# rv64_exec_core named literal sections (irreducible per-core logic paragraphs).
# Structured parts (entity/ports/generics/constants/decode arm headers/mem-init/
# dbg taps) are generated in gen_types.spl / exec_core_gen.spl — NOT here.
# Each function below is one named section; the header comment names it.

fn rv64_head_comment() -> [text]:
    var l: [text] = []
    l = l.push("-- rv64_exec_core — hand-written synthesizable RV64IM + minimal Zicsr core.")
    l = l.push("--")
    l = l.push("-- Route decision (doc/03_plan/hardware/riscv/fpga_board_bringup_jtag_10min_plan_2026-07-24.md,")
    l = l.push("-- Lane C): this is the widened, structurally diff-able sibling of the proven")
    l = l.push("-- rv32_exec_core.vhd (multi-cycle, GHDL-clean, K26 board-proven). There is NO")
    l = l.push("-- .spl -> VHDL backend (generate_rv64_vhdl.shs is BLOCKED on a phantom")
    l = l.push("-- compile_to_vhdl_module); the .spl model (src/lib/hardware/rv64gc_rtl/) is the")
    l = l.push("-- differential oracle only. This file is the real synthesizable artifact.")
    l = l.push("--")
    l = l.push("-- Scope: RV64IM (base + M multiply/divide) + the RV64 W-suffix word ops")
    l = l.push("-- (ADDIW/SLLIW/SRLIW/SRAIW, ADDW/SUBW/SLLW/SRLW/SRAW, MULW/DIVW/DIVUW/REMW/REMUW)")
    l = l.push("-- + a minimal machine-mode Zicsr read set. Machine mode only, no MMU, no FPU,")
    l = l.push("-- no compressed. Exactly enough to run the Adler-32 soak payload class")
    l = l.push("-- (MUL/DIV/REMU + loads/stores + a 16550-style UART TX at 0x1000_0000).")
    l = l.push("--")
    l = l.push("-- Memory model mirrors rv32's replicated-BRAM discipline but at 64-bit width:")
    l = l.push("-- two identical physical copies mem_a (instruction fetch) / mem_b (data) each")
    l = l.push("-- with exactly one synchronous read port + a shared funneled write port, so it")
    l = l.push("-- infers simple-dual-port BRAM (no async multiport LUTRAM). Loads and sub-word")
    l = l.push("-- stores are deferred one cycle through S_LOAD / S_STORE using the registered")
    l = l.push("-- reads mem_a_q / mem_b_q.")
    l

fn rv64_type_mem() -> [text]:
    var l: [text] = []
    l = l.push("  type mem_t  is array(0 to MEM_WORDS - 1) of std_logic_vector(63 downto 0);")
    l

fn rv64_type_ldkind() -> [text]:
    var l: [text] = []
    l = l.push("  type ld_kind_t is (LD_D, LD_W, LD_WU, LD_H, LD_HU, LD_B, LD_BU);")
    l

fn rv64_sig_block() -> [text]:
    var l: [text] = []
    l = l.push("  signal mem_a : mem_t := init_mem;")
    l = l.push("  signal mem_b : mem_t := init_mem;")
    l = l.push("  attribute ram_style : string;")
    l = l.push("  attribute ram_style of mem_a : signal is \"block\";")
    l = l.push("  attribute ram_style of mem_b : signal is \"block\";")
    l = l.push("  signal mem_a_q : std_logic_vector(63 downto 0) := (others => '0');")
    l = l.push("  signal mem_b_q : std_logic_vector(63 downto 0) := (others => '0');")
    l = l.push("")
    l = l.push("  -- Minimal machine-mode CSRs (read-as-value; writes accepted but discarded")
    l = l.push("  -- for the subset the soak / OpenSBI banner touch).")
    l = l.push("  signal csr_mhartid : unsigned(63 downto 0) := (others => '0');")
    l = l.push("  signal csr_mstatus : unsigned(63 downto 0) := (others => '0');")
    l = l.push("  signal csr_mtvec   : unsigned(63 downto 0) := (others => '0');")
    l = l.push("  signal csr_mie     : unsigned(63 downto 0) := (others => '0');")
    l = l.push("  signal csr_mip     : unsigned(63 downto 0) := (others => '0');")
    l = l.push("  signal csr_mcycle  : unsigned(63 downto 0) := (others => '0');")
    l = l.push("")
    l = l.push("  -- Multi-cycle restoring divider. All div/rem forms (full + W) are normalised")
    l = l.push("  -- to a 64-bit unsigned magnitude division (64 iterations) with sign / word")
    l = l.push("  -- fix-up applied at completion. dividend is 128-bit (magnitude in the low 64,")
    l = l.push("  -- partial remainder accumulates in the high 64).")
    l = l.push("  signal div_dividend_q : unsigned(127 downto 0) := (others => '0');")
    l = l.push("  signal div_divisor_q  : unsigned(63 downto 0)  := (others => '0');")
    l = l.push("  signal div_quotient_q : unsigned(63 downto 0)  := (others => '0');")
    l = l.push("  signal div_count_q    : unsigned(6 downto 0)   := (others => '0');")
    l = l.push("  signal div_is_rem_q   : std_logic := '0';")
    l = l.push("  signal div_is_w_q     : std_logic := '0';")
    l = l.push("  signal div_neg_q      : std_logic := '0';")
    l = l.push("  signal div_rd_q       : natural range 0 to 31 := 0;")
    l = l.push("")
    l = l.push("  -- Deferred load / sub-word store bookkeeping.")
    l = l.push("  signal ld_rd_q   : natural range 0 to 31 := 0;")
    l = l.push("  signal ld_kind_q : ld_kind_t := LD_D;")
    l = l.push("  signal ld_off_q  : natural range 0 to 7 := 0;")
    l = l.push("  signal st_idx_q  : natural range 0 to MEM_WORDS - 1 := 0;")
    l = l.push("  signal st_len_q  : natural range 1 to 8 := 1;")
    l = l.push("  signal st_off_q  : natural range 0 to 7 := 0;")
    l = l.push("  signal st_data_q : std_logic_vector(63 downto 0) := (others => '0');")
    l = l.push("")
    l = l.push("  signal regs_q    : regs_t := (others => (others => '0'));")
    l = l.push("  signal pc_q      : unsigned(63 downto 0) := BASE_ADDR;")
    l = l.push("  signal next_pc_q : unsigned(63 downto 0) := BASE_ADDR;")
    l = l.push("  signal state_q   : state_t := S_FETCH;")
    l = l.push("")
    l = l.push("  signal uart_tx_q    : std_logic := '1';")
    l = l.push("  signal uart_busy_q  : std_logic := '0';")
    l = l.push("  signal uart_baud_q  : natural range 0 to CLK_FREQ := 0;")
    l = l.push("  signal uart_bits_q  : natural range 0 to 10 := 0;")
    l = l.push("  signal uart_shift_q : std_logic_vector(9 downto 0) := (others => '1');")
    l

fn rv64_helper_funcs() -> [text]:
    var l: [text] = []
    l = l.push("  function sext(v : std_logic_vector) return unsigned is")
    l = l.push("  begin")
    l = l.push("    return unsigned(resize(signed(v), 64));")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  -- Sign-extend a 32-bit word result to 64 bits (RV64 W-op semantics).")
    l = l.push("  function sext32(v : std_logic_vector(31 downto 0)) return unsigned is")
    l = l.push("  begin")
    l = l.push("    return unsigned(resize(signed(v), 64));")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  -- 64-bit two's-complement magnitude. abs(INT64_MIN) wraps to 0x8000..0 which")
    l = l.push("  -- as an *unsigned* value is exactly 2^63 — the correct magnitude, so only the")
    l = l.push("  -- INT_MIN / -1 quotient overflow needs the explicit guard below.")
    l = l.push("  function mag(v : unsigned(63 downto 0)) return unsigned is")
    l = l.push("  begin")
    l = l.push("    if v(63) = '1' then")
    l = l.push("      return unsigned(-signed(v));")
    l = l.push("    else")
    l = l.push("      return v;")
    l = l.push("    end if;")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function mem_index(addr : unsigned(63 downto 0)) return natural is")
    l = l.push("    variable off : unsigned(63 downto 0);")
    l = l.push("  begin")
    l = l.push("    off := addr - BASE_ADDR;")
    l = l.push("    return to_integer(off(15 downto 3));")
    l = l.push("  end function;")
    l

fn rv64_process_head() -> [text]:
    var l: [text] = []
    l = l.push("  process(clk)")
    l = l.push("    variable r        : regs_t;")
    l = l.push("    variable pc_next  : unsigned(63 downto 0);")
    l = l.push("    variable pc_idx   : natural;")
    l = l.push("    variable word64   : std_logic_vector(63 downto 0);")
    l = l.push("    variable ins      : std_logic_vector(31 downto 0);")
    l = l.push("    variable op       : std_logic_vector(6 downto 0);")
    l = l.push("    variable f3       : std_logic_vector(2 downto 0);")
    l = l.push("    variable rd       : natural range 0 to 31;")
    l = l.push("    variable rs1      : natural range 0 to 31;")
    l = l.push("    variable rs2      : natural range 0 to 31;")
    l = l.push("    variable sh6      : natural range 0 to 63;")
    l = l.push("    variable sh5      : natural range 0 to 31;")
    l = l.push("    variable eff      : unsigned(63 downto 0);")
    l = l.push("    variable idx      : natural;")
    l = l.push("    variable boff     : natural range 0 to 7;")
    l = l.push("    variable res32    : std_logic_vector(31 downto 0);")
    l = l.push("    variable prod128  : signed(127 downto 0);")
    l = l.push("    variable uprod    : unsigned(127 downto 0);")
    l = l.push("    variable a_s      : signed(63 downto 0);")
    l = l.push("    variable b_s      : signed(63 downto 0);")
    l = l.push("    variable a_mag    : unsigned(63 downto 0);")
    l = l.push("    variable b_mag    : unsigned(63 downto 0);")
    l = l.push("    variable dvd      : unsigned(127 downto 0);")
    l = l.push("    variable magres   : unsigned(63 downto 0);")
    l = l.push("    variable finalv   : unsigned(63 downto 0);")
    l = l.push("    variable ldw     : std_logic_vector(63 downto 0);")
    l = l.push("    variable data_w   : std_logic_vector(63 downto 0);")
    l = l.push("    -- Single muxed read address per physical memory + one funneled write port.")
    l = l.push("    variable mem_ra_a : natural range 0 to MEM_WORDS - 1;")
    l = l.push("    variable mem_ra_b : natural range 0 to MEM_WORDS - 1;")
    l = l.push("    variable mem_we   : boolean;")
    l = l.push("    variable mem_wa   : natural range 0 to MEM_WORDS - 1;")
    l = l.push("    variable mem_wd   : std_logic_vector(63 downto 0);")
    l = l.push("    variable start_div : boolean;")
    l = l.push("  begin")
    l

fn rv64_exec_prelude() -> [text]:
    var l: [text] = []
    l = l.push("    if rising_edge(clk) then")
    l = l.push("      -- Per-cycle memory port defaults: prefetch the current pc word on mem_a;")
    l = l.push("      -- data-side reads override mem_ra_b below.")
    l = l.push("      mem_we   := false;")
    l = l.push("      mem_wa   := 0;")
    l = l.push("      mem_wd   := (others => '0');")
    l = l.push("      pc_idx   := mem_index(pc_q);")
    l = l.push("      if pc_idx > MEM_WORDS - 1 then")
    l = l.push("        pc_idx := MEM_WORDS - 1;")
    l = l.push("      end if;")
    l = l.push("      mem_ra_a := pc_idx;")
    l = l.push("      mem_ra_b := 0;")
    l = l.push("")
    l = l.push("      debug_uart_valid_q      <= debug_uart_valid_next_q;")
    l = l.push("      debug_uart_valid_next_q <= '0';")
    l = l.push("      csr_mcycle              <= csr_mcycle + 1;")
    l = l.push("")
    l = l.push("      -- UART shift engine (runs every edge regardless of FSM state).")
    l = l.push("      if uart_busy_q = '1' then")
    l = l.push("        if uart_baud_q >= BAUD_DIV - 1 then")
    l = l.push("          uart_baud_q <= 0;")
    l = l.push("          if uart_bits_q > 1 then")
    l = l.push("            uart_tx_q    <= uart_shift_q(1);")
    l = l.push("            uart_shift_q <= '1' & uart_shift_q(9 downto 1);")
    l = l.push("            uart_bits_q  <= uart_bits_q - 1;")
    l = l.push("          else")
    l = l.push("            uart_tx_q   <= '1';")
    l = l.push("            uart_busy_q <= '0';")
    l = l.push("            uart_bits_q <= 0;")
    l = l.push("          end if;")
    l = l.push("        else")
    l = l.push("          uart_baud_q <= uart_baud_q + 1;")
    l = l.push("        end if;")
    l = l.push("      end if;")
    l = l.push("")
    l = l.push("      if rst = '1' then")
    l = l.push("        regs_q    <= (others => (others => '0'));")
    l = l.push("        pc_q      <= BASE_ADDR;")
    l = l.push("        next_pc_q <= BASE_ADDR;")
    l = l.push("        state_q   <= S_FETCH;")
    l = l.push("        ld_rd_q   <= 0;")
    l = l.push("        ld_kind_q <= LD_D;")
    l = l.push("        ld_off_q  <= 0;")
    l = l.push("        st_idx_q  <= 0;")
    l = l.push("        st_len_q  <= 1;")
    l = l.push("        st_off_q  <= 0;")
    l = l.push("        st_data_q <= (others => '0');")
    l = l.push("        uart_tx_q    <= '1';")
    l = l.push("        uart_busy_q  <= '0';")
    l = l.push("        uart_baud_q  <= 0;")
    l = l.push("        uart_bits_q  <= 0;")
    l = l.push("        uart_shift_q <= (others => '1');")
    l = l.push("        debug_uart_valid_q      <= '0';")
    l = l.push("        debug_uart_valid_next_q <= '0';")
    l = l.push("        debug_uart_byte_q       <= (others => '0');")
    l = l.push("        csr_mhartid <= (others => '0');")
    l = l.push("        csr_mstatus <= (others => '0');")
    l = l.push("        csr_mtvec   <= (others => '0');")
    l = l.push("        csr_mie     <= (others => '0');")
    l = l.push("        csr_mip     <= (others => '0');")
    l = l.push("        csr_mcycle  <= (others => '0');")
    l = l.push("        div_dividend_q <= (others => '0');")
    l = l.push("        div_divisor_q  <= (others => '0');")
    l = l.push("        div_quotient_q <= (others => '0');")
    l = l.push("        div_count_q    <= (others => '0');")
    l = l.push("        div_is_rem_q   <= '0';")
    l = l.push("        div_is_w_q     <= '0';")
    l = l.push("        div_neg_q      <= '0';")
    l = l.push("        div_rd_q       <= 0;")
    l = l.push("")
    l = l.push("      elsif state_q = S_UART then")
    l = l.push("        if uart_busy_q = '0' then")
    l = l.push("          pc_q    <= next_pc_q;")
    l = l.push("          state_q <= S_FETCH;")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("      elsif state_q = S_DIVIDE then")
    l = l.push("        if div_count_q /= 0 then")
    l = l.push("          dvd := shift_left(div_dividend_q, 1);")
    l = l.push("          if dvd(127 downto 64) >= div_divisor_q then")
    l = l.push("            dvd(127 downto 64) := dvd(127 downto 64) - div_divisor_q;")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1) + 1;")
    l = l.push("          else")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1);")
    l = l.push("          end if;")
    l = l.push("          div_dividend_q <= dvd;")
    l = l.push("          div_count_q    <= div_count_q - 1;")
    l = l.push("        else")
    l = l.push("          if div_is_rem_q = '1' then")
    l = l.push("            magres := div_dividend_q(127 downto 64);")
    l = l.push("          else")
    l = l.push("            magres := div_quotient_q;")
    l = l.push("          end if;")
    l = l.push("          if div_neg_q = '1' then")
    l = l.push("            finalv := unsigned(-signed(magres));")
    l = l.push("          else")
    l = l.push("            finalv := magres;")
    l = l.push("          end if;")
    l = l.push("          if div_is_w_q = '1' then")
    l = l.push("            finalv := sext32(std_logic_vector(finalv(31 downto 0)));")
    l = l.push("          end if;")
    l = l.push("          if div_rd_q /= 0 then")
    l = l.push("            regs_q(div_rd_q) <= finalv;")
    l = l.push("          end if;")
    l = l.push("          div_rd_q <= 0;")
    l = l.push("          state_q  <= S_FETCH;")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("      elsif state_q = S_FETCH then")
    l = l.push("        -- mem_a_q was latched with the pc word on the previous edge (default")
    l = l.push("        -- addressing); decode + execute happens next cycle in S_EXEC.")
    l = l.push("        state_q <= S_EXEC;")
    l = l.push("")
    l = l.push("      elsif state_q = S_LOAD then")
    l = l.push("        ldw := mem_b_q;")
    l = l.push("        boff := ld_off_q;")
    l = l.push("        if ld_rd_q /= 0 then")
    l = l.push("          case ld_kind_q is")
    l = l.push("            when LD_D  => regs_q(ld_rd_q) <= unsigned(ldw);")
    l = l.push("            when LD_W  => regs_q(ld_rd_q) <= sext32(ldw(boff * 8 + 31 downto boff * 8));")
    l = l.push("            when LD_WU => regs_q(ld_rd_q) <= resize(unsigned(ldw(boff * 8 + 31 downto boff * 8)), 64);")
    l = l.push("            when LD_H  => regs_q(ld_rd_q) <= sext(ldw(boff * 8 + 15 downto boff * 8));")
    l = l.push("            when LD_HU => regs_q(ld_rd_q) <= resize(unsigned(ldw(boff * 8 + 15 downto boff * 8)), 64);")
    l = l.push("            when LD_B  => regs_q(ld_rd_q) <= sext(ldw(boff * 8 + 7 downto boff * 8));")
    l = l.push("            when LD_BU => regs_q(ld_rd_q) <= resize(unsigned(ldw(boff * 8 + 7 downto boff * 8)), 64);")
    l = l.push("          end case;")
    l = l.push("        end if;")
    l = l.push("        state_q <= S_FETCH;")
    l = l.push("")
    l = l.push("      elsif state_q = S_STORE then")
    l = l.push("        -- Sub-word store read-modify-write: mem_b_q holds the current word.")
    l = l.push("        data_w := mem_b_q;")
    l = l.push("        boff   := st_off_q;")
    l = l.push("        for i in 0 to 7 loop")
    l = l.push("          if i >= st_off_q and i < st_off_q + st_len_q then")
    l = l.push("            data_w(i * 8 + 7 downto i * 8) := st_data_q((i - st_off_q) * 8 + 7 downto (i - st_off_q) * 8);")
    l = l.push("          end if;")
    l = l.push("        end loop;")
    l = l.push("        mem_we  := true;")
    l = l.push("        mem_wa  := st_idx_q;")
    l = l.push("        mem_wd  := data_w;")
    l = l.push("        state_q <= S_FETCH;")
    l = l.push("")
    l = l.push("      else  -- S_EXEC")
    l = l.push("        r         := regs_q;")
    l = l.push("        state_q   <= S_FETCH;")
    l = l.push("        pc_next   := pc_q + 4;")
    l = l.push("        start_div := false;")
    l = l.push("        word64    := mem_a_q;")
    l = l.push("        if pc_q(2) = '0' then")
    l = l.push("          ins := word64(31 downto 0);")
    l = l.push("        else")
    l = l.push("          ins := word64(63 downto 32);")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("        op  := ins(6 downto 0);")
    l = l.push("        f3  := ins(14 downto 12);")
    l = l.push("        rd  := to_integer(unsigned(ins(11 downto 7)));")
    l = l.push("        rs1 := to_integer(unsigned(ins(19 downto 15)));")
    l = l.push("        rs2 := to_integer(unsigned(ins(24 downto 20)));")
    l = l.push("        sh6 := to_integer(unsigned(ins(25 downto 20)));")
    l = l.push("        sh5 := to_integer(unsigned(ins(24 downto 20)));")
    l = l.push("")
    l

fn rv64_arm_op_imm() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then")
    l = l.push("              case f3 is")
    l = l.push("                when \"000\" => r(rd) := r(rs1) + sext(ins(31 downto 20));")
    l = l.push("                when \"111\" => r(rd) := r(rs1) and sext(ins(31 downto 20));")
    l = l.push("                when \"110\" => r(rd) := r(rs1) or sext(ins(31 downto 20));")
    l = l.push("                when \"100\" => r(rd) := r(rs1) xor sext(ins(31 downto 20));")
    l = l.push("                when \"010\" =>")
    l = l.push("                  if signed(r(rs1)) < signed(sext(ins(31 downto 20))) then r(rd) := to_unsigned(1, 64); else r(rd) := (others => '0'); end if;")
    l = l.push("                when \"011\" =>")
    l = l.push("                  if r(rs1) < sext(ins(31 downto 20)) then r(rd) := to_unsigned(1, 64); else r(rd) := (others => '0'); end if;")
    l = l.push("                when \"001\" => r(rd) := shift_left(r(rs1), sh6);")
    l = l.push("                when others =>  -- \"101\" SRLI / SRAI (6-bit shamt)")
    l = l.push("                  if ins(30) = '1' then r(rd) := unsigned(shift_right(signed(r(rs1)), sh6));")
    l = l.push("                  else r(rd) := shift_right(r(rs1), sh6); end if;")
    l = l.push("              end case;")
    l = l.push("            end if;")
    l

fn rv64_arm_op_imm32() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then")
    l = l.push("              case f3 is")
    l = l.push("                when \"000\" =>  -- ADDIW")
    l = l.push("                  res32 := std_logic_vector(unsigned(r(rs1)(31 downto 0)) + unsigned(sext(ins(31 downto 20))(31 downto 0)));")
    l = l.push("                  r(rd) := sext32(res32);")
    l = l.push("                when \"001\" =>  -- SLLIW (5-bit shamt)")
    l = l.push("                  res32 := std_logic_vector(shift_left(unsigned(r(rs1)(31 downto 0)), sh5));")
    l = l.push("                  r(rd) := sext32(res32);")
    l = l.push("                when others =>  -- \"101\" SRLIW / SRAIW")
    l = l.push("                  if ins(30) = '1' then res32 := std_logic_vector(shift_right(signed(r(rs1)(31 downto 0)), sh5));")
    l = l.push("                  else res32 := std_logic_vector(shift_right(unsigned(r(rs1)(31 downto 0)), sh5)); end if;")
    l = l.push("                  r(rd) := sext32(res32);")
    l = l.push("              end case;")
    l = l.push("            end if;")
    l

fn rv64_arm_op() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then")
    l = l.push("              if ins(31 downto 25) = \"0000001\" then")
    l = l.push("                case f3 is")
    l = l.push("                  when \"000\" =>  -- MUL (low 64)")
    l = l.push("                    uprod := unsigned(r(rs1)) * unsigned(r(rs2));")
    l = l.push("                    r(rd) := uprod(63 downto 0);")
    l = l.push("                  when \"001\" =>  -- MULH (signed*signed high)")
    l = l.push("                    prod128 := signed(r(rs1)) * signed(r(rs2));")
    l = l.push("                    r(rd) := unsigned(prod128(127 downto 64));")
    l = l.push("                  when \"010\" =>  -- MULHSU (signed*unsigned high)")
    l = l.push("                    prod128 := signed(unsigned(r(rs1)) * unsigned(r(rs2)));")
    l = l.push("                    if signed(r(rs1)) < 0 then")
    l = l.push("                      prod128 := prod128 - shift_left(resize(signed(unsigned(r(rs2))), 128), 64);")
    l = l.push("                    end if;")
    l = l.push("                    r(rd) := unsigned(prod128(127 downto 64));")
    l = l.push("                  when \"011\" =>  -- MULHU (unsigned*unsigned high)")
    l = l.push("                    uprod := unsigned(r(rs1)) * unsigned(r(rs2));")
    l = l.push("                    r(rd) := uprod(127 downto 64);")
    l = l.push("                  when \"100\" =>  -- DIV")
    l = l.push("                    if r(rs2) = 0 then")
    l = l.push("                      r(rd) := (others => '1');")
    l = l.push("                    elsif r(rs1) = x\"8000000000000000\" and r(rs2) = x\"FFFFFFFFFFFFFFFF\" then")
    l = l.push("                      r(rd) := x\"8000000000000000\";")
    l = l.push("                    else")
    l = l.push("                      a_s := signed(r(rs1)); b_s := signed(r(rs2));")
    l = l.push("                      a_mag := mag(r(rs1)); b_mag := mag(r(rs2));")
    l = l.push("                      div_neg_q <= (a_s(63) xor b_s(63));")
    l = l.push("                      div_is_rem_q <= '0'; div_is_w_q <= '0';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                  when \"101\" =>  -- DIVU")
    l = l.push("                    if r(rs2) = 0 then")
    l = l.push("                      r(rd) := (others => '1');")
    l = l.push("                    else")
    l = l.push("                      a_mag := r(rs1); b_mag := r(rs2);")
    l = l.push("                      div_neg_q <= '0'; div_is_rem_q <= '0'; div_is_w_q <= '0';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                  when \"110\" =>  -- REM")
    l = l.push("                    if r(rs2) = 0 then")
    l = l.push("                      r(rd) := r(rs1);")
    l = l.push("                    elsif r(rs1) = x\"8000000000000000\" and r(rs2) = x\"FFFFFFFFFFFFFFFF\" then")
    l = l.push("                      r(rd) := (others => '0');")
    l = l.push("                    else")
    l = l.push("                      a_s := signed(r(rs1));")
    l = l.push("                      a_mag := mag(r(rs1)); b_mag := mag(r(rs2));")
    l = l.push("                      div_neg_q <= a_s(63);")
    l = l.push("                      div_is_rem_q <= '1'; div_is_w_q <= '0';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                  when others =>  -- \"111\" REMU")
    l = l.push("                    if r(rs2) = 0 then")
    l = l.push("                      r(rd) := r(rs1);")
    l = l.push("                    else")
    l = l.push("                      a_mag := r(rs1); b_mag := r(rs2);")
    l = l.push("                      div_neg_q <= '0'; div_is_rem_q <= '1'; div_is_w_q <= '0';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                end case;")
    l = l.push("              else")
    l = l.push("                case f3 is")
    l = l.push("                  when \"000\" => if ins(30) = '1' then r(rd) := r(rs1) - r(rs2); else r(rd) := r(rs1) + r(rs2); end if;")
    l = l.push("                  when \"001\" => r(rd) := shift_left(r(rs1), to_integer(r(rs2)(5 downto 0)));")
    l = l.push("                  when \"010\" => if signed(r(rs1)) < signed(r(rs2)) then r(rd) := to_unsigned(1, 64); else r(rd) := (others => '0'); end if;")
    l = l.push("                  when \"011\" => if r(rs1) < r(rs2) then r(rd) := to_unsigned(1, 64); else r(rd) := (others => '0'); end if;")
    l = l.push("                  when \"100\" => r(rd) := r(rs1) xor r(rs2);")
    l = l.push("                  when \"101\" => if ins(30) = '1' then r(rd) := unsigned(shift_right(signed(r(rs1)), to_integer(r(rs2)(5 downto 0)))); else r(rd) := shift_right(r(rs1), to_integer(r(rs2)(5 downto 0))); end if;")
    l = l.push("                  when \"110\" => r(rd) := r(rs1) or r(rs2);")
    l = l.push("                  when others => r(rd) := r(rs1) and r(rs2);")
    l = l.push("                end case;")
    l = l.push("              end if;")
    l = l.push("            end if;")
    l

fn rv64_arm_op32() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then")
    l = l.push("              if ins(31 downto 25) = \"0000001\" then")
    l = l.push("                case f3 is")
    l = l.push("                  when \"000\" =>  -- MULW")
    l = l.push("                    res32 := std_logic_vector(resize(signed(r(rs1)(31 downto 0)) * signed(r(rs2)(31 downto 0)), 32));")
    l = l.push("                    r(rd) := sext32(res32);")
    l = l.push("                  when \"100\" =>  -- DIVW")
    l = l.push("                    if r(rs2)(31 downto 0) = x\"00000000\" then")
    l = l.push("                      r(rd) := (others => '1');")
    l = l.push("                    elsif r(rs1)(31 downto 0) = x\"80000000\" and r(rs2)(31 downto 0) = x\"FFFFFFFF\" then")
    l = l.push("                      r(rd) := x\"FFFFFFFF80000000\";")
    l = l.push("                    else")
    l = l.push("                      a_s := resize(signed(r(rs1)(31 downto 0)), 64);")
    l = l.push("                      b_s := resize(signed(r(rs2)(31 downto 0)), 64);")
    l = l.push("                      a_mag := mag(unsigned(a_s)); b_mag := mag(unsigned(b_s));")
    l = l.push("                      div_neg_q <= (a_s(63) xor b_s(63));")
    l = l.push("                      div_is_rem_q <= '0'; div_is_w_q <= '1';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                  when \"101\" =>  -- DIVUW")
    l = l.push("                    if r(rs2)(31 downto 0) = x\"00000000\" then")
    l = l.push("                      r(rd) := (others => '1');")
    l = l.push("                    else")
    l = l.push("                      a_mag := resize(unsigned(r(rs1)(31 downto 0)), 64);")
    l = l.push("                      b_mag := resize(unsigned(r(rs2)(31 downto 0)), 64);")
    l = l.push("                      div_neg_q <= '0'; div_is_rem_q <= '0'; div_is_w_q <= '1';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                  when \"110\" =>  -- REMW")
    l = l.push("                    if r(rs2)(31 downto 0) = x\"00000000\" then")
    l = l.push("                      r(rd) := sext32(std_logic_vector(r(rs1)(31 downto 0)));")
    l = l.push("                    elsif r(rs1)(31 downto 0) = x\"80000000\" and r(rs2)(31 downto 0) = x\"FFFFFFFF\" then")
    l = l.push("                      r(rd) := (others => '0');")
    l = l.push("                    else")
    l = l.push("                      a_s := resize(signed(r(rs1)(31 downto 0)), 64);")
    l = l.push("                      b_s := resize(signed(r(rs2)(31 downto 0)), 64);")
    l = l.push("                      a_mag := mag(unsigned(a_s)); b_mag := mag(unsigned(b_s));")
    l = l.push("                      div_neg_q <= a_s(63);")
    l = l.push("                      div_is_rem_q <= '1'; div_is_w_q <= '1';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                  when others =>  -- \"111\" REMUW")
    l = l.push("                    if r(rs2)(31 downto 0) = x\"00000000\" then")
    l = l.push("                      r(rd) := sext32(std_logic_vector(r(rs1)(31 downto 0)));")
    l = l.push("                    else")
    l = l.push("                      a_mag := resize(unsigned(r(rs1)(31 downto 0)), 64);")
    l = l.push("                      b_mag := resize(unsigned(r(rs2)(31 downto 0)), 64);")
    l = l.push("                      div_neg_q <= '0'; div_is_rem_q <= '1'; div_is_w_q <= '1';")
    l = l.push("                      start_div := true;")
    l = l.push("                    end if;")
    l = l.push("                end case;")
    l = l.push("              else")
    l = l.push("                case f3 is")
    l = l.push("                  when \"000\" =>  -- ADDW / SUBW")
    l = l.push("                    if ins(30) = '1' then res32 := std_logic_vector(unsigned(r(rs1)(31 downto 0)) - unsigned(r(rs2)(31 downto 0)));")
    l = l.push("                    else res32 := std_logic_vector(unsigned(r(rs1)(31 downto 0)) + unsigned(r(rs2)(31 downto 0))); end if;")
    l = l.push("                    r(rd) := sext32(res32);")
    l = l.push("                  when \"001\" =>  -- SLLW (5-bit)")
    l = l.push("                    res32 := std_logic_vector(shift_left(unsigned(r(rs1)(31 downto 0)), to_integer(r(rs2)(4 downto 0))));")
    l = l.push("                    r(rd) := sext32(res32);")
    l = l.push("                  when others =>  -- \"101\" SRLW / SRAW")
    l = l.push("                    if ins(30) = '1' then res32 := std_logic_vector(shift_right(signed(r(rs1)(31 downto 0)), to_integer(r(rs2)(4 downto 0))));")
    l = l.push("                    else res32 := std_logic_vector(shift_right(unsigned(r(rs1)(31 downto 0)), to_integer(r(rs2)(4 downto 0)))); end if;")
    l = l.push("                    r(rd) := sext32(res32);")
    l = l.push("                end case;")
    l = l.push("              end if;")
    l = l.push("            end if;")
    l

fn rv64_arm_auipc() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then r(rd) := pc_q + sext32(ins(31 downto 12) & x\"000\"); end if;")
    l

fn rv64_arm_lui() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then r(rd) := sext32(ins(31 downto 12) & x\"000\"); end if;")
    l

fn rv64_arm_jal() -> [text]:
    var l: [text] = []
    l = l.push("            if rd /= 0 then r(rd) := pc_q + 4; end if;")
    l = l.push("            pc_next := pc_q + sext(ins(31) & ins(19 downto 12) & ins(20) & ins(30 downto 21) & '0');")
    l

fn rv64_arm_jalr() -> [text]:
    var l: [text] = []
    l = l.push("            pc_next := (r(rs1) + sext(ins(31 downto 20))) and x\"FFFFFFFFFFFFFFFE\";")
    l = l.push("            if rd /= 0 then r(rd) := pc_q + 4; end if;")
    l

fn rv64_arm_branch() -> [text]:
    var l: [text] = []
    l = l.push("            eff := pc_q + sext(ins(31) & ins(7) & ins(30 downto 25) & ins(11 downto 8) & '0');")
    l = l.push("            case f3 is")
    l = l.push("              when \"000\" => if r(rs1) = r(rs2) then pc_next := eff; end if;")
    l = l.push("              when \"001\" => if r(rs1) /= r(rs2) then pc_next := eff; end if;")
    l = l.push("              when \"100\" => if signed(r(rs1)) < signed(r(rs2)) then pc_next := eff; end if;")
    l = l.push("              when \"101\" => if signed(r(rs1)) >= signed(r(rs2)) then pc_next := eff; end if;")
    l = l.push("              when \"110\" => if r(rs1) < r(rs2) then pc_next := eff; end if;")
    l = l.push("              when others => if r(rs1) >= r(rs2) then pc_next := eff; end if;")
    l = l.push("            end case;")
    l

fn rv64_arm_load() -> [text]:
    var l: [text] = []
    l = l.push("            eff := r(rs1) + sext(ins(31 downto 20));")
    l = l.push("            if rd /= 0 and eff(31 downto 28) = x\"8\" then")
    l = l.push("              mem_ra_b := mem_index(eff);")
    l = l.push("              ld_rd_q  <= rd;")
    l = l.push("              ld_off_q <= to_integer(eff(2 downto 0));")
    l = l.push("              case f3 is")
    l = l.push("                when \"011\" => ld_kind_q <= LD_D;")
    l = l.push("                when \"010\" => ld_kind_q <= LD_W;")
    l = l.push("                when \"110\" => ld_kind_q <= LD_WU;")
    l = l.push("                when \"001\" => ld_kind_q <= LD_H;")
    l = l.push("                when \"101\" => ld_kind_q <= LD_HU;")
    l = l.push("                when \"000\" => ld_kind_q <= LD_B;")
    l = l.push("                when others => ld_kind_q <= LD_BU;  -- \"100\"")
    l = l.push("              end case;")
    l = l.push("              state_q <= S_LOAD;")
    l = l.push("            elsif rd /= 0 then")
    l = l.push("              r(rd) := (others => '0');")
    l = l.push("            end if;")
    l

fn rv64_arm_store() -> [text]:
    var l: [text] = []
    l = l.push("            eff := r(rs1) + sext(ins(31 downto 25) & ins(11 downto 7));")
    l = l.push("            if eff = UART_ADDR and f3 = \"000\" then")
    l = l.push("              uart_shift_q <= '1' & std_logic_vector(r(rs2)(7 downto 0)) & '0';")
    l = l.push("              uart_tx_q    <= '0';")
    l = l.push("              uart_busy_q  <= '1';")
    l = l.push("              uart_baud_q  <= 0;")
    l = l.push("              uart_bits_q  <= 10;")
    l = l.push("              debug_uart_valid_next_q <= '1';")
    l = l.push("              debug_uart_byte_q       <= std_logic_vector(r(rs2)(7 downto 0));")
    l = l.push("              next_pc_q <= pc_next;")
    l = l.push("              state_q   <= S_UART;")
    l = l.push("            elsif eff(31 downto 28) = x\"8\" then")
    l = l.push("              idx  := mem_index(eff);")
    l = l.push("              boff := to_integer(eff(2 downto 0));")
    l = l.push("              if f3 = \"011\" then")
    l = l.push("                -- SD (aligned 8-byte): direct write, no read needed.")
    l = l.push("                mem_we := true;")
    l = l.push("                mem_wa := idx;")
    l = l.push("                mem_wd := std_logic_vector(r(rs2));")
    l = l.push("              else")
    l = l.push("                -- SB/SH/SW: read-modify-write via S_STORE.")
    l = l.push("                mem_ra_b  := mem_index(eff);")
    l = l.push("                st_idx_q  <= idx;")
    l = l.push("                st_off_q  <= boff;")
    l = l.push("                st_data_q <= std_logic_vector(r(rs2));")
    l = l.push("                case f3 is")
    l = l.push("                  when \"000\" => st_len_q <= 1;")
    l = l.push("                  when \"001\" => st_len_q <= 2;")
    l = l.push("                  when others => st_len_q <= 4;  -- \"010\" SW")
    l = l.push("                end case;")
    l = l.push("                state_q <= S_STORE;")
    l = l.push("              end if;")
    l = l.push("            end if;")
    l

fn rv64_sys_glue_a() -> [text]:
    var l: [text] = []
    l = l.push("            case f3 is")
    l = l.push("              when \"000\" =>")
    l = l.push("                -- ecall / ebreak: halt cleanly (hold pc).")
    l = l.push("                pc_next := pc_q;")
    l = l.push("              when \"001\" | \"010\" | \"011\" | \"101\" | \"110\" | \"111\" =>")
    l = l.push("                if rd /= 0 then")
    l

fn rv64_sys_glue_b() -> [text]:
    var l: [text] = []
    l = l.push("                end if;")
    l = l.push("              when others => null;")
    l = l.push("            end case;")
    l

fn rv64_epilogue() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("        if start_div then")
    l = l.push("          div_dividend_q <= x\"0000000000000000\" & a_mag;")
    l = l.push("          div_divisor_q  <= b_mag;")
    l = l.push("          div_quotient_q <= (others => '0');")
    l = l.push("          div_count_q    <= to_unsigned(64, 7);")
    l = l.push("          div_rd_q       <= rd;")
    l = l.push("          state_q        <= S_DIVIDE;")
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("        r(0) := (others => '0');")
    l = l.push("        regs_q <= r;")
    l = l.push("        if state_q = S_EXEC then")
    l = l.push("          pc_q <= pc_next;")
    l = l.push("        end if;")
    l = l.push("      end if;")
    l = l.push("")
    l = l.push("      -- === Physical memory ports (single read + single write per array) ===")
    l = l.push("      if mem_we then")
    l = l.push("        mem_a(mem_wa) <= mem_wd;")
    l = l.push("        mem_b(mem_wa) <= mem_wd;")
    l = l.push("      end if;")
    l = l.push("      mem_a_q <= mem_a(mem_ra_a);")
    l = l.push("      mem_b_q <= mem_b(mem_ra_b);")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l = l.push("end architecture rtl;")
    l

