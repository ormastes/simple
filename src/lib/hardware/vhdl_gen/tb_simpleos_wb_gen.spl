# Structured testbench VHDL generator — emits THREE XLEN PAIRS byte-identical
# to the goldens in examples/09_embedded/fpga_riscv/rtl/:
#
#   tb_rv32_wb_soc_smoke.vhd      / tb_rv64_wb_soc_smoke.vhd
#   tb_rv32_simpleos_boot.vhd     / tb_rv64_simpleos_boot.vhd
#   tb_rv32_simpleos_boot_axi.vhd / tb_rv64_simpleos_boot_axi.vhd
#
# Each pair comes from ONE templated generator parameterized by XlenConfig
# (Simple has no const generics, so the width is a runtime value threaded
# through the descriptors) plus a small per-variant descriptor struct. There is
# no rv32 fork and no rv64 fork of any file body: `generate_wb_soc_smoke`,
# `generate_simpleos_boot` and `generate_simpleos_boot_axi` each emit both
# siblings, and every section they assemble is either
#
#   * STRUCTURAL — entity, `use` clauses, signal/constant/variable declaration
#     groups (with group-local column alignment), DUT instantiation port maps,
#     memory-init impure functions and their file paths, the latency-injecting
#     AXI slave FSM (storage kind + byte width parameterized), assert/report
#     tables, terminal-marker chains, and the to_hstring debug-tap report; or
#   * a NAMED LITERAL paragraph in tb_wb_sections.spl, used only where the text
#     is irreducible (file-header prose reflowed per XLEN, fixed control-flow
#     glue with no parameter in it).
#
# XLEN-dependent everywhere: vector widths (xlen-1 downto 0), write-strobe
# width and byte-per-word divisor (xlen/8), to_unsigned() width argument,
# address literals (xlen/4 hex digits), and memory-init fill patterns.
#
# Determinism: arrays only, no Dict iteration during emission; every table is
# built and consumed in declaration order, so repeated generation is
# byte-identical.

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.gen_types.{VgMemInit, no_lines, vg_hex, vg_append, vg_spaces, emit_mem_init}
use std.hardware.vhdl_gen.tb_wb_types.*
use std.hardware.vhdl_gen.tb_wb_sections.*

fn tjl(lines: [text]) -> text:
    lines.join("\n")

# ---------------------------------------------------------------------------
# Shared XLEN-derived naming
# ---------------------------------------------------------------------------

# "RV32" / "RV64" — the report/assert marker prefix used by every testbench.
fn tb_tag(cfg: XlenConfig) -> text:
    "RV" + cfg.xlen.to_text()

# "rv32" / "rv64" — the entity-name infix.
fn tb_arch(cfg: XlenConfig) -> text:
    "rv" + cfg.xlen.to_text()

fn vec_ty(xlen: i64) -> text:
    "std_logic_vector(" + (xlen - 1).to_text() + " downto 0)"

fn uns_ty(xlen: i64) -> text:
    "unsigned(" + (xlen - 1).to_text() + " downto 0)"

fn hex_lit(v: i64, xlen: i64) -> text:
    "x\"" + vg_hex(v, xlen / 4) + "\""

# ---------------------------------------------------------------------------
# Per-variant descriptors
# ---------------------------------------------------------------------------

struct VgWbSocTb:
    marker: text           # UART marker string the smoke test hunts for
    dut_note: [text]       # comment lines before the DUT instantiation
    dut_entity: text
    run_window: text       # `wait for <run_window>;` before the asserts

struct VgBootTb:
    header: [text]         # file-header prose block
    core_entity: text
    timeout: text          # safety-timeout literal
    timeout_note: [text]   # extra comment lines above the timeout

struct VgBootAxiTb:
    header: [text]
    core_entity: text
    timeout: text
    ram_words: i64
    ram_note: text         # trailing comment on the RAM_WORDS constant
    rdisk_words: i64
    rdisk_note: text
    ram_mem_file: text
    rdisk_mem_file: text
    iface_note: text       # tail of the memory-interface comment line
    slave_note: [text]     # variant tail of the slave-process comment
    slave_in_signals: bool # rv32 backs the slave with architecture SIGNALS;
                           # rv64 must use process VARIABLES (net-count limit)

fn rv32_wb_desc() -> VgWbSocTb:
    VgWbSocTb(
        marker: "FPGA-RV32", dut_note: no_lines(),
        dut_entity: "soc_top_rv32_sim", run_window: "20 ms"
    )

fn rv64_wb_desc() -> VgWbSocTb:
    VgWbSocTb(
        marker: "SimpleOS RV64 FPGA", dut_note: rv64_wb_dut_note(),
        dut_entity: "soc_top_rv64_sim", run_window: "5 ms"
    )

fn rv32_boot_desc() -> VgBootTb:
    var note: [text] = []
    note = note.push("    -- Sized to give the ramdisk FS/ls/launch path headroom past the boot markers.")
    VgBootTb(
        header: vg_append(rv32_boot_header_lead(), boot_header_tap_note(false)),
        core_entity: "rv32_exec_core_flat", timeout: "200 ms", timeout_note: note
    )

fn rv64_boot_desc() -> VgBootTb:
    VgBootTb(
        header: vg_append(rv64_boot_header_lead(), boot_header_tap_note(true)),
        core_entity: "rv64_exec_core_flat", timeout: "400 ms", timeout_note: no_lines()
    )

fn rv32_axi_desc() -> VgBootAxiTb:
    var note: [text] = []
    note = note.push("  -- master to drop mem_req between transactions (the core does, 1-cycle gap).")
    VgBootAxiTb(
        header: vg_append(rv32_axi_header_lead(), axi_header_tap_note()),
        core_entity: "rv32_exec_core_axi", timeout: "1500 ms",
        ram_words: 4194304, ram_note: "-- 16 MiB",
        rdisk_words: 262144, rdisk_note: "-- 1 MiB",
        ram_mem_file: "rv32_flat.mem", rdisk_mem_file: "rv32_ramdisk.mem",
        iface_note: ".", slave_note: note, slave_in_signals: true
    )

fn rv64_axi_desc() -> VgBootAxiTb:
    var note: [text] = []
    note = note.push("  -- master to drop mem_req between transactions (the core does, >=1-cycle gap).")
    note = note.push("  -- The 80 MB / 1 MB arrays are process VARIABLES (see header).")
    VgBootAxiTb(
        header: vg_append(rv64_axi_header_lead(), axi_header_tap_note()),
        core_entity: "rv64_exec_core_axi", timeout: "3000 ms",
        ram_words: 10000000, ram_note: "-- 80 MiB, covers _kernel_end",
        rdisk_words: 131072, rdisk_note: "-- 1 MiB",
        ram_mem_file: "rv64_flat.mem", rdisk_mem_file: "rv64_ramdisk.mem",
        iface_note: ", 64-bit.", slave_note: note, slave_in_signals: false
    )

# ---------------------------------------------------------------------------
# Shared structural sections
# ---------------------------------------------------------------------------

# clk / rst / uart_tx — present in all six testbenches.
fn clock_reset_decls() -> [VgDeclSpec]:
    var d: [VgDeclSpec] = []
    d = d.push(vg_sig("clk", "std_logic", "'0'"))
    d = d.push(vg_sig("rst", "std_logic", "'1'"))
    d = d.push(vg_sig("uart_tx", "std_logic", ""))
    d

# Parallel debug-tap signals of the flat/axi cores. debug_ins is always 32 bits
# (RISC-V instructions are 32-bit at both XLENs); the register taps are XLEN.
fn debug_tap_decl_names() -> [text]:
    var n: [text] = []
    n = n.push("pc")
    n = n.push("ins")
    n = n.push("a0")
    n = n.push("ra")
    n = n.push("sp")
    n

fn debug_tap_decls(xlen: i64) -> [VgDeclSpec]:
    var d: [VgDeclSpec] = []
    d = d.push(vg_sig_w("debug_uart_valid", 17, "std_logic", ""))
    d = d.push(vg_sig_w("debug_uart_byte", 17, "std_logic_vector(7 downto 0)", ""))
    val names = debug_tap_decl_names()
    var i = 0
    while i < names.len():
        var w = xlen
        if names[i] == "ins":
            w = 32
        d = d.push(vg_sig_w("debug_" + names[i], 12, vec_ty(w), ""))
        i = i + 1
    d

# The core-facing declaration block shared by the four SimpleOS-boot lanes.
fn boot_core_decls(xlen: i64) -> [VgDeclSpec]:
    var d = clock_reset_decls()
    var taps = debug_tap_decls(xlen)
    var i = 0
    while i < taps.len():
        d = d.push(taps[i])
        i = i + 1
    d = d.push(vg_sig("done", "boolean", "false"))
    d

# Identity port-map rows shared by the four SimpleOS-boot lanes.
fn boot_core_rows() -> [VgAssocRow]:
    var r: [VgAssocRow] = []
    var a: [text] = []
    a = a.push("clk")
    a = a.push("rst")
    a = a.push("uart_tx")
    r = r.push(vg_row(a))
    var b: [text] = []
    b = b.push("debug_uart_valid")
    b = b.push("debug_uart_byte")
    r = r.push(vg_row(b))
    var c: [text] = []
    c = c.push("debug_pc")
    c = c.push("debug_ins")
    c = c.push("debug_a0")
    r = r.push(vg_row(c))
    var e: [text] = []
    e = e.push("debug_ra")
    e = e.push("debug_sp")
    r = r.push(vg_row(e))
    r

fn core_generic_map() -> text:
    "CLK_FREQ => 1_000_000, BAUD_RATE => 115_200"

# The terminal markers every SimpleOS-boot testbench stops on.
fn boot_terminal_markers() -> [VgTermMarker]:
    var m: [VgTermMarker] = []
    m = m.push(vg_term("TEST FAILED", "TEST_FAILED (honest FS-probe wall)"))
    m = m.push(vg_term("TEST PASSED", "TEST_PASSED"))
    m

# UART byte -> line accumulator process (shared by all four boot lanes).
fn uart_line_process(tag: text) -> [text]:
    var v: [VgDeclSpec] = []
    v = v.push(vg_var_w("lbuf", 5, "string(1 to 256)", "(others => ' ')"))
    v = v.push(vg_var_w("llen", 5, "natural", "0"))
    v = v.push(vg_var_w("ch", 5, "character", ""))
    var l = uart_line_process_comment()
    l = l.push("  process(clk)")
    l = vg_append(l, emit_decls(v, 4))
    l = vg_append(l, uart_line_intake())
    l = l.push("          report \"" + tag + "_UART_LINE: \" & lbuf(1 to llen) severity note;")
    l = vg_append(l, emit_term_markers(10, tag, boot_terminal_markers()))
    l = vg_append(l, uart_line_buffer_tail())
    l

# Safety-timeout watchdog that dumps the debug taps (shared by all four boot
# lanes; only the window and the explanatory note differ).
fn boot_stuck_process(tag: text, timeout: text, note: [text]) -> [text]:
    var l: [text] = []
    l = l.push("  process")
    l = l.push("  begin")
    l = vg_append(l, boot_stuck_timeout_note())
    l = vg_append(l, note)
    l = l.push("    wait for " + timeout + ";")
    l = l.push("    if not done then")
    l = vg_append(l, emit_hstring_report(6, tag, "BOOT_STUCK", debug_tap_decl_names()))
    var tail_marker: [text] = []
    tail_marker = tail_marker.push("BOOT_STUCK: no terminal marker within window")
    l = vg_append(l, emit_reports(6, tag, tail_marker))
    l = vg_append(l, boot_stuck_tail())
    l

# ---------------------------------------------------------------------------
# Pair 1 — tb_rv{32,64}_wb_soc_smoke
# ---------------------------------------------------------------------------

fn wb_uses() -> [text]:
    var u: [text] = []
    u = u.push("ieee.std_logic_1164")
    u = u.push("std.env")
    u

fn wb_decls(d: VgWbSocTb) -> [VgDeclSpec]:
    var s = clock_reset_decls()
    s = s.push(vg_sig("tx_seen", "std_logic", "'0'"))
    s = s.push(vg_sig("byte_seen", "std_logic", "'0'"))
    s = s.push(vg_sig("marker_seen", "std_logic", "'0'"))
    s = s.push(vg_const("MARKER", "string", "\"" + d.marker + "\""))
    s = s.push(vg_sig("marker_idx", "natural range 1 to MARKER'length + 1", "1"))
    s = s.push(vg_sig("last_tx", "std_logic", "'1'"))
    s = s.push(vg_const("BIT_TIME", "time", "8680 ns"))
    s

fn wb_assoc_list() -> [VgAssoc]:
    var a: [VgAssoc] = []
    a = a.push(vg_ident("clk"))
    a = a.push(vg_ident("rst"))
    a = a.push(vg_ident("uart_tx"))
    a = a.push(vg_assoc("uart_rx", "'1'"))
    a

fn wb_assert_table() -> [VgAssertSpec]:
    var a: [VgAssertSpec] = []
    a = a.push(vg_assert("tx_seen", "UART_TX_ACTIVITY_MISSING"))
    a = a.push(vg_assert("byte_seen", "UART_BYTE_MISSING"))
    a = a.push(vg_assert("marker_seen", "UART_MARKER_MISSING"))
    a

fn wb_seen_markers() -> [text]:
    var m: [text] = []
    m = m.push("UART_TX_ACTIVITY_SEEN")
    m = m.push("UART_BYTE_SEEN")
    m = m.push("UART_MARKER_SEEN")
    m

fn wb_main_process(tag: text, d: VgWbSocTb) -> [text]:
    var l: [text] = []
    l = l.push("  process")
    l = l.push("  begin")
    l = l.push("    wait for 200 ns;")
    l = l.push("    rst <= '0';")
    l = l.push("    wait for " + d.run_window + ";")
    l = vg_append(l, emit_asserts(4, tag, wb_assert_table()))
    l = vg_append(l, emit_reports(4, tag, wb_seen_markers()))
    l = l.push("    wait;")
    l = l.push("  end process;")
    l

fn wb_decode_process(tag: text) -> [text]:
    var v: [VgDeclSpec] = []
    v = v.push(vg_var_w("byte_value", 11, "integer", "0"))
    var l: [text] = []
    l = l.push("  process")
    l = vg_append(l, emit_decls(v, 4))
    l = vg_append(l, wb_decode_sample_loop())
    l = l.push("      report \"" + tag + "_UART_BYTE_VALUE=\" & integer'image(byte_value) severity note;")
    l = vg_append(l, wb_marker_match_open())
    l = vg_append(l, emit_reports(10, tag, wb_seen_markers()))
    l = vg_append(l, wb_marker_match_close())
    var one: [text] = []
    one = one.push("UART_BYTE_SEEN")
    l = vg_append(l, emit_reports(6, tag, one))
    l = vg_append(l, wb_decode_loop_tail())
    l

fn wb_desc_for(cfg: XlenConfig) -> VgWbSocTb:
    if cfg.is_rv32():
        rv32_wb_desc()
    else:
        rv64_wb_desc()

# Public entry: ONE template for both siblings of the WB-SoC smoke pair.
fn generate_wb_soc_smoke(cfg: XlenConfig) -> text:
    val d = wb_desc_for(cfg)
    val tag = tb_tag(cfg)
    val ent = "tb_" + tb_arch(cfg) + "_wb_soc_smoke"
    var parts: [text] = []
    parts = parts.push(tjl(emit_use_clauses(wb_uses())))
    parts = parts.push("")
    parts = parts.push(tjl(emit_tb_entity(ent)))
    parts = parts.push("")
    parts = parts.push("architecture sim of " + ent + " is")
    parts = parts.push(tjl(emit_decls(wb_decls(d), 2)))
    parts = parts.push("begin")
    parts = parts.push("  clk <= not clk after 5 ns;")
    parts = parts.push("")
    parts = parts.push(tjl(emit_dut_vertical(d.dut_note, "dut", d.dut_entity, wb_assoc_list())))
    parts = parts.push("")
    parts = parts.push(tjl(wb_main_process(tag, d)))
    parts = parts.push("")
    parts = parts.push(tjl(wb_edge_detect_process()))
    parts = parts.push("")
    parts = parts.push(tjl(wb_decode_process(tag)))
    parts = parts.push("end architecture sim;")
    parts.join("\n") + "\n"

# ---------------------------------------------------------------------------
# Pair 2 — tb_rv{32,64}_simpleos_boot (flat core, internal RAM)
# ---------------------------------------------------------------------------

fn boot_uses() -> [text]:
    var u: [text] = []
    u = u.push("ieee.std_logic_1164")
    u = u.push("ieee.numeric_std")
    u = u.push("std.env")
    u

fn boot_desc_for(cfg: XlenConfig) -> VgBootTb:
    if cfg.is_rv32():
        rv32_boot_desc()
    else:
        rv64_boot_desc()

# Public entry: ONE template for both siblings of the flat-core boot pair.
fn generate_simpleos_boot(cfg: XlenConfig) -> text:
    val d = boot_desc_for(cfg)
    val tag = tb_tag(cfg)
    val ent = "tb_" + tb_arch(cfg) + "_simpleos_boot"
    var parts: [text] = []
    parts = parts.push(tjl(d.header))
    parts = parts.push(tjl(emit_use_clauses(boot_uses())))
    parts = parts.push("")
    parts = parts.push(tjl(emit_tb_entity(ent)))
    parts = parts.push("")
    parts = parts.push("architecture sim of " + ent + " is")
    parts = parts.push(tjl(emit_decls(boot_core_decls(cfg.xlen), 2)))
    parts = parts.push("begin")
    parts = parts.push("  clk <= not clk after 5 ns;")
    parts = parts.push("")
    parts = parts.push(tjl(emit_dut_grouped("u_core", d.core_entity, core_generic_map(), boot_core_rows())))
    parts = parts.push("")
    parts = parts.push(tjl(tb_reset_release_process()))
    parts = parts.push("")
    parts = parts.push(tjl(uart_line_process(tag)))
    parts = parts.push("")
    parts = parts.push(tjl(boot_stuck_process(tag: tag, timeout: d.timeout, note: d.timeout_note)))
    parts = parts.push("end architecture sim;")
    parts.join("\n") + "\n"

# ---------------------------------------------------------------------------
# Pair 3 — tb_rv{32,64}_simpleos_boot_axi (synthesizable core + latency slave)
# ---------------------------------------------------------------------------

fn axi_uses() -> [text]:
    var u: [text] = []
    u = u.push("ieee.std_logic_1164")
    u = u.push("ieee.numeric_std")
    u = u.push("std.textio")
    u = u.push("ieee.std_logic_textio")
    u = u.push("std.env")
    u

# External synchronous memory interface (core master <-> tb slave).
fn axi_iface_decls(xlen: i64, iface_note: text) -> [VgDeclSpec]:
    val bpw = xlen / 8
    var pre: [text] = []
    pre = pre.push("  -- External synchronous memory interface (core master <-> tb slave)" + iface_note)
    var d: [VgDeclSpec] = []
    d = d.push(vg_with_pre(vg_sig_w("mem_req", 11, "std_logic", ""), pre))
    d = d.push(vg_sig_w("mem_we", 11, "std_logic", ""))
    d = d.push(vg_sig_w("mem_addr", 11, vec_ty(xlen), ""))
    d = d.push(vg_sig_w("mem_wdata", 11, vec_ty(xlen), ""))
    d = d.push(vg_sig_w("mem_wstrb", 11, "std_logic_vector(" + (bpw - 1).to_text() + " downto 0)", ""))
    d = d.push(vg_sig_w("mem_rdata", 11, vec_ty(xlen), "(others => '0')"))
    d = d.push(vg_sig_w("mem_rvalid", 11, "std_logic", "'0'"))
    d

fn axi_store_decls(xlen: i64, d: VgBootAxiTb) -> [VgDeclSpec]:
    var pre: [text] = []
    pre = pre.push("  -- Behavioral memory slave backing store (the GHDL stand-in for PS DDR).")
    var s: [VgDeclSpec] = []
    s = s.push(vg_with_pre(vg_decl_w(kind: "constant", name: "BASE_ADDR", name_w: 11, ty: uns_ty(xlen), init: hex_lit(v: 0x80000000, xlen: xlen)), pre))
    s = s.push(vg_const_w_trail(name: "RAM_WORDS", name_w: 11, ty: "natural", init: d.ram_words.to_text(), trail: d.ram_note))
    s = s.push(vg_decl_w(kind: "constant", name: "RDISK_BASE", name_w: 11, ty: uns_ty(xlen), init: hex_lit(v: 0x88000000, xlen: xlen)))
    s = s.push(vg_const_w_trail(name: "RDISK_WORDS", name_w: 11, ty: "natural", init: d.rdisk_words.to_text(), trail: d.rdisk_note))
    s

fn emit_array_type(name: text, bound: text, xlen: i64) -> text:
    "  type " + name + " is array(0 to " + bound + " - 1) of " + vec_ty(xlen) + ";"

fn axi_ram_init_desc(d: VgBootAxiTb, xlen: i64) -> VgMemInit:
    VgMemInit(
        fn_name: "init_ram", ret_ty: "ram_t", file_name: d.ram_mem_file,
        line_var: "line_v", word_var: "word_v", mem_var: "mem_v",
        width: xlen, fill_hex: vg_hex(0, xlen / 4), fill_comment: "",
        bound_const: "RAM_WORDS", aligned: false
    )

# The slave's backing arrays and FSM state. Identical declaration list and
# identical column widths in both siblings — only the storage kind (signal vs
# variable) and the scope indent differ, so it is emitted once.
fn slave_state_decls(kind: text, indent: i64, blank_before_type: bool) -> [text]:
    var pre: [text] = []
    if blank_before_type:
        pre = pre.push("")
    pre = pre.push(vg_spaces(indent) + "type slv_state_t is (SLV_IDLE, SLV_WAIT, SLV_RESP);")
    var s: [VgDeclSpec] = []
    s = s.push(vg_decl_w(kind, "ram", 6, "ram_t", "init_ram"))
    s = s.push(vg_decl_w(kind, "rdisk", 6, "rdisk_t", "init_rdisk"))
    s = s.push(vg_with_pre(vg_decl_w(kind, "slv_state", 11, "slv_state_t", "SLV_IDLE"), pre))
    s = s.push(vg_decl_w(kind, "wait_cnt", 11, "natural", "0"))
    s = s.push(vg_decl_w(kind, "lat_target", 11, "natural", "1"))
    s = s.push(vg_decl_w(kind, "acc_idx", 11, "natural", "0"))
    emit_decls(s, indent)

fn slave_local_decls(xlen: i64) -> [VgDeclSpec]:
    var s: [VgDeclSpec] = []
    s = s.push(vg_var_w("a", 8, uns_ty(xlen), ""))
    s = s.push(vg_var_w("idx", 8, "natural", ""))
    s = s.push(vg_var_w("rd_word", 8, vec_ty(xlen), ""))
    s = s.push(vg_var_w("wr_word", 8, vec_ty(xlen), ""))
    s = s.push(vg_var_w("in_ram_r", 10, "boolean", ""))
    s = s.push(vg_var_w("in_rdsk_r", 10, "boolean", ""))
    s

# Latency-injecting slave FSM. `st` is the state-update operator: "<=" when the
# slave state lives in architecture signals (rv32), ":=" when it lives in
# process variables (rv64). `bpw` is bytes per bus word (xlen / 8).
fn emit_axi_slave_fsm(st: text, xlen: i64) -> [text]:
    val bpw = xlen / 8
    val b = bpw.to_text()
    val xw = xlen.to_text()
    var l: [text] = []
    l = l.push("  begin")
    l = l.push("    if rising_edge(clk) then")
    l = l.push("      mem_rvalid <= '0';")
    l = l.push("      if rst = '1' then")
    l = l.push("        slv_state " + st + " SLV_IDLE;")
    l = l.push("        wait_cnt " + st + " 0;")
    l = l.push("        acc_idx " + st + " 0;")
    l = l.push("        mem_rvalid <= '0';")
    l = l.push("      else")
    l = l.push("        case slv_state is")
    l = l.push("          when SLV_IDLE =>")
    l = l.push("            if mem_req = '1' then")
    l = l.push("              lat_target " + st + " 1 + (acc_idx mod 4);  -- vary wait-states 1..4")
    l = l.push("              acc_idx " + st + " acc_idx + 1;")
    l = l.push("              wait_cnt " + st + " 0;")
    l = l.push("              slv_state " + st + " SLV_WAIT;")
    l = l.push("            end if;")
    l = l.push("          when SLV_WAIT =>")
    l = l.push("            if wait_cnt >= lat_target - 1 then")
    l = l.push("              a := unsigned(mem_addr);")
    l = l.push("              in_ram_r := (a >= BASE_ADDR) and (a < BASE_ADDR + to_unsigned(RAM_WORDS * " + b + ", " + xw + "));")
    l = l.push("              in_rdsk_r := (a >= RDISK_BASE) and (a < RDISK_BASE + to_unsigned(RDISK_WORDS * " + b + ", " + xw + "));")
    l = l.push("              if in_ram_r then")
    l = l.push("                idx := to_integer((a - BASE_ADDR)) / " + b + ";")
    l = l.push("                rd_word := ram(idx);")
    l = l.push("              elsif in_rdsk_r then")
    l = l.push("                idx := to_integer((a - RDISK_BASE)) / " + b + ";")
    l = l.push("                rd_word := rdisk(idx);")
    l = l.push("              else")
    l = l.push("                idx := 0;")
    l = l.push("                rd_word := (others => '0');")
    l = l.push("              end if;")
    l = l.push("              if mem_we = '1' then")
    l = l.push("                -- Apply byte-enables (read-modify-write in the slave).")
    l = l.push("                wr_word := rd_word;")
    l = l.push("                for i in 0 to " + (bpw - 1).to_text() + " loop")
    l = l.push("                  if mem_wstrb(i) = '1' then")
    l = l.push("                    wr_word(i * 8 + 7 downto i * 8) := mem_wdata(i * 8 + 7 downto i * 8);")
    l = l.push("                  end if;")
    l = l.push("                end loop;")
    l = l.push("                if in_ram_r then")
    l = l.push("                  ram(idx) " + st + " wr_word;")
    l = l.push("                elsif in_rdsk_r then")
    l = l.push("                  rdisk(idx) " + st + " wr_word;")
    l = l.push("                end if;")
    l = l.push("                mem_rdata <= (others => '0');")
    l = l.push("              else")
    l = l.push("                mem_rdata <= rd_word;")
    l = l.push("              end if;")
    l = l.push("              mem_rvalid <= '1';")
    l = l.push("              slv_state " + st + " SLV_RESP;")
    l = l.push("            else")
    l = l.push("              wait_cnt " + st + " wait_cnt + 1;")
    l = l.push("            end if;")
    l = l.push("          when SLV_RESP =>")
    l = l.push("            -- rvalid pulsed for one cycle above; wait for req to drop (>=1")
    l = l.push("            -- cycle idle gap) before accepting the next transaction.")
    l = l.push("            if mem_req = '0' then")
    l = l.push("              slv_state " + st + " SLV_IDLE;")
    l = l.push("            end if;")
    l = l.push("        end case;")
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

fn axi_slave_process(d: VgBootAxiTb, xlen: i64) -> [text]:
    var l = axi_slave_process_comment_head()
    l = vg_append(l, d.slave_note)
    l = l.push("  process(clk)")
    var st = ":="
    if d.slave_in_signals:
        st = "<="
    else:
        l = vg_append(l, slave_state_decls(kind: "variable", indent: 4, blank_before_type: false))
    l = vg_append(l, emit_decls(slave_local_decls(xlen), 4))
    l = vg_append(l, emit_axi_slave_fsm(st, xlen))
    l

fn axi_core_rows() -> [VgAssocRow]:
    var base = boot_core_rows()
    var r: [VgAssocRow] = []
    r = r.push(base[0])
    var a: [text] = []
    a = a.push("mem_req")
    a = a.push("mem_we")
    a = a.push("mem_addr")
    r = r.push(vg_row(a))
    var b: [text] = []
    b = b.push("mem_wdata")
    b = b.push("mem_wstrb")
    r = r.push(vg_row(b))
    var c: [text] = []
    c = c.push("mem_rdata")
    c = c.push("mem_rvalid")
    r = r.push(vg_row(c))
    var i = 1
    while i < base.len():
        r = r.push(base[i])
        i = i + 1
    r

fn axi_desc_for(cfg: XlenConfig) -> VgBootAxiTb:
    if cfg.is_rv32():
        rv32_axi_desc()
    else:
        rv64_axi_desc()

# Public entry: ONE template for both siblings of the AXI-lane boot pair.
# `mem_prefix` is prepended to the .mem file names (default "" reproduces the
# golden's relative form; harness runs may pass an absolute directory prefix).
fn generate_simpleos_boot_axi(cfg: XlenConfig, mem_prefix: text) -> text:
    val d = axi_desc_for(cfg)
    val tag = tb_tag(cfg)
    val xlen = cfg.xlen
    val ent = "tb_" + tb_arch(cfg) + "_simpleos_boot_axi"
    var parts: [text] = []
    parts = parts.push(tjl(d.header))
    parts = parts.push(tjl(emit_use_clauses(axi_uses())))
    parts = parts.push("")
    parts = parts.push(tjl(emit_tb_entity(ent)))
    parts = parts.push("")
    parts = parts.push("architecture sim of " + ent + " is")
    parts = parts.push(tjl(emit_decls(boot_core_decls(xlen), 2)))
    parts = parts.push("")
    parts = parts.push(tjl(emit_decls(axi_iface_decls(xlen, d.iface_note), 2)))
    parts = parts.push("")
    var store = emit_decls(axi_store_decls(xlen, d), 2)
    store = store.push(emit_array_type(name: "ram_t", bound: "RAM_WORDS", xlen: xlen))
    store = store.push(emit_array_type(name: "rdisk_t", bound: "RDISK_WORDS", xlen: xlen))
    parts = parts.push(tjl(store))
    parts = parts.push("")
    parts = parts.push(tjl(emit_mem_init(axi_ram_init_desc(d, xlen), mem_prefix)))
    parts = parts.push("")
    parts = parts.push(tjl(emit_mem_init_optional(
        "init_rdisk", "rdisk_t", d.rdisk_mem_file, mem_prefix,
        xlen, vg_hex(0, xlen / 4), "RDISK_WORDS")))
    if d.slave_in_signals:
        parts = parts.push("")
        parts = parts.push(tjl(slave_state_decls(kind: "signal", indent: 2, blank_before_type: true)))
    parts = parts.push("begin")
    parts = parts.push("  clk <= not clk after 5 ns;")
    parts = parts.push("")
    parts = parts.push(tjl(emit_dut_grouped("u_core", d.core_entity, core_generic_map(), axi_core_rows())))
    parts = parts.push("")
    parts = parts.push(tjl(tb_reset_release_process()))
    parts = parts.push("")
    parts = parts.push(tjl(axi_slave_process(d, xlen)))
    parts = parts.push("")
    parts = parts.push(tjl(uart_line_process(tag)))
    parts = parts.push("")
    parts = parts.push(tjl(boot_stuck_process(tag: tag, timeout: d.timeout, note: boot_stuck_axi_note())))
    parts = parts.push("end architecture sim;")
    parts.join("\n") + "\n"

# ---------------------------------------------------------------------------
# Convenience entries (per-file wrappers over the three paired templates)
# ---------------------------------------------------------------------------

fn generate_rv32_wb_soc_smoke() -> text:
    generate_wb_soc_smoke(XlenConfig.rv32())

fn generate_rv64_wb_soc_smoke() -> text:
    generate_wb_soc_smoke(XlenConfig.rv64())

fn generate_rv32_simpleos_boot() -> text:
    generate_simpleos_boot(XlenConfig.rv32())

fn generate_rv64_simpleos_boot() -> text:
    generate_simpleos_boot(XlenConfig.rv64())

fn generate_rv32_simpleos_boot_axi(mem_prefix: text) -> text:
    generate_simpleos_boot_axi(XlenConfig.rv32(), mem_prefix)

fn generate_rv64_simpleos_boot_axi(mem_prefix: text) -> text:
    generate_simpleos_boot_axi(XlenConfig.rv64(), mem_prefix)
