# Named literal paragraphs for the KV260 DDR-boot testbench pair
# (tb_rv32_k26_ddr_boot.vhd / tb_rv64_k26_ddr_boot.vhd).
#
# ONLY irreducible prose / fixed behavioural VHDL paragraphs live here. Every
# paragraph that varies with XLEN in a *computable* way (widths, word
# addresses, byte lanes, signal tables, port maps, memory-init bodies) is
# emitted structurally in tb_k26_ddr_gen.spl instead.
#
# Naming: k26_sh_* = byte-identical in BOTH members of the XLEN pair;
#         k26_rv32_* / k26_rv64_* = member-specific prose.
#
# Determinism: arrays only, no Dict iteration anywhere.

# ---------------------------------------------------------------------------
# File-header prose
# ---------------------------------------------------------------------------

fn k26_rv32_header_lead() -> [text]:
    var l: [text] = []
    l = l.push("-- tb_rv32_k26_ddr_boot: pre-silicon rehearsal of the EXACT KV260 bring-up path.")
    l = l.push("--")
    l = l.push("-- Unlike tb_rv32_simpleos_boot_axi (which wires a behavioral slave straight to")
    l = l.push("-- the core's mem_* port), this testbench drives soc_top_rv32_k26_ddr -- the real")
    l = l.push("-- PL top -- so it exercises the two pieces that only exist on silicon:")
    l = l.push("--")
    l = l.push("--   1. rv32_axi4_mem_adapter, turning mem_* into full AXI4 (AW/W/B/AR/R) and")
    l = l.push("--      REMAPPING core 0x80000000/0x88000000 into the DDR aperture, because on")
    l = l.push("--      ZynqMP 0x80000000+ is not memory. The AXI4 slave model here therefore")
    l = l.push("--      backs DDR at G_DDR_BASE, and the boot only works if the remap is right.")
    l = l.push("--   2. rv32_ctrl_obs_slave, the AXI4-Lite control/observation path. The")
    l = l.push("--      transcript below is recovered the SAME way the board flow recovers it:")
    l = l.push("--      poll UART_COUNT, then read the capture buffer over AXI-Lite. Nothing is")
    l = l.push("--      tapped from inside the DUT. If this transcript is right, the JTAG")
    l = l.push("--      readout on silicon is reading a path already proven here.")
    l

fn k26_rv64_header_lead() -> [text]:
    var l: [text] = []
    l = l.push("-- tb_rv64_k26_ddr_boot: pre-silicon rehearsal of the EXACT KV260 bring-up path")
    l = l.push("-- for the rv64 soft-core. Direct 64-bit mirror of tb_rv32_k26_ddr_boot.")
    l = l.push("--")
    l = l.push("-- Drives soc_top_rv64_k26_ddr -- the real PL top that gets synthesized -- so it")
    l = l.push("-- exercises the two pieces that only exist on silicon:")
    l = l.push("--")
    l = l.push("--   1. rv64_axi4_mem_adapter, turning the 64-bit mem_* port into full AXI4")
    l = l.push("--      (AW/W/B/AR/R) and REMAPPING core 0x80200000/0x88000000 into the DDR")
    l = l.push("--      aperture, because on ZynqMP 0x80000000+ is not memory. The AXI4 slave")
    l = l.push("--      model here backs DDR at G_DDR_BASE, and the boot only works if the")
    l = l.push("--      remap is right.")
    l = l.push("--   2. rv32_ctrl_obs_slave (reused unchanged), the AXI4-Lite control /")
    l = l.push("--      observation path. The transcript below is recovered the SAME way the")
    l = l.push("--      board flow recovers it: poll UART_COUNT, then read the capture buffer")
    l = l.push("--      over AXI-Lite. Nothing is tapped from inside the DUT.")
    l

# Shared closing paragraph of both file headers.
fn k26_sh_header_tail() -> [text]:
    var l: [text] = []
    l = l.push("--")
    l = l.push("-- The AXI slave injects varying wait-states on both channels so the adapter is")
    l = l.push("-- never tested against an unrealistically prompt memory.")
    l

# rv64-only: the .bss-zeroing rationale added by commit dae8b497135.
fn k26_rv64_header_bss() -> [text]:
    var l: [text] = []
    l = l.push("--")
    l = l.push("-- .bss ZEROING: exactly like the board flow (bringup_kv260_rv64_ddr.shs step")
    l = l.push("-- 5b), init_ram zeroes the kernel's .bss span AFTER loading the image. Real")
    l = l.push("-- power-up DDR4 is garbage; the kernel assumes zero .bss (g_heap_off at")
    l = l.push("-- 0x80208008 -- garbage there makes every allocation fail: the rv32 lane's")
    l = l.push("-- canary-only park). Run with G_GARBAGE_FILL=true to prove the zeroed span is")
    l = l.push("-- COMPLETE for rv64: the boot must still pass when everything the board does")
    l = l.push("-- not load or zero is trash.")
    l

# ---------------------------------------------------------------------------
# Entity-generic pre-comments
# ---------------------------------------------------------------------------

fn k26_rv32_garbage_generic_doc() -> [text]:
    var l: [text] = []
    l = l.push("    -- Real PS DDR4 is NOT zeroed at power-up. GHDL/QEMU always hand the")
    l = l.push("    -- kernel pristine zero RAM, which masks any reliance on implicit")
    l = l.push("    -- zero-initialised .bss (e.g. g_heap_off at 0x80007004: garbage there")
    l = l.push("    -- makes every rv_alloc return null and every rt_string-based println")
    l = l.push("    -- print an empty line). Set true to fill all DDR words beyond the")
    l = l.push("    -- loaded kernel image with a deterministic nonzero pseudo-random")
    l = l.push("    -- pattern, rehearsing what silicon actually provides.")
    l

fn k26_rv64_garbage_generic_doc() -> [text]:
    var l: [text] = []
    l = l.push("    -- Real PS DDR4 is NOT zeroed at power-up; GHDL hands out pristine zero")
    l = l.push("    -- arrays, which masks any reliance on implicit zero-initialised memory")
    l = l.push("    -- beyond the .bss span the bring-up explicitly zeroes. Set true to fill")
    l = l.push("    -- all DDR words beyond the loaded kernel image with deterministic nonzero")
    l = l.push("    -- pseudo-random garbage, rehearsing what silicon actually provides.")
    l

fn k26_rv64_skip_bss_generic_doc() -> [text]:
    var l: [text] = []
    l = l.push("    -- Skip the tb's board-step-5b .bss zeroing. Combined with")
    l = l.push("    -- G_GARBAGE_FILL=true this hands the kernel garbage .bss — the run")
    l = l.push("    -- passing then proves the kernel's own crt0 .bss-zero loop works with")
    l = l.push("    -- ZERO loader cooperation (board-runnable rule). Default false keeps the")
    l = l.push("    -- historical board-flow rehearsal unchanged.")
    l

# ---------------------------------------------------------------------------
# Declaration-region prose
# ---------------------------------------------------------------------------

# rv64-only pre-comment on the RAM_WORDS constant.
fn k26_rv64_ram_words_doc() -> [text]:
    var l: [text] = []
    l = l.push("  -- 80 MiB of 64-bit words: covers the kernel span core 0x80200000..0x84A20000")
    l = l.push("  -- (.text .. .heap end, ~74 MB behind the 2 MB front pad).")
    l

# rv64-only pre-comment on the BSS_W0 constant.
fn k26_rv64_bss_const_doc() -> [text]:
    var l: [text] = []
    l = l.push("  -- .bss span from llvm-readelf on simpleos_riscv64_smf_fs.elf:")
    l = l.push("  -- core 0x80205000 size 0x1A004 -> DDR offset 0x205000, zeroed in 27 pages")
    l = l.push("  -- (0x1B000 bytes) exactly like the board's bss_zeros.bin dow. The 0xFFC")
    l = l.push("  -- spill past .bss lands in .stack, which needs no preserved content.")
    l

# Garbage-fill rationale inside init_ram.
fn k26_rv32_garbage_fill_doc() -> [text]:
    var l: [text] = []
    l = l.push("      -- xorshift32: deterministic nonzero garbage in every word, standing in")
    l = l.push("      -- for un-zeroed power-up DDR4 content. The kernel image is loaded OVER")
    l = l.push("      -- this below, so only .bss/heap/stack and unused DDR stay garbage --")
    l = l.push("      -- exactly the silicon situation (board loads only kernel + ramdisk).")
    l

fn k26_rv64_garbage_fill_doc() -> [text]:
    var l: [text] = []
    l = l.push("      -- xorshift64: deterministic nonzero garbage in every word, standing in")
    l = l.push("      -- for un-zeroed power-up DDR4 content. The kernel image is loaded OVER")
    l = l.push("      -- this below and .bss is then zeroed exactly as the board flow does, so")
    l = l.push("      -- stack/heap/unused DDR stay garbage -- the silicon situation.")
    l

# rv64-only board-step-5b rationale, emitted above the generated zeroing loop.
fn k26_rv64_bss_zero_doc() -> [text]:
    var l: [text] = []
    l = l.push("    -- Board step 5b: zero .bss (belt-and-suspenders; the kernel now also")
    l = l.push("    -- self-zeroes .bss in _start). G_SKIP_BSS_ZERO=true disables this to")
    l = l.push("    -- prove the kernel's crt0 loop alone suffices under garbage DDR.")
    l

# Why ram/rdisk are process variables (host-RSS numbers differ per member).
fn k26_rv32_process_var_doc() -> [text]:
    var l: [text] = []
    l = l.push("  -- ram/rdisk are PROCESS VARIABLES, not signals: a 16 Mi-word GHDL signal")
    l = l.push("  -- array carries per-element driver/event machinery and cost ~45 GB of host")
    l = l.push("  -- RSS. As variables the same backing store is a few hundred MB.")
    l

fn k26_rv64_process_var_doc() -> [text]:
    var l: [text] = []
    l = l.push("  -- ram/rdisk are PROCESS VARIABLES, not signals: a 10 Mi-word GHDL signal")
    l = l.push("  -- array carries per-element driver/event machinery (tens of GB of host RSS);")
    l = l.push("  -- as variables the same backing store is well under 1 GB.")
    l

# ---------------------------------------------------------------------------
# ddr_slave process — fixed handshake paragraphs (shared)
# ---------------------------------------------------------------------------

# Reset arm + one-shot deassert defaults + `case phase is` / `when 0 =>` up to
# the point the read/write banks are generated.
fn k26_sh_ddr_slave_reset(with_trace: bool) -> [text]:
    var l: [text] = []
    l = l.push("  begin")
    l = l.push("    if rising_edge(clk) then")
    l = l.push("      if rst_n = '0' then")
    l = l.push("        arready <= '0'; rvalid <= '0'; rlast <= '0';")
    l = l.push("        awready <= '0'; wready <= '0'; bvalid <= '0';")
    if with_trace:
        l = l.push("        trace_reads <= 0; trace_writes <= 0;")
    l = l.push("        phase := 0; jitter := 1;")
    l = l.push("      else")
    l = l.push("        -- default deasserts for one-shot handshakes")
    l = l.push("        if rvalid = '1' and rready = '1' then rvalid <= '0'; rlast <= '0'; end if;")
    l = l.push("        if bvalid = '1' and bready = '1' then bvalid <= '0'; end if;")
    l = l.push("        arready <= '0';")
    l = l.push("        awready <= '0';")
    l = l.push("        wready  <= '0';")
    l = l.push("")
    l = l.push("        case phase is")
    l = l.push("          when 0 =>")
    l = l.push("            if arvalid = '1' then")
    l = l.push("              arready <= '1';")
    l = l.push("              saved_addr := unsigned(araddr);")
    if with_trace:
        l = l.push("              if G_TRACE_BYTES > 0 and")
        l = l.push("                 saved_addr >= G_TRACE_BASE and")
        l = l.push("                 saved_addr < G_TRACE_BASE + G_TRACE_BYTES then")
        l = l.push("                trace_reads <= trace_reads + 1;")
        l = l.push("              end if;")
    l = l.push("              jitter := (jitter mod 4) + 1;")
    l = l.push("              wait_n := jitter;")
    l = l.push("              phase := 1;")
    l = l.push("            elsif awvalid = '1' and wvalid = '1' then")
    l = l.push("              awready <= '1';")
    l = l.push("              wready  <= '1';")
    l = l.push("              saved_addr := unsigned(awaddr);")
    if with_trace:
        l = l.push("              if G_TRACE_BYTES > 0 and")
        l = l.push("                 saved_addr >= G_TRACE_BASE and")
        l = l.push("                 saved_addr < G_TRACE_BASE + G_TRACE_BYTES then")
        l = l.push("                trace_writes <= trace_writes + 1;")
        l = l.push("              end if;")
    l = l.push("              -- capture write immediately")
    l = l.push("              addr_v := saved_addr;")
    l = l.push("              is_rdisk := addr_v >= (DDR_BASE + RDISK_OFF);")
    l

# Between the write banks and the read phase.
fn k26_sh_ddr_slave_write_finish() -> [text]:
    var l: [text] = []
    l = l.push("              jitter := (jitter mod 4) + 1;")
    l = l.push("              wait_n := jitter;")
    l = l.push("              phase := 2;")
    l = l.push("            end if;")
    l = l.push("")
    l = l.push("          when 1 =>")
    l = l.push("            if wait_n > 0 then")
    l = l.push("              wait_n := wait_n - 1;")
    l = l.push("            elsif rvalid = '0' then")
    l = l.push("              addr_v := saved_addr;")
    l = l.push("              is_rdisk := addr_v >= (DDR_BASE + RDISK_OFF);")
    l

# After the read banks: drive rvalid/rlast and the write-response arm.
fn k26_sh_ddr_slave_tail() -> [text]:
    var l: [text] = []
    l = l.push("              rvalid <= '1';")
    l = l.push("              rlast  <= '1';")
    l = l.push("              phase  := 0;")
    l = l.push("            end if;")
    l = l.push("")
    l = l.push("          when others =>")
    l = l.push("            if wait_n > 0 then")
    l = l.push("              wait_n := wait_n - 1;")
    l = l.push("            elsif bvalid = '0' then")
    l = l.push("              bvalid <= '1';")
    l = l.push("              phase  := 0;")
    l = l.push("            end if;")
    l = l.push("        end case;")
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

# ---------------------------------------------------------------------------
# ctrl process — stimulus/checker scaffolding (shared)
# ---------------------------------------------------------------------------

fn k26_sh_ctrl_decls(configurable_marker: bool) -> [text]:
    var l: [text] = []
    l = l.push("  -- ---------------------------------------------------------------------")
    l = l.push("  -- Control sequence: exactly what xsdb does on the board.")
    l = l.push("  -- ---------------------------------------------------------------------")
    l = l.push("  ctrl : process")
    l = l.push("    variable txt : line;")
    l = l.push("    variable rd  : std_logic_vector(31 downto 0);")
    l = l.push("    variable count, shown : natural := 0;")
    l = l.push("    variable w : std_logic_vector(31 downto 0);")
    l = l.push("    variable ch : character;")
    l = l.push("    variable byte_v : natural;")
    l = l.push("    variable stall_iters : natural := 0;")
    l = l.push("    variable last_count : natural := 0;")
    l = l.push("    -- Rolling match on the terminal marker so the run ends on SUCCESS rather")
    l = l.push("    -- than on a guessed timeout.")
    if configurable_marker:
        l = l.push("    constant MARKER : string := G_MARKER;")
    else:
        l = l.push("    constant MARKER : string := \"TEST PASSED\";")
    l = l.push("    variable mi : natural := 0;")
    l = l.push("    variable matched : boolean := false;")
    l

fn k26_sh_lite_read_proc() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("    procedure lite_read(addr : in std_logic_vector(15 downto 0);")
    l = l.push("                        res : out std_logic_vector(31 downto 0)) is")
    l = l.push("    begin")
    l = l.push("      wait until rising_edge(clk);")
    l = l.push("      l_araddr  <= addr;")
    l = l.push("      l_arvalid <= '1';")
    l = l.push("      l_rready  <= '1';")
    l = l.push("      loop")
    l = l.push("        wait until rising_edge(clk);")
    l = l.push("        exit when l_arready = '1';")
    l = l.push("      end loop;")
    l = l.push("      l_arvalid <= '0';")
    l = l.push("      loop")
    l = l.push("        wait until rising_edge(clk);")
    l = l.push("        exit when l_rvalid = '1';")
    l = l.push("      end loop;")
    l = l.push("      res := l_rdata;")
    l = l.push("      l_rready <= '0';")
    l = l.push("    end procedure;")
    l

fn k26_sh_lite_write_head() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("    procedure lite_write(addr : in std_logic_vector(15 downto 0);")
    l = l.push("                         dat : in std_logic_vector(31 downto 0)) is")
    l = l.push("    begin")
    l = l.push("      wait until rising_edge(clk);")
    l = l.push("      l_awaddr  <= addr;")
    l = l.push("      l_awvalid <= '1';")
    l = l.push("      loop")
    l = l.push("        wait until rising_edge(clk);")
    l = l.push("        exit when l_awready = '1';")
    l = l.push("      end loop;")
    l = l.push("      l_awvalid <= '0';")
    l = l.push("      l_wdata   <= dat;")
    l = l.push("      l_wvalid  <= '1';")
    l = l.push("      loop")
    l = l.push("        wait until rising_edge(clk);")
    l = l.push("        exit when l_wready = '1';")
    l = l.push("      end loop;")
    l = l.push("      l_wvalid <= '0';")
    l

# The BVALID/BREADY ordering rationale — same defect, differently wrapped
# prose in each member ("the original tb hang" vs "the original rv32 tb hang").
fn k26_rv32_bready_doc() -> [text]:
    var l: [text] = []
    l = l.push("      -- BVALID is asserted at WREADY time and held only until BREADY: with")
    l = l.push("      -- BREADY pre-asserted it is a single-cycle pulse landing on the exact")
    l = l.push("      -- edge the WREADY loop exits on, so waiting one more edge missed it")
    l = l.push("      -- forever (the original tb hang). Assert BREADY only now, after the W")
    l = l.push("      -- handshake -- the slave holds BVALID until it sees BREADY, so the")
    l = l.push("      -- handshake below cannot be missed.")
    l

fn k26_rv64_bready_doc() -> [text]:
    var l: [text] = []
    l = l.push("      -- BVALID is asserted at WREADY time and held only until BREADY: with")
    l = l.push("      -- BREADY pre-asserted it is a single-cycle pulse landing on the exact")
    l = l.push("      -- edge the WREADY loop exits on, so waiting one more edge missed it")
    l = l.push("      -- forever (the original rv32 tb hang). Assert BREADY only now, after the")
    l = l.push("      -- W handshake -- the slave holds BVALID until it sees BREADY, so the")
    l = l.push("      -- handshake below cannot be missed.")
    l

fn k26_sh_lite_write_tail() -> [text]:
    var l: [text] = []
    l = l.push("      l_bready <= '1';")
    l = l.push("      loop")
    l = l.push("        wait until rising_edge(clk);")
    l = l.push("        exit when l_bvalid = '1';")
    l = l.push("      end loop;")
    l = l.push("      l_bready <= '0';")
    l = l.push("    end procedure;")
    l

# Reset release sequence, then the `-- 1. MAGIC check` banner.
fn k26_sh_ctrl_reset_release() -> [text]:
    var l: [text] = []
    l = l.push("  begin")
    l = l.push("    rst_n <= '0';")
    l = l.push("    wait for 200 ns;")
    l = l.push("    wait until rising_edge(clk);")
    l = l.push("    rst_n <= '1';")
    l = l.push("    wait for 100 ns;")
    l = l.push("")
    l = l.push("    -- 1. MAGIC check -- proves the PL is configured and the slave is mapped.")
    l

# rv64 reuses the rv32 control slave verbatim, so its MAGIC still spells RV32.
fn k26_rv64_magic_reuse_doc() -> [text]:
    var l: [text] = []
    l = l.push("    --    (Reused rv32_ctrl_obs_slave: MAGIC deliberately still reads \"RV32\".)")
    l

# MAGIC / pre-run / core-release steps.
fn k26_sh_ctrl_bringup() -> [text]:
    var l: [text] = []
    l = l.push("    lite_read(x\"0024\", rd);")
    l = l.push("    write(txt, string'(\"K26_MAGIC=0x\"));")
    l = l.push("    hwrite(txt, rd);")
    l = l.push("    writeline(output, txt);")
    l = l.push("    assert rd = x\"52563332\"")
    l = l.push("      report \"K26_MAGIC_MISMATCH: control slave not reachable\" severity failure;")
    l = l.push("")
    l = l.push("    -- 2. Core must still be held in reset before we release it.")
    l = l.push("    lite_read(x\"001C\", rd);")
    l = l.push("    write(txt, string'(\"K26_PRERUN_READS=0x\"));")
    l = l.push("    hwrite(txt, rd);")
    l = l.push("    writeline(output, txt);")
    l = l.push("    assert rd = x\"00000000\"")
    l = l.push("      report \"K26_CORE_RAN_BEFORE_RELEASE: reset gate is broken\" severity failure;")
    l = l.push("")
    l = l.push("    -- 3. DDR is loaded (by init_ram/init_rdisk here, by xsdb on the board);")
    l = l.push("    --    release the core.")
    l = l.push("    lite_write(x\"0000\", x\"00000001\");")
    l = l.push("    write(txt, string'(\"K26_CORE_RELEASED\"));")
    l = l.push("    writeline(output, txt);")
    l

# Transcript poll loop + rolling marker match + stall/overflow exits.
fn k26_sh_ctrl_poll() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("    -- 4. Poll the transcript over AXI-Lite exactly as the board flow does.")
    l = l.push("    loop")
    l = l.push("      lite_read(x\"0004\", rd);")
    l = l.push("      count := to_integer(unsigned(rd));")
    l = l.push("      while shown < count loop")
    l = l.push("        lite_read(std_logic_vector(to_unsigned(16#8000# + (shown / 4) * 4, 16)), w);")
    l = l.push("        byte_v := to_integer(unsigned(w(8 * (shown mod 4) + 7 downto 8 * (shown mod 4))));")
    l = l.push("        ch := character'val(byte_v);")
    l = l.push("        if byte_v = 10 then")
    l = l.push("          writeline(output, txt);")
    l = l.push("        elsif byte_v >= 32 and byte_v < 127 then")
    l = l.push("          write(txt, ch);")
    l = l.push("        end if;")
    l = l.push("        if ch = MARKER(MARKER'low + mi) then")
    l = l.push("          mi := mi + 1;")
    l = l.push("          if mi = MARKER'length then matched := true; end if;")
    l = l.push("        elsif ch = MARKER(MARKER'low) then")
    l = l.push("          mi := 1;")
    l = l.push("        else")
    l = l.push("          mi := 0;")
    l = l.push("        end if;")
    l = l.push("        shown := shown + 1;")
    l = l.push("      end loop;")
    l = l.push("")
    l = l.push("      exit when matched;")
    l = l.push("")
    l = l.push("      if count = last_count then")
    l = l.push("        stall_iters := stall_iters + 1;")
    l = l.push("      else")
    l = l.push("        stall_iters := 0;")
    l = l.push("        last_count := count;")
    l = l.push("      end if;")
    l = l.push("      exit when stall_iters > 2000000;")
    l = l.push("      exit when count >= 16384;")
    l = l.push("    end loop;")
    l

# Marker verdict block emitted before the counter read-back table.
fn k26_sh_ctrl_verdict(configurable_marker: bool) -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("    if txt /= null and txt'length > 0 then writeline(output, txt); end if;")
    l = l.push("    if matched then")
    if configurable_marker:
        l = l.push("      write(txt, string'(\"K26_MARKER_SEEN\"));")
    else:
        l = l.push("      write(txt, string'(\"K26_MARKER_TEST_PASSED_SEEN\"));")
    l = l.push("    else")
    l = l.push("      write(txt, string'(\"K26_MARKER_NOT_SEEN\"));")
    l = l.push("    end if;")
    l = l.push("    writeline(output, txt);")
    l = l.push("")
    l = l.push("    if txt /= null and txt'length > 0 then writeline(output, txt); end if;")
    l = l.push("")
    l

# UART byte count + DONE marker + stop.
fn k26_sh_ctrl_finish(with_trace: bool) -> [text]:
    var l: [text] = []
    if with_trace:
        l = l.push("    write(txt, string'(\"K26_TRACE_READS=\")); write(txt, trace_reads); writeline(output, txt);")
        l = l.push("    write(txt, string'(\"K26_TRACE_WRITES=\")); write(txt, trace_writes); writeline(output, txt);")
    l = l.push("    write(txt, string'(\"K26_UART_BYTES=\")); write(txt, count); writeline(output, txt);")
    l = l.push("    write(txt, string'(\"K26_DDR_TB_DONE\"));")
    l = l.push("    writeline(output, txt);")
    l = l.push("    done <= true;")
    l = l.push("    wait for 100 ns;")
    l = l.push("    stop(0);")
    l = l.push("  end process;")
    l = l.push("end architecture sim;")
    l
