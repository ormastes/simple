# Structured generator for rv32_ctrl_obs_slave.vhd — the AXI4-Lite control /
# observation slave, byte-identical to the silicon-proven golden in
# examples/09_embedded/fpga_riscv/rtl/.
#
# The centrepiece is ONE register table (CobsReg[]) that drives BOTH artefacts
# the golden keeps in sync by hand: the byte-offset documentation table in the
# file header AND the read-mux `when "<sel>" =>` arms — the selector is
# COMPUTED from the byte offset (offset/4 as a 6-bit literal), so the two can
# never drift. The four capture lanes likewise drive both the write-side lane
# select and the read-side concatenation from one lane count.
#
# Structurally generated: entity ports (grouped column widths), constants,
# signal declarations, the register-map doc table, the read-mux case, the lane
# select case, the lane concatenation, and every reset assign block. Named
# literal sections (ctrl_obs_slave_sections.spl) carry the header rationale
# prose and the AXI4-Lite handshake paragraphs.
#
# Determinism: arrays only, no Dict iteration; two runs are byte-identical.

use std.hardware.vhdl_gen.gen_types.{VgPortSpec, VgAssign, VgConst, vg_hex, vg_pad, vg_spaces, vg_append, no_lines, emit_constants}
use std.hardware.vhdl_gen.bus_infra_types.*
use std.hardware.vhdl_gen.ctrl_obs_slave_sections.*

# One entry of the AXI4-Lite register map. `offset` < 0 marks the windowed
# capture-buffer aperture: documented, but served by the BRAM read port rather
# than by a read-mux arm.
struct CobsReg:
    offset: i64
    name: text
    label_override: text   # "" => "0x<hex4> <name>"
    doc: [text]
    expr: text             # "" => no read-mux arm
    comment: text          # trailing comment on the mux arm

val COBS_LANES: i64 = 4
val COBS_BUF_WORDS: i64 = 4096
val COBS_ENTITY: text = "rv32_ctrl_obs_slave"

fn cobs_push_ports(dst: [VgPortSpec], src: [VgPortSpec]) -> [VgPortSpec]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

fn cobs_doc(a: text) -> [text]:
    bi_one(a)

# ---------------------------------------------------------------------------
# The register table
# ---------------------------------------------------------------------------

fn cobs_reg(offset: i64, name: text, doc: [text], expr: text) -> CobsReg:
    CobsReg(offset: offset, name: name, label_override: "", doc: doc, expr: expr, comment: "")

fn cobs_regs() -> [CobsReg]:
    var r: [CobsReg] = []
    var ctrl_doc: [text] = []
    ctrl_doc = ctrl_doc.push("bit0 = core_run. 0 holds the core in reset; write 1 to")
    ctrl_doc = ctrl_doc.push("release it AFTER the DDR images are loaded.")
    ctrl_doc = ctrl_doc.push("bit1 = capture_reset (self-clearing): zeroes the UART")
    ctrl_doc = ctrl_doc.push("write pointer.")
    r = r.push(cobs_reg(0x0000, "CTRL", ctrl_doc, "(0 => core_run_q, others => '0')"))
    r = r.push(cobs_reg(0x0004, "UART_COUNT",
                        cobs_doc("bytes captured so far (saturates at 4096)"),
                        "std_logic_vector(resize(wptr_q, 32))"))
    r = r.push(cobs_reg(0x0008, "DEBUG_PC", cobs_doc("live program counter"), "debug_pc"))
    r = r.push(cobs_reg(0x000C, "DEBUG_INS", cobs_doc("live instruction word"), "debug_ins"))
    r = r.push(cobs_reg(0x0010, "DEBUG_A0", cobs_doc("live x10"), "debug_a0"))
    r = r.push(cobs_reg(0x0014, "DEBUG_SP", cobs_doc("live x2"), "debug_sp"))
    r = r.push(cobs_reg(0x0018, "DEBUG_RA", cobs_doc("live x1"), "debug_ra"))
    r = r.push(cobs_reg(0x001C, "STAT_READS",
                        cobs_doc("AXI read transactions retired by the core"), "stat_reads"))
    r = r.push(cobs_reg(0x0020, "STAT_WRITES",
                        cobs_doc("AXI write transactions retired by the core"), "stat_writes"))
    var magic_doc: [text] = []
    magic_doc = magic_doc.push("constant 0x52563332 (\"RV32\") -- proves the slave is")
    magic_doc = magic_doc.push("mapped and the PL is configured before trusting any")
    magic_doc = magic_doc.push("other readout")
    r = r.push(CobsReg(offset: 0x0024, name: "MAGIC", label_override: "", doc: magic_doc,
                       expr: "x\"52563332\"", comment: "  -- \"RV32\""))
    var buf_doc: [text] = []
    buf_doc = buf_doc.push("UART capture buffer word i, holding FOUR captured bytes")
    buf_doc = buf_doc.push("little-endian: byte 4i in [7:0] .. byte 4i+3 in [31:24].")
    buf_doc = buf_doc.push("i = 0..4095, so 16 KB of transcript. Bytes beyond")
    buf_doc = buf_doc.push("UART_COUNT are stale and must be ignored by the reader.")
    r = r.push(CobsReg(offset: -1, name: "", label_override: "0x8000 + 4*i", doc: buf_doc,
                       expr: "", comment: ""))
    r

# The documentation table in the file header, generated from the SAME array
# that drives the read mux.
fn cobs_doc_table(regs: [CobsReg]) -> [text]:
    val cont = "--" + vg_spaces(22)
    var l: [text] = []
    var i = 0
    while i < regs.len():
        val e = regs[i]
        var label = e.label_override
        if label == "":
            label = "0x" + vg_hex(e.offset, 4) + " " + e.name
        var k = 0
        while k < e.doc.len():
            if k == 0:
                l = l.push("--   " + vg_pad(label, 19) + e.doc[0])
            else:
                l = l.push(cont + e.doc[k])
            k = k + 1
        i = i + 1
    l

# Read-mux arms; the selector is the word index (offset/4) as a 6-bit literal.
fn cobs_read_mux_arms(regs: [CobsReg]) -> [VgCaseArm]:
    var arms: [VgCaseArm] = []
    var i = 0
    while i < regs.len():
        val e = regs[i]
        if e.expr != "":
            arms = arms.push(bi_arm_inline("\"" + bi_bin(e.offset / 4, 6) + "\"", 8,
                                           "rdata_q <= " + e.expr + ";" + e.comment))
        i = i + 1
    arms = arms.push(bi_arm_inline("others", 8, "rdata_q <= (others => '0');"))
    arms

# ---------------------------------------------------------------------------
# Entity
# ---------------------------------------------------------------------------

fn cobs_axilite_ports(pre: [text]) -> [VgPortSpec]:
    val nw = 19
    val px = "s_axi_ctrl_"
    var l: [VgPortSpec] = []
    l = l.push(bi_port(pre, px + "awaddr", nw, "in", 3, bi_slv(15)))
    l = l.push(bi_port(bi_no_lines(), px + "awprot", nw, "in", 3, bi_slv(2)))
    l = l.push(bi_port(bi_no_lines(), px + "awvalid", nw, "in", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "awready", nw, "out", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "wdata", nw, "in", 3, bi_slv(31)))
    l = l.push(bi_port(bi_no_lines(), px + "wstrb", nw, "in", 3, bi_slv(3)))
    l = l.push(bi_port(bi_no_lines(), px + "wvalid", nw, "in", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "wready", nw, "out", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "bresp", nw, "out", 3, bi_slv(1)))
    l = l.push(bi_port(bi_no_lines(), px + "bvalid", nw, "out", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "bready", nw, "in", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "araddr", nw, "in", 3, bi_slv(15)))
    l = l.push(bi_port(bi_no_lines(), px + "arprot", nw, "in", 3, bi_slv(2)))
    l = l.push(bi_port(bi_no_lines(), px + "arvalid", nw, "in", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "arready", nw, "out", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "rdata", nw, "out", 3, bi_slv(31)))
    l = l.push(bi_port(bi_no_lines(), px + "rresp", nw, "out", 3, bi_slv(1)))
    l = l.push(bi_port(bi_no_lines(), px + "rvalid", nw, "out", 3, "std_logic"))
    l = l.push(bi_port(bi_no_lines(), px + "rready", nw, "in", 3, "std_logic"))
    l

fn cobs_ports() -> [VgPortSpec]:
    var p: [VgPortSpec] = []
    p = p.push(bi_port(bi_no_lines(), "clk", 7, "in", 2, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "resetn", 7, "in", 2, "std_logic"))
    val obs_pre = bi_two("", "    -- Control / observation to the core wrapper")
    p = p.push(bi_port(obs_pre, "core_run", 12, "out", 3, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "debug_pc", 12, "in", 3, bi_slv(31)))
    p = p.push(bi_port(bi_no_lines(), "debug_ins", 12, "in", 3, bi_slv(31)))
    p = p.push(bi_port(bi_no_lines(), "debug_a0", 12, "in", 3, bi_slv(31)))
    p = p.push(bi_port(bi_no_lines(), "debug_sp", 12, "in", 3, bi_slv(31)))
    p = p.push(bi_port(bi_no_lines(), "debug_ra", 12, "in", 3, bi_slv(31)))
    p = p.push(bi_port(bi_no_lines(), "stat_reads", 12, "in", 3, bi_slv(31)))
    p = p.push(bi_port(bi_no_lines(), "stat_writes", 12, "in", 3, bi_slv(31)))
    val uart_pre = bi_two("", "    -- Core UART side-channel to capture")
    p = p.push(bi_port(uart_pre, "uart_valid", 11, "in", 2, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "uart_byte", 11, "in", 2, bi_slv(7)))
    p = cobs_push_ports(p, cobs_axilite_ports(bi_two("", "    -- AXI4-Lite slave")))
    p

# ---------------------------------------------------------------------------
# Architecture declarations
# ---------------------------------------------------------------------------

fn cobs_lane_names() -> text:
    var names: [text] = []
    var i = 0
    while i < COBS_LANES:
        names = names.push("lane" + i.to_text())
        i = i + 1
    names.join(", ")

fn cobs_buf_consts() -> [VgConst]:
    var c: [VgConst] = []
    c = c.push(VgConst(pre_comments: ctrl_obs_buffer_decl_comment(), name: "BUF_WORDS",
                       ty: "natural", value: COBS_BUF_WORDS.to_text()))
    c = c.push(VgConst(pre_comments: no_lines(), name: "BUF_BYTES", ty: "natural",
                       value: "BUF_WORDS * " + COBS_LANES.to_text()))
    c

fn cobs_lane_sigs() -> [VgSignalSpec]:
    val names = cobs_lane_names()
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig(names, names.len() + 1, "lane_t", 7, "(others => (others => '0'))"))
    s

fn cobs_ptr_sigs() -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig_tail("wptr_q", 7, bi_unsigned(14), 22, "(others => '0')",
                           "  -- byte count 0..16384"))
    s = s.push(bi_sig("core_run_q", 11, "std_logic", 10, "'0'"))
    s

fn cobs_axi_sigs() -> [VgSignalSpec]:
    val zero = "(others => '0')"
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig("awready_q", 10, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("wready_q", 10, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("bvalid_q", 10, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("arready_q", 10, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("rvalid_q", 10, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("rdata_q", 10, bi_slv(31), 30, zero))
    s = s.push(bi_sig("awaddr_q", 10, bi_slv(15), 30, zero))
    s

fn cobs_buf_sigs() -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig("buf_rd_q", 9, bi_slv(31), 30, "(others => '0')"))
    s = s.push(bi_sig("is_buf_q", 9, "std_logic", 10, "'0'"))
    s

# ---------------------------------------------------------------------------
# Concurrent wiring
# ---------------------------------------------------------------------------

fn cobs_axi_wiring() -> [VgAssign]:
    val px = "s_axi_ctrl_"
    var a: [VgAssign] = []
    a = a.push(bi_assign(px + "awready", "awready_q"))
    a = a.push(bi_assign(px + "wready", "wready_q"))
    a = a.push(bi_assign(px + "bvalid", "bvalid_q"))
    a = a.push(bi_assign(px + "bresp", "\"00\""))
    a = a.push(bi_assign(px + "arready", "arready_q"))
    a = a.push(bi_assign(px + "rvalid", "rvalid_q"))
    a = a.push(bi_assign(px + "rresp", "\"00\""))
    a

# The read-data output is its own alignment group (a conditional assign, not a
# registered-signal passthrough).
fn cobs_rdata_mux() -> [VgAssign]:
    var a: [VgAssign] = []
    a = a.push(bi_assign_pre(ctrl_obs_rdata_mux_comment(), "s_axi_ctrl_rdata",
                             "buf_rd_q when is_buf_q = '1' else rdata_q"))
    a

# ---------------------------------------------------------------------------
# Processes
# ---------------------------------------------------------------------------

# Lane select for the capture write: one arm per byte lane, last one `others`.
fn cobs_lane_arms() -> [VgCaseArm]:
    val idx = "(to_integer(wptr_q(13 downto 2)))"
    var arms: [VgCaseArm] = []
    var i = 0
    while i < COBS_LANES:
        var sel = i.to_text()
        if i == COBS_LANES - 1:
            sel = "others"
        arms = arms.push(bi_arm_inline(sel, 0, "lane" + i.to_text() + idx + " <= uart_byte;"))
        i = i + 1
    arms

fn cobs_capture_process() -> [text]:
    var reset: [VgAssign] = []
    reset = reset.push(bi_assign("wptr_q", "(others => '0')"))
    var body: [text] = []
    body = body.push("    if rising_edge(clk) then")
    body = body.push("      if resetn = '0' then")
    body = vg_append(body, emit_assigns_at(8, 6, reset))
    body = body.push("      else")
    body = body.push("        if uart_valid = '1' and wptr_q < BUF_BYTES then")
    body = vg_append(body, emit_case(10, "to_integer(wptr_q(1 downto 0))", cobs_lane_arms()))
    body = body.push("          wptr_q <= wptr_q + 1;")
    body = body.push("        end if;")
    body = body.push("      end if;")
    body = body.push("    end if;")
    emit_process(2, "", "clk", bi_no_lines(), body)

fn cobs_write_reset() -> [VgAssign]:
    var a: [VgAssign] = []
    a = a.push(bi_assign("awready_q", "'0'"))
    a = a.push(bi_assign("wready_q", "'0'"))
    a = a.push(bi_assign("bvalid_q", "'0'"))
    a = a.push(bi_assign("core_run_q", "'0'"))
    a = a.push(bi_assign("awaddr_q", "(others => '0')"))
    a

fn cobs_write_process() -> [text]:
    var body: [text] = []
    body = body.push("    if rising_edge(clk) then")
    body = body.push("      if resetn = '0' then")
    body = vg_append(body, emit_assigns_at(8, 10, cobs_write_reset()))
    body = body.push("      else")
    body = vg_append(body, ctrl_obs_write_body())
    body = body.push("      end if;")
    body = body.push("    end if;")
    emit_process(2, "", "clk", bi_no_lines(), body)

fn cobs_read_reset() -> [VgAssign]:
    val zero = "(others => '0')"
    var a: [VgAssign] = []
    a = a.push(bi_assign("arready_q", "'0'"))
    a = a.push(bi_assign("rvalid_q", "'0'"))
    a = a.push(bi_assign("rdata_q", zero))
    a = a.push(bi_assign("buf_rd_q", zero))
    a = a.push(bi_assign("is_buf_q", "'0'"))
    a

# The 32-bit capture word is the four byte lanes concatenated MSB-first.
fn cobs_lane_concat() -> [text]:
    val idx = "(to_integer(unsigned(s_axi_ctrl_araddr(13 downto 2))))"
    var l: [text] = []
    var i = COBS_LANES - 1
    while i >= 0:
        var head = "                     & "
        if i == COBS_LANES - 1:
            head = "          buf_rd_q  <= "
        var tail = ""
        if i == 0:
            tail = ";"
        l = l.push(head + "lane" + i.to_text() + idx + tail)
        i = i - 1
    l

fn cobs_read_process() -> [text]:
    var body: [text] = []
    body = body.push("    if rising_edge(clk) then")
    body = body.push("      if resetn = '0' then")
    body = vg_append(body, emit_assigns_at(8, 9, cobs_read_reset()))
    body = body.push("      else")
    body = body.push("        arready_q <= '0';")
    body = body.push("        if arready_q = '0' and s_axi_ctrl_arvalid = '1' and rvalid_q = '0' then")
    body = body.push("          arready_q <= '1';")
    body = vg_append(body, cobs_lane_concat())
    body = body.push("          is_buf_q  <= s_axi_ctrl_araddr(15);")
    body = body.push("          if s_axi_ctrl_araddr(15) = '1' then")
    body = body.push("            rdata_q <= (others => '0');   -- unused; buf_rd_q drives the output")
    body = body.push("          else")
    body = vg_append(body, emit_case(12, "s_axi_ctrl_araddr(7 downto 2)", cobs_read_mux_arms(cobs_regs())))
    body = body.push("          end if;")
    body = vg_append(body, ctrl_obs_read_tail())
    body = body.push("      end if;")
    body = body.push("    end if;")
    emit_process(2, "", "clk", bi_no_lines(), body)

# ---------------------------------------------------------------------------
# Whole-file assembly
# ---------------------------------------------------------------------------

fn generate_ctrl_obs_slave() -> text:
    val regs = cobs_regs()
    var parts: [text] = []
    var lib: [text] = []
    lib = lib.push("library ieee;")
    lib = lib.push("use ieee.std_logic_1164.all;")
    lib = lib.push("use ieee.numeric_std.all;")
    parts = parts.push(bi_jl(lib))
    parts = parts.push("")
    parts = parts.push(bi_jl(ctrl_obs_head_prose()))
    parts = parts.push(bi_jl(cobs_doc_table(regs)))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_entity_ports(COBS_ENTITY, cobs_ports())))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + COBS_ENTITY + " is")
    parts = parts.push(bi_jl(emit_constants(cobs_buf_consts(), false)))
    parts = parts.push("  type lane_t is array(0 to BUF_WORDS - 1) of " + bi_slv(7) + ";")
    parts = parts.push(bi_jl(emit_signal_decls(cobs_lane_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(cobs_ptr_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(cobs_axi_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(cobs_buf_sigs())))
    parts = parts.push("begin")
    var run: [VgAssign] = []
    run = run.push(bi_assign("core_run", "core_run_q"))
    parts = parts.push(bi_jl(emit_assigns_at(2, 8, run)))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_assigns_at(2, 18, cobs_axi_wiring())))
    parts = parts.push(bi_jl(emit_assigns_at(2, 16, cobs_rdata_mux())))
    parts = parts.push("")
    parts = parts.push("  -- UART capture: one byte per debug_uart_valid pulse, stop when full.")
    parts = parts.push(bi_jl(cobs_capture_process()))
    parts = parts.push("")
    parts = parts.push("  -- AXI4-Lite write channel")
    parts = parts.push(bi_jl(cobs_write_process()))
    parts = parts.push("")
    parts = parts.push("  -- AXI4-Lite read channel. Registered BRAM read of the capture buffer costs")
    parts = parts.push("  -- one extra cycle, absorbed by asserting rvalid the cycle after arready.")
    parts = parts.push(bi_jl(cobs_read_process()))
    parts = parts.push("end architecture rtl;")
    parts.join("\n") + "\n"
