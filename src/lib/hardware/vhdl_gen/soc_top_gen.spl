# SoC-top assembly — emits the seven SoC-top RTL files byte-identical to the
# goldens in examples/09_embedded/fpga_riscv/rtl/:
#
#   soc_top_rv32.vhd / soc_top_rv64.vhd                 board tops (unisim)
#   soc_top_rv32_k26_ddr.vhd / soc_top_rv64_k26_ddr.vhd  KV260 PS-DDR4 tops
#   soc_top_rv32_sim.vhd / soc_top_rv64_sim.vhd          GHDL wrappers
#   soc_top_rv32_tiny_bram.vhd                           BRAM-only board top
#
# Factoring (one template source per XLEN pair, no whole-file forks):
#   - THREE templated pair generators — soc_top_board / soc_top_k26_ddr /
#     soc_top_sim — each taking an XlenConfig and driving one shared skeleton.
#     The rv32-only _tiny_bram singleton reuses the same emitters and shares
#     the STARTUPE3 / BUFGCE_DIV / BSCANE2 instances and the reset process with
#     the board pair.
#   - Everything structural (entity + generic/port tables, component
#     declarations, signal declarations, instantiation maps, concurrent
#     assignments, synthesis attributes, ILA probe packing) comes from typed
#     descriptors in soc_top_types.spl.
#   - Only the behavioural processes and the file-head rationale prose are
#     named literal sections (soc_top_sections.spl), and the two recurring
#     processes are emitted once and shared across all their siblings.
#
# Determinism: arrays only, no Dict iteration; repeated generation is
# byte-identical.

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.gen_types.{VgGenericSpec, VgPortSpec, no_lines, vg_append}
use std.hardware.vhdl_gen.soc_top_types.*
use std.hardware.vhdl_gen.soc_top_sections.*

fn sjl(lines: [text]) -> text:
    lines.join("\n")

fn one(s: text) -> [text]:
    var l: [text] = []
    l = l.push(s)
    l

fn two(a: text, b: text) -> [text]:
    var l: [text] = []
    l = l.push(a)
    l = l.push(b)
    l

# XLEN-derived text fragments used across all three pairs.
fn xtag(cfg: XlenConfig) -> text:
    "rv" + cfg.xlen.to_text()

# std_logic_vector(N-1 downto 0)
fn slv(n: i64) -> text:
    "std_logic_vector(" + (n - 1).to_text() + " downto 0)"

# ===========================================================================
# Shared primitive instances (board pair + tiny_bram)
# ===========================================================================

fn soc_startupe3_inst() -> SocInst:
    var g: [SocAssoc] = []
    g = g.push(sa("PROG_USR", "\"FALSE\""))
    g = g.push(sa("SIM_CCLK_FREQ", "0.0"))
    var gr: [SocMapRow] = []
    gr = gr.push(srow(g))

    var r1: [SocAssoc] = []
    r1 = r1.push(sa("CFGCLK", "cfgclk"))
    r1 = r1.push(sa("CFGMCLK", "cfgmclk"))
    r1 = r1.push(sa("DI", "di"))
    r1 = r1.push(sa("EOS", "eos"))
    r1 = r1.push(sa("PREQ", "preq"))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("DO", "\"0000\""))
    r2 = r2.push(sa("DTS", "\"1111\""))
    r2 = r2.push(sa("FCSBO", "'1'"))
    r2 = r2.push(sa("FCSBTS", "'1'"))
    r2 = r2.push(sa("GSR", "'0'"))
    r2 = r2.push(sa("GTS", "'0'"))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("KEYCLEARB", "'1'"))
    r3 = r3.push(sa("PACK", "'0'"))
    r3 = r3.push(sa("USRCCLKO", "'0'"))
    r3 = r3.push(sa("USRCCLKTS", "'1'"))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("USRDONEO", "'1'"))
    r4 = r4.push(sa("USRDONETS", "'1'"))
    var pr: [SocMapRow] = []
    pr = pr.push(srow(r1))
    pr = pr.push(srow(r2))
    pr = pr.push(srow(r3))
    pr = pr.push(srow(r4))
    soc_inst(2, "u_startup", "STARTUPE3", SOC_MAP_INLINE, gr, SOC_MAP_BLOCK, pr)

fn soc_bufgce_div_inst() -> SocInst:
    var g: [SocAssoc] = []
    g = g.push(sa("BUFGCE_DIVIDE", "2"))
    var gr: [SocMapRow] = []
    gr = gr.push(srow(g))
    var p: [SocAssoc] = []
    p = p.push(sa("I", "cfgmclk"))
    p = p.push(sa("CE", "'1'"))
    p = p.push(sa("CLR", "'0'"))
    p = p.push(sa("O", "clk_core"))
    var pr: [SocMapRow] = []
    pr = pr.push(srow(p))
    soc_inst(2, "u_clkdiv", "BUFGCE_DIV", SOC_MAP_INLINE, gr, SOC_MAP_INLINE, pr)

fn soc_bscane2_inst(indent: i64, pre: [text]) -> SocInst:
    var g: [SocAssoc] = []
    g = g.push(sa("JTAG_CHAIN", "4"))
    var gr: [SocMapRow] = []
    gr = gr.push(srow(g))
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("CAPTURE", "bsc_capture"))
    r1 = r1.push(sa("DRCK", "bsc_drck"))
    r1 = r1.push(sa("RESET", "open"))
    r1 = r1.push(sa("RUNTEST", "open"))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("SEL", "bsc_sel"))
    r2 = r2.push(sa("SHIFT", "bsc_shift"))
    r2 = r2.push(sa("TCK", "open"))
    r2 = r2.push(sa("TMS", "open"))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("UPDATE", "bsc_update"))
    r3 = r3.push(sa("TDI", "bsc_tdi"))
    r3 = r3.push(sa("TDO", "bsc_tdo"))
    var pr: [SocMapRow] = []
    pr = pr.push(srow(r1))
    pr = pr.push(srow(r2))
    pr = pr.push(srow(r3))
    soc_with_pre(pre, soc_inst(indent, "u_bscan", "BSCANE2", SOC_MAP_INLINE, gr, SOC_MAP_TIGHT, pr))

# The BSCANE2 plumbing signal block, shared by the board pair and tiny_bram.
fn soc_bsc_signals(pre: [text], with_dbg_rst: bool) -> [SocSignal]:
    var s: [SocSignal] = []
    if with_dbg_rst:
        s = s.push(ssig_c(pre, "dbg_rst_n", 11, "std_logic"))
        s = s.push(ssig("bsc_sel", 11, "std_logic"))
    else:
        s = s.push(ssig_c(pre, "bsc_sel", 11, "std_logic"))
    s = s.push(ssig("bsc_drck", 11, "std_logic"))
    s = s.push(ssig("bsc_capture", 11, "std_logic"))
    s = s.push(ssig("bsc_shift", 11, "std_logic"))
    s = s.push(ssig("bsc_update", 11, "std_logic"))
    s = s.push(ssig("bsc_tdi", 11, "std_logic"))
    s = s.push(ssig("bsc_tdo", 11, "std_logic"))
    s

# The STARTUPE3 clock-source signal block, shared by the board pair and
# tiny_bram (the board pair injects the clk_core rationale comment).
fn soc_clock_signals(cfg_w: i64, clk_w: i64, clk_pre: [text]) -> [SocSignal]:
    var s: [SocSignal] = []
    s = s.push(ssig("cfgclk", cfg_w, "std_logic"))
    s = s.push(ssig("cfgmclk", cfg_w, "std_logic"))
    s = s.push(ssig_c(clk_pre, "clk_core", clk_w, "std_logic"))
    s = s.push(ssig("di", cfg_w, slv(4)))
    s = s.push(ssig("eos", cfg_w, "std_logic"))
    s = s.push(ssig("preq", cfg_w, "std_logic"))
    s = s.push(ssig_init("rst_q", cfg_w, "std_logic", "'1'"))
    s = s.push(ssig_init("rst_cnt", cfg_w, "unsigned(31 downto 0)", "(others => '0')"))
    s

fn soc_dont_touch_attrs(w: i64) -> [text]:
    var kinds: [text] = []
    kinds = kinds.push("dont_touch")
    kinds = kinds.push("mark_debug")
    var specs: [SocAttr] = []
    specs = specs.push(sattr("dont_touch", "uart_tx_core", w, "\"true\""))
    specs = specs.push(sattr("mark_debug", "uart_tx_core", w, "\"true\""))
    specs = specs.push(sattr("dont_touch", "uart_ila_probe", w, "\"true\""))
    specs = specs.push(sattr("mark_debug", "uart_ila_probe", w, "\"true\""))
    var l: [text] = []
    l = vg_append(l, soc_emit_attr_decls(kinds))
    l = vg_append(l, soc_emit_attr_specs(specs))
    l

# ===========================================================================
# PAIR 1 — board tops (soc_top_rv32 / soc_top_rv64)
# ===========================================================================

# ILA tap table: the probe width and every slice range are derived from it.
fn board_ila_taps(cfg: XlenConfig) -> [SocIlaTap]:
    var t: [SocIlaTap] = []
    t = t.push(stap("debug_uart_byte", 8))
    t = t.push(stap("debug_uart_valid", 1))
    t = t.push(stap("marker_seen", 1))
    if cfg.is_rv32():
        t = t.push(stap("debug_pc", 16))
        t = t.push(stap("debug_ins", 32))
        t = t.push(stap("debug_a0", 8))
        t = t.push(stap("debug_ra", 16))
        t = t.push(stap("debug_sp", 16))
        t = t.push(stap("debug_phase", 4))
    t

fn board_generics(cfg: XlenConfig) -> [VgGenericSpec]:
    var g: [VgGenericSpec] = []
    if cfg.is_rv32():
        g = g.push(sg("RESET_RELEASE_COUNT", 20, "natural", "255"))
        var p: [text] = []
        p = p.push("    -- Lane B: optional in-fabric JTAG debug of the rv32 hart, reached through the")
        p = p.push("    -- Xilinx BSCANE2 USER tunnel (same FT4232H programming chain, no extra pins).")
        p = p.push("    -- DEFAULT OFF so Lane A's synth is byte-for-byte unaffected; a build knob")
        p = p.push("    -- (`-generic G_DEBUG_JTAG=true`) turns it on for a debug bitstream. Adds NO")
        p = p.push("    -- top-level ports — BSCANE2 taps the internal config-JTAG. See")
        p = p.push("    -- src/lib/hardware/debug/jtag_debug_chain.vhd + bscane2_tap_bridge.vhd.")
        g = g.push(sgc(p, "G_DEBUG_JTAG", 13, "boolean", "false"))
    else:
        g = g.push(sg("RESET_RELEASE_COUNT", 20, "natural", "255"))
    g

fn board_ports(cfg: XlenConfig) -> [VgPortSpec]:
    var p: [VgPortSpec] = []
    p = p.push(sp("uart_tx", 8, "out", 3, "std_logic"))
    if cfg.is_rv64():
        p = p.push(sp("uart_rx", 8, "in", 3, "std_logic"))
    p

fn board_signals(cfg: XlenConfig) -> [SocSignal]:
    var s: [SocSignal] = []
    if cfg.is_rv32():
        var cp: [text] = []
        cp = cp.push("  -- Core clock: cfgmclk (~50 MHz nominal) divided by 2 via BUFGCE_DIV.")
        cp = cp.push("  -- The rv32 core cannot close timing at 50 MHz (WNS probe => ~37 MHz max),")
        cp = cp.push("  -- so the whole design runs in the 25 MHz clk_core domain.")
        s = vg_append_sig(s, soc_clock_signals(7, 8, cp))
        s = s.push(ssig("uart_tx_core", 12, "std_logic"))
        s = s.push(ssig("debug_uart_valid", 0, "std_logic"))
        s = s.push(ssig("debug_uart_byte", 0, slv(8)))
        s = s.push(ssig("debug_pc", 0, slv(16)))
        s = s.push(ssig("debug_ins", 0, slv(32)))
        s = s.push(ssig("debug_a0", 0, slv(8)))
        s = s.push(ssig("debug_ra", 0, slv(16)))
        s = s.push(ssig("debug_sp", 0, slv(16)))
        s = s.push(ssig("debug_phase", 0, slv(4)))
        s = s.push(ssig_init("marker_idx", 0, "natural range 0 to 8", "0"))
        s = s.push(ssig_init("marker_seen", 0, "std_logic", "'0'"))
        s = s.push(ssig("uart_ila_probe", 0, slv(soc_ila_width(board_ila_taps(cfg)))))
    else:
        var cp: [text] = []
        cp = cp.push("  -- Core clock: cfgmclk (~50 MHz nominal) divided by 2 via BUFGCE_DIV, same")
        cp = cp.push("  -- margin soc_top_rv32 uses (its 32-bit core cannot close timing at the raw")
        cp = cp.push("  -- ~50 MHz either). rv64's 64-bit datapath already needed /2 off a 100 MHz")
        cp = cp.push("  -- PS clock to meet timing (WNS -3.758 ns @ 100 MHz -> +1.420 ns @ 50 MHz),")
        cp = cp.push("  -- so /2 off the slower cfgmclk carries the same margin forward.")
        s = vg_append_sig(s, soc_clock_signals(9, 9, cp))
        s = s.push(ssig("uart_tx_core", 16, "std_logic"))
        s = s.push(ssig("debug_uart_valid", 16, "std_logic"))
        s = s.push(ssig("debug_uart_byte", 16, slv(8)))
        s = s.push(ssig_init("marker_idx", 11, "natural range 0 to 17", "0"))
        s = s.push(ssig_init("marker_seen", 11, "std_logic", "'0'"))
        s = s.push(ssig("uart_ila_probe", 0, slv(soc_ila_width(board_ila_taps(cfg)))))
    s

fn vg_append_sig(dst: [SocSignal], src: [SocSignal]) -> [SocSignal]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

fn board_core_inst(cfg: XlenConfig) -> SocInst:
    if cfg.is_rv32():
        var gp: [text] = []
        gp = gp.push("        -- Must equal the real clk_core frequency or the UART baud divisor is")
        gp = gp.push("        -- wrong: cfgmclk is ~50 MHz nominal, divided by 2 => 25 MHz.")
        var gr: [SocMapRow] = []
        var g1: [SocAssoc] = []
        g1 = g1.push(sa("CLK_FREQ", "25_000_000"))
        gr = gr.push(srow_c(gp, g1))
        var g2: [SocAssoc] = []
        g2 = g2.push(sa("BAUD_RATE", "115_200"))
        gr = gr.push(srow(g2))
        var pr: [SocMapRow] = []
        var r1: [SocAssoc] = []
        r1 = r1.push(sa("clk", "clk_core"))
        r1 = r1.push(sa("rst", "rst_q"))
        r1 = r1.push(sa("uart_tx", "uart_tx_core"))
        pr = pr.push(srow(r1))
        var names: [text] = []
        names = names.push("debug_uart_valid")
        names = names.push("debug_uart_byte")
        names = names.push("debug_pc")
        names = names.push("debug_ins")
        names = names.push("debug_a0")
        names = names.push("debug_ra")
        names = names.push("debug_sp")
        names = names.push("debug_phase")
        var i = 0
        while i < names.len():
            pr = pr.push(srow1(names[i], 0, names[i]))
            i = i + 1
        soc_inst(4, "u_core", "entity work.rv32_exec_core", SOC_MAP_BLOCK, gr, SOC_MAP_BLOCK, pr)
    else:
        var gr: [SocMapRow] = []
        gr = gr.push(srow1("CLK_FREQ", 9, "25_000_000"))
        gr = gr.push(srow1("BAUD_RATE", 9, "115_200"))
        var pr: [SocMapRow] = []
        pr = pr.push(srow1("clk", 16, "clk_core"))
        pr = pr.push(srow1("rst", 16, "rst_q"))
        pr = pr.push(srow1("uart_tx", 16, "uart_tx_core"))
        pr = pr.push(srow1("debug_uart_valid", 16, "debug_uart_valid"))
        pr = pr.push(srow1("debug_uart_byte", 16, "debug_uart_byte"))
        soc_inst(2, "u_core", "entity work.rv64_exec_core", SOC_MAP_BLOCK, gr, SOC_MAP_BLOCK, pr)

fn rv64_uart_bscan_log_inst() -> SocInst:
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk_core"))
    r1 = r1.push(sa("rst_n", "dbg_rst_n"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("debug_uart_valid", "debug_uart_valid"))
    r2 = r2.push(sa("debug_uart_byte", "debug_uart_byte"))
    pr = pr.push(srow(r2))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("bsc_sel", "bsc_sel"))
    r3 = r3.push(sa("bsc_drck", "bsc_drck"))
    r3 = r3.push(sa("bsc_capture", "bsc_capture"))
    pr = pr.push(srow(r3))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("bsc_shift", "bsc_shift"))
    r4 = r4.push(sa("bsc_update", "bsc_update"))
    r4 = r4.push(sa("bsc_tdi", "bsc_tdi"))
    pr = pr.push(srow(r4))
    var r5: [SocAssoc] = []
    r5 = r5.push(sa("bsc_tdo", "bsc_tdo"))
    pr = pr.push(srow(r5))
    var none: [SocMapRow] = []
    soc_inst(2, "u_uart_bscan_log", "entity work.uart_bscan_log", SOC_MAP_NONE, none, SOC_MAP_TIGHT, pr)

fn rv32_bridge_inst() -> SocInst:
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk_core"))
    r1 = r1.push(sa("rst_n", "dbg_rst_n"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("bsc_sel", "bsc_sel"))
    r2 = r2.push(sa("bsc_drck", "bsc_drck"))
    r2 = r2.push(sa("bsc_capture", "bsc_capture"))
    pr = pr.push(srow(r2))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("bsc_shift", "bsc_shift"))
    r3 = r3.push(sa("bsc_update", "bsc_update"))
    r3 = r3.push(sa("bsc_tdi", "bsc_tdi"))
    pr = pr.push(srow(r3))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("bsc_tdo", "bsc_tdo"))
    pr = pr.push(srow(r4))
    var r5: [SocAssoc] = []
    r5 = r5.push(sa("tck_o", "dbg_tck"))
    r5 = r5.push(sa("tms_o", "dbg_tms"))
    r5 = r5.push(sa("tdi_o", "dbg_tdi"))
    r5 = r5.push(sa("tdo_i", "dbg_tdo"))
    pr = pr.push(srow(r5))
    var none: [SocMapRow] = []
    soc_inst(4, "u_bridge", "entity work.bscane2_tap_bridge", SOC_MAP_NONE, none, SOC_MAP_TIGHT, pr)

fn rv32_chain_inst() -> SocInst:
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk_core"))
    r1 = r1.push(sa("rst_n", "dbg_rst_n"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("tck", "dbg_tck"))
    r2 = r2.push(sa("tms", "dbg_tms"))
    r2 = r2.push(sa("tdi", "dbg_tdi"))
    r2 = r2.push(sa("trst_n", "dbg_rst_n"))
    pr = pr.push(srow(r2))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("tdo", "dbg_tdo"))
    pr = pr.push(srow(r3))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("uart_tx", "uart_tx_core"))
    pr = pr.push(srow(r4))
    var r5: [SocAssoc] = []
    r5 = r5.push(sa("o_halted", "open"))
    r5 = r5.push(sa("o_running", "open"))
    r5 = r5.push(sa("o_step", "open"))
    pr = pr.push(srow(r5))
    var r6: [SocAssoc] = []
    r6 = r6.push(sa("o_dbg_pc_full", "open"))
    r6 = r6.push(sa("o_dbg_reg_data", "open"))
    pr = pr.push(srow(r6))
    var none: [SocMapRow] = []
    soc_inst(4, "u_chain", "entity work.jtag_debug_chain", SOC_MAP_NONE, none, SOC_MAP_TIGHT, pr)

fn soc_top_board(cfg: XlenConfig) -> text:
    val ent = "soc_top_" + xtag(cfg)
    val taps = board_ila_taps(cfg)
    var parts: [text] = []
    parts = parts.push(sjl(soc_library_header(5)))
    parts = parts.push("")
    if cfg.is_rv64():
        parts = parts.push(sjl(soc_head_rv64()))
    parts = parts.push(sjl(soc_emit_entity(ent, board_generics(cfg), board_ports(cfg))))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + ent + " is")
    parts = parts.push(sjl(soc_emit_signals(board_signals(cfg))))
    if cfg.is_rv32():
        var mb: [text] = []
        mb = mb.push("46")
        mb = mb.push("50")
        mb = mb.push("47")
        mb = mb.push("41")
        mb = mb.push("2D")
        mb = mb.push("52")
        mb = mb.push("56")
        mb = mb.push("33")
        mb = mb.push("32")
        parts = parts.push(sjl(soc_marker_case_fn(mb)))
        parts = parts.push(sjl(soc_dont_touch_attrs(0)))
        parts = parts.push("")
        var bp: [text] = []
        bp = bp.push("  -- Lane B: BSCANE2 debug-tunnel plumbing (used only when G_DEBUG_JTAG = true).")
        var bsig = soc_bsc_signals(bp, true)
        bsig = bsig.push(ssig("dbg_tck", 11, "std_logic"))
        bsig = bsig.push(ssig("dbg_tms", 11, "std_logic"))
        bsig = bsig.push(ssig("dbg_tdi", 11, "std_logic"))
        bsig = bsig.push(ssig("dbg_tdo", 11, "std_logic"))
        parts = parts.push(sjl(soc_emit_signals(bsig)))
    else:
        parts = parts.push("")
        var bp: [text] = []
        bp = bp.push("  -- No UART adapter / debug module exists on this board bring-up (2026-07-24):")
        bp = bp.push("  -- an always-on BSCANE2 (USER4) tap onto the config JTAG chain gives the host")
        bp = bp.push("  -- a read-only view of the soft-UART byte stream (byte_cnt + last 16 bytes)")
        bp = bp.push("  -- for board-origin soak evidence with zero extra cabling. See")
        bp = bp.push("  -- src/lib/hardware/debug/uart_bscan_log.vhd.")
        parts = parts.push(sjl(soc_emit_signals(soc_bsc_signals(bp, true))))
        parts = parts.push("")
        parts = parts.push(sjl(soc_marker_string_fn("SimpleOS RV64 FPGA")))
        parts = parts.push("")
        parts = parts.push(sjl(soc_dont_touch_attrs(14)))
    parts = parts.push("begin")

    var asgn: [SocAssign] = []
    asgn = asgn.push(sasn("dbg_rst_n", "not rst_q"))
    asgn = asgn.push(sasn("uart_tx", "uart_tx_core"))
    var ila = soc_ila_assigns("uart_ila_probe", taps)
    var i = 0
    while i < ila.len():
        asgn = asgn.push(ila[i])
        i = i + 1
    parts = parts.push(sjl(soc_emit_assigns(asgn)))
    parts = parts.push("")

    if cfg.is_rv64():
        parts = parts.push(sjl(soc_emit_inst(soc_bscane2_inst(2, no_lines()))))
        parts = parts.push("")
        parts = parts.push(sjl(soc_emit_inst(rv64_uart_bscan_log_inst())))
        parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(soc_startupe3_inst())))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(soc_bufgce_div_inst())))
    parts = parts.push("")
    if cfg.is_rv64():
        parts = parts.push(sjl(two("  -- Free-running power-on reset release -- NO external PS handshake (this is",
                                   "  -- exactly soc_top_rv32's reset process).")))
    parts = parts.push(sjl(soc_reset_process()))
    parts = parts.push("")
    if cfg.is_rv32():
        parts = parts.push(sjl(soc_marker_process(8, 10)))
    else:
        parts = parts.push(sjl(soc_marker_process(17, 11)))
    parts = parts.push("")

    if cfg.is_rv32():
        var b1: [text] = []
        b1 = b1.push("DEFAULT (G_DEBUG_JTAG = false): the plain rv32 core, exactly as before.")
        b1 = b1.push("Lane A's synth resolves to this arm; nothing about it changes.")
        parts = parts.push(sjl(soc_banner(b1)))
        parts = parts.push(soc_generate_open("gen_nodebug", "not G_DEBUG_JTAG"))
        parts = parts.push(sjl(soc_emit_inst(board_core_inst(cfg))))
        parts = parts.push(soc_generate_close("gen_nodebug"))
        parts = parts.push("")
        var b2: [text] = []
        b2 = b2.push("DEBUG (G_DEBUG_JTAG = true): the SAME rv32 hart wrapped by the JTAG debug")
        b2 = b2.push("back-end (jtag_debug_chain: TAP -> DTM -> CDC -> DM -> clock-gated hart),")
        b2 = b2.push("reached through the Xilinx BSCANE2 USER4 tunnel + bscane2_tap_bridge. The")
        b2 = b2.push("soak UART still streams from the wrapped core (o_uart_tx) so the ILA/serial")
        b2 = b2.push("markers stay visible; OpenOCD independently halts/reads/steps the hart over")
        b2 = b2.push("the programming JTAG chain. See scripts/fpga/openocd_kv260_bscan.cfg.")
        parts = parts.push(sjl(soc_banner(b2)))
        parts = parts.push(soc_generate_open("gen_debug", "G_DEBUG_JTAG"))
        parts = parts.push(sjl(soc_emit_inst(soc_bscane2_inst(4,
            one("    -- Xilinx BSCANE2: USER4 data-register tap onto the config JTAG chain.")))))
        parts = parts.push("")
        parts = parts.push(sjl(soc_emit_inst(rv32_bridge_inst())))
        parts = parts.push("")
        parts = parts.push(sjl(soc_emit_inst(rv32_chain_inst())))
        parts = parts.push("")
        var tie: [SocAssign] = []
        var tp: [text] = []
        tp = tp.push("    -- The observation/ILA taps are driven from the core in the default arm; in")
        tp = tp.push("    -- the debug arm the JTAG DM is the inspection path, so tie them inactive.")
        tie = tie.push(sasn_c(tp, 4, "debug_uart_valid", 16, "'0'"))
        var tn: [text] = []
        tn = tn.push("debug_uart_byte")
        tn = tn.push("debug_pc")
        tn = tn.push("debug_ins")
        tn = tn.push("debug_a0")
        tn = tn.push("debug_ra")
        tn = tn.push("debug_sp")
        tn = tn.push("debug_phase")
        var k = 0
        while k < tn.len():
            tie = tie.push(sasn_w(4, tn[k], 16, "(others => '0')"))
            k = k + 1
        parts = parts.push(sjl(soc_emit_assigns(tie)))
        parts = parts.push(soc_generate_close("gen_debug"))
    else:
        parts = parts.push(sjl(soc_emit_inst(board_core_inst(cfg))))
    parts = parts.push("end architecture rtl;")
    parts.join("\n") + "\n"

# ===========================================================================
# PAIR 2 — KV260 PS-DDR4 tops (soc_top_rv32_k26_ddr / soc_top_rv64_k26_ddr)
# ===========================================================================

fn ddr_generics(cfg: XlenConfig) -> [VgGenericSpec]:
    var clk = "100000000"
    if cfg.is_rv64():
        clk = "50000000"
    var g: [VgGenericSpec] = []
    g = g.push(sg("G_CLK_FREQ", 12, "natural", clk))
    g = g.push(sg("G_BAUD_RATE", 12, "natural", "115200"))
    g = g.push(sg("G_CORE_BASE", 12, "unsigned(31 downto 0)", "x\"80000000\""))
    g = g.push(sg("G_DDR_BASE", 12, "unsigned(31 downto 0)", "x\"10000000\""))
    g

# AXI4 master + AXI4-Lite control ports. Only the write/read DATA and STRB
# widths track XLEN; everything else is shared byte-for-byte.
fn ddr_ports(cfg: XlenConfig) -> [VgPortSpec]:
    val dw = cfg.xlen
    val sw = cfg.bytes_per_reg
    var hp_note = "    -- AXI4 master into PS DDR (S_AXI_HP0_FPD)"
    var lpd = "LPD"
    if cfg.is_rv64():
        hp_note = "    -- AXI4 master into PS DDR (S_AXI_HP0_FPD), 64-bit data"
        lpd = "FPD"
    var p: [VgPortSpec] = []
    p = p.push(sp("clk", 7, "in", 2, "std_logic"))
    p = p.push(sp("rst_n", 7, "in", 2, "std_logic"))
    p = p.push(spc(one(""), "uart_tx", 8, "out", 3, "std_logic"))
    p = p.push(spc(two("", hp_note), "m_axi_hp_awaddr", 17, "out", 3, slv(32)))
    p = p.push(sp("m_axi_hp_awlen", 17, "out", 3, slv(8)))
    p = p.push(sp("m_axi_hp_awsize", 17, "out", 3, slv(3)))
    p = p.push(sp("m_axi_hp_awburst", 17, "out", 3, slv(2)))
    p = p.push(sp("m_axi_hp_awcache", 17, "out", 3, slv(4)))
    p = p.push(sp("m_axi_hp_awprot", 17, "out", 3, slv(3)))
    p = p.push(sp("m_axi_hp_awvalid", 17, "out", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_awready", 17, "in", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_wdata", 17, "out", 3, slv(dw)))
    p = p.push(sp("m_axi_hp_wstrb", 17, "out", 3, slv(sw)))
    p = p.push(sp("m_axi_hp_wlast", 17, "out", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_wvalid", 17, "out", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_wready", 17, "in", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_bresp", 17, "in", 3, slv(2)))
    p = p.push(sp("m_axi_hp_bvalid", 17, "in", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_bready", 17, "out", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_araddr", 17, "out", 3, slv(32)))
    p = p.push(sp("m_axi_hp_arlen", 17, "out", 3, slv(8)))
    p = p.push(sp("m_axi_hp_arsize", 17, "out", 3, slv(3)))
    p = p.push(sp("m_axi_hp_arburst", 17, "out", 3, slv(2)))
    p = p.push(sp("m_axi_hp_arcache", 17, "out", 3, slv(4)))
    p = p.push(sp("m_axi_hp_arprot", 17, "out", 3, slv(3)))
    p = p.push(sp("m_axi_hp_arvalid", 17, "out", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_arready", 17, "in", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_rdata", 17, "in", 3, slv(dw)))
    p = p.push(sp("m_axi_hp_rresp", 17, "in", 3, slv(2)))
    p = p.push(sp("m_axi_hp_rlast", 17, "in", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_rvalid", 17, "in", 3, "std_logic"))
    p = p.push(sp("m_axi_hp_rready", 17, "out", 3, "std_logic"))
    val ctrl_note = "    -- AXI4-Lite control / observation slave (from M_AXI_HPM0_" + lpd + ")"
    p = p.push(spc(two("", ctrl_note), "s_axi_ctrl_awaddr", 19, "in", 3, slv(16)))
    p = p.push(sp("s_axi_ctrl_awprot", 19, "in", 3, slv(3)))
    p = p.push(sp("s_axi_ctrl_awvalid", 19, "in", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_awready", 19, "out", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_wdata", 19, "in", 3, slv(32)))
    p = p.push(sp("s_axi_ctrl_wstrb", 19, "in", 3, slv(4)))
    p = p.push(sp("s_axi_ctrl_wvalid", 19, "in", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_wready", 19, "out", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_bresp", 19, "out", 3, slv(2)))
    p = p.push(sp("s_axi_ctrl_bvalid", 19, "out", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_bready", 19, "in", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_araddr", 19, "in", 3, slv(16)))
    p = p.push(sp("s_axi_ctrl_arprot", 19, "in", 3, slv(3)))
    p = p.push(sp("s_axi_ctrl_arvalid", 19, "in", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_arready", 19, "out", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_rdata", 19, "out", 3, slv(32)))
    p = p.push(sp("s_axi_ctrl_rresp", 19, "out", 3, slv(2)))
    p = p.push(sp("s_axi_ctrl_rvalid", 19, "out", 3, "std_logic"))
    p = p.push(sp("s_axi_ctrl_rready", 19, "in", 3, "std_logic"))
    p

fn ddr_component_ports(cfg: XlenConfig) -> [VgPortSpec]:
    val dw = cfg.xlen
    val sw = cfg.bytes_per_reg
    var p: [VgPortSpec] = []
    p = p.push(sp("clk", 4, "in", 2, "std_logic"))
    p = p.push(sp("rst", 4, "in", 2, "std_logic"))
    p = p.push(sp("uart_tx", 8, "out", 3, "std_logic"))
    p = p.push(sp("mem_req", 10, "out", 3, "std_logic"))
    p = p.push(sp("mem_we", 10, "out", 3, "std_logic"))
    p = p.push(sp("mem_addr", 10, "out", 3, slv(dw)))
    p = p.push(sp("mem_wdata", 10, "out", 3, slv(dw)))
    p = p.push(sp("mem_wstrb", 10, "out", 3, slv(sw)))
    p = p.push(sp("mem_rdata", 10, "in", 3, slv(dw)))
    p = p.push(sp("mem_rvalid", 10, "in", 3, "std_logic"))
    p = p.push(sp("debug_uart_valid", 17, "out", 3, "std_logic"))
    p = p.push(sp("debug_uart_byte", 16, "out", 3, slv(8)))
    p = p.push(sp("debug_pc", 9, "out", 3, slv(dw)))
    p = p.push(sp("debug_ins", 10, "out", 3, slv(32)))
    p = p.push(sp("debug_a0", 9, "out", 3, slv(dw)))
    p = p.push(sp("debug_ra", 9, "out", 3, slv(dw)))
    p = p.push(sp("debug_sp", 9, "out", 3, slv(dw)))
    p

fn ddr_signals(cfg: XlenConfig) -> [SocSignal]:
    val dw = cfg.xlen
    val sw = cfg.bytes_per_reg
    var s: [SocSignal] = []
    s = s.push(ssig("core_rst", 9, "std_logic"))
    s = s.push(ssig("core_run", 9, "std_logic"))
    s = s.push(ssig("core_rstn", 9, "std_logic"))
    s = s.push(ssig_c(one(""), "mem_req", 10, "std_logic"))
    s = s.push(ssig("mem_we", 10, "std_logic"))
    s = s.push(ssig("mem_addr", 10, slv(dw)))
    s = s.push(ssig("mem_wdata", 10, slv(dw)))
    s = s.push(ssig("mem_wstrb", 10, slv(sw)))
    s = s.push(ssig("mem_rdata", 10, slv(dw)))
    s = s.push(ssig("mem_rvalid", 10, "std_logic"))
    s = s.push(ssig_c(one(""), "dbg_uart_valid", 14, "std_logic"))
    s = s.push(ssig("dbg_uart_byte", 14, slv(8)))
    if cfg.is_rv32():
        s = s.push(ssig("dbg_pc, dbg_ins, dbg_a0, dbg_sp, dbg_ra", 0, slv(32)))
    else:
        s = s.push(ssig("dbg_pc, dbg_a0, dbg_sp, dbg_ra", 0, slv(64)))
        s = s.push(ssig("dbg_ins", 0, slv(32)))
    s = s.push(ssig("stat_reads, stat_writes", 0, slv(32)))
    s

fn ddr_core_inst(cfg: XlenConfig) -> SocInst:
    var gr: [SocMapRow] = []
    var g: [SocAssoc] = []
    g = g.push(sa("CLK_FREQ", "G_CLK_FREQ"))
    g = g.push(sa("BAUD_RATE", "G_BAUD_RATE"))
    gr = gr.push(srow(g))
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk"))
    r1 = r1.push(sa("rst", "core_rst"))
    r1 = r1.push(sa("uart_tx", "uart_tx"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("mem_req", "mem_req"))
    r2 = r2.push(sa("mem_we", "mem_we"))
    r2 = r2.push(sa("mem_addr", "mem_addr"))
    pr = pr.push(srow(r2))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("mem_wdata", "mem_wdata"))
    r3 = r3.push(sa("mem_wstrb", "mem_wstrb"))
    pr = pr.push(srow(r3))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("mem_rdata", "mem_rdata"))
    r4 = r4.push(sa("mem_rvalid", "mem_rvalid"))
    pr = pr.push(srow(r4))
    var r5: [SocAssoc] = []
    r5 = r5.push(sa("debug_uart_valid", "dbg_uart_valid"))
    r5 = r5.push(sa("debug_uart_byte", "dbg_uart_byte"))
    pr = pr.push(srow(r5))
    var r6: [SocAssoc] = []
    r6 = r6.push(sa("debug_pc", "dbg_pc"))
    r6 = r6.push(sa("debug_ins", "dbg_ins"))
    r6 = r6.push(sa("debug_a0", "dbg_a0"))
    pr = pr.push(srow(r6))
    var r7: [SocAssoc] = []
    r7 = r7.push(sa("debug_ra", "dbg_ra"))
    r7 = r7.push(sa("debug_sp", "dbg_sp"))
    pr = pr.push(srow(r7))
    soc_inst(2, "u_core", xtag(cfg) + "_exec_core_axi", SOC_MAP_INLINE, gr, SOC_MAP_TIGHT, pr)

# Byte-identical across the pair except the adapter entity name.
fn ddr_axi_inst(cfg: XlenConfig) -> SocInst:
    var gr: [SocMapRow] = []
    var g: [SocAssoc] = []
    g = g.push(sa("G_CORE_BASE", "G_CORE_BASE"))
    g = g.push(sa("G_DDR_BASE", "G_DDR_BASE"))
    gr = gr.push(srow(g))
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk"))
    r1 = r1.push(sa("resetn", "core_rstn"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("mem_req", "mem_req"))
    r2 = r2.push(sa("mem_we", "mem_we"))
    r2 = r2.push(sa("mem_addr", "mem_addr"))
    pr = pr.push(srow(r2))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("mem_wdata", "mem_wdata"))
    r3 = r3.push(sa("mem_wstrb", "mem_wstrb"))
    pr = pr.push(srow(r3))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("mem_rdata", "mem_rdata"))
    r4 = r4.push(sa("mem_rvalid", "mem_rvalid"))
    pr = pr.push(srow(r4))
    var r5: [SocAssoc] = []
    r5 = r5.push(sa("stat_reads", "stat_reads"))
    r5 = r5.push(sa("stat_writes", "stat_writes"))
    pr = pr.push(srow(r5))
    # AXI channel wiring: each row pairs two adapter formals with the matching
    # top-level m_axi_hp_* actual, generated from the signal-suffix table.
    var rows: [text] = []
    rows = rows.push("awaddr,awlen")
    rows = rows.push("awsize,awburst")
    rows = rows.push("awcache,awprot")
    rows = rows.push("awvalid,awready")
    rows = rows.push("wdata,wstrb")
    rows = rows.push("wlast,wvalid")
    rows = rows.push("wready")
    rows = rows.push("bresp,bvalid")
    rows = rows.push("bready")
    rows = rows.push("araddr,arlen")
    rows = rows.push("arsize,arburst")
    rows = rows.push("arcache,arprot")
    rows = rows.push("arvalid,arready")
    rows = rows.push("rdata,rresp")
    rows = rows.push("rlast,rvalid")
    rows = rows.push("rready")
    var i = 0
    while i < rows.len():
        val suffixes = rows[i].split(",")
        var assocs: [SocAssoc] = []
        var j = 0
        while j < suffixes.len():
            assocs = assocs.push(sa("m_axi_" + suffixes[j], "m_axi_hp_" + suffixes[j]))
            j = j + 1
        pr = pr.push(srow(assocs))
        i = i + 1
    soc_inst(2, "u_axi", "entity work." + xtag(cfg) + "_axi4_mem_adapter", SOC_MAP_INLINE, gr, SOC_MAP_TIGHT, pr)

fn ddr_ctrl_inst(cfg: XlenConfig) -> SocInst:
    var pre: [text] = []
    if cfg.is_rv64():
        pre = pre.push("  -- rv32_ctrl_obs_slave reused UNCHANGED; 64-bit debug taps truncated to their")
        pre = pre.push("  -- low 32 bits (the rv64 SimpleOS map fits under 4 GB, so nothing is lost).")
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk"))
    r1 = r1.push(sa("resetn", "rst_n"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("core_run", "core_run"))
    pr = pr.push(srow(r2))
    if cfg.is_rv32():
        var d1: [SocAssoc] = []
        d1 = d1.push(sa("debug_pc", "dbg_pc"))
        d1 = d1.push(sa("debug_ins", "dbg_ins"))
        d1 = d1.push(sa("debug_a0", "dbg_a0"))
        pr = pr.push(srow(d1))
        var d2: [SocAssoc] = []
        d2 = d2.push(sa("debug_sp", "dbg_sp"))
        d2 = d2.push(sa("debug_ra", "dbg_ra"))
        pr = pr.push(srow(d2))
    else:
        val tr = "(31 downto 0)"
        var d1: [SocAssoc] = []
        d1 = d1.push(sa("debug_pc", "dbg_pc" + tr))
        d1 = d1.push(sa("debug_ins", "dbg_ins"))
        pr = pr.push(srow(d1))
        var d2: [SocAssoc] = []
        d2 = d2.push(sa("debug_a0", "dbg_a0" + tr))
        pr = pr.push(srow(d2))
        var d3: [SocAssoc] = []
        d3 = d3.push(sa("debug_sp", "dbg_sp" + tr))
        d3 = d3.push(sa("debug_ra", "dbg_ra" + tr))
        pr = pr.push(srow(d3))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("stat_reads", "stat_reads"))
    r3 = r3.push(sa("stat_writes", "stat_writes"))
    pr = pr.push(srow(r3))
    var r4: [SocAssoc] = []
    r4 = r4.push(sa("uart_valid", "dbg_uart_valid"))
    r4 = r4.push(sa("uart_byte", "dbg_uart_byte"))
    pr = pr.push(srow(r4))
    var rows: [text] = []
    rows = rows.push("awaddr,awprot")
    rows = rows.push("awvalid,awready")
    rows = rows.push("wdata,wstrb")
    rows = rows.push("wvalid,wready")
    rows = rows.push("bresp,bvalid")
    rows = rows.push("bready")
    rows = rows.push("araddr,arprot")
    rows = rows.push("arvalid,arready")
    rows = rows.push("rdata,rresp")
    rows = rows.push("rvalid,rready")
    var i = 0
    while i < rows.len():
        val suffixes = rows[i].split(",")
        var assocs: [SocAssoc] = []
        var j = 0
        while j < suffixes.len():
            val n = "s_axi_ctrl_" + suffixes[j]
            assocs = assocs.push(sa(n, n))
            j = j + 1
        pr = pr.push(srow(assocs))
        i = i + 1
    var none: [SocMapRow] = []
    soc_with_pre(pre, soc_inst(2, "u_ctrl", "entity work.rv32_ctrl_obs_slave", SOC_MAP_NONE, none, SOC_MAP_TIGHT, pr))

fn soc_top_k26_ddr(cfg: XlenConfig) -> text:
    val ent = "soc_top_" + xtag(cfg) + "_k26_ddr"
    var parts: [text] = []
    parts = parts.push(sjl(soc_library_header(3)))
    parts = parts.push("")
    if cfg.is_rv32():
        parts = parts.push(sjl(soc_head_rv32_k26_ddr()))
    else:
        parts = parts.push(sjl(soc_head_rv64_k26_ddr()))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_entity(ent, ddr_generics(cfg), ddr_ports(cfg))))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + ent + " is")
    parts = parts.push(sjl(soc_emit_component(xtag(cfg) + "_exec_core_axi",
        "generic (CLK_FREQ : natural := 100000000; BAUD_RATE : natural := 115200);",
        ddr_component_ports(cfg))))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_signals(ddr_signals(cfg))))
    parts = parts.push("begin")
    var asgn: [SocAssign] = []
    var ap: [text] = []
    ap = ap.push("  -- Core is held in reset until DDR is populated AND software sets CTRL bit0.")
    asgn = asgn.push(sasn_c(ap, 2, "core_rst", 9, "'1' when (rst_n = '0' or core_run = '0') else '0'"))
    asgn = asgn.push(sasn_w(2, "core_rstn", 9, "rst_n"))
    parts = parts.push(sjl(soc_emit_assigns(asgn)))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(ddr_core_inst(cfg))))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(ddr_axi_inst(cfg))))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(ddr_ctrl_inst(cfg))))
    parts = parts.push("end architecture rtl;")
    parts.join("\n") + "\n"

# ===========================================================================
# PAIR 3 — GHDL simulation wrappers (soc_top_rv32_sim / soc_top_rv64_sim)
# ===========================================================================

# The tap list that drives BOTH the internal signal declarations and the core
# port map — one table, two consumers.
fn sim_taps(cfg: XlenConfig) -> [SocIlaTap]:
    var t: [SocIlaTap] = []
    t = t.push(stap("debug_uart_valid", 1))
    t = t.push(stap("debug_uart_byte", 8))
    if cfg.is_rv32():
        t = t.push(stap("debug_pc", 16))
        t = t.push(stap("debug_ins", 32))
        t = t.push(stap("debug_a0", 8))
        t = t.push(stap("debug_ra", 16))
        t = t.push(stap("debug_sp", 16))
        t = t.push(stap("debug_phase", 4))
    t

fn sim_ports(cfg: XlenConfig) -> [VgPortSpec]:
    var dw = 2
    var nw = 4
    if cfg.is_rv64():
        dw = 3
        nw = 8
    var p: [VgPortSpec] = []
    p = p.push(sp("clk", nw, "in", dw, "std_logic"))
    p = p.push(sp("rst", nw, "in", dw, "std_logic"))
    p = p.push(sp("uart_tx", 8, "out", 3, "std_logic"))
    p = p.push(sp("uart_rx", 8, "in", dw, "std_logic"))
    p

fn soc_top_sim(cfg: XlenConfig) -> text:
    val ent = "soc_top_" + xtag(cfg) + "_sim"
    val taps = sim_taps(cfg)
    var w = 0
    if cfg.is_rv64():
        w = 16
    var parts: [text] = []
    parts = parts.push(sjl(soc_library_header(2)))
    parts = parts.push("")
    if cfg.is_rv64():
        parts = parts.push(sjl(soc_head_rv64_sim()))
    var nogen: [VgGenericSpec] = []
    parts = parts.push(sjl(soc_emit_entity(ent, nogen, sim_ports(cfg))))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + ent + " is")
    var sigs: [SocSignal] = []
    var i = 0
    while i < taps.len():
        var ty = "std_logic"
        if taps[i].width > 1:
            ty = slv(taps[i].width)
        sigs = sigs.push(ssig(taps[i].name, w, ty))
        i = i + 1
    parts = parts.push(sjl(soc_emit_signals(sigs)))
    parts = parts.push("begin")
    var pr: [SocMapRow] = []
    pr = pr.push(srow1("clk", w, "clk"))
    pr = pr.push(srow1("rst", w, "rst"))
    pr = pr.push(srow1("uart_tx", w, "uart_tx"))
    i = 0
    while i < taps.len():
        pr = pr.push(srow1(taps[i].name, w, taps[i].name))
        i = i + 1
    var none: [SocMapRow] = []
    parts = parts.push(sjl(soc_emit_inst(
        soc_inst(2, "u_core", "entity work." + xtag(cfg) + "_exec_core", SOC_MAP_NONE, none, SOC_MAP_BLOCK, pr))))
    parts = parts.push("end architecture rtl;")
    parts.join("\n") + "\n"

# ===========================================================================
# SINGLETON — soc_top_rv32_tiny_bram (BRAM-only board top, rv32 only)
# ===========================================================================

fn tiny_generics() -> [VgGenericSpec]:
    var g: [VgGenericSpec] = []
    g = g.push(sg("RESET_RELEASE_COUNT", 20, "natural", "255"))
    g = g.push(sg("G_CLK_FREQ", 14, "natural", "25000000"))
    g = g.push(sg("G_BAUD_RATE", 14, "natural", "115200"))
    g = g.push(sg("G_RAM_WORDS", 14, "natural", "65536"))
    g = g.push(sg("G_RDISK_WORDS", 14, "natural", "81920"))
    g = g.push(sg("G_UARTBUF_WORDS", 16, "natural", "2048"))
    g = g.push(sg("G_RAM_INIT_FILE", 18, "string", "\"rv32_flat.mem\""))
    g = g.push(sg("G_RDISK_INIT_FILE", 18, "string", "\"rv32_ramdisk.mem\""))
    g

fn tiny_signals() -> [SocSignal]:
    var s: [SocSignal] = []
    s = vg_append_sig(s, soc_clock_signals(7, 8, no_lines()))
    var bp: [text] = []
    bp = bp.push("")
    bp = bp.push("  -- BSCANE2 USER4 plumbing.")
    s = vg_append_sig(s, soc_bsc_signals(bp, false))
    var dp: [text] = []
    dp = dp.push("")
    dp = dp.push("  -- DRCK-domain shift register + UPDATE-domain command latch.")
    s = s.push(ssig_ci(dp, "dr_shift_q", 12, slv(64), "(others => '0')"))
    s = s.push(ssig_init("cmd_reg_q", 12, slv(32), "(others => '0')"))
    s = s.push(ssig_init("cmd_toggle_q", 12, "std_logic", "'0'"))
    var sp2: [text] = []
    sp2 = sp2.push("")
    sp2 = sp2.push("  -- clk_core-domain synchronizer + pulse gen.")
    s = s.push(ssig_ci(sp2, "tgl_sync_q", 10, slv(3), "(others => '0')"))
    s = s.push(ssig("obs_cmd_valid", 0, "std_logic"))
    s = s.push(ssig("obs_resp", 0, slv(64)))
    s

fn tiny_soc_inst() -> SocInst:
    var gr: [SocMapRow] = []
    var g1: [SocAssoc] = []
    g1 = g1.push(sa("CLK_FREQ", "G_CLK_FREQ"))
    g1 = g1.push(sa("BAUD_RATE", "G_BAUD_RATE"))
    gr = gr.push(srow(g1))
    var g2: [SocAssoc] = []
    g2 = g2.push(sa("RAM_WORDS", "G_RAM_WORDS"))
    g2 = g2.push(sa("RDISK_WORDS", "G_RDISK_WORDS"))
    gr = gr.push(srow(g2))
    var g3: [SocAssoc] = []
    g3 = g3.push(sa("UARTBUF_WORDS", "G_UARTBUF_WORDS"))
    gr = gr.push(srow(g3))
    var g4: [SocAssoc] = []
    g4 = g4.push(sa("RAM_INIT_FILE", "G_RAM_INIT_FILE"))
    g4 = g4.push(sa("RDISK_INIT_FILE", "G_RDISK_INIT_FILE"))
    gr = gr.push(srow(g4))
    var pr: [SocMapRow] = []
    var r1: [SocAssoc] = []
    r1 = r1.push(sa("clk", "clk_core"))
    r1 = r1.push(sa("rst", "rst_q"))
    r1 = r1.push(sa("uart_tx", "uart_tx"))
    pr = pr.push(srow(r1))
    var r2: [SocAssoc] = []
    r2 = r2.push(sa("obs_cmd", "cmd_reg_q"))
    r2 = r2.push(sa("obs_cmd_valid", "obs_cmd_valid"))
    r2 = r2.push(sa("obs_resp", "obs_resp"))
    pr = pr.push(srow(r2))
    var r3: [SocAssoc] = []
    r3 = r3.push(sa("debug_uart_valid", "open"))
    r3 = r3.push(sa("debug_uart_byte", "open"))
    r3 = r3.push(sa("debug_pc", "open"))
    pr = pr.push(srow(r3))
    soc_inst(2, "u_soc", "entity work.rv32_bram_soc", SOC_MAP_TIGHT, gr, SOC_MAP_TIGHT, pr)

fn soc_top_tiny_bram() -> text:
    val ent = "soc_top_rv32_tiny_bram"
    var parts: [text] = []
    parts = parts.push(sjl(soc_library_header(5)))
    parts = parts.push("")
    parts = parts.push(sjl(soc_head_rv32_tiny_bram()))
    parts = parts.push("")
    var noports: [VgPortSpec] = []
    noports = noports.push(sp("uart_tx", 8, "out", 3, "std_logic"))
    parts = parts.push(sjl(soc_emit_entity(ent, tiny_generics(), noports)))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + ent + " is")
    parts = parts.push(sjl(soc_emit_signals(tiny_signals())))
    parts = parts.push("")
    var kinds: [text] = []
    kinds = kinds.push("ASYNC_REG")
    var specs: [SocAttr] = []
    specs = specs.push(sattr("ASYNC_REG", "tgl_sync_q", 0, "\"TRUE\""))
    var attrs: [text] = []
    attrs = vg_append(attrs, soc_emit_attr_decls(kinds))
    attrs = vg_append(attrs, soc_emit_attr_specs(specs))
    parts = parts.push(sjl(attrs))
    parts = parts.push("begin")
    parts = parts.push(sjl(soc_emit_inst(soc_startupe3_inst())))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(soc_bufgce_div_inst())))
    parts = parts.push("")
    parts = parts.push(sjl(soc_reset_process()))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(soc_bscane2_inst(2, no_lines()))))
    parts = parts.push("")
    parts = parts.push(sjl(soc_tiny_drck_process()))
    var a1: [SocAssign] = []
    a1 = a1.push(sasn("bsc_tdo", "dr_shift_q(0)"))
    parts = parts.push(sjl(soc_emit_assigns(a1)))
    parts = parts.push("")
    parts = parts.push(sjl(soc_tiny_update_process()))
    parts = parts.push("")
    parts = parts.push(sjl(soc_tiny_sync_process()))
    var a2: [SocAssign] = []
    a2 = a2.push(sasn("obs_cmd_valid", "tgl_sync_q(1) xor tgl_sync_q(0)"))
    parts = parts.push(sjl(soc_emit_assigns(a2)))
    parts = parts.push("")
    parts = parts.push(sjl(soc_emit_inst(tiny_soc_inst())))
    parts = parts.push("end architecture rtl;")
    parts.join("\n") + "\n"

# ===========================================================================
# Public entry points (one per family; XLEN pairs share a template)
# ===========================================================================

fn generate_soc_top_board(cfg: XlenConfig) -> text:
    soc_top_board(cfg)

fn generate_soc_top_k26_ddr(cfg: XlenConfig) -> text:
    soc_top_k26_ddr(cfg)

fn generate_soc_top_sim(cfg: XlenConfig) -> text:
    soc_top_sim(cfg)

fn generate_soc_top_tiny_bram() -> text:
    soc_top_tiny_bram()
