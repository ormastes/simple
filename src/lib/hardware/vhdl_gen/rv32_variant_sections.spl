    l = l.push("          div_count_q <= div_count_q - 1;")
    l = l.push("          dvd := shift_left(div_dividend_q, 1);")
    l = l.push("          if unsigned(dvd(63 downto 32)) >= unsigned(div_divisor_q(31 downto 0)) then")
    l = l.push("            dvd(63 downto 32) := dvd(63 downto 32) - div_divisor_q(31 downto 0);")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1) + 1;")
    l = l.push("          else")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1);")
    l = l.push("          end if;")
    l = l.push("          div_dividend_q <= dvd;")
    l = l.push("        else")
    l = l.push("          div_running_q <= '0';")
    l

