    l = l.push("")
    l = l.push("-- rv32_exec_core_flat: full-RAM behavioral sibling of rv32_exec_core.")
    l = l.push("--")
    l = l.push("-- The synthesizable rv32_exec_core confines code+data to a 64 KB window")
    l = l.push("-- (word_index = off(15 downto 2)) and therefore runs only payloads linked")
    l = l.push("-- wholly inside that window, such as the 64 KB NVMe self-test firmware.")
    l = l.push("-- The full rv32 SimpleOS kernel needs ~8.5 MB of contiguous RAM")
    l = l.push("-- (sp=_stack_top=0x8081d010, heap=0x8081e000), so this variant keeps the SAME")
    l = l.push("-- decode / ALU / CSR / M-extension / RVC logic but backs it with ONE flat")
    l = l.push("-- 16 MB behavioral RAM (word_index = off(23 downto 2), covering")
    l = l.push("-- 0x80000000..0x80FFFFFF). Memory access here is asynchronous single-cycle")
    l = l.push("-- (behavioral, NOT a BRAM model) so all the windowing/deferral/replication")
    l = l.push("-- machinery is gone; on silicon this 16 MB is PS DDR, not fabric BRAM.")
    l = l.push("--")
    l = l.push("-- Additions over the synthesizable core's memory front-end: lh/lhu/sh are")
    l = l.push("-- decoded (the NVMe-fw core only needed lb/lbu/lw/sb/sw). Byte/half stores are")
    l = l.push("-- read-modify-write within the single async cycle.")
    l = l.push("")
    l

# golden: (blank-led block)
fn rv32_axi_head() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("-- rv32_exec_core_axi: SYNTHESIZABLE sibling of rv32_exec_core_flat.")
    l = l.push("--")
    l = l.push("-- rv32_exec_core_flat boots the full rv32 SimpleOS kernel to TEST PASSED in")
    l = l.push("-- GHDL, but it is BEHAVIORAL-ONLY: its S_EXEC state does fetch (async) + decode")
    l = l.push("-- + execute in ONE cycle with COMBINATIONAL reads from internal 16 MB + 1 MB")
    l = l.push("-- VHDL arrays. 17 MB of fabric BRAM does not exist on an xck26 (~2.9 MB), so")
    l = l.push("-- that core cannot synthesize.")
    l = l.push("--")
    l = l.push("-- This variant keeps the SAME decode / ALU / CSR / M-extension divider FSM and")
    l = l.push("-- the SAME fixed compressed decoders (CA-format c.sub/xor/or/and, XORI, C.LW/SW")
    l = l.push("-- immediate builders) BIT-FOR-BIT, but moves ALL memory behind an EXTERNAL")
    l = l.push("-- synchronous request/valid interface (AXI-shaped: addr / wdata / wstrb / we /")
    l = l.push("-- req -> rdata / rvalid). Every instruction now walks a STALLED multi-cycle FSM")
    l = l.push("--")
    l = l.push("--   S_FETCH -> S_FETCH_W [-> S_FETCH2 -> S_FETCH2_W] -> S_DECODE")
    l = l.push("--            -> (S_LOAD_W | S_STORE_W | S_DIVIDE | S_UART) -> S_FETCH")
    l = l.push("--")
    l = l.push("-- so it tolerates memory that is NOT single-cycle (PS-DDR4 over an AXI master,")
    l = l.push("-- or the latency-injecting GHDL slave in tb_rv32_simpleos_boot_axi). There are")
    l = l.push("-- NO multi-KB combinational array reads here; on silicon the memory slave is an")
    l = l.push("-- M_AXI_HP master into PS DDR, and the 0x88000000 ramdisk + 0x10000000 UART are")
    l = l.push("-- reachable through the same port (ramdisk) / as decoded side-channels (UART).")
    l = l.push("--")
    l = l.push("-- Load results are consumed ONLY after mem_rvalid (never speculatively), and pc")
    l = l.push("-- advances ONLY after the memory access retires, so an added wait-state cannot")
    l = l.push("-- corrupt a load or double-advance pc.")
    l = l.push("")
    l
