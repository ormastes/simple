# Entry point for scripts/fpga/generate_exec_core_vhdl.shs — writes the six
# generated silicon-lane cores (rv32/rv64 base + flat + axi variants) into
# build/os/rtl/ (a scanned lane of scripts/check/check-riscv-rtl-truth.shs;
# the emitted cores contain real opcode decode so they classify
# generated-real).
#
# Flags:
#   --mem-prefix <dir/>  optional absolute path prefix for the .mem files in
#                        init_rom/init_data_rom/init_mem/init_ram/init_rdisk
#                        (default: golden's relative form, e.g.
#                        "rv32_payload.mem"); the axi cores read no .mem files
#   --out-dir <dir>      output directory (default build/os/rtl)

use app.io.cli_ops.{get_args}
use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.exec_core_gen.{generate_exec_core}
use std.hardware.vhdl_gen.exec_core_variant_gen.{generate_exec_core_flat, generate_exec_core_axi}

extern fn rt_file_write_text(path: text, content: text) -> bool

fn main():
    var mem_prefix = ""
    var out_dir = "build/os/rtl"
    val args = get_args()
    var i = 0
    while i < args.len():
        if args[i] == "--mem-prefix" and i + 1 < args.len():
            mem_prefix = args[i + 1]
            i = i + 1
        if args[i] == "--out-dir" and i + 1 < args.len():
            out_dir = args[i + 1]
            i = i + 1
        i = i + 1
    var names: [text] = []
    var texts: [text] = []
    names = names.push("rv32_exec_core.vhd")
    texts = texts.push(generate_exec_core(XlenConfig.rv32(), mem_prefix, true))
    names = names.push("rv64_exec_core.vhd")
    texts = texts.push(generate_exec_core(XlenConfig.rv64(), mem_prefix, true))
    names = names.push("rv32_exec_core_flat.vhd")
    texts = texts.push(generate_exec_core_flat(XlenConfig.rv32(), mem_prefix))
    names = names.push("rv64_exec_core_flat.vhd")
    texts = texts.push(generate_exec_core_flat(XlenConfig.rv64(), mem_prefix))
    names = names.push("rv32_exec_core_axi.vhd")
    texts = texts.push(generate_exec_core_axi(XlenConfig.rv32()))
    names = names.push("rv64_exec_core_axi.vhd")
    texts = texts.push(generate_exec_core_axi(XlenConfig.rv64()))
    var all_ok = true
    i = 0
    while i < names.len():
        val p = out_dir + "/" + names[i]
        val ok = rt_file_write_text(p, texts[i])
        if ok:
            print("VHDL_GEN: wrote " + p)
        else:
            all_ok = false
            print("VHDL_GEN: write failed for " + p)
        i = i + 1
    if all_ok:
        print("VHDL_GEN: OK")
    else:
        print("VHDL_GEN: FAILED (write error)")
