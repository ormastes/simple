# Entry point for scripts/fpga/generate_exec_core_vhdl.shs — writes the two
# generated silicon-lane cores into build/os/rtl/ (a scanned lane of
# scripts/check/check-riscv-rtl-truth.shs; the emitted cores contain real
# opcode decode so they classify generated-real).
#
# Flags:
#   --mem-prefix <dir/>  optional absolute path prefix for the .mem files in
#                        init_rom/init_data_rom/init_mem (default: golden's
#                        relative form, e.g. "rv32_payload.mem")
#   --out-dir <dir>      output directory (default build/os/rtl)

use app.io.cli_ops.{get_args}
use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.exec_core_gen.{generate_exec_core}

extern fn rt_file_write_text(path: text, content: text) -> bool

fn main():
    var mem_prefix = ""
    var out_dir = "build/os/rtl"
    val args = get_args()
    var i = 0
    while i < args.len():
        if args[i] == "--mem-prefix" and i + 1 < args.len():
            mem_prefix = args[i + 1]
            i = i + 1
        if args[i] == "--out-dir" and i + 1 < args.len():
            out_dir = args[i + 1]
            i = i + 1
        i = i + 1
    val rv32_text = generate_exec_core(XlenConfig.rv32(), mem_prefix, true)
    val rv64_text = generate_exec_core(XlenConfig.rv64(), mem_prefix, true)
    val p32 = out_dir + "/rv32_exec_core.vhd"
    val p64 = out_dir + "/rv64_exec_core.vhd"
    val ok32 = rt_file_write_text(p32, rv32_text)
    val ok64 = rt_file_write_text(p64, rv64_text)
    if ok32 and ok64:
        print("VHDL_GEN: wrote " + p32)
        print("VHDL_GEN: wrote " + p64)
        print("VHDL_GEN: OK")
    else:
        print("VHDL_GEN: FAILED (write error)")
