# golden: bo   := to_integer(pc_q(2 downto 0));
fn rv64_fa12() -> [text]:
    var l: [text] = []
    l = l.push("        bo   := to_integer(pc_q(2 downto 0));")
    l = l.push("        h    := comb(bo * 8 + 15 downto bo * 8);")
    l = l.push("        ins  := comb(bo * 8 + 31 downto bo * 8);")
    l = l.push("")
    l = l.push("        if h(1 downto 0) /= \"11\" then")
    l = l.push("          ------------------------------------------------------------------")
    l = l.push("          -- RV64C (compressed) — 2-byte instruction.")
    l = l.push("          ------------------------------------------------------------------")
    l = l.push("          pc_next := pc_q + 2;")
    l = l.push("          case h(1 downto 0) is")
    l = l.push("            when \"00\" =>  -- Quadrant 0")
    l = l.push("              case h(15 downto 13) is")
    l = l.push("                when \"000\" =>  -- C.ADDI4SPN")
    l = l.push("                  rd := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("                  r(rd) := r(2) + c_addi4spn_imm(h);")
    l = l.push("                when \"010\" =>  -- C.LW  (sext32)")
    l = l.push("                  rd  := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("                  rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("                  do_load := true; ld_rd := rd; mem_sz := 4; ld_signed := true;")
    l = l.push("                  mem_eff := r(rs1) + c_lw_imm(h);")
    l = l.push("                when \"011\" =>  -- C.LD")
    l = l.push("                  rd  := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("                  rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("                  do_load := true; ld_rd := rd; mem_sz := 8;")
    l = l.push("                  mem_eff := r(rs1) + c_ld_imm(h);")
    l = l.push("                when \"110\" =>  -- C.SW")
    l = l.push("                  rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("                  rs2 := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("                  do_store := true; mem_sz := 4;")
    l = l.push("                  mem_eff := r(rs1) + c_lw_imm(h); st_src := r(rs2);")
    l = l.push("                when \"111\" =>  -- C.SD")
    l = l.push("                  rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("                  rs2 := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("                  do_store := true; mem_sz := 8;")
    l = l.push("                  mem_eff := r(rs1) + c_ld_imm(h); st_src := r(rs2);")
    l = l.push("                when others => null;  -- 001 C.FLD / 101 C.FSD unused")
    l = l.push("              end case;")
    l = l.push("")
    l = l.push("            when \"01\" =>  -- Quadrant 1")
    l = l.push("              case h(15 downto 13) is")
    l = l.push("                when \"000\" =>  -- C.ADDI")
    l = l.push("                  rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("                  if rd /= 0 then r(rd) := r(rd) + c_addi_imm(h); end if;")
    l = l.push("                when \"001\" =>  -- C.ADDIW (RV64 — replaces RV32 C.JAL)")
    l = l.push("                  rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("                  if rd /= 0 then")
