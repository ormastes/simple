# golden: end if;
fn rv64_fa10() -> [text]:
    var l: [text] = []
    l = l.push("        end if;")
    l = l.push("")
    l = l.push("      elsif state_q = S_DIVIDE then")
    l = l.push("        if div_count_q /= 0 then")
    l = l.push("          dvd := shift_left(div_dividend_q, 1);")
    l = l.push("          if dvd(127 downto 64) >= div_divisor_q then")
    l = l.push("            dvd(127 downto 64) := dvd(127 downto 64) - div_divisor_q;")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1) + 1;")
    l = l.push("          else")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1);")
    l = l.push("          end if;")
    l = l.push("          div_dividend_q <= dvd;")
    l = l.push("          div_count_q    <= div_count_q - 1;")
    l = l.push("        else")
    l = l.push("          if div_is_rem_q = '1' then")
    l = l.push("            magres := div_dividend_q(127 downto 64);")
    l = l.push("          else")
    l = l.push("            magres := div_quotient_q;")
    l = l.push("          end if;")
    l = l.push("          if div_neg_q = '1' then")
    l = l.push("            finalv := unsigned(-signed(magres));")
    l = l.push("          else")
    l = l.push("            finalv := magres;")
    l = l.push("          end if;")
    l = l.push("          if div_is_w_q = '1' then")
    l = l.push("            finalv := sext32(std_logic_vector(finalv(31 downto 0)));")
    l = l.push("          end if;")
    l = l.push("          if div_rd_q /= 0 then")
    l = l.push("            regs_q(div_rd_q) <= finalv;")
    l = l.push("          end if;")
    l = l.push("          div_rd_q <= 0;")
    l

