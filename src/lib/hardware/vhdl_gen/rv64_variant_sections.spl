# golden: (blank-led block)
fn rv64_flat_head() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("-- rv64_exec_core_flat: full-RAM behavioral sibling of rv64_exec_core, and the")
    l = l.push("-- rv64 analogue of rv32_exec_core_flat.")
    l = l.push("--")
    l = l.push("-- The synthesizable rv64_exec_core confines code+data to a 64 KB window (multi-")
    l = l.push("-- cycle BRAM model, word_index = off(15 downto 3)) tuned for the Adler-32 soak")
    l = l.push("-- payload. The full rv64 SimpleOS smoke kernel")
    l = l.push("-- (build/os/simpleos_riscv64_smf_fs.elf) enters at 0x80200000, sp=0x80a1e010,")
    l = l.push("-- heap 0x80a1f000..0x84a1f000, so it needs a large contiguous RAM. This variant")
    l = l.push("-- keeps the SAME RV64IM + Zicsr datapath but:")
    l = l.push("--   * backs it with ONE flat behavioral RAM of 64-bit words covering")
    l = l.push("--     0x80000000..~0x85000000 (~80 MB), async single-cycle (behavioral, not a")
    l = l.push("--     BRAM model). On silicon this region is external PS DDR over AXI, NOT")
    l = l.push("--     fabric BRAM (board-runnable: 80 MB will not fit on-chip — a bring-up item).")
    l = l.push("--   * resets PC to 0x80200000 in M-mode-direct (no OpenSBI, no satp — the smoke")
    l = l.push("--     kernel executes zero privileged instructions; see")
    l = l.push("--     doc/09_report/rv64_simpleos_ghdl_soc_scope_2026-07-25.md).")
    l = l.push("--   * adds the RV64C (compressed) decoder ported from rv32_exec_core_flat and")
    l = l.push("--     adapted to the RV64 quadrant encodings (C.ADDIW in place of C.JAL, C.LD/")
    l = l.push("--     C.SD/C.LDSP/C.SDSP doublewords, C.ADDW/C.SUBW, 6-bit shift amounts).")
    l = l.push("--   * adds a read-only ramdisk bank at 0x88000000 preloaded from")
    l = l.push("--     \"rv64_ramdisk.mem\" (a truncated FAT image; virtio_blk_read_sector() in")
    l = l.push("--     arch/common/riscv_common.h memcpys 512-byte sectors out of it once the")
    l = l.push("--     kernel auto-detects the FAT signature there).")
    l = l.push("--")
    l = l.push("-- Memory format: rv64_flat.mem / rv64_ramdisk.mem carry one 64-bit little-endian")
    l = l.push("-- word per line (16 hex digits), matching rv64_payload.mem's hread format.")
    l = l.push("")
    l

# golden: (blank-led block)
fn rv64_axi_head() -> [text]:
    var l: [text] = []
    l = l.push("")
    l = l.push("-- rv64_exec_core_axi: SYNTHESIZABLE sibling of rv64_exec_core_flat.")
    l = l.push("--")
    l = l.push("-- rv64_exec_core_flat boots the full rv64 SimpleOS kernel to TEST PASSED in")
    l = l.push("-- GHDL, but it is BEHAVIORAL-ONLY: its S_EXEC state fetches (async) + decodes +")
    l = l.push("-- executes in ONE cycle with COMBINATIONAL reads/writes of a flat ~80 MB VHDL")
    l = l.push("-- array (a process VARIABLE). 80 MB of fabric BRAM does not exist on an xck26")
    l = l.push("-- (~2.9 MB), so that core cannot synthesize.")
    l = l.push("--")
    l = l.push("-- This variant keeps the SAME RV64IM + Zicsr datapath and the SAME ported RV64C")
    l = l.push("-- decoder (C.LD/SD, C.ADDIW, C.SUBW/ADDW, C.LDSP/SDSP, 6-bit shamts) BIT-FOR-BIT,")
    l = l.push("-- but moves ALL memory behind an EXTERNAL synchronous request/valid interface")
    l = l.push("-- (AXI-shaped: addr / wdata / wstrb / we / req -> rdata / rvalid), 64-bit wide —")
    l = l.push("-- the native rv64 word, mirroring how rv32_exec_core_axi uses a 32-bit port.")
    l = l.push("-- Every instruction now walks a STALLED multi-cycle FSM")
    l = l.push("--")
    l = l.push("--   S_FETCH -> S_FETCH_W [-> S_FETCH2 -> S_FETCH2_W] -> S_DECODE")
    l = l.push("--            -> (S_LOAD_W [-> S_LOAD2 -> S_LOAD2_W]")
    l = l.push("--               | S_STORE_W [-> S_STORE2 -> S_STORE2_W]")
    l = l.push("--               | S_DIVIDE | S_UART) -> S_FETCH")
    l = l.push("--")
    l = l.push("-- so it tolerates memory that is NOT single-cycle (PS-DDR4 over an AXI master,")
    l = l.push("-- or the latency-injecting GHDL slave in tb_rv64_simpleos_boot_axi). On silicon")
    l = l.push("-- the memory slave is an M_AXI_HP master into PS DDR; the 0x88000000 ramdisk is")
    l = l.push("-- reachable through the same port, and the 0x10000000 UART is a decoded")
    l = l.push("-- side-channel handled inside the core (never a memory transaction).")
    l = l.push("--")
    l = l.push("-- Because pc is 2-byte aligned, a 32-bit instruction whose byte offset within")
    l = l.push("-- the 8-byte word is 6 straddles the word boundary; S_FETCH2 fetches the next")
    l = l.push("-- word so the full 32-bit encoding is available. RV64 LD/SD (8-byte) and any")
    l = l.push("-- misaligned access may likewise straddle a word — S_LOAD2/S_STORE2 issue a")
    l = l.push("-- second beat with the remaining bytes/strobes. Load results are consumed ONLY")
    l = l.push("-- after mem_rvalid, and pc advances ONLY after the access retires, so an added")
    l = l.push("-- wait-state cannot corrupt a load or double-advance pc.")
    l = l.push("")
    l
