# golden: -- Resolve MMIO side-channels inline (never an external memory op).
fn rv64_ax13() -> [text]:
    var l: [text] = []
    l = l.push("        -- Resolve MMIO side-channels inline (never an external memory op).")
    l = l.push("        ------------------------------------------------------------------")
