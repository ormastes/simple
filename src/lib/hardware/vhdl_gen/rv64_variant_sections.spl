    l = l.push("          -- 16550 LSR: THRE|TEMT so TX-empty polling progresses.")
    l = l.push("          if ld_rd /= 0 then r(ld_rd) := x\"0000000000000060\"; end if;")
    l = l.push("          do_load := false;")
    l = l.push("        end if;")
    l = l.push("        if do_store and mem_eff = UART_ADDR then")
    l = l.push("          uart_shift_q <= '1' & std_logic_vector(st_src(7 downto 0)) & '0';")
    l = l.push("          uart_tx_q    <= '0';")
    l = l.push("          uart_busy_q  <= '1';")
    l = l.push("          uart_baud_q  <= 0;")
    l = l.push("          uart_bits_q  <= 10;")
    l = l.push("          debug_uart_valid_q <= '1';")
    l = l.push("          debug_uart_byte_q  <= std_logic_vector(st_src(7 downto 0));")
    l = l.push("          do_store := false;")
    l = l.push("          uart_started := true;")
    l

