# Named literal sections for the product-core GHDL testbenches.
#
# Everything that has repeated STRUCTURE lives in tb_product_types.spl /
# tb_product_gen.spl and is emitted from descriptor arrays. What is left here
# are the irreducible paragraphs: three textio read loops and two bit-lane
# selection paragraphs that occur exactly once each and have no sibling to
# factor against. Each is a small named function, never one giant per-file
# blob.
#
# Named `sp_*` (sections, product) to stay clear of the flat interpreter
# function registry shared with the other section modules.

# ---------------------------------------------------------------------------
# tb_rv32_product_sv32_pmp
# ---------------------------------------------------------------------------

# Body of `init_program`: '@'-prefixed address lines are skipped, every other
# line is one hex word appended in order until MEM_WORDS is reached.
fn sp_sv32_init_program_body() -> [text]:
    var l: [text] = []
    l = l.push("    while not endfile(source) loop")
    l = l.push("      readline(source, row);")
    l = l.push("      if row'length > 0 and row.all(row.all'low) /= '@' then")
    l = l.push("        hread(row, word, good);")
    l = l.push("        if good and index < MEM_WORDS then result(index) := word; index := index + 1; end if;")
    l = l.push("      end if;")
    l = l.push("    end loop;")
    l = l.push("    return result;")
    l

# The 32-bit word is presented on whichever half of the 64-bit Wishbone read
# bus the address selects.
fn sp_sv32_lane_select() -> [text]:
    var l: [text] = []
    l = l.push("    if adr(2) = '0' then dat_i <= x\"00000000\" & d;")
    l = l.push("    else dat_i <= d & x\"00000000\";")
    l = l.push("    end if;")
    l

# ---------------------------------------------------------------------------
# tb_rv64_product_sv39_pmp
# ---------------------------------------------------------------------------

# Body of `image_byte`: linear scan of the `<addr> <byte>` hex image for one
# byte, returning x"00" when the address is not backed by the image.
fn sp_sv39_image_byte_body() -> [text]:
    var l: [text] = []
    l = l.push("    while not endfile(image) loop")
    l = l.push("      readline(image, row);")
    l = l.push("      hread(row, image_addr, good);")
    l = l.push("      if good then")
    l = l.push("        hread(row, image_data, good);")
    l = l.push("        if good and unsigned(image_addr) = addr then return image_data; end if;")
    l = l.push("      end if;")
    l = l.push("    end loop;")
    l = l.push("    return x\"00\";")
    l

# Body of `program_qword`: eight little-endian image bytes assembled into the
# aligned 64-bit Wishbone read word.
fn sp_sv39_program_qword_body() -> [text]:
    var l: [text] = []
    l = l.push("    for byte in 0 to 7 loop")
    l = l.push("      data(byte * 8 + 7 downto byte * 8) := image_byte(base + to_unsigned(byte, 64));")
    l = l.push("    end loop;")
    l = l.push("    return data;")
    l
