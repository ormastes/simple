# Public entries: one shared template source, parameterized by XlenConfig.
fn generate_exec_core_flat(cfg: XlenConfig, mem_prefix: text) -> text:
    if cfg.is_rv32():
        generate_rv32_flat(mem_prefix)
    else:
        generate_rv64_flat(mem_prefix)

fn generate_exec_core_axi(cfg: XlenConfig) -> text:
    if cfg.is_rv32():
        generate_rv32_axi()
    else:
        generate_rv64_axi()
