fn generate_rv64_axi() -> text:
    val ent = "rv64_exec_core_axi"
    var parts: [text] = []
    parts = parts.push(vjl(synth_library_header()))
    parts = parts.push(vjl(rv64_axi_head()))
    parts = parts.push(vjl(emit_entity_spec(ent, rv64_axi_generics(), rv64_axi_ports())))
    parts = parts.push("")
