fn generate_rv64_flat(mem_prefix: text) -> text:
    val ent = "rv64_exec_core_flat"
    var parts: [text] = []
    parts = parts.push(vjl(emit_library_header()))
    parts = parts.push(vjl(rv64_flat_head()))
    parts = parts.push(vjl(emit_entity_spec(ent, rv64_flat_generics(), rv64_flat_ports())))
    parts = parts.push("")
