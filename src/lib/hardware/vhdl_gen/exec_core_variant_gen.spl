fn rv64_flat_ports() -> [VgPortSpec]:
    var p: [VgPortSpec] = []
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "clk", name_w: 17, dir: "in", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "rst", name_w: 17, dir: "in", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "uart_tx", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_uart_valid", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_uart_byte", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(7 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_pc", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_ins", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(31 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_a0", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_ra", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_sp", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p

fn rv64_axi_generics() -> [VgGenericSpec]:
    var g: [VgGenericSpec] = []
    g = g.push(VgGenericSpec(pre_comments: no_lines(), name: "CLK_FREQ", name_w: 10, ty: "natural", default_val: "100000000"))
    g = g.push(VgGenericSpec(pre_comments: no_lines(), name: "BAUD_RATE", name_w: 10, ty: "natural", default_val: "115200"))
    g

fn rv64_axi_ports() -> [VgPortSpec]:
    var p: [VgPortSpec] = []
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "clk", name_w: 17, dir: "in", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "rst", name_w: 17, dir: "in", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "uart_tx", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic", default_val: ""))
    var pp1: [text] = []
    pp1 = pp1.push("    -- External synchronous memory interface (AXI-master-shaped, 64-bit).")
    pp1 = pp1.push("    -- Handshake: core holds mem_req='1' with a stable 8-byte-aligned mem_addr")
    pp1 = pp1.push("    -- until the slave pulses mem_rvalid='1' for one cycle (read data on")
    pp1 = pp1.push("    -- mem_rdata, or write accepted). mem_req drops the cycle after rvalid, so")
    pp1 = pp1.push("    -- the slave sees a >=1-cycle idle gap between transactions.")
    p = p.push(VgPortSpec(pre_comments: pp1, name: "mem_req", name_w: 11, dir: "out", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "mem_we", name_w: 11, dir: "out", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "mem_addr", name_w: 11, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "mem_wdata", name_w: 11, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "mem_wstrb", name_w: 11, dir: "out", dir_w: 3, ty: "std_logic_vector(7 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "mem_rdata", name_w: 11, dir: "in", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "mem_rvalid", name_w: 11, dir: "in", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_uart_valid", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_uart_byte", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(7 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_pc", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_ins", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(31 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_a0", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_ra", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p = p.push(VgPortSpec(pre_comments: no_lines(), name: "debug_sp", name_w: 17, dir: "out", dir_w: 3, ty: "std_logic_vector(63 downto 0)", default_val: ""))
    p

# ---------------------------------------------------------------------------
# Whole-core assembly
# ---------------------------------------------------------------------------

fn generate_rv32_flat(mem_prefix: text) -> text:
    val ent = "rv32_exec_core_flat"
    var parts: [text] = []
    parts = parts.push(vjl(emit_library_header()))
    parts = parts.push(vjl(rv32_flat_head()))
    parts = parts.push(vjl(emit_entity_spec(ent, rv32_flat_generics(rv32_flat_geometry()), rv32_flat_ports())))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + ent + " is")
    parts = parts.push(vjl(rv32_fl01()))
    parts = parts.push("    file f : text open read_mode is \"" + mem_prefix + "rv32_flat.mem" + "\";")
    parts = parts.push(vjl(rv32_fl02()))
    parts = parts.push("    file_open(fstatus, f, \"" + mem_prefix + "rv32_ramdisk.mem" + "\", read_mode);")
    parts = parts.push(vjl(rv32_fl03()))
    parts = parts.push(vjl(rv32_fa01()))
    parts = parts.push(vjl(rv32_fl04()))
    parts = parts.push(vjl(rv32_fa02()))
    parts = parts.push(vjl(rv32_fa03()))
    parts = parts.push(vjl(rv32_fl05()))
    parts = parts.push(vjl(rv32_fa04()))
    parts = parts.push(vjl(rv32_fl06()))
    parts = parts.push(vjl(rv32_fa05()))
    parts = parts.push(vjl(rv32_fl07()))
    parts = parts.push(vjl(rv32_fa06()))
    parts = parts.push(vjl(rv32_fa07()))
    parts = parts.push(vjl(rv32_fl08()))
    parts = parts.push(vjl(rv32_fa08()))
    parts = parts.push(vjl(rv32_fl09()))
    parts = parts.push(vjl(rv32_fa09()))
    parts = parts.push(vjl(rv32_fl10()))
    parts = parts.push(vjl(rv32_fa10()))
    parts = parts.push(vjl(rv32_fl11()))
    parts = parts.push(vjl(rv32_fa11()))
    parts = parts.push(vjl(rv32_fl12()))
    parts = parts.push(vjl(rv32_fa12()))
    parts = parts.push(vjl(rv32_fl13()))
    parts = parts.push(vjl(rv32_fa13()))
    parts = parts.push(vjl(rv32_fl14()))
    parts = parts.push(vjl(rv32_fa14()))
    parts = parts.push(vjl(rv32_fl15()))
    parts = parts.push(vjl(rv32_fa15()))
    parts = parts.push(vjl(rv32_arm_op_imm()))
    parts = parts.push(vjl(rv32_fa16()))
    parts = parts.push(vjl(rv32_fl16()))
    parts = parts.push(vjl(rv32_fa17()))
    parts = parts.push(vjl(rv32_fl17()))
    parts = parts.push(vjl(rv32_fa18()))
    parts = parts.push(vjl(rv32_fl18()))
    parts = parts.push(vjl(rv32_fa19()))
    parts = parts.push(vjl(rv32_fl19()))
    parts = parts.push(vjl(rv32_fa20()))
    parts = parts.push(vjl(rv32_arm_auipc()))
    parts = parts.push(vjl(rv32_fa21()))
    parts = parts.push(vjl(rv32_arm_lui()))
    parts = parts.push(vjl(rv32_fa22()))
    parts = parts.push(vjl(rv32_arm_jal()))
    parts = parts.push(vjl(rv32_fa23()))
    parts = parts.push(vjl(rv32_arm_jalr()))
    parts = parts.push(vjl(rv32_fa24()))
    parts = parts.push(vjl(rv32_arm_branch()))
    parts = parts.push(vjl(rv32_fa25()))
    parts = parts.push(vjl(rv32_fl20()))
    parts = parts.push(vjl(rv32_fa26()))
    parts = parts.push(vjl(rv32_fl21()))
    parts = parts.push(vjl(rv32_fa27()))
    parts = parts.push(vjl(rv32_fl22()))
    parts = parts.push(vjl(rv32_fa28()))
    parts.join("\n") + "\n"

