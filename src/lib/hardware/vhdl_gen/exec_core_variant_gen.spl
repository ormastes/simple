    parts = parts.push(vjl(rv64_fl01()))
    parts = parts.push("    file f        : text open read_mode is \"" + mem_prefix + "rv64_flat.mem" + "\";")
    parts = parts.push(vjl(rv64_fl02()))
    parts = parts.push("    file_open(fstat, f, \"" + mem_prefix + "rv64_ramdisk.mem" + "\", read_mode);")
    parts = parts.push(vjl(rv64_fl03()))
    parts = parts.push(vjl(rv64_fa01()))
    parts = parts.push(vjl(rv64_fl04()))
    parts = parts.push(vjl(rv64_fa02()))
