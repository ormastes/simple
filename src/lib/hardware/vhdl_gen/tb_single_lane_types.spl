# Structured VHDL generation primitives for the single-lane GHDL testbenches
# (tb_rv32_nvme_fw_smoke / tb_rv32_simpleos_boot_tiny / tb_rv32_tiny_bram_soc /
# tb_rv64_soak).
#
# Same construction-API style as gen_types.spl: typed descriptor arrays are
# elaborated at generator time into VHDL text. No Dict anywhere (determinism:
# seed Dict order is random per process); arrays only. These emitters cover the
# shapes an entity-less testbench needs that the core emitters do not:
#   - `use std.env.all` library header (stop/finish), no textio
#   - entity with generics but NO port clause
#   - signal / constant / variable declaration blocks with group-local widths
#   - DUT instantiation with row-wrapped generic map / port map association
#   - `report ... & ... severity <sev>;` continuation chains (incl. the shared
#     debug-register dump used by three of the four testbenches)
#   - reset-release process, clocked UART-tap process, wait-guard process
#
# Named `vgtb_*` / `VgTb*` to stay clear of the core generator's symbol space
# (the interpreter keeps a FLAT function/struct registry, so a duplicate name in
# a sibling module silently hijacks the import).

use std.hardware.vhdl_gen.gen_types.*

# ---------------------------------------------------------------------------
# Descriptors
# ---------------------------------------------------------------------------

# One `signal` / `constant` / `variable` declaration. `name_w` is the width of
# the name field INCLUDING the space before the colon, matching VgPortSpec's
# convention: testbench declaration groups align group-locally (and some groups
# in the goldens keep a width inherited from a wider sibling file), so the width
# is carried per item rather than recomputed.
struct VgTbDecl:
    pre_comments: [text]
    name: text
    name_w: i64
    ty: text
    init: text             # "" when the declaration has no `:= <init>`

# One `formal => actual` association in a generic map / port map.
struct VgTbAssoc:
    formal: text
    actual: text

# One arm of an `if/elsif` terminal-marker chain inside a UART line
# accumulator: `if llen <cmp> <len_expr> and lbuf(1 to <len_expr>) = <match_expr>`.
struct VgTbMarkerArm:
    cmp: text              # comparison against the accumulated length (">=" / "=")
    len_expr: text         # length bound, reused as the lbuf slice bound
    match_expr: text       # quoted literal or constant the slice is compared to
    reached: text          # value reported as `reached=<...>`

# A component instantiation. `generic_rows` / `port_rows` give how many
# associations share each emitted line — the associations themselves are data,
# only the line wrapping is layout metadata.
struct VgTbInst:
    label: text
    entity_name: text
    generics: [VgTbAssoc]
    generic_rows: [i64]
    ports: [VgTbAssoc]
    port_rows: [i64]

fn vgtb_join(lines: [text]) -> text:
    lines.join("\n")

fn vgtb_decl(name: text, name_w: i64, ty: text, init: text) -> VgTbDecl:
    VgTbDecl(pre_comments: no_lines(), name: name, name_w: name_w, ty: ty, init: init)

fn vgtb_decl_c(pre: [text], name: text, name_w: i64, ty: text, init: text) -> VgTbDecl:
    VgTbDecl(pre_comments: pre, name: name, name_w: name_w, ty: ty, init: init)

fn vgtb_assoc(formal: text, actual: text) -> VgTbAssoc:
    VgTbAssoc(formal: formal, actual: actual)

# `name => name` — the common case where the tb signal mirrors the port name.
fn vgtb_wire(name: text) -> VgTbAssoc:
    VgTbAssoc(formal: name, actual: name)

fn vgtb_append_decls(dst: [VgTbDecl], src: [VgTbDecl]) -> [VgTbDecl]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

fn vgtb_append_assocs(dst: [VgTbAssoc], src: [VgTbAssoc]) -> [VgTbAssoc]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

fn vgtb_append_i64(dst: [i64], src: [i64]) -> [i64]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

# ---------------------------------------------------------------------------
# Structural emitters
# ---------------------------------------------------------------------------

# Testbench library header: no textio (nothing is read from a file here), but
# `std.env` for the `stop` procedure every one of these testbenches calls.
fn vgtb_library_header() -> [text]:
    var l: [text] = []
    l = l.push("library ieee;")
    l = l.push("use ieee.std_logic_1164.all;")
    l = l.push("use ieee.numeric_std.all;")
    l = l.push("use std.env.all;")
    l

# Testbench entity: generics only, no port clause (a tb has no boundary).
fn vgtb_entity(name: text, gens: [VgGenericSpec]) -> [text]:
    var l: [text] = []
    l = l.push("entity " + name + " is")
    if gens.len() > 0:
        l = l.push("  generic (")
        var i = 0
        while i < gens.len():
            val g = gens[i]
            l = vg_append(l, g.pre_comments)
            var line = "    " + vg_pad(g.name, g.name_w) + ": " + g.ty + " := " + g.default_val
            if i < gens.len() - 1:
                line = line + ";"
            l = l.push(line)
            i = i + 1
        l = l.push("  );")
    l = l.push("end entity " + name + ";")
    l

fn vgtb_arch_head(arch: text, entity_name: text) -> text:
    "architecture " + arch + " of " + entity_name + " is"

fn vgtb_arch_foot(arch: text) -> text:
    "end architecture " + arch + ";"

fn vgtb_decls(indent: i64, keyword: text, decls: [VgTbDecl]) -> [text]:
    val ind = vg_spaces(indent)
    var l: [text] = []
    var i = 0
    while i < decls.len():
        val d = decls[i]
        l = vg_append(l, d.pre_comments)
        var line = ind + keyword + " " + vg_pad(d.name, d.name_w) + ": " + d.ty
        if d.init != "":
            line = line + " := " + d.init
        l = l.push(line + ";")
        i = i + 1
    l

# `clk <= not clk after <half> ns;` — the free-running clock every tb drives.
fn vgtb_clock_driver(half_period_ns: i64) -> text:
    "  clk <= not clk after " + half_period_ns.to_text() + " ns;"

fn vgtb_assoc_row(items: [VgTbAssoc], start: i64, count: i64) -> text:
    var cells: [text] = []
    var i = 0
    while i < count:
        cells = cells.push(items[start + i].formal + " => " + items[start + i].actual)
        i = i + 1
    cells.join(", ")

# `generic map (...)` / `port map (...)`: one line when the caller declared a
# single row, otherwise an open line plus one line per row.
fn vgtb_map_block(kw: text, items: [VgTbAssoc], rows: [i64], close: text) -> [text]:
    var l: [text] = []
    if items.len() == 0:
        return l
    if rows.len() == 1:
        l = l.push("    " + kw + " map (" + vgtb_assoc_row(items, 0, rows[0]) + close)
        return l
    l = l.push("    " + kw + " map (")
    var idx = 0
    var r = 0
    while r < rows.len():
        val row = vgtb_assoc_row(items, idx, rows[r])
        idx = idx + rows[r]
        if r == rows.len() - 1:
            l = l.push("      " + row + close)
        else:
            l = l.push("      " + row + ",")
        r = r + 1
    l

fn vgtb_inst(inst: VgTbInst) -> [text]:
    var l: [text] = []
    l = l.push("  " + inst.label + " : entity work." + inst.entity_name)
    l = vg_append(l, vgtb_map_block("generic", inst.generics, inst.generic_rows, ")"))
    l = vg_append(l, vgtb_map_block("port", inst.ports, inst.port_rows, ");"))
    l

# `report <head>` plus `& <tail>` continuation lines two columns deeper; the
# severity clause rides the final line.
fn vgtb_report(indent: i64, head: text, tails: [text], severity: text) -> [text]:
    val ind = vg_spaces(indent)
    val cont = vg_spaces(indent + 2)
    var l: [text] = []
    if tails.len() == 0:
        l = l.push(ind + "report " + head + " severity " + severity + ";")
        return l
    l = l.push(ind + "report " + head)
    var i = 0
    while i < tails.len():
        var line = cont + "& " + tails[i]
        if i == tails.len() - 1:
            line = line + " severity " + severity + ";"
        l = l.push(line)
        i = i + 1
    l

# Same, but the severity clause sits alone on the wrapped final line.
fn vgtb_report_sev_line(indent: i64, head: text, tails: [text], severity: text) -> [text]:
    val ind = vg_spaces(indent)
    val cont = vg_spaces(indent + 2)
    var l: [text] = []
    l = l.push(ind + "report " + head)
    var i = 0
    while i < tails.len():
        l = l.push(cont + "& " + tails[i])
        i = i + 1
    l = l.push(cont + "severity " + severity + ";")
    l

# `report "<tag> pc=0x" & to_hstring(debug_pc) & " ins=0x" & ...` — the debug
# register dump shared by the nvme / boot-tiny / bram-soc stuck reports. `regs`
# are the bare tap names; each maps to signal `debug_<reg>`.
fn vgtb_reg_dump_report(indent: i64, tag: text, regs: [text], severity: text) -> [text]:
    val head = "\"" + tag + " " + regs[0] + "=0x\" & to_hstring(debug_" + regs[0] + ")"
    var tails: [text] = []
    var i = 1
    while i < regs.len():
        tails = tails.push("\" " + regs[i] + "=0x\" & to_hstring(debug_" + regs[i] + ")")
        i = i + 1
    vgtb_report(indent, head, tails, severity)

# `report "<tag> <k>=" & integer'image(<expr>) & ...` — the budget banner the
# generic-parameterised testbenches print before releasing reset.
fn vgtb_int_fields_report(indent: i64, tag: text, fields: [VgTbAssoc], severity: text) -> [text]:
    val head = "\"" + tag + " " + fields[0].formal + "=\" & integer'image(" + fields[0].actual + ")"
    var tails: [text] = []
    var i = 1
    while i < fields.len():
        tails = tails.push("\" " + fields[i].formal + "=\" & integer'image(" + fields[i].actual + ")")
        i = i + 1
    vgtb_report(indent, head, tails, severity)

# Reset-release process: optional banner lines, then hold reset for `wait_expr`.
fn vgtb_reset_process(head_lines: [text], wait_expr: text) -> [text]:
    var l: [text] = []
    l = l.push("  process")
    l = l.push("  begin")
    l = vg_append(l, head_lines)
    l = l.push("    wait for " + wait_expr + ";")
    l = l.push("    rst <= '0';")
    l = l.push("    wait;")
    l = l.push("  end process;")
    l

# Clocked debug-UART tap process. The `process(clk)` / `rising_edge` /
# `rst = '0' and debug_uart_valid = '1'` scaffold is identical in all three
# tap-based testbenches; only the declarations and the body differ.
fn vgtb_uart_tap_process(decls: [VgTbDecl], body: [text]) -> [text]:
    var l: [text] = []
    l = l.push("  process(clk)")
    l = vg_append(l, vgtb_decls(4, "variable", decls))
    l = l.push("  begin")
    l = l.push("    if rising_edge(clk) then")
    l = l.push("      if rst = '0' and debug_uart_valid = '1' then")
    l = vg_append(l, body)
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

# `ch := character'val(to_integer(unsigned(debug_uart_byte)));` at `indent`.
fn vgtb_tap_byte_to_char(indent: i64) -> text:
    vg_spaces(indent) + "ch := character'val(to_integer(unsigned(debug_uart_byte)));"

# Wait-guard process: `wait for <t>; if not done then <body> end if; wait;`.
fn vgtb_guard_process(head_lines: [text], wait_expr: text, body: [text]) -> [text]:
    var l: [text] = []
    l = l.push("  process")
    l = l.push("  begin")
    l = vg_append(l, head_lines)
    l = l.push("    wait for " + wait_expr + ";")
    l = l.push("    if not done then")
    l = vg_append(l, body)
    l = l.push("    end if;")
    l = l.push("    wait;")
    l = l.push("  end process;")
    l
