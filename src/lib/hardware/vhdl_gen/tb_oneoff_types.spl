# Structural vocabulary for the two ONE-OFF VHDL harnesses (see
# tb_oneoff_gen.spl). These two files are not members of any lane: they have no
# XLEN sibling and no sibling of any other kind, so nothing here invents a
# pairing. What it does add is the handful of VHDL *dialect* forms the one-offs
# use that the single-lane goldens never do:
#
#   * the compact entity shell   `entity X is end entity;`   (one line)
#   * the anonymous architecture foot   `end architecture;`   (no arch name)
#   * mixed-keyword declaration groups (`variable` and `file` interleaved in
#     one process header), which a single vgtb_decls call cannot express
#   * the "one space before the colon" declaration column both files use
#
# Everything else — library header, entity, arch head, decl rendering, map
# blocks, instantiation, clock driver, reset process, clocked process, report —
# is REUSED from tb_single_lane_types.spl rather than re-implemented here.
#
# Determinism: arrays only, no Dict iteration; repeated generation is
# byte-identical within and across processes.

use std.hardware.vhdl_gen.gen_types.*
use std.hardware.vhdl_gen.tb_single_lane_types.*

# One arm of the ISA gate's UART verdict chain: a byte value and the verdict
# word it reports. The arms are otherwise identical, so the chain is generated
# from this descriptor rather than written out twice.
struct VgGateArm:
    hex: text              # UART byte as VHDL hex literal digits, e.g. "50"
    verdict: text          # reported as GATE_RESULT=<verdict>

fn vg_gate_arm(hex: text, verdict: text) -> VgGateArm:
    VgGateArm(hex: hex, verdict: verdict)

# ---------------------------------------------------------------------------
# Dialect forms absent from the single-lane vocabulary
# ---------------------------------------------------------------------------

# Compact entity shell: declaration and end on one line. The single-lane
# goldens always spell this over two lines (vgtb_entity), so this is a sibling
# form, not a parameterisation of it.
fn vgtb_entity_compact(name: text) -> text:
    "entity " + name + " is end entity;"

# `end architecture;` — the anonymous sibling of vgtb_arch_foot(arch).
fn vgtb_arch_foot_anon() -> text:
    "end architecture;"

# ---------------------------------------------------------------------------
# Declaration helpers
# ---------------------------------------------------------------------------

# Both one-off files use the same declaration column rule: exactly one space
# between the name and the colon (no group alignment). Encoding that rule once
# keeps the per-file descriptor lists free of hand-counted widths.
fn oo_decl(name: text, ty: text, init: text) -> VgTbDecl:
    vgtb_decl(name, name.len() + 1, ty, init)

fn oo_vec(hi: i64) -> text:
    "std_logic_vector(" + hi.to_text() + " downto 0)"

# Declaration group whose keyword varies per item (`variable` / `file`).
# `keywords[i]` applies to `decls[i]`; field layout is delegated to the shared
# vgtb_decl_text so mixed groups line up exactly like uniform ones.
fn oo_decls_mixed(indent: i64, keywords: [text], decls: [VgTbDecl]) -> [text]:
    val ind = vg_spaces(indent)
    var l: [text] = []
    var i = 0
    while i < decls.len():
        l = vg_append(l, decls[i].pre_comments)
        l = l.push(ind + vgtb_decl_text(keywords[i], decls[i]))
        i = i + 1
    l

# ---------------------------------------------------------------------------
# Instantiation head
# ---------------------------------------------------------------------------

# `<label><sep>entity work.<name>` — the shared vgtb_inst hard-codes both the
# " : " label separator and the single-lane map layout; these two files differ
# on both axes (the ISA gate writes `dut:` with no leading space), so the head
# line is emitted here and the map blocks come from vgtb_map_block_at.
fn oo_inst_head(label: text, sep: text, entity_name: text) -> text:
    "  " + label + sep + "entity work." + entity_name

# ---------------------------------------------------------------------------
# Shared body fragments
# ---------------------------------------------------------------------------

# `file_open(fstat, fout, "<file>", <mode>);`
fn oo_file_open(indent: i64, file_name: text, mode: text) -> text:
    vg_spaces(indent) + "file_open(fstat, fout, \"" + file_name + "\", " + mode + ");"

# The UART verdict chain: `if/elsif` over the sampled byte, one arm per
# descriptor, each arm writing its verdict line and latching result_seen.
fn oo_gate_arms(indent: i64, arms: [VgGateArm]) -> [text]:
    val ind = vg_spaces(indent)
    val bi = vg_spaces(indent + 2)
    var l: [text] = []
    var i = 0
    while i < arms.len():
        var kw = "elsif"
        if i == 0:
            kw = "if"
        l = l.push(ind + kw + " dbyte = x\"" + arms[i].hex + "\" then")
        l = l.push(bi + "write(l, string'(\"GATE_RESULT=" + arms[i].verdict + "\"));")
        l = l.push(bi + "writeline(output, l);")
        l = l.push(bi + "result_seen <= '1';")
        i = i + 1
    l = l.push(ind + "end if;")
    l
