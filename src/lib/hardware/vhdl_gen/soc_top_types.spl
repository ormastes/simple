# Structural VHDL emitters for the SoC-top family (soc_top_rv32/rv64 and their
# _k26_ddr / _sim / _tiny_bram siblings).
#
# SoC tops are structural RTL: entity/generic/port tables, component
# declarations, signal declarations, instantiation port maps, concurrent
# assignments and synthesis attributes. Every one of those shapes gets a typed
# descriptor here and is elaborated into text by a shared emitter; only the
# genuinely behavioural paragraphs (processes, header rationale comments) live
# as named literal sections in soc_top_sections.spl.
#
# Determinism: arrays only, no Dict anywhere; two runs are byte-identical.
#
# Column alignment is GROUP-LOCAL in the goldens (a port group aligns to its own
# widest member while the next group does not), so every descriptor carries its
# own explicit field width instead of a single per-file `aligned` flag — the
# same lesson VgPortSpec encodes for the exec-core variants.

use std.hardware.vhdl_gen.gen_types.{VgGenericSpec, VgPortSpec, no_lines, vg_pad, vg_spaces, vg_append}

# ---------------------------------------------------------------------------
# Descriptor types
# ---------------------------------------------------------------------------

# One `signal` declaration. `names` may be a comma-joined group
# ("dbg_pc, dbg_ins, dbg_a0") — the goldens declare siblings that way.
struct SocSignal:
    pre_comments: [text]   # verbatim full lines emitted before the signal line
    names: text
    names_w: i64           # width of the name field before " : "
    ty: text
    init: text             # "" when the signal has no initial value

# One `formal => actual` association inside a generic/port map.
struct SocAssoc:
    formal: text
    formal_w: i64          # 0 = no padding
    actual: text

# One physical LINE of a map: the goldens pack several associations per line.
struct SocMapRow:
    pre_comments: [text]
    assocs: [SocAssoc]

# Map layout styles.
val SOC_MAP_NONE: i64 = 0    # no such map on this instance
val SOC_MAP_INLINE: i64 = 1  # generic map (A => b, C => d)
val SOC_MAP_BLOCK: i64 = 2   # open paren, rows, own-line `)` / `);`
val SOC_MAP_TIGHT: i64 = 3   # open paren, rows, `)` appended to the last row

export SOC_MAP_NONE
export SOC_MAP_INLINE
export SOC_MAP_BLOCK
export SOC_MAP_TIGHT

# One component/entity instantiation.
struct SocInst:
    pre_lines: [text]      # verbatim lines before the label line
    indent: i64            # indent of the `label : kind` line (2, or 4 inside a generate)
    label: text
    kind: text             # "STARTUPE3" or "entity work.rv32_exec_core"
    gen_style: i64
    gen_rows: [SocMapRow]
    port_style: i64
    port_rows: [SocMapRow]

# One concurrent signal assignment.
struct SocAssign:
    pre_comments: [text]
    indent: i64
    lhs: text
    lhs_w: i64
    rhs: text

# One `attribute X of Y : signal is "V";` specification.
struct SocAttr:
    kind: text
    target: text
    target_w: i64
    value: text            # already quoted, e.g. "\"true\""

# ---------------------------------------------------------------------------
# Terse descriptor constructors (keep the tables readable)
# ---------------------------------------------------------------------------

fn sg(name: text, nw: i64, ty: text, dv: text) -> VgGenericSpec:
    VgGenericSpec(pre_comments: no_lines(), name: name, name_w: nw, ty: ty, default_val: dv)

fn sgc(pre: [text], name: text, nw: i64, ty: text, dv: text) -> VgGenericSpec:
    VgGenericSpec(pre_comments: pre, name: name, name_w: nw, ty: ty, default_val: dv)

fn sp(name: text, nw: i64, dir: text, dw: i64, ty: text) -> VgPortSpec:
    VgPortSpec(pre_comments: no_lines(), name: name, name_w: nw, dir: dir, dir_w: dw, ty: ty, default_val: "")

fn spc(pre: [text], name: text, nw: i64, dir: text, dw: i64, ty: text) -> VgPortSpec:
    VgPortSpec(pre_comments: pre, name: name, name_w: nw, dir: dir, dir_w: dw, ty: ty, default_val: "")

fn ssig(names: text, nw: i64, ty: text) -> SocSignal:
    SocSignal(pre_comments: no_lines(), names: names, names_w: nw, ty: ty, init: "")

fn ssig_init(names: text, nw: i64, ty: text, init: text) -> SocSignal:
    SocSignal(pre_comments: no_lines(), names: names, names_w: nw, ty: ty, init: init)

fn ssig_c(pre: [text], names: text, nw: i64, ty: text) -> SocSignal:
    SocSignal(pre_comments: pre, names: names, names_w: nw, ty: ty, init: "")

fn ssig_ci(pre: [text], names: text, nw: i64, ty: text, init: text) -> SocSignal:
    SocSignal(pre_comments: pre, names: names, names_w: nw, ty: ty, init: init)

fn sa(f: text, a: text) -> SocAssoc:
    SocAssoc(formal: f, formal_w: 0, actual: a)

fn saw(f: text, w: i64, a: text) -> SocAssoc:
    SocAssoc(formal: f, formal_w: w, actual: a)

fn srow(assocs: [SocAssoc]) -> SocMapRow:
    SocMapRow(pre_comments: no_lines(), assocs: assocs)

fn srow_c(pre: [text], assocs: [SocAssoc]) -> SocMapRow:
    SocMapRow(pre_comments: pre, assocs: assocs)

# Single-association row — the most common shape in the aligned port maps.
fn srow1(f: text, w: i64, a: text) -> SocMapRow:
    var v: [SocAssoc] = []
    v = v.push(saw(f, w, a))
    srow(v)

fn sasn(lhs: text, rhs: text) -> SocAssign:
    SocAssign(pre_comments: no_lines(), indent: 2, lhs: lhs, lhs_w: 0, rhs: rhs)

fn sasn_w(indent: i64, lhs: text, w: i64, rhs: text) -> SocAssign:
    SocAssign(pre_comments: no_lines(), indent: indent, lhs: lhs, lhs_w: w, rhs: rhs)

fn sasn_c(pre: [text], indent: i64, lhs: text, w: i64, rhs: text) -> SocAssign:
    SocAssign(pre_comments: pre, indent: indent, lhs: lhs, lhs_w: w, rhs: rhs)

fn sattr(kind: text, target: text, w: i64, value: text) -> SocAttr:
    SocAttr(kind: kind, target: target, target_w: w, value: value)

# ---------------------------------------------------------------------------
# Library headers
# ---------------------------------------------------------------------------

# n = number of clauses: 2 (sim wrappers), 3 (AXI/DDR tops), 5 (unisim board
# tops that instantiate STARTUPE3/BSCANE2/BUFGCE_DIV primitives).
fn soc_library_header(n: i64) -> [text]:
    var l: [text] = []
    l = l.push("library ieee;")
    l = l.push("use ieee.std_logic_1164.all;")
    if n >= 3:
        l = l.push("use ieee.numeric_std.all;")
    if n >= 5:
        l = l.push("library unisim;")
        l = l.push("use unisim.vcomponents.all;")
    l

# ---------------------------------------------------------------------------
# Entity / component declarations
# ---------------------------------------------------------------------------

# Sibling of gen_types.emit_entity_spec that also handles the generic-less
# entities (the _sim wrappers have ports only).
fn soc_emit_entity(name: text, gens: [VgGenericSpec], ports: [VgPortSpec]) -> [text]:
    var l: [text] = []
    l = l.push("entity " + name + " is")
    var i = 0
    if gens.len() > 0:
        l = l.push("  generic (")
        while i < gens.len():
            val g = gens[i]
            l = vg_append(l, g.pre_comments)
            var line = "    " + vg_pad(g.name, g.name_w) + ": " + g.ty + " := " + g.default_val
            if i < gens.len() - 1:
                line = line + ";"
            l = l.push(line)
            i = i + 1
        l = l.push("  );")
    l = l.push("  port (")
    i = 0
    while i < ports.len():
        val p = ports[i]
        l = vg_append(l, p.pre_comments)
        var line = "    " + vg_pad(p.name, p.name_w) + ": " + vg_pad(p.dir, p.dir_w) + " " + p.ty
        if i < ports.len() - 1:
            line = line + ";"
        l = l.push(line)
        i = i + 1
    l = l.push("  );")
    l = l.push("end entity " + name + ";")
    l

# Architecture-declarative `component ... end component;`. The goldens keep the
# generic clause on one line and close the port clause on the last port.
fn soc_emit_component(name: text, gen_line: text, ports: [VgPortSpec]) -> [text]:
    var l: [text] = []
    l = l.push("  component " + name + " is")
    l = l.push("    " + gen_line)
    l = l.push("    port (")
    var i = 0
    while i < ports.len():
        val p = ports[i]
        l = vg_append(l, p.pre_comments)
        var line = "      " + vg_pad(p.name, p.name_w) + ": " + vg_pad(p.dir, p.dir_w) + " " + p.ty
        if i < ports.len() - 1:
            line = line + ";"
        else:
            line = line + ");"
        l = l.push(line)
        i = i + 1
    l = l.push("  end component;")
    l

# ---------------------------------------------------------------------------
# Declarations, assignments, attributes
# ---------------------------------------------------------------------------

fn soc_emit_signals(sigs: [SocSignal]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < sigs.len():
        val s = sigs[i]
        l = vg_append(l, s.pre_comments)
        var line = "  signal " + vg_pad(s.names, s.names_w) + " : " + s.ty
        if s.init != "":
            line = line + " := " + s.init
        l = l.push(line + ";")
        i = i + 1
    l

fn soc_emit_assigns(items: [SocAssign]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < items.len():
        val a = items[i]
        l = vg_append(l, a.pre_comments)
        l = l.push(vg_spaces(a.indent) + vg_pad(a.lhs, a.lhs_w) + " <= " + a.rhs + ";")
        i = i + 1
    l

fn soc_emit_attr_decls(kinds: [text]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < kinds.len():
        l = l.push("  attribute " + kinds[i] + " : string;")
        i = i + 1
    l

fn soc_emit_attr_specs(specs: [SocAttr]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < specs.len():
        val s = specs[i]
        l = l.push("  attribute " + s.kind + " of " + vg_pad(s.target, s.target_w) + " : signal is " + s.value + ";")
        i = i + 1
    l

# ---------------------------------------------------------------------------
# Instantiation maps
# ---------------------------------------------------------------------------

fn soc_row_text(row: SocMapRow) -> text:
    var out = ""
    var i = 0
    while i < row.assocs.len():
        val a = row.assocs[i]
        if i > 0:
            out = out + ", "
        out = out + vg_pad(a.formal, a.formal_w) + " => " + a.actual
        i = i + 1
    out

fn soc_emit_map(indent: i64, kw: text, rows: [SocMapRow], style: i64, tail: text) -> [text]:
    val ind = vg_spaces(indent)
    val rin = vg_spaces(indent + 2)
    var l: [text] = []
    if style == SOC_MAP_INLINE:
        l = l.push(ind + kw + " map (" + soc_row_text(rows[0]) + ")" + tail)
    else:
        l = l.push(ind + kw + " map (")
        var i = 0
        while i < rows.len():
            l = vg_append(l, rows[i].pre_comments)
            var line = rin + soc_row_text(rows[i])
            if i < rows.len() - 1:
                line = line + ","
            else:
                if style == SOC_MAP_TIGHT:
                    line = line + ")" + tail
            l = l.push(line)
            i = i + 1
        if style == SOC_MAP_BLOCK:
            l = l.push(ind + ")" + tail)
    l

fn soc_emit_inst(inst: SocInst) -> [text]:
    var l: [text] = []
    l = vg_append(l, inst.pre_lines)
    l = l.push(vg_spaces(inst.indent) + inst.label + " : " + inst.kind)
    if inst.gen_style != SOC_MAP_NONE:
        l = vg_append(l, soc_emit_map(inst.indent + 2, "generic", inst.gen_rows, inst.gen_style, ""))
    l = vg_append(l, soc_emit_map(inst.indent + 2, "port", inst.port_rows, inst.port_style, ";"))
    l

fn soc_inst(indent: i64, label: text, kind: text, gen_style: i64, gen_rows: [SocMapRow], port_style: i64, port_rows: [SocMapRow]) -> SocInst:
    SocInst(pre_lines: no_lines(), indent: indent, label: label, kind: kind,
            gen_style: gen_style, gen_rows: gen_rows, port_style: port_style, port_rows: port_rows)

# Attach verbatim lines (comments / blank separators) ahead of an instance.
fn soc_with_pre(pre: [text], inst: SocInst) -> SocInst:
    SocInst(pre_lines: pre, indent: inst.indent, label: inst.label, kind: inst.kind,
            gen_style: inst.gen_style, gen_rows: inst.gen_rows,
            port_style: inst.port_style, port_rows: inst.port_rows)

# ---------------------------------------------------------------------------
# ILA observation-probe packing
# ---------------------------------------------------------------------------
#
# The board tops concatenate their debug taps into one `uart_ila_probe` vector.
# Both the vector width and every slice range are DERIVED from the tap table,
# so the probe map is data, not hand-written bit arithmetic.

struct SocIlaTap:
    name: text
    width: i64

fn stap(name: text, width: i64) -> SocIlaTap:
    SocIlaTap(name: name, width: width)

fn soc_ila_width(taps: [SocIlaTap]) -> i64:
    var w = 0
    var i = 0
    while i < taps.len():
        w = w + taps[i].width
        i = i + 1
    w

fn soc_ila_assigns(probe: text, taps: [SocIlaTap]) -> [SocAssign]:
    var out: [SocAssign] = []
    var lo = 0
    var i = 0
    while i < taps.len():
        val t = taps[i]
        var slice = probe + "(" + lo.to_text() + ")"
        if t.width > 1:
            slice = probe + "(" + (lo + t.width - 1).to_text() + " downto " + lo.to_text() + ")"
        out = out.push(sasn(slice, t.name))
        lo = lo + t.width
        i = i + 1
    out

# ---------------------------------------------------------------------------
# Generate-statement wrapper (rv32's G_DEBUG_JTAG arms)
# ---------------------------------------------------------------------------

fn soc_generate_open(label: text, cond: text) -> text:
    "  " + label + " : if " + cond + " generate"

fn soc_generate_close(label: text) -> text:
    "  end generate " + label + ";"

# Full-width banner comment used to head the generate arms.
fn soc_banner(lines: [text]) -> [text]:
    var dashes = ""
    var d = 0
    while d < 76:
        dashes = dashes + "-"
        d = d + 1
    val bar = "  " + dashes
    var l: [text] = []
    l = l.push(bar)
    var i = 0
    while i < lines.len():
        l = l.push("  -- " + lines[i])
        i = i + 1
    l = l.push(bar)
    l
