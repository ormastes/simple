# Named literal sections for the AXI4 memory adapter XLEN pair — irreducible
# paragraphs only:
#   * the two per-XLEN file header rationale comments (free prose; the rv64 one
#     is not a mechanical widening of the rv32 one, it documents an extra
#     truncation decision)
#   * the six FSM state-arm bodies, which are XLEN-INDEPENDENT and therefore
#     emitted verbatim into both files from this one source
# Everything else (entity, signals, remap function, static qualifiers, wiring,
# reset block, case scaffolding) is generated structurally in
# axi4_mem_adapter_gen.spl.

fn axi_adapter_head_rv32() -> [text]:
    var l: [text] = []
    l = l.push("-- rv32_axi4_mem_adapter: bridges the rv32_exec_core_axi simple stalled")
    l = l.push("-- request/valid memory port onto a full AXI4 master (AW/W/B/AR/R), so the core")
    l = l.push("-- can reach Zynq UltraScale+ PS DDR4 through an S_AXI_HP slave port.")
    l = l.push("--")
    l = l.push("-- Core-side handshake (see rv32_exec_core_axi.vhd):")
    l = l.push("--   core holds mem_req='1' with stable word-aligned mem_addr until the slave")
    l = l.push("--   pulses mem_rvalid='1' for exactly ONE cycle; mem_req drops the cycle after,")
    l = l.push("--   so there is always a >=1-cycle idle gap between transactions.")
    l = l.push("-- Only ONE transaction is ever outstanding, which keeps this adapter tiny: no")
    l = l.push("-- reordering, no ID management, no write-data buffering.")
    l = l.push("--")
    l = l.push("-- Address remap. The rv32 SimpleOS image is linked at 0x80000000 (kernel) with")
    l = l.push("-- the FAT32 ramdisk window at 0x88000000. On ZynqMP the 0x80000000..0xFFFFFFFF")
    l = l.push("-- range is NOT DDR (it is PCIe/reserved), so raw pass-through would never hit")
    l = l.push("-- memory. We subtract G_CORE_BASE and add G_DDR_BASE, placing the whole")
    l = l.push("-- 8.19 MB kernel + ramdisk window inside DDR low:")
    l = l.push("--   core 0x80000000 -> DDR G_DDR_BASE + 0x00000000   (kernel, reset PC)")
    l = l.push("--   core 0x88000000 -> DDR G_DDR_BASE + 0x08000000   (ramdisk, FAT32 image)")
    l = l.push("-- G_DDR_BASE defaults to 0x10000000 (256 MB into DDR) to stay clear of the")
    l = l.push("-- FSBL/ATF/U-Boot low-DDR footprint used while loading the images over JTAG.")
    l = l.push("--")
    l = l.push("-- Burst shape is deliberately single-beat (AxLEN=0, AxSIZE=2 -> 4 bytes,")
    l = l.push("-- AxBURST=INCR). The AXI SmartConnect in the block design handles the 32-bit ->")
    l = l.push("-- 128-bit data upsizing and the 32-bit -> 49-bit address widening for HP_FPD.")
    l

fn axi_adapter_head_rv64() -> [text]:
    var l: [text] = []
    l = l.push("-- rv64_axi4_mem_adapter: bridges the rv64_exec_core_axi simple stalled")
    l = l.push("-- request/valid memory port (64-bit) onto a full AXI4 master (AW/W/B/AR/R), so")
    l = l.push("-- the core can reach Zynq UltraScale+ PS DDR4 through an S_AXI_HP slave port.")
    l = l.push("-- This is the 64-bit widening of rv32_axi4_mem_adapter (same FSM, same")
    l = l.push("-- one-outstanding-transaction contract); see that file for the rationale.")
    l = l.push("--")
    l = l.push("-- Core-side handshake (see rv64_exec_core_axi.vhd):")
    l = l.push("--   core holds mem_req='1' with stable 8-byte-aligned mem_addr until the slave")
    l = l.push("--   pulses mem_rvalid='1' for exactly ONE cycle; mem_req drops the cycle after,")
    l = l.push("--   so there is always a >=1-cycle idle gap between transactions.")
    l = l.push("-- Only ONE transaction is ever outstanding: no reordering, no ID management,")
    l = l.push("-- no write-data buffering.")
    l = l.push("--")
    l = l.push("-- Address remap. The rv64 SimpleOS image is linked at 0x80200000 (kernel entry)")
    l = l.push("-- with the FAT32 ramdisk window at 0x88000000. On ZynqMP the range")
    l = l.push("-- 0x80000000..0xFFFFFFFF is NOT DDR (PCIe/reserved), so raw pass-through would")
    l = l.push("-- never hit memory. We subtract G_CORE_BASE and add G_DDR_BASE, placing the")
    l = l.push("-- whole kernel + ramdisk window inside DDR low, same scheme as rv32:")
    l = l.push("--   core 0x80000000 -> DDR G_DDR_BASE + 0x00000000")
    l = l.push("--   core 0x80200000 -> DDR G_DDR_BASE + 0x00200000   (kernel, reset PC)")
    l = l.push("--   core 0x88000000 -> DDR G_DDR_BASE + 0x08000000   (ramdisk, FAT32 image)")
    l = l.push("-- G_DDR_BASE defaults to 0x10000000 (256 MB into DDR) to stay clear of the")
    l = l.push("-- FSBL/ATF/U-Boot low-DDR footprint used while loading the images over JTAG.")
    l = l.push("-- The core's mem_addr is 64-bit but the SimpleOS map fits entirely under 4 GB,")
    l = l.push("-- so the remap uses the LOW 32 BITS only (documented truncation).")
    l = l.push("--")
    l = l.push("-- Burst shape is single-beat (AxLEN=0), 8 bytes (AxSIZE=3 -- the native rv64")
    l = l.push("-- word, matching the core's 64-bit port), INCR. The AXI SmartConnect in the")
    l = l.push("-- block design handles the 64-bit -> 128-bit data upsizing and the 32-bit ->")
    l = l.push("-- 49-bit address widening for HP_FPD. The core guarantees 8-byte-aligned")
    l = l.push("-- addresses, so a single beat is always naturally aligned.")
    l

# The remap-function doc comment: rv32 is one line, rv64 documents the
# truncation in two.
fn axi_adapter_remap_comment_rv32() -> [text]:
    var l: [text] = []
    l = l.push("  -- Remap a core address into the DDR aperture.")
    l

fn axi_adapter_remap_comment_rv64() -> [text]:
    var l: [text] = []
    l = l.push("  -- Remap a core address into the DDR aperture (low 32 bits; the SimpleOS")
    l = l.push("  -- rv64 map lives entirely under 4 GB).")
    l

# ---------------------------------------------------------------------------
# FSM state-arm bodies (shared verbatim by BOTH XLEN members)
# ---------------------------------------------------------------------------

fn axi_adapter_arm_idle() -> [text]:
    var l: [text] = []
    l = l.push("            if mem_req = '1' then")
    l = l.push("              axaddr_q <= remap(mem_addr);")
    l = l.push("              if mem_we = '1' then")
    l = l.push("                wdata_q   <= mem_wdata;")
    l = l.push("                wstrb_q   <= mem_wstrb;")
    l = l.push("                awvalid_q <= '1';")
    l = l.push("                wvalid_q  <= '1';")
    l = l.push("                state_q   <= S_WR_ADDR;")
    l = l.push("              else")
    l = l.push("                arvalid_q <= '1';")
    l = l.push("                state_q   <= S_RD_ADDR;")
    l = l.push("              end if;")
    l = l.push("            end if;")
    l

fn axi_adapter_arm_rd_addr() -> [text]:
    var l: [text] = []
    l = l.push("            if m_axi_arready = '1' then")
    l = l.push("              arvalid_q <= '0';")
    l = l.push("              rready_q  <= '1';")
    l = l.push("              state_q   <= S_RD_DATA;")
    l = l.push("            end if;")
    l

fn axi_adapter_arm_rd_data() -> [text]:
    var l: [text] = []
    l = l.push("            if m_axi_rvalid = '1' then")
    l = l.push("              rready_q <= '0';")
    l = l.push("              rdata_q  <= m_axi_rdata;")
    l = l.push("              rvalid_q <= '1';          -- retire to the core")
    l = l.push("              reads_q  <= reads_q + 1;")
    l = l.push("              state_q  <= S_DONE;")
    l = l.push("            end if;")
    l

fn axi_adapter_arm_wr_addr() -> [text]:
    var l: [text] = []
    l = l.push("            if m_axi_awready = '1' then")
    l = l.push("              awvalid_q <= '0';")
    l = l.push("            end if;")
    l = l.push("            if m_axi_wready = '1' then")
    l = l.push("              wvalid_q <= '0';")
    l = l.push("            end if;")
    l = l.push("            if (awvalid_q = '0' or m_axi_awready = '1') and")
    l = l.push("               (wvalid_q = '0' or m_axi_wready = '1') then")
    l = l.push("              bready_q <= '1';")
    l = l.push("              state_q  <= S_WR_RESP;")
    l = l.push("            end if;")
    l

fn axi_adapter_arm_wr_resp() -> [text]:
    var l: [text] = []
    l = l.push("            if m_axi_bvalid = '1' then")
    l = l.push("              bready_q <= '0';")
    l = l.push("              rvalid_q <= '1';          -- write accepted; retire to the core")
    l = l.push("              writes_q <= writes_q + 1;")
    l = l.push("              state_q  <= S_DONE;")
    l = l.push("            end if;")
    l

fn axi_adapter_arm_done() -> [text]:
    var l: [text] = []
    l = l.push("            if mem_req = '0' then")
    l = l.push("              state_q <= S_IDLE;")
    l = l.push("            end if;")
    l
