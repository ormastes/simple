# Named literal sections for the SoC-top family — the paragraphs that are NOT
# structural RTL and therefore cannot be table-driven:
#
#   * file-head rationale comments (prose: board bring-up history, DDR sizing,
#     CDC discipline). Prose has no descriptor form.
#   * clocked processes (reset-release counter, marker-string matcher, the
#     tiny_bram JTAG DR shift/update/sync processes). These are behavioural
#     VHDL; the two that recur across siblings are emitted ONCE here and shared
#     (soc_reset_process is byte-identical in rv32 / rv64 / tiny_bram, and
#     soc_marker_process is one template parameterised by the marker length and
#     the alignment column).
#
# Everything else about these files lives in soc_top_types.spl descriptors.
# Determinism: arrays only, no Dict.

use std.hardware.vhdl_gen.gen_types.{vg_pad}

# ---------------------------------------------------------------------------
# Shared behavioural processes
# ---------------------------------------------------------------------------

# Free-running power-on reset release counter. Byte-identical in soc_top_rv32,
# soc_top_rv64 and soc_top_rv32_tiny_bram — emitted once, shared three ways.
fn soc_reset_process() -> [text]:
    var l: [text] = []
    l = l.push("  process(clk_core)")
    l = l.push("  begin")
    l = l.push("    if rising_edge(clk_core) then")
    l = l.push("      if rst_cnt < to_unsigned(RESET_RELEASE_COUNT, rst_cnt'length) then")
    l = l.push("        rst_cnt <= rst_cnt + 1;")
    l = l.push("        rst_q <= '1';")
    l = l.push("      else")
    l = l.push("        rst_q <= '0';")
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

# Marker-string matcher. `last_idx` is the final character index of the marker
# and `idx_w` the group-local alignment column for `marker_idx` (the rv64
# golden aligns it against `marker_seen`; the rv32 golden does not).
fn soc_marker_process(last_idx: i64, idx_w: i64) -> [text]:
    val mi = vg_pad("marker_idx", idx_w)
    var l: [text] = []
    l = l.push("  process(clk_core)")
    l = l.push("  begin")
    l = l.push("    if rising_edge(clk_core) then")
    l = l.push("      if rst_q = '1' then")
    l = l.push("        " + mi + " <= 0;")
    l = l.push("        marker_seen <= '0';")
    l = l.push("      elsif debug_uart_valid = '1' then")
    l = l.push("        if debug_uart_byte = marker_byte(marker_idx) then")
    l = l.push("          if marker_idx = " + last_idx.to_text() + " then")
    l = l.push("            marker_seen <= '1';")
    l = l.push("            " + mi + " <= 0;")
    l = l.push("          else")
    l = l.push("            marker_idx <= marker_idx + 1;")
    l = l.push("          end if;")
    l = l.push("        elsif debug_uart_byte = marker_byte(0) then")
    l = l.push("          marker_idx <= 1;")
    l = l.push("        else")
    l = l.push("          marker_idx <= 0;")
    l = l.push("        end if;")
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

# ---------------------------------------------------------------------------
# marker_byte lookup functions (two encodings across the pair)
# ---------------------------------------------------------------------------

# Case-table encoding (rv32): one `when <i> => return x"<hh>";` per byte, the
# last byte folded into the `when others` arm. Driven by the byte array, so the
# marker string is data, not text.
fn soc_marker_case_fn(bytes: [text]) -> [text]:
    var l: [text] = []
    l = l.push("  function marker_byte(idx : natural) return std_logic_vector is")
    l = l.push("  begin")
    l = l.push("    case idx is")
    var i = 0
    while i < bytes.len() - 1:
        l = l.push("      when " + i.to_text() + " => return x\"" + bytes[i] + "\";")
        i = i + 1
    l = l.push("      when others => return x\"" + bytes[bytes.len() - 1] + "\";")
    l = l.push("    end case;")
    l = l.push("  end function;")
    l

# String-constant encoding (rv64).
fn soc_marker_string_fn(mk: text) -> [text]:
    var l: [text] = []
    l = l.push("  -- Marker string \"" + mk + "\" (" + mk.len().to_text() + " chars) as an ASCII lookup.")
    l = l.push("  function marker_byte(idx : natural) return std_logic_vector is")
    l = l.push("    constant MK : string := \"" + mk + "\";")
    l = l.push("  begin")
    l = l.push("    return std_logic_vector(to_unsigned(character'pos(MK(idx + 1)), 8));")
    l = l.push("  end function;")
    l

# ---------------------------------------------------------------------------
# tiny_bram JTAG observation-DR processes (behavioural, no structural form)
# ---------------------------------------------------------------------------

fn soc_tiny_drck_process() -> [text]:
    var l: [text] = []
    l = l.push("  -- DRCK domain: capture response, shift command in / response out.")
    l = l.push("  process(bsc_drck)")
    l = l.push("  begin")
    l = l.push("    if rising_edge(bsc_drck) then")
    l = l.push("      if bsc_sel = '1' then")
    l = l.push("        if bsc_capture = '1' then")
    l = l.push("          dr_shift_q <= obs_resp; -- raw cross-domain sample; quasi-static by protocol")
    l = l.push("        elsif bsc_shift = '1' then")
    l = l.push("          dr_shift_q <= bsc_tdi & dr_shift_q(63 downto 1);")
    l = l.push("        end if;")
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

fn soc_tiny_update_process() -> [text]:
    var l: [text] = []
    l = l.push("  -- UPDATE-DR: latch the shifted-in command (low 32 bits) and flag it.")
    l = l.push("  process(bsc_update)")
    l = l.push("  begin")
    l = l.push("    if rising_edge(bsc_update) then")
    l = l.push("      if bsc_sel = '1' then")
    l = l.push("        cmd_reg_q <= dr_shift_q(31 downto 0);")
    l = l.push("        cmd_toggle_q <= not cmd_toggle_q;")
    l = l.push("      end if;")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

fn soc_tiny_sync_process() -> [text]:
    var l: [text] = []
    l = l.push("  -- clk_core domain: toggle -> one-cycle obs_cmd_valid pulse.")
    l = l.push("  process(clk_core)")
    l = l.push("  begin")
    l = l.push("    if rising_edge(clk_core) then")
    l = l.push("      tgl_sync_q <= cmd_toggle_q & tgl_sync_q(2 downto 1);")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l

# ---------------------------------------------------------------------------
# File-head rationale comments (prose)
# ---------------------------------------------------------------------------

fn soc_head_rv64() -> [text]:
    var l: [text] = []
    l = l.push("-- soc_top_rv64 — KV260 (Kria K26) board top for the hand-written rv64_exec_core.")
    l = l.push("--")
    l = l.push("-- Board variant (Vivado-only): clocked from the free-running STARTUPE3")
    l = l.push("-- CFGMCLK output (config-JTAG clock, ~50 MHz nominal on UltraScale+),")
    l = l.push("-- divided by 2 via BUFGCE_DIV for clk_core -- EXACTLY soc_top_rv32's own")
    l = l.push("-- clocking pattern, reused verbatim here after board bring-up (2026-07-24)")
    l = l.push("-- found that this design's original PS-block-design clock (pl_clk0) never")
    l = l.push("-- toggles under a JTAG-only bitstream download: a real ILA wired onto")
    l = l.push("-- clk_core (build/fpga evidence, ENABLE_UART_ILA build) showed HW_ILAS=0")
    l = l.push("-- (dbg_hub never enumerates => clk_core dead), and PS-side register")
    l = l.push("-- correctness (CRL_APB PL0_REF_CTRL, GPIO/EMIO pl_resetn0, PS-PL isolation)")
    l = l.push("-- verified via xsdb did not unstick it -- pl_clk0 delivery depends on PS")
    l = l.push("-- boot-time (FSBL) bring-up this JTAG-only flow bypasses. CFGMCLK has NO PS")
    l = l.push("-- dependency (same board, same chip, and soc_top_rv32 already completed a")
    l = l.push("-- real 981 s board soak on this exact clock source), so the PS block design")
    l = l.push("-- is dropped entirely: no k26_ps_bd, no pl_resetn0 handshake. Reset is a")
    l = l.push("-- plain free-running power-on release counter, identical to soc_top_rv32.")
    l = l.push("-- GHDL cannot elaborate this entity (STARTUPE3/BSCANE2 need unisim); use")
    l = l.push("-- soc_top_rv64_sim for simulation.")
    l

fn soc_head_rv64_sim() -> [text]:
    var l: [text] = []
    l = l.push("-- soc_top_rv64_sim — GHDL/simulation wrapper for rv64_exec_core.")
    l = l.push("--")
    l = l.push("-- Mirrors soc_top_rv32_sim: exposes clk/rst directly (no Xilinx PS BD or")
    l = l.push("-- STARTUPE3 primitives, which raw GHDL cannot elaborate). The board variant is")
    l = l.push("-- soc_top_rv64.vhd (Zynq pl_clk0-clocked). The testbenches instantiate THIS")
    l = l.push("-- entity.")
    l

fn soc_head_rv32_k26_ddr() -> [text]:
    var l: [text] = []
    l = l.push("-- soc_top_rv32_k26_ddr: PL top for booting rv32 SimpleOS on real KV260 (xck26)")
    l = l.push("-- silicon out of Zynq UltraScale+ PS DDR4.")
    l = l.push("--")
    l = l.push("-- Why DDR and not BRAM: the rv32 SimpleOS image needs ~8.19 MB of contiguous")
    l = l.push("-- RAM (sp = _stack_top = 0x8081d010) plus a FAT32 ramdisk window at 0x88000000.")
    l = l.push("-- An xck26 has ~2.9 MB of fabric BRAM total, so the working set cannot live in")
    l = l.push("-- the PL. rv32_axi4_mem_adapter therefore turns the core's stalled mem_* port")
    l = l.push("-- into an AXI4 master that reaches PS DDR through S_AXI_HP0_FPD.")
    l = l.push("--")
    l = l.push("--   M_AXI_HP    (this module -> SmartConnect -> zynq S_AXI_HP0_FPD -> DDR4)")
    l = l.push("--   S_AXI_CTRL  (zynq M_AXI_HPM0_LPD -> this module) control + observation")
    l = l.push("--")
    l = l.push("-- Bring-up order enforced by hardware: core_run resets to '0', so the soft-core")
    l = l.push("-- is held in reset from the moment the bitstream configures. Only after the")
    l = l.push("-- kernel and ramdisk images have been written into DDR (over JTAG via xsdb")
    l = l.push("-- `dow -data`, or by an FSBL) does software set CTRL bit0, releasing the core.")
    l = l.push("-- This makes it impossible for the core to fetch from uninitialised DDR.")
    l = l.push("--")
    l = l.push("-- Observation is over S_AXI_CTRL, not UART: on the KV260 carrier the fabric")
    l = l.push("-- UART TX pin (H12 / PMOD J2) is not routed to the onboard FT4232H, so no host")
    l = l.push("-- tty can see it. uart_tx is still brought out for an optional external 3.3 V")
    l = l.push("-- USB-UART on PMOD J2.")
    l

fn soc_head_rv64_k26_ddr() -> [text]:
    var l: [text] = []
    l = l.push("-- soc_top_rv64_k26_ddr: PL top for booting rv64 SimpleOS on real KV260 (xck26)")
    l = l.push("-- silicon out of Zynq UltraScale+ PS DDR4. Direct 64-bit widening of the")
    l = l.push("-- silicon-proven soc_top_rv32_k26_ddr (see that file for the full rationale).")
    l = l.push("--")
    l = l.push("-- Why DDR and not BRAM: the rv64 SimpleOS image spans core 0x80200000 (.text)")
    l = l.push("-- to ~0x84A20000 (.heap end) -- ~74 MB -- plus a FAT32 ramdisk window at")
    l = l.push("-- 0x88000000. An xck26 has ~2.9 MB of fabric BRAM total, so the working set")
    l = l.push("-- cannot live in the PL. rv64_axi4_mem_adapter turns the core's stalled mem_*")
    l = l.push("-- port (64-bit) into an AXI4 master that reaches PS DDR through S_AXI_HP0_FPD.")
    l = l.push("--")
    l = l.push("--   M_AXI_HP    (this module -> SmartConnect -> zynq S_AXI_HP0_FPD -> DDR4)")
    l = l.push("--   S_AXI_CTRL  (zynq M_AXI_HPM0_FPD -> this module) control + observation")
    l = l.push("--")
    l = l.push("-- Bring-up order enforced by hardware: core_run resets to '0', so the soft-core")
    l = l.push("-- is held in reset from the moment the bitstream configures. Only after the")
    l = l.push("-- kernel and ramdisk images have been written into DDR (over JTAG via xsdb")
    l = l.push("-- `dow -data`) AND .bss has been zeroed does software set CTRL bit0, releasing")
    l = l.push("-- the core. This makes it impossible for the core to fetch uninitialised DDR.")
    l = l.push("--")
    l = l.push("-- Observation reuses rv32_ctrl_obs_slave UNCHANGED (its interface is width-")
    l = l.push("-- agnostic except for the debug taps): the 64-bit debug values are TRUNCATED to")
    l = l.push("-- their low 32 bits for the observation registers. This is a documented,")
    l = l.push("-- deliberate loss: the whole rv64 SimpleOS address map lives under 4 GB, so the")
    l = l.push("-- low 32 PC/A0/SP/RA bits are fully identifying. MAGIC therefore still reads")
    l = l.push("-- 0x52563332 (\"RV32\") -- it proves slave reachability, not core width.")
    l = l.push("--")
    l = l.push("-- Default clock is 50 MHz (not the rv32 lane's 100 MHz): the rv32 build closed")
    l = l.push("-- at -0.115 ns WNS @100 MHz, so the wider 64-bit datapath is constrained to")
    l = l.push("-- 50 MHz to make timing MEET rather than repeating a negative-WNS gamble.")
    l

fn soc_head_rv32_tiny_bram() -> [text]:
    var l: [text] = []
    l = l.push("-- soc_top_rv32_tiny_bram: Vivado top for booting the TINY rv32 SimpleOS config")
    l = l.push("-- on real KV260 (xck26) silicon out of on-chip BRAM ONLY.")
    l = l.push("--")
    l = l.push("--   NO DDR, NO block design, NO FSBL, NO PS dependency of any kind:")
    l = l.push("--   * clock  = STARTUPE3 CFGMCLK (~50 MHz nominal) / 2 via BUFGCE_DIV — the")
    l = l.push("--     same PS-free pattern the proven Adler-32 ROM design used on this board.")
    l = l.push("--   * memory = rv32_bram_soc BRAM banks, INIT'd from .mem files at synthesis")
    l = l.push("--     time, so the kernel + FAT32 ramdisk are alive the moment the bitstream")
    l = l.push("--     configures. The core starts booting right after the reset counter.")
    l = l.push("--   * observation = BSCANE2 USER4 data register (KV260 PL UART pin H12/PMOD J2")
    l = l.push("--     is not routed to any host tty). This is a plain 64-bit DR, NOT the DMI")
    l = l.push("--     tunnel: shift in a 32-bit obs command, and the response to the PREVIOUS")
    l = l.push("--     command shifts out (lag-by-one, same discipline as the proven DMI")
    l = l.push("--     tunnel). Response = A55A(16) | cmd-echo(16) | data(32); the signature +")
    l = l.push("--     echo let the host find the bit alignment past the ARM DAP bypass bit.")
    l = l.push("--     Command set: see rv32_bram_soc.vhd (magic/status/pc/uartbuf/...).")
    l = l.push("--")
    l = l.push("-- CDC: the DR lives in the DRCK (JTAG) domain. UPDATE-DR latches the shifted")
    l = l.push("-- command and flips cmd_toggle; a 3-FF synchronizer in clk_core turns that")
    l = l.push("-- into a one-cycle obs_cmd_valid pulse. The 64-bit response register is")
    l = l.push("-- written in clk_core and sampled raw by CAPTURE-DR: safe because the host")
    l = l.push("-- reads a response microseconds-to-milliseconds after it stabilized (responses")
    l = l.push("-- only change when a new command is issued).")
    l
