# ============================================================================
# K26 AXI-HP Bridge — VexRiscv-SMP AXI4 to PS S_AXI_HP0
# ============================================================================
#
# Bridges the VexRiscv-SMP core's AXI4 master (iBus/dBus) to the Zynq
# UltraScale+ PS S_AXI_HP0 high-performance slave port for DDR access.
#
# AXI4 master side (from VexRiscv-SMP):
#   - 64-bit data, 32-bit address, burst-capable
#
# AXI-HP slave side (to PS DDR controller):
#   - 128-bit data, 49-bit address, burst-capable
#   - Directly accesses DDR4 via PS memory controller
#
# VHDL synthesizable subset: i64, u32, bool, structs only.
# ============================================================================

# ============================================================================
# AXI4 Master Signals (from VexRiscv-SMP core)
# ============================================================================

struct Axi4MasterWrite:
    awaddr: i64
    awlen: u32
    awsize: u32
    awburst: u32
    awvalid: bool
    wdata: i64
    wstrb: u32
    wlast: bool
    wvalid: bool
    bready: bool

struct Axi4MasterRead:
    araddr: i64
    arlen: u32
    arsize: u32
    arburst: u32
    arvalid: bool
    rready: bool

struct Axi4SlaveWriteResp:
    awready: bool
    wready: bool
    bresp: u32
    bvalid: bool

struct Axi4SlaveReadResp:
    arready: bool
    rdata: i64
    rresp: u32
    rlast: bool
    rvalid: bool

# ============================================================================
# AXI-HP Port Signals (to PS)
# ============================================================================

struct AxiHpMaster:
    awaddr: i64
    awlen: u32
    awsize: u32
    awburst: u32
    awvalid: bool
    wdata_lo: i64
    wdata_hi: i64
    wstrb: u32
    wlast: bool
    wvalid: bool
    bready: bool
    araddr: i64
    arlen: u32
    arsize: u32
    arburst: u32
    arvalid: bool
    rready: bool

struct AxiHpSlave:
    awready: bool
    wready: bool
    bresp: u32
    bvalid: bool
    arready: bool
    rdata_lo: i64
    rdata_hi: i64
    rresp: u32
    rlast: bool
    rvalid: bool

# ============================================================================
# Bridge State
# ============================================================================

struct AxiHpBridge:
    pending_write: bool
    pending_read: bool
    addr_offset: i64

# ============================================================================
# Bridge Operations
# ============================================================================

fn axi_hp_bridge_create() -> AxiHpBridge:
    return AxiHpBridge(
        pending_write: false,
        pending_read: false,
        addr_offset: 0
    )

fn axi_hp_bridge_forward_write(wr: Axi4MasterWrite) -> AxiHpMaster:
    return AxiHpMaster(
        awaddr: wr.awaddr,
        awlen: wr.awlen,
        awsize: wr.awsize,
        awburst: wr.awburst,
        awvalid: wr.awvalid,
        wdata_lo: wr.wdata,
        wdata_hi: 0,
        wstrb: wr.wstrb,
        wlast: wr.wlast,
        wvalid: wr.wvalid,
        bready: wr.bready,
        araddr: 0,
        arlen: 0,
        arsize: 0,
        arburst: 0,
        arvalid: false,
        rready: false
    )

fn axi_hp_bridge_forward_read(rd: Axi4MasterRead) -> AxiHpMaster:
    return AxiHpMaster(
        awaddr: 0,
        awlen: 0,
        awsize: 0,
        awburst: 0,
        awvalid: false,
        wdata_lo: 0,
        wdata_hi: 0,
        wstrb: 0,
        wlast: false,
        wvalid: false,
        bready: false,
        araddr: rd.araddr,
        arlen: rd.arlen,
        arsize: rd.arsize,
        arburst: rd.arburst,
        arvalid: rd.arvalid,
        rready: rd.rready
    )

fn axi_hp_bridge_write_resp(hp: AxiHpSlave) -> Axi4SlaveWriteResp:
    return Axi4SlaveWriteResp(
        awready: hp.awready,
        wready: hp.wready,
        bresp: hp.bresp,
        bvalid: hp.bvalid
    )

fn axi_hp_bridge_read_resp(hp: AxiHpSlave) -> Axi4SlaveReadResp:
    return Axi4SlaveReadResp(
        arready: hp.arready,
        rdata: hp.rdata_lo,
        rresp: hp.rresp,
        rlast: hp.rlast,
        rvalid: hp.rvalid
    )

pub fn generate_wb64_axi_hp_bridge_vhdl() -> text:
    """Generate the single-outstanding RV64 Wishbone-to-K26 AXI-HP bridge."""
    return """library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity wb64_axi_hp_bridge is
  port (
    clk            : in  std_logic;
    rst            : in  std_logic;
    wb_adr_i       : in  std_logic_vector(63 downto 0);
    wb_dat_i       : in  std_logic_vector(63 downto 0);
    wb_dat_o       : out std_logic_vector(63 downto 0);
    wb_we_i        : in  std_logic;
    wb_sel_i       : in  std_logic_vector(7 downto 0);
    wb_stb_i       : in  std_logic;
    wb_cyc_i       : in  std_logic;
    wb_lock_i      : in  std_logic;
    wb_ack_o       : out std_logic;
    wb_err_o       : out std_logic;
    m_axi_awaddr   : out std_logic_vector(48 downto 0);
    m_axi_awlen    : out std_logic_vector(7 downto 0);
    m_axi_awsize   : out std_logic_vector(2 downto 0);
    m_axi_awburst  : out std_logic_vector(1 downto 0);
    m_axi_awlock   : out std_logic;
    m_axi_awvalid  : out std_logic;
    m_axi_awready  : in  std_logic;
    m_axi_wdata    : out std_logic_vector(127 downto 0);
    m_axi_wstrb    : out std_logic_vector(15 downto 0);
    m_axi_wlast    : out std_logic;
    m_axi_wvalid   : out std_logic;
    m_axi_wready   : in  std_logic;
    m_axi_bresp    : in  std_logic_vector(1 downto 0);
    m_axi_bvalid   : in  std_logic;
    m_axi_bready   : out std_logic;
    m_axi_araddr   : out std_logic_vector(48 downto 0);
    m_axi_arlen    : out std_logic_vector(7 downto 0);
    m_axi_arsize   : out std_logic_vector(2 downto 0);
    m_axi_arburst  : out std_logic_vector(1 downto 0);
    m_axi_arlock   : out std_logic;
    m_axi_arvalid  : out std_logic;
    m_axi_arready  : in  std_logic;
    m_axi_rdata    : in  std_logic_vector(127 downto 0);
    m_axi_rresp    : in  std_logic_vector(1 downto 0);
    m_axi_rlast    : in  std_logic;
    m_axi_rvalid   : in  std_logic;
    m_axi_rready   : out std_logic
  );
end entity wb64_axi_hp_bridge;

architecture rtl of wb64_axi_hp_bridge is
  constant CORE_DDR_BASE : unsigned(48 downto 0) := shift_left(to_unsigned(1, 49), 31);
  constant K26_DDR_BASE  : unsigned(48 downto 0) := shift_left(to_unsigned(1, 49), 30);
  type state_t is (idle, write_issue, write_response, read_issue, read_response, wb_release);
  signal state       : state_t := idle;
  signal addr_q      : std_logic_vector(63 downto 0) := (others => '0');
  signal data_q      : std_logic_vector(63 downto 0) := (others => '0');
  signal sel_q       : std_logic_vector(7 downto 0) := (others => '0');
  signal upper_q     : std_logic := '0';
  signal axi_addr_q  : unsigned(48 downto 0);
  signal aw_pending  : std_logic := '0';
  signal w_pending   : std_logic := '0';
begin
  -- Core 0x80000000..0x8fffffff maps into an isolated PS DDR_LOW window at
  -- 0x40000000..0x4fffffff, leaving PS firmware/load memory separate.
  axi_addr_q <= unsigned(addr_q(48 downto 0)) - CORE_DDR_BASE + K26_DDR_BASE;
  m_axi_awaddr  <= std_logic_vector(axi_addr_q(48 downto 3)) & "000";
  m_axi_awlen   <= (others => '0');
  m_axi_awsize  <= "011";
  m_axi_awburst <= "01";
  -- The product core serializes atomics on its single-master bus. AXI LOCK is
  -- an exclusive transaction protocol, not a generic Wishbone lock.
  m_axi_awlock  <= '0';
  m_axi_awvalid <= aw_pending;
  m_axi_wdata   <= data_q & x"0000000000000000" when upper_q = '1'
                   else x"0000000000000000" & data_q;
  m_axi_wstrb   <= sel_q & x"00" when upper_q = '1' else x"00" & sel_q;
  m_axi_wlast   <= '1';
  m_axi_wvalid  <= w_pending;
  m_axi_bready  <= '1' when state = write_response else '0';

  m_axi_araddr  <= std_logic_vector(axi_addr_q(48 downto 3)) & "000";
  m_axi_arlen   <= (others => '0');
  m_axi_arsize  <= "011";
  m_axi_arburst <= "01";
  m_axi_arlock  <= '0';
  m_axi_arvalid <= '1' when state = read_issue else '0';
  m_axi_rready  <= '1' when state = read_response else '0';

  process(clk)
  begin
    if rising_edge(clk) then
      wb_ack_o <= '0';
      wb_err_o <= '0';
      if rst = '1' then
        state      <= idle;
        aw_pending <= '0';
        w_pending  <= '0';
        wb_dat_o   <= (others => '0');
      else
        case state is
          when idle =>
            if wb_cyc_i = '1' and wb_stb_i = '1' then
              addr_q  <= wb_adr_i;
              data_q  <= wb_dat_i;
              sel_q   <= wb_sel_i;
              upper_q <= wb_adr_i(3);
              if wb_we_i = '1' then
                aw_pending <= '1';
                w_pending  <= '1';
                state      <= write_issue;
              else
                state <= read_issue;
              end if;
            end if;

          when write_issue =>
            if aw_pending = '1' and m_axi_awready = '1' then
              aw_pending <= '0';
            end if;
            if w_pending = '1' and m_axi_wready = '1' then
              w_pending <= '0';
            end if;
            if (aw_pending = '0' or m_axi_awready = '1') and
               (w_pending = '0' or m_axi_wready = '1') then
              state <= write_response;
            end if;

          when write_response =>
            if m_axi_bvalid = '1' then
              wb_ack_o <= not m_axi_bresp(1);
              wb_err_o <= m_axi_bresp(1);
              state    <= wb_release;
            end if;

          when read_issue =>
            if m_axi_arready = '1' then
              state <= read_response;
            end if;

          when read_response =>
            if m_axi_rvalid = '1' then
              if upper_q = '1' then
                wb_dat_o <= m_axi_rdata(127 downto 64);
              else
                wb_dat_o <= m_axi_rdata(63 downto 0);
              end if;
              wb_ack_o <= not (m_axi_rresp(1) or not m_axi_rlast);
              wb_err_o <= m_axi_rresp(1) or not m_axi_rlast;
              state    <= wb_release;
            end if;

          when wb_release =>
            if wb_cyc_i = '0' or wb_stb_i = '0' then
              state <= idle;
            end if;
        end case;
      end if;
    end if;
  end process;
end architecture rtl;
"""

pub fn generate_rv64_k26_ps_pl_top_vhdl() -> text:
    """Connect the generated external-DDR SoC to the K26 AXI-HP bridge."""
    return """library ieee;
use ieee.std_logic_1164.all;

entity soc_top_rv64_k26_pl is
  port (
    clk            : in  std_logic;
    rst_n          : in  std_logic;
    uart_tx        : out std_logic;
    uart_rx        : in  std_logic;
    m_axi_awid     : out std_logic_vector(0 downto 0);
    m_axi_awaddr   : out std_logic_vector(48 downto 0);
    m_axi_awlen    : out std_logic_vector(7 downto 0);
    m_axi_awsize   : out std_logic_vector(2 downto 0);
    m_axi_awburst  : out std_logic_vector(1 downto 0);
    m_axi_awlock   : out std_logic;
    m_axi_awcache  : out std_logic_vector(3 downto 0);
    m_axi_awprot   : out std_logic_vector(2 downto 0);
    m_axi_awqos    : out std_logic_vector(3 downto 0);
    m_axi_awvalid  : out std_logic;
    m_axi_awready  : in  std_logic;
    m_axi_wdata    : out std_logic_vector(127 downto 0);
    m_axi_wstrb    : out std_logic_vector(15 downto 0);
    m_axi_wlast    : out std_logic;
    m_axi_wvalid   : out std_logic;
    m_axi_wready   : in  std_logic;
    m_axi_bid      : in  std_logic_vector(0 downto 0);
    m_axi_bresp    : in  std_logic_vector(1 downto 0);
    m_axi_bvalid   : in  std_logic;
    m_axi_bready   : out std_logic;
    m_axi_arid     : out std_logic_vector(0 downto 0);
    m_axi_araddr   : out std_logic_vector(48 downto 0);
    m_axi_arlen    : out std_logic_vector(7 downto 0);
    m_axi_arsize   : out std_logic_vector(2 downto 0);
    m_axi_arburst  : out std_logic_vector(1 downto 0);
    m_axi_arlock   : out std_logic;
    m_axi_arcache  : out std_logic_vector(3 downto 0);
    m_axi_arprot   : out std_logic_vector(2 downto 0);
    m_axi_arqos    : out std_logic_vector(3 downto 0);
    m_axi_arvalid  : out std_logic;
    m_axi_arready  : in  std_logic;
    m_axi_rid      : in  std_logic_vector(0 downto 0);
    m_axi_rdata    : in  std_logic_vector(127 downto 0);
    m_axi_rresp    : in  std_logic_vector(1 downto 0);
    m_axi_rlast    : in  std_logic;
    m_axi_rvalid   : in  std_logic;
    m_axi_rready   : out std_logic
  );
end entity soc_top_rv64_k26_pl;

architecture rtl of soc_top_rv64_k26_pl is
  signal rst           : std_logic;
  signal ddr_adr       : std_logic_vector(63 downto 0);
  signal ddr_dat_o     : std_logic_vector(63 downto 0);
  signal ddr_dat_i     : std_logic_vector(63 downto 0);
  signal ddr_we        : std_logic;
  signal ddr_sel       : std_logic_vector(7 downto 0);
  signal ddr_stb       : std_logic;
  signal ddr_cyc       : std_logic;
  signal ddr_lock      : std_logic;
  signal ddr_ack       : std_logic;
  signal ddr_err       : std_logic;
  signal debug_valid   : std_logic;
  signal debug_byte    : std_logic_vector(7 downto 0);
  attribute X_INTERFACE_INFO : string;
  attribute X_INTERFACE_PARAMETER : string;
  attribute X_INTERFACE_INFO of clk : signal is "xilinx.com:signal:clock:1.0 clk CLK";
  attribute X_INTERFACE_PARAMETER of clk : signal is "XIL_INTERFACENAME clk, ASSOCIATED_BUSIF M_AXI_HP, ASSOCIATED_RESET rst_n, FREQ_HZ 100000000";
  attribute X_INTERFACE_INFO of rst_n : signal is "xilinx.com:signal:reset:1.0 rst_n RST";
  attribute X_INTERFACE_PARAMETER of rst_n : signal is "XIL_INTERFACENAME rst_n, POLARITY ACTIVE_LOW";
  attribute X_INTERFACE_PARAMETER of m_axi_awaddr : signal is "XIL_INTERFACENAME M_AXI_HP, PROTOCOL AXI4, DATA_WIDTH 128, ADDR_WIDTH 49, ID_WIDTH 1, HAS_BURST 1, HAS_LOCK 1, HAS_CACHE 1, HAS_PROT 1, HAS_QOS 1, HAS_REGION 0, SUPPORTS_NARROW_BURST 1, MAX_BURST_LENGTH 256, NUM_READ_OUTSTANDING 1, NUM_WRITE_OUTSTANDING 1";
  attribute X_INTERFACE_INFO of m_axi_awid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWID";
  attribute X_INTERFACE_INFO of m_axi_awaddr : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWADDR";
  attribute X_INTERFACE_INFO of m_axi_awlen : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWLEN";
  attribute X_INTERFACE_INFO of m_axi_awsize : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWSIZE";
  attribute X_INTERFACE_INFO of m_axi_awburst : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWBURST";
  attribute X_INTERFACE_INFO of m_axi_awlock : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWLOCK";
  attribute X_INTERFACE_INFO of m_axi_awcache : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWCACHE";
  attribute X_INTERFACE_INFO of m_axi_awprot : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWPROT";
  attribute X_INTERFACE_INFO of m_axi_awqos : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWQOS";
  attribute X_INTERFACE_INFO of m_axi_awvalid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWVALID";
  attribute X_INTERFACE_INFO of m_axi_awready : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP AWREADY";
  attribute X_INTERFACE_INFO of m_axi_wdata : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP WDATA";
  attribute X_INTERFACE_INFO of m_axi_wstrb : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP WSTRB";
  attribute X_INTERFACE_INFO of m_axi_wlast : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP WLAST";
  attribute X_INTERFACE_INFO of m_axi_wvalid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP WVALID";
  attribute X_INTERFACE_INFO of m_axi_wready : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP WREADY";
  attribute X_INTERFACE_INFO of m_axi_bid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP BID";
  attribute X_INTERFACE_INFO of m_axi_bresp : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP BRESP";
  attribute X_INTERFACE_INFO of m_axi_bvalid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP BVALID";
  attribute X_INTERFACE_INFO of m_axi_bready : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP BREADY";
  attribute X_INTERFACE_INFO of m_axi_arid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARID";
  attribute X_INTERFACE_INFO of m_axi_araddr : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARADDR";
  attribute X_INTERFACE_INFO of m_axi_arlen : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARLEN";
  attribute X_INTERFACE_INFO of m_axi_arsize : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARSIZE";
  attribute X_INTERFACE_INFO of m_axi_arburst : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARBURST";
  attribute X_INTERFACE_INFO of m_axi_arlock : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARLOCK";
  attribute X_INTERFACE_INFO of m_axi_arcache : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARCACHE";
  attribute X_INTERFACE_INFO of m_axi_arprot : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARPROT";
  attribute X_INTERFACE_INFO of m_axi_arqos : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARQOS";
  attribute X_INTERFACE_INFO of m_axi_arvalid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARVALID";
  attribute X_INTERFACE_INFO of m_axi_arready : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP ARREADY";
  attribute X_INTERFACE_INFO of m_axi_rid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP RID";
  attribute X_INTERFACE_INFO of m_axi_rdata : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP RDATA";
  attribute X_INTERFACE_INFO of m_axi_rresp : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP RRESP";
  attribute X_INTERFACE_INFO of m_axi_rlast : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP RLAST";
  attribute X_INTERFACE_INFO of m_axi_rvalid : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP RVALID";
  attribute X_INTERFACE_INFO of m_axi_rready : signal is "xilinx.com:interface:aximm:1.0 M_AXI_HP RREADY";
begin
  rst <= not rst_n;
  m_axi_awid    <= (others => '0');
  m_axi_awcache <= "0011";
  m_axi_awprot  <= "000";
  m_axi_awqos   <= (others => '0');
  m_axi_arid    <= (others => '0');
  m_axi_arcache <= "0011";
  m_axi_arprot  <= "000";
  m_axi_arqos   <= (others => '0');

  u_soc: entity work.soc_top_rv64_external_ddr
    generic map (
      RESET_ADDR => x"0000000080000000"
    )
    port map (
      clk => clk,
      rst => rst,
      uart_tx => uart_tx,
      uart_rx => uart_rx,
      debug_uart_valid => debug_valid,
      debug_uart_byte => debug_byte,
      ddr_wb_adr_o => ddr_adr,
      ddr_wb_dat_o => ddr_dat_o,
      ddr_wb_dat_i => ddr_dat_i,
      ddr_wb_we_o => ddr_we,
      ddr_wb_sel_o => ddr_sel,
      ddr_wb_stb_o => ddr_stb,
      ddr_wb_cyc_o => ddr_cyc,
      ddr_wb_lock_o => ddr_lock,
      ddr_wb_ack_i => ddr_ack,
      ddr_wb_err_i => ddr_err
    );

  u_ddr_bridge: entity work.wb64_axi_hp_bridge
    port map (
      clk => clk,
      rst => rst,
      wb_adr_i => ddr_adr,
      wb_dat_i => ddr_dat_o,
      wb_dat_o => ddr_dat_i,
      wb_we_i => ddr_we,
      wb_sel_i => ddr_sel,
      wb_stb_i => ddr_stb,
      wb_cyc_i => ddr_cyc,
      wb_lock_i => ddr_lock,
      wb_ack_o => ddr_ack,
      wb_err_o => ddr_err,
      m_axi_awaddr => m_axi_awaddr,
      m_axi_awlen => m_axi_awlen,
      m_axi_awsize => m_axi_awsize,
      m_axi_awburst => m_axi_awburst,
      m_axi_awlock => m_axi_awlock,
      m_axi_awvalid => m_axi_awvalid,
      m_axi_awready => m_axi_awready,
      m_axi_wdata => m_axi_wdata,
      m_axi_wstrb => m_axi_wstrb,
      m_axi_wlast => m_axi_wlast,
      m_axi_wvalid => m_axi_wvalid,
      m_axi_wready => m_axi_wready,
      m_axi_bresp => m_axi_bresp,
      m_axi_bvalid => m_axi_bvalid,
      m_axi_bready => m_axi_bready,
      m_axi_araddr => m_axi_araddr,
      m_axi_arlen => m_axi_arlen,
      m_axi_arsize => m_axi_arsize,
      m_axi_arburst => m_axi_arburst,
      m_axi_arlock => m_axi_arlock,
      m_axi_arvalid => m_axi_arvalid,
      m_axi_arready => m_axi_arready,
      m_axi_rdata => m_axi_rdata,
      m_axi_rresp => m_axi_rresp,
      m_axi_rlast => m_axi_rlast,
      m_axi_rvalid => m_axi_rvalid,
      m_axi_rready => m_axi_rready
    );
end architecture rtl;
"""

pub fn generate_rv32_k26_ps_pl_top_vhdl() -> text:
    """Reuse the RV64 WB64/AXI shell around the RV32 compiler product SoC."""
    generate_rv64_k26_ps_pl_top_vhdl()
        .replace("soc_top_rv64_k26_pl", "soc_top_rv32_k26_pl")
        .replace("soc_top_rv64_external_ddr", "soc_top_rv32_external_ddr")

