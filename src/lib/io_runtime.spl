# Shim: std.io_runtime → nogc_sync_mut.io_runtime
# Created for interpreter-mode module resolution (binary can't search lib/*/ subdirs)
#
# Use explicit-origin exports here.  A layered `export use` makes the HIR
# surface builder chase package aliases while this module is still being
# materialized, so unrelated sibling facades can poison the origin and leave
# these canonical runtime operations unresolved in downstream compiler code.
export shell, shell_output, shell_bool, shell_output_trimmed, ShellResult, ProcessResult from nogc_sync_mut.io_runtime
export file_read, file_read_result, file_write, file_write_exact, file_exists, file_delete, file_copy, file_size, file_hash_sha256, file_hash_sha256_or_empty from nogc_sync_mut.io_runtime
export file_read_bytes, file_read_bytes_result, file_write_bytes, file_append_text from nogc_sync_mut.io_runtime
export read_file, read_file_text, read_file_text_result, write_file, remove_file_if_exists, file_size_raw from nogc_sync_mut.io_runtime
export dir_create, dir_create_all, is_dir, is_file, is_char_device, dir_list, dir_walk, dir_remove, dir_remove_all, dir_exists from nogc_sync_mut.io_runtime
export list_dir, mkdir_p from nogc_sync_mut.io_runtime
export env_get, env_get_nullable, env_get_opt, env_set, cwd, home, platform_name from nogc_sync_mut.io_runtime
export getpid, process_kill, process_run, process_run_bounded, process_spawn_async, process_is_running from nogc_sync_mut.io_runtime
export time_now_unix_micros, time_now_monotonic_ms, get_args, cli_arg_count, cli_arg_at, exit, thread_sleep from nogc_sync_mut.io_runtime
export hash_text, file_rename, file_move_cross_device, env_set_process, cwd_process, rename_path, shell_exec, process_run_timeout from nogc_sync_mut.io_runtime
export rt_file_write_text, rt_file_read_text, file_read_nullable from nogc_sync_mut.io_runtime
export host_os, host_arch from nogc_sync_mut.io_runtime
