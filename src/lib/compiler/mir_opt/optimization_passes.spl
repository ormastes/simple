# Stub re-export for std.compiler.mir_opt.optimization_passes
# Routes to the canonical implementation in
# src/compiler/60.mir_opt/_OptimizationPasses/{engine,io_passes}.spl.
# The intermediate legacy hop (src/compiler/60.mir_opt/optimization_passes.spl)
# is shadowed by this file under the `compiler.mir_opt.optimization_passes`
# spelling during entry-closure resolution, so the stub routes to the real
# owners directly.

export use compiler.mir_opt._OptimizationPasses.engine.{OptimizationLevel, OptimizationStats, OptimizationEngine}
export use compiler.mir_opt._OptimizationPasses.io_passes.{optimize_write_coalesce, optimize_read_ahead_hoist, optimize_syscall_batch, count_write_coalesce, count_read_ahead_hoist, count_syscall_batch}
