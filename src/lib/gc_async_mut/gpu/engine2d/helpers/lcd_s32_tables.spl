# LCD text coverage tables shared by the CPU composite (`engine2d_lcd_quad_composite`
# in engine.spl) and the Vulkan font batch packer (backend_vulkan_font.spl),
# which ships the same tables to the font kernel (shaders/font_atlas_batch.comp)
# so the device blend is byte-identical to the CPU one.
use std.common.math.math.{math_pow}


# Coverage preblend by the text colour channel (Skia SkMaskGamma, Chrome 159):
# light text gets thicker coverage. Measured from the same 16 px glyphs drawn
# white-on-black vs black-on-white (identical phases): mask steps 2->3, 8->10.5,
# 17->19, 24->26, 28->29 of 32; red #c00000 R 2->3; navy #172033 B 17->18.
# Modelled as cov' = cov^(1 - 0.22 * L / 255) for channel value L; black
# (L = 0) is the identity, which is what the FIR fit above was measured on.
var _engine2d_lcd_preblend_tables: Dict<i64, [i64]> = {}

fn _engine2d_lcd_preblend(level: i64) -> [i64]:
    if val Some(hit) = _engine2d_lcd_preblend_tables.get(level):
        return hit
    var table: [i64] = [0; 256]
    val exponent = 1.0 - 0.22 * (level as f64) / 255.0
    var i: i64 = 0
    while i < 256:
        if level == 0 or i == 0 or i == 255:
            table[i] = i
        else:
            val v = math_pow((i as f64) / 255.0, exponent) * 255.0 + 0.5
            table[i] = if v > 255.0: 255 else: v as i64
        i = i + 1
    _engine2d_lcd_preblend_tables[level] = table
    table

# Per text colour: coverage -> Skia s32 for R (0..255), G (256..511) and B
# (512..767), preblend and text alpha folded in.
var _engine2d_lcd_s32_cache: Dict<i64, [i64]> = {}

pub fn engine2d_lcd_s32_tables(color: u32) -> [i64]:
    val key = color.to_i64()
    if val Some(hit) = _engine2d_lcd_s32_cache.get(key):
        return hit
    val color_alpha = ((color >> 24) & 0xFFu32).to_i64()
    var table: [i64] = [0; 768]
    var ch: i64 = 0
    while ch < 3:
        val pre = _engine2d_lcd_preblend(((color >> (16 - 8 * ch).to_u32()) & 0xFFu32).to_i64())
        var c: i64 = 0
        while c < 256:
            val s5 = (pre[c] * color_alpha / 255) >> 3
            table[ch * 256 + c] = s5 + (s5 >> 4)
            c = c + 1
        ch = ch + 1
    _engine2d_lcd_s32_cache[key] = table
    table
