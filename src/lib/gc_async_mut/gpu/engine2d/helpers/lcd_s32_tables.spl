# LCD text coverage tables shared by the CPU composite (`engine2d_lcd_quad_composite`
# in engine.spl) and the Vulkan font batch packer (backend_vulkan_font.spl),
# which ships the same tables to the font kernel (shaders/font_atlas_batch.comp)
# so the device blend is byte-identical to the CPU one.
use std.common.math.math.{math_pow}


# Coverage preblend by the text colour channel: Skia's SkMaskGamma correcting
# LUT (SkTMaskGamma_build_correcting_lut) with Chrome's Linux constants,
# SK_GAMMA_EXPONENT 1.2 and SK_GAMMA_CONTRAST 0.2. The channel value is first
# reduced to Skia's 3 luminance bits (SkTMaskGamma<3, 3, 3>::CanonicalColor).
# Measured on 16 px Liberation Sans black text against Chrome 159 together
# with the exact-area 4x-wide raster and Skia's 12-tap LCD FIR (sfnt_glyf.spl):
# the `l` stem at four phases and the `n` stems match to the LCD16 step. The
# fitted exponent / cubic lift used here before compensated the old raster.
var _engine2d_lcd_preblend_tables: Dict<i64, [i64]> = {}

val _LCD_GAMMA: f64 = 1.2
val _LCD_CONTRAST: f64 = 0.2125

fn _engine2d_lcd_contrast(a: f64, contrast: f64) -> f64:
    a + (1.0 - a) * contrast * a

fn _engine2d_lcd_preblend(level: i64) -> [i64]:
    # Only the 3 luminance bits shape the table (CanonicalColor), so 8 tables
    # cover every channel value.
    val bits = level >> 5
    if val Some(hit) = _engine2d_lcd_preblend_tables.get(bits):
        return hit
    var table: [i64] = [0; 256]
    val canonical = (bits << 5) | (bits << 2) | (bits >> 1)
    val src = (canonical as f64) / 255.0
    val lin_src = math_pow(src, _LCD_GAMMA)
    val dst = 1.0 - src
    val lin_dst = math_pow(dst, _LCD_GAMMA)
    val contrast = _LCD_CONTRAST * lin_dst
    val flat = (src - dst) < 1.0 / 256.0 and (dst - src) < 1.0 / 256.0
    var i: i64 = 0
    while i < 256:
        val srca = _engine2d_lcd_contrast((i as f64) / 255.0, contrast)
        var result = srca
        if not flat:
            val lin_out = lin_src * srca + (1.0 - srca) * lin_dst
            val out = math_pow(lin_out, 1.0 / _LCD_GAMMA)
            result = (out - dst) / (src - dst)
        var v = (255.0 * result + 0.5) as i64
        if v < 0: v = 0
        if v > 255: v = 255
        table[i] = v
        i = i + 1
    _engine2d_lcd_preblend_tables[bits] = table
    table

# Per text colour: coverage -> Skia s32 for R (0..255), G (256..511) and B
# (512..767), preblend and text alpha folded in.
var _engine2d_lcd_s32_cache: Dict<i64, [i64]> = {}

# reason: colour is a packed 0xAARRGGBB word and the result is the kernel's 3 x 256 s32 table, both shared verbatim with the font kernel
# @allow(primitive_api)
pub fn engine2d_lcd_s32_tables(color: u32) -> [i64]:
    val key = color.to_i64()
    if val Some(hit) = _engine2d_lcd_s32_cache.get(key):
        return hit
    val color_alpha = ((color >> 24) & 0xFFu32).to_i64()
    var table: [i64] = [0; 768]
    var ch: i64 = 0
    while ch < 3:
        val pre = _engine2d_lcd_preblend(((color >> (16 - 8 * ch).to_u32()) & 0xFFu32).to_i64())
        var c: i64 = 0
        while c < 256:
            val s5 = pre[c] >> 3
            table[ch * 256 + c] = ((s5 + (s5 >> 4)) * (color_alpha + 1)) >> 8
            c = c + 1
        ch = ch + 1
    _engine2d_lcd_s32_cache[key] = table
    table
