# Skia-matched blur kernels (Chrome 159): the backdrop-filter region blur and
# the 1-D blurred-step profile used by box shadows. A leaf module, so both the
# Draw IR painters and the Engine2D backends can import it.
use std.common.math.math.{math_exp}

# CSS `backdrop-filter: blur()` as Chrome 159 paints it: a Gaussian with
# sigma = `sigma_milli` / 1000 device px over the w x h box region alone,
# mirrored at its edges (nothing outside the box bleeds in), averaged in
# premultiplied ARGB.
# @allow(primitive_api): raw ARGB pixel region and device-px sizes shared by the Draw IR and raster painters
pub fn engine2d_backdrop_blur_pixels(src: [u32], w: i32, h: i32, sigma_milli: i32) -> [u32]:
    val n = (w as i64) * (h as i64)
    if w <= 0 or h <= 0 or sigma_milli <= 0 or src.len() != n:
        return src
    val sigma = sigma_milli.to_f64() / 1000.0
    val rad = (sigma * 3.0).ceil() as i32
    var wt: [i64] = []
    var total: i64 = 0
    var i = -rad
    # cpu-lane-loop-ok: Gaussian kernel taps; bound 2*ceil(3*sigma)+1
    while i <= rad:
        val v = (math_exp(-(i * i).to_f64() / (2.0 * sigma * sigma)) * 65536.0 + 0.5) as i64
        wt.push(v)
        total = total + v
        i = i + 1
    var planes: [i64] = [0; n * 4]
    var p: i64 = 0
    # cpu-lane-loop-ok: premultiply the box region once; bound w*h
    while p < n:
        val c = src[p]
        val a = ((c >> 24) & 0xFFu32) as i64
        planes[p * 4] = a
        planes[p * 4 + 1] = (((c >> 16) & 0xFFu32) as i64) * a
        planes[p * 4 + 2] = (((c >> 8) & 0xFFu32) as i64) * a
        planes[p * 4 + 3] = ((c & 0xFFu32) as i64) * a
        p = p + 1
    # Skia raster (sigma >= 2): the SVG triple box of size d over 8-bit
    # premultiplied channels; below that a true Gaussian kernel.
    val d = (sigma * 3.0 * 2.5066282746310002 / 4.0 + 0.5) as i32
    val both = if sigma >= 2.0:
        _e2d_triple_box(planes, w, h, d)
    else:
        _e2d_gauss_pass(_e2d_gauss_pass(planes, w, h, wt, total, rad, true), w, h, wt, total, rad, false)
    var out: [u32] = [0u32; n]
    p = 0
    # cpu-lane-loop-ok: unpremultiply the box region once; bound w*h
    while p < n:
        val a = both[p * 4]
        if a > 0:
            val r = (both[p * 4 + 1] + a / 2) / a
            val g = (both[p * 4 + 2] + a / 2) / a
            val b = (both[p * 4 + 3] + a / 2) / a
            out[p] = ((a as u32) << 24) | (((if r > 255: 255 else: r) as u32) << 16) | (((if g > 255: 255 else: g) as u32) << 8) | ((if b > 255: 255 else: b) as u32)
        p = p + 1
    out


# The same blur over ONE 8-bit coverage plane (a glyph mask for a blurred
# text-shadow): a quarter of the work of the four-channel region blur. Lines
# are extended with zeros, so the plane needs no edge treatment of its own.
# @allow(primitive_api): raw 8-bit coverage plane and device-px sizes of a text-shadow mask
pub fn engine2d_blur_coverage(cov: [i64], w: i32, h: i32, sigma_milli: i32) -> [i64]:
    val n = (w as i64) * (h as i64)
    if w <= 0 or h <= 0 or sigma_milli <= 0 or cov.len() != n:
        return cov
    _e2d_cov_axis(_e2d_cov_axis(cov, w, h, sigma_milli, true), w, h, sigma_milli, false)

fn _e2d_cov_axis(cov: [i64], w: i32, h: i32, sigma_milli: i32, horizontal: bool) -> [i64]:
    val sigma = sigma_milli.to_f64() / 1000.0
    val d = (sigma * 3.0 * 2.5066282746310002 / 4.0 + 0.5) as i32
    val rad = (sigma * 3.0).ceil() as i32
    val m = rad + 3 * (d / 2 + 1) + 1
    val lo_a = if d % 2 == 0: d / 2 else: (d - 1) / 2
    val lo_b = if d % 2 == 0: d / 2 - 1 else: (d - 1) / 2
    val d_c = if d % 2 == 0: d + 1 else: d
    var wt: [i64] = []
    var total: i64 = 0
    if sigma < 2.0:
        var t = -rad
        # cpu-lane-loop-ok: Gaussian kernel taps; bound 2*ceil(3*sigma)+1
        while t <= rad:
            val v = (math_exp(-(t * t).to_f64() / (2.0 * sigma * sigma)) * 65536.0 + 0.5) as i64
            wt.push(v)
            total = total + v
            t = t + 1
    val len = if horizontal: w else: h
    val lines = if horizontal: h else: w
    val ext = len + 2 * m
    var out: [i64] = [0; cov.len()]
    var line = 0
    # cpu-lane-loop-ok: one row or column of the mask per step; bound h or w
    while line < lines:
        var buf: [i64] = [0; ext]
        var i = 0
        # cpu-lane-loop-ok: the zero-extended line; bound len
        while i < len:
            val q = if horizontal: (line as i64) * (w as i64) + (i as i64) else: (i as i64) * (w as i64) + (line as i64)
            buf[(i + m) as i64] = cov[q]
            i = i + 1
        var r: [i64] = [0; ext]
        if sigma >= 2.0:
            r = _e2d_box_line(_e2d_box_line(_e2d_box_line(buf, d, lo_a), d, lo_b), d_c, d_c / 2)
        else:
            i = rad
            # cpu-lane-loop-ok: Gaussian taps along the line; bound ext * (2*rad+1)
            while i < ext - rad:
                var s: i64 = 0
                var t = -rad
                while t <= rad:
                    s = s + buf[(i + t) as i64] * wt[(t + rad) as i64]
                    t = t + 1
                r[i as i64] = (s + total / 2) / total
                i = i + 1
        i = 0
        # cpu-lane-loop-ok: crop the extension; bound len
        while i < len:
            val q = if horizontal: (line as i64) * (w as i64) + (i as i64) else: (i as i64) * (w as i64) + (line as i64)
            out[q] = r[(i + m) as i64]
            i = i + 1
        line = line + 1
    out

# Skia's legacy raster blur for sigma >= 2 (the SVG feGaussianBlur box
# approximation): per axis three box passes of size d (odd d: all centred;
# even d: d left-biased, d right-biased, then d + 1 centred), each rounded to
# 8 bits with Skia's (sum * (2^24 / d) + 2^23) >> 24. The region is extended
# by mirroring before the passes, so the box edge is mirrored once.
fn _e2d_triple_box(planes: [i64], w: i32, h: i32, d: i32) -> [i64]:
    val n = (w as i64) * (h as i64)
    var p8: [i64] = [0; n * 4]
    var p: i64 = 0
    # cpu-lane-loop-ok: 16-bit premultiplied to 8-bit premultiplied; bound w*h*4
    while p < n * 4:
        p8[p] = if p % 4 == 0: planes[p] else: (planes[p] + 127) / 255
        p = p + 1
    val horiz = _e2d_box3_axis(p8, w, h, d, true)
    var both = _e2d_box3_axis(horiz, w, h, d, false)
    p = 0
    # cpu-lane-loop-ok: back to the 16-bit premultiplied scale; bound w*h*4
    while p < n * 4:
        if p % 4 != 0:
            both[p] = both[p] * 255
        p = p + 1
    both

fn _e2d_box3_axis(planes: [i64], w: i32, h: i32, d: i32, horizontal: bool) -> [i64]:
    var out: [i64] = [0; planes.len()]
    val len = if horizontal: w else: h
    val lines = if horizontal: h else: w
    val m = 3 * (d / 2 + 1) + 1
    val ext = len + 2 * m
    val lo_a = if d % 2 == 0: d / 2 else: (d - 1) / 2
    val lo_b = if d % 2 == 0: d / 2 - 1 else: (d - 1) / 2
    val d_c = if d % 2 == 0: d + 1 else: d
    var line = 0
    # cpu-lane-loop-ok: one row or column of the blurred box region per step; bound h or w
    while line < lines:
        var ch: i64 = 0
        # cpu-lane-loop-ok: the 4 premultiplied channels; bound 4
        while ch < 4:
            var buf: [i64] = [0; ext]
            var i = 0
            # cpu-lane-loop-ok: mirror-extended line; bound len + 2m
            while i < ext:
                val s = _e2d_mirror(i - m, len)
                val q = if horizontal: (line as i64) * (w as i64) + (s as i64) else: (s as i64) * (w as i64) + (line as i64)
                buf[i] = planes[q * 4 + ch]
                i = i + 1
            val r = _e2d_box_line(_e2d_box_line(_e2d_box_line(buf, d, lo_a), d, lo_b), d_c, d_c / 2)
            i = 0
            # cpu-lane-loop-ok: crop the extension; bound len
            while i < len:
                val q = if horizontal: (line as i64) * (w as i64) + (i as i64) else: (i as i64) * (w as i64) + (line as i64)
                out[q * 4 + ch] = r[i + m]
                i = i + 1
            ch = ch + 1
        line = line + 1
    out

# out[i] = mean of buf[i - lo .. i - lo + d - 1] (indices clamped), Skia rounding.
fn _e2d_box_line(buf: [i64], d: i32, lo: i32) -> [i64]:
    val len = buf.len() as i32
    var out: [i64] = [0; buf.len()]
    val scale: i64 = 16777216 / (d as i64)
    var sum: i64 = 0
    var j = -lo
    # cpu-lane-loop-ok: initial box window; bound d
    while j < d - lo:
        sum = sum + buf[(if j < 0: 0 elif j >= len: len - 1 else: j) as i64]
        j = j + 1
    var i = 0
    # cpu-lane-loop-ok: sliding box window along the line; bound len
    while i < len:
        out[i as i64] = (sum * scale + 8388608) >> 24
        val leave = i - lo
        val enter = i - lo + d
        sum = sum - buf[(if leave < 0: 0 elif leave >= len: len - 1 else: leave) as i64] + buf[(if enter < 0: 0 elif enter >= len: len - 1 else: enter) as i64]
        i = i + 1
    out

# One axis of a blurred rect (it separates): coverage 0..255 of the step
# [start, end) after the backdrop blur kernel, sampled at lo .. hi - 1.
# @allow(primitive_api): 1-D device-px step and coverage profile shared with the raster shadow painter
pub fn engine2d_blur_step_profile(start: i32, end: i32, lo: i32, hi: i32, sigma_milli: i32) -> [i32]:
    var out: [i32] = []
    if hi <= lo:
        return out
    val sigma = sigma_milli.to_f64() / 1000.0
    val d = (sigma * 3.0 * 2.5066282746310002 / 4.0 + 0.5) as i32
    val m = (sigma * 3.0).ceil() as i32 + 3 * (d / 2 + 1) + 1
    val ext = hi - lo + 2 * m
    var buf: [i64] = [0; ext]
    var i = 0
    # cpu-lane-loop-ok: the step over the extended axis; bound hi - lo + 2m
    while i < ext:
        val p = lo - m + i
        buf[i as i64] = if p >= start and p < end: 255 else: 0
        i = i + 1
    var r = buf
    if sigma >= 2.0:
        val lo_a = if d % 2 == 0: d / 2 else: (d - 1) / 2
        val lo_b = if d % 2 == 0: d / 2 - 1 else: (d - 1) / 2
        val d_c = if d % 2 == 0: d + 1 else: d
        r = _e2d_box_line(_e2d_box_line(_e2d_box_line(buf, d, lo_a), d, lo_b), d_c, d_c / 2)
    elif sigma_milli > 0:
        val one = engine2d_backdrop_blur_pixels(_e2d_step_pixels(buf), ext, 1, sigma_milli)
        i = 0
        # cpu-lane-loop-ok: alpha channel of the blurred step; bound ext
        while i < ext:
            r[i as i64] = ((one[i as i64] >> 24) & 0xFFu32) as i64
            i = i + 1
    i = 0
    # cpu-lane-loop-ok: crop the extension; bound hi - lo
    while i < hi - lo:
        out.push(r[(i + m) as i64] as i32)
        i = i + 1
    out

fn _e2d_step_pixels(buf: [i64]) -> [u32]:
    var px: [u32] = []
    for v in buf:
        px.push((v as u32) << 24)
    px
# Mirror index for Skia's kMirror tile mode: -1 -> 0, len -> len - 1.
fn _e2d_mirror(i: i32, len: i32) -> i32:
    val period = 2 * len
    var m = i % period
    if m < 0:
        m = m + period
    if m >= len: period - 1 - m else: m

# One separable Gaussian pass over 4 interleaved premultiplied channels,
# rounded back to channel precision (alpha 0..255, colour 0..65025).
fn _e2d_gauss_pass(planes: [i64], w: i32, h: i32, wt: [i64], total: i64, rad: i32, horizontal: bool) -> [i64]:
    var out: [i64] = [0; planes.len()]
    val len = if horizontal: w else: h
    var y = 0
    # cpu-lane-loop-ok: one row of the blurred box region per step; bound h
    while y < h:
        var x = 0
        # cpu-lane-loop-ok: one pixel of the blurred box region per step; bound w
        while x < w:
            var s0: i64 = 0
            var s1: i64 = 0
            var s2: i64 = 0
            var s3: i64 = 0
            var t = -rad
            # cpu-lane-loop-ok: Gaussian taps per pixel; bound 2*ceil(3*sigma)+1
            while t <= rad:
                val m = _e2d_mirror((if horizontal: x else: y) + t, len)
                val q = if horizontal: ((y as i64) * (w as i64) + (m as i64)) * 4 else: ((m as i64) * (w as i64) + (x as i64)) * 4
                val k = wt[(t + rad) as i64]
                s0 = s0 + planes[q] * k
                s1 = s1 + planes[q + 1] * k
                s2 = s2 + planes[q + 2] * k
                s3 = s3 + planes[q + 3] * k
                t = t + 1
            val o = ((y as i64) * (w as i64) + (x as i64)) * 4
            out[o] = (s0 + total / 2) / total
            out[o + 1] = (s1 + total / 2) / total
            out[o + 2] = (s2 + total / 2) / total
            out[o + 3] = (s3 + total / 2) / total
            x = x + 1
        y = y + 1
    out
