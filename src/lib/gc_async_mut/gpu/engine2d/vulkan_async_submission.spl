"""Pure-Simple owner facade for the runtime-owned Vulkan B/N2 submission ring.

The facade owns the session handle and forwards opaque provider tokens.
Command buffers, slot-generation authority, fences, and descriptor/buffer
owners remain runtime-owned until `retire` returns 1.
"""

use std.gc_async_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_async_session_acquire,
    vulkan_sffi_async_session_bind_buffer,
    vulkan_sffi_async_session_bind_buffer_supported,
    vulkan_sffi_async_session_command,
    vulkan_sffi_async_session_submit,
    vulkan_sffi_async_session_poll,
    vulkan_sffi_async_session_retire,
    vulkan_sffi_async_session_receipt,
    vulkan_sffi_async_session_cancel,
    vulkan_sffi_async_session_close,
    vulkan_sffi_async_session_capacity,
    vulkan_sffi_async_session_in_flight,
    vulkan_sffi_async_session_published_sequence,
    vulkan_sffi_async_session_supported,
    vulkan_sffi_async_session_create_with_wait,
    vulkan_sffi_async_session_recover,
    vulkan_sffi_async_session_abandon_device,
    vulkan_sffi_async_session_snapshot,
    vulkan_sffi_async_session_snapshot_word
}
use std.common.gpu.render_surface_contract.{
    GPU_ASYNC_ACCESS_READ, GPU_ASYNC_ACCESS_WRITE,
    GPU_ASYNC_ACCESS_READ_WRITE, gpu_async_frame_ring_capacity_v2_valid,
    gpu_async_wait_timeout_v2_valid
}

pub val VULKAN_ASYNC_RETIRED: i64 = 1
pub val VULKAN_ASYNC_PENDING: i64 = 0
pub val VULKAN_ASYNC_INVALID: i64 = -1
pub val VULKAN_ASYNC_UNKNOWN: i64 = -2
pub val VULKAN_ASYNC_WOULD_BLOCK: i64 = -3
pub val VULKAN_ASYNC_CLOSED: i64 = -4
pub val VULKAN_ASYNC_QUARANTINED: i64 = 2
pub val VULKAN_ASYNC_BIND_INVALID: i64 = -1
pub val VULKAN_ASYNC_BIND_UNSUPPORTED: i64 = -5

# The checked managed range-binding provider operation is not present in the
# canonical runtime ABI yet. Engine2D callers can query this explicitly and
# keep the legacy path separate.
pub fn vulkan_async_session_bind_buffer_supported() -> bool:
    vulkan_sffi_async_session_bind_buffer_supported()

pub class VulkanAsyncSubmissionSession:
    handle: i64
    capacity: i64
    terminal_handle: i64

    static fn open(capacity: i64) -> VulkanAsyncSubmissionSession:
        VulkanAsyncSubmissionSession.open_with_wait(capacity, 1000000)

    static fn open_with_wait(capacity: i64, timeout_ns: i64) -> VulkanAsyncSubmissionSession:
        var handle = 0
        if gpu_async_frame_ring_capacity_v2_valid(capacity) and
           gpu_async_wait_timeout_v2_valid(timeout_ns) and
           vulkan_sffi_async_session_supported() == 1:
            handle = vulkan_sffi_async_session_create_with_wait(capacity, timeout_ns)
        VulkanAsyncSubmissionSession(
            handle: handle,
            terminal_handle: 0,
            capacity: if handle > 0:
                vulkan_sffi_async_session_capacity(handle)
            else:
                0
        )

    fn is_open() -> bool:
        self.handle > 0

    fn acquire() -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_acquire(self.handle)

    # Bind a range through the runtime owner while this exact opaque token is
    # recording. The provider/runtime is authoritative for slot-generation,
    # range-conflict, and resource-retention decisions; this facade only
    # validates scalar shape and never waits for a prior frame or reads back.
    fn bind_buffer(token: i64, descriptor_set: i64, binding: i64,
                   buffer: i64, offset: i64, range: i64, access: i64) -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        if token <= 0 or descriptor_set <= 0 or binding < 0 or
           binding > 4294967295 or buffer <= 0 or
           offset < 0 or range <= 0 or
           offset > 9223372036854775807 - range or
           (access != GPU_ASYNC_ACCESS_READ and
            access != GPU_ASYNC_ACCESS_WRITE and
            access != GPU_ASYNC_ACCESS_READ_WRITE):
            return VULKAN_ASYNC_BIND_INVALID
        if not vulkan_async_session_bind_buffer_supported():
            return VULKAN_ASYNC_BIND_UNSUPPORTED
        vulkan_sffi_async_session_bind_buffer(self.handle, token,
            descriptor_set, binding, buffer, offset, range, access)

    fn command(token: i64) -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_command(self.handle, token)

    fn submit(token: i64) -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_submit(self.handle, token)

    fn poll(token: i64) -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_poll(self.handle, token)

    fn retire(token: i64) -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_retire(self.handle, token)

    fn receipt(sequence: i64) -> i64:
        if self.handle <= 0:
            return 0
        vulkan_sffi_async_session_receipt(self.handle, sequence)

    fn cancel() -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_cancel(self.handle)

    # Explicit device-wide recovery; never used by the normal frame loop.
    fn recover() -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        vulkan_sffi_async_session_recover(self.handle)

    # Forced device teardown after failed recovery retains the entire device
    # generation in one bounded runtime quarantine. Result 2 is NOT completion.
    me abandon_device() -> i64:
        if self.handle <= 0:
            return VULKAN_ASYNC_INVALID
        val result = vulkan_sffi_async_session_abandon_device(self.handle)
        if result == VULKAN_ASYNC_QUARANTINED:
            self.terminal_handle = self.handle
            self.handle = 0
            self.capacity = 0
        result

    # Fixed version-1 copied record. Empty means unavailable/stale, never zero
    # activity. Concurrent snapshot replacement causes explicit rejection.
    fn telemetry() -> [i64]:
        val query_handle = if self.handle > 0: self.handle else: self.terminal_handle
        if query_handle <= 0:
            return []
        val snapshot = vulkan_sffi_async_session_snapshot(query_handle)
        if snapshot <= 0:
            return []
        var words: [i64] = []
        for index in 0..64:
            val word = vulkan_sffi_async_session_snapshot_word(query_handle, snapshot, index)
            if word < 0:
                return []
            words.push(word)
        words

    me close() -> i64:
        if self.handle <= 0:
            return 1
        val result = vulkan_sffi_async_session_close(self.handle)
        if result == 1:
            self.terminal_handle = self.handle
            self.handle = 0
            self.capacity = 0
        result

    fn in_flight() -> i64:
        if self.handle <= 0:
            return 0
        vulkan_sffi_async_session_in_flight(self.handle)

    fn published_sequence() -> i64:
        if self.handle <= 0:
            return 0
        vulkan_sffi_async_session_published_sequence(self.handle)
