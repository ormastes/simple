    me _draw_font_batch(x: i32, y: i32, batch: FontRenderBatch) -> bool:
        self._draw_font_batch_plan(x, y, batch, ["cuda", "metal", "opencl", "vulkan", "rocm", "cpu"])

    me _draw_font_batch_cpu_suffix(x: i32, y: i32, batch: FontRenderBatch, submitted: i64) -> i64:
        var quad_index = if submitted < 0 or submitted > batch.quads.len(): 0 else: submitted
        while quad_index < batch.quads.len():
            val quad = batch.quads[quad_index]
            val pixels = engine2d_font_atlas_subrect_pixels(
                batch.atlas_pixels, batch.atlas_width, batch.atlas_height,
                quad.atlas_x, quad.atlas_y, quad.width, quad.height, quad.color
            )
            # See doc/08_tracking/bug/font_render_batch_transform_identity_default_not_applied_2026-07-19.md
            # (BLOCKER B): the Option<i32>-returning font_destination_origin(...).?
            # round-trip decoded to a CONSTANT (1, 1) for every quad of every
            # draw here on this freestanding target -- confirmed via gated
            # boot probes: dst_x=1 dst_y=1 regardless of x spanning 6..3788
            # and quad.dst_x varying per glyph, which collapsed every draw's
            # glyphs onto the same origin pixel. Same "constructed value loses
            # its real payload" family as the transform_identity class-default
            # bug. Compute the destination with plain i64 arithmetic and an
            # explicit bounds check instead of routing through the Option
            # helper, so the real value survives.
            val dst_x_i64 = x.to_i64() + quad.dst_x.to_i64()
            val dst_y_i64 = y.to_i64() + quad.dst_y.to_i64()
            val dst_x_end = dst_x_i64 + quad.width.to_i64() - 1
            val dst_y_end = dst_y_i64 + quad.height.to_i64() - 1
            val dst_in_range = (quad.width > 0 and quad.height > 0 and
                dst_x_i64 >= -2147483648 and dst_x_i64 <= 2147483647 and
                dst_x_end >= -2147483648 and dst_x_end <= 2147483647 and
                dst_y_i64 >= -2147483648 and dst_y_i64 <= 2147483647 and
                dst_y_end >= -2147483648 and dst_y_end <= 2147483647)
            if _VEC_TEXT_PROBE and _vec_blit_probe_count < 8:
                _vec_blit_probe_count = _vec_blit_probe_count + 1
                var pnz = 0
                var pi: i64 = 0
                while pi < pixels.len():
                    if ((pixels[pi] >> 24) & 0xFFu32) > 0u32:
                        pnz = pnz + 1
                    pi = pi + 1
                var dxs = "nil"
                var dys = "nil"
                if dst_in_range:
                    dxs = "{dst_x_i64}"
                    dys = "{dst_y_i64}"
                print("[vec-text-probe] blit qi={quad_index} w={quad.width} h={quad.height} pix_len={pixels.len()} expect={quad.width.to_i64() * quad.height.to_i64()} pix_nz={pnz} color_a={(quad.color >> 24) & 0xFFu32} dst_x={dxs} dst_y={dys} x={x} y={y}")
            if pixels.len() == quad.width.to_i64() * quad.height.to_i64() and dst_in_range:
                self.draw_image_blend(dst_x_i64 as i32, dst_y_i64 as i32, quad.width, quad.height, pixels)
            quad_index = quad_index + 1
        quad_index

    me _font_batch_receipt(source: text, content_count: i64):
        """Print only when a staged batch lost its payload (see _font_batch_receipt_count)."""
        if _font_batch_receipt_count >= 8:
            return
        if self.font_owner.active.len() == 0:
            return
        if (self.font_owner.active[0].staged_valid and
                self.font_owner.active[0].staged_quads.len() == 0 and
                content_count > 0):
            _font_batch_receipt_count = _font_batch_receipt_count + 1
            print("[font-batch] degenerate source={source} content={content_count} quads=0 atlas_pixels={self.font_owner.active[0].atlas_pixels.len()} identity={self.font_owner.active[0].staged_font_identity} generation={self.font_owner.active[0].staged_face_generation}")

    # Materialize the staged payload the renderer just wrote and hand it to the
    # blit planner. The FontRenderBatch is built HERE, as a function-local
    # struct literal read field-by-field off a live FontRenderer, and only ever
    # travels onward as an INBOUND parameter — it is never returned across a
    # call. That removes the native aggregate-return quads loss.
    me _draw_font_batch_staged(x: i32, y: i32, plan: [text]) -> bool:
        if self.font_owner.active.len() == 0:
            return false
        var atlas: [u32] = []
        if not self.font_owner.active[0].staged_atlas_empty:
            atlas = self.font_owner.active[0].atlas_pixels
        val batch = FontRenderBatch(
            program_version: self.font_owner.active[0].staged_program_version,
            transform_identity: self.font_owner.active[0].staged_transform_identity,
            font_identity: self.font_owner.active[0].staged_font_identity,
            face_generation: self.font_owner.active[0].staged_face_generation,
            valid: self.font_owner.active[0].staged_valid,
            atlas_width: self.font_owner.active[0].staged_atlas_width,
            atlas_height: self.font_owner.active[0].staged_atlas_height,
            atlas_pixels: atlas, quads: self.font_owner.active[0].staged_quads,
            atlas_generation: self.font_owner.active[0].staged_atlas_generation,
            dirty_rects: self.font_owner.active[0].staged_dirty_rects,
            atlas_owner_generation: self.font_owner.active[0].staged_atlas_owner_generation,
            render_config_identity: self.font_owner.active[0].staged_render_config_identity,
            execution_target: self.font_owner.active[0].staged_execution_target,
            execution_policy: self.font_owner.active[0].staged_execution_policy
        )
        self._draw_font_batch_plan(x, y, batch, plan)

    me _draw_font_batch_plan(x: i32, y: i32, batch: FontRenderBatch, plan: [text]) -> bool:
        # Snapshot once, up front: the same `batch.material_supported()` call
        # expression also appears inside the probe's print() interpolation
        # below (root cause of a duplicate-call CSE hazard; see history).
        # But calling the zero-arg method `batch.material_supported()` on a
        # non-self local here never materializes the receiver into its ABI
        # register (rdi) at all -- disassembly confirmed the call site simply
        # reuses whatever rdi already held (the enclosing self), regardless
        # of call ordering, unlike ordinary explicit-argument method calls
        # (e.g. `cuda.draw_font_batch(x, y, batch)` a few hundred bytes
        # later, which DOES reload every argument, including the receiver,
        # from its spill slot before calling). Inlining the body here avoids
        # the receiver-dispatch call entirely: `batch.valid` /
        # `batch.program_version` / `batch.transform_identity` are plain
        # field loads (no ABI materialization needed) and
        # `font_atlas_composite_program_version_valid` is a free function
        # taking an explicit i64, not a receiver-dispatch call.
        val n_quads_total = batch.quads.len()
        val material_ok = batch.valid and
            batch.transform_identity == "uniform-scale;translate-late"
        val gpu_material_ok = font_atlas_composite_program_version_valid(batch.program_version)
        if _VEC_TEXT_PROBE and _vec_text_probe_count < 8:
            _vec_text_probe_count = _vec_text_probe_count + 1
            val n_quads = n_quads_total
            var nz = 0
            var first_w = 0
            var first_h = 0
            var first_ax = 0
            var first_ay = 0
            var first_color_a: u32 = 0u32
            if n_quads > 0:
                val fq = batch.quads[0]
                first_w = fq.width
                first_h = fq.height
                first_ax = fq.atlas_x
                first_ay = fq.atlas_y
                first_color_a = (fq.color >> 24) & 0xFFu32
                var row = 0
                while row < fq.height:
                    var col = 0
                    while col < fq.width:
                        val idx = (fq.atlas_y + row) * batch.atlas_width + fq.atlas_x + col
                        if idx.to_i64() >= 0 and idx.to_i64() < batch.atlas_pixels.len():
                            val px = batch.atlas_pixels[idx]
                            if ((px >> 24) & 0xFFu32) > 0u32:
                                nz = nz + 1
                        col = col + 1
                    row = row + 1
            print("[vec-text-probe] consumer valid={batch.valid} material_supported={material_ok} n_quads={n_quads} atlas_len={batch.atlas_pixels.len()} first_w={first_w} first_h={first_h} first_ax={first_ax} first_ay={first_ay} first_cov_nz={nz} color_a={first_color_a}")
        if not material_ok or plan.len() == 0:
            return false
        var quad_index: i64 = 0
        var attempts: [text] = []
        var winner = ""
        for target in plan:
            if not gpu_material_ok and target != "cpu":
                attempts.push(target + ":unsupported")
            elif self.vulkan_font_state_unknown and target != "cpu":
                attempts.push(target + ":poisoned-skip")
            elif quad_index > 0 and target != "cpu":
                attempts.push(target + ":skipped-partial")
            elif target == "cuda":
                val active = self.cuda_backend
                if active == nil:
                    attempts.push("cuda:unavailable")
                else:
                    val cuda = active
                    quad_index = cuda.draw_font_batch(x, y, batch)
                    self.cuda_backend = cuda
                    if self.selected_backend_name == "cuda":
                        self.backend = cuda
                    if quad_index < 0 or quad_index > batch.quads.len(): quad_index = 0
                    attempts.push(if quad_index == batch.quads.len(): "cuda:success" else: "cuda:failed")
                    if quad_index == batch.quads.len(): winner = "cuda"
            elif target == "metal":
                val active = self.metal_backend
                if active == nil:
                    attempts.push("metal:unavailable")
                else:
                    val metal = active
                    quad_index = metal.draw_font_batch(x, y, batch)
                    self.metal_backend = Some(metal)
                    if quad_index < 0 or quad_index > batch.quads.len(): quad_index = 0
                    attempts.push(if quad_index == batch.quads.len(): "metal:success" else: "metal:failed")
                    if quad_index == batch.quads.len(): winner = "metal"
            elif target == "opencl":
                val active = self.opencl_backend
                if active == nil:
                    attempts.push("opencl:unavailable")
                else:
                    val opencl = active
                    quad_index = opencl.draw_font_batch(x, y, batch)
                    self.opencl_backend = opencl
                    if quad_index < 0 or quad_index > batch.quads.len(): quad_index = 0
                    attempts.push(if quad_index == batch.quads.len(): "opencl:success" else: "opencl:failed")
                    if quad_index == batch.quads.len(): winner = "opencl"
            elif target == "vulkan":
                # `if val Some(vulkan) = ...` (NOT `val vulkan = <optional>`):
                # a `me` call made through an OPTION-typed binding mutates a
                # temporary unwrap that is discarded, so every state change
                # `composite_font_batch` makes -- above all the entry flush at
                # backend_vulkan_font.spl:269 that consumes the pending compute
                # batch -- was lost, leaving the stored backend re-submitting an
                # already-consumed command buffer and returning rc=-1 for every
                # later flush and primitive dispatch (run-lane truncation,
                # 2026-08-02). Only the destructured binding writes back.
                if val Some(vulkan) = self.vulkan_backend:
                    # var (not val): evidence.fallback_pixels is cleared below;
                    # W1006 mut-capability failure here silently killed
                    # whole-program JIT (2026-07-18).
                    var evidence = vulkan.composite_font_batch(x, y, batch)
                    self.last_vulkan_font_evidence = evidence
                    self.vulkan_backend = Some(vulkan)
                    attempts.push("vulkan:" + evidence.reason)
                    if (evidence.reason == "partial-framebuffer-restore-failed" or
                        evidence.reason == "missing-command-cleanup-capability" or
                        evidence.reason == "descriptor-cleanup-failed" or
                        evidence.reason == "params-cleanup-failed" or
                        evidence.reason == "font-batch-record-failed" or
                        evidence.reason == "font-atlas-transition-completion-unknown" or
                        evidence.reason == "atlas-cleanup-failed" or
                        evidence.reason == "fence-completion-unknown" or
                        evidence.reason == "device-lost" or
                        evidence.reason == "fence-cleanup-failed" or
                        evidence.reason == "fence-wait-evidence-failed" or
                        evidence.reason == "cleanup-failed"):
                        self.last_font_execution_attempts = attempts
                        self.last_font_execution_target = ""
                        self._poison_vulkan_font_surface(evidence.fallback_pixels)
                        evidence.fallback_pixels = []
                        self.last_vulkan_font_evidence = evidence
                        quad_index = 0
                        continue
                    if ((evidence.device_executed or evidence.status == "recorded") and
                        evidence.dispatch_count == batch.quads.len()):
                        quad_index = batch.quads.len()
                        winner = "vulkan"
                else:
                    attempts.push("vulkan:unavailable")
            elif target == "rocm":
                val active = self.rocm_backend
                if active == nil:
                    attempts.push("rocm:unavailable")
                else:
                    val rocm = active
                    quad_index = rocm.draw_font_batch(x, y, batch)
                    self.rocm_backend = rocm
                    if rocm.initialized:
                        self.backend = rocm
                    if quad_index < 0 or quad_index > batch.quads.len(): quad_index = 0
                    attempts.push(if quad_index == batch.quads.len(): "rocm:success" else: "rocm:failed")
                    if quad_index == batch.quads.len(): winner = "rocm"
            elif target == "cpu":
                val cpu_simd_requested = self.selected_backend_name == "cpu_simd" and active_arch_text() == "x86_64"
                val native_hits_before = engine2d_simd_native_hits()
                quad_index = self._draw_font_batch_cpu_suffix(x, y, batch, quad_index)
                val cpu_simd = cpu_simd_requested and engine2d_simd_native_hits() > native_hits_before
                if cpu_simd:
                    attempts.push("cpu_simd:success")
                    winner = "cpu_simd"
                else:
                    attempts.push(if cpu_simd_requested: "cpu_simd:no-native-alpha-hit" else: "cpu:success")
                    winner = "cpu"
            if winner != "":
                break
        self.last_font_execution_attempts = attempts
        self.last_font_execution_target = winner
        winner != ""

    me draw_glyph_run(x: i32, y: i32, run: FontGlyphRun, color: u32, font_size: i32) -> bool:
        self.ensure_font_renderer()
        self.font_owner.active[0].stage_glyph_run(run, color, font_size)
        self._font_batch_receipt("glyph-run", run.glyph_ids.len())
        self._draw_font_batch_staged(
            x, y, ["cuda", "metal", "opencl", "vulkan", "rocm", "cpu"])

    me draw_text(x: i32, y: i32, text_val: text, color: u32, font_size: i32):
        """Draw a selected vector face fail-closed, or use the bitmap default."""
        var has_ttf = false
        val owner: Engine2DFontOwner = self.font_owner
        val renderer_present = owner.active.len() > 0
        if renderer_present:
            # Read the owner slot directly — rerun10 proved even the PLAIN
            # aggregate return of the former owner helper arrives
            # null in the freestanding build (has_sffi_ttf cr2=0x0 with a
            # typed intermediate already bound). Field + array-element
            # access are the proven channels; no function return crosses.
            val present_fonts: FontRenderer = owner.active[0]
            has_ttf = present_fonts.has_sffi_ttf()
        if _VEC_TEXT_PROBE and _vec_entry_probe_count < 8:
            _vec_entry_probe_count = _vec_entry_probe_count + 1
            print("[vec-text-probe] draw_text-entry text_len={text_val.len()} font_renderer_nil={not renderer_present} has_sffi_ttf={has_ttf} vulkan_font_state_unknown={self.vulkan_font_state_unknown} selected_backend={self.selected_backend_name}")
        if has_ttf:
            if _VEC_TEXT_PROBE and _vec_entry_probe_count < 24:
                _vec_entry_probe_count = _vec_entry_probe_count + 1
                print("[vec-text-probe] about-to-call-draw_text_configured")
            val configured_ok = self.draw_text_configured(
                x, y, text_val, color, engine2d_default_font_config_for(font_size, self.baremetal_backend != nil)
            )
            if _VEC_TEXT_PROBE and _vec_entry_probe_count < 24:
                _vec_entry_probe_count = _vec_entry_probe_count + 1
                print("[vec-text-probe] returned-from-draw_text_configured ok={configured_ok}")
            return
        # NOTE(2026-08-02): a poisoned lane used to `return` here, silently
        # DROPPING the bitmap text draw. It only existed because the router
        # chain below would otherwise dispatch into the dead Vulkan backend;
        # `_vulkan_primitive_target()` now excludes that arm, so the chain
        # falls through to `self.backend` -- the CPU fallback surface the
        # poison installed -- and the text is painted instead of dropped.
        if val Some(vg) = self.virtio_gpu_backend:
            vg.draw_text(x, y, text_val, color, font_size)
        elif val Some(bm) = self.baremetal_backend:
            bm.draw_text(x, y, text_val, color, font_size)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.draw_text(x, y, text_val, color, font_size)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_text(x, y, text_val, color, font_size)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            self.backend.draw_text(x, y, text_val, color, font_size)

    me draw_text_configured(x: i32, y: i32, text_val: text, color: u32, config: FontRenderConfig) -> bool:
        self.last_font_plan_admitted = false
        if _VEC_TEXT_PROBE and _vec_entry_probe_count < 24:
            _vec_entry_probe_count = _vec_entry_probe_count + 1
            print("[vec-text-probe] draw_text_configured-FIRST-LINE")
        # Use the caller-owned plan channel proven by the advances path below.
        # The returned [text] from font_execution_plan can arrive empty on the
        # native aggregate-return lane before staging begins.
        var plan: [text] = []
        val plan_count = font_execution_plan_into(
            config, ["cuda", "metal", "opencl", "vulkan", "rocm", "cpu"], plan)
        if _VEC_TEXT_PROBE and _vec_entry_probe_count < 24:
            _vec_entry_probe_count = _vec_entry_probe_count + 1
            val policy_is_suggested = config.execution_policy == FontExecutionPolicy.Suggested
            val policy_is_preferred = config.execution_policy == FontExecutionPolicy.Preferred
            val policy_is_required = config.execution_policy == FontExecutionPolicy.Required
            print("[vec-text-probe] draw_text_configured-entry plan_len={plan_count} selection_supported={font_render_config_selection_supported(config)} family={config.family} category={config.category} exec_target={config.execution_target} size={config.size} weight={config.weight} style={config.style} hinting={config.hinting} antialiasing={config.antialiasing} atlas_policy={config.atlas_policy} language={config.language} script={config.script} policy_suggested={policy_is_suggested} policy_preferred={policy_is_preferred} policy_required={policy_is_required}")
        if plan_count <= 0:
            return false
        if plan.len() == 0:
            return false
        if not font_render_config_selection_supported(config):
            return false
        self.last_font_plan_admitted = true
        self.ensure_font_renderer()
        var fonts: FontRenderer = self.font_owner.active[0]
        fonts.stage_text_configured(text_val, color, config)
        self.font_owner.active[0] = fonts
        self._font_batch_receipt("text", text_val.len())
        self._draw_font_batch_staged(x, y, plan)

    me draw_text_points_dpi(x: i32, y: i32, text_val: text, color: u32, points: i32, dpi: i32) -> bool:
        self.last_font_size_is_100 = false
        if points <= 0:
            return false
        if dpi <= 0:
            return false
        val font_size: i32 = (points * dpi + 36) / 72
        if font_size <= 0:
            return false
        if font_size > 512:
            return false
        self.last_font_size_is_100 = font_size == 100
        val config = FontRenderConfig(
            family: "auto", category: "auto", language: "und", script: "auto",
            size: font_size, weight: "normal", style: "normal", hinting: "none",
            antialiasing: "grayscale", atlas_policy: "shared-alpha-1024",
            execution_target: "auto",
            execution_policy: FontExecutionPolicy.Suggested
        )
        self.draw_text_configured(x, y, text_val, color, config)

    me draw_text_with_advances(x: i32, y: i32, text_val: text, advance_widths: [i32], color: u32, font_size: i32) -> bool:
        """Draw producer-resolved text through the selected vector face."""
        self.draw_text_with_advances_configured(
            x, y, text_val, advance_widths, color, engine2d_default_font_config_for(font_size, self.baremetal_backend != nil)
        )

    me draw_text_with_advances_vulkan_only(x: i32, y: i32, text_val: text, advance_widths: [i32], color: u32, font_size: i32) -> bool:
        """Draw resolved text through the canonical Vulkan font batch only.

        This is the strict DrawIR device primitive boundary: unlike the normal
        routing policy it never tries CUDA, Metal, or CPU after Vulkan.
        """
        if self.selected_backend_name != "vulkan" or self.vulkan_font_state_unknown:
            return false
        val config = engine2d_default_font_config_for(font_size, false)
        if not font_render_config_selection_supported(config):
            return false
        self.ensure_font_renderer()
        var fonts: FontRenderer = self.font_owner.active[0]
        fonts.stage_text_with_advances_configured(text_val, advance_widths, color, config)
        self.font_owner.active[0] = fonts
        self._font_batch_receipt("text-advances-vulkan-only", text_val.len())
        self._draw_font_batch_staged(x, y, ["vulkan"])

    me draw_text_with_advances_configured(x: i32, y: i32, text_val: text, advance_widths: [i32], color: u32, config: FontRenderConfig) -> bool:
        # Mut-param plan (font_execution_plan_into): the [text] array RETURN of
        # font_execution_plan arrived empty at THIS call site on the
        # freestanding lane while the identical shaped-path call survived
        # (rerun31 [e2d-batch] plan-empty for text='X' size=12). The variant
        # fills a caller-local list and returns a scalar count, both proven
        # channels, and its per-gate receipts attribute any honest rejection.
        var plan: [text] = []
        val plan_count = font_execution_plan_into(config, ["cuda", "metal", "opencl", "vulkan", "rocm", "cpu"], plan)
        # Explicit branches (no mixed boolean or) + per-exit receipts: rerun30
        # proved the caller sees false while the batch-path receipt below stays
        # silent — the failure is in one of these two early exits.
        if plan_count == 0:
            print("[e2d-batch] plan-empty text_len={text_val.len()}")
            return false
        if not font_render_config_selection_supported(config):
            print("[e2d-batch] selection-unsupported text_len={text_val.len()} advances={advance_widths.len()}")
            return false
        self.ensure_font_renderer()
        var fonts: FontRenderer = self.font_owner.active[0]
        fonts.stage_text_with_advances_configured(text_val, advance_widths, color, config)
        self.font_owner.active[0] = fonts
        self._font_batch_receipt("text-advances", text_val.len())
        val advances_drawn = self._draw_font_batch_staged(x, y, plan)
        if not advances_drawn:
            print("[e2d-batch] advances-draw-failed text='{text_val}' advances={advance_widths.len()} batch_valid={self.font_owner.active[0].staged_valid} quads={self.font_owner.active[0].staged_quads.len()}")
        advances_drawn

    me draw_shaped_text(x: i32, y: i32, glyph_run: DrawIrGlyphRunPayload, color: u32, font_size: i32) -> bool:
        """Draw a semantic shaped run through the canonical selected face."""
        self.draw_shaped_text_configured(
            x, y, glyph_run, color, engine2d_default_font_config_for(font_size, self.baremetal_backend != nil)
        )

    me draw_shaped_text_vulkan_only(x: i32, y: i32, glyph_run: DrawIrGlyphRunPayload, color: u32, font_size: i32) -> bool:
        """Draw a shaped run through the canonical Vulkan font batch only."""
        if self.selected_backend_name != "vulkan" or self.vulkan_font_state_unknown:
            return false
        val config = engine2d_default_font_config_for(font_size, false)
        if not font_render_config_selection_supported(config):
            return false
        self.ensure_font_renderer()
        var fonts: FontRenderer = self.font_owner.active[0]
        fonts.stage_selected_glyph_run_configured(glyph_run, color, config)
        self.font_owner.active[0] = fonts
        self._font_batch_receipt("shaped-vulkan-only", glyph_run.glyph_ids.len())
        self._draw_font_batch_staged(x, y, ["vulkan"])

    me draw_shaped_text_configured(x: i32, y: i32, glyph_run: DrawIrGlyphRunPayload, color: u32, config: FontRenderConfig) -> bool:
        val plan = font_execution_plan(config, ["cuda", "metal", "opencl", "vulkan", "rocm", "cpu"])
        if plan.len() == 0 or not font_render_config_selection_supported(config):
            return false
        self.ensure_font_renderer()
        var fonts: FontRenderer = self.font_owner.active[0]
        fonts.stage_selected_glyph_run_configured(glyph_run, color, config)
        self.font_owner.active[0] = fonts
        self._font_batch_receipt("shaped", glyph_run.glyph_ids.len())
        self._draw_font_batch_staged(x, y, plan)

    me load_font(path: text) -> bool:
        """Select one trusted TTF/OTF for process-wide Simple 2D text."""
        val active_cuda = self.cuda_backend
        if active_cuda != nil:
            val cuda = active_cuda
            cuda.invalidate_font_atlas()
            self.cuda_backend = cuda
        val active_opencl = self.opencl_backend
        if active_opencl != nil:
            val opencl = active_opencl
            opencl.invalidate_font_atlas()
            self.opencl_backend = opencl
        val active_metal = self.metal_backend
        if active_metal != nil:
            val metal = active_metal
            metal.invalidate_font_atlas()
            self.metal_backend = Some(metal)
        val active_rocm = self.rocm_backend
        if active_rocm != nil:
            val rocm = active_rocm
            rocm.invalidate_font_atlas()
            self.rocm_backend = rocm
            if rocm.initialized:
                self.backend = rocm
        self.ensure_font_renderer()
        val fonts: FontRenderer = self.font_owner.active[0]
        val loaded = fonts.try_load_runtime_ttf(path)
        self.font_owner.active[0] = fonts
        loaded

    me load_font_bytes(path: text, blob: [u8]) -> bool:
        self.ensure_font_renderer()
        val fonts: FontRenderer = self.font_owner.active[0]
        val loaded = fonts.try_load_selected_bytes(path, blob)
        self.font_owner.active[0] = fonts
        loaded

    me select_font_identity(identity: text) -> bool:
        """Select the exact bundled face named by a stable Draw IR identity."""
        if identity == "":
            return false
        if self.font_owner.active.len() > 0:
            val owner_fonts: FontRenderer = self.font_owner.active[0]
            val current_identity = owner_fonts.current_font_identity()
            self.font_owner.active[0] = owner_fonts
            if current_identity == identity:
                return true
        val selected_path = selected_font_asset_local_path_for_identity(identity)
        if selected_path == "":
            return false
        self.ensure_font_renderer()
        val fonts: FontRenderer = self.font_owner.active[0]
        val registered = fonts.try_load_registered_identity(identity)
        self.font_owner.active[0] = fonts
        if (not registered and
            (font_renderer_registered_selected_bytes_only() or not self.load_font(selected_path))):
            return false
        val loaded_fonts: FontRenderer = self.font_owner.active[0]
        val loaded_identity = loaded_fonts.current_font_identity()
        self.font_owner.active[0] = loaded_fonts
        if loaded_identity == identity:
            return true
        self.unload_font()
        false

    me unload_font():
        """Restore the zero-config bitmap text path."""
        val active_cuda = self.cuda_backend
        if active_cuda != nil:
            val cuda = active_cuda
            cuda.invalidate_font_atlas()
            self.cuda_backend = cuda
        val active_opencl = self.opencl_backend
        if active_opencl != nil:
            val opencl = active_opencl
            opencl.invalidate_font_atlas()
            self.opencl_backend = opencl
        val active_metal = self.metal_backend
        if active_metal != nil:
            val metal = active_metal
            metal.invalidate_font_atlas()
            self.metal_backend = Some(metal)
        val active_rocm = self.rocm_backend
        if active_rocm != nil:
            val rocm = active_rocm
            rocm.invalidate_font_atlas()
            self.rocm_backend = rocm
            if rocm.initialized:
                self.backend = rocm
        val owner: Engine2DFontOwner = self.font_owner
        self.font_owner = engine2d_font_owner_clear(owner)

    me font_cache_stats() -> FontCacheStats:
        self.ensure_font_renderer()
        val fonts: FontRenderer = self.font_owner.active[0]
        val stats = fonts.cache_stats()
        self.font_owner.active[0] = fonts
        stats

    me font_receipt_reset_cache_stats() -> bool:
        if self.font_owner.active.len() == 0:
            return false
        var fonts: FontRenderer = self.font_owner.active[0]
        val reset_ok = fonts.reset_cache_stats_receipt()
        self.font_owner.active[0] = fonts
        reset_ok

