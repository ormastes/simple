    fn vulkan_font_performance_evidence() -> VulkanFontCompositeEvidence?:
        self.last_vulkan_font_evidence

    fn draw_ir_font_evidence() -> DrawIrTargetFontEvidence?:
        val vulkan = self.last_vulkan_font_evidence
        if vulkan == nil:
            return nil
        val evidence = vulkan
        Some(DrawIrTargetFontEvidence(
            batch_identity: evidence.batch_identity,
            readback_source: evidence.readback_source,
            device_checksum: evidence.device_checksum,
            oracle_checksum: evidence.oracle_checksum,
            readback_nonblank_pixels: evidence.readback_nonblank_pixels,
            parity: evidence.parity,
            device_executed: evidence.device_executed,
            promotion_ready: evidence.promotion_ready,
            atlas_upload_count: evidence.atlas_upload_count,
            atlas_upload_bytes: evidence.atlas_upload_bytes,
            atlas_payload_sha256: evidence.atlas_payload_sha256
        ))

    me draw_text_bg(x: i32, y: i32, text_val: text, fg: u32, bg: u32, font_size: i32):
        """Draw text with an explicit background colour per glyph cell.

        A selected vector face uses its measured advance/line height and the
        same antialiased `draw_text` path. Bitmap mode keeps the existing
        backend cell painter. This is the method `Engine2dCompositorBackend`
        and other GUI wrappers should call.
        """
        if self.font_owner.active.len() > 0:
            val fonts: FontRenderer = self.font_owner.active[0]
            if fonts.has_sffi_ttf() and font_size > 0 and font_size <= 512:
                    val text_width = fonts.measure_text_width(text_val, font_size)
                    var line_height = fonts.horizontal_line_metric(font_size, 3)
                    self.font_owner.active[0] = fonts
                    if line_height <= 0:
                        line_height = font_size
                    if text_width > 0:
                        self.draw_rect_filled(x, y, text_width, line_height, bg)
                    self.draw_text(x, y, text_val, fg, font_size)
                    return
        if val Some(vg) = self.virtio_gpu_backend:
            emu_draw_text_bg(self.backend, x, y, text_val, fg, bg, font_size)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_text_bg(self.backend, x, y, text_val, fg, bg, font_size)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.draw_text_bg(x, y, text_val, fg, bg, font_size)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            # Keep the canonical software-AA payload byte-for-byte; only the
            # final copy is routed through the canonical typed Vulkan state.
            val text_buf = text_aa_blit_buffer(text_val, fg, bg, font_size)
            if text_buf.is_empty():
                return
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_image(
                x, y, text_buf.width, text_buf.height, text_buf.pixels)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            emu_draw_text_bg(self.backend, x, y, text_val, fg, bg, font_size)

    me draw_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        """Blit a pixel array onto the framebuffer."""
        if val Some(vg) = self.virtio_gpu_backend:
            vg.draw_image(x, y, w, h, pixels)
        elif val Some(bm) = self.baremetal_backend:
            bm.draw_image(x, y, w, h, pixels)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.draw_image(x, y, w, h, pixels)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            vulkan.draw_image(x, y, w, h, pixels)
            self.vulkan_backend = Some(vulkan)
            self.backend = vulkan
        else:
            self.backend.draw_image(x, y, w, h, pixels)

