    me draw_image_blend(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        # Typed receivers on the if-val bindings: bare calls on the erased
        # bindings trip the AOT ambiguous-method guard (28 candidates) and
        # blocked `bin/simple compile` of the web showcase (2026-07-18); same
        # class as draw_image_scaled above.
        if val Some(vg) = self.virtio_gpu_backend:
            var vg_typed: VirtioGpuBackend = vg
            vg_typed.draw_image_blend(x, y, w, h, pixels)
        elif val Some(bm) = self.baremetal_backend:
            var bm_typed: BaremetalBackend = bm
            bm_typed.draw_image_blend(x, y, w, h, pixels)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.draw_image_blend(x, y, w, h, pixels)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_image_blend(x, y, w, h, pixels)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            # emu_* free-function route like draw_image_scaled: the AOT lane
            # also flags the `self.backend.<method>` trait-object call as a
            # bare 28-candidate ambiguity (2026-07-18).
            emu_draw_image_blend(self.backend, x, y, w, h, pixels)

    me draw_engine(dst_x: i32, dst_y: i32, src: Engine2D):
        """Composite an embedded render target (typically an offscreen Engine2D
        from create_offscreen()) into self at (dst_x, dst_y).

        Reads back src's framebuffer and alpha-blends it over self via
        draw_image_blend — the core "rendering-inside-rendering" primitive:
        a nested engine's finished frame becomes one blit into the parent.
        """
        self.draw_image_blend(dst_x, dst_y, src.width(), src.height(), src.read_pixels())

    me draw_engine_opacity(dst_x: i32, dst_y: i32, src: Engine2D, opacity_milli: i32):
        """Like draw_engine, but scales src's pixel alpha by opacity_milli/1000
        (1000 = fully opaque) before compositing.

        draw_image_blend has no opacity parameter of its own, so a
        sub-opacity embed premultiplies the scale into each source pixel's
        alpha channel first, then blends normally.
        """
        if opacity_milli >= 1000:
            self.draw_engine(dst_x, dst_y, src)
            return
        if opacity_milli <= 0:
            return
        val scaled = engine2d_scale_pixel_alpha(src.read_pixels(), opacity_milli)
        self.draw_image_blend(dst_x, dst_y, src.width(), src.height(), scaled)

    me draw_software_offscreen_opacity_consume(dst_x: i32, dst_y: i32, src: Engine2D, opacity_milli: i32) -> bool:
        """Composite a SOFTWARE offscreen into self at opacity_milli/1000,
        CONSUMING src: scale src's own buffer alpha in place and blend it
        directly, with NO read_pixels() snapshot and NO
        engine2d_scale_pixel_alpha() copy.

        Returns true when the fast in-place path applied (src is software
        backed), false otherwise so the caller falls back to
        draw_engine_opacity(). Only call when src's pixels will not be reused
        unscaled (e.g. a scratch embedded offscreen cleared before its next
        use). This keeps translucent-window compositing on the non-reclaiming
        SimpleOS baremetal bump heap from leaking two full-surface scratch
        arrays per window.
        """
        if opacity_milli <= 0:
            return true
        val src_software: SoftwareBackend? = src.software_backend
        if val Some(sw) = src_software:
            if opacity_milli < 1000:
                sw.scale_alpha_in_place(opacity_milli)
            self.draw_image_blend(dst_x, dst_y, sw.w, sw.h, sw.buf)
            return true
        false

    me draw_vulkan_image_blend_checked(dst_x: i32, dst_y: i32, width: i32, height: i32, pixels: [u32], opacity_milli: i32) -> bool:
        """Blend child pixels only through the active checked Vulkan path."""
        # Destructured binding, not `val vulkan = <optional>` -- see the
        # write-back note on the vulkan font route.
        if val Some(vulkan) = self.vulkan_backend:
            val completed = vulkan.draw_image_blend_checked(dst_x, dst_y, width, height, pixels, opacity_milli)
            self.vulkan_backend = Some(vulkan)
            return completed
        false

    me draw_metal_image_blend_checked(dst_x: i32, dst_y: i32, width: i32, height: i32, pixels: [u32], opacity_milli: i32) -> bool:
        """Blend child pixels only through the active checked Metal path."""
        val active = self.metal_backend
        if active == nil:
            return false
        val metal = active
        val completed = metal.draw_image_blend_checked(dst_x, dst_y, width, height, pixels, opacity_milli)
        self.metal_backend = Some(metal)
        completed

    # Concrete-typed offscreen creator. Every branch already produces an
    # Engine2D (create_shared_vulkan_offscreen / create_shared_metal_offscreen /
    # create_offscreen all return Engine2D), so the trait-typed wrapper below is
    # a pure widening.
    #
    # Draw IR's advanced executor calls THIS one, never the widened wrapper: a
    # DrawIrRenderTarget-typed surface makes every later .read_pixels_with_source()
    # / .shutdown() / .draw_image() on it lower to duck dispatch, and native
    # codegen turns duck dispatch into a ud2 trap because `class Engine2D with
    # DrawIrRenderTarget` (the mixin form) registers no vtable. See
    # doc/08_tracking/bug/native_with_trait_impl_no_vtable_duck_trap_2026-07-28.md
    me draw_ir_create_offscreen_engine(width: i32, height: i32) -> Result<Engine2D, text>:
        if self.backend_name() == "vulkan":
            val created = self.create_shared_vulkan_offscreen(width, height)
            match created:
                Err(reason): Err(reason)
                Ok(target): Ok(target)
        elif self.backend_name() == "metal":
            val created = self.create_shared_metal_offscreen(width, height)
            match created:
                Err(reason): Err(reason)
                Ok(target): Ok(target)
        else:
            Ok(Engine2D.create_offscreen(width, height))

    me draw_ir_create_offscreen(width: i32, height: i32) -> Result<DrawIrRenderTarget, text>:
        val created = self.draw_ir_create_offscreen_engine(width, height)
        match created:
            Err(reason): Err(reason)
            Ok(target): Ok(target)

    me draw_ir_composite_readback(dst_x: i32, dst_y: i32, width: i32, height: i32, readback: Engine2DReadback, opacity_milli: i32) -> bool:
        if width <= 0 or height <= 0 or opacity_milli <= 0 or opacity_milli > 1000:
            return false
        if readback.pixels.len() != width.to_i64() * height.to_i64():
            return false
        if self.backend_name() == "vulkan":
            if readback.source != "device_readback" or readback.backend_handle <= 0:
                return false
            return self.draw_vulkan_image_blend_checked(
                dst_x, dst_y, width, height, readback.pixels, opacity_milli)
        if self.backend_name() == "metal":
            if readback.source != "device_readback" or readback.backend_handle <= 0:
                return false
            return self.draw_metal_image_blend_checked(
                dst_x, dst_y, width, height, readback.pixels, opacity_milli)
        var pixels = readback.pixels
        if opacity_milli < 1000:
            pixels = engine2d_scale_pixel_alpha(pixels, opacity_milli)
        self.draw_image_blend(dst_x, dst_y, width, height, pixels)
        true

    me draw_image_scaled(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        if dst_w == src_w and dst_h == src_h:
            self.draw_image(dst_x, dst_y, dst_w, dst_h, pixels)
            return
        if self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_image_scaled(cuda, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            # Typed receiver: the if-val binding is type-erased and the AOT
            # codegen's ambiguous-method guard refuses a bare
            # draw_image_scaled with 26 candidates (blocked `bin/simple
            # compile` of every Engine2D user, 2026-07-18).
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_image_scaled(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        elif val Some(vg) = self.virtio_gpu_backend:
            emu_draw_image_scaled(self.backend, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_image_scaled(self.backend, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
        else:
            emu_draw_image_scaled(self.backend, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)

    me draw_image_scaled_blend(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        if dst_w == src_w and dst_h == src_h:
            self.draw_image_blend(dst_x, dst_y, dst_w, dst_h, pixels)
            return
        if self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_image_scaled_blend(cuda, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_image_scaled_blend(
                dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            emu_draw_image_scaled_blend(self.backend, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)

    me draw_triangle_outline(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32, thickness: i32):
        if val Some(vg) = self.virtio_gpu_backend:
            emu_draw_triangle_outline(self.backend, x1, y1, x2, y2, x3, y3, color, thickness)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_triangle_outline(self.backend, x1, y1, x2, y2, x3, y3, color, thickness)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_triangle_outline(cuda, x1, y1, x2, y2, x3, y3, color, thickness)
            self.cuda_backend = cuda
            self.backend = cuda
        else:
            emu_draw_triangle_outline(self.backend, x1, y1, x2, y2, x3, y3, color, thickness)

    me draw_blur_rect(x: i32, y: i32, w: i32, h: i32, radius: i32):
        if val Some(vg) = self.virtio_gpu_backend:
            emu_draw_blur_rect(self.backend, x, y, w, h, radius)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_blur_rect(self.backend, x, y, w, h, radius)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_blur_rect(cuda, x, y, w, h, radius)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_blur_rect(x, y, w, h, radius)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            emu_draw_blur_rect(self.backend, x, y, w, h, radius)

    me draw_shadow_rect(x: i32, y: i32, w: i32, h: i32, offset_x: i32, offset_y: i32, blur_r: i32, color: u32):
        if val Some(vg) = self.virtio_gpu_backend:
            emu_draw_shadow_rect(self.backend, x, y, w, h, offset_x, offset_y, blur_r, color)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_shadow_rect(self.backend, x, y, w, h, offset_x, offset_y, blur_r, color)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_shadow_rect(cuda, x, y, w, h, offset_x, offset_y, blur_r, color)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_shadow_rect(
                x, y, w, h, offset_x, offset_y, blur_r, color)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            emu_draw_shadow_rect(self.backend, x, y, w, h, offset_x, offset_y, blur_r, color)

    me draw_image_transform(dst_x: i32, dst_y: i32, src_w: i32, src_h: i32, a: i32, b: i32, c: i32, d: i32, tx: i32, ty: i32, pixels: [u32]):
        if val Some(vg) = self.virtio_gpu_backend:
            emu_draw_image_transform(self.backend, dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_image_transform(self.backend, dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_image_transform(cuda, dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_image_transform(
                dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            emu_draw_image_transform(self.backend, dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)

    me draw_rect_blend_mode(x: i32, y: i32, w: i32, h: i32, color: u32, mode: i32):
        if val Some(vg) = self.virtio_gpu_backend:
            emu_draw_rect_blend_mode(self.backend, x, y, w, h, color, mode)
        elif val Some(bm) = self.baremetal_backend:
            emu_draw_rect_blend_mode(self.backend, x, y, w, h, color, mode)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            emu_draw_rect_blend_mode(cuda, x, y, w, h, color, mode)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.draw_rect_blend_mode(x, y, w, h, color, mode)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            emu_draw_rect_blend_mode(self.backend, x, y, w, h, color, mode)

    me set_mask(mask_pixels: [u8], w: i32, h: i32):
        if val Some(vg) = self.virtio_gpu_backend:
            vg.set_mask(mask_pixels, w, h)
        elif val Some(bm) = self.baremetal_backend:
            bm.set_mask(mask_pixels, w, h)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.set_mask(mask_pixels, w, h)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.set_mask(mask_pixels, w, h)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            self.backend.set_mask(mask_pixels, w, h)

    me clear_mask():
        if val Some(vg) = self.virtio_gpu_backend:
            vg.clear_mask()
        elif val Some(bm) = self.baremetal_backend:
            bm.clear_mask()
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.clear_mask()
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.clear_mask()
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            self.backend.clear_mask()

    me set_clip(x: i32, y: i32, w: i32, h: i32):
        """Set the clipping rectangle. Drawing outside this rect is discarded."""
        if val Some(vg) = self.virtio_gpu_backend:
            vg.set_clip(x, y, w, h)
        elif val Some(bm) = self.baremetal_backend:
            bm.set_clip(x, y, w, h)
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.set_clip(x, y, w, h)
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.set_clip(x, y, w, h)
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            self.backend.set_clip(x, y, w, h)

    me clear_clip():
        """Remove the clipping rectangle."""
        if val Some(vg) = self.virtio_gpu_backend:
            vg.clear_clip()
        elif val Some(bm) = self.baremetal_backend:
            bm.clear_clip()
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.clear_clip()
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            var vulkan_typed: VulkanBackend = vulkan
            vulkan_typed.clear_clip()
            self.vulkan_backend = Some(vulkan_typed)
            self.backend = vulkan_typed
        else:
            self.backend.clear_clip()

    me present():
        """Flush the framebuffer to the screen / finalize the frame."""
        if val Some(vg) = self.virtio_gpu_backend:
            vg.present()
        elif val Some(bm) = self.baremetal_backend:
            bm.present()
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            cuda.present()
            self.cuda_backend = cuda
            self.backend = cuda
        elif val Some(vulkan) = self._vulkan_primitive_target():
            vulkan.present()
            self.vulkan_backend = Some(vulkan)
            self.backend = vulkan
        else:
            self.backend.present()

    me submit_batch() -> bool:
        """Flush any backend-buffered draw calls for this frame into one
        fenced submission. No-op (returns true) on backends that dispatch
        immediately per primitive."""
        if val Some(vg) = self.virtio_gpu_backend:
            return vg.submit_batch()
        elif val Some(bm) = self.baremetal_backend:
            return bm.submit_batch()
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            val ok = cuda.submit_batch()
            self.cuda_backend = cuda
            self.backend = cuda
            return ok
        elif val Some(vulkan) = self._vulkan_primitive_target():
            val ok = vulkan.submit_batch()
            self.vulkan_backend = Some(vulkan)
            self.backend = vulkan
            return ok
        else:
            return self.backend.submit_batch()

    me submit_batch_for_present() -> bool:
        """Flush Vulkan with an exclusive one-shot presenter-read receipt."""
        if val Some(vulkan) = self._vulkan_primitive_target():
            val ok = vulkan.submit_batch_for_present()
            self.vulkan_backend = Some(vulkan)
            self.backend = vulkan
            return ok
        false

    me read_pixels() -> [u32]:
        # Checksum-free readback: delegate straight to the backend's read_pixels
        # (which, for the Metal GPU-only/native path, is a single-FFI download
        # returning the [u32] framebuffer). read_pixels_with_source() still
        # computes the O(n) Simple checksum for evidence rows; callers that only
        # need pixels avoid that cost here.
        if val Some(vg) = self.virtio_gpu_backend:
            return vg.read_pixels()
        elif val Some(bm) = self.baremetal_backend:
            return bm.read_pixels()
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            val pixels = cuda.read_pixels()
            self.cuda_backend = cuda
            self.backend = cuda
            return pixels
        elif val Some(vulkan) = self._vulkan_primitive_target():
            val pending_status = vulkan._flush_pending_compute()
            if pending_status < 0:
                vulkan.mark_completion_unknown()
            elif pending_status != 1:
                vulkan.mark_cpu_fallback("primitive-batch-read-flush-ineligible")
            val pixels = vulkan.read_pixels()
            self.vulkan_backend = Some(vulkan)
            self.backend = vulkan
            return pixels
        else:
            return self.backend.read_pixels()

    me read_pixels_with_source() -> Engine2DReadback:
        """Read the framebuffer contents as a flat u32 array."""
        if self.vulkan_font_state_unknown:
            # The lane was demoted to the CPU fallback surface by
            # `_poison_vulkan_font_surface`; the device framebuffer holds only
            # whatever landed before the poison. Report the surface that was
            # actually painted, with honest provenance -- never
            # `device_readback` (run-lane truncation, 2026-08-02).
            return engine2d_readback(self.backend.read_pixels(), "cpu_fallback")
        if val Some(vg) = self.virtio_gpu_backend:
            vg.read_pixels_with_source()
        elif val Some(bm) = self.baremetal_backend:
            bm.read_pixels_with_source()
        elif self.selected_backend_name == "cuda":
            val cuda = self.cuda_backend.?
            val readback = cuda.read_pixels_with_source()
            self.cuda_backend = cuda
            self.backend = cuda
            readback
        elif val Some(vulkan) = self._vulkan_primitive_target():
            val pending_status = vulkan._flush_pending_compute()
            if pending_status < 0:
                vulkan.mark_completion_unknown()
            elif pending_status != 1:
                vulkan.mark_cpu_fallback("primitive-batch-read-flush-ineligible")
            # Honesty backstop. EVERY return path of `_flush_pending_compute`
            # clears the pending batch, so pending state that SURVIVES the
            # flush proves the value the flush mutated is not the value about
            # to be read back -- the frame cannot be device-attested. Fail
            # closed instead of publishing a truncated `device_readback`
            # (run-lane truncation, 2026-08-02).
            if vulkan.pending_compute_command != 0 or vulkan.pending_compute_count != 0:
                vulkan.mark_cpu_fallback("pending-compute-state-contradicts-flush")
            val readback = vulkan.read_pixels_with_source()
            self.vulkan_backend = Some(vulkan)
            self.backend = vulkan
            readback
        else:
            self.backend.read_pixels_with_source()

    # ========================================================================
    # Lifecycle
    # ========================================================================

    me shutdown():
        """Shut down the backend and release all resources."""
        self.unload_font()
        if self.selected_backend_name == "vulkan-poisoned-software":
            if val Some(vulkan) = self.vulkan_backend:
                vulkan.shutdown()
                if vulkan.completion_unknown:
                    self.vulkan_backend = Some(vulkan)
                else:
                    self.vulkan_backend = nil
            if val Some(software) = self.software_backend:
                software.shutdown()
            return
        if self.selected_backend_name == "vulkan":
            if val Some(vulkan) = self.vulkan_backend:
                vulkan.shutdown()
                if vulkan.completion_unknown:
                    self.vulkan_backend = Some(vulkan)
                else:
                    self.vulkan_backend = nil
                return
        if self.selected_backend_name == "cuda":
            if val Some(cuda) = self.cuda_backend:
                cuda.shutdown()
                return
        if self.selected_backend_name == "metal":
            if val Some(metal) = self.metal_backend:
                metal.shutdown()
                return
        if self.selected_backend_name == "opencl":
            if val Some(opencl) = self.opencl_backend:
                opencl.shutdown()
                return
        if self.selected_backend_name == "rocm":
            if val Some(rocm) = self.rocm_backend:
                rocm.shutdown()
                return
        if self.selected_backend_name == "software":
            if val Some(software) = self.software_backend:
                software.shutdown()
                return
        if val Some(vg) = self.virtio_gpu_backend:
            vg.shutdown()
        elif val Some(bm) = self.baremetal_backend:
            bm.shutdown()
        else:
            self.backend.shutdown()

    # ========================================================================
    # Frame pacing (AC-7)
    # ========================================================================

    me tick_forever(draw_fn: fn() -> bool):
        """Run the frame loop until draw_fn returns false.

        Uses event-sleep pacing (tick_once) instead of tight spinning so the
        WM thread yields CPU between frames.  FramePacingCounters are updated
        every tick and are readable via get_frame_pacing().

        Args:
            draw_fn: Called each tick to issue draw commands and call present().
                     Return false to stop the loop.
        """
        var running = true
        while running:
            running = draw_fn()
            tick_once(self.pacing)

    fn get_frame_pacing() -> FramePacingCounters:
        """Return the current accumulated frame-pacing counters."""
        self.pacing
