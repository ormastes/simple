# 2D Engine — Optimized Software Backend with SIMD Hints
#
# Enhanced CPU rendering with:
#   - Tile-based rendering for cache efficiency (64x64 tiles)
#   - SIMD-friendly memory layout (4-byte aligned, contiguous)
#   - Alpha blending support on all operations
#   - Dirty-tile tracking to minimize present() work
#
# This backend is faster than the basic CpuBackend for large scenes
# because it processes tiles that fit in L1/L2 cache.
#
# Usage:
#   use std.gpu.engine2d.backend_software.{SoftwareBackend}

use std.gc_async_mut.gpu.engine2d.backend.{RenderBackend, Engine2DExtended, Engine2DReadback, engine2d_readback, ReadbackSource, readback_source_label}
use std.gc_async_mut.gpu.engine2d.backend_capability.{BackendCapability, backend_capability_software}
use std.gpu.engine2d.color.{color_a, color_r, color_g, color_b, rgba, blend}
use std.gpu.engine2d.backend_emu_math.{_emu_overlay_ch}
use std.gpu.engine2d.helpers_text.{text_metrics, text_aa_blit_buffer}
use common.ui.glyph_bitmap_5x7.{glyph_index_for_char_code, glyph_row_bits}
use std.gpu.engine2d.simd_provider.{record_simd_fill_hit, record_simd_copy_hit, record_simd_alpha_hit}
use std.gpu.engine2d.simd_kernels.{native_pixel_rows_enabled, _scalar_fill_row, rt_engine2d_simd_fill_span_u32, rt_engine2d_simd_copy_span_u32, rt_engine2d_simd_blend_span_u32, rt_engine2d_simd_blend_const_span_u32}
use common.gpu.engine2d.kernel_registry.{
    CpuKernelTable, SpanOpBatch,
    kernel_table_new, kernel_table_register, kernel_table_seal,
    span_batch_new, span_batch_push,
    KERNEL_OP_FILL_CONST, KERNEL_OP_SRC_OVER_CONST, KERNEL_OP_SRC_OVER_IMAGE, KERNEL_OP_MASK_SRC_OVER,
    KERNEL_FORMAT_ARGB8888_STRAIGHT,
    KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS,
    KERNEL_BUCKET_TINY, KERNEL_BUCKET_SMALL, KERNEL_BUCKET_MEDIUM, KERNEL_BUCKET_LARGE,
    KERNEL_PROVIDER_SIMD_ISA,
}
use std.nogc_sync_mut.gpu.engine2d.simd_isa_provider.{
    simd_span_batch_execute, simd_isa_fill_const,
    simd_isa_src_over_const, simd_isa_src_over_image, simd_isa_mask_src_over,
}
use common.gpu.engine2d.scalar_oracle.{
    oracle_fill_const, oracle_src_over_const, oracle_src_over_image, oracle_mask_src_over,
}
use std.gc_async_mut.gpu.engine2d_host_clock.{time_now_unix_micros}
use std.gpu.engine2d.backend_emu.{
    emu_draw_ellipse, emu_draw_ellipse_filled,
    emu_draw_arc, emu_draw_bezier,
    emu_draw_polygon_filled, emu_draw_polyline,
    emu_draw_rect_thick, emu_draw_circle_thick, emu_draw_rounded_rect, emu_draw_rounded_rect_outline,
    emu_draw_gradient_rect_h, emu_draw_radial_gradient,
    emu_draw_rect_blend, emu_draw_image_blend,
    emu_draw_image_scaled,
    emu_draw_triangle_outline,
    emu_draw_blur_rect, emu_draw_shadow_rect,
    emu_draw_image_transform,
    emu_draw_rect_blend_mode,
    emu_draw_rect, emu_draw_gradient_rect
}

# ============================================================================
# Constants
# ============================================================================

val TILE_SIZE: i32 = 64     # Tile width/height in pixels (fits in L1 cache)

# ============================================================================
# Honest per-bucket kernel-table timing probe (fill_const)
# ============================================================================
#
# Same pattern as the KERNEL_BUCKET_LARGE probe that used to be the only one
# ensure_kernel_table ran: measure scalar vs SIMD-ISA at a span length
# representative of the bucket; the caller registers only if the SIMD path
# actually measured faster (and bit-exact). TINY/SMALL/MEDIUM spans pay SIMD
# setup/call overhead that LARGE spans amortize away, so this is expected to
# (and is allowed to) stay on scalar for the small buckets — the gate must
# not be forced either way.
#
# STRUCTURE NOTE (why the probes measure but do NOT register): a `mut`
# CpuKernelTable passed caller -> probe -> kernel_table_register loses the
# register's write-back at the intermediate hop under the interpreter — a
# direct one-hop kernel_table_register(t, ...) persists, the same call routed
# through a probe taking `mut table` does not (verified 2026-08-07; sibling
# of doc/08_tracking/bug/self_pass_to_free_fn_mutation_loss_2026-05-29.md).
# So each probe returns an exact/faster verdict bitmask and the table OWNER
# performs the registration one hop from itself.

val KERNEL_PROBE_FASTER: i64 = 1   # bit 0: SIMD measured faster than scalar
val KERNEL_PROBE_EXACT: i64 = 2    # bit 1: SIMD output bit-exact vs the oracle

fn _kernel_probe_fill_bucket(n: i64, iters: i64) -> i64:
    """Measure scalar vs SIMD-ISA fill_const at `n` pixels x `iters` reps and
    return the KERNEL_PROBE_* verdict bitmask. fill_const is a verbatim store,
    bit-exact by construction, so KERNEL_PROBE_EXACT is always set."""
    var probe: [u32] = [0; n.to_i32()]
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        _scalar_fill_row(probe, 0, n, 0xFF102030u32)
        i0 = i0 + 1
    val t1 = time_now_unix_micros()
    val scalar_us = t1 - t0
    # Measure the actual SIMD-ISA fill_const kernel (the same function
    # simd_span_batch_execute calls when a slot resolves to SIMD_ISA).
    val t2 = time_now_unix_micros()
    var i2: i64 = 0
    while i2 < iters:
        simd_isa_fill_const(probe, 0, n, 0xFF102030)
        i2 = i2 + 1
    val simd_us = time_now_unix_micros() - t2
    var verdict: i64 = KERNEL_PROBE_EXACT
    if simd_us < scalar_us:
        verdict = verdict + KERNEL_PROBE_FASTER
    verdict

# The three blend ops below mirror _kernel_probe_fill_bucket exactly, with one
# addition: unlike fill_const (a verbatim store, bit-exact by construction),
# these READ dst (and src/mask), so each probe first runs one oracle-vs-SIMD
# pass over identical buffers and compares pixel-for-pixel — the measured
# exact flag joins faster in the returned verdict, and the caller's
# kernel_table_register refuses the slot unless BOTH hold. Timing measures
# the same functions simd_span_batch_execute dispatches to, against the same
# scalar oracles it falls back to.

fn _kernel_probe_src_over_const_bucket(n: i64, iters: i64) -> i64:
    """Measure oracle_src_over_const vs simd_isa_src_over_const at `n` pixels
    x `iters` reps, with a bit-exact pre-pass on identical buffers. Returns
    the KERNEL_PROBE_* verdict bitmask."""
    val colour: i64 = 0x80102030
    var oracle_buf: [u32] = [0; n.to_i32()]
    var simd_buf: [u32] = [0; n.to_i32()]
    oracle_fill_const(oracle_buf, 0, n, 0xFF404040)
    oracle_fill_const(simd_buf, 0, n, 0xFF404040)
    oracle_src_over_const(oracle_buf, 0, n, colour)
    simd_isa_src_over_const(simd_buf, 0, n, colour)
    var exact = true
    var k: i64 = 0
    while k < n:
        if oracle_buf[k.to_i32()] != simd_buf[k.to_i32()]:
            exact = false
        k = k + 1
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        oracle_src_over_const(oracle_buf, 0, n, colour)
        i0 = i0 + 1
    val scalar_us = time_now_unix_micros() - t0
    val t1 = time_now_unix_micros()
    var i1: i64 = 0
    while i1 < iters:
        simd_isa_src_over_const(simd_buf, 0, n, colour)
        i1 = i1 + 1
    val simd_us = time_now_unix_micros() - t1
    var verdict: i64 = 0
    if exact:
        verdict = verdict + KERNEL_PROBE_EXACT
    if simd_us < scalar_us:
        verdict = verdict + KERNEL_PROBE_FASTER
    verdict

fn _kernel_probe_src_over_image_bucket(n: i64, iters: i64) -> i64:
    """Measure oracle_src_over_image vs simd_isa_src_over_image at `n` pixels
    x `iters` reps (same honest gate shape as the fill probe, plus the
    bit-exact pre-pass). Returns the KERNEL_PROBE_* verdict bitmask."""
    var src: [u32] = [0; n.to_i32()]
    oracle_fill_const(src, 0, n, 0x9033AA55)
    var oracle_buf: [u32] = [0; n.to_i32()]
    var simd_buf: [u32] = [0; n.to_i32()]
    oracle_fill_const(oracle_buf, 0, n, 0xFF404040)
    oracle_fill_const(simd_buf, 0, n, 0xFF404040)
    oracle_src_over_image(oracle_buf, 0, src, 0, n)
    simd_isa_src_over_image(simd_buf, 0, src, 0, n)
    var exact = true
    var k: i64 = 0
    while k < n:
        if oracle_buf[k.to_i32()] != simd_buf[k.to_i32()]:
            exact = false
        k = k + 1
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        oracle_src_over_image(oracle_buf, 0, src, 0, n)
        i0 = i0 + 1
    val scalar_us = time_now_unix_micros() - t0
    val t1 = time_now_unix_micros()
    var i1: i64 = 0
    while i1 < iters:
        simd_isa_src_over_image(simd_buf, 0, src, 0, n)
        i1 = i1 + 1
    val simd_us = time_now_unix_micros() - t1
    var verdict: i64 = 0
    if exact:
        verdict = verdict + KERNEL_PROBE_EXACT
    if simd_us < scalar_us:
        verdict = verdict + KERNEL_PROBE_FASTER
    verdict

fn _kernel_probe_mask_src_over_bucket(n: i64, iters: i64) -> i64:
    """Measure oracle_mask_src_over vs simd_isa_mask_src_over at `n` pixels
    x `iters` reps (same honest gate shape as the fill probe, plus the
    bit-exact pre-pass). Returns the KERNEL_PROBE_* verdict bitmask."""
    val colour: i64 = 0xC0104080
    var mask: [u32] = [0; n.to_i32()]
    var m: i64 = 0
    while m < n:
        # Mixed coverage including 0 and 255 so the probe exercises the
        # oracle's `m > 0` skip and full-coverage paths, not one flat value.
        mask[m.to_i32()] = ((m * 37) % 256) as u32
        m = m + 1
    var oracle_buf: [u32] = [0; n.to_i32()]
    var simd_buf: [u32] = [0; n.to_i32()]
    oracle_fill_const(oracle_buf, 0, n, 0xFF404040)
    oracle_fill_const(simd_buf, 0, n, 0xFF404040)
    oracle_mask_src_over(oracle_buf, 0, colour, mask, 0, n)
    simd_isa_mask_src_over(simd_buf, 0, colour, mask, 0, n)
    var exact = true
    var k: i64 = 0
    while k < n:
        if oracle_buf[k.to_i32()] != simd_buf[k.to_i32()]:
            exact = false
        k = k + 1
    val t0 = time_now_unix_micros()
    var i0: i64 = 0
    while i0 < iters:
        oracle_mask_src_over(oracle_buf, 0, colour, mask, 0, n)
        i0 = i0 + 1
    val scalar_us = time_now_unix_micros() - t0
    val t1 = time_now_unix_micros()
    var i1: i64 = 0
    while i1 < iters:
        simd_isa_mask_src_over(simd_buf, 0, colour, mask, 0, n)
        i1 = i1 + 1
    val simd_us = time_now_unix_micros() - t1
    var verdict: i64 = 0
    if exact:
        verdict = verdict + KERNEL_PROBE_EXACT
    if simd_us < scalar_us:
        verdict = verdict + KERNEL_PROBE_FASTER
    verdict

# ============================================================================
# Software Backend
# ============================================================================

class SoftwareBackend:
    """Optimized software renderer with tile-based processing.

    Memory layout: flat [u32] buffer, row-major, 4 bytes per pixel (ARGB).
    Tiles: the framebuffer is logically divided into TILE_SIZE x TILE_SIZE
    tiles. Draw operations mark affected tiles as dirty. present() can
    use the dirty set to minimize work when compositing to a display.

    All draw operations support alpha blending via the blend() function
    from color.spl. Opaque colors (alpha=255) bypass the blend for speed.
    """

    buf: [u32]
    w: i32
    h: i32
    tiles_x: i32              # Number of tiles horizontally
    tiles_y: i32              # Number of tiles vertically
    dirty_tiles: [bool]       # Per-tile dirty flag
    clip_x: i32
    clip_y: i32
    clip_w: i32
    clip_h: i32
    clip_enabled: bool
    mask_buf: [u8]
    mask_w: i32
    mask_h: i32
    initialized: bool
    native_simd_spans: bool
    mirror: [u32]             # WS-D3 frame-persistent readback mirror
    mirror_valid: bool
    kernel_table: CpuKernelTable   # per-op provider table for simd_span_batch_execute
    kernel_table_ready: bool       # true once the honest timing gate has run and sealed the table
    simd_batch_hits: i64           # observable: ops the batch dispatcher actually routed to SIMD_ISA

    static fn create() -> SoftwareBackend:
        """Create an uninitialized software backend."""
        SoftwareBackend(
            buf: [],
            w: 0,
            h: 0,
            tiles_x: 0,
            tiles_y: 0,
            dirty_tiles: [],
            clip_x: 0,
            clip_y: 0,
            clip_w: 0,
            clip_h: 0,
            clip_enabled: false,
            mask_buf: [],
            mask_w: 0,
            mask_h: 0,
            initialized: false,
            native_simd_spans: false,
            mirror: [],
            mirror_valid: false,
            kernel_table: kernel_table_new(),
            kernel_table_ready: false,
            simd_batch_hits: 0
        )

    static fn create_cpu_simd() -> SoftwareBackend:
        var backend = SoftwareBackend.create()
        backend.native_simd_spans = true
        backend

impl RenderBackend for SoftwareBackend:

    fn name() -> text:
        "software"

    me init(width: i32, height: i32) -> bool:
        self.w = width
        self.h = height
        val total = width * height
        self.buf = [0; total]

        # Initialize tile tracking
        self.tiles_x = (width + TILE_SIZE - 1) / TILE_SIZE
        self.tiles_y = (height + TILE_SIZE - 1) / TILE_SIZE
        val tile_count = self.tiles_x * self.tiles_y
        # WS-D3 hole #2: init() writes the WHOLE buffer (opaque black, below),
        # so frame 1's damage set must cover the whole surface. Allocating
        # all-false here left an empty damage set over a fully written buffer,
        # which ships stale pixels to any damage-driven consumer on frame 1.
        self.dirty_tiles = [true; tile_count]

        # Fill with opaque black
        val opaque_black = 0xff000000u32
        var i = 0
        while i < total:
            self.buf[i] = opaque_black
            i = i + 1

        self.clip_x = 0
        self.clip_y = 0
        self.clip_w = width
        self.clip_h = height
        self.clip_enabled = false
        self.initialized = true
        true

    me shutdown():
        self.buf = []
        self.dirty_tiles = []
        self.mirror = []
        self.mirror_valid = false
        self.mask_buf = []
        self.mask_w = 0
        self.mask_h = 0
        self.w = 0
        self.h = 0
        self.initialized = false

    me clear(color: u32):
        var row = 0
        # cpu-lane-loop-ok: framebuffer clear walks one scanline per row and delegates each row to sw_fill_raw_span; the per-row bulk fill is already the bulk idiom, a whole-buffer memset is blocked on N5
        while row < self.h:
            self.sw_fill_raw_span(row * self.w, self.w, color)
            row = row + 1
        val dirty_count = self.dirty_tiles.len()
        var dirty = 0
        while dirty < dirty_count:
            self.dirty_tiles[dirty] = true
            dirty = dirty + 1

    me draw_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        # Outline: four edges, delegated to the canonical emu algorithm
        # (backend_emu.spl:43) so CPU output is byte-identical to the shared
        # emulation reference — same idiom as draw_rounded_rect. emu composes
        # the edges from core.draw_rect_filled (trait dispatch, so self
        # mutation persists), which ALSO gets us alpha-blended edges for free:
        # the old hand-written sw_hline/sw_vline edges wrote raw color and
        # never blended alpha, diverging from emu on alpha outlines.
        # reconciled to canonical emu 2026-07-06 (D2)
        # Degenerate-dim guard (w <= 0 or h <= 0) lives inside emu, matching
        # Metal's _dispatch_metal_rect_outline guard.
        emu_draw_rect(self, x, y, w, h, color)

    me draw_rect_filled(x: i32, y: i32, w: i32, h: i32, color: u32):
        val has_alpha = color_a(color) < 255
        val row_end = y + h
        val clip_y_end = self.clip_y + self.clip_h
        val clip_x_end = self.clip_x + self.clip_w
        val mask_active = self.mask_buf.len() > 0
        if has_alpha:
            var alpha_row = y
            while alpha_row < row_end:
                self.sw_hline_blend(x, alpha_row, w, color)
                alpha_row = alpha_row + 1
            return
        var start_x = x
        var end_x = x + w
        if start_x < 0:
            start_x = 0
        if end_x > self.w:
            end_x = self.w
        var start_y = y
        var end_y = row_end
        if start_y < 0:
            start_y = 0
        if end_y > self.h:
            end_y = self.h
        if self.clip_enabled:
            if start_x < self.clip_x:
                start_x = self.clip_x
            if end_x > clip_x_end:
                end_x = clip_x_end
            if start_y < self.clip_y:
                start_y = self.clip_y
            if end_y > clip_y_end:
                end_y = clip_y_end
        if end_x <= start_x or end_y <= start_y:
            return
        var row = start_y
        while row < end_y:
            var col = start_x
            if mask_active:
                while col < end_x:
                    self.sw_set_pixel(col, row, color)
                    col = col + 1
            else:
                val row_base = row * self.w
                self.sw_fill_raw_span(row_base + start_x, end_x - start_x, color)
                self.mark_span_dirty(start_x, row, end_x - start_x)
            row = row + 1

    me draw_line(x1: i32, y1: i32, x2: i32, y2: i32, color: u32, thickness: i32):
        # NOT consolidated onto emu (D2 group A review, 2026-07-06): thin lines
        # are already byte-exact against emu_draw_line, but emu's per-point
        # body re-enters core.draw_rect_filled(cx, cy, 1, 1, color) for every
        # Bresenham step (full clip/mask/dirty-span overhead per pixel),
        # whereas sw_bresenham's sw_set_pixel is the lean single-guard-set
        # primitive. Delegating would multiply per-pixel cost on long lines
        # for no behavior change, so this stays a documented exception.
        if thickness <= 1:
            self.sw_bresenham(x1, y1, x2, y2, color)
        else:
            val half = thickness / 2
            var offset = -half
            var adx = x2 - x1
            if adx < 0: adx = -adx
            var ady = y2 - y1
            if ady < 0: ady = -ady
            while offset <= half:
                if adx >= ady:
                    self.sw_bresenham(x1, y1 + offset, x2, y2 + offset, color)
                else:
                    self.sw_bresenham(x1 + offset, y1, x2 + offset, y2, color)
                offset = offset + 1

    me draw_circle(cx: i32, cy: i32, r: i32, color: u32):
        # Degenerate radius is a no-op, matching Metal's
        # _dispatch_metal_circle guard (r <= 0). This guard is sw-canonical
        # and intentionally NOT unified with emu (emu stamps a stray center
        # pixel for r <= 0) — see doc/05_design D2 roadmap.
        if r <= 0:
            return
        var px = r
        var py = 0
        var d = 1 - r
        while px >= py:
            self.sw_set_pixel(cx + px, cy + py, color)
            self.sw_set_pixel(cx - px, cy + py, color)
            self.sw_set_pixel(cx + px, cy - py, color)
            self.sw_set_pixel(cx - px, cy - py, color)
            self.sw_set_pixel(cx + py, cy + px, color)
            self.sw_set_pixel(cx - py, cy + px, color)
            self.sw_set_pixel(cx + py, cy - px, color)
            self.sw_set_pixel(cx - py, cy - px, color)
            py = py + 1
            # Decision-variable tie-break unified to emu's textbook `d < 0`
            # (was `d <= 0`), matching backend_emu.spl:117 bit-for-bit at
            # midpoint-tie radii. reconciled to canonical emu 2026-07-06 (D2)
            if d < 0:
                d = d + 2 * py + 1
            else:
                px = px - 1
                d = d + 2 * py - 2 * px + 1

    me draw_circle_filled(cx: i32, cy: i32, r: i32, color: u32):
        # Per-pixel disk: a pixel (dx, dy) is filled iff dx*dx + dy*dy <= r*r.
        # Emitted as one horizontal span per row (half-width = floor(sqrt(r*r -
        # dy*dy))) so it stays a fast hline fill while producing the identical
        # pixel set as the Metal kernel_draw_circle_filled distance test — making
        # CPU and GPU bit-exact for filled circles.
        # Degenerate radius is a no-op, matching Metal's
        # _dispatch_metal_circle guard (r <= 0).
        if r <= 0:
            return
        val has_alpha = color_a(color) < 255
        val r_sq = r * r
        var dy = 0 - r
        while dy <= r:
            val half = _sw_isqrt(r_sq - dy * dy)
            if has_alpha:
                self.sw_hline_blend(cx - half, cy + dy, 2 * half + 1, color)
            else:
                self.sw_hline(cx - half, cy + dy, 2 * half + 1, color)
            dy = dy + 1

    me draw_rounded_rect(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32):
        # A FILLED rounded rectangle. Delegates to the canonical emu algorithm
        # (backend_emu.spl:152) so CPU output is byte-identical to the shared
        # emulation reference — same idiom as draw_ellipse/draw_ellipse_filled.
        # emu composes the fill from core.draw_rect_filled (trait dispatch, so
        # self mutation persists). Degenerate-dim guard lives inside emu.
        # NOTE: this used to draw only a 1px OUTLINE (a bug); genuine outlines
        # are draw_rounded_rect_outline. See
        # doc/08_tracking/bug/engine2d_software_rounded_rect_draws_outline_not_fill_2026-07-06.md
        emu_draw_rounded_rect(self, x, y, w, h, radius, color)

    me draw_triangle_filled(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32):
        # Integer barycentric (edge-function / 2x-area) fill, identical to the
        # Metal kernel_draw_triangle_filled so CPU and GPU produce the same pixel
        # set. A pixel is inside when all three edge weights share the sign of the
        # triangle determinant. Iterates the same bounding box as the GPU kernel.
        val d = (y2 - y3) * (x1 - x3) + (x3 - x2) * (y1 - y3)
        if d == 0:
            return
        var min_x = x1
        if x2 < min_x: min_x = x2
        if x3 < min_x: min_x = x3
        var max_x = x1
        if x2 > max_x: max_x = x2
        if x3 > max_x: max_x = x3
        var min_y = y1
        if y2 < min_y: min_y = y2
        if y3 < min_y: min_y = y3
        var max_y = y1
        if y2 > max_y: max_y = y2
        if y3 > max_y: max_y = y3

        val has_alpha = color_a(color) < 255
        var py = min_y
        while py <= max_y:
            var px = min_x
            while px <= max_x:
                val w1 = (y2 - y3) * (px - x3) + (x3 - x2) * (py - y3)
                val w2 = (y3 - y1) * (px - x3) + (x1 - x3) * (py - y3)
                val w3 = d - w1 - w2
                var inside = false
                if d > 0:
                    inside = w1 >= 0 and w2 >= 0 and w3 >= 0
                else:
                    inside = w1 <= 0 and w2 <= 0 and w3 <= 0
                if inside:
                    if has_alpha:
                        self.sw_set_pixel_blend(px, py, color)
                    else:
                        self.sw_set_pixel(px, py, color)
                px = px + 1
            py = py + 1

    me draw_gradient_rect(x: i32, y: i32, w: i32, h: i32, top_color: u32, bottom_color: u32):
        # Row-by-row integer lerp, delegated to the canonical emu algorithm
        # (backend_emu.spl:250) so CPU output is byte-identical to the shared
        # emulation reference — same idiom as draw_rounded_rect/draw_rect.
        # Lerp formula (a + (b-a)*t/max_t, truncate toward zero) matches the
        # Metal MSL kernel_draw_gradient_rect bit-for-bit; a float lerp would
        # diverge by +/-1 per channel due to rounding and is not reproducible
        # on the GPU. emu composes each row from core.draw_rect_filled (trait
        # dispatch, so self mutation persists).
        emu_draw_gradient_rect(self, x, y, w, h, top_color, bottom_color)

    me draw_text(x: i32, y: i32, text_val: text, color: u32, font_size: i32):
        # Render glyph rows inline via the shared packed atlas. This avoids
        # per-character row-array allocation while keeping byte-identical glyphs.
        val metrics = text_metrics(text_val, font_size)
        val gh = metrics.glyph_height_px
        val scale = metrics.scale
        val advance = metrics.advance
        val text_len = text_val.len()
        val fast_direct = not self.clip_enabled and self.mask_buf.len() == 0
        var i: i64 = 0
        var cursor_x = x
        while i < text_len:
            val code = text_val.char_code_at(i)
            val glyph_index = glyph_index_for_char_code(code)
            var gy = 0
            while gy < gh:
                val row_data = glyph_row_bits(glyph_index, gy)
                var gx = 0
                while gx < 5:
                    val bit = (row_data >> (4 - gx)) & 1
                    if bit != 0:
                        val run_x = cursor_x + gx * scale
                        val run_y = y + gy * scale
                        if fast_direct:
                            var sy = 0
                            while sy < scale:
                                val py = run_y + sy
                                if py >= 0 and py < self.h:
                                    var start_x = run_x
                                    var count = scale
                                    if start_x < 0:
                                        count = count + start_x
                                        start_x = 0
                                    if start_x + count > self.w:
                                        count = self.w - start_x
                                    if count > 0:
                                        val off = py * self.w + start_x
                                        self.sw_fill_raw_span(off, count, color)
                                        self.mark_span_dirty(start_x, py, count)
                                sy = sy + 1
                        else:
                            var sy = 0
                            while sy < scale:
                                val py = run_y + sy
                                var sx = 0
                                while sx < scale:
                                    self.sw_set_pixel(run_x + sx, py, color)
                                    sx = sx + 1
                                sy = sy + 1
                    gx = gx + 1
                gy = gy + 1
            cursor_x = cursor_x + advance
            i = i + 1

    me draw_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        if w <= 0 or h <= 0:
            return
        val pixels_len = pixels.len()
        val slow_checked = self.clip_enabled or self.mask_buf.len() > 0
        var row = 0
        # cpu-lane-loop-ok: one iteration per source image row while blitting; each row body delegates to sw_copy_raw_span, so the per-pixel work is already bulk
        while row < h:
            val py = y + row
            if py >= 0 and py < self.h:
                val src_row_base = row * w
                var start_x = x
                var src_x = 0
                var count = w
                if start_x < 0:
                    src_x = -start_x
                    count = count + start_x
                    start_x = 0
                if start_x + count > self.w:
                    count = self.w - start_x
                if count > 0 and src_row_base + src_x + count <= pixels_len:
                    val src_off = src_row_base + src_x
                    if slow_checked:
                        var col = 0
                        # cpu-lane-loop-ok: clipped/masked slow path only (slow_checked): per-pixel sw_set_pixel is required because clip and mask tests are per-pixel predicates
                        while col < count:
                            self.sw_set_pixel(start_x + col, py, pixels[src_off + col])
                            col = col + 1
                    else:
                        val dst_off = py * self.w + start_x
                        self.sw_copy_raw_span(dst_off, pixels, src_off, count)
                        self.mark_span_dirty(start_x, py, count)
            row = row + 1

    me blit_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        """Compatibility alias used by SIMD integration tests."""
        self.draw_image(x, y, w, h, pixels)

    me set_clip(x: i32, y: i32, w: i32, h: i32):
        self.clip_x = x
        self.clip_y = y
        self.clip_w = w
        self.clip_h = h
        self.clip_enabled = true

    me clear_clip():
        self.clip_enabled = false
        self.clip_x = 0
        self.clip_y = 0
        self.clip_w = self.w
        self.clip_h = self.h

    me set_mask(mask_pixels: [u8], w: i32, h: i32):
        self.mask_buf = mask_pixels
        self.mask_w = w
        self.mask_h = h

    me clear_mask():
        self.mask_buf = []
        self.mask_w = 0
        self.mask_h = 0

    me submit_batch() -> bool:
        # Immediate-mode backend: nothing buffered to flush.
        true

    me present():
        # Reset dirty tiles for next frame
        val dirty_count = self.dirty_tiles.len()
        var i = 0
        while i < dirty_count:
            self.dirty_tiles[i] = false
            i = i + 1

    me read_pixels() -> [u32]:
        val pixel_count = self.w * self.h
        var copy: [u32] = [0; pixel_count]
        var i = 0
        while i < pixel_count:
            copy[i] = self.buf[i]
            i = i + 1
        copy

    me read_pixels_with_source() -> Engine2DReadback:
        val pixel_count = self.w * self.h
        var copy: [u32] = [0; pixel_count]
        var i = 0
        while i < pixel_count:
            copy[i] = self.buf[i]
            i = i + 1
        engine2d_readback(copy, readback_source_label(ReadbackSource.CpuMirror))

    me scale_alpha_in_place(opacity_milli: i32):
        """Scale every pixel's alpha by opacity_milli/1000 IN PLACE.

        Byte-identical to engine2d_scale_pixel_alpha() but mutates this
        backend's own buffer instead of returning a fresh full-surface array,
        so compositing a scratch offscreen at partial opacity does not allocate
        a copy. Only valid on a buffer the caller is about to discard or
        re-clear (the SimpleOS baremetal heap never reclaims, so every avoided
        full-surface array matters).
        """
        if opacity_milli >= 1000:
            return
        val count = self.buf.len()
        var i = 0
        while i < count:
            val p = self.buf[i]
            val scaled_a = (color_a(p) * opacity_milli) / 1000
            self.buf[i] = rgba(color_r(p), color_g(p), color_b(p), scaled_a)
            i = i + 1
        # WS-D3 hole #1: this kernel rewrites EVERY pixel in place but used to
        # mark nothing dirty, so a damage-driven present would ship the whole
        # surface stale. It is a whole-buffer write => whole-buffer damage.
        val tile_total = self.dirty_tiles.len()
        var t = 0
        while t < tile_total:
            self.dirty_tiles[t] = true
            t = t + 1

    fn capability() -> BackendCapability:
        """Honest self-description: pure-CPU software emulation, no device,
        no GPU-accelerated ops (everything runs on the software path)."""
        backend_capability_software()

    me width() -> i32:
        self.w

    me height() -> i32:
        self.h

    me draw_ellipse(cx: i32, cy: i32, rx: i32, ry: i32, color: u32):
        emu_draw_ellipse(self, cx, cy, rx, ry, color)

    me draw_ellipse_filled(cx: i32, cy: i32, rx: i32, ry: i32, color: u32):
        emu_draw_ellipse_filled(self, cx, cy, rx, ry, color)

    me draw_arc(cx: i32, cy: i32, r: i32, start_deg: i32, end_deg: i32, color: u32, thickness: i32):
        emu_draw_arc(self, cx, cy, r, start_deg, end_deg, color, thickness)

    me draw_bezier(x1: i32, y1: i32, cx1: i32, cy1: i32, cx2: i32, cy2: i32, x2: i32, y2: i32, color: u32, thickness: i32):
        emu_draw_bezier(self, x1, y1, cx1, cy1, cx2, cy2, x2, y2, color, thickness)

    me draw_polygon_filled(xs: [i32], ys: [i32], count: i32, color: u32):
        emu_draw_polygon_filled(self, xs, ys, count, color)

    me draw_polyline(xs: [i32], ys: [i32], count: i32, color: u32, thickness: i32):
        emu_draw_polyline(self, xs, ys, count, color, thickness)

    me draw_rect_thick(x: i32, y: i32, w: i32, h: i32, color: u32, thickness: i32):
        emu_draw_rect_thick(self, x, y, w, h, color, thickness)

    me draw_circle_thick(cx: i32, cy: i32, r: i32, color: u32, thickness: i32):
        emu_draw_circle_thick(self, cx, cy, r, color, thickness)

    me draw_rounded_rect_outline(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32, thickness: i32):
        if w <= 0 or h <= 0 or thickness <= 0:
            return
        var r = radius
        if r > w / 2:
            r = w / 2
        if r > h / 2:
            r = h / 2
        var t = thickness
        if t > r + 1:
            t = r + 1
        var off = 0
        while off < t:
            self.sw_hline(x + r, y + off, w - 2 * r, color)
            self.sw_hline(x + r, y + h - 1 - off, w - 2 * r, color)
            self.sw_vline(x + off, y + r, h - 2 * r, color)
            self.sw_vline(x + w - 1 - off, y + r, h - 2 * r, color)
            self.sw_corner_arc(x + r, y + r, r - off, color, -1, -1)
            self.sw_corner_arc(x + w - 1 - r, y + r, r - off, color, 1, -1)
            self.sw_corner_arc(x + r, y + h - 1 - r, r - off, color, -1, 1)
            self.sw_corner_arc(x + w - 1 - r, y + h - 1 - r, r - off, color, 1, 1)
            off = off + 1

    me draw_gradient_rect_h(x: i32, y: i32, w: i32, h: i32, left_color: u32, right_color: u32):
        if w <= 0 or h <= 0:
            return
        val lr = color_r(left_color)
        val lg = color_g(left_color)
        val lb = color_b(left_color)
        val la = color_a(left_color)
        val rr = color_r(right_color)
        val rg = color_g(right_color)
        val rb = color_b(right_color)
        val ra = color_a(right_color)
        val opaque_ramp = la == 255 and ra == 255
        var divisor = w - 1
        if divisor < 1:
            divisor = 1
        # Build the immutable horizontal ramp once, then replay it through the
        # contiguous variable-alpha span owner.  This preserves the emulation
        # oracle's integer interpolation while avoiding w vertical draw calls
        # and their strided framebuffer walks.
        var gradient_row: [u32] = [0u32; w]
        var col = 0
        while col < w:
            val r = lr + (rr - lr) * col / divisor
            val g = lg + (rg - lg) * col / divisor
            val b = lb + (rb - lb) * col / divisor
            val a = la + (ra - la) * col / divisor
            gradient_row[col] = rgba(r, g, b, a)
            col = col + 1
        var row = 0
        while row < h:
            if opaque_ramp:
                self.draw_image(x, y + row, w, 1, gradient_row)
            else:
                self.draw_image_blend(x, y + row, w, 1, gradient_row)
            row = row + 1

    me draw_radial_gradient(cx: i32, cy: i32, r: i32, center_color: u32, edge_color: u32):
        emu_draw_radial_gradient(self, cx, cy, r, center_color, edge_color)

    me draw_rect_blend(x: i32, y: i32, w: i32, h: i32, color: u32):
        if w <= 0 or h <= 0:
            return
        val alpha = color_a(color)
        if alpha == 0:
            return
        if alpha == 255:
            self.draw_rect_filled(x, y, w, h, color)
            return
        var row = 0
        # Route each clipped row through the backend's constant-colour span
        # owner.  The mask-off path blends in place with the native
        # AVX2/SSE2/NEON/RVV primitive; clipped and masked rows retain the
        # exact per-pixel fallback owned by sw_hline_blend.
        while row < h:
            self.sw_hline_blend(x, y + row, w, color)
            row = row + 1

    me draw_image_blend(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        if w <= 0 or h <= 0:
            return
        val pixels_len = pixels.len()
        val slow_checked = self.clip_enabled or self.mask_buf.len() > 0
        var row = 0
        # cpu-lane-loop-ok: one iteration per source image row while alpha-blitting; each row body delegates to the SIMD row blend or its scalar fallback below
        while row < h:
            val py = y + row
            if py >= 0 and py < self.h:
                val src_row_base = row * w
                var start_x = x
                var src_x = 0
                var count = w
                if start_x < 0:
                    src_x = -start_x
                    count = count + start_x
                    start_x = 0
                if start_x + count > self.w:
                    count = self.w - start_x
                if count > 0 and src_row_base + src_x + count <= pixels_len:
                    var col = 0
                    if slow_checked:
                        # cpu-lane-loop-ok: clipped/masked slow path only (slow_checked): per-pixel sw_set_pixel_blend is required because clip and mask tests are per-pixel predicates
                        while col < count:
                            self.sw_set_pixel_blend(start_x + col, py, pixels[src_row_base + src_x + col])
                            col = col + 1
                    else:
                        val dst_off = py * self.w + start_x
                        val src_off = src_row_base + src_x
                        if self.native_simd_spans and native_pixel_rows_enabled():
                            record_simd_alpha_hit()
                            self.buf = rt_engine2d_simd_blend_span_u32(
                                self.buf, dst_off.to_i64(), pixels,
                                src_off.to_i64(), count.to_i64())
                        else:
                            # cpu-lane-loop-ok: scalar fallback taken when SIMD spans are unavailable on this arch; this is the reference blend body the SIMD path is checked against
                            while col < count:
                                val src = pixels[src_off + col]
                                if color_a(src) > 0:
                                    self.buf[dst_off + col] = blend(src, self.buf[dst_off + col])
                                col = col + 1
                        self.mark_span_dirty(start_x, py, count)
            row = row + 1

    me draw_image_scaled(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        val src_count = src_w.to_i64() * src_h.to_i64()
        val dst_count = dst_w.to_i64() * dst_h.to_i64()
        val right = dst_x.to_i64() + dst_w.to_i64()
        val bottom = dst_y.to_i64() + dst_h.to_i64()
        if (dst_w <= 0 or dst_h <= 0 or src_w <= 0 or src_h <= 0 or
            src_count <= 0 or pixels.len().to_i64() != src_count or
            dst_count <= 0 or dst_count > 2147483647 or
            (dst_w.to_i64() - 1) * src_w.to_i64() > 2147483647 or
            (dst_h.to_i64() - 1) * src_h.to_i64() > 2147483647 or
            right - 1 > 2147483647 or bottom - 1 > 2147483647):
            return

        # `buf` is public and may be supplied as the source array.  Preserve
        # the emulation path's snapshot-before-write semantics whenever the
        # source shape could cover this framebuffer; other source lengths
        # cannot alias `self.buf`.
        var source_pixels = pixels
        if src_count == self.buf.len().to_i64():
            var snapshot: [u32] = [0u32; src_count]
            var source_i: i64 = 0
            while source_i < src_count:
                snapshot[source_i] = pixels[source_i]
                source_i = source_i + 1
            source_pixels = snapshot

        # Precompute horizontal nearest-neighbour indices once and stream one
        # reusable row through draw_image.  The emulation path materialized
        # dst_w * dst_h pixels before the first write; this bounds transient
        # storage to two dst_w arrays and lets opaque rows use SIMD copies.
        var src_x: [i32] = [0; dst_w]
        var row_pixels: [u32] = [0u32; dst_w]
        var dx = 0
        while dx < dst_w:
            src_x[dx] = (dx.to_i64() * src_w.to_i64() / dst_w.to_i64()) as i32
            dx = dx + 1
        var dy0_64: i64 = 0
        if dst_y < 0:
            dy0_64 = 0 - dst_y.to_i64()
        var dy1_64 = dst_h.to_i64()
        val surface_end = self.h.to_i64() - dst_y.to_i64()
        if dy1_64 > surface_end:
            dy1_64 = surface_end
        if dy0_64 < 0: dy0_64 = 0
        if dy1_64 > dst_h.to_i64(): dy1_64 = dst_h.to_i64()
        if dy0_64 >= dy1_64:
            return
        var dy = dy0_64 as i32
        var last_sy: i32 = -1
        while dy < (dy1_64 as i32):
            val sy = (dy.to_i64() * src_h.to_i64() / dst_h.to_i64()) as i32
            if sy != last_sy:
                val src_base = sy * src_w
                dx = 0
                while dx < dst_w:
                    row_pixels[dx] = source_pixels[src_base + src_x[dx]]
                    dx = dx + 1
                last_sy = sy
            self.draw_image(dst_x, dst_y + dy, dst_w, 1, row_pixels)
            dy = dy + 1

    me draw_triangle_outline(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32, thickness: i32):
        emu_draw_triangle_outline(self, x1, y1, x2, y2, x3, y3, color, thickness)

    me draw_blur_rect(x: i32, y: i32, w: i32, h: i32, radius: i32):
        if w <= 0 or h <= 0 or radius <= 0:
            return
        var out_x0_64 = x.to_i64()
        var out_y0_64 = y.to_i64()
        var out_x1_64 = x.to_i64() + w.to_i64()
        var out_y1_64 = y.to_i64() + h.to_i64()
        if out_x0_64 < 0: out_x0_64 = 0
        if out_y0_64 < 0: out_y0_64 = 0
        if out_x1_64 > self.w.to_i64(): out_x1_64 = self.w.to_i64()
        if out_y1_64 > self.h.to_i64(): out_y1_64 = self.h.to_i64()
        val out_x0 = out_x0_64 as i32
        val out_y0 = out_y0_64 as i32
        val out_x1 = out_x1_64 as i32
        val out_y1 = out_y1_64 as i32
        val out_w = out_x1 - out_x0
        val out_h = out_y1 - out_y0
        if out_w <= 0 or out_h <= 0:
            return

        # Only framebuffer rows that can contribute to a visible output are
        # materialized.  The emulation owner allocated (h + 2r) * w entries
        # for five planes and first copied the entire framebuffer; this keeps
        # the same separable sums while bounding scratch to
        # visible_width * contributing_framebuffer_rows.
        var src_y0_64 = out_y0.to_i64() - radius.to_i64()
        var src_y1_64 = out_y1.to_i64() + radius.to_i64()
        if src_y0_64 < 0: src_y0_64 = 0
        if src_y1_64 > self.h.to_i64(): src_y1_64 = self.h.to_i64()
        val src_y0 = src_y0_64 as i32
        val src_y1 = src_y1_64 as i32
        val src_rows = src_y1 - src_y0
        val span = src_rows.to_i64() * out_w.to_i64()
        val out_count = out_w.to_i64() * out_h.to_i64()
        if span <= 0 or span > 2147483647 or out_count <= 0 or out_count > 2147483647:
            return
        var hr: [i32] = [0; span]
        var hg: [i32] = [0; span]
        var hb: [i32] = [0; span]
        var ha: [i32] = [0; span]
        var hc: [i32] = [0; span]
        var ri = 0
        while ri < src_rows:
            val fy = src_y0 + ri
            val row_base = fy * self.w
            val out_base = ri * out_w
            var sr = 0
            var sg = 0
            var sb = 0
            var sa = 0
            var cnt = 0
            var fx_64 = out_x0.to_i64() - radius.to_i64()
            var fx_end_64 = out_x0.to_i64() + radius.to_i64()
            if fx_64 < 0: fx_64 = 0
            if fx_end_64 >= self.w.to_i64(): fx_end_64 = self.w.to_i64() - 1
            while fx_64 <= fx_end_64:
                val p = self.buf[row_base + (fx_64 as i32)]
                sr = sr + (((p >> 16) & 0xFFu32) as i32)
                sg = sg + (((p >> 8) & 0xFFu32) as i32)
                sb = sb + ((p & 0xFFu32) as i32)
                sa = sa + (((p >> 24) & 0xFFu32) as i32)
                cnt = cnt + 1
                fx_64 = fx_64 + 1
            var px = 0
            while px < out_w:
                hr[out_base + px] = sr
                hg[out_base + px] = sg
                hb[out_base + px] = sb
                ha[out_base + px] = sa
                hc[out_base + px] = cnt
                val leave_x = out_x0.to_i64() + px.to_i64() - radius.to_i64()
                if leave_x >= 0 and leave_x < self.w.to_i64():
                    val p = self.buf[row_base + (leave_x as i32)]
                    sr = sr - (((p >> 16) & 0xFFu32) as i32)
                    sg = sg - (((p >> 8) & 0xFFu32) as i32)
                    sb = sb - ((p & 0xFFu32) as i32)
                    sa = sa - (((p >> 24) & 0xFFu32) as i32)
                    cnt = cnt - 1
                val enter_x = out_x0.to_i64() + px.to_i64() + radius.to_i64() + 1
                if enter_x >= 0 and enter_x < self.w.to_i64():
                    val p = self.buf[row_base + (enter_x as i32)]
                    sr = sr + (((p >> 16) & 0xFFu32) as i32)
                    sg = sg + (((p >> 8) & 0xFFu32) as i32)
                    sb = sb + ((p & 0xFFu32) as i32)
                    sa = sa + (((p >> 24) & 0xFFu32) as i32)
                    cnt = cnt + 1
                px = px + 1
            ri = ri + 1

        var temp: [u32] = [0u32; out_count]
        var px = 0
        while px < out_w:
            var sr = 0
            var sg = 0
            var sb = 0
            var sa = 0
            var cnt = 0
            var fy = src_y0
            var fy_end_64 = out_y0.to_i64() + radius.to_i64() + 1
            if fy_end_64 > self.h.to_i64(): fy_end_64 = self.h.to_i64()
            val fy_end = fy_end_64 as i32
            while fy < fy_end:
                val idx = (fy - src_y0) * out_w + px
                sr = sr + hr[idx]
                sg = sg + hg[idx]
                sb = sb + hb[idx]
                sa = sa + ha[idx]
                cnt = cnt + hc[idx]
                fy = fy + 1
            var py = 0
            while py < out_h:
                if cnt > 0:
                    temp[py * out_w + px] = rgba(sr / cnt, sg / cnt, sb / cnt, sa / cnt)
                val gy = out_y0 + py
                val leave_y = gy.to_i64() - radius.to_i64()
                if leave_y >= src_y0.to_i64() and leave_y < src_y1.to_i64():
                    val idx = ((leave_y as i32) - src_y0) * out_w + px
                    sr = sr - hr[idx]
                    sg = sg - hg[idx]
                    sb = sb - hb[idx]
                    sa = sa - ha[idx]
                    cnt = cnt - hc[idx]
                val enter_y = gy.to_i64() + radius.to_i64() + 1
                if enter_y >= src_y0.to_i64() and enter_y < src_y1.to_i64():
                    val idx = ((enter_y as i32) - src_y0) * out_w + px
                    sr = sr + hr[idx]
                    sg = sg + hg[idx]
                    sb = sb + hb[idx]
                    sa = sa + ha[idx]
                    cnt = cnt + hc[idx]
                py = py + 1
            px = px + 1
        self.draw_image(out_x0, out_y0, out_w, out_h, temp)

    me draw_shadow_rect(x: i32, y: i32, w: i32, h: i32, offset_x: i32, offset_y: i32, blur_r: i32, color: u32):
        emu_draw_shadow_rect(self, x, y, w, h, offset_x, offset_y, blur_r, color)

    me draw_image_transform(dst_x: i32, dst_y: i32, src_w: i32, src_h: i32, a: i32, b: i32, c: i32, d: i32, tx: i32, ty: i32, pixels: [u32]):
        emu_draw_image_transform(self, dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)

    me draw_rect_blend_mode(x: i32, y: i32, w: i32, h: i32, color: u32, mode: i32):
        if w <= 0 or h <= 0:
            return
        val sr = color_r(color)
        val sg = color_g(color)
        val sb = color_b(color)
        val sa = color_a(color)
        if mode != 1 and mode != 2 and mode != 3 and mode != 4 and sa == 255:
            self.draw_rect_filled(x, y, w, h, color)
            return
        var x0_64 = x.to_i64()
        var y0_64 = y.to_i64()
        var x1_64 = x.to_i64() + w.to_i64()
        var y1_64 = y.to_i64() + h.to_i64()
        if x0_64 < 0: x0_64 = 0
        if y0_64 < 0: y0_64 = 0
        if x1_64 > self.w.to_i64(): x1_64 = self.w.to_i64()
        if y1_64 > self.h.to_i64(): y1_64 = self.h.to_i64()
        if self.clip_enabled:
            val clip_x0 = self.clip_x.to_i64()
            val clip_y0 = self.clip_y.to_i64()
            val clip_x1 = clip_x0 + self.clip_w.to_i64()
            val clip_y1 = clip_y0 + self.clip_h.to_i64()
            if x0_64 < clip_x0: x0_64 = clip_x0
            if y0_64 < clip_y0: y0_64 = clip_y0
            if x1_64 > clip_x1: x1_64 = clip_x1
            if y1_64 > clip_y1: y1_64 = clip_y1
        val x0 = x0_64 as i32
        val y0 = y0_64 as i32
        val x1 = x1_64 as i32
        val y1 = y1_64 as i32
        if x1 <= x0 or y1 <= y0:
            return
        val mask_active = self.mask_buf.len() > 0
        var py = y0
        while py < y1:
            var px = x0
            while px < x1:
                val dst = self.buf[py * self.w + px]
                val dr = color_r(dst)
                val dg = color_g(dst)
                val db = color_b(dst)
                val da = color_a(dst)
                var rr = sr
                var rg = sg
                var rb = sb
                if mode == 1:
                    rr = sr * dr / 255
                    rg = sg * dg / 255
                    rb = sb * db / 255
                else if mode == 2:
                    rr = 255 - (255 - sr) * (255 - dr) / 255
                    rg = 255 - (255 - sg) * (255 - dg) / 255
                    rb = 255 - (255 - sb) * (255 - db) / 255
                else if mode == 3:
                    rr = _emu_overlay_ch(sr, dr)
                    rg = _emu_overlay_ch(sg, dg)
                    rb = _emu_overlay_ch(sb, db)
                else if mode == 4:
                    rr = sr + dr
                    rg = sg + dg
                    rb = sb + db
                    if rr > 255: rr = 255
                    if rg > 255: rg = 255
                    if rb > 255: rb = 255
                val out_r = dr + (rr - dr) * sa / 255
                val out_g = dg + (rg - dg) * sa / 255
                val out_b = db + (rb - db) * sa / 255
                var out_a = da
                if sa > out_a: out_a = sa
                val output = rgba(out_r, out_g, out_b, out_a)
                if mask_active:
                    self.sw_set_pixel(px, py, output)
                else:
                    self.buf[py * self.w + px] = output
                px = px + 1
            if not mask_active:
                self.mark_span_dirty(x0, py, x1 - x0)
            py = py + 1

impl SoftwareBackend:
    # Phase 1 fallback: paint the cell with `bg` first, then overlay the
    # glyph via the shared 5x7 raster. Tile dirty-tracking is preserved
    # because both calls route through the `self.*` helpers that already
    # mark tiles dirty.
    me draw_text_bg(x: i32, y: i32, text_val: text, fg: u32, bg: u32, font_size: i32):
        val text_buf = text_aa_blit_buffer(text_val, fg, bg, font_size)
        if text_buf.is_empty():
            return
        self.draw_image(x, y, text_buf.width, text_buf.height, text_buf.pixels)

    me draw_ellipse(cx: i32, cy: i32, rx: i32, ry: i32, color: u32):
        emu_draw_ellipse(self, cx, cy, rx, ry, color)

    me draw_ellipse_filled(cx: i32, cy: i32, rx: i32, ry: i32, color: u32):
        emu_draw_ellipse_filled(self, cx, cy, rx, ry, color)

# ============================================================================
# Pixel and Line Helpers — me methods to avoid mutation-loss bug
#
# The compiler silently drops mutations when `self` or `self.field` is passed
# to a free function. All helpers that write into `self.buf` or
# `self.dirty_tiles` are therefore `me` methods so that writes persist.
# Read-only helpers (_clip_span, _sw_mask_blocks, _sw_isqrt) remain free
# functions since they never mutate.
# See: doc/08_tracking/bug/self_pass_to_free_fn_mutation_loss_2026-05-29.md
# ============================================================================

impl SoftwareBackend:

    # GPU-dict pilot (design doc/05_design/ui/rendering/cpu_gpu_dual_algorithm_design.md
    # §3/§4): the CPU-lane oracle for `indexed_fill`. `idx` is a row-major w*h
    # byte buffer of palette indices; the body is a plain host array index
    # `palette[idx]` per pixel — no per-pixel FFI, this IS the bulk/native
    # CPU-lane idiom for a data-dependent gather (there is no memset-style bulk
    # form for a per-pixel table lookup). Out-of-range indices resolve to the
    # SAME 0xFFFFFFFF sentinel the Metal `lut_lookup` dense path returns on a
    # miss (design §3.2/§3.4) so the CPU and GPU stay bit-exact on the edge
    # case too — a defined, loud value, never a silent wrong pixel.
    # The two per-pixel gather loops below carry the cpu-lane-loop-ok annotation
    # on their HEADER lines — the hot-loop gate (design §6.1) exempts a loop only
    # via its header/line-above, never a def-line comment.
    me indexed_fill(x: i32, y: i32, w: i32, h: i32, idx: [u8], palette: [u32]):
        if w <= 0 or h <= 0:
            return
        val count = palette.len()
        var ly = 0
        while ly < h:  # cpu-lane-loop-ok: indexed_fill CPU-lane gather oracle (design §3/§4)
            val py = y + ly
            if py >= 0 and py < self.h:
                var start_x = -1
                var lx = 0
                while lx < w:  # cpu-lane-loop-ok: indexed_fill CPU-lane gather oracle (design §3/§4)
                    val px = x + lx
                    if px >= 0 and px < self.w:
                        val key = idx[ly * w + lx].to_i32()
                        var c: u32 = 0xFFFFFFFFu32
                        if key >= 0 and key < count:
                            c = palette[key]
                        self.buf[py * self.w + px] = c
                        if start_x < 0:
                            start_x = px
                    lx = lx + 1
                if start_x >= 0:
                    self.mark_span_dirty(start_x, py, w)
            ly = ly + 1

    me ensure_kernel_table():
        """Build the CpuKernelTable once, per-session, with an honest timing
        gate applied to EVERY size bucket (TINY/SMALL/MEDIUM/LARGE) and to
        EVERY op simd_span_batch_execute can dispatch to SIMD-ISA —
        fill_const, src_over_const, src_over_image, and mask_src_over — not
        just fill_const: each op only earns the KERNEL_PROVIDER_SIMD_ISA
        slot in a bucket if a real measurement (same pattern as
        simd_isa_provider_spec.spl) shows it both bit-exact against its
        scalar oracle and faster than that oracle, at a span length
        representative of that bucket, on this machine. If it is not faster
        in a bucket, that bucket's slot honestly stays scalar and
        simd_span_batch_execute's own fallback keeps output identical —
        small spans are expected to lose to SIMD's fixed call/setup
        overhead, and the gate must not force registration to pretend
        otherwise. All-scalar is a legitimate (and under the interpreter,
        the expected) outcome; the deliverable of this table is complete
        MEASUREMENT coverage, not SIMD wins."""
        if self.kernel_table_ready:
            return
        # (representative span length, iterations) per bucket. Small spans get
        # more iterations so the wall-clock measurement window is large
        # enough to be above timer-resolution noise. Probes MEASURE only and
        # return a verdict bitmask; registration happens HERE, on a LOCAL
        # table that is assigned to self.kernel_table once sealed. Both
        # indirections are deliberate: a mut table threaded through a probe
        # loses kernel_table_register's write-back, and so does registering
        # into self.kernel_table directly (self.field passed to a free fn —
        # doc/08_tracking/bug/self_pass_to_free_fn_mutation_loss_2026-05-29.md).
        # A local var -> free fn register is the one shape that persists;
        # the sealed local is then stored with a plain field assignment.
        # The bucket-spec's "owned-table registration persists" example
        # guards this exact shape.
        var table = kernel_table_new()
        var v: i64 = 0
        v = _kernel_probe_fill_bucket(8, 4000)
        kernel_table_register(table, KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_fill_bucket(32, 2000)
        kernel_table_register(table, KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_SMALL,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_fill_bucket(128, 500)
        kernel_table_register(table, KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_MEDIUM,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_fill_bucket(4096, 64)
        kernel_table_register(table, KERNEL_OP_FILL_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_LARGE,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        # Blend ops cost many times a fill per pixel under the interpreter
        # (gather + blend + scatter), so their probe iteration counts are
        # scaled down hard to keep total table-build time in the same order
        # as the fill probes while still measuring well above timer
        # resolution (each timing window stays in the multi-ms range).
        v = _kernel_probe_src_over_const_bucket(8, 75)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_const_bucket(32, 40)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_SMALL,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_const_bucket(128, 10)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_MEDIUM,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_const_bucket(1024, 2)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_CONST, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_LARGE,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_image_bucket(8, 75)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_IMAGE, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_image_bucket(32, 40)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_IMAGE, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_SMALL,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_image_bucket(128, 10)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_IMAGE, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_MEDIUM,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_src_over_image_bucket(1024, 2)
        kernel_table_register(table, KERNEL_OP_SRC_OVER_IMAGE, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_LARGE,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_mask_src_over_bucket(8, 75)
        kernel_table_register(table, KERNEL_OP_MASK_SRC_OVER, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_TINY,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_mask_src_over_bucket(32, 40)
        kernel_table_register(table, KERNEL_OP_MASK_SRC_OVER, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_SMALL,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_mask_src_over_bucket(128, 10)
        kernel_table_register(table, KERNEL_OP_MASK_SRC_OVER, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_MEDIUM,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        v = _kernel_probe_mask_src_over_bucket(1024, 2)
        kernel_table_register(table, KERNEL_OP_MASK_SRC_OVER, KERNEL_FORMAT_ARGB8888_STRAIGHT,
                              KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS, KERNEL_BUCKET_LARGE,
                              KERNEL_PROVIDER_SIMD_ISA, (v & KERNEL_PROBE_EXACT) != 0, (v & KERNEL_PROBE_FASTER) != 0)
        kernel_table_seal(table)
        self.kernel_table = table
        self.kernel_table_ready = true

    me sw_fill_raw_span(offset: i32, raw_count: i32, color: u32):
        val count = _span_safe_count(self.buf.len(), offset, raw_count)
        if count <= 0:
            return
        if self.native_simd_spans and native_pixel_rows_enabled():
            self.ensure_kernel_table()
            record_simd_fill_hit()
            var batch = span_batch_new(1)
            span_batch_push(batch, KERNEL_OP_FILL_CONST, offset as i64, 0, count as i64, color as i64, 0)
            val empty_u32: [u32] = []
            val executed = simd_span_batch_execute(batch, self.buf, empty_u32, empty_u32, self.kernel_table,
                                                   KERNEL_FORMAT_ARGB8888_STRAIGHT, KERNEL_ALIGN_UNKNOWN, KERNEL_SPAN_CONTIGUOUS)
            self.simd_batch_hits = self.simd_batch_hits + batch.non_scalar_lookups
            if executed == batch.length:
                return
            # Batch dispatcher refused (shouldn't happen for a single valid op) —
            # fall back to the direct native call rather than leave the span unfilled.
            self.buf = rt_engine2d_simd_fill_span_u32(self.buf, offset as i64, count as i64, color)
            return
        _scalar_fill_row(self.buf, offset as i64, count as i64, color)

    me sw_copy_raw_span(dst_offset: i32, src: [u32], src_offset: i32, count: i32):
        val safe_count = _span_copy_safe_count(self.buf.len(), dst_offset, src.len(), src_offset, count)
        if safe_count <= 0:
            return
        if self.native_simd_spans and native_pixel_rows_enabled():
            record_simd_copy_hit()
            self.buf = rt_engine2d_simd_copy_span_u32(self.buf, dst_offset as i64, src, src_offset as i64, safe_count as i64)
            return
        var i = 0
        # cpu-lane-loop-ok: scalar fallback inside sw_copy_raw_span itself, taken only when rt_engine2d_simd_copy_span_u32 is unavailable; this IS the bulk span primitive
        while i < safe_count:
            self.buf[dst_offset + i] = src[src_offset + i]
            i = i + 1

    me sw_blend_const_raw_span(offset: i32, count: i32, color: u32):
        val safe_count = _span_safe_count(self.buf.len(), offset, count)
        if safe_count <= 0:
            return
        if self.native_simd_spans and native_pixel_rows_enabled():
            record_simd_alpha_hit()
            self.buf = rt_engine2d_simd_blend_const_span_u32(
                self.buf, offset.to_i64(), safe_count.to_i64(), color.to_i64())
            return
        var i = 0
        # cpu-lane-loop-ok: scalar fallback inside sw_blend_const_raw_span when SIMD spans are unavailable; this IS the bulk span primitive
        while i < safe_count:
            self.buf[offset + i] = blend(color, self.buf[offset + i])
            i = i + 1

    me mark_dirty(tx: i32, ty: i32):
        """Mark a tile as dirty."""
        val idx = ty * self.tiles_x + tx
        if idx >= 0 and idx < self.dirty_tiles.len():
            self.dirty_tiles[idx] = true

    me mark_pixel_dirty(x: i32, y: i32):
        """Mark the tile containing pixel (x, y) as dirty."""
        val tx = x / TILE_SIZE
        val ty = y / TILE_SIZE
        self.mark_dirty(tx, ty)

    me mark_span_dirty(x: i32, y: i32, length: i32):
        """Mark all tiles touched by a horizontal span."""
        if length <= 0:
            return
        val tx0 = x / TILE_SIZE
        val tx1 = (x + length - 1) / TILE_SIZE
        val ty = y / TILE_SIZE
        var tx = tx0
        while tx <= tx1:
            self.mark_dirty(tx, ty)
            tx = tx + 1

    # ========================================================================
    # WS-D3 — damage query + frame-persistent mirror
    # ========================================================================

    me damage_rects(max_rects: i32) -> [i32]:
        """Damage as a flat [x,y,w,h, x,y,w,h, ...] i32 array, pixel units.

        Flat i32 (not a struct array) on purpose: struct-valued containers hit
        the native-codegen Dict/struct pitfalls documented in code-style.md,
        and a flat array is trivially assertable from a spec.

        Scan is row-major over the tile grid, emitting one rect per run of
        horizontally-adjacent dirty tiles, then merging vertically-stacked runs
        that share x and w. Past `max_rects` the set collapses to its single
        bounding rect; if the bound covers >60% of the surface the whole
        surface is returned as one rect (a partial path costing more than the
        full copy is a loss).

        This does NOT clear damage — present() remains the single clear owner.
        """
        var out: [i32] = []
        if self.tiles_x <= 0 or self.tiles_y <= 0:
            return out
        var cap = max_rects
        if cap <= 0:
            cap = 16
        # Output tuple indices for the prior tile row.  Keeping every active
        # run (rather than only inspecting the last emitted rectangle) lets
        # separated columns extend vertically without fragmenting damage.
        var prev_x: [i32] = []
        var prev_w: [i32] = []
        var prev_out: [i32] = []
        var ty = 0
        while ty < self.tiles_y:
            var curr_x: [i32] = []
            var curr_w: [i32] = []
            var curr_out: [i32] = []
            var prev_cursor = 0
            val y0 = ty * TILE_SIZE
            var y1 = y0 + TILE_SIZE
            if y1 > self.h:
                y1 = self.h
            var tx = 0
            while tx < self.tiles_x:
                if self.dirty_tiles[ty * self.tiles_x + tx]:
                    var run_end = tx
                    while run_end < self.tiles_x and self.dirty_tiles[ty * self.tiles_x + run_end]:
                        run_end = run_end + 1
                    val x0 = tx * TILE_SIZE
                    var x1 = run_end * TILE_SIZE
                    if x1 > self.w:
                        x1 = self.w
                    val rw = x1 - x0
                    val rh = y1 - y0
                    if rw > 0 and rh > 0:
                        var merged = false
                        var output_index = -1
                        # Both row run lists are x-sorted, so one monotonic
                        # cursor finds exact predecessor runs in linear time.
                        while prev_cursor < prev_x.len() and prev_x[prev_cursor] < x0:
                            prev_cursor += 1
                        if prev_cursor < prev_x.len() and prev_x[prev_cursor] == x0 and prev_w[prev_cursor] == rw:
                            output_index = prev_out[prev_cursor]
                            out[output_index + 3] = out[output_index + 3] + rh
                            merged = true
                        if not merged:
                            output_index = out.len()
                            out.push(x0)
                            out.push(y0)
                            out.push(rw)
                            out.push(rh)
                        curr_x.push(x0)
                        curr_w.push(rw)
                        curr_out.push(output_index)
                    tx = run_end
                else:
                    tx = tx + 1
            prev_x = curr_x
            prev_w = curr_w
            prev_out = curr_out
            ty = ty + 1
        val rect_count = out.len() / 4
        if rect_count == 0:
            return out
        # Bounding rect of everything we emitted.
        var bx0 = out[0]
        var by0 = out[1]
        var bx1 = out[0] + out[2]
        var by1 = out[1] + out[3]
        var r = 1
        while r < rect_count:
            val o = r * 4
            if out[o] < bx0:
                bx0 = out[o]
            if out[o + 1] < by0:
                by0 = out[o + 1]
            if out[o] + out[o + 2] > bx1:
                bx1 = out[o] + out[o + 2]
            if out[o + 1] + out[o + 3] > by1:
                by1 = out[o + 1] + out[o + 3]
            r = r + 1
        # 8K areas multiplied by a percentage exceed i32.  Widen before every
        # multiply so the full/local decision is deterministic at large sizes.
        val bound_area = (bx1 - bx0).to_i64() * (by1 - by0).to_i64()
        val surface_area = self.w.to_i64() * self.h.to_i64()
        # Compare against floor(3/5 surface) without cross-multiplication;
        # even the largest positive i32 dimensions cannot overflow this form.
        val full_threshold = (surface_area / 5) * 3 + ((surface_area % 5) * 3) / 5
        if surface_area > 0 and bound_area > full_threshold:
            return [0, 0, self.w, self.h]
        if rect_count > cap:
            return [bx0, by0, bx1 - bx0, by1 - by0]
        out

    me damage_is_empty() -> bool:
        """True when no tile is marked dirty (a no-op frame)."""
        val n = self.dirty_tiles.len()
        var i = 0
        while i < n:
            if self.dirty_tiles[i]:
                return false
            i = i + 1
        true

    me read_pixels_damaged(max_rects: i32) -> [u32]:
        """Damage-driven readback into a frame-persistent mirror.

        Unlike read_pixels(), which walks all w*h pixels every frame, this
        refreshes only the damaged rects of a mirror retained across frames.
        The mirror is seeded in full the first time (and on any surface resize),
        so the very first call costs exactly what read_pixels() costs.

        CALLER CONTRACT: the returned array is the backend's own mirror, not a
        fresh copy (that is the entire point -- see read_pixels() if you need
        an independent snapshot). Treat it as read-only and valid only until
        the next read_pixels_damaged()/shutdown() call.
        """
        val pixel_count = self.w * self.h
        if pixel_count <= 0:
            return []
        if not self.mirror_valid or self.mirror.len() != pixel_count:
            var seed: [u32] = [0; pixel_count]
            var s = 0
            while s < pixel_count:
                seed[s] = self.buf[s]
                s = s + 1
            self.mirror = seed
            self.mirror_valid = true
            return self.mirror
        val rects = self.damage_rects(max_rects)
        val rect_count = rects.len() / 4
        var r = 0
        while r < rect_count:
            val o = r * 4
            val rx = rects[o]
            val ry = rects[o + 1]
            val rw = rects[o + 2]
            val rh = rects[o + 3]
            var row = 0
            while row < rh:
                val base = (ry + row) * self.w + rx
                var c = 0
                # cpu-lane-loop-ok: per-damaged-row span copy; this IS the bulk
                # idiom for the boxed-pixel buffer (8 B/px, no memcpy available)
                while c < rw:
                    self.mirror[base + c] = self.buf[base + c]
                    c = c + 1
                row = row + 1
            r = r + 1
        self.mirror

    me invalidate_mirror():
        """Drop the frame-persistent mirror; the next damaged read reseeds."""
        self.mirror = []
        self.mirror_valid = false

    me sw_set_pixel(x: i32, y: i32, color: u32):
        if x < 0 or y < 0 or x >= self.w or y >= self.h:
            return
        if self.clip_enabled:
            if (x < self.clip_x or x >= self.clip_x + self.clip_w or
                y < self.clip_y or y >= self.clip_y + self.clip_h):
                return
        if _sw_mask_blocks(self, x, y):
            return
        val idx = y * self.w + x
        self.buf[idx] = color
        self.mark_pixel_dirty(x, y)

    me sw_set_pixel_blend(x: i32, y: i32, color: u32):
        if x < 0 or y < 0 or x >= self.w or y >= self.h:
            return
        if self.clip_enabled:
            if (x < self.clip_x or x >= self.clip_x + self.clip_w or
                y < self.clip_y or y >= self.clip_y + self.clip_h):
                return
        if _sw_mask_blocks(self, x, y):
            return
        val idx = y * self.w + x
        self.buf[idx] = blend(color, self.buf[idx])
        self.mark_pixel_dirty(x, y)

    me sw_hline(x: i32, y: i32, length: i32, color: u32):
        val clipped = _clip_span(self, x, y, length)
        val count = clipped.2
        if count <= 0:
            return
        val mask_active = self.mask_buf.len() > 0
        if mask_active:
            var xoff = 0
            while xoff < count:
                self.sw_set_pixel(clipped.0 + xoff, y, color)
                xoff = xoff + 1
            return
        val off = y * self.w + clipped.0
        self.sw_fill_raw_span(off, count, color)
        self.mark_span_dirty(clipped.0, y, count)

    me sw_hline_blend(x: i32, y: i32, length: i32, color: u32):
        val clipped = _clip_span(self, x, y, length)
        val count = clipped.2
        if count <= 0:
            return
        val mask_active = self.mask_buf.len() > 0
        if mask_active:
            var xoff = 0
            while xoff < count:
                self.sw_set_pixel_blend(clipped.0 + xoff, y, color)
                xoff = xoff + 1
            return
        val off = y * self.w + clipped.0
        self.sw_blend_const_raw_span(off, count, color)
        self.mark_span_dirty(clipped.0, y, count)

    me sw_vline(x: i32, y: i32, length: i32, color: u32):
        var i = 0
        while i < length:
            self.sw_set_pixel(x, y + i, color)
            i = i + 1

    me sw_bresenham(x1: i32, y1: i32, x2: i32, y2: i32, color: u32):
        var dx = x2 - x1
        var dy = y2 - y1
        var sx: i32 = 1
        var sy: i32 = 1
        if dx < 0:
            dx = -dx
            sx = -1
        if dy < 0:
            dy = -dy
            sy = -1
        var err = dx - dy
        var cx = x1
        var cy = y1
        while true:
            self.sw_set_pixel(cx, cy, color)
            if cx == x2 and cy == y2:
                return
            val e2 = 2 * err
            if e2 > -dy:
                err = err - dy
                cx = cx + sx
            if e2 < dx:
                err = err + dx
                cy = cy + sy

    me sw_corner_arc(cx: i32, cy: i32, r: i32, color: u32, sx: i32, sy: i32):
        var px = r
        var py = 0
        var d = 1 - r
        while px >= py:
            self.sw_set_pixel(cx + px * sx, cy + py * sy, color)
            self.sw_set_pixel(cx + py * sx, cy + px * sy, color)
            py = py + 1
            if d <= 0:
                d = d + 2 * py + 1
            else:
                px = px - 1
                d = d + 2 * py - 2 * px + 1

# ============================================================================
# Read-only span helpers (no mutation — safe as free functions)
# ============================================================================

fn _span_safe_count(buf_len: i32, offset: i32, count: i32) -> i32:
    if buf_len <= 0 or offset < 0 or count <= 0:
        return 0
    if offset >= buf_len:
        return 0
    val remaining = (buf_len - offset).to_i64()
    val safe_count = if count.to_i64() < remaining: count.to_i64() else: remaining
    if safe_count > 2147483647:
        return 2147483647
    safe_count.to_i32()

fn _span_copy_safe_count(dst_len: i32, dst_offset: i32, src_len: i32, src_offset: i32, count: i32) -> i32:
    val dst_count = _span_safe_count(dst_len, dst_offset, count)
    if dst_count <= 0:
        return 0
    if src_len <= 0 or src_offset < 0:
        return 0
    if src_offset >= src_len:
        return 0
    val src_remaining = (src_len - src_offset).to_i64()
    val cnt = dst_count.to_i64()
    if cnt < src_remaining:
        return dst_count
    src_remaining.to_i32()

fn _clip_span(backend: SoftwareBackend, x: i32, y: i32, length: i32) -> (i32, i32, i32):
    """Clip a horizontal span to framebuffer and active clip rectangle.

    Returns (start_x, end_x_exclusive, count). A zero count means no pixels
    should be touched.
    """
    if length <= 0 or y < 0 or y >= backend.h:
        return (0, 0, 0)
    var start = x
    var end = x + length
    if start < 0:
        start = 0
    if end > backend.w:
        end = backend.w
    if backend.clip_enabled:
        if y < backend.clip_y or y >= backend.clip_y + backend.clip_h:
            return (0, 0, 0)
        if start < backend.clip_x:
            start = backend.clip_x
        val clip_end = backend.clip_x + backend.clip_w
        if end > clip_end:
            end = clip_end
    if end <= start:
        return (0, 0, 0)
    (start, end, end - start)

fn _sw_mask_blocks(backend: SoftwareBackend, x: i32, y: i32) -> bool:
    if backend.mask_buf.len() == 0:
        return false
    val mi = y * backend.mask_w + x
    if mi < 0 or mi >= backend.mask_buf.len():
        return false
    backend.mask_buf[mi] == 0u8

# ============================================================================
# Triangle Edge Interpolation
# ============================================================================

# Integer floor square root (Newton). Used by draw_circle_filled to compute the
# per-row span half-width that matches the Metal distance test exactly.
fn _sw_isqrt(n: i32) -> i32:
    if n <= 0:
        return 0
    var x = n
    var y = (x + 1) / 2
    while y < x:
        x = y
        y = (x + n / x) / 2
    x
