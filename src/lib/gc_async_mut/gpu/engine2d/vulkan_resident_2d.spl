pub val ENGINE2D_VULKAN_RESIDENT_GATE_REASON: text = "needs SIMPLE_GPU_TEST=1 and a Vulkan device whose session initialises"
pub val ENGINE2D_VULKAN_MAX_SCENE_PAYLOAD_BYTES: i64 = 2147483648

val _ENGINE2D_VULKAN_STORAGE_BUFFER: i64 = 0x80
val _ENGINE2D_VULKAN_SCENE_PROOF_BYTES: i64 = 4
val _ENGINE2D_VULKAN_FENCE_WAIT_NS: i64 = 1000000000
val _ENGINE2D_VULKAN_MAX_PENDING_FENCES: i64 = 16

# Environment variable carrying the exact identity of the running binary. It is
# the only binary-identity source in the tree (`dual_run_binary_identity` reads
# the same key); when it is unset the evidence field stays EMPTY so that
# `engine2d_gpu_device_evidence_qualifies` refuses, which is the honest result.
pub val ENGINE2D_VULKAN_BINARY_IDENTITY_ENV: text = "SIMPLE_BINARY_IDENTITY"

# The capabilities an initialised VulkanSession genuinely has: compute passes
# (its pipelines are compute pipelines) and indirect dispatch
# (vkCmdDispatchIndirect is Vulkan 1.0 core). Exactly the pair the resident
# profile requires. The device-generated-command / work-graph bits are NOT
# claimed here: nothing in this tree probes for them.
pub val ENGINE2D_VULKAN_CORE_CAPABILITIES: u32 = DRAW_IR_V3_CAP_COMPUTE_PASSES + DRAW_IR_V3_CAP_INDIRECT_DISPATCH

struct Engine2dVulkanResidentFrame:
    """One frame's outcome: the epoch receipt plus the arena facts it was admitted under."""
    receipt: Engine2dGpuEpochReceipt
    admitted: bool
    store_reason: u16
    generation: u64
    scene_identity: u64

struct Engine2dVulkanResidentSliceReport:
    frames_requested: i64
    frames_submitted: i64
    semantic_rebuilds: i64
    readbacks: i64
    session_initialised: bool
    init_error: text
    device_name: text
    device_type: text
    driver_identity: text
    negative_control_passed: bool
    evidence_qualifies: bool
    device_execution_proven: bool
    last_phase: text
    submit_failures: i64
    device_scene_uploads: i64
    device_scene_upload_bytes: i64
    device_scene_reuses: i64
    device_scene_upload_failures: i64
    device_scene_allocations: i64
    device_scene_releases: i64
    device_scene_release_failures: i64
    device_scene_blocking_upload_calls: i64
    blocking_queue_submit_calls: i64
    device_scene_descriptor_binds: i64
    device_scene_dispatches: i64
    device_scene_nonblocking_submits: i64
    device_scene_fence_waits: i64
    device_scene_shader_consumed: bool
    device_scene_proof_readbacks: i64
    device_scene_proof_initializations: i64
    device_scene_proof_init_bytes: i64
    device_scene_shader: i64
    device_scene_pipeline: i64
    device_scene_descriptor: i64
    device_scene_descriptor_ready: bool
    device_scene_bound_identity: u64
    device_scene_proof_buffer: i64
    device_scene_proof_checksum: [u8]
    device_scene_fences: [i64]
    host_submit_ns: i64
    host_complete_ns: i64
    summary: text

class Engine2dVulkanResidentArena:
    """A fixed, never-grown packed-generation arena driving the resident slice.

    The caller is the sole mutable owner. The class and the process-global
    Vulkan SFFI context provide no cross-task synchronization, so this arena
    must not be shared between concurrent tasks. `scene_rows` crosses the
    device boundary as an encoded copy; `device_scene_rows` is a private exact
    snapshot used only to prevent hash-collision reuse.
    """
    store: DrawIrPackedGenerationStoreV3
    arena_id: u64
    arena_generation: u64
    frames_submitted: i64
    semantic_rebuilds: i64
    readbacks: i64
    last_scene_identity: u64
    last_scene_rows: [u64]
    # One published storage-buffer handle owns the packed scene rows. A larger
    # replacement is uploaded before the old handle is released and published;
    # identical frames reuse the current handle without crossing the boundary.
    device_scene_capacity_rows: i64
    device_scene_buffer: i64
    device_scene_buffer_capacity_bytes: i64
    device_scene_identity: u64
    device_scene_rows: [u64]
    device_scene_uploads: i64
    device_scene_upload_bytes: i64
    device_scene_reuses: i64
    device_scene_upload_failures: i64
    device_scene_allocations: i64
    device_scene_releases: i64
    device_scene_release_failures: i64
    device_scene_blocking_upload_calls: i64
    blocking_queue_submit_calls: i64
    device_scene_descriptor_binds: i64
    device_scene_dispatches: i64
    device_scene_nonblocking_submits: i64
    device_scene_fence_waits: i64
    device_scene_shader_consumed: bool
    device_scene_proof_readbacks: i64
    device_scene_proof_initializations: i64
    device_scene_proof_init_bytes: i64
    device_scene_proof_needs_reset: bool
    device_scene_shader: i64
    device_scene_pipeline: i64
    device_scene_descriptor: i64
    device_scene_bound_identity: u64
    device_scene_proof_buffer: i64
    device_scene_proof_checksum: [u8]
    device_scene_fences: [i64]

fn engine2d_vulkan_resident_scene_identity(rows: [u64]) -> u64:
    """Bounded rows-only prefilter: no growing text and no arithmetic overflow.

    The store's own sealed `content_hash` folds the per-admission generation in
    and therefore differs for two identical scenes. This fold is stable across
    frames but is collision-prone by construction, so exact retained rows make
    every reuse and semantic-change decision.
    """
    var mixed = 0xcbf29ce484222325u64 ^ (rows.len() as u64)
    var i = 0
    while i < rows.len():
        mixed = ((mixed << 7u64) | (mixed >> 57u64)) ^ (rows[i] ^ 0x9e3779b97f4a7c15u64)
        i = i + 1
    mixed

fn engine2d_vulkan_resident_arena(arena_id: u64, slot_count: u32, rows_per_slot: u32, queue_capacity: u32) -> Engine2dVulkanResidentArena:
    """Create the bounded packed-row arena once; its store has no grow path."""
    Engine2dVulkanResidentArena(
        store: DrawIrPackedGenerationStoreV3.bounded(arena_id, slot_count, rows_per_slot, queue_capacity),
        arena_id: arena_id,
        arena_generation: 1u64,
        frames_submitted: 0,
        semantic_rebuilds: 0,
        readbacks: 0,
        last_scene_identity: 0u64,
        last_scene_rows: [],
        device_scene_capacity_rows: rows_per_slot as i64,
        device_scene_buffer: 0,
        device_scene_buffer_capacity_bytes: 0,
        device_scene_identity: 0u64,
        device_scene_rows: [],
        device_scene_uploads: 0,
        device_scene_upload_bytes: 0,
        device_scene_reuses: 0,
        device_scene_upload_failures: 0,
        device_scene_allocations: 0,
        device_scene_releases: 0,
        device_scene_release_failures: 0,
        device_scene_blocking_upload_calls: 0,
        blocking_queue_submit_calls: 0,
        device_scene_descriptor_binds: 0,
        device_scene_dispatches: 0,
        device_scene_nonblocking_submits: 0,
        device_scene_fence_waits: 0,
        device_scene_shader_consumed: false,
        device_scene_proof_readbacks: 0,
        device_scene_proof_initializations: 0,
        device_scene_proof_init_bytes: 0,
        device_scene_proof_needs_reset: false,
        device_scene_shader: 0,
        device_scene_pipeline: 0,
        device_scene_descriptor: 0,
        device_scene_descriptor_ready: false,
        device_scene_bound_identity: 0u64,
        device_scene_proof_buffer: 0,
        device_scene_proof_checksum: [],
        device_scene_fences: []
    )

fn engine2d_vulkan_resident_scene_payload(rows: [u64]) -> [u8]:
    """Pack each authoritative u64 row as eight little-endian bytes."""
    if rows.len() <= 0 or rows.len() > ENGINE2D_VULKAN_MAX_SCENE_PAYLOAD_BYTES / 8:
        return []
    var payload: [u8] = [0u8; rows.len() * 8]
    var offset = 0
    for row in rows:
        val encoded = u64_to_bytes_le(row)
        for byte in encoded:
            payload[offset] = byte
            offset = offset + 1
    payload

fn _engine2d_vulkan_resident_scene_snapshot(rows: [u64]) -> [u64]:
    var snapshot: [u64] = [0u64; rows.len()]
    var i = 0
    while i < rows.len():
        snapshot[i] = rows[i]
        i = i + 1
    snapshot

fn _engine2d_vulkan_resident_scene_rows_equal(left: [u64], right: [u64]) -> bool:
    if left.len() != right.len():
        return false
    var i = 0
    while i < left.len():
        if left[i] != right[i]:
            return false
        i = i + 1
    true

fn _engine2d_vulkan_resident_scene_proof_checksum(rows: [u64]) -> [u8]:
    """Return the checksum written by the resident-consumer shader.

    The shader consumes the packed u32 words, not the host u64 values. Keeping
    this oracle byte-identical to `engine2d_vulkan_resident_scene_payload`
    makes a proof-buffer readback a collision-limited data-consumption check.
    """
    var checksum = 2166136261u64
    for row in rows:
        val encoded = u64_to_bytes_le(row)
        var offset = 0
        while offset < encoded.len():
            val word = (encoded[offset] as u64) |
                ((encoded[offset + 1] as u64) << 8) |
                ((encoded[offset + 2] as u64) << 16) |
                ((encoded[offset + 3] as u64) << 24)
            checksum = (checksum ^ word) * 16777619u64
            offset = offset + 4
    u32_to_bytes_le((checksum & 0xFFFFFFFFu64).to_u32())

fn engine2d_vulkan_resident_scene_proof_checksum(rows: [u64]) -> [u8]:
    _engine2d_vulkan_resident_scene_proof_checksum(rows)

fn _engine2d_vulkan_resident_bytes_equal(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len():
        return false
    var i = 0
    while i < left.len():
        if left[i] != right[i]:
            return false
        i = i + 1
    true

impl Engine2dVulkanResidentArena:
    me retire_scene_fences() -> bool:
        """Wait and release only the fences owned by this scene ring.

        The provider's historical `submit_and_wait_fence` waits internally
        before returning. The arena still owns the returned fence handles and
        releases them at a bounded batch, scene mutation, or shutdown boundary.
        """
        var remaining: [i64] = []
        var all_retired = true
        for fence in self.device_scene_fences:
            self.device_scene_fence_waits = self.device_scene_fence_waits + 1
            if vulkan_sffi_wait_fence(fence, _ENGINE2D_VULKAN_FENCE_WAIT_NS):
                if not vulkan_sffi_destroy_fence(fence):
                    remaining.push(fence)
                    all_retired = false
            else:
                remaining.push(fence)
                all_retired = false
        self.device_scene_fences = remaining
        all_retired

    me ensure_scene_consumer(rows: [u64]) -> bool:
        """Bind the retained scene buffer to the real checksum shader.

        The four-byte proof is a collision-limited diagnostic, not an exact
        content identity and not device-admission evidence. Resetting it to the
        checksum complement once per scene upload prevents an untouched or
        stale proof allocation from passing without adding a per-frame upload.
        """
        if self.device_scene_buffer <= 0 or not vulkan_sffi_fence_submission_supported():
            return false
        if self.device_scene_descriptor > 0 and not self.device_scene_descriptor_ready:
            if not vulkan_sffi_destroy_descriptor_set(self.device_scene_descriptor):
                return false
            self.device_scene_descriptor = 0
        if self.device_scene_proof_buffer <= 0:
            self.device_scene_proof_buffer = vulkan_sffi_alloc_buffer(_ENGINE2D_VULKAN_SCENE_PROOF_BYTES, _ENGINE2D_VULKAN_STORAGE_BUFFER)
            if self.device_scene_proof_buffer <= 0:
                return false
            self.device_scene_proof_needs_reset = true
        if self.device_scene_shader <= 0:
            self.device_scene_shader = vulkan_sffi_compile_spirv(spirv_resident_scene_consume())
            if self.device_scene_shader <= 0:
                return false
        if self.device_scene_pipeline <= 0:
            self.device_scene_pipeline = vulkan_sffi_create_compute_pipeline(self.device_scene_shader, "main", 4)
            if self.device_scene_pipeline <= 0:
                return false
        if self.device_scene_descriptor <= 0:
            val desc = vulkan_sffi_create_descriptor_set(self.device_scene_pipeline)
            if desc <= 0:
                return false
            self.device_scene_descriptor = desc
            self.device_scene_descriptor_ready = false
            if not vulkan_sffi_bind_buffer(desc, 1, self.device_scene_proof_buffer):
                if vulkan_sffi_destroy_descriptor_set(desc):
                    self.device_scene_descriptor = 0
                return false
            if not vulkan_sffi_bind_buffer(desc, 0, self.device_scene_buffer):
                if vulkan_sffi_destroy_descriptor_set(desc):
                    self.device_scene_descriptor = 0
                return false
            self.device_scene_descriptor_ready = true
            self.device_scene_bound_identity = self.device_scene_identity
            self.device_scene_descriptor_binds = self.device_scene_descriptor_binds + 1
        elif self.device_scene_bound_identity != self.device_scene_identity:
            if not vulkan_sffi_bind_buffer(self.device_scene_descriptor, 0, self.device_scene_buffer):
                return false
            self.device_scene_bound_identity = self.device_scene_identity
            self.device_scene_descriptor_binds = self.device_scene_descriptor_binds + 1
        self.device_scene_proof_checksum = _engine2d_vulkan_resident_scene_proof_checksum(rows)
        if self.device_scene_proof_needs_reset:
            var sentinel: [u8] = [0u8; _ENGINE2D_VULKAN_SCENE_PROOF_BYTES]
            var i = 0
            while i < sentinel.len():
                sentinel[i] = self.device_scene_proof_checksum[i] ^ 0xFFu8
                i = i + 1
            self.device_scene_blocking_upload_calls = self.device_scene_blocking_upload_calls + 1
            if not vulkan_sffi_copy_to_buffer(self.device_scene_proof_buffer, sentinel, 0):
                return false
            self.device_scene_proof_initializations = self.device_scene_proof_initializations + 1
            self.device_scene_proof_init_bytes = self.device_scene_proof_init_bytes + _ENGINE2D_VULKAN_SCENE_PROOF_BYTES
            self.device_scene_proof_needs_reset = false
        true

    me dispatch_scene(rows: [u64]) -> bool:
        """Record one genuine descriptor-backed scene-consumer dispatch."""
        # Keep native command/fence ownership bounded for arbitrarily long
        # diagnostic runs. The common 16-frame fixture fills one batch and
        # retires it once after the loop; longer runs retire between batches.
        if self.device_scene_fences.len() >= _ENGINE2D_VULKAN_MAX_PENDING_FENCES:
            if not self.retire_scene_fences():
                return false
        if not self.ensure_scene_consumer(rows):
            return false
        val cmd = vulkan_sffi_begin_compute()
        if cmd <= 0:
            return false
        var ready = vulkan_sffi_bind_pipeline(cmd, self.device_scene_pipeline)
        if ready:
            ready = vulkan_sffi_bind_descriptors(cmd, self.device_scene_descriptor)
        if ready:
            ready = vulkan_sffi_push_constants(cmd, self.device_scene_pipeline, u32_to_bytes_le((rows.len() * 2) as u32))
        if ready:
            ready = vulkan_sffi_dispatch(cmd, 1, 1, 1)
        if ready:
            ready = vulkan_sffi_end_compute(cmd)
        if not ready:
            # The command never transferred to the queue, so it remains the
            # caller's owned command and can be discarded immediately.
            val discarded = vulkan_sffi_discard_command(cmd)
            return false
        self.blocking_queue_submit_calls = self.blocking_queue_submit_calls + 1
        val fence = vulkan_sffi_submit_and_wait_fence(cmd)
        if fence <= 0:
            return false
        self.device_scene_fences.push(fence)
        self.device_scene_dispatches = self.device_scene_dispatches + 1
        true

    me release_scene_consumer() -> bool:
        if not self.retire_scene_fences():
            return false
        var released = true
        if self.device_scene_descriptor > 0:
            val descriptor_released = vulkan_sffi_destroy_descriptor_set(self.device_scene_descriptor)
            if descriptor_released:
                self.device_scene_descriptor = 0
                self.device_scene_descriptor_ready = false
            released = descriptor_released and released
        if self.device_scene_proof_buffer > 0:
            val proof_released = vulkan_sffi_free_buffer(self.device_scene_proof_buffer)
            if proof_released:
                self.device_scene_proof_buffer = 0
            released = proof_released and released
        if self.device_scene_pipeline > 0:
            val pipeline_released = vulkan_sffi_destroy_pipeline(self.device_scene_pipeline)
            if pipeline_released:
                self.device_scene_pipeline = 0
            released = pipeline_released and released
        if self.device_scene_shader > 0:
            val shader_released = vulkan_sffi_destroy_shader(self.device_scene_shader)
            if shader_released:
                self.device_scene_shader = 0
            released = shader_released and released
        released

    me device_scene_matches(rows: [u64]) -> bool:
        """Exact collision-safe match against the bytes represented on device."""
        if self.device_scene_buffer <= 0 or rows.len() != self.device_scene_rows.len():
            return false
        if engine2d_vulkan_resident_scene_identity(rows) != self.device_scene_identity:
            return false
        _engine2d_vulkan_resident_scene_rows_equal(rows, self.device_scene_rows)

    me upload_scene_if_changed(rows: [u64]) -> bool:
        """Upload changed scene rows into one retained storage buffer.

        This method is intentionally device-only: unit callers can continue to
        exercise the fixed arena without a Vulkan runtime. A failed allocation
        or copy never leaves partially written bytes eligible for reuse.
        """
        if rows.len() <= 0 or rows.len() > self.device_scene_capacity_rows:
            self.device_scene_upload_failures = self.device_scene_upload_failures + 1
            return false
        if self.device_scene_matches(rows):
            self.device_scene_reuses = self.device_scene_reuses + 1
            return true
        if not self.retire_scene_fences():
            self.device_scene_upload_failures = self.device_scene_upload_failures + 1
            return false
        val payload = engine2d_vulkan_resident_scene_payload(rows)
        if payload.len() == 0:
            self.device_scene_upload_failures = self.device_scene_upload_failures + 1
            return false
        val bytes = payload.len().to_i64()
        val identity = engine2d_vulkan_resident_scene_identity(rows)
        if self.device_scene_buffer <= 0 or self.device_scene_buffer_capacity_bytes < bytes:
            val fresh = vulkan_sffi_alloc_buffer(bytes, _ENGINE2D_VULKAN_STORAGE_BUFFER)
            if fresh <= 0:
                self.device_scene_upload_failures = self.device_scene_upload_failures + 1
                return false
            self.device_scene_allocations = self.device_scene_allocations + 1
            self.device_scene_blocking_upload_calls = self.device_scene_blocking_upload_calls + 1
            if not vulkan_sffi_copy_to_buffer(fresh, payload, 0):
                if vulkan_sffi_free_buffer(fresh):
                    self.device_scene_releases = self.device_scene_releases + 1
                else:
                    self.device_scene_release_failures = self.device_scene_release_failures + 1
                self.device_scene_upload_failures = self.device_scene_upload_failures + 1
                return false
            if self.device_scene_buffer > 0:
                if not vulkan_sffi_free_buffer(self.device_scene_buffer):
                    self.device_scene_release_failures = self.device_scene_release_failures + 1
                    if vulkan_sffi_free_buffer(fresh):
                        self.device_scene_releases = self.device_scene_releases + 1
                    else:
                        self.device_scene_release_failures = self.device_scene_release_failures + 1
                    self.device_scene_upload_failures = self.device_scene_upload_failures + 1
                    return false
                self.device_scene_releases = self.device_scene_releases + 1
            self.device_scene_buffer = fresh
            self.device_scene_buffer_capacity_bytes = bytes
        else:
            self.device_scene_blocking_upload_calls = self.device_scene_blocking_upload_calls + 1
            if not vulkan_sffi_copy_to_buffer(self.device_scene_buffer, payload, 0):
                # The synchronous provider may have written a prefix before
                # returning failure. Invalidate the exact reuse key so those
                # bytes can never masquerade as the previous scene.
                self.device_scene_identity = 0u64
                self.device_scene_rows = []
                self.device_scene_upload_failures = self.device_scene_upload_failures + 1
                return false
        self.device_scene_identity = identity
        self.device_scene_rows = _engine2d_vulkan_resident_scene_snapshot(rows)
        self.device_scene_proof_needs_reset = true
        self.device_scene_uploads = self.device_scene_uploads + 1
        self.device_scene_upload_bytes = self.device_scene_upload_bytes + bytes
        true

    me release_device_scene_buffer() -> bool:
        if not self.release_scene_consumer():
            return false
        if self.device_scene_buffer <= 0:
            return true
        val released = vulkan_sffi_free_buffer(self.device_scene_buffer)
        if released:
            self.device_scene_releases = self.device_scene_releases + 1
            self.device_scene_buffer = 0
            self.device_scene_buffer_capacity_bytes = 0
            self.device_scene_identity = 0u64
            self.device_scene_rows = []
        else:
            self.device_scene_release_failures = self.device_scene_release_failures + 1
        released

fn _resident_refusal(request: Engine2dGpuEpochRequest, reason_code: u32, store_reason: u16, diagnostic: text) -> Engine2dVulkanResidentFrame:
    Engine2dVulkanResidentFrame(
        receipt: Engine2dGpuEpochReceipt(
            profile: request.profile,
            queue_handle: request.queue_handle,
            backend_handle: request.backend_handle,
            queue_generation: request.queue_generation,
            operation_generation: request.operation_generation,
            scene_generation: request.scene_generation,
            surface_generation: request.surface_generation,
            arena_generation: request.arena_generation,
            token: nil,
            phase: ENGINE2D_GPU_PHASE_REJECTED,
            terminal: true,
            reason_code: reason_code,
            missing_capabilities: 0u32,
            truth: engine2d_gpu_truth_none(),
            routing_evidence_only: true,
            device_execution_proven: false,
            diagnostic: diagnostic
        ),
        admitted: false,
        store_reason: store_reason,
        generation: 0u64,
        scene_identity: 0u64
    )

impl Engine2dVulkanResidentArena:
    me frame(scene_rows: [u64], request: Engine2dGpuEpochRequest, session_available: bool, caps: u32) -> Engine2dVulkanResidentFrame:
        """Run one frame through the fixed arena and return its epoch receipt.

        Every failure path releases the slot (`abort`/`complete`) so the next
        frame finds the same storage free: that reuse is what makes the arena
        fixed rather than merely bounded.
        """
        if request.arena_generation != self.arena_generation:
            return _resident_refusal(request, DRAW_IR_V3_REASON_NONE, DRAW_IR_PACKED_REASON_STALE,
                "stale arena generation {request.arena_generation}; arena is {self.arena_generation}")
        var generation_ref = DrawIrPackedGenerationRefV3(arena_id: self.arena_id, generation: 0u64, slot: 0u32)
        match self.store.admit(scene_rows.len() as u32):
            case DrawIrPackedAdmissionV3.Refused(reason):
                return _resident_refusal(request, DRAW_IR_V3_REASON_CAPACITY_OVERFLOW, reason,
                    "fixed arena refused the frame: store reason {reason}")
            case DrawIrPackedAdmissionV3.Admitted(reference):
                generation_ref = reference
        var i = 0
        while i < scene_rows.len():
            val written = self.store.write(generation_ref, scene_rows[i])
            if written != DRAW_IR_PACKED_REASON_OK:
                self.store.abort(generation_ref)
                return _resident_refusal(request, DRAW_IR_V3_REASON_DEVICE_FAULT, written,
                    "packed write refused at row {i}")
            i = i + 1
        var submission = DrawIrPackedSubmissionV3(generation_ref: generation_ref, row_count: 0u32, content_hash: "")
        match self.store.seal(generation_ref):
            case DrawIrPackedSealV3.Refused(reason):
                self.store.abort(generation_ref)
                return _resident_refusal(request, DRAW_IR_V3_REASON_DEVICE_FAULT, reason, "seal refused")
            case DrawIrPackedSealV3.Sealed(sealed):
                submission = sealed
        val published = self.store.publish(submission)
        if published != DRAW_IR_PACKED_REASON_OK:
            self.store.abort(generation_ref)
            return _resident_refusal(request, DRAW_IR_V3_REASON_CAPACITY_OVERFLOW, published, "handoff queue refused the generation")
        match self.store.take():
            case DrawIrPackedHandoffV3.Refused(reason):
                return _resident_refusal(request, DRAW_IR_V3_REASON_DEVICE_FAULT, reason, "handoff queue was empty")
            case DrawIrPackedHandoffV3.Ready(taken):
                submission = taken
        if not self.store.matches(submission, scene_rows):
            self.store.complete(submission.generation_ref)
            return _resident_refusal(request, DRAW_IR_V3_REASON_DEVICE_FAULT, DRAW_IR_PACKED_REASON_STALE,
                "taken generation does not match the submitted rows")
        # Release the slot back into the fixed pool. No FRAMEBUFFER readback
        # happens here or elsewhere in this module, which is why the legacy
        # `readbacks` counter stays 0. The four-byte proof has its own counter.
        self.store.complete(submission.generation_ref)
        val identity = engine2d_vulkan_resident_scene_identity(scene_rows)
        if self.frames_submitted > 0 and not _engine2d_vulkan_resident_scene_rows_equal(scene_rows, self.last_scene_rows):
            self.semantic_rebuilds = self.semantic_rebuilds + 1
            self.last_scene_rows = _engine2d_vulkan_resident_scene_snapshot(scene_rows)
        elif self.frames_submitted == 0:
            self.last_scene_rows = _engine2d_vulkan_resident_scene_snapshot(scene_rows)
        self.last_scene_identity = identity
        self.frames_submitted = self.frames_submitted + 1
        val token = RingToken(
            ring_id: self.arena_id,
            slot: submission.generation_ref.slot as u64,
            generation: RingGeneration(value: submission.generation_ref.generation)
        )
        Engine2dVulkanResidentFrame(
            receipt: engine2d_gpu_epoch_admit(request, token, session_available, caps),
            admitted: true,
            store_reason: DRAW_IR_PACKED_REASON_OK,
            generation: submission.generation_ref.generation,
            scene_identity: identity
        )

fn engine2d_vulkan_resident_frame(arena: Engine2dVulkanResidentArena, scene_rows: [u64], request: Engine2dGpuEpochRequest, session_available: bool, caps: u32) -> Engine2dVulkanResidentFrame:
    """Free-function entry point; the arena is mutated in place and keeps its counters.

    The arena parameter is used directly: rebinding it to a local `var` first
    copied the class value, so every counter update landed on the copy and the
    caller's arena stayed at zero frames — a silently vacuous wrapper.
    """
    arena.frame(scene_rows, request, session_available, caps)

fn engine2d_vulkan_resident_request(profile: text, arena_generation: u64, scene_generation: u64, row_count: i64) -> Engine2dGpuEpochRequest:
    """A resident-slice epoch request over a registered payload lease."""
    Engine2dGpuEpochRequest(
        profile: profile,
        queue_handle: 1,
        backend_handle: 1,
        queue_generation: 1u64,
        operation_generation: scene_generation,
        scene_generation: scene_generation,
        surface_generation: 1u64,
        arena_generation: arena_generation,
        payload_lease: RingPayloadLease(
            ownership: RingPayloadOwnership.RegisteredLease,
            owner_id: 1u64,
            handle: 1u64,
            generation: RingGeneration(value: 1u64),
            byte_length: (row_count * 8) as u64
        ),
        command_count: row_count,
        packet_bytes: row_count * 8,
        content_hash: 0u64
    )

fn engine2d_vulkan_binary_identity() -> text:
    """Exact identity of the running binary, or empty when the host did not supply one.

    Empty is deliberate: an "unavailable" placeholder would be non-empty and
    would slip past `engine2d_gpu_device_evidence_qualifies`.
    """
    env_get(ENGINE2D_VULKAN_BINARY_IDENTITY_ENV)

fn engine2d_vulkan_device_evidence(device_name: text, device_type: text, driver_identity: text, host_submit_ns: i64, host_complete_ns: i64, transfer_bytes: i64, negative_control_passed: bool) -> Engine2dGpuDeviceEvidence:
    """Device evidence for the Vulkan slice: real identities and real host timestamps only.

    `device_timestamp_available` is reported false because this tree exposes no
    Vulkan query-pool extern at all, so there is no honest device tick to read.
    """
    # TODO: [gpu][P2] When a VkQueryPool timestamp extern exists it must supply
    # the timestamp-valid bits, the queue's timestampPeriod, and a begin/end tick
    # pair written by vkCmdWriteTimestamp around the resident dispatch; only then
    # may device_timestamp_available become true and device_begin/end_ticks be
    # filled from the device instead of staying zero.
    Engine2dGpuDeviceEvidence(
        binary_identity: engine2d_vulkan_binary_identity(),
        device_name: device_name,
        device_type: device_type,
        driver_identity: driver_identity,
        host_submit_ns: host_submit_ns,
        host_complete_ns: host_complete_ns,
        device_timestamp_available: false,
        device_begin_ticks: 0,
        device_end_ticks: 0,
        transfer_bytes: transfer_bytes,
        negative_control_passed: negative_control_passed
    )

fn engine2d_vulkan_resident_device_ready() -> bool:
    """Live probe: a Vulkan loader alone is not a device.

    `vulkan_available()` answers true on hosts where `VulkanSession.init()`
    still fails (measured on macOS 2026-09-05: available=true, init_error
    "runtime-init"), so a gate built on availability alone would run the device
    scenario against a session that never came up.
    """
    val session = VulkanSession.create()
    val rc = session.init()
    val ready = rc == 0 and session.is_valid()
    # Release either way: a half-initialised session still holds an instance.
    if ready or rc == 0:
        session.release()
    ready

fn _resident_host_ns() -> i64:
    time_now_unix_micros() * 1000

fn _resident_report(frames: i64, arena: Engine2dVulkanResidentArena, session_initialised: bool, init_error: text, device_name: text, device_type: text, driver_identity: text, negative_control_passed: bool, submit_failures: i64, evidence: Engine2dGpuDeviceEvidence, receipt: Engine2dGpuEpochReceipt) -> Engine2dVulkanResidentSliceReport:
    val qualifies = engine2d_gpu_device_evidence_qualifies(evidence)
    Engine2dVulkanResidentSliceReport(
        frames_requested: frames,
        frames_submitted: arena.frames_submitted,
        semantic_rebuilds: arena.semantic_rebuilds,
        readbacks: arena.readbacks,
        session_initialised: session_initialised,
        init_error: init_error,
        device_name: device_name,
        device_type: device_type,
        driver_identity: driver_identity,
        negative_control_passed: negative_control_passed,
        evidence_qualifies: qualifies,
        device_execution_proven: receipt.device_execution_proven,
        last_phase: receipt.phase,
        submit_failures: submit_failures,
        device_scene_uploads: arena.device_scene_uploads,
        device_scene_upload_bytes: arena.device_scene_upload_bytes,
        device_scene_reuses: arena.device_scene_reuses,
        device_scene_upload_failures: arena.device_scene_upload_failures,
        device_scene_allocations: arena.device_scene_allocations,
        device_scene_releases: arena.device_scene_releases,
        device_scene_release_failures: arena.device_scene_release_failures,
        device_scene_blocking_upload_calls: arena.device_scene_blocking_upload_calls,
        blocking_queue_submit_calls: arena.blocking_queue_submit_calls,
        device_scene_descriptor_binds: arena.device_scene_descriptor_binds,
        device_scene_dispatches: arena.device_scene_dispatches,
        device_scene_nonblocking_submits: arena.device_scene_nonblocking_submits,
        device_scene_fence_waits: arena.device_scene_fence_waits,
        device_scene_shader_consumed: arena.device_scene_shader_consumed,
        device_scene_proof_readbacks: arena.device_scene_proof_readbacks,
        device_scene_proof_initializations: arena.device_scene_proof_initializations,
        device_scene_proof_init_bytes: arena.device_scene_proof_init_bytes,
        device_scene_shader: arena.device_scene_shader,
        device_scene_pipeline: arena.device_scene_pipeline,
        device_scene_descriptor: arena.device_scene_descriptor,
        device_scene_descriptor_ready: arena.device_scene_descriptor_ready,
        device_scene_bound_identity: arena.device_scene_bound_identity,
        device_scene_proof_buffer: arena.device_scene_proof_buffer,
        device_scene_proof_checksum: arena.device_scene_proof_checksum,
        device_scene_fences: arena.device_scene_fences,
        host_submit_ns: evidence.host_submit_ns,
        host_complete_ns: evidence.host_complete_ns,
        summary: "frames={arena.frames_submitted}/{frames};rebuilds={arena.semantic_rebuilds};framebuffer_readbacks={arena.readbacks};scene_allocations={arena.device_scene_allocations};scene_uploads={arena.device_scene_uploads};scene_upload_bytes={arena.device_scene_upload_bytes};scene_reuses={arena.device_scene_reuses};scene_releases={arena.device_scene_releases};scene_upload_failures={arena.device_scene_upload_failures};scene_release_failures={arena.device_scene_release_failures};blocking_upload_calls={arena.device_scene_blocking_upload_calls};blocking_submit_calls={arena.blocking_queue_submit_calls};descriptor_binds={arena.device_scene_descriptor_binds};dispatches={arena.device_scene_dispatches};nonblocking_submits={arena.device_scene_nonblocking_submits};fence_waits={arena.device_scene_fence_waits};proof_initializations={arena.device_scene_proof_initializations};proof_init_bytes={arena.device_scene_proof_init_bytes};proof_readbacks={arena.device_scene_proof_readbacks};shader_consumed_at_least_once={arena.device_scene_shader_consumed};submit_failures={submit_failures};device={device_name};qualifies={qualifies};{engine2d_gpu_epoch_receipt_summary(receipt)}"
    )

fn engine2d_vulkan_resident_slice_run(frames: i64, scene_rows: [u64], caps: u32) -> Engine2dVulkanResidentSliceReport:
    """Run the resident slice on a real VulkanSession and report what was actually proven.

    The caller gates this on `vulkan_available()` and its own environment
    switch. When the session cannot initialise, every receipt stays
    routing-only and the report carries the session's own `init_error`.
    """
    var arena = engine2d_vulkan_resident_arena(0x5245534944u64, 2u32, (scene_rows.len() as u32) + 1u32, 2u32)
    val session = VulkanSession.create()
    val rc = session.init()
    if rc != 0 or not session.is_valid():
        # Preserve diagnostics before release clears the session fields, and
        # release any partially initialized provider state on this error path.
        val init_error = session.init_error
        val device_name = session.device_name
        val device_type = session.device_type
        val driver_identity = session.driver_identity
        val blocked = _resident_refusal(
            engine2d_vulkan_resident_request(ENGINE2D_GPU_PROFILE_SCENE_STATIC_POOL, arena.arena_generation, 1u64, scene_rows.len()),
            DRAW_IR_V3_REASON_DEVICE_FAULT, DRAW_IR_PACKED_REASON_OK,
            "vulkan session did not initialise: rc={rc} {init_error}")
        session.release()
        return _resident_report(frames, arena, false, init_error, device_name, device_type, driver_identity, false, 0, engine2d_gpu_device_evidence_none(), blocked.receipt)
    var last = _resident_refusal(
        engine2d_vulkan_resident_request(ENGINE2D_GPU_PROFILE_SCENE_STATIC_POOL, arena.arena_generation, 1u64, scene_rows.len()),
        DRAW_IR_V3_REASON_NONE, DRAW_IR_PACKED_REASON_OK, "no frame ran").receipt
    val submit_ns = _resident_host_ns()
    var transferred = 0
    var submit_failures = 0
    var frame_index = 0
    while frame_index < frames:
        if not arena.upload_scene_if_changed(scene_rows):
            submit_failures = submit_failures + 1
            frame_index = frame_index + 1
            continue
        transferred = arena.device_scene_upload_bytes
        # The retained scene buffer is descriptor-bound and consumed by one
        # real compute dispatch. The current fenced-submit provider waits for
        # completion before returning; retained fence handles are destroyed at
        # a bounded batch, scene-mutation, or shutdown boundary.
        if not arena.dispatch_scene(scene_rows):
            submit_failures = submit_failures + 1
        else:
            val request = engine2d_vulkan_resident_request(ENGINE2D_GPU_PROFILE_SCENE_STATIC_POOL, arena.arena_generation, 1u64, scene_rows.len())
            val outcome = arena.frame(scene_rows, request, true, caps)
            last = outcome.receipt
        frame_index = frame_index + 1
    # Negative control: a request carrying a generation the fixed arena never
    # issued must be refused, so a passing run cannot be explained by "the
    # arena accepts everything".
    val stale = arena.frame(scene_rows, engine2d_vulkan_resident_request(ENGINE2D_GPU_PROFILE_SCENE_STATIC_POOL, arena.arena_generation + 1u64, 1u64, scene_rows.len()), true, caps)
    val negative_control_passed = stale.receipt.phase == ENGINE2D_GPU_PHASE_REJECTED
    # Read the proof buffer once after all diagnostic fences retire. This is an
    # explicit attestation readback, not a steady-state framebuffer readback.
    val fences_retired = arena.retire_scene_fences()
    if fences_retired and arena.device_scene_proof_buffer > 0 and arena.device_scene_dispatches > 0:
        val proof = vulkan_sffi_read_buffer_bytes(arena.device_scene_proof_buffer, _ENGINE2D_VULKAN_SCENE_PROOF_BYTES, 0)
        arena.device_scene_proof_readbacks = arena.device_scene_proof_readbacks + 1
        arena.device_scene_shader_consumed = _engine2d_vulkan_resident_bytes_equal(proof, arena.device_scene_proof_checksum)
    # A failed submit, failed fence retirement, failed proof, or failed release
    # voids the whole run's device evidence rather than being averaged away.
    val complete_ns = _resident_host_ns()
    val released = arena.release_device_scene_buffer()
    val evidence = if submit_failures > 0 or not fences_retired or not arena.device_scene_shader_consumed or not released or arena.device_scene_release_failures > 0:
        engine2d_gpu_device_evidence_none()
    else:
        engine2d_vulkan_device_evidence(session.device_name, session.device_type, session.driver_identity, submit_ns, complete_ns, transferred, negative_control_passed)
    val proven = engine2d_gpu_epoch_advance(last, ENGINE2D_GPU_PHASE_GPU_FINISHED, evidence, engine2d_gpu_truth_none())
    # release() clears the identity fields, so copy them first.
    val device_name = session.device_name
    val device_type = session.device_type
    val driver_identity = session.driver_identity
    session.release()
    _resident_report(frames, arena, true, "", device_name, device_type, driver_identity, negative_control_passed, submit_failures, evidence, proven)

