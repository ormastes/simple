# Vulkan font-atlas composite companion. Pipeline ownership stays in
# VulkanSession; this module owns only atlas upload, dispatch, and evidence.

use std.common.gpu.font_atlas_composite.{FONT_ATLAS_COMPOSITE_PROGRAM_VERSION, font_atlas_composite_program_version_valid, font_atlas_composite_cache_identity, font_atlas_subrect_pixels, font_destination_origin}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend, VulkanErrorKind, vulkan_classify_error}
use std.gc_async_mut.gpu.engine2d.backend_vulkan_helpers.{vulkan_order_trace, vulkan_order_trace_enabled}
use std.gc_async_mut.gpu.engine2d.backend_vulkan_font_types.{VulkanFontPipelineEvidence, VulkanFontCompositeEvidence}
use std.gc_async_mut.gpu.engine2d.backend_vulkan_font_spirv.{FONT_ATLAS_COMPOSITE_VULKAN_SPIRV_SHA256}
use std.gpu.engine2d.backend_software.{SoftwareBackend}
use std.gc_async_mut.text_layout.font_renderer.{FontRenderBatch, font_render_batch_atlas_owner_identity, font_render_batch_atlas_cache_identity}
use std.common.ui.ui_frame_clock.{FrameClock}
use std.nogc_sync_mut.ui.host_frame_clock.{default_frame_clock}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_alloc_buffer, vulkan_sffi_free_buffer,
    vulkan_sffi_copy_to_buffer, vulkan_sffi_read_buffer_bytes,
    vulkan_sffi_create_descriptor_set, vulkan_sffi_bind_buffer,
    vulkan_sffi_destroy_descriptor_set, vulkan_sffi_begin_compute,
    vulkan_sffi_bind_pipeline, vulkan_sffi_bind_descriptors,
    vulkan_sffi_dispatch, vulkan_sffi_end_compute,
    vulkan_sffi_fence_submission_supported, vulkan_sffi_submit_and_wait_fence,
    vulkan_sffi_wait_fence, vulkan_sffi_destroy_fence,
    vulkan_sffi_last_error,
    vulkan_sffi_quarantine_dependencies,
    vulkan_sffi_quarantine_unsubmitted_command
}

val VULKAN_FONT_PARAMS_BYTES: i64 = 52
val VULKAN_FONT_PACKED_HEADER_WORDS: i64 = 8
val VULKAN_FONT_PACKED_GLYPH_WORDS: i64 = 7
val VULKAN_FONT_PACKED_MAX_BYTES: i64 = (VULKAN_FONT_PACKED_HEADER_WORDS + VULKAN_FONT_FRAME_GLYPH_CAP * VULKAN_FONT_PACKED_GLYPH_WORDS) * 4
val VULKAN_FONT_FRAME_GLYPH_CAP: i64 = 4096
val _VULKAN_STORAGE_BUFFER: i64 = 0x80

fn vulkan_font_elapsed_ns(started_ns: i64, finished_ns: i64) -> i64:
    if finished_ns > started_ns: finished_ns - started_ns else: 0

fn vulkan_font_timed_ns(total_ns: i64, evidence_overhead_ns: i64) -> i64:
    if total_ns > evidence_overhead_ns: total_ns - evidence_overhead_ns else: 0

fn vulkan_font_gpu_resource_bytes(atlas_bytes: i64, framebuffer_bytes: i64, params_allocated: bool) -> i64:
    if atlas_bytes < 0 or framebuffer_bytes < 0: return 0
    atlas_bytes + framebuffer_bytes + (if params_allocated: VULKAN_FONT_PARAMS_BYTES else: 0)

fn vulkan_font_gpu_resource_bytes_for_params(atlas_bytes: i64, framebuffer_bytes: i64,
                                             params_count: i64) -> i64:
    if atlas_bytes < 0 or framebuffer_bytes < 0 or params_count < 0: return 0
    atlas_bytes + framebuffer_bytes + params_count * VULKAN_FONT_PARAMS_BYTES

fn vulkan_font_frame_batch_contract(text_count: i64, command_count: i64,
                                    submission_count: i64, fence_count: i64) -> bool:
    text_count > 0 and command_count == 1 and submission_count == 1 and fence_count == 1

fn _vulkan_font_pack_i32_le(mut buf: [u8], offset: i32, value: i32) -> i32:
    val offset_1 = offset + 1
    val offset_2 = offset + 2
    val offset_3 = offset + 3
    buf[offset] = (value & 0xFF) as u8
    buf[offset_1] = ((value >> 8) & 0xFF) as u8
    buf[offset_2] = ((value >> 16) & 0xFF) as u8
    buf[offset_3] = ((value >> 24) & 0xFF) as u8
    offset + 4

fn vulkan_font_atlas_composite_params(atlas_width: i32, atlas_height: i32, atlas_count: i64,
                                      atlas_x: i32, atlas_y: i32, quad_width: i32, quad_height: i32,
                                      dst_width: i32, dst_height: i32, dst_count: i64,
                                      dst_x: i32, dst_y: i32, color: u32) -> [u8]:
    val atlas_product = atlas_width.to_i64() * atlas_height.to_i64()
    val quad_product = quad_width.to_i64() * quad_height.to_i64()
    val dst_product = dst_width.to_i64() * dst_height.to_i64()
    if (atlas_width <= 0 or atlas_height <= 0 or quad_width <= 0 or quad_height <= 0 or
        dst_width <= 0 or dst_height <= 0 or atlas_count != atlas_product or dst_count != dst_product or
        atlas_count > 2147483647 or dst_count > 2147483647 or quad_product <= 0 or quad_product > 2147483647 or
        atlas_x < 0 or atlas_y < 0 or atlas_x > atlas_width or atlas_y > atlas_height or
        quad_width > atlas_width - atlas_x or quad_height > atlas_height - atlas_y):
        return []
    var p: [u8] = [0u8; VULKAN_FONT_PARAMS_BYTES]
    var off = 0
    val values: [i32] = [atlas_width, atlas_height, atlas_count as i32, atlas_x, atlas_y,
        quad_width, quad_height, dst_width, dst_height, dst_count as i32, dst_x, dst_y, color as i32]
    for value in values:
        off = _vulkan_font_pack_i32_le(p, off, value)
    p

fn vulkan_font_dispatch_groups(pixel_count: i64) -> i64:
    if pixel_count <= 0 or pixel_count > 2147483647:
        0
    else:
        (pixel_count + 63) / 64

fn vulkan_font_packed_params(batch: FontRenderBatch, origin_x: i32, origin_y: i32,
                             dst_width: i32, dst_height: i32) -> [u8]:
    val glyph_count = batch.quads.len()
    val word_count = VULKAN_FONT_PACKED_HEADER_WORDS + glyph_count * VULKAN_FONT_PACKED_GLYPH_WORDS
    if glyph_count <= 0 or glyph_count > VULKAN_FONT_FRAME_GLYPH_CAP or word_count > 2147483647 / 4:
        return []
    val atlas_count = batch.atlas_width.to_i64() * batch.atlas_height.to_i64()
    val dst_count = dst_width.to_i64() * dst_height.to_i64()
    if atlas_count <= 0 or atlas_count > 2147483647 or dst_count <= 0 or dst_count > 2147483647:
        return []
    var packed: [u8] = [0u8; word_count * 4]
    var off = 0
    var max_pixels: i64 = 0
    val header: [i32] = [batch.atlas_width, batch.atlas_height, atlas_count as i32,
        dst_width, dst_height, dst_count as i32, glyph_count as i32, 0]
    for value in header:
        off = _vulkan_font_pack_i32_le(packed, off, value)
    for q in batch.quads:
        val pixels = q.width.to_i64() * q.height.to_i64()
        if pixels > max_pixels: max_pixels = pixels
        val dst_x = font_destination_origin(origin_x, q.dst_x, q.width)
        val dst_y = font_destination_origin(origin_y, q.dst_y, q.height)
        if dst_x == nil or dst_y == nil: return []
        val values: [i32] = [q.atlas_x, q.atlas_y, q.width, q.height,
            dst_x.?, dst_y.?, q.color as i32]
        for value in values:
            off = _vulkan_font_pack_i32_le(packed, off, value)
    _vulkan_font_pack_i32_le(packed, 28, max_pixels as i32)
    packed

fn vulkan_font_atlas_replacement_status(old_present: bool, old_freed: bool, fresh_freed: bool) -> text:
    if not old_present or old_freed:
        "replace"
    elif fresh_freed:
        "atlas-cleanup-failed"
    else:
        "cleanup-failed"

fn _vulkan_font_pixels_to_bytes(pixels: [u32]) -> [u8]:
    val byte_count = pixels.len() * 4
    var bytes: [u8] = [0u8; byte_count]
    var i: i64 = 0
    while i < pixels.len():
        val p = pixels[i]
        val off = i * 4
        val off_1 = off + 1
        val off_2 = off + 2
        val off_3 = off + 3
        bytes[off] = (p & 0xffu32) as u8
        bytes[off_1] = ((p >> 8) & 0xffu32) as u8
        bytes[off_2] = ((p >> 16) & 0xffu32) as u8
        bytes[off_3] = ((p >> 24) & 0xffu32) as u8
        i = i + 1
    bytes

# Atlas payload identity token for font composite evidence.
#
# PERF (2026-08-04): this used to be `sha256_u8_hex(atlas_payload)` over the
# whole 4 MB atlas. The font atlas is a FIXED 1024x1024 (FONT_ATLAS_WIDTH /
# FONT_ATLAS_HEIGHT in text_layout/font_renderer.spl) regardless of how many
# glyphs a batch draws, so even a two-glyph draw hashed 1024*1024*4 =
# 4,194,304 bytes. The vulkan font lane runs interpreted (the vulkan_sffi_*
# externs are unresolved in the JIT, which drops the whole module to the
# interpreter), where sha256_u8_hex measures ~7.2 KB/s -- externally measured
# 2.29 s for 16 KB and 4.26 s for 32 KB, i.e. linear. That put a single cold
# atlas upload at ~10 minutes of pure evidence overhead and made every
# vector-font spec on this lane effectively unverifiable.
#
# What the token actually guarantees (audited across every consumer before
# this change): it is a *change-detection* token with a well-formedness gate,
# NOT a cryptographic or parity checksum.
#   - shape: vulkan_font_stage_evidence_ready below requires .len() == 64, and
#     the live-evidence checker requires 64 lowercase hex chars
#     (scripts/check/check-macos-gpu-2d-live-evidence.shs sha256_valid).
#   - change detection: the only value comparisons are warm-vs-cold equality
#     within one receipt (test/02_integration/rendering/macos_gpu_2d_live_harness.spl,
#     scripts/check/check-macos-gpu-2d-live-evidence.shs) and stability across
#     samples (test/05_perf/graphics_2d/shared_multilingual_gpu_fonts_perf_spec.spl).
#   - NOT security, NOT cross-process parity: no consumer anywhere recomputes
#     this digest independently and compares values, and no constant pins it.
#     (The one recompute-and-compare in the tree,
#     test/03_system/app/simple_2d/feature/native_gpu_font_readback_spec.spl:415,
#     belongs to the ENGINE3D adapter's alpha-channel digest in
#     engine3d/vulkan_font_adapter.spl:174 -- a different writer over different
#     bytes, deliberately left untouched here.)
#
# So the fix keeps a real SHA-256 (identical 64-char lowercase hex shape) but
# stops feeding it 4 MB: every pixel is folded into a 128-bit four-lane
# fingerprint, and SHA-256 is then taken over that fingerprint plus the atlas
# geometry. Coverage is unchanged -- all 1024*1024 pixels still contribute, so
# any atlas mutation still moves the token -- and the index is mixed into each
# lane so position matters (a swap of two pixels changes the digest). There is
# no native byte-buffer SHA-256 extern registered for the interpreter, so
# routing to native would mean adding one across the Rust seed; that is a
# separate lane. Externally measured: 4 MB atlas 3.91 s vs ~10 min before.
fn _vulkan_font_atlas_payload_digest(pixels: [u32], width: i32, height: i32) -> text:
    val mask32: i64 = 4294967295
    val prime: i64 = 16777619
    var l0: i64 = 2166136261
    var l1: i64 = 2246822519
    var l2: i64 = 3266489917
    var l3: i64 = 668265263
    val n = pixels.len()
    val quad_end = n - (n % 4)
    var i: i64 = 0
    while i < quad_end:
        val v0 = pixels[i].to_i64() & mask32
        val v1 = pixels[i + 1].to_i64() & mask32
        val v2 = pixels[i + 2].to_i64() & mask32
        val v3 = pixels[i + 3].to_i64() & mask32
        l0 = ((l0 ^ (v0 + i)) * prime) & mask32
        l1 = ((l1 ^ (v1 + i)) * prime) & mask32
        l2 = ((l2 ^ (v2 + i)) * prime) & mask32
        l3 = ((l3 ^ (v3 + i)) * prime) & mask32
        i = i + 4
    while i < n:
        val v = pixels[i].to_i64() & mask32
        l0 = ((l0 ^ (v + i)) * prime) & mask32
        i = i + 1
    val lanes: [i64] = [l0, l1, l2, l3, n, width.to_i64(), height.to_i64()]
    var pre: [u8] = [0u8; 56]
    var k: i64 = 0
    while k < 7:
        val w = lanes[k]
        val base = k * 8
        var b: i64 = 0
        while b < 8:
            pre[base + b] = ((w >> (b * 8)) & 255).to_u8()
            b = b + 1
        k = k + 1
    sha256_u8_hex(pre)

fn _vulkan_font_bytes_to_pixels(bytes: [u8], count: i64) -> [u32]:
    if count <= 0 or bytes.len() != count * 4:
        return []
    var pixels: [u32] = [0u32; count]
    var i: i64 = 0
    while i < count:
        val off = i * 4
        val off_1 = off + 1
        val off_2 = off + 2
        val off_3 = off + 3
        val byte_0 = bytes[off] as u32
        val byte_1 = (bytes[off_1] as u32) << 8
        val byte_2 = (bytes[off_2] as u32) << 16
        val byte_3 = (bytes[off_3] as u32) << 24
        pixels[i] = byte_0 | byte_1 | byte_2 | byte_3
        i = i + 1
    pixels

fn _vulkan_font_download(handle: i64, byte_count: i64) -> [u8]:
    if handle <= 0 or byte_count <= 0 or byte_count > 8589934588:
        return []
    val bytes = vulkan_sffi_read_buffer_bytes(handle, byte_count, 0)
    if bytes.len() != byte_count:
        return []
    bytes

fn vulkan_font_pixels_checksum(pixels: [u32]) -> i64:
    if pixels.len() == 0:
        return 0
    var checksum: i64 = -3750763034362895579
    var i: i64 = 0
    while i < pixels.len():
        checksum = checksum xor (pixels[i] as i64)
        checksum = ((checksum as u64) * (1099511628211 as u64)) as i64
        i = i + 1
    checksum

fn vulkan_font_pixels_equal(actual: [u32], expected: [u32]) -> bool:
    if actual.len() != expected.len():
        return false
    var i: i64 = 0
    while i < actual.len():
        if actual[i] != expected[i]:
            return false
        i = i + 1
    true

fn vulkan_font_changed_pixel_count(before: [u32], after: [u32]) -> i64:
    if before.len() != after.len(): return 0
    var count: i64 = 0
    var i: i64 = 0
    while i < after.len():
        if before[i] != after[i]: count = count + 1
        i = i + 1
    count

fn vulkan_font_runtime_classification(runtime_available: bool, evidence: VulkanFontCompositeEvidence) -> text:
    if not runtime_available:
        "unavailable"
    elif evidence.device_executed and evidence.parity and not evidence.promotion_ready:
        "executed-unpromoted"
    elif evidence.promotion_ready:
        "promoted"
    else:
        "failed"

fn vulkan_font_promotion_ready(artifact_mode: text, dispatch_count: i64, quad_count: i64,
                               submitted: bool, waited: bool, readback_bytes: i64,
                               parity: bool, fence_handle: i64,
                               fence_available: bool, fence_destroyed: bool,
                               device_name: text, device_type: text,
                               driver_identity: text) -> bool:
    (artifact_mode == "precompiled-spirv" and
     quad_count > 0 and dispatch_count == 1 and submitted and waited and
     readback_bytes > 0 and parity and fence_handle > 0 and fence_available and
     fence_destroyed and device_name != "" and
     (device_type == "discrete" or device_type == "integrated" or device_type == "virtual") and
     driver_identity != "")

fn vulkan_font_stage_evidence_ready(evidence: VulkanFontCompositeEvidence) -> bool:
    (evidence.artifact_identity == "precompiled-spirv:" + FONT_ATLAS_COMPOSITE_VULKAN_SPIRV_SHA256 and
     evidence.entry_name == "main" and
     evidence.program_version == FONT_ATLAS_COMPOSITE_PROGRAM_VERSION and
     evidence.emission_compile_ns > 0 and evidence.batch_identity != "" and
     evidence.atlas_payload_sha256.len() == 64 and
     evidence.shader_handle > 0 and evidence.pipeline_handle > 0 and
     evidence.atlas_buffer_handle > 0 and evidence.params_buffer_handle > 0 and
     evidence.command_handle > 0 and evidence.fence_handle > 0 and
     evidence.readback_buffer_handle > 0 and evidence.quad_count > 0 and
     evidence.dispatch_count == 1 and evidence.submitted and
     evidence.completion_waited and evidence.fence_evidence_available and
     evidence.fence_destroyed and evidence.readback_source == "device_readback" and
     evidence.readback_byte_count > 0 and evidence.queue_device_ns > 0 and
     evidence.sync_wait_ns > 0 and evidence.present_readback_ns > 0 and
     evidence.cpu_oracle_ns > 0 and
     evidence.present_mode == "not-applicable-offscreen" and
     evidence.readback_nonblank_pixels > 0 and
     evidence.readback_nonblank_pixels <= evidence.readback_byte_count / 4 and
     evidence.device_checksum != 0 and
     evidence.device_checksum == evidence.oracle_checksum and evidence.parity and
     evidence.device_executed)

fn _vulkan_font_evidence(pipeline: VulkanFontPipelineEvidence, status: text, reason: text,
                         atlas: i64, params: i64, descriptor: i64, command: i64,
                         quads: i64, dispatches: i64, submitted: bool, waited: bool,
                         framebuffer: i64, readback_bytes: i64, device_checksum: i64,
                         oracle_checksum: i64, parity: bool) -> VulkanFontCompositeEvidence:
    val executed = submitted and waited
    VulkanFontCompositeEvidence(status: status, reason: reason, artifact_mode: pipeline.artifact_mode,
        shader_handle: pipeline.shader_handle, pipeline_handle: pipeline.pipeline_handle,
        atlas_buffer_handle: atlas, params_buffer_handle: params,
        descriptor_handle: if descriptor < 0: 0 else: descriptor,
        descriptor_created: descriptor != 0, descriptor_destroyed: descriptor < 0,
        command_handle: command, quad_count: quads, dispatch_count: dispatches,
        submitted: submitted, completion_waited: waited, fence_handle: 0,
        fence_evidence_available: false, fence_destroyed: false,
        device_name: pipeline.device_name, device_type: pipeline.device_type,
        driver_identity: pipeline.driver_identity,
        readback_source: if readback_bytes > 0: "device_readback" else: "unavailable",
        readback_buffer_handle: if readback_bytes > 0: framebuffer else: 0,
        readback_byte_count: readback_bytes, device_checksum: device_checksum,
        oracle_checksum: oracle_checksum, parity: parity, device_executed: executed,
        promotion_ready: false, artifact_identity: pipeline.artifact_identity,
        entry_name: pipeline.entry_name, program_version: pipeline.program_version,
        emission_compile_ns: pipeline.emission_compile_ns,
        present_mode: "not-applicable-offscreen")

fn _vulkan_font_completion(evidence: VulkanFontCompositeEvidence, fence_handle: i64,
                           fence_available: bool, fence_destroyed: bool) -> VulkanFontCompositeEvidence:
    var result = evidence
    result.fence_handle = fence_handle
    result.fence_evidence_available = fence_available
    result.fence_destroyed = fence_destroyed
    result.promotion_ready = vulkan_font_promotion_ready(
        result.artifact_mode, result.dispatch_count, result.quad_count, result.submitted,
        result.completion_waited, result.readback_byte_count, result.parity,
        fence_handle, fence_available, fence_destroyed,
        result.device_name, result.device_type, result.driver_identity
    ) and vulkan_font_stage_evidence_ready(result)
    if result.promotion_ready:
        result.status = "promoted"
        result.reason = "fence-device-identity-readback-proven"
    elif result.artifact_mode != "precompiled-spirv" and result.device_executed and result.parity:
        result.status = "executed-unpromoted"
        result.reason = "precompiled-spirv-required"
    result

fn _vulkan_font_with_fallback(evidence: VulkanFontCompositeEvidence,
                              pixels: [u32]) -> VulkanFontCompositeEvidence:
    var replayable = evidence
    replayable.fallback_pixels = pixels
    replayable

impl VulkanBackend:
    me set_font_oracle_mode(enabled: bool):
        # Production rendering never reads the full surface or runs the CPU
        # renderer. Tests and evidence collectors opt in explicitly.
        self.font_oracle_mode = enabled

    me composite_font_batch(origin_x: i32, origin_y: i32,
                            batch: FontRenderBatch) -> VulkanFontCompositeEvidence:
        val clock = default_frame_clock()
        val started_ns = clock.now_micros() * 1000
        var evidence = self._composite_font_batch_impl(origin_x, origin_y, batch, clock)
        val total_ns = vulkan_font_elapsed_ns(started_ns, clock.now_micros() * 1000)
        evidence.elapsed_ns = vulkan_font_timed_ns(total_ns, evidence.evidence_overhead_ns)
        evidence.atlas_upload_count = self.font_atlas_upload_count
        evidence.atlas_upload_bytes = self.font_atlas_upload_bytes
        evidence.gpu_resource_high_water_bytes = self.font_gpu_resource_high_water_bytes
        evidence

    me _composite_font_batch_impl(origin_x: i32, origin_y: i32,
                                  batch: FontRenderBatch, clock: FrameClock) -> VulkanFontCompositeEvidence:
        if self.font_oracle_mode:
            val evidence_flush = self._flush_pending_compute()
            if evidence_flush <= 0:
                return _vulkan_font_evidence(
                    self.font_atlas_pipeline_evidence(), "failed",
                    if evidence_flush < 0: "primitive-batch-completion-unknown" else: "primitive-batch-submit-failed",
                    self.d_font_atlas, self.d_font_params, 0, 0,
                    batch.quads.len(), 0, false, false, self.d_framebuffer,
                    0, 0, 0, false)
        val pipeline = self.font_atlas_pipeline_evidence()
        val framebuffer = self.d_framebuffer
        val width = self.w
        val height = self.h
        if pipeline.status != "ready" or pipeline.shader_handle <= 0 or pipeline.pipeline_handle <= 0:
            return _vulkan_font_evidence(pipeline, "unavailable", "font-pipeline-not-ready", 0, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        if not font_atlas_composite_program_version_valid(batch.program_version) or not batch.valid or batch.quads.len() == 0:
            return _vulkan_font_evidence(pipeline, "rejected", "invalid-font-batch", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        val pending_glyph_count = self.pending_font_glyph_count
        if (batch.quads.len() > VULKAN_FONT_FRAME_GLYPH_CAP or
            (self.frame_batching_enabled and
             pending_glyph_count > VULKAN_FONT_FRAME_GLYPH_CAP - batch.quads.len())):
            return _vulkan_font_evidence(pipeline, "rejected", "font-frame-glyph-cap-exceeded", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        val dst_count = width.to_i64() * height.to_i64()
        if framebuffer <= 0 or width <= 0 or height <= 0 or dst_count <= 0 or dst_count > 2147483647:
            return _vulkan_font_evidence(pipeline, "rejected", "invalid-destination", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        val atlas_count = batch.atlas_width.to_i64() * batch.atlas_height.to_i64()
        if batch.atlas_width <= 0 or batch.atlas_height <= 0 or atlas_count <= 0 or atlas_count > 2147483647 or batch.atlas_pixels.len() != atlas_count:
            return _vulkan_font_evidence(pipeline, "rejected", "invalid-font-atlas", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)

        var evidence_overhead_ns: i64 = 0
        var dirty_upload_ns: i64 = 0

        var checked: i64 = 0
        while checked < batch.quads.len():
            val q = batch.quads[checked]
            val total = q.width.to_i64() * q.height.to_i64()
            val dst_x = font_destination_origin(origin_x, q.dst_x, q.width)
            val dst_y = font_destination_origin(origin_y, q.dst_y, q.height)
            if vulkan_font_dispatch_groups(total) == 0 or dst_x == nil or dst_y == nil:
                return _vulkan_font_evidence(pipeline, "rejected", "invalid-font-quad", self.d_font_atlas, self.d_font_params, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            val packed = vulkan_font_atlas_composite_params(batch.atlas_width, batch.atlas_height, batch.atlas_pixels.len(),
                q.atlas_x, q.atlas_y, q.width, q.height, width, height, dst_count, dst_x.?, dst_y.?, q.color)
            if packed.len() != VULKAN_FONT_PARAMS_BYTES:
                return _vulkan_font_evidence(pipeline, "rejected", "invalid-font-params", self.d_font_atlas, self.d_font_params, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            checked = checked + 1

        if (pipeline.device_type != "discrete" and pipeline.device_type != "integrated" and
            pipeline.device_type != "virtual" and pipeline.device_type != "cpu"):
            return _vulkan_font_evidence(pipeline, "unavailable", "accelerated-device-required", 0, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        if not vulkan_sffi_fence_submission_supported():
            return _vulkan_font_evidence(pipeline, "unavailable", "fenced-submit-required", 0, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)

        val device_features = if pipeline.device_name != "" and pipeline.device_type != "" and pipeline.driver_identity != "":
            "name=" + pipeline.device_name + ";type=" + pipeline.device_type + ";driver=" + pipeline.driver_identity
        else: ""
        val dependency_identity = if self.session.device > 0 and self.session.generation > 0:
            "device=" + self.session.device.to_string() + ";generation=" + self.session.generation.to_string()
        else: ""
        val owner_identity = font_atlas_composite_cache_identity(
            font_render_batch_atlas_owner_identity(batch), "vulkan2d", device_features,
            pipeline.artifact_identity, dependency_identity)
        if owner_identity == "":
            return _vulkan_font_evidence(pipeline, "rejected", "incomplete-font-cache-identity", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        val atlas_bytes = atlas_count * 4
        val dimensions_changed = self.font_atlas_width != batch.atlas_width or self.font_atlas_height != batch.atlas_height
        val atlas_content_changed = self.font_atlas_generation != batch.atlas_generation or self.font_atlas_owner_identity != owner_identity
        if self.pending_font_descriptors.len() > 0 and (dimensions_changed or atlas_content_changed):
            val atlas_flush = self._flush_pending_compute()
            if atlas_flush <= 0:
                return _vulkan_font_evidence(pipeline, "failed",
                    if atlas_flush < 0: "font-atlas-transition-completion-unknown" else: "font-atlas-transition-submit-failed",
                    self.d_font_atlas, self.d_font_params, 0, 0,
                    batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        if self.d_font_atlas == 0 or dimensions_changed:
            val fresh = vulkan_sffi_alloc_buffer(atlas_bytes, _VULKAN_STORAGE_BUFFER)
            if fresh == 0:
                return _vulkan_font_evidence(pipeline, "failed", "atlas-allocation-failed", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            if self.d_font_atlas != 0:
                val old_freed = vulkan_sffi_free_buffer(self.d_font_atlas)
                if not old_freed:
                    val fresh_freed = vulkan_sffi_free_buffer(fresh)
                    val reason = vulkan_font_atlas_replacement_status(true, false, fresh_freed)
                    return _vulkan_font_evidence(pipeline, "failed", reason, self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            self.d_font_atlas = fresh
            self.font_atlas_width = batch.atlas_width
            self.font_atlas_height = batch.atlas_height
            self.font_atlas_generation = -1
            self.font_atlas_owner_identity = ""
            self.font_atlas_payload_sha256 = ""
            val allocated_bytes = vulkan_font_gpu_resource_bytes(atlas_bytes, dst_count * 4, self.d_font_params != 0)
            if allocated_bytes > self.font_gpu_resource_high_water_bytes:
                self.font_gpu_resource_high_water_bytes = allocated_bytes
        if self.font_atlas_generation != batch.atlas_generation or self.font_atlas_owner_identity != owner_identity:
            val dirty_upload_started = clock.now_micros() * 1000
            val atlas_payload = _vulkan_font_pixels_to_bytes(batch.atlas_pixels)
            val atlas_uploaded = vulkan_sffi_copy_to_buffer(self.d_font_atlas, atlas_payload, 0)
            dirty_upload_ns = vulkan_font_elapsed_ns(dirty_upload_started, clock.now_micros() * 1000)
            if not atlas_uploaded:
                self.font_atlas_generation = -1
                self.font_atlas_owner_identity = ""
                self.font_atlas_payload_sha256 = ""
                return _vulkan_font_evidence(pipeline, "failed", "atlas-upload-failed", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            val payload_hash_started = clock.now_micros() * 1000
            self.font_atlas_payload_sha256 = _vulkan_font_atlas_payload_digest(
                batch.atlas_pixels, batch.atlas_width, batch.atlas_height)
            evidence_overhead_ns = evidence_overhead_ns + vulkan_font_elapsed_ns(payload_hash_started, clock.now_micros() * 1000)
            self.font_atlas_generation = batch.atlas_generation
            self.font_atlas_owner_identity = owner_identity
            self.font_atlas_upload_count = self.font_atlas_upload_count + 1
            self.font_atlas_upload_bytes = self.font_atlas_upload_bytes + atlas_bytes
        if pipeline.artifact_mode == "precompiled-spirv" or pipeline.artifact_mode == "runtime-glsl":
            val packed = vulkan_font_packed_params(batch, origin_x, origin_y, width, height)
            val pool_index = self.pending_font_params.len()
            val use_packed_pool = self.frame_batching_enabled and not self.font_oracle_mode
            if packed.len() == 0 or packed.len() > VULKAN_FONT_PACKED_MAX_BYTES:
                return _vulkan_font_evidence(pipeline, "rejected", "invalid-packed-font-params", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            var packed_params: i64 = 0
            var packed_descriptor: i64 = 0
            if use_packed_pool and pool_index < self.font_params_pool.len():
                packed_params = self.font_params_pool[pool_index]
                packed_descriptor = self.font_descriptor_pool[pool_index]
                if self.font_params_pool_capacity[pool_index] < packed.len():
                    return _vulkan_font_evidence(pipeline, "failed", "packed-font-pool-capacity-invalid", self.d_font_atlas, packed_params, packed_descriptor, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            else:
                val allocation_bytes = if use_packed_pool: VULKAN_FONT_PACKED_MAX_BYTES else: packed.len()
                packed_params = vulkan_sffi_alloc_buffer(allocation_bytes, _VULKAN_STORAGE_BUFFER)
                packed_descriptor = vulkan_sffi_create_descriptor_set(pipeline.pipeline_handle)
                if packed_params <= 0 or packed_descriptor <= 0:
                    if packed_params > 0: vulkan_sffi_free_buffer(packed_params)
                    if packed_descriptor > 0: vulkan_sffi_destroy_descriptor_set(packed_descriptor)
                    return _vulkan_font_evidence(pipeline, "failed", "packed-font-pool-allocation-failed", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
                if use_packed_pool:
                    self.font_params_pool.push(packed_params)
                    self.font_descriptor_pool.push(packed_descriptor)
                    self.font_params_pool_capacity.push(VULKAN_FONT_PACKED_MAX_BYTES)
            var packed_pool_bytes: i64 = 0
            for capacity in self.font_params_pool_capacity:
                packed_pool_bytes = packed_pool_bytes + capacity
            val packed_resource_bytes = atlas_bytes + dst_count * 4 + packed_pool_bytes
            if packed_resource_bytes > self.font_gpu_resource_high_water_bytes:
                self.font_gpu_resource_high_water_bytes = packed_resource_bytes
            val packed_ready = (
                vulkan_sffi_copy_to_buffer(packed_params, packed, 0) and
                vulkan_sffi_bind_buffer(packed_descriptor, 0, self.d_font_atlas) and
                vulkan_sffi_bind_buffer(packed_descriptor, 1, framebuffer) and
                vulkan_sffi_bind_buffer(packed_descriptor, 2, packed_params))
            if not packed_ready:
                if not use_packed_pool:
                    if packed_descriptor > 0: vulkan_sffi_destroy_descriptor_set(packed_descriptor)
                    if packed_params > 0: vulkan_sffi_free_buffer(packed_params)
                return _vulkan_font_evidence(pipeline, "failed", "packed-font-prepare-failed", self.d_font_atlas, packed_params, packed_descriptor, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            val packed_command = if self.pending_compute_command > 0:
                self.pending_compute_command
            else:
                vulkan_sffi_begin_compute()
            var max_pixels: i64 = 0
            for q in batch.quads:
                val glyph_pixels = q.width.to_i64() * q.height.to_i64()
                if glyph_pixels > max_pixels: max_pixels = glyph_pixels
            val packed_recorded = (packed_command > 0 and
                vulkan_sffi_bind_pipeline(packed_command, pipeline.pipeline_handle) and
                vulkan_sffi_bind_descriptors(packed_command, packed_descriptor) and
                vulkan_sffi_dispatch(packed_command, vulkan_font_dispatch_groups(max_pixels), batch.quads.len(), 1))
            if not packed_recorded:
                if packed_command > 0: vulkan_sffi_quarantine_unsubmitted_command(packed_command, 0, 0)
                if use_packed_pool:
                    self._quarantine_pending_compute_descriptors()
                    self._clear_pending_compute_state()
                else:
                    vulkan_sffi_quarantine_dependencies(packed_descriptor, packed_params, 0, 0)
                self.completion_unknown = true
                return _vulkan_font_evidence(pipeline, "failed", "packed-font-record-failed", self.d_font_atlas, packed_params, packed_descriptor, packed_command, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            if use_packed_pool:
                if self.pending_compute_command == 0:
                    self.pending_compute_command = packed_command
                if self.pending_font_descriptors.len() == 0:
                    self.font_frame_command_count = self.font_frame_command_count + 1
                self.pending_font_descriptors.push(packed_descriptor)
                self.pending_font_params.push(packed_params)
                self.pending_font_glyph_count = self.pending_font_glyph_count + batch.quads.len()
                var packed_evidence = _vulkan_font_evidence(pipeline, "recorded", "queued-packed-font-batch",
                    self.d_font_atlas, packed_params, packed_descriptor, packed_command, batch.quads.len(), 1,
                    false, false, framebuffer, 0, 0, 0, false)
                packed_evidence.batch_identity = font_render_batch_atlas_cache_identity(batch)
                packed_evidence.atlas_payload_sha256 = self.font_atlas_payload_sha256
                packed_evidence.dirty_upload_ns = dirty_upload_ns
                packed_evidence.command_buffer_count = 1
                packed_evidence.submission_count = 0
                packed_evidence.fence_count = 0
                packed_evidence.descriptor_count = 1
                packed_evidence.oracle_mode = false
                self.dirty = true
                return packed_evidence

            var oracle_before: [u32] = []
            var oracle = SoftwareBackend.create()
            var packed_oracle_ns: i64 = 0
            if self.font_oracle_mode:
                oracle_before = _vulkan_font_bytes_to_pixels(
                    _vulkan_font_download(framebuffer, dst_count * 4), dst_count)
                if oracle_before.len() != dst_count:
                    vulkan_sffi_quarantine_unsubmitted_command(packed_command, 0, 0)
                    vulkan_sffi_quarantine_dependencies(packed_descriptor, packed_params, 0, 0)
                    return _vulkan_font_evidence(pipeline, "failed", "packed-font-oracle-seed-failed", self.d_font_atlas, packed_params, packed_descriptor, packed_command, batch.quads.len(), 1, false, false, framebuffer, 0, 0, 0, false)
                oracle.init(width, height)
                oracle.buf = oracle_before
                val oracle_started = clock.now_micros() * 1000
                for q in batch.quads:
                    val dst_x = font_destination_origin(origin_x, q.dst_x, q.width)
                    val dst_y = font_destination_origin(origin_y, q.dst_y, q.height)
                    val glyph_pixels = font_atlas_subrect_pixels(batch.atlas_pixels, batch.atlas_width, batch.atlas_height,
                        q.atlas_x, q.atlas_y, q.width, q.height, q.color)
                    oracle.draw_image_blend(dst_x.?, dst_y.?, q.width, q.height, glyph_pixels)
                packed_oracle_ns = vulkan_font_elapsed_ns(oracle_started, clock.now_micros() * 1000)
            val queue_started = clock.now_micros() * 1000
            val ended = vulkan_sffi_end_compute(packed_command)
            if not ended:
                vulkan_sffi_quarantine_unsubmitted_command(packed_command, 0, 0)
                vulkan_sffi_quarantine_dependencies(packed_descriptor, packed_params, 0, 0)
                self.completion_unknown = true
                return _vulkan_font_evidence(pipeline, "failed", "packed-font-command-end-failed", self.d_font_atlas, packed_params, packed_descriptor, packed_command, batch.quads.len(), 1, false, false, framebuffer, 0, 0, 0, false)
            val fence = vulkan_sffi_submit_and_wait_fence(packed_command)
            if fence < 0:
                vulkan_sffi_quarantine_dependencies(packed_descriptor, packed_params, 0, 0)
                self.completion_unknown = true
                return _vulkan_font_evidence(pipeline, "failed", "packed-font-completion-unknown", self.d_font_atlas, packed_params, packed_descriptor, packed_command, batch.quads.len(), 1, false, false, framebuffer, 0, 0, 0, false)
            val packed_queue_ns = vulkan_font_elapsed_ns(queue_started, clock.now_micros() * 1000)
            val sync_started = clock.now_micros() * 1000
            val waited = fence > 0 and vulkan_sffi_wait_fence(fence, 0)
            val packed_sync_ns = vulkan_font_elapsed_ns(sync_started, clock.now_micros() * 1000)
            val fence_destroyed = fence > 0 and vulkan_sffi_destroy_fence(fence)
            var after: [u32] = []
            var packed_readback_ns: i64 = 0
            if self.font_oracle_mode and waited:
                val readback_started = clock.now_micros() * 1000
                after = _vulkan_font_bytes_to_pixels(_vulkan_font_download(framebuffer, dst_count * 4), dst_count)
                packed_readback_ns = vulkan_font_elapsed_ns(readback_started, clock.now_micros() * 1000)
            val parity = self.font_oracle_mode and after.len() == dst_count and vulkan_font_pixels_equal(after, oracle.buf)
            val descriptor_destroyed = vulkan_sffi_destroy_descriptor_set(packed_descriptor)
            val params_freed = vulkan_sffi_free_buffer(packed_params)
            var executed = _vulkan_font_evidence(pipeline,
                if waited and (not self.font_oracle_mode or parity): "executed" else: "failed",
                if waited and (not self.font_oracle_mode or parity): "single-packed-font-submit" else: "packed-font-completion-or-parity-failed",
                self.d_font_atlas, packed_params, if descriptor_destroyed: -packed_descriptor else: packed_descriptor,
                packed_command, batch.quads.len(), 1, fence > 0, waited, framebuffer,
                if self.font_oracle_mode: dst_count * 4 else: 0,
                if self.font_oracle_mode: vulkan_font_pixels_checksum(after) else: 0,
                if self.font_oracle_mode: vulkan_font_pixels_checksum(oracle.buf) else: 0, parity)
            executed.batch_identity = font_render_batch_atlas_cache_identity(batch)
            executed.atlas_payload_sha256 = self.font_atlas_payload_sha256
            executed.dirty_upload_ns = dirty_upload_ns
            executed.command_buffer_count = 1
            executed.submission_count = if fence > 0: 1 else: 0
            executed.fence_count = if fence > 0: 1 else: 0
            executed.descriptor_count = 1
            executed.oracle_mode = self.font_oracle_mode
            executed.queue_device_ns = packed_queue_ns
            executed.sync_wait_ns = packed_sync_ns
            executed.present_readback_ns = packed_readback_ns
            executed.cpu_oracle_ns = packed_oracle_ns
            executed.readback_nonblank_pixels = vulkan_font_changed_pixel_count(oracle_before, after)
            if not descriptor_destroyed or not params_freed: executed.status = "failed"
            if waited: self.dirty = true
            return _vulkan_font_completion(executed, fence, fence > 0, fence_destroyed)
        if not self.frame_batching_enabled and self.d_font_params == 0:
            self.d_font_params = vulkan_sffi_alloc_buffer(VULKAN_FONT_PARAMS_BYTES, _VULKAN_STORAGE_BUFFER)
            if self.d_font_params == 0:
                return _vulkan_font_evidence(pipeline, "failed", "params-allocation-failed", self.d_font_atlas, 0, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)

        val resource_bytes = vulkan_font_gpu_resource_bytes(atlas_bytes, dst_count * 4, self.d_font_params > 0)
        if resource_bytes > self.font_gpu_resource_high_water_bytes:
            self.font_gpu_resource_high_water_bytes = resource_bytes

        val byte_count = dst_count * 4
        var before_bytes: [u8] = []
        var before: [u32] = []
        var oracle = SoftwareBackend.create()
        if self.font_oracle_mode:
            val initial_evidence_started = clock.now_micros() * 1000
            before_bytes = _vulkan_font_download(framebuffer, byte_count)
            before = _vulkan_font_bytes_to_pixels(before_bytes, dst_count)
            if before.len() != dst_count:
                return _vulkan_font_evidence(pipeline, "failed", "initial-device-readback-failed", self.d_font_atlas, self.d_font_params, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
            oracle.init(width, height)
            oracle.buf = before
            evidence_overhead_ns = evidence_overhead_ns + vulkan_font_elapsed_ns(initial_evidence_started, clock.now_micros() * 1000)

        var done: i64 = 0
        var last_params: i64 = 0
        var last_descriptor: i64 = 0
        val command = if self.frame_batching_enabled and self.pending_compute_command > 0:
            self.pending_compute_command
        else:
            vulkan_sffi_begin_compute()
        if command <= 0:
            return _vulkan_font_evidence(pipeline, "failed", "font-command-allocation-failed", self.d_font_atlas, self.d_font_params, 0, 0, batch.quads.len(), 0, false, false, framebuffer, 0, 0, 0, false)
        var descriptors: [i64] = []
        var params_handles: [i64] = []
        var last_fence: i64 = 0
        var last_fence_available = false
        var last_fence_destroyed = false
        var queue_device_ns: i64 = 0
        var sync_wait_ns: i64 = 0
        var cpu_oracle_ns: i64 = 0
        var prepared = true
        val use_warm_pool = self.frame_batching_enabled and not self.font_oracle_mode
        while done < batch.quads.len():
            val q = batch.quads[done]
            val total = q.width.to_i64() * q.height.to_i64()
            val groups = vulkan_font_dispatch_groups(total)
            val dst_x = font_destination_origin(origin_x, q.dst_x, q.width)
            val dst_y = font_destination_origin(origin_y, q.dst_y, q.height)
            val packed = vulkan_font_atlas_composite_params(batch.atlas_width, batch.atlas_height, batch.atlas_pixels.len(),
                q.atlas_x, q.atlas_y, q.width, q.height, width, height, dst_count, dst_x.?, dst_y.?, q.color)
            val pool_index = self.pending_font_params.len() + done
            var params: i64 = 0
            var descriptor: i64 = 0
            if use_warm_pool and pool_index < self.font_params_pool.len():
                params = self.font_params_pool[pool_index]
                descriptor = self.font_descriptor_pool[pool_index]
            elif use_warm_pool:
                params = vulkan_sffi_alloc_buffer(VULKAN_FONT_PARAMS_BYTES, _VULKAN_STORAGE_BUFFER)
                descriptor = vulkan_sffi_create_descriptor_set(pipeline.pipeline_handle)
                if params > 0 and descriptor > 0:
                    self.font_params_pool.push(params)
                    self.font_descriptor_pool.push(descriptor)
                    self.font_params_pool_capacity.push(VULKAN_FONT_PARAMS_BYTES)
                else:
                    if params > 0: vulkan_sffi_free_buffer(params)
                    if descriptor > 0: vulkan_sffi_destroy_descriptor_set(descriptor)
                    params = 0
                    descriptor = 0
            else:
                params = if not self.frame_batching_enabled and done == 0:
                    self.d_font_params
                else:
                    vulkan_sffi_alloc_buffer(VULKAN_FONT_PARAMS_BYTES, _VULKAN_STORAGE_BUFFER)
                descriptor = vulkan_sffi_create_descriptor_set(pipeline.pipeline_handle)
            val descriptors_ready = (params > 0 and descriptor > 0 and
                vulkan_sffi_copy_to_buffer(params, packed, 0) and
                vulkan_sffi_bind_buffer(descriptor, 0, self.d_font_atlas) and
                vulkan_sffi_bind_buffer(descriptor, 1, framebuffer) and
                vulkan_sffi_bind_buffer(descriptor, 2, params))
            last_params = params
            last_descriptor = descriptor
            if params > 0: params_handles.push(params)
            if descriptor > 0: descriptors.push(descriptor)
            prepared = (prepared and descriptors_ready and
                vulkan_sffi_bind_pipeline(command, pipeline.pipeline_handle) and
                vulkan_sffi_bind_descriptors(command, descriptor) and
                vulkan_sffi_dispatch(command, groups, 1, 1))
            if not prepared: break
            if self.font_oracle_mode:
                val pixels = font_atlas_subrect_pixels(batch.atlas_pixels, batch.atlas_width, batch.atlas_height,
                    q.atlas_x, q.atlas_y, q.width, q.height, q.color)
                val oracle_started = clock.now_micros() * 1000
                oracle.draw_image_blend(dst_x.?, dst_y.?, q.width, q.height, pixels)
                val oracle_elapsed = vulkan_font_elapsed_ns(oracle_started, clock.now_micros() * 1000)
                cpu_oracle_ns = cpu_oracle_ns + oracle_elapsed
                evidence_overhead_ns = evidence_overhead_ns + oracle_elapsed
            done = done + 1

        val live_params_count = params_handles.len() + (if self.frame_batching_enabled: self.pending_font_params.len() else: 0)
        val live_resource_bytes = vulkan_font_gpu_resource_bytes_for_params(
            atlas_bytes, dst_count * 4, live_params_count)
        if live_resource_bytes > self.font_gpu_resource_high_water_bytes:
            self.font_gpu_resource_high_water_bytes = live_resource_bytes

        if self.frame_batching_enabled and not self.font_oracle_mode and prepared and done == batch.quads.len():
            if self.pending_compute_command == 0:
                self.pending_compute_command = command
            if self.pending_font_descriptors.len() == 0:
                self.font_frame_command_count = self.font_frame_command_count + 1
            for descriptor in descriptors: self.pending_font_descriptors.push(descriptor)
            for params in params_handles: self.pending_font_params.push(params)
            self.pending_font_glyph_count = self.pending_font_glyph_count + batch.quads.len()
            val retained_params_count = self.pending_font_params.len() + (if self.d_font_params > 0: 1 else: 0)
            val retained_resource_bytes = vulkan_font_gpu_resource_bytes_for_params(
                atlas_bytes, dst_count * 4, retained_params_count)
            if retained_resource_bytes > self.font_gpu_resource_high_water_bytes:
                self.font_gpu_resource_high_water_bytes = retained_resource_bytes
            var recorded = _vulkan_font_evidence(pipeline, "recorded", "queued-in-frame-command",
                self.d_font_atlas, last_params, last_descriptor, command, batch.quads.len(), done,
                false, false, framebuffer, 0, 0, 0, false)
            recorded.batch_identity = font_render_batch_atlas_cache_identity(batch)
            recorded.atlas_payload_sha256 = self.font_atlas_payload_sha256
            recorded.dirty_upload_ns = dirty_upload_ns
            recorded.command_buffer_count = 1
            recorded.submission_count = 0
            recorded.fence_count = 0
            recorded.descriptor_count = descriptors.len()
            recorded.oracle_mode = false
            self.dirty = true
            return recorded

        prepared = prepared and done == batch.quads.len() and vulkan_sffi_end_compute(command)
        if not prepared:
            # Keep each handle under exactly one quarantine owner: the command
            # is retained separately from every descriptor and params buffer.
            vulkan_sffi_quarantine_unsubmitted_command(command, 0, 0)
            if not use_warm_pool:
                for descriptor in descriptors: vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
                for params in params_handles:
                    vulkan_sffi_quarantine_dependencies(0, params, 0, 0)
                    if params == self.d_font_params: self.d_font_params = 0
            if self.frame_batching_enabled:
                self._quarantine_pending_compute_descriptors()
                self._clear_pending_compute_state()
                self.completion_unknown = true
            return _vulkan_font_with_fallback(
                _vulkan_font_evidence(pipeline, "failed", "font-batch-record-failed", self.d_font_atlas, last_params, last_descriptor, command, batch.quads.len(), done, false, false, framebuffer, 0, 0, 0, false), before)

        val queue_device_started = clock.now_micros() * 1000
        val fence_result = vulkan_sffi_submit_and_wait_fence(command)
        queue_device_ns = vulkan_font_elapsed_ns(queue_device_started, clock.now_micros() * 1000)
        var submitted = fence_result > 0
        var completion_waited = false
        if submitted:
            last_fence = fence_result
            last_fence_available = true
            val sync_wait_started = clock.now_micros() * 1000
            completion_waited = vulkan_sffi_wait_fence(fence_result, 0)
            sync_wait_ns = vulkan_font_elapsed_ns(sync_wait_started, clock.now_micros() * 1000)
            last_fence_destroyed = vulkan_sffi_destroy_fence(fence_result)
        elif fence_result < 0:
            for descriptor in descriptors: vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
            for params in params_handles:
                vulkan_sffi_quarantine_dependencies(0, params, 0, 0)
                if params == self.d_font_params: self.d_font_params = 0
            val reason = if vulkan_classify_error(vulkan_sffi_last_error()) == VulkanErrorKind.DeviceLost: "device-lost" else: "fence-completion-unknown"
            return _vulkan_font_completion(_vulkan_font_with_fallback(
                _vulkan_font_evidence(pipeline, "failed", reason, self.d_font_atlas, last_params, last_descriptor, command, batch.quads.len(), done, false, false, framebuffer, 0, 0, 0, false), before), -1, false, false)

        var cleanup_ok = true
        var descriptor_cleanup_ok = true
        for descriptor in descriptors:
            val destroyed = vulkan_sffi_destroy_descriptor_set(descriptor)
            if not destroyed: vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
            descriptor_cleanup_ok = destroyed and descriptor_cleanup_ok
            cleanup_ok = destroyed and cleanup_ok
        var params_index: i64 = if self.frame_batching_enabled: 0 else: 1
        while params_index < params_handles.len():
            val freed = vulkan_sffi_free_buffer(params_handles[params_index])
            if not freed: vulkan_sffi_quarantine_dependencies(0, params_handles[params_index], 0, 0)
            cleanup_ok = freed and cleanup_ok
            params_index = params_index + 1
        if not submitted or not completion_waited or not last_fence_destroyed or not cleanup_ok:
            val reason = if not submitted: "font-batch-submit-failed" elif not completion_waited: "fence-wait-evidence-failed" elif not last_fence_destroyed: "fence-cleanup-failed" elif not descriptor_cleanup_ok: "descriptor-cleanup-failed" else: "params-cleanup-failed"
            return _vulkan_font_completion(_vulkan_font_with_fallback(
                _vulkan_font_evidence(pipeline, "failed", reason, self.d_font_atlas, last_params, if descriptor_cleanup_ok: -last_descriptor else: last_descriptor, command, batch.quads.len(), done, submitted, completion_waited, framebuffer, 0, 0, 0, false), before), last_fence, last_fence_available, last_fence_destroyed)

        val final_evidence_started = clock.now_micros() * 1000
        var after: [u32] = []
        var present_readback_ns: i64 = 0
        var device_checksum: i64 = 0
        var oracle_checksum: i64 = 0
        var parity = false
        if self.font_oracle_mode:
            val present_readback_started = clock.now_micros() * 1000
            after = _vulkan_font_bytes_to_pixels(_vulkan_font_download(framebuffer, byte_count), dst_count)
            present_readback_ns = vulkan_font_elapsed_ns(present_readback_started, clock.now_micros() * 1000)
            device_checksum = vulkan_font_pixels_checksum(after)
            oracle_checksum = vulkan_font_pixels_checksum(oracle.buf)
            parity = after.len() == dst_count and vulkan_font_pixels_equal(after, oracle.buf)
        var restored = true
        if self.font_oracle_mode and not parity:
            restored = vulkan_sffi_copy_to_buffer(framebuffer, before_bytes, 0)
        var completed = _vulkan_font_evidence(pipeline,
            if self.font_oracle_mode and parity: "executed-unpromoted" elif self.font_oracle_mode: "readback-mismatch" else: "executed",
            if self.font_oracle_mode and parity: "fence-and-device-identity-evidence-unavailable" elif self.font_oracle_mode and restored: "device-readback-does-not-match-cpu-oracle" elif self.font_oracle_mode: "partial-framebuffer-restore-failed" else: "single-submit-production-frame",
            self.d_font_atlas, last_params, -last_descriptor, command, batch.quads.len(), done,
            true, true, framebuffer,
            if self.font_oracle_mode and after.len() == dst_count: byte_count else: 0, device_checksum, oracle_checksum, parity)
        completed.batch_identity = font_render_batch_atlas_cache_identity(batch)
        completed.atlas_payload_sha256 = self.font_atlas_payload_sha256
        completed.dirty_upload_ns = dirty_upload_ns
        completed.queue_device_ns = queue_device_ns
        completed.sync_wait_ns = sync_wait_ns
        completed.present_readback_ns = present_readback_ns
        completed.cpu_oracle_ns = cpu_oracle_ns
        completed.readback_nonblank_pixels = vulkan_font_changed_pixel_count(before, after)
        completed.command_buffer_count = 1
        completed.submission_count = 1
        completed.fence_count = 1
        completed.descriptor_count = descriptors.len()
        completed.oracle_mode = self.font_oracle_mode
        var result = _vulkan_font_completion(completed, last_fence, last_fence_available, last_fence_destroyed)
        evidence_overhead_ns = evidence_overhead_ns + vulkan_font_elapsed_ns(final_evidence_started, clock.now_micros() * 1000)
        result.evidence_overhead_ns = evidence_overhead_ns
        if vulkan_order_trace_enabled():
            vulkan_order_trace("font-done status={result.status} reason={result.reason} parity={parity} promotion_ready={result.promotion_ready} dispatched={done}/{batch.quads.len()}")
        if result.device_executed:
            self.dirty = true
        result

export VULKAN_FONT_PARAMS_BYTES
export vulkan_font_atlas_composite_params
export vulkan_font_dispatch_groups, vulkan_font_atlas_replacement_status
export vulkan_font_pixels_checksum, vulkan_font_pixels_equal, vulkan_font_runtime_classification
export vulkan_font_promotion_ready
export vulkan_font_changed_pixel_count, vulkan_font_stage_evidence_ready
export vulkan_font_timed_ns
export vulkan_font_frame_batch_contract
export VULKAN_FONT_FRAME_GLYPH_CAP, vulkan_font_gpu_resource_bytes_for_params
export VULKAN_FONT_PACKED_HEADER_WORDS, VULKAN_FONT_PACKED_GLYPH_WORDS
export VULKAN_FONT_PACKED_MAX_BYTES, vulkan_font_packed_params
use std.gc_async_mut.gpu.engine2d.backend.{RenderBackend, Engine2DExtended}
