"""2D Engine — Stateless Emulation Layer: Advanced Operations

@tag:stdlib
@tag:api
@tag:gpu

Advanced rendering operations extracted from backend_emu.spl.
All functions are stateless and operate via RenderBackend.

Contains: scaled image, box blur, drop shadow, affine transform, and
blend mode rect.
"""

use std.gc_async_mut.gpu.engine2d.backend.{RenderBackend}
use std.gpu.engine2d.color.{color_r, color_g, color_b, color_a, rgba}
use std.gc_async_mut.gpu.engine2d.helpers.blur_kernel.{engine2d_blur_step_profile}
use std.gpu.engine2d.backend_emu_math.{_emu_min, _emu_max, _emu_overlay_ch, _emu_blend_over}

# ============================================================================
# Scaled Image — Nearest-neighbor resample
# ============================================================================

fn _emu_scale_image_pixels(dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]) -> [u32]:
    val src_count = src_w.to_i64() * src_h.to_i64()
    val dst_count = dst_w.to_i64() * dst_h.to_i64()
    if (dst_w <= 0 or dst_h <= 0 or src_w <= 0 or src_h <= 0 or
        src_count <= 0 or pixels.len().to_i64() != src_count or
        dst_count <= 0 or dst_count > 2147483647 or
        (dst_w.to_i64() - 1) * src_w.to_i64() > 2147483647 or
        (dst_h.to_i64() - 1) * src_h.to_i64() > 2147483647):
        return []
    var result: [u32] = [0u32; dst_count]
    var dy: i32 = 0
    while dy < dst_h:
        val sy = dy.to_i64() * src_h.to_i64() / dst_h.to_i64()
        var dx: i32 = 0
        while dx < dst_w:
            val sx = dx.to_i64() * src_w.to_i64() / dst_w.to_i64()
            val dst_index = dy.to_i64() * dst_w.to_i64() + dx.to_i64()
            val src_index = sy * src_w.to_i64() + sx
            result[dst_index] = pixels[src_index]
            dx = dx + 1
        dy = dy + 1
    result

fn _emu_scaled_image_destination_valid(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32) -> bool:
    val right = dst_x.to_i64() + dst_w.to_i64()
    val bottom = dst_y.to_i64() + dst_h.to_i64()
    right - 1 <= 2147483647 and bottom - 1 <= 2147483647

fn emu_draw_image_scaled(mut core: RenderBackend, dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
    if not _emu_scaled_image_destination_valid(dst_x, dst_y, dst_w, dst_h):
        return
    val result = _emu_scale_image_pixels(dst_w, dst_h, src_w, src_h, pixels)
    if result.len() == 0:
        return
    core.draw_image(dst_x, dst_y, dst_w, dst_h, result)

fn emu_draw_image_scaled_blend(mut core: RenderBackend, dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
    if not _emu_scaled_image_destination_valid(dst_x, dst_y, dst_w, dst_h):
        return
    val result = _emu_scale_image_pixels(dst_w, dst_h, src_w, src_h, pixels)
    if result.len() == 0:
        return
    emu_draw_image_blend(core, dst_x, dst_y, dst_w, dst_h, result)

fn emu_draw_image_blend(mut core: RenderBackend, x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
    if w <= 0 or h <= 0:
        return
    if core.name() == "cpu":
        core.draw_image_blend(x, y, w, h, pixels)
        return
    val fb_w = core.width()
    val fb_h = core.height()
    # The blend reads only the destination rectangle. The software backend
    # has a native region read that copies exactly those rows out of the SAME
    # `buf` its whole-frame `read_pixels` snapshots, so `region[py*w+px]`
    # equals `fb[fy*fb_w+fx]` for every in-bounds pixel -- the only pixels read
    # below. A whole-frame snapshot at 3840x2160 was 506 MB per blended glyph
    # quad. Other backends keep the whole-frame read: their region seam is the
    # trait default built on `read_pixels_with_source`, not `read_pixels`.
    var use_region = false
    var region: [u32] = []
    var fb: [u32] = []
    if core.name() == "software":
        region = core.read_pixels_region_raw(x, y, w, h)
        use_region = region.len().to_i64() == w.to_i64() * h.to_i64()
    if not use_region:
        fb = core.read_pixels()
    var result: [u32] = [0u32; w * h]
    var py: i32 = 0
    # cpu-lane-loop-ok: image blend scanline walk: one iteration per destination row
    while py < h:
        var px: i32 = 0
        # cpu-lane-loop-ok: image blend per-pixel column walk; designated CPU lane reference body per design section 6
        while px < w:
            val src = pixels[py * w + px]
            val sa = color_a(src)
            val fx = x + px
            val fy = y + py
            if fx >= 0 and fx < fb_w and fy >= 0 and fy < fb_h:
                if sa == 255:
                    result[py * w + px] = src
                else:
                    val dst = if use_region: region[py * w + px] else: fb[fy * fb_w + fx]
                    if sa == 0:
                        result[py * w + px] = dst
                    else:
                        result[py * w + px] = _emu_blend_over(color_r(src), color_g(src), color_b(src), sa, dst, false)
            px = px + 1
        py = py + 1
    core.draw_image(x, y, w, h, result)

# ============================================================================
# Box Blur — SEPARABLE sliding-window box blur over a framebuffer region.
#
# Output is bit-identical to the former full O(w*h*(2r+1)^2) square-window
# convolution, at O(w*h) work INDEPENDENT of radius. Why the separable form is
# exactly equivalent: the old code summed only in-bounds taps and divided by
# `cnt`, the number of in-bounds taps. In-bounds-ness factorises —
# a tap (fx, fy) is in bounds iff (0 <= fx < fb_w) AND (0 <= fy < fb_h) — so
# both the channel sums and the tap COUNT are separable. Pass 1 accumulates
# per-row horizontal sums *and* horizontal in-bounds counts; a source row whose
# fy is off-framebuffer contributes all-zero accumulators (count included), which
# reproduces the vertical clamping exactly. Pass 2 slides a vertical window over
# those per-row sums and counts, so the final `cnt` equals the old in-bounds tap
# count and `sum/cnt` uses the identical i32 division.
#
# Pass 1 covers source rows ri in 0 .. h+2*radius-1 (fy = y - radius + ri), so
# every row band 2 needs (ri in [py, py+2*radius], py < h) always exists and no
# clamping is required in band 2.
#
# Inlined color_r/g/b/a (2D-1 perf fix) is preserved: same bit math as
# color_r/g/b/a in color.spl, output-identical, but without 4 free-fn dispatches
# per tap in the interpreter.
# ============================================================================

fn emu_draw_blur_rect(mut core: RenderBackend, x: i32, y: i32, w: i32, h: i32, radius: i32):
    if w <= 0 or h <= 0 or radius <= 0:
        return
    val fb: [u32] = core.read_pixels()
    val fb_w = core.width()
    val fb_h = core.height()
    val rows = h + 2 * radius
    val span = rows * w
    var hr: [i32] = [0; span]
    var hg: [i32] = [0; span]
    var hb: [i32] = [0; span]
    var ha: [i32] = [0; span]
    var hc: [i32] = [0; span]
    var ri: i32 = 0
    # cpu-lane-loop-ok: box blur horizontal band row walk: one iteration per source row
    while ri < rows:
        val fy = y - radius + ri
        if fy >= 0 and fy < fb_h:
            val row_base = fy * fb_w
            val out_base = ri * w
            # Sliding window over fx in [x+px-radius, x+px+radius] ∩ [0, fb_w).
            var sr: i32 = 0
            var sg: i32 = 0
            var sb: i32 = 0
            var sa: i32 = 0
            var cnt: i32 = 0
            var fx = x - radius
            while fx <= x + radius:
                if fx >= 0 and fx < fb_w:
                    val p = fb[row_base + fx]
                    sr = sr + (((p >> 16) & 0xFFu32) as i32)
                    sg = sg + (((p >> 8) & 0xFFu32) as i32)
                    sb = sb + ((p & 0xFFu32) as i32)
                    sa = sa + (((p >> 24) & 0xFFu32) as i32)
                    cnt = cnt + 1
                fx = fx + 1
            var px: i32 = 0
            # cpu-lane-loop-ok: box blur horizontal per-pixel column walk; the blur body is explicitly designated a CPU lane reference in design section 6
            while px < w:
                hr[out_base + px] = sr
                hg[out_base + px] = sg
                hb[out_base + px] = sb
                ha[out_base + px] = sa
                hc[out_base + px] = cnt
                # Step the window one column right: drop the leaving column,
                # add the entering one.
                val leave = x + px - radius
                if leave >= 0 and leave < fb_w:
                    val pl = fb[row_base + leave]
                    sr = sr - (((pl >> 16) & 0xFFu32) as i32)
                    sg = sg - (((pl >> 8) & 0xFFu32) as i32)
                    sb = sb - ((pl & 0xFFu32) as i32)
                    sa = sa - (((pl >> 24) & 0xFFu32) as i32)
                    cnt = cnt - 1
                val enter = x + px + radius + 1
                if enter >= 0 and enter < fb_w:
                    val pe = fb[row_base + enter]
                    sr = sr + (((pe >> 16) & 0xFFu32) as i32)
                    sg = sg + (((pe >> 8) & 0xFFu32) as i32)
                    sb = sb + ((pe & 0xFFu32) as i32)
                    sa = sa + (((pe >> 24) & 0xFFu32) as i32)
                    cnt = cnt + 1
                px = px + 1
        ri = ri + 1
    var temp: [u32] = [0u32; w * h]
    var px2: i32 = 0
    # cpu-lane-loop-ok: box blur vertical band column walk: one iteration per destination column
    while px2 < w:
        var sr: i32 = 0
        var sg: i32 = 0
        var sb: i32 = 0
        var sa: i32 = 0
        var cnt: i32 = 0
        var k: i32 = 0
        while k <= 2 * radius:
            val idx = k * w + px2
            sr = sr + hr[idx]
            sg = sg + hg[idx]
            sb = sb + hb[idx]
            sa = sa + ha[idx]
            cnt = cnt + hc[idx]
            k = k + 1
        var py: i32 = 0
        # cpu-lane-loop-ok: box blur vertical per-pixel scanline walk; the blur body is explicitly designated a CPU lane reference in design section 6
        while py < h:
            if cnt > 0:
                temp[py * w + px2] = rgba(sr / cnt, sg / cnt, sb / cnt, sa / cnt)
            # Step the vertical window one row down over the band-1 rows.
            val leave = py * w + px2
            val enter = (py + 2 * radius + 1) * w + px2
            sr = sr - hr[leave]
            sg = sg - hg[leave]
            sb = sb - hb[leave]
            sa = sa - ha[leave]
            cnt = cnt - hc[leave]
            if py + 2 * radius + 1 < rows:
                sr = sr + hr[enter]
                sg = sg + hg[enter]
                sb = sb + hb[enter]
                sa = sa + ha[enter]
                cnt = cnt + hc[enter]
            py = py + 1
        px2 = px2 + 1
    core.draw_image(x, y, w, h, temp)

# ============================================================================
# Drop Shadow — Offset + blur + blend compose
# ============================================================================

# A blur of an AXIS-ALIGNED rect is exactly separable, so the 2D coverage is
# the outer product of the x and y profiles. That is why no 2D mask is ever
# materialized: the cost is O(w + h) profile work plus one composite band.
# One axis of the shadow coverage (0..255): the step [offset, offset + span) over n
# samples, blurred with sigma = blur_r / 2 by Chrome 159's Skia kernel (the
# raster painter shares it).
fn _emu_shadow_profile(n: i32, offset: i32, span: i32, blur_r: i32) -> [i32]:
    engine2d_blur_step_profile(offset, offset + span, 0, n, blur_r * 500)

# Standard CSS drop shadow: rasterize the shadow rect as an ALPHA COVERAGE
# field, blur that coverage, then composite the shadow colour through it.
#
# The previous implementation filled an OPAQUE rect expanded by blur_r and then
# blurred the already-filled area in place. Blurring a uniformly filled region
# returns the same uniform region, so the shadow was a hard band with no edge
# falloff at all.
#
# Coverage crosses 1/2 exactly ON the shadow rect edge, which is the CSS/Chrome
# definition.
# One shadow pixel: colour (sr, sg, sb) at coverage `cov` over `dst`. Over an
# opaque destination this is the integer formula the Vulkan kernel twins;
# over a translucent one (an opacity group or other transparent offscreen)
# it is Chrome's src-over, so the shadow keeps its own alpha there.
fn _emu_shadow_px(sr: i32, sg: i32, sb: i32, cov: i32, dst: u32) -> u32:
    if ((dst >> 24) & 0xFFu32) != 0xFFu32:
        return _emu_blend_over(sr, sg, sb, cov, dst, true)
    val rr = (sr * cov + (((dst >> 16) & 0xFFu32) as i32) * (255 - cov)) / 255
    val rg = (sg * cov + (((dst >> 8) & 0xFFu32) as i32) * (255 - cov)) / 255
    val rb = (sb * cov + ((dst & 0xFFu32) as i32) * (255 - cov)) / 255
    0xFF000000u32 | ((rr as u32) << 16) | ((rg as u32) << 8) | (rb as u32)

fn emu_draw_shadow_rect(mut core: RenderBackend, x: i32, y: i32, w: i32, h: i32, offset_x: i32, offset_y: i32, blur_r: i32, color: u32):
    emu_draw_shadow_rect_outside(core, x, y, w, h, offset_x, offset_y, blur_r, color, 0, 0, 0, 0)

# emu_draw_shadow_rect with the pixels of the hole (hx, hy, hw, hh) left as
# they are. The Draw IR box painter passes the part of the border box that it
# repaints opaque or restores (an outer shadow is clipped to outside the
# border box), so a box taller than the frame -- 852 x 16939 CSS px is the
# whole frame at device scale 4 -- composites, reads and writes only the
# falloff bands beside it instead of its whole in-frame interior.
fn emu_draw_shadow_rect_outside(mut core: RenderBackend, x: i32, y: i32, w: i32, h: i32, offset_x: i32, offset_y: i32, blur_r: i32, color: u32, hx: i32, hy: i32, hw: i32, hh: i32):
    if w <= 0 or h <= 0:
        return
    val sx = x + offset_x
    val sy = y + offset_y
    var shadow_a = ((color >> 24) & 0xFFu32) as i32
    if shadow_a == 0:
        # Legacy callers band a bare 0x00RRGGBB; keep those opaque.
        shadow_a = 255
    if blur_r <= 0:
        core.draw_rect_filled(sx, sy, w, h, color)
        return
    # Pad by 2*blur_r so the whole falloff (half-support ~1.5*blur_r) fits.
    val pad = 2 * blur_r
    val mx = sx - pad
    val my = sy - pad
    val mw = w + 2 * pad
    val mh = h + 2 * pad
    if mw <= 0 or mh <= 0:
        return
    # Only the part of the shadow region inside the surface is ever written
    # (draw_image clips), so only that part is read and composited.
    val fb_w = core.width()
    val fb_h = core.height()
    val cx0 = if mx < 0: 0 else: mx
    val cy0 = if my < 0: 0 else: my
    val cx1 = if mx + mw > fb_w: fb_w else: mx + mw
    val cy1 = if my + mh > fb_h: fb_h else: my + mh
    if cx1 <= cx0 or cy1 <= cy0:
        return
    # Each axis is sampled over the in-frame span only: a sample depends on
    # the step and the fixed-support kernel, not on the sampled span, so a
    # 67908 px tall box costs its in-frame rows, not its height.
    val prof_x = engine2d_blur_step_profile(sx, sx + w, cx0, cx1, blur_r * 500)
    val prof_y = engine2d_blur_step_profile(sy, sy + h, cy0, cy1, blur_r * 500)
    val sr = ((color >> 16) & 0xFFu32) as i32
    val sg = ((color >> 8) & 0xFFu32) as i32
    val sb = (color & 0xFFu32) as i32
    val h0x = _emu_max(hx, cx0)
    val h1x = _emu_min(hx + hw, cx1)
    val h0y = _emu_max(hy, cy0)
    val h1y = _emu_min(hy + hh, cy1)
    if hw <= 0 or hh <= 0 or h1x <= h0x or h1y <= h0y:
        _emu_shadow_band(core, cx0, cy0, cx1 - cx0, cy1 - cy0,
            prof_x, cx0, prof_y, cy0, sr, sg, sb, shadow_a)
        return
    # Above and below the hole at full width, then left and right of it.
    _emu_shadow_band(core, cx0, cy0, cx1 - cx0, h0y - cy0,
        prof_x, cx0, prof_y, cy0, sr, sg, sb, shadow_a)
    _emu_shadow_band(core, cx0, h1y, cx1 - cx0, cy1 - h1y,
        prof_x, cx0, prof_y, cy0, sr, sg, sb, shadow_a)
    _emu_shadow_band(core, cx0, h0y, h0x - cx0, h1y - h0y,
        prof_x, cx0, prof_y, cy0, sr, sg, sb, shadow_a)
    _emu_shadow_band(core, h1x, h0y, cx1 - h1x, h1y - h0y,
        prof_x, cx0, prof_y, cy0, sr, sg, sb, shadow_a)

# Composite colour (sr, sg, sb) at alpha `shadow_a` through the separable
# coverage over the frame rect (bx, by, bw, bh): prof_x[i] is the coverage of
# column px0 + i and prof_y[j] of row py0 + j. Only the rows and columns with
# non-zero coverage are read and written.
fn _emu_shadow_band(mut core: RenderBackend, bx: i32, by: i32, bw: i32, bh: i32, prof_x: [i32], px0: i32, prof_y: [i32], py0: i32, sr: i32, sg: i32, sb: i32, shadow_a: i32):
    if bw <= 0 or bh <= 0:
        return
    # Columns whose coverage is non-zero (nz0..nz1) and full (i0..i1), in
    # band columns. A blurred step rises, holds 255, then falls, so both are
    # one run; outside nz0..nz1 the pixel stays the destination, and inside
    # i0..i1 the coverage is one constant per row.
    var nz0 = bw
    var nz1 = 0
    var i0 = bw
    var i1 = 0
    var c = 0
    while c < bw:  # cpu-lane-loop-ok: one iteration per profile sample, O(w) not O(w*h)
        val p = prof_x[bx - px0 + c]
        if p > 0:
            if c < nz0:
                nz0 = c
            nz1 = c + 1
        if p == 255:
            if c < i0:
                i0 = c
            i1 = c + 1
        c = c + 1
    if nz1 <= nz0:
        return
    if i1 <= i0:
        i0 = nz1
        i1 = nz1
    var r0 = bh
    var r1 = 0
    var r = 0
    while r < bh:  # cpu-lane-loop-ok: one iteration per profile sample, O(h) not O(w*h)
        if prof_y[by - py0 + r] > 0:
            if r < r0:
                r0 = r
            r1 = r + 1
        r = r + 1
    if r1 <= r0:
        return
    # Region columns: [0, cw) is band columns [nz0, nz1).
    val cw = nz1 - nz0
    val rh = r1 - r0
    val e0 = i0 - nz0
    val e1 = i1 - nz0
    val col_off = bx + nz0 - px0
    # `src` is only ever read and `outp` only ever written: the interpreter
    # re-decodes an array's whole backing store when a slice/min/max read
    # follows a write to it, so mixing both on one array costs O(region) per
    # row. A composed row is built in the row-sized `line` for the same reason.
    val src: [u32] = core.read_pixels_region_raw(bx + nz0, by + r0, cw, rh)
    var outp: [u32] = src
    var line: [u32] = []
    var prev_cur: [u32] = []
    var prev_cov_y = -1
    # _emu_shadow_px memo: memo_out[cov] is the pixel for destination
    # memo_dst[cov] (-1 = none). Exact: the colour is fixed for the call.
    var memo_dst: [i64] = [-1; 256]
    var memo_out: [u32] = [0u32; 256]
    # Last composed falloff segment per band (0 left, 1 right): the same
    # coverage row over the same destination composes the same pixels.
    var ecov0 = -1
    var esrc0: [u32] = []
    var eout0: [u32] = []
    var ecov1 = -1
    var esrc1: [u32] = []
    var eout1: [u32] = []
    var row = 0
    while row < rh:  # cpu-lane-loop-ok: one iteration per shadow-region row
        val cov_y = prof_y[by + r0 + row - py0]
        if cov_y > 0:
            val row_base = row * cw
            val cur = src.slice(row_base, row_base + cw)
            # A row with the coverage of the last composed row over the same
            # destination composes the same pixels: one native compare and
            # one span instead of a per-pixel pass.
            if not (cov_y == prev_cov_y and cur == prev_cur):
                line = cur
                # Interior: coverage is one constant for the whole row segment.
                val icov = ((255 * cov_y + 127) / 255 * shadow_a + 127) / 255
                if icov > 0 and e1 > e0:
                    val dst = cur[e0]
                    if cur.slice(e0, e1) == [dst; e1 - e0]:
                        # Uniform destination: one pixel formula, one bulk span.
                        val fill_row: [u32] = [_emu_shadow_px(sr, sg, sb, icov, dst); e1 - e0]
                        line.write_span(fill_row, e0 as i64, 0, (e1 - e0) as i64)
                    else:
                        # Destination varies: 64-px chunks; a uniform chunk
                        # (one native compare) is one span, else per pixel.
                        var ix = e0
                        while ix < e1:  # cpu-lane-loop-ok: one iteration per 64-px chunk
                            val cend = if ix + 64 < e1: ix + 64 else: e1
                            val d0 = cur[ix]
                            if memo_dst[icov] != (d0 as i64):
                                memo_dst[icov] = d0 as i64
                                memo_out[icov] = _emu_shadow_px(sr, sg, sb, icov, d0)
                            if cur[cend - 1] == d0 and cur.slice(ix, cend) == [d0; cend - ix]:
                                line.write_span([memo_out[icov]; cend - ix], ix as i64, 0, (cend - ix) as i64)
                                ix = cend
                            else:
                                while ix < cend:  # cpu-lane-loop-ok: destination varies within this chunk
                                    val d = cur[ix]
                                    if memo_dst[icov] != (d as i64):
                                        memo_dst[icov] = d as i64
                                        memo_out[icov] = _emu_shadow_px(sr, sg, sb, icov, d)
                                    line[ix] = memo_out[icov]
                                    ix = ix + 1
                # Edges: the falloff bands, per pixel.
                var band = 0
                while band < 2:  # cpu-lane-loop-ok: two edge bands per row
                    var px = if band == 0: 0 else: e1
                    val pend = if band == 0: e0 else: cw
                    if pend > px:
                        val seg = cur.slice(px, pend)
                        val hit = if band == 0: cov_y == ecov0 and seg == esrc0 else: cov_y == ecov1 and seg == esrc1
                        if hit:
                            line.write_span(if band == 0: eout0 else: eout1, px as i64, 0, (pend - px) as i64)
                        else:
                            val seg_start = px
                            while px < pend:  # cpu-lane-loop-ok: falloff band only, not the whole row
                                val cov = ((prof_x[px + col_off] * cov_y + 127) / 255 * shadow_a + 127) / 255
                                if cov > 0:
                                    val d = cur[px]
                                    if memo_dst[cov] != (d as i64):
                                        memo_dst[cov] = d as i64
                                        memo_out[cov] = _emu_shadow_px(sr, sg, sb, cov, d)
                                    line[px] = memo_out[cov]
                                px = px + 1
                            val out_seg = line.slice(seg_start, pend)
                            if band == 0:
                                ecov0 = cov_y
                                esrc0 = seg
                                eout0 = out_seg
                            else:
                                ecov1 = cov_y
                                esrc1 = seg
                                eout1 = out_seg
                    band = band + 1
                prev_cur = cur
                prev_cov_y = cov_y
            outp.write_span(line, row_base as i64, 0, cw as i64)
        row = row + 1
    core.draw_image(bx + nz0, by + r0, cw, rh, outp)

# ============================================================================
# Affine Transform Image — Per-pixel inverse transform sample
# ============================================================================

fn emu_draw_image_transform(mut core: RenderBackend, dst_x: i32, dst_y: i32, src_w: i32, src_h: i32, a: i32, b: i32, c: i32, d: i32, tx: i32, ty: i32, pixels: [u32]):
    if src_w <= 0 or src_h <= 0:
        return
    val det = a * d - b * c
    if det == 0:
        return
    val bx1 = _emu_min(_emu_min(0, a * src_w), _emu_min(b * src_h, a * src_w + b * src_h)) / 256
    val by1 = _emu_min(_emu_min(0, c * src_w), _emu_min(d * src_h, c * src_w + d * src_h)) / 256
    val bx2 = _emu_max(_emu_max(0, a * src_w), _emu_max(b * src_h, a * src_w + b * src_h)) / 256
    val by2 = _emu_max(_emu_max(0, c * src_w), _emu_max(d * src_h, c * src_w + d * src_h)) / 256
    val out_w = bx2 - bx1 + 1
    val out_h = by2 - by1 + 1
    if out_w <= 0 or out_h <= 0:
        return
    var result: [u32] = [0u32; out_w * out_h]
    var py: i32 = 0
    while py < out_h:
        var px: i32 = 0
        while px < out_w:
            val ox = (bx1 + px) * 256 - tx
            val oy = (by1 + py) * 256 - ty
            val sx = (d * ox - b * oy) / det
            val sy = (-c * ox + a * oy) / det
            if sx >= 0 and sx < src_w and sy >= 0 and sy < src_h:
                result[py * out_w + px] = pixels[sy * src_w + sx]
            px = px + 1
        py = py + 1
    core.draw_image(dst_x + bx1, dst_y + by1, out_w, out_h, result)

# ============================================================================
# Blend Mode Rect — Read + compute + write with mode selection
# mode: 0=src-over, 1=multiply, 2=screen, 3=overlay, 4=additive
# NOTE 4 (additive) is clamped saturating add and is NOT the same as 2 (screen):
# additive clips at 255, screen approaches it asymptotically. Do not substitute
# one for the other - game additive blending relies on the clipping behaviour.
# ============================================================================

fn emu_draw_rect_blend_mode(mut core: RenderBackend, x: i32, y: i32, w: i32, h: i32, color: u32, mode: i32):
    if w <= 0 or h <= 0:
        return
    val fb: [u32] = core.read_pixels()
    val fb_w = core.width()
    val fb_h = core.height()
    val sr = color_r(color)
    val sg = color_g(color)
    val sb = color_b(color)
    val sa = color_a(color)
    var result: [u32] = [0u32; w * h]
    var py: i32 = 0
    # cpu-lane-loop-ok: blend-mode rect scanline walk: one iteration per destination row
    while py < h:
        var px: i32 = 0
        # cpu-lane-loop-ok: blend-mode rect per-pixel column walk; CPU lane reference body for the GPU blend-mode shader
        while px < w:
            val fx = x + px
            val fy = y + py
            if fx >= 0 and fx < fb_w and fy >= 0 and fy < fb_h:
                val dst = fb[fy * fb_w + fx]
                val dr = color_r(dst)
                val dg = color_g(dst)
                val db = color_b(dst)
                val da = color_a(dst)
                var rr: i32 = sr
                var rg: i32 = sg
                var rb: i32 = sb
                if mode == 1:
                    rr = sr * dr / 255
                    rg = sg * dg / 255
                    rb = sb * db / 255
                else if mode == 2:
                    rr = 255 - (255 - sr) * (255 - dr) / 255
                    rg = 255 - (255 - sg) * (255 - dg) / 255
                    rb = 255 - (255 - sb) * (255 - db) / 255
                else if mode == 3:
                    rr = _emu_overlay_ch(sr, dr)
                    rg = _emu_overlay_ch(sg, dg)
                    rb = _emu_overlay_ch(sb, db)
                else if mode == 4:
                    rr = _emu_min(255, sr + dr)
                    rg = _emu_min(255, sg + dg)
                    rb = _emu_min(255, sb + db)
                val out_r = dr + (rr - dr) * sa / 255
                val out_g = dg + (rg - dg) * sa / 255
                val out_b = db + (rb - db) * sa / 255
                result[py * w + px] = rgba(out_r, out_g, out_b, _emu_max(sa, da))
            px = px + 1
        py = py + 1
    core.draw_image(x, y, w, h, result)
