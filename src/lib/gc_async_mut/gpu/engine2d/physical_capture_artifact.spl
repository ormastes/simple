# Controlled rectangle Engine2D artifact adapter. This accepts only the live
# owner-bound strict Vulkan capture; the shared pair contract still reports a
# matching pair as a candidate until independent provenance is verified.

use std.gc_async_mut.gpu.engine2d.final_output_capture.{
    Engine2dStrictVulkanCapturedFrame}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_selected_device_identity_v1,
    vulkan_sffi_selected_device_type}
use common.renderdoc.final_output_pixels.{final_output_validate}
use common.renderdoc.physical_vulkan_2d_qualification.{
    CONTROLLED_RECT_FIXTURE_PATH, CONTROLLED_RECT_FIXTURE_SHA256,
    CONTROLLED_CLIP_FIXTURE_PATH, CONTROLLED_CLIP_FIXTURE_SHA256,
    PreparedRenderScene, VulkanBackendCaptureArtifact}

fn _engine2d_controlled_artifact(
    captured: Engine2dStrictVulkanCapturedFrame,
    scene: PreparedRenderScene,
    fixture_id: text, scene_scope: text,
    fixture_path: text, fixture_sha256: text
) -> Result<VulkanBackendCaptureArtifact, text>:
    """Bind one controlled capture to its still-live Vulkan owner."""
    if (scene.fixture_id != fixture_id or
        scene.scene_scope != scene_scope or
        scene.source_path != fixture_path or
        scene.source_sha256 != fixture_sha256 or
        scene.render_degraded or scene.degrade_reason != ""):
        return Err("Engine2D controlled rectangle scene invalid")
    val pixels = captured.capture
    if (pixels.metadata.fixture_id != scene.fixture_id or
        pixels.metadata.fixture_digest != scene.source_sha256 or
        pixels.metadata.device_status != "ready" or
        pixels.metadata.width != 16 or pixels.metadata.height != 16 or
        pixels.metadata.crop_x != 0 or pixels.metadata.crop_y != 0 or
        pixels.metadata.crop_width != 16 or pixels.metadata.crop_height != 16):
        return Err("Engine2D controlled rectangle capture domain mismatch")
    val expected_resource = "engine2d-vulkan-framebuffer-{captured.backend_handle}"
    val expected_completion = "{captured.device_identity}:{captured.submission_generation}"
    if (pixels.metadata.resource_id != expected_resource or
        pixels.metadata.submission_token != expected_completion or
        pixels.metadata.completion_token != expected_completion):
        return Err("Engine2D controlled rectangle capture owner mismatch")
    match final_output_validate(pixels):
        case Err(err): return Err("Engine2D controlled rectangle capture invalid: " + err.code)
        case Ok(_): ()
    if (captured.engine.backend_name() != "vulkan" or
        captured.device_identity <= 0 or captured.backend_handle <= 0 or
        captured.submission_generation <= 0 or captured.submit_count <= 0 or
        captured.fence_count <= 0 or captured.readback_source != "device_readback" or
        not (captured.device_type == "discrete" or
             captured.device_type == "integrated") or
        captured.device_name == "" or captured.driver_identity == ""):
        return Err("Engine2D physical Vulkan capture owner incomplete")
    if (captured.engine.vulkan_submission_generation() != captured.submission_generation or
        captured.engine.vulkan_device_identity() != captured.device_identity or
        captured.engine.vulkan_device_name() != captured.device_name or
        captured.engine.vulkan_device_type() != captured.device_type or
        captured.engine.vulkan_driver_identity() != captured.driver_identity):
        return Err("Engine2D physical Vulkan capture owner changed")
    if val Some(frame) = captured.engine.latest_vulkan_frame_receipt():
        if (not frame.completion_known or frame.cpu_fallback_used or
            frame.backend_handle != captured.backend_handle or
            frame.device_identity != captured.device_identity or
            frame.device_fence_count != captured.submission_generation or
            frame.device_submit_count < captured.submit_count or
            frame.device_fence_count < captured.fence_count or
            frame.framebuffer_width.to_i64() != pixels.metadata.width or
            frame.framebuffer_height.to_i64() != pixels.metadata.height):
            return Err("Engine2D physical Vulkan frame receipt changed")
    else:
        return Err("Engine2D physical Vulkan frame receipt absent")
    val identity = vulkan_sffi_selected_device_identity_v1(
        captured.device_identity)?
    if (identity.device_uuid != captured.device_uuid or
        identity.driver_uuid != captured.driver_uuid or
        vulkan_sffi_selected_device_type() != captured.device_type or
        captured.engine.vulkan_submission_generation() != captured.submission_generation):
        return Err("Engine2D selected physical Vulkan identity changed")
    Ok(VulkanBackendCaptureArtifact(
        backend_id: "engine2d-vulkan", fixture_id: scene.fixture_id,
        fixture_sha256: scene.source_sha256,
        # Authentication here is local to Engine2D's live owner. It does not
        # promote the cross-backend pair beyond the shared candidate verdict.
        producer_authenticated: true, provider_identity: 0,
        device_name: captured.device_name, device_type: captured.device_type,
        driver_identity: captured.driver_identity,
        physical_device_uuid: captured.device_uuid,
        driver_uuid: captured.driver_uuid,
        device_identity: captured.device_identity,
        backend_handle: captured.backend_handle,
        submit_count: captured.submit_count, fence_count: captured.fence_count,
        readback_source: captured.readback_source, fallback_required: false,
        capture: Some(pixels)))

pub fn engine2d_controlled_rectangle_artifact(
    captured: Engine2dStrictVulkanCapturedFrame,
    scene: PreparedRenderScene
) -> Result<VulkanBackendCaptureArtifact, text>:
    """Bind the v1 opaque rectangle capture to its live Vulkan owner."""
    _engine2d_controlled_artifact(captured, scene,
        "controlled-opaque-rect-v1", "controlled-rectangle-only",
        CONTROLLED_RECT_FIXTURE_PATH, CONTROLLED_RECT_FIXTURE_SHA256)

pub fn engine2d_controlled_clip_artifact(
    captured: Engine2dStrictVulkanCapturedFrame,
    scene: PreparedRenderScene
) -> Result<VulkanBackendCaptureArtifact, text>:
    """Bind the v2 clipped rectangle capture to its live Vulkan owner."""
    _engine2d_controlled_artifact(captured, scene,
        "controlled-clipped-rect-v2", "controlled-clipped-rectangle-only",
        CONTROLLED_CLIP_FIXTURE_PATH, CONTROLLED_CLIP_FIXTURE_SHA256)
