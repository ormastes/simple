# Target-owned exact box-blur execution seam.

@cfg("os", "simpleos")
extern fn rt_engine2d_box_blur_region(
    pixels: [u32], fb_w: i64, fb_h: i64,
    x: i64, y: i64, w: i64, h: i64, radius: i64
) -> [u32]

@cfg("os", "simpleos")
fn engine2d_blur_pixels_target(
    pixels: [u32], fb_w: i32, fb_h: i32,
    x: i32, y: i32, w: i32, h: i32, radius: i32
) -> [u32]:
    rt_engine2d_box_blur_region(
        pixels, fb_w.to_i64(), fb_h.to_i64(),
        x.to_i64(), y.to_i64(), w.to_i64(), h.to_i64(), radius.to_i64())

@cfg(macos or linux or windows or freebsd or openbsd or netbsd or android)
use std.gpu.engine2d.backend_emu_adv.{_emu_blur_rect_pixels}

@cfg(macos or linux or windows or freebsd or openbsd or netbsd or android)
fn engine2d_blur_pixels_target(
    pixels: [u32], fb_w: i32, fb_h: i32,
    x: i32, y: i32, w: i32, h: i32, radius: i32
) -> [u32]:
    _emu_blur_rect_pixels(pixels, fb_w, fb_h, x, y, w, h, radius)
