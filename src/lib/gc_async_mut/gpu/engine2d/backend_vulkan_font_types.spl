class VulkanFontPipelineEvidence:
    status: text
    reason: text
    artifact_mode: text
    shader_handle: i64
    pipeline_handle: i64
    device_name: text
    device_type: text
    driver_identity: text
    artifact_identity: text = ""
    entry_name: text = ""
    program_version: i64 = 0
    emission_compile_ns: i64 = 0

class VulkanFontCompositeEvidence:
    status: text
    reason: text
    artifact_mode: text
    shader_handle: i64
    pipeline_handle: i64
    atlas_buffer_handle: i64
    params_buffer_handle: i64
    descriptor_handle: i64
    descriptor_created: bool
    descriptor_destroyed: bool
    command_handle: i64
    quad_count: i64
    dispatch_count: i64
    submitted: bool
    completion_waited: bool
    fence_handle: i64
    fence_evidence_available: bool
    fence_destroyed: bool
    device_name: text
    device_type: text
    driver_identity: text
    readback_source: text
    readback_buffer_handle: i64
    readback_byte_count: i64
    device_checksum: i64
    oracle_checksum: i64
    parity: bool
    device_executed: bool
    promotion_ready: bool
    elapsed_ns: i64 = 0
    # How many overlap-free dispatches this batch was split into. 1 means the
    # batch's quads never overlapped and it took the single-dispatch path
    # unchanged; >1 means `vulkan_font_partition_quads` separated glyphs that
    # would otherwise have raced on a shared destination word.
    sub_batch_count: i64 = 1
    evidence_overhead_ns: i64 = 0
    atlas_upload_count: i64 = 0
    atlas_upload_bytes: i64 = 0
    gpu_resource_high_water_bytes: i64 = 0
    fallback_pixels: [u32] = []
    artifact_identity: text = ""
    entry_name: text = ""
    program_version: i64 = 0
    emission_compile_ns: i64 = 0
    batch_identity: text = ""
    atlas_payload_sha256: text = ""
    dirty_upload_ns: i64 = 0
    queue_device_ns: i64 = 0
    sync_wait_ns: i64 = 0
    present_readback_ns: i64 = 0
    cpu_oracle_ns: i64 = 0
    present_mode: text = ""
    readback_nonblank_pixels: i64 = 0
    command_buffer_count: i64 = 0
    submission_count: i64 = 0
    fence_count: i64 = 0
    descriptor_count: i64 = 0
    oracle_mode: bool = false

    me clear_fallback_pixels():
        self.fallback_pixels = []

# --- Shared Vulkan font-lane constants ---------------------------------------
# These lived in backend_vulkan.spl / backend_vulkan_font.spl, but those two
# modules import each other. Class and fn imports tolerate that cycle; a
# module-level val import from a still-loading module does not, so every val
# crossing that edge is defined once here (this module imports nothing) and
# re-exported by both sides.

# Parked host mirrors, one per font owner besides the active one. Matches the
# producer's `FONT_ATLAS_PARK_MAX` (11 parks + 1 active = 12 owners): a mirror
# evicted while the producer still holds that owner's atlas costs a full
# 1,048,576-pixel repack on the owner's next run.
val VULKAN_FONT_ATLAS_MIRROR_MAX: i32 = 11

# Timing-bucket ids for the font pipeline (see vulkan_timing_add).
val VK_T_FONT_COMPOSITE: i64 = 22
val VK_T_FONT_ATLAS_BUILD: i64 = 23
# Sub-steps of `composite_font_batch`, which the first attribution run measured
# at 27.3 s across 5 calls on a 300x253 page -- 58% of the whole frame.
val VK_T_FONT_ATLAS_PACK: i64 = 24
val VK_T_FONT_ATLAS_UPLOAD: i64 = 25
val VK_T_FONT_ATLAS_DIGEST: i64 = 26
val VK_T_FONT_PACKED_PARAMS: i64 = 27
val VK_T_FONT_QUAD_VALIDATE: i64 = 28
val VK_T_FONT_OWNER_IDENTITY: i64 = 29

# Provenance values recorded on VulkanBackend.last_text_path: which lane a text
# draw took. They sit beside the readback-provenance vocabulary
# (`completion_unknown` / `readback_failed` / `cpu_fallback` / `device_readback`
# / `host_cache_after_device_copy`) but describe a DIFFERENT axis, so they are
# deliberately distinct strings and never mix with `readback_source`.
val VULKAN_TEXT_PATH_CPU_RASTER: text = "cpu-raster-blit"
# No lane ran at all: the surface was quarantined by `completion_unknown`, so
# the draw was dropped exactly as every other primitive drops it.
val VULKAN_TEXT_PATH_NOT_DRAWN: text = "not-drawn"

# Timing-bucket ids for the submit/enqueue/SFFI pipeline (see vulkan_timing_add).
# Same cycle-breaking move as the font buckets above: backend_vulkan_helpers.spl
# and backend_vulkan.spl import each other, and vals cannot cross that edge.
val VK_T_ENQUEUE: i64 = 9
val VK_T_FLUSH: i64 = 10
val VK_T_SFFI_BEGIN: i64 = 11
val VK_T_SFFI_REAP: i64 = 12
val VK_T_SFFI_DESC: i64 = 13
val VK_T_SFFI_BIND_PIPE: i64 = 14
val VK_T_SFFI_BIND_DESC: i64 = 15
val VK_T_SFFI_PUSH: i64 = 16
val VK_T_SFFI_DISPATCH: i64 = 17
val VK_T_SFFI_END: i64 = 18
val VK_T_SFFI_SUBMIT: i64 = 19
val VK_T_SFFI_WAIT_FENCE: i64 = 20

# Dispatch completion status / batching thresholds. Moved out of
# backend_vulkan_helpers.spl for the same mutual-import reason.
val VK_DISPATCH_COMPLETED_INELIGIBLE: i64 = 2
# Below this the single-rect lane is cheaper: one dispatch costs a buffer
# upload and a whole-bounding-box grid, which a lone rect does not amortise.
val RECT_BATCH_MIN_RECTS: i64 = 2
val VK_IMAGE_COMPOSITE_COPY: i32 = 0
val VK_IMAGE_COMPOSITE_SRC_OVER: i32 = 1
# Solid colour fill: Chrome's SkPMSrcOver rule (color.blend_solid) rather
# than the image rule mode 1 uses.
val VK_IMAGE_COMPOSITE_SRC_OVER_SOLID: i32 = 2
val VK_SPEC_MAX_WORKGROUP_COUNT: i64 = 65535

export VulkanFontPipelineEvidence, VulkanFontCompositeEvidence
export VULKAN_FONT_ATLAS_MIRROR_MAX
export VK_T_FONT_COMPOSITE, VK_T_FONT_ATLAS_BUILD, VK_T_FONT_ATLAS_PACK
export VK_T_FONT_ATLAS_UPLOAD, VK_T_FONT_ATLAS_DIGEST, VK_T_FONT_PACKED_PARAMS
export VK_T_FONT_QUAD_VALIDATE, VK_T_FONT_OWNER_IDENTITY
export VULKAN_TEXT_PATH_CPU_RASTER, VULKAN_TEXT_PATH_NOT_DRAWN
export VK_T_ENQUEUE, VK_T_FLUSH, VK_T_SFFI_BEGIN, VK_T_SFFI_REAP
export VK_T_SFFI_DESC, VK_T_SFFI_BIND_PIPE, VK_T_SFFI_BIND_DESC, VK_T_SFFI_PUSH
export VK_T_SFFI_DISPATCH, VK_T_SFFI_END, VK_T_SFFI_SUBMIT, VK_T_SFFI_WAIT_FENCE
export VK_DISPATCH_COMPLETED_INELIGIBLE, RECT_BATCH_MIN_RECTS
export VK_IMAGE_COMPOSITE_COPY, VK_IMAGE_COMPOSITE_SRC_OVER
export VK_IMAGE_COMPOSITE_SRC_OVER_SOLID, VK_SPEC_MAX_WORKGROUP_COUNT
