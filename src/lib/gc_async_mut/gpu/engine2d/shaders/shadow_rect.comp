#version 450
// Device box-shadow kernel — the exact integer twin of emu_draw_shadow_rect()
// in src/lib/gc_async_mut/gpu/engine2d/backend_emu_adv.spl.
//
// binding 0 = framebuffer uint[], index = y * fb_w + x (READ ONLY here)
// binding 1 = output uint[], mw * mh words at offset 0 (index = py * mw + px),
//             followed by the two 1-D coverage profiles the host uploaded:
//               [prof_off .. prof_off+mw)        = prof_x
//               [prof_off+mw .. prof_off+mw+mh)  = prof_y
//             The two regions are disjoint, so a thread never reads a word
//             another thread writes and no barrier is required.
// push constants (44 bytes): mx, my, mw, mh, fb_w, fb_h, sr, sg, sb,
//                            shadow_a, prof_off
// dispatch: 2D, ceil(mw/16) x ceil(mh/16) workgroups of 16x16
//
// WHY THE PROFILES COME FROM THE HOST and the kernel is not three passes of
// blur_rect.comp: emu_draw_shadow_rect's coverage field is SEPARABLE —
// cov = ((prof_x[px] * prof_y[py] + 127) / 255 * shadow_a + 127) / 255 — where each profile
// is Skia's blurred step (engine2d_blur_step_profile, rounded integer box
// passes). Running blur_rect.comp over a 2-D coverage image instead rounds a
// different quantity, so it is NOT the same integer field. The profiles are O(mw + mh) host work
// (two 1-D arrays, no pixel loop) and are uploaded into the tail of the same
// buffer the kernel writes, which keeps the whole frame GPU-resident: no
// readback, no host pixel loop, and the dispatch is recorded into the frame's
// single command buffer.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) buffer Framebuffer { uint data[]; } fb;
layout(set = 0, binding = 1) buffer ShadowOut { uint data[]; } dst;

layout(push_constant) uniform PushConstants {
    int mx;
    int my;
    int mw;
    int mh;
    int fb_w;
    int fb_h;
    int sr;
    int sg;
    int sb;
    int shadow_a;
    int prof_off;
} pc;

// color.spl `_blend_premul_over`: one channel of straight-alpha src over a
// translucent dst, through premultiplied space.
int premul_over(int s, int sa, int d, int da, int inv, int oa) {
    int p = (s * sa + 127) / 255 + (((d * da + 127) / 255) * inv + 127) / 255;
    int v = (p * 255 + oa / 2) / oa;
    return v > 255 ? 255 : v;
}

void main() {
    int px = int(gl_GlobalInvocationID.x);
    int py = int(gl_GlobalInvocationID.y);
    if (px >= pc.mw || py >= pc.mh) return;

    int fx = pc.mx + px;
    int fy = pc.my + py;
    // The host twin leaves `dst` at 0 for a sample outside the framebuffer.
    uint dstv = 0u;
    if (fx >= 0 && fx < pc.fb_w && fy >= 0 && fy < pc.fb_h) {
        dstv = fb.data[uint(fy * pc.fb_w + fx)];
    }

    int cov_x = int(dst.data[uint(pc.prof_off + px)]);
    int cov_y = int(dst.data[uint(pc.prof_off + pc.mw + py)]);
    // Same expression, same left-to-right rounding divisions as the twin.
    int cov = ((cov_x * cov_y + 127) / 255 * pc.shadow_a + 127) / 255;

    uint outv = dstv;
    uint da = (dstv >> 24u) & 255u;
    if (cov > 0 && da != 255u) {
        // A translucent destination (an opacity group or other transparent
        // offscreen): Chrome's src-over, as the twin's `_emu_shadow_px` does
        // through color.spl `blend_solid`.
        if (cov >= 255 || da == 0u) {
            outv = (uint(cov >= 255 ? 255 : cov) << 24u) | (uint(pc.sr) << 16u) | (uint(pc.sg) << 8u) | uint(pc.sb);
        } else {
            int ida = int(da);
            int inv = 255 - cov;
            int oa = cov + (ida * inv + 127) / 255;
            int rr = premul_over(pc.sr, cov, int((dstv >> 16u) & 255u), ida, inv, oa);
            int rg = premul_over(pc.sg, cov, int((dstv >> 8u) & 255u), ida, inv, oa);
            int rb = premul_over(pc.sb, cov, int(dstv & 255u), ida, inv, oa);
            outv = (uint(oa) << 24u) | (uint(rr) << 16u) | (uint(rg) << 8u) | uint(rb);
        }
    } else if (cov > 0) {
        int dr = int((dstv >> 16u) & 255u);
        int dg = int((dstv >> 8u) & 255u);
        int db = int(dstv & 255u);
        int rr = (pc.sr * cov + dr * (255 - cov)) / 255;
        int rg = (pc.sg * cov + dg * (255 - cov)) / 255;
        int rb = (pc.sb * cov + db * (255 - cov)) / 255;
        // Opaque destination: the twin's integer formula.
        outv = 0xFF000000u | (uint(rr) << 16u) | (uint(rg) << 8u) | uint(rb);
    }
    dst.data[uint(py * pc.mw + px)] = outv;
}
