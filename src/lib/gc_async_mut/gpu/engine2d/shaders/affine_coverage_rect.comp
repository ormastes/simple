#version 450
// Strict Engine2D DrawIR v4 opaque affine rectangle. One polygon is clipped
// against each target pixel square, so there is no quad diagonal or seam.
// The host computes a conservative target-space bbox and intersects the
// surface clip before dispatch. Layout is 60 bytes within a 64-byte range.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) buffer Framebuffer { uint data[]; } fb;
layout(push_constant) uniform PushConstants {
    int rx; int ry; int rw; int rh;
    int fb_w; int fb_h;
    uint color;
    float local_w; float local_h;
    float a; float b; float c; float d; float tx; float ty;
} pc;

float side_distance(vec2 p, int side, float px, float py) {
    if (side == 0) return p.x - px;
    if (side == 1) return px + 1.0 - p.x;
    if (side == 2) return p.y - py;
    return py + 1.0 - p.y;
}

float square_coverage(float px, float py) {
    vec2 shape[8];
    vec2 clipped[8];
    shape[0] = vec2(pc.tx, pc.ty);
    shape[1] = vec2(pc.a * pc.local_w + pc.tx,
                    pc.b * pc.local_w + pc.ty);
    shape[2] = vec2(pc.a * pc.local_w + pc.c * pc.local_h + pc.tx,
                    pc.b * pc.local_w + pc.d * pc.local_h + pc.ty);
    shape[3] = vec2(pc.c * pc.local_h + pc.tx,
                    pc.d * pc.local_h + pc.ty);
    int count = 4;
    for (int side = 0; side < 4; ++side) {
        int next_count = 0;
        for (int i = 0; i < count; ++i) {
            vec2 from = shape[i];
            vec2 to = shape[(i + 1) % count];
            float d0 = side_distance(from, side, px, py);
            float d1 = side_distance(to, side, px, py);
            bool inside0 = d0 >= 0.0;
            bool inside1 = d1 >= 0.0;
            if (inside0 != inside1) {
                float t = d0 / (d0 - d1);
                clipped[next_count++] = mix(from, to, t);
            }
            if (inside1) clipped[next_count++] = to;
        }
        count = next_count;
        if (count == 0) return 0.0;
        for (int i = 0; i < count; ++i) shape[i] = clipped[i];
    }
    float twice_area = 0.0;
    for (int i = 0; i < count; ++i) {
        vec2 p = shape[i] - vec2(px, py);
        vec2 q = shape[(i + 1) % count] - vec2(px, py);
        twice_area += p.x * q.y - q.x * p.y;
    }
    return clamp(abs(twice_area) * 0.5, 0.0, 1.0);
}

uint blend_opaque(uint src, uint dst, float coverage) {
    float remainder = 1.0 - coverage;
    uint r = uint(round(float((src >> 16u) & 255u) * coverage +
                        float((dst >> 16u) & 255u) * remainder));
    uint g = uint(round(float((src >> 8u) & 255u) * coverage +
                        float((dst >> 8u) & 255u) * remainder));
    uint b = uint(round(float(src & 255u) * coverage +
                        float(dst & 255u) * remainder));
    return 0xff000000u | (r << 16u) | (g << 8u) | b;
}

void main() {
    int lx = int(gl_GlobalInvocationID.x);
    int ly = int(gl_GlobalInvocationID.y);
    if (lx >= pc.rw || ly >= pc.rh) return;
    int x = pc.rx + lx;
    int y = pc.ry + ly;
    if (x < 0 || x >= pc.fb_w || y < 0 || y >= pc.fb_h) return;
    float coverage = square_coverage(float(x), float(y));
    if (coverage <= 0.0) return;
    uint index = uint(y) * uint(pc.fb_w) + uint(x);
    if (coverage >= 1.0) {
        fb.data[index] = pc.color;
    } else {
        fb.data[index] = blend_opaque(pc.color, fb.data[index], coverage);
    }
}
