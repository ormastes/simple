# Target-selected Engine2D facade. Consumer modules import one stable surface;
# only this import-only owner carries platform cfg declarations.

@cfg("os", "simpleos")
use std.gc_async_mut.gpu.engine2d.engine_baremetal.{Engine2D, DrawIrTargetFontEvidence}
@cfg(os = "macos" or os = "linux" or os = "windows" or os = "freebsd" or os = "openbsd" or os = "netbsd" or os = "android")
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
@cfg(os = "macos" or os = "linux" or os = "windows" or os = "freebsd" or os = "openbsd" or os = "netbsd" or os = "android")
use std.gc_async_mut.gpu.engine2d.draw_ir_target.{DrawIrTargetFontEvidence}

export Engine2D, DrawIrTargetFontEvidence
