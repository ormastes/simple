# 2D Engine — Vulkan Backend Helpers
#
# Extension impl for VulkanBackend: compute dispatch methods and text fallback.
# Free functions: push-constant packing, pixel/byte conversion, type helpers.
#
# Depends on: backend_vulkan.spl (VulkanBackend class)
#             backend_vulkan_glsl.spl (shader sources, accessed via main init)

use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.gpu.engine2d.glyph.{render_text_to_buffer}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_create_descriptor_set, vulkan_sffi_bind_buffer,
    vulkan_sffi_destroy_descriptor_set, vulkan_sffi_begin_compute,
    vulkan_sffi_bind_pipeline, vulkan_sffi_bind_descriptors,
    vulkan_sffi_push_constants, vulkan_sffi_dispatch,
    vulkan_sffi_end_compute, vulkan_sffi_discard_command,
    vulkan_sffi_fence_submission_supported,
    vulkan_sffi_submit_and_wait_fence, vulkan_sffi_wait_fence,
    vulkan_sffi_destroy_fence, vulkan_sffi_free_buffer,
    vulkan_sffi_alloc_buffer,
    vulkan_sffi_copy_from_buffer, vulkan_sffi_copy_to_buffer,
    vulkan_sffi_read_buffer_bytes, vulkan_sffi_wait_idle,
    vulkan_sffi_dispatch_buffer_compute_checked,
    vulkan_sffi_quarantine_dependencies,
    vulkan_sffi_quarantine_unsubmitted_command,
    vulkan_sffi_reap_dependency_quarantine
}

# ============================================================================
# Vulkan SFFI (re-declared for use in this module)
# ============================================================================

# ============================================================================
# Push Constant Size (must match backend_vulkan.spl)
# ============================================================================

val VK_PUSH_CONSTANT_SIZE: i64 = 64
val VK_DISPATCH_COMPLETED_INELIGIBLE: i64 = 2
# Retained image-source staging buffers kept warm across frames. This is a
# HOST-MEMORY bound, not a command-buffer bound: `rt_vulkan_create_descriptor_set`
# (src/compiler_rust/runtime/src/vulkan_graphics_runtime_compute.rs:19-70) creates
# a FRESH VkDescriptorPool per set, so the SFFI imposes no ceiling on the number
# of descriptor sets or dispatches recorded into one command buffer. The pending
# dependency table is therefore grown by push and no longer forces a mid-frame
# submit+fence-wait when a frame exceeds a fixed slot count.
val VK_IMAGE_SOURCE_POOL_CAPACITY: i64 = 256
# Bound retained host staging so a pathological web image cannot pin
# unbounded CPU memory on the long-lived compositor surface.
val VULKAN_IMAGE_UPLOAD_SCRATCH_MAX_BYTES: i64 = 67108864

# ============================================================================
# Submission-order probe (level-gated, default OFF)
# ============================================================================

val _VULKAN_ORDER_TRACE_ENABLED =
    (env_get("SIMPLE_VK_ORDER_TRACE") ?? "") == "1"

fn vulkan_order_trace_enabled() -> bool:
    """True when SIMPLE_VK_ORDER_TRACE=1 armed the `[vk-order]` probe.

    Resolve this process-scoped configuration once: primitive dispatch is a
    render hot path and must not perform an environment lookup for every draw.
    """
    _VULKAN_ORDER_TRACE_ENABLED

fn vulkan_order_trace(message: text):
    """Emit one `[vk-order]` line when the probe is armed, else do nothing.

    This probe exists to answer a specific, recurring question: in what ORDER
    do framebuffer mutations actually reach the device relative to the font
    route's snapshot/restore? The run-lane truncation bug
    (`doc/08_tracking/bug/run_lane_render_truncation_divergence_2026-08-02.md`)
    was mis-diagnosed twice because that ordering was invisible. Configuration
    is cached once and callers guard message construction, so disabled tracing
    costs one cached boolean branch. Arm with `SIMPLE_VK_ORDER_TRACE=1` before
    starting the process.
    """
    if vulkan_order_trace_enabled():
        print("[vk-order] " + message)
val VK_IMAGE_COMPOSITE_COPY: i32 = 0
val VK_IMAGE_COMPOSITE_SRC_OVER: i32 = 1

# ============================================================================
# Compute Dispatch Methods
# ============================================================================

fn vulkan_dispatch_framebuffer_compute_checked(d_framebuffer: i64, pipe: i64, push_data: [u8], gx: i64, gy: i64, gz: i64) -> i64:
    """Engine2D compatibility name for the shared checked buffer dispatch."""
    vulkan_sffi_dispatch_buffer_compute_checked(d_framebuffer, pipe, push_data, gx, gy, gz)

fn vulkan_dispatch_image_composite_checked(d_framebuffer: i64, pipe: i64, d_src: i64, push_data: [u8], gx: i64, gy: i64, gz: i64) -> i64:
    """Dispatch image copy/src-over with a non-replayable completion status.

    Returns 1 for receipt-eligible completion, 2 for completed mutation whose
    cleanup evidence is ineligible, 0 when no submission occurred, and -1 when
    completion or dependency release is unknown.
    """
    if d_framebuffer <= 0 or pipe <= 0 or d_src <= 0 or push_data.len() == 0 or gx <= 0 or gy <= 0 or gz <= 0:
        if d_src > 0:
            vulkan_sffi_free_buffer(d_src)
        return 0
    if not vulkan_sffi_reap_dependency_quarantine():
        vulkan_sffi_free_buffer(d_src)
        return -1
    if not vulkan_sffi_fence_submission_supported():
        vulkan_sffi_free_buffer(d_src)
        return 0
    val desc = vulkan_sffi_create_descriptor_set(pipe)
    if desc <= 0:
        vulkan_sffi_free_buffer(d_src)
        return 0

    var cmd: i64 = 0
    var ready = vulkan_sffi_bind_buffer(desc, 0, d_framebuffer)
    if ready:
        ready = vulkan_sffi_bind_buffer(desc, 1, d_src)
    if ready:
        cmd = vulkan_sffi_begin_compute()
        ready = cmd > 0
    if ready:
        ready = vulkan_sffi_bind_pipeline(cmd, pipe)
    if ready:
        ready = vulkan_sffi_bind_descriptors(cmd, desc)
    if ready:
        ready = vulkan_sffi_push_constants(cmd, pipe, push_data)
    if ready:
        ready = vulkan_sffi_dispatch(cmd, gx, gy, gz)
    if ready:
        ready = vulkan_sffi_end_compute(cmd)

    if not ready:
        val command_released = cmd <= 0 or vulkan_sffi_discard_command(cmd)
        if not command_released:
            vulkan_sffi_quarantine_unsubmitted_command(cmd, desc, d_src)
            return -1
        val descriptor_destroyed = vulkan_sffi_destroy_descriptor_set(desc)
        val source_freed = vulkan_sffi_free_buffer(d_src)
        return 0

    val fence = vulkan_sffi_submit_and_wait_fence(cmd)
    if fence < 0:
        # The runtime quarantines the command/fence. A successful device-idle
        # proves their dependent descriptor/source are now safe to release.
        if not vulkan_sffi_wait_idle():
            vulkan_sffi_quarantine_dependencies(desc, d_src, 0, 0)
            return -1
        val descriptor_destroyed = vulkan_sffi_destroy_descriptor_set(desc)
        val source_freed = vulkan_sffi_free_buffer(d_src)
        return VK_DISPATCH_COMPLETED_INELIGIBLE
    if fence == 0:
        # The runtime frees commands that were not submitted.
        val descriptor_destroyed = vulkan_sffi_destroy_descriptor_set(desc)
        val source_freed = vulkan_sffi_free_buffer(d_src)
        return 0

    val completion_waited = vulkan_sffi_wait_fence(fence, 0)
    if not completion_waited:
        # submit_and_wait_fence already waited indefinitely before returning a
        # positive fence, but fail closed if its evidence cannot be observed.
        if not vulkan_sffi_wait_idle():
            vulkan_sffi_quarantine_dependencies(desc, d_src, 0, 0)
            return -1
    val fence_destroyed = vulkan_sffi_destroy_fence(fence)
    val descriptor_destroyed = vulkan_sffi_destroy_descriptor_set(desc)
    val source_freed = vulkan_sffi_free_buffer(d_src)
    if completion_waited and fence_destroyed and descriptor_destroyed and source_freed:
        return 1
    VK_DISPATCH_COMPLETED_INELIGIBLE

impl VulkanBackend:

    me _prepare_image_upload(pixels: [u32], count: i64) -> bool:
        """Pack an image into reusable host staging without changing pixels.

        `vulkan_sffi_copy_to_buffer_prefix` snapshots the initialized prefix
        immediately into the destination Vulkan buffer. The pooled device
        source remains fenced independently, so this CPU scratch is safe to
        reuse by the next sequential draw.
        """
        if count <= 0 or pixels.len().to_i64() != count:
            return false
        if count > 9223372036854775807 / 4:
            return false
        val byte_count = count * 4
        if byte_count > VULKAN_IMAGE_UPLOAD_SCRATCH_MAX_BYTES:
            self.image_upload_scratch_fallback_count = self.image_upload_scratch_fallback_count + 1
            return false
        if self.image_upload_scratch.len().to_i64() < byte_count:
            self.image_upload_scratch = [0u8; byte_count]
            self.image_upload_scratch_resize_count = self.image_upload_scratch_resize_count + 1
        var i: i64 = 0
        while i < count:
            val pixel = pixels[i]
            val offset = i * 4
            self.image_upload_scratch[offset] = _u32_to_u8(pixel & 0xFF)
            self.image_upload_scratch[offset + 1] = _u32_to_u8((pixel >> 8) & 0xFF)
            self.image_upload_scratch[offset + 2] = _u32_to_u8((pixel >> 16) & 0xFF)
            self.image_upload_scratch[offset + 3] = _u32_to_u8((pixel >> 24) & 0xFF)
            i = i + 1
        true

    me _image_source_is_pending(source: i64) -> bool:
        if source <= 0:
            return false
        var i: i64 = 0
        while i < self.pending_compute_count:
            if self.pending_compute_sources[i] == source:
                return true
            i = i + 1
        false

    me _image_descriptor_is_pooled(descriptor: i64) -> bool:
        if descriptor <= 0:
            return false
        for pooled in self.image_descriptor_pool:
            if pooled == descriptor:
                return true
        false

    me _pending_image_composite_count() -> i64:
        var n: i64 = 0
        var i: i64 = 0
        while i < self.pending_compute_count:
            if self.pending_compute_sources[i] > 0:
                n = n + 1
            i = i + 1
        n

    me _image_source_is_pooled(source: i64) -> bool:
        if source <= 0:
            return false
        val pool_len = self.image_source_pool.len().to_i64()
        var i: i64 = 0
        while i < pool_len:
            if self.image_source_pool[i] == source:
                return true
            i = i + 1
        false

    me _image_source_pool_owner_matches() -> bool:
        if (not self.initialized or self.d_framebuffer <= 0 or
            not self.session.is_valid() or self.session.device <= 0 or
            self.session.generation <= 0):
            return false
        if self.image_source_pool.len() == 0:
            return true
        (self.image_source_pool_device_identity == self.session.device and
         self.image_source_pool_session_generation == self.session.generation and
         self.image_source_pool_surface_identity == self.d_framebuffer)

    me _image_source_pool_is_fully_pending() -> bool:
        val pool_len = self.image_source_pool.len().to_i64()
        if (not self._image_source_pool_owner_matches() or
            pool_len < VK_IMAGE_SOURCE_POOL_CAPACITY):
            return false
        var i: i64 = 0
        while i < pool_len:
            val source = self.image_source_pool[i]
            if source <= 0 or not self._image_source_is_pending(source):
                return false
            i = i + 1
        true

    me _acquire_image_source(byte_count: i64) -> i64:
        """Return a completed source buffer large enough for one image.

        Batched image composites keep their source dependency until the one
        frame fence.  A pooled buffer is therefore reusable only when it is
        absent from the current pending dependency table.  The pool is bounded
        by `VK_IMAGE_SOURCE_POOL_CAPACITY`; exhaustion keeps the caller's
        existing fail-closed path intact.
        """
        if byte_count <= 0 or byte_count % 4 != 0:
            return 0
        val pool_len = self.image_source_pool.len().to_i64()
        if not self._image_source_pool_owner_matches():
            return 0
        var i: i64 = 0
        while i < pool_len:
            val source = self.image_source_pool[i]
            if (source > 0 and
                self.image_source_pool_capacity[i] >= byte_count and
                not self._image_source_is_pending(source)):
                self.image_source_pool_reuse_count = self.image_source_pool_reuse_count + 1
                return source
            i = i + 1
        if pool_len >= VK_IMAGE_SOURCE_POOL_CAPACITY:
            # The pool can be full of completed buffers that are smaller than
            # a later image. Replace one completed undersized slot instead of
            # permanently failing every larger draw after saturation.
            var replace_index: i64 = -1
            var replace_capacity: i64 = 9223372036854775807
            i = 0
            while i < pool_len:
                val source = self.image_source_pool[i]
                val capacity = self.image_source_pool_capacity[i]
                if source <= 0:
                    replace_index = i
                    replace_capacity = -1
                elif (replace_capacity >= 0 and
                    not self._image_source_is_pending(source) and
                    capacity < replace_capacity):
                    replace_index = i
                    replace_capacity = capacity
                i = i + 1
            if replace_index < 0:
                return 0
            val replaced = self.image_source_pool[replace_index]
            self.image_source_pool[replace_index] = 0
            self.image_source_pool_capacity[replace_index] = 0
            if replaced > 0 and not vulkan_sffi_free_buffer(replaced):
                vulkan_sffi_quarantine_dependencies(0, replaced, 0, 0)
            val replacement = vulkan_sffi_alloc_buffer(byte_count, 0x80)
            if replacement <= 0:
                return 0
            self.image_source_pool[replace_index] = replacement
            self.image_source_pool_capacity[replace_index] = byte_count
            self.image_source_pool_allocation_count = self.image_source_pool_allocation_count + 1
            if replaced > 0:
                self.image_source_pool_replacement_count = self.image_source_pool_replacement_count + 1
            return replacement
        val source = vulkan_sffi_alloc_buffer(byte_count, 0x80)
        if source <= 0:
            return 0
        if pool_len == 0:
            self.image_source_pool_device_identity = self.session.device
            self.image_source_pool_session_generation = self.session.generation
            self.image_source_pool_surface_identity = self.d_framebuffer
        self.image_source_pool.push(source)
        self.image_source_pool_capacity.push(byte_count)
        self.image_source_pool_allocation_count = self.image_source_pool_allocation_count + 1
        source

    me _release_image_source(source: i64):
        # Pooled source buffers remain owned by the surface after the frame
        # fence.  Transient (non-batched) sources retain the old release path.
        if source <= 0 or self._image_source_is_pooled(source):
            return
        vulkan_sffi_free_buffer(source)

    me _destroy_image_source_pool():
        val pool_len = self.image_source_pool.len().to_i64()
        var i: i64 = 0
        while i < pool_len:
            val source = self.image_source_pool[i]
            if source > 0 and not vulkan_sffi_free_buffer(source):
                vulkan_sffi_quarantine_dependencies(0, source, 0, 0)
            i = i + 1
        self.image_source_pool = []
        self.image_source_pool_capacity = []
        self.image_source_pool_device_identity = 0
        self.image_source_pool_session_generation = 0
        self.image_source_pool_surface_identity = 0

    me _clear_pending_compute_state():
        self.pending_compute_command = 0
        self.pending_compute_pipelines = []
        self.pending_compute_descriptors = []
        self.pending_compute_sources = []
        self.pending_compute_count = 0

    me _release_pending_compute_descriptors() -> bool:
        var released = true
        var i: i64 = 0
        while i < self.pending_compute_count:
            val descriptor = self.pending_compute_descriptors[i]
            # Pooled image-composite descriptors outlive the frame fence exactly
            # like the font lane's `font_descriptor_pool`: completion makes them
            # rebindable, shutdown (not every frame) owns their destruction.
            if (not self._image_descriptor_is_pooled(descriptor) and
                not vulkan_sffi_destroy_descriptor_set(descriptor)):
                vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
                released = false
            val source = self.pending_compute_sources[i]
            if (source > 0 and not self._image_source_is_pooled(source) and
                not vulkan_sffi_free_buffer(source)):
                vulkan_sffi_quarantine_dependencies(0, source, 0, 0)
                released = false
            i = i + 1
        # Batched font handles belong to the warm pool. Completion makes them
        # reusable; shutdown, not every frame, owns their destruction.
        self.pending_font_descriptors = []
        self.pending_font_params = []
        self.pending_font_glyph_count = 0
        released

    me _quarantine_pending_compute_descriptors():
        var i: i64 = 0
        while i < self.pending_compute_count:
            val source = self.pending_compute_sources[i]
            val descriptor = self.pending_compute_descriptors[i]
            # A pooled image descriptor is ALSO reached by the pool sweep below,
            # so passing it here too would quarantine one handle twice and reap
            # a second destroy of an already-destroyed set. Same reasoning as
            # the pooled-source guard on the next argument.
            vulkan_sffi_quarantine_dependencies(
                if self._image_descriptor_is_pooled(descriptor): 0 else descriptor,
                if self._image_source_is_pooled(source): 0 else source,
                0, 0)
            i = i + 1
        # Any member of the reusable pool may have been referenced by the
        # unknown command. Quarantine every member once and discard the pool.
        for source in self.image_source_pool:
            if source > 0:
                vulkan_sffi_quarantine_dependencies(0, source, 0, 0)
        for descriptor in self.image_descriptor_pool:
            vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
        for descriptor in self.font_descriptor_pool:
            vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
        for params in self.font_params_pool:
            vulkan_sffi_quarantine_dependencies(0, params, 0, 0)
        self.pending_font_descriptors = []
        self.pending_font_params = []
        self.pending_font_glyph_count = 0
        self.image_descriptor_pool = []
        self.font_descriptor_pool = []
        self.font_params_pool = []
        self.font_params_pool_capacity = []
        self.image_source_pool = []
        self.image_source_pool_capacity = []
        self.image_source_pool_device_identity = 0
        self.image_source_pool_session_generation = 0
        self.image_source_pool_surface_identity = 0

    me _flush_pending_compute() -> i64:
        """Submit one Engine-managed primitive batch and release dependencies."""
        self.midframe_flush_count = self.midframe_flush_count + 1
        val flush_rc = self._flush_pending_compute_impl()
        if vulkan_order_trace_enabled():
            vulkan_order_trace("flush rc={flush_rc} dirty={self.dirty} cpu_fallback={self.cpu_fallback_used} completion_unknown={self.completion_unknown}")
        flush_rc

    me _flush_pending_compute_impl() -> i64:
        val cmd = self.pending_compute_command
        if cmd <= 0:
            return 1
        val has_font_work = self.pending_font_descriptors.len() > 0
        if not vulkan_sffi_end_compute(cmd):
            val discarded = vulkan_sffi_discard_command(cmd)
            if not discarded:
                val first_desc = if self.pending_compute_count > 0:
                    self.pending_compute_descriptors[0]
                elif self.pending_font_descriptors.len() > 0:
                    self.pending_font_descriptors[0]
                else:
                    0
                vulkan_sffi_quarantine_unsubmitted_command(cmd, first_desc, 0)
                self._quarantine_pending_compute_descriptors()
                self._clear_pending_compute_state()
                return -1
            self._release_pending_compute_descriptors()
            self._clear_pending_compute_state()
            return 0

        val fence = vulkan_sffi_submit_and_wait_fence(cmd)
        if fence < 0:
            if not vulkan_sffi_wait_idle():
                self._quarantine_pending_compute_descriptors()
                self._clear_pending_compute_state()
                return -1
            self._release_pending_compute_descriptors()
            self._clear_pending_compute_state()
            return VK_DISPATCH_COMPLETED_INELIGIBLE
        if fence == 0:
            self._release_pending_compute_descriptors()
            self._clear_pending_compute_state()
            return 0
        # The fence handle is returned only for an actual queue submission.
        # Keep this owner-side observation independent of caller success.
        self.observed_device_submit_count = self.observed_device_submit_count + 1
        if has_font_work:
            self.font_frame_submission_count = self.font_frame_submission_count + 1
            self.font_frame_fence_count = self.font_frame_fence_count + 1

        val completion_waited = vulkan_sffi_wait_fence(fence, 0)
        if not completion_waited and not vulkan_sffi_wait_idle():
            self._quarantine_pending_compute_descriptors()
            self._clear_pending_compute_state()
            return -1
        val fence_destroyed = vulkan_sffi_destroy_fence(fence)
        val descriptors_released = self._release_pending_compute_descriptors()
        self._clear_pending_compute_state()
        if completion_waited and fence_destroyed and descriptors_released:
            self.observed_device_fence_count = self.observed_device_fence_count + 1
            1
        else:
            VK_DISPATCH_COMPLETED_INELIGIBLE

    me _enqueue_framebuffer_compute(pipe: i64, push_data: [u8],
                                    gx: i64, gy: i64, gz: i64) -> i64:
        if (self.d_framebuffer <= 0 or pipe <= 0 or push_data.len() == 0 or
            gx <= 0 or gy <= 0 or gz <= 0):
            return 0
        if self.pending_compute_command <= 0:
            if (not vulkan_sffi_reap_dependency_quarantine() or
                not vulkan_sffi_fence_submission_supported()):
                return 0
            self.pending_compute_command = vulkan_sffi_begin_compute()
            if self.pending_compute_command <= 0:
                return 0

        var desc: i64 = 0
        var i: i64 = 0
        while i < self.pending_compute_count:
            if self.pending_compute_pipelines[i] == pipe:
                desc = self.pending_compute_descriptors[i]
            i = i + 1
        if desc <= 0:
            desc = vulkan_sffi_create_descriptor_set(pipe)
            if desc <= 0 or not vulkan_sffi_bind_buffer(
                    desc, 0, self.d_framebuffer):
                if desc > 0:
                    if not vulkan_sffi_destroy_descriptor_set(desc):
                        vulkan_sffi_quarantine_dependencies(
                            desc, 0, 0, 0)
                val flushed = self._flush_pending_compute()
                return if flushed < 0: -1 else: 0
            self.pending_compute_pipelines.push(pipe)
            self.pending_compute_descriptors.push(desc)
            self.pending_compute_sources.push(0)
            self.pending_compute_count = self.pending_compute_count + 1
        val cmd = self.pending_compute_command
        val ready = (
            vulkan_sffi_bind_pipeline(cmd, pipe) and
            vulkan_sffi_bind_descriptors(cmd, desc) and
            vulkan_sffi_push_constants(cmd, pipe, push_data) and
            vulkan_sffi_dispatch(cmd, gx, gy, gz))
        if not ready:
            val flushed = self._flush_pending_compute()
            return if flushed < 0: -1 else: 0
        1

    me _resolve_framebuffer_descriptor(pipe: i64) -> i64:
        """Descriptor set for `pipe` bound to the framebuffer, dedup'd per batch.

        Extracted from `_enqueue_framebuffer_compute` so the rect-batch lane can
        resolve it ONCE for N rects instead of re-running the scan and the
        bind chain per rect. Returns <= 0 when the set could not be created or
        bound; the caller owns the flush/fallback decision.
        """
        var i: i64 = 0
        while i < self.pending_compute_count:
            if self.pending_compute_pipelines[i] == pipe:
                return self.pending_compute_descriptors[i]
            i = i + 1
        val desc = vulkan_sffi_create_descriptor_set(pipe)
        if desc <= 0 or not vulkan_sffi_bind_buffer(desc, 0, self.d_framebuffer):
            if desc > 0:
                if not vulkan_sffi_destroy_descriptor_set(desc):
                    vulkan_sffi_quarantine_dependencies(desc, 0, 0, 0)
            return 0
        self.pending_compute_pipelines.push(pipe)
        self.pending_compute_descriptors.push(desc)
        self.pending_compute_sources.push(0)
        self.pending_compute_count = self.pending_compute_count + 1
        desc

    me _enqueue_rect_batch(pipe: i64, rects: [i32], colors: [u32]) -> i64:
        """Enqueue N opaque rect dispatches with ONE interpreter transit.

        # Frozen packed layout (do not reorder; mirrors the packed-glyph
        # discipline in backend_vulkan_font.spl:103)
        #   rects  : 4 i32 per rect, [x0,y0,w0,h0, x1,y1,w1,h1, ...]
        #   colors : 1 u32 per rect; colors[k] paints rects[4k..4k+4]
        #   invariant: rects.len() == colors.len() * 4
        # Painter order is the array order: rect k is dispatched before k+1
        # into the SAME command buffer, so the GPU executes them in order.
        #
        # Why this exists (measured 2026-09-11, macOS/M4, interpreter lane):
        # one `Engine2D.draw_rect_filled` cost 509 us of interpreter time --
        # 342 us packing, 97 us in the 4-SFFI enqueue, 23 us in the facade --
        # for a dispatch the GPU enqueues in ~24 us. This lane keeps the
        # per-rect work to an in-place push-constant rewrite plus the two
        # SFFI calls that genuinely vary per rect (push_constants, dispatch);
        # bind_pipeline and bind_descriptors are hoisted out of the loop
        # because command-buffer bindings persist until rebound.
        #
        # Returns the number of rects enqueued, or -1 on an unrecoverable
        # failure. A short return means the caller must replay the REMAINING
        # rects (index >= return value) through the single-rect path, which
        # preserves painter order because everything before it is already
        # recorded in the command buffer.
        """
        val count = colors.len().to_i64()
        if self.d_framebuffer <= 0 or pipe <= 0 or count <= 0:
            return 0
        if rects.len().to_i64() != count * 4:
            return 0
        if self.pending_compute_command <= 0:
            if (not vulkan_sffi_reap_dependency_quarantine() or
                not vulkan_sffi_fence_submission_supported()):
                return 0
            self.pending_compute_command = vulkan_sffi_begin_compute()
            if self.pending_compute_command <= 0:
                return 0
        val desc = self._resolve_framebuffer_descriptor(pipe)
        if desc <= 0:
            val flushed = self._flush_pending_compute()
            return if flushed < 0: -1 else: 0
        val cmd = self.pending_compute_command
        if not vulkan_sffi_bind_pipeline(cmd, pipe) or not vulkan_sffi_bind_descriptors(cmd, desc):
            val flushed = self._flush_pending_compute()
            return if flushed < 0: -1 else: 0
        # One reusable push-constant staging buffer for the whole batch: the
        # runtime copies these bytes at record time (vkCmdPushConstants takes
        # them by value), so rewriting it in place between dispatches is safe.
        var pc_buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
        # Only the first FIVE words (x, y, w, h, colour -- offsets 0..19) vary
        # per rect. Framebuffer size and clip (offsets 20..47) are frame state,
        # so they are written ONCE here instead of 28 bytes re-written per
        # rect. Measured 2026-09-11: rewriting the whole 48-byte block per rect
        # cost 111 us/rect; the interpreter charges ~1.5 us per array store, so
        # the hoist is the difference between 48 and 20 stores per rect.
        _write_rect_pc_into(pc_buf, 0, 0, 0, 0, 0, 0u32, self.w, self.h,
                            self.clip_x, self.clip_y, self.clip_w, self.clip_h,
                            self.clip_enabled)
        var k: i64 = 0
        while k < count:
            val base = k * 4
            val rw = rects[base + 2]
            val rh = rects[base + 3]
            if rw > 0 and rh > 0:
                # Per-rect push-constant words (offsets 0..19), written inline
                # rather than called because at ~7 us per interpreter `me`/fn
                # transit the call itself is ~10% of this loop body.
                val vx = (rects[base] as u32) as i64
                pc_buf[0] = (vx & 255) as u8
                pc_buf[1] = ((vx >> 8) & 255) as u8
                pc_buf[2] = ((vx >> 16) & 255) as u8
                pc_buf[3] = ((vx >> 24) & 255) as u8
                val vy = (rects[base + 1] as u32) as i64
                pc_buf[4] = (vy & 255) as u8
                pc_buf[5] = ((vy >> 8) & 255) as u8
                pc_buf[6] = ((vy >> 16) & 255) as u8
                pc_buf[7] = ((vy >> 24) & 255) as u8
                val vw = (rw as u32) as i64
                pc_buf[8] = (vw & 255) as u8
                pc_buf[9] = ((vw >> 8) & 255) as u8
                pc_buf[10] = ((vw >> 16) & 255) as u8
                pc_buf[11] = ((vw >> 24) & 255) as u8
                val vh = (rh as u32) as i64
                pc_buf[12] = (vh & 255) as u8
                pc_buf[13] = ((vh >> 8) & 255) as u8
                pc_buf[14] = ((vh >> 16) & 255) as u8
                pc_buf[15] = ((vh >> 24) & 255) as u8
                val vc = colors[k] as i64
                pc_buf[16] = (vc & 255) as u8
                pc_buf[17] = ((vc >> 8) & 255) as u8
                pc_buf[18] = ((vc >> 16) & 255) as u8
                pc_buf[19] = ((vc >> 24) & 255) as u8
                val gx = (rw as i64 + 15) / 16
                val gy = (rh as i64 + 15) / 16
                if (not vulkan_sffi_push_constants(cmd, pipe, pc_buf) or
                    not vulkan_sffi_dispatch(cmd, gx, gy, 1)):
                    val flushed = self._flush_pending_compute()
                    return if flushed < 0: -1 else: k
            k = k + 1
        # One trace line for the whole batch. The single-rect path emits one per
        # dispatch; without this the batch lane is INVISIBLE to
        # SIMPLE_VK_ORDER_TRACE=1, and that probe exists precisely because
        # mutation ordering was misdiagnosed twice.
        if vulkan_order_trace_enabled():
            vulkan_order_trace("rect-batch pipe={pipe} n={count} desc={desc} cmd={cmd} clip_on={self.clip_enabled} clip={self.clip_x},{self.clip_y},{self.clip_w},{self.clip_h}")
        count

    me _enqueue_image_composite(pipe: i64, d_src: i64, push_data: [u8],
                                gx: i64, gy: i64, gz: i64) -> i64:
        """Consume one uploaded source and retain it through the frame fence."""
        if (self.d_framebuffer <= 0 or pipe <= 0 or d_src <= 0 or
            push_data.len() == 0 or gx <= 0 or gy <= 0 or gz <= 0):
            self._release_image_source(d_src)
            return 0
        if self.pending_compute_command <= 0:
            if (not vulkan_sffi_reap_dependency_quarantine() or
                not vulkan_sffi_fence_submission_supported()):
                self._release_image_source(d_src)
                return 0
            self.pending_compute_command = vulkan_sffi_begin_compute()
            if self.pending_compute_command <= 0:
                self._release_image_source(d_src)
                return 0
        # Reuse a warm descriptor set by position within the batch, mirroring the
        # font lane (`font_descriptor_pool`, backend_vulkan_font.spl:846-861).
        # Position `k` is claimed at most once per batch and every earlier batch
        # that used it was submitted AND fence-waited by `_flush_pending_compute`,
        # so re-binding it here cannot touch a set live in an unsubmitted command.
        # `rt_vulkan_create_descriptor_set` builds a whole VkDescriptorPool per
        # set (vulkan_graphics_runtime_compute.rs:19-70), so this removes one pool
        # creation per composited image rather than merely one allocation.
        val pool_index = self._pending_image_composite_count()
        val pooled = self.frame_batching_enabled and pool_index < self.image_descriptor_pool.len().to_i64()
        val desc = if pooled:
            self.image_descriptor_pool[pool_index]
        else:
            vulkan_sffi_create_descriptor_set(pipe)
        if (desc <= 0 or not vulkan_sffi_bind_buffer(desc, 0, self.d_framebuffer) or
            not vulkan_sffi_bind_buffer(desc, 1, d_src)):
            if desc > 0 and not pooled and not vulkan_sffi_destroy_descriptor_set(desc):
                vulkan_sffi_quarantine_dependencies(desc, 0, 0, 0)
            self._release_image_source(d_src)
            val bind_flush = self._flush_pending_compute()
            return if bind_flush < 0: -1 else: 0
        val cmd = self.pending_compute_command
        # Register dependencies before recording: if any command operation
        # fails, the common flush/discard path still owns their lifetime.
        if self.frame_batching_enabled and not pooled:
            self.image_descriptor_pool.push(desc)
        self.pending_compute_pipelines.push(pipe)
        self.pending_compute_descriptors.push(desc)
        self.pending_compute_sources.push(d_src)
        self.pending_compute_count = self.pending_compute_count + 1
        val ready = (
            vulkan_sffi_bind_pipeline(cmd, pipe) and
            vulkan_sffi_bind_descriptors(cmd, desc) and
            vulkan_sffi_push_constants(cmd, pipe, push_data) and
            vulkan_sffi_dispatch(cmd, gx, gy, gz))
        if not ready:
            val dispatch_flush = self._flush_pending_compute()
            return if dispatch_flush < 0: -1 else: 0
        1

    me _flush_for_host_fallback(reason: text) -> bool:
        val status = self._flush_pending_compute()
        if status == 1:
            return true
        self.mark_cpu_fallback(reason)
        if status < 0:
            self.completion_unknown = true
            return false
        status == VK_DISPATCH_COMPLETED_INELIGIBLE

    me _dispatch_framebuffer_checked(pipe: i64, push_data: [u8], gx: i64, gy: i64, gz: i64) -> i64:
        var dispatched = if self.frame_batching_enabled:
            self._enqueue_framebuffer_compute(pipe, push_data, gx, gy, gz)
        else:
            vulkan_dispatch_framebuffer_compute_checked(
                self.d_framebuffer, pipe, push_data, gx, gy, gz)
        if dispatched == 0 and self.frame_batching_enabled and self.initialized and self.d_framebuffer > 0:
            # Hardening (2026-08-10 full-page-render sweep): long batched
            # sessions occasionally fail one dispatch in the bind chain after
            # ~30 command buffers (traced: rc=0 right after a healthy one on
            # the same buffer). The frame's earlier dispatches are intact, so
            # retry ONCE on a fresh command buffer before latching the CPU
            # fallback -- a transient chain failure must not demote the whole
            # lane, but a persistent one still must.
            val flushed = self._flush_pending_compute()
            if flushed >= 0:
                if vulkan_order_trace_enabled():
                    vulkan_order_trace("dispatch-retry pipe={pipe} after flush rc={flushed}")
                dispatched = self._enqueue_framebuffer_compute(pipe, push_data, gx, gy, gz)
        # clip_* is on this line deliberately: `_pack_rect_pc` folds the clip
        # into the rect push constants, so a clip left armed from an earlier
        # Draw-IR command makes the GPU discard a primitive while the dispatch
        # still reports rc=1 and dirty=true. That is indistinguishable from a
        # healthy frame in every other receipt -- see the run-lane truncation
        # bug's "What is still open".
        if vulkan_order_trace_enabled():
            vulkan_order_trace("dispatch pipe={pipe} batched={self.frame_batching_enabled} rc={dispatched} fb={self.d_framebuffer} pending_cmd={self.pending_compute_command} pending_n={self.pending_compute_count} clip_on={self.clip_enabled} clip={self.clip_x},{self.clip_y},{self.clip_w},{self.clip_h}")
        if dispatched > 0:
            self.dirty = true
            self.mark_device_content_changed()
        else:
            self.mark_cpu_fallback("framebuffer-dispatch-failed")
            if dispatched < 0:
                self.completion_unknown = true
            elif self.initialized and self.d_framebuffer > 0:
                # Status 0 may follow a completed mutation whose cleanup
                # evidence failed. Refresh device bytes, but never promote it.
                self.dirty = true
        dispatched

    me _gpu_draw_text_fallback(x: i32, y: i32, text_val: text, color: u32, font_size: i32):
        """Render text on CPU and upload affected region to GPU.

        For production use, a glyph atlas would be pre-uploaded to GPU memory
        and sampled by a compute shader. This fallback is acceptable
        for low-frequency text draws (UI labels, debug overlays).
        """
        if not self.initialized:
            return
        val pending_status = self._flush_pending_compute()
        if pending_status <= 0:
            if pending_status < 0:
                self.completion_unknown = true
            return
        # Ensure host buffer is current
        if self.dirty:
            val fb_size = _i64(self.w) * _i64(self.h) * 4
            val fb_bytes = vulkan_sffi_read_buffer_bytes(self.d_framebuffer, fb_size, 0)
            val refreshed = _bytes_to_pixel_array(fb_bytes, self.w * self.h)
            if refreshed.len() != self.w * self.h:
                self._mark_readback_length_failed()
                return
            self.host_buf = refreshed

        self.mark_cpu_fallback("legacy-text-host-framebuffer-fallback")
        # Render glyphs into host buffer using shared glyph module
        render_text_to_buffer(self.host_buf, self.w, self.h, x, y, text_val, color, font_size)

        # Upload entire host buffer back to GPU
        val fb_size = _i64(self.w) * _i64(self.h) * 4
        val upload_bytes = _pixels_to_bytes(self.host_buf, _i64(self.w) * _i64(self.h))
        vulkan_sffi_copy_to_buffer(self.d_framebuffer, upload_bytes, 0)
        self.dirty = false

# ============================================================================
# Type Conversion Helpers
# ============================================================================

fn _i64(v: i32) -> i64:
    v as i64

fn _i32_to_u32(v: i32) -> u32:
    v as u32

fn _u32_to_u8(v: u32) -> u8:
    v as u8

fn _u8_to_u32(v: u8) -> u32:
    v as u32

fn _bool_to_i32(v: bool) -> i32:
    if v: 1
    else: 0

# ============================================================================
# Push Constant Packing
#
# Push constants are packed as [u8] arrays of i32 values in little-endian.
# Each kernel's push constant layout is documented in the GLSL source.
# ============================================================================

fn _pack_i32_le(mut buf: [u8], offset: i32, value: i32) -> [u8]:
    """Pack an i32 into buf at byte offset in little-endian order."""
    val v = _i32_to_u32(value)
    buf[offset] = _u32_to_u8(v & 0xFF)
    buf[offset + 1] = _u32_to_u8((v >> 8) & 0xFF)
    buf[offset + 2] = _u32_to_u8((v >> 16) & 0xFF)
    buf[offset + 3] = _u32_to_u8((v >> 24) & 0xFF)
    buf

fn _pack_u32_le(mut buf: [u8], offset: i32, value: u32) -> [u8]:
    """Pack a u32 into buf at byte offset in little-endian order."""
    buf[offset] = _u32_to_u8(value & 0xFF)
    buf[offset + 1] = _u32_to_u8((value >> 8) & 0xFF)
    buf[offset + 2] = _u32_to_u8((value >> 16) & 0xFF)
    buf[offset + 3] = _u32_to_u8((value >> 24) & 0xFF)
    buf

fn _pack_clear_pc(color: u32, fb_w: i32, fb_h: i32) -> [u8]:
    """Push constants for clear kernel: color, fb_w, fb_h."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_u32_le(buf, 0, color)
    buf = _pack_i32_le(buf, 4, fb_w)
    buf = _pack_i32_le(buf, 8, fb_h)
    buf

fn _pack_rect_pc(x: i32, y: i32, w: i32, h: i32, color: u32, fb_w: i32, fb_h: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool) -> [u8]:
    """Push constants for rect kernels.

    HOT PATH (measured 2026-09-11, macOS/M4, interpreter lane): the previous
    body -- 12 `_pack_*_le(mut buf, ..) -> buf` calls, each of which also made
    4 tiny cast-helper calls -- cost **342 us per call**, 67% of the 509 us
    that one `Engine2D.draw_rect_filled` spent in the interpreter, versus a
    9 us floor for a bare `me` call. Every byte is written inline here: no
    sub-calls, and no `mut buf` pass-and-return, which the interpreter
    realises as a fresh 64-byte array per step. Layout is UNCHANGED and stays
    byte-identical to the GLSL rect kernels' push-constant block -- 12 i32/u32
    little-endian words at offsets 0,4,..,44. Do not "simplify" this back into
    the helper calls; see
    doc/08_tracking/bug/vulkan_draw_rect_interpreter_overhead_2026-09-11.md.
    """
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    _write_rect_pc_into(buf, 0, x, y, w, h, color, fb_w, fb_h, clip_x, clip_y, clip_w, clip_h, clip_enabled)
    buf

fn _write_rect_pc_into(mut buf: [u8], base: i64, x: i32, y: i32, w: i32, h: i32, color: u32, fb_w: i32, fb_h: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool):
    """Write the frozen 48-byte rect push-constant block at `base` in `buf`.

    Shared by the single-rect packer above and the batch lane, so the two can
    never drift. Writes are inline (no per-word helper call) for the reason
    documented on `_pack_rect_pc`.
    """
    val vx = (x as u32) as i64
    buf[base] = (vx & 255) as u8
    buf[base + 1] = ((vx >> 8) & 255) as u8
    buf[base + 2] = ((vx >> 16) & 255) as u8
    buf[base + 3] = ((vx >> 24) & 255) as u8
    val vy = (y as u32) as i64
    buf[base + 4] = (vy & 255) as u8
    buf[base + 5] = ((vy >> 8) & 255) as u8
    buf[base + 6] = ((vy >> 16) & 255) as u8
    buf[base + 7] = ((vy >> 24) & 255) as u8
    val vw = (w as u32) as i64
    buf[base + 8] = (vw & 255) as u8
    buf[base + 9] = ((vw >> 8) & 255) as u8
    buf[base + 10] = ((vw >> 16) & 255) as u8
    buf[base + 11] = ((vw >> 24) & 255) as u8
    val vh = (h as u32) as i64
    buf[base + 12] = (vh & 255) as u8
    buf[base + 13] = ((vh >> 8) & 255) as u8
    buf[base + 14] = ((vh >> 16) & 255) as u8
    buf[base + 15] = ((vh >> 24) & 255) as u8
    val vc = color as i64
    buf[base + 16] = (vc & 255) as u8
    buf[base + 17] = ((vc >> 8) & 255) as u8
    buf[base + 18] = ((vc >> 16) & 255) as u8
    buf[base + 19] = ((vc >> 24) & 255) as u8
    val vfw = (fb_w as u32) as i64
    buf[base + 20] = (vfw & 255) as u8
    buf[base + 21] = ((vfw >> 8) & 255) as u8
    buf[base + 22] = ((vfw >> 16) & 255) as u8
    buf[base + 23] = ((vfw >> 24) & 255) as u8
    val vfh = (fb_h as u32) as i64
    buf[base + 24] = (vfh & 255) as u8
    buf[base + 25] = ((vfh >> 8) & 255) as u8
    buf[base + 26] = ((vfh >> 16) & 255) as u8
    buf[base + 27] = ((vfh >> 24) & 255) as u8
    val vcx = (clip_x as u32) as i64
    buf[base + 28] = (vcx & 255) as u8
    buf[base + 29] = ((vcx >> 8) & 255) as u8
    buf[base + 30] = ((vcx >> 16) & 255) as u8
    buf[base + 31] = ((vcx >> 24) & 255) as u8
    val vcy = (clip_y as u32) as i64
    buf[base + 32] = (vcy & 255) as u8
    buf[base + 33] = ((vcy >> 8) & 255) as u8
    buf[base + 34] = ((vcy >> 16) & 255) as u8
    buf[base + 35] = ((vcy >> 24) & 255) as u8
    val vcw = (clip_w as u32) as i64
    buf[base + 36] = (vcw & 255) as u8
    buf[base + 37] = ((vcw >> 8) & 255) as u8
    buf[base + 38] = ((vcw >> 16) & 255) as u8
    buf[base + 39] = ((vcw >> 24) & 255) as u8
    val vch = (clip_h as u32) as i64
    buf[base + 40] = (vch & 255) as u8
    buf[base + 41] = ((vch >> 8) & 255) as u8
    buf[base + 42] = ((vch >> 16) & 255) as u8
    buf[base + 43] = ((vch >> 24) & 255) as u8
    val ce = if clip_enabled: 1
        else: 0
    buf[base + 44] = ce as u8
    buf[base + 45] = 0u8
    buf[base + 46] = 0u8
    buf[base + 47] = 0u8

fn _pack_line_pc(x1: i32, y1: i32, x2: i32, y2: i32, color: u32, thickness: i32, fb_w: i32, fb_h: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool) -> [u8]:
    """Push constants for line kernel."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_i32_le(buf, 0, x1)
    buf = _pack_i32_le(buf, 4, y1)
    buf = _pack_i32_le(buf, 8, x2)
    buf = _pack_i32_le(buf, 12, y2)
    buf = _pack_u32_le(buf, 16, color)
    buf = _pack_i32_le(buf, 20, thickness)
    buf = _pack_i32_le(buf, 24, fb_w)
    buf = _pack_i32_le(buf, 28, fb_h)
    buf = _pack_i32_le(buf, 32, clip_x)
    buf = _pack_i32_le(buf, 36, clip_y)
    buf = _pack_i32_le(buf, 40, clip_w)
    buf = _pack_i32_le(buf, 44, clip_h)
    buf = _pack_i32_le(buf, 48, _bool_to_i32(clip_enabled))
    buf

fn _pack_circle_pc(cx: i32, cy: i32, r: i32, color: u32, fb_w: i32, fb_h: i32, filled: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool) -> [u8]:
    """Push constants for circle kernels."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_i32_le(buf, 0, cx)
    buf = _pack_i32_le(buf, 4, cy)
    buf = _pack_i32_le(buf, 8, r)
    buf = _pack_u32_le(buf, 12, color)
    buf = _pack_i32_le(buf, 16, fb_w)
    buf = _pack_i32_le(buf, 20, fb_h)
    buf = _pack_i32_le(buf, 24, filled)
    buf = _pack_i32_le(buf, 28, clip_x)
    buf = _pack_i32_le(buf, 32, clip_y)
    buf = _pack_i32_le(buf, 36, clip_w)
    buf = _pack_i32_le(buf, 40, clip_h)
    buf = _pack_i32_le(buf, 44, _bool_to_i32(clip_enabled))
    buf

fn _pack_rounded_rect_pc(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32, fb_w: i32, fb_h: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool) -> [u8]:
    """Push constants for rounded rect kernel."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_i32_le(buf, 0, x)
    buf = _pack_i32_le(buf, 4, y)
    buf = _pack_i32_le(buf, 8, w)
    buf = _pack_i32_le(buf, 12, h)
    buf = _pack_i32_le(buf, 16, radius)
    buf = _pack_u32_le(buf, 20, color)
    buf = _pack_i32_le(buf, 24, fb_w)
    buf = _pack_i32_le(buf, 28, fb_h)
    buf = _pack_i32_le(buf, 32, clip_x)
    buf = _pack_i32_le(buf, 36, clip_y)
    buf = _pack_i32_le(buf, 40, clip_w)
    buf = _pack_i32_le(buf, 44, clip_h)
    buf = _pack_i32_le(buf, 48, _bool_to_i32(clip_enabled))
    buf

fn _pack_triangle_pc(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32, fb_w: i32, fb_h: i32, min_x: i32, min_y: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool) -> [u8]:
    """Push constants for triangle kernel."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_i32_le(buf, 0, x1)
    buf = _pack_i32_le(buf, 4, y1)
    buf = _pack_i32_le(buf, 8, x2)
    buf = _pack_i32_le(buf, 12, y2)
    buf = _pack_i32_le(buf, 16, x3)
    buf = _pack_i32_le(buf, 20, y3)
    buf = _pack_u32_le(buf, 24, color)
    buf = _pack_i32_le(buf, 28, fb_w)
    buf = _pack_i32_le(buf, 32, fb_h)
    buf = _pack_i32_le(buf, 36, min_x)
    buf = _pack_i32_le(buf, 40, min_y)
    buf = _pack_i32_le(buf, 44, clip_x)
    buf = _pack_i32_le(buf, 48, clip_y)
    buf = _pack_i32_le(buf, 52, clip_w)
    buf = _pack_i32_le(buf, 56, clip_h)
    buf = _pack_i32_le(buf, 60, _bool_to_i32(clip_enabled))
    buf

fn _pack_gradient_pc(x: i32, y: i32, w: i32, h: i32, top_color: u32, bottom_color: u32, fb_w: i32, fb_h: i32, clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32, clip_enabled: bool) -> [u8]:
    """Push constants for gradient rect kernel."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_i32_le(buf, 0, x)
    buf = _pack_i32_le(buf, 4, y)
    buf = _pack_i32_le(buf, 8, w)
    buf = _pack_i32_le(buf, 12, h)
    buf = _pack_u32_le(buf, 16, top_color)
    buf = _pack_u32_le(buf, 20, bottom_color)
    buf = _pack_i32_le(buf, 24, fb_w)
    buf = _pack_i32_le(buf, 28, fb_h)
    buf = _pack_i32_le(buf, 32, clip_x)
    buf = _pack_i32_le(buf, 36, clip_y)
    buf = _pack_i32_le(buf, 40, clip_w)
    buf = _pack_i32_le(buf, 44, clip_h)
    buf = _pack_i32_le(buf, 48, _bool_to_i32(clip_enabled))
    buf

fn _pack_image_composite_pc(x: i32, y: i32, w: i32, h: i32, fb_w: i32, fb_h: i32,
                            clip_x: i32, clip_y: i32, clip_w: i32, clip_h: i32,
                            clip_enabled: bool, opacity_milli: i32, composite_mode: i32,
                            src_w: i32, src_h: i32) -> [u8]:
    """Push constants for checked image copy/src-over."""
    var buf: [u8] = [0u8; VK_PUSH_CONSTANT_SIZE]
    buf = _pack_i32_le(buf, 0, x)
    buf = _pack_i32_le(buf, 4, y)
    buf = _pack_i32_le(buf, 8, w)
    buf = _pack_i32_le(buf, 12, h)
    buf = _pack_i32_le(buf, 16, fb_w)
    buf = _pack_i32_le(buf, 20, fb_h)
    buf = _pack_i32_le(buf, 24, clip_x)
    buf = _pack_i32_le(buf, 28, clip_y)
    buf = _pack_i32_le(buf, 32, clip_w)
    buf = _pack_i32_le(buf, 36, clip_h)
    buf = _pack_i32_le(buf, 40, _bool_to_i32(clip_enabled))
    buf = _pack_i32_le(buf, 44, opacity_milli)
    buf = _pack_i32_le(buf, 48, composite_mode)
    buf = _pack_i32_le(buf, 52, src_w)
    buf = _pack_i32_le(buf, 56, src_h)
    buf

# ============================================================================
# Byte / Pixel Conversion
# ============================================================================

fn _pixels_to_bytes(pixels: [u32], count: i64) -> [u8]:
    """Convert a [u32] pixel array to [u8] little-endian byte array."""
    var bytes: [u8] = [0u8; count * 4]
    var i: i64 = 0
    while i < count:
        val p = pixels[i]
        val off = i * 4
        bytes[off] = _u32_to_u8(p & 0xFF)
        bytes[off + 1] = _u32_to_u8((p >> 8) & 0xFF)
        bytes[off + 2] = _u32_to_u8((p >> 16) & 0xFF)
        bytes[off + 3] = _u32_to_u8((p >> 24) & 0xFF)
        i = i + 1
    bytes

fn _bytes_to_pixel_array(bytes: [u8], count: i32) -> [u32]:
    """Convert little-endian bytes into a new [u32] pixel array."""
    if count <= 0 or bytes.len().to_i64() != _i64(count) * 4:
        return []
    var pixels: [u32] = [0u32; count]
    var i = 0
    while i < count:
        val off = i * 4
        val b0 = _u8_to_u32(bytes[off])
        val b1 = _u8_to_u32(bytes[off + 1])
        val b2 = _u8_to_u32(bytes[off + 2])
        val b3 = _u8_to_u32(bytes[off + 3])
        pixels[i] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        i = i + 1
    pixels
