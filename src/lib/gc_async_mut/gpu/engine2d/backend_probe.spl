# Engine2D backend probe result and strict selection helpers.

use std.gpu.engine2d.helpers_availability.{backend_canonical_name, backend_is_hardware}
use std.gpu.engine2d.simd_kernels.{detect_simd_level, SimdLevel}

val BACKEND_CPU: text = "cpu"
val BACKEND_SOFTWARE: text = "software"
val BACKEND_CPU_SIMD: text = "cpu_simd"
val BACKEND_VULKAN: text = "vulkan"
val BACKEND_CUDA: text = "cuda"
val BACKEND_ROCM: text = "rocm"
val BACKEND_OPENCL: text = "opencl"
val BACKEND_METAL: text = "metal"
val BACKEND_HIP: text = "hip"
val BACKEND_WEBGPU: text = "webgpu"

val STATUS_OK: text = "Initialized"
val STATUS_FAILED: text = "Failed"
val STATUS_FALLBACK: text = "Fallback"

enum BackendStatus:
    Initialized
    Unavailable
    Failed
    Fallback
    Unsupported

fn backend_status_text(status: BackendStatus) -> text:
    match status:
        BackendStatus.Initialized: "Initialized"
        BackendStatus.Unavailable: "Unavailable"
        BackendStatus.Failed: "Failed"
        BackendStatus.Fallback: "Fallback"
        BackendStatus.Unsupported: "Unsupported"

fn backend_probe_initialized(probe: BackendProbeResult) -> bool:
    probe.status == BackendStatus.Initialized

fn backend_probe_fallback(probe: BackendProbeResult) -> bool:
    probe.status == BackendStatus.Fallback

class BackendProbeResult:
    requested_name: text
    selected_name: text
    status: BackendStatus
    device_name: text
    api_name: text
    feature_gate: text
    shader_format: text
    fallback_reason: text
    backend_name: text
    available: bool
    init_ms: i64
    reason: text
    has_compute: bool
    has_graphics: bool
    has_present: bool
    # True when this result came from a probe whose availability check actually
    # ran on the host (every strict-probe path executes; status carries the
    # outcome). Defaulted so hand-built selection-failure results stay valid.
    executed: bool = true
    # Nominal memory budget (MB) the probe reports for diagnostics; 0 = not
    # reported. CPU SIMD lanes set a positive scratch budget on the host.
    memory_mb: i64 = 0

    static fn create(name: text, status: BackendStatus, api: text, gate: text, shader: text, reason: text) -> BackendProbeResult:
        val ok = status == BackendStatus.Initialized
        BackendProbeResult(
            requested_name: name,
            selected_name: name,
            status: status,
            device_name: if ok: name + ":0" else: "",
            api_name: api,
            feature_gate: gate,
            shader_format: shader,
            fallback_reason: if ok: "" else: reason,
            backend_name: name,
            available: ok,
            init_ms: if ok: 1 else: 0,
            reason: reason,
            has_compute: ok,
            has_graphics: ok,
            has_present: false,
            executed: true,
            memory_mb: 0
        )

    static fn success(name: text, reason: text) -> BackendProbeResult:
        BackendProbeResult.create(name, BackendStatus.Initialized, name, name + "_runtime", _shader_format_for_backend(name), reason)

    static fn failed(name: text, reason: text) -> BackendProbeResult:
        BackendProbeResult.create(name, BackendStatus.Failed, name, name + "_runtime", _shader_format_for_backend(name), reason)

    static fn unavailable(name: text, reason: text) -> BackendProbeResult:
        BackendProbeResult.create(name, BackendStatus.Unavailable, name, name + "_runtime", _shader_format_for_backend(name), reason)

    fn is_usable() -> bool:
        backend_probe_initialized(self)

    fn is_ok() -> bool:
        backend_probe_initialized(self)

    # Strict-selection invariant, mirroring
    # Engine3DBackendProbeResult.strict_failure_without_fallback() so the same
    # predicate means the same thing on both engines.
    #
    # True means: this probe failed (or succeeded) on the backend that was
    # ACTUALLY REQUESTED — the selector never silently substituted a different
    # backend, and never demoted to a Fallback status. It is the 2D counterpart
    # of the campaign's honest-provenance rule: a caller must never be told
    # "vulkan" while quietly being handed CPU.
    #
    # Today every engine2d construction path satisfies this by construction
    # (_strict_probe_backend always passes the canonical requested name through
    # to selected_name and never emits BackendStatus.Fallback), so this reads
    # as a REGRESSION GUARD rather than a live discriminator: it exists to go
    # red the moment someone reintroduces a silent CPU-fallback path.
    #
    # Measured 2026-08-05: over 28 backend names (canonical names, aliases,
    # whitespace-padded and unknown names) StrictBackendFactory.create_backend()
    # produced 28 probes and this predicate returned true on all 28 — on factory
    # output it really is constant. It is NOT a constant function, though: hand
    # it a probe whose selected_name was substituted, or whose status was
    # demoted to Fallback, and it returns false. Both cases are pinned by the
    # negative arm in test/01_unit/lib/gpu/engine2d/backend_probe_strict_spec.spl
    # ("returns false when a probe was substituted or demoted to Fallback").
    # Do not delete that example: without it the ~30 positive assertions across
    # the strict-probe specs rest on a predicate never shown able to go red.
    fn strict_failure_without_fallback() -> bool:
        if self.status == BackendStatus.Fallback:
            return false
        if self.selected_name != self.requested_name:
            return false
        true

    # Hardware provenance, mirroring helpers_availability.backend_is_hardware:
    # true only for backends that execute on a GPU device. The cpu/software
    # lanes and every cpu_simd lane are capability-gated host paths, never
    # hardware, so they must report false here.
    fn is_hardware() -> bool:
        backend_is_hardware(self.requested_name)

    fn diagnostic_text() -> text:
        "requested={self.requested_name};selected={self.selected_name};status={backend_status_text(self.status)};api={self.api_name};gate={self.feature_gate};shader={self.shader_format};compute={self.has_compute.to_text()};graphics={self.has_graphics.to_text()};present={self.has_present.to_text()};reason={self.reason}"

    fn summary() -> text:
        self.diagnostic_text() + ";executed={self.executed.to_text()};memory_mb={self.memory_mb}"

fn _shader_format_for_backend(name: text) -> text:
    val canonical = backend_canonical_name(name)
    if canonical == BACKEND_CUDA:
        return "ptx"
    if canonical == BACKEND_ROCM:
        return "hsaco"
    if canonical == BACKEND_OPENCL:
        return "opencl-c"
    if canonical == BACKEND_METAL:
        return "msl"
    if canonical == BACKEND_VULKAN:
        return "spirv"
    if canonical == BACKEND_WEBGPU:
        return "wgsl"
    "none"

fn _strict_probe_backend(name: text) -> BackendProbeResult:
    val canonical = backend_canonical_name(name)
    if canonical == BACKEND_CPU or canonical == BACKEND_SOFTWARE:
        var cpu = BackendProbeResult.success(canonical, canonical + " backend available")
        cpu.has_compute = true
        cpu.has_graphics = true
        cpu.has_present = true
        return cpu
    if canonical == BACKEND_CPU_SIMD:
        # HONESTY (doc/08_tracking/bug/cpu_simd_mutable_array_extern_wiring_2026-05-31.md):
        # detect_simd_level() reports the host's *detected* instruction set, but
        # the cpu_simd render/compute lane never dispatches through it (unwired
        # externs, orphaned CpuSimdSession) — so the message must not claim the
        # detected feature is actively used, only that it was observed on the host.
        val lvl = detect_simd_level()
        var cpu = BackendProbeResult.create(canonical, BackendStatus.Initialized, "cpu-simd", "runtime_cpu_features", "none", "CPU renderer (alias of cpu; no live SIMD dispatch); host feature detected=" + lvl.feature_text())
        cpu.has_compute = true
        cpu.has_graphics = true
        cpu.has_present = true
        cpu.memory_mb = 16
        return cpu
    # Arch-specific SIMD probes: check runtime SIMD level for a real evidence match.
    # cpu_simd_arm  → Initialized only when runtime NEON is confirmed (aarch64 host)
    # cpu_simd_x86  → Initialized only when runtime SSE4.2 or AVX2 is confirmed
    # cpu_simd_riscv → Initialized only when runtime RVV is confirmed
    if canonical == "cpu_simd_arm":
        val lvl = detect_simd_level()
        if lvl == SimdLevel.Neon:
            var r = BackendProbeResult.create(canonical, BackendStatus.Initialized, "cpu-simd-arm", "arm_neon_sve", "none", "aarch64 NEON runtime kernels confirmed")
            r.has_compute = true
            r.has_graphics = true
            r.has_present = true
            r.memory_mb = 16
            return r
        var missing = BackendProbeResult.create(canonical, BackendStatus.Unavailable, "cpu-simd-arm", "arm_neon_sve", "none", "cpu_simd_arm not available: runtime NEON not detected on this host")
        missing.memory_mb = 16
        return missing
    if canonical == "cpu_simd_x86":
        val lvl = detect_simd_level()
        if lvl == SimdLevel.Avx2 or lvl == SimdLevel.Sse42:
            var r = BackendProbeResult.create(canonical, BackendStatus.Initialized, "cpu-simd-x86", "x86_sse42_avx2_avx512", "none", "x86_64 SSE/AVX runtime kernels confirmed")
            r.has_compute = true
            r.has_graphics = true
            r.has_present = true
            r.memory_mb = 16
            return r
        var missing = BackendProbeResult.create(canonical, BackendStatus.Unavailable, "cpu-simd-x86", "x86_sse42_avx2_avx512", "none", "cpu_simd_x86 not available: runtime SSE4.2/AVX2 not detected on this host")
        missing.memory_mb = 16
        return missing
    if canonical == "cpu_simd_riscv":
        val lvl = detect_simd_level()
        if lvl == SimdLevel.Rvv:
            var r = BackendProbeResult.create(canonical, BackendStatus.Initialized, "cpu-simd-riscv", "riscv_vector_extension", "none", "riscv64 RVV runtime kernels confirmed")
            r.has_compute = true
            r.has_graphics = true
            r.has_present = true
            r.memory_mb = 16
            return r
        var missing = BackendProbeResult.create(canonical, BackendStatus.Unavailable, "cpu-simd-riscv", "riscv_vector_extension", "none", "cpu_simd_riscv not available: runtime RVV not detected on this host")
        missing.memory_mb = 16
        return missing
    if canonical == BACKEND_ROCM:
        # Hardened 2D diagnostics: ROCm/HIP is a compute-capable hardware API
        # even when no runtime is reachable, so has_compute stays true while
        # has_graphics/has_present stay false (no 2D raster/present path proven).
        var r = BackendProbeResult.create(canonical, BackendStatus.Unavailable, "rocm", "rocm_hip_runtime", "hsaco", "ROCm/HIP probe unavailable in interpreter")
        r.has_compute = true
        return r
    if canonical == BACKEND_OPENCL:
        # Hardened 2D diagnostics: without a live OpenCL session the strongest
        # evidence available here is ICD platform presence, so the gate reports
        # opencl_icd_platform rather than a generic runtime gate. Compute stays
        # true (OpenCL is a compute-only API); graphics/present stay false.
        var r = BackendProbeResult.create(canonical, BackendStatus.Unavailable, "opencl", "opencl_icd_platform", "opencl-c", "OpenCL ICD platform evidence only; session not initialized in interpreter")
        r.has_compute = true
        return r
    if canonical == "optix":
        # OptiX is a ray-tracing/compute API with no Engine2D raster or present
        # path: report it as unsupported-for-2D-raster instead of falling back.
        var r = BackendProbeResult.create(canonical, BackendStatus.Unavailable, "optix", "optix_2d_raster_unsupported", "ptx", "OptiX has no Engine2D raster path; compute-only API")
        r.has_compute = true
        return r
    BackendProbeResult.unavailable(canonical, canonical + " runtime evidence not available")

class BackendProber:
    static fn create() -> BackendProber:
        BackendProber()

    fn probe_backend(name: text) -> BackendProbeResult:
        _strict_probe_backend(name)

    fn probe_cuda() -> BackendProbeResult:
        _strict_probe_backend(BACKEND_CUDA)

    fn probe_rocm() -> BackendProbeResult:
        _strict_probe_backend(BACKEND_ROCM)

    fn probe_opencl() -> BackendProbeResult:
        _strict_probe_backend(BACKEND_OPENCL)

    fn probe_cpu_simd_x86() -> BackendProbeResult:
        _strict_probe_backend("cpu_simd_x86")

    fn probe_cpu_simd_arm() -> BackendProbeResult:
        _strict_probe_backend("cpu_simd_arm")

    fn probe_cpu_simd_riscv() -> BackendProbeResult:
        _strict_probe_backend("cpu_simd_riscv")

    fn probe_cpu() -> BackendProbeResult:
        _strict_probe_backend(BACKEND_CPU)

    # One-line evidence rollup over every hardened Engine2D backend. Mirrors
    # Engine3DBackendProber.probe_all_summary(): each probe contributes its
    # summary(), prefixed by the runtime-evidence selection and suffixed by
    # the per-backend status/gate fields diagnostics tooling greps for.
    fn probe_all_summary() -> text:
        val cpu = self.probe_cpu()
        val cpu_simd = self.probe_backend(BACKEND_CPU_SIMD)
        val x86 = self.probe_cpu_simd_x86()
        val arm = self.probe_cpu_simd_arm()
        val riscv = self.probe_cpu_simd_riscv()
        val vulkan = self.probe_backend(BACKEND_VULKAN)
        val cuda = self.probe_cuda()
        val metal = self.probe_backend(BACKEND_METAL)
        val opencl = self.probe_opencl()
        val rocm = self.probe_rocm()
        val webgpu = self.probe_backend(BACKEND_WEBGPU)
        val optix = self.probe_backend("optix")
        val probes = [cpu, cpu_simd, x86, arm, riscv, vulkan, cuda, metal, opencl, rocm, webgpu, optix]
        var selected = ""
        var joined = ""
        var i = 0
        while i < probes.len():
            val p = probes[i]
            if backend_probe_initialized(p):
                if selected.len() > 0:
                    selected = selected + "+"
                selected = selected + p.selected_name
            if joined.len() > 0:
                joined = joined + " | "
            joined = joined + p.summary()
            i = i + 1
        if selected.len() == 0:
            selected = "none"
        "runtime_evidence selected=" + selected + " | " + joined + " | metal_status=" + backend_status_text(metal.status) + ";vulkan_status=" + backend_status_text(vulkan.status) + ";cuda_status=" + backend_status_text(cuda.status) + ";opencl_status=" + backend_status_text(opencl.status) + ";opencl_gate=" + opencl.feature_gate + ";opencl_reason=" + opencl.reason + ";cpu_simd_x86_status=" + backend_status_text(x86.status) + ";cpu_simd_arm_status=" + backend_status_text(arm.status) + ";cpu_simd_riscv_status=" + backend_status_text(riscv.status)

class StrictBackendFactory:
    static fn strict() -> StrictBackendFactory:
        StrictBackendFactory()

    fn create_backend(name: text) -> BackendProbeResult:
        _strict_probe_backend(name)

export BackendStatus, BackendProbeResult, BackendProber, StrictBackendFactory
export backend_status_text, backend_probe_initialized, backend_probe_fallback
export BACKEND_CPU, BACKEND_SOFTWARE, BACKEND_VULKAN, BACKEND_CUDA, BACKEND_ROCM, BACKEND_OPENCL, BACKEND_METAL, BACKEND_HIP, BACKEND_WEBGPU
export STATUS_OK, STATUS_FAILED, STATUS_FALLBACK
