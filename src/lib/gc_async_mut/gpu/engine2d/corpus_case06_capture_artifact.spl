# Owner-bound Engine2D capture of the admitted corpus case 06 projection.

use std.gc_async_mut.gpu.engine2d.final_output_capture.{
    Engine2dStrictVulkanCapturedFrame}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_selected_device_identity_v1,
    vulkan_sffi_selected_device_type}
use std.gc_async_mut.gpu.browser_engine.web_opaque_box_qualification.{
    WebOpaqueBoxGpuScene}
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow,
    file_hash_sha256}
use common.renderdoc.corpus_case06_oracle.{
    CORPUS_CASE06_FIXTURE_ID, CORPUS_CASE06_SOURCE_PATH,
    CORPUS_CASE06_SOURCE_SHA256, CORPUS_CASE06_REFERENCE_PATH,
    CORPUS_CASE06_REFERENCE_SHA256, CORPUS_CASE06_WIDTH,
    CORPUS_CASE06_HEIGHT}
use common.renderdoc.final_output_pixels.{final_output_validate}
use common.renderdoc.physical_vulkan_2d_qualification.{
    PreparedRenderScene, VulkanBackendCaptureArtifact}

fn _engine2d_case06_web_projection_valid(web: WebOpaqueBoxGpuScene) -> bool:
    if web.source_command_count != 6 or web.gpu_command_count != 5 or
        web.source_command_indexes.len() != 5 or
        web.source_draw_ir.batches.len() != 1 or
        web.gpu_draw_ir.batches.len() != 1:
        return false
    if web.source_command_indexes[0] != 0 or
        web.source_command_indexes[1] != 1 or
        web.source_command_indexes[2] != 2 or
        web.source_command_indexes[3] != 3 or
        web.source_command_indexes[4] != 5:
        return false
    val source = web.source_draw_ir.batches[0].commands
    val gpu = web.gpu_draw_ir.batches[0].commands
    if source.len() != 6 or gpu.len() != 5:
        return false
    var i = 0
    while i < 5:  # cpu-lane-loop-ok: fixed five-command case 06 source-to-GPU mapping check
        val producer = source[web.source_command_indexes[i]]
        val lowered = gpu[i]
        if lowered.component_id != producer.component_id or
            lowered.kind != producer.kind or lowered.x != producer.x or
            lowered.y != producer.y or lowered.width != producer.width or
            lowered.height != producer.height or lowered.color != producer.color:
            return false
        i = i + 1
    val parent = source[4]
    val child_source = source[5]
    val child_gpu = gpu[4]
    if parent.color != 0u32 or parent.width <= 0 or parent.height <= 0 or
        not child_source.clip_rect.present or
        not child_gpu.clip_rect.present:
        return false
    child_source.clip_rect.x == parent.x and
    child_source.clip_rect.y == parent.y and
    child_source.clip_rect.width == parent.width and
    child_source.clip_rect.height == parent.height and
    child_gpu.clip_rect.x == child_source.clip_rect.x and
    child_gpu.clip_rect.y == child_source.clip_rect.y and
    child_gpu.clip_rect.width == child_source.clip_rect.width and
    child_gpu.clip_rect.height == child_source.clip_rect.height

pub fn engine2d_corpus_case06_artifact(
    captured: Engine2dStrictVulkanCapturedFrame,
    scene: PreparedRenderScene,
    web: WebOpaqueBoxGpuScene
) -> Result<VulkanBackendCaptureArtifact, text>:
    if scene.fixture_id != CORPUS_CASE06_FIXTURE_ID or
        scene.source_path != CORPUS_CASE06_SOURCE_PATH or
        scene.source_sha256 != CORPUS_CASE06_SOURCE_SHA256 or
        scene.scene_scope != "corpus-case06-rectangular-clip-only" or
        scene.render_degraded or scene.degrade_reason != "" or
        web.html_sha256 != scene.source_sha256 or
        web.source_draw_ir_sha256.len() != 64 or
        not _engine2d_case06_web_projection_valid(web) or
        not file_is_regular_no_follow(CORPUS_CASE06_SOURCE_PATH) or
        file_hash_sha256(CORPUS_CASE06_SOURCE_PATH) !=
            CORPUS_CASE06_SOURCE_SHA256 or
        not file_is_regular_no_follow(CORPUS_CASE06_REFERENCE_PATH) or
        file_hash_sha256(CORPUS_CASE06_REFERENCE_PATH) !=
            CORPUS_CASE06_REFERENCE_SHA256:
        return Err("Engine2D corpus case 06 source admission invalid")
    val pixels = captured.capture
    if pixels.metadata.fixture_id != scene.fixture_id or
        pixels.metadata.fixture_digest != scene.source_sha256 or
        pixels.metadata.device_status != "ready" or
        pixels.metadata.width != CORPUS_CASE06_WIDTH.to_i64() or
        pixels.metadata.height != CORPUS_CASE06_HEIGHT.to_i64() or
        pixels.metadata.crop_x != 0 or pixels.metadata.crop_y != 0 or
        pixels.metadata.crop_width != CORPUS_CASE06_WIDTH.to_i64() or
        pixels.metadata.crop_height != CORPUS_CASE06_HEIGHT.to_i64():
        return Err("Engine2D corpus case 06 capture domain mismatch")
    val expected_resource = "engine2d-vulkan-framebuffer-{captured.backend_handle}"
    val expected_completion = "{captured.device_identity}:{captured.submission_generation}"
    if pixels.metadata.resource_id != expected_resource or
        pixels.metadata.submission_token != expected_completion or
        pixels.metadata.completion_token != expected_completion:
        return Err("Engine2D corpus case 06 capture owner mismatch")
    match final_output_validate(pixels):
        case Err(err): return Err("Engine2D corpus case 06 capture invalid: " + err.code)
        case Ok(_): ()
    if captured.engine.backend_name() != "vulkan" or
        captured.device_identity <= 0 or captured.backend_handle <= 0 or
        captured.submission_generation <= 0 or captured.submit_count <= 0 or
        captured.fence_count <= 0 or captured.readback_source != "device_readback" or
        not (captured.device_type == "discrete" or
             captured.device_type == "integrated") or
        captured.device_name == "" or captured.driver_identity == "":
        return Err("Engine2D corpus case 06 physical Vulkan owner incomplete")
    if captured.engine.vulkan_submission_generation() != captured.submission_generation or
        captured.engine.vulkan_device_identity() != captured.device_identity or
        captured.engine.vulkan_device_name() != captured.device_name or
        captured.engine.vulkan_device_type() != captured.device_type or
        captured.engine.vulkan_driver_identity() != captured.driver_identity:
        return Err("Engine2D corpus case 06 physical Vulkan owner changed")
    if val Some(frame) = captured.engine.latest_vulkan_frame_receipt():
        if not frame.completion_known or frame.cpu_fallback_used or
            frame.backend_handle != captured.backend_handle or
            frame.device_identity != captured.device_identity or
            frame.device_fence_count != captured.submission_generation or
            frame.device_submit_count < captured.submit_count or
            frame.device_fence_count < captured.fence_count or
            frame.framebuffer_width.to_i64() != pixels.metadata.width or
            frame.framebuffer_height.to_i64() != pixels.metadata.height:
            return Err("Engine2D corpus case 06 frame receipt changed")
    else:
        return Err("Engine2D corpus case 06 frame receipt absent")
    val identity = vulkan_sffi_selected_device_identity_v1(
        captured.device_identity)?
    if identity.device_uuid != captured.device_uuid or
        identity.driver_uuid != captured.driver_uuid or
        vulkan_sffi_selected_device_type() != captured.device_type or
        captured.engine.vulkan_submission_generation() != captured.submission_generation:
        return Err("Engine2D corpus case 06 selected device changed")
    Ok(VulkanBackendCaptureArtifact(
        backend_id: "engine2d-vulkan", fixture_id: scene.fixture_id,
        fixture_sha256: scene.source_sha256,
        producer_authenticated: true, provider_identity: 0,
        device_name: captured.device_name, device_type: captured.device_type,
        driver_identity: captured.driver_identity,
        physical_device_uuid: captured.device_uuid,
        driver_uuid: captured.driver_uuid,
        device_identity: captured.device_identity,
        backend_handle: captured.backend_handle,
        submit_count: captured.submit_count, fence_count: captured.fence_count,
        readback_source: captured.readback_source, fallback_required: false,
        capture: Some(pixels)))
