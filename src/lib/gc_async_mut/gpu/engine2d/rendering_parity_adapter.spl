# Engine2D rendering-parity adapter: Engine2D readback -> canonical straight
# RGBA8 plus truthful backend evidence for common.ui.rendering_parity.
#
# Alpha mode: the Engine2D CPU raster composites in straight alpha
# (color.blend: "Porter-Duff src-over on straight alpha", unpremultiplied
# output), so its framebuffer words are straight ARGB. The caller passes the
# alpha mode of the lane it read; ENGINE2D_CPU_ALPHA_MODE is that value for CPU.
#
use std.gc_async_mut.gpu.engine2d.backend.{Engine2DReadback, engine2d_readback_with_identity}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_draw_ir_adv_composition}
use common.ui.draw_ir.{DrawIrComposition}
use common.ui.rendering_parity.{
    BackendEvidence, backend_evidence, backend_evidence_v1,
    pixel_format_descriptor, argb_u32_to_straight_rgba8,
    PIXEL_FORMAT_ARGB_U32, PIXEL_ALPHA_STRAIGHT, PIXEL_ORIGIN_TOP_LEFT,
    PIXEL_COLOR_SPACE_SRGB, RENDER_STATUS_NOT_RUN,
    RenderingStageRecord, rendering_stage_record_v1, rendering_stage_records_valid_order,
    stable_bytes_checksum
}

val ENGINE2D_PARITY_CONVERTER: text = "engine2d-argb32-to-rgba8-v1"
val ENGINE2D_CPU_ALPHA_MODE: text = PIXEL_ALPHA_STRAIGHT

pub struct Engine2dParityOutput:
    valid: bool
    reason: text
    rgba: [u8]

pub struct Engine2dParityEvidence:
    status: text
    reason: text
    requested_backend: text
    actual_backend: text
    physical_backend: bool
    execution_id: text
    simd_execution_receipt: text
    evidence: BackendEvidence

fn _physical_backend(name: text) -> bool:
    name == "vulkan" or name == "cuda" or name == "metal" or name == "rocm" or name == "directx" or name == "opengl" or name == "opencl"

fn _cpu_backend(name: text) -> bool:
    name == "cpu" or name == "cpu_simd"

# Manifest row name -> explicit Engine2D backend. A GPU row never maps to a CPU backend.
pub fn engine2d_rendering_parity_backend_name(row: text, api: text) -> Result<text, text>:
    if row == "simple_cpu":
        return Ok("cpu")
    if row == "simple_simd":
        return Ok("cpu_simd")
    if row == "simple_gpu":
        if _physical_backend(api):
            return Ok(api)
        return Err("simple_gpu row needs a physical graphics API, got '" + api + "'")
    Err("unknown rendering parity row " + row)

fn _invalid_output(reason: text) -> Engine2dParityOutput:
    Engine2dParityOutput(valid: false, reason: reason, rgba: [])

pub fn engine2d_rendering_parity_canonicalize(readback: Engine2DReadback, width: i64, height: i64, requested_backend: text, actual_backend: text, alpha_mode: text = ENGINE2D_CPU_ALPHA_MODE) -> Engine2dParityOutput:
    if requested_backend != actual_backend:
        return _invalid_output("backend-fallback")
    if width <= 0 or height <= 0 or readback.pixel_count != width * height or readback.pixels.len() != width * height:
        return _invalid_output("invalid-pixel-count")
    if _physical_backend(requested_backend):
        if readback.source != "device_readback":
            return _invalid_output("device-readback-required")
        if readback.device_identity <= 0:
            return _invalid_output("device-identity-required")
    match pixel_format_descriptor(PIXEL_FORMAT_ARGB_U32, alpha_mode, PIXEL_ORIGIN_TOP_LEFT, PIXEL_COLOR_SPACE_SRGB, width * 4, width):
        Err(e): _invalid_output(e)
        Ok(d):
            match argb_u32_to_straight_rgba8(readback.pixels, width, height, d):
                Err(e): _invalid_output(e)
                Ok(rgba): Engine2dParityOutput(valid: true, reason: "", rgba: rgba)

# Evidence for one executed lane. A rejected output, a degraded run or any
# recorded fallback is a "fail", never a pass.
pub fn engine2d_rendering_parity_evidence(case_id: text, readback: Engine2DReadback, width: i64, height: i64, requested_backend: text, actual_backend: text, execution_id: text, revision_id: text, generation: i64, fallback_count: i64, degraded: bool, simd_receipt: text, started_at: i64, finished_at: i64, alpha_mode: text = ENGINE2D_CPU_ALPHA_MODE) -> Result<Engine2dParityEvidence, text>:
    val out = engine2d_rendering_parity_canonicalize(readback, width, height, requested_backend, actual_backend, alpha_mode)
    val physical = _physical_backend(requested_backend)
    val fell_back = requested_backend != actual_backend
    var reason = out.reason
    if out.valid and degraded:
        reason = "degraded-run"
    if out.valid and not degraded and fallback_count > 0:
        reason = "fallback-count-nonzero"
    val status = if reason == "": "pass" else: "fail"
    # A physical claim is only recorded when the lane really is that device.
    val claim = physical and status == "pass"
    val device = if claim: readback.device_identity.to_string() else: ""
    val readback_id = if claim: readback.checksum.to_string() else: ""
    val driver = if claim: "handle-" + readback.backend_handle.to_string() else: ""
    val api = if physical: requested_backend else: "cpu"
    val ev = backend_evidence_v1(
        case_id, requested_backend, api, execution_id, revision_id, driver, device, readback_id,
        width, height, PIXEL_FORMAT_ARGB_U32, generation, fallback_count, claim,
        false, fell_back and _cpu_backend(actual_backend), false, if fell_back: "backend-fallback" else: "",
        started_at, finished_at, status, reason)?
    Ok(Engine2dParityEvidence(
        status: status, reason: reason, requested_backend: requested_backend,
        actual_backend: actual_backend, physical_backend: physical, execution_id: execution_id,
        simd_execution_receipt: simd_receipt, evidence: ev))

# Lane that could not run (e.g. no Vulkan device): never a pass.
pub fn engine2d_rendering_parity_not_run(case_id: text, backend: text, reason: text) -> Result<BackendEvidence, text>:
    backend_evidence(case_id, backend, backend, true, RENDER_STATUS_NOT_RUN, reason)

# Canonical RGBA8 plus the full chained stage list (source stages followed by
# this lane's raster stage) for one executed composition.
pub struct Engine2dParityStagedOutput:
    rgba8: [u8]
    checksum: u64
    stages: [RenderingStageRecord]
    artifact_id: text

pub struct Engine2dParityComposition:
    evidence: Engine2dParityEvidence
    output: Engine2dParityStagedOutput

# Execute one already-observed Draw IR composition on exactly the requested
# backend. The HTML is never re-rendered, and an unavailable backend (for
# example Vulkan without a device) is an Err for the caller to record as
# not_run -- never a silent fallback and never a pass.
pub fn engine2d_rendering_parity_execute_composition(case_id: text, composition: DrawIrComposition, stages: [RenderingStageRecord], width: i64, height: i64, backend: text, execution_id: text, revision_id: text, artifact_id: text, degraded: bool, simd_receipt: text, started_at: i64, finished_at: i64) -> Result<Engine2dParityComposition, text>:
    if width <= 0 or height <= 0:
        return Err("engine2d parity: non-positive viewport")
    if stages.len() == 0:
        return Err("engine2d parity: no source stage records")
    if not rendering_stage_records_valid_order(stages):
        return Err("engine2d parity: source stage records are not a contiguous chain")
    val created = Engine2D.create_requested_backend(width as i32, height as i32, backend)
    if created.is_err():
        return Err("backend unavailable: " + backend + ": " + created.unwrap_err())
    var engine = created.unwrap()
    engine.clear(0u32)
    val result = engine2d_draw_ir_adv_composition(engine, composition, false)
    val actual = engine.backend_name()
    engine.shutdown()
    val readback = engine2d_readback_with_identity(result.pixels, result.readback_source, result.backend_handle, result.device_identity)
    val fallback_count = if result.fallback_required: 1 else: 0
    val evidence = engine2d_rendering_parity_evidence(
        case_id, readback, width, height, backend, actual, execution_id, revision_id,
        composition.generation, fallback_count, degraded, simd_receipt, started_at, finished_at)?
    val out = engine2d_rendering_parity_canonicalize(readback, width, height, backend, actual)
    if not out.valid:
        return Ok(Engine2dParityComposition(evidence: evidence, output: Engine2dParityStagedOutput(rgba8: [], checksum: 0u64, stages: stages, artifact_id: artifact_id)))
    val sum = stable_bytes_checksum(out.rgba)
    val raster = rendering_stage_record_v1(
        case_id, backend, "raster", stages.len(), "framebuffer", "", stages[stages.len() - 1].output_checksum, sum,
        ENGINE2D_PARITY_CONVERTER, 1, degraded, false)?
    Ok(Engine2dParityComposition(evidence: evidence, output: Engine2dParityStagedOutput(rgba8: out.rgba, checksum: sum, stages: stages + [raster], artifact_id: artifact_id)))
