fn vulkan_backend_retain_session(mut backend: VulkanBackend, session: VulkanSession):
    """Retain and store the original session without trusting a native method return."""
    session.retain()
    backend.session = session
    backend.owns_session = true

fn _vulkan_submission_is_proven(backend: VulkanBackend) -> bool:
    """True only when this backend's last batch was proven done ON THE DEVICE.

    Every clause is a fail-closed gate: a sticky CPU fallback, unknown
    completion, an uninitialized surface, a batch that was never submitted, or
    a submission whose fence has not been waited on all mean "not proven".
    """
    if backend.cpu_fallback_used: return false
    if backend.completion_unknown: return false
    if not backend.initialized: return false
    if backend.observed_device_submit_count <= 0: return false
    backend.observed_device_fence_count >= backend.observed_device_submit_count

val VK_IMAGE_INLINE_KEY_MAX_PIXELS: i64 = 64

fn inline_image_key(pixels: [u32], pixel_count: i64, w: i32, h: i32,
                    opacity_milli: i32, composite_mode: i32) -> i64:
    """Digest a SMALL image's own words, once per draw.

    The real page draws 76 one-pixel composites per frame (measured on
    `web_catalog/overview.html`); each was a full upload of four bytes plus an
    SFFI crossing, every frame, forever. For an image this size the content IS
    cheap enough to be its own identity -- which is why the caller applies a
    hard pixel bound before calling here, and never digests a large image.

    `opacity_milli` and `composite_mode` are folded in even though they do not
    change the SOURCE bytes: they are free here, and folding them keeps the key
    a strictly finer partition than the buffer's contents.
    """
    var hash: i64 = 1469598103934665603
    hash = _fnv_mix_i64(hash, _i64(w))
    hash = _fnv_mix_i64(hash, _i64(h))
    hash = _fnv_mix_i64(hash, _i64(opacity_milli))
    hash = _fnv_mix_i64(hash, _i64(composite_mode))
    var i: i64 = 0
    while i < pixel_count:
        hash = _fnv_mix_i64(hash, _i64(pixels[i].to_i32()))
        i = i + 1
    if hash == 0: 1 else: hash

fn text_blit_image_key(text_val: text, color: u32, font_size: i32, w: i32, h: i32) -> i64:
    """FNV-1a over a text blit's IDENTITY -- never over its pixels.

    The raster `text_blit_buffer` produces is a pure function of these five
    values (it carries no position), so this walks the string once per draw
    instead of digesting the 4 * w * h bytes it would cost to hash the raster.
    A per-frame pixel digest would cost more than the upload it saves, which is
    exactly why the key must come from the producer.

    Non-zero by construction: 0 is reserved for "no key", and a hash that landed
    on it would silently disable the cache for that one string.
    """
    var hash: i64 = 1469598103934665603
    hash = _fnv_mix_i64(hash, _i64(color.to_i32()))
    hash = _fnv_mix_i64(hash, _i64(font_size))
    hash = _fnv_mix_i64(hash, _i64(w))
    hash = _fnv_mix_i64(hash, _i64(h))
    for ch in text_val.chars():
        hash = _fnv_mix_i64(hash, ch.to_i64())
    if hash == 0: 1 else: hash

fn _fnv_mix_i64(hash: i64, value: i64) -> i64:
    """Fold all 8 bytes of `value` into an FNV-1a accumulator."""
    var h = hash
    var shift: i64 = 0
    while shift < 64:
        h = (h ^ ((value >> shift) & 255)) * 1099511628211
        shift = shift + 8
    h

fn vulkan_submitted_framebuffer_handle(backend: VulkanBackend) -> i64:
    """Framebuffer handle safe to present directly, or 0 when unproven."""
    if not _vulkan_submission_is_proven(backend): return 0
    backend.d_framebuffer

fn vulkan_framebuffer_ownership_handle(backend: VulkanBackend) -> i64:
    """Handle identifying the allocation this backend OWNS.

    Unlike `vulkan_submitted_framebuffer_handle` this does not require a proven
    submission -- ownership exists as soon as the device allocation does -- but
    it is still 0 on CPU fallback or before initialization, because in those
    cases there is no device allocation to own.
    """
    if backend.cpu_fallback_used: return 0
    if not backend.initialized: return 0
    backend.d_framebuffer

fn vulkan_submitted_device_identity(backend: VulkanBackend) -> i64:
    """Device that executed the proven submission, or 0 when unproven."""
    if not _vulkan_submission_is_proven(backend): return 0
    backend.session.device

fn vulkan_submitted_generation(backend: VulkanBackend) -> i64:
    """Monotonic proven-completion counter, or 0 when unproven.

    This is the fence count, not the submit count: it only advances after an
    explicit wait succeeded, so it can never name work still in flight.
    """
    if not _vulkan_submission_is_proven(backend): return 0
    backend.observed_device_fence_count

fn vulkan_accepted_compute_submits(backend: VulkanBackend) -> i64:
    """Queue submissions the device has ACCEPTED so far, process-wide.

    Deliberately not derived from `observed_device_fence_count`: that counter
    advances once per proven completion, so a frame with two submissions and
    one wait reads the same as a frame with one submission. This is the
    submission count itself, which is what a "one submit per frame" claim is
    about. Zero when no device is up, which callers must treat as unknown
    rather than as a passing measurement.
    """
    if backend.completion_unknown: return 0
    vulkan_sffi_accepted_compute_submit_count()

fn vulkan_cancel_submitted_present_source(
    mut backend: VulkanBackend, framebuffer: i64, receipt: i64
) -> bool:
    """Withdraw a present source published by a proven submission.

    Fail-closed and exact-match: the caller must name both the framebuffer
    handle and the generation it was handed. A stale or mismatched pair
    cancels nothing and returns false, so a late cancel cannot tear down a
    newer frame's present source.
    """
    val handle = vulkan_submitted_framebuffer_handle(backend)
    if handle == 0: return false
    if framebuffer != handle: return false
    if receipt != vulkan_submitted_generation(backend): return false
    backend.frame_present_attempted = false
    backend.frame_present_completed = false
    backend.frame_device_present = false
    backend.frame_present_mode = "cancelled"
    backend.presentation_swapchain = 0
    true

impl RenderBackend for VulkanBackend:

    fn name() -> text:
        "vulkan"

    me init(width: i32, height: i32) -> bool:
        self.last_error = ""
        var session = VulkanSession.create()
        val session_status = session.init()
        # Native status-code comparison has historically been vulnerable to
        # ABI/codegen corruption (a printed zero entered the nonzero branch on
        # macOS arm64).  Session validity is the authoritative success state:
        # init sets it only after the device, shaders, and pipelines exist.
        if not session.is_valid():
            val reason = if session.init_error == "": session_status.to_text() else: session.init_error
            self.last_error = "Vulkan shared session initialization failed: " + reason
            return false
        if not self.init_with_session(width, height, session):
            session.release()
            return false
        session.release()
        true

    me init_headless_present(width: i32, height: i32, vsync: bool) -> bool:
        """Initialize compute and a same-device headless swapchain.

        This must be the first Vulkan owner in the process. The resulting
        presentation is a real vkQueuePresentKHR completion but is explicitly
        headless and must not be reported as a visible window/screen surface.
        """
        if self.initialized or self.presentation_swapchain != 0:
            self.last_error = "Vulkan backend already initialized"
            return false
        val swapchain = vulkan_sffi_init_headless_present(
            width.to_i64(), height.to_i64(), vsync)
        if swapchain <= 0:
            self.last_error = vulkan_sffi_last_error()
            return false
        if not self.init(width, height):
            vulkan_sffi_destroy_swapchain(swapchain)
            return false
        self.presentation_swapchain = swapchain
        self.presentation_mode = "headless-swapchain"
        true

    me init_window_present(width: i32, height: i32, vsync: bool) -> bool:
        """Initialize Engine2D on a same-device visible window swapchain."""
        if self.initialized or self.presentation_swapchain != 0:
            self.last_error = "Vulkan backend already initialized"
            return false
        val swapchain = vulkan_sffi_init_window_present(
            width.to_i64(), height.to_i64(), vsync)
        if swapchain <= 0:
            self.last_error = vulkan_sffi_last_error()
            return false
        if not self.init(width, height):
            vulkan_sffi_destroy_swapchain(swapchain)
            return false
        self.presentation_swapchain = swapchain
        self.presentation_mode = "window-swapchain"
        true

    me init_external_window_present(kind: i64, display: i64, window: i64, width: i32, height: i32, vsync: bool) -> bool:
        """Adopt a caller-owned native window before Vulkan device selection."""
        if self.initialized or self.presentation_swapchain != 0:
            self.last_error = "Vulkan backend already initialized"
            return false
        val swapchain = vulkan_sffi_init_external_window_present(
            kind, display, window, width.to_i64(), height.to_i64(), vsync)
        if swapchain <= 0:
            self.last_error = vulkan_sffi_last_error()
            return false
        if not self.init(width, height):
            vulkan_sffi_destroy_swapchain(swapchain)
            return false
        self.presentation_swapchain = swapchain
        self.presentation_mode = "window-swapchain"
        true

    me init_with_session(width: i32, height: i32, session: VulkanSession) -> bool:
        """Initialise this backend surface using a pre-initialised shared VulkanSession.

        The session must already have been successfully init()ed.  This backend
        borrows the session's pipelines (no shader recompilation) and retains
        the session so it stays alive for the lifetime of this surface.
        shutdown() will call session.release().

        Per-surface state (framebuffer, host buffer, clip region) is still
        owned exclusively by this backend.
        """
        if self.initialized or self.owns_session:
            self.last_error = "Vulkan backend already owns an active session"
            return false
        if width <= 0 or height <= 0:
            self.last_error = "Vulkan framebuffer dimensions are invalid"
            return false
        if not session.is_valid():
            self.last_error = "Vulkan session is invalid"
            return false
        # Keep the original session value. Hosted native compilation can corrupt
        # a class-valued return from a mutating no-argument method.
        vulkan_backend_retain_session(self, session)

        # Borrow shared pipeline handles from the session
        self.shader_clear         = session.shader_clear
        self.shader_rect_filled   = session.shader_rect_filled
        self.shader_rect_outline  = session.shader_rect_outline
        self.shader_circle_filled = session.shader_circle_filled
        self.shader_circle_outline = session.shader_circle_outline
        self.shader_line          = session.shader_line
        self.shader_rounded_rect  = session.shader_rounded_rect
        self.shader_triangle      = session.shader_triangle
        self.shader_gradient      = session.shader_gradient
        self.shader_blit          = session.shader_blit

        self.pipe_clear          = session.pipe_clear
        self.pipe_rect_filled    = session.pipe_rect_filled
        self.pipe_rect_outline   = session.pipe_rect_outline
        self.pipe_circle_filled  = session.pipe_circle_filled
        self.pipe_circle_outline = session.pipe_circle_outline
        self.pipe_line           = session.pipe_line
        self.pipe_rounded_rect   = session.pipe_rounded_rect
        self.pipe_triangle       = session.pipe_triangle
        self.pipe_gradient       = session.pipe_gradient
        self.pipe_blit           = session.pipe_blit
        self.pipe_rect_batch     = session.pipe_rect_batch
        self.rect_batch_error    = session.rect_batch_error

        self.w = width
        self.h = height

        # Allocate per-surface device framebuffer storage buffer
        # Usage 0x80 = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
        val fb_size = _i64(width) * _i64(height) * 4
        self.d_framebuffer = vulkan_sffi_alloc_buffer(fb_size, 0x80)
        if self.d_framebuffer == 0:
            self.last_error = "vulkan_sffi_alloc_buffer failed: " + vulkan_sffi_last_error()
            self._clear_borrowed_pipeline_handles()
            self.session.release()
            self.owns_session = false
            return false

        # Allocate host readback buffer
        val total = width * height
        self.host_buf = [0u32; total]

        self.clip_x = 0
        self.clip_y = 0
        self.clip_w = width
        self.clip_h = height
        self.clip_enabled = false
        self.initialized = true
        self.dirty = false
        self.present_damage_rects = []
        self.present_damage_valid = false
        self.host_mirror_valid = false
        self._clear_frame_damage()
        self.present_readback_bytes = 0
        self.present_readback_rect_count = 0
        self.present_full_readback_count = 0
        self.present_noop_count = 0
        self.device_finalize_no_readback_count = 0
        self.device_content_revision = 0
        self.frame_index = 0
        self.frame_dirty_rect_count = 0
        self.frame_device_to_present_bytes = 0
        self.frame_device_to_present_rect_count = 0
        self.frame_readback_requested = false
        self.frame_readback_completed = false
        self.frame_present_attempted = false
        self.frame_present_completed = false
        self.frame_present_mode = "none"
        self.frame_host_cache_refresh_completed = false
        self.frame_full_fallback = false
        self.frame_fallback_reason = ""
        self.frame_device_present = false
        self.pending_compute_command = 0
        self.pending_compute_pipelines = []
        self.pending_compute_descriptors = []
        self.pending_compute_sources = []
        self.pending_compute_count = 0
        self.image_source_pool = []
        self.image_source_pool_capacity = []
        self.image_source_pool_key = []
        self.image_source_pool_device_identity = 0
        self.image_source_pool_session_generation = 0
        self.image_source_pool_surface_identity = 0
        self.image_source_pool_reuse_count = 0
        self.image_source_pool_allocation_count = 0
        self.image_source_pool_replacement_count = 0
        self.image_source_upload_count = 0
        self.image_source_upload_bytes = 0
        self.image_upload_scratch = []
        self.image_upload_scratch_reuse_count = 0
        self.image_upload_scratch_resize_count = 0
        self.image_upload_scratch_fallback_count = 0
        self.cpu_fallback_used = false
        self.cpu_fallback_reason = ""
        true

    me mark_cpu_fallback(reason: text):
        """Record the first operation that forced host framebuffer mutation."""
        if not self.cpu_fallback_used:
            self.cpu_fallback_reason = reason
            if vulkan_order_trace_enabled():
                vulkan_order_trace("cpu-fallback-first reason=" + reason)
        self.cpu_fallback_used = true

    me mark_completion_unknown():
        self.completion_unknown = true

    me mark_device_content_changed():
        if self.device_content_revision >= 9223372036854775806:
            self.device_content_revision = 1
        else:
            self.device_content_revision += 1

    me enable_frame_batching():
        self.frame_batching_enabled = true

    me _mark_readback_length_failed():
        self.last_error = "Vulkan framebuffer readback byte count mismatch"

    me shutdown():
        # Host-only upload staging is never a GPU dependency. Release it even
        # when unknown device completion forces the GPU-resource quarantine
        # path to return early below.
        self.image_upload_scratch = []
        val pending_status = self._flush_pending_compute_at("shutdown")
        if pending_status < 0:
            self.completion_unknown = true
        if self.completion_unknown:
            if not vulkan_sffi_recover_dependency_quarantine():
                # Preserve every potentially in-flight resource. The runtime
                # quarantine owns eventual process-level cleanup.
                return
            self.completion_unknown = false
        self._destroy_image_source_pool()
        if self.presentation_swapchain != 0:
            vulkan_sffi_destroy_swapchain(self.presentation_swapchain)
            self.presentation_swapchain = 0
            self.presentation_mode = "none"
        if self.d_font_params != 0:
            vulkan_sffi_free_buffer(self.d_font_params)
            self.d_font_params = 0
        for descriptor in self.image_descriptor_pool:
            if not vulkan_sffi_destroy_descriptor_set(descriptor):
                vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
        self.image_descriptor_pool = []
        self.font_atlas_cpu_scale = -1
        self.font_atlas_cpu_glyph_height = -1
        self.font_atlas_cpu_pixels = []
        self.font_atlas_cpu_build_count = 0
        self.midframe_flush_count = 0
        for descriptor in self.font_descriptor_pool:
            vulkan_sffi_destroy_descriptor_set(descriptor)
        for params in self.font_params_pool:
            vulkan_sffi_free_buffer(params)
        self.image_descriptor_pool = []
        self.font_descriptor_pool = []
        self.font_params_pool = []
        self.font_params_pool_capacity = []
        # Free every per-owner slot. `d_font_atlas` aliases whichever slot was
        # active, so it must NOT be freed a second time below.
        for slot_handle in self.font_atlas_slot_handles:
            if slot_handle != 0:
                vulkan_sffi_free_buffer(slot_handle)
        val atlas_was_slotted = self.font_atlas_slot_handles.len() > 0
        self.font_atlas_slot_handles = []
        self.font_atlas_slot_owners = []
        self.font_atlas_slot_sequences = []
        self.font_atlas_slot_referenced = []
        self.font_atlas_active_slot = -1
        if self.d_font_atlas != 0:
            if not atlas_was_slotted:
                vulkan_sffi_free_buffer(self.d_font_atlas)
            self.d_font_atlas = 0
        self.font_atlas_generation = -1
        self.font_atlas_owner_identity = ""
        self.font_atlas_payload_sha256 = ""
        # The device buffer is gone, so the mirror no longer describes anything.
        self.font_atlas_host_bytes = []
        self.font_atlas_host_identity = ""
        self.font_atlas_host_valid = false
        self.font_atlas_host_generation = -1
        self.font_atlas_host_owner_sequence = -1
        self.font_atlas_mirror_slots = []
        self.font_atlas_width = 0
        self.font_atlas_height = 0
        self.font_atlas_upload_count = 0
        self.font_atlas_upload_bytes = 0
        self.font_gpu_resource_high_water_bytes = 0
        self.font_oracle_mode = false
        self.pending_font_descriptors = []
        self.pending_font_params = []
        self.pending_font_glyph_count = 0
        self.font_frame_command_count = 0
        self.font_frame_submission_count = 0
        self.font_frame_fence_count = 0
        if self.owns_session:
            # Session owns shaders/pipelines — do not destroy them here
            if self.d_framebuffer != 0:
                vulkan_sffi_free_buffer(self.d_framebuffer)
                self.d_framebuffer = 0
            self.host_buf = []
            self.present_damage_rects = []
            self.present_damage_valid = false
            self.host_mirror_valid = false
            self.w = 0
            self.h = 0
            self.mask_buf = []
            self.mask_w = 0
            self.mask_h = 0
            self.initialized = false
            self._clear_borrowed_pipeline_handles()
            self.session.release()
            self.owns_session = false
            return

        # Standalone (no shared session): destroy pipelines and shaders here
        # Destroy pipelines
        if self.pipe_clear != 0: vulkan_sffi_destroy_pipeline(self.pipe_clear)
        if self.pipe_rect_filled != 0: vulkan_sffi_destroy_pipeline(self.pipe_rect_filled)
        if self.pipe_rect_outline != 0: vulkan_sffi_destroy_pipeline(self.pipe_rect_outline)
        if self.pipe_circle_filled != 0: vulkan_sffi_destroy_pipeline(self.pipe_circle_filled)
        if self.pipe_circle_outline != 0: vulkan_sffi_destroy_pipeline(self.pipe_circle_outline)
        if self.pipe_line != 0: vulkan_sffi_destroy_pipeline(self.pipe_line)
        if self.pipe_rounded_rect != 0: vulkan_sffi_destroy_pipeline(self.pipe_rounded_rect)
        if self.pipe_triangle != 0: vulkan_sffi_destroy_pipeline(self.pipe_triangle)
        if self.pipe_gradient != 0: vulkan_sffi_destroy_pipeline(self.pipe_gradient)
        if self.pipe_blit != 0: vulkan_sffi_destroy_pipeline(self.pipe_blit)
        # Destroy shader modules
        if self.shader_clear != 0: vulkan_sffi_destroy_shader(self.shader_clear)
        if self.shader_rect_filled != 0: vulkan_sffi_destroy_shader(self.shader_rect_filled)
        if self.shader_rect_outline != 0: vulkan_sffi_destroy_shader(self.shader_rect_outline)
        if self.shader_circle_filled != 0: vulkan_sffi_destroy_shader(self.shader_circle_filled)
        if self.shader_circle_outline != 0: vulkan_sffi_destroy_shader(self.shader_circle_outline)
        if self.shader_line != 0: vulkan_sffi_destroy_shader(self.shader_line)
        if self.shader_rounded_rect != 0: vulkan_sffi_destroy_shader(self.shader_rounded_rect)
        if self.shader_triangle != 0: vulkan_sffi_destroy_shader(self.shader_triangle)
        if self.shader_gradient != 0: vulkan_sffi_destroy_shader(self.shader_gradient)
        if self.shader_blit != 0: vulkan_sffi_destroy_shader(self.shader_blit)
        # Free framebuffer
        if self.d_framebuffer != 0:
            vulkan_sffi_free_buffer(self.d_framebuffer)
            self.d_framebuffer = 0
        self.host_buf = []
        self.present_damage_rects = []
        self.present_damage_valid = false
        self.host_mirror_valid = false
        self._clear_frame_damage()
        self.w = 0
        self.h = 0
        self.mask_buf = []
        self.mask_w = 0
        self.mask_h = 0
        self.initialized = false

    me clear(color: u32):
        if self.completion_unknown: return
        val total = _i64(self.w) * _i64(self.h)
        val workgroups = (total + 255) / 256
        val pc = _pack_clear_pc(color, self.w, self.h)
        self.hint_damage(0, 0, _i64(self.w), _i64(self.h))
        val dispatched = self._dispatch_framebuffer_checked(self.pipe_clear, pc, workgroups, 1, 1, "clear-dispatch-failed")
        if dispatched > 0:
            self.dirty = true
            self.host_mirror_frame_fresh = false
        else:
            if dispatched < 0:
                self.completion_unknown = true
            elif self.initialized and self.d_framebuffer > 0:
                self.dirty = true
                self.host_mirror_frame_fresh = false
                # A dispatch that failed leaves the device surface in an
                # unknown state; the hinted rect no longer bounds the change.
                self.note_damage_full()

    me draw_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        if self.completion_unknown: return
        val pc = _pack_rect_pc(x, y, w, h, color, self.w, self.h, self.clip_x, self.clip_y, self.clip_w, self.clip_h, self.clip_enabled)
        val gx = (_i64(w) + 15) / 16
        val gy = (_i64(h) + 15) / 16
        self.hint_damage(_i64(x), _i64(y), _i64(w), _i64(h))
        self._dispatch_framebuffer_checked(self.pipe_rect_outline, pc, gx, gy, 1, "rect-outline-dispatch-failed")

    me draw_rect_filled(x: i32, y: i32, w: i32, h: i32, color: u32):
        # Timed shim: the body is unchanged in `_draw_rect_filled_impl`. Split
        # this way rather than by start/stop pairs at every `return` because the
        # body has six exits and a missed one would silently under-report.
        if not vulkan_timing_enabled():
            self._draw_rect_filled_impl(x, y, w, h, color)
            return
        val _t = vulkan_timing_now_us()
        self._draw_rect_filled_impl(x, y, w, h, color)
        vulkan_timing_add(VK_T_RECT, _t)

    me _draw_rect_filled_impl(x: i32, y: i32, w: i32, h: i32, color: u32):
        if self.completion_unknown: return
        _vk_stat_rect(w, h, color_a(color) < 255, self.mask_buf.len() > 0 and color_a(color) >= 255)
        if color_a(color) < 255:
            val pixel_count = _i64(w) * _i64(h)
            if pixel_count <= 0:
                return
            if pixel_count > 2147483647:
                self.mark_cpu_fallback("alpha-rect-size-overflow")
                return
            val pixels: [u32] = [color; w * h]
            self.draw_image_blend(x, y, w, h, pixels)
            return
        if self.mask_buf.len() > 0:
            # The rect compute kernel packs clip state but has no mask plane,
            # so a device dispatch would paint straight through an active
            # stencil mask (observed as vulkan-vs-software mask parity
            # divergence in native_shader_backend_readback_matrix_spec).
            # Route through the host image path, which applies clip AND mask.
            if w <= 0 or h <= 0:
                return
            if _i64(w) * _i64(h) > 2147483647:
                self.mark_cpu_fallback("masked-rect-size-overflow")
                return
            val masked_pixels: [u32] = [color; w * h]
            self.draw_image(x, y, w, h, masked_pixels)
            return
        val pc = _pack_rect_pc(x, y, w, h, color, self.w, self.h, self.clip_x, self.clip_y, self.clip_w, self.clip_h, self.clip_enabled)
        val gx = (_i64(w) + 15) / 16
        val gy = (_i64(h) + 15) / 16
        self.hint_damage(_i64(x), _i64(y), _i64(w), _i64(h))
        val dispatched = self._dispatch_framebuffer_checked(self.pipe_rect_filled, pc, gx, gy, 1, "rect-dispatch-failed")
        if dispatched > 0:
            self.dirty = true
            self.host_mirror_frame_fresh = false
        else:
            if dispatched < 0:
                self.completion_unknown = true
            elif self.initialized and self.d_framebuffer > 0:
                self.dirty = true
                self.host_mirror_frame_fresh = false
                # A dispatch that failed leaves the device surface in an
                # unknown state; the hinted rect no longer bounds the change.
                self.note_damage_full()

    me draw_rect_list_filled(rects: [i32], colors: [u32]):
        """Paint N filled rects with ONE interpreter transit and one dispatch each.

        Packed layout (frozen, see `_enqueue_rect_batch`):
          rects[4k..4k+4] = x,y,w,h of rect k; colors[k] = its colour.
        Painter order is array order. A malformed pair (length mismatch) paints
        nothing rather than painting a guessed prefix.

        Semantics are identical to calling `draw_rect_filled` once per rect --
        this method is a throughput lane, not a different renderer. Anything
        the fast lane cannot express (an active stencil mask, or any
        non-opaque colour, both of which route through the host image path in
        the single-rect method) falls back to the single-rect loop for the
        WHOLE list, so painter order can never be reordered by a partial
        fallback.

        One deliberate, stated divergence: a zero-or-negative-area rect is
        SKIPPED here, whereas the single-rect path dispatches it, gets rc 0 back
        from a gx=0 dispatch, and consequently flushes mid-frame and marks a CPU
        fallback. The PIXELS are identical either way (a zero-area rect paints
        nothing); the counters are not. Skipping is the correct behaviour and
        the single path's is arguably the bug, but this method does not claim to
        reproduce it.
        """
        if self.completion_unknown: return
        _vk_stat_rect_list_op()
        val count = colors.len().to_i64()
        if count <= 0: return
        if rects.len().to_i64() != count * 4: return
        if self.mask_buf.len() > 0:
            self._draw_rect_list_single(rects, colors, 0, count)
            return
        var k: i64 = 0
        while k < count:
            if color_a(colors[k]) < 255:
                self._draw_rect_list_single(rects, colors, 0, count)
                return
            k = k + 1
        # Preferred lane: ONE compute dispatch reading the rect list out of a
        # GPU storage buffer. This is what removes the per-rect interpreter
        # cost entirely rather than halving it -- the host loop below still
        # pays two SFFI calls per rect. When the batch pipeline is unavailable
        # (old driver, SPIR-V rejected; `rect_batch_error` carries the reason)
        # the host loop is the fallback, and its pixels are identical.
        var enqueued: i64 = 0
        if (self.frame_batching_enabled and self.pipe_rect_batch > 0 and
            count >= RECT_BATCH_MIN_RECTS):
            enqueued = self._enqueue_rect_batch_gpu(rects, colors)
        if enqueued == 0 and self.frame_batching_enabled:
            enqueued = self._enqueue_rect_batch(self.pipe_rect_filled, rects, colors)
        if enqueued < 0:
            self.completion_unknown = true
            self.mark_cpu_fallback("rect-batch-dispatch-failed")
            return
        if enqueued > 0:
            self.dirty = true
            self.host_mirror_frame_fresh = false
            # The batch enqueues bypass `_dispatch_framebuffer_checked`, so the
            # funnel never sees them. Widening to the whole surface is the
            # fail-safe reading; a per-rect union here would be a second,
            # independently-wrong damage accountant.
            self.note_damage_full()
            self.mark_device_content_changed()
        if enqueued < count:
            # Replay only the tail; everything before `enqueued` is already
            # recorded, so order holds.
            self._draw_rect_list_single(rects, colors, enqueued, count)

    me _draw_rect_list_single(rects: [i32], colors: [u32], from: i64, to: i64):
        var k = from
        while k < to:
            val base = k * 4
            self.draw_rect_filled(rects[base], rects[base + 1], rects[base + 2],
                                  rects[base + 3], colors[k])
            k = k + 1

    me draw_line(x1: i32, y1: i32, x2: i32, y2: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        if thickness <= 0:
            self.mark_cpu_fallback("line-thickness-invalid")
            return
        val dx = _i64(x2) - _i64(x1)
        val dy = _i64(y2) - _i64(y1)
        val abs_dx = if dx < 0: -dx else: dx
        val abs_dy = if dy < 0: -dy else: dy
        # A thickness-1 axis-aligned Bresenham line is exactly one inclusive
        # filled rectangle. Route this dominant GUI/Web border/separator case
        # through the parallel 16x16 rectangle shader; keep diagonal and thick
        # strokes on the ordered single-invocation Bresenham oracle.
        if thickness == 1 and (x1 == x2 or y1 == y2) and abs_dx < 2147483647 and abs_dy < 2147483647:
            val rx = if x1 < x2: x1 else: x2
            val ry = if y1 < y2: y1 else: y2
            val rw = (abs_dx + 1).to_i32()
            val rh = (abs_dy + 1).to_i32()
            val rect_pc = _pack_rect_pc(
                rx, ry, rw, rh, color, self.w, self.h,
                self.clip_x, self.clip_y, self.clip_w, self.clip_h,
                self.clip_enabled)
            self.hint_damage(_i64(rx), _i64(ry), _i64(rw), _i64(rh))
            val rect_dispatched = self._dispatch_framebuffer_checked(
                self.pipe_rect_filled, rect_pc,
                (_i64(rw) + 15) / 16, (_i64(rh) + 15) / 16, 1, "axis-line-rect-dispatch-failed")
            if rect_dispatched > 0:
                self.dirty = true
                self.host_mirror_frame_fresh = false
            else:
                if rect_dispatched < 0:
                    self.completion_unknown = true
            return
        # The line kernel owns the ordered Bresenham state and every pixel
        # write in one device invocation.  This is deliberately not a host
        # raster loop and cannot be counted when the dispatch fails.
        var steps = if abs_dx > abs_dy: abs_dx else: abs_dy
        if steps == 0:
            steps = 1
        if steps <= 0 or steps > 2147483647:
            self.mark_cpu_fallback("line-dispatch-size-invalid")
            return
        val pc = _pack_line_pc(
            x1, y1, x2, y2, color, thickness, self.w, self.h,
            self.clip_x, self.clip_y, self.clip_w, self.clip_h,
            self.clip_enabled)
        val dispatched = self._dispatch_framebuffer_checked(
            self.pipe_line, pc, 1, 1, 1, "line-dispatch-failed")
        if dispatched > 0:
            self.dirty = true
            self.host_mirror_frame_fresh = false
        else:
        if dispatched < 0:
            self.completion_unknown = true

    me draw_circle(cx: i32, cy: i32, r: i32, color: u32):
        if self.completion_unknown: return
        # Circle OUTLINE composed from real GPU draw_rect_filled dispatches using
        # the same midpoint algorithm as SoftwareBackend — real device pixels,
        # bit-exact with the CPU reference. The dedicated circle-outline SPIR-V
        # kernel is a distance-ring that diverges from the Bresenham-midpoint
        # contract, so it stays unwired.
        # See bug vulkan_raster_kernels_noop_and_divergent_2026-06-17.
        emu_draw_circle(self, cx, cy, r, color)

    me draw_circle_filled(cx: i32, cy: i32, r: i32, color: u32):
        if self.completion_unknown: return
        val bw = 2 * r + 1
        val bh = 2 * r + 1
        val gx = (_i64(bw) + 15) / 16
        val gy = (_i64(bh) + 15) / 16
        val pc = _pack_circle_pc(cx, cy, r, color, self.w, self.h, 1, self.clip_x, self.clip_y, self.clip_w, self.clip_h, self.clip_enabled)
        self._dispatch_framebuffer_checked(self.pipe_circle_filled, pc, gx, gy, 1, "circle-filled-dispatch-failed")

    me draw_rounded_rect(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32):
        if self.completion_unknown: return
        # Filled rounded rect composed from real GPU draw_rect_filled dispatches
        # (3 band rects + 4 anti-aliased corner boxes), matching SoftwareBackend
        # exactly — this IS the Vulkan lane's implementation of the SHARED
        # ROUNDED-RECT CORNER COVERAGE FORMULA v1, since the AA lives in the emu
        # expansion and reaches the GPU as per-pixel alpha-modulated fills. The
        # formula is defined once above emu_draw_rounded_rect in backend_emu.spl.
        # The dedicated rounded_rect SPIR-V kernel fills a plain rect (ignores the
        # corner radius), diverging from the engine contract, so it stays unwired.
        # See bug vulkan_raster_kernels_noop_and_divergent_2026-06-17.
        emu_draw_rounded_rect(self, x, y, w, h, radius, color)

    me draw_triangle_filled(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32):
        if self.completion_unknown: return
        # Compute bounding box of triangle
        var min_x = x1
        if x2 < min_x: min_x = x2
        if x3 < min_x: min_x = x3
        var min_y = y1
        if y2 < min_y: min_y = y2
        if y3 < min_y: min_y = y3
        var max_x = x1
        if x2 > max_x: max_x = x2
        if x3 > max_x: max_x = x3
        var max_y = y1
        if y2 > max_y: max_y = y2
        if y3 > max_y: max_y = y3

        val bw = max_x - min_x + 1
        val bh = max_y - min_y + 1
        val gx = (_i64(bw) + 15) / 16
        val gy = (_i64(bh) + 15) / 16
        val pc = _pack_triangle_pc(x1, y1, x2, y2, x3, y3, color, self.w, self.h, min_x, min_y, self.clip_x, self.clip_y, self.clip_w, self.clip_h, self.clip_enabled)
        self._dispatch_framebuffer_checked(self.pipe_triangle, pc, gx, gy, 1, "triangle-filled-dispatch-failed")

    me draw_gradient_rect(x: i32, y: i32, w: i32, h: i32, top_color: u32, bottom_color: u32):
        if self.completion_unknown: return
        val gx = (_i64(w) + 15) / 16
        val gy = (_i64(h) + 15) / 16
        val pc = _pack_gradient_pc(x, y, w, h, top_color, bottom_color, self.w, self.h, self.clip_x, self.clip_y, self.clip_w, self.clip_h, self.clip_enabled)
        self.hint_damage(_i64(x), _i64(y), _i64(w), _i64(h))
        self._dispatch_framebuffer_checked(self.pipe_gradient, pc, gx, gy, 1, "gradient-rect-dispatch-failed")

    # Bitmap text goes through the font-atlas pipeline whenever that pipeline can
    # reproduce the CPU raster exactly (`_bitmap_text_atlas_path`,
    # backend_vulkan_font.spl); otherwise the original CPU raster + image blit
    # runs unchanged. `last_text_path` / `last_text_fallback_reason` always say
    # which of the two actually happened.
    me draw_text(x: i32, y: i32, text_val: text, color: u32, font_size: i32):
        if not vulkan_timing_enabled():
            self._draw_text_impl(x, y, text_val, color, font_size)
            return
        val _t = vulkan_timing_now_us()
        self._draw_text_impl(x, y, text_val, color, font_size)
        vulkan_timing_add(VK_T_TEXT, _t)

    me _draw_text_impl(x: i32, y: i32, text_val: text, color: u32, font_size: i32):
        _vk_stat_text_op()
        if self.completion_unknown:
            self.last_text_path = VULKAN_TEXT_PATH_NOT_DRAWN
            self.last_text_fallback_reason = "completion-unknown"
            return
        if not self.initialized:
            self.dirty = true
            self.host_mirror_frame_fresh = false
            self.note_damage_full()
            self.last_text_path = VULKAN_TEXT_PATH_CPU_RASTER
            self.last_text_fallback_reason = "backend-uninitialized"
            return
        if not self._bitmap_text_atlas_path(x, y, text_val, color, font_size):
            return
        val text_buf = text_blit_buffer(text_val, color, 0x00000000u32, font_size)
        if text_buf.is_empty():
            return
        # The FIRST in-tree producer of an image key. This blit's pixels are a
        # pure function of (text, color, font_size, w, h) -- the raster carries
        # no position -- so the key is computed ONCE per draw call from those
        # five, never from the pixels: the hash walks the string, not the
        # 4 * w * h words it would cost to digest the raster. Identical labels
        # (a repeated table header, a re-rendered frame) therefore upload once.
        self.hint_image_key(text_blit_image_key(text_val, color, font_size,
            text_buf.width, text_buf.height))
        self.draw_image_blend(x, y, text_buf.width, text_buf.height, text_buf.pixels)

    me _draw_image_composite_native(x: i32, y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32], opacity_milli: i32, composite_mode: i32, require_wholly_bounded: bool) -> i64:
        if not vulkan_timing_enabled():
            return self._draw_image_composite_native_impl(x, y, dst_w, dst_h, src_w, src_h, pixels, opacity_milli, composite_mode, require_wholly_bounded)
        val _t = vulkan_timing_now_us()
        val rc = self._draw_image_composite_native_impl(x, y, dst_w, dst_h, src_w, src_h, pixels, opacity_milli, composite_mode, require_wholly_bounded)
        vulkan_timing_add(VK_T_IMAGE_COMPOSITE, _t)
        # Split this call into the full-surface or the small population with its
        # own wall time, so the 443 s / 102 s split the attribution run inferred
        # from maxima is measured directly rather than reconstructed.
        vulkan_image_size_note(_i64(src_w) * _i64(src_h), _i64(self.w) * _i64(self.h),
            vulkan_timing_now_us() - _t)
        rc

    me _draw_image_composite_native_impl(x: i32, y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32], opacity_milli: i32, composite_mode: i32, require_wholly_bounded: bool) -> i64:
        # Consume the producer key FIRST, before any validation return. A key
        # names THIS call's pixels; leaving it armed on a rejected composite
        # (clipped out, bad geometry, uninitialized) would hand this identity to
        # the next, unrelated image -- which would then be stamped with it and
        # skip a genuine upload on a later frame.
        val image_key = self.pending_image_key
        self.pending_image_key = 0
        if self.completion_unknown or not self.initialized or self.d_framebuffer <= 0 or self.pipe_blit <= 0:
            vulkan_image_reason_note(VK_IMG_R_STATE)
            return 0
        if (dst_w <= 0 or dst_h <= 0 or src_w <= 0 or src_h <= 0 or self.mask_buf.len() > 0 or
            opacity_milli <= 0 or opacity_milli > 1000 or
            (composite_mode != VK_IMAGE_COMPOSITE_COPY and composite_mode != VK_IMAGE_COMPOSITE_SRC_OVER)):
            vulkan_image_reason_note(VK_IMG_R_ARGS)
            return 0

        val pixel_count = _i64(src_w) * _i64(src_h)
        val scale_x_product = (_i64(dst_w) - 1) * _i64(src_w)
        val scale_y_product = (_i64(dst_h) - 1) * _i64(src_h)
        if (pixel_count <= 0 or pixel_count > 4294967295 or pixel_count > 9223372036854775807 / 4 or
            pixels.len().to_i64() != pixel_count or
            scale_x_product > 2147483647 or scale_y_product > 2147483647):
            vulkan_image_reason_note(VK_IMG_R_GEOM)
            return 0
        val right = _i64(x) + _i64(dst_w)
        val bottom = _i64(y) + _i64(dst_h)
        if right - 1 > 2147483647 or bottom - 1 > 2147483647:
            vulkan_image_reason_note(VK_IMG_R_GEOM)
            return 0
        if require_wholly_bounded and (_i64(x) < 0 or _i64(y) < 0 or right > _i64(self.w) or bottom > _i64(self.h)):
            vulkan_image_reason_note(VK_IMG_R_CLIP)
            return 0
        if self.clip_enabled:
            val clip_right = _i64(self.clip_x) + _i64(self.clip_w)
            val clip_bottom = _i64(self.clip_y) + _i64(self.clip_h)
            if self.clip_w <= 0 or self.clip_h <= 0 or clip_right > 2147483647 or clip_bottom > 2147483647:
                vulkan_image_reason_note(VK_IMG_R_CLIP)
                return 0
            if require_wholly_bounded and (_i64(x) < _i64(self.clip_x) or _i64(y) < _i64(self.clip_y) or
                right > clip_right or bottom > clip_bottom):
                vulkan_image_reason_note(VK_IMG_R_CLIP)
                return 0

        val src_size = pixel_count * 4
        # An image small enough that hashing it costs less than uploading it
        # gets a key even with no producer. The bound is what makes this honest:
        # at or below `VK_IMAGE_INLINE_KEY_MAX_PIXELS` words the digest is
        # cheaper than the staging pack plus the SFFI crossing it replaces, and
        # above it the pixels are never touched -- a per-frame digest of a large
        # image would cost more than the upload it saves.
        val effective_key = if image_key != 0:
            image_key
        elif pixel_count <= VK_IMAGE_INLINE_KEY_MAX_PIXELS:
            inline_image_key(pixels, pixel_count, src_w, src_h, opacity_milli, composite_mode)
        else:
            0
        if effective_key != 0 and self.frame_batching_enabled:
            val keyed = self._acquire_keyed_image_source(src_size, effective_key)
            if keyed > 0:
                # The slot already holds these exact pixels from an earlier
                # frame (or an earlier draw in this one). No upload at all --
                # this is the whole point of the key.
                if vulkan_order_trace_enabled():
                    vulkan_order_trace("image-upload-skipped key={effective_key} bytes={src_size} src={keyed}")
                return self._finish_image_composite(keyed, x, y, dst_w, dst_h, src_w, src_h,
                    opacity_milli, composite_mode)
        val _t_alloc = vulkan_timing_now_us()
        var d_src = if self.frame_batching_enabled:
            self._acquire_image_source(src_size)
        else:
            vulkan_sffi_alloc_buffer(src_size, 0x80)
        if (d_src <= 0 and self.frame_batching_enabled and
            self._image_source_pool_is_fully_pending()):
            # A full source pool means all slots are still dependencies of the
            # current command buffer.  Flush once, then retry acquisition so a
            # large image-heavy frame can continue without a CPU fallback.
            val flushed = self._flush_pending_compute_at("_draw_image_composite_native_impl")
            if flushed < 0:
                return -1
            if flushed > 0:
                d_src = self._acquire_image_source(src_size)
        if d_src <= 0:
            vulkan_timing_add(VK_T_IMAGE_ALLOC, _t_alloc)
            vulkan_image_reason_note(VK_IMG_R_SOURCE)
            return 0
        vulkan_timing_add(VK_T_IMAGE_ALLOC, _t_alloc)

        # FASTEST when it runs: `pixels` is already `[u32]`, so the typed lane
        # uploads the caller's own words and performs NO host packing at all --
        # the runtime widens each word to four little-endian bytes, byte for
        # byte what the interpreted loop below produces. That loop is
        # `4 * pixel_count` interpreted array stores (2.7M for one 900x760
        # full-surface composite) and is the measured dominant term of this
        # function. Opt-in via `SIMPLE_VK_IMAGE_UPLOAD=u32`; see
        # `_VULKAN_IMAGE_UPLOAD_U32_REQUESTED` for why it cannot be the default.
        var upload_ok = false
        if vulkan_image_upload_u32_requested():
            upload_ok = vulkan_sffi_copy_to_buffer_u32(d_src, pixels, 0)
            vulkan_image_upload_note("u32",
                if upload_ok: "typed-requested" else: "typed-declined")
        if upload_ok:
            self.image_source_upload_count = self.image_source_upload_count + 1
            self.image_source_upload_bytes = self.image_source_upload_bytes + src_size
            self._record_image_source_key(d_src, effective_key)
            return self._finish_image_composite(d_src, x, y, dst_w, dst_h, src_w, src_h,
                opacity_milli, composite_mode)
        if vulkan_image_upload_u32_requested():
            # The typed lane declined (native array ABI). Fall through to the
            # byte path, which is behaviour-preserving, only slower.
            vulkan_image_upload_note("bytes", "typed-declined")
        else:
            vulkan_image_upload_note("bytes", "typed-not-requested")

        val scratch_reused = self.image_upload_scratch.len().to_i64() == src_size
        val _t_pack = vulkan_timing_now_us()
        val scratch_prepared = self._prepare_image_upload(pixels, pixel_count)
        vulkan_timing_add(VK_T_IMAGE_PACK, _t_pack)
        upload_ok = scratch_prepared
        if scratch_prepared:
            # Timed separately from the composite total: it hands the staging
            # array across the SFFI boundary. Since `_prepare_image_upload`
            # sizes that array to EXACTLY `src_size`, the prefix is the whole
            # array and the interpreter-ABI admission test
            # (`byte_count == data.len()`) holds, so the exact-size byte
            # fallback below is dead for every admitted size instead of firing
            # on 262 of 264 composites.
            val _t_up = vulkan_timing_now_us()
            upload_ok = vulkan_sffi_copy_to_buffer_prefix(
                d_src, self.image_upload_scratch, src_size, 0)
            vulkan_timing_add(VK_T_UPLOAD, _t_up)
            if upload_ok and scratch_reused:
                # Count only successful prefix uploads that avoided allocating
                # the legacy exact-size payload, not merely packing attempts.
                self.image_upload_scratch_reuse_count = self.image_upload_scratch_reuse_count + 1
            elif not upload_ok:
                # The prefix facade is unavailable on this ABI lane; the
                # exact-size fallback below remains behavior-preserving.
                self.image_upload_scratch_fallback_count = self.image_upload_scratch_fallback_count + 1
        if not upload_ok:
            # Preserve the exact-size legacy path for oversized images and
            # interpreter array ABIs that cannot upload a prefix.
            val _t_bf = vulkan_timing_now_us()
            vulkan_image_pack_note_byte_fallback()
            val source_bytes = _pixels_to_bytes(pixels, pixel_count)
            upload_ok = source_bytes.len().to_i64() == src_size and
                vulkan_sffi_copy_to_buffer(d_src, source_bytes, 0)
            vulkan_timing_add(VK_T_IMAGE_BYTE_FALLBACK, _t_bf)
        if not upload_ok:
            self._release_image_source(d_src)
            vulkan_image_reason_note(VK_IMG_R_UPLOAD)
            return 0
        self.image_source_upload_count = self.image_source_upload_count + 1
        self.image_source_upload_bytes = self.image_source_upload_bytes + src_size
        self._record_image_source_key(d_src, effective_key)
        self._finish_image_composite(d_src, x, y, dst_w, dst_h, src_w, src_h,
            opacity_milli, composite_mode)

    me _finish_image_composite(d_src: i64, x: i32, y: i32, dst_w: i32, dst_h: i32,
                               src_w: i32, src_h: i32, opacity_milli: i32,
                               composite_mode: i32) -> i64:
        """Descriptor + dispatch + damage, once a source buffer holds the image.

        Split out so the typed `[u32]` upload and the packed byte upload share
        one dispatch path instead of duplicating it -- the two lanes must be
        byte-identical downstream or the opt-in flag would change pixels.
        """
        val _t_disp = vulkan_timing_now_us()
        val pc = _pack_image_composite_pc(x, y, dst_w, dst_h, self.w, self.h,
            self.clip_x, self.clip_y, self.clip_w, self.clip_h, self.clip_enabled,
            opacity_milli, composite_mode, src_w, src_h)
        val gx = (_i64(dst_w) + 15) / 16
        val gy = (_i64(dst_h) + 15) / 16
        val dispatched = if self.frame_batching_enabled:
            self._enqueue_image_composite(self.pipe_blit, d_src, pc, gx, gy, 1)
        else:
            vulkan_dispatch_image_composite_checked(self.d_framebuffer, self.pipe_blit, d_src, pc, gx, gy, 1)
        if vulkan_order_trace_enabled():
            vulkan_order_trace("image-composite x={x} y={y} w={dst_w} h={dst_h} mode={composite_mode} rc={dispatched} fb={self.d_framebuffer}")
        if dispatched > 0:
            self.dirty = true
            self.host_mirror_frame_fresh = false
            # Image composite also bypasses the dispatch funnel, but its
            # destination rect IS known exactly, so fold it rather than widen.
            self.hint_damage(_i64(x), _i64(y), _i64(dst_w), _i64(dst_h))
            self.consume_damage_hint()
            self.mark_device_content_changed()
            if dispatched == VK_DISPATCH_COMPLETED_INELIGIBLE:
                self.mark_cpu_fallback("image-composite-cleanup-ineligible")
            vulkan_image_reason_note(VK_IMG_R_OK)
        else:
            vulkan_image_reason_note(VK_IMG_R_DISPATCH)
        vulkan_timing_add(VK_T_IMAGE_DISPATCH, _t_disp)
        dispatched

    me _draw_image_native(x: i32, y: i32, w: i32, h: i32, pixels: [u32]) -> i64:
        """Copy an exact-size image, clipped by the Vulkan target bounds."""
        self._draw_image_composite_native(x, y, w, h, w, h, pixels, 1000, VK_IMAGE_COMPOSITE_COPY, false)

    me _draw_image_scaled_native(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]) -> i64:
        """Nearest-neighbor scale and copy an image on the Vulkan device."""
        self._draw_image_composite_native(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels, 1000, VK_IMAGE_COMPOSITE_COPY, false)

    me _draw_image_scaled_blend_native(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]) -> i64:
        """Nearest-neighbor scale and src-over an image on the Vulkan device."""
        self._draw_image_composite_native(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels, 1000, VK_IMAGE_COMPOSITE_SRC_OVER, false)

    me _draw_image_blend_native(x: i32, y: i32, w: i32, h: i32, pixels: [u32], opacity_milli: i32) -> i64:
        """Composite a clipped straight-ARGB image on the Vulkan device."""
        self._draw_image_composite_native(x, y, w, h, w, h, pixels, opacity_milli, VK_IMAGE_COMPOSITE_SRC_OVER, false)

    me draw_image_blend_checked(x: i32, y: i32, w: i32, h: i32, pixels: [u32], opacity_milli: i32) -> bool:
        """Composite only when fenced native Vulkan completion is proven."""
        if self.completion_unknown:
            return false
        val status = self._draw_image_blend_native(x, y, w, h, pixels, opacity_milli)
        if status == 1:
            return true
        self.mark_cpu_fallback("checked-image-blend-failed")
        if status < 0:
            self.completion_unknown = true
        false

    me draw_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        if self.completion_unknown: return
        _vk_stat_image_op(w, h, false)
        val native_status = self._draw_image_native(x, y, w, h, pixels)
        if native_status > 0:
            return
        if native_status < 0:
            self.mark_cpu_fallback("image-copy-completion-unknown")
            self.completion_unknown = true
            return
        val pending_status = self._flush_pending_compute_at("draw_image")
        if pending_status <= 0:
            if pending_status < 0:
                self.completion_unknown = true
            return
        if self.dirty:
            val fb_size = _i64(self.w) * _i64(self.h) * 4
            val fb_bytes = vulkan_sffi_read_buffer_bytes(self.d_framebuffer, fb_size, 0)
            val refreshed = _bytes_to_pixel_array(fb_bytes, self.w * self.h)
            if refreshed.len() != self.w * self.h:
                self._mark_readback_length_failed()
                return
            self.host_buf = refreshed
            self.host_mirror_valid = true

        self.mark_cpu_fallback("image-copy-host-fallback")
        val clip_end_x = self.clip_x + self.clip_w
        val clip_end_y = self.clip_y + self.clip_h
        val mask_active = self.mask_buf.len() > 0
        var py = 0
        while py < h:
            var px = 0
            while px < w:
                val dx = x + px
                val dy = y + py
                val src_idx = py * w + px
                var writable = dx >= 0 and dx < self.w and dy >= 0 and dy < self.h and src_idx < pixels.len()
                if writable and self.clip_enabled:
                    writable = dx >= self.clip_x and dx < clip_end_x and dy >= self.clip_y and dy < clip_end_y
                if writable and mask_active:
                    val mask_idx = dy * self.mask_w + dx
                    if mask_idx >= 0 and mask_idx < self.mask_buf.len():
                        writable = self.mask_buf[mask_idx] != 0u8
                if writable:
                    self.host_buf[dy * self.w + dx] = pixels[src_idx]
                px = px + 1
            py = py + 1
        val upload_bytes = _pixels_to_bytes(self.host_buf, _i64(self.w) * _i64(self.h))
        vulkan_sffi_copy_to_buffer(self.d_framebuffer, upload_bytes, 0)
        self.dirty = false
        self.host_mirror_valid = true

    me set_clip(x: i32, y: i32, w: i32, h: i32):
        self.clip_x = x
        self.clip_y = y
        self.clip_w = w
        self.clip_h = h
        self.clip_enabled = true

    me clear_clip():
        self.clip_enabled = false
        self.clip_x = 0
        self.clip_y = 0
        self.clip_w = self.w
        self.clip_h = self.h

    me set_mask(mask_pixels: [u8], w: i32, h: i32):
        self.mask_buf = mask_pixels
        self.mask_w = w
        self.mask_h = h

    me clear_mask():
        self.mask_buf = []
        self.mask_w = 0
        self.mask_h = 0

    me submit_batch() -> bool:
        """Submit every buffered draw dispatch from this frame in ONE fenced
        command-buffer submission instead of one submission per primitive.

        Safe to call whether or not frame batching is enabled: with no
        pending command (immediate-mode dispatch, or nothing drawn yet)
        `_flush_pending_compute()` is a no-op that returns 1.
        """
        if self.completion_unknown:
            return false
        val pending_status = self._flush_pending_compute_at("submit_batch")
        if pending_status < 0:
            self.completion_unknown = true
            return false
        pending_status != 0

    me _begin_frame_receipt(mode: text, readback_requested: bool,
                            present_attempted: bool):
        self.frame_index += 1
        self.frame_dirty_rect_count = if self.present_damage_valid:
            self.present_damage_rects.len().to_i64() / 4
        else:
            0
        self.frame_device_to_present_bytes = 0
        self.frame_device_to_present_rect_count = 0
        self.frame_readback_requested = readback_requested
        self.frame_readback_completed = false
        self.frame_present_attempted = present_attempted
        self.frame_present_completed = false
        self.frame_present_mode = mode
        self.frame_host_cache_refresh_completed = false
        self.frame_full_fallback = false
        self.frame_fallback_reason = ""
        self.frame_device_present = false

    fn latest_frame_receipt() -> VulkanFrameReceipt:
        """Snapshot the latest finalized frame without implying swapchain work.

        `device_present` and `present_completed` remain false until a native
        surface/swapchain owner completes a real presentation call. A retained
        compute frame and a refreshed host cache are reported as distinct modes.
        """
        VulkanFrameReceipt(
            frame_index: self.frame_index,
            framebuffer_width: self.w,
            framebuffer_height: self.h,
            dirty_rect_count: self.frame_dirty_rect_count,
            device_to_present_bytes: self.frame_device_to_present_bytes,
            device_to_present_rect_count: self.frame_device_to_present_rect_count,
            readback_requested: self.frame_readback_requested,
            readback_completed: self.frame_readback_completed,
            readback_bytes: self.present_readback_bytes,
            present_attempted: self.frame_present_attempted,
            present_completed: self.frame_present_completed,
            present_mode: self.frame_present_mode,
            device_present: self.frame_device_present,
            host_cache_refresh_completed: self.frame_host_cache_refresh_completed,
            no_readback: not self.frame_readback_requested and self.present_readback_bytes == 0,
            full_frame_fallback: self.frame_full_fallback,
            fallback_reason: self.frame_fallback_reason,
            cpu_fallback_used: self.cpu_fallback_used,
            completion_known: not self.completion_unknown,
            backend_handle: self.d_framebuffer,
            device_identity: self.session.device,
            swapchain_identity: self.presentation_swapchain,
            device_submit_count: self.observed_device_submit_count,
            device_fence_count: self.observed_device_fence_count)

    fn window_present_enabled() -> bool:
        self.presentation_mode == "window-swapchain" and
        self.presentation_swapchain > 0

    me _present_device(mode: text) -> bool:
        self._begin_frame_receipt(mode, false, true)
        self.present_readback_bytes = 0
        self.present_readback_rect_count = 0
        if self.presentation_swapchain <= 0 or self.d_framebuffer <= 0:
            self.frame_fallback_reason = mode + "-unavailable"
            return false
        if self.completion_unknown:
            self.frame_fallback_reason = "completion-unknown"
            return false
        val pending_status = self._flush_pending_compute_at("_present_device")
        if pending_status <= 0:
            if pending_status < 0:
                self.completion_unknown = true
            self.frame_fallback_reason = "compute-finalize-failed"
            return false
        val requested_regions = (
            self.present_damage_valid and self.present_damage_rects.len() > 0)
        val presented = if requested_regions:
            vulkan_sffi_present_buffer_regions(
                self.presentation_swapchain, self.d_framebuffer,
                self.w.to_i64(), self.h.to_i64(),
                self.device_content_revision, self.present_damage_rects)
        else:
            vulkan_sffi_present_buffer(
                self.presentation_swapchain, self.d_framebuffer,
                self.w.to_i64(), self.h.to_i64(), self.device_content_revision)
        if presented <= 0:
            self.frame_fallback_reason = mode + "-present-failed"
            return false
        self.frame_present_completed = true
        self.frame_device_present = true
        self.frame_device_to_present_bytes = vulkan_sffi_last_present_copy_bytes(
            self.presentation_swapchain)
        self.frame_device_to_present_rect_count = vulkan_sffi_last_present_copy_rects(
            self.presentation_swapchain)
        self.host_mirror_valid = false
        self._clear_present_damage()
        if requested_regions and presented <= 2:
            self.frame_full_fallback = true
            self.frame_fallback_reason = "swapchain-image-history-seed"
        if presented == 2 or presented == 4:
            self.frame_fallback_reason = "swapchain-suboptimal"
        true

    me present_headless_device() -> bool:
        """Complete a same-device headless swapchain presentation."""
        if self.presentation_mode != "headless-swapchain":
            return self._present_device("headless-swapchain")
        self._present_device(self.presentation_mode)

    me present_window_device() -> bool:
        """Complete a same-device visible-window swapchain presentation."""
        if self.presentation_mode != "window-swapchain":
            return self._present_device("window-swapchain")
        self._present_device(self.presentation_mode)

    me finalize_compute_frame_no_readback() -> bool:
        """Finish a storage-buffer frame without copying it to the host.

        This is deliberately not called presentation: VulkanBackend currently
        owns no swapchain/surface. A skipped cache refresh invalidates the host
        mirror so any later present/readback must reseed it from the complete
        device framebuffer instead of patching a stale retained frame.
        """
        self._begin_frame_receipt("device-retained", false, false)
        self.present_readback_bytes = 0
        self.present_readback_rect_count = 0
        if self.completion_unknown:
            self.frame_fallback_reason = "completion-unknown"
            return false
        val pending_status = self._flush_pending_compute_at("finalize_compute_frame_no_readback")
        if pending_status <= 0:
            if pending_status < 0:
                self.completion_unknown = true
            self.frame_fallback_reason = "compute-finalize-failed"
            return false
        if self.dirty:
            self.host_mirror_valid = false
        self._clear_present_damage()
        self.device_finalize_no_readback_count += 1
        self.frame_present_completed = false
        true

    me stage_present_damage(rects: [i64]) -> bool:
        """Copy an exact, non-overlapping damage plan for the next present.

        The backend rejects malformed or overlapping plans instead of widening
        them. An absent/invalid plan conservatively selects full readback.
        """
        self.present_damage_rects = []
        self.present_damage_valid = false
        if rects.len() % 4 != 0 or rects.len() > 4096:
            return false
        var i = 0
        while i < rects.len():
            val x = rects[i]
            val y = rects[i + 1]
            val rw = rects[i + 2]
            val rh = rects[i + 3]
            if x < 0 or y < 0 or rw <= 0 or rh <= 0:
                return false
            if x > _i64(self.w) or y > _i64(self.h):
                return false
            if rw > _i64(self.w) - x or rh > _i64(self.h) - y:
                return false
            var j = 0
            while j < i:
                val ox = rects[j]
                val oy = rects[j + 1]
                val ow = rects[j + 2]
                val oh = rects[j + 3]
                if x < ox + ow and ox < x + rw and y < oy + oh and oy < y + rh:
                    return false
                j += 4
            i += 4
        i = 0
        while i < rects.len():
            self.present_damage_rects.push(rects[i])
            i += 1
        self.present_damage_valid = true
        true

    me _clear_present_damage():
        self.present_damage_rects = []
        self.present_damage_valid = false
        # Every caller of this is a frame boundary (present / device present /
        # finalize), so the accumulated draw-call union retires with it.
        self._clear_frame_damage()

    me hint_image_key(key: i64):
        """Name the identity+generation of the NEXT image composite's pixels.

        Producer-supplied, computed ONCE where the image is produced or decoded
        -- never a per-frame digest of `pixels`, which would cost more than the
        upload it saves. A non-zero key promises: same key => byte-identical
        pixels. Zero (the default) means "unknown", and every unkeyed image
        uploads exactly as before. Consumed once, by
        `_draw_image_composite_native_impl`; see `hint_damage` for the same
        arm-then-consume shape.
        """
        self.pending_image_key = key

    me hint_damage(x: i64, y: i64, w: i64, h: i64):
        """Publish the destination rect of the draw call about to dispatch.

        The dispatch funnel consumes this; an absent hint is read as "this
        primitive's footprint is unknown" and marks the whole surface damaged.
        Fail-safe by construction: forgetting a hint costs speed, never
        correctness."""
        self.pending_damage_hint = true
        self.pending_damage_hx = x
        self.pending_damage_hy = y
        self.pending_damage_hw = w
        self.pending_damage_hh = h

    me note_damage_full():
        self.pending_damage_hint = false
        self.frame_damage_valid = true
        self.frame_damage_full = true

    me consume_damage_hint():
        """Fold the pending hint into the frame union, or widen to full."""
        if not self.pending_damage_hint:
            self.note_damage_full()
            return
        val hx = self.pending_damage_hx
        val hy = self.pending_damage_hy
        val hw = self.pending_damage_hw
        val hh = self.pending_damage_hh
        self.pending_damage_hint = false
        if hw <= 0 or hh <= 0:
            # A degenerate footprint paints nothing; leave the union untouched
            # rather than widening it to the whole surface.
            return
        # Clip to the surface. A rect entirely outside it damages nothing.
        var x0 = if hx < 0: 0 else: hx
        var y0 = if hy < 0: 0 else: hy
        var x1 = hx + hw
        var y1 = hy + hh
        if x1 > _i64(self.w): x1 = _i64(self.w)
        if y1 > _i64(self.h): y1 = _i64(self.h)
        if x1 <= x0 or y1 <= y0:
            return
        # An active clip can only SHRINK the painted area, so ignoring it keeps
        # the union conservative (a superset), which is the safe direction.
        if not self.frame_damage_valid or self.frame_damage_full:
            if self.frame_damage_full:
                return
            self.frame_damage_valid = true
            self.frame_damage_x0 = x0
            self.frame_damage_y0 = y0
            self.frame_damage_x1 = x1
            self.frame_damage_y1 = y1
            return
        if x0 < self.frame_damage_x0: self.frame_damage_x0 = x0
        if y0 < self.frame_damage_y0: self.frame_damage_y0 = y0
        if x1 > self.frame_damage_x1: self.frame_damage_x1 = x1
        if y1 > self.frame_damage_y1: self.frame_damage_y1 = y1

    me _clear_frame_damage():
        self.frame_damage_valid = false
        self.frame_damage_full = false
        self.frame_damage_x0 = 0
        self.frame_damage_y0 = 0
        self.frame_damage_x1 = 0
        self.frame_damage_y1 = 0
        self.pending_damage_hint = false

    fn frame_damage_rect_px() -> i64:
        """Pixels in this frame's damage union (evidence counter)."""
        self.damage_rect_px

    fn frame_mirror_copy_iterations() -> i64:
        """Interpreted element writes spent patching the host mirror."""
        self.mirror_copy_iterations

    me _refresh_host_frame_damage() -> bool:
        """Re-download ONLY this frame's damage union into the host mirror.

        Returns false whenever the damage-scoped route is not applicable or
        not profitable, so every caller keeps the full refresh as its fallback.

        The row download uses the interpreter-legal scalars-in / array-out
        primitive F8 added (`vulkan_sffi_readback_u32_alloc`), one native call
        per damaged row: that is the only shape this lane marshals, and it is
        what keeps the byte->u32 unpack out of interpreted code. The scatter
        into `host_buf` is still an interpreted element write per damaged
        pixel -- there is NO extern on this lane that takes a destination array
        -- but it is bounded by the damage area instead of the surface, which
        is the whole point. `mirror_copy_iterations` reports it honestly."""
        if not self.host_mirror_valid or not self.frame_damage_valid:
            return false
        if self.frame_damage_full:
            return false
        val px_total = _i64(self.w) * _i64(self.h)
        if self.host_buf.len().to_i64() != px_total:
            return false
        val x0 = self.frame_damage_x0
        val y0 = self.frame_damage_y0
        val rw = self.frame_damage_x1 - x0
        val rh = self.frame_damage_y1 - y0
        if rw <= 0 or rh <= 0:
            return false
        if rh > 16384:
            return false
        val area = rw * rh
        # Below half the surface the per-row call overhead is repaid many times
        # over; at or above it the single contiguous full download is cheaper.
        if area * 2 >= px_total:
            return false
        var row: i64 = 0
        var iterations: i64 = 0
        while row < rh:
            val src_px = (y0 + row) * _i64(self.w) + x0
            val band = vulkan_sffi_readback_u32_alloc(
                self.d_framebuffer, rw.to_i32(), src_px * 4)
            if band.len().to_i64() != rw:
                return false
            var col: i64 = 0
            while col < rw:
                self.host_buf[src_px + col] = band[col]
                col = col + 1
            iterations = iterations + rw
            row = row + 1
        # The mirror identity must still describe the WHOLE surface. This is one
        # native fold over device memory (no interpreted loop and no second
        # unpack), so it stays honest without reintroducing the cost this path
        # exists to remove. A lane without the native arm returns -1 and the
        # caller falls back to the full refresh.
        val checksum = vulkan_sffi_readback_u32_alloc_checksum(
            self.d_framebuffer, self.w * self.h, 0)
        if checksum < 0:
            return false
        self.last_host_checksum = checksum
        self.damage_rect_px = area
        self.mirror_copy_iterations = iterations
        self.present_readback_bytes = area * 4
        self.present_readback_rect_count = 1
        true

    me _refresh_host_full() -> bool:
        val fb_size = _i64(self.w) * _i64(self.h) * 4
        # One native call filling host_buf IN PLACE: download → [u32] tag-write
        # → identity checksum. The destination is passed in rather than
        # returned in a tuple, because a tuple return deep-copies the array
        # (~12.1ms per 800x600 frame under JIT — larger than the download and
        # native fill combined). Reusing host_buf also drops the per-frame
        # 480,000-element allocation. See
        # doc/02_requirements/nfr/engine2d_vulkan_2d_perf.md.
        val px_count = self.w * self.h
        # Bulk native unpack when the interpreter lane offers it; the
        # caller-owned-destination facade stays the fallback on every other
        # lane and on any failure of this one.
        val bulk = vulkan_sffi_readback_u32_alloc(self.d_framebuffer, px_count, 0)
        var checksum: i64 = -1
        if bulk.len() == px_count:
            self.host_buf = bulk
            checksum = vulkan_sffi_readback_u32_alloc_checksum(
                self.d_framebuffer, px_count, 0)
        else:
            if self.host_buf.len() != px_count:
                self.host_buf = [0u32; px_count]
            checksum = vulkan_sffi_readback_u32_into(
                self.host_buf, self.d_framebuffer, px_count, 0)
        if checksum < 0:
            self._mark_readback_length_failed()
            return false
        self.last_host_checksum = checksum
        self.host_mirror_valid = true
        self.present_readback_bytes = fb_size
        self.present_readback_rect_count = 1
        self.present_full_readback_count += 1
        self.host_mirror_frame_fresh = true
        # The whole surface now matches the device, so nothing is outstanding.
        self.damage_rect_px = _i64(self.w) * _i64(self.h)
        self.mirror_copy_iterations = 0
        self._clear_frame_damage()
        true

    me _refresh_host_damage() -> bool:
        if not self.host_mirror_valid or not self.present_damage_valid:
            return false
        if self.present_damage_rects.len() == 0:
            return false
        if self.present_damage_rects.len() > 4096:
            self.frame_full_fallback = true
            self.frame_fallback_reason = "damage-transfer-region-cap"
            return self._refresh_host_full()
        var regions: [i64] = []
        var expected_pixels: i64 = 0
        var total_rows: i64 = 0
        var i = 0
        while i < self.present_damage_rects.len():
            val x = self.present_damage_rects[i]
            val y = self.present_damage_rects[i + 1]
            val rw = self.present_damage_rects[i + 2]
            val rh = self.present_damage_rects[i + 3]
            val pixel_count = rw * rh
            if rh > 16384 - total_rows:
                self.frame_full_fallback = true
                self.frame_fallback_reason = "damage-transfer-row-cap"
                return self._refresh_host_full()
            val src_offset = (y * _i64(self.w) + x) * 4
            regions.push(src_offset)
            regions.push(rw * 4)
            regions.push(rh)
            regions.push(_i64(self.w) * 4)
            expected_pixels += pixel_count
            total_rows += rh
            i += 4
        # Prefer the native per-row download used by `_refresh_host_frame_damage`:
        # one call per damaged row, so the byte->u32 unpack never runs
        # interpreted. `_bytes_to_pixel_array` below is that same unpack done
        # one pixel at a time and is kept only as the fallback for lanes that
        # do not offer the native arm.
        var packed_pixels: [u32] = []
        var native_rows = true
        i = 0
        while i < self.present_damage_rects.len():
            val nx = self.present_damage_rects[i]
            val ny = self.present_damage_rects[i + 1]
            val nw = self.present_damage_rects[i + 2]
            val nh = self.present_damage_rects[i + 3]
            var nrow: i64 = 0
            while nrow < nh and native_rows:
                val src_px = (ny + nrow) * _i64(self.w) + nx
                val band = vulkan_sffi_readback_u32_alloc(
                    self.d_framebuffer, nw.to_i32(), src_px * 4)
                if band.len().to_i64() != nw:
                    native_rows = false
                else:
                    var bcol: i64 = 0
                    while bcol < nw:
                        packed_pixels.push(band[bcol])
                        bcol = bcol + 1
                nrow = nrow + 1
            i += 4
        if not native_rows or packed_pixels.len().to_i64() != expected_pixels:
            val packed = vulkan_sffi_read_buffer_regions_bytes(
                self.d_framebuffer, regions)
            packed_pixels = _bytes_to_pixel_array(
                packed, expected_pixels.to_i32())
        if packed_pixels.len().to_i64() != expected_pixels:
            self.last_error = "Vulkan damaged framebuffer readback byte count mismatch"
            return false

        var source_index: i64 = 0
        var patched: i64 = 0
        i = 0
        while i < self.present_damage_rects.len():
            val x = self.present_damage_rects[i].to_i32()
            val y = self.present_damage_rects[i + 1].to_i32()
            val rw = self.present_damage_rects[i + 2].to_i32()
            val rh = self.present_damage_rects[i + 3].to_i32()
            var row = 0
            while row < rh:
                var col = 0
                while col < rw:
                    self.host_buf[(y + row) * self.w + x + col] = packed_pixels[source_index]
                    source_index += 1
                    col += 1
                row += 1
            patched = patched + _i64(rw) * _i64(rh)
            i += 4
        self.damage_rect_px = expected_pixels
        self.mirror_copy_iterations = patched
        self.present_readback_bytes = expected_pixels * 4
        self.present_readback_rect_count = self.present_damage_rects.len().to_i64() / 4
        true

    me present():
        val trace_present = (env_get("SIMPLE_VK_PRESENT_TRACE") ?? "") == "1"
        var pt0: i64 = 0
        if trace_present:
            pt0 = time_now_unix_micros()
        self._begin_frame_receipt("host-cache", true, false)
        self.present_readback_bytes = 0
        self.present_readback_rect_count = 0
        if self.completion_unknown:
            self.frame_fallback_reason = "completion-unknown"
            return
        val pending_status = self._flush_pending_compute_at("present")
        if trace_present:
            vulkan_order_trace("present flush_us={time_now_unix_micros() - pt0}")
        if pending_status <= 0:
            if pending_status < 0:
                self.completion_unknown = true
            self.frame_fallback_reason = "compute-finalize-failed"
            return
        if not self.dirty:
            self.present_noop_count += 1
            self.frame_present_mode = "none"
            self.frame_readback_requested = false
            self._clear_present_damage()
            return
        var pt1: i64 = 0
        if trace_present:
            pt1 = time_now_unix_micros()
        if self.host_mirror_frame_fresh and self.host_mirror_valid:
            # A readback already downloaded this frame's surface into host_buf
            # (draw_ir_adv reads pixels BEFORE present, so strict device
            # provenance stays satisfiable). The receipt fields below stay
            # truthful -- the mirror IS refreshed from the device for this
            # frame -- it is simply not downloaded twice.
            # Report what the readback ACTUALLY transferred. A damage-scoped
            # readback moved only its rect, and overwriting that with the full
            # surface size would make the receipt describe a download that did
            # not happen.
            if self.readback_frame_bytes > 0:
                self.present_readback_bytes = self.readback_frame_bytes
                self.present_readback_rect_count = self.readback_frame_rects
            else:
                self.present_readback_bytes = _i64(self.w) * _i64(self.h) * 4
                self.present_readback_rect_count = 1
            self.frame_present_mode = "host-cache-from-readback"
            self.dirty = false
            self.frame_readback_completed = true
            self.frame_host_cache_refresh_completed = true
            self.host_mirror_frame_fresh = false
            self.readback_frame_bytes = 0
            self.readback_frame_rects = 0
            self._clear_present_damage()
            return
        if self.present_damage_valid and self.host_mirror_valid:
            if not self._refresh_host_damage():
                self.frame_fallback_reason = "damaged-host-cache-refresh-failed"
                return
        else:
            self.frame_full_fallback = true
            self.frame_fallback_reason = if self.host_mirror_valid:
                "damage-plan-unavailable"
            else:
                "host-mirror-seed"
            if not self._refresh_host_full():
                self.frame_fallback_reason = "full-host-cache-refresh-failed"
                return
        if trace_present:
            vulkan_order_trace("present refresh_us={time_now_unix_micros() - pt1}")
        self.dirty = false
        self.frame_readback_completed = true
        self.frame_host_cache_refresh_completed = true
        self._clear_present_damage()

    me read_pixels() -> [u32]:
        if not vulkan_timing_enabled():
            return self.read_pixels_with_source().pixels
        val _t = vulkan_timing_now_us()
        val out = self.read_pixels_with_source().pixels
        vulkan_timing_add(VK_T_READBACK, _t)
        out

    fn sample_host_mirror(indices: [i64]) -> [u32]:
        """Copy bounded evidence samples while the physical owner is known.

        Keeping field lookup and indexed reads inside Engine2D's concrete
        VulkanBackend prevents an external JIT evidence harness from
        materializing the retained array through an unrelated public alias.
        Any invalid index fails closed without returning partial evidence.
        """
        var samples: [u32] = []
        for index in indices:
            if index < 0 or index >= self.host_buf.len():
                return []
            samples.push(self.host_buf[index])
        samples

    me read_pixels_with_source() -> Engine2DReadback:
        vulkan_stat_note_readback(_i64(self.w) * _i64(self.h))
        if vulkan_order_trace_enabled():
            vulkan_order_trace("readback-entry dirty={self.dirty} pending_cmd={self.pending_compute_command} pending_n={self.pending_compute_count} cpu_fallback={self.cpu_fallback_used} completion_unknown={self.completion_unknown} fb={self.d_framebuffer}")
        if self.completion_unknown:
            return engine2d_readback([], "completion_unknown")
        # With frame batching enabled (enable_frame_batching(), used by the
        # "vulkan"/"metal-on-vulkan"/"directx-on-vulkan" Engine2D lanes),
        # draw calls only enqueue compute dispatches into a not-yet-submitted
        # command buffer; only present()/submit_batch() used to force that
        # submission. A caller reading pixels directly (never calling
        # present()) previously read the device framebuffer before the
        # batched draws were ever submitted, so the readback silently
        # reflected an earlier (or empty) frame. Flush here too, exactly as
        # present() does, so read_pixels()/read_pixels_with_source() are
        # correct regardless of whether present() was ever called.
        val pending_status = self._flush_pending_compute_at("read_pixels_with_source")
        if pending_status < 0:
            self.completion_unknown = true
            return engine2d_readback([], "completion_unknown")
        if pending_status == VK_DISPATCH_COMPLETED_INELIGIBLE:
            self.mark_cpu_fallback("readback-batch-cleanup-ineligible")
        # fn contract forbids self mutation: dirty reads fetch straight from the
        # device; present() owns the host_buf cache refresh.
        if self.dirty:
            self.damage_rect_px = 0
            self.mirror_copy_iterations = 0
            # Damage-scoped route FIRST: when a valid mirror from the previous
            # frame survives and this frame's draw calls named a sub-rect, only
            # that rect is re-downloaded. The mirror and the returned pixels
            # share one array here exactly as the full arm below does (F8's
            # readback/present/readback spec pins that consumers treat a
            # readback as read-only), so no full-surface copy is needed.
            if self._refresh_host_frame_damage():
                # Deliberately does NOT clear `dirty` or the frame union, so
                # present() reaches the same `host_mirror_frame_fresh` dedup arm
                # the full route reaches and the frame receipt stays identical
                # for both routes. Clearing `dirty` here sent present() down its
                # `not dirty` noop arm, whose receipt reports no readback at all.
                self.host_mirror_frame_fresh = true
                self.readback_frame_bytes = self.damage_rect_px * 4
                self.readback_frame_rects = 1
                if self.cpu_fallback_used:
                    return engine2d_readback(self.host_buf, "cpu_fallback")
                return Engine2DReadback(
                    pixels: self.host_buf, source: "device_readback",
                    backend_handle: self.d_framebuffer,
                    device_identity: self.session.device,
                    pixel_count: self.host_buf.len().to_i64(),
                    checksum: self.last_host_checksum)
            # Fill a local buffer in place; see _refresh_host_full for why the
            # destination is passed in rather than returned in a tuple.
            val bulk_px = vulkan_sffi_readback_u32_alloc(
                self.d_framebuffer, self.w * self.h, 0)
            var pixels: [u32] = []
            var checksum: i64 = -1
            if bulk_px.len() == self.w * self.h:
                pixels = bulk_px
                checksum = vulkan_sffi_readback_u32_alloc_checksum(
                    self.d_framebuffer, self.w * self.h, 0)
            else:
                pixels = [0u32; self.w * self.h]
                checksum = vulkan_sffi_readback_u32_into(
                    pixels, self.d_framebuffer, self.w * self.h, 0)
            if checksum < 0:
                return engine2d_readback([], "readback_failed")
            # Seed the host mirror from the download that just happened. Before
            # this, an offscreen frame that read pixels and then presented paid
            # for the SAME surface twice -- 48% of a 900x760 web frame -- to
            # refresh a mirror no offscreen caller reads. The mirror and this
            # readback share one array: every mirror writer rebinds or writes
            # through `self.host_buf`, and a readback's pixels are read-only to
            # its consumers (pinned by the readback/present/readback spec).
            if pixels.len() == self.w * self.h:
                self.host_buf = pixels
                self.host_mirror_valid = true
                self.last_host_checksum = checksum
                self.host_mirror_frame_fresh = true
                # A full download re-establishes the whole surface.
                self.damage_rect_px = _i64(self.w) * _i64(self.h)
                self.readback_frame_bytes = self.damage_rect_px * 4
                self.readback_frame_rects = 1
                self._clear_frame_damage()
            if self.cpu_fallback_used:
                return engine2d_readback(pixels, "cpu_fallback")
            return Engine2DReadback(
                pixels: pixels, source: "device_readback",
                backend_handle: self.d_framebuffer,
                device_identity: self.session.device,
                pixel_count: pixels.len().to_i64(), checksum: checksum)
        # A clean frame downloads nothing and patches nothing.
        self.damage_rect_px = 0
        self.mirror_copy_iterations = 0
        var copy: [u32] = [0u32; self.w * self.h]
        # One native slot memcpy instead of an interpreted per-pixel loop. The
        # loop was ~482 ms per 7680x4320 frame — more than half the frame, and
        # ~100x the GPU transfer it accompanies. The facade falls back to the
        # element loop itself when the native ABI is unavailable, so this stays
        # correct on every lane; a failure here is a hard failure, never a
        # partially-written destination.
        if not vulkan_sffi_copy_u32_into(copy, self.host_buf, self.w * self.h):
            return engine2d_readback([], "readback_failed")
        if self.cpu_fallback_used:
            engine2d_readback(copy, "cpu_fallback")
        else:
            # The cache was refreshed by a completed device-to-host copy. This
            # is not swapchain/device presentation; preserve that distinction.
            # The checksum was computed during that refresh — reuse it instead
            # of re-running the O(n) modulo loop over the copy.
            Engine2DReadback(
                pixels: copy, source: "host_cache_after_device_copy",
                backend_handle: self.d_framebuffer,
                device_identity: self.session.device,
                pixel_count: copy.len().to_i64(),
                checksum: self.last_host_checksum)

    me width() -> i32:
        self.w

    me height() -> i32:
        self.h

    me draw_ellipse(cx: i32, cy: i32, rx: i32, ry: i32, color: u32):
        if self.completion_unknown: return
        emu_draw_ellipse(self, cx, cy, rx, ry, color)

    me draw_ellipse_filled(cx: i32, cy: i32, rx: i32, ry: i32, color: u32):
        if self.completion_unknown: return
        emu_draw_ellipse_filled(self, cx, cy, rx, ry, color)

    me draw_arc(cx: i32, cy: i32, r: i32, start_deg: i32, end_deg: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_arc(self, cx, cy, r, start_deg, end_deg, color, thickness)

    me draw_bezier(x1: i32, y1: i32, cx1: i32, cy1: i32, cx2: i32, cy2: i32, x2: i32, y2: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_bezier(self, x1, y1, cx1, cy1, cx2, cy2, x2, y2, color, thickness)

    me draw_polygon_filled(xs: [i32], ys: [i32], count: i32, color: u32):
        if self.completion_unknown: return
        emu_draw_polygon_filled(self, xs, ys, count, color)

    me draw_polyline(xs: [i32], ys: [i32], count: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_polyline(self, xs, ys, count, color, thickness)

    me draw_rect_thick(x: i32, y: i32, w: i32, h: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_rect_thick(self, x, y, w, h, color, thickness)

    me draw_circle_thick(cx: i32, cy: i32, r: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_circle_thick(self, cx, cy, r, color, thickness)

    me draw_rounded_rect_outline(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_rounded_rect_outline(self, x, y, w, h, radius, color, thickness)

    me draw_gradient_rect_h(x: i32, y: i32, w: i32, h: i32, left_color: u32, right_color: u32):
        if self.completion_unknown: return
        if self.mask_buf.len() > 0 and w > 0 and h > 0:
            var pixels: [u32] = [0u32; w * h]
            var py = 0
            while py < h:
                var px = 0
                while px < w:
                    val denom = if w > 1: w - 1 else: 1
                    val rr = color_r(left_color) + (color_r(right_color) - color_r(left_color)) * px / denom
                    val gg = color_g(left_color) + (color_g(right_color) - color_g(left_color)) * px / denom
                    val bb = color_b(left_color) + (color_b(right_color) - color_b(left_color)) * px / denom
                    val aa = color_a(left_color) + (color_a(right_color) - color_a(left_color)) * px / denom
                    val dx = x + px
                    val dy = y + py
                    val mask_index = dy * self.mask_w + dx
                    if (dx >= 0 and dy >= 0 and mask_index >= 0 and
                            mask_index < self.mask_buf.len() and
                            self.mask_buf[mask_index] != 0u8):
                        pixels[py * w + px] = rgba(rr, gg, bb, aa)
                    px = px + 1
                py = py + 1
            val saved_mask = self.mask_buf
            val saved_mask_w = self.mask_w
            val saved_mask_h = self.mask_h
            self.mask_buf = []
            self.mask_w = 0
            self.mask_h = 0
            self.draw_image_blend(x, y, w, h, pixels)
            self.mask_buf = saved_mask
            self.mask_w = saved_mask_w
            self.mask_h = saved_mask_h
            return
        emu_draw_gradient_rect_h(self, x, y, w, h, left_color, right_color)

    me draw_radial_gradient(cx: i32, cy: i32, r: i32, center_color: u32, edge_color: u32):
        if self.completion_unknown: return
        emu_draw_radial_gradient(self, cx, cy, r, center_color, edge_color)

    me draw_rect_blend(x: i32, y: i32, w: i32, h: i32, color: u32):
        if self.completion_unknown: return
        if color_a(color) == 255:
            self.draw_rect_filled(x, y, w, h, color)
            return
        if color_a(color) == 0:
            return
        if not self._flush_for_host_fallback("rect-blend-host-readback"):
            return
        emu_draw_rect_blend(self, x, y, w, h, color)

    me draw_image_blend(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        if not vulkan_timing_enabled():
            self._draw_image_blend_impl(x, y, w, h, pixels)
            return
        val _t = vulkan_timing_now_us()
        self._draw_image_blend_impl(x, y, w, h, pixels)
        vulkan_timing_add(VK_T_IMAGE_BLEND, _t)

    me _draw_image_blend_impl(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        if self.completion_unknown: return
        _vk_stat_image_op(w, h, true)
        val native_status = self._draw_image_blend_native(x, y, w, h, pixels, 1000)
        if native_status > 0:
            return
        if native_status < 0:
            self.mark_cpu_fallback("image-blend-completion-unknown")
            self.completion_unknown = true
            return
        if not self._flush_for_host_fallback("image-blend-host-readback"):
            return
        self.mark_cpu_fallback("image-blend-host-fallback")
        emu_draw_image_blend(self, x, y, w, h, pixels)

    me draw_image_scaled(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        if self.completion_unknown: return
        if not _vulkan_scaled_image_args_valid(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels):
            return
        val native_status = self._draw_image_scaled_native(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
        if native_status > 0:
            return
        if native_status < 0:
            self.mark_cpu_fallback("scaled-image-completion-unknown")
            self.completion_unknown = true
            return
        self.mark_cpu_fallback("scaled-image-host-fallback")
        emu_draw_image_scaled(self, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)

    me draw_image_scaled_blend(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]):
        if self.completion_unknown: return
        if not _vulkan_scaled_image_args_valid(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels):
            return
        val native_status = self._draw_image_scaled_blend_native(dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)
        if native_status > 0:
            return
        if native_status < 0:
            self.mark_cpu_fallback("scaled-image-blend-completion-unknown")
            self.completion_unknown = true
            return
        if not self._flush_for_host_fallback(
                "scaled-image-blend-host-readback"):
            return
        self.mark_cpu_fallback("scaled-image-blend-host-fallback")
        emu_draw_image_scaled_blend(self, dst_x, dst_y, dst_w, dst_h, src_w, src_h, pixels)

    me draw_triangle_outline(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32, thickness: i32):
        if self.completion_unknown: return
        emu_draw_triangle_outline(self, x1, y1, x2, y2, x3, y3, color, thickness)

    me draw_ir_apply_glass_material_device(config: Engine2dGlassMaterialConfig) -> bool:
        """Paint the whole glass rect on the device, with no host round trip.

        This replaces the lane's single largest CPU<->GPU boundary crossing:
        the CPU twin reads the ENTIRE framebuffer back to the host, blurs and
        tints one rect there, and uploads that rect again -- one full-surface
        readback plus one upload per glass rect per frame. The kernel reads the
        framebuffer where it already lives.

        Fail-closed on every path: a `false` return has left the framebuffer
        untouched, so the caller's CPU twin still paints the identical pixels.
        The validation below deliberately MIRRORS
        `engine2d_draw_ir_glass_material_pixels`' own guards -- a config that
        one rejects must not be painted by the other, or the two lanes differ.
        """
        if self.completion_unknown or not self.initialized or self.d_framebuffer <= 0:
            self.last_error = "glass-device-state-unavailable"
            return false
        if self.pipe_blit <= 0 or self.session.pipe_glass_material <= 0:
            self.last_error = if self.session.glass_error != "":
                self.session.glass_error
            else:
                "glass-device-pipeline-unavailable"
            return false
        if self.mask_buf.len() > 0:
            # A mask changes which pixels the copy-back may touch; the CPU twin
            # has no such concept, so parity is not established here.
            self.last_error = "glass-device-mask-unsupported"
            return false
        if (config.framebuffer_width != self.w or config.framebuffer_height != self.h or
            config.width <= 0 or config.height <= 0 or config.x < 0 or config.y < 0 or
            _i64(config.x) + _i64(config.width) > _i64(self.w) or
            _i64(config.y) + _i64(config.height) > _i64(self.h)):
            self.last_error = "glass-device-geometry-rejected"
            return false
        val pixel_count = _i64(config.width) * _i64(config.height)
        if pixel_count <= 0 or pixel_count > ENGINE2D_GLASS_MAX_WORK_PIXELS:
            self.last_error = "glass-device-work-budget-exceeded"
            return false

        val out_bytes = pixel_count * 4
        # One acquisition serves both roles: the kernel's output buffer and,
        # immediately after, the image source of the copy-back -- so the pool
        # owns its lifetime exactly as it does for an ordinary image upload.
        var d_out = self._acquire_image_source(out_bytes)
        if d_out <= 0 and self._image_source_pool_is_fully_pending():
            val retried = self._flush_pending_compute_at("glass-device-retry")
            if retried < 0:
                self.completion_unknown = true
                self.last_error = "glass-device-flush-unknown"
                return false
            if retried > 0:
                d_out = self._acquire_image_source(out_bytes)
        if d_out <= 0:
            self.last_error = "glass-device-output-unavailable"
            return false

        val blur = if config.blur_radius < 0:
            0
        elif config.blur_radius > 4:
            4
        else:
            config.blur_radius
        val pc = _pack_glass_material_pc(
            self.w, self.h, config.x, config.y, config.width, config.height,
            engine2d_glass_corner_radius(config), blur,
            config.saturation_milli, config.surface_alpha_milli,
            config.surface_color, config.gradient_from, config.gradient_to,
            config.gradient_enabled, config.gradient_layered_over_surface)
        val gx = (_i64(config.width) + 15) / 16
        val gy = (_i64(config.height) + 15) / 16
        # Recorded rather than submitted, for the same reason as the blur twin
        # above: every dispatch already carries a full memory barrier.
        val produced = if self.frame_batching_enabled:
            self._enqueue_image_composite(
                self.session.pipe_glass_material, d_out, pc, gx, gy, 1)
        else:
            vulkan_dispatch_region_kernel_checked(
                self.d_framebuffer, self.session.pipe_glass_material, d_out, pc, gx, gy, 1)
        if vulkan_order_trace_enabled():
            vulkan_order_trace("glass-device x={config.x} y={config.y} w={config.width} h={config.height} blur={blur} rc={produced} fb={self.d_framebuffer}")
        if produced <= 0:
            if not self.frame_batching_enabled:
                self._release_image_source(d_out)
            if produced < 0:
                self.completion_unknown = true
            self.last_error = "glass-device-dispatch-failed"
            return false

        # Reuse the ordinary image-composite tail so the copy-back is exactly
        # what `draw_image(x, y, w, h, pixels)` does today -- same clip, same
        # damage and dirty bookkeeping -- with the pixels already on the device.
        val composited = self._finish_image_composite(
            d_out, config.x, config.y, config.width, config.height,
            config.width, config.height, 1000, VK_IMAGE_COMPOSITE_COPY)
        if composited <= 0:
            if composited < 0:
                self.completion_unknown = true
            self.last_error = "glass-device-composite-failed"
            return false
        vulkan_stat_note_device_glass_material()
        self.last_error = ""
        true

    me _draw_blur_rect_device(x: i32, y: i32, w: i32, h: i32, radius: i32) -> bool:
        """Box-blur a rect entirely on the device. False = nothing was drawn.

        The host twin this replaces reads the ENTIRE framebuffer back, blurs
        one rect on the CPU and uploads that rect again -- a full-surface
        readback per blurred rect per frame, and the largest remaining
        CPU<->GPU crossing on the web renderer's Vulkan lane. It was also a
        SILENT one: the flush it performs succeeds, so no cpu-fallback reason
        was ever recorded for it.

        Fail-closed: every `false` return has left the framebuffer untouched,
        so the caller falls through to the host twin and paints the identical
        pixels (proven byte-for-byte by the parity spec).
        """
        if self.completion_unknown or not self.initialized or self.d_framebuffer <= 0:
            return false
        if self.pipe_blit <= 0 or self.session.pipe_blur_rect <= 0:
            return false
        if self.mask_buf.len() > 0:
            return false
        # Mirror emu_draw_blur_rect()'s own guards exactly: a rect it would
        # decline must not be painted here either.
        if w <= 0 or h <= 0 or radius <= 0:
            return false
        val pixel_count = _i64(w) * _i64(h)
        if pixel_count <= 0 or pixel_count > 4294967295 or pixel_count > 9223372036854775807 / 4:
            return false

        val out_bytes = pixel_count * 4
        # One acquisition serves both roles: the kernel's output buffer and,
        # immediately after, the image source of the copy-back, so the pool
        # owns its lifetime exactly as for an ordinary image upload.
        var d_out = self._acquire_image_source(out_bytes)
        if d_out <= 0 and self._image_source_pool_is_fully_pending():
            val retried = self._flush_pending_compute_at("blur-device-retry")
            if retried < 0:
                self.completion_unknown = true
                return false
            if retried > 0:
                d_out = self._acquire_image_source(out_bytes)
        if d_out <= 0:
            return false

        val pc = _pack_blur_rect_pc(x, y, w, h, self.w, self.h, radius)
        val gx = (_i64(w) + 15) / 16
        val gy = (_i64(h) + 15) / 16
        # FROZEN PRECONDITION for reusing the image-composite enqueue with a
        # foreign pipeline: blur_rect.comp, glass_material.comp and _glsl_blit
        # all declare the SAME descriptor set layout -- exactly two storage
        # buffers, 0 = framebuffer and 1 = source -- and all fit the 64-byte
        # push-constant range. The batcher's warm descriptor pool hands out
        # sets built for the blit pipeline, which are layout-compatible with
        # these only while that holds. A third binding, or a different binding
        # order, means a new pool, not a new caller here.
        #
        # RECORDED, not submitted. The kernel samples framebuffer content that
        # earlier dispatches in this same command buffer produced, and that is
        # safe without a flush because `rt_vulkan_dispatch` emits a full memory
        # barrier after EVERY dispatch (vulkan_graphics_runtime_compute.rs:480-494).
        # Flushing here instead would cost one queue submission per blurred
        # rect -- which is exactly what the host path cost, so the boundary
        # crossing would be gone while the submit count stood still.
        val produced = if self.frame_batching_enabled:
            self._enqueue_image_composite(
                self.session.pipe_blur_rect, d_out, pc, gx, gy, 1)
        else:
            vulkan_dispatch_region_kernel_checked(
                self.d_framebuffer, self.session.pipe_blur_rect, d_out, pc, gx, gy, 1)
        if vulkan_order_trace_enabled():
            vulkan_order_trace("blur-device x={x} y={y} w={w} h={h} r={radius} rc={produced} fb={self.d_framebuffer}")
        if produced <= 0:
            if not self.frame_batching_enabled:
                self._release_image_source(d_out)
            if produced < 0:
                self.completion_unknown = true
            return false

        # Same tail as an ordinary image upload, so the copy-back is exactly
        # what emu_draw_blur_rect's `core.draw_image(x, y, w, h, temp)` does --
        # same clip, same damage and dirty bookkeeping.
        val composited = self._finish_image_composite(
            d_out, x, y, w, h, w, h, 1000, VK_IMAGE_COMPOSITE_COPY)
        if composited <= 0:
            if composited < 0:
                self.completion_unknown = true
            return false
        vulkan_stat_note_device_blur_rect()
        true

    me draw_blur_rect(x: i32, y: i32, w: i32, h: i32, radius: i32):
        if self.completion_unknown: return
        if self._draw_blur_rect_device(x, y, w, h, radius):
            return
        if not self._flush_for_host_fallback("blur-host-readback"):
            return
        # Reached only when the device kernel declined. Record it: this is a
        # full-surface readback plus an upload, and it used to happen with
        # cpu_fallback_count reading 0.
        self.mark_cpu_fallback("glass-device-unavailable")
        emu_draw_blur_rect(self, x, y, w, h, radius)

    me draw_shadow_rect(x: i32, y: i32, w: i32, h: i32, offset_x: i32, offset_y: i32, blur_r: i32, color: u32):
        if self.completion_unknown: return
        if w <= 0 or h <= 0:
            return
        val sx = x + offset_x
        val sy = y + offset_y
        val sw = w + 2 * blur_r
        val sh = h + 2 * blur_r
        self.draw_rect_filled(
            sx - blur_r, sy - blur_r, sw, sh, color)
        if blur_r > 0:
            self.draw_blur_rect(
                sx - blur_r, sy - blur_r, sw, sh, blur_r)

    me draw_image_transform(dst_x: i32, dst_y: i32, src_w: i32, src_h: i32, a: i32, b: i32, c: i32, d: i32, tx: i32, ty: i32, pixels: [u32]):
        if self.completion_unknown: return
        emu_draw_image_transform(self, dst_x, dst_y, src_w, src_h, a, b, c, d, tx, ty, pixels)

    me draw_rect_blend_mode(x: i32, y: i32, w: i32, h: i32, color: u32, mode: i32):
        if self.completion_unknown: return
        if not self._flush_for_host_fallback("blend-mode-host-readback"):
            return
        emu_draw_rect_blend_mode(self, x, y, w, h, color, mode)

impl Engine2DExtended for VulkanBackend:
    me _clear_borrowed_pipeline_handles():
        self.shader_clear = 0
        self.shader_rect_filled = 0
        self.shader_rect_outline = 0
        self.shader_circle_filled = 0
        self.shader_circle_outline = 0
        self.shader_line = 0
        self.shader_rounded_rect = 0
        self.shader_triangle = 0
        self.shader_gradient = 0
        self.shader_blit = 0
        self.pipe_clear = 0
        self.pipe_rect_filled = 0
        self.pipe_rect_outline = 0
        self.pipe_circle_filled = 0
        self.pipe_circle_outline = 0
        self.pipe_line = 0
        self.pipe_rounded_rect = 0
        self.pipe_triangle = 0
        self.pipe_gradient = 0
        self.pipe_blit = 0
        # The session owns the batch pipeline and destroys it; the surface only
        # drops its copy of the handle and its own rect-list buffers.
        self.pipe_rect_batch = 0
        self.rect_batch_error = "not-installed"
        self._free_rect_batch_pool()

    me install_font_atlas_pipeline(spirv_bytes: [u8]) -> VulkanFontPipelineEvidence:
        """Install through the retained shared session; standalone mode fails closed."""
        if self.owns_session:
            return self.session.install_font_atlas_pipeline(spirv_bytes)
        VulkanFontPipelineEvidence(
            status: "unavailable", reason: "font-pipeline-requires-session",
            artifact_mode: "none", shader_handle: 0, pipeline_handle: 0,
            device_name: "", device_type: "", driver_identity: ""
        )

    me font_atlas_pipeline_evidence() -> VulkanFontPipelineEvidence:
        """Return only the live retained session's current font pipeline."""
        if self.owns_session:
            return self.session.font_atlas_pipeline_evidence()
        VulkanFontPipelineEvidence(
            status: "unavailable", reason: "font-pipeline-requires-session",
            artifact_mode: "none", shader_handle: 0, pipeline_handle: 0,
            device_name: "", device_type: "", driver_identity: ""
        )

    # Rasterize glyph coverage on the CPU, then perform the framebuffer write
    # through the fenced Vulkan image-composite path. CPU glyph generation is
    # analogous to preparing a texture; it does not make the final framebuffer
    # a CPU mirror when the device composite succeeds.
    me draw_text_bg(x: i32, y: i32, text_val: text, fg: u32, bg: u32, font_size: i32):
        if self.completion_unknown:
            self.last_text_path = VULKAN_TEXT_PATH_NOT_DRAWN
            self.last_text_fallback_reason = "completion-unknown"
            return
        if not self.initialized:
            self.dirty = true
            self.host_mirror_frame_fresh = false
            self.note_damage_full()
            self.last_text_path = VULKAN_TEXT_PATH_CPU_RASTER
            self.last_text_fallback_reason = "backend-uninitialized"
            return
        if not self._bitmap_text_bg_atlas_path(x, y, text_val, fg, bg, font_size):
            return
        val text_buf = text_blit_buffer(text_val, fg, bg, font_size)
        if text_buf.is_empty():
            return
        self.draw_image(x, y, text_buf.width, text_buf.height, text_buf.pixels)

# ---------------------------------------------------------------------------
# Draw-kind census (process-global, instrumentation only)
# ---------------------------------------------------------------------------
# Counts what each Vulkan draw entry point actually DID, split by the branch it
# took, so a page probe can attribute a frame instead of guessing. Module-level
# rather than per-backend fields because a probe reads them without holding the
# backend, and exactly one Vulkan surface is live on the page lane.
#
# The load-bearing split is `rect_alpha_blend`: `draw_rect_filled` turns ANY
# colour with alpha < 255 into a full `draw_image_blend`, which on this lane is a
# staging upload + dispatch + fence. `rect_alpha_1x1` counts the degenerate
# single-pixel case that anti-aliased shape decomposition emits.

var _vk_stat_rect_opaque: i64 = 0
var _vk_stat_rect_alpha_blend: i64 = 0
var _vk_stat_rect_alpha_1x1: i64 = 0
var _vk_stat_rect_masked: i64 = 0
var _vk_stat_rect_list: i64 = 0
var _vk_stat_image_blend: i64 = 0
var _vk_stat_image_blend_small: i64 = 0
var _vk_stat_image: i64 = 0
var _vk_stat_text: i64 = 0

pub fn vulkan_draw_census_reset():
    _vk_stat_rect_opaque = 0
    _vk_stat_rect_alpha_blend = 0
    _vk_stat_rect_alpha_1x1 = 0
    _vk_stat_rect_masked = 0
    _vk_stat_rect_list = 0
    _vk_stat_image_blend = 0
    _vk_stat_image_blend_small = 0
    _vk_stat_image = 0
    _vk_stat_text = 0

pub fn vulkan_draw_census_line() -> text:
    ("rect_opaque={_vk_stat_rect_opaque}" +
     " rect_alpha_blend={_vk_stat_rect_alpha_blend}" +
     " rect_alpha_1x1={_vk_stat_rect_alpha_1x1}" +
     " rect_masked={_vk_stat_rect_masked}" +
     " rect_list={_vk_stat_rect_list}" +
     " image_blend={_vk_stat_image_blend}" +
     " image_blend_le16px={_vk_stat_image_blend_small}" +
     " image={_vk_stat_image}" +
     " text={_vk_stat_text}")

fn _vk_stat_rect(w: i32, h: i32, alpha: bool, masked: bool):
    if masked:
        _vk_stat_rect_masked = _vk_stat_rect_masked + 1
    elif alpha:
        _vk_stat_rect_alpha_blend = _vk_stat_rect_alpha_blend + 1
        if w == 1 and h == 1:
            _vk_stat_rect_alpha_1x1 = _vk_stat_rect_alpha_1x1 + 1
    else:
        _vk_stat_rect_opaque = _vk_stat_rect_opaque + 1

fn _vk_stat_image_op(w: i32, h: i32, blend: bool):
    if blend:
        _vk_stat_image_blend = _vk_stat_image_blend + 1
        if w * h <= 16:
            _vk_stat_image_blend_small = _vk_stat_image_blend_small + 1
    else:
        _vk_stat_image = _vk_stat_image + 1

fn _vk_stat_text_op():
    _vk_stat_text = _vk_stat_text + 1

fn _vk_stat_rect_list_op():
    _vk_stat_rect_list = _vk_stat_rect_list + 1

# Full-surface readbacks and checksum walks are O(framebuffer) EACH, so a frame
# that performs several is superlinear in page content even when its draw count
# is small. These are cumulative for the process, unlike the frame-scoped
# `present_*_count` fields, which a frame boundary resets before a probe can
# read them.
var _vk_stat_readbacks: i64 = 0
var _vk_stat_readback_pixels: i64 = 0

pub fn vulkan_stat_note_readback(pixel_count: i64):
    _vk_stat_readbacks = _vk_stat_readbacks + 1
    _vk_stat_readback_pixels = _vk_stat_readback_pixels + pixel_count

pub fn vulkan_readback_count() -> i64:
    """Full-surface readbacks this process has performed.

    Exposed on its own, not only inside the census line, because the device
    glass/blur claim is exactly "this counter did not move" and parsing a
    formatted line to assert that would be a worse oracle than reading it.
    """
    _vk_stat_readbacks

# Device-side replacements for what used to be host round trips. These rise
# while `_vk_stat_readbacks` stays put -- that pairing, not either number on
# its own, is what distinguishes "painted on the device" from "painted
# correctly by some path".
var _vk_stat_device_blur_rects: i64 = 0
var _vk_stat_device_glass_materials: i64 = 0

pub fn vulkan_stat_note_device_blur_rect():
    _vk_stat_device_blur_rects = _vk_stat_device_blur_rects + 1

pub fn vulkan_stat_note_device_glass_material():
    _vk_stat_device_glass_materials = _vk_stat_device_glass_materials + 1

pub fn vulkan_device_blur_rect_count() -> i64:
    _vk_stat_device_blur_rects

pub fn vulkan_device_glass_material_count() -> i64:
    _vk_stat_device_glass_materials

pub fn vulkan_device_material_census_line() -> text:
    "device_blur_rects={_vk_stat_device_blur_rects} device_glass_materials={_vk_stat_device_glass_materials}"

pub fn vulkan_device_material_census_reset():
    _vk_stat_device_blur_rects = 0
    _vk_stat_device_glass_materials = 0

pub fn vulkan_readback_census_line() -> text:
    "readbacks={_vk_stat_readbacks} readback_pixels={_vk_stat_readback_pixels}"

pub fn vulkan_readback_census_reset():
    _vk_stat_readbacks = 0
    _vk_stat_readback_pixels = 0

# ---------------------------------------------------------------------------
# Per-op wall-clock attribution (process-global, instrumentation only)
# ---------------------------------------------------------------------------
# The draw-kind census above answers "how many ops", which was enough to find
# the 1x1-composite population but NOT enough to explain the residual: at
# 300x253 the Vulkan lane costs 68 s against 25 s for cpu_simd on the same page,
# and 187 counted ops cannot account for a 43 s delta at any plausible per-
# dispatch cost. So this records WHERE the wall clock goes, split by call kind
# AND by SFFI sub-step, with count / total / max per bucket.
#
# Gated: every probe is `if vulkan_timing_enabled()`, resolved from the
# environment ONCE at module init and never per call, so an unarmed frame pays
# one already-resolved bool test per op and no clock syscall at all.
#
# Module-global rather than per-backend fields for the same reason the draw
# census is: a page probe and a spec both read these without holding the
# backend, and the per-instance counters were measured reading back zero
# (`submits=0` against 111 drawn rects) because the pooled slot a probe can
# reach is not always the instance that drew.

val VK_T_COUNT: i64 = 34

val VK_T_RECT: i64 = 0
val VK_T_RECT_LIST: i64 = 1
val VK_T_IMAGE: i64 = 2
val VK_T_IMAGE_BLEND: i64 = 3
val VK_T_IMAGE_COMPOSITE: i64 = 4
val VK_T_TEXT: i64 = 5
val VK_T_TEXT_BG: i64 = 6
val VK_T_READBACK: i64 = 7
val VK_T_PRESENT: i64 = 8
val VK_T_ENQUEUE: i64 = 9
val VK_T_FLUSH: i64 = 10
val VK_T_SFFI_BEGIN: i64 = 11
val VK_T_SFFI_REAP: i64 = 12
val VK_T_SFFI_DESC: i64 = 13
val VK_T_SFFI_BIND_PIPE: i64 = 14
val VK_T_SFFI_BIND_DESC: i64 = 15
val VK_T_SFFI_PUSH: i64 = 16
val VK_T_SFFI_DISPATCH: i64 = 17
val VK_T_SFFI_END: i64 = 18
val VK_T_SFFI_SUBMIT: i64 = 19
val VK_T_SFFI_WAIT_FENCE: i64 = 20
val VK_T_UPLOAD: i64 = 21
val VK_T_FONT_COMPOSITE: i64 = 22
val VK_T_FONT_ATLAS_BUILD: i64 = 23
# Sub-steps of `composite_font_batch`, which the first attribution run measured
# at 27.3 s across 5 calls on a 300x253 page -- 58% of the whole frame.
val VK_T_FONT_ATLAS_PACK: i64 = 24
val VK_T_FONT_ATLAS_UPLOAD: i64 = 25
val VK_T_FONT_ATLAS_DIGEST: i64 = 26
val VK_T_FONT_PACKED_PARAMS: i64 = 27
val VK_T_FONT_QUAD_VALIDATE: i64 = 28
val VK_T_FONT_OWNER_IDENTITY: i64 = 29
# Sub-steps of `_draw_image_composite_native_impl`, which the 900x760
# attribution run measured at 544 s across 264 calls -- 69% of the whole frame,
# with the split between host packing, device allocation and dispatch
# UNMEASURED. These four buckets settle it in one run.
val VK_T_IMAGE_PACK: i64 = 30
val VK_T_IMAGE_ALLOC: i64 = 31
val VK_T_IMAGE_DISPATCH: i64 = 32
val VK_T_IMAGE_BYTE_FALLBACK: i64 = 33

var _vk_timing_armed: bool = false
var _vk_timing_resolved: bool = false

var _vk_t_us: [i64] = [0; 34]
var _vk_t_n: [i64] = [0; 34]
var _vk_t_max: [i64] = [0; 34]

pub fn vulkan_timing_enabled() -> bool:
    """True when `SIMPLE_VK_TIMING=1`. The environment is read exactly once."""
    if not _vk_timing_resolved:
        val v = env_get("SIMPLE_VK_TIMING") ?? ""
        _vk_timing_armed = v == "1" or v == "true"
        _vk_timing_resolved = true
    _vk_timing_armed

pub fn vulkan_timing_now_us() -> i64:
    if not vulkan_timing_enabled():
        return 0
    default_frame_clock().now_micros()

pub fn vulkan_timing_add(bucket: i64, started_us: i64):
    """Fold one completed op into `bucket`. No-op unless timing is armed."""
    if not vulkan_timing_enabled():
        return
    if bucket < 0 or bucket >= VK_T_COUNT:
        return
    val elapsed = default_frame_clock().now_micros() - started_us
    if elapsed < 0:
        return
    _vk_t_us[bucket] = _vk_t_us[bucket] + elapsed
    _vk_t_n[bucket] = _vk_t_n[bucket] + 1
    if elapsed > _vk_t_max[bucket]:
        _vk_t_max[bucket] = elapsed

pub fn vulkan_timing_note(bucket: i64, elapsed_us: i64):
    """Fold a pre-measured duration into `bucket`, for a caller that already
    holds a start/finish pair (e.g. the font composite's own evidence clock)."""
    if not vulkan_timing_enabled():
        return
    if bucket < 0 or bucket >= VK_T_COUNT or elapsed_us < 0:
        return
    _vk_t_us[bucket] = _vk_t_us[bucket] + elapsed_us
    _vk_t_n[bucket] = _vk_t_n[bucket] + 1
    if elapsed_us > _vk_t_max[bucket]:
        _vk_t_max[bucket] = elapsed_us

pub fn vulkan_timing_reset():
    vulkan_font_dirty_reset()
    vulkan_image_stats_reset()
    var i: i64 = 0
    while i < VK_T_COUNT:
        _vk_t_us[i] = 0
        _vk_t_n[i] = 0
        _vk_t_max[i] = 0
        i = i + 1

fn _vk_timing_name(bucket: i64) -> text:
    if bucket == VK_T_RECT: return "rect"
    if bucket == VK_T_RECT_LIST: return "rect_list"
    if bucket == VK_T_IMAGE: return "image"
    if bucket == VK_T_IMAGE_BLEND: return "image_blend"
    if bucket == VK_T_IMAGE_COMPOSITE: return "image_composite"
    if bucket == VK_T_TEXT: return "text"
    if bucket == VK_T_TEXT_BG: return "text_bg"
    if bucket == VK_T_READBACK: return "readback"
    if bucket == VK_T_PRESENT: return "present"
    if bucket == VK_T_ENQUEUE: return "enqueue"
    if bucket == VK_T_FLUSH: return "flush"
    if bucket == VK_T_SFFI_BEGIN: return "sffi_begin_compute"
    if bucket == VK_T_SFFI_REAP: return "sffi_reap_quarantine"
    if bucket == VK_T_SFFI_DESC: return "sffi_descriptor"
    if bucket == VK_T_SFFI_BIND_PIPE: return "sffi_bind_pipeline"
    if bucket == VK_T_SFFI_BIND_DESC: return "sffi_bind_descriptors"
    if bucket == VK_T_SFFI_PUSH: return "sffi_push_constants"
    if bucket == VK_T_SFFI_DISPATCH: return "sffi_dispatch"
    if bucket == VK_T_SFFI_END: return "sffi_end_compute"
    if bucket == VK_T_SFFI_SUBMIT: return "sffi_submit_and_wait"
    if bucket == VK_T_SFFI_WAIT_FENCE: return "sffi_wait_fence"
    if bucket == VK_T_UPLOAD: return "sffi_upload"
    if bucket == VK_T_FONT_COMPOSITE: return "font_composite"
    if bucket == VK_T_FONT_ATLAS_BUILD: return "font_atlas_cpu_build"
    if bucket == VK_T_FONT_ATLAS_PACK: return "font_atlas_pack_u32_to_u8"
    if bucket == VK_T_FONT_ATLAS_UPLOAD: return "font_atlas_sffi_upload"
    if bucket == VK_T_FONT_ATLAS_DIGEST: return "font_atlas_payload_sha256"
    if bucket == VK_T_FONT_PACKED_PARAMS: return "font_packed_params"
    if bucket == VK_T_FONT_QUAD_VALIDATE: return "font_quad_validate"
    if bucket == VK_T_FONT_OWNER_IDENTITY: return "font_owner_identity"
    if bucket == VK_T_IMAGE_PACK: return "image_pack_u32_to_u8"
    if bucket == VK_T_IMAGE_ALLOC: return "image_source_alloc"
    if bucket == VK_T_IMAGE_DISPATCH: return "image_descriptor_dispatch"
    if bucket == VK_T_IMAGE_BYTE_FALLBACK: return "image_exact_size_byte_fallback"
    "bucket{bucket}"

# Why the font-atlas upload cache missed, per composite. The timing table says
# the 4 MB repack+redigest ran 5 times on a page whose atlas should be built
# once; these counters separate "the atlas genuinely changed" (new glyphs were
# rasterized between batches) from "the cache key is unstable" (same atlas,
# different identity), because the correct fix differs in each case.
var _vk_font_dirty_gen: i64 = 0
var _vk_font_dirty_identity: i64 = 0
var _vk_font_dirty_dims: i64 = 0
var _vk_font_composites: i64 = 0
var _vk_font_gen_trace: text = ""

pub fn vulkan_font_dirty_note(gen_changed: bool, identity_changed: bool,
                              dims_changed: bool, generation: i64):
    if not vulkan_timing_enabled():
        return
    _vk_font_composites = _vk_font_composites + 1
    if gen_changed: _vk_font_dirty_gen = _vk_font_dirty_gen + 1
    if identity_changed: _vk_font_dirty_identity = _vk_font_dirty_identity + 1
    if dims_changed: _vk_font_dirty_dims = _vk_font_dirty_dims + 1
    if _vk_font_composites <= 16:
        _vk_font_gen_trace = _vk_font_gen_trace + " {generation}"

var _vk_font_pack_full: i64 = 0
var _vk_font_pack_incremental: i64 = 0

pub fn vulkan_font_per_owner_mirror_enabled() -> bool:
    """Per-owner atlas mirrors, on by default; `0` restores the single mirror.

    The off position exists as a MEASUREMENT CONTROL: it lets the same binary
    and the same tree produce the pre-change pack counts, so a before/after
    comparison cannot be contaminated by a rebuild.
    """
    (env_get("SIMPLE_VK_FONT_PER_OWNER_MIRROR") ?? "") != "0"

pub fn vulkan_font_pack_note(incremental: bool):
    """Record whether an atlas upload repacked the whole atlas or only the
    cells the batch inserted. Always counted, not just when timing is armed:
    a spec asserts on these without wanting the clock overhead."""
    if incremental:
        _vk_font_pack_incremental = _vk_font_pack_incremental + 1
    else:
        _vk_font_pack_full = _vk_font_pack_full + 1

pub fn vulkan_font_pack_full_count() -> i64:
    _vk_font_pack_full

pub fn vulkan_font_pack_incremental_count() -> i64:
    _vk_font_pack_incremental

pub fn vulkan_font_pack_reset():
    _vk_font_pack_full = 0
    _vk_font_pack_incremental = 0

# Mirror self-check (SIMPLE_VK_FONT_SELFCHECK=1). After an incremental repack,
# the mirror is compared byte-for-byte against a full pack of the same atlas --
# the ground truth. This is the only way to tell the three candidate causes of a
# moved frame apart: a mismatch INSIDE a reported dirty rect means the repack
# loop is wrong; a mismatch OUTSIDE every dirty rect means the producer changes
# cells it does not report; zero mismatches means the divergence is downstream
# of the mirror entirely. Costs a full pack per incremental repack, so it is
# opt-in and never on in a timed run.
var _vk_font_mirror_checks: i64 = 0
var _vk_font_mirror_bad_calls: i64 = 0
var _vk_font_mirror_bad_bytes: i64 = 0
var _vk_font_mirror_first: text = ""
var _vk_font_decisions: text = ""

pub fn vulkan_font_selfcheck_enabled() -> bool:
    (env_get("SIMPLE_VK_FONT_SELFCHECK") ?? "") == "1"

# Atlas payload digest source (SIMPLE_VK_FONT_DIGEST=payload restores the walk).
#
# The digest is EVIDENCE -- callers assert it is 64 lowercase hex characters and
# that it moves when the atlas moves; nothing reads it to decide whether to
# re-upload. That decision is made, and has always been made, by
# `(atlas_generation, owner_identity)`: `_vulkan_font_upload_atlas` re-uploads
# exactly when either changes, so if that pair were not a sound content key the
# upload cache would already be painting stale glyphs. Hashing 1,048,576 pixels
# in interpreted Simple to restate what the pair already says cost **37,650 ms
# across 21 calls** of a 259,523 ms 900x760 frame -- 53% of `font_composite` and
# the single largest remaining term. The default digest therefore folds the same
# geometry with that pair instead of the pixels, and keeps the identical
# `sha256_u8_hex` shape so every existing evidence assertion still holds.
#
# `SIMPLE_VK_FONT_DIGEST=payload` restores the full pixel walk for anyone who
# wants a content-derived token (e.g. to audit the generation counter itself);
# `SIMPLE_VK_FONT_SELFCHECK=1` implies it, because a run that exists to check the
# mirror against ground truth should not be reading a token that cannot see the
# pixels.
pub fn vulkan_font_payload_digest_full() -> bool:
    (env_get("SIMPLE_VK_FONT_DIGEST") ?? "") == "payload" or vulkan_font_selfcheck_enabled()

# Overlapping-quad census (SIMPLE_VK_FONT_OVERLAP=1). The packed font kernel
# (`font_atlas_composite.spl:266`) runs ONE INVOCATION PER (pixel, glyph) and
# blends with a plain non-atomic read-modify-write on `dst[di]`. Two glyphs in
# the SAME dispatch whose destination rects share a pixel are therefore two
# concurrent invocations racing on that word, and the loser's blend is dropped --
# which produces exactly the graded, run-varying per-texel error F18 measured on
# thin glyph stems (139 vs 226 against a CPU oracle of 124). This counter is the
# host-side evidence for that: it counts, per batch, how many ordered quad pairs
# have intersecting destination rects. O(n^2) in the glyph count, so it is
# opt-in and never on in a timed run.
var _vk_font_overlap_batches: i64 = 0
var _vk_font_overlap_pairs: i64 = 0
var _vk_font_overlap_max_batch: i64 = 0
var _vk_font_overlap_quads: i64 = 0

pub fn vulkan_font_overlap_enabled() -> bool:
    (env_get("SIMPLE_VK_FONT_OVERLAP") ?? "") == "1"

pub fn vulkan_font_overlap_note(quads: i64, pairs: i64):
    _vk_font_overlap_batches = _vk_font_overlap_batches + 1
    _vk_font_overlap_quads = _vk_font_overlap_quads + quads
    _vk_font_overlap_pairs = _vk_font_overlap_pairs + pairs
    if pairs > _vk_font_overlap_max_batch:
        _vk_font_overlap_max_batch = pairs

pub fn vulkan_font_overlap_report() -> text:
    """`"batches=<n> quads=<n> overlapping_pairs=<n> max_in_one_batch=<n>"`.

    `overlapping_pairs=0` across every batch would REFUTE the write-race
    hypothesis for the packed font dispatch; any non-zero count confirms that at
    least one destination word is written by two concurrent invocations.
    """
    "batches={_vk_font_overlap_batches} quads={_vk_font_overlap_quads} overlapping_pairs={_vk_font_overlap_pairs} max_in_one_batch={_vk_font_overlap_max_batch}"

pub fn vulkan_font_mirror_note(mismatched_bytes: i64, detail: text):
    _vk_font_mirror_checks = _vk_font_mirror_checks + 1
    if mismatched_bytes > 0:
        _vk_font_mirror_bad_calls = _vk_font_mirror_bad_calls + 1
        _vk_font_mirror_bad_bytes = _vk_font_mirror_bad_bytes + mismatched_bytes
        if _vk_font_mirror_first == "":
            _vk_font_mirror_first = detail

pub fn vulkan_font_decision_note(detail: text):
    """One line per composite recording every `can_increment` input and the
    decision, so a full<->incremental swap is visible without re-deriving it."""
    if _vk_font_decisions.len() < 4000:
        _vk_font_decisions = _vk_font_decisions + "\n    " + detail

pub fn vulkan_font_mirror_line() -> text:
    ("font_mirror_selfcheck checks={_vk_font_mirror_checks}" +
     " bad_calls={_vk_font_mirror_bad_calls}" +
     " bad_bytes={_vk_font_mirror_bad_bytes}" +
     " first=[{_vk_font_mirror_first}]" +
     " decisions:{_vk_font_decisions}")

pub fn vulkan_font_mirror_reset():
    _vk_font_mirror_checks = 0
    _vk_font_mirror_bad_calls = 0
    _vk_font_mirror_bad_bytes = 0
    _vk_font_mirror_first = ""
    _vk_font_decisions = ""

pub fn vulkan_font_dirty_line() -> text:
    ("font_atlas_dirty composites={_vk_font_composites}" +
     " gen_changed={_vk_font_dirty_gen}" +
     " identity_changed={_vk_font_dirty_identity}" +
     " dims_changed={_vk_font_dirty_dims}" +
     " generations=[{_vk_font_gen_trace} ]" +
     " pack_full={_vk_font_pack_full} pack_incremental={_vk_font_pack_incremental}" +
     (if _vk_font_mirror_checks > 0 or _vk_font_decisions != "": "\n  " + vulkan_font_mirror_line() else: ""))

pub fn vulkan_font_dirty_reset():
    vulkan_font_pack_reset()
    vulkan_font_mirror_reset()
    _vk_font_dirty_gen = 0
    _vk_font_dirty_identity = 0
    _vk_font_dirty_dims = 0
    _vk_font_composites = 0
    _vk_font_gen_trace = ""

# Why an image composite declined the device path, and how big it was.
#
# `_draw_image_composite_native_impl` has ten `return 0` exits; every one of
# them drops the caller to `emu_draw_image_*`, which does a full host
# `core.read_pixels()` and a software blend. Until these counters existed the
# 544 s attributed to `image_composite` at 900x760 could not be split between
# "the device path ran and the interpreted u32->u8 pack was slow" and "the
# device path declined and the cost is a host readback", which need opposite
# fixes. The size tally separates the 3 full-surface composites (684k px) from
# the 261 small ones, because those two populations also need different fixes.
val VK_IMG_R_OK: i64 = 0
val VK_IMG_R_STATE: i64 = 1
val VK_IMG_R_ARGS: i64 = 2
val VK_IMG_R_GEOM: i64 = 3
val VK_IMG_R_CLIP: i64 = 4
val VK_IMG_R_SOURCE: i64 = 5
val VK_IMG_R_UPLOAD: i64 = 6
val VK_IMG_R_DISPATCH: i64 = 7
val VK_IMG_R_COUNT: i64 = 8

var _vk_img_reason: [i64] = [0; 8]
var _vk_img_full_surface: i64 = 0
var _vk_img_small: i64 = 0
var _vk_img_full_surface_us: i64 = 0
var _vk_img_small_us: i64 = 0
var _vk_img_max_px: i64 = 0

pub fn vulkan_image_reason_note(reason: i64):
    """Record the exit taken by one `_draw_image_composite_native_impl` call."""
    if reason < 0 or reason >= VK_IMG_R_COUNT:
        return
    _vk_img_reason[reason] = _vk_img_reason[reason] + 1

pub fn vulkan_image_size_note(pixel_count: i64, surface_pixels: i64, elapsed_us: i64):
    """Tally one composite as full-surface or small, with its wall time.

    "Full surface" is >= 90% of the destination surface: a viewport-sized
    layer composite, which is the population that costs ~443 s of the 544 s.
    """
    if pixel_count > _vk_img_max_px:
        _vk_img_max_px = pixel_count
    if surface_pixels > 0 and pixel_count * 10 >= surface_pixels * 9:
        _vk_img_full_surface = _vk_img_full_surface + 1
        _vk_img_full_surface_us = _vk_img_full_surface_us + elapsed_us
    else:
        _vk_img_small = _vk_img_small + 1
        _vk_img_small_us = _vk_img_small_us + elapsed_us

fn _vk_img_reason_name(reason: i64) -> text:
    if reason == VK_IMG_R_OK: return "ok"
    if reason == VK_IMG_R_STATE: return "backend_state"
    if reason == VK_IMG_R_ARGS: return "bad_args_or_mask"
    if reason == VK_IMG_R_GEOM: return "geometry_overflow"
    if reason == VK_IMG_R_CLIP: return "clip_reject"
    if reason == VK_IMG_R_SOURCE: return "no_device_source"
    if reason == VK_IMG_R_UPLOAD: return "upload_failed"
    if reason == VK_IMG_R_DISPATCH: return "dispatch_declined"
    "reason{reason}"

pub fn vulkan_image_stats_line() -> text:
    var reasons = ""
    var i: i64 = 0
    while i < VK_IMG_R_COUNT:
        if _vk_img_reason[i] > 0:
            reasons = reasons + " {_vk_img_reason_name(i)}={_vk_img_reason[i]}"
        i = i + 1
    ("image_composite_stats full_surface={_vk_img_full_surface}" +
     " full_surface_ms={_vk_img_full_surface_us / 1000}" +
     " small={_vk_img_small} small_ms={_vk_img_small_us / 1000}" +
     " max_px={_vk_img_max_px} upload_mode={vulkan_image_upload_last_mode()}" +
     " upload_reason={vulkan_image_upload_last_reason()}" +
     " reasons:" + reasons)

pub fn vulkan_image_full_surface_count() -> i64:
    _vk_img_full_surface

pub fn vulkan_image_small_count() -> i64:
    _vk_img_small

pub fn vulkan_image_reason_count(reason: i64) -> i64:
    if reason < 0 or reason >= VK_IMG_R_COUNT: return 0
    _vk_img_reason[reason]

pub fn vulkan_image_stats_reset():
    var i: i64 = 0
    while i < VK_IMG_R_COUNT:
        _vk_img_reason[i] = 0
        i = i + 1
    _vk_img_full_surface = 0
    _vk_img_small = 0
    _vk_img_full_surface_us = 0
    _vk_img_small_us = 0
    _vk_img_max_px = 0

pub fn vulkan_timing_count(bucket: i64) -> i64:
    if bucket < 0 or bucket >= VK_T_COUNT: return 0
    _vk_t_n[bucket]

pub fn vulkan_timing_total_us(bucket: i64) -> i64:
    if bucket < 0 or bucket >= VK_T_COUNT: return 0
    _vk_t_us[bucket]

pub fn vulkan_timing_table() -> text:
    """Multi-line `bucket n total_ms max_ms` table, or one line when disarmed."""
    if not vulkan_timing_enabled():
        return "vk-timing: disarmed (set SIMPLE_VK_TIMING=1)"
    var out = ("vk-timing bucket n total_ms max_ms\n  " + vulkan_font_dirty_line() +
        "\n  " + vulkan_image_stats_line())
    if vulkan_font_overlap_enabled():
        out = out + "\n  font_quad_overlap " + vulkan_font_overlap_report()
    var i: i64 = 0
    while i < VK_T_COUNT:
        if _vk_t_n[i] > 0:
            val total_ms = _vk_t_us[i] / 1000
            val max_ms = _vk_t_max[i] / 1000
            out = out + "\n  {_vk_timing_name(i)} {_vk_t_n[i]} {total_ms} {max_ms}"
        i = i + 1
    out
