# ============================================================================
# Vulkan Availability Check
# ============================================================================

fn vulkan_available() -> bool:
    """Check if Vulkan runtime is available on this system."""
    vulkan_sffi_is_available()

# ============================================================================
# Structured error classification
# ============================================================================
#
# VulkanErrorKind classifies the failure category returned in last_error so
# callers can react appropriately without string-parsing.
#
# Usage:
#   val kind = vulkan_classify_error(backend.last_error)
#   if kind == VulkanErrorKind.DeviceLost: ...

enum VulkanErrorKind:
    """Classification of Vulkan runtime errors."""
    # Vulkan device was lost (VK_ERROR_DEVICE_LOST or similar).
    DeviceLost
    # A required Vulkan extension was not available on the selected device.
    MissingExtension
    # SPIR-V or GLSL shader compilation failed at pipeline creation time.
    ShaderCompile
    # The Vulkan runtime is not present or not initialised on this host.
    NotAvailable
    # No Vulkan device enumerated (or selection of a specific device failed).
    NoDevice
    # Catch-all for other runtime errors not classified above.
    Other
    # Not an error (last_error is empty).
    None

struct VulkanFrameReceipt:
    frame_index: i64
    framebuffer_width: i32
    framebuffer_height: i32
    dirty_rect_count: i64
    device_to_present_bytes: i64
    device_to_present_rect_count: i64
    readback_requested: bool
    readback_completed: bool
    readback_bytes: i64
    present_attempted: bool
    present_completed: bool
    present_mode: text
    device_present: bool
    host_cache_refresh_completed: bool
    no_readback: bool
    full_frame_fallback: bool
    fallback_reason: text
    cpu_fallback_used: bool
    completion_known: bool
    backend_handle: i64
    device_identity: i64
    swapchain_identity: i64
    # Monotonic backend-owner observations. A submit is recorded only after
    # the Vulkan SFFI returns a concrete fence for a real command buffer; a
    # fence completion is recorded only after the explicit wait succeeds.
    device_submit_count: i64
    device_fence_count: i64

fn _err_is_device_lost(err: text) -> bool:
    err.contains("device lost") or err.contains("DEVICE_LOST")

fn _err_is_missing_ext(err: text) -> bool:
    err.contains("extension") or err.contains("Extension")

fn _err_is_shader_compile(err: text) -> bool:
    val has_shader = err.contains("shader") or err.contains("SPIR-V")
    val has_compile = err.contains("compile") or err.contains("pipeline")
    has_shader or has_compile

fn _err_is_not_available(err: text) -> bool:
    err.contains("unavailable") or err.contains("vulkan_init")

fn _err_is_no_device(err: text) -> bool:
    err.contains("no Vulkan devices") or err.contains("select_device")

fn vulkan_classify_error(err: text) -> VulkanErrorKind:
    """Classify a Vulkan error string into a VulkanErrorKind variant.

    Uses substring matching against known error prefixes emitted by the
    Simple Vulkan SFFI layer.  Returns VulkanErrorKind.None when err is "".
    """
    if err == "":
        VulkanErrorKind.None
    elif _err_is_device_lost(err):
        VulkanErrorKind.DeviceLost
    elif _err_is_missing_ext(err):
        VulkanErrorKind.MissingExtension
    elif _err_is_shader_compile(err):
        VulkanErrorKind.ShaderCompile
    elif _err_is_not_available(err):
        VulkanErrorKind.NotAvailable
    elif _err_is_no_device(err):
        VulkanErrorKind.NoDevice
    else:
        VulkanErrorKind.Other

fn _vulkan_scaled_image_args_valid(dst_x: i32, dst_y: i32, dst_w: i32, dst_h: i32, src_w: i32, src_h: i32, pixels: [u32]) -> bool:
    val source_pixel_count = _i64(src_w) * _i64(src_h)
    val destination_pixel_count = _i64(dst_w) * _i64(dst_h)
    val right = _i64(dst_x) + _i64(dst_w)
    val bottom = _i64(dst_y) + _i64(dst_h)
    (dst_w > 0 and dst_h > 0 and src_w > 0 and src_h > 0 and
        source_pixel_count > 0 and source_pixel_count <= 4294967295 and pixels.len().to_i64() == source_pixel_count and
        destination_pixel_count > 0 and destination_pixel_count <= 2147483647 and
        (_i64(dst_w) - 1) * _i64(src_w) <= 2147483647 and
        (_i64(dst_h) - 1) * _i64(src_h) <= 2147483647 and
        right - 1 <= 2147483647 and bottom - 1 <= 2147483647)

# ============================================================================
# Vulkan Backend
# ============================================================================

# One parked host byte mirror of a font atlas, keyed on the atlas OWNER identity
# (the font face) and the atlas generation those bytes incorporate. Nothing here
# is device state: the bytes are a copy of `batch.atlas_pixels`, so a parked slot
# stays valid across device buffer rewrites and is invalidated only by a
# generation gap, which the incremental repack already requires to be exactly +1.
class VulkanFontAtlasMirror:
    identity: text
    generation: i64
    # This owner's own atlas sequence as of `bytes`. The GLOBAL `generation` is
    # bumped by every owner, so it cannot express continuity across an
    # interleave; `owner_sequence` advances by exactly 1 per dirty batch for
    # THIS owner and is what the incremental path tests. -1 = the producer
    # published none and the global +1 rule applies instead.
    owner_sequence: i64 = -1
    bytes: [u8]

val VULKAN_FONT_ATLAS_MIRROR_MAX: i32 = 4

class VulkanBackend:
    """Vulkan compute shader 2D renderer.

    Architecture:
    - Framebuffer lives in a Vulkan storage buffer (d_framebuffer)
    - Each draw call dispatches a compute shader
    - present() copies GPU storage buffer to host buffer
    - Host buffer is returned by read_pixels()

    Kernel dispatch: Each primitive (rect, circle, line) has a dedicated
    compute shader. Workgroup sizes are chosen to cover the bounding box
    of the primitive being drawn.
    """

    host_buf: [u32]
    w: i32
    h: i32
    d_framebuffer: i64          # Vulkan storage buffer handle
    # Shader module handles
    shader_clear: i64
    shader_rect_filled: i64
    shader_rect_outline: i64
    shader_circle_filled: i64
    shader_circle_outline: i64
    shader_line: i64
    shader_rounded_rect: i64
    shader_triangle: i64
    shader_gradient: i64
    shader_blit: i64
    # Pipeline handles
    pipe_clear: i64
    pipe_rect_filled: i64
    pipe_rect_outline: i64
    pipe_circle_filled: i64
    pipe_circle_outline: i64
    pipe_line: i64
    pipe_rounded_rect: i64
    pipe_triangle: i64
    pipe_gradient: i64
    pipe_blit: i64
    # Batched-rect lane: ONE dispatch for N rects, rect list in a GPU buffer.
    # The session owns the pipeline; the surface owns the per-frame rect-list
    # buffers, because they must stay alive until the frame fence retires.
    pipe_rect_batch: i64
    rect_batch_error: text
    # Slot pool, one slot per batch recorded in the current frame. A slot may
    # NOT be reused inside a frame: `copy_to_buffer` writes at RECORD time but
    # the dispatch reads at SUBMIT time, so overwriting slot 0 for a second
    # batch would silently repaint the first batch's dispatch with the second
    # batch's rects. `rect_batch_slot` is the next free slot and resets only
    # when the pending command is cleared (i.e. after the fence).
    rect_batch_buffers: [i64]
    rect_batch_capacities: [i64]
    rect_batch_descriptors: [i64]
    rect_batch_slot: i64
    # Dispatches recorded into the current frame's command buffer, counted so
    # the bench can assert one dispatch per batched frame rather than N.
    # SCOPE, stated so a reader does not over-trust it: this counts the
    # FRAMEBUFFER compute lanes only -- `_enqueue_framebuffer_compute` (clear,
    # rect, line, circle, ...) and `_enqueue_rect_batch*`. Image composites and
    # font dispatches are NOT counted; it is a rect-lane discriminator, not a
    # total device-command census.
    frame_dispatch_count: i64
    # Dispatch count of the last flushed frame, so a caller can read it after
    # end_frame without racing the live counter.
    last_frame_dispatch_count: i64
    # Per-surface font composite storage; the session owns the pipeline.
    d_font_atlas: i64
    d_font_params: i64
    font_atlas_generation: i64
    font_atlas_owner_identity: text
    font_atlas_payload_sha256: text
    # Host byte mirror of the device font atlas, kept so a dirty batch repacks
    # only the glyph cells it actually inserted instead of all 1,048,576 atlas
    # pixels. `font_atlas_host_valid` is cleared at the START of every upload
    # and set again only once that upload has SUCCEEDED, so a composite that
    # returns early (glyph cap, invalid quad, failed upload) leaves the mirror
    # stale and forces the next one to repack in full -- which is what makes
    # the incremental path sound without assuming batches arrive unbroken.
    font_atlas_host_bytes: [u8]
    font_atlas_host_identity: text
    font_atlas_host_valid: bool
    # Parked mirrors for atlas owners that are not currently active. Two font
    # identities on one page used to evict each other's mirror on every switch,
    # so BOTH paid a full 1,048,576-pixel repack per batch (measured: every
    # owner switch was a `pack_full`). Parking the outgoing owner's bytes and
    # swapping the incoming owner's back in makes an alternating A,B,A,B page
    # repack only its dirty cells. Bounded LRU: index 0 is the least recently
    # used and is evicted first.
    font_atlas_mirror_slots: [VulkanFontAtlasMirror]
    # The atlas generation the mirror actually incorporated. Generations come
    # from ONE global counter bumped once per dirty batch, so `batch
    # .atlas_generation == font_atlas_host_generation + 1` proves no other dirty
    # batch slipped between this one and the mirror's last update -- including
    # batches this backend never saw at all, which no flag inside the composite
    # can observe. Any gap forces a full repack, which is always safe.
    font_atlas_host_generation: i64
    # The per-owner atlas sequence the mirror bytes incorporate; parked and
    # restored with them. -1 = unknown / producer publishes none.
    font_atlas_host_owner_sequence: i64 = -1
    # PER-OWNER DEVICE ATLAS SLOTS (F32).
    #
    # There used to be exactly ONE device atlas buffer (`d_font_atlas`). Every
    # font run whose atlas content moved therefore had to flush the pending
    # command buffer before its host write, because the dispatches already
    # recorded in that command buffer read the very bytes the write was about
    # to replace -- a genuine read-after-write hazard. With one buffer the
    # cheapest honest cap was `1 + font runs`, and the catalog page measured 17
    # submits / 17 fence waits per frame against an invariant of 1.
    #
    # A round-robin ring does not fix this (run 3 finds both slots referenced
    # and flushes anyway, landing at ~runs/2). What fixes it is keying the slot
    # on the ATLAS OWNER and exploiting the two facts F16/F24 already
    # established:
    #   * an owner whose parked atlas is restored unchanged (`ALREADY_TRUTH`)
    #     needs NO device write at all -- its slot still holds exactly those
    #     bytes -- so an alternating A,B,A,B page costs zero uploads and zero
    #     flushes after the first pass over each owner;
    #   * an `INCREMENTAL` batch writes only cells this batch inserted. Every
    #     cell an already-recorded dispatch reads keeps byte-identical content,
    #     so the write is not a hazard and needs no flush either.
    # A flush is then required only for a FULL repack (cells may have moved)
    # into a slot a recorded dispatch still references, and only when no
    # unreferenced slot is free to take the write instead.
    #
    # Parallel arrays rather than a struct array: the tables are tiny (bounded
    # by VULKAN_FONT_ATLAS_SLOT_MAX) and every other pooled resource in this
    # backend is already shaped this way.
    font_atlas_slot_handles: [i64]
    font_atlas_slot_owners: [text]
    # The owner's published `atlas_owner_sequence` the slot's bytes incorporate.
    # -1 = unknown (producer publishes none), which never matches and so always
    # forces a write -- fail-closed.
    font_atlas_slot_sequences: [i64]
    # Bound by a dispatch recorded into the CURRENT, not-yet-submitted command
    # buffer. Cleared wholesale by `_clear_pending_compute_state`, which runs at
    # the end of every flush path including the failure ones.
    font_atlas_slot_referenced: [bool]
    # Index into the tables above of the slot `d_font_atlas` currently aliases.
    # -1 = none bound yet.
    font_atlas_active_slot: i64 = -1
    # Counters, for the audit gate and the bug record. `hits` are runs that
    # needed no device write at all; `inplace` are writes that skipped a flush
    # because they were incremental; `forced` are the flushes that genuinely
    # remained.
    font_atlas_slot_hits: i64
    font_atlas_slot_inplace_writes: i64
    font_atlas_slot_forced_flushes: i64
    font_atlas_width: i32
    font_atlas_height: i32
    font_atlas_upload_count: i64
    font_atlas_upload_bytes: i64
    font_gpu_resource_high_water_bytes: i64
    font_oracle_mode: bool
    # Mask buffer storage
    mask_buf: [u8]
    mask_w: i32
    mask_h: i32
    # Clipping state
    clip_x: i32
    clip_y: i32
    clip_w: i32
    clip_h: i32
    clip_enabled: bool
    initialized: bool
    dirty: bool                  # True when GPU has changes not yet copied to host
    present_damage_rects: [i64]  # Validated flat x,y,w,h tuples owned by this backend
    present_damage_valid: bool
    host_mirror_valid: bool
    # Live per-frame damage union, accumulated by the draw calls themselves.
    # `frame_damage_full` is the FAIL-SAFE state: any device dispatch whose
    # destination rectangle this backend cannot name marks the whole surface
    # damaged, so an unhinted primitive can never produce a stale mirror.
    # x1/y1 are EXCLUSIVE. See doc/08_tracking/bug/
    # vulkan_damage_path_dead_interpreted_copy_2026-09-12.md.
    frame_damage_valid: bool
    frame_damage_full: bool
    frame_damage_x0: i64
    frame_damage_y0: i64
    frame_damage_x1: i64
    frame_damage_y1: i64
    # Destination hint published by a draw call immediately before it dispatches;
    # consumed (and cleared) by the dispatch funnel. Absent hint => full damage.
    pending_damage_hint: bool
    pending_damage_hx: i64
    pending_damage_hy: i64
    pending_damage_hw: i64
    pending_damage_hh: i64
    # Evidence counters: pixels in the damage union actually re-downloaded, and
    # interpreted element writes spent patching the host mirror this frame.
    damage_rect_px: i64
    mirror_copy_iterations: i64
    # What the readback that seeded the mirror actually transferred, carried
    # across to present()'s dedup arm (which zeroes present_readback_bytes on
    # entry) so the receipt describes the real download, not a nominal one.
    readback_frame_bytes: i64
    readback_frame_rects: i64
    # True when host_buf already holds THIS frame's device surface, so present()
    # must not download the whole framebuffer a second time. Set by the readback
    # that performed the download, cleared by every `dirty = true`. See
    # doc/08_tracking/bug/
    # vulkan_readback_interpreted_unpack_dominates_frame_2026-09-12.md.
    host_mirror_frame_fresh: bool
    last_host_checksum: i64  # checksum of the last host_buf refresh (same algorithm as engine2d_readback_with_identity)
    present_readback_bytes: i64
    present_readback_rect_count: i64
    present_full_readback_count: i64
    present_noop_count: i64
    device_finalize_no_readback_count: i64
    presentation_swapchain: i64
    presentation_mode: text
    device_content_revision: i64
    frame_index: i64
    frame_dirty_rect_count: i64
    frame_device_to_present_bytes: i64
    frame_device_to_present_rect_count: i64
    frame_readback_requested: bool
    frame_readback_completed: bool
    frame_present_attempted: bool
    frame_present_completed: bool
    frame_present_mode: text
    frame_host_cache_refresh_completed: bool
    frame_full_fallback: bool
    frame_fallback_reason: text
    frame_device_present: bool
    frame_batching_enabled: bool
    pending_compute_command: i64
    pending_compute_pipelines: [i64]   # block-grown slot table; entries [0, pending_compute_count) are live
    pending_compute_descriptors: [i64] # parallel to pipelines
    pending_compute_sources: [i64]     # image source buffer per slot; zero for framebuffer-only work
    pending_compute_count: i64         # live entries in the two arrays above
    # Batched image composites retain their source buffers until the frame
    # fence.  Reuse completed per-surface buffers instead of allocating and
    # freeing one Vulkan storage buffer for every web image draw.
    image_source_pool: [i64]
    image_source_pool_capacity: [i64]
    image_source_pool_device_identity: i64
    image_source_pool_session_generation: i64
    image_source_pool_surface_identity: i64
    image_source_pool_reuse_count: i64
    image_source_pool_allocation_count: i64
    image_source_pool_replacement_count: i64
    image_source_upload_count: i64
    image_source_upload_bytes: i64
    # Reusable host staging for source-image marshalling. Native ABI lanes may
    # upload a bounded prefix; interpreter lanes use the exact-size fallback.
    image_upload_scratch: [u8]
    image_upload_scratch_reuse_count: i64
    image_upload_scratch_resize_count: i64
    image_upload_scratch_fallback_count: i64
    pending_font_descriptors: [i64]
    pending_font_params: [i64]
    pending_font_glyph_count: i64
    image_descriptor_pool: [i64] # warm frame-reusable image-composite descriptors
    # Host-side coverage atlas for the built-in face, memoised on the SAME
    # identity the device-side generation cache keys on (scale + glyph height).
    font_atlas_cpu_scale: i64
    font_atlas_cpu_glyph_height: i64
    font_atlas_cpu_pixels: [u32]
    font_atlas_cpu_build_count: i64   # host coverage-atlas rasters actually performed
    # Attribution for every mid-frame flush: the LAST caller site tag, printed
    # by the `[vk-order] flush` trace. Without it `submits_per_frame=17` names a
    # count and no cause, and the wrong file gets edited.
    last_flush_site: text
    pending_flush_site: text
    image_source_pool_key: [i64]      # parallel to `image_source_pool`; producer
                                      # identity+generation key, 0 = unkeyed slot
    pending_image_key: i64            # one-shot key for the NEXT image composite
    image_source_key_hit_count: i64   # uploads skipped because the key matched
    midframe_flush_count: i64         # CUMULATIVE `_flush_pending_compute` calls since
                                      # create/shutdown — NOT reset per frame. One frame that
                                      # ends in a single finalize contributes exactly 1.
    font_descriptor_pool: [i64] # warm frame-reusable glyph descriptors
    font_params_pool: [i64]     # parallel 52-byte parameter buffers
    font_params_pool_capacity: [i64]
    font_frame_command_count: i64
    font_frame_submission_count: i64
    font_frame_fence_count: i64
    observed_device_submit_count: i64
    observed_device_fence_count: i64
    cpu_fallback_used: bool      # Sticky conservative provenance for this backend lifetime
    cpu_fallback_reason: text    # First transition reason; empty while device-only
    completion_unknown: bool    # True when dependent Vulkan work may still be in flight
    session: VulkanSession       # Shared session (null-like when not session-owned)
    owns_session: bool           # True when this backend must release the session
    last_error: text             # Most recent init/runtime failure for strict probes
    # Text-lane provenance. A SEPARATE axis from the readback provenance
    # (`readback_source`: completion_unknown / readback_failed / cpu_fallback /
    # device_readback / host_cache_after_device_copy) — this says which lane the
    # last text draw took, not where its pixels were read back from. Values:
    # "font-atlas-batch" (the GPU atlas composited it), "cpu-raster-blit" (the
    # CPU rasteriser + image upload did), "font-atlas-batch-abandoned" (the atlas
    # attempt failed after work may already have been recorded, so nothing was
    # redrawn). Empty until the first text draw.
    last_text_path: text
    # Why the atlas lane was not used, or the composite evidence reason when it
    # was attempted and did not complete. Empty exactly when last_text_path is
    # "font-atlas-batch".
    last_text_fallback_reason: text

