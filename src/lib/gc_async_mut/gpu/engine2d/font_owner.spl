use std.gc_async_mut.text_layout.font_renderer.{FontRenderer}

# Owns Engine2D's optional renderer without relying on native flow narrowing
# to restore a concrete receiver after an Option comparison.
class Engine2DFontOwner:
    active: FontRenderer?

    static fn new() -> Engine2DFontOwner:
        Engine2DFontOwner(active: nil)

fn engine2d_font_owner_get_or_create(mut owner: Engine2DFontOwner) -> FontRenderer:
    match owner.active:
        case Some(renderer):
            return renderer
        case None:
            pass_do_nothing("create the renderer below on cache miss")
    val created = FontRenderer.new()
    owner.active = Some(created)
    created

fn engine2d_font_owner_store(mut owner: Engine2DFontOwner, renderer: FontRenderer) -> Engine2DFontOwner:
    owner.active = Some(renderer)
    owner

fn engine2d_font_owner_current(owner: Engine2DFontOwner) -> FontRenderer?:
    owner.active

fn engine2d_font_owner_clear(mut owner: Engine2DFontOwner) -> Engine2DFontOwner:
    match owner.active:
        case Some(renderer):
            renderer.clear_ttf()
        case None:
            pass_do_nothing("no selected renderer to clear")
    owner.active = nil
    owner
