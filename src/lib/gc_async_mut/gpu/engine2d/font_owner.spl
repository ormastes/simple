use std.gc_async_mut.text_layout.font_renderer.{FontRenderer}

# Owns Engine2D's optional renderer without relying on native flow narrowing
# to restore a concrete receiver after an Option comparison.
#
# One-slot list instead of `FontRenderer?`: an Option-wrapped aggregate
# crossing a function boundary (the old match-the-Option-and-return-the-
# payload shape) is the deterministic payload-loss defect on the
# freestanding native lane (probes/cranelift_aggregate_return_min.spl
# probe 3; doc/08_tracking/bug/
# cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md),
# and `.?` field unwrap is its own baremetal fault class (2026-07-18,
# cr2=0x0). Array-element access is a proven-safe channel.
class Engine2DFontOwner:
    active: [FontRenderer]

    static fn new() -> Engine2DFontOwner:
        Engine2DFontOwner(active: [])

fn engine2d_font_owner_has(owner: Engine2DFontOwner) -> bool:
    owner.active.len() > 0

fn engine2d_font_owner_get_or_create(mut owner: Engine2DFontOwner) -> FontRenderer:
    if owner.active.len() == 0:
        owner.active = [FontRenderer.new()]
    owner.active[0]

fn engine2d_font_owner_store(mut owner: Engine2DFontOwner, renderer: FontRenderer) -> Engine2DFontOwner:
    owner.active = [renderer]
    owner

fn engine2d_font_owner_clear(mut owner: Engine2DFontOwner) -> Engine2DFontOwner:
    if owner.active.len() > 0:
        owner.active[0].clear_ttf()
    owner.active = []
    owner

fn engine2d_font_owner_measure_advances(mut owner: Engine2DFontOwner, content: text, font_size: i32) -> [i32]:
    """Measure per-codepoint advances using FontRenderer's cumulative milli-px
    pen + kerning pipeline so Engine2D stays aligned with Skia/browser layout."""
    var renderer = engine2d_font_owner_get_or_create(owner)
    val advs = renderer.measure_text_advances(content, font_size)
    owner.active = [renderer]
    advs

fn engine2d_font_owner_measure_width_milli(mut owner: Engine2DFontOwner, content: text, font_size: i32) -> i64:
    """Measure exact unrounded total run width in milli-px via FontRenderer."""
    var renderer = engine2d_font_owner_get_or_create(owner)
    val w_milli = renderer.measure_text_width_milli(content, font_size)
    owner.active = [renderer]
    w_milli

fn engine2d_font_owner_measure_width_size_milli(mut owner: Engine2DFontOwner, content: text, size_milli: i64, bold: bool = false) -> i64:
    """Measure exact fractional-size run width in milli-px via FontRenderer."""
    var renderer = engine2d_font_owner_get_or_create(owner)
    val w_milli = renderer.measure_text_width_size_milli(content, size_milli, bold)
    owner.active = [renderer]
    w_milli

fn engine2d_font_owner_render_text_baseline_styled(mut owner: Engine2DFontOwner, buffer: [u32], buf_w: i32, buf_h: i32, x_px: f64, baseline_y: f64, content: text, color: u32, font_size_px: f64, bold: bool, italic: bool) -> [u32]:
    """Render baseline-aligned styled text through FontRenderer with quarter-pixel phases and kerning."""
    var renderer = engine2d_font_owner_get_or_create(owner)
    val out = renderer.render_text_baseline_styled(buffer, buf_w, buf_h, x_px, baseline_y, content, color, font_size_px, bold, italic)
    owner.active = [renderer]
    out
