# Owner-bound Engine2D capture of the admitted corpus case 02 projection.

use std.gc_async_mut.gpu.engine2d.final_output_capture.{
    Engine2dStrictVulkanCapturedFrame}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_selected_device_identity_v1,
    vulkan_sffi_selected_device_type}
use std.gc_async_mut.gpu.browser_engine.web_opaque_box_qualification.{
    WebOpaqueBoxGpuScene}
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow,
    file_hash_sha256}
use std.common.crypto.sha256.{sha256_text}
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU, DRAW_IR_BACKEND_GPU,
    DRAW_IR_SCHEMA_VERSION_V4}
use common.ui.draw_ir_sdn.{draw_ir_to_sdn}
use common.renderdoc.corpus_case02_polygon_oracle.{
    CORPUS_CASE02_FIXTURE_ID, CORPUS_CASE02_SOURCE_PATH,
    CORPUS_CASE02_SOURCE_SHA256, CORPUS_CASE02_WIDTH,
    CORPUS_CASE02_HEIGHT, case02_capture_matches_oracle}
use common.renderdoc.final_output_pixels.{final_output_validate}
use common.renderdoc.physical_vulkan_2d_qualification.{
    PreparedRenderScene, VulkanBackendCaptureArtifact}

fn _engine2d_case02_uuid_valid(value: text) -> bool:
    if value.len() != 32 or value == "00000000000000000000000000000000":
        return false
    var index = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if not ((code >= 48 and code <= 57) or
            (code >= 97 and code <= 102)):
            return false
        index = index + 1
    true

fn _engine2d_case02_web_projection_valid(web: WebOpaqueBoxGpuScene) -> bool:
    if web.source_draw_ir_sha256.len() != 64 or
        web.gpu_draw_ir_sha256.len() != 64 or
        web.source_draw_ir_sha256 != sha256_text(draw_ir_to_sdn(web.source_draw_ir)) or
        web.gpu_draw_ir_sha256 != sha256_text(draw_ir_to_sdn(web.gpu_draw_ir)) or
        web.source_command_count != 6 or web.gpu_command_count != 6 or
        web.source_command_indexes.len() != 6 or
        web.source_draw_ir.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        web.gpu_draw_ir.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        web.source_draw_ir.backend_target != DRAW_IR_BACKEND_CPU or
        web.gpu_draw_ir.backend_target != DRAW_IR_BACKEND_GPU or
        web.source_draw_ir.batches.len() != 1 or
        web.gpu_draw_ir.batches.len() != 1:
        return false
    val source = web.source_draw_ir.batches[0]
    val gpu = web.gpu_draw_ir.batches[0]
    if source.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        gpu.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        source.commands.len() != 6 or gpu.commands.len() != 6 or
        source.embedding.width != CORPUS_CASE02_WIDTH or
        source.embedding.height != CORPUS_CASE02_HEIGHT or
        gpu.embedding.width != CORPUS_CASE02_WIDTH or
        gpu.embedding.height != CORPUS_CASE02_HEIGHT:
        return false
    var index = 0
    while index < 6:  # cpu-lane-loop-ok: fixed six-command case 02 mapping check
        if web.source_command_indexes[index] != index.to_i64() or
            gpu.commands[index].component_id != source.commands[index].component_id or
            gpu.commands[index].color != source.commands[index].color:
            return false
        index = index + 1
    true

pub fn engine2d_corpus_case02_artifact(
    captured: Engine2dStrictVulkanCapturedFrame,
    scene: PreparedRenderScene,
    web: WebOpaqueBoxGpuScene
) -> Result<VulkanBackendCaptureArtifact, text>:
    if scene.fixture_id != CORPUS_CASE02_FIXTURE_ID or
        scene.source_path != CORPUS_CASE02_SOURCE_PATH or
        scene.source_sha256 != CORPUS_CASE02_SOURCE_SHA256 or
        scene.scene_scope != "corpus-case02-fractional-edges-only" or
        scene.render_degraded or scene.degrade_reason != "" or
        web.html_sha256 != scene.source_sha256 or
        not _engine2d_case02_web_projection_valid(web) or
        not file_is_regular_no_follow(CORPUS_CASE02_SOURCE_PATH) or
        file_hash_sha256(CORPUS_CASE02_SOURCE_PATH) !=
            CORPUS_CASE02_SOURCE_SHA256:
        return Err("Engine2D corpus case 02 source admission invalid")
    val pixels = captured.capture
    if pixels.metadata.fixture_id != scene.fixture_id or
        pixels.metadata.fixture_digest != scene.source_sha256 or
        pixels.metadata.device_status != "ready" or
        pixels.metadata.width != CORPUS_CASE02_WIDTH.to_i64() or
        pixels.metadata.height != CORPUS_CASE02_HEIGHT.to_i64() or
        pixels.metadata.crop_x != 0 or pixels.metadata.crop_y != 0 or
        pixels.metadata.crop_width != CORPUS_CASE02_WIDTH.to_i64() or
        pixels.metadata.crop_height != CORPUS_CASE02_HEIGHT.to_i64():
        return Err("Engine2D corpus case 02 capture domain mismatch")
    val expected_resource = "engine2d-vulkan-framebuffer-{captured.backend_handle}"
    val expected_completion = "{captured.device_identity}:{captured.submission_generation}"
    if pixels.metadata.resource_id != expected_resource or
        pixels.metadata.submission_token != expected_completion or
        pixels.metadata.completion_token != expected_completion:
        return Err("Engine2D corpus case 02 capture owner mismatch")
    match final_output_validate(pixels):
        case Err(err): return Err("Engine2D corpus case 02 capture invalid: " + err.code)
        case Ok(_): ()
    val oracle_verdict = case02_capture_matches_oracle(pixels)?
    if not oracle_verdict.passed:
        return Err("Engine2D corpus case 02 edge oracle mismatch")
    if captured.engine.backend_name() != "vulkan" or
        captured.device_identity <= 0 or captured.backend_handle <= 0 or
        captured.submission_generation <= 0 or captured.submit_count <= 0 or
        captured.fence_count <= 0 or captured.readback_source != "device_readback" or
        not (captured.device_type == "discrete" or
             captured.device_type == "integrated") or
        captured.device_name == "" or captured.driver_identity == "" or
        not _engine2d_case02_uuid_valid(captured.device_uuid) or
        not _engine2d_case02_uuid_valid(captured.driver_uuid):
        return Err("Engine2D corpus case 02 physical Vulkan owner incomplete")
    if captured.engine.vulkan_submission_generation() != captured.submission_generation or
        captured.engine.vulkan_device_identity() != captured.device_identity or
        captured.engine.vulkan_device_name() != captured.device_name or
        captured.engine.vulkan_device_type() != captured.device_type or
        captured.engine.vulkan_driver_identity() != captured.driver_identity:
        return Err("Engine2D corpus case 02 physical Vulkan owner changed")
    if val Some(frame) = captured.engine.latest_vulkan_frame_receipt():
        if not frame.completion_known or frame.cpu_fallback_used or
            frame.backend_handle != captured.backend_handle or
            frame.device_identity != captured.device_identity or
            frame.device_fence_count != captured.submission_generation or
            frame.device_submit_count < captured.submit_count or
            frame.device_fence_count < captured.fence_count or
            frame.framebuffer_width.to_i64() != pixels.metadata.width or
            frame.framebuffer_height.to_i64() != pixels.metadata.height:
            return Err("Engine2D corpus case 02 frame receipt changed")
    else:
        return Err("Engine2D corpus case 02 frame receipt absent")
    val identity = vulkan_sffi_selected_device_identity_v1(
        captured.device_identity)?
    if identity.device_uuid != captured.device_uuid or
        identity.driver_uuid != captured.driver_uuid or
        vulkan_sffi_selected_device_type() != captured.device_type or
        captured.engine.vulkan_submission_generation() != captured.submission_generation:
        return Err("Engine2D corpus case 02 selected device changed")
    Ok(VulkanBackendCaptureArtifact(
        backend_id: "engine2d-vulkan", fixture_id: scene.fixture_id,
        fixture_sha256: scene.source_sha256,
        producer_authenticated: true, provider_identity: 0,
        device_name: captured.device_name, device_type: captured.device_type,
        driver_identity: captured.driver_identity,
        physical_device_uuid: captured.device_uuid,
        driver_uuid: captured.driver_uuid,
        device_identity: captured.device_identity,
        backend_handle: captured.backend_handle,
        submit_count: captured.submit_count, fence_count: captured.fence_count,
        readback_source: captured.readback_source, fallback_required: false,
        capture: Some(pixels)))
