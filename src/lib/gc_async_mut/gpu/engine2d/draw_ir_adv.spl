# Engine2D advanced Draw IR executor.
#
# This is the first Simple2D-facing Draw IR boundary. It executes the shared
# Draw IR contract through the existing Engine2D facade and keeps GPU selection
# as metadata/fallback policy; real GPU plugin migration is a later backend job.

use std.gc_async_mut.gpu.engine2d.draw_ir_env_target.{draw_ir_env_get}
use std.common.ui.draw_ir.{
    DRAW_IR_COMMAND_IMAGE,
    DRAW_IR_COMMAND_RECT,
    DRAW_IR_COMMAND_TEXT,
    DRAW_IR_BACKEND_GPU,
    DrawIrBatch,
    DrawIrCommand,
    DrawIrComposition,
    DrawIrRect,
    DrawIrEmbeddingConfig,
    DrawIrStyleProp,
    Simple2dDrawIrCompositionPlan,
    Simple2dDrawIrPlan,
    draw_ir_rect_intersection,
    draw_ir_no_rect,
    draw_ir_rect_bounds,
    draw_ir_rect_translate,
    simple_2d_draw_ir_adv_composition_plan,
    simple_2d_draw_ir_adv_plan
}
use std.gc_async_mut.gpu.engine2d.engine_target.{Engine2D, DrawIrTargetFontEvidence, engine2d_target_draw_ir_blit_image_prepared_opaque_status, engine2d_target_replay_prepared_scanout_status, engine2d_target_capture_prepared_scanout_status}
use std.gc_async_mut.gpu.engine2d.backend.{Engine2DReadback, engine2d_readback, engine2d_readback_with_identity}
extern fn rt_time_now_micros() -> i64
use std.nogc_sync_mut.text_layout.font_types.{FontRenderBatch}
use std.gc_async_mut.gpu.engine2d.draw_ir_glass_material.{
    Engine2dGlassExecutionResult,
    Engine2dGlassMaterialConfig,
    engine2d_glass_execution_cpu,
    engine2d_glass_execution_unavailable,
    engine2d_draw_ir_glass_material_pixels
}
use std.common.gpu.font_atlas_composite.{font_atlas_subrect_pixels, font_destination_origin}
use std.gc_async_mut.gpu.engine2d.draw_ir_box_effects.{
    Engine2dDrawIrCornerRadii,
    engine2d_draw_ir_has_inset_shadow,
    engine2d_draw_ir_legacy_shadow_safe,
    engine2d_draw_ir_legacy_uniform_radius,
    engine2d_draw_ir_mask_geometry_safe,
    engine2d_draw_ir_render_legacy_shadow,
    engine2d_draw_ir_render_typed_background,
