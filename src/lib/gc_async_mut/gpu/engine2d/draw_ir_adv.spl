}

fn _engine2d_draw_ir_trace_font_style_enabled() -> bool:
    draw_ir_env_get("SIMPLE_TRACE_FONT_STYLE") != nil

# Level-gated serial probe for TEXT command dispatch (shaped/resolved/plain
# branch selection) — doc/08_tracking/bug/native_char_code_at_tag_shift_2026-07-19.md
# investigation. Flip to false to silence at land time. Capped to the first 8
# TEXT commands so a busy desktop frame can't flood serial.
val _E2D_TEXT_PROBE: bool = false
var _e2d_text_probe_count: i32 = 0
val _E2D_MATERIAL_TRACE: bool = false
var _e2d_material_bounds_rejection_logged: bool = false
var _e2d_wm_batch_profile_emitted: bool = false
var _e2d_wm_prepared_batch_profile_emitted: bool = false
var _e2d_wm_command_profile_active: bool = false
var _e2d_exact_image_probe_count: i32 = 0
var _e2d_prepared_image_xy: [i64] = []
var _e2d_prepared_image_xy_active: bool = false
var _e2d_prepared_image_xy_profiled: bool = false
var _e2d_owner_image_xy_active: bool = false
var _e2d_owner_image_x0: i64 = 0
var _e2d_owner_image_y0: i64 = 0
var _e2d_owner_image_x1: i64 = 0
var _e2d_owner_image_y1: i64 = 0
var _e2d_owner_image_x2: i64 = 0
var _e2d_owner_image_y2: i64 = 0
var _e2d_retained_readback_pixels: [u32] = []
var _e2d_command_owner_readback_pixels: [u32] = []
var _e2d_command_owner_probe_count: i32 = 0
var _e2d_box_owner_probe_count: i32 = 0

fn engine2d_draw_ir_adv_retained_readback_pixels(expected_count: i32) -> [u32]:
    if expected_count <= 0 or _e2d_retained_readback_pixels.len() != expected_count:
        return []
    _e2d_retained_readback_pixels

fn engine2d_draw_ir_adv_set_owner_image_xy(x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64):
    _e2d_owner_image_x0 = x0
    _e2d_owner_image_y0 = y0
    _e2d_owner_image_x1 = x1
    _e2d_owner_image_y1 = y1
    _e2d_owner_image_x2 = x2
    _e2d_owner_image_y2 = y2
    _e2d_owner_image_xy_active = true

fn engine2d_draw_ir_adv_clear_owner_image_xy():
    _e2d_owner_image_xy_active = false

fn engine2d_draw_ir_adv_present_owner_image(engine: Engine2D, x: i64, y: i64, width: i32, height: i32, pixels: [u32]) -> i32:
    """Execute one admitted Draw IR image with scalar owner coordinates."""
    if x < 0 or y < 0 or x > 2147483647 or y > 2147483647:
        return 0
    engine2d_target_draw_ir_blit_image_prepared_opaque_status(
        engine, x.to_i32(), y.to_i32(), width, height, pixels)
var _e2d_image_lookup_failure_profiled: bool = false
val _E2D_DRAW_IR_MAX_TEXT_ITEMS: i64 = 4096
val _E2D_DRAW_IR_MAX_STYLE_VALUE_BYTES: i64 = 65536
val _E2D_DRAW_IR_MAX_FONT_SIZE: i32 = 512

# A concrete Metal WM material request is not fulfilled by an aggregate
# counter. Each material owns the device framebuffer tuple that executed it so
# the compositor can reject a frame whose first (or any later) receipt was
# produced on a different surface.
struct Engine2dMetalGlassReceipt:
    material_id: text
    fulfilled: bool
    execution_target: text
    backend_handle: i64
    device_identity: i64
    readback_source: text
    readback_checksum: i64

class Engine2dDrawIrAdvResult:
    schema: text
    unit_id: text
    selected_backend: text
    fallback_required: bool
    fallback_reason: text
    rendered_command_count: i32
    skipped_command_count: i32
    pixels: [u32]
    readback_source: text
    backend_handle: i64
    device_identity: i64
    readback_checksum: i64
    cpu_composited_material_count: i32 = 0
    # Post-execution font evidence copied from the Engine2D/FontRenderer and,
    # for Vulkan, its completed FontRenderBatch device receipt. Transient
    # atlas/cache payloads remain owned by Engine2D and never enter Draw IR.
    font_identity: text = ""
    font_execution_target: text = ""
    font_batch_identity: text = ""
    font_readback_source: text = ""
    font_device_checksum: i64 = 0
    font_oracle_checksum: i64 = 0
    font_readback_nonblank_pixels: i64 = 0
    font_parity: bool = false
    font_device_executed: bool = false
    font_promotion_ready: bool = false
    font_atlas_upload_count: i64 = 0
    font_atlas_upload_bytes: i64 = 0
    font_atlas_payload_sha256: text = ""
    # Appended to preserve all existing result-field offsets.
    metal_device_glass_material_count: i32 = 0
    # A concrete Metal WM composition may not silently lose a requested
    # material dispatch. Keep requested and unfulfilled receipts distinct so
    # the hosted compositor can reject a frame instead of inferring success
    # from the planner's target alone.
    metal_device_glass_requested_count: i32 = 0
    metal_device_glass_unfulfilled_count: i32 = 0
    metal_device_glass_receipts: [Engine2dMetalGlassReceipt] = []
    glass_execution_target: text = ""
    glass_backend_handle: i64 = 0
    glass_device_identity: i64 = 0

class Engine2dDrawIrTransport:
    destination: [u32]
    status: [i32]
    evidence_i64: [i64]
    evidence_text: [text]

struct Engine2dResolvedDrawIrImage:
    image_uri: text
    width: i32
    height: i32
    pixels: [u32]
    opaque: bool

struct Engine2dCssBackgroundPixels:
    valid: bool
    pixels: [u32]

struct Engine2dCssBackgroundMetadata:
    valid: bool
    repeat: text
    tile_x: i64
    tile_y: i64
    tile_width: i64
    tile_height: i64
    shape_x: i64
    shape_y: i64
    shape_width: i64
    shape_height: i64
    radius_tl_x: i64
    radius_tl_y: i64
    radius_tr_x: i64
    radius_tr_y: i64
    radius_br_x: i64
    radius_br_y: i64
    radius_bl_x: i64
    radius_bl_y: i64

# Named result for the internal render walkers. Positional tuple-member reads
# are miscompiled on the entry-closure freestanding native path; named fields
# preserve rendered/skipped counts on every backend.
class Engine2dDrawIrRenderOutcome:
    engine: Engine2D
    rendered: i32
    skipped: i32
    unsupported_kinds: text
    cpu_composited_material_count: i32
    metal_device_glass_material_count: i32
    metal_device_glass_requested_count: i32
    metal_device_glass_unfulfilled_count: i32
    metal_device_glass_receipts: [Engine2dMetalGlassReceipt]
    glass_execution_target: text
    glass_backend_handle: i64
    glass_device_identity: i64
    css_background_pixel_work_remaining: i64

struct Engine2dDrawIrBoxOutcome:
    engine: Engine2D
    glass_execution: Engine2dGlassExecutionResult

struct Engine2dDrawIrGlassOutcome:
    engine: Engine2D
    composited: bool
    execution: Engine2dGlassExecutionResult

fn _engine2d_draw_ir_render_outcome(
    engine: Engine2D,
    rendered: i32,
    skipped: i32,
    unsupported_kinds: text,
    cpu_composited_material_count: i32,
    metal_device_glass_material_count: i32 = 0,
    metal_device_glass_requested_count: i32 = 0,
    metal_device_glass_unfulfilled_count: i32 = 0,
    metal_device_glass_receipts: [Engine2dMetalGlassReceipt] = [],
    glass_execution_target: text = "",
    glass_backend_handle: i64 = 0,
    glass_device_identity: i64 = 0,
    css_background_pixel_work_remaining: i64 = -1
) -> Engine2dDrawIrRenderOutcome:
    Engine2dDrawIrRenderOutcome(
        engine: engine,
        rendered: rendered,
        skipped: skipped,
        unsupported_kinds: unsupported_kinds,
        cpu_composited_material_count: cpu_composited_material_count,
        metal_device_glass_material_count:
            metal_device_glass_material_count,
        metal_device_glass_requested_count:
            metal_device_glass_requested_count,
        metal_device_glass_unfulfilled_count:
            metal_device_glass_unfulfilled_count,
        metal_device_glass_receipts: metal_device_glass_receipts,
        glass_execution_target: glass_execution_target,
        glass_backend_handle: glass_backend_handle,
        glass_device_identity: glass_device_identity,
        css_background_pixel_work_remaining:
            css_background_pixel_work_remaining
    )

fn _engine2d_draw_ir_result_from_plan(plan: Simple2dDrawIrPlan, rendered: i32, skipped: i32, readback: Engine2DReadback) -> Engine2dDrawIrAdvResult:
    Engine2dDrawIrAdvResult(
        schema: plan.schema,
        unit_id: plan.batch_id,
        selected_backend: plan.selected_backend,
        fallback_required: plan.fallback_required,
        fallback_reason: plan.fallback_reason,
        rendered_command_count: rendered,
        skipped_command_count: skipped,
        pixels: readback.pixels,
        readback_source: readback.source,
        backend_handle: readback.backend_handle,
        device_identity: readback.device_identity,
        readback_checksum: readback.checksum,
        cpu_composited_material_count: 0,
        metal_device_glass_material_count: 0,
        metal_device_glass_requested_count: 0,
        metal_device_glass_unfulfilled_count: 0,
        glass_execution_target: "",
        glass_backend_handle: 0,
        glass_device_identity: 0
    )

fn _engine2d_draw_ir_result_from_composition_plan(plan: Simple2dDrawIrCompositionPlan, rendered: i32, skipped: i32, readback: Engine2DReadback) -> Engine2dDrawIrAdvResult:
    Engine2dDrawIrAdvResult(
        schema: plan.schema,
        unit_id: plan.composition_id,
        selected_backend: plan.selected_backend,
        fallback_required: plan.fallback_required,
        fallback_reason: plan.fallback_reason,
        rendered_command_count: rendered,
        skipped_command_count: skipped,
        pixels: readback.pixels,
        readback_source: readback.source,
        backend_handle: readback.backend_handle,
        device_identity: readback.device_identity,
        readback_checksum: readback.checksum,
        cpu_composited_material_count: 0,
        metal_device_glass_material_count: 0,
        metal_device_glass_requested_count: 0,
        metal_device_glass_unfulfilled_count: 0,
        glass_execution_target: "",
        glass_backend_handle: 0,
        glass_device_identity: 0
    )

fn _engine2d_draw_ir_supported_command(kind: text) -> bool:
    kind == DRAW_IR_COMMAND_RECT or kind == DRAW_IR_COMMAND_TEXT or kind == DRAW_IR_COMMAND_IMAGE

# A fully transparent fill has no visible contribution. Nonzero alpha may
# initialize a fresh transparent child through each backend's canonical fill.
fn _engine2d_draw_ir_has_visible_alpha(color: u32) -> bool:
    ((color >> 24) & 0xFFu32) != 0u32

# Recover the pixel font size a text command was laid out with from its computed
# style (`font-size` is a plain integer string). Falls back to 12 when absent.
fn _engine2d_draw_ir_text_font_size(style: [DrawIrStyleProp]) -> i32:
    for prop in style:
        val prop_key: text = prop.key
        if prop_key == "font-size":
            val prop_value: text = prop.value
            if prop_value.len() == 0 or prop_value.len() > 9:
                return 12
            var value = 0
            var idx: i64 = 0
            while idx < prop_value.len():
                # i64 binding, no .to_i32() dispatch — chained conversion on
                # the erased char_code_at result misroutes into Px.to_i32
                # (see _engine2d_draw_ir_nth_int above).
                val ch: i64 = prop_value.char_code_at(idx)
                if ch < 48 or ch > 57:
                    return 12
                val digit = (ch - 48) as i32
                if value > (_E2D_DRAW_IR_MAX_FONT_SIZE - digit) / 10:
                    return 12
                value = value * 10 + digit
                idx = idx + 1
            if value > 0:
                return value
    12

# Look up a computed-style value by key. Style props are emitted by the browser
# layout renderer as packed key/value pairs (colors/widths as decimal strings,
# `background-image` as `linear-gradient(<from>,<to>)`, `box-shadow` as
# `<x>px <y>px <color>`). Returns "" when the key is absent.
fn _engine2d_draw_ir_style_value(props: [DrawIrStyleProp], key: text) -> text:
    for prop in props:
        val prop_key: text = prop.key
        if prop_key == key:
            val prop_value: text = prop.value
            return prop_value
    ""

# GAP-2: how many N-stop gradient stops (if any) `paint_layout.spl` encoded
# for this style, via the "background-gradient-stop-count" prop. 0 means no
# N-stop gradient was parsed at CSS-apply time and the legacy 2-stop
# background-image path (from/to only) remains authoritative.
fn _engine2d_draw_ir_gradient_stop_count(props: [DrawIrStyleProp]) -> i32:
    _engine2d_draw_ir_nth_int(
        _engine2d_draw_ir_style_value(props, "background-gradient-stop-count"), 0, 0
    ) as i32

fn _engine2d_draw_ir_text_advances(command: DrawIrCommand) -> [i32]:
    if command.advance_widths.len() > 0:
        if command.advance_widths.len() > _E2D_DRAW_IR_MAX_TEXT_ITEMS:
            return []
        var character_count: i64 = 0
        for ch in command.text_value:
            character_count = character_count + 1
        if command.advance_widths.len() != character_count:
            return []
        var width: i64 = 0
        for advance in command.advance_widths:
            val advance_i64 = advance as i64
            if advance < 0 or width > 2147483647 - advance_i64:
                return []
            width = width + advance_i64
        if width != command.width as i64:
            return []
        return command.advance_widths
    val encoded = _engine2d_draw_ir_style_value(command.computed_style, "font-advance-widths")
    if encoded == "":
        return []
    if (encoded.len() > _E2D_DRAW_IR_MAX_STYLE_VALUE_BYTES or
        command.text_value.len() > _E2D_DRAW_IR_MAX_TEXT_ITEMS):
        return []
    val parts = encoded.split(",")
    if parts.len() > _E2D_DRAW_IR_MAX_TEXT_ITEMS:
        return []
    var advances: [i32] = []
    var width: i64 = 0
    for raw in parts:
        val advance = raw.to_int() ?? -1
        # `as` casts, not .to_i64() dispatch: chained conversions on this
        # freestanding lane misroute (C7 erased-receiver class).
        val advance_i64 = advance as i64
        if advance < 0 or width > 2147483647 - advance_i64:
            print("[e2d-adv] parse-reject raw_len={raw.len()} advance={advance} width={width}")
            return []
        advances.push(advance)
        width = width + advance_i64
    var character_count: i64 = 0
    for ch in command.text_value:
        character_count = character_count + 1
    val command_width = command.width as i64
    if advances.len() != character_count or width != command_width:
        # Silent on healthy frames: fires only for the command about to be
        # skipped as text-font-advances, attributing WHICH gate rejected.
        print("[e2d-adv] mismatch advances={advances.len()} chars={character_count} width={width} cmd_width={command_width} text_len={command.text_value.len()}")
        return []
    advances

fn _engine2d_draw_ir_shaping_requested(command: DrawIrCommand) -> bool:
    _engine2d_draw_ir_style_value(command.computed_style, "font-shaping") == "selected-pure-simple"

fn _engine2d_draw_ir_shaped_payload_valid(command: DrawIrCommand, advances: [i32]) -> bool:
    val payload = command.glyph_run
    if (not payload.valid or payload.glyph_ids.len() == 0 or
        payload.glyph_ids.len() > _E2D_DRAW_IR_MAX_TEXT_ITEMS or
        payload.glyph_ids.len() != payload.xs.len() or
        payload.glyph_ids.len() != payload.ys.len() or
        payload.glyph_ids.len() != payload.clusters.len()):
        return false
    var index: i64 = 0
    while index < payload.glyph_ids.len():
        if (payload.glyph_ids[index] == 0u32 or payload.glyph_ids[index] > 2147483647u32 or
            payload.clusters[index] < 0 or payload.clusters[index] >= advances.len()):
            return false
        index = index + 1
    true

# Scan the nth (0-based) signed integer token out of a free-form value string.
# Accumulate in i64 so packed u32 color words (up to 4294967295) do not overflow
# an i32 mid-scan. Returns `fallback` when the nth token is absent.
fn _engine2d_draw_ir_nth_int(value: text, n: i32, fallback: i64) -> i64:
    if value.len() > _E2D_DRAW_IR_MAX_STYLE_VALUE_BYTES:
        return fallback
    var count = 0
    var idx: i64 = 0
    val cs = value.chars()
    val length = cs.len()
    # The whole scan stays in i64: `char_code_at(...).to_i32()` chained the
    # conversion as a method dispatch on an erased receiver, which the
    # freestanding/cranelift lane mis-routed into Px.to_i32 with a
    # null-masked receiver (hosted-WM first-frame crash, stack recovered
    # from the stripped binary). char_code_at already yields a plain i64.
    while idx < length:
        val ch0: i64 = cs[idx].char_code_at(0)
        val is_digit = ch0 >= 48 and ch0 <= 57
        var sign_ok = false
        if (ch0 == 45 or ch0 == 43) and idx + 1 < length:
            val nxt: i64 = cs[idx + 1].char_code_at(0)
            sign_ok = nxt >= 48 and nxt <= 57
        if is_digit or sign_ok:
            val negative = ch0 == 45
            if ch0 == 45 or ch0 == 43:
                idx = idx + 1
            var acc: i64 = 0
            while idx < length:
                val ch: i64 = cs[idx].char_code_at(0)
                if ch >= 48 and ch <= 57:
                    val digit = ch - 48
                    if acc > (9223372036854775807 - digit) / 10:
                        return fallback
                    acc = acc * 10 + digit
                    idx = idx + 1
                else:
                    break
            if negative:
                acc = 0 - acc
            if count == n:
                return acc
            count = count + 1
        else:
            idx = idx + 1
    fallback

# Paint the per-side borders of a box. Emits a uniform rounded-border outline
# when a corner radius plus four equal, same-colored, non-zero sides are present;
# otherwise paints per-side slivers with `draw_rect_filled`. Engine2D is
# value-copied across this free-function boundary, so the caller MUST reassign
# from the returned engine.
fn _engine2d_draw_ir_render_borders(engine: Engine2D, style: [DrawIrStyleProp], x: i32, y: i32, w: i32, h: i32, radius: i32) -> Engine2D:
    var eng = engine
    val top_w = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-top-width"), 0, 0) as i32
    val right_w = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-right-width"), 0, 0) as i32
    val bottom_w = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-bottom-width"), 0, 0) as i32
    val left_w = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-left-width"), 0, 0) as i32
    val top_c = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-top-color"), 0, 0) as u32
    val right_c = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-right-color"), 0, 0) as u32
    val bottom_c = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-bottom-color"), 0, 0) as u32
    val left_c = _engine2d_draw_ir_nth_int(_engine2d_draw_ir_style_value(style, "border-left-color"), 0, 0) as u32
    val uniform = top_w == right_w and right_w == bottom_w and bottom_w == left_w and top_w > 0 and top_c == right_c and right_c == bottom_c and bottom_c == left_c
    if radius > 0 and uniform and _engine2d_draw_ir_has_visible_alpha(top_c):
        eng.draw_rounded_rect_outline(x, y, w, h, radius, top_c, top_w)
        return eng
    if top_w > 0 and _engine2d_draw_ir_has_visible_alpha(top_c):
        eng.draw_rect_filled(x, y, w, top_w, top_c)
    if bottom_w > 0 and _engine2d_draw_ir_has_visible_alpha(bottom_c):
        eng.draw_rect_filled(x, y + h - bottom_w, w, bottom_w, bottom_c)
    if left_w > 0 and _engine2d_draw_ir_has_visible_alpha(left_c):
        eng.draw_rect_filled(x, y, left_w, h, left_c)
    if right_w > 0 and _engine2d_draw_ir_has_visible_alpha(right_c):
        eng.draw_rect_filled(x + w - right_w, y, right_w, h, right_c)
    eng

fn _engine2d_draw_ir_render_glass_material(
    engine: Engine2D, command: DrawIrCommand,
    x: i32, y: i32, w: i32, h: i32, radius: i32,
    mut execution_i64: [i64], mut execution_text: [text]
) -> Engine2dDrawIrGlassOutcome:
    var eng = engine
    val unavailable = engine2d_glass_execution_unavailable(
        "glass-material-not-composited")
    val style: [DrawIrStyleProp] = command.computed_style
    val capability = _engine2d_draw_ir_style_value(
        style, "backdrop-filter-capability")
    if (capability != "engine2d-composited-glass-material-v1" and
        capability != "engine2d-cpu-composited-material-v1"):
        return Engine2dDrawIrGlassOutcome(
            engine: eng, composited: false, execution: unavailable)
    val framebuffer_width = eng.width()
    val framebuffer_height = eng.height()
    val material_x = if x < 0: 0 else: x
    val material_y = if y < 0: 0 else: y
    val right_i64 = x.to_i64() + w.to_i64()
    val bottom_i64 = y.to_i64() + h.to_i64()
    val material_right = if right_i64 > framebuffer_width.to_i64():
        framebuffer_width
    else:
        right_i64 as i32
    val material_bottom = if bottom_i64 > framebuffer_height.to_i64():
        framebuffer_height
    else:
        bottom_i64 as i32
    val material_width = material_right - material_x
    val material_height = material_bottom - material_y
    if (w <= 0 or h <= 0 or material_width <= 0 or material_height <= 0):
        if not _e2d_material_bounds_rejection_logged:
            print "[engine2d-material-exec] rejected=bounds capability={capability} rect={x},{y},{w},{h} framebuffer={framebuffer_width},{framebuffer_height}"
            _e2d_material_bounds_rejection_logged = true
        return Engine2dDrawIrGlassOutcome(
            engine: eng, composited: false, execution: unavailable)
    val material_radius = if (
        material_x != x or material_y != y or
        material_width != w or material_height != h
    ): 0 else: radius
    val backdrop = _engine2d_draw_ir_style_value(style, "backdrop-filter")
    val requested_blur = _engine2d_draw_ir_nth_int(backdrop, 0, 0)
    val realized_blur_text = _engine2d_draw_ir_style_value(
        style, "backdrop-filter-realized-blur-radius-px")
    val realized_saturation_text = _engine2d_draw_ir_style_value(
        style, "backdrop-filter-realized-saturation-milli")
    if realized_blur_text == "" or realized_saturation_text == "":
        print "[engine2d-material-exec] rejected=realized-scalars capability={capability} blur_len={realized_blur_text.len()} saturation_len={realized_saturation_text.len()}"
        return Engine2dDrawIrGlassOutcome(
            engine: eng, composited: false, execution: unavailable)
    val realized_blur = _engine2d_draw_ir_nth_int(
        realized_blur_text,
        0,
        requested_blur
    ) as i32
    val requested_saturation_percent = _engine2d_draw_ir_nth_int(
        backdrop, 1, 100)
    var requested_saturation_milli: i64 = 1000
    if requested_saturation_percent >= 0 and requested_saturation_percent <= 300:
        requested_saturation_milli = requested_saturation_percent * 10
    val realized_saturation_milli = _engine2d_draw_ir_nth_int(
        realized_saturation_text,
        0,
        requested_saturation_milli
    ) as i32
    val command_alpha: u32 = (command.color >> 24) & 0xFFu32
    val command_color_i64: i64 = command.color as i64
    val surface_alpha_milli = _engine2d_draw_ir_nth_int(
        _engine2d_draw_ir_style_value(
            style, "wm-material-surface-alpha-milli"),
        0,
        (command_alpha as i64) * 1000 / 255
    ) as i32
    val surface_color = _engine2d_draw_ir_nth_int(
        _engine2d_draw_ir_style_value(style, "background-color"),
        0,
        command_color_i64
    ) as u32
    val background_image = _engine2d_draw_ir_style_value(
        style, "background-image")
    val gradient_enabled = background_image.starts_with("linear-gradient(")
    val gradient_layered_over_surface = (
        _engine2d_draw_ir_style_value(
            style, "background-image-composite-mode") ==
        "surface-then-alpha-gradient")
    val gradient_from = _engine2d_draw_ir_nth_int(
        background_image, 0, command_color_i64) as u32
    val gradient_to = _engine2d_draw_ir_nth_int(
        background_image, 1, command_color_i64) as u32
    val config = Engine2dGlassMaterialConfig(
        framebuffer_width: framebuffer_width,
        framebuffer_height: framebuffer_height,
        x: material_x,
        y: material_y,
        width: material_width,
        height: material_height,
        radius: material_radius,
        blur_radius: realized_blur,
        saturation_milli: realized_saturation_milli,
        surface_alpha_milli: surface_alpha_milli,
        surface_color: surface_color,
        gradient_from: gradient_from,
        gradient_to: gradient_to,
        gradient_enabled: gradient_enabled,
        gradient_layered_over_surface: gradient_layered_over_surface
    )
    val device_execution = eng.draw_ir_apply_glass_material(config)
    if device_execution.applied:
        execution_i64[0] = 1
        execution_i64[1] = device_execution.backend_handle
        execution_i64[2] = device_execution.device_identity
        execution_text[0] = device_execution.execution_target
        return Engine2dDrawIrGlassOutcome(
            engine: eng, composited: true, execution: device_execution)
    if device_execution.failure_reason == "device-glass-state-unknown":
        print "[engine2d-material-exec] rejected=device-state-unknown capability={capability}"
        return Engine2dDrawIrGlassOutcome(
            engine: eng, composited: false, execution: device_execution)
    val pixels = engine2d_draw_ir_glass_material_pixels(
        eng.read_pixels(), config)
    if pixels.len() != material_width.to_i64() * material_height.to_i64():
        print "[engine2d-material-exec] rejected=cpu-pixel-span capability={capability} pixels={pixels.len()} expected={material_width.to_i64() * material_height.to_i64()} device_reason={device_execution.failure_reason}"
        return Engine2dDrawIrGlassOutcome(
            engine: eng, composited: false, execution: unavailable)
    eng.draw_image(
        material_x, material_y, material_width, material_height, pixels)
    execution_i64[0] = 1
    execution_i64[1] = 0
    execution_i64[2] = 0
    execution_text[0] = "cpu-scalar-glass-v1"
    if _E2D_MATERIAL_TRACE:
        print "[engine2d-material-handoff] stage=glass-success code={execution_i64[0]} target={execution_text[0]}"
    Engine2dDrawIrGlassOutcome(
        engine: eng,
        composited: true,
        execution: engine2d_glass_execution_cpu()
    )

# Render a single HTML/CSS box honestly instead of collapsing it to one flat
# fill: box-shadow first (behind), then background (linear-gradient beats a solid
# fill; a corner radius routes the solid fill to a rounded rect), then per-side
# borders. Each sub-feature is checked independently so a transparent-background
# box that still has a border or shadow paints instead of vanishing. Keep the
# concrete Engine2D owner mutable across this boundary; returning it inside the
# old box-outcome aggregate lost the receiver on freestanding native builds.
fn _engine2d_draw_ir_render_box(
    engine: Engine2D, command: DrawIrCommand,
    x: i32, y: i32, w: i32, h: i32,
    mut execution_i64: [i64], mut execution_text: [text]
) -> Engine2D:
    var eng = engine
    # Reset and draw through the exact caller-owned receiver. Evidence remains
    # in the caller-owned scalar sidecars; no Engine2D value crosses back in a
    # nested result.
    eng.clear_mask()
    val style: [DrawIrStyleProp] = command.computed_style
    val typed_shadows = engine2d_draw_ir_typed_box_shadows(style)
    val typed_corners = engine2d_draw_ir_typed_corner_radii(style)
    var shadow_admitted = (
        typed_shadows.schema_present and typed_shadows.valid and
        engine2d_draw_ir_typed_shadow_geometry_safe(
            typed_shadows.layers, x, y, w, h)
    )
    var corner_admitted = typed_corners.valid
    val decoded_uniform_radius = engine2d_draw_ir_clamp_uniform_radius(
        engine2d_draw_ir_uniform_corner_radius(typed_corners), w, h)
    if (corner_admitted and decoded_uniform_radius < 0 and
        not engine2d_draw_ir_mask_geometry_safe(x, y, w, h)):
        corner_admitted = false
    val typed_has_inset = (
        shadow_admitted and
        engine2d_draw_ir_has_inset_shadow(typed_shadows.layers)
    )
    if (typed_has_inset and
        not engine2d_draw_ir_mask_geometry_safe(x, y, w, h)):
        shadow_admitted = false
    if shadow_admitted:
        val outer_shadow_engine_ignored = engine2d_draw_ir_render_typed_outer_shadows(
            eng, typed_shadows.layers, x, y, w, h)
    else:
        # Absent, malformed, partial, or unsafe typed shadows fall back once.
        # The Engine2D effect owner validates legacy geometry before drawing;
        # an unsafe legacy aggregate is an intentional no-op.
        val legacy_shadow_engine_ignored = engine2d_draw_ir_render_legacy_shadow(
            eng, style, x, y, w, h)
    val legacy_radius = engine2d_draw_ir_clamp_uniform_radius(
        engine2d_draw_ir_legacy_uniform_radius(style), w, h)
    val typed_nonuniform = corner_admitted and decoded_uniform_radius < 0
    val radius = if typed_nonuniform:
        0
    elif corner_admitted and decoded_uniform_radius >= 0:
        decoded_uniform_radius
    else:
        legacy_radius
    val effective_corners: Engine2dDrawIrCornerRadii = if corner_admitted:
        typed_corners
    else:
        engine2d_draw_ir_uniform_corners(legacy_radius)
    # Engine2dGlassMaterialConfig currently carries one uniform radius. A
    # nonuniform typed box therefore stays on the bounded CPU mask path rather
    # than claiming a device-glass execution with the wrong clip.
    val glass = if typed_nonuniform:
        Engine2dDrawIrGlassOutcome(
            engine: eng,
            composited: false,
            execution: engine2d_glass_execution_unavailable(
                "nonuniform-corner-device-glass-unavailable")
        )
    else:
        _engine2d_draw_ir_render_glass_material(
            eng, command, x, y, w, h, radius,
            execution_i64, execution_text)
    if capability == "engine2d-cpu-composited-material-v1":
        print "[engine2d-material-handoff] stage=box-return code={execution_i64[0]} target={execution_text[0]}"
    if execution_i64[0] == 1:
        if shadow_admitted:
            val inset_shadow_engine_ignored = engine2d_draw_ir_render_typed_inset_shadows(
                eng, typed_shadows.layers, x, y, w, h, effective_corners)
        val border_engine_ignored = _engine2d_draw_ir_render_borders(
            eng, style, x, y, w, h, radius)
        return eng
    val bg_image = _engine2d_draw_ir_style_value(style, "background-image")
    if typed_nonuniform:
        val background_engine_ignored = engine2d_draw_ir_render_typed_background(
            eng, command, x, y, w, h, effective_corners)
    elif _engine2d_draw_ir_gradient_stop_count(style) >= 2 and radius <= 0:
        # GAP-2: an N-stop/angled/radial gradient was parsed at CSS-apply
        # time (simple_web_html_layout_renderer_decl_apply.spl) and threaded
        # through as flat style props (paint_layout.spl). Rebuild the stop
        # arrays here with the same `_engine2d_draw_ir_nth_int` decimal
        # scanner the legacy 2-stop path already uses, then paint with the
        # stop-list-aware Engine2D primitives instead of the legacy 2-color
        # `draw_gradient_rect`.
        val stop_count = _engine2d_draw_ir_gradient_stop_count(style)
        val stops_raw = _engine2d_draw_ir_style_value(style, "background-gradient-stops")
        val angle_deg = _engine2d_draw_ir_nth_int(
            _engine2d_draw_ir_style_value(style, "background-gradient-angle-deg"), 0, 180
        ) as i32
        val is_radial = _engine2d_draw_ir_style_value(style, "background-gradient-is-radial") == "1"
        var stop_colors: [u32] = []
        var stop_positions: [i32] = []
        var gsi: i32 = 0
        while gsi < stop_count:
            stop_colors.push(_engine2d_draw_ir_nth_int(stops_raw, gsi, 0) as u32)
            gsi = gsi + 1
        gsi = 0
        while gsi < stop_count:
            stop_positions.push(_engine2d_draw_ir_nth_int(stops_raw, stop_count + gsi, 0) as i32)
            gsi = gsi + 1
        if is_radial:
            val cx = x + w / 2
            val cy = y + h / 2
            val r = if w > h: w / 2 else: h / 2
            eng.draw_radial_gradient_rect_stops(cx, cy, r, stop_colors, stop_positions)
        else:
            eng.draw_gradient_rect_stops(x, y, w, h, stop_colors, stop_positions, angle_deg)
    elif bg_image.starts_with("linear-gradient(") and radius <= 0:
        val g_from = _engine2d_draw_ir_nth_int(bg_image, 0, 0) as u32
        val g_to = _engine2d_draw_ir_nth_int(bg_image, 1, 0) as u32
        eng.draw_gradient_rect(x, y, w, h, g_from, g_to)
    elif bg_image.starts_with("linear-gradient(") and radius > 0 and _engine2d_draw_ir_has_visible_alpha(command.color):
        # No backend owns a rounded-gradient clip yet. Honor the radius with
        # the producer's explicit solid fallback rather than leaking square
        # gradient pixels outside the glass surface.
        eng.draw_rounded_rect(x, y, w, h, radius, command.color)
    elif _engine2d_draw_ir_has_visible_alpha(command.color):
        if radius > 0:
            eng.draw_rounded_rect(x, y, w, h, radius, command.color)
        else:
            eng.draw_rect_filled(x, y, w, h, command.color)
            if (_e2d_box_owner_probe_count < 3 and x > 4 and y > 4):
                val box_pixels = eng.read_pixels()
                if box_pixels.len() == eng.width().to_i64() * eng.height().to_i64():
                    _e2d_box_owner_probe_count = _e2d_box_owner_probe_count + 1
                    val box_probe_x = x + w / 2
                    val box_probe_y = y + h / 2
                    val box_probe_index = (
                        box_probe_y.to_i64() * eng.width().to_i64() +
                        box_probe_x.to_i64())
                    if (box_probe_x >= 0 and box_probe_y >= 0 and
                        box_probe_x < eng.width() and box_probe_y < eng.height()):
                        print "[draw-ir-box-pixels] color={command.color} xy={x},{y} size={w}x{h} probe={box_pixels[box_probe_index]}"
    if shadow_admitted:
        val clipped_inset_shadow_engine_ignored = engine2d_draw_ir_render_typed_inset_shadows(
            eng, typed_shadows.layers, x, y, w, h, effective_corners)
    val clipped_border_engine_ignored = _engine2d_draw_ir_render_borders(
        eng, style, x, y, w, h, radius)
    eng
fn engine2d_resolved_draw_ir_image(image_uri: text, width: i32, height: i32, pixels: [u32]) -> Engine2dResolvedDrawIrImage:
    var opaque = (
        width > 0 and height > 0 and
        pixels.len() == width.to_i64() * height.to_i64())
    if opaque:
        for pixel in pixels:
            if ((pixel >> 24) & 0xFFu32) != 0xFFu32:
                opaque = false
                break
    Engine2dResolvedDrawIrImage(
        image_uri: image_uri, width: width, height: height, pixels: pixels,
        opaque: opaque)

fn _engine2d_draw_ir_resolved_image_index(images: [Engine2dResolvedDrawIrImage], image_uri: text) -> i32:
    var index = 0
    while index < images.len():
        if images[index].image_uri == image_uri:
            return index
        index = index + 1
    -1

fn _engine2d_draw_ir_valid_resolved_image(image: Engine2dResolvedDrawIrImage) -> bool:
    image.width > 0 and image.height > 0 and image.pixels.len() == image.width.to_i64() * image.height.to_i64()

fn _engine2d_draw_ir_image_is_opaque(image: Engine2dResolvedDrawIrImage) -> bool:
    image.opaque

fn _engine2d_draw_ir_unique_style_value(props: [DrawIrStyleProp], key: text) -> text:
    var found = ""
    var count = 0
    for prop in props:
        if prop.key == key:
            found = prop.value
            count = count + 1
    if count != 1:
        return ""
    found

fn _engine2d_draw_ir_has_css_background_role(props: [DrawIrStyleProp]) -> bool:
    for prop in props:
        if prop.key == "image-role" and prop.value == "css-background":
            return true
    false

fn _engine2d_draw_ir_canonical_i32(value: text) -> i64:
    val invalid: i64 = 9223372036854775807
    if value == "" or value.len() > 11:
        return invalid
    val parsed = _engine2d_draw_ir_nth_int(value, 0, invalid)
    if parsed < -2147483648 or parsed > 2147483647:
        return invalid
    if "{parsed}" != value:
        return invalid
    parsed

fn _engine2d_draw_ir_positive_mod(value: i64, modulus: i64) -> i64:
    val remainder = value % modulus
    if remainder < 0:
        return remainder + modulus
    remainder

fn _engine2d_draw_ir_css_background_metadata(
    command: DrawIrCommand
) -> Engine2dCssBackgroundMetadata:
    val invalid: i64 = 9223372036854775807
    val style = command.computed_style
    if _engine2d_draw_ir_unique_style_value(
        style, "image-role") != "css-background":
        return Engine2dCssBackgroundMetadata(
            valid: false, repeat: "", tile_x: 0, tile_y: 0,
            tile_width: 0, tile_height: 0, shape_x: 0, shape_y: 0,
            shape_width: 0, shape_height: 0,
            radius_tl_x: 0, radius_tl_y: 0,
            radius_tr_x: 0, radius_tr_y: 0,
            radius_br_x: 0, radius_br_y: 0,
            radius_bl_x: 0, radius_bl_y: 0)
    val repeat = _engine2d_draw_ir_unique_style_value(
        style, "background-repeat")
    if (repeat != "no-repeat" and repeat != "repeat-x" and
        repeat != "repeat-y" and repeat != "repeat"):
        return Engine2dCssBackgroundMetadata(
            valid: false, repeat: "", tile_x: 0, tile_y: 0,
            tile_width: 0, tile_height: 0, shape_x: 0, shape_y: 0,
            shape_width: 0, shape_height: 0,
            radius_tl_x: 0, radius_tl_y: 0,
            radius_tr_x: 0, radius_tr_y: 0,
            radius_br_x: 0, radius_br_y: 0,
            radius_bl_x: 0, radius_bl_y: 0)
    val tile_x = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-tile-x"))
    val tile_y = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-tile-y"))
    val tile_width = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-tile-width"))
    val tile_height = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-tile-height"))
    val shape_x = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-shape-x"))
    val shape_y = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-shape-y"))
    val shape_width = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-shape-width"))
    val shape_height = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-shape-height"))
    val radius_tl_x = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-tl-x"))
    val radius_tl_y = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-tl-y"))
    val radius_tr_x = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-tr-x"))
    val radius_tr_y = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-tr-y"))
    val radius_br_x = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-br-x"))
    val radius_br_y = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-br-y"))
    val radius_bl_x = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-bl-x"))
    val radius_bl_y = _engine2d_draw_ir_canonical_i32(
        _engine2d_draw_ir_unique_style_value(style, "background-radius-bl-y"))
    val command_right = command.x.to_i64() + command.width.to_i64()
    val command_bottom = command.y.to_i64() + command.height.to_i64()
    val shape_right = if shape_x != invalid and shape_width != invalid:
        shape_x + shape_width
    else:
        invalid
    val shape_bottom = if shape_y != invalid and shape_height != invalid:
        shape_y + shape_height
    else:
        invalid
    Engine2dCssBackgroundMetadata(
        valid: (
            tile_x != invalid and tile_y != invalid and
            tile_width != invalid and tile_height != invalid and
            shape_x != invalid and shape_y != invalid and
            shape_width != invalid and shape_height != invalid and
            radius_tl_x != invalid and radius_tl_y != invalid and
            radius_tr_x != invalid and radius_tr_y != invalid and
            radius_br_x != invalid and radius_br_y != invalid and
            radius_bl_x != invalid and radius_bl_y != invalid and
            tile_width > 0 and tile_height > 0 and
            shape_width > 0 and shape_height > 0 and
            radius_tl_x >= 0 and radius_tl_y >= 0 and
            radius_tr_x >= 0 and radius_tr_y >= 0 and
            radius_br_x >= 0 and radius_br_y >= 0 and
            radius_bl_x >= 0 and radius_bl_y >= 0 and
            command.x.to_i64() >= shape_x and command.y.to_i64() >= shape_y and
            command_right <= shape_right and command_bottom <= shape_bottom),
        repeat: repeat,
        tile_x: tile_x,
        tile_y: tile_y,
        tile_width: tile_width,
        tile_height: tile_height,
        shape_x: shape_x,
        shape_y: shape_y,
        shape_width: shape_width,
        shape_height: shape_height,
        radius_tl_x: radius_tl_x,
        radius_tl_y: radius_tl_y,
        radius_tr_x: radius_tr_x,
        radius_tr_y: radius_tr_y,
        radius_br_x: radius_br_x,
        radius_br_y: radius_br_y,
        radius_bl_x: radius_bl_x,
        radius_bl_y: radius_bl_y
    )

fn _engine2d_draw_ir_inside_corner(
    dx: i64, dy: i64, radius_x: i64, radius_y: i64
) -> bool:
    val nx = dx.to_f64() / radius_x.to_f64()
    val ny = dy.to_f64() / radius_y.to_f64()
    nx * nx + ny * ny <= 1.0

fn _engine2d_draw_ir_css_background_inside_clip(
    metadata: Engine2dCssBackgroundMetadata, px: i64, py: i64
) -> bool:
    val max_radius_x = metadata.shape_width / 2
    val max_radius_y = metadata.shape_height / 2
    val tlx = if metadata.radius_tl_x < max_radius_x: metadata.radius_tl_x else: max_radius_x
    val tly = if metadata.radius_tl_y < max_radius_y: metadata.radius_tl_y else: max_radius_y
    val trx = if metadata.radius_tr_x < max_radius_x: metadata.radius_tr_x else: max_radius_x
    val try = if metadata.radius_tr_y < max_radius_y: metadata.radius_tr_y else: max_radius_y
    val brx = if metadata.radius_br_x < max_radius_x: metadata.radius_br_x else: max_radius_x
    val bry = if metadata.radius_br_y < max_radius_y: metadata.radius_br_y else: max_radius_y
    val blx = if metadata.radius_bl_x < max_radius_x: metadata.radius_bl_x else: max_radius_x
    val bly = if metadata.radius_bl_y < max_radius_y: metadata.radius_bl_y else: max_radius_y
    if (tlx > 0 and tly > 0 and px < metadata.shape_x + tlx and
        py < metadata.shape_y + tly):
        val dx = metadata.shape_x + tlx - 1 - px
        val dy = metadata.shape_y + tly - 1 - py
        return _engine2d_draw_ir_inside_corner(dx, dy, tlx, tly)
    if (trx > 0 and try > 0 and
        px >= metadata.shape_x + metadata.shape_width - trx and
        py < metadata.shape_y + try):
        val dx = px - (metadata.shape_x + metadata.shape_width - trx)
        val dy = metadata.shape_y + try - 1 - py
        return _engine2d_draw_ir_inside_corner(dx, dy, trx, try)
    if (blx > 0 and bly > 0 and px < metadata.shape_x + blx and
        py >= metadata.shape_y + metadata.shape_height - bly):
        val dx = metadata.shape_x + blx - 1 - px
        val dy = py - (metadata.shape_y + metadata.shape_height - bly)
        return _engine2d_draw_ir_inside_corner(dx, dy, blx, bly)
    if (brx > 0 and bry > 0 and
        px >= metadata.shape_x + metadata.shape_width - brx and
        py >= metadata.shape_y + metadata.shape_height - bry):
        val dx = px - (metadata.shape_x + metadata.shape_width - brx)
        val dy = py - (metadata.shape_y + metadata.shape_height - bry)
        return _engine2d_draw_ir_inside_corner(dx, dy, brx, bry)
    true

fn _engine2d_draw_ir_css_background_pixels(
    command: DrawIrCommand,
    image: Engine2dResolvedDrawIrImage,
    sample_origin_x: i64,
    sample_origin_y: i64,
    target_pixels: i64
) -> Engine2dCssBackgroundPixels:
    var empty: [u32] = []
    val metadata = _engine2d_draw_ir_css_background_metadata(command)
    if (not metadata.valid or command.width <= 0 or command.height <= 0 or
        target_pixels <= 0):
        return Engine2dCssBackgroundPixels(valid: false, pixels: empty)
    val work = command.width.to_i64() * command.height.to_i64()
    if work <= 0 or work > target_pixels or work > 2147483647:
        return Engine2dCssBackgroundPixels(valid: false, pixels: empty)

    val repeat_x = (
        metadata.repeat == "repeat-x" or metadata.repeat == "repeat")
    val repeat_y = (
        metadata.repeat == "repeat-y" or metadata.repeat == "repeat")
    val work_i32 = work as i32
    var pixels: [u32] = [0u32; work_i32]
    var local_y: i64 = 0
    while local_y < command.height.to_i64():
        val relative_y = sample_origin_y + local_y - metadata.tile_y
        var sample_y = relative_y
        var y_visible = (
            relative_y >= 0 and relative_y < metadata.tile_height)
        if repeat_y:
            sample_y = _engine2d_draw_ir_positive_mod(
                relative_y, metadata.tile_height)
            y_visible = true
        var local_x: i64 = 0
        while local_x < command.width.to_i64():
            val relative_x = sample_origin_x + local_x - metadata.tile_x
            var sample_x = relative_x
            var x_visible = (
                relative_x >= 0 and relative_x < metadata.tile_width)
            if repeat_x:
                sample_x = _engine2d_draw_ir_positive_mod(
                    relative_x, metadata.tile_width)
                x_visible = true
            if (x_visible and y_visible and
                _engine2d_draw_ir_css_background_inside_clip(
                    metadata, sample_origin_x + local_x,
                    sample_origin_y + local_y)):
                val source_x = (
                    sample_x * image.width.to_i64() / metadata.tile_width)
                val source_y = (
                    sample_y * image.height.to_i64() / metadata.tile_height)
                pixels[local_y * command.width.to_i64() + local_x] = (
                    image.pixels[source_y * image.width.to_i64() + source_x])
            local_x = local_x + 1
        local_y = local_y + 1
    Engine2dCssBackgroundPixels(valid: pixels.len() == work, pixels: pixels)

fn _engine2d_draw_ir_fresh_device_rect_style_supported(style: [DrawIrStyleProp]) -> bool:
    for prop in style:
        val key = prop.key
        val identity = key == "source" or key == "part" or key == "z-index" or key == "focused" or key == "image-role"
        val background = key == "background-color" or key == "background-image" or key == "background-image-source-css" or key == "background-image-capability" or key == "background-image-composite-mode" or key == "background-image-fallback" or key == "background-image-fallback-reason"
        val border = key == "border-radius" or key == "border-top-left-radius" or key == "border-top-right-radius" or key == "border-bottom-right-radius" or key == "border-bottom-left-radius" or key == "border-top-width" or key == "border-right-width" or key == "border-bottom-width" or key == "border-left-width" or key == "border-top-color" or key == "border-right-color" or key == "border-bottom-color" or key == "border-left-color"
        val shadow = key == "box-shadow" or key == "box-shadow-raw" or key == "box-shadow-blur-radius" or engine2d_draw_ir_typed_shadow_key_supported(key)
        val backdrop = key == "backdrop-filter" or key == "backdrop-filter-capability" or key == "backdrop-filter-requested-target" or key == "backdrop-filter-realized" or key == "backdrop-filter-realized-blur-radius-px" or key == "backdrop-filter-realized-saturation-milli" or key == "backdrop-filter-reduction-reason" or key == "backdrop-filter-fallback" or key == "backdrop-filter-fallback-target" or key == "backdrop-filter-fallback-reason" or key == "backdrop-filter-fallback-material-hash"
        val typography = key == "color" or key == "font-family" or key == "font-size" or key == "font-weight"
        val wm_metadata = key == "wm-theme-schema" or key == "wm-theme-id" or key == "wm-theme-family-id" or key == "wm-theme-source-reference" or key == "wm-theme-source-manifest-sha256" or key == "wm-theme-material-sha256" or key == "wm-material-request" or key == "wm-material-surface-alpha-milli"
        if not (identity or background or border or shadow or backdrop or typography or wm_metadata):
            return false
    true

fn _engine2d_draw_ir_fresh_device_command_supported(command: DrawIrCommand, images: [Engine2dResolvedDrawIrImage], width: i32, height: i32, allow_clipped: bool, allow_translucent_initializer: bool) -> bool:
    val right = command.x.to_i64() + command.width.to_i64()
    val bottom = command.y.to_i64() + command.height.to_i64()
    if (command.width <= 0 or command.height <= 0 or right <= 0 or bottom <= 0 or
        command.x >= width or command.y >= height):
        return false
    val wholly_bounded = command.x >= 0 and command.y >= 0 and right <= width.to_i64() and bottom <= height.to_i64()
    if command.kind == "text":
        val identity = _engine2d_draw_ir_style_value(command.computed_style, "font-identity")
        val font_size = _engine2d_draw_ir_text_font_size(command.computed_style)
        if command.text_value == "" or identity == "" or (not allow_clipped and not wholly_bounded):
            return false
        return (_engine2d_draw_ir_style_value(command.computed_style, "font-family") != "" and
            _engine2d_draw_ir_text_advances(command).len() > 0 and
            _engine2d_draw_ir_style_value(command.computed_style, "line-height") != "" and
            font_size > 0 and font_size <= 512)
    if not allow_clipped and not wholly_bounded:
        return false
    if command.kind == "rect":
        if not _engine2d_draw_ir_fresh_device_rect_style_supported(command.computed_style):
            return false
        val typed_shadows = engine2d_draw_ir_typed_box_shadows(
            command.computed_style)
        var typed_shadow_admitted = (
            typed_shadows.schema_present and typed_shadows.valid and
            engine2d_draw_ir_typed_shadow_geometry_safe(
                typed_shadows.layers,
                command.x,
                command.y,
                command.width,
                command.height)
        )
        if (typed_shadow_admitted and
            engine2d_draw_ir_has_inset_shadow(typed_shadows.layers) and
            not engine2d_draw_ir_mask_geometry_safe(
                command.x, command.y, command.width, command.height)):
            typed_shadow_admitted = false
        # Match execution: any absent, malformed, or unsafe typed schema uses
        # the aggregate only when that aggregate passes the same bounded
        # Engine2D validator. Corners are decoded and admitted independently.
        if (not typed_shadow_admitted and
            not engine2d_draw_ir_legacy_shadow_safe(
                command.computed_style,
                command.x,
                command.y,
                command.width,
                command.height)):
            return false
        val alpha = (command.color >> 24) & 0xFFu32
        val pixel_work = command.width.to_i64() * command.height.to_i64()
        val css_background_border_overlay = (
            _engine2d_draw_ir_unique_style_value(
                command.computed_style, "image-role") ==
            "css-background-border-overlay")
        return (alpha == 0xFFu32 or css_background_border_overlay or
            (allow_translucent_initializer and alpha > 0u32)) and
            pixel_work <= width.to_i64() * height.to_i64()
    if command.kind != "image":
        return false
    val image_index = _engine2d_draw_ir_resolved_image_index(images, command.image_uri)
    if image_index < 0:
        return false
    val image = images[image_index]
    if (_engine2d_draw_ir_has_css_background_role(
        command.computed_style) and
        not _engine2d_draw_ir_css_background_metadata(command).valid):
        return false
    val exact_size = command.width == image.width and command.height == image.height
    val source_work = image.width.to_i64() * image.height.to_i64()
    val scaled_work = command.width.to_i64() * command.height.to_i64()
    val scaled_work_bounded = scaled_work <= width.to_i64() * height.to_i64() and scaled_work <= 2147483647
    val native_index_bounded = (source_work <= 4294967295 and
        (command.width.to_i64() - 1) * image.width.to_i64() <= 2147483647 and
        (command.height.to_i64() - 1) * image.height.to_i64() <= 2147483647)
    _engine2d_draw_ir_valid_resolved_image(image) and
        native_index_bounded and
        (exact_size or scaled_work_bounded)

fn _engine2d_draw_ir_fresh_device_initializes_target(command: DrawIrCommand, images: [Engine2dResolvedDrawIrImage], width: i32, height: i32) -> bool:
    if command.x != 0 or command.y != 0 or command.width != width or command.height != height:
        return false
    if command.kind == "rect":
        return command.computed_style.len() == 0 and ((command.color >> 24) & 0xFFu32) == 0xFFu32
    if command.kind != "image":
        return false
    val image_index = _engine2d_draw_ir_resolved_image_index(images, command.image_uri)
    if image_index < 0 or not _engine2d_draw_ir_valid_resolved_image(
        images[image_index]):
        return false
    if _engine2d_draw_ir_has_css_background_role(command.computed_style):
        val metadata = _engine2d_draw_ir_css_background_metadata(command)
        return (metadata.valid and metadata.repeat == "repeat" and
            _engine2d_draw_ir_image_is_opaque(images[image_index]))
    _engine2d_draw_ir_image_is_opaque(images[image_index])

fn _engine2d_draw_ir_fresh_device_reason(composition: DrawIrComposition, images: [Engine2dResolvedDrawIrImage], width: i32, height: i32) -> text:
    var first_command = true
    for batch in composition.batches:
        val embedding = batch.embedding
        val right = embedding.x.to_i64() + embedding.width.to_i64()
        val bottom = embedding.y.to_i64() + embedding.height.to_i64()
        if (embedding.x < 0 or embedding.y < 0 or embedding.width <= 0 or embedding.height <= 0 or
            right > width.to_i64() or bottom > height.to_i64() or
            embedding.opacity_milli <= 0 or embedding.opacity_milli > 1000):
            return "fresh-device-bounded-embedding-required"
        val fills_target = embedding.x == 0 and embedding.y == 0 and embedding.width == width and embedding.height == height
        if (not fills_target or embedding.opacity_milli < 1000) and embedding.surface_id == "":
            return "fresh-device-embedded-surface-required"
        if first_command and (not fills_target or embedding.opacity_milli != 1000):
            return "fresh-device-opaque-full-target-first-command-required"
        var command_index = 0
        for command in batch.commands:
            val allow_translucent_initializer = not fills_target and embedding.clip and command_index == 0
            if not _engine2d_draw_ir_fresh_device_command_supported(command, images, embedding.width, embedding.height, not fills_target and embedding.clip, allow_translucent_initializer):
                return "fresh-device-command-preflight-required"
            if first_command and not _engine2d_draw_ir_fresh_device_initializes_target(command, images, width, height):
                return "fresh-device-opaque-full-target-first-command-required"
            first_command = false
            command_index = command_index + 1
    if first_command:
        return "fresh-device-nonempty-composition-required"
    ""

fn _engine2d_draw_ir_prepare_fresh_device_text(engine: Engine2D, composition: DrawIrComposition, width: i32, height: i32) -> (Engine2D, text):
    var eng = engine
    var pixel_work: i64 = 0
    val max_pixel_work = width.to_i64() * height.to_i64()
    for batch in composition.batches:
        for command in batch.commands:
            if command.kind == "text":
                val identity = _engine2d_draw_ir_style_value(command.computed_style, "font-identity")
                if not eng.select_font_identity(identity):
                    return (eng, "fresh-device-font-identity-unavailable")
                val font_size = _engine2d_draw_ir_text_font_size(command.computed_style)
                val advances = _engine2d_draw_ir_text_advances(command)
                if advances.len() == 0:
                    return (eng, "fresh-device-font-advances-invalid")
                val fonts = eng.fonts()
                val shaped = _engine2d_draw_ir_shaping_requested(command)
                if shaped and not _engine2d_draw_ir_shaped_payload_valid(command, advances):
                    return (eng, "fresh-device-font-shaping-invalid")
                val prepared: FontRenderBatch = if shaped:
                    fonts.prepare_selected_glyph_run(command.glyph_run, command.color, font_size)
                else:
                    fonts.prepare_text_with_advances(command.text_value, advances, command.color, font_size)
                eng.install_font_renderer(fonts)
                if not prepared.valid or prepared.font_identity != identity:
                    return (eng, if shaped: "fresh-device-font-shaping-invalid" else: "fresh-device-font-batch-invalid")
                for quad in prepared.quads:
                    val total = quad.width.to_i64() * quad.height.to_i64()
                    val dst_x = font_destination_origin(command.x, quad.dst_x, quad.width)
                    val dst_y = font_destination_origin(command.y, quad.dst_y, quad.height)
                    if total <= 0 or total > max_pixel_work - pixel_work:
                        return (eng, "fresh-device-font-work-limit-exceeded")
                    pixel_work = pixel_work + total
                    if (dst_x == nil or dst_y == nil or
                        font_atlas_subrect_pixels(prepared.atlas_pixels, prepared.atlas_width, prepared.atlas_height,
                            quad.atlas_x, quad.atlas_y, quad.width, quad.height, quad.color).len() != total):
                        return (eng, "fresh-device-font-quad-invalid")
    (eng, "")

# Append one diagnostic kind without unbounded duplicate string growth.
fn _engine2d_draw_ir_note_unsupported_kind(kinds: text, kind: text) -> text:
    if kinds == "":
        return kind
    if ("," + kinds + ",").contains("," + kind + ","):
        return kinds
    kinds + "," + kind

fn _engine2d_draw_ir_unsupported_command_kinds(commands: [DrawIrCommand]) -> text:
    var kinds = ""
    for command in commands:
        if command.? == false:
            continue
        if not _engine2d_draw_ir_supported_command(command.kind):
            kinds = _engine2d_draw_ir_note_unsupported_kind(kinds, command.kind)
    if kinds == "":
        return "none"
    kinds

fn _engine2d_draw_ir_append_unsupported_reason(reason: text, unsupported_kinds: text) -> text:
    if unsupported_kinds == "none":
        return reason
    val unsupported_reason = "unsupported Draw IR commands skipped: {unsupported_kinds}"
    if reason == "":
        return unsupported_reason
    "{reason}; {unsupported_reason}"

fn _engine2d_draw_ir_result_from_plan_with_unsupported(plan: Simple2dDrawIrPlan, rendered: i32, skipped: i32, unsupported_kinds: text, readback: Engine2DReadback) -> Engine2dDrawIrAdvResult:
    val has_unsupported = skipped > 0 and unsupported_kinds != "none"
    Engine2dDrawIrAdvResult(
        schema: plan.schema,
        unit_id: plan.batch_id,
        selected_backend: plan.selected_backend,
        fallback_required: plan.fallback_required or has_unsupported,
        fallback_reason: _engine2d_draw_ir_append_unsupported_reason(plan.fallback_reason, unsupported_kinds),
        rendered_command_count: rendered,
        skipped_command_count: skipped,
        pixels: readback.pixels,
        readback_source: readback.source,
        backend_handle: readback.backend_handle,
        device_identity: readback.device_identity,
        readback_checksum: readback.checksum,
        cpu_composited_material_count: 0,
        metal_device_glass_material_count: 0,
        metal_device_glass_requested_count: 0,
        metal_device_glass_unfulfilled_count: 0,
        glass_execution_target: "",
        glass_backend_handle: 0,
        glass_device_identity: 0
    )

fn _engine2d_draw_ir_result_from_composition_plan_with_unsupported(plan: Simple2dDrawIrCompositionPlan, rendered: i32, skipped: i32, unsupported_kinds: text, readback: Engine2DReadback) -> Engine2dDrawIrAdvResult:
    val has_unsupported = skipped > 0 and unsupported_kinds != "none"
    Engine2dDrawIrAdvResult(
        schema: plan.schema,
        unit_id: plan.composition_id,
        selected_backend: plan.selected_backend,
        fallback_required: plan.fallback_required or has_unsupported,
        fallback_reason: _engine2d_draw_ir_append_unsupported_reason(plan.fallback_reason, unsupported_kinds),
        rendered_command_count: rendered,
        skipped_command_count: skipped,
        pixels: readback.pixels,
        readback_source: readback.source,
        backend_handle: readback.backend_handle,
        device_identity: readback.device_identity,
        readback_checksum: readback.checksum,
        cpu_composited_material_count: 0,
        metal_device_glass_material_count: 0,
        metal_device_glass_requested_count: 0,
        metal_device_glass_unfulfilled_count: 0,
        glass_execution_target: "",
        glass_backend_handle: 0,
        glass_device_identity: 0
    )

# Maximum embedded-surface nesting depth for _engine2d_draw_ir_render_batch_embedded.
# The current DrawIrBatch/DrawIrComposition schema has no field that lets one
# batch reference a nested child batch/composition directly, so a single
# executor call never structurally recurses past depth 0 today — this cap is
# forward-proofing the offscreen render path so that IF a future producer
# feeds an embedded surface's own pixels back in (e.g. as a resolved
# DRAW_IR_COMMAND_IMAGE built from another embedded render, composing surfaces
# by hand across two executor calls), unbounded nesting still can't blow the
# stack: past this depth the batch falls back to today's direct translate+clip
# render instead of allocating another offscreen Engine2D.
val ENGINE2D_DRAW_IR_EMBED_MAX_DEPTH: i32 = 3

# Single-slot reusable software offscreen for embedded (translucent) batches.
# SimpleOS runs on a NON-reclaiming baremetal bump heap: Engine2D.create_offscreen
# allocates a full ~8 MB surface per translucent window and offscreen.shutdown()
# frees nothing, so ~12 per-window surfaces exhaust the 192 MB heap before the
# first desktop frame completes ([PANIC] heap exhausted). Top-level embedded
# batches render sequentially (one live at a time; depth is never incremented,
# so there is no re-entrancy), so a single cached surface — cleared before each
# reuse — serves them all, and is reused across frames too. Keyed by EXACT
# (w, h) because draw_engine composites src.width() x src.height(); a size
# change reallocates (bounded by the number of distinct window sizes).
var _engine2d_embed_pool: Engine2D? = nil
var _engine2d_embed_pool_w: i32 = 0
var _engine2d_embed_pool_h: i32 = 0
var _engine2d_embed_pool_backend: text = ""

# Three-entry retained parent-material cache. Current WM composition has three
# glass windows; a larger scene remains correct and simply
# thrashes this bounded cache. Entries are admitted by exact parent pixels plus
# the producer's style revision and full embedding contract.
var _engine2d_parent_material_key_a: text = ""
var _engine2d_parent_material_key_b: text = ""
var _engine2d_parent_material_key_c: text = ""
var _engine2d_parent_material_pixels_a: [u32] = []
var _engine2d_parent_material_pixels_b: [u32] = []
var _engine2d_parent_material_pixels_c: [u32] = []
var _engine2d_parent_material_rendered_a: i32 = 0
var _engine2d_parent_material_rendered_b: i32 = 0
var _engine2d_parent_material_rendered_c: i32 = 0
var _engine2d_parent_material_cpu_a: i32 = 0
var _engine2d_parent_material_cpu_b: i32 = 0
var _engine2d_parent_material_cpu_c: i32 = 0
var _engine2d_parent_material_css_a: i64 = 0
var _engine2d_parent_material_css_b: i64 = 0
var _engine2d_parent_material_css_c: i64 = 0
var _engine2d_parent_material_next: i32 = 0

fn _engine2d_parent_material_cache_key(
    batch: DrawIrBatch, visual_key: text, padding: i32
) -> text:
    val e: DrawIrEmbeddingConfig = batch.embedding
    "{visual_key}|{batch.backend_target}|{batch.source.style_revision}|{e.surface_id}|{e.x},{e.y},{e.width},{e.height},{e.opacity_milli}|{padding}|{batch.commands.len()}"

fn _engine2d_parent_material_cache_slot(key: text) -> i32:
    if key != "" and key == _engine2d_parent_material_key_a:
        return 0
    if key != "" and key == _engine2d_parent_material_key_b:
        return 1
    if key != "" and key == _engine2d_parent_material_key_c:
        return 2
    -1

fn _engine2d_parent_material_cache_pixels(slot: i32) -> [u32]:
    if slot == 0: return _engine2d_parent_material_pixels_a
    if slot == 1: return _engine2d_parent_material_pixels_b
    if slot == 2: return _engine2d_parent_material_pixels_c
    []

fn _engine2d_parent_material_cache_rendered(slot: i32) -> i32:
    if slot == 0: return _engine2d_parent_material_rendered_a
    if slot == 1: return _engine2d_parent_material_rendered_b
    if slot == 2: return _engine2d_parent_material_rendered_c
    0

fn _engine2d_parent_material_cache_cpu(slot: i32) -> i32:
    if slot == 0: return _engine2d_parent_material_cpu_a
    if slot == 1: return _engine2d_parent_material_cpu_b
    if slot == 2: return _engine2d_parent_material_cpu_c
    0

fn _engine2d_parent_material_cache_css(slot: i32) -> i64:
    if slot == 0: return _engine2d_parent_material_css_a
    if slot == 1: return _engine2d_parent_material_css_b
    if slot == 2: return _engine2d_parent_material_css_c
    0

fn _engine2d_parent_material_cache_store(
    key: text, pixels: [u32], rendered: i32, cpu: i32, css_remaining: i64
):
    if _engine2d_parent_material_next == 0:
        _engine2d_parent_material_key_a = key
        _engine2d_parent_material_pixels_a = pixels
        _engine2d_parent_material_rendered_a = rendered
        _engine2d_parent_material_cpu_a = cpu
        _engine2d_parent_material_css_a = css_remaining
        _engine2d_parent_material_next = 1
    elif _engine2d_parent_material_next == 1:
        _engine2d_parent_material_key_b = key
        _engine2d_parent_material_pixels_b = pixels
        _engine2d_parent_material_rendered_b = rendered
        _engine2d_parent_material_cpu_b = cpu
        _engine2d_parent_material_css_b = css_remaining
        _engine2d_parent_material_next = 2
    else:
        _engine2d_parent_material_key_c = key
        _engine2d_parent_material_pixels_c = pixels
        _engine2d_parent_material_rendered_c = rendered
        _engine2d_parent_material_cpu_c = cpu
        _engine2d_parent_material_css_c = css_remaining
        _engine2d_parent_material_next = 0

fn _engine2d_embed_offscreen_acquire(
    owner: Engine2D, w: i32, h: i32, failure_reason: [text]
) -> Engine2D:
    # Reuse the cached surface only on an exact size match. The (w, h) sentinel
    # (initial 0x0 never matches a real embedding, which is guarded > 0) makes
    # the first call allocate. Robust to any Option/nil miscodegen on the
    # freestanding path: a missed reuse only costs an extra allocation, never
    # corruption. clear() restores the fully-transparent start state that a
    # fresh create_offscreen() would have; clip/mask are reset so no state
    # leaks between reuses.
    if (_engine2d_embed_pool_w == w and _engine2d_embed_pool_h == h and
        _engine2d_embed_pool_backend == owner.backend_name()):
        if val Some(cached) = _engine2d_embed_pool:
            return cached
    val created = owner.draw_ir_create_offscreen_engine(w, h)
    match created:
        Err(reason):
            if failure_reason.len() > 0:
                failure_reason[0] = reason
            owner
        Ok(fresh):
            _engine2d_embed_pool = Some(fresh)
            _engine2d_embed_pool_w = w
            _engine2d_embed_pool_h = h
            _engine2d_embed_pool_backend = owner.backend_name()
            fresh

# Render one batch's flat command list onto `engine`, with every command's
# local (x, y) shifted by (offset_x, offset_y). Shared by the direct
# translate+clip path and the offscreen embedded-surface path (where
# offset_x/offset_y are 0 since the surface origin IS the batch origin).
# Engine2D is value-copied across this free-function boundary (see
# _engine2d_draw_ir_render_box), so callers reassign the typed outcome engine.
fn _engine2d_draw_ir_render_commands(engine: Engine2D, commands: [DrawIrCommand], offsets: [i32], images: [Engine2dResolvedDrawIrImage], blend_images: bool, metal_device_glass_required: bool, active_clip: DrawIrRect, css_background_pixel_work_budget: i64, material_execution_counts: [i64], reset_surface: bool = false, image_xy: [i64] = [], engine_owner: [Engine2D] = []) -> Engine2dDrawIrRenderOutcome:
    var eng = engine
    var offset_x: i32 = 0
    var offset_y: i32 = 0
    if offsets.len() >= 2:
        offset_x = offsets[0]
        offset_y = offsets[1]
    if reset_surface:
        # Reset after the function's own Engine2D projection so every reset and
        # draw observes the exact same concrete backend payload.
        eng.clear(0x00000000u32)
        eng.clear_clip()
        eng.clear_mask()
    var rendered = 0
    var skipped = 0
    var unsupported_kinds = ""
    var cpu_composited_material_count = 0
    var metal_device_glass_material_count = 0
    var metal_device_glass_requested_count = 0
    var metal_device_glass_unfulfilled_count = 0
    var metal_device_glass_receipts: [Engine2dMetalGlassReceipt] = []
    var glass_execution_target = ""
    var glass_backend_handle: i64 = 0
    var glass_device_identity: i64 = 0
    var css_background_pixel_work_remaining = css_background_pixel_work_budget
    var material_execution_i64: [i64] = [0, 0, 0]
    var material_execution_text: [text] = [""]
    for command in commands:
        # A nil display-list element must be skipped before any field access.
        # Keep the explicit comparison: freestanding codegen has miscompiled
        # `not` in this condition position.
        if command.? == false:
            skipped = skipped + 1
            continue
        val command_kind: text = command.kind
        val profile_command_started_us = rt_time_now_micros()
        val x = offset_x + command.x
        val y = offset_y + command.y
        val command_clip = command.clip_rect
        if command_clip.present:
            val clip = draw_ir_rect_intersection(
                draw_ir_rect_translate(command_clip, offset_x, offset_y),
                active_clip
            )
            eng.set_clip(
                clip.x, clip.y, clip.width, clip.height
            )
        if command_kind == DRAW_IR_COMMAND_RECT:
            # A concrete Metal composition requests a device receipt for every
            # canonical WM glass surface, even when its metadata or bounds are
            # malformed. Counting before execution makes that loss visible to
            # the composition/host fail-closed gate.
            val metal_requested = (metal_device_glass_required and
                _engine2d_draw_ir_style_value(
                    command.computed_style, "wm-material-request") ==
                "window-surface-glass")
            if metal_requested:
                metal_device_glass_requested_count = (
                    metal_device_glass_requested_count + 1)
            material_execution_i64[0] = 0
            material_execution_i64[1] = 0
            material_execution_i64[2] = 0
            material_execution_text[0] = ""
            eng = _engine2d_draw_ir_render_box(
                eng, command, x, y, command.width, command.height,
                material_execution_i64, material_execution_text)
            if _engine2d_draw_ir_style_value(
                command.computed_style, "backdrop-filter-capability") ==
                    "engine2d-cpu-composited-material-v1":
                if _E2D_MATERIAL_TRACE:
                    print "[engine2d-material-handoff] stage=command-return code={material_execution_i64[0]} target={material_execution_text[0]}"
            if material_execution_text[0] == "cpu-scalar-glass-v1":
                cpu_composited_material_count = cpu_composited_material_count + 1
                glass_execution_target = material_execution_text[0]
            elif material_execution_text[0] == "metal-device-glass-v1":
                if (material_execution_i64[1] > 0 and
                    material_execution_i64[2] > 0):
                    metal_device_glass_material_count = (
                        metal_device_glass_material_count + 1)
                    glass_execution_target = material_execution_text[0]
                    glass_backend_handle = material_execution_i64[1]
                    glass_device_identity = material_execution_i64[2]
            if metal_requested and not (
                material_execution_text[0] ==
                    "metal-device-glass-v1" and
                material_execution_i64[1] > 0 and
                material_execution_i64[2] > 0):
                metal_device_glass_unfulfilled_count = (
                    metal_device_glass_unfulfilled_count + 1)
            if metal_requested:
                val fulfilled = (material_execution_text[0] ==
                    "metal-device-glass-v1" and
                    material_execution_i64[1] > 0 and
                    material_execution_i64[2] > 0)
                metal_device_glass_receipts.push(
                    Engine2dMetalGlassReceipt(
                        material_id: command.component_id,
                        fulfilled: fulfilled,
                        execution_target: material_execution_text[0],
                        backend_handle: material_execution_i64[1],
                        device_identity: material_execution_i64[2],
                        readback_source: "",
                        readback_checksum: 0
                    )
                )
            rendered = rendered + 1
        elif command_kind == DRAW_IR_COMMAND_TEXT:
            # Text remains on the canonical Engine2D font/batch route. The
            # generic command clip also covers selection/caret rectangles.
            val font_identity = _engine2d_draw_ir_style_value(command.computed_style, "font-identity")
            var font_ready = true
            val shaped = _engine2d_draw_ir_shaping_requested(command)
            var font_failure_kind = if shaped: "text-font-shaping" else: "text-font-identity"
            val probe_this = _E2D_TEXT_PROBE and _e2d_text_probe_count < 8
            # Level-gated (default off, permanent): pins the font-identity
            # value flowing into eng.select_font_identity from the Draw-IR
            # text command's own computed_style, independent of whether the
            # upstream Style object (fixed in section 16.2) computed it
            # correctly. See doc/08_tracking/bug/
            # jit_run_file_pipeline_gaps_2026-07-30.md section 16.4.
            if _engine2d_draw_ir_trace_font_style_enabled() and font_identity != "":
                print "[draw-ir-font-trace] font_identity={font_identity}"
            if font_identity != "":
                font_ready = eng.select_font_identity(font_identity)
            else if shaped:
                font_ready = false
            if font_ready:
                val encoded_advances = _engine2d_draw_ir_style_value(command.computed_style, "font-advance-widths")
                val has_resolved_advances = command.advance_widths.len() > 0 or encoded_advances != ""
                val advances = _engine2d_draw_ir_text_advances(command)
                if advances.len() > 0:
                    font_failure_kind = if shaped: "text-font-shaping" else: "text-font-batch"
                    # Explicit nested branches (no mixed boolean and/or): the
                    # entry-closure freestanding codegen drops the left operand
                    # of mixed `and`, which sent non-shaped commands into the
                    # shaped branch with an empty glyph run (rerun28: skip
                    # text-font-batch while the advances path's own failure
                    # receipt stayed silent — draw_text_with_advances was
                    # never called).
                    var payload_valid = true
                    if shaped:
                        payload_valid = _engine2d_draw_ir_shaped_payload_valid(command, advances)
                    var drawn = false
                    if shaped:
                        if payload_valid:
                            drawn = eng.draw_shaped_text(x, y, command.glyph_run, command.color, _engine2d_draw_ir_text_font_size(command.computed_style))
                    else:
                        drawn = eng.draw_text_with_advances(x, y, command.text_value, advances, command.color, _engine2d_draw_ir_text_font_size(command.computed_style))
                    if probe_this:
                        _e2d_text_probe_count = _e2d_text_probe_count + 1
                        val branch_kind = if shaped and payload_valid: "shaped" else if not shaped: "resolved" else: "shaped-invalid"
                        val glyph_count = command.glyph_run.glyph_ids.len()
                        print("[e2d-text-probe] ir kind={branch_kind} shaped={shaped} payload_valid={payload_valid} glyphs={glyph_count} advances={advances.len()} drawn={drawn}")
                    if drawn:
                        rendered = rendered + 1
                    else:
                        font_ready = false
                        # Discriminator vs the callee-side receipt: this line
                        # with shaped=false and NO [e2d-batch] line means the
                        # callee returned true but the bool return crossing
                        # delivered false; shaped=true here means the
                        # failure-kind ternary mislabeled a shaped command.
                        val skip_shaped = if shaped: 1 else: 0
                        val skip_payload = if payload_valid: 1 else: 0
                        val skip_font_size = _engine2d_draw_ir_text_font_size(command.computed_style)
                        print("[e2d-ir] draw-false shaped={skip_shaped} payload_valid={skip_payload} advances={advances.len()} text_len={command.text_value.len()} glyphs={command.glyph_run.glyph_ids.len()} size={skip_font_size} text='{command.text_value}'")
                elif has_resolved_advances:
                    font_ready = false
                    font_failure_kind = if shaped: "text-font-shaping" else: "text-font-advances"
                else:
                    if probe_this:
                        _e2d_text_probe_count = _e2d_text_probe_count + 1
                        print("[e2d-text-probe] ir kind=plain len={command.text_value.len()}")
                    eng.draw_text(x, y, command.text_value, command.color, _engine2d_draw_ir_text_font_size(command.computed_style))
                    rendered = rendered + 1
            if not font_ready:
                skipped = skipped + 1
                unsupported_kinds = _engine2d_draw_ir_note_unsupported_kind(unsupported_kinds, font_failure_kind)
        elif command_kind == DRAW_IR_COMMAND_IMAGE:
            val image_index = _engine2d_draw_ir_resolved_image_index(images, command.image_uri)
            if image_index >= 0 and _engine2d_draw_ir_valid_resolved_image(images[image_index]):
                val image = images[image_index]
                if _engine2d_draw_ir_has_css_background_role(command.computed_style):
                    val metadata = _engine2d_draw_ir_css_background_metadata(
                        command)
                    val css_work = (
                        command.width.to_i64() * command.height.to_i64())
                    val css_x = offset_x.to_i64() + command.x.to_i64()
                    val css_y = offset_y.to_i64() + command.y.to_i64()
                    var css_background_budget_admitted = false
                    if (metadata.valid and css_work > 0 and
                        css_work <= css_background_pixel_work_remaining and
                        css_x >= -2147483648 and css_x <= 2147483647 and
                        css_y >= -2147483648 and css_y <= 2147483647):
                        css_background_pixel_work_remaining = (
                            css_background_pixel_work_remaining - css_work)
                        css_background_budget_admitted = true
                    var css = Engine2dCssBackgroundPixels(
                        valid: false, pixels: [])
                    if css_background_budget_admitted:
                        css = _engine2d_draw_ir_css_background_pixels(
                            command, image,
                            command.x.to_i64(), command.y.to_i64(),
                            command.width.to_i64() * command.height.to_i64())
                    if css.valid:
                        eng.draw_image_blend(
                            css_x.to_i32(), css_y.to_i32(),
                            command.width, command.height, css.pixels)
                        rendered = rendered + 1
                    else:
                        skipped = skipped + 1
                        unsupported_kinds = _engine2d_draw_ir_note_unsupported_kind(
                            unsupported_kinds, "image-css-background")
                else:
                    var packed_exact_status: i32 = 0
                    var packed_x = x
                    var packed_y = y
                    var sidecar_position = false
                    if _e2d_owner_image_xy_active:
                        if image_index == 0:
                            packed_x = _e2d_owner_image_x0.to_i32()
                            packed_y = _e2d_owner_image_y0.to_i32()
                            sidecar_position = true
                        elif image_index == 1:
                            packed_x = _e2d_owner_image_x1.to_i32()
                            packed_y = _e2d_owner_image_y1.to_i32()
                            sidecar_position = true
                        elif image_index == 2:
                            packed_x = _e2d_owner_image_x2.to_i32()
                            packed_y = _e2d_owner_image_y2.to_i32()
                            sidecar_position = true
                    val active_image_xy = if _e2d_prepared_image_xy_active:
                        _e2d_prepared_image_xy
                    else:
                        image_xy
                    val image_xy_index = image_index * 2
                    if not sidecar_position and image_xy_index >= 0 and image_xy_index + 1 < active_image_xy.len():
                        val sidecar_x = active_image_xy[image_xy_index]
                        val sidecar_y = active_image_xy[image_xy_index + 1]
                        if sidecar_x >= 0 and sidecar_x <= 2147483647:
                            if sidecar_y >= 0 and sidecar_y <= 2147483647:
                                val sidecar_right = sidecar_x + image.width.to_i64()
                                val sidecar_bottom = sidecar_y + image.height.to_i64()
                                if sidecar_right <= eng.width().to_i64() and sidecar_bottom <= eng.height().to_i64():
                                    packed_x = sidecar_x.to_i32()
                                    packed_y = sidecar_y.to_i32()
                                    sidecar_position = true
                    if not sidecar_position and command.image_uri.starts_with("wmabs:"):
                        packed_x = _engine2d_draw_ir_nth_int(
                            command.image_uri, 0, x).to_i32()
                        packed_y = _engine2d_draw_ir_nth_int(
                            command.image_uri, 1, y).to_i32()
                    if not sidecar_position and not command.image_uri.starts_with("wmabs:"):
                        if command.component_id.starts_with("wmabs:"):
                            packed_x = _engine2d_draw_ir_nth_int(
                                command.component_id, 0, x).to_i32()
                            packed_y = _engine2d_draw_ir_nth_int(
                                command.component_id, 1, y).to_i32()
                    val wm_absolute_x = _engine2d_draw_ir_style_value(
                        command.computed_style, "wm-absolute-x")
                    val wm_absolute_y = _engine2d_draw_ir_style_value(
                        command.computed_style, "wm-absolute-y")
                    if not sidecar_position and not command.image_uri.starts_with("wmabs:"):
                        if not command.component_id.starts_with("wmabs:"):
                            if wm_absolute_x != "":
                                if wm_absolute_y != "":
                                    packed_x = _engine2d_draw_ir_nth_int(
                                        wm_absolute_x, 0, x).to_i32()
                                    packed_y = _engine2d_draw_ir_nth_int(
                                        wm_absolute_y, 0, y).to_i32()
                    if eng.backend_name() == "baremetal":
                        if command.width == image.width:
                            if command.height == image.height:
                                if _e2d_prepared_image_xy_active:
                                    packed_exact_status = eng.draw_ir_blit_image_prepared_opaque_status(
                                        packed_x, packed_y, image.width, image.height, image.pixels)
                                else:
                                    packed_exact_status = eng.draw_ir_blit_image_exact_status(
                                        packed_x, packed_y, image.width, image.height, image.pixels)
                    if _e2d_exact_image_probe_count < 6:
                        _e2d_exact_image_probe_count = _e2d_exact_image_probe_count + 1
                        print "[engine2d-image-profile] packed_status={packed_exact_status} xy={packed_x},{packed_y} command={command.width}x{command.height} image={image.width}x{image.height} pixels={image.pixels.len()} backend={eng.backend_name()}"
                    if packed_exact_status <= 0 and blend_images and not _engine2d_draw_ir_image_is_opaque(image):
                        if command.width == image.width and command.height == image.height:
                            eng.draw_image_blend(x, y, image.width, image.height, image.pixels)
                        else:
                            eng.draw_image_scaled_blend(x, y, command.width, command.height, image.width, image.height, image.pixels)
                    elif packed_exact_status <= 0:
                        eng.draw_image_scaled(x, y, command.width, command.height, image.width, image.height, image.pixels)
                    rendered = rendered + 1
            else:
                if not _e2d_image_lookup_failure_profiled:
                    _e2d_image_lookup_failure_profiled = true
                    val first_image_uri = if images.len() > 0:
                        images[0].image_uri
                    else:
                        ""
                    val first_image_width = if images.len() > 0: images[0].width else: -1
                    val first_image_height = if images.len() > 0: images[0].height else: -1
                    val first_image_pixels = if images.len() > 0: images[0].pixels.len() else: -1
                    print "[engine2d-image-lookup-failure] command={command.image_uri} command_size={command.width}x{command.height} images={images.len()} first={first_image_uri} image_size={first_image_width}x{first_image_height} pixels={first_image_pixels}"
                skipped = skipped + 1
                unsupported_kinds = _engine2d_draw_ir_note_unsupported_kind(unsupported_kinds, command_kind)
        else:
            skipped = skipped + 1
            unsupported_kinds = _engine2d_draw_ir_note_unsupported_kind(unsupported_kinds, command_kind)
        if command_clip.present:
            if active_clip.present:
                eng.set_clip(
                    active_clip.x, active_clip.y,
                    active_clip.width, active_clip.height
                )
            else:
                eng.clear_clip()
        if _e2d_wm_command_profile_active:
            val profile_command_finished_us = rt_time_now_micros()
            print "[engine2d-command-profile] kind={command_kind} id={command.component_id} elapsed_us={profile_command_finished_us - profile_command_started_us}"
    if material_execution_counts.len() >= 6:
        material_execution_counts[0] = cpu_composited_material_count.to_i64()
        material_execution_counts[1] = metal_device_glass_material_count.to_i64()
        material_execution_counts[2] = metal_device_glass_requested_count.to_i64()
        material_execution_counts[3] = metal_device_glass_unfulfilled_count.to_i64()
        material_execution_counts[4] = rendered.to_i64()
        material_execution_counts[5] = skipped.to_i64()
    # Freestanding native class values are copied at free-function boundaries.
    # Capture software pixels while `eng` is still the exact command receiver;
    # transporting Engine2D through an aggregate or array sidecar loses this
    # owner on the current Stage3 ABI.
    if eng.backend_name() == "software" and rendered > 0:
        # Keep the pixel array as the direct scalar method result. Wrapping it
        # in Engine2DReadback recreates the nested aggregate projection defect
        # this owner-side path exists to avoid.
        _e2d_command_owner_readback_pixels = eng.read_pixels()
        if (_e2d_command_owner_probe_count < 3 and
            _e2d_command_owner_readback_pixels.len() ==
                eng.width().to_i64() * eng.height().to_i64()):
            _e2d_command_owner_probe_count = _e2d_command_owner_probe_count + 1
            val owner_center = (
                (eng.height() / 2).to_i64() * eng.width().to_i64() +
                (eng.width() / 2).to_i64())
            print "[draw-ir-owner-pixels] width={eng.width()} height={eng.height()} first={_e2d_command_owner_readback_pixels[0]} center={_e2d_command_owner_readback_pixels[owner_center]} last={_e2d_command_owner_readback_pixels[_e2d_command_owner_readback_pixels.len() - 1]}"
    if engine_owner.len() > 0:
        engine_owner[0] = eng
    _engine2d_draw_ir_render_outcome(
        eng,
        rendered,
        skipped,
        unsupported_kinds,
        cpu_composited_material_count,
        metal_device_glass_material_count,
        metal_device_glass_requested_count,
        metal_device_glass_unfulfilled_count,
        metal_device_glass_receipts,
        glass_execution_target,
        glass_backend_handle,
        glass_device_identity,
        css_background_pixel_work_remaining
    )

fn _engine2d_draw_ir_command_samples_parent(command: DrawIrCommand) -> bool:
    if command.? == false or command.kind != DRAW_IR_COMMAND_RECT:
        return false
    if (_engine2d_draw_ir_style_value(
        command.computed_style, "wm-material-request") !=
        "window-surface-glass"):
        return false
    val capability = _engine2d_draw_ir_style_value(
        command.computed_style, "backdrop-filter-capability")
    capability == "engine2d-composited-glass-material-v1" or capability == "engine2d-cpu-composited-material-v1"

fn _engine2d_draw_ir_batch_samples_parent(batch: DrawIrBatch) -> bool:
    for command in batch.commands:
        if _engine2d_draw_ir_command_samples_parent(command):
            return true
    false

fn _engine2d_draw_ir_parent_material_request_count(batch: DrawIrBatch) -> i32:
    var count = 0
    for command in batch.commands:
        if _engine2d_draw_ir_command_samples_parent(command):
            count = count + 1
    count

fn _engine2d_draw_ir_unfulfilled_metal_receipts(batch: DrawIrBatch) -> [Engine2dMetalGlassReceipt]:
    var receipts: [Engine2dMetalGlassReceipt] = []
    for command in batch.commands:
        if _engine2d_draw_ir_command_samples_parent(command):
            receipts.push(Engine2dMetalGlassReceipt(
                material_id: command.component_id,
                fulfilled: false,
                execution_target: "unavailable",
                backend_handle: 0,
                device_identity: 0,
                readback_source: "",
                readback_checksum: 0
            ))
    receipts

fn _engine2d_draw_ir_receipts_with_readback(receipts: [Engine2dMetalGlassReceipt], readback: Engine2DReadback) -> [Engine2dMetalGlassReceipt]:
    var completed: [Engine2dMetalGlassReceipt] = []
    for receipt in receipts:
        completed.push(Engine2dMetalGlassReceipt(
            material_id: receipt.material_id,
            fulfilled: receipt.fulfilled,
            execution_target: receipt.execution_target,
            backend_handle: receipt.backend_handle,
            device_identity: receipt.device_identity,
            readback_source: readback.source,
            readback_checksum: readback.checksum
        ))
    completed

# Return exactly the already-painted parent region that a translucent WM
# material is allowed to sample. An empty result is an invalid request, never
# a transparent substitute: transparent seeding would make the material lie
# about its backdrop while still returning a receipt.
fn _engine2d_draw_ir_parent_region_pixels(
    readback: Engine2DReadback, parent_width: i32, parent_height: i32,
    x: i32, y: i32, width: i32, height: i32
) -> [u32]:
    _engine2d_draw_ir_parent_region_pixels_raw(
        readback.pixels, parent_width, parent_height, x, y, width, height)

fn _engine2d_draw_ir_parent_region_pixels_raw(
    pixels: [u32], parent_width: i32, parent_height: i32,
    x: i32, y: i32, width: i32, height: i32
) -> [u32]:
    if (parent_width <= 0 or parent_height <= 0 or width <= 0 or height <= 0 or
        pixels.len() != parent_width.to_i64() * parent_height.to_i64()):
        return []
    var region: [u32] = []
    var row = 0
    while row < height:
        var column = 0
        while column < width:
            val source_x = x + column
            val source_y = y + row
            if (source_x >= 0 and source_y >= 0 and
                source_x < parent_width and source_y < parent_height):
                val source_index = source_y.to_i64() * parent_width.to_i64() +
                    source_x.to_i64()
                region.push(pixels[source_index])
            else:
                # Match the glass helper's actual framebuffer edge semantics.
                region.push(0u32)
            column = column + 1
        row = row + 1
    region

# D9: region-limited readback seam. No backend below exposes a device-side
# region read yet (RenderBackend only has whole-framebuffer
# read_pixels_with_source()), so this is the DEFAULT implementation: read the
# full frame once, exactly as every call site already did, and crop on the
# host with _engine2d_draw_ir_parent_region_pixels. Pixel-for-pixel identical
# to a caller doing eng.read_pixels_with_source() then cropping itself by
# hand -- see engine2d_read_pixels_region_equivalence_spec.spl -- so this
# alone removes no work. What it buys: every "I only need this rect" call
# site now asks a single seam for exactly its rect instead of the whole
# framebuffer, so a future backend-specific region read (a real device-side
# crop) can be dropped in behind this one function with no call-site changes.
fn _engine2d_read_pixels_region(engine: Engine2D, x: i32, y: i32, width: i32, height: i32) -> Engine2DReadback:
    var eng = engine
    val full = eng.read_pixels_with_source()
    val cropped = _engine2d_draw_ir_parent_region_pixels(
        full, eng.width(), eng.height(), x, y, width, height)
    engine2d_readback_with_identity(
        cropped, full.source, full.backend_handle, full.device_identity)

fn _engine2d_read_pixels_region_pixels(engine: Engine2D, x: i32, y: i32, width: i32, height: i32) -> [u32]:
    val total = width.to_i64() * height.to_i64()
    if width <= 0 or height <= 0 or total <= 0 or total > 2147483647:
        return []
    var region_pixels: [u32] = [0u32; total]
    val copied = engine.copy_pixels_region_into(
        x, y, width, height, region_pixels
    ).to_i64()
    if copied != total:
        return []
    region_pixels

fn _engine2d_draw_ir_parent_material_padding(batch: DrawIrBatch) -> i32:
    var padding = 0
    for command in batch.commands:
        if _engine2d_draw_ir_command_samples_parent(command):
            var blur = _engine2d_draw_ir_nth_int(
                _engine2d_draw_ir_style_value(
                    command.computed_style,
                    "backdrop-filter-realized-blur-radius-px"), 0, 0) as i32
            if blur < 0:
                blur = 0
            # Material producers currently realize at 4px. Cap hostile input
            # so a malformed style cannot force an unbounded parent snapshot.
            if blur > 64:
                blur = 64
            if blur > padding:
                padding = blur
    padding

# Render one batch onto `engine`, honoring a real embedded render target when
# the batch declares a non-empty embedding.surface_id: the batch's commands
# render into a fresh offscreen Engine2D sized embedding.width x
# embedding.height (positioned relative to the SURFACE origin, i.e. WITHOUT
# adding embedding.x/y — that offset applies exactly once, at composite time
# below), then the finished surface is stitched into `engine` at
# (embedding.x, embedding.y) honoring embedding.opacity_milli. The offscreen
# buffer's own bounds enforce embedding.clip for free (commands can never
# paint outside a canvas that small), so `clip` needs no extra handling here.
#
# Batches with an empty surface_id (or a degenerate/too-deep embedding) keep
# today's exact direct translate+clip behavior — this is the load-bearing
# backward-compatibility path: no regression for callers that never opted
# into a real embedded surface.
fn _engine2d_draw_ir_render_batch_embedded(engine: Engine2D, batch: DrawIrBatch, images: [Engine2dResolvedDrawIrImage], depth: i32, allow_parent_image: bool, css_background_pixel_work_budget: i64, batch_execution_counts: [i64], visual_key: text, batch_offsets: [i32], image_xy: [i64] = [], engine_owner: [Engine2D] = []) -> Engine2dDrawIrRenderOutcome:
    var eng = engine
    # Preserve the nested Draw IR struct layout across the native
    # free-function boundary. Native inference has historically treated an
    # unannotated field projection as a generic runtime value here.
    val embedding: DrawIrEmbeddingConfig = batch.embedding
    # Keep the command array typed for the same reason. A production SimpleOS
    # entry-closure build lowered `batch.commands.len()` as an impl-less trait
    # call and trapped before the first WM frame.
    val commands: [DrawIrCommand] = batch.commands
    if commands.len() == 0:
        return _engine2d_draw_ir_render_outcome(eng, 0, 0, "", 0)
    # Perf short-circuit: a batch whose embedding is (0,0) at full opacity and
    # EXACTLY the size of the target it renders onto composites as a plain 1:1
    # copy with no cropping/offset/alpha effect — offscreen-then-blit would be
    # provably identical pixels for strictly more work (an extra full-size
    # buffer alloc/init/clear plus a second full-canvas read_pixels+blend
    # pass). Root/full-page batches (e.g. widget_draw_ir.spl's "widget-root",
    # window_scene_draw_ir.spl's desktop batch) hit this every render, so
    # skipping the redundant round trip here matters under the interpreter
    # (see doc/08_tracking/bug/engine2d_interpreted_mirror_dominates_render_2026-07-03.md
    # for the same class of cost). Smaller/offset/sub-opaque batches (real
    # windows, dialogs, thumbnails) are unaffected and still get a real
    # offscreen surface.
    # Keep the full-target decision in typed scalar locals. The native Metal
    # path previously mis-evaluated the compact mixed field/method expression
    # below for a browser-produced embedding even though the caller observed
    # (0,0,320,240,1000) and the engine was 320x240. That incorrectly created
    # a shared offscreen target for a root batch and corrupted its command
    # decoding. Simple scalar comparisons preserve the intended fast path.
    val target_width: i32 = eng.width()
    val target_height: i32 = eng.height()
    val embedding_x: i32 = embedding.x
    val embedding_y: i32 = embedding.y
    val embedding_width: i32 = embedding.width
    val embedding_height: i32 = embedding.height
    val embedding_opacity: i32 = embedding.opacity_milli
    val origin_matches = embedding_x == 0 and embedding_y == 0
    val size_matches = embedding_width == target_width and embedding_height == target_height
    val fully_opaque = embedding_opacity >= 1000
    val fills_target_exactly = origin_matches and size_matches and fully_opaque
    # Backdrop material is defined against pixels already painted by earlier
    # composition batches. Rendering such a window into a fresh transparent
    # child changes its input and invalidates both pixels and receipts. Keep
    # ordinary embedded content isolated, but execute the canonical material
    # batch directly and in-order on the parent under the embedding clip.
    val samples_parent = _engine2d_draw_ir_batch_samples_parent(batch)
    # A sub-region batch only NEEDS a real offscreen surface when it either
    # (a) requires alpha compositing (opacity < 100%), or (b) has its own
    # dedicated device-shared-offscreen path (vulkan/metal, wired below).
    # Everything else (opaque, CPU/baremetal-backed, wanting clip) is exactly
    # equivalent to rendering directly onto the parent engine with its clip
    # rect set to the embedding bounds -- same reasoning `fills_target_exactly`
    # already applies to the full-page case, generalized to sub-regions.
    # This also sidesteps `Engine2D.create_offscreen()`'s plain CPU/software
    # offscreen path, whose `RenderBackend` trait-object dispatch
    # (`self.backend.draw_rect_filled(...)`) has been observed to fault with
    # a garbage instruction pointer on the freestanding cranelift codegen path
    # for a `SoftwareBackend` boxed this way -- a compiler/codegen defect
    # filed for follow-up, not something fixable at this call site.
    val needs_real_offscreen = embedding.opacity_milli < 1000 or eng.backend_name() == "vulkan" or eng.backend_name() == "metal"
    # Opaque baremetal batches can render directly into the MMIO parent: the
    # command loop already applies embedding offsets, and no opacity surface
    # or device-shared target is needed. This avoids one full-frame software
    # allocation per desktop/chrome/taskbar batch on the bump-only OS heap.
    val baremetal_direct = eng.backend_name() == "baremetal" and embedding.opacity_milli >= 1000
    val use_embedded_surface = embedding.surface_id != "" and depth < ENGINE2D_DRAW_IR_EMBED_MAX_DEPTH and embedding.width > 0 and embedding.height > 0 and not fills_target_exactly and not samples_parent and (needs_real_offscreen or (not embedding.clip and not baremetal_direct))
    # Every parent-sampling batch uses one seeded delta owner. Translucent
    # batches require it for opacity correctness; opaque batches use the same
    # route so an unchanged, checksum-proven material raster can be retained.
    # The final composite always honors embedding.opacity_milli.
    if samples_parent:
        # Metal's device glass helper rejects non-gpu-only targets.  Do not
        # manufacture a mirror-backed child merely to make this branch appear
        # to work: that would turn an inactive (930) surface into a CPU
        # fallback while the selected backend still says Metal.  A future
        # device-only delta target may replace this explicit fail-closed gate.
        if batch.backend_target == "metal" and eng.backend_name() == "metal":
            val requested = _engine2d_draw_ir_parent_material_request_count(batch)
            return _engine2d_draw_ir_render_outcome(
                eng, 0, batch.commands.len().to_i32(),
                "metal-parent-material-subopaque-requires-gpu-only-delta", 0,
                0, requested, requested,
                _engine2d_draw_ir_unfulfilled_metal_receipts(batch)
            )
        val parent_padding = _engine2d_draw_ir_parent_material_padding(batch)
        val delta_width = embedding.width + parent_padding * 2
        val delta_height = embedding.height + parent_padding * 2
        # A composition scene key is the canonical immutable visual identity
        # for prepared replay.  Admit a retained material before copying or
        # checksumming its parent region; a changed scene/style/geometry/backend
        # key misses and executes the canonical seeded path below.
        val material_cache_key = _engine2d_parent_material_cache_key(
            batch, visual_key, parent_padding)
        val material_cache_slot = _engine2d_parent_material_cache_slot(
            material_cache_key)
        if visual_key != "" and material_cache_slot >= 0:
            val cached_pixels = _engine2d_parent_material_cache_pixels(
                material_cache_slot)
            if cached_pixels.len() == embedding.width.to_i64() * embedding.height.to_i64():
                val cached_readback = engine2d_readback(
                    cached_pixels, "software")
                val cached_composited = eng.draw_ir_composite_readback(
                    embedding.x, embedding.y, embedding.width,
                    embedding.height, cached_readback, embedding_opacity)
                if cached_composited:
                    val cached_rendered = _engine2d_parent_material_cache_rendered(
                        material_cache_slot)
                    val cached_cpu = _engine2d_parent_material_cache_cpu(
                        material_cache_slot)
                    val cached_css = _engine2d_parent_material_cache_css(
                        material_cache_slot)
                    if batch_execution_counts.len() >= 6:
                        batch_execution_counts[0] = cached_cpu.to_i64()
                        batch_execution_counts[1] = 0
                        batch_execution_counts[2] = 0
                        batch_execution_counts[3] = 0
                        batch_execution_counts[4] = cached_rendered.to_i64()
                        batch_execution_counts[5] = 0
                    return _engine2d_draw_ir_render_outcome(
                        eng, cached_rendered, 0, "", cached_cpu,
                        0, 0, 0, [], "cpu-composited-material",
                        0, 0, cached_css)
        # D9: was a full-frame eng.read_pixels_with_source() every call, even
        # though only this one glass rect is needed. Route through the
        # region-limited seam instead -- see
        # engine2d_read_pixels_region_equivalence_spec.spl for the proof that
        # this returns pixels identical to the old full-read-then-crop path.
        val seed = _engine2d_read_pixels_region_pixels(
            eng, embedding.x - parent_padding, embedding.y - parent_padding,
            delta_width, delta_height)
        if seed.len() != delta_width.to_i64() * delta_height.to_i64():
            return _engine2d_draw_ir_render_outcome(
                eng, 0, batch.commands.len().to_i32(),
                "parent-material-seed-unavailable", 0)
        val seeded_surface = eng.draw_ir_create_offscreen_engine(
            delta_width, delta_height)
        match seeded_surface:
            Err(reason):
                return _engine2d_draw_ir_render_outcome(
                    eng, 0, batch.commands.len().to_i32(),
                    "parent-material-offscreen-unavailable:{reason}", 0)
            Ok(child):
                var delta = child
                delta.draw_image(0, 0, delta_width, delta_height, seed)
                var inner_material_counts: [i64] = [0, 0, 0, 0, 0, 0]
                var inner_offsets: [i32] = [parent_padding, parent_padding]
                val inner = _engine2d_draw_ir_render_commands(
                    delta, batch.commands, inner_offsets, images, true,
                    batch.backend_target == "metal", draw_ir_no_rect(),
                    css_background_pixel_work_budget, inner_material_counts, false,
                    image_xy)
                if batch_execution_counts.len() >= 6:
                    batch_execution_counts[0] = inner_material_counts[0]
                    batch_execution_counts[1] = inner_material_counts[1]
                    batch_execution_counts[2] = inner_material_counts[2]
                    batch_execution_counts[3] = inner_material_counts[3]
                    batch_execution_counts[4] = inner_material_counts[4]
                    batch_execution_counts[5] = inner_material_counts[5]
                val child_readback = delta.read_pixels_with_source()
                val child_core = _engine2d_draw_ir_parent_region_pixels(
                    child_readback, delta_width, delta_height,
                    parent_padding, parent_padding,
                    embedding.width, embedding.height)
                val child_core_readback = engine2d_readback_with_identity(
                    child_core, child_readback.source,
                    child_readback.backend_handle,
                    child_readback.device_identity)
                val composited = eng.draw_ir_composite_readback(
                    embedding.x, embedding.y, embedding.width,
                    embedding.height, child_core_readback, embedding_opacity)
                delta.shutdown()
                if not composited:
                    return _engine2d_draw_ir_render_outcome(
                        eng, 0, batch.commands.len().to_i32(),
                        "parent-material-delta-composite-not-proven", 0,
                        0, 0, 0, [], "", 0, 0,
                        inner.css_background_pixel_work_remaining)
                _engine2d_parent_material_cache_store(
                    material_cache_key, child_core, inner.rendered,
                    inner_material_counts[0].to_i32(),
                    inner.css_background_pixel_work_remaining)
                return _engine2d_draw_ir_render_outcome(
                    eng, inner.rendered, inner.skipped,
                    inner.unsupported_kinds,
                    inner_material_counts[0].to_i32(),
                    inner.metal_device_glass_material_count,
                    inner.metal_device_glass_requested_count,
                    inner.metal_device_glass_unfulfilled_count,
                    inner.metal_device_glass_receipts,
                    inner.glass_execution_target,
                    inner.glass_backend_handle,
                    inner.glass_device_identity,
                    inner.css_background_pixel_work_remaining)
    if not use_embedded_surface:
        val apply_clip = embedding.clip and not fills_target_exactly
        if apply_clip:
            eng.set_clip(embedding.x, embedding.y, embedding.width, embedding.height)
        val blend_images = allow_parent_image or (embedding.surface_id != "" and fills_target_exactly)
        var direct_material_counts: [i64] = [0, 0, 0, 0, 0, 0]
        var direct_offsets: [i32] = [embedding.x, embedding.y]
        if batch_offsets.len() >= 2:
            direct_offsets[0] = batch_offsets[0]
            direct_offsets[1] = batch_offsets[1]
        var command_engine_owner: [Engine2D] = [eng]
        val direct = _engine2d_draw_ir_render_commands(
            eng, commands, direct_offsets, images,
            blend_images, batch.backend_target == "metal",
            if apply_clip:
                draw_ir_rect_bounds(
                    embedding.x, embedding.y, embedding.width, embedding.height
                )
            else:
                draw_ir_no_rect(),
            css_background_pixel_work_budget, direct_material_counts, false,
            image_xy, command_engine_owner)
        eng = command_engine_owner[0]
        if batch_execution_counts.len() >= 6:
            batch_execution_counts[0] = direct_material_counts[0]
            batch_execution_counts[1] = direct_material_counts[1]
            batch_execution_counts[2] = direct_material_counts[2]
            batch_execution_counts[3] = direct_material_counts[3]
            batch_execution_counts[4] = direct_material_counts[4]
            batch_execution_counts[5] = direct_material_counts[5]
        if apply_clip:
            eng.clear_clip()
        if engine_owner.len() > 0:
            engine_owner[0] = eng
        return _engine2d_draw_ir_render_outcome(
            eng,
            direct.rendered,
            direct.skipped,
            direct.unsupported_kinds,
            direct_material_counts[0].to_i32(),
            direct.metal_device_glass_material_count,
            direct.metal_device_glass_requested_count,
            direct.metal_device_glass_unfulfilled_count,
            direct.metal_device_glass_receipts,
            direct.glass_execution_target,
            direct.glass_backend_handle,
            direct.glass_device_identity,
            direct.css_background_pixel_work_remaining
        )

    # Seed-JIT compatibility (hot path): a mutable `Engine2D? = nil` binding
    # trips the seed's W1003 shared-pointer check, and `?? return` has no seed
    # parse — either one silently drops this per-frame function from the JIT,
    # leaving every DrawIR batch interpreted. Track the offscreen as a plain
    # var + created flag instead. See
    # doc/08_tracking/bug/seed_parser_no_return_expression_kills_jit_2026-07-26.md
    var offscreen = eng
    var offscreen_created = false
    var offscreen_pooled = false
    if eng.backend_name() != "vulkan" and eng.backend_name() != "metal" and depth == 0:
        # Software/baremetal offscreen: borrow the shared single-slot pool at
        # the (non-reentrant) top level so a fresh ~8 MB surface is not charged
        # to the non-reclaiming bump heap per translucent window. Nested embeds
        # (depth > 0, currently unreachable but kept correct) use a fresh
        # surface so an in-flight parent buffer is never clobbered.
        var pool_failure: [text] = [""]
        val pooled = _engine2d_embed_offscreen_acquire(
            eng, embedding.width, embedding.height, pool_failure)
        if pool_failure[0] != "":
            return _engine2d_draw_ir_render_outcome(
                eng, 0, commands.len().to_i32(), pool_failure[0], 0)
        offscreen = pooled
        # Reset the exact local identity that is passed to the renderer. A
        # pooled class may cross Option/direct-return lowering on acquisition;
        # resetting inside the acquire owner can therefore mutate a different
        # projected payload than the caller subsequently draws through.
        offscreen_created = true
        offscreen_pooled = true
    else:
        val created = eng.draw_ir_create_offscreen_engine(
            embedding.width, embedding.height)
        match created:
            Err(reason):
                return _engine2d_draw_ir_render_outcome(
                    eng, 0, commands.len().to_i32(), reason, 0)
            Ok(target):
                offscreen = target
                offscreen_created = true
    if not offscreen_created:
        return _engine2d_draw_ir_render_outcome(
            eng,
            0,
            commands.len().to_i32(),
            "embedded-offscreen-not-created",
            0
        )
    var inner_material_counts: [i64] = [0, 0, 0, 0, 0, 0]
    var offscreen_offsets: [i32] = [0, 0]
    val inner = _engine2d_draw_ir_render_commands(
        offscreen, commands, offscreen_offsets, images, true,
        batch.backend_target == "metal", draw_ir_no_rect(),
        css_background_pixel_work_budget, inner_material_counts, true,
        image_xy)
    if batch_execution_counts.len() >= 6:
        batch_execution_counts[0] = inner_material_counts[0]
        batch_execution_counts[1] = inner_material_counts[1]
        batch_execution_counts[2] = inner_material_counts[2]
        batch_execution_counts[3] = inner_material_counts[3]
        batch_execution_counts[4] = inner_material_counts[4]
        batch_execution_counts[5] = inner_material_counts[5]
    val child = offscreen.read_pixels_with_source()
    val composited = eng.draw_ir_composite_readback(
        embedding.x,
        embedding.y,
        embedding.width,
        embedding.height,
        child,
        embedding.opacity_milli
    )
    # A pooled offscreen is retained for the next same-size batch (and future
    # frames); shutting it down would free its buffer and defeat the reuse.
    if not offscreen_pooled:
        offscreen.shutdown()
    if not composited:
        return _engine2d_draw_ir_render_outcome(
            eng,
            0,
            commands.len().to_i32(),
            "embedded-device-composite-not-proven",
            0, 0, 0, 0, [], "", 0, 0,
            inner.css_background_pixel_work_remaining
        )
    _engine2d_draw_ir_render_outcome(
        eng,
        inner.rendered,
        inner.skipped,
        inner.unsupported_kinds,
        # A material receipt proves composition against the destination pixels
        # visible to the material helper. An embedded/offscreen surface starts
        # transparent and does not sample its already-painted parent backdrop,
        # so its inner helper result is deliberately not a parent receipt.
        # Keep rendering/accounting intact but fail closed on this evidence.
        0,
        0,
        inner.metal_device_glass_requested_count,
        inner.metal_device_glass_requested_count,
        _engine2d_draw_ir_unfulfilled_metal_receipts(batch),
        "", 0, 0, inner.css_background_pixel_work_remaining
    )

fn engine2d_draw_ir_adv_batch(engine: Engine2D, batch: DrawIrBatch, gpu_available: bool) -> Engine2dDrawIrAdvResult:
    var images: [Engine2dResolvedDrawIrImage] = []
    engine2d_draw_ir_adv_batch_with_images(engine, batch, gpu_available, images)

fn engine2d_draw_ir_adv_batch_with_images(engine: Engine2D, batch: DrawIrBatch, gpu_available: bool, images: [Engine2dResolvedDrawIrImage]) -> Engine2dDrawIrAdvResult:
    val plan = simple_2d_draw_ir_adv_plan(batch, gpu_available)
    var eng = engine
    var batch_execution_counts: [i64] = [0, 0, 0, 0, 0, 0]
    var batch_offsets: [i32] = [batch.embedding.x, batch.embedding.y]
    val outcome = _engine2d_draw_ir_render_batch_embedded(
        eng, batch, images, 0, false,
        eng.width().to_i64() * eng.height().to_i64(), batch_execution_counts, "", batch_offsets)
    eng = outcome.engine
    var unsupported_kinds = outcome.unsupported_kinds
    if unsupported_kinds == "":
        unsupported_kinds = "none"
    val readback = eng.read_pixels_with_source()
    var result = _engine2d_draw_ir_result_from_plan_with_unsupported(
        plan,
        batch_execution_counts[4].to_i32(),
        batch_execution_counts[5].to_i32(),
        unsupported_kinds,
        readback
    )
    result.cpu_composited_material_count = batch_execution_counts[0].to_i32()
    result.metal_device_glass_material_count = (
        outcome.metal_device_glass_material_count)
    result.metal_device_glass_requested_count = (
        outcome.metal_device_glass_requested_count)
    result.metal_device_glass_unfulfilled_count = (
        outcome.metal_device_glass_unfulfilled_count)
    result.metal_device_glass_receipts = _engine2d_draw_ir_receipts_with_readback(
        outcome.metal_device_glass_receipts, readback)
    result.glass_execution_target = outcome.glass_execution_target
    result.glass_backend_handle = outcome.glass_backend_handle
    result.glass_device_identity = outcome.glass_device_identity
    result

fn engine2d_draw_ir_adv_composition(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool) -> Engine2dDrawIrAdvResult:
    var images: [Engine2dResolvedDrawIrImage] = []
    val result = engine2d_draw_ir_adv_composition_with_images(engine, composition, gpu_available, images)
    result

fn engine2d_draw_ir_adv_composition_with_images(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage]) -> Engine2dDrawIrAdvResult:
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: [], evidence_text: [])
    val result = _engine2d_draw_ir_adv_composition_with_images(engine, composition, gpu_available, images, false, true, true, transport, "")
    result

fn engine2d_draw_ir_adv_composition_with_images_into(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], destination: [u32]) -> i32:
    var transport_status: [i32] = [-4]
    val transport = Engine2dDrawIrTransport(destination: destination, status: transport_status, evidence_i64: [], evidence_text: [])
    _engine2d_draw_ir_adv_composition_with_images(
        engine, composition, gpu_available, images, false, true, true,
        transport, ""
    )
    transport_status[0]

# Caller-owned evidence transport for native/freestanding targets. The large
# Engine2dDrawIrAdvResult remains the canonical public result, but material
# provenance consumers must not recover its nested fields after return on a
# toolchain whose aggregate ABI can lose them.
fn engine2d_draw_ir_adv_composition_with_images_into_evidence(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], destination: [u32], evidence_i64: [i64], evidence_text: [text]) -> i32:
    var transport_status: [i32] = [-4]
    val transport = Engine2dDrawIrTransport(destination: destination, status: transport_status, evidence_i64: evidence_i64, evidence_text: evidence_text)
    _engine2d_draw_ir_adv_composition_with_images(
        engine, composition, gpu_available, images, false, true, true,
        transport, ""
    )
    transport_status[0]

fn engine2d_draw_ir_adv_composition_present_with_images(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage]) -> Engine2dDrawIrAdvResult:
    """Render and present a composition without requesting a result readback."""
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: [], evidence_text: [])
    _engine2d_draw_ir_adv_composition_with_images(engine, composition, gpu_available, images, false, true, false, transport, "")

fn engine2d_draw_ir_adv_composition_present_with_images_evidence(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], evidence_i64: [i64], evidence_text: [text]) -> Engine2dDrawIrAdvResult:
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: evidence_i64, evidence_text: evidence_text)
    _engine2d_draw_ir_adv_composition_with_images(engine, composition, gpu_available, images, false, true, false, transport, "")

fn engine2d_draw_ir_adv_composition_present_with_owner_xy_evidence(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64, evidence_i64: [i64], evidence_text: [text]) -> Engine2dDrawIrAdvResult:
    """Present a fresh composition with scalar owner-derived image positions."""
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: evidence_i64, evidence_text: evidence_text)
    engine2d_draw_ir_adv_set_owner_image_xy(x0, y0, x1, y1, x2, y2)
    val result = _engine2d_draw_ir_adv_composition_with_images(
        engine, composition, gpu_available, images, false, true, false,
        transport, "")
    engine2d_draw_ir_adv_clear_owner_image_xy()
    result

fn engine2d_draw_ir_adv_composition_present_prepared_with_images_evidence(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], evidence_i64: [i64], evidence_text: [text]) -> Engine2dDrawIrAdvResult:
    """Replay an immutable prepared composition through fresh Draw IR execution."""
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: evidence_i64, evidence_text: evidence_text)
    _engine2d_draw_ir_adv_composition_with_images(
        engine, composition, gpu_available, images, false, true, false,
        transport, composition.scene_key)

fn engine2d_draw_ir_adv_composition_present_prepared_with_images_xy_evidence(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], image_xy: [i64], evidence_i64: [i64], evidence_text: [text]) -> Engine2dDrawIrAdvResult:
    """Replay prepared Draw IR with caller-owned resolved-image positions."""
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: evidence_i64, evidence_text: evidence_text)
    _e2d_prepared_image_xy = image_xy
    _e2d_prepared_image_xy_active = true
    if not _e2d_prepared_image_xy_profiled:
        _e2d_prepared_image_xy_profiled = true
        val xy0 = if image_xy.len() > 0: image_xy[0] else: -1
        val xy1 = if image_xy.len() > 1: image_xy[1] else: -1
        print "[engine2d-image-sidecar] active=true len={image_xy.len()} xy0={xy0},{xy1}"
    val result = _engine2d_draw_ir_adv_composition_with_images(
        engine, composition, gpu_available, images, false, true, false,
        transport, composition.scene_key, image_xy)
    _e2d_prepared_image_xy_active = false
    result

fn engine2d_draw_ir_adv_present_prepared_scanout_evidence(engine: Engine2D, width: i32, height: i32, pixels: [u32], evidence_i64: [i64], evidence_text: [text]) -> i32:
    """Execute the canonical retained full-scene image through scalar ABI."""
    if width <= 0 or height <= 0:
        return 0
    if pixels.len() != width.to_i64() * height.to_i64():
        return 0
    val status = engine2d_target_draw_ir_blit_image_prepared_opaque_status(
        engine, 0, 0, width, height, pixels)
    print "[prepared-scanout-status] status={status} width={width} height={height} pixels={pixels.len()}"
    if evidence_i64.len() >= 7:
        evidence_i64[0] = if status > 0: 0 else: 1
        evidence_i64[1] = 0
        evidence_i64[2] = 0
        evidence_i64[3] = 0
        evidence_i64[4] = 0
        evidence_i64[5] = if status > 0: 1 else: 0
        evidence_i64[6] = if status > 0: 0 else: 1
    if evidence_text.len() >= 3:
        evidence_text[0] = ""
        evidence_text[1] = ""
        evidence_text[2] = if status > 0: "none" else: "prepared-scanout-blit-failed"
    if status <= 0:
        return 0
    engine.submit_batch()
    engine.present()
    1

fn engine2d_draw_ir_adv_replay_prepared_scanout(
    engine: Engine2D, width: i32, height: i32
) -> i32:
    # The executor publishes prepared_valid only after the ordered framebuffer
    # capture. The target replay has no new input beyond these admitted scalar
    # dimensions; its native scalar return is unstable on freestanding ARM64.
    engine2d_target_replay_prepared_scanout_status(engine, width, height)
    engine.submit_batch()
    engine.present()
    1

fn engine2d_draw_ir_adv_capture_prepared_scanout(
    engine: Engine2D, width: i32, height: i32
) -> i32:
    engine2d_target_capture_prepared_scanout_status(engine, width, height)

fn engine2d_draw_ir_adv_fresh_device_composition_with_images(engine: Engine2D, composition: DrawIrComposition, images: [Engine2dResolvedDrawIrImage]) -> Engine2dDrawIrAdvResult:
    """Render/read back an exhaustively preflighted fresh device composition."""
    val reason = _engine2d_draw_ir_fresh_device_reason(composition, images, engine.width(), engine.height())
    if reason != "":
        val plan = simple_2d_draw_ir_adv_composition_plan(composition, true)
        return _engine2d_draw_ir_result_from_composition_plan_with_unsupported(plan, 0, 1, reason, engine2d_readback([], "preflight_rejected"))
    val prepared = _engine2d_draw_ir_prepare_fresh_device_text(engine, composition, engine.width(), engine.height())
    if prepared.1 != "":
        val plan = simple_2d_draw_ir_adv_composition_plan(composition, true)
        return _engine2d_draw_ir_result_from_composition_plan_with_unsupported(plan, 0, 1, prepared.1, engine2d_readback([], "preflight_rejected"))
    val transport = Engine2dDrawIrTransport(destination: [], status: [], evidence_i64: [], evidence_text: [])
    _engine2d_draw_ir_adv_composition_with_images(prepared.0, composition, true, images, true, false, true, transport, "")

fn _engine2d_draw_ir_adv_composition_with_images(engine: Engine2D, composition: DrawIrComposition, gpu_available: bool, images: [Engine2dResolvedDrawIrImage], allow_parent_image: bool, present_frame: bool, readback_frame: bool, transport: Engine2dDrawIrTransport, prepared_visual_key: text, image_xy: [i64] = []) -> Engine2dDrawIrAdvResult:
    _e2d_command_owner_readback_pixels = []
    val plan = simple_2d_draw_ir_adv_composition_plan(composition, gpu_available)
    # Preserve the public fallback invariant from the original inputs. The
    # native cross-module aggregate path can lose this bool from `plan`.
    val gpu_fallback_required = (
        composition.backend_target == DRAW_IR_BACKEND_GPU and
        not gpu_available)
    # NOTE(2026-07-16): previously this preflight-scanned every batch and, if
    # ANY command anywhere was unresolved (e.g. one missing taskbar icon on a
    # degraded disk), bailed out with rendered=0 for the WHOLE composition.
    # The per-command loop below (_engine2d_draw_ir_render_commands) already
    # renders everything it can and accounts for the rest in skipped/
    # unsupported_kinds, so the all-or-nothing preflight bail is removed:
    # unresolved commands are now skipped individually and everything else
    # still renders. This depended on backend_baremetal.spl's
    # draw_rect_filled (and siblings) clamping unconditionally to the
    # framebuffer bounds regardless of clip_enabled -- see that file for the
    # fix that made this safe.
    var eng = engine
    var rendered = 0
    var skipped = 0
    var unsupported_kinds = ""
    var cpu_composited_material_count = 0
    var metal_device_glass_material_count = 0
    var metal_device_glass_requested_count = 0
    var metal_device_glass_unfulfilled_count = 0
    var metal_device_glass_receipts: [Engine2dMetalGlassReceipt] = []
    var glass_execution_target = ""
    var glass_backend_handle: i64 = 0
    var glass_device_identity: i64 = 0
    var css_background_pixel_work_remaining = (
        eng.width().to_i64() * eng.height().to_i64())
    # NOTE(layer ordering): batches composite in array order, not re-sorted by
    # embedding.layer. Every real producer (e.g. window_scene_draw_ir.spl)
    # already emits batches desktop-first/chrome-next/windows-by-ascending-
    # z_index, i.e. already in ascending layer order, so batch order is a
    # faithful proxy for layer order today. Re-sorting here would need to
    # restructure this loop (stable sort + re-derive rendered/skipped
    # accounting) for no behavior change against any current producer, so it
    # is left as a documented limitation rather than done speculatively.
    var profile_wm_batches = false
    if composition.batches.len() == 9:
        if prepared_visual_key != "" and not _e2d_wm_prepared_batch_profile_emitted:
            profile_wm_batches = true
            _e2d_wm_prepared_batch_profile_emitted = true
        elif prepared_visual_key == "" and not _e2d_wm_batch_profile_emitted:
            profile_wm_batches = true
            _e2d_wm_batch_profile_emitted = true
    var profile_batch_index: i32 = 0
    for batch in composition.batches:
        var batch_execution_counts: [i64] = [0, 0, 0, 0, 0, 0]
        var batch_offsets: [i32] = [batch.embedding.x, batch.embedding.y]
        # Top-level WM content commands are authored in absolute coordinates.
        # Do not read the cross-module embedding x/y fields: the current
        # AArch64 aggregate layout resolves x as surface_id. Nested content has
        # parent_id and retains canonical embedding translation/clipping.
        if batch.commands.len() == 1:
            if batch.commands[0].parent_id == "":
                if batch.batch_id.starts_with("content-"):
                    batch_offsets[0] = 0
                    batch_offsets[1] = 0
        val profile_batch_started_us = rt_time_now_micros()
        if profile_wm_batches:
            if profile_batch_index == 6:
                _e2d_wm_command_profile_active = true
        var batch_engine_owner: [Engine2D] = [eng]
        val outcome = _engine2d_draw_ir_render_batch_embedded(
            eng, batch, images, 0, allow_parent_image,
            css_background_pixel_work_remaining, batch_execution_counts,
            prepared_visual_key, batch_offsets, image_xy, batch_engine_owner)
        eng = batch_engine_owner[0]
        _e2d_wm_command_profile_active = false
        if profile_wm_batches:
            val profile_batch_finished_us = rt_time_now_micros()
            val profile_mode = if prepared_visual_key != "": "prepared" else: "fresh"
            print "[engine2d-batch-profile] mode={profile_mode} index={profile_batch_index} commands={batch.commands.len()} surface={batch.embedding.surface_id} elapsed_us={profile_batch_finished_us - profile_batch_started_us} cpu_material={batch_execution_counts[0]} rendered={batch_execution_counts[4]} skipped={batch_execution_counts[5]}"
        profile_batch_index = profile_batch_index + 1
        if outcome.css_background_pixel_work_remaining >= 0:
            css_background_pixel_work_remaining = (
                outcome.css_background_pixel_work_remaining)
        rendered = rendered + batch_execution_counts[4].to_i32()
        skipped = skipped + batch_execution_counts[5].to_i32()
        cpu_composited_material_count = (
            cpu_composited_material_count +
            batch_execution_counts[0].to_i32()
        )
        metal_device_glass_material_count = (
            metal_device_glass_material_count +
            batch_execution_counts[1].to_i32()
        )
        metal_device_glass_requested_count = (
            metal_device_glass_requested_count +
            batch_execution_counts[2].to_i32()
        )
        metal_device_glass_unfulfilled_count = (
            metal_device_glass_unfulfilled_count +
            batch_execution_counts[3].to_i32()
        )
        for receipt in outcome.metal_device_glass_receipts:
            metal_device_glass_receipts.push(receipt)
        if outcome.glass_execution_target != "":
            glass_execution_target = outcome.glass_execution_target
        if outcome.glass_backend_handle > 0:
            glass_backend_handle = outcome.glass_backend_handle
        if outcome.glass_device_identity > 0:
            glass_device_identity = outcome.glass_device_identity
        if outcome.unsupported_kinds != "" and outcome.unsupported_kinds != "none":
            if unsupported_kinds != "":
                unsupported_kinds = unsupported_kinds + ","
            unsupported_kinds = unsupported_kinds + outcome.unsupported_kinds
    if unsupported_kinds == "":
        unsupported_kinds = "none"
    # Flush the whole composition's buffered draw calls into ONE submission
    # (one fence wait) before present/readback, instead of leaving frame
    # boundaries implicit in present()'s own flush. A no-op on backends that
    # already dispatch immediately per primitive (see RenderBackend.submit_batch).
    eng.submit_batch()
    if present_frame:
        eng.present()
    var readback = engine2d_readback([], "not_requested")
    if readback_frame:
        readback = eng.read_pixels_with_source()
        if (_e2d_command_owner_readback_pixels.len() ==
            eng.width().to_i64() * eng.height().to_i64()):
            _e2d_retained_readback_pixels = _e2d_command_owner_readback_pixels
        else:
            _e2d_retained_readback_pixels = readback.pixels
    if transport.destination.len() > 0 and transport.status.len() > 0:
        if readback.pixels.len() == transport.destination.len():
            var transport_index: i32 = 0
            while transport_index < transport.destination.len():
                transport.destination[transport_index] = readback.pixels[transport_index]
                transport_index = transport_index + 1
            transport.status[0] = 1
        else:
            transport.status[0] = -4
    if transport.evidence_i64.len() >= 5:
        transport.evidence_i64[0] = skipped.to_i64()
        transport.evidence_i64[1] = cpu_composited_material_count.to_i64()
        transport.evidence_i64[2] = metal_device_glass_material_count.to_i64()
        transport.evidence_i64[3] = glass_backend_handle
        transport.evidence_i64[4] = glass_device_identity
    if transport.evidence_i64.len() >= 7:
        transport.evidence_i64[5] = rendered.to_i64()
        transport.evidence_i64[6] = (if gpu_fallback_required or skipped > 0: 1 else: 0)
    if transport.evidence_text.len() >= 2:
        transport.evidence_text[0] = glass_execution_target
        transport.evidence_text[1] = readback.source
    if transport.evidence_text.len() >= 3:
        transport.evidence_text[2] = unsupported_kinds
    var result = _engine2d_draw_ir_result_from_composition_plan_with_unsupported(
        plan, rendered, skipped, unsupported_kinds, readback)
    if gpu_fallback_required:
        result.fallback_required = true
        if result.fallback_reason == "":
            result.fallback_reason = "gpu backend unavailable; using cpu fallback"
    # Single line: the parser needs the expression on the same line as `=`;
    # a newline straight after the assignment operator does not continue.
    result.cpu_composited_material_count = cpu_composited_material_count
    result.metal_device_glass_material_count = (
        metal_device_glass_material_count)
    result.metal_device_glass_requested_count = (
        metal_device_glass_requested_count)
    result.metal_device_glass_unfulfilled_count = (
        metal_device_glass_unfulfilled_count)
    result.metal_device_glass_receipts = _engine2d_draw_ir_receipts_with_readback(
        metal_device_glass_receipts, readback)
    result.glass_execution_target = glass_execution_target
    result.glass_backend_handle = glass_backend_handle
    result.glass_device_identity = glass_device_identity
    # A concrete Metal request is a device request, but a CPU material
    # execution is still a valid, explicitly classified fallback. Do not let
    # the planner's requested GPU classification masquerade as the actual
    # material execution target.
    if (composition.backend_target == "metal" and
        (cpu_composited_material_count > 0 or
            metal_device_glass_unfulfilled_count > 0 or
            metal_device_glass_material_count !=
                metal_device_glass_requested_count)):
        result.selected_backend = "cpu"
        result.fallback_required = true
        if cpu_composited_material_count > 0:
            result.fallback_reason = "metal glass material used cpu fallback"
        else:
            result.fallback_reason = "metal glass material device receipt missing"
    val rendered_fonts = eng.fonts()
    result.font_identity = rendered_fonts.current_font_identity()
    eng.install_font_renderer(rendered_fonts)
    result.font_execution_target = eng.font_execution_target()
    val target_font = eng.draw_ir_font_evidence()
    if target_font != nil:
        # Keep the already-guarded nullable value intact. On freestanding x86
        # the explicit `.?` form was lowered to a second `rt_native_neq`
        # boolean and that boolean was then dereferenced as evidence.
        val evidence: DrawIrTargetFontEvidence = target_font
        result.font_batch_identity = evidence.batch_identity
        result.font_readback_source = evidence.readback_source
        result.font_device_checksum = evidence.device_checksum
        result.font_oracle_checksum = evidence.oracle_checksum
        result.font_readback_nonblank_pixels = evidence.readback_nonblank_pixels
        result.font_parity = evidence.parity
        result.font_device_executed = evidence.device_executed
        result.font_promotion_ready = evidence.promotion_ready
        result.font_atlas_upload_count = evidence.atlas_upload_count
        result.font_atlas_upload_bytes = evidence.atlas_upload_bytes
        result.font_atlas_payload_sha256 = evidence.atlas_payload_sha256
    result

