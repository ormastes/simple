# Canonical transport-neutral Engine2D showcase scene.
# Surface adapters own window/input/presentation; this module owns pixels only.

use std.gc_async_mut.gpu.engine2d.engine_target.{Engine2D}

val SHOWCASE_DESIGN_W: i32 = 800
val SHOWCASE_DESIGN_H: i32 = 600

fn _showcase_x(value: i32, width: i32) -> i32:
    value * width / SHOWCASE_DESIGN_W

fn _showcase_y(value: i32, height: i32) -> i32:
    value * height / SHOWCASE_DESIGN_H

fn _showcase_detail(value: i32, width: i32) -> i32:
    val scaled = value * width / SHOWCASE_DESIGN_W
    if scaled < 1:
        return 1
    scaled

fn _showcase_mask(width: i32, height: i32) -> [u8]:
    var mask: [u8] = [0u8; width * height]
    val x0 = _showcase_x(600, width)
    val x1 = _showcase_x(780, width)
    val y0 = _showcase_y(350, height)
    val y1 = _showcase_y(430, height)
    var y = y0
    while y < y1:
        var x = x0
        while x < x1:
            mask[y * width + x] = 255u8
            x = x + 1
        y = y + 1
    mask

fn _showcase_label(mut engine: Engine2D, width: i32, height: i32,
                   x: i32, y: i32, value: text) -> Engine2D:
    engine.draw_text_bg(
        _showcase_x(x, width), _showcase_y(y, height), value,
        0xfff3f6fcu32, 0xcc101522u32, _showcase_detail(12, width))
    engine

fn graphics_2d_showcase_render(mut engine: Engine2D, width: i32,
                               height: i32, dpi: i32,
                               include_mask: bool) -> Engine2D:
    val bg = 0xff101522u32
    val panel = 0xff1b2435u32
    val white = 0xfff3f6fcu32
    val blue = 0xff3b82f6u32
    val cyan = 0xff22d3eeu32
    val green = 0xff22c55eu32
    val amber = 0xfff59e0bu32
    val red = 0xffef4444u32
    val purple = 0xffa855f7u32

    engine.clear(bg)
    engine.draw_text(_showcase_x(20, width), _showcase_y(12, height),
        "Simple Engine2D - complete primitive showcase", white,
        _showcase_detail(18, width))

    engine.draw_rect_filled(_showcase_x(18, width), _showcase_y(48, height),
        _showcase_x(245, width), _showcase_y(150, height), panel)
    engine = _showcase_label(engine, width, height, 28, 55, "RECT / LINE")
    engine.draw_rect(_showcase_x(30, width), _showcase_y(80, height),
        _showcase_x(55, width), _showcase_y(38, height), blue)
    engine.draw_rect_filled(_showcase_x(94, width), _showcase_y(80, height),
        _showcase_x(55, width), _showcase_y(38, height), cyan)
    engine.draw_rect_thick(_showcase_x(158, width), _showcase_y(80, height),
        _showcase_x(55, width), _showcase_y(38, height), green,
        _showcase_detail(4, width))
    engine.draw_rounded_rect(_showcase_x(30, width), _showcase_y(130, height),
        _showcase_x(80, width), _showcase_y(45, height),
        _showcase_x(12, width), purple)
    engine.draw_line(_showcase_x(30, width), _showcase_y(185, height),
        _showcase_x(215, width), _showcase_y(185, height), red,
        _showcase_detail(3, width))

    engine.draw_rect_filled(_showcase_x(276, width), _showcase_y(48, height),
        _showcase_x(250, width), _showcase_y(245, height), panel)
    engine = _showcase_label(engine, width, height, 286, 55, "CURVES / SHAPES")
    engine.draw_circle(_showcase_x(310, width), _showcase_y(105, height),
        _showcase_x(25, width), blue)
    engine.draw_circle_filled(_showcase_x(375, width), _showcase_y(105, height),
        _showcase_x(25, width), green)
    engine.draw_circle_thick(_showcase_x(440, width), _showcase_y(105, height),
        _showcase_x(25, width), amber, _showcase_detail(5, width))
    engine.draw_ellipse_filled(_showcase_x(405, width), _showcase_y(165, height),
        _showcase_x(35, width), _showcase_y(20, height), purple)
    engine.draw_triangle_filled(
        _showcase_x(295, width), _showcase_y(225, height),
        _showcase_x(345, width), _showcase_y(190, height),
        _showcase_x(365, width), _showcase_y(245, height), blue)
    engine.draw_bezier(
        _showcase_x(290, width), _showcase_y(275, height),
        _showcase_x(345, width), _showcase_y(235, height),
        _showcase_x(430, width), _showcase_y(315, height),
        _showcase_x(510, width), _showcase_y(270, height), amber,
        _showcase_detail(3, width))

    engine.draw_rect_filled(_showcase_x(539, width), _showcase_y(48, height),
        _showcase_x(243, width), _showcase_y(245, height), panel)
    engine = _showcase_label(engine, width, height, 549, 55, "GRADIENT / EFFECT")
    engine.draw_gradient_rect(_showcase_x(551, width), _showcase_y(82, height),
        _showcase_x(65, width), _showcase_y(70, height), blue, purple)
    engine.draw_gradient_rect_h(_showcase_x(626, width), _showcase_y(82, height),
        _showcase_x(65, width), _showcase_y(70, height), green, cyan)
    engine.draw_radial_gradient(_showcase_x(739, width), _showcase_y(117, height),
        _showcase_x(38, width), white, red)
    engine.draw_shadow_rect(_showcase_x(558, width), _showcase_y(180, height),
        _showcase_x(85, width), _showcase_y(55, height),
        _showcase_x(8, width), _showcase_y(8, height),
        _showcase_detail(8, width), 0xaa000000u32)
    engine.draw_rect_filled(_showcase_x(558, width), _showcase_y(180, height),
        _showcase_x(85, width), _showcase_y(55, height), blue)
    engine.draw_rect_blend(_showcase_x(660, width), _showcase_y(180, height),
        _showcase_x(105, width), _showcase_y(55, height), 0x88a855f7u32)

    engine.draw_rect_filled(_showcase_x(18, width), _showcase_y(307, height),
        _showcase_x(365, width), _showcase_y(130, height), panel)
    engine = _showcase_label(engine, width, height, 28, 315, "IMAGE / TEXT")
    val image = [red, amber, green, cyan, blue, purple, white, panel,
                 cyan, blue, purple, red, amber, green, panel, white]
    engine.draw_image_scaled(_showcase_x(30, width), _showcase_y(345, height),
        _showcase_x(64, width), _showcase_y(64, height), 4, 4, image)
    engine.draw_image_transform(_showcase_x(115, width), _showcase_y(345, height),
        4, 4, 256, 64, 0, 256, 0, 0, image)
    engine.draw_text(_showcase_x(235, width), _showcase_y(350, height),
        "glyph text", green, _showcase_detail(14, width))
    engine.draw_text_bg(_showcase_x(235, width), _showcase_y(380, height),
        "text background", white, blue, _showcase_detail(14, width))

    engine.draw_rect_filled(_showcase_x(397, width), _showcase_y(307, height),
        _showcase_x(180, width), _showcase_y(130, height), panel)
    engine = _showcase_label(engine, width, height, 407, 315, "CLIP")
    engine.draw_rect(_showcase_x(414, width), _showcase_y(346, height),
        _showcase_x(142, width), _showcase_y(70, height), cyan)
    engine.set_clip(_showcase_x(416, width), _showcase_y(348, height),
        _showcase_x(138, width), _showcase_y(66, height))
    engine.draw_circle_filled(_showcase_x(416, width), _showcase_y(380, height),
        _showcase_x(55, width), red)
    engine.draw_rect_filled(_showcase_x(480, width), _showcase_y(340, height),
        _showcase_x(100, width), _showcase_y(85, height), purple)
    engine.clear_clip()

    engine.draw_rect_filled(_showcase_x(591, width), _showcase_y(307, height),
        _showcase_x(191, width), _showcase_y(130, height), panel)
    engine = _showcase_label(engine, width, height, 601, 315, "MASK / BLEND")
    if include_mask:
        engine.set_mask(_showcase_mask(width, height), width, height)
    engine.draw_gradient_rect_h(_showcase_x(600, width), _showcase_y(350, height),
        _showcase_x(180, width), _showcase_y(80, height), amber, red)
    engine.draw_rect_blend_mode(_showcase_x(625, width), _showcase_y(370, height),
        _showcase_x(130, width), _showcase_y(38, height), 0xaa22c55eu32, 1)
    engine.clear_mask()

    engine.draw_rect_filled(_showcase_x(18, width), _showcase_y(452, height),
        _showcase_x(764, width), _showcase_y(125, height), panel)
    engine = _showcase_label(engine, width, height, 28, 460,
        "ENGINE COMPOSITION / OPACITY")
    var child = Engine2D.create_with_backend_fast(80, 60, "software")
    child.clear(0x00000000u32)
    child.draw_rounded_rect(5, 5, 70, 50, 10, blue)
    child.draw_circle_filled(40, 30, 16, amber)
    child.present()
    val child_pixels = child.read_pixels()
    engine.draw_image(_showcase_x(38, width), _showcase_y(495, height),
        80, 60, child_pixels)
    var opacity_pixels: [u32] = [0u32; child_pixels.len()]
    var opacity_index = 0
    while opacity_index < child_pixels.len():
        val source = child_pixels[opacity_index]
        val source_alpha = ((source >> 24u32) & 255u32) * 450u32 / 1000u32
        opacity_pixels[opacity_index] =
            (source & 0x00ffffffu32) | (source_alpha << 24u32)
        opacity_index = opacity_index + 1
    engine.draw_image_blend(_showcase_x(138, width), _showcase_y(495, height),
        80, 60, opacity_pixels)
    child.shutdown()
    engine

fn graphics_2d_showcase_draw(mut engine: Engine2D, width: i32,
                             height: i32) -> Engine2D:
    graphics_2d_showcase_render(engine, width, height, 300, true)

fn graphics_2d_showcase_render_pixels(width: i32, height: i32) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    var engine = Engine2D.create_offscreen(width, height)
    engine = graphics_2d_showcase_render(engine, width, height, 300, true)
    engine.present()
    val pixels = engine.read_pixels()
    engine.shutdown()
    pixels

export graphics_2d_showcase_render, graphics_2d_showcase_draw, graphics_2d_showcase_render_pixels
