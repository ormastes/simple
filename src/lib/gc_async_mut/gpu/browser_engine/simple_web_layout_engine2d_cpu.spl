# CPU web Draw IR adapter. Engine2D owns all raster semantics.

use common.ui.draw_ir.{DrawIrComposition}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_draw_ir_cpu_bitmap}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_draw_ir_adv_composition}
use std.gc_async_mut.gpu.engine2d.engine_target.{Engine2D}

fn _simple_web_render_draw_ir_composition_with_cpu_backend(
    composition: DrawIrComposition, width: i32, height: i32, backend_name: text
) -> [u32]:
    var engine = Engine2D.create_with_backend(width, height, backend_name)
    engine.clear(0u32)
    val result = engine2d_draw_ir_adv_composition(engine, composition, false)
    val pixels = result.pixels
    engine.shutdown()
    pixels

pub fn simple_web_render_html_to_pixels_with_cpu_draw_ir_backend(html: text, width: i32, height: i32, backend_name: text) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    _simple_web_render_draw_ir_composition_with_cpu_backend(
        simple_web_layout_render_html_draw_ir_cpu_bitmap(html, width, height),
        width, height, if backend_name == "cpu_simd": "cpu_simd" else: "cpu"
    )

pub fn simple_web_render_draw_ir_composition_with_cpu_backend(
    composition: DrawIrComposition, width: i32, height: i32
) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    _simple_web_render_draw_ir_composition_with_cpu_backend(
        composition, width, height, "cpu"
    )
