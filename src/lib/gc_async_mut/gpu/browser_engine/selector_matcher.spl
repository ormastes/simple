# Browser engine selector matcher helpers.
#
# Provides :not() selector matching used by fallback pixel path rendering.

fn _sel_attr_value(tag: text, attr: text) -> text:
    val key_dq = attr + "=\""
    val key_sq = attr + "='"
    val lo = tag.lower()
    val idx_dq = lo.index_of(key_dq)
    if idx_dq >= 0:
        val after = tag.substring(idx_dq + key_dq.len(), tag.byte_len())
        val close = after.index_of("\"")
        if close >= 0:
            return after.substring(0, close)
    val idx_sq = lo.index_of(key_sq)
    if idx_sq >= 0:
        val after = tag.substring(idx_sq + key_sq.len(), tag.byte_len())
        val close = after.index_of("'")
        if close >= 0:
            return after.substring(0, close)
    ""

fn br_tag_name_from_content(content: text) -> text:
    val trimmed = content.trim()
    if not trimmed.starts_with("<"):
        return ""
    val end = trimmed.index_of(">")
    if end <= 1:
        return ""
    val body = trimmed.substring(1, end).trim()
    val space = body.index_of(" ")
    if space > 0:
        return body.substring(0, space).lower()
    body.lower()

fn _sel_option_matches_tag(option: text, tag_name: text, tag: text) -> bool:
    val opt = option.trim()
    # Attribute substring selector [attr*="value"]
    val attr_start = opt.index_of("[")
    if attr_start >= 0:
        val attr_end = opt.index_of("]")
        if attr_end > attr_start:
            val attr_expr = opt.substring(attr_start + 1, attr_end)
            val star_eq = attr_expr.index_of("*=\"")
            if star_eq >= 0:
                val attr_name = attr_expr.substring(0, star_eq)
                val value_part = attr_expr.substring(star_eq + 3, attr_expr.byte_len())
                val close_dq = value_part.index_of("\"")
                val sub = if close_dq >= 0: value_part.substring(0, close_dq) else value_part
                val attr_val = _sel_attr_value(tag, attr_name)
                return attr_val.contains(sub)
    # Compound tag.class selector
    val dot = opt.index_of(".")
    if dot > 0:
        val opt_tag = opt.substring(0, dot)
        val opt_class = opt.substring(dot + 1, opt.byte_len())
        if opt_tag == tag_name:
            val class_val = _sel_attr_value(tag, "class")
            val classes = class_val.split(" ")
            var idx: i32 = 0
            val class_count = classes.len()
            while idx < class_count:
                if classes[idx].trim() == opt_class:
                    return true
                idx = idx + 1
    false

# Returns true when the :not() selector does NOT match the element described by
# tag_name and tag (i.e. the element is a valid match for the full selector).
pub fn br_selector_list_contains_not_self(selector: text, tag_name: text, tag: text) -> bool:
    val marker = tag_name + ":not("
    val start = selector.index_of(marker)
    if start < 0:
        return false
    val after = selector.substring(start + marker.len(), selector.byte_len())
    val close = after.index_of(")")
    if close < 0:
        return false
    val options_str = after.substring(0, close)
    val options = options_str.split(",")
    var idx: i32 = 0
    val option_count = options.len()
    while idx < option_count:
        val opt = options[idx].trim()
        if opt != "" and _sel_option_matches_tag(opt, tag_name, tag):
            return false
        idx = idx + 1
    true

fn _sel_name_char(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
    (ch >= "0" and ch <= "9") or ch == "-" or ch == "_"

# Does `selector` (one rule's whole selector list) mention `wanted` as a
# COMPLETE selector name?
#
# This used to be a bare `selector.contains(wanted)`. A CSS identifier can be
# extended: ".card" is a substring of ".card-header", "#nav" of "#nav-item",
# "div" of "divider". The caller merges every rule this returns true for into
# one declaration string whose LAST declaration wins the cascade, so a
# `.card` element silently rendered with `.card-header`'s declarations.
# Requiring the character after the match to be a non-identifier character
# keeps every legitimate hit (".card", ".card:hover", ".card.primary",
# "div.card", ".card p") and drops only the name-extension false positives.
fn br_selector_list_contains_simple(selector: text, tag_name: text, tag: text) -> bool:
    val want_len = tag_name.len()
    if want_len == 0:
        return false
    val sel_len = selector.byte_len()
    var start: i32 = 0
    while start + want_len <= sel_len:
        val hit = selector.substring(start, sel_len).index_of(tag_name)
        if hit < 0:
            return false
        val at = start + hit
        val after = at + want_len
        if after >= sel_len or not _sel_name_char(selector.substring(after, after + 1)):
            return true
        start = at + 1
    false

fn br_selector_list_contains_has_descendant(selector: text, tag_name: text, tag: text) -> bool:
    false

fn br_selector_list_contains_attr_self(selector: text, tag_name: text, tag: text) -> bool:
    _sel_option_matches_tag(selector, tag_name, tag)

fn br_selector_list_contains_empty_self(selector: text, tag_name: text, tag: text) -> bool:
    selector.contains(":empty")

fn br_selector_list_contains_first_child_self(selector: text, tag_name: text, tag: text) -> bool:
    selector.contains(":first-child")

fn br_selector_list_contains_last_child_self(selector: text, tag_name: text, tag: text) -> bool:
    selector.contains(":last-child")

fn br_selector_list_contains_only_child_self(selector: text, tag_name: text, tag: text) -> bool:
    selector.contains(":only-child")

# One signed integer of an An+B term; "" and "+" mean `fallback`, "-" means
# its negation. Returns nil for anything that is not an integer.
fn _sel_nth_int(raw: text, fallback: i64) -> i64?:
    val t = raw.trim()
    if t == "" or t == "+":
        return fallback
    if t == "-":
        return 0 - fallback
    val digits = if t.starts_with("+"): t.substring(1, t.byte_len()) else: t
    digits.to_i64()

# Does 1-based sibling index `nth` satisfy one `:nth-child()` argument
# (integer, odd, even or An+B; Selectors 4 section 14.4.1)?
fn _sel_nth_arg_matches(raw: text, nth: i64) -> bool:
    val arg = raw.replace(" ", "").lower()
    if arg == "odd":
        return nth % 2 == 1
    if arg == "even":
        return nth % 2 == 0
    val n_at = arg.index_of("n")
    if n_at < 0:
        val exact = _sel_nth_int(arg, 0)
        if exact == nil:
            return false
        return nth == (exact ?? 0)
    val step_opt = _sel_nth_int(arg.substring(0, n_at), 1)
    val offset_opt = _sel_nth_int(arg.substring(n_at + 1, arg.byte_len()), 0)
    if step_opt == nil or offset_opt == nil:
        return false
    val step = step_opt ?? 0
    val delta = nth - (offset_opt ?? 0)
    if step == 0:
        return delta == 0
    if step > 0:
        return delta >= 0 and delta % step == 0
    delta <= 0 and (0 - delta) % (0 - step) == 0

# True when the rule's selector list carries a `:nth-child(...)` whose
# argument selects sibling index `nth`. This used to be a bare
# `selector.contains(":nth-child")`, which applied an `:nth-child(2)` rule to
# every sibling.
fn br_selector_list_contains_nth_child_self(selector: text, tag_name: text, tag: text, nth: i64) -> bool:
    if nth <= 0:
        return false
    val marker = ":nth-child("
    var rest = selector
    while true:
        val start = rest.index_of(marker)
        if start < 0:
            return false
        val after = rest.substring(start + marker.len(), rest.byte_len())
        val close = after.index_of(")")
        if close < 0:
            return false
        if _sel_nth_arg_matches(after.substring(0, close), nth):
            return true
        rest = after.substring(close + 1, after.byte_len())
    false

fn br_selector_list_contains_multi_class(selector: text, classes: [text]) -> bool:
    for cls in classes:
        if cls != "" and not selector.contains("." + cls):
            return false
    true

export br_selector_list_contains_not_self
export br_tag_name_from_content
export br_selector_list_contains_simple
export br_selector_list_contains_has_descendant
export br_selector_list_contains_attr_self
export br_selector_list_contains_empty_self
export br_selector_list_contains_first_child_self
export br_selector_list_contains_last_child_self
export br_selector_list_contains_only_child_self
export br_selector_list_contains_nth_child_self
export br_selector_list_contains_multi_class
