        display_v = "block"
        margin_l_v = 8
        margin_t_v = 8
        margin_r_v = 8
        margin_b_v = 8
    elif tag == "input":
        display_v = "inline"
        pad_l_v = 2
        pad_r_v = 2
        pad_t_v = 1
        pad_b_v = 1
    elif tag == "button":
        display_v = "inline"
        border_box_v = true
