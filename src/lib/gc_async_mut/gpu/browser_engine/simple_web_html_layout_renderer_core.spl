export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.*
use std.gc_async_mut.gpu.browser_engine.style.supports.{eval_supports_query}
use std.gc_async_mut.io.mod_stub.{env_get}
use std.common.ui.ui_frame_clock.{FrameClock}
use std.nogc_sync_mut.ui.host_frame_clock.{default_frame_clock}

class Rules:
    group_parts: [[[text]]]
    group_specificities: [[i32]]
    decls: [text]
    important_decls: [text]

# Named transport for the three parallel rule-scan arrays. Returning these as
# an anonymous [[text]] loses the inner RuntimeArray identity in native code.
enum CssWrapperKind:
    Media
    Supports
    Layer
    Unsupported

class CssRuleScan:
    selectors: [text]
    declarations: [text]
    wrapper_starts: [i32]
    wrapper_counts: [i32]
    wrapper_kinds: [CssWrapperKind]
    wrapper_preludes: [text]

val CSS_SCAN_CANDIDATE_CAP: i32 = 6000
val CSS_VAR_SUBSTITUTION_BUDGET: i32 = 1024
val CSS_SELECTOR_GROUP_CAP: i32 = 16
val CSS_SELECTOR_PART_CAP: i32 = 256

enum CssVarResolution:
    Resolved(value: text)
    Invalid
    Cycle
    DepthExceeded
    BudgetExceeded

class CssVarResolutionState:
    remaining: i32
    active_names: [text]
    prop_names: [text]
    prop_values: [text]
    prop_count: i32
    memo_names: [text]
    memo_values: [text]
    memo_count: i32

    static fn new(props: text) -> CssVarResolutionState:
        var names: [text] = [""; 200]
        var values: [text] = [""; 200]
        var prop_count = 0
        var pos: i64 = 0
        var guard = 0
        # First-iteration discriminator for the `prop_count=0` stage-3 defect.
        # `guard=45` with `prop_count=0` proves `colon > 0` never fired, but NOT
        # which primitive broke: `substring` (raw_len=0), `trim` (raw_len>0 but
        # line_len=0), or `index_of` itself (line_len>0 but io<0 while the
        # native `find_from` on the SAME text returns a real index). Capturing
        # both searches on the same receiver is what separates the third case
        # from the first two -- an `index_of` that disagrees with `find_from`
        # on identical input is a compiler/runtime defect and nothing else.
        var probe_raw_len: i64 = -1
        var probe_line_len: i64 = -1
        var probe_colon_io: i64 = -1
        var probe_colon_ff: i64 = -1
        while pos < props.len() and guard < names.len():  # cpu-lane-loop-ok: walks the collected :root custom-property lines (one per newline), bounded by the 200-entry prop_names table; runs once per style invalidation inside extract_css, not per paint frame
            guard = guard + 1
            val nl = find_from(props, "\n", pos)
            val line_end = if nl < 0: props.len() else: nl
            val line_raw = props.substring(pos, line_end)
            val line = line_raw.trim()
            # `index_of` is NOT usable here: in the baremetal/native lane it
            # returns 0 for a receiver whose colon is at index 11, while the
            # native `find_from` on the SAME text returns 11. Proven 2026-08-09
            # in the SimpleOS WM lane:
            #   raw_len=15 line_len=15 colon_index_of=0 colon_find_from=11
            # A returned 0 fails the `colon > 0` guard below exactly like a
            # "not found", which is why all 45 property lines were dropped.
            # Do NOT "simplify" this back to `line.index_of(":")`.
            val colon = find_from(line, ":", 0)
            if guard == 1:
                probe_raw_len = line_raw.len()
                probe_line_len = line.len()
                probe_colon_io = line.index_of(":")
                probe_colon_ff = colon
            if colon > 0:
                names[prop_count] = line.substring(0, colon).trim()
                values[prop_count] = line.substring(
                    colon + 1, line.len()
                ).trim()
                prop_count = prop_count + 1
            pos = if nl < 0: props.len() else: nl + 1
        # STAGE 3 of the `props=0` chain, and the only stage that had never been
        # instrumented. `prop_count` is set solely inside `if colon > 0` above,
        # and the walk is bounded by `guard < names.len()` -- the `200` literal
        # table cap. A non-empty `props` that yields `prop_count=0` is therefore
        # either "the loop never ran" (`guard=0`), "the loop ran but no line had
        # a colon" (`guard>0`), or "the table cap truncated it"
        # (`guard>=names_cap`), and those three have different causes. Silent
        # whenever the re-parse recovers at least one property.
        #
        # PROVEN 2026-08-09 in the SimpleOS WM lane: stage 1 and stage 2 were
        # both silent and this fired with
        #   props_len=1365 names_cap=200 guard=45 prop_count=0
        # i.e. the collected sheet arrives intact (1365 chars, the host's exact
        # value), the loop walks all 45 property lines, and `colon > 0` still
        # never fires. The `raw_len`/`line_len`/`colon_index_of`/`colon_find_from`
        # fields exist to name which primitive is responsible.
        if props.len() > 0 and (prop_count == 0 or guard >= names.len()):
            print "[web-style-producer] css-props-stage3 props_len={props.len()} names_cap={names.len()} guard={guard} prop_count={prop_count} raw_len={probe_raw_len} line_len={probe_line_len} colon_index_of={probe_colon_io} colon_find_from={probe_colon_ff}"
        CssVarResolutionState(
            remaining: CSS_VAR_SUBSTITUTION_BUDGET,
            active_names: [""; 33],
            prop_names: names,
            prop_values: values,
            prop_count: prop_count,
            memo_names: [""; 200],
            memo_values: [""; 200],
            memo_count: 0
        )

class RuleBuckets:
    id_keys: [text]
    id_rules: [[i32]]
    class_keys: [text]
    class_rules: [[i32]]
    tag_keys: [text]
    tag_rules: [[i32]]
    fallback_rules: [i32]
    # O(1) key->index lookups for style_rule_candidates. build_rule_buckets already
    # builds these dicts while bucketing rules; without carrying them forward,
    # style_rule_candidates fell back to text_key_index's O(distinct-keys) linear
    # scan per node lookup, reproducing the same quadratic shape build_rule_buckets
    # itself was fixed for (WEB-2) -- O(nodes x distinct-keys) overall.
    id_key_dict: Dict<text, i32>
    class_key_dict: Dict<text, i32>
    tag_key_dict: Dict<text, i32>

fn _css_root_prefix_is_preamble(prefix: text) -> bool:
    var remaining = prefix.trim()
    var guard = 0
    while remaining.len() > 0 and guard < 32:  # cpu-lane-loop-ok: detector false positive: bound is the literal guard `< 32`, a fixed comment/at-rule preamble-strip budget on one short selector prefix, not an element or pixel count
        guard = guard + 1
        if remaining.starts_with("/*"):
            val comment_close = find_from(remaining, "*/", 2)
            if comment_close < 0:
                return false
            remaining = remaining.substring(
                comment_close + 2, remaining.len()
            ).trim()
        elif remaining.starts_with("@"):
            val semicolon = find_from(remaining, ";", 1)
            val brace = find_from(remaining, "{", 1)
            if semicolon < 0 or (brace >= 0 and brace < semicolon):
                return false
            remaining = remaining.substring(
                semicolon + 1, remaining.len()
            ).trim()
        else:
            return false
    remaining.len() == 0

fn _css_collect_custom_props(css: text, root_attrs: text) -> text:
    # Collect --name: value pairs from :root { } blocks.
    # Returns a compact string of "--name:value\n" entries.
    #
    # `:root` blocks are few (theme + a handful of variants), so locate each
    # one with the native substring search (`find_from`) instead of walking
    # the whole ~336KB stylesheet one byte at a time in interpreted Simple —
    # the byte-array walk cost ~6.6s per frame on a realistic theme sheet
    # (measured), because each interpreted `cb[i]` element read over 336K
    # entries is ~1us. Native search + a single small-body substring per
    # `:root` block is O(occurrences), microseconds in practice. Semantics are
    # preserved: a `:root` match counts only when the text between it and the
    # opening brace is whitespace (a standalone `:root` selector, exactly what
    # `css_bytes_trimmed_eq(..., ":root")` accepted before).
    # Bare :root declarations have lower specificity than matching
    # :root[attr] declarations. Keep the two groups separate, preserving
    # source order within each, then concatenate base before variants.
    var base_entries: [text] = [""; 400]
    var variant_entries: [text] = [""; 400]
    var base_entry_i = 0
    var variant_entry_i = 0
    var pos = 0
    var guard = 0
    while guard < 200:  # cpu-lane-loop-ok: walks the `:root` blocks located by native find_from in one stylesheet, hard-capped at 200 blocks; once per style invalidation
        guard = guard + 1
        val rp = find_from(css, ":root", pos)
        if rp < 0:
            break
        var selector_start = rp
        while selector_start > 0:
            val previous = css[selector_start - 1:selector_start - 1 + 1]
            if previous == "{" or previous == "}" or previous == ",":
                break
            selector_start = selector_start - 1
        if not _css_root_prefix_is_preamble(
            css.substring(selector_start, rp)
        ):
            pos = rp + 5
            continue
        val brace = find_from(css, "{", rp + 5)
        if brace < 0:
            break
        val between = css.substring(rp + 5, brace).trim()
        var is_root_variant = true
        if between.len() > 0:
            if not between.starts_with("["):
                is_root_variant = false
            else:
                val attr_close = find_from(between, "]", 0)
                if attr_close < 0:
                    is_root_variant = false
                else:
                    val suffix = between.substring(attr_close + 1, between.len()).trim()
                    is_root_variant = suffix.len() == 0 and attr_selector_matches(root_attrs, between.substring(1, attr_close))
        if not is_root_variant:
            # Skip selectors like `:root.dark` or `:root main {}` here.
            # `:root` was part of a larger selector (e.g. `:root.dark`); skip it.
            pos = rp + 5
            continue
        val close = find_from(css, "}", brace)
        if close < 0:
            break
        val body = css.substring(brace + 1, close)
        val body_len = body.len()
        var bp: i64 = 0
        var bg = 0
        while bp < body_len and bg < 400:  # cpu-lane-loop-ok: walks the `--name: value` declarations inside one small `:root` block body via native find_from, capped at 400 declarations per block
            bg = bg + 1
            val dd = find_from(body, "--", bp)
            if dd < 0:
                break
            val colon = find_from(body, ":", dd)
            if colon < 0:
                break
            val semi = find_from(body, ";", colon)
            val name = body.substring(dd, colon).trim()
            var val_end = semi
            if val_end < 0:
                val_end = body_len
            val prop_val = body.substring(colon + 1, val_end).trim()
            if name.len() > 2:
                val entry = name + ":" + prop_val + "\n"
                if between.len() == 0 and base_entry_i < base_entries.len():
                    base_entries[base_entry_i] = entry
                    base_entry_i = base_entry_i + 1
                elif between.len() > 0 and variant_entry_i < variant_entries.len():
                    variant_entries[variant_entry_i] = entry
                    variant_entry_i = variant_entry_i + 1
            bp = if semi >= 0: semi + 1 else: body_len
        pos = close + 1
    if base_entry_i == 0 and variant_entry_i == 0:
        return ""
    text_list_prefix(base_entries, base_entry_i).join("") + text_list_prefix(variant_entries, variant_entry_i).join("")

fn _css_resolve_vars(
    css: text, state: CssVarResolutionState, resolution_depth: i32,
    active_count: i32, nested: bool
) -> CssVarResolution:
    if resolution_depth > 32:
        return CssVarResolution.DepthExceeded
    if css.index_of("var(") < 0:
        return CssVarResolution.Resolved(value: css)
    if state.remaining <= 0:
        return CssVarResolution.BudgetExceeded
    var chunks: [text] = [""; 801]
    var chunk_count = 0
    # Unresolved-var accounting for the top-level pass. A `var()` that cannot
    # be resolved used to be spliced out to the EMPTY string while the pass
    # still reported `Resolved`, which is silent AND wrong (see the
    # `replacement_text` match below). Count them and name the first one so a
    # sheet rendered with dead variables says so in one line instead of
    # surfacing downstream as a content mismatch.
    var unresolved_var_count = 0
    var first_unresolved_name = ""
    var first_unresolved_sw_raw = false
    var first_unresolved_sw_portable = false
    var first_unresolved_prop_idx = -1
    var resolved_len = 0
    val css_len = css.len()
    var scan = 0
    var vg = 0
    while scan < css_len and vg < 400:  # cpu-lane-loop-ok: walks the `var(` occurrences in one stylesheet via native find_from, capped at 400 substitutions per resolve pass; once per style invalidation
        vg = vg + 1
        val open = find_from(css, "var(", scan)
        if open < 0:
            break
        if state.remaining <= 0:
            return CssVarResolution.BudgetExceeded
        state.remaining = state.remaining - 1
        # Match the closing paren by depth: var() args may nest more var()/
        # calc() parens, so the first ")" is not necessarily the close.
        var depth = 1
        var k = open + 4
        while k < css_len and depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE `var(` by paren depth; bound is the distance to that paren and it exits at depth 0
            if css[k] == "(":
                depth = depth + 1
            elif css[k] == ")":
                depth = depth - 1
            k = k + 1
        if depth != 0:
            return CssVarResolution.Invalid
        val close = k - 1
        if chunk_count + 2 >= chunks.len():
            return CssVarResolution.BudgetExceeded
        # Split "--name, fallback" at the first TOP-LEVEL comma; the fallback
        # itself may be another var() and is resolved recursively per spec.
        val inner = css.substring(open + 4, close)
        var cdepth = 0
        var comma = -1
        var m = 0
        val inner_len = inner.len()
        while m < inner_len:  # cpu-lane-loop-ok: scans ONE var() argument for its first top-level comma; bound is that argument's length, not the sheet's
            val ch = inner[m]
            if ch == "(":
                cdepth = cdepth + 1
            elif ch == ")":
                cdepth = cdepth - 1
            elif ch == "," and cdepth == 0:
                comma = m
                break
            m = m + 1
        val prop_name = (if comma >= 0: inner.substring(0, comma) else: inner).trim()
        # `text_starts_with_portable` (byte compare), NOT `.starts_with()`.
        # The x86_64 freestanding kernel build mis-marshals boolean results
        # from text builtins at call depth
        # (doc/08_tracking/bug/x64_freestanding_text_char_at_starts_with.md,
        # residual item 3) — the same defect that once collapsed
        # `_html_scan_events` to zero events in the guest while the host
        # produced a full DOM. This call site sits deep inside the style pass
        # AND recurses, so a mis-marshalled `false` here would declare every
        # custom-property name invalid and splice every `var()` away, which is
        # precisely the SimpleOS WM rung-(d) signature.
        val prop_name_sw_raw = prop_name.starts_with("--")
        val prop_name_sw_portable = text_starts_with_portable(prop_name, "--")
        val valid_var_name = (
            prop_name.len() > 2 and prop_name_sw_portable
        )
        # CSS declarations are last-wins. Search backwards so a matching
        # :root variant (or a later base declaration) overrides an earlier
        # custom property instead of being silently ignored.
        var prop_idx = -1
        var prop_scan = state.prop_count - 1
        while prop_scan >= 0:  # cpu-lane-loop-ok: backward last-wins lookup of one custom-property name in the <=200-entry :root property table; searched backwards on purpose so a later :root variant overrides an earlier declaration
            if state.prop_names[prop_scan] == prop_name:
                prop_idx = prop_scan
                break
            prop_scan = prop_scan - 1
        val prefix = css.substring(scan, open)
        chunks[chunk_count] = prefix
        chunk_count = chunk_count + 1
        var replacement = CssVarResolution.Invalid
        if not valid_var_name:
            replacement = CssVarResolution.Invalid
        elif prop_idx >= 0:
            var cycle = false
            var active_scan = 0
            while active_scan < active_count:  # cpu-lane-loop-ok: detector false positive: bound is active_count, the <=33-slot cycle-detection stack (active_names is [""; 33]) -- a fixed recursion-depth cap, not an element count
                if state.active_names[active_scan] == prop_name:
                    cycle = true
                    break
                active_scan = active_scan + 1
            if cycle:
                replacement = CssVarResolution.Cycle
            else:
                var memo_index = -1
                var memo_scan = 0
                while memo_scan < state.memo_count:  # cpu-lane-loop-ok: linear probe of the <=200-entry var() resolution memo table for one property name; the memo itself exists to stop repeated recursive re-resolution
                    if state.memo_names[memo_scan] == prop_name:
                        memo_index = memo_scan
                        break
                    memo_scan = memo_scan + 1
                if memo_index >= 0:
                    replacement = CssVarResolution.Resolved(
                        value: state.memo_values[memo_index]
                    )
                else:
                    if active_count >= state.active_names.len():
                        return CssVarResolution.DepthExceeded
                    state.active_names[active_count] = prop_name
                    replacement = _css_resolve_vars(
                        state.prop_values[prop_idx], state,
                        resolution_depth + 1,
                        active_count + 1, true
                    )
                    match replacement:
                        CssVarResolution.Resolved(resolved_value):
                            if state.memo_count < state.memo_names.len():
                                state.memo_names[state.memo_count] = prop_name
                                state.memo_values[state.memo_count] = (
                                    resolved_value
                                )
                                state.memo_count = state.memo_count + 1
                        _:
                            pass
        elif comma >= 0:
            val fallback = inner.substring(comma + 1, inner_len).trim()
            replacement = _css_resolve_vars(
                fallback, state, resolution_depth + 1,
                active_count, true
            )
        else:
            replacement = CssVarResolution.Invalid
        var should_use_fallback = false
        match replacement:
            CssVarResolution.Invalid:
                should_use_fallback = valid_var_name
            CssVarResolution.Cycle:
                should_use_fallback = not nested
            CssVarResolution.DepthExceeded:
                should_use_fallback = not nested
            _:
                pass
        if should_use_fallback and comma >= 0:
            val fallback = inner.substring(comma + 1, inner_len).trim()
            replacement = _css_resolve_vars(
                fallback, state, resolution_depth + 1,
                active_count, true
            )
        # An unresolvable `var()` must NOT become the empty string. CSS makes
        # such a declaration invalid at computed-value time (css-variables-1
        # §3.2); splicing empty instead manufactures a syntactically parseable
        # but semantically wrong value. Measured on the `aetheric_dark` sheet:
        # `backdrop-filter: blur(var(--blur-surface)) saturate(170%)` became
        # `blur() saturate(170%)` (21 chars, rejected by
        # simple_web_backdrop_admission because the blur term no longer ends in
        # `px)`), and `background: linear-gradient(...), var(--app-surface)`
        # became `linear-gradient(...),` (73 chars, a bare trailing comma)
        # whose colour was then read off the GRADIENT'S FIRST STOP
        # (0x14FFFFFF) rather than the surface. Those are exactly the three
        # numbers the SimpleOS WM x86_64 lane reported, and they read as a
        # theme/content mismatch rather than as dead variables.
        #
        # This resolver is driven over a WHOLE `<style>` sheet, not one
        # declaration, so "drop the declaration" cannot be expressed by
        # returning `Invalid` (that would drop the entire stylesheet). The
        # fail-closed equivalent at this granularity is to leave the `var(...)`
        # SOURCE TEXT verbatim in place: downstream value parsers already treat
        # a literal `var(` as unparseable, and
        # `src/os/compositor/simple_web_window_renderer.spl` states the intent
        # explicitly — it keeps "unresolved variables as rejection witnesses".
        # The declaration therefore fails loudly instead of attesting a colour
        # it never had.
        var replacement_text = ""
        val unresolved_source = css.substring(open, close + 1)
        var unresolved_here = false
        match replacement:
            CssVarResolution.Resolved(resolved_value):
                replacement_text = resolved_value
            CssVarResolution.Invalid:
                if nested:
                    return CssVarResolution.Invalid
                replacement_text = unresolved_source
                unresolved_here = true
            CssVarResolution.Cycle:
                if nested:
                    return CssVarResolution.Cycle
                replacement_text = unresolved_source
                unresolved_here = true
            CssVarResolution.DepthExceeded:
                if nested:
                    return CssVarResolution.DepthExceeded
                replacement_text = unresolved_source
                unresolved_here = true
            CssVarResolution.BudgetExceeded:
                if nested:
                    return CssVarResolution.BudgetExceeded
                replacement_text = unresolved_source
                unresolved_here = true
        if unresolved_here:
            if unresolved_var_count == 0:
                first_unresolved_name = prop_name
                first_unresolved_sw_raw = prop_name_sw_raw
                first_unresolved_sw_portable = prop_name_sw_portable
                first_unresolved_prop_idx = prop_idx
            unresolved_var_count = unresolved_var_count + 1
        if (
            resolved_len + prefix.len() + replacement_text.len() >
            SIMPLE_WEB_MAX_HTML_BYTES
        ):
            return CssVarResolution.Invalid
        resolved_len = (
            resolved_len + prefix.len() + replacement_text.len()
        )
        chunks[chunk_count] = replacement_text
        chunk_count = chunk_count + 1
        scan = close + 1
    if scan < css_len and vg >= 400:
        return CssVarResolution.BudgetExceeded
    if scan < css_len and chunk_count < chunks.len():
        val suffix = css.substring(scan, css_len)
        if resolved_len + suffix.len() > SIMPLE_WEB_MAX_HTML_BYTES:
            return CssVarResolution.Invalid
        chunks[chunk_count] = suffix
        chunk_count = chunk_count + 1
    # One line, only when something actually failed to resolve, only for the
    # top-level pass. Silent on a healthy sheet.
    #
    # Do NOT replace this with a post-hoc `resolved.index_of("var(") >= 0`
    # check on the caller side: that test was written, measured against a
    # provably-unresolved sheet, and DID NOT FIRE, because under the old
    # splice-to-empty behaviour the `var(` text was already gone by the time
    # anyone could look. The receipt has to live at the substitution site.
    #
    # `props` separates "no custom properties collected" from "collected but
    # the lookup missed" (`idx=-1` with `props>0`). `sw_raw`/`sw_portable`
    # separate BOTH of those from the x86_64 freestanding boolean
    # mis-marshalling of `text.starts_with` at depth: `sw_raw=false` with
    # `sw_portable=true` on a name that plainly begins with `--` is that
    # defect and nothing else.
    if unresolved_var_count > 0 and not nested:
        print "[web-style-producer] css-var-unresolved count={unresolved_var_count} first={first_unresolved_name} idx={first_unresolved_prop_idx} props={state.prop_count} sw_raw={first_unresolved_sw_raw} sw_portable={first_unresolved_sw_portable} css_len={css_len}"
    CssVarResolution.Resolved(
        value: text_list_prefix(chunks, chunk_count).join("")
    )

# Evaluate one comma-group of a @media prelude: every parenthesized term must
# pass. Width terms compare against the viewport; any unknown feature term
# (prefers-*, forced-colors, resolution, ...) fails its group, matching a UA
# with no such preference set (Chrome headless defaults).
fn _media_group_applies(group: text, viewport_w: i32) -> bool:
    var ok = true
    var i = 0
    val n = group.len()
    while i < n and ok:  # cpu-lane-loop-ok: walks the parenthesized feature terms of ONE @media comma-group via native find_from; a handful of terms per group
        val lp = find_from(group, "(", i)
        if lp < 0:
            break
        val rp = find_from(group, ")", lp)
        if rp < 0:
            ok = false
            break
        val term = group.substring(lp + 1, rp).trim().lower()
        val colon = text_index_of(term, ":")
        if colon < 0:
            ok = false
        else:
            val feat = term.substring(0, colon).trim()
            val px = parse_int(term.substring(colon + 1, term.len()))
            if feat == "max-width":
                ok = viewport_w <= px
            elif feat == "min-width":
                ok = viewport_w >= px
            else:
                ok = false
        i = rp + 1
    ok

# Evaluate a @media prelude ("@media (max-width: 599px), print") against the
# viewport width. Comma groups OR together. viewport_w < 0 = legacy mode:
# every media block applies (the pre-media-support behavior).
fn _media_prelude_applies(prelude: text, viewport_w: i32) -> bool:
    if viewport_w < 0:
        return true
    val cond = prelude.substring(6, prelude.len()).trim()
    if cond.len() == 0:
        return true
    val groups = split_top_level_commas(cond)
    val gc = groups.len()
    var gi = 0
    while gi < gc:  # cpu-lane-loop-ok: walks the comma-separated groups of ONE @media prelude; bound is that prelude's comma count
        if _media_group_applies(groups[gi], viewport_w):
            return true
        gi = gi + 1
    false

fn extract_css(html: text) -> Rules:
    # Legacy entry: media blocks all apply (no viewport context).
    extract_css_vw(html, -1)

# Pure-Simple rule-boundary scanner. Returns 3 parallel text arrays in
# document order: [sel_text, decl_text, wrapper_prelude] — trimmed selector /
# declaration text per candidate rule; wrapper_prelude is "" for
# unconditional rules or the "@media (...)" prelude for rules nested in a
# depth-0 @-wrapper.
#
# It must NOT slice the ~336KB stylesheet with `css.substring()` / `css[a:b]`
# per rule: under this interpreter both re-collect the ENTIRE receiver string
# on every call (measured: ~0.7ms per call on a 262KB string → O(rules *
# total_css_len), the multi-second/minute quadratic that hung the browser's
# first frame). Instead it splits the sheet ONCE on "{" (native, O(n)), then
# splits each small segment on "}" (native, O(segment)) and only ever slices
# those small pieces — genuine O(total_css_len). A brace-depth stack tracks
# @-wrappers so depth-1 rules carry their wrapper prelude, matching the
# depth-0-rule / depth-1-child-of-@-wrapper emission the layout cascade
# expects. Native replacement counts admit normal sheets; hostile delimiter
# storms keep only a byte-bounded prefix before either split allocates.
fn _css_scan_rules_simple(css: text, requested_rule_cap: i32) -> CssRuleScan:
    val rule_cap = if requested_rule_cap < 0:
        0
    elif requested_rule_cap > CSS_SCAN_CANDIDATE_CAP:
        CSS_SCAN_CANDIDATE_CAP
    else:
        requested_rule_cap
    if rule_cap == 0:
        return CssRuleScan(
            selectors: [], declarations: [], wrapper_starts: [],
            wrapper_counts: [], wrapper_kinds: [], wrapper_preludes: []
        )
    val structural_cap = rule_cap * 2 + 64
    var cutoff = css.len()
    var excessive_structure = false
    if css.len() > structural_cap:
        excessive_structure = (
            css.len() - css.replace("{", "").len() > structural_cap
        )
        if not excessive_structure:
            excessive_structure = (
                css.len() - css.replace("}", "").len() > structural_cap
            )
    if excessive_structure:
        # ponytail: hostile sheets keep a byte-bounded prefix; add a native
        # positional-count primitive only if standards-level recovery matters.
        cutoff = structural_cap
    val bounded_css = if cutoff < css.len():
        css.substring(0, cutoff)
    else:
        css
    # Brace-depth stack of opener (selector / @-prelude) strings.
    var stack: [text] = [""; 64]
    var depth = 0
    val parts = bounded_css.split("{")
    val np = parts.len()
    if np <= 1:
        return CssRuleScan(
            selectors: [], declarations: [], wrapper_starts: [],
            wrapper_counts: [], wrapper_kinds: [], wrapper_preludes: []
        )
    var cap = np - 1
    if cap > rule_cap:
        cap = rule_cap
    var sels: [text] = [""; cap]
    var decls: [text] = [""; cap]
    var wrapper_starts: [i32] = [0; cap]
    var wrapper_counts: [i32] = [0; cap]
    var wrapper_kinds: [CssWrapperKind] = []
    var wrapper_preludes: [text] = []
    var out = 0
    var sel_pending: text = parts[0]
    var k = 1
    while k < np:  # cpu-lane-loop-ok: the rule-boundary scan: walks the `{`-split segments of one stylesheet (np-1 segments = candidate rules), deliberately native-split then small-piece sliced; once per style invalidation
        val opener = sel_pending.trim()
        # This "{" opens a block whose selector / prelude is `opener`.
        if depth < stack.len():
            stack[depth] = opener
        depth = depth + 1
        val seg: text = parts[k]
        val subs: [text] = seg.split("}")
        val nsubs = subs.len()
        # `subs[0]` is the just-opened block's body up to its first "}". If the
        # block is a leaf rule (opener not an @-wrapper) with a non-empty
        # selector, emit it. Preserve every enclosing @-ancestor so an inner
        # @layer cannot escape a false outer @supports/@media condition.
        val is_wrapper = opener.lower().starts_with("@")
        if (not is_wrapper) and opener.len() > 0 and out < cap:
            wrapper_starts[out] = wrapper_kinds.len()
            var wrapper_count = 0
            var wrapper_depth = 0
            var wrapper_overflow = depth - 1 > 32
            # cpu-lane-loop-ok: walks the @-wrapper ancestors of ONE rule; bound is the brace-depth stack, capped at 32 wrappers over 64 stack slots (all constants -- detector false positive on the bound rule)
            while (
                wrapper_depth < depth - 1 and
                wrapper_depth < stack.len() and
                wrapper_count < 32 and not wrapper_overflow
            ):
                val ancestor: text = stack[wrapper_depth]
                if ancestor.lower().starts_with("@"):
                    val lower_ancestor = ancestor.trim().lower()
                    var kind = CssWrapperKind.Unsupported
                    if (
                        lower_ancestor == "@media" or
                        lower_ancestor.starts_with("@media ") or
                        lower_ancestor.starts_with("@media\t") or
                        lower_ancestor.starts_with("@media\n")
                    ):
                        kind = CssWrapperKind.Media
                    elif (
                        lower_ancestor == "@supports" or
                        lower_ancestor.starts_with("@supports ") or
                        lower_ancestor.starts_with("@supports\t") or
                        lower_ancestor.starts_with("@supports\n")
                    ):
                        kind = CssWrapperKind.Supports
                    elif (
                        lower_ancestor == "@layer" or
                        lower_ancestor.starts_with("@layer ") or
                        lower_ancestor.starts_with("@layer\t") or
                        lower_ancestor.starts_with("@layer\n")
                    ):
                        kind = CssWrapperKind.Layer
                    wrapper_kinds.push(kind)
                    wrapper_preludes.push(ancestor)
                    wrapper_count = wrapper_count + 1
                wrapper_depth = wrapper_depth + 1
            if wrapper_overflow:
                wrapper_kinds.push(CssWrapperKind.Unsupported)
                wrapper_preludes.push("@unsupported-overflow")
                wrapper_count = wrapper_count + 1
            sels[out] = opener
            decls[out] = subs[0].trim()
            wrapper_counts[out] = wrapper_count
            out = out + 1
        # Each "}" in `seg` closes one open block; pop that many.
        var closes = nsubs - 1
        while closes > 0 and depth > 0:  # cpu-lane-loop-ok: pops one brace-depth level per `}` in the current segment; bound is that segment's close-brace count
            depth = depth - 1
            closes = closes - 1
        # The trailing piece after the last "}" is the next block's selector.
        sel_pending = if nsubs > 0: subs[nsubs - 1] else: ""
        k = k + 1
    CssRuleScan(
        selectors: text_list_prefix(sels, out),
        declarations: text_list_prefix(decls, out),
        wrapper_starts: wrapper_starts,
        wrapper_counts: wrapper_counts,
        wrapper_kinds: wrapper_kinds,
        wrapper_preludes: wrapper_preludes
    )

fn extract_css_vw(html: text, viewport_w: i32, trace_stages: bool = false) -> Rules:
    _extract_css_vw_with_rule_limit(
        html, viewport_w, trace_stages, WEB_STYLE_RULE_QUOTA
    )

fn _html_without_inert_template_sources(source: text) -> text:
    val lower = source.lower()
    var parts: [text] = []
    var visible_start = 0
    var pos = 0
    var depth = 0
    var guard = 0
    while pos < source.len() and guard < SIMPLE_WEB_MAX_HTML_PARTS:  # cpu-lane-loop-ok: walks the tags of the HTML source via native find_from to elide inert <template> bodies, capped by SIMPLE_WEB_MAX_HTML_PARTS; once per parse
        guard = guard + 1
        val lt = find_from(lower, "<", pos)
        if lt < 0:
            pos = source.len()
            continue
        val gt = find_from(lower, ">", lt + 1)
        if gt < 0:
            pos = source.len()
            continue
        val inner = lower.substring(lt + 1, gt).trim()
        val closing = inner.starts_with("/")
        val raw_name = if closing:
            inner.substring(1, inner.len()).trim()
        else:
            inner
        var name_end = 0
        # cpu-lane-loop-ok: scans the characters of ONE tag name until whitespace or `/`; bound is that tag name's length, not the document's
        while (
            name_end < raw_name.len() and
            raw_name[name_end:name_end + 1] != " " and
            raw_name[name_end:name_end + 1] != "\t" and
            raw_name[name_end:name_end + 1] != "\n" and
            raw_name[name_end:name_end + 1] != "\r" and
            raw_name[name_end:name_end + 1] != "/"
        ):
            name_end = name_end + 1
        val name = raw_name.substring(0, name_end)
        if name == "template":
            if closing:
                if depth > 0:
                    depth = depth - 1
                    if depth == 0:
                        visible_start = gt + 1
            else:
                if depth == 0:
                    parts.push(source.substring(visible_start, lt))
                if depth < 512:
                    depth = depth + 1
                else:
                    depth = 513
        if not closing and (name == "script" or name == "style"):
            val close = find_from(lower, "</{name}", gt + 1)
            pos = if close < 0: source.len() else: close
        else:
            pos = gt + 1
    if depth == 0 and visible_start < source.len():
        parts.push(source.substring(visible_start, source.len()))
    parts.join("")

fn _extract_css_vw_with_rule_limit(
    source_html: text, viewport_w: i32, trace_stages: bool,
    requested_rule_limit: i32
) -> Rules:
    val rule_limit = if requested_rule_limit < 0:
        0
    elif requested_rule_limit > WEB_STYLE_RULE_QUOTA:
        WEB_STYLE_RULE_QUOTA
    else:
        requested_rule_limit
    if (rule_limit == 0 or not _simple_web_html_source_admitted(
        source_html, SIMPLE_WEB_MAX_HTML_BYTES
    )):
        return Rules(
            group_parts: [], group_specificities: [], decls: [],
            important_decls: []
        )
    val html = _html_without_inert_template_sources(source_html)
    # First pass: collect CSS custom properties from all :root blocks
    var html_tag = find_from(html, "<html", 0)
    var html_tag_guard = 0
    while html_tag >= 0 and html_tag_guard < 20:  # cpu-lane-loop-ok: detector false positive: bound is the literal guard `< 20` retries while locating the real `<html` tag
        html_tag_guard = html_tag_guard + 1
        val after_tag = html_tag + 5
        if after_tag >= html.len():
            html_tag = -1
            break
        val boundary = html[after_tag:after_tag + 1]
        if boundary == ">" or boundary == " " or boundary == "\t" or boundary == "\n" or boundary == "\r":
            break
        html_tag = find_from(html, "<html", after_tag)
    val html_tag_close = if html_tag >= 0: find_from(html, ">", html_tag + 5) else: -1
    val root_attrs = if html_tag >= 0 and html_tag_close >= 0: html.substring(html_tag + 5, html_tag_close) else: ""
    var custom_prop_parts: [text] = [""; 100]
    var custom_prop_count = 0
    var pre_pos = 0
    var pre_guard = 0
    while pre_guard < 100:  # cpu-lane-loop-ok: walks the `<style>` blocks of the document for the custom-property pre-pass, capped at 100 blocks; once per style invalidation
        pre_guard = pre_guard + 1
        val pre_sp = find_from(html, "<style", pre_pos)
        if pre_sp < 0:
            break
        val pre_open = find_from(html, ">", pre_sp)
        if pre_open < 0:
            break
        val pre_close = find_from(html, "</style", pre_open)
        if pre_close < 0:
            break
        val pre_css = html.substring(pre_open + 1, pre_close)
        val collected_props = _css_collect_custom_props(pre_css, root_attrs)
        # STAGE 1 of the `props=0` chain. `props={state.prop_count}` on the
        # `css-var-unresolved` receipt is NOT this function's return value --
        # it is the end of collect -> join -> re-parse, and a zero there is
        # consistent with a failure at any of the three. This receipt pins the
        # collector itself: `pre_css_len>0` with `collected_len=0` means the
        # collector found no `:root` custom properties in a non-empty <style>
        # block. Silent when the block yields properties.
        # PROVEN SILENT 2026-08-09 in the WM lane -- the collector is healthy in
        # the guest; do not re-suspect it without new evidence.
        if collected_props.len() == 0:
            print "[web-style-producer] css-props-stage1 block={pre_guard} pre_css_len={pre_css.len()} collected_len=0"
        if collected_props.len() > 0 and custom_prop_count < custom_prop_parts.len():
            custom_prop_parts[custom_prop_count] = collected_props
            custom_prop_count = custom_prop_count + 1
        pre_pos = pre_close + 1
    val custom_props = if custom_prop_count == 0: "" else: custom_prop_parts.join("")
    # STAGE 2 of the `props=0` chain: the gate at `collected_props.len() > 0`
    # plus the `join("")`. A zero here with a non-zero stage-1 collection means
    # the accumulate/join lost the data rather than the collector.
    # PROVEN SILENT 2026-08-09 in the WM lane -- the join delivers 1365 chars,
    # the host's exact value. The defect is downstream, in the re-parse.
    if custom_props.len() == 0:
        print "[web-style-producer] css-props-stage2 parts={custom_prop_count} custom_props_len=0"
    var group_parts: [[[text]]] = []
    var group_specificities: [[i32]] = []
    var decls: [text] = []
    var important_decls: [text] = []
    var pos = 0
    var guard = 0
    var total_candidates = 0
    while guard < 1000 and group_parts.len() < rule_limit:  # cpu-lane-loop-ok: walks the `<style>` blocks of the document for rule extraction, capped at 1000 blocks and by rule_limit; once per style invalidation
        guard = guard + 1
        val sp = find_from(html, "<style", pos)
        if sp < 0:
            break
        val open = find_from(html, ">", sp)
        if open < 0:
            break
        val close = find_from(html, "</style", open)
        if close < 0:
            break
        val css_raw = html.substring(open + 1, close)
        val css_var_state = CssVarResolutionState.new(custom_props)
        val css_resolution = _css_resolve_vars(
            css_raw, css_var_state, 0, 0, false
        )
        val css = match css_resolution:
            CssVarResolution.Resolved(resolved_css):
                resolved_css
            _:
                css_raw
        # The OTHER silent path: the substitution pass bailed WHOLESALE
        # (budget/depth/invalid) and the sheet is used RAW, so every `var()`
        # in it stays literal. Distinct from the per-`var()` unresolved case
        # reported by `css-var-unresolved` inside `_css_resolve_vars`, and the
        # two must not be confused — the 2026-08-08 WM rung-(d) misdiagnosis
        # came from mistaking one for the other. Silent on a healthy sheet.
        match css_resolution:
            CssVarResolution.Resolved(_):
                pass
            _:
                print "[web-style-producer] css-var-pass-bailed block={guard} props_len={custom_props.len()} css_len={css_raw.len()}"
        # Rule-boundary scan: split the sheet ONCE on "{"/"}" natively rather
        # than walking it a character at a time in interpreted Simple (which
        # cost seconds-to-minutes on a realistic theme sheet). See
        # `_css_scan_rules_simple`. Selector-group splitting, @media condition
        # evaluation, and CSS-variable substitution stay in Simple below.
        val remaining_rules = rule_limit - group_parts.len()
        val bounds: CssRuleScan = _css_scan_rules_simple(
            css, CSS_SCAN_CANDIDATE_CAP
        )
        val b_sel_text: [text] = bounds.selectors
        val b_decl_text: [text] = bounds.declarations
        val candidate_count = b_sel_text.len()
        total_candidates = total_candidates + candidate_count
        if trace_stages:
            print "[layout-trace] css_scan candidates={candidate_count} declarations={b_decl_text.len()} wrappers={bounds.wrapper_kinds.len()}"
            var trace_rule_i = 0
            while trace_rule_i < candidate_count:  # cpu-lane-loop-ok: trace-only: the whole loop sits inside `if trace_stages:` and prints one line per scanned rule; costs nothing when tracing is off
                print "[layout-trace] css_scan rule={trace_rule_i} selector={b_sel_text[trace_rule_i]} decl_len={b_decl_text[trace_rule_i].len()}"
                trace_rule_i = trace_rule_i + 1
        val block_cap = if candidate_count < remaining_rules:
            candidate_count
        else:
            remaining_rules
        var block_group_parts: [[[text]]] = [[[]]; block_cap]
        var block_group_specificities: [[i32]] = [[]; block_cap]
        var block_decls: [text] = [""; block_cap]
        var block_important_decls: [text] = [""; block_cap]
        var out_i = 0
        var bi = 0
        while bi < candidate_count and out_i < remaining_rules:  # cpu-lane-loop-ok: walks the candidate rules _css_scan_rules_simple produced for ONE <style> block; bound is that block's rule count, capped by remaining_rules; once per style invalidation
            var include = true
            val wrapper_start = bounds.wrapper_starts[bi]
            val wrapper_end = (
                wrapper_start + bounds.wrapper_counts[bi]
            )
            var wrapper_i = wrapper_start
            while wrapper_i < wrapper_end and include:  # cpu-lane-loop-ok: walks the <=32 @-wrapper ancestors recorded for THIS rule to evaluate its @media/@supports/@layer conditions
                val wrapper_prelude = (
                    bounds.wrapper_preludes[wrapper_i].trim()
                )
                match bounds.wrapper_kinds[wrapper_i]:
                    CssWrapperKind.Media:
                        include = _media_prelude_applies(
                            wrapper_prelude, viewport_w
                        )
                    CssWrapperKind.Supports:
                        include = eval_supports_query(
                            wrapper_prelude.substring(
                                9, wrapper_prelude.len()
                            ).trim()
                        )
                    CssWrapperKind.Layer:
                        include = true
                    CssWrapperKind.Unsupported:
                        include = false
                wrapper_i = wrapper_i + 1
            if include:
                val sel: text = b_sel_text[bi]
                val decl: text = b_decl_text[bi]
                val rule_groups = split_selector_groups(sel)
                # INLINED on purpose (was split_selector_group_parts): a
                # [[text]] return crossing a Simple-function boundary loses
                # data in the freestanding SimpleOS build (see
                # doc/08_tracking/bug/
                # cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md).
                # Building the nested array as a local and assigning it
                # in-place keeps the handoff inside one call frame.
                val rule_group_count = rule_groups.len()
                var rule_parts: [[text]] = [[]; rule_group_count]
                var rule_specificities: [i32] = [0; rule_group_count]
                var rgi = 0
                while rgi < rule_group_count:  # cpu-lane-loop-ok: walks the selector comma-groups of ONE rule, capped at CSS_SELECTOR_GROUP_CAP (16)
                    rule_parts[rgi] = selector_group_parts(rule_groups[rgi])
                    rule_specificities[rgi] = _group_specificity(rule_parts[rgi])
                    rgi = rgi + 1
                block_group_parts[out_i] = rule_parts
                block_group_specificities[out_i] = rule_specificities
                val priority_decls = css_declaration_priority_split(decl)
                block_decls[out_i] = priority_decls.normal
                block_important_decls[out_i] = priority_decls.important
                out_i = out_i + 1
            bi = bi + 1
        # INLINED on purpose (was group_parts_list_prefix): same aggregate
        # cross-function-return hazard as above — append each element
        # directly instead of returning a [[[text]]] prefix slice.
        var gi = 0
        while gi < out_i:
            group_parts = group_parts + [block_group_parts[gi]]
            group_specificities = group_specificities + [block_group_specificities[gi]]
            gi = gi + 1
        decls = decls + text_list_prefix(block_decls, out_i)
        important_decls = important_decls + text_list_prefix(
            block_important_decls, out_i
        )
        pos = close + 1
    val result = Rules(
        group_parts: group_parts,
        group_specificities: group_specificities,
        decls: decls,
        important_decls: important_decls)
    if trace_stages:
        print "[layout-trace] css_result rules={result.group_parts.len()} decls={result.decls.len()}"
    # Silent-on-healthy attribution receipt: scanned at least one candidate
    # rule but the Rules struct came back with zero selector groups. The
    # split/inline handoffs above are proven-local now; if this still fires,
    # the remaining suspect is the Rules struct return itself (see
    # doc/08_tracking/bug/cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md).
    if total_candidates > 0 and group_parts.len() == 0:
        print "[css-extract] degenerate candidates={total_candidates} groups=0"
    result

pub fn simple_web_layout_debug_capped_css_rule_count(
    html: text, requested_rule_limit: i32
) -> i32:
    _extract_css_vw_with_rule_limit(
        html, -1, false, requested_rule_limit
    ).group_parts.len()

fn unquote_css_attr_value(raw: text) -> text:
    val v = raw.trim()
    if v.len() >= 2:
        val first = v[0:0 + 1]
        # Exact last-byte slice: the quote characters being tested are
        # ASCII; a multi-byte final character simply never matches.
        val last = v[v.len() - 1:v.len()]
        if (first == "\"" and last == "\"") or (first == "'" and last == "'"):
            return v.substring(1, v.len() - 1)
    v

fn attr_selector_matches(attrs: text, expr: text) -> bool:
    var raw = expr.trim()
    if raw.len() == 0:
        return false
    var case_insensitive = false
    if raw.ends_with(" i") or raw.ends_with(" I"):
        case_insensitive = true
        raw = raw.substring(0, raw.len() - 2).trim()
    elif raw.ends_with(" s") or raw.ends_with(" S"):
        # Explicit case-sensitive flag; comparison below already has that
        # behavior, but remove the flag before unquoting the operand.
        raw = raw.substring(0, raw.len() - 2).trim()
    val prefix_op = text_index_of(raw, "^=")
    if prefix_op >= 0:
        val name = raw.substring(0, prefix_op).trim()
        val want = unquote_css_attr_value(raw.substring(prefix_op + 2, raw.len()))
        val actual = attr_value(attrs, name)
        if case_insensitive:
            return actual.len() > 0 and actual.lower().starts_with(want.lower())
        return actual.len() > 0 and actual.starts_with(want)
    val suffix_op = text_index_of(raw, "$=")
    if suffix_op >= 0:
        val name = raw.substring(0, suffix_op).trim()
        val want = unquote_css_attr_value(raw.substring(suffix_op + 2, raw.len()))
        val actual = attr_value(attrs, name)
        if case_insensitive:
            return actual.len() > 0 and actual.lower().ends_with(want.lower())
        return actual.len() > 0 and actual.ends_with(want)
    val exact_op = text_index_of(raw, "=")
    if exact_op >= 0:
        val name = raw.substring(0, exact_op).trim()
        val want = unquote_css_attr_value(raw.substring(exact_op + 1, raw.len()))
        if case_insensitive:
            return attr_value(attrs, name).lower() == want.lower()
        return attr_value(attrs, name) == want
    attr_value(attrs, raw).len() > 0

fn class_words_has(words: [text], want: text) -> bool:
    var i = 0
    val word_count = words.len()
    while i < word_count:  # cpu-lane-loop-ok: linear scan of ONE node's class-word list for one wanted class; bound is that node's class count (single digits in practice)
        if words[i] == want:
            return true
        i = i + 1
    false

fn base_selector_matches(base: text, tag: text, cls: text, class_words: [text], id: text) -> bool:
    if base.len() == 0:
        return true
    # universal selector (e.g. the `*, *::before, *::after` margin/padding reset)
    if base == "*":
        return true
    if base[0:0 + 1] == ".":
        val want = base.substring(1, base.len())
        return class_has_all(class_words, want)
    if base[0:0 + 1] == "#":
        # #id or compound #id.class(.class...)
        val id_dot = find_from(base, ".", 1)
        if id_dot >= 0:
            val want_id = base.substring(1, id_dot)
            val want_cls = base.substring(id_dot + 1, base.len())
            return id == want_id and class_has_all(class_words, want_cls)
        return id == base.substring(1, base.len())
    val hash = text_index_of(base, "#")
    if hash > 0:
        # tag#id or tag#id.class
        val t = base.substring(0, hash)
        val dot2 = find_from(base, ".", hash + 1)
        if dot2 >= 0:
            val want_id = base.substring(hash + 1, dot2)
            val want_cls = base.substring(dot2 + 1, base.len())
            return t == tag and id == want_id and class_has_all(class_words, want_cls)
        return t == tag and id == base.substring(hash + 1, base.len())
    val dot = text_index_of(base, ".")
    if dot >= 0:
        val t = base.substring(0, dot)
        val want = base.substring(dot + 1, base.len())
        return t == tag and class_has_all(class_words, want)
    base == tag

# Check :not(), :is(), :where() pseudo-class against this element's base properties.
# Returns true if the selector pseudo condition is satisfied.
fn _pseudo_list_matches(
    pseudo: text, arg: text, tag: text, cls: text,
    class_words: [text], id: text, attrs: text,
    recursion_depth: i32 = 0
) -> bool:
    if recursion_depth > 32:
        return false
    # Split arg on commas (not inside parens) to get individual options
    var options: [text] = [""; 16]
    var opt_count = 0
    var depth = 0
    var i = 0
    val arg_len = arg.len()
    var option_start = 0
    while i < arg_len:  # cpu-lane-loop-ok: splits ONE :not()/:is()/:where() argument on top-level commas; bound is that argument's length
        val ch = arg[i:i + 1]
        if ch == "(":
            depth = depth + 1
            if depth > 32:
                return false
        elif ch == ")":
            depth = depth - 1
            if depth < 0:
                return false
        elif ch == "," and depth == 0:
            if opt_count >= 16:
                return false
            val option = arg.substring(option_start, i).trim()
            if option.len() == 0:
                return false
            options[opt_count] = option
            opt_count = opt_count + 1
            option_start = i + 1
        i = i + 1
    if depth != 0:
        return false
    val tail = arg.substring(option_start, arg_len).trim()
    if tail.len() == 0:
        return false
    if tail.len() > 0 and opt_count >= 16:
        return false
    if tail.len() > 0:
        options[opt_count] = tail
        opt_count = opt_count + 1
    if pseudo == "not":
        # :not(sel, ...) — match if NONE of the options match
        var j = 0
        while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 parsed :not() options, returning false at the first option that matches
            val opt = options[j]
            if (
                opt.len() > 0 and simple_match(
                    opt, tag, cls, class_words, id, attrs,
                    recursion_depth
                )
            ):
                return false
            j = j + 1
        return true
    if pseudo == "is" or pseudo == "where":
        # :is(sel, ...) / :where(sel, ...) — match if ANY option matches
        var j = 0
        while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 parsed :is()/:where() options, returning true at the first option that matches
            val opt = options[j]
            if (
                opt.len() > 0 and simple_match(
                    opt, tag, cls, class_words, id, attrs,
                    recursion_depth
                )
            ):
                return true
            j = j + 1
        return false
    # Unknown pseudo-class: treat as non-matching for reject tests, but allow pass-through
    # for unknown structural pseudos (handled in full context).
    false

fn simple_match(
    sel: text, tag: text, cls: text, class_words: [text],
    id: text, attrs: text, recursion_depth: i32 = 0
) -> bool:
    if sel.len() == 0 or recursion_depth > 32:
        return false
    # Pseudo-element selectors (::before, ::after, ::selection, ...) target
    # boxes this engine does not render; they must never match the host
    # element (previously "body::before" applied its decls to <body> itself).
    if text_index_of(sel, "::") >= 0:
        return false
    # Split off the base (before the first colon at depth 0)
    var base = sel
    val colon = text_index_of(base, ":")
    if colon >= 0:
        base = base.substring(0, colon)
    val attr_start = text_index_of(base, "[")
    if attr_start >= 0:
        val attr_end = text_index_of(base, "]")
        if attr_end < attr_start:
            return false
        val node_base = base.substring(0, attr_start).trim()
        val expr = base.substring(attr_start + 1, attr_end)
        if not (base_selector_matches(node_base, tag, cls, class_words, id) and attr_selector_matches(attrs, expr)):
            return false
    else:
        if not base_selector_matches(base, tag, cls, class_words, id):
            return false
    # Now check pseudo-classes (at the current element level, no node-position context)
    if colon < 0:
        return true
    var pseudo_pos = colon
    var pseudo_count = 0
    while pseudo_pos < sel.len():  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector; bound is that selector's length with a hard pseudo_count cap of 32
        pseudo_count = pseudo_count + 1
        if pseudo_count > 32 or sel[pseudo_pos:pseudo_pos + 1] != ":":
            return false
        val name_start = pseudo_pos + 1
        var name_end = name_start
        # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
        while (
            name_end < sel.len() and sel[name_end:name_end + 1] != ":" and
            sel[name_end:name_end + 1] != "(" and sel[name_end:name_end + 1] != "["
        ):
            name_end = name_end + 1
        val pseudo = sel.substring(name_start, name_end)
        if pseudo.len() == 0:
            return false
        var arg = ""
        if name_end < sel.len() and sel[name_end:name_end + 1] == "(":
            var functional_depth = 1
            var close = name_end + 1
            while close < sel.len() and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo-class argument; bound is the remaining selector length, paren depth capped at 32
                val ch = sel[close:close + 1]
                if ch == "(":
                    functional_depth = functional_depth + 1
                    if functional_depth > 32:
                        return false
                elif ch == ")":
                    functional_depth = functional_depth - 1
                close = close + 1
            if functional_depth != 0:
                return false
            arg = sel.substring(name_end + 1, close - 1).trim()
            pseudo_pos = close
        else:
            pseudo_pos = name_end
            if (
                pseudo == "root" and pseudo_pos < sel.len() and
                sel[pseudo_pos:pseudo_pos + 1] == "["
            ):
                val attr_close = find_from(sel, "]", pseudo_pos + 1)
                if attr_close < 0 or not attr_selector_matches(
                    attrs, sel.substring(pseudo_pos + 1, attr_close)
                ):
                    return false
                pseudo_pos = attr_close + 1
        if pseudo == "not" or pseudo == "is" or pseudo == "where":
            if not _pseudo_list_matches(
                pseudo, arg, tag, cls, class_words, id, attrs,
                recursion_depth + 1
            ):
                return false
        elif _is_interaction_state_pseudo(pseudo, attrs):
            return false
        elif pseudo == "root":
            if tag != "html":
                return false
        elif (
            pseudo != "empty" and pseudo != "first-child" and
            pseudo != "last-child" and pseudo != "only-child" and
            pseudo != "nth-child" and pseudo != "has"
        ):
            return false
    true

# Interaction/UA-state pseudo-classes a static renderer must treat as
# unsatisfied. `:disabled` honors an actual disabled attribute when present.
fn _is_interaction_state_pseudo(pseudo: text, attrs: text) -> bool:
    if pseudo == "hover":
        return true
    if pseudo == "active":
        return true
    if pseudo == "focus":
        return true
    if pseudo == "focus-visible":
        return true
    if pseudo == "focus-within":
        return true
    if pseudo == "visited":
        return true
    if pseudo == "target":
        return true
    if pseudo == "checked":
        return true
    if pseudo == "placeholder-shown":
        return true
    if pseudo == "autofill":
        return true
    if pseudo == "disabled":
        return not attrs.contains("disabled")
    false

fn class_has_all(words: [text], wants: text) -> bool:
    val wants_len = wants.len()
    var start = 0
    var i = 0
    while i <= wants_len:  # cpu-lane-loop-ok: splits a `.a.b.c` compound class selector on `.`; bound is that compound's text length
        if i == wants_len or wants[i:i + 1] == ".":
            if i > start:
                val want = wants.substring(start, i)
                if not class_words_has(words, want):
                    return false
            start = i + 1
        i = i + 1
    true

fn class_contains(cls: text, want: text) -> bool:
    cls.contains(want)

# Count element-type siblings of node[idx] up to and including idx (1-based child position).
fn _child_position(ctx: SelectorContext, idx: i32) -> i32:
    if idx < 0 or idx >= ctx.element_position.len():
        return 1
    ctx.element_position[idx]

# Count total element-type children of parent of node[idx].
fn _sibling_count(ctx: SelectorContext, idx: i32) -> i32:
    if idx < 0 or idx >= ctx.element_sibling_count.len():
        return 1
    ctx.element_sibling_count[idx]

# Evaluate :nth-child(expr) where expr is odd, even, or an+b / n+b / b.
fn _nth_child_matches(expr: text, pos: i32) -> bool:
    val e = expr.trim()
    if e == "odd":
        return (pos % 2) == 1
    if e == "even":
        return (pos % 2) == 0
    # Check for "an+b" or "n+b" or just "b"
    val n_idx = text_index_of(e, "n")
    if n_idx >= 0:
        val a_str = e.substring(0, n_idx).trim()
        val a = if a_str == "" or a_str == "+": 1 elif a_str == "-": -1 else: parse_int(a_str)
        val after_n = e.substring(n_idx + 1, e.len()).trim()
        val b = if after_n.len() == 0: 0 else: parse_int(after_n)
        if a == 0:
            return pos == b
        val rem = pos - b
        if rem < 0:
            return false
        return (rem % a) == 0
    # plain number
    parse_int(e) == pos

# Check whether any node that is a child of parent_idx matches simple selector sel_arg.
fn _has_direct_child_match(nodes: [HNode], ctx: SelectorContext, parent_idx: i32, sel_arg: text) -> bool:
    if parent_idx < 0 or parent_idx >= ctx.child_index.first_child.len():
        return false
    var c = ctx.child_index.first_child[parent_idx]
    while c >= 0:  # cpu-lane-loop-ok: walks the direct-child sibling chain of one parent via child_index.next_sibling for :has(> sel); bound is that parent's child count
        val nd = nodes[c]
        if nd.tag != "#text":
            if simple_match(sel_arg, nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw):
                return true
        c = ctx.child_index.next_sibling[c]
    false

# Check whether any descendant of node[idx] matches simple selector sel_arg.
fn _has_descendant_match(nodes: [HNode], ctx: SelectorContext, idx: i32, sel_arg: text) -> bool:
    if idx < 0 or idx >= ctx.child_index.first_child.len():
        return false
    val node_count = nodes.len()
    var stack: [i32] = [0; node_count]
    var stack_len = 0
    var c = ctx.child_index.first_child[idx]
    while c >= 0:  # cpu-lane-loop-ok: seeds the :has() descendant DFS stack with the direct children of one node
        stack[stack_len] = c
        stack_len = stack_len + 1
        c = ctx.child_index.next_sibling[c]
    while stack_len > 0:  # cpu-lane-loop-ok: DFS over ONE node's subtree evaluating :has(sel); bound is that subtree's descendant count
        stack_len = stack_len - 1
        val cur = stack[stack_len]
        val nd = nodes[cur]
        if nd.tag != "#text":
            if simple_match(sel_arg, nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw):
                return true
        c = ctx.child_index.first_child[cur]
        while c >= 0:  # cpu-lane-loop-ok: pushes the children of the just-popped node onto the :has() DFS stack; bound is that node's child count
            stack[stack_len] = c
            stack_len = stack_len + 1
            c = ctx.child_index.next_sibling[c]
    false

# Check any :has() option (space-separated = descendant, "> .x" = direct child).
fn _has_option_matches(nodes: [HNode], ctx: SelectorContext, idx: i32, opt: text) -> bool:
    val trimmed = opt.trim()
    if trimmed.starts_with("> "):
        val child_sel = trimmed.substring(2, trimmed.len()).trim()
        return _has_direct_child_match(nodes, ctx, idx, child_sel)
    if trimmed == ">":
        return false
    _has_descendant_match(nodes, ctx, idx, trimmed)

# Check whether a node has any child element (non-text) or non-whitespace text children.
fn _node_is_empty(ctx: SelectorContext, idx: i32) -> bool:
    if idx < 0 or idx >= ctx.has_content_child.len():
        return true
    not ctx.has_content_child[idx]

# Full-context pseudo-class check. Called after simple_match() passes the base check.
# Returns true if all pseudo-class conditions on sel are satisfied given node context.
fn _pseudo_ctx_matches(sel: text, nodes: [HNode], ctx: SelectorContext, idx: i32) -> bool:
    val colon = text_index_of(sel, ":")
    if colon < 0:
        return true
    var pseudo_pos = colon
    var pseudo_count = 0
    while pseudo_pos < sel.len():  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector in the positional-pseudo pass; bound is that selector's length, pseudo_count capped at 32
        pseudo_count = pseudo_count + 1
        if pseudo_count > 32 or sel[pseudo_pos:pseudo_pos + 1] != ":":
            return false
        val name_start = pseudo_pos + 1
        var name_end = name_start
        # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
        while (
            name_end < sel.len() and sel[name_end:name_end + 1] != ":" and
            sel[name_end:name_end + 1] != "(" and sel[name_end:name_end + 1] != "["
        ):
            name_end = name_end + 1
        val pseudo = sel.substring(name_start, name_end)
        if pseudo.len() == 0:
            return false
        var arg = ""
        if name_end < sel.len() and sel[name_end:name_end + 1] == "(":
            var functional_depth = 1
            var close = name_end + 1
            while close < sel.len() and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo-class argument in the positional pass; paren depth capped at 32
                val ch = sel[close:close + 1]
                if ch == "(":
                    functional_depth = functional_depth + 1
                    if functional_depth > 32:
                        return false
                elif ch == ")":
                    functional_depth = functional_depth - 1
                close = close + 1
            if functional_depth != 0:
                return false
            arg = sel.substring(name_end + 1, close - 1).trim()
            pseudo_pos = close
        else:
            pseudo_pos = name_end
            if (
                pseudo == "root" and pseudo_pos < sel.len() and
                sel[pseudo_pos:pseudo_pos + 1] == "["
            ):
                val attr_close = find_from(sel, "]", pseudo_pos + 1)
                if attr_close < 0:
                    return false
                pseudo_pos = attr_close + 1
        if pseudo == "empty":
            if not _node_is_empty(ctx, idx):
                return false
        elif pseudo == "first-child":
            if _child_position(ctx, idx) != 1:
                return false
        elif pseudo == "last-child":
            if _child_position(ctx, idx) != _sibling_count(ctx, idx):
                return false
        elif pseudo == "only-child":
            if _sibling_count(ctx, idx) != 1:
                return false
        elif pseudo == "nth-child":
            if not _nth_child_matches(arg, _child_position(ctx, idx)):
                return false
        elif pseudo == "has":
            var opts: [text] = [""; 16]
            var opt_count = 0
            var depth = 0
            var i = 0
            var option_start = 0
            while i < arg.len():  # cpu-lane-loop-ok: splits ONE :has() argument on top-level commas; bound is that argument's length
                val ch = arg[i:i + 1]
                if ch == "(":
                    depth = depth + 1
                    if depth > 32:
                        return false
                elif ch == ")":
                    depth = depth - 1
                    if depth < 0:
                        return false
                elif ch == "," and depth == 0:
                    if opt_count >= opts.len():
                        return false
                    val option = arg.substring(option_start, i).trim()
                    if option.len() == 0:
                        return false
                    opts[opt_count] = option
                    opt_count = opt_count + 1
                    option_start = i + 1
                i = i + 1
            if depth != 0:
                return false
            val tail = arg.substring(option_start, arg.len()).trim()
            if tail.len() == 0 or opt_count >= opts.len():
                return false
            if tail.len() > 0:
                opts[opt_count] = tail
                opt_count = opt_count + 1
            var matched = false
            var j = 0
            while j < opt_count and not matched:  # cpu-lane-loop-ok: walks the <=16 parsed :has() options, stopping at the first that matches
                matched = _has_option_matches(
                    nodes, ctx, idx, opts[j]
                )
                j = j + 1
            if not matched:
                return false
        elif (
            pseudo == "not" or pseudo == "is" or pseudo == "where" or
            pseudo == "root" or pseudo == "hover" or pseudo == "active" or
            pseudo == "focus" or pseudo == "focus-visible" or
            pseudo == "focus-within" or pseudo == "visited" or
            pseudo == "target" or pseudo == "checked" or
            pseudo == "placeholder-shown" or pseudo == "autofill" or
            pseudo == "disabled"
        ):
            # Base matching already handled these state/list pseudos.
            var already_checked = true
        else:
            return false
    true

# Full-context simple match: base match + pseudo-class positional check.
fn simple_match_ctx(sel: text, tag: text, cls: text, class_words: [text], id: text, attrs: text, nodes: [HNode], ctx: SelectorContext, idx: i32) -> bool:
    if not simple_match(sel, tag, cls, class_words, id, attrs):
        return false
    _pseudo_ctx_matches(sel, nodes, ctx, idx)

fn split_selector_groups(sel: text) -> [text]:
    var depth = 0
    var i = 0
    val sel_len = sel.len()
    var group_count = 0
    var group_start = 0
    while i < sel_len:  # cpu-lane-loop-ok: counting pass over ONE selector's characters to size the comma-group array; bound is that selector's length
        val ch = sel[i:i + 1]
        if ch == "(":
            depth = depth + 1
            if depth > 32:
                return []
        elif ch == ")":
            depth = depth - 1
            if depth < 0:
                return []
        elif ch == "," and depth == 0:
            if sel.substring(group_start, i).trim().len() == 0:
                return []
            group_count = group_count + 1
            if group_count >= CSS_SELECTOR_GROUP_CAP:
                return []
            group_start = i + 1
        i = i + 1
    if depth != 0:
        return []
    if sel.substring(group_start, sel_len).trim().len() == 0:
        return []
    group_count = group_count + 1
    if group_count == 0 or group_count > CSS_SELECTOR_GROUP_CAP:
        return []
    var groups: [text] = [""; group_count]
    depth = 0
    i = 0
    var group_i = 0
    group_start = 0
    while i < sel_len and group_i < group_count:  # cpu-lane-loop-ok: emit pass over the same selector, filling the <=CSS_SELECTOR_GROUP_CAP group array
        val ch = sel[i:i + 1]
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            if depth > 0:
                depth = depth - 1
        elif ch == "," and depth == 0:
            groups[group_i] = sel.substring(group_start, i).trim()
            group_i = group_i + 1
            group_start = i + 1
        i = i + 1
    if group_i < groups.len():
        val tail = sel.substring(group_start, sel_len).trim()
        if tail.len() > 0:
            groups[group_i] = tail
    groups

fn normalize_child_combinators(group: text) -> text:
    var i = 0
    val group_len = group.len()
    var depth = 0
    var combinator_count = 0
    while i < group_len and combinator_count <= CSS_SELECTOR_PART_CAP:  # cpu-lane-loop-ok: counting pass over ONE selector group's characters counting depth-0 `>` combinators, capped at CSS_SELECTOR_PART_CAP
        val ch = group[i:i + 1]
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            if depth > 0:
                depth = depth - 1
        elif ch == ">" and depth == 0:
            combinator_count = combinator_count + 1
        i = i + 1
    if combinator_count > CSS_SELECTOR_PART_CAP:
        return ""
    if combinator_count == 0:
        return group.trim()
    val chunk_count = combinator_count * 2 + 1
    var chunks: [text] = [""; chunk_count]
    var chunk_i = 0
    var start = 0
    i = 0
    depth = 0
    while i < group_len:  # cpu-lane-loop-ok: emit pass over the same group, splitting it around each depth-0 `>` combinator
        val ch = group[i:i + 1]
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            if depth > 0:
                depth = depth - 1
        elif ch == ">" and depth == 0:
            chunks[chunk_i] = group.substring(start, i)
            chunk_i = chunk_i + 1
            chunks[chunk_i] = " > "
            chunk_i = chunk_i + 1
            start = i + 1
        i = i + 1
    chunks[chunk_i] = group.substring(start, group_len)
    chunks.join("").trim()

fn selector_group_parts(group: text) -> [text]:
    # Split on spaces at depth-0 only: depth counts ( ) and [ ] so that spaces
    # inside :has(> .x) args and [attr='val with spaces'] are preserved.
    val normalized = normalize_child_combinators(group)
    val norm_len = normalized.len()
    # First pass: count tokens
    var token_count = 0
    var depth = 0
    var in_token = false
    var pi = 0
    while pi < norm_len and token_count <= CSS_SELECTOR_PART_CAP:  # cpu-lane-loop-ok: token-counting pass over ONE normalized selector group; bound is that group's length, capped at CSS_SELECTOR_PART_CAP tokens
        val ch = normalized[pi:pi + 1]
        if ch == "(" or ch == "[":
            depth = depth + 1
            if not in_token:
                token_count = token_count + 1
                in_token = true
        elif ch == ")" or ch == "]":
            if depth > 0:
                depth = depth - 1
        elif ch == " " and depth == 0:
            in_token = false
        else:
            if not in_token:
                token_count = token_count + 1
                in_token = true
        pi = pi + 1
    if token_count > CSS_SELECTOR_PART_CAP:
        return []
    if token_count == 0:
        return [""]
    var parts: [text] = [""; token_count]
    var part_i = 0
    depth = 0
    in_token = false
    var token_start = -1
    pi = 0
    while pi < norm_len:  # cpu-lane-loop-ok: token-emit pass over the same normalized group, slicing each depth-0 whitespace-separated part
        val ch = normalized[pi:pi + 1]
        if ch == "(" or ch == "[":
            if not in_token:
                token_start = pi
            depth = depth + 1
            in_token = true
        elif ch == ")" or ch == "]":
            if not in_token:
                token_start = pi
            if depth > 0:
                depth = depth - 1
            in_token = true
        elif ch == " " and depth == 0:
            if in_token:
                if part_i < token_count:
                    parts[part_i] = normalized.substring(token_start, pi).trim()
                    part_i = part_i + 1
                token_start = -1
                in_token = false
        else:
            if not in_token:
                token_start = pi
            in_token = true
        pi = pi + 1
    if token_start >= 0 and part_i < token_count:
        val tail = normalized.substring(token_start, norm_len).trim()
        if tail.len() > 0:
            parts[part_i] = tail
    parts

fn selector_rightmost_part(parts: [text]) -> text:
    var right = parts.len() - 1
    while right >= 0:  # cpu-lane-loop-ok: scans ONE selector group's parts from the right for the rightmost non-empty, non-`>` part; bound is that group's part count (<=256)
        val part = parts[right]
        if part.len() > 0 and part != ">":
            return part
        right = right - 1
    ""

fn selector_bucket_base(part: text) -> text:
    var base = part
    val colon = text_index_of(base, ":")
    if colon >= 0:
        base = base.substring(0, colon)
    val attr_start = text_index_of(base, "[")
    if attr_start >= 0:
        base = base.substring(0, attr_start).trim()
    base

fn selector_bucket_kind(part: text) -> text:
    val base = selector_bucket_base(part)
    selector_bucket_kind_from_base(base)

fn selector_bucket_kind_from_base(base: text) -> text:
    if base.len() == 0 or base == "*":
        return "fallback"
    if base[0:0 + 1] == "#":
        return "id"
    if base[0:0 + 1] == ".":
        return "class"
    # tag#id compound: bucket as "id" so rules fire when node has that id
    val hash = text_index_of(base, "#")
    if hash > 0:
        return "id"
    if text_index_of(base, ".") >= 0:
        return "class"
    "tag"

fn selector_bucket_value(part: text) -> text:
    val base = selector_bucket_base(part)
    selector_bucket_value_from_base(base)

fn selector_bucket_value_from_base(base: text) -> text:
    if base.len() == 0:
        return ""
    val first = base[0:0 + 1]
    if first == "#" or first == ".":
        val dot = find_from(base, ".", 1)
        if dot >= 0:
            return base.substring(1, dot)
        return base.substring(1, base.len())
    # tag#id compound: return the id part as the bucket key
    val hash = text_index_of(base, "#")
    if hash > 0:
        val dot2 = find_from(base, ".", hash + 1)
        if dot2 >= 0:
            return base.substring(hash + 1, dot2)
        return base.substring(hash + 1, base.len())
    val dot = text_index_of(base, ".")
    if dot >= 0:
        val next_dot = find_from(base, ".", dot + 1)
        if next_dot >= 0:
            return base.substring(dot + 1, next_dot)
        return base.substring(dot + 1, base.len())
    base

fn text_key_index_count(keys: [text], key: text, key_count: i32) -> i32:
    var i = 0
    while i < key_count:  # cpu-lane-loop-ok: linear key scan reached only as the documented fallback when the O(1) key Dict is unavailable -- dict_key_index_count tries `d.has(key)` first, so the hosted lane never walks this
        if keys[i] == key:
            return i
        i = i + 1
    -1


fn i32_list_prefix(values: [i32], count: i32) -> [i32]:
    var out: [i32] = [0; count]
    var i = 0
    while i < count:  # cpu-lane-loop-ok: prefix copy of an i32 array; bound is the requested count
        out[i] = values[i]
        i = i + 1
    out

fn text_seen_before(values: [text], end_index: i32, value: text) -> bool:
    var i = 0
    while i < end_index:  # cpu-lane-loop-ok: dedupe probe over ONE node's already-visited class words; bound is that node's class index i, single digits in practice
        if values[i] == value:
            return true
        i = i + 1
    false

fn merge_two_sorted_rule_lists_unique(left: [i32], right: [i32]) -> [i32]:
    val left_count = left.len()
    val right_count = right.len()
    if left_count == 0:
        return right
    if right_count == 0:
        return left
    var li = 0
    var ri = 0
    var out_count = 0
    var last = -1
    var has_last = false
    while li < left_count or ri < right_count:  # cpu-lane-loop-ok: count pass of the 2-way sorted-rule-list merge (O(left+right)), sizing the output before allocation
        var next = 0
        if ri >= right_count or (li < left_count and left[li] <= right[ri]):
            next = left[li]
            li = li + 1
        else:
            next = right[ri]
            ri = ri + 1
        if not has_last or next != last:
            out_count = out_count + 1
            last = next
            has_last = true
    var out: [i32] = [0; out_count]
    li = 0
    ri = 0
    var oi = 0
    last = -1
    has_last = false
    while li < left_count or ri < right_count:  # cpu-lane-loop-ok: emit pass of the same 2-way sorted-rule-list merge, writing the deduped union
        var next = 0
        if ri >= right_count or (li < left_count and left[li] <= right[ri]):
            next = left[li]
            li = li + 1
        else:
            next = right[ri]
            ri = ri + 1
        if not has_last or next != last:
            out[oi] = next
            oi = oi + 1
            last = next
            has_last = true
    out

fn merge_sorted_rule_lists_unique_count(lists: [[i32]], list_count: i32) -> [i32]:
    if list_count == 0:
        return []
    if list_count == 1:
        return lists[0]
    if list_count == 2:
        return merge_two_sorted_rule_lists_unique(lists[0], lists[1])
    var positions: [i32] = [0; list_count]
    var out_count = 0
    var last = -1
    var has_last = false
    var done = false
    while not done:  # cpu-lane-loop-ok: outer count pass of the k-way sorted-rule-list merge: one iteration per distinct output rule id
        var min_rule = 2147483647
        var found = false
        var list_i = 0
        while list_i < list_count:  # cpu-lane-loop-ok: inner min-scan arm of the k-way merge count pass over the k candidate lists (k = this node's class count + 3)
            val rules = lists[list_i]
            val rule_count = rules.len()
            var pos = positions[list_i]
            while pos < rule_count and has_last and rules[pos] == last:  # cpu-lane-loop-ok: duplicate-skip arm of the count pass: advances past repeats of the last emitted rule id inside one already-sorted bucket list
                pos = pos + 1
            positions[list_i] = pos
            if pos < rule_count and rules[pos] < min_rule:
                min_rule = rules[pos]
                found = true
            list_i = list_i + 1
        if found:
            out_count = out_count + 1
            last = min_rule
            has_last = true
        else:
            done = true
    positions = [0; list_count]
    var out: [i32] = [0; out_count]
    var out_i = 0
    last = -1
    has_last = false
    done = false
    while not done:  # cpu-lane-loop-ok: outer emit pass of the k-way sorted-rule-list merge: one iteration per distinct output rule id
        var min_rule = 2147483647
        var found = false
        var list_i = 0
        while list_i < list_count:  # cpu-lane-loop-ok: inner min-scan arm of the k-way merge emit pass over the k candidate lists (k = this node's class count + 3)
            val rules = lists[list_i]
            val rule_count = rules.len()
            var pos = positions[list_i]
            while pos < rule_count and has_last and rules[pos] == last:  # cpu-lane-loop-ok: duplicate-skip arm of the emit pass: advances past repeats of the last emitted rule id inside one already-sorted bucket list
                pos = pos + 1
            positions[list_i] = pos
            if pos < rule_count and rules[pos] < min_rule:
                min_rule = rules[pos]
                found = true
            list_i = list_i + 1
        if found:
            out[out_i] = min_rule
            out_i = out_i + 1
            last = min_rule
            has_last = true
        else:
            done = true
    out

fn rule_lists_from_counts(counts: [i32]) -> [[i32]]:
    val count_len = counts.len()
    var lists: [[i32]] = [[]; count_len]
    var i = 0
    while i < count_len:  # cpu-lane-loop-ok: allocates one exactly-sized rule bucket per distinct selector key; bound is the distinct-key count
        lists[i] = [0; counts[i]]
        i = i + 1
    lists

fn dict_key_index_count(d: Dict<text, i32>, keys: [text], key: text, count: i32) -> i32:
    if d.has(key):
        return d[key]
    # ponytail: linear fallback keeps Simple-core correct until its Dict ABI is available; hosted runtimes stay O(1).
    text_key_index_count(keys, key, count)

fn build_rule_buckets(rules: Rules, trace_stages: bool = false) -> RuleBuckets:
    var bucket_capacity = 0
    var cr = 0
    val rule_count = rules.group_parts.len()
    if trace_stages:
        print "[layout-trace] bucket_stage=count-start rules={rule_count}"
    while cr < rule_count:  # cpu-lane-loop-ok: capacity-count pass over the extracted rules to size the bucket arrays; bound is the rule count, once per style invalidation
        bucket_capacity = bucket_capacity + rules.group_parts[cr].len()
        cr = cr + 1
    if trace_stages:
        print "[layout-trace] bucket_stage=count-ready capacity={bucket_capacity}"
    var id_keys_raw: [text] = [""; bucket_capacity]
    var id_counts_raw: [i32] = [0; bucket_capacity]
    var id_key_count = 0
    var class_keys_raw: [text] = [""; bucket_capacity]
    var class_counts_raw: [i32] = [0; bucket_capacity]
    var class_key_count = 0
    var tag_keys_raw: [text] = [""; bucket_capacity]
    var tag_counts_raw: [i32] = [0; bucket_capacity]
    var tag_key_count = 0
    var entry_kinds: [i32] = [0; bucket_capacity]
    var entry_buckets: [i32] = [0; bucket_capacity]
    var entry_rules: [i32] = [0; bucket_capacity]
    var entry_count = 0
    var fallback_count = 0
    var id_key_dict: Dict<text, i32> = {}
    var class_key_dict: Dict<text, i32> = {}
    var tag_key_dict: Dict<text, i32> = {}
    if trace_stages:
        print "[layout-trace] bucket_stage=storage-ready"
    var r = 0
    while r < rule_count:  # cpu-lane-loop-ok: bucket-build pass over the extracted rules; bound is the rule count, once per style invalidation
        val groups = rules.group_parts[r]
        var g = 0
        val group_count = groups.len()
        if trace_stages:
            print "[layout-trace] bucket_stage=rule-start rule={r} groups={group_count}"
        while g < group_count:  # cpu-lane-loop-ok: walks the selector comma-groups of ONE rule (<=CSS_SELECTOR_GROUP_CAP), assigning each to its id/class/tag bucket
            val right = selector_rightmost_part(groups[g])
            val base = selector_bucket_base(right)
            val kind = selector_bucket_kind_from_base(base)
            val key = selector_bucket_value_from_base(base)
            if kind == "id" and key.len() > 0:
                var idx = dict_key_index_count(id_key_dict, id_keys_raw, key, id_key_count)
                if idx < 0:
                    idx = id_key_count
                    id_keys_raw[idx] = key
                    id_key_count = id_key_count + 1
                    id_key_dict[key] = idx
                id_counts_raw[idx] = id_counts_raw[idx] + 1
                entry_kinds[entry_count] = 1
                entry_buckets[entry_count] = idx
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
            elif kind == "class" and key.len() > 0:
                var idx = dict_key_index_count(class_key_dict, class_keys_raw, key, class_key_count)
                if idx < 0:
                    idx = class_key_count
                    class_keys_raw[idx] = key
                    class_key_count = class_key_count + 1
                    class_key_dict[key] = idx
                class_counts_raw[idx] = class_counts_raw[idx] + 1
                entry_kinds[entry_count] = 2
                entry_buckets[entry_count] = idx
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
            elif kind == "tag" and key.len() > 0:
                var idx = dict_key_index_count(tag_key_dict, tag_keys_raw, key, tag_key_count)
                if idx < 0:
                    idx = tag_key_count
                    tag_keys_raw[idx] = key
                    tag_key_count = tag_key_count + 1
                    tag_key_dict[key] = idx
                tag_counts_raw[idx] = tag_counts_raw[idx] + 1
                entry_kinds[entry_count] = 3
                entry_buckets[entry_count] = idx
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
            else:
                entry_kinds[entry_count] = 4
                entry_buckets[entry_count] = fallback_count
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
                fallback_count = fallback_count + 1
            g = g + 1
        r = r + 1
    val id_keys = text_list_prefix(id_keys_raw, id_key_count)
    val id_counts = i32_list_prefix(id_counts_raw, id_key_count)
    val class_keys = text_list_prefix(class_keys_raw, class_key_count)
    val class_counts = i32_list_prefix(class_counts_raw, class_key_count)
    val tag_keys = text_list_prefix(tag_keys_raw, tag_key_count)
    val tag_counts = i32_list_prefix(tag_counts_raw, tag_key_count)
    var id_rules = rule_lists_from_counts(id_counts)
    var id_positions: [i32] = [0; id_counts.len()]
    var class_rules = rule_lists_from_counts(class_counts)
    var class_positions: [i32] = [0; class_counts.len()]
    var tag_rules = rule_lists_from_counts(tag_counts)
    var tag_positions: [i32] = [0; tag_counts.len()]
    var fallback_rules: [i32] = [0; fallback_count]
    var entry_i = 0
    while entry_i < entry_count:  # cpu-lane-loop-ok: fill pass scattering each recorded bucket entry into its preallocated bucket slot; bound is the entry count
        val entry_kind = entry_kinds[entry_i]
        val bucket_idx = entry_buckets[entry_i]
        val rule_idx = entry_rules[entry_i]
        if entry_kind == 1:
            var bucket = id_rules[bucket_idx]
            bucket[id_positions[bucket_idx]] = rule_idx
            id_rules[bucket_idx] = bucket
            id_positions[bucket_idx] = id_positions[bucket_idx] + 1
        elif entry_kind == 2:
            var bucket = class_rules[bucket_idx]
            bucket[class_positions[bucket_idx]] = rule_idx
            class_rules[bucket_idx] = bucket
            class_positions[bucket_idx] = class_positions[bucket_idx] + 1
        elif entry_kind == 3:
            var bucket = tag_rules[bucket_idx]
            bucket[tag_positions[bucket_idx]] = rule_idx
            tag_rules[bucket_idx] = bucket
            tag_positions[bucket_idx] = tag_positions[bucket_idx] + 1
        else:
            fallback_rules[bucket_idx] = rule_idx
        entry_i = entry_i + 1
    RuleBuckets(id_keys: id_keys, id_rules: id_rules, class_keys: class_keys, class_rules: class_rules, tag_keys: tag_keys, tag_rules: tag_rules, fallback_rules: fallback_rules, id_key_dict: id_key_dict, class_key_dict: class_key_dict, tag_key_dict: tag_key_dict)

fn dict_key_index(d: Dict<text, i32>, keys: [text], key: text) -> i32:
    dict_key_index_count(d, keys, key, keys.len() as i32)

fn style_rule_candidates(node: HNode, buckets: RuleBuckets) -> [i32]:
    val class_count = node.class_words.len()
    if class_count == 0 and node.id_attr.len() == 0:
        val tag_idx = dict_key_index(buckets.tag_key_dict, buckets.tag_keys, node.tag)
        if tag_idx < 0:
            return buckets.fallback_rules
        return merge_two_sorted_rule_lists_unique(buckets.fallback_rules, buckets.tag_rules[tag_idx])
    var lists: [[i32]] = [[]; class_count + 3]
    var list_count = 0
    lists[list_count] = buckets.fallback_rules
    list_count = list_count + 1
    if node.id_attr.len() > 0:
        val id_idx = dict_key_index(buckets.id_key_dict, buckets.id_keys, node.id_attr)
        if id_idx >= 0:
            lists[list_count] = buckets.id_rules[id_idx]
            list_count = list_count + 1
    val tag_idx = dict_key_index(buckets.tag_key_dict, buckets.tag_keys, node.tag)
    if tag_idx >= 0:
        lists[list_count] = buckets.tag_rules[tag_idx]
        list_count = list_count + 1
    var i = 0
    while i < class_count:  # cpu-lane-loop-ok: walks ONE node's class words to collect that node's class buckets; bound is that node's class count
        val cls = node.class_words[i]
        if cls.len() > 0:
            if class_count <= 1 or not text_seen_before(node.class_words, i, cls):
                val class_idx = dict_key_index(buckets.class_key_dict, buckets.class_keys, cls)
                if class_idx >= 0:
                    lists[list_count] = buckets.class_rules[class_idx]
                    list_count = list_count + 1
        i = i + 1
    merge_sorted_rule_lists_unique_count(lists, list_count)

fn selector_group_matches_node_parts(nodes: [HNode], ctx: SelectorContext, idx: i32, parts: [text]) -> bool:
    var right = parts.len() - 1
    while right >= 0 and parts[right] == "":  # cpu-lane-loop-ok: skips trailing empty parts of ONE selector group; bound is that group's part count
        right = right - 1
    if right < 0:
        return false
    val nd = nodes[idx]
    # Use full-context match for the rightmost part (the target element) so that
    # position-based pseudos (:first-child, :last-child, :nth-child, :empty, :has, etc.)
    # are evaluated against the real node tree.
    if not simple_match_ctx(parts[right], nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, nodes, ctx, idx):
        return false
    var ancestor = nd.parent
    var want = right - 1
    var require_direct = false
    while want >= 0:  # cpu-lane-loop-ok: walks ONE selector group's parts right-to-left matching ancestors; bound is that group's part count (<=256)
        val part = parts[want]
        if part.len() == 0:
            want = want - 1
        elif part == ">":
            require_direct = true
            want = want - 1
        else:
            if require_direct:
                if ancestor < 0:
                    return false
                val anc = nodes[ancestor]
                if simple_match(part, anc.tag, anc.class_attr, anc.class_words, anc.id_attr, anc.attrs_raw):
                    ancestor = anc.parent
                    require_direct = false
                else:
                    return false
            else:
                var found = false
                while ancestor >= 0 and not found:  # cpu-lane-loop-ok: descendant-combinator ancestor walk up the parent chain of one node; bound is that node's tree depth
                    val anc = nodes[ancestor]
                    if simple_match(part, anc.tag, anc.class_attr, anc.class_words, anc.id_attr, anc.attrs_raw):
                        found = true
                    else:
                        ancestor = anc.parent
                if not found:
                    return false
                ancestor = nodes[ancestor].parent
            want = want - 1
    not require_direct

# ---------------------------------------------------------------------------
# CSS specificity helpers
# ---------------------------------------------------------------------------

fn _part_specificity(
    part: text, recursion_depth: i32 = 0
) -> i32:
    if recursion_depth > 32:
        return -1000000
    var base = part
    val colon = text_index_of(base, ":")
    var pseudo_specificity = 0
    if colon >= 0:
        base = base.substring(0, colon)
        var pseudo_pos = colon
        var pseudo_count = 0
        while pseudo_pos < part.len():  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector part while scoring specificity; pseudo_count capped at 32
            pseudo_count = pseudo_count + 1
            if pseudo_count > 32 or part[pseudo_pos:pseudo_pos + 1] != ":":
                return -1000000
            val name_start = pseudo_pos + 1
            var name_end = name_start
            # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
            while (
                name_end < part.len() and
                part[name_end:name_end + 1] != ":" and
                part[name_end:name_end + 1] != "(" and
                part[name_end:name_end + 1] != "["
            ):
                name_end = name_end + 1
            val pseudo_name = part.substring(name_start, name_end)
            if pseudo_name.len() == 0:
                return -1000000
            if name_end < part.len() and part[name_end:name_end + 1] == "(":
                var functional_depth = 1
                var close = name_end + 1
                while close < part.len() and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo-class argument while scoring specificity; paren depth capped at 32
                    val ch = part[close:close + 1]
                    if ch == "(":
                        functional_depth = functional_depth + 1
                        if functional_depth > 32:
                            return -1000000
                    elif ch == ")":
                        functional_depth = functional_depth - 1
                    close = close + 1
                if functional_depth != 0:
                    return -1000000
                val inner = part.substring(name_end + 1, close - 1)
                if (
                    pseudo_name == "is" or pseudo_name == "not" or
                    pseudo_name == "has"
                ):
                    val options = split_selector_groups(inner)
                    if options.len() == 0:
                        return -1000000
                    var max_option_specificity = 0
                    for option in options:  # cpu-lane-loop-ok: walks the parsed :is()/:not()/:has() options taking the max option specificity; bound is CSS_SELECTOR_GROUP_CAP (16) options
                        val option_specificity = _group_specificity(
                            selector_group_parts(option),
                            recursion_depth + 1
                        )
                        if option_specificity < 0:
                            return -1000000
                        if option_specificity > max_option_specificity:
                            max_option_specificity = option_specificity
                    pseudo_specificity = (
                        pseudo_specificity + max_option_specificity
                    )
                elif pseudo_name == "nth-child":
                    pseudo_specificity = pseudo_specificity + 10
                elif pseudo_name != "where":
                    return -1000000
                pseudo_pos = close
            else:
                pseudo_specificity = pseudo_specificity + 10
                pseudo_pos = name_end
                if (
                    pseudo_name == "root" and pseudo_pos < part.len() and
                    part[pseudo_pos:pseudo_pos + 1] == "["
                ):
                    val attr_close = find_from(
                        part, "]", pseudo_pos + 1
                    )
                    if attr_close < 0:
                        return -1000000
                    pseudo_specificity = pseudo_specificity + 10
                    pseudo_pos = attr_close + 1
    var attribute_specificity = 0
    var attribute_scan = 0
    while attribute_scan < base.len():  # cpu-lane-loop-ok: counts the `[attr]` selectors in ONE selector base via native find_from; bound is that base's length
        val attribute_open = find_from(base, "[", attribute_scan)
        if attribute_open < 0:
            break
        attribute_specificity = attribute_specificity + 10
        val attribute_close = find_from(base, "]", attribute_open + 1)
        if attribute_close < 0:
            break
        attribute_scan = attribute_close + 1
    val attr_bracket = text_index_of(base, "[")
    if attr_bracket >= 0:
        base = base.substring(0, attr_bracket).trim()
    var base_specificity = attribute_specificity
    if base.len() == 0 or base == "*":
        base_specificity = attribute_specificity
    elif base[0:0 + 1] == "#":
        val dot = find_from(base, ".", 1)
        if dot >= 0:
            base_specificity = 110 + attribute_specificity
        else:
            base_specificity = 100 + attribute_specificity
    elif base[0:0 + 1] == ".":
        var class_count = 1
        var i = 1
        val base_len = base.len()
        while i < base_len:  # cpu-lane-loop-ok: counts the `.` class separators in one `.a.b` compound base; bound is that base's length
            if base[i:i + 1] == ".":
                class_count = class_count + 1
            i = i + 1
        base_specificity = class_count * 10 + attribute_specificity
    elif text_index_of(base, "#") > 0:
        val hash = text_index_of(base, "#")
        val dot = find_from(base, ".", hash + 1)
        if dot >= 0:
            base_specificity = 111 + attribute_specificity
        else:
            base_specificity = 101 + attribute_specificity
    elif text_index_of(base, ".") >= 0:
        val dot = text_index_of(base, ".")
        var class_count2 = 1
        var j = dot + 1
        val base_len2 = base.len()
        while j < base_len2:  # cpu-lane-loop-ok: counts the `.` class separators after the first dot in one `tag.a.b` compound base; bound is that base's length
            if base[j:j + 1] == ".":
                class_count2 = class_count2 + 1
            j = j + 1
        base_specificity = 1 + class_count2 * 10 + attribute_specificity
    else:
        base_specificity = 1 + attribute_specificity
    base_specificity + pseudo_specificity

fn _group_specificity(
    parts: [text], recursion_depth: i32 = 0
) -> i32:
    if recursion_depth > 32:
        return -1000000
    var total = 0
    var i = 0
    val part_count = parts.len()
    while i < part_count:  # cpu-lane-loop-ok: sums per-part specificity over ONE selector group's parts; bound is that group's part count. Computed once at extract time and cached in Rules.group_specificities, never recomputed per node
        val p = parts[i]
        if p.len() > 0 and p != ">":
            val part_specificity = _part_specificity(
                p, recursion_depth
            )
            if part_specificity < 0:
                return -1000000
            total = total + part_specificity
        i = i + 1
    total

fn _candidate_sort_before(left: i32, right: i32, rule_specificities: [i32]) -> bool:
    val left_spec = rule_specificities[left]
    val right_spec = rule_specificities[right]
    if left_spec < right_spec:
        return true
    if left_spec > right_spec:
        return false
    left <= right

fn _sort_candidates_by_specificity(candidates: [i32], rule_specificities: [i32]) -> [i32]:
    val n = candidates.len()
    if n <= 1:
        return candidates
    var src: [i32] = [0; n]
    var dest: [i32] = [0; n]
    var i = 0
    while i < n:  # cpu-lane-loop-ok: copy-in arm of the bottom-up merge sort of ONE node's candidate rule ids; bound is that node's candidate count; runs once per style invalidation
        src[i] = candidates[i]
        i = i + 1
    var width = 1
    while width < n:  # cpu-lane-loop-ok: width-doubling arm (log n iterations) of the candidate-specificity merge sort
        var start = 0
        while start < n:  # cpu-lane-loop-ok: run-start arm of the candidate-specificity merge sort: one iteration per run pair at the current width
            var mid = start + width
            if mid > n:
                mid = n
            var endv = start + width + width
            if endv > n:
                endv = n
            var left_i = start
            var right_i = mid
            var out_i = start
            while left_i < mid and right_i < endv:  # cpu-lane-loop-ok: merge arm of the candidate-specificity merge sort: emits the smaller head while both runs still have elements
                if _candidate_sort_before(src[left_i], src[right_i], rule_specificities):
                    dest[out_i] = src[left_i]
                    left_i = left_i + 1
                else:
                    dest[out_i] = src[right_i]
                    right_i = right_i + 1
                out_i = out_i + 1
            while left_i < mid:  # cpu-lane-loop-ok: left-drain arm of the candidate-specificity merge sort
                dest[out_i] = src[left_i]
                left_i = left_i + 1
                out_i = out_i + 1
            while right_i < endv:  # cpu-lane-loop-ok: right-drain arm of the candidate-specificity merge sort
                dest[out_i] = src[right_i]
                right_i = right_i + 1
                out_i = out_i + 1
            start = start + width + width
        i = 0
        while i < n:  # cpu-lane-loop-ok: copy-back arm of the candidate-specificity merge sort, returning dest to src for the next width
            src[i] = dest[i]
            i = i + 1
        width = width + width
    src

fn _z_index_sort_before(left: i32, right: i32, styles: [Style]) -> bool:
    val left_z = styles[left].z_index
    val right_z = styles[right].z_index
    if left_z < right_z:
        return true
    if left_z > right_z:
        return false
    left <= right

fn _sort_positive_z_indices(indices: [i32], count: i32, styles: [Style]) -> [i32]:
    if count <= 0:
        return []
    var src: [i32] = [0; count]
    var dest: [i32] = [0; count]
    var i = 0
    while i < count:  # cpu-lane-loop-ok: copy-in arm of the bottom-up merge sort of one stacking context's positive z-index children; bound is that context's positive-z child count
        src[i] = indices[i]
        i = i + 1
    var width = 1
    while width < count:  # cpu-lane-loop-ok: width-doubling arm (log n iterations) of the positive z-index merge sort
        var start = 0
        while start < count:  # cpu-lane-loop-ok: run-start arm of the positive z-index merge sort: one iteration per run pair at the current width
            var mid = start + width
            if mid > count:
                mid = count
            var endv = start + width + width
            if endv > count:
                endv = count
            var left_i = start
            var right_i = mid
            var out_i = start
            while left_i < mid and right_i < endv:  # cpu-lane-loop-ok: merge arm of the positive z-index merge sort: emits the smaller head while both runs still have elements
                if _z_index_sort_before(src[left_i], src[right_i], styles):
                    dest[out_i] = src[left_i]
                    left_i = left_i + 1
                else:
                    dest[out_i] = src[right_i]
                    right_i = right_i + 1
                out_i = out_i + 1
            while left_i < mid:  # cpu-lane-loop-ok: left-drain arm of the positive z-index merge sort
                dest[out_i] = src[left_i]
                left_i = left_i + 1
                out_i = out_i + 1
            while right_i < endv:  # cpu-lane-loop-ok: right-drain arm of the positive z-index merge sort
                dest[out_i] = src[right_i]
                right_i = right_i + 1
                out_i = out_i + 1
            start = start + width + width
        i = 0
        while i < count:  # cpu-lane-loop-ok: copy-back arm of the positive z-index merge sort, returning dest to src for the next width
            src[i] = dest[i]
            i = i + 1
        width = width + width
    src

fn _style_order_sort_before(left: i32, right: i32, styles: [Style]) -> bool:
    val left_order = styles[left].order
    val right_order = styles[right].order
    if left_order < right_order:
        return true
    if left_order > right_order:
        return false
    left <= right

fn _sort_style_order_indices(indices: [i32], count: i32, styles: [Style]) -> [i32]:
    if count <= 0:
        return []
    var src: [i32] = [0; count]
    var dest: [i32] = [0; count]
    var i = 0
    while i < count:  # cpu-lane-loop-ok: copy-in arm of the bottom-up merge sort of one flex container's children by CSS `order`; bound is that container's child count
        src[i] = indices[i]
        i = i + 1
    var width = 1
    while width < count:  # cpu-lane-loop-ok: width-doubling arm (log n iterations) of the flex `order` merge sort
        var start = 0
        while start < count:  # cpu-lane-loop-ok: run-start arm of the flex `order` merge sort: one iteration per run pair at the current width
            var mid = start + width
            if mid > count:
                mid = count
            var endv = start + width + width
            if endv > count:
                endv = count
            var left_i = start
            var right_i = mid
            var out_i = start
            while left_i < mid and right_i < endv:  # cpu-lane-loop-ok: merge arm of the flex `order` merge sort: emits the smaller head while both runs still have elements
                if _style_order_sort_before(src[left_i], src[right_i], styles):
                    dest[out_i] = src[left_i]
                    left_i = left_i + 1
                else:
                    dest[out_i] = src[right_i]
                    right_i = right_i + 1
                out_i = out_i + 1
            while left_i < mid:  # cpu-lane-loop-ok: left-drain arm of the flex `order` merge sort
                dest[out_i] = src[left_i]
                left_i = left_i + 1
                out_i = out_i + 1
            while right_i < endv:  # cpu-lane-loop-ok: right-drain arm of the flex `order` merge sort
                dest[out_i] = src[right_i]
                right_i = right_i + 1
                out_i = out_i + 1
            start = start + width + width
        i = 0
        while i < count:  # cpu-lane-loop-ok: copy-back arm of the flex `order` merge sort, returning dest to src for the next width
            src[i] = dest[i]
            i = i + 1
        width = width + width
    src

# ---------------------------------------------------------------------------
# Presentational attributes (bgcolor/width/height/align -> CSS declarations)
# ---------------------------------------------------------------------------
# Map legacy HTML presentational attributes (bgcolor/width/height/align) to CSS
# declarations. Applied with lowest priority: after tag defaults but before
# matched CSS rules and inline style.
fn presentational_attr_decls(node: HNode) -> text:
    if node.attrs_raw.len() == 0:
        return ""
    var out = ""
    val hidden_value = attr_value(node.attrs_raw, "hidden").trim().lower()
    if attr_present(node.attrs_raw, "hidden") and hidden_value != "until-found":
        out = out + "display:none;"
    var bg = attr_value_by_key(node.attrs_raw, "bgcolor=").trim()
    if bg.len() == 6 and not bg.starts_with("#"):
        bg = "#" + bg
    if bg.len() > 0:
        out = out + "background-color:" + bg + ";"
    val w = attr_value_by_key(node.attrs_raw, "width=").trim()
    if w.len() > 0:
        if w.ends_with("%"):
            out = out + "width:" + w + ";"
        elif parse_int(w) > 0:
            out = out + "width:" + parse_int(w).to_text() + "px;"
    val h = attr_value_by_key(node.attrs_raw, "height=").trim()
    if h.len() > 0:
        if h.ends_with("%"):
            out = out + "height:" + h + ";"
        elif parse_int(h) > 0:
            out = out + "height:" + parse_int(h).to_text() + "px;"
    val align = attr_value_by_key(node.attrs_raw, "align=").trim().lower()
    if align == "center" or align == "left" or align == "right":
        out = out + "text-align:" + align + ";"
    out

# ---------------------------------------------------------------------------
# Compute styles (cascade: inherit -> tag defaults -> matched rules -> inline)
# ---------------------------------------------------------------------------

fn is_valid_selectedcontent_context(nodes: [HNode], child_index: HtmlChildIndex, node_index: i32) -> bool:
    val button_index = nodes[node_index].parent
    if button_index < 0 or nodes[button_index].tag != "button":
        return false
    val select_index = nodes[button_index].parent
    if select_index < 0 or nodes[select_index].tag != "select":
        return false
    if attr_present(nodes[select_index].attrs_raw, "multiple"):
        return false
    var first_element = child_index.first_child[select_index]
    while first_element >= 0 and nodes[first_element].tag == "#text":  # cpu-lane-loop-ok: skips the leading `#text` siblings to reach the first element child of ONE <select>; bound is that select's leading text-node run
        first_element = child_index.next_sibling[first_element]
    if first_element != button_index:
        return false
    child_index.first_child[button_index] == node_index

# Resolve disclosure visibility once for the flat preorder arena. A closed
# details exposes only its first direct summary; descendants inherit hiding.
fn _details_content_hidden(nodes: [HNode]) -> [bool]:
    val node_count = nodes.len()
    var first_summary: [i32] = [-1; node_count]
    var i = 0
    while i < node_count:  # cpu-lane-loop-ok: pass 1 over the flat preorder node arena recording each <details>' first <summary>; bound is the node count, once per style pass
        val parent = nodes[i].parent
        if (
            nodes[i].tag == "summary" and parent >= 0 and
            nodes[parent].tag == "details" and first_summary[parent] < 0
        ):
            first_summary[parent] = i
        i = i + 1
    var hidden: [bool] = [false; node_count]
    i = 0
    while i < node_count:  # cpu-lane-loop-ok: pass 2 over the same preorder arena propagating disclosure hiding parent-to-child; bound is the node count, once per style pass
        val parent = nodes[i].parent
        if parent >= 0:
            hidden[i] = hidden[parent]
            if (
                not hidden[i] and nodes[parent].tag == "details" and
                not attr_present(nodes[parent].attrs_raw, "open")
            ):
                # Bounded profile: do not synthesize the UA shadow summary.
                hidden[i] = (
                    first_summary[parent] < 0 or
                    first_summary[parent] != i
                )
        i = i + 1
    hidden

pub fn simple_web_enforce_details_visibility(
    nodes: [HNode], styles: [Style]
) -> [Style]:
    val hidden = _details_content_hidden(nodes)
    var resolved = styles
    var i = 0
    while i < resolved.len():  # cpu-lane-loop-ok: applies display:none to the structurally hidden nodes; bound is the style array length (node count), once per style pass
        if hidden[i]:
            resolved[i] = apply_decls(
                resolved[i], "display:none", resolved[i].font_size
            )
        i = i + 1
    resolved

fn _final_overflow_axis_in_decls(decls: text, axis: text) -> text:
    if decls == "":
        return ""
    val table = decl_table_build(decls)
    val shorthand_at = decl_tbl_last_index(table, "overflow")
    val axis_at = decl_tbl_last_index(table, axis)
    if axis_at > shorthand_at:
        return decl_tbl_get(table, axis).trim().lower()
    if shorthand_at >= 0:
        val raw = decl_tbl_get(table, "overflow").trim().lower()
        var parts: [text] = []
        for part in raw.split(" "):  # cpu-lane-loop-ok: detector false positive: iterates the tokens of ONE `overflow` shorthand value, which CSS defines as 1 or 2 tokens
            if part != "":
                parts.push(part)
        if parts.len() >= 2:
            if axis == "overflow-x":
                return parts[0]
            return parts[1]
        return raw
    ""

fn _final_overflow_axis(
    normal: text, inline_normal: text, important: text,
    inline_important: text, axis: text
) -> text:
    val inline_important_value = _final_overflow_axis_in_decls(
        inline_important, axis
    )
    if inline_important_value != "":
        return inline_important_value
    val important_value = _final_overflow_axis_in_decls(important, axis)
    if important_value != "":
        return important_value
    val inline_value = _final_overflow_axis_in_decls(inline_normal, axis)
    if inline_value != "":
        return inline_value
    _final_overflow_axis_in_decls(normal, axis)

fn _scrollbar_width_in_decls(decls: text) -> text:
    if decls == "":
        return ""
    decl_tbl_get(decl_table_build(decls), "scrollbar-width").trim().lower()

fn _display_value_in_decls(decls: text) -> text:
    if decls == "" or _decl_over_quota(decls):
        return ""
    decl_tbl_get_last_cascading_display(decl_table_build(decls))

fn _final_authored_display(
    ua_display: text, inherited_display: text, normal: text, inline_normal: text,
    important: text,
    inline_important: text
) -> text:
    var value = ""
    val normal_value = _display_value_in_decls(normal)
    if normal_value != "":
        value = normal_value
    val inline_value = _display_value_in_decls(inline_normal)
    if inline_value != "":
        value = inline_value
    val important_value = _display_value_in_decls(important)
    if important_value != "":
        value = important_value
    val inline_important_value = _display_value_in_decls(inline_important)
    if inline_important_value != "":
        value = inline_important_value
    if value == "":
        return ""
    if value == "initial" or value == "unset":
        return "inline"
    if value == "inherit":
        return inherited_display
    if value == "revert":
        return ua_display
    value

fn _normalize_final_overflow_axes(
    st: Style, normal: text, inline_normal: text, important: text,
    inline_important: text
) -> Style:
    val x_raw = _final_overflow_axis(
        normal, inline_normal, important, inline_important, "overflow-x"
    )
    val y_raw = _final_overflow_axis(
        normal, inline_normal, important, inline_important, "overflow-y"
    )
    val x = if x_raw == "": "visible" else: x_raw
    val y = if y_raw == "": "visible" else: y_raw
    var scrollbar_width = _scrollbar_width_in_decls(normal)
    val inline_width = _scrollbar_width_in_decls(inline_normal)
    if inline_width != "":
        scrollbar_width = inline_width
    val important_width = _scrollbar_width_in_decls(important)
    if important_width != "":
        scrollbar_width = important_width
    val inline_important_width = _scrollbar_width_in_decls(inline_important)
    if inline_important_width != "":
        scrollbar_width = inline_important_width
    var normalized = st
    if scrollbar_width != "":
        normalized.scrollbar_width_none = scrollbar_width == "none"
    # CSS computes a visible axis to auto when the other axis is non-visible.
    # Do this after all cascade origins so split rules cannot leak overflow.
    if (
        (x == "hidden" or x == "auto" or x == "scroll") and
        y == "visible"
    ):
        normalized.overflow_auto_y = true
        normalized.overflow_scroll_y = false
    normalized

fn compute_styles(nodes: [HNode], rules: Rules, child_index: HtmlChildIndex, trace_stages: bool = false, vector_fonts: bool = true) -> [Style]:
    var material_entries_unused: [text] = ["", ""]
    var material_counts_unused: [i64] = [0, 0]
    var cpu_material_nodes_unused: [i32] = []
    var solid_material_nodes_unused: [i32] = []
    compute_styles_with_material(
        nodes, rules, child_index, trace_stages, vector_fonts,
        material_entries_unused, material_counts_unused,
        cpu_material_nodes_unused, solid_material_nodes_unused)

# Freestanding-safe material provenance channel: the realized solid-material
# entries are built HERE from the loop-local style (before any aggregate
# element store, array return, or array param crossing — all of which lose
# Style field contents on the freestanding lane) and handed out through a
# mutable text/count slots (the apply_advances idiom). Consumers derive the
# material digest from these canonical entries instead of re-reading [Style].
fn compute_styles_with_material(nodes: [HNode], rules: Rules, child_index: HtmlChildIndex, trace_stages: bool, vector_fonts: bool, mut material_entries: [text], mut material_counts: [i64], mut cpu_material_nodes: [i32], mut solid_material_nodes: [i32]) -> [Style]:
    var cpu_material_entry_count: i64 = 0
    var solid_material_entry_count: i64 = 0
    val material_channel_ready = (
        material_entries.len() >= 2 and material_counts.len() >= 2)
    if material_channel_ready:
        material_entries[0] = "simple-web-realized-cpu-composited-material-v1"
        material_entries[1] = "simple-web-realized-solid-material-v1"
        material_counts[0] = 0
        material_counts[1] = 0
    val rule_buckets = build_rule_buckets(rules, trace_stages)
    if trace_stages:
        print "[layout-trace] style_stage=rule-buckets-ready"
    val selector_ctx = build_selector_context(nodes, child_index)
    if trace_stages:
        print "[layout-trace] style_stage=selector-context-ready"
    var rule_specificities: [i32] = [-1; rules.group_parts.len()]
    if trace_stages:
        print "[layout-trace] style_stage=rule-specificities-ready"
    val node_count = nodes.len()
    val details_hidden = _details_content_hidden(nodes)
    var styles: [Style] = [renderer_default_style(); node_count]
    if trace_stages:
        print "[layout-trace] style_stage=defaults-ready nodes={node_count}"
    val _phase_on = _web_phase_trace_enabled()
    # Hoisted trace gate. The [font-inherit-trace] probes below are level-gated
    # and default off, but the GATE ITSELF used to be an env_get() evaluated at
    # each of its 7 call sites INSIDE the per-node loop -- i.e. up to 7 env
    # lookups per node per style pass, paid in full even with tracing off, and
    # paid on every frame because the non-session render API re-runs the whole
    # cascade per call. An env var cannot change mid-render, so reading it once
    # here is semantics-preserving. The probes themselves are untouched and stay
    # permanently available, per the log-retention policy; only the cost of
    # asking whether they are on moves out of the loop. Mirrors _phase_on above.
    val _font_style_trace_on = env_get("SIMPLE_TRACE_FONT_STYLE") != nil
    val _phase_clock = default_frame_clock()
    val _phase_loop_start_us = _phase_clock.now_micros()
    var i = 0
    while i < node_count:  # cpu-lane-loop-ok: THE per-node cascade loop; bound is the document node count and it runs once per style invalidation, not per paint frame (simple_web_layout_rerender_retained gates compute_styles_with_material behind dirty_stage == "css" and reuses prior styles on paint-only frames)
        # Budget guard (outer): stop resolving further nodes on expiry; nodes not
        # yet reached keep their renderer_default_style() so the array stays valid.
        if _web_budget_expired():
            print "[web-style-producer] budget-break at={i} of={node_count} {web_budget_now_and_deadline()}"
            break
        # Periodic progress (every 10 nodes), level-gated: on a long run,
        # budget-break was the ONLY progress line this loop ever emitted --
        # silent for the whole run if the budget never expires. This makes a
        # long-running style pass observable instead of indistinguishable
        # from a hang.
        if _phase_on and (i % 10) == 0:
            print "[web-phase] style_progress i={i} of={node_count} elapsed_ms={(_phase_clock.now_micros() - _phase_loop_start_us) / 1000}"
        val nd = nodes[i]
        if trace_stages:
            print "[layout-trace] style_stage=node-start index={i} parent={nd.parent} tag={nd.tag}"
        # Level-gated (default off, permanent per log-retention policy):
        # pins whether the parent's OWN cascade-resolved font_family/
        # font_size (i.e. its inline `style=` was applied to ITS style
        # entry) and whether inherit_from() actually copies them onto the
        # child, independent of trace_stages (which every real caller
        # hardwires false). See doc/08_tracking/bug/
        # jit_run_file_pipeline_gaps_2026-07-30.md section 16.
        if _font_style_trace_on:
            val style_attr_len: i64 = nd.style_attr.len()
            val style_attr_has_bungee: bool = nd.style_attr.contains("Bungee")
            val raw_style_attr: text = attr_value(nd.attrs_raw, "style")
            val raw_style_attr_len: i64 = raw_style_attr.len()
            if raw_style_attr_len > 0:
                print "[font-inherit-trace] index={i} tag={nd.tag} parent={nd.parent} style_attr_len={style_attr_len} style_attr_has_bungee={style_attr_has_bungee} raw_attrs_style_len={raw_style_attr_len}"
        var st = renderer_default_style()
        val inherited_display = if nd.parent >= 0:
            styles[nd.parent].display
        else:
            "block"
        if nd.parent >= 0:
            val parent_style = styles[nd.parent]
            if trace_stages:
                print "[layout-trace] style_stage=parent-loaded index={i}"
                print "[layout-trace] style_stage=parent-display index={i} display={parent_style.display}"
                print "[layout-trace] style_stage=parent-font index={i} size={parent_style.font_size} family={parent_style.font_family}"
            if _font_style_trace_on:
                print "[font-inherit-trace] index={i} parent_font_family={parent_style.font_family} parent_font_size={parent_style.font_size}"
            st.inherit_from(parent_style)
            if trace_stages:
                print "[layout-trace] style_stage=inherit-returned index={i} display={st.display} font={st.font_family}"
            if _font_style_trace_on:
                print "[font-inherit-trace] index={i} post_inherit_font_family={st.font_family} post_inherit_font_size={st.font_size}"
        # em/% font-size resolve against the inherited (parent) font-size, not the
        # UA-default set by tag_defaults (so h1{font-size:1.5em} == 1.5 x parent).
        val em_base = if nd.parent >= 0: styles[nd.parent].font_size else: 16
        if trace_stages:
            print "[layout-trace] style_stage=em-base-ready index={i} em={em_base}"
        st = tag_defaults(st, nd.tag)
        val ua_display = st.display
        if trace_stages:
            print "[layout-trace] style_stage=tag-defaults-ready index={i} display={st.display}"
            print "[layout-trace] style_stage=attrs-ready index={i} attrs_len={nd.attrs_raw.len()}"
        val pres_decls = presentational_attr_decls(nd)
        if trace_stages:
            print "[layout-trace] style_stage=presentational-ready index={i} decls_len={pres_decls.len()}"
        if pres_decls.len() > 0:
            st = apply_decls(st, pres_decls, em_base)
        var empty_cells_hide = false
        if trace_stages:
            print "[layout-trace] style_stage=selector-inputs index={i} class_attr={nd.class_attr} classes={nd.class_words.len()} id_len={nd.id_attr.len()}"
        # A text node is NOT an element: no author selector matches it, not
        # even the universal `*`. Its computed values are exactly the parent
        # element's inherited values (CSS 2.1 6.2 / css-cascade-4 6.4).
        # Matching author rules against the `#text` pseudo-node let a rule
        # like `*{font-size:16px}` clobber the font-size the text had just
        # inherited from its parent's inline `style="font-size:24px"`, which
        # made every text advance font-size-INVARIANT: the metrics resolved
        # (correctly, from real hmtx advances) at the wrong size, so a 16px
        # and a 24px box broke at the same character
        # (tools/layout_diff fixture 14_font_size_wrap).
        val candidates_raw: [i32] = if nd.tag == "#text":
            []
        else:
            style_rule_candidates(nd, rule_buckets)
        if trace_stages:
            print "[layout-trace] style_stage=candidates-ready index={i} count={candidates_raw.len()}"
        var specificity_i = 0
        var selector_group_budget_count = 0
        while specificity_i < candidates_raw.len():  # cpu-lane-loop-ok: walks the bucketed candidate rules of ONE node computing each rule's matched specificity; bound is that node's candidate count, not the full rule set
            val specificity_rule = candidates_raw[specificity_i]
            val specificity_groups = rules.group_parts[specificity_rule]
            val precomputed_specificities = rules.group_specificities[specificity_rule]
            var matched_specificity = -1
            var group_i = 0
            var specificity_expired = false
            while group_i < specificity_groups.len():  # cpu-lane-loop-ok: walks the selector comma-groups of one candidate rule (<=CSS_SELECTOR_GROUP_CAP) running the actual selector match; budget-sampled every 256 groups
                if (selector_group_budget_count & 255) == 0 and _web_budget_expired():
                    specificity_expired = true
                    break
                if selector_group_matches_node_parts(
                    nodes, selector_ctx, i, specificity_groups[group_i]
                ):
                    val group_specificity = precomputed_specificities[group_i]
                    if group_specificity > matched_specificity:
                        matched_specificity = group_specificity
                selector_group_budget_count = selector_group_budget_count + 1
                group_i = group_i + 1
            if specificity_expired:
                while specificity_i < candidates_raw.len():  # cpu-lane-loop-ok: budget-expiry drain arm: marks the not-yet-scored remainder of THIS node's candidate list unmatched (-1) so the cascade below skips them
                    rule_specificities[candidates_raw[specificity_i]] = -1
                    specificity_i = specificity_i + 1
                break
            rule_specificities[specificity_rule] = matched_specificity
            specificity_i = specificity_i + 1
        val candidates = _sort_candidates_by_specificity(candidates_raw, rule_specificities)
        if trace_stages:
            print "[layout-trace] style_stage=candidates-sorted index={i} count={candidates.len()}"
        var candidate_i = 0
        val candidate_count = candidates.len()
        var has_important_candidates = false
        # Perf: apply_decls unpacks/repacks the ~176-field Style struct and
        # probes ~283 known property names against the rule's small decl
        # table on EVERY call (see doc/08_tracking/bug/
        # web_style_producer_4s_per_node_interpreted_lane_2026-07-29.md,
        # "Cost center attribution" -- apply_decls is 70-90% of per-node
        # style-resolution wall time). Instead of calling it once per
        # candidate rule, accumulate every candidate's decls into one
        # string (in cascade order) and call it ONCE per node.
        # Behavior-preserving: decl_table_build()/decl_tbl_last_index()
        # already implement "last occurrence in the table wins" as the
        # tie-break for shorthand-vs-longhand and duplicate-property
        # ordering; string concatenation preserves relative source order
        # across rules exactly the way it already does within one rule's
        # decls, so the merged table's "last occurrence" is still the
        # correct cascade winner. The merged string is then trimmed back
        # under apply_decls' internal WEB_RULE_DECL_QUOTA (256) guard by
        # _merged_decls_within_quota: that guard is defined PER RULE, and a
        # node matching several rules that each individually stayed under
        # the cap can exceed it once merged -- which made the guard drop
        # this node's ENTIRE author cascade, including the rules that
        # legitimately passed. Trimming keeps the cascade winners.
        var combined_decls = ""
        while candidate_i < candidate_count:  # cpu-lane-loop-ok: walks ONE node's specificity-sorted candidate rules accumulating their normal decls into a single string, so apply_decls (the 70-90% per-node cost center) is called once per node instead of once per rule; budget-sampled every 256 candidates
            # Budget guard (inner): this is the apply_decls call site loop where a
            # single node can match thousands of rules (the hostile case). Sample
            # the clock so the legit large-theme path pays no per-rule clock cost.
            if (candidate_i & 255) == 0 and _web_budget_expired():
                break
            val r = candidates[candidate_i]
            # Rule quota: rules past the cap (CSS source order) are dropped so the
            # first, load-bearing rules keep winning without unbounded cascade work.
            if r >= WEB_STYLE_RULE_QUOTA:
                candidate_i = candidate_i + 1
                continue
            if rule_specificities[r] >= 0:
                val empty_cells_decl = decl_get(rules.decls[r], "empty-cells")
                if empty_cells_decl != "":
                    empty_cells_hide = (
                        empty_cells_decl.trim().lower() == "hide"
                    )
                if rules.decls[r] != "":
                    combined_decls = combined_decls + rules.decls[r] + ";"
                if rules.important_decls[r] != "":
                    has_important_candidates = true
            candidate_i = candidate_i + 1
        combined_decls = _merged_decls_within_quota(combined_decls)
        if trace_stages:
            print "[layout-trace] style_stage=inline-input index={i} len={nd.style_attr.len()}"
        var inline_normal = ""
        var inline_important = ""
        if nd.style_attr != "":
            val inline_priority = css_declaration_priority_split(nd.style_attr)
            inline_normal = inline_priority.normal
            inline_important = inline_priority.important
        if _font_style_trace_on and nd.style_attr.len() > 0:
            print "[font-inline-trace] index={i} raw_style_attr_len={nd.style_attr.len()} inline_normal_len={inline_normal.len()}"
        # Author-important declarations outrank every author-normal declaration,
        # including inline style. Within the important origin, retain the same
        # specificity/source order as the normal author cascade.
        var combined_important_decls = ""
        if has_important_candidates:
            candidate_i = 0
            while candidate_i < candidate_count:  # cpu-lane-loop-ok: second pass over the SAME node's candidate rules collecting author-!important decls; entered only when the first pass set has_important_candidates
                if (candidate_i & 255) == 0 and _web_budget_expired():
                    break
                val r = candidates[candidate_i]
                if r >= WEB_STYLE_RULE_QUOTA:
                    candidate_i = candidate_i + 1
                    continue
                if (
                    rule_specificities[r] >= 0 and
                    rules.important_decls[r] != ""
                ):
                    combined_important_decls = (
                        combined_important_decls + rules.important_decls[r] + ";"
                    )
                candidate_i = candidate_i + 1
            combined_important_decls = _merged_decls_within_quota(
                combined_important_decls
            )

        # Resolve the final inherited/normal/inline/important writing-mode once.
        # Every logical-size declaration then maps on that final axis even when
        # its own cascade phase ran before the winning writing-mode declaration.
        var logical_writing_mode = st.writing_mode
        logical_writing_mode = resolve_writing_mode_decls(
            logical_writing_mode, combined_decls
        )
        logical_writing_mode = resolve_writing_mode_decls(
            logical_writing_mode, inline_normal
        )
        logical_writing_mode = resolve_writing_mode_decls(
            logical_writing_mode, combined_important_decls
        )
        logical_writing_mode = resolve_writing_mode_decls(
            logical_writing_mode, inline_important
        )

        val final_display = _final_authored_display(
            ua_display, inherited_display, combined_decls, inline_normal,
            combined_important_decls, inline_important
        )

        if combined_decls != "":
            st = apply_decls_without_display_on_writing_mode(
                st, combined_decls, em_base, logical_writing_mode
            )
        if inline_normal != "":
            val inline_empty_cells_decl = decl_get(
                inline_normal, "empty-cells"
            )
            if inline_empty_cells_decl != "":
                empty_cells_hide = (
                    inline_empty_cells_decl.trim().lower() == "hide"
                )
            st = apply_decls_without_display_on_writing_mode(
                st, inline_normal, em_base, logical_writing_mode
            )
            if _font_style_trace_on:
                print "[font-inline-trace] index={i} post_inline_apply_font_family={st.font_family} post_inline_apply_font_size={st.font_size}"
        if combined_important_decls != "":
            val important_empty_cells_decl = decl_get(
                combined_important_decls, "empty-cells"
            )
            if important_empty_cells_decl != "":
                empty_cells_hide = (
                    important_empty_cells_decl.trim().lower() == "hide"
                )
            st = apply_decls_without_display_on_writing_mode(
                st, combined_important_decls, em_base, logical_writing_mode
            )
        if inline_important != "":
            val inline_important_empty_cells_decl = decl_get(
                inline_important, "empty-cells"
            )
            if inline_important_empty_cells_decl != "":
                empty_cells_hide = (
                    inline_important_empty_cells_decl.trim().lower() == "hide"
                )
            st = apply_decls_without_display_on_writing_mode(
                st, inline_important, em_base, logical_writing_mode
            )
        if final_display != "":
            if final_display == "contents":
                st = apply_decls(st, "display:" + final_display, em_base)
            else:
                st.display = final_display
        st = _normalize_final_overflow_axes(
            st, combined_decls, inline_normal, combined_important_decls,
            inline_important
        )
        # Disclosure state is structural and author CSS cannot reveal closed
        # content. Apply it after the author cascade and before layout/paint.
        if details_hidden[i]:
            st = apply_decls(st, "display:none", em_base)
        # The customizable-select projection is not implemented yet. In its
        # one valid context, keep selectedcontent inert even when author CSS
        # tries to display it; invalid-context uses retain generic semantics.
        if nd.tag == "selectedcontent" and is_valid_selectedcontent_context(nodes, child_index, i):
            st = apply_decls(st, "display:none", em_base)
        # The shared WM supplies the package's named solid material for the
        # legacy fallback mode. A producer may opt into the CPU-composited
        # material contract only with the exact mode value, preserving the
        # authored translucent background and backdrop declaration for W2.
        # Freestanding lane: method calls chained onto a function-call return
        # (attr_value(...).trim().lower()) misroute/corrupt on this backend —
        # the char_code_at().to_i32() defect class. Bind each hop to a typed
        # local so every dispatch has a held text receiver.
        val wm_fallback_attr: text = attr_value(nd.attrs_raw, "data-wm-theme-fallback")
        val wm_fallback_trimmed: text = wm_fallback_attr.trim()
        val wm_fallback: text = wm_fallback_trimmed.lower()
        if nd.attrs_raw.contains("data-wm-theme-fallback"):
            # Unconditional per-contract-node receipt (bounded: contract nodes
            # only): shows exactly which hop kills the value — attr extraction,
            # trim, lower, or the == comparison itself.
            val probe_raw_match = wm_fallback_attr == "solid-material"
            val probe_final_match = wm_fallback == "solid-material"
            print "[web-style-producer] contract-attr index={i} attrs_len={nd.attrs_raw.len()} raw_len={wm_fallback_attr.len()} trimmed_len={wm_fallback_trimmed.len()} lower_len={wm_fallback.len()} raw_match={probe_raw_match} final_match={probe_final_match}"
        val wm_material_mode: text = attr_value(
            nd.attrs_raw, "data-wm-theme-material-mode")
        # Bind every contract comparison ONCE, immediately after extraction.
        # Re-comparing these text locals ~120 lines later (after the font
        # resolver and style cascade calls) has been observed to flip on the
        # freestanding x86_64 lane: the same iteration printed
        # `contract-attr ... final_match=1` and then took NEITHER the admitted
        # nor the rejected branch, so the material witness silently stayed
        # "none" and the WM degraded every window
        # (content-provenance-rejected). Same defect class as the chained
        # attr_value(...).trim().lower() corruption documented above; the fix
        # idiom is the same — evaluate at extraction depth, carry booleans.
        val wm_fallback_is_solid: bool = wm_fallback == "solid-material"
        val wm_mode_is_cpu: bool =
            wm_material_mode == "engine2d-cpu-composited-material-v1"
        val wm_mode_is_empty: bool = wm_material_mode == ""
        if (
            wm_fallback_is_solid and not wm_mode_is_cpu
        ):
            val wm_bg_attr: text = attr_value(nd.attrs_raw, "data-wm-theme-bg")
            val wm_bg: text = wm_bg_attr.trim()
            val wm_fg_attr: text = attr_value(nd.attrs_raw, "data-wm-theme-fg")
            val wm_fg: text = wm_fg_attr.trim()
            var wm_fallback_decls = "backdrop-filter:none;-webkit-backdrop-filter:none;background-image:none;"
            if wm_bg.len() > 0:
                wm_fallback_decls = wm_fallback_decls + "background-color:" + wm_bg + ";"
            if wm_fg.len() > 0:
                wm_fallback_decls = wm_fallback_decls + "color:" + wm_fg + ";"
            st = apply_decls(st, wm_fallback_decls, em_base)
            # Producer-side provenance attribution (silent on healthy): the
            # material witness downstream reads these same fields through the
            # returned [Style] array. Keep this diagnostic inside the legacy
            # fallback branch; exact CPU mode is intentionally translucent.
            val wm_realized_bg: u32 = st.bg
            val wm_realized_gf: u32 = st.background_gradient_from
            val wm_realized_gt: u32 = st.background_gradient_to
            val wm_realized_layers: i64 = st.bg_layers_raw.len()
            if (
                ((wm_realized_bg >> 24) & 255u32) != 255u32 or
                wm_realized_gf != 0u32 or wm_realized_gt != 0u32 or
                wm_realized_layers != 0
            ):
                print "[web-style-producer] wm-contract-unrealized index={i} bg={wm_realized_bg} gradient_from={wm_realized_gf} gradient_to={wm_realized_gt} layers_len={wm_realized_layers} wm_bg_len={wm_bg.len()}"
        if trace_stages:
            print "[layout-trace] style_stage=inline-ready index={i}"
        if empty_cells_hide and (nd.tag == "td" or nd.tag == "th") and not selector_ctx.has_content_child[i]:
            st = apply_decls(st, "background-color:transparent;background-image:none", em_base)
        if vector_fonts and nd.tag == "#text":
            val metric_text = if st.white_space_nowrap: nd.text_data else: nd.text_trimmed
            if trace_stages:
                print "[layout-trace] style_stage=metric-text-ready index={i} len={metric_text.len()}"
            val language = _html_text_language(nodes, i, st)
            if trace_stages:
                print "[layout-trace] style_stage=metric-language-ready index={i} language={language}"
            # Level-gated (default off, permanent per log-retention policy):
            # dumps the exact font_family/font_size a #text node's computed
            # style carries into font resolution. Added to answer, for a
            # specific text node, whether an ancestor's inline style ever
            # reached it (cascade defect) vs reached it correctly and the
            # fault is downstream in category/coverage-matrix resolution --
            # see doc/08_tracking/bug/jit_run_file_pipeline_gaps_2026-07-30.md
            # section 16 (web showcase vector-font-evidence follow-on).
            if _font_style_trace_on:
                print "[font-style-trace] index={i} font_family={st.font_family} font_size={st.font_size} language={language} text={metric_text}"
            val metrics = resolve_font_metrics_with_language(st.font_family, metric_text, st.font_size, language)
            if trace_stages:
                print "[layout-trace] style_stage=metrics-ready index={i} valid={metrics.valid}"
            if metrics.valid:
                st.resolved_font_identity = metrics.identity
                st.resolved_font_advances = metrics.advances
                st.resolved_font_width = metrics.width
                st.resolved_font_line_height = metrics.line_height
        # Material receipts are built from loop-local fields before the
        # freestanding-unsafe [Style] store/return boundary.
        val mat_bg: u32 = st.bg
        val mat_fg: u32 = st.fg
        val mat_gf: u32 = st.background_gradient_from
        val mat_gt: u32 = st.background_gradient_to
        val mat_layers: text = st.bg_layers_raw
        val mat_backdrop: text = st.backdrop_filter_raw
        val declared_bg_attr = attr_value(
            nd.attrs_raw, "data-wm-theme-bg")
        val declared_argb = parse_color_any(declared_bg_attr)
        val declared_opaque = (
            declared_bg_attr != "" and
            ((declared_argb >> 24) & 255u32) == 255u32)
        val surface_alpha = (mat_bg >> 24) & 255u32
        val translucent_surface = (
            surface_alpha > 0u32 and surface_alpha < 255u32)
        val opaque_surface = surface_alpha == 255u32
        val typed_stops_absent = mat_gf == 0u32 and mat_gt == 0u32
        val typed_stops_present = mat_gf != 0u32 and mat_gt != 0u32
        val typed_stops_valid = typed_stops_absent or typed_stops_present
        val backdrop = simple_web_backdrop_admission(mat_backdrop)
        # A pre-animation receipt cannot describe the final frame. Animated
        # material nodes fail closed until the side channel becomes
        # animation-aware.
        val static_material = st.animation_name == "none"
        val cpu_admitted = (
            material_channel_ready and static_material and
            wm_mode_is_cpu and
            wm_fallback_is_solid and declared_opaque and
            translucent_surface and mat_layers == "" and
            typed_stops_valid and backdrop.admitted)
        if cpu_admitted:
            val realized = "blur({backdrop.realized_blur_px}px) saturate({backdrop.realized_saturation_milli / 10}%)"
            material_entries[0] = (
                material_entries[0] +
                "\n{cpu_material_entry_count}|kind=cpu-composited-material" +
                "|reason=native-device-backdrop-path-pending" +
                "|mode={wm_material_mode}|fallback={wm_fallback}" +
                "|declared={declared_argb}|surface={mat_bg}" +
                "|surface-alpha-milli={(surface_alpha as i64) * 1000 / 255}" +
                "|backdrop={mat_backdrop}|realized={realized}" +
                "|blur={backdrop.realized_blur_px}" +
                "|saturation={backdrop.realized_saturation_milli}" +
                "|stops={mat_gf},{mat_gt}")
            cpu_material_entry_count = cpu_material_entry_count + 1
            cpu_material_nodes.push(i)
        val solid_admitted = (
            material_channel_ready and static_material and
            wm_mode_is_empty and wm_fallback_is_solid and
            declared_opaque and opaque_surface and mat_backdrop == "" and
            mat_layers == "" and typed_stops_absent)
        if solid_admitted:
            material_entries[1] = (
                material_entries[1] +
                "\n{solid_material_entry_count}|kind=solid-material" +
                "|reason=cpu-raster-backdrop-sampling-unavailable" +
                "|bg={mat_bg}|fg={mat_fg}|backdrop=none" +
                "|background-image=none")
            solid_material_entry_count = solid_material_entry_count + 1
            solid_material_nodes.push(i)
        if (
            wm_fallback_is_solid and
            not cpu_admitted and not solid_admitted
        ):
            print "[web-style-producer] entry-rejected index={i} mode={wm_material_mode} bg={mat_bg} gf={mat_gf} gt={mat_gt} layers_len={mat_layers.len()} backdrop_len={mat_backdrop.len()} animation={st.animation_name}"
            # Bounded conjunct receipt (contract nodes only): names the exact
            # admission clause that failed instead of forcing inference from
            # the aggregate line above.
            print "[web-style-producer] entry-rejected-detail index={i} channel={material_channel_ready} static={static_material} mode_ok={wm_mode_is_cpu} declared_opaque={declared_opaque} declared_argb={declared_argb} declared_attr_len={declared_bg_attr.len()} translucent={translucent_surface} opaque={opaque_surface} stops_valid={typed_stops_valid} backdrop_admitted={backdrop.admitted} backdrop={mat_backdrop}"
        if _font_style_trace_on:
            print "[font-inherit-trace] index={i} final_font_family={st.font_family} final_font_size={st.font_size}"
        styles[i] = st
        if trace_stages:
            print "[layout-trace] style_stage=node-complete index={i}"
        i = i + 1
    # A style-budget break must not expose closed disclosure content that the
    # outer loop did not reach. Preserve the structural hidden state for the
    # untouched suffix without rescanning any descendants.
    while i < node_count:  # cpu-lane-loop-ok: suffix pass after a style-budget break: restores structural details-hidden state for the nodes the cascade loop never reached; bound is the node count
        if details_hidden[i]:
            styles[i] = apply_decls(styles[i], "display:none", 16)
        i = i + 1
    if material_channel_ready:
        material_counts[0] = cpu_material_entry_count
        material_counts[1] = solid_material_entry_count
    if cpu_material_entry_count > 0:
        print "[web-style-producer] cpu-entries-ready count={cpu_material_entry_count} len={material_entries[0].len()}"
    if solid_material_entry_count > 0:
        print "[web-style-producer] solid-entries-ready count={solid_material_entry_count} len={material_entries[1].len()}"
    styles

pub fn simple_web_layout_debug_style_by_id(html: text, id: text, field: text) -> text:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css(html)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index)
    var i = 0
    val node_count = nodes.len()
    while i < node_count:  # cpu-lane-loop-ok: debug-only entry point (simple_web_layout_debug_style_by_id): linear search of the node arena for one id; not reachable from any render path
        val node = nodes[i]
        if node.id_attr == id:
            val st = styles[i]
            val style_attr = node.style_attr
            if field == "decl_width":
                return decl_get(style_attr, "width")
            if field == "decl_margin":
                return decl_get(style_attr, "margin")
            if field == "decl_height":
                return decl_get(style_attr, "height")
            if field == "parse_width":
                return parse_int(decl_get(style_attr, "width")).to_string()
            if field == "parse_margin":
                return parse_int(decl_get(style_attr, "margin")).to_string()
            if field == "parse_height":
                return parse_int(decl_get(style_attr, "height")).to_string()
            if field == "display":
                return st.display
            if field == "caption-side":
                return st.caption_side
            if field == "border-collapse":
                return st.border_collapse
            if field == "border-spacing":
                if st.border_spacing_x_px == st.border_spacing_y_px:
                    return "{st.border_spacing_x_px}px"
                return (
                    "{st.border_spacing_x_px}px " +
                    "{st.border_spacing_y_px}px"
                )
            if field == "position":
                if st.position_sticky:
                    return "sticky"
                if st.position_fixed:
                    return "fixed"
                if st.position_absolute:
                    return "absolute"
                if st.position_relative:
                    return "relative"
                return "static"
            if field == "width":
                return st.width_px.to_string()
            if field == "height":
                return st.height_px.to_string()
            if field == "margin_l":
                return st.margin_l.to_string()
            if field == "pad_l":
                return st.pad_l.to_string()
            if field == "pad_r":
                return st.pad_r.to_string()
            if field == "border_l":
                return st.border_l.to_string()
            if field == "white_space_nowrap":
                return if st.white_space_nowrap: "true" else: "false"
            if field == "transition_property":
                return st.transition_property
            if field == "transition_duration_ms":
                return st.transition_duration_ms.to_string()
            if field == "transition_delay_ms":
                return st.transition_delay_ms.to_string()
            if field == "transition_timing_function":
                return st.transition_timing_function
            if field == "animation_name":
                return st.animation_name
            if field == "animation_duration_ms":
                return st.animation_duration_ms.to_string()
            if field == "animation_delay_ms":
                return st.animation_delay_ms.to_string()
            if field == "animation_timing_function":
                return st.animation_timing_function
            if field == "animation_iteration_count":
                return st.animation_iteration_count
            if field == "animation_direction":
                return st.animation_direction
            if field == "animation_fill_mode":
                return st.animation_fill_mode
            if field == "animation_play_state":
                return st.animation_play_state
            if field == "transform_origin":
                return st.transform_origin
            if field == "transform_box":
                return st.transform_box
            if field == "transform_style":
                return st.transform_style
            if field == "flex_grow":
                return st.flex_grow.to_string()
            if field == "flex_wrap":
                return st.flex_wrap
            if field == "flex_direction":
                return st.flex_direction
            if field == "font_size":
                return st.font_size.to_string()
            if field == "background_color":
                return st.bg.to_string()
            if field == "background_gradient_from":
                return st.background_gradient_from.to_string()
            if field == "background_gradient_to":
                return st.background_gradient_to.to_string()
            if field == "background_layers_raw":
                return st.bg_layers_raw
            if field == "backdrop_filter_raw":
                return st.backdrop_filter_raw
        i = i + 1
    ""
