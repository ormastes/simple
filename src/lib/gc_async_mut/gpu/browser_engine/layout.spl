use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.layout_box.{BeLayoutBox, BeBoxKind}
use std.gc_async_mut.gpu.browser_engine.css.{CssPx}
use std.gc_async_mut.gpu.browser_engine.layout_core.{layout_node as layout_node_core}
use std.gc_async_mut.gpu.browser_engine.layout_float.{FloatContext}
use std.gc_async_mut.gpu.browser_engine.layout_table.{layout_table}
use std.gc_async_mut.gpu.browser_engine.layout_m14_types.{
    WebLayoutContext, LayoutBox, LineBox, InlineFragment, layout_context_new
}
use std.gc_async_mut.gpu.browser_engine.layout_inline.{
    _collect_text, _split_words, _parse_inline_text_align
}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_get_attr, be_dom_get_style}

val M14_LINE_HEIGHT = 24
val M14_BASELINE = 19

export BeLayoutBox

class LayoutPaintScene:
    """Ordered list of paint commands produced by the layout+paint pass."""
    width: f64
    height: f64
    commands: [text]   # simplified: real impl uses PaintOp enum

impl LayoutPaintScene:
    static fn empty(width: f64, height: f64) -> LayoutPaintScene:
        LayoutPaintScene(width: width, height: height, commands: [])

    fn add_command(cmd: text):
        self.commands.push(cmd)

fn layout_tree(root: BeDomNode, viewport_w: f64, viewport_h: f64) -> BeLayoutBox:
    """Compute a block layout tree for the given DOM root.

    Performs a simplified normal-flow block layout:
    - Width is inherited from parent (viewport for root).
    - Height accumulates children top-down.
    The root is a block formatting context root (CSS 2.2 §9.4.1, like
    `<html>`): no child margin collapses through it. Its own margins are not
    applied.
    """
    _layout_block_node(root, 0.0, 0.0, viewport_w, viewport_h, true, _block_floats_new())

class BlockFloats:
    """Margin-box rects (page coordinates) of the floats placed so far in one
    block formatting context, in source order. Shared by reference down the
    tree; every BFC root starts a fresh one for its own content."""
    xs: [f64]
    ys: [f64]
    ws: [f64]
    hs: [f64]
    lefts: [bool]

fn _block_floats_new() -> BlockFloats:
    BlockFloats(xs: [], ys: [], ws: [], hs: [], lefts: [])

fn _floats_add(fl: BlockFloats, x: f64, y: f64, w: f64, h: f64, left: bool):
    fl.xs.push(x)
    fl.ys.push(y)
    fl.ws.push(w)
    fl.hs.push(h)
    fl.lefts.push(left)

fn _floats_bottom(fl: BlockFloats, left: bool, right: bool, floor: f64) -> f64:
    """Lowest margin-box bottom of the floats on the selected sides, never
    above `floor`: the clearance target of CSS 2.2 §9.5.2."""
    var b = floor
    var i = 0
    while i < fl.ys.len():
        if (fl.lefts[i] and left) or (not fl.lefts[i] and right):
            if fl.ys[i] + fl.hs[i] > b:
                b = fl.ys[i] + fl.hs[i]
        i = i + 1
    b

fn _floats_top(fl: BlockFloats, floor: f64) -> f64:
    """A float's outer top is never above an earlier float's (§9.5.1 rule 5)."""
    var t = floor
    for fy in fl.ys:
        if fy > t:
            t = fy
    t

fn _float_hits(fy: f64, fh: f64, y: f64, h: f64) -> bool:
    """Whether a float spanning [fy, fy+fh) meets the band [y, y+h) (the
    point y when h is 0)."""
    if fh <= 0.0:
        return false
    if h > 0.0:
        return fy < y + h and y < fy + fh
    fy <= y and y < fy + fh

fn _float_band(fl: BlockFloats, y: f64, h: f64, left0: f64, right0: f64) -> [f64]:
    """[left edge, right edge, next y, hit] of the room between the floats
    meeting band [y, y+h); `next y` is the nearest bottom of those floats and
    `hit` is 1.0 when any float meets the band."""
    var le = left0
    var re = right0
    var next_y = y
    var hit = 0.0
    var i = 0
    while i < fl.ys.len():
        if _float_hits(fl.ys[i], fl.hs[i], y, h):
            val bottom = fl.ys[i] + fl.hs[i]
            if hit == 0.0 or bottom < next_y:
                next_y = bottom
            hit = 1.0
            if fl.lefts[i]:
                if fl.xs[i] + fl.ws[i] > le:
                    le = fl.xs[i] + fl.ws[i]
            elif fl.xs[i] < re:
                re = fl.xs[i]
        i = i + 1
    [le, re, next_y, hit]

fn _float_place(fl: BlockFloats, left0: f64, right0: f64, start_y: f64, mw: f64, mh: f64, left: bool) -> [f64]:
    """Margin-box [x, y] of a new float (CSS 2.2 §9.5.1): the highest y from
    `start_y` where its margin box fits beside the floats it would meet, then
    as far left (or right) as those floats allow."""
    var y = start_y
    var tries = 0
    while tries < 1000:
        tries = tries + 1
        val band = _float_band(fl, y, mh, left0, right0)
        if band[3] == 0.0 or band[1] - band[0] >= mw or band[2] <= y:
            if left:
                return [band[0], y]
            return [band[1] - mw, y]
        y = band[2]
    [left0, y]

fn _bfc_place(fl: BlockFloats, left0: f64, right0: f64, start_y: f64, ml: f64, mr: f64, need_w: f64) -> [f64]:
    """Border-box [x, y, width] of a block formatting context root beside
    floats (CSS 2.2 §9.5): its border box may not overlap a float's margin
    box, but its own margins may. Moves down past float bottoms until
    `need_w` (0 for an auto width) fits; hit is tested at the top edge only.
    Returns width -1 once no float meets the top edge (normal placement)."""
    var y = start_y
    var tries = 0
    while tries < 1000:
        tries = tries + 1
        val band = _float_band(fl, y, 0.0, left0, right0)
        if band[3] == 0.0:
            return [left0 + ml, y, -1.0]
        var x = left0 + ml
        if band[0] > x:
            x = band[0]
        var r = right0 - mr
        if band[1] < r:
            r = band[1]
        val fits = if need_w > 0.0: r - x >= need_w else: r - x > 0.0
        if fits or band[2] <= y:
            return [x, y, r - x]
        y = band[2]
    [left0 + ml, y, -1.0]

fn _clears(node: BeDomNode, left: bool) -> bool:
    if node.is_text():
        return false
    val c = node.style.clear_css
    c == "both" or (left and c == "left") or (not left and c == "right")

fn _is_float(node: BeDomNode) -> bool:
    if node.is_text():
        return false
    val f = node.style.float_css
    f != "" and f != "none"

fn _layout_block_node(node: BeDomNode, x: f64, y: f64, avail_w: f64, avail_h: f64, bfc_root: bool, floats: BlockFloats) -> BeLayoutBox:
    """Recursively compute layout for a single node. `bfc_root` is set when the
    container makes this box a BFC root that its own style cannot show (the
    layout root, a flex item). `floats` holds the floats of the enclosing
    block formatting context."""
    if node.is_text():
        # Estimate text box height as 1.5 × font-size, width as content length
        val font_size = if node.style.font_size > 0.0: node.style.font_size else: 16.0
        val est_w = node.data.len().to_f64() * font_size * 0.6
        val w = if est_w < avail_w: est_w else: avail_w
        return BeLayoutBox.text_box(node, node.data, x, y, w, font_size * 1.5)

    # display:none generates no box (CSS Display 3 §2.5). A parent skips such a
    # child; a display:none root still has to return a box, so it is 0x0 with
    # no children, matching Chrome's getBoundingClientRect() of 0,0,0,0.
    if node.style.display == "none":
        var none_box = BeLayoutBox.block_for(node, x, y, 0.0, 0.0)
        none_box.content_x = x
        none_box.content_y = y
        none_box.content_width = 0.0
        none_box.content_height = 0.0
        return none_box

    # Element node
    val style = node.style
    val px = style.padding_left + style.padding_right + style.border_left() + style.border_right()
    val py = style.padding_top + style.padding_bottom + style.border_top() + style.border_bottom()
    val border_box = style.box_sizing == "border-box"

    # An explicit width is the content-box width unless box-sizing:border-box
    # (CSS Box Sizing 3 §4); a border box never shrinks below its insets.
    var self_w = avail_w
    if style.width > 0.0:
        self_w = style.width
        if not border_box:
            self_w = style.width + px
        if self_w < px:
            self_w = px

    var box = BeLayoutBox.block_for(node, x, y, self_w, 0.0)

    # Layout children top-down. Adjoining sibling margins collapse in block
    # flow only (CSS 2.2 §8.3.1); flex and grid items never collapse (CSS
    # Flexbox 1 §4.2, CSS Grid 1 §6.1). Parent/child collapse (§8.3.1): when
    # this box lets its first child's top margin through, the caller already
    # placed this box at the collapsed margin, so the first child sits at the
    # content top; when it lets the last child's bottom margin through, that
    # margin is left out of this box's height and handed to the caller in
    # `after_margin_*`. An empty (self-collapsing) child adds no height and
    # joins its margins into the running set; floats and abs/fixed boxes take
    # no part in collapsing. Every adjoining set resolves as (largest positive
    # + most negative).
    val items_bfc = _items_are_bfc_roots(style)
    val collapse = not items_bfc
    val own_bfc = bfc_root or _is_root_element(node)
    val top_through = not own_bfc and _top_margin_passes(style)
    var bottom_through = not own_bfc and _bottom_margin_passes(style)
    val inner_x = x + style.padding_left + style.border_left()
    val content_top = y + style.padding_top + style.border_top()
    # cursor_y = bottom border edge of the previous child (or content top)
    var cursor_y = content_top
    val inner_w = self_w - px
    var prev_mb = [0.0, 0.0]
    var has_prev = false
    # A BFC root starts its own float context; any other box shares its
    # container's, so clearance sees floats of earlier sibling subtrees.
    val own_ctx = own_bfc or _establishes_bfc(style)
    val fl = if own_ctx: _block_floats_new() else: floats

    var i = 0
    val child_count = node.children.len()
    while i < child_count:
        val child = node.children[i]
        i = i + 1
        # display:none generates no box and takes no space; its margins do not
        # separate the siblings around it (CSS Display 3 §2.5). Whitespace-only
        # text between blocks generates no box either (CSS Text 3 §4.1.1).
        if not _generates_box(child):
            continue
        val out_of_flow = _is_out_of_flow(child)
        var self_collapses = not out_of_flow and _self_collapses(child, items_bfc)
        var prior = [0.0, 0.0]
        if has_prev and collapse:
            prior = prev_mb
        val child_mt = _top_margin_set(child, items_bfc, fl, cursor_y, prior)
        var gap = _margin_set_value(child_mt)
        if out_of_flow:
            # Static position: below the pending margin, plus its own margin.
            gap = child.style.margin_top
            if has_prev:
                gap = gap + _margin_set_value(prev_mb)
        elif has_prev:
            if collapse:
                gap = _margin_set_value(_margin_set_join(prev_mb, child_mt))
            else:
                gap = _margin_set_value(prev_mb) + _margin_set_value(child_mt)
        elif top_through:
            gap = 0.0
        # Horizontal margins (CSS 2.2 §10.3.3): the child's margin box spans the
        # content width, so its border box starts at margin-left and an auto
        # width fills what the two margins leave. Auto margins take the
        # leftover space of an explicit-width block.
        var child_ml = 0.0
        var child_mr = 0.0
        if not child.is_text():
            val used = _used_horizontal_margins(child.style, inner_w)
            child_ml = used[0]
            child_mr = used[1]
        var child_w = inner_w - child_ml - child_mr
        if child_w < 0.0:
            child_w = 0.0
        var cx = inner_x + child_ml
        var cy = cursor_y + gap
        if not out_of_flow and not child.is_text() and collapse:
            # Clearance (CSS 2.2 §9.5.2): when the hypothetical border edge
            # (cy, margins collapsed as if clear were none) is above the
            # relevant floats, the border edge moves to their bottom and the
            # clearance stops the collapse with the preceding margins.
            val clear_y = _floats_bottom(fl, _clears(child, true), _clears(child, false), cy)
            if clear_y > cy:
                cy = clear_y
                self_collapses = false
            # A BFC root may not overlap a float's margin box (§9.5).
            if _establishes_bfc(child.style):
                var need_w = 0.0
                if child.style.width > 0.0:
                    need_w = child.style.width
                    if child.style.box_sizing != "border-box":
                        need_w = need_w +child.style.padding_left + child.style.padding_right + child.style.border_left() + child.style.border_right()
                val placed = _bfc_place(fl, inner_x, inner_x + inner_w, cy, child_ml, child_mr, need_w)
                if placed[2] >= 0.0:
                    cx = placed[0]
                    child_w = placed[2]
                if placed[1] > cy:
                    cy = placed[1]
                    self_collapses = false
        var child_box = _layout_block_node(child, cx, cy, child_w, avail_h, items_bfc, fl)
        if out_of_flow and _is_float(child) and collapse:
            # Float placement (§9.5.1): its margin-box top starts at the
            # static position, no higher than an earlier float or its own
            # clearance, and moves down until its margin box fits.
            val fml = if child.style.margin_left_auto: 0.0 else: child.style.margin_left
            val fmr = if child.style.margin_right_auto: 0.0 else: child.style.margin_right
            val fmt = child.style.margin_top
            val mw = fml + child_box.width + fmr
            val mh = fmt + child_box.height + child.style.margin_bottom
            var top = _floats_top(fl, cy - fmt)
            top = _floats_bottom(fl, _clears(child, true), _clears(child, false), top)
            val left = child.style.float_css != "right"
            val at = _float_place(fl, inner_x, inner_x + inner_w, top, mw, mh, left)
            if at[0] + fml != cx or at[1] + fmt != cy:
                cx = at[0] + fml
                cy = at[1] + fmt
                child_box = _layout_block_node(child, cx, cy, child_w, avail_h, items_bfc, fl)
            child_ml = fml
            child_mr = fmr
            _floats_add(fl, at[0], at[1], mw, mh, left)
        child_box.margin_left = child_ml
        child_box.margin_right = child_mr
        box.children.push(child_box)
        if out_of_flow:
            continue
        # A box that took height in layout is not empty, e.g. a parent whose
        # empty clear:both child cleared a float outside it (Chrome 159).
        if self_collapses and child_box.height > 0.0:
            self_collapses = false
        if self_collapses:
            # Its margins were consumed by this box's top margin, or join the
            # running set; the cursor does not move.
            if has_prev or not top_through:
                prev_mb = _margin_set_join(prev_mb, _margin_set_join(child_mt, _bottom_margin_set(child, items_bfc)))
                has_prev = true
            continue
        cursor_y = cy + child_box.height
        prev_mb = [child_box.after_margin_pos, child_box.after_margin_neg]
        has_prev = true
    # A min-height that would raise the through-collapsed height keeps the
    # last child's margin inside this box (Chrome 159).
    var min_h = style.min_height
    if border_box:
        min_h = style.min_height - py
    if bottom_through and style.min_height > 0.0 and min_h > cursor_y - content_top:
        bottom_through = false
    if not bottom_through:
        cursor_y = cursor_y + _margin_set_value(prev_mb)

    # Determine self height: an explicit height is the content height unless
    # box-sizing:border-box; the content height never goes below 0 or the
    # min-height. A box that establishes a BFC contains its floats.
    var content_h = cursor_y - content_top
    if own_ctx:
        val float_bottom = _floats_bottom(fl, true, true, content_top)
        if float_bottom - content_top > content_h:
            content_h = float_bottom - content_top
    if style.height > 0.0 or style.height_zero:
        content_h = style.height
        if border_box:
            content_h = style.height - py
    if content_h < min_h:
        content_h = min_h
    if content_h < 0.0:
        content_h = 0.0
    box.height = content_h + py
    # Re-sync the stored content height with the resolved border-box height
    # (block_for baked it against the provisional 0.0 height).
    box.content_height = content_h
    var after = _margin_set(style.margin_bottom)
    if bottom_through:
        after = _margin_set_join(after, prev_mb)
    box.after_margin_pos = after[0]
    box.after_margin_neg = after[1]
    box

fn _used_horizontal_margins(style: StyleProps, inner_w: f64) -> [f64]:
    """Used [margin-left, margin-right] of a block in normal flow (CSS 2.2
    §10.3.3). With an auto width, auto margins are 0. With an explicit width,
    auto margins share the leftover space equally (one auto side takes all of
    it); a negative leftover (over-constrained) makes them 0."""
    var ml = style.margin_left
    var mr = style.margin_right
    if style.margin_left_auto:
        ml = 0.0
    if style.margin_right_auto:
        mr = 0.0
    if style.width <= 0.0:
        return [ml, mr]
    if not style.margin_left_auto and not style.margin_right_auto:
        return [ml, mr]
    val px = style.padding_left + style.padding_right + style.border_left() + style.border_right()
    var border_w = style.width
    if style.box_sizing != "border-box":
        border_w = style.width + px
    if border_w < px:
        border_w = px
    val leftover = inner_w - ml - mr - border_w
    if leftover <= 0.0:
        return [ml, mr]
    if style.margin_left_auto and style.margin_right_auto:
        return [leftover / 2.0, leftover / 2.0]
    if style.margin_left_auto:
        return [leftover, mr]
    [ml, leftover]

fn _margin_set(m: f64) -> [f64]:
    """A set of adjoining vertical margins as [largest positive, most
    negative] (CSS 2.2 §8.3.1). Folding pairwise collapses is wrong once signs
    mix (10, -5, 3 must give 5, not 8), so sets join component-wise and
    resolve once."""
    if m >= 0.0:
        return [m, 0.0]
    [0.0, m]

fn _margin_set_join(a: [f64], b: [f64]) -> [f64]:
    var pos = a[0]
    if b[0] > pos:
        pos = b[0]
    var neg = a[1]
    if b[1] < neg:
        neg = b[1]
    [pos, neg]

fn _margin_set_value(m: [f64]) -> f64:
    m[0] + m[1]

fn _establishes_bfc(style: StyleProps) -> bool:
    """Block formatting context roots detectable from StyleProps (CSS 2.2
    §9.4.1, CSS Display 3): flex/grid/flow-root/inline-block/table boxes,
    `overflow` other than visible/clip, floats, absolute/fixed positioning."""
    val d = style.display
    if d == "flex" or d == "inline-flex" or d == "grid" or d == "inline-grid":
        return true
    if d == "flow-root" or d == "inline-block" or d == "table" or d == "inline-table" or d == "table-cell":
        return true
    val o = style.overflow
    if o != "" and o != "visible" and o != "clip":
        return true
    if style.float_css != "" and style.float_css != "none":
        return true
    style.position == "absolute" or style.position == "fixed"

fn _is_root_element(node: BeDomNode) -> bool:
    """`<html>` establishes the initial BFC (CSS 2.2 §9.4.1) even when the
    layout root is the `#document` node above it."""
    node.tag_name.lower() == "html"

fn _items_are_bfc_roots(style: StyleProps) -> bool:
    """Flex and grid items each establish an independent formatting context."""
    val d = style.display
    d == "flex" or d == "inline-flex" or d == "grid" or d == "inline-grid"

fn _top_margin_passes(style: StyleProps) -> bool:
    """A box's top margin adjoins its first in-flow child's (CSS 2.2 §8.3.1)
    with no top border, no top padding and no own BFC. A child with
    clearance ends the chain: see `_top_margin_set`."""
    not _establishes_bfc(style) and style.padding_top == 0.0 and style.border_top() == 0.0

fn _bottom_margin_passes(style: StyleProps) -> bool:
    """A box's bottom margin adjoins its last in-flow child's with no bottom
    border/padding, an auto height and no own BFC. A min-height that takes
    effect is checked at layout time."""
    not _establishes_bfc(style) and style.padding_bottom == 0.0 and style.border_bottom() == 0.0 and style.height <= 0.0 and not style.height_zero

fn _generates_box(node: BeDomNode) -> bool:
    """False for display:none and whitespace-only text."""
    if node.is_text():
        return node.data.trim() != ""
    node.style.display != "none"

fn _is_out_of_flow(node: BeDomNode) -> bool:
    """Floats and absolutely/fixed positioned boxes (CSS 2.2 §9.3)."""
    if node.is_text():
        return false
    val f = node.style.float_css
    (f != "" and f != "none") or node.style.position == "absolute" or node.style.position == "fixed"

fn _self_collapses(node: BeDomNode, bfc_root: bool) -> bool:
    """CSS 2.2 §8.3.1: a box with no own BFC, zero min-height, zero or auto
    height, no vertical padding/border and no in-flow content has adjoining
    top and bottom margins."""
    if node.is_text() or bfc_root or _is_root_element(node):
        return false
    val st = node.style
    if _establishes_bfc(st) or st.padding_top != 0.0 or st.padding_bottom != 0.0 or st.border_top() != 0.0 or st.border_bottom() != 0.0:
        return false
    if st.height > 0.0 or st.min_height > 0.0:
        return false
    var left_float = false
    var right_float = false
    for c in node.children:
        if _generates_box(c) and _is_float(c):
            left_float = left_float or c.style.float_css != "right"
            right_float = right_float or c.style.float_css == "right"
        elif _generates_box(c) and not _is_out_of_flow(c):
            # A child cleared past an earlier sibling float has clearance, so
            # this box is not empty (the clearfix pattern, Chrome 159).
            if (left_float and _clears(c, true)) or (right_float and _clears(c, false)):
                return false
            if not _self_collapses(c, false):
                return false
    true

fn _top_margin_set(node: BeDomNode, bfc_root: bool, fl: BlockFloats, base_y: f64, prior: [f64]) -> [f64]:
    """The collapsed top-margin set a box presents to its container: its own
    margin-top joined with its leading in-flow children's sets while they
    adjoin (an empty child adds its whole set and lets the next one through).
    A leading child with clearance ends the chain before its own margin
    (CSS 2.2 §8.3.1): Chrome 159 gives it clearance when it clears a float
    that precedes it in the same box, or when its hypothetical border edge
    (`base_y` + the collapsed `prior` + chain) is above a float in `fl`."""
    if node.is_text():
        return [0.0, 0.0]
    var m = _margin_set(node.style.margin_top)
    if bfc_root or _is_root_element(node) or not _top_margin_passes(node.style):
        return m
    val items_bfc = _items_are_bfc_roots(node.style)
    var left_float = false
    var right_float = false
    for c in node.children:
        if _generates_box(c) and _is_float(c):
            left_float = left_float or c.style.float_css != "right"
            right_float = right_float or c.style.float_css == "right"
        elif _generates_box(c) and not _is_out_of_flow(c):
            val cl = _clears(c, true)
            val cr = _clears(c, false)
            if (left_float and cl) or (right_float and cr):
                return m
            val before = _margin_set_join(prior, m)
            val cm = _top_margin_set(c, items_bfc, fl, base_y, before)
            if cl or cr:
                val hyp = base_y + _margin_set_value(_margin_set_join(before, cm))
                if _floats_bottom(fl, cl, cr, hyp) > hyp:
                    return m
            m = _margin_set_join(m, cm)
            if not _self_collapses(c, items_bfc):
                return m
            m = _margin_set_join(m, _bottom_margin_set(c, items_bfc))
    m

fn _bottom_margin_set(node: BeDomNode, bfc_root: bool) -> [f64]:
    """The collapsed bottom-margin set of a box whose height does not depend
    on layout: its own margin-bottom joined with its trailing in-flow
    children's sets while they adjoin. Used for self-collapsing boxes; laid
    out boxes report theirs in `after_margin_*`."""
    if node.is_text():
        return [0.0, 0.0]
    var m = _margin_set(node.style.margin_bottom)
    if bfc_root or _is_root_element(node) or not _bottom_margin_passes(node.style):
        return m
    val items_bfc = _items_are_bfc_roots(node.style)
    var k = node.children.len() - 1
    while k >= 0:
        val c = node.children[k]
        k = k - 1
        if _generates_box(c) and not _is_out_of_flow(c):
            m = _margin_set_join(m, _bottom_margin_set(c, items_bfc))
            if not _self_collapses(c, items_bfc):
                return m
            m = _margin_set_join(m, _top_margin_set(c, items_bfc, _block_floats_new(), 0.0, [0.0, 0.0]))
    m

fn layout_node(node: BeDomNode, container: BeLayoutBox, parent_style: StyleProps) -> BeLayoutBox:
    """Lay out a single node within a container box and computed parent style.

    Container-box entry point over the layout_core dispatcher: runs the same
    block/flex/text layout with a fresh float context."""
    layout_node_core(node, container, parent_style, FloatContext.create())

fn layout_to_scene(root: BeDomNode, w: CssPx, h: CssPx) -> LayoutPaintScene:
    """Run layout then generate paint commands into a LayoutPaintScene.

    Inlines layout_tree + paint to avoid cross-module FieldGet issues
    (see ADR-002 / Cranelift FieldGet bug note in engine_merge).
    """
    val box_tree = layout_tree(root, w.value, h.value)
    val scene = LayoutPaintScene.empty(w.value, h.value)
    paint_box(box_tree, scene)
    scene

fn paint_box(box: BeLayoutBox, scene: LayoutPaintScene):
    """Recursively emit paint commands for a layout box."""
    # Background
    if box.style.background_color.len() > 0:
        scene.add_command("fill_rect {box.x} {box.y} {box.width} {box.height} {box.style.background_color}")

    # Border: one stroke when all four sides match, else a fill per side.
    val bt = box.style.border_top()
    val br = box.style.border_right()
    val bb = box.style.border_bottom()
    val bl = box.style.border_left()
    val bc = box.style.border_color
    if bc.len() > 0:
        if bt > 0.0 and bt == br and bt == bb and bt == bl:
            scene.add_command("stroke_rect {box.x} {box.y} {box.width} {box.height} {bt} {bc}")
        else:
            if bt > 0.0:
                scene.add_command("fill_rect {box.x} {box.y} {box.width} {bt} {bc}")
            if bb > 0.0:
                val bottom_y = box.y + box.height - bb
                scene.add_command("fill_rect {box.x} {bottom_y} {box.width} {bb} {bc}")
            if bl > 0.0:
                scene.add_command("fill_rect {box.x} {box.y} {bl} {box.height} {bc}")
            if br > 0.0:
                val right_x = box.x + box.width - br
                scene.add_command("fill_rect {right_x} {box.y} {br} {box.height} {bc}")

    # Text content
    if box.text_content.len() > 0:
        scene.add_command("draw_text {box.x} {box.y} {box.style.font_size} {box.style.color} {box.text_content}")

    # Recurse into children
    var i = 0
    val child_count = box.children.len()
    while i < child_count:
        paint_box(box.children[i], scene)
        i = i + 1

fn layout_get_x(box: BeLayoutBox) -> f64:
    box.x

fn layout_get_y(box: BeLayoutBox) -> f64:
    box.y

fn layout_get_width(box: BeLayoutBox) -> f64:
    box.width

fn layout_get_height(box: BeLayoutBox) -> f64:
    box.height

fn layout_get_node(box: BeLayoutBox) -> i64:
    box.node_id

fn layout_get_children(box: BeLayoutBox) -> [BeLayoutBox]:
    box.children

fn layout_flex(node: BeDomNode, container: BeLayoutBox, style: StyleProps, parent_ctx) -> BeLayoutBox:
    container

fn layout_text(node: BeDomNode, container: BeLayoutBox, style: StyleProps) -> BeLayoutBox:
    container

fn _box_contains(box: BeLayoutBox, x: f64, y: f64) -> bool:
    """Point-in-box test in absolute layout coordinates.

    Half-open on the right/bottom edge ([x, x+w) x [y, y+h)), matching the
    GUI reference convention (common.ui.widget_hit._contains): a point on a
    shared border between two adjacent boxes hits exactly the box whose
    interval contains it, never both."""
    x >= box.x and y >= box.y and x < box.x + box.width and y < box.y + box.height

fn _lockstep_count(box: BeLayoutBox, node: BeDomNode) -> i64:
    """Child count shared by the layout box and its DOM node (layout_node
    emits one child box per DOM child, in order)."""
    var n = box.children.len()
    if node.children.len() < n:
        n = node.children.len()
    n

fn hit_test(box: BeLayoutBox, node: BeDomNode, x: f64, y: f64) -> BeDomNode?:
    """Return the deepest DOM node whose layout box contains (x, y).

    Walks the layout box tree and DOM tree in lockstep (layout_node builds
    box.children[i] from node.children[i]), preferring the last (topmost)
    matching child. Returns nil when the point falls outside `box`.
    """
    if not _box_contains(box, x, y):
        return None
    val n = _lockstep_count(box, node)
    var i = n - 1
    while i >= 0:
        val found = hit_test(box.children[i], node.children[i], x, y)
        if found.?:
            return found
        i = i - 1
    Some(node)

fn hit_test_anchor(box: BeLayoutBox, node: BeDomNode, x: f64, y: f64) -> BeDomNode?:
    """Return the innermost enclosing <a> node whose subtree contains the
    deepest box at (x, y), or nil when the hit is not inside any anchor."""
    if not _box_contains(box, x, y):
        return None
    val n = _lockstep_count(box, node)
    var i = n - 1
    while i >= 0:
        val found = hit_test_anchor(box.children[i], node.children[i], x, y)
        if found.?:
            return found
        i = i - 1
    if node.tag_name == "a":
        return Some(node)
    None

fn first_anchor_box(box: BeLayoutBox, node: BeDomNode) -> BeLayoutBox?:
    """Return the layout box of the first <a> element in document order."""
    if node.tag_name == "a":
        return Some(box)
    val n = _lockstep_count(box, node)
    var i = 0
    while i < n:
        val found = first_anchor_box(box.children[i], node.children[i])
        if found.?:
            return found
        i = i + 1
    None

# =========================================================================
# M14 public block layout (CSS 2.1 §9.2.1 anonymous block boxes)
# =========================================================================

fn _m14_is_inline_tag(tag: text) -> bool:
    """Inline-level tags for the M14 public layout API (CSS 2.1 §9.2.2)."""
    (
        tag == "#text" or tag == "span" or tag == "a" or tag == "b" or
        tag == "i" or tag == "em" or tag == "strong" or tag == "small" or
        tag == "code" or tag == "label" or tag == "abbr" or tag == "sub" or
        tag == "sup" or tag == "br" or tag == "var" or tag == "kbd" or
        tag == "samp" or tag == "time" or tag == "q" or tag == "cite" or
        tag == "bdi" or tag == "bdo" or tag == "data" or tag == "del" or
        tag == "dfn" or tag == "ins" or tag == "output" or tag == "s" or
        tag == "u" or tag == "wbr" or tag == "mark" or tag == "slot" or
        tag == "selectedcontent" or
        # Replaced elements are inline-level too (round 19): Chrome reports
        # `display=inline` for canvas/svg/audio/video on the `animation`
        # catalog page. Kept in step with `is_inline_tag` in
        # `simple_web_html_layout_renderer_style.spl`, this predicate's twin.
        tag == "img" or tag == "svg" or tag == "video" or tag == "audio" or
        tag == "canvas" or tag == "iframe" or tag == "embed" or
        tag == "object"
    )

fn _m14_is_non_rendered(tag: text) -> bool:
    """Tags that generate no box at all."""
    (
        tag == "head" or tag == "title" or tag == "meta" or tag == "style" or
        tag == "script" or tag == "link" or tag == "base" or tag == "template"
    )

fn _m14_text_of(node: BeDomNode) -> text:
    """Concatenated text content of an inline-level node."""
    if node.tag_name == "#text":
        return node.data
    var out = ""
    var i = 0
    while i < node.children.len():
        out = out + _m14_text_of(node.children[i])
        i = i + 1
    out

fn _m14_rendered_children(node: BeDomNode) -> [BeDomNode]:
    """Children that generate boxes: drops non-rendered tags and the
    whitespace-only text nodes the parser inserts between block siblings."""
    var kids: [BeDomNode] = []
    var i = 0
    while i < node.children.len():
        val c = node.children[i]
        if not _m14_is_non_rendered(c.tag_name):
            if c.tag_name != "#text" or c.data.trim() != "":
                kids.push(c)
        i = i + 1
    kids

fn _m14_layout_root(node: BeDomNode) -> BeDomNode:
    """Resolve the layout root: the parser always wraps author markup in
    `#document > html > body`, and those wrappers are not author boxes, so
    descend through them while each has exactly one rendered child."""
    var cur = node
    var guard = 0
    while guard < 8:
        val t = cur.tag_name
        if t != "#document" and t != "html" and t != "body":
            return cur
        val kids = _m14_rendered_children(cur)
        if kids.len() != 1 or _m14_is_inline_tag(kids[0].tag_name):
            # A lone INLINE child is content, not a wrapper: descending into it
            # would return a box with no children and drop the text.
            return cur
        cur = kids[0]
        guard = guard + 1
    cur

fn _m14_line_box(x: i32, y: i32, width: i32, run: text) -> LineBox:
    """One line box holding a single inline fragment for `run`."""
    val frag = InlineFragment(
        x: x, y: y, width: width, height: M14_LINE_HEIGHT,
        baseline_offset: M14_BASELINE, text_run: run
    )
    LineBox(
        x: x, y: y, width: width, height: M14_LINE_HEIGHT,
        baseline: M14_BASELINE, fragments: [frag]
    )

fn _m14_anonymous_block(y: i32, width: i32, run: text) -> LayoutBox:
    """CSS 2.1 §9.2.1: an anonymous block box wrapping an inline run that is
    a sibling of block-level content."""
    LayoutBox(
        x: 0, y: y, width: width, height: M14_LINE_HEIGHT,
        is_anonymous: true, line_boxes: [_m14_line_box(0, y, width, run)],
        children: []
    )

fn _m14_layout_block_node(node: BeDomNode, avail_w: i32, top: i32) -> LayoutBox:
    """Normal-flow block layout for one element, generating anonymous block
    boxes around every maximal inline run when the element also has at least
    one block-level child (CSS 2.1 §9.2.1)."""
    val kids = _m14_rendered_children(node)
    var has_block = false
    var i = 0
    while i < kids.len():
        if not _m14_is_inline_tag(kids[i].tag_name):
            has_block = true
        i = i + 1

    var children: [LayoutBox] = []
    var lines: [LineBox] = []
    var y = top
    var run = ""
    i = 0
    while i < kids.len():
        val k = kids[i]
        if _m14_is_inline_tag(k.tag_name):
            run = run + _m14_text_of(k)
        else:
            if run != "":
                children.push(_m14_anonymous_block(y, avail_w, run))
                y = y + M14_LINE_HEIGHT
                run = ""
            val child_box = _m14_layout_block_node(k, avail_w, y)
            children.push(child_box)
            y = y + child_box.height
        i = i + 1

    if run != "":
        if has_block:
            children.push(_m14_anonymous_block(y, avail_w, run))
        else:
            lines.push(_m14_line_box(0, y, avail_w, run))
        y = y + M14_LINE_HEIGHT

    LayoutBox(
        x: 0, y: top, width: avail_w, height: y - top,
        is_anonymous: false, line_boxes: lines, children: children
    )

fn layout_block(node: BeDomNode, ctx: WebLayoutContext) -> LayoutBox:
    """Lay out `node` as a block container over the M14 public LayoutBox type.

    `node` may be the parsed document; the parser-inserted
    `#document > html > body` wrappers are unwrapped first. Inline runs that
    are siblings of block-level boxes are wrapped in anonymous block boxes
    (`is_anonymous == true`) per CSS 2.1 §9.2.1."""
    _m14_layout_block_node(_m14_layout_root(node), ctx.available_width, 0)

# Fixed per-character advance for IFC text measurement. M14 carries no font
# metrics, so inline text advances at the same uniform rate the rest of the
# M14 model assumes; one space between words costs one character advance.
val IFC_CHAR_WIDTH = 8

fn _m14_inline_style_prop(node: BeDomNode, name: text) -> text:
    """Extract a `name:` value from the inline style attribute; "" when the
    attribute or property is absent."""
    val style_attr = be_dom_get_attr(node, "style")
    if style_attr.len() == 0:
        return ""
    val needle = name + ":"
    val idx = style_attr.index_of(needle)
    if idx < 0:
        return ""
    val start = idx + needle.byte_len()
    var end = start
    val style_attr_blen = style_attr.byte_len()
    while end < style_attr_blen and style_attr.slice(end, end + 1) != ";":
        end = end + 1
    style_attr.slice(start, end).trim()

fn _m14_text_width(s: text) -> i32:
    """Advance width of `s` in the fixed-rate M14 text model."""
    s.len() * IFC_CHAR_WIDTH

fn _m14_chunk_word(w: text, avail: i32) -> [text]:
    """Split `w` into chunks no wider than `avail` (word-break: break-all /
    overflow-wrap: break-word)."""
    var chunks: [text] = []
    var max_chars = avail / IFC_CHAR_WIDTH
    if max_chars < 1:
        max_chars = 1
    var i = 0
    val w_blen = w.byte_len()
    while i < w_blen:
        var j = i + max_chars
        if j > w_blen:
            j = w_blen
        chunks.push(w.slice(i, j))
        i = j
    chunks

fn _m14_ifc_line(runs: [text], used_w: i32, y: i32, avail: i32, align: text) -> LineBox:
    """Build one LineBox from the text runs packed on a single line, with
    fragments positioned per `text-align` (left default; center/right offset
    the whole run within the available width)."""
    var x0 = 0
    if align == "center":
        x0 = (avail - used_w) / 2
        if x0 < 0:
            x0 = 0
    else:
        if align == "right":
            x0 = avail - used_w
            if x0 < 0:
                x0 = 0
    var frags: [InlineFragment] = []
    var x = x0
    var i = 0
    while i < runs.len():
        val w = _m14_text_width(runs[i])
        frags.push(InlineFragment(
            x: x, y: y, width: w, height: M14_LINE_HEIGHT,
            baseline_offset: M14_BASELINE, text_run: runs[i]))
        x = x + w + IFC_CHAR_WIDTH
        i = i + 1
    LineBox(
        x: x0, y: y, width: used_w, height: M14_LINE_HEIGHT,
        baseline: M14_BASELINE, fragments: frags)

fn layout_inline(node: BeDomNode, ctx: WebLayoutContext) -> LayoutBox:
    """Lay out `node` as an inline formatting context over the M14 public
    LayoutBox type, performing real line breaking.

    Whitespace-separated words are packed greedily into lines of
    `ctx.available_width` px. An oversized word is split into width-fitting
    chunks when the root element requests it (`word-break: break-all` or
    `overflow-wrap: break-word`/`anywhere`); otherwise it keeps its own
    overflowing line, per CSS Text Level 3. Fragments are positioned per
    `text-align` (default left)."""
    val root = _m14_layout_root(node)
    val avail = ctx.available_width
    val align = _parse_inline_text_align(root)
    val word_break = _m14_inline_style_prop(root, "word-break")
    var wrap = _m14_inline_style_prop(root, "overflow-wrap")
    if wrap == "":
        wrap = be_dom_get_style(root).overflow_wrap
    var tokens: [text] = []
    val words = _split_words(_collect_text(root))
    var i = 0
    while i < words.len():
        val w = words[i]
        if _m14_text_width(w) > avail and (word_break == "break-all" or wrap == "break-word" or wrap == "anywhere"):
            val chunks = _m14_chunk_word(w, avail)
            var k = 0
            while k < chunks.len():
                tokens.push(chunks[k])
                k = k + 1
        else:
            tokens.push(w)
        i = i + 1
    var lines: [LineBox] = []
    var cur: [text] = []
    var cur_w = 0
    i = 0
    while i < tokens.len():
        val w = _m14_text_width(tokens[i])
        if cur.len() == 0:
            cur.push(tokens[i])
            cur_w = w
        else:
            val joined = cur_w + IFC_CHAR_WIDTH + w
            if joined <= avail:
                cur.push(tokens[i])
                cur_w = joined
            else:
                lines.push(_m14_ifc_line(cur, cur_w, lines.len() * M14_LINE_HEIGHT, avail, align))
                cur = [tokens[i]]
                cur_w = w
        i = i + 1
    if cur.len() > 0:
        lines.push(_m14_ifc_line(cur, cur_w, lines.len() * M14_LINE_HEIGHT, avail, align))
    LayoutBox(
        x: 0, y: 0, width: avail, height: lines.len() * M14_LINE_HEIGHT,
        is_anonymous: false, line_boxes: lines, children: [])

