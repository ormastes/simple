fn styles_with_height(styles: [Style], index: i32, height_px: i32) -> [Style]:
    val style_count = styles.len()
    if style_count == 0:
        return []
    var result: [Style] = [styles[0]; style_count]
    var si = 0
    while si < style_count:
        if si == index:
            result[si] = style_with_height(styles[si], height_px)
        else:
            result[si] = styles[si]
        si = si + 1
    result
fn intrinsic_text_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, widths: [i32]) -> IntrinsicWidthResult:
    if widths[i] >= 0:
        return IntrinsicWidthResult(width: widths[i], widths: widths)
    var out_widths = widths
    var width = 0
    var c = child_index.first_child[i]
    while c >= 0:
        if nodes[c].tag == "#text":
            val txt: text = nodes[c].text_trimmed
            if txt.len() > 0:
                val glyph_w = style_char_w(styles[c])
                val ink_w = if glyph_w > 1: glyph_w - 1 else: glyph_w
                width = width + txt.len() * ink_w
        elif styles[c].display == "inline":
            val child = intrinsic_text_width(nodes, styles, child_index, c, out_widths)
            out_widths = child.widths
            width = width + child.width
        c = child_index.next_sibling[c]
    if nodes[i].tag != "#text":
        width = width + styles[i].pad_l + styles[i].pad_r + styles[i].border_l + styles[i].border_r
    out_widths[i] = width
    IntrinsicWidthResult(width: width, widths: out_widths)

fn inline_text_advance_width(node: HNode, st: Style) -> i32:
    if node.tag != "#text":
        return 0
    val raw = node.text_data
    if raw == " " and node.text_trimmed == "":
        var whitespace_advance = style_space_advance(st) / 3
        if whitespace_advance < 1:
            whitespace_advance = 1
        return whitespace_advance
    var width = 0
    var i = 0
    val n = raw.len()
    val advance = style_text_advance(st)
    val space_advance = style_space_advance(st)
    while i < n:
        val ch = raw.char_code_at(i)
        if ch == 32:
            width = width + space_advance
        elif ch == 9 or ch == 10 or ch == 13:
            if node.text_trimmed != "":
                width = width + space_advance
        else:
            width = width + advance
        i = i + 1
    width

fn text_ink_y_offset(fs: i32) -> i32:
    val scale = glyph_scale(fs)
    if scale > 1:
        return scale + 1
    1

fn text_ink_x_offset(fs: i32) -> i32:
    1

fn wrap_line_end(txt: text, off: i32, cpl: i32) -> i32:
    val n = txt.len()
    var limit = off + cpl
    if limit >= n:
        return n
    var last_space = -1
    var i = off
    while i < limit:
        if txt.char_code_at(i) == 32:
            last_space = i
        i = i + 1
    if last_space > off:
        return last_space
    limit

fn skip_wrap_spaces(txt: text, off: i32) -> i32:
    var out = off
    val n = txt.len()
    while out < n and txt.char_code_at(out) == 32:
        out = out + 1
    out

fn text_line_advance_width(txt: text, start: i32, endv: i32, advance: i32, space_advance: i32) -> i32:
    var width = 0
    var i = start
    while i < endv:
        width = width + if txt.char_code_at(i) == 32: space_advance else: advance
        i = i + 1
    width

fn text_line_aligned_x(base_x: i32, line_box_w: i32, line_w: i32, st: Style, line_i: i32, line_count: i32) -> i32:
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "start":
        align = if st.direction_rtl: "right" else: "left"
    elif align == "end":
        align = if st.direction_rtl: "left" else: "right"
    if align == "center":
        return base_x + (line_box_w - line_w) / 2
    if align == "right":
        return base_x + line_box_w - line_w
    base_x

fn ellipsize_text_for_width(txt: text, start: i32, endv: i32, max_width: i32, advance: i32, space_advance: i32) -> text:
    if max_width <= 0:
        return ""
    val full_width = text_line_advance_width(txt, start, endv, advance, space_advance)
    if full_width <= max_width:
        return txt.substring(start, endv)
    val ellipsis = "..."
    val ellipsis_w = text_line_advance_width(ellipsis, 0, ellipsis.len(), advance, space_advance)
    if max_width <= ellipsis_w:
        return ellipsis
    val content_limit = max_width - ellipsis_w
    var out = ""
    var used = 0
    var i = start
    while i < endv:
        val char_w = if txt.char_code_at(i) == 32: space_advance else: advance
        if used + char_w > content_limit:
            break
        out = out + txt.char_at(i)
        used = used + char_w
        i = i + 1
    out + ellipsis

fn compute_wrap_ranges(txt: text, cpl: i32) -> LineWrapRanges:
    val txt_len = txt.len()
    if txt_len == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var line_count = 0
    var count_off = 0
    while count_off < txt_len:
        val endc = wrap_line_end(txt, count_off, cpl)
        line_count = line_count + 1
        count_off = skip_wrap_spaces(txt, endc)
    if line_count <= 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var starts: [i32] = [0; line_count]
    var ends: [i32] = [0; line_count]
    var off = 0
    var line = 0
    while off < txt_len:
        val endc = wrap_line_end(txt, off, cpl)
        starts[line] = off
        ends[line] = endc
        off = skip_wrap_spaces(txt, endc)
        line = line + 1
    LineWrapRanges(starts: starts, ends: ends)

fn zero_i32_list(count: i32) -> [i32]:
    [0; count]

fn neg_one_i32_list(count: i32) -> [i32]:
    [-1; count]

fn shifted_i32_list(values: [i32], delta: i32) -> [i32]:
    val count = values.len()
    var shifted: [i32] = [0; count]
    var i = 0
    while i < count:
        shifted[i] = values[i] + delta
        i = i + 1
    shifted

fn empty_i32_lists(count: i32) -> [[i32]]:
    [[]; count]

fn css_outer_width(node: HNode, st: Style, css_width: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_width
    css_width + st.pad_l + st.pad_r + st.border_l + st.border_r

fn css_outer_height(node: HNode, st: Style, css_height: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_height
    css_height + st.pad_t + st.pad_b + st.border_t + st.border_b

fn definite_content_height_limit(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return st.height_px - st.pad_t - st.pad_b - border_y
        return st.height_px
    if st.min_height_px > 0:
        return st.min_height_px
    0

fn constrained_outer_width(node: HNode, st: Style, candidate_width: i32) -> i32:
    var out = candidate_width
    if st.min_width_px > 0:
        val min_outer = css_outer_width(node, st, st.min_width_px)
        if out < min_outer:
            out = min_outer
    if st.max_width_px > 0:
        val max_outer = css_outer_width(node, st, st.max_width_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn constrained_outer_height(node: HNode, st: Style, candidate_height: i32) -> i32:
    var out = candidate_height
    if st.min_height_px > 0:
        val min_outer = css_outer_height(node, st, st.min_height_px)
        if out < min_outer:
            out = min_outer
    if st.max_height_px > 0:
        val max_outer = css_outer_height(node, st, st.max_height_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn absolute_outer_width(parent: Style, node: HNode, st: Style, containing_w: i32) -> i32:
    if st.width_px == 0 and st.left_px > 0 and st.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        var stretched = padding_box_w - st.left_px - st.right_px
        if stretched < 1:
            stretched = 1
        return constrained_outer_width(node, st, stretched)
    if st.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val percent_content_w = padding_box_w * (0 - st.width_px) / 100
        return constrained_outer_width(node, st, css_outer_width(node, st, percent_content_w))
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    if st.width_px > 0:
        return constrained_outer_width(node, st, explicit_node_w)
    constrained_outer_width(node, st, containing_w)

fn absolute_outer_height(node: HNode, st: Style, containing_h: i32) -> i32:
    val border_y = st.border_t + st.border_b
    val resolved_h = resolve_percent_height_px(st.height_px, containing_h)
    if resolved_h > 0:
        if st.border_box:
            return constrained_outer_height(node, st, resolved_h)
        return constrained_outer_height(node, st, resolved_h + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

fn resolve_horizontal_margin_px(margin_px: i32, containing_w: i32) -> i32:
    if margin_px < 0:
        return containing_w * (0 - margin_px) / 100
    margin_px

fn resolve_percent_height_px(height_px: i32, containing_h: i32) -> i32:
    if height_px < 0 and containing_h > 0:
        return containing_h * (0 - height_px) / 100
    height_px

fn absolute_child_x(parent_x: i32, parent: Style, child_node: HNode, child: Style, containing_w: i32) -> i32:
    if child.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        return parent_x + parent.border_l + padding_box_w - absolute_outer_width(parent, child_node, child, containing_w) - child.right_px
    parent_x + parent.border_l + child.left_px

fn absolute_child_y(parent_y: i32, parent: Style, child_node: HNode, child: Style, containing_h: i32) -> i32:
    if child.bottom_px >= 0:
        return parent_y + parent.border_t + containing_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px
    parent_y + parent.border_t + child.top_px

fn absolute_child_styles(styles: [Style], child_index: i32, parent: Style, child: Style, containing_w: i32, containing_h: i32) -> [Style]:
    var resolved_child = child
    if child.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val child_width_px = padding_box_w * (0 - child.width_px) / 100
        resolved_child = style_with_width(resolved_child, child_width_px)
    val child_height_px = resolve_percent_height_px(child.height_px, containing_h)
    if child_height_px > 0 and child_height_px != resolved_child.height_px:
        resolved_child = style_with_height(resolved_child, child_height_px)
    if resolved_child.width_px != child.width_px or resolved_child.height_px != child.height_px:
        val style_count = styles.len()
        if style_count == 0:
            return []
        var result: [Style] = [styles[0]; style_count]
        var si = 0
        while si < style_count:
            if si == child_index:
                result[si] = resolved_child
            else:
                result[si] = styles[si]
            si = si + 1
        return result
    styles

fn layout(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32]) -> LayoutResult:
    var out_bx = bx
    var out_by = by
    var out_bw = bw
    var out_bh = bh
    var out_wrap_starts = wrap_starts
    var out_wrap_ends = wrap_ends
    var out_intrinsic_widths = intrinsic_widths
    out_bx[i] = x
    out_by[i] = y
    val st = styles[i]
    val node = nodes[i]
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if st.display == "none":
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    if st.display == "contents":
        out_bw[i] = w
        var cy_contents = y
        var c_contents = child_index.first_child[i]
        var child_count_contents = 0
        var prev_margin_b_contents = 0
        while c_contents >= 0:
            val cst = styles[c_contents]
            val cml = resolve_horizontal_margin_px(cst.margin_l, w)
            val cmr = resolve_horizontal_margin_px(cst.margin_r, w)
            if child_count_contents > 0:
                cy_contents = cy_contents + st.gap_px
            val collapsed_margin_contents = if prev_margin_b_contents > cst.margin_t: prev_margin_b_contents else: cst.margin_t
            cy_contents = cy_contents + collapsed_margin_contents
            var child_w_contents = w - cml - cmr
            if child_w_contents < 1:
                child_w_contents = 1
            val child = layout(nodes, styles, child_index, c_contents, x + cml, cy_contents, child_w_contents, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths)
            out_bx = child.bx
            out_by = child.by
            out_bw = child.bw
            out_bh = child.bh
            out_wrap_starts = child.wrap_starts
            out_wrap_ends = child.wrap_ends
            out_intrinsic_widths = child.intrinsic_widths
            cy_contents = cy_contents + child.height
            prev_margin_b_contents = cst.margin_b
            child_count_contents = child_count_contents + 1
            c_contents = child_index.next_sibling[c_contents]
        if child_count_contents > 0:
            cy_contents = cy_contents + prev_margin_b_contents
        val h_contents = cy_contents - y
        out_bh[i] = h_contents
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h_contents)
    val border_x = st.border_l + st.border_r
    val border_y = st.border_t + st.border_b
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    # width_px > 0: explicit px. width_px < 0: percentage of available width
    # (negative sentinel from apply_decls). width_px == 0: fill available width.
    var node_w = if st.width_px > 0: explicit_node_w else: w
    if st.flex_basis_px > 0 and w > 0:
        node_w = w
    if st.width_px < 0:
        node_w = css_outer_width(nodes[i], st, w * (0 - st.width_px) / 100)
        if node_w < 1:
            node_w = 1
    out_bw[i] = node_w
    if node.tag != "#text" and st.width_px == 0 and st.white_space_nowrap:
        val nowrap_intrinsic = intrinsic_text_width(nodes, styles, child_index, i, out_intrinsic_widths)
        out_intrinsic_widths = nowrap_intrinsic.widths
        if nowrap_intrinsic.width > node_w:
            node_w = nowrap_intrinsic.width
    node_w = constrained_outer_width(node, st, node_w)
    out_bw[i] = node_w
    if node.tag == "#text":
        # white-space:pre/nowrap (st.white_space_nowrap, inherited from e.g. a
        # <pre> code block) preserves the raw text incl. leading indentation;
        # normal flow uses the trimmed text. Measure and paint must agree on which.
        val txt: text = if st.white_space_nowrap: node.text_data else: node.text_trimmed
        val txt_len = if st.white_space_nowrap: node.text_data.len() else: node.text_trimmed.len()
        val cw = style_char_w(st)
        var cpl = node_w / cw
        if cpl < 1:
            cpl = 1
        if st.white_space_nowrap:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        else:
            val ranges = compute_wrap_ranges(txt, cpl)
            out_wrap_starts[i] = ranges.starts
            out_wrap_ends[i] = ranges.ends
        val lines = out_wrap_starts[i].len()
        val h = lines * style_line_h(st)
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if node.tag == "img" or node.tag == "input":
        val explicit_node_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        val h = constrained_outer_height(node, st, if st.height_px > 0: explicit_node_h else: style_line_h(st))
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    val ix = x + st.border_l + st.pad_l
    var iw = node_w - st.pad_l - st.pad_r - border_x
    if iw < 1:
        iw = 1
    val scrollbar_gutter = 15
    val content_height_limit = definite_content_height_limit(node, st)
    if st.display == "flex" and st.flex_direction != "column":
        val children_for_i_count = child_index.child_count[i]
        if st.flex_wrap != "nowrap":
            val row_wrap_column_gap = st.column_gap_px
            val row_wrap_row_gap = st.row_gap_px
            var line_heights: [i32] = [0; children_for_i_count]
            var line_count = 0
            var total_line_h = 0
            var cx_measure = 0
            var line_h_measure = 0
            var child_count_measure = 0
            var fm = child_index.first_child[i]
            while fm >= 0:
                val cst = styles[fm]
                if not cst.position_absolute:
                    val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
                    val resolved_cst = if child_height_px > 0 and child_height_px != cst.height_px:
                        style_with_height(cst, child_height_px)
                    else:
                        cst
                    val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                    val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
                    val base_w_wrap = if cst.flex_basis_px > 0: cst.flex_basis_px else: if cst.width_px > 0: if nodes[fm].has_widget_class or nodes[fm].has_icon_image_class or cst.border_box: cst.width_px else: cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r else: if cst.width_px < 0: iw else: iw
                    val item_outer_w = cml + base_w_wrap + cmr
                    if child_count_measure > 0 and cx_measure + row_wrap_column_gap + item_outer_w > iw:
                        line_heights[line_count] = line_h_measure
                        line_count = line_count + 1
                        total_line_h = total_line_h + line_h_measure
                        cx_measure = 0
                        line_h_measure = 0
                        child_count_measure = 0
                    if child_count_measure > 0:
                        cx_measure = cx_measure + row_wrap_column_gap
                    cx_measure = cx_measure + item_outer_w
                    val used_h = resolved_cst.margin_t + flex_item_outer_height(nodes[fm], resolved_cst) + resolved_cst.margin_b
                    if used_h > line_h_measure:
                        line_h_measure = used_h
                    child_count_measure = child_count_measure + 1
                fm = child_index.next_sibling[fm]
            if child_count_measure > 0:
                line_heights[line_count] = line_h_measure
                line_count = line_count + 1
                total_line_h = total_line_h + line_h_measure
            if line_count > 1:
                total_line_h = total_line_h + row_wrap_row_gap * (line_count - 1)
            val explicit_content_h = if st.height_px > 0:
                if legacy_widget_box or st.border_box: st.height_px - st.pad_t - st.pad_b - border_y else: st.height_px
            else:
                0
            var align_content_offset = 0
            var align_content_gap_extra = 0
            var align_content_line_extra = 0
            var total_line_h_with_align = total_line_h
            if (st.align_content == "center" or st.align_content == "safe-center" or st.align_content == "unsafe-center") and explicit_content_h > total_line_h:
                align_content_offset = (explicit_content_h - total_line_h) / 2
            elif (st.align_content == "flex-end" or st.align_content == "end") and explicit_content_h > total_line_h:
                align_content_offset = explicit_content_h - total_line_h
            elif st.align_content == "space-between" and explicit_content_h > total_line_h and line_count > 1:
                align_content_gap_extra = (explicit_content_h - total_line_h) / (line_count - 1)
            elif st.align_content == "space-around" and explicit_content_h > total_line_h and line_count > 0:
                align_content_offset = (explicit_content_h - total_line_h) / (line_count * 2)
                align_content_gap_extra = (explicit_content_h - total_line_h) / line_count
            elif st.align_content == "space-evenly" and explicit_content_h > total_line_h and line_count > 0:
                align_content_offset = (explicit_content_h - total_line_h) / (line_count + 1)
                align_content_gap_extra = (explicit_content_h - total_line_h) / (line_count + 1)
            elif (st.align_content == "stretch" or st.align_content == "normal") and explicit_content_h > total_line_h and line_count > 0:
                align_content_line_extra = (explicit_content_h - total_line_h) / line_count
                total_line_h_with_align = total_line_h + align_content_line_extra * line_count
            val reverse_wrap = st.flex_wrap == "wrap-reverse"
            var cx_wrap = ix
            var cy_wrap = if reverse_wrap:
                y + st.border_t + st.pad_t + align_content_offset + total_line_h_with_align - (if line_count > 0: line_heights[0] + align_content_line_extra else: 0)
            else:
                animation_end = _css_animation_add_ms_no_wrap(
                    animation_start,
                    _css_animation_active_duration_ms(
                        st.animation_duration_ms.to_i64(), iteration_count
                    )
                )
                if animation_end < 0:
                    animation_end = 0
                if latest_end != -2 and animation_end > latest_end:
                    latest_end = animation_end

            if not paused and current_time_ms >= 0:
                var candidate: i64 = -1
                if matched:
                    candidate = _simple_web_css_animation_instance_next_ms(
                        animation_instances[matched_index], current_time_ms
                    )
                elif current_time_ms < animation_start:
                    candidate = animation_start
                elif infinite:
                    candidate = _css_animation_next_frame_ms(
                        current_time_ms
                    )
                elif current_time_ms < animation_end:
                    candidate = _css_animation_next_frame_ms(
                        current_time_ms
                    )
                    if candidate > animation_end:
                        candidate = animation_end
                if candidate >= 0 and (
                    next_change < 0 or candidate < next_change
                ):
                    next_change = candidate
        style_index = style_index + 1
    _SimpleWebAnimationSchedule(
        animation_end_ms: latest_end,
        animation_next_ms: next_change
    )

pub fn simple_web_layout_animation_end_ms(
    html: text, width: i32
) -> i64:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val registry = _simple_web_extract_keyframes(html)
    if registry.entries.len() == 0:
        return -1
    val frame_index = _simple_web_animation_frame_index(
        styles, nodes, child_index, registry, [], false
    )
    _simple_web_layout_animation_schedule(
        styles, -1, [], frame_index
    ).animation_end_ms

fn _simple_web_fractional_opacity_command_roots(
    nodes: [HNode], styles: [Style], owner_nodes: [i32]
) -> (bool, [i32], i32):
    if nodes.len() != styles.len():
        return (false, [], 0)
    var node_roots: [i32] = [-1; nodes.len()]
    var has_root = false
    var i: i32 = 0
    var first_visible: i32 = -1
    val node_count = nodes.len()
    while i < node_count:
        if _html_draw_ir_visible(nodes, styles, boxes, i):
            if first_visible < 0:
                first_visible = i
            command_count = command_count + 1
        i = i + 1
    if command_count <= 0:
        return []
    val first_command = _html_draw_ir_command(nodes, styles, boxes, first_visible, width, height, vector_fonts)
    var commands: [DrawIrCommand] = [first_command; command_count]
    var out_i = 1
    i = first_visible + 1
    while i < node_count:
        if _html_draw_ir_visible(nodes, styles, boxes, i):
            commands[out_i] = _html_draw_ir_command(nodes, styles, boxes, i, width, height, vector_fonts)
            out_i = out_i + 1
        i = i + 1
    commands

fn _simple_web_fractional_opacity_root_bounded(
    styles: [Style], boxes: LayoutResult, root: i32,
    width: i32, height: i32
) -> bool:
    if root < 0 or root >= styles.len():
        return false
    val st = styles[root]
    val x = boxes.bx[root].to_i64()
    val y = boxes.by[root].to_i64()
    val w = boxes.bw[root].to_i64()
    val h = boxes.bh[root].to_i64()
    (
        st.overflow_hidden and st.outline_w == 0 and
        st.box_shadow_raw == "" and st.box_shadow_color == 0u32 and
        x >= 0 and y >= 0 and w > 0 and h > 0 and
        x + w <= width.to_i64() and y + h <= height.to_i64()
    )

fn _simple_web_draw_ir_css_background(command: DrawIrCommand) -> bool:
    for prop in command.computed_style:  # cpu-lane-loop-ok: scans one command's computed_style list for the css-background image role; bound is that command's property count
        if prop.key == "image-role" and prop.value == "css-background":
            return true
    false

fn _simple_web_draw_ir_translate_command(
    command: DrawIrCommand, dx: i32, dy: i32
) -> DrawIrCommand:
    var translated = command
    translated.x = translated.x + dx
    translated.y = translated.y + dy
    translated.border_rect = draw_ir_rect_translate(
        translated.border_rect, dx, dy
    )
    translated.content_rect = draw_ir_rect_translate(
        translated.content_rect, dx, dy
    )
    translated.hit_rect = draw_ir_rect_translate(
        translated.hit_rect, dx, dy
    )
    translated.clip_rect = draw_ir_rect_translate(
        translated.clip_rect, dx, dy
    )
    translated

fn _simple_web_iframe_fractional_ancestor(
    nodes: [HNode], styles: [Style], node_index: i32
) -> bool:
    var current = node_index
    while current >= 0 and current < styles.len():  # cpu-lane-loop-ok: ancestor walk looking for a fractional-opacity ancestor of an iframe; bound is tree depth, not an element count - flagged by the gate's any-loop-header approximation of the design's bound-based rule
        if styles[current].opacity_pct < 100:
            return true
        current = nodes[current].parent
    false

fn _simple_web_draw_ir_has_material_request(
    composition: DrawIrComposition
) -> bool:
    for batch in composition.batches:  # cpu-lane-loop-ok: batch level of a single linear scan of one admitted iframe child composition; total work is that child composition's size, once per embedded iframe
        for command in batch.commands:  # cpu-lane-loop-ok: command level of the same one-shot material-request scan over an iframe child composition
            for prop in command.computed_style:  # cpu-lane-loop-ok: property level of the same scan; bound is one command's computed_style count and it returns on the first match
                if prop.key == "wm-material-request":
                    return true
    false

fn _simple_web_layout_merge_material_witness(
    witnesses: [SimpleWebLayoutMaterialWitness]
) -> SimpleWebLayoutMaterialWitness:
    var cpu_count = 0
    var solid_count = 0
    var cpu_parts: [text] = []
    var solid_parts: [text] = []
    var cpu_single_hash = ""
    var solid_single_hash = ""
    for witness in witnesses:  # cpu-lane-loop-ok: folds the parent witness plus one witness per embedded iframe; bound is the iframe child count
        if witness.cpu_composited_count > 0:
            cpu_count = cpu_count + witness.cpu_composited_count
            cpu_parts.push("{witness.cpu_composited_count}:{witness.cpu_composited_sha256}")
            cpu_single_hash = witness.cpu_composited_sha256
        if witness.solid_material_count > 0:
            solid_count = solid_count + witness.solid_material_count
            solid_parts.push("{witness.solid_material_count}:{witness.solid_material_sha256}")
            solid_single_hash = witness.solid_material_sha256
    SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_count,
        cpu_composited_sha256: if cpu_parts.len() == 0: "" elif cpu_parts.len() == 1: cpu_single_hash else: sha256_text("v1\n" + cpu_parts.join("\n") + "\n"),
        solid_material_count: solid_count,
        solid_material_sha256: if solid_parts.len() == 0: "" elif solid_parts.len() == 1: solid_single_hash else: sha256_text("v1\n" + solid_parts.join("\n") + "\n")
    )

fn _simple_web_layout_segment_batch(
    source: DrawIrSourceInfo, embedding: DrawIrEmbeddingConfig,
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    opacity_root: i32, opacity_root_count: i32,
    segment_index: i32, commands: [DrawIrCommand]
) -> DrawIrBatch:
    if opacity_root >= 0:
        val bounded = opacity_root_count > 1
        val opacity_embedding = draw_ir_embedding_config(
            "html-opacity-{opacity_root}",
            _html_draw_ir_component_id(nodes[opacity_root], opacity_root),
            if bounded: boxes.bx[opacity_root] else: 0,
            if bounded: boxes.by[opacity_root] else: 0,
            if bounded: boxes.bw[opacity_root] else: embedding.width,
            if bounded: boxes.bh[opacity_root] else: embedding.height,
            0, styles[opacity_root].opacity_pct * 10, true
        )
        return draw_ir_batch_with_source(
            "html-layout-{segment_index}", DRAW_IR_BACKEND_CPU,
            opacity_embedding, commands, source
        )
    draw_ir_batch_with_source(
        "html-layout-{segment_index}", DRAW_IR_BACKEND_CPU,
        embedding, commands, source
    )

fn _simple_web_layout_compose_retained(
    html: text,
    nodes: [HNode],
    rules: Rules,
    child_index: HtmlChildIndex,
    base_styles: [Style],
    styles: [Style],
    raw_boxes: LayoutResult,
    animation_registry: KeyframeRegistry,
    animation_schedule: _SimpleWebAnimationSchedule,
    animation_time_ms: i64,
    animation_property_work_count: i64,
    material_entries: [text],
    material_counts: [i64],
    cpu_material_nodes: [i32],
    solid_material_nodes: [i32],
    width: i32,
    height: i32,
    vector_fonts: bool,
    scroll_y: i32,
    overlay: BrowserTextInputOverlay,
    images: [SimpleOsHostGpuImageResource],
    depth: i32
) -> SimpleWebLayoutDrawIrResult:
    val scrolled = _simple_web_scrolled_layout(
        nodes, styles, raw_boxes, width, height, scroll_y
    )
    val boxes = scrolled.boxes
    val source = draw_ir_source_html_ast(
        "simple_web_html_layout_renderer", "html", "", "", "",
        "layout", "1"
    )
    val embedding = draw_ir_embedding_config(
        "html", "document", 0, 0, width, height, 0, 1000, true
    )
    val input_hit_build = _simple_web_input_text_hit_build(
        nodes, styles, child_index, boxes, width, height, overlay
    )
    val visible_nodes = _html_draw_ir_visible_nodes(
        nodes, styles, boxes, width, height
    )
    val (commands, command_owner_nodes) = _html_draw_ir_commands(
        nodes, styles, boxes, width, height, vector_fonts,
        input_hit_build.target_keys, overlay, visible_nodes, images
    )
    val canvas_color = _web_canvas_background(
        nodes, styles, argb(255, 255, 255)
    )
    val canvas = _html_draw_ir_canvas_command(width, height, canvas_color)
    var batches: [DrawIrBatch] = []
    var child_witnesses: [SimpleWebLayoutMaterialWitness] = []
    val (opacity_found, opacity_command_roots, opacity_root_count) = (
        _simple_web_fractional_opacity_command_roots(
            nodes, styles, command_owner_nodes)
    )
    var opacity_supported = (
        opacity_found and opacity_command_roots.len() == commands.len()
    )
    if opacity_supported and opacity_root_count > 1:
        var admission_index = 0
        var admitted_root = -1
        var surface_pixel_work: i64 = 0
        val viewport_pixel_work = width.to_i64() * height.to_i64()
        var pooled_width = -1
        var pooled_height = -1
        while admission_index < commands.len():  # cpu-lane-loop-ok: opacity-surface admission scan over the emitted commands; bound is the command count and it runs only when more than one opacity root exists
            val root = opacity_command_roots[admission_index]
            if root >= 0 and (
                not _simple_web_fractional_opacity_root_bounded(
                    styles, boxes, root, width, height
                ) or _simple_web_draw_ir_css_background(
                    commands[admission_index]
                )
            ):
                opacity_supported = false
            if root >= 0 and root != admitted_root:
                if pooled_width < 0:
                    pooled_width = boxes.bw[root]
                    pooled_height = boxes.bh[root]
                elif (
                    boxes.bw[root] != pooled_width or
                    boxes.bh[root] != pooled_height
                ):
                    opacity_supported = false
                surface_pixel_work = surface_pixel_work + (
                    boxes.bw[root].to_i64() * boxes.bh[root].to_i64()
                )
                if surface_pixel_work > viewport_pixel_work:
                    opacity_supported = false
                admitted_root = root
            admission_index = admission_index + 1
    # One backwards-free prepass gives each owner a single insertion point.
    # Rechecking the remaining command suffix for every iframe made this path
    # quadratic on pages with many independently painted replaced elements.
    var last_command_index_by_owner: [i32] = [-1; nodes.len()]
    var command_index = 0
    while command_index < command_owner_nodes.len():  # cpu-lane-loop-ok: backwards-free prepass recording each owner's last command index; bound is the command count and it exists precisely to replace a former quadratic suffix rescan (see comment above)
        val owner = command_owner_nodes[command_index]
        if owner >= 0 and owner < last_command_index_by_owner.len():
            last_command_index_by_owner[owner] = command_index
        command_index = command_index + 1
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, width, height
    )
    var run_root = -1
    var run_commands: [DrawIrCommand] = [canvas]
    var segment_index = 0
    command_index = 0
    while command_index < commands.len():  # cpu-lane-loop-ok: the main compose pass: one visit per emitted DrawIR command to cut opacity/iframe batch boundaries; bound is the command count, CPU lane builds DrawIR by design
        val next_root = if opacity_supported:
            opacity_command_roots[command_index]
        else:
            -1
        if next_root != run_root:
            if run_commands.len() > 0:
                batches.push(_simple_web_layout_segment_batch(
                    source, embedding, nodes, styles, boxes, run_root,
                    opacity_root_count, segment_index, run_commands
                ))
                segment_index = segment_index + 1
            run_root = next_root
            run_commands = []
        val command = if run_root >= 0 and opacity_root_count > 1:
            _simple_web_draw_ir_translate_command(
                commands[command_index], 0 - boxes.bx[run_root],
                0 - boxes.by[run_root]
            )
        else:
            commands[command_index]
        run_commands.push(command)
        val owner = command_owner_nodes[command_index]
        if (
            owner >= 0 and owner < nodes.len() and
            nodes[owner].tag == "iframe" and
            last_command_index_by_owner[owner] == command_index
        ):
            val st = styles[owner]
            val content = draw_ir_rect_bounds(
                boxes.bx[owner] + st.border_l + st.pad_l,
                boxes.by[owner] + st.border_t + st.pad_t,
                if boxes.bw[owner] - st.border_l - st.border_r - st.pad_l - st.pad_r > 0: boxes.bw[owner] - st.border_l - st.border_r - st.pad_l - st.pad_r else: 0,
                if boxes.bh[owner] - st.border_t - st.border_b - st.pad_t - st.pad_b > 0: boxes.bh[owner] - st.border_t - st.border_b - st.pad_t - st.pad_b else: 0
            )
            val paint_clip = paint_clip_at(clip_cache, owner)
            val visible = draw_ir_rect_intersection(content,
                draw_ir_rect_bounds(paint_clip.x0, paint_clip.y0,
                    paint_clip.x1 - paint_clip.x0, paint_clip.y1 - paint_clip.y0))
            if visible.width > 0 and visible.height > 0:
                val owner_id = _html_draw_ir_component_id(nodes[owner], owner)
                val placeholder = draw_ir_rect_clipped(
                    "{owner_id}:iframe-placeholder", content.x, content.y,
                    content.width, content.height, WEB_IFRAME_PLACEHOLDER,
                    visible
                )
                val now = rt_time_now_micros()
                if (
                    depth + 1 > WEB_IFRAME_DEPTH_CAP or
                    now >= _web_render_deadline_us or
                    _simple_web_iframe_fractional_ancestor(nodes, styles, owner)
                ):
                    if run_root >= 0 and opacity_root_count > 1:
                        run_commands.push(_simple_web_draw_ir_translate_command(
                            placeholder, 0 - boxes.bx[run_root],
                            0 - boxes.by[run_root]
                        ))
                    else:
                        run_commands.push(placeholder)
                else:
                    val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
                    val child_styles = if child_height_px > 0 and child_height_px != cst.height_px:
                        styles_with_height(styles, fc_wrap, child_height_px)
                    else:
                        # An admitted child is the only case that needs a new
                        # flat batch boundary. Denials stay in this group.
                        batches.push(_simple_web_layout_segment_batch(
                            source, embedding, nodes, styles, boxes, run_root,
                            opacity_root_count, segment_index, run_commands
                        ))
                        segment_index = segment_index + 1
                        run_commands = []
                        val embedded = draw_ir_embed_composition(
                            child.composition, content.x, content.y,
                            visible, "{owner_id}:iframe:{depth + 1}",
                            owner_id, 0
                        )
                        for batch in embedded:  # cpu-lane-loop-ok: appends the batches produced by one embedded iframe composition; bound is that child's batch count
                            batches.push(batch)
                        child_witnesses.push(child.material_witness)
        command_index = command_index + 1
    if run_commands.len() > 0:
        batches.push(_simple_web_layout_segment_batch(
            source, embedding, nodes, styles, boxes, run_root,
            opacity_root_count, segment_index, run_commands
        ))
    val composition = draw_ir_composition(
        "html-layout", "simple-web-html-layout", DRAW_IR_BACKEND_CPU, batches
    )
    val parent_material_witness = _simple_web_visible_material_witness(
        material_entries, cpu_material_nodes, solid_material_nodes,
        visible_nodes
    )
    val material_witness = _simple_web_layout_merge_material_witness(
        [parent_material_witness] + child_witnesses
    )
    SimpleWebLayoutDrawIrResult(
        composition: composition,
        render_degraded: simple_web_layout_last_render_degraded(),
        degrade_reason: simple_web_layout_last_render_degrade_reason(),
        material_fallback: simple_web_layout_material_provenance_after_execution(
            material_witness, 0, 1, 1, 0
        ),
        material_witness: material_witness,
        animation_end_ms: animation_schedule.animation_end_ms,
        animation_next_ms: animation_schedule.animation_next_ms,
        animation_property_work_count: animation_property_work_count,
        hit_index: SimpleWebLayoutHitIndex(
            nodes: nodes,
            styles: styles,
            child_index: child_index,
            boxes: boxes,
            width: width,
            height: height,
            input_text_hits: input_hit_build.hits
        ),
        resolved_input_view_start_byte:
            input_hit_build.resolved_view_start_byte,
        resolved_scroll_y: scrolled.resolved_scroll_y,
        max_scroll_y: scrolled.max_scroll_y,
        document_html: html,
        rules: rules,
        base_styles: base_styles,
        raw_boxes: raw_boxes,
        animation_registry: animation_registry,
        material_entries: material_entries,
        material_counts: material_counts,
        cpu_material_nodes: cpu_material_nodes,
        solid_material_nodes: solid_material_nodes
    )

# Comparability gate for the Draw IR display list, the exact analogue of
# `simple_web_layout_software_pixels_presentable` for the pixel oracle: a
# composition truncated by budget exhaustion is NOT a display list of the page
# and must never be compared against another engine's artifact as though it
# were. Callers that diff, gate, or capture evidence from a composition test
# this first; a false answer means "these are whatever commands got emitted
# before the clock ran out", not "the page has no elements".
pub fn simple_web_layout_draw_ir_comparable(
    result: SimpleWebLayoutDrawIrResult
) -> bool:
    not result.render_degraded

fn build_ancestor_clip_cache(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], fbw: i32, fbh: i32) -> PaintClipCache:
    val default_clip = ClipRect(x0: 0, y0: 0, x1: fbw, y1: fbh)
    if not has_visible_overflow_clip(styles):
        return PaintClipCache(has_node_clips: false, default_clip: default_clip, clips: [])
    val node_count = nodes.len()
    var clips: [ClipRect] = [default_clip; node_count]
    var i = 0
    while i < node_count:
        var clip = default_clip
        val p = nodes[i].parent
        if p >= 0:
            clip = clips[p]
            val pst = styles[p]
            if pst.overflow_hidden and pst.display != "none":
                val cx0 = bx[p] + pst.border_l
                val cy0 = by[p] + pst.border_t
                val cx1 = bx[p] + bw[p] - pst.border_r
                val cy1 = by[p] + bh[p] - pst.border_b
                clip = clip_intersect(clip, cx0, cy0, cx1, cy1)
        clips[i] = clip
        i = i + 1
    PaintClipCache(has_node_clips: true, default_clip: default_clip, clips: clips)

fn _simple_web_layout_compose_document(
    html: text, width: i32, height: i32, vector_fonts: bool,
    animation_time_ms: i64, scroll_y: i32,
    overlay: BrowserTextInputOverlay,
    animation_instances: [BrowserCssAnimationInstance],
    images: [SimpleOsHostGpuImageResource],
    extra_rules: Rules, depth: i32, deadline_us: i64
) -> SimpleWebLayoutDrawIrResult:
    val render_start_us = rt_time_now_micros()
    val _phase_on = _web_phase_trace_enabled()
    if deadline_us > 0:
        _web_render_deadline_us = deadline_us
    val budget_us = if _web_render_deadline_us > render_start_us:
        _web_render_deadline_us - render_start_us
    else:
        1
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(nodes, styles, child_index, 0, 0, 0, cw, ch, zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), empty_starts, empty_ends, neg_one_i32_list(node_count))
    val white = argb(255, 255, 255)
    val base = _web_canvas_background(nodes, styles, white)
    var fb = browser_layout_framebuffer_filled(base, cw, ch)
    val wrap_cache = TextWrapCache(starts: boxes.wrap_starts, ends: boxes.wrap_ends)
    var painted = paint(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, wrap_cache, fb, cw, ch, false)
    painted = _web_paint_iframes(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, rules, painted, cw, ch, depth)
    painted

# Blit every iframe's rendered child document over its content box. `parent_rules`
# is the current document's rule set, forwarded to "shared" children. `depth` is
# the current document's depth; a child at depth+1 beyond the cap is replaced by
# a flat placeholder and never recursed into.
fn _web_paint_iframes(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], parent_rules: Rules, fb: [u32], fbw: i32, fbh: i32, depth: i32) -> [u32]:
    var out = fb
    val node_count = nodes.len() as i32
    var i = 0
    while i < node_count:
        val nd = nodes[i]
        if nd.tag == "iframe":
            val st = styles[i]
            val hidden = st.display == "none" or st.visibility_hidden or content_hidden_by_ancestor(nodes, styles, i)
            if not hidden:
                val cx = bx[i] + st.border_l + st.pad_l
                val cy = by[i] + st.border_t + st.pad_t
                val cw = bw[i] - st.border_l - st.border_r - st.pad_l - st.pad_r
                val ch = bh[i] - st.border_t - st.border_b - st.pad_t - st.pad_b
                if cw > 0 and ch > 0 and cx < fbw and cy < fbh:
                    if depth + 1 > WEB_IFRAME_DEPTH_CAP:
                        out = fb_rect(out, fbw, fbh, cx, cy, cw, ch, WEB_IFRAME_PLACEHOLDER)
                    else:
                        val child_html = _web_iframe_child_html(nd)
                        val shared = attr_value(nd.attrs_raw, "space").trim().lower() == "shared"
                        val extra = if shared: parent_rules else: _web_empty_rules()
                        # Give the child at most HALF the parent's remaining budget
                        # so a heavy child cannot stall the parent render.
                        val save_deadline = _web_render_deadline_us
                        val now = rt_time_now_unix_micros()
                        if _web_render_deadline_us > now:
                            _web_render_deadline_us = now + (_web_render_deadline_us - now) / 2
                        val child_px = _web_render_child_pixels(child_html, cw, ch, extra, depth + 1)
                        _web_render_deadline_us = save_deadline
                        if child_px.len() == cw * ch:
                            out = _web_blit_child(out, fbw, fbh, cx, cy, cw, ch, child_px)
        i = i + 1
    out

fn _simple_web_layout_render_html_draw_ir(html: text, width: i32, height: i32, vector_fonts: bool) -> DrawIrComposition:
    val render_start_us = rt_time_now_unix_micros()
    val env_override = _web_render_budget_ms_env_override()
    val area_floor_ms = (width as i64) * (height as i64) / 16
    val default_budget_ms = if area_floor_ms > WEB_RENDER_BUDGET_MS: area_floor_ms else: WEB_RENDER_BUDGET_MS
    val resolved_budget_ms = if env_override > 0: env_override else: default_budget_ms
    _web_budget_begin(resolved_budget_ms)
    val budget_us = resolved_budget_ms * 1000
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width)
    val child_index = build_child_index(nodes)
    _web_budget_rearm(render_start_us + budget_us * 7 / 10)
    val styles = compute_styles(nodes, rules, child_index, false, vector_fonts)
    _web_budget_rearm(render_start_us + budget_us * 9 / 10)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        0,
        0,
        0,
        width,
        height,
        [0; nodes.len()],
        [0; nodes.len()],
        [0; nodes.len()],
        [0; nodes.len()]
    )
    val source = draw_ir_source_html_ast("simple_web_html_layout_renderer", "html", "", "", "", "layout", "1")
    val embedding = draw_ir_embedding_config("html", "document", 0, 0, width, height, 0, 1000, true)
    var commands = _html_draw_ir_commands(nodes, styles, boxes, width, height, vector_fonts)
    val canvas_color = _web_canvas_background(nodes, styles, argb(255, 255, 255))
    commands = [_html_draw_ir_canvas_command(width, height, canvas_color)] + commands
    val batch = draw_ir_batch_with_source("html-layout", DRAW_IR_BACKEND_CPU, embedding, commands, source)
    val batches = [batch]
    val composition = draw_ir_composition("html-layout", "simple-web-html-layout", DRAW_IR_BACKEND_CPU, batches)
    composition

pub class SimpleWebRetainedLayoutPreparation:
    html: text
    nodes: [HNode]
    rules: Rules
    child_index: HtmlChildIndex
    base_styles: [Style]
    styles: [Style]
    animation_registry: KeyframeRegistry
    animation_schedule: _SimpleWebAnimationSchedule
    animation_time_ms: i64
    animation_property_work_count: i64
    material_entries: [text]
    material_counts: [i64]
    cpu_material_nodes: [i32]
    solid_material_nodes: [i32]
    width: i32
    height: i32
    vector_fonts: bool
    scroll_y: i32
    overlay: BrowserTextInputOverlay
    images: [SimpleOsHostGpuImageResource]

pub fn simple_web_layout_prepare_retained(
    html: text, width: i32, height: i32, vector_fonts: bool,
    animation_time_ms: i64, scroll_y: i32,
    overlay: BrowserTextInputOverlay,
    animation_instances: [BrowserCssAnimationInstance],
    images: [SimpleOsHostGpuImageResource]
) -> SimpleWebRetainedLayoutPreparation:
    val env_override = _web_render_budget_ms_env_override()
    val area_floor_ms = (width as i64) * (height as i64) / 16
    val default_budget_ms = if area_floor_ms > WEB_RENDER_BUDGET_MS: area_floor_ms else: WEB_RENDER_BUDGET_MS
    _web_budget_begin(if env_override > 0: env_override else: default_budget_ms)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    var material_entries: [text] = ["", ""]
    var material_counts: [i64] = [0, 0]
    var cpu_material_nodes: [i32] = []
    var solid_material_nodes: [i32] = []
    val base_styles = compute_styles_with_material(
        nodes, rules, child_index, false, vector_fonts,
        material_entries, material_counts,
        cpu_material_nodes, solid_material_nodes
    )
    var styles = base_styles
    val animation_registry = _simple_web_extract_keyframes(html)
    var animation_schedule = _SimpleWebAnimationSchedule(
        animation_end_ms: -1, animation_next_ms: -1
    )
    var animation_property_work_count: i64 = 0
    if animation_registry.entries.len() > 0:
        val animation_frame_index = _simple_web_animation_frame_index(
            styles, nodes, child_index, animation_registry,
            animation_instances, false
        )
        animation_schedule = _simple_web_layout_animation_schedule(
            styles, animation_time_ms, animation_instances,
            animation_frame_index
        )
        if animation_time_ms >= 0:
            val animation_apply = _apply_css_animations(
                nodes, styles, animation_registry, animation_time_ms,
                animation_instances, animation_frame_index
            )
            styles = animation_apply.styles
            animation_property_work_count = animation_apply.property_work_count
    styles = simple_web_resolve_collapsed_table_borders(
        nodes, child_index, styles
    )
    SimpleWebRetainedLayoutPreparation(
        html: html, nodes: nodes, rules: rules, child_index: child_index,
        base_styles: base_styles, styles: styles,
        animation_registry: animation_registry,
        animation_schedule: animation_schedule,
        animation_time_ms: animation_time_ms,
        animation_property_work_count: animation_property_work_count,
        material_entries: material_entries, material_counts: material_counts,
        cpu_material_nodes: cpu_material_nodes,
        solid_material_nodes: solid_material_nodes,
        width: width, height: height, vector_fonts: vector_fonts,
        scroll_y: scroll_y, overlay: overlay, images: images
    )

pub fn simple_web_layout_empty_retained() -> LayoutResult:
    LayoutResult(
        bx: [], by: [], bw: [], bh: [], wrap_starts: [], wrap_ends: [],
        intrinsic_widths: [], height: 0
    )

pub fn simple_web_layout_compose_prepared(
    prepared: SimpleWebRetainedLayoutPreparation,
    raw_boxes: LayoutResult
) -> SimpleWebLayoutDrawIrResult:
    _simple_web_layout_compose_retained(
        prepared.html, prepared.nodes, prepared.rules, prepared.child_index,
        prepared.base_styles, prepared.styles, raw_boxes,
        prepared.animation_registry, prepared.animation_schedule,
        prepared.animation_time_ms,
        prepared.animation_property_work_count,
        prepared.material_entries, prepared.material_counts,
        prepared.cpu_material_nodes, prepared.solid_material_nodes,
        prepared.width, prepared.height, prepared.vector_fonts,
        prepared.scroll_y, prepared.overlay, prepared.images, 0
    )

fn _simple_web_layout_render_html_draw_ir_result_at_time(
    html: text, width: i32, height: i32, vector_fonts: bool,
    animation_time_ms: i64, scroll_y: i32,
    overlay: BrowserTextInputOverlay,
    animation_instances: [BrowserCssAnimationInstance],
    images: [SimpleOsHostGpuImageResource]
) -> SimpleWebLayoutDrawIrResult:
    val env_override = _web_render_budget_ms_env_override()
    val area_floor_ms = (width as i64) * (height as i64) / 16
    val default_budget_ms = if area_floor_ms > WEB_RENDER_BUDGET_MS: area_floor_ms else: WEB_RENDER_BUDGET_MS
    val resolved_budget_ms = if env_override > 0: env_override else: default_budget_ms
    _web_budget_begin(resolved_budget_ms)
    _simple_web_layout_compose_document(
        html, width, height, vector_fonts, animation_time_ms, scroll_y,
        overlay, animation_instances, images, _web_empty_rules(), 0,
        _web_render_deadline_us
    )

fn _simple_web_layout_render_html_draw_ir_result(html: text, width: i32, height: i32, vector_fonts: bool) -> SimpleWebLayoutDrawIrResult:
    _simple_web_layout_render_html_draw_ir_result_at_time(
        html, width, height, vector_fonts, -1, 0,
        browser_text_input_overlay_empty(), [], []
    )

pub fn simple_web_layout_animation_needs_layout(
    prior: SimpleWebLayoutDrawIrResult
) -> bool:
    var registry_index_by_name: Dict<text, i32> = {}
    var registry_index = 0
    while registry_index < prior.animation_registry.entries.len():  # cpu-lane-loop-ok: builds the keyframe-name to index dict; bound is the declared @keyframes count
        registry_index_by_name[
            prior.animation_registry.entries[registry_index].name
        ] = registry_index
        registry_index = registry_index + 1
    var active_entries = [false; prior.animation_registry.entries.len()]
    for style in prior.base_styles:  # cpu-lane-loop-ok: marks which @keyframes entries any base style actually activates; bound is the base style count, once per needs-layout decision
        if style.animation_name != "none" and style.animation_duration_ms > 0:
            val active_index = (
                registry_index_by_name.get(style.animation_name) ?? -1
            )
            if active_index >= 0:
                active_entries[active_index] = true
    registry_index = 0
    for entry in prior.animation_registry.entries:  # cpu-lane-loop-ok: per-@keyframes-entry scan deciding whether any animated property forces layout; bound is the declared @keyframes count
        if not active_entries[registry_index]:
            registry_index = registry_index + 1
            continue
        for frame in entry.frames:  # cpu-lane-loop-ok: per-keyframe scan inside one active @keyframes entry; bound is that entry's declared keyframes
            for declaration in frame.properties:  # cpu-lane-loop-ok: per-declaration scan inside one keyframe; bound is that keyframe's declared properties and it returns on the first layout-affecting property
                val property = declaration.property.trim().lower()
                if (
                    property != "background-color" and
                    property != "color" and property != "opacity"
                ):
                    return true
        registry_index = registry_index + 1
    false

pub fn simple_web_layout_rerender_retained(
    prior: SimpleWebLayoutDrawIrResult,
    dirty_stage: text,
    width: i32,
    height: i32,
    animation_time_ms: i64,
    scroll_y: i32,
    overlay: BrowserTextInputOverlay,
    animation_instances: [BrowserCssAnimationInstance],
    images: [SimpleOsHostGpuImageResource]
) -> SimpleWebLayoutDrawIrResult:
    val nodes = prior.hit_index.nodes
    val child_index = prior.hit_index.child_index
    var rules = prior.rules
    var base_styles = prior.base_styles
    var material_entries = prior.material_entries
    var material_counts = prior.material_counts
    var cpu_material_nodes = prior.cpu_material_nodes
    var solid_material_nodes = prior.solid_material_nodes
    if dirty_stage == "css":
        rules = extract_css_vw(prior.document_html, width, false)
        material_entries = ["", ""]
        material_counts = [0, 0]
        cpu_material_nodes = []
        solid_material_nodes = []
        base_styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )

    var styles = if dirty_stage == "paint":
        prior.hit_index.styles
    else:
        base_styles
    var animation_schedule = _SimpleWebAnimationSchedule(
        animation_end_ms: prior.animation_end_ms,
        animation_next_ms: prior.animation_next_ms
    )
    # This diagnostic is frame-local. Retained paint-only frames do not apply
    # animation declarations and therefore must not inherit a prior frame's
    # work count.
    var animation_property_work_count: i64 = 0
    if dirty_stage != "paint" and prior.animation_registry.entries.len() > 0:
        val animation_frame_index = _simple_web_animation_frame_index(
            styles, nodes, child_index, prior.animation_registry,
            animation_instances, false
        )
        animation_schedule = _simple_web_layout_animation_schedule(
            styles, animation_time_ms, animation_instances,
            animation_frame_index
        )
        if animation_time_ms >= 0:
            val animation_apply = _apply_css_animations(
                nodes, styles, prior.animation_registry, animation_time_ms,
                animation_instances, animation_frame_index
            )
            styles = animation_apply.styles
            animation_property_work_count = (
                animation_apply.property_work_count
            )
    if dirty_stage != "paint":
        styles = simple_web_resolve_collapsed_table_borders(
            nodes, child_index, styles
        )

    var raw_boxes = prior.raw_boxes
    if dirty_stage != "paint" and dirty_stage != "animation-paint":
        val node_count = nodes.len() as i32
        raw_boxes = layout(
            nodes, styles, child_index, 0, 0, 0, width, height,
            zero_i32_list(node_count), zero_i32_list(node_count),
            zero_i32_list(node_count), zero_i32_list(node_count),
            empty_i32_lists(node_count), empty_i32_lists(node_count),
            neg_one_i32_list(node_count)
        )
    _simple_web_layout_compose_retained(
        prior.document_html, nodes, rules, child_index, base_styles, styles,
        raw_boxes, prior.animation_registry, animation_schedule,
        animation_time_ms,
        animation_property_work_count,
        material_entries, material_counts, cpu_material_nodes,
        solid_material_nodes, width, height, true, scroll_y, overlay, images, 0
    )

