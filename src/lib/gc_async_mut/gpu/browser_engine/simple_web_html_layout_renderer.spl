# simple_web_html_layout_renderer.spl — a small but REAL HTML renderer in pure
# Simple, ported from examples/06_io/ui/mini_html_render.spl for the production web
# rendering path.
#
# Parses HTML into a flat node arena (avoiding the interpreter's nested-field
# push bug), applies inline + <style>-block CSS, does block-flow layout with
# word-wrapped text, and paints boxes + text into a staging [u32] framebuffer
# using a tiny 5x7 bitmap font. Engine2D presentation lives in a separate shim
# so Draw IR and software layout stay free of the GPU backend closure.
#
# Two interpreter bugs are worked around here (both worth a seed fix):
#   * text.index_of(needle, pos) IGNORES pos -> use find_from() (substring+find).
#   * obj.field.push() on an array element does not persist -> use a flat arena
#     of nodes keyed by integer parent index; only ever append to the top array.
#
# Public entry: simple_web_layout_render_html_software_pixels(html, w, h)
#   parse -> CSS cascade -> block layout -> paint text+boxes -> [u32]

use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    DrawIrCommand,
    DrawIrComposition,
    DrawIrStyleProp,
    draw_ir_batch_with_source,
    draw_ir_box_with_style,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_rect_bounds,
    draw_ir_source_html_ast,
    draw_ir_style_prop
}
use common.render_scene.scene.{SceneCommand, scene_fill_rect}
use common.ui.web_render_api.{WebRenderMaterialFallbackProvenance}
use std.common.gpu.simpleos_host_gpu_draw_ir.{SimpleOsHostGpuImageResource}
use std.common.crypto.sha256.{sha256_text}
use std.common.color.types.{from_rgba}
use std.common.animation.timing.{
    TimingFunction, evaluate_timing, parse_timing_function
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles.{tile_paint_flag_enabled}
use std.gc_async_mut.gpu.browser_engine.style_block_parse.{extract_keyframes, KeyframeRegistry}
use std.gc_async_mut.gpu.browser_engine.style.animation.{
    BrowserCssAnimationInstance, CSSDeclaration, CSSValue,
    animation_css_value_text, sample_keyframes_with_underlying,
    browser_css_animation_capacity_available
}
use common.render_scene.scene.{SceneCommand, scene_fill_rect}
use common.ui.web_render_api.{WebRenderMaterialFallbackProvenance}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.text_layout.font_renderer.{resolve_font_metrics_with_language}
use std.nogc_async_mut.gpu.engine2d.simd_kernels.{engine2d_simd_fill_rows_u32, blit_rect}

# ---------------------------------------------------------------------------
# Render budget + CSS quotas (hostile-page hardening)
# ---------------------------------------------------------------------------
# A hostile or pathological page (a huge <style>, thousands of rules matching a
# single node, a giant DOM) can drive the O(rules) cascade or the O(nodes) paint
# loops for minutes. These guards degrade GRACEFULLY: on wall-clock budget expiry
# the current phase stops at a loop boundary and whatever has been resolved or
# painted so far is returned (never a panic, never an empty buffer — the
# framebuffer is always allocated at width*height before paint). CSS quotas
# silently drop over-limit rules/declarations so the first, load-bearing rules
# still win.
extern fn rt_time_now_unix_micros() -> i64

# Default wall-clock budget for one software render, in milliseconds. Sized
# for AOT/JIT-compiled execution. Under `bin/simple run` (tree-walking
# interpreter), parse_html/compute_styles/layout for even a small document
# (see doc header) routinely exceed this, so `_web_budget_expired()` (below)
# trips mid-paint and only the canvas-background command survives — a
# uniform-fill frame that still reports nonzero/varied-looking pixel stats
# at the framebuffer level but has no real content. This is NOT scaled up
# here by default (that would silently hide the interpreter-perf gap for
# every caller, including compiled ones close to the edge of their own
# budget). Interpreted-mode callers that need real content — showcase
# evidence capture, manual debugging via `bin/simple run` — must opt in via
# SIMPLE_WEB_RENDER_BUDGET_MS (see _web_render_budget_ms_env_override below).
# The interpreter-vs-budget gap itself is a perf defect, tracked separately
# from this render-budget mechanism; do not paper over it by raising this
# default.
val WEB_RENDER_BUDGET_MS: i64 = 10000

# Optional override for WEB_RENDER_BUDGET_MS, read from the environment at the
# start of every render so long/headless probes can raise the budget without
# threading an explicit i64 arg through the public entry points (an explicit
# i64 default-arg on those entry points has a known seed-interpreter bug that
# whites out painted backgrounds — see
# doc/08_tracking/bug/seed_interp_explicit_i64_default_arg_poisons_render_backgrounds_2026-07-11.md).
# Unset or non-numeric -> falls back to WEB_RENDER_BUDGET_MS / the caller's
# explicit budget_ms as before.
fn _web_render_budget_ms_env_override() -> i64:
    val raw = env_get("SIMPLE_WEB_RENDER_BUDGET_MS") ?? ""
    if raw == "":
        return 0
    val n = raw.trim().to_i64()
    if n == nil or n <= 0:
        return 0
    n
# Cap on the number of style rules the cascade will apply per node; rules beyond
# this index (CSS source order) are skipped so the first rules keep their effect.
val WEB_STYLE_RULE_QUOTA: i32 = 4096
# Cap on declarations processed for a single rule; a rule with more is skipped.
val WEB_RULE_DECL_QUOTA: i32 = 256
# Maximum embedding depth for iframe rendering-inside-rendering. The top document
# is depth 0; each nested iframe child renders one level deeper. A child whose
# depth would EXCEED this cap is not recursed into — its content box is filled
# with a flat placeholder instead — so a page that embeds itself (or a cycle)
# can never drive unbounded recursion.
val WEB_IFRAME_DEPTH_CAP: i32 = 3
# Placeholder fill painted in place of an iframe whose child would exceed the
# depth cap (opaque grey).
val WEB_IFRAME_PLACEHOLDER: u32 = 0xFF888888u32

# Per-render mutable state (reset at the start of every public render entry).
var _web_render_deadline_us: i64 = 0
var _web_render_degraded: bool = false

# True iff the most recent render tripped its wall-clock budget (a phase stopped
# early). Quota drops do NOT set this — they are silent by design.
pub fn simple_web_layout_last_render_degraded() -> bool:
    _web_render_degraded

# Arm the budget for a fresh render: record the deadline and clear the flag.
# A budget_ms that is <= 0, or that is still the module default (i.e. the
# caller went through the public entry point's default arg rather than
# passing an explicit override), is subject to the SIMPLE_WEB_RENDER_BUDGET_MS
# env override; an explicit non-default budget_ms from the caller always wins.
fn _web_budget_begin(budget_ms: i64):
    val env_override = _web_render_budget_ms_env_override()
    val ms = if budget_ms <= 0 or budget_ms == WEB_RENDER_BUDGET_MS:
        if env_override > 0: env_override else: WEB_RENDER_BUDGET_MS
    else:
        budget_ms
    _web_render_deadline_us = rt_time_now_unix_micros() + ms * 1000
    _web_render_degraded = false

# Re-arm the deadline mid-render to hand the NEXT stage its own slice of the
# total budget, without ever extending the overall wall-clock past whatever
# the caller originally granted. Used to stage-partition a single budget_ms
# across style -> layout -> paint so an early stage exhausting its slice does
# not zero out every later stage (see simple_web_layout_render_html_software_pixels).
# A stage that already tripped the deadline stays expired: rearming only ever
# raises the deadline to a point <= the original total, so if the previous
# absolute deadline was already in the past, moving it later just grants the
# next stage its fresh slice; it never un-expires a stage's own past work.
fn _web_budget_rearm(deadline_us: i64):
    if _web_render_deadline_us > 0:
        _web_render_deadline_us = deadline_us

# True once the wall-clock deadline has passed; latches the degraded flag so
# callers can report the render as degraded. A deadline of 0 means "not armed"
# (guards are inert), so any code path that never called _web_budget_begin runs
# unbounded exactly as before.
fn _web_budget_expired() -> bool:
    if _web_render_deadline_us <= 0:
        return false
    if rt_time_now_unix_micros() > _web_render_deadline_us:
        _web_render_degraded = true
        return true
    false

# ---------------------------------------------------------------------------
# Flat node arena
# ---------------------------------------------------------------------------

class HNode:
    tag: text          # lowercased tag, "#text", or "#root"
    text_data: text    # text for #text nodes
    text_trimmed: text
    style_attr: text   # raw style="" value
    class_attr: text
    class_words: [text]
    has_widget_class: bool
    has_icon_image_class: bool
    has_widget_panel_class: bool
    has_widget_button_class: bool
    has_widget_image_class: bool
    has_focused_class: bool
    id_attr: text
    attrs_raw: text    # raw tag inner text for attribute selectors
    parent: i64        # index of parent in the arena (-1 for root)

class HtmlChildIndex:
    first_child: [i32]
    next_sibling: [i32]
    child_count: [i32]

class SelectorContext:
    child_index: HtmlChildIndex
    element_position: [i32]
    element_sibling_count: [i32]
    has_content_child: [bool]

class ClassFlags:
    has_widget_class: bool
    has_icon_image_class: bool
    has_widget_panel_class: bool
    has_widget_button_class: bool
    has_widget_image_class: bool
    has_focused_class: bool

fn mk_node(tag: text, parent: i64) -> HNode:
    HNode(tag: tag, text_data: "", text_trimmed: "", style_attr: "", class_attr: "", class_words: [], has_widget_class: false, has_icon_image_class: false, has_widget_panel_class: false, has_widget_button_class: false, has_widget_image_class: false, has_focused_class: false, id_attr: "", attrs_raw: "", parent: parent)

fn build_child_index(nodes: [HNode]) -> HtmlChildIndex:
    val node_count = nodes.len()
    var first_child: [i32] = [-1; node_count]
    var last_child: [i32] = [-1; node_count]
    var next_sibling: [i32] = [-1; node_count]
    var child_count: [i32] = [0; node_count]
    var i = 0
    while i < node_count:
        val parent = nodes[i].parent
        if parent >= 0 and parent < node_count:
            if first_child[parent] < 0:
                first_child[parent] = i
            else:
                next_sibling[last_child[parent]] = i
            last_child[parent] = i
            child_count[parent] = child_count[parent] + 1
        i = i + 1
    HtmlChildIndex(first_child: first_child, next_sibling: next_sibling, child_count: child_count)

fn build_selector_context(nodes: [HNode], child_index: HtmlChildIndex) -> SelectorContext:
    val node_count = nodes.len()
    var element_position: [i32] = [1; node_count]
    var element_sibling_count: [i32] = [1; node_count]
    var has_content_child: [bool] = [false; node_count]
    var parent = 0
    while parent < node_count:
        var element_count = 0
        var child = child_index.first_child[parent]
        while child >= 0:
            val nd = nodes[child]
            if nd.tag == "#text":
                if nd.text_trimmed.len() > 0:
                    has_content_child[parent] = true
            else:
                has_content_child[parent] = true
                element_count = element_count + 1
                element_position[child] = element_count
            child = child_index.next_sibling[child]
        child = child_index.first_child[parent]
        while child >= 0:
            if nodes[child].tag != "#text":
                element_sibling_count[child] = element_count
            child = child_index.next_sibling[child]
        parent = parent + 1
    SelectorContext(child_index: child_index, element_position: element_position, element_sibling_count: element_sibling_count, has_content_child: has_content_child)

# ---------------------------------------------------------------------------
# Position-aware string find (works around index_of(needle,pos) ignoring pos)
# ---------------------------------------------------------------------------

fn text_index_of(haystack: text, needle: text) -> i32:
    find_from(haystack, needle, 0)

fn text_matches_at(haystack: text, needle: text, offset: i32) -> bool:
    val needle_len = needle.len()
    if offset < 0 or offset + needle_len > haystack.len():
        return false
    var j = 0
    while j < needle_len:
        if haystack.char_at(offset + j) != needle.char_at(j):
            return false
        j = j + 1
    true

fn find_from(s: text, needle: text, pos: i32) -> i32:
    if needle.len() == 0:
        return if pos < 0: 0 else: pos
    if s.len() < needle.len():
        return -1
    val limit = slen - nlen
    var i = start
    while i <= limit:
        if text_matches_at(s, needle, i):
            return i
        i = i + 1
    -1

fn attr_key_index(inner: text, key: text, key_len: i32) -> i32:
    if key_len == 0:
        return 0
    val inner_len = inner.len()
    if inner_len < key_len:
        return -1
    val first = key.char_at(0)
    val limit = inner_len - key_len
    var i = 0
    # Quote-aware scan: a key substring that lands INSIDE a quoted attribute
    # value is not a real attribute. This matters for values that embed markup —
    # e.g. an <iframe srcdoc="...div style='height:10px'..."> must not have its
    # own `style=`/`width=`/`height=` read from inside the srcdoc value.
    var quote = ""
    while i <= limit:
        val ci = inner.char_at(i)
        if quote != "":
            if ci == quote:
                quote = ""
            i = i + 1
            continue
        if ci == "\"" or ci == "'":
            quote = ci
            i = i + 1
            continue
        if ci == first:
            # Left word-boundary guard: a candidate match is only a real
            # attribute when it starts the inner text or follows ASCII
            # whitespace. Without this, a longer attribute name ending with
            # the key falsely matches — `align=` inside `valign=`, `bgcolor=`
            # inside `data-bgcolor=`, `width=` inside `data-width=`.
            var at_token_start = i == 0
            if not at_token_start:
                val prev = inner.char_at(i - 1)
                at_token_start = prev == " " or prev == "\t" or prev == "\n" or prev == "\r"
            if at_token_start:
                var j = 1
                var matched = true
                while j < key_len:
                    if inner.char_at(i + j) != key.char_at(j):
                        matched = false
                        break
                    j = j + 1
                if matched:
                    return i
        i = i + 1
    -1

fn is_void(tag: text) -> bool:
    tag == "meta" or tag == "br" or tag == "img" or tag == "input" or tag == "link" or tag == "hr" or tag == "area" or tag == "base" or tag == "col" or tag == "embed" or tag == "source" or tag == "track" or tag == "wbr"

# ---------------------------------------------------------------------------
# Attribute extraction (reads class/id/style out of the raw tag inner text)
# ---------------------------------------------------------------------------

fn attr_value(inner: text, name: text) -> text:
    # find name= and read the quoted value; simple, tolerant
    val key = name + "="
    attr_value_by_key(inner, key)

fn attr_value_by_key(inner: text, key: text) -> text:
    val key_len = key.len()
    val kpos = attr_key_index(inner, key, key_len)
    if kpos < 0:
        return ""
    var i = kpos + key_len
    if i >= inner.len():
        return ""
    val q = inner.char_at(i)
    if q == "\"" or q == "'":
        val end = find_from(inner, q, i + 1)
        if end < 0:
            return ""
        return decode_html_entities(inner.substring(i + 1, end))
    # unquoted: read to whitespace
    var j = i
    val inner_len = inner.len()
    while j < inner_len:
        val c = inner.char_at(j)
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "/":
            break
        j = j + 1
    decode_html_entities(inner.substring(i, j))

fn html_ascii_is_upper(c: text) -> bool:
    c == "A" or c == "B" or c == "C" or c == "D" or c == "E" or c == "F" or c == "G" or
    c == "H" or c == "I" or c == "J" or c == "K" or c == "L" or c == "M" or c == "N" or
    c == "O" or c == "P" or c == "Q" or c == "R" or c == "S" or c == "T" or c == "U" or
    c == "V" or c == "W" or c == "X" or c == "Y" or c == "Z"

fn tag_name_of(inner: text) -> text:
    var j = 0
    val m = inner.len()
    var has_upper = false
    while j < m:
        val c = inner.char_at(j)
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "/":
            break
        if html_ascii_is_upper(c):
            has_upper = true
        j = j + 1
    val nm = inner.substring(0, j)
    if has_upper:
        return nm.lower()
    nm

fn html_ascii_lower_char_matches(c: text, lower: text) -> bool:
    if c == lower:
        return true
    if lower == "a": return c == "A"
    if lower == "b": return c == "B"
    if lower == "c": return c == "C"
    if lower == "d": return c == "D"
    if lower == "e": return c == "E"
    if lower == "f": return c == "F"
    if lower == "g": return c == "G"
    if lower == "h": return c == "H"
    if lower == "i": return c == "I"
    if lower == "j": return c == "J"
    if lower == "k": return c == "K"
    if lower == "l": return c == "L"
    if lower == "m": return c == "M"
    if lower == "n": return c == "N"
    if lower == "o": return c == "O"
    if lower == "p": return c == "P"
    if lower == "q": return c == "Q"
    if lower == "r": return c == "R"
    if lower == "s": return c == "S"
    if lower == "t": return c == "T"
    if lower == "u": return c == "U"
    if lower == "v": return c == "V"
    if lower == "w": return c == "W"
    if lower == "x": return c == "X"
    if lower == "y": return c == "Y"
    if lower == "z": return c == "Z"
    false

fn close_tag_matches(inner: text, tag: text) -> bool:
    var start = 1
    var end = inner.len()
    while start < end:
        val c = inner.char_at(start)
        if c != " " and c != "\t" and c != "\n" and c != "\r":
            break
        start = start + 1
    while end > start:
        val c = inner.char_at(end - 1)
        if c != " " and c != "\t" and c != "\n" and c != "\r":
            break
        end = end - 1
    val tag_len = tag.len()
    if end - start != tag_len:
        return false
    var i = 0
    while i < tag_len:
        if not html_ascii_lower_char_matches(inner.char_at(start + i), tag.char_at(i)):
            return false
        i = i + 1
    true

fn split_class_words_trimmed(class_attr: text) -> [text]:
    var word_count = 1
    var i = 0
    val class_len = class_attr.len()
    while i < class_len:
        if class_attr.char_at(i) == " ":
            word_count = word_count + 1
        i = i + 1
    var words: [text] = [""; word_count]
    i = 0
    var start = 0
    var word_i = 0
    while i < class_len:
        if class_attr.char_at(i) == " ":
            words[word_i] = class_attr.substring(start, i).trim()
            word_i = word_i + 1
            start = i + 1
        i = i + 1
    words[word_i] = class_attr.substring(start, class_len).trim()
    words

fn class_flags_from_attr(class_attr: text) -> ClassFlags:
    var flags = ClassFlags(has_widget_class: false, has_icon_image_class: false, has_widget_panel_class: false, has_widget_button_class: false, has_widget_image_class: false, has_focused_class: false)
    var i = 0
    val class_len = class_attr.len()
    while i < class_len:
        val c = class_attr.char_at(i)
        if c == "w":
            if not flags.has_widget_class and text_matches_at(class_attr, "widget-", i):
                flags.has_widget_class = true
            if not flags.has_widget_panel_class and text_matches_at(class_attr, "widget-panel", i):
                flags.has_widget_panel_class = true
            if not flags.has_widget_button_class and text_matches_at(class_attr, "widget-button", i):
                flags.has_widget_button_class = true
            if not flags.has_widget_image_class and text_matches_at(class_attr, "widget-image", i):
                flags.has_widget_image_class = true
        elif c == "i":
            if not flags.has_icon_image_class and text_matches_at(class_attr, "icon-image", i):
                flags.has_icon_image_class = true
        elif c == "f":
            if not flags.has_focused_class and text_matches_at(class_attr, "focused", i):
                flags.has_focused_class = true
        i = i + 1
    flags

fn mk_element_node(tag: text, parent: i64, inner: text) -> HNode:
    # Construct array-bearing node fields in one typed value. Mutating an
    # initially-empty [text] field and then copying the class into [HNode]
    # loses earlier siblings' array handles in native code.
    val class_attr: text = attr_value_by_key(inner, "class=")
    val class_words: [text] = if class_attr.len() > 0: split_class_words_trimmed(class_attr) else: []
    val flags: ClassFlags = class_flags_from_attr(class_attr)
    HNode(
        tag: tag,
        text_data: "",
        text_trimmed: "",
        style_attr: attr_value_by_key(inner, "style="),
        class_attr: class_attr,
        class_words: class_words,
        has_widget_class: flags.has_widget_class,
        has_icon_image_class: flags.has_icon_image_class,
        has_widget_panel_class: flags.has_widget_panel_class,
        has_widget_button_class: flags.has_widget_button_class,
        has_widget_image_class: flags.has_widget_image_class,
        has_focused_class: flags.has_focused_class,
        id_attr: attr_value_by_key(inner, "id="),
        attrs_raw: inner,
        parent: parent
    )

fn html_text_range_has_non_ws(html: text, start: i32, end: i32) -> bool:
    var i = start
    while i < end:
        val c = html.char_at(i)
        if c != " " and c != "\t" and c != "\n" and c != "\r":
            return true
        i = i + 1
    false

# ---------------------------------------------------------------------------
# Split-based HTML structural scanning (parse_html)
#
# parse_html used to scan the WHOLE `html` document with
# `find_from(html, needle, pos)` (growing `pos`) and materialize every tag's
# inner text with `html.substring(lt + 1, gt)`. Under this interpreter both
# cost O(len(receiver)) PER CALL (substring collects the whole receiver's
# chars; find_from slices the receiver's tail), so one call per tag made the
# parse O(tag_count * doc_len) = O(n^2) -- measured 1.5s/6.7s/26s at
# 700/1500/3000 synthetic rules (doc/08_tracking/bug/
# text_substring_o_offset_parse_html_quadratic_2026-07-07.md).
#
# A byte-array rewrite (the CSS scanner's css_bytes_find idiom) was tried
# first and measured ~10x WORSE (14.5s at N=700): interpreted per-element
# array reads make byte walking slower than the original whole-string calls.
# The pattern that actually works under the interpreter is the one
# _css_scan_rules_simple (~:3900) already uses: split the document ONCE on
# "<" (native, O(n)), then only ever slice the SMALL per-tag segments
# (native, O(segment)). Total cost is O(doc_len).
#
# _html_scan_events returns the document as a flat event list, two parallel
# arrays [kinds, payloads]:
#   kind "g" -- tag: payload is the tag's inner text (owned small string)
#   kind "x" -- text run between tags (raw, entities still encoded)
#   kind "e" -- trailing text after the last tag (raw); kept distinct because
#               parse_html applies the single-space rule (txt == " ") only to
#               middle runs, never to the tail.
# Comments and raw-text elements (style/script/title) are consumed here and
# produce no events, matching the old scanner's pos-jump behaviour exactly,
# including the quirky cases: "-->" / closer ">" searches that cross a later
# "<", unterminated comments/tags discarding the rest of the document, and
# a raw-text element with no closer falling back to normal scanning.
# ---------------------------------------------------------------------------

fn _html_scan_events(html: text) -> [[text]]:
    val parts = html.split("<")
    val np = parts.len() as i32
    val cap = np * 2 + 2
    var kinds: [text] = [""; cap]
    var payloads: [text] = [""; cap]
    var out = 0
    if np > 0 and parts[0].len() > 0:
        kinds[out] = if np == 1: "e" else: "x"
        payloads[out] = parts[0]
        out = out + 1
    var k = 1
    while k < np:
        var seg: text = parts[k]
        if seg.starts_with("!--"):
            # Comment: content may contain "<" (spanning later parts), but
            # "-->" contains no "<" so it always lies within a single part.
            var cidx = (seg.index_of("-->") ?? -1) as i32
            var terminated = cidx >= 0
            while not terminated:
                k = k + 1
                if k >= np:
                    break
                seg = parts[k]
                cidx = (seg.index_of("-->") ?? -1) as i32
                terminated = cidx >= 0
            if not terminated:
                # Unterminated comment: old scanner broke out, discarding the rest.
                return [text_list_prefix(kinds, out), text_list_prefix(payloads, out)]
            val ctail = seg.substring(cidx + 3, seg.len())
            if ctail.len() > 0 and out < cap:
                kinds[out] = if k == np - 1: "e" else: "x"
                payloads[out] = ctail
                out = out + 1
            k = k + 1
            continue
        # Normal tag: the old scanner searched ">" from the "<" across any
        # embedded "<", so accumulate parts until the segment holds a ">".
        var gt = (seg.index_of(">") ?? -1) as i32
        while gt < 0:
            k = k + 1
            if k >= np:
                # No ">" until EOF: old scanner broke out, discarding the rest.
                return [text_list_prefix(kinds, out), text_list_prefix(payloads, out)]
            seg = seg + "<" + parts[k]
            gt = (seg.index_of(">") ?? -1) as i32
        val inner = seg.substring(0, gt)
        var rest = seg.substring(gt + 1, seg.len())
        if out < cap:
            kinds[out] = "g"
            payloads[out] = inner
            out = out + 1
        # Raw-text elements: consume content + closing tag, no events.
        if inner.len() > 0:
            val first = inner.char_at(0)
            if first != "!" and first != "/":
                val name = tag_name_of(inner)
                if name == "style" or name == "script" or name == "title":
                    val closer = "/" + name
                    var j = k + 1
                    var found = -1
                    while j < np:
                        val pj: text = "{parts[j]}"
                        if pj.starts_with(closer):
                            found = j
                            break
                        j = j + 1
                    if found >= 0:
                        # First ">" from the closer on (may cross a "<").
                        var seg2: text = parts[found]
                        var gt2 = (seg2.index_of(">") ?? -1) as i32
                        while gt2 < 0:
                            found = found + 1
                            if found >= np:
                                # Closer without ">": old scanner re-scanned from
                                # "</name", found no ">", and broke out.
                                return [text_list_prefix(kinds, out), text_list_prefix(payloads, out)]
                            seg2 = seg2 + "<" + parts[found]
                            gt2 = (seg2.index_of(">") ?? -1) as i32
                        rest = seg2.substring(gt2 + 1, seg2.len())
                        k = found
                    # Closer missing entirely: old scanner left pos after the
                    # open tag and kept scanning the content as normal HTML,
                    # which is what falling through with `rest` does.
        if rest.len() > 0 and out < cap:
            kinds[out] = if k == np - 1: "e" else: "x"
            payloads[out] = rest
            out = out + 1
        k = k + 1
    [text_list_prefix(kinds, out), text_list_prefix(payloads, out)]

# True if a tag event's inner text produces an element node in the arena
# (mirrors the skip rules in parse_html's build pass).
fn _html_tag_event_makes_node(inner: text) -> bool:
    if inner.len() == 0:
        return false
    val first = inner.char_at(0)
    if first == "!" or first == "/":
        return false
    val name = tag_name_of(inner)
    if name == "style" or name == "script" or name == "title" or name == "head" or name == "meta" or name == "link" or name == "base":
        return false
    true

# ---------------------------------------------------------------------------
# Parser -> arena
# ---------------------------------------------------------------------------

# Encode a Unicode code point to UTF-8 text. The common-tier helper
# (char_from_codepoint) returns U+FFFD for bytes >= 128, so non-ASCII must go
# through the runtime byte->text boundary here instead.
extern fn rt_bytes_to_text(data: [u8]) -> text

fn _codepoint_to_text(cp: i64) -> text:
    if cp <= 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
        return "�"
    var bytes: [u8] = []
    if cp < 0x80:
        bytes.push(cp)
    elif cp < 0x800:
        bytes.push(0xC0 + cp / 64)
        bytes.push(0x80 + cp % 64)
    elif cp < 0x10000:
        bytes.push(0xE0 + cp / 4096)
        bytes.push(0x80 + (cp / 64) % 64)
        bytes.push(0x80 + cp % 64)
    else:
        bytes.push(0xF0 + cp / 262144)
        bytes.push(0x80 + (cp / 4096) % 64)
        bytes.push(0x80 + (cp / 64) % 64)
        bytes.push(0x80 + cp % 64)
    rt_bytes_to_text(bytes)

# Decode decimal (&#NNNN;) and hex (&#xHHHH;) numeric character references per
# the WHATWG character-reference rules. Runs BEFORE the named-entity replaces:
# "&amp;#38;" contains no literal "&#" pair, so double-decoding cannot occur.
fn _decode_numeric_entities(s: text) -> text:
    var start = find_from(s, "&#", 0)
    if start < 0:
        return s
    val n = s.len()
    var out = ""
    var i = 0
    while start >= 0:
        out = out + s.substring(i, start)
        var j = start + 2
        var is_hex = false
        if j < n and (s[j] == "x" or s[j] == "X"):
            is_hex = true
            j = j + 1
        var cp = 0i64
        var digits = 0
        var valid = true
        while j < n and digits <= 7:
            val c = s[j]
            if c == ";":
                break
            var d = -1
            if c >= "0" and c <= "9":
                d = c.char_code_at(0) - 48
            elif is_hex and c >= "a" and c <= "f":
                d = c.char_code_at(0) - 87
            elif is_hex and c >= "A" and c <= "F":
                d = c.char_code_at(0) - 55
            if d < 0:
                valid = false
                break
            cp = cp * (if is_hex: 16 else: 10) + d
            digits = digits + 1
            j = j + 1
        if valid and digits > 0 and j < n and s[j] == ";":
            out = out + _codepoint_to_text(cp)
            i = j + 1
        else:
            # Not a well-formed reference: emit "&#" literally and move on.
            out = out + "&#"
            i = start + 2
        start = find_from(s, "&#", i)
    out + s.substring(i, n)

# Decode the HTML character entities the markdown/office HTML emitters produce
# (markdown_escape_html: & < > " '). Text nodes carry escaped content, so the
# painter would otherwise show "&quot;" literally instead of a quote. Decode
# &amp; LAST so "&amp;lt;" round-trips to "&lt;", not "<".
fn decode_html_entities(s: text) -> text:
    if s.len() == 0:
        return s
    if find_from(s, "&", 0) < 0:
        return s
    var out = _decode_numeric_entities(s)
    out = out.replace("&lt;", "<")
    out = out.replace("&gt;", ">")
    out = out.replace("&quot;", "\"")
    out = out.replace("&#39;", "'")
    out = out.replace("&apos;", "'")
    out = out.replace("&nbsp;", " ")
    out = out.replace("&#32;", " ")
    out = out.replace("&#x20;", " ")
    out = out.replace("&#X20;", " ")
    out = out.replace("&#34;", "\"")
    out = out.replace("&#x22;", "\"")
    out = out.replace("&#X22;", "\"")
    out = out.replace("&#38;", "&")
    out = out.replace("&#x26;", "&")
    out = out.replace("&#X26;", "&")
    out = out.replace("&#60;", "<")
    out = out.replace("&#x3C;", "<")
    out = out.replace("&#x3c;", "<")
    out = out.replace("&#X3C;", "<")
    out = out.replace("&#X3c;", "<")
    out = out.replace("&#62;", ">")
    out = out.replace("&#x3E;", ">")
    out = out.replace("&#x3e;", ">")
    out = out.replace("&#X3E;", ">")
    out = out.replace("&#X3e;", ">")
    out.replace("&amp;", "&")

fn parse_html(html: text) -> [HNode]:
    val ev = _html_scan_events(html)
    val kinds = ev[0]
    val payloads = ev[1]
    val ev_count = kinds.len() as i32
    # Counting pass: arena size, mirroring the node-creation rules below.
    # (Replaces the old count_html_nodes second full scan of the document.)
    var node_count = 1
    var e = 0
    while e < ev_count:
        if kinds[e] == "g":
            if _html_tag_event_makes_node(payloads[e]):
                node_count = node_count + 1
        else:
            val ctxt = decode_html_entities(payloads[e])
            if ctxt.trim().len() > 0 or (kinds[e] == "x" and ctxt == " "):
                node_count = node_count + 1
        e = e + 1
    var nodes: [HNode] = [mk_node("#root", -1); node_count]
    var node_i = 1
    var pstack: [i64] = [0; node_count]
    var stack_len = 1
    e = 0
    while e < ev_count:
        val kind = kinds[e]
        e = e + 1
        if kind != "g":
            val txt = decode_html_entities(payloads[e - 1])
            val txt_trimmed = txt.trim()
            if txt_trimmed.len() > 0 or (kind == "x" and txt == " "):
                var tn = mk_node("#text", pstack[stack_len - 1])
                tn.text_data = txt
                tn.text_trimmed = txt_trimmed
                nodes[node_i] = tn
                node_i = node_i + 1
            continue
        val inner = payloads[e - 1]
        if inner.len() == 0:
            continue
        val first = inner.char_at(0)
        if first == "!":
            continue
        if first == "/":
            var k = stack_len - 1
            var found = -1
            while k >= 1:
                val pidx = pstack[k]
                if close_tag_matches(inner, nodes[pidx].tag):
                    found = k
                    break
                k = k - 1
            if found >= 1:
                stack_len = found
            continue
        val name = tag_name_of(inner)
        # style/script/title content is consumed by _html_scan_events; their
        # open-tag events (and head/meta/link/base) produce no nodes.
        if name == "style" or name == "script" or name == "title":
            continue
        if name == "head" or name == "meta" or name == "link" or name == "base":
            continue
        val node = mk_element_node(name, pstack[stack_len - 1], inner)
        val current_index = node_i
        nodes[current_index] = node
        node_i = node_i + 1
        val self_close = inner.char_at(inner.len() - 1) == "/"
        if not is_void(name) and not self_close:
            if stack_len < pstack.len():
                pstack[stack_len] = current_index
                stack_len = stack_len + 1
    nodes

pub fn simple_web_layout_debug_attr_by_id(html: text, id: text, attr: text) -> text:
    val nodes = parse_html(html)
    var i = 0
    val node_count = nodes.len()
    while i < node_count:
        val node = nodes[i]
        if node.id_attr == id:
            if attr == "style":
                return node.style_attr
            if attr == "class":
                return node.class_attr
            if attr == "id":
                return node.id_attr
            return attr_value(node.attrs_raw, attr)
        i = i + 1
    ""

pub fn simple_web_layout_debug_style_by_id(html: text, id: text, field: text) -> text:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css(html)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index)
    var i = 0
    val node_count = nodes.len()
    while i < node_count:
        val node = nodes[i]
        if node.id_attr == id:
            val st = styles[i]
            val style_attr = node.style_attr
            if field == "decl_width":
                return decl_get(style_attr, "width")
            if field == "decl_margin":
                return decl_get(style_attr, "margin")
            if field == "decl_height":
                return decl_get(style_attr, "height")
            if field == "parse_width":
                return parse_int(decl_get(style_attr, "width")).to_string()
            if field == "parse_margin":
                return parse_int(decl_get(style_attr, "margin")).to_string()
            if field == "parse_height":
                return parse_int(decl_get(style_attr, "height")).to_string()
            if field == "display":
                return st.display
            if field == "width":
                return st.width_px.to_string()
            if field == "height":
                return st.height_px.to_string()
            if field == "margin_l":
                return st.margin_l.to_string()
            if field == "pad_l":
                return st.pad_l.to_string()
            if field == "pad_r":
                return st.pad_r.to_string()
            if field == "border_l":
                return st.border_l.to_string()
            if field == "white_space_nowrap":
                return if st.white_space_nowrap: "true" else: "false"
            if field == "transition_property":
                return st.transition_property
            if field == "transition_duration_ms":
                return st.transition_duration_ms.to_string()
            if field == "transition_delay_ms":
                return st.transition_delay_ms.to_string()
            if field == "transition_timing_function":
                return st.transition_timing_function
            if field == "animation_name":
                return st.animation_name
            if field == "animation_duration_ms":
                return st.animation_duration_ms.to_string()
            if field == "animation_delay_ms":
                return st.animation_delay_ms.to_string()
            if field == "animation_timing_function":
                return st.animation_timing_function
            if field == "animation_iteration_count":
                return st.animation_iteration_count
            if field == "animation_direction":
                return st.animation_direction
            if field == "animation_fill_mode":
                return st.animation_fill_mode
            if field == "animation_play_state":
                return st.animation_play_state
            if field == "transform_origin":
                return st.transform_origin
            if field == "transform_box":
                return st.transform_box
            if field == "transform_style":
                return st.transform_style
            if field == "flex_grow":
                return st.flex_grow.to_string()
            if field == "flex_wrap":
                return st.flex_wrap
            if field == "flex_direction":
                return st.flex_direction
        i = i + 1
    ""

pub fn simple_web_layout_debug_layout_by_id(html: text, width: i32, height: i32, id: text, field: text) -> text:
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index)
    val node_count = nodes.len().to_i32()
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    var i = 0
    while i < node_count:
        val node = nodes[i]
        if node.id_attr == id:
            val x = boxes.bx[i]
            val y = boxes.by[i]
            val w = boxes.bw[i]
            val h = boxes.bh[i]
            if field == "x": return x.to_string()
            if field == "y": return y.to_string()
            if field == "w": return w.to_string()
            if field == "h": return h.to_string()
            if field == "margin_t": return styles[i].margin_t.to_string()
            if field == "margin_b": return styles[i].margin_b.to_string()
        i = i + 1
    ""

pub fn simple_web_layout_uses_legacy_widget_chrome(html: text) -> bool:
    html.contains("widget-panel") and not html.contains("<style")

fn _simple_web_element_child_ordinal(
    nodes: [HNode], child_index: HtmlChildIndex,
    parent_index: i32, target_index: i32
) -> i32:
    var ordinal = 0
    var child = child_index.first_child[parent_index]
    while child >= 0:  # cpu-lane-loop-ok: walks one parent's sibling chain to find a child's element ordinal; bound is that parent's child count, not the document
        if _simple_web_layout_element(nodes[child]):
            if child == target_index:
                return ordinal
            ordinal = ordinal + 1
        child = child_index.next_sibling[child]
    -1

fn _simple_web_node_target_key(
    nodes: [HNode], child_index: HtmlChildIndex, node_index: i32
) -> text:
    if node_index < 0 or node_index >= nodes.len():
        return ""
    var body = node_index
    while body >= 0 and nodes[body].tag != "body":
        body = nodes[body].parent.to_i32()
    if body < 0:
        return ""
    if node_index == body:
        return "path:"
    var reversed: [i32] = [0; nodes.len()]
    var depth = 0
    var current = node_index
    while current != body and current >= 0:
        val parent = nodes[current].parent.to_i32()
        if parent < 0:
            return ""
        val ordinal = _simple_web_element_child_ordinal(
            nodes, child_index, parent, current
        )
        if ordinal < 0:
            return ""
        reversed[depth] = ordinal
        depth = depth + 1
        current = parent
    var path = "path:"
    var part = depth - 1
    while part >= 0:
        if part < depth - 1:
            path = path + "/"
        path = path + reversed[part].to_text()
        part = part - 1
    path

fn dec_val(c: text) -> i32:
    if c == "0": return 0
    if c == "1": return 1
    if c == "2": return 2
    if c == "3": return 3
    if c == "4": return 4
    if c == "5": return 5
    if c == "6": return 6
    if c == "7": return 7
    if c == "8": return 8
    if c == "9": return 9
    10

fn argb(r: i32, g: i32, b: i32) -> u32:
    0xFF000000u32 | ((r.to_u32()) << 16) | ((g.to_u32()) << 8) | b.to_u32()

fn parse_int_range(s: text, start: i32, end: i32) -> i32:
    var i = start
    var v = 0
    var matched_any_digit = false
    while i < end:
        val c = s.char_at(i)
        val digit = dec_val(c)
        if digit < 10:
            v = v * 10 + digit
            matched_any_digit = true
        else:
            if matched_any_digit:
                break
        i = i + 1
    v

fn _simple_web_animation_target_keys(
    nodes: [HNode], child_index: HtmlChildIndex
) -> [text]:
    var target_keys = [""; nodes.len()]
    var body_index = -1
    var node_index = 0
    while node_index < nodes.len():  # cpu-lane-loop-ok: one scan for the <body> node, breaks on first hit; bound is node_count, runs once per animation frame-index build
        if nodes[node_index].tag == "body":
            body_index = node_index
            target_keys[node_index] = "path:"
            break
        item_index = item_index + 1
        pos = comma + 1
    0u32

    var parent_index = body_index
    while parent_index < nodes.len():
        if target_keys[parent_index] != "":
            var ordinal = 0
            var child = child_index.first_child[parent_index]
            while child >= 0:
                if _simple_web_layout_element(nodes[child]):
                    val separator = if target_keys[parent_index] == "path:":
                        ""
                    else:
                        "/"
                    target_keys[child] = (
                        target_keys[parent_index] + separator +
                        ordinal.to_text()
                    )
                    ordinal = ordinal + 1
                child = child_index.next_sibling[child]
        parent_index = parent_index + 1
    target_keys

fn _simple_web_hit_target_key(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, width: i32, height: i32, x: i32, y: i32
) -> text:
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        width, height
    )
    var best = -1
    var best_z = -2147483647
    var i = 0
    while i < n:
        if dec_val(s.char_at(i)) < 10:
            val (v, j) = parse_font_shorthand_number(s, i, n)
            if j + 1 < n and s.char_at(j) == "p" and s.char_at(j + 1) == "x":
                return v
            i = j
        else:
            i = i + 1
    0

# Family tail after the required size[/line-height] component of `font:`.
fn parse_font_shorthand_family(s: text) -> text:
    val n = s.len()
    var i = 0
    while i + 1 < n:
        if dec_val(s.char_at(i)) < 10:
            val (_, number_end) = parse_font_shorthand_number(s, i, n)
            var j = number_end
            if j + 1 < n and s.char_at(j) == "p" and s.char_at(j + 1) == "x":
                j = j + 2
                j = skip_wrap_spaces(s, j)
                if j < n and s.char_at(j) == "/":
                    j = skip_wrap_spaces(s, j + 1)
                    val family_sep = find_from(s, " ", j)
                    if family_sep < 0:
                        return ""
                    j = skip_wrap_spaces(s, family_sep)
                return s.substring(j, n).trim()
            i = j
        else:
            i = i + 1
    ""

class BoxShadowAgg:
    found: bool
    x: i32
    y: i32
    blur: i32
    alpha: i32
    color: u32

fn split_top_level_commas(s: text) -> [text]:
    var parts: [text] = [""; 24]
    var count = 0
    var depth = 0
    var start = 0
    val n = s.len()
    var i = 0
    while i < n:
        val c = s.char_at(i)
        if c == "(":
            depth = depth + 1
        elif c == ")":
            if depth > 0:
                depth = depth - 1
        elif c == "," and depth == 0:
            if count < parts.len():
                parts[count] = s.substring(start, i)
                count = count + 1
            start = i + 1
        i = i + 1
    if count < parts.len():
        parts[count] = s.substring(start, n)
        count = count + 1
    text_list_prefix(parts, count)

pub fn simple_web_layout_hit_test_index(
    index: SimpleWebLayoutHitIndex, x: i32, y: i32
) -> text:
    _simple_web_hit_target_key(
        index.nodes, index.styles, index.child_index, index.boxes,
        index.width, index.height, x, y
    )

class SimpleWebLayoutDrawIrResult:
    composition: DrawIrComposition
    # Budget-exhaustion verdict, captured at the moment this result was built.
    # The Draw IR analogue of SimpleWebLayoutPixelResult.render_degraded, and
    # necessary for the same reason: `composition` alone cannot express
    # exhaustion.
    #
    # When layout trips its deadline, layout_with_style zeroes bw/bh for every
    # subtree it did not reach; _html_draw_ir_visible then reports every such
    # node invisible (box_w <= 0), so _html_draw_ir_commands emits nothing for
    # it. The canvas rect is emitted unconditionally, so a fully-truncated
    # render returns a well-formed composition holding exactly ONE command --
    # shaped precisely like a successful render of an empty document. A
    # per-stage comparison against that composition reads "Simple produced no
    # div" as a layout mismatch, when the truth is "layout never ran".
    #
    # The module-global simple_web_layout_last_render_degraded() is NOT a
    # substitute, for the reason already documented on the pixel result: it is
    # cleared by the next _web_budget_begin, so a caller that renders the
    # baseline, then renders the lane, then compares, reads the LANE's status.
    # These two fields travel with the result and stay valid for its lifetime.
    render_degraded: bool
    # "" when complete; otherwise the WEB_BUDGET_SITE_* name of the first
    # exhaustion exit taken (e.g. "style-cascade", "layout-subtree").
    degrade_reason: text
    material_fallback: WebRenderMaterialFallbackProvenance
    material_witness: SimpleWebLayoutMaterialWitness
    animation_end_ms: i64
    animation_next_ms: i64
    animation_property_work_count: i64
    hit_index: SimpleWebLayoutHitIndex
    resolved_input_view_start_byte: i64
    resolved_scroll_y: i32
    max_scroll_y: i32
    document_html: text
    rules: Rules
    base_styles: [Style]
    raw_boxes: LayoutResult
    animation_registry: KeyframeRegistry
    material_entries: [text]
    material_counts: [i64]
    cpu_material_nodes: [i32]
    solid_material_nodes: [i32]

fn _simple_web_root_sticky_admitted(
    nodes: [HNode], node_index: i32
) -> bool:
    var ancestor = nodes[node_index].parent as i32
    while ancestor >= 0 and ancestor < nodes.len():  # cpu-lane-loop-ok: ancestor walk that bails at the first non-root/html/body ancestor; bound is tree depth, not an element count - flagged by the gate's any-loop-header approximation of the design's bound-based rule
        val tag = nodes[ancestor].tag
        if tag != "#root" and tag != "html" and tag != "body":
            return false
        ancestor = nodes[ancestor].parent as i32
    true

class _SimpleWebScrolledLayout:
    boxes: LayoutResult
    resolved_scroll_y: i32
    max_scroll_y: i32

fn _simple_web_scrolled_layout(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    viewport_width: i32, viewport_height: i32, scroll_y: i32
) -> _SimpleWebScrolledLayout:
    var raw_bottom = boxes.height.to_i64()
    var i = 0
    while i < boxes.by.len():  # cpu-lane-loop-ok: first of two box passes: computes the raw document bottom; bound is the box count (== node_count), once per compose
        val bottom = boxes.by[i].to_i64() + boxes.bh[i].to_i64()
        if bottom > raw_bottom:
            raw_bottom = bottom
        i = i + 1
    val extent_height = if raw_bottom > 2147483647:
        2147483647
    elif raw_bottom > viewport_height.to_i64():
        raw_bottom.to_i32()
    else:
        viewport_height
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        viewport_width, extent_height
    )

    var content_bottom = viewport_height.to_i64()
    i = 0
    while i < boxes.by.len():  # cpu-lane-loop-ok: second box pass: clips each box against its ancestor clip for the scrollable content bottom; needs the clip cache derived from pass one so it cannot be merged; bound is the box count
        val clip = paint_clip_at(clip_cache, i)
        val node_x0 = boxes.bx[i].to_i64()
        val node_y0 = boxes.by[i].to_i64()
        val node_x1 = node_x0 + boxes.bw[i].to_i64()
        val node_y1 = node_y0 + boxes.bh[i].to_i64()
        if (node_x1 > clip.x0.to_i64() and node_x0 < clip.x1.to_i64() and
            node_y1 > clip.y0.to_i64() and node_y0 < clip.y1.to_i64()):
            val clipped_bottom = if node_y1 < clip.y1.to_i64():
                node_y1
            else:
                clip.y1.to_i64()
            if clipped_bottom > content_bottom:
                content_bottom = clipped_bottom
        i = i + 1
    var max_scroll = content_bottom - viewport_height.to_i64()
    if max_scroll < 0:
        max_scroll = 0
    var resolved = if scroll_y > 0: scroll_y.to_i64() else: 0
    if resolved > max_scroll:
        resolved = max_scroll
    var has_top_sticky = false
    var has_top_sticky_index = 0
    while has_top_sticky_index < styles.len():  # cpu-lane-loop-ok: scans styles for a root-scroll top-inset sticky box; bound is the style count (== node_count), once per compose
        val style = styles[has_top_sticky_index]
        if (
            style.position_sticky and
            style.top_px != SIMPLE_WEB_STICKY_TOP_AUTO and
            _simple_web_root_sticky_admitted(nodes, has_top_sticky_index)
        ):
            has_top_sticky = true
        has_top_sticky_index = has_top_sticky_index + 1
    var shifted_by = if resolved == 0 and not has_top_sticky:
        boxes.by
    else:
        shifted_i32_list(boxes.by, 0 - resolved.to_i32())
    if has_top_sticky:
        # ponytail: root-scroll/top-inset sticky only; add scroll-container
        # bounds and other inset axes when those conformance slices land.
        var subtree_delta: [i32] = [0; nodes.len()]
        var has_sticky_ancestor: [bool] = [false; nodes.len()]
        var node_index = 0
        while node_index < styles.len():  # cpu-lane-loop-ok: top-down sticky-shift pass propagating subtree deltas from the parent entry; bound is the style count, runs only when a top sticky box exists
            val parent = nodes[node_index].parent as i32
            val inherited_delta = if parent >= 0:
                subtree_delta[parent]
            else:
                0
            val nested = if parent >= 0:
                has_sticky_ancestor[parent] or styles[parent].position_sticky
            else:
                false
            shifted_by[node_index] = (
                shifted_by[node_index] + inherited_delta
            )
            var own_delta = 0
            val style = styles[node_index]
            if (
                not nested and style.position_sticky and
                style.top_px != SIMPLE_WEB_STICKY_TOP_AUTO and
                _simple_web_root_sticky_admitted(nodes, node_index) and
                shifted_by[node_index] < style.top_px
            ):
                own_delta = style.top_px - shifted_by[node_index]
                shifted_by[node_index] = style.top_px
            subtree_delta[node_index] = inherited_delta + own_delta
            has_sticky_ancestor[node_index] = nested
            node_index = node_index + 1
    val shifted = LayoutResult(
        bx: boxes.bx,
        by: shifted_by,
        bw: boxes.bw,
        bh: boxes.bh,
        wrap_starts: boxes.wrap_starts,
        wrap_ends: boxes.wrap_ends,
        intrinsic_widths: boxes.intrinsic_widths,
        height: boxes.height
    )
    _SimpleWebScrolledLayout(
        boxes: shifted,
        resolved_scroll_y: resolved.to_i32(),
        max_scroll_y: max_scroll.to_i32()
    )

class SimpleWebLayoutMaterialWitness:
    cpu_composited_count: i32
    cpu_composited_sha256: text
    solid_material_count: i32
    solid_material_sha256: text

struct _SimpleWebInputTextHitBuild:
    target_keys: [text]
    hits: [SimpleWebInputTextHitMap]
    resolved_view_start_byte: i64

fn _simple_web_input_text_hit_build(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, width: i32, height: i32,
    overlay: BrowserTextInputOverlay
) -> _SimpleWebInputTextHitBuild:
    var target_keys: [text] = [""; nodes.len()]
    var hits: [SimpleWebInputTextHitMap] = []
    var resolved_view_start_byte = overlay.view_start_byte
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        width, height
    )
    var i = 0
    while i < nodes.len():  # cpu-lane-loop-ok: one pass over nodes building the text-input hit map; bound is node_count and the target-key/paint-plan work fires only for <input> elements
        if (
            nodes[i].tag == "input" and
            input_accepts_text_overlay(nodes[i]) and
            styles[i].display != "none" and
            not styles[i].visibility_hidden and
            boxes.bw[i] > 0 and boxes.bh[i] > 0
        ):
            val target_key = _simple_web_node_target_key(
                nodes, child_index, i
            )
            target_keys[i] = target_key
            val content_w = (
                boxes.bw[i] - styles[i].border_l - styles[i].border_r -
                styles[i].pad_l - styles[i].pad_r
            )
            val advance = style_text_advance(styles[i])
            val glyph_advance = if advance > 0: advance else: 1
            val plan = if target_key == overlay.target_key:
                input_text_paint_plan_with_overlay(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    paint_clip_at(clip_cache, i), overlay
                )
            else:
                input_text_paint_plan(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    paint_clip_at(clip_cache, i),
                    content_w / glyph_advance + 1
                )
            if target_key == overlay.target_key:
                resolved_view_start_byte = plan.resolved_view_start_byte
            hits.push(SimpleWebInputTextHitMap(
                target_key: target_key,
                x: plan.clip.x0,
                y: plan.clip.y0,
                width: plan.clip.x1 - plan.clip.x0,
                height: plan.clip.y1 - plan.clip.y0,
                source_boundary_bytes: plan.source_boundary_bytes,
                boundary_x_px: plan.boundary_x_px
            ))
        i = i + 1
    _SimpleWebInputTextHitBuild(
        target_keys: target_keys,
        hits: hits,
        resolved_view_start_byte: resolved_view_start_byte
    )

pub fn simple_web_layout_material_provenance_after_execution(witness: SimpleWebLayoutMaterialWitness, skipped_command_count: i32, pixel_count: i32, expected_pixel_count: i32, executed_cpu_material_count: i32) -> WebRenderMaterialFallbackProvenance:
    simple_web_layout_material_provenance_after_backend_execution(
        witness,
        skipped_command_count,
        pixel_count,
        expected_pixel_count,
        executed_cpu_material_count,
        0,
        "",
        "",
        0,
        0
    )

pub fn simple_web_layout_material_provenance_after_backend_execution(
    witness: SimpleWebLayoutMaterialWitness,
    skipped_command_count: i32,
    pixel_count: i32,
    expected_pixel_count: i32,
    executed_cpu_material_count: i32,
    executed_metal_material_count: i32,
    glass_execution_target: text,
    readback_source: text,
    glass_backend_handle: i64,
    glass_device_identity: i64
) -> WebRenderMaterialFallbackProvenance:
    if skipped_command_count != 0 or pixel_count != expected_pixel_count:
        if witness.cpu_composited_count > 0 or witness.solid_material_count > 0:
            print "[web-material-provenance] witness-dropped-at-integrity-gate skipped={skipped_command_count} pixels={pixel_count} expected={expected_pixel_count} cpu_witness={witness.cpu_composited_count} solid_witness={witness.solid_material_count}"
        return WebRenderMaterialFallbackProvenance.none()
    if witness.cpu_composited_count > 0:
        if (witness.cpu_composited_count ==
                executed_metal_material_count and
            executed_cpu_material_count == 0 and
            glass_execution_target == "metal-device-glass-v1" and
            readback_source == "device_readback" and
            glass_backend_handle > 0 and glass_device_identity > 0 and
            witness.cpu_composited_sha256.len() == 64):
            return WebRenderMaterialFallbackProvenance.metal_device_composited(
                witness.cpu_composited_sha256)
        if (witness.cpu_composited_count == executed_cpu_material_count and
            executed_metal_material_count == 0 and
            witness.cpu_composited_sha256.len() == 64):
            return WebRenderMaterialFallbackProvenance.cpu_composited(
                witness.cpu_composited_sha256)
        # Defect signal, bounded (fires only when a realized witness fails to
        # convert): names the exact mismatch instead of a silent kind="none".
        print "[web-material-provenance] witness-unconverted cpu_witness={witness.cpu_composited_count} cpu_executed={executed_cpu_material_count} metal_executed={executed_metal_material_count} sha_len={witness.cpu_composited_sha256.len()} target={glass_execution_target} readback={readback_source}"
        return WebRenderMaterialFallbackProvenance.none()
    if (executed_cpu_material_count != 0 or
        executed_metal_material_count != 0):
        # Executed material with NO witness: the sidecar channel lost the
        # entries between the style pass and this decision. Bounded defect
        # signal, same rationale as witness-unconverted above.
        print "[web-material-provenance] executed-without-witness cpu_executed={executed_cpu_material_count} metal_executed={executed_metal_material_count} solid_witness={witness.solid_material_count}"
        return WebRenderMaterialFallbackProvenance.none()
    if (witness.solid_material_count > 0 and
        witness.solid_material_sha256.len() == 64):
        return WebRenderMaterialFallbackProvenance.solid(
            "cpu-raster-backdrop-sampling-unavailable",
            witness.solid_material_sha256)
    WebRenderMaterialFallbackProvenance.none()

pub fn simple_web_material_fallback_realized(declared: bool, bg: u32, gradient_from: u32, gradient_to: u32, layers_raw: text) -> bool:
    declared and ((bg >> 24) & 255u32) == 255u32 and gradient_from == 0u32 and gradient_to == 0u32 and layers_raw == ""

fn _simple_web_material_witness_from_sidecar(
    entries: [text], counts: [i64]
) -> SimpleWebLayoutMaterialWitness:
    if entries.len() < 2 or counts.len() < 2:
        return SimpleWebLayoutMaterialWitness(
            cpu_composited_count: 0,
            cpu_composited_sha256: "",
            solid_material_count: 0,
            solid_material_sha256: "")
    val cpu_count = counts[0]
    val solid_count = counts[1]
    SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_count as i32,
        cpu_composited_sha256:
            if cpu_count > 0: sha256_text(entries[0]) else: "",
        solid_material_count: solid_count as i32,
        solid_material_sha256:
            if solid_count > 0: sha256_text(entries[1]) else: "")

fn _simple_web_visible_material_witness(
    entries: [text], cpu_nodes: [i32], solid_nodes: [i32],
    visible_nodes: [bool]
) -> SimpleWebLayoutMaterialWitness:
    if entries.len() < 2:
        return _simple_web_material_witness_from_sidecar([], [])
    val cpu_lines = entries[0].split("\n")
    val solid_lines = entries[1].split("\n")
    var cpu_filtered: [text] = [""; cpu_lines.len()]
    var solid_filtered: [text] = [""; solid_lines.len()]
    cpu_filtered[0] = cpu_lines[0]
    solid_filtered[0] = solid_lines[0]
    var cpu_filtered_count = 1
    var solid_filtered_count = 1
    var counts: [i64] = [0, 0]
    var i = 0
    while i < cpu_nodes.len() and i + 1 < cpu_lines.len():  # cpu-lane-loop-ok: filters the cpu-composited material sidecar down to visible nodes; bound is the recorded cpu material node count, not the document
        val node = cpu_nodes[i]
        if node >= 0 and node < visible_nodes.len() and visible_nodes[node]:
            cpu_filtered[cpu_filtered_count] = cpu_lines[i + 1]
            cpu_filtered_count = cpu_filtered_count + 1
            counts[0] = counts[0] + 1
        i = i + 1
    i = 0
    while i < solid_nodes.len() and i + 1 < solid_lines.len():  # cpu-lane-loop-ok: same filter for the solid material sidecar; bound is the recorded solid material node count
        val node = solid_nodes[i]
        if node >= 0 and node < visible_nodes.len() and visible_nodes[node]:
            solid_filtered[solid_filtered_count] = solid_lines[i + 1]
            solid_filtered_count = solid_filtered_count + 1
            counts[1] = counts[1] + 1
        i = i + 1
    _simple_web_material_witness_from_sidecar(
        [
            cpu_filtered.slice(0, cpu_filtered_count).join("\n"),
            solid_filtered.slice(0, solid_filtered_count).join("\n")
        ],
        counts
    )

fn _animation_direction_progress(progress: f64, direction: text, iteration: i64) -> f64:
    if direction == "reverse":
        return 1.0 - progress
    if direction == "alternate" and iteration % 2 != 0:
        return 1.0 - progress
    if direction == "alternate-reverse" and iteration % 2 == 0:
        return 1.0 - progress
    progress

fn _animation_direction_is_forwards(direction: text, iteration: i64) -> bool:
    if direction == "reverse":
        return false
    if direction == "alternate":
        return iteration % 2 == 0
    if direction == "alternate-reverse":
        return iteration % 2 != 0
    true

fn _css_animation_signature(st: Style) -> text:
    (
        st.animation_name + "\u001f" +
        st.animation_duration_ms.to_text() + "\u001f" +
        st.animation_delay_ms.to_text() + "\u001f" +
        st.animation_timing_function + "\u001f" +
        st.animation_iteration_count + "\u001f" +
        st.animation_direction + "\u001f" +
        st.animation_fill_mode
    )

val CSS_ANIMATION_MAX_TIME_MS: i64 = 9223372036854775807
val CSS_ANIMATION_MIN_TIME_MS: i64 = -9223372036854775808

fn _css_animation_iteration_count(raw: text) -> f64:
    if raw == "infinite":
        return -1.0
    if val parsed = parse_animation_iteration_number_token(raw):
        return parsed
    1.0

fn _css_animation_add_ms_no_wrap(base_ms: i64, delta_ms: i64) -> i64:
    if (
        delta_ms > 0 and
        base_ms > CSS_ANIMATION_MAX_TIME_MS - delta_ms
    ):
        return CSS_ANIMATION_MAX_TIME_MS
    if (
        delta_ms < 0 and
        base_ms < CSS_ANIMATION_MIN_TIME_MS - delta_ms
    ):
        return CSS_ANIMATION_MIN_TIME_MS
    base_ms + delta_ms

fn _css_animation_sub_ms_no_wrap(base_ms: i64, delta_ms: i64) -> i64:
    if (
        delta_ms > 0 and
        base_ms < CSS_ANIMATION_MIN_TIME_MS + delta_ms
    ):
        return CSS_ANIMATION_MIN_TIME_MS
    if (
        delta_ms < 0 and
        base_ms > CSS_ANIMATION_MAX_TIME_MS + delta_ms
    ):
        return CSS_ANIMATION_MAX_TIME_MS
    base_ms - delta_ms

fn _css_animation_active_duration_ms(
    duration_ms: i64, iteration_count: f64
) -> i64:
    if iteration_count < 0.0:
        return -1
    val active_duration = duration_ms.to_f64() * iteration_count
    if (
        active_duration != active_duration or
        active_duration > CSS_ANIMATION_MAX_FINITE_ITERATIONS
    ):
        return CSS_ANIMATION_MAX_TIME_MS
    if active_duration <= 0.0:
        return 0
    active_duration.ceil().to_i64()

fn _css_animation_next_frame_ms(current_time_ms: i64) -> i64:
    val next_ms = _css_animation_add_ms_no_wrap(current_time_ms, 16)
    if next_ms <= current_time_ms:
        return -1
    next_ms

fn _simple_web_animation_frame_index(
    styles: [Style], nodes: [HNode], child_index: HtmlChildIndex,
    registry: KeyframeRegistry,
    instances: [BrowserCssAnimationInstance], include_signatures: bool
) -> _SimpleWebAnimationFrameIndex:
    val target_keys = _simple_web_animation_target_keys(nodes, child_index)
    var signatures: [text] = if include_signatures:
        [""; styles.len()]
    else:
        []
    var style_index = 0
    while style_index < styles.len():  # cpu-lane-loop-ok: optional animation-signature pass over styles; bound is the style count and only the reconcile caller requests signatures
        if (include_signatures and
            styles[style_index].animation_name != "none" and
            styles[style_index].animation_duration_ms > 0
        ):
            signatures[style_index] = _css_animation_signature(
                styles[style_index]
            )
        style_index = style_index + 1

    var keyframes_by_name: Dict<text, i32> = {}
    var keyframe_index = 0
    while keyframe_index < registry.entries.len():  # cpu-lane-loop-ok: builds the keyframe-name to index dict; bound is the declared @keyframes count
        keyframes_by_name[registry.entries[keyframe_index].name] = (
            keyframe_index
        )
        keyframe_index = keyframe_index + 1

    var instances_by_target: Dict<text, i32> = {}
    var instance_index = 0
    while instance_index < instances.len():  # cpu-lane-loop-ok: builds the target-key to instance index dict; bound is the live animation instance count (capacity-capped)
        instances_by_target[instances[instance_index].target_key] = (
            instance_index
        )
        instance_index = instance_index + 1
    _SimpleWebAnimationFrameIndex(
        target_keys: target_keys,
        signatures: signatures,
        keyframes_by_name: keyframes_by_name,
        instances_by_target: instances_by_target
    )

pub fn simple_web_layout_reconcile_animation_instances(
    html: text, width: i32, current_time_ms: i64,
    new_epoch_ms: i64, reset_descendants: bool,
    previous: [BrowserCssAnimationInstance]
) -> [BrowserCssAnimationInstance]:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val registry = _simple_web_extract_keyframes(html)
    if registry.entries.len() == 0:
        return []
    val frame_index = _simple_web_animation_frame_index(
        styles, nodes, child_index, registry, previous, true
    )
    var reconciled: [BrowserCssAnimationInstance] = []
    var style_index = 0
    while style_index < styles.len():  # cpu-lane-loop-ok: one pass over styles reconciling declared animations against the previous instance list; bound is the style count, runs on animation reconcile, not on paint
        val st = styles[style_index]
        val keyframe_index = (
            frame_index.keyframes_by_name.get(st.animation_name) ?? -1
        )
        if (
            st.animation_name != "none" and
            st.animation_duration_ms > 0 and
            keyframe_index >= 0
        ):
            val target_key = frame_index.target_keys[style_index]
            if (
                target_key != "" and
                browser_css_animation_capacity_available(reconciled.len())
            ):
                val signature = frame_index.signatures[style_index]
                val paused = st.animation_play_state == "paused"
                val duration_ms = st.animation_duration_ms.to_i64()
                val delay_ms = st.animation_delay_ms.to_i64()
                val iteration_count = _css_animation_iteration_count(
                    st.animation_iteration_count
                )
                val old_index = (
                    frame_index.instances_by_target.get(target_key) ?? -1
                )
                if (
                    (not reset_descendants or target_key == "path:") and
                    old_index >= 0 and
                    previous[old_index].signature == signature
                ):
                    val old = previous[old_index]
                    if paused and not old.paused:
                        val elapsed = _css_animation_sub_ms_no_wrap(
                            current_time_ms, old.start_time_ms
                        )
                        val paused_elapsed = if elapsed > 0:
                            elapsed
                        else:
                            0
                        reconciled.push(BrowserCssAnimationInstance(
                            target_key: target_key,
                            signature: signature,
                            start_time_ms: old.start_time_ms,
                            paused: true,
                            paused_elapsed_ms: paused_elapsed,
                            duration_ms: duration_ms,
                            delay_ms: delay_ms,
                            timing: old.timing,
                            iteration_count: iteration_count
                        ))
                    elif not paused and old.paused:
                        reconciled.push(BrowserCssAnimationInstance(
                            target_key: target_key,
                            signature: signature,
                            start_time_ms: _css_animation_sub_ms_no_wrap(
                                current_time_ms, old.paused_elapsed_ms
                            ),
                            paused: false,
                            paused_elapsed_ms: old.paused_elapsed_ms,
                            duration_ms: duration_ms,
                            delay_ms: delay_ms,
                            timing: old.timing,
                            iteration_count: iteration_count
                        ))
                    else:
                        reconciled.push(old)
                else:
                    if val timing = parse_timing_function(
                        st.animation_timing_function
                    ):
                        reconciled.push(BrowserCssAnimationInstance(
                            target_key: target_key,
                            signature: signature,
                            start_time_ms: new_epoch_ms,
                            paused: paused,
                            paused_elapsed_ms: 0,
                            duration_ms: duration_ms,
                            delay_ms: delay_ms,
                            timing: timing,
                            iteration_count: iteration_count
                        ))
        style_index = style_index + 1
    reconciled

fn _animation_progress(
    st: Style, animation_time_ms: i64, timing: TimingFunction
) -> f64?:
    if st.animation_name == "none" or st.animation_duration_ms <= 0:
        return nil
    val elapsed = _css_animation_sub_ms_no_wrap(
        animation_time_ms, st.animation_delay_ms.to_i64()
    )
    if elapsed < 0:
        if st.animation_fill_mode == "backwards" or st.animation_fill_mode == "both":
            val directed_before = _animation_direction_progress(
                0.0, st.animation_direction, 0
            )
            val current_direction_forwards = (
                _animation_direction_is_forwards(st.animation_direction, 0)
            )
            return Some(evaluate_timing(
                timing, directed_before, current_direction_forwards
            ))
        return nil
    val iteration_count = _css_animation_iteration_count(
        st.animation_iteration_count
    )
    if iteration_count == 0.0:
        if (
            st.animation_fill_mode == "forwards" or
            st.animation_fill_mode == "both"
        ):
            val directed_zero = _animation_direction_progress(
                0.0, st.animation_direction, 0
            )
            val current_direction_forwards = (
                _animation_direction_is_forwards(st.animation_direction, 0)
            )
            return Some(evaluate_timing(
                timing, directed_zero, not current_direction_forwards
            ))
        return nil
    val duration = st.animation_duration_ms.to_i64()
    val active_duration = duration.to_f64() * iteration_count
    if (
        iteration_count > 0.0 and
        elapsed.to_f64() >= active_duration
    ):
        if st.animation_fill_mode != "forwards" and st.animation_fill_mode != "both":
            return nil
        val whole_iterations = iteration_count.floor()
        val fractional_iteration = iteration_count - whole_iterations
        val terminal_iteration = if fractional_iteration > 0.0:
            whole_iterations.to_i64()
        else:
            if matched_any_digit:
                break
        i = i + 1
    v

fn parse_nth_int(s: text, target: i32) -> i32:
    var i = 0
    var seen = 0
    val s_len = s.len()
    while i < s_len:
        val c = s.char_at(i)
        if dec_val(c) < 10:
            var v = 0
            while i < s_len:
                val d = s.char_at(i)
                val digit = dec_val(d)
                if digit >= 10:
                    break
                v = v * 10 + digit
                i = i + 1
            if seen == target:
                return v
            seen = seen + 1
        else:
            i = i + 1
    -1

pub fn simple_web_layout_animation_instances_next_ms(
    instances: [BrowserCssAnimationInstance], current_time_ms: i64
) -> i64:
    var next_ms: i64 = -1
    for instance in instances:  # cpu-lane-loop-ok: min over the live animation instances' next-tick times; bound is the instance count
        val candidate_ms = _simple_web_css_animation_instance_next_ms(
            instance, current_time_ms
        )
        if candidate_ms >= 0 and (next_ms < 0 or candidate_ms < next_ms):
            next_ms = candidate_ms
    next_ms

fn _simple_web_layout_animation_schedule(
    styles: [Style], current_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance],
    frame_index: _SimpleWebAnimationFrameIndex
) -> _SimpleWebAnimationSchedule:
    var latest_end: i64 = -1
    var next_change: i64 = -1
    var style_index = 0
    while style_index < styles.len():  # cpu-lane-loop-ok: one pass over styles computing the frame's animation end/next timestamps; bound is the style count, once per animation-schedule build
        val st = styles[style_index]
        val keyframe_index = (
            frame_index.keyframes_by_name.get(st.animation_name) ?? -1
        )
        if (
            st.animation_name != "none" and
            st.animation_duration_ms > 0 and
            keyframe_index >= 0
        ):
            val target_key = frame_index.target_keys[style_index]
            val matched_index = (
                frame_index.instances_by_target.get(target_key) ?? -1
            )
            val matched = matched_index >= 0
            val paused = if matched:
                animation_instances[matched_index].paused
            else:
                bg_v = parse_color_any(bgs)
                background_gradient_from_v = 0u32
                background_gradient_to_v = 0u32
        else:
            bg_v = parse_color(bg)
            background_gradient_from_v = 0u32
            background_gradient_to_v = 0u32
    if bg_image.len() > 0:
        val image_lower = bg_image.trim().lower()
        if image_lower == "none":
            background_gradient_from_v = 0u32
            background_gradient_to_v = 0u32
        else:
            val gradient_from = parse_linear_gradient_color(bg_image, 0)
            val gradient_to = parse_linear_gradient_color(bg_image, 1)
            if gradient_from != 0u32 and gradient_to != 0u32:
                background_gradient_from_v = gradient_from
                background_gradient_to_v = gradient_to
    if bg_repeat.len() > 0:
        val repeat_lower = bg_repeat.trim().lower()
        if repeat_lower == "no-repeat" or repeat_lower == "repeat":
            background_repeat_v = repeat_lower
    if bg_size.len() > 0:
        val size_trimmed = bg_size.trim()
        val first_space = find_from(size_trimmed, " ", 0)
        val first_size = if first_space >= 0: size_trimmed.substring(0, first_space) else: size_trimmed
        if first_size.len() > 0:
            val sw = parse_int(first_size)
            if sw > 0:
                background_size_w_px_v = sw
        if first_space >= 0:
            val second_size = size_trimmed.substring(first_space + 1, size_trimmed.len()).trim()
            val sh = parse_int(second_size)
            if sh > 0:
                background_size_h_px_v = sh
        elif background_size_w_px_v > 0:
            background_size_h_px_v = background_size_w_px_v
    if bg_position.len() > 0:
        val pos_trimmed = bg_position.trim()
        val first_space = find_from(pos_trimmed, " ", 0)
        val first_pos = if first_space >= 0: pos_trimmed.substring(0, first_space) else: pos_trimmed
        if first_pos.len() > 0:
            background_position_x_px_v = parse_int(first_pos)
        if first_space >= 0:
            val second_pos = pos_trimmed.substring(first_space + 1, pos_trimmed.len()).trim()
            background_position_y_px_v = parse_int(second_pos)
    val bg_clip = decl_get(decls, "background-clip")
    if bg_clip.len() > 0:
        val bg_clip_norm = bg_clip.trim().lower()
        if bg_clip_norm == "border-box" or bg_clip_norm == "padding-box" or bg_clip_norm == "content-box":
            background_clip_v = bg_clip_norm
    val bg_origin = decl_get(decls, "background-origin")
    if bg_origin.len() > 0:
        val bg_origin_norm = bg_origin.trim().lower()
        if bg_origin_norm == "border-box" or bg_origin_norm == "padding-box" or bg_origin_norm == "content-box":
            background_origin_v = bg_origin_norm
    val col = decl_get(decls, "color")
    if col.len() > 0:
        val cv = parse_color(col)
        if cv != 0u32:
            fg_v = cv
    val fs = decl_get(decls, "font-size")
    val fs_pos = decl_last_pos(decls, "font-size")
    if fs.len() > 0 and (font_pos < 0 or fs_pos > font_pos):
        val v = parse_int(fs)
        if v > 0:
            font_size_v = v
    val font_size_adjust_decl = decl_get(decls, "font-size-adjust")
    if font_size_adjust_decl.len() > 0:
        val font_size_adjust_norm = font_size_adjust_decl.trim().lower()
        if font_size_adjust_norm == "none" or font_size_adjust_norm == "from-font" or parse_int(font_size_adjust_norm) >= 0:
            font_size_adjust_v = font_size_adjust_norm
    val font_palette_decl = decl_get(decls, "font-palette")
    if font_palette_decl.len() > 0:
        val font_palette_norm = font_palette_decl.trim().lower()
        if font_palette_norm == "normal" or font_palette_norm == "light" or font_palette_norm == "dark":
            font_palette_v = font_palette_norm
    val font_feature_settings_decl = decl_get(decls, "font-feature-settings")
    if font_feature_settings_decl.len() > 0:
        val font_feature_settings_norm = font_feature_settings_decl.trim().lower()
        if font_feature_settings_norm.len() > 0:
            font_feature_settings_v = font_feature_settings_norm
    val line_height = decl_get(decls, "line-height")
    val line_height_pos = decl_last_pos(decls, "line-height")
    if line_height.len() > 0 and (font_pos < 0 or line_height_pos > font_pos):
        val parsed_line_height = parse_line_height_value(line_height)
        if parsed_line_height != 0:
            line_height_v = parsed_line_height
    val width = decl_get(decls, "width")
    if width.len() > 0:
        if width.ends_with("%"):
            # Percentage width: store as a negative sentinel (resolved against the
            # parent's available width at layout time, where it is known).
            val wp = parse_int(width)
            width_v = if wp > 0: 0 - wp else: 0
        else:
            width_v = parse_int(width)
    val height = decl_get(decls, "height")
    if height.len() > 0:
        if height.ends_with("%"):
            val hp = parse_int(height)
            height_v = if hp > 0: 0 - hp else: 0
        else:
            height_v = parse_int(height)
    val box_sizing = decl_get(decls, "box-sizing")
    if box_sizing.len() > 0:
        border_box_v = box_sizing == "border-box"
    val border_radius = decl_get(decls, "border-radius")
    if border_radius.len() > 0:
        val radius_v = parse_int(border_radius)
        border_radius_px_v = if radius_v > 0: radius_v else: 0
        border_radius_tl_px_v = border_radius_px_v
        border_radius_tr_px_v = border_radius_px_v
        border_radius_br_px_v = border_radius_px_v
        border_radius_bl_px_v = border_radius_px_v
    val border_top_left_radius = decl_get(decls, "border-top-left-radius")
    if border_top_left_radius.len() > 0:
        val r_tl = parse_int(border_top_left_radius)
        border_radius_tl_px_v = if r_tl > 0: r_tl else: 0
    val border_top_right_radius = decl_get(decls, "border-top-right-radius")
    if border_top_right_radius.len() > 0:
        val r_tr = parse_int(border_top_right_radius)
        border_radius_tr_px_v = if r_tr > 0: r_tr else: 0
    val border_bottom_right_radius = decl_get(decls, "border-bottom-right-radius")
    if border_bottom_right_radius.len() > 0:
        val r_br = parse_int(border_bottom_right_radius)
        border_radius_br_px_v = if r_br > 0: r_br else: 0
    val border_bottom_left_radius = decl_get(decls, "border-bottom-left-radius")
    if border_bottom_left_radius.len() > 0:
        val r_bl = parse_int(border_bottom_left_radius)
        border_radius_bl_px_v = if r_bl > 0: r_bl else: 0
    val min_width = decl_get(decls, "min-width")
    if min_width.len() > 0:
        min_width_v = parse_int(min_width)
    val max_width = decl_get(decls, "max-width")
    if max_width.len() > 0:
        max_width_v = parse_int(max_width)
    val min_height = decl_get(decls, "min-height")
    if min_height.len() > 0:
        if min_height.contains("vh"):
            min_height_vh_v = true
        else:
            min_height_v = parse_int(min_height)
    val max_height = decl_get(decls, "max-height")
    if max_height.len() > 0:
        max_height_v = parse_int(max_height)
    val flex = decl_get(decls, "flex")
    if flex.len() > 0:
        val flex_grow_raw = parse_nth_int(flex, 0)
        if flex_grow_raw >= 0:
            flex_grow_v = flex_grow_raw
        val flex_shrink_raw = parse_nth_int(flex, 1)
        if flex_shrink_raw >= 0:
            flex_shrink_v = flex_shrink_raw
        val flex_basis_raw = parse_nth_int(flex, 2)
        if flex_basis_raw > 0:
            flex_basis_px_v = flex_basis_raw
    val flex_grow_decl = decl_get(decls, "flex-grow")
    if flex_grow_decl.len() > 0:
        val grow_v = parse_int(flex_grow_decl)
        if grow_v > 0:
            flex_grow_v = grow_v
    val flex_shrink_decl = decl_get(decls, "flex-shrink")
    if flex_shrink_decl.len() > 0:
        val shrink_v = parse_int(flex_shrink_decl)
        if shrink_v >= 0:
            flex_shrink_v = shrink_v
    val flex_basis_decl = decl_get(decls, "flex-basis")
    if flex_basis_decl.len() > 0:
        val basis_v = parse_int(flex_basis_decl)
        if basis_v > 0:
            flex_basis_px_v = basis_v
    val order_decl = decl_get(decls, "order")
    if order_decl.len() > 0:
        order_v = parse_int(order_decl)
    val display_decl = decl_get(decls, "display")
    if display_decl.len() > 0:
        if display_decl == "none":
            display_v = "none"
        elif display_decl == "inline":
            display_v = "inline"
        elif display_decl == "flex":
            display_v = "flex"
        elif display_decl == "contents":
            display_v = "contents"
        else:
            display_v = "block"
    val overflow_decl = decl_get(decls, "overflow")
    if overflow_decl.len() > 0:
        overflow_hidden_v = overflow_decl == "hidden"
        if overflow_decl == "auto" or overflow_decl == "scroll":
            overflow_auto_y_v = true
    val overflow_x_decl = decl_get(decls, "overflow-x")
    if overflow_x_decl.len() > 0:
        if overflow_x_decl == "hidden":
            overflow_hidden_v = true
    val overflow_y_decl = decl_get(decls, "overflow-y")
    if overflow_y_decl.len() > 0:
        if overflow_y_decl == "hidden":
            overflow_hidden_v = true
        if overflow_y_decl == "auto" or overflow_y_decl == "scroll":
            overflow_auto_y_v = true
    if overflow_x_decl == "hidden" and overflow_y_decl == "visible":
        overflow_auto_y_v = true
    val contain_decl = decl_get(decls, "contain")
    if contain_decl.len() > 0:
        val contain_norm = contain_decl.trim().lower()
        if contain_norm.contains("paint") or contain_norm == "content" or contain_norm == "strict":
            overflow_hidden_v = true
    val scrollbar_width_decl = decl_get(decls, "scrollbar-width")
    if scrollbar_width_decl.len() > 0:
        val scrollbar_width_norm = scrollbar_width_decl.trim().lower()
        if scrollbar_width_norm == "none":
            overflow_auto_y_v = false
    val scrollbar_color_decl = decl_get(decls, "scrollbar-color")
    if scrollbar_color_decl.len() > 0:
        val scrollbar_color_norm = scrollbar_color_decl.trim().lower()
        if scrollbar_color_norm != "auto":
            val scrollbar_color_parts = scrollbar_color_norm.split(" ")
            if scrollbar_color_parts.len() >= 2:
                val thumb_color = parse_color_any(scrollbar_color_parts[0])
                val track_color = parse_color_any(scrollbar_color_parts[1])
                if thumb_color != 0u32 and track_color != 0u32:
                    scrollbar_thumb_color_v = thumb_color
                    scrollbar_track_color_v = track_color
    val text_overflow_decl = decl_get(decls, "text-overflow")
    if text_overflow_decl.len() > 0:
        val text_overflow_norm = text_overflow_decl.trim().lower()
        text_overflow_ellipsis_v = text_overflow_norm == "ellipsis"
    val visibility_decl = decl_get(decls, "visibility")
    if visibility_decl.len() > 0:
        if visibility_decl == "hidden":
            visibility_hidden_v = true
        elif visibility_decl == "visible":
            visibility_hidden_v = false
    val content_visibility_decl = decl_get(decls, "content-visibility")
    if content_visibility_decl.len() > 0:
        val content_visibility_norm = content_visibility_decl.trim().lower()
        if content_visibility_norm == "hidden":
            content_visibility_hidden_v = true
        elif content_visibility_norm == "visible" or content_visibility_norm == "auto":
            content_visibility_hidden_v = false
    val position_decl = decl_get(decls, "position")
    if position_decl.len() > 0:
        if position_decl == "relative":
            position_relative_v = true
            position_absolute_v = false
        elif position_decl == "absolute":
            position_relative_v = false
            position_absolute_v = true
        else:
            position_relative_v = false
            position_absolute_v = false
    val left_decl = decl_get(decls, "left")
    if left_decl.len() > 0:
        left_px_v = parse_int(left_decl)
    val top_decl = decl_get(decls, "top")
    if top_decl.len() > 0:
        top_px_v = parse_int(top_decl)
    val right_decl = decl_get(decls, "right")
    if right_decl.len() > 0:
        right_px_v = parse_int(right_decl)
    val bottom_decl = decl_get(decls, "bottom")
    if bottom_decl.len() > 0:
        bottom_px_v = parse_int(bottom_decl)
    val z_index_decl = decl_get(decls, "z-index")
    if z_index_decl.len() > 0:
        z_index_v = parse_int(z_index_decl)
    val opacity_decl = decl_get(decls, "opacity")
    if opacity_decl.len() > 0:
        opacity_pct_v = parse_opacity_pct(opacity_decl)
    val transform_decl = decl_get(decls, "transform")
    if transform_decl.len() > 0:
        val translate_x = parse_transform_translate_x(transform_decl)
        val translate_y = parse_transform_translate_y(transform_decl)
        if translate_x != 0 or translate_y != 0:
            left_px_v = left_px_v + translate_x
            top_px_v = top_px_v + translate_y
            position_relative_v = true
    val transform_origin_decl = decl_get(decls, "transform-origin")
    if transform_origin_decl.len() > 0:
        transform_origin_v = transform_origin_decl.trim().lower()
    val transform_box_decl = decl_get(decls, "transform-box")
    if transform_box_decl.len() > 0:
        val transform_box_norm = transform_box_decl.trim().lower()
        if transform_box_norm == "content-box" or transform_box_norm == "border-box" or transform_box_norm == "fill-box" or transform_box_norm == "stroke-box" or transform_box_norm == "view-box":
            transform_box_v = transform_box_norm
    val transform_style_decl = decl_get(decls, "transform-style")
    if transform_style_decl.len() > 0:
        val transform_style_norm = transform_style_decl.trim().lower()
        if transform_style_norm == "flat" or transform_style_norm == "preserve-3d":
            transform_style_v = transform_style_norm
    val flex_direction_decl = decl_get(decls, "flex-direction")
    if flex_direction_decl.len() > 0:
        if flex_direction_decl == "column":
            flex_direction_v = "column"
        else:
            flex_direction_v = "row"
    val flex_wrap_decl = decl_get(decls, "flex-wrap")
    if flex_wrap_decl.len() > 0:
        if flex_wrap_decl == "wrap" or flex_wrap_decl == "wrap-reverse" or flex_wrap_decl == "nowrap":
            flex_wrap_v = flex_wrap_decl
    val justify_content_decl = decl_get(decls, "justify-content")
    if justify_content_decl.len() > 0:
        val normalized_justify_content = normalize_overflow_box_alignment(justify_content_decl)
        if normalized_justify_content == "space-between" or normalized_justify_content == "space-around" or normalized_justify_content == "space-evenly" or normalized_justify_content == "center" or normalized_justify_content == "safe-center" or normalized_justify_content == "unsafe-center" or normalized_justify_content == "flex-end" or normalized_justify_content == "flex-start" or normalized_justify_content == "start" or normalized_justify_content == "end":
            justify_content_v = normalized_justify_content
    val ta = decl_get(decls, "text-align")
    if ta.len() > 0:
        text_align_v = ta
    val text_align_last_decl = decl_get(decls, "text-align-last")
    if text_align_last_decl.len() > 0:
        val text_align_last_norm = text_align_last_decl.trim().lower()
        if text_align_last_norm == "auto" or text_align_last_norm == "left" or text_align_last_norm == "right" or text_align_last_norm == "center" or text_align_last_norm == "start" or text_align_last_norm == "end":
            text_align_last_v = text_align_last_norm
    val text_transform_decl = decl_get(decls, "text-transform")
    if text_transform_decl.len() > 0:
        val text_transform_norm = text_transform_decl.trim().lower()
        if text_transform_norm == "uppercase" or text_transform_norm == "lowercase" or text_transform_norm == "capitalize" or text_transform_norm == "none":
            text_transform_v = text_transform_norm
    val text_indent_decl = decl_get(decls, "text-indent")
    if text_indent_decl.len() > 0:
        text_indent_px_v = parse_int(text_indent_decl)
    val letter_spacing_decl = decl_get(decls, "letter-spacing")
    if letter_spacing_decl.len() > 0:
        letter_spacing_px_v = parse_int(letter_spacing_decl)
    val word_spacing_decl = decl_get(decls, "word-spacing")
    if word_spacing_decl.len() > 0:
        word_spacing_px_v = parse_int(word_spacing_decl)
    val font_style_decl = decl_get(decls, "font-style")
    val font_style_pos = decl_last_pos(decls, "font-style")
    if font_style_decl.len() > 0 and (font_pos < 0 or font_style_pos > font_pos):
        val font_style_norm = font_style_decl.trim().lower()
        font_style_italic_v = font_style_norm == "italic" or font_style_norm == "oblique"
    val direction_decl = decl_get(decls, "direction")
    if direction_decl.len() > 0:
        val direction_norm = direction_decl.trim().lower()
        if direction_norm == "rtl":
            direction_rtl_v = true
        elif direction_norm == "ltr":
            direction_rtl_v = false
    val text_shadow_decl = decl_get(decls, "text-shadow")
    if text_shadow_decl.len() > 0:
        val text_shadow_norm = text_shadow_decl.trim().lower()
        if text_shadow_norm == "none":
            text_shadow_x_px_v = 0
            text_shadow_y_px_v = 0
            text_shadow_color_v = 0u32
        else:
            val shadow_x = parse_signed_nth_int(text_shadow_norm, 0)
            val shadow_y = parse_signed_nth_int(text_shadow_norm, 1)
            val shadow_color = parse_color_any(text_shadow_norm)
            if shadow_x != -1000000 and shadow_y != -1000000:
                text_shadow_x_px_v = shadow_x
                text_shadow_y_px_v = shadow_y
                text_shadow_color_v = if shadow_color != 0u32: shadow_color else: st.fg
    val text_decoration_decl = decl_get(decls, "text-decoration")
    if text_decoration_decl.len() > 0:
        val text_decoration_norm = text_decoration_decl.trim().lower()
        if text_decoration_norm == "none":
            text_decoration_underline_v = false
        elif text_decoration_norm.contains("underline"):
            text_decoration_underline_v = true
            val text_decoration_decl_color = parse_color_any(text_decoration_norm)
            if text_decoration_decl_color != 0u32:
                text_decoration_color_v = text_decoration_decl_color
    val text_decoration_line = decl_get(decls, "text-decoration-line")
    if text_decoration_line.len() > 0:
        val text_decoration_line_norm = text_decoration_line.trim().lower()
        if text_decoration_line_norm == "none":
            text_decoration_underline_v = false
        elif text_decoration_line_norm.contains("underline"):
            text_decoration_underline_v = true
    val text_decoration_color = decl_get(decls, "text-decoration-color")
    if text_decoration_color.len() > 0:
        val text_decoration_color_parsed = parse_color_any(text_decoration_color)
        if text_decoration_color_parsed != 0u32:
            text_decoration_color_v = text_decoration_color_parsed
    val text_decoration_style = decl_get(decls, "text-decoration-style")
    if text_decoration_style.len() > 0:
        val text_decoration_style_norm = text_decoration_style.trim().lower()
        if text_decoration_style_norm == "solid" or text_decoration_style_norm == "double" or text_decoration_style_norm == "dashed" or text_decoration_style_norm == "dotted" or text_decoration_style_norm == "wavy":
            text_decoration_style_v = text_decoration_style_norm
    val text_decoration_thickness = decl_get(decls, "text-decoration-thickness")
    if text_decoration_thickness.len() > 0:
        val text_decoration_thickness_norm = text_decoration_thickness.trim().lower()
        if text_decoration_thickness_norm == "auto" or text_decoration_thickness_norm == "from-font":
            text_decoration_thickness_px_v = 1
        else:
            val parsed_thickness = parse_int(text_decoration_thickness_norm)
            if parsed_thickness > 0:
                text_decoration_thickness_px_v = parsed_thickness
    val text_underline_offset = decl_get(decls, "text-underline-offset")
    if text_underline_offset.len() > 0:
        val text_underline_offset_norm = text_underline_offset.trim().lower()
        if text_underline_offset_norm == "auto":
