fn _simple_web_extract_keyframes(html: text) -> KeyframeRegistry:
    if not _simple_web_html_source_admitted(
        html, SIMPLE_WEB_MAX_HTML_BYTES
    ):
        return KeyframeRegistry.new()
    extract_keyframes(html)

pub fn simple_web_layout_debug_layout_by_id(html: text, width: i32, height: i32, id: text, field: text) -> text:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    # Pass every parameter explicitly. An omitted trailing default was
    # observed taking a non-default value in the freestanding SimpleOS kernel
    # build (the `trace_stages` receipt fired from this call site even though
    # the only trace-enabled caller never ran), so this render path does not
    # rely on default-argument materialization.
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    var i = 0
    while i < node_count:
        val node = nodes[i]
        if node.id_attr == id:
            val x = boxes.bx[i]
            val y = boxes.by[i]
            val w = boxes.bw[i]
            val h = boxes.bh[i]
            if field == "x": return x.to_string()
            if field == "y": return y.to_string()
            if field == "w": return w.to_string()
            if field == "h": return h.to_string()
        i = i + 1
    ""

fn _simple_web_layout_element(node: HNode) -> bool:
    (
        node.tag != "#text" and node.tag != "style" and
        node.tag != "script" and node.tag != "title" and
        node.tag != "head" and node.tag != "meta" and
        node.tag != "link" and node.tag != "base"
    )

fn _simple_web_element_child_ordinal(
    nodes: [HNode], child_index: HtmlChildIndex,
    parent_index: i32, target_index: i32
) -> i32:
    var ordinal = 0
    var child = child_index.first_child[parent_index]
    while child >= 0:
        if _simple_web_layout_element(nodes[child]):
            if child == target_index:
                return ordinal
            ordinal = ordinal + 1
        child = child_index.next_sibling[child]
    -1

fn _simple_web_node_target_key(
    nodes: [HNode], child_index: HtmlChildIndex, node_index: i32
) -> text:
    if node_index < 0 or node_index >= nodes.len():
        return ""
    var body = node_index
    while body >= 0 and nodes[body].tag != "body":
        body = nodes[body].parent.to_i32()
    if body < 0:
        return ""
    if node_index == body:
        return "path:"
    var reversed: [i32] = [0; nodes.len()]
    var depth = 0
    var current = node_index
    while current != body and current >= 0:
        val parent = nodes[current].parent.to_i32()
        if parent < 0:
            return ""
        val ordinal = _simple_web_element_child_ordinal(
            nodes, child_index, parent, current
        )
        if ordinal < 0:
            return ""
        reversed[depth] = ordinal
        depth = depth + 1
        current = parent
    var path = "path:"
    var part = depth - 1
    while part >= 0:
        if part < depth - 1:
            path = path + "/"
        path = path + reversed[part].to_text()
        part = part - 1
    path

class _SimpleWebAnimationFrameIndex:
    target_keys: [text]
    signatures: [text]
    keyframes_by_name: Dict<text, i32>
    instances_by_target: Dict<text, i32>

class _SimpleWebAnimationApplyResult:
    styles: [Style]
    property_work_count: i64

class _SimpleWebAnimationSchedule:
    animation_end_ms: i64
    animation_next_ms: i64

fn _simple_web_animation_target_keys(
    nodes: [HNode], child_index: HtmlChildIndex
) -> [text]:
    var target_keys = [""; nodes.len()]
    var body_index = -1
    var node_index = 0
    while node_index < nodes.len():
        if nodes[node_index].tag == "body":
            body_index = node_index
            target_keys[node_index] = "path:"
            break
        node_index = node_index + 1
    if body_index < 0:
        return target_keys

    var parent_index = body_index
    while parent_index < nodes.len():
        if target_keys[parent_index] != "":
            var ordinal = 0
            var child = child_index.first_child[parent_index]
            while child >= 0:
                if _simple_web_layout_element(nodes[child]):
                    val separator = if target_keys[parent_index] == "path:":
                        ""
                    else:
                        "/"
                    target_keys[child] = (
                        target_keys[parent_index] + separator +
                        ordinal.to_text()
                    )
                    ordinal = ordinal + 1
                child = child_index.next_sibling[child]
        parent_index = parent_index + 1
    target_keys

fn _simple_web_hit_target_key(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, width: i32, height: i32, x: i32, y: i32
) -> text:
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        width, height
    )
    var best = -1
    var best_z = -2147483647
    var i = 0
    while i < nodes.len():
        val node = nodes[i]
        val style = styles[i]
        val clip = paint_clip_at(clip_cache, i)
        val hit_x = x.to_i64()
        val hit_y = y.to_i64()
        val box_x = boxes.bx[i].to_i64()
        val box_y = boxes.by[i].to_i64()
        val inside = (
            boxes.bw[i] > 0 and boxes.bh[i] > 0 and
            hit_x >= box_x and hit_y >= box_y and
            hit_x < box_x + boxes.bw[i].to_i64() and
            hit_y < box_y + boxes.bh[i].to_i64() and
            x >= clip.x0 and y >= clip.y0 and
            x < clip.x1 and y < clip.y1
        )
        if (
            inside and node.tag != "#text" and node.tag != "#root" and
            style.display != "none" and not style.visibility_hidden and
            not content_hidden_by_ancestor(nodes, styles, i) and
            (best < 0 or style.z_index > best_z or
             (style.z_index == best_z and i > best))
        ):
            best = i
            best_z = style.z_index
        i = i + 1
    if best < 0:
        return ""
    _simple_web_node_target_key(nodes, child_index, best)

pub fn simple_web_layout_hit_test_target_at_time(
    html: text, width: i32, height: i32,
    x: i32, y: i32, animation_time_ms: i64
) -> text:
    simple_web_layout_hit_test_target_at_time_with_animations(
        html, width, height, x, y, animation_time_ms, []
    )

pub fn simple_web_layout_hit_test_target_at_time_with_animations(
    html: text, width: i32, height: i32,
    x: i32, y: i32, animation_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance]
) -> text:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    var styles = compute_styles(nodes, rules, child_index, false, true)
    if animation_time_ms >= 0:
        val registry = _simple_web_extract_keyframes(html)
        if registry.entries.len() > 0:
            val frame_index = _simple_web_animation_frame_index(
                styles, nodes, child_index, registry, animation_instances,
                false
            )
            val animation_apply = _apply_css_animations(
                nodes, styles, registry, animation_time_ms,
                animation_instances, frame_index
            )
            styles = animation_apply.styles
    val node_count = nodes.len() as i32
    val boxes = layout(
        nodes, styles, child_index, 0, 0, 0, width, height,
        zero_i32_list(node_count), zero_i32_list(node_count),
        zero_i32_list(node_count), zero_i32_list(node_count),
        empty_i32_lists(node_count), empty_i32_lists(node_count),
        neg_one_i32_list(node_count)
    )
    _simple_web_hit_target_key(
        nodes, styles, child_index, boxes, width, height, x, y
    )

pub struct SimpleWebInputTextHitMap:
    target_key: text
    x: i32
