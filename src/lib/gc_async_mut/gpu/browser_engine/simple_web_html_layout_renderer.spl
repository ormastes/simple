export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.*
export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_layout.*

use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    DrawIrComposition,
    draw_ir_batch_with_source,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_group_command,
    draw_ir_source_html_ast
}
use std.common.web.browser_renderer_protocol.{
    BrowserTextInputOverlay, browser_text_input_overlay_empty
}
use common.render_scene.scene.{SceneCommand, scene_fill_rect}
use common.ui.web_render_api.{
    WEB_RENDER_ENGINE2D_STATUS_RENDERED,
    WEB_RENDER_ENGINE2D_STATUS_UNAVAILABLE,
    WebRenderMaterialFallbackProvenance
}
use std.common.crypto.sha256.{sha256_text}
use std.common.animation.timing.{evaluate_timing, parse_timing_function}
use std.gc_async_mut.gpu.browser_engine.style_block_parse.{extract_keyframes, KeyframeRegistry}
use std.gc_async_mut.gpu.browser_engine.style.animation.{sample_keyframes, animation_css_value_text}

pub fn simple_web_layout_debug_layout_by_id(html: text, width: i32, height: i32, id: text, field: text) -> text:
    _simple_web_use_hosted_font_metrics()
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    # Pass every parameter explicitly. An omitted trailing default was
    # observed taking a non-default value in the freestanding SimpleOS kernel
    # build (the `trace_stages` receipt fired from this call site even though
    # the only trace-enabled caller never ran), so this render path does not
    # rely on default-argument materialization.
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    var i = 0
    while i < node_count:
        val node = nodes[i]
        if node.id_attr == id:
            val x = boxes.bx[i]
            val y = boxes.by[i]
            val w = boxes.bw[i]
            val h = boxes.bh[i]
            if field == "x": return x.to_string()
            if field == "y": return y.to_string()
            if field == "w": return w.to_string()
            if field == "h": return h.to_string()
        i = i + 1
    ""

fn _simple_web_layout_element(node: HNode) -> bool:
    (
        node.tag != "#text" and node.tag != "style" and
        node.tag != "script" and node.tag != "title" and
        node.tag != "head" and node.tag != "meta" and
        node.tag != "link" and node.tag != "base"
    )

fn _simple_web_element_child_ordinal(
    nodes: [HNode], child_index: HtmlChildIndex,
    parent_index: i32, target_index: i32
) -> i32:
    var ordinal = 0
    var child = child_index.first_child[parent_index]
    while child >= 0:
        if _simple_web_layout_element(nodes[child]):
            if child == target_index:
                return ordinal
            ordinal = ordinal + 1
        child = child_index.next_sibling[child]
    -1

fn _simple_web_node_target_key(
    nodes: [HNode], child_index: HtmlChildIndex, node_index: i32
) -> text:
    if node_index < 0 or node_index >= nodes.len():
        return ""
    if nodes[node_index].id_attr != "":
        return "id:{nodes[node_index].id_attr}"
    var body = node_index
    while body >= 0 and nodes[body].tag != "body":
        body = nodes[body].parent.to_i32()
    if body < 0:
        return ""
    if node_index == body:
        return "path:"
    var reversed: [i32] = [0; nodes.len()]
    var depth = 0
    var current = node_index
    while current != body and current >= 0:
        val parent = nodes[current].parent.to_i32()
        if parent < 0:
            return ""
        val ordinal = _simple_web_element_child_ordinal(
            nodes, child_index, parent, current
        )
        if ordinal < 0:
            return ""
        reversed[depth] = ordinal
        depth = depth + 1
        current = parent
    var path = "path:"
    var part = depth - 1
    while part >= 0:
        if part < depth - 1:
            path = path + "/"
        path = path + reversed[part].to_text()
        part = part - 1
    path

fn _simple_web_hit_target_key(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, x: i32, y: i32
) -> text:
    var best = -1
    var best_z = -2147483647
    var i = 0
    while i < nodes.len():
        val node = nodes[i]
        val style = styles[i]
        val inside = (
            boxes.bw[i] > 0 and boxes.bh[i] > 0 and
            x >= boxes.bx[i] and y >= boxes.by[i] and
            x < boxes.bx[i] + boxes.bw[i] and
            y < boxes.by[i] + boxes.bh[i]
        )
        if (
            inside and node.tag != "#text" and node.tag != "#root" and
            style.display != "none" and not style.visibility_hidden and
            not content_hidden_by_ancestor(nodes, styles, i) and
            (best < 0 or style.z_index > best_z or
             (style.z_index == best_z and i > best))
        ):
            best = i
            best_z = style.z_index
        i = i + 1
    if best < 0:
        return ""
    _simple_web_node_target_key(nodes, child_index, best)

pub fn simple_web_layout_hit_test_target_at_time(
    html: text, width: i32, height: i32,
    x: i32, y: i32, animation_time_ms: i64
) -> text:
    _simple_web_use_hosted_font_metrics()
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    var styles = compute_styles(nodes, rules, child_index, false, true)
    if animation_time_ms >= 0:
        styles = _apply_css_animations(
            styles, extract_keyframes(html), animation_time_ms
        )
    val node_count = nodes.len() as i32
    val boxes = layout(
        nodes, styles, child_index, 0, 0, 0, width, height,
        zero_i32_list(node_count), zero_i32_list(node_count),
        zero_i32_list(node_count), zero_i32_list(node_count),
        empty_i32_lists(node_count), empty_i32_lists(node_count),
        neg_one_i32_list(node_count)
    )
    _simple_web_hit_target_key(
        nodes, styles, child_index, boxes, x, y
    )

pub struct SimpleWebInputTextHitMap:
    target_key: text
    x: i32
    y: i32
    width: i32
    height: i32
    source_boundary_bytes: [i64]
    boundary_x_px: [i32]

class SimpleWebLayoutHitIndex:
    nodes: [HNode]
    styles: [Style]
    child_index: HtmlChildIndex
    boxes: LayoutResult
    input_text_hits: [SimpleWebInputTextHitMap]

pub fn simple_web_layout_hit_test_index(
    index: SimpleWebLayoutHitIndex, x: i32, y: i32
) -> text:
    _simple_web_hit_target_key(
        index.nodes, index.styles, index.child_index, index.boxes, x, y
    )

class SimpleWebLayoutDrawIrResult:
    composition: DrawIrComposition
    material_fallback: WebRenderMaterialFallbackProvenance
    material_witness: SimpleWebLayoutMaterialWitness
    animation_end_ms: i64
    hit_index: SimpleWebLayoutHitIndex
    resolved_input_view_start_byte: i64
    status: text
    reason: text

class SimpleWebLayoutMaterialWitness:
    cpu_composited_count: i32
    cpu_composited_sha256: text
    solid_material_count: i32
    solid_material_sha256: text

struct _SimpleWebInputTextHitBuild:
    target_keys: [text]
    hits: [SimpleWebInputTextHitMap]
    resolved_view_start_byte: i64

fn _simple_web_input_text_hit_build(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, width: i32, height: i32,
    overlay: BrowserTextInputOverlay
) -> _SimpleWebInputTextHitBuild:
    var target_keys: [text] = [""; nodes.len()]
    var hits: [SimpleWebInputTextHitMap] = []
    var resolved_view_start_byte = overlay.view_start_byte
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        width, height
    )
    var i = 0
    while i < nodes.len():
        if (
            nodes[i].tag == "input" and
            input_accepts_text_overlay(nodes[i]) and
            styles[i].display != "none" and
            not styles[i].visibility_hidden and
            boxes.bw[i] > 0 and boxes.bh[i] > 0
        ):
            val target_key = _simple_web_node_target_key(
                nodes, child_index, i
            )
            target_keys[i] = target_key
            val content_w = (
                boxes.bw[i] - styles[i].border_l - styles[i].border_r -
                styles[i].pad_l - styles[i].pad_r
            )
            val advance = style_text_advance(styles[i])
            val glyph_advance = if advance > 0: advance else: 1
            val plan = if target_key == overlay.target_key:
                input_text_paint_plan_with_overlay(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    paint_clip_at(clip_cache, i), overlay
                )
            else:
                input_text_paint_plan(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    paint_clip_at(clip_cache, i),
                    content_w / glyph_advance + 1
                )
            if target_key == overlay.target_key:
                resolved_view_start_byte = plan.resolved_view_start_byte
            hits.push(SimpleWebInputTextHitMap(
                target_key: target_key,
                x: plan.clip.x0,
                y: plan.clip.y0,
                width: plan.clip.x1 - plan.clip.x0,
                height: plan.clip.y1 - plan.clip.y0,
                source_boundary_bytes: plan.source_boundary_bytes,
                boundary_x_px: plan.boundary_x_px
            ))
        i = i + 1
    _SimpleWebInputTextHitBuild(
        target_keys: target_keys,
        hits: hits,
        resolved_view_start_byte: resolved_view_start_byte
    )

pub fn simple_web_layout_material_provenance_after_execution(witness: SimpleWebLayoutMaterialWitness, skipped_command_count: i32, pixel_count: i32, expected_pixel_count: i32, executed_cpu_material_count: i32) -> WebRenderMaterialFallbackProvenance:
    simple_web_layout_material_provenance_after_backend_execution(
        witness,
        skipped_command_count,
        pixel_count,
        expected_pixel_count,
        executed_cpu_material_count,
        0,
        "",
        "",
        0,
        0
    )

pub fn simple_web_layout_material_provenance_after_backend_execution(
    witness: SimpleWebLayoutMaterialWitness,
    skipped_command_count: i32,
    pixel_count: i32,
    expected_pixel_count: i32,
    executed_cpu_material_count: i32,
    executed_metal_material_count: i32,
    glass_execution_target: text,
    readback_source: text,
    glass_backend_handle: i64,
    glass_device_identity: i64
) -> WebRenderMaterialFallbackProvenance:
    if skipped_command_count != 0 or pixel_count != expected_pixel_count:
        return WebRenderMaterialFallbackProvenance.none()
    if witness.cpu_composited_count > 0:
        if (witness.cpu_composited_count ==
                executed_metal_material_count and
            executed_cpu_material_count == 0 and
            glass_execution_target == "metal-device-glass-v1" and
            readback_source == "device_readback" and
            glass_backend_handle > 0 and glass_device_identity > 0 and
            witness.cpu_composited_sha256.len() == 64):
            return WebRenderMaterialFallbackProvenance.metal_device_composited(
                witness.cpu_composited_sha256)
        if (witness.cpu_composited_count == executed_cpu_material_count and
            executed_metal_material_count == 0 and
            witness.cpu_composited_sha256.len() == 64):
            return WebRenderMaterialFallbackProvenance.cpu_composited(
                witness.cpu_composited_sha256)
        return WebRenderMaterialFallbackProvenance.none()
    if (executed_cpu_material_count != 0 or
        executed_metal_material_count != 0):
        return WebRenderMaterialFallbackProvenance.none()
    if (witness.solid_material_count > 0 and
        witness.solid_material_sha256.len() == 64):
        return WebRenderMaterialFallbackProvenance.solid(
            "cpu-raster-backdrop-sampling-unavailable",
            witness.solid_material_sha256)
    WebRenderMaterialFallbackProvenance.none()

pub fn simple_web_material_fallback_realized(declared: bool, bg: u32, gradient_from: u32, gradient_to: u32, layers_raw: text) -> bool:
    declared and ((bg >> 24) & 255u32) == 255u32 and gradient_from == 0u32 and gradient_to == 0u32 and layers_raw == ""

fn _simple_web_material_witness_from_sidecar(
    entries: [text], counts: [i64]
) -> SimpleWebLayoutMaterialWitness:
    if entries.len() < 2 or counts.len() < 2:
        return SimpleWebLayoutMaterialWitness(
            cpu_composited_count: 0,
            cpu_composited_sha256: "",
            solid_material_count: 0,
            solid_material_sha256: "")
    val cpu_count = counts[0]
    val solid_count = counts[1]
    SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_count as i32,
        cpu_composited_sha256:
            if cpu_count > 0: sha256_text(entries[0]) else: "",
        solid_material_count: solid_count as i32,
        solid_material_sha256:
            if solid_count > 0: sha256_text(entries[1]) else: "")

fn _animation_direction_progress(progress: f64, direction: text, iteration: i64) -> f64:
    if direction == "reverse":
        return 1.0 - progress
    if direction == "alternate" and iteration % 2 != 0:
        return 1.0 - progress
    if direction == "alternate-reverse" and iteration % 2 == 0:
        return 1.0 - progress
    progress

fn _animation_progress(st: Style, animation_time_ms: i64) -> f64?:
    if st.animation_name == "none" or st.animation_duration_ms <= 0:
        return nil
    val elapsed = if st.animation_play_state == "paused":
        0 - st.animation_delay_ms.to_i64()
    else:
        animation_time_ms - st.animation_delay_ms.to_i64()
    if elapsed < 0:
        if st.animation_fill_mode == "backwards" or st.animation_fill_mode == "both":
            return Some(_animation_direction_progress(0.0, st.animation_direction, 0))
        return nil
    val iteration_count = if st.animation_iteration_count == "infinite":
        -1
    else:
        val parsed = parse_int(st.animation_iteration_count).to_i64()
        if parsed > 0: parsed else: 1
    val duration = st.animation_duration_ms.to_i64()
    if iteration_count > 0 and elapsed >= duration * iteration_count:
        if st.animation_fill_mode != "forwards" and st.animation_fill_mode != "both":
            return nil
        return Some(_animation_direction_progress(
            1.0, st.animation_direction, iteration_count - 1
        ))
    val iteration = elapsed / duration
    val local = (elapsed % duration).to_f64() / duration.to_f64()
    val directed = _animation_direction_progress(local, st.animation_direction, iteration)
    Some(evaluate_timing(parse_timing_function(st.animation_timing_function), directed))

fn _apply_css_animations(
    styles: [Style], registry: KeyframeRegistry, animation_time_ms: i64
) -> [Style]:
    var animated = styles
    var style_index = 0
    while style_index < animated.len():
        val st = animated[style_index]
        if val Some(progress) = _animation_progress(st, animation_time_ms):
            for entry in registry.entries:
                if entry.name == st.animation_name:
                    val updates = sample_keyframes(
                        style_index.to_i64(), entry.frames, progress
                    )
                    var declarations = ""
                    for update in updates:
                        if declarations.len() > 0:
                            declarations = declarations + ";"
                        declarations = (
                            declarations + update.property + ":" +
                            animation_css_value_text(update.value)
                        )
                    if declarations.len() > 0:
                        animated[style_index] = apply_decls(
                            st, declarations, st.font_size
                        )
        style_index = style_index + 1
    animated

fn _simple_web_layout_animation_end_from_styles(
    styles: [Style], registry: KeyframeRegistry
) -> i64:
    var latest_end: i64 = -1
    for st in styles:
        if st.animation_name != "none" and st.animation_duration_ms > 0:
            var has_keyframes = false
            for entry in registry.entries:
                if entry.name == st.animation_name and entry.frames.len() > 0:
                    has_keyframes = true
            if has_keyframes:
                if st.animation_play_state == "paused":
                    if latest_end < 0:
                        latest_end = 0
                elif st.animation_iteration_count == "infinite":
                    return -2
                else:
                    val iterations = parse_int(st.animation_iteration_count)
                    val count = if iterations > 0: iterations else: 1
                    var animation_end = (
                        st.animation_delay_ms.to_i64() +
                        st.animation_duration_ms.to_i64() * count.to_i64()
                    )
                    if animation_end < 0:
                        animation_end = 0
                    if animation_end > latest_end:
                        latest_end = animation_end
    latest_end

pub fn simple_web_layout_animation_end_ms(
    html: text, width: i32
) -> i64:
    _simple_web_use_hosted_font_metrics()
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    _simple_web_layout_animation_end_from_styles(
        styles, extract_keyframes(html)
    )

fn _simple_web_layout_render_html_draw_ir_result_at_time(
    html: text, width: i32, height: i32, vector_fonts: bool,
    animation_time_ms: i64, overlay: BrowserTextInputOverlay
) -> SimpleWebLayoutDrawIrResult:
    val render_start_us = rt_time_now_micros()
    val env_override = _web_render_budget_ms_env_override()
    val area_floor_ms = (width as i64) * (height as i64) / 16
    val default_budget_ms = if area_floor_ms > WEB_RENDER_BUDGET_MS: area_floor_ms else: WEB_RENDER_BUDGET_MS
    val resolved_budget_ms = if env_override > 0: env_override else: default_budget_ms
    _web_budget_begin(resolved_budget_ms)
    val budget_us = resolved_budget_ms * 1000
    val nodes = parse_html(html)
    # Pass every parameter explicitly. An omitted trailing default was
    # observed taking a non-default value in the freestanding SimpleOS kernel
    # build (the `trace_stages` receipt fired from this call site even though
    # the only trace-enabled caller never ran), so this render path does not
    # rely on default-argument materialization.
    val rules = extract_css_vw(html, width, false)
    # A document that tokenizes but yields no element nodes is always a defect,
    # never honest content: every downstream stage (style, layout, material
    # provenance) then degrades silently while the frame still reports
    # "rendered". Report the inputs that separate an empty document from a
    # collapsed tokenizer so such a frame stays attributable.
    if nodes.len() <= 1:
        # `split_parts` comes from the runtime `split` builtin; `lt_portable`
        # counts the same "<" in plain Simple. On the 2026-07-26 SimpleOS run
        # this receipt read `html_len=5794 nodes=0 split_parts=18` — far too few
        # parts for 5.8 KB of markup — while every `[web-scan]` divergence and
        # bail receipt stayed silent, i.e. the collapse is upstream of the
        # tokenizer. These two counters separate the remaining candidates: if
        # they disagree, `split` truncated; if they agree and are both small,
        # the document handed to us was already short of markup and the defect
        # is in whoever produced it (scene_to_html).
        val split_parts = html.split("<").len()
        var lt_portable = 0
        var lt_scan = 0
        while lt_scan < html.len():
            if html.char_code_at(lt_scan) == 60:
                lt_portable = lt_portable + 1
            lt_scan = lt_scan + 1
        print "[web-layout] degenerate-parse html_len={html.len()} nodes={nodes.len()} split_parts={split_parts} lt_portable={lt_portable} rules={rules.group_parts.len()}"
        # 2026-07-26 guest run answered the counter question: split_parts=18,
        # lt_portable=17 — they AGREE, so `split` is honest and the document
        # really has only 17 tags in 5.8 KB. The producer is the defect. Dump
        # raw char codes (freestanding-safe: integers only, no text handles)
        # from the head and the middle so the next run shows what the bulk of
        # the document actually is.
        var head_codes = ""
        var dump_i = 0
        while dump_i < 96 and dump_i < html.len():
            head_codes = "{head_codes} {html.char_code_at(dump_i)}"
            dump_i = dump_i + 1
        print "[web-layout] degenerate-head-codes{head_codes}"
        var mid_codes = ""
        var mid_i = html.len() / 2
        val mid_end = mid_i + 96
        while mid_i < mid_end and mid_i < html.len():
            mid_codes = "{mid_codes} {html.char_code_at(mid_i)}"
            mid_i = mid_i + 1
        print "[web-layout] degenerate-mid-codes{mid_codes}"
        # 2026-07-26 second guest run: head decodes to a well-formed
        # `<!DOCTYPE html><html data-wm-theme=...` shell and the middle is the
        # <style> payload, and the HOST parses this exact shape to nodes=5 —
        # so the producer is honest and the collapse is a guest-side per-part
        # parse divergence. Dump each split part's opening codes so the next
        # guest run shows which parts the parser mis-classified.
        val dump_parts = html.split("<")
        var part_i = 1
        while part_i < dump_parts.len():
            val part = dump_parts[part_i]
            var part_codes = ""
            var pc = 0
            while pc < 12 and pc < part.len():
                part_codes = "{part_codes} {part.char_code_at(pc)}"
                pc = pc + 1
            print "[web-layout] degenerate-part i={part_i} len={part.len()} codes{part_codes}"
            part_i = part_i + 1
        # GROUP is intentionally unsupported by Engine2D, so the existing
        # skipped-command/status gates reject this frame instead of presenting
        # blank pixels as a successful render.
        val failed_source = draw_ir_source_html_ast(
            "simple_web_html_layout_renderer", "html", "", "", "",
            "degenerate-parse", "1")
        val failed_embedding = draw_ir_embedding_config(
            "html", "document", 0, 0, width, height, 0, 1000, true)
        val failed_batch = draw_ir_batch_with_source(
            "html-layout", DRAW_IR_BACKEND_CPU, failed_embedding,
            [draw_ir_group_command("degenerate-html-parse", "document")],
            failed_source)
        return SimpleWebLayoutDrawIrResult(
            composition: draw_ir_composition(
                "html-layout", "simple-web-html-layout",
                DRAW_IR_BACKEND_CPU, [failed_batch]),
            material_fallback: WebRenderMaterialFallbackProvenance.none(),
            material_witness: SimpleWebLayoutMaterialWitness(
                cpu_composited_count: 0,
                cpu_composited_sha256: "",
                solid_material_count: 0,
                solid_material_sha256: ""),
            animation_end_ms: -1,
            hit_index: SimpleWebLayoutHitIndex(
                nodes: [],
                styles: [],
                child_index: HtmlChildIndex(
                    first_child: [], next_sibling: [], child_count: []),
                boxes: LayoutResult(
                    bx: [], by: [], bw: [], bh: [],
                    wrap_starts: [], wrap_ends: [],
                    intrinsic_widths: [], height: 0),
                input_text_hits: []),
            resolved_input_view_start_byte: 0,
            status: WEB_RENDER_ENGINE2D_STATUS_UNAVAILABLE,
            reason: "degenerate-html-parse"
        )
    val child_index = build_child_index(nodes)
    _web_budget_rearm(render_start_us + budget_us * 7 / 10)
    var material_entries: [text] = ["", ""]
    var material_counts: [i64] = [0, 0]
    var styles = compute_styles_with_material(
        nodes, rules, child_index, false, vector_fonts,
        material_entries, material_counts)
    val animation_registry = extract_keyframes(html)
    val animation_end_ms = _simple_web_layout_animation_end_from_styles(
        styles, animation_registry
    )
    if animation_time_ms >= 0:
        styles = _apply_css_animations(
            styles, animation_registry, animation_time_ms
        )
    _web_budget_rearm(render_start_us + budget_us * 9 / 10)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    val source = draw_ir_source_html_ast("simple_web_html_layout_renderer", "html", "", "", "", "layout", "1")
    val embedding = draw_ir_embedding_config("html", "document", 0, 0, width, height, 0, 1000, true)
    val input_hit_build = _simple_web_input_text_hit_build(
        nodes, styles, child_index, boxes, width, height, overlay
    )
    var commands = _html_draw_ir_commands(
        nodes, styles, boxes, width, height, vector_fonts,
        input_hit_build.target_keys, overlay
    )
    val canvas_color = _web_canvas_background(nodes, styles, argb(255, 255, 255))
    commands = [_html_draw_ir_canvas_command(width, height, canvas_color)] + commands
    val batch = draw_ir_batch_with_source("html-layout", DRAW_IR_BACKEND_CPU, embedding, commands, source)
    val batches = [batch]
    val composition = draw_ir_composition("html-layout", "simple-web-html-layout", DRAW_IR_BACKEND_CPU, batches)
    val material_witness = _simple_web_material_witness_from_sidecar(
        material_entries, material_counts)
    SimpleWebLayoutDrawIrResult(
        composition: composition,
        material_fallback: simple_web_layout_material_provenance_after_execution(
            material_witness, 0, 1, 1, 0),
        material_witness: material_witness,
        animation_end_ms: animation_end_ms,
        hit_index: SimpleWebLayoutHitIndex(
            nodes: nodes,
            styles: styles,
            child_index: child_index,
            boxes: boxes,
            input_text_hits: input_hit_build.hits
        ),
        resolved_input_view_start_byte:
            input_hit_build.resolved_view_start_byte,
        status: WEB_RENDER_ENGINE2D_STATUS_RENDERED,
        reason: ""
    )

