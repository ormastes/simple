    if resolved_radii.valid:
        border_radius_tl_px_v = resolved_radii.top_left_px
        border_radius_tr_px_v = resolved_radii.top_right_px
        border_radius_br_px_v = resolved_radii.bottom_right_px
        border_radius_bl_px_v = resolved_radii.bottom_left_px
    val min_width = decl_tbl_get(decl_tbl, "min-width")
    val min_width_pos = decl_tbl_last_index(decl_tbl, "min-width")
    if min_width.len() > 0:
        min_width_v = parse_int(min_width)
    val max_width = decl_tbl_get(decl_tbl, "max-width")
    val max_width_pos = decl_tbl_last_index(decl_tbl, "max-width")
    if max_width.len() > 0:
        max_width_v = parse_int(max_width)
    val min_height = decl_tbl_get(decl_tbl, "min-height")
    val min_height_pos = decl_tbl_last_index(decl_tbl, "min-height")
    if min_height.len() > 0:
        if min_height.contains("vh"):
            min_height_vh_v = true
        else:
            min_height_vh_v = false
            min_height_v = parse_int(min_height)
    val max_height = decl_tbl_get(decl_tbl, "max-height")
    val max_height_pos = decl_tbl_last_index(decl_tbl, "max-height")
    if max_height.len() > 0:
        max_height_v = parse_int(max_height)
    val min_inline_size = decl_tbl_get(decl_tbl, "min-inline-size")
    val min_inline_size_pos = decl_tbl_last_index(decl_tbl, "min-inline-size")
    if min_inline_size.len() > 0:
        if logical_inline_is_height and min_inline_size_pos > min_height_pos:
            if min_inline_size.contains("vh"):
                min_height_vh_v = true
            else:
                min_height_vh_v = false
                min_height_v = parse_int(min_inline_size)
        elif not logical_inline_is_height and min_inline_size_pos > min_width_pos:
            min_width_v = parse_int(min_inline_size)
    val max_inline_size = decl_tbl_get(decl_tbl, "max-inline-size")
    val max_inline_size_pos = decl_tbl_last_index(decl_tbl, "max-inline-size")
    if max_inline_size.len() > 0:
        if logical_inline_is_height and max_inline_size_pos > max_height_pos:
            max_height_v = parse_int(max_inline_size)
        elif not logical_inline_is_height and max_inline_size_pos > max_width_pos:
            max_width_v = parse_int(max_inline_size)
    val min_block_size = decl_tbl_get(decl_tbl, "min-block-size")
    val min_block_size_pos = decl_tbl_last_index(decl_tbl, "min-block-size")
    if min_block_size.len() > 0:
        if logical_inline_is_height and min_block_size_pos > min_width_pos:
