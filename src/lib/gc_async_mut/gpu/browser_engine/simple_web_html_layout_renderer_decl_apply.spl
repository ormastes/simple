        if grow_v > 0:
            flex_grow_v = grow_v
    val flex_shrink_decl = decl_tbl_get(decl_tbl, "flex-shrink")
    if flex_shrink_decl.len() > 0:
        val shrink_v = parse_int(flex_shrink_decl)
        if shrink_v >= 0:
            flex_shrink_v = shrink_v
    val flex_basis_decl = decl_tbl_get(decl_tbl, "flex-basis")
    if flex_basis_decl.len() > 0:
        val basis_v = parse_supported_nonnegative_px(flex_basis_decl)
        if basis_v >= 0:
            flex_basis_px_v = basis_v
    val order_decl = decl_tbl_get(decl_tbl, "order")
    if order_decl.len() > 0:
        order_v = parse_int(order_decl)
    val float_decl = decl_tbl_get(decl_tbl, "float").trim()
    if float_decl.len() > 0:
        if float_decl == "left":
            float_mode_v = 1
        elif float_decl == "right":
            float_mode_v = 2
        elif float_decl == "none":
            float_mode_v = 0
    val display_decl = decl_tbl_get_last_valid_display(decl_tbl)
    if apply_display and display_decl.len() > 0:
        if display_decl == "none":
