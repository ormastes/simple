        )
    val inset_block_end = decl_tbl_get(decl_tbl, "inset-block-end")
    if inset_block_end.len() > 0 and decl_tbl_last_index(decl_tbl, "inset-block-end") > bottom_pos:
        bottom_px_v = parse_int(inset_block_end)
    val inset_inline_start = decl_tbl_get(decl_tbl, "inset-inline-start")
    if inset_inline_start.len() > 0 and decl_tbl_last_index(decl_tbl, "inset-inline-start") > left_pos:
        left_px_v = parse_int(inset_inline_start)
    val inset_inline_end = decl_tbl_get(decl_tbl, "inset-inline-end")
    if inset_inline_end.len() > 0 and decl_tbl_last_index(decl_tbl, "inset-inline-end") > right_pos:
        right_px_v = parse_int(inset_inline_end)
    val z_index_decl = decl_tbl_get(decl_tbl, "z-index")
    if z_index_decl.len() > 0:
        z_index_v = parse_int(z_index_decl)
    val opacity_decl = decl_tbl_get(decl_tbl, "opacity")
    if opacity_decl.len() > 0:
        opacity_pct_v = parse_opacity_pct(opacity_decl)
    val filter_decl = decl_tbl_get(decl_tbl, "filter")
    if filter_decl.len() > 0:
        val filter_opacity_pct = parse_filter_opacity_pct(filter_decl)
        if filter_opacity_pct >= 0:
            opacity_pct_v = (opacity_pct_v * filter_opacity_pct) / 100
    val clip_decl = decl_tbl_get(decl_tbl, "clip")
    if clip_decl.len() > 0:
        val clip_right = parse_clip_rect_value(clip_decl, 1)
        val clip_bottom = parse_clip_rect_value(clip_decl, 2)
        val clip_left = parse_clip_rect_value(clip_decl, 3)
        val clipped_w = clip_right - clip_left
        if clipped_w > 0 and width_v > 0 and clipped_w < width_v:
            width_v = clipped_w
        if clip_bottom > 0 and height_v > 0 and clip_bottom < height_v:
            height_v = clip_bottom
    val transform_decl = decl_tbl_get(decl_tbl, "transform")
    if transform_decl.len() > 0:
        if (
            position_sticky_v and
            transform_decl.trim().lower() != "none"
        ):
            top_px_v = SIMPLE_WEB_STICKY_TOP_AUTO
        else:
            val translate_x = parse_transform_translate_x(transform_decl)
            val translate_y = parse_transform_translate_y(transform_decl)
            if translate_x != 0 or translate_y != 0:
                left_px_v = left_px_v + translate_x
                top_px_v = top_px_v + translate_y
                position_relative_v = true
            val transform_scale_pct = parse_transform_scale_pct(
                transform_decl
            )
            if transform_scale_pct != 100:
                if width_v > 0:
                    width_v = (width_v * transform_scale_pct) / 100
                if height_v > 0:
                    height_v = (height_v * transform_scale_pct) / 100
            if (
                parse_transform_rotate_quarter_turn(transform_decl) and
                width_v > 0 and height_v > 0
            ):
                val old_width = width_v
                width_v = height_v
                height_v = old_width
    val translate_decl = decl_tbl_get(decl_tbl, "translate")
    if translate_decl.len() > 0:
        if (
            position_sticky_v and
            translate_decl.trim().lower() != "none"
        ):
            top_px_v = SIMPLE_WEB_STICKY_TOP_AUTO
        else:
            val individual_translate_x = parse_individual_translate_x(
                translate_decl
            )
            val individual_translate_y = parse_individual_translate_y(
                translate_decl
            )
            if individual_translate_x != 0 or individual_translate_y != 0:
                left_px_v = left_px_v + individual_translate_x
                top_px_v = top_px_v + individual_translate_y
                position_relative_v = true
    val scale_decl = decl_tbl_get(decl_tbl, "scale")
    if scale_decl.len() > 0:
        val scale_pct = parse_scale_pct(scale_decl)
        if scale_pct != 100:
            if width_v > 0:
                width_v = (width_v * scale_pct) / 100
            if height_v > 0:
                height_v = (height_v * scale_pct) / 100
    val rotate_decl = decl_tbl_get(decl_tbl, "rotate")
    if rotate_decl.len() > 0:
        if parse_rotate_quarter_turn(rotate_decl) and width_v > 0 and height_v > 0:
            val old_width = width_v
            width_v = height_v
            height_v = old_width
    val transform_origin_decl = decl_tbl_get(decl_tbl, "transform-origin")
    if transform_origin_decl.len() > 0:
        transform_origin_v = transform_origin_decl.trim().lower()
    val transform_box_decl = decl_tbl_get(decl_tbl, "transform-box")
    if transform_box_decl.len() > 0:
        val transform_box_norm = transform_box_decl.trim().lower()
        if transform_box_norm == "content-box" or transform_box_norm == "border-box" or transform_box_norm == "fill-box" or transform_box_norm == "stroke-box" or transform_box_norm == "view-box":
            transform_box_v = transform_box_norm
    val transform_style_decl = decl_tbl_get(decl_tbl, "transform-style")
    if transform_style_decl.len() > 0:
        val transform_style_norm = transform_style_decl.trim().lower()
        if transform_style_norm == "flat" or transform_style_norm == "preserve-3d":
            transform_style_v = transform_style_norm
    val object_fit_decl = decl_tbl_get(decl_tbl, "object-fit")
    if object_fit_decl.len() > 0:
        val object_fit_norm = object_fit_decl.trim().lower()
        if object_fit_norm == "fill" or object_fit_norm == "contain" or object_fit_norm == "cover" or object_fit_norm == "none" or object_fit_norm == "scale-down":
            object_fit_v = object_fit_norm
    val image_rendering_decl = decl_tbl_get(decl_tbl, "image-rendering")
    if image_rendering_decl.len() > 0:
        val image_rendering_norm = image_rendering_decl.trim().lower()
        if image_rendering_norm == "auto" or image_rendering_norm == "smooth" or image_rendering_norm == "crisp-edges" or image_rendering_norm == "pixelated":
            image_rendering_v = image_rendering_norm
    val object_position_decl = decl_tbl_get(decl_tbl, "object-position")
    if object_position_decl.len() > 0:
        object_position_v = object_position_decl.trim().lower()
    val flex_direction_decl = decl_tbl_get(decl_tbl, "flex-direction")
    if flex_direction_decl.len() > 0:
        if flex_direction_decl == "column":
            flex_direction_v = "column"
        elif flex_direction_decl == "row-reverse":
            flex_direction_v = "row-reverse"
        else:
            flex_direction_v = "row"
    val flex_wrap_decl = decl_tbl_get(decl_tbl, "flex-wrap")
    if flex_wrap_decl.len() > 0:
        if flex_wrap_decl == "wrap" or flex_wrap_decl == "wrap-reverse" or flex_wrap_decl == "nowrap":
            flex_wrap_v = flex_wrap_decl
    val flex_flow_decl = decl_tbl_get(decl_tbl, "flex-flow")
    if flex_flow_decl.len() > 0:
        if css_word_contains(flex_flow_decl, "row-reverse"):
            flex_direction_v = "row-reverse"
        elif css_word_contains(flex_flow_decl, "column"):
            flex_direction_v = "column"
        elif css_word_contains(flex_flow_decl, "row"):
            flex_direction_v = "row"
        if css_word_contains(flex_flow_decl, "wrap-reverse"):
            flex_wrap_v = "wrap-reverse"
        elif css_word_contains(flex_flow_decl, "wrap"):
            flex_wrap_v = "wrap"
        elif css_word_contains(flex_flow_decl, "nowrap"):
            flex_wrap_v = "nowrap"
    val justify_content_decl = decl_tbl_get(decl_tbl, "justify-content")
    if justify_content_decl.len() > 0:
        val normalized_justify_content = normalize_overflow_box_alignment(justify_content_decl)
        if supports_content_distribution_alignment(normalized_justify_content):
            justify_content_v = normalized_justify_content
    val place_content_decl = decl_tbl_get(decl_tbl, "place-content")
    if place_content_decl.len() > 0:
        val normalized_place_content = normalize_overflow_box_alignment(place_content_decl)
        if supports_content_distribution_alignment(normalized_place_content):
            align_content_v = normalized_place_content
            justify_content_v = normalized_place_content
        else:
            val place_content_parts = normalized_place_content.split(" ")
            if place_content_parts.len() == 2:
                val place_align = normalize_overflow_box_alignment(place_content_parts[0])
                val place_justify = normalize_overflow_box_alignment(place_content_parts[1])
                if supports_align_content_alignment(place_align):
                    align_content_v = place_align
                if supports_content_distribution_alignment(place_justify):
                    justify_content_v = place_justify
    val ta = decl_tbl_get(decl_tbl, "text-align")
    if ta.len() > 0:
        text_align_v = ta
    val text_align_all_decl = decl_tbl_get(decl_tbl, "text-align-all")
    if text_align_all_decl.len() > 0:
        val text_align_all_norm = text_align_all_decl.trim().lower()
        if text_align_all_norm == "left" or text_align_all_norm == "right" or text_align_all_norm == "center" or text_align_all_norm == "start" or text_align_all_norm == "end" or text_align_all_norm == "justify":
            text_align_v = text_align_all_norm
    val text_align_last_decl = decl_tbl_get(decl_tbl, "text-align-last")
    if text_align_last_decl.len() > 0:
        val text_align_last_norm = text_align_last_decl.trim().lower()
        if text_align_last_norm == "auto" or text_align_last_norm == "left" or text_align_last_norm == "right" or text_align_last_norm == "center" or text_align_last_norm == "start" or text_align_last_norm == "end":
            text_align_last_v = text_align_last_norm
    val text_justify_decl = decl_tbl_get(decl_tbl, "text-justify")
    if text_justify_decl.len() > 0:
        val text_justify_norm = text_justify_decl.trim().lower()
        if text_justify_norm == "auto" or text_justify_norm == "none" or text_justify_norm == "inter-word" or text_justify_norm == "inter-character" or text_justify_norm == "distribute":
            text_justify_v = text_justify_norm
    val text_transform_decl = decl_tbl_get(decl_tbl, "text-transform")
    if text_transform_decl.len() > 0:
        val text_transform_norm = text_transform_decl.trim().lower()
        if text_transform_norm == "uppercase" or text_transform_norm == "lowercase" or text_transform_norm == "capitalize" or text_transform_norm == "none":
            text_transform_v = text_transform_norm
    val text_indent_decl = decl_tbl_get(decl_tbl, "text-indent")
    if text_indent_decl.len() > 0:
        text_indent_px_v = parse_int(text_indent_decl)
    val letter_spacing_decl = decl_tbl_get(decl_tbl, "letter-spacing")
    if letter_spacing_decl.len() > 0:
        letter_spacing_px_v = parse_int(letter_spacing_decl)
    val word_spacing_decl = decl_tbl_get(decl_tbl, "word-spacing")
    if word_spacing_decl.len() > 0:
        word_spacing_px_v = parse_int(word_spacing_decl)
    val font_style_decl = decl_tbl_get(decl_tbl, "font-style")
    val font_style_pos = decl_tbl_last_index(decl_tbl, "font-style")
    if font_style_decl.len() > 0 and (font_pos < 0 or font_style_pos > font_pos):
        val font_style_norm = font_style_decl.trim().lower()
        font_style_italic_v = font_style_norm == "italic" or font_style_norm == "oblique"
    val font_kerning_decl = decl_tbl_get(decl_tbl, "font-kerning")
    if font_kerning_decl.len() > 0:
        val font_kerning_norm = font_kerning_decl.trim().lower()
        if font_kerning_norm == "auto" or font_kerning_norm == "normal" or font_kerning_norm == "none":
            font_kerning_v = font_kerning_norm
    val font_optical_sizing_decl = decl_tbl_get(decl_tbl, "font-optical-sizing")
    if font_optical_sizing_decl.len() > 0:
        val font_optical_sizing_norm = font_optical_sizing_decl.trim().lower()
        if font_optical_sizing_norm == "auto" or font_optical_sizing_norm == "none":
            font_optical_sizing_v = font_optical_sizing_norm
    val font_language_override_decl = decl_tbl_get(decl_tbl, "font-language-override")
    if font_language_override_decl.len() > 0:
        val font_language_override_norm = font_language_override_decl.trim()
        val font_language_override_lower = font_language_override_norm.lower()
        if font_language_override_lower == "normal" or font_language_override_norm.starts_with("\"") or font_language_override_norm.starts_with("'"):
            font_language_override_v = font_language_override_norm
    val font_variation_settings_decl = decl_tbl_get(decl_tbl, "font-variation-settings")
    if font_variation_settings_decl.len() > 0:
        val font_variation_settings_norm = font_variation_settings_decl.trim()
        val font_variation_settings_lower = font_variation_settings_norm.lower()
        if font_variation_settings_lower == "normal" or font_variation_settings_norm.starts_with("\"") or font_variation_settings_norm.starts_with("'"):
            font_variation_settings_v = font_variation_settings_norm
    val font_variant_decl = decl_tbl_get(decl_tbl, "font-variant")
    if font_variant_decl.len() > 0:
        val font_variant_norm = font_variant_decl.trim().lower()
        if font_variant_norm.len() > 0:
            font_variant_v = font_variant_norm
    val font_variant_alternates_decl = decl_tbl_get(decl_tbl, "font-variant-alternates")
    if font_variant_alternates_decl.len() > 0:
        val font_variant_alternates_norm = font_variant_alternates_decl.trim().lower()
        if font_variant_alternates_norm == "normal" or font_variant_alternates_norm == "historical-forms" or font_variant_alternates_norm.contains("("):
            font_variant_alternates_v = font_variant_alternates_norm
    val font_variant_caps_decl = decl_tbl_get(decl_tbl, "font-variant-caps")
    if font_variant_caps_decl.len() > 0:
        val font_variant_caps_norm = font_variant_caps_decl.trim().lower()
        if font_variant_caps_norm == "normal" or font_variant_caps_norm == "small-caps" or font_variant_caps_norm == "all-small-caps" or font_variant_caps_norm == "petite-caps" or font_variant_caps_norm == "all-petite-caps" or font_variant_caps_norm == "unicase" or font_variant_caps_norm == "titling-caps":
            font_variant_caps_v = font_variant_caps_norm
    val font_variant_east_asian_decl = decl_tbl_get(decl_tbl, "font-variant-east-asian")
    if font_variant_east_asian_decl.len() > 0:
        val font_variant_east_asian_norm = font_variant_east_asian_decl.trim().lower()
        if font_variant_east_asian_norm == "normal" or font_variant_east_asian_norm == "ruby" or font_variant_east_asian_norm.starts_with("jis") or font_variant_east_asian_norm.contains("width") or font_variant_east_asian_norm.contains("simplified") or font_variant_east_asian_norm.contains("traditional"):
            font_variant_east_asian_v = font_variant_east_asian_norm
    val font_variant_emoji_decl = decl_tbl_get(decl_tbl, "font-variant-emoji")
    if font_variant_emoji_decl.len() > 0:
        val font_variant_emoji_norm = font_variant_emoji_decl.trim().lower()
        if font_variant_emoji_norm == "normal" or font_variant_emoji_norm == "text" or font_variant_emoji_norm == "emoji" or font_variant_emoji_norm == "unicode":
            font_variant_emoji_v = font_variant_emoji_norm
    val font_variant_ligatures_decl = decl_tbl_get(decl_tbl, "font-variant-ligatures")
    if font_variant_ligatures_decl.len() > 0:
        val font_variant_ligatures_norm = font_variant_ligatures_decl.trim().lower()
        if font_variant_ligatures_norm == "normal" or font_variant_ligatures_norm == "none" or font_variant_ligatures_norm.contains("ligatures"):
            font_variant_ligatures_v = font_variant_ligatures_norm
    val font_variant_numeric_decl = decl_tbl_get(decl_tbl, "font-variant-numeric")
    if font_variant_numeric_decl.len() > 0:
        val font_variant_numeric_norm = font_variant_numeric_decl.trim().lower()
        if font_variant_numeric_norm == "normal" or font_variant_numeric_norm == "ordinal" or font_variant_numeric_norm == "slashed-zero" or font_variant_numeric_norm.contains("-nums") or font_variant_numeric_norm.contains("fractions"):
            font_variant_numeric_v = font_variant_numeric_norm
    val font_variant_position_decl = decl_tbl_get(decl_tbl, "font-variant-position")
    if font_variant_position_decl.len() > 0:
        val font_variant_position_norm = font_variant_position_decl.trim().lower()
        if font_variant_position_norm == "normal" or font_variant_position_norm == "sub" or font_variant_position_norm == "super":
            font_variant_position_v = font_variant_position_norm
    val font_stretch_decl = decl_tbl_get(decl_tbl, "font-stretch")
    if font_stretch_decl.len() > 0:
        val font_stretch_norm = font_stretch_decl.trim().lower()
        if font_stretch_norm == "normal" or font_stretch_norm == "ultra-condensed" or font_stretch_norm == "extra-condensed" or font_stretch_norm == "condensed" or font_stretch_norm == "semi-condensed" or font_stretch_norm == "semi-expanded" or font_stretch_norm == "expanded" or font_stretch_norm == "extra-expanded" or font_stretch_norm == "ultra-expanded":
            font_stretch_v = font_stretch_norm
    val font_width_decl = decl_tbl_get(decl_tbl, "font-width")
    if font_width_decl.len() > 0:
        val font_width_norm = font_width_decl.trim().lower()
        if font_width_norm == "normal" or font_width_norm == "ultra-condensed" or font_width_norm == "extra-condensed" or font_width_norm == "condensed" or font_width_norm == "semi-condensed" or font_width_norm == "semi-expanded" or font_width_norm == "expanded" or font_width_norm == "extra-expanded" or font_width_norm == "ultra-expanded":
            font_width_v = font_width_norm
    val font_synthesis_decl = decl_tbl_get(decl_tbl, "font-synthesis")
    if font_synthesis_decl.len() > 0:
