        elif not logical_inline_is_height and min_block_size_pos > min_height_pos:
            if min_block_size.contains("vh"):
                min_height_vh_v = true
            else:
                min_height_vh_v = false
                min_height_v = parse_int(min_block_size)
    val max_block_size = decl_tbl_get(decl_tbl, "max-block-size")
    val max_block_size_pos = decl_tbl_last_index(decl_tbl, "max-block-size")
    if max_block_size.len() > 0:
        if logical_inline_is_height and max_block_size_pos > max_width_pos:
            max_width_v = parse_int(max_block_size)
        elif not logical_inline_is_height and max_block_size_pos > max_height_pos:
            max_height_v = parse_int(max_block_size)
    val flex = decl_tbl_get(decl_tbl, "flex")
    if flex.len() > 0:
        val flex_grow_raw = parse_nth_int(flex, 0)
        if flex_grow_raw >= 0:
