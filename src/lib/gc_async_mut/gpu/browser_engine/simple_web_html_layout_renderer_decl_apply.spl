        if text_decoration_style_norm == "solid" or text_decoration_style_norm == "double" or text_decoration_style_norm == "dashed" or text_decoration_style_norm == "dotted" or text_decoration_style_norm == "wavy":
            text_decoration_style_v = text_decoration_style_norm
    val text_decoration_thickness = decl_tbl_get(decl_tbl, "text-decoration-thickness")
    if text_decoration_thickness.len() > 0:
        val text_decoration_thickness_norm = text_decoration_thickness.trim().lower()
        if text_decoration_thickness_norm == "auto" or text_decoration_thickness_norm == "from-font":
