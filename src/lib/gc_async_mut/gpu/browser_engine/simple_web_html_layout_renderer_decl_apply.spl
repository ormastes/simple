    val font_synthesis_position_decl = decl_tbl_get(decl_tbl, "font-synthesis-position")
    if font_synthesis_position_decl.len() > 0:
        val font_synthesis_position_norm = font_synthesis_position_decl.trim().lower()
        if font_synthesis_position_norm == "auto" or font_synthesis_position_norm == "none":
            font_synthesis_position_v = font_synthesis_position_norm
    val font_synthesis_style_decl = decl_tbl_get(decl_tbl, "font-synthesis-style")
    if font_synthesis_style_decl.len() > 0:
        val font_synthesis_style_norm = font_synthesis_style_decl.trim().lower()
        if font_synthesis_style_norm == "auto" or font_synthesis_style_norm == "none":
            font_synthesis_style_v = font_synthesis_style_norm
    val font_synthesis_weight_decl = decl_tbl_get(decl_tbl, "font-synthesis-weight")
    if font_synthesis_weight_decl.len() > 0:
        val font_synthesis_weight_norm = font_synthesis_weight_decl.trim().lower()
        if font_synthesis_weight_norm == "auto" or font_synthesis_weight_norm == "none":
            font_synthesis_weight_v = font_synthesis_weight_norm
    val direction_decl = decl_tbl_get(decl_tbl, "direction")
    if direction_decl.len() > 0:
        val direction_norm = direction_decl.trim().lower()
        if direction_norm == "rtl":
            direction_rtl_v = true
        elif direction_norm == "ltr":
            direction_rtl_v = false
    val text_orientation_decl = decl_tbl_get(decl_tbl, "text-orientation")
    if text_orientation_decl.len() > 0:
        val text_orientation_norm = text_orientation_decl.trim().lower()
        if text_orientation_norm == "mixed" or text_orientation_norm == "upright" or text_orientation_norm == "sideways":
            text_orientation_v = text_orientation_norm
    val text_combine_upright_decl = decl_tbl_get(decl_tbl, "text-combine-upright")
    if text_combine_upright_decl.len() > 0:
        val text_combine_upright_norm = text_combine_upright_decl.trim().lower()
        if text_combine_upright_norm == "none" or text_combine_upright_norm == "all" or text_combine_upright_norm.starts_with("digits"):
            text_combine_upright_v = text_combine_upright_norm
    val text_shadow_decl = decl_tbl_get(decl_tbl, "text-shadow")
    if text_shadow_decl.len() > 0:
        val text_shadow_norm = text_shadow_decl.trim().lower()
        if text_shadow_norm == "none":
            text_shadow_x_px_v = 0
            text_shadow_y_px_v = 0
            text_shadow_color_v = 0u32
        else:
            val shadow_x = parse_signed_nth_int(text_shadow_norm, 0)
            val shadow_y = parse_signed_nth_int(text_shadow_norm, 1)
            val shadow_color = parse_color_any(text_shadow_norm)
            if shadow_x != -1000000 and shadow_y != -1000000:
                text_shadow_x_px_v = shadow_x
                text_shadow_y_px_v = shadow_y
                text_shadow_color_v = if shadow_color != 0u32: shadow_color else: st.fg
    val text_decoration_decl = decl_tbl_get(decl_tbl, "text-decoration")
    if text_decoration_decl.len() > 0:
        val text_decoration_norm = text_decoration_decl.trim().lower()
        if text_decoration_norm == "none":
            text_decoration_underline_v = false
            text_decoration_overline_v = false
            text_decoration_line_through_v = false
        else:
            # Independent `if`s, not an elif chain: CSS permits combinations
            # such as `text-decoration: underline line-through`.
            if text_decoration_norm.contains("underline"):
                text_decoration_underline_v = true
            if text_decoration_norm.contains("overline"):
                text_decoration_overline_v = true
            if text_decoration_norm.contains("line-through"):
                text_decoration_line_through_v = true
            val text_decoration_decl_color = parse_color_any(text_decoration_norm)
            if text_decoration_decl_color != 0u32:
                text_decoration_color_v = text_decoration_decl_color
    val text_decoration_line = decl_tbl_get(decl_tbl, "text-decoration-line")
    if text_decoration_line.len() > 0:
        val text_decoration_line_norm = text_decoration_line.trim().lower()
        if text_decoration_line_norm == "none":
            text_decoration_underline_v = false
            text_decoration_overline_v = false
            text_decoration_line_through_v = false
        else:
            if text_decoration_line_norm.contains("underline"):
                text_decoration_underline_v = true
            if text_decoration_line_norm.contains("overline"):
                text_decoration_overline_v = true
            if text_decoration_line_norm.contains("line-through"):
                text_decoration_line_through_v = true
    val text_decoration_color = decl_tbl_get(decl_tbl, "text-decoration-color")
    if text_decoration_color.len() > 0:
        val text_decoration_color_parsed = parse_color_any(text_decoration_color)
        if text_decoration_color_parsed != 0u32:
            text_decoration_color_v = text_decoration_color_parsed
    val text_decoration_style = decl_tbl_get(decl_tbl, "text-decoration-style")
    if text_decoration_style.len() > 0:
