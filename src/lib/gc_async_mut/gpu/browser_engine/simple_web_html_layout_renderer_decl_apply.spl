export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.*
export use std.gc_async_mut.gpu.browser_engine.simple_web_css_box_effects.*

fn _apply_decls_without_grid(
    st: Style, decls: text, decl_tbl: [text], em_base: i32,
    logical_writing_mode: text, apply_display: bool
) -> Style:
    if decls.len() == 0:
        return st
    # Per-rule declaration quota: a rule carrying more than the cap is dropped
    # wholesale (graceful — the cascade continues with the remaining rules).
    if _decl_over_quota(decls):
        return st
    # The caller parses the declaration block ONCE. Every lookup below reads
    # that shared table, including Grid and authored-metadata owners.
    # Ordering comparisons below use entry indices from `decl_tbl_last_index`,
    # which rank identically to the byte offsets `decl_last_pos` used to return.
    if _decl_tbl_all_dispatch_handled(decl_tbl):
        return _apply_decls_dispatch(st, decl_tbl, em_base, apply_display)
    var bg_v = st.bg
    var background_gradient_from_v = st.background_gradient_from
    var background_gradient_to_v = st.background_gradient_to
    # GAP-2: N-stop / angle / radial gradient model, additive alongside the
    # legacy from/to pair above.
    var background_gradient_stop_colors_v: [u32] = st.background_gradient_stop_colors
    var background_gradient_stop_positions_v: [i32] = st.background_gradient_stop_positions
    var background_gradient_angle_deg_v = st.background_gradient_angle_deg
    var background_gradient_is_radial_v = st.background_gradient_is_radial
    var background_repeat_v = st.background_repeat
    var background_size_w_px_v = st.background_size_w_px
    var background_size_h_px_v = st.background_size_h_px
    var background_position_x_px_v = st.background_position_x_px
    var background_position_y_px_v = st.background_position_y_px
    var background_clip_v = st.background_clip
    var background_origin_v = st.background_origin
    var background_attachment_v = st.background_attachment
    var background_image_uri_v = st.background_image_uri
    var fg_v = st.fg
    var font_size_v = st.font_size
    var font_family_v = st.font_family
    var line_height_v = st.line_height_px
    var width_v = st.width_px
    var height_v = st.height_px
    var border_box_v = st.border_box
    var border_collapse_v = st.border_collapse
    var min_width_v = st.min_width_px
    var max_width_v = st.max_width_px
    var min_height_v = st.min_height_px
    var max_height_v = st.max_height_px
    var min_height_vh_v = st.min_height_vh
    var flex_fill_v = st.flex_fill
    var flex_grow_v = st.flex_grow
    var flex_shrink_v = st.flex_shrink
    var flex_basis_px_v = st.flex_basis_px
    var order_v = st.order
    var flex_wrap_v = st.flex_wrap
    var justify_content_v = st.justify_content
    var align_items_v = st.align_items
    var align_self_v = st.align_self
    var align_content_v = st.align_content
    var pad_l_v = st.pad_l
    var pad_t_v = st.pad_t
    var pad_r_v = st.pad_r
    var pad_b_v = st.pad_b
    var border_w_v = st.border_w
    var border_color_v = st.border_color
    var border_l_v = st.border_l
    var border_t_v = st.border_t
    var border_r_v = st.border_r
    var border_b_v = st.border_b
    var border_color_l_v = st.border_color_l
    var border_color_t_v = st.border_color_t
    var border_color_r_v = st.border_color_r
    var border_color_b_v = st.border_color_b
    var border_style_l_v = st.border_style_l
    var border_style_r_v = st.border_style_r
    var outline_w_v = st.outline_w
    var outline_color_v = st.outline_color
    var outline_offset_px_v = st.outline_offset_px
    var box_shadow_x_px_v = st.box_shadow_x_px
    var box_shadow_y_px_v = st.box_shadow_y_px
    var box_shadow_color_v = st.box_shadow_color
    var box_shadow_blur_px_v = st.box_shadow_blur_px
    var box_shadow_alpha_v = st.box_shadow_alpha
    var box_shadow_raw_v = st.box_shadow_raw
    var bg_layers_raw_v = st.bg_layers_raw
    var backdrop_filter_raw_v = st.backdrop_filter_raw
    var border_radius_px_v = st.border_radius_px
    var border_radius_tl_px_v = st.border_radius_tl_px
    var border_radius_tr_px_v = st.border_radius_tr_px
    var border_radius_br_px_v = st.border_radius_br_px
    var border_radius_bl_px_v = st.border_radius_bl_px
    var gap_v = st.gap_px
    var row_gap_v = st.row_gap_px
    var column_gap_v = st.column_gap_px
    var margin_l_v = st.margin_l
    var margin_t_v = st.margin_t
    var margin_r_v = st.margin_r
    var margin_b_v = st.margin_b
    var margin_l_auto_v = st.margin_l_auto
    var margin_r_auto_v = st.margin_r_auto
    var margin_t_auto_v = st.margin_t_auto
    var margin_b_auto_v = st.margin_b_auto
    var display_v = st.display
    var float_mode_v = st.float_mode
    var overflow_hidden_v = st.overflow_hidden
    var overflow_auto_y_v = st.overflow_auto_y
    var overflow_scroll_y_v = st.overflow_scroll_y
    var scrollbar_thumb_color_v = st.scrollbar_thumb_color
    var scrollbar_track_color_v = st.scrollbar_track_color
    var text_overflow_ellipsis_v = st.text_overflow_ellipsis
    var visibility_hidden_v = st.visibility_hidden
    var content_visibility_hidden_v = st.content_visibility_hidden
    var will_change_v = st.will_change
    var color_adjust_v = st.color_adjust
    var forced_color_adjust_v = st.forced_color_adjust
    var print_color_adjust_v = st.print_color_adjust
    var orphans_v = st.orphans
    var widows_v = st.widows
    var position_relative_v = st.position_relative
    var position_absolute_v = st.position_absolute
    var position_sticky_v = st.position_sticky
    var position_fixed_v = st.position_fixed
    var left_px_v = st.left_px
    var top_px_v = st.top_px
    var right_px_v = st.right_px
    var bottom_px_v = st.bottom_px
    var z_index_v = st.z_index
    var opacity_pct_v = st.opacity_pct
    var flex_direction_v = st.flex_direction
    var text_align_v = st.text_align
    var text_align_last_v = st.text_align_last
    var text_justify_v = st.text_justify
    var text_transform_v = st.text_transform
    var text_indent_px_v = st.text_indent_px
    var letter_spacing_px_v = st.letter_spacing_px
    var word_spacing_px_v = st.word_spacing_px
    var font_size_adjust_v = st.font_size_adjust
    var font_palette_v = st.font_palette
    var font_feature_settings_v = st.font_feature_settings
    var font_language_override_v = st.font_language_override
    var font_variation_settings_v = st.font_variation_settings
    var font_variant_v = st.font_variant
    var font_variant_alternates_v = st.font_variant_alternates
    var font_variant_caps_v = st.font_variant_caps
    var font_variant_east_asian_v = st.font_variant_east_asian
    var font_variant_emoji_v = st.font_variant_emoji
    var font_variant_ligatures_v = st.font_variant_ligatures
    var font_variant_numeric_v = st.font_variant_numeric
    var font_variant_position_v = st.font_variant_position
    var font_style_italic_v = st.font_style_italic
    var font_kerning_v = st.font_kerning
    var font_optical_sizing_v = st.font_optical_sizing
    var font_stretch_v = st.font_stretch
    var font_width_v = st.font_width
    var font_synthesis_v = st.font_synthesis
    var font_synthesis_small_caps_v = st.font_synthesis_small_caps
    var font_synthesis_position_v = st.font_synthesis_position
    var font_synthesis_style_v = st.font_synthesis_style
    var font_synthesis_weight_v = st.font_synthesis_weight
    var direction_rtl_v = st.direction_rtl
    var writing_mode_v = st.writing_mode
    var text_orientation_v = st.text_orientation
    var text_combine_upright_v = st.text_combine_upright
    var text_shadow_x_px_v = st.text_shadow_x_px
    var text_shadow_y_px_v = st.text_shadow_y_px
    var text_shadow_color_v = st.text_shadow_color
    var text_decoration_color_v = st.text_decoration_color
    var text_decoration_underline_v = st.text_decoration_underline
    var text_decoration_overline_v = st.text_decoration_overline
    var text_decoration_line_through_v = st.text_decoration_line_through
    var text_decoration_style_v = st.text_decoration_style
    var text_decoration_thickness_px_v = st.text_decoration_thickness_px
    var text_underline_offset_px_v = st.text_underline_offset_px
    var text_underline_position_v = st.text_underline_position
    var white_space_nowrap_v = st.white_space_nowrap
    var overflow_wrap_v = st.overflow_wrap
    var line_break_v = st.line_break
    var hyphens_v = st.hyphens
    var word_break_v = st.word_break
    var cursor_v = st.cursor
    var resize_v = st.resize
    var table_layout_v = st.table_layout
    var border_spacing_x_px_v = st.border_spacing_x_px
    var border_spacing_y_px_v = st.border_spacing_y_px
    var caption_side_v = st.caption_side
    var vertical_align_v = st.vertical_align
    var caret_color_v = st.caret_color
    var accent_color_v = st.accent_color
    var tab_size_v = st.tab_size
    var unicode_bidi_v = st.unicode_bidi
    var transition_property_v = st.transition_property
    var transition_duration_ms_v = st.transition_duration_ms
    var transition_delay_ms_v = st.transition_delay_ms
    var transition_timing_function_v = st.transition_timing_function
    var animation_name_v = st.animation_name
    var animation_duration_ms_v = st.animation_duration_ms
    var animation_delay_ms_v = st.animation_delay_ms
    var animation_timing_function_v = st.animation_timing_function
    var animation_iteration_count_v = st.animation_iteration_count
    var animation_direction_v = st.animation_direction
    var animation_fill_mode_v = st.animation_fill_mode
    var animation_play_state_v = st.animation_play_state
    var transform_origin_v = st.transform_origin
    var transform_box_v = st.transform_box
    var transform_style_v = st.transform_style
    var image_rendering_v = st.image_rendering
    var object_fit_v = st.object_fit
    var object_position_v = st.object_position
    var bold_v = st.bold
    val font_decl = decl_tbl_get(decl_tbl, "font")
    val font_pos = decl_tbl_last_index(decl_tbl, "font")
    if font_decl.len() > 0:
        val font_raw = font_decl.trim()
        val font_norm = font_raw.lower()
        font_style_italic_v = false
        bold_v = false
        if font_norm.contains("italic") or font_norm.contains("oblique"):
            font_style_italic_v = true
        if font_norm.contains("bold") or font_norm.contains("700") or font_norm.contains("600") or font_norm.contains("800"):
            bold_v = true
        # The size component of a `font:` shorthand is the number attached to
        # "px" — a bare leading number is the WEIGHT ("font: 600 11px system-ui"
        # must not become font-size 600px, which rendered screen-filling glyphs).
        val parsed_font_size = parse_font_shorthand_size_px(font_norm)
        if parsed_font_size > 0:
            font_size_v = parsed_font_size
        val shorthand_family = parse_font_shorthand_family(font_raw)
        if shorthand_family != "":
            font_family_v = shorthand_family
        val slash = find_from(font_norm, "/", 0)
        if slash >= 0 and slash + 1 < font_norm.len():
            val after_slash = font_norm.substring(slash + 1, font_norm.len()).trim()
            val slash_space = find_from(after_slash, " ", 0)
            val line_part = if slash_space >= 0: after_slash.substring(0, slash_space) else: after_slash
            val parsed_line_height = parse_line_height_value(line_part)
            if parsed_line_height != 0:
                line_height_v = parsed_line_height
    val font_family_decl = decl_tbl_get(decl_tbl, "font-family").trim()
    if font_family_decl != "" and decl_tbl_last_index(decl_tbl, "font-family") > font_pos:
        font_family_v = font_family_decl
    val bg = decl_tbl_get(decl_tbl, "background-color")
    val bgs = decl_tbl_get(decl_tbl, "background")
    val bg_image = decl_tbl_get(decl_tbl, "background-image")
    val bg_repeat = decl_tbl_get(decl_tbl, "background-repeat")
    val bg_size = decl_tbl_get(decl_tbl, "background-size")
    val bg_position = decl_tbl_get(decl_tbl, "background-position")
    val bg_attachment = decl_tbl_get(decl_tbl, "background-attachment")
    val bg_pos = decl_tbl_last_index(decl_tbl, "background-color")
    val bgs_pos = decl_tbl_last_index(decl_tbl, "background")
    val bg_image_pos = decl_tbl_last_index(decl_tbl, "background-image")
    if bg_pos >= 0 or bgs_pos >= 0:
        if bgs_pos > bg_pos:
            # `background` resets every background longhand before parsing its
            # own layer, regardless of where earlier declarations were stored.
            background_image_uri_v = ""
            background_repeat_v = "repeat"
            background_size_w_px_v = 0
            background_size_h_px_v = 0
            background_position_x_px_v = -1000
            background_position_y_px_v = -1000
            background_clip_v = "border-box"
            background_origin_v = "padding-box"
            background_attachment_v = "scroll"
            val shorthand = _parse_background_shorthand(bgs)
            if shorthand.valid:
                bg_v = shorthand.color
                background_gradient_from_v = 0u32
                background_gradient_to_v = 0u32
                background_gradient_stop_colors_v = []
                background_gradient_stop_positions_v = []
                background_gradient_angle_deg_v = 180
                background_gradient_is_radial_v = false
                background_image_uri_v = shorthand.image_uri
                background_repeat_v = shorthand.repeat
                background_size_w_px_v = shorthand.size_w
                background_size_h_px_v = shorthand.size_h
                background_position_x_px_v = shorthand.position_x
                background_position_y_px_v = shorthand.position_y
                background_origin_v = shorthand.origin
                background_clip_v = shorthand.clip
                bg_layers_raw_v = ""
            else:
                # GAP-3: `background: <typed gradient>, <base colour>` is the
                # shape every glass panel uses. `_parse_background_shorthand`
                # fails closed on any `gradient(` and on >1 top-level layer, so
                # this fell into the raw branch below: the typed stops were
                # zeroed and `bg` collapsed to whatever colour token
                # `parse_color_alpha` found first anywhere in the string
                # (the *gradient's* first stop, not the base colour). The node
                # was then unrepresentable to the CPU-composited material gate,
                # which demands an empty `background-layers-raw`. Project the
                # exact two-layer shape onto the one typed image layer the
                # renderer has. Everything else still stays raw and fails
                # closed.
                val over_layers = split_top_level_commas(bgs.trim())
                var over_typed = false
                var over_radial = false
                var over_color = 0u32
                var over_image = ""
                if over_layers.len() == 2:
                    over_image = over_layers[0].trim()
                    val over_base = over_layers[1].trim()
                    val over_base_lower = over_base.lower()
                    # The base layer must be a plain colour: no image function
                    # and no unresolved var(). Without this guard
                    # `parse_color_alpha` would happily pick `red` out of a
                    # second `linear-gradient(90deg, red, blue)` layer.
                    val over_base_is_color = (
                        not over_base_lower.contains("gradient(") and
                        not over_base_lower.contains("url(") and
                        not over_base_lower.contains("image-set(") and
                        not over_base_lower.contains("cross-fade(") and
                        not over_base_lower.contains("element(") and
                        not over_base_lower.contains("paint(") and
                        not over_base_lower.contains("var(")
                    )
                    if over_base_is_color:
                        over_color = parse_color_alpha(over_base)
                        if over_color != 0u32:
                            val over_from = parse_linear_gradient_color(over_image, 0)
                            val over_to = parse_linear_gradient_color(over_image, 1)
                            if _background_is_exact_typed_linear_layer(
                                over_image, over_from, over_to, false
                            ):
                                over_typed = true
                                background_gradient_from_v = over_from
                                background_gradient_to_v = over_to
                            elif is_radial_gradient(over_image):
                                over_typed = true
                                over_radial = true
                                # A radial layer has no meaningful 2-colour
                                # projection; the stop list below carries it.
                                background_gradient_from_v = 0u32
                                background_gradient_to_v = 0u32
                if over_typed:
                    bg_v = over_color
                    background_image_uri_v = ""
                    val over_stops = parse_gradient_stops(over_image)
                    var over_stop_colors: [u32] = []
                    var over_stop_positions: [i32] = []
                    var over_idx = 0
                    while over_idx < over_stops.len():
                        over_stop_colors.push(over_stops[over_idx].color)
                        over_stop_positions.push(over_stops[over_idx].pos_permille)
                        over_idx = over_idx + 1
                    background_gradient_stop_colors_v = over_stop_colors
                    background_gradient_stop_positions_v = over_stop_positions
                    background_gradient_angle_deg_v = (
                        if over_radial: 180
                        else: parse_gradient_angle_deg(over_image)
                    )
                    background_gradient_is_radial_v = over_radial
                    bg_layers_raw_v = ""
                else:
                    bg_v = parse_color_alpha(bgs)
                    background_gradient_from_v = 0u32
                    background_gradient_to_v = 0u32
                    background_gradient_stop_colors_v = []
                    background_gradient_stop_positions_v = []
                    background_gradient_angle_deg_v = 180
                    background_gradient_is_radial_v = false
                    bg_layers_raw_v = bgs
        else:
            bg_v = parse_color_alpha(bg)
            background_gradient_from_v = 0u32
            background_gradient_to_v = 0u32
            background_gradient_stop_colors_v = []
            background_gradient_stop_positions_v = []
            background_gradient_angle_deg_v = 180
            background_gradient_is_radial_v = false
    # A later `background` shorthand resets `background-image`; do not replay
    # an earlier longhand merely because declarations are collected by name.
    if bg_image.len() > 0 and bg_image_pos > bgs_pos:
        val image_lower = bg_image.trim().lower()
        if image_lower == "none":
            background_image_uri_v = ""
            background_gradient_from_v = 0u32
            background_gradient_to_v = 0u32
            background_gradient_stop_colors_v = []
            background_gradient_stop_positions_v = []
            background_gradient_angle_deg_v = 180
            background_gradient_is_radial_v = false
            # An explicit later `background-image:none` resets the entire
            # image layer list, including radial/multilayer state retained
            # from an earlier `background:` shorthand.
            bg_layers_raw_v = ""
        else:
            val image_uri = _background_exact_url_value(bg_image)
            val gradient_from = parse_linear_gradient_color(bg_image, 0)
            val gradient_to = parse_linear_gradient_color(bg_image, 1)
            if image_uri != "" and image_lower.starts_with("url("):
                background_image_uri_v = image_uri
                background_gradient_from_v = 0u32
                background_gradient_to_v = 0u32
                background_gradient_stop_colors_v = []
                background_gradient_stop_positions_v = []
                background_gradient_angle_deg_v = 180
                background_gradient_is_radial_v = false
                bg_layers_raw_v = ""
            elif _background_is_exact_typed_linear_layer(
                bg_image, gradient_from, gradient_to, false
            ):
                background_image_uri_v = ""
                background_gradient_from_v = gradient_from
                background_gradient_to_v = gradient_to
                bg_layers_raw_v = ""
                # GAP-2: this is confirmed to be exactly one linear-gradient(...)
                # layer (angle and/or 3+ stops included — the legacy from/to
                # pair above only ever captures the first two color stops).
                # Parse the full stop list and angle from the same raw CSS text
                # so N-stop/angled gradients reach the paint layer instead of
                # collapsing to 2 stops.
                val stops = parse_gradient_stops(bg_image)
                var stop_colors: [u32] = []
                var stop_positions: [i32] = []
                var stop_idx = 0
                while stop_idx < stops.len():
                    stop_colors.push(stops[stop_idx].color)
                    stop_positions.push(stops[stop_idx].pos_permille)
                    stop_idx = stop_idx + 1
                background_gradient_stop_colors_v = stop_colors
                background_gradient_stop_positions_v = stop_positions
                background_gradient_angle_deg_v = parse_gradient_angle_deg(bg_image)
                background_gradient_is_radial_v = false
            elif is_radial_gradient(bg_image) and split_top_level_commas(bg_image.trim()).len() <= 1:
                # GAP-2: a single radial-gradient(...) layer never satisfies
                # `_background_is_exact_typed_linear_layer` (it requires a
                # `linear-gradient(` prefix), so it always fell through to the
                # unsupported/raw branch below and lost its gradient entirely.
                # Parse it directly via the GAP-2 stop-list machinery instead.
                background_image_uri_v = ""
                background_gradient_from_v = 0u32
                background_gradient_to_v = 0u32
                bg_layers_raw_v = ""
                val stops = parse_gradient_stops(bg_image)
                var stop_colors: [u32] = []
                var stop_positions: [i32] = []
                var stop_idx = 0
                while stop_idx < stops.len():
                    stop_colors.push(stops[stop_idx].color)
                    stop_positions.push(stops[stop_idx].pos_permille)
                    stop_idx = stop_idx + 1
                background_gradient_stop_colors_v = stop_colors
                background_gradient_stop_positions_v = stop_positions
                background_gradient_angle_deg_v = 180
                background_gradient_is_radial_v = true
            else:
                # Unsupported, multiple, or malformed image layers must
                # replace any prior typed projection and remain observable to
                # the fail-closed Draw IR/material gate.
                background_gradient_from_v = 0u32
                background_gradient_to_v = 0u32
                background_gradient_stop_colors_v = []
                background_gradient_stop_positions_v = []
                background_gradient_angle_deg_v = 180
                background_gradient_is_radial_v = false
                background_image_uri_v = ""
                bg_layers_raw_v = bg_image
    val bg_repeat_pos = decl_tbl_last_index(decl_tbl, "background-repeat")
    if bg_repeat.len() > 0 and bg_repeat_pos > bgs_pos:
        val repeat_lower = bg_repeat.trim().lower()
        if repeat_lower == "no-repeat" or repeat_lower == "repeat" or repeat_lower == "repeat-x" or repeat_lower == "repeat-y":
            background_repeat_v = repeat_lower
    val bg_size_pos = decl_tbl_last_index(decl_tbl, "background-size")
    if bg_size.len() > 0 and bg_size_pos > bgs_pos:
        val size_trimmed = bg_size.trim()
        val first_space = find_from(size_trimmed, " ", 0)
        val first_size = if first_space >= 0: size_trimmed.substring(0, first_space) else: size_trimmed
        if first_size.len() > 0:
            val sw = if first_size.lower() == "auto": 0 else: parse_int(first_size)
            if sw >= 0:
                background_size_w_px_v = sw
        if first_space >= 0:
            val second_size = size_trimmed.substring(first_space + 1, size_trimmed.len()).trim()
            val sh = if second_size.lower() == "auto": 0 else: parse_int(second_size)
            if sh >= 0:
                background_size_h_px_v = sh
        else:
            background_size_h_px_v = 0
    val bg_position_pos = decl_tbl_last_index(decl_tbl, "background-position")
    if bg_position.len() > 0 and bg_position_pos > bgs_pos:
        val pos_trimmed = bg_position.trim()
        val first_space = find_from(pos_trimmed, " ", 0)
        val first_pos = if first_space >= 0: pos_trimmed.substring(0, first_space) else: pos_trimmed
        if first_pos.len() > 0:
            background_position_x_px_v = _background_position_value(first_pos, true)
        if first_space >= 0:
            val second_pos = pos_trimmed.substring(first_space + 1, pos_trimmed.len()).trim()
            background_position_y_px_v = _background_position_value(second_pos, false)
        else:
            background_position_y_px_v = -1050
    val bg_clip = decl_tbl_get(decl_tbl, "background-clip")
    if bg_clip.len() > 0 and decl_tbl_last_index(decl_tbl, "background-clip") > bgs_pos:
        val bg_clip_norm = bg_clip.trim().lower()
        if bg_clip_norm == "border-box" or bg_clip_norm == "padding-box" or bg_clip_norm == "content-box":
            background_clip_v = bg_clip_norm
    val bg_origin = decl_tbl_get(decl_tbl, "background-origin")
    if bg_origin.len() > 0 and decl_tbl_last_index(decl_tbl, "background-origin") > bgs_pos:
        val bg_origin_norm = bg_origin.trim().lower()
        if bg_origin_norm == "border-box" or bg_origin_norm == "padding-box" or bg_origin_norm == "content-box":
            background_origin_v = bg_origin_norm
    if bg_attachment.len() > 0 and decl_tbl_last_index(decl_tbl, "background-attachment") > bgs_pos:
        val bg_attachment_norm = bg_attachment.trim().lower()
        if bg_attachment_norm == "scroll" or bg_attachment_norm == "fixed" or bg_attachment_norm == "local":
            background_attachment_v = bg_attachment_norm
    # Keep exactly two URL layers in the existing raw Style witness, but only
    # after every aligned longhand has been normalized. Anything else remains
    # raw and the canonical Draw IR path fails closed.
    if bg_image.len() > 0 and bg_image_pos > bgs_pos:
        val shared_longhands = (
            split_top_level_commas(bg_repeat.trim()).len() <= 1 and
            split_top_level_commas(bg_origin.trim()).len() <= 1 and
            split_top_level_commas(bg_clip.trim()).len() <= 1 and
            split_top_level_commas(bg_attachment.trim()).len() <= 1
        )
        val two_url_plan = if shared_longhands:
            _background_two_url_plan(
                bg_image, background_repeat_v, bg_size, bg_position,
                background_size_w_px_v,
                background_size_h_px_v, background_position_x_px_v,
                background_position_y_px_v, background_origin_v,
                background_clip_v, background_attachment_v
            )
        else:
            ""
        if two_url_plan != "":
            background_image_uri_v = ""
            background_gradient_from_v = 0u32
            background_gradient_to_v = 0u32
            background_gradient_stop_colors_v = []
            background_gradient_stop_positions_v = []
            background_gradient_angle_deg_v = 180
            background_gradient_is_radial_v = false
            bg_layers_raw_v = two_url_plan
    val col = decl_tbl_get(decl_tbl, "color")
    if col.len() > 0:
        val cv = parse_color(col)
        if cv != 0u32:
            fg_v = cv
    val fs = decl_tbl_get(decl_tbl, "font-size")
    val fs_pos = decl_tbl_last_index(decl_tbl, "font-size")
    if fs.len() > 0 and (font_pos < 0 or fs_pos > font_pos):
        val fsl = fs.trim().lower()
        if fsl.ends_with("rem"):
            # rem is relative to the root font-size (16px default).
            val computed = (16 * parse_decimal_x10(fsl)) / 10
            if computed > 0:
                font_size_v = computed
        elif fsl.ends_with("em"):
            # em is relative to the inherited (parent) font-size.
            val computed = (em_base * parse_decimal_x10(fsl)) / 10
            if computed > 0:
                font_size_v = computed
        elif fsl.ends_with("%"):
            # percent font-size is relative to the inherited font-size.
            val computed = (em_base * parse_int(fsl)) / 100
            if computed > 0:
                font_size_v = computed
        else:
            val v = parse_int(fs)
            if v > 0:
                font_size_v = v
    val font_size_adjust_decl = decl_tbl_get(decl_tbl, "font-size-adjust")
    if font_size_adjust_decl.len() > 0:
        val font_size_adjust_norm = font_size_adjust_decl.trim().lower()
        if font_size_adjust_norm == "none" or font_size_adjust_norm == "from-font" or parse_int(font_size_adjust_norm) >= 0:
            font_size_adjust_v = font_size_adjust_norm
    val font_palette_decl = decl_tbl_get(decl_tbl, "font-palette")
    if font_palette_decl.len() > 0:
        val font_palette_norm = font_palette_decl.trim().lower()
        if font_palette_norm == "normal" or font_palette_norm == "light" or font_palette_norm == "dark":
            font_palette_v = font_palette_norm
    val font_feature_settings_decl = decl_tbl_get(decl_tbl, "font-feature-settings")
    if font_feature_settings_decl.len() > 0:
        val font_feature_settings_norm = font_feature_settings_decl.trim().lower()
        if font_feature_settings_norm.len() > 0:
            font_feature_settings_v = font_feature_settings_norm
    val line_height = decl_tbl_get(decl_tbl, "line-height")
    val line_height_pos = decl_tbl_last_index(decl_tbl, "line-height")
    if line_height.len() > 0 and (font_pos < 0 or line_height_pos > font_pos):
        val parsed_line_height = parse_line_height_value(line_height)
        if parsed_line_height != 0:
            line_height_v = parsed_line_height
    writing_mode_v = _decl_tbl_resolve_writing_mode(
        writing_mode_v, decl_tbl
    )
    val sizing_writing_mode = (
        if logical_writing_mode.len() > 0:
            logical_writing_mode
        else:
            writing_mode_v
    )
    val logical_inline_is_height = sizing_writing_mode != "horizontal-tb"
    val width = decl_tbl_get(decl_tbl, "width")
    val width_pos = decl_tbl_last_index(decl_tbl, "width")
    if width.len() > 0:
        if width.ends_with("%"):
            # Percentage width: store as a negative sentinel (resolved against the
            # parent's available width at layout time, where it is known).
            val wp = parse_int(width)
            width_v = if wp > 0: 0 - wp else: 0
        elif width.ends_with("vw"):
            # Viewport width unit: exact for viewport-level elements (parent ==
            # viewport). Reuse the percent sentinel so it resolves against the
            # parent's available width at layout time.
            val wv = parse_int(width)
            width_v = if wv > 0: 0 - wv else: 0
        else:
            width_v = parse_int(width)
    val height = decl_tbl_get(decl_tbl, "height")
    val height_pos = decl_tbl_last_index(decl_tbl, "height")
    if height.len() > 0:
        if height.ends_with("%"):
            val hp = parse_int(height)
            height_v = if hp > 0: 0 - hp else: 0
        else:
            height_v = parse_int(height)
    val inline_size = decl_tbl_get(decl_tbl, "inline-size")
    val inline_size_pos = decl_tbl_last_index(decl_tbl, "inline-size")
    if inline_size.len() > 0:
        val isp = parse_int(inline_size)
        val inline_size_v = if inline_size.ends_with("%") and isp > 0: 0 - isp else: isp
        if logical_inline_is_height and inline_size_pos > height_pos:
            height_v = inline_size_v
        elif not logical_inline_is_height and inline_size_pos > width_pos:
            width_v = inline_size_v
    val block_size = decl_tbl_get(decl_tbl, "block-size")
    val block_size_pos = decl_tbl_last_index(decl_tbl, "block-size")
    if block_size.len() > 0:
        val bsp = parse_int(block_size)
        val block_size_v = if block_size.ends_with("%") and bsp > 0: 0 - bsp else: bsp
        if logical_inline_is_height and block_size_pos > width_pos:
            width_v = block_size_v
        elif not logical_inline_is_height and block_size_pos > height_pos:
            height_v = block_size_v
    val aspect_ratio = decl_tbl_get(decl_tbl, "aspect-ratio")
    if aspect_ratio.len() > 0:
        val ar_num = parse_aspect_ratio_numerator(aspect_ratio)
        val ar_den = parse_aspect_ratio_denominator(aspect_ratio)
        if ar_num > 0 and ar_den > 0:
            if width_v > 0 and height_v == 0:
                height_v = (width_v * ar_den) / ar_num
            elif height_v > 0 and width_v == 0:
                width_v = (height_v * ar_num) / ar_den
    val box_sizing = decl_tbl_get(decl_tbl, "box-sizing")
    if box_sizing.len() > 0:
        border_box_v = box_sizing == "border-box"
    val border_radius_shorthand = parse_border_radius_shorthand(
