        if font_synthesis_norm == "none" or font_synthesis_norm == "weight" or font_synthesis_norm == "style" or font_synthesis_norm == "small-caps" or font_synthesis_norm == "position" or font_synthesis_norm.contains(" "):
            font_synthesis_v = font_synthesis_norm
    val font_synthesis_small_caps_decl = decl_tbl_get(decl_tbl, "font-synthesis-small-caps")
    if font_synthesis_small_caps_decl.len() > 0:
