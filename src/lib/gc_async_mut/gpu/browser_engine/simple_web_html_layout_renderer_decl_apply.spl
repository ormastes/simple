        overflow_scroll_y_v = overflow_decl == "scroll"
    val overflow_x_decl = decl_tbl_get(decl_tbl, "overflow-x")
    if overflow_x_decl.len() > 0:
        if overflow_x_decl == "hidden":
            overflow_hidden_v = true
    val overflow_y_decl = decl_tbl_get(decl_tbl, "overflow-y")
    if overflow_y_decl.len() > 0:
        if overflow_y_decl == "hidden":
