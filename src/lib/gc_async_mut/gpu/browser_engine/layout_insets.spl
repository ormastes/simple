use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{HNode}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{Style}

# Sum of bottom insets (padding + border) along a node's ancestor chain.
# Layout and painting share this owner: fill targets the ancestors' content
# box rather than the raw viewport edge. The starting node is excluded.
fn ancestor_bottom_inset(nodes: [HNode], styles: [Style], i: i32) -> i32:
    var inset = 0
    var p = nodes[i].parent
    var guard = 0
    # cpu-lane-loop-ok: ancestor chain walk bounded by the literal guard < 64
    while p >= 0 and guard < 64:
        guard = guard + 1
        val ps = styles[p]
        inset = inset + ps.pad_b + ps.border_b
        p = nodes[p].parent
    inset
