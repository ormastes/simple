    var i = 0
    val correction_count = text_flow_correction_offsets.len()
    while i < correction_count:
        val idx = text_flow_correction_offsets[i]
        if idx >= 0 and idx < out.len():
            out[idx] = text_flow_correction_colors[i]
        i = i + 1
    out

# Two adjacent sides of different colours (`transparent` counts) meet on the
# diagonal from the outer to the inner corner, as Chrome paints them: a CSS
# triangle (`border:20px solid transparent; border-top-color:red`) is a
# triangle, not a red rectangle. Same-coloured neighbours keep the plain
# rectangles of fb_border_sides_clip, so a uniform border is unchanged.
fn _fb_border_mitred(bl: i32, bt: i32, br: i32, bb: i32, cl: u32, ct: u32, cr: u32, cb: u32) -> bool:
    val tl = bt > 0 and bl > 0 and ct != cl
    val tr = bt > 0 and br > 0 and ct != cr
    val bl_corner = bb > 0 and bl > 0 and cb != cl
    val br_corner = bb > 0 and br > 0 and cb != cr
    tl or tr or bl_corner or br_corner

# Row `r` (0 at the outer edge) of a side `side_w` thick, against a neighbour
# `cross_w` thick: the first column (from the outer corner) the side owns
# whole, times 2, plus 1 when the column before it is cut in half by the
# diagonal. A pixel belongs to the side when its centre lies past the
# diagonal, (2c+1) * side_w > (2r+1) * cross_w.
fn _fb_mitre_cut(r: i32, side_w: i32, cross_w: i32) -> i32:
    val num = (2 * r + 1) * cross_w
    var c = 0
    while (2 * c + 1) * side_w <= num:
        c = c + 1
    if c > 0 and (2 * c - 1) * side_w == num:
        return c * 2 + 1
    c * 2

# A glyph pixel: `color: rgba(0,0,0,.5)` blends over what is under it, as
# Chrome does (the 5x7 lane wrote it opaque). An alpha byte of 0 is a colour
# packed without one and stays opaque.
fn _fb_text_px(color: u32, dst: u32) -> u32:
    val a = ((color >> 24) & 255u32) as i32
    if a > 0 and a < 255:
        return composite_over_base(color | 0xFF000000u32, a, dst)
    color
