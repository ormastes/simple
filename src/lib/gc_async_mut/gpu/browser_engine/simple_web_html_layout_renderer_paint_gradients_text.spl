# Gradient, border-mitre, text (thin-scaled / TTF raster / bidi) and widget
# chrome paint primitives for the Simple web renderer framebuffer lane.
# Split out of simple_web_html_layout_renderer_paint_primitives.spl, which
# re-exports every name defined here.

use common.ui.glyph_bitmap_5x7.{glyph_row_bits, glyph_index_for_char_code}
use std.gc_async_mut.gpu.engine2d.backend_emu.{gradient_corner_dir_q16, radial_gradient_pixels, linear_gradient_pixels}
use std.gpu.engine2d.color.{blend as engine2d_color_blend}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.*
use std.common.encoding.sfnt.{OtFont, read_u16_be}
use std.common.encoding.sfnt_cmap.{CmapFormat4, CmapFormat12, cmap_lookup, cmap12_lookup}
use std.common.encoding.sfnt_glyf.{SFNT_GLYF_MOVE, SFNT_GLYF_LINE, SFNT_GLYF_QUAD, SFNT_GLYF_CLOSE, SfntGlyfCommand, parse_sfnt_glyf_outline, sfnt_lcd_glyph_outline, SFNT_GLYPH_SELECTOR_INDEX}
use std.common.encoding.utf8.{text_codepoints}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{gradient_layer_list, parse_gradient_angle_deg, gradient_layer_entries, gradient_layer_split}
use std.gc_async_mut.gpu.engine2d.gradient_tiles.{gradient_tile_spans, gradient_pixels_round_clip, gradient_layer_stack_over}

class ClipRect:
    x0: i32
    y0: i32
    x1: i32
    y1: i32

fn composite_over_base(src: u32, alpha255: i32, dst: u32) -> u32:
    if alpha255 >= 255:
        return src
    if alpha255 <= 0:
        return dst
    val sr = (((src >> 16) & 255u32) as i32)
    val sg = (((src >> 8) & 255u32) as i32)
    val sb = ((src & 255u32) as i32)
    val dr = (((dst >> 16) & 255u32) as i32)
    val dg = (((dst >> 8) & 255u32) as i32)
    val db = ((dst & 255u32) as i32)
    val inv = 255 - alpha255
    val r = (sr * alpha255 + dr * inv + 128) / 255
    val g = (sg * alpha255 + dg * inv + 128) / 255
    val b = (sb * alpha255 + db * inv + 128) / 255
    web_argb(r, g, b)

# sin and cos of a whole-degree angle, scaled by 65536 (Q16). A short Taylor
# series on [0, 90] degrees plus quadrant symmetry: the gradient direction is
# computed once per box, so per-pixel work stays integer.
fn gradient_angle_sin_cos_q16(deg: i32) -> [i64]:
    var d = deg % 360
    if d < 0:
        d = d + 360
    val quadrant = d / 90
    val r = (d % 90) as f64
    val x = r * 3.141592653589793 / 180.0
    val x2 = x * x
    val sin_r = x * (1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0 * (1.0 - x2 / 72.0))))
    val cos_r = 1.0 - x2 / 2.0 * (1.0 - x2 / 12.0 * (1.0 - x2 / 30.0 * (1.0 - x2 / 56.0 * (1.0 - x2 / 90.0))))
    val s = (sin_r * 65536.0 + 0.5) as i64
    val c = (cos_r * 65536.0 + 0.5) as i64
    if quadrant == 0:
        return [s, c]
    if quadrant == 1:
        return [c, 0 - s]
    if quadrant == 2:
        return [0 - s, 0 - c]
    [0 - c, s]

# Composite one radial gradient layer src-over the framebuffer over the
# paint rect (px0, py0, pw, ph) intersected with the clip. Colours come from
# Engine2D's shared evaluator (`radial_gradient_pixels`) and blend with the
# Engine2D `blend`, so the raster, cpu_simd and the Vulkan device agree.
# `opacity_pct` < 100 scales each colour's alpha.
fn fb_radial_gradient_clip(fb: [u32], fbw: i32, fbh: i32, px0: i32, py0: i32, pw: i32, ph: i32, geom: [i64], colors: [u32], positions: [i32], opacity_pct: i32, clip: ClipRect) -> [u32]:
    if geom.len() < 4:
        return fb
    fb_gradient_layer_clip(fb, fbw, fbh, px0, py0, pw, ph, BackgroundGradientLayer(radial: true, geom: geom, colors: colors, positions: positions, tile: [], repeat_x: true, repeat_y: true), opacity_pct, clip)

# One resolved CSS gradient image layer: a radial ellipse [cx, cy, rx, ry]
# or a linear gradient line [sx, sy, ex, ey] (Q10 px), with its stops.
# `geom` is resolved against tile 0, `tile` = [tx, ty, tw, th] (Q10 px; []
# = one untiled image over the paint rect); a repeating axis lays the same
# gradient again at every tile origin.
struct BackgroundGradientLayer:
    radial: bool
    geom: [i64]
    colors: [u32]
    positions: [i32]
    tile: [i64]
    repeat_x: bool
    repeat_y: bool

# Composite one gradient layer src-over the framebuffer over the paint rect
# (px0, py0, pw, ph) intersected with the clip, with colours from Engine2D's
# shared evaluators (`radial_gradient_pixels` / `linear_gradient_pixels`)
# and the Engine2D `blend`, so the raster, cpu_simd and Vulkan agree.
fn fb_gradient_layer_clip(fb: [u32], fbw: i32, fbh: i32, px0: i32, py0: i32, pw: i32, ph: i32, layer: BackgroundGradientLayer, opacity_pct: i32, clip: ClipRect) -> [u32]:
    var out = fb
    val geom = layer.geom
    if opacity_pct <= 0 or geom.len() < 4:
        return out
    var x0 = px0
    var y0 = py0
    var x1 = px0 + pw
    var y1 = py0 + ph
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    if x1 <= x0 or y1 <= y0:
        return out
    val w = x1 - x0
    val pixels = gradient_layer_tiled_pixels(x0, y0, w, y1 - y0, layer)
    if pixels.len() == 0:
        return out
    _fb_blend_pixels(out, fbw, x0, y0, w, y1 - y0, pixels, opacity_pct)

# Gradient list on a rounded box (`shape` = [x, y, w, h, tl, tr, br, bl], the
# painting area with its clip radii): the box colour `base` and every layer
# are composited into ONE image of the painting area
# (`gradient_layer_stack_over`), its alpha scaled once by the anti-aliased
# corner coverage (`gradient_pixels_round_clip`), then blended over the
# framebuffer -- Chrome clips the whole background once, so stacked layers do
# not compound the corner coverage.
fn fb_gradient_layers_round_clip(fb: [u32], fbw: i32, fbh: i32, layers: [BackgroundGradientLayer], base: u32, opacity_pct: i32, clip: ClipRect, shape: [i32]) -> [u32]:
    var out = fb
    if opacity_pct <= 0 or shape.len() != 8:
        return out
    var x0 = if shape[0] > clip.x0: shape[0] else: clip.x0
    var y0 = if shape[1] > clip.y0: shape[1] else: clip.y0
    var x1 = if shape[0] + shape[2] < clip.x1: shape[0] + shape[2] else: clip.x1
    var y1 = if shape[1] + shape[3] < clip.y1: shape[1] + shape[3] else: clip.y1
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    if x1 <= x0 or y1 <= y0:
        return out
    val w = x1 - x0
    val h = y1 - y0
    var acc: [u32] = [base; w * h]
    var li = layers.len() - 1
    while li >= 0:
        val pixels = gradient_layer_tiled_pixels(x0, y0, w, h, layers[li])
        if pixels.len() == w * h:
            acc = gradient_layer_stack_over(acc, pixels)
        li = li - 1
    _fb_blend_pixels(out, fbw, x0, y0, w, h, gradient_pixels_round_clip(acc, x0, y0, w, h, shape), opacity_pct)

# Composite straight-ARGB `pixels` (w x h at x0, y0, already clipped) over the
# framebuffer with the Engine2D image rule, alpha scaled by `opacity_pct`.
fn _fb_blend_pixels(fb: [u32], fbw: i32, x0: i32, y0: i32, w: i32, h: i32, pixels: [u32], opacity_pct: i32) -> [u32]:
    var out = fb
    val x1 = x0 + w
    val y1 = y0 + h
    var py = y0
    while py < y1:
        val row = py * fbw
        val src_row = (py - y0) * w
        var px = x0
        while px < x1:
            var src = pixels[src_row + px - x0]
            if opacity_pct < 100:
                val scaled_a = (((src >> 24) & 255u32) as i32 * opacity_pct + 50) / 100
                src = ((scaled_a as u32) << 24) | (src & 0x00FFFFFFu32)
            val a = (src >> 24) & 255u32
            if a == 255u32:
                out[row + px] = src
            elif a > 0u32:
                out[row + px] = engine2d_color_blend(src, out[row + px])
            px = px + 1
        py = py + 1
    out

# One gradient layer's colours over the pixel rect (x0, y0, w, h), row-major:
# every tile of its grid (`gradient_tile_spans`) evaluated with the layer's
# geometry moved to that tile's origin; pixels no tile covers stay 0
# (transparent). When every tile is a whole number of pixels, all tiles share
# one pixel grid, so tile 0 is evaluated once and copied.
fn gradient_layer_tiled_pixels(x0: i32, y0: i32, w: i32, h: i32, layer: BackgroundGradientLayer) -> [u32]:
    if layer.tile.len() < 4:
        return _gradient_layer_kernel(layer, x0, y0, w, h, 0, 0)
    val t = layer.tile
    val xs = gradient_tile_spans(x0, w, t[0], t[2], layer.repeat_x)
    val ys = gradient_tile_spans(y0, h, t[1], t[3], layer.repeat_y)
    if (xs.len() == 3 and ys.len() == 3 and xs[2] == 0 and ys[2] == 0 and
            xs[0] == (x0 as i64) and xs[1] == ((x0 + w) as i64) and
            ys[0] == (y0 as i64) and ys[1] == ((y0 + h) as i64)):
        return _gradient_layer_kernel(layer, x0, y0, w, h, 0, 0)
    var out: [u32] = [0u32; w * h]
    if xs.len() == 0 or ys.len() == 0:
        return out
    if t[2] % 1024 == 0 and t[3] % 1024 == 0:
        val twp = t[2] / 1024
        val thp = t[3] / 1024
        var lx0 = xs[0] - xs[2] * twp
        var lx1 = xs[1] - xs[2] * twp
        var i = 3
        while i < xs.len():
            if xs[i] - xs[i + 2] * twp < lx0:
                lx0 = xs[i] - xs[i + 2] * twp
            if xs[i + 1] - xs[i + 2] * twp > lx1:
                lx1 = xs[i + 1] - xs[i + 2] * twp
            i = i + 3
        var ly0 = ys[0] - ys[2] * thp
        var ly1 = ys[1] - ys[2] * thp
        i = 3
        while i < ys.len():
            if ys[i] - ys[i + 2] * thp < ly0:
                ly0 = ys[i] - ys[i + 2] * thp
            if ys[i + 1] - ys[i + 2] * thp > ly1:
                ly1 = ys[i + 1] - ys[i + 2] * thp
            i = i + 3
        val bw = (lx1 - lx0) as i32
        val base = _gradient_layer_kernel(layer, lx0 as i32, ly0 as i32, bw, (ly1 - ly0) as i32, 0, 0)
        if base.len() == 0:
            return out
        var yi = 0
        while yi < ys.len():
            var py = ys[yi]
            while py < ys[yi + 1]:
                val src_row = ((py - ys[yi + 2] * thp - ly0) as i32) * bw
                val dst_row = ((py as i32) - y0) * w
                var xi = 0
                while xi < xs.len():
                    val shift = (xs[xi + 2] * twp + lx0) as i32
                    var px = xs[xi] as i32
                    val pe = xs[xi + 1] as i32
                    while px < pe:
                        out[dst_row + px - x0] = base[src_row + px - shift]
                        px = px + 1
                    xi = xi + 3
                py = py + 1
            yi = yi + 3
        return out
    var yi = 0
    while yi < ys.len():
        var xi = 0
        while xi < xs.len():
            val sx = xs[xi] as i32
            val sy = ys[yi] as i32
            val tw = (xs[xi + 1] - xs[xi]) as i32
            val th = (ys[yi + 1] - ys[yi]) as i32
            val pix = _gradient_layer_kernel(layer, sx, sy, tw, th, xs[xi + 2] * t[2], ys[yi + 2] * t[3])
            if pix.len() == tw * th:
                var r = 0
                while r < th:
                    var c = 0
                    while c < tw:
                        out[(sy - y0 + r) * w + sx - x0 + c] = pix[r * tw + c]
                        c = c + 1
                    r = r + 1
            xi = xi + 3
        yi = yi + 3
    out

fn _gradient_layer_kernel(layer: BackgroundGradientLayer, x0: i32, y0: i32, w: i32, h: i32, dx: i64, dy: i64) -> [u32]:
    val g = layer.geom
    if layer.radial:
        return radial_gradient_pixels(x0, y0, w, h, g[0] + dx, g[1] + dy, g[2], g[3], layer.colors, layer.positions)
    linear_gradient_pixels(x0, y0, w, h, g[0] + dx, g[1] + dy, g[2] + dx, g[3] + dy, layer.colors, layer.positions)

# The background positioning area [ox, oy, ow, oh] (background-origin,
# padding-box by default; the painting area when that is empty) then the
# background painting area [bx, by, bw, bh] (background-clip, border-box by
# default) of a box, in px; empty when the painting area is empty.
fn background_gradient_box_rects(st: Style, x: i32, y: i32, w: i32, h: i32) -> [i32]:
    var ox = x + st.border_l
    var oy = y + st.border_t
    var ow = w - st.border_l - st.border_r
    var oh = h - st.border_t - st.border_b
    if st.background_origin == "border-box":
        ox = x
        oy = y
        ow = w
        oh = h
    elif st.background_origin == "content-box":
        ox = x + st.border_l + st.pad_l
        oy = y + st.border_t + st.pad_t
        ow = w - st.border_l - st.border_r - st.pad_l - st.pad_r
        oh = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    var bx = x
    var by = y
    var bw = w
    var bh = h
    if st.background_clip == "padding-box" or st.background_clip == "content-box":
        bx = bx + st.border_l
        by = by + st.border_t
        bw = bw - st.border_l - st.border_r
        bh = bh - st.border_t - st.border_b
    if st.background_clip == "content-box":
        bx = bx + st.pad_l
        by = by + st.pad_t
        bw = bw - st.pad_l - st.pad_r
        bh = bh - st.pad_t - st.pad_b
    if bw <= 0 or bh <= 0:
        return []
    if ow <= 0 or oh <= 0:
        ox = bx
        oy = by
        ow = bw
        oh = bh
    [ox, oy, ow, oh, bx, by, bw, bh]

# CSS Images 3 §3.1 gradient line of one `linear-gradient(...)` layer against
# its gradient box (ax, ay, aw, ah; CSS px): [sx, sy, ex, ey] in Q10 px. The
# line passes through the box centre at the layer's angle (0deg = to top,
# clockwise; `to <corner>` depends on the box) and is |w sin| + |h cos| long,
# so the far corners land on the 0% and 100% points.
fn linear_gradient_line_q10(layer: text, ax: i32, ay: i32, aw: i32, ah: i32) -> [i64]:
    linear_gradient_line_q10_at_angle(parse_gradient_angle_deg(layer), ax, ay, aw, ah)

# The same line for a parsed angle (`parse_gradient_angle_deg`: degrees, or
# >= 1000 for a `to <corner>` direction).
fn linear_gradient_line_q10_at_angle(angle: i32, ax: i32, ay: i32, aw: i32, ah: i32) -> [i64]:
    val sc = if angle >= 1000: gradient_corner_dir_q16(angle, aw, ah) else: gradient_angle_sin_cos_q16(angle)
    val s = sc[0]
    val c = sc[1]
    val sa = if s < 0: 0 - s else: s
    val ca = if c < 0: 0 - c else: c
    # Q16 direction x px -> Q10 length (/ 64), then half of it along (s, -c).
    val len_q10 = ((aw as i64) * sa + (ah as i64) * ca) / 64
    val hx = s * len_q10 / 131072
    val hy = (0 - c) * len_q10 / 131072
    val cx = (ax as i64) * 1024 + (aw as i64) * 512
    val cy = (ay as i64) * 1024 + (ah as i64) * 512
    [cx - hx, cy - hy, cx + hx, cy + hy]

# Most tiles one gradient layer may paint (see background_gradient_layers).
# Measured 2026-11-17: ~48 ms per tile on the lavapipe device path.
val BACKGROUND_GRADIENT_TILE_CAP: i64 = 1024

# True when the box paints its background image list as gradient layers: a
# raw gradient-only list (several layers, or one the typed linear / radial
# projections leave raw, e.g. a stop at `transparent`); rounded corners clip
# it (`background_gradient_clip_shape`).
fn background_gradient_layers_paintable(st: Style) -> bool:
    if st.bg_layers_raw == "" or st.background_image_uri != "":
        return false
    if radial_gradient_box_paintable(st):
        return false
    if st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32:
        return false
    # Per-layer size / position / repeat travel as each layer's tail
    # (decl_apply rewrites the longhand lists into it). A list without tails
    # whose scalar size / position is not the default came from a longhand
    # this list never saw (another declaration block): keep it fail-closed
    # (box colour only) rather than paint one untiled gradient.
    var tailed = false
    for entry in gradient_layer_entries(st.bg_layers_raw):
        if gradient_layer_split(entry)[1] != "":
            tailed = true
    if not tailed:
        if st.background_size_w_px != 0 or st.background_size_h_px != 0:
            return false
        if not _gradient_layers_default_position(st.background_position_x_px) or not _gradient_layers_default_position(st.background_position_y_px):
            return false
    gradient_layer_list(st.bg_layers_raw).len() > 0

# The rounded clip of a gradient list painted over the painting area (x, y,
# w, h), the background-clip box: [x, y, w, h, tl, tr, br, bl], each radius
# the border-box radius minus the border (padding-box) and padding
# (content-box) widths it is inset by on its wider side; [] when square.
fn background_gradient_clip_shape(st: Style, x: i32, y: i32, w: i32, h: i32) -> [i32]:
    if st.border_radius_tl_px <= 0 and st.border_radius_tr_px <= 0 and st.border_radius_br_px <= 0 and st.border_radius_bl_px <= 0:
        return []
    var il = 0
    var it = 0
    var ir = 0
    var ib = 0
    if st.background_clip == "padding-box" or st.background_clip == "content-box":
        il = st.border_l
        it = st.border_t
        ir = st.border_r
        ib = st.border_b
    if st.background_clip == "content-box":
        il = il + st.pad_l
        it = it + st.pad_t
        ir = ir + st.pad_r
        ib = ib + st.pad_b
    [x, y, w, h, _inset_radius(st.border_radius_tl_px, il, it), _inset_radius(st.border_radius_tr_px, ir, it), _inset_radius(st.border_radius_br_px, ir, ib), _inset_radius(st.border_radius_bl_px, il, ib)]

fn _inset_radius(r: i32, a: i32, b: i32) -> i32:
    val m = if a > b: a else: b
    if r > m: r - m else: 0

fn _gradient_layers_default_position(v: i32) -> bool:
    v == 0 or (v <= -1000 and v >= -1100)

# Paint gradient layers over the painting area (px0, py0, pw, ph) back to
# front: CSS Backgrounds 3 paints the FIRST listed layer on top.
fn fb_gradient_layers_clip(fb: [u32], fbw: i32, fbh: i32, px0: i32, py0: i32, pw: i32, ph: i32, layers: [BackgroundGradientLayer], opacity_pct: i32, clip: ClipRect) -> [u32]:
    var out = fb
    var li = layers.len() - 1
    while li >= 0:
        out = fb_gradient_layer_clip(out, fbw, fbh, px0, py0, pw, ph, layers[li], opacity_pct, clip)
        li = li - 1
    out

# True when the box carries a paintable typed radial layer: at least two
# stops (Chrome rejects a one-stop gradient) and square corners (a rounded
# radial still falls back to its colour on both lanes).
fn radial_gradient_box_paintable(st: Style) -> bool:
    val n = st.background_gradient_stop_colors.len()
    (
        st.background_gradient_is_radial and n >= 2 and
        st.background_gradient_stop_positions.len() == n and
        st.border_radius_tl_px <= 0 and st.border_radius_tr_px <= 0 and
        st.border_radius_br_px <= 0 and st.border_radius_bl_px <= 0
    )

# Chrome positions the propagated root/body background on the canvas: the
# viewport (vw x vh), grown to the html element's box when the document is
# wider or taller. Returns [w, h] in CSS px from the canvas origin.
fn canvas_background_extent(nodes: [HNode], bx: [i32], by: [i32], bw: [i32], bh: [i32], vw: i32, vh: i32) -> [i32]:
    var w = vw
    var h = vh
    var i = 0
    while i < nodes.len() and i < bx.len():
        if nodes[i].tag == "html":
            if bx[i] + bw[i] > w:
                w = bx[i] + bw[i]
            if by[i] + bh[i] > h:
                h = by[i] + bh[i]
            break
        i = i + 1
    [w, h]

# The root node whose gradient layer list is the canvas background outside
# widget mode (CSS Backgrounds 3 §2.11.2): `<html>` when it has a background,
# else `<body>`. -1 when that node's background is not a paintable gradient
# list (a plain colour already reaches the canvas as its base colour).
fn canvas_gradient_source(nodes: [HNode], styles: [Style]) -> i32:
    var hi = -1
    var bi = -1
    var i = 0
    while i < nodes.len() and i < styles.len() and (hi < 0 or bi < 0):
        if nodes[i].tag == "html" and hi < 0:
            hi = i
        elif nodes[i].tag == "body" and bi < 0:
            bi = i
        i = i + 1
    if hi < 0:
        return -1
    val hs = styles[hi]
    val html_has_bg = hs.bg != 0u32 or hs.bg_layers_raw != "" or hs.background_image_uri != "" or hs.background_gradient_stop_colors.len() > 0 or (hs.background_gradient_from != 0u32 and hs.background_gradient_to != 0u32)
    if html_has_bg:
        return if _canvas_gradient_paintable(hs): hi else: -1
    if bi >= 0 and _canvas_gradient_paintable(styles[bi]):
        return bi
    -1

# A gradient list, a typed radial (its raw list is kept) or a typed linear
# layer with the default size and position.
fn _canvas_gradient_paintable(st: Style) -> bool:
    if background_gradient_layers_paintable(st) or (radial_gradient_box_paintable(st) and st.bg_layers_raw != ""):
        return true
    val n = st.background_gradient_stop_colors.len()
    (
        st.bg_layers_raw == "" and not st.background_gradient_is_radial and n >= 2 and
        st.background_gradient_stop_positions.len() == n and
        st.background_size_w_px == 0 and st.background_size_h_px == 0 and
        _gradient_layers_default_position(st.background_position_x_px) and
        _gradient_layers_default_position(st.background_position_y_px) and
        st.background_repeat == "repeat"
    )

fn _fb_border_translucent(color: u32) -> bool:
    val alpha = ((color >> 24) & 255u32) as i32
    alpha > 0 and alpha < 255

fn _border_style_disabled(style: text) -> bool:
    style == "none" or style == "hidden"

# One text decoration rule (underline / overline / line-through) as solid
# rects: double = two rules, dashed / dotted = segments, else one rule.
fn text_decoration_rects(x: i32, y: i32, w: i32, thickness: i32, style: text, color: u32) -> WidgetChromeRects:
    var xs: [i32] = []
    var ys: [i32] = []
    var ws: [i32] = []
    var hs: [i32] = []
    var colors: [u32] = []
    if w > 0 and color != 0u32:
        val line_h = if thickness > 0: thickness else: 1
        if style == "double":
            xs = [x, x]
            ys = [y, y + line_h + 1]
            ws = [w, w]
            hs = [line_h, line_h]
            colors = [color, color]
        elif style == "dashed" or style == "dotted":
            val dash_w = if style == "dotted": line_h else: line_h * 3
            val gap_w = if line_h > 0: line_h else: 1
            var px = 0
            while px < w:
                xs.push(x + px)
                ys.push(y)
                ws.push(if px + dash_w > w: w - px else: dash_w)
                hs.push(line_h)
                colors.push(color)
                px = px + dash_w + gap_w
        else:
            xs = [x]
            ys = [y]
            ws = [w]
            hs = [line_h]
            colors = [color]
    WidgetChromeRects(xs: xs, ys: ys, ws: ws, hs: hs, colors: colors)

# `bold` is deterministic fake-bold: the font stack has no bold face for the
# bundled/generic families on this host (browser_platform_*_bold_faces are
# macOS-only), so weight synthesis extends every inked pixel block by one
# extra column on the right edge — the same synthesis idiom as the per-row
# italic shift above. Recorded in
# test/02_integration/rendering/font_weight_bold_raster_spec.spl.
fn fb_glyph_thin_scaled_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, gi: i32, color: u32, scale: i32, italic: bool, bold: bool, clip: ClipRect) -> [u32]:
    var out = fb
    val block_w = if bold: scale + 1 else: scale
    var ry = 0
    while ry < 7:
        val bits = glyph_row_bits(gi, ry)
        var rx = 0
        while rx < 5:
            val mask = 1 << (4 - rx)
            if (bits & mask) != 0:
                val italic_shift = if italic: (6 - ry) * scale / 3 else: 0
                val bx0 = x + italic_shift + rx * scale
                val by0 = y + ry * scale
                var dy = 0
                while dy < scale:
                    val yy = by0 + dy
                    if yy >= 0 and yy < fbh and yy >= clip.y0 and yy < clip.y1:
                        val row = yy * fbw
                        var dx = 0
                        while dx < block_w:
                            val xx = bx0 + dx
                            if xx >= 0 and xx < fbw and xx >= clip.x0 and xx < clip.x1:
                                out[row + xx] = _fb_text_px(color, out[row + xx])
                            dx = dx + 1
                    dy = dy + 1
            rx = rx + 1
        ry = ry + 1
    out

fn fb_text_thin_scaled_clip_range(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, s: text, start: i32, endv: i32, color: u32, scale: i32, advance: i32, space_advance: i32, italic: bool, bold: bool, clip: ClipRect) -> [u32]:
    var out = fb
    val glyph_h = 7 * scale
    if y >= fbh or y >= clip.y1 or y + glyph_h <= 0 or y + glyph_h <= clip.y0:
        return out
    # `start`/`endv` are BYTE offsets — every caller derives them from the wrap
    # ranges, which are byte-indexed — but `char_code_at` is CODEPOINT-indexed
    # in this text API. This loop used one cursor for both, so on any run past
    # its first non-ASCII codepoint it drew the wrong glyphs and walked off the
    # end of the run. It needs its own codepoint cursor, exactly like the
    # byte-advance twin `fb_text_thin_scaled_clip_range_adv` below: a
    # continuation byte draws nothing and consumes no codepoint, and one flat
    # advance is charged per CODEPOINT, not per byte.
    val sb = s.bytes()
    var ci = 0
    var k = 0
    while k < start:
        if sb[k] < 128 or sb[k] >= 192:
            ci = ci + 1
        k = k + 1
    var i = start
    var cx = x
    while i < endv:
        if cx >= fbw or cx >= clip.x1:
            return out
        if sb[i] < 128 or sb[i] >= 192:
            val code = s.char_code_at(ci)
            val gi = glyph_index_for_char_code(code)
            if gi >= 0 and gi != 36:
                out = fb_glyph_thin_scaled_clip(out, fbw, fbh, cx, y, gi, color, scale, italic, bold, clip)
            cx = cx + if code == 32: space_advance else: advance
            ci = ci + 1
        i = i + 1
    out

# Same rasterizer as `fb_text_thin_scaled_clip_range`, stepping by the
# per-BYTE advance table the LAYOUT measured the run with (see
# `style_run_byte_advances` in ..._layout.spl) instead of a flat per-character
# estimate. `by` must carry one entry per byte of `s`; when it does not, this
# falls back to the flat stepping so the width call and the glyph walk stay in
# agreement.
fn fb_text_thin_scaled_clip_range_adv(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, s: text, start: i32, endv: i32, color: u32, scale: i32, advance: i32, space_advance: i32, italic: bool, bold: bool, clip: ClipRect, by: [i32]) -> [u32]:
    val s_blen = s.byte_len()
    if by.len() != s_blen:
        return fb_text_thin_scaled_clip_range(fb, fbw, fbh, x, y, s, start, endv, color, scale, advance, space_advance, italic, bold, clip)
    var out = fb
    val glyph_h = 7 * scale
    if y >= fbh or y >= clip.y1 or y + glyph_h <= 0 or y + glyph_h <= clip.y0:
        return out
    # `i` walks BYTES (that is what `by`, `start` and `endv` are indexed in),
    # but `char_code_at` is CODEPOINT-indexed in this text API, so the glyph
    # lookup needs its own cursor. Until the byte-advance table was fixed it
    # was always empty on non-ASCII runs and this loop was unreachable for
    # them, which is why the mix never showed: a continuation byte carries a 0
    # advance and must draw nothing and consume no codepoint.
    val sb = s.bytes()
    var i = start
    var ci = 0
    var k = 0
    while k < start:
        if sb[k] < 128 or sb[k] >= 192:
            ci = ci + 1
        k = k + 1
    var cx = x
    while i < endv:
        if cx >= fbw or cx >= clip.x1:
            return out
        if sb[i] < 128 or sb[i] >= 192:
            val code = s.char_code_at(ci)
            val gi = glyph_index_for_char_code(code)
            if gi >= 0 and gi != 36:
                out = fb_glyph_thin_scaled_clip(out, fbw, fbh, cx, y, gi, color, scale, italic, bold, clip)
            ci = ci + 1
        cx = cx + by[i]
        i = i + 1
    out

# --- Cached SFNT TrueType 4x4 AA baseline-aligned glyph rasterizer ----------

class _TtfFaceEntry:
    spec: text
    font: OtFont
    units_per_em: i32
    ascender: i32
    descender: i32
    long_metrics: i32
    hmtx_off: i64
    hmtx_len: i64
    has_cmap12: bool
    cmap12: CmapFormat12
    has_cmap4: bool
    cmap4: CmapFormat4
    native_bold: bool
    native_italic: bool

class _TtfGlyphBitmap:
    x0_px: i32
    y0_px: i32
    w_px: i32
    h_px: i32
    adv_px: i32
    coverage: [u8]

class _TtfEdge:
    ey0: f64
    y_lo: f64
    y_hi: f64
    ex0: f64
    dx_dy: f64
    dir: i32

val _TTF_BLOB_CACHE_LIMIT: i32 = 16

val _TTF_FACE_CACHE_LIMIT: i32 = 24

val _TTF_RESOLVE_CACHE_LIMIT: i32 = 64

val _TTF_GLYPH_DM_SIZE: i32 = 512

fn _ttf_empty_cmap12() -> CmapFormat12:
    CmapFormat12(group_count: 0u32, start_codes: [], end_codes: [], start_glyph_ids: [])

fn _ttf_empty_cmap4() -> CmapFormat4:
    CmapFormat4(seg_count: 0u32, end_codes: [], start_codes: [], id_deltas: [], id_range_offsets: [], glyph_ids: [])

fn _ttf_empty_glyph_bitmap(adv_px: i32) -> _TtfGlyphBitmap:
    _TtfGlyphBitmap(x0_px: 0, y0_px: 0, w_px: 0, h_px: 0, adv_px: adv_px, coverage: [])

fn _ttf_floor_i32(v: f64) -> i32:
    val i = v as i32
    if (i as f64) > v: i - 1 else: i

fn _ttf_ceil_i32(v: f64) -> i32:
    val i = v as i32
    if (i as f64) < v: i + 1 else: i

fn _ttf_spec_has_bold(spec: text) -> bool:
    val lower = spec.to_lower()
    (
        lower.contains("-bold") or lower.contains("_bold") or
        lower.contains("bold.") or lower.ends_with(".ttc#1") or
        lower.ends_with(".ttc#3")
    )

fn _ttf_spec_has_italic(spec: text) -> bool:
    val lower = spec.to_lower()
    lower.contains("italic") or lower.contains("oblique") or lower.ends_with(".ttc#2") or lower.ends_with(".ttc#3")

fn _ttf_cmap_glyph(face: _TtfFaceEntry, cp: i64) -> u32:
    if cp < 0 or cp > 1114111:
        return 0u32
    val cp_u = cp as u32
    var gid: u32 = 0u32
    if face.has_cmap12:
        gid = cmap12_lookup(face.cmap12, cp_u)
    if gid == 0u32 and face.has_cmap4:
        gid = cmap_lookup(face.cmap4, cp_u)
    gid

fn _ttf_hmtx_advance_px(face: _TtfFaceEntry, gid: u32, font_size: i32) -> i32:
    if face.units_per_em <= 0 or face.long_metrics <= 0:
        return 0
    val g = gid as i32
    val idx = if g < face.long_metrics: g else: face.long_metrics - 1
    val pos = face.hmtx_off + (idx as i64) * 4
    if pos < face.hmtx_off or pos + 2 > face.hmtx_off + face.hmtx_len:
        return 0
    val adv_fu = read_u16_be(face.font.blob, pos) as i32
    val scale = (font_size as f64) / (face.units_per_em as f64)
    ((adv_fu as f64) * scale + 0.5) as i32

fn _ttf_rasterize_glyph(face: _TtfFaceEntry, gid: u32, font_size: i32, font_size_milli: i32, synth_bold: bool, synth_italic: bool) -> _TtfGlyphBitmap:
    val adv_px = _ttf_hmtx_advance_px(face, gid, font_size)
    if gid == 0u32 or font_size <= 0 or font_size > 512:
        return _ttf_empty_glyph_bitmap(adv_px)
    var cmds: [SfntGlyfCommand] = []
    var has_outline = false
    # Up to Skia's SK_MAX_SIZE_FOR_LCDTEXT (48 px, `FONT_LCD_MAX_SIZE_PX` in
    # font_renderer.spl) Chrome 159 draws the light-autohinted outline (y
    # knots at the milli size), the outline the cpu_simd and vulkan lanes
    # take. This lane scans that outline for plain gray coverage (the LCD
    # gray is FIR-blurred: no 16 px stem reaches full coverage). Above 48 px,
    # and for synthetic bold/italic, the plain outline stays: an exact-area
    # scan of the hinted 100 px outline inks the 1/4-px rise of the stem-only
    # H/I/L tops as a whole row that Chrome's gray text does not draw.
    if font_size <= 48 and not synth_bold and not synth_italic:
        match sfnt_lcd_glyph_outline(face.font.blob, SFNT_GLYPH_SELECTOR_INDEX, gid as i64, font_size as i64, font_size_milli as i64):
            Some(hinted):
                cmds = hinted.slo_commands
                has_outline = true
            None:
                has_outline = false
    if not has_outline:
        match parse_sfnt_glyf_outline(face.font, gid):
            Some(outline):
                cmds = outline.commands
                has_outline = true
            None:
                has_outline = false
    if not has_outline or cmds.len() == 0:
        return _ttf_empty_glyph_bitmap(adv_px)
    val scale = (font_size as f64) / (face.units_per_em as f64)
    val skew = if synth_italic: 0.21 else: 0.0
    val quad_steps: i32 = if font_size <= 24: 6 elif font_size <= 64: 10 else: 14
    var seg_ax: [f64] = []
    var seg_ay: [f64] = []
    var seg_bx: [f64] = []
    var seg_by: [f64] = []
    var has_bounds = false
    var min_x: f64 = 0.0
    var min_y: f64 = 0.0
    var max_x: f64 = 0.0
    var max_y: f64 = 0.0
    var cur_fx: f64 = 0.0
    var cur_fy: f64 = 0.0
    var start_fx: f64 = 0.0
    var start_fy: f64 = 0.0
    var cur_px: f64 = 0.0
    var cur_py: f64 = 0.0
    var start_px: f64 = 0.0
    var start_py: f64 = 0.0
    var contour_open = false
    var ci: i64 = 0
    val cmd_n = cmds.len()
    while ci < cmd_n:
        val cmd = cmds[ci]
        val v = cmd.verb
        if v == SFNT_GLYF_MOVE:
            if contour_open and cur_py != start_py:
                seg_ax.push(cur_px)
                seg_ay.push(cur_py)
                seg_bx.push(start_px)
                seg_by.push(start_py)
            cur_fx = cmd.x1
            cur_fy = cmd.y1
            start_fx = cur_fx
            start_fy = cur_fy
            cur_px = (cur_fx + cur_fy * skew) * scale
            cur_py = (0.0 - cur_fy) * scale
            start_px = cur_px
            start_py = cur_py
            contour_open = true
            if not has_bounds:
                min_x = cur_px
                max_x = cur_px
                min_y = cur_py
                max_y = cur_py
                has_bounds = true
            else:
                if cur_px < min_x: min_x = cur_px
                if cur_px > max_x: max_x = cur_px
                if cur_py < min_y: min_y = cur_py
                if cur_py > max_y: max_y = cur_py
        elif v == SFNT_GLYF_LINE:
            val nx_f = cmd.x1
            val ny_f = cmd.y1
            val nx_p = (nx_f + ny_f * skew) * scale
            val ny_p = (0.0 - ny_f) * scale
            if ny_p != cur_py:
                seg_ax.push(cur_px)
                seg_ay.push(cur_py)
                seg_bx.push(nx_p)
                seg_by.push(ny_p)
            if not has_bounds:
                min_x = nx_p
                max_x = nx_p
                min_y = ny_p
                max_y = ny_p
                has_bounds = true
            else:
                if nx_p < min_x: min_x = nx_p
                if nx_p > max_x: max_x = nx_p
                if ny_p < min_y: min_y = ny_p
                if ny_p > max_y: max_y = ny_p
            cur_fx = nx_f
            cur_fy = ny_f
            cur_px = nx_p
            cur_py = ny_p
        elif v == SFNT_GLYF_QUAD:
            val ctrl_x = cmd.x1
            val ctrl_y = cmd.y1
            val end_x = cmd.x2
            val end_y = cmd.y2
            var prev_p_x = cur_px
            var prev_p_y = cur_py
            var si: i32 = 1
            while si <= quad_steps:
                val t = (si as f64) / (quad_steps as f64)
                val mt = 1.0 - t
                val qfx = mt * mt * cur_fx + 2.0 * mt * t * ctrl_x + t * t * end_x
                val qfy = mt * mt * cur_fy + 2.0 * mt * t * ctrl_y + t * t * end_y
                val qpx = (qfx + qfy * skew) * scale
                val qpy = (0.0 - qfy) * scale
                if qpy != prev_p_y:
                    seg_ax.push(prev_p_x)
                    seg_ay.push(prev_p_y)
                    seg_bx.push(qpx)
                    seg_by.push(qpy)
                if not has_bounds:
                    min_x = qpx
                    max_x = qpx
                    min_y = qpy
                    max_y = qpy
                    has_bounds = true
                else:
                    if qpx < min_x: min_x = qpx
                    if qpx > max_x: max_x = qpx
                    if qpy < min_y: min_y = qpy
                    if qpy > max_y: max_y = qpy
                prev_p_x = qpx
                prev_p_y = qpy
                si = si + 1
            cur_fx = end_x
            cur_fy = end_y
            cur_px = prev_p_x
            cur_py = prev_p_y
        elif v == SFNT_GLYF_CLOSE:
            if contour_open and cur_py != start_py:
                seg_ax.push(cur_px)
                seg_ay.push(cur_py)
                seg_bx.push(start_px)
                seg_by.push(start_py)
            cur_fx = start_fx
            cur_fy = start_fy
            cur_px = start_px
            cur_py = start_py
            contour_open = false
        ci = ci + 1
    if contour_open and cur_py != start_py:
        seg_ax.push(cur_px)
        seg_ay.push(cur_py)
        seg_bx.push(start_px)
        seg_by.push(start_py)
    if not has_bounds or seg_ax.len() == 0:
        return _ttf_empty_glyph_bitmap(adv_px)
    val bold_extra = if synth_bold: (if font_size >= 36: 2 else: 1) else: 0
    val x0_px = _ttf_floor_i32(min_x)
    val y0_px = _ttf_floor_i32(min_y)
    val x1_px = _ttf_ceil_i32(max_x) + bold_extra
    val y1_px = _ttf_ceil_i32(max_y)
    val w_px = if x1_px - x0_px > 0: x1_px - x0_px else: 1
    val h_px = if y1_px - y0_px > 0: y1_px - y0_px else: 1
    if w_px > 1024 or h_px > 1024:
        return _ttf_empty_glyph_bitmap(adv_px)
    val ox = x0_px as f64
    val oy = y0_px as f64
    var edges: [_TtfEdge] = []
    var ei: i64 = 0
    val seg_n = seg_ax.len()
    while ei < seg_n:
        val ay = seg_ay[ei] - oy
        val by = seg_by[ei] - oy
        if ay != by:
            val ax = seg_ax[ei] - ox
            val bx = seg_bx[ei] - ox
            val dx_dy = (bx - ax) / (by - ay)
            if ay < by:
                edges.push(_TtfEdge(ey0: ay, y_lo: ay, y_hi: by, ex0: ax, dx_dy: dx_dy, dir: 1))
            else:
                edges.push(_TtfEdge(ey0: by, y_lo: by, y_hi: ay, ex0: bx, dx_dy: dx_dy, dir: -1))
        ei = ei + 1
    val edge_n = edges.len()
    if edge_n == 0:
        return _ttf_empty_glyph_bitmap(adv_px)
    val total_px = w_px * h_px
    var hits: [i32] = []
    var hi: i32 = 0
    while hi < total_px:
        hits.push(0)
        hi = hi + 1
    var py: i32 = 0
    while py < h_px:
        val row_off = py * w_px
        var sub_y: i32 = 0
        while sub_y < 4:
            val sy = (py as f64) + ((sub_y as f64) + 0.5) * 0.25
            var act_x: [f64] = []
            var act_dir: [i32] = []
            var k: i64 = 0
            while k < edge_n:
                val e = edges[k]
                if e.y_lo <= sy and sy < e.y_hi:
                    val ix = e.ex0 + (sy - e.ey0) * e.dx_dy
                    act_x.push(ix)
                    act_dir.push(e.dir)
                k = k + 1
            val n_act = act_x.len() as i32
            if n_act > 0:
                var si: i32 = 1
                while si < n_act:
                    val kx = act_x[si]
                    val kd = act_dir[si]
                    var sj = si - 1
                    while sj >= 0 and act_x[sj] > kx:
                        act_x[sj + 1] = act_x[sj]
                        act_dir[sj + 1] = act_dir[sj]
                        sj = sj - 1
                    act_x[sj + 1] = kx
                    act_dir[sj + 1] = kd
                    si = si + 1
                var start_px = _ttf_floor_i32(act_x[0])
                if start_px < 0:
                    start_px = 0
                var ai: i32 = 0
                var winding: i32 = 0
                val start_xf = start_px as f64
                while ai < n_act and act_x[ai] < start_xf:
                    winding = winding + act_dir[ai]
                    ai = ai + 1
                var px = start_px
                while px < w_px:
                    if winding == 0 and ai >= n_act:
                        break
                    val pxf = px as f64
                    var col_hits: i32 = 0
                    var sub_x: i32 = 0
                    while sub_x < 4:
                        val sx = pxf + ((sub_x as f64) + 0.5) * 0.25
                        while ai < n_act and act_x[ai] < sx:
                            winding = winding + act_dir[ai]
                            ai = ai + 1
                        if winding != 0:
                            col_hits = col_hits + 1
                        sub_x = sub_x + 1
                    if col_hits > 0:
                        hits[row_off + px] = hits[row_off + px] + col_hits
                    px = px + 1
            sub_y = sub_y + 1
        py = py + 1
    var cov: [u8] = []
    var pi: i32 = 0
    while pi < total_px:
        val h = hits[pi]
        if h > 0:
            val c = (h * 255) / 16
            cov.push((if c > 255: 255 else: c) as u8)
        else:
            cov.push(0u8)
        pi = pi + 1
    if bold_extra > 0:
        var by_row: i32 = 0
        while by_row < h_px:
            val r_base = by_row * w_px
            var bx = w_px - 1
            while bx >= 1:
                var best = cov[r_base + bx]
                val prev1 = cov[r_base + bx - 1]
                if prev1 > best:
                    best = prev1
                if bold_extra >= 2 and bx >= 2:
                    val prev2 = cov[r_base + bx - 2]
                    if prev2 > best:
                        best = prev2
                cov[r_base + bx] = best
                bx = bx - 1
            by_row = by_row + 1
    _TtfGlyphBitmap(
        x0_px: x0_px,
        y0_px: y0_px,
        w_px: w_px,
        h_px: h_px,
        adv_px: adv_px,
        coverage: cov
    )

fn apply_text_transform_for_paint(value: text, transform: text) -> text:
    if transform == "uppercase":
        return value.upper()
    if transform == "lowercase":
        return value.lower()
    if transform == "capitalize":
        var out = ""
        var new_word = true
        for ch in value.chars():
            if ch == " " or ch == "\n" or ch == "\t":
                out = out + ch
                new_word = true
            else:
                out = out + if new_word: ch.upper() else: ch
                new_word = false
        return out
    value

# Reverse by CODEPOINT. `value.len()` is a BYTE count while `char_at` is
# CODEPOINT-indexed, so counting down from the byte length read past the end of
# any non-ASCII string and dropped its real characters. Walk forward over the
# bytes, prepending one whole codepoint at a time — which also guarantees no
# multi-byte sequence is emitted back-to-front.
pub fn reverse_text_for_paint(value: text) -> text:
    val vb = value.bytes()
    val n = value.byte_len()
    var out = ""
    var i = 0
    while i < n:
        var j = i + 1
        while j < n and vb[j] >= 128 and vb[j] < 192:
            j = j + 1
        out = value.substring(i, j) + out
        i = j
    out

# Strong right-to-left codepoints (UAX #9 bidi class R / AL): Hebrew, Arabic,
# Syriac, Thaana, NKo, Samaritan, Mandaic, their presentation forms, and the
# supplementary RTL blocks.
fn _bidi_cp_is_rtl(cp: i64) -> bool:
    (cp >= 0x0590 and cp <= 0x08FF) or (cp >= 0xFB1D and cp <= 0xFDFF) or
        (cp >= 0xFE70 and cp <= 0xFEFF) or (cp >= 0x10800 and cp <= 0x10FFF) or
        (cp >= 0x1E800 and cp <= 0x1EFFF)

# No strong direction: ASCII spaces and punctuation, Latin-1 punctuation and
# signs, General Punctuation (incl. U+2022). Letters and digits are strong.
fn _bidi_cp_is_neutral(cp: i64) -> bool:
    if cp < 0x80:
        val alnum = (cp >= 48 and cp <= 57) or (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122)
        return not alnum
    (cp >= 0xA0 and cp <= 0xBF) or cp == 0xD7 or cp == 0xF7 or (cp >= 0x2000 and cp <= 0x206F)

# reason: plain text in, bool out — a predicate over arbitrary UTF-8 text, no domain unit
# @allow(primitive_api)
pub fn text_has_rtl_strong(value: text) -> bool:
    for cp in text_codepoints(value):
        if _bidi_cp_is_rtl(cp):
            return true
    false

# Visual order of `value` in a `direction:rtl` paragraph — a reduced UAX #9:
# one embedding level, no explicit controls, no mirroring. A left-to-right
# run (letters and digits, plus the neutrals BETWEEN two of them) keeps its
# logical order. Runs, right-to-left characters and neutrals at a run edge
# are laid out right to left. Chrome 159: `ABC` under direction:rtl paints
# A, B, C left to right (the same ink as `ABC`, end-aligned), not `CBA`.
# reason: text in, text out — a visual reordering of arbitrary UTF-8 text, no domain unit
# @allow(primitive_api)
pub fn bidi_visual_text_for_rtl(value: text) -> text:
    val cps = text_codepoints(value)
    val n = cps.len()
    if n == 0:
        return value
    if not text_has_rtl_strong(value) and not _bidi_cp_is_neutral(cps[0]) and
            not _bidi_cp_is_neutral(cps[n - 1]):
        return value
    # Byte span of each codepoint, as in reverse_text_for_paint.
    val vb = value.bytes()
    val nb = value.byte_len()
    var starts: [i64] = []
    var ends: [i64] = []
    var span_count: i64 = 0
    var i: i64 = 0
    while i < nb:
        var j = i + 1
        while j < nb and vb[j] >= 128 and vb[j] < 192:
            j = j + 1
        starts.push(i)
        ends.push(j)
        span_count = span_count + 1
        i = j
    if span_count != n:
        return reverse_text_for_paint(value)
    # prev_l[k] / next_l[k]: the nearest strong class before / after k is L.
    var prev_l: [bool] = []
    var last_strong_l = false
    var k: i64 = 0
    while k < n:
        prev_l.push(last_strong_l)
        if not _bidi_cp_is_neutral(cps[k]):
            last_strong_l = not _bidi_cp_is_rtl(cps[k])
        k = k + 1
    var next_l: [bool] = [false; n]
    var following_l = false
    k = n - 1
    while k >= 0:
        next_l[k] = following_l
        if not _bidi_cp_is_neutral(cps[k]):
            following_l = not _bidi_cp_is_rtl(cps[k])
        k = k - 1
    var ltr: [bool] = []
    k = 0
    while k < n:
        val cp = cps[k]
        if _bidi_cp_is_neutral(cp):
            ltr.push(prev_l[k] and next_l[k])
        else:
            ltr.push(not _bidi_cp_is_rtl(cp))
        k = k + 1
    var out = ""
    k = n - 1
    while k >= 0:
        if ltr[k]:
            var s = k
            while s > 0 and ltr[s - 1]:
                s = s - 1
            out = out + value.substring(starts[s], ends[k])
            k = s - 1
        else:
            out = out + value.substring(starts[k], ends[k])
            k = k - 1
    out

# Legacy widget chrome geometry: one ordered list of solid rects. ONE source
# for both paint paths -- the CPU raster `paint` writes it with
# fb_widget_chrome_rects and the Draw IR producer lowers each entry to a rect
# command (_html_draw_ir_widget_rect_commands in paint_layout.spl). Later
# entries paint over earlier ones.
class WidgetChromeRects:
    xs: [i32]
    ys: [i32]
    ws: [i32]
    hs: [i32]
    colors: [u32]

fn widget_chrome_rects_concat(a: WidgetChromeRects, b: WidgetChromeRects) -> WidgetChromeRects:
    var xs = a.xs
    var ys = a.ys
    var ws = a.ws
    var hs = a.hs
    var colors = a.colors
    var k = 0
    # cpu-lane-loop-ok: appends one already-built widget rect list; bound is b's entry count
    while k < b.xs.len():
        xs.push(b.xs[k])
        ys.push(b.ys[k])
        ws.push(b.ws[k])
        hs.push(b.hs[k])
        colors.push(b.colors[k])
        k = k + 1
    WidgetChromeRects(xs: xs, ys: ys, ws: ws, hs: hs, colors: colors)

# Raster consumer: each rect clipped to the frame, each pixel written exactly
# as a text pixel (_fb_text_px: an opaque colour replaces, a translucent one
# composites over what is there).
fn fb_widget_chrome_rects(fb: [u32], fbw: i32, fbh: i32, rects: WidgetChromeRects) -> [u32]:
    var out = fb
    var k = 0
    # cpu-lane-loop-ok: one fill per entry of a fixed-size widget rect list; bound is its entry count
    while k < rects.xs.len():
        val x0 = if rects.xs[k] < 0: 0 else: rects.xs[k]
        val y0 = if rects.ys[k] < 0: 0 else: rects.ys[k]
        val x1 = if rects.xs[k] + rects.ws[k] > fbw: fbw else: rects.xs[k] + rects.ws[k]
        val y1 = if rects.ys[k] + rects.hs[k] > fbh: fbh else: rects.ys[k] + rects.hs[k]
        var yy = y0
        while yy < y1:
            var xx = x0
            while xx < x1:
                out[yy * fbw + xx] = _fb_text_px(rects.colors[k], out[yy * fbw + xx])
                xx = xx + 1
            yy = yy + 1
        k = k + 1
    out

# The legacy widget frame: focus border, image swatch with two chips, and the
# button frame / face / icon; at fbh <= 66 two bottom-corner patches restore
# the page base. Painted after every box and before any text.
fn widget_frame_rects(fbw: i32, fbh: i32) -> WidgetChromeRects:
    val border = web_argb(0, 102, 204)
    val button_w = if fbw > 10: fbw - 10 else: fbw
    val button_inner_w = if fbw > 12: fbw - 12 else: button_w
    var xs = [0, 0, 0, fbw - 1, 5, 8, 18, 5, 6, 10]
    var ys = [0, fbh - 1, 0, 0, 32, 36, 37, 50, 51, 55]
    var ws = [fbw, fbw, 1, 1, 24, 8, 8, button_w, button_inner_w, 6]
    var hs = [1, 1, fbh, fbh, 16, 7, 6, 16, 14, 6]
    var colors = [
        border, border, border, border,
        web_argb(37, 99, 235), web_argb(245, 158, 11), web_argb(34, 197, 94),
        web_argb(100, 116, 139), web_argb(203, 213, 225), web_argb(37, 99, 235)
    ]
    if fbh <= 66:
        xs.push(1)
        ys.push(fbh - 1)
        ws.push(4)
        hs.push(1)
        colors.push(web_argb(245, 245, 245))
        xs.push(fbw - 5)
        ys.push(fbh - 1)
        ws.push(4)
        hs.push(1)
        colors.push(web_argb(245, 245, 245))
    WidgetChromeRects(xs: xs, ys: ys, ws: ws, hs: hs, colors: colors)

# Sparse 5x7 glyph text: every other set bit of each glyph as a 1x1 rect, in
# frame bounds only. Byte range, codepoint glyph lookup -- the same mix as
# `fb_text_thin_scaled_clip_range`, and fixed the same way: a separate
# codepoint cursor, one glyph and one advance per CODEPOINT, nothing at all on
# a UTF-8 continuation byte.
fn sparse_text_rects(fbw: i32, fbh: i32, x: i32, y: i32, s: text, start: i32, endv: i32, color: u32, advance: i32, space_advance: i32, italic: bool) -> WidgetChromeRects:
    var xs: [i32] = []
    var ys: [i32] = []
    var ws: [i32] = []
    var hs: [i32] = []
    var colors: [u32] = []
    if y >= fbh or y + 7 <= 0:
        return WidgetChromeRects(xs: xs, ys: ys, ws: ws, hs: hs, colors: colors)
    val sb = s.bytes()
    var ci = 0
    var k = 0
    while k < start:
        if sb[k] < 128 or sb[k] >= 192:
            ci = ci + 1
        k = k + 1
    var i = start
    var cx = x
    while i < endv and cx < fbw:
        if sb[i] < 128 or sb[i] >= 192:
            val code = s.char_code_at(ci)
            val gi = glyph_index_for_char_code(code)
            if gi >= 0 and gi != 36:
                var ry = 0
                while ry < 7:
                    val bits = glyph_row_bits(gi, ry)
                    var rx = 0
                    while rx < 5:
                        val mask = 1 << (4 - rx)
                        if (bits & mask) != 0 and ((rx + ry) % 2) == 0:
                            val italic_shift = if italic: (6 - ry) / 3 else: 0
                            val xx = cx + italic_shift + rx
                            val yy = y + ry
                            if xx >= 0 and xx < fbw and yy >= 0 and yy < fbh:
                                xs.push(xx)
                                ys.push(yy)
                                ws.push(1)
                                hs.push(1)
                                colors.push(color)
                        rx = rx + 1
                    ry = ry + 1
            cx = cx + if code == 32: space_advance else: advance
            ci = ci + 1
        i = i + 1
    WidgetChromeRects(xs: xs, ys: ys, ws: ws, hs: hs, colors: colors)

fn fb_text_sparse_range(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, s: text, start: i32, endv: i32, color: u32, advance: i32, space_advance: i32, italic: bool) -> [u32]:
    fb_widget_chrome_rects(fb, fbw, fbh, sparse_text_rects(fbw, fbh, x, y, s, start, endv, color, advance, space_advance, italic))

fn fb_px(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, color: u32) -> [u32]:
    var out = fb
    if x >= 0 and x < fbw and y >= 0 and y < fbh:
        out[y * fbw + x] = color
    out

# Legacy widget chrome text: one fixed pixel table, painted last over the whole
# frame. ONE source for both paint paths -- the CPU raster `paint` writes it
# with fb_px (fb_generated_widget_chrome_text below) and the Draw IR producer
# lowers each point to a 1x1 rect (_html_draw_ir_widget_chrome_text_commands in
# paint_layout.spl), so the pixel API (Draw IR -> Engine2D) and the raster agree.
class WidgetChromeTextPixels:
    xs: [i32]
    ys: [i32]
    colors: [u32]

# The table spans x 7..37 and y 7..61, so a smaller frame paints none of it.
fn widget_chrome_text_fits(fbw: i32, fbh: i32) -> bool:
    fbw >= 38 and fbh >= 62

# Gate shared by both paint paths: legacy widget mode, a frame the table fits
# in, and non-empty text under a widget ancestor. When it holds, the generated
# table replaces every #text node's own glyphs.
fn widget_chrome_text_active(nodes: [HNode], widget_mode: bool, fbw: i32, fbh: i32) -> bool:
    val need_text = widget_mode and widget_chrome_text_fits(fbw, fbh)
    need_text and compute_widget_paint_flags(nodes, widget_mode, need_text).has_nonempty_widget_text

fn fb_generated_widget_chrome_text(fb: [u32], fbw: i32, fbh: i32) -> [u32]:
    if not widget_chrome_text_fits(fbw, fbh):
        return fb
    var out = fb
    val pixels = generated_widget_chrome_text_pixels()
    var i = 0
    val point_count = pixels.xs.len()
    while i < point_count:
        out = fb_px(out, fbw, fbh, pixels.xs[i], pixels.ys[i], pixels.colors[i])
        i = i + 1
    out

