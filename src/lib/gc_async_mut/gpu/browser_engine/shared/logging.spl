"""
# Browser Logger

Structured logging for browser engine subsystems.
"""

#![allow(REQC001)]

pub enum BrowserLogLevel:
    Trace
    Debug
    Info
    Warn
    Error

fn _level_rank(l: BrowserLogLevel) -> i64:
    match l:
        BrowserLogLevel.Trace: 0
        BrowserLogLevel.Debug: 1
        BrowserLogLevel.Info:  2
        BrowserLogLevel.Warn:  3
        BrowserLogLevel.Error: 4

pub class Logger:
    name: text
    # The configured minimum level. `new` used to accept this argument and throw
    # it away -- the class had no field to put it in -- so every Logger behaved
    # as if it were set to Trace no matter what the caller asked for.
    min_level: BrowserLogLevel

    static fn new(name: text, level: BrowserLogLevel) -> Logger:
        Logger(name: name, min_level: level)

    fn level_tag(l: BrowserLogLevel) -> text:
        match l:
            BrowserLogLevel.Trace: "TRACE"
            BrowserLogLevel.Debug: "DEBUG"
            BrowserLogLevel.Info: "INFO"
            BrowserLogLevel.Warn: "WARN"
            BrowserLogLevel.Error: "ERROR"

    # The inverse of the rest of this defect family: not "errors are suppressed"
    # but "nothing is suppressed". This bound `val _level = msg_level` and then
    # ignored it, returning an unconditional `true`, so the level filter did
    # nothing at all and a Logger built with a threshold of Error still printed
    # every Trace message. Combined with `new` discarding the level, the filter
    # was inert on both ends.
    #
    # doc/08_tracking/bug/logging_surfaces_that_suppress_errors_by_default_family_2026-08-10.md (OPEN 4)
    me should_log(msg_level: BrowserLogLevel) -> bool:
        _level_rank(msg_level) >= _level_rank(self.min_level)

    me log(msg_level: BrowserLogLevel, msg: text):
        if self.should_log(msg_level):
            val tag = self.level_tag(msg_level)
            val formatted = "[{tag}] [{self.name}] {msg}"
            print(formatted)

    me trace(msg: text):
        self.log(BrowserLogLevel.Trace, msg)

    me debug(msg: text):
        self.log(BrowserLogLevel.Debug, msg)

    me info(msg: text):
        self.log(BrowserLogLevel.Info, msg)

    me warn(msg: text):
        self.log(BrowserLogLevel.Warn, msg)

    me error(msg: text):
        self.log(BrowserLogLevel.Error, msg)
