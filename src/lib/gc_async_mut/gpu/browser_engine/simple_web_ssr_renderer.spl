"""
# Narrow canonical server-side web renderer

This capability boundary intentionally exposes only the in-memory HTML pixel
operation used by the hosted HTTP server.  It still follows the canonical web
layout -> Draw IR -> Engine2D path and uses the same backend resolver as the
general browser renderer, but does not pull URL/file loading, theme preview,
readback, or animation APIs into the server executable closure.
"""

use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    simple_web_engine2d_resolved_backend_name
}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d
}

pub fn simple_web_ssr_render_html_to_pixels(
    html: text, width: i32, height: i32, backend_name: text
) -> [u32]:
    val resolved = simple_web_engine2d_resolved_backend_name(
        width, height, backend_name
    )
    simple_web_layout_render_html_pixels_engine2d(
        html, width, height, resolved
    )

export simple_web_ssr_render_html_to_pixels
