# Pinned case02 source DrawIR v4 to strict single-surface GPU projection.
# All six source commands are proved before any replacement command is kept.

use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU, DRAW_IR_BACKEND_GPU, DRAW_IR_COMMAND_RECT,
    DRAW_IR_RASTER_ALIASED_PIXEL_CENTER, DRAW_IR_RASTER_COVERAGE_AA,
    DRAW_IR_SCHEMA_VERSION_V4, DRAW_IR_SOURCE_HTML_AST,
    DrawIrCommand, DrawIrComposition, DrawIrFractionalGeometry,
    DrawIrAffine2D, draw_ir_affine_rect, draw_ir_batch_with_source_v4,
    draw_ir_composition_v4, draw_ir_embedding_config, draw_ir_rect,
    draw_ir_rect_bounds}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{HNode}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{Style}
use std.gc_async_mut.gpu.browser_engine.web_opaque_box_checks.{
    WEB_OPAQUE_STYLE_KEYS, WEB_OPAQUE_REQUIRED_PAINT_KEYS,
    _web_style_neutral, _web_raw_style_reason_with_case02}

pub class WebCase02Projection:
    gpu: DrawIrComposition
    source_indexes: [i64]

fn _web_case02_near(actual: f64, expected: f64) -> bool:
    actual == actual and actual >= expected - 0.00001 and
        actual <= expected + 0.00001

fn _web_case02_role(index: i32) -> text:
    if index == 0: return "canvas"
    if index <= 3: return "painted-background"
    if index == 4: return "rotated-leaf"
    "fractional-bar"

fn _web_case02_node_id(node: HNode, index: i32) -> text:
    if node.id_attr != "": return node.id_attr
    "{node.tag}_{index}"

fn _web_case02_authored_reason(st: Style, index: i32) -> text:
    if st.fractional_authored_decls.len() == 0:
        return "missing-authored-provenance:{index}"
    val allowed = "|box-sizing|margin|padding|width|height|background|" +
        "position|overflow|color|font|left|top|transform|"
    for entry in st.fractional_authored_decls:
        val parts = entry.split("=")
        if parts.len() < 2 or not allowed.contains("|{parts[0]}|"):
            return "unknown-authored-property:{index}"
    ""

fn _web_case02_style_reason(
    command: DrawIrCommand, st: Style?, index: i32,
    node_index: i32, source_sha: text
) -> text:
    var seen: Dict<text, bool> = {}
    for prop in command.computed_style:
        if seen.get(prop.key) ?? false:
            return "duplicate-source-style:{index}:{prop.key}"
        seen[prop.key] = true
        if prop.key == "source-role":
            if prop.value != _web_case02_role(index):
                return "source-role-mismatch:{index}"
        elif prop.key == "source-node-index":
            if prop.value != "{node_index}":
                return "source-node-index-mismatch:{index}"
        elif prop.key == "source-html-sha256":
            if index != 0 or prop.value != source_sha:
                return "source-html-sha256-mismatch:{index}"
        elif prop.key == "source-transform-raw":
            if index < 4 or st == nil:
                return "unexpected-source-transform:{index}"
            if val Some(style) = st:
                if prop.value != style.transform_raw:
                    return "source-transform-mismatch:{index}"
        elif not WEB_OPAQUE_STYLE_KEYS.contains("|{prop.key}|"):
            return "unknown-source-style:{index}:{prop.key}"
        elif prop.key == "transform":
            if st == nil:
                return "canvas-transform-style:{index}"
            if val Some(style) = st:
                if prop.value != style.transform_raw:
                    return "source-transform-style-mismatch:{index}"
        elif prop.key == "box-geometry-unresolved":
            val expected = if index >= 4: "true" else: "false"
            if prop.value != expected:
                return "source-geometry-style-mismatch:{index}"
        elif not _web_style_neutral(prop.key, prop.value, command.color):
            return "source-paint-style-unhandled:{index}:{prop.key}"
    if not (seen.get("source-role") ?? false) or
        not (seen.get("source-node-index") ?? false):
        return "missing-source-role-style:{index}"
    if index == 0 and not (seen.get("source-html-sha256") ?? false):
        return "missing-source-html-sha256"
    if index >= 4 and not (seen.get("source-transform-raw") ?? false):
        return "missing-source-transform:{index}"
    if index > 0:
        for key in WEB_OPAQUE_REQUIRED_PAINT_KEYS.split("|"):
            if key != "" and not (seen.get(key) ?? false):
                return "missing-source-paint-style:{index}:{key}"
    ""

fn _web_case02_matrix_reason(
    geometry: DrawIrFractionalGeometry, matrix: DrawIrAffine2D,
    index: i32
) -> text:
    if geometry.x != 0.0 or geometry.y != 0.0:
        return "nonlocal-fractional-geometry:{index}"
    if index <= 3:
        if not _web_case02_near(geometry.width, 640.0) or
            not _web_case02_near(geometry.height, 480.0) or
            not _web_case02_near(matrix.a, 1.0) or
            not _web_case02_near(matrix.b, 0.0) or
            not _web_case02_near(matrix.c, 0.0) or
            not _web_case02_near(matrix.d, 1.0) or
            not _web_case02_near(matrix.tx, 0.0) or
            not _web_case02_near(matrix.ty, 0.0):
            return "background-not-full-surface:{index}"
    elif index == 4:
        val center_x = 90.25
        val center_y = 50.0
        val expected_tx = 40.25 + 0.25 + center_x -
            matrix.a * center_x - matrix.c * center_y
        val expected_ty = 50.5 + 0.25 + center_y -
            matrix.b * center_x - matrix.d * center_y
        if not _web_case02_near(geometry.width, 180.5) or
            not _web_case02_near(geometry.height, 100.0) or
            not _web_case02_near(matrix.a, 0.992546151641322) or
            not _web_case02_near(matrix.b, 0.121869343405147) or
            not _web_case02_near(matrix.c, 0.0 - matrix.b) or
            not _web_case02_near(matrix.d, matrix.a) or
            not _web_case02_near(matrix.tx, expected_tx) or
            not _web_case02_near(matrix.ty, expected_ty):
            return "rotated-tile-matrix-unhandled"
    else:
        if not _web_case02_near(geometry.width, 2.5) or
            not _web_case02_near(geometry.height, 280.5) or
            not _web_case02_near(matrix.a, 1.0) or
            not _web_case02_near(matrix.b, 0.0) or
            not _web_case02_near(matrix.c, 0.0) or
            not _web_case02_near(matrix.d, 1.0) or
            not _web_case02_near(matrix.tx, 290.5) or
            not _web_case02_near(matrix.ty, 40.25):
            return "fractional-bar-matrix-unhandled"
    ""

fn _web_case02_command_reason(
    command: DrawIrCommand, nodes: [HNode], styles: [Style],
    index: i32, source_sha: text
) -> text:
    if command.kind != DRAW_IR_COMMAND_RECT or
        command.x != 0 or command.y != 0 or
        command.width != 0 or command.height != 0 or
        command.fractional_geometry == nil or
        command.affine_transform == nil or
        command.text_value != "" or command.advance_widths.len() != 0 or
        command.edge != nil or command.image_uri != "" or
        command.points.len() != 0 or command.glyph_run.valid or
        command.glyph_run.glyph_ids.len() != 0 or
        command.glyph_run.xs.len() != 0 or
        command.glyph_run.ys.len() != 0 or
        command.glyph_run.clusters.len() != 0 or
        command.border_rect.present or command.content_rect.present or
        command.hit_rect.present:
        return "source-command-payload-unhandled:{index}"
    if not command.clip_rect.present or command.clip_rect.x != 0 or
        command.clip_rect.y != 0 or command.clip_rect.width != 640 or
        command.clip_rect.height != 480:
        return "source-surface-clip-unhandled:{index}"
    val expected_color = if index <= 3: 0xFFFFFFFFu32
        elif index == 4: 0xFF247BDEu32 else: 0xFF111111u32
    val expected_policy = if index <= 3:
        DRAW_IR_RASTER_ALIASED_PIXEL_CENTER
    else:
        DRAW_IR_RASTER_COVERAGE_AA
    if command.color != expected_color or
        command.raster_policy != expected_policy:
        return "source-color-or-raster-unhandled:{index}"
    if val Some(geometry) = command.fractional_geometry:
        if val Some(matrix) = command.affine_transform:
            val matrix_reason = _web_case02_matrix_reason(
                geometry, matrix, index)
            if matrix_reason != "": return matrix_reason
    if index == 0:
        if command.component_id != "html-canvas" or command.parent_id != "":
            return "source-canvas-identity-unhandled"
        return _web_case02_style_reason(command, nil, index, -1, source_sha)
    var matched = -1
    var candidate = 0
    while candidate < nodes.len():
        if _web_case02_node_id(nodes[candidate], candidate) ==
            command.component_id:
            if matched >= 0:
                return "ambiguous-source-node:{index}"
            matched = candidate
        candidate = candidate + 1
    if matched < 0:
        return "missing-source-node:{index}"
    val node = nodes[matched]
    val parent = node.parent as i32
    if parent < 0 or parent >= nodes.len() or
        command.parent_id != _web_case02_node_id(nodes[parent], parent):
        return "source-parent-unhandled:{index}"
    if (index == 1 and (node.tag != "html" or nodes[parent].tag != "#root")) or
        (index == 2 and (node.tag != "body" or nodes[parent].tag != "html")) or
        (index == 3 and (node.tag != "div" or node.id_attr != "scene" or
            nodes[parent].tag != "body")) or
        (index == 4 and (node.tag != "div" or node.class_attr != "tile" or
            nodes[parent].id_attr != "scene")) or
        (index == 5 and (node.tag != "div" or node.class_attr != "" or
            nodes[parent].id_attr != "scene")):
        return "source-node-role-unhandled:{index}"
    val st = styles[matched]
    if st.bg != command.color or st.opacity_pct != 100 or
        (index == 3 and (not st.position_relative or not st.overflow_hidden)) or
        (index >= 4 and (not st.position_absolute or not st.border_box)) or
        (index == 4 and st.transform_raw !=
            "translate(.25px,.25px) rotate(7deg)") or
        (index == 5 and st.transform_raw != "none"):
        return "source-style-state-unhandled:{index}"
    val raw_reason = _web_raw_style_reason_with_case02(
        st, command, index.to_i64(), index == 3, index == 4,
        index >= 4)
    if raw_reason != "": return raw_reason
    val authored_reason = _web_case02_authored_reason(st, index)
    if authored_reason != "": return authored_reason
    _web_case02_style_reason(command, Some(st), index, matched, source_sha)

# Only the pinned public wrapper admits HTML. Direct callers still receive the
# same full source-command and raw-style preflight, including the pinned digest.
fn web_case02_project_v4(
    source: DrawIrComposition, nodes: [HNode], styles: [Style],
    source_sha: text
) -> Result<WebCase02Projection, text>:
    if source_sha !=
        "5ad0ddd4a7848160e220c116c7c7f21872a7f184d3444a2d97990e88da10bfe1":
        return Err("case02-helper-source-sha-unpinned")
    if source.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        source.backend_target != DRAW_IR_BACKEND_CPU or
        source.batches.len() != 1 or nodes.len() != styles.len():
        return Err("case02-source-topology-unhandled")
    val batch = source.batches[0]
    val embedding = batch.embedding
    if batch.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        batch.backend_target != DRAW_IR_BACKEND_CPU or
        batch.source.source_kind != DRAW_IR_SOURCE_HTML_AST or
        batch.source.source_id != "simple_web_html_layout_renderer" or
        embedding.x != 0 or embedding.y != 0 or
        embedding.width != 640 or embedding.height != 480 or
        embedding.layer != 0 or embedding.opacity_milli != 1000 or
        not embedding.clip or batch.commands.len() != 6:
        return Err("case02-source-batch-unhandled")
    var index = 0
    while index < 6:
        val reason = _web_case02_command_reason(
            batch.commands[index], nodes, styles, index, source_sha)
        if reason != "": return Err(reason)
        index = index + 1
    var gpu_commands: [DrawIrCommand] = []
    var source_indexes: [i64] = []
    index = 0
    while index < 6:
        val command = batch.commands[index]
        if index <= 3:
            gpu_commands.push(draw_ir_rect(
                command.component_id, 0, 0, 640, 480, command.color))
        else:
            if val Some(geometry) = command.fractional_geometry:
                if val Some(matrix) = command.affine_transform:
                    var projected = draw_ir_affine_rect(
                        command.component_id, geometry.width,
                        geometry.height, command.color, matrix,
                        command.raster_policy)
                    projected.clip_rect = draw_ir_rect_bounds(0, 0, 640, 480)
                    gpu_commands.push(projected)
        source_indexes.push(index.to_i64())
        index = index + 1
    if gpu_commands.len() != 6 or source_indexes.len() != 6:
        return Err("case02-projection-incomplete")
    val gpu_embedding = draw_ir_embedding_config(
        embedding.surface_id, embedding.component_id,
        0, 0, 640, 480, 0, 1000, false)
    val gpu_batch = draw_ir_batch_with_source_v4(
        batch.batch_id, DRAW_IR_BACKEND_GPU, gpu_embedding,
        gpu_commands, batch.source)
    val gpu = draw_ir_composition_v4(
        source.composition_id, source.scene_key, DRAW_IR_BACKEND_GPU,
        [gpu_batch])
    Ok(WebCase02Projection(gpu: gpu, source_indexes: source_indexes))
