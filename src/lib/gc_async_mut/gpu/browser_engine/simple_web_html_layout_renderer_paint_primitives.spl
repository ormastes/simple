fn web_glyph_scale(fs: i32) -> i32:
    var s = fs / 8
    if s < 1:
        s = 1
    s

# write `color` to a single framebuffer pixel (clipped)
fn fb_put(mut fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, color: u32):
    if x < 0 or y < 0 or x >= fbw or y >= fbh:
        return
    fb[y * fbw + x] = color

fn fb_clear(mut fb: [u32], color: u32):
    var i = 0
    val n = fb.len()
    while i < n:
        fb[i] = color
        i = i + 1

fn browser_layout_framebuffer_filled(base: u32, width: i32, height: i32) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    val pixels = width.to_i64() * height.to_i64()
    val workers: i64 = if pixels >= 1048576: 8 else: 1
    engine2d_simd_fill_rows_u32(width.to_i64(), height.to_i64(), base, workers)

fn browser_layout_framebuffer_filled_serial(base: u32, width: i32, height: i32) -> [u32]:
    engine2d_simd_fill_rows_u32(width.to_i64(), height.to_i64(), base, 1)

# clipped filled rectangle
fn fb_rect(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, color: u32) -> [u32]:
    var out = fb
    var x0 = x
    var y0 = y
    var x1 = x + w
    var y1 = y + h
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    fb_fill_rows_const(out, fbw, x0, y0, x1, y1, color)

class PaintClipCache:
    has_node_clips: bool
    default_clip: ClipRect
    clips: [ClipRect]

fn clip_intersect(c: ClipRect, x0: i32, y0: i32, x1: i32, y1: i32) -> ClipRect:
    var nx0 = c.x0
    var ny0 = c.y0
    var nx1 = c.x1
    var ny1 = c.y1
    if x0 > nx0:
        nx0 = x0
    if y0 > ny0:
        ny0 = y0
    if x1 < nx1:
        nx1 = x1
    if y1 < ny1:
        ny1 = y1
    ClipRect(x0: nx0, y0: ny0, x1: nx1, y1: ny1)

fn fb_rect_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, color: u32, clip: ClipRect) -> [u32]:
    var out = fb
    var x0 = x
    var y0 = y
    var x1 = x + w
    var y1 = y + h
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    out = fb_fill_rows_const(out, fbw, x0, y0, x1, y1, color)
    out

# ============================================================================
# Solid-fill row template
#
# `fb_rect_clip` and `fb_rect` are the busiest primitives in the renderer: every
# solid background reaches one of them (via fb_style_background_opacity_clip ->
# rounded -> corners -> radius 0 -> fb_rect_opacity_clip), as do all four
# border sides, outlines, underlines and form controls — 23 call sites for
# fb_rect_clip alone, over the whole viewport, overdrawn several times a frame.
#
# Both ran one INTERPRETED STORE PER PIXEL. A constant fill deliberately has no
# span-kernel path (simd_kernels.spl:460-473 measured the extern round trip at
# 7 ms vs 0 ms scalar — the ABI cannot mutate the caller's array, so the return
# plus copy-back costs more than the stores it replaces). The cheap bulk
# channel is `write_span`, so the shape that wins is: build ONE row natively,
# then bulk-write it per row.
# ============================================================================
fn fb_fill_rows_const(fb: [u32], fbw: i32, x0: i32, y0: i32, x1: i32, y1: i32, color: u32) -> [u32]:
    """Fill the already-clipped rect [x0,x1) x [y0,y1) with a constant colour."""
    var out = fb
    val w = x1 - x0
    if w <= 0 or y1 <= y0:
        return out
    val row = engine2d_simd_fill_row_u32(w.to_i64(), color)
    if row.len() != w:
        # The native row builder is unavailable; fall back rather than write a
        # short row, which would leave the tail of every line unpainted.
        return _scalar_fill_rows_const(out, fbw, x0, y0, x1, y1, color)
    var py = y0
    while py < y1:
        out.write_span(row, (py * fbw + x0).to_i64(), 0, w.to_i64())
        py = py + 1
    out

fn _scalar_fill_rows_const(fb: [u32], fbw: i32, x0: i32, y0: i32, x1: i32, y1: i32, color: u32) -> [u32]:
    """Scalar reference path — identical output by construction."""
    var out = fb
    var py = y0
    while py < y1:
        val base = py * fbw
        var px = x0
        while px < x1:
            out[base + px] = color
            px = px + 1
        py = py + 1
    out

fn blend_opacity(src: u32, dst: u32, opacity_pct: i32) -> u32:
    """Composite the opaque colour src over dst at an integer percent opacity,
    as Chrome 159 composites a solid fill: the percent becomes the 8-bit paint
    alpha a = round(pct*255/100) and each channel is
    round(s*a/255) + ((d*(256-a)) >> 8) (SkPMSrcOver; dst treated as opaque,
    output alpha 255). Bit-identical to rt_engine2d_blend_const_span_pct_u32
    (C runtime and interpreter bridge) and Engine2D color.blend_solid."""
    if opacity_pct >= 100:
        return src
    if opacity_pct <= 0:
        return dst
    val a = (opacity_pct * 255 + 50) / 100
    val inv256 = 256 - a
    val sr = (((src >> 16) & 255u32) as i32)
    val sg = (((src >> 8) & 255u32) as i32)
    val sb = ((src & 255u32) as i32)
    val dr = (((dst >> 16) & 255u32) as i32)
    val dg = (((dst >> 8) & 255u32) as i32)
    val db = ((dst & 255u32) as i32)
    val r = (sr * a + 127) / 255 + (dr * inv256) / 256
    val g = (sg * a + 127) / 255 + (dg * inv256) / 256
    val b = (sb * a + 127) / 255 + (db * inv256) / 256
    web_argb(r, g, b)

fn fb_rect_opacity_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, color: u32, opacity_pct: i32, clip: ClipRect) -> [u32]:
    if opacity_pct >= 100:
        return fb_rect_clip(fb, fbw, fbh, x, y, w, h, color, clip)
    var out = fb
    var x0 = x
    var y0 = y
    var x1 = x + w
    var y1 = y + h
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    # Row kernel instead of a per-pixel loop. `blend_opacity` is ~15 integer
    # ops per pixel, which is the regime where the gather/extern/scatter round
    # trip pays for itself — the same regime as simd_blend_row (measured 0 ms
    # vs 13 ms), and unlike a constant fill, where it is a documented loss.
    #
    # The kernel takes a PERCENT (converted to the 8-bit alpha
    # round(pct*255/100)); rt_engine2d_simd_blend_const_span_u32 takes the
    # colour's own alpha byte instead. Both composite with Chrome's solid rule.
    var py = y0
    while py < y1:
        val row = py * fbw
        out = fb_blend_const_row_opacity(out, row + x0, x1 - x0, color, opacity_pct)
        py = py + 1
    out

# The kernel returns ONLY the blended span, not the whole framebuffer.
#
# It used to return the whole thing, which meant one unpack+repack of the
# ENTIRE framebuffer per row. Measured with a 10x50 rect on a 1920x384 buffer,
# that was 1214 ms against the scalar loop's 1116 ms — a REGRESSION on the
# shape that actually occurs. The original 333 ms -> 1 ms measurement used a
# rect covering the whole buffer, which hid the fb_len term completely.
@unsafe(reason: "percent-opacity constant-colour span blend; bounds are enforced inside the kernel", capabilities: [ffi])
extern fn rt_engine2d_blend_const_span_pct_u32(dst: [u32], offset: i64, count: i64, color: u32, opacity_pct: i64) -> [u32]

@unsafe(reason: "soft box-shadow coverage-span blend kernel", capabilities: [ffi])
extern fn rt_engine2d_blend_cov_span_u32(dst: [u32], offset: i64, colcov: [i32], count: i64, cov_y_and_alpha: i64, color: u32) -> [u32]?

fn fb_blend_const_row_opacity(fb: [u32], offset: i32, count: i32, color: u32, opacity_pct: i32) -> [u32]:
    """Blend one constant colour across a row span at an integer percent opacity.

    Falls back to the scalar twin when the native kernel is unavailable. An
    unbacked extern returns nil, so a result whose length is not exactly the
    requested span is treated as "not backed" and never written back.
    """
    if count <= 0:
        return fb
    var out = fb
    if offset < 0 or offset >= out.len():
        return out
    var n = count
    if offset + n > out.len():
        n = out.len() - offset
    val span = rt_engine2d_blend_const_span_pct_u32(
        out, offset.to_i64(), n.to_i64(), color, opacity_pct.to_i64())
    if span.len() != n:
        return _scalar_blend_const_row_opacity(fb, offset, count, color, opacity_pct)
    # Bulk write-back, not a per-element loop. The kernel does the blend
    # natively and then this loop handed the win back one interpreted store at
    # a time; `write_span` is the same bulk channel simd_blit_row uses.
    out.write_span(span, offset.to_i64(), 0, n.to_i64())
    out

fn _scalar_blend_const_row_opacity(fb: [u32], offset: i32, count: i32, color: u32, opacity_pct: i32) -> [u32]:
    """Scalar reference path — bit-identical to the kernel by construction.

    The span is clamped to the buffer exactly as the kernel clamps it. This is
    not defensive dressing: without it the twin walks off the end of the row
    for an over-long count while the kernel stops, so the two disagree on the
    one input where disagreement is a memory-safety bug rather than a rounding
    difference. The parity spec pins that case.
    """
    var out = fb
    if count <= 0 or offset < 0 or offset >= out.len():
        return out
    var remaining = out.len() - offset
    var n = count
    if n > remaining:
        n = remaining
    var i = 0
    while i < n:
        val idx = offset + i
        out[idx] = blend_opacity(color, out[idx], opacity_pct)
        i = i + 1
    out

fn fb_rounded_rect_opacity_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32, opacity_pct: i32, clip: ClipRect) -> [u32]:
    if radius <= 0:
        return fb_rect_opacity_clip(fb, fbw, fbh, x, y, w, h, color, opacity_pct, clip)
    var out = fb
    var r = radius
    val max_r = if w < h: w / 2 else: h / 2
    if r > max_r:
        r = max_r
    if r <= 0:
        return fb_rect_opacity_clip(fb, fbw, fbh, x, y, w, h, color, opacity_pct, clip)
    var x0 = x
    var y0 = y
    var x1 = x + w
    var y1 = y + h
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    val rr = r * r
    var py = y0
    while py < y1:
        val row = py * fbw
        var px = x0
        while px < x1:
            var inside = true
            if px < x + r and py < y + r:
                val dx = (x + r - 1) - px
                val dy = (y + r - 1) - py
                inside = dx * dx + dy * dy <= rr
            elif px >= x + w - r and py < y + r:
                val dx = px - (x + w - r)
                val dy = (y + r - 1) - py
                inside = dx * dx + dy * dy <= rr
            elif px < x + r and py >= y + h - r:
                val dx = (x + r - 1) - px
                val dy = py - (y + h - r)
                inside = dx * dx + dy * dy <= rr
            elif px >= x + w - r and py >= y + h - r:
                val dx = px - (x + w - r)
                val dy = py - (y + h - r)
                inside = dx * dx + dy * dy <= rr
            if inside:
                if opacity_pct >= 100:
                    out[row + px] = color
                else:
                    out[row + px] = blend_opacity(color, out[row + px], opacity_pct)
            px = px + 1
        py = py + 1
    out

fn clamp_corner_radius(radius: i32, w: i32, h: i32) -> i32:
    if radius <= 0:
        return 0
    val max_r = if w < h: w / 2 else: h / 2
    if radius > max_r:
        return max_r
    radius

# Paint ONE row (py) of the rounded rect (x,y,w,h), span sx..sx+sw, honoring
# the per-corner radii of the FULL rect. The per-row gradient painter used to
# pass 1px-tall strips to the corners helper, which degenerated the corner
# tests and painted gradient backgrounds square (radius-16 buttons filled
# their corners with accent where Chromium shows the page beneath).
fn fb_rounded_rect_row_span_opacity_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, rtl: i32, rtr: i32, rbr: i32, rbl: i32, py: i32, sx: i32, sw: i32, color: u32, opacity_pct: i32, clip: ClipRect, image_alpha255: i32 = -1) -> [u32]:
    # image_alpha255 >= 0 marks a gradient (image-layer) row: Chrome composites
    # it with the image rule at the 8-bit stop alpha. A percent loses that
    # alpha (16 -> 6% -> 15), so opacity_pct is ignored then.
    val image = image_alpha255 >= 0
    val src = (color & 0x00FFFFFFu32) | ((image_alpha255 as u32) << 24)
    val tl = clamp_corner_radius(rtl, w, h)
    val tr = clamp_corner_radius(rtr, w, h)
    val br = clamp_corner_radius(rbr, w, h)
    val bl = clamp_corner_radius(rbl, w, h)
    val square = tl <= 0 and tr <= 0 and br <= 0 and bl <= 0
    if square and not image:
        return fb_rect_opacity_clip(fb, fbw, fbh, sx, py, sw, 1, color, opacity_pct, clip)
    if py < 0 or py >= fbh or py < clip.y0 or py >= clip.y1:
        return fb
    var out = fb
    var x0 = sx
    var x1 = sx + sw
    if x0 < 0:
        x0 = 0
    if x1 > fbw:
        x1 = fbw
    if x0 < clip.x0:
        x0 = clip.x0
    if x1 > clip.x1:
        x1 = clip.x1
    val row = py * fbw
    if square:
        return fb_blend_image_row(out, row + x0, x1 - x0, src)
    var px = x0
    while px < x1:
        var inside = true
        if tl > 0 and px < x + tl and py < y + tl:
            val dx = (x + tl - 1) - px
            val dy = (y + tl - 1) - py
            inside = dx * dx + dy * dy <= tl * tl
        elif tr > 0 and px >= x + w - tr and py < y + tr:
            val dx = px - (x + w - tr)
            val dy = (y + tr - 1) - py
            inside = dx * dx + dy * dy <= tr * tr
        elif bl > 0 and px < x + bl and py >= y + h - bl:
            val dx = (x + bl - 1) - px
            val dy = py - (y + h - bl)
            inside = dx * dx + dy * dy <= bl * bl
        elif br > 0 and px >= x + w - br and py >= y + h - br:
            val dx = px - (x + w - br)
            val dy = py - (y + h - br)
            inside = dx * dx + dy * dy <= br * br
        if inside:
            val idx = row + px
            if image:
                out[idx] = engine2d_color_blend(src, out[idx])
            else:
                out[idx] = blend_opacity(color, out[idx], opacity_pct)
        px = px + 1
    out

fn fb_blend_image_row(fb: [u32], offset: i32, count: i32, src: u32) -> [u32]:
    """Composite one constant translucent colour over a row span with the
    image rule (native blend_span on a row copy, bulk write-back)."""
    if count <= 0:
        return fb
    var out = fb
    var dst_row: [u32] = [0; count]
    dst_row.write_span(out, 0, offset.to_i64(), count.to_i64())
    val src_row: [u32] = [src; count]
    val blended = engine2d_simd_blend_span_u32(dst_row, 0, src_row, 0, count.to_i64())
    if blended.len() == count:
        out.write_span(blended, offset.to_i64(), 0, count.to_i64())
        return out
    var i = 0
    while i < count:
        out[offset + i] = engine2d_color_blend(src, out[offset + i])
        i = i + 1
    out

fn _isqrt_i64(v: i64) -> i64:
    if v <= 0:
        return 0
    var guess = v
    var next = (guess + 1) / 2
    while next < guess:  # cpu-lane-loop-ok: Newton iteration, converges in O(log v) steps
        guess = next
        next = (guess + v / guess) / 2
    guess

# Pixel coverage (0..256) of a rounded corner whose arc has radius `r`, for a
# pixel whose centre is (dx, dy) away from the arc centre. The ramp is one pixel
# wide and crosses 1/2 exactly on the arc; the previous hard `dx*dx+dy*dy<=r*r`
# test produced a stair-stepped corner with no intermediate value anywhere.
#
# This is the SHARED ROUNDED-RECT CORNER COVERAGE FORMULA v1, whose single
# definition is the comment block above `emu_draw_rounded_rect` in
# src/lib/gc_async_mut/gpu/engine2d/backend_emu.spl. Keep the two in step:
# this repo has two rounded-rect rasterizers (this framebuffer painter and the
# Engine2D one) and they are meant to agree.
#
# The `2*d + 1` terms are load-bearing. The arc centre is the continuous point
# (x+r, y+r) and a pixel centre is (px+0.5, py+0.5), so the true offset is
# `dx + 0.5`; doubling clears the halves, which makes the sum FOUR TIMES the
# squared distance and is why the scale is `* 16384`, not `<< 16`. The original
# 2026-09-12 version of this function used `sq * 65536`, i.e. it measured from
# the arc-centre PIXEL — that pushes the whole arc outward by half a pixel.
# It looks fine in isolation (this file's own spec only asserts "some pixels
# are intermediate") but puts the ramp in the wrong place, which
# test/01_unit/browser_engine/border_radius_antialias_engine2d_spec.spl's AC-1
# coordinates detect on the Engine2D side.
fn _corner_coverage256(dx: i32, dy: i32, r: i32) -> i32:
    val ex = (2 * dx + 1) as i64
    val ey = (2 * dy + 1) as i64
    val dist256 = _isqrt_i64((ex * ex + ey * ey) * 16384)
    val cov = ((r as i64) * 256 + 128 - dist256) as i32
    if cov < 0:
        return 0
    if cov > 256:
        return 256
    cov

fn _blend_alpha256(src: u32, dst: u32, a: i32) -> u32:
    val ia = 256 - a
    val r = ((((src >> 16) & 0xFFu32) as i32) * a + (((dst >> 16) & 0xFFu32) as i32) * ia) / 256
    val g = ((((src >> 8) & 0xFFu32) as i32) * a + (((dst >> 8) & 0xFFu32) as i32) * ia) / 256
    val b = (((src & 0xFFu32) as i32) * a + ((dst & 0xFFu32) as i32) * ia) / 256
    (src & 0xFF000000u32) | ((r as u32) << 16) | ((g as u32) << 8) | (b as u32)

fn fb_rounded_rect_corners_opacity_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, rtl: i32, rtr: i32, rbr: i32, rbl: i32, color: u32, opacity_pct: i32, clip: ClipRect) -> [u32]:
    val tl = clamp_corner_radius(rtl, w, h)
    val tr = clamp_corner_radius(rtr, w, h)
    val br = clamp_corner_radius(rbr, w, h)
    val bl = clamp_corner_radius(rbl, w, h)
    if tl <= 0 and tr <= 0 and br <= 0 and bl <= 0:
        return fb_rect_opacity_clip(fb, fbw, fbh, x, y, w, h, color, opacity_pct, clip)
    var out = fb
    var x0 = x
    var y0 = y
    var x1 = x + w
    var y1 = y + h
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    var py = y0
    while py < y1:
        val row = py * fbw
        # Split the row into [left corner cells][FLAT interior][right corner
        # cells]. Only the corner cells need the per-pixel arc test; the
        # interior is fully covered by definition, so it is one row-kernel
        # call instead of a branchy per-pixel loop over most of the box.
        #
        # This is only sound because the interior now blends with
        # `blend_opacity`, the same arithmetic the kernel uses. It previously
        # used a /256 floor, and routing it here while the corner cells kept
        # the other rounding would have made them disagree at the seam.
        val l_rad = if tl > 0 and py < y + tl: tl
                    elif bl > 0 and py >= y + h - bl: bl
                    else: 0
        val r_rad = if tr > 0 and py < y + tr: tr
                    elif br > 0 and py >= y + h - br: br
                    else: 0
        var flat_lo = x + l_rad
        var flat_hi = x + w - r_rad
        if flat_lo < x0:
            flat_lo = x0
        if flat_hi > x1:
            flat_hi = x1
        if flat_hi > flat_lo and opacity_pct > 0:
            out = fb_blend_const_row_opacity(out, row + flat_lo, flat_hi - flat_lo, color, opacity_pct)
        var px = x0
        while px < x1:
            # Skip the span the row kernel just painted.
            if flat_hi > flat_lo and px >= flat_lo and px < flat_hi:
                px = flat_hi
                if px >= x1:
                    break
            # Analytic coverage (0..256) instead of a hard in/out test, so the
            # corner arc is anti-aliased: a pixel centred exactly on the arc
            # gets 1/2 coverage and the ramp is one pixel wide.
            var cov = 256
            if tl > 0 and px < x + tl and py < y + tl:
                cov = _corner_coverage256((x + tl - 1) - px, (y + tl - 1) - py, tl)
            elif tr > 0 and px >= x + w - tr and py < y + tr:
                cov = _corner_coverage256(px - (x + w - tr), (y + tr - 1) - py, tr)
            elif bl > 0 and px < x + bl and py >= y + h - bl:
                cov = _corner_coverage256((x + bl - 1) - px, py - (y + h - bl), bl)
            elif br > 0 and px >= x + w - br and py >= y + h - br:
                cov = _corner_coverage256(px - (x + w - br), py - (y + h - br), br)
            if cov > 0:
                if cov >= 256:
                    # FULLY covered interior: blend exactly as the square-rect
                    # path does. It used to go through the /256 route below,
                    # which floors, while fb_rect_opacity_clip rounds (/100,
                    # +50) — so the same colour at the same opacity painted
                    # DIFFERENTLY depending on whether the box had rounded
                    # corners, and differed from its own corner ramp at the
                    # seam. The /256 route stays for partial coverage, where
                    # the anti-aliased corner genuinely needs sub-pixel alpha.
                    out[row + px] = blend_opacity(color, out[row + px], opacity_pct)
                else:
                    var alpha256 = cov
                    if opacity_pct < 100:
                        alpha256 = (alpha256 * opacity_pct) / 100
                    if alpha256 >= 256:
                        out[row + px] = color
                    elif alpha256 > 0:
                        out[row + px] = _blend_alpha256(color, out[row + px], alpha256)
            px = px + 1
        py = py + 1
    out

fn fb_style_rounded_rect_opacity_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, st: Style, color: u32, opacity_pct: i32, clip: ClipRect) -> [u32]:
    fb_rounded_rect_corners_opacity_clip(fb, fbw, fbh, x, y, w, h, st.border_radius_tl_px, st.border_radius_tr_px, st.border_radius_br_px, st.border_radius_bl_px, color, opacity_pct, clip)

# Soft (blurred) drop shadow. The blurred rounded-rect silhouette is
# approximated by a separable edge ramp (a fast, buffer-free stand-in for a
# 3-pass box blur of the silhouette): coverage falls linearly across a band of
# +/- `blur` px centered on each edge (=> ~0.5 at the edge, matching a gaussian
# with sigma ~ blur). `alpha` (0..255) scales the peak opacity; the shadow color
# is composited src-over onto the existing framebuffer (integer math).
# Piecewise-linear standard-normal CDF scaled to 0..256; z is in 1/256 units.
# Knots every z=0.5 from -3 to +3 (max interp error ~2/256, inside tol).
fn _phi256(z256: i32) -> i32:
    if z256 <= -768:
        return 0
    if z256 >= 768:
        return 256
    val t = z256 + 768
    val seg = t / 128
    val frac = t - seg * 128
    var a = 0
    var b = 0
    if seg == 0:
        a = 0
        b = 2
    elif seg == 1:
        a = 2
        b = 6
    elif seg == 2:
        a = 6
        b = 17
    elif seg == 3:
        a = 17
        b = 41
    elif seg == 4:
        a = 41
        b = 79
    elif seg == 5:
        a = 79
        b = 128
    elif seg == 6:
        a = 128
        b = 177
    elif seg == 7:
        a = 177
        b = 215
    elif seg == 8:
        a = 215
        b = 239
    elif seg == 9:
        a = 239
        b = 250
    elif seg == 10:
        a = 250
        b = 254
    else:
        a = 254
        b = 256
    a + ((b - a) * frac) / 128

# One soft-shadow row through the native coverage-span kernel.
#
# The shadow's coverage is SEPARABLE — colcov[x] * cov_y / 256 — so a whole row
# is one precomputed column table scaled by a per-row constant. That is exactly
# the shape a span kernel wants, and it is why this primitive gets a kernel of
# its own rather than reusing one: its blend is `/256` FLOOR with alpha in
# 0..=256, while the percent kernel rounds via `/100 + 50` and the mask kernel
# uses `/255` with `inv = 255 - a`. At a = 128 this computes
# `(s*128 + d*128)/256` where the mask kernel computes `(s*128 + d*127)/255`.
# Substituting either shifts every shadow pixel.
fn fb_blend_cov_row(fb: [u32], offset: i32, colcov: [i32], count: i32, cov_y: i32, alpha: i32, color: u32) -> [u32]:
    """Blend one coverage row span; falls back to the scalar twin if unbacked."""
    if count <= 0:
        return fb
    var out = fb
    if offset < 0 or offset >= out.len():
        return out
    var n = count
    if offset + n > out.len():
        n = out.len() - offset
    if n <= 0 or colcov.len() < n:
        return _scalar_blend_cov_row(fb, offset, colcov, count, cov_y, alpha, color)
    # cov_y and alpha are packed to keep the extern at six arguments; both are
    # bounded well below 1024 by construction (cov_y <= 256 from _phi256,
    # alpha <= 255).
    val packed = (cov_y.to_i64() * 1024) + alpha.to_i64()
    val kernel = rt_engine2d_blend_cov_span_u32(
        out, offset.to_i64(), colcov, n.to_i64(), packed, color)
    if val span = kernel:
        if span.len() != n:
            return _scalar_blend_cov_row(fb, offset, colcov, count, cov_y, alpha, color)
        out.write_span(span, offset.to_i64(), 0, n.to_i64())
        return out
    # Kernel nil: the native span was refused (allocation or invalid input). This
    # is the explicit scalar-twin path, not a silent default: the scalar blend
    # computes the same pixels, and the nil is visible in this branch.
    _scalar_blend_cov_row(fb, offset, colcov, count, cov_y, alpha, color)

fn _scalar_blend_cov_row(fb: [u32], offset: i32, colcov: [i32], count: i32, cov_y: i32, alpha: i32, color: u32) -> [u32]:
    """Scalar reference — the exact arithmetic fb_soft_box_shadow used inline.

    Clamped to the buffer exactly as the kernel clamps it, so the two agree on
    an over-long count instead of one walking off the end of the row.
    """
    var out = fb
    if count <= 0 or offset < 0 or offset >= out.len():
        return out
    var n = count
    if offset + n > out.len():
        n = out.len() - offset
    if n > colcov.len():
        n = colcov.len()
    val sr = (((color >> 16) & 255u32) as i32)
    val sg = (((color >> 8) & 255u32) as i32)
    val sb = ((color & 255u32) as i32)
    var i = 0
    while i < n:
        val cov = (colcov[i] * cov_y) / 256
        if cov > 0:
            var a = (cov * alpha) / 255
            if a > 256:
                a = 256
            val idx = offset + i
            val d = out[idx]
            val dr = (((d >> 16) & 255u32) as i32)
            val dg = (((d >> 8) & 255u32) as i32)
            val db = ((d & 255u32) as i32)
            val nr = (sr * a + dr * (256 - a)) / 256
            val ng = (sg * a + dg * (256 - a)) / 256
            val nb = (sb * a + db * (256 - a)) / 256
            out[idx] = web_argb(nr, ng, nb)
        i = i + 1
    out

fn fb_soft_box_shadow(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, color: u32, blur: i32, alpha: i32, clip: ClipRect) -> [u32]:
    if blur <= 0 or alpha <= 0 or w <= 0 or h <= 0:
        return fb
    var out = fb
    val x0 = x
    val y0 = y
    val x1 = x + w
    val y1 = y + h
    var rx0 = x0 - blur
    var ry0 = y0 - blur
    var rx1 = x1 + blur
    var ry1 = y1 + blur
    if rx0 < 0:
        rx0 = 0
    if ry0 < 0:
        ry0 = 0
    if rx1 > fbw:
        rx1 = fbw
    if ry1 > fbh:
        ry1 = fbh
    if rx0 < clip.x0:
        rx0 = clip.x0
    if ry0 < clip.y0:
        ry0 = clip.y0
    if rx1 > clip.x1:
        rx1 = clip.x1
    if ry1 > clip.y1:
        ry1 = clip.y1
    if rx1 <= rx0 or ry1 <= ry0:
        return out
    val sr = (((color >> 16) & 255u32) as i32)
    val sg = (((color >> 8) & 255u32) as i32)
    val sb = ((color & 255u32) as i32)
    # A CSS blur radius r means a Gaussian with sigma = r/2, and the blurred
    # silhouette of an axis-aligned rect separates exactly into the product of
    # two 1D blurred-edge profiles: cov(x,y) = covx(x) * covy(y) with each
    # covA = Phi(dist_to_near_edge/sigma) * Phi(dist_to_far_edge/sigma).
    # (The old linear edge ramp over-darkened the whole halo and made drop
    # shadows read as broad gray bands.) z*256 = dist*256/sigma = dist*512/blur.
    val span = rx1 - rx0
    var colcov: [i32] = [0; span]
    var k = 0
    while k < span:
        # distinct name from the row-loop `var px`: a `val` here would
        # const-poison the later `var` on interpreters without the
        # CONST_NAMES scoping fix (the deployed self-hosted binary).
        val col_px = rx0 + k
        val cxl = _phi256(((col_px - x0) * 512) / blur)
        val cxr = _phi256(((x1 - col_px) * 512) / blur)
        colcov[k] = (cxl * cxr) / 256
        k = k + 1
    var py = ry0
    while py < ry1:
        val cyl = _phi256(((py - y0) * 512) / blur)
        val cyr = _phi256(((y1 - py) * 512) / blur)
        val cov_y = (cyl * cyr) / 256
        if cov_y > 0:
            # One native call per row, replacing ~15 interpreted integer ops
            # per pixel. `colcov` is already built once per shadow above.
            out = fb_blend_cov_row(out, py * fbw + rx0, colcov, rx1 - rx0,
                cov_y, alpha, color)
        py = py + 1
    out

# Dispatch a node's box-shadow: soft blurred halo when a blur radius was parsed,
# otherwise the exact legacy hard-offset rounded-rect (byte-identical).
# When the raw multi-layer declaration is available, each dark layer is painted
# separately back-to-front (Chromium-style stacking): the tight small-blur
# layers hug the box while the wide soft layer spreads, so spill above the box
# stays light while the drop below is deep.
fn paint_box_shadow(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, st: Style, clip: ClipRect) -> [u32]:
    if st.box_shadow_raw != "":
        var out = fb
        val layers = split_top_level_commas(st.box_shadow_raw)
        var li = layers.len() - 1
        while li >= 0:
            val layer = layers[li]
            li = li - 1
            if layer.contains("inset"):
                continue
            val layer_lower = layer.trim().lower()
            if layer_lower == "none" or layer_lower.contains("transparent"):
                continue
            val col_raw = parse_color_any(layer)
            val col = if col_raw != 0u32: col_raw elif st.box_shadow_color != 0u32: st.box_shadow_color elif st.fg != 0u32: st.fg else: web_argb(0, 0, 0)
            val alpha = shadow_layer_alpha(layer)
            if alpha <= 0:
                continue
            val prefix = shadow_length_prefix(layer)
            val ox = parse_signed_nth_int(prefix, 0)
            val oy = parse_signed_nth_int(prefix, 1)
            if ox == -1000000 or oy == -1000000:
                continue
            var blur = parse_signed_nth_int(prefix, 2)
            if blur == -1000000 or blur < 0:
                blur = 0
            var spread = parse_signed_nth_int(prefix, 3)
            if spread == -1000000:
                spread = 0
            val sx = x + ox - spread
            val sy = y + oy - spread
            val sw = w + 2 * spread
            val sh = h + 2 * spread
            if sw <= 0 or sh <= 0:
                continue
            if blur > 0:
                out = fb_soft_box_shadow(out, fbw, fbh, sx, sy, sw, sh, col, blur, alpha, clip)
            else:
                val op_pct = if alpha >= 255: 100 else: (alpha * 100 + 127) / 255
                if op_pct > 0:
                    val rtl = if st.border_radius_tl_px > 0: (if st.border_radius_tl_px + spread > 0: st.border_radius_tl_px + spread else: 0) else: 0
                    val rtr = if st.border_radius_tr_px > 0: (if st.border_radius_tr_px + spread > 0: st.border_radius_tr_px + spread else: 0) else: 0
                    val rbr = if st.border_radius_br_px > 0: (if st.border_radius_br_px + spread > 0: st.border_radius_br_px + spread else: 0) else: 0
                    val rbl = if st.border_radius_bl_px > 0: (if st.border_radius_bl_px + spread > 0: st.border_radius_bl_px + spread else: 0) else: 0
                    out = fb_rounded_rect_corners_opacity_clip(out, fbw, fbh, sx, sy, sw, sh, rtl, rtr, rbr, rbl, col, op_pct, clip)
        return out
    if st.box_shadow_blur_px > 0:
        return fb_soft_box_shadow(fb, fbw, fbh, x + st.box_shadow_x_px, y + st.box_shadow_y_px, w, h, st.box_shadow_color, st.box_shadow_blur_px, st.box_shadow_alpha, clip)
    fb_style_rounded_rect_opacity_clip(fb, fbw, fbh, x + st.box_shadow_x_px, y + st.box_shadow_y_px, w, h, st, st.box_shadow_color, 100, clip)

# Skia's 8x8 ordered-dither level M (0..63) at DEVICE pixel (px, py), as
# Chrome's raster pipeline computes it: X = px, Y = py ^ px, and M interleaves
# the low 3 bits of each. The stored channel is floor(v + (2M+1)/128) for an
# exact value v in 0..255 (dither in (-63/128, 63/128), then round-to-nearest).
# Replayed against 42 Chrome 159 gradient pixels, 42/42 exact.
fn gradient_dither_threshold(px: i32, py: i32) -> i32:
    val x = px & 7
    val y = (py ^ px) & 7
    ((y & 1) << 5) | ((x & 1) << 4) | ((y & 2) << 2) | ((x & 2) << 1) | ((y & 4) >> 1) | ((x & 4) >> 2)

# Pixel-centre vertical gradient ramp with Chrome's ordered dither.
# Chrome 159 samples each row at its centre, t = (2*pos + 1) / (2*span), so
# no row is an exact stop: a 4px #000 -> #fff ramp paints 1F/60/9F/DF and a
# 2px one 3F/BF. 92b33870986 had switched this to endpoint-exact
# t = pos / (span - 1) to satisfy spec pins that Chrome never painted.
# (px, py) are device pixel coordinates; see gradient_dither_threshold.
fn mix_channel_gradient_centered(a: i32, b: i32, pos: i32, span: i32, px: i32, py: i32) -> i32:
    if span <= 0:
        return a
    val denom = span * 2
    val b_weight = pos * 2 + 1
    val weighted = a * (denom - b_weight) + b * b_weight
    val out = (weighted * 128 + (gradient_dither_threshold(px, py) * 2 + 1) * denom) / (denom * 128)
    if out > 255:
        return 255
    out

fn mix_color_vertical_centered(a: u32, b: u32, pos: i32, span: i32, px: i32, py: i32) -> u32:
    if span <= 0:
        return a
    val aa = (((a >> 24) & 255u32) as i32)
    val ar = (((a >> 16) & 255u32) as i32)
    val ag = (((a >> 8) & 255u32) as i32)
    val ab = ((a & 255u32) as i32)
    val ba = (((b >> 24) & 255u32) as i32)
    val br = (((b >> 16) & 255u32) as i32)
    val bg = (((b >> 8) & 255u32) as i32)
    val bb = ((b & 255u32) as i32)
    val alpha = mix_channel_gradient_centered(aa, ba, pos, span, px, py)
    val red = mix_channel_gradient_centered(ar, br, pos, span, px, py)
    val green = mix_channel_gradient_centered(ag, bg, pos, span, px, py)
    val blue = mix_channel_gradient_centered(ab, bb, pos, span, px, py)
    (alpha.to_u32() << 24) | (red.to_u32() << 16) | (green.to_u32() << 8) | blue.to_u32()

fn gradient_pixel_alpha255(color: u32, element_opacity_pct: i32) -> i32:
    val alpha = (((color >> 24) & 255u32) as i32)
    (alpha * element_opacity_pct + 50) / 100

fn background_gradient_pixel_opacity(color: u32, element_opacity_pct: i32) -> i32:
    val alpha = (((color >> 24) & 255u32) as i32)
    (element_opacity_pct * alpha + 127) / 255

fn fb_style_background_opacity_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, st: Style, clip: ClipRect) -> [u32]:
    var bg_x = x
    var bg_y = y
    var bg_w = w
    var bg_h = h
    var image_origin_x = x + st.border_l
    var image_origin_y = y + st.border_t
    var image_origin_w = w - st.border_l - st.border_r
    var image_origin_h = h - st.border_t - st.border_b
    if st.background_origin == "border-box":
        image_origin_x = x
        image_origin_y = y
        image_origin_w = w
        image_origin_h = h
    elif st.background_origin == "content-box":
        image_origin_x = x + st.border_l + st.pad_l
        image_origin_y = y + st.border_t + st.pad_t
        image_origin_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
        image_origin_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    if st.background_clip == "padding-box" or st.background_clip == "content-box":
        bg_x = bg_x + st.border_l
        bg_y = bg_y + st.border_t
        bg_w = bg_w - st.border_l - st.border_r
        bg_h = bg_h - st.border_t - st.border_b
    if st.background_clip == "content-box":
        bg_x = bg_x + st.pad_l
        bg_y = bg_y + st.pad_t
        bg_w = bg_w - st.pad_l - st.pad_r
        bg_h = bg_h - st.pad_t - st.pad_b
    if bg_w <= 0 or bg_h <= 0:
        return fb
    if image_origin_w <= 0 or image_origin_h <= 0:
        image_origin_x = bg_x
        image_origin_y = bg_y
        image_origin_w = bg_w
        image_origin_h = bg_h
    # Fold the solid background color's own alpha (rgba) into the paint
    # opacity: translucent panels must composite over what's beneath, not
    # paint as opaque slabs. For alpha=255 colors this is bit-identical to
    # the old path ((pct*255+127)/255 == pct).
    val solid_bg_alpha = (((st.bg >> 24) & 255u32) as i32)
    val solid_bg_opacity = (st.opacity_pct * solid_bg_alpha + 127) / 255
    if radial_gradient_box_paintable(st):
        # CSS radial gradient over the box colour (Draw IR twin:
        # `background-gradient-radial-geometry`, the same geometry function).
        var radial_out = fb
        if st.bg != 0u32 and solid_bg_opacity > 0:
            radial_out = fb_style_rounded_rect_opacity_clip(radial_out, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st, st.bg | 0xFF000000u32, solid_bg_opacity, clip)
        val rg = radial_gradient_box_geometry(st, x, y, w, h)
        if rg.len() < 8:
            return radial_out
        return fb_radial_gradient_clip(radial_out, fbw, fbh, rg[4] as i32, rg[5] as i32, rg[6] as i32, rg[7] as i32, rg, st.background_gradient_stop_colors, st.background_gradient_stop_positions, st.opacity_pct, clip)
    if background_gradient_layers_paintable(st):
        # Gradient layer list over the box colour (Draw IR twin:
        # `background-gradient-layer-geometry`, the same resolver).
        var layers_out = fb
        if st.bg != 0u32 and solid_bg_opacity > 0:
            layers_out = fb_style_rounded_rect_opacity_clip(layers_out, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st, st.bg | 0xFF000000u32, solid_bg_opacity, clip)
        val r = background_gradient_box_rects(st, x, y, w, h)
        if r.len() < 8:
            return layers_out
        val layers = background_gradient_layers(st.bg_layers_raw, r[0], r[1], r[2], r[3], st.font_size)
        val shape = background_gradient_clip_shape(st, r[4], r[5], r[6], r[7])
        if shape.len() == 8:
            # Rounded: the colour joins the one clipped background image.
            val base = if st.bg != 0u32 and solid_bg_alpha > 0: st.bg else: 0u32
            return fb_gradient_layers_round_clip(fb, fbw, fbh, layers, base, st.opacity_pct, clip, shape)
        return fb_gradient_layers_clip(layers_out, fbw, fbh, r[4], r[5], r[6], r[7], layers, st.opacity_pct, clip)
    if st.background_gradient_from == 0u32 or st.background_gradient_to == 0u32:
        if solid_bg_opacity <= 0:
            return fb
        return fb_style_rounded_rect_opacity_clip(fb, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st, st.bg | 0xFF000000u32, solid_bg_opacity, clip)
    var out = fb
    if st.bg != 0u32 and solid_bg_opacity > 0:
        out = fb_style_rounded_rect_opacity_clip(out, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st, st.bg | 0xFF000000u32, solid_bg_opacity, clip)
    val tile_w = if st.background_size_w_px > 0: st.background_size_w_px else: image_origin_w
    val tile_h = if st.background_size_h_px > 0: st.background_size_h_px else: image_origin_h
    val fixed_no_repeat = st.background_attachment == "fixed" and st.background_repeat == "no-repeat"
    val image_x = if st.background_repeat == "no-repeat": st.background_position_x_px else: 0
    val image_y = if st.background_repeat == "no-repeat": st.background_position_y_px else: 0
    val remaining_w = image_origin_w - image_x
    val remaining_h = image_origin_h - image_y
    val max_x = if fixed_no_repeat: tile_w else: (if st.background_repeat == "no-repeat": (if tile_w < remaining_w: tile_w else: remaining_w) else: image_origin_w)
    val max_y = if fixed_no_repeat: tile_h else: (if st.background_repeat == "no-repeat": (if tile_h < remaining_h: tile_h else: remaining_h) else: image_origin_h)
    val image_base_x = if fixed_no_repeat: image_x else: image_origin_x + image_x
    val image_base_y = if fixed_no_repeat: image_y else: image_origin_y + image_y
    val image_clip = if fixed_no_repeat: clip_intersect(clip, bg_x, bg_y, bg_x + bg_w, bg_y + bg_h) else: clip
    if linear_gradient_needs_general_raster(st):
        return fb_linear_gradient_general_clip(out, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st, tile_w, tile_h, max_x, max_y, image_base_x, image_base_y, image_clip)
    var py = 0
    while py < max_y:
        val tile_py = py % tile_h
        val dev_y = image_base_y + py
        # Chrome dithers every device pixel. Within one row the dither level
        # depends only on x & 7, so the row has at most 8 colours; equal
        # neighbours are merged into one span.
        var phase: [u32] = []
        var k = 0
        while k < 8:
            phase.push(mix_color_vertical_centered(st.background_gradient_from, st.background_gradient_to, tile_py, tile_h, image_base_x + k, dev_y))
            k = k + 1
        var run_x = 0
        var px = 1
        while px <= max_x:
            if px == max_x or phase[px & 7] != phase[run_x & 7]:
                val color = phase[run_x & 7]
                val alpha255 = gradient_pixel_alpha255(color, st.opacity_pct)
                if alpha255 > 0:
                    out = fb_rounded_rect_row_span_opacity_clip(out, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st.border_radius_tl_px, st.border_radius_tr_px, st.border_radius_br_px, st.border_radius_bl_px, dev_y, image_base_x + run_x, px - run_x, color, 100, image_clip, alpha255)
                run_x = px
            px = px + 1
        py = py + 1
    out

# True when a typed linear gradient is more than the two-stop top-to-bottom
# ramp the row painter above handles: an angle other than 180deg, a third
# stop, or a stop position other than 0% / 100%.
fn linear_gradient_needs_general_raster(st: Style) -> bool:
    if st.background_gradient_is_radial:
        return false
    val n = st.background_gradient_stop_colors.len()
    if n < 2 or st.background_gradient_stop_positions.len() != n:
        return false
    if n > 2 or st.background_gradient_angle_deg % 360 != 180:
        return true
    st.background_gradient_stop_positions[0] != 0 or st.background_gradient_stop_positions[1] != 1000

# One colour channel mixed in PREMULTIPLIED space (CSS Images 4 §3.4.1):
# weights are each stop's alpha times its share, so a transparent stop
# contributes no colour (blue -> transparent stays blue while it fades).
# With equal alphas this is the plain straight-alpha mix, bit for bit.
fn _gradient_mix_channel(a: u32, b: u32, shift: u32, wa: i64, wb: i64) -> u32:
    val ca = ((a >> shift) & 255u32) as i64
    val cb = ((b >> shift) & 255u32) as i64
    val ws = wa + wb
    if ws <= 0:
        return 0u32
    val v = (ca * wa + cb * wb + ws / 2) / ws
    (v as u32) << shift

# Color of the gradient line at `t16` (0..65536 from start to end) through
# the stop list (positions in permille; `parse_gradient_stops` clamps each
# one up to the largest before it, so they never decrease).
fn linear_gradient_color_at(colors: [u32], positions: [i32], t16: i64) -> u32:
    val n = colors.len()
    val first = (positions[0] as i64) * 65536 / 1000
    if t16 <= first:
        return colors[0]
    var i = 0
    while i + 1 < n:
        val p0 = (positions[i] as i64) * 65536 / 1000
        val p1 = (positions[i + 1] as i64) * 65536 / 1000
        if t16 <= p1:
            if p1 <= p0:
                return colors[i + 1]
            val f16 = (t16 - p0) * 65536 / (p1 - p0)
            val a = colors[i]
            val b = colors[i + 1]
            val wa = ((a >> 24) & 255u32) as i64 * (65536 - f16)
            val wb = ((b >> 24) & 255u32) as i64 * f16
            val alpha = ((wa + wb + 32768) / 65536) as u32
            return (alpha << 24) | _gradient_mix_channel(a, b, 16u32, wa, wb) | _gradient_mix_channel(a, b, 8u32, wa, wb) | _gradient_mix_channel(a, b, 0u32, wa, wb)
        i = i + 1
    colors[n - 1]

# CSS Images 3 §3.1 linear gradient over each `tile_w` x `tile_h` tile: the
# gradient line passes through the tile centre at `angle` (0deg = to top,
# clockwise) and is |w sin| + |h cos| long, so the corners hit the end
# stops. Each row is painted as spans of equal color.
fn fb_linear_gradient_general_clip(fb: [u32], fbw: i32, fbh: i32, bg_x: i32, bg_y: i32, bg_w: i32, bg_h: i32, st: Style, tile_w: i32, tile_h: i32, max_x: i32, max_y: i32, image_base_x: i32, image_base_y: i32, image_clip: ClipRect) -> [u32]:
    var out = fb
    if tile_w <= 0 or tile_h <= 0:
        return out
    val sc = if st.background_gradient_angle_deg >= 1000:
        gradient_corner_dir_q16(st.background_gradient_angle_deg, tile_w, tile_h)
    else:
        gradient_angle_sin_cos_q16(st.background_gradient_angle_deg)
    val s = sc[0]
    val c = sc[1]
    val sw = if s < 0: 0 - s else: s
    val cw = if c < 0: 0 - c else: c
    var len_q16 = (tile_w as i64) * sw + (tile_h as i64) * cw
    if len_q16 < 1:
        len_q16 = 1
    # The ramp is sampled once per box into 1025 entries (t16 >> 6): the
    # per-pixel work is then one multiply-add and a lookup. A per-pixel stop
    # walk made the catalog `html` page render 55% slower.
    val colors = st.background_gradient_stop_colors
    val positions = st.background_gradient_stop_positions
    var lut: [u32] = []
    var li = 0
    while li <= 1024:
        lut.push(linear_gradient_color_at(colors, positions, (li as i64) * 64))
        li = li + 1
    var py = 0
    val square = st.border_radius_tl_px <= 0 and st.border_radius_tr_px <= 0 and st.border_radius_br_px <= 0 and st.border_radius_bl_px <= 0
    while py < max_y:
        val dy2 = (2 * (py % tile_h) + 1 - tile_h) as i64
        if square:
            # Square corners: write the clipped row pixel by pixel. A span
            # call per color change (every few pixels on a diagonal ramp)
            # made the catalog `html` page render 55% slower.
            val fy = image_base_y + py
            if fy >= 0 and fy < fbh and fy >= image_clip.y0 and fy < image_clip.y1:
                var x0 = image_base_x
                var x1 = image_base_x + max_x
                if x0 < 0:
                    x0 = 0
                if x1 > fbw:
                    x1 = fbw
                if x0 < image_clip.x0:
                    x0 = image_clip.x0
                if x1 > image_clip.x1:
                    x1 = image_clip.x1
                val row = fy * fbw
                var fx = x0
                while fx < x1:
                    val gx = fx - image_base_x
                    val dx2 = (2 * (gx % tile_w) + 1 - tile_w) as i64
                    var t16 = 32768 + (dx2 * s - dy2 * c) * 32768 / len_q16
                    if t16 < 0:
                        t16 = 0
                    if t16 > 65536:
                        t16 = 65536
                    val color = lut[(t16 / 64) as i32]
                    # A gradient is an image layer: Chrome composites it with
                    # its 8-bit stop alpha and the image rule. Quantizing that
                    # alpha to a percent first loses it (0.066*255 = 16 -> 6%
                    # -> 15) and moves the Aetheric pin off Chrome's #575758.
                    val alpha255 = gradient_pixel_alpha255(color, st.opacity_pct)
                    if alpha255 >= 255:
                        out[row + fx] = color | 0xFF000000u32
                    elif alpha255 > 0:
                        out[row + fx] = engine2d_color_blend((color & 0x00FFFFFFu32) | ((alpha255 as u32) << 24), out[row + fx])
                    fx = fx + 1
            py = py + 1
            continue
        var span_start = 0
        var span_color = 0u32
        var px = 0
        while px <= max_x:
            var color = 0u32
            if px < max_x:
                val dx2 = (2 * (px % tile_w) + 1 - tile_w) as i64
                var t16 = 32768 + (dx2 * s - dy2 * c) * 32768 / len_q16
                if t16 < 0:
                    t16 = 0
                if t16 > 65536:
                    t16 = 65536
                color = lut[(t16 / 64) as i32]
            if px == max_x or (px > span_start and color != span_color):
                val alpha255 = gradient_pixel_alpha255(span_color, st.opacity_pct)
                if alpha255 > 0 and px > span_start:
                    out = fb_rounded_rect_row_span_opacity_clip(out, fbw, fbh, bg_x, bg_y, bg_w, bg_h, st.border_radius_tl_px, st.border_radius_tr_px, st.border_radius_br_px, st.border_radius_bl_px, image_base_y + py, image_base_x + span_start, px - span_start, span_color, 100, image_clip, alpha255)
                span_start = px
            span_color = color
            px = px + 1
        py = py + 1
    out

# integer sqrt (Newton, monotone-decreasing loop) for radial falloff distances
fn _isqrt_i64(v: i64) -> i64:
    if v <= 0:
        return 0
    var g: i64 = v
    var nx: i64 = (g + 1) / 2
    while nx < g:
        g = nx
        nx = (g + v / g) / 2
    g

# Parse the center of a radial-gradient position spec ("circle at top left",
# "at 78% 10%", "circle at bottom center") into [x_pct, y_pct] of the box.
# Keywords bind to their own axis; "center"/percentages consume x then y.
fn _radial_center_pct(spec: text) -> [i32]:
    var xp = 50
    var yp = 50
    val low = spec.lower()
    val at = text_index_of(low, "at ")
    if at < 0:
        return [xp, yp]
    val pos = low.substring(at + 3, low.byte_len()).trim()
    val toks = pos.split(" ")
    var x_set = false
    var y_set = false
    var ti = 0
    val tc = toks.len()
    while ti < tc:
        val tok = toks[ti].trim()
        ti = ti + 1
        if tok == "":
            continue
        if tok == "left":
            xp = 0
            x_set = true
        elif tok == "right":
            xp = 100
            x_set = true
        elif tok == "top":
            yp = 0
            y_set = true
        elif tok == "bottom":
            yp = 100
            y_set = true
        elif tok == "center":
            if not x_set:
                x_set = true
            else:
                y_set = true
        elif tok.ends_with("%"):
            val v = parse_int(tok.substring(0, tok.byte_len() - 1))
            if not x_set:
                xp = v
                x_set = true
            elif not y_set:
                yp = v
                y_set = true
    [xp, yp]

# A CSS length token as Q10 px (1/1024 px): "[-]12" / "[-]12.5" plus a
# "px" unit (stripped by the caller). Fractions keep 4 digits.
fn _radial_number_q10(tok: text) -> i64:
    var i = 0
    val n = tok.byte_len()
    var neg = false
    if n > 0 and tok.substring(0, 1) == "-":
        neg = true
        i = 1
    var whole: i64 = 0
    while i < n and dec_val(tok.substring(i, i + 1)) < 10:
        whole = whole * 10 + (dec_val(tok.substring(i, i + 1)) as i64)
        i = i + 1
    var frac: i64 = 0
    var scale: i64 = 1
    if i < n and tok.substring(i, i + 1) == ".":
        i = i + 1
        while i < n and dec_val(tok.substring(i, i + 1)) < 10 and scale < 10000:
            frac = frac * 10 + (dec_val(tok.substring(i, i + 1)) as i64)
            scale = scale * 10
            i = i + 1
    val q = whole * 1024 + (frac * 1024 + scale / 2) / scale
    if neg: 0 - q else: q

# One position/size component against an axis of `extent` px: "N%" of the
# extent or "Npx". -1 marks a token that is neither.
fn _radial_component_q10(tok: text, extent: i32) -> i64:
    if tok.ends_with("%"):
        return (extent as i64) * _radial_number_q10(tok.substring(0, tok.byte_len() - 1)) / 100
    if tok.ends_with("px"):
        return _radial_number_q10(tok.substring(0, tok.byte_len() - 2))
    -1

# Centre of `[at <position>]` (1 or 2 values: left/center/right/top/bottom,
# percentages, px) in Q10 px. A vertical keyword first, or a horizontal one
# second, swaps the pair. Without px this is `_radial_center_pct`.
fn _radial_center_q10(spec: text, ax: i32, ay: i32, aw: i32, ah: i32) -> [i64]:
    val low = spec.lower()
    val at = text_index_of(low, "at ")
    var toks: [text] = []
    if at >= 0:
        for raw in low.substring(at + 3, low.byte_len()).trim().split(" "):
            val t = raw.trim()
            if t != "":
                toks.push(t)
    var has_px = false
    for t in toks:
        if t.ends_with("px"):
            has_px = true
    if not has_px:
        val pct = _radial_center_pct(spec)
        return [(ax as i64) * 1024 + (aw as i64) * 1024 * (pct[0] as i64) / 100, (ay as i64) * 1024 + (ah as i64) * 1024 * (pct[1] as i64) / 100]
    var first = if toks.len() > 0: toks[0] else: "center"
    var second = if toks.len() > 1: toks[1] else: "center"
    if first == "top" or first == "bottom" or second == "left" or second == "right":
        val tmp = first
        first = second
        second = tmp
    var cx: i64 = (aw as i64) * 512
    if first == "left":
        cx = 0
    elif first == "right":
        cx = (aw as i64) * 1024
    elif first != "center":
        val v = _radial_component_q10(first, aw)
        if v != -1:
            cx = v
    var cy: i64 = (ah as i64) * 512
    if second == "top":
        cy = 0
    elif second == "bottom":
        cy = (ah as i64) * 1024
    elif second != "center":
        val v = _radial_component_q10(second, ah)
        if v != -1:
            cy = v
    [(ax as i64) * 1024 + cx, (ay as i64) * 1024 + cy]

fn _radial_abs_q10(v: i64) -> i64:
    if v < 0: 0 - v else: v

# CSS Images 3 §3.2 ending shape of one `radial-gradient(...)` layer against
# its gradient box (ax, ay, aw, ah; CSS px): [cx, cy, rx, ry] in Q10 px.
# Shape `circle` / `ellipse` (default ellipse; one length alone means a
# circle), size keywords closest-side / closest-corner / farthest-side /
# farthest-corner (the default) or explicit lengths (px; ellipse also %),
# and the `at <position>` centre (default center). The corner keywords
# keep the side keyword's aspect ratio for an ellipse (sqrt(2) x the sides).
fn radial_gradient_geometry_q10(layer: text, ax: i32, ay: i32, aw: i32, ah: i32) -> [i64]:
    val parts = split_top_level_commas_paren_aware(gradient_inner(layer))
    var head = ""
    if parts.len() > 0 and is_gradient_shape_or_position_token(parts[0]):
        head = parts[0].trim().lower()
    val center = _radial_center_q10(head, ax, ay, aw, ah)
    val cx = center[0]
    val cy = center[1]
    val at = text_index_of(head, "at ")
    val shape_part = if at >= 0: head.substring(0, at) else: head
    var circle = false
    var ellipse = false
    var size_kw = "farthest-corner"
    var lens: [i64] = []
    for raw in shape_part.trim().split(" "):
        val t = raw.trim()
        if t == "circle":
            circle = true
        elif t == "ellipse":
            ellipse = true
        elif t == "closest-side" or t == "closest-corner" or t == "farthest-side" or t == "farthest-corner":
            size_kw = t
        elif t != "":
            val axis_extent = if lens.len() == 0: aw else: ah
            val v = _radial_component_q10(t, axis_extent)
            if v >= 0:
                lens.push(v)
    if not circle and not ellipse and lens.len() == 1:
        circle = true
    if lens.len() == 1 and circle:
        return [cx, cy, lens[0], lens[0]]
    if lens.len() == 2 and not circle:
        return [cx, cy, lens[0], lens[1]]
    val dl = _radial_abs_q10(cx - (ax as i64) * 1024)
    val dr = _radial_abs_q10((ax as i64 + aw as i64) * 1024 - cx)
    val dt = _radial_abs_q10(cy - (ay as i64) * 1024)
    val db = _radial_abs_q10((ay as i64 + ah as i64) * 1024 - cy)
    val near_x = if dl < dr: dl else: dr
    val far_x = if dl > dr: dl else: dr
    val near_y = if dt < db: dt else: db
    val far_y = if dt > db: dt else: db
    if circle:
        if size_kw == "closest-side":
            val r = if near_x < near_y: near_x else: near_y
            return [cx, cy, r, r]
        if size_kw == "farthest-side":
            val r = if far_x > far_y: far_x else: far_y
            return [cx, cy, r, r]
        if size_kw == "closest-corner":
            val r = _isqrt_i64(near_x * near_x + near_y * near_y)
            return [cx, cy, r, r]
        val r = _isqrt_i64(far_x * far_x + far_y * far_y)
        return [cx, cy, r, r]
    if size_kw == "closest-side":
        return [cx, cy, near_x, near_y]
    if size_kw == "farthest-side":
        return [cx, cy, far_x, far_y]
    if size_kw == "closest-corner":
        return [cx, cy, _isqrt_i64(2 * near_x * near_x), _isqrt_i64(2 * near_y * near_y)]
    [cx, cy, _isqrt_i64(2 * far_x * far_x), _isqrt_i64(2 * far_y * far_y)]

# The typed radial background of a box: the gradient box is the background
# positioning area (background-origin, padding-box by default) and the paint
# rect the background painting area (background-clip, border-box by
# default). Returns [cx, cy, rx, ry] (Q10 px) then the paint rect
# [px0, py0, pw, ph] (px); empty when the box has no area.
fn radial_gradient_box_geometry(st: Style, x: i32, y: i32, w: i32, h: i32) -> [i64]:
    val r = background_gradient_box_rects(st, x, y, w, h)
    if r.len() < 8:
        return []
    val g = radial_gradient_geometry_q10(st.bg_layers_raw, r[0], r[1], r[2], r[3])
    [g[0], g[1], g[2], g[3], r[4] as i64, r[5] as i64, r[6] as i64, r[7] as i64]

# The image layers of a gradient-only background list (`gradient_layer_list`)
# resolved against the gradient box (ax, ay, aw, ah; CSS px), in CSS order:
# the first paints on top. Empty when the list is not gradient-only.
#
# Each layer's tile (CSS Backgrounds 3 §3.8-3.9) comes from its
# `<position> / <size> <repeat>` tail: a gradient has no intrinsic size, so
# `auto`, `cover` and `contain` are the positioning area; percentages of the
# size resolve against the area, of the position against (area - tile). A
# zero-sized layer is not painted. Empty when any tail is unsupported.
#
# Stop positions given as lengths (`px`, `em` of `em_px`) resolve per layer
# against that layer's gradient line on its tile: a linear line's length, a
# radial's gradient ray (its horizontal radius).
fn background_gradient_layers(raw: text, ax: i32, ay: i32, aw: i32, ah: i32, em_px: i32 = 16) -> [BackgroundGradientLayer]:
    var out: [BackgroundGradientLayer] = []
    for entry in gradient_layer_entries(raw):
        val split = gradient_layer_split(entry)
        val tail = gradient_layer_tail_parts(split[1])
        if tail.len() != 3:
            return []
        val pos = background_position_spec(tail[0])
        val size = background_size_spec(tail[1])
        val rep = background_repeat_spec(tail[2])
        if pos.len() != 4 or size.len() != 5 or rep.len() != 2:
            return []
        val lay = split[0]
        val radial = text_index_of(lay.lower(), "radial-gradient(") == 0
        val aw_q = (aw as i64) * 1024
        val ah_q = (ah as i64) * 1024
        var tw = aw_q
        var th = ah_q
        if size[0] == 0:
            if size[1] == 1:
                tw = size[2]
            elif size[1] == 2:
                tw = aw_q * size[2] / 102400
            if size[3] == 1:
                th = size[4]
            elif size[3] == 2:
                th = ah_q * size[4] / 102400
        if tw <= 0 or th <= 0:
            continue
        # Each tile is one gradient evaluation (one Vulkan dispatch on the
        # device): a tile grid past BACKGROUND_GRADIENT_TILE_CAP over the
        # positioning area fails the whole list closed (box colour only).
        val nx = if rep[0] == 1: aw_q / tw + 2 else: 1
        val ny = if rep[1] == 1: ah_q / th + 2 else: 1
        if nx * ny > BACKGROUND_GRADIENT_TILE_CAP:
            return []
        val tx = (ax as i64) * 1024 + (aw_q - tw) * pos[0] / 102400 + pos[1]
        val ty = (ay as i64) * 1024 + (ah_q - th) * pos[2] / 102400 + pos[3]
        val geom = _gradient_layer_tile_geometry(lay, radial, tx, ty, tw, th)
        if geom.len() < 4:
            return []
        val line_q10 = if radial: geom[2] else: _isqrt_i64((geom[2] - geom[0]) * (geom[2] - geom[0]) + (geom[3] - geom[1]) * (geom[3] - geom[1]))
        val stops: [GradientStopSpec] = parse_gradient_stops_on_line(lay, line_q10, em_px)
        var colors: [u32] = []
        var positions: [i32] = []
        for stop in stops:
            colors.push(stop.color)
            positions.push(stop.pos_permille)
        out.push(BackgroundGradientLayer(radial: radial, geom: geom, colors: colors, positions: positions, tile: [tx, ty, tw, th], repeat_x: rep[0] == 1, repeat_y: rep[1] == 1))
    out

# A layer's geometry resolved against its tile (Q10 px rect). A whole-pixel
# tile resolves directly; a fractional size resolves at 64x and scales back,
# which needs the geometry to scale with the box, so a radial layer with an
# explicit length fails closed (empty) there.
fn _gradient_layer_tile_geometry(lay: text, radial: bool, tx: i64, ty: i64, tw: i64, th: i64) -> [i64]:
    if tw % 1024 == 0 and th % 1024 == 0:
        val w = (tw / 1024) as i32
        val h = (th / 1024) as i32
        if tx % 1024 == 0 and ty % 1024 == 0:
            val ix = (tx / 1024) as i32
            val iy = (ty / 1024) as i32
            return if radial: radial_gradient_geometry_q10(lay, ix, iy, w, h) else: linear_gradient_line_q10(lay, ix, iy, w, h)
        val g = if radial: radial_gradient_geometry_q10(lay, 0, 0, w, h) else: linear_gradient_line_q10(lay, 0, 0, w, h)
        if radial:
            return [g[0] + tx, g[1] + ty, g[2], g[3]]
        return [g[0] + tx, g[1] + ty, g[2] + tx, g[3] + ty]
    val inner = gradient_inner(lay).lower()
    if radial and (text_index_of(inner, "px") >= 0 or text_index_of(inner, "em") >= 0):
        return []
    val w64 = (tw / 16) as i32
    val h64 = (th / 16) as i32
    val g = if radial: radial_gradient_geometry_q10(lay, 0, 0, w64, h64) else: linear_gradient_line_q10(lay, 0, 0, w64, h64)
    if radial:
        return [g[0] / 64 + tx, g[1] / 64 + ty, g[2] / 64, g[3] / 64]
    [g[0] / 64 + tx, g[1] / 64 + ty, g[2] / 64 + tx, g[3] / 64 + ty]

# The canvas gradient layers of `src` (see canvas_gradient_source): Chrome
# positions the propagated root background on the root (`<html>`) box, so a
# default `repeat` tiles it past that box over the whole canvas.
fn canvas_gradient_layers(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], src: i32) -> [BackgroundGradientLayer]:
    var i = 0
    while i < nodes.len() and i < bx.len():
        if nodes[i].tag == "html":
            val st = styles[src]
            if st.bg_layers_raw != "":
                return background_gradient_layers(st.bg_layers_raw, bx[i], by[i], bw[i], bh[i], st.font_size)
            # A typed linear layer: its parsed stops on the html box, repeating.
            val tile: [i64] = [(bx[i] as i64) * 1024, (by[i] as i64) * 1024, (bw[i] as i64) * 1024, (bh[i] as i64) * 1024]
            if bw[i] <= 0 or bh[i] <= 0:
                return []
            val geom = linear_gradient_line_q10_at_angle(st.background_gradient_angle_deg, bx[i], by[i], bw[i], bh[i])
            return [BackgroundGradientLayer(radial: false, geom: geom, colors: st.background_gradient_stop_colors, positions: st.background_gradient_stop_positions, tile: tile, repeat_x: true, repeat_y: true)]
        i = i + 1
    []

# Paint the radial-gradient layers of a multi-layer `background` stack over
# the rect (x, y, w, h), which is both the gradient box and the painting
# area (the propagated canvas background passes the viewport). CSS paints
# the FIRST layer topmost, so layers composite back-to-front. Non-radial
# layers are ignored (the scalar Style fields paint them).
fn fb_background_radial_stack_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, raw: text, opacity_pct: i32, clip: ClipRect) -> [u32]:
    var out = fb
    if w <= 0 or h <= 0 or opacity_pct <= 0:
        return out
    val layers = split_top_level_commas(raw)
    var li = layers.len() - 1
    while li >= 0:
        val lay = layers[li]
        li = li - 1
        if text_index_of(lay.lower(), "radial-gradient(") < 0:
            continue
        val stops: [GradientStopSpec] = parse_gradient_stops(lay)
        var colors: [u32] = []
        var positions: [i32] = []
        for stop in stops:
            colors.push(stop.color)
            positions.push(stop.pos_permille)
        if colors.len() < 2:
            continue
        val geom = radial_gradient_geometry_q10(lay, x, y, w, h)
        out = fb_radial_gradient_clip(out, fbw, fbh, x, y, w, h, geom, colors, positions, opacity_pct, clip)
    out

fn fb_border_sides_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, bl: i32, bt: i32, br: i32, bb: i32, cl: u32, ct: u32, cr: u32, cb: u32, clip: ClipRect) -> [u32]:
    var out = fb
    if _fb_border_mitred(bl, bt, br, bb, cl, ct, cr, cb):
        return _fb_border_sides_mitred(fb, fbw, fbh, x, y, w, h, bl, bt, br, bb, cl, ct, cr, cb, clip)
    if bt > 0 and ct != 0u32:
        out = _fb_border_side_clip(out, fbw, fbh, x, y, w, bt, ct, clip)
    if bb > 0 and cb != 0u32:
        out = _fb_border_side_clip(out, fbw, fbh, x, y + h - bb, w, bb, cb, clip)
    # A translucent left/right side skips the rows a painted top/bottom side
    # already covered, so a corner is blended once, not twice -- and keeps
    # the rows of an unpainted side, so the corner is not left empty.
    val top_rows = if ct != 0u32: bt else: 0
    val bottom_rows = if cb != 0u32: bb else: 0
    if bl > 0 and cl != 0u32:
        if _fb_border_translucent(cl):
            out = _fb_border_side_clip(out, fbw, fbh, x, y + top_rows, bl, h - top_rows - bottom_rows, cl, clip)
        else:
            out = _fb_border_side_clip(out, fbw, fbh, x, y, bl, h, cl, clip)
    if br > 0 and cr != 0u32:
        if _fb_border_translucent(cr):
            out = _fb_border_side_clip(out, fbw, fbh, x + w - br, y + top_rows, br, h - top_rows - bottom_rows, cr, clip)
        else:
            out = _fb_border_side_clip(out, fbw, fbh, x + w - br, y, br, h, cr, clip)
    out

# A translucent border colour (`hsl(0 100% 50% / .5)`) blends over what is
# under it, as Chrome does; it used to be stored raw, alpha byte and all. An
# alpha byte of 0 is a colour packed without one and stays opaque.
fn _fb_border_side_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, color: u32, clip: ClipRect) -> [u32]:
    if not _fb_border_translucent(color):
        return fb_rect_clip(fb, fbw, fbh, x, y, w, h, color, clip)
    val alpha = ((color >> 24) & 255u32) as i32
    fb_rect_opacity_clip(fb, fbw, fbh, x, y, w, h, color | 0xFF000000u32, (alpha * 100 + 127) / 255, clip)

# Dash runs [start, len, start, len, ...] along one straight border side of
# `length` px and `thickness` px, as Chrome 159 lays them out
# (StrokeData::SelectBestDashGap, open path): a dash of 2t (dotted: t) at both
# ends, the gap stretched or shrunk from t to the count that fits best, starts
# rounded to whole px. A side no longer than two dashes is solid; one shorter
# than two dashes and a gap keeps two dashes and scales dash and gap together
# (measured: t=5, L=22 gives 8.75 / 4.5 / 8.75).
# reason: geometry helper shared by the raster and Draw IR border lanes
# @allow(primitive_api)
pub fn border_dash_runs(length: i32, thickness: i32, dotted: bool) -> [i32]:
    if length <= 0:
        return []
    val t = if thickness > 0: thickness else: 1
    # Blink: device thickness < 3 uses dash 3t / gap 2t, otherwise 2t / t.
    val thin = (not dotted) and t < 3
    val dash = if dotted: t else: (if thin: t * 3 else: t * 2)
    val gap = if thin: t * 2 else: t
    if length <= 2 * dash:
        return [0, length]
    if length < 2 * dash + gap:
        val short_dash = (length * dash * 2 + (2 * dash + gap)) / ((2 * dash + gap) * 2)
        return [0, short_dash, length - short_dash, short_dash]
    val min_n = (length + gap) / (dash + gap)
    val max_n = min_n + 1
    val min_gap_milli = ((length - min_n * dash) * 1000) / (min_n - 1)
    val max_gap_milli = ((length - max_n * dash) * 1000) / (max_n - 1)
    var n = min_n
    var gap_milli = min_gap_milli
    val d_min = if min_gap_milli > gap * 1000: min_gap_milli - gap * 1000 else: gap * 1000 - min_gap_milli
    val d_max = if max_gap_milli > gap * 1000: max_gap_milli - gap * 1000 else: gap * 1000 - max_gap_milli
    if max_gap_milli > 0 and d_max <= d_min:
        n = max_n
        gap_milli = max_gap_milli
    var runs: [i32] = []
    var i = 0
    # cpu-lane-loop-ok: one run per dash of one side; bound is n <= length / dash + 1
    while i < n:
        val start = (i * (dash * 1000 + gap_milli) + 500) / 1000
        runs.push(start)
        runs.push(if start + dash > length: length - start else: dash)
        i = i + 1
    runs

# Row spans [start, len] (one per row, len may be 0) of a round dot of
# diameter `d`: the pixels whose centre lies in the circle inscribed in the
# d x d cell. Chrome 159 draws `dotted` borders as round dots.
# ponytail: pixel-centre coverage, no AA on the dot edge; upgrade with a
# coverage ramp if the partial edge pixels get pinned.
# reason: geometry helper shared by the raster and Draw IR border lanes
# @allow(primitive_api)
pub fn border_dot_row_spans(d: i32) -> [i32]:
    var spans: [i32] = []
    var row = 0
    # cpu-lane-loop-ok: one span per dot row; bound is the border width
    while row < d:
        val dy = 2 * row + 1 - d
        var c0 = -1
        var c1 = -1
        var c = 0
        # cpu-lane-loop-ok: scans one dot row; bound is the border width
        while c < d:
            val dx = 2 * c + 1 - d
            if dx * dx + dy * dy <= d * d:
                if c0 < 0:
                    c0 = c
                c1 = c
            c = c + 1
        if c0 < 0:
            spans.push(0)
            spans.push(0)
        else:
            spans.push(c0)
            spans.push(c1 - c0 + 1)
        row = row + 1
    spans

# Chrome 159 strokes a uniform dashed / dotted border on a rounded box as ONE
# closed path: the border's centre line (inset t/2, radius r - t/2), started
# where the top-left arc ends and run clockwise. SelectBestDashGap (closed
# path: as many gaps as dashes) fits the gap so whole dashes close the loop:
# dash 2t, nominal gap t; dotted: round dots of diameter t, one per pitch,
# the first centred on the start. Sides may differ in colour, and some may be
# solid: Chrome keeps the one pattern and paints each pixel with its nearest
# side (the diagonal from the outer to the inner corner splits a corner, ties
# to the vertical side); a side set in `solid_sides` (bit 1 top, 2 right,
# 4 bottom, 8 left) fills its part of the ring. Returns [row, x0, len, side]
# spans (box-relative; side 0 top, 1 right, 2 bottom, 3 left) of the pixels
# whose centre is covered; empty when the shape does not apply (r <= t/2, a
# side shorter than its arcs, or a loop too short to dash), so the caller
# keeps its per-side path.
# ponytail: uniform width and circular radius only, pixel-centre coverage (no
# AA); upgrade with per-side widths (Chrome insets the centre line per side).
# reason: geometry helper shared by the raster and Draw IR border lanes; box size, width and radius in px, side bit mask
# @allow(primitive_api)
pub fn border_rounded_dash_spans(w: i32, h: i32, t: i32, r: i32, dotted: bool, solid_sides: i32) -> [i32]:
    var out: [i32] = []
    if t <= 0 or 2 * r <= t or 2 * r > w or 2 * r > h:
        return out
    val tf = t as f64
    val rf = r as f64
    val wf = w as f64
    val hf = h as f64
    val c = tf / 2.0
    val rc = rf - c
    val a = wf - 2.0 * rf
    val b = hf - 2.0 * rf
    val q = 3.141592653589793 * rc / 2.0
    val total = 2.0 * a + 2.0 * b + 4.0 * q
    val dash = if dotted: tf else: 2.0 * tf
    val nominal = tf
    if total <= 2.0 * dash:
        return out
    val min_n = ((total / (dash + nominal)) as i64) as f64
    if min_n < 1.0:
        return out
    val min_gap = (total - min_n * dash) / min_n
    val max_gap = (total - (min_n + 1.0) * dash) / (min_n + 1.0)
    val d_min = if min_gap > nominal: min_gap - nominal else: nominal - min_gap
    val d_max = if max_gap > nominal: max_gap - nominal else: nominal - max_gap
    val gap = if max_gap <= 0.0 or d_min < d_max: min_gap else: max_gap
    val pitch = dash + gap
    val seg = [a, a + q, a + q + b, a + 2.0 * q + b, 2.0 * a + 2.0 * q + b, 2.0 * a + 3.0 * q + b, 2.0 * a + 3.0 * q + 2.0 * b]
    var py = 0
    # cpu-lane-loop-ok: rows of one rounded border box; bound is the box height
    while py < h:
        val y = (py as f64) + 0.5
        var run0 = -1
        var run_side = -1
        var px = 0
        # cpu-lane-loop-ok: pixels of one row of the border box; interior rows jump the padding span
        while px <= w:
            var side = -1
            if px < w:
                val x = (px as f64) + 0.5
                val sd = _rounded_dash_param(x, y, wf, hf, rf, rc, c, seg)
                val near = _rounded_nearest_side(x, y, wf, hf)
                var hit = false
                if (solid_sides >> near) & 1 == 1:
                    hit = sd[1] <= c
                elif dotted:
                    hit = _rounded_dot_hit(x, y, sd[0], pitch, total, wf, hf, rf, rc, c, seg)
                else:
                    val k = ((sd[0] / pitch) as i64) as f64
                    hit = sd[1] <= c and sd[0] - k * pitch < dash
                if hit:
                    side = near
            if run0 >= 0 and side != run_side:
                out.push(py)
                out.push(run0)
                out.push(px - run0)
                out.push(run_side)
                run0 = -1
            if side >= 0 and run0 < 0:
                run0 = px
                run_side = side
            if px == t and py >= r and py < h - r and w - t > px:
                px = w - t
            else:
                px = px + 1
        py = py + 1
    out

# [s, d] for a point: its arc-length parameter on the closed centre line
# (see `border_rounded_dash_spans`) and its distance from that line.
fn _rounded_dash_param(x: f64, y: f64, w: f64, h: f64, r: f64, rc: f64, c: f64, seg: [f64]) -> [f64]:
    if x < r and y < r:
        return [seg[6] + rc * (atan2_f64(y - r, x - r) + 3.141592653589793), _abs_f64(sqrt_f64((x - r) * (x - r) + (y - r) * (y - r)) - rc)]
    if x > w - r and y < r:
        return [rc * (atan2_f64(y - r, x - (w - r)) + 1.5707963267948966) + seg[0], _abs_f64(sqrt_f64((x - (w - r)) * (x - (w - r)) + (y - r) * (y - r)) - rc)]
    if x > w - r and y > h - r:
        return [seg[2] + rc * atan2_f64(y - (h - r), x - (w - r)), _abs_f64(sqrt_f64((x - (w - r)) * (x - (w - r)) + (y - (h - r)) * (y - (h - r))) - rc)]
    if x < r and y > h - r:
        return [seg[4] + rc * (atan2_f64(y - (h - r), x - r) - 1.5707963267948966), _abs_f64(sqrt_f64((x - r) * (x - r) + (y - (h - r)) * (y - (h - r))) - rc)]
    # Nearest straight side; ties go bottom, left, right, top.
    var dm = h - y
    var s = seg[3] + (w - r - x)
    if x < dm:
        dm = x
        s = seg[5] + (h - r - y)
    if w - x < dm:
        dm = w - x
        s = seg[1] + (y - r)
    if y < dm:
        dm = y
        s = x - r
    [s, _abs_f64(dm - c)]

# The one dash style ("dashed" / "dotted") of a rounded border whose sides are
# each that style or solid, at least one not solid; "" otherwise.
# reason: border-style keyword helper shared by the raster and Draw IR border lanes
# @allow(primitive_api)
pub fn _rounded_dash_style(st: text, sr: text, sb: text, sl: text) -> text:
    var style = ""
    for s in [st, sr, sb, sl]:
        if s == "dashed" or s == "dotted":
            if style != "" and style != s:
                return ""
            style = s
        elif s != "solid":
            return ""
    style

# `solid_sides` bit mask for `border_rounded_dash_spans` (1 top, 2 right,
# 4 bottom, 8 left).
# reason: border-style keyword helper shared by the raster and Draw IR border lanes
# @allow(primitive_api)
pub fn _rounded_solid_sides(st: text, sr: text, sb: text, sl: text) -> i32:
    (if st == "solid": 1 else: 0) + (if sr == "solid": 2 else: 0) + (if sb == "solid": 4 else: 0) + (if sl == "solid": 8 else: 0)

# The side (0 top, 1 right, 2 bottom, 3 left) nearest a point; ties go to the
# vertical side, as Chrome's corner diagonals do for equal widths.
fn _rounded_nearest_side(x: f64, y: f64, w: f64, h: f64) -> i32:
    var side = 3
    var dm = x
    if w - x < dm:
        side = 1
        dm = w - x
    if y < dm:
        side = 0
        dm = y
    if h - y < dm:
        side = 2
    side

fn _abs_f64(v: f64) -> f64:
    if v < 0.0: 0.0 - v else: v

# Whether (x, y) lies in a dot of diameter 2c centred on the centre line at a
# multiple of `pitch` (the nearest dots by arc length, wrapping the loop).
fn _rounded_dot_hit(x: f64, y: f64, s: f64, pitch: f64, total: f64, w: f64, h: f64, r: f64, rc: f64, c: f64, seg: [f64]) -> bool:
    val k = (s / pitch) as i64
    var kk = k - 1
    # cpu-lane-loop-ok: tests the four dots nearest one pixel; fixed bound
    while kk <= k + 2:
        var sp = (kk as f64) * pitch
        if sp < 0.0:
            sp = sp + total
        if sp >= total:
            sp = sp - total
        val p = _rounded_dash_point(sp, w, h, r, rc, c, seg)
        if (x - p[0]) * (x - p[0]) + (y - p[1]) * (y - p[1]) <= c * c:
            return true
        kk = kk + 1
    false

# The centre-line point at arc length `s` (0 <= s < perimeter).
fn _rounded_dash_point(s: f64, w: f64, h: f64, r: f64, rc: f64, c: f64, seg: [f64]) -> [f64]:
    if s < seg[0]:
        return [r + s, c]
    if s < seg[1]:
        val f = (s - seg[0]) / rc - 1.5707963267948966
        return [w - r + rc * cos_f64(f), r + rc * sin_f64(f)]
    if s < seg[2]:
        return [w - c, r + (s - seg[1])]
    if s < seg[3]:
        val f = (s - seg[2]) / rc
        return [w - r + rc * cos_f64(f), h - r + rc * sin_f64(f)]
    if s < seg[4]:
        return [w - r - (s - seg[3]), h - c]
    if s < seg[5]:
        val f = (s - seg[4]) / rc + 1.5707963267948966
        return [r + rc * cos_f64(f), h - r + rc * sin_f64(f)]
    if s < seg[6]:
        return [c, h - r - (s - seg[5])]
    val f = (s - seg[6]) / rc + 3.141592653589793
    [r + rc * cos_f64(f), r + rc * sin_f64(f)]

fn _fb_border_span_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, is_horiz: bool, style: text, color: u32, clip: ClipRect) -> [u32]:
    if w <= 0 or h <= 0 or color == 0u32 or _border_style_disabled(style):
        return fb
    var out = fb
    val t = if is_horiz: h else: w
    if style == "double" and t >= 3:
        # Chrome 159: each stripe is round(t / 3) px, the gap takes the rest.
        val line_t = (t + 1) / 3
        if is_horiz:
            out = _fb_border_side_clip(out, fbw, fbh, x, y, w, line_t, color, clip)
            return _fb_border_side_clip(out, fbw, fbh, x, y + h - line_t, w, line_t, color, clip)
        out = _fb_border_side_clip(out, fbw, fbh, x, y, line_t, h, color, clip)
        return _fb_border_side_clip(out, fbw, fbh, x + w - line_t, y, line_t, h, color, clip)
    if style == "dashed" or style == "dotted":
        val runs = border_dash_runs(if is_horiz: w else: h, t, style == "dotted")
        var r = 0
        # cpu-lane-loop-ok: one rect per dash of one border side; bound is the run count
        val dot = if style == "dotted": border_dot_row_spans(t) else: []
        while r + 1 < runs.len():
            val cx = if is_horiz: x + runs[r] else: x
            val cy = if is_horiz: y else: y + runs[r]
            if dot.len() > 0 and runs[r + 1] == t:
                var k = 0
                # cpu-lane-loop-ok: paints one round dot row by row; bound is the border width
                while k < t:
                    if dot[2 * k + 1] > 0:
                        out = _fb_border_side_clip(out, fbw, fbh, cx + dot[2 * k], cy + k, dot[2 * k + 1], 1, color, clip)
                    k = k + 1
            elif is_horiz:
                out = _fb_border_side_clip(out, fbw, fbh, cx, cy, runs[r + 1], h, color, clip)
            else:
                out = _fb_border_side_clip(out, fbw, fbh, cx, cy, w, runs[r + 1], color, clip)
            r = r + 2
        return out
    _fb_border_side_clip(out, fbw, fbh, x, y, w, h, color, clip)

fn _fb_border_corner_arc_clip(fb: [u32], fbw: i32, fbh: i32, bx: i32, by: i32, bw: i32, bh: i32, corner_kind: i32, rad: i32, w_h: i32, w_v: i32, c_h: u32, c_v: u32, s_h: text, s_v: text, clip: ClipRect) -> [u32]:
    if rad <= 0:
        return fb
    val h_active = w_h > 0 and c_h != 0u32 and not _border_style_disabled(s_h)
    val v_active = w_v > 0 and c_v != 0u32 and not _border_style_disabled(s_v)
    if not h_active and not v_active:
        return fb
    var qx0 = bx
    var qy0 = by
    if corner_kind == 1 or corner_kind == 2:
        qx0 = bx + bw - rad
    if corner_kind == 2 or corner_kind == 3:
        qy0 = by + bh - rad
    var qx1 = qx0 + rad
    var qy1 = qy0 + rad
    if qx0 < 0: qx0 = 0
    if qy0 < 0: qy0 = 0
    if qx1 > fbw: qx1 = fbw
    if qy1 > fbh: qy1 = fbh
    if qx0 < clip.x0: qx0 = clip.x0
    if qy0 < clip.y0: qy0 = clip.y0
    if qx1 > clip.x1: qx1 = clip.x1
    if qy1 > clip.y1: qy1 = clip.y1
    if qx1 <= qx0 or qy1 <= qy0:
        return fb
    var out = fb
    var py = qy0
    while py < qy1:
        val row = py * fbw
        val dy = if corner_kind == 0 or corner_kind == 1: (by + rad - 1) - py else: py - (by + bh - rad)
        var px = qx0
        while px < qx1:
            val dx = if corner_kind == 0 or corner_kind == 3: (bx + rad - 1) - px else: px - (bx + bw - rad)
            val outer_cov = _corner_coverage256(dx, dy, rad)
            if outer_cov > 0:
                val use_h = if h_active and v_active: dy >= dx else: h_active
                val side_w = if use_h: w_h else: w_v
                val side_col = if use_h: c_h else: c_v
                val side_style = if use_h: s_h else: s_v
                var paint_px = true
                if not (h_active and v_active):
                    if use_h and dy < rad - side_w:
                        paint_px = false
                    elif not use_h and dx < rad - side_w:
                        paint_px = false
                if paint_px and (side_style == "dashed" or side_style == "dotted"):
                    val stroke_t = if side_w > 0: side_w else: 1
                    val dash_len = if side_style == "dotted": stroke_t else: stroke_t * 3
                    val gap_len = if side_style == "dotted": stroke_t else: stroke_t * 2
                    val arc_step = dx + (rad - dy)
                    if (arc_step % (dash_len + gap_len)) >= dash_len:
                        paint_px = false
                if paint_px:
                    var ring_cov = outer_cov
                    if h_active and v_active:
                        val r_in = if rad > side_w: rad - side_w else: 0
                        if side_style == "double" and side_w >= 3:
                            val line_w = (side_w + 2) / 3
                            val r_mid_out = if rad > line_w: rad - line_w else: 0
                            val r_mid_in = if r_in + line_w < r_mid_out: r_in + line_w else: r_mid_out
                            val outer_ring = if r_mid_out > 0: outer_cov - _corner_coverage256(dx, dy, r_mid_out) else: outer_cov
                            val inner_ring = if r_mid_in > r_in: _corner_coverage256(dx, dy, r_mid_in) - (if r_in > 0: _corner_coverage256(dx, dy, r_in) else: 0) else: 0
                            ring_cov = outer_ring + inner_ring
                        elif r_in > 0:
                            ring_cov = outer_cov - _corner_coverage256(dx, dy, r_in)
                    if ring_cov > 256:
                        ring_cov = 256
                    if ring_cov > 0:
                        val opaque_col = side_col | 0xFF000000u32
                        var cov = ring_cov
                        if _fb_border_translucent(side_col):
                            val col_a = ((side_col >> 24) & 255u32) as i32
                            cov = (cov * col_a) / 255
                        if cov >= 256:
                            out[row + px] = opaque_col
                        elif cov > 0:
                            out[row + px] = _blend_alpha256(opaque_col, out[row + px], cov)
            px = px + 1
        py = py + 1
    out

# Chrome 159 paints a border whose corner radii differ as the ring between the
# outer per-corner mask and the inner one, sampled at pixel centres: the same
# model as `engine2d_draw_ir_render_typed_border_ring` (cpu_simd / Vulkan).
# Pixels are whole-colour; the join between two sides runs from the outer box
# corner to the inner box corner, a tie going to the vertical side.
# ponytail: no sub-pixel AA on the arcs (Chrome's own edge pixels are partial);
# upgrade by sampling a coverage ramp in `_ring_corner_in`/`_ring_inner_ok`.
# Solid sides only; other styles keep the circular-arc painter.
fn _ring_corner_in(dx: i32, dy: i32, r: i32) -> bool:
    if r <= 0:
        return true
    val ex = (2 * dx + 1) as i64
    val ey = (2 * dy + 1) as i64
    ex * ex + ey * ey <= 4 * (r as i64) * (r as i64)

# (ux2, uy2): pixel centre from this corner of the border box, doubled. The
# inner ellipse is centred at (r, r) with radii (rx, ry).
fn _ring_inner_ok(ux2: i64, uy2: i64, r: i32, rx: i32, ry: i32) -> bool:
    val r2 = 2 * (r as i64)
    if rx <= 0 or ry <= 0 or ux2 >= r2 or uy2 >= r2:
        return true
    val a = r2 - ux2
    val b = r2 - uy2
    val rxl = rx as i64
    val ryl = ry as i64
    a * a * ryl * ryl + b * b * rxl * rxl <= 4 * rxl * rxl * ryl * ryl

fn _ring_inset_radius(r: i32, inset: i32) -> i32:
    if r > inset: r - inset else: 0

fn _ring_style_plain(style: text, width: i32) -> bool:
    style == "solid" or width <= 0

fn fb_border_ring_per_corner_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, bl: i32, bt: i32, br: i32, bb: i32, cl: u32, ct: u32, cr: u32, cb: u32, tl: i32, tr: i32, rbr: i32, rbl: i32, clip: ClipRect) -> [u32]:
    var out = fb
    var x0 = x
    var y0 = y
    var x1 = x + w
    var y1 = y + h
    if x0 < 0: x0 = 0
    if y0 < 0: y0 = 0
    if x1 > fbw: x1 = fbw
    if y1 > fbh: y1 = fbh
    if x0 < clip.x0: x0 = clip.x0
    if y0 < clip.y0: y0 = clip.y0
    if x1 > clip.x1: x1 = clip.x1
    if y1 > clip.y1: y1 = clip.y1
    var py = y0
    # cpu-lane-loop-ok: one ring test per pixel of the clipped border box; bound is that box's visible area
    while py < y1:
        val ry = py - y
        val top_half = ry * 2 < h
        val uy2 = if top_half: (2 * ry + 1) as i64 else: (2 * h - (2 * ry + 1)) as i64
        val hw = if top_half: bt else: bb
        val hc = if top_half: ct else: cb
        var px = x0
        while px < x1:  # cpu-lane-loop-ok: row of the same clipped border box
            val rx = px - x
            var inside = true
            if tl > 0 and rx < tl and ry < tl:
                inside = _ring_corner_in(tl - 1 - rx, tl - 1 - ry, tl)
            elif tr > 0 and rx >= w - tr and ry < tr:
                inside = _ring_corner_in(rx - (w - tr), tr - 1 - ry, tr)
            elif rbr > 0 and rx >= w - rbr and ry >= h - rbr:
                inside = _ring_corner_in(rx - (w - rbr), ry - (h - rbr), rbr)
            elif rbl > 0 and rx < rbl and ry >= h - rbl:
                inside = _ring_corner_in(rbl - 1 - rx, ry - (h - rbl), rbl)
            if inside:
                val cx2 = (2 * rx + 1) as i64
                val cy2 = (2 * ry + 1) as i64
                var in_pad = rx >= bl and ry >= bt and rx < w - br and ry < h - bb
                if in_pad:
                    in_pad = _ring_inner_ok(cx2, cy2, tl, tl - bl, tl - bt) and _ring_inner_ok((2 * w) as i64 - cx2, cy2, tr, tr - br, tr - bt) and _ring_inner_ok((2 * w) as i64 - cx2, (2 * h) as i64 - cy2, rbr, rbr - br, rbr - bb) and _ring_inner_ok(cx2, (2 * h) as i64 - cy2, rbl, rbl - bl, rbl - bb)
                if not in_pad:
                    val left_half = rx * 2 < w
                    val ux2 = if left_half: cx2 else: (2 * w) as i64 - cx2
                    val vw = if left_half: bl else: br
                    val vc = if left_half: cl else: cr
                    val horizontal = vw <= 0 or (hw > 0 and uy2 * (vw as i64) < ux2 * (hw as i64))
                    val col = if horizontal: hc else: vc
                    if col != 0u32:
                        if _fb_border_translucent(col):
                            val a256 = (((col >> 24) & 255u32) as i32 * 256) / 255
                            out[py * fbw + px] = _blend_alpha256(col | 0xFF000000u32, out[py * fbw + px], a256)
                        else:
                            out[py * fbw + px] = col
            px = px + 1
        py = py + 1
    out

fn fb_border_sides_styled_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, bl: i32, bt: i32, br: i32, bb: i32, cl: u32, ct: u32, cr: u32, cb: u32, sl: text, st_top: text, sr: text, sb: text, rtl: i32, rtr: i32, rbr: i32, rbl: i32, clip: ClipRect) -> [u32]:
    val tl = clamp_corner_radius(rtl, w, h)
    val tr = clamp_corner_radius(rtr, w, h)
    val br_rad = clamp_corner_radius(rbr, w, h)
    val bl_rad = clamp_corner_radius(rbl, w, h)
    # A uniform double border (any radii): two solid rings of
    # round(w / 3) px following the radii (the Draw IR producer's twin,
    # `_html_draw_ir_styled_border_commands`). ponytail: uniform width only.
    if sl == "double" and st_top == "double" and sr == "double" and sb == "double" and bl == bt and bt == br and br == bb and bt >= 3:
        val stripe = (bt + 1) / 3
        val ins = bt - stripe
        val outer = fb_border_ring_per_corner_clip(fb, fbw, fbh, x, y, w, h, stripe, stripe, stripe, stripe, cl, ct, cr, cb, tl, tr, br_rad, bl_rad, clip)
        return fb_border_ring_per_corner_clip(outer, fbw, fbh, x + ins, y + ins, w - 2 * ins, h - 2 * ins, stripe, stripe, stripe, stripe, cl, ct, cr, cb, _ring_inset_radius(tl, ins), _ring_inset_radius(tr, ins), _ring_inset_radius(br_rad, ins), _ring_inset_radius(bl_rad, ins), clip)
    val dash_style = _rounded_dash_style(st_top, sr, sb, sl)
    if dash_style != "" and bl == bt and bt == br and br == bb and tl > 0 and tl == tr and tr == br_rad and br_rad == bl_rad:
        val spans = border_rounded_dash_spans(w, h, bt, tl, dash_style == "dotted", _rounded_solid_sides(st_top, sr, sb, sl))
        if spans.len() > 0:
            val side_colors = [ct, cr, cb, cl]
            var dashed_out = fb
            var k = 0
            # cpu-lane-loop-ok: one row span per covered run of the rounded dash path; bound is the span count
            while k + 3 < spans.len():
                val sc = side_colors[spans[k + 3]]
                if sc != 0u32:
                    dashed_out = _fb_border_side_clip(dashed_out, fbw, fbh, x + spans[k + 1], y + spans[k], spans[k + 2], 1, sc, clip)
                k = k + 4
            return dashed_out
    if (tl != tr or tr != br_rad or br_rad != bl_rad) and _ring_style_plain(sl, bl) and _ring_style_plain(st_top, bt) and _ring_style_plain(sr, br) and _ring_style_plain(sb, bb):
        return fb_border_ring_per_corner_clip(fb, fbw, fbh, x, y, w, h, bl, bt, br, bb, cl, ct, cr, cb, tl, tr, br_rad, bl_rad, clip)
    var out = fb
    if bt > 0 and ct != 0u32 and not _border_style_disabled(st_top):
        out = _fb_border_span_clip(out, fbw, fbh, x + tl, y, w - tl - tr, bt, true, st_top, ct, clip)
    if bb > 0 and cb != 0u32 and not _border_style_disabled(sb):
        out = _fb_border_span_clip(out, fbw, fbh, x + bl_rad, y + h - bb, w - bl_rad - br_rad, bb, true, sb, cb, clip)
    val top_active = bt > 0 and ct != 0u32 and not _border_style_disabled(st_top)
    val bot_active = bb > 0 and cb != 0u32 and not _border_style_disabled(sb)
    val top_rows = if top_active: bt else: 0
    val bottom_rows = if bot_active: bb else: 0
    if bl > 0 and cl != 0u32 and not _border_style_disabled(sl):
        if tl == 0 and bl_rad == 0:
            if _fb_border_translucent(cl):
                out = _fb_border_span_clip(out, fbw, fbh, x, y + top_rows, bl, h - top_rows - bottom_rows, false, sl, cl, clip)
            else:
                out = _fb_border_span_clip(out, fbw, fbh, x, y, bl, h, false, sl, cl, clip)
        else:
            out = _fb_border_span_clip(out, fbw, fbh, x, y + tl, bl, h - tl - bl_rad, false, sl, cl, clip)
    if br > 0 and cr != 0u32 and not _border_style_disabled(sr):
        if tr == 0 and br_rad == 0:
            if _fb_border_translucent(cr):
                out = _fb_border_span_clip(out, fbw, fbh, x + w - br, y + top_rows, br, h - top_rows - bottom_rows, false, sr, cr, clip)
            else:
                out = _fb_border_span_clip(out, fbw, fbh, x + w - br, y, br, h, false, sr, cr, clip)
        else:
            out = _fb_border_span_clip(out, fbw, fbh, x + w - br, y + tr, br, h - tr - br_rad, false, sr, cr, clip)
    if tl > 0:
        out = _fb_border_corner_arc_clip(out, fbw, fbh, x, y, w, h, 0, tl, bt, bl, ct, cl, st_top, sl, clip)
    if tr > 0:
        out = _fb_border_corner_arc_clip(out, fbw, fbh, x, y, w, h, 1, tr, bt, br, ct, cr, st_top, sr, clip)
    if br_rad > 0:
        out = _fb_border_corner_arc_clip(out, fbw, fbh, x, y, w, h, 2, br_rad, bb, br, cb, cr, sb, sr, clip)
    if bl_rad > 0:
        out = _fb_border_corner_arc_clip(out, fbw, fbh, x, y, w, h, 3, bl_rad, bb, bl, cb, cl, sb, sl, clip)
    out

# Blends native form-control spans (form_control_chrome.spl) whose origin is
# (ox, oy), clipped to the frame and to `clip`. The staging raster is always
# device scale 1, so a span is CSS px here.
fn fb_chrome_spans_clip(fb: [u32], fbw: i32, fbh: i32, spans: ChromeSpans, ox: i32, oy: i32, clip: ClipRect) -> [u32]:
    var out = fb
    var n = 0
    # cpu-lane-loop-ok: one blend per span of one native control part; bound is that part's span count
    while n < spans.xs.len():
        var x0 = ox + spans.xs[n]
        var y0 = oy + spans.ys[n]
        var x1 = x0 + spans.ws[n]
        var y1 = y0 + spans.hs[n]
        if x0 < 0: x0 = 0
        if y0 < 0: y0 = 0
        if x1 > fbw: x1 = fbw
        if y1 > fbh: y1 = fbh
        if x0 < clip.x0: x0 = clip.x0
        if y0 < clip.y0: y0 = clip.y0
        if x1 > clip.x1: x1 = clip.x1
        if y1 > clip.y1: y1 = clip.y1
        val color = spans.colors[n]
        if x1 > x0 and (color >> 24) == 255u32:
            out = fb_fill_rows_const(out, fbw, x0, y0, x1, y1, color)
        elif x1 > x0:
            var row = y0
            # cpu-lane-loop-ok: rows of one translucent span; bound is the span's height
            while row < y1:
                out = fb_blend_image_row(out, row * fbw + x0, x1 - x0, color)
                row = row + 1
        n = n + 1
    out

# Chrome 159 menulist arrow (see _html_draw_ir_select_arrow_commands, the Draw
# IR twin): the 8 x 4 chevron whose box starts at int(inner right - 11.5).
fn fb_select_chevron_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, border_r: i32, color: u32, clip: ClipRect) -> [u32]:
    val arrow_x = ((w - border_r) * 2 - 23) / 2
    if w < 10 or h < 8 or arrow_x < 0:
        return fb
    fb_chrome_spans_clip(
        fb, fbw, fbh, chrome_select_arrow_spans(1, if color != 0u32: color else: web_argb(0, 0, 0)),
        x + arrow_x, y + h / 2, clip
    )

# Chrome 159 textarea resize grip (the Draw IR twin is
# _html_draw_ir_textarea_grip_commands).
fn fb_textarea_grip_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, border_l: i32, border_t: i32, border_r: i32, border_b: i32, clip: ClipRect) -> [u32]:
    if w - border_l - border_r < 16 or h - border_t - border_b < 16:
        return fb
    fb_chrome_spans_clip(fb, fbw, fbh, chrome_resizer_spans(1), x + w - border_r - 16, y + h - border_b - 16, clip)

fn fb_outline_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, outline_w: i32, outline_offset: i32, color: u32, clip: ClipRect) -> [u32]:
    if outline_w <= 0 or color == 0u32:
        return fb
    val grow = outline_w + outline_offset
    val ox = x - grow
    val oy = y - grow
    val ow = w + grow * 2
    val oh = h + grow * 2
    fb_border_sides_clip(fb, fbw, fbh, ox, oy, ow, oh, outline_w, outline_w, outline_w, outline_w, color, color, color, color, clip)

fn fb_text_underline(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, thickness: i32, style: text, color: u32) -> [u32]:
    var out = fb
    val rects = text_decoration_rects(x, y, w, thickness, style, color)
    var k = 0
    while k < rects.xs.len():
        out = fb_rect(out, fbw, fbh, rects.xs[k], rects.ys[k], rects.ws[k], rects.hs[k], rects.colors[k])
        k = k + 1
    out

fn fb_text_underline_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, thickness: i32, style: text, color: u32, clip: ClipRect) -> [u32]:
    var out = fb
    if w <= 0 or color == 0u32:
        return out
    val line_h = if thickness > 0: thickness else: 1
    if style == "double":
        out = fb_rect_clip(out, fbw, fbh, x, y, w, line_h, color, clip)
        return fb_rect_clip(out, fbw, fbh, x, y + line_h + 1, w, line_h, color, clip)
    if style == "dashed" or style == "dotted":
        val dash_w = if style == "dotted": line_h else: line_h * 3
        val gap_w = if line_h > 0: line_h else: 1
        var px = 0
        while px < w:
            val seg_w = if px + dash_w > w: w - px else: dash_w
            out = fb_rect_clip(out, fbw, fbh, x + px, y, seg_w, line_h, color, clip)
            px = px + dash_w + gap_w
        return out
    fb_rect_clip(out, fbw, fbh, x, y, w, line_h, color, clip)
var _ttf_blob_paths: [text] = []
var _ttf_blob_bytes: [[u8]] = []
var _ttf_face_specs: [text] = []
var _ttf_faces: [_TtfFaceEntry] = []
var _ttf_resolve_keys: [text] = []
var _ttf_resolve_slots: [i32] = []
var _ttf_dm_keys: [text] = []
var _ttf_dm_vals: [_TtfGlyphBitmap] = []

fn _ttf_read_file_bytes_cached(path: text) -> [u8]:
    if path == "":
        return []
    var i: i32 = 0
    val n = _ttf_blob_paths.len() as i32
    while i < n:
        if _ttf_blob_paths[i] == path:
            return _ttf_blob_bytes[i]
        i = i + 1
    var loaded: [u8] = []
    match browser_file_read_bytes(path):
        Some(raw):
            loaded = raw
        None:
            loaded = []
    if loaded.len() > 0:
        if _ttf_blob_paths.len() >= (_TTF_BLOB_CACHE_LIMIT as i64):
            _ttf_blob_paths = []
            _ttf_blob_bytes = []
        _ttf_blob_paths.push(path)
        _ttf_blob_bytes.push(loaded)
    loaded

fn _ttf_load_face_spec(spec: text) -> i32:
    if spec == "":
        return -1
    var i: i32 = 0
    val n = _ttf_face_specs.len() as i32
    while i < n:
        if _ttf_face_specs[i] == spec:
            return i
        i = i + 1
    val path = font_face_spec_path(spec)
    val face_idx = font_face_spec_index(spec)
    if path == "" or face_idx < 0:
        return -1
    val raw = _ttf_read_file_bytes_cached(path)
    if raw.len() == 0:
        return -1
    val is_ttc = raw.len() >= 12 and raw[0] == 116u8 and raw[1] == 116u8 and raw[2] == 99u8 and raw[3] == 102u8
    val face_blob = if is_ttc: sfnt_face_blob(raw, face_idx) else: raw
    if face_blob.len() == 0:
        return -1
    var font_ok = false
    var font = OtFont(blob: [], tables: [])
    match parse_offset_table(face_blob):
        Some(f):
            font = f
            font_ok = true
        None:
            font_ok = false
    if not font_ok:
        return -1
    var has_head = false
    var head_off: i64 = 0
    var head_len: i64 = 0
    var has_hhea = false
    var hhea_off: i64 = 0
    var hhea_len: i64 = 0
    var has_hmtx = false
    var hmtx_off: i64 = 0
    var hmtx_len: i64 = 0
    var has_loca = false
    var has_glyf = false
    var ti: i64 = 0
    val tbls = font.tables
    val tbl_n = tbls.len()
    while ti < tbl_n:
        val tbl = tbls[ti]
        val t = tbl.tag
        if t == 1751474532u32:
            has_head = true
            head_off = tbl.offset as i64
            head_len = tbl.length as i64
        elif t == 1751672161u32:
            has_hhea = true
            hhea_off = tbl.offset as i64
            hhea_len = tbl.length as i64
        elif t == 1752003704u32:
            has_hmtx = true
            hmtx_off = tbl.offset as i64
            hmtx_len = tbl.length as i64
        elif t == 1819239265u32:
            has_loca = true
        elif t == 1735162214u32:
            has_glyf = true
        ti = ti + 1
    if not has_head or not has_hhea or not has_hmtx or not has_loca or not has_glyf:
        return -1
    val blob_len = font.blob.len()
    if head_off < 0 or head_len < 54 or head_off + head_len > blob_len:
        return -1
    if hhea_off < 0 or hhea_len < 36 or hhea_off + hhea_len > blob_len:
        return -1
    if hmtx_off < 0 or hmtx_len < 4 or hmtx_off + hmtx_len > blob_len:
        return -1
    val upem = read_u16_be(font.blob, head_off + 18) as i32
    val asc = read_i16_be(font.blob, hhea_off + 4)
    val desc = read_i16_be(font.blob, hhea_off + 6)
    val lmet = read_u16_be(font.blob, hhea_off + 34) as i32
    if upem <= 0 or lmet <= 0:
        return -1
    var has_cmap12 = false
    var cmap12 = _ttf_empty_cmap12()
    match parse_cmap_format12(font):
        Some(c12):
            has_cmap12 = true
            cmap12 = c12
        None:
            has_cmap12 = false
    var has_cmap4 = false
    var cmap4 = _ttf_empty_cmap4()
    match parse_cmap_format4(font):
        Some(c4):
            has_cmap4 = true
            cmap4 = c4
        None:
            has_cmap4 = false
    if not has_cmap12 and not has_cmap4:
        return -1
    val entry = _TtfFaceEntry(
        spec: spec,
        font: font,
        units_per_em: upem,
        ascender: asc,
        descender: desc,
        long_metrics: lmet,
        hmtx_off: hmtx_off,
        hmtx_len: hmtx_len,
        has_cmap12: has_cmap12,
        cmap12: cmap12,
        has_cmap4: has_cmap4,
        cmap4: cmap4,
        native_bold: _ttf_spec_has_bold(spec),
        native_italic: _ttf_spec_has_italic(spec)
    )
    if _ttf_face_specs.len() >= (_TTF_FACE_CACHE_LIMIT as i64):
        _ttf_face_specs = []
        _ttf_faces = []
        _ttf_resolve_keys = []
        _ttf_resolve_slots = []
        _ttf_dm_keys = []
        _ttf_dm_vals = []
    val slot = _ttf_faces.len() as i32
    _ttf_face_specs.push(spec)
    _ttf_faces.push(entry)
    slot

fn _ttf_resolve_face(identity: text, font_family: text, bold: bool, italic: bool) -> i32:
    val b_tag = if bold: "1" else: "0"
    val it_tag = if italic: "1" else: "0"
    val key = identity + "|" + font_family + "|" + b_tag + "|" + it_tag
    var ri: i32 = 0
    val rn = _ttf_resolve_keys.len() as i32
    while ri < rn:
        if _ttf_resolve_keys[ri] == key:
            return _ttf_resolve_slots[ri]
        ri = ri + 1
    var candidates: [text] = []
    if identity != "":
        if identity.starts_with("unmanaged="):
            val u_spec = font_unmanaged_identity_face_spec(identity)
            if u_spec != "":
                candidates.push(u_spec)
        elif identity.starts_with("sha256="):
            val m_path = selected_font_asset_local_path_for_identity(identity)
            if m_path != "":
                candidates.push(m_path)
        elif identity.ends_with(".ttf") or identity.ends_with(".ttc") or identity.contains("#"):
            candidates.push(identity)
    val family_cands = web_font_face_candidates(font_family, bold, italic)
    var fi: i64 = 0
    while fi < family_cands.len():
        candidates.push(family_cands[fi])
        fi = fi + 1
    candidates.push("assets/fonts/NotoSans-Regular.ttf")
    candidates.push("doc/06_spec/03_system/app/simple_web/evidence/fonts/DejaVuSans.ttf")
    if bold:
        candidates.push("/System/Library/Fonts/Helvetica.ttc#1")
        candidates.push("/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf")
        candidates.push("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf")
    candidates.push("/System/Library/Fonts/Helvetica.ttc#0")
    candidates.push("/System/Library/Fonts/Supplemental/Arial.ttf")
    candidates.push("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf")
    candidates.push("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    candidates.push("assets/fonts/google-fonts/ofl/nunito/Nunito[wght].ttf")
    candidates.push("assets/fonts/google-fonts/ofl/bungee/Bungee-Regular.ttf")
    var chosen: i32 = -1
    var ci: i64 = 0
    while ci < candidates.len() and chosen < 0:
        chosen = _ttf_load_face_spec(candidates[ci])
        ci = ci + 1
    if _ttf_resolve_keys.len() >= (_TTF_RESOLVE_CACHE_LIMIT as i64):
        _ttf_resolve_keys = []
        _ttf_resolve_slots = []
    _ttf_resolve_keys.push(key)
    _ttf_resolve_slots.push(chosen)
    chosen

fn _ttf_glyph_cached(face_slot: i32, font_size: i32, synth_bold: bool, synth_italic: bool, gid: u32) -> _TtfGlyphBitmap:
    if _ttf_dm_keys.len() == 0:
        var init_i: i32 = 0
        while init_i < _TTF_GLYPH_DM_SIZE:
            _ttf_dm_keys.push("")
            _ttf_dm_vals.push(_ttf_empty_glyph_bitmap(0))
            init_i = init_i + 1
    val sb_i = if synth_bold: 1 else: 0
    val si_i = if synth_italic: 1 else: 0
    val key = "{face_slot}:{font_size}:{sb_i}:{si_i}:{gid}"
    val h_raw: i64 = (face_slot as i64) * 73856093 + (font_size as i64) * 19349663 + (sb_i as i64) * 83492791 + (si_i as i64) * 297121507 + (gid as i64)
    var slot = (h_raw % (_TTF_GLYPH_DM_SIZE as i64)) as i32
    if slot < 0:
        slot = slot + _TTF_GLYPH_DM_SIZE
    if _ttf_dm_keys[slot] == key:
        return _ttf_dm_vals[slot]
    val bmp = _ttf_rasterize_glyph(_ttf_faces[face_slot], gid, font_size, synth_bold, synth_italic)
    _ttf_dm_keys[slot] = key
    _ttf_dm_vals[slot] = bmp
    bmp

# reason: TTF availability query over boolean bold/italic flags
# @allow(primitive_api)
pub fn fb_text_ttf_available(resolved_font_identity: text, font_family: text, bold: bool, italic: bool) -> bool:
    _ttf_resolve_face(resolved_font_identity, font_family, bold, italic) >= 0

# reason: TTF ascent pixel calculator takes integer font_size and boolean bold/italic flags
# @allow(primitive_api)
pub fn fb_text_ttf_ascent_px(font_size: i32, resolved_font_identity: text, font_family: text, bold: bool, italic: bool) -> i32:
    if font_size <= 0:
        return 0
    val face_slot = _ttf_resolve_face(resolved_font_identity, font_family, bold, italic)
    if face_slot < 0:
        return (font_size * 905 + 500) / 1000
    val face = _ttf_faces[face_slot]
    val upem = face.units_per_em
    if face.ascender > 0 and upem > 0:
        return (face.ascender * font_size + upem / 2) / upem
    (font_size * 905 + 500) / 1000

# reason: TTF baseline pixel calculator takes i32 pixel coordinates/size and bold/italic flags
# @allow(primitive_api)
pub fn fb_text_ttf_line_baseline_y(line_top: i32, line_h_px: i32, font_size: i32, resolved_font_identity: text, font_family: text, bold: bool, italic: bool) -> i32:
    val face_slot = _ttf_resolve_face(resolved_font_identity, font_family, bold, italic)
    var asc_px = (font_size * 905 + 500) / 1000
    var desc_px = (font_size * 212 + 500) / 1000
    if face_slot >= 0:
        val face = _ttf_faces[face_slot]
        val upem = face.units_per_em
        if upem > 0:
            if face.ascender > 0:
                asc_px = (face.ascender * font_size + upem / 2) / upem
            val desc_fu = if face.descender < 0: 0 - face.descender else: 0
            if desc_fu > 0:
                desc_px = (desc_fu * font_size + upem / 2) / upem
    if line_h_px <= 0:
        return line_top + asc_px
    val text_top = (2 * line_top + line_h_px - asc_px - desc_px) / 2
    text_top + asc_px

# reason: low-level framebuffer TTF glyph range painter over raw [u32] pixels and i32 coords
# @allow(primitive_api)
pub fn fb_text_ttf_aa_clip_range_adv(
    fb: [u32], fbw: i32, fbh: i32, x: i32, baseline_y: i32,
    s: text, start: i32, endv: i32, color: u32, font_size: i32,
    resolved_font_identity: text, font_family: text,
    italic: bool, bold: bool, clip: ClipRect, by: [i32]
) -> [u32]:
    if font_size <= 0 or start >= endv:
        return fb
    val fg_alpha = ((color >> 24) & 255u32) as i32
    if fg_alpha <= 0:
        return fb
    val face_slot = _ttf_resolve_face(resolved_font_identity, font_family, bold, italic)
    if face_slot < 0:
        val fallback_scale = web_glyph_scale(font_size)
        val fallback_adv = 6 * fallback_scale
        val fallback_space = 3 * fallback_scale
        return fb_text_thin_scaled_clip_range_adv(
            fb, fbw, fbh, x, baseline_y - 7 * fallback_scale, s, start, endv,
            color, fallback_scale, fallback_adv, fallback_space, italic, bold, clip, by
        )
    val face = _ttf_faces[face_slot]
    val synth_bold = bold and not face.native_bold
    val synth_italic = italic and not face.native_italic
    var cx0 = if clip.x0 > 0: clip.x0 else: 0
    var cy0 = if clip.y0 > 0: clip.y0 else: 0
    var cx1 = if clip.x1 < fbw: clip.x1 else: fbw
    var cy1 = if clip.y1 < fbh: clip.y1 else: fbh
    if cx0 >= cx1 or cy0 >= cy1:
        return fb
    val s_blen = s.byte_len()
    val use_by = by.len() == s_blen
    val clamped_end = if endv < s_blen: endv else: s_blen
    val sb = s.bytes()
    val cps = text_codepoints(s)
    var ci: i64 = 0
    var k: i32 = 0
    while k < start and k < s_blen:
        if sb[k] < 128 or sb[k] >= 192:
            ci = ci + 1
        k = k + 1
    var out = fb
    var pen_x = x
    var i = start
    while i < clamped_end:
        if pen_x - font_size >= cx1:
            return out
        val b = sb[i]
        var step_x: i32 = 0
        if b < 128 or b >= 192:
            val cp = if ci < cps.len(): cps[ci] else: 0
            ci = ci + 1
            val is_ws = cp == 32 or cp == 9 or cp == 10 or cp == 13
            val gid = _ttf_cmap_glyph(face, cp)
            if is_ws:
                if not use_by:
                    step_x = _ttf_hmtx_advance_px(face, gid, font_size)
            elif gid == 0u32:
                val gi = glyph_index_for_char_code(cp)
                val fb_scale = web_glyph_scale(font_size)
                if gi >= 0 and gi != 36:
                    out = fb_glyph_thin_scaled_clip(
                        out, fbw, fbh, pen_x, baseline_y - 7 * fb_scale,
                        gi, color, fb_scale, italic, bold, clip
                    )
                if not use_by:
                    step_x = 6 * fb_scale
            else:
                val bmp = _ttf_glyph_cached(face_slot, font_size, synth_bold, synth_italic, gid)
                if not use_by:
                    step_x = bmp.adv_px
                if bmp.w_px > 0 and bmp.h_px > 0 and bmp.coverage.len() > 0:
                    val gx0 = pen_x + bmp.x0_px
                    val gy0 = baseline_y + bmp.y0_px
                    val gx1 = gx0 + bmp.w_px
                    val gy1 = gy0 + bmp.h_px
                    val dx0 = if gx0 > cx0: gx0 else: cx0
                    val dy0 = if gy0 > cy0: gy0 else: cy0
                    val dx1 = if gx1 < cx1: gx1 else: cx1
                    val dy1 = if gy1 < cy1: gy1 else: cy1
                    if dx0 < dx1 and dy0 < dy1:
                        var dy = dy0
                        while dy < dy1:
                            val src_row = (dy - gy0) * bmp.w_px
                            val dst_row = dy * fbw
                            var dx = dx0
                            while dx < dx1:
                                val cov = bmp.coverage[src_row + (dx - gx0)] as i32
                                if cov > 0:
                                    val eff_alpha = if fg_alpha == 255: cov else: (cov * fg_alpha + 127) / 255
                                    if eff_alpha > 0:
                                        val dst_idx = dst_row + dx
                                        out[dst_idx] = composite_over_base(color, eff_alpha, out[dst_idx])
                                dx = dx + 1
                            dy = dy + 1
        if use_by:
            step_x = by[i]
        pen_x = pen_x + step_x
        i = i + 1
    out

# reason: low-level framebuffer TTF range painter over raw [u32] pixels and i32 coords
# @allow(primitive_api)
pub fn fb_text_ttf_aa_clip_range(
    fb: [u32], fbw: i32, fbh: i32, x: i32, baseline_y: i32,
    s: text, start: i32, endv: i32, color: u32, font_size: i32,
    resolved_font_identity: text, font_family: text,
    italic: bool, bold: bool, clip: ClipRect
) -> [u32]:
    fb_text_ttf_aa_clip_range_adv(
        fb, fbw, fbh, x, baseline_y, s, start, endv, color, font_size,
        resolved_font_identity, font_family, italic, bold, clip, []
    )

# The half-covered diagonal pixel: half of each side, painted ONCE as the
# 50/50 mix (two sequential half blends weighted the first side 25%). A
# transparent side (0) contributes nothing.
fn _fb_mitre_pixel(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, ca: u32, cb: u32, clip: ClipRect) -> [u32]:
    if ca == 0u32 and cb == 0u32:
        return fb
    val mix = mitre_mix_color(ca, cb)
    val a = ((mix >> 24) & 255u32) as i32
    fb_rect_opacity_clip(fb, fbw, fbh, x, y, 1, 1, mix | 0xFF000000u32, (a * 100 + 127) / 255, clip)

# 50/50 mix of two side colours as one colour with its own alpha (the alpha
# byte 0 of a non-zero colour means opaque here). Premultiplied average.
fn mitre_mix_color(ca: u32, cb: u32) -> u32:
    var r = 0
    var g = 0
    var b = 0
    var a_sum = 0
    for c in [ca, cb]:
        if c != 0u32:
            val a0 = ((c >> 24) & 255u32) as i32
            val ea = if a0 == 0: 255 else: a0
            r = r + (((c >> 16) & 255u32) as i32) * ea
            g = g + (((c >> 8) & 255u32) as i32) * ea
            b = b + ((c & 255u32) as i32) * ea
            a_sum = a_sum + ea
    if a_sum == 0:
        return 0u32
    val a = a_sum / 2
    ((a as u32) << 24) | (((r / a_sum) as u32) << 16) | (((g / a_sum) as u32) << 8) | ((b / a_sum) as u32)

fn _fb_border_sides_mitred(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, bl: i32, bt: i32, br: i32, bb: i32, cl: u32, ct: u32, cr: u32, cb: u32, clip: ClipRect) -> [u32]:
    var out = fb
    # Horizontal sides, one row at a time: row r of the top side and row r
    # (counted up from the bottom edge) of the bottom side.
    for side in [0, 1]:
        val thick = if side == 0: bt else: bb
        val c = if side == 0: ct else: cb
        var r = 0
        while r < thick:
            val py = if side == 0: y + r else: y + h - 1 - r
            var l_full = 0
            var r_full = 0
            if bl > 0 and cl != c:
                val cut = _fb_mitre_cut(r, thick, bl)
                l_full = cut / 2
                if cut % 2 == 1:
                    out = _fb_mitre_pixel(out, fbw, fbh, x + l_full - 1, py, c, cl, clip)
            if br > 0 and cr != c:
                val cut = _fb_mitre_cut(r, thick, br)
                r_full = cut / 2
                if cut % 2 == 1:
                    out = _fb_mitre_pixel(out, fbw, fbh, x + w - r_full, py, c, cr, clip)
            if c != 0u32 and w - l_full - r_full > 0:
                out = _fb_border_side_clip(out, fbw, fbh, x + l_full, py, w - l_full - r_full, 1, c, clip)
            r = r + 1
    # Vertical sides: the rows between the horizontal sides whole, and inside
    # a mitred corner only the columns before the diagonal. A same-coloured
    # corner was already painted by the horizontal side.
    for side in [0, 1]:
        val thick = if side == 0: bl else: br
        val c = if side == 0: cl else: cr
        if thick > 0 and c != 0u32:
            val px0 = if side == 0: x else: x + w - thick
            if h - bt - bb > 0:
                out = _fb_border_side_clip(out, fbw, fbh, px0, y + bt, thick, h - bt - bb, c, clip)
            for end in [0, 1]:
                val cross = if end == 0: bt else: bb
                val cc = if end == 0: ct else: cb
                if cross > 0 and cc != c:
                    var r = 0
                    while r < cross:
                        val cut = _fb_mitre_cut(r, cross, thick)
                        val own = cut / 2 - cut % 2
                        if own > 0:
                            val py = if end == 0: y + r else: y + h - 1 - r
                            val ox = if side == 0: x else: x + w - own
                            out = _fb_border_side_clip(out, fbw, fbh, ox, py, own, 1, c, clip)
                        r = r + 1
    out
