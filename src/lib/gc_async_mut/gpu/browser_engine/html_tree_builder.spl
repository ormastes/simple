# HTML Tree Builder — WHATWG insertion-mode tree construction
#
# Builds a BeDomNode tree from tokenized HTML.
# Key constraint: BeDomNode values are copied when stored in arrays.
# The private stack owns preallocated storage and clears slots before child growth.

use std.gc_async_mut.gpu.browser_engine.html_tokenizer.{
    HtmlTokenizer, HtmlToken, HtmlTokenKind, HtmlAttr,
    html_tokenizer_new, html_tokenizer_tokenize_with_limits,
    HTML_MAX_TOKENS, HTML_MAX_ATTRIBUTES
}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_get_tag, be_dom_get_children, be_dom_get_attr,
    be_dom_add_child, be_dom_set_attr, be_dom_get_is_text,
    be_dom_set_children
}
use std.gc_async_mut.gpu.browser_engine.css.{be_default_style}
use std.gc_async_mut.gpu.browser_engine.dom_limits.{
    HTML_MAX_TREE_DEPTH, HTML_MAX_NODES
}
use common.web.html_escape.{html_escape_core}

# Preallocated owner keeps stack mutation O(1) without aliased array parameters.
class _TreeStack:
    nodes: [BeDomNode]
    parent_indices: [i32]
    length: i32
    empty: BeDomNode

    fn len() -> i32:
        self.length

    fn top() -> BeDomNode:
        self.nodes[self.length - 1]

    fn root_or(fallback: BeDomNode) -> BeDomNode:
        if self.length > 0: self.nodes[0] else: fallback

    fn find_tag(tag: text) -> i32:
        var i = self.length - 1
        while i >= 0:
            if be_dom_get_tag(self.nodes[i]) == tag:
                return i
            i = i - 1
        -1

    me push_open(node: BeDomNode):
        if self.length >= self.nodes.len():
            val completed_idx = self.length - 1
            val parent_idx = self.parent_indices[completed_idx]
            val completed = self.nodes[completed_idx]
            var parent = self.nodes[parent_idx]
            self.nodes[completed_idx] = self.empty
            self.nodes[parent_idx] = self.empty
            parent.children.push(completed)
            self.nodes[parent_idx] = parent
            self.length = completed_idx
        self.nodes[self.length] = node
        self.parent_indices[self.length] = self.length - 1
        self.length = self.length + 1

    me foster_push_open(node: BeDomNode):
        var table_idx = self.length - 1
        while table_idx >= 0 and be_dom_get_tag(self.nodes[table_idx]) != "table":
            table_idx = table_idx - 1
        val parent_idx = if table_idx > 0: table_idx - 1 else: self.length - 1
        if self.length >= self.nodes.len():
            self.close_top()
        self.nodes[self.length] = node
        self.parent_indices[self.length] = parent_idx
        self.length = self.length + 1

    me replace_top(node: BeDomNode):
        self.nodes[self.length - 1] = node

    me append_child(child: BeDomNode):
        if self.length == 0: return
        val idx = self.length - 1
        var parent = self.nodes[idx]
        self.nodes[idx] = self.empty
        parent.children.push(child)
        self.nodes[idx] = parent

    me close_top():
        if self.length <= 1: return
        val completed_idx = self.length - 1
        val parent_idx = self.parent_indices[completed_idx]
        val completed = self.nodes[completed_idx]
        var parent = self.nodes[parent_idx]
        self.nodes[completed_idx] = self.empty
        self.nodes[parent_idx] = self.empty
        parent.children.push(completed)
        self.nodes[parent_idx] = parent
        self.length = completed_idx

    me close_through(tag: text):
        var limit = 200
        while limit > 0 and self.length > 1:
            limit = limit - 1
            val completed_idx = self.length - 1
            val parent_idx = self.parent_indices[completed_idx]
            val top_tag = be_dom_get_tag(self.nodes[completed_idx])
            val completed = self.nodes[completed_idx]
            var parent = self.nodes[parent_idx]
            self.nodes[completed_idx] = self.empty
            self.nodes[parent_idx] = self.empty
            parent.children.push(completed)
            self.nodes[parent_idx] = parent
            self.length = completed_idx
            if top_tag == tag:
                limit = 0

    me foster_append(child: BeDomNode):
        var table_idx = self.length - 1
        while table_idx >= 0 and be_dom_get_tag(self.nodes[table_idx]) != "table":
            table_idx = table_idx - 1
        val parent_idx = if table_idx > 0: table_idx - 1 else: self.length - 1
        var parent = self.nodes[parent_idx]
        self.nodes[parent_idx] = self.empty
        parent.children.push(child)
        self.nodes[parent_idx] = parent

fn _is_void(tag: text) -> bool:
    if tag == "area": return true
    if tag == "base": return true
    if tag == "br": return true
    if tag == "col": return true
    if tag == "embed": return true
    if tag == "hr": return true
    if tag == "img": return true
    if tag == "input": return true
    if tag == "link": return true
    if tag == "meta": return true
    if tag == "param": return true
    if tag == "source": return true
    if tag == "track": return true
    if tag == "wbr": return true
    false

fn _is_table_context(tag: text) -> bool:
    """True if this tag is a table structural element."""
    tag == "table" or tag == "tbody" or tag == "thead" or tag == "tfoot" or tag == "tr"

fn _is_table_content(tag: text) -> bool:
    """True if this tag is valid inside a table."""
    if _is_table_context(tag): return true
    if tag == "td": return true
    if tag == "th": return true
    if tag == "col": return true
    if tag == "colgroup": return true
    if tag == "caption": return true
    false

fn _closes_p_elem(tag: text) -> bool:
    if tag == "address": return true
    if tag == "article": return true
    if tag == "aside": return true
    if tag == "blockquote": return true
    if tag == "div": return true
    if tag == "dl": return true
    if tag == "details": return true
    if tag == "fieldset": return true
    if tag == "footer": return true
    if tag == "h1": return true
    if tag == "h2": return true
    if tag == "h3": return true
    if tag == "h4": return true
    if tag == "h5": return true
    if tag == "h6": return true
    if tag == "header": return true
    if tag == "hr": return true
    if tag == "main": return true
    if tag == "menu": return true
    if tag == "nav": return true
    if tag == "ol": return true
    if tag == "p": return true
    if tag == "pre": return true
    if tag == "section": return true
    if tag == "summary": return true
    if tag == "table": return true
    if tag == "ul": return true
    false

fn _apply_attrs(node: BeDomNode, attrs: [HtmlAttr]) -> BeDomNode:
    """Apply attributes to node and return the modified node."""
    var n = node
    var ai = 0
    while ai < attrs.len():
        val attr = attrs[ai]
        ai = ai + 1
        n.set_attr(attr.name, attr.value)
    n

fn _token_would_create_node(
    tok: HtmlToken, in_body: bool, in_script: bool,
    skipped_raw_text_tag: text
) -> bool:
    if tok.token_kind == HtmlTokenKind.StartTag:
        val tag = tok.tag_name
        if tag == "html" or tag == "head" or tag == "body":
            return false
        return tag != "style" and tag != "noscript"
    if tok.token_kind == HtmlTokenKind.EndTag:
        return tok.tag_name == "script" and in_script
    if tok.token_kind == HtmlTokenKind.Character:
        if in_script or skipped_raw_text_tag != "":
            return false
        return in_body or tok.data.trim().len() > 0
    false

pub class TreeBuilderResult:
    """Result from html_tree_builder_build_with_scripts.

    Fields:
        doc       - the built DOM tree (#document node)
        scripts   - collected <script> bodies in document order
        src_paths - collected <script src="..."> paths in document order
        truncated - true when the requested or production node cap was reached
    """
    doc: BeDomNode
    scripts: [text]
    src_paths: [text]
    truncated: bool

pub class HtmlFlatNode:
    """Canonical bounded HTML node projected in pre-order."""
    tag: text
    text_data: text
    normalized_attrs: text
    parent: i32
    depth: i32

pub class HtmlFlatProjection:
    nodes: [HtmlFlatNode]
    truncated: bool

pub fn html_tree_builder_build(html_text: text) -> BeDomNode:
    """Build a BeDomNode tree. Returns a #document node with an html child."""
    val result = html_tree_builder_build_with_scripts(html_text)
    result.doc

fn _debug_walk_bedom(node: BeDomNode, depth: i32, out: [text]):
    val style_val: text = node.get_attr("style")
    out.push(
        depth.to_text() + "|" + node.tag_name + "|attrlen=" +
        style_val.len().to_text() + "|childcount=" + node.children.len().to_text()
    )
    var i = 0
    while i < node.children.len():
        _debug_walk_bedom(node.children[i], depth + 1, out)
        i = i + 1

pub fn html_tree_builder_debug_dump_bedom(html_text: text) -> text:
    """Permanent debug entry point: recursive tag_name/get_attr("style")/
    children-count dump of the raw BeDomNode tree, bypassing the flat
    stack-pop projection and HNode entirely. Used to bisect the JIT
    struct-field-read defect chased in doc/08_tracking/bug/
    jit_run_file_pipeline_gaps_2026-07-30.md section 16."""
    val doc = html_tree_builder_build(html_text)
    var out: [text] = []
    _debug_walk_bedom(doc, 0, out)
    out.join("\n")

pub fn html_tree_builder_build_with_scripts(html_text: text) -> TreeBuilderResult:
    html_tree_builder_build_with_scripts_limit(html_text, HTML_MAX_NODES)

pub fn html_tree_builder_build_with_scripts_limit(
    html_text: text, requested_node_limit: i64
) -> TreeBuilderResult:
    html_tree_builder_build_with_parse_limits(
        html_text, requested_node_limit,
        HTML_MAX_TOKENS, HTML_MAX_ATTRIBUTES
    )

pub fn html_tree_builder_build_with_parse_limits(
    html_text: text, requested_node_limit: i64,
    requested_token_limit: i32, requested_attr_limit: i32
) -> TreeBuilderResult:
    """Build a BeDomNode tree and collect <script> content.

    Returns a TreeBuilderResult with the DOM tree and any inline script
    bodies or external script src paths found during parsing.
    """
    val node_limit = if requested_node_limit < 4:
        4
    elif requested_node_limit > HTML_MAX_NODES:
        HTML_MAX_NODES
    else:
        requested_node_limit
    val tokenizer = html_tokenizer_new(html_text)
    val tokenized = html_tokenizer_tokenize_with_limits(
        tokenizer, requested_token_limit, requested_attr_limit
    )
    val tokens = tokenized.tokens
    val ntok = tokens.len()

    # Collected script content
    var script_bodies: [text] = []
    var script_src_paths: [text] = []

    # Stack: [#document, html, head] initially
    # We'll switch from head-mode to body-mode on first body content
    var next_node_id: i64 = 1
    val doc_node = BeDomNode.element_with_id(next_node_id, "#document")
    next_node_id = next_node_id + 1
    val html_el = BeDomNode.element_with_id(next_node_id, "html")
    next_node_id = next_node_id + 1
    val head_el = BeDomNode.element_with_id(next_node_id, "head")
    next_node_id = next_node_id + 1
    val body_el = BeDomNode.element_with_id(next_node_id, "body")
    next_node_id = next_node_id + 1

    val empty_node = BeDomNode.element_with_id(0, "")
    val stack = _TreeStack(
        nodes: [empty_node; HTML_MAX_TREE_DEPTH],
        parent_indices: [-1; HTML_MAX_TREE_DEPTH],
        length: 0, empty: empty_node
    )
    stack.push_open(doc_node)
    stack.push_open(html_el)
    stack.push_open(head_el)

    var in_body = false
    var in_script = false
    var script_in_template = false
    var script_content = ""
    var script_src = ""
    var skipped_raw_text_tag = ""
    var truncated = tokenized.truncated

    var ti = 0
    while ti < ntok:
        val tok = tokens[ti]
        if (next_node_id > node_limit and _token_would_create_node(
            tok, in_body, in_script, skipped_raw_text_tag
        )):
            truncated = true
            ti = ntok
            continue
        ti = ti + 1

        if tok.token_kind == HtmlTokenKind.Eof:
            ti = ntok

        elif tok.token_kind == HtmlTokenKind.Doctype:
            pass_dn

        elif tok.token_kind == HtmlTokenKind.Comment:
            pass_dn

        elif tok.token_kind == HtmlTokenKind.StartTag:
            val t = tok.tag_name

            if t == "html":
                val html_idx = stack.find_tag("html")
                if html_idx >= 0:
                    stack.nodes[html_idx] = _apply_attrs(
                        stack.nodes[html_idx], tok.attrs
                    )

            elif t == "head":
                val head_idx = stack.find_tag("head")
                if head_idx >= 0:
                    stack.nodes[head_idx] = _apply_attrs(
                        stack.nodes[head_idx], tok.attrs
                    )

            elif t == "body":
                if not in_body:
                    # Pop head, push body
                    stack.close_top()
                    stack.push_open(_apply_attrs(body_el, tok.attrs))
                    in_body = true
                else:
                    val body_idx = stack.find_tag("body")
                    if body_idx >= 0:
                        stack.nodes[body_idx] = _apply_attrs(
                            stack.nodes[body_idx], tok.attrs
                        )

            elif t == "title":
                val title_raw = BeDomNode.element_with_id(next_node_id, t)
                next_node_id = next_node_id + 1
                stack.push_open(_apply_attrs(title_raw, tok.attrs))

            elif t == "meta" or t == "link" or t == "base":
                # head elements — add to top of stack as void children
                val he_raw = BeDomNode.element_with_id(next_node_id, t)
                next_node_id = next_node_id + 1
                val he = _apply_attrs(he_raw, tok.attrs)
                stack.append_child(he)

            elif t == "script":
                # M15: Collect script content for execution
                if not in_body:
                    stack.close_top()
                    stack.push_open(body_el)
                    in_body = true
                in_script = true
                script_in_template = stack.find_tag("template") >= 0
                script_content = ""
                # Check for src attribute
                script_src = ""
                var sa = 0
                while sa < tok.attrs.len():
                    val attr = tok.attrs[sa]
                    if attr.name == "src":
                        script_src = attr.value
                    sa = sa + 1
                # Push script element onto stack
                val script_el = BeDomNode.element_with_id(next_node_id, "script")
                next_node_id = next_node_id + 1
                val script_node = _apply_attrs(script_el, tok.attrs)
                stack.push_open(script_node)

            elif t == "style" or t == "noscript":
                skipped_raw_text_tag = t

            else:
                # Switch to body if not yet
                if not in_body:
                    stack.close_top()  # close head
                    stack.push_open(body_el)
                    in_body = true

                # Implicit close of <p> before block elements
                if _closes_p_elem(t) and stack.find_tag("p") >= 0:
                    stack.close_through("p")

                # Implicit close of <li> before new <li>
                if t == "li" and stack.find_tag("li") >= 0:
                    stack.close_through("li")

                # A new definition term or description closes either open kind.
                if t == "dt" or t == "dd":
                    val open_dt = stack.find_tag("dt")
                    val open_dd = stack.find_tag("dd")
                    if open_dt > open_dd:
                        stack.close_through("dt")
                    elif open_dd >= 0:
                        stack.close_through("dd")

                # HTML5 "in table" insertion-mode subset (bug
                # browser_engine_no_implicit_tbody_synthesis_2026-08-19):
                # a row or cell that appears directly inside <table> gets an
                # implicit <tbody>, matching Chrome's tree construction.
                # thead/tfoot grouping of stray rows is out of scope — only
                # the tbody synthesis branch every real page hits.
                if (
                    (t == "tr" or t == "td" or t == "th") and
                    be_dom_get_tag(stack.top()) == "table"
                ):
                    val implicit_tbody = BeDomNode.element_with_id(
                        next_node_id, "tbody"
                    )
                    next_node_id = next_node_id + 1
                    stack.push_open(implicit_tbody)

                # Check if we're in a table context with non-table content
                val top_tag = be_dom_get_tag(stack.top())
                val in_table_ctx = _is_table_context(top_tag)
                val is_table_content = _is_table_content(t)

                if _is_void(t):
                    val vn_raw = BeDomNode.element_with_id(next_node_id, t)
                    next_node_id = next_node_id + 1
                    val vnode = _apply_attrs(vn_raw, tok.attrs)
                    if in_table_ctx and not is_table_content:
                        stack.foster_append(vnode)
                    else:
                        stack.append_child(vnode)
                elif in_table_ctx and not is_table_content:
                    # Foster-parent non-table elements that appear inside table context
                    val fp_raw = BeDomNode.element_with_id(next_node_id, t)
                    next_node_id = next_node_id + 1
                    val fp_el = _apply_attrs(fp_raw, tok.attrs)
                    stack.foster_push_open(fp_el)
                else:
                    val el_raw = BeDomNode.element_with_id(next_node_id, t)
                    next_node_id = next_node_id + 1
                    val new_el = _apply_attrs(el_raw, tok.attrs)
                    stack.push_open(new_el)

        elif tok.token_kind == HtmlTokenKind.EndTag:
            val et = tok.tag_name
            if et == "script" and in_script:
                # M15: Close script tag — collect content
                in_script = false
                if not script_in_template:
                    if script_src != "":
                        script_src_paths.push(script_src)
                    elif script_content.trim().len() > 0:
                        script_bodies.push(script_content)
                # Store content as a real DOM text child.
                var top = stack.top()
                top.children = [BeDomNode.text_node(next_node_id, script_content)]
                next_node_id = next_node_id + 1
                stack.replace_top(top)
                # Pop script node and append to parent
                if stack.find_tag("script") >= 0:
                    stack.close_top()
                script_content = ""
                script_src = ""
                script_in_template = false
            elif et == skipped_raw_text_tag:
                skipped_raw_text_tag = ""
            elif et == "html" or et == "body" or et == "head":
                pass_dn  # handled in drain
            elif stack.find_tag(et) >= 0:
                stack.close_through(et)

        elif tok.token_kind == HtmlTokenKind.Character:
            val data = tok.data
            # M15: Accumulate text inside <script> tags
            if in_script:
                script_content = "{script_content}{data}"
            elif skipped_raw_text_tag != "":
                pass_dn
            elif be_dom_get_tag(stack.top()) == "title":
                val title_text = BeDomNode.text_node(next_node_id, data)
                next_node_id = next_node_id + 1
                stack.append_child(title_text)
            elif not in_body:
                if data.trim().len() > 0:
                    # Non-whitespace before body — switch to body
                    stack.close_top()  # close head
                    stack.push_open(body_el)
                    in_body = true
                    val tn = BeDomNode.text_node(next_node_id, data)
                    next_node_id = next_node_id + 1
                    stack.append_child(tn)
            else:
                val tn2 = BeDomNode.text_node(next_node_id, data)
                next_node_id = next_node_id + 1
                if (
                    data.trim().len() > 0 and
                    _is_table_context(be_dom_get_tag(stack.top()))
                ):
                    stack.foster_append(tn2)
                else:
                    stack.append_child(tn2)

    # Empty and head-only documents still own one independently synthesized
    # body element.
    if not in_body:
        stack.close_top()
        stack.push_open(body_el)
    # Drain remaining open elements
    while stack.len() > 1:
        stack.close_top()

    val final_doc = stack.root_or(doc_node)
    TreeBuilderResult(
        doc: final_doc, scripts: script_bodies,
        src_paths: script_src_paths, truncated: truncated
    )

fn _flat_projection_attrs(node: BeDomNode) -> text:
    var keys = node.attributes.keys()
    keys.sort()
    var normalized = ""
    for key in keys:
        if not key.starts_with("\u0000"):
            normalized = normalized + " " + key + "=\"" +
                html_escape_core(node.attributes.get(key) ?? "") + "\""
    normalized

pub fn html_tree_builder_flat_projection(
    html_text: text
) -> HtmlFlatProjection:
    html_tree_builder_flat_projection_with_limits(
        html_text, HTML_MAX_NODES, HTML_MAX_TOKENS, HTML_MAX_ATTRIBUTES
    )

pub fn html_tree_builder_flat_projection_with_limits(
    html_text: text, requested_node_limit: i64,
    requested_token_limit: i32, requested_attr_limit: i32
) -> HtmlFlatProjection:
    """Build once canonically, then flatten in authoritative child order."""
    val built = html_tree_builder_build_with_parse_limits(
        html_text, requested_node_limit,
        requested_token_limit, requested_attr_limit
    )
    val projection_limit = if requested_node_limit < 4:
        4
    elif requested_node_limit > HTML_MAX_NODES:
        HTML_MAX_NODES
    else:
        requested_node_limit
    var nodes: [HtmlFlatNode] = []
    var node_stack: [BeDomNode] = [built.doc]
    var parent_stack: [i32] = [-1]
    var depth_stack: [i32] = [0]
    var truncated = built.truncated
    while node_stack.len() > 0:
        val node = node_stack.pop()
        val parent = parent_stack.pop()
        val depth = depth_stack.pop()
        if nodes.len() >= projection_limit:
            truncated = true
            node_stack = []
            parent_stack = []
            depth_stack = []
            continue
        val projected_index = nodes.len() as i32
        nodes.push(HtmlFlatNode(
            tag: node.tag_name,
            text_data: node.data,
            normalized_attrs: _flat_projection_attrs(node),
            parent: parent,
            depth: depth
        ))
        var child_i = node.children.len()
        while child_i > 0:
            child_i = child_i - 1
            node_stack.push(node.children[child_i])
            parent_stack.push(projected_index)
            depth_stack.push(depth + 1)
    HtmlFlatProjection(nodes: nodes, truncated: truncated)
