# Shared fail-closed checks for the bounded Web rectangle adapters.

use common.ui.draw_ir.{DRAW_IR_COMMAND_RECT, DrawIrCommand,
    draw_ir_command_has_unsupported_v4_state}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{Style}

# Exact fixed keys emitted by _html_draw_ir_style_props. The conditional
# material and per-shadow-layer keys are excluded and therefore rejected.
# Presence is checked for the paint controls that make a plain rect truthful.
pub val WEB_OPAQUE_STYLE_KEYS: text =
    "|background-gradient-stop-count|background-gradient-stops|background-gradient-angle-deg|background-gradient-is-radial|" +
    "tag|id|class|display|grid-template-columns|grid-template-rows|grid-column|grid-row|flex-direction|flex-wrap|" +
    "justify-content|align-items|align-self|background-clip|background-attachment|background-repeat|" +
    "background-size-width|background-size-height|background-position-x|background-position-y|background-color|" +
    "background-image|background-layers-raw|background-origin|box-shadow|box-shadow-raw|box-shadow-layer-count|" +
    "box-shadow-blur-radius|backdrop-filter|backdrop-filter-capability|backdrop-filter-fallback|" +
    "backdrop-filter-fallback-reason|color|direction|font-size|font-family|font-identity|font-size-adjust|" +
    "font-palette|font-feature-settings|font-language-override|font-variation-settings|font-variant|" +
    "font-variant-alternates|font-variant-caps|font-variant-east-asian|font-variant-emoji|" +
    "font-variant-ligatures|font-variant-numeric|font-variant-position|font-style|font-kerning|" +
    "font-optical-sizing|font-stretch|font-width|font-synthesis|font-synthesis-small-caps|" +
    "font-synthesis-position|font-synthesis-style|font-synthesis-weight|font-weight|width|height|" +
    "min-width|max-width|min-height|max-height|position|left|top|right|bottom|line-height|letter-spacing|" +
    "caret-color|accent-color|cursor|hyphens|line-break|overflow-wrap|resize|table-layout|border-collapse|" +
    "border-spacing|caption-side|vertical-align|tab-size|unicode-bidi|word-break|word-wrap|writing-mode|" +
    "text-orientation|text-combine-upright|word-spacing|text-decoration-color|text-decoration-line|" +
    "text-indent|text-overflow|text-shadow|text-transform|text-decoration-style|text-decoration-thickness|" +
    "text-underline-offset|text-underline-position|text-align|text-align-all|text-align-last|text-justify|" +
    "transition-property|transition-duration|transition-delay|transition-timing-function|animation-name|" +
    "animation-duration|animation-delay|animation-timing-function|animation-iteration-count|" +
    "animation-direction|animation-fill-mode|animation-play-state|transform-origin|transform-box|" +
    "transform-style|transform|translate|scale|rotate|box-geometry-raw-tokens|box-geometry-unresolved|image-rendering|object-fit|object-position|" +
    "padding-left|padding-top|padding-right|" +
    "padding-bottom|margin-left|margin-right|margin-top|margin-bottom|border-left-width|border-left-style|" +
    "border-radius|border-top-left-radius|border-top-right-radius|border-bottom-right-radius|" +
    "border-bottom-left-radius|border-top-width|border-right-width|border-right-style|border-bottom-width|" +
    "border-top-color|border-right-color|border-bottom-color|border-left-color|outline-width|outline-color|" +
    "outline-offset|z-index|visibility|content-visibility|will-change|color-adjust|forced-color-adjust|" +
    "print-color-adjust|orphans|widows|box-shadow-layer-schema|"

pub val WEB_OPAQUE_REQUIRED_PAINT_KEYS: text =
    "|background-gradient-stop-count|background-gradient-stops|background-gradient-is-radial|" +
    "background-color|background-image|background-layers-raw|box-shadow|box-shadow-raw|" +
    "box-shadow-layer-count|box-shadow-blur-radius|backdrop-filter|backdrop-filter-capability|" +
    "backdrop-filter-fallback|border-left-width|border-top-width|border-right-width|border-bottom-width|" +
    "border-radius|border-top-left-radius|border-top-right-radius|border-bottom-right-radius|" +
    "border-bottom-left-radius|outline-width|outline-offset|visibility|content-visibility|" +
    "animation-name|transition-property|transform|translate|scale|rotate|box-geometry-raw-tokens|box-geometry-unresolved|box-shadow-layer-schema|"

fn _web_style_neutral(key: text, value: text, color: u32) -> bool:
    if key == "background-color":
        return value == "{color}"
    if key == "background-gradient-stop-count" or
        key == "background-gradient-is-radial" or
        key == "background-size-width" or key == "background-size-height" or
        key == "background-position-x" or key == "background-position-y" or
        key == "box-shadow-layer-count" or key == "box-shadow-blur-radius" or
        key == "border-left-width" or key == "border-top-width" or
        key == "border-right-width" or key == "border-bottom-width" or
        key == "border-radius" or key == "border-top-left-radius" or
        key == "border-top-right-radius" or
        key == "border-bottom-right-radius" or
        key == "border-bottom-left-radius" or key == "outline-width" or
        key == "outline-offset":
        return value == "0"
    if key == "background-gradient-stops" or
        key == "background-layers-raw" or key == "box-shadow-raw":
        return value == ""
    if key == "background-image" or key == "box-shadow" or
        key == "backdrop-filter" or key == "backdrop-filter-fallback" or
        key == "backdrop-filter-fallback-reason" or
        key == "text-decoration-line" or key == "text-shadow" or
        key == "transition-property" or key == "animation-name":
        return value == "none"
    if key == "backdrop-filter-capability":
        return value == "not-requested"
    if key == "box-shadow-layer-schema":
        return value == "web-box-shadow-layers-v1"
    if key == "border-left-style" or key == "border-right-style":
        return value == "none"
    if key == "visibility" or key == "content-visibility":
        return value == "visible"
    if key == "transform-style":
        return value == "flat"
    if key == "transform" or key == "translate" or
        key == "scale" or key == "rotate":
        return value == "none"
    if key == "box-geometry-unresolved": return value == "false"
    if key == "transition-duration" or key == "transition-delay" or
        key == "animation-duration" or key == "animation-delay":
        return value == "0ms"
    if key == "will-change" or key == "forced-color-adjust":
        return value == "auto"
    if key == "color-adjust" or key == "print-color-adjust":
        return value == "economy"
    if key == "background-clip":
        return value == "border-box"
    if key == "background-origin":
        return value == "padding-box"
    if key == "background-attachment":
        return value == "scroll"
    if key == "background-repeat":
        return value == "repeat"
    if key == "display":
        return value == "block"
    # Remaining classified properties influence resolved layout, text, images,
    # or nonpainting interaction. This lane admits only rect commands and
    # checks resolved geometry, all paint controls, and the raw Style below.
    true

fn _web_style_reason(command: DrawIrCommand, index: i64) -> text:
    if command.component_id == "html-canvas":
        if command.computed_style.len() == 0:
            return ""
        return "unhandled-canvas-style:{index}"
    var seen: Dict<text, bool> = {}
    for prop in command.computed_style:
        if not WEB_OPAQUE_STYLE_KEYS.contains("|{prop.key}|"):
            return "unhandled-paint-style-key:{index}:{prop.key}"
        if seen.get(prop.key) ?? false:
            return "duplicate-paint-style-key:{index}:{prop.key}"
        seen[prop.key] = true
        if not _web_style_neutral(prop.key, prop.value, command.color):
            return "unhandled-paint-style-value:{index}:{prop.key}"
    for key in WEB_OPAQUE_REQUIRED_PAINT_KEYS.split("|"):
        if key != "" and not (seen.get(key) ?? false):
            return "missing-paint-style-key:{index}:{key}"
    ""

fn _plain_opaque_rect_reason_extent(command: DrawIrCommand,
    index: i64, width: i32, height: i32) -> text:
    if draw_ir_command_has_unsupported_v4_state(command):
        return "web-v4-command-state-unhandled:{index}"
    if command.kind != DRAW_IR_COMMAND_RECT:
        return "unhandled-command-kind:{index}:{command.kind}"
    if command.fractional_geometry != nil or command.edge != nil or
        command.points.len() != 0 or command.image_uri != "" or
        command.text_value != "" or command.advance_widths.len() != 0 or
        command.glyph_run.valid or
        command.glyph_run.glyph_ids.len() != 0 or
        command.glyph_run.xs.len() != 0 or
        command.glyph_run.ys.len() != 0 or
        command.glyph_run.clusters.len() != 0:
        return "unhandled-command-payload:{index}"
    if command.width <= 0 or command.height <= 0 or
        command.x < 0 or command.y < 0 or
        command.x.to_i64() + command.width.to_i64() > width.to_i64() or
        command.y.to_i64() + command.height.to_i64() > height.to_i64():
        return "unhandled-command-geometry:{index}"
    if ((command.color >> 24) & 255u32) != 255u32:
        return "unhandled-command-alpha:{index}"
    if not command.clip_rect.present or command.clip_rect.x != 0 or
        command.clip_rect.y != 0 or command.clip_rect.width != width or
        command.clip_rect.height != height:
        return "unhandled-command-clip:{index}"
    _web_style_reason(command, index)

fn _plain_opaque_rect_reason(command: DrawIrCommand,
    index: i64) -> text:
    _plain_opaque_rect_reason_extent(command, index, 16, 16)

fn _web_raw_style_reason_with_case02(
    st: Style, command: DrawIrCommand, index: i64,
    allow_full_scene_overflow: bool, allow_transform: bool,
    allow_unresolved_geometry: bool
) -> text:
    if st.bg != command.color or st.opacity_pct != 100 or
        st.background_image_uri != "" or st.bg_layers_raw != "" or
        st.background_gradient_from != 0u32 or
        st.background_gradient_to != 0u32 or
        st.background_gradient_stop_colors.len() != 0 or
        st.background_gradient_stop_positions.len() != 0 or
        st.background_gradient_is_radial or
        st.box_shadow_raw != "" or st.box_shadow_color != 0u32 or
        st.box_shadow_blur_px != 0 or st.box_shadow_x_px != 0 or
        st.box_shadow_y_px != 0 or st.backdrop_filter_raw != "" or
        st.border_w != 0 or st.border_l != 0 or st.border_t != 0 or
        st.border_r != 0 or st.border_b != 0 or
        st.border_radius_px != 0 or st.border_radius_tl_px != 0 or
        st.border_radius_tr_px != 0 or st.border_radius_br_px != 0 or
        st.border_radius_bl_px != 0 or st.outline_w != 0 or
        st.outline_offset_px != 0 or st.pad_l != 0 or
        st.pad_t != 0 or st.pad_r != 0 or st.pad_b != 0 or
        (st.overflow_hidden and not allow_full_scene_overflow) or
        st.overflow_auto_y or st.overflow_scroll_y or
        st.visibility_hidden or st.content_visibility_hidden or
        st.position_fixed or st.position_sticky or
        st.transform_style != "flat" or
        st.transform_origin != "center center" or
        st.transform_box != "border-box" or
        (st.transform_raw != "none" and not allow_transform) or
        st.translate_raw != "none" or
        st.scale_raw != "none" or st.rotate_raw != "none" or
        (st.box_geometry_unresolved and not allow_unresolved_geometry):
        return "web-layout-raw-paint-state-unhandled:{index}"
    if allow_full_scene_overflow and not st.overflow_hidden:
        return "web-layout-scene-overflow-state-missing:{index}"
    ""

fn _web_raw_style_reason(st: Style, command: DrawIrCommand,
    index: i64, allow_full_scene_overflow: bool) -> text:
    _web_raw_style_reason_with_case02(
        st, command, index, allow_full_scene_overflow, false, false)
