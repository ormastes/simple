# Retained-composition support for the Simple web renderer facade: hit-test
# index, scrolled-layout helpers, material provenance witnesses, CSS animation
# scheduling, fractional-opacity nesting and the GPU paint-state helpers.
# Split out of simple_web_html_layout_renderer.spl, which re-exports every
# name defined here.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_geometry.{compute_styles, extract_css_vw, SIMPLE_WEB_STICKY_TOP_AUTO, Style, split_top_level_commas, shadow_length_prefix, web_canvas_background_authored, build_ancestor_clip_cache, paint_clip_at, input_accepts_text_overlay, input_text_paint_plan, input_text_paint_plan_with_overlay, paint, paint_tiled, layout, web_html_layout_tree, LayoutResult, TextWrapCache, zero_i32_list, neg_one_i32_list, shifted_i32_list, empty_i32_lists, browser_layout_framebuffer_filled}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_geometry.{_SimpleWebAnimationFrameIndex, _SimpleWebAnimationSchedule}
use std.nogc_sync_mut.ui.host_frame_clock.{default_frame_clock}
use std.gc_async_mut.gpu.engine2d.css_opacity_group.{css_opacity_group_surface_id}
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU, DrawIrBatch, DrawIrCommand, DrawIrComposition, DrawIrEmbeddingConfig, DrawIrSourceInfo, draw_ir_batch_with_source, draw_ir_embedding_config}
use std.common.web.browser_renderer_protocol.{BrowserTextInputOverlay}
use common.render_scene.scene.{SceneCommand, scene_fill_rect}
use common.ui.web_render_api.{WebRenderMaterialFallbackProvenance}
use std.common.crypto.sha256.{sha256_text}
use std.common.color.types.{from_rgba}
use std.common.animation.timing.{parse_timing_function}
use std.gc_async_mut.gpu.browser_engine.style_block_parse.{KeyframeRegistry}
use std.gc_async_mut.gpu.browser_engine.style.animation.{BrowserCssAnimationInstance, CSSValue, browser_css_animation_capacity_available}

pub struct SimpleWebInputTextHitMap:
    target_key: text
    x: i32
    y: i32
    width: i32
    height: i32
    source_boundary_bytes: [i64]
    boundary_x_px: [i32]

class SimpleWebLayoutHitIndex:
    nodes: [HNode]
    styles: [Style]
    child_index: HtmlChildIndex
    boxes: LayoutResult
    width: i32
    height: i32
    input_text_hits: [SimpleWebInputTextHitMap]

pub enum SimpleWebElementScrollReason:
    None
    EmptyElementId
    ElementNotFound
    ElementNotScrollContainer
    ElementHasNoLayoutBox
    FixedDescendantUnsupported
    NoScrollRange
    ClampedToScrollRange
    RenderDegraded

pub fn simple_web_element_scroll_reason_text(
    reason: SimpleWebElementScrollReason
) -> text:
    if reason == SimpleWebElementScrollReason.EmptyElementId:
        return "empty-element-id"
    if reason == SimpleWebElementScrollReason.ElementNotFound:
        return "element-not-found"
    if reason == SimpleWebElementScrollReason.ElementNotScrollContainer:
        return "element-not-scroll-container"
    if reason == SimpleWebElementScrollReason.ElementHasNoLayoutBox:
        return "element-has-no-layout-box"
    if reason == SimpleWebElementScrollReason.FixedDescendantUnsupported:
        return "fixed-descendant-unsupported"
    if reason == SimpleWebElementScrollReason.NoScrollRange:
        return "no-scroll-range"
    if reason == SimpleWebElementScrollReason.ClampedToScrollRange:
        return "clamped-to-scroll-range"
    if reason == SimpleWebElementScrollReason.RenderDegraded:
        return "render-degraded"
    ""

pub class SimpleWebElementScrollState:
    requested_id: text
    resolved_id: text
    requested_top: i32
    resolved_top: i32
    max_top: i32
    # One of not-requested, applied, unsupported, degraded.
    status: text
    reason: SimpleWebElementScrollReason
    # The WEB_BUDGET_SITE_* value when reason is RenderDegraded.
    degrade_detail: text

pub fn simple_web_layout_hit_test_index(
    index: SimpleWebLayoutHitIndex, x: i32, y: i32
) -> text:
    _simple_web_hit_target_key(
        index.nodes, index.styles, index.child_index, index.boxes,
        index.width, index.height, x, y
    )

fn _simple_web_root_sticky_admitted(
    nodes: [HNode], node_index: i32
) -> bool:
    var ancestor = nodes[node_index].parent as i32
    while ancestor >= 0 and ancestor < nodes.len():  # cpu-lane-loop-ok: ancestor walk that bails at the first non-root/html/body ancestor; bound is tree depth, not an element count - flagged by the gate's any-loop-header approximation of the design's bound-based rule
        val tag = nodes[ancestor].tag
        if tag != "#root" and tag != "html" and tag != "body":
            return false
        ancestor = nodes[ancestor].parent as i32
    true

class _SimpleWebScrolledLayout:
    boxes: LayoutResult
    resolved_scroll_y: i32
    max_scroll_y: i32

class _SimpleWebElementScrolledLayout:
    boxes: LayoutResult
    state: SimpleWebElementScrollState
    selected_index: i32

fn _simple_web_scrolled_layout(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    viewport_width: i32, viewport_height: i32, scroll_y: i32
) -> _SimpleWebScrolledLayout:
    var raw_bottom = boxes.height.to_i64()
    var i = 0
    while i < boxes.by.len():  # cpu-lane-loop-ok: first of two box passes: computes the raw document bottom; bound is the box count (== node_count), once per compose
        val bottom = boxes.by[i].to_i64() + boxes.bh[i].to_i64()
        if bottom > raw_bottom:
            raw_bottom = bottom
        i = i + 1
    val extent_height = if raw_bottom > 2147483647:
        2147483647
    elif raw_bottom > viewport_height.to_i64():
        raw_bottom.to_i32()
    else:
        viewport_height
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        viewport_width, extent_height
    )

    var content_bottom = viewport_height.to_i64()
    i = 0
    while i < boxes.by.len():  # cpu-lane-loop-ok: second box pass: clips each box against its ancestor clip for the scrollable content bottom; needs the clip cache derived from pass one so it cannot be merged; bound is the box count
        val clip = paint_clip_at(clip_cache, i)
        val node_x0 = boxes.bx[i].to_i64()
        val node_y0 = boxes.by[i].to_i64()
        val node_x1 = node_x0 + boxes.bw[i].to_i64()
        val node_y1 = node_y0 + boxes.bh[i].to_i64()
        if (node_x1 > clip.x0.to_i64() and node_x0 < clip.x1.to_i64() and
            node_y1 > clip.y0.to_i64() and node_y0 < clip.y1.to_i64()):
            val clipped_bottom = if node_y1 < clip.y1.to_i64():
                node_y1
            else:
                clip.y1.to_i64()
            if clipped_bottom > content_bottom:
                content_bottom = clipped_bottom
        i = i + 1
    var max_scroll = content_bottom - viewport_height.to_i64()
    if max_scroll < 0:
        max_scroll = 0
    var resolved = if scroll_y > 0: scroll_y.to_i64() else: 0
    if resolved > max_scroll:
        resolved = max_scroll
    var has_top_sticky = false
    var has_top_sticky_index = 0
    while has_top_sticky_index < styles.len():  # cpu-lane-loop-ok: scans styles for a root-scroll top-inset sticky box; bound is the style count (== node_count), once per compose
        val style = styles[has_top_sticky_index]
        if (
            style.position_sticky and
            style.top_px != SIMPLE_WEB_STICKY_TOP_AUTO and
            _simple_web_root_sticky_admitted(nodes, has_top_sticky_index)
        ):
            has_top_sticky = true
        has_top_sticky_index = has_top_sticky_index + 1
    var shifted_by = if resolved == 0 and not has_top_sticky:
        boxes.by
    else:
        shifted_i32_list(boxes.by, 0 - resolved.to_i32())
    if has_top_sticky:
        # ponytail: root-scroll/top-inset sticky only; add scroll-container
        # bounds and other inset axes when those conformance slices land.
        var subtree_delta: [i32] = [0; nodes.len()]
        var has_sticky_ancestor: [bool] = [false; nodes.len()]
        var node_index = 0
        while node_index < styles.len():  # cpu-lane-loop-ok: top-down sticky-shift pass propagating subtree deltas from the parent entry; bound is the style count, runs only when a top sticky box exists
            val parent = nodes[node_index].parent as i32
            val inherited_delta = if parent >= 0:
                subtree_delta[parent]
            else:
                0
            val nested = if parent >= 0:
                has_sticky_ancestor[parent] or styles[parent].position_sticky
            else:
                false
            shifted_by[node_index] = (
                shifted_by[node_index] + inherited_delta
            )
            var own_delta = 0
            val style = styles[node_index]
            if (
                not nested and style.position_sticky and
                style.top_px != SIMPLE_WEB_STICKY_TOP_AUTO and
                _simple_web_root_sticky_admitted(nodes, node_index) and
                shifted_by[node_index] < style.top_px
            ):
                own_delta = style.top_px - shifted_by[node_index]
                shifted_by[node_index] = style.top_px
            subtree_delta[node_index] = inherited_delta + own_delta
            has_sticky_ancestor[node_index] = nested
            node_index = node_index + 1
    val shifted = LayoutResult(
        bx: boxes.bx,
        by: shifted_by,
        bw: boxes.bw,
        bh: boxes.bh,
        wrap_starts: boxes.wrap_starts,
        wrap_ends: boxes.wrap_ends,
        intrinsic_widths: boxes.intrinsic_widths,
        height: boxes.height,
        first_line_dx: boxes.first_line_dx,
        line_boxes: boxes.line_boxes,
        pen_origin_milli: boxes.pen_origin_milli,
        device_dy: boxes.device_dy,
        device_dy_rest: boxes.device_dy_rest,
        device_top: boxes.device_top
    )
    _SimpleWebScrolledLayout(
        boxes: shifted,
        resolved_scroll_y: resolved.to_i32(),
        max_scroll_y: max_scroll.to_i32()
    )

fn _simple_web_element_scrolled_layout(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    requested: bool, element_id: text, scroll_top: i32
) -> _SimpleWebElementScrolledLayout:
    if not requested:
        return _SimpleWebElementScrolledLayout(
            boxes: boxes, selected_index: -1,
            state: SimpleWebElementScrollState(
                requested_id: "", resolved_id: "", requested_top: 0,
                resolved_top: 0, max_top: 0,
                status: "not-requested",
                reason: SimpleWebElementScrollReason.None,
                degrade_detail: ""
            )
        )
    var selected = -1
    if element_id != "":
        var find_index = 0
        while find_index < nodes.len():  # cpu-lane-loop-ok: one id lookup over DOM nodes, bounded by node count
            if nodes[find_index].id_attr == element_id:
                selected = find_index
                break
            find_index = find_index + 1
    val unsupported_reason = if element_id == "":
        SimpleWebElementScrollReason.EmptyElementId
    elif selected < 0:
        SimpleWebElementScrollReason.ElementNotFound
    elif not styles[selected].overflow_auto_y and
        not styles[selected].overflow_scroll_y:
        SimpleWebElementScrollReason.ElementNotScrollContainer
    elif boxes.bw[selected] <= 0 or boxes.bh[selected] <= 0:
        SimpleWebElementScrollReason.ElementHasNoLayoutBox
    else:
        SimpleWebElementScrollReason.None
    if unsupported_reason != SimpleWebElementScrollReason.None:
        return _SimpleWebElementScrolledLayout(
            boxes: boxes, selected_index: -1,
            state: SimpleWebElementScrollState(
                requested_id: element_id, resolved_id: "",
                requested_top: scroll_top, resolved_top: 0, max_top: 0,
                status: "unsupported", reason: unsupported_reason,
                degrade_detail: ""
            )
        )
    # A viewport-fixed descendant does not move with an element scrollport.
    # The current paint path has one translated layout box per descendant,
    # so reject that tree until fixed containing blocks are represented.
    var inside: [bool] = [false; nodes.len()]
    var scan_index = 0
    while scan_index < nodes.len():  # cpu-lane-loop-ok: one parent-first descendant preflight, bounded by node count
        val parent = nodes[scan_index].parent as i32
        if parent >= 0:
            inside[scan_index] = parent == selected or inside[parent]
            if inside[scan_index] and styles[scan_index].position_fixed:
                return _SimpleWebElementScrolledLayout(
                    boxes: boxes, selected_index: -1,
                    state: SimpleWebElementScrollState(
                        requested_id: element_id, resolved_id: element_id,
                        requested_top: scroll_top, resolved_top: 0, max_top: 0,
                        status: "unsupported",
                        reason: SimpleWebElementScrollReason.FixedDescendantUnsupported,
                        degrade_detail: ""
                    )
                )
        scan_index = scan_index + 1
    val descendants = _html_draw_ir_descendant_bottom(nodes, styles, boxes)
    val inner_bottom = (
        boxes.by[selected].to_i64() + boxes.bh[selected].to_i64() -
        styles[selected].border_b.to_i64()
    )
    var max_top = descendants[selected] - inner_bottom
    if max_top < 0:
        max_top = 0
    if max_top > 2147483647:
        max_top = 2147483647
    var resolved = if scroll_top > 0: scroll_top.to_i64() else: 0i64
    if resolved > max_top:
        resolved = max_top
    if scroll_top > 0 and max_top == 0:
        return _SimpleWebElementScrolledLayout(
            boxes: boxes, selected_index: selected,
            state: SimpleWebElementScrollState(
                requested_id: element_id, resolved_id: element_id,
                requested_top: scroll_top, resolved_top: 0, max_top: 0,
                status: "unsupported",
                reason: SimpleWebElementScrollReason.NoScrollRange,
                degrade_detail: ""
            )
        )
    # Keep raw layout coordinates intact for extent and source evidence.
    # Copy explicitly before mutating descendant positions.
    var shifted_by: [i32] = []
    for original_y in boxes.by:  # cpu-lane-loop-ok: one copy per layout box, bounded by node count
        shifted_by.push(original_y)
    var inner_scroll_ancestor: [bool] = [false; nodes.len()]
    var sticky_subtree_delta: [i32] = [0; nodes.len()]
    var i = 0
    while i < nodes.len():  # cpu-lane-loop-ok: one top-down descendant translation and sticky pass, bounded by node count
        val parent = nodes[i].parent as i32
        if parent >= 0:
            if inside[i]:
                val inherited = sticky_subtree_delta[parent]
                val shifted_y = (
                    boxes.by[i].to_i64() - resolved + inherited.to_i64()
                )
                shifted_by[i] = _html_draw_ir_saturated_i32(shifted_y)
                inner_scroll_ancestor[i] = if parent == selected:
                    false
                else:
                    inner_scroll_ancestor[parent] or
                    styles[parent].overflow_auto_y or
                    styles[parent].overflow_hidden
                var own_delta = 0
                if (
                    styles[i].position_sticky and
                    styles[i].top_px != SIMPLE_WEB_STICKY_TOP_AUTO and
                    not inner_scroll_ancestor[i]
                ):
                    val sticky_top = (
                        boxes.by[selected].to_i64() +
                        styles[selected].border_t.to_i64() +
                        styles[i].top_px.to_i64()
                    )
                    val parent_bottom = (
                        shifted_by[parent].to_i64() +
                        boxes.bh[parent].to_i64() -
                        styles[parent].border_b.to_i64() -
                        boxes.bh[i].to_i64()
                    )
                    var target_y = sticky_top
                    if target_y > parent_bottom:
                        target_y = parent_bottom
                    if target_y > shifted_by[i].to_i64():
                        val sticky_y = _html_draw_ir_saturated_i32(target_y)
                        own_delta = sticky_y - shifted_by[i]
                        shifted_by[i] = sticky_y
                sticky_subtree_delta[i] = inherited + own_delta
        i = i + 1
    val shifted = LayoutResult(
        bx: boxes.bx, by: shifted_by, bw: boxes.bw, bh: boxes.bh,
        wrap_starts: boxes.wrap_starts, wrap_ends: boxes.wrap_ends,
        intrinsic_widths: boxes.intrinsic_widths, height: boxes.height,
        first_line_dx: boxes.first_line_dx,
        line_boxes: boxes.line_boxes,
        pen_origin_milli: boxes.pen_origin_milli,
        device_dy: boxes.device_dy,
        device_dy_rest: boxes.device_dy_rest,
        device_top: boxes.device_top
    )
    val applied_reason = if resolved != scroll_top.to_i64():
        SimpleWebElementScrollReason.ClampedToScrollRange
    else:
        SimpleWebElementScrollReason.None
    _SimpleWebElementScrolledLayout(
        boxes: shifted, selected_index: selected,
        state: SimpleWebElementScrollState(
            requested_id: element_id, resolved_id: element_id,
            requested_top: scroll_top, resolved_top: resolved.to_i32(),
            max_top: max_top.to_i32(), status: "applied",
            reason: applied_reason,
            degrade_detail: ""
        )
    )

class SimpleWebLayoutMaterialWitness:
    cpu_composited_count: i32
    cpu_composited_sha256: text
    solid_material_count: i32
    solid_material_sha256: text

struct _SimpleWebInputTextHitBuild:
    target_keys: [text]
    hits: [SimpleWebInputTextHitMap]
    resolved_view_start_byte: i64

fn _simple_web_input_text_hit_build(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, width: i32, height: i32,
    overlay: BrowserTextInputOverlay
) -> _SimpleWebInputTextHitBuild:
    var target_keys: [text] = [""; nodes.len()]
    var hits: [SimpleWebInputTextHitMap] = []
    var resolved_view_start_byte = overlay.view_start_byte
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        width, height
    )
    var i = 0
    while i < nodes.len():  # cpu-lane-loop-ok: one pass over nodes building the text-input hit map; bound is node_count and the target-key/paint-plan work fires only for <input> elements
        if (
            nodes[i].tag == "input" and
            input_accepts_text_overlay(nodes[i]) and
            styles[i].display != "none" and
            not styles[i].visibility_hidden and
            boxes.bw[i] > 0 and boxes.bh[i] > 0
        ):
            val target_key = _simple_web_node_target_key(
                nodes, child_index, i
            )
            target_keys[i] = target_key
            val plan = if target_key == overlay.target_key:
                input_text_paint_plan_with_overlay(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    paint_clip_at(clip_cache, i), overlay
                )
            else:
                input_text_paint_plan(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    paint_clip_at(clip_cache, i)
                )
            if target_key == overlay.target_key:
                resolved_view_start_byte = plan.resolved_view_start_byte
            hits.push(SimpleWebInputTextHitMap(
                target_key: target_key,
                x: plan.clip.x0,
                y: plan.clip.y0,
                width: plan.clip.x1 - plan.clip.x0,
                height: plan.clip.y1 - plan.clip.y0,
                source_boundary_bytes: plan.source_boundary_bytes,
                boundary_x_px: plan.boundary_x_px
            ))
        i = i + 1
    _SimpleWebInputTextHitBuild(
        target_keys: target_keys,
        hits: hits,
        resolved_view_start_byte: resolved_view_start_byte
    )

# reason: moved verbatim from simple_web_html_layout_renderer.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn simple_web_layout_material_provenance_after_execution(witness: SimpleWebLayoutMaterialWitness, skipped_command_count: i32, pixel_count: i32, expected_pixel_count: i32, executed_cpu_material_count: i32) -> WebRenderMaterialFallbackProvenance:
    simple_web_layout_material_provenance_after_backend_execution(
        witness,
        skipped_command_count,
        pixel_count,
        expected_pixel_count,
        executed_cpu_material_count,
        0,
        "",
        "",
        0,
        0
    )

pub fn simple_web_layout_material_provenance_after_backend_execution(
    witness: SimpleWebLayoutMaterialWitness,
    skipped_command_count: i32,
    pixel_count: i32,
    expected_pixel_count: i32,
    executed_cpu_material_count: i32,
    executed_metal_material_count: i32,
    glass_execution_target: text,
    readback_source: text,
    glass_backend_handle: i64,
    glass_device_identity: i64
) -> WebRenderMaterialFallbackProvenance:
    if skipped_command_count != 0 or pixel_count != expected_pixel_count:
        if witness.cpu_composited_count > 0 or witness.solid_material_count > 0:
            print "[web-material-provenance] witness-dropped-at-integrity-gate skipped={skipped_command_count} pixels={pixel_count} expected={expected_pixel_count} cpu_witness={witness.cpu_composited_count} solid_witness={witness.solid_material_count}"
        return WebRenderMaterialFallbackProvenance.none()
    if witness.cpu_composited_count > 0:
        if (witness.cpu_composited_count ==
                executed_metal_material_count and
            executed_cpu_material_count == 0 and
            glass_execution_target == "metal-device-glass-v1" and
            readback_source == "device_readback" and
            glass_backend_handle > 0 and glass_device_identity > 0 and
            witness.cpu_composited_sha256.len() == 64):
            return WebRenderMaterialFallbackProvenance.metal_device_composited(
                witness.cpu_composited_sha256)
        if (witness.cpu_composited_count == executed_cpu_material_count and
            executed_metal_material_count == 0 and
            witness.cpu_composited_sha256.len() == 64):
            return WebRenderMaterialFallbackProvenance.cpu_composited(
                witness.cpu_composited_sha256)
        # Defect signal, bounded (fires only when a realized witness fails to
        # convert): names the exact mismatch instead of a silent kind="none".
        print "[web-material-provenance] witness-unconverted cpu_witness={witness.cpu_composited_count} cpu_executed={executed_cpu_material_count} metal_executed={executed_metal_material_count} sha_len={witness.cpu_composited_sha256.len()} target={glass_execution_target} readback={readback_source}"
        return WebRenderMaterialFallbackProvenance.none()
    if (executed_cpu_material_count != 0 or
        executed_metal_material_count != 0):
        # Executed material with NO witness: the sidecar channel lost the
        # entries between the style pass and this decision. Bounded defect
        # signal, same rationale as witness-unconverted above.
        print "[web-material-provenance] executed-without-witness cpu_executed={executed_cpu_material_count} metal_executed={executed_metal_material_count} solid_witness={witness.solid_material_count}"
        return WebRenderMaterialFallbackProvenance.none()
    if (witness.solid_material_count > 0 and
        witness.solid_material_sha256.len() == 64):
        return WebRenderMaterialFallbackProvenance.solid(
            "cpu-raster-backdrop-sampling-unavailable",
            witness.solid_material_sha256)
    WebRenderMaterialFallbackProvenance.none()

# reason: moved verbatim from simple_web_html_layout_renderer.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn simple_web_material_fallback_realized(declared: bool, bg: u32, gradient_from: u32, gradient_to: u32, layers_raw: text) -> bool:
    declared and ((bg >> 24) & 255u32) == 255u32 and gradient_from == 0u32 and gradient_to == 0u32 and layers_raw == ""

fn _simple_web_material_witness_from_sidecar(
    entries: [text], counts: [i64]
) -> SimpleWebLayoutMaterialWitness:
    if entries.len() < 2 or counts.len() < 2:
        return SimpleWebLayoutMaterialWitness(
            cpu_composited_count: 0,
            cpu_composited_sha256: "",
            solid_material_count: 0,
            solid_material_sha256: "")
    val cpu_count = counts[0]
    val solid_count = counts[1]
    SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_count as i32,
        cpu_composited_sha256:
            if cpu_count > 0: sha256_text(entries[0]) else: "",
        solid_material_count: solid_count as i32,
        solid_material_sha256:
            if solid_count > 0: sha256_text(entries[1]) else: "")

fn _simple_web_visible_material_witness(
    entries: [text], cpu_nodes: [i32], solid_nodes: [i32],
    visible_nodes: [bool]
) -> SimpleWebLayoutMaterialWitness:
    if entries.len() < 2:
        return _simple_web_material_witness_from_sidecar([], [])
    val cpu_lines = entries[0].split("\n")
    val solid_lines = entries[1].split("\n")
    var cpu_filtered: [text] = [""; cpu_lines.len()]
    var solid_filtered: [text] = [""; solid_lines.len()]
    cpu_filtered[0] = cpu_lines[0]
    solid_filtered[0] = solid_lines[0]
    var cpu_filtered_count = 1
    var solid_filtered_count = 1
    var counts: [i64] = [0, 0]
    var i = 0
    while i < cpu_nodes.len() and i + 1 < cpu_lines.len():  # cpu-lane-loop-ok: filters the cpu-composited material sidecar down to visible nodes; bound is the recorded cpu material node count, not the document
        val node = cpu_nodes[i]
        if node >= 0 and node < visible_nodes.len() and visible_nodes[node]:
            cpu_filtered[cpu_filtered_count] = cpu_lines[i + 1]
            cpu_filtered_count = cpu_filtered_count + 1
            counts[0] = counts[0] + 1
        i = i + 1
    i = 0
    while i < solid_nodes.len() and i + 1 < solid_lines.len():  # cpu-lane-loop-ok: same filter for the solid material sidecar; bound is the recorded solid material node count
        val node = solid_nodes[i]
        if node >= 0 and node < visible_nodes.len() and visible_nodes[node]:
            solid_filtered[solid_filtered_count] = solid_lines[i + 1]
            solid_filtered_count = solid_filtered_count + 1
            counts[1] = counts[1] + 1
        i = i + 1
    _simple_web_material_witness_from_sidecar(
        [
            cpu_filtered.slice(0, cpu_filtered_count).join("\n"),
            solid_filtered.slice(0, solid_filtered_count).join("\n")
        ],
        counts
    )

fn _animation_direction_progress(progress: f64, direction: text, iteration: i64) -> f64:
    if direction == "reverse":
        return 1.0 - progress
    if direction == "alternate" and iteration % 2 != 0:
        return 1.0 - progress
    if direction == "alternate-reverse" and iteration % 2 == 0:
        return 1.0 - progress
    progress

fn _animation_direction_is_forwards(direction: text, iteration: i64) -> bool:
    if direction == "reverse":
        return false
    if direction == "alternate":
        return iteration % 2 == 0
    if direction == "alternate-reverse":
        return iteration % 2 != 0
    true

fn _css_animation_signature(st: Style) -> text:
    (
        st.animation_name + "\u001f" +
        st.animation_duration_ms.to_text() + "\u001f" +
        st.animation_delay_ms.to_text() + "\u001f" +
        st.animation_timing_function + "\u001f" +
        st.animation_iteration_count + "\u001f" +
        st.animation_direction + "\u001f" +
        st.animation_fill_mode
    )

val CSS_ANIMATION_MAX_TIME_MS: i64 = 9223372036854775807
val CSS_ANIMATION_MIN_TIME_MS: i64 = -9223372036854775808

fn _css_animation_iteration_count(raw: text) -> f64:
    if raw == "infinite":
        return -1.0
    if val parsed = parse_animation_iteration_number_token(raw):
        return parsed
    1.0

fn _css_animation_add_ms_no_wrap(base_ms: i64, delta_ms: i64) -> i64:
    if (
        delta_ms > 0 and
        base_ms > CSS_ANIMATION_MAX_TIME_MS - delta_ms
    ):
        return CSS_ANIMATION_MAX_TIME_MS
    if (
        delta_ms < 0 and
        base_ms < CSS_ANIMATION_MIN_TIME_MS - delta_ms
    ):
        return CSS_ANIMATION_MIN_TIME_MS
    base_ms + delta_ms

fn _css_animation_sub_ms_no_wrap(base_ms: i64, delta_ms: i64) -> i64:
    if (
        delta_ms > 0 and
        base_ms < CSS_ANIMATION_MIN_TIME_MS + delta_ms
    ):
        return CSS_ANIMATION_MIN_TIME_MS
    if (
        delta_ms < 0 and
        base_ms > CSS_ANIMATION_MAX_TIME_MS + delta_ms
    ):
        return CSS_ANIMATION_MAX_TIME_MS
    base_ms - delta_ms

fn _css_animation_active_duration_ms(
    duration_ms: i64, iteration_count: f64
) -> i64:
    if iteration_count < 0.0:
        return -1
    val active_duration = duration_ms.to_f64() * iteration_count
    if (
        active_duration != active_duration or
        active_duration > CSS_ANIMATION_MAX_FINITE_ITERATIONS
    ):
        return CSS_ANIMATION_MAX_TIME_MS
    if active_duration <= 0.0:
        return 0
    active_duration.ceil().to_i64()

fn _css_animation_next_frame_ms(current_time_ms: i64) -> i64:
    val next_ms = _css_animation_add_ms_no_wrap(current_time_ms, 16)
    if next_ms <= current_time_ms:
        return -1
    next_ms

fn _simple_web_animation_frame_index(
    styles: [Style], nodes: [HNode], child_index: HtmlChildIndex,
    registry: KeyframeRegistry,
    instances: [BrowserCssAnimationInstance], include_signatures: bool
) -> _SimpleWebAnimationFrameIndex:
    val target_keys = _simple_web_animation_target_keys(nodes, child_index)
    var signatures: [text] = if include_signatures:
        [""; styles.len()]
    else:
        []
    var style_index = 0
    while style_index < styles.len():  # cpu-lane-loop-ok: optional animation-signature pass over styles; bound is the style count and only the reconcile caller requests signatures
        if (include_signatures and
            styles[style_index].animation_name != "none" and
            styles[style_index].animation_duration_ms > 0
        ):
            signatures[style_index] = _css_animation_signature(
                styles[style_index]
            )
        style_index = style_index + 1

    var keyframes_by_name: Dict<text, i32> = {}
    var keyframe_index = 0
    while keyframe_index < registry.entries.len():  # cpu-lane-loop-ok: builds the keyframe-name to index dict; bound is the declared @keyframes count
        keyframes_by_name[registry.entries[keyframe_index].name] = (
            keyframe_index
        )
        keyframe_index = keyframe_index + 1

    var instances_by_target: Dict<text, i32> = {}
    var instance_index = 0
    while instance_index < instances.len():  # cpu-lane-loop-ok: builds the target-key to instance index dict; bound is the live animation instance count (capacity-capped)
        instances_by_target[instances[instance_index].target_key] = (
            instance_index
        )
        instance_index = instance_index + 1
    _SimpleWebAnimationFrameIndex(
        target_keys: target_keys,
        signatures: signatures,
        keyframes_by_name: keyframes_by_name,
        instances_by_target: instances_by_target
    )

pub fn simple_web_layout_reconcile_animation_instances(
    html: text, width: i32, current_time_ms: i64,
    new_epoch_ms: i64, reset_descendants: bool,
    previous: [BrowserCssAnimationInstance]
) -> [BrowserCssAnimationInstance]:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val registry = _simple_web_extract_keyframes(html)
    if registry.entries.len() == 0:
        return []
    val frame_index = _simple_web_animation_frame_index(
        styles, nodes, child_index, registry, previous, true
    )
    var reconciled: [BrowserCssAnimationInstance] = []
    var style_index = 0
    while style_index < styles.len():  # cpu-lane-loop-ok: one pass over styles reconciling declared animations against the previous instance list; bound is the style count, runs on animation reconcile, not on paint
        val st = styles[style_index]
        val keyframe_index = (
            frame_index.keyframes_by_name.get(st.animation_name) ?? -1
        )
        if (
            st.animation_name != "none" and
            st.animation_duration_ms > 0 and
            keyframe_index >= 0
        ):
            val target_key = frame_index.target_keys[style_index]
            if (
                target_key != "" and
                browser_css_animation_capacity_available(reconciled.len())
            ):
                val signature = frame_index.signatures[style_index]
                val paused = st.animation_play_state == "paused"
                val duration_ms = st.animation_duration_ms.to_i64()
                val delay_ms = st.animation_delay_ms.to_i64()
                val iteration_count = _css_animation_iteration_count(
                    st.animation_iteration_count
                )
                val old_index = (
                    frame_index.instances_by_target.get(target_key) ?? -1
                )
                if (
                    (not reset_descendants or target_key == "path:") and
                    old_index >= 0 and
                    previous[old_index].signature == signature
                ):
                    val old = previous[old_index]
                    if paused and not old.paused:
                        val elapsed = _css_animation_sub_ms_no_wrap(
                            current_time_ms, old.start_time_ms
                        )
                        val paused_elapsed = if elapsed > 0:
                            elapsed
                        else:
                            0
                        reconciled.push(BrowserCssAnimationInstance(
                            target_key: target_key,
                            signature: signature,
                            start_time_ms: old.start_time_ms,
                            paused: true,
                            paused_elapsed_ms: paused_elapsed,
                            duration_ms: duration_ms,
                            delay_ms: delay_ms,
                            timing: old.timing,
                            iteration_count: iteration_count
                        ))
                    elif not paused and old.paused:
                        reconciled.push(BrowserCssAnimationInstance(
                            target_key: target_key,
                            signature: signature,
                            start_time_ms: _css_animation_sub_ms_no_wrap(
                                current_time_ms, old.paused_elapsed_ms
                            ),
                            paused: false,
                            paused_elapsed_ms: old.paused_elapsed_ms,
                            duration_ms: duration_ms,
                            delay_ms: delay_ms,
                            timing: old.timing,
                            iteration_count: iteration_count
                        ))
                    else:
                        reconciled.push(old)
                else:
                    if val timing = parse_timing_function(
                        st.animation_timing_function
                    ):
                        reconciled.push(BrowserCssAnimationInstance(
                            target_key: target_key,
                            signature: signature,
                            start_time_ms: new_epoch_ms,
                            paused: paused,
                            paused_elapsed_ms: 0,
                            duration_ms: duration_ms,
                            delay_ms: delay_ms,
                            timing: timing,
                            iteration_count: iteration_count
                        ))
        style_index = style_index + 1
    reconciled

fn _animation_computed_length(value: i32) -> CSSValue:
    CSSValue.Length(v: value.to_f64(), unit: "px")

fn _animation_computed_color(value: u32) -> CSSValue:
    CSSValue.Color(color: from_rgba(
        ((value >> 16) & 255u32).to_i64(),
        ((value >> 8) & 255u32).to_i64(),
        (value & 255u32).to_i64(),
        ((value >> 24) & 255u32).to_i64()
    ))

fn _simple_web_css_animation_instance_next_ms(
    instance: BrowserCssAnimationInstance, current_time_ms: i64
) -> i64:
    if instance.paused:
        return -1
    if instance.duration_ms <= 0:
        return -1
    val start_ms = _css_animation_add_ms_no_wrap(
        instance.start_time_ms, instance.delay_ms
    )
    if current_time_ms < start_ms:
        return start_ms
    if instance.iteration_count < 0.0:
        return _css_animation_next_frame_ms(current_time_ms)
    val end_ms = (
        _css_animation_add_ms_no_wrap(
            start_ms,
            _css_animation_active_duration_ms(
                instance.duration_ms, instance.iteration_count
            )
        )
    )
    if current_time_ms < end_ms:
        val next_frame_ms = _css_animation_next_frame_ms(current_time_ms)
        if next_frame_ms < 0:
            return -1
        if next_frame_ms < end_ms:
            return next_frame_ms
        return end_ms
    -1

pub fn simple_web_layout_animation_instances_next_ms(
    instances: [BrowserCssAnimationInstance], current_time_ms: i64
) -> i64:
    var next_ms: i64 = -1
    for instance in instances:  # cpu-lane-loop-ok: min over the live animation instances' next-tick times; bound is the instance count
        val candidate_ms = _simple_web_css_animation_instance_next_ms(
            instance, current_time_ms
        )
        if candidate_ms >= 0 and (next_ms < 0 or candidate_ms < next_ms):
            next_ms = candidate_ms
    next_ms

fn _simple_web_layout_animation_schedule(
    styles: [Style], current_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance],
    frame_index: _SimpleWebAnimationFrameIndex
) -> _SimpleWebAnimationSchedule:
    var latest_end: i64 = -1
    var next_change: i64 = -1
    var style_index = 0
    while style_index < styles.len():  # cpu-lane-loop-ok: one pass over styles computing the frame's animation end/next timestamps; bound is the style count, once per animation-schedule build
        val st = styles[style_index]
        val keyframe_index = (
            frame_index.keyframes_by_name.get(st.animation_name) ?? -1
        )
        if (
            st.animation_name != "none" and
            st.animation_duration_ms > 0 and
            keyframe_index >= 0
        ):
            val target_key = frame_index.target_keys[style_index]
            val matched_index = (
                frame_index.instances_by_target.get(target_key) ?? -1
            )
            val matched = matched_index >= 0
            val paused = if matched:
                animation_instances[matched_index].paused
            else:
                st.animation_play_state == "paused"
            val start_time_ms = if matched:
                animation_instances[matched_index].start_time_ms
            else:
                0
            val animation_start = (
                _css_animation_add_ms_no_wrap(
                    start_time_ms, st.animation_delay_ms.to_i64()
                )
            )
            val iteration_count = _css_animation_iteration_count(
                st.animation_iteration_count
            )
            val infinite = iteration_count < 0.0
            var animation_end: i64 = -1
            if infinite:
                if not paused:
                    latest_end = -2
            else:
                animation_end = _css_animation_add_ms_no_wrap(
                    animation_start,
                    _css_animation_active_duration_ms(
                        st.animation_duration_ms.to_i64(), iteration_count
                    )
                )
                if animation_end < 0:
                    animation_end = 0
                if latest_end != -2 and animation_end > latest_end:
                    latest_end = animation_end

            if not paused and current_time_ms >= 0:
                var candidate: i64 = -1
                if matched:
                    candidate = _simple_web_css_animation_instance_next_ms(
                        animation_instances[matched_index], current_time_ms
                    )
                elif current_time_ms < animation_start:
                    candidate = animation_start
                elif infinite:
                    candidate = _css_animation_next_frame_ms(
                        current_time_ms
                    )
                elif current_time_ms < animation_end:
                    candidate = _css_animation_next_frame_ms(
                        current_time_ms
                    )
                    if candidate > animation_end:
                        candidate = animation_end
                if candidate >= 0 and (
                    next_change < 0 or candidate < next_change
                ):
                    next_change = candidate
        style_index = style_index + 1
    _SimpleWebAnimationSchedule(
        animation_end_ms: latest_end,
        animation_next_ms: next_change
    )

pub fn simple_web_layout_animation_end_ms(
    html: text, width: i32
) -> i64:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val registry = _simple_web_extract_keyframes(html)
    if registry.entries.len() == 0:
        return -1
    val frame_index = _simple_web_animation_frame_index(
        styles, nodes, child_index, registry, [], false
    )
    _simple_web_layout_animation_schedule(
        styles, -1, [], frame_index
    ).animation_end_ms

# The page base under every node, shared by the raster `paint` callers and the
# Draw IR canvas command: a legacy widget chrome page paints on the F5F5F5
# widget base (the presenter's `_base_for` agrees), any other page on its
# authored canvas background.
fn _simple_web_layout_canvas_base(html: text, nodes: [HNode], styles: [Style]) -> u32:
    if simple_web_layout_uses_legacy_widget_chrome(html):
        return web_argb(245, 245, 245)
    web_canvas_background_authored(html, nodes, styles, web_argb(255, 255, 255))

# Deepest nested opacity root level the Draw IR producer emits: level L is
# rendered at embed depth L, and the executor's ENGINE2D_DRAW_IR_EMBED_MAX_DEPTH
# (3) admits depths 0..2 only.
val _SIMPLE_WEB_OPACITY_NEST_MAX_LEVEL: i32 = 2

fn _simple_web_opacity_root_on_chain(root_parent: [i32], start: i32, target: i32) -> bool:
    var r = start
    while r >= 0:  # cpu-lane-loop-ok: walks one opacity-root chain; bound is the nest level cap (3)
        if r == target:
            return true
        r = root_parent[r]
    false

# Filter Effects 2 backdrop roots that need their own isolated group: a node
# with `backdrop-filter` whose subtree holds another `backdrop-filter`. The
# descendant's backdrop is only what was painted inside the root's group
# (transparent at start), not the page under it (Chrome 159). Pages without
# nested backdrop filters get no flag, so their paint path is unchanged.
fn _simple_web_backdrop_root_flags(nodes: [HNode], styles: [Style]) -> [bool]:
    var roots: [bool] = [false; nodes.len()]
    if nodes.len() != styles.len():
        return roots
    # below[i]: some descendant of i has backdrop-filter. Parents precede
    # children, so a reverse pass sees every descendant before its ancestor.
    var below: [bool] = [false; nodes.len()]
    var i: i32 = nodes.len() as i32 - 1
    while i >= 0:  # cpu-lane-loop-ok: one bottom-up pass folding backdrop-filter presence into parents; bound is node_count, once per compose
        val own = styles[i].backdrop_filter_raw != ""
        if (
            own and below[i] and nodes[i].tag != "#root" and
            nodes[i].tag != "html" and nodes[i].tag != "body"
        ):
            roots[i] = true
        val parent = nodes[i].parent as i32
        if parent >= 0 and parent < i and (own or below[i]):
            below[parent] = true
        i = i - 1
    roots

# Each command's innermost fractional-opacity or backdrop root, the number
# of roots, and each root's parent root (-1 at top level). A root nested in
# another root is a nested CSS group; every root's commands must stay
# contiguous (no root is re-entered after its subtree's run closed). A
# backdrop root (`backdrop_roots`) is a group at opacity 100%.
fn _simple_web_fractional_opacity_command_roots(
    nodes: [HNode], styles: [Style], owner_nodes: [i32], backdrop_roots: [bool]
) -> (bool, [i32], i32, [i32]):
    if nodes.len() != styles.len():
        return (false, [], 0, [])
    var node_roots: [i32] = [-1; nodes.len()]
    var root_parent: [i32] = [-1; nodes.len()]
    var root_level: [i32] = [0; nodes.len()]
    var has_root = false
    var i: i32 = 0
    while i < nodes.len():  # cpu-lane-loop-ok: single top-down pass assigning each node its fractional-opacity surface root; bound is node_count, once per compose
        val parent = nodes[i].parent as i32
        val parent_root = if parent >= 0 and parent < i:
            node_roots[parent]
        else:
            -1
        val opacity = styles[i].opacity_pct
        val fractional = opacity > 0 and opacity < 100
        val backdrop_root = (
            opacity >= 100 and i < backdrop_roots.len() and backdrop_roots[i]
        )
        if fractional or backdrop_root:
            if (
                nodes[i].tag == "#root" or
                nodes[i].tag == "html" or nodes[i].tag == "body"
            ):
                return (false, [], 0, [])
            if parent_root >= 0:
                if root_level[parent_root] >= _SIMPLE_WEB_OPACITY_NEST_MAX_LEVEL:
                    return (false, [], 0, [])
                root_parent[i] = parent_root
                root_level[i] = root_level[parent_root] + 1
            node_roots[i] = i
            has_root = true
        else:
            node_roots[i] = parent_root
        if (
            node_roots[i] >= 0 and
            styles[i].backdrop_filter_raw != ""
        ):
            # A backdrop-filter under a group reads that group's layer. Only
            # chains of backdrop roots (opacity 100%) are admitted; a
            # fractional-opacity root above it keeps the ungrouped path.
            var chain = node_roots[i]
            while chain >= 0:  # cpu-lane-loop-ok: the node's root chain; bound is the nest level cap (3)
                if styles[chain].opacity_pct < 100:
                    return (false, [], 0, [])
                chain = root_parent[chain]
        i = i + 1
    if not has_root:
        return (false, [], 0, [])
    var command_roots: [i32] = []
    var closed: [bool] = [false; nodes.len()]
    var opened: [bool] = [false; nodes.len()]
    var previous = -1
    var root_count = 0
    for owner in owner_nodes:  # cpu-lane-loop-ok: maps each emitted DrawIR command to its owner's opacity root and detects reopened runs; bound is the command count
        if owner < 0 or owner >= node_roots.len():
            return (false, [], 0, [])
        val root = node_roots[owner]
        if root != previous:
            # Leaving a root's subtree closes it; entering a closed root
            # again would split its layer.
            var left = previous
            while left >= 0:  # cpu-lane-loop-ok: previous root chain; bound is the nest level cap
                if not _simple_web_opacity_root_on_chain(root_parent, root, left):
                    closed[left] = true
                left = root_parent[left]
            var entered = root
            while entered >= 0:  # cpu-lane-loop-ok: new root chain; bound is the nest level cap
                if closed[entered]:
                    return (false, [], 0, [])
                if not opened[entered]:
                    opened[entered] = true
                    root_count = root_count + 1
                entered = root_parent[entered]
            previous = root
        command_roots.push(root)
    (root_count > 0, command_roots, root_count, root_parent)

# Per opacity root: the surface rect its commands are painted into, whether
# they are translated into it, and how many of them paint (a colour with
# alpha, an image or a glyph run). Two or more painted items make the root a
# CSS opacity GROUP (Chrome saveLayer + SkBlendARGB32 restore); a box's border,
# outline and box-shadow count as items of their own. One keeps the
# existing single-item surface path. The rect is the union of the root's
# command rects clipped to the viewport, so a layer never exceeds the
# subtree's clipped bounds. A command that cannot be moved by
# `_simple_web_draw_ir_translate_command` (glyph runs, points, fractional or
# affine geometry, paint transforms, CSS background images) or a member with a
# box-shadow or outline keeps that root on a viewport-sized, untranslated
# surface.
#
# A nested root's commands also fold into every ancestor root's rect, so a
# nested layer always lies inside its parent's layer. A root that holds or is
# a nested root is always a group (Chrome restores every level as a layer).
struct _SimpleWebOpacityRootBounds:
    x: [i32]
    y: [i32]
    w: [i32]
    h: [i32]
    translate: [bool]
    painted: [i32]
    group: [bool]

# Paint reach past a box's border box, per side [left, top, right, bottom],
# from its outset shadows (offset toward the side + spread + 2*blur) and its
# outline (width + |offset| on every side). Empty when a shadow length does
# not parse as px: the reach is unknown, so the root keeps a viewport surface.
fn _simple_web_opacity_halo(st: Style) -> [i32]:
    var o = 0
    if st.outline_w > 0:
        o = st.outline_w + (if st.outline_offset_px < 0: 0 - st.outline_offset_px else: st.outline_offset_px)
    var reach: [i32] = [o, o, o, o]
    var layers: [[i32]] = []
    if st.box_shadow_raw != "":
        for layer in split_top_level_commas(st.box_shadow_raw):  # cpu-lane-loop-ok: one box's shadow layer list
            if not layer.contains("inset"):
                var v: [i32] = [0, 0, 0, 0]
                var k = 0
                for token in shadow_length_prefix(layer).split(" "):  # cpu-lane-loop-ok: at most four length tokens
                    if k < 4 and token.trim() != "":
                        if val n = token.replace("px", "").trim().to_int():
                            v[k] = n as i32
                        else:
                            return []
                        k = k + 1
                layers = layers + [v]
    elif st.box_shadow_color != 0u32:
        layers = [[st.box_shadow_x_px, st.box_shadow_y_px, st.box_shadow_blur_px, 0]]
    for v in layers:  # cpu-lane-loop-ok: one box's shadow layers
        val grow = v[3] + v[2] * 2
        val sides: [i32] = [grow - v[0], grow - v[1], grow + v[0], grow + v[1]]
        var n = 0
        while n < 4:
            if sides[n] > reach[n]:
                reach[n] = sides[n]
            n = n + 1
    reach

fn _simple_web_draw_ir_command_translatable(command: DrawIrCommand) -> bool:
    if val _geometry = command.fractional_geometry:
        return false
    if val _affine = command.affine_transform:
        return false
    (
        not command.glyph_run.valid and command.points.len() == 0 and
        not command.has_transform and
        not _simple_web_draw_ir_css_background(command)
    )

fn _simple_web_opacity_root_bounds(
    commands: [DrawIrCommand], command_roots: [i32], owners: [i32],
    root_parent: [i32],
    styles: [Style], node_count: i32, width: i32, height: i32
) -> _SimpleWebOpacityRootBounds:
    var x0: [i32] = [width; node_count]
    var y0: [i32] = [height; node_count]
    var x1: [i32] = [0; node_count]
    var y1: [i32] = [0; node_count]
    var translate: [bool] = [true; node_count]
    var painted: [i32] = [0; node_count]
    var seen: [bool] = [false; node_count]
    var edge_owner = -1
    var i = 0
    while i < commands.len():  # cpu-lane-loop-ok: one pass over the emitted commands folding each into its opacity root's bounds; bound is the command count, once per compose
        val root = command_roots[i]
        if root >= 0 and root < node_count:
            seen[root] = true
            val c = commands[i]
            val movable = _simple_web_draw_ir_command_translatable(c)
            # A shadow halo or an outline paints outside the command rect:
            # the surface rect grows by that reach.
            val owner = if i < owners.len(): owners[i] else: -1
            val halo: [i32] = if owner >= 0 and owner < styles.len(): _simple_web_opacity_halo(styles[owner]) else: [0, 0, 0, 0]
            val halo_known = halo.len() == 4
            var chain = root
            while chain >= 0:  # cpu-lane-loop-ok: folds the command into its root and every ancestor root; bound is the nest level cap
                if not movable or not halo_known:
                    translate[chain] = false
                if halo_known and c.width > 0 and c.height > 0:
                    if c.x - halo[0] < x0[chain]: x0[chain] = c.x - halo[0]
                    if c.y - halo[1] < y0[chain]: y0[chain] = c.y - halo[1]
                    if c.x + c.width + halo[2] > x1[chain]: x1[chain] = c.x + c.width + halo[2]
                    if c.y + c.height + halo[3] > y1[chain]: y1[chain] = c.y + c.height + halo[3]
                chain = if chain < root_parent.len(): root_parent[chain] else: -1
            if ((c.color >> 24) & 255u32) != 0u32 or c.image_uri != "" or c.glyph_run.valid:
                painted[root] = painted[root] + 1
            # An image's opacity is never folded into its pixels' alpha: Chrome
            # composites even a lone <img> as a layer (opacity .5 over white:
            # B8C2FB, the fold gives B8C2FA), so an image alone is a group.
            if c.image_uri != "":
                painted[root] = painted[root] + 1
            # A box's border and outline ride its background command but are
            # separate paint items to Chrome (bg + border at 0.5 is a group:
            # ff7e7e, not ff7f7f) -- counted once per owner, as the raster
            # lane's _raster_group_node_ops does.
            if owner >= 0 and owner < styles.len() and owner != edge_owner:
                edge_owner = owner
                val est = styles[owner]
                if est.border_l > 0 or est.border_t > 0 or est.border_r > 0 or est.border_b > 0:
                    painted[root] = painted[root] + 1
                if est.outline_w > 0 and est.outline_color != 0u32:
                    painted[root] = painted[root] + 1
                # An outset/inset box-shadow is its own item too (Chrome 159:
                # red bg + blue shadow at 0.5 restores ff7e7e, not ff7f7f).
                if est.box_shadow_color != 0u32 or est.box_shadow_raw != "":
                    painted[root] = painted[root] + 1
                # A gradient / image background layer paints from the style,
                # not the command colour.
                if (est.background_gradient_from != 0u32 and est.background_gradient_to != 0u32) or est.bg_layers_raw != "" or est.background_image_uri != "":
                    painted[root] = painted[root] + 1
        i = i + 1
    var group: [bool] = [false; node_count]
    var w: [i32] = [width; node_count]
    var h: [i32] = [height; node_count]
    var r = 0
    while r < node_count:  # cpu-lane-loop-ok: clamps each root's rect to the viewport; bound is node_count, once per compose
        if painted[r] >= 2:
            group[r] = true
        # A root at opacity 100% is a backdrop root: always an isolated group.
        if seen[r] and r < styles.len() and styles[r].opacity_pct >= 100:
            group[r] = true
        if r < root_parent.len() and root_parent[r] >= 0:
            group[r] = true
            group[root_parent[r]] = true
        val cx0 = if x0[r] > 0: x0[r] else: 0
        val cy0 = if y0[r] > 0: y0[r] else: 0
        val cx1 = if x1[r] < width: x1[r] else: width
        val cy1 = if y1[r] < height: y1[r] else: height
        if translate[r] and cx1 > cx0 and cy1 > cy0:
            x0[r] = cx0
            y0[r] = cy0
            w[r] = cx1 - cx0
            h[r] = cy1 - cy0
        else:
            translate[r] = false
            x0[r] = 0
            y0[r] = 0
        r = r + 1
    _SimpleWebOpacityRootBounds(x: x0, y: y0, w: w, h: h, translate: translate, painted: painted, group: group)

# Draw IR prop naming the nested CSS opacity groups a command sits in, below
# its batch's own group: one `root,x,y,w,h,opacity_milli` entry per level,
# outermost first, `;`-separated, each rect relative to its parent layer. The
# command itself is in its innermost layer's coordinates. Read by
# `draw_ir_adv` to render each level into its own layer.
val SIMPLE_WEB_OPACITY_NEST_PROP = "css-opacity-group-nest"

fn _simple_web_opacity_nest_texts(
    root_parent: [i32], bounds: _SimpleWebOpacityRootBounds, styles: [Style]
) -> [text]:
    var out: [text] = [""; root_parent.len()]
    var r = 0
    while r < root_parent.len():  # cpu-lane-loop-ok: one entry per nested root, parents first (parent index < child index); bound is node_count, once per compose
        val parent = root_parent[r]
        if parent >= 0:
            val entry = "{r},{bounds.x[r] - bounds.x[parent]},{bounds.y[r] - bounds.y[parent]},{bounds.w[r]},{bounds.h[r]},{styles[r].opacity_pct * 10}"
            out[r] = if out[parent] == "": entry else: out[parent] + ";" + entry
        r = r + 1
    out

fn _simple_web_opacity_top_root(root_parent: [i32], root: i32) -> i32:
    var r = root
    while r >= 0 and r < root_parent.len() and root_parent[r] >= 0:  # cpu-lane-loop-ok: walks to the top-level root; bound is the nest level cap
        r = root_parent[r]
    r

fn _simple_web_draw_ir_css_background(command: DrawIrCommand) -> bool:
    for prop in command.computed_style:  # cpu-lane-loop-ok: scans one command's computed_style list for the css-background image role; bound is that command's property count
        if prop.key == "image-role" and prop.value == "css-background":
            return true
    false

fn _simple_web_iframe_fractional_ancestor(
    nodes: [HNode], styles: [Style], node_index: i32
) -> bool:
    var current = node_index
    while current >= 0 and current < styles.len():  # cpu-lane-loop-ok: ancestor walk looking for a fractional-opacity ancestor of an iframe; bound is tree depth, not an element count - flagged by the gate's any-loop-header approximation of the design's bound-based rule
        if styles[current].opacity_pct < 100:
            return true
        current = nodes[current].parent
    false

fn _simple_web_draw_ir_has_material_request(
    composition: DrawIrComposition
) -> bool:
    for batch in composition.batches:  # cpu-lane-loop-ok: batch level of a single linear scan of one admitted iframe child composition; total work is that child composition's size, once per embedded iframe
        for command in batch.commands:  # cpu-lane-loop-ok: command level of the same one-shot material-request scan over an iframe child composition
            for prop in command.computed_style:  # cpu-lane-loop-ok: property level of the same scan; bound is one command's computed_style count and it returns on the first match
                if prop.key == "wm-material-request":
                    return true
    false

fn _simple_web_layout_merge_material_witness(
    witnesses: [SimpleWebLayoutMaterialWitness]
) -> SimpleWebLayoutMaterialWitness:
    var cpu_count = 0
    var solid_count = 0
    var cpu_parts: [text] = []
    var solid_parts: [text] = []
    var cpu_single_hash = ""
    var solid_single_hash = ""
    for witness in witnesses:  # cpu-lane-loop-ok: folds the parent witness plus one witness per embedded iframe; bound is the iframe child count
        if witness.cpu_composited_count > 0:
            cpu_count = cpu_count + witness.cpu_composited_count
            cpu_parts.push("{witness.cpu_composited_count}:{witness.cpu_composited_sha256}")
            cpu_single_hash = witness.cpu_composited_sha256
        if witness.solid_material_count > 0:
            solid_count = solid_count + witness.solid_material_count
            solid_parts.push("{witness.solid_material_count}:{witness.solid_material_sha256}")
            solid_single_hash = witness.solid_material_sha256
    SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_count,
        cpu_composited_sha256: if cpu_parts.len() == 0: "" elif cpu_parts.len() == 1: cpu_single_hash else: sha256_text("v1\n" + cpu_parts.join("\n") + "\n"),
        solid_material_count: solid_count,
        solid_material_sha256: if solid_parts.len() == 0: "" elif solid_parts.len() == 1: solid_single_hash else: sha256_text("v1\n" + solid_parts.join("\n") + "\n")
    )

fn _simple_web_layout_segment_batch(
    source: DrawIrSourceInfo, embedding: DrawIrEmbeddingConfig,
    nodes: [HNode], styles: [Style],
    opacity_root: i32, bounds: _SimpleWebOpacityRootBounds,
    segment_index: i32, commands: [DrawIrCommand]
) -> DrawIrBatch:
    if opacity_root >= 0:
        val surface_id = if bounds.group[opacity_root]:
            css_opacity_group_surface_id(opacity_root)
        else:
            "html-opacity-{opacity_root}"
        val opacity_embedding = draw_ir_embedding_config(
            surface_id,
            _html_draw_ir_component_id(nodes[opacity_root], opacity_root),
            bounds.x[opacity_root], bounds.y[opacity_root],
            bounds.w[opacity_root], bounds.h[opacity_root],
            0, styles[opacity_root].opacity_pct * 10, true
        )
        return draw_ir_batch_with_source(
            "html-layout-{segment_index}", DRAW_IR_BACKEND_CPU,
            opacity_embedding, commands, source
        )
    draw_ir_batch_with_source(
        "html-layout-{segment_index}", DRAW_IR_BACKEND_CPU,
        embedding, commands, source
    )

pub fn simple_web_layout_empty_retained() -> LayoutResult:
    LayoutResult(
        bx: [], by: [], bw: [], bh: [], wrap_starts: [], wrap_ends: [],
        intrinsic_widths: [], height: 0
    )

# Stage-timed variant of the software render entry: prints per-stage wall
# times so render-cost regressions can be localized without a debugger.
# reason: moved verbatim from simple_web_html_layout_renderer.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn simple_web_layout_render_html_software_pixels_traced(html: text, width: i32, height: i32, budget_ms: i64 = WEB_RENDER_BUDGET_MS) -> [u32]:
    _web_budget_begin(budget_ms)
    val t0 = default_frame_clock().now_micros()
    val nodes = parse_html(html)
    val t1 = default_frame_clock().now_micros()
    print "[layout-trace] parse_html_ms={(t1 - t0) / 1000} nodes={nodes.len()}"
    val rules = extract_css_vw(html, width, true)
    val t2 = default_frame_clock().now_micros()
    print "[layout-trace] extract_css_ms={(t2 - t1) / 1000}"
    val child_index = build_child_index(nodes)
    val t_child_index = default_frame_clock().now_micros()
    print "[layout-trace] build_child_index_ms={(t_child_index - t2) / 1000}"
    val styles = compute_styles(nodes, rules, child_index, true, true, width, height)
    val t3 = default_frame_clock().now_micros()
    print "[layout-trace] compute_styles_ms={(t3 - t_child_index) / 1000}"
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = web_html_layout_tree(nodes, styles, child_index, 0, 0, 0, width, width, height, zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), empty_starts, empty_ends, neg_one_i32_list(node_count))
    val t4 = default_frame_clock().now_micros()
    print "[layout-trace] layout_ms={(t4 - t3) / 1000}"
    var trace_i = 0
    while trace_i < node_count:  # cpu-lane-loop-ok: one pass over nodes printing the html/body/main box receipt; bound is node_count and this is the stage-timed diagnostic render entry point only
        val trace_node = nodes[trace_i]
        if trace_node.tag == "html" or trace_node.tag == "body" or trace_node.tag == "main":
            val trace_style = styles[trace_i]
            print "[layout-trace-box] tag={trace_node.tag} x={boxes.bx[trace_i]} y={boxes.by[trace_i]} w={boxes.bw[trace_i]} h={boxes.bh[trace_i]} bg={trace_style.bg} gradient_from={trace_style.background_gradient_from} gradient_to={trace_style.background_gradient_to} opacity={trace_style.opacity_pct}"
        trace_i = trace_i + 1
    val white = web_argb(255, 255, 255)
    val widget_mode = simple_web_layout_uses_legacy_widget_chrome(html)
    val base = if widget_mode: web_argb(245, 245, 245) else: _web_canvas_background(nodes, styles, white)
    var fb = browser_layout_framebuffer_filled(base, width, height)
    val t_init = default_frame_clock().now_micros()
    val wrap_cache = TextWrapCache(starts: boxes.wrap_starts, ends: boxes.wrap_ends, first_line_dx: boxes.first_line_dx, line_boxes: boxes.line_boxes)
    val t_paint = default_frame_clock().now_micros()
    var painted = paint(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, wrap_cache, fb, width, height, widget_mode)
    painted = _web_paint_iframes(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, rules, painted, width, height, 0)
    val t5 = default_frame_clock().now_micros()
    print "[layout-trace] framebuffer_init_ms={(t_init - t4) / 1000} trace_setup_ms={(t_paint - t_init) / 1000} paint_draw_ms={(t5 - t_paint) / 1000} paint_ms={(t5 - t4) / 1000} widget_mode={widget_mode}"
    painted

# Spec/benchmark entry for the CPU tile-render-culling lane: renders `html`
# into a full document-space framebuffer (width x height) and, when `tiled`,
# rasters only ops visible in the tiles intersecting viewport rows
# [viewport_y, viewport_y + viewport_h) plus the 512px prefetch margin
# (occlusion-culled ops are skipped too). `tiled` false runs the classic
# paint() on the exact same pipeline — the non-tiled baseline for the
# pixel-parity oracle. Same-budget on both lanes keeps runs deterministic.
pub fn simple_web_layout_render_html_software_pixels_tile_lane(
    html: text, width: i32, height: i32,
    viewport_y: i32, viewport_h: i32, tiled: bool
) -> [u32]:
    # A deliberately huge fixed budget: the tiled-vs-classic comparison must
    # be deterministic, and a wall-clock budget break that lands differently
    # in the two lanes would fake a parity diff. Degraded-render behavior is
    # covered by the production entry, not this oracle.
    val lane_budget_ms: i64 = 3600000
    _web_budget_begin(lane_budget_ms)
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true, width, height)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = web_html_layout_tree(nodes, styles, child_index, 0, 0, 0, width, width, height, zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), empty_starts, empty_ends, neg_one_i32_list(node_count))
    val white = web_argb(255, 255, 255)
    val widget_mode = simple_web_layout_uses_legacy_widget_chrome(html)
    val base = if widget_mode: web_argb(245, 245, 245) else: _web_canvas_background(nodes, styles, white)
    var fb = browser_layout_framebuffer_filled(base, width, height)
    val wrap_cache = TextWrapCache(starts: boxes.wrap_starts, ends: boxes.wrap_ends, first_line_dx: boxes.first_line_dx, line_boxes: boxes.line_boxes)
    var painted = if tiled:
        paint_tiled(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, wrap_cache, fb, width, height, widget_mode, viewport_y, viewport_h)
    else:
        paint(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, wrap_cache, fb, width, height, widget_mode)
    painted = _web_paint_iframes(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, rules, painted, width, height, 0)
    painted

fn _web_gpu_paint_state(
    nodes: [HNode], styles: [Style]
) -> ([bool], [bool], i32):
    val node_count = nodes.len() as i32
    var visible: [bool] = [false; node_count]
    var opaque: [bool] = [false; node_count]
    var subtree_allowed: [bool] = [false; node_count]
    var visits = 0
    var i: i32 = 0
    while i < node_count:  # cpu-lane-loop-ok: single top-down pass deriving per-node visible/opaque/subtree-allowed flags from the parent's entry; bound is node_count and it replaces per-node ancestor rewalks
        val parent = nodes[i].parent as i32
        val ancestor_allowed = parent < 0 or subtree_allowed[parent]
        val ancestor_opaque = parent < 0 or opaque[parent]
        val st = styles[i]
        visible[i] = (
            ancestor_allowed and st.display != "none" and
            not st.visibility_hidden
        )
        opaque[i] = ancestor_opaque and st.opacity_pct == 100
        subtree_allowed[i] = (
            ancestor_allowed and st.display != "none" and
            not st.content_visibility_hidden and
            nodes[i].tag != "iframe"
        )
        visits = visits + 1
        i = i + 1
    (visible, opaque, visits)

pub fn simple_web_layout_debug_gpu_paint_state_visits(
    html: text, width: i32
) -> i32:
    val nodes = parse_html(html)
    val rules = extract_css_vw(html, width, false)
    val styles = compute_styles(
        nodes, rules, build_child_index(nodes), false, true
    )
    val (_, _, visits) = _web_gpu_paint_state(nodes, styles)
    visits

# Emit a fill_rect op for every node whose background is a plain opaque
# border-box rectangle — i.e. exactly the case where paint() writes a flat
# `st.bg | 0xFF000000` slab over (bx,by,bw,bh) with no rounding/opacity/gradient.
# Ops are emitted in node-index order, which matches normal-flow paint order
# (parent before child). Anything ambiguous is skipped and handled by the
# presenter's residual blit, so this walk is conservative: skipping a node only
# reduces GPU offload, it never breaks parity.
fn _web_gpu_solid_fill_ops(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], width: i32, height: i32, widget_mode: bool, paint_visible: [bool], paint_opaque: [bool]) -> [SceneCommand]:
    var ops: [SceneCommand] = []
    if widget_mode:
        return ops
    val node_count = nodes.len() as i32
    var i: i32 = 0
    while i < node_count:
        val nd = nodes[i]
        val st = styles[i]
        val x = bx[i]
        val y = by[i]
        val w = bw[i]
        val h = bh[i]
        val visible = paint_visible[i] and paint_opaque[i]
        val is_text = nd.tag == "#text"
        val solid_alpha = ((st.bg >> 24) & 255u32)
        val no_gradient = st.background_gradient_from == 0u32 or st.background_gradient_to == 0u32
        val no_radius = st.border_radius_tl_px == 0 and st.border_radius_tr_px == 0 and st.border_radius_br_px == 0 and st.border_radius_bl_px == 0
        val border_box_clip = st.background_clip == "border-box"
        val plain_solid = (visible and not is_text and st.opacity_pct == 100 and solid_alpha == 255u32 and no_gradient and no_radius and border_box_clip and w > 0 and h > 0 and x < width and y < height)
        if plain_solid:
            val argb_color = (st.bg | 0xFF000000u32)
            ops = ops.push(scene_fill_rect(x, y, w, h, argb_color as i32))
        i = i + 1
    ops

fn _web_gpu_solid_only_frame(nodes: [HNode], styles: [Style], widget_mode: bool, paint_visible: [bool], paint_opaque: [bool]) -> bool:
    if widget_mode:
        return false
    val node_count = nodes.len() as i32
    var i: i32 = 0
    while i < node_count:  # cpu-lane-loop-ok: one pass over nodes testing whether the frame is entirely solid fills; bound is node_count and every disqualifying node returns immediately
        val nd = nodes[i]
        val st = styles[i]
        val visible = paint_visible[i]
        if visible:
            if not paint_opaque[i]:
                return false
            if nd.tag == "iframe":
                # Iframe content is a blitted child bitmap, not a solid fill op;
                # force the full CPU paint path so _web_paint_iframes can run.
                return false
            if nd.tag == "#text":
                if nd.text_trimmed != "":
                    return false
            else:
                val has_bg = st.bg != 0u32
                val solid_alpha = ((st.bg >> 24) & 255u32) == 255u32
                val has_gradient = st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32
                val has_extra_paint = st.border_w > 0 or st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0 or st.outline_w > 0 or st.box_shadow_raw != "" or st.bg_layers_raw != "" or st.overflow_auto_y or nd.has_icon_image_class or nd.has_focused_class
                val plain_radius = st.border_radius_tl_px == 0 and st.border_radius_tr_px == 0 and st.border_radius_br_px == 0 and st.border_radius_bl_px == 0
                val plain_solid_bg = has_bg and solid_alpha and not has_gradient and st.opacity_pct == 100 and plain_radius and st.background_clip == "border-box"
                if has_gradient or has_extra_paint:
                    return false
                if has_bg and not plain_solid_bg:
                    return false
            i = i + 1
        else:
            i = i + 1
    true

# Render at a scroll offset: preserve viewport layout, then shift paint
# coordinates so allocation stays bounded by WxH.
# This re-render approach keeps each call stateless.
# Literal default (== WEB_RENDER_BUDGET_MS): see simple_web_layout_render_html_software_pixels.
# reason: moved verbatim from simple_web_html_layout_renderer.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn simple_web_layout_render_html_software_pixels_at_scroll(html: text, width: i32, height: i32, scroll_y: i32, budget_ms: i64 = 10000) -> [u32]:
    _web_budget_begin(budget_ms)
    if width <= 0 or height <= 0:
        return []
    val nodes = parse_html(html)
    # Pass every parameter explicitly. An omitted trailing default was
    # observed taking a non-default value in the freestanding SimpleOS kernel
    # build (the `trace_stages` receipt fired from this call site even though
    # the only trace-enabled caller never ran), so this render path does not
    # rely on default-argument materialization.
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true, width, height)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = web_html_layout_tree(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    val scrolled = _simple_web_scrolled_layout(
        nodes, styles, boxes, width, height, scroll_y
    )
    val shifted_boxes = scrolled.boxes
    val white = web_argb(255, 255, 255)
    val widget_mode = simple_web_layout_uses_legacy_widget_chrome(html)
    val base = if widget_mode: web_argb(245, 245, 245) else: _web_canvas_background(nodes, styles, white)
    var fb = browser_layout_framebuffer_filled(base, width, height)
    val wrap_cache = TextWrapCache(
        starts: shifted_boxes.wrap_starts, ends: shifted_boxes.wrap_ends,
        first_line_dx: shifted_boxes.first_line_dx,
        line_boxes: shifted_boxes.line_boxes
    )
    var painted = paint(
        nodes, styles, shifted_boxes.bx, shifted_boxes.by,
        shifted_boxes.bw, shifted_boxes.bh, wrap_cache,
        fb, width, height, widget_mode
    )
    painted = _web_paint_iframes(
        nodes, styles, shifted_boxes.bx, shifted_boxes.by,
        shifted_boxes.bw, shifted_boxes.bh, rules,
        painted, width, height, 0
    )
    painted
