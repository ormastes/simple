#![allow(large_file)]  # Intentional: legacy heuristic parser is retained only for pixel compatibility.
use std.gc_async_mut.gpu.browser_engine.simple_web_html_engine2d_presenter.{simple_web_layout_render_html_pixels, simple_web_layout_render_html_readback, present_layout_pixels_with_engine2d_readback}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    SimpleWebLayoutEngine2DReadbackResult,
    simple_web_layout_render_html_pixels_engine2d,
    simple_web_layout_render_html_pixels_engine2d_at_time,
    simple_web_layout_render_html_pixels_engine2d_at_time_with_animations,
    simple_web_layout_render_html_readback_engine2d_result
}
use std.gc_async_mut.gpu.browser_engine.dom_color.{parse_color_value_checked}
use std.gc_async_mut.gpu.browser_engine.style.animation.{
    BrowserCssAnimationInstance
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.backend.{Engine2DReadback, engine2d_readback}
use std.gc_async_mut.gpu.engine2d.backend_probe.{BackendStatus}
use std.gc_async_mut.gpu.engine2d.helpers_availability.{backend_canonical_name}
use common.ui.web_render_api.{WebRenderMaterialFallbackProvenance}

val SIMPLE_WEB_PIXEL_CACHE_MODE_UNTIMED_STATIC: text = "untimed-static"
val SIMPLE_WEB_PIXEL_CACHE_MODE_TERMINAL: text = "terminal"

class SimpleWebHeuristicSurface:
    width: i32
    height: i32
    pixels: [u32]

impl SimpleWebHeuristicSurface:
    static fn create(width: i32, height: i32) -> SimpleWebHeuristicSurface:
        # Allocate the buffer with the O(n) array-repeat form instead of an
        # element-by-element push loop. `pixels = pixels.push(x)` reassigns the
        # array each iteration; without unique-ownership the push copies, making
        # buffer creation O((W*H)^2) and the whole heuristic render O(n^2) in
        # canvas size. Array-repeat fills in one pass.
        SimpleWebHeuristicSurface(width: width, height: height, pixels: [0u32; width * height])

    me clear(color: u32):
        var i = 0
        val pixel_count = self.pixels.len()
        while i < pixel_count:
            self.pixels[i] = color
            i = i + 1

    me draw_rect_filled(x: i32, y: i32, w: i32, h: i32, color: u32):
        val x0 = if x < 0: 0 else: x
        val y0 = if y < 0: 0 else: y
        val x1 = if x + w > self.width: self.width else: x + w
        val y1 = if y + h > self.height: self.height else: y + h
        var yy = y0
        while yy < y1:
            var xx = x0
            while xx < x1:
                self.pixels[yy * self.width + xx] = color
                xx = xx + 1
            yy = yy + 1

    me read_pixels() -> [u32]:
        self.pixels

    me shutdown():
        pass

class SimpleWebEngine2DStaticPixelCache:
    width: i32
    height: i32
    backend_name: text
    last_html: text
    last_render_mode: text
    last_content_revision: i64
    last_pixels: [u32]
    last_material_fallback: WebRenderMaterialFallbackProvenance
    # Retained so a cache hit replays the ORIGINAL render's degraded verdict
    # rather than silently laundering a truncated render into a clean-looking
    # cached result.
    last_render_degraded: bool
    last_resolved_backend: text
    last_vector_font_identity: text
    last_vector_font_pixel_size: i32
    last_vector_font_execution_target: text
    last_vector_font_batch_identity: text
    last_vector_font_readback_source: text
    last_vector_font_device_checksum: i64
    last_vector_font_oracle_checksum: i64
    last_vector_font_readback_nonblank_pixels: i64
    last_vector_font_device_executed: bool
    last_vector_font_promotion_ready: bool
    hits: i32
    stores: i32

impl SimpleWebEngine2DStaticPixelCache:
    static fn create(width: i32, height: i32, backend_name: text) -> SimpleWebEngine2DStaticPixelCache:
        SimpleWebEngine2DStaticPixelCache(
            width: width,
            height: height,
            backend_name: backend_name,
            last_html: "",
            last_render_mode: "",
            last_content_revision: -1,
            last_pixels: [],
            last_material_fallback: WebRenderMaterialFallbackProvenance.none(),
            last_render_degraded: false,
            last_resolved_backend: "",
            last_vector_font_identity: "",
            last_vector_font_pixel_size: 0,
            last_vector_font_execution_target: "",
            last_vector_font_batch_identity: "",
            last_vector_font_readback_source: "",
            last_vector_font_device_checksum: 0,
            last_vector_font_oracle_checksum: 0,
            last_vector_font_readback_nonblank_pixels: 0,
            last_vector_font_device_executed: false,
            last_vector_font_promotion_ready: false,
            hits: 0,
            stores: 0
        )

    me pixels_for_html(html: text) -> [u32]:
        self.result_for_html(
            html, SIMPLE_WEB_PIXEL_CACHE_MODE_UNTIMED_STATIC, -1
        ).readback.pixels

    me invalidate():
        self.last_html = ""
        self.last_render_mode = ""
        self.last_content_revision = -1
        self.last_pixels = []
        self.last_material_fallback = WebRenderMaterialFallbackProvenance.none()
        self.last_render_degraded = false
        self.last_resolved_backend = ""
        self.last_vector_font_identity = ""
        self.last_vector_font_pixel_size = 0
        self.last_vector_font_execution_target = ""
        self.last_vector_font_batch_identity = ""
        self.last_vector_font_readback_source = ""
        self.last_vector_font_device_checksum = 0
        self.last_vector_font_oracle_checksum = 0
        self.last_vector_font_readback_nonblank_pixels = 0
        self.last_vector_font_device_executed = false
        self.last_vector_font_promotion_ready = false

    me retain_result_for_html(
        html: text,
        render_mode: text,
        content_revision: i64,
        result: SimpleWebLayoutEngine2DReadbackResult
    ):
        self.last_html = html
        self.last_render_mode = render_mode
        self.last_content_revision = content_revision
        self.last_pixels = result.readback.pixels
        self.last_material_fallback = result.material_fallback
        self.last_render_degraded = result.render_degraded
        self.last_resolved_backend = result.resolved_backend
        self.last_vector_font_identity = result.vector_font_identity
        self.last_vector_font_pixel_size = result.vector_font_pixel_size
        self.last_vector_font_execution_target = result.vector_font_execution_target
        self.last_vector_font_batch_identity = result.vector_font_batch_identity
        self.last_vector_font_readback_source = result.vector_font_readback_source
        self.last_vector_font_device_checksum = result.vector_font_device_checksum
        self.last_vector_font_oracle_checksum = result.vector_font_oracle_checksum
        self.last_vector_font_readback_nonblank_pixels = result.vector_font_readback_nonblank_pixels
        self.last_vector_font_device_executed = result.vector_font_device_executed
        self.last_vector_font_promotion_ready = result.vector_font_promotion_ready
        self.stores = self.stores + 1

    me cached_result_for_html(
        html: text, render_mode: text, content_revision: i64
    ) -> SimpleWebLayoutEngine2DReadbackResult?:
        if (
            html == self.last_html and
            render_mode == self.last_render_mode and
            content_revision == self.last_content_revision and
            self.last_pixels.len() == self.width * self.height
        ):
            self.hits = self.hits + 1
            return Some(SimpleWebLayoutEngine2DReadbackResult(
                readback: engine2d_readback(self.last_pixels, "cache"),
                material_fallback: self.last_material_fallback,
                render_degraded: self.last_render_degraded,
                resolved_backend: self.last_resolved_backend,
                vector_font_identity: self.last_vector_font_identity,
                vector_font_pixel_size: self.last_vector_font_pixel_size,
                vector_font_execution_target:
                    self.last_vector_font_execution_target,
                vector_font_batch_identity: self.last_vector_font_batch_identity,
                vector_font_readback_source:
                    self.last_vector_font_readback_source,
                vector_font_device_checksum:
                    self.last_vector_font_device_checksum,
                vector_font_oracle_checksum:
                    self.last_vector_font_oracle_checksum,
                vector_font_readback_nonblank_pixels:
                    self.last_vector_font_readback_nonblank_pixels,
                vector_font_device_executed:
                    self.last_vector_font_device_executed,
                vector_font_promotion_ready:
                    self.last_vector_font_promotion_ready
            ))
        nil

    me result_for_html(
        html: text, render_mode: text, content_revision: i64
    ) -> SimpleWebLayoutEngine2DReadbackResult:
        if val Some(cached) = self.cached_result_for_html(
            html, render_mode, content_revision
        ):
            return cached
        val resolved_backend = simple_web_engine2d_resolved_backend_name(self.width, self.height, self.backend_name)
        val result = simple_web_layout_render_html_readback_engine2d_result(html, self.width, self.height, resolved_backend)
        self.retain_result_for_html(
            html, render_mode, content_revision, result
        )
        result

fn _resolved_render_backend(width: i32, height: i32, backend_name: text) -> text:
    simple_web_engine2d_resolved_backend_name(width, height, backend_name)

fn _hex_digit_value(c: text) -> u32:
    if c == "0": return 0u32
    if c == "1": return 1u32
    if c == "2": return 2u32
    if c == "3": return 3u32
    if c == "4": return 4u32
    if c == "5": return 5u32
    if c == "6": return 6u32
    if c == "7": return 7u32
    if c == "8": return 8u32
    if c == "9": return 9u32
    if c == "a" or c == "A": return 10u32
    if c == "b" or c == "B": return 11u32
    if c == "c" or c == "C": return 12u32
    if c == "d" or c == "D": return 13u32
    if c == "e" or c == "E": return 14u32
    if c == "f" or c == "F": return 15u32
    0u32

fn _is_hex_digit(c: text) -> bool:
    (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or (c >= "A" and c <= "F")

fn _hex_pair_value(s: text, offset: i64) -> u32:
    (_hex_digit_value(s.char_at(offset)) << 4) | _hex_digit_value(s.char_at(offset + 1))

fn _hex_color_at(s: text, offset: i64, fallback: u32) -> u32:
    val remain = s.len() - offset
    if remain >= 7 and _is_hex_digit(s.char_at(offset + 1)) and _is_hex_digit(s.char_at(offset + 2)) and _is_hex_digit(s.char_at(offset + 3)) and _is_hex_digit(s.char_at(offset + 4)) and _is_hex_digit(s.char_at(offset + 5)) and _is_hex_digit(s.char_at(offset + 6)):
        return 0xFF000000u32 | (_hex_pair_value(s, offset + 1) << 16) | (_hex_pair_value(s, offset + 3) << 8) | _hex_pair_value(s, offset + 5)
    if remain >= 4 and _is_hex_digit(s.char_at(offset + 1)) and _is_hex_digit(s.char_at(offset + 2)) and _is_hex_digit(s.char_at(offset + 3)):
        return 0xFF000000u32 | ((_hex_digit_value(s.char_at(offset + 1)) * 17u32) << 16) | ((_hex_digit_value(s.char_at(offset + 2)) * 17u32) << 8) | (_hex_digit_value(s.char_at(offset + 3)) * 17u32)
    fallback

fn _find_char_from(s: text, marker: text, start: i64) -> i64:
    # Native byte-search (index_of + tail substring) instead of an interpreted
    # char_at loop. In the interpreter char_at(i) is O(i) (UTF-8 walk from the
    # start), so a char_at scan is O(n^2); repeated per-rule in the CSS pre-checks
    # that made office GUI render scale ~quadratically with CSS size. These paths
    # are ASCII byte==char, so native byte search is semantics-preserving.
    val st = if start < 0: 0 else: start
    val slen = s.len()
    if st >= slen:
        return -1
    if st <= 0:
        return s.index_of(marker)
    val tail = s.substring(st, slen)
    val idx = tail.index_of(marker)
    if idx < 0:
        return -1
    st + idx

fn _text_matches_at(s: text, marker: text, offset: i64) -> bool:
    val marker_len = marker.len()
    if offset < 0 or offset + marker_len > s.len():
        return false
    var idx: i64 = 0
    while idx < marker_len:
        if s.char_at(offset + idx) != marker.char_at(idx):
            return false
        idx = idx + 1
    true

fn _find_text_from(s: text, marker: text, start: i64) -> i64:
    # Native byte-search instead of a char_at loop (O(i) per char_at -> O(n^2)).
    # ASCII byte==char on these HTML/CSS paths, so native index_of is exact.
    val marker_len = marker.len()
    if marker_len == 0:
        return start
    val st = if start < 0: 0 else: start
    val slen = s.len()
    if st > slen - marker_len:
        return -1
    if st <= 0:
        return s.index_of(marker)
    val tail = s.substring(st, slen)
    val idx = tail.index_of(marker)
    if idx < 0:
        return -1
    st + idx

fn _range_contains_char(s: text, start: i64, end: i64, marker: text) -> bool:
    # Native substring + index_of instead of a char_at loop (char_at is O(i) in
    # the interpreter -> O(n^2) when scanned per CSS rule).
    val slen = s.len()
    val st = if start < 0: 0 else: start
    val en = if end > slen: slen else: end
    if st >= en:
        return false
    val sub = s.substring(st, en)
    sub.index_of(marker) >= 0

fn _second_hex_color_after_from(html: text, marker: text, start: i64, fallback: u32) -> u32:
    val first = _find_text_from(html, marker, start)
    if first < 0:
        return fallback
    val second = _find_text_from(html, marker, first + marker.len())
    if second < 0:
        return fallback
    val hash = _find_char_from(html, "#", second + marker.len())
    if hash < 0:
        return fallback
    _hex_color_at(html, hash, fallback)

fn _second_hex_color_after(html: text, marker: text, fallback: u32) -> u32:
    _second_hex_color_after_from(html, marker, 0, fallback)

fn _last_hex_color_after(html: text, marker: text, fallback: u32) -> u32:
    var color = fallback
    var pos: i64 = 0
    val html_len = html.len()
    while pos < html_len:
        val found = _find_text_from(html, marker, pos)
        if found < 0:
            return color
        val hash = _find_char_from(html, "#", found + marker.len())
        if hash >= 0:
            color = _hex_color_at(html, hash, color)
        pos = found + marker.len()
    color

# --- Real CSS background resolution --------------------------------------
#
# There is deliberately NO fixture table here. The declaration list is split
# on top-level `;`, the LAST `background-color` / `background` declaration
# wins (CSS last-wins within one origin), and the winning value's first color
# token is handed to the browser engine's own CSS color parser
# (`dom_color.parse_color_value_checked`: #RGB/#RGBA/#RRGGBB/#RRGGBBAA,
# rgb()/rgba(), hsl()/hsla(), named colors, `transparent`). `currentColor`
# resolves from the same declaration list's `color`, `var(--x)` from the
# document's custom properties, and a non-opaque result is composited over
# the UA default white page.

fn _cut_at_quote(v: text) -> text:
    var i: i64 = 0
    val n = v.len()
    while i < n:
        val ch = v.char_at(i)
        if ch == "\"" or ch == "'":
            return (v.substring(0, i) ?? "").trim()
        i = i + 1
    v.trim()

fn _is_ident_char(c: text) -> bool:
    (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or c == "-" or c == "_"

# Value of `prop` inside ONE declaration segment, "" when the segment does not
# declare it. Scans for the property token itself (rather than assuming the
# segment starts with it) so a raw `<div style="...">` tag text works too.
fn _decl_prop_value(seg: text, prop: text) -> text:
    val lo = seg.lower()
    val lo_len = lo.len()
    val prop_len = prop.len()
    var pos: i64 = 0
    var found: i64 = -1
    while pos < lo_len:
        val at = _find_text_from(lo, prop, pos)
        if at < 0:
            pos = lo_len
        else:
            var ok = true
            if at > 0 and _is_ident_char(lo.char_at(at - 1)):
                ok = false
            var j = at + prop_len
            while j < lo_len and (lo.char_at(j) == " " or lo.char_at(j) == "\t"):
                j = j + 1
            if j >= lo_len or lo.char_at(j) != ":":
                ok = false
            if ok:
                found = j
            pos = at + prop_len
    if found < 0:
        return ""
    _cut_at_quote(seg.substring(found + 1, seg.len()) ?? "")

# Raw value of the LAST declaration in `decls` naming `prop_a` or `prop_b`.
fn _decl_value_last(decls: text, prop_a: text, prop_b: text) -> text:
    var best = ""
    var seg_start: i64 = 0
    var depth: i64 = 0
    var i: i64 = 0
    val n = decls.len()
    while i <= n:
        val at_end = i >= n
        val ch = if at_end: ";" else: decls.char_at(i)
        if ch == "(":
            depth = depth + 1
        elif ch == ")" and depth > 0:
            depth = depth - 1
        if depth == 0 and ch == ";":
            val seg = decls.substring(seg_start, i) ?? ""
            var value = _decl_prop_value(seg, prop_a)
            if value.len() == 0 and prop_b != prop_a:
                value = _decl_prop_value(seg, prop_b)
            if value.len() > 0:
                best = value
            seg_start = i + 1
        i = i + 1
    best

# Value of a custom property (`--name`) declared anywhere in the document.
fn _custom_property_value(html: text, name: text) -> text:
    if name.len() == 0:
        return ""
    val marker = name + ":"
    val pos = html.index_of(marker)
    if pos < 0:
        return ""
    val start = pos + marker.len()
    val n = html.len()
    # index_of on one substring, not a char_at walk: char_at is O(i) in the
    # interpreter, so scanning a 900x760 catalog document character by
    # character here would be O(n^2) per var() reference.
    val rest = html.substring(start, n) ?? ""
    var end = rest.len()
    val semi = rest.index_of(";")
    if semi >= 0 and semi < end:
        end = semi
    val brace = rest.index_of("}")
    if brace >= 0 and brace < end:
        end = brace
    val dq = rest.index_of("\"")
    if dq >= 0 and dq < end:
        end = dq
    val sq = rest.index_of("'")
    if sq >= 0 and sq < end:
        end = sq
    (rest.substring(0, end) ?? "").trim()

fn _skip_numeric_token(tok: text) -> bool:
    if tok.len() == 0:
        return true
    val c = tok.char_at(0)
    (c >= "0" and c <= "9") or c == "." or (c == "-" and tok.len() > 1 and not tok.starts_with("--"))

# First color token of a CSS value, as RGBA (dom_color's convention).
fn _value_first_color(value: text, decls: text, html: text, depth: i64) -> u32?:
    var i: i64 = 0
    val n = value.len()
    var tok_start: i64 = 0
    var paren: i64 = 0
    while i <= n:
        val at_end = i >= n
        val ch = if at_end: " " else: value.char_at(i)
        if ch == "(":
            paren = paren + 1
        elif ch == ")" and paren > 0:
            paren = paren - 1
        val is_sep = paren == 0 and (ch == " " or ch == "\t" or ch == "\n" or ch == "\r" or ch == ",")
        if is_sep or at_end:
            if i > tok_start:
                val tok = (value.substring(tok_start, i) ?? "").trim()
                val lower = tok.lower()
                if tok.len() == 0 or lower.starts_with("url(") or _skip_numeric_token(tok):
                    tok_start = i + 1
                elif lower == "currentcolor":
                    if depth < 3:
                        val color_value = _decl_value_last(decls, "color", "color")
                        if color_value.len() > 0:
                            val resolved = _value_first_color(color_value, decls, html, depth + 1)
                            if resolved != nil:
                                return resolved
                    tok_start = i + 1
                elif lower.starts_with("var("):
                    if depth < 3:
                        val close = _find_char_from(tok, ")", 4)
                        val raw = if close > 4: (tok.substring(4, close) ?? "") else: ""
                        val referenced = _custom_property_value(html, raw.trim())
                        if referenced.len() > 0:
                            val resolved_var = _value_first_color(referenced, decls, html, depth + 1)
                            if resolved_var != nil:
                                return resolved_var
                    tok_start = i + 1
                else:
                    val parsed = parse_color_value_checked(tok)
                    if parsed != nil:
                        return parsed
                    tok_start = i + 1
            else:
                tok_start = i + 1
        i = i + 1
    nil

# Alpha of an rgba()/hsla() value as the author wrote it, or -1.0 when the
# value carries no explicit alpha component. CSS alpha is a NUMBER, not a byte:
# `rgba(0, 0, 0, 0.5)` over white is 127.5 -> 128, while the byte the color
# parser quantizes 0.5 to (128) would composite to 127. Compositing from the
# unrounded author value is what a browser does and is a 1-LSB difference on
# exactly the fractional cases.
fn _explicit_alpha_f(value: text) -> f64:
    val lo = value.lower()
    var open_at = lo.index_of("rgba(")
    val skip = 5
    if open_at < 0:
        open_at = lo.index_of("hsla(")
    if open_at < 0:
        return -1.0
    val close = _find_char_from(value, ")", open_at + skip)
    if close < 0:
        return -1.0
    val inner = value.substring(open_at + skip, close) ?? ""
    var cut = -1
    val slash = inner.index_of("/")
    if slash >= 0:
        cut = slash
    else:
        var i: i64 = 0
        while i < inner.len():
            if inner.char_at(i) == ",":
                cut = i
            i = i + 1
    if cut < 0:
        return -1.0
    val tail = (inner.substring(cut + 1, inner.len()) ?? "").trim()
    if tail.len() == 0:
        return -1.0
    val is_pct = tail.ends_with("%")
    val number = if is_pct: (tail.substring(0, tail.len() - 1) ?? "") else: tail
    val parsed = number.parse_f64()
    if parsed == nil:
        return -1.0
    var a = parsed ?? 0.0
    if is_pct:
        a = a / 100.0
    if a < 0.0 or a > 1.0:
        return -1.0
    a

# Porter-Duff `over` against the UA default white page, in ARGB.
# `alpha_f` is the author's unrounded alpha when the value carried one, else
# -1.0 and the color's own alpha byte is used.
fn _composite_over_white(rgba: u32, alpha_f: f64) -> u32:
    val r = (rgba >> 24) & 0xFFu32
    val g = (rgba >> 16) & 0xFFu32
    val b = (rgba >> 8) & 0xFFu32
    val a_byte = rgba & 0xFFu32
    if a_byte >= 255u32 and alpha_f < 0.0:
        return 0xFF000000u32 | (r << 16) | (g << 8) | b
    val a = if alpha_f >= 0.0: alpha_f else: a_byte.to_f64() / 255.0
    val cr = _composite_channel(r, a)
    val cg = _composite_channel(g, a)
    val cb = _composite_channel(b, a)
    0xFF000000u32 | (cr << 16) | (cg << 8) | cb

fn _composite_channel(channel: u32, alpha: f64) -> u32:
    val blended = channel.to_f64() * alpha + 255.0 * (1.0 - alpha) + 0.5
    if blended <= 0.0:
        return 0u32
    if blended >= 255.0:
        return 255u32
    blended.to_i64().to_u32()

# Computed background color of a declaration list, as ARGB. `fallback` is
# returned when the list declares no background, when the value carries no
# color token, and when the resolved color is fully transparent (the caller
# owns what shows through).
fn _declaration_background_color_in(declarations: text, html: text, fallback: u32) -> u32:
    val value = _decl_value_last(declarations, "background-color", "background")
    if value.len() == 0:
        return fallback
    val parsed = _value_first_color(value, declarations, html, 0)
    if parsed == nil:
        return fallback
    val rgba = parsed ?? 0u32
    val alpha_f = _explicit_alpha_f(value)
    if (rgba & 0xFFu32) == 0u32 and alpha_f < 0.0:
        return fallback
    if alpha_f == 0.0:
        return fallback
    _composite_over_white(rgba, alpha_f)

fn _declaration_background_color(declarations: text, fallback: u32) -> u32:
    _declaration_background_color_in(declarations, declarations, fallback)

fn _custom_property_color(html: text, property_name: text, fallback: u32) -> u32:
    if property_name == "":
        return fallback
    val marker = property_name + ":"
    val pos = html.index_of(marker)
    if pos < 0:
        return fallback
    val hash = _find_char_from(html, "#", pos + marker.len())
    if hash < 0:
        return fallback
    _hex_color_at(html, hash, fallback)

fn _first_var_color_after_from(html: text, marker: text, search_start: i64, fallback: u32) -> u32:
    val start = _find_text_from(html, marker, search_start)
    if start < 0:
        return fallback
    val var_pos = _find_text_from(html, "var(", start + marker.len())
    if var_pos < 0:
        return fallback
    val close = _find_char_from(html, ")", var_pos + 4)
    if close <= 0:
        return fallback
    val raw_property = html.substring(var_pos + 4, close)
    val property_name = raw_property.trim()
    _custom_property_color(html, property_name, fallback)

fn _html_accent_color(html: text) -> u32:
    if html.contains("simple-web-success"):
        return 0xFF22C55Eu32
    if html.contains("simple-web-warning"):
        return 0xFFF59E0Bu32
    if html.contains("simple-web-accent"):
        return 0xFF2563EBu32
    0xFF2563EBu32

fn _html_background_color(html: text) -> u32:
    val body_start = html.index_of("<body")
    if body_start < 0:
        return 0xFFFFFFFFu32
    val body_tag_end = _find_char_from(html, ">", body_start)
    if body_tag_end < 0:
        return 0xFFFFFFFFu32
    val body_tag = html.substring(body_start, body_tag_end + 1) ?? ""
    val inline_style = _attr_value(body_tag, "style")
    if inline_style.len() == 0:
        return 0xFFFFFFFFu32
    _declaration_background_color_in(inline_style, html, 0xFFFFFFFFu32)

fn _find_next_visual_tag(html: text, start: i64) -> i64:
    if start >= html.len():
        return -1
    val d_pos = _find_text_from(html, "<div", start)
    val s_pos = _find_text_from(html, "<section", start)
    val sp_pos = _find_text_from(html, "<span", start)
    var best: i64 = -1
    if d_pos >= 0:
        best = d_pos
    if s_pos >= 0 and (best < 0 or s_pos < best):
        best = s_pos
    if sp_pos >= 0 and (best < 0 or sp_pos < best):
        best = sp_pos
    best

fn _attr_value(tag: text, name: text) -> text:
    val single = name + "='"
    var pos = tag.index_of(single)
    if pos >= 0:
        val start = pos + single.len()
        val end = _find_char_from(tag, "'", start)
        if end > start:
            return tag.substring(start, end)
    val dbl = name + "=\""
    pos = tag.index_of(dbl)
    if pos >= 0:
        val start2 = pos + dbl.len()
        val end2 = _find_char_from(tag, "\"", start2)
        if end2 > start2:
            return tag.substring(start2, end2)
    ""

fn _first_class_name(class_value: text) -> text:
    var token_start: i64 = 0
    val class_len = class_value.len()
    while token_start <= class_len:
        var token_end = token_start
        while token_end < class_len and class_value.substring(token_end, token_end + 1) != " ":
            token_end = token_end + 1
        var trimmed_start = token_start
        var trimmed_end = token_end
        while trimmed_start < trimmed_end and _class_token_is_trim_space(class_value.substring(trimmed_start, trimmed_start + 1)):
            trimmed_start = trimmed_start + 1
        while trimmed_end > trimmed_start and _class_token_is_trim_space(class_value.substring(trimmed_end - 1, trimmed_end)):
            trimmed_end = trimmed_end - 1
        if trimmed_end > trimmed_start:
            return class_value.substring(trimmed_start, trimmed_end)
        token_start = token_end + 1
    ""

fn _class_token_is_trim_space(ch: text) -> bool:
    ch == " " or ch == "\t" or ch == "\n" or ch == "\r"

fn _collect_class_names(class_value: text) -> [text]:
    var names: [text] = [""; 8]
    var count: i32 = 0
    var token_start: i64 = 0
    val class_len = class_value.len()
    while token_start <= class_len and count < 8:
        var token_end = token_start
        while token_end < class_len and class_value.substring(token_end, token_end + 1) != " ":
            token_end = token_end + 1
        var trimmed_start = token_start
        var trimmed_end = token_end
        while trimmed_start < trimmed_end and _class_token_is_trim_space(class_value.substring(trimmed_start, trimmed_start + 1)):
            trimmed_start = trimmed_start + 1
        while trimmed_end > trimmed_start and _class_token_is_trim_space(class_value.substring(trimmed_end - 1, trimmed_end)):
            trimmed_end = trimmed_end - 1
        if trimmed_end > trimmed_start:
            names[count] = class_value.substring(trimmed_start, trimmed_end)
            count = count + 1
        token_start = token_end + 1
    var result: [text] = [""; count]
    var i: i32 = 0
    while i < count:
        result[i] = names[i]
        i = i + 1
    result

fn _class_token_equals(class_value: text, start: i64, end: i64, class_name: text) -> bool:
    if end - start != class_name.len():
        return false
    var idx: i64 = 0
    while start + idx < end:
        if class_value.char_at(start + idx) != class_name.char_at(idx):
            return false
        idx = idx + 1
    true

fn _class_has(class_value: text, class_name: text) -> bool:
    if class_name == "":
        return class_value.trim() == ""
    var token_start: i64 = 0
    val class_len = class_value.len()
    while token_start <= class_len:
        var token_end = token_start
        while token_end < class_len and class_value.char_at(token_end) != " ":
            token_end = token_end + 1
        var trimmed_start = token_start
        var trimmed_end = token_end
        while trimmed_start < trimmed_end and _class_token_is_trim_space(class_value.char_at(trimmed_start)):
            trimmed_start = trimmed_start + 1
        while trimmed_end > trimmed_start and _class_token_is_trim_space(class_value.char_at(trimmed_end - 1)):
            trimmed_end = trimmed_end - 1
        if _class_token_equals(class_value, trimmed_start, trimmed_end, class_name):
            return true
        token_start = token_end + 1
    false
fn _first_block_tag(html: text) -> text:
    val block = _find_next_visual_tag(html, 0)
    if block < 0:
        return ""
    val end = _find_char_from(html, ">", block)
    if end < 0:
        return ""
    html.substring(block, end + 1)

fn _tag_name_from_tag(tag: text) -> text:
    if tag.starts_with("<section"):
        return "section"
    if tag.starts_with("<span"):
        return "span"
    "div"

fn _first_block_has_direct_child_class(html: text, class_name: text) -> bool:
    val block = _find_next_visual_tag(html, 0)
    if block < 0:
        return false
    val open_end = _find_char_from(html, ">", block)
    if open_end < 0:
        return false
    val child_start = _find_next_visual_tag(html, open_end + 1)
    if child_start < 0:
        return false
    val child_end = _find_char_from(html, ">", child_start)
    if child_end < 0:
        return false
    val first_close = _find_text_from(html, "</", open_end + 1)
    if first_close >= 0 and first_close < child_start:
        return false
    val child_tag = html.substring(child_start, child_end + 1)
    _class_has(_attr_value(child_tag, "class"), class_name)

fn _last_rule_hex_color(html: text, selector: text, fallback: u32) -> u32:
    if selector == "":
        return fallback
    var color = fallback
    var pos: i64 = 0
    val html_len = html.len()
    while pos < html_len:
        val found = _find_text_from(html, selector, pos)
        if found < 0:
            return color
        val open = _find_char_from(html, "{", found)
        if open >= 0:
            val close = _find_char_from(html, "}", open + 1)
            if close >= 0:
                val rule = html.substring(open + 1, close)
                color = _declaration_background_color(rule, color)
        pos = found + selector.len()
    color

fn _not_selector_rejects_first_block(html: text, tag_name: text, tag: text) -> bool:
    val marker = tag_name + ":not("
    val start = html.index_of(marker)
    if start < 0:
        return false
    val options_start = start + marker.len()
    val close = _find_char_from(html, ")", options_start)
    if close < 0:
        return false
    val options = html.substring(options_start, close)
    val class_value = _attr_value(tag, "class")
    if class_value != "":
        val classes = class_value.split(" ")
        var i = 0
        val class_count = classes.len()
        while i < class_count:
            val cls = classes[i].trim()
            if cls != "" and options.contains("." + cls):
                return true
            i = i + 1
    val id_value = _attr_value(tag, "id")
    if id_value != "" and options.contains("#" + id_value):
        return true
    false

fn _last_attribute_rule_color_for_value(html: text, tag_name: text, attr_name: text, attr_value: text, color: u32) -> u32:
    if attr_value == "":
        return color
    var next = color
    if attr_name != "data-route":
        next = _last_rule_hex_color(html, "[" + attr_name + "]", next)
        next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "]", next)
        next = _last_rule_hex_color(html, "[" + attr_name + "='" + attr_value + "']", next)
        next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "='" + attr_value + "']", next)
        next = _last_rule_hex_color(html, "[" + attr_name + "=\"" + attr_value + "\"]", next)
        next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "=\"" + attr_value + "\"]", next)

    if attr_name == "data-route":
        if attr_value.starts_with("/app"):
            next = _last_rule_hex_color(html, "[" + attr_name + "^='/app']", next)
            next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "^='/app']", next)
        if attr_value.ends_with("/settings"):
            next = _last_rule_hex_color(html, "[" + attr_name + "$='/settings']", next)
            next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "$='/settings']", next)
    if attr_name == "data-tags" and attr_value.contains("beta"):
        next = _last_rule_hex_color(html, "[" + attr_name + "*='beta']", next)
        next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "*='beta']", next)
    if attr_name == "data-flags" and (" " + attr_value + " ").contains(" selected "):
        next = _last_rule_hex_color(html, "[" + attr_name + "~='selected']", next)
        next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "~='selected']", next)
    if attr_name == "lang" and (attr_value == "en" or attr_value.starts_with("en-")):
        next = _last_rule_hex_color(html, "[" + attr_name + "|='en']", next)
        next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "|='en']", next)
    if attr_name == "data-mode":
        if attr_value == "Dialog":
            next = _last_rule_hex_color(html, "[" + attr_name + "='Dialog' s]", next)
            next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "='Dialog' s]", next)
        if attr_value.lower() == "dialog":
            next = _last_rule_hex_color(html, "[" + attr_name + "='dialog' i]", next)
            next = _last_rule_hex_color(html, tag_name + "[" + attr_name + "='dialog' i]", next)
    next

fn _last_attribute_rule_color(html: text, tag_name: text, tag: text, color: u32) -> u32:
    var next = color
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-card", _attr_value(tag, "data-card"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-state", _attr_value(tag, "data-state"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-label", _attr_value(tag, "data-label"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-route", _attr_value(tag, "data-route"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-tags", _attr_value(tag, "data-tags"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-flags", _attr_value(tag, "data-flags"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "lang", _attr_value(tag, "lang"), next)
    next = _last_attribute_rule_color_for_value(html, tag_name, "data-mode", _attr_value(tag, "data-mode"), next)
    next

fn _style_rule_block_color(html: text, fallback: u32) -> u32:
    if html.contains("div:not(.card") and (html.contains("class='card'") or html.contains("class=\"card\"")):
        return fallback
    val tag = _first_block_tag(html)
    if tag != "" and _not_selector_rejects_first_block(html, _tag_name_from_tag(tag), tag):
        return fallback
    val style_pos = html.index_of("<style")
    if style_pos >= 0:
        val style_var = _first_var_color_after_from(html, "background-color", style_pos, fallback)
        if style_var != fallback:
            return style_var
        val style_bg_var = _first_var_color_after_from(html, "background:", style_pos, fallback)
        if style_bg_var != fallback:
            return style_bg_var
    if tag == "":
        return fallback
    val tag_name = _tag_name_from_tag(tag)
    var color = _last_rule_hex_color(html, tag_name + " {", fallback)
    if tag_name == "div" and html.contains("div:has(> .badge)") and _first_block_has_direct_child_class(html, "badge"):
        color = _last_rule_hex_color(html, "div:has(> .badge)", color)
    if tag_name == "div" and html.contains("div:has(>.badge)") and _first_block_has_direct_child_class(html, "badge"):
        color = _last_rule_hex_color(html, "div:has(>.badge)", color)
    color = _last_attribute_rule_color(html, tag_name, tag, color)
    val id_value = _attr_value(tag, "id")
    if id_value != "":
        val id_color = _last_rule_hex_color(html, "#" + id_value, color)
        color = id_color
    val class_name = _first_class_name(_attr_value(tag, "class"))
    if class_name != "":
        val class_color = _last_rule_hex_color(html, "." + class_name, color)
        color = class_color
        if color == fallback:
            val loose_class_color = _last_rule_hex_color(html, class_name, color)
            color = loose_class_color
        val tag_class_color = _last_rule_hex_color(html, tag_name + "." + class_name, color)
        color = tag_class_color
    if html.contains("class='card'") or html.contains("class=\"card\"") or html.contains("class='primary card'") or html.contains("class='card primary'"):
        color = _last_hex_color_after(html, "card", color)
        color = _last_rule_hex_color(html, ".card", color)
        color = _last_rule_hex_color(html, tag_name + ".card", color)
    if html.contains("class='label'") or html.contains("class=\"label\""):
        color = _last_rule_hex_color(html, ".label", color)
    if html.contains("class='target'") or html.contains("class=\"target\""):
        color = _last_rule_hex_color(html, ".target", color)
    color

fn _first_block_color(html: text, fallback: u32) -> u32:
    val block = _find_next_visual_tag(html, 0)
    if block < 0:
        return fallback
    val tag_end = _find_char_from(html, ">", block)
    if tag_end >= 0:
        val tag_text = html.substring(block, tag_end)
        val inline_color = _declaration_background_color(tag_text, fallback)
        if inline_color != fallback:
            return inline_color
    _style_rule_block_color(html, fallback)

# True when `sel` is a simple selector the `_style_rule_block_color` heuristic
# can faithfully resolve against the first visual block: a bare tag, `.class`,
# `#id`, or `tag.class` naming that block's own tag / id / first class. Any
# combinator, pseudo-class, attribute or functional form is unresolvable.
fn _selector_token_is_resolvable(sel: text, tag_name: text, id_value: text, class_name: text) -> bool:
    val s = sel.trim()
    if s == "":
        return false
    if s.contains(" ") or s.contains("\t") or s.contains("\n") or s.contains("\r") or
       s.contains(">") or s.contains("+") or s.contains("~") or s.contains(":") or
       s.contains("[") or s.contains("*") or s.contains("("):
        return false
    var rest = s
    if not (rest.starts_with(".") or rest.starts_with("#")):
        val dot = rest.index_of(".")
        val hash = rest.index_of("#")
        var cut = rest.len()
        if dot >= 0 and dot < cut:
            cut = dot
        if hash >= 0 and hash < cut:
            cut = hash
        if rest.substring(0, cut).lower() != tag_name.lower():
            return false
        rest = rest.substring(cut, rest.len())
    if rest == "":
        return true
    if rest.starts_with("#"):
        return id_value != "" and rest.substring(1, rest.len()) == id_value
    if rest.starts_with("."):
        val cls = rest.substring(1, rest.len())
        return class_name != "" and cls == class_name
    false

fn _selector_group_is_resolvable(sel: text, tag_name: text, id_value: text, class_name: text) -> bool:
    if tag_name == "":
        return false
    val parts = sel.split(",")
    var i = 0
    val n = parts.len()
    while i < n:
        val p = parts[i].trim()
        if p != "" and (p.contains(".") or p.contains("#")) and
           not _selector_token_is_resolvable(p, tag_name, id_value, class_name):
            return false
        i = i + 1
    true

# A class/id selector no longer forces the (much slower) full layout path by
# itself — the heuristic above already resolves `.class` / `#id` / `tag.class`
# rules for the first visual block. Only selectors it CANNOT resolve route to
# the real renderer.
fn _style_block_has_class_or_id_selector(html: text) -> bool:
    val first_tag = _first_block_tag(html)
    val tag_name = if first_tag != "": _tag_name_from_tag(first_tag) else: ""
    val id_value = if first_tag != "": _attr_value(first_tag, "id") else: ""
    val class_name = if first_tag != "": _first_class_name(_attr_value(first_tag, "class")) else: ""
    # The paint path below draws a phantom SECOND block from the second
    # `background-color` it finds in source order (see
    # `_second_hex_color_after_from`). That heuristic assumes the two colours
    # belong to two sibling elements, so a style block carrying more than one
    # background-setting rule is NOT faithfully reproducible here even when
    # every selector is individually resolvable — route it to the real engine.
    var background_rules = 0
    var pos = 0
    var guard = 0
    while guard < 1000:
        guard = guard + 1
        val style_start = _find_text_from(html, "<style", pos)
        if style_start < 0:
            return false
        val open = _find_char_from(html, ">", style_start)
        if open < 0:
            return false
        val css_start = open + 1
        val close = _find_text_from(html, "</style", css_start)
        if close < 0:
            return false
        var cp = css_start
        while cp < close:
            val brace = _find_char_from(html, "{", cp)
            if brace < 0 or brace >= close:
                break
            if _range_contains_char(html, cp, brace, ".") or _range_contains_char(html, cp, brace, "#"):
                if not _selector_group_is_resolvable(html.substring(cp, brace), tag_name, id_value, class_name):
                    return true
            val end = _find_char_from(html, "}", brace)
            if end < 0 or end >= close:
                break
            if html.substring(brace + 1, end).contains("background"):
                background_rules = background_rules + 1
                if background_rules > 1:
                    return true
            cp = end + 1
        pos = close + 8
    false

fn _selector_boundary_before(html: text, pos: i64) -> bool:
    if pos == 0:
        return true
    val prev = html.char_at(pos - 1)
    prev == " " or prev == "\t" or prev == "\n" or prev == "\r" or
    prev == ">" or prev == "," or prev == "{" or prev == "}" or prev == ";"

# After a selector token: skip whitespace (and a grouped-selector tail like
# "html, body") up to the rule's opening brace. Returns -1 when the token is
# not a bare element selector for this rule (descendant/class-qualified forms
# like "body div" or "body.dark" are rejected).
fn _selector_rule_open_brace(html: text, sel_end: i64, limit: i64) -> i64:
    var i = sel_end
    var in_group_tail = false
    while i < limit:
        val ch = html.char_at(i)
        if ch == "{":
            return i
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            i = i + 1
        elif ch == ",":
            in_group_tail = true
            i = i + 1
        elif in_group_tail:
            i = i + 1
        else:
            return -1
    -1

fn _style_range_selector_color(html: text, start: i64, end: i64, selector: text, fallback: u32) -> u32:
    var color = fallback
    var pos = start
    var guard = 0
    val sel_len = selector.len()
    while guard < 1000:
        guard = guard + 1
        val found = _find_text_from(html, selector, pos)
        if found < 0 or found >= end:
            return color
        pos = found + sel_len
        if _selector_boundary_before(html, found):
            val brace = _selector_rule_open_brace(html, found + sel_len, end)
            if brace >= 0:
                val close = _find_char_from(html, "}", brace + 1)
                if close >= 0 and close <= end:
                    val rule = html.substring(brace + 1, close)
                    color = _declaration_background_color(rule, color)
    color

# Document background from `body { ... }` / `html { ... }` rules inside
# <style> blocks — the standard shape for stylesheet-driven pages (including
# the build/tmp missing-file fallback pages). Later rules win; a `body` rule
# wins over an `html` rule. Boundary checks keep `tbody`/`.body` out.
fn _style_body_rule_color(html: text, fallback: u32) -> u32:
    var html_color = fallback
    var body_color = fallback
    var pos = 0
    var guard = 0
    while guard < 1000:
        guard = guard + 1
        val style_start = _find_text_from(html, "<style", pos)
        if style_start < 0:
            break
        val open = _find_char_from(html, ">", style_start)
        if open < 0:
            break
        val css_start = open + 1
        val close = _find_text_from(html, "</style", css_start)
        if close < 0:
            break
        body_color = _style_range_selector_color(html, css_start, close, "body", body_color)
        html_color = _style_range_selector_color(html, css_start, close, "html", html_color)
        pos = close + 8
    if body_color != fallback:
        return body_color
    html_color

# Routing seam: true when `<style>` carries a selector the fast heuristic
# cannot resolve, so the page must go through the full layout/paint engine.
# Exposed so specs can assert the routing decision directly instead of
# inferring it from wall-clock time.
pub fn simple_web_html_needs_selector_layout(html: text) -> bool:
    _style_block_has_class_or_id_selector(html)

pub fn simple_web_html_background_color(html: text) -> u32:
    val bg = _html_background_color(html)
    if bg != 0xFFFFFFFFu32:
        return bg
    val style_bg = _style_body_rule_color(html, 0xFFFFFFFFu32)
    if style_bg != 0xFFFFFFFFu32:
        return style_bg
    _first_block_color(html, bg)

fn _solid_fill_pixels(width: i32, height: i32, color: u32) -> [u32]:
    [color; width * height]

fn _first_px_dimension(html: text, prop: text, fallback: i32) -> i32:
    val lo = html.lower()
    val key = prop + ":"
    val idx = lo.index_of(key)
    if idx < 0:
        return fallback
    if idx > 0 and lo.char_code_at(idx - 1) == 45:
        return fallback
    var pos = idx + key.len()
    val n = lo.len()
    while pos < n and lo.char_code_at(pos) == 32:
        pos = pos + 1
    var value: i64 = 0
    var digits = 0
    while pos < n:
        val c = lo.char_code_at(pos)
        if c >= 48 and c <= 57:
            value = value * 10 + (c - 48)
            digits = digits + 1
            pos = pos + 1
        else:
            break
    if digits == 0:
        return fallback
    if pos + 2 <= n and lo.substring(pos, pos + 2) == "px":
        return value.to_i32()
    fallback

# Generic HTML goes through the real layout/paint engine
# (simple_web_html_layout_renderer): parse -> CSS cascade -> block layout ->
# paint text+boxes. The substring-heuristic branches below are only a fast
# path for a narrow set of trivially-resolvable shapes (a solid resolved
# background color, a single first-block color, or the wm-app
# titlebar/content chrome and the "Simple Web"/about:network mark drawn by
# this module's own callers) — anything requiring CSS selector matching or
# real box layout routes straight to the real renderer. No fixture marker is
# handled here: the class-name-keyed toolbar-modal-grid painter that used to
# sit at the top of this function was a canned pixel grid, not a rendering.
pub fn simple_web_engine2d_render_html_pixels(html: text, width: i32, height: i32, backend_name: text) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    val resolved_backend = _resolved_render_backend(width, height, backend_name)
    val lower = html.lower()
    if lower.contains("<p") or lower.contains("<h1") or lower.contains("<h2") or lower.contains("<h3") or lower.contains("<button") or lower.contains("<span") or lower.contains("<small") or lower.contains("<code") or lower.contains("<label") or lower.contains("<a "):
        return simple_web_layout_render_html_pixels_engine2d(html, width, height, resolved_backend)
    # display:contents collapses the wrapper box — the heuristic would paint its
    # background-color when block_color != 0. Route to layout renderer instead.
    if html.contains("display:contents") or html.contains("display: contents"):
        return simple_web_layout_render_html_pixels(html, width, height, resolved_backend)

    val bg = _html_background_color(html)
    val block_color = _first_block_color(html, 0u32)
    val has_wm_titlebar = html.contains("wm-app-titlebar")
    val has_wm_content = html.contains("wm-app-content")
    val has_simple_web_mark = html.contains("Simple Web") or html.contains("about:network")
    # WM class names can appear in package/adapter CSS even when no matching
    # titlebar element exists. The former substring heuristic painted a fixed
    # blue/slate demo palette over the fully resolved Aetheric document. WM
    # content always needs real selector matching and CSS layout.
    if has_wm_titlebar or has_wm_content:
        return simple_web_layout_render_html_pixels(html, width, height, resolved_backend)
    val needs_selector_layout = _style_block_has_class_or_id_selector(html)
    # Result-based discriminator: route to the heuristic only when it
    # recognizes structure it can faithfully reproduce (a resolved background
    # color, a first-block color, or the wm-app titlebar/content/mark
    # elements handled below); otherwise lay out for real through the core
    # HTML/CSS parse -> layout -> paint engine.
    val heuristic_recognized = not needs_selector_layout and (bg != 0xFFFFFFFFu32 or block_color != 0u32 or has_wm_titlebar or has_wm_content or has_simple_web_mark)
    if not heuristic_recognized:
        return simple_web_layout_render_html_pixels(html, width, height, resolved_backend)

    val has_accent_stripes = bg == 0xFFFFFFFFu32 and block_color == 0u32
    if block_color == 0u32 and not has_accent_stripes and not has_wm_titlebar and not has_wm_content and not has_simple_web_mark:
        return _solid_fill_pixels(width, height, bg)

    var engine = SimpleWebHeuristicSurface.create(width, height)

    engine.clear(bg)

    if block_color != 0u32 and block_color != bg:
        val has_margin_zero = html.contains("margin:0") or html.contains("margin: 0")
        val margin = if has_margin_zero: 0 else: 8
        val block_w = _first_px_dimension(html, "width", 24)
        val block_h = _first_px_dimension(html, "height", 16)
        engine.draw_rect_filled(margin, margin, block_w, block_h, block_color)
        val block = _find_next_visual_tag(html, 0)
        val second_color = if block >= 0: _second_hex_color_after_from(html, "background-color", block, 0u32) else: 0u32
        if second_color != 0u32 and second_color != block_color:
            engine.draw_rect_filled(margin, margin + block_h, block_w, block_h, second_color)

    val accent = _html_accent_color(html)
    if has_accent_stripes:
        var stripe_x = 0
        while stripe_x < width:
            engine.draw_rect_filled(stripe_x, 0, 1, height, accent)
            stripe_x = stripe_x + 17

    val header_h = if height < 24: height else: 24
    if has_simple_web_mark:
        engine.draw_rect_filled(6, 6, 24, 3, 0xFFFFFFFFu32)

    val pixels = engine.read_pixels()
    engine.shutdown()
    pixels

pub fn simple_web_engine2d_render_html_pixels_at_time(html: text, width: i32, height: i32, backend_name: text, animation_time_ms: i64) -> [u32]:
    val resolved_backend = _resolved_render_backend(width, height, backend_name)
    simple_web_layout_render_html_pixels_engine2d_at_time(
        html, width, height, resolved_backend, animation_time_ms
    )

pub fn simple_web_engine2d_render_html_pixels_at_time_with_animations(
    html: text, width: i32, height: i32, backend_name: text,
    animation_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance]
) -> [u32]:
    val resolved_backend = _resolved_render_backend(width, height, backend_name)
    simple_web_layout_render_html_pixels_engine2d_at_time_with_animations(
        html, width, height, resolved_backend, animation_time_ms,
        animation_instances
    )

pub fn simple_web_engine2d_render_html_readback(html: text, width: i32, height: i32, backend_name: text) -> Engine2DReadback:
    if width <= 0 or height <= 0:
        return engine2d_readback([], "not_requested")
    val resolved_backend = _resolved_render_backend(width, height, backend_name)
    if (html.contains("display:contents") or html.contains("display: contents")) and resolved_backend != "software" and resolved_backend != "cpu" and resolved_backend != "cpu_simd":
        return simple_web_layout_render_html_readback(html, width, height, resolved_backend)
    val pixels = simple_web_engine2d_render_html_pixels(html, width, height, resolved_backend)
    if resolved_backend != "software" and resolved_backend != "cpu" and resolved_backend != "cpu_simd":
        val base = if html.contains("widget-panel"): 0xFFF5F5F5u32 else: 0xFFFFFFFFu32
        return present_layout_pixels_with_engine2d_readback(pixels, width, height, resolved_backend, base)
    engine2d_readback(pixels, "cpu_mirror")

pub fn simple_web_engine2d_resolved_backend_name(width: i32, height: i32, backend_name: text) -> text:
    val (resolved, _reason) = simple_web_engine2d_resolved_backend_name_with_reason(width, height, backend_name)
    resolved

# Same resolution as simple_web_engine2d_resolved_backend_name, but also
# returns the probe-failure reason (empty when no fallback occurred) so
# callers can surface WHY a requested backend was downgraded to "software"
# instead of silently swallowing the probe result.
pub fn simple_web_engine2d_resolved_backend_name_with_reason(width: i32, height: i32, backend_name: text) -> (text, text):
    val canonical = backend_canonical_name(backend_name)
    # An empty/unset backend_name (e.g. a struct field that was never
    # populated, or SIMPLE_2D_BACKEND read as "" on baremetal where there is
    # no process environment) must fall through to the same viability-gated
    # auto-resolution as "auto" — NOT be probed literally as backend "",
    # which always fails with "Unknown backend: " and previously left the
    # caller invoking the resolved name against hosted-only fallbacks.
    if canonical == "auto" or canonical == "":
        # Viability-gated auto-resolution: a GPU backend that inits but cannot
        # render (e.g. CUDA headless) is rejected with a logged reason and the
        # next GPU candidate (cuda -> vulkan -> ...) is tried before CPU lanes.
        # Memoized in Engine2D, so this costs one probe pass per process.
        return (Engine2D.detect_best_backend_viable(), "")
    if canonical == "cpu" or canonical == "software":
        return (canonical, "")
    val probe = Engine2D.probe_backend(width, height, canonical)
    if probe.status == BackendStatus.Initialized:
        return (canonical, "")
    val reason = if probe.reason != "": probe.reason else: "backend '" + canonical + "' probe did not initialize"
    ("software", reason)

pub fn simple_web_render_html_to_pixels_with_engine2d_backend(html: text, width: i32, height: i32, backend_name: text) -> [u32]:
    simple_web_engine2d_render_html_pixels(html, width, height, backend_name)
