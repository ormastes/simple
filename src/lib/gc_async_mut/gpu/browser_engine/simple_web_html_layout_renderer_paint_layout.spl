fn _html_draw_ir_component_id(node: HNode, i: i32) -> text:
    if node.id_attr != "":
        return node.id_attr
    if node.tag == "#text":
        return "text_{i}"
    "{node.tag}_{i}"

fn _html_draw_ir_non_negative(value: i32) -> i32:
    if value < 0:
        return 0
    value

fn _html_draw_ir_shadow_layer_count(value: text) -> i32:
    if value == "":
        return 0
    split_top_level_commas(value).len() as i32

fn _html_draw_ir_clamp_i64(value: i64, low: i64, high: i64) -> i64:
    if value < low:
        return low
    if value > high:
        return high
    value

fn _html_draw_ir_wm_fallback_color(node: HNode, st: Style) -> u32:
    val wm_fallback = attr_value(
        node.attrs_raw, "data-wm-theme-fallback").trim().lower()
    if wm_fallback != "solid-material":
        return st.bg
    val declared = parse_color_any(attr_value(node.attrs_raw, "data-wm-theme-bg").trim())
    if ((declared >> 24) & 255u32) == 255u32:
        return declared
    if ((st.bg >> 24) & 255u32) == 255u32:
        return st.bg
    # Incomplete contracts still need native-safe opaque transport. They do
    # not receive a material capability or any realized witness.
    0xFF000000u32 | (st.bg & 0x00FFFFFFu32)

# CSS `text-decoration-line` serialization: space-separated in canonical order,
# or "none". Keeps the DrawIR metadata in lock-step with what the raster path
# actually paints - the two disagreeing was the original defect here.
fn _text_decoration_line_text(st: Style) -> text:
    var out = ""
    if st.text_decoration_underline:
        out = "underline"
    if st.text_decoration_overline:
        out = if out == "": "overline" else: "{out} overline"
    if st.text_decoration_line_through:
        out = if out == "": "line-through" else: "{out} line-through"
    if out == "":
        return "none"
    out


fn _html_draw_ir_style_props(node: HNode, st: Style) -> [DrawIrStyleProp]:
    # Level-gated consumption-site trace (default off), joining the
    # SIMPLE_TRACE_FONT_STYLE family already landed in
    # simple_web_html_layout_renderer_core.spl. This is the CONSUMER named in
    # doc/08_tracking/bug/jit_run_file_pipeline_gaps_2026-07-30.md 16.5: the
    # sole style source (renderer.spl:1482) is proven correct, so the
    # divergence must be between computation and consumption. Printing the
    # node's identity next to the Style it was PAIRED WITH answers whether the
    # marker node receives a wrong Style, or a different node's Style entry
    # (an index/ordering mismatch in the paint-order/visible-node filters).
    if (env_get("SIMPLE_TRACE_FONT_STYLE") ?? "") == "1":
        val trace_id: text = attr_value(node.attrs_raw, "id")
        val trace_class: text = attr_value(node.attrs_raw, "class")
        val trace_is_marker: bool = trace_id.contains("vector-font-evidence")
        if trace_is_marker or st.font_family.contains("Bungee") or st.resolved_font_identity.contains("Bungee"):
            print "draw_ir_style_props_pairing tag={node.tag} id={trace_id} class={trace_class} marker={trace_is_marker} font_family={st.font_family} font_size={st.font_size} identity={st.resolved_font_identity}"
    val wm_fallback = attr_value(node.attrs_raw, "data-wm-theme-fallback")
    val wm_solid_fallback = wm_fallback == "solid-material"
    val material_mode_attr = attr_value(node.attrs_raw, "data-wm-theme-material-mode")
    val material_mode = material_mode_attr == "engine2d-cpu-composited-material-v1"
    val declared_fallback_attr = attr_value(node.attrs_raw, "data-wm-theme-bg")
    val declared_fallback_color = parse_color_any(declared_fallback_attr)
    val declared_fallback_opaque = (
        declared_fallback_attr != "" and
        ((declared_fallback_color >> 24) & 255u32) == 255u32
    )
    val bg_alpha = (st.bg >> 24) & 255u32
    val backdrop_requested = st.backdrop_filter_raw != ""
    val has_gradient = (
        st.background_gradient_from != 0u32 and
        st.background_gradient_to != 0u32
    )
    val typed_stops_absent = (
        st.background_gradient_from == 0u32 and
        st.background_gradient_to == 0u32
    )
    val typed_stops_present = (
        st.background_gradient_from != 0u32 and
        st.background_gradient_to != 0u32
    )
    val typed_stops_valid = typed_stops_absent or typed_stops_present
    val raw_layers_empty = st.bg_layers_raw == ""
    val backdrop = simple_web_backdrop_admission(st.backdrop_filter_raw)
    # The CPU material path supports a translucent base with at most one
    # normalized linear-gradient layer. Extra/radial stacks remain fail-closed
    # on the opaque command fallback instead of overstating layered parity.
    val material_ready = (
        material_mode and wm_solid_fallback and
        declared_fallback_opaque and backdrop.admitted and
        bg_alpha > 0u32 and bg_alpha < 255u32 and
        raw_layers_empty and typed_stops_valid
    )
    if material_mode_attr != "" and not material_ready:
        # Bounded defect receipt (contract nodes only): this duplicated
        # admission re-derivation disagreeing with compute_styles_with_material
        # is exactly how a realized material executes zero cpu-composited
        # commands (witness-unconverted). Name the failing conjunct.
        print "[web-paint] material-not-ready mode={material_mode} solid={wm_solid_fallback} declared_opaque={declared_fallback_opaque} declared_attr_len={declared_fallback_attr.len()} backdrop_admitted={backdrop.admitted} backdrop_len={st.backdrop_filter_raw.len()} bg_alpha={bg_alpha} layers_empty={raw_layers_empty} stops_valid={typed_stops_valid} gf={st.background_gradient_from} gt={st.background_gradient_to}"
    val realized_blur = backdrop.realized_blur_px
    val realized_saturation = backdrop.realized_saturation_milli
    # GAP-2: project the N-stop / angled / radial gradient model onto flat
    # Draw IR props. Without these the stop-list branch in
    # engine2d/draw_ir_adv.spl (`_engine2d_draw_ir_gradient_stop_count >= 2`)
    # can never fire, because nothing else in the tree writes them. A
    # radial-gradient sets background_gradient_from/to to 0 by design
    # (decl_apply), so the legacy 2-color "background-image" prop below
    # renders it as "none" and the element painted no pixels at all.
    val gradient_stop_count = st.background_gradient_stop_colors.len()
    # Accumulate through StringBuilder rather than `raw = raw + piece`: this
    # runs once per gradient-bearing node per frame, and repeated `+` on text
    # recopies the whole accumulated prefix on every stop.
    var gradient_stops_builder = StringBuilder.new()
    var gsi = 0
    while gsi < gradient_stop_count:
        if gsi > 0:
            gradient_stops_builder.push(",")
        gradient_stops_builder.push("{st.background_gradient_stop_colors[gsi]}")
        gsi = gsi + 1
    gsi = 0
    while gsi < st.background_gradient_stop_positions.len():
        gradient_stops_builder.push(",")
        gradient_stops_builder.push("{st.background_gradient_stop_positions[gsi]}")
        gsi = gsi + 1
    val gradient_stops_raw = gradient_stops_builder.build()
    val shadow_parse = parse_box_shadow_layers(
        st.box_shadow_raw, st.fg
    )
    var props = [
        draw_ir_style_prop("background-gradient-stop-count", "{gradient_stop_count}"),
        draw_ir_style_prop("background-gradient-stops", gradient_stops_raw),
        draw_ir_style_prop("background-gradient-angle-deg", "{st.background_gradient_angle_deg}"),
        draw_ir_style_prop("background-gradient-is-radial", if st.background_gradient_is_radial: "1" else: "0"),
        draw_ir_style_prop("tag", node.tag),
        draw_ir_style_prop("id", node.id_attr),
        draw_ir_style_prop("class", node.class_attr),
        draw_ir_style_prop("display", st.display),
        draw_ir_style_prop(
            "grid-template-columns", st.grid_template_columns
        ),
        draw_ir_style_prop("grid-template-rows", st.grid_template_rows),
        draw_ir_style_prop("grid-column", st.grid_column),
        draw_ir_style_prop("grid-row", st.grid_row),
        draw_ir_style_prop("flex-direction", st.flex_direction),
        draw_ir_style_prop("flex-wrap", st.flex_wrap),
        draw_ir_style_prop("justify-content", st.justify_content),
        draw_ir_style_prop("align-items", st.align_items),
        draw_ir_style_prop("align-self", st.align_self),
        draw_ir_style_prop("background-clip", st.background_clip),
        draw_ir_style_prop("background-attachment", st.background_attachment),
        draw_ir_style_prop("background-repeat", st.background_repeat),
        draw_ir_style_prop("background-size-width", "{st.background_size_w_px}"),
        draw_ir_style_prop("background-size-height", "{st.background_size_h_px}"),
        draw_ir_style_prop("background-position-x", "{st.background_position_x_px}"),
        draw_ir_style_prop("background-position-y", "{st.background_position_y_px}"),
        draw_ir_style_prop("background-color", "{st.bg}"),
        draw_ir_style_prop("background-image", if st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32: "linear-gradient({st.background_gradient_from},{st.background_gradient_to})" else: "none"),
        draw_ir_style_prop("background-layers-raw", st.bg_layers_raw),
        draw_ir_style_prop("background-origin", st.background_origin),
        # Preserve the legacy aggregate projection and authored CSS for
        # consumers that do not admit the ordered typed layer schema below.
        draw_ir_style_prop("box-shadow", if st.box_shadow_color != 0u32: "{st.box_shadow_x_px}px {st.box_shadow_y_px}px {st.box_shadow_color}" else: "none"),
        draw_ir_style_prop("box-shadow-raw", st.box_shadow_raw),
        draw_ir_style_prop("box-shadow-layer-count", "{_html_draw_ir_shadow_layer_count(st.box_shadow_raw)}"),
        draw_ir_style_prop("box-shadow-blur-radius", "{st.box_shadow_blur_px}"),
        draw_ir_style_prop("backdrop-filter", if backdrop_requested: st.backdrop_filter_raw else: "none"),
        draw_ir_style_prop("backdrop-filter-capability", if material_ready: "engine2d-cpu-composited-material-v1" elif wm_solid_fallback or backdrop_requested: "unavailable" else: "not-requested"),
        draw_ir_style_prop("backdrop-filter-fallback", if material_ready: "cpu-composited-material" elif wm_solid_fallback and material_mode_attr == "": "solid-material" else: "none"),
        draw_ir_style_prop("backdrop-filter-fallback-reason", if material_ready: "native-device-backdrop-path-pending" elif material_mode_attr != "": "incomplete-wm-material-contract" elif wm_solid_fallback: "cpu-raster-backdrop-sampling-unavailable" elif backdrop_requested: "incomplete-wm-material-contract" else: "none"),
        draw_ir_style_prop("color", "{st.fg}"),
        draw_ir_style_prop("direction", if st.direction_rtl: "rtl" else: "ltr"),
        draw_ir_style_prop("font-size", "{st.font_size}"),
        draw_ir_style_prop("font-family", st.font_family),
        draw_ir_style_prop("font-identity", st.resolved_font_identity),
        draw_ir_style_prop("font-size-adjust", st.font_size_adjust),
        draw_ir_style_prop("font-palette", st.font_palette),
        draw_ir_style_prop("font-feature-settings", st.font_feature_settings),
        draw_ir_style_prop("font-language-override", st.font_language_override),
        draw_ir_style_prop("font-variation-settings", st.font_variation_settings),
        draw_ir_style_prop("font-variant", st.font_variant),
        draw_ir_style_prop("font-variant-alternates", st.font_variant_alternates),
        draw_ir_style_prop("font-variant-caps", st.font_variant_caps),
        draw_ir_style_prop("font-variant-east-asian", st.font_variant_east_asian),
        draw_ir_style_prop("font-variant-emoji", st.font_variant_emoji),
        draw_ir_style_prop("font-variant-ligatures", st.font_variant_ligatures),
        draw_ir_style_prop("font-variant-numeric", st.font_variant_numeric),
        draw_ir_style_prop("font-variant-position", st.font_variant_position),
        draw_ir_style_prop("font-style", if st.font_style_italic: "italic" else: "normal"),
        draw_ir_style_prop("font-kerning", st.font_kerning),
        draw_ir_style_prop("font-optical-sizing", st.font_optical_sizing),
        draw_ir_style_prop("font-stretch", st.font_stretch),
        draw_ir_style_prop("font-width", st.font_width),
        draw_ir_style_prop("font-synthesis", st.font_synthesis),
        draw_ir_style_prop("font-synthesis-small-caps", st.font_synthesis_small_caps),
        draw_ir_style_prop("font-synthesis-position", st.font_synthesis_position),
        draw_ir_style_prop("font-synthesis-style", st.font_synthesis_style),
        draw_ir_style_prop("font-synthesis-weight", st.font_synthesis_weight),
        draw_ir_style_prop("font-weight", if st.bold: "bold" else: "normal"),
        draw_ir_style_prop("width", "{st.width_px}"),
        draw_ir_style_prop("height", "{st.height_px}"),
        draw_ir_style_prop("min-width", "{st.min_width_px}"),
        draw_ir_style_prop("max-width", "{st.max_width_px}"),
        draw_ir_style_prop("min-height", "{st.min_height_px}"),
        draw_ir_style_prop("max-height", "{st.max_height_px}"),
        draw_ir_style_prop(
            "position",
            if st.position_sticky:
                "sticky"
            elif st.position_absolute:
                "absolute"
            elif st.position_relative:
                "relative"
            else:
                "static"
        ),
        draw_ir_style_prop("left", "{st.left_px}"),
        draw_ir_style_prop(
            "top",
            if (
                st.position_sticky and
                st.top_px == SIMPLE_WEB_STICKY_TOP_AUTO
            ):
                "auto"
            else:
                "{st.top_px}"
        ),
        draw_ir_style_prop("right", "{st.right_px}"),
        draw_ir_style_prop("bottom", "{st.bottom_px}"),
        draw_ir_style_prop("line-height", "{style_line_h(st)}"),
        draw_ir_style_prop("letter-spacing", "{st.letter_spacing_px}"),
        draw_ir_style_prop("caret-color", if st.caret_color != 0u32: "{st.caret_color}" else: "auto"),
        draw_ir_style_prop("accent-color", if st.accent_color != 0u32: "{st.accent_color}" else: "auto"),
        draw_ir_style_prop("cursor", st.cursor),
        draw_ir_style_prop("hyphens", st.hyphens),
        draw_ir_style_prop("line-break", st.line_break),
        draw_ir_style_prop("overflow-wrap", st.overflow_wrap),
        draw_ir_style_prop("resize", st.resize),
        draw_ir_style_prop("table-layout", st.table_layout),
        draw_ir_style_prop("border-collapse", st.border_collapse),
        draw_ir_style_prop(
            "border-spacing",
            if st.border_spacing_x_px == st.border_spacing_y_px:
                "{st.border_spacing_x_px}px"
            else:
                (
                    "{st.border_spacing_x_px}px " +
                    "{st.border_spacing_y_px}px"
                )
        ),
        draw_ir_style_prop("caption-side", st.caption_side),
        draw_ir_style_prop("vertical-align", st.vertical_align),
        draw_ir_style_prop("tab-size", "{st.tab_size}"),
        draw_ir_style_prop("unicode-bidi", st.unicode_bidi),
        draw_ir_style_prop("word-break", st.word_break),
        draw_ir_style_prop("word-wrap", st.overflow_wrap),
        draw_ir_style_prop("writing-mode", st.writing_mode),
        draw_ir_style_prop("text-orientation", st.text_orientation),
        draw_ir_style_prop("text-combine-upright", st.text_combine_upright),
        draw_ir_style_prop("word-spacing", "{st.word_spacing_px}"),
        draw_ir_style_prop("text-decoration-color", if st.text_decoration_color != 0u32: "{st.text_decoration_color}" else: "currentColor"),
        draw_ir_style_prop("text-decoration-line", _text_decoration_line_text(st)),
        draw_ir_style_prop("text-indent", "{st.text_indent_px}"),
        draw_ir_style_prop("text-overflow", if st.text_overflow_ellipsis: "ellipsis" else: "clip"),
        draw_ir_style_prop("text-shadow", if st.text_shadow_color != 0u32: "{st.text_shadow_x_px}px {st.text_shadow_y_px}px {st.text_shadow_color}" else: "none"),
        draw_ir_style_prop("text-transform", st.text_transform),
        draw_ir_style_prop("text-decoration-style", st.text_decoration_style),
        draw_ir_style_prop("text-decoration-thickness", "{st.text_decoration_thickness_px}px"),
        draw_ir_style_prop("text-underline-offset", "{st.text_underline_offset_px}px"),
        draw_ir_style_prop("text-underline-position", st.text_underline_position),
        draw_ir_style_prop("text-align", st.text_align),
        draw_ir_style_prop("text-align-all", st.text_align),
        draw_ir_style_prop("text-align-last", st.text_align_last),
        draw_ir_style_prop("text-justify", st.text_justify),
        draw_ir_style_prop("transition-property", st.transition_property),
        draw_ir_style_prop("transition-duration", "{st.transition_duration_ms}ms"),
        draw_ir_style_prop("transition-delay", "{st.transition_delay_ms}ms"),
        draw_ir_style_prop("transition-timing-function", st.transition_timing_function),
        draw_ir_style_prop("animation-name", st.animation_name),
        draw_ir_style_prop("animation-duration", "{st.animation_duration_ms}ms"),
        draw_ir_style_prop("animation-delay", "{st.animation_delay_ms}ms"),
        draw_ir_style_prop("animation-timing-function", st.animation_timing_function),
        draw_ir_style_prop("animation-iteration-count", st.animation_iteration_count),
        draw_ir_style_prop("animation-direction", st.animation_direction),
        draw_ir_style_prop("animation-fill-mode", st.animation_fill_mode),
        draw_ir_style_prop("animation-play-state", st.animation_play_state),
        draw_ir_style_prop("transform-origin", st.transform_origin),
        draw_ir_style_prop("transform-box", st.transform_box),
        draw_ir_style_prop("transform-style", st.transform_style),
        draw_ir_style_prop("image-rendering", st.image_rendering),
        draw_ir_style_prop("object-fit", st.object_fit),
        draw_ir_style_prop("object-position", st.object_position),
        draw_ir_style_prop("padding-left", "{st.pad_l}"),
        draw_ir_style_prop("padding-top", "{st.pad_t}"),
        draw_ir_style_prop("padding-right", "{st.pad_r}"),
        draw_ir_style_prop("padding-bottom", "{st.pad_b}"),
        draw_ir_style_prop("margin-left", "{st.margin_l}"),
        draw_ir_style_prop("margin-right", "{st.margin_r}"),
        draw_ir_style_prop("margin-top", "{st.margin_t}"),
        draw_ir_style_prop("margin-bottom", "{st.margin_b}"),
        draw_ir_style_prop("border-left-width", "{st.border_l}"),
        draw_ir_style_prop("border-left-style", st.border_style_l),
        draw_ir_style_prop("border-radius", "{st.border_radius_px}"),
        draw_ir_style_prop("border-top-left-radius", "{st.border_radius_tl_px}"),
        draw_ir_style_prop("border-top-right-radius", "{st.border_radius_tr_px}"),
        draw_ir_style_prop("border-bottom-right-radius", "{st.border_radius_br_px}"),
        draw_ir_style_prop("border-bottom-left-radius", "{st.border_radius_bl_px}"),
        draw_ir_style_prop("border-top-width", "{st.border_t}"),
        draw_ir_style_prop("border-right-width", "{st.border_r}"),
        draw_ir_style_prop("border-right-style", st.border_style_r),
        draw_ir_style_prop("border-bottom-width", "{st.border_b}"),
        draw_ir_style_prop("border-top-color", "{st.border_color_t}"),
        draw_ir_style_prop("border-right-color", "{st.border_color_r}"),
        draw_ir_style_prop("border-bottom-color", "{st.border_color_b}"),
        draw_ir_style_prop("border-left-color", "{st.border_color_l}"),
        draw_ir_style_prop("outline-width", "{st.outline_w}"),
        draw_ir_style_prop("outline-color", "{st.outline_color}"),
        draw_ir_style_prop("outline-offset", "{st.outline_offset_px}"),
        draw_ir_style_prop("z-index", "{st.z_index}"),
        draw_ir_style_prop("visibility", if st.visibility_hidden: "hidden" else: "visible"),
        draw_ir_style_prop("content-visibility", if st.content_visibility_hidden: "hidden" else: "visible"),
        draw_ir_style_prop("will-change", st.will_change),
        draw_ir_style_prop("color-adjust", st.color_adjust),
        draw_ir_style_prop("forced-color-adjust", st.forced_color_adjust),
        draw_ir_style_prop("print-color-adjust", st.print_color_adjust),
        draw_ir_style_prop("orphans", "{st.orphans}"),
        draw_ir_style_prop("widows", "{st.widows}")
    ]
    # A malformed or unsupported declaration omits the schema completely so
    # Engine2D cannot mistake a partial typed projection for authoritative
    # paint data. The parser preserves CSS source order; consumers paint the
    # admitted layers in the order required by their box-paint phases.
    if shadow_parse.valid and shadow_parse.layers.len() <= 24:
        props.push(draw_ir_style_prop(
            "box-shadow-layer-schema", "web-box-shadow-layers-v1"
        ))
        var shadow_index = 0
        # cpu-lane-loop-ok: emits the typed box-shadow layer props; the enclosing if caps shadow_parse.layers.len() at 24, so the bound is a literal constant, not an element count - detector false positive
        while shadow_index < shadow_parse.layers.len():
            val shadow_layer = shadow_parse.layers[shadow_index]
            val shadow_prefix = "box-shadow-layer-{shadow_index}"
            props.push(draw_ir_style_prop(
                "{shadow_prefix}-kind", shadow_layer.kind
            ))
            props.push(draw_ir_style_prop(
                "{shadow_prefix}-offset-x", "{shadow_layer.offset_x_px}"
            ))
            props.push(draw_ir_style_prop(
                "{shadow_prefix}-offset-y", "{shadow_layer.offset_y_px}"
            ))
            props.push(draw_ir_style_prop(
                "{shadow_prefix}-blur-radius",
                "{shadow_layer.blur_radius_px}"
            ))
            props.push(draw_ir_style_prop(
                "{shadow_prefix}-spread-radius",
                "{shadow_layer.spread_radius_px}"
            ))
            props.push(draw_ir_style_prop(
                "{shadow_prefix}-color", "{shadow_layer.color_rgba}"
            ))
            shadow_index = shadow_index + 1
    if backdrop_requested:
        props.push(draw_ir_style_prop(
            "backdrop-filter-fallback-material-hash", ""
        ))
    if material_ready:
        props.push(draw_ir_style_prop("wm-material-request", "window-surface-glass"))
        props.push(draw_ir_style_prop(
            "wm-material-surface-alpha-milli",
            "{(bg_alpha as i64) * 1000 / 255}"
        ))
        props.push(draw_ir_style_prop("backdrop-filter-realized", "blur({realized_blur}px) saturate({realized_saturation / 10}%)"))
        props.push(draw_ir_style_prop("backdrop-filter-realized-blur-radius-px", "{realized_blur}"))
        props.push(draw_ir_style_prop("backdrop-filter-realized-saturation-milli", "{realized_saturation}"))
        if st.backdrop_filter_raw != "blur({realized_blur}px) saturate({realized_saturation / 10}%)":
            props.push(draw_ir_style_prop("backdrop-filter-reduction-reason", "cpu-blur-radius-bounded-to-4"))
        if has_gradient:
            props.push(draw_ir_style_prop(
                "background-image-composite-mode",
                "surface-then-alpha-gradient"
            ))
    props

# Validate that `cp_advances` describes `txt` in per-CODEPOINT arity and hand
# it back unchanged. Round 5 used to re-express this array per BYTE here (the
# codepoint's advance on its lead byte, 0 on each UTF-8 continuation byte)
# because the Engine2D consumer indexed its staged quads in byte space; that
# consumer defect is fixed (`font_advances_codepoint_arity` now resolves the
# index space once per batch and accepts both conventions), so the producer
# emits the CANONICAL per-codepoint array and declares it with the
# `font-advance-arity: codepoint` style prop. Returns an empty array when the
# array does not describe `txt`, so the caller falls back to the flat styled
# command rather than emitting a mis-sized array.
# The framebuffer painter keeps its own BYTE view of the same numbers
# (`style_run_byte_advances`, ..._layout.spl) derived from the identical
# per-codepoint `resolved_font_advances`, so layout, paint and Draw IR still
# measure a run identically -- only the wire arity differs.
fn _html_draw_ir_codepoint_advances(txt: text, cp_advances: [i32]) -> [i32]:
    var out: [i32] = []
    if cp_advances.len() == 0:
        return out
    if cp_advances.len() != text_codepoint_len(txt) as i32:
        return out
    cp_advances

# Emit ONE Draw IR text command for `txt`, carrying the resolved per-glyph
# advances the layout path measured the same string with. Factored out of
# `_html_draw_ir_command` in round 5 so the WRAPPED-line emitters can use the
# identical code rather than a second, flat-advance measurement model; before
# that, a wrapped run was drawn with `draw_ir_text_styled_clipped` (no
# advances) while layout had already sized its lines from real metrics.
# Falls back to the styled/flat command when vector fonts are off or the
# resolver returns nothing usable -- in which case BOTH sides are flat, which
# is consistent, rather than one side each.
fn _html_draw_ir_resolved_text_command(
    nodes: [HNode], i: i32, node: HNode, st: Style, cid: text,
    tx: i32, ty: i32, txt: text, computed_style: [DrawIrStyleProp],
    clip_rect: DrawIrRect, vector_fonts: bool
) -> DrawIrCommand:
    if not vector_fonts:
        return draw_ir_text_styled_clipped(
            cid, tx, ty, txt, st.fg, computed_style, clip_rect
        )
    # Compose-stage font resolve (round 13 target C). This is the SECOND
    # `resolve_font_metrics_with_language` per #text node -- style resolves the
    # same family/size over the node's metric text during the cascade
    # (`sec_resolve`), and this one resolves again over the painted string.
    # Timed into `lay_compose_resolve` so the compose window has a named
    # bucket; the timer is the same default-off `SIMPLE_WEB_STYLE_COUNTERS=1`
    # gate as every counter around it and reads no clock when unarmed.
    val _cr_t0 = if _wsc_on: _wsc_now_us() else: 0
    val metrics = resolve_font_metrics_with_language(
        browser_font_family_for_weight(st.font_family, st.bold), txt, st.font_size,
        _html_text_language(nodes, i, st)
    )
    if _wsc_on:
        _wlay_add(8, _wsc_now_us() - _cr_t0, 1)
    # ADVANCE ARITY (round 5 follow-up). `metrics.advances` carries one advance
    # per CODEPOINT and that is exactly what now goes on the wire: the Engine2D
    # consumer resolves the quads' index space per batch and normalises to
    # codepoint arity (`font_advances_codepoint_arity`), so the round-5
    # byte-expansion shim this call replaced is no longer needed. The command
    # states its convention with `font-advance-arity: codepoint` below; a
    # declaration that disagrees with what arrives makes the consumer take the
    # flat fallback instead of silently reinterpreting the array. History and
    # the incident this closes:
    # doc/08_tracking/bug/web_drawir_advances_staged_per_byte_kills_render_2026-09-12.md.
    val cp_advances = _html_draw_ir_codepoint_advances(txt, metrics.advances)
    if cp_advances.len() == 0:
        return draw_ir_text_styled_clipped(
            cid, tx, ty, txt, st.fg, computed_style, clip_rect
        )
    var resolved = if metrics.shaping_required:
        draw_ir_text_shaped_font(
            cid, tx, ty, txt, st.fg,
            metrics.family, metrics.identity, cp_advances, metrics.width,
            metrics.line_height, st.font_size, metrics.glyph_run
        )
    else:
        draw_ir_text_resolved_font(
            cid, tx, ty, txt, st.fg,
            metrics.family, metrics.identity, cp_advances, metrics.width,
            metrics.line_height, st.font_size
        )
    if resolved.computed_style.len() == 0:
        return draw_ir_text_styled_clipped(
            cid, tx, ty, txt, st.fg, computed_style, clip_rect
        )
    var merged: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: per-node style-prop merge that drops the five font-* keys the resolved font metrics supersede; bound is this node's own declared prop list
    for prop in computed_style:
        if (prop.key != "font-family" and prop.key != "font-identity" and
            prop.key != "font-size" and prop.key != "line-height" and
            prop.key != "font-shaping"):
            merged.push(prop)
    # cpu-lane-loop-ok: appends the resolved font-metric props onto the merged list; bound is the small fixed prop set returned by draw_ir_text_shaped_font / _resolved_font
    for prop in resolved.computed_style:
        merged.push(prop)
    # Declare the wire arity of `advance_widths` for the Engine2D gate.
    merged.push(draw_ir_style_prop("font-advance-arity", "codepoint"))
    resolved.computed_style = merged
    resolved.clip_rect = clip_rect
    resolved

fn _html_draw_ir_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult, i: i32,
    clip: ClipRect, vector_fonts: bool
) -> DrawIrCommand:
    val node = nodes[i]
    val st = styles[i]
    val x = boxes.bx[i]
    val y = boxes.by[i]
    val w = boxes.bw[i]
    val h = boxes.bh[i]
    val content_x = x + st.border_l + st.pad_l
    val content_y = y + st.border_t + st.pad_t
    val content_w = _html_draw_ir_non_negative(w - st.border_l - st.border_r - st.pad_l - st.pad_r)
    val content_h = _html_draw_ir_non_negative(h - st.border_t - st.border_b - st.pad_t - st.pad_b)
    val border_rect = draw_ir_rect_bounds(x, y, w, h)
    val content_rect = draw_ir_rect_bounds(content_x, content_y, content_w, content_h)
    val hit_rect = draw_ir_rect_bounds(x, y, w, h)
    val clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    val computed_style = _html_draw_ir_style_props(node, st)
    # Text-run nodes carry no background of their own; emitting them as a
    # (transparent) box makes the Draw IR executor paint an opaque zero-color
    # fill that reads back as a solid bar over the parent's background. Emit a
    # real text command instead so the executor rasterizes glyphs (on Metal fast
    # mode this routes to the GPU glyph blit) in the node's foreground color.
    if node.tag == "#text" and node.text_trimmed != "":
        val transformed_text = apply_text_transform_for_paint(
            node.text_trimmed, st.text_transform
        )
        val visual_text_rtl = if st.direction_rtl:
            reverse_text_for_paint(transformed_text)
        else:
            transformed_text
        # `_html_draw_ir_command` is the only text-command builder reachable
        # from the Draw IR tree; `ellipsize_text_for_width` is otherwise only
        # wired into the CPU-framebuffer raster loops above, so a Draw IR text
        # run with `text-overflow:ellipsis` always carried the full untruncated
        # string and its full measured width regardless of the content box.
        # Bound to the fixed-advance width model already used by those raster
        # loops (style_text_advance/style_space_advance), so it does not
        # disturb the vector-font measurement path below when ellipsis is off.
        #
        # overflow-wrap (2026-08-08): layout already computes per-node
        # word-wrap break points (boxes.wrap_starts[i]/boxes.wrap_ends[i]) for
        # the CPU-framebuffer raster loop above (`wrap_cache`, :999-1035);
        # this Draw IR builder used to ignore that pre-computed line list
        # entirely and always emit the full node.text_trimmed as one command
        # (doc/08_tracking/bug/web_css_overflow_wrap_zero_consumer_2026-08-07.md).
        # `wrap_active` reuses that line list as-is instead of re-deriving
        # break points conditioned on `st.overflow_wrap`: layout's own wrap
        # computation (compute_style_wrap_ranges/compute_wrap_ranges) is not
        # conditioned on `overflow_wrap` either — it always falls back to a
        # one-character hard split when a single word cannot fit a line — so
        # this keeps Draw IR consistent with the raster path's existing
        # (already-hard-splitting) wrap model rather than adding a second,
        # differently-gated one. Only the first wrapped line is returned here
        # (byte-identical to the old single-command shape when unwrapped);
        # `_html_draw_ir_wrap_extra_line_commands` below emits the rest. A
        # wrapped node always uses the fixed-advance measurement model (same
        # as the ellipsis path) rather than the vector/shaped-font metrics
        # path further down — line-by-line glyph shaping is not implemented,
        # noted here as a scope simplification.
        val wrap_line_starts = boxes.wrap_starts[i]
        val wrap_line_ends = boxes.wrap_ends[i]
        val wrap_active = (
            wrap_line_starts.len() > 1 and not st.text_overflow_ellipsis
        )
        val visual_text = if st.text_overflow_ellipsis:
            ellipsize_text_for_width(
                visual_text_rtl, 0, visual_text_rtl.len(), content_w, st,
                style_text_advance(st), style_space_advance(st)
            )
        elif wrap_active:
            visual_text_rtl.substring(wrap_line_starts[0], wrap_line_ends[0])
        else:
            visual_text_rtl
        if wrap_active:
            # Round 5: a wrapped run no longer falls back to the flat
            # fixed-advance model. LAYOUT sized every one of these lines with
            # the resolved per-glyph metrics (round 4), so emitting them here
            # without advances made paint and layout measure the same text two
            # different ways -- the `forms-media` pixel regression recorded in
            # doc/08_tracking/bug/web_forms_media_pixel_regression_layout_paint_advance_disagree_2026-09-12.md.
            # Metrics are resolved for THIS line's substring, which is exactly
            # the string the command draws, and the resolver is cached per
            # (family, content, size, identity, language) so the per-line calls
            # collapse onto repeated text.
            return _html_draw_ir_resolved_text_command(
                nodes, i, node, st, _html_draw_ir_component_id(node, i),
                content_x, content_y, visual_text, computed_style, clip_rect,
                vector_fonts
            )
        return _html_draw_ir_resolved_text_command(
            nodes, i, node, st, _html_draw_ir_component_id(node, i),
            content_x, content_y, visual_text, computed_style, clip_rect,
            vector_fonts
        )
    val command = draw_ir_box_with_style(
        _html_draw_ir_component_id(node, i),
        x,
        y,
        w,
        h,
        _html_draw_ir_wm_fallback_color(node, st),
        border_rect,
        content_rect,
        hit_rect,
        clip_rect,
        computed_style
    )
    command

# Companion to `_html_draw_ir_command`'s `wrap_active` branch: that function
# returns only the first wrapped line (to keep its single-`DrawIrCommand`
# return shape byte-identical to the unwrapped case); this emits the Draw IR
# text commands for the remaining lines using layout's precomputed
# boxes.wrap_starts[i]/boxes.wrap_ends[i], one command per line, offset by
# style_line_h(st) per line. Returns an empty list when the node is not a
# wrapped `#text` node, so callers can push its result unconditionally.
fn _html_draw_ir_wrap_extra_line_commands(
    nodes: [HNode], styles: [Style], boxes: LayoutResult, i: i32,
    clip: ClipRect, vector_fonts: bool
) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = []
    val node = nodes[i]
    val st = styles[i]
    if node.tag != "#text" or node.text_trimmed == "" or st.text_overflow_ellipsis:
        return out
    val wrap_line_starts = boxes.wrap_starts[i]
    val wrap_line_ends = boxes.wrap_ends[i]
    val wrap_line_count = wrap_line_starts.len()
    if wrap_line_count <= 1:
        return out
    val x = boxes.bx[i]
    val y = boxes.by[i]
    val content_x = x + st.border_l + st.pad_l
    val content_y = y + st.border_t + st.pad_t
    val transformed_text = apply_text_transform_for_paint(
        node.text_trimmed, st.text_transform
    )
    val visual_text_rtl = if st.direction_rtl:
        reverse_text_for_paint(transformed_text)
    else:
        transformed_text
    val clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    val computed_style = _html_draw_ir_style_props(node, st)
    val lh = style_line_h(st)
    var line_i = 1
    # cpu-lane-loop-ok: emits the wrapped lines beyond the first for one
    # #text node's Draw IR command; bound is wrap_line_count from layout's
    # precomputed boxes.wrap_starts[i], the same per-node line list the
    # CPU-framebuffer raster loop (:999-1035) iterates over.
    while line_i < wrap_line_count:
        val line_text = visual_text_rtl.substring(
            wrap_line_starts[line_i], wrap_line_ends[line_i]
        )
        val line_y = content_y + line_i * lh
        out.push(_html_draw_ir_resolved_text_command(
            nodes, i, node, st,
            _html_draw_ir_component_id(node, i) + "_line{line_i}",
            content_x, line_y, line_text, computed_style, clip_rect,
            vector_fonts
        ))
        line_i = line_i + 1
    out

fn _html_draw_ir_image_index_by_uri(
    images: [SimpleOsHostGpuImageResource]
) -> Dict<text, i32>:
    # First VALID resource per uri wins, exactly like the linear scan this
    # index replaces: an invalid entry never shadows a later valid one.
    var by_uri: Dict<text, i32> = {}
    var index = 0
    # cpu-lane-loop-ok: one pass over the image list building the uri -> index map that every per-node lookup reads; bound is images.len(), built once per _html_draw_ir_commands
    while index < images.len():
        val image = images[index]
        if image.width > 0 and image.height > 0 and
            image.pixels.len() == image.width.to_i64() * image.height.to_i64() and
            not by_uri.contains_key(image.image_uri):
            by_uri[image.image_uri] = index
        index = index + 1
    by_uri

fn _html_draw_ir_image_index(
    image_index: Dict<text, i32>, image_uri: text
) -> i32:
    image_index.get(image_uri) ?? -1

fn _html_draw_ir_fit_size(
    object_fit: text, box_w: i32, box_h: i32,
    image_w: i32, image_h: i32
) -> (i32, i32):
    if object_fit == "fill":
        return (box_w, box_h)
    if object_fit == "none":
        return (image_w, image_h)
    val box_w64 = box_w.to_i64()
    val box_h64 = box_h.to_i64()
    val image_w64 = image_w.to_i64()
    val image_h64 = image_h.to_i64()
    val contain_by_width = box_w64 * image_h64 <= box_h64 * image_w64
    var contain_w = box_w
    var contain_h = (
        (box_w64 * image_h64) / image_w64
    ).to_i32()
    if not contain_by_width:
        contain_h = box_h
        contain_w = ((box_h64 * image_w64) / image_h64).to_i32()
    if object_fit == "contain":
        return (contain_w, contain_h)
    if object_fit == "scale-down":
        if image_w <= box_w and image_h <= box_h:
            return (image_w, image_h)
        return (contain_w, contain_h)
    val cover_by_width = box_w64 * image_h64 >= box_h64 * image_w64
    if cover_by_width:
        return (
            box_w, ((box_w64 * image_h64) / image_w64).to_i32()
        )
    (((box_h64 * image_w64) / image_h64).to_i32(), box_h)

fn _html_draw_ir_image_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, images: [SimpleOsHostGpuImageResource],
    image_index_by_uri: Dict<text, i32>, ancestor_clip: ClipRect
) -> DrawIrCommand?:
    val node = nodes[i]
    if node.tag != "img" and node.tag != "video":
        return nil
    val image_attr = if node.tag == "video": "poster" else: "src"
    val image_uri = attr_value(node.attrs_raw, image_attr).trim()
    val image_index = _html_draw_ir_image_index(image_index_by_uri, image_uri)
    if image_index < 0:
        return nil
    val st = styles[i]
    val box_x = boxes.bx[i] + st.border_l + st.pad_l
    val box_y = boxes.by[i] + st.border_t + st.pad_t
    val box_w = _html_draw_ir_non_negative(
        boxes.bw[i] - st.border_l - st.border_r - st.pad_l - st.pad_r
    )
    val box_h = _html_draw_ir_non_negative(
        boxes.bh[i] - st.border_t - st.border_b - st.pad_t - st.pad_b
    )
    if box_w <= 0 or box_h <= 0:
        return nil
    val image = images[image_index]
    val (draw_w, draw_h) = _html_draw_ir_fit_size(
        st.object_fit, box_w, box_h, image.width, image.height
    )
    if draw_w <= 0 or draw_h <= 0:
        return nil
    val draw_x = box_x + (
        (box_w.to_i64() - draw_w.to_i64()) *
        object_position_x_pct(st.object_position).to_i64() / 100
    ).to_i32()
    val draw_y = box_y + (
        (box_h.to_i64() - draw_h.to_i64()) *
        object_position_y_pct(st.object_position).to_i64() / 100
    ).to_i32()
    val clip = clip_intersect(
        ancestor_clip, box_x, box_y, box_x + box_w, box_y + box_h
    )
    if clip.x1 <= clip.x0 or clip.y1 <= clip.y0:
        return nil
    var command = draw_ir_image_command(
        _html_draw_ir_component_id(node, i) + "_image",
        draw_x, draw_y, draw_w, draw_h, image_uri,
        _html_draw_ir_style_props(node, st)
    )
    command.clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    Some(command)

fn _html_draw_ir_background_edge(
    edge: text, box_start: i32, box_size: i32, border_start: i32,
    border_end: i32, padding_start: i32, padding_end: i32
) -> (i32, i32):
    if edge == "border-box":
        return (box_start, box_size)
    if edge == "content-box":
        val inset_start = border_start + padding_start
        return (
            box_start + inset_start,
            _html_draw_ir_non_negative(
                box_size - inset_start - border_end - padding_end
            )
        )
    (
        box_start + border_start,
        _html_draw_ir_non_negative(box_size - border_start - border_end)
    )

fn _html_draw_ir_background_offset(value: i32, free_space: i32) -> i32:
    if value <= -1000:
        return (free_space.to_i64() * (-1000 - value).to_i64() / 100).to_i32()
    value

class HtmlDrawIrBackgroundLayer:
    image_uri: text
    repeat: text
    size_w: i32
    size_h: i32
    position_x: i32
    position_y: i32
    origin: text
    clip: text
    attachment: text
    index: i32

fn _html_draw_ir_two_url_background_layers(st: Style) -> [HtmlDrawIrBackgroundLayer]:
    val fields = st.bg_layers_raw.split("\n")
    if fields.len() != 11 or fields[0] != "two-url-v1":
        return []
    var layers: [HtmlDrawIrBackgroundLayer] = []
    var index = 0
    # cpu-lane-loop-ok: iterates the two layers of the two-url-v1 background encoding; bound is the literal constant 2, so this is a detector false positive
    while index < 2:
        val repeat = fields[3]
        val origin = fields[8]
        val clip = fields[9]
        val attachment = fields[10]
        if (fields[index + 1] == "" or
            (repeat != "repeat" and repeat != "repeat-x" and
             repeat != "repeat-y" and repeat != "no-repeat") or
            (origin != "border-box" and origin != "padding-box" and
             origin != "content-box") or
            (clip != "border-box" and clip != "padding-box" and
             clip != "content-box") or
            (attachment != "scroll" and attachment != "fixed")):
            return []
        val size_w = parse_int(fields[4])
        val size_h = parse_int(fields[5])
        if size_w < 0 or size_h < 0:
            return []
        layers.push(HtmlDrawIrBackgroundLayer(
            image_uri: fields[index + 1], repeat: repeat, size_w: size_w,
            size_h: size_h, position_x: parse_int(fields[6]),
            position_y: parse_int(fields[7]), origin: origin,
            clip: clip, attachment: attachment, index: index
        ))
        index = index + 1
    layers

fn _html_draw_ir_background_layers(st: Style) -> [HtmlDrawIrBackgroundLayer]:
    val layered = _html_draw_ir_two_url_background_layers(st)
    if layered.len() == 2:
        return layered
    if (st.bg_layers_raw != "" or st.background_image_uri == "" or
        st.background_attachment == "local"):
        return []
    [HtmlDrawIrBackgroundLayer(
        image_uri: st.background_image_uri, repeat: st.background_repeat,
        size_w: st.background_size_w_px, size_h: st.background_size_h_px,
        position_x: st.background_position_x_px,
        position_y: st.background_position_y_px,
        origin: st.background_origin, clip: st.background_clip,
        attachment: st.background_attachment, index: -1
    )]

fn _html_draw_ir_background_image_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, images: [SimpleOsHostGpuImageResource],
    image_index_by_uri: Dict<text, i32>,
    ancestor_clip: ClipRect, viewport_width: i32, viewport_height: i32,
    layer: HtmlDrawIrBackgroundLayer
) -> DrawIrCommand?:
    val st = styles[i]
    if (
        layer.image_uri == ""
    ):
        return nil
    val image_index = _html_draw_ir_image_index(image_index_by_uri, layer.image_uri)
    if image_index < 0:
        return nil
    val image = images[image_index]
    val (element_origin_x, element_origin_w) = _html_draw_ir_background_edge(
        layer.origin, boxes.bx[i], boxes.bw[i],
        st.border_l, st.border_r, st.pad_l, st.pad_r
    )
    val (element_origin_y, element_origin_h) = _html_draw_ir_background_edge(
        layer.origin, boxes.by[i], boxes.bh[i],
        st.border_t, st.border_b, st.pad_t, st.pad_b
    )
    var origin_x = element_origin_x
    var origin_y = element_origin_y
    var origin_w = element_origin_w
    var origin_h = element_origin_h
    if layer.attachment == "fixed":
        origin_x = 0
        origin_y = 0
        origin_w = viewport_width
        origin_h = viewport_height
    val (clip_x, clip_w) = _html_draw_ir_background_edge(
        layer.clip, boxes.bx[i], boxes.bw[i],
        st.border_l, st.border_r, st.pad_l, st.pad_r
    )
    val (clip_y, clip_h) = _html_draw_ir_background_edge(
        layer.clip, boxes.by[i], boxes.bh[i],
        st.border_t, st.border_b, st.pad_t, st.pad_b
    )
    var clip_inset_l = 0
    var clip_inset_t = 0
    var clip_inset_r = 0
    var clip_inset_b = 0
    if layer.clip == "padding-box" or layer.clip == "content-box":
        clip_inset_l = st.border_l
        clip_inset_t = st.border_t
        clip_inset_r = st.border_r
        clip_inset_b = st.border_b
    if layer.clip == "content-box":
        clip_inset_l = clip_inset_l + st.pad_l
        clip_inset_t = clip_inset_t + st.pad_t
        clip_inset_r = clip_inset_r + st.pad_r
        clip_inset_b = clip_inset_b + st.pad_b
    val clip = clip_intersect(
        ancestor_clip, clip_x, clip_y, clip_x + clip_w, clip_y + clip_h
    )
    if clip.x1 <= clip.x0 or clip.y1 <= clip.y0:
        return nil
    var tile_w = layer.size_w
    var tile_h = layer.size_h
    if tile_w <= 0 and tile_h <= 0:
        tile_w = image.width
        tile_h = image.height
    elif tile_w <= 0:
        tile_w = (
            tile_h.to_i64() * image.width.to_i64() / image.height.to_i64()
        ).to_i32()
    elif tile_h <= 0:
        tile_h = (
            tile_w.to_i64() * image.height.to_i64() / image.width.to_i64()
        ).to_i32()
    if tile_w <= 0 or tile_h <= 0:
        return nil
    val tile_x = origin_x + _html_draw_ir_background_offset(
        layer.position_x, origin_w - tile_w
    )
    val tile_y = origin_y + _html_draw_ir_background_offset(
        layer.position_y, origin_h - tile_h
    )
    var props = _html_draw_ir_style_props(nodes[i], st)
    props.push(draw_ir_style_prop("image-role", "css-background"))
    if layer.index >= 0:
        props.push(draw_ir_style_prop("background-layer-index", "{layer.index}"))
    var prop_index = 0
    while prop_index < props.len():
        if props[prop_index].key == "background-repeat":
            props[prop_index] = draw_ir_style_prop("background-repeat", layer.repeat)
        prop_index = prop_index + 1
    props.push(draw_ir_style_prop("background-tile-x", "{tile_x}"))
    props.push(draw_ir_style_prop("background-tile-y", "{tile_y}"))
    props.push(draw_ir_style_prop("background-tile-width", "{tile_w}"))
    props.push(draw_ir_style_prop("background-tile-height", "{tile_h}"))
    props.push(draw_ir_style_prop("background-shape-x", "{clip_x}"))
    props.push(draw_ir_style_prop("background-shape-y", "{clip_y}"))
    props.push(draw_ir_style_prop("background-shape-width", "{clip_w}"))
    props.push(draw_ir_style_prop("background-shape-height", "{clip_h}"))
    props.push(draw_ir_style_prop("background-radius-tl-x",
        "{_html_draw_ir_non_negative(st.border_radius_tl_px - clip_inset_l)}"))
    props.push(draw_ir_style_prop("background-radius-tl-y",
        "{_html_draw_ir_non_negative(st.border_radius_tl_px - clip_inset_t)}"))
    props.push(draw_ir_style_prop("background-radius-tr-x",
        "{_html_draw_ir_non_negative(st.border_radius_tr_px - clip_inset_r)}"))
    props.push(draw_ir_style_prop("background-radius-tr-y",
        "{_html_draw_ir_non_negative(st.border_radius_tr_px - clip_inset_t)}"))
    props.push(draw_ir_style_prop("background-radius-br-x",
        "{_html_draw_ir_non_negative(st.border_radius_br_px - clip_inset_r)}"))
    props.push(draw_ir_style_prop("background-radius-br-y",
        "{_html_draw_ir_non_negative(st.border_radius_br_px - clip_inset_b)}"))
    props.push(draw_ir_style_prop("background-radius-bl-x",
        "{_html_draw_ir_non_negative(st.border_radius_bl_px - clip_inset_l)}"))
    props.push(draw_ir_style_prop("background-radius-bl-y",
        "{_html_draw_ir_non_negative(st.border_radius_bl_px - clip_inset_b)}"))
    var command = draw_ir_image_command(
        _html_draw_ir_component_id(nodes[i], i) + "_background_image" +
            if layer.index >= 0: "_{layer.index}" else: "",
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0,
        layer.image_uri, props
    )
    command.clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    Some(command)

fn _html_draw_ir_background_border_overlay(
    nodes: [HNode], styles: [Style], boxes: LayoutResult, i: i32,
    clip: ClipRect, vector_fonts: bool
) -> DrawIrCommand:
    var command = _html_draw_ir_command(
        nodes, styles, boxes, i, clip, vector_fonts
    )
    command.component_id = (
        _html_draw_ir_component_id(nodes[i], i) + "_background_border_overlay"
    )
    command.color = 0u32
    var props: [DrawIrStyleProp] = [
        draw_ir_style_prop("image-role", "css-background-border-overlay")
    ]
    # cpu-lane-loop-ok: filters one node's computed style down to the border-* / outline-* keys for the background border overlay; bound is that one node's prop list
    for prop in command.computed_style:
        if prop.key.starts_with("border-") or prop.key.starts_with("outline-"):
            props.push(prop)
    command.computed_style = props
    command

fn _html_draw_ir_has_input_text(
    node: HNode, st: Style, box_width: i32
) -> bool:
    if (
        node.tag != "input" or input_uses_accent_color(node) or
        not input_paints_text(node)
    ):
        return false
    val content_w = (
        box_width - st.border_l - st.border_r - st.pad_l - st.pad_r
    )
    if content_w <= 0:
        return false
    val adv = style_text_advance(st)
    val glyph_advance = if adv > 0: adv else: 1
    input_text_for_paint(node, content_w / glyph_advance + 1) != ""

fn _html_draw_ir_input_text_command_from_plan(
    node: HNode, st: Style, i: i32, plan: InputTextPaintPlan
) -> DrawIrCommand:
    draw_ir_text_styled_clipped(
        _html_draw_ir_component_id(node, i) + "_value",
        plan.baseline_x,
        plan.baseline_y,
        plan.text_value,
        plan.color,
        _html_draw_ir_style_props(node, st),
        draw_ir_rect_bounds(
            plan.clip.x0, plan.clip.y0,
            plan.clip.x1 - plan.clip.x0, plan.clip.y1 - plan.clip.y0
        )
    )

fn _html_draw_ir_overlay_rect(
    component_id: text, rect: ClipRect, color: u32, clip: ClipRect
) -> DrawIrCommand:
    draw_ir_rect_clipped(
        component_id,
        rect.x0,
        rect.y0,
        rect.x1 - rect.x0,
        rect.y1 - rect.y0,
        color,
        draw_ir_rect_bounds(
            clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
        )
    )

fn _html_draw_ir_checkable_commands(
    node: HNode, st: Style, i: i32,
    x: i32, y: i32, width: i32, height: i32, clip: ClipRect
) -> [DrawIrCommand]:
    var commands: [DrawIrCommand] = []
    val control_w = if width < 14: width else: 14
    val control_h = if height < 14: height else: 14
    if control_w <= 0 or control_h <= 0:
        return commands
    val component_id = _html_draw_ir_component_id(node, i)
    val input_type = attr_value(node.attrs_raw, "type").trim().lower()
    val checked = input_is_checked(node)
    val accent = if st.accent_color != 0u32:
        st.accent_color
    else:
        argb(37, 99, 235)
    val surface = argb(248, 250, 252)
    val radio = input_type == "radio"

    var frame = _html_draw_ir_overlay_rect(
        component_id + "_checkable_frame",
        ClipRect(x0: x, y0: y, x1: x + control_w, y1: y + control_h),
        surface, clip
    )
    frame.parent_id = component_id
    frame.computed_style = [
        draw_ir_style_prop("form-control-part", "frame"),
        draw_ir_style_prop("input-type", input_type),
        draw_ir_style_prop("checked", if checked: "true" else: "false"),
        draw_ir_style_prop("accent-color", "{accent}"),
        draw_ir_style_prop("border-top-width", "1"),
        draw_ir_style_prop("border-right-width", "1"),
        draw_ir_style_prop("border-bottom-width", "1"),
        draw_ir_style_prop("border-left-width", "1"),
        draw_ir_style_prop("border-top-color", "{accent}"),
        draw_ir_style_prop("border-right-color", "{accent}"),
        draw_ir_style_prop("border-bottom-color", "{accent}"),
        draw_ir_style_prop("border-left-color", "{accent}")
    ]
    if radio:
        frame.computed_style.push(draw_ir_style_prop(
            "border-radius", "{control_w / 2}"
        ))
    commands.push(frame)

    if checked and control_w > 6 and control_h > 6:
        var indicator = _html_draw_ir_overlay_rect(
            component_id + "_checked_indicator",
            ClipRect(
                x0: x + 3, y0: y + 3,
                x1: x + control_w - 3, y1: y + control_h - 3
            ),
            accent, clip
        )
        indicator.parent_id = component_id
        indicator.computed_style = [
            draw_ir_style_prop("form-control-part", "checked-indicator"),
            draw_ir_style_prop("input-type", input_type),
            draw_ir_style_prop("checked", "true"),
            draw_ir_style_prop("accent-color", "{accent}")
        ]
        if radio:
            indicator.computed_style.push(draw_ir_style_prop(
                "border-radius", "{(control_w - 6) / 2}"
            ))
        commands.push(indicator)
    commands

fn _html_draw_ir_summary_marker_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, clip: ClipRect
) -> DrawIrCommand?:
    val node = nodes[i]
    val st = styles[i]
    val parent = node.parent
    if (
        not node.is_details_summary or st.display != "list-item" or
        parent < 0 or nodes[parent].tag != "details"
    ):
        return nil
    val marker_state = if attr_present(nodes[parent].attrs_raw, "open"):
        "open"
    else:
        "closed"
    val marker_text = if marker_state == "open": "▼" else: "▶"
    var computed_style = _html_draw_ir_style_props(node, st)
    computed_style.push(draw_ir_style_prop(
        "summary-marker", "disclosure"
    ))
    computed_style.push(draw_ir_style_prop(
        "summary-marker-state", marker_state
    ))
    val clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    var marker = draw_ir_text_styled_clipped(
        _html_draw_ir_component_id(node, i) + "::marker",
        boxes.bx[i], boxes.by[i], marker_text, st.fg,
        computed_style, clip_rect
    )
    marker.parent_id = _html_draw_ir_component_id(node, i)
    marker

fn _html_draw_ir_abs_i32(value: i32) -> i64:
    if value < 0: 0 - value.to_i64() else: value.to_i64()

fn _html_draw_ir_saturated_i32(value: i64) -> i32:
    _html_draw_ir_clamp_i64(
        value, 0i64 - 2147483647i64 - 1i64, 2147483647i64
    ).to_i32()

fn _html_draw_ir_visible(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, clip: ClipRect
) -> bool:
    if i <= 0:
        return false
    val display = styles[i].display
    val box_w = boxes.bw[i]
    val box_h = boxes.bh[i]
    if display == "none":
        return false
    if styles[i].visibility_hidden:
        return false
    val ancestor_hidden = content_paint_hidden_by_ancestor(nodes, styles, i)
    if ancestor_hidden:
        return false
    if box_w <= 0:
        return false
    if box_h <= 0:
        return false
    if clip.x1 <= clip.x0 or clip.y1 <= clip.y0:
        return false
    val st = styles[i]
    val effect_x = (
        st.outline_w.to_i64() + _html_draw_ir_abs_i32(st.outline_offset_px) +
        _html_draw_ir_abs_i32(st.box_shadow_x_px) +
        st.box_shadow_blur_px.to_i64() +
        _html_draw_ir_abs_i32(st.text_shadow_x_px)
    )
    val effect_y = (
        st.outline_w.to_i64() + _html_draw_ir_abs_i32(st.outline_offset_px) +
        _html_draw_ir_abs_i32(st.box_shadow_y_px) +
        st.box_shadow_blur_px.to_i64() +
        _html_draw_ir_abs_i32(st.text_shadow_y_px) +
        _html_draw_ir_abs_i32(st.text_underline_offset_px) +
        st.text_decoration_thickness_px.to_i64()
    )
    var x0 = boxes.bx[i].to_i64() - effect_x
    var y0 = boxes.by[i].to_i64() - effect_y
    var x1 = boxes.bx[i].to_i64() + box_w.to_i64() + effect_x
    var y1 = boxes.by[i].to_i64() + box_h.to_i64() + effect_y
    if st.box_shadow_raw != "":
        val layers = split_top_level_commas(st.box_shadow_raw)
        for layer in layers:
            if not layer.contains("inset"):
                val prefix = shadow_length_prefix(layer)
                val ox = parse_signed_nth_int(prefix, 0)
                val oy = parse_signed_nth_int(prefix, 1)
                if ox != -1000000 and oy != -1000000:
                    var blur = parse_signed_nth_int(prefix, 2)
                    if blur == -1000000 or blur <= 0:
                        blur = 1
                    val shadow_x0 = (
                        boxes.bx[i].to_i64() + ox.to_i64() - blur.to_i64()
                    )
                    val shadow_y0 = (
                        boxes.by[i].to_i64() + oy.to_i64() - blur.to_i64()
                    )
                    val shadow_x1 = (
                        boxes.bx[i].to_i64() + ox.to_i64() +
                        box_w.to_i64() + blur.to_i64()
                    )
                    val shadow_y1 = (
                        boxes.by[i].to_i64() + oy.to_i64() +
                        box_h.to_i64() + blur.to_i64()
                    )
                    if shadow_x0 < x0: x0 = shadow_x0
                    if shadow_y0 < y0: y0 = shadow_y0
                    if shadow_x1 > x1: x1 = shadow_x1
                    if shadow_y1 > y1: y1 = shadow_y1
    if (x1 <= clip.x0.to_i64() or y1 <= clip.y0.to_i64() or
        x0 >= clip.x1.to_i64() or y0 >= clip.y1.to_i64()):
        return false
    true

fn _html_draw_ir_visible_nodes(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    clip_cache: PaintClipCache
) -> [bool]:
    var visible: [bool] = [false; nodes.len()]
    var i: i32 = 0
    # cpu-lane-loop-ok: one visibility decision per node into a reusable [bool] mask so downstream Draw IR emission does not recompute visibility; bound is nodes.len()
    while i < nodes.len():
        visible[i] = _html_draw_ir_visible(
            nodes, styles, boxes, i, paint_clip_at(clip_cache, i)
        )
        i = i + 1
    visible

fn _html_draw_ir_append_context_paint_order(
    styles: [Style], members: [[i32]], child_contexts: [[i32]],
    context_id: i32, order: [i32]
) -> [i32]:
    var result = order
    # cpu-lane-loop-ok: appends the members of one stacking context in document order; summed over the whole recursion each node is appended exactly once, so the total is O(node_count)
    for member in members[context_id]:
        result.push(member)
    val children = _sort_positive_z_indices(
        child_contexts[context_id],
        child_contexts[context_id].len(),
        styles
    )
    # cpu-lane-loop-ok: recurses into the z-sorted child stacking contexts of one context; bound is that context's child count and each context is visited exactly once
    for child in children:
        result = _html_draw_ir_append_context_paint_order(
            styles, members, child_contexts, child + 1, result
        )
    result

fn _html_draw_ir_node_paint_order(
    nodes: [HNode], styles: [Style]
) -> [i32]:
    val node_count = nodes.len()
    # Context zero is the document. Positive positioned nodes use node index + 1
    # so their ordinary descendants stay grouped while nested positive siblings
    # are sorted stably inside the nearest supported stacking context.
    var node_context: [i32] = [0; node_count]
    var members: [[i32]] = [[]; node_count + 1]
    var child_contexts: [[i32]] = [[]; node_count + 1]
    var i: i32 = 0
    # cpu-lane-loop-ok: assigns each node to its nearest supported stacking context and registers it as a member; single forward O(node_count) pass, parents precede children
    while i < node_count:
        val parent = nodes[i].parent
        val parent_context = if parent >= 0 and parent < i:
            node_context[parent]
        else:
            0
        if styles[i].position_absolute and styles[i].z_index > 0:
            child_contexts[parent_context].push(i)
            node_context[i] = i + 1
            members[i + 1].push(i)
        else:
            node_context[i] = parent_context
            members[parent_context].push(i)
        i = i + 1
    _html_draw_ir_append_context_paint_order(
        styles, members, child_contexts, 0, []
    )

fn _html_draw_ir_commands(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    width: i32, height: i32, vector_fonts: bool,
    target_keys: [text], overlay: BrowserTextInputOverlay,
    visible_nodes: [bool], images: [SimpleOsHostGpuImageResource],
    clip_cache: PaintClipCache
) -> ([DrawIrCommand], [i32]):
    # One uri -> index map per render. The per-node loop below used to rescan
    # the whole image list for every img, video and background layer.
    val image_index_by_uri = _html_draw_ir_image_index_by_uri(images)
    var commands: [DrawIrCommand] = []
    var owner_nodes: [i32] = []
    var scrollbar_lowering = false
    # cpu-lane-loop-ok: existence scan over the style list to decide whether scrollbar lowering is needed at all; bound is style count, one pass, result is a single bool
    for st in styles:
        if st.overflow_auto_y:
            scrollbar_lowering = true
    val paint_order = _html_draw_ir_node_paint_order(nodes, styles)
    # Cache subtree geometry only when a scrollport exists. A clipping child
    # contributes its own border edge, never its hidden descendants.
    var descendant_bottom: [i64] = []
    var subtree_last_paint: [i32] = []
    var scrollbar_commands_at: [[DrawIrCommand]] = []
    var scrollbar_owners_at: [[i32]] = []
    if scrollbar_lowering:
        descendant_bottom = [0i64; nodes.len()]
        var extent_init = 0
        # cpu-lane-loop-ok: initialises descendant_bottom to each node's own bottom edge; single O(node_count) init of the scroll-extent accumulator
        while extent_init < nodes.len():
            descendant_bottom[extent_init] = (
                boxes.by[extent_init].to_i64() +
                boxes.bh[extent_init].to_i64()
            )
            extent_init = extent_init + 1
        var extent_index = nodes.len() - 1
        # cpu-lane-loop-ok: reverse sweep propagating each node's scroll extent into its parent; this IS the bulk idiom - it replaces a per-node subtree walk with one O(node_count) backward pass
        while extent_index >= 0:
            val own_bottom = (
                boxes.by[extent_index].to_i64() +
                boxes.bh[extent_index].to_i64()
            )
            val extent_parent = nodes[extent_index].parent
            if extent_parent >= 0:
                val propagated_bottom = if (
                    styles[extent_index].overflow_hidden or
                    styles[extent_index].overflow_auto_y
                ):
                    own_bottom
                else:
                    descendant_bottom[extent_index]
                if propagated_bottom > descendant_bottom[extent_parent]:
                    descendant_bottom[extent_parent] = propagated_bottom
            extent_index = extent_index - 1
        # Schedule chrome immediately after the owner's last painted
        # descendant. This keeps it above owned content, below later stacking
        # contexts/glass, and contiguous with its opacity subtree.
        subtree_last_paint = [0; nodes.len()]
        var order_index = 0
        # cpu-lane-loop-ok: records each node's own position within paint_order; single O(paint_order) pass
        while order_index < paint_order.len():
            subtree_last_paint[paint_order[order_index]] = order_index
            order_index = order_index + 1
        var subtree_index = nodes.len() - 1
        # cpu-lane-loop-ok: reverse sweep lifting each node's last-painted descendant index into its parent so scrollbar chrome can flush right after the owner's subtree; one O(node_count) backward pass
        while subtree_index >= 0:
            val subtree_parent = nodes[subtree_index].parent
            if (
                subtree_parent >= 0 and
                subtree_last_paint[subtree_index] >
                    subtree_last_paint[subtree_parent]
            ):
                subtree_last_paint[subtree_parent] = (
                    subtree_last_paint[subtree_index]
                )
            subtree_index = subtree_index - 1
        scrollbar_commands_at = [[]; paint_order.len()]
        scrollbar_owners_at = [[]; paint_order.len()]
        var scrollbar_index = nodes.len() - 1
        # cpu-lane-loop-ok: builds the scrollbar track/thumb Draw IR commands for overflow-auto-y scrollports and buckets them at their owner's flush point; bound is node_count, one pass
        while scrollbar_index >= 0:
            val st = styles[scrollbar_index]
            if (
                scrollbar_index < visible_nodes.len() and
                visible_nodes[scrollbar_index] and
                nodes[scrollbar_index].tag != "#text" and
                st.overflow_auto_y and not st.scrollbar_width_none
            ):
                val raw_track_h = (
                    boxes.bh[scrollbar_index].to_i64() -
                    st.border_t.to_i64() - st.border_b.to_i64()
                )
                val track_h64 = _html_draw_ir_clamp_i64(
                    raw_track_h, 0, 2147483647
                )
                val inner_width64 = (
                    boxes.bw[scrollbar_index].to_i64() -
                    st.border_l.to_i64() - st.border_r.to_i64()
                )
                val track_x64 = (
                    boxes.bx[scrollbar_index].to_i64() +
                    boxes.bw[scrollbar_index].to_i64() -
                    st.border_r.to_i64() - 15
                )
                val track_y64 = (
                    boxes.by[scrollbar_index].to_i64() +
                    st.border_t.to_i64()
                )
                val content_extent = (
                    descendant_bottom[scrollbar_index] - track_y64
                )
                if (
                    inner_width64 >= 15 and track_h64 >= 8 and
                    (
                        st.overflow_scroll_y or
                        content_extent > track_h64
                    )
                ):
                    val track_x = _html_draw_ir_saturated_i32(track_x64)
                    val track_y = _html_draw_ir_saturated_i32(track_y64)
                    val track_h = _html_draw_ir_saturated_i32(track_h64)
                    val node_clip = paint_clip_at(
                        clip_cache, scrollbar_index
                    )
                    val scrollport_clip = clip_intersect(
                        node_clip,
                        _html_draw_ir_saturated_i32(
                            boxes.bx[scrollbar_index].to_i64() +
                            st.border_l.to_i64()
                        ),
                        track_y,
                        _html_draw_ir_saturated_i32(
                            boxes.bx[scrollbar_index].to_i64() +
                            boxes.bw[scrollbar_index].to_i64() -
                            st.border_r.to_i64()
                        ),
                        _html_draw_ir_saturated_i32(
                            track_y64 + track_h64
                        )
                    )
                    if (
                        scrollport_clip.x1 > scrollport_clip.x0 and
                        scrollport_clip.y1 > scrollport_clip.y0
                    ):
                        val component_id = _html_draw_ir_component_id(
                            nodes[scrollbar_index], scrollbar_index
                        )
                        val track_color = if (
                            st.scrollbar_track_color != 0u32
                        ):
                            st.scrollbar_track_color
                        else:
                            argb(209, 213, 219)
                        val thumb_color = if (
                            st.scrollbar_thumb_color != 0u32
                        ):
                            st.scrollbar_thumb_color
                        else:
                            argb(107, 114, 128)
                        var track = _html_draw_ir_overlay_rect(
                            component_id + "_scrollbar_track",
                            ClipRect(
                                x0: track_x, y0: track_y,
                                x1: _html_draw_ir_saturated_i32(
                                    track_x64 + 15
                                ),
                                y1: _html_draw_ir_saturated_i32(
                                    track_y64 + track_h64
                                )
                            ),
                            track_color, scrollport_clip
                        )
                        track.parent_id = component_id
                        track.computed_style = [
                            draw_ir_style_prop(
                                "scrollbar-part", "track"
                            ),
                            draw_ir_style_prop(
                                "scrollbar-color", "{track_color}"
                            )
                        ]
                        val effective_extent = if (
                            content_extent > track_h64
                        ):
                            content_extent
                        else:
                            track_h64
                        var thumb_h64 = (
                            track_h64 * track_h64 / effective_extent
                        )
                        if thumb_h64 < 16:
                            thumb_h64 = 16
                        if thumb_h64 > track_h64:
                            thumb_h64 = track_h64
                        var thumb = _html_draw_ir_overlay_rect(
                            component_id + "_scrollbar_thumb",
                            ClipRect(
                                x0: track_x, y0: track_y,
                                x1: _html_draw_ir_saturated_i32(
                                    track_x64 + 15
                                ),
                                y1: _html_draw_ir_saturated_i32(
                                    track_y64 + thumb_h64
                                )
                            ),
                            thumb_color, scrollport_clip
                        )
                        thumb.parent_id = component_id
                        thumb.computed_style = [
                            draw_ir_style_prop(
                                "scrollbar-part", "thumb"
                            ),
                            draw_ir_style_prop(
                                "scrollbar-color", "{thumb_color}"
                            )
                        ]
                        val flush_at = subtree_last_paint[scrollbar_index]
                        scrollbar_commands_at[flush_at].push(track)
                        scrollbar_owners_at[flush_at].push(scrollbar_index)
                        scrollbar_commands_at[flush_at].push(thumb)
                        scrollbar_owners_at[flush_at].push(scrollbar_index)
            scrollbar_index = scrollbar_index - 1
    var paint_index: i32 = 0
    # cpu-lane-loop-ok: the Draw IR emission pass: one command group per node in stacking-context paint order. Bound is paint_order.len() == node_count; emitting per node is the whole purpose of this producer
    while paint_index < paint_order.len():
        val i = paint_order[paint_index]
        if i < visible_nodes.len() and visible_nodes[i]:
            val node_clip = paint_clip_at(clip_cache, i)
            val component_id = _html_draw_ir_component_id(nodes[i], i)
            val parent = nodes[i].parent
            val parent_id = if parent >= 0 and parent < nodes.len():
                _html_draw_ir_component_id(nodes[parent], parent)
            else:
                ""
            var node_command = _html_draw_ir_command(
                nodes, styles, boxes, i, node_clip, vector_fonts
            )
            node_command.parent_id = parent_id
            commands.push(node_command)
            owner_nodes.push(i)
            # cpu-lane-loop-ok: pushes the Draw IR text commands for wrapped
            # lines 2..N of one #text node; bound is that node's own
            # layout-precomputed wrap-line count (see
            # _html_draw_ir_wrap_extra_line_commands), empty for every other
            # node kind and for single-line text
            for extra_line_command in _html_draw_ir_wrap_extra_line_commands(
                nodes, styles, boxes, i, node_clip, vector_fonts
            ):
                var extra_line = extra_line_command
                extra_line.parent_id = parent_id
                commands.push(extra_line)
                owner_nodes.push(i)
            if val summary_marker = _html_draw_ir_summary_marker_command(
                nodes, styles, boxes, i, node_clip
            ):
                commands.push(summary_marker)
                owner_nodes.push(i)
            if styles[i].background_image_uri != "" or styles[i].bg_layers_raw != "":
                val background_layers = _html_draw_ir_background_layers(styles[i])
                var backgrounds_ready = background_layers.len() > 0
                for layer in background_layers:
                    if _html_draw_ir_image_index(image_index_by_uri, layer.image_uri) < 0:
                        backgrounds_ready = false
                var background_index = background_layers.len() - 1
                var lowered_backgrounds: [DrawIrCommand] = []
                # cpu-lane-loop-ok: lowers the declared background layers back-to-front; bound is background_layers.len(), which _html_draw_ir_two_url_background_layers caps at 2 (or 1 for the single-image form)
                while backgrounds_ready and background_index >= 0:
                    if val background_command = _html_draw_ir_background_image_command(
                        nodes, styles, boxes, i, images, image_index_by_uri,
                        node_clip, width, height,
                        background_layers[background_index]
                    ):
                        var background = background_command
                        background.parent_id = component_id
                        lowered_backgrounds.push(background)
                    else:
                        # A declared pair is atomic: no command survives if either
                        # layer cannot lower through the canonical typed path.
                        backgrounds_ready = false
                    background_index = background_index - 1
                if backgrounds_ready and lowered_backgrounds.len() > 0:
                    # cpu-lane-loop-ok: pushes the already-lowered background commands in declared order; bound is the same background layer count of at most 2
                    for background in lowered_backgrounds:
                        commands.push(background)
                        owner_nodes.push(i)
                    var border_overlay = _html_draw_ir_background_border_overlay(
                        nodes, styles, boxes, i, node_clip, vector_fonts
                    )
                    border_overlay.parent_id = component_id
                    commands.push(border_overlay)
                    owner_nodes.push(i)
            if val image_command = _html_draw_ir_image_command(
                nodes, styles, boxes, i, images, image_index_by_uri, node_clip
            ):
                var image = image_command
                image.parent_id = component_id
                commands.push(image)
                owner_nodes.push(i)
            if nodes[i].tag == "input" and input_uses_accent_color(nodes[i]):
                # cpu-lane-loop-ok: pushes the checkbox/radio sub-part commands (frame, border edges, checked indicator) for one input; bound is the fixed small command set _html_draw_ir_checkable_commands builds
                for control_command in _html_draw_ir_checkable_commands(
                    nodes[i], styles[i], i,
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    node_clip
                ):
                    commands.push(control_command)
                    owner_nodes.push(i)
            val overlay_target = (
                i < target_keys.len() and
                target_keys[i] != "" and
                target_keys[i] == overlay.target_key and
                input_accepts_text_overlay(nodes[i])
            )
            if (
                overlay_target or _html_draw_ir_has_input_text(
                nodes[i], styles[i], boxes.bw[i]
                )
            ):
                val node_overlay = if overlay_target:
                    overlay
                else:
                    browser_text_input_overlay_empty()
                val plan = input_text_paint_plan_with_overlay(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    node_clip, node_overlay
                )
                if plan.selection_present:
                    var selection = _html_draw_ir_overlay_rect(
                        component_id + "_selection",
                        plan.selection_rect,
                        plan.selection_color,
                        plan.clip
                    )
                    selection.parent_id = component_id
                    commands.push(selection)
                    owner_nodes.push(i)
                if plan.text_value != "":
                    var input_text = _html_draw_ir_input_text_command_from_plan(
                        nodes[i], styles[i], i, plan
                    )
                    input_text.parent_id = component_id
                    commands.push(input_text)
                    owner_nodes.push(i)
                if plan.caret_present:
                    var caret = _html_draw_ir_overlay_rect(
                        component_id + "_caret",
                        plan.caret_rect,
                        plan.caret_color,
                        plan.clip
                    )
                    caret.parent_id = component_id
                    commands.push(caret)
                    owner_nodes.push(i)
        if scrollbar_lowering:
            # cpu-lane-loop-ok: flushes the scrollbar commands bucketed at this paint index; bound is the commands queued for this index, a track+thumb pair per owning scrollport
            for scrollbar_command in scrollbar_commands_at[paint_index]:
                commands.push(scrollbar_command)
            # cpu-lane-loop-ok: flushes the owner node indices paired with the scrollbar commands above; same small per-index bound
            for scrollbar_owner in scrollbar_owners_at[paint_index]:
                owner_nodes.push(scrollbar_owner)
        paint_index = paint_index + 1
    (commands, owner_nodes)

fn _html_draw_ir_canvas_command(width: i32, height: i32, color: u32) -> DrawIrCommand:
    val rect = draw_ir_rect_bounds(0, 0, width, height)
    draw_ir_box_with_style("html-canvas", 0, 0, width, height, color, rect, rect, rect, rect, [])

# CSS canvas background propagation: the viewport (canvas) background comes from
# the root <html> element's computed background-color, or from <body> if the root
# has none, and covers the ENTIRE viewport regardless of the body's content
# height. Returns `fallback` (white) when neither carries a background. The result
# is forced opaque so the whole framebuffer clears to a solid color.
fn _web_canvas_background(nodes: [HNode], styles: [Style], fallback: u32) -> u32:
    val n = nodes.len()
    var html_bg = 0u32
    var body_bg = 0u32
    var i = 0
    # cpu-lane-loop-ok: single scan for the html and body background colors used for CSS canvas background propagation; bound is node_count, one pass, no nesting
    while i < n:
        val nd = nodes[i]
        if nd.tag == "html" and html_bg == 0u32:
            html_bg = styles[i].bg
        else if nd.tag == "body" and body_bg == 0u32:
            body_bg = styles[i].bg
        i = i + 1
    if html_bg != 0u32:
        return _web_canvas_background_over(html_bg, fallback)
    if body_bg != 0u32:
        return _web_canvas_background_over(body_bg, fallback)
    fallback

fn _web_canvas_background_over(color: u32, base: u32) -> u32:
    """Composite a canvas background color over the page base (CSS Backgrounds
    §2.11.2 + CSS Compositing simple alpha `over`). A semi-transparent canvas
    background must blend with the base the UA paints under it, not be forced
    opaque: `rgba(0,0,0,0.5)` over white is #808080, which is what Chrome paints
    and what this used to report as pure black."""
    val a = (color >> 24) & 0xFFu32
    if a >= 255u32:
        return color | 0xFF000000u32
    val br = (base >> 16) & 0xFFu32
    val bg_ = (base >> 8) & 0xFFu32
    val bb = base & 0xFFu32
    val cr = (color >> 16) & 0xFFu32
    val cg = (color >> 8) & 0xFFu32
    val cb = color & 0xFFu32
    # 8-bit alpha is a rounded sample of the authored fraction (`0.5` -> 128),
    # so blending with `255 - a` reintroduces the rounding loss and lands a
    # half-transparent black on white at 127 where Chrome paints 128. Weighting
    # with `256 - a` over a 256 denominator keeps the authored half exact.
    val inv = 256u32 - a
    val r = (cr * a + br * inv + 128u32) / 256u32
    val g = (cg * a + bg_ * inv + 128u32) / 256u32
    val b = (cb * a + bb * inv + 128u32) / 256u32
    0xFF000000u32 | (r << 16) | (g << 8) | b

# ---------------------------------------------------------------------------
# Iframe embedding (rendering-inside-rendering). A hidden/private capability:
# <iframe srcdoc="..."> is a replaced element whose child document is rendered
# by this SAME pipeline into an offscreen [u32] buffer and blitted into the
# parent framebuffer over the iframe's content box. `space` selects the CSS
# scope: "separate" (default) styles the child from its own <style>/attributes
# only; "shared" also applies the parent document's collected CSS rules (parent
# first, child overrides). Depth is capped by WEB_IFRAME_DEPTH_CAP.
# ---------------------------------------------------------------------------

fn _web_empty_rules() -> Rules:
    var gp: [[[text]]] = []
    var gs: [[i32]] = []
    var dc: [text] = []
    var important_dc: [text] = []
    Rules(
        group_parts: gp, group_specificities: gs, decls: dc,
        important_decls: important_dc
    )

fn _web_iframe_child_html(nd: HNode) -> text:
    # srcdoc is the primary (and only supported) content source. attr_value
    # entity-decodes the value, so a srcdoc written with &lt;/&gt;/&quot; yields
    # real child markup (the scanner splits on raw "<"/">", so an iframe's markup
    # MUST arrive entity-encoded inside the attribute). NOTE: the `src` attribute
    # (external URL / local file:// path) is intentionally UNSUPPORTED here — this
    # layout module imports no filesystem or network helper, so there is no
    # reachable way to fetch a src document. srcdoc-only by design.
    attr_value(nd.attrs_raw, "srcdoc")

# Copy a child [u32] buffer (cw*ch) into the parent framebuffer at (dx,dy),
# clipped to the parent bounds. Opaque replace (the iframe box owns its pixels).
fn _web_blit_child(fb: [u32], fbw: i32, fbh: i32, dx: i32, dy: i32, cw: i32, ch: i32, child: [u32]) -> [u32]:
    var out = fb
    if cw <= 0 or ch <= 0:
        return out
    val x0 = if dx < 0: 0 else: dx
    val y0 = if dy < 0: 0 else: dy
    val x1_raw = dx + cw
    val y1_raw = dy + ch
    val x1 = if x1_raw > fbw: fbw else: x1_raw
    val y1 = if y1_raw > fbh: fbh else: y1_raw
    val width = x1 - x0
    val height = y1 - y0
    if width > 0 and height > 0:
        blit_rect(out, fbw.to_i64(), x0.to_i64(), y0.to_i64(), child, cw.to_i64(), (x0 - dx).to_i64(), (y0 - dy).to_i64(), width.to_i64(), height.to_i64())
    out

# Render one child document to a cw*ch [u32] buffer via the full pipeline.
# `extra_rules` are prepended to the child's own rules for "shared" space (empty
# for "separate"). `depth` is the child's own embedding depth; its own iframes
# recurse one level deeper.
fn _web_render_child_pixels(child_html: text, cw: i32, ch: i32, extra_rules: Rules, depth: i32) -> [u32]:
    if cw <= 0 or ch <= 0:
        return []
    val nodes = parse_html(child_html)
    # Explicit trailing args: omitted defaults are not reliable on the
    # freestanding SimpleOS build (see simple_web_html_layout_renderer).
    val own_rules = extract_css_vw(child_html, cw, false)
    val rules = Rules(
        group_parts: extra_rules.group_parts + own_rules.group_parts,
        group_specificities: extra_rules.group_specificities + own_rules.group_specificities,
        decls: extra_rules.decls + own_rules.decls,
        important_decls: (
            extra_rules.important_decls + own_rules.important_decls
        ))
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(nodes, styles, child_index, 0, 0, 0, cw, ch, zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), empty_starts, empty_ends, neg_one_i32_list(node_count))
    val white = argb(255, 255, 255)
    val base = _web_canvas_background(nodes, styles, white)
    var fb = browser_layout_framebuffer_filled(base, cw, ch)
    val wrap_cache = TextWrapCache(starts: boxes.wrap_starts, ends: boxes.wrap_ends)
    var painted = paint(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, wrap_cache, fb, cw, ch, false)
    painted = _web_paint_iframes(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, rules, painted, cw, ch, depth)
    painted

# Blit every iframe's rendered child document over its content box. `parent_rules`
# is the current document's rule set, forwarded to "shared" children. `depth` is
# the current document's depth; a child at depth+1 beyond the cap is replaced by
# a flat placeholder and never recursed into.
fn _web_paint_iframes(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], parent_rules: Rules, fb: [u32], fbw: i32, fbh: i32, depth: i32) -> [u32]:
    var out = fb
    val node_count = nodes.len() as i32
    var i = 0
    # cpu-lane-loop-ok: one pass over the node list blitting each iframe's separately-rendered child framebuffer; bound is node_count and only iframe-tagged nodes do work
    while i < node_count:
        val nd = nodes[i]
        if nd.tag == "iframe":
            val st = styles[i]
            val hidden = st.display == "none" or st.visibility_hidden or content_paint_hidden_by_ancestor(nodes, styles, i)
            if not hidden:
                val cx = bx[i] + st.border_l + st.pad_l
                val cy = by[i] + st.border_t + st.pad_t
                val cw = bw[i] - st.border_l - st.border_r - st.pad_l - st.pad_r
                val ch = bh[i] - st.border_t - st.border_b - st.pad_t - st.pad_b
                if cw > 0 and ch > 0 and cx < fbw and cy < fbh:
                    if depth + 1 > WEB_IFRAME_DEPTH_CAP:
                        out = fb_rect(out, fbw, fbh, cx, cy, cw, ch, WEB_IFRAME_PLACEHOLDER)
                    else:
                        val child_html = _web_iframe_child_html(nd)
                        val shared = attr_value(nd.attrs_raw, "space").trim().lower() == "shared"
                        val extra = if shared: parent_rules else: _web_empty_rules()
                        # Give the child at most HALF the parent's remaining budget
                        # so a heavy child cannot stall the parent render.
                        val save_deadline = _web_render_deadline_us
                        val now = _web_budget_clock.now_micros()
                        if _web_render_deadline_us > now:
                            _web_render_deadline_us = now + (_web_render_deadline_us - now) / 2
                        val child_px = _web_render_child_pixels(child_html, cw, ch, extra, depth + 1)
                        _web_render_deadline_us = save_deadline
                        if child_px.len() == cw * ch:
                            out = _web_blit_child(out, fbw, fbh, cx, cy, cw, ch, child_px)
        i = i + 1
    out
