fn _html_draw_ir_image_index_by_uri(
    images: [SimpleOsHostGpuImageResource]
) -> Dict<text, i32>:
    # First VALID resource per uri wins, exactly like the linear scan this
    # index replaces: an invalid entry never shadows a later valid one.
    var by_uri: Dict<text, i32> = {}
    var index = 0
    # cpu-lane-loop-ok: one pass over the image list building the uri -> index map that every per-node lookup reads; bound is images.len(), built once per _html_draw_ir_commands
    while index < images.len():
        val image = images[index]
        if image.width > 0 and image.height > 0 and
            image.pixels.len() == image.width.to_i64() * image.height.to_i64() and
            not by_uri.contains_key(image.image_uri):
            by_uri[image.image_uri] = index
        index = index + 1
    by_uri

fn _html_draw_ir_image_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, images: [SimpleOsHostGpuImageResource],
    image_index_by_uri: Dict<text, i32>, ancestor_clip: ClipRect
) -> DrawIrCommand?:
    val node = nodes[i]
    if node.tag != "img" and node.tag != "video":
        return nil
    val image_attr = if node.tag == "video": "poster" else: "src"
    val image_uri = attr_value(node.attrs_raw, image_attr).trim()
    val image_index = _html_draw_ir_image_index(image_index_by_uri, image_uri)
    if image_index < 0:
        return nil
    val st = styles[i]
    val box_x = boxes.bx[i] + st.border_l + st.pad_l
    val box_y = boxes.by[i] + st.border_t + st.pad_t
    val box_w = _html_draw_ir_non_negative(
        boxes.bw[i] - st.border_l - st.border_r - st.pad_l - st.pad_r
    )
    val box_h = _html_draw_ir_non_negative(
        boxes.bh[i] - st.border_t - st.border_b - st.pad_t - st.pad_b
    )
    if box_w <= 0 or box_h <= 0:
        return nil
    val image = images[image_index]
    val (draw_w, draw_h) = _html_draw_ir_fit_size(
        st.object_fit, box_w, box_h, image.width, image.height
    )
    if draw_w <= 0 or draw_h <= 0:
        return nil
    val draw_x = box_x + (
        (box_w.to_i64() - draw_w.to_i64()) *
        object_position_x_pct(st.object_position).to_i64() / 100
    ).to_i32()
    val draw_y = box_y + (
        (box_h.to_i64() - draw_h.to_i64()) *
        object_position_y_pct(st.object_position).to_i64() / 100
    ).to_i32()
    val clip = clip_intersect(
        ancestor_clip, box_x, box_y, box_x + box_w, box_y + box_h
    )
    if clip.x1 <= clip.x0 or clip.y1 <= clip.y0:
        return nil
    var command = draw_ir_image_command(
        _html_draw_ir_component_id(node, i) + "_image",
        draw_x, draw_y, draw_w, draw_h, image_uri,
        _html_draw_ir_style_props(node, st)
    )
    command.clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    Some(command)

fn _html_draw_ir_background_image_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, images: [SimpleOsHostGpuImageResource],
    image_index_by_uri: Dict<text, i32>,
    ancestor_clip: ClipRect, viewport_width: i32, viewport_height: i32,
    layer: HtmlDrawIrBackgroundLayer
) -> DrawIrCommand?:
    val st = styles[i]
    if (
        layer.image_uri == ""
    ):
        return nil
    val image_index = _html_draw_ir_image_index(image_index_by_uri, layer.image_uri)
    if image_index < 0:
        return nil
    val image = images[image_index]
    val (element_origin_x, element_origin_w) = _html_draw_ir_background_edge(
        layer.origin, boxes.bx[i], boxes.bw[i],
        st.border_l, st.border_r, st.pad_l, st.pad_r
    )
    val (element_origin_y, element_origin_h) = _html_draw_ir_background_edge(
        layer.origin, boxes.by[i], boxes.bh[i],
        st.border_t, st.border_b, st.pad_t, st.pad_b
    )
    var origin_x = element_origin_x
    var origin_y = element_origin_y
    var origin_w = element_origin_w
    var origin_h = element_origin_h
    if layer.attachment == "fixed":
        origin_x = 0
        origin_y = 0
        origin_w = viewport_width
        origin_h = viewport_height
    val (clip_x, clip_w) = _html_draw_ir_background_edge(
        layer.clip, boxes.bx[i], boxes.bw[i],
        st.border_l, st.border_r, st.pad_l, st.pad_r
    )
    val (clip_y, clip_h) = _html_draw_ir_background_edge(
        layer.clip, boxes.by[i], boxes.bh[i],
        st.border_t, st.border_b, st.pad_t, st.pad_b
    )
    var clip_inset_l = 0
    var clip_inset_t = 0
    var clip_inset_r = 0
    var clip_inset_b = 0
    if layer.clip == "padding-box" or layer.clip == "content-box":
        clip_inset_l = st.border_l
        clip_inset_t = st.border_t
        clip_inset_r = st.border_r
        clip_inset_b = st.border_b
    if layer.clip == "content-box":
        clip_inset_l = clip_inset_l + st.pad_l
        clip_inset_t = clip_inset_t + st.pad_t
        clip_inset_r = clip_inset_r + st.pad_r
        clip_inset_b = clip_inset_b + st.pad_b
    val clip = clip_intersect(
        ancestor_clip, clip_x, clip_y, clip_x + clip_w, clip_y + clip_h
    )
    if clip.x1 <= clip.x0 or clip.y1 <= clip.y0:
        return nil
    var tile_w = layer.size_w
    var tile_h = layer.size_h
    if tile_w <= 0 and tile_h <= 0:
        tile_w = image.width
        tile_h = image.height
    elif tile_w <= 0:
        tile_w = (
            tile_h.to_i64() * image.width.to_i64() / image.height.to_i64()
        ).to_i32()
    elif tile_h <= 0:
        tile_h = (
            tile_w.to_i64() * image.height.to_i64() / image.width.to_i64()
        ).to_i32()
    if tile_w <= 0 or tile_h <= 0:
        return nil
    val tile_x = origin_x + _html_draw_ir_background_offset(
        layer.position_x, origin_w - tile_w
    )
    val tile_y = origin_y + _html_draw_ir_background_offset(
        layer.position_y, origin_h - tile_h
    )
    var props = _html_draw_ir_style_props(nodes[i], st)
    props.push(draw_ir_style_prop("image-role", "css-background"))
    if layer.index >= 0:
        props.push(draw_ir_style_prop("background-layer-index", "{layer.index}"))
    var prop_index = 0
    while prop_index < props.len():
        if props[prop_index].key == "background-repeat":
            props[prop_index] = draw_ir_style_prop("background-repeat", layer.repeat)
        prop_index = prop_index + 1
    props.push(draw_ir_style_prop("background-tile-x", "{tile_x}"))
    props.push(draw_ir_style_prop("background-tile-y", "{tile_y}"))
    props.push(draw_ir_style_prop("background-tile-width", "{tile_w}"))
    props.push(draw_ir_style_prop("background-tile-height", "{tile_h}"))
    props.push(draw_ir_style_prop("background-shape-x", "{clip_x}"))
    props.push(draw_ir_style_prop("background-shape-y", "{clip_y}"))
    props.push(draw_ir_style_prop("background-shape-width", "{clip_w}"))
    props.push(draw_ir_style_prop("background-shape-height", "{clip_h}"))
    props.push(draw_ir_style_prop("background-radius-tl-x",
        "{_html_draw_ir_non_negative(st.border_radius_tl_px - clip_inset_l)}"))
    props.push(draw_ir_style_prop("background-radius-tl-y",
        "{_html_draw_ir_non_negative(st.border_radius_tl_px - clip_inset_t)}"))
    props.push(draw_ir_style_prop("background-radius-tr-x",
        "{_html_draw_ir_non_negative(st.border_radius_tr_px - clip_inset_r)}"))
    props.push(draw_ir_style_prop("background-radius-tr-y",
        "{_html_draw_ir_non_negative(st.border_radius_tr_px - clip_inset_t)}"))
    props.push(draw_ir_style_prop("background-radius-br-x",
        "{_html_draw_ir_non_negative(st.border_radius_br_px - clip_inset_r)}"))
    props.push(draw_ir_style_prop("background-radius-br-y",
        "{_html_draw_ir_non_negative(st.border_radius_br_px - clip_inset_b)}"))
    props.push(draw_ir_style_prop("background-radius-bl-x",
        "{_html_draw_ir_non_negative(st.border_radius_bl_px - clip_inset_l)}"))
    props.push(draw_ir_style_prop("background-radius-bl-y",
        "{_html_draw_ir_non_negative(st.border_radius_bl_px - clip_inset_b)}"))
    var command = draw_ir_image_command(
        _html_draw_ir_component_id(nodes[i], i) + "_background_image" +
            if layer.index >= 0: "_{layer.index}" else: "",
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0,
        layer.image_uri, props
    )
    command.clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    Some(command)

fn _html_draw_ir_summary_marker_command(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, clip: ClipRect
) -> DrawIrCommand?:
    val node = nodes[i]
    val st = styles[i]
    val parent = node.parent
    if (
        not node.is_details_summary or st.display != "list-item" or
        parent < 0 or nodes[parent].tag != "details"
    ):
        return nil
    val marker_state = if attr_present(nodes[parent].attrs_raw, "open"):
        "open"
    else:
        "closed"
    val marker_open = marker_state == "open"
    var computed_style = _html_draw_ir_style_props(node, st)
    computed_style.push(draw_ir_style_prop(
        "summary-marker", "disclosure"
    ))
    computed_style.push(draw_ir_style_prop(
        "summary-marker-state", marker_state
    ))
    # Chrome 159 paints the disclosure symbol as a filled path, not a glyph
    # (list_marker_painter.cc canonical disclosure paths, in a unit square):
    # closed (0,0) (0.86,0.5) (0,1); open (0,0.07) (0.5,0.93) (1,0.07). The
    # square is `summary_marker_symbol_64` wide, at the content start, and
    # ends on the baseline of the summary's strut, from the resolved face's own
    # ascent and descent (Chrome 159 serif 24px, line-height normal: 21, where
    # a sans 0.905em ascent gives 22). Points are 1/64 px.
    val fs = st.font_size
    val size = summary_marker_symbol_64(fs)
    val content_x = boxes.bx[i] + st.border_l + st.pad_l
    val line_top = boxes.by[i] + st.border_t + st.pad_t
    val x0 = content_x * 64
    val y0 = (line_top + inline_line_strut_baseline_offset(st)) * 64 - size
    val points: [DrawIrPoint] = if marker_open:
        [
            DrawIrPoint(x: x0, y: y0 + size * 7 / 100),
            DrawIrPoint(x: x0 + size / 2, y: y0 + size * 93 / 100),
            DrawIrPoint(x: x0 + size, y: y0 + size * 7 / 100)
        ]
    else:
        [
            DrawIrPoint(x: x0, y: y0),
            DrawIrPoint(x: x0 + size * 86 / 100, y: y0 + size / 2),
            DrawIrPoint(x: x0, y: y0 + size)
        ]
    computed_style.push(draw_ir_style_prop("path-fill", "{st.fg}"))
    computed_style.push(draw_ir_style_prop("path-units", "64"))
    var marker = draw_ir_path_command(
        _html_draw_ir_component_id(node, i) + "::marker",
        points, computed_style, _html_draw_ir_component_id(node, i)
    )
    marker.clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    # The command box is the symbol square in whole px, for culling.
    marker.x = content_x
    marker.y = y0 / 64
    marker.width = (size + 63) / 64
    marker.height = (y0 % 64 + size + 63) / 64
    marker

# Vertical font metrics Chrome uses for the generic sans face (Arial /
# Liberation Sans / Helvetica share them): ascent 0.905em, descent 0.212em,
# both rounded to whole pixels as Skia's FontMetrics are. Used only to place
# list-marker symbols and text-decoration rules the way Chrome does.
fn _html_draw_ir_chrome_ascent(font_size: i32) -> i32:
    (font_size * 905 + 500) / 1000

fn _html_draw_ir_chrome_descent(font_size: i32) -> i32:
    (font_size * 212 + 500) / 1000

# Chrome's half-leading text top inside a line box: the y where a run of this
# font starts when the line box is `lh` tall.
fn _html_draw_ir_chrome_text_top(line_top: i32, lh: i32, font_size: i32) -> i32:
    (2 * line_top + lh - _html_draw_ir_chrome_ascent(font_size) -
        _html_draw_ir_chrome_descent(font_size)) / 2

# list-style-position: outside markers for the synthesized `::marker` boxes
# (parse/style/geometry: bug browser_engine_no_list_marker_boxes_2026-08-19;
# that change stopped at geometry, so nothing was painted). Chrome 131:
# - `ol` (decimal): the text "N. " in the li's font, its end on the li's
#   content edge (16px: "1." ink x 23..34 for content x 40).
# - `ul`/`menu` (disc): a filled circle from ListMarker's symbol metrics,
#   a = ascent, o = a*2/3, side = (o+1)/2, x = content - o - 7,
#   y = text top + 3(a-o)/2 (16px: 5x5 at x 24, line top + 10).
# Scope: disc/decimal defaults only. Nested-list circle/square, other
# list-style-type values, and the ol `start`/`reversed`/li `value` attributes
# are not implemented (the ordinal is the li's index among its li siblings).
fn _html_draw_ir_list_marker_commands(
    nodes: [HNode], styles: [Style], boxes: LayoutResult, i: i32,
    clip: ClipRect, vector_fonts: bool
) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = []
    val node = nodes[i]
    val st = styles[i]
    if node.tag != "::marker" or st.display != "marker":
        return out
    val li = node.parent as i32
    if li < 0:
        return out
    val list = nodes[li].parent as i32
    if list < 0:
        return out
    val li_st = styles[li]
    val content_x = boxes.bx[li] + li_st.border_l + li_st.pad_l
    val line_top = boxes.by[li] + li_st.border_t + li_st.pad_t
    val lh = style_line_h(li_st)
    val fs = st.font_size
    val text_top = _html_draw_ir_chrome_text_top(line_top, lh, fs)
    val clip_rect = draw_ir_rect_bounds(
        clip.x0, clip.y0, clip.x1 - clip.x0, clip.y1 - clip.y0
    )
    if nodes[list].tag == "ol":
        var ordinal = 1
        var j = list + 1
        # cpu-lane-loop-ok: counts the li's preceding li siblings; bound is the list's subtree before this li
        while j < li:
            if nodes[j].parent as i32 == list and nodes[j].tag == "li":
                ordinal = ordinal + 1
            j = j + 1
        val label = "{ordinal}. "
        var marker = _html_draw_ir_resolved_text_command(
            nodes, i, node, st, _html_draw_ir_component_id(node, i) + "-text",
            content_x, text_top, label, _html_draw_ir_style_props(node, st),
            clip_rect, vector_fonts
        )
        val label_w = if marker.width > 0:
            marker.width
        else:
            style_text_line_advance_width_with(
                style_run_byte_advances(st, label), label, 0, label.byte_len(),
                style_text_advance(st), style_space_advance(st)
            )
        marker.x = content_x - label_w
        out.push(marker)
        return out
    val ascent = _html_draw_ir_chrome_ascent(fs)
    val offset = ascent * 2 / 3
    val side = (offset + 1) / 2
    if side <= 0:
        return out
    val disc_rect = draw_ir_rect_bounds(content_x - offset - 7, text_top + 3 * (ascent - offset) / 2, side, side)
    out.push(draw_ir_box_with_style(
        _html_draw_ir_component_id(node, i) + "::marker-disc",
        disc_rect.x, disc_rect.y, side, side, st.fg,
        disc_rect, disc_rect, disc_rect, clip_rect,
        [draw_ir_style_prop("border-radius", "{side / 2}")]
    ))
    out

# `text-decoration-line: underline` for a #text node's emitted text runs (UA
# `a:link` and authored underlines). The Draw IR text command carries the
# decoration only as a style prop, which no Engine2D executor reads, so the
# rule is emitted as its own rect under each run. Placement follows Chrome:
# top = baseline + round(0.106em - thickness/2), thickness = round(0.0733em)
# (min 1) unless `text-decoration-thickness` is set; the baseline is the run's
# y plus the ascent, i.e. relative to where the glyphs are drawn.
fn _html_draw_ir_underline_commands(
    node: HNode, st: Style, runs: [DrawIrCommand]
) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = []
    if node.tag != "#text" or not st.text_decoration_underline:
        return out
    val fs = st.font_size
    val thickness = style_decoration_thickness_px(st)
    val below = (fs * 1060 - thickness * 5000 + 5000) / 10000
    val color = if st.text_decoration_color != 0u32: st.text_decoration_color else: st.fg
    # cpu-lane-loop-ok: one rule per emitted text line of this node; bound is the node's wrapped line count
    for run in runs:
        if run.kind == "text" and run.width > 0:
            out.push(draw_ir_rect_clipped(
                run.component_id + "::underline", run.x,
                run.y + _html_draw_ir_chrome_ascent(fs) + below + st.text_underline_offset_px,
                run.width, thickness, color, run.clip_rect
            ))
    out

fn _html_draw_ir_abs_i32(value: i32) -> i64:
    if value < 0: 0 - value.to_i64() else: value.to_i64()

fn _html_draw_ir_saturated_i32(value: i64) -> i32:
    _html_draw_ir_clamp_i64(
        value, 0i64 - 2147483647i64 - 1i64, 2147483647i64
    ).to_i32()

fn _html_draw_ir_visible(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    i: i32, clip: ClipRect
) -> bool:
    if i <= 0:
        return false
    val display = styles[i].display
    val box_w = boxes.bw[i]
    val box_h = boxes.bh[i]
    if display == "none":
        return false
    if styles[i].visibility_hidden:
        return false
    if html_text_paint_fully_transparent(nodes[i], styles[i]):
        return false
    val ancestor_hidden = content_paint_hidden_by_ancestor(nodes, styles, i)
    if ancestor_hidden:
        return false
    if box_w <= 0:
        return false
    if box_h <= 0:
        return false
    if clip.x1 <= clip.x0 or clip.y1 <= clip.y0:
        return false
    val st = styles[i]
    val effect_x = (
        st.outline_w.to_i64() + _html_draw_ir_abs_i32(st.outline_offset_px) +
        _html_draw_ir_abs_i32(st.box_shadow_x_px) +
        st.box_shadow_blur_px.to_i64() +
        _html_draw_ir_abs_i32(st.text_shadow_x_px)
    )
    val effect_y = (
        st.outline_w.to_i64() + _html_draw_ir_abs_i32(st.outline_offset_px) +
        _html_draw_ir_abs_i32(st.box_shadow_y_px) +
        st.box_shadow_blur_px.to_i64() +
        _html_draw_ir_abs_i32(st.text_shadow_y_px) +
        _html_draw_ir_abs_i32(st.text_underline_offset_px) +
        st.text_decoration_thickness_px.to_i64()
    )
    var x0 = boxes.bx[i].to_i64() - effect_x
    var y0 = boxes.by[i].to_i64() - effect_y
    var x1 = boxes.bx[i].to_i64() + box_w.to_i64() + effect_x
    var y1 = boxes.by[i].to_i64() + box_h.to_i64() + effect_y
    if st.box_shadow_raw != "":
        val layers = split_top_level_commas(st.box_shadow_raw)
        for layer in layers:
            if not layer.contains("inset"):
                val prefix = shadow_length_prefix(layer)
                val ox = parse_signed_nth_int(prefix, 0)
                val oy = parse_signed_nth_int(prefix, 1)
                if ox != -1000000 and oy != -1000000:
                    var blur = parse_signed_nth_int(prefix, 2)
                    if blur == -1000000 or blur <= 0:
                        blur = 1
                    var sp = parse_signed_nth_int(prefix, 3)
                    if sp == -1000000 or sp < 0:
                        sp = 0
                    val shadow_pad = blur.to_i64() + sp.to_i64()
                    val shadow_x0 = (
                        boxes.bx[i].to_i64() + ox.to_i64() - shadow_pad
                    )
                    val shadow_y0 = (
                        boxes.by[i].to_i64() + oy.to_i64() - shadow_pad
                    )
                    val shadow_x1 = (
                        boxes.bx[i].to_i64() + ox.to_i64() +
                        box_w.to_i64() + shadow_pad
                    )
                    val shadow_y1 = (
                        boxes.by[i].to_i64() + oy.to_i64() +
                        box_h.to_i64() + shadow_pad
                    )
                    if shadow_x0 < x0: x0 = shadow_x0
                    if shadow_y0 < y0: y0 = shadow_y0
                    if shadow_x1 > x1: x1 = shadow_x1
                    if shadow_y1 > y1: y1 = shadow_y1
    if (x1 <= clip.x0.to_i64() or y1 <= clip.y0.to_i64() or
        x0 >= clip.x1.to_i64() or y0 >= clip.y1.to_i64()):
        return false
    true

fn _html_draw_ir_visible_nodes(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    clip_cache: PaintClipCache
) -> [bool]:
    var visible: [bool] = [false; nodes.len()]
    var i: i32 = 0
    # cpu-lane-loop-ok: one visibility decision per node into a reusable [bool] mask so downstream Draw IR emission does not recompute visibility; bound is nodes.len()
    while i < nodes.len():
        visible[i] = _html_draw_ir_visible(
            nodes, styles, boxes, i, paint_clip_at(clip_cache, i)
        )
        i = i + 1
    visible

fn _html_draw_ir_append_context_paint_order(
    styles: [Style], members: [[i32]], child_contexts: [[i32]],
    context_id: i32, order: [i32]
) -> [i32]:
    var result = order
    # cpu-lane-loop-ok: appends the members of one stacking context in document order; summed over the whole recursion each node is appended exactly once, so the total is O(node_count)
    for member in members[context_id]:
        result.push(member)
    val children = _sort_positive_z_indices(
        child_contexts[context_id],
        child_contexts[context_id].len(),
        styles
    )
    # cpu-lane-loop-ok: recurses into the z-sorted child stacking contexts of one context; bound is that context's child count and each context is visited exactly once
    for child in children:
        result = _html_draw_ir_append_context_paint_order(
            styles, members, child_contexts, child + 1, result
        )
    result

fn _html_draw_ir_opens_context(st: Style) -> bool:
    (st.position_absolute or st.position_fixed or st.position_relative) and st.z_index >= 0

# Context id per node, as `_html_draw_ir_node_paint_order` groups them: 0 is
# the document, a context-opening node i is i + 1.
fn _html_draw_ir_node_contexts(nodes: [HNode], styles: [Style]) -> [i32]:
    var ctx: [i32] = [0; nodes.len()]
    var i: i32 = 0
    # cpu-lane-loop-ok: one forward pass, parents precede children; bound is node_count
    while i < nodes.len():
        val parent = nodes[i].parent
        ctx[i] = if _html_draw_ir_opens_context(styles[i]):
            i + 1
        elif parent >= 0 and parent < i:
            ctx[parent]
        else:
            0
        i = i + 1
    ctx

# Chrome paints an in-flow box's outline in its context's outline phase:
# after every member of the context, before its positioned child contexts.
# ponytail: a box under a fractional-opacity ancestor (inside its context)
# keeps its outline inline so the opacity group's command run stays
# contiguous; upgrade by flushing deferred outlines at the group's end.
fn _html_draw_ir_outline_deferrable(nodes: [HNode], styles: [Style], i: i32, context: i32) -> bool:
    val st = styles[i]
    if nodes[i].tag == "#text" or st.outline_w <= 0 or st.outline_color == 0u32:
        return false
    var p = i
    # cpu-lane-loop-ok: ancestor walk up to the context root; bound is tree depth
    while p >= 0:
        if styles[p].opacity_pct < 100:
            return false
        if p == context - 1:
            return true
        p = nodes[p].parent
    true

# The outline-phase twin of a box command: no paint but its outline, and no
# hit area (the box command keeps it).
fn _html_draw_ir_outline_phase_command(command: DrawIrCommand) -> DrawIrCommand:
    var out = _html_draw_ir_widget_suppressed_box(command, true, false)
    var props: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: copies one command's prop list restoring outline-width; bound is that list
    for prop in out.computed_style:
        if prop.key == "outline-width":
            props.push(draw_ir_style_prop("outline-width", _html_draw_ir_prop_value(command, "outline-width")))
        else:
            props.push(prop)
    out.computed_style = props
    out.component_id = command.component_id + "#outline"
    out.hit_rect = draw_ir_rect_bounds(0, 0, 0, 0)
    out

fn _html_draw_ir_prop_value(command: DrawIrCommand, key: text) -> text:
    # cpu-lane-loop-ok: linear lookup in one command's prop list
    for prop in command.computed_style:
        if prop.key == key:
            return prop.value
    ""

fn _html_draw_ir_without_outline(command: DrawIrCommand) -> DrawIrCommand:
    var out = command
    var props: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: copies one command's prop list zeroing outline-width; bound is that list
    for prop in command.computed_style:
        if prop.key == "outline-width":
            props.push(draw_ir_style_prop("outline-width", "0"))
        else:
            props.push(prop)
    out.computed_style = props
    out

fn _html_draw_ir_node_paint_order(
    nodes: [HNode], styles: [Style]
) -> [i32]:
    val node_count = nodes.len()
    # Context zero is the document. Positive positioned nodes use node index + 1
    # so their ordinary descendants stay grouped while nested positive siblings
    # are sorted stably inside the nearest supported stacking context.
    var node_context: [i32] = [0; node_count]
    var members: [[i32]] = []
    var child_contexts: [[i32]] = []
    var ctx_init: i32 = 0
    # cpu-lane-loop-ok: allocate distinct mutable bucket per stacking context
    while ctx_init <= node_count:
        var empty_m: [i32] = []
        var empty_c: [i32] = []
        members.push(empty_m)
        child_contexts.push(empty_c)
        ctx_init = ctx_init + 1
    var i: i32 = 0
    # cpu-lane-loop-ok: assigns each node to its nearest supported stacking context and registers it as a member; single forward O(node_count) pass, parents precede children
    while i < node_count:
        val parent = nodes[i].parent
        val parent_context = if parent >= 0 and parent < i:
            node_context[parent]
        else:
            0
        # CSS 2.1 Appendix E: positioned boxes with z-index auto/0 paint after
        # the in-flow blocks and inlines of their context, in tree order, and
        # positive z-index paints after those (stable z sort keeps 0 first).
        # ponytail: a z-auto box is grouped like a context, so a positive-z
        # descendant sorts inside it rather than in the real ancestor context;
        # upgrade by flattening z-auto members into the parent's child list.
        if _html_draw_ir_opens_context(styles[i]):
            child_contexts[parent_context].push(i)
            node_context[i] = i + 1
            members[i + 1].push(i)
        else:
            node_context[i] = parent_context
            members[parent_context].push(i)
        i = i + 1
    _html_draw_ir_append_context_paint_order(
        styles, members, child_contexts, 0, []
    )

fn _html_draw_ir_descendant_bottom(
    nodes: [HNode], styles: [Style], boxes: LayoutResult
) -> [i64]:
    var descendant_bottom: [i64] = [0i64; nodes.len()]
    var i = 0
    while i < nodes.len():  # cpu-lane-loop-ok: one raw-layout bottom per node, bounded by node count
        val outer_bottom = boxes.by[i].to_i64() + boxes.bh[i].to_i64()
        # A scrollport's own border is not scrollable content. Begin at its
        # inner bottom; descendants may extend that range below the viewport.
        descendant_bottom[i] = if styles[i].overflow_auto_y or
            styles[i].overflow_scroll_y:
            outer_bottom - styles[i].border_b.to_i64()
        else:
            outer_bottom
        i = i + 1
    i = nodes.len() - 1
    while i >= 0:  # cpu-lane-loop-ok: one reverse subtree-extent pass, bounded by node count
        val parent = nodes[i].parent
        if parent >= 0:
            val own_bottom = boxes.by[i].to_i64() + boxes.bh[i].to_i64()
            val propagated = if styles[i].overflow_hidden or
                styles[i].overflow_auto_y or styles[i].overflow_scroll_y:
                own_bottom
            else:
                descendant_bottom[i]
            val content_bottom = if styles[parent].overflow_auto_y or
                styles[parent].overflow_scroll_y:
                propagated + styles[parent].pad_b.to_i64()
            else:
                propagated
            if content_bottom > descendant_bottom[parent]:
                descendant_bottom[parent] = content_bottom
        i = i - 1
    descendant_bottom

fn _html_draw_ir_commands(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    raw_boxes: LayoutResult,
    width: i32, height: i32, vector_fonts: bool,
    target_keys: [text], overlay: BrowserTextInputOverlay,
    visible_nodes: [bool], images: [SimpleOsHostGpuImageResource],
    clip_cache: PaintClipCache,
    element_scroll_index: i32, element_scroll_top: i32,
    element_scroll_max: i32, widget_mode: bool, widget_chrome_text: bool
) -> ([DrawIrCommand], [i32]):
    # One uri -> index map per render. The per-node loop below used to rescan
    # the whole image list for every img, video and background layer.
    val image_index_by_uri = _html_draw_ir_image_index_by_uri(images)
    var commands: [DrawIrCommand] = []
    var owner_nodes: [i32] = []
    var scrollbar_lowering = false
    # cpu-lane-loop-ok: existence scan over the style list to decide whether scrollbar lowering is needed at all; bound is style count, one pass, result is a single bool
    for st in styles:
        # The raster paints scrollbar chrome only outside legacy widget mode.
        if st.overflow_auto_y and not widget_mode:
            scrollbar_lowering = true
    val paint_order = _html_draw_ir_node_paint_order(nodes, styles)
    val node_contexts = _html_draw_ir_node_contexts(nodes, styles)
    var pending_outlines: [DrawIrCommand] = []
    var pending_outline_owners: [i32] = []
    var pending_context: i32 = -1
    # Cache subtree geometry only when a scrollport exists. A clipping child
    # contributes its own border edge, never its hidden descendants.
    var descendant_bottom: [i64] = []
    var subtree_last_paint: [i32] = []
    var scrollbar_commands_at: [[DrawIrCommand]] = []
    var scrollbar_owners_at: [[i32]] = []
    if scrollbar_lowering:
        descendant_bottom = _html_draw_ir_descendant_bottom(
            nodes, styles, raw_boxes
        )
        # Schedule chrome immediately after the owner's last painted
        # descendant. This keeps it above owned content, below later stacking
        # contexts/glass, and contiguous with its opacity subtree.
        subtree_last_paint = [0; nodes.len()]
        var order_index = 0
        # cpu-lane-loop-ok: records each node's own position within paint_order; single O(paint_order) pass
        while order_index < paint_order.len():
            subtree_last_paint[paint_order[order_index]] = order_index
            order_index = order_index + 1
        var subtree_index = nodes.len() - 1
        # cpu-lane-loop-ok: reverse sweep lifting each node's last-painted descendant index into its parent so scrollbar chrome can flush right after the owner's subtree; one O(node_count) backward pass
        while subtree_index >= 0:
            val subtree_parent = nodes[subtree_index].parent
            if (
                subtree_parent >= 0 and
                subtree_last_paint[subtree_index] >
                    subtree_last_paint[subtree_parent]
            ):
                subtree_last_paint[subtree_parent] = (
                    subtree_last_paint[subtree_index]
                )
            subtree_index = subtree_index - 1
        scrollbar_commands_at = []
        scrollbar_owners_at = []
        var sb_init = 0
        # cpu-lane-loop-ok: allocate distinct mutable scrollbar bucket per paint slot
        while sb_init < paint_order.len():
            var empty_cmds: [DrawIrCommand] = []
            var empty_owners: [i32] = []
            scrollbar_commands_at.push(empty_cmds)
            scrollbar_owners_at.push(empty_owners)
            sb_init = sb_init + 1
        var scrollbar_index = nodes.len() - 1
        # cpu-lane-loop-ok: builds the scrollbar track/thumb Draw IR commands for overflow-auto-y scrollports and buckets them at their owner's flush point; bound is node_count, one pass
        while scrollbar_index >= 0:
            val st = styles[scrollbar_index]
            if (
                scrollbar_index < visible_nodes.len() and
                visible_nodes[scrollbar_index] and
                nodes[scrollbar_index].tag != "#text" and
                st.overflow_auto_y and not st.scrollbar_width_none
            ):
                val raw_track_h = (
                    boxes.bh[scrollbar_index].to_i64() -
                    st.border_t.to_i64() - st.border_b.to_i64()
                )
                val track_h64 = _html_draw_ir_clamp_i64(
                    raw_track_h, 0, 2147483647
                )
                val inner_width64 = (
                    boxes.bw[scrollbar_index].to_i64() -
                    st.border_l.to_i64() - st.border_r.to_i64()
                )
                val track_x64 = (
                    boxes.bx[scrollbar_index].to_i64() +
                    boxes.bw[scrollbar_index].to_i64() -
                    st.border_r.to_i64() - 15
                )
                val track_y64 = (
                    boxes.by[scrollbar_index].to_i64() +
                    st.border_t.to_i64()
                )
                val raw_track_y64 = (
                    raw_boxes.by[scrollbar_index].to_i64() +
                    st.border_t.to_i64()
                )
                val content_extent = (
                    descendant_bottom[scrollbar_index] - raw_track_y64
                )
                if (
                    inner_width64 >= 15 and track_h64 >= 8 and
                    (
                        st.overflow_scroll_y or
                        content_extent > track_h64
                    )
                ):
                    val track_x = _html_draw_ir_saturated_i32(track_x64)
                    val track_y = _html_draw_ir_saturated_i32(track_y64)
                    val track_h = _html_draw_ir_saturated_i32(track_h64)
                    val node_clip = paint_clip_at(
                        clip_cache, scrollbar_index
                    )
                    val scrollport_clip = clip_intersect(
                        node_clip,
                        _html_draw_ir_saturated_i32(
                            boxes.bx[scrollbar_index].to_i64() +
                            st.border_l.to_i64()
                        ),
                        track_y,
                        _html_draw_ir_saturated_i32(
                            boxes.bx[scrollbar_index].to_i64() +
                            boxes.bw[scrollbar_index].to_i64() -
                            st.border_r.to_i64()
                        ),
                        _html_draw_ir_saturated_i32(
                            track_y64 + track_h64
                        )
                    )
                    if (
                        scrollport_clip.x1 > scrollport_clip.x0 and
                        scrollport_clip.y1 > scrollport_clip.y0
                    ):
                        val component_id = _html_draw_ir_component_id(
                            nodes[scrollbar_index], scrollbar_index
                        )
                        val track_color = if (
                            st.scrollbar_track_color != 0u32
                        ):
                            st.scrollbar_track_color
                        else:
                            web_argb(209, 213, 219)
                        val thumb_color = if (
                            st.scrollbar_thumb_color != 0u32
                        ):
                            st.scrollbar_thumb_color
                        else:
                            web_argb(107, 114, 128)
                        var track = _html_draw_ir_overlay_rect(
                            component_id + "_scrollbar_track",
                            ClipRect(
                                x0: track_x, y0: track_y,
                                x1: _html_draw_ir_saturated_i32(
                                    track_x64 + 15
                                ),
                                y1: _html_draw_ir_saturated_i32(
                                    track_y64 + track_h64
                                )
                            ),
                            track_color, scrollport_clip
                        )
                        track.parent_id = component_id
                        track.computed_style = [
                            draw_ir_style_prop(
                                "scrollbar-part", "track"
                            ),
                            draw_ir_style_prop(
                                "scrollbar-color", "{track_color}"
                            )
                        ]
                        val effective_extent = if (
                            content_extent > track_h64
                        ):
                            content_extent
                        else:
                            track_h64
                        var thumb_h64 = (
                            track_h64 * track_h64 / effective_extent
                        )
                        if thumb_h64 < 16:
                            thumb_h64 = 16
                        if thumb_h64 > track_h64:
                            thumb_h64 = track_h64
                        val thumb_offset = if (
                            scrollbar_index == element_scroll_index and
                            element_scroll_max > 0
                        ):
                            (track_h64 - thumb_h64) *
                            element_scroll_top.to_i64() /
                            element_scroll_max.to_i64()
                        else:
                            0i64
                        var thumb = _html_draw_ir_overlay_rect(
                            component_id + "_scrollbar_thumb",
                            ClipRect(
                                x0: track_x,
                                y0: _html_draw_ir_saturated_i32(
                                    track_y64 + thumb_offset
                                ),
                                x1: _html_draw_ir_saturated_i32(
                                    track_x64 + 15
                                ),
                                y1: _html_draw_ir_saturated_i32(
                                    track_y64 + thumb_offset + thumb_h64
                                )
                            ),
                            thumb_color, scrollport_clip
                        )
                        thumb.parent_id = component_id
                        thumb.computed_style = [
                            draw_ir_style_prop(
                                "scrollbar-part", "thumb"
                            ),
                            draw_ir_style_prop(
                                "scrollbar-color", "{thumb_color}"
                            )
                        ]
                        val flush_at = subtree_last_paint[scrollbar_index]
                        scrollbar_commands_at[flush_at].push(track)
                        scrollbar_owners_at[flush_at].push(scrollbar_index)
                        scrollbar_commands_at[flush_at].push(thumb)
                        scrollbar_owners_at[flush_at].push(scrollbar_index)
            scrollbar_index = scrollbar_index - 1
    # Outside widget mode a root gradient list is the canvas background (the
    # raster `_paint_passes` twin): its command paints the canvas, positioned
    # on the html box, and not its own box.
    val canvas_src = if widget_mode: -1 else: canvas_gradient_source(nodes, styles)
    var paint_index: i32 = 0
    # cpu-lane-loop-ok: the Draw IR emission pass: one command group per node in stacking-context paint order. Bound is paint_order.len() == node_count; emitting per node is the whole purpose of this producer
    while paint_index < paint_order.len():
        val i = paint_order[paint_index]
        if pending_outlines.len() > 0 and node_contexts[i] != pending_context:
            # cpu-lane-loop-ok: flushes the context's deferred outlines; bound is its outlined members
            for oc in pending_outlines:
                commands.push(oc)
            # cpu-lane-loop-ok: owners paired with the outlines above
            for oo in pending_outline_owners:
                owner_nodes.push(oo)
            pending_outlines = []
            pending_outline_owners = []
        # Legacy widget mode never paints a #text node as a text run: the
        # generated chrome text or the sparse offset text (both emitted after
        # this loop, as the raster `paint` does) replaces its glyphs.
        val widget_replaces_text = widget_mode and nodes[i].tag == "#text"
        if i < visible_nodes.len() and visible_nodes[i] and not widget_replaces_text:
            val node_clip = paint_clip_at(clip_cache, i)
            val component_id = _html_draw_ir_component_id(nodes[i], i)
            val parent = nodes[i].parent
            val parent_id = if parent >= 0 and parent < nodes.len():
                _html_draw_ir_component_id(nodes[parent], parent)
            else:
                ""
            var node_command = _html_draw_ir_command(
                nodes, styles, boxes, i, node_clip, vector_fonts
            )
            node_command.parent_id = parent_id
            if i == canvas_src:
                val canvas = canvas_background_extent(
                    nodes, boxes.bx, boxes.by, boxes.bw, boxes.bh, width, height)
                val root_layers = canvas_gradient_layers(
                    nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, i)
                node_command = _html_draw_ir_root_canvas_gradient(
                    node_command, root_layers, boxes.bx[i], boxes.by[i], canvas[0], canvas[1])
            # Legacy widget mode box suppression, as the raster `paint`
            # passes 1-4: the html/body background (skip_widget_page_bg) and
            # the whole box paint of a widget-* / icon-image node
            # (skip_widget_node_bg). The command stays, carrying no paint.
            val widget_node_box_skipped = widget_mode and (
                nodes[i].has_widget_class or nodes[i].has_icon_image_class
            )
            val widget_page_bg_skipped = widget_mode and (
                nodes[i].tag == "html" or nodes[i].tag == "body"
            )
            if widget_node_box_skipped or widget_page_bg_skipped:
                # A body background stack with layers keeps its gradient
                # base: the raster paints it under the radial layers.
                val keep_gradient = (
                    not widget_node_box_skipped and nodes[i].tag == "body" and
                    styles[i].bg_layers_raw != ""
                )
                node_command = _html_draw_ir_widget_suppressed_box(
                    node_command, widget_node_box_skipped, keep_gradient
                )
                if keep_gradient and background_gradient_layers_paintable(styles[i]):
                    # The body gradient layer list is the canvas background
                    # too: re-resolve every layer on the canvas (the raster's
                    # fb_gradient_layers_clip on canvas_background_extent).
                    val canvas = canvas_background_extent(
                        nodes, boxes.bx, boxes.by, boxes.bw, boxes.bh, width, height)
                    node_command = _html_draw_ir_canvas_gradient_layers(
                        node_command, styles[i], boxes.bx[i], boxes.by[i], canvas[0], canvas[1])
                elif keep_gradient and styles[i].background_gradient_is_radial:
                    # Chrome propagates the body background to the canvas:
                    # the radial is positioned on, and paints, the canvas
                    # (the raster's fb_background_radial_stack_clip twin).
                    val canvas = canvas_background_extent(
                        nodes, boxes.bx, boxes.by, boxes.bw, boxes.bh, width, height)
                    node_command = _html_draw_ir_canvas_radial(
                        node_command, styles[i], boxes.bx[i], boxes.by[i], canvas[0], canvas[1])
            if not widget_mode and _html_draw_ir_outline_deferrable(nodes, styles, i, node_contexts[i]):
                pending_outlines.push(_html_draw_ir_outline_phase_command(node_command))
                pending_outline_owners.push(i)
                pending_context = node_contexts[i]
                node_command = _html_draw_ir_without_outline(node_command)
            commands.push(node_command)
            owner_nodes.push(i)
            var text_runs: [DrawIrCommand] = [node_command]
            # cpu-lane-loop-ok: pushes the Draw IR text commands for wrapped
            # lines 2..N of one #text node; bound is that node's own
            # layout-precomputed wrap-line count (see
            # _html_draw_ir_wrap_extra_line_commands), empty for every other
            # node kind and for single-line text
            for extra_line_command in _html_draw_ir_wrap_extra_line_commands(
                nodes, styles, boxes, i, node_clip, vector_fonts
            ):
                var extra_line = extra_line_command
                extra_line.parent_id = parent_id
                commands.push(extra_line)
                owner_nodes.push(i)
                text_runs.push(extra_line)
            # cpu-lane-loop-ok: underline rules for this #text node's runs; bound is its line count
            for underline_command in _html_draw_ir_underline_commands(nodes[i], styles[i], text_runs):
                var underline = underline_command
                underline.parent_id = parent_id
                commands.push(underline)
                owner_nodes.push(i)
            # cpu-lane-loop-ok: at most one marker command for a ::marker node, none otherwise
            for list_marker_command in _html_draw_ir_list_marker_commands(
                nodes, styles, boxes, i, node_clip, vector_fonts
            ):
                var list_marker = list_marker_command
                list_marker.parent_id = component_id
                commands.push(list_marker)
                owner_nodes.push(i)
            if val summary_marker = _html_draw_ir_summary_marker_command(
                nodes, styles, boxes, i, node_clip
            ):
                commands.push(summary_marker)
                owner_nodes.push(i)
            # The raster paints the placeholder only outside widget mode.
            if not widget_mode and nodes[i].tag == "img" and nodes[i].has_widget_image_class:
                val ph = widget_image_placeholder_rects(
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    styles[i].object_fit, styles[i].object_position
                )
                val ph_clip = draw_ir_rect_bounds(
                    node_clip.x0, node_clip.y0,
                    node_clip.x1 - node_clip.x0, node_clip.y1 - node_clip.y0
                )
                var k = 0
                # cpu-lane-loop-ok: at most 3 placeholder rects for one img
                while k * 4 < ph.len():
                    commands.push(draw_ir_rect_clipped(
                        component_id + "::placeholder-{k}", ph[k * 4],
                        ph[k * 4 + 1], ph[k * 4 + 2], ph[k * 4 + 3],
                        WIDGET_IMAGE_PLACEHOLDER_COLORS[k], ph_clip, component_id
                    ))
                    owner_nodes.push(i)
                    k = k + 1
            # A widget-mode suppressed box lowers no URL background layer and
            # no border overlay (which would repaint the suppressed border).
            if (
                not widget_node_box_skipped and not widget_page_bg_skipped and
                (styles[i].background_image_uri != "" or styles[i].bg_layers_raw != "")
            ):
                val background_layers = _html_draw_ir_background_layers(styles[i])
                var backgrounds_ready = background_layers.len() > 0
                for layer in background_layers:
                    if _html_draw_ir_image_index(image_index_by_uri, layer.image_uri) < 0:
                        backgrounds_ready = false
                var background_index = background_layers.len() - 1
                var lowered_backgrounds: [DrawIrCommand] = []
                # cpu-lane-loop-ok: lowers the declared background layers back-to-front; bound is background_layers.len(), which _html_draw_ir_two_url_background_layers caps at 2 (or 1 for the single-image form)
                while backgrounds_ready and background_index >= 0:
                    if val background_command = _html_draw_ir_background_image_command(
                        nodes, styles, boxes, i, images, image_index_by_uri,
                        node_clip, width, height,
                        background_layers[background_index]
                    ):
                        var background = background_command
                        background.parent_id = component_id
                        lowered_backgrounds.push(background)
                    else:
                        # A declared pair is atomic: no command survives if either
                        # layer cannot lower through the canonical typed path.
                        backgrounds_ready = false
                    background_index = background_index - 1
                if backgrounds_ready and lowered_backgrounds.len() > 0:
                    # cpu-lane-loop-ok: pushes the already-lowered background commands in declared order; bound is the same background layer count of at most 2
                    for background in lowered_backgrounds:
                        commands.push(background)
                        owner_nodes.push(i)
                    var border_overlay = _html_draw_ir_background_border_overlay(
                        nodes, styles, boxes, i, node_clip, vector_fonts
                    )
                    border_overlay.parent_id = component_id
                    commands.push(border_overlay)
                    owner_nodes.push(i)
            if not widget_node_box_skipped:
                # cpu-lane-loop-ok: dashed/dotted/double border side commands for one node; bound is its four sides
                for border_cmd in _html_draw_ir_styled_border_commands(
                    nodes[i], styles[i], boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i], i, node_clip
                ):
                    var styled_cmd = border_cmd
                    styled_cmd.parent_id = component_id
                    commands.push(styled_cmd)
                    owner_nodes.push(i)
            # The raster paints the select chevron and the checkbox / radio
            # accent control only outside widget mode.
            if not widget_mode and nodes[i].tag == "select":
                for arrow_cmd in _html_draw_ir_select_arrow_commands(
                    nodes[i], styles[i], boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i], i, node_clip
                ):
                    var select_cmd = arrow_cmd
                    select_cmd.parent_id = component_id
                    commands.push(select_cmd)
                    owner_nodes.push(i)
            # The raster paints inline svg shapes only outside widget mode
            # (it paints no video / audio in either mode).
            if (nodes[i].tag == "svg" and not widget_mode) or nodes[i].tag == "video" or nodes[i].tag == "audio":
                # cpu-lane-loop-ok: pushes the replaced-media sub-part commands (svg rects, video surface, audio pill) for one element; bound is that element's shape count
                for media_command in _html_draw_ir_replaced_media_commands(
                    nodes, styles, boxes, i, node_clip
                ):
                    commands.push(media_command)
                    owner_nodes.push(i)
            if val image_command = _html_draw_ir_image_command(
                nodes, styles, boxes, i, images, image_index_by_uri, node_clip
            ):
                var image = image_command
                image.parent_id = component_id
                commands.push(image)
                owner_nodes.push(i)
            if not widget_mode and nodes[i].tag == "input" and input_uses_accent_color(nodes[i]):
                # cpu-lane-loop-ok: pushes the checkbox/radio sub-part commands (frame, border edges, checked indicator) for one input; bound is the fixed small command set _html_draw_ir_checkable_commands builds
                for control_command in _html_draw_ir_checkable_commands(
                    nodes[i], styles[i], i,
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    node_clip
                ):
                    commands.push(control_command)
                    owner_nodes.push(i)
            val overlay_target = (
                i < target_keys.len() and
                target_keys[i] != "" and
                target_keys[i] == overlay.target_key and
                input_accepts_text_overlay(nodes[i])
            )
            # The raster paints static input value text only outside widget
            # mode; a live edit overlay (Draw IR only) still paints.
            if (
                overlay_target or (not widget_mode and _html_draw_ir_has_input_text(
                nodes[i], styles[i], boxes.bw[i]
                ))
            ):
                val node_overlay = if overlay_target:
                    overlay
                else:
                    browser_text_input_overlay_empty()
                val plan = input_text_paint_plan_with_overlay(
                    nodes[i], styles[i],
                    boxes.bx[i], boxes.by[i], boxes.bw[i], boxes.bh[i],
                    node_clip, node_overlay
                )
                if plan.selection_present:
                    var selection = _html_draw_ir_overlay_rect(
                        component_id + "_selection",
                        plan.selection_rect,
                        plan.selection_color,
                        plan.clip
                    )
                    selection.parent_id = component_id
                    commands.push(selection)
                    owner_nodes.push(i)
                if plan.text_value != "":
                    var input_text = _html_draw_ir_input_text_command_from_plan(
                        nodes[i], styles[i], i, plan
                    )
                    input_text.parent_id = component_id
                    commands.push(input_text)
                    owner_nodes.push(i)
                if plan.caret_present:
                    var caret = _html_draw_ir_overlay_rect(
                        component_id + "_caret",
                        plan.caret_rect,
                        plan.caret_color,
                        plan.clip
                    )
                    caret.parent_id = component_id
                    commands.push(caret)
                    owner_nodes.push(i)
        if scrollbar_lowering:
            # cpu-lane-loop-ok: flushes the scrollbar commands bucketed at this paint index; bound is the commands queued for this index, a track+thumb pair per owning scrollport
            for scrollbar_command in scrollbar_commands_at[paint_index]:
                commands.push(scrollbar_command)
            # cpu-lane-loop-ok: flushes the owner node indices paired with the scrollbar commands above; same small per-index bound
            for scrollbar_owner in scrollbar_owners_at[paint_index]:
                owner_nodes.push(scrollbar_owner)
        paint_index = paint_index + 1
    # cpu-lane-loop-ok: flushes the last context's deferred outlines; bound is its outlined members
    for oc in pending_outlines:
        commands.push(oc)
    # cpu-lane-loop-ok: owners paired with the outlines above
    for oo in pending_outline_owners:
        owner_nodes.push(oo)
    # Legacy widget overlays, in the raster `paint` order: the frame over every
    # box, then the node text (sparse offset text in document order, unless the
    # generated chrome text replaces it), then the chrome text table. No node
    # owns them, so their owner is -1 (opacity surfaces then fail closed).
    if widget_mode:
        # cpu-lane-loop-ok: one rect per entry of the fixed legacy widget frame list
        for frame_command in _html_draw_ir_widget_rect_commands("widget-frame-", widget_frame_rects(width, height), width, height):
            commands.push(frame_command)
            owner_nodes.push(-1)
    if widget_mode and not widget_chrome_text:
        val wrap_cache = TextWrapCache(starts: boxes.wrap_starts, ends: boxes.wrap_ends, first_line_dx: boxes.first_line_dx, line_boxes: boxes.line_boxes)
        var offset_text = WidgetChromeRects(xs: [], ys: [], ws: [], hs: [], colors: [])
        var text_index: i32 = 0
        # cpu-lane-loop-ok: the raster text pass order (document order); bound is node_count, legacy widget pages only
        while text_index < nodes.len():
            if nodes[text_index].tag == "#text":
                offset_text = widget_chrome_rects_concat(offset_text, widget_offset_text_node_rects(
                    nodes, styles, boxes.bx, boxes.by, boxes.bw, wrap_cache,
                    text_index, width, height))
            text_index = text_index + 1
        # cpu-lane-loop-ok: one rect per sparse glyph pixel / decoration rule of the legacy widget offset text
        for text_command in _html_draw_ir_widget_rect_commands("widget-offset-text-", offset_text, width, height):
            commands.push(text_command)
            owner_nodes.push(-1)
    if widget_chrome_text:
        # cpu-lane-loop-ok: one 1x1 rect per point of the fixed generated widget chrome text table
        for chrome_command in _html_draw_ir_widget_chrome_text_commands(width, height):
            commands.push(chrome_command)
            owner_nodes.push(-1)
    (_html_draw_ir_device_top(commands, owner_nodes, nodes, boxes), owner_nodes)

# Legacy widget mode box suppression on a node's Draw IR box command, as the
# raster `paint` skips it: the background (fill color, background color and,
# unless `keep_gradient`, the gradient), and for a widget-* / icon-image node
# (`whole_box`) also the border, outline and box shadow. Every other prop, the
# command's id, geometry and owner stay as they were.
# Re-resolve a body radial command's geometry against the canvas
# (width x height from the origin), keeping it relative to the command origin.
fn _html_draw_ir_canvas_radial(command: DrawIrCommand, st: Style, x: i32, y: i32, width: i32, height: i32) -> DrawIrCommand:
    var out = command
    val g = radial_gradient_geometry_q10(st.bg_layers_raw, 0, 0, width, height)
    val geom = _html_draw_ir_radial_geometry_prop([g[0], g[1], g[2], g[3], 0, 0, width as i64, height as i64], x, y)
    var props: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: rewrites one box command's own computed-style list; bound is that prop list
    for prop in command.computed_style:
        if prop.key != "background-gradient-radial-geometry":
            props.push(prop)
    props.push(geom)
    out.computed_style = props
    out

# The propagated root canvas background: the command's own box colour is
# dropped (the canvas base carries it) and its gradient layers, resolved on
# the html box, paint the canvas (width x height from the origin).
fn _html_draw_ir_root_canvas_gradient(command: DrawIrCommand, layers: [BackgroundGradientLayer], x: i32, y: i32, width: i32, height: i32) -> DrawIrCommand:
    var out = command
    out.color = 0u32
    var props: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: rewrites one box command's own computed-style list; bound is that prop list
    for prop in command.computed_style:
        if prop.key == "background-color":
            props.push(draw_ir_style_prop(prop.key, "0"))
        elif prop.key != "background-gradient-layer-geometry" and prop.key != "background-gradient-layer-stops" and prop.key != "background-gradient-layer-tiles" and prop.key != "background-gradient-layer-repeat" and prop.key != "background-gradient-layer-clip-radii":
            props.push(prop)
    if layers.len() > 0:
        for prop in _html_draw_ir_gradient_layer_props(layers, x, y, 0, 0, width, height):
            props.push(prop)
    out.computed_style = props
    out

# Re-resolve a body gradient layer list against the canvas (width x height
# from the origin), relative to the command origin.
fn _html_draw_ir_canvas_gradient_layers(command: DrawIrCommand, st: Style, x: i32, y: i32, width: i32, height: i32) -> DrawIrCommand:
    var out = command
    val layers = background_gradient_layers(st.bg_layers_raw, 0, 0, width, height, st.font_size)
    var props: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: rewrites one box command's own computed-style list; bound is that prop list
    for prop in command.computed_style:
        if prop.key != "background-gradient-layer-geometry" and prop.key != "background-gradient-layer-stops" and prop.key != "background-gradient-layer-tiles" and prop.key != "background-gradient-layer-repeat":
            props.push(prop)
    for prop in _html_draw_ir_gradient_layer_props(layers, x, y, 0, 0, width, height):
        props.push(prop)
    out.computed_style = props
    out

fn _html_draw_ir_widget_suppressed_box(command: DrawIrCommand, whole_box: bool, keep_gradient: bool) -> DrawIrCommand:
    var out = command
    out.color = 0u32
    var props: [DrawIrStyleProp] = []
    # cpu-lane-loop-ok: rewrites one box command's own computed-style list; bound is that prop list
    for prop in command.computed_style:
        val key = prop.key
        if key == "background-color":
            props.push(draw_ir_style_prop(key, "0"))
        elif not keep_gradient and key == "background-image":
            props.push(draw_ir_style_prop(key, "none"))
        elif not keep_gradient and key == "background-gradient-stop-count":
            props.push(draw_ir_style_prop(key, "0"))
        elif not keep_gradient and key == "background-gradient-stops":
            props.push(draw_ir_style_prop(key, ""))
        elif not keep_gradient and (key == "background-gradient-layer-geometry" or key == "background-gradient-layer-stops" or key == "background-gradient-layer-tiles" or key == "background-gradient-layer-repeat"):
            # (dropped: the suppressed box paints no gradient layers)
            continue
        elif whole_box and key == "background-layers-raw":
            props.push(draw_ir_style_prop(key, ""))
        elif whole_box and (key == "border-top-width" or key == "border-right-width" or key == "border-bottom-width" or key == "border-left-width" or key == "outline-width" or key == "box-shadow-layer-count" or key == "box-shadow-blur-radius"):
            props.push(draw_ir_style_prop(key, "0"))
        elif whole_box and key == "box-shadow":
            props.push(draw_ir_style_prop(key, "none"))
        elif whole_box and key == "box-shadow-raw":
            props.push(draw_ir_style_prop(key, ""))
        elif not whole_box or not key.starts_with("box-shadow-layer-"):
            # (a whole-box skip drops the typed shadow layer schema and its
            # per-layer props)
            props.push(prop)
    out.computed_style = props
    out

# Draw IR lowering of the legacy generated widget chrome text: the SAME point
# table the raster `paint` writes (generated_widget_chrome_text_pixels), one
# opaque 1x1 rect per point, clipped to the surface.
fn _html_draw_ir_widget_chrome_text_commands(width: i32, height: i32) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = []
    if not widget_chrome_text_fits(width, height):
        return out
    val pixels = generated_widget_chrome_text_pixels()
    val surface = draw_ir_rect_bounds(0, 0, width, height)
    var k = 0
    # cpu-lane-loop-ok: bound is the fixed point-table length
    while k < pixels.xs.len():
        out.push(draw_ir_rect_clipped(
            "widget-chrome-text-{k}", pixels.xs[k], pixels.ys[k], 1, 1,
            pixels.colors[k], surface
        ))
        k = k + 1
    out

# Draw IR lowering of a legacy widget rect list (frame, offset text): the SAME
# list the raster `paint` writes with fb_widget_chrome_rects, one rect command
# per entry, clipped to the surface.
fn _html_draw_ir_widget_rect_commands(prefix: text, rects: WidgetChromeRects, width: i32, height: i32) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = []
    val surface = draw_ir_rect_bounds(0, 0, width, height)
    var k = 0
    # cpu-lane-loop-ok: bound is the rect list length
    while k < rects.xs.len():
        out.push(draw_ir_rect_clipped(
            "{prefix}{k}", rects.xs[k], rects.ys[k], rects.ws[k], rects.hs[k],
            rects.colors[k], surface
        ))
        k = k + 1
    out

fn _html_draw_ir_canvas_command(width: i32, height: i32, color: u32) -> DrawIrCommand:
    val rect = draw_ir_rect_bounds(0, 0, width, height)
    draw_ir_box_with_style("html-canvas", 0, 0, width, height, color, rect, rect, rect, rect, [])

# CSS canvas background propagation: the viewport (canvas) background comes from
# the root <html> element's computed background-color, or from <body> if the root
# has none, and covers the ENTIRE viewport regardless of the body's content
# height. Returns `fallback` (white) when neither carries a background. The result
# is forced opaque so the whole framebuffer clears to a solid color.
fn _web_canvas_background(nodes: [HNode], styles: [Style], fallback: u32) -> u32:
    val n = nodes.len()
    var html_bg = 0u32
    var body_bg = 0u32
    var i = 0
    # cpu-lane-loop-ok: single scan for the html and body background colors used for CSS canvas background propagation; bound is node_count, one pass, no nesting
    while i < n:
        val nd = nodes[i]
        if nd.tag == "html" and html_bg == 0u32:
            html_bg = styles[i].bg
        else if nd.tag == "body" and body_bg == 0u32:
            body_bg = styles[i].bg
        i = i + 1
    if html_bg != 0u32:
        return _web_canvas_background_over(html_bg, fallback)
    if body_bg != 0u32:
        return _web_canvas_background_over(body_bg, fallback)
    fallback

fn _web_canvas_background_over(color: u32, base: u32) -> u32:
    """Composite a canvas background color over the page base (CSS Backgrounds
    §2.11.2 + CSS Compositing simple alpha `over`). A semi-transparent canvas
    background must blend with the base the UA paints under it, not be forced
    opaque: `rgba(0,0,0,0.5)` over white is #808080, which is what Chrome paints
    and what this used to report as pure black."""
    val a = (color >> 24) & 0xFFu32
    if a >= 255u32:
        return color | 0xFF000000u32
    val br = (base >> 16) & 0xFFu32
    val bg_ = (base >> 8) & 0xFFu32
    val bb = base & 0xFFu32
    val cr = (color >> 16) & 0xFFu32
    val cg = (color >> 8) & 0xFFu32
    val cb = color & 0xFFu32
    # 8-bit alpha is a rounded sample of the authored fraction (`0.5` -> 128),
    # so blending with `255 - a` reintroduces the rounding loss and lands a
    # half-transparent black on white at 127 where Chrome paints 128. Weighting
    # with `256 - a` over a 256 denominator keeps the authored half exact.
    val inv = 256u32 - a
    val r = (cr * a + br * inv + 128u32) / 256u32
    val g = (cg * a + bg_ * inv + 128u32) / 256u32
    val b = (cb * a + bb * inv + 128u32) / 256u32
    0xFF000000u32 | (r << 16) | (g << 8) | b

# Authored alpha fraction of the document canvas background color (body first,
# then html), extracted from the raw markup. Returns -1.0 when the canvas
# background is not a translucent rgba()/hsla() or #RGBA/#RRGGBBAA form.
#
# The parsed alpha BYTE cannot substitute for the fraction: the byte is a
# quantization of the authored value, and no integer blend of the byte
# reproduces both pinned oracle pixels — `rgba(0,0,0,0.5)` over white is
# #808080 (authored half) while `#0008` (authored 8/15, byte 0x88) over white
# is #777777, and the byte-only blends above give 128 for 0x80 but 120 for
# 0x88. The canvas composite therefore needs the authored fraction.
fn _web_canvas_bg_authored_alpha_fraction(html: text) -> f64:
    val lower = html.lower()
    var tag_at = text_index_of(lower, "<body")
    if tag_at < 0:
        tag_at = text_index_of(lower, "<html")
    if tag_at < 0:
        return -1.0
    val tag_end = find_from(html, ">", tag_at)
    if tag_end < 0:
        return -1.0
    val style = attr_value(html.substring(tag_at, tag_end), "style")
    if style.len() == 0:
        return -1.0
    val style_lower = style.lower()
    var value = ""
    val prop_at = find_from(style_lower, "background-color", 0)
    if prop_at >= 0:
        val colon = find_from(style_lower, ":", prop_at)
        if colon >= 0:
            val semi = find_from(style_lower, ";", colon + 1)
            value = style.substring(colon + 1, if semi >= 0: semi else: style.byte_len()).trim()
    if value.len() == 0:
        val bg_at = find_from(style_lower, "background", 0)
        if bg_at >= 0:
            val colon = find_from(style_lower, ":", bg_at)
            if colon >= 0:
                val semi = find_from(style_lower, ";", colon + 1)
                value = style.substring(colon + 1, if semi >= 0: semi else: style.byte_len()).trim()
    if value.len() == 0:
        return -1.0
    val value_lower = value.lower()
    val rgba_at = text_index_of(value_lower, "rgba")
    val hsla_at = text_index_of(value_lower, "hsla")
    var open_at = rgba_at
    if hsla_at >= 0 and (open_at < 0 or hsla_at < open_at):
        open_at = hsla_at
    if open_at >= 0:
        val lp = find_from(value, "(", open_at)
        val rp = if lp >= 0: find_from(value, ")", lp + 1) else: -1
        if lp >= 0 and rp > lp:
            # Alpha is the argument after the LAST top-level comma
            # (`rgba(0, 0, 0, 0.5)`; nested functions stay comma-blind).
            var cut = -1
            var depth = 0
            var i = lp + 1
            while i < rp:
                val c = value.substring(i, i + 1)
                if c == "(":
                    depth = depth + 1
                elif c == ")":
                    depth = depth - 1
                elif c == "," and depth == 0:
                    cut = i
                i = i + 1
            if cut >= 0:
                val tail = value.substring(cut + 1, rp).trim()
                val is_pct = tail.ends_with("%")
                val number_text = if is_pct: tail.substring(0, tail.byte_len() - 1) else: tail
                val parsed = number_text.parse_f64()
                if parsed != nil:
                    var a = parsed ?? 0.0
                    if is_pct:
                        a = a / 100.0
                    if a >= 0.0 and a <= 1.0:
                        return a
        return -1.0
    val hash = text_index_of(value, "#")
    if hash >= 0:
        val hex = value.substring(hash + 1, value.byte_len()).trim()
        if hex.byte_len() == 4 and hex_val(hex.substring(3, 4)) >= 0:
            return hex_val(hex.substring(3, 4)).to_f64() / 15.0
        if hex.byte_len() == 8:
            val byte = hex_val(hex.substring(6, 7)) * 16 + hex_val(hex.substring(7, 8))
            return byte.to_f64() / 255.0
    -1.0

fn _web_canvas_background_over_authored(color: u32, base: u32, alpha_fraction: f64) -> u32:
    if alpha_fraction >= 1.0:
        return color | 0xFF000000u32
    if alpha_fraction <= 0.0:
        return base
    val a = alpha_fraction
    val inv = 1.0 - a
    val br = (base >> 16) & 0xFFu32
    val bg_ = (base >> 8) & 0xFFu32
    val bb = base & 0xFFu32
    val cr = (color >> 16) & 0xFFu32
    val cg = (color >> 8) & 0xFFu32
    val cb = color & 0xFFu32
    val r = (cr.to_f64() * a + br.to_f64() * inv + 0.5).to_i64().to_u32()
    val g = (cg.to_f64() * a + bg_.to_f64() * inv + 0.5).to_i64().to_u32()
    val b = (cb.to_f64() * a + bb.to_f64() * inv + 0.5).to_i64().to_u32()
    0xFF000000u32 | (r << 16) | (g << 8) | b

pub fn web_canvas_background_authored(html: text, nodes: [HNode], styles: [Style], fallback: u32) -> u32:
    """Canvas background with authored-fraction alpha compositing. Identical to
    `_web_canvas_background` unless the winning html/body background is a
    translucent rgba()/hsla() or #RGBA/#RRGGBBAA color, in which case the
    authored alpha fraction (not the quantized byte) blends over the base."""
    val n = nodes.len()
    var html_bg = 0u32
    var body_bg = 0u32
    var i = 0
    while i < n:
        val nd = nodes[i]
        if nd.tag == "html" and html_bg == 0u32:
            html_bg = styles[i].bg
        elif nd.tag == "body" and body_bg == 0u32:
            body_bg = styles[i].bg
        i = i + 1
    val winner = if html_bg != 0u32: html_bg else: body_bg
    if winner == 0u32:
        return _web_canvas_background(nodes, styles, fallback)
    val a_byte = (winner >> 24) & 0xFFu32
    if a_byte == 0u32 or a_byte >= 255u32:
        return _web_canvas_background(nodes, styles, fallback)
    val fraction = _web_canvas_bg_authored_alpha_fraction(html)
    if fraction < 0.0:
        return _web_canvas_background(nodes, styles, fallback)
    _web_canvas_background_over_authored(winner, fallback, fraction)

# ---------------------------------------------------------------------------
# Iframe embedding (rendering-inside-rendering). A hidden/private capability:
# <iframe srcdoc="..."> is a replaced element whose child document is rendered
# by this SAME pipeline into an offscreen [u32] buffer and blitted into the
# parent framebuffer over the iframe's content box. `space` selects the CSS
# scope: "separate" (default) styles the child from its own <style>/attributes
# only; "shared" also applies the parent document's collected CSS rules (parent
# first, child overrides). Depth is capped by WEB_IFRAME_DEPTH_CAP.
# ---------------------------------------------------------------------------

fn _web_empty_rules() -> Rules:
    var gp: [[[text]]] = []
    var gs: [[i32]] = []
    var dc: [text] = []
    var important_dc: [text] = []
    Rules(
        group_parts: gp, group_specificities: gs, decls: dc,
        important_decls: important_dc
    )

fn _web_iframe_child_html(nd: HNode) -> text:
    # srcdoc is the primary (and only supported) content source. attr_value
    # entity-decodes the value, so a srcdoc written with &lt;/&gt;/&quot; yields
    # real child markup (the scanner splits on raw "<"/">", so an iframe's markup
    # MUST arrive entity-encoded inside the attribute). NOTE: the `src` attribute
    # (external URL / local file:// path) is intentionally UNSUPPORTED here — this
    # layout module imports no filesystem or network helper, so there is no
    # reachable way to fetch a src document. srcdoc-only by design.
    attr_value(nd.attrs_raw, "srcdoc")

# Copy a child [u32] buffer (cw*ch) into the parent framebuffer at (dx,dy),
# clipped to the parent bounds. Opaque replace (the iframe box owns its pixels).
fn _web_blit_child(fb: [u32], fbw: i32, fbh: i32, dx: i32, dy: i32, cw: i32, ch: i32, child: [u32]) -> [u32]:
    var out = fb
    if cw <= 0 or ch <= 0:
        return out
    val x0 = if dx < 0: 0 else: dx
    val y0 = if dy < 0: 0 else: dy
    val x1_raw = dx + cw
    val y1_raw = dy + ch
    val x1 = if x1_raw > fbw: fbw else: x1_raw
    val y1 = if y1_raw > fbh: fbh else: y1_raw
    val width = x1 - x0
    val height = y1 - y0
    if width > 0 and height > 0:
        blit_rect(out, fbw.to_i64(), x0.to_i64(), y0.to_i64(), child, cw.to_i64(), (x0 - dx).to_i64(), (y0 - dy).to_i64(), width.to_i64(), height.to_i64())
    out

# Render one child document to a cw*ch [u32] buffer via the full pipeline.
# `extra_rules` are prepended to the child's own rules for "shared" space (empty
# for "separate"). `depth` is the child's own embedding depth; its own iframes
# recurse one level deeper.
fn _web_render_child_pixels(child_html: text, cw: i32, ch: i32, extra_rules: Rules, depth: i32) -> [u32]:
    if cw <= 0 or ch <= 0:
        return []
    val nodes = parse_html(child_html)
    # Explicit trailing args: omitted defaults are not reliable on the
    # freestanding SimpleOS build (see simple_web_html_layout_renderer).
    val own_rules = extract_css_vw(child_html, cw, false)
    val rules = Rules(
        group_parts: extra_rules.group_parts + own_rules.group_parts,
        group_specificities: extra_rules.group_specificities + own_rules.group_specificities,
        decls: extra_rules.decls + own_rules.decls,
        important_decls: (
            extra_rules.important_decls + own_rules.important_decls
        ))
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true, cw, ch)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = web_html_layout_tree(nodes, styles, child_index, 0, 0, 0, cw, cw, ch, zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), zero_i32_list(node_count), empty_starts, empty_ends, neg_one_i32_list(node_count))
    val white = web_argb(255, 255, 255)
    val base = _web_canvas_background(nodes, styles, white)
    var fb = browser_layout_framebuffer_filled(base, cw, ch)
    val wrap_cache = TextWrapCache(starts: boxes.wrap_starts, ends: boxes.wrap_ends, first_line_dx: boxes.first_line_dx, line_boxes: boxes.line_boxes)
    var painted = paint(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, wrap_cache, fb, cw, ch, false)
    painted = _web_paint_iframes(nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh, rules, painted, cw, ch, depth)
    painted

# Blit every iframe's rendered child document over its content box. `parent_rules`
# is the current document's rule set, forwarded to "shared" children. `depth` is
# the current document's depth; a child at depth+1 beyond the cap is replaced by
# a flat placeholder and never recursed into.
fn _web_paint_iframes(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], parent_rules: Rules, fb: [u32], fbw: i32, fbh: i32, depth: i32) -> [u32]:
    var out = fb
    val node_count = nodes.len() as i32
    var i = 0
    # cpu-lane-loop-ok: one pass over the node list blitting each iframe's separately-rendered child framebuffer; bound is node_count and only iframe-tagged nodes do work
    while i < node_count:
        val nd = nodes[i]
        if nd.tag == "iframe":
            val st = styles[i]
            val hidden = st.display == "none" or st.visibility_hidden or content_paint_hidden_by_ancestor(nodes, styles, i)
            if not hidden:
                val cx = bx[i] + st.border_l + st.pad_l
                val cy = by[i] + st.border_t + st.pad_t
                val cw = bw[i] - st.border_l - st.border_r - st.pad_l - st.pad_r
                val ch = bh[i] - st.border_t - st.border_b - st.pad_t - st.pad_b
                if cw > 0 and ch > 0 and cx < fbw and cy < fbh:
                    if depth + 1 > WEB_IFRAME_DEPTH_CAP:
                        out = fb_rect(out, fbw, fbh, cx, cy, cw, ch, WEB_IFRAME_PLACEHOLDER)
                    else:
                        val child_html = _web_iframe_child_html(nd)
                        val shared = attr_value(nd.attrs_raw, "space").trim().lower() == "shared"
                        val extra = if shared: parent_rules else: _web_empty_rules()
                        # Give the child at most HALF the parent's remaining budget
                        # so a heavy child cannot stall the parent render.
                        val save_deadline = _web_render_deadline_us
                        val now = _web_budget_clock.now_micros()
                        if _web_render_deadline_us > now:
                            _web_render_deadline_us = now + (_web_render_deadline_us - now) / 2
                        val child_px = _web_render_child_pixels(child_html, cw, ch, extra, depth + 1)
                        _web_render_deadline_us = save_deadline
                        if child_px.len() == cw * ch:
                            out = _web_blit_child(out, fbw, fbh, cx, cy, cw, ch, child_px)
        i = i + 1
    out

# Device scale k > 1: moves every command by the snapped device top of the box
# that owns it (LayoutResult.device_top) or, for a node no flow pass placed
# (text, inline boxes, inline-blocks, floats, abspos), of its nearest placed
# ancestor. Text adds it to its
# device-px line-metrics offset. Carried as `device-y-offset`, which
# `draw_ir_composition_at_device_scale` applies and strips. Only the top
# moves: a box keeps k x its CSS height, as measured against Chrome on the
# catalog (a bottom snapped from the cursor residual put the overview
# section's border 1 device px above Chrome's). At k == 1 the table is empty
# and the commands are returned untouched.
fn _html_draw_ir_device_top(commands: [DrawIrCommand], owners: [i32], nodes: [HNode], boxes: LayoutResult) -> [DrawIrCommand]:
    if boxes.device_top.len() != nodes.len():
        return commands
    var out: [DrawIrCommand] = []
    var c = 0
    # cpu-lane-loop-ok: one offset lookup per emitted command, k > 1 renders only; the ancestor walk ends at the nearest flow-placed box
    while c < commands.len():
        var command = commands[c]
        var r = if c < owners.len(): owners[c] else: -1
        while r >= 0 and r < nodes.len() and boxes.device_top[r] == DEVICE_TOP_UNSET:
            r = nodes[r].parent
        val dy = if r >= 0 and r < nodes.len(): box_device_top_px(boxes.device_top[r]) else: 0
        if dy != 0:
            var style: [DrawIrStyleProp] = []
            var prior = 0
            for prop in command.computed_style:
                if prop.key == "device-y-offset":
                    prior = prop.value.to_int() as i32
                else:
                    style.push(prop)
            if prior + dy != 0:
                style.push(draw_ir_style_prop("device-y-offset", (prior + dy).to_text()))
            command.computed_style = style
        out.push(command)
        c = c + 1
    out
