fn styles_with_height(styles: [Style], index: i32, height_px: i32) -> [Style]:
    val style_count = styles.len()
    if style_count == 0:
        return []
    var result: [Style] = [styles[0]; style_count]
    var si = 0
    while si < style_count:
        if si == index:
            result[si] = style_with_height(styles[si], height_px)
        else:
            result[si] = styles[si]
        si = si + 1
    result
fn intrinsic_text_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, widths: [i32]) -> IntrinsicWidthResult:
    if widths[i] >= 0:
        return IntrinsicWidthResult(width: widths[i], widths: widths)
    var out_widths = widths
    var width = 0
    var c = child_index.first_child[i]
    while c >= 0:
        if nodes[c].tag == "#text":
            val txt: text = nodes[c].text_trimmed
            if txt.len() > 0:
                val resolved = styles[c].resolved_font_width
                if resolved > 0:
                    width = width + resolved
                else:
                    val glyph_w = style_char_w(styles[c])
                    val ink_w = if glyph_w > 1: glyph_w - 1 else: glyph_w
                    width = width + txt.len() * ink_w
        elif styles[c].display == "inline":
            val child = intrinsic_text_width(nodes, styles, child_index, c, out_widths)
            out_widths = child.widths
            width = width + child.width
        c = child_index.next_sibling[c]
    if nodes[i].tag != "#text":
        width = width + styles[i].pad_l + styles[i].pad_r + styles[i].border_l + styles[i].border_r
    out_widths[i] = width
    IntrinsicWidthResult(width: width, widths: out_widths)

fn inline_text_advance_width(node: HNode, st: Style) -> i32:
    if node.tag != "#text":
        return 0
    val raw = node.text_data
    if st.resolved_font_width > 0 and st.resolved_font_advances.len() == raw.len():
        return st.resolved_font_width
    if raw == " " and node.text_trimmed == "":
        var whitespace_advance = style_space_advance(st) / 3
        if whitespace_advance < 1:
            whitespace_advance = 1
        return whitespace_advance
    var width = 0
    var i = 0
    val n = raw.len()
    val advance = style_text_advance(st)
    val space_advance = style_space_advance(st)
    while i < n:
        val ch = raw.char_code_at(i)
        if ch == 32:
            width = width + space_advance
        elif ch == 9 or ch == 10 or ch == 13:
            if node.text_trimmed != "":
                width = width + space_advance
        else:
            width = width + advance
        i = i + 1
    width

fn text_ink_y_offset(fs: i32) -> i32:
    val scale = glyph_scale(fs)
    if scale > 1:
        return scale + 1
    1

fn text_ink_x_offset(fs: i32) -> i32:
    1

fn wrap_line_end(txt: text, off: i32, cpl: i32) -> i32:
    val n = txt.len()
    var limit = off + cpl
    if limit >= n:
        return n
    var last_space = -1
    var i = off
    while i < limit:
        if txt.char_code_at(i) == 32:
            last_space = i
        i = i + 1
    if last_space > off:
        return last_space
    limit

fn skip_wrap_spaces(txt: text, off: i32) -> i32:
    var out = off
    val n = txt.len()
    while out < n and txt.char_code_at(out) == 32:
        out = out + 1
    out

fn text_line_advance_width(txt: text, start: i32, endv: i32, advance: i32, space_advance: i32) -> i32:
    var width = 0
    var i = start
    while i < endv:
        width = width + if txt.char_code_at(i) == 32: space_advance else: advance
        i = i + 1
    width

fn style_text_line_advance_width(txt: text, start: i32, endv: i32, st: Style, advance: i32, space_advance: i32) -> i32:
    val resolved = resolved_text_range_width(st, start, endv)
    if resolved >= 0:
        return resolved
    text_line_advance_width(txt, start, endv, advance, space_advance)

fn text_line_aligned_x(base_x: i32, line_box_w: i32, line_w: i32, st: Style, line_i: i32, line_count: i32) -> i32:
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "start":
        align = if st.direction_rtl: "right" else: "left"
    elif align == "end":
        align = if st.direction_rtl: "left" else: "right"
    if align == "center":
        return base_x + (line_box_w - line_w) / 2
    if align == "right":
        return base_x + line_box_w - line_w
    base_x

fn text_line_needs_paint_width(st: Style, line_i: i32, line_count: i32) -> bool:
    if st.text_decoration_underline:
        return true
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "center" or align == "right":
        return true
    if align == "start":
        return st.direction_rtl
    if align == "end":
        return not st.direction_rtl
    false

fn ellipsize_text_for_width(txt: text, start: i32, endv: i32, max_width: i32, st: Style, advance: i32, space_advance: i32) -> text:
    if max_width <= 0:
        return ""
    val full_width = style_text_line_advance_width(txt, start, endv, st, advance, space_advance)
    if full_width <= max_width:
        return txt.substring(start, endv)
    val ellipsis = "..."
    val ellipsis_w = text_line_advance_width(ellipsis, 0, ellipsis.len(), advance, space_advance)
    if max_width <= ellipsis_w:
        return ellipsis
    val content_limit = max_width - ellipsis_w
    var out = ""
    var used = 0
    var i = start
    while i < endv:
        val resolved_char_w = resolved_text_range_width(st, i, i + 1)
        val char_w = if resolved_char_w >= 0: resolved_char_w elif txt.char_code_at(i) == 32: space_advance else: advance
        if used + char_w > content_limit:
            break
        out = out + txt.char_at(i)
        used = used + char_w
        i = i + 1
    out + ellipsis

fn compute_wrap_ranges(txt: text, cpl: i32) -> LineWrapRanges:
    val txt_len = txt.len()
    if txt_len == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var line_count = 0
    var count_off = 0
    while count_off < txt_len:
        val endc = wrap_line_end(txt, count_off, cpl)
        line_count = line_count + 1
        count_off = skip_wrap_spaces(txt, endc)
    if line_count <= 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var starts: [i32] = [0; line_count]
    var ends: [i32] = [0; line_count]
    var off = 0
    var line = 0
    while off < txt_len:
        val endc = wrap_line_end(txt, off, cpl)
        starts[line] = off
        ends[line] = endc
        off = skip_wrap_spaces(txt, endc)
        line = line + 1
    LineWrapRanges(starts: starts, ends: ends)

fn compute_style_wrap_ranges(txt: text, max_width: i32, st: Style, fallback_cpl: i32) -> LineWrapRanges:
    if st.resolved_font_identity == "" or st.resolved_font_advances.len() != txt.len() or max_width <= 0:
        return compute_wrap_ranges(txt, fallback_cpl)
    var starts: [i32] = []
    var ends: [i32] = []
    var start = 0
    val n = txt.len()
    while start < n:
        var endv = start
        var used = 0
        var last_space = -1
        while endv < n and used + st.resolved_font_advances[endv] <= max_width:
            used = used + st.resolved_font_advances[endv]
            if txt.char_code_at(endv) == 32:
                last_space = endv
            endv = endv + 1
        if endv == start:
            endv = start + 1
        elif endv < n and last_space > start:
            endv = last_space
        starts.push(start)
        ends.push(endv)
        start = skip_wrap_spaces(txt, endv)
    LineWrapRanges(starts: starts, ends: ends)

fn zero_i32_list(count: i32) -> [i32]:
    [0; count]

fn neg_one_i32_list(count: i32) -> [i32]:
    [-1; count]

fn shifted_i32_list(values: [i32], delta: i32) -> [i32]:
    val count = values.len()
    var shifted: [i32] = [0; count]
    var i = 0
    while i < count:
        shifted[i] = values[i] + delta
        i = i + 1
    shifted

fn empty_i32_lists(count: i32) -> [[i32]]:
    [[]; count]

fn css_outer_width(node: HNode, st: Style, css_width: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_width
    css_width + st.pad_l + st.pad_r + st.border_l + st.border_r

fn css_outer_height(node: HNode, st: Style, css_height: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_height
    css_height + st.pad_t + st.pad_b + st.border_t + st.border_b

fn definite_content_height_limit(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return st.height_px - st.pad_t - st.pad_b - border_y
        return st.height_px
    if st.min_height_px > 0:
        return st.min_height_px
    0

fn constrained_outer_width(node: HNode, st: Style, candidate_width: i32) -> i32:
    var out = candidate_width
    if st.min_width_px > 0:
        val min_outer = css_outer_width(node, st, st.min_width_px)
        if out < min_outer:
            out = min_outer
    if st.max_width_px > 0:
        val max_outer = css_outer_width(node, st, st.max_width_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn constrained_outer_height(node: HNode, st: Style, candidate_height: i32) -> i32:
    var out = candidate_height
    if st.min_height_px > 0:
        val min_outer = css_outer_height(node, st, st.min_height_px)
        if out < min_outer:
            out = min_outer
    if st.max_height_px > 0:
        val max_outer = css_outer_height(node, st, st.max_height_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn absolute_outer_width(parent: Style, node: HNode, st: Style, containing_w: i32) -> i32:
    if st.width_px == 0 and st.left_px > 0 and st.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        var stretched = padding_box_w - st.left_px - st.right_px
        if stretched < 1:
            stretched = 1
        return constrained_outer_width(node, st, stretched)
    if st.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val percent_content_w = padding_box_w * (0 - st.width_px) / 100
        return constrained_outer_width(node, st, css_outer_width(node, st, percent_content_w))
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    if st.width_px > 0:
        return constrained_outer_width(node, st, explicit_node_w)
    constrained_outer_width(node, st, containing_w)

fn absolute_outer_height(node: HNode, st: Style, containing_h: i32) -> i32:
    val border_y = st.border_t + st.border_b
    val resolved_h = resolve_percent_height_px(st.height_px, containing_h)
    if resolved_h > 0:
        if st.border_box:
            return constrained_outer_height(node, st, resolved_h)
        return constrained_outer_height(node, st, resolved_h + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

fn resolve_horizontal_margin_px(margin_px: i32, containing_w: i32) -> i32:
    if margin_px < 0:
        return containing_w * (0 - margin_px) / 100
    margin_px

fn resolve_percent_height_px(height_px: i32, containing_h: i32) -> i32:
    if height_px < 0 and containing_h > 0:
        return containing_h * (0 - height_px) / 100
    height_px

fn resolve_vertical_margin_px(margin_px: i32, viewport_h: i32) -> i32:
    if margin_px <= -1000:
        return viewport_h * ((0 - margin_px) - 1000) / 100
    if margin_px < 0:
        return 0
    margin_px

fn absolute_child_x(parent_x: i32, parent: Style, child_node: HNode, child: Style, containing_w: i32) -> i32:
    if child.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        return parent_x + parent.border_l + padding_box_w - absolute_outer_width(parent, child_node, child, containing_w) - child.right_px
    parent_x + parent.border_l + child.left_px

fn absolute_child_y(parent_y: i32, parent: Style, child_node: HNode, child: Style, containing_h: i32) -> i32:
    if child.bottom_px >= 0:
        return parent_y + parent.border_t + containing_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px
    parent_y + parent.border_t + child.top_px

fn absolute_child_styles(styles: [Style], child_index: i32, parent: Style, child: Style, containing_w: i32, containing_h: i32) -> [Style]:
    var resolved_child = child
    if child.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val child_width_px = padding_box_w * (0 - child.width_px) / 100
        resolved_child = style_with_width(resolved_child, child_width_px)
    val child_height_px = resolve_percent_height_px(child.height_px, containing_h)
    if child_height_px > 0 and child_height_px != resolved_child.height_px:
        resolved_child = style_with_height(resolved_child, child_height_px)
    if resolved_child.width_px != child.width_px or resolved_child.height_px != child.height_px:
        val style_count = styles.len()
        if style_count == 0:
            return []
        var result: [Style] = [styles[0]; style_count]
        var si = 0
        while si < style_count:
            if si == child_index:
                result[si] = resolved_child
            else:
                result[si] = styles[si]
            si = si + 1
        return result
    styles

fn layout(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32]) -> LayoutResult:
    var out_bx = bx
    var out_by = by
    var out_bw = bw
    var out_bh = bh
    var out_wrap_starts = wrap_starts
    var out_wrap_ends = wrap_ends
    var out_intrinsic_widths = intrinsic_widths
    out_bx[i] = x
    out_by[i] = y
    val st = styles[i]
    val node = nodes[i]
    # Budget guard: short-circuit layout of not-yet-processed subtrees on expiry.
    # Emit a zero-size box for this node and return a valid LayoutResult so the
    # recursion unwinds cleanly while already-computed boxes stay intact.
    if _web_budget_expired():
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if st.display == "none":
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    if st.display == "contents":
        out_bw[i] = w
        var cy_contents = y
        var c_contents = child_index.first_child[i]
        var child_count_contents = 0
        var prev_margin_b_contents = 0
        while c_contents >= 0:
            val cst = styles[c_contents]
            val cml = resolve_horizontal_margin_px(cst.margin_l, w)
            val cmr = resolve_horizontal_margin_px(cst.margin_r, w)
            if child_count_contents > 0:
                cy_contents = cy_contents + st.gap_px
            val cst_margin_t_contents = resolve_vertical_margin_px(cst.margin_t, viewport_h)
            val collapsed_margin_contents = if prev_margin_b_contents > cst_margin_t_contents: prev_margin_b_contents else: cst_margin_t_contents
            cy_contents = cy_contents + collapsed_margin_contents
            var child_w_contents = w - cml - cmr
            if child_w_contents < 1:
                child_w_contents = 1
            val child = layout(nodes, styles, child_index, c_contents, x + cml, cy_contents, child_w_contents, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths)
            out_bx = child.bx
            out_by = child.by
            out_bw = child.bw
            out_bh = child.bh
            out_wrap_starts = child.wrap_starts
            out_wrap_ends = child.wrap_ends
            out_intrinsic_widths = child.intrinsic_widths
            cy_contents = cy_contents + child.height
            prev_margin_b_contents = resolve_vertical_margin_px(cst.margin_b, viewport_h)
            child_count_contents = child_count_contents + 1
            c_contents = child_index.next_sibling[c_contents]
        if child_count_contents > 0:
            cy_contents = cy_contents + prev_margin_b_contents
        val h_contents = cy_contents - y
        out_bh[i] = h_contents
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h_contents)
    val border_x = st.border_l + st.border_r
    val border_y = st.border_t + st.border_b
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    # width_px > 0: explicit px. width_px < 0: percentage of available width
    # (negative sentinel from apply_decls). width_px == 0: fill available width.
    var node_w = if st.width_px > 0: explicit_node_w else: w
    if st.flex_basis_px > 0 and w > 0:
        node_w = w
    if st.width_px < 0:
        node_w = css_outer_width(nodes[i], st, w * (0 - st.width_px) / 100)
        if node_w < 1:
            node_w = 1
    out_bw[i] = node_w
    if node.tag != "#text" and st.width_px == 0 and st.white_space_nowrap:
        val nowrap_intrinsic = intrinsic_text_width(nodes, styles, child_index, i, out_intrinsic_widths)
        out_intrinsic_widths = nowrap_intrinsic.widths
        if nowrap_intrinsic.width > node_w:
            node_w = nowrap_intrinsic.width
    node_w = constrained_outer_width(node, st, node_w)
    out_bw[i] = node_w
    if node.tag == "iframe":
        # Replaced element (like img): fixed box from CSS width/height, else the
        # width/height HTML attributes, else the browser default 300x150. The
        # subtree is never laid out (returns without recursing into children).
        if st.width_px == 0:
            val attr_w = parse_int(attr_value(node.attrs_raw, "width"))
            var iframe_w = if attr_w > 0: attr_w else: 300
            iframe_w = constrained_outer_width(node, st, iframe_w)
            out_bw[i] = iframe_w
        val explicit_iframe_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        var iframe_h = explicit_iframe_h
        if st.height_px == 0:
            val attr_h = parse_int(attr_value(node.attrs_raw, "height"))
            iframe_h = if attr_h > 0: attr_h else: 150
        iframe_h = constrained_outer_height(node, st, iframe_h)
        out_bh[i] = iframe_h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, iframe_h)
    if node.tag == "#text":
        # white-space:pre/nowrap (st.white_space_nowrap, inherited from e.g. a
        # <pre> code block) preserves the raw text incl. leading indentation;
        # normal flow uses the trimmed text. Measure and paint must agree on which.
        val txt: text = if st.white_space_nowrap: node.text_data else: node.text_trimmed
        val txt_len = if st.white_space_nowrap: node.text_data.len() else: node.text_trimmed.len()
        val cw = style_char_w(st)
        var cpl = node_w / cw
        if cpl < 1:
            cpl = 1
        # If the whole run fits the box at its real advance width, keep it on
        # one line. An inline #text box is sized by advance width (5px/char at
        # scale 1) while cpl divides by cell width (6px/char), so without this
        # check a run that exactly fits its box spuriously wraps at ~5/6 of its
        # length ("Simple Editor" -> "Simple"/"Editor", "EDITOR" -> "EDITO"/"R").
        val full_adv = style_text_line_advance_width(txt, 0, txt_len, st, style_text_advance(st), style_space_advance(st))
        if st.white_space_nowrap:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        elif full_adv <= node_w:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        else:
            val ranges = compute_style_wrap_ranges(txt, node_w, st, cpl)
            out_wrap_starts[i] = ranges.starts
            out_wrap_ends[i] = ranges.ends
        val lines = out_wrap_starts[i].len()
        val h = lines * style_line_h(st)
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if node.tag == "img" or node.tag == "input":
        val explicit_node_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        val h = constrained_outer_height(node, st, if st.height_px > 0: explicit_node_h else: style_line_h(st))
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if st.content_visibility_hidden:
        var hidden_h = st.pad_t + st.pad_b + border_y
        if st.height_px > 0:
            hidden_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        if st.min_height_px > 0:
            val min_hidden_h = css_outer_height(node, st, st.min_height_px)
            if min_hidden_h > hidden_h:
                hidden_h = min_hidden_h
        if hidden_h < 1:
            hidden_h = 1
        out_bh[i] = hidden_h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, hidden_h)
    val ix = x + st.border_l + st.pad_l
    var iw = node_w - st.pad_l - st.pad_r - border_x
    if iw < 1:
        iw = 1
    val scrollbar_gutter = 15
    val content_height_limit = definite_content_height_limit(node, st)
    if st.display == "flex" and st.flex_direction != "column":
        val children_for_i_count = child_index.child_count[i]
        if st.flex_wrap != "nowrap":
            val row_wrap_column_gap = st.column_gap_px
            val row_wrap_row_gap = st.row_gap_px
            var line_heights: [i32] = [0; children_for_i_count]
            var line_count = 0
            var total_line_h = 0
            var cx_measure = 0
            var line_h_measure = 0
            var child_count_measure = 0
            var fm = child_index.first_child[i]
            while fm >= 0:
                val cst = styles[fm]
                if not cst.position_absolute:
                    val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
                    val resolved_cst = if child_height_px > 0 and child_height_px != cst.height_px:
                        style_with_height(cst, child_height_px)
                    else:
                        cst
                    val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                    val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
                    val base_w_wrap = if cst.flex_basis_px > 0: cst.flex_basis_px else: if cst.width_px > 0: if nodes[fm].has_widget_class or nodes[fm].has_icon_image_class or cst.border_box: cst.width_px else: cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r else: if cst.width_px < 0: iw else: iw
                    val item_outer_w = cml + base_w_wrap + cmr
                    if child_count_measure > 0 and cx_measure + row_wrap_column_gap + item_outer_w > iw:
                        line_heights[line_count] = line_h_measure
                        line_count = line_count + 1
                        total_line_h = total_line_h + line_h_measure
                        cx_measure = 0
                        line_h_measure = 0
                        child_count_measure = 0
                    if child_count_measure > 0:
                        cx_measure = cx_measure + row_wrap_column_gap
                    cx_measure = cx_measure + item_outer_w
                    val used_h = resolved_cst.margin_t + flex_item_outer_height(nodes[fm], resolved_cst) + resolved_cst.margin_b
                    if used_h > line_h_measure:
                        line_h_measure = used_h
                    child_count_measure = child_count_measure + 1
                fm = child_index.next_sibling[fm]
            if child_count_measure > 0:
                line_heights[line_count] = line_h_measure
                line_count = line_count + 1
                total_line_h = total_line_h + line_h_measure
            if line_count > 1:
                total_line_h = total_line_h + row_wrap_row_gap * (line_count - 1)
            val explicit_content_h = if st.height_px > 0:
                if legacy_widget_box or st.border_box: st.height_px - st.pad_t - st.pad_b - border_y else: st.height_px
            else:
                0
            var align_content_offset = 0
            var align_content_gap_extra = 0
            var align_content_line_extra = 0
            var total_line_h_with_align = total_line_h
            if (st.align_content == "center" or st.align_content == "safe-center" or st.align_content == "unsafe-center") and explicit_content_h > total_line_h:
                align_content_offset = (explicit_content_h - total_line_h) / 2
            elif (st.align_content == "flex-end" or st.align_content == "end") and explicit_content_h > total_line_h:
                align_content_offset = explicit_content_h - total_line_h
            elif st.align_content == "space-between" and explicit_content_h > total_line_h and line_count > 1:
                align_content_gap_extra = (explicit_content_h - total_line_h) / (line_count - 1)
            elif st.align_content == "space-around" and explicit_content_h > total_line_h and line_count > 0:
                align_content_offset = (explicit_content_h - total_line_h) / (line_count * 2)
                align_content_gap_extra = (explicit_content_h - total_line_h) / line_count
            elif st.align_content == "space-evenly" and explicit_content_h > total_line_h and line_count > 0:
                align_content_offset = (explicit_content_h - total_line_h) / (line_count + 1)
                align_content_gap_extra = (explicit_content_h - total_line_h) / (line_count + 1)
            elif (st.align_content == "stretch" or st.align_content == "normal") and explicit_content_h > total_line_h and line_count > 0:
                align_content_line_extra = (explicit_content_h - total_line_h) / line_count
                total_line_h_with_align = total_line_h + align_content_line_extra * line_count
            val reverse_wrap = st.flex_wrap == "wrap-reverse"
            var cx_wrap = ix
            var cy_wrap = if reverse_wrap:
                y + st.border_t + st.pad_t + align_content_offset + total_line_h_with_align - (if line_count > 0: line_heights[0] + align_content_line_extra else: 0)
            else:
                y + st.border_t + st.pad_t + align_content_offset
            var line_h_wrap = 0
            var line_index_wrap = 0
            var fc_wrap = child_index.first_child[i]
            var flex_child_count_wrap = 0
            while fc_wrap >= 0:
                val cst = styles[fc_wrap]
                if cst.position_absolute:
                    val absolute_containing_h = content_height_limit + st.pad_t + st.pad_b
                    val ax = absolute_child_x(x, st, nodes[fc_wrap], cst, iw)
                    val ay = absolute_child_y(y, st, nodes[fc_wrap], cst, absolute_containing_h)
                    val absolute_w = absolute_outer_width(st, nodes[fc_wrap], cst, iw)
                    val child_styles = absolute_child_styles(styles, fc_wrap, st, cst, iw, absolute_containing_h)
                    val child = layout(nodes, child_styles, child_index, fc_wrap, ax, ay, absolute_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths)
                    out_bx = child.bx
                    out_by = child.by
                    out_bw = child.bw
                    out_bh = child.bh
                    out_wrap_starts = child.wrap_starts
                    out_wrap_ends = child.wrap_ends
                    out_intrinsic_widths = child.intrinsic_widths
                else:
                    val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
                    val child_styles = if child_height_px > 0 and child_height_px != cst.height_px:
                        styles_with_height(styles, fc_wrap, child_height_px)
                    else:
                        styles
                    val resolved_cst = child_styles[fc_wrap]
                    val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                    val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
                    val base_w_wrap = if cst.flex_basis_px > 0: cst.flex_basis_px else: if cst.width_px > 0: if nodes[fc_wrap].has_widget_class or nodes[fc_wrap].has_icon_image_class or cst.border_box: cst.width_px else: cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r else: if cst.width_px < 0: iw else: iw
                    val item_outer_w = cml + base_w_wrap + cmr
                    if flex_child_count_wrap > 0 and cx_wrap - ix + st.gap_px + item_outer_w > iw:
                        cx_wrap = ix
                        if reverse_wrap:
                            cy_wrap = cy_wrap - ((if line_index_wrap + 1 < line_count: line_heights[line_index_wrap + 1] + align_content_line_extra else: 0) + row_wrap_row_gap + align_content_gap_extra)
                        else:
                            cy_wrap = cy_wrap + line_h_wrap + row_wrap_row_gap + align_content_gap_extra
                        line_index_wrap = line_index_wrap + 1
                        line_h_wrap = if line_index_wrap < line_count: line_heights[line_index_wrap] + align_content_line_extra else: 0
                        flex_child_count_wrap = 0
                    if flex_child_count_wrap == 0 and line_index_wrap < line_count:
                        line_h_wrap = line_heights[line_index_wrap] + align_content_line_extra
                    if flex_child_count_wrap > 0:
                        cx_wrap = cx_wrap + row_wrap_column_gap
                    cx_wrap = cx_wrap + cml
                    var remaining_w = base_w_wrap
                    if remaining_w < 1:
                        remaining_w = 1
                    val child = layout(nodes, child_styles, child_index, fc_wrap, cx_wrap, cy_wrap + resolved_cst.margin_t, remaining_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths)
                    out_bx = child.bx
                    out_by = child.by
                    out_bw = child.bw
                    out_bh = child.bh
                    out_wrap_starts = child.wrap_starts
                    out_wrap_ends = child.wrap_ends
                    out_intrinsic_widths = child.intrinsic_widths
                    cx_wrap = cx_wrap + out_bw[fc_wrap] + cmr
                    flex_child_count_wrap = flex_child_count_wrap + 1
                fc_wrap = child_index.next_sibling[fc_wrap]
            var flex_h_wrap = if st.height_px > 0:
                if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
            else:
                total_line_h + st.pad_t + st.pad_b + border_y
            if flex_h_wrap < 1:
                flex_h_wrap = 1
            out_bh[i] = flex_h_wrap
            return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, flex_h_wrap)
        # Pre-pass: distribute the inner width across flex children. Children with an
        # explicit width (px or %) take it; the leftover space is shared by flex-grow
        # weight using left-to-right cumulative rounding so integer remainders stay
        # stable against Chromium for small fixtures.
        val ordered_flex_children = flex_ordered_children(styles, child_index, i)
        val ordered_flex_child_count = ordered_flex_children.len()
        var sum_explicit = 0
        var auto_weight = 0
        var auto_main_margin_count = 0
        var shrink_scaled_total = 0
        var nonabs_count = 0
        var ps_i = 0
        while ps_i < ordered_flex_child_count:
            val ps = ordered_flex_children[ps_i]
            val pcst = styles[ps]
            if not pcst.position_absolute:
                val pml = resolve_horizontal_margin_px(pcst.margin_l, iw)
                val pmr = resolve_horizontal_margin_px(pcst.margin_r, iw)
                nonabs_count = nonabs_count + 1
                var base_w = 0
                if pcst.flex_basis_px > 0:
                    base_w = pcst.flex_basis_px
                elif pcst.width_px > 0:
                    base_w = if nodes[ps].has_widget_class or nodes[ps].has_icon_image_class or pcst.border_box: pcst.width_px else: pcst.width_px + pcst.pad_l + pcst.pad_r + pcst.border_l + pcst.border_r
                elif pcst.width_px < 0:
                    base_w = iw * (0 - pcst.width_px) / 100
                if base_w > 0:
                    sum_explicit = sum_explicit + base_w
                    val shrink_factor = if pcst.flex_shrink > 0: pcst.flex_shrink else: 0
                    shrink_scaled_total = shrink_scaled_total + (shrink_factor * base_w)
                else:
                    val intrinsic = intrinsic_text_width(nodes, styles, child_index, ps, out_intrinsic_widths)
                    out_intrinsic_widths = intrinsic.widths
