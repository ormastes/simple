wAgg, text_list_prefix, split_top_level_commas, parse_float_to_255, shadow_layer_alpha, shadow_length_prefix, paren_matching_close, BgLayers, parse_background_layers, parse_box_shadow_agg, CssDeclarationPrioritySplit, css_important_marker_start, css_declaration_priority_split, ComputedStyleHot, computed_style_hot_from, simple_web_style_hot_is_display_none, css_math_fn_name, css_math_args, css_math_primary, css_math_implied_max_px, css_math_implied_min_px, WEB_STYLE_CASCADE_MEMO_LIMIT, web_style_cascade_memo_reset, web_style_cascade_memo_hits, web_style_cascade_memo_misses, web_style_cascade_memo_lookup, web_style_cascade_memo_store, CSS_INTEGER_PX_INVALID, CSS_INTEGER_PX_ABS_MAX, CssCornerRadii, WebBoxShadowLayer, WebBoxShadowParseResult, parse_border_radius_shorthand, resolve_authored_border_radii, parse_box_shadow_layers, CSS_PROP_UNKNOWN, CSS_PROP_BOX_SIZING, CSS_PROP_COLOR, CSS_PROP_WIDTH, CSS_PROP_HEIGHT, CSS_PROP_MIN_HEIGHT, CSS_PROP_MARGIN_LEFT, CSS_PROP_Z_INDEX, CSS_PROP_DISPLAY, CSS_PROP_GRID_TEMPLATE_COLUMNS, CSS_PROP_GRID_TEMPLATE_ROWS, CSS_PROP_GRID_COLUMN, CSS_PROP_GRID_ROW, CSS_PROP_BORDER_COLLAPSE, CSS_PROP_JUSTIFY_CONTENT, CSS_PROP_ALIGN_ITEMS, CSS_PROP_GAP, CSS_PROP_FLEX_BASIS, CSS_PROP_TEXT_ALIGN, CSS_PROP_FONT_STYLE, CSS_PROP_CURSOR, CSS_PROP_OUTLINE, CSS_PROP_OVERFLOW, CSS_PROP_BOX_SHADOW, CSS_PROP_PADDING, CSS_PROP_MARGIN, CSS_PROP_BORDER_RADIUS, CSS_PROP_RADIUS_TL, CSS_PROP_RADIUS_TR, CSS_PROP_RADIUS_BR, CSS_PROP_RADIUS_BL, CSS_PROP_RADIUS_SS, CSS_PROP_RADIUS_SE, CSS_PROP_RADIUS_ES, CSS_PROP_RADIUS_EE, css_prop_id, css_prop_mask, css_prop_mask_has, css_prop_mask_has_radius_family, css_probe_reset, css_probe_note, css_probe_count}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core_selectors.{_compound_base_tokens, _nth_of_offset, _comb_code_of_part, PSEUDO_NTH_LAST_CHILD, _parse_attr_test, _first_top_level_colon}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{hnode_attr_bloom_bit, hnode_hot_bit_for_name}

# Selector rule indexing and cascade ordering, split out of
# simple_web_html_layout_renderer_core_selectors.spl to keep each parser input
# below 128 KiB: rule admission (unknown pseudo names), rule buckets and
# candidate lookup, specificity, and the stable cascade/z-order sorts.

# Pseudo-class names Chrome 159 accepts in a style rule (each checked with a
# Chrome 159 `<style>` probe, 2026-11-17). One unknown pseudo-class drops the
# whole rule (Selectors 4 section 3.1: an invalid selector in a list
# invalidates the list), unlike a known-but-unsatisfied one (`a, b:hover`).
# Legacy single-colon pseudo-elements are listed too. The @page-only names
# `:first`, `:left`, `:right` and `:blank` are rejected by Chrome here.
# Only the seven `-webkit-` names below are accepted (`:-webkit-frob`,
# `:-webkit-hover` are dropped); every `-internal-` name is still accepted.
val CSS_KNOWN_PSEUDO_CLASSES: [text] = [
    "-webkit-any", "-webkit-any-link", "-webkit-autofill", "-webkit-drag",
    "-webkit-full-page-media", "-webkit-full-screen",
    "-webkit-full-screen-ancestor",
    "horizontal", "vertical", "decrement", "increment", "start", "end",
    "double-button", "single-button", "no-button", "corner-present",
    "window-inactive",
    "active", "active-view-transition", "any-link", "autofill", "buffering",
    "checked", "current", "default", "defined", "dir", "disabled", "empty",
    "enabled", "first-child", "first-of-type", "focus", "focus-visible",
    "focus-within", "fullscreen", "future", "has", "host", "host-context",
    "hover", "in-range", "indeterminate", "invalid", "is", "lang", "last-child",
    "last-of-type", "link", "modal", "muted", "not", "nth-child",
    "nth-last-child", "nth-last-of-type", "nth-of-type", "only-child",
    "only-of-type", "open", "optional", "out-of-range", "past", "paused",
    "picture-in-picture", "placeholder-shown", "playing", "popover-open",
    "read-only", "read-write", "required", "root", "scope", "seeking",
    "stalled", "state", "target", "user-invalid", "user-valid", "valid",
    "visited", "volume-locked", "where", "xr-overlay",
    "before", "after", "first-line", "first-letter"
]

# `::` pseudo-element names Chrome 159 accepts (same probe). Chrome accepts
# every `::-webkit-` name.
val CSS_KNOWN_PSEUDO_ELEMENTS: [text] = [
    "after", "backdrop", "before", "checkmark", "column", "cue", "cue-region",
    "details-content", "file-selector-button", "first-letter", "first-line",
    "grammar-error", "highlight", "marker", "part", "picker", "picker-icon",
    "placeholder", "scroll-button", "scroll-marker", "scroll-marker-group",
    "search-text", "selection", "slotted", "spelling-error", "target-text",
    "view-transition", "view-transition-group", "view-transition-image-pair",
    "view-transition-new", "view-transition-old"
]

fn _css_name_in(names: [text], n: text) -> bool:
    var i = 0
    while i < names.len():  # cpu-lane-loop-ok: fixed ~70-name table, once per pseudo name at rule parse
        if names[i] == n:
            return true
        i = i + 1
    false

fn _css_pseudo_class_known(name: text) -> bool:
    val n = name.lower()
    if n.starts_with("-internal-"):
        return true
    _css_name_in(CSS_KNOWN_PSEUDO_CLASSES, n)

val CSS_USER_ACTION_PSEUDO_CLASSES: [text] = [
    "hover", "active", "focus", "focus-visible", "focus-within"
]

val CSS_SCROLLBAR_PSEUDO_CLASSES: [text] = [
    "hover", "active", "enabled", "disabled", "window-inactive",
    "horizontal", "vertical", "decrement", "increment", "start", "end",
    "double-button", "single-button", "no-button", "corner-present"
]

# Known pseudo-classes Chrome 159 still rejects after ::part(),
# ::details-content and ::picker(): tree-structural ones, :has/:host/:scope
# and the scrollbar-only states.
val CSS_NOT_AFTER_ELEMENT_BACKED: [text] = [
    "first-child", "last-child", "only-child", "nth-child", "nth-last-child",
    "first-of-type", "last-of-type", "only-of-type", "nth-of-type",
    "nth-last-of-type", "empty", "root", "has", "host", "host-context", "scope",
    "horizontal", "vertical", "decrement", "increment", "start", "end",
    "double-button", "single-button", "no-button", "corner-present"
]

# May pseudo-class `n` follow pseudo-element `element` (both lower case;
# a functional `::cue(...)` is "cue()")? Chrome 159 `<style>` probes,
# 2026-11-17: `::part(x):hover`, `::selection:window-inactive`,
# `::-webkit-scrollbar:hover` and `::file-selector-button:focus` are
# accepted; `::before:hover`, `::placeholder:hover`, `::selection:hover`,
# `::-webkit-scrollbar:focus` and `::part(x):first-child` are dropped.
# `:is()`/`:where()` follow any pseudo-element; `:not()` is accepted here
# and its argument is checked against the same element by the caller.
fn _css_pseudo_class_allowed_after(element: text, n: text) -> bool:
    if n == "is" or n == "where" or n == "not":
        return true
    if element == "part" or element == "details-content" or element == "picker":
        return _css_pseudo_class_known(n) and not _css_name_in(CSS_NOT_AFTER_ELEMENT_BACKED, n)
    if element.starts_with("-webkit-scrollbar") or element == "-webkit-resizer":
        return _css_name_in(CSS_SCROLLBAR_PSEUDO_CLASSES, n)
    val user_action = _css_name_in(CSS_USER_ACTION_PSEUDO_CLASSES, n)
    if element.starts_with("-webkit-") or element == "file-selector-button" or element == "cue":
        return user_action
    if element == "scroll-button":
        return user_action or n == "enabled" or n == "disabled"
    if element == "scroll-marker":
        return user_action or n == "target-current" or n == "target-before" or n == "target-after"
    if element == "selection":
        return n == "window-inactive"
    if element == "search-text":
        return n == "current"
    if element.starts_with("view-transition-"):
        return n == "only-child"
    false

fn _css_pseudo_element_known(name: text) -> bool:
    val n = name.lower()
    if n.starts_with("-webkit-"):
        return true
    _css_name_in(CSS_KNOWN_PSEUDO_ELEMENTS, n)

# Index of the `)` closing the `(` at `open`, before `end`; -1 when unclosed.
fn _selector_paren_close(sel: text, open: i32, end: i32) -> i32:
    var depth = 0
    var quote = ""
    var i = open
    while i < end:  # cpu-lane-loop-ok: one functional argument of ONE rule's selector at parse time
        val ch = sel.substring(i, i + 1)
        if quote != "":
            if ch == "\\":
                i = i + 1
            elif ch == quote:
                quote = ""
        elif ch == "\\":
            i = i + 1
        elif ch == "\"" or ch == "'":
            quote = ch
        elif ch == "(":
            depth = depth + 1
        elif ch == ")":
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    0 - 1

# Does sel[start, end) name an unknown pseudo-class or pseudo-element, or
# use one where Chrome 159 rejects it? The arguments of `:not()`, `:has()`
# and the `of S` of `:nth-child()` / `:nth-last-child()` are checked too
# (they are not forgiving); `:is()` and `:where()` are forgiving in Chrome,
# so their arguments are not. `no_elements`: a pseudo-element here is
# invalid (`:not(::before)`, `:has(::before)`; `:nth-child(1 of ::before)`
# is accepted). `element` names the pseudo-element the range follows ("" for
# none): only the pseudo-classes `_css_pseudo_class_allowed_after` lists may
# follow one, and no class, id or attribute (`::before.a`). `of S` on
# `:nth-of-type()` / `:nth-last-of-type()` is invalid.
fn _selector_range_has_unknown_pseudo(sel: text, start: i32, end: i32, element_in: text, no_elements: bool) -> bool:
    var quote = ""
    var bracket = 0
    var element = element_in
    var i = start
    while i < end:  # cpu-lane-loop-ok: one pass over ONE rule's selector text at parse time
        val ch = sel.substring(i, i + 1)
        if quote != "":
            if ch == "\\":
                i = i + 1
            elif ch == quote:
                quote = ""
        elif ch == "\\":
            i = i + 1
        elif ch == "\"" or ch == "'":
            quote = ch
        elif bracket == 0 and element != "" and ".#[".contains(ch):
            return true
        elif ch == "[":
            bracket = bracket + 1
        elif ch == "]":
            if bracket > 0:
                bracket = bracket - 1
        elif bracket == 0 and " ,>+~\t\n".contains(ch):
            element = ""
        elif bracket == 0 and ch == "(":
            val skip = _selector_paren_close(sel, i, end)
            if skip < 0:
                return false
            i = skip
        elif bracket == 0 and ch == ":":
            val is_element = i + 1 < end and sel.substring(i + 1, i + 2) == ":"
            val name_start = if is_element: i + 2 else: i + 1
            var e = name_start
            while e < end and not "():.#[ ,>+~".contains(sel.substring(e, e + 1)):  # cpu-lane-loop-ok: scans ONE pseudo name
                if sel.substring(e, e + 1) == "\\":
                    e = e + 1
                e = e + 1
            val name = sel.substring(name_start, e)
            val lname = name.lower()
            val has_args = e < end and sel.substring(e, e + 1) == "("
            val legacy = not is_element and element == "" and (lname == "before" or lname == "after" or lname == "first-line" or lname == "first-letter")
            if is_element or legacy:
                if no_elements or not _css_pseudo_element_known(name):
                    return true
                element = if lname == "cue" and has_args: "cue()" else: lname
            elif element != "":
                if not _css_pseudo_class_allowed_after(element, lname):
                    return true
            elif not _css_pseudo_class_known(name):
                return true
            i = e - 1
            if has_args:
                val close = _selector_paren_close(sel, e, end)
                if close < 0:
                    return false
                val arg = sel.substring(e + 1, close)
                if is_element:
                    i = close
                elif lname == "not" or lname == "has":
                    val inner = if lname == "not": element else: ""
                    if _selector_range_has_unknown_pseudo(sel, e + 1, close, inner, true):
                        return true
                elif lname == "nth-child" or lname == "nth-last-child":
                    val of_at = _nth_of_offset(PSEUDO_NTH_CHILD, arg)
                    if of_at >= 0 and _selector_range_has_unknown_pseudo(sel, e + 1 + of_at + 4, close, "", false):
                        return true
                elif (lname == "nth-of-type" or lname == "nth-last-of-type") and _nth_of_offset(PSEUDO_NTH_CHILD, arg) >= 0:
                    return true
                i = close
        i = i + 1
    false

# True when a rule's selector list names a pseudo-class or `::` pseudo-element
# Chrome 159 does not know, so the whole rule must be dropped.
# reason: CSS rule admission is a yes/no fact about one selector text.
# @allow(primitive_api)
fn selector_list_has_unknown_pseudo(sel: text) -> bool:
    _selector_range_has_unknown_pseudo(sel, 0, sel.byte_len(), "", false)

fn selector_rightmost_part(parts: [text]) -> text:
    var right = parts.len() - 1
    while right >= 0:  # cpu-lane-loop-ok: scans ONE selector group's parts from the right for the rightmost non-empty, non-`>` part; bound is that group's part count (<=256)
        val part = parts[right]
        if part.len() > 0 and _comb_code_of_part(part) < 0:
            return part
        right = right - 1
    ""

# A selector group whose rightmost compound ends in `::before` / `::after`
# (or legacy `:before` / `:after`) targets the GENERATED box, not the element.
# It is rewritten to `<origin compound> > ::before`: the generated node (tag
# "::before", parent = its originating element, see
# _html_append_generated_content) then matches through the ordinary
# child-combinator path, and the rule buckets under the "::before" tag so no
# parsed element ever sees it. Any other group is returned unchanged.
fn selector_group_generated_parts(parts: [text]) -> [text]:
    var right = parts.len() - 1
    while right >= 0 and (parts[right].len() == 0 or _comb_code_of_part(parts[right]) >= 0):  # cpu-lane-loop-ok: skips trailing combinator tokens of ONE selector group; bound is its part count
        right = right - 1
    if right < 0 or text_index_of(parts[right], ":") < 0:
        return parts
    val part = parts[right]
    val lower = part.lower()
    var kind = ""
    var cut = 0
    if lower.ends_with("::before"):
        kind = "::before"
        cut = part.byte_len() - 8
    elif lower.ends_with("::after"):
        kind = "::after"
        cut = part.byte_len() - 7
    elif lower.ends_with(":before"):
        kind = "::before"
        cut = part.byte_len() - 7
    elif lower.ends_with(":after"):
        kind = "::after"
        cut = part.byte_len() - 6
    if kind == "":
        return parts
    var origin = part.substring(0, cut)
    if origin == "":
        origin = "*"
    var out: [text] = []
    var k = 0
    while k < right:  # cpu-lane-loop-ok: copies the parts left of the rightmost compound of ONE selector group; bound is its part count
        out.push(parts[k])
        k = k + 1
    out.push(origin)
    out.push(">")
    out.push(kind)
    out

fn selector_bucket_base(part: text) -> text:
    var base = part
    val colon = _first_top_level_colon(base)
    if colon >= 0:
        base = base.substring(0, colon)
    val attr_start = text_index_of(base, "[")
    if attr_start >= 0:
        base = base.substring(0, attr_start).trim()
    base

fn selector_bucket_kind(part: text) -> text:
    val base = selector_bucket_base(part)
    selector_bucket_kind_from_base(base)

fn selector_bucket_kind_from_base(base: text) -> text:
    if base.len() == 0 or base == "*":
        return "fallback"
    # Any compound with an id buckets as "id", else on its first class.
    val toks = _compound_base_tokens(base)
    if toks[1] != "":
        return "id"
    if toks.len() > 3:
        return "class"
    if toks[0] == "":
        return "fallback"
    "tag"

fn selector_bucket_value(part: text) -> text:
    val base = selector_bucket_base(part)
    selector_bucket_value_from_base(base)

fn selector_bucket_value_from_base(base: text) -> text:
    if base.len() == 0:
        return ""
    # Same split as selector_bucket_kind_from_base: id, else first class, else tag.
    val toks = _compound_base_tokens(base)
    if toks[1] != "":
        return toks[2]
    if toks.len() > 3:
        return toks[3]
    base

fn text_key_index_count(keys: [text], key: text, key_count: i32) -> i32:
    var i = 0
    while i < key_count:  # cpu-lane-loop-ok: linear key scan reached only as the documented fallback when the O(1) key Dict is unavailable -- dict_key_index_count tries `d.has(key)` first, so the hosted lane never walks this
        if keys[i] == key:
            return i
        i = i + 1
    -1


fn i32_list_prefix(values: [i32], count: i32) -> [i32]:
    var out: [i32] = [0; count]
    var i = 0
    while i < count:  # cpu-lane-loop-ok: prefix copy of an i32 array; bound is the requested count
        out[i] = values[i]
        i = i + 1
    out

fn text_seen_before(values: [text], end_index: i32, value: text) -> bool:
    var i = 0
    while i < end_index:  # cpu-lane-loop-ok: dedupe probe over ONE node's already-visited class words; bound is that node's class index i, single digits in practice
        if values[i] == value:
            return true
        i = i + 1
    false

fn merge_two_sorted_rule_lists_unique(left: [i32], right: [i32]) -> [i32]:
    val left_count = left.len()
    val right_count = right.len()
    if left_count == 0:
        return right
    if right_count == 0:
        return left
    var li = 0
    var ri = 0
    var out_count = 0
    var last = -1
    var has_last = false
    while li < left_count or ri < right_count:  # cpu-lane-loop-ok: count pass of the 2-way sorted-rule-list merge (O(left+right)), sizing the output before allocation
        var next = 0
        if ri >= right_count or (li < left_count and left[li] <= right[ri]):
            next = left[li]
            li = li + 1
        else:
            next = right[ri]
            ri = ri + 1
        if not has_last or next != last:
            out_count = out_count + 1
            last = next
            has_last = true
    var out: [i32] = [0; out_count]
    li = 0
    ri = 0
    var oi = 0
    last = -1
    has_last = false
    while li < left_count or ri < right_count:  # cpu-lane-loop-ok: emit pass of the same 2-way sorted-rule-list merge, writing the deduped union
        var next = 0
        if ri >= right_count or (li < left_count and left[li] <= right[ri]):
            next = left[li]
            li = li + 1
        else:
            next = right[ri]
            ri = ri + 1
        if not has_last or next != last:
            out[oi] = next
            oi = oi + 1
            last = next
            has_last = true
    out

fn merge_sorted_rule_lists_unique_count(lists: [[i32]], list_count: i32) -> [i32]:
    if list_count == 0:
        return []
    if list_count == 1:
        return lists[0]
    if list_count == 2:
        return merge_two_sorted_rule_lists_unique(lists[0], lists[1])
    var positions: [i32] = [0; list_count]
    var out_count = 0
    var last = -1
    var has_last = false
    var done = false
    while not done:  # cpu-lane-loop-ok: outer count pass of the k-way sorted-rule-list merge: one iteration per distinct output rule id
        var min_rule = 2147483647
        var found = false
        var list_i = 0
        while list_i < list_count:  # cpu-lane-loop-ok: inner min-scan arm of the k-way merge count pass over the k candidate lists (k = this node's class count + 3)
            val rules = lists[list_i]
            val rule_count = rules.len()
            var pos = positions[list_i]
            while pos < rule_count and has_last and rules[pos] == last:  # cpu-lane-loop-ok: duplicate-skip arm of the count pass: advances past repeats of the last emitted rule id inside one already-sorted bucket list
                pos = pos + 1
            positions[list_i] = pos
            if pos < rule_count and rules[pos] < min_rule:
                min_rule = rules[pos]
                found = true
            list_i = list_i + 1
        if found:
            out_count = out_count + 1
            last = min_rule
            has_last = true
        else:
            done = true
    positions = [0; list_count]
    var out: [i32] = [0; out_count]
    var out_i = 0
    last = -1
    has_last = false
    done = false
    while not done:  # cpu-lane-loop-ok: outer emit pass of the k-way sorted-rule-list merge: one iteration per distinct output rule id
        var min_rule = 2147483647
        var found = false
        var list_i = 0
        while list_i < list_count:  # cpu-lane-loop-ok: inner min-scan arm of the k-way merge emit pass over the k candidate lists (k = this node's class count + 3)
            val rules = lists[list_i]
            val rule_count = rules.len()
            var pos = positions[list_i]
            while pos < rule_count and has_last and rules[pos] == last:  # cpu-lane-loop-ok: duplicate-skip arm of the emit pass: advances past repeats of the last emitted rule id inside one already-sorted bucket list
                pos = pos + 1
            positions[list_i] = pos
            if pos < rule_count and rules[pos] < min_rule:
                min_rule = rules[pos]
                found = true
            list_i = list_i + 1
        if found:
            out[out_i] = min_rule
            out_i = out_i + 1
            last = min_rule
            has_last = true
        else:
            done = true
    out

fn rule_lists_from_counts(counts: [i32]) -> [[i32]]:
    val count_len = counts.len()
    var lists: [[i32]] = [[]; count_len]
    var i = 0
    while i < count_len:  # cpu-lane-loop-ok: allocates one exactly-sized rule bucket per distinct selector key; bound is the distinct-key count
        lists[i] = [0; counts[i]]
        i = i + 1
    lists

fn dict_key_index_count(d: Dict<text, i32>, keys: [text], key: text, count: i32) -> i32:
    if d.has(key):
        return d[key]
    # ponytail: linear fallback keeps Simple-core correct until its Dict ABI is available; hosted runtimes stay O(1).
    text_key_index_count(keys, key, count)

fn _selector_first_attr_key(right: text) -> text:
    val n = right.byte_len()
    var i = 0
    var quote = ""
    while i < n:
        val ch = right.substring(i, i + 1)
        if quote != "":
            if ch == "\\" and i + 1 < n:
                i = i + 2
                continue
            if ch == quote:
                quote = ""
            i = i + 1
            continue
        if ch == "\"" or ch == "'":
            quote = ch
            i = i + 1
            continue
        if ch == ":":
            return ""
        if ch == "[":
            var j = i + 1
            var inner_q = ""
            while j < n:
                val c2 = right.substring(j, j + 1)
                if inner_q != "":
                    if c2 == "\\" and j + 1 < n:
                        j = j + 2
                        continue
                    if c2 == inner_q:
                        inner_q = ""
                else:
                    if c2 == "\"" or c2 == "'":
                        inner_q = c2
                    elif c2 == "]":
                        val parsed = _parse_attr_test(right.substring(i + 1, j))
                        return parsed.name.trim().lower()
                j = j + 1
            return ""
        i = i + 1
    ""

fn _dict_key_index_i64(d: Dict<text, i64>, keys: [text], key: text, count: i32) -> i32:
    if d.has(key):
        return d[key] as i32
    text_key_index_count(keys, key, count)

fn _i64_rule_lists_from_counts(counts: [i32]) -> [[i64]]:
    var out: [[i64]] = []
    var i = 0
    while i < counts.len():
        out.push([0 as i64; counts[i]])
        i = i + 1
    out

fn build_rule_buckets(rules: Rules, trace_stages: bool = false) -> RuleBuckets:
    var bucket_capacity = 0
    var cr = 0
    val rule_count = rules.group_parts.len()
    if trace_stages:
        print "[layout-trace] bucket_stage=count-start rules={rule_count}"
    while cr < rule_count:  # cpu-lane-loop-ok: capacity-count pass over the extracted rules to size the bucket arrays; bound is the rule count, once per style invalidation
        bucket_capacity = bucket_capacity + rules.group_parts[cr].len()
        cr = cr + 1
    if trace_stages:
        print "[layout-trace] bucket_stage=count-ready capacity={bucket_capacity}"
    var id_keys_raw: [text] = [""; bucket_capacity]
    var id_counts_raw: [i32] = [0; bucket_capacity]
    var id_key_count = 0
    var class_keys_raw: [text] = [""; bucket_capacity]
    var class_counts_raw: [i32] = [0; bucket_capacity]
    var class_key_count = 0
    var tag_keys_raw: [text] = [""; bucket_capacity]
    var tag_counts_raw: [i32] = [0; bucket_capacity]
    var tag_key_count = 0
    var attr_keys_raw: [text] = [""; bucket_capacity]
    var attr_counts_raw: [i32] = [0; bucket_capacity]
    var attr_key_count = 0
    var entry_kinds: [i32] = [0; bucket_capacity]
    var entry_buckets: [i32] = [0; bucket_capacity]
    var entry_rules: [i32] = [0; bucket_capacity]
    var entry_count = 0
    var fallback_count = 0
    var id_key_dict: Dict<text, i32> = {}
    var class_key_dict: Dict<text, i32> = {}
    var tag_key_dict: Dict<text, i32> = {}
    var attr_key_dict: Dict<text, i64> = {}
    if trace_stages:
        print "[layout-trace] bucket_stage=storage-ready"
    var r = 0
    while r < rule_count:  # cpu-lane-loop-ok: bucket-build pass over the extracted rules; bound is the rule count, once per style invalidation
        val groups = rules.group_parts[r]
        var g = 0
        val group_count = groups.len()
        if trace_stages:
            print "[layout-trace] bucket_stage=rule-start rule={r} groups={group_count}"
        while g < group_count:  # cpu-lane-loop-ok: walks the selector comma-groups of ONE rule (<=CSS_SELECTOR_GROUP_CAP), assigning each to its id/class/tag/attr bucket
            val right = selector_rightmost_part(selector_group_generated_parts(groups[g]))
            val generated = right == "::before" or right == "::after"
            val base = if generated: right else: selector_bucket_base(right)
            val kind = if generated: "tag" else: selector_bucket_kind_from_base(base)
            val key = if generated: right else: selector_bucket_value_from_base(base)
            if kind == "id" and key.len() > 0:
                var idx = dict_key_index_count(id_key_dict, id_keys_raw, key, id_key_count)
                if idx < 0:
                    idx = id_key_count
                    id_keys_raw[idx] = key
                    id_key_count = id_key_count + 1
                    id_key_dict[key] = idx
                id_counts_raw[idx] = id_counts_raw[idx] + 1
                entry_kinds[entry_count] = 1
                entry_buckets[entry_count] = idx
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
            elif kind == "class" and key.len() > 0:
                var idx = dict_key_index_count(class_key_dict, class_keys_raw, key, class_key_count)
                if idx < 0:
                    idx = class_key_count
                    class_keys_raw[idx] = key
                    class_key_count = class_key_count + 1
                    class_key_dict[key] = idx
                class_counts_raw[idx] = class_counts_raw[idx] + 1
                entry_kinds[entry_count] = 2
                entry_buckets[entry_count] = idx
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
            elif kind == "tag" and key.len() > 0:
                var idx = dict_key_index_count(tag_key_dict, tag_keys_raw, key, tag_key_count)
                if idx < 0:
                    idx = tag_key_count
                    tag_keys_raw[idx] = key
                    tag_key_count = tag_key_count + 1
                    tag_key_dict[key] = idx
                tag_counts_raw[idx] = tag_counts_raw[idx] + 1
                entry_kinds[entry_count] = 3
                entry_buckets[entry_count] = idx
                entry_rules[entry_count] = r
                entry_count = entry_count + 1
            else:
                val akey = _selector_first_attr_key(right)
                if akey.len() > 0:
                    var idx = _dict_key_index_i64(attr_key_dict, attr_keys_raw, akey, attr_key_count)
                    if idx < 0:
                        idx = attr_key_count
                        attr_keys_raw[idx] = akey
                        attr_key_count = attr_key_count + 1
                        attr_key_dict[akey] = idx as i64
                    attr_counts_raw[idx] = attr_counts_raw[idx] + 1
                    entry_kinds[entry_count] = 5
                    entry_buckets[entry_count] = idx
                    entry_rules[entry_count] = r
                    entry_count = entry_count + 1
                else:
                    entry_kinds[entry_count] = 4
                    entry_buckets[entry_count] = fallback_count
                    entry_rules[entry_count] = r
                    entry_count = entry_count + 1
                    fallback_count = fallback_count + 1
            g = g + 1
        r = r + 1
    val id_keys = text_list_prefix(id_keys_raw, id_key_count)
    val id_counts = i32_list_prefix(id_counts_raw, id_key_count)
    val class_keys = text_list_prefix(class_keys_raw, class_key_count)
    val class_counts = i32_list_prefix(class_counts_raw, class_key_count)
    val tag_keys = text_list_prefix(tag_keys_raw, tag_key_count)
    val tag_counts = i32_list_prefix(tag_counts_raw, tag_key_count)
    val attr_keys = text_list_prefix(attr_keys_raw, attr_key_count)
    val attr_counts = i32_list_prefix(attr_counts_raw, attr_key_count)
    var id_rules = rule_lists_from_counts(id_counts)
    var id_positions: [i32] = [0; id_counts.len()]
    var class_rules = rule_lists_from_counts(class_counts)
    var class_positions: [i32] = [0; class_counts.len()]
    var tag_rules = rule_lists_from_counts(tag_counts)
    var tag_positions: [i32] = [0; tag_counts.len()]
    var attr_rules = _i64_rule_lists_from_counts(attr_counts)
    var attr_positions: [i32] = [0; attr_counts.len()]
    var fallback_rules: [i32] = [0; fallback_count]
    var entry_i = 0
    while entry_i < entry_count:  # cpu-lane-loop-ok: fill pass scattering each recorded bucket entry into its preallocated bucket slot; bound is the entry count
        val entry_kind = entry_kinds[entry_i]
        val bucket_idx = entry_buckets[entry_i]
        val rule_idx = entry_rules[entry_i]
        if entry_kind == 1:
            var bucket = id_rules[bucket_idx]
            bucket[id_positions[bucket_idx]] = rule_idx
            id_rules[bucket_idx] = bucket
            id_positions[bucket_idx] = id_positions[bucket_idx] + 1
        elif entry_kind == 2:
            var bucket = class_rules[bucket_idx]
            bucket[class_positions[bucket_idx]] = rule_idx
            class_rules[bucket_idx] = bucket
            class_positions[bucket_idx] = class_positions[bucket_idx] + 1
        elif entry_kind == 3:
            var bucket = tag_rules[bucket_idx]
            bucket[tag_positions[bucket_idx]] = rule_idx
            tag_rules[bucket_idx] = bucket
            tag_positions[bucket_idx] = tag_positions[bucket_idx] + 1
        elif entry_kind == 5:
            var bucket = attr_rules[bucket_idx]
            bucket[attr_positions[bucket_idx]] = rule_idx as i64
            attr_rules[bucket_idx] = bucket
            attr_positions[bucket_idx] = attr_positions[bucket_idx] + 1
        else:
            fallback_rules[bucket_idx] = rule_idx
        entry_i = entry_i + 1
    # Pre-parse every selector part ONCE, here, so the per-node match path
    # never re-scans selector text. Uses the SAME splitting helpers the text
    # matcher uses; see parse_selector_part().
    var parsed_groups: [[[ParsedSel]]] = []
    var pr = 0
    while pr < rule_count:  # cpu-lane-loop-ok: pre-parses the selector parts of every extracted rule; bound is the rule count, once per style invalidation
        val pgroups = rules.group_parts[pr]
        var parsed_rule: [[ParsedSel]] = []
        var pg = 0
        val pgroup_count = pgroups.len()
        while pg < pgroup_count:  # cpu-lane-loop-ok: pre-parses the comma-groups of ONE rule (<=CSS_SELECTOR_GROUP_CAP)
            parsed_rule.push(parse_selector_group(selector_group_generated_parts(pgroups[pg])))
            pg = pg + 1
        parsed_groups.push(parsed_rule)
        pr = pr + 1
    if trace_stages:
        print "[layout-trace] bucket_stage=selectors-parsed rules={parsed_groups.len()}"
    RuleBuckets(
        id_keys: id_keys, id_rules: id_rules,
        class_keys: class_keys, class_rules: class_rules,
        tag_keys: tag_keys, tag_rules: tag_rules,
        attr_keys: attr_keys, attr_rules: attr_rules,
        fallback_rules: fallback_rules,
        id_key_dict: id_key_dict, class_key_dict: class_key_dict,
        tag_key_dict: tag_key_dict, attr_key_dict: attr_key_dict,
        parsed_groups: parsed_groups
    )

fn dict_key_index(d: Dict<text, i32>, keys: [text], key: text) -> i32:
    dict_key_index_count(d, keys, key, keys.len() as i32)

fn _i64_rule_list_to_i32(xs: [i64]) -> [i32]:
    var out: [i32] = [0; xs.len()]
    var i = 0
    while i < xs.len():
        out[i] = xs[i] as i32
        i = i + 1
    out

fn style_rule_candidates(node: HNode, buckets: RuleBuckets) -> [i32]:
    val class_count = node.class_words.len()
    val attr_bucket_count = buckets.attr_keys.len()
    val has_attr_buckets = node.attr_mask != 0u32 and attr_bucket_count > 0
    if class_count == 0 and node.id_attr.len() == 0 and not has_attr_buckets:
        val tag_idx = dict_key_index(buckets.tag_key_dict, buckets.tag_keys, node.tag)
        # A generated box is matched only by its own `::before`/`::after`
        # rules: `*` and the other fallback rules select elements, never
        # pseudo-elements (`* {margin:0}` leaves `::before` alone).
        if node.tag == "::before" or node.tag == "::after":
            return if tag_idx < 0: [] else: buckets.tag_rules[tag_idx]
        if tag_idx < 0:
            return buckets.fallback_rules
        return merge_two_sorted_rule_lists_unique(buckets.fallback_rules, buckets.tag_rules[tag_idx])
    var lists: [[i32]] = [[]; class_count + 3 + attr_bucket_count]
    var list_count = 0
    lists[list_count] = buckets.fallback_rules
    list_count = list_count + 1
    if node.id_attr.len() > 0:
        val id_idx = dict_key_index(buckets.id_key_dict, buckets.id_keys, node.id_attr)
        if id_idx >= 0:
            lists[list_count] = buckets.id_rules[id_idx]
            list_count = list_count + 1
    val tag_idx = dict_key_index(buckets.tag_key_dict, buckets.tag_keys, node.tag)
    if tag_idx >= 0:
        lists[list_count] = buckets.tag_rules[tag_idx]
        list_count = list_count + 1
    var i = 0
    while i < class_count:  # cpu-lane-loop-ok: walks ONE node's class words to collect that node's class buckets; bound is that node's class count
        val cls = node.class_words[i]
        if cls.len() > 0:
            if class_count <= 1 or not text_seen_before(node.class_words, i, cls):
                val class_idx = dict_key_index(buckets.class_key_dict, buckets.class_keys, cls)
                if class_idx >= 0:
                    lists[list_count] = buckets.class_rules[class_idx]
                    list_count = list_count + 1
        i = i + 1
    if has_attr_buckets:
        var ai = 0
        while ai < attr_bucket_count:  # cpu-lane-loop-ok: checks attribute rule buckets against HNode.attr_mask Bloom + hot presence bits
            val akey = buckets.attr_keys[ai]
            if (node.attr_mask & hnode_attr_bloom_bit(akey)) != 0u32:
                val hot = hnode_hot_bit_for_name(akey)
                if hot == 0u32 or (node.attr_mask & hot) != 0u32:
                    lists[list_count] = _i64_rule_list_to_i32(buckets.attr_rules[ai])
                    list_count = list_count + 1
            ai = ai + 1
    merge_sorted_rule_lists_unique_count(lists, list_count)

# ---------------------------------------------------------------------------
# CSS specificity helpers
# ---------------------------------------------------------------------------

fn _part_specificity(
    part: text, recursion_depth: i32 = 0
) -> i32:
    if recursion_depth > 32:
        return -1000000
    # The generated-box subject of selector_group_generated_parts: a
    # pseudo-element counts like a type selector (Selectors 4 17).
    if part == "::before" or part == "::after":
        return 1
    var base = part
    val colon = _first_top_level_colon(base)
    var pseudo_specificity = 0
    if colon >= 0:
        base = base.substring(0, colon)
        var pseudo_pos = colon
        var pseudo_count = 0
        val part_blen = part.byte_len()
        while pseudo_pos < part_blen:  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector part while scoring specificity; pseudo_count capped at 32
            pseudo_count = pseudo_count + 1
            if pseudo_count > 32 or part.substring(pseudo_pos, pseudo_pos + 1) != ":":
                return -1000000
            val name_start = pseudo_pos + 1
            var name_end = name_start
            # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
            while (
                name_end < part_blen and
                part.substring(name_end, name_end + 1) != ":" and
                part.substring(name_end, name_end + 1) != "(" and
                part.substring(name_end, name_end + 1) != "["
            ):
                name_end = name_end + 1
            val pseudo_name = part.substring(name_start, name_end)
            if pseudo_name.len() == 0:
                return -1000000
            if name_end < part_blen and part.substring(name_end, name_end + 1) == "(":
                var functional_depth = 1
                var close = name_end + 1
                while close < part_blen and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo-class argument while scoring specificity; paren depth capped at 32
                    val ch = part.substring(close, close + 1)
                    if ch == "(":
                        functional_depth = functional_depth + 1
                        if functional_depth > 32:
                            return -1000000
                    elif ch == ")":
                        functional_depth = functional_depth - 1
                    close = close + 1
                if functional_depth != 0:
                    return -1000000
                val inner = part.substring(name_end + 1, close - 1)
                if (
                    pseudo_name == "is" or pseudo_name == "not" or
                    pseudo_name == "has"
                ):
                    val options = split_selector_groups(inner)
                    if options.len() == 0:
                        return -1000000
                    var max_option_specificity = 0
                    for option in options:  # cpu-lane-loop-ok: walks the parsed :is()/:not()/:has() options taking the max option specificity; bound is CSS_SELECTOR_GROUP_CAP (16) options
                        val option_specificity = _group_specificity(
                            selector_group_parts(option),
                            recursion_depth + 1
                        )
                        if option_specificity < 0:
                            return -1000000
                        if option_specificity > max_option_specificity:
                            max_option_specificity = option_specificity
                    pseudo_specificity = (
                        pseudo_specificity + max_option_specificity
                    )
                elif (
                    pseudo_name == "nth-child" or pseudo_name == "nth-last-child" or
                    pseudo_name == "nth-of-type" or pseudo_name == "nth-last-of-type"
                ):
                    pseudo_specificity = pseudo_specificity + 10
                    # `An+B of S` adds the most specific selector of S.
                    val of_code = if pseudo_name == "nth-child": PSEUDO_NTH_CHILD elif pseudo_name == "nth-last-child": PSEUDO_NTH_LAST_CHILD else: 0 - 1
                    val of_at = _nth_of_offset(of_code, inner.trim())
                    if of_at >= 0:
                        val of_inner = inner.trim()
                        var max_of_specificity = 0
                        for of_option in split_selector_groups(of_inner.substring(of_at + 4, of_inner.byte_len())):  # cpu-lane-loop-ok: walks the selector list of ONE `of S` argument once per rule
                            val of_specificity = _group_specificity(
                                selector_group_parts(of_option),
                                recursion_depth + 1
                            )
                            if of_specificity > max_of_specificity:
                                max_of_specificity = of_specificity
                        pseudo_specificity = pseudo_specificity + max_of_specificity
                elif pseudo_name != "where":
                    return -1000000
                pseudo_pos = close
            else:
                pseudo_specificity = pseudo_specificity + 10
                pseudo_pos = name_end
                if (
                    pseudo_name == "root" and pseudo_pos < part_blen and
                    part.substring(pseudo_pos, pseudo_pos + 1) == "["
                ):
                    val attr_close = find_from(
                        part, "]", pseudo_pos + 1
                    )
                    if attr_close < 0:
                        return -1000000
                    pseudo_specificity = pseudo_specificity + 10
                    pseudo_pos = attr_close + 1
    var attribute_specificity = 0
    var attribute_scan = 0
    while attribute_scan < base.byte_len():  # cpu-lane-loop-ok: counts the `[attr]` selectors in ONE selector base via native find_from; bound is that base's length
        val attribute_open = find_from(base, "[", attribute_scan)
        if attribute_open < 0:
            break
        attribute_specificity = attribute_specificity + 10
        val attribute_close = find_from(base, "]", attribute_open + 1)
        if attribute_close < 0:
            break
        attribute_scan = attribute_close + 1
    val attr_bracket = text_index_of(base, "[")
    if attr_bracket >= 0:
        base = base.substring(0, attr_bracket).trim()
    var base_specificity = attribute_specificity
    if base.len() > 0 and base != "*":
        # (id, class, type) = 100, 10, 1 per part, in any order.
        val toks = _compound_base_tokens(base)
        val id_spec = if toks[1] != "": 100 else: 0
        val tag_spec = if toks[0] != "": 1 else: 0
        base_specificity = id_spec + ((toks.len() - 3) as i32) * 10 + tag_spec + attribute_specificity
    base_specificity + pseudo_specificity

fn _group_specificity(
    parts: [text], recursion_depth: i32 = 0
) -> i32:
    if recursion_depth > 32:
        return -1000000
    var total = 0
    var i = 0
    val subject_parts = selector_group_generated_parts(parts)
    val part_count = subject_parts.len()
    while i < part_count:  # cpu-lane-loop-ok: sums per-part specificity over ONE selector group's parts; bound is that group's part count. Computed once at extract time and cached in Rules.group_specificities, never recomputed per node
        val p = subject_parts[i]
        if p.len() > 0 and _comb_code_of_part(p) < 0:
            val part_specificity = _part_specificity(
                p, recursion_depth
            )
            if part_specificity < 0:
                return -1000000
            total = total + part_specificity
        i = i + 1
    total

fn _candidate_sort_before(left: i32, right: i32, rule_specificities: [i32]) -> bool:
    val left_spec = rule_specificities[left]
    val right_spec = rule_specificities[right]
    if left_spec < right_spec:
        return true
    if left_spec > right_spec:
        return false
    left <= right

fn _sort_candidates_by_specificity(candidates: [i32], rule_specificities: [i32]) -> [i32]:
    val n = candidates.len()
    if n <= 1:
        return candidates
    var src: [i32] = [0; n]
    var dest: [i32] = [0; n]
    var i = 0
    while i < n:  # cpu-lane-loop-ok: copy-in arm of the bottom-up merge sort of ONE node's candidate rule ids; bound is that node's candidate count; runs once per style invalidation
        src[i] = candidates[i]
        i = i + 1
    var width = 1
    while width < n:  # cpu-lane-loop-ok: width-doubling arm (log n iterations) of the candidate-specificity merge sort
        var start = 0
        while start < n:  # cpu-lane-loop-ok: run-start arm of the candidate-specificity merge sort: one iteration per run pair at the current width
            var mid = start + width
            if mid > n:
                mid = n
            var endv = start + width + width
            if endv > n:
                endv = n
            var left_i = start
            var right_i = mid
            var out_i = start
            while left_i < mid and right_i < endv:  # cpu-lane-loop-ok: merge arm of the candidate-specificity merge sort: emits the smaller head while both runs still have elements
                if _candidate_sort_before(src[left_i], src[right_i], rule_specificities):
                    dest[out_i] = src[left_i]
                    left_i = left_i + 1
                else:
                    dest[out_i] = src[right_i]
                    right_i = right_i + 1
                out_i = out_i + 1
            while left_i < mid:  # cpu-lane-loop-ok: left-drain arm of the candidate-specificity merge sort
                dest[out_i] = src[left_i]
                left_i = left_i + 1
                out_i = out_i + 1
            while right_i < endv:  # cpu-lane-loop-ok: right-drain arm of the candidate-specificity merge sort
                dest[out_i] = src[right_i]
                right_i = right_i + 1
                out_i = out_i + 1
            start = start + width + width
        i = 0
        while i < n:  # cpu-lane-loop-ok: copy-back arm of the candidate-specificity merge sort, returning dest to src for the next width
            src[i] = dest[i]
            i = i + 1
        width = width + width
    src

# Strict z-index order. The merge takes the right head only when it is
# strictly before the left one, so equal z keeps the input order: the callers
# pass tree order, which is not index order once generated `::before` /
# `::after` nodes are appended after the parsed arena.
fn _z_index_sort_before(left: i32, right: i32, styles: [Style]) -> bool:
    styles[left].z_index < styles[right].z_index

fn _sort_positive_z_indices(indices: [i32], count: i32, styles: [Style]) -> [i32]:
    if count <= 0:
        return []
    var src: [i32] = [0; count]
    var dest: [i32] = [0; count]
    var i = 0
    while i < count:  # cpu-lane-loop-ok: copy-in arm of the bottom-up merge sort of one stacking context's positive z-index children; bound is that context's positive-z child count
        src[i] = indices[i]
        i = i + 1
    var width = 1
    while width < count:  # cpu-lane-loop-ok: width-doubling arm (log n iterations) of the positive z-index merge sort
        var start = 0
        while start < count:  # cpu-lane-loop-ok: run-start arm of the positive z-index merge sort: one iteration per run pair at the current width
            var mid = start + width
            if mid > count:
                mid = count
            var endv = start + width + width
            if endv > count:
                endv = count
            var left_i = start
            var right_i = mid
            var out_i = start
            while left_i < mid and right_i < endv:  # cpu-lane-loop-ok: merge arm of the positive z-index merge sort: emits the smaller head while both runs still have elements
                if _z_index_sort_before(src[right_i], src[left_i], styles):
                    dest[out_i] = src[right_i]
                    right_i = right_i + 1
                else:
                    dest[out_i] = src[left_i]
                    left_i = left_i + 1
                out_i = out_i + 1
            while left_i < mid:  # cpu-lane-loop-ok: left-drain arm of the positive z-index merge sort
                dest[out_i] = src[left_i]
                left_i = left_i + 1
                out_i = out_i + 1
            while right_i < endv:  # cpu-lane-loop-ok: right-drain arm of the positive z-index merge sort
                dest[out_i] = src[right_i]
                right_i = right_i + 1
                out_i = out_i + 1
            start = start + width + width
        i = 0
        while i < count:  # cpu-lane-loop-ok: copy-back arm of the positive z-index merge sort, returning dest to src for the next width
            src[i] = dest[i]
            i = i + 1
        width = width + width
    src

fn _style_order_sort_before(left: i32, right: i32, styles: [Style]) -> bool:
    val left_order = styles[left].order
    val right_order = styles[right].order
    if left_order < right_order:
        return true
    if left_order > right_order:
        return false
    left <= right

fn _sort_style_order_indices(indices: [i32], count: i32, styles: [Style]) -> [i32]:
    if count <= 0:
        return []
    var src: [i32] = [0; count]
    var dest: [i32] = [0; count]
    var i = 0
    while i < count:  # cpu-lane-loop-ok: copy-in arm of the bottom-up merge sort of one flex container's children by CSS `order`; bound is that container's child count
        src[i] = indices[i]
        i = i + 1
    var width = 1
    while width < count:  # cpu-lane-loop-ok: width-doubling arm (log n iterations) of the flex `order` merge sort
        var start = 0
        while start < count:  # cpu-lane-loop-ok: run-start arm of the flex `order` merge sort: one iteration per run pair at the current width
            var mid = start + width
            if mid > count:
                mid = count
            var endv = start + width + width
            if endv > count:
                endv = count
            var left_i = start
            var right_i = mid
            var out_i = start
            while left_i < mid and right_i < endv:  # cpu-lane-loop-ok: merge arm of the flex `order` merge sort: emits the smaller head while both runs still have elements
                if _style_order_sort_before(src[left_i], src[right_i], styles):
                    dest[out_i] = src[left_i]
                    left_i = left_i + 1
                else:
                    dest[out_i] = src[right_i]
                    right_i = right_i + 1
                out_i = out_i + 1
            while left_i < mid:  # cpu-lane-loop-ok: left-drain arm of the flex `order` merge sort
                dest[out_i] = src[left_i]
                left_i = left_i + 1
                out_i = out_i + 1
            while right_i < endv:  # cpu-lane-loop-ok: right-drain arm of the flex `order` merge sort
                dest[out_i] = src[right_i]
                right_i = right_i + 1
                out_i = out_i + 1
            start = start + width + width
        i = 0
        while i < count:  # cpu-lane-loop-ok: copy-back arm of the flex `order` merge sort, returning dest to src for the next width
            src[i] = dest[i]
            i = i + 1
        width = width + width
    src

# ---------------------------------------------------------------------------
# Presentational attributes (bgcolor/width/height/align -> CSS declarations)
# ---------------------------------------------------------------------------
# Map legacy HTML presentational attributes (bgcolor/width/height/align) to CSS
# declarations. Applied with lowest priority: after tag defaults but before
# matched CSS rules and inline style.
