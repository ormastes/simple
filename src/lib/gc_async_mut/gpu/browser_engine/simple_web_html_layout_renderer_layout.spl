                    cx_wrap = cx_wrap + effective_cml
                    var remaining_w = base_w_wrap
                    if remaining_w < 1:
                        remaining_w = 1
                    val child = layout_with_style(nodes, styles, child_index, fc_wrap, cx_wrap, cy_wrap + resolved_cst.margin_t, remaining_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
                    out_bx = child.bx
                    out_by = child.by
                    out_bw = child.bw
                    out_bh = child.bh
                    out_wrap_starts = child.wrap_starts
                    out_wrap_ends = child.wrap_ends
                    out_intrinsic_widths = child.intrinsic_widths
