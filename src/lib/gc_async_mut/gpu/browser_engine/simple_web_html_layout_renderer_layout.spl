fn style_with_width(st: Style, width_px: i32) -> Style:
    val out = style_with_width_without_height_metadata(st, width_px)
    out.height_auto = st.height_auto
    out.align_items_authored = st.align_items_authored
    out.scrollbar_width_none = st.scrollbar_width_none
    out

fn intrinsic_text_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, widths: [i32]) -> IntrinsicWidthResult:
    if widths[i] >= 0:
        return IntrinsicWidthResult(width: widths[i], widths: widths)
    var out_widths = widths
    var width = 0
    var c = child_index.first_child[i]
    while c >= 0:
        if nodes[c].tag == "#text":
            val txt: text = nodes[c].text_trimmed
            if txt.len() > 0:
                val resolved = styles[c].resolved_font_width
                if resolved > 0:
                    width = width + resolved
                else:
                    val glyph_w = style_char_w(styles[c])
                    val ink_w = if glyph_w > 1: glyph_w - 1 else: glyph_w
                    # CELL width, not byte length: a CJK glyph is drawn double
                    # width and is charged exactly two cells, and a combining
                    # mark is charged none.
                    width = width + (text_cell_width(txt) as i32) * ink_w
        elif (
            styles[c].display == "inline" or
            styles[c].display == "inline-block"
        ):
            val child = intrinsic_text_width(nodes, styles, child_index, c, out_widths)
            out_widths = child.widths
            width = width + child.width
        c = child_index.next_sibling[c]
    if nodes[i].tag != "#text":
        width = width + styles[i].pad_l + styles[i].pad_r + styles[i].border_l + styles[i].border_r
    out_widths[i] = width
    IntrinsicWidthResult(width: width, widths: out_widths)

fn inline_text_advance_width(node: HNode, st: Style) -> i32:
    if node.tag != "#text":
        return 0
    val raw = node.text_data
    val cps = text_codepoints(raw)
    # `resolved_font_advances` carries ONE advance per codepoint (see
    # font_renderer.measure_text_advances), so the arity check is against the
    # codepoint count. Comparing it against `raw.len()` matched only by
    # accident on ASCII and matched a byte-per-byte advance array on non-ASCII.
    if st.resolved_font_width > 0 and st.resolved_font_advances.len() == cps.len():
        return st.resolved_font_width
    if raw == " " and node.text_trimmed == "":
        var whitespace_advance = style_space_advance(st) / 3
        if whitespace_advance < 1:
            whitespace_advance = 1
        return whitespace_advance
    var width = 0
    var i = 0
    val n = cps.len()
    val advance = style_text_advance(st)
    val space_advance = style_space_advance(st)
    while i < n:
        val ch = cps[i]
        if ch == 32:
            width = width + space_advance
        elif ch == 9 or ch == 10 or ch == 13:
            if node.text_trimmed != "":
                width = width + space_advance
        else:
            width = width + (codepoint_cells(ch) as i32) * advance
        i = i + 1
    width

fn text_ink_y_offset(fs: i32) -> i32:
    val scale = glyph_scale(fs)
    if scale > 1:
        return scale + 1
    1

fn text_ink_x_offset(fs: i32) -> i32:
    1

fn wrap_line_end(txt: text, off: i32, cpl: i32) -> i32:
    val n = txt.len()
    var limit = off + cpl
    if limit >= n:
        return n
    var last_space = -1
    var i = off
    while i < limit:
        if txt.char_code_at(i) == 32:
            last_space = i
        i = i + 1
    if last_space > off:
        return last_space
    limit

# `skip_wrap_spaces` now lives in ..._foundation.spl (reached here through the
# export chain). It was defined HERE but also called from ..._style.spl, which
# sits BELOW this module in the import order and therefore cannot see it. The
# interpreter's flat function registry resolved that anyway; HIR lowering did
# not, so the whole renderer module failed JIT compilation with
# "Unknown variable: skip_wrap_spaces while lowering parse_font_shorthand_family"
# and silently ran interpreted (~1000x slower).

fn text_line_advance_width(txt: text, start: i32, endv: i32, advance: i32, space_advance: i32) -> i32:
    var width = 0
    var i = start
    while i < endv:
        width = width + if txt.char_code_at(i) == 32: space_advance else: advance
        i = i + 1
    width

fn style_text_line_advance_width(txt: text, start: i32, endv: i32, st: Style, advance: i32, space_advance: i32) -> i32:
    val resolved = resolved_text_range_width(st, start, endv)
    if resolved >= 0:
        return resolved
    text_line_advance_width(txt, start, endv, advance, space_advance)

fn text_line_aligned_x(base_x: i32, line_box_w: i32, line_w: i32, st: Style, line_i: i32, line_count: i32) -> i32:
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "start":
        align = if st.direction_rtl: "right" else: "left"
    elif align == "end":
        align = if st.direction_rtl: "left" else: "right"
    if align == "center":
        return base_x + (line_box_w - line_w) / 2
    if align == "right":
        return base_x + line_box_w - line_w
    base_x

fn text_line_needs_paint_width(st: Style, line_i: i32, line_count: i32) -> bool:
    if st.text_decoration_underline:
        return true
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "center" or align == "right":
        return true
    if align == "start":
        return st.direction_rtl
    if align == "end":
        return not st.direction_rtl
    false

fn ellipsize_text_for_width(txt: text, start: i32, endv: i32, max_width: i32, st: Style, advance: i32, space_advance: i32) -> text:
    if max_width <= 0:
        return ""
    val full_width = style_text_line_advance_width(txt, start, endv, st, advance, space_advance)
    if full_width <= max_width:
        return txt.substring(start, endv)
    val ellipsis = "..."
    val ellipsis_w = text_line_advance_width(ellipsis, 0, ellipsis.len(), advance, space_advance)
    if max_width <= ellipsis_w:
        return ellipsis
    val content_limit = max_width - ellipsis_w
    var out = ""
    var used = 0
    var i = start
    while i < endv:
        val resolved_char_w = resolved_text_range_width(st, i, i + 1)
        val char_w = if resolved_char_w >= 0: resolved_char_w elif txt.char_code_at(i) == 32: space_advance else: advance
        if used + char_w > content_limit:
            break
        out = out + txt.char_at(i)
        used = used + char_w
        i = i + 1
    out + ellipsis

# --- Left-float exclusion band (bug browser_engine_float_no_inline_wrap_
# beside_float_2026-08-19). Scope, stated honestly: a SINGLE left float per
# band, default clear only. The band is recorded when a float:left child is
# placed and expires by document y (text laid out below the band bottom is
# unaffected), so it needs no per-frame teardown beyond the root reset in
# layout(). Multiple simultaneous floats, float:right bands, and explicit
# `clear` interaction are not modeled.
var g_float_band_bottom: i32 = -2147483648
var g_float_band_indent: i32 = 0

# Float-band-aware text wrap: lines whose index falls inside the band wrap to
# narrow_w; later lines wrap to full_w. Mirrors compute_style_wrap_ranges'
# font-advance path with a cell-width fallback.
fn compute_style_wrap_ranges_float_band(txt: text, full_w: i32, narrow_w: i32, narrow_lines: i32, st: Style) -> LineWrapRanges:
    val n = txt.len()
    if n == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    val use_font = st.resolved_font_identity != "" and st.resolved_font_advances.len() == n and full_w > 0 and narrow_w > 0
    val cw = style_char_w(st)
    var starts: [i32] = []
    var ends: [i32] = []
    var start = 0
    var line = 0
    while start < n:
        val max_width = if line < narrow_lines: narrow_w else: full_w
        var endv = start
        if use_font:
            var used = 0
            var last_space = -1
            while endv < n and used + st.resolved_font_advances[endv] <= max_width:
                used = used + st.resolved_font_advances[endv]
                if txt.char_code_at(endv) == 32:
                    last_space = endv
                endv = endv + 1
            if endv == start:
                endv = start + 1
            elif endv < n and last_space > start:
                endv = last_space
        else:
            var cpl = max_width / cw
            if cpl < 1:
                cpl = 1
            endv = wrap_line_end(txt, start, cpl)
            if endv <= start:
                endv = start + 1
        starts.push(start)
        ends.push(endv)
        start = skip_wrap_spaces(txt, endv)
        line = line + 1
    if starts.len() == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    LineWrapRanges(starts: starts, ends: ends)

fn compute_wrap_ranges(txt: text, cpl: i32) -> LineWrapRanges:
    val txt_len = txt.len()
    if txt_len == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var line_count = 0
    var count_off = 0
    while count_off < txt_len:
        val endc = wrap_line_end(txt, count_off, cpl)
        line_count = line_count + 1
        count_off = skip_wrap_spaces(txt, endc)
    if line_count <= 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var starts: [i32] = [0; line_count]
    var ends: [i32] = [0; line_count]
    var off = 0
    var line = 0
    while off < txt_len:
        val endc = wrap_line_end(txt, off, cpl)
        starts[line] = off
        ends[line] = endc
        off = skip_wrap_spaces(txt, endc)
        line = line + 1
    LineWrapRanges(starts: starts, ends: ends)

fn compute_style_wrap_ranges(txt: text, max_width: i32, st: Style, fallback_cpl: i32) -> LineWrapRanges:
    if st.resolved_font_identity == "" or st.resolved_font_advances.len() != txt.len() or max_width <= 0:
        return compute_wrap_ranges(txt, fallback_cpl)
    var starts: [i32] = []
    var ends: [i32] = []
    var start = 0
    val n = txt.len()
    while start < n:
        var endv = start
        var used = 0
        var last_space = -1
        while endv < n and used + st.resolved_font_advances[endv] <= max_width:
            used = used + st.resolved_font_advances[endv]
            if txt.char_code_at(endv) == 32:
                last_space = endv
            endv = endv + 1
        if endv == start:
            endv = start + 1
        elif endv < n and last_space > start:
            endv = last_space
        starts.push(start)
        ends.push(endv)
        start = skip_wrap_spaces(txt, endv)
    LineWrapRanges(starts: starts, ends: ends)

fn zero_i32_list(count: i32) -> [i32]:
    [0; count]

fn neg_one_i32_list(count: i32) -> [i32]:
    [-1; count]

fn shifted_i32_list(values: [i32], delta: i32) -> [i32]:
    val count = values.len()
    var shifted: [i32] = [0; count]
    var i = 0
    while i < count:
        shifted[i] = values[i] + delta
        i = i + 1
    shifted

fn empty_i32_lists(count: i32) -> [[i32]]:
    [[]; count]

fn css_outer_width(node: HNode, st: Style, css_width: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_width
    css_width + st.pad_l + st.pad_r + st.border_l + st.border_r

fn css_outer_height(node: HNode, st: Style, css_height: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_height
    css_height + st.pad_t + st.pad_b + st.border_t + st.border_b

fn definite_content_height_limit(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return st.height_px - st.pad_t - st.pad_b - border_y
        return st.height_px
    if st.min_height_px > 0:
        return st.min_height_px
    0

fn constrained_outer_width(node: HNode, st: Style, candidate_width: i32) -> i32:
    var out = candidate_width
    if st.min_width_px > 0:
        val min_outer = css_outer_width(node, st, st.min_width_px)
        if out < min_outer:
            out = min_outer
    if st.max_width_px > 0:
        val max_outer = css_outer_width(node, st, st.max_width_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn explicit_auto_table_column_offsets(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    table: i32, inner_width: i32, spacing_x: i32, spacing_y: i32
) -> [i32]:
    # Keep the legacy zero-spacing admission narrow. Authored spacing also
    # admits constrained and spanning cells after their minimum track widths
    # are resolved here, so gaps never force overlapping boxes.
    val has_authored_spacing = spacing_x > 0 or spacing_y > 0
    val rows = simple_web_collect_table_rows(nodes, child_index, table)
    val column_count = simple_web_fixed_table_column_count(
        nodes, child_index, rows
    )
    var widths: [i32] = [0; column_count]
    for row in rows.rows:
        var column = 0
        var cell = child_index.first_child[row]
        while cell >= 0:
            if styles[cell].display == "table-cell":
                val span = simple_web_fixed_table_cell_span(
                    nodes[cell], column_count
                )
                val cell_style = styles[cell]
                if not has_authored_spacing and (
                    span != 1 or cell_style.width_px <= 0 or
                    cell_style.min_width_px > 0 or
                    cell_style.max_width_px > 0
                ):
                    return []
                if span == 1 and column < column_count:
                    var cell_width = if cell_style.width_px > 0:
                        css_outer_width(
                            nodes[cell], cell_style, cell_style.width_px
                        )
                    else:
                        1
                    # border-collapse: adjacent cell borders are shared, so a
                    # cell's border-box contributes only half of each vertical
                    # border to its column track (uniform-width borders only —
                    # per-edge winner widths stay outside this admission).
                    if styles[table].border_collapse == "collapse" and cell_width > 1:
                        cell_width = cell_width - (
                            (cell_style.border_l + cell_style.border_r) / 2
                        )
                    if cell_style.max_width_px > 0:
                        val max_width = css_outer_width(
                            nodes[cell], cell_style,
                            cell_style.max_width_px
                        )
                        if cell_width > max_width:
                            cell_width = max_width
                    if cell_style.min_width_px > 0:
                        val min_width = css_outer_width(
                            nodes[cell], cell_style,
                            cell_style.min_width_px
                        )
                        if cell_width < min_width:
                            cell_width = min_width
                    if cell_width > widths[column]:
                        widths[column] = cell_width
                column = column + span
            cell = child_index.next_sibling[cell]
    if has_authored_spacing:
        for row in rows.rows:
            var span_column = 0
            var span_cell = child_index.first_child[row]
            while span_cell >= 0:
                if styles[span_cell].display == "table-cell":
                    val span = simple_web_fixed_table_cell_span(
                        nodes[span_cell], column_count
                    )
                    val next_column = if span_column + span < column_count:
                        span_column + span
                    else:
                        column_count
                    if span > 1 and span_column < column_count:
                        val span_style = styles[span_cell]
                        var required_width = if span_style.width_px > 0:
                            css_outer_width(
                                nodes[span_cell], span_style,
                                span_style.width_px
                            )
                        else:
                            0
                        if span_style.min_width_px > 0:
                            val span_min_width = css_outer_width(
                                nodes[span_cell], span_style,
                                span_style.min_width_px
                            )
                            if required_width < span_min_width:
                                required_width = span_min_width
                        var current_width = (
                            spacing_x * (next_column - span_column - 1)
                        )
                        var width_column = span_column
                        while width_column < next_column:
                            current_width = current_width + widths[width_column]
                            width_column = width_column + 1
                        if required_width > current_width:
                            val deficit = required_width - current_width
                            val span_count = next_column - span_column
                            val grow_each = deficit / span_count
                            val grow_remainder = (
                                deficit - grow_each * span_count
                            )
                            var grow_column = span_column
                            while grow_column < next_column:
                                widths[grow_column] = (
                                    widths[grow_column] +
                                    grow_each +
                                    (if (
                                        grow_column - span_column <
                                        grow_remainder
                                    ): 1 else: 0)
                                )
                                grow_column = grow_column + 1
                    span_column = next_column
                span_cell = child_index.next_sibling[span_cell]
    var minimum_width = 0
    for width in widths:
        if width <= 0:
            return []
        minimum_width = minimum_width + width
    var grid_width = inner_width - spacing_x * (column_count + 1)
    if grid_width < minimum_width:
        grid_width = minimum_width
    val extra = grid_width - minimum_width
    val extra_each = extra / column_count
    val extra_remainder = extra - extra_each * column_count
    var offsets: [i32] = [0; column_count + 1]
    var offset_column = 0
    while offset_column < column_count:
        offsets[offset_column + 1] = (
            offsets[offset_column] + widths[offset_column] + extra_each +
            (if offset_column < extra_remainder: 1 else: 0)
        )
        offset_column = offset_column + 1
    offsets

fn constrained_outer_height(node: HNode, st: Style, candidate_height: i32) -> i32:
    var out = candidate_height
    if st.min_height_px > 0:
        val min_outer = css_outer_height(node, st, st.min_height_px)
        if out < min_outer:
            out = min_outer
    if st.max_height_px > 0:
        val max_outer = css_outer_height(node, st, st.max_height_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn absolute_outer_width(parent: Style, node: HNode, st: Style, containing_w: i32) -> i32:
    if st.width_px == 0 and st.left_px > 0 and st.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        var stretched = padding_box_w - st.left_px - st.right_px
        if stretched < 1:
            stretched = 1
        return constrained_outer_width(node, st, stretched)
    if st.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val percent_content_w = padding_box_w * (0 - st.width_px) / 100
        return constrained_outer_width(node, st, css_outer_width(node, st, percent_content_w))
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    if st.width_px > 0:
        return constrained_outer_width(node, st, explicit_node_w)
    constrained_outer_width(node, st, containing_w)

fn absolute_outer_height(node: HNode, st: Style, containing_h: i32) -> i32:
    val border_y = st.border_t + st.border_b
    val resolved_h = resolve_percent_height_px(st.height_px, containing_h)
    if resolved_h > 0:
        if st.border_box:
            return constrained_outer_height(node, st, resolved_h)
        return constrained_outer_height(node, st, resolved_h + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

fn resolve_horizontal_margin_px(margin_px: i32, containing_w: i32) -> i32:
    if margin_px < 0:
        return containing_w * (0 - margin_px) / 100
    margin_px

fn resolve_percent_height_px(height_px: i32, containing_h: i32) -> i32:
    if height_px < 0 and containing_h > 0:
        return containing_h * (0 - height_px) / 100
    height_px

fn resolve_vertical_margin_px(margin_px: i32, viewport_h: i32) -> i32:
    # margin_px <= -1000 is the vh-percentage sentinel (see margin_token_vh_px);
    # anything else, including -999..-1, is a literal (possibly negative) px
    # margin and must pass through unchanged for CSS 2.2 8.3.1 collapsing to
    # see the true sign.
    if margin_px <= -1000:
        return viewport_h * ((0 - margin_px) - 1000) / 100
    margin_px

fn absolute_child_x(parent_x: i32, parent: Style, child_node: HNode, child: Style, containing_w: i32) -> i32:
    if child.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        return parent_x + parent.border_l + padding_box_w - absolute_outer_width(parent, child_node, child, containing_w) - child.right_px
    parent_x + parent.border_l + child.left_px

fn absolute_child_y(parent_y: i32, parent: Style, child_node: HNode, child: Style, containing_h: i32) -> i32:
    if child.bottom_px >= 0:
        return parent_y + parent.border_t + containing_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px
    parent_y + parent.border_t + child.top_px

fn absolute_child_style(parent: Style, child: Style, containing_w: i32, containing_h: i32) -> Style:
    var resolved_child = child
    if child.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val child_width_px = padding_box_w * (0 - child.width_px) / 100
        resolved_child = style_with_width(resolved_child, child_width_px)
    val child_height_px = resolve_percent_height_px(child.height_px, containing_h)
    if child_height_px > 0 and child_height_px != resolved_child.height_px:
        resolved_child = style_with_height(resolved_child, child_height_px)
    resolved_child

# Resolves a normalized track list (space-separated "Npx" / "Nfr" tokens,
# see normalized_grid_track_list in
# simple_web_html_layout_renderer_declarations.spl) into concrete pixel
# sizes. Fixed (px) tracks keep their declared size; the space remaining in
# `available_w` after subtracting fixed track sizes and inter-track gaps is
# distributed across `fr` tracks proportional to their flex factor — CSS
# Grid SS11.5 "Resolving Flexible Track Sizes", simplified: no min-content
# clamping and no `minmax()` support (see
# doc/08_tracking/bug/browser_engine_grid_fr_track_unit_unsupported_2026-08-07.md).
fn grid_track_sizes(raw: text, available_w: i32, gap: i32) -> [i32]:
    var tokens: [text] = []
    var is_fr: [bool] = []
    var fixed_sum = 0
    var fr_total = 0
    for part in raw.split(" "):
        val token = part.trim()
        if token == "":
            continue
        if token.ends_with("fr") and token.len() > 2:
            val factor = parse_int(token)
            if factor <= 0:
                return []
            tokens.push(token)
            is_fr.push(true)
            fr_total = fr_total + factor
        else:
            val size = parse_int(token)
            if size <= 0:
                return []
            tokens.push(token)
            is_fr.push(false)
            fixed_sum = fixed_sum + size
    val track_count = tokens.len() as i32
    if track_count == 0:
        return []
    var free_space = available_w - fixed_sum - gap * (track_count - 1)
    if free_space < 0:
        free_space = 0
    var sizes: [i32] = []
    var idx = 0
    while idx < tokens.len():
        if is_fr[idx]:
            val factor = parse_int(tokens[idx])
            val fr_size = if fr_total > 0: free_space * factor / fr_total else: 0
            sizes.push(fr_size)
        else:
            sizes.push(parse_int(tokens[idx]))
        idx = idx + 1
    sizes

fn grid_placement_start(raw: text) -> i32:
    val value = raw.trim()
    if value == "":
        return -1
    val slash = find_from(value, "/", 0)
    val first = if slash >= 0:
        value.substring(0, slash).trim()
    else:
        value
    val line = parse_int(first)
    if line > 0: line - 1 else: -1

fn grid_placement_span(raw: text) -> i32:
    val value = raw.trim()
    val slash = find_from(value, "/", 0)
    if slash < 0:
        return 1
    val start = parse_int(value.substring(0, slash).trim())
    val tail = value.substring(slash + 1, value.len()).trim()
    if tail.starts_with("span "):
        val span = parse_int(tail.substring(5, tail.len()).trim())
        return if span > 0: span else: 1
    val end_line = parse_int(tail)
    if start > 0 and end_line > start: end_line - start else: 1

fn grid_track_offset(sizes: [i32], gap: i32, track: i32) -> i32:
    var offset = 0
    var index = 0
    while index < track and index < sizes.len():
        offset = offset + sizes[index] + gap
        index = index + 1
    offset

fn grid_track_span_size(
    sizes: [i32], gap: i32, start: i32, span: i32
) -> i32:
    var size = 0
    var index = 0
    while index < span and start + index < sizes.len():
        if index > 0:
            size = size + gap
        size = size + sizes[start + index]
        index = index + 1
    size

# A single `grid-template-areas` named area resolved to its (0-based)
# track range, e.g. "right" in `"left right"` -> row_start:0, col_start:1,
# row_span:1, col_span:1.
class GridAreaRect:
    area: text
    row_start: i32
    col_start: i32
    row_span: i32
    col_span: i32

# Parses a normalized `grid-template-areas` string (rows joined by "|",
# cells within a row space-separated -- see normalized_grid_template_areas
# in simple_web_html_layout_renderer_declarations.spl) into the list of
# named area rectangles it declares. Only rectangular areas are recognized
# (CSS Grid SS7.1 "Named Areas"): a name whose occupied cells don't form a
# solid rectangle is dropped -- silently, per this renderer's existing
# lenient-CSS convention -- and a `grid-area` reference to a dropped name
# falls through to numeric/auto placement. No dot-cell (`.`) handling beyond
# treating it as an empty/unnamed cell, and no implicit-track creation
# beyond what the template's own row/column count implies. See
# doc/08_tracking/bug/browser_engine_grid_template_areas_missing_2026-08.md.
fn grid_template_area_rects(raw: text) -> [GridAreaRect]:
    var result: [GridAreaRect] = []
    if raw == "":
        return result
    val rows = raw.split("|")
    var names: [text] = []
    var min_rows: [i32] = []
    var max_rows: [i32] = []
    var min_cols: [i32] = []
    var max_cols: [i32] = []
    var row_idx = 0
    while row_idx < rows.len():
        val cols = rows[row_idx].split(" ")
        var col_idx = 0
        while col_idx < cols.len():
            val name = cols[col_idx].trim()
            if name != "" and name != ".":
                var found = -1
                var k = 0
                while k < names.len():
                    if names[k] == name:
                        found = k
                    k = k + 1
                if found < 0:
                    names.push(name)
                    min_rows.push(row_idx as i32)
                    max_rows.push(row_idx as i32)
                    min_cols.push(col_idx as i32)
                    max_cols.push(col_idx as i32)
                else:
                    if (row_idx as i32) < min_rows[found]:
                        min_rows[found] = row_idx as i32
                    if (row_idx as i32) > max_rows[found]:
                        max_rows[found] = row_idx as i32
                    if (col_idx as i32) < min_cols[found]:
                        min_cols[found] = col_idx as i32
                    if (col_idx as i32) > max_cols[found]:
                        max_cols[found] = col_idx as i32
            col_idx = col_idx + 1
        row_idx = row_idx + 1
    var i = 0
    while i < names.len():
        var valid = true
        var rr = min_rows[i]
        while rr <= max_rows[i] and valid:
            val cols = rows[rr].split(" ")
            var cc = min_cols[i]
            while cc <= max_cols[i] and valid:
                if (cc as i64) >= cols.len() or cols[cc].trim() != names[i]:
                    valid = false
                cc = cc + 1
            rr = rr + 1
        if valid:
            result.push(GridAreaRect(
                area: names[i], row_start: min_rows[i], col_start: min_cols[i],
                row_span: max_rows[i] - min_rows[i] + 1,
                col_span: max_cols[i] - min_cols[i] + 1
            ))
        i = i + 1
    result

fn layout(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32]) -> LayoutResult:
    # Fresh layout pass: no float band carries over from a previous document.
    g_float_band_bottom = -2147483648
    g_float_band_indent = 0
    layout_with_style(nodes, styles, child_index, i, x, y, w, viewport_h, bx, by, bw, bh, wrap_starts, wrap_ends, intrinsic_widths, styles[i])

# =========================================================================
# `contain: layout` fast path for layout_selected. See containment.spl for
# why this is wired here (array/index-positional) rather than reusing that
# file's Dict-keyed LayoutContainState.
#
# node_contain_layout: reads the node's `contain` attribute the same way
# every other attribute is read in this file (attr_value(node.attrs_raw,
# name), e.g. the "width"/"height" reads a few lines above) and checks the
# "layout" token via containment.spl's shared token matcher.
# =========================================================================

fn node_contain_layout(node: HNode) -> bool:
    contain_value_contains_layout(attr_value(node.attrs_raw, "contain"))

fn nearest_contain_layout_ancestor(nodes: [HNode], idx: i32) -> i32:
    var cur = nodes[idx].parent as i32
    while cur >= 0:
        if node_contain_layout(nodes[cur]):
            return cur
        cur = nodes[cur].parent as i32
    -1

# Nearest `contain: layout` ancestor shared by every selected structural id.
# Returns -1 (no fast path) unless ALL selected ids resolve to the exact
# same boundary node — a conservative but always-correct restriction: a
# mutation batch touching two different contained subtrees, or one that
# isn't contained at all, falls straight through to the full recompute
# below rather than attempting a partial splice.
fn layout_contain_boundary(nodes: [HNode], selected_structural_ids: [i64]) -> i32:
    val node_count = nodes.len() as i32
    var boundary: i32 = -1
    var first = true
    for structural_id in selected_structural_ids:
        val idx = (structural_id - 1) as i32
        if idx < 0 or idx >= node_count:
            return -1
        val b = nearest_contain_layout_ancestor(nodes, idx)
        if b < 0:
            return -1
        if first:
            boundary = b
            first = false
        elif b != boundary:
            return -1
    boundary

# Structural node count of the subtree rooted at `i` (i inclusive). This is
# an upper bound on how many `layout_with_style` calls the fast path below
# performs: every recursive call in `layout_with_style` passes a child index
# drawn from `child_index.first_child`/`next_sibling` of the current node,
# so the recursion can never step outside this subtree. Used as the
# proportionality oracle in the spec (subtree size vs. total node count).
fn subtree_node_count(child_index: HtmlChildIndex, i: i32) -> i32:
    var total = 1
    var child = child_index.first_child[i]
    while child >= 0:
        total = total + subtree_node_count(child_index, child)
        child = child_index.next_sibling[child]
    total

fn layout_contain_boundary_subtree_size(nodes: [HNode], child_index: HtmlChildIndex, selected_structural_ids: [i64]) -> i32:
    """Public probe for the correctness/proportionality spec: the subtree
    size a fast-path recompute is bounded by, or the full node count when no
    `contain: layout` boundary covers the selection (i.e. no savings claimed)."""
    val boundary = layout_contain_boundary(nodes, selected_structural_ids)
    if boundary < 0:
        return nodes.len() as i32
    subtree_node_count(child_index, boundary)

fn layout_selected(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    selected_structural_ids: [i64], width: i32, viewport_h: i32,
    retained: LayoutResult
) -> LayoutSelectedResult:
    if selected_structural_ids.len() == 0:
        return LayoutSelectedResult(layout: retained, fault: "")
    if nodes.len() != styles.len():
        return LayoutSelectedResult(layout: retained, fault: "cpu-layout-style-shape-mismatch")
    for structural_id in selected_structural_ids:
        if structural_id <= 0 or structural_id > nodes.len():
            return LayoutSelectedResult(layout: retained, fault: "cpu-layout-selection-out-of-range")
    val retained_empty = retained.bx.len() == 0
    if not retained_empty and (
        retained.bx.len() != nodes.len() or retained.by.len() != nodes.len() or
        retained.bw.len() != nodes.len() or retained.bh.len() != nodes.len() or
        retained.wrap_starts.len() != nodes.len() or
        retained.wrap_ends.len() != nodes.len() or
        retained.intrinsic_widths.len() != nodes.len()
    ):
        return LayoutSelectedResult(layout: retained, fault: "cpu-layout-retained-shape-mismatch")

    # contain:layout fast path. `contain: layout` promises the boundary
    # node's own box does not depend on how its subtree is laid out, so a
    # mutation confined to that subtree can be relaid-out starting from the
    # boundary, seeded from the previously-RETAINED box arrays everywhere
    # else, instead of recomputing from the document root. Correctness does
    # not rely on trusting the `contain` attribute: the recomputed
    # boundary's own box (bw/bh) is compared against the retained value
    # afterward, and any mismatch (a lying/violating `contain: layout`, or
    # any other reason the boundary's box actually changed) falls through
    # to the unconditional full recompute below, so the fast path can only
    # ever produce output identical to the full recompute, never wrong
    # output.
    if not retained_empty:
        val boundary = layout_contain_boundary(nodes, selected_structural_ids)
        if boundary >= 0:
            val bst = styles[boundary]
            val sub = layout_with_style(
                nodes, styles, child_index, boundary,
                retained.bx[boundary], retained.by[boundary], retained.bw[boundary],
                viewport_h, retained.bx, retained.by, retained.bw, retained.bh,
                retained.wrap_starts, retained.wrap_ends, retained.intrinsic_widths, bst
            )
            if sub.bw[boundary] == retained.bw[boundary] and sub.bh[boundary] == retained.bh[boundary]:
                return LayoutSelectedResult(layout: sub, fault: "")

    val node_count = nodes.len() as i32
    # Canonical recursion remains the one authority. The selected seam controls
    # which island artifacts the execution port returns; recomputing from the
    # document root preserves containing-block and sibling constraints.
    val computed = layout(
        nodes, styles, child_index, 0, 0, 0, width, viewport_h,
        zero_i32_list(node_count), zero_i32_list(node_count),
        zero_i32_list(node_count), zero_i32_list(node_count),
        empty_i32_lists(node_count), empty_i32_lists(node_count),
        neg_one_i32_list(node_count)
    )
    LayoutSelectedResult(layout: computed, fault: "")

fn layout_with_style(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32], st: Style) -> LayoutResult:
    var out_bx = bx
    var out_by = by
    var out_bw = bw
    var out_bh = bh
    var out_wrap_starts = wrap_starts
    var out_wrap_ends = wrap_ends
    var out_intrinsic_widths = intrinsic_widths
    out_bx[i] = x
    out_by[i] = y
    val node = nodes[i]
    # Budget guard: short-circuit layout of not-yet-processed subtrees on expiry.
    # Emit a zero-size box for this node and return a valid LayoutResult so the
    # recursion unwinds cleanly while already-computed boxes stay intact.
    if _web_budget_expired_at(WEB_BUDGET_SITE_LAYOUT_SUBTREE):
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if simple_web_style_hot_is_display_none(computed_style_hot_from(st)):
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    if st.display == "contents":
        out_bw[i] = w
        var cy_contents = y
        var c_contents = child_index.first_child[i]
        var child_count_contents = 0
        var prev_margin_b_contents = 0
        while c_contents >= 0:
            val cst = styles[c_contents]
            val cml = resolve_horizontal_margin_px(cst.margin_l, w)
            val cmr = resolve_horizontal_margin_px(cst.margin_r, w)
            if child_count_contents > 0:
                cy_contents = cy_contents + st.gap_px
            val cst_margin_t_contents = resolve_vertical_margin_px(cst.margin_t, viewport_h)
            val collapsed_margin_contents = collapse_margins_signed(prev_margin_b_contents, cst_margin_t_contents)
            cy_contents = cy_contents + collapsed_margin_contents
            var child_w_contents = w - cml - cmr
            if child_w_contents < 1:
                child_w_contents = 1
            val child = layout_with_style(nodes, styles, child_index, c_contents, x + cml, cy_contents, child_w_contents, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, styles[c_contents])
            out_bx = child.bx
            out_by = child.by
            out_bw = child.bw
            out_bh = child.bh
            out_wrap_starts = child.wrap_starts
            out_wrap_ends = child.wrap_ends
            out_intrinsic_widths = child.intrinsic_widths
            cy_contents = cy_contents + child.height
            prev_margin_b_contents = resolve_vertical_margin_px(cst.margin_b, viewport_h)
            child_count_contents = child_count_contents + 1
            c_contents = child_index.next_sibling[c_contents]
        if child_count_contents > 0:
            cy_contents = cy_contents + prev_margin_b_contents
        val h_contents = cy_contents - y
        out_bh[i] = h_contents
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h_contents)
    val border_x = st.border_l + st.border_r
    val border_y = st.border_t + st.border_b
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    # width_px > 0: explicit px. width_px < 0: percentage of available width
    # (negative sentinel from apply_decls). width_px == 0: fill available width.
    var node_w = if st.width_px > 0: explicit_node_w else: w
    if st.flex_basis_px > 0 and w > 0:
        node_w = w
    if st.width_px < 0:
        node_w = css_outer_width(nodes[i], st, w * (0 - st.width_px) / 100)
        if node_w < 1:
            node_w = 1
    out_bw[i] = node_w
    if node.tag != "#text" and st.width_px == 0 and st.white_space_nowrap:
        val nowrap_intrinsic = intrinsic_text_width(nodes, styles, child_index, i, out_intrinsic_widths)
        out_intrinsic_widths = nowrap_intrinsic.widths
        if nowrap_intrinsic.width > node_w:
            node_w = nowrap_intrinsic.width
    node_w = constrained_outer_width(node, st, node_w)
    out_bw[i] = node_w
    if node.tag == "iframe":
        # Replaced element (like img): fixed box from CSS width/height, else the
        # width/height HTML attributes, else the browser default 300x150. The
        # subtree is never laid out (returns without recursing into children).
        if st.width_px == 0:
            val attr_w = parse_int(attr_value(node.attrs_raw, "width"))
            var iframe_w = if attr_w > 0: attr_w else: 300
            iframe_w = constrained_outer_width(node, st, iframe_w)
            out_bw[i] = iframe_w
        val explicit_iframe_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        var iframe_h = explicit_iframe_h
        if st.height_px == 0:
            val attr_h = parse_int(attr_value(node.attrs_raw, "height"))
            iframe_h = if attr_h > 0: attr_h else: 150
        iframe_h = constrained_outer_height(node, st, iframe_h)
        out_bh[i] = iframe_h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, iframe_h)
    if node.tag == "#text":
        # white-space:pre/nowrap (st.white_space_nowrap, inherited from e.g. a
        # <pre> code block) preserves the raw text incl. leading indentation;
        # normal flow uses the trimmed text. Measure and paint must agree on which.
        val txt: text = if st.white_space_nowrap: node.text_data else: node.text_trimmed
        val txt_len = if st.white_space_nowrap: node.text_data.len() else: node.text_trimmed.len()
        val cw = style_char_w(st)
        var cpl = node_w / cw
        if cpl < 1:
            cpl = 1
        # If the whole run fits the box at its real advance width, keep it on
        # one line. An inline #text box is sized by advance width (5px/char at
        # scale 1) while cpl divides by cell width (6px/char), so without this
        # check a run that exactly fits its box spuriously wraps at ~5/6 of its
        # length ("Simple Editor" -> "Simple"/"Editor", "EDITOR" -> "EDITO"/"R").
        val full_adv = style_text_line_advance_width(txt, 0, txt_len, st, style_text_advance(st), style_space_advance(st))
        # Active left-float band: lines of this text that vertically overlap
        # the band wrap to the narrowed width, the rest to the full width.
        val band_lh = style_line_h(st)
        var band_narrow_lines = 0
        var band_narrow_w = node_w
        if g_float_band_indent > 0 and y < g_float_band_bottom and band_lh > 0 and not st.white_space_nowrap:
            band_narrow_lines = (g_float_band_bottom - y + band_lh - 1) / band_lh
            band_narrow_w = node_w - g_float_band_indent
            if band_narrow_w < 1:
                band_narrow_w = 1
        if st.white_space_nowrap:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        elif band_narrow_lines > 0 and full_adv > band_narrow_w:
            val band_ranges = compute_style_wrap_ranges_float_band(txt, node_w, band_narrow_w, band_narrow_lines, st)
            out_wrap_starts[i] = band_ranges.starts
            out_wrap_ends[i] = band_ranges.ends
        elif full_adv <= node_w:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        else:
            val ranges = compute_style_wrap_ranges(txt, node_w, st, cpl)
            out_wrap_starts[i] = ranges.starts
            out_wrap_ends[i] = ranges.ends
        val lines = out_wrap_starts[i].len()
        val h = lines * style_line_h(st)
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if node.tag == "img" or node.tag == "input":
        val explicit_node_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        val h = constrained_outer_height(node, st, if st.height_px > 0: explicit_node_h else: style_line_h(st))
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if st.content_visibility_hidden:
        var hidden_h = st.pad_t + st.pad_b + border_y
        if st.height_px > 0:
            hidden_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        if st.min_height_px > 0:
            val min_hidden_h = css_outer_height(node, st, st.min_height_px)
            if min_hidden_h > hidden_h:
                hidden_h = min_hidden_h
        if hidden_h < 1:
            hidden_h = 1
        out_bh[i] = hidden_h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, hidden_h)
    val ix = x + st.border_l + st.pad_l
    var iw = node_w - st.pad_l - st.pad_r - border_x
    if iw < 1:
        iw = 1
    val scrollbar_gutter = 15
    val content_height_limit = definite_content_height_limit(node, st)
    val auto_column_offsets = if (
        st.display == "table" and st.table_layout == "auto"
    ):
        # width:auto tables shrink to fit: pass 0 as the available inner
        # width so no leftover space is distributed across the columns.
        explicit_auto_table_column_offsets(
            nodes, styles, child_index, i,
            if st.width_px > 0: iw else: 0,
            st.border_spacing_x_px, st.border_spacing_y_px
        )
    else:
        []
    if (
        st.display == "table" and (
            st.table_layout == "fixed" or
            auto_column_offsets.len() > 0 or
            st.border_spacing_x_px > 0 or
            st.border_spacing_y_px > 0
        )
    ):
        val table_rows = simple_web_collect_table_rows(
            nodes, child_index, i
        )
        val column_count = simple_web_fixed_table_column_count(
            nodes, child_index, table_rows
        )
        # border-collapse geometry (uniform-border slice, honest limits): the
        # grid tracks were sized with half-borders shared between neighbours
        # (see explicit_auto_table_column_offsets); the outer half-border of
        # the first column/row shifts the grid origin by round-half-up, and
        # each row sheds the shared half of its cells' top+bottom borders.
        # Non-uniform per-edge winner widths and row/col spans are NOT
        # modelled here — they keep the plain separate-model geometry.
        val table_collapse = st.border_collapse == "collapse"
        var collapse_outer_x = 0
        var collapse_outer_y = 0
        var collapse_row_shave = 0
        if table_collapse and table_rows.rows.len() > 0:
            var probe_cell = child_index.first_child[table_rows.rows[0]]
            while probe_cell >= 0 and styles[probe_cell].display != "table-cell":
                probe_cell = child_index.next_sibling[probe_cell]
            if probe_cell >= 0:
                collapse_outer_x = (styles[probe_cell].border_l + 1) / 2
                collapse_outer_y = (styles[probe_cell].border_t + 1) / 2
                collapse_row_shave = (
                    styles[probe_cell].border_t + styles[probe_cell].border_b
                ) / 2
        var table_grid_width = if (
            st.table_layout == "auto" and
            auto_column_offsets.len() > column_count
        ):
            auto_column_offsets[column_count]
        else:
            iw - st.border_spacing_x_px * (column_count + 1)
        if table_grid_width < column_count:
            table_grid_width = column_count
        val table_inner_width = (
            table_grid_width +
            st.border_spacing_x_px * (column_count + 1)
        )
        if table_inner_width > iw:
            out_bw[i] = out_bw[i] + table_inner_width - iw
        elif st.width_px <= 0 and auto_column_offsets.len() > 0:
            # width:auto table shrinks to fit its columns instead of filling
            # the containing block.
            out_bw[i] = (
                table_inner_width + st.pad_l + st.pad_r + border_x +
                collapse_outer_x
            )
        var table_row_width = (
            table_grid_width +
            st.border_spacing_x_px * (column_count - 1)
        )
        if table_row_width < 1:
            table_row_width = 1
        var table_y = y + st.border_t + st.pad_t
        var table_child = child_index.first_child[i]
        while table_child >= 0:
            if (
                styles[table_child].display == "table-caption" and
                styles[table_child].caption_side != "bottom"
            ):
                val caption = layout_with_style(
                    nodes, styles, child_index, table_child,
                    ix, table_y, table_inner_width, viewport_h,
                    out_bx, out_by, out_bw, out_bh,
                    out_wrap_starts, out_wrap_ends,
                    out_intrinsic_widths, styles[table_child]
                )
                out_bx = caption.bx
                out_by = caption.by
                out_bw = caption.bw
                out_bh = caption.bh
                out_wrap_starts = caption.wrap_starts
                out_wrap_ends = caption.wrap_ends
                out_intrinsic_widths = caption.intrinsic_widths
                table_y = table_y + caption.height
            table_child = child_index.next_sibling[table_child]
        if table_rows.rows.len() > 0:
            table_y = table_y + st.border_spacing_y_px + collapse_outer_y
        var table_row_index = 0
        while table_row_index < table_rows.rows.len():
            val table_row = table_rows.rows[table_row_index]
            val table_group = table_rows.groups[table_row_index]
            if table_group >= 0 and out_bh[table_group] == 0:
                out_bx[table_group] = ix + st.border_spacing_x_px + collapse_outer_x
                out_by[table_group] = table_y
                out_bw[table_group] = table_row_width
            out_bx[table_row] = ix + st.border_spacing_x_px + collapse_outer_x
            out_by[table_row] = table_y
            out_bw[table_row] = table_row_width
            var row_h = 1
            var used_columns = 0
            var cell = child_index.first_child[table_row]
            while cell >= 0:
                if styles[cell].display == "table-cell":
                    val span = simple_web_fixed_table_cell_span(
                        nodes[cell], column_count
                    )
                    val cell_x = if (
                        st.table_layout == "auto" and
                        auto_column_offsets.len() > used_columns
                    ):
                        (
                            ix + collapse_outer_x +
                            st.border_spacing_x_px * (used_columns + 1) +
                            auto_column_offsets[used_columns]
                        )
                    else:
                        (
                            ix + collapse_outer_x +
                            st.border_spacing_x_px * (used_columns + 1) +
                            table_grid_width * used_columns / column_count
                        )
                    var next_columns = used_columns + span
                    if next_columns > column_count:
                        next_columns = column_count
                    val cell_right = if (
                        st.table_layout == "auto" and
                        auto_column_offsets.len() > next_columns
                    ):
                        (
                            ix + collapse_outer_x +
                            st.border_spacing_x_px * next_columns +
                            auto_column_offsets[next_columns]
                        )
                    else:
                        (
                            ix + collapse_outer_x +
                            st.border_spacing_x_px * next_columns +
                            table_grid_width * next_columns / column_count
                        )
                    val allocated_cell_width = cell_right - cell_x
                    var cell_layout_style = styles[cell]
                    if st.table_layout == "auto":
                        var cell_layout_width = allocated_cell_width
                        if not styles[cell].border_box:
                            cell_layout_width = (
                                cell_layout_width -
                                styles[cell].pad_l - styles[cell].pad_r -
                                styles[cell].border_l - styles[cell].border_r
                            )
                        cell_layout_style = style_with_width(
                            styles[cell],
                            if cell_layout_width > 0: cell_layout_width else: 1
                        )
                    val cell_result = layout_with_style(
                        nodes, styles, child_index, cell,
                        cell_x, table_y, allocated_cell_width,
                        viewport_h, out_bx, out_by, out_bw, out_bh,
                        out_wrap_starts, out_wrap_ends,
                        out_intrinsic_widths, cell_layout_style
                    )
                    out_bx = cell_result.bx
                    out_by = cell_result.by
                    out_bw = cell_result.bw
                    out_bh = cell_result.bh
                    out_wrap_starts = cell_result.wrap_starts
                    out_wrap_ends = cell_result.wrap_ends
                    out_intrinsic_widths = cell_result.intrinsic_widths
                    if cell_result.height > row_h:
                        row_h = cell_result.height
                    used_columns = next_columns
                cell = child_index.next_sibling[cell]
            if collapse_row_shave > 0 and row_h > collapse_row_shave:
                row_h = row_h - collapse_row_shave
            cell = child_index.first_child[table_row]
            while cell >= 0:
                if styles[cell].display == "table-cell":
                    out_bh[cell] = row_h
                cell = child_index.next_sibling[cell]
            out_bh[table_row] = row_h
            table_y = table_y + row_h + st.border_spacing_y_px
            if table_group >= 0:
                out_bh[table_group] = (
                    table_y - st.border_spacing_y_px -
                    out_by[table_group]
                )
            table_row_index = table_row_index + 1
        table_child = child_index.first_child[i]
        while table_child >= 0:
            if (
                styles[table_child].display == "table-caption" and
                styles[table_child].caption_side == "bottom"
            ):
                val caption = layout_with_style(
                    nodes, styles, child_index, table_child,
                    ix, table_y, table_inner_width, viewport_h,
                    out_bx, out_by, out_bw, out_bh,
                    out_wrap_starts, out_wrap_ends,
                    out_intrinsic_widths, styles[table_child]
                )
                out_bx = caption.bx
                out_by = caption.by
                out_bw = caption.bw
                out_bh = caption.bh
                out_wrap_starts = caption.wrap_starts
                out_wrap_ends = caption.wrap_ends
                out_intrinsic_widths = caption.intrinsic_widths
                table_y = table_y + caption.height
            table_child = child_index.next_sibling[table_child]
        var table_h = (
            table_y - y + st.pad_b + st.border_b
        )
        if st.height_px > 0:
            table_h = css_outer_height(node, st, st.height_px)
        out_bh[i] = table_h
        return relative_layout_result(
            child_index, i, st, out_bx, out_by, out_bw, out_bh,
            out_wrap_starts, out_wrap_ends, out_intrinsic_widths,
            table_h
        )
    val grid_columns = grid_track_sizes(
        st.grid_template_columns, iw, st.column_gap_px
    )
    if st.display == "grid" and grid_columns.len() > 0:
        # Row `fr` tracks would need the container's resolved content height,
        # which isn't generally known ahead of auto-height row sizing;
        # available_w=0 here means an `fr` row track resolves to 0px rather
        # than participating in flexible sizing (row-axis fr is out of scope
        # for this simplification — see the bug doc above).
        val explicit_rows = grid_track_sizes(st.grid_template_rows, 0, st.row_gap_px)
        val grid_column_count = grid_columns.len() as i32
        val grid_child_count = child_index.child_count[i]
        val grid_row_capacity = (
            grid_child_count + explicit_rows.len() as i32 + 1
        )
        # `grid-template-areas` named-area rectangles, resolved against
        # `grid-area:<name>` references below (CSS Grid SS7.1); see
        # grid_template_area_rects for the rectangularity-validation and
        # scope notes.
        val area_rects = grid_template_area_rects(st.grid_template_areas)
        var grid_rows: [i32] = [0; grid_row_capacity]
        var explicit_row_index = 0
        while explicit_row_index < explicit_rows.len():
            grid_rows[explicit_row_index] = explicit_rows[explicit_row_index]
            explicit_row_index = explicit_row_index + 1
        var occupied: [bool] = [
            false; grid_row_capacity * grid_column_count
        ]
        var max_grid_row = explicit_rows.len() as i32
        var grid_child = child_index.first_child[i]
        while grid_child >= 0:
            val grid_child_style = styles[grid_child]
            var grid_column = grid_placement_start(
                grid_child_style.grid_column
            )
            var grid_row = grid_placement_start(grid_child_style.grid_row)
            var grid_column_span = grid_placement_span(
                grid_child_style.grid_column
            )
            var grid_row_span = grid_placement_span(grid_child_style.grid_row)
            if grid_child_style.grid_area != "":
                var area_idx = 0
                var area_found = -1
                while area_idx < area_rects.len():
                    if area_rects[area_idx].area == grid_child_style.grid_area:
                        area_found = area_idx as i32
                    area_idx = area_idx + 1
                if area_found >= 0:
                    grid_column = area_rects[area_found].col_start
                    grid_row = area_rects[area_found].row_start
                    grid_column_span = area_rects[area_found].col_span
                    grid_row_span = area_rects[area_found].row_span
            if grid_column_span > grid_column_count:
                grid_column_span = grid_column_count
            # A declared line beyond this bounded layout pass cannot index the
            # occupancy/row arrays. Treat it as auto-placement, preserving the
            # same fail-closed behavior as unsupported/invalid placement.
            if grid_row >= grid_row_capacity:
                grid_row = -1
            if (
                grid_column >= grid_column_count or
                grid_column + grid_column_span > grid_column_count
            ):
                grid_column = -1
            if grid_column < 0 or grid_row < 0:
                # `grid-auto-flow: column` walks column-major: fill down
                # each column (bounded by the explicit row-track count, CSS
                # Grid SS8.5) before advancing to the next column, instead of
                # the default row-major walk. Bounding by the explicit row
                # count (rather than the row-major capacity buffer sized for
                # implicit-row growth) matches browser behavior for a grid
                # with a declared `grid-template-rows`; see
                # doc/08_tracking/bug/
                # browser_engine_grid_template_areas_missing_2026-08.md.
                val flow_row_bound = if (
                    st.grid_auto_flow_column and explicit_rows.len() as i32 > 0
                ):
                    explicit_rows.len() as i32
                else:
                    grid_row_capacity
                val candidate_limit = if st.grid_auto_flow_column:
                    flow_row_bound * grid_column_count
                else:
                    grid_row_capacity * grid_column_count
                var candidate = 0
                var placed = false
                while (
                    candidate < candidate_limit and not placed
                ):
                    val candidate_row = if st.grid_auto_flow_column:
                        candidate % flow_row_bound
                    else:
                        candidate / grid_column_count
                    val candidate_column = if st.grid_auto_flow_column:
                        candidate / flow_row_bound
                    else:
                        candidate % grid_column_count
                    var admitted = (
                        (grid_row < 0 or candidate_row == grid_row) and
                        (grid_column < 0 or candidate_column == grid_column) and
                        candidate_column + grid_column_span <=
                            grid_column_count
                    )
                    var span_index = 0
                    while admitted and span_index < grid_column_span:
                        if occupied[
                            candidate_row * grid_column_count +
                            candidate_column + span_index
                        ]:
                            admitted = false
                        span_index = span_index + 1
                    if admitted:
                        grid_row = candidate_row
                        grid_column = candidate_column
                        placed = true
                    candidate = candidate + 1
            if grid_row < 0:
                grid_row = 0
            if grid_column < 0:
                grid_column = 0
            var mark_index = 0
            while mark_index < grid_column_span:
                occupied[
                    grid_row * grid_column_count +
                    grid_column + mark_index
                ] = true
                mark_index = mark_index + 1
            val grid_child_x = (
                ix + grid_track_offset(
                    grid_columns, st.column_gap_px, grid_column
                )
            )
            val grid_margin_t = resolve_vertical_margin_px(
                grid_child_style.margin_t, viewport_h
            )
            val grid_margin_b = resolve_vertical_margin_px(
                grid_child_style.margin_b, viewport_h
            )
            val grid_child_y = (
                y + st.border_t + st.pad_t +
                grid_track_offset(grid_rows, st.row_gap_px, grid_row) +
                grid_margin_t
            )
            val grid_child_width = grid_track_span_size(
                grid_columns, st.column_gap_px,
                grid_column, grid_column_span
            )
            val grid_item_align = effective_item_align(
                st, grid_child_style
            )
            val grid_child_is_replaced = grid_item_is_replaced(
                nodes[grid_child]
            )
            val grid_explicit_stretch = (
                grid_item_align == "stretch" and (
                    grid_child_style.align_self == "stretch" or
                    st.align_items_authored
                )
            )
            # `normal` stretches only when automatic sizing has not already
            # produced an intrinsic/aspect-ratio block size. Explicit stretch
            # may replace that automatic used size for this bounded slice.
            val grid_normal_stretch = (
                (
                    grid_item_align == "normal" or (
                        grid_child_style.align_self == "auto" and
                        not st.align_items_authored
                    )
                ) and
                grid_child_style.height_px == 0
            )
            var resolved_grid_child_style = grid_child_style
            # This bounded Grid slice does not size spanning rows. Stretch
            # only an auto-size, non-replaced item occupying one row and one
            # column, when block-axis auto margins do not own the free space.
            if (
                grid_row < explicit_rows.len() and
                grid_column_span == 1 and
                grid_row_span == 1 and
                (grid_explicit_stretch or grid_normal_stretch) and
                grid_child_style.height_auto and
                not grid_child_style.margin_t_auto and
                not grid_child_style.margin_b_auto and
                not grid_child_is_replaced
            ):
                var grid_stretch_outer_h = (
                    grid_rows[grid_row] - grid_margin_t - grid_margin_b
                )
                if grid_stretch_outer_h < 1:
                    grid_stretch_outer_h = 1
                var grid_stretch_style_h = grid_stretch_outer_h
                if not (
                    nodes[grid_child].has_widget_class or
                    nodes[grid_child].has_icon_image_class or
                    grid_child_style.border_box
                ):
                    grid_stretch_style_h = (
                        grid_stretch_outer_h - grid_child_style.pad_t -
                        grid_child_style.pad_b - grid_child_style.border_t -
                        grid_child_style.border_b
                    )
                if grid_stretch_style_h < 1:
                    grid_stretch_style_h = 1
                resolved_grid_child_style = style_with_height(
                    grid_child_style, grid_stretch_style_h
                )
            val grid_result = layout_with_style(
                nodes, styles, child_index, grid_child,
                grid_child_x, grid_child_y, grid_child_width, viewport_h,
                out_bx, out_by, out_bw, out_bh,
                out_wrap_starts, out_wrap_ends, out_intrinsic_widths,
                resolved_grid_child_style
            )
            out_bx = grid_result.bx
            out_by = grid_result.by
            out_bw = grid_result.bw
            out_bh = grid_result.bh
            out_wrap_starts = grid_result.wrap_starts
            out_wrap_ends = grid_result.wrap_ends
            out_intrinsic_widths = grid_result.intrinsic_widths
            if (
                grid_row >= explicit_rows.len() and
                grid_result.height > grid_rows[grid_row]
            ):
                grid_rows[grid_row] = grid_result.height
            if grid_row + 1 > max_grid_row:
                max_grid_row = grid_row + 1
            grid_child = child_index.next_sibling[grid_child]
        var grid_content_height = 0
        var grid_height_index = 0
        while grid_height_index < max_grid_row:
            if grid_height_index > 0:
                grid_content_height = grid_content_height + st.row_gap_px
            grid_content_height = (
                grid_content_height + grid_rows[grid_height_index]
            )
            grid_height_index = grid_height_index + 1
        var grid_height = (
            grid_content_height + st.pad_t + st.pad_b + border_y
        )
        if st.height_px > 0:
            grid_height = css_outer_height(node, st, st.height_px)
        out_bh[i] = grid_height
        return relative_layout_result(
            child_index, i, st, out_bx, out_by, out_bw, out_bh,
            out_wrap_starts, out_wrap_ends, out_intrinsic_widths,
            grid_height
        )
    if (
        st.display == "flex" and
        st.flex_direction != "column" and
        st.flex_direction != "column-reverse"
    ):
        val children_for_i_count = child_index.child_count[i]
        val ordered_row_children = flex_ordered_children(styles, child_index, i)
        val ordered_row_child_count = ordered_row_children.len()
        if st.flex_wrap != "nowrap":
            val row_wrap_column_gap = st.column_gap_px
            val row_wrap_row_gap = st.row_gap_px
            var line_heights: [i32] = [0; children_for_i_count]
            var line_widths: [i32] = [0; children_for_i_count]
            var line_item_counts: [i32] = [0; children_for_i_count]
            var line_auto_margin_counts: [i32] = [0; children_for_i_count]
            var line_count = 0
            var total_line_h = 0
            var cx_measure = 0
            var line_h_measure = 0
            var child_count_measure = 0
            var auto_margin_count_measure = 0
            var fm_i = 0
            while fm_i < ordered_row_child_count:
                val fm = ordered_row_children[fm_i]
                val cst = styles[fm]
                if not cst.position_absolute:
                    val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
                    val resolved_cst = if child_height_px > 0 and child_height_px != cst.height_px:
                        style_with_height(cst, child_height_px)
                    else:
                        cst
                    val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                    val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
                    val base_w_wrap = if cst.flex_basis_px > 0: cst.flex_basis_px else: if cst.width_px > 0: if nodes[fm].has_widget_class or nodes[fm].has_icon_image_class or cst.border_box: cst.width_px else: cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r else: if cst.width_px < 0: iw else: iw
                    val measured_ml = if cst.margin_l_auto: 0 else: cml
                    val measured_mr = if cst.margin_r_auto: 0 else: cmr
                    val item_auto_margins = (
                        (if cst.margin_l_auto: 1 else: 0) +
                        (if cst.margin_r_auto: 1 else: 0)
                    )
                    val item_outer_w = measured_ml + base_w_wrap + measured_mr
                    if child_count_measure > 0 and cx_measure + row_wrap_column_gap + item_outer_w > iw:
                        line_heights[line_count] = line_h_measure
                        line_widths[line_count] = cx_measure
                        line_item_counts[line_count] = child_count_measure
                        line_auto_margin_counts[line_count] = auto_margin_count_measure
                        line_count = line_count + 1
                        total_line_h = total_line_h + line_h_measure
                        cx_measure = 0
                        line_h_measure = 0
                        child_count_measure = 0
                        auto_margin_count_measure = 0
                    if child_count_measure > 0:
                        cx_measure = cx_measure + row_wrap_column_gap
                    cx_measure = cx_measure + item_outer_w
                    val used_h = resolved_cst.margin_t + flex_item_outer_height(nodes[fm], resolved_cst) + resolved_cst.margin_b
                    if used_h > line_h_measure:
