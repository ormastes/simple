                    out_bx = cell_result.bx
                    out_by = cell_result.by
                    out_bw = cell_result.bw
                    out_bh = cell_result.bh
                    out_wrap_starts = cell_result.wrap_starts
                    out_wrap_ends = cell_result.wrap_ends
