    out.grid_template_areas = st.grid_template_areas
    out.grid_area = st.grid_area
    out.grid_auto_flow_column = st.grid_auto_flow_column
    out.height_auto = false
    out.align_items_authored = st.align_items_authored
    out.scrollbar_width_none = st.scrollbar_width_none
    out

