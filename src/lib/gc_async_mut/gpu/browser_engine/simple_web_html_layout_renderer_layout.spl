        val table_rows = simple_web_collect_table_rows(
            nodes, child_index, i
        )
        val column_count = simple_web_fixed_table_column_count(
            nodes, child_index, table_rows
        )
        var table_y = y + st.border_t + st.pad_t
        var table_child = child_index.first_child[i]
        while table_child >= 0:
            if styles[table_child].display == "table-caption":
                val caption = layout_with_style(
                    nodes, styles, child_index, table_child,
                    ix, table_y, iw, viewport_h,
                    out_bx, out_by, out_bw, out_bh,
                    out_wrap_starts, out_wrap_ends,
                    out_intrinsic_widths, styles[table_child]
