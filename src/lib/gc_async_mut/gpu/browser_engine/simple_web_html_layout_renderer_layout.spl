                    val cell_x = if st.table_layout == "auto":
                        ix + auto_column_offsets[used_columns]
                    else:
                        ix + iw * used_columns / column_count
                    var next_columns = used_columns + span
                    if next_columns > column_count:
                        next_columns = column_count
