                    # (e.g. width:100% taskbar pills in a row) must shrink from the
                    # same base the measuring loop used, not take the full inner
                    # width (which stacked/overflowed the row).
                    val base_w = if cst.flex_basis_px > 0: cst.flex_basis_px else: if cst.width_px < 0: iw * (0 - cst.width_px) / 100 else: if nodes[fc].has_widget_class or nodes[fc].has_icon_image_class or cst.border_box: cst.width_px else: cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r
                    val shrink_factor = if cst.flex_shrink > 0: cst.flex_shrink else: 0
                    val scaled_shrink = shrink_factor * base_w
                    val cumulative_shrink = (shrink_deficit * (shrink_scaled_used + scaled_shrink)) / shrink_scaled_total
                    remaining_w = base_w - (cumulative_shrink - shrink_width_assigned)
                    shrink_scaled_used = shrink_scaled_used + scaled_shrink
                    shrink_width_assigned = cumulative_shrink
