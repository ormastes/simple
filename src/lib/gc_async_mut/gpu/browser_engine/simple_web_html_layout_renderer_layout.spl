        val positive_free_space = if shrink_deficit == 0 and auto_weight == 0 and auto_main_margin_count == 0 and iw > sum_explicit + gaps_total: iw - sum_explicit - gaps_total else: 0
        var justify_start_offset = 0
        var justify_gap_extra = 0
