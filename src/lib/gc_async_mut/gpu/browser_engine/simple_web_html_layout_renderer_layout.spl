        val auto_main_margin_px = main_distribution.auto_margin
        var justify_start_offset = main_distribution.start_offset
        val justify_gap_extra = main_distribution.gap_extra
        if main_free_space < 0 and st.justify_content == "unsafe-center" and shrink_scaled_total == 0:
