                val absolute_w = absolute_outer_width(st, nodes[fc], cst, iw)
                val resolved_cst = absolute_child_style(st, cst, iw, absolute_containing_h)
                val child = layout_with_style(nodes, styles, child_index, fc, ax, ay, absolute_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
                out_bx = child.bx
                out_by = child.by
                out_bw = child.bw
                out_bh = child.bh
                out_wrap_starts = child.wrap_starts
                out_wrap_ends = child.wrap_ends
                out_intrinsic_widths = child.intrinsic_widths
            else:
                val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
