        var cx = ix + justify_start_offset
        var max_child_h = 0
        var flex_child_count = 0
        var flex_weight_used = 0
        var flex_width_assigned = 0
        var shrink_scaled_used = 0
        var shrink_width_assigned = 0
        var max_baseline = 0
        if st.align_items == "baseline":
            var pb_i = 0
            while pb_i < ordered_flex_child_count:
                val pb = ordered_flex_children[pb_i]
                val pcst = styles[pb]
                if not pcst.position_absolute:
                    val baseline = pcst.margin_t + style_baseline_offset(pcst)
                    if baseline > max_baseline:
                        max_baseline = baseline
                pb_i = pb_i + 1
        else:
            var pb_self_i = 0
            while pb_self_i < ordered_flex_child_count:
                val pb_self = ordered_flex_children[pb_self_i]
                val pcst_self = styles[pb_self]
                if not pcst_self.position_absolute and effective_item_align(st, pcst_self) == "baseline":
                    val baseline_self = pcst_self.margin_t + style_baseline_offset(pcst_self)
                    if baseline_self > max_baseline:
                        max_baseline = baseline_self
                pb_self_i = pb_self_i + 1
        var fc_i = 0
        while fc_i < ordered_flex_child_count:
            val fc = ordered_flex_children[fc_i]
            val cst = styles[fc]
            if cst.position_absolute:
                val absolute_containing_h = content_height_limit + st.pad_t + st.pad_b
                val ax = absolute_child_x(x, st, nodes[fc], cst, iw)
                val ay = absolute_child_y(y, st, nodes[fc], cst, absolute_containing_h)
                val absolute_w = absolute_outer_width(st, nodes[fc], cst, iw)
                val resolved_cst = absolute_child_style(st, cst, iw, absolute_containing_h)
                val child = layout_with_style(nodes, styles, child_index, fc, ax, ay, absolute_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
                out_bx = child.bx
                out_by = child.by
                out_bw = child.bw
                out_bh = child.bh
                out_wrap_starts = child.wrap_starts
                out_wrap_ends = child.wrap_ends
                out_intrinsic_widths = child.intrinsic_widths
            else:
                val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
                if flex_child_count > 0:
                    cx = cx + st.column_gap_px + justify_gap_extra
                cx = cx + (if cst.margin_l_auto: auto_main_margin_px else: cml)
                # auto-width child gets its weighted share; %-width resolves against
                # the container inner width; px-width children ignore this.
                var remaining_w = iw - (cx - ix) - cmr
                var force_used_w = false
                if shrink_deficit > 0 and shrink_scaled_total > 0 and (cst.width_px != 0 or cst.flex_basis_px > 0):
