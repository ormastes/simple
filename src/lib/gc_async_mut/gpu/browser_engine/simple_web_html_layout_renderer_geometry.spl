fn _simple_web_extract_keyframes(html: text) -> KeyframeRegistry:
    if not _simple_web_html_source_admitted(
        html, SIMPLE_WEB_MAX_HTML_BYTES
    ):
        return KeyframeRegistry.new()
    extract_keyframes(html)

pub fn simple_web_layout_element_geometry_lines(html: text, width: i32, height: i32) -> [text]:
    """One `GEOM|<nth-path>|<tag>|<x>|<y>|<w>|<h>` line per LAID-OUT ELEMENT, in
    document order — the enumeration the Chrome geometry differ compares
    against.

    Why this exists rather than reading the Draw IR: the differ used to build
    its element list from Draw IR COMMANDS, so an element that paints nothing
    emitted no command and entered no list. **Measured, that accounts for one
    row of the eight-page difference, not the desync** — round 8 supposed the
    paintless boxes WERE the `<li>` desync and that is retracted here; the
    desync was tree construction (see html_tree_builder.spl's
    `find_tag_in_list_item_scope`). Enumerating elements is still the right
    scheme, because Chrome's side walks `document.body.querySelectorAll('*')`
    and a command list can never be proved to cover it.

    The key is `_simple_web_node_target_key`, the same function the hit-test and
    animation target keys use, so there is ONE nth-path scheme in this file
    rather than a second one that can drift from it."""
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    # Every parameter explicit — same reason as simple_web_layout_debug_layout_by_id.
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    var out: [text] = []
    var i = 0
    while i < node_count:  # cpu-lane-loop-ok: one pass over the parsed node list emitting the differ's element rows; bound is node_count and this entry is tooling-only, not on any paint path
        if _simple_web_layout_element(nodes[i]) and
           not _simple_web_generates_no_box(nodes[i]):
            val key = _simple_web_node_target_key(nodes, child_index, i)
            if key != "":
                out.push(
                    "GEOM|" + key + "|" + nodes[i].tag + "|" +
                    boxes.bx[i].to_string() + "|" + boxes.by[i].to_string() + "|" +
                    boxes.bw[i].to_string() + "|" + boxes.bh[i].to_string()
                )
        i = i + 1
    out

pub fn simple_web_layout_debug_layout_by_id(html: text, width: i32, height: i32, id: text, field: text) -> text:
    _web_budget_begin(WEB_RENDER_BUDGET_MS)
    val nodes = parse_html(html)
    # Pass every parameter explicitly. An omitted trailing default was
    # observed taking a non-default value in the freestanding SimpleOS kernel
    # build (the `trace_stages` receipt fired from this call site even though
    # the only trace-enabled caller never ran), so this render path does not
    # rely on default-argument materialization.
    val rules = extract_css_vw(html, width, false)
    val child_index = build_child_index(nodes)
    val styles = compute_styles(nodes, rules, child_index, false, true)
    val node_count = nodes.len() as i32
    val empty_starts = empty_i32_lists(node_count)
    val empty_ends = empty_i32_lists(node_count)
    val boxes = layout(
        nodes,
        styles,
        child_index,
        0,
        0,
        0,
        width,
        height,
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        zero_i32_list(node_count),
        empty_starts,
        empty_ends,
        neg_one_i32_list(node_count)
    )
    var i = 0
    while i < node_count:  # cpu-lane-loop-ok: linear id lookup over the parsed node list in the debug-only layout query entry; bound is node_count, single pass, not on any paint path
        val node = nodes[i]
        if node.id_attr == id:
            val x = boxes.bx[i]
            val y = boxes.by[i]
            val w = boxes.bw[i]
            val h = boxes.bh[i]
            if field == "x": return x.to_string()
            if field == "y": return y.to_string()
            if field == "w": return w.to_string()
            if field == "h": return h.to_string()
            if field == "margin_t": return styles[i].margin_t.to_string()
            if field == "margin_b": return styles[i].margin_b.to_string()
            # Paint-side width of the FIRST line of this element's first text
            # child, computed exactly the way paint() computes it: through the
            # shared per-byte advance table (`style_run_byte_advances`). Its
            # whole point is that it must equal the element's LAYOUT box width
            # `w` above -- layout sizing the run one way while paint stepped
            # glyphs another is the `forms-media` pixel regression recorded in
            # doc/08_tracking/bug/web_forms_media_pixel_regression_layout_paint_advance_disagree_2026-09-12.md.
            if field == "paint_line_w":
                var t = child_index.first_child[i]
                while t >= 0:
                    if nodes[t].tag == "#text":
                        val tst = styles[t]
                        val ttxt = if tst.white_space_nowrap: nodes[t].text_data else: nodes[t].text_trimmed
                        val tstarts = boxes.wrap_starts[t]
                        val tends = boxes.wrap_ends[t]
                        if tstarts.len() > 0:
                            return style_text_line_advance_width_with(
                                style_run_byte_advances(tst, ttxt), ttxt,
                                tstarts[0], tends[0],
                                style_text_advance(tst), style_space_advance(tst)
                            ).to_string()
                        return "0"
                    t = child_index.next_sibling[t]
                return ""
        i = i + 1
    ""

fn _simple_web_layout_element(node: HNode) -> bool:
    (
        node.tag != "#text" and node.tag != "style" and
        node.tag != "script" and node.tag != "title" and
        node.tag != "head" and node.tag != "meta" and
        node.tag != "link" and node.tag != "base" and
        # Pseudo-element boxes (`::marker`, synthesised as every <li>'s FIRST
        # child) are not DOM elements: Chrome's querySelectorAll walk cannot
        # see them, so counting them here shifted the nth-path ordinal of
        # every real child inside a list item by one. The geometry differ
        # already excludes them from its own key scheme
        # (doc/08_tracking/bug/web_layout_geometry_differ_counts_marker_boxes_
        # as_elements_2026-09-12.md); these hit-test / animation target keys
        # claim to mirror that scheme byte-for-byte and did not.
        not node.tag.starts_with("::")
    )

# An element that GENERATES NO BOX. Distinct from `_simple_web_layout_element`
# above, and the distinction is load-bearing in both directions:
#
#   * `_simple_web_layout_element` decides what COUNTS FOR AN ORDINAL, and must
#     keep matching the differ walker's `layoutEl` byte-for-byte. `<wbr>` IS a
#     layout element there (the walker's SKIP set holds only STYLE/SCRIPT/TITLE/
#     HEAD/META/LINK/BASE), so removing it from that predicate would shift the
#     nth-path of every following sibling and desync the two sides -- exactly
#     the `::marker` defect recorded above, replayed.
#   * THIS predicate decides what HAS GEOMETRY. `<wbr>` is a zero-width BREAK
#     OPPORTUNITY in the text (HTML  4.7.28: "does not represent anything ...
#     represents an opportunity for the line to break"), not a box. Chrome
#     agrees and reports it as the all-zero rect -- its way of saying there is
#     no box to report.
#
# Because the key is computed from the DOM walk and not from the emitted rows,
# dropping a row here CANNOT move any other element's path. Round 19 recorded
# the opposite belief ("genuinely emitting no box shifts the differ's path
# ordinals for every element after it") and deferred the fix on that basis;
# that premise is FALSE, and the `wbr_boxless_geometry_spec` sibling-ordinal
# assertion is what pins it.
#
# Scoped to `wbr` alone, on measurement rather than intuition. The round-20
# census found five boxless elements in Chrome across the eight catalog pages,
# but the other four are boxless for reasons that are NOT properties of their
# tag -- two `<span>` fallback children of a replaced element, and two
# `<option>` inside a closed `<select>` -- and belong to their own rules.
# `<br>` is deliberately absent: Chrome gives it a REAL rect, so adding it here
# on the "likely boxless" intuition would have been a regression.
fn _simple_web_generates_no_box(node: HNode) -> bool:
    node.tag == "wbr"

fn _simple_web_element_child_ordinal(
    nodes: [HNode], child_index: HtmlChildIndex,
    parent_index: i32, target_index: i32
) -> i32:
    var ordinal = 0
    var child = child_index.first_child[parent_index]
    while child >= 0:  # cpu-lane-loop-ok: walks one parent's sibling chain to find a child's element ordinal; bound is that parent's child count, not the document
        if _simple_web_layout_element(nodes[child]):
            if child == target_index:
                return ordinal
            ordinal = ordinal + 1
        child = child_index.next_sibling[child]
    -1

fn _simple_web_node_target_key(
    nodes: [HNode], child_index: HtmlChildIndex, node_index: i32
) -> text:
    if node_index < 0 or node_index >= nodes.len():
        return ""
    var body = node_index
    while body >= 0 and nodes[body].tag != "body":  # cpu-lane-loop-ok: ancestor walk from a node up to <body>; bound is tree depth, not an element count - flagged by the gate's any-loop-header approximation of the design's bound-based rule
        body = nodes[body].parent.to_i32()
    if body < 0:
        return ""
    if node_index == body:
        return "path:"
    var reversed: [i32] = [0; nodes.len()]
    var depth = 0
    var current = node_index
    while current != body and current >= 0:  # cpu-lane-loop-ok: ancestor walk emitting one path ordinal per level; bound is tree depth - flagged by the gate's any-loop-header approximation of the design's bound-based rule
        val parent = nodes[current].parent.to_i32()
        if parent < 0:
            return ""
        val ordinal = _simple_web_element_child_ordinal(
            nodes, child_index, parent, current
        )
        if ordinal < 0:
            return ""
        reversed[depth] = ordinal
        depth = depth + 1
        current = parent
    var path = "path:"
    var part = depth - 1
    while part >= 0:  # cpu-lane-loop-ok: reverses the depth-many path ordinals collected above into the target-key text; bound is tree depth, not an element count
        if part < depth - 1:
            path = path + "/"
        path = path + reversed[part].to_text()
        part = part - 1
    path

class _SimpleWebAnimationFrameIndex:
    target_keys: [text]
    signatures: [text]
    keyframes_by_name: Dict<text, i32>
    instances_by_target: Dict<text, i32>

class _SimpleWebAnimationApplyResult:
    styles: [Style]
    property_work_count: i64

class _SimpleWebAnimationSchedule:
    animation_end_ms: i64
    animation_next_ms: i64

fn _simple_web_animation_target_keys(
    nodes: [HNode], child_index: HtmlChildIndex
) -> [text]:
    var target_keys = [""; nodes.len()]
    var body_index = -1
    var node_index = 0
    while node_index < nodes.len():  # cpu-lane-loop-ok: one scan for the <body> node, breaks on first hit; bound is node_count, runs once per animation frame-index build
        if nodes[node_index].tag == "body":
            body_index = node_index
            target_keys[node_index] = "path:"
            break
        node_index = node_index + 1
    if body_index < 0:
        return target_keys

    var parent_index = body_index
    while parent_index < nodes.len():  # cpu-lane-loop-ok: single top-down pass assigning every node its animation target key; bound is node_count - this IS the bulk replacement for the per-node path walk
        if target_keys[parent_index] != "":
            var ordinal = 0
            var child = child_index.first_child[parent_index]
            while child >= 0:  # cpu-lane-loop-ok: inner sibling chain of the current parent; every node is visited exactly once as a child, so the enclosing pass stays O(node_count)
                if _simple_web_layout_element(nodes[child]):
                    val separator = if target_keys[parent_index] == "path:":
                        ""
                    else:
                        "/"
                    target_keys[child] = (
                        target_keys[parent_index] + separator +
                        ordinal.to_text()
                    )
                    ordinal = ordinal + 1
                child = child_index.next_sibling[child]
        parent_index = parent_index + 1
    target_keys

fn _simple_web_hit_target_key(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    boxes: LayoutResult, width: i32, height: i32, x: i32, y: i32
) -> text:
    val clip_cache = build_ancestor_clip_cache(
        nodes, styles, boxes.bx, boxes.by, boxes.bw, boxes.bh,
        width, height
    )
    var best = -1
    var best_z = -2147483647
    var i = 0
    while i < nodes.len():  # cpu-lane-loop-ok: one pass over nodes picking the topmost hit box; bound is node_count and it runs per pointer event, not per frame
        val node = nodes[i]
        val style = styles[i]
        val clip = paint_clip_at(clip_cache, i)
        val hit_x = x.to_i64()
        val hit_y = y.to_i64()
        val box_x = boxes.bx[i].to_i64()
        val box_y = boxes.by[i].to_i64()
        val inside = (
            boxes.bw[i] > 0 and boxes.bh[i] > 0 and
            hit_x >= box_x and hit_y >= box_y and
            hit_x < box_x + boxes.bw[i].to_i64() and
            hit_y < box_y + boxes.bh[i].to_i64() and
            x >= clip.x0 and y >= clip.y0 and
            x < clip.x1 and y < clip.y1
        )
        if (
            inside and node.tag != "#text" and node.tag != "#root" and
            style.display != "none" and not style.visibility_hidden and
            not content_hidden_by_ancestor(nodes, styles, i) and
            (best < 0 or style.z_index > best_z or
             (style.z_index == best_z and i > best))
        ):
            best = i
            best_z = style.z_index
        i = i + 1
    if best < 0:
        return ""
    _simple_web_node_target_key(nodes, child_index, best)
