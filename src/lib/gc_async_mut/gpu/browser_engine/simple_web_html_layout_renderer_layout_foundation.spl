# A `<summary>`'s disclosure marker (Chrome 159 list_marker.cc): the symbol
# box is `0.66em` square and an inside marker adds a `0.4em` end margin, each
# truncated to a LayoutUnit (1/64 px) on its own -- 16 px: 675/64 + 409/64 =
# 16.9375, the x where Chrome starts the summary text in every font family.
# reason: font size in whole px; result in 1/64 px like Chrome's LayoutUnit.
# @allow(primitive_api)
pub fn summary_marker_symbol_64(font_size: i32) -> i32:
    font_size * 66 * 64 / 100

# reason: font size and the marker's inline width are whole layout pixels.
# @allow(primitive_api)
pub fn summary_marker_inline_width(font_size: i32) -> i32:
    (summary_marker_symbol_64(font_size) + font_size * 4 * 64 / 10 + 32) / 64

# Bounded collapsed-border style precedence, from lowest to highest.
# An empty style is the same as an absent/none edge. Unknown styles fail the
# bounded admission instead of silently selecting the wrong border.
fn simple_web_collapsed_border_style_rank(style: text) -> i32:
    val normalized = style.trim().lower()
    if normalized == "" or normalized == "none":
        return 0
    if normalized == "inset":
        return 1
    if normalized == "groove":
        return 2
    if normalized == "outset":
        return 3
    if normalized == "ridge":
        return 4
    if normalized == "dotted":
        return 5
    if normalized == "dashed":
        return 6
    if normalized == "solid":
        return 7
    if normalized == "double":
        return 8
    if normalized == "hidden":
        return 9
    -1

fn simple_web_collapsed_left_edge_wins(
    left_style: text, left_width: i32,
    right_style: text, right_width: i32
) -> bool:
    val left_rank = simple_web_collapsed_border_style_rank(left_style)
    val right_rank = simple_web_collapsed_border_style_rank(right_style)
    # hidden suppresses every competing border.
    if left_rank == 9:
        return true
    if right_rank == 9:
        return false
    # none/absent loses to a present style.
    if left_rank != right_rank and (left_rank == 0 or right_rank == 0):
        return left_rank > right_rank
    if left_width != right_width:
        return left_width > right_width
    if left_rank != right_rank:
        return left_rank > right_rank
    # The admitted slice is LTR, so the earlier (left) cell wins an exact tie.
    true

# Bounded CSS border-collapse slice: resolve only adjacent direct table-cell
# edges in one LTR row. Wider spans, vertical conflicts, row spans, and RTL
# origin precedence remain outside this admission.
fn simple_web_resolve_collapsed_table_borders(
    nodes: [HNode], child_index: HtmlChildIndex, styles: [Style]
) -> [Style]:
    var resolved = styles
    var table = 0
    while table < nodes.len():
        if (
            resolved[table].display == "table" and
            resolved[table].border_collapse == "collapse"
        ):
            val rows = simple_web_collect_table_rows(
                nodes, child_index, table
            )
            var bounded = (
                rows.rows.len() == 1 and
                not resolved[table].direction_rtl
            )
            for row in rows.rows:
                if (
                    resolved[row].display != "table-row" or
                    resolved[row].direction_rtl
                ):
                    bounded = false
                var direct_cell_count = 0
                var first_cell = -1
                var second_cell = -1
                var bounded_cell = child_index.first_child[row]
                while bounded_cell >= 0:
                    if resolved[bounded_cell].display == "table-cell":
                        direct_cell_count = direct_cell_count + 1
                        if direct_cell_count == 1:
                            first_cell = bounded_cell
                        elif direct_cell_count == 2:
                            second_cell = bounded_cell
                        if (
                            attr_value(
                                nodes[bounded_cell].attrs_raw, "colspan"
                            ) != "" or
                            attr_value(
                                nodes[bounded_cell].attrs_raw, "rowspan"
                            ) != ""
                        ):
                            bounded = false
                    bounded_cell = child_index.next_sibling[bounded_cell]
                if direct_cell_count != 2:
                    bounded = false
                elif (
                    resolved[first_cell].direction_rtl or
                    resolved[second_cell].direction_rtl or
                    simple_web_collapsed_border_style_rank(
                        resolved[first_cell].border_style_r
                    ) < 0 or
                    simple_web_collapsed_border_style_rank(
                        resolved[second_cell].border_style_l
                    ) < 0
                ):
                    bounded = false
            if not bounded:
                table = table + 1
                continue
            resolved[table].border_spacing_x_px = 0
            resolved[table].border_spacing_y_px = 0
            for row in rows.rows:
                var previous = -1
                var cell = child_index.first_child[row]
                while cell >= 0:
                    if resolved[cell].display == "table-cell":
                        if previous >= 0:
                            var left = resolved[previous]
                            var right = resolved[cell]
                            if simple_web_collapsed_left_edge_wins(
                                left.border_style_r, left.border_r,
                                right.border_style_l, right.border_l
                            ):
                                right.border_l = 0
                                right.border_color_l = 0u32
                            else:
                                left.border_r = 0
                                left.border_color_r = 0u32
                            resolved[previous] = left
                            resolved[cell] = right
                        previous = cell
                    cell = child_index.next_sibling[cell]
        table = table + 1
    resolved

class LayoutResult:
    bx: [i32]
    by: [i32]
    bw: [i32]
    bh: [i32]
    wrap_starts: [[i32]]
    wrap_ends: [[i32]]
    intrinsic_widths: [i32]
    height: i32
    # CSS 2.2 8.3.1: the bottom margin of a block's LAST in-flow child
    # collapses THROUGH the block when the block has no bottom padding,
    # no bottom border, and no height that would establish a bottom edge.
    # The margin is then the block's own trailing margin for the parent's
    # sibling collapsing -- it must not be added to the block's height.
    # Without this an <li> wrapping a <p> was 16 px taller than Chrome.
    # Units: milli-px (see block_margin_milli).
    trailing_margin_b: i32 = 0
    # CSS 2.2 8.3.1, the symmetric half: the top margin of a block's FIRST
    # in-flow child collapses THROUGH the block when the block has no top
    # padding, no top border, and nothing else that would establish a top
    # edge. The margin is then the block's own LEADING margin and must be
    # collapsed with the block's declared margin-top by the block's parent
    # instead of being added to the block's height. Without this
    # `<div><p>t</p></div>` measured 40 px where Chrome measures 24.
    # Units: milli-px.
    leading_margin_t: i32 = 0
    # Residual of the block cursor at this box's bottom edge, in milli-px: its
    # true bottom is (y + height) * 1000 + end_frac_milli, so a parent continues
    # its own cursor from it instead of dropping the container's sub-pixel
    # height. Only meaningful when end_frac_valid (block and single-line flex
    # row paths); every other path leaves the parent's cursor alone.
    end_frac_milli: i32 = 0
    end_frac_valid: bool = false
    # Per node: how far the FIRST line of a wrapped `#text` run starts to the
    # right of its box's left edge. A run that starts mid-line (after an
    # inline sibling) shares that line box, and its continuation lines start
    # at the line box's left edge -- so its box is the full line width and
    # only line 0 is inset. Empty when no run in the document needs it.
    # Filled by `layout()` from `g_text_first_line_dx`; read through
    # `text_first_line_dx_at`.
    first_line_dx: [i32] = []
    # Per-node (dx, width) pairs for the lines of a wrapped `#text` run that
    # floats shorten; empty when no run needs it. Filled by `layout()` from
    # `g_text_line_boxes`; read through `text_line_box_dx` / `text_line_box_w`.
    line_boxes: [[i32]] = []
    # Per node: milli-px from a mid-line `#text` run's box x to where its
    # first line's pen REALLY starts (Chrome 159 keeps the fraction of the
    # inline content before it). Empty when no run needs it. Filled by
    # `layout()` from `g_text_pen_origin_milli`; read through
    # `text_pen_origin_at`.
    pen_origin_milli: [i32] = []
    # Per node at device scale k > 1: device-px y correction of a `#text` run's
    # Draw IR command, first line in `device_dy`, lines 2..n in
    # `device_dy_rest` (see `align_inline_line_device_dy`). Empty at k == 1.
    # Filled by `layout()` from `g_text_device_dy` / `g_text_device_dy_rest`.
    device_dy: [i32] = []
    device_dy_rest: [i32] = []
    # Per node at device scale k > 1: milli device px from k x by[i] to the true
    # device top of a block-level box (`box_device_top_record`); paint snaps it
    # with `box_device_top_px` and moves every command the box owns by it.
    # DEVICE_TOP_UNSET where the block cursor did not place the node. Empty at k == 1.
    device_top: [i32] = []

class LayoutSelectedResult:
    layout: LayoutResult
    fault: text

class PositionOffsetResult:
    bx: [i32]
    by: [i32]

fn offset_layout_subtree(child_index: HtmlChildIndex, node_index: i32, dx: i32, dy: i32, bx: [i32], by: [i32]) -> PositionOffsetResult:
    var out_bx = bx
    var out_by = by
    out_bx[node_index] = out_bx[node_index] + dx
    out_by[node_index] = out_by[node_index] + dy
    var child = child_index.first_child[node_index]
    while child >= 0:
        val shifted = offset_layout_subtree(child_index, child, dx, dy, out_bx, out_by)
        out_bx = shifted.bx
        out_by = shifted.by
        child = child_index.next_sibling[child]
    PositionOffsetResult(bx: out_bx, by: out_by)

fn rtl_row_flex_item_offset(
    child_index: HtmlChildIndex, node_index: i32,
    content_x: i32, content_w: i32,
    margin_l: i32, margin_r: i32,
    st: Style, bx: [i32], by: [i32], bw: [i32]
) -> PositionOffsetResult:
    # Row layout is measured once in logical order from the left. For RTL,
    # reflect each occupied margin box around the content box, then translate
    # the complete item subtree. Physical left/right margins remain physical;
    # DOM/order sorting is deliberately unchanged.
    val relative_x = if st.position_relative: st.left_px else: 0
    val normal_x = bx[node_index] - relative_x
    val mirrored_x = (
        content_x + content_w - (normal_x - content_x) - bw[node_index] +
        margin_l - margin_r + relative_x
    )
    offset_layout_subtree(
        child_index, node_index, mirrored_x - bx[node_index], 0, bx, by
    )

class InlineLineAlignment:
    bx: [i32]
    by: [i32]
    height: i32
    # Device scale k > 1: the line's device-px height minus k x `height`, in
    # milli CSS px (Chrome lays the line out in device px). The block cursor
    # carries it in its residual. 0 at k == 1.
    height_frac_milli: i32 = 0

# Distance from the top of a line box (of this style's strut) to its baseline.
# Chrome (Blink FontHeight::AddLeading): ascent and descent are the face's own,
# each rounded to whole px; half-leading = (line-height - (ascent + descent)) / 2
# is FLOORED and goes above, the remainder below. Chrome 159, Liberation Serif
# 16px (14/3): line-height 24 -> baseline 17, 20 -> 15, 17 -> 14, normal -> 14.
# Without a measured face the old estimate (font_size * 7/8, leading split on
# font_size) stays.
# reason: a whole-px offset inside the line box, the unit layout and paint share.
# @allow(primitive_api)
pub fn inline_line_strut_baseline_offset(st: Style) -> i32:
    val ad = style_face_ascent_descent(st)
    if ad.len() == 2:
        val leading = style_line_h(st) - (ad[0] + ad[1])
        val above = if leading >= 0: leading / 2 else: 0 - (1 - leading) / 2
        return above + ad[0]
    val half_leading = (style_line_h(st) - st.font_size) / 2
    half_leading + style_baseline_offset(st)

# CSS 2.1 §10.8.1: "the baseline of an inline, non-replaced element is the
# baseline of its font; the baseline of an inline REPLACED element is the
# bottom margin edge". An empty inline-block already followed the bottom-edge
# rule (§10.8.1's "if it has no in-flow line boxes" clause) and the two cases
# are the same arithmetic, so `bottom_edge_baseline` selects between them.
# Round 19 added the replaced arm: it is what puts Chrome's canvas/svg/audio/
# video on one shared baseline at y=335 on the `animation` catalog page instead
# of hanging each one from the font strut.
#
# The rule is scoped to REPLACED MEDIA, not to every tag in
# `grid_item_is_replaced`. Form controls are in that set too, and this engine
# currently gives `input` and `select` `display:inline`, so an unscoped
# predicate caught them — measured: it took `form_control_widget_box_spec`'s
# `<label>Choice <select>…` from 33 px to 39. A form control's baseline is its
# INNER TEXT baseline (Chrome reports these four as `inline-block` in the first
# place, per the round-19 census), which the font strut already models, so they
# keep the strut path until someone measures the inner-text case properly.
fn replaced_media_bottom_edge_tag(tag: text) -> bool:
    (
        tag == "img" or tag == "svg" or tag == "video" or tag == "audio" or
        tag == "canvas" or tag == "iframe" or tag == "embed" or
        tag == "object"
    )

fn bottom_edge_baseline(child_index: HtmlChildIndex, node_index: i32, st: Style, replaced_media: bool) -> bool:
    if replaced_media and st.display == "inline":
        return true
    st.display == "inline-block" and child_index.child_count[node_index] == 0

fn inline_line_baseline_ascent(child_index: HtmlChildIndex, node_index: i32, st: Style, margin_t: i32, margin_b: i32, bh: [i32], replaced: bool) -> i32:
    if bottom_edge_baseline(child_index, node_index, st, replaced):
        return margin_t + bh[node_index] + margin_b
    inline_line_strut_baseline_offset(st)

fn inline_line_baseline_offset(child_index: HtmlChildIndex, node_index: i32, st: Style, margin_b: i32, bh: [i32], replaced: bool) -> i32:
    if bottom_edge_baseline(child_index, node_index, st, replaced):
        return bh[node_index] + margin_b
    inline_line_strut_baseline_offset(st)

fn inline_line_baseline_descent(st: Style) -> i32:
    style_line_h(st) - inline_line_strut_baseline_offset(st)

# An inline non-replaced ELEMENT: the only kind of box whose `vertical-align:
# sub | super` is modelled as a baseline shift.
fn inline_box_is_plain_element(node: HNode, st: Style) -> bool:
    node.tag != "#text" and st.display == "inline" and not grid_item_is_replaced(node)

# The text run of plain inline element `c` when that run is its only child and
# the element adds no horizontal padding or border, else -1. Chrome wraps such
# an element exactly like the run inside it, one fragment per line. Nodes are
# in document order, so that child is `c + 1` and no later node is `c`'s.
# reason: node indices are the layout tables' own i32 keys
# @allow(primitive_api)
pub fn inline_sole_text_run(nodes: [HNode], styles: [Style], c: i32) -> i32:
    val st = styles[c]
    if not inline_box_is_plain_element(nodes[c], st):
        return -1
    if st.pad_l != 0 or st.pad_r != 0 or st.border_l != 0 or st.border_r != 0:
        return -1
    val t = c + 1
    val n = nodes.len() as i32
    if t >= n or nodes[t].parent != (c as i64) or nodes[t].tag != "#text":
        return -1
    if t + 1 < n and nodes[t + 1].parent == (c as i64):
        return -1
    t

# Baseline shift of `vertical-align: sub | super`, positive = DOWN, rounded to
# the nearest pixel. Chrome (Blink) lowers a `sub` box by a fifth of the
# PARENT's font size plus 1 px and raises a `super` box by a third plus 1 px.
fn vertical_align_baseline_shift(st: Style, parent_font_size: i32) -> i32:
    if st.vertical_align == "sub":
        return (parent_font_size * 2 + 15) / 10
    if st.vertical_align == "super":
        return 0 - (parent_font_size * 2 + 9) / 6
    0

# Device twin at device scale k > 1: Blink adds the 1 px in ZOOMED layout
# units, so the shift is `k * size / 5 + 1` DEVICE px, not k times the CSS
# shift. Chrome 159 at k=4 in a 16 px line: sub 14 rows down (13.8), super 22
# rows up (22.33); k x the CSS shift is 16 and 24.
fn vertical_align_baseline_shift_device(st: Style, parent: Style, k: i32) -> i32:
    val size_milli = font_milli_of(parent.font_size, parent.font_size_milli) * k
    if st.vertical_align == "sub":
        return (size_milli / 5 + 1500) / 1000
    if st.vertical_align == "super":
        return 0 - (size_milli / 3 + 1500) / 1000
    0

# Distance from the top of an inline box's content area to its baseline.
fn inline_content_area_ascent(st: Style) -> i32:
    val ad = style_face_ascent_descent(st)
    if ad.len() == 2 and ad[0] > 0:
        return ad[0]
    (inline_content_area_height(st) - st.font_size + 1) / 2 + style_baseline_offset(st)

# Extent of an inline element's line-height box ABOVE its own baseline,
# including the sub/super boxes nested in it: those are laid out inside the
# element but still have to fit in the line box that holds it.
fn inline_box_shifted_ascent(child_index: HtmlChildIndex, html_nodes: [HNode], styles: [Style], node_index: i32) -> i32:
    val st = styles[node_index]
    var ascent = inline_line_strut_baseline_offset(st)
    var child = child_index.first_child[node_index]
    while child >= 0:
        if inline_box_is_plain_element(html_nodes[child], styles[child]):
            val child_ascent = inline_box_shifted_ascent(child_index, html_nodes, styles, child) - vertical_align_baseline_shift(styles[child], st.font_size)
            if child_ascent > ascent:
                ascent = child_ascent
        child = child_index.next_sibling[child]
    ascent

# The same extent BELOW the baseline.
fn inline_box_shifted_descent(child_index: HtmlChildIndex, html_nodes: [HNode], styles: [Style], node_index: i32) -> i32:
    val st = styles[node_index]
    var descent = inline_line_baseline_descent(st)
    var child = child_index.first_child[node_index]
    while child >= 0:
        if inline_box_is_plain_element(html_nodes[child], styles[child]):
            val child_descent = inline_box_shifted_descent(child_index, html_nodes, styles, child) + vertical_align_baseline_shift(styles[child], st.font_size)
            if child_descent > descent:
                descent = child_descent
        child = child_index.next_sibling[child]
    descent

# `vertical-align: middle | top | bottom | text-top | text-bottom` on an ATOMIC
# inline (inline-block, replaced, widget): returns the keyword, or "" for every
# other box. CSS 2.2 10.8 aligns the MARGIN box, so the margins are part of what
# is placed and of the line height. Plain inline elements are not handled here;
# a replaced element or form control is atomic even where this engine still
# carries `display: inline` for it.
fn inline_atomic_valign(node: HNode, st: Style) -> text:
    if node.tag == "#text" or (st.display == "inline" and not grid_item_is_replaced(node)):
        return ""
    if st.vertical_align == "middle" or st.vertical_align == "top" or st.vertical_align == "bottom" or st.vertical_align == "text-top" or st.vertical_align == "text-bottom":
        return st.vertical_align
    ""

# Half the x-height of the line's own font in 1/64 px, rounded half up: the
# distance above the baseline at which `vertical-align: middle` centres a
# margin box. Blink: LayoutUnit::FromFloatRound(XHeight() / 2), with Skia's
# x-height (OS/2 sxHeight; 0.56 of the ascent for a face without one).
# Chrome 159: Liberation Sans 16px 271/64, 24px 406/64; Liberation Serif 16px
# 235/64.
fn inline_middle_half_x_height_64(st: Style) -> i32:
    val units = browser_face_x_height_units(st.font_family, st.bold, st.font_style_italic)
    if units.len() == 2:
        val scaled = units[0] * (font_milli_of(st.font_size, st.font_size_milli) as i64) * 32
        val per_px = units[1] * 1000
        return ((scaled + per_px / 2) / per_px) as i32
    (style_baseline_offset(st) * 56 * 32 + 50) / 100

fn align_inline_line_baselines(child_index: HtmlChildIndex, line_style: Style, html_nodes: [HNode], nodes: [i32], margin_ts: [i32], margin_bs: [i32], styles: [Style], line_y: i32, line_height: i32, bx: [i32], by: [i32], bh: [i32], line_frac_milli: i32 = 0, origin_frac_milli: i32 = 0) -> InlineLineAlignment:
    var out_bx = bx
    var out_by = by
    if nodes.len() == 0:
        return InlineLineAlignment(
            bx: out_bx, by: out_by, height: line_height
        )
    var ascent = inline_line_strut_baseline_offset(line_style)
    var descent = inline_line_baseline_descent(line_style)
    # The parent's content area around the baseline: `text-top` / `text-bottom`
    # hang from its top / bottom edge.
    val content_ascent = inline_content_area_ascent(line_style)
    val content_descent = inline_content_area_height(line_style) - content_ascent
    var top_margin_box_h = 0
    var bottom_margin_box_h = 0
    var baseline_i = 0
    var any_valign = false
    # `middle` boxes: half the parent's x-height, and the furthest any margin
    # box reaches above / below the baseline, all in 1/64 px (Chrome lands on
    # fractions: a 10 px box in 16px Liberation Sans sits at y 4.765625).
    var middle_half_x64 = -1
    var middle_ascent64 = 0
    var middle_descent64 = 0
    while baseline_i < nodes.len():
        val node_index = nodes[baseline_i]
        val node_style = styles[node_index]
        val node_valign = inline_atomic_valign(html_nodes[node_index], node_style)
        if node_valign != "":
            val margin_box_h = margin_ts[baseline_i] + bh[node_index] + margin_bs[baseline_i]
            if node_valign == "middle":
                if middle_half_x64 < 0:
                    middle_half_x64 = inline_middle_half_x_height_64(line_style)
                if margin_box_h * 32 + middle_half_x64 > middle_ascent64:
                    middle_ascent64 = margin_box_h * 32 + middle_half_x64
                if margin_box_h * 32 - middle_half_x64 > middle_descent64:
                    middle_descent64 = margin_box_h * 32 - middle_half_x64
                baseline_i = baseline_i + 1
                continue
            any_valign = true
            if node_valign == "top":
                if margin_box_h > top_margin_box_h:
                    top_margin_box_h = margin_box_h
            elif node_valign == "bottom":
                if margin_box_h > bottom_margin_box_h:
                    bottom_margin_box_h = margin_box_h
            elif node_valign == "text-top":
                if content_ascent > ascent:
                    ascent = content_ascent
                if margin_box_h - content_ascent > descent:
                    descent = margin_box_h - content_ascent
            else:
                if margin_box_h - content_descent > ascent:
                    ascent = margin_box_h - content_descent
                if content_descent > descent:
                    descent = content_descent
            baseline_i = baseline_i + 1
            continue
        val node_replaced = replaced_media_bottom_edge_tag(html_nodes[node_index].tag)
        val widget_baseline = inline_widget_baseline_from_top(
            child_index, html_nodes, styles, node_index, bh
        )
        var node_ascent = if widget_baseline >= 0:
            margin_ts[baseline_i] + widget_baseline
        else:
            inline_line_baseline_ascent(
                child_index, node_index, node_style,
                margin_ts[baseline_i], margin_bs[baseline_i], bh, node_replaced
            )
        var node_descent = if widget_baseline >= 0:
            bh[node_index] - widget_baseline + margin_bs[baseline_i]
        elif bottom_edge_baseline(
            child_index, node_index, node_style, node_replaced
        ): 0 else: inline_line_baseline_descent(node_style)
        # A plain inline element reaches as far as the sub/super boxes nested
        # in it, and a sub/super element is itself moved off the baseline --
        # both have to fit in the line box, which grows to hold them.
        if widget_baseline < 0 and inline_box_is_plain_element(html_nodes[node_index], node_style):
            val node_line_shift = vertical_align_baseline_shift(node_style, line_style.font_size)
            node_ascent = inline_box_shifted_ascent(child_index, html_nodes, styles, node_index) - node_line_shift
            node_descent = inline_box_shifted_descent(child_index, html_nodes, styles, node_index) + node_line_shift
        if node_ascent > ascent:
            ascent = node_ascent
        if node_descent > descent:
            descent = node_descent
        baseline_i = baseline_i + 1
    # A `middle` margin box reaching past the strut and the baseline-aligned
    # boxes sets the line's ascent / descent at its own fraction. The baseline
    # every other box hangs from is that ascent snapped to a whole px; the
    # line height is the snapped sum (Chrome 159, 16px serif, `margin:5px 0`
    # on a 10 px box: ascent 14, descent 6.328, height 20.328 -> 20).
    var line_ascent64 = ascent * 64
    if middle_ascent64 > line_ascent64:
        line_ascent64 = middle_ascent64
        ascent = (middle_ascent64 + 32) / 64
    var line_descent64 = descent * 64
    if middle_descent64 > line_descent64:
        line_descent64 = middle_descent64
    var device_excess = 0
    if g_layout_device_scale > 1:
        device_excess = align_inline_line_device_dy(child_index, line_style, html_nodes, nodes, margin_ts, margin_bs, styles, bh, ascent, descent, any_valign, middle_ascent64, line_frac_milli, origin_frac_milli)
    var resolved_height = (line_ascent64 + line_descent64 + 32) / 64
    if line_height > resolved_height:
        resolved_height = line_height
    # A top-aligned box taller than the rest grows the line downwards; a
    # bottom-aligned one grows it upwards, which moves the baseline down.
    val baseline_set_height = resolved_height
    if top_margin_box_h > resolved_height:
        resolved_height = top_margin_box_h
    if bottom_margin_box_h > resolved_height:
        resolved_height = bottom_margin_box_h
    val baseline_drop = if bottom_margin_box_h > baseline_set_height: resolved_height - baseline_set_height else: 0
    val aligned_line_y = line_y + baseline_drop
    baseline_i = 0
    while baseline_i < nodes.len():
        val node_index = nodes[baseline_i]
        val node_valign = inline_atomic_valign(html_nodes[node_index], styles[node_index])
        if node_valign != "":
            # middle: the margin box's midpoint sits half an x-height above
            # the baseline; the fractional top is snapped half up, as Chrome
            # snaps the box when painting.
            val box_top = if node_valign == "middle":
                aligned_line_y + margin_ts[baseline_i] + _floor_div_i32(
                    line_ascent64 - middle_half_x64 - (margin_ts[baseline_i] + bh[node_index] + margin_bs[baseline_i]) * 32 + 32, 64
                )
            elif node_valign == "top":
                line_y + margin_ts[baseline_i]
            elif node_valign == "bottom":
                line_y + resolved_height - margin_bs[baseline_i] - bh[node_index]
            elif node_valign == "text-top":
                aligned_line_y + ascent - content_ascent + margin_ts[baseline_i]
            else:
                aligned_line_y + ascent + content_descent - margin_bs[baseline_i] - bh[node_index]
            val valign_shift = box_top - out_by[node_index]
            if valign_shift != 0:
                val shifted_valign = offset_layout_subtree(
                    child_index, node_index, 0, valign_shift, out_bx, out_by
                )
                out_bx = shifted_valign.bx
                out_by = shifted_valign.by
            baseline_i = baseline_i + 1
            continue
        val node_widget_baseline = inline_widget_baseline_from_top(
            child_index, html_nodes, styles, node_index, bh
        )
        val node_baseline_offset = if node_widget_baseline >= 0:
            node_widget_baseline
        else:
            inline_line_baseline_offset(
                child_index, node_index, styles[node_index],
                margin_bs[baseline_i], bh,
                replaced_media_bottom_edge_tag(html_nodes[node_index].tag)
            )
        # An inline non-replaced box sits on the line's BASELINE: its content
        # area top is the line ascent minus its own face ascent (a box taller
        # than its content area, padding, is centred on that). For the line's
        # own font that is the half-leading, line_y + (line_h - content_h)/2;
        # a smaller font sits lower than centred: Chrome 159 puts `<small>`
        # (13.33 px, ascent 12) in a 16px/1.5 Liberation Sans line (baseline
        # 17) at 5, a 12 px span at 6; centring gave 4 and 5. Every other
        # participant (inline-block, replaced,
        # sub/super) keeps the baseline placement computed above.
        # Only for a SINGLE-line run. This renderer models a wrapped #text as
        # one tall box rather than N line boxes, so on a wrapped run
        # `resolved_height` is N line-heights and centring in it would push the
        # element down by (N-1)/2 lines — measured 12 px too low on a 3-line
        # `<li>`. Those runs keep the existing top placement until wrapped text
        # is modelled as real line boxes.
        val node_is_half_leaded = (
            styles[node_index].display == "inline" and
            styles[node_index].vertical_align == "baseline" and
            not grid_item_is_replaced(html_nodes[node_index]) and
            bh[node_index] > 0 and bh[node_index] < resolved_height and
            resolved_height <= style_line_h(line_style)
        )
        # A bare #text run is painted from its box top, and its box is a whole
        # line-height tall (N line-heights when wrapped), so its glyphs need
        # the run's OWN half-leading below the strut placement -- the same
        # content-area offset an inline element gets above. Without it plain
        # words sat 3 px above <strong>/<em>/<code> words in one line, and
        # plain-text blocks 3-4 px above Chromium
        # (test/01_unit/browser_engine/inline_text_half_leading_spec.spl).
        # Not inside an inline element: that element's own half-leading shift
        # above already moves its text. A floated or absolutely positioned inline
        # element is the exception: it is blockified (CSS 2.2 9.7) and nothing
        # shifts it on a parent line, so its run takes the half-leading like a
        # block's. Chrome 159, `position:absolute` span, Liberation Serif 48px
        # (line 55, content area 53): `H` rows 12..43; without it 11..42.
        # An inline non-replaced ELEMENT needs the same offset whenever it
        # misses the centring branch above -- a line made taller than the
        # line-height by an atomic inline or a bigger font -- or it sits that
        # much above the bare run beside it.
        # FLOORED like the strut's (Blink FontHeight::AddLeading): Chrome 159
        # puts a 16px/1 Liberation Sans run (content area 17) at -1, baseline
        # 13; truncation left it at 0.
        val node_is_text_or_inline = (
            html_nodes[node_index].tag == "#text" or (
                styles[node_index].display == "inline" and
                not grid_item_is_replaced(html_nodes[node_index])
            )
        )
        val text_half_leading = if (
            node_is_text_or_inline and
            (line_style.display != "inline" or line_style.float_mode != 0 or line_style.position_absolute or line_style.position_fixed) and
            styles[node_index].vertical_align == "baseline" and
            bh[node_index] > 0
        ):
            _floor_div_i32(style_line_h(styles[node_index]) - inline_content_area_height(styles[node_index]), 2)
        else:
            0
        # A sub/super element hangs from the line's baseline by its shift; its
        # box is its content area, so the content-area ascent places the top.
        val node_baseline_shift = if inline_box_is_plain_element(html_nodes[node_index], styles[node_index]):
            vertical_align_baseline_shift(styles[node_index], line_style.font_size)
        else:
            0
        val shift_y = if node_baseline_shift != 0:
            aligned_line_y + ascent + node_baseline_shift - inline_content_area_ascent(styles[node_index]) - out_by[node_index]
        elif node_is_half_leaded:
            aligned_line_y + ascent - inline_content_area_ascent(styles[node_index]) - (bh[node_index] - inline_content_area_height(styles[node_index])) / 2 - out_by[node_index]
        else:
            aligned_line_y + ascent - node_baseline_offset - out_by[node_index] + text_half_leading
        if shift_y != 0:
            val shifted = offset_layout_subtree(
                child_index, node_index, 0, shift_y, out_bx, out_by
            )
            out_bx = shifted.bx
            out_by = shifted.by
        baseline_i = baseline_i + 1
    # The device excess holds only where the baseline pass set the height, and
    # only for a block container: an inline box keeps its whole CSS px height,
    # which the line around it aligns by (its device reach is read from its
    # struts there).
    val height_frac_milli = if line_style.display != "inline" and resolved_height == ascent + descent and middle_ascent64 == 0 and middle_descent64 == 0: device_excess * 1000 / g_layout_device_scale else: 0
    InlineLineAlignment(bx: out_bx, by: out_by, height: resolved_height, height_frac_milli: height_frac_milli)

fn block_bottom_margin_collapses_through(nodes: [HNode], styles: [Style], i: i32, st: Style) -> bool:
    val node = nodes[i]
    # CSS 2.2 8.3.1: a block's bottom margin collapses with the bottom margin
    # of its last in-flow child when nothing establishes a bottom edge between
    # them -- no bottom padding, no bottom border, and no height/clamp/overflow
    # that would close the box. Chrome measures an <li><p>text</p></li> at the
    # <p>'s height; Simple measured it 16 px taller because the <p>'s bottom
    # margin was added to the <li>'s content height instead of collapsing out.
    # <body>/<html> are excluded: the document box owns page height here and
    # shrinking it moves nothing but the surface extent.
    if node.tag == "body" or node.tag == "html":
        return false
    if st.display != "block" and st.display != "list-item":
        return false
    if st.position_absolute or st.position_fixed:
        return false
    if st.float_mode != 0:
        return false
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return false
    if st.pad_b != 0 or st.border_b != 0:
        return false
    if st.height_px != 0 or st.min_height_px > 0 or st.max_height_px > 0:
        return false
    if st.min_height_vh or st.flex_fill:
        return false
    if node.has_widget_panel_class:
        return false
    # Flex and grid ITEMS are independent formatting contexts too (Flexbox 4,
    # Grid 6): margins never collapse through them, and the containing flex
    # row sizes itself from the item's outer height. Chrome measures the item
    # in `<div style="display:flex"><div id="f"><p>t</p></div></div>` at
    # 56 px; letting the 16 px escape would shrink the row with it.
    val parent = nodes[i].parent
    if parent >= 0:
        val pdisp = styles[parent].display
        if pdisp == "flex" or pdisp == "inline-flex" or pdisp == "grid" or pdisp == "inline-grid":
            return false
    true

fn block_top_margin_collapses_through(nodes: [HNode], styles: [Style], i: i32, st: Style) -> bool:
    # Mirror of block_bottom_margin_collapses_through for the TOP edge: a
    # block's top margin collapses with its first in-flow child's top margin
    # when nothing separates them. The exclusion set is deliberately the same
    # one the bottom half uses (documents, non-block display, out-of-flow,
    # floats, BFC roots, widget panels, flex/grid items) so the two halves
    # cannot disagree about which boxes are formatting-context roots. The
    # height clamps are kept in the exclusion set too: CSS lets a top margin
    # escape a fixed-height block, but admitting that here would move boxes
    # the bottom half still holds in place, so it stays conservative and the
    # remaining case is recorded rather than guessed at.
    if node_tag_is_document(nodes[i]):
        return false
    if st.display != "block" and st.display != "list-item":
        return false
    if st.position_absolute or st.position_fixed:
        return false
    if st.float_mode != 0:
        return false
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return false
    if st.pad_t != 0 or st.border_t != 0:
        return false
    if st.height_px != 0 or st.min_height_px > 0 or st.max_height_px > 0:
        return false
    if st.min_height_vh or st.flex_fill:
        return false
    if nodes[i].has_widget_panel_class:
        return false
    val parent = nodes[i].parent
    if parent >= 0:
        val pdisp = styles[parent].display
        if pdisp == "flex" or pdisp == "inline-flex" or pdisp == "grid" or pdisp == "inline-grid":
            return false
    true

fn node_tag_is_document(node: HNode) -> bool:
    node.tag == "body" or node.tag == "html" or node.tag == "#root"

fn relative_layout_result(child_index: HtmlChildIndex, node_index: i32, st: Style, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32], height: i32) -> LayoutResult:
    if st.position_relative and (st.left_px != 0 or st.top_px != 0):
        val shifted = offset_layout_subtree(child_index, node_index, st.left_px, st.top_px, bx, by)
        return LayoutResult(bx: shifted.bx, by: shifted.by, bw: bw, bh: bh, wrap_starts: wrap_starts, wrap_ends: wrap_ends, intrinsic_widths: intrinsic_widths, height: height)
    LayoutResult(bx: bx, by: by, bw: bw, bh: bh, wrap_starts: wrap_starts, wrap_ends: wrap_ends, intrinsic_widths: intrinsic_widths, height: height)

class TextWrapCache:
    starts: [[i32]]
    ends: [[i32]]
    # See LayoutResult.first_line_dx.
    first_line_dx: [i32] = []
    # See LayoutResult.line_boxes.
    line_boxes: [[i32]] = []

# Content area of an inline box = the face's rounded ascent + descent (Chrome 159:
# 17px for Liberation Serif 16px, where the estimate below gives 18).
# reason: a pixel height in the layout tables' own i32 units
# @allow(primitive_api)
pub fn inline_content_area_height(st: Style) -> i32:
    val ad = style_face_ascent_descent(st)
    if ad.len() == 2 and ad[0] > 0:
        return ad[0] + ad[1]
    var h = if style_font_is_monospace(st):
        st.font_size * 19 / 16
    else:
        st.font_size * 9 / 8
    if h < 1:
        h = 1
    h

# Used thickness of a text-decoration rule. `text_decoration_thickness_px` is
# the authored length; 0 means `auto`/`from-font`, which Chrome 131 resolves
# to round(0.0733em) with a 1px floor (16px -> 1, 24px -> 2). The framebuffer
# painter and the Draw IR producer both call this so they cannot disagree.
fn style_decoration_thickness_px(st: Style) -> i32:
    if st.text_decoration_thickness_px > 0:
        return st.text_decoration_thickness_px
    val auto_px = (st.font_size * 733 + 5000) / 10000
    if auto_px < 1: 1 else: auto_px

# [ascent, descent] of the style's face in whole px, or [] without a measured face.
fn style_face_ascent_descent(st: Style) -> [i32]:
    browser_face_ascent_descent_milli_px(st.font_family, st.bold, st.font_style_italic, font_milli_of(st.font_size, st.font_size_milli))

fn style_baseline_offset(st: Style) -> i32:
    val ad = style_face_ascent_descent(st)
    if ad.len() == 2 and ad[0] > 0:
        return ad[0]
    var baseline = st.font_size * 7 / 8
    if baseline < 1:
        baseline = 1
    baseline

fn effective_item_align(parent: Style, child: Style) -> text:
    if child.align_self.len() > 0 and child.align_self != "auto":
        return child.align_self
    parent.align_items

fn replaced_default_box_h(tag: text) -> i32:
    """UA default BORDER-BOX height matching `replaced_default_box_w`.

    CSS 2.1 §10.6.2 fallback is 150px. `<audio controls>` is the one exception
    measured against Chrome 152: the control strip is 54px tall.
    """
    if tag == "audio":
        return 54
    if replaced_default_box_w(tag) > 0:
        return 150
    0

# Width Chrome's UA reserves inside a <select> beside its widest option label
# (inner start padding plus the drop-down arrow). Chrome 159: an EMPTY select
# is exactly 20 px + its padding + its border, with the UA box (22) and with
# the catalog's `padding:8px;border:1px` (38) alike, and every labelled select
# measured is `ceil(label) + 20` on top of that. It was 22 while it was fitted
# on ONE label: the extra 2 px was text under-measure (13 px instead of the
# UA's 13.3333 px, rounded instead of ceiled), not arrow.
pub val SELECT_ARROW_WIDTH_PX: i32 = 20

# Block padding Chrome's menulist puts INSIDE a <select>'s content box, above
# and below its one line (1 px each): the UA select is 19 px tall on a 15 px
# line with a 1 px border, 21 at 16 px, 40 at 32 px.
pub val SELECT_INNER_BLOCK_PADDING_PX: i32 = 2
# Finer oversample for the fractional (milli-px) label width: 1/36 px steps at
# the UA 13.333 px font keep a four-button row within Chrome's edge rounding
# (1/30 px steps drifted a fifth button's left edge over the .5 boundary).
val FORM_CONTROL_MILLI_OVERSAMPLE: i32 = 12

fn form_control_label_width_milli_px(st: Style, label: text) -> i32:
    """Width of one control label in milli-px (1/1000 px), NOT rounded up:
    the fractional width Chrome keeps in LayoutUnit (1/64 px steps). Falls back to the whole
    -pixel `form_control_label_width_px` times 1000 where no real-size
    measurement exists."""
    if label.len() == 0:
        return 0
    if st.resolved_font_identity == "" or st.resolved_font_width <= 0:
        return form_control_label_width_px(st, label) * 1000
    var num = st.font_size
    var den = 1
    if st.font_size == FORM_CONTROL_UA_FONT_TRUNCATED_PX:
        num = FORM_CONTROL_UA_FONT_NUM
        den = FORM_CONTROL_UA_FONT_DEN
    var over = FORM_CONTROL_MILLI_OVERSAMPLE
    if num * over > FORM_CONTROL_MEASURE_MAX_PX:
        over = FORM_CONTROL_MEASURE_MAX_PX / num
    if over < 1:
        return st.resolved_font_width * 1000
    val family = browser_font_family_for_style(st.font_family, st.bold, st.font_style_italic)
    val metrics = resolve_font_metrics_with_language(family, label, num * over, "")
    if not metrics.valid or metrics.width <= 0:
        return st.resolved_font_width * 1000
    val scale = den * over
    # Floor to Chrome's LayoutUnit (1/64 px), then to milli-px. Flooring (not
    # rounding) offsets the small upward bias of the oversampled measurement.
    ((metrics.width * 64) / scale) * 1000 / 64

fn form_control_widest_option_label_px(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, select_i: i32) -> i32:
    """Widest `<option>` label of a `<select>`, including options nested in an
    `<optgroup>`, each measured at the real control font size."""
    var widest = 0
    var c = child_index.first_child[select_i]
    while c >= 0:  # cpu-lane-loop-ok: one pass over a select's own option children during its intrinsic sizing; bound is that child list
        if nodes[c].tag == "optgroup":
            val nested = form_control_widest_option_label_px(nodes, styles, child_index, c)
            if nested > widest:
                widest = nested
        elif nodes[c].tag == "option":
            val label_w = form_control_text_children_label_px(nodes, styles, child_index, c)
            if label_w > widest:
                widest = label_w
        c = child_index.next_sibling[c]
    widest

fn form_control_button_frac_delta_milli_px(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, button_i: i32) -> i32:
    """How far a `<button>`'s fractional label width (milli-px) sits below the
    whole-pixel width the intrinsic sizing used (`form_control_button_label_correction_px`
    rounds each label UP). 0 or negative. A flex row accumulates this so item
    edges follow Chrome's LayoutUnit positions instead of drifting right."""
    var delta = 0
    var t = child_index.first_child[button_i]
    while t >= 0:  # cpu-lane-loop-ok: one pass over one button's direct children; bound is that child list
        if nodes[t].tag == "#text" and styles[t].resolved_font_width > 0:
            val real_w = form_control_label_width_px(styles[t], nodes[t].text_trimmed)
            val used_w = if real_w > styles[t].resolved_font_width: real_w else: styles[t].resolved_font_width
            delta = delta + form_control_label_width_milli_px(styles[t], nodes[t].text_trimmed) - used_w * 1000
        t = child_index.next_sibling[t]
    delta

# A max-content text width as Chrome 159 stores it: the exact advance sum
# rounded UP to a LayoutUnit (1/64 px, `LayoutUnit::FromFloatCeil`), back in
# milli-px (rounded up). `HTML` at 16px DejaVu Sans is 43.5547 px exact and
# 43.5625 (2788/64) in Chrome; six such items in a row sum to 357.5, not 357.498.
fn layout_unit_ceil_milli(milli: i64) -> i64:
    val w64 = (milli * 64 + 999) / 1000
    (w64 * 1000 + 63) / 64

# reason: node indices and whole-px / milli-px widths are layout-array scalars.
# @allow(primitive_api)
pub fn flex_item_text_frac_delta_milli_px(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, item: i32, st: Style, intrinsic_w: i32) -> i32:
    """How far the exact (milli-px) max-content width of an auto-width flex
    item sits from the whole-px `intrinsic_w` the row sized it with, when the
    item's content is one text run: Chrome 159 keeps `HTML` at 43.5625 px in
    a row of text items, so the next item starts at 43.5625 and `CSS Paint`
    (73.8125) ends at 117, not 118. 0 for any other content."""
    var run = -1
    var c = child_index.first_child[item]
    while c >= 0:  # cpu-lane-loop-ok: one pass over one flex item's direct children; bound is that child list
        if nodes[c].tag != "#text":
            return 0
        if nodes[c].text_trimmed.len() > 0:
            if run >= 0:
                return 0
            run = c
        c = child_index.next_sibling[c]
    if run < 0:
        return 0
    val rst = styles[run]
    if rst.resolved_font_width_milli < 0 or intrinsic_w != rst.resolved_font_width + st.pad_l + st.pad_r + st.border_l + st.border_r:
        return 0
    val frac = layout_unit_ceil_milli(rst.resolved_font_width_milli) - (rst.resolved_font_width as i64) * 1000
    if frac > 500 or frac < -500: 0 else: frac as i32

# reason: node index, run text and whole-px / milli-px widths are layout scalars.
# @allow(primitive_api)
pub fn text_run_exact_width_milli_px(nodes: [HNode], run: i32, st: Style, txt: text, whole_px: i32) -> i32:
    """Exact width of the text run `run` in milli-px, as the flex row that
    sized its parent measured it: a `<button>` label at the control's real
    font, any other run from its resolved milli width; `whole_px` x 1000 when
    the style carries no exact width."""
    val parent = nodes[run].parent
    if parent >= 0 and nodes[parent].tag == "button":
        return form_control_label_width_milli_px(st, txt)
    if st.resolved_font_width_milli >= 0 and whole_px == st.resolved_font_width:
        return layout_unit_ceil_milli(st.resolved_font_width_milli) as i32
    whole_px * 1000

# Inline-start inset of a <select>'s label inside its content box: the 20 px
# interior is 4 px of start padding and a 16 px arrow column. Chrome 159 paints
# `Alpha` 13 px in from the border edge of a `padding:8px;border:1px` select.
pub val SELECT_LABEL_INLINE_START_PX: i32 = 4

fn form_control_baseline_from_top(node: HNode, st: Style, h: i32) -> i32:
    """Distance from a form control's border-box top to its baseline, or -1
    when `node` is not a control this rule covers.

    A text `<input>` or `<select>` aligns on its INNER text baseline: border +
    padding + the leading that centres its one line in the content box + that
    line's own baseline. Hanging the control from a font strut at its top edge
    instead put every padded control 6 px below the top of its line. Checkbox
    and radio align on their bottom border edge and `<textarea>` on its bottom
    edge (Chrome 159: a 13x13 checkbox sits 4 px into a 24 px line; a 48 px
    textarea makes its label 55 = 48 + the line's descent)."""
    if node.tag == "textarea":
        return h
    if node.tag == "input":
        val input_type = attr_value(node.attrs_raw, "type").trim().lower()
        if input_type == "checkbox" or input_type == "radio":
            return h
    elif node.tag != "select":
        return -1
    val line = style_line_h(st)
    var lead = (h - st.border_t - st.border_b - st.pad_t - st.pad_b - line) / 2
    if lead < 0:
        lead = 0
    st.border_t + st.pad_t + lead + inline_line_strut_baseline_offset(st)

fn inline_widget_baseline_from_top(child_index: HtmlChildIndex, html_nodes: [HNode], styles: [Style], node_index: i32, bh: [i32]) -> i32:
    """Baseline of an inline widget measured from its border-box top, or -1.

    A `<button>` is an inline-block: its baseline is the baseline of its LAST
    line of label text (Chrome 159: a three-line 51 px button sits at the top
    of a 52 px line), the label block being centred in the content box. An
    empty button aligns on the bottom of its content box. Every other control
    goes through `form_control_baseline_from_top`."""
    val node = html_nodes[node_index]
    val st = styles[node_index]
    val h = bh[node_index]
    if node.tag != "button":
        return form_control_baseline_from_top(node, st, h)
    if st.display != "inline-block" and st.display != "inline" and st.display != "inline-flex" and st.display != "inline-grid":
        return -1
    if child_index.first_child[node_index] < 0:
        return h - st.border_b - st.pad_b
    val line = style_line_h(st)
    val descent = line - inline_line_strut_baseline_offset(st)
    if st.height_px <= 0 and st.min_height_px <= 0 and st.max_height_px <= 0:
        # Auto height: the content fills the content box, so the last line
        # ends at its bottom whatever the content is -- a direct text label,
        # a label inside `<b>`, several lines after a `<br>`, or an image
        # (whose bottom edge is that line's baseline, with the strut's
        # descent below it).
        return h - st.border_b - st.pad_b - descent
    # An explicit height (or a min- / max-height clamp) no longer equals the
    # content: the label block is centred in the content box, or overflows
    # it from the top.
    var label = child_index.first_child[node_index]
    while label >= 0 and html_nodes[label].tag != "#text":
        label = child_index.next_sibling[label]
    var label_h = if label >= 0: bh[label] else: line
    if label_h < line:
        label_h = line
    var lead = (h - st.border_t - st.border_b - st.pad_t - st.pad_b - label_h) / 2
    if lead < 0:
        lead = 0
    st.border_t + st.pad_t + lead + (label_h - line) + inline_line_strut_baseline_offset(st)

fn replaced_auto_box_h(node: HNode, st: Style, box_w: i32) -> i32:
    """BORDER-BOX height of a replaced element whose CSS height is auto, given
    its used border-box width; the height twin of `replaced_auto_box_w`. An
    `<svg>` with a valid viewBox follows its ratio from the content width;
    nothing else scales (Chrome 159: `<video width=120>` is 120x150)."""
    val attr_h = parse_int(attr_value(node.attrs_raw, "height"))
    if attr_h > 0 and not attr_value(node.attrs_raw, "height").trim().ends_with("%"):
        return attr_h
    val inset_y = st.pad_t + st.pad_b + st.border_t + st.border_b
    if node.tag == "svg":
        val view_box = svg_ratio_view_box_milli(node.attrs_raw)
        if view_box.len() == 4:
            var content_w = box_w - st.pad_l - st.pad_r - st.border_l - st.border_r
            if content_w < 0:
                content_w = 0
            return svg_ratio_scaled_px(content_w, view_box[3], view_box[2]) + inset_y
    val default_h = replaced_default_box_h(node.tag)
    if replaced_default_is_content_size(node.tag):
        return default_h + inset_y
    default_h

fn form_control_rows(node: HNode) -> i32:
    """Visible text rows of a <textarea>: its `rows` attribute, else the HTML
    default of 2 (HTML §4.10.11 — Chrome's textarea is two rows tall)."""
    val attr_rows = parse_int(attr_value(node.attrs_raw, "rows"))
    if attr_rows > 0:
        return attr_rows
    2

fn flex_ordered_children(styles: [Style], child_index: HtmlChildIndex, parent_i: i32) -> [i32]:
    val child_count = child_index.child_count[parent_i]
    if child_count <= 0:
        return []
    var out: [i32] = [0; child_count]
    var c = child_index.first_child[parent_i]
    var out_len = 0
    var sorted = true
    var last_order = 0
    while c >= 0:
        # A display:none child (whitespace-only text included) is no flex item.
        if styles[c].display == "none":
            c = child_index.next_sibling[c]
            continue
        val current_order = styles[c].order
        if out_len > 0 and current_order < last_order:
            sorted = false
        last_order = current_order
        out[out_len] = c
        out_len = out_len + 1
        c = child_index.next_sibling[c]
    if out_len < child_count:
        out = i32_list_prefix(out, out_len)
    if sorted:
        return out
    _sort_style_order_indices(out, out_len, styles)

class RowFlexDistribution:
    start_offset: i32
    gap_extra: i32
    auto_margin: i32

fn row_flex_distribution(
    free_space: i32, item_count: i32, auto_margin_count: i32,
    justify_content: text
) -> RowFlexDistribution:
    var start_offset = 0
    var gap_extra = 0
    var auto_margin = 0
    if free_space > 0 and auto_margin_count > 0:
        auto_margin = free_space / auto_margin_count
    elif free_space > 0:
        if justify_content == "space-between" and item_count > 1:
            gap_extra = free_space / (item_count - 1)
        elif justify_content == "space-around" and item_count > 0:
            start_offset = free_space / (item_count * 2)
            gap_extra = free_space / item_count
        elif justify_content == "space-evenly" and item_count > 0:
            start_offset = free_space / (item_count + 1)
            gap_extra = free_space / (item_count + 1)
        elif (
            justify_content == "center" or
            justify_content == "safe-center" or
            justify_content == "unsafe-center"
        ):
            start_offset = free_space / 2
        elif justify_content == "flex-end" or justify_content == "end":
            start_offset = free_space
    RowFlexDistribution(
        start_offset: start_offset,
        gap_extra: gap_extra,
        auto_margin: auto_margin
    )

fn row_flex_main_reversed(st: Style) -> bool:
    st.direction_rtl != (st.flex_direction == "row-reverse")

fn flex_item_outer_height(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return constrained_outer_height(node, st, st.height_px)
        return constrained_outer_height(node, st, st.height_px + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

