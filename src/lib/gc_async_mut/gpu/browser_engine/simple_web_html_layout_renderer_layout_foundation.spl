export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_primitives.*
use std.gc_async_mut.gpu.browser_engine.layout_table.{
    simple_web_collect_table_rows, simple_web_fixed_table_cell_span,
    simple_web_fixed_table_column_count, table_distribute_auto_columns
}
use std.gc_async_mut.gpu.browser_engine.containment.{contain_value_contains_layout}
use std.gc_async_mut.gpu.browser_engine.layout_m14_types.{collapse_margins_signed}
# Text is measured by CODEPOINT, never by UTF-8 byte length. `text.len()` is a
# BYTE count while `char_code_at(i)` is CODEPOINT indexed, so the old
# `while i < raw.len(): raw.char_code_at(i)` shape charged "漢" three advances
# and then measured two phantom zero-codepoints on top. The codepoint decode
# and the wide/zero-width column policy live in one shared leaf; this lane
# consumes it rather than keeping a private copy.
# See doc/08_tracking/bug/live_lane_inline_text_measure_counts_utf8_bytes_2026-08-11.md
use std.common.layout.text_metrics.{codepoint_cells, text_cell_width}
use std.common.encoding.utf8.{text_codepoints}

val SIMPLE_WEB_SUMMARY_MARKER_INLINE_WIDTH: i32 = 16

# Bounded collapsed-border style precedence, from lowest to highest.
# An empty style is the same as an absent/none edge. Unknown styles fail the
# bounded admission instead of silently selecting the wrong border.
fn simple_web_collapsed_border_style_rank(style: text) -> i32:
    val normalized = style.trim().lower()
    if normalized == "" or normalized == "none":
        return 0
    if normalized == "inset":
        return 1
    if normalized == "groove":
        return 2
    if normalized == "outset":
        return 3
    if normalized == "ridge":
        return 4
    if normalized == "dotted":
        return 5
    if normalized == "dashed":
        return 6
    if normalized == "solid":
        return 7
    if normalized == "double":
        return 8
    if normalized == "hidden":
        return 9
    -1

fn simple_web_collapsed_left_edge_wins(
    left_style: text, left_width: i32,
    right_style: text, right_width: i32
) -> bool:
    val left_rank = simple_web_collapsed_border_style_rank(left_style)
    val right_rank = simple_web_collapsed_border_style_rank(right_style)
    # hidden suppresses every competing border.
    if left_rank == 9:
        return true
    if right_rank == 9:
        return false
    # none/absent loses to a present style.
    if left_rank != right_rank and (left_rank == 0 or right_rank == 0):
        return left_rank > right_rank
    if left_width != right_width:
        return left_width > right_width
    if left_rank != right_rank:
        return left_rank > right_rank
    # The admitted slice is LTR, so the earlier (left) cell wins an exact tie.
    true

# Bounded CSS border-collapse slice: resolve only adjacent direct table-cell
# edges in one LTR row. Wider spans, vertical conflicts, row spans, and RTL
# origin precedence remain outside this admission.
fn simple_web_resolve_collapsed_table_borders(
    nodes: [HNode], child_index: HtmlChildIndex, styles: [Style]
) -> [Style]:
    var resolved = styles
    var table = 0
    while table < nodes.len():
        if (
            resolved[table].display == "table" and
            resolved[table].border_collapse == "collapse"
        ):
            val rows = simple_web_collect_table_rows(
                nodes, child_index, table
            )
            var bounded = (
                rows.rows.len() == 1 and
                not resolved[table].direction_rtl
            )
            for row in rows.rows:
                if (
                    resolved[row].display != "table-row" or
                    resolved[row].direction_rtl
                ):
                    bounded = false
                var direct_cell_count = 0
                var first_cell = -1
                var second_cell = -1
                var bounded_cell = child_index.first_child[row]
                while bounded_cell >= 0:
                    if resolved[bounded_cell].display == "table-cell":
                        direct_cell_count = direct_cell_count + 1
                        if direct_cell_count == 1:
                            first_cell = bounded_cell
                        elif direct_cell_count == 2:
                            second_cell = bounded_cell
                        if (
                            attr_value(
                                nodes[bounded_cell].attrs_raw, "colspan"
                            ) != "" or
                            attr_value(
                                nodes[bounded_cell].attrs_raw, "rowspan"
                            ) != ""
                        ):
                            bounded = false
                    bounded_cell = child_index.next_sibling[bounded_cell]
                if direct_cell_count != 2:
                    bounded = false
                elif (
                    resolved[first_cell].direction_rtl or
                    resolved[second_cell].direction_rtl or
                    simple_web_collapsed_border_style_rank(
                        resolved[first_cell].border_style_r
                    ) < 0 or
                    simple_web_collapsed_border_style_rank(
                        resolved[second_cell].border_style_l
                    ) < 0
                ):
                    bounded = false
            if not bounded:
                table = table + 1
                continue
            resolved[table].border_spacing_x_px = 0
            resolved[table].border_spacing_y_px = 0
            for row in rows.rows:
                var previous = -1
                var cell = child_index.first_child[row]
                while cell >= 0:
                    if resolved[cell].display == "table-cell":
                        if previous >= 0:
                            var left = resolved[previous]
                            var right = resolved[cell]
                            if simple_web_collapsed_left_edge_wins(
                                left.border_style_r, left.border_r,
                                right.border_style_l, right.border_l
                            ):
                                right.border_l = 0
                                right.border_color_l = 0u32
                            else:
                                left.border_r = 0
                                left.border_color_r = 0u32
                            resolved[previous] = left
                            resolved[cell] = right
                        previous = cell
                    cell = child_index.next_sibling[cell]
        table = table + 1
    resolved

class LayoutResult:
    bx: [i32]
    by: [i32]
    bw: [i32]
    bh: [i32]
    wrap_starts: [[i32]]
    wrap_ends: [[i32]]
    intrinsic_widths: [i32]
    height: i32
    # CSS 2.2 8.3.1: the bottom margin of a block's LAST in-flow child
    # collapses THROUGH the block when the block has no bottom padding,
    # no bottom border, and no height that would establish a bottom edge.
    # The margin is then the block's own trailing margin for the parent's
    # sibling collapsing -- it must not be added to the block's height.
    # Without this an <li> wrapping a <p> was 16 px taller than Chrome.
    trailing_margin_b: i32 = 0
    # CSS 2.2 8.3.1, the symmetric half: the top margin of a block's FIRST
    # in-flow child collapses THROUGH the block when the block has no top
    # padding, no top border, and nothing else that would establish a top
    # edge. The margin is then the block's own LEADING margin and must be
    # collapsed with the block's declared margin-top by the block's parent
    # instead of being added to the block's height. Without this
    # `<div><p>t</p></div>` measured 40 px where Chrome measures 24.
    leading_margin_t: i32 = 0

class LayoutSelectedResult:
    layout: LayoutResult
    fault: text

class PositionOffsetResult:
    bx: [i32]
    by: [i32]

fn offset_layout_subtree(child_index: HtmlChildIndex, node_index: i32, dx: i32, dy: i32, bx: [i32], by: [i32]) -> PositionOffsetResult:
    var out_bx = bx
    var out_by = by
    out_bx[node_index] = out_bx[node_index] + dx
    out_by[node_index] = out_by[node_index] + dy
    var child = child_index.first_child[node_index]
    while child >= 0:
        val shifted = offset_layout_subtree(child_index, child, dx, dy, out_bx, out_by)
        out_bx = shifted.bx
        out_by = shifted.by
        child = child_index.next_sibling[child]
    PositionOffsetResult(bx: out_bx, by: out_by)

fn rtl_row_flex_item_offset(
    child_index: HtmlChildIndex, node_index: i32,
    content_x: i32, content_w: i32,
    margin_l: i32, margin_r: i32,
    st: Style, bx: [i32], by: [i32], bw: [i32]
) -> PositionOffsetResult:
    # Row layout is measured once in logical order from the left. For RTL,
    # reflect each occupied margin box around the content box, then translate
    # the complete item subtree. Physical left/right margins remain physical;
    # DOM/order sorting is deliberately unchanged.
    val relative_x = if st.position_relative: st.left_px else: 0
    val normal_x = bx[node_index] - relative_x
    val mirrored_x = (
        content_x + content_w - (normal_x - content_x) - bw[node_index] +
        margin_l - margin_r + relative_x
    )
    offset_layout_subtree(
        child_index, node_index, mirrored_x - bx[node_index], 0, bx, by
    )

class InlineLineAlignment:
    bx: [i32]
    by: [i32]
    height: i32

fn inline_line_strut_baseline_offset(st: Style) -> i32:
    val half_leading = (style_line_h(st) - st.font_size) / 2
    half_leading + style_baseline_offset(st)

# CSS 2.1 §10.8.1: "the baseline of an inline, non-replaced element is the
# baseline of its font; the baseline of an inline REPLACED element is the
# bottom margin edge". An empty inline-block already followed the bottom-edge
# rule (§10.8.1's "if it has no in-flow line boxes" clause) and the two cases
# are the same arithmetic, so `bottom_edge_baseline` selects between them.
# Round 19 added the replaced arm: it is what puts Chrome's canvas/svg/audio/
# video on one shared baseline at y=335 on the `animation` catalog page instead
# of hanging each one from the font strut.
#
# The rule is scoped to REPLACED MEDIA, not to every tag in
# `grid_item_is_replaced`. Form controls are in that set too, and this engine
# currently gives `input` and `select` `display:inline`, so an unscoped
# predicate caught them — measured: it took `form_control_widget_box_spec`'s
# `<label>Choice <select>…` from 33 px to 39. A form control's baseline is its
# INNER TEXT baseline (Chrome reports these four as `inline-block` in the first
# place, per the round-19 census), which the font strut already models, so they
# keep the strut path until someone measures the inner-text case properly.
fn replaced_media_bottom_edge_tag(tag: text) -> bool:
    (
        tag == "img" or tag == "svg" or tag == "video" or tag == "audio" or
        tag == "canvas" or tag == "iframe" or tag == "embed" or
        tag == "object"
    )

fn bottom_edge_baseline(child_index: HtmlChildIndex, node_index: i32, st: Style, replaced_media: bool) -> bool:
    if replaced_media and st.display == "inline":
        return true
    st.display == "inline-block" and child_index.child_count[node_index] == 0

fn inline_line_baseline_ascent(child_index: HtmlChildIndex, node_index: i32, st: Style, margin_t: i32, margin_b: i32, bh: [i32], replaced: bool) -> i32:
    if bottom_edge_baseline(child_index, node_index, st, replaced):
        return margin_t + bh[node_index] + margin_b
    inline_line_strut_baseline_offset(st)

fn inline_line_baseline_offset(child_index: HtmlChildIndex, node_index: i32, st: Style, margin_b: i32, bh: [i32], replaced: bool) -> i32:
    if bottom_edge_baseline(child_index, node_index, st, replaced):
        return bh[node_index] + margin_b
    inline_line_strut_baseline_offset(st)

fn inline_line_baseline_descent(st: Style) -> i32:
    style_line_h(st) - inline_line_strut_baseline_offset(st)

fn align_inline_line_baselines(child_index: HtmlChildIndex, line_style: Style, html_nodes: [HNode], nodes: [i32], margin_ts: [i32], margin_bs: [i32], styles: [Style], line_y: i32, line_height: i32, bx: [i32], by: [i32], bh: [i32]) -> InlineLineAlignment:
    var out_bx = bx
    var out_by = by
    if nodes.len() == 0:
        return InlineLineAlignment(
            bx: out_bx, by: out_by, height: line_height
        )
    var ascent = inline_line_strut_baseline_offset(line_style)
    var descent = inline_line_baseline_descent(line_style)
    var baseline_i = 0
    while baseline_i < nodes.len():
        val node_index = nodes[baseline_i]
        val node_style = styles[node_index]
        val node_replaced = replaced_media_bottom_edge_tag(html_nodes[node_index].tag)
        val node_ascent = inline_line_baseline_ascent(
            child_index, node_index, node_style,
            margin_ts[baseline_i], margin_bs[baseline_i], bh, node_replaced
        )
        val node_descent = if bottom_edge_baseline(
            child_index, node_index, node_style, node_replaced
        ): 0 else: inline_line_baseline_descent(node_style)
        if node_ascent > ascent:
            ascent = node_ascent
        if node_descent > descent:
            descent = node_descent
        baseline_i = baseline_i + 1
    var resolved_height = ascent + descent
    if line_height > resolved_height:
        resolved_height = line_height
    baseline_i = 0
    while baseline_i < nodes.len():
        val node_index = nodes[baseline_i]
        val node_baseline_offset = inline_line_baseline_offset(
            child_index, node_index, styles[node_index],
            margin_bs[baseline_i], bh,
            replaced_media_bottom_edge_tag(html_nodes[node_index].tag)
        )
        # An inline non-replaced box sits in the line box by HALF-LEADING: its
        # content area is centred, so its top is line_y + (line_h - content_h)/2
        # rather than line_y. Every other participant (inline-block, replaced,
        # sub/super) keeps the baseline placement computed above.
        # Only for a SINGLE-line run. This renderer models a wrapped #text as
        # one tall box rather than N line boxes, so on a wrapped run
        # `resolved_height` is N line-heights and centring in it would push the
        # element down by (N-1)/2 lines — measured 12 px too low on a 3-line
        # `<li>`. Those runs keep the existing top placement until wrapped text
        # is modelled as real line boxes.
        val node_is_half_leaded = (
            styles[node_index].display == "inline" and
            styles[node_index].vertical_align == "baseline" and
            not grid_item_is_replaced(html_nodes[node_index]) and
            bh[node_index] > 0 and bh[node_index] < resolved_height and
            resolved_height <= style_line_h(line_style)
        )
        val shift_y = if node_is_half_leaded:
            line_y + (resolved_height - bh[node_index]) / 2 - out_by[node_index]
        else:
            line_y + ascent - node_baseline_offset - out_by[node_index]
        if shift_y != 0:
            val shifted = offset_layout_subtree(
                child_index, node_index, 0, shift_y, out_bx, out_by
            )
            out_bx = shifted.bx
            out_by = shifted.by
        baseline_i = baseline_i + 1
    InlineLineAlignment(bx: out_bx, by: out_by, height: resolved_height)

fn block_bottom_margin_collapses_through(nodes: [HNode], styles: [Style], i: i32, st: Style) -> bool:
    val node = nodes[i]
    # CSS 2.2 8.3.1: a block's bottom margin collapses with the bottom margin
    # of its last in-flow child when nothing establishes a bottom edge between
    # them -- no bottom padding, no bottom border, and no height/clamp/overflow
    # that would close the box. Chrome measures an <li><p>text</p></li> at the
    # <p>'s height; Simple measured it 16 px taller because the <p>'s bottom
    # margin was added to the <li>'s content height instead of collapsing out.
    # <body>/<html> are excluded: the document box owns page height here and
    # shrinking it moves nothing but the surface extent.
    if node.tag == "body" or node.tag == "html":
        return false
    if st.display != "block" and st.display != "list-item":
        return false
    if st.position_absolute or st.position_fixed:
        return false
    if st.float_mode != 0:
        return false
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return false
    if st.pad_b != 0 or st.border_b != 0:
        return false
    if st.height_px != 0 or st.min_height_px != 0 or st.max_height_px != 0:
        return false
    if st.min_height_vh or st.flex_fill:
        return false
    if node.has_widget_panel_class:
        return false
    # Flex and grid ITEMS are independent formatting contexts too (Flexbox 4,
    # Grid 6): margins never collapse through them, and the containing flex
    # row sizes itself from the item's outer height. Chrome measures the item
    # in `<div style="display:flex"><div id="f"><p>t</p></div></div>` at
    # 56 px; letting the 16 px escape would shrink the row with it.
    val parent = nodes[i].parent
    if parent >= 0:
        val pdisp = styles[parent].display
        if pdisp == "flex" or pdisp == "inline-flex" or pdisp == "grid" or pdisp == "inline-grid":
            return false
    true

fn block_top_margin_collapses_through(nodes: [HNode], styles: [Style], i: i32, st: Style) -> bool:
    # Mirror of block_bottom_margin_collapses_through for the TOP edge: a
    # block's top margin collapses with its first in-flow child's top margin
    # when nothing separates them. The exclusion set is deliberately the same
    # one the bottom half uses (documents, non-block display, out-of-flow,
    # floats, BFC roots, widget panels, flex/grid items) so the two halves
    # cannot disagree about which boxes are formatting-context roots. The
    # height clamps are kept in the exclusion set too: CSS lets a top margin
    # escape a fixed-height block, but admitting that here would move boxes
    # the bottom half still holds in place, so it stays conservative and the
    # remaining case is recorded rather than guessed at.
    if node_tag_is_document(nodes[i]):
        return false
    if st.display != "block" and st.display != "list-item":
        return false
    if st.position_absolute or st.position_fixed:
        return false
    if st.float_mode != 0:
        return false
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return false
    if st.pad_t != 0 or st.border_t != 0:
        return false
    if st.height_px != 0 or st.min_height_px != 0 or st.max_height_px != 0:
        return false
    if st.min_height_vh or st.flex_fill:
        return false
    if nodes[i].has_widget_panel_class:
        return false
    val parent = nodes[i].parent
    if parent >= 0:
        val pdisp = styles[parent].display
        if pdisp == "flex" or pdisp == "inline-flex" or pdisp == "grid" or pdisp == "inline-grid":
            return false
    true

fn node_tag_is_document(node: HNode) -> bool:
    node.tag == "body" or node.tag == "html" or node.tag == "#root"

fn relative_layout_result(child_index: HtmlChildIndex, node_index: i32, st: Style, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32], height: i32) -> LayoutResult:
    if st.position_relative and (st.left_px != 0 or st.top_px != 0):
        val shifted = offset_layout_subtree(child_index, node_index, st.left_px, st.top_px, bx, by)
        return LayoutResult(bx: shifted.bx, by: shifted.by, bw: bw, bh: bh, wrap_starts: wrap_starts, wrap_ends: wrap_ends, intrinsic_widths: intrinsic_widths, height: height)
    LayoutResult(bx: bx, by: by, bw: bw, bh: bh, wrap_starts: wrap_starts, wrap_ends: wrap_ends, intrinsic_widths: intrinsic_widths, height: height)

class TextWrapCache:
    starts: [[i32]]
    ends: [[i32]]

class IntrinsicWidthResult:
    width: i32
    widths: [i32]

class LineWrapRanges:
    starts: [i32]
    ends: [i32]

fn char_w(fs: i32) -> i32:
    if fs <= 8:
        return 4
    6 * glyph_scale(fs)

fn text_advance(fs: i32) -> i32:
    if fs <= 8:
        return 4
    5 * glyph_scale(fs)

fn style_char_w(st: Style) -> i32:
    var out = char_w(st.font_size) + st.letter_spacing_px
    if out < 1:
        out = 1
    out

fn style_text_advance(st: Style) -> i32:
    var out = text_advance(st.font_size) + st.letter_spacing_px
    if out < 1:
        out = 1
    out

fn style_space_advance(st: Style) -> i32:
    var out = style_text_advance(st) / 2 + st.word_spacing_px
    if out < 1:
        out = 1
    out

fn line_h(fs: i32) -> i32:
    9 * glyph_scale(fs)

fn style_line_h(st: Style) -> i32:
    if st.line_height_px > 0:
        return st.line_height_px
    if st.line_height_px < 0:
        # negative sentinel = unitless line-height multiplier * 10 (e.g. 1.6 -> -16),
        # resolved here against the element's final font-size.
        val lh = st.font_size * (0 - st.line_height_px) / 10
        if lh > 0:
            return lh
    if st.resolved_font_line_height > 0:
        return st.resolved_font_line_height
    line_h(st.font_size)

# --- ONE advance table, shared by layout and paint -------------------------
#
# Round 4 made LAYOUT size an inline run from the resolved per-glyph metrics
# while PAINT kept stepping glyphs by the flat `style_text_advance` estimate
# (`fb_text_thin_scaled_clip_range`'s `advance`/`space_advance` arguments), and
# the aligned line width (`style_text_line_advance_width`) used a THIRD rule:
# it indexed `resolved_font_advances` with BYTE offsets as if bytes and
# codepoints were the same thing. A centred or right-aligned run was therefore
# positioned from real metrics and then drawn with wider flat advances, so its
# glyphs walked out of the box the layout had sized. That is the `forms-media`
# pixel regression recorded in
# doc/08_tracking/bug/web_forms_media_pixel_regression_layout_paint_advance_disagree_2026-09-12.md.
#
# `style_run_byte_advances` is the single source of truth that closes it: one
# advance per BYTE of the string that is actually painted, carrying the
# codepoint's measured advance on its lead byte and 0 on every UTF-8
# continuation byte (which draw no glyph). Summing it over a byte range gives
# the same number the paint loop walks, by construction. It returns an EMPTY
# array whenever the measured metrics do not describe this exact string
# (no resolved face, or an arity mismatch) so both sides fall back to the flat
# estimate TOGETHER rather than one side at a time.
fn _lay_style_run_byte_advances_inner(st: Style, s: text) -> [i32]:
    var out: [i32] = []
    if st.resolved_font_identity == "" or st.resolved_font_width <= 0:
        return out
    val cps = text_codepoints(s)
    val adv = st.resolved_font_advances
    if adv.len() != cps.len() or adv.len() == 0:
        return out
    # Expand codepoint -> bytes from the CODEPOINT VALUES, not by classifying
    # `char_code_at` results as lead/continuation bytes. `char_code_at` decodes
    # — it never answers a value in 128..191 — so the byte classifier could
    # never recognise a continuation byte, over-ran `adv` on the first
    # multi-byte codepoint and returned an EMPTY table. That made this whole
    # helper dead on exactly the runs it exists for (any `&mdash;`, accent or
    # `×`), silently sending both wrap and paint back to the flat estimate.
    var i = 0
    val cn = cps.len()
    while i < cn:
        out.push(adv[i])
        var k = 1
        val w = utf8_encoded_len(cps[i])
        while k < w:
            out.push(0)
            k = k + 1
        i = i + 1
    # Fail closed: if the expansion does not describe this exact string, both
    # sides must fall back together rather than one at a time.
    if out.len() != s.len():
        return []
    out

# Number of UTF-8 bytes a codepoint occupies.
pub fn utf8_encoded_len(cp: i64) -> i32:
    if cp < 0x80:
        return 1
    if cp < 0x800:
        return 2
    if cp < 0x10000:
        return 3
    4

# First byte offset strictly after `start` that begins a codepoint. Used by the
# wrap loops for the degenerate "not even one glyph fits" step, so that forcing
# progress never splits a multi-byte codepoint across two lines.
#
# Reads `s.bytes()`, like `skip_wrap_spaces`, and NOT `char_code_at`: this
# renderer's text API is mixed — `len()` and `substring` are BYTE-indexed while
# `char_code_at`/`char_at` are CODEPOINT-indexed — so a byte offset handed to
# `char_code_at` silently reads the wrong character on any non-ASCII run.
pub fn next_codepoint_start(s: text, start: i32) -> i32:
    val n = s.len() as i32
    val b = s.bytes()
    var i = start + 1
    while i < n:
        if b[i] < 128 or b[i] >= 192:
            return i
        i = i + 1
    n

fn byte_advances_range_width(by: [i32], start: i32, endv: i32) -> i32:
    var width = 0
    var i = start
    while i < endv:
        width = width + by[i]
        i = i + 1
    width

# Line width from an already-built byte-advance table (the paint loop builds it
# once per text node and hands the SAME array to the width call and to the
# glyph stepper).
fn style_text_line_advance_width_with(by: [i32], txt: text, start: i32, endv: i32, advance: i32, space_advance: i32) -> i32:
    if by.len() == txt.len() and start >= 0 and endv <= by.len():
        return byte_advances_range_width(by, start, endv)
    text_line_advance_width(txt, start, endv, advance, space_advance)

# Height of the CONTENT AREA of an inline non-replaced box: the font's own
# ascent+descent, NOT the line-height. CSS 2.1 SS10.6.1 — `line-height` sizes
# the LINE box; the inline box inside it is the content area, centred in the
# line by half-leading. Simple used to give an inline element the whole
# line-height and place it at the line's top edge, which is why every
# `<strong>`/`<em>/<code>/<a>` in the catalog measured 6 px too tall and 3-4 px
# too high against Chrome (measured: Chrome `<strong>` y=195 h=18 inside a
# y=192 h=24 line; Simple gave y=192 h=24 for the same element).
#
# 9/8 of the font size (18 px at 16 px) is the normal-metrics approximation this
# renderer already uses elsewhere for vertical font geometry. That is the SANS
# stack's number. Chrome measures 19 px, not 18, for the monospace `<code>`
# stack at the same 16 px — the note here already said so, and the code never
# implemented the second half of its own sentence. Measured against headless
# Chrome (round 10, fixture in doc/10_metrics/ui/web_chrome_parity_round10_
# 2026-09-13.md): `<code>` h=19 vs `<span>` h=18 at font-size 16. So the
# monospace content area is 19/16 of the font size. A real per-family
# ascent+descent would need font metrics this layout path does not carry; these
# two ratios are what Chrome reports for the two stacks the catalog uses.
#
# The family substring list mirrors `browser_font_candidates_for_family`
# (font_provider.spl) and `_resolved_font_category_uncached` (font_renderer.spl)
# exactly — three lists that disagree is how `system-ui` ended up resolving to a
# serif face, so this one is kept identical to them rather than "close enough".
fn style_font_is_monospace(st: Style) -> bool:
    val fam = st.font_family.lower()
    (
        fam.contains("mono") or fam.contains("courier") or
        fam.contains("code") or fam.contains("console")
    )

fn inline_content_area_height(st: Style) -> i32:
    var h = if style_font_is_monospace(st):
        st.font_size * 19 / 16
    else:
        st.font_size * 9 / 8
    if h < 1:
        h = 1
    h

fn style_baseline_offset(st: Style) -> i32:
    var baseline = st.font_size * 7 / 8
    if baseline < 1:
        baseline = 1
    baseline

fn effective_item_align(parent: Style, child: Style) -> text:
    if child.align_self.len() > 0 and child.align_self != "auto":
        return child.align_self
    parent.align_items

fn grid_item_is_replaced(node: HNode) -> bool:
    val tag = node.tag
    (
        tag == "audio" or tag == "button" or tag == "canvas" or
        tag == "embed" or tag == "iframe" or tag == "img" or
        tag == "input" or tag == "meter" or tag == "object" or
        tag == "progress" or tag == "select" or tag == "textarea" or
        tag == "video" or tag == "svg"
    )

fn replaced_default_box_w(tag: text) -> i32:
    """UA default BORDER-BOX width for a replaced element that has no intrinsic
    media size, or 0 for a tag that is not sized this way.

    CSS 2.1 §10.3.2 gives a replaced element with no intrinsic width and no
    specified width a used width of 300px. Chrome's `<audio controls>` widget
    is 300px wide by the same rule; its height is the widget default (below),
    not the §10.6.2 fallback. `<img>` and `<input>` are deliberately absent:
    they are sized from real intrinsic/UA metrics further down this function's
    caller, and giving them a 300px default would be a regression.
    """
    if tag == "iframe" or tag == "video" or tag == "canvas" or tag == "embed" or tag == "object" or tag == "audio":
        return 300
    0

fn replaced_default_box_h(tag: text) -> i32:
    """UA default BORDER-BOX height matching `replaced_default_box_w`.

    CSS 2.1 §10.6.2 fallback is 150px. `<audio controls>` is the one exception
    measured against Chrome 152: the control strip is 54px tall.
    """
    if tag == "audio":
        return 54
    if replaced_default_box_w(tag) > 0:
        return 150
    0

# Width Chrome's UA reserves for a <select>'s drop-down arrow, on top of the
# widest option label. Derived against Chrome 152 on the catalog's forms-media
# page: Chrome's select border box is 73 px there, and this engine's
# max-content width for the same `<option>` set (label + the select's own
# padding 16 and border 2) is 51, so the arrow region is 22.
val SELECT_ARROW_WIDTH_PX: i32 = 22

# Per-column advance and content-box intercept Chrome's UA uses to turn a text
# control's `size`/`cols` attribute into an intrinsic CONTENT width. These are
# NOT this engine's text metrics: `style_char_w` is the 6 px bitmap cell the
# glyph rasteriser draws into, and using it here is what made every sized
# control too narrow (measured: `<input size=20>` 138 px against Chrome's 163).
#
# A control's width is NOT `columns x text advance`. Chrome adds a fixed
# font-derived intercept on top of the per-column term, so dividing a single
# measured width by its `size` recovers neither number. Both were fitted
# against Chrome 152 at the UA control font size (13.3333 px), on sizes
# 1,2,3,4,5,6,10,20,40, on two independent pages (the catalog's forms-media,
# whose author CSS adds 18 px of padding+border, and a bare page with the UA's
# own 8 px) -- the CONTENT width agreed at 145 px on both, which is what makes
# these content-box numbers rather than a fit to one page's padding:
#
#   <input size=N>     content = N * 7 + 5      exact on every size measured
#   <textarea cols=N>  content = N * 8 + 17     exact at 10/20/30, 1 px at 40
#
# The two differ because Chrome gives them different UA fonts -- `input` is
# proportional (Arial), `textarea` is monospace, whose '0' advance is 8.0253 --
# and because a textarea reserves a ~15 px vertical scrollbar gutter, which is
# the bulk of its larger intercept.
#
# Scaled by `glyph_scale` so a control at another font size stays consistent
# with the rest of this engine's metrics; `glyph_scale` is 1 at the UA control
# size, so the measured numbers above are reproduced exactly.
val INPUT_COL_ADVANCE_PX: i32 = 7
val INPUT_CONTENT_INTERCEPT_PX: i32 = 5
val TEXTAREA_COL_ADVANCE_PX: i32 = 8
val TEXTAREA_CONTENT_INTERCEPT_PX: i32 = 17

fn form_control_intrinsic_content_w(node: HNode, st: Style, cols: i32) -> i32:
    """Content-box width Chrome's UA gives a text control from its `size` /
    `cols` attribute: a per-column advance plus a fixed font-derived
    intercept. `<textarea>` and `<input>` carry different UA fonts and a
    different intercept, so they are separate arms rather than one formula."""
    val scale = glyph_scale(st.font_size)
    if node.tag == "textarea":
        return cols * TEXTAREA_COL_ADVANCE_PX * scale + TEXTAREA_CONTENT_INTERCEPT_PX * scale
    cols * INPUT_COL_ADVANCE_PX * scale + INPUT_CONTENT_INTERCEPT_PX * scale

fn form_control_rows(node: HNode) -> i32:
    """Visible text rows of a <textarea>: its `rows` attribute, else the HTML
    default of 2 (HTML §4.10.11 — Chrome's textarea is two rows tall)."""
    val attr_rows = parse_int(attr_value(node.attrs_raw, "rows"))
    if attr_rows > 0:
        return attr_rows
    2

fn form_control_cols(node: HNode) -> i32:
    """Visible character columns of a text control: `size` for <input>, `cols`
    for <textarea>, else the HTML default of 20 for both."""
    val attr_name = if node.tag == "textarea": "cols" else: "size"
    val attr_cols = parse_int(attr_value(node.attrs_raw, attr_name))
    if attr_cols > 0:
        return attr_cols
    20

fn flex_ordered_children(styles: [Style], child_index: HtmlChildIndex, parent_i: i32) -> [i32]:
    val child_count = child_index.child_count[parent_i]
    if child_count <= 0:
        return []
    var out: [i32] = [0; child_count]
    var c = child_index.first_child[parent_i]
    var out_len = 0
    var sorted = true
    var last_order = 0
    while c >= 0:
        val current_order = styles[c].order
        if out_len > 0 and current_order < last_order:
            sorted = false
        last_order = current_order
        out[out_len] = c
        out_len = out_len + 1
        c = child_index.next_sibling[c]
    if sorted:
        return out
    _sort_style_order_indices(out, out_len, styles)

class RowFlexDistribution:
    start_offset: i32
    gap_extra: i32
    auto_margin: i32

fn row_flex_distribution(
    free_space: i32, item_count: i32, auto_margin_count: i32,
    justify_content: text
) -> RowFlexDistribution:
    var start_offset = 0
    var gap_extra = 0
    var auto_margin = 0
    if free_space > 0 and auto_margin_count > 0:
        auto_margin = free_space / auto_margin_count
    elif free_space > 0:
        if justify_content == "space-between" and item_count > 1:
            gap_extra = free_space / (item_count - 1)
        elif justify_content == "space-around" and item_count > 0:
            start_offset = free_space / (item_count * 2)
            gap_extra = free_space / item_count
        elif justify_content == "space-evenly" and item_count > 0:
            start_offset = free_space / (item_count + 1)
            gap_extra = free_space / (item_count + 1)
        elif (
            justify_content == "center" or
            justify_content == "safe-center" or
            justify_content == "unsafe-center"
        ):
            start_offset = free_space / 2
        elif justify_content == "flex-end" or justify_content == "end":
            start_offset = free_space
    RowFlexDistribution(
        start_offset: start_offset,
        gap_extra: gap_extra,
        auto_margin: auto_margin
    )

fn row_flex_main_reversed(st: Style) -> bool:
    st.direction_rtl != (st.flex_direction == "row-reverse")

fn flex_item_outer_height(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return constrained_outer_height(node, st, st.height_px)
        return constrained_outer_height(node, st, st.height_px + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

