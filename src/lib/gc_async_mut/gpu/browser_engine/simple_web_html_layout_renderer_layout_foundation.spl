fn style_with_width(st: Style, width_px: i32) -> Style:
    val out = style_with_width_without_height_metadata(st, width_px)
    out.height_auto = st.height_auto
    out.left_auto = st.left_auto
    out.top_auto = st.top_auto
    out.align_items_authored = st.align_items_authored
    out.scrollbar_width_none = st.scrollbar_width_none
    out.display_inline_flex_authored = st.display_inline_flex_authored
    out.contain_size = st.contain_size
    out.contain_intrinsic_w_px = st.contain_intrinsic_w_px
    out.contain_intrinsic_h_px = st.contain_intrinsic_h_px
    out

# Width an inline replaced box (img/svg/video/input/...) will take on its
# line: its CSS width, else its `width` attribute, else the UA default box,
# clamped by min/max-width. 0 for anything that is not an inline replaced box.
fn inline_replaced_predicted_width(node: HNode, st: Style) -> i32:
    if st.display != "inline" or not grid_item_is_replaced(node):
        return 0
    if st.width_px > 0:
        return css_outer_width(node, st, st.width_px)
    if st.width_px < 0:
        return 0
    val attr_w = parse_int(attr_value(node.attrs_raw, "width"))
    if attr_w <= 0 and node.tag == "svg" and svg_ratio_view_box_milli(node.attrs_raw).len() == 4:
        # An svg with a ratio and no width contributes its height-derived
        # width, or nothing: `replaced_auto_box_w` with no available width.
        return constrained_outer_width(node, st, replaced_auto_box_w(node, st, 0))
    constrained_outer_width(
        node, st, if attr_w > 0: attr_w else: replaced_default_box_w(node.tag)
    )

# Extra width an inline box needs, beyond its intrinsic width, for the
# IN-FLOW `<svg>`s it holds (through inline boxes only) that have a viewBox
# ratio and no size. Such an svg contributes 0 to the intrinsic width but
# fills the line's available width up to its min/max-width (Chrome 159:
# `<span>a<svg viewBox="0 0 24 24"></svg>b</span>` in 900 px holds a 900x900
# svg; with `max-width:24px` the svg is 24x24 and the span 41.8). A floated
# or absolutely positioned svg is out of flow and adds nothing.
fn inline_box_ratio_only_svg_fill_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, available_w: i32) -> i32:
    var extra = 0
    var c = child_index.first_child[i]
    while c >= 0:
        val cst = styles[c]
        if cst.display == "inline" and nodes[c].tag != "#text":
            if nodes[c].tag == "svg":
                if (
                    cst.width_px == 0 and cst.float_mode == 0 and
                    not cst.position_absolute and not cst.position_fixed and
                    parse_int(attr_value(nodes[c].attrs_raw, "width")) <= 0 and
                    replaced_specified_box_h(cst) == 0 and
                    svg_ratio_view_box_milli(nodes[c].attrs_raw).len() == 4
                ):
                    extra = extra + constrained_outer_width(
                        nodes[c], cst, replaced_auto_box_w(nodes[c], cst, available_w)
                    ) - constrained_outer_width(
                        nodes[c], cst, replaced_auto_box_w(nodes[c], cst, 0)
                    )
            elif child_index.first_child[c] >= 0:
                extra = extra + inline_box_ratio_only_svg_fill_w(nodes, styles, child_index, c, available_w)
        c = child_index.next_sibling[c]
    extra

fn _lay_intrinsic_text_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, widths: [i32]) -> IntrinsicWidthResult:
    if widths[i] >= 0:
        return IntrinsicWidthResult(width: widths[i], widths: widths)
    var out_widths = widths
    var width = 0
    # One collapsed space separates two inline items when the white space
    # between them survives collapsing (`ab <img> ef`): it sits at neither
    # line edge, so it has an advance. `gap_pending` remembers that the
    # content so far ENDED in such a space; a run that STARTS with one after
    # earlier content charges it directly. Chrome 159: `<legend>ab
    # <code>cd</code> ef</legend>` is 63 px, and 54 without the two spaces.
    var gap_pending = false
    var c = child_index.first_child[i]
    while c >= 0:
        if nodes[c].tag == "#text":
            val txt: text = nodes[c].text_trimmed
            if txt.len() > 0:
                if width > 0 and (gap_pending or text_starts_with_collapsible_space(nodes[c].text_data)) and not styles[c].white_space_nowrap:
                    width = width + resolved_space_advance(styles[c], text_codepoints(txt))
                gap_pending = text_ends_with_collapsible_space(nodes[c].text_data) and not styles[c].white_space_nowrap
                val resolved = styles[c].resolved_font_width
                if resolved > 0:
                    width = width + resolved
                else:
                    val glyph_w = style_char_w(styles[c])
                    val ink_w = if glyph_w > 1: glyph_w - 1 else: glyph_w
                    # CELL width, not byte length: a CJK glyph is drawn double
                    # width and is charged exactly two cells, and a combining
                    # mark is charged none.
                    width = width + (text_cell_width(txt) as i32) * ink_w
        elif (
            styles[c].display == "inline" or
            styles[c].display == "inline-block"
        ):
            val child = intrinsic_text_width(nodes, styles, child_index, c, out_widths)
            out_widths = child.widths
            # An inline REPLACED child is as wide as its own box, which the
            # text walk never sees (it has no text). Chrome 159:
            # `<legend>ab <img width=40> ef</legend>` is 84 px; Simple
            # measured 35 and wrapped the image onto its own line.
            var child_w = child.width
            # ... unless it is out of flow inside an inline box: a floated or
            # absolutely positioned box never widens the span around it
            # (Chrome 159: `<span>a<canvas style="position:absolute">
            # </canvas>b</span>` is 17.8 px wide).
            val out_of_flow_in_span = styles[i].display == "inline" and (
                styles[c].float_mode != 0 or styles[c].position_absolute or
                styles[c].position_fixed
            )
            val replaced_w = if out_of_flow_in_span: 0 else: inline_replaced_predicted_width(nodes[c], styles[c])
            if replaced_w > child_w:
                child_w = replaced_w
            if child_w > 0:
                if gap_pending and width > 0:
                    width = width + style_space_advance(styles[i])
                gap_pending = false
            width = width + child_w
        c = child_index.next_sibling[c]
    if nodes[i].tag != "#text":
        width = width + styles[i].pad_l + styles[i].pad_r + styles[i].border_l + styles[i].border_r
    if nodes[i].tag == "button":
        # The label is painted at the truncated 13 px control size but Chrome
        # sizes the button from it at 13.3333 px.
        width = width + form_control_button_label_correction_px(nodes, styles, child_index, i)
    out_widths[i] = width
    IntrinsicWidthResult(width: width, widths: out_widths)

# Max-content width of a flex item, used as its flex base size when it has
# neither `flex-basis` nor a `width` (CSS: `flex-basis: content`).
#
# `intrinsic_text_width` above cannot serve here: it descends only into inline
# and inline-block children, so a block container such as `<ol>` measures as
# nothing but its own padding. This walks EVERY in-flow child — inline children
# accumulate along the current line, each block child starts a new one — and the
# widest line wins, which is the max-content rule.
fn _lay_flex_item_max_content_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32) -> i32:
    var inline_run = 0
    var widest = 0
    var c = child_index.first_child[i]
    while c >= 0:  # cpu-lane-loop-ok: one pass over this item's children during flex base sizing, bounded by the child list, not on any paint path
        val cst = styles[c]
        val ctag = nodes[c].tag
        if ctag == "#text":
            val txt: text = nodes[c].text_trimmed
            if txt.len() > 0:
                val resolved = cst.resolved_font_width
                if resolved > 0:
                    inline_run = inline_run + resolved
                else:
                    val glyph_w = style_char_w(cst)
                    val ink_w = if glyph_w > 1: glyph_w - 1 else: glyph_w
                    inline_run = inline_run + (text_cell_width(txt) as i32) * ink_w
        elif cst.display != "none" and cst.display != "marker":
            val child_w = if cst.width_px > 0:
                cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r
            else:
                flex_item_max_content_width(nodes, styles, child_index, c)
            if cst.display == "inline" or cst.display == "inline-block":
                inline_run = inline_run + child_w
            else:
                if inline_run > widest:
                    widest = inline_run
                inline_run = 0
                if child_w > widest:
                    widest = child_w
        c = child_index.next_sibling[c]
    if inline_run > widest:
        widest = inline_run
    if nodes[i].tag == "button":
        # Same real-size label rule as `intrinsic_text_width`, for a button
        # that is a flex / grid / table-cell item.
        widest = widest + form_control_button_label_correction_px(nodes, styles, child_index, i)
    widest + styles[i].pad_l + styles[i].pad_r + styles[i].border_l + styles[i].border_r

# Max-content width of a table CELL — CSS 2.1 §17.5.2.2's per-cell input to
# automatic column sizing. It is the same measurement a flex item's
# `flex-basis: content` needs (widest line over every in-flow child, inline
# children accumulating along the line), so it delegates rather than growing a
# second copy that would drift from it.
fn _lay_table_cell_max_content_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    val w = flex_item_max_content_width(nodes, styles, child_index, cell)
    if w < 1: 1 else: w

# Min-content width of one text run: its longest unbreakable word. Character
# counting rather than `text_cell_width` is deliberate and approximate — a word
# is measured in glyph cells, which is the same unit the max-content walk uses
# for its per-character advance, so the two stay on one scale.
fn _table_text_min_content_width(txt: text, cst: Style) -> i32:
    val glyph_w = style_char_w(cst)
    val ink_w = if glyph_w > 1: glyph_w - 1 else: glyph_w
    var longest = 0
    var cur = 0
    # `txt.len()` is a BYTE count and `char_at` is CODEPOINT-indexed, so the
    # old single cursor read past the end of a non-ASCII cell and counted each
    # multi-byte character several times, over-sizing the column. `cur` counts
    # CHARACTERS (it is multiplied by a per-glyph width below), so step by
    # codepoint and test the word break on the BYTE.
    val tb = txt.bytes()
    val nb = txt.byte_len()
    var i = 0
    while i < nb:  # cpu-lane-loop-ok: one pass over a cell's text during table column sizing, not on any paint path
        val b = tb[i]
        if b == 32 or b == 9 or b == 10:
            cur = 0
        else:
            cur = cur + 1
            if cur > longest:
                longest = cur
        i = next_codepoint_start(txt, i)
    longest * ink_w

# Min-content width of a table CELL — the other half of CSS 2.1 §17.5.2.2's
# per-cell input. Without it a column has no floor, so a table that does not
# fit its containing block has nothing to compress toward and simply overflows.
fn _lay_table_cell_min_content_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    var widest = 0
    var c = child_index.first_child[cell]
    while c >= 0:  # cpu-lane-loop-ok: one pass over this cell's children during table column sizing
        val cst = styles[c]
        if nodes[c].tag == "#text":
            val w = _table_text_min_content_width(nodes[c].text_trimmed, cst)
            if w > widest:
                widest = w
        elif cst.display != "none" and cst.display != "marker":
            val child_w = if cst.width_px > 0:
                cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r
            else:
                table_cell_min_content_width(nodes, styles, child_index, c)
            if child_w > widest:
                widest = child_w
        c = child_index.next_sibling[c]
    val st = styles[cell]
    val out = widest + st.pad_l + st.pad_r + st.border_l + st.border_r
    if out < 1: 1 else: out

# Flex base size for ONE item of a wrapping row. Items that state a basis, a
# width, a percentage width (`width_px < 0`) or a non-zero `flex-grow` keep the
# width the caller computed; only an item that states nothing at all is sized to
# its max-content width, capped at the container's inner width.
#
# Without this, such an item was given `iw` — the whole container — so every
# auto-width item wrapped onto a line of its own. The NON-wrapping branch of the
# same layout already measured its items; only the wrap branch did not. See
# doc/08_tracking/bug/web_flex_wrap_auto_width_item_fills_line_2026-09-12.md.
fn _lay_flex_wrap_auto_base_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, item: i32, cst: Style, iw: i32, caller_base_w: i32) -> i32:
    if cst.flex_basis_px > 0 or cst.width_px != 0 or cst.flex_grow != 0:
        return caller_base_w
    val max_content = flex_item_max_content_width(nodes, styles, child_index, item)
    if max_content <= 0 or max_content >= iw:
        return caller_base_w
    max_content

# Advance width of a WHOLE text run, in the face the metrics were measured with.
#
# `resolved_font_advances` carries one advance per CODEPOINT; `txt_len` and
# every wrap offset in this renderer are BYTE indices. On any non-ASCII run the
# two disagree, so the old per-codepoint range helper bailed out and the flat
# per-character estimate was compared against a `node_w` that had already been
# sized from the REAL measured width. A one-glyph em dash therefore "overflowed"
# its own box and wrapped to one line per BYTE: measured h=72 (3 lines) for
# `<div>&mdash;</div>` where Chrome reports 24, and the same for any run
# containing a single accented letter. That inflated every catalog `<li>` whose
# text carries an `&mdash;`.
fn _lay_style_measured_run_advance_inner(txt: text, txt_len: i32, st: Style) -> i32:
    if st.resolved_font_width > 0 and st.resolved_font_advances.len() == text_codepoints(txt).len():
        return st.resolved_font_width
    style_text_line_advance_width(txt, 0, txt_len, st, style_text_advance(st), style_space_advance(st))

fn codepoint_is_space(ch: i64) -> bool:
    ch == 32 or ch == 9 or ch == 10 or ch == 13

# True when normal white-space processing would collapse a leading run of
# white space in this raw text node. BYTE-indexed on purpose: every ASCII
# white-space byte is its own codepoint, and no UTF-8 continuation byte can
# equal one, so reading the first byte is exact and needs no decode.
pub fn text_starts_with_collapsible_space(raw: text) -> bool:
    if raw.len() == 0:
        return false
    val b = raw.bytes()[0]
    b == 32 or b == 9 or b == 10 or b == 13

# The trailing-edge twin of `text_starts_with_collapsible_space`.
pub fn text_ends_with_collapsible_space(raw: text) -> bool:
    val tb = raw.bytes()
    val n = tb.len()
    if n == 0:
        return false
    val b = tb[n - 1]
    b == 32 or b == 9 or b == 10 or b == 13

# Advance of ONE space in the face the resolved metrics were measured with.
# Prefer a real space advance out of the measured array; only when the measured
# string carries no space at all does the flat estimate stand in.
fn resolved_space_advance(st: Style, measured_cps: [i64]) -> i32:
    var i = 0
    val n = measured_cps.len()
    while i < n:
        # The table is in VISUAL order (reversed under direction:rtl, see the
        # metric-text resolve in ..._core.spl); `measured_cps` is logical.
        val ai = if st.direction_rtl: n - 1 - i else: i
        if measured_cps[i] == 32 and ai >= 0 and ai < st.resolved_font_advances.len():
            return st.resolved_font_advances[ai]
        i = i + 1
    style_space_advance(st)

fn _lay_inline_text_advance_width_inner(node: HNode, st: Style) -> i32:
    if node.tag != "#text":
        return 0
    val raw = node.text_data
    # `lay_cps` (round 13): this decode runs on EVERY call, including the ones
    # that then return `st.resolved_font_width` in O(1) from the arity check
    # below -- so if the inline bucket is dominated by it, the repeat is the
    # decode, not the measurement. Timed to decide that from data rather than
    # from code reading; default-off like every counter here.
    val _cps_t0 = if _wsc_on: _wsc_now_us() else: 0
    val cps = text_codepoints(raw)
    if _wsc_on:
        _wlay_add(9, _wsc_now_us() - _cps_t0, 1)
    # `resolved_font_advances` carries ONE advance per codepoint (see
    # font_renderer.measure_text_advances), so the arity check is against the
    # codepoint count. Comparing it against `raw.len()` matched only by
    # accident on ASCII and matched a byte-per-byte advance array on non-ASCII.
    if st.resolved_font_width > 0 and st.resolved_font_advances.len() == cps.len():
        return st.resolved_font_width
    # The metrics were measured over the TRIMMED text unless white-space:nowrap
    # (see the `metric_text` binding in ..._core.spl's style stage), so on any
    # run with leading/trailing whitespace — which is most prose, e.g.
    # `<p>Paragraph with <strong>` — the arity check above could never match and
    # the whole real-metrics path was dead. It fell back to the flat
    # `text_advance` below, which over-measured plain 16 px text by ~25 %
    # (Chrome 112 px for "Paragraph with ", Simple ~140 px) and, because the
    # over-wide runs wrap sooner, also inflated wrapped-block heights.
    # Charge the trimmed-off edge whitespace separately: CSS collapses a run of
    # white space to a single space, so at most one space per edge.
    val trimmed = node.text_trimmed
    if st.resolved_font_width > 0 and trimmed.len() > 0:
        val trimmed_cps = text_codepoints(trimmed)
        if st.resolved_font_advances.len() == trimmed_cps.len():
            var edges = 0
            if cps.len() > 0 and codepoint_is_space(cps[0]):
                edges = edges + 1
            if cps.len() > 1 and codepoint_is_space(cps[cps.len() - 1]):
                edges = edges + 1
            return st.resolved_font_width + edges * resolved_space_advance(st, trimmed_cps)
    if raw == " " and node.text_trimmed == "":
        var whitespace_advance = style_space_advance(st) / 3
        if whitespace_advance < 1:
            whitespace_advance = 1
        return whitespace_advance
    var width = 0
    var i = 0
    val n = cps.len()
    val advance = style_text_advance(st)
    val space_advance = style_space_advance(st)
    while i < n:
        val ch = cps[i]
        if ch == 32:
            width = width + space_advance
        elif ch == 9 or ch == 10 or ch == 13:
            if node.text_trimmed != "":
                width = width + space_advance
        else:
            width = width + (codepoint_cells(ch) as i32) * advance
        i = i + 1
    width

fn text_ink_y_offset(fs: i32) -> i32:
    val scale = web_glyph_scale(fs)
    if scale > 1:
        return scale + 1
    1

fn text_ink_x_offset(fs: i32) -> i32:
    1

# `off` and the returned offset are BYTE indices, but `cpl` is a CHARACTER
# budget (cells per line). Adding the two — and then probing with the
# CODEPOINT-indexed `char_code_at` — meant a non-ASCII run both got a short
# line (each multi-byte codepoint spent 2-3 of its character budget) and broke
# at the wrong place. Spend the budget one CODEPOINT at a time, and test for a
# space on the BYTE, which is exact: no continuation byte can equal 32.
pub fn web_wrap_line_end(txt: text, off: i32, cpl: i32) -> i32:
    val n = txt.byte_len()
    val tb = txt.bytes()
    var last_space = -1
    var i = off
    var taken = 0
    while i < n and taken < cpl:
        if tb[i] == 32:
            last_space = i
        i = next_codepoint_start(txt, i)
        taken = taken + 1
    if i >= n:
        return n
    if last_space > off:
        return last_space
    i

# `skip_wrap_spaces` now lives in ..._foundation.spl (reached here through the
# export chain). It was defined HERE but also called from ..._style.spl, which
# sits BELOW this module in the import order and therefore cannot see it. The
# interpreter's flat function registry resolved that anyway; HIR lowering did
# not, so the whole renderer module failed JIT compilation with
# "Unknown variable: skip_wrap_spaces while lowering parse_font_shorthand_family"
# and silently ran interpreted (~1000x slower).

# `start`/`endv` are BYTE offsets; `char_code_at` is CODEPOINT-indexed. Read
# with one cursor this charged one flat advance per BYTE, so a 3-byte em dash
# cost three glyph widths, and it read the wrong character to decide "is this a
# space". Walk the bytes and charge once per CODEPOINT — i.e. on a lead byte,
# never on a UTF-8 continuation byte (128..191).
pub fn text_line_advance_width(txt: text, start: i32, endv: i32, advance: i32, space_advance: i32) -> i32:
    val tb = txt.bytes()
    var width = 0
    var i = start
    while i < endv:
        if tb[i] < 128 or tb[i] >= 192:
            width = width + if tb[i] == 32: space_advance else: advance
        i = i + 1
    width

fn style_text_line_advance_width(txt: text, start: i32, endv: i32, st: Style, advance: i32, space_advance: i32) -> i32:
    style_text_line_advance_width_with(
        style_run_byte_advances(st, txt), txt, start, endv, advance, space_advance
    )

# A #text run whose color is fully transparent (alpha 0, e.g.
# `color: transparent`, the classic "text hidden behind a sprite" pattern)
# paints nothing (gap L, 2026-10-05). The glyph painters ignore color alpha, so
# both paint lanes skip the run here instead. A run with a text-shadow still
# paints as before (CSS draws the shadow of transparent text; not modelled).
fn html_text_paint_fully_transparent(nd: HNode, st: Style) -> bool:
    nd.tag == "#text" and (st.fg >> 24) == 0u32 and st.text_shadow_color == 0u32

fn text_line_aligned_x(base_x: i32, line_box_w: i32, line_w: i32, st: Style, line_i: i32, line_count: i32) -> i32:
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "start":
        align = if st.direction_rtl: "right" else: "left"
    elif align == "end":
        align = if st.direction_rtl: "left" else: "right"
    if align == "center":
        return base_x + (line_box_w - line_w) / 2
    if align == "right":
        return base_x + line_box_w - line_w
    base_x

fn text_line_needs_paint_width(st: Style, line_i: i32, line_count: i32) -> bool:
    if st.text_decoration_underline:
        return true
    var align = st.text_align
    if line_i == line_count - 1 and st.text_align_last != "auto":
        align = st.text_align_last
    if align == "center" or align == "right":
        return true
    if align == "start":
        return st.direction_rtl
    if align == "end":
        return not st.direction_rtl
    false

fn _lay_ellipsize_text_for_width_inner(txt: text, start: i32, endv: i32, max_width: i32, st: Style, advance: i32, space_advance: i32) -> text:
    if max_width <= 0:
        return ""
    val full_width = style_text_line_advance_width(txt, start, endv, st, advance, space_advance)
    if full_width <= max_width:
        return txt.substring(start, endv)
    val ellipsis = "..."
    val ellipsis_w = text_line_advance_width(ellipsis, 0, ellipsis.byte_len(), advance, space_advance)
    if max_width <= ellipsis_w:
        return ellipsis
    val content_limit = max_width - ellipsis_w
    # `start`/`endv` are BYTE offsets (they are cut on with `substring` just
    # above), so every step of this loop must be byte-indexed too. It used to
    # mix three index spaces at once: `resolved_text_range_width(st, i, i+1)`
    # indexed the per-CODEPOINT advance array with a byte offset, and
    # `char_code_at(i)` / `char_at(i)` are CODEPOINT-indexed in this text API.
    # On any run past its first non-ASCII codepoint all three disagreed, so an
    # ellipsized run was measured with one character's advance and built from a
    # different character. `style_run_byte_advances` is the per-BYTE table that
    # answers this exactly (the codepoint's advance on its lead byte, 0 on every
    # continuation byte), which also makes a cut inside a codepoint impossible.
    val by = style_run_byte_advances(st, txt)
    val txt_blen = txt.byte_len()
    val use_by = by.len() == txt_blen
    val tb = txt.bytes()
    var out = ""
    var used = 0
    var i = start
    while i < endv:
        val nexti = next_codepoint_start(txt, i)
        val char_w = if use_by: by[i] elif tb[i] == 32: space_advance else: advance
        if used + char_w > content_limit:
            break
        out = out + txt.substring(i, nexti)
        used = used + char_w
        i = nexti
    out + ellipsis

# First-line inset of wrapped `#text` runs that start mid-line (see
# LayoutResult.first_line_dx). `g_text_first_line_dx_pending` hands the inset
# from the inline run loop to the `#text` branch of `layout_with_style` for the
# one node laid out next; `g_text_first_line_dx` accumulates the per-node
# values for the layout pass and stays EMPTY until a run needs one, so a
# document without such a run pays nothing.
pub var g_text_first_line_dx_pending: i32 = 0
pub var g_text_first_line_dx: [i32] = []

fn text_first_line_dx_reset():
    g_text_first_line_dx_pending = 0
    g_text_first_line_dx = []

# Record node `i`'s inset. Called for EVERY `#text` placed by the inline run
# loop once the table exists, so a subtree that is laid out twice (flex/grid
# measuring passes) cannot leave a stale inset behind.
fn text_first_line_dx_record(node_count: i32, i: i32, dx: i32):
    if g_text_first_line_dx.len() == 0:
        if dx == 0:
            return
        g_text_first_line_dx = zero_i32_list(node_count)
    g_text_first_line_dx[i] = dx

# Inset of wrapped line `line` of `#text` node `i`. One table carries both
# models: a POSITIVE entry insets line 0 only (a run that starts mid-line); a
# NEGATIVE entry is `-(lines * 65536 + dx)` and insets the first `lines` lines
# by `dx` (lines a left float shortens, see `text_float_line_inset_code`).
# Every reader -- both painters and the geometry probe -- goes through here.
fn text_line_inset_at(table: [i32], i: i32, line: i32) -> i32:
    if i < 0 or i >= table.len():
        return 0
    val code = table[i]
    if code >= 0:
        return if line == 0: code else: 0
    val packed = 0 - code
    if line < packed / 65536: packed % 65536 else: 0

fn text_float_line_inset_code(lines: i32, dx: i32) -> i32:
    if lines <= 0 or dx <= 0 or dx >= 65536 or lines >= 32768:
        return 0
    0 - (lines * 65536 + dx)

fn text_first_line_dx_at(table: [i32], i: i32) -> i32:
    text_line_inset_at(table, i, 0)

# A run whose lines start at the line box's left edge: the only alignment for
# which the mid-line first-line inset is modelled. Centred / right-aligned /
# justified and RTL runs keep their existing placement.
fn text_run_aligns_line_left(st: Style) -> bool:
    if st.direction_rtl:
        return false
    if st.text_align == "center" or st.text_align == "right" or st.text_align == "end" or st.text_align == "justify":
        return false
    if st.text_align_last == "center" or st.text_align_last == "right" or st.text_align_last == "end" or st.text_align_last == "justify":
        return false
    true

# Advance of the LAST wrapped line of a run -- where the pen sits for the
# inline sibling that follows the run on that line.
fn text_last_line_advance(txt: text, st: Style, starts: [i32], ends: [i32]) -> i32:
    val n = starts.len()
    if n == 0:
        return 0
    style_text_line_advance_width_with(
        style_run_byte_advances(st, txt), txt, starts[n - 1], ends[n - 1],
        style_text_advance(st), style_space_advance(st)
    )

# Float-band-aware text wrap: lines whose index falls inside the band wrap to
# narrow_w; later lines wrap to full_w. Mirrors compute_style_wrap_ranges'
# font-advance path with a cell-width fallback.
fn compute_style_wrap_ranges_float_band(txt: text, full_w: i32, narrow_w: i32, narrow_lines: i32, st: Style) -> LineWrapRanges:
    val n = txt.byte_len()
    if n == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    # Byte-indexed advances, for the same reason as
    # `_lay_compute_style_wrap_ranges_inner`: `n` is a BYTE count and
    # `resolved_font_advances` is per CODEPOINT, so the old arity check sent
    # every non-ASCII run to the flat cell-width fallback.
    val by = style_run_byte_advances(st, txt)
    val tb = txt.bytes()
    val use_font = st.resolved_font_identity != "" and by.len() == n and full_w > 0 and narrow_w > 0
    val cw = style_char_w(st)
    var starts: [i32] = []
    var ends: [i32] = []
    var start = 0
    var line = 0
    while start < n:
        val max_width = if line < narrow_lines: narrow_w else: full_w
        var endv = start
        if use_font:
            var used = 0
            var last_space = -1
            while endv < n and used + by[endv] <= max_width:
                used = used + by[endv]
                if tb[endv] == 32:
                    last_space = endv
                endv = endv + 1
            if endv == start:
                endv = next_codepoint_start(txt, start)
            elif endv < n and last_space > start:
                endv = last_space
        else:
            var cpl = max_width / cw
            if cpl < 1:
                cpl = 1
            endv = web_wrap_line_end(txt, start, cpl)
            if endv <= start:
                endv = start + 1
        starts.push(start)
        ends.push(endv)
        start = skip_wrap_spaces(txt, endv)
        line = line + 1
    if starts.len() == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    LineWrapRanges(starts: starts, ends: ends)

fn _lay_compute_wrap_ranges_inner(txt: text, cpl: i32) -> LineWrapRanges:
    val txt_len = txt.byte_len()
    if txt_len == 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var line_count = 0
    var count_off = 0
    while count_off < txt_len:
        val endc = web_wrap_line_end(txt, count_off, cpl)
        line_count = line_count + 1
        count_off = skip_wrap_spaces(txt, endc)
    if line_count <= 0:
        return LineWrapRanges(starts: [0; 1], ends: [0; 1])
    var starts: [i32] = [0; line_count]
    var ends: [i32] = [0; line_count]
    var off = 0
    var line = 0
    while off < txt_len:
        val endc = web_wrap_line_end(txt, off, cpl)
        starts[line] = off
        ends[line] = endc
        off = skip_wrap_spaces(txt, endc)
        line = line + 1
    LineWrapRanges(starts: starts, ends: ends)

# `resolved_font_advances` carries ONE advance per CODEPOINT, while every wrap
# offset in this renderer is a BYTE index. Comparing its length against
# `txt.len()` (bytes) therefore matched only on pure-ASCII runs: a single em
# dash, accented letter or `×` made the arity check fail and dropped the whole
# wrap onto `compute_wrap_ranges`, the flat cells-per-line estimate
# (`style_char_w` = 12 px at 16 px against a real ~7.8 px average). The
# estimate is wide, so such a run wrapped one line too early and every
# following box inherited the 24 px step — measured as the accumulating
# vertical drift on `css-layout`/`css-paint`/`html`, all of whose catalog
# `<li>`s carry an `&mdash;`.
#
# `style_run_byte_advances` is the table that already answers this correctly:
# one advance per BYTE, carrying the codepoint's measured advance on its lead
# byte and 0 on every UTF-8 continuation byte. Indexing it with the byte
# offsets this loop already uses is exact, and a break can never land inside a
# codepoint — a continuation byte adds 0 and therefore always fits.
fn _lay_compute_style_wrap_ranges_inner(txt: text, max_width: i32, st: Style, fallback_cpl: i32) -> LineWrapRanges:
    _lay_compute_style_wrap_ranges_first_inner(txt, max_width, max_width, st, fallback_cpl)

# `first_width` is the width available to line 0 -- the remainder of a line
# box the run shares with the inline siblings before it. Every later line gets
# `max_width`, the whole line box (Chrome: `<li><code>x</code> long text</li>`
# continues at the li's content-left, not under the text's own start).
# The caller must have checked that the run has a per-byte advance table
# (`style_run_byte_advances`); without one this degrades to the uniform wrap.
fn compute_style_wrap_ranges_first_line(txt: text, first_width: i32, max_width: i32, st: Style, fallback_cpl: i32) -> LineWrapRanges:
    _lay_compute_style_wrap_ranges_first_inner(txt, first_width, max_width, st, fallback_cpl)

fn _lay_compute_style_wrap_ranges_first_inner(txt: text, first_width: i32, max_width: i32, st: Style, fallback_cpl: i32) -> LineWrapRanges:
    # Cheap gates first: building `by` decodes the whole run, so it must not run
    # for a style that cannot use it anyway.
    if st.resolved_font_identity == "" or max_width <= 0:
        return compute_wrap_ranges(txt, fallback_cpl)
    val by = style_run_byte_advances(st, txt)
    val txt_bytes = txt.byte_len()
    if by.len() != txt_bytes:
        return compute_wrap_ranges(txt, fallback_cpl)
    var starts: [i32] = []
    var ends: [i32] = []
    var start = 0
    val n = txt.byte_len()
    # BYTE-indexed space test. `char_code_at` is CODEPOINT-indexed in this text
    # API while `endv` is a byte offset (it is cut on with `substring`), so on
    # any run past its first non-ASCII codepoint the two disagree and the break
    # landed some bytes away from the space it meant to break at.
    val tb = txt.bytes()
    while start < n:
        var endv = start
        var used = 0
        var last_space = -1
        val line_width = if start == 0: first_width else: max_width
        while endv < n and used + by[endv] <= line_width:
            used = used + by[endv]
            if tb[endv] == 32:
                last_space = endv
            endv = endv + 1
        # CSS Text 3 `overflow-wrap: normal` (the initial value) forbids a break
        # INSIDE a word: a word wider than the line OVERFLOWS it, it is not
        # chopped. Measured against Chrome on an 80 px box:
        # `LongWordBreakHere` is ONE line that overflows, and
        # `LongWord<wbr>BreakHere` is exactly two. Before this arm the loop cut
        # at whatever byte stopped fitting, and — when the run started
        # mid-line, so `max_width` was a small pen remainder — at `endv ==
        # start` it emitted a single CODEPOINT per line: 9 lines for
        # "BreakHere" against Chrome's 1. Intra-word breaking stays available
        # where CSS actually asks for it (`overflow-wrap: break-word` /
        # `anywhere`, `word-break: break-all`), which is why this is a
        # condition and not a deletion.
        val may_break_in_word = st.overflow_wrap == "break-word" or st.overflow_wrap == "anywhere" or st.word_break == "break-all"
        if endv < n and last_space > start:
            endv = last_space
        elif not may_break_in_word and endv < n:
            # No break opportunity inside this line: take the whole word, even
            # though it overflows, and break at the space that ends it.
            endv = word_end_byte(tb, start, n)
        if endv == start:
            # Progress guard: `start` is a space whose own advance already
            # exceeds `max_width` (a pen remainder of a pixel or two), so the
            # word arm above has nothing to take. Emit one codepoint so the
            # outer loop always advances; without it the line list would grow
            # forever on a 1 px box.
            endv = next_codepoint_start(txt, start)
        starts.push(start)
        ends.push(endv)
        start = skip_wrap_spaces(txt, endv)
    LineWrapRanges(starts: starts, ends: ends)

# Advance of the FIRST unbreakable piece of a text run: everything up to the
# first collapsible space, or the whole run when it has none. Used by the
# `<wbr>` soft-break arm in the block loop, which may take a break opportunity
# only when the piece that FOLLOWS it does not fit the line remainder. Using
# the whole run's advance there instead would break at a `<wbr>` whose next
# word still fits and only a later word does not — measured against Chrome,
# `Long<wbr>Word<wbr>BreakHere` in an 80 px box is TWO lines, not three,
# because Chrome is greedy and uses only the last opportunity that is needed.
fn first_word_advance_width(node: HNode, st: Style) -> i32:
    if node.tag != "#text":
        return 0
    val txt = node.text_trimmed
    val n = txt.byte_len()
    if n == 0:
        return 0
    val by = style_run_byte_advances(st, txt)
    if by.len() != n:
        # No per-byte table for this style: fall back to the whole-run advance
        # rather than guessing. That is wider, so it can only make the arm more
        # conservative about breaking, never less.
        return inline_text_advance_width(node, st)
    val tb = txt.bytes()
    val stop = word_end_byte(tb, 0, n)
    var w = 0
    var k = 0
    while k < stop:  # cpu-lane-loop-ok: scans one word of one text run, bounded by that run's byte length
        w = w + by[k]
        k = k + 1
    w

# Byte offset one past the last byte of the word that starts at `start`, i.e.
# the next ASCII space at or after `start`, or `n` when the run has none. Used
# by the `overflow-wrap: normal` arm above, where a word that does not fit the
# line must overflow it whole rather than be cut.
fn word_end_byte(tb: [u8], start: i32, n: i32) -> i32:
    var k = start
    while k < n:  # cpu-lane-loop-ok: scans one word of one text run, bounded by that run's byte length
        if tb[k] == 32:
            return k
        k = k + 1
    n

# Line ranges for a `white-space: pre` run: every U+000A is a forced break.
# Two HTML rules are folded in, both harvested from Chrome rather than recalled:
# a single newline IMMEDIATELY after the `<pre>` start tag is dropped
# (`<pre>\nA\nB</pre>` is two lines, not three), and a run that ENDS in a
# newline does not open a trailing empty line.
fn compute_preserved_newline_ranges(txt: text, txt_len: i32) -> LineWrapRanges:
    val tb = txt.bytes()
    var starts: [i32] = []
    var ends: [i32] = []
    var start = if txt_len > 0 and tb[0] == 10: 1 else: 0
    var k = start
    while k < txt_len:  # cpu-lane-loop-ok: one pass over one text run's bytes
        if tb[k] == 10:
            starts.push(start)
            ends.push(k)
            start = k + 1
        k = k + 1
    if start < txt_len or starts.len() == 0:
        starts.push(start)
        ends.push(txt_len)
    LineWrapRanges(starts: starts, ends: ends)

fn zero_i32_list(count: i32) -> [i32]:
    [0; count]

fn neg_one_i32_list(count: i32) -> [i32]:
    [-1; count]

fn shifted_i32_list(values: [i32], delta: i32) -> [i32]:
    val count = values.len()
    var shifted: [i32] = [0; count]
    var i = 0
    while i < count:
        shifted[i] = values[i] + delta
        i = i + 1
    shifted

pub fn empty_i32_lists(count: i32) -> [[i32]]:
    [[]; count]

fn css_outer_width(node: HNode, st: Style, css_width: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_width
    css_width + st.pad_l + st.pad_r + st.border_l + st.border_r

fn css_outer_height(node: HNode, st: Style, css_height: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_height
    css_height + st.pad_t + st.pad_b + st.border_t + st.border_b

fn definite_content_height_limit(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return st.height_px - st.pad_t - st.pad_b - border_y
        return st.height_px
    if st.min_height_px > 0:
        return st.min_height_px
    0

fn constrained_outer_width(node: HNode, st: Style, candidate_width: i32) -> i32:
    var out = candidate_width
    if st.min_width_px > 0:
        val min_outer = css_outer_width(node, st, st.min_width_px)
        if out < min_outer:
            out = min_outer
    if st.max_width_px > 0:
        val max_outer = css_outer_width(node, st, st.max_width_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn explicit_auto_table_column_offsets(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    table: i32, inner_width: i32, spacing_x: i32, spacing_y: i32,
    fill_available: bool
) -> [i32]:
    # Keep the legacy zero-spacing admission narrow. Authored spacing also
    # admits constrained and spanning cells after their minimum track widths
    # are resolved here, so gaps never force overlapping boxes.
    val has_authored_spacing = spacing_x > 0 or spacing_y > 0
    val rows = simple_web_collect_table_rows(nodes, child_index, table)
    val column_count = simple_web_fixed_table_column_count(
        nodes, child_index, rows
    )
    var widths: [i32] = [0; column_count]
    var col_min: [i32] = [0; column_count]
    for row in rows.rows:
        var column = 0
        var cell = child_index.first_child[row]
        while cell >= 0:
            if styles[cell].display == "table-cell":
                val span = simple_web_fixed_table_cell_span(
                    nodes[cell], column_count
                )
                val cell_style = styles[cell]
                if not has_authored_spacing and (
                    span != 1 or
                    cell_style.min_width_px > 0 or
                    cell_style.max_width_px > 0
                ):
                    return []
                if span == 1 and column < column_count:
                    var cell_width = if cell_style.width_px > 0:
                        css_outer_width(
                            nodes[cell], cell_style, cell_style.width_px
                        )
                    else:
                        # CSS 2.1 §17.5.2.2: a cell with no stated width sizes
                        # its column from CONTENT, not from a 1px placeholder
                        # that the caller then fills by an equal split. Until
                        # this landed, every table whose cells state no width
                        # bailed out of the auto path entirely (the removed
                        # `cell_style.width_px <= 0` bail above) and got fixed
                        # equal columns — the shape `table_layout_spec` used to
                        # assert and Chrome never produces.
                        table_cell_max_content_width(
                            nodes, styles, child_index, cell
                        )
                    # border-collapse: adjacent cell borders are shared, so a
                    # cell's border-box contributes only half of each vertical
                    # border to its column track (uniform-width borders only —
                    # per-edge winner widths stay outside this admission).
                    if styles[table].border_collapse == "collapse" and cell_width > 1:
                        cell_width = cell_width - (
                            (cell_style.border_l + cell_style.border_r) / 2
                        )
                    if cell_style.max_width_px > 0:
                        val max_width = css_outer_width(
                            nodes[cell], cell_style,
                            cell_style.max_width_px
                        )
                        if cell_width > max_width:
                            cell_width = max_width
                    if cell_style.min_width_px > 0:
                        val min_width = css_outer_width(
                            nodes[cell], cell_style,
                            cell_style.min_width_px
                        )
                        if cell_width < min_width:
                            cell_width = min_width
                    if cell_width > widths[column]:
                        widths[column] = cell_width
                    # The column's FLOOR. A cell with a stated width is its own
                    # floor; an auto cell's floor is its longest unbreakable
                    # word. Never above the ceiling just computed.
                    var cell_min = if cell_style.width_px > 0:
                        cell_width
                    else:
                        table_cell_min_content_width(
                            nodes, styles, child_index, cell
                        )
                    if cell_style.min_width_px > 0:
                        val floor_width = css_outer_width(
                            nodes[cell], cell_style, cell_style.min_width_px
                        )
                        if cell_min < floor_width:
                            cell_min = floor_width
                    if cell_min > cell_width:
                        cell_min = cell_width
                    if cell_min > col_min[column]:
                        col_min[column] = cell_min
                column = column + span
            cell = child_index.next_sibling[cell]
    if has_authored_spacing:
        for row in rows.rows:
            var span_column = 0
            var span_cell = child_index.first_child[row]
            while span_cell >= 0:
                if styles[span_cell].display == "table-cell":
                    val span = simple_web_fixed_table_cell_span(
                        nodes[span_cell], column_count
                    )
                    val next_column = if span_column + span < column_count:
                        span_column + span
                    else:
                        column_count
                    if span > 1 and span_column < column_count:
                        val span_style = styles[span_cell]
                        var required_width = if span_style.width_px > 0:
                            css_outer_width(
                                nodes[span_cell], span_style,
                                span_style.width_px
                            )
                        else:
                            0
                        if span_style.min_width_px > 0:
                            val span_min_width = css_outer_width(
                                nodes[span_cell], span_style,
                                span_style.min_width_px
                            )
                            if required_width < span_min_width:
                                required_width = span_min_width
                        var current_width = (
                            spacing_x * (next_column - span_column - 1)
                        )
                        var width_column = span_column
                        while width_column < next_column:
                            current_width = current_width + widths[width_column]
                            width_column = width_column + 1
                        if required_width > current_width:
                            val deficit = required_width - current_width
                            val span_count = next_column - span_column
                            val grow_each = deficit / span_count
                            val grow_remainder = (
                                deficit - grow_each * span_count
                            )
                            var grow_column = span_column
                            while grow_column < next_column:
                                val grow_share = grow_each + (if (
                                    grow_column - span_column < grow_remainder
                                ): 1 else: 0)
                                widths[grow_column] = (
                                    widths[grow_column] + grow_share
                                )
                                # The floor rises with the ceiling: a spanning
                                # cell's stated requirement is a requirement in
                                # both directions, or the columns it covers
                                # could be compressed back below it.
                                col_min[grow_column] = (
                                    col_min[grow_column] + grow_share
                                )
                                grow_column = grow_column + 1
                    span_column = next_column
                span_cell = child_index.next_sibling[span_cell]
    var sum_max = 0
    var c_i = 0
    while c_i < column_count:
        if widths[c_i] <= 0:
            return []
        if col_min[c_i] > widths[c_i]:
            col_min[c_i] = widths[c_i]
        sum_max = sum_max + widths[c_i]
        c_i = c_i + 1
    # CSS 2.1 §17.5.2: a table with a stated width FILLS it; a `width: auto`
    # table is as wide as its content but never wider than the space it has —
    # past that ceiling its columns compress between their min- and
    # max-content widths instead of overflowing the containing block. The
    # distribution itself is `table_distribute_auto_columns`, the same function
    # the M14 spec-facing `layout_table` calls, so the two lanes resolve
    # columns by one rule rather than two that drift.
    var available = inner_width - spacing_x * (column_count + 1)
    if available < column_count:
        available = column_count
    # CAPMIN (CSS 2.1 §17.5.2): the used width of a `width: auto` table is at
    # least the min-content width of its CAPTION. Without this the caption is
    # laid out at the shrink-to-fit table width and wraps — measured on the
    # `html` catalog page, "Table caption" over a one-word cell wrapped to two
    # lines (48 px against Chrome's 24) and pushed every later element on the
    # page down. Chrome widens the table instead.
    var capmin = 0
    var cap_child = child_index.first_child[table]
    while cap_child >= 0:  # cpu-lane-loop-ok: one pass over the table's own children
        if styles[cap_child].display == "table-caption":
            val cap_w = table_cell_min_content_width(
                nodes, styles, child_index, cap_child
            ) - spacing_x * (column_count + 1)
            if cap_w > capmin:
                capmin = cap_w
        cap_child = child_index.next_sibling[cap_child]
    val target = if fill_available:
        available
    elif sum_max <= available:
        if capmin > sum_max:
            if capmin < available: capmin else: available
        else:
            0
    else:
        available
    val used = table_distribute_auto_columns(col_min, widths, target)
    if used.len() != column_count:
        return []
    var offsets: [i32] = [0; column_count + 1]
    var offset_column = 0
    while offset_column < column_count:
        offsets[offset_column + 1] = (
            offsets[offset_column] + used[offset_column]
        )
        offset_column = offset_column + 1
    offsets

fn constrained_outer_height(node: HNode, st: Style, candidate_height: i32) -> i32:
    var out = candidate_height
    if st.min_height_px > 0:
        val min_outer = css_outer_height(node, st, st.min_height_px)
        if out < min_outer:
            out = min_outer
    if st.max_height_px > 0:
        val max_outer = css_outer_height(node, st, st.max_height_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn absolute_outer_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, node_i: i32, parent: Style, node: HNode, st: Style, containing_w: i32) -> i32:
    if st.width_px == 0 and st.left_px > 0 and st.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        var stretched = padding_box_w - st.left_px - st.right_px
        if stretched < 1:
            stretched = 1
        return constrained_outer_width(node, st, stretched)
    if st.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val percent_content_w = padding_box_w * (0 - st.width_px) / 100
        return constrained_outer_width(node, st, css_outer_width(node, st, percent_content_w))
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    if st.width_px > 0:
        return constrained_outer_width(node, st, explicit_node_w)
    # CSS 2.1 10.3.7: `width: auto` on an absolutely positioned, non-replaced
    # box is SHRINK-TO-FIT, not "fill the containing block". The stretch case is
    # only reachable when BOTH `left` and `right` are given, and that arm is the
    # first branch above. Falling through to the containing block made every
    # `width:auto` absolute box as wide as its containing block, which then also
    # dragged its x through the `right` formula in absolute_child_x (measured on
    # the catalog's one absolute box: w 810 instead of 77, x 35 instead of 769).
    #
    # shrink-to-fit = min(max(preferred-minimum, available), preferred).
    # `preferred` is the same max-content measurement <select> already uses for
    # its intrinsic width, so no new measurement surface is introduced here.
    #
    # AVAILABLE is not the whole containing block: 10.3.7 takes it as the
    # containing block MINUS whichever of left/right is specified, because that
    # offset is already committed. Harvested from Chrome on a fixture where the
    # content overflows (`right: 10px`, text far wider than the block): Chrome
    # clamps to 890 in a 900 px block, not to 900. Only the overflow case can
    # see this, which is why it is taken from a measurement rather than assumed.
    val padding_box_w = containing_w + parent.pad_l + parent.pad_r
    var available = padding_box_w
    if st.right_px >= 0:
        available = available - st.right_px
    if st.left_px > 0:
        available = available - st.left_px
    if replaced_default_box_w(node.tag) > 0:
        # 10.3.8: a replaced box is not shrink-to-fit. Chrome 159: an
        # absolute viewBox-only svg in a 500 px containing block is 500x500.
        return constrained_outer_width(node, st, replaced_auto_box_w(node, st, available))
    var shrink_to_fit = flex_item_max_content_width(nodes, styles, child_index, node_i)
    if shrink_to_fit > available:
        shrink_to_fit = available
    if shrink_to_fit < 1:
        shrink_to_fit = 1
    constrained_outer_width(node, st, shrink_to_fit)

fn absolute_outer_height(node: HNode, st: Style, containing_h: i32) -> i32:
    val border_y = st.border_t + st.border_b
    val resolved_h = resolve_percent_height_px(st.height_px, containing_h)
    if resolved_h > 0:
        if st.border_box:
            return constrained_outer_height(node, st, resolved_h)
        return constrained_outer_height(node, st, resolved_h + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

fn resolve_horizontal_margin_px(margin_px: i32, containing_w: i32) -> i32:
    if margin_px < 0:
        return containing_w * (0 - margin_px) / 100
    margin_px

fn resolve_percent_height_px(height_px: i32, containing_h: i32) -> i32:
    if height_px < 0 and containing_h > 0:
        return containing_h * (0 - height_px) / 100
    height_px

fn resolve_vertical_margin_px(margin_px: i32, viewport_h: i32) -> i32:
    # margin_px <= -1000 is the vh-percentage sentinel (see margin_token_vh_px);
    # anything else, including -999..-1, is a literal (possibly negative) px
    # margin and must pass through unchanged for CSS 2.2 8.3.1 collapsing to
    # see the true sign.
    if margin_px <= -1000:
        return viewport_h * ((0 - margin_px) - 1000) / 100
    margin_px

fn absolute_child_x(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, child_i: i32, parent_x: i32, parent: Style, child_node: HNode, child: Style, containing_w: i32, viewport_w: i32) -> i32:
    # position:fixed: both insets are measured from the viewport, not the
    # nearest ancestor (CSS 2.2 10.1 makes the viewport the fixed containing
    # block). The right branch must be checked with the viewport width before
    # the ancestor-anchored absolute formula below can fire.
    if child.position_fixed:
        if child.right_px >= 0:
            return viewport_w - absolute_outer_width(nodes, styles, child_index, child_i, parent, child_node, child, containing_w) - child.right_px
        return child.left_px
    # CSS 2.2 10.1: with no positioned ancestor the containing block is the
    # initial containing block at the layout origin, so an authored `left`
    # is not measured from the (static) parent. `left: auto` keeps the
    # parent-relative static-position approximation below.
    if not child.left_auto and not absolute_has_positioned_ancestor(nodes, styles, child_i):
        return child.left_px
    if child.right_px >= 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        return parent_x + parent.border_l + padding_box_w - absolute_outer_width(nodes, styles, child_index, child_i, parent, child_node, child, containing_w) - child.right_px
    parent_x + parent.border_l + child.left_px

# True when some ancestor of `node_i` establishes an absolute containing block
# (any non-static position). Transforms/containment are not modelled here.
fn absolute_has_positioned_ancestor(nodes: [HNode], styles: [Style], node_i: i32) -> bool:
    var a = nodes[node_i].parent
    while a >= 0:
        val ast = styles[a]
        if ast.position_relative or ast.position_absolute or ast.position_sticky or ast.position_fixed:
            return true
        a = nodes[a].parent
    false

fn absolute_child_y(nodes: [HNode], styles: [Style], child_i: i32, parent_y: i32, parent: Style, child_node: HNode, child: Style, containing_h: i32, viewport_h: i32) -> i32:
    # Mirror of absolute_child_x: a fixed box's bottom inset resolves against
    # the viewport height, not the nearest ancestor's content height.
    if child.position_fixed:
        if child.bottom_px >= 0:
            return viewport_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px
        return child.top_px
    # Same initial-containing-block rule as absolute_child_x for `top`.
    if not child.top_auto and not absolute_has_positioned_ancestor(nodes, styles, child_i):
        return child.top_px
    if child.bottom_px >= 0:
        return parent_y + parent.border_t + containing_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px
    parent_y + parent.border_t + child.top_px

fn absolute_child_style(parent: Style, child: Style, containing_w: i32, containing_h: i32) -> Style:
    var resolved_child = child
    if child.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val child_width_px = padding_box_w * (0 - child.width_px) / 100
        resolved_child = style_with_width(resolved_child, child_width_px)
    val child_height_px = resolve_percent_height_px(child.height_px, containing_h)
    if child_height_px > 0 and child_height_px != resolved_child.height_px:
        resolved_child = style_with_height(resolved_child, child_height_px)
    resolved_child

# Resolves a normalized track list (space-separated "Npx" / "Nfr" tokens,
# see normalized_grid_track_list in
# simple_web_html_layout_renderer_declarations.spl) into concrete pixel
# sizes. Fixed (px) tracks keep their declared size; the space remaining in
# `available_w` after subtracting fixed track sizes and inter-track gaps is
# distributed across `fr` tracks proportional to their flex factor — CSS
# Grid SS11.5 "Resolving Flexible Track Sizes", simplified: no min-content
# clamping and no `minmax()` support (see
# doc/08_tracking/bug/browser_engine_grid_fr_track_unit_unsupported_2026-08-07.md).
fn _lay_grid_track_sizes_inner(raw: text, available_w: i32, gap: i32) -> [i32]:
    var tokens: [text] = []
    var is_fr: [bool] = []
    var fixed_sum = 0
    var fr_total = 0
    for part in raw.split(" "):
        val token = part.trim()
        if token == "":
            continue
        if token.ends_with("fr") and token.len() > 2:
            val factor = parse_int(token)
            if factor <= 0:
                return []
            tokens.push(token)
            is_fr.push(true)
            fr_total = fr_total + factor
        else:
            val size = parse_int(token)
            if size <= 0:
                return []
            tokens.push(token)
            is_fr.push(false)
            fixed_sum = fixed_sum + size
    val track_count = tokens.len() as i32
    if track_count == 0:
        return []
    var free_space = available_w - fixed_sum - gap * (track_count - 1)
    if free_space < 0:
        free_space = 0
    var sizes: [i32] = []
    var idx = 0
    while idx < tokens.len():
        if is_fr[idx]:
            val factor = parse_int(tokens[idx])
            val fr_size = if fr_total > 0: free_space * factor / fr_total else: 0
            sizes.push(fr_size)
        else:
            sizes.push(parse_int(tokens[idx]))
        idx = idx + 1
    sizes

fn grid_placement_start(raw: text) -> i32:
    val value = raw.trim()
    if value == "":
        return -1
    val slash = find_from(value, "/", 0)
    val first = if slash >= 0:
        value.substring(0, slash).trim()
    else:
        value
    val line = parse_int(first)
    if line > 0: line - 1 else: -1

fn grid_placement_span(raw: text) -> i32:
    val value = raw.trim()
    val slash = find_from(value, "/", 0)
    if slash < 0:
        return 1
    val start = parse_int(value.substring(0, slash).trim())
    val tail = value.substring(slash + 1, value.byte_len()).trim()
    if tail.starts_with("span "):
        val span = parse_int(tail.substring(5, tail.byte_len()).trim())
        return if span > 0: span else: 1
    val end_line = parse_int(tail)
    if start > 0 and end_line > start: end_line - start else: 1

fn grid_track_offset(sizes: [i32], gap: i32, track: i32) -> i32:
    var offset = 0
    var index = 0
    while index < track and index < sizes.len():
        offset = offset + sizes[index] + gap
        index = index + 1
    offset

fn grid_track_span_size(
    sizes: [i32], gap: i32, start: i32, span: i32
) -> i32:
    var size = 0
    var index = 0
    while index < span and start + index < sizes.len():
        if index > 0:
            size = size + gap
        size = size + sizes[start + index]
        index = index + 1
    size

# A single `grid-template-areas` named area resolved to its (0-based)
# track range, e.g. "right" in `"left right"` -> row_start:0, col_start:1,
# row_span:1, col_span:1.
class GridAreaRect:
    area: text
    row_start: i32
    col_start: i32
    row_span: i32
    col_span: i32

# Parses a normalized `grid-template-areas` string (rows joined by "|",
# cells within a row space-separated -- see normalized_grid_template_areas
# in simple_web_html_layout_renderer_declarations.spl) into the list of
# named area rectangles it declares. Only rectangular areas are recognized
# (CSS Grid SS7.1 "Named Areas"): a name whose occupied cells don't form a
# solid rectangle is dropped -- silently, per this renderer's existing
# lenient-CSS convention -- and a `grid-area` reference to a dropped name
# falls through to numeric/auto placement. No dot-cell (`.`) handling beyond
# treating it as an empty/unnamed cell, and no implicit-track creation
# beyond what the template's own row/column count implies. See
# doc/08_tracking/bug/browser_engine_grid_template_areas_missing_2026-08.md.
fn grid_template_area_rects(raw: text) -> [GridAreaRect]:
    var result: [GridAreaRect] = []
    if raw == "":
        return result
    val rows = raw.split("|")
    var names: [text] = []
    var min_rows: [i32] = []
    var max_rows: [i32] = []
    var min_cols: [i32] = []
    var max_cols: [i32] = []
    var row_idx = 0
    while row_idx < rows.len():
        val cols = rows[row_idx].split(" ")
        var col_idx = 0
        while col_idx < cols.len():
            val name = cols[col_idx].trim()
            if name != "" and name != ".":
                var found = -1
                var k = 0
                while k < names.len():
                    if names[k] == name:
                        found = k
                    k = k + 1
                if found < 0:
                    names.push(name)
                    min_rows.push(row_idx as i32)
                    max_rows.push(row_idx as i32)
                    min_cols.push(col_idx as i32)
                    max_cols.push(col_idx as i32)
                else:
                    if (row_idx as i32) < min_rows[found]:
                        min_rows[found] = row_idx as i32
                    if (row_idx as i32) > max_rows[found]:
                        max_rows[found] = row_idx as i32
                    if (col_idx as i32) < min_cols[found]:
                        min_cols[found] = col_idx as i32
                    if (col_idx as i32) > max_cols[found]:
                        max_cols[found] = col_idx as i32
            col_idx = col_idx + 1
        row_idx = row_idx + 1
    var i = 0
    while i < names.len():
        var valid = true
        var rr = min_rows[i]
        while rr <= max_rows[i] and valid:
            val cols = rows[rr].split(" ")
            var cc = min_cols[i]
            while cc <= max_cols[i] and valid:
                if (cc as i64) >= cols.len() or cols[cc].trim() != names[i]:
                    valid = false
                cc = cc + 1
            rr = rr + 1
        if valid:
            result.push(GridAreaRect(
                area: names[i], row_start: min_rows[i], col_start: min_cols[i],
                row_span: max_rows[i] - min_rows[i] + 1,
                col_span: max_cols[i] - min_cols[i] + 1
            ))
        i = i + 1
    result

fn style_run_byte_advances(st: Style, s: text) -> [i32]:
    if not _wsc_on:
        return _lay_style_run_byte_advances_inner(st, s)
    val t0 = _wsc_now_us()
    val out = _lay_style_run_byte_advances_inner(st, s)
    _wlay_add(0, _wsc_now_us() - t0, 1)
    out

fn style_measured_run_advance(txt: text, txt_len: i32, st: Style) -> i32:
    if not _wsc_on:
        return _lay_style_measured_run_advance_inner(txt, txt_len, st)
    val t0 = _wsc_now_us()
    val out = _lay_style_measured_run_advance_inner(txt, txt_len, st)
    _wlay_add(0, _wsc_now_us() - t0, 1)
    out

fn inline_text_advance_width(node: HNode, st: Style) -> i32:
    if not _wsc_on:
        return _lay_inline_text_advance_width_inner(node, st)
    val t0 = _wsc_now_us()
    val out = _lay_inline_text_advance_width_inner(node, st)
    _wlay_add(1, _wsc_now_us() - t0, 1)
    out

