fn style_with_height(st: Style, height_px: i32) -> Style:
    # Style gained Grid fields after this shared used-value clone was written.
    # Restore them here so a temporarily height-resolved item can remain a
    # nested Grid container and retain its own placement metadata.
    val out = style_with_height_without_grid_fields(st, height_px)
    out.grid_template_columns = st.grid_template_columns
    out.grid_template_rows = st.grid_template_rows
    out.grid_column = st.grid_column
    out.grid_row = st.grid_row
    out.grid_template_areas = st.grid_template_areas
    out.grid_area = st.grid_area
    out.grid_auto_flow_column = st.grid_auto_flow_column
    out.height_auto = false
    out.left_auto = st.left_auto
    out.top_auto = st.top_auto
    out.align_items_authored = st.align_items_authored
    out.scrollbar_width_none = st.scrollbar_width_none
    out.display_inline_flex_authored = st.display_inline_flex_authored
    out.contain_size = st.contain_size
    out.contain_intrinsic_w_px = st.contain_intrinsic_w_px
    out.contain_intrinsic_h_px = st.contain_intrinsic_h_px
    out

