_upright, text_shadow_x_px: st.text_shadow_x_px, text_shadow_y_px: st.text_shadow_y_px, text_shadow_color: st.text_shadow_color, text_shadow_raw: st.text_shadow_raw, text_decoration_color: st.text_decoration_color, text_decoration_underline: st.text_decoration_underline, text_decoration_style: st.text_decoration_style, text_decoration_thickness_px: st.text_decoration_thickness_px, text_underline_offset_px: st.text_underline_offset_px, text_underline_position: st.text_underline_position, white_space_nowrap: st.white_space_nowrap, white_space_pre: st.white_space_pre, overflow_wrap: st.overflow_wrap, line_break: st.line_break, hyphens: st.hyphens, word_break: st.word_break, cursor: st.cursor, resize: st.resize, table_layout: st.table_layout, border_collapse: st.border_collapse, border_spacing_x_px: st.border_spacing_x_px, border_spacing_y_px: st.border_spacing_y_px, caption_side: st.caption_side, vertical_align: st.vertical_align, caret_color: st.caret_color, accent_color: st.accent_color, tab_size: st.tab_size, unicode_bidi: st.unicode_bidi, transition_property: st.transition_property, transition_duration_ms: st.transition_duration_ms, transition_delay_ms: st.transition_delay_ms, transition_timing_function: st.transition_timing_function, animation_name: st.animation_name, animation_duration_ms: st.animation_duration_ms, animation_delay_ms: st.animation_delay_ms, animation_timing_function: st.animation_timing_function, animation_iteration_count: st.animation_iteration_count, animation_direction: st.animation_direction, animation_fill_mode: st.animation_fill_mode, animation_play_state: st.animation_play_state, transform_origin: st.transform_origin, transform_box: st.transform_box, transform_style: st.transform_style, image_rendering: st.image_rendering, object_fit: st.object_fit, object_position: st.object_position, bold: st.bold, float_mode: st.float_mode, clear_mode: st.clear_mode)

fn style_with_width(st: Style, width_px: i32) -> Style:
    val out = style_with_width_without_height_metadata(st, width_px)
    # The clone above predates the Grid fields: restore them so a grid container
    # or item whose percent padding / margin / min-max was resolved stays one.
    out.grid_template_columns = st.grid_template_columns
    out.grid_template_rows = st.grid_template_rows
    out.grid_column = st.grid_column
    out.grid_row = st.grid_row
    out.grid_template_areas = st.grid_template_areas
    out.grid_area = st.grid_area
    out.grid_auto_flow_column = st.grid_auto_flow_column
    out.grid_auto_rows = st.grid_auto_rows
    out.grid_auto_columns = st.grid_auto_columns
    out.height_auto = st.height_auto
    out.left_auto = st.left_auto
    out.top_auto = st.top_auto
    out.left_milli = st.left_milli
    out.top_milli = st.top_milli
    out.right_milli = st.right_milli
    out.bottom_milli = st.bottom_milli
    out.white_space_newline = st.white_space_newline
    out.align_items_authored = st.align_items_authored
    out.scrollbar_width_none = st.scrollbar_width_none
    out.display_inline_flex_authored = st.display_inline_flex_authored
    out.contain_size = st.contain_size
    out.contain_intrinsic_w_px = st.contain_intrinsic_w_px
    out.contain_intrinsic_h_px = st.contain_intrinsic_h_px
    out.width_zero = st.width_zero and width_px == 0
    out

# Extra width an inline box needs, beyond its intrinsic width, for the
# IN-FLOW `<svg>`s it holds (through inline boxes only) that have a viewBox
# ratio and no size. Such an svg contributes 0 to the intrinsic width but
# fills the line's available width up to its min/max-width (Chrome 159:
# `<span>a<svg viewBox="0 0 24 24"></svg>b</span>` in 900 px holds a 900x900
# svg; with `max-width:24px` the svg is 24x24 and the span 41.8). A floated
# or absolutely positioned svg is out of flow and adds nothing.
fn inline_box_ratio_only_svg_fill_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, available_w: i32) -> i32:
    var extra = 0
    var c = child_index.first_child[i]
    while c >= 0:
        val cst = styles[c]
        if cst.display == "inline" and nodes[c].tag != "#text":
            if nodes[c].tag == "svg":
                if (
                    cst.width_px == 0 and cst.float_mode == 0 and
                    not cst.position_absolute and not cst.position_fixed and
                    parse_int(attr_value(nodes[c].attrs_raw, "width")) <= 0 and
                    replaced_specified_box_h(cst) == 0 and
                    svg_ratio_view_box_milli(nodes[c].attrs_raw).len() == 4
                ):
                    extra = extra + constrained_outer_width(
                        nodes[c], cst, replaced_auto_box_w(nodes[c], cst, available_w)
                    ) - constrained_outer_width(
                        nodes[c], cst, replaced_auto_box_w(nodes[c], cst, 0)
                    )
            elif child_index.first_child[c] >= 0:
                extra = extra + inline_box_ratio_only_svg_fill_w(nodes, styles, child_index, c, available_w)
        c = child_index.next_sibling[c]
    extra

# Max-content width of a table CELL — CSS 2.1 §17.5.2.2's per-cell input to
# automatic column sizing. It is the same measurement a flex item's
# `flex-basis: content` needs (widest line over every in-flow child, inline
# children accumulating along the line), so it delegates rather than growing a
# second copy that would drift from it.
fn _lay_table_cell_max_content_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    val w = flex_item_max_content_width(nodes, styles, child_index, cell)
    if w < 1: 1 else: w

# Min-content width of a table CELL — the other half of CSS 2.1 §17.5.2.2's
# per-cell input. Without it a column has no floor, so a table that does not
# fit its containing block has nothing to compress toward and simply overflows.
fn _lay_table_cell_min_content_width_inner(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    var widest = 0
    var c = child_index.first_child[cell]
    while c >= 0:  # cpu-lane-loop-ok: one pass over this cell's children during table column sizing
        val cst = styles[c]
        if nodes[c].tag == "#text":
            val w = _table_text_min_content_width(nodes[c].text_trimmed, cst)
            if w > widest:
                widest = w
        elif cst.display != "none" and cst.display != "marker":
            val child_w = if cst.width_px > 0:
                cst.width_px + cst.pad_l + cst.pad_r + cst.border_l + cst.border_r
            else:
                table_cell_min_content_width(nodes, styles, child_index, c)
            if child_w > widest:
                widest = child_w
        c = child_index.next_sibling[c]
    val st = styles[cell]
    val out = widest + st.pad_l + st.pad_r + st.border_l + st.border_r
    if out < 1: 1 else: out

# First-line inset of wrapped `#text` runs that start mid-line (see
# LayoutResult.first_line_dx). `g_text_first_line_dx_pending` hands the inset
# from the inline run loop to the `#text` branch of `layout_with_style` for the
# one node laid out next; `g_text_first_line_dx` accumulates the per-node
# values for the layout pass and stays EMPTY until a run needs one, so a
# document without such a run pays nothing.
pub var g_text_first_line_dx_pending: i32 = 0
pub var g_text_first_line_dx: [i32] = []

fn text_first_line_dx_reset():
    g_text_first_line_dx_pending = 0
    g_text_first_line_dx = []

# Record node `i`'s inset. Called for EVERY `#text` placed by the inline run
# loop once the table exists, so a subtree that is laid out twice (flex/grid
# measuring passes) cannot leave a stale inset behind.
fn text_first_line_dx_record(node_count: i32, i: i32, dx: i32):
    if g_text_first_line_dx.len() == 0:
        if dx == 0:
            return
        g_text_first_line_dx = zero_i32_list(node_count)
    g_text_first_line_dx[i] = dx

# Mid-line pen origins (see LayoutResult.pen_origin_milli). Same lifecycle as
# `g_text_first_line_dx`: empty until a run needs one, recorded for every
# placed `#text` once it exists so a re-laid-out subtree leaves no stale value.
pub var g_text_pen_origin_milli: [i32] = []

pub fn text_pen_origin_reset():
    g_text_pen_origin_milli = []

# A subtree relayout that bypasses `layout()` continues from retained values.
# reason: per-node milli-px table, the same shape LayoutResult.pen_origin_milli carries.
# @allow(primitive_api)
pub fn text_pen_origin_restore(table: [i32]):
    g_text_pen_origin_milli = table

# reason: node index and milli-px origin index the per-node layout tables.
# @allow(primitive_api)
pub fn text_pen_origin_record(node_count: i32, i: i32, origin_milli: i32):
    if g_text_pen_origin_milli.len() == 0:
        if origin_milli == 0:
            return
        g_text_pen_origin_milli = zero_i32_list(node_count)
    g_text_pen_origin_milli[i] = origin_milli

# reason: per-node milli-px table read by node index, like text_first_line_dx_at.
# @allow(primitive_api)
pub fn text_pen_origin_at(table: [i32], i: i32) -> i32:
    if i >= 0 and i < table.len().to_i32(): table[i] else: 0

# Left edges of the auto table columns just resolved, as Chrome-minus-integer
# milli-px (table_column_edge_frac_milli); read by the table right after
# `explicit_auto_table_column_offsets` returns.
pub var g_table_column_edge_frac_milli: [i32] = []

# Exact-minus-integer x (milli-px) of a box's content edge, where the layout
# that placed the box knows it (an auto table cell). The box's inline loop
# starts every line with this pen error instead of 0. Reset with the pen
# origins by `layout()`.
pub var g_box_line_start_err_milli: [i32] = []

pub fn box_line_start_err_reset():
    g_box_line_start_err_milli = []

# reason: node index and milli-px error index the per-node layout tables.
# @allow(primitive_api)
pub fn box_line_start_err_record(node_count: i32, i: i32, err_milli: i32):
    if g_box_line_start_err_milli.len() == 0:
        if err_milli == 0:
            return
        g_box_line_start_err_milli = zero_i32_list(node_count)
    g_box_line_start_err_milli[i] = err_milli

# reason: per-node milli-px table read by node index.
# @allow(primitive_api)
pub fn box_line_start_err_at(i: i32) -> i64:
    if i >= 0 and i < g_box_line_start_err_milli.len().to_i32(): g_box_line_start_err_milli[i] as i64 else: 0

# Sentinel: the inline cursor moved by an advance with no exact width.
pub val INLINE_PEN_ERR_UNKNOWN: i64 = -1000000000

# The inline cursor's exact-minus-integer error (milli-px) at `inline_x`, or
# INLINE_PEN_ERR_UNKNOWN. A line start carries the box's own content-edge
# error (`line_start_err`, 0 unless its layout knows one). Otherwise the recorded
# error holds only while the cursor is still where it was recorded (`err_x`
# on line `err_y`); any other move went through an untracked advance.
# reason: inline-loop cursor coordinates are whole layout pixels.
# @allow(primitive_api)
pub fn inline_pen_err(inline_x: i32, inline_start_x: i32, cy: i32, err_x: i32, err_y: i32, err_milli: i64, line_start_err: i64 = 0) -> i64:
    if inline_x == inline_start_x:
        return line_start_err
    if inline_x == err_x and cy == err_y:
        return err_milli
    INLINE_PEN_ERR_UNKNOWN

# Exact-minus-integer width (milli-px) of an auto-width `<button>` on a line:
# its box holds each label rounded UP to a whole pixel, Chrome keeps the
# label's real width (`Submit` 41.484 px in a 42 px slot, so the box after it
# starts at 57.48, column 57). INLINE_PEN_ERR_UNKNOWN for a label with no
# exact width.
fn inline_button_width_err_milli(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, button_i: i32) -> i64:
    var delta: i64 = 0
    var t = child_index.first_child[button_i]
    while t >= 0:  # cpu-lane-loop-ok: one pass over one button's direct children; bound is that child list
        if nodes[t].tag != "#text":
            return INLINE_PEN_ERR_UNKNOWN
        val tst = styles[t]
        if nodes[t].text_trimmed.len() > 0:
            if tst.resolved_font_width <= 0 or tst.resolved_font_width_milli < 0:
                return INLINE_PEN_ERR_UNKNOWN
            val real_w = form_control_label_width_px(tst, nodes[t].text_trimmed)
            val used_w = if real_w > tst.resolved_font_width: real_w else: tst.resolved_font_width
            delta = delta + tst.resolved_font_width_milli - (used_w as i64) * 1000
        t = child_index.next_sibling[t]
    delta

# True when replaced box `node` (canvas, svg, img, video, iframe, embed,
# object) is as wide as a whole-px `width` attribute with no padding or
# border, so its laid-out width `bw` has no fraction Chrome would keep.
# reason: laid-out box width is a whole layout pixel.
# @allow(primitive_api)
fn inline_replaced_width_is_exact(node: HNode, st: Style, bw: i32) -> bool:
    val tag = node.tag
    if not (tag == "canvas" or tag == "svg" or tag == "img" or tag == "video" or tag == "iframe" or tag == "embed" or tag == "object"):
        return false
    if st.pad_l != 0 or st.pad_r != 0 or st.border_l != 0 or st.border_r != 0:
        return false
    val raw = attr_value(node.attrs_raw, "width").trim()
    if raw.len() == 0:
        return false
    var i = 0
    while i < raw.len():  # cpu-lane-loop-ok: one pass over one attribute value
        val ch = raw[i:i + 1]
        if ch < "0" or ch > "9":
            return false
        i = i + 1
    parse_int(raw) == bw

# Whole pixels of the cursor's exact-minus-integer error, to nearest. The
# inline loop moves the cursor by them, so a box after many runs sits where
# Chrome snaps it (`n <b>o</b> n <i>o</i> ...`: the 9th run at 110, not 107)
# and the error left for the pen origin stays within half a pixel.
# reason: milli-px error in, whole layout pixels out.
# @allow(primitive_api)
# reason: internal browser_engine pen arithmetic in milli-px, shared by layout_engine; same unit convention as the surrounding layout helpers
# @allow(primitive_api)
pub fn inline_pen_err_carry_px(err_milli: i64) -> i32:
    if err_milli >= 500:
        return ((err_milli + 500) / 1000) as i32
    if err_milli < -500:
        return 0 - (((0 - err_milli) + 499) / 1000) as i32
    0

# Exact-minus-integer width (milli-px) of inline item `c` as the inline loop
# advanced past it, or INLINE_PEN_ERR_UNKNOWN. Exact only for what this
# layout measures from the face: a one-line `#text` run, and a plain inline
# element (no padding/border) holding exactly one such run -- `<code>audio
# </code>` is 48.17 px in Chrome, 48 here -- and a default checkbox / radio
# (a whole 13 px box). Anything else (other atomic boxes,
# wrapped runs, spacing-adjusted runs) is unknown, so later runs on the line
# keep the integer pen.
# reason: node index into the per-node layout tables.
# @allow(primitive_api)
pub fn inline_item_width_err_milli(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, c: i32, bw: [i32], wrap_starts: [[i32]]) -> i64:
    var run = c
    if nodes[c].tag != "#text":
        val st = styles[c]
        # An auto-width `<button>` is as wide as its label rounded UP; Chrome
        # keeps the fraction (`Go` 33.785 px in a 34 px box).
        if nodes[c].tag == "button" and st.width_px <= 0 and st.min_width_px <= 0 and st.max_width_px <= 0:
            return inline_button_width_err_milli(nodes, styles, child_index, c)
        # A control sized in device px (a default `<input>` is 719 device px
        # at k = 4 in a 185 CSS px box): what follows it starts at that width.
        if g_layout_device_scale > 1 and box_device_extra_w_at(c) != 0:
            return (box_device_extra_w_at(c) as i64) * 1000 / (g_layout_device_scale as i64)
        # A replaced box sized by a whole-px `width` attribute is exactly
        # that wide: the pen error before it carries on past it (`<canvas
        # width=60>` then a space then an svg: the svg at 64.45, not 64).
        if inline_replaced_width_is_exact(nodes[c], st, bw[c]):
            return 0
        # A default checkbox / radio is a whole 13 px box: the label run
        # after it keeps the line's pen fraction (`<input type=checkbox>
        # Enabled`: Chrome paints `Enabled` from 34.45, not 34).
        if nodes[c].tag == "input" and st.width_px <= 0:
            val input_type = attr_value(nodes[c].attrs_raw, "type").trim().lower()
            if input_type == "checkbox" or input_type == "radio":
                return 0
        if st.display != "inline" or grid_item_is_replaced(nodes[c]):
            return INLINE_PEN_ERR_UNKNOWN
        if st.pad_l != 0 or st.pad_r != 0 or st.border_l != 0 or st.border_r != 0:
            return INLINE_PEN_ERR_UNKNOWN
        val first = child_index.first_child[c]
        if first < 0 or child_index.next_sibling[first] >= 0 or nodes[first].tag != "#text":
            return INLINE_PEN_ERR_UNKNOWN
        if bw[c] != bw[first]:
            return INLINE_PEN_ERR_UNKNOWN
        run = first
    val rst = styles[run]
    if wrap_starts[run].len() > 1 or rst.resolved_font_width_milli < 0:
        return INLINE_PEN_ERR_UNKNOWN
    if bw[run] == rst.resolved_font_width:
        return rst.resolved_font_width_milli - (bw[run] as i64) * 1000
    # A run measured over its trimmed text whose box also holds one or two
    # edge spaces, rounded once with them (`Lead ` is 35.59 + 4.45 -> 40).
    if rst.resolved_space_milli > 0:
        var k: i64 = 1
        while k <= 2:
            val exact = rst.resolved_font_width_milli + k * rst.resolved_space_milli
            if (bw[run] as i64) == (exact + 500) / 1000:
                return exact - (bw[run] as i64) * 1000
            k = k + 1
        # The same box with its edge space(s) kerned against the run's glyph.
        if rst.resolved_lead_space_milli > 0 or rst.resolved_trail_space_milli > 0:
            val lead_m = if rst.resolved_lead_space_milli > 0: rst.resolved_lead_space_milli else: rst.resolved_space_milli
            val trail_m = if rst.resolved_trail_space_milli > 0: rst.resolved_trail_space_milli else: rst.resolved_space_milli
            val kerned_edges: [i64] = [trail_m, lead_m, lead_m + trail_m]
            for edge in kerned_edges:
                val exact = rst.resolved_font_width_milli + edge
                if (bw[run] as i64) == (exact + 500) / 1000:
                    return exact - (bw[run] as i64) * 1000
    INLINE_PEN_ERR_UNKNOWN

# Per-line boxes of wrapped `#text` runs whose lines floats shorten (see
# LayoutResult.line_boxes): for node `i` a flat list of (dx, width) pairs, one
# pair per line, `dx` measured from the run's box left. Lines past the end of
# the list span the whole box. EMPTY until a run needs it. A node has either
# a first-line inset (mid-line run) or line boxes (float-shortened run),
# never both.
pub var g_text_line_boxes: [[i32]] = []
# Hand-over from the inline run loop to the `#text` branch for the one run
# laid out next: the line boxes it has to wrap into.
pub var g_text_line_boxes_pending: [i32] = []

fn text_line_boxes_reset():
    g_text_line_boxes = []
    g_text_line_boxes_pending = []

# Record node `i`'s line boxes; called for every `#text` the run loop places
# once the table exists, so a re-laid-out subtree leaves nothing stale.
fn text_line_boxes_record(node_count: i32, i: i32, boxes: [i32]):
    if g_text_line_boxes.len() == 0:
        if boxes.len() == 0:
            return
        g_text_line_boxes = empty_i32_lists(node_count)
    g_text_line_boxes[i] = boxes

# Device scale (Chrome --force-device-scale-factor) of the render this layout
# pass feeds. It is 1 everywhere except the >=300-dpi entry
# (`simple_web_layout_render_html_pixels_engine2d_at_device_scale`), which sets
# it around layout + compose and restores 1. At 1 nothing below runs and
# nothing is recorded.
var g_layout_device_scale: i32 = 1

# reason: k is a dimensionless integer device-pixel ratio, not a unit-bearing quantity.
# @allow(primitive_api)
pub fn layout_device_scale_set(k: i32):
    g_layout_device_scale = if k > 1: k else: 1

# reason: k is a dimensionless integer device-pixel ratio, not a unit-bearing quantity.
# @allow(primitive_api)
pub fn layout_device_scale() -> i32:
    g_layout_device_scale

# Device-px y correction of each `#text` run's Draw IR command at device scale
# k > 1 (see LayoutResult.device_dy): `g_text_device_dy` for the first line,
# `g_text_device_dy_rest` for lines 2..n. EMPTY until a line needs one, and
# always empty at k == 1.
var g_text_device_dy: [i32] = []
var g_text_device_dy_rest: [i32] = []

pub fn text_device_dy_reset():
    g_text_device_dy = []
    g_text_device_dy_rest = []

# Read and restore the tables through functions: the layout passes live in
# other modules.
# reason: per-node device-px offsets indexed like the layout box arrays.
# @allow(primitive_api)
pub fn text_device_dy_first_table() -> [i32]:
    g_text_device_dy

# reason: per-node device-px offsets indexed like the layout box arrays.
# @allow(primitive_api)
pub fn text_device_dy_rest_table() -> [i32]:
    g_text_device_dy_rest

# reason: per-node device-px offsets indexed like the layout box arrays.
# @allow(primitive_api)
pub fn text_device_dy_restore(first: [i32], rest: [i32]):
    g_text_device_dy = first
    g_text_device_dy_rest = rest

fn text_device_dy_record(node_count: i32, i: i32, first: i32, rest: i32):
    if g_text_device_dy.len() == 0:
        if first == 0 and rest == 0:
            return
        g_text_device_dy = zero_i32_list(node_count)
        g_text_device_dy_rest = zero_i32_list(node_count)
    g_text_device_dy[i] = first
    g_text_device_dy_rest[i] = rest

# Move lines 2..n of the wrapped run `i` down by `extra` device px: the device
# height its first line has beyond k x the CSS line height.
pub fn text_device_dy_rest_add(node_count: i32, i: i32, extra: i32):
    if extra == 0:
        return
    if g_text_device_dy.len() == 0:
        g_text_device_dy = zero_i32_list(node_count)
        g_text_device_dy_rest = zero_i32_list(node_count)
    g_text_device_dy_rest[i] = g_text_device_dy_rest[i] + extra

# Sub-pixel top of each laid-out block-level box at device scale k > 1 (see
# LayoutResult.device_top), in milli DEVICE px: k times the block cursor's
# milli residual. The cursor keeps y rounded to whole CSS px with the residual
# in `cy_frac`, so a box whose true top is by*1000 + frac paints, like
# Chrome's pixel-snapped device rect, from
# round(k * (by*1000 + frac) / 1000) = k*by + `box_device_top_px`(k * frac).
# DEVICE_TOP_UNSET marks a node the block cursor did not place (text, inline
# boxes, inline-blocks, floats, abspos):
# paint takes its nearest recorded ancestor's. Allocated by the first record
# of a k > 1 layout; always empty at k == 1.
pub val DEVICE_TOP_UNSET: i32 = -1000000
var g_box_device_top: [i32] = []

pub fn box_device_top_reset():
    g_box_device_top = []

# reason: per-node milli-device-px residuals indexed like the layout box arrays.
# @allow(primitive_api)
pub fn box_device_top_table() -> [i32]:
    g_box_device_top

# reason: per-node milli-device-px residuals indexed like the layout box arrays.
# @allow(primitive_api)
pub fn box_device_top_restore(top: [i32]):
    g_box_device_top = top

# Whole device px of a milli-device-px residual. Chrome keeps layout in
# LayoutUnits (1/64 device px) and pixel-snaps halves up; the cursor's milli
# residual drifts below that grid (0.67em of 32px is 21.437 here, 21.4375 in
# Chrome), so it is first put on the 1/64 grid: an h2 at 543.496 device px
# snaps to 543.5 and then 544, as in Chrome.
# reason: milli device px in, whole device px out; both are raster-grid scalars.
# @allow(primitive_api)
pub fn box_device_top_px(milli_device: i32) -> i32:
    val sixty_fourths = _floor_div_i32(milli_device * 64 + 500, 1000)
    _floor_div_i32(sixty_fourths + 32, 64)

# Records the cursor residual the block cursor (or a flex row) hands child i
# (milli CSS px; k > 1 only). A later
# pass over the same node overwrites, so the final placement wins.
# reason: node index, node count and milli residual are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_top_record(node_count: i32, i: i32, frac_milli: i32):
    val k = g_layout_device_scale
    if k <= 1 or i < 0 or i >= node_count:
        return
    if g_box_device_top.len() != node_count:
        var t: [i32] = []
        var n = 0
        while n < node_count:
            t.push(DEVICE_TOP_UNSET)
            n = n + 1
        g_box_device_top = t
    g_box_device_top[i] = frac_milli * k

# An atomic box a LINE placed (a form control) is not on the block cursor: it
# hangs from the line's baseline, which Chrome finds in device px. Its entry
# is DEVICE_TOP_REL + dy, whole device px RELATIVE to its nearest
# cursor-placed ancestor: paint adds every such entry on the way up to that
# ancestor's own top (`_html_draw_ir_device_top`). Chrome 159, 16px/1.5
# Liberation Sans at k=4: the baseline is 70 where 4 x 17 is 68, so a default
# text `<input>` (baseline 60 = 4 x 15) starts on device row 10, not 8.
pub val DEVICE_TOP_REL: i32 = -2000000

# reason: a device-top table entry in, its kind out; layout-array scalars.
# @allow(primitive_api)
pub fn box_device_top_is_inline_dy(entry: i32) -> bool:
    entry < DEVICE_TOP_REL / 2 - 500000

# reason: node index, node count and a device-px delta are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_inline_dy_record(node_count: i32, i: i32, dy_device_px: i32):
    if g_layout_device_scale <= 1 or i < 0 or i >= node_count:
        return
    if g_box_device_top.len() != node_count:
        if dy_device_px == 0:
            return
        var t: [i32] = []
        var n = 0
        while n < node_count:
            t.push(DEVICE_TOP_UNSET)
            n = n + 1
        g_box_device_top = t
    if dy_device_px != 0:
        g_box_device_top[i] = DEVICE_TOP_REL + dy_device_px
    elif box_device_top_is_inline_dy(g_box_device_top[i]):
        g_box_device_top[i] = DEVICE_TOP_UNSET

# The milli DEVICE px residual node `i` paints with when it records none of
# its own: that of its nearest ancestor-or-self the block cursor placed (what
# `_html_draw_ir_device_top` falls back to). 0 at k == 1 or with none.
# reason: node index in, milli device px out; both are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_top_inherited_milli(nodes: [HNode], i: i32) -> i32:
    if g_box_device_top.len() != nodes.len():
        return 0
    var r = i
    while r >= 0 and (g_box_device_top[r] == DEVICE_TOP_UNSET or box_device_top_is_inline_dy(g_box_device_top[r])):  # cpu-lane-loop-ok: ancestor walk to the nearest flow-placed box, depth-bounded
        r = nodes[r].parent as i32
    if r >= 0: g_box_device_top[r] else: 0

# A placed subtree moved by `delta_milli` of cursor residual (a collapsed top
# margin re-topped it after its own layout): its recorded tops move with it.
# reason: node index and milli residual delta are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_top_shift(child_index: HtmlChildIndex, node_index: i32, delta_milli: i32):
    if delta_milli == 0 or node_index < 0 or node_index >= g_box_device_top.len():
        return
    if g_box_device_top[node_index] != DEVICE_TOP_UNSET and not box_device_top_is_inline_dy(g_box_device_top[node_index]):
        g_box_device_top[node_index] = g_box_device_top[node_index] + delta_milli * g_layout_device_scale
    var child = child_index.first_child[node_index]
    while child >= 0:
        box_device_top_shift(child_index, child, delta_milli)
        child = child_index.next_sibling[child]

fn _floor_div_i32(a: i32, b: i32) -> i32:
    if a >= 0: a / b else: 0 - ((0 - a + b - 1) / b)

# The UA control font is 13.333px (`font_size` 13, `font_size_milli` 13333)
# with a 1.2 line-height ratio (FORM_CONTROL_UA_LINE_HEIGHT_RATIO in
# ..._declarations.spl) for Chrome's `normal`. Device metrics take the face's
# own line: at k=4 the Liberation Sans line is 61 device px (48 + 11 + 2 at
# 53.33px), where 15 px x 4 gives 60 and 13.333px x 4 x 1.2 gives 64.
val FORM_CONTROL_UA_LINE_HEIGHT_TENTHS: i32 = -12

fn style_is_ua_control_font(st: Style) -> bool:
    st.font_size == FORM_CONTROL_UA_FONT_TRUNCATED_PX and st.font_size_milli == FORM_CONTROL_UA_FONT_NUM * 1000 / FORM_CONTROL_UA_FONT_DEN and st.line_height_px == FORM_CONTROL_UA_LINE_HEIGHT_TENTHS

fn style_device_font_milli(st: Style) -> i32:
    if style_is_ua_control_font(st):
        return FORM_CONTROL_UA_FONT_NUM * 1000 / FORM_CONTROL_UA_FONT_DEN
    font_milli_of(st.font_size, st.font_size_milli)

# Used line-height of `st` in milli DEVICE px at device scale k: Chrome zooms
# the computed value, so `20px` is 20k, a number multiplies the device font
# size, and `normal` is the face's per-part rounded sum at size * k.
fn style_device_line_h_milli(st: Style, k: i32) -> i32:
    val size_milli = style_device_font_milli(st)
    if st.line_height_px > 0:
        return st.line_height_px * k * 1000
    if st.line_height_px < 0 and not style_is_ua_control_font(st):
        val lh = size_milli * k * (0 - st.line_height_px) / 10
        if lh > 0:
            return lh
    val normal = browser_normal_line_height_milli_px(st.font_family, st.bold, st.font_style_italic, size_milli * k)
    if normal > 0:
        return normal * 1000
    style_line_h(st) * k * 1000

# Device-px twin of `inline_line_strut_baseline_offset` at device scale k > 1:
# Blink (FontHeight::AddLeading under zoom-for-dsf) takes the strut from the
# face at size * k with the subpixel-positioning borrow, and floors the
# half-leading in DEVICE px. Chrome 159 DejaVu Sans 16px at k=4: 58 (58/16,
# leading 0); line-height 23px: 9 + 58 = 67. Without a measured face this is
# k times the CSS offset.
fn inline_line_strut_baseline_offset_device(st: Style, k: i32) -> i32:
    val ad = browser_face_ascent_descent_device_px(st.font_family, st.bold, st.font_style_italic, style_device_font_milli(st), k)
    if ad.len() != 2:
        return k * inline_line_strut_baseline_offset(st)
    _floor_div_i32(style_device_line_h_milli(st, k) - (ad[0] + ad[1]) * 1000, 2000) + ad[0]

# The painter puts a text command's baseline at its top plus the face ascent
# rounded at the DEVICE size (no borrow), while layout placed the top
# `k * css ascent` above the CSS baseline: this is what that costs, in device px.
# The painter's device size is the whole px `draw_ir_device_scale` hands it:
# 17.6 px at k=4 paints at 70, ascent 63, where 70.4 would round to 64.
fn text_device_painter_dy(st: Style, k: i32) -> i32:
    val css = style_face_ascent_descent(st)
    val size_milli = font_milli_of(st.font_size, st.font_size_milli)
    val dev = browser_face_ascent_descent_milli_px(st.font_family, st.bold, st.font_style_italic, font_milli_round_px(size_milli * k) * 1000)
    if css.len() != 2 or dev.len() != 2:
        return 0
    k * css[0] - dev[0]

# Device mirror of `inline_box_shifted_ascent`.
fn inline_box_shifted_ascent_device(child_index: HtmlChildIndex, html_nodes: [HNode], styles: [Style], node_index: i32, k: i32) -> i32:
    val st = styles[node_index]
    var ascent = inline_line_strut_baseline_offset_device(st, k)
    var child = child_index.first_child[node_index]
    while child >= 0:
        if inline_box_is_plain_element(html_nodes[child], styles[child]):
            val child_ascent = inline_box_shifted_ascent_device(child_index, html_nodes, styles, child, k) - vertical_align_baseline_shift_device(styles[child], st, k)
            if child_ascent > ascent:
                ascent = child_ascent
        child = child_index.next_sibling[child]
    ascent

# Record the device y correction of every `#text` run in this line: the
# line's own baseline delta (device baseline minus k x CSS baseline) plus the
# painter term. Lines 2..n of a wrapped run hold only that run on the line
# style's strut, so they take the delta of those two struts.
fn _text_device_dy_record_subtree(child_index: HtmlChildIndex, html_nodes: [HNode], styles: [Style], node_index: i32, line_style: Style, parent_style: Style, k: i32, line_delta: i32, shift_delta: i32):
    val st = styles[node_index]
    if html_nodes[node_index].tag == "#text":
        var css_rest = inline_line_strut_baseline_offset(line_style)
        var dev_rest = inline_line_strut_baseline_offset_device(line_style, k)
        val css_own = inline_line_strut_baseline_offset(st)
        val dev_own = inline_line_strut_baseline_offset_device(st, k)
        if css_own > css_rest:
            css_rest = css_own
        if dev_own > dev_rest:
            dev_rest = dev_own
        val painter = text_device_painter_dy(st, k)
        text_device_dy_record(html_nodes.len() as i32, node_index, line_delta + shift_delta + painter, dev_rest - k * css_rest + shift_delta + painter)
        return
    if not inline_box_is_plain_element(html_nodes[node_index], st):
        return
    # A sub/super box was moved by its CSS shift; its runs take the difference
    # to the device shift.
    val own_shift = shift_delta + vertical_align_baseline_shift_device(st, parent_style, k) - k * vertical_align_baseline_shift(st, parent_style.font_size)
    var child = child_index.first_child[node_index]
    while child >= 0:
        _text_device_dy_record_subtree(child_index, html_nodes, styles, child, line_style, st, k, line_delta, own_shift)
        child = child_index.next_sibling[child]

# Device mirror of `inline_box_shifted_descent`.
fn inline_box_shifted_descent_device(child_index: HtmlChildIndex, html_nodes: [HNode], styles: [Style], node_index: i32, k: i32) -> i32:
    val st = styles[node_index]
    var descent = style_device_line_h_milli(st, k) / 1000 - inline_line_strut_baseline_offset_device(st, k)
    var child = child_index.first_child[node_index]
    while child >= 0:
        if inline_box_is_plain_element(html_nodes[child], styles[child]):
            val child_descent = inline_box_shifted_descent_device(child_index, html_nodes, styles, child, k) + vertical_align_baseline_shift_device(styles[child], st, k)
            if child_descent > descent:
                descent = child_descent
        child = child_index.next_sibling[child]
    descent

# Device-px height of each box minus k x its CSS height, at device scale k > 1.
# Chrome lays out in device px, so a text `<input>` whose `normal` line is 61
# device px at k=4 is 133 tall where 4 x the CSS box is 132. Boxes stay
# CSS-snapped; the line that holds such a box reads this to find its own device
# height (`align_inline_line_device_dy`). Recorded by the form-control branch
# and by the block path; allocated by the first non-zero record, empty at
# k == 1.
var g_box_device_extra_h: [i32] = []

pub fn box_device_extra_h_reset():
    g_box_device_extra_w = []
    g_box_device_dx = []
    g_box_device_extra_h = []

# reason: node index, node count and a device-px delta are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_extra_h_record(node_count: i32, i: i32, extra_device_px: i32):
    if g_layout_device_scale <= 1 or i < 0 or i >= node_count:
        return
    if g_box_device_extra_h.len() != node_count:
        if extra_device_px == 0:
            return
        g_box_device_extra_h = zero_i32_list(node_count)
    g_box_device_extra_h[i] = extra_device_px

# reason: node index in, device-px delta out; both are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_extra_h_at(i: i32) -> i32:
    if i < 0 or i >= g_box_device_extra_h.len(): 0 else: g_box_device_extra_h[i]

# Device-px WIDTH of each box minus k x its CSS width, at device scale k > 1:
# the width twin of `g_box_device_extra_h`, for an auto-width form control.
# Chrome sizes a control in device px (a default text `<input>` is 719 device
# px at k = 4, 4 x its 185 CSS px is 740), so the value is usually negative.
# Only the control's own box takes it: boxes after it on the line keep their
# CSS-snapped x. Empty at k == 1.
var g_box_device_extra_w: [i32] = []

# reason: node index, node count and a device-px delta are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_extra_w_record(node_count: i32, i: i32, extra_device_px: i32):
    if g_layout_device_scale <= 1 or i < 0 or i >= node_count:
        return
    if g_box_device_extra_w.len() != node_count:
        if extra_device_px == 0:
            return
        g_box_device_extra_w = zero_i32_list(node_count)
    g_box_device_extra_w[i] = extra_device_px

# reason: node index in, device-px delta out; both are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_extra_w_at(i: i32) -> i32:
    if i < 0 or i >= g_box_device_extra_w.len(): 0 else: g_box_device_extra_w[i]

# Device-px x shift of an atomic inline box (button, inline-block, replaced)
# at device scale k > 1: k x the inline cursor's exact-minus-integer error
# where the box starts, to the nearest device px. Chrome places the box after
# a 33.785 px `Go` button at device column 135 (k = 4), not at 4 x 34. The
# box's whole subtree moves with it. Empty at k == 1 and until a box needs it.
var g_box_device_dx: [i32] = []

# reason: node index, node count and a device-px delta are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_dx_record(node_count: i32, i: i32, dx_device_px: i32):
    if g_layout_device_scale <= 1 or i < 0 or i >= node_count:
        return
    if g_box_device_dx.len() != node_count:
        if dx_device_px == 0:
            return
        g_box_device_dx = zero_i32_list(node_count)
    g_box_device_dx[i] = dx_device_px

# reason: presence flag for the per-node device dx table, mirrors box_device_top_is_inline_dy in this file
# @allow(primitive_api)
pub fn box_device_dx_any() -> bool:
    g_box_device_dx.len() > 0

# Sum of the shifts of node `i` and its ancestors; 0 when no box has one.
# reason: node index in, device-px delta out; both are layout-array scalars.
# @allow(primitive_api)
pub fn box_device_dx_total(nodes: [HNode], i: i32) -> i32:
    if g_box_device_dx.len() != nodes.len():
        return 0
    var dx = 0
    var r = i
    while r >= 0 and r < g_box_device_dx.len():  # cpu-lane-loop-ok: one ancestor walk per emitted command, k > 1 renders with a shifted box only
        dx = dx + g_box_device_dx[r]
        r = nodes[r].parent as i32
    dx

# True (Chrome LayoutUnit) border-box width of a box minus its whole-px width,
# in milli-px. A flex row snaps an item's EDGES (`CSS Paint`: 73.8125 px at
# 43.5625 is the box 44..117, 73 px), but the item's content is laid out in
# the true width: the 73.8 px label fits and stays on one line. Handed to the
# item's own layout through `g_item_frac_w_pending` (set by the flex row right
# before it lays the item out, consumed on entry) and kept per node for the
# item's text children.
pub val BOX_FRAC_W_UNSET: i32 = -2147483648
var g_item_frac_w_pending: i32 = -2147483648
var g_box_frac_w_milli: [i32] = []

pub fn box_frac_w_reset():
    g_item_frac_w_pending = BOX_FRAC_W_UNSET
    g_box_frac_w_milli = []

# reason: a milli-px width remainder is a layout-array scalar.
# @allow(primitive_api)
pub fn item_frac_w_hand_over(frac_milli: i32):
    g_item_frac_w_pending = frac_milli

# Consumes the pending remainder for node `i`: every layout of a node
# overwrites its entry, so a stale remainder never outlives the pass that set it.
# reason: node index and node count are layout-array scalars.
# @allow(primitive_api)
pub fn box_frac_w_take(node_count: i32, i: i32):
    val frac = g_item_frac_w_pending
    g_item_frac_w_pending = BOX_FRAC_W_UNSET
    if i < 0 or i >= node_count:
        return
    if g_box_frac_w_milli.len() != node_count:
        if frac == BOX_FRAC_W_UNSET:
            return
        g_box_frac_w_milli = [BOX_FRAC_W_UNSET; node_count]
    g_box_frac_w_milli[i] = frac

# reason: node index in, milli-px remainder (or BOX_FRAC_W_UNSET) out.
# @allow(primitive_api)
pub fn box_frac_w_at(i: i32) -> i32:
    if i < 0 or i >= g_box_frac_w_milli.len(): BOX_FRAC_W_UNSET else: g_box_frac_w_milli[i]

# `<input>` types Chrome sizes from `size` columns of text (a text field);
# buttons, range, color, file, image, hidden and the checkable types are not.
# reason: the raw `type` attribute value in, a yes/no out.
# @allow(primitive_api)
pub fn input_type_is_column_sized(input_type: text) -> bool:
    val kind = input_type.trim().lower()
    not (kind == "button" or kind == "submit" or kind == "reset" or kind == "range" or kind == "color" or kind == "file" or kind == "image" or kind == "hidden" or kind == "checkbox" or kind == "radio")

# Device-px width of an auto-width `<select>` minus k x its CSS width: Chrome
# takes the ceiling of the widest label in DEVICE px (`Alpha` at 13.333px is
# 136.41 device px at k = 4 -> 137, where 4 x ceil(34.09) is 140).
# reason: node index in, device-px delta out; both are layout-array scalars.
# @allow(primitive_api)
pub fn select_device_extra_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, select_i: i32) -> i32:
    val k = g_layout_device_scale
    if k <= 1:
        return 0
    val widest_milli = _form_control_widest_option_label_milli(nodes, styles, child_index, select_i)
    (widest_milli * k + 999) / 1000 - k * form_control_widest_option_label_px(nodes, styles, child_index, select_i)

fn _form_control_widest_option_label_milli(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, select_i: i32) -> i32:
    var widest = 0
    var c = child_index.first_child[select_i]
    while c >= 0:  # cpu-lane-loop-ok: one pass over one select's direct children; bound is that child list
        var label_w = 0
        if nodes[c].tag == "optgroup":
            label_w = _form_control_widest_option_label_milli(nodes, styles, child_index, c)
        elif nodes[c].tag == "option":
            var t = child_index.first_child[c]
            while t >= 0:  # cpu-lane-loop-ok: one pass over one option's direct children; bound is that child list
                if nodes[t].tag == "#text":
                    label_w = label_w + form_control_label_width_milli_px(styles[t], nodes[t].text_trimmed)
                t = child_index.next_sibling[t]
        if label_w > widest:
            widest = label_w
        c = child_index.next_sibling[c]
    widest

# Device-px baseline of a text-baseline form control (text `<input>`,
# `<select>`, `<button>`) from its border-box top, minus k x the CSS one. The
# borders and padding scale by k; the control's own strut is the device one
# (13.333px Liberation Sans, `normal`: 12, 24, 35, 48 for k x 12 = 36 at k=3),
# and an auto-height `<select>` has the upper half, rounded up, of its
# round(1.5k) inner block padding above the label (1, 2, 3, 3 for k x 1).
# An auto-height `<button>` is measured from its BOTTOM, like its CSS baseline
# (`inline_widget_baseline_from_top`): the box's device extra height less what
# the device descent of its last line adds (k=2: a 22 px box of 43 device px,
# descent 7 for 2 x 3, so 2 x 16 - 2 = 30).
# Chrome 159 baselines: input / button 15, 30, 44, 60; select 14, 28, 41, 55.
fn form_control_device_baseline_delta(node: HNode, st: Style, k: i32, extra_h: i32) -> i32:
    val strut = inline_line_strut_baseline_offset_device(st, k) - k * inline_line_strut_baseline_offset(st)
    if node.tag == "button" and st.height_px <= 0 and st.min_height_px <= 0 and st.max_height_px <= 0:
        return extra_h - (style_device_line_h_milli(st, k) / 1000 - k * style_line_h(st)) + strut
    if node.tag == "select" and st.height_px <= 0:
        return strut + ((3 * k + 1) / 2 + 1) / 2 - k * (SELECT_INNER_BLOCK_PADDING_PX / 2)
    strut

# What the label text inside a `<select>` moves by against its frame (device
# px, k > 1): the frame takes `form_control_device_baseline_delta` less than
# the line's baseline delta, the label sits on the baseline itself.
# reason: device-px delta out; a layout scalar.
# @allow(primitive_api)
pub fn form_control_label_device_dy(node: HNode, st: Style) -> i32:
    val k = g_layout_device_scale
    if k <= 1 or node.tag != "select":
        return 0
    form_control_device_baseline_delta(node, st, k, 0)

# Device-px height of an auto-height form control minus k x its CSS height
# (Chrome 159, 13.333px Liberation Sans, k = 1..4): the `normal` line is the
# face's per-part rounded sum at the DEVICE size (15, 31, 45, 61), a textarea
# has `rows` of them, and a `<select>` adds round(1.5k) of inner block padding
# (2, 3, 5, 6) where the CSS box has k x SELECT_INNER_BLOCK_PADDING_PX.
# reason: row count in, device-px delta out; both are layout scalars.
# @allow(primitive_api)
pub fn form_control_device_extra_h(node: HNode, st: Style, rows: i32) -> i32:
    val k = g_layout_device_scale
    if k <= 1:
        return 0
    val line_extra = style_device_line_h_milli(st, k) / 1000 - k * style_line_h(st)
    val pad_extra = if node.tag == "select": (3 * k + 1) / 2 - k * SELECT_INNER_BLOCK_PADDING_PX else: 0
    rows * line_extra + pad_extra

# Device mirror of the baseline pass of `align_inline_line_baselines` (k > 1):
# the line ascent and descent from device struts, atomic and widget baselines
# at k x their CSS value (boxes stay CSS-snapped) plus the box's device extra
# height: above the baseline for a box that aligns on its bottom edge, below it
# otherwise. A line holding a top/bottom/text-top/text-bottom box gets no
# correction: its baseline also depends on the line height, which stays in CSS
# px. A `middle` box has no baseline of its own; it only raises the line ascent
# to `middle_ascent64` (1/64 CSS px) when its margin box reaches above
# everything else.
# Returns the line's device height minus k x (css_ascent + css_descent), 0 for
# a line with a valign box.
fn align_inline_line_device_dy(child_index: HtmlChildIndex, line_style: Style, html_nodes: [HNode], nodes: [i32], margin_ts: [i32], margin_bs: [i32], styles: [Style], bh: [i32], css_ascent: i32, css_descent: i32, has_valign: bool, middle_ascent64: i32, line_frac_milli: i32 = 0, origin_frac_milli: i32 = 0) -> i32:
    val k = g_layout_device_scale
    var ascent = inline_line_strut_baseline_offset_device(line_style, k)
    var descent = style_device_line_h_milli(line_style, k) / 1000 - ascent
    # The form controls (and bottom-edge-baseline atomics) on the line and how
    # far each one's device baseline is from k x its CSS baseline.
    var widget_nodes: [i32] = []
    var widget_deltas: [i32] = []
    var i = 0
    while i < nodes.len():
        val node_index = nodes[i]
        val node_style = styles[node_index]
        if inline_atomic_valign(html_nodes[node_index], node_style) == "middle":
            i = i + 1
            continue
        val node_replaced = replaced_media_bottom_edge_tag(html_nodes[node_index].tag)
        val widget_baseline = inline_widget_baseline_from_top(child_index, html_nodes, styles, node_index, bh)
        val extra_h = box_device_extra_h_at(node_index)
        var node_ascent = 0
        var node_descent = 0
        if widget_baseline >= 0:
            val baseline_delta = if widget_baseline >= bh[node_index]: extra_h else: form_control_device_baseline_delta(html_nodes[node_index], node_style, k, extra_h)
            node_ascent = k * (margin_ts[i] + widget_baseline) + baseline_delta
            node_descent = k * (bh[node_index] - widget_baseline + margin_bs[i]) + extra_h - baseline_delta
            widget_nodes.push(node_index)
            widget_deltas.push(baseline_delta)
        elif bottom_edge_baseline(child_index, node_index, node_style, node_replaced):
            node_ascent = k * (margin_ts[i] + bh[node_index] + margin_bs[i]) + extra_h
            # An empty inline-block or an image sits ON the device baseline
            # too (Chrome 159, 16px/1.5 at k=4: a 10 px box spans device
            # rows 30-69 of its line, not 28-67).
            widget_nodes.push(node_index)
            widget_deltas.push(extra_h)
        elif inline_box_is_plain_element(html_nodes[node_index], node_style):
            val node_line_shift = vertical_align_baseline_shift_device(node_style, line_style, k)
            node_ascent = inline_box_shifted_ascent_device(child_index, html_nodes, styles, node_index, k) - node_line_shift
            node_descent = inline_box_shifted_descent_device(child_index, html_nodes, styles, node_index, k) + node_line_shift
        else:
            node_ascent = inline_line_strut_baseline_offset_device(node_style, k)
            node_descent = style_device_line_h_milli(node_style, k) / 1000 - node_ascent
        if node_ascent > ascent:
            ascent = node_ascent
        if node_descent > descent:
            descent = node_descent
        i = i + 1
    val middle_ascent = (k * middle_ascent64 + 32) / 64
    if middle_ascent > ascent:
        ascent = middle_ascent
    val line_delta = if has_valign: 0 else: ascent - k * css_ascent
    # The line starts at the cursor's residual; its container already carries
    # the residual it started at (origin), so only the difference moves the
    # boxes (an svg after an h2 with 19.92px margins: device row 439, not 440).
    val line_start_dy = box_device_top_px(line_frac_milli * k) - box_device_top_px(origin_frac_milli * k)
    # A control hangs from the device baseline by its own device baseline.
    i = 0
    while i < widget_nodes.len():
        box_device_inline_dy_record(html_nodes.len() as i32, widget_nodes[i], if has_valign: 0 else: line_delta - widget_deltas[i] + line_start_dy)
        i = i + 1
    i = 0
    while i < nodes.len():
        _text_device_dy_record_subtree(child_index, html_nodes, styles, nodes[i], line_style, line_style, k, line_delta, if has_valign: 0 else: line_start_dy)
        i = i + 1
    if has_valign: 0 else: ascent + descent - k * (css_ascent + css_descent)

# Line ranges for a `white-space: pre` run: every U+000A is a forced break.
# Two HTML rules are folded in, both harvested from Chrome rather than recalled:
# a single newline IMMEDIATELY after the `<pre>` start tag is dropped
# (`<pre>\nA\nB</pre>` is two lines, not three), and a run that ENDS in a
# newline does not open a trailing empty line.
fn compute_preserved_newline_ranges(txt: text, txt_len: i32) -> LineWrapRanges:
    val tb = txt.bytes()
    var starts: [i32] = []
    var ends: [i32] = []
    var start = if txt_len > 0 and tb[0] == 10: 1 else: 0
    var k = start
    while k < txt_len:  # cpu-lane-loop-ok: one pass over one text run's bytes
        if tb[k] == 10:
            starts.push(start)
            ends.push(k)
            start = k + 1
        k = k + 1
    if start < txt_len or starts.len() == 0:
        starts.push(start)
        ends.push(txt_len)
    LineWrapRanges(starts: starts, ends: ends)

fn zero_i32_list(count: i32) -> [i32]:
    [0; count]

fn neg_one_i32_list(count: i32) -> [i32]:
    [-1; count]

fn shifted_i32_list(values: [i32], delta: i32) -> [i32]:
    val count = values.len()
    var shifted: [i32] = [0; count]
    var i = 0
    while i < count:
        shifted[i] = values[i] + delta
        i = i + 1
    shifted

pub fn empty_i32_lists(count: i32) -> [[i32]]:
    var out: [[i32]] = []
    var i: i32 = 0
    # cpu-lane-loop-ok: allocate distinct mutable i32 bucket per slot
    while i < count:
        var bucket: [i32] = []
        out.push(bucket)
        i = i + 1
    out

fn css_outer_height(node: HNode, st: Style, css_height: i32) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if legacy_widget_box or st.border_box:
        return css_height
    css_height + st.pad_t + st.pad_b + st.border_t + st.border_b

fn definite_content_height_limit(node: HNode, st: Style) -> i32:
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    val border_y = st.border_t + st.border_b
    if st.height_px > 0:
        if legacy_widget_box or st.border_box:
            return st.height_px - st.pad_t - st.pad_b - border_y
        return st.height_px
    if st.min_height_px > 0:
        return st.min_height_px
    0

# `st` with its percentage `min-` / `max-` sizes (negative sentinels, see
# `_decl_percent_sentinel_or_length_px`) resolved to px against the
# containing block: `containing_w` for the widths, `containing_h` for the
# heights. A height percentage against an auto height (`containing_h <= 0`)
# is `none` (CSS 2.2 10.7). Every reader of the clamp slots tests `> 0`, so
# an unresolved sentinel already reads as `none` -- which is what an
# intrinsic (max-content) contribution needs.
fn style_with_resolved_percent_min_max(st: Style, containing_w: i32, containing_h: i32) -> Style:
    if st.min_width_px >= 0 and st.max_width_px >= 0 and st.min_height_px >= 0 and st.max_height_px >= 0:
        return st
    val out = style_with_width(st, st.width_px)
    if st.min_width_px < 0:
        out.min_width_px = if containing_w > 0: containing_w * (0 - st.min_width_px) / 100 else: 0
    if st.max_width_px < 0:
        out.max_width_px = if containing_w > 0: containing_w * (0 - st.max_width_px) / 100 else: 0
    if st.min_height_px < 0:
        out.min_height_px = if containing_h > 0: containing_h * (0 - st.min_height_px) / 100 else: 0
    if st.max_height_px < 0:
        out.max_height_px = if containing_h > 0: containing_h * (0 - st.max_height_px) / 100 else: 0
    out

fn explicit_auto_table_column_offsets(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    table: i32, inner_width: i32, spacing_x: i32, spacing_y: i32,
    fill_available: bool
) -> [i32]:
    # Keep the legacy zero-spacing admission narrow. Authored spacing also
    # admits constrained and spanning cells after their minimum track widths
    # are resolved here, so gaps never force overlapping boxes.
    val has_authored_spacing = spacing_x > 0 or spacing_y > 0
    val rows = simple_web_collect_table_rows(nodes, child_index, table)
    val column_count = simple_web_fixed_table_column_count(
        nodes, child_index, rows
    )
    var widths: [i32] = [0; column_count]
    var col_min: [i32] = [0; column_count]
    # Sub-pixel remainder (milli-px) of each column's max-content width, so the
    # slack split below runs on Chrome's fractional widths, not rounded ones.
    var col_frac: [i32] = [0; column_count]
    # True while the column's max-content width is one this layout measures
    # exactly (table_cell_text_width_exact); the Chrome column edges below are
    # derived only then.
    var col_exact: [bool] = [false; column_count]
    for row in rows.rows:
        var column = 0
        var cell = child_index.first_child[row]
        while cell >= 0:
            if styles[cell].display == "table-cell":
                val span = simple_web_fixed_table_cell_span(
                    nodes[cell], column_count
                )
                val cell_style = styles[cell]
                if not has_authored_spacing and (
                    span != 1 or
                    cell_style.min_width_px > 0 or
                    cell_style.max_width_px > 0
                ):
                    return []
                if span == 1 and column < column_count:
                    var cell_width = if cell_style.width_px > 0:
                        css_outer_width(
                            nodes[cell], cell_style, cell_style.width_px
                        )
                    else:
                        # CSS 2.1 §17.5.2.2: a cell with no stated width sizes
                        # its column from CONTENT, not from a 1px placeholder
                        # that the caller then fills by an equal split. Until
                        # this landed, every table whose cells state no width
                        # bailed out of the auto path entirely (the removed
                        # `cell_style.width_px <= 0` bail above) and got fixed
                        # equal columns — the shape `table_layout_spec` used to
                        # assert and Chrome never produces.
                        table_cell_max_content_width(
                            nodes, styles, child_index, cell
                        )
                    # border-collapse: adjacent cell borders are shared, so a
                    # cell's border-box contributes only half of each vertical
                    # border to its column track (uniform-width borders only —
                    # per-edge winner widths stay outside this admission).
                    if styles[table].border_collapse == "collapse" and cell_width > 1:
                        cell_width = cell_width - (
                            (cell_style.border_l + cell_style.border_r) / 2
                        )
                    if cell_style.max_width_px > 0:
                        val max_width = css_outer_width(
                            nodes[cell], cell_style,
                            cell_style.max_width_px
                        )
                        if cell_width > max_width:
                            cell_width = max_width
                    if cell_style.min_width_px > 0:
                        val min_width = css_outer_width(
                            nodes[cell], cell_style,
                            cell_style.min_width_px
                        )
                        if cell_width < min_width:
                            cell_width = min_width
                    var cell_frac = 0
                    var cell_exact = false
                    if cell_style.width_px <= 0 and cell_style.min_width_px <= 0 and cell_style.max_width_px <= 0:
                        cell_frac = table_cell_text_frac_milli(nodes, styles, child_index, cell)
                        cell_exact = table_cell_text_width_exact(nodes, styles, child_index, cell)
                    if cell_width > widths[column]:
                        widths[column] = cell_width
                        col_frac[column] = cell_frac
                        col_exact[column] = cell_exact
                    elif cell_width == widths[column]:
                        if cell_frac > col_frac[column]:
                            col_frac[column] = cell_frac
                        if not cell_exact:
                            col_exact[column] = false
                    # The column's FLOOR. A cell with a stated width is its own
                    # floor; an auto cell's floor is its longest unbreakable
                    # word. Never above the ceiling just computed.
                    var cell_min = if cell_style.width_px > 0:
                        cell_width
                    else:
                        table_cell_min_content_width(
                            nodes, styles, child_index, cell
                        )
                    if cell_style.min_width_px > 0:
                        val floor_width = css_outer_width(
                            nodes[cell], cell_style, cell_style.min_width_px
                        )
                        if cell_min < floor_width:
                            cell_min = floor_width
                    if cell_min > cell_width:
                        cell_min = cell_width
                    if cell_min > col_min[column]:
                        col_min[column] = cell_min
                column = column + span
            cell = child_index.next_sibling[cell]
    if has_authored_spacing:
        for row in rows.rows:
            var span_column = 0
            var span_cell = child_index.first_child[row]
            while span_cell >= 0:
                if styles[span_cell].display == "table-cell":
                    val span = simple_web_fixed_table_cell_span(
                        nodes[span_cell], column_count
                    )
                    val next_column = if span_column + span < column_count:
                        span_column + span
                    else:
                        column_count
                    if span > 1 and span_column < column_count:
                        val span_style = styles[span_cell]
                        var required_width = if span_style.width_px > 0:
                            css_outer_width(
                                nodes[span_cell], span_style,
                                span_style.width_px
                            )
                        else:
                            0
                        if span_style.min_width_px > 0:
                            val span_min_width = css_outer_width(
                                nodes[span_cell], span_style,
                                span_style.min_width_px
                            )
                            if required_width < span_min_width:
                                required_width = span_min_width
                        var current_width = (
                            spacing_x * (next_column - span_column - 1)
                        )
                        var width_column = span_column
                        while width_column < next_column:
                            current_width = current_width + widths[width_column]
                            width_column = width_column + 1
                        if required_width > current_width:
                            val deficit = required_width - current_width
                            val span_count = next_column - span_column
                            val grow_each = deficit / span_count
                            val grow_remainder = (
                                deficit - grow_each * span_count
                            )
                            var grow_column = span_column
                            while grow_column < next_column:
                                val grow_share = grow_each + (if (
                                    grow_column - span_column < grow_remainder
                                ): 1 else: 0)
                                widths[grow_column] = (
                                    widths[grow_column] + grow_share
                                )
                                # The floor rises with the ceiling: a spanning
                                # cell's stated requirement is a requirement in
                                # both directions, or the columns it covers
                                # could be compressed back below it.
                                col_min[grow_column] = (
                                    col_min[grow_column] + grow_share
                                )
                                col_exact[grow_column] = false
                                grow_column = grow_column + 1
                    span_column = next_column
                span_cell = child_index.next_sibling[span_cell]
    var sum_max = 0
    var c_i = 0
    while c_i < column_count:
        if widths[c_i] <= 0:
            return []
        if col_min[c_i] > widths[c_i]:
            col_min[c_i] = widths[c_i]
        sum_max = sum_max + widths[c_i]
        c_i = c_i + 1
    # CSS 2.1 §17.5.2: a table with a stated width FILLS it; a `width: auto`
    # table is as wide as its content but never wider than the space it has —
    # past that ceiling its columns compress between their min- and
    # max-content widths instead of overflowing the containing block. The
    # distribution itself is `table_distribute_auto_columns`, the same function
    # the M14 spec-facing `layout_table` calls, so the two lanes resolve
    # columns by one rule rather than two that drift.
    var available = inner_width - spacing_x * (column_count + 1)
    if available < column_count:
        available = column_count
    # CAPMIN (CSS 2.1 §17.5.2): the used width of a `width: auto` table is at
    # least the min-content width of its CAPTION. Without this the caption is
    # laid out at the shrink-to-fit table width and wraps — measured on the
    # `html` catalog page, "Table caption" over a one-word cell wrapped to two
    # lines (48 px against Chrome's 24) and pushed every later element on the
    # page down. Chrome widens the table instead.
    var capmin = 0
    var cap_child = child_index.first_child[table]
    while cap_child >= 0:  # cpu-lane-loop-ok: one pass over the table's own children
        if styles[cap_child].display == "table-caption":
            val cap_w = table_cell_min_content_width(
                nodes, styles, child_index, cap_child
            ) - spacing_x * (column_count + 1)
            if cap_w > capmin:
                capmin = cap_w
        cap_child = child_index.next_sibling[cap_child]
    val target = if fill_available:
        available
    elif sum_max <= available:
        if capmin > sum_max:
            if capmin < available: capmin else: available
        else:
            0
    else:
        available
    # Distribute in milli-px; only the cumulative column edges round to px.
    var max_milli: [i32] = []
    var min_milli: [i32] = []
    var milli_column = 0
    while milli_column < column_count:
        val hi_milli = widths[milli_column] * 1000 + col_frac[milli_column]
        val lo_milli = col_min[milli_column] * 1000
        max_milli.push(hi_milli)
        min_milli.push(if lo_milli < hi_milli: lo_milli else: hi_milli)
        milli_column = milli_column + 1
    val used = table_distribute_auto_columns(min_milli, max_milli, target * 1000)
    if used.len() != column_count:
        return []
    var offsets: [i32] = [0; column_count + 1]
    var offset_column = 0
    var edge_milli = 0
    while offset_column < column_count:
        edge_milli = edge_milli + used[offset_column]
        offsets[offset_column + 1] = (edge_milli + 500) / 1000
        offset_column = offset_column + 1
    g_table_column_edge_frac_milli = table_column_edge_frac_milli(
        max_milli, col_exact, target, offsets
    )
    offsets

# Chrome 159 column edges minus the whole-pixel `offsets` (milli-px), one per
# column's LEFT edge; empty when they are not known. Chrome sizes auto columns
# in LayoutUnits (1/64 px): a table with room to spare gives column i
# `floor(width * max_i / sum(max))` (the last one takes the rest), and a
# shrink-to-fit table gives each its max-content width. Measured on
# `width:61px` over cells 455/64, 228/64, 228/64 wide: edges 0, 1949, 2926
# (table_cell_pen_origin_chrome159_spec). Known only when every column's
# max-content width is exact and the columns are not being compressed.
# reason: per-column milli-px and px tables from the column distribution.
# @allow(primitive_api)
fn table_column_edge_frac_milli(max_milli: [i32], col_exact: [bool], target: i32, offsets: [i32]) -> [i32]:
    val column_count = max_milli.len().to_i32()
    var max64: [i64] = []
    var sum64: i64 = 0
    var column = 0
    while column < column_count:
        if not col_exact[column]:
            return []
        val unit = ((max_milli[column] as i64) * 64 + 500) / 1000
        max64.push(unit)
        sum64 = sum64 + unit
        column = column + 1
    val total64 = (target as i64) * 64
    if sum64 <= 0 or (target != 0 and total64 < sum64):
        return []
    var fracs: [i32] = []
    var edge64: i64 = 0
    column = 0
    while column < column_count:
        fracs.push(((edge64 * 1000) / 64 - (offsets[column] as i64) * 1000) as i32)
        edge64 = edge64 + (if target == 0: max64[column] else: total64 * max64[column] / sum64)
        column = column + 1
    fracs

# True when `table_cell_text_frac_milli` measured the cell: its max-content
# width is one text run at milli precision.
fn table_cell_text_width_exact(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> bool:
    val only = child_index.first_child[cell]
    if only < 0 or child_index.next_sibling[only] >= 0 or nodes[only].tag != "#text":
        return false
    val st = styles[only]
    nodes[only].text_trimmed.len() > 0 and st.resolved_font_width > 0 and st.resolved_font_width_milli >= 0

# Sub-pixel remainder (milli-px, -500..500) of a table cell's max-content text
# width when the cell holds exactly one text run measured at milli precision;
# 0 otherwise. The integer width is the rounding of the exact one.
fn table_cell_text_frac_milli(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    val only = child_index.first_child[cell]
    if only < 0 or child_index.next_sibling[only] >= 0 or nodes[only].tag != "#text":
        return 0
    val st = styles[only]
    if nodes[only].text_trimmed.len() == 0 or st.resolved_font_width <= 0 or st.resolved_font_width_milli < 0:
        return 0
    val frac = st.resolved_font_width_milli - (st.resolved_font_width as i64) * 1000
    if frac > 500 or frac < -500: 0 else: frac as i32

fn constrained_outer_height(node: HNode, st: Style, candidate_height: i32) -> i32:
    var out = candidate_height
    if st.min_height_px > 0:
        val min_outer = css_outer_height(node, st, st.min_height_px)
        if out < min_outer:
            out = min_outer
    if st.max_height_px > 0:
        val max_outer = css_outer_height(node, st, st.max_height_px)
        if out > max_outer:
            out = max_outer
    if out < 1:
        out = 1
    out

fn absolute_outer_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, node_i: i32, parent: Style, node: HNode, authored_st: Style, containing_w: i32) -> i32:
    val st = style_with_resolved_percent_min_max(style_with_resolved_percent_padding(authored_st, containing_w + parent.pad_l + parent.pad_r), containing_w + parent.pad_l + parent.pad_r, 0)
    # `left` is SET (`left:0` / `inset:0` count), not merely positive; a
    # replaced box keeps its intrinsic width (Chrome 159: `<canvas>` with
    # `inset:0` stays 300 wide, a `<div>` or `<input>` stretches).
    if st.width_px == 0 and not st.width_zero and not authored_st.left_auto and st.right_px >= 0 and not absolute_replaced_tag(node.tag):
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        var stretched = padding_box_w - st.left_px - st.right_px - absolute_margin_x(st, padding_box_w)
        if stretched < 1:
            stretched = 1
        return constrained_outer_width(node, st, stretched)
    if st.width_px < 0:
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        val percent_content_w = padding_box_w * (0 - st.width_px) / 100
        return constrained_outer_width(node, st, css_outer_width(node, st, percent_content_w))
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    if st.width_px > 0 or st.width_zero:
        return constrained_outer_width(node, st, explicit_node_w)
    # CSS 2.1 10.3.7: `width: auto` on an absolutely positioned, non-replaced
    # box is SHRINK-TO-FIT, not "fill the containing block". The stretch case is
    # only reachable when BOTH `left` and `right` are given, and that arm is the
    # first branch above. Falling through to the containing block made every
    # `width:auto` absolute box as wide as its containing block, which then also
    # dragged its x through the `right` formula in absolute_child_x (measured on
    # the catalog's one absolute box: w 810 instead of 77, x 35 instead of 769).
    #
    # shrink-to-fit = min(max(preferred-minimum, available), preferred).
    # `preferred` is the same max-content measurement <select> already uses for
    # its intrinsic width, so no new measurement surface is introduced here.
    #
    # AVAILABLE is not the whole containing block: 10.3.7 takes it as the
    # containing block MINUS whichever of left/right is specified, because that
    # offset is already committed. Harvested from Chrome on a fixture where the
    # content overflows (`right: 10px`, text far wider than the block): Chrome
    # clamps to 890 in a 900 px block, not to 900. Only the overflow case can
    # see this, which is why it is taken from a measurement rather than assumed.
    val padding_box_w = containing_w + parent.pad_l + parent.pad_r
    var available = padding_box_w
    if st.right_px >= 0:
        available = available - st.right_px
    if st.left_px > 0:
        available = available - st.left_px
    if replaced_default_box_w(node.tag) > 0:
        # 10.3.8: a replaced box is not shrink-to-fit. Chrome 159: an
        # absolute viewBox-only svg in a 500 px containing block is 500x500.
        return constrained_outer_width(node, st, replaced_auto_box_w(node, st, available))
    var shrink_to_fit = flex_item_max_content_width(nodes, styles, child_index, node_i) + percent_padding_extra_w(styles[node_i], st)
    if shrink_to_fit > available:
        shrink_to_fit = available
    if shrink_to_fit < 1:
        shrink_to_fit = 1
    constrained_outer_width(node, st, shrink_to_fit)

fn absolute_outer_height(node: HNode, st: Style, containing_h: i32) -> i32:
    val border_y = st.border_t + st.border_b
    val resolved_h = resolve_percent_height_px(st.height_px, containing_h)
    if resolved_h > 0:
        if st.border_box:
            return constrained_outer_height(node, st, resolved_h)
        return constrained_outer_height(node, st, resolved_h + st.pad_t + st.pad_b + border_y)
    constrained_outer_height(node, st, style_line_h(st))

fn resolve_horizontal_margin_px(margin_px: i32, containing_w: i32) -> i32:
    if margin_px < 0:
        return containing_w * (0 - margin_px) / 100
    margin_px

fn resolve_percent_height_px(height_px: i32, containing_h: i32) -> i32:
    if height_px < 0 and containing_h > 0:
        return containing_h * (0 - height_px) / 100
    height_px

fn resolve_vertical_margin_px(margin_px: i32, viewport_h: i32) -> i32:
    # margin_px <= -1000 is the vh-percentage sentinel (see margin_token_vh_px);
    # anything else, including -999..-1, is a literal (possibly negative) px
    # margin and must pass through unchanged for CSS 2.2 8.3.1 collapsing to
    # see the true sign.
    if margin_px <= -1000:
        return viewport_h * ((0 - margin_px) - 1000) / 100
    margin_px

# Block-axis margin in milli-px (Chrome LayoutUnit carries 1/64 px). The ONE
# place that turns a Style's vertical margin into the value the block cursor
# collapses and advances by: a cascaded fraction (UA h1-h6 em margins) wins,
# otherwise the whole-px margin (vh sentinel resolved) times 1000. A NEGATIVE
# milli is an author percent (-(percent x 1000), see _decl_vertical_margin_milli):
# CSS 2.2 8.3 resolves it against the containing block WIDTH `containing_w`,
# floored to Chrome's 1/64 px LayoutUnit.
fn block_margin_milli(st: Style, top: bool, viewport_h: i32, containing_w: i32) -> i32:
    val px = if top: st.margin_t else: st.margin_b
    val milli = if top: st.margin_t_milli else: st.margin_b_milli
    if milli < 0:
        val exact = (containing_w as i64) * (0 - milli).to_i64() / 100
        return ((exact * 64) / 1000 * 1000 / 64) as i32
    if milli != 0 and px >= 0:
        return milli
    resolve_vertical_margin_px(px, viewport_h) * 1000

# Whole-px vertical margin for layout paths with no fractional cursor: a
# percent margin (negative milli) resolves against `containing_w` and floors
# to px; every other form keeps the legacy whole-px reading.
fn vertical_margin_px_in(st: Style, top: bool, viewport_h: i32, containing_w: i32) -> i32:
    val milli = if top: st.margin_t_milli else: st.margin_b_milli
    if milli < 0:
        return block_margin_milli(st, top, viewport_h, containing_w) / 1000
    resolve_vertical_margin_px(if top: st.margin_t else: st.margin_b, viewport_h)

# Layout paths with no fractional cursor (flex, absolute, float, inline-block,
# grid) read only the whole-px `margin_t` / `margin_b`. A percent margin (a
# negative milli) is resolved here against the containing block width and
# floored to whole px, with the milli cleared so no reader sees it twice.
fn style_with_resolved_percent_margins(st: Style, containing_w: i32, viewport_h: i32) -> Style:
    if st.margin_t_milli >= 0 and st.margin_b_milli >= 0:
        return st
    val out = style_with_width(st, st.width_px)
    if st.margin_t_milli < 0:
        out.margin_t = vertical_margin_px_in(st, true, viewport_h, containing_w)
        out.margin_t_milli = 0
    if st.margin_b_milli < 0:
        out.margin_b = vertical_margin_px_in(st, false, viewport_h, containing_w)
        out.margin_b_milli = 0
    out

# Percent padding (`Style.pad_*_pct`, percent x 1000) resolves on all four
# sides against the containing block INLINE size (CSS 2.2 8.4): `containing_w`
# is the parent content width, a grid area width, or the padding box for an
# absolutely positioned box. Rounded to the nearest whole px (Chrome keeps
# 1/64 px and snaps at paint; flooring put the content up to 1 px early); the
# percent slots are cleared so no reader resolves twice.
fn style_with_resolved_percent_padding(st: Style, containing_w: i32) -> Style:
    if st.pad_l_pct == 0 and st.pad_t_pct == 0 and st.pad_r_pct == 0 and st.pad_b_pct == 0:
        return st
    val out = style_with_width(st, st.width_px)
    val basis = if containing_w > 0: containing_w as i64 else: 0
    if st.pad_l_pct > 0:
        out.pad_l = ((basis * (st.pad_l_pct as i64) + 50000) / 100000) as i32
    if st.pad_t_pct > 0:
        out.pad_t = ((basis * (st.pad_t_pct as i64) + 50000) / 100000) as i32
    if st.pad_r_pct > 0:
        out.pad_r = ((basis * (st.pad_r_pct as i64) + 50000) / 100000) as i32
    if st.pad_b_pct > 0:
        out.pad_b = ((basis * (st.pad_b_pct as i64) + 50000) / 100000) as i32
    out.pad_l_pct = 0
    out.pad_t_pct = 0
    out.pad_r_pct = 0
    out.pad_b_pct = 0
    out

# Horizontal px a percent padding adds once resolved. Intrinsic (max-content)
# walks read the authored style, where a percent padding is still 0, so a
# shrink-to-fit width adds this to the measured content.
fn percent_padding_extra_w(authored: Style, resolved: Style) -> i32:
    resolved.pad_l - authored.pad_l + resolved.pad_r - authored.pad_r

fn absolute_child_x(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, child_i: i32, parent_x: i32, parent: Style, child_node: HNode, child: Style, containing_w: i32, viewport_w: i32) -> i32:
    # position:fixed: both insets are measured from the viewport, not the
    # nearest ancestor (CSS 2.2 10.1 makes the viewport the fixed containing
    # block). The right branch must be checked with the viewport width before
    # the ancestor-anchored absolute formula below can fire.
    if child.position_fixed:
        if child.right_px >= 0 and child.left_auto:
            return viewport_w - absolute_outer_width(nodes, styles, child_index, child_i, parent, child_node, child, containing_w) - child.right_px - absolute_margin_r(child, viewport_w) + absolute_auto_inset_shift(child.left_auto, child.left_px)
        return child.left_px + absolute_margin_l(child, viewport_w)
    # CSS 2.2 10.1: with no positioned ancestor the containing block is the
    # initial containing block at the layout origin, so an authored `left`
    # is not measured from the (static) parent. `left: auto` keeps the
    # parent-relative static-position approximation below.
    if not child.left_auto and not absolute_has_positioned_ancestor(nodes, styles, child_i):
        return child.left_px + absolute_margin_l(child, containing_w + parent.pad_l + parent.pad_r)
    # Both insets with a definite width over-constrain the box; `right` is
    # ignored when the containing block is ltr and `left` when it is rtl
    # (CSS 2.2 10.3.7). With `width:auto` the box stretches instead and
    # `left` places it in either direction.
    val definite_w = child.width_px != 0 or child.width_zero
    if child.right_px >= 0 and (child.left_auto or (definite_w and absolute_containing_block_rtl(nodes, styles, child_i))):
        val padding_box_w = containing_w + parent.pad_l + parent.pad_r
        return parent_x + parent.border_l + padding_box_w - absolute_outer_width(nodes, styles, child_index, child_i, parent, child_node, child, containing_w) - child.right_px - absolute_margin_r(child, padding_box_w) + absolute_auto_inset_shift(child.left_auto, child.left_px)
    parent_x + parent.border_l + child.left_px + absolute_margin_l(child, containing_w + parent.pad_l + parent.pad_r)

# Content width an absolute box's insets and percentages resolve against:
# the parent's content box, or the viewport for position:fixed (CSS 2.2
# 10.1). The callers add the parent's horizontal padding back.
# What an `auto` inset still holds: decl_apply folds an abspos box's
# translation into `left` / `top` (px or milli), which `auto` otherwise
# leaves 0, so a box placed from `right` / `bottom` still moves by it.
fn absolute_auto_inset_shift(inset_auto: bool, v: i32) -> i32:
    if inset_auto: v else: 0

fn absolute_containing_width(parent: Style, child: Style, content_w: i32, viewport_w: i32) -> i32:
    if child.position_fixed and viewport_w > 0:
        return viewport_w - parent.pad_l - parent.pad_r
    content_w

fn absolute_replaced_tag(tag: text) -> bool:
    tag == "canvas" or tag == "img" or tag == "video" or tag == "svg" or tag == "iframe" or tag == "embed" or tag == "object" or tag == "audio"

# Direction of the containing block of the absolute box `node_i`: its
# nearest positioned ancestor (Chrome 159: an ltr wrapper inside an rtl
# containing block does not make it ltr).
fn absolute_containing_block_rtl(nodes: [HNode], styles: [Style], node_i: i32) -> bool:
    var a = nodes[node_i].parent
    var root_rtl = false
    while a >= 0:
        val ast = styles[a]
        if ast.position_relative or ast.position_absolute or ast.position_sticky or ast.position_fixed:
            return ast.direction_rtl
        root_rtl = ast.direction_rtl
        a = nodes[a].parent
    root_rtl

# True when some ancestor of `node_i` establishes an absolute containing block
# (any non-static position). Transforms/containment are not modelled here.
fn absolute_has_positioned_ancestor(nodes: [HNode], styles: [Style], node_i: i32) -> bool:
    var a = nodes[node_i].parent
    while a >= 0:
        val ast = styles[a]
        if ast.position_relative or ast.position_absolute or ast.position_sticky or ast.position_fixed:
            return true
        a = nodes[a].parent
    false

fn absolute_child_y(nodes: [HNode], styles: [Style], child_i: i32, parent_y: i32, parent: Style, child_node: HNode, child: Style, containing_h: i32, viewport_h: i32) -> i32:
    # Mirror of absolute_child_x: a fixed box's bottom inset resolves against
    # the viewport height, not the nearest ancestor's content height.
    # With both `top` and `bottom` set, `top` wins (CSS 2.2 10.6.4).
    if child.position_fixed:
        if child.bottom_px >= 0 and child.top_auto:
            return viewport_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px - absolute_margin_b(child) + absolute_auto_inset_shift(child.top_auto, child.top_px)
        return child.top_px + absolute_margin_t(child)
    # Same initial-containing-block rule as absolute_child_x: with no
    # positioned ancestor `top` is measured from the layout origin and
    # `bottom` from the viewport bottom (Chrome 159: `bottom:10px` in a
    # 300 px viewport is y 280 whatever the body holds).
    if not absolute_has_positioned_ancestor(nodes, styles, child_i):
        if not child.top_auto:
            return child.top_px + absolute_margin_t(child)
        if child.bottom_px >= 0 and viewport_h > 0:
            return viewport_h - absolute_outer_height(child_node, child, viewport_h) - child.bottom_px - absolute_margin_b(child) + absolute_auto_inset_shift(child.top_auto, child.top_px)
    # Both insets with a definite height over-constrain the box; `bottom`
    # is ignored (CSS 2.2 10.6.4).
    if child.bottom_px >= 0 and child.top_auto:
        return parent_y + parent.border_t + containing_h - absolute_outer_height(child_node, child, containing_h) - child.bottom_px - absolute_margin_b(child) + absolute_auto_inset_shift(child.top_auto, child.top_px)
    parent_y + parent.border_t + child.top_px + absolute_margin_t(child)

# Sub-pixel part (milli-px) of the x `absolute_child_x` returns as whole px,
# branch for branch: the fraction of the inset that placed the box (`right`
# and the box's own auto-width fraction `auto_w_frac_milli` count leftwards),
# plus `parent_err_milli`, the containing block's own content-edge fraction,
# when the box is placed against its parent and not the viewport / initial
# containing block. Chrome keeps the sum in LayoutUnits (1/64 px).
# reason: node index and milli-px fractions are layout-array scalars.
# @allow(primitive_api)
pub fn absolute_child_x_frac_milli(nodes: [HNode], styles: [Style], child_i: i32, child: Style, auto_w_frac_milli: i32, parent_err_milli: i32) -> i32:
    if child.position_fixed:
        if child.right_px >= 0 and child.left_auto:
            return 0 - child.right_milli - auto_w_frac_milli + absolute_auto_inset_shift(child.left_auto, child.left_milli)
        return child.left_milli
    if not child.left_auto and not absolute_has_positioned_ancestor(nodes, styles, child_i):
        return child.left_milli
    val definite_w = child.width_px != 0 or child.width_zero
    if child.right_px >= 0 and (child.left_auto or (definite_w and absolute_containing_block_rtl(nodes, styles, child_i))):
        return parent_err_milli - child.right_milli - auto_w_frac_milli + absolute_auto_inset_shift(child.left_auto, child.left_milli)
    parent_err_milli + child.left_milli

# The y twin of `absolute_child_x_frac_milli` for `absolute_child_y`.
# reason: node index and milli-px fractions are layout-array scalars.
# @allow(primitive_api)
pub fn absolute_child_y_frac_milli(nodes: [HNode], styles: [Style], child_i: i32, child: Style, parent_frac_milli: i32) -> i32:
    if child.position_fixed:
        if child.bottom_px >= 0 and child.top_auto:
            return 0 - child.bottom_milli + absolute_auto_inset_shift(child.top_auto, child.top_milli)
        return child.top_milli
    if not absolute_has_positioned_ancestor(nodes, styles, child_i):
        if not child.top_auto:
            return child.top_milli
        if child.bottom_px >= 0:
            return 0 - child.bottom_milli + absolute_auto_inset_shift(child.top_auto, child.top_milli)
    if child.bottom_px >= 0 and child.top_auto:
        return parent_frac_milli - child.bottom_milli + absolute_auto_inset_shift(child.top_auto, child.top_milli)
    parent_frac_milli + child.top_milli

fn absolute_child_style(parent: Style, child: Style, containing_w: i32, containing_h: i32, tag: text) -> Style:
    # Percentages of an abspos box are of the containing block's padding box.
    val padding_box_w = containing_w + parent.pad_l + parent.pad_r
    var resolved_child = style_with_resolved_percent_min_max(style_with_resolved_percent_margins(style_with_resolved_percent_padding(child, padding_box_w), padding_box_w, 0), padding_box_w, containing_h)
    if child.width_px < 0:
        val child_width_px = padding_box_w * (0 - child.width_px) / 100
        resolved_child = style_with_width(resolved_child, child_width_px)
    val child_height_px = resolve_percent_height_px(child.height_px, containing_h)
    if child_height_px > 0 and child_height_px != resolved_child.height_px:
        resolved_child = style_with_height(resolved_child, child_height_px)
    # `top` and `bottom` with an auto height stretch the box over the
    # containing padding box (CSS 2.2 10.6.4); a replaced element keeps its
    # intrinsic height, as it keeps its width in absolute_outer_width.
    if child.height_auto and child.height_px == 0 and not child.top_auto and child.bottom_px >= 0 and not absolute_replaced_tag(tag):
        val outer_h = containing_h - child.top_px - child.bottom_px - absolute_margin_t(child) - absolute_margin_b(child)
        val frame_h = child.pad_t + child.pad_b + child.border_t + child.border_b
        var stretched_h = if child.border_box: outer_h else: outer_h - frame_h
        if stretched_h < 1:
            stretched_h = 1
        resolved_child = style_with_height(resolved_child, stretched_h)
    resolved_child

# Used margins of an absolute box (CSS 2.2 10.3.7 / 10.6.4): `auto` is 0
# here, a percentage is of the containing block width. ponytail: vh vertical
# margins resolve to 0 (no viewport here); thread viewport_h when needed.
fn absolute_margin_l(st: Style, cb_w: i32) -> i32:
    if st.margin_l_auto: 0 else: resolve_horizontal_margin_px(st.margin_l, cb_w)

fn absolute_margin_r(st: Style, cb_w: i32) -> i32:
    if st.margin_r_auto: 0 else: resolve_horizontal_margin_px(st.margin_r, cb_w)

fn absolute_margin_x(st: Style, cb_w: i32) -> i32:
    absolute_margin_l(st, cb_w) + absolute_margin_r(st, cb_w)

fn absolute_margin_t(st: Style) -> i32:
    if st.margin_t_auto: 0 else: resolve_vertical_margin_px(st.margin_t, 0)

fn absolute_margin_b(st: Style) -> i32:
    if st.margin_b_auto: 0 else: resolve_vertical_margin_px(st.margin_b, 0)

# Resolves a normalized track list (space-separated "Npx" / "Nfr" tokens,
# see normalized_grid_track_list in
# simple_web_html_layout_renderer_declarations.spl) into concrete pixel
# sizes. Fixed (px) tracks keep their declared size; the space remaining in
# `available_w` after subtracting fixed track sizes and inter-track gaps is
# distributed across `fr` tracks proportional to their flex factor — CSS
# Grid SS11.5 "Resolving Flexible Track Sizes", simplified: no min-content
# clamping and no `minmax()` support (see
# doc/08_tracking/bug/browser_engine_grid_fr_track_unit_unsupported_2026-08-07.md).
fn _lay_grid_track_sizes_inner(raw: text, available_w: i32, gap: i32) -> [i32]:
    var tokens: [text] = []
    var is_fr: [bool] = []
    var fixed_sum = 0
    var fr_total = 0
    for part in raw.split(" "):
        val token = part.trim()
        if token == "":
            continue
        if token.ends_with("fr") and token.len() > 2:
            val factor = parse_int(token)
            if factor <= 0:
                return []
            tokens.push(token)
            is_fr.push(true)
            fr_total = fr_total + factor
        else:
            val size = parse_int(token)
            if size <= 0:
                return []
            tokens.push(token)
            is_fr.push(false)
            fixed_sum = fixed_sum + size
    val track_count = tokens.len() as i32
    if track_count == 0:
        return []
    var free_space = available_w - fixed_sum - gap * (track_count - 1)
    if free_space < 0:
        free_space = 0
    var sizes: [i32] = []
    var idx = 0
    while idx < tokens.len():
        if is_fr[idx]:
            val factor = parse_int(tokens[idx])
            val fr_size = if fr_total > 0: free_space * factor / fr_total else: 0
            sizes.push(fr_size)
        else:
            sizes.push(parse_int(tokens[idx]))
        idx = idx + 1
    sizes

fn grid_placement_start(raw: text) -> i32:
    val value = raw.trim()
    if value == "":
        return -1
    val slash = find_from(value, "/", 0)
    val first = if slash >= 0:
        value.substring(0, slash).trim()
    else:
        value
    # A leading `span N` has an auto start (parse_int would read the N).
    if first.starts_with("span "):
        return -1
    val line = parse_int(first)
    if line > 0: line - 1 else: -1

fn grid_placement_span(raw: text) -> i32:
    val value = raw.trim()
    val slash = find_from(value, "/", 0)
    if slash < 0:
        # A bare `span N` (auto start, normalized_grid_placement).
        if value.starts_with("span "):
            val bare_span = parse_int(value.substring(5, value.byte_len()).trim())
            return if bare_span > 0: bare_span else: 1
        return 1
    val start = parse_int(value.substring(0, slash).trim())
    val tail = value.substring(slash + 1, value.byte_len()).trim()
    if tail.starts_with("span "):
        val span = parse_int(tail.substring(5, tail.byte_len()).trim())
        return if span > 0: span else: 1
    val end_line = parse_int(tail)
    if start > 0 and end_line > start: end_line - start else: 1

fn grid_track_offset(sizes: [i32], gap: i32, track: i32) -> i32:
    var offset = 0
    var index = 0
    while index < track and index < sizes.len():
        offset = offset + sizes[index] + gap
        index = index + 1
    offset

fn grid_track_span_size(
    sizes: [i32], gap: i32, start: i32, span: i32
) -> i32:
    var size = 0
    var index = 0
    while index < span and start + index < sizes.len():
        if index > 0:
            size = size + gap
        size = size + sizes[start + index]
        index = index + 1
    size

# A single `grid-template-areas` named area resolved to its (0-based)
# track range, e.g. "right" in `"left right"` -> row_start:0, col_start:1,
# row_span:1, col_span:1.
class GridAreaRect:
    area: text
    row_start: i32
    col_start: i32
    row_span: i32
    col_span: i32

# Parses a normalized `grid-template-areas` string (rows joined by "|",
# cells within a row space-separated -- see normalized_grid_template_areas
# in simple_web_html_layout_renderer_declarations.spl) into the list of
# named area rectangles it declares. Only rectangular areas are recognized
# (CSS Grid SS7.1 "Named Areas"): a name whose occupied cells don't form a
# solid rectangle is dropped -- silently, per this renderer's existing
# lenient-CSS convention -- and a `grid-area` reference to a dropped name
# falls through to numeric/auto placement. No dot-cell (`.`) handling beyond
# treating it as an empty/unnamed cell, and no implicit-track creation
# beyond what the template's own row/column count implies. See
# doc/08_tracking/bug/browser_engine_grid_template_areas_missing_2026-08.md.
fn grid_template_area_rects(raw: text) -> [GridAreaRect]:
    var result: [GridAreaRect] = []
    if raw == "":
        return result
    val rows = raw.split("|")
    var names: [text] = []
    var min_rows: [i32] = []
    var max_rows: [i32] = []
    var min_cols: [i32] = []
    var max_cols: [i32] = []
    var row_idx = 0
    while row_idx < rows.len():
        val cols = rows[row_idx].split(" ")
        var col_idx = 0
        while col_idx < cols.len():
            val name = cols[col_idx].trim()
            if name != "" and name != ".":
                var found = -1
                var k = 0
                while k < names.len():
                    if names[k] == name:
                        found = k
                    k = k + 1
                if found < 0:
                    names.push(name)
                    min_rows.push(row_idx as i32)
                    max_rows.push(row_idx as i32)
                    min_cols.push(col_idx as i32)
                    max_cols.push(col_idx as i32)
                else:
                    if (row_idx as i32) < min_rows[found]:
                        min_rows[found] = row_idx as i32
                    if (row_idx as i32) > max_rows[found]:
                        max_rows[found] = row_idx as i32
                    if (col_idx as i32) < min_cols[found]:
                        min_cols[found] = col_idx as i32
                    if (col_idx as i32) > max_cols[found]:
                        max_cols[found] = col_idx as i32
            col_idx = col_idx + 1
        row_idx = row_idx + 1
    var i = 0
    while i < names.len():
        var valid = true
        var rr = min_rows[i]
        while rr <= max_rows[i] and valid:
            val cols = rows[rr].split(" ")
            var cc = min_cols[i]
            while cc <= max_cols[i] and valid:
                if (cc as i64) >= cols.len() or cols[cc].trim() != names[i]:
                    valid = false
                cc = cc + 1
            rr = rr + 1
        if valid:
            result.push(GridAreaRect(
                area: names[i], row_start: min_rows[i], col_start: min_cols[i],
                row_span: max_rows[i] - min_rows[i] + 1,
                col_span: max_cols[i] - min_cols[i] + 1
            ))
        i = i + 1
    result

fn table_cell_max_content_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    if not _wsc_on:
        return _lay_table_cell_max_content_width_inner(nodes, styles, child_index, cell)
    val t0 = _wsc_now_us()
    val out = _lay_table_cell_max_content_width_inner(nodes, styles, child_index, cell)
    _wlay_add(5, _wsc_now_us() - t0, 1)
    out

fn table_cell_min_content_width(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, cell: i32) -> i32:
    if not _wsc_on:
        return _lay_table_cell_min_content_width_inner(nodes, styles, child_index, cell)
    val t0 = _wsc_now_us()
    val out = _lay_table_cell_min_content_width_inner(nodes, styles, child_index, cell)
    _wlay_add(5, _wsc_now_us() - t0, 1)
    out

fn grid_track_sizes(raw: text, available_w: i32, gap: i32) -> [i32]:
    if not _wsc_on:
        return _lay_grid_track_sizes_inner(raw, available_w, gap)
    val t0 = _wsc_now_us()
    val out = _lay_grid_track_sizes_inner(raw, available_w, gap)
    _wlay_add(6, _wsc_now_us() - t0, 1)
    out

# True when something other than collapsible white space follows `button_i`
# among its siblings (a box or text the narrowed button would sit beside).
fn button_has_inline_follower(nodes: [HNode], child_index: HtmlChildIndex, button_i: i32) -> bool:
    var sib = child_index.next_sibling[button_i]
    while sib >= 0:  # cpu-lane-loop-ok: one pass over this button's following siblings; bound is that child list
        if nodes[sib].tag != "#text" or nodes[sib].text_trimmed.len() > 0:
            return true
        sib = child_index.next_sibling[sib]
    false

# Device-px width of an auto-width `<button>` minus k x its CSS width. Chrome
# sizes the label in device px from its fractional width, so `Go` is 135.14
# device px at k = 4 (33.785 CSS px), where 4 x the whole-px 34 is 136. The
# fractional shortfall (`form_control_button_frac_delta_milli_px`, <= 0) scaled
# by k and rounded to the nearest device px.
# reason: node index in, device-px delta out; both are layout-array scalars.
# @allow(primitive_api)
pub fn button_device_extra_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, button_i: i32) -> i32:
    val k = g_layout_device_scale
    if k <= 1:
        return 0
    # Every button outside a flex/grid row is sized, followed or not: what
    # follows starts at the exact pen (`box_device_dx_record`, pen origin).
    # Where the inline loop has no exact pen for the follower it undoes this
    # (`button_has_inline_follower`), or the narrowed button opens a 1 px gap.
    val parent = nodes[button_i].parent
    if parent >= 0:
        val pd = styles[parent].display
        if pd == "flex" or pd == "inline-flex" or pd == "grid" or pd == "inline-grid":
            return 0
    val delta = form_control_button_frac_delta_milli_px(nodes, styles, child_index, button_i)
    if delta >= 0:
        return 0
    0 - ((0 - delta * k + 500) / 1000)
