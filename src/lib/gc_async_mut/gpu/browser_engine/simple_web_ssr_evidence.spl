"""System-test evidence adapter for canonical SSR composition and readback.

This module is intentionally separate from `simple_web_ssr_renderer`: importing
the broader semantic evidence surfaces must not enlarge the production server
entry closure.
"""

use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    simple_web_engine2d_resolved_backend_name
}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    web_draw_ir_gpu_route_sample
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir
}

struct SimpleWebSsrRenderEvidence:
    composition_schema: text
    composition_id: text
    backend_target: text
    batch_count: i64
    command_count: i64
    pixels: [u32]

fn simple_web_ssr_render_evidence(
    html: text, width: i32, height: i32, backend_name: text
) -> SimpleWebSsrRenderEvidence:
    val resolved = simple_web_engine2d_resolved_backend_name(
        width, height, backend_name
    )
    val composition = simple_web_layout_render_html_draw_ir(
        html, width, height
    )
    var command_count = 0
    for batch in composition.batches:
        command_count = command_count + batch.commands.len()
    SimpleWebSsrRenderEvidence(
        composition_schema: composition.schema,
        composition_id: composition.composition_id,
        backend_target: resolved,
        batch_count: composition.batches.len(),
        command_count: command_count,
        pixels: web_draw_ir_gpu_route_sample(
            composition, width, height, resolved
        )
    )

export SimpleWebSsrRenderEvidence, simple_web_ssr_render_evidence
