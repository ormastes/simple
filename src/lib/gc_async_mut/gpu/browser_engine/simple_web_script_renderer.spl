use std.gc_async_mut.gpu.browser_engine.browser_script_execute.{
    execute_scripts_in_html, execute_dom_scripts_via_session
}
use std.gc_async_mut.gpu.browser_engine.simple_web_file_renderer.{
    simple_web_render_html_to_rgba_bytes,
    simple_web_render_url_to_pixels
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_pixels_with_images
}
use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.io_runtime.{file_exists, file_read}

extern fn rt_bytes_alloc(n: i64) -> [u8]?

fn _argb_u32_to_rgba_bytes(pixels: [u32], width: i64, height: i64) -> [u8]:
    val n_bytes = width * height * 4
    var out = match rt_bytes_alloc(n_bytes):
        Some(b): b
        None: []
    if out.len().to_i64() < n_bytes:
        return []
    var i: i64 = 0
    val count = width * height
    while i < count and i < pixels.len().to_i64():
        val px = pixels[i].to_i64()
        val a = (px >> 24) & 255
        val r = (px >> 16) & 255
        val g = (px >> 8) & 255
        val b = px & 255
        val base = i * 4
        out[base] = r.to_u8()
        out[base + 1] = g.to_u8()
        out[base + 2] = b.to_u8()
        out[base + 3] = a.to_u8()
        i = i + 1
    out

# reason: mirrors sibling simple_web_render_url_to_pixels_with_scripts(url, width, height) pixel dimension API
# @allow(primitive_api)
pub fn simple_web_render_html_with_scripts_to_rgba_pixels(html_str: text, width: i64, height: i64) -> [u8]:
    """Execute inline JS and <script type='text/simple'> DOM scripts in BrowserSession and render software RGBA pixels."""
    if width <= 0 or height <= 0:
        return []
    var session = BrowserSession.new()
    val _ = session.open_html("about:document", html_str)
    val mutated_html = session.render_html_document()
    val pixels = simple_web_layout_render_html_software_pixels_with_images(
        mutated_html, width.to_i32(), height.to_i32(), session.image_resources
    )
    _argb_u32_to_rgba_bytes(pixels, width, height)

pub fn simple_web_render_url_to_pixels_with_scripts(url: text, width: i64, height: i64) -> [u8]:
    if url.starts_with("about:"):
        return simple_web_render_url_to_pixels(url, width, height)

    if url.starts_with("file://"):
        val path = url.substring(7, url.byte_len())
        if file_exists(path):
            val html_str = file_read(path)
            val _ = execute_scripts_in_html(html_str)
            val dom_exec = execute_dom_scripts_via_session(html_str)
            val final_html = if dom_exec.mutated_html != "": dom_exec.mutated_html else: html_str
            return simple_web_render_html_to_rgba_bytes(final_html, width, height)
        return simple_web_render_url_to_pixels("about:blank", width, height)

    simple_web_render_url_to_pixels("about:blank", width, height)
