export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.*
export use std.gc_async_mut.gpu.browser_engine.simple_web_css_box_effects.*
export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_decl_apply.*
export use std.gc_async_mut.gpu.browser_engine.simple_web_css_property_id.*

fn sticky_top_inset_value(
    raw: text, parsed: i32, position_sticky: bool
) -> i32:
    val parts = raw.trim().lower().split(" ")
    if (
        position_sticky and parts.len() > 0 and
        parts[0] == "auto"
    ):
        return SIMPLE_WEB_STICKY_TOP_AUTO
    parsed

fn border_spacing_px(raw: text) -> i32:
    val value = raw.trim().lower()
    if value == "0":
        return 0
    if not value.ends_with("px") or value.len() <= 2:
        return -1
    val digits = value.substring(0, value.len() - 2)
    var index = 0
    while index < digits.len():
        val ch = digits.char_at(index)
        if ch < "0" or ch > "9":
            return -1
        index = index + 1
    parse_int(digits)

fn _background_has_image_syntax(raw: text) -> bool:
    val lower = raw.trim().lower()
    (
        lower.contains("gradient(") or
        lower.contains("url(") or
        lower.contains("image(") or
        lower.contains("image-set(") or
        lower.contains("cross-fade(") or
        lower.contains("element(") or
        lower.contains("paint(")
    )

fn _background_is_exact_typed_linear_layer(raw: text, gradient_from: u32, gradient_to: u32, allow_base_color_layer: bool) -> bool:
    if gradient_from == 0u32 or gradient_to == 0u32:
        return false
    val layers = split_top_level_commas(raw.trim().lower())
    if layers.len() < 1 or layers.len() > 2:
        return false
    val image_layer = layers[0].trim()
    if not image_layer.starts_with("linear-gradient("):
        return false
    val open = find_from(image_layer, "(", 0)
    if open != "linear-gradient".len():
        return false
    val close = paren_matching_close(image_layer, open)
    if close != image_layer.len() - 1:
        return false
    if layers.len() == 1:
        return true
    allow_base_color_layer and parse_color_any(layers[1].trim()) != 0u32

fn _background_exact_single_url(raw: text) -> text:
    val value = raw.trim()
    val lower = value.lower()
    # A comma inside rgb()/rgba() is a color argument, not a second image
    # layer. Only a top-level comma makes this shorthand unrepresentable.
    if split_top_level_commas(value).len() > 1 or lower.contains("gradient(") or lower.contains("image-set("):
        return ""
    val start = find_from(lower, "url(", 0)
    if start < 0:
        return ""
    val open = start + 3
    val close = paren_matching_close(value, open)
    if close < 0 or find_from(lower, "url(", close + 1) >= 0:
        return ""
    var uri = value.substring(open + 1, close).trim()
    if uri.len() >= 2:
        if (uri.starts_with("\"") and uri.ends_with("\"")) or (uri.starts_with("'") and uri.ends_with("'")):
            uri = uri.substring(1, uri.len() - 1).trim()
    if uri == "":
        return ""
    uri

fn _padding_integer_px(token: text) -> i32:
    val value = token.trim().lower()
    if value == "0":
        return 0
    if not value.ends_with("px") or value.len() <= 2:
        return -1
    val digits = value.substring(0, value.len() - 2)
    var number = 0
    var index = 0
    while index < digits.len():
        val digit = dec_val(digits.char_at(index))
        if digit >= 10 or number > (1000000 - digit) / 10:
            return -1
        number = number * 10 + digit
        index = index + 1
    number

fn _padding_integer_px_values(raw: text, maximum: i32) -> [i32]:
    val tokens = ws_tokens(raw.trim().lower())
    var values: [i32] = []
    if tokens.len() == 0 or tokens.len() > maximum:
        return values
    for token in tokens:
        val value = _padding_integer_px(token)
        if value < 0:
            return []
        values.push(value)
    values

fn _resolve_authored_padding(
    decl_tbl: [text], initial_top: i32, initial_right: i32,
    initial_bottom: i32, initial_left: i32
) -> (i32, i32, i32, i32):
    var top = initial_top
    var right = initial_right
    var bottom = initial_bottom
    var left = initial_left
    var index = 0
    while index < decl_tbl.len():
        val name = decl_tbl[index]
        val raw = decl_tbl[index + 1]
        if name == "padding":
            val values = _padding_integer_px_values(raw, 4)
            if values.len() > 0:
                top = values[0]
                right = values[0]
                bottom = values[0]
                left = values[0]
                if values.len() == 2:
                    right = values[1]
                    left = values[1]
                elif values.len() == 3:
                    right = values[1]
                    left = values[1]
                    bottom = values[2]
                elif values.len() == 4:
                    right = values[1]
                    bottom = values[2]
                    left = values[3]
        elif name == "padding-top":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                top = values[0]
        elif name == "padding-right":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                right = values[0]
        elif name == "padding-bottom":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                bottom = values[0]
        elif name == "padding-left":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                left = values[0]
        elif name == "padding-block":
            val values = _padding_integer_px_values(raw, 2)
            if values.len() > 0:
                top = values[0]
                bottom = if values.len() == 2: values[1] else: values[0]
        elif name == "padding-block-start":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                top = values[0]
        elif name == "padding-block-end":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                bottom = values[0]
        elif name == "padding-inline":
            val values = _padding_integer_px_values(raw, 2)
            if values.len() > 0:
                left = values[0]
                right = if values.len() == 2: values[1] else: values[0]
        elif name == "padding-inline-start":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                left = values[0]
        elif name == "padding-inline-end":
            val values = _padding_integer_px_values(raw, 1)
            if values.len() == 1:
                right = values[0]
        index = index + 2
    (top, right, bottom, left)

fn _background_exact_url_value(raw: text) -> text:
    val value = raw.trim()
    val lower = value.lower()
    if not lower.starts_with("url("):
        return ""
    val close = paren_matching_close(value, 3)
    if close != value.len() - 1:
        return ""
    _background_exact_single_url(value)

# A compact internal plan keeps the existing Style shape intact. Newlines are
# safe delimiters because admitted image URLs reject control bytes and every
# other field below is normalized before serialization.
fn _background_two_url_plan(
    image: text, repeat: text, size_raw: text, position_raw: text,
    size_w: i32, size_h: i32, position_x: i32, position_y: i32,
    origin: text, clip: text, attachment: text
) -> text:
    val images = split_top_level_commas(image.trim())
    if images.len() != 2:
        return ""
    val first_uri = _background_exact_url_value(images[0])
    val second_uri = _background_exact_url_value(images[1])
    if first_uri == "" or second_uri == "":
        return ""
    if (split_top_level_commas(repeat.trim()).len() > 1 or
        split_top_level_commas(size_raw.trim()).len() > 1 or
        split_top_level_commas(position_raw.trim()).len() > 1 or
        split_top_level_commas(origin.trim()).len() > 1 or
        split_top_level_commas(clip.trim()).len() > 1 or
        split_top_level_commas(attachment.trim()).len() > 1 or
        split_top_level_commas(image.trim()).len() != 2 or attachment == "local"):
        return ""
    (
        "two-url-v1\n{first_uri}\n{second_uri}\n{repeat}\n{size_w}\n" +
        "{size_h}\n{position_x}\n{position_y}\n{origin}\n{clip}\n{attachment}"
    )

fn _background_position_value(raw: text, horizontal: bool) -> i32:
    val value = raw.trim().lower()
    if value == "left" or value == "top":
        return -1000
    if value == "center":
        return -1050
    if value == "right" or value == "bottom":
        return -1100
    if value.ends_with("%"):
        val pct = parse_int(value)
        if pct >= 0 and pct <= 100:
            return -1000 - pct
        return 0
    parse_int(value)

class BackgroundShorthand:
    valid: bool
    color: u32
    image_uri: text
    repeat: text
    size_w: i32
    size_h: i32
    position_x: i32
    position_y: i32
    origin: text
    clip: text

fn _background_shorthand_tokens(raw: text) -> [text]:
    var tokens: [text] = []
    var current = ""
    var depth = 0
    var i = 0
    while i < raw.len():
        val c = raw.char_at(i)
        if c == "(":
            depth = depth + 1
            current = current + c
        elif c == ")":
            if depth > 0:
                depth = depth - 1
            current = current + c
        elif depth == 0 and c == "/":
            if current != "":
                tokens.push(current)
                current = ""
            tokens.push("/")
        elif depth == 0 and (c == " " or c == "\t" or c == "\n" or c == "\r"):
            if current != "":
                tokens.push(current)
                current = ""
        else:
            current = current + c
        i = i + 1
    if current != "":
        tokens.push(current)
    tokens

fn _background_box_token(token: text) -> bool:
    val value = token.lower()
    value == "border-box" or value == "padding-box" or value == "content-box"

fn _background_position_token(token: text) -> bool:
    val value = token.lower()
    if value == "left" or value == "right" or value == "top" or value == "bottom" or value == "center":
        return true
    (value.ends_with("px") and value.len() > 2) or (value.ends_with("%") and value.len() > 1)

fn _background_size_token(token: text) -> bool:
    val value = token.lower()
    value == "auto" or (value.ends_with("px") and value.len() > 2)

fn _background_color_token(token: text) -> bool:
    val value = token.trim().lower()
    value == "transparent" or value == "none" or parse_color_alpha(value) != 0u32

fn _background_position_pair(first: text, second: text) -> [i32]:
    val first_lower = first.lower()
    val second_lower = second.lower()
    val first_vertical = first_lower == "top" or first_lower == "bottom"
    val second_horizontal = second_lower == "left" or second_lower == "right"
    if first_vertical:
        return [_background_position_value(second, true), _background_position_value(first, false)]
    if first_lower == "center" and second_horizontal:
        return [_background_position_value(second, true), -1050]
    [_background_position_value(first, true), _background_position_value(second, false)]

# The renderer has one typed image layer. Parse only the corresponding useful
# CSS subset; anything lossy stays as the raw witness and is not rendered.
fn _parse_background_shorthand(raw: text) -> BackgroundShorthand:
    val empty = BackgroundShorthand(valid: false, color: 0u32, image_uri: "", repeat: "repeat", size_w: 0, size_h: 0, position_x: -1000, position_y: -1000, origin: "padding-box", clip: "border-box")
    val value = raw.trim()
    val lower = value.lower()
    if value == "" or split_top_level_commas(value).len() > 1 or lower.contains("gradient(") or lower.contains("image-set(") or lower.contains("cross-fade(") or lower.contains("element(") or lower.contains("paint("):
        return empty
    val tokens = _background_shorthand_tokens(value)
    var color = 0u32
    var color_seen = false
    var image_uri = ""
    var repeat = "repeat"
    var repeat_seen = false
    var attachment_seen = false
    var origin = "padding-box"
    var clip = "border-box"
    var box_count = 0
    var positions: [text] = []
    var sizes: [text] = []
    var after_slash = false
    var slash_seen = false
    for token in tokens:
        val norm = token.trim().lower()
        if norm == "":
            continue
        if norm == "/":
            if slash_seen or positions.len() == 0:
                return empty
            slash_seen = true
            after_slash = true
        elif after_slash:
            if not _background_size_token(norm) or sizes.len() >= 2:
                return empty
            sizes.push(norm)
        elif norm == "fixed" or norm == "local":
            return empty
        elif norm == "scroll":
            if attachment_seen:
                return empty
            attachment_seen = true
        elif norm == "repeat" or norm == "repeat-x" or norm == "repeat-y" or norm == "no-repeat":
            if repeat_seen:
                return empty
            repeat = norm
            repeat_seen = true
        elif _background_box_token(norm):
            if box_count >= 2:
                return empty
            if box_count == 0:
                origin = norm
                clip = norm
            else:
                clip = norm
            box_count = box_count + 1
        elif _background_position_token(norm):
            if positions.len() >= 2:
                return empty
            positions.push(norm)
        elif norm.starts_with("url("):
            val uri = _background_exact_url_value(norm)
            if image_uri != "" or uri == "":
                return empty
            image_uri = uri
        elif _background_color_token(norm):
            if color_seen:
                return empty
            color = parse_color_alpha(norm)
            color_seen = true
        else:
            return empty
    if slash_seen and sizes.len() == 0:
        return empty
    var position_x = -1000
    var position_y = -1000
    if positions.len() == 1:
        val only = positions[0].lower()
        if only == "top" or only == "bottom":
            position_x = -1050
            position_y = _background_position_value(positions[0], false)
        else:
            position_x = _background_position_value(positions[0], true)
            position_y = -1050
    elif positions.len() == 2:
        val pair = _background_position_pair(positions[0], positions[1])
        position_x = pair[0]
        position_y = pair[1]
    val size_w = if sizes.len() > 0 and sizes[0] != "auto": parse_int(sizes[0]) else: 0
    val size_h = if sizes.len() > 1 and sizes[1] != "auto": parse_int(sizes[1]) else: 0
    BackgroundShorthand(valid: true, color: color, image_uri: image_uri, repeat: repeat, size_w: size_w, size_h: size_h, position_x: position_x, position_y: position_y, origin: origin, clip: clip)

# Stage 1 of the apply_decls loop-inversion fix (see doc/08_tracking/bug/
# web_style_producer_4s_per_node_interpreted_lane_2026-07-29.md, "Staging").
# apply_decls' full body below probes ~283 known property names against
# the rule's small decl table on every call. When every property in a
# call's decl_tbl is one we understand well enough to update Style
# directly (no cross-property shorthand interactions we haven't traced),
# _apply_decls_dispatch below applies them directly via a `mut` Style
# parameter -- true in-place field mutation (verified: a `mut x: SomeClass`
# parameter's field writes are visible to the caller, not a local-only
# copy), so this path pays neither the 176-field copy-in/copy-out nor the
# 283-probe scan. Any decl_tbl entry NOT in this list falls back to the
# full probe body unchanged -- this list only grows once a property's full
# consequences (including any "if some other resolved field now has value
# X, also do Y" coupling elsewhere in apply_decls) have been traced; get
# this wrong and it is a silent rendering bug, not a crash.
val _APPLY_DECLS_DISPATCH_PROPS: [text] = [
    "box-sizing", "color", "width", "height", "min-height", "margin-left",
    "z-index", "display",
    # The Grid fields are applied by apply_grid_decls after either base path.
    # Listing them here avoids the full 283-property probe for Grid-only rules.
    "grid-template-columns", "grid-template-rows",
    "grid-column", "grid-row",
    "border-collapse",
    # Stage 2: most entries are independent. The border-radius family is the
    # deliberate exception: both paths call the same authored-order resolver.
    # Other shorthand/longhand families still fall back to the full probe.
    "justify-content", "align-items", "gap", "flex-basis", "text-align",
    "font-style", "cursor",
    "outline", "overflow", "box-shadow", "padding", "margin",
    "border-radius",
    "border-top-left-radius", "border-top-right-radius",
    "border-bottom-right-radius", "border-bottom-left-radius",
    "border-start-start-radius", "border-start-end-radius",
    "border-end-start-radius", "border-end-end-radius",
]

fn _decl_tbl_all_dispatch_handled(decl_tbl: [text]) -> bool:
    # O(k): one interned-id lookup per declaration instead of scanning the
    # dispatch-prop list per name. css_prop_id() and
    # _APPLY_DECLS_DISPATCH_PROPS must stay in lockstep; the property-id
    # spec asserts the two agree entry-for-entry.
    var i = 0
    while i < decl_tbl.len():
        if css_prop_id(decl_tbl[i]) == CSS_PROP_UNKNOWN:
            return false
        i = i + 2
    true

fn _decl_tbl_resolve_writing_mode(current: text, decl_tbl: [text]) -> text:
    val raw = decl_tbl_get(decl_tbl, "writing-mode")
    if raw.len() == 0:
        return current
    val value = raw.trim().lower()
    if value == "horizontal-tb" or value == "vertical-rl" or value == "vertical-lr" or value == "sideways-rl" or value == "sideways-lr":
        return value
    current

fn parse_supported_nonnegative_px(raw: text) -> i32:
    val value = raw.trim().lower()
    val digits = if value.ends_with("px"):
        value.substring(0, value.len() - 2)
    else:
        value
    if digits.len() == 0:
        return -1
    var digit_index = 0
    while digit_index < digits.len():
        val ch = digits.char_at(digit_index)
        if ch < "0" or ch > "9":
            return -1
        digit_index = digit_index + 1
    if val Some(parsed) = digits.parse_i64():
        if parsed >= 0 and parsed <= 2147483647:
            return parsed.to_i32()
    -1

fn decl_tbl_get_last_valid_nonnegative_px(
    decl_tbl: [text], prop: text
) -> text?:
    var i = (decl_tbl.len() as i32) - 2
    while i >= 0:
        if decl_tbl[i] == prop:
            val value = decl_tbl[i + 1].trim().lower()
            if (
                parse_supported_nonnegative_px(value) >= 0 or
                value == "initial" or value == "unset" or
                value == "inherit"
            ):
                return Some(value)
        i = i - 2
    nil

fn parse_supported_outline_shorthand_width_px(raw: text) -> i32:
    val value = raw.trim().lower()
    if value == "0" or value == "0px":
        return 0
    val parsed = parse_int(value)
    if parsed > 0:
        return parsed
    -1

fn resolve_writing_mode_decls(current: text, decls: text) -> text:
    if (
        decls.len() == 0 or not decls.contains("writing-mode") or
        _decl_over_quota(decls)
    ):
        return current
    _decl_tbl_resolve_writing_mode(current, decl_table_build(decls))

fn _apply_decls_dispatch(
    mut st: Style, decl_tbl: [text], em_base: i32, apply_display: bool
) -> Style:
    # apply_decls' Style(...) reconstruction always resets these four
    # resolved-font-cache fields, unconditionally, on every successful
    # call -- not gated on which properties are present. Must match here
    # too or the dispatch path would leave stale cached font-resolution
    # data that the full-probe path always clears.
    st.resolved_font_identity = ""
    st.resolved_font_advances = []
    st.resolved_font_width = 0
    st.resolved_font_line_height = 0

    # Stage 3 (O(k)): one interning pass builds a presence mask; every probe
    # below is gated on its property actually appearing in this rule, so a
    # rule with k declarations pays O(k) table scans, not one scan per
    # dispatch-handled property. Skipping an absent property is
    # behavior-identical: every block below no-ops on the empty/absent value.
    val mask = css_prop_mask(decl_tbl)
    if css_prop_mask_has(mask, CSS_PROP_BOX_SIZING):
        css_probe_note()
        val box_sizing = decl_tbl_get(decl_tbl, "box-sizing")
        if box_sizing.len() > 0:
            st.border_box = box_sizing == "border-box"
    if css_prop_mask_has(mask, CSS_PROP_BORDER_COLLAPSE):
        css_probe_note()
        val border_collapse = decl_tbl_get(decl_tbl, "border-collapse").trim().lower()
        if border_collapse == "collapse" or border_collapse == "separate":
            st.border_collapse = border_collapse
        elif border_collapse == "initial":
            st.border_collapse = "separate"
    if css_prop_mask_has_radius_family(mask):
        css_probe_note()
        val border_radius_shorthand = parse_border_radius_shorthand(
            decl_tbl_get(decl_tbl, "border-radius"))
        if border_radius_shorthand.valid:
            st.border_radius_px = border_radius_shorthand.top_left_px
        val resolved_radii = resolve_authored_border_radii(
            decl_tbl, st.border_radius_tl_px, st.border_radius_tr_px,
            st.border_radius_br_px, st.border_radius_bl_px)
        if resolved_radii.valid:
            st.border_radius_tl_px = resolved_radii.top_left_px
            st.border_radius_tr_px = resolved_radii.top_right_px
            st.border_radius_br_px = resolved_radii.bottom_right_px
            st.border_radius_bl_px = resolved_radii.bottom_left_px
    if css_prop_mask_has(mask, CSS_PROP_COLOR):
        css_probe_note()
        val col = decl_tbl_get(decl_tbl, "color")
        if col.len() > 0:
            val cv = parse_color(col)
            if cv != 0u32:
                st.fg = cv
    if css_prop_mask_has(mask, CSS_PROP_WIDTH):
        css_probe_note()
        val width = decl_tbl_get(decl_tbl, "width")
        if width.len() > 0:
            if width.ends_with("%"):
                val wp = parse_int(width)
                st.width_px = if wp > 0: 0 - wp else: 0
            elif width.ends_with("vw"):
                val wv = parse_int(width)
                st.width_px = if wv > 0: 0 - wv else: 0
            else:
                st.width_px = parse_int(width)
    if css_prop_mask_has(mask, CSS_PROP_HEIGHT):
        css_probe_note()
        val height = decl_tbl_get(decl_tbl, "height")
        if height.len() > 0:
            if height.ends_with("%"):
                val hp = parse_int(height)
                st.height_px = if hp > 0: 0 - hp else: 0
            else:
                st.height_px = parse_int(height)
    if css_prop_mask_has(mask, CSS_PROP_MIN_HEIGHT):
        css_probe_note()
        val min_height = decl_tbl_get(decl_tbl, "min-height")
        if min_height.len() > 0:
            if min_height.contains("vh"):
                st.min_height_vh = true
            else:
                st.min_height_vh = false
                st.min_height_px = parse_int(min_height)
    # Cascade order for the margin family mirrors the full-probe body:
    # decl_tbl is source-ordered, so the margin-left longhand only applies
    # when it was declared AFTER the last `margin` shorthand (last-declared
    # wins per side, both directions). Gated as one family: either member
    # present pays both position probes so ordering stays exact.
    val margin_family_present = (
        css_prop_mask_has(mask, CSS_PROP_MARGIN) or
        css_prop_mask_has(mask, CSS_PROP_MARGIN_LEFT)
    )
    var margin_sh_pos: i32 = -1
    var margin = ""
    if margin_family_present:
        css_probe_note()
        margin_sh_pos = decl_tbl_last_index(decl_tbl, "margin")
        margin = decl_tbl_get(decl_tbl, "margin")
    if margin.len() > 0:
        val mtoks = ws_tokens(margin.trim().lower())
        val mn = mtoks.len()
        if mn > 0:
            var t_tok = mtoks[0]
            var r_tok = mtoks[0]
            var b_tok = mtoks[0]
            var l_tok = mtoks[0]
            if mn == 2:
                r_tok = mtoks[1]
                l_tok = mtoks[1]
            elif mn == 3:
                r_tok = mtoks[1]
                l_tok = mtoks[1]
                b_tok = mtoks[2]
            elif mn >= 4:
                r_tok = mtoks[1]
                b_tok = mtoks[2]
                l_tok = mtoks[3]
            st.margin_t_auto = t_tok == "auto"
            st.margin_r_auto = r_tok == "auto"
            st.margin_b_auto = b_tok == "auto"
            st.margin_l_auto = l_tok == "auto"
            st.margin_t = if t_tok == "auto": 0 else: margin_token_vh_px(t_tok)
            st.margin_r = if r_tok == "auto": 0 else: margin_token_px(r_tok)
            st.margin_b = if b_tok == "auto": 0 else: margin_token_vh_px(b_tok)
            st.margin_l = if l_tok == "auto": 0 else: margin_token_px(l_tok)
    var ml = ""
    var ml_pos: i32 = -1
    if css_prop_mask_has(mask, CSS_PROP_MARGIN_LEFT):
        css_probe_note()
        ml = decl_tbl_get(decl_tbl, "margin-left")
        ml_pos = decl_tbl_last_index(decl_tbl, "margin-left")
    if ml.len() > 0 and ml_pos > margin_sh_pos:
        if ml == "auto":
            st.margin_l = 0
            st.margin_l_auto = true
        else:
            st.margin_l = if ml.ends_with("%"): 0 - parse_int(ml) else: parse_int(ml)
            st.margin_l_auto = false
    if css_prop_mask_has(mask, CSS_PROP_Z_INDEX):
        css_probe_note()
        val z_index_decl = decl_tbl_get(decl_tbl, "z-index")
        if z_index_decl.len() > 0:
            st.z_index = parse_int(z_index_decl)
    if css_prop_mask_has(mask, CSS_PROP_JUSTIFY_CONTENT):
        css_probe_note()
        val justify_content_decl = decl_tbl_get(decl_tbl, "justify-content")
        if justify_content_decl.len() > 0:
            val normalized_justify_content = normalize_overflow_box_alignment(justify_content_decl)
            if supports_content_distribution_alignment(normalized_justify_content):
                st.justify_content = normalized_justify_content
    if css_prop_mask_has(mask, CSS_PROP_ALIGN_ITEMS):
        css_probe_note()
        val align_items_decl = decl_tbl_get(decl_tbl, "align-items")
        if align_items_decl.len() > 0:
            st.align_items = align_items_decl
    var gap: text? = nil
    if css_prop_mask_has(mask, CSS_PROP_GAP):
        css_probe_note()
        gap = decl_tbl_get_last_valid_nonnegative_px(decl_tbl, "gap")
    if val Some(gap_value) = gap:
        if (
            gap_value == "initial" or gap_value == "unset" or
            gap_value == "inherit"
        ):
            st.gap_px = 0
            st.row_gap_px = 0
            st.column_gap_px = 0
        else:
            val gv = parse_supported_nonnegative_px(gap_value)
            st.gap_px = gv
            st.row_gap_px = gv
            st.column_gap_px = gv
    if css_prop_mask_has(mask, CSS_PROP_FLEX_BASIS):
        css_probe_note()
        val flex_basis_decl = decl_tbl_get(decl_tbl, "flex-basis")
        if flex_basis_decl.len() > 0:
            val basis_v = parse_supported_nonnegative_px(flex_basis_decl)
            if basis_v >= 0:
                st.flex_basis_px = basis_v
    if css_prop_mask_has(mask, CSS_PROP_TEXT_ALIGN):
        css_probe_note()
        val ta = decl_tbl_get(decl_tbl, "text-align")
        if ta.len() > 0:
            st.text_align = ta
    if css_prop_mask_has(mask, CSS_PROP_FONT_STYLE):
        css_probe_note()
        val font_style_decl = decl_tbl_get(decl_tbl, "font-style").trim().lower()
        if font_style_decl == "normal":
            st.font_style_italic = false
        elif font_style_decl == "italic" or font_style_decl == "oblique":
            st.font_style_italic = true
    if css_prop_mask_has(mask, CSS_PROP_CURSOR):
        css_probe_note()
        val cursor_decl = decl_tbl_get(decl_tbl, "cursor")
        if cursor_decl.len() > 0:
            val cursor_norm = cursor_decl.trim().lower()
            if cursor_norm.len() > 0:
                st.cursor = cursor_norm
    if css_prop_mask_has(mask, CSS_PROP_OUTLINE):
        css_probe_note()
        val outline = decl_tbl_get(decl_tbl, "outline")
        if outline.len() > 0:
            val ow = parse_supported_outline_shorthand_width_px(outline)
            if ow >= 0:
                st.outline_w = ow
            val oc = parse_color_any(outline)
            if oc != 0u32:
                st.outline_color = oc
            if border_style_disables_paint(outline):
                st.outline_w = 0
    if css_prop_mask_has(mask, CSS_PROP_OVERFLOW):
        css_probe_note()
        val overflow_decl = decl_tbl_get(decl_tbl, "overflow")
        if overflow_decl.len() > 0:
            st.overflow_hidden = overflow_decl == "hidden"
            st.overflow_auto_y = (
                overflow_decl == "auto" or overflow_decl == "scroll"
            )
            st.overflow_scroll_y = overflow_decl == "scroll"
    var box_shadow_decl = ""
    if css_prop_mask_has(mask, CSS_PROP_BOX_SHADOW):
        css_probe_note()
        box_shadow_decl = decl_tbl_get(decl_tbl, "box-shadow")
    if box_shadow_decl.len() > 0:
        val box_shadow_norm = box_shadow_decl.trim().lower()
        if box_shadow_norm == "none":
            st.box_shadow_x_px = 0
            st.box_shadow_y_px = 0
            st.box_shadow_color = 0u32
            st.box_shadow_blur_px = 0
            st.box_shadow_alpha = 255
            st.box_shadow_raw = ""
        else:
            st.box_shadow_raw = box_shadow_norm
            val agg = parse_box_shadow_agg(box_shadow_norm)
            if agg.found:
                st.box_shadow_x_px = agg.x
                st.box_shadow_y_px = agg.y
                st.box_shadow_blur_px = agg.blur
                st.box_shadow_alpha = agg.alpha
                st.box_shadow_color = agg.color
    if css_prop_mask_has(mask, CSS_PROP_PADDING):
        css_probe_note()
        val (resolved_pad_t, resolved_pad_r, resolved_pad_b, resolved_pad_l) = _resolve_authored_padding(
            decl_tbl, st.pad_t, st.pad_r, st.pad_b, st.pad_l
        )
        st.pad_t = resolved_pad_t
        st.pad_r = resolved_pad_r
        st.pad_b = resolved_pad_b
        st.pad_l = resolved_pad_l
    var display_decl = ""
    if css_prop_mask_has(mask, CSS_PROP_DISPLAY):
        css_probe_note()
        display_decl = decl_tbl_get_last_valid_display(decl_tbl)
    if apply_display and display_decl.len() > 0:
        if display_decl == "none":
            st.display = "none"
        elif display_decl == "inline":
            st.display = "inline"
        elif display_decl == "inline-block":
            st.display = "inline-block"
        elif display_decl == "list-item":
            st.display = "list-item"
        elif display_decl == "flex":
            st.display = "flex"
        elif display_decl == "grid":
            st.display = "grid"
        elif display_decl == "contents":
            st.display = "contents"
        elif display_decl == "block":
            st.display = "block"
    # list-style / list-style-type (bug browser_engine_no_list_marker_boxes_
    # 2026-08-19). Scope: only the `none` vs visible distinction is modelled.
    val list_style_type_decl = decl_tbl_get(decl_tbl, "list-style-type").trim().lower()
    val list_style_decl = decl_tbl_get(decl_tbl, "list-style").trim().lower()
    if list_style_type_decl.len() > 0:
        st.list_style_none = list_style_type_decl == "none"
    elif list_style_decl.len() > 0:
        st.list_style_none = list_style_decl.contains("none")
    # Unconditional in the full-probe path too: it checks the FINAL
    # display_v, which can already be "contents" from inheritance even
    # when this call's decls never mention "display" at all.
    if apply_display and st.display == "contents":
        st.bg = 0u32
        st.width_px = 0
        st.height_px = 0
        st.pad_l = 0
        st.pad_t = 0
        st.pad_r = 0
        st.pad_b = 0
        st.border_w = 0
        st.border_l = 0
        st.border_t = 0
        st.border_r = 0
        st.border_b = 0
        st.border_color = 0u32
        st.border_color_l = 0u32
        st.border_color_t = 0u32
        st.border_color_r = 0u32
        st.border_color_b = 0u32
        st.outline_w = 0
        st.outline_color = 0u32
        st.margin_l = 0
        st.margin_t = 0
        st.margin_r = 0
        st.margin_b = 0
        st.margin_l_auto = false
        st.margin_r_auto = false
        st.margin_t_auto = false
        st.margin_b_auto = false
    st

fn normalized_grid_positive_int(raw: text) -> i32:
    val value = raw.trim()
    if value == "":
        return 0
    var index = 0
    while index < value.len():
        val ch = value.char_at(index)
        if ch < "0" or ch > "9":
            return 0
        index = index + 1
    parse_int(value)

fn normalized_grid_track_list(raw: text) -> text:
    val parts = raw.trim().split(" ")
    var normalized = ""
    for part in parts:
        val token = part.trim().lower()
        if token == "":
            continue
        # `fr` tracks (CSS Grid SS11.5, simplified — no `minmax()`, no
        # min-content clamping) are kept alongside `px` tracks instead of
        # rejecting the whole list. Resolution to pixels happens at layout
        # time in grid_track_sizes (simple_web_html_layout_renderer_layout.spl),
        # once the container's available width is known.
        if token.ends_with("fr") and token.len() > 2:
            val fr_size = normalized_grid_positive_int(
                token.substring(0, token.len() - 2)
            )
            if fr_size <= 0:
                return ""
            if normalized != "":
                normalized = normalized + " "
            normalized = normalized + fr_size.to_string() + "fr"
            continue
        if not token.ends_with("px") or token.len() <= 2:
            return ""
        val size = normalized_grid_positive_int(
            token.substring(0, token.len() - 2)
        )
        if size <= 0:
            return ""
        if normalized != "":
            normalized = normalized + " "
        normalized = normalized + size.to_string() + "px"
    normalized

fn normalized_grid_placement(raw: text) -> text:
    val value = raw.trim().lower()
    val slash = find_from(value, "/", 0)
    val start_raw = if slash >= 0:
        value.substring(0, slash).trim()
    else:
        value
    val start = normalized_grid_positive_int(start_raw)
    if start <= 0:
        return ""
    if slash < 0:
        return start.to_string()
    val tail = value.substring(slash + 1, value.len()).trim()
    if tail.starts_with("span "):
        val span = normalized_grid_positive_int(
            tail.substring(5, tail.len()).trim()
        )
        if span > 0:
            return "{start} / span {span}"
        return ""
    val end_line = normalized_grid_positive_int(tail)
    if end_line > start:
        return "{start} / {end_line}"
    ""

fn normalized_grid_area(raw: text) -> text:
    val value = raw.trim()
    if value == "" or value.lower() == "auto":
        return ""
    if find_from(value, "/", 0) >= 0:
        # The numeric/multi-value `grid-area` shorthand (row-start /
        # column-start / row-end / column-end) is out of scope for this
        # simplification -- only the named-area reference form (`grid-area:
        # <name>`) is supported. See doc/08_tracking/bug/
        # browser_engine_grid_template_areas_missing_2026-08.md.
        return ""
    # Named-area idents are CASE-SENSITIVE per CSS (unlike the `auto`
    # keyword check above): preserve case so this matches the row/column
    # cell names produced by normalized_grid_template_areas verbatim,
    # instead of silently falling to auto-placement on any non-lowercase
    # `grid-area` value. See doc/08_tracking/bug/
    # browser_engine_grid_template_areas_missing_2026-08.md.
    value

fn normalized_grid_auto_flow(raw: text) -> bool:
    # Only the `column` flow mode is recognized (no `dense` modifier
    # support) -- see doc/08_tracking/bug/
    # browser_engine_grid_template_areas_missing_2026-08.md for scope notes.
    val value = raw.trim().lower()
    for token in value.split(" "):
        if token.trim() == "column":
            return true
    false

fn normalized_grid_template_areas(raw: text) -> text:
    # Parses the quoted-strings `grid-template-areas` value into rows
    # joined by "|", cells within a row joined by a single space, e.g.
    # `"left right"` -> "left right", or `"a a" "b c"` -> "a a|b c". Only
    # rectangular templates are supported: rows whose cell count disagrees
    # with the first row are rejected outright (whole declaration ignored,
    # per this renderer's lenient-CSS convention). Per-area rectangle
    # validation (a single area name must occupy a solid rectangle of
    # cells, not merely a consistent column count) happens later, at
    # placement time, in grid_template_area_rects
    # (simple_web_html_layout_renderer_layout.spl) -- see
    # doc/08_tracking/bug/browser_engine_grid_template_areas_missing_2026-08.md.
    val value = raw.trim()
    if value == "":
        return ""
    var result = ""
    var col_count = -1
    var pos = 0
    val n = value.len()
    while pos < n:
        val ch = value.char_at(pos)
        if ch == "\"" or ch == "'":
            val close = find_from(value, ch, pos + 1)
            if close < 0:
                return ""
            val row_raw = value.substring(pos + 1, close).trim()
            if row_raw == "":
                return ""
            var row_normalized = ""
            var cols_in_row = 0
            for tok in row_raw.split(" "):
                val cell = tok.trim()
                if cell == "":
                    continue
                if row_normalized != "":
                    row_normalized = row_normalized + " "
                row_normalized = row_normalized + cell
                cols_in_row = cols_in_row + 1
            if col_count < 0:
                col_count = cols_in_row
            elif cols_in_row != col_count:
                return ""
            if result != "":
                result = result + "|"
            result = result + row_normalized
            pos = close + 1
        else:
            pos = pos + 1
    result

fn apply_grid_decls(mut st: Style, table: [text]):
    val columns = normalized_grid_track_list(
        decl_tbl_get(table, "grid-template-columns")
    )
    if columns != "":
        st.grid_template_columns = columns
    val rows = normalized_grid_track_list(
        decl_tbl_get(table, "grid-template-rows")
    )
    if rows != "":
        st.grid_template_rows = rows
    val column = normalized_grid_placement(
        decl_tbl_get(table, "grid-column")
    )
    if column != "":
        st.grid_column = column
    val row = normalized_grid_placement(decl_tbl_get(table, "grid-row"))
    if row != "":
        st.grid_row = row
    val areas = normalized_grid_template_areas(
        decl_tbl_get(table, "grid-template-areas")
    )
    if areas != "":
        st.grid_template_areas = areas
    if normalized_grid_auto_flow(decl_tbl_get(table, "grid-auto-flow")):
        st.grid_auto_flow_column = true
    val area = normalized_grid_area(decl_tbl_get(table, "grid-area"))
    if area != "":
        st.grid_area = area

fn apply_authored_style_metadata(
    mut st: Style, previous: Style, table: [text],
    logical_writing_mode: text
) -> Style:
    # The integer used-size channel deliberately maps both `auto` and `0px`
    # to zero. Retain declaration identity beside it so alignment can tell
    # automatic sizing from an authored zero without reparsing in layout.
    st.height_auto = previous.height_auto
    st.align_items_authored = previous.align_items_authored
    st.scrollbar_width_none = previous.scrollbar_width_none
    # Match ordinary logical sizing exactly: the cascade owner supplies the
    # already-final cross-phase writing mode. Only standalone apply_decls calls
    # resolve this phase locally from the incoming computed value.
    val sizing_writing_mode = if logical_writing_mode.len() > 0:
        logical_writing_mode
    else:
        _decl_tbl_resolve_writing_mode(previous.writing_mode, table)
    val logical_inline_is_height = sizing_writing_mode != "horizontal-tb"
    var winning_property = "height"
    var winning_position = decl_tbl_last_index(table, winning_property)
    val logical_property = if logical_inline_is_height:
        "inline-size"
    else:
        "block-size"
    val logical_position = decl_tbl_last_index(table, logical_property)
    if logical_position > winning_position:
        winning_property = logical_property
        winning_position = logical_position
    if winning_position >= 0:
        val winning_value = decl_tbl_get(
            table, winning_property
        ).trim().lower()
        st.height_auto = (
            winning_value == "auto" or winning_value == "initial" or
            winning_value == "unset" or winning_value == "revert"
        )
    if (
        decl_tbl_last_index(table, "align-items") >= 0 or
        decl_tbl_last_index(table, "place-items") >= 0
    ):
        st.align_items_authored = true
    st

fn _apply_decls_on_writing_mode(
    st: Style, decls: text, em_base: i32, logical_writing_mode: text,
    apply_display: bool
) -> Style:
    # Preserve the declaration trust boundary before the Grid side path.
    if decls.len() == 0 or _decl_over_quota(decls):
        return st
    # One table owns ordinary values, Grid values, and authored metadata.
    val table = decl_table_build(decls)
    val has_grid_declaration = (
        decl_tbl_last_index(table, "grid-template-columns") >= 0 or
        decl_tbl_last_index(table, "grid-template-rows") >= 0 or
        decl_tbl_last_index(table, "grid-column") >= 0 or
        decl_tbl_last_index(table, "grid-row") >= 0 or
        decl_tbl_last_index(table, "grid-template-areas") >= 0 or
        decl_tbl_last_index(table, "grid-auto-flow") >= 0 or
        decl_tbl_last_index(table, "grid-area") >= 0
    )
    if not has_grid_declaration:
        val ordinary = _apply_decls_without_grid(
            st, decls, table, em_base, logical_writing_mode, apply_display
        )
        return apply_authored_style_metadata(
            ordinary, st, table, logical_writing_mode
        )
    val columns = st.grid_template_columns
    val rows = st.grid_template_rows
    val column = st.grid_column
    val row = st.grid_row
    val areas = st.grid_template_areas
    val area = st.grid_area
    val auto_flow_column = st.grid_auto_flow_column
    var result = _apply_decls_without_grid(
        st, decls, table, em_base, logical_writing_mode, apply_display
    )
    result.grid_template_columns = columns
    result.grid_template_rows = rows
    result.grid_column = column
    result.grid_row = row
    result.grid_template_areas = areas
    result.grid_area = area
    result.grid_auto_flow_column = auto_flow_column
    apply_grid_decls(result, table)
    apply_authored_style_metadata(result, st, table, logical_writing_mode)

fn apply_decls_on_writing_mode(
    st: Style, decls: text, em_base: i32, logical_writing_mode: text
) -> Style:
    _apply_decls_on_writing_mode(
        st, decls, em_base, logical_writing_mode, true
    )

fn apply_decls_without_display_on_writing_mode(
    st: Style, decls: text, em_base: i32, logical_writing_mode: text
) -> Style:
    _apply_decls_on_writing_mode(
        st, decls, em_base, logical_writing_mode, false
    )

fn apply_decls(st: Style, decls: text, em_base: i32) -> Style:
    apply_decls_on_writing_mode(st, decls, em_base, "")

# default per-tag tweaks (block/inline, heading sizes, spacing)
fn _tag_defaults_without_metadata(st: Style, tag: text) -> Style:
    var display_v = st.display
    var font_size_v = st.font_size
    var font_family_v = st.font_family
    var pad_l_v = st.pad_l
    var pad_t_v = st.pad_t
    var pad_r_v = st.pad_r
    var pad_b_v = st.pad_b
    var margin_l_v = st.margin_l
    var margin_t_v = st.margin_t
    var margin_r_v = st.margin_r
    var margin_b_v = st.margin_b
    var border_box_v = st.border_box
    var bold_v = st.bold
    var fg_v = st.fg
    var underline_v = st.text_decoration_underline
    var white_space_nowrap_v = st.white_space_nowrap
    var vertical_align_v = st.vertical_align
    var line_height_v = st.line_height_px
    var text_align_v = st.text_align
