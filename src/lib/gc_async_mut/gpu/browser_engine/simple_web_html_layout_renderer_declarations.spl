    if is_inline_tag(tag):
        display_v = "inline"
    if tag == "h1":
        font_size_v = 34
        bold_v = true
        margin_t_v = 10
        margin_b_v = 10
    elif tag == "h2":
        font_size_v = 26
        bold_v = true
        margin_t_v = 8
        margin_b_v = 8
    elif tag == "h3":
        font_size_v = 20
        bold_v = true
        margin_t_v = 6
        margin_b_v = 6
    elif tag == "h4":
        font_size_v = 16
        bold_v = true
        margin_t_v = 10
        margin_b_v = 10
    elif tag == "h5":
        font_size_v = 13
        bold_v = true
        margin_t_v = 8
        margin_b_v = 8
    elif tag == "h6":
        font_size_v = 11
        bold_v = true
        margin_t_v = 7
        margin_b_v = 7
    elif tag == "p":
        margin_t_v = 16
        margin_b_v = 16
    elif tag == "blockquote":
        margin_l_v = 40
        margin_t_v = 16
        margin_r_v = 40
        margin_b_v = 16
    elif tag == "pre":
        font_family_v = "monospace"
        margin_t_v = 16
        margin_b_v = 16
        white_space_nowrap_v = true
    elif tag == "body":
        display_v = "block"
        margin_l_v = 8
        margin_t_v = 8
        margin_r_v = 8
        margin_b_v = 8
    elif tag == "input":
