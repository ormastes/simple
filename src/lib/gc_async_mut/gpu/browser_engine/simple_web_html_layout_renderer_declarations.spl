    var animation_duration_ms_v = st.animation_duration_ms
    var animation_delay_ms_v = st.animation_delay_ms
    var animation_timing_function_v = st.animation_timing_function
    var animation_iteration_count_v = st.animation_iteration_count
    var animation_direction_v = st.animation_direction
    var animation_fill_mode_v = st.animation_fill_mode
    var animation_play_state_v = st.animation_play_state
    var transform_origin_v = st.transform_origin
    var transform_box_v = st.transform_box
    var transform_style_v = st.transform_style
