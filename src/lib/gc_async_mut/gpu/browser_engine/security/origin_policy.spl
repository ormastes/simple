"""
# Origin Policy

The browser security origin model: origin derivation, equality, opaque (unique)
origins, serialization, and the same-origin-policy decision points.

Reuses the existing `Origin` entity from `net/entity/url_types.spl` — there is no
second origin envelope. Opaque origins are encoded inside that same tuple as
`scheme = "null"`, `host = <unforgeable nonce>`, `port = -1`.

## Why derivation does not go through `Url.parse`

`Url.parse` / `http_client.types.parse_url` cannot be trusted for security
decisions (verified 2026-07-27):

- `data:text/html,...`, `about:blank` and `javascript:alert(1)` all parse to
  `scheme = "http"` with `host` = the scheme text, i.e. a *normal* http origin.
- `""` and `"not a url"` both parse to `scheme = "http", host = ""`, so every
  unparseable input collapses to one shared origin.
- `port` is an `Option` leaking into an `i64` field: under the interpreter it
  prints `Option::Some(80)`, and under the JIT it is uninitialized garbage
  (`640`, `3544`, `216`).

So `origin_from_url_text` does its own strict, fail-closed derivation and
constructs `Origin` directly. Anything it cannot fully validate becomes a fresh
opaque origin, which is trusted by nothing.

Every decision in this module is deny-wins: unknown, malformed, opaque or
partially-populated origins lose.
"""

use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use common.web.host_policy.{is_ip_host_literal}
use common.web.public_suffix.{registrable_domain}

# ---------------------------------------------------------------------------
# low-level scanners (no `parse_int` — it does not resolve at runtime here)
# ---------------------------------------------------------------------------

fn _is_digit(code: i64) -> bool:
    return code >= 48 and code <= 57

fn _is_lower_alpha(code: i64) -> bool:
    return code >= 97 and code <= 122

fn _is_host_char(code: i64) -> bool:
    if _is_digit(code) or _is_lower_alpha(code):
        return true
    # '-' '.' '_' '~'
    return code == 45 or code == 46 or code == 95 or code == 126

fn _is_ipv6_char(code: i64) -> bool:
    if _is_digit(code):
        return true
    if code >= 97 and code <= 102:
        return true
    # ':' '.'
    return code == 58 or code == 46

fn _parse_port(raw: text) -> i64:
    """Strict port parse. Returns -1 for anything not a 1..65535 decimal."""
    if raw.len() == 0 or raw.len() > 5:
        return -1
    var acc = 0
    var i = 0
    while i < raw.len():
        val code = raw.char_code_at(i)
        if not _is_digit(code):
            return -1
        acc = acc * 10 + (code - 48)
        i = i + 1
    if acc < 1 or acc > 65535:
        return -1
    return acc

fn _cut_at_delims(raw: text) -> text:
    """Return the prefix of `raw` before the first '/', '?' or '#'."""
    var i = 0
    while i < raw.len():
        val code = raw.char_code_at(i)
        if code == 47 or code == 63 or code == 35:
            return raw.slice(0, i)
        i = i + 1
    return raw

fn _after_last_at(raw: text) -> text:
    """Strip userinfo: the host starts after the LAST '@' (WHATWG URL rule)."""
    var last = -1
    var i = 0
    while i < raw.len():
        if raw.char_code_at(i) == 64:
            last = i
        i = i + 1
    if last < 0:
        return raw
    return raw.slice(last + 1, raw.len())

fn _is_scheme_token(scheme: text) -> bool:
    if scheme.len() == 0:
        return false
    if not _is_lower_alpha(scheme.char_code_at(0)):
        return false
    var i = 1
    while i < scheme.len():
        val code = scheme.char_code_at(i)
        val ok = _is_lower_alpha(code) or _is_digit(code) or code == 43 or code == 45 or code == 46
        if not ok:
            return false
        i = i + 1
    return true

fn _is_host_token(host: text) -> bool:
    """Registrable host or bracketed IPv6 literal. Rejects a trailing dot.

    The trailing-dot form (`example.com.`) is rejected rather than normalised:
    it is a classic public-suffix / cookie-domain bypass, and rejecting is the
    fail-closed choice.
    """
    if host.len() == 0:
        return false
    if host.starts_with("["):
        if not host.ends_with("]"):
            return false
        if host.len() < 4:
            return false
        var i = 1
        while i < host.len() - 1:
            if not _is_ipv6_char(host.char_code_at(i)):
                return false
            i = i + 1
        return true
    if host.starts_with(".") or host.ends_with("."):
        return false
    if host.index_of("..") >= 0:
        return false
    var j = 0
    while j < host.len():
        if not _is_host_char(host.char_code_at(j)):
            return false
        j = j + 1
    return true

# ---------------------------------------------------------------------------
# schemes
# ---------------------------------------------------------------------------

pub fn default_port_for(scheme: text) -> i64:
    """Default port for a hierarchical (origin-bearing) scheme, else -1.

    A -1 result means "this scheme does not carry a tuple origin" — `data:`,
    `blob:`, `about:`, `javascript:`, `file:` and everything unknown.
    """
    if scheme == "http":
        return 80
    if scheme == "https":
        return 443
    if scheme == "ws":
        return 80
    if scheme == "wss":
        return 443
    if scheme == "ftp":
        return 21
    return -1

pub fn is_secure_scheme(scheme: text) -> bool:
    return scheme == "https" or scheme == "wss"

# ---------------------------------------------------------------------------
# opaque origins
# ---------------------------------------------------------------------------

pub fn is_opaque(origin: Origin) -> bool:
    """True when this origin is opaque (unique)."""
    return origin.scheme == "null"

pub fn opaque_origin(nonce: text) -> Origin:
    """Create an opaque origin carrying `nonce` as its identity.

    Two opaque origins are the same origin only when they carry the same nonce,
    i.e. only when they are literally the same opaque origin. Re-deriving an
    origin from the same `data:` URL twice yields two origins that are NOT the
    same origin — which is what the HTML spec requires.
    """
    return Origin(scheme: "null", host: "opaque:" + nonce, port: -1)

pub class OpaqueOriginSource:
    """Allocator handing out distinct opaque origins.

    Held by a browsing context rather than stored in a module global — cross
    module global state does not survive imports reliably in this toolchain.
    """
    _label: text
    _counter: i64

    static fn create(label: text) -> OpaqueOriginSource:
        return OpaqueOriginSource(_label: label, _counter: 0)

    me fn next() -> Origin:
        val n = self._counter + 1
        self._counter = n
        return opaque_origin(self._label + "#" + n.to_text())

# ---------------------------------------------------------------------------
# derivation
# ---------------------------------------------------------------------------

fn _well_formed(origin: Origin) -> bool:
    """A tuple origin that is fully populated. Opaque origins are not tuples."""
    if is_opaque(origin):
        return false
    if not _is_scheme_token(origin.scheme):
        return false
    if default_port_for(origin.scheme) < 0:
        return false
    if not _is_host_token(origin.host):
        return false
    return origin.port >= 1 and origin.port <= 65535

pub fn is_tuple_origin(origin: Origin) -> bool:
    """True when the origin is a usable (scheme, host, port) tuple."""
    return _well_formed(origin)

pub fn origin_from_url_text(raw: text, opaque_nonce: text) -> Origin:
    """Derive a security origin from a URL string. Fail-closed.

    Anything that is not a fully-validated hierarchical URL — including every
    `data:`, `blob:`, `about:` and `javascript:` URL, and every malformed
    input — yields a FRESH opaque origin identified by `opaque_nonce`.
    """
    val trimmed = raw.trim()
    if trimmed.len() == 0:
        return opaque_origin(opaque_nonce)
    val colon = trimmed.index_of(":")
    if colon <= 0:
        return opaque_origin(opaque_nonce)
    val scheme = trimmed.slice(0, colon).to_lower()
    if not _is_scheme_token(scheme):
        return opaque_origin(opaque_nonce)
    val default_port = default_port_for(scheme)
    if default_port < 0:
        return opaque_origin(opaque_nonce)
    val rest = trimmed.slice(colon + 1, trimmed.len())
    if not rest.starts_with("//"):
        return opaque_origin(opaque_nonce)
    val authority = _after_last_at(_cut_at_delims(rest.slice(2, rest.len())))
    if authority.len() == 0:
        return opaque_origin(opaque_nonce)

    var host = authority
    var port = default_port
    if authority.starts_with("["):
        val close = authority.index_of("]")
        if close < 0:
            return opaque_origin(opaque_nonce)
        host = authority.slice(0, close + 1)
        val tail = authority.slice(close + 1, authority.len())
        if tail.len() > 0:
            if not tail.starts_with(":"):
                return opaque_origin(opaque_nonce)
            port = _parse_port(tail.slice(1, tail.len()))
    else:
        val ci = authority.index_of(":")
        if ci >= 0:
            host = authority.slice(0, ci)
            port = _parse_port(authority.slice(ci + 1, authority.len()))
    if port < 0:
        return opaque_origin(opaque_nonce)
    val lowered = host.to_lower()
    if not _is_host_token(lowered):
        return opaque_origin(opaque_nonce)
    return Origin(scheme: scheme, host: lowered, port: port)

# ---------------------------------------------------------------------------
# equality and serialization
# ---------------------------------------------------------------------------

pub fn same_origin(left: Origin, right: Origin) -> bool:
    """Same-origin check over (scheme, host, port). Deny-wins.

    - An opaque origin is same-origin only with the identical opaque origin.
    - A partially-populated / malformed origin is same-origin with NOTHING,
      not even an identical malformed origin. This is what stops every broken
      URL from collapsing into one shared, mutually-trusting origin.
    """
    if is_opaque(left) or is_opaque(right):
        if not (is_opaque(left) and is_opaque(right)):
            return false
        if left.host == "opaque:":
            return false
        return left.host == right.host
    if not _well_formed(left):
        return false
    if not _well_formed(right):
        return false
    return left.scheme == right.scheme and left.host == right.host and left.port == right.port

fn _valid_ipv4_site_host(host: text) -> bool:
    val parts = host.split(".")
    if parts.len() != 4:
        return false
    for part in parts:
        if part == "":
            return false
        var index = 0
        while index < part.len():
            val code = part.char_code_at(index)
            if code < 48 or code > 57:
                return false
            index = index + 1
        val octet = part.to_i64() ?? -1
        if octet < 0 or octet > 255:
            return false
    true

fn _valid_ip_site_host(host: text) -> bool:
    if host.contains(":"):
        if not host.starts_with("[") or not host.ends_with("]"):
            return false
        var inner = host.slice(1, host.len() - 1)
        if not inner.contains(":") or inner.contains(":::"):
            return false
        if inner.contains("."):
            val last_colon = inner.last_index_of(":")
            if last_colon < 0 or not _valid_ipv4_site_host(inner.slice(last_colon + 1, inner.len())):
                return false
            inner = inner.slice(0, last_colon + 1) + "0:0"
        if (inner.starts_with(":") and not inner.starts_with("::")) or
            (inner.ends_with(":") and not inner.ends_with("::")):
            return false
        var double_count = 0
        var index = 0
        while index + 1 < inner.len():
            if inner.slice(index, index + 2) == "::":
                double_count = double_count + 1
                index = index + 2
            else:
                index = index + 1
        if double_count > 1:
            return false
        var group_count = 0
        for group in inner.split(":"):
            if group != "":
                if group.len() > 4:
                    return false
                var group_index = 0
                while group_index < group.len():
                    if not _is_ipv6_char(group.char_code_at(group_index)):
                        return false
                    group_index = group_index + 1
                group_count = group_count + 1
        if double_count == 0:
            return group_count == 8
        return group_count < 8
    _valid_ipv4_site_host(host)

fn _valid_single_label_site_host(host: text) -> bool:
    if host == "" or host.len() > 63 or host.starts_with("-") or host.ends_with("-"):
        return false
    var index = 0
    while index < host.len():
        val code = host.char_code_at(index)
        if not (_is_lower_alpha(code) or _is_digit(code) or code == 45):
            return false
        index = index + 1
    true

pub fn same_site(left: Origin, right: Origin) -> bool:
    """Schemeful-site comparison. Opaque and malformed origins never match."""
    if not _well_formed(left) or not _well_formed(right):
        return false
    if left.scheme != right.scheme:
        return false
    val left_ip = is_ip_host_literal(left.host)
    val right_ip = is_ip_host_literal(right.host)
    val left_single_label = not left.host.contains(".")
    val right_single_label = not right.host.contains(".")
    if left_ip or right_ip:
        if not (left_ip and right_ip and _valid_ip_site_host(left.host) and _valid_ip_site_host(right.host)):
            return false
        return left.host == right.host
    if left_single_label or right_single_label:
        if not (_valid_single_label_site_host(left.host) and _valid_single_label_site_host(right.host)):
            return false
        return left.host == right.host
    val left_domain = registrable_domain(left.host)
    if left_domain == "":
        return false
    return left_domain == registrable_domain(right.host)

pub fn schemeful_site_key(origin: Origin) -> text:
    """Serialize the schemeful site used by partitioned browser state.

    Ports and subdomains do not affect the key. IP literals and exact
    `localhost` use their normalized host. Other single-label, opaque,
    malformed, public-suffix-only, and unusable hosts have no key.
    """
    if not _well_formed(origin):
        return ""
    val host = origin.host.trim().to_lower()
    if is_ip_host_literal(host):
        if not _valid_ip_site_host(host):
            return ""
        return "{origin.scheme}://{host}"
    if not host.contains("."):
        if host != "localhost":
            return ""
        return "{origin.scheme}://localhost"
    val domain = registrable_domain(host)
    if domain == "":
        return ""
    return "{origin.scheme}://{domain}"

pub fn serialize_origin(origin: Origin) -> text:
    """Serialize per HTML: `"null"` for opaque or unusable, else the ASCII form."""
    if not _well_formed(origin):
        return "null"
    if origin.port == default_port_for(origin.scheme):
        return "{origin.scheme}://{origin.host}"
    return "{origin.scheme}://{origin.host}:{origin.port}"

pub fn is_potentially_trustworthy(origin: Origin) -> bool:
    """Secure-context test used by the `Secure` cookie attribute and permissions."""
    if not _well_formed(origin):
        return false
    if is_secure_scheme(origin.scheme):
        return true
    if origin.host == "localhost" or origin.host == "127.0.0.1" or origin.host == "[::1]":
        return true
    return origin.host.ends_with(".localhost")

# ---------------------------------------------------------------------------
# same-origin-policy decision points
# ---------------------------------------------------------------------------

pub fn can_access_document(subject: Origin, target: Origin) -> bool:
    """May a document in `subject` reach into a document in `target`?"""
    return same_origin(subject, target)

pub fn can_use_storage(origin: Origin) -> bool:
    """Opaque and malformed origins get no storage at all."""
    return _well_formed(origin)

pub fn storage_key(origin: Origin) -> text:
    """Partition key for storage. Empty text means "no storage for you"."""
    if not can_use_storage(origin):
        return ""
    return serialize_origin(origin)

pub fn same_storage_partition(left: Origin, right: Origin) -> bool:
    """Do these two origins share a storage partition?"""
    val key = storage_key(left)
    if key == "":
        return false
    return key == storage_key(right)

pub fn can_read_response(
    requester: Origin,
    response_origin: Origin,
    allow_origin_header: text,
    with_credentials: bool
) -> bool:
    """May `requester` read the body of a response served from `response_origin`?

    Same-origin always may. Cross-origin needs an explicit CORS grant:
    an exact `Access-Control-Allow-Origin` echo, or `*` without credentials.
    An opaque or malformed requester never gets a cross-origin read — in
    particular a literal `Access-Control-Allow-Origin: null` never matches,
    because the serialized form of an opaque origin is not a grant target.
    """
    if same_origin(requester, response_origin):
        return true
    if not _well_formed(requester):
        return false
    val header = allow_origin_header.trim()
    if header.len() == 0:
        return false
    if header == "*":
        return not with_credentials
    if header == "null":
        return false
    return header == serialize_origin(requester)
