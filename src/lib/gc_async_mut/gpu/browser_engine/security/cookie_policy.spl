"""
# Cookie Policy

Enforcement for the RFC 6265bis cookie attributes that `net/cookie_store.spl`
parses but never acted on: `Secure`, `HttpOnly`, `SameSite`, domain and path
matching, the `__Host-` / `__Secure-` name prefixes, and expiry.

Reuses the existing `Cookie` / `SameSite` entities and the existing
`common.web.public_suffix.is_public_suffix` table — no second cookie model and
no second suffix list.

## Relation to `CookieStore.domain_matches`

`CookieStore.domain_matches` implements the *jar key* rule, where a leading dot
marks a subdomain-covering key. `domain_matches` here implements RFC 6265 §5.1.3,
where `Domain=example.com` (dot or no dot) covers `sub.example.com`. The store's
variant is left as-is; this module is the authority for accept/send decisions.

Deny-wins throughout: any check that cannot be satisfied rejects the cookie.
"""

use std.gc_async_mut.gpu.browser_engine.net.entity.cookie_types.{Cookie, SameSite}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use std.gc_async_mut.gpu.browser_engine.security.origin_policy.{
    is_opaque,
    is_tuple_origin,
    is_potentially_trustworthy
}
use common.web.public_suffix.{is_public_suffix}

pub class CookieVerdict:
    """Outcome of a Set-Cookie admission check."""
    accepted: bool
    reason: text

    static fn accept() -> CookieVerdict:
        return CookieVerdict(accepted: true, reason: "ok")

    static fn reject(reason: text) -> CookieVerdict:
        return CookieVerdict(accepted: false, reason: reason)

pub fn canonical_domain(raw: text) -> text:
    """Lowercase a cookie Domain attribute and drop the RFC 6265 leading dot."""
    var domain = raw.trim().to_lower()
    while domain.starts_with("."):
        domain = domain.slice(1, domain.len())
    if domain.ends_with("."):
        return ""
    return domain

pub fn domain_matches(cookie_domain: text, request_host: text) -> bool:
    """RFC 6265 §5.1.3 domain-match, dot-insensitive on the cookie side."""
    val domain = canonical_domain(cookie_domain)
    val host = request_host.trim().to_lower()
    if domain.len() == 0 or host.len() == 0:
        return false
    if domain == host:
        return true
    if not host.ends_with("." + domain):
        return false
    # An IP-literal host never domain-matches a shorter suffix.
    return not host.starts_with("[")

pub fn path_matches(cookie_path: text, request_path: text) -> bool:
    """RFC 6265 §5.1.4 path-match."""
    if not cookie_path.starts_with("/"):
        return false
    var path = request_path
    if not path.starts_with("/"):
        path = "/"
    if cookie_path == path:
        return true
    if cookie_path == "/":
        return true
    if not path.starts_with(cookie_path):
        return false
    if cookie_path.ends_with("/"):
        return true
    return path.slice(cookie_path.len(), cookie_path.len() + 1) == "/"

pub fn is_expired(cookie: Cookie, now: i64) -> bool:
    """`expires_at == 0` is a session cookie and never expires on the clock."""
    if cookie.expires_at == 0:
        return false
    return cookie.expires_at <= now

fn _same_site_is_none(cookie: Cookie) -> bool:
    match cookie.same_site:
        SameSite.None:
            return true
        SameSite.Strict:
            return false
        SameSite.Lax:
            return false
    return false

fn _same_site_is_strict(cookie: Cookie) -> bool:
    match cookie.same_site:
        SameSite.Strict:
            return true
        SameSite.Lax:
            return false
        SameSite.None:
            return false
    return false

pub fn validate_set_cookie(cookie: Cookie, origin: Origin, now: i64) -> CookieVerdict:
    """Decide whether `origin` may set `cookie`. Deny-wins.

    Rejects, in order: opaque/malformed origins, empty names, `SameSite=None`
    without `Secure`, `Secure` from a non-secure origin, `__Host-`/`__Secure-`
    prefix violations, a `Domain` that is a public suffix (so nothing can set a
    cookie for `com` or `co.uk`), a `Domain` that does not cover the request
    host, a relative path, and cookies that are already expired.
    """
    if is_opaque(origin) or not is_tuple_origin(origin):
        return CookieVerdict.reject("opaque-or-malformed-origin")

    val name = cookie.name.trim()
    if name.len() == 0:
        return CookieVerdict.reject("empty-name")

    if _same_site_is_none(cookie) and not cookie.secure:
        return CookieVerdict.reject("samesite-none-requires-secure")

    if cookie.secure and not is_potentially_trustworthy(origin):
        return CookieVerdict.reject("secure-attribute-requires-secure-origin")

    val domain = canonical_domain(cookie.domain)

    if name.starts_with("__Host-"):
        if not cookie.secure:
            return CookieVerdict.reject("host-prefix-requires-secure")
        if cookie.domain.trim().len() != 0:
            return CookieVerdict.reject("host-prefix-forbids-domain")
        if cookie.path != "/":
            return CookieVerdict.reject("host-prefix-requires-root-path")
    elif name.starts_with("__Secure-"):
        if not cookie.secure:
            return CookieVerdict.reject("secure-prefix-requires-secure")

    if cookie.domain.trim().len() != 0:
        if domain.len() == 0:
            return CookieVerdict.reject("malformed-domain")
        if is_public_suffix(domain):
            return CookieVerdict.reject("domain-is-public-suffix")
        if not domain_matches(domain, origin.host):
            return CookieVerdict.reject("domain-not-host-suffix")

    if not cookie.path.starts_with("/"):
        return CookieVerdict.reject("path-must-be-absolute")

    if is_expired(cookie, now):
        return CookieVerdict.reject("already-expired")

    return CookieVerdict.accept()

pub fn effective_domain(cookie: Cookie, origin: Origin) -> text:
    """Jar key for an accepted cookie: the Domain attribute, else host-only."""
    val domain = canonical_domain(cookie.domain)
    if domain.len() > 0:
        return domain
    return origin.host.trim().to_lower()

pub fn script_visible(cookie: Cookie) -> bool:
    """`HttpOnly` cookies are never handed to script (`document.cookie`)."""
    return not cookie.http_only

pub fn cookie_applies(
    cookie: Cookie,
    origin: Origin,
    request_path: text,
    is_same_site_request: bool,
    is_top_level_navigation: bool,
    now: i64
) -> bool:
    """Should `cookie` be attached to a request to `origin` + `request_path`?

    Deny-wins. A `Secure` cookie never leaves a non-secure channel, an expired
    cookie is never sent, and `SameSite` gates cross-site delivery:
    `Strict` same-site only, `Lax` same-site plus top-level navigations,
    `None` anywhere — but `None` is only reachable at all because
    `validate_set_cookie` already forced `Secure` on it.
    """
    if is_opaque(origin) or not is_tuple_origin(origin):
        return false
    if is_expired(cookie, now):
        return false
    if cookie.secure and not is_potentially_trustworthy(origin):
        return false
    if not domain_matches(effective_domain(cookie, origin), origin.host):
        return false
    if not path_matches(cookie.path, request_path):
        return false
    if is_same_site_request:
        return true
    if _same_site_is_none(cookie):
        return cookie.secure
    if _same_site_is_strict(cookie):
        return false
    return is_top_level_navigation

fn _digits_to_i64(raw: text) -> i64:
    """Parse an optionally-signed decimal. Returns 0 on anything malformed."""
    val body = raw.trim()
    if body.len() == 0:
        return 0
    var negative = false
    var start = 0
    if body.starts_with("-"):
        negative = true
        start = 1
    elif body.starts_with("+"):
        start = 1
    if start >= body.len() or body.len() - start > 18:
        return 0
    var acc = 0
    var i = start
    while i < body.len():
        val code = body.char_code_at(i)
        if code < 48 or code > 57:
            return 0
        acc = acc * 10 + (code - 48)
        i = i + 1
    if negative:
        return 0 - acc
    return acc

pub fn apply_max_age(cookie: Cookie, header: text, now: i64) -> Cookie:
    """Resolve a `Max-Age=` attribute in `header` into an absolute `expires_at`.

    `Max-Age<=0` means delete-now, encoded as an expiry one second in the past
    so `is_expired` and `validate_set_cookie` both see it. Absent or malformed
    `Max-Age` leaves the cookie a session cookie.
    """
    val parts = header.split(";")
    var i = 0
    while i < parts.len():
        val part = parts[i].trim()
        i = i + 1
        val lowered = part.to_lower()
        if lowered.starts_with("max-age="):
            val seconds = _digits_to_i64(part.slice(8, part.len()))
            var expiry = now + seconds
            if seconds <= 0:
                expiry = now - 1
            return Cookie {
                name: cookie.name,
                value: cookie.value,
                domain: cookie.domain,
                path: cookie.path,
                secure: cookie.secure,
                http_only: cookie.http_only,
                same_site: cookie.same_site,
                expires_at: expiry
            }
    return cookie
