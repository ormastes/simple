"""
# ScriptHost

Top-level Simple-script integration host for the browser engine (M15).
Owns ConsoleBuffer, EventLoop, and ScriptRunner; exposes typed-route event delivery.

Replaces the JS engine approach — instead reuses the Simple compiler/interpreter
to run <script> tag content as Simple language code.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, BeDomEvent}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomDocumentGeneration, DomNodeRoute, DomIdentityIndex
}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_node_for_route, be_dom_path_for_route,
    be_dom_apply_default_action_to_route,
    be_dom_apply_default_action_to_route_without_focus,
    be_dom_submit_form_owner_route, be_dom_set_children
}
use std.gc_async_mut.gpu.browser_engine.script.console_buffer.{ConsoleBuffer}
use std.gc_async_mut.gpu.browser_engine.script.event_loop.{EventLoop}
use std.gc_async_mut.gpu.browser_engine.script.script_runner.{
    ScriptRunner, run_script, run_script_file
}
use std.gc_async_mut.gpu.browser_engine.net.fetch_dispatch.{FetchDispatch}
use std.gc_async_mut.gpu.browser_engine.script.event_api.{event_dispatch_route}
use std.gc_async_mut.gpu.browser_engine.script.network_api.{ScriptFetchRequest,
    ScriptFetchResponse, fetch_send, script_fetch_to_net_request,
    script_response_from_net}
use std.gc_async_mut.gpu.browser_engine.script.dom_api.{node_set_text_content,
    node_class_list_add, node_class_list_remove, node_class_list_contains}

pub fn script_host_apply_event_action(node: BeDomNode, action: text) -> BeDomNode:
    """Apply one deterministic listener action to the target DOM node."""
    if action.starts_with("set-text:"):
        return node_set_text_content(node, action.substring(9, action.len()))
    if action.starts_with("set-attr:"):
        val payload = action.substring(9, action.len())
        val separator = payload.index_of("=")
        if separator >= 0:
            var next = node
            next.set_attr(payload.substring(0, separator), payload.substring(separator + 1, payload.len()))
            return next
        return node
    if action.starts_with("remove-attr:"):
        var next = node
        next.remove_attr(action.substring(12, action.len()))
        return next
    if action.starts_with("add-class:"):
        return node_class_list_add(node, action.substring(10, action.len()))
    if action.starts_with("remove-class:"):
        return node_class_list_remove(node, action.substring(13, action.len()))
    if action.starts_with("toggle-class:"):
        val cls = action.substring(13, action.len())
        if node_class_list_contains(node, cls):
            return node_class_list_remove(node, cls)
        return node_class_list_add(node, cls)
    node

pub fn script_host_apply_action_to_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    action: text, default_action: bool, allow_focus: bool = true
) -> BeDomNode:
    """Apply a route-authorized action by rebuilding only its ancestor path."""
    if default_action:
        if allow_focus:
            return be_dom_apply_default_action_to_route(root, index, route, action)
        return be_dom_apply_default_action_to_route_without_focus(
            root, index, route, action
        )
    val path = be_dom_path_for_route(root, index, route)
    if path.len() == 0:
        return root
    var next = script_host_apply_event_action(path[path.len() - 1], action)
    var ancestor = path.len() - 2
    while ancestor >= 0:
        val parent = path[ancestor]
        var children: [BeDomNode] = []
        for child in parent.children:
            if child.node_id == next.node_id:
                children.push(next)
            else:
                children.push(child)
        next = be_dom_set_children(parent, children)
        ancestor = ancestor - 1
    next

pub class ScriptHost:
    """Host that manages Simple-script execution, event loop, and console buffer.

    Fields:
        _dom_root      - BrowserSession-committed DOM root
        _event_loop    - macrotask/rAF queue
        _console_buf   - bounded console.log ring buffer
        _dom_dirty     - true if scripts have mutated the DOM since last clear
        _runner        - ScriptRunner that executes Simple code
        fetch_dispatch - optional FetchDispatch for fetch() API (D-4)
    """
    _dom_root: BeDomNode
    _dom_generation: DomDocumentGeneration?
    _dom_identity_index: DomIdentityIndex?
    _event_loop: EventLoop
    _console_buf: ConsoleBuffer
    _dom_dirty: bool
    _runner: ScriptRunner
    fetch_dispatch: FetchDispatch?

    static fn new() -> ScriptHost:
        """Create a ScriptHost with an empty div root."""
        ScriptHost(
            _dom_root: BeDomNode.element("div"),
            _dom_generation: nil,
            _dom_identity_index: nil,
            _event_loop: EventLoop.new(),
            _console_buf: ConsoleBuffer.new(),
            _dom_dirty: false,
            _runner: ScriptRunner.new(),
            fetch_dispatch: nil
        )

    me install_document_state(
        dom_root: BeDomNode, index: DomIdentityIndex,
        generation: DomDocumentGeneration
    ) -> bool:
        """Install only the BrowserSession-committed document state."""
        if index.generation.value != generation.value:
            return false
        var replaces_document = true
        if val Some(current) = self._dom_generation:
            replaces_document = current.value != generation.value
        if replaces_document:
            self._event_loop = EventLoop.new()
        self._dom_root = dom_root
        self._dom_generation = Some(generation)
        self._dom_identity_index = Some(index)
        # Locals-then-store-back: chained field assignment
        # (self._runner.x = ...) fails under the interpreter.
        var runner = self._runner
        runner.dom_root = dom_root
        runner.console_buffer = self._console_buf
        runner.event_loop = self._event_loop
        self._runner = runner
        self._dom_dirty = false
        true

    me execute(source: text):
        """Parse and run a Simple script block against committed DOM state.

        The compatibility ScriptRunner rejects ambient-host Simple execution;
        production pages use the constrained BrowserSession evaluator.
        """
        if self._dom_identity_index == nil or source.trim().len() == 0:
            return
        val stdout = run_script(self._runner, source)
        if stdout.len() > 0:
            self._console_buf.append("log", stdout, 0)
        self._dom_dirty = true

    me execute_file(path: text):
        """Deny legacy Simple script files without reading host paths."""
        if self._dom_identity_index == nil:
            return
        val stdout = run_script_file(self._runner, path)
        if stdout.len() > 0:
            self._console_buf.append("log", stdout, 0)
        self._dom_dirty = true

    me tick(now_micros: i64):
        """Fire expired timers, drain microtasks, flush rAF callbacks.

        Drains expired timers and rAF slots from the event loop.
        Callback execution is logged but not dispatched (no callback registry yet).
        """
        val fired_timers = self._event_loop.drain_expired(now_micros)
        val fired_rafs = self._event_loop.drain_raf(now_micros)
        if fired_timers.len() > 0 or fired_rafs.len() > 0:
            self._dom_dirty = true

    me inject_dom_event_route(
        route: DomNodeRoute, event: BeDomEvent
    ) -> Result<bool, text>:
        """Deliver only a route from this still-published document."""
        val generation = match self._dom_generation:
            Some(value): value
            nil: return Err("invalid_document")
        if route.generation.value != generation.value:
            return Err("stale_target")
        val index = match self._dom_identity_index:
            Some(value): value
            nil: return Err("invalid_document")
        match be_dom_node_for_route(self._dom_root, index, route):
            Some(_): pass_do_nothing
            nil: return Err("stale_target")
        val dispatch = event_dispatch_route(
            self._dom_root, index, route, nil, event
        )
        var action_index = 0
        while action_index < dispatch.actions.len():
            self._dom_root = script_host_apply_action_to_route(
                self._dom_root, index,
                dispatch.current_targets[action_index],
                dispatch.actions[action_index], false
            )
            action_index = action_index + 1
        if dispatch.default_action_allowed:
            self._dom_root = script_host_apply_action_to_route(
                self._dom_root, index, route,
                dispatch.default_action, true
            )
            if (
                dispatch.event.event_type == "click" and
                (dispatch.default_action == "input-checkbox-toggle" or
                 dispatch.default_action == "input-radio-select")
            ):
                val _ = self.inject_dom_event_route(
                    route, BeDomEvent.create(
                        "input", "", true, false
                    )
                )
                val _ = self.inject_dom_event_route(
                    route, BeDomEvent.create(
                        "change", "", true, false
                    )
                )
            if (
                dispatch.event.event_type == "click" and
                dispatch.default_action == "button-activate"
            ):
                if val Some(form_route) = be_dom_submit_form_owner_route(
                    self._dom_root, index, route
                ):
                    val _ = self.inject_dom_event_route(
                        form_route, BeDomEvent.create(
                            "submit", "", true, true
                        )
                    )
        if dispatch.actions.len() > 0 or dispatch.default_action_allowed:
            self._dom_dirty = true
        Ok(true)

    me dom_root() -> BeDomNode:
        """Return the current (possibly script-mutated) DOM root."""
        self._dom_root

    me dom_dirty() -> bool:
        """True if scripts have mutated the DOM since last clear_dirty."""
        self._dom_dirty

    me clear_dirty():
        """Reset the dom_dirty flag."""
        self._dom_dirty = false

    me console_buffer() -> ConsoleBuffer:
        """Read-only access to the console log buffer."""
        self._console_buf

    me event_loop() -> EventLoop:
        """Access to the event loop for timer inspection."""
        self._event_loop

    me runner() -> ScriptRunner:
        """Access to the underlying ScriptRunner."""
        self._runner

    me set_fetch_dispatch(d: FetchDispatch):
        """Wire a FetchDispatch implementation for fetch() calls (D-4)."""
        self.fetch_dispatch = Some(d)

    me fetch(request: ScriptFetchRequest) -> ScriptFetchResponse:
        """Dispatch a fetch request or return the fail-closed zero response."""
        if val dispatch = self.fetch_dispatch:
            return script_response_from_net(dispatch.dispatch(script_fetch_to_net_request(request)))
        fetch_send(request)
