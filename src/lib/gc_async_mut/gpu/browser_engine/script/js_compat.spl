"""
# JS Compatibility Layer

Pure-Simple implementations of common JavaScript standard library functions.
Used by the JS transpiler to provide JS-like APIs in transpiled scripts.

JS Function         -> Simple Function:
    parseInt()      -> js_parse_int()
    parseFloat()    -> js_parse_float()
    String()        -> js_to_string()
    isNaN()         -> js_is_nan()
    isFinite()      -> js_is_finite()
    Math.floor()    -> js_math_floor()
    Math.ceil()     -> js_math_ceil()
    Math.round()    -> js_math_round()
    Math.random()   -> js_math_random()
    Math.abs()      -> js_math_abs()
    Math.min()      -> js_math_min()
    Math.max()      -> js_math_max()
    Math.sqrt()     -> js_math_sqrt()
    Math.pow()      -> js_math_pow()
    Math.PI         -> js_math_pi()
    String.split()  -> js_string_split()
    Array.join()    -> js_string_join()
    String.trim()   -> js_string_trim()
    String.startsWith() -> js_string_starts_with()
    String.endsWith()   -> js_string_ends_with()
    String.includes()   -> js_string_includes()
    String.replace()    -> js_string_replace()
    String.toLowerCase() -> js_string_to_lower()
    String.toUpperCase() -> js_string_to_upper()
    Array.push()    -> js_array_push()
    Array.pop()     -> js_array_pop()
    Array.length    -> js_array_length()
    Array.indexOf() -> js_array_index_of()
    Array.slice()   -> js_array_slice()
    JSON.parse()    -> js_json_parse()
    JSON.stringify() -> js_json_stringify()
    encodeURIComponent() -> js_encode_uri_component()
    decodeURIComponent() -> js_decode_uri_component()
    Date.now()      -> js_date_now()
"""

#![allow(REQC001)]

use std.common.char_from_code_pure.{char_from_code}

extern fn rt_math_floor(x: f64) -> f64
extern fn rt_math_ceil(x: f64) -> f64
extern fn rt_random_random() -> f64
extern fn rt_time_now_unix_millis() -> i64

# =========================================================================
# Number Parsing
# =========================================================================

pub fn js_parse_int(s: text, radix: i64 = 0) -> i64:
    """Parse the leading integer in `s`, like JavaScript `parseInt`.

    Leading whitespace and one sign are accepted. A zero radix selects
    hexadecimal for a `0x` prefix and decimal otherwise; explicit radices from
    2 through 36 are supported. Parsing stops at the first invalid digit.
    This compatibility API returns 0 when no digit is present or the radix is
    invalid because this layer cannot currently represent JavaScript NaN.
    """
    val trimmed = s.trim()
    val len = trimmed.len()
    if len == 0:
        return 0

    var i = 0
    var negative = false
    if trimmed[i] == "-":
        negative = true
        i = i + 1
    elif trimmed[i] == "+":
        i = i + 1

    var effective_radix = radix
    if effective_radix == 0:
        effective_radix = 10
        if i + 1 < len and trimmed[i] == "0" and (trimmed[i + 1] == "x" or trimmed[i + 1] == "X"):
            effective_radix = 16
    if effective_radix < 2 or effective_radix > 36:
        return 0
    if effective_radix == 16 and i + 1 < len and trimmed[i] == "0" and (trimmed[i + 1] == "x" or trimmed[i + 1] == "X"):
        i = i + 2

    var result: i64 = 0
    var found_digit = false
    while i < len:
        val digit = _js_digit_value(trimmed[i])
        if digit < 0 or digit >= effective_radix:
            break
        found_digit = true
        result = result * effective_radix + digit
        i = i + 1
    if not found_digit:
        return 0
    if negative:
        return 0 - result
    result

pub fn js_parse_float(s: text) -> f64:
    """Parse the leading decimal number in `s`, like JavaScript `parseFloat`.

    Leading whitespace and one sign are accepted. Parsing stops after the
    longest valid decimal/fraction/exponent prefix. This compatibility API
    returns 0.0 when no numeric prefix is present because this layer cannot
    currently represent JavaScript NaN.
    """
    val trimmed = s.trim()
    val len = trimmed.len()
    if len == 0:
        return 0.0

    var i = 0
    var negative = false
    if trimmed[i] == "-":
        negative = true
        i = i + 1
    elif trimmed[i] == "+":
        i = i + 1

    var result = 0.0
    var found_digit = false
    while i < len:
        val digit = _js_decimal_digit_value(trimmed[i])
        if digit < 0:
            break
        found_digit = true
        result = result * 10.0 + digit.to_f64()
        i = i + 1

    if i < len and trimmed[i] == ".":
        i = i + 1
        var place = 0.1
        while i < len:
            val digit = _js_decimal_digit_value(trimmed[i])
            if digit < 0:
                break
            found_digit = true
            result = result + digit.to_f64() * place
            place = place / 10.0
            i = i + 1

    if not found_digit:
        return 0.0

    if i < len and (trimmed[i] == "e" or trimmed[i] == "E"):
        var exponent_i = i + 1
        var exponent_negative = false
        if exponent_i < len and trimmed[exponent_i] == "-":
            exponent_negative = true
            exponent_i = exponent_i + 1
        elif exponent_i < len and trimmed[exponent_i] == "+":
            exponent_i = exponent_i + 1
        var exponent: i64 = 0
        var found_exponent_digit = false
        while exponent_i < len:
            val digit = _js_decimal_digit_value(trimmed[exponent_i])
            if digit < 0:
                break
            found_exponent_digit = true
            exponent = exponent * 10 + digit
            exponent_i = exponent_i + 1
        if found_exponent_digit:
            if exponent_negative:
                exponent = 0 - exponent
            result = result * js_math_pow(10.0, exponent.to_f64())

    if negative:
        return 0.0 - result
    result

pub fn js_to_string(v: text) -> text:
    """Convert a value to string. Identity for text type."""
    v

# =========================================================================
# Number Checks
# =========================================================================

pub fn js_is_nan(v: f64) -> bool:
    """Check if a value is NaN. NaN != NaN in IEEE 754."""
    v != v

pub fn js_is_finite(v: f64) -> bool:
    """Check if a value is finite (not NaN and not infinity)."""
    if v != v:
        return false
    if v > 1.7976931348623157e308:
        return false
    if v < -1.7976931348623157e308:
        return false
    true

# =========================================================================
# Math Functions
# =========================================================================

pub fn js_math_floor(x: f64) -> i64:
    """Floor a float to the nearest integer below."""
    val floored = rt_math_floor(x)
    floored.to_i64()

pub fn js_math_ceil(x: f64) -> i64:
    """Ceil a float to the nearest integer above."""
    val ceiled = rt_math_ceil(x)
    ceiled.to_i64()

pub fn js_math_round(x: f64) -> i64:
    """Round a float to the nearest integer."""
    val floored = rt_math_floor(x)
    if x - floored >= 0.5:
        return (floored + 1.0).to_i64()
    floored.to_i64()

pub fn js_math_random() -> f64:
    """Return a random float in [0, 1)."""
    rt_random_random()

pub fn js_math_abs(x: f64) -> f64:
    """Absolute value."""
    if x < 0.0:
        return 0.0 - x
    x

pub fn js_math_min(a: f64, b: f64) -> f64:
    """Return the smaller of two values."""
    if a <= b:
        return a
    b

pub fn js_math_max(a: f64, b: f64) -> f64:
    """Return the larger of two values."""
    if a >= b:
        return a
    b

pub fn js_math_sqrt(x: f64) -> f64:
    """Square root via Newton's method."""
    if x < 0.0:
        return 0.0
    if x == 0.0:
        return 0.0
    var guess = x / 2.0
    var i = 0
    while i < 50:
        val next = (guess + x / guess) / 2.0
        val diff = next - guess
        val abs_diff = if diff < 0.0: 0.0 - diff else: diff
        if abs_diff < 1.0e-15:
            return next
        guess = next
        i = i + 1
    guess

pub fn js_math_pow(base: f64, exp: f64) -> f64:
    """Integer-exponent power function.

    Handles non-negative integer exponents. For fractional exponents
    or negative bases with fractional exp, returns 0.0 (limitation).
    """
    val int_exp = rt_math_floor(exp)
    val frac = exp - int_exp
    val abs_frac = if frac < 0.0: 0.0 - frac else: frac
    if abs_frac > 1.0e-10:
        # Fractional exponent — not supported in pure Simple
        return 0.0
    var n = int_exp.to_i64()
    if n == 0:
        return 1.0
    var result = 1.0
    var b = base
    var neg = false
    if n < 0:
        neg = true
        n = 0 - n
    while n > 0:
        if n % 2 == 1:
            result = result * b
        b = b * b
        n = n / 2
    if neg:
        return 1.0 / result
    result

pub fn js_math_pi() -> f64:
    """Return the value of pi."""
    3.141592653589793

# =========================================================================
# String Functions
# =========================================================================

pub fn js_string_split(s: text, sep: text) -> [text]:
    """Split a string by separator."""
    s.split(sep)

pub fn js_string_join(arr: [text], sep: text) -> text:
    """Join an array of strings with a separator."""
    var result = ""
    var i = 0
    while i < arr.len():
        if i > 0:
            result = result + sep
        result = result + arr[i]
        i = i + 1
    result

pub fn js_string_trim(s: text) -> text:
    """Trim whitespace from both ends."""
    s.trim()

pub fn js_string_starts_with(s: text, prefix: text) -> bool:
    """Check if a string starts with a prefix."""
    s.starts_with(prefix)

pub fn js_string_ends_with(s: text, suffix: text) -> bool:
    """Check if a string ends with a suffix."""
    s.ends_with(suffix)

pub fn js_string_includes(s: text, sub: text) -> bool:
    """Check if a string contains a substring."""
    s.contains(sub)

pub fn js_string_replace(s: text, old: text, replacement: text) -> text:
    """Replace first occurrence of old with replacement."""
    s.replace(old, replacement)

pub fn js_string_to_lower(s: text) -> text:
    """Convert a string to lowercase."""
    s.lower()

pub fn js_string_to_upper(s: text) -> text:
    """Convert a string to uppercase."""
    s.upper()

# =========================================================================
# Array Functions
# =========================================================================

pub fn js_array_push(arr: [text], item: text):
    """Push an item to the end of an array."""
    arr.push(item)

pub fn js_array_pop(arr: [text]) -> text:
    """Pop and return the last item, or empty string if empty."""
    if arr.len() == 0:
        return ""
    val last = arr[arr.len() - 1]
    arr.pop()
    last

pub fn js_array_length(arr: [text]) -> i32:
    """Return the length of an array."""
    arr.len()

pub fn js_array_index_of(arr: [text], item: text) -> i32:
    """Return the index of the first occurrence of item, or -1."""
    var i = 0
    while i < arr.len():
        if arr[i] == item:
            return i
        i = i + 1
    -1

pub fn js_array_slice(arr: [text], start: i32, end_idx: i32) -> [text]:
    """Return a slice of the array from start to end (exclusive)."""
    var result: [text] = []
    var i = start
    while i < end_idx and i < arr.len():
        result.push(arr[i])
        i = i + 1
    result

# =========================================================================
# JSON (stubs)
# =========================================================================

pub fn js_json_parse(s: text) -> text:
    """Parse a JSON string. # STUB: returns input as-is."""
    s

pub fn js_json_stringify(v: text) -> text:
    """Stringify a value to JSON. # STUB: returns input as-is."""
    v

# =========================================================================
# URI Encoding
# =========================================================================

pub fn js_encode_uri_component(s: text) -> text:
    """Percent-encode a URI component like ECMAScript encodeURIComponent.

    Every byte of the UTF-8 encoding is written as %XX (upper-case hex) except
    the unreserved set A-Z a-z 0-9 - _ . ! ~ * ' ( ). Control characters, the
    rest of ASCII punctuation and non-ASCII characters are all escaped.
    """
    var result = ""
    for b in s.bytes():
        val code = b as i64
        if _uri_unreserved_byte(code):
            result = result + char_from_code(code)
        else:
            result = result + "%" + _uri_hex_byte(code)
    result

pub fn js_decode_uri_component(s: text) -> Result<text, text>:
    """Decode a percent-encoded URI component like ECMAScript decodeURIComponent.

    Each %XX is one byte; bytes >= 0x80 must form a well-formed UTF-8 sequence
    of escapes. JavaScript throws `URIError: URI malformed` for a truncated or
    non-hex escape and for an invalid, overlong, surrogate or out-of-range
    sequence; this returns Err with that message instead. Unescaped text,
    including `+` and raw non-ASCII, is passed through.
    """
    val n = s.byte_len()
    var result = ""
    var i = 0
    while i < n:
        val b = s.byte_at(i) as i64
        if b != 37:
            val width = _uri_utf8_width(b)
            val step = if width < 1 or i + width > n: 1 else: width
            result = result + s.slice(i, i + step)
            i = i + step
            continue
        val first = _uri_escape_value(s, i, n)
        if first < 0:
            return Err(_URI_MALFORMED)
        i = i + 3
        if first < 128:
            result = result + char_from_code(first)
            continue
        val width = _uri_utf8_width(first)
        if width < 2:
            return Err(_URI_MALFORMED)
        var code = if width == 2: first - 192 elif width == 3: first - 224 else: first - 240
        var k = 1
        while k < width:
            val next = _uri_escape_value(s, i, n)
            if next < 128 or next > 191:
                return Err(_URI_MALFORMED)
            code = code * 64 + (next - 128)
            i = i + 3
            k = k + 1
        val smallest = if width == 2: 128 elif width == 3: 2048 else: 65536
        if code < smallest or code > 1114111 or (code >= 55296 and code <= 57343):
            return Err(_URI_MALFORMED)
        result = result + char_from_code(code)
    Ok(result)

# =========================================================================
# Date
# =========================================================================

pub fn js_date_now() -> i64:
    """Return current time in milliseconds since epoch."""
    rt_time_now_unix_millis()

# =========================================================================
# Internal Helpers
# =========================================================================

fn _js_decimal_digit_value(ch: text) -> i64:
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    0 - 1

fn _js_digit_value(ch: text) -> i64:
    val decimal = _js_decimal_digit_value(ch)
    if decimal >= 0:
        return decimal
    val lower = ch.lower()
    if lower == "a": return 10
    if lower == "b": return 11
    if lower == "c": return 12
    if lower == "d": return 13
    if lower == "e": return 14
    if lower == "f": return 15
    if lower == "g": return 16
    if lower == "h": return 17
    if lower == "i": return 18
    if lower == "j": return 19
    if lower == "k": return 20
    if lower == "l": return 21
    if lower == "m": return 22
    if lower == "n": return 23
    if lower == "o": return 24
    if lower == "p": return 25
    if lower == "q": return 26
    if lower == "r": return 27
    if lower == "s": return 28
    if lower == "t": return 29
    if lower == "u": return 30
    if lower == "v": return 31
    if lower == "w": return 32
    if lower == "x": return 33
    if lower == "y": return 34
    if lower == "z": return 35
    0 - 1

val _URI_MALFORMED: text = "URIError: URI malformed"

fn _uri_unreserved_byte(code: i64) -> bool:
    """A-Z a-z 0-9 - _ . ! ~ * ' ( ) — the bytes encodeURIComponent keeps."""
    if (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57):
        return true
    (code == 45 or code == 95 or code == 46 or code == 33 or code == 126 or
        code == 42 or code == 39 or code == 40 or code == 41)

fn _uri_hex_byte(code: i64) -> text:
    val digits = "0123456789ABCDEF"
    digits.slice(code / 16, code / 16 + 1) + digits.slice(code % 16, code % 16 + 1)

fn _uri_hex_value(code: i64) -> i64:
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 65 and code <= 70:
        return code - 55
    if code >= 97 and code <= 102:
        return code - 87
    return -1

# Value of the `%XX` escape that starts at byte `at`, or -1 when there is no
# complete, well-formed escape there.
fn _uri_escape_value(s: text, at: i64, n: i64) -> i64:
    if at + 2 >= n or (s.byte_at(at) as i64) != 37:
        return -1
    val hi = _uri_hex_value(s.byte_at(at + 1) as i64)
    val lo = _uri_hex_value(s.byte_at(at + 2) as i64)
    if hi < 0 or lo < 0:
        return -1
    hi * 16 + lo

# Length of the UTF-8 sequence a lead byte announces; 1 for ASCII, 0 for a
# byte that cannot start a sequence (continuation byte, 0xC0/0xC1, >= 0xF5).
fn _uri_utf8_width(lead: i64) -> i64:
    if lead < 128:
        return 1
    if lead >= 194 and lead <= 223:
        return 2
    if lead >= 224 and lead <= 239:
        return 3
    if lead >= 240 and lead <= 244:
        return 4
    0

