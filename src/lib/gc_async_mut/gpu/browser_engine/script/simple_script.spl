"""
# SimpleScript Executor

Executes Simple language code in the browser engine, providing DOM access,
event handling, timers, and console output equivalent to JavaScript (M15 / REQ-6 / AC-5).

The SimpleScriptExecutor wraps the Simple interpreter and bridges it to the
browser DOM and event loop infrastructure.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, BeDomEvent}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomDocumentGeneration, DomIdentityIndex
}
use std.gc_async_mut.gpu.browser_engine.script.console_buffer.{ConsoleBuffer}
use std.gc_async_mut.gpu.browser_engine.script.event_loop.{EventLoop,
    EVENT_LOOP_MAX_PENDING_TASKS}
use std.gc_async_mut.gpu.browser_engine.net.fetch_dispatch.{FetchDispatch}
use std.gc_async_mut.gpu.browser_engine.script.event_api.{event_dispatch}
use std.gc_async_mut.gpu.browser_engine.script.script_runner.{ScriptRunner, run_script}
use std.gc_async_mut.gpu.browser_engine.script.script_host.{script_host_apply_event_action}
use std.gc_async_mut.gpu.browser_engine.script.network_api.{ScriptFetchRequest,
    ScriptFetchResponse, fetch_send, script_fetch_to_net_request,
    script_response_from_net}

val SIMPLE_SCRIPT_MAX_CALLBACKS: i64 = 256
val SIMPLE_SCRIPT_MAX_CALLBACK_SOURCE_BYTES: i64 = 65536

pub class SimpleScriptExecutor:
    """Executor for Simple language code in the browser.

    Fields:
        _dom_root       - current DOM root for this script context
        _event_loop     - shared event loop for timers and rAF
        _console_buf    - shared console output buffer
        _dom_dirty      - true if Simple code mutated the DOM
        fetch_dispatch  - optional FetchDispatch for fetch() API
        _runner         - canonical browser Simple/JavaScript runner
    """
    _dom_root: BeDomNode
    _dom_generation: DomDocumentGeneration?
    _dom_identity_index: DomIdentityIndex?
    _event_loop: EventLoop
    _console_buf: ConsoleBuffer
    _dom_dirty: bool
    _callback_ids: [i64]
    _callback_sources: [text]
    _callback_count: i64
    fetch_dispatch: FetchDispatch?
    _runner: ScriptRunner

    static fn new(event_loop: EventLoop, console_buf: ConsoleBuffer) -> SimpleScriptExecutor:
        """Create a SimpleScriptExecutor with empty DOM root."""
        SimpleScriptExecutor(
            _dom_root: BeDomNode.element("div"),
            _dom_generation: nil,
            _dom_identity_index: nil,
            _event_loop: event_loop,
            _console_buf: console_buf,
            _dom_dirty: false,
            _callback_ids: [],
            _callback_sources: [],
            _callback_count: 0,
            fetch_dispatch: nil,
            _runner: ScriptRunner.new()
        )

    me reset(dom_root: BeDomNode):
        """Bind a new document and discard callbacks and work from the old one."""
        self._dom_root = dom_root
        self._event_loop = EventLoop.new()
        self._runner.dom_root = dom_root
        self._runner.event_loop = self._event_loop
        self._console_buf.clear()
        self._runner.console_buffer = self._console_buf
        self._callback_ids = []
        self._callback_sources = []
        self._callback_count = 0
        self._dom_dirty = false

    me publish_dom(
        dom_root: BeDomNode, generation: DomDocumentGeneration,
        index: DomIdentityIndex
    ) -> bool:
        """Publish a DOM snapshot only when its index has the same generation."""
        if index.generation.value != generation.value:
            return false
        self._dom_root = dom_root
        self._dom_generation = Some(generation)
        self._dom_identity_index = Some(index)
        true

    me reset_document(
        dom_root: BeDomNode, generation: DomDocumentGeneration,
        index: DomIdentityIndex
    ) -> bool:
        """Replace a document and retire all callbacks from its predecessor."""
        if index.generation.value != generation.value:
            return false
        self.reset(dom_root)
        self._dom_generation = Some(generation)
        self._dom_identity_index = Some(index)
        true

    me register_callback(callback_id: i64, source: text) -> bool:
        """Retain one bounded command body under a stable callback identity."""
        if (callback_id < 0 or source.trim() == "" or
            source.len() > SIMPLE_SCRIPT_MAX_CALLBACK_SOURCE_BYTES):
            return false
        var i = 0
        while i < self._callback_ids.len():
            if self._callback_ids[i] == callback_id:
                self._callback_sources[i] = source
                return true
            i = i + 1
        if self._callback_ids.len() >= SIMPLE_SCRIPT_MAX_CALLBACKS:
            return false
        self._callback_ids.push(callback_id)
        self._callback_sources.push(source)
        true

    fn has_callback(callback_id: i64) -> bool:
        """Return whether callback_id names a retained command body."""
        var i = 0
        while i < self._callback_ids.len():
            if self._callback_ids[i] == callback_id:
                return true
            i = i + 1
        false

    me schedule_timeout(callback_id: i64, now_micros: i64, delay_ms: i64) -> i64:
        """Schedule a retained callback once on the canonical EventLoop."""
        if self._event_loop.pending_timer_count() >= EVENT_LOOP_MAX_PENDING_TASKS:
            return -1
        val delay = if delay_ms > 0: delay_ms else: 0
        self._event_loop.schedule_timer(
            callback_id, now_micros + delay * 1000, 0
        )

    me schedule_interval(callback_id: i64, now_micros: i64, delay_ms: i64) -> i64:
        """Schedule a retained callback repeatedly on the canonical EventLoop."""
        if (delay_ms <= 0 or
            self._event_loop.pending_timer_count() >=
                EVENT_LOOP_MAX_PENDING_TASKS):
            return -1
        self._event_loop.schedule_timer(
            callback_id, now_micros + delay_ms * 1000, delay_ms * 1000
        )

    me schedule_animation_frame(callback_id: i64) -> bool:
        """Schedule a retained callback in the canonical next-frame slot."""
        if self._event_loop.pending_raf_count() >= EVENT_LOOP_MAX_PENDING_TASKS:
            return false
        self._event_loop.schedule_raf(callback_id)
        true

    me cancel_timer(timer_id: i64):
        """Cancel a timeout or interval by its canonical EventLoop identity."""
        self._event_loop.cancel_timer(timer_id)

    fn _callback_source(callback_id: i64) -> text:
        var i = 0
        while i < self._callback_ids.len():
            if self._callback_ids[i] == callback_id:
                return self._callback_sources[i]
            i = i + 1
        ""

    me execute(source: text, dom_root: BeDomNode):
        """Parse and execute Simple code against dom_root.

        Stores dom_root as the current root. Empty source is a no-op. Non-empty
        source is delegated to the canonical ScriptRunner so this compatibility
        surface shares the browser's interpreter, DOM, event-loop, and console
        ownership rather than maintaining a second execution path.
        """
        self._dom_root = dom_root
        if source.len() == 0:
            return

        self._runner.dom_root = dom_root
        self._runner.console_buffer = self._console_buf
        self._runner.event_loop = self._event_loop
        val stdout = run_script(self._runner, source)
        if stdout.len() > 0:
            self._console_buf.append("log", stdout, 0)
        self._dom_dirty = true

    me tick(now_micros: i64) -> [text]:
        """Fire expired timers and drain microtasks from event loop.

        Callback IDs are owned by the canonical EventLoop. Draining any timer
        or animation-frame work invalidates the rendered DOM snapshot.
        """
        val timers = self._event_loop.drain_expired(now_micros)
        val raf = self._event_loop.drain_raf()
        var callbacks: [text] = []
        for callback_id in timers:
            val source = self._callback_source(callback_id)
            if source != "":
                callbacks.push(source)
                self._callback_count = self._callback_count + 1
        for callback_id in raf:
            val source = self._callback_source(callback_id)
            if source != "":
                callbacks.push(source)
                self._callback_count = self._callback_count + 1
        if timers.len() > 0 or raf.len() > 0:
            self._dom_dirty = true
        callbacks

    fn callback_count() -> i64:
        """Return the number of retained callback invocations."""
        self._callback_count

    fn next_due_ms() -> i64:
        """Return the next callback deadline on the shared millisecond clock."""
        val due = self._event_loop.next_due_micros()
        if due < 0:
            return -1
        due / 1000

    me inject_dom_event(event: BeDomEvent):
        """Dispatch a DOM event into registered Simple event listeners.

        Deterministic listener actions are dispatched through the same DOM
        owner used by ScriptHost. Any delivered action invalidates rendering.
        """
        val actions = event_dispatch(self._dom_root, event)
        for action in actions:
            self._dom_root = script_host_apply_event_action(self._dom_root, action)
        if actions.len() == 0:
            return
        self._dom_dirty = true

    me dom_root() -> BeDomNode:
        """Return the current (possibly Simple-mutated) DOM root."""
        self._dom_root

    me dom_dirty() -> bool:
        """True if Simple code has mutated the DOM since last clear."""
        self._dom_dirty

    me clear_dirty():
        """Reset the dom_dirty flag."""
        self._dom_dirty = false

    me console_buffer() -> ConsoleBuffer:
        """Read-only access to the shared console log buffer."""
        self._console_buf

    me event_loop() -> EventLoop:
        """Return the shared timer and animation-frame owner."""
        self._event_loop

    me set_fetch_dispatch(d: FetchDispatch):
        """Wire a FetchDispatch implementation for fetch() calls."""
        self.fetch_dispatch = Some(d)

    me fetch(request: ScriptFetchRequest) -> ScriptFetchResponse:
        """Dispatch a fetch request or return the fail-closed zero response."""
        if val dispatch = self.fetch_dispatch:
            return script_response_from_net(dispatch.dispatch(script_fetch_to_net_request(request)))
        fetch_send(request)

    me log(level: text, message: text, now_micros: i64):
        """Append a console log entry (called from Simple code)."""
        self._console_buf.append(level, message, now_micros)
