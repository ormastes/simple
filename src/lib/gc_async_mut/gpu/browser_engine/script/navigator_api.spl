"""Navigator API for browser scripts.

Provides the browser-facing `navigator` data surface and a secure-context
entrypoint for `navigator.gpu`.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use std.gc_async_mut.gpu.browser_engine.security.permission_policy.{PermissionSet}
use std.gc_async_mut.gpu.browser_engine.webgpu_context.{WebGPUContext, webgpu_create_context}

pub class BrowserNavigator:
    user_agent: text
    language: text
    online: bool
    secure_context: bool
    platform: text

    static fn create(secure_context: bool) -> BrowserNavigator:
        BrowserNavigator(
            user_agent: "SimpleBrowser/0.1",
            language: "en-US",
            online: true,
            secure_context: secure_context,
            platform: "simple"
        )

    fn gpu_available() -> bool:
        self.secure_context

    fn request_gpu() -> WebGPUContext:
        webgpu_create_context(self.secure_context)

pub fn navigator_create(secure_context: bool) -> BrowserNavigator:
    BrowserNavigator.create(secure_context)

pub fn navigator_user_agent(nav: BrowserNavigator) -> text:
    nav.user_agent

pub fn navigator_language(nav: BrowserNavigator) -> text:
    nav.language

pub fn navigator_on_line(nav: BrowserNavigator) -> bool:
    nav.online

pub fn navigator_platform(nav: BrowserNavigator) -> text:
    nav.platform

pub fn navigator_gpu_available(nav: BrowserNavigator) -> bool:
    nav.gpu_available()

pub fn navigator_gpu(nav: BrowserNavigator) -> WebGPUContext:
    nav.request_gpu()

# =========================================================================
# Permission-gated navigator features
# =========================================================================

pub fn navigator_feature_allowed(perms: PermissionSet, origin: Origin, feature: text) -> bool:
    """The gate for every permission-backed `navigator.*` feature.

    Default-deny: `permission_policy.PermissionSet.query` answers `Denied` for
    an ungranted origin, an opaque origin, an unknown feature, and a
    secure-context-only feature held by a non-secure origin. The old
    `secure_context: bool` flag was a per-browser toggle, not a per-origin
    grant, and gated nothing but `navigator.gpu`.
    """
    return perms.allows(origin, feature)

pub fn navigator_geolocation_allowed(perms: PermissionSet, origin: Origin) -> bool:
    return navigator_feature_allowed(perms, origin, "geolocation")

pub fn navigator_notifications_allowed(perms: PermissionSet, origin: Origin) -> bool:
    return navigator_feature_allowed(perms, origin, "notifications")
