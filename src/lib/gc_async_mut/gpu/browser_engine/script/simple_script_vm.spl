# In-process constrained Simple DOM Script VM for <script type="text/simple">.
#
# Provides safe DOM query/mutation, style/classList/attribute helpers,
# form control properties, DataTransfer, console logging, and capture/bubble
# DOM event listener dispatch without spawning host compilers or processes.

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, BeDomEvent}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_get_attr, be_dom_has_attr, be_dom_get_text_content,
    be_dom_serialize_children, be_dom_set_children,
    be_dom_query_selector_all, be_dom_find_by_id, be_dom_find_by_node_id,
    be_dom_find_by_tag
}
use std.gc_async_mut.gpu.browser_engine.html_tree_builder.{html_tree_builder_build}
use std.gc_async_mut.gpu.browser_engine.script.console_buffer.{ConsoleBuffer}
use std.gc_async_mut.gpu.browser_engine.style_block.{CssDecl}
use std.gc_async_mut.gpu.browser_engine.style_block_parse.{parse_declarations}
use std.gc_async_mut.web.browser_session_form.{
    browser_select_value, browser_select_update
}

val SIMPLE_SCRIPT_VM_MAX_LOOP: i64 = 4096
val SIMPLE_SCRIPT_VM_MAX_DEPTH: i64 = 32

class SimpleScriptVal:
    kind: text
    text_val: text
    int_val: i64
    float_val: f64
    bool_val: bool
    node_id: i64
    items: [SimpleScriptVal]

impl SimpleScriptVal:
    static fn none() -> SimpleScriptVal:
        SimpleScriptVal(kind: "none", text_val: "", int_val: 0, float_val: 0.0, bool_val: false, node_id: -1, items: [])

    static fn from_bool(b: bool) -> SimpleScriptVal:
        SimpleScriptVal(kind: "bool", text_val: if b: "true" else: "false", int_val: if b: 1 else: 0, float_val: if b: 1.0 else: 0.0, bool_val: b, node_id: -1, items: [])

    static fn from_int(v: i64) -> SimpleScriptVal:
        SimpleScriptVal(kind: "int", text_val: "{v}", int_val: v, float_val: v.to_f64(), bool_val: v != 0, node_id: -1, items: [])

    static fn from_float(v: f64) -> SimpleScriptVal:
        var s = "{v}"
        if s.ends_with(".0"):
            s = s.substring(0, s.byte_len() - 2)
        SimpleScriptVal(kind: "float", text_val: s, int_val: v.to_i64(), float_val: v, bool_val: v != 0.0, node_id: -1, items: [])

    static fn from_text(t: text) -> SimpleScriptVal:
        SimpleScriptVal(kind: "text", text_val: t, int_val: 0, float_val: 0.0, bool_val: t != "", node_id: -1, items: [])

    static fn dom(node_id: i64) -> SimpleScriptVal:
        if node_id < 0:
            return SimpleScriptVal.none()
        SimpleScriptVal(kind: "dom", text_val: "", int_val: node_id, float_val: node_id.to_f64(), bool_val: true, node_id: node_id, items: [])

    static fn obj(kind: text, node_id: i64) -> SimpleScriptVal:
        SimpleScriptVal(kind: kind, text_val: "", int_val: node_id, float_val: 0.0, bool_val: true, node_id: node_id, items: [])

    static fn from_list(items: [SimpleScriptVal]) -> SimpleScriptVal:
        SimpleScriptVal(kind: "list", text_val: "", int_val: items.len().to_i64(), float_val: 0.0, bool_val: items.len() > 0, node_id: -1, items: items)

    fn is_truthy() -> bool:
        if self.kind == "none": return false
        if self.kind == "bool": return self.bool_val
        if self.kind == "int": return self.int_val != 0
        if self.kind == "float": return self.float_val != 0.0
        if self.kind == "text": return self.text_val != ""
        if self.kind == "dom": return self.node_id >= 0
        if self.kind == "list": return self.items.len() > 0
        true

    fn as_text() -> text:
        if self.kind == "text": return self.text_val
        if self.kind == "int": return "{self.int_val}"
        if self.kind == "float": return self.text_val
        if self.kind == "bool": return if self.bool_val: "true" else: "false"
        if self.kind == "none": return ""
        if self.kind == "dom": return "[BeDomNode:{self.node_id}]"
        self.text_val

    fn as_int() -> i64:
        if self.kind == "int": return self.int_val
        if self.kind == "float": return self.float_val.to_i64()
        if self.kind == "bool": return if self.bool_val: 1 else: 0
        if self.kind == "text": return self.text_val.trim().parse_i64() ?? 0
        0

    fn as_float() -> f64:
        if self.kind == "float": return self.float_val
        if self.kind == "int": return self.int_val.to_f64()
        if self.kind == "bool": return if self.bool_val: 1.0 else: 0.0
        if self.kind == "text": return self.text_val.trim().parse_f64() ?? 0.0
        0.0

class SimpleScriptFn:
    name: text
    params: [text]
    body_lines: [text]
    body_indents: [i64]

class SimpleScriptDomListener:
    node_id: i64
    event_type: text
    fn_name: text
    inline_params: [text]
    inline_lines: [text]
    inline_indents: [i64]
    capture: bool
    once: bool

class SimpleScriptExecFrame:
    returned: bool
    ret_val: SimpleScriptVal
    names: [text]
    values: [SimpleScriptVal]
    is_top_level: bool

fn _ss_css_name(name: text) -> text:
    if name == "cssFloat":
        return "float"
    if name.starts_with("--"):
        return name
    var out = ""
    var i: i64 = 0
    val n = name.byte_len()
    while i < n:
        val ch = name.substring(i, i + 1)
        if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(ch):
            out = out + "-" + ch.lower()
        else:
            out = out + ch
        i = i + 1
    out

fn _ss_style_set(style_text: text, prop: text, value: text) -> text:
    val target = _ss_css_name(prop)
    var decls = parse_declarations(style_text)
    var kept: [CssDecl] = []
    for decl in decls:
        val p = decl.property.trim()
        val matches = if target.starts_with("--"): p == target else: p.lower() == target.lower()
        if not matches:
            kept.push(decl)
    if value.trim() != "":
        kept.push(CssDecl(property: target, value: value.trim()))
    var out = ""
    for decl in kept:
        out = out + decl.property + ":" + decl.value + ";"
    out

fn _ss_style_get(style_text: text, prop: text) -> text:
    val target = _ss_css_name(prop)
    val decls = parse_declarations(style_text)
    var found = ""
    for decl in decls:
        val p = decl.property.trim()
        val matches = if target.starts_with("--"): p == target else: p.lower() == target.lower()
        if matches:
            found = decl.value
    found

fn _ss_max_node_id(node: BeDomNode) -> i64:
    var m = node.node_id
    for child in node.children:
        val cm = _ss_max_node_id(child)
        if cm > m:
            m = cm
    m

fn _ss_assign_ids(node: BeDomNode, parent_id: i64, mut next_id: i64) -> (BeDomNode, i64):
    var cur = node
    if cur.node_id <= 0:
        cur.node_id = next_id
        next_id = next_id + 1
    cur.parent_id = parent_id
    var new_children: [BeDomNode] = []
    for child in cur.children:
        val res = _ss_assign_ids(child, cur.node_id, next_id)
        new_children.push(res.0)
        next_id = res.1
    cur.children = new_children
    (cur, next_id)

fn _ss_replace_node_by_id(root: BeDomNode, replacement: BeDomNode) -> BeDomNode:
    if root.node_id == replacement.node_id:
        return replacement
    var new_children: [BeDomNode] = []
    var changed = false
    for child in root.children:
        val next_child = _ss_replace_node_by_id(child, replacement)
        new_children.push(next_child)
        changed = true
    if changed:
        return be_dom_set_children(root, new_children)
    root

fn _ss_find_parent_id(root: BeDomNode, target_id: i64) -> i64:
    for child in root.children:
        if child.node_id == target_id:
            return root.node_id
        val nested = _ss_find_parent_id(child, target_id)
        if nested >= 0:
            return nested
    -1

fn _ss_select_index(node: BeDomNode) -> i64:
    var idx: i64 = 0
    var fallback: i64 = -1
    for child in node.children:
        if child.tag_name == "option":
            if fallback < 0:
                fallback = idx
            if be_dom_has_attr(child, "selected"):
                return idx
            idx = idx + 1
    fallback

fn _ss_select_by_index(node: BeDomNode, target_idx: i64) -> BeDomNode:
    var next = node
    var opt_idx: i64 = 0
    var new_children: [BeDomNode] = []
    for child in next.children:
        var c = child
        if c.tag_name == "option":
            if opt_idx == target_idx and not be_dom_has_attr(c, "disabled"):
                c.set_attr("selected", "selected")
            else:
                c.remove_attr("selected")
            opt_idx = opt_idx + 1
        new_children.push(c)
    next.children = new_children
    next

fn _ss_is_ident_char(ch: text) -> bool:
    if ch.byte_len() != 1:
        return false
    ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_").contains(ch)

fn _ss_is_digit(ch: text) -> bool:
    ch.byte_len() == 1 and ("0123456789").contains(ch)

fn _ss_strip_inline_comment(line: text) -> text:
    var in_sq = false
    var in_dq = false
    var esc = false
    var i: i64 = 0
    val n = line.byte_len()
    while i < n:
        val ch = line.substring(i, i + 1)
        if esc:
            esc = false
        elif ch == "\\" and (in_sq or in_dq):
            esc = true
        elif ch == "'" and not in_dq:
            in_sq = not in_sq
        elif ch == "\"" and not in_sq:
            in_dq = not in_dq
        elif ch == "#" and not in_sq and not in_dq:
            return line.substring(0, i)
        i = i + 1
    line

fn _ss_count_indent(line: text) -> i64:
    var i: i64 = 0
    val n = line.byte_len()
    while i < n:
        val ch = line.substring(i, i + 1)
        if ch == " ":
            i = i + 1
        elif ch == "\t":
            i = i + 4
        else:
            break
    i

fn _ss_find_top_level_op(expr: text, op: text) -> i64:
    # Find rightmost occurrence of op outside quotes, parens, brackets, braces.
    var depth_p: i64 = 0
    var depth_b: i64 = 0
    var depth_c: i64 = 0
    var in_sq = false
    var in_dq = false
    var esc = false
    val n = expr.byte_len()
    val oplen = op.byte_len()
    var last: i64 = -1
    var i: i64 = 0
    while i <= n - oplen:
        val ch = expr.substring(i, i + 1)
        if esc:
            esc = false
            i = i + 1
            continue
        if ch == "\\" and (in_sq or in_dq):
            esc = true
            i = i + 1
            continue
        if ch == "'" and not in_dq:
            in_sq = not in_sq
            i = i + 1
            continue
        if ch == "\"" and not in_sq:
            in_dq = not in_dq
            i = i + 1
            continue
        if not in_sq and not in_dq:
            if ch == "(": depth_p = depth_p + 1
            elif ch == ")": depth_p = depth_p - 1
            elif ch == "[": depth_b = depth_b + 1
            elif ch == "]": depth_b = depth_b - 1
            elif ch == "{": depth_c = depth_c + 1
            elif ch == "}": depth_c = depth_c - 1
            elif depth_p == 0 and depth_b == 0 and depth_c == 0:
                if expr.substring(i, i + oplen) == op:
                    # For word ops like "and" / "or", check boundaries
                    var ok = true
                    if op == " and " or op == " or ":
                        ok = true
                    elif op == "+" or op == "-":
                        # Avoid unary leading + / - or after another operator
                        if i == 0:
                            ok = false
                        else:
                            val prev = expr.substring(0, i).trim()
                            if prev == "" or prev.ends_with("(") or prev.ends_with(",") or prev.ends_with("=") or prev.ends_with("!") or prev.ends_with("<") or prev.ends_with(">") or prev.ends_with("+") or prev.ends_with("-") or prev.ends_with("*") or prev.ends_with("/"):
                                ok = false
                    if ok:
                        last = i
        i = i + 1
    last

fn _ss_find_top_level_char(s: text, target: text, from_right: bool) -> i64:
    var depth_p: i64 = 0
    var depth_b: i64 = 0
    var depth_c: i64 = 0
    var in_sq = false
    var in_dq = false
    var esc = false
    val n = s.byte_len()
    var last: i64 = -1
    var i: i64 = 0
    while i < n:
        val ch = s.substring(i, i + 1)
        if esc:
            esc = false
            i = i + 1
            continue
        if ch == "\\" and (in_sq or in_dq):
            esc = true
            i = i + 1
            continue
        if ch == "'" and not in_dq:
            in_sq = not in_sq
            i = i + 1
            continue
        if ch == "\"" and not in_sq:
            in_dq = not in_dq
            i = i + 1
            continue
        if not in_sq and not in_dq:
            if ch == "(": depth_p = depth_p + 1
            elif ch == ")": depth_p = depth_p - 1
            elif ch == "[": depth_b = depth_b + 1
            elif ch == "]": depth_b = depth_b - 1
            elif ch == "{": depth_c = depth_c + 1
            elif ch == "}": depth_c = depth_c - 1
            elif depth_p == 0 and depth_b == 0 and depth_c == 0 and ch == target:
                if not from_right:
                    return i
                last = i
        i = i + 1
    last

fn _ss_split_top_level_args(args_str: text) -> [text]:
    val trimmed = args_str.trim()
    if trimmed == "":
        return []
    var out: [text] = []
    var depth_p: i64 = 0
    var depth_b: i64 = 0
    var depth_c: i64 = 0
    var in_sq = false
    var in_dq = false
    var esc = false
    var start: i64 = 0
    var i: i64 = 0
    val n = trimmed.byte_len()
    while i < n:
        val ch = trimmed.substring(i, i + 1)
        if esc:
            esc = false
        elif ch == "\\" and (in_sq or in_dq):
            esc = true
        elif ch == "'" and not in_dq:
            in_sq = not in_sq
        elif ch == "\"" and not in_sq:
            in_dq = not in_dq
        elif not in_sq and not in_dq:
            if ch == "(": depth_p = depth_p + 1
            elif ch == ")": depth_p = depth_p - 1
            elif ch == "[": depth_b = depth_b + 1
            elif ch == "]": depth_b = depth_b - 1
            elif ch == "{": depth_c = depth_c + 1
            elif ch == "}": depth_c = depth_c - 1
            elif ch == "," and depth_p == 0 and depth_b == 0 and depth_c == 0:
                out.push(trimmed.substring(start, i).trim())
                start = i + 1
        i = i + 1
    out.push(trimmed.substring(start, n).trim())
    out

fn _ss_is_wrapped_parens(expr: text) -> bool:
    val n = expr.byte_len()
    if n < 2 or expr.substring(0, 1) != "(" or expr.substring(n - 1, n) != ")":
        return false
    var depth: i64 = 0
    var in_sq = false
    var in_dq = false
    var esc = false
    var i: i64 = 0
    while i < n:
        val ch = expr.substring(i, i + 1)
        if esc:
            esc = false
        elif ch == "\\" and (in_sq or in_dq):
            esc = true
        elif ch == "'" and not in_dq:
            in_sq = not in_sq
        elif ch == "\"" and not in_sq:
            in_dq = not in_dq
        elif not in_sq and not in_dq:
            if ch == "(": depth = depth + 1
            elif ch == ")":
                depth = depth - 1
                if depth == 0 and i < n - 1:
                    return false
        i = i + 1
    depth == 0

fn _ss_is_quoted_literal(expr: text) -> bool:
    val n = expr.byte_len()
    if n < 2:
        return false
    val q = expr.substring(0, 1)
    if (q != "\"" and q != "'") or expr.substring(n - 1, n) != q:
        return false
    var esc = false
    var i: i64 = 1
    while i < n - 1:
        val ch = expr.substring(i, i + 1)
        if esc:
            esc = false
        elif ch == "\\":
            esc = true
        elif ch == q:
            return false
        i = i + 1
    not esc

fn _ss_split_postfix(expr: text) -> (text, text, text):
    # Returns (recv, kind, payload) where kind is "call" | "prop" | "index" | ""
    val n = expr.byte_len()
    if n == 0:
        return ("", "", "")
    val last = expr.substring(n - 1, n)
    if last == ")":
        # Match opening '('
        var depth: i64 = 0
        var in_sq = false
        var in_dq = false
        var esc = false
        var i: i64 = n - 1
        while i >= 0:
            val ch = expr.substring(i, i + 1)
            if ch == "'" and not in_dq:
                in_sq = not in_sq
            elif ch == "\"" and not in_sq:
                in_dq = not in_dq
            elif not in_sq and not in_dq:
                if ch == ")": depth = depth + 1
                elif ch == "(":
                    depth = depth - 1
                    if depth == 0:
                        return (expr.substring(0, i).trim(), "call", expr.substring(i + 1, n - 1))
            i = i - 1
    if last == "]":
        var depth: i64 = 0
        var in_sq = false
        var in_dq = false
        var i: i64 = n - 1
        while i >= 0:
            val ch = expr.substring(i, i + 1)
            if ch == "'" and not in_dq:
                in_sq = not in_sq
            elif ch == "\"" and not in_sq:
                in_dq = not in_dq
            elif not in_sq and not in_dq:
                if ch == "]": depth = depth + 1
                elif ch == "[":
                    depth = depth - 1
                    if depth == 0:
                        if i == 0:
                            return ("", "", "")
                        return (expr.substring(0, i).trim(), "index", expr.substring(i + 1, n - 1))
            i = i - 1
    val dot = _ss_find_top_level_char(expr, ".", true)
    if dot > 0:
        val prop = expr.substring(dot + 1, n).trim()
        val recv = expr.substring(0, dot).trim()
        # Distinguish decimal float literal like 3.14
        var only_digits = true
        var ri: i64 = 0
        while ri < recv.byte_len():
            if not _ss_is_digit(recv.substring(ri, ri + 1)):
                only_digits = false
                break
            ri = ri + 1
        if only_digits and prop.byte_len() > 0 and _ss_is_digit(prop.substring(0, 1)):
            return ("", "", "")
        return (recv, "prop", prop)
    ("", "", "")

pub fn simple_script_security_check(source: text) -> text:
    val lo = source.lower()
    if lo.contains("rt_process_run") or lo.contains("host.shell") or lo.contains("shell("):
        return "host shell access denied"
    if lo.contains("stdout_write") or lo.contains("stderr_write"):
        return "host io access denied"
    if lo.contains("file_read") or lo.contains("file_write") or lo.contains("rt_file_") or lo.contains("fs."):
        return "filesystem access denied"
    if lo.contains("rt_env_") or lo.contains("process.env"):
        return "ambient environment access denied"
    if lo.contains("require(") or lo.contains("child_process"):
        return "module loader access denied"
    if lo.contains("fetch(") or lo.contains("xmlhttprequest") or lo.contains("websocket"):
        return "network access denied"
    ""

# reason: predicate over single SimpleScript source line matching BrowserSession script dispatch
# @allow(primitive_api)
pub fn simple_script_is_dom_statement(line: text) -> bool:
    val t = line.trim()
    if t == "" or t.starts_with("#"):
        return false
    if (t.starts_with("val ") or t.starts_with("var ") or t.starts_with("fn ") or
        t.starts_with("if ") or t.starts_with("elif ") or t == "else:" or
        t.starts_with("while ") or t.starts_with("for ") or
        t == "return" or t.starts_with("return ") or t == "pass" or
        t.starts_with("document.") or t.starts_with("window.") or
        t.starts_with("console.") or t.starts_with("console_log(") or
        t.starts_with("print(")):
        return true
    val eq_pos = _ss_find_top_level_char(t, "=", false)
    if eq_pos > 0:
        val lhs = t.substring(0, eq_pos).trim()
        if not lhs.contains(" "):
            return true
    val paren_pos = _ss_find_top_level_char(t, "(", false)
    if paren_pos > 0:
        val callee = t.substring(0, paren_pos).trim()
        if not callee.contains(" "):
            return true
    false

# reason: predicate over SimpleScript source block matching BrowserSession script dispatch
# @allow(primitive_api)
pub fn simple_script_source_uses_dom(source: text) -> bool:
    for raw in source.split("\n"):
        val t = _ss_strip_inline_comment(raw).trim()
        if t == "" or t.starts_with("#"):
            continue
        if simple_script_is_dom_statement(t):
            return true
    false

# reason: in-process constrained Simple DOM VM matching BeDomEvent pixel coordinates and dirty/prevented flags
# @allow(primitive_api)
pub class SimpleScriptDomVm:
    dom: BeDomNode
    dom_dirty: bool
    structural_dirty: bool
    title: text
    title_dirty: bool
    console: ConsoleBuffer
    logs: [text]
    var_names: [text]
    var_values: [SimpleScriptVal]
    fns: [SimpleScriptFn]
    listeners: [SimpleScriptDomListener]
    staged_nodes: [BeDomNode]
    data_transfer_keys: [text]
    data_transfer_vals: [text]
    event_prevent_default: bool
    event_stop_prop: bool
    event_stop_imm_prop: bool
    current_event_type: text
    current_target_id: i64
    current_current_target_id: i64
    current_client_x: i32
    current_client_y: i32
    current_offset_x: i32
    current_offset_y: i32
    current_key: text
    current_code: text
    current_data: text
    current_delta_x: f64
    current_delta_y: f64
    current_delta_mode: i32
    scroll_x: i64
    scroll_y: i64
    next_alloc_id: i64
    error: text

impl SimpleScriptDomVm:
    static fn new(console: ConsoleBuffer) -> SimpleScriptDomVm:
        SimpleScriptDomVm(
            dom: BeDomNode.element("div"),
            dom_dirty: false,
            structural_dirty: false,
            title: "",
            title_dirty: false,
            console: console,
            logs: [],
            var_names: [],
            var_values: [],
            fns: [],
            listeners: [],
            staged_nodes: [],
            data_transfer_keys: [],
            data_transfer_vals: [],
            event_prevent_default: false,
            event_stop_prop: false,
            event_stop_imm_prop: false,
            current_event_type: "",
            current_target_id: -1,
            current_current_target_id: -1,
            current_client_x: 0,
            current_client_y: 0,
            current_offset_x: 0,
            current_offset_y: 0,
            current_key: "",
            current_code: "",
            current_data: "",
            current_delta_x: 0.0,
            current_delta_y: 0.0,
            current_delta_mode: 0,
            scroll_x: 0,
            scroll_y: 0,
            next_alloc_id: 100000,
            error: ""
        )

    # reason: matches SimpleScriptExecutor.install_document_state document replacement flag
    # @allow(primitive_api)
    me install_document(dom_root: BeDomNode, replaces_document: bool):
        self.dom = dom_root
        val m = _ss_max_node_id(dom_root) + 1
        if m > self.next_alloc_id:
            self.next_alloc_id = m
        self.dom_dirty = false
        self.structural_dirty = false
        if replaces_document:
            self.title = ""
            self.title_dirty = false
            self.var_names = []
            self.var_values = []
            self.fns = []
            self.listeners = []
            self.staged_nodes = []
            self.data_transfer_keys = []
            self.data_transfer_vals = []
            self.logs = []
            self.scroll_x = 0
            self.scroll_y = 0
            self.error = ""

    me _log(msg: text):
        self.logs.push(msg)
        self.console.append("log", msg, 0)

    me _get_var(frame: SimpleScriptExecFrame, name: text) -> SimpleScriptVal?:
        var i = frame.names.len() - 1
        while i >= 0:
            if frame.names[i] == name:
                return Some(frame.values[i])
            i = i - 1
        var g = self.var_names.len() - 1
        while g >= 0:
            if self.var_names[g] == name:
                return Some(self.var_values[g])
            g = g - 1
        None

    me _set_var(mut frame: SimpleScriptExecFrame, name: text, value: SimpleScriptVal, declare_local: bool):
        if declare_local and not frame.is_top_level:
            var i: i64 = 0
            while i < frame.names.len():
                if frame.names[i] == name:
                    frame.values[i] = value
                    return
                i = i + 1
            frame.names.push(name)
            frame.values.push(value)
            return
        if not frame.is_top_level:
            var li = frame.names.len() - 1
            while li >= 0:
                if frame.names[li] == name:
                    frame.values[li] = value
                    return
                li = li - 1
        var gi = self.var_names.len() - 1
        while gi >= 0:
            if self.var_names[gi] == name:
                self.var_values[gi] = value
                return
            gi = gi - 1
        self.var_names.push(name)
        self.var_values.push(value)

    fn _find_node(node_id: i64) -> BeDomNode?:
        if node_id < 0:
            return None
        if val Some(live) = be_dom_find_by_node_id(self.dom, node_id):
            return Some(live)
        for staged in self.staged_nodes:
            if val Some(found) = be_dom_find_by_node_id(staged, node_id):
                return Some(found)
        None

    me _commit_node(node: BeDomNode):
        if be_dom_find_by_node_id(self.dom, node.node_id).is_some():
            self.dom = _ss_replace_node_by_id(self.dom, node)
            self.dom_dirty = true
            return
        var i: i64 = 0
        while i < self.staged_nodes.len():
            if be_dom_find_by_node_id(self.staged_nodes[i], node.node_id).is_some():
                self.staged_nodes[i] = _ss_replace_node_by_id(self.staged_nodes[i], node)
                return
            i = i + 1

    me _remove_staged_root(node_id: i64):
        var kept: [BeDomNode] = []
        for s in self.staged_nodes:
            if s.node_id != node_id:
                kept.push(s)
        self.staged_nodes = kept

    me _alloc_id() -> i64:
        val id = self.next_alloc_id
        self.next_alloc_id = self.next_alloc_id + 1
        id

    me _set_element_text(node_id: i64, content: text):
        if val Some(node) = self._find_node(node_id):
            var next = node
            if next.tag_name == "#text":
                next.data = content
            elif next.tag_name == "textarea":
                if content == "":
                    next.children = []
                else:
                    next.children = [BeDomNode.text_node(self._alloc_id(), content)]
            else:
                if content == "":
                    next.children = []
                else:
                    next.children = [BeDomNode.text_node(self._alloc_id(), content)]
            self._commit_node(next)

    me _set_element_inner_html(node_id: i64, html_frag: text):
        if val Some(node) = self._find_node(node_id):
            val parsed = html_tree_builder_build("<html><body>" + html_frag + "</body></html>")
            val bodies = be_dom_find_by_tag(parsed, "body")
            var children: [BeDomNode] = []
            if bodies.len() > 0:
                var nid = self.next_alloc_id
                for child in bodies[0].children:
                    val assigned = _ss_assign_ids(child, node.node_id, nid)
                    children.push(assigned.0)
                    nid = assigned.1
                self.next_alloc_id = nid
            val updated = be_dom_set_children(node, children)
            self._commit_node(updated)
            self.structural_dirty = true

    me _append_child(parent_id: i64, child_id: i64) -> SimpleScriptVal:
        if val Some(parent) = self._find_node(parent_id):
            if val Some(child) = self._find_node(child_id):
                # Detach from previous live parent if any
                val old_parent_id = _ss_find_parent_id(self.dom, child_id)
                if old_parent_id >= 0:
                    if val Some(old_parent) = self._find_node(old_parent_id):
                        var kept: [BeDomNode] = []
                        for c in old_parent.children:
                            if c.node_id != child_id:
                                kept.push(c)
                        self._commit_node(be_dom_set_children(old_parent, kept))
                self._remove_staged_root(child_id)
                if val Some(fresh_parent) = self._find_node(parent_id):
                    var updated_child = child
                    updated_child.parent_id = parent_id
                    var next_children = fresh_parent.children
                    next_children.push(updated_child)
                    self._commit_node(be_dom_set_children(fresh_parent, next_children))
                    self.structural_dirty = true
                    return SimpleScriptVal.dom(child_id)
        SimpleScriptVal.none()

    me _insert_before(parent_id: i64, child_id: i64, ref_id: i64) -> SimpleScriptVal:
        if ref_id < 0:
            return self._append_child(parent_id, child_id)
        if val Some(parent) = self._find_node(parent_id):
            if val Some(child) = self._find_node(child_id):
                val old_parent_id = _ss_find_parent_id(self.dom, child_id)
                if old_parent_id >= 0:
                    if val Some(old_parent) = self._find_node(old_parent_id):
                        var kept: [BeDomNode] = []
                        for c in old_parent.children:
                            if c.node_id != child_id:
                                kept.push(c)
                        self._commit_node(be_dom_set_children(old_parent, kept))
                self._remove_staged_root(child_id)
                if val Some(fresh_parent) = self._find_node(parent_id):
                    var updated_child = child
                    updated_child.parent_id = parent_id
                    var next_children: [BeDomNode] = []
                    var inserted = false
                    for c in fresh_parent.children:
                        if c.node_id == ref_id and not inserted:
                            next_children.push(updated_child)
                            inserted = true
                        next_children.push(c)
                    if not inserted:
                        next_children.push(updated_child)
                    self._commit_node(be_dom_set_children(fresh_parent, next_children))
                    self.structural_dirty = true
                    return SimpleScriptVal.dom(child_id)
        SimpleScriptVal.none()

    me _remove_child(parent_id: i64, child_id: i64) -> SimpleScriptVal:
        if val Some(parent) = self._find_node(parent_id):
            var kept: [BeDomNode] = []
            for c in parent.children:
                if c.node_id != child_id:
                    kept.push(c)
            self._commit_node(be_dom_set_children(parent, kept))
            self.structural_dirty = true
            return SimpleScriptVal.dom(child_id)
        SimpleScriptVal.none()

    me _eval_string_literal(raw: text, mut frame: SimpleScriptExecFrame, depth: i64) -> text:
        val q = raw.substring(0, 1)
        val inner = raw.substring(1, raw.byte_len() - 1)
        var out = ""
        var i: i64 = 0
        val n = inner.byte_len()
        while i < n:
            val ch = inner.substring(i, i + 1)
            if ch == "\\" and i + 1 < n:
                val next_ch = inner.substring(i + 1, i + 2)
                if next_ch == "n": out = out + "\n"
                elif next_ch == "t": out = out + "\t"
                elif next_ch == "r": out = out + "\r"
                else: out = out + next_ch
                i = i + 2
                continue
            if q == "\"" and ch == "{":
                var depth_c: i64 = 1
                var j: i64 = i + 1
                while j < n and depth_c > 0:
                    val c2 = inner.substring(j, j + 1)
                    if c2 == "{": depth_c = depth_c + 1
                    elif c2 == "}": depth_c = depth_c - 1
                    j = j + 1
                if depth_c == 0:
                    val sub_expr = inner.substring(i + 1, j - 1)
                    val v = self._eval_expr(sub_expr, frame, depth + 1)
                    out = out + v.as_text()
                    i = j
                    continue
            out = out + ch
            i = i + 1
        out

    me _call_user_fn(fn_name: text, args: [SimpleScriptVal], depth: i64) -> SimpleScriptVal:
        if depth > SIMPLE_SCRIPT_VM_MAX_DEPTH:
            return SimpleScriptVal.none()
        for f in self.fns:
            if f.name == fn_name:
                var sub = SimpleScriptExecFrame(returned: false, ret_val: SimpleScriptVal.none(), names: [], values: [], is_top_level: false)
                var pi: i64 = 0
                while pi < f.params.len():
                    val arg = if pi < args.len(): args[pi] else: SimpleScriptVal.none()
                    sub.names.push(f.params[pi])
                    sub.values.push(arg)
                    pi = pi + 1
                self._exec_block(f.body_lines, f.body_indents, 0, f.body_lines.len(), sub, depth + 1)
                return sub.ret_val
        SimpleScriptVal.none()

    me _eval_call(recv: SimpleScriptVal, method: text, arg_exprs: [text], mut frame: SimpleScriptExecFrame, depth: i64) -> SimpleScriptVal:
        var args: [SimpleScriptVal] = []
        for ae in arg_exprs:
            args.push(self._eval_expr(ae, frame, depth + 1))

        if recv.kind == "global_document":
            if method == "getElementById" and args.len() >= 1:
                if val Some(found) = be_dom_find_by_id(self.dom, args[0].as_text()):
                    return SimpleScriptVal.dom(found.node_id)
                return SimpleScriptVal.none()
            if method == "querySelector" and args.len() >= 1:
                val list = be_dom_query_selector_all(self.dom, args[0].as_text())
                if list.len() > 0:
                    return SimpleScriptVal.dom(list[0].node_id)
                return SimpleScriptVal.none()
            if method == "querySelectorAll" and args.len() >= 1:
                val list = be_dom_query_selector_all(self.dom, args[0].as_text())
                var out: [SimpleScriptVal] = []
                for item in list:
                    out.push(SimpleScriptVal.dom(item.node_id))
                return SimpleScriptVal.from_list(out)
            if method == "createElement" and args.len() >= 1:
                val nid = self._alloc_id()
                val created = BeDomNode.element_with_id(nid, args[0].as_text().lower())
                self.staged_nodes.push(created)
                return SimpleScriptVal.dom(nid)
            if method == "createTextNode" and args.len() >= 1:
                val nid = self._alloc_id()
                val created = BeDomNode.text_node(nid, args[0].as_text())
                self.staged_nodes.push(created)
                return SimpleScriptVal.dom(nid)
            if method == "addEventListener" and args.len() >= 2:
                val ev_type = args[0].as_text().trim().lower()
                val cb_name = if args[1].kind == "fn": args[1].text_val else: arg_exprs[1].trim()
                val capture = if args.len() >= 3: args[2].is_truthy() else: false
                self.listeners.push(SimpleScriptDomListener(
                    node_id: -1,
                    event_type: ev_type,
                    fn_name: cb_name,
                    inline_params: [],
                    inline_lines: [],
                    inline_indents: [],
                    capture: capture,
                    once: false
                ))
                return SimpleScriptVal.none()
            return SimpleScriptVal.none()

        if recv.kind == "global_window":
            if method == "addEventListener" and args.len() >= 2:
                val ev_type = args[0].as_text().trim().lower()
                val cb_name = if args[1].kind == "fn": args[1].text_val else: arg_exprs[1].trim()
                val capture = if args.len() >= 3: args[2].is_truthy() else: false
                self.listeners.push(SimpleScriptDomListener(
                    node_id: -2,
                    event_type: ev_type,
                    fn_name: cb_name,
                    inline_params: [],
                    inline_lines: [],
                    inline_indents: [],
                    capture: capture,
                    once: false
                ))
                return SimpleScriptVal.none()
            if method == "scrollTo" and args.len() >= 2:
                val nx = args[0].as_int()
                val ny = args[1].as_int()
                self.scroll_x = if nx < 0: 0 else: nx
                self.scroll_y = if ny < 0: 0 else: ny
                return SimpleScriptVal.none()
            if method == "scrollBy" and args.len() >= 2:
                val nx = self.scroll_x + args[0].as_int()
                val ny = self.scroll_y + args[1].as_int()
                self.scroll_x = if nx < 0: 0 else: nx
                self.scroll_y = if ny < 0: 0 else: ny
                return SimpleScriptVal.none()
            return SimpleScriptVal.none()

        if recv.kind == "global_console":
            if method == "log" or method == "warn" or method == "error" or method == "info":
                var parts: [text] = []
                for a in args:
                    parts.push(a.as_text())
                self._log(parts.join(" "))
            return SimpleScriptVal.none()

        if recv.kind == "global_math":
            if method == "round" and args.len() >= 1:
                val f = args[0].as_float()
                val r = if f >= 0.0: (f + 0.5).to_i64() else: (f - 0.5).to_i64()
                return SimpleScriptVal.from_int(r)
            if method == "floor" and args.len() >= 1:
                return SimpleScriptVal.from_int(args[0].as_float().to_i64())
            if method == "ceil" and args.len() >= 1:
                val f = args[0].as_float()
                val i = f.to_i64()
                return SimpleScriptVal.from_int(if f > i.to_f64(): i + 1 else: i)
            if method == "abs" and args.len() >= 1:
                val f = args[0].as_float()
                return SimpleScriptVal.from_float(if f < 0.0: -f else: f)
            if method == "min" and args.len() >= 2:
                val a = args[0].as_float()
                val b = args[1].as_float()
                return SimpleScriptVal.from_float(if a < b: a else: b)
            if method == "max" and args.len() >= 2:
                val a = args[0].as_float()
                val b = args[1].as_float()
                return SimpleScriptVal.from_float(if a > b: a else: b)
            return SimpleScriptVal.none()

        if recv.kind == "dom":
            val nid = recv.node_id
            if method == "getAttribute" and args.len() >= 1:
                if val Some(n) = self._find_node(nid):
                    val key = args[0].as_text()
                    if be_dom_has_attr(n, key):
                        return SimpleScriptVal.from_text(be_dom_get_attr(n, key))
                return SimpleScriptVal.none()
            if method == "hasAttribute" and args.len() >= 1:
                if val Some(n) = self._find_node(nid):
                    return SimpleScriptVal.from_bool(be_dom_has_attr(n, args[0].as_text()))
                return SimpleScriptVal.from_bool(false)
            if method == "setAttribute" and args.len() >= 2:
                if val Some(n) = self._find_node(nid):
                    var next = n
                    next.set_attr(args[0].as_text(), args[1].as_text())
                    self._commit_node(next)
                return SimpleScriptVal.none()
            if method == "removeAttribute" and args.len() >= 1:
                if val Some(n) = self._find_node(nid):
                    var next = n
                    next.remove_attr(args[0].as_text())
                    self._commit_node(next)
                return SimpleScriptVal.none()
            if method == "appendChild" and args.len() >= 1:
                return self._append_child(nid, args[0].node_id)
            if method == "insertBefore" and args.len() >= 2:
                return self._insert_before(nid, args[0].node_id, args[1].node_id)
            if method == "removeChild" and args.len() >= 1:
                return self._remove_child(nid, args[0].node_id)
            if method == "querySelector" and args.len() >= 1:
                if val Some(n) = self._find_node(nid):
                    val list = be_dom_query_selector_all(n, args[0].as_text())
                    if list.len() > 0:
                        return SimpleScriptVal.dom(list[0].node_id)
                return SimpleScriptVal.none()
            if method == "querySelectorAll" and args.len() >= 1:
                if val Some(n) = self._find_node(nid):
                    val list = be_dom_query_selector_all(n, args[0].as_text())
                    var out: [SimpleScriptVal] = []
                    for item in list:
                        out.push(SimpleScriptVal.dom(item.node_id))
                    return SimpleScriptVal.from_list(out)
                return SimpleScriptVal.from_list([])
            if method == "addEventListener" and args.len() >= 2:
                val ev_type = args[0].as_text().trim().lower()
                val cb_name = if args[1].kind == "fn": args[1].text_val else: arg_exprs[1].trim()
                val capture = if args.len() >= 3: args[2].is_truthy() else: false
                self.listeners.push(SimpleScriptDomListener(
                    node_id: nid,
                    event_type: ev_type,
                    fn_name: cb_name,
                    inline_params: [],
                    inline_lines: [],
                    inline_indents: [],
                    capture: capture,
                    once: false
                ))
                return SimpleScriptVal.none()
            if method == "focus":
                if val Some(n) = self._find_node(nid):
                    var next = n
                    next.set_attr("data-focused", "true")
                    self._commit_node(next)
                return SimpleScriptVal.none()
            if method == "scrollTo" and args.len() >= 2:
                if val Some(n) = self._find_node(nid):
                    val nx = args[0].as_int()
                    val ny = args[1].as_int()
                    val cx = if nx < 0: 0 else: nx
                    var cy = if ny < 0: 0 else: ny
                    val max_st = self._max_scroll_top(n)
                    if max_st >= 0 and cy > max_st: cy = max_st
                    var next = n
                    next.set_attr("data-scroll-left", "{cx}")
                    next.set_attr("data-scroll-top", "{cy}")
                    self._commit_node(next)
                return SimpleScriptVal.none()
            if method == "scrollBy" and args.len() >= 2:
                if val Some(n) = self._find_node(nid):
                    val cur_x = (be_dom_get_attr(n, "data-scroll-left").trim().parse_i64()) ?? 0
                    val cur_y = (be_dom_get_attr(n, "data-scroll-top").trim().parse_i64()) ?? 0
                    val nx = cur_x + args[0].as_int()
                    var cy = cur_y + args[1].as_int()
                    val cx = if nx < 0: 0 else: nx
                    if cy < 0: cy = 0
                    val max_st = self._max_scroll_top(n)
                    if max_st >= 0 and cy > max_st: cy = max_st
                    var next = n
                    next.set_attr("data-scroll-left", "{cx}")
                    next.set_attr("data-scroll-top", "{cy}")
                    self._commit_node(next)
                return SimpleScriptVal.none()
            return SimpleScriptVal.none()

        if recv.kind == "classlist":
            if val Some(n) = self._find_node(recv.node_id):
                val raw = be_dom_get_attr(n, "class").trim()
                var cls_list: [text] = []
                if raw != "":
                    for part in raw.split(" "):
                        val p = part.trim()
                        if p != "":
                            cls_list.push(p)
                if method == "contains" and args.len() >= 1:
                    val target = args[0].as_text()
                    for c in cls_list:
                        if c == target:
                            return SimpleScriptVal.from_bool(true)
                    return SimpleScriptVal.from_bool(false)
                if method == "add" and args.len() >= 1:
                    for a in args:
                        val target = a.as_text().trim()
                        if target != "":
                            var exists = false
                            for c in cls_list:
                                if c == target: exists = true
                            if not exists:
                                cls_list.push(target)
                    var next = n
                    val joined = cls_list.join(" ")
                    if joined == "": next.remove_attr("class") else: next.set_attr("class", joined)
                    self._commit_node(next)
                    return SimpleScriptVal.none()
                if method == "remove" and args.len() >= 1:
                    var kept: [text] = []
                    for c in cls_list:
                        var rm = false
                        for a in args:
                            if c == a.as_text(): rm = true
                        if not rm:
                            kept.push(c)
                    var next = n
                    val joined = kept.join(" ")
                    if joined == "": next.remove_attr("class") else: next.set_attr("class", joined)
                    self._commit_node(next)
                    return SimpleScriptVal.none()
                if method == "toggle" and args.len() >= 1:
                    val target = args[0].as_text().trim()
                    var exists = false
                    var kept: [text] = []
                    for c in cls_list:
                        if c == target:
                            exists = true
                        else:
                            kept.push(c)
                    var added = false
                    if not exists and target != "":
                        kept.push(target)
                        added = true
                    var next = n
                    val joined = kept.join(" ")
                    if joined == "": next.remove_attr("class") else: next.set_attr("class", joined)
                    self._commit_node(next)
                    return SimpleScriptVal.from_bool(added)
            return SimpleScriptVal.none()

        if recv.kind == "style":
            if val Some(n) = self._find_node(recv.node_id):
                val cur_style = be_dom_get_attr(n, "style")
                if method == "setProperty" and args.len() >= 2:
                    var next = n
                    val updated = _ss_style_set(cur_style, args[0].as_text(), args[1].as_text())
                    if updated == "": next.remove_attr("style") else: next.set_attr("style", updated)
                    self._commit_node(next)
                    return SimpleScriptVal.none()
                if method == "getPropertyValue" and args.len() >= 1:
                    return SimpleScriptVal.from_text(_ss_style_get(cur_style, args[0].as_text()))
                if method == "removeProperty" and args.len() >= 1:
                    val old = _ss_style_get(cur_style, args[0].as_text())
                    var next = n
                    val updated = _ss_style_set(cur_style, args[0].as_text(), "")
                    if updated == "": next.remove_attr("style") else: next.set_attr("style", updated)
                    self._commit_node(next)
                    return SimpleScriptVal.from_text(old)
            return SimpleScriptVal.none()

        if recv.kind == "event":
            if method == "preventDefault":
                self.event_prevent_default = true
            elif method == "stopPropagation":
                self.event_stop_prop = true
            elif method == "stopImmediatePropagation":
                self.event_stop_imm_prop = true
                self.event_stop_prop = true
            return SimpleScriptVal.none()

        if recv.kind == "datatransfer":
            if method == "setData" and args.len() >= 2:
                val key = args[0].as_text()
                val val_txt = args[1].as_text()
                var i: i64 = 0
                var updated = false
                while i < self.data_transfer_keys.len():
                    if self.data_transfer_keys[i] == key:
                        self.data_transfer_vals[i] = val_txt
                        updated = true
                    i = i + 1
                if not updated:
                    self.data_transfer_keys.push(key)
                    self.data_transfer_vals.push(val_txt)
            elif method == "getData" and args.len() >= 1:
                val key = args[0].as_text()
                var i: i64 = 0
                while i < self.data_transfer_keys.len():
                    if self.data_transfer_keys[i] == key:
                        return SimpleScriptVal.from_text(self.data_transfer_vals[i])
                    i = i + 1
                return SimpleScriptVal.from_text("")
            elif method == "clearData":
                self.data_transfer_keys = []
                self.data_transfer_vals = []
            return SimpleScriptVal.none()

        if recv.kind == "text":
            val s = recv.text_val
            if method == "len" or method == "length": return SimpleScriptVal.from_int(s.len().to_i64())
            if method == "trim": return SimpleScriptVal.from_text(s.trim())
            if method == "lower" or method == "toLowerCase": return SimpleScriptVal.from_text(s.lower())
            if method == "upper" or method == "toUpperCase": return SimpleScriptVal.from_text(s.upper())
            if method == "contains" and args.len() >= 1: return SimpleScriptVal.from_bool(s.contains(args[0].as_text()))
            if method == "starts_with" and args.len() >= 1: return SimpleScriptVal.from_bool(s.starts_with(args[0].as_text()))
            if method == "ends_with" and args.len() >= 1: return SimpleScriptVal.from_bool(s.ends_with(args[0].as_text()))
            if method == "replace" and args.len() >= 2: return SimpleScriptVal.from_text(s.replace(args[0].as_text(), args[1].as_text()))
            if method == "to_i64" or method == "to_int": return SimpleScriptVal.from_int(s.trim().parse_i64() ?? 0)
            return SimpleScriptVal.none()

        if recv.kind == "int" or recv.kind == "float":
            if method == "to_text": return SimpleScriptVal.from_text(recv.as_text())
            if method == "to_i64" or method == "to_int": return SimpleScriptVal.from_int(recv.as_int())
            return SimpleScriptVal.none()

        if recv.kind == "list":
            if method == "len" or method == "length":
                return SimpleScriptVal.from_int(recv.items.len().to_i64())
            return SimpleScriptVal.none()

        SimpleScriptVal.none()

    fn _max_scroll_top(n: BeDomNode) -> i64:
        val sh = (be_dom_get_attr(n, "data-scroll-height").trim().parse_i64()) ?? -1
        val ch = (be_dom_get_attr(n, "data-client-height").trim().parse_i64()) ?? -1
        if sh >= 0 and ch >= 0:
            val m = sh - ch
            return if m > 0: m else: 0
        -1

    me _get_prop(recv: SimpleScriptVal, prop: text) -> SimpleScriptVal:
        if recv.kind == "global_window":
            if prop == "scrollX" or prop == "pageXOffset":
                return SimpleScriptVal.from_int(self.scroll_x)
            if prop == "scrollY" or prop == "pageYOffset":
                return SimpleScriptVal.from_int(self.scroll_y)
            if prop == "document":
                return SimpleScriptVal.obj("global_document", -1)
            return SimpleScriptVal.none()

        if recv.kind == "global_document":
            if prop == "title":
                return SimpleScriptVal.from_text(self.title)
            if prop == "body":
                val bodies = be_dom_find_by_tag(self.dom, "body")
                if bodies.len() > 0:
                    return SimpleScriptVal.dom(bodies[0].node_id)
                return SimpleScriptVal.none()
            return SimpleScriptVal.none()

        if recv.kind == "dom":
            if val Some(n) = self._find_node(recv.node_id):
                if prop == "id": return SimpleScriptVal.from_text(be_dom_get_attr(n, "id"))
                if prop == "tagName" or prop == "nodeName": return SimpleScriptVal.from_text(n.tag_name.upper())
                if prop == "className": return SimpleScriptVal.from_text(be_dom_get_attr(n, "class"))
                if prop == "value":
                    if n.tag_name == "select":
                        return SimpleScriptVal.from_text(browser_select_value(n))
                    if n.tag_name == "textarea":
                        return SimpleScriptVal.from_text(be_dom_get_text_content(n))
                    return SimpleScriptVal.from_text(be_dom_get_attr(n, "value"))
                if prop == "checked": return SimpleScriptVal.from_bool(be_dom_has_attr(n, "checked"))
                if prop == "disabled": return SimpleScriptVal.from_bool(be_dom_has_attr(n, "disabled"))
                if prop == "selected": return SimpleScriptVal.from_bool(be_dom_has_attr(n, "selected"))
                if prop == "selectedIndex": return SimpleScriptVal.from_int(_ss_select_index(n))
                if prop == "scrollTop":
                    val raw_st = be_dom_get_attr(n, "data-scroll-top").trim()
                    return SimpleScriptVal.from_int(raw_st.parse_i64() ?? 0)
                if prop == "scrollLeft":
                    val raw_sl = be_dom_get_attr(n, "data-scroll-left").trim()
                    return SimpleScriptVal.from_int(raw_sl.parse_i64() ?? 0)
                if prop == "scrollHeight":
                    val raw_sh = be_dom_get_attr(n, "data-scroll-height").trim()
                    return SimpleScriptVal.from_int(raw_sh.parse_i64() ?? 0)
                if prop == "clientHeight":
                    val raw_ch = be_dom_get_attr(n, "data-client-height").trim()
                    return SimpleScriptVal.from_int(raw_ch.parse_i64() ?? 0)
                if prop == "textContent" or prop == "innerText": return SimpleScriptVal.from_text(be_dom_get_text_content(n))
                if prop == "innerHTML": return SimpleScriptVal.from_text(be_dom_serialize_children(n))
                if prop == "style": return SimpleScriptVal.obj("style", n.node_id)
                if prop == "classList": return SimpleScriptVal.obj("classlist", n.node_id)
                if prop == "parentNode":
                    val pid = _ss_find_parent_id(self.dom, n.node_id)
                    return SimpleScriptVal.dom(pid)
                if prop == "children" or prop == "childNodes":
                    var items: [SimpleScriptVal] = []
                    for c in n.children:
                        if prop == "childNodes" or c.tag_name != "#text":
                            items.push(SimpleScriptVal.dom(c.node_id))
                    return SimpleScriptVal.from_list(items)
            return SimpleScriptVal.none()

        if recv.kind == "style":
            if val Some(n) = self._find_node(recv.node_id):
                val raw = be_dom_get_attr(n, "style")
                if prop == "cssText":
                    return SimpleScriptVal.from_text(raw)
                return SimpleScriptVal.from_text(_ss_style_get(raw, prop))
            return SimpleScriptVal.from_text("")

        if recv.kind == "event":
            if prop == "type": return SimpleScriptVal.from_text(self.current_event_type)
            if prop == "target": return SimpleScriptVal.dom(self.current_target_id)
            if prop == "currentTarget": return SimpleScriptVal.dom(self.current_current_target_id)
            if prop == "clientX" or prop == "pageX" or prop == "screenX": return SimpleScriptVal.from_int(self.current_client_x.to_i64())
            if prop == "clientY" or prop == "pageY" or prop == "screenY": return SimpleScriptVal.from_int(self.current_client_y.to_i64())
            if prop == "offsetX": return SimpleScriptVal.from_int(self.current_offset_x.to_i64())
            if prop == "offsetY": return SimpleScriptVal.from_int(self.current_offset_y.to_i64())
            if prop == "key": return SimpleScriptVal.from_text(self.current_key)
            if prop == "code": return SimpleScriptVal.from_text(self.current_code)
            if prop == "data": return SimpleScriptVal.from_text(self.current_data)
            if prop == "deltaX": return SimpleScriptVal.from_float(self.current_delta_x)
            if prop == "deltaY": return SimpleScriptVal.from_float(self.current_delta_y)
            if prop == "deltaMode": return SimpleScriptVal.from_int(self.current_delta_mode.to_i64())
            if prop == "defaultPrevented": return SimpleScriptVal.from_bool(self.event_prevent_default)
            if prop == "dataTransfer": return SimpleScriptVal.obj("datatransfer", -1)
            return SimpleScriptVal.none()

        if recv.kind == "text" and (prop == "len" or prop == "length"):
            return SimpleScriptVal.from_int(recv.text_val.len().to_i64())
        if recv.kind == "list" and (prop == "len" or prop == "length"):
            return SimpleScriptVal.from_int(recv.items.len().to_i64())
        SimpleScriptVal.none()

    me _set_prop(recv: SimpleScriptVal, prop: text, value: SimpleScriptVal):
        if recv.kind == "global_document":
            if prop == "title":
                self.title = value.as_text()
                self.title_dirty = true
            elif prop == "body":
                pass_dn
            return
        if recv.kind == "dom":
            if val Some(n) = self._find_node(recv.node_id):
                if prop == "textContent" or prop == "innerText":
                    self._set_element_text(n.node_id, value.as_text())
                    return
                if prop == "innerHTML":
                    self._set_element_inner_html(n.node_id, value.as_text())
                    return
                if prop == "selectedIndex" and n.tag_name == "select":
                    var next = _ss_select_by_index(n, value.as_int())
                    val next_val = browser_select_value(next)
                    if next_val != "":
                        next.set_attr("value", next_val)
                    self._commit_node(next)
                    return
                if prop == "value" and n.tag_name == "select":
                    val upd = browser_select_update(n, value.as_text())
                    if upd.found:
                        var next_sel = upd.node
                        next_sel.set_attr("value", browser_select_value(next_sel))
                        self._commit_node(next_sel)
                    return
                var next = n
                if prop == "scrollTop":
                    var st = value.as_int()
                    if st < 0: st = 0
                    val max_st = self._max_scroll_top(n)
                    if max_st >= 0 and st > max_st: st = max_st
                    next.set_attr("data-scroll-top", "{st}")
                    self._commit_node(next)
                    return
                if prop == "scrollLeft":
                    var sl = value.as_int()
                    if sl < 0: sl = 0
                    next.set_attr("data-scroll-left", "{sl}")
                    self._commit_node(next)
                    return
                if prop == "id":
                    val s = value.as_text()
                    if s == "": next.remove_attr("id") else: next.set_attr("id", s)
                elif prop == "className":
                    val s = value.as_text()
                    if s == "": next.remove_attr("class") else: next.set_attr("class", s)
                elif prop == "value":
                    if next.tag_name == "textarea":
                        self._set_element_text(n.node_id, value.as_text())
                        return
                    next.set_attr("value", value.as_text())
                elif prop == "checked":
                    if value.is_truthy(): next.set_attr("checked", "checked") else: next.remove_attr("checked")
                elif prop == "disabled":
                    if value.is_truthy(): next.set_attr("disabled", "disabled") else: next.remove_attr("disabled")
                elif prop == "selected":
                    if value.is_truthy(): next.set_attr("selected", "selected") else: next.remove_attr("selected")
                self._commit_node(next)
            return
        if recv.kind == "style":
            if val Some(n) = self._find_node(recv.node_id):
                var next = n
                if prop == "cssText":
                    val s = value.as_text().trim()
                    if s == "": next.remove_attr("style") else: next.set_attr("style", s)
                else:
                    val updated = _ss_style_set(be_dom_get_attr(n, "style"), prop, value.as_text())
                    if updated == "": next.remove_attr("style") else: next.set_attr("style", updated)
                self._commit_node(next)

    me _eval_expr(raw_expr: text, mut frame: SimpleScriptExecFrame, depth: i64) -> SimpleScriptVal:
        if depth > 64:
            return SimpleScriptVal.none()
        var expr = raw_expr.trim()
        while _ss_is_wrapped_parens(expr):
            expr = expr.substring(1, expr.byte_len() - 1).trim()
        if expr == "":
            return SimpleScriptVal.none()

        # Binary operators from lowest to highest precedence
        val or_idx = _ss_find_top_level_op(expr, " or ")
        if or_idx >= 0:
            val lv = self._eval_expr(expr.substring(0, or_idx), frame, depth + 1)
            if lv.is_truthy():
                return SimpleScriptVal.from_bool(true)
            val rv = self._eval_expr(expr.substring(or_idx + 4, expr.byte_len()), frame, depth + 1)
            return SimpleScriptVal.from_bool(rv.is_truthy())

        val and_idx = _ss_find_top_level_op(expr, " and ")
        if and_idx >= 0:
            val lv = self._eval_expr(expr.substring(0, and_idx), frame, depth + 1)
            if not lv.is_truthy():
                return SimpleScriptVal.from_bool(false)
            val rv = self._eval_expr(expr.substring(and_idx + 5, expr.byte_len()), frame, depth + 1)
            return SimpleScriptVal.from_bool(rv.is_truthy())

        val eq_idx = _ss_find_top_level_op(expr, "==")
        val ne_idx = _ss_find_top_level_op(expr, "!=")
        val le_idx = _ss_find_top_level_op(expr, "<=")
        val ge_idx = _ss_find_top_level_op(expr, ">=")
        val lt_idx = _ss_find_top_level_op(expr, "<")
        val gt_idx = _ss_find_top_level_op(expr, ">")
        var cmp_idx: i64 = -1
        var cmp_op = ""
        if eq_idx > cmp_idx: cmp_idx = eq_idx; cmp_op = "=="
        if ne_idx > cmp_idx: cmp_idx = ne_idx; cmp_op = "!="
        if le_idx > cmp_idx: cmp_idx = le_idx; cmp_op = "<="
        if ge_idx > cmp_idx: cmp_idx = ge_idx; cmp_op = ">="
        if lt_idx > cmp_idx and lt_idx != le_idx: cmp_idx = lt_idx; cmp_op = "<"
        if gt_idx > cmp_idx and gt_idx != ge_idx: cmp_idx = gt_idx; cmp_op = ">"
        if cmp_idx >= 0:
            val lv = self._eval_expr(expr.substring(0, cmp_idx), frame, depth + 1)
            val rv = self._eval_expr(expr.substring(cmp_idx + cmp_op.byte_len(), expr.byte_len()), frame, depth + 1)
            if cmp_op == "==":
                if lv.kind == "none" or rv.kind == "none":
                    return SimpleScriptVal.from_bool(lv.kind == rv.kind)
                if lv.kind == "bool" and rv.kind == "bool":
                    return SimpleScriptVal.from_bool(lv.bool_val == rv.bool_val)
                if (lv.kind == "int" or lv.kind == "float") and (rv.kind == "int" or rv.kind == "float"):
                    return SimpleScriptVal.from_bool(lv.as_float() == rv.as_float())
                return SimpleScriptVal.from_bool(lv.as_text() == rv.as_text())
            if cmp_op == "!=":
                if lv.kind == "none" or rv.kind == "none":
                    return SimpleScriptVal.from_bool(lv.kind != rv.kind)
                if (lv.kind == "int" or lv.kind == "float") and (rv.kind == "int" or rv.kind == "float"):
                    return SimpleScriptVal.from_bool(lv.as_float() != rv.as_float())
                return SimpleScriptVal.from_bool(lv.as_text() != rv.as_text())
            if cmp_op == "<": return SimpleScriptVal.from_bool(lv.as_float() < rv.as_float())
            if cmp_op == "<=": return SimpleScriptVal.from_bool(lv.as_float() <= rv.as_float())
            if cmp_op == ">": return SimpleScriptVal.from_bool(lv.as_float() > rv.as_float())
            if cmp_op == ">=": return SimpleScriptVal.from_bool(lv.as_float() >= rv.as_float())

        val add_idx = _ss_find_top_level_op(expr, "+")
        val sub_idx = _ss_find_top_level_op(expr, "-")
        if add_idx > 0 and add_idx > sub_idx:
            val lv = self._eval_expr(expr.substring(0, add_idx), frame, depth + 1)
            val rv = self._eval_expr(expr.substring(add_idx + 1, expr.byte_len()), frame, depth + 1)
            if lv.kind == "text" or rv.kind == "text":
                return SimpleScriptVal.from_text(lv.as_text() + rv.as_text())
            if lv.kind == "float" or rv.kind == "float":
                return SimpleScriptVal.from_float(lv.as_float() + rv.as_float())
            return SimpleScriptVal.from_int(lv.as_int() + rv.as_int())
        if sub_idx > 0 and sub_idx > add_idx:
            val lv = self._eval_expr(expr.substring(0, sub_idx), frame, depth + 1)
            val rv = self._eval_expr(expr.substring(sub_idx + 1, expr.byte_len()), frame, depth + 1)
            if lv.kind == "float" or rv.kind == "float":
                return SimpleScriptVal.from_float(lv.as_float() - rv.as_float())
            return SimpleScriptVal.from_int(lv.as_int() - rv.as_int())

        val mul_idx = _ss_find_top_level_op(expr, "*")
        val div_idx = _ss_find_top_level_op(expr, "/")
        val mod_idx = _ss_find_top_level_op(expr, "%")
        var mul_pos: i64 = -1
        var mul_op = ""
        if mul_idx > mul_pos: mul_pos = mul_idx; mul_op = "*"
        if div_idx > mul_pos: mul_pos = div_idx; mul_op = "/"
        if mod_idx > mul_pos: mul_pos = mod_idx; mul_op = "%"
        if mul_pos > 0:
            val lv = self._eval_expr(expr.substring(0, mul_pos), frame, depth + 1)
            val rv = self._eval_expr(expr.substring(mul_pos + 1, expr.byte_len()), frame, depth + 1)
            if mul_op == "*":
                if lv.kind == "float" or rv.kind == "float":
                    return SimpleScriptVal.from_float(lv.as_float() * rv.as_float())
                return SimpleScriptVal.from_int(lv.as_int() * rv.as_int())
            if mul_op == "/":
                val denom = rv.as_float()
                if denom == 0.0: return SimpleScriptVal.from_int(0)
                if lv.kind == "int" and rv.kind == "int" and rv.as_int() != 0:
                    return SimpleScriptVal.from_int(lv.as_int() / rv.as_int())
                return SimpleScriptVal.from_float(lv.as_float() / denom)
            val m = rv.as_int()
            if m == 0: return SimpleScriptVal.from_int(0)
            return SimpleScriptVal.from_int(lv.as_int() % m)

        # Unary operators
        if expr.starts_with("not "):
            val inner = self._eval_expr(expr.substring(4, expr.byte_len()), frame, depth + 1)
            return SimpleScriptVal.from_bool(not inner.is_truthy())
        if expr.starts_with("!"):
            val inner = self._eval_expr(expr.substring(1, expr.byte_len()), frame, depth + 1)
            return SimpleScriptVal.from_bool(not inner.is_truthy())
        if expr.starts_with("-"):
            val inner = self._eval_expr(expr.substring(1, expr.byte_len()), frame, depth + 1)
            if inner.kind == "float":
                return SimpleScriptVal.from_float(-inner.as_float())
            return SimpleScriptVal.from_int(-inner.as_int())

        # Literals
        if _ss_is_quoted_literal(expr):
            return SimpleScriptVal.from_text(self._eval_string_literal(expr, frame, depth + 1))
        if expr == "true": return SimpleScriptVal.from_bool(true)
        if expr == "false": return SimpleScriptVal.from_bool(false)
        if expr == "nil" or expr == "null" or expr == "undefined": return SimpleScriptVal.none()
        if expr == "document": return SimpleScriptVal.obj("global_document", -1)
        if expr == "window" or expr == "self" or expr == "globalThis": return SimpleScriptVal.obj("global_window", -2)
        if expr == "console": return SimpleScriptVal.obj("global_console", -1)
        if expr == "Math": return SimpleScriptVal.obj("global_math", -1)
        if expr == "event" or expr == "ev": return SimpleScriptVal.obj("event", -1)

        if expr.starts_with("[") and expr.ends_with("]"):
            val inner_list = expr.substring(1, expr.byte_len() - 1).trim()
            var items: [SimpleScriptVal] = []
            for part in _ss_split_top_level_args(inner_list):
                items.push(self._eval_expr(part, frame, depth + 1))
            return SimpleScriptVal.from_list(items)

        # Postfix calls / index / property access
        val postfix = _ss_split_postfix(expr)
        val recv_expr = postfix.0
        val pkind = postfix.1
        val payload = postfix.2
        if pkind == "call":
            val arg_exprs = _ss_split_top_level_args(payload)
            val recv_post = _ss_split_postfix(recv_expr)
            if recv_post.1 == "prop":
                val obj = self._eval_expr(recv_post.0, frame, depth + 1)
                return self._eval_call(obj, recv_post.2, arg_exprs, frame, depth + 1)
            # Standalone global function call
            var args: [SimpleScriptVal] = []
            for ae in arg_exprs:
                args.push(self._eval_expr(ae, frame, depth + 1))
            if recv_expr == "console_log" or recv_expr == "print":
                var parts: [text] = []
                for a in args:
                    parts.push(a.as_text())
                self._log(parts.join(" "))
                return SimpleScriptVal.none()
            if recv_expr == "clamp" and args.len() >= 3:
                val v = args[0].as_float()
                val lo = args[1].as_float()
                val hi = args[2].as_float()
                val clamped = if v < lo: lo elif v > hi: hi else: v
                return SimpleScriptVal.from_int(clamped.to_i64())
            if recv_expr == "min" and args.len() >= 2:
                val a = args[0].as_int()
                val b = args[1].as_int()
                return SimpleScriptVal.from_int(if a < b: a else: b)
            if recv_expr == "max" and args.len() >= 2:
                val a = args[0].as_int()
                val b = args[1].as_int()
                return SimpleScriptVal.from_int(if a > b: a else: b)
            if (recv_expr == "int" or recv_expr == "parseInt") and args.len() >= 1:
                return SimpleScriptVal.from_int(args[0].as_int())
            if (recv_expr == "str" or recv_expr == "String" or recv_expr == "to_text") and args.len() >= 1:
                return SimpleScriptVal.from_text(args[0].as_text())
            return self._call_user_fn(recv_expr, args, depth + 1)
        if pkind == "index":
            val arr = self._eval_expr(recv_expr, frame, depth + 1)
            val idx = self._eval_expr(payload, frame, depth + 1).as_int()
            if arr.kind == "list" and idx >= 0 and idx < arr.items.len():
                return arr.items[idx]
            return SimpleScriptVal.none()
        if pkind == "prop":
            val obj = self._eval_expr(recv_expr, frame, depth + 1)
            return self._get_prop(obj, payload)

        # Numeric literal?
        if val Some(iv) = expr.parse_i64():
            return SimpleScriptVal.from_int(iv)
        if expr.contains("."):
            if val Some(fv) = expr.parse_f64():
                return SimpleScriptVal.from_float(fv)

        # Variable or function name lookup
        if val Some(v) = self._get_var(frame, expr):
            return v
        for f in self.fns:
            if f.name == expr:
                return SimpleScriptVal(kind: "fn", text_val: expr, int_val: 0, float_val: 0.0, bool_val: true, node_id: -1, items: [])
        SimpleScriptVal.none()

    me _exec_assignment(stmt: text, mut frame: SimpleScriptExecFrame, depth: i64):
        var s = stmt.trim()
        var declare_local = false
        if s.starts_with("val "):
            declare_local = true
            s = s.substring(4, s.byte_len()).trim()
        elif s.starts_with("var "):
            declare_local = true
            s = s.substring(4, s.byte_len()).trim()

        var op = "="
        var op_pos = _ss_find_top_level_op(s, "+=")
        if op_pos > 0:
            op = "+="
        else:
            op_pos = _ss_find_top_level_op(s, "-=")
            if op_pos > 0:
                op = "-="
            else:
                op_pos = _ss_find_top_level_char(s, "=", false)
                op = "="
        if op_pos <= 0:
            return
        val lhs = s.substring(0, op_pos).trim()
        val rhs_expr = s.substring(op_pos + op.byte_len(), s.byte_len()).trim()
        var rhs = self._eval_expr(rhs_expr, frame, depth + 1)
        if op == "+=":
            val cur = self._eval_expr(lhs, frame, depth + 1)
            if cur.kind == "text" or rhs.kind == "text":
                rhs = SimpleScriptVal.from_text(cur.as_text() + rhs.as_text())
            else:
                rhs = SimpleScriptVal.from_int(cur.as_int() + rhs.as_int())
        elif op == "-=":
            val cur = self._eval_expr(lhs, frame, depth + 1)
            rhs = SimpleScriptVal.from_int(cur.as_int() - rhs.as_int())

        val dot = _ss_find_top_level_char(lhs, ".", true)
        if dot > 0:
            val recv_expr = lhs.substring(0, dot).trim()
            val prop = lhs.substring(dot + 1, lhs.byte_len()).trim()
            val recv = self._eval_expr(recv_expr, frame, depth + 1)
            self._set_prop(recv, prop, rhs)
            return
        self._set_var(frame, lhs, rhs, declare_local)

    me _exec_block(lines: [text], indents: [i64], start_idx: i64, end_idx: i64, mut frame: SimpleScriptExecFrame, depth: i64):
        if depth > SIMPLE_SCRIPT_VM_MAX_DEPTH:
            return
        var idx = start_idx
        while idx < end_idx and not frame.returned:
            val line = lines[idx]
            val indent = indents[idx]
            if line == "" or line.starts_with("#"):
                idx = idx + 1
                continue

            # Function definition: fn name(params):
            if line.starts_with("fn ") and line.ends_with(":"):
                val header = line.substring(3, line.byte_len() - 1).trim()
                val lp = header.index_of("(") ?? -1
                val rp = header.index_of(")") ?? -1
                if lp > 0 and rp > lp:
                    val fname = header.substring(0, lp).trim()
                    val param_raw = header.substring(lp + 1, rp).trim()
                    var params: [text] = []
                    if param_raw != "":
                        for p in param_raw.split(","):
                            params.push(p.trim())
                    var body_end = idx + 1
                    var b_lines: [text] = []
                    var b_indents: [i64] = []
                    while body_end < end_idx and (lines[body_end] == "" or indents[body_end] > indent):
                        b_lines.push(lines[body_end])
                        b_indents.push(indents[body_end])
                        body_end = body_end + 1
                    self.fns.push(SimpleScriptFn(name: fname, params: params, body_lines: b_lines, body_indents: b_indents))
                    idx = body_end
                    continue

            # Inline addEventListener("evt", fn(ev): ...)
            if line.contains(".addEventListener(") and line.ends_with(":"):
                val dot = _ss_find_top_level_char(line, ".", true)
                if dot > 0:
                    val recv_expr = line.substring(0, dot).trim()
                    val call_part = line.substring(dot + 1, line.byte_len() - 1).trim()
                    val lp = call_part.index_of("(") ?? -1
                    val comma = call_part.index_of(",") ?? -1
                    if lp > 0 and comma > lp:
                        val evt_expr = call_part.substring(lp + 1, comma).trim()
                        val fn_sig = call_part.substring(comma + 1, call_part.byte_len()).trim()
                        val recv = self._eval_expr(recv_expr, frame, depth + 1)
                        val evt_name = self._eval_expr(evt_expr, frame, depth + 1).as_text().trim().lower()
                        var p_list: [text] = []
                        val flp = fn_sig.index_of("(") ?? -1
                        val frp = fn_sig.index_of(")") ?? -1
                        if flp >= 0 and frp > flp:
                            val p_raw = fn_sig.substring(flp + 1, frp).trim()
                            if p_raw != "":
                                for p in p_raw.split(","):
                                    p_list.push(p.trim())
                        var body_end = idx + 1
                        var b_lines: [text] = []
                        var b_indents: [i64] = []
                        while body_end < end_idx and (lines[body_end] == "" or indents[body_end] > indent):
                            b_lines.push(lines[body_end])
                            b_indents.push(indents[body_end])
                            body_end = body_end + 1
                        if (recv.kind == "dom" and recv.node_id >= 0) or recv.kind == "global_document" or recv.kind == "global_window":
                            val target_nid = if recv.kind == "global_document": -1 elif recv.kind == "global_window": -2 else: recv.node_id
                            self.listeners.push(SimpleScriptDomListener(
                                node_id: target_nid,
                                event_type: evt_name,
                                fn_name: "",
                                inline_params: p_list,
                                inline_lines: b_lines,
                                inline_indents: b_indents,
                                capture: false,
                                once: false
                            ))
                        idx = body_end
                        continue

            # if / elif / else chain
            if line.starts_with("if ") and line.ends_with(":"):
                val cond_expr = line.substring(3, line.byte_len() - 1).trim()
                var branches_conds: [text] = [cond_expr]
                var branches_starts: [i64] = []
                var branches_ends: [i64] = []
                var cursor = idx + 1
                var b_start = cursor
                while cursor < end_idx and (lines[cursor] == "" or indents[cursor] > indent):
                    cursor = cursor + 1
                branches_starts.push(b_start)
                branches_ends.push(cursor)
                while cursor < end_idx and indents[cursor] == indent and (lines[cursor].starts_with("elif ") or lines[cursor] == "else:"):
                    val bline = lines[cursor]
                    if bline == "else:":
                        branches_conds.push("true")
                    else:
                        branches_conds.push(bline.substring(5, bline.byte_len() - 1).trim())
                    cursor = cursor + 1
                    val s2 = cursor
                    while cursor < end_idx and (lines[cursor] == "" or indents[cursor] > indent):
                        cursor = cursor + 1
                    branches_starts.push(s2)
                    branches_ends.push(cursor)
                var bi: i64 = 0
                while bi < branches_conds.len():
                    val cv = self._eval_expr(branches_conds[bi], frame, depth + 1)
                    if cv.is_truthy():
                        self._exec_block(lines, indents, branches_starts[bi], branches_ends[bi], frame, depth + 1)
                        break
                    bi = bi + 1
                idx = cursor
                continue

            # while loop
            if line.starts_with("while ") and line.ends_with(":"):
                val cond_expr = line.substring(6, line.byte_len() - 1).trim()
                var body_end = idx + 1
                while body_end < end_idx and (lines[body_end] == "" or indents[body_end] > indent):
                    body_end = body_end + 1
                var iter: i64 = 0
                while iter < SIMPLE_SCRIPT_VM_MAX_LOOP and not frame.returned:
                    val cv = self._eval_expr(cond_expr, frame, depth + 1)
                    if not cv.is_truthy():
                        break
                    self._exec_block(lines, indents, idx + 1, body_end, frame, depth + 1)
                    iter = iter + 1
                idx = body_end
                continue

            # for item in list:
            if line.starts_with("for ") and line.ends_with(":"):
                val header = line.substring(4, line.byte_len() - 1).trim()
                val in_pos = header.index_of(" in ") ?? -1
                var body_end = idx + 1
                while body_end < end_idx and (lines[body_end] == "" or indents[body_end] > indent):
                    body_end = body_end + 1
                if in_pos > 0:
                    val var_name = header.substring(0, in_pos).trim()
                    val list_expr = header.substring(in_pos + 4, header.byte_len()).trim()
                    val list_val = self._eval_expr(list_expr, frame, depth + 1)
                    var ii: i64 = 0
                    while ii < list_val.items.len() and ii < SIMPLE_SCRIPT_VM_MAX_LOOP and not frame.returned:
                        self._set_var(frame, var_name, list_val.items[ii], false)
                        self._exec_block(lines, indents, idx + 1, body_end, frame, depth + 1)
                        ii = ii + 1
                idx = body_end
                continue

            if line == "return":
                frame.returned = true
                frame.ret_val = SimpleScriptVal.none()
                return
            if line.starts_with("return "):
                frame.returned = true
                frame.ret_val = self._eval_expr(line.substring(7, line.byte_len()), frame, depth + 1)
                return
            if line == "pass" or line == "pass_dn":
                idx = idx + 1
                continue

            if line.starts_with("val ") or line.starts_with("var ") or _ss_find_top_level_char(line, "=", false) > 0:
                val eq_pos = _ss_find_top_level_char(line, "=", false)
                val eq2 = _ss_find_top_level_op(line, "==")
                if line.starts_with("val ") or line.starts_with("var ") or (eq_pos > 0 and eq_pos != eq2):
                    self._exec_assignment(line, frame, depth + 1)
                    idx = idx + 1
                    continue

            val _ = self._eval_expr(line, frame, depth + 1)
            idx = idx + 1

    # reason: returns execution status matching SimpleScriptExecutor boolean execute contract
    # @allow(primitive_api)
    me execute(source: text) -> bool:
        self.error = ""
        val sec = simple_script_security_check(source)
        if sec != "":
            self.error = sec
            return false
        var lines: [text] = []
        var indents: [i64] = []
        for raw in source.replace("\r", "").split("\n"):
            val cleaned = _ss_strip_inline_comment(raw)
            val trimmed = cleaned.trim()
            if trimmed == "":
                continue
            lines.push(trimmed)
            indents.push(_ss_count_indent(cleaned))
        var frame = SimpleScriptExecFrame(returned: false, ret_val: SimpleScriptVal.none(), names: [], values: [], is_top_level: true)
        self._exec_block(lines, indents, 0, lines.len(), frame, 0)
        true

    # reason: matches BeDomEvent pixel coordinates and returns (default_prevented, propagation_stopped) flags
    # @allow(primitive_api)
    me dispatch_event(
        event_type: text, target_node_id: i64, path_node_ids: [i64],
        bubbles: bool, client_x: i32, client_y: i32,
        offset_x: i32, offset_y: i32, key: text, code: text, data: text,
        prevented_in: bool, stopped_in: bool
    ) -> (bool, bool):
        val norm = event_type.trim().lower()
        self.current_event_type = norm
        self.current_target_id = target_node_id
        self.current_client_x = client_x
        self.current_client_y = client_y
        self.current_offset_x = offset_x
        self.current_offset_y = offset_y
        self.current_key = key
        self.current_code = code
        self.current_data = data
        self.event_prevent_default = prevented_in
        self.event_stop_prop = stopped_in
        self.event_stop_imm_prop = false

        var phases_nodes: [i64] = []
        var phases_capture: [bool] = []
        # Capture phase (window -> document -> ancestors outer -> parent)
        if target_node_id >= 0:
            phases_nodes.push(-2)
            phases_capture.push(true)
            phases_nodes.push(-1)
            phases_capture.push(true)
        var ci: i64 = 0
        while ci < path_node_ids.len() - 1:
            phases_nodes.push(path_node_ids[ci])
            phases_capture.push(true)
            ci = ci + 1
        # Target phase
        phases_nodes.push(target_node_id)
        phases_capture.push(false)
        # Bubble phase (parent -> outer -> document -> window)
        if bubbles:
            var bi: i64 = path_node_ids.len() - 2
            while bi >= 0:
                phases_nodes.push(path_node_ids[bi])
                phases_capture.push(false)
                bi = bi - 1
            if target_node_id >= 0:
                phases_nodes.push(-1)
                phases_capture.push(false)
                phases_nodes.push(-2)
                phases_capture.push(false)

        var pi: i64 = 0
        while pi < phases_nodes.len() and not self.event_stop_prop:
            val cur_id = phases_nodes[pi]
            val cap = phases_capture[pi]
            self.current_current_target_id = cur_id
            var li: i64 = 0
            while li < self.listeners.len() and not self.event_stop_imm_prop:
                val listener = self.listeners[li]
                if listener.node_id == cur_id and listener.event_type == norm and (listener.capture == cap or cur_id == target_node_id):
                    val ev_val = SimpleScriptVal.obj("event", -1)
                    if listener.fn_name != "":
                        val _ = self._call_user_fn(listener.fn_name, [ev_val], 0)
                    else:
                        var sub = SimpleScriptExecFrame(returned: false, ret_val: SimpleScriptVal.none(), names: [], values: [], is_top_level: false)
                        if listener.inline_params.len() >= 1:
                            sub.names.push(listener.inline_params[0])
                            sub.values.push(ev_val)
                        self._exec_block(listener.inline_lines, listener.inline_indents, 0, listener.inline_lines.len(), sub, 0)
                li = li + 1
            pi = pi + 1
        (self.event_prevent_default, self.event_stop_prop)
