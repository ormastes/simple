fn has_visible_overflow_clip(styles: [Style]) -> bool:
    var i = 0
    val style_count = styles.len()
    # cpu-lane-loop-ok: existence scan over the style list for any overflow clip; bound is style_count and it returns on the first hit; runs once per paint to decide whether a per-node clip array is needed at all
    while i < style_count:
        val st = styles[i]
        if (st.overflow_hidden or st.overflow_auto_y) and st.display != "none":
            return true
        i = i + 1
    false

fn build_ancestor_clip_cache(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], fbw: i32, fbh: i32) -> PaintClipCache:
    val default_clip = ClipRect(x0: 0, y0: 0, x1: fbw, y1: fbh)
    if not has_visible_overflow_clip(styles):
        return PaintClipCache(has_node_clips: false, default_clip: default_clip, clips: [])
    val node_count = nodes.len()
    var clips: [ClipRect] = [default_clip; node_count]
    var i = 0
    # cpu-lane-loop-ok: single forward pass over the node list building each node's clip from its already-computed parent clip; this loop IS the bulk idiom that replaces a per-node ancestor walk, bound is node_count
    while i < node_count:
        var clip = default_clip
        val p = nodes[i].parent
        if p >= 0:
            clip = clips[p]
            val pst = styles[p]
            if (pst.overflow_hidden or pst.overflow_auto_y) and pst.display != "none":
                val cx0 = bx[p] + pst.border_l
                val cy0 = by[p] + pst.border_t
                val cx1 = bx[p] + bw[p] - pst.border_r
                val cy1 = by[p] + bh[p] - pst.border_b
                clip = clip_intersect(clip, cx0, cy0, cx1, cy1)
        clips[i] = clip
        i = i + 1
    PaintClipCache(has_node_clips: true, default_clip: default_clip, clips: clips)

fn paint_clip_at(cache: PaintClipCache, i: i32) -> ClipRect:
    if cache.has_node_clips:
        return cache.clips[i]
    cache.default_clip

fn has_relative_paint_root(nodes: [HNode], styles: [Style], i: i32) -> bool:
    var cur = i
    # cpu-lane-loop-ok: depth-bounded ancestor walk up nodes[].parent for position:relative; bound is DOM depth, not an element or pixel count, so this is a detector false positive under the bound-based rule of design section 6
    while cur >= 0:
        if styles[cur].position_relative:
            return true
        cur = nodes[cur].parent as i32
    false

fn content_hidden_by_ancestor(nodes: [HNode], styles: [Style], i: i32) -> bool:
    var cur = nodes[i].parent as i32
    # cpu-lane-loop-ok: depth-bounded ancestor walk up nodes[].parent for display:none / content-visibility:hidden / iframe; bound is DOM depth, not an element count, so this is a detector false positive under the bound-based rule
    while cur >= 0:
        # An <iframe> is a replaced element: its DOM subtree (fallback content or
        # any inline children) is NOT laid out or painted in the parent document.
        # The iframe's real content is rendered separately from srcdoc/src and
        # blitted over its box by _web_paint_iframes, so descendants stay hidden.
        if (
            styles[cur].display == "none" or
            styles[cur].content_visibility_hidden or nodes[cur].tag == "iframe"
        ):
            return true
        cur = nodes[cur].parent as i32
    false

fn content_paint_hidden_by_ancestor(
    nodes: [HNode], styles: [Style], i: i32
) -> bool:
    if styles[i].opacity_pct <= 0:
        return true
    var cur = nodes[i].parent as i32
    # cpu-lane-loop-ok: ONE depth-bounded ancestor walk testing both hiding
    # conditions. This used to be TWO walks of the same chain — a
    # content_hidden_by_ancestor call followed by an opacity-only walk — which
    # doubled the traversals of the hottest predicate in paint() (11 call
    # sites, most of them once per node per frame). Bound is DOM depth, not an
    # element count, so this is a detector false positive under the
    # bound-based rule.
    while cur >= 0:
        # An <iframe> is a replaced element: its DOM subtree is NOT laid out or
        # painted in the parent document — see content_hidden_by_ancestor above
        # for the full note.
        if (
            styles[cur].display == "none" or
            styles[cur].content_visibility_hidden or
            nodes[cur].tag == "iframe" or
            styles[cur].opacity_pct <= 0
        ):
            return true
        cur = nodes[cur].parent as i32
    false

fn fb_vertical_scrollbar_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, h: i32, track_color: u32, thumb_color: u32, clip: ClipRect) -> [u32]:
    val track = if track_color != 0u32: track_color else: argb(241, 241, 241)
    val thumb = if thumb_color != 0u32: thumb_color else: argb(163, 163, 163)
    val thumb_dark = if thumb_color != 0u32: thumb_color else: argb(80, 80, 80)
    var out = fb_rect_clip(fb, fbw, fbh, x, y, 15, h, track, clip)
    val mid_x = x + 7
    val up_y = y + 3
    var row = 0
    # cpu-lane-loop-ok: fixed 4-row up-arrow glyph of the scrollbar button; bound is the literal constant 4, not a pixel or element count, so this is a detector false positive
    while row < 4:
        val half = row
        out = fb_rect_clip(out, fbw, fbh, mid_x - half, up_y + row, half * 2 + 1, 1, thumb, clip)
        row = row + 1
    val down_y = y + h - 7
    row = 0
    # cpu-lane-loop-ok: fixed 4-row down-arrow glyph of the scrollbar button; bound is the literal constant 4, not a pixel or element count, so this is a detector false positive
    while row < 4:
        val half = 3 - row
        out = fb_rect_clip(out, fbw, fbh, mid_x - half, down_y + row, half * 2 + 1, 1, thumb_dark, clip)
        row = row + 1
    out

fn fb_widget_image_placeholder_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, object_fit: text, object_position: text, clip: ClipRect) -> [u32]:
    val intrinsic_w = 24
    val intrinsic_h = 16
    var draw_w = w
    var draw_h = h
    if object_fit == "contain" or object_fit == "scale-down":
        if w * intrinsic_h <= h * intrinsic_w:
            draw_w = w
            draw_h = (w * intrinsic_h) / intrinsic_w
        else:
            draw_h = h
            draw_w = (h * intrinsic_w) / intrinsic_h
    elif object_fit == "cover":
        if w * intrinsic_h >= h * intrinsic_w:
            draw_w = w
            draw_h = (w * intrinsic_h) / intrinsic_w
        else:
            draw_h = h
            draw_w = (h * intrinsic_w) / intrinsic_h
    elif object_fit == "none":
        draw_w = if intrinsic_w < w: intrinsic_w else: w
        draw_h = if intrinsic_h < h: intrinsic_h else: h
    if draw_w <= 0 or draw_h <= 0:
        return fb
    val draw_x = x + (((w - draw_w) * object_position_x_pct(object_position)) / 100)
    val draw_y = y + (((h - draw_h) * object_position_y_pct(object_position)) / 100)
    var out = fb_rect_clip(fb, fbw, fbh, draw_x, draw_y, draw_w, draw_h, argb(37, 99, 235), clip)
    val accent_w = if draw_w >= 8: 8 else: draw_w
    val accent_h = if draw_h >= 7: 7 else: draw_h
    val accent_x = draw_x + if draw_w > 11: 3 else: 0
    val accent_y = draw_y + if draw_h > 11: 4 else: 0
    out = fb_rect_clip(out, fbw, fbh, accent_x, accent_y, accent_w, accent_h, argb(245, 158, 11), clip)
    if draw_w >= 21 and draw_h >= 11:
        out = fb_rect_clip(out, fbw, fbh, draw_x + 13, draw_y + 5, 8, 6, argb(34, 197, 94), clip)
    out

fn input_uses_accent_color(nd: HNode) -> bool:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    input_type == "checkbox" or input_type == "radio"

fn input_is_checked(nd: HNode) -> bool:
    attr_present(nd.attrs_raw, "checked")

fn input_paints_text(nd: HNode) -> bool:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val declared_value = attr_value(nd.attrs_raw, "value")
    if declared_value != "" and not text_is_valid_utf8(declared_value):
        return false
    input_type == "" or input_type == "text" or input_type == "search" or
        input_type == "url" or input_type == "tel" or
        input_type == "email" or input_type == "password" or
        input_type == "number" or input_type == "button" or
        input_type == "submit" or input_type == "reset"

pub fn input_accepts_text_overlay(nd: HNode) -> bool:
    val disabled_at = attr_key_index(nd.attrs_raw, "disabled", 8)
    if disabled_at >= 0:
        val disabled_end = disabled_at + 8
        if disabled_end >= nd.attrs_raw.len():
            return false
        val after_disabled = nd.attrs_raw.char_at(disabled_end)
        if (
            after_disabled == "=" or after_disabled == " " or
            after_disabled == "\t" or after_disabled == "\n" or
            after_disabled == "\r" or after_disabled == "/"
        ):
            return false
    if not text_is_valid_utf8(attr_value(nd.attrs_raw, "value")):
        return false
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    input_type == "" or input_type == "text" or input_type == "search" or
        input_type == "url" or input_type == "tel" or
        input_type == "email" or input_type == "password" or
        input_type == "number"

fn input_text_prefix(value: text, max_glyphs: i32) -> text:
    if max_glyphs <= 0:
        return ""
    if text_codepoint_len(value) <= max_glyphs:
        return value
    val bytes = value.bytes()
    var byte_index: i64 = 0
    var glyph_index: i32 = 0
    # cpu-lane-loop-ok: UTF-8 sequence walk to find the byte offset of the max_glyphs-th glyph so the value can be sliced on a codepoint boundary; bound is min(value bytes, max_glyphs) where max_glyphs is the glyph count that fits the input's content box
    while byte_index < bytes.len() and glyph_index < max_glyphs:
        val sequence_length = utf8_seq_len(bytes[byte_index])
        if sequence_length > 0:
            byte_index = byte_index + sequence_length
        else:
            byte_index = byte_index + 1
        glyph_index = glyph_index + 1
    value[0:byte_index]

fn input_text_for_paint(nd: HNode, max_glyphs: i32) -> text:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val declared_value = attr_value(nd.attrs_raw, "value")
    if not text_is_valid_utf8(declared_value):
        return ""
    var value = declared_value
    if value == "":
        if input_type == "submit":
            value = "Submit"
        elif input_type == "reset":
            value = "Reset"
        else:
            value = attr_value(nd.attrs_raw, "placeholder")
    if input_type == "password" and declared_value != "":
        var count = text_codepoint_len(declared_value)
        if count > max_glyphs:
            count = max_glyphs
        return "*".repeat(count)
    input_text_prefix(value, max_glyphs)

# Shared resolved input text geometry used by the CPU pixel painter and the
# Draw IR producer. It contains only durable layout semantics: the executor
# receives the final text and clip, never renderer-local font/cache state.
pub struct InputTextPaintPlan:
    text_value: text
    baseline_x: i32
    baseline_y: i32
    measured_width: i32
    clip: ClipRect
    color: u32
    source_window_start_byte: i64
    source_window_end_byte: i64
    source_boundary_bytes: [i64]
    boundary_x_px: [i32]
    selection_present: bool
    selection_rect: ClipRect
    selection_color: u32
    caret_present: bool
    caret_rect: ClipRect
    caret_color: u32
    resolved_view_start_byte: i64

pub struct InputTextVisualMap:
    display_text: text
    source_boundary_bytes: [i64]
    boundary_x_px: [i32]

pub val INPUT_TEXT_SELECTION_ALPHA: u32 = 0x66u32

pub fn input_caret_color(st: Style) -> u32:
    if st.caret_color != 0u32: st.caret_color else: st.fg

pub fn input_selection_color(st: Style) -> u32:
    (INPUT_TEXT_SELECTION_ALPHA << 24) |
        (input_caret_color(st) & 0x00FFFFFFu32)

fn _input_text_empty_rect() -> ClipRect:
    ClipRect(x0: 0, y0: 0, x1: 0, y1: 0)

fn _input_text_declared_value(nd: HNode) -> text:
    attr_value(nd.attrs_raw, "value")

fn _input_text_source_boundaries(value: text) -> [i64]:
    var boundaries: [i64] = [0]
    val bytes = value.bytes()
    var cursor: i64 = 0
    # cpu-lane-loop-ok: one UTF-8 decode pass over a single input element's declared value building its codepoint boundary table; bound is that value's byte length, not page content
    while cursor < bytes.len():
        var count = utf8_seq_len(bytes[cursor])
        if count <= 0 or cursor + count > bytes.len():
            count = 1
        cursor = cursor + count
        boundaries.push(cursor)
    boundaries

pub fn input_text_visual_map(nd: HNode, st: Style) -> InputTextVisualMap:
    val source = _input_text_declared_value(nd)
    if not text_is_valid_utf8(source):
        return InputTextVisualMap(
            display_text: "",
            source_boundary_bytes: [],
            boundary_x_px: []
        )
    val source_boundaries = _input_text_source_boundaries(source)
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val transformed = if input_type == "password":
        "*".repeat(source_boundaries.len() - 1)
    else:
        apply_text_transform_for_paint(source, st.text_transform)
    val display_text = if st.direction_rtl:
        reverse_text_for_paint(transformed)
    else:
        transformed
    val advance = style_text_advance(st)
    val space_advance = style_space_advance(st)
    val total_width = style_text_line_advance_width(
        transformed, 0, transformed.len(), st, advance, space_advance
    )
    var boundary_x_px: [i32] = []
    var boundary_index = 0
    while boundary_index < source_boundaries.len():
        val source_end = source_boundaries[boundary_index]
        val prefix = if input_type == "password":
            "*".repeat(boundary_index)
        else:
            apply_text_transform_for_paint(
                source[0:source_end], st.text_transform
            )
        val prefix_width = style_text_line_advance_width(
            prefix, 0, prefix.len(), st, advance, space_advance
        )
        boundary_x_px.push(
            if st.direction_rtl:
                total_width - prefix_width
            else:
                prefix_width
        )
        boundary_index = boundary_index + 1
    InputTextVisualMap(
        display_text: display_text,
        source_boundary_bytes: source_boundaries,
        boundary_x_px: boundary_x_px
    )

fn _input_text_boundary_index(
    visual_map: InputTextVisualMap, source_byte: i64
) -> i32:
    var i = 0
    while i < visual_map.source_boundary_bytes.len():
        if visual_map.source_boundary_bytes[i] == source_byte:
            return i
        i = i + 1
    -1

pub fn input_text_x_at_source_byte(
    visual_map: InputTextVisualMap, source_byte: i64
) -> i32:
    val index = _input_text_boundary_index(visual_map, source_byte)
    if index < 0:
        return 0
    visual_map.boundary_x_px[index]

pub fn input_text_source_byte_at_x(
    visual_map: InputTextVisualMap, x: i32
) -> i64:
    if visual_map.source_boundary_bytes.len() == 0:
        return 0
    var best_index = 0
    var best_distance = visual_map.boundary_x_px[0] - x
    if best_distance < 0:
        best_distance = 0 - best_distance
    var i = 1
    while i < visual_map.source_boundary_bytes.len():
        var distance = visual_map.boundary_x_px[i] - x
        if distance < 0:
            distance = 0 - distance
        if distance < best_distance:
            best_index = i
            best_distance = distance
        i = i + 1
    visual_map.source_boundary_bytes[best_index]

fn _input_text_content_clip(ancestor_clip: ClipRect, x: i32, y: i32, w: i32, h: i32) -> ClipRect:
    val raw_clip = clip_intersect(ancestor_clip, x, y, x + w, y + h)
    var x1 = raw_clip.x1
    var y1 = raw_clip.y1
    if x1 < raw_clip.x0:
        x1 = raw_clip.x0
    if y1 < raw_clip.y0:
        y1 = raw_clip.y0
    ClipRect(x0: raw_clip.x0, y0: raw_clip.y0, x1: x1, y1: y1)

pub fn input_text_paint_plan(nd: HNode, st: Style, x: i32, y: i32, w: i32, h: i32, ancestor_clip: ClipRect, max_glyphs: i32) -> InputTextPaintPlan:
    val raw_text = input_text_for_paint(nd, max_glyphs)
    val transformed_text = apply_text_transform_for_paint(
        raw_text, st.text_transform
    )
    val text_value = if st.direction_rtl:
        reverse_text_for_paint(transformed_text)
    else:
        transformed_text
    val content_x = x + st.border_l + st.pad_l
    val content_y = y + st.border_t + st.pad_t
    val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
    val content_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    val scale = glyph_scale(st.font_size)
    val baseline_y = content_y + if content_h > 7 * scale:
        (content_h - 7 * scale) / 2
    else:
        0
    val adv = style_text_advance(st)
    val space_adv = style_space_advance(st)
    val measured_width = style_text_line_advance_width(
        text_value, 0, text_value.len(), st, adv, space_adv
    )
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val baseline_x = if (
        input_type == "button" or input_type == "submit" or
        input_type == "reset"
    ):
        content_x + (content_w - measured_width) / 2
    else:
        text_line_aligned_x(
            content_x, content_w, measured_width, st, 0, 1
        )
    val visual_map = input_text_visual_map(nd, st)
    var absolute_boundaries: [i32] = []
    # cpu-lane-loop-ok: maps one input's glyph-boundary x offsets to absolute x; bound is the boundary count of that input's own value, a single linear map with no nesting
    for boundary_x in visual_map.boundary_x_px:
        absolute_boundaries.push(baseline_x + boundary_x)
    # There is no computed ::placeholder color in Style yet. st.fg is the
    # canonical theme-derived fail-safe rather than a renderer-only gray.
    InputTextPaintPlan(
        text_value: text_value,
        baseline_x: baseline_x,
        baseline_y: baseline_y,
        measured_width: measured_width,
        clip: _input_text_content_clip(
            ancestor_clip, content_x, content_y, content_w, content_h
        ),
        color: st.fg,
        source_window_start_byte: 0,
        source_window_end_byte: if text_is_valid_utf8(
            _input_text_declared_value(nd)
        ):
            _input_text_declared_value(nd).len()
        else:
            0,
        source_boundary_bytes: visual_map.source_boundary_bytes,
        boundary_x_px: absolute_boundaries,
        selection_present: false,
        selection_rect: _input_text_empty_rect(),
        selection_color: input_selection_color(st),
        caret_present: false,
        caret_rect: _input_text_empty_rect(),
        caret_color: input_caret_color(st),
        resolved_view_start_byte: 0
    )

pub fn input_text_paint_plan_with_overlay(
    nd: HNode, st: Style, x: i32, y: i32, w: i32, h: i32,
    ancestor_clip: ClipRect, overlay: BrowserTextInputOverlay
) -> InputTextPaintPlan:
    if overlay.target_key == "":
        val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
        val advance = style_text_advance(st)
        val glyph_advance = if advance > 0: advance else: 1
        return input_text_paint_plan(
            nd, st, x, y, w, h, ancestor_clip,
            content_w / glyph_advance + 1
        )
    val visual_map = input_text_visual_map(nd, st)
    if visual_map.source_boundary_bytes.len() == 0:
        return input_text_paint_plan(
            nd, st, x, y, w, h, ancestor_clip, 0
        )
    var view_index = _input_text_boundary_index(
        visual_map, overlay.view_start_byte
    )
    if view_index < 0:
        view_index = 0
    var focus_index = _input_text_boundary_index(
        visual_map, overlay.focus_byte
    )
    if focus_index < 0:
        focus_index = visual_map.source_boundary_bytes.len() - 1
    val content_x = x + st.border_l + st.pad_l
    val content_y = y + st.border_t + st.pad_t
    val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
    val content_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    if focus_index < view_index:
        view_index = focus_index
    var focus_distance = (
        visual_map.boundary_x_px[focus_index] -
        visual_map.boundary_x_px[view_index]
    )
    if focus_distance < 0:
        focus_distance = 0 - focus_distance
    # cpu-lane-loop-ok: advances the horizontal scroll window start until the focused caret fits content_w; bound is focus_index inside one input's boundary table, and view_index only ever moves forward
    while view_index < focus_index and focus_distance >= content_w:
        view_index = view_index + 1
        focus_distance = (
            visual_map.boundary_x_px[focus_index] -
            visual_map.boundary_x_px[view_index]
        )
        if focus_distance < 0:
            focus_distance = 0 - focus_distance
    val resolved_view_start = visual_map.source_boundary_bytes[view_index]
    var window_end_index = view_index
    # cpu-lane-loop-ok: extends the visible window end while it still fits content_w; bound is one input's boundary count, single monotone forward scan
    while window_end_index + 1 < visual_map.source_boundary_bytes.len():
        var window_width = (
            visual_map.boundary_x_px[window_end_index + 1] -
            visual_map.boundary_x_px[view_index]
        )
        if window_width < 0:
            window_width = 0 - window_width
        if window_width > content_w:
            break
        window_end_index = window_end_index + 1
    val resolved_window_end = (
        visual_map.source_boundary_bytes[window_end_index]
    )
    val advance = style_text_advance(st)
    val space_advance = style_space_advance(st)
    val visual_width = style_text_line_advance_width(
        visual_map.display_text, 0, visual_map.display_text.len(),
        st, advance, space_advance
    )
    val glyph_advance = if advance > 0: advance else: 1
    val static_plan = input_text_paint_plan(
        nd, st, x, y, w, h, ancestor_clip,
        content_w / glyph_advance + 1
    )
    val baseline_x = if view_index == 0:
        static_plan.baseline_x
    elif st.direction_rtl:
        content_x + content_w - visual_map.boundary_x_px[view_index]
    else:
        content_x - visual_map.boundary_x_px[view_index]
    val scale = glyph_scale(st.font_size)
    val text_height = 7 * scale
    val baseline_y = content_y + if content_h > text_height:
        (content_h - text_height) / 2
    else:
        0
    var absolute_boundaries: [i32] = []
    # cpu-lane-loop-ok: same absolute-x boundary mapping as input_text_paint_plan, overlay variant; bound is the boundary count of that one input's value
    for boundary_x in visual_map.boundary_x_px:
        absolute_boundaries.push(baseline_x + boundary_x)
    var anchor_x = baseline_x + input_text_x_at_source_byte(
        visual_map, overlay.anchor_byte
    )
    var focus_x = baseline_x + input_text_x_at_source_byte(
        visual_map, overlay.focus_byte
    )
    val selection_present = overlay.anchor_byte != overlay.focus_byte
    if anchor_x > focus_x:
        val swap = anchor_x
        anchor_x = focus_x
        focus_x = swap
    val caret_x = baseline_x + input_text_x_at_source_byte(
        visual_map, overlay.focus_byte
    )
    val clip = _input_text_content_clip(
        ancestor_clip, content_x, content_y, content_w, content_h
    )
    InputTextPaintPlan(
        text_value: visual_map.display_text,
        baseline_x: baseline_x,
        baseline_y: baseline_y,
        measured_width: visual_width,
        clip: clip,
        color: st.fg,
        source_window_start_byte: resolved_view_start,
        source_window_end_byte: resolved_window_end,
        source_boundary_bytes: visual_map.source_boundary_bytes,
        boundary_x_px: absolute_boundaries,
        selection_present: selection_present,
        selection_rect: ClipRect(
            x0: anchor_x, y0: baseline_y,
            x1: focus_x, y1: baseline_y + text_height
        ),
        selection_color: input_selection_color(st),
        caret_present: overlay.caret_visible and not selection_present,
        caret_rect: ClipRect(
            x0: caret_x, y0: baseline_y,
            x1: caret_x + 1, y1: baseline_y + text_height
        ),
        caret_color: input_caret_color(st),
        resolved_view_start_byte: resolved_view_start
    )

fn fb_input_accent_control_clip(
    fb: [u32], fbw: i32, fbh: i32,
    x: i32, y: i32, w: i32, h: i32,
    input_type: text, checked: bool, accent_color: u32, clip: ClipRect
) -> [u32]:
    val accent = if accent_color != 0u32: accent_color else: argb(37, 99, 235)
    val control_w = if w < 14: w else: 14
    val control_h = if h < 14: h else: 14
    if control_w <= 0 or control_h <= 0:
        return fb
    val radio = input_type == "radio"
    var out = fb
    if radio:
        out = fb_rounded_rect_opacity_clip(
            out, fbw, fbh, x, y, control_w, control_h,
            control_w / 2, accent, 100, clip
        )
        if control_w > 2 and control_h > 2:
            out = fb_rounded_rect_opacity_clip(
                out, fbw, fbh, x + 1, y + 1,
                control_w - 2, control_h - 2,
                (control_w - 2) / 2, argb(248, 250, 252), 100, clip
            )
    else:
        out = fb_rect_clip(fb, fbw, fbh, x, y, control_w, control_h, argb(248, 250, 252), clip)
        out = fb_rect_clip(out, fbw, fbh, x, y, control_w, 1, accent, clip)
        out = fb_rect_clip(out, fbw, fbh, x, y + control_h - 1, control_w, 1, accent, clip)
        out = fb_rect_clip(out, fbw, fbh, x, y, 1, control_h, accent, clip)
        out = fb_rect_clip(out, fbw, fbh, x + control_w - 1, y, 1, control_h, accent, clip)
    if checked and control_w > 6 and control_h > 6:
        if radio:
            out = fb_rounded_rect_opacity_clip(
                out, fbw, fbh, x + 3, y + 3,
                control_w - 6, control_h - 6,
                (control_w - 6) / 2, accent, 100, clip
            )
        else:
            out = fb_rect_clip(out, fbw, fbh, x + 3, y + 3, control_w - 6, control_h - 6, accent, clip)
    out

# ---------------------------------------------------------------------------
# Paint into a staging [u32] framebuffer before Engine2D presentation.
# ---------------------------------------------------------------------------

# Sum of bottom insets (padding + border) along a node's ancestor chain.
# Used when a flex-fill/panel node grows toward the viewport bottom: the fill
# target is the ancestors' content box, not the raw viewport edge.
fn ancestor_bottom_inset(nodes: [HNode], styles: [Style], i: i32) -> i32:
    var inset = 0
    var p = nodes[i].parent
    var guard = 0
    # cpu-lane-loop-ok: ancestor chain walk with an explicit guard < 64 cap; the bound is a literal constant, not an element count, so this is a detector false positive
    while p >= 0 and guard < 64:
        guard = guard + 1
        val ps = styles[p]
        inset = inset + ps.pad_b + ps.border_b
        p = nodes[p].parent
    inset

fn paint(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool) -> [u32]:
    var out = fb
    # Reserve roughly half of whatever time remains in the paint stage for the
    # text pass. Draw order requires backgrounds/structural passes to run
    # first (text must land on top), but on a large real page those passes
    # alone can consume the entire remaining budget before the text pass —
    # the actually-visible content — ever gets a turn, leaving a degraded
    # render blank even though real geometry was computed. Restored to the
    # full paint deadline before the text pass below. In the common case
    # (budget never trips) this never matters: every pass finishes long
    # before either deadline.
    val paint_now_us = _web_budget_clock.now_micros()
    val paint_deadline_us = _web_render_deadline_us
    if paint_deadline_us > paint_now_us:
        _web_budget_rearm(paint_now_us + (paint_deadline_us - paint_now_us) / 2)
    val need_widget_text = widget_mode and fbw >= 38 and fbh >= 62
    val widget_flags = compute_widget_paint_flags(nodes, widget_mode, need_widget_text)
    val has_widget_panel = widget_flags.has_widget_panel
    val chrome_widget_text = need_widget_text and widget_flags.has_nonempty_widget_text
    val clip_cache = build_ancestor_clip_cache(nodes, styles, bx, by, bw, bh, fbw, fbh)
    # backgrounds first (document order = back to front)
    val node_count = nodes.len()
    var i = 0
    var has_absolute_node = false
    # cpu-lane-loop-ok: fn paint pass 1 of 6: normal-flow (non-absolute, non-relative-root) box paint - shadow, background, border, outline plus widget panel and button fills, in document order = back to front. Bound is node_count; the CPU lane rasterises per node by design, and the pass is budget-guarded via _web_budget_expired_at
    while i < node_count:
        # Budget guard: stop painting backgrounds on expiry; the framebuffer keeps
        # whatever was painted so far (already sized width*height).
        if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_BACKGROUNDS):
            break
        val nd = nodes[i]
        val st = styles[i]
        if st.position_absolute:
            has_absolute_node = true
        val x = bx[i]
        val y = by[i]
        val w = bw[i]
        val h = bh[i]
        val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
        val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
        val relative_paint_root = has_relative_paint_root(nodes, styles, i)
        val normal_flow = not st.position_absolute and not relative_paint_root
        val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
        val visible_box = normal_flow and visible_node and nd.tag != "#text" and y < fbh
        val non_widget_mode = not widget_mode
        if visible_box:
            val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32))
            val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
            val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
            val paint_shadow = not skip_widget_node_bg and st.box_shadow_color != 0u32
            if skip_widget_page_bg and nd.tag == "body" and st.bg_layers_raw != "":
                # widget pages suppress the flat page bg, but a radial-carrying
                # body background stack is the Chromium-visible page tint:
                # paint the linear base ramp, then the radial layers over it
                val clip = paint_clip_at(clip_cache, i)
                if st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32:
                    out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                out = fb_background_radial_stack_clip(out, fbw, fbh, x, y, w, h, st.bg_layers_raw, st.opacity_pct, clip)
            if paint_shadow or paint_bg or paint_border or paint_outline:
                val clip = paint_clip_at(clip_cache, i)
                if paint_shadow:
                    out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                if paint_bg:
                    out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                if paint_border:
                    out = fb_border_sides_clip(out, fbw, fbh, x, y, w, h, st.border_l, st.border_t, st.border_r, st.border_b, st.border_color_l, st.border_color_t, st.border_color_r, st.border_color_b, clip)
                if paint_outline:
                    out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
        if normal_flow and non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
            val panel_h = h
            if st.bg == 0u32 and st.background_gradient_from == 0u32:
                out = fb_rect(out, fbw, fbh, x, y, w, panel_h, argb(245, 245, 245))
            if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                out = fb_rect(out, fbw, fbh, x, y, w, 1, argb(0, 102, 204))
        if normal_flow and non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
            if st.bg == 0u32 and st.background_gradient_from == 0u32:
                out = fb_rect(out, fbw, fbh, x, y, w, h, argb(203, 213, 225))
        i = i + 1
    i = 0
    # cpu-lane-loop-ok: fn paint pass 2 of 6: the relative-paint-root boxes pass 1 deliberately skipped, painted after normal flow so position:relative subtrees land above it. Disjoint node set from pass 1, so it cannot be fused without breaking paint order. Bound is node_count, budget-guarded
    while i < node_count:
        # Budget guard: stop scanning for relative-paint-root nodes on expiry.
        # This pass was completely unguarded — unlike every other O(node_count)
        # paint pass — so on a large real page it silently burned the rest of
        # the paint slice walking has_relative_paint_root/content_hidden_by_ancestor
        # for every node before the text pass ever got a chance to run, which is
        # why a degraded render still came out fully blank.
        if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_RELATIVE_ROOTS):
            break
        val nd = nodes[i]
        val st = styles[i]
        if has_relative_paint_root(nodes, styles, i) and not st.position_absolute:
            val x = bx[i]
            val y = by[i]
            val w = bw[i]
            val h = bh[i]
            val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
            val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
            val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
            val visible_box = visible_node and nd.tag != "#text" and y < fbh
            val non_widget_mode = not widget_mode
            if visible_box:
                val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32))
                val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
                val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
                val paint_shadow = not skip_widget_node_bg and st.box_shadow_color != 0u32
                if paint_shadow or paint_bg or paint_border or paint_outline:
                    val clip = paint_clip_at(clip_cache, i)
                    if paint_shadow:
                        out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_bg:
                        out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_border:
                        out = fb_border_sides_clip(out, fbw, fbh, x, y, w, h, st.border_l, st.border_t, st.border_r, st.border_b, st.border_color_l, st.border_color_t, st.border_color_r, st.border_color_b, clip)
                    if paint_outline:
                        out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
            if non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
                val panel_h = h
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, panel_h, argb(245, 245, 245))
                if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, 1, argb(0, 102, 204))
            if non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, h, argb(203, 213, 225))
        i = i + 1
    var positive_z_indices: [i32] = []
    var positive_z_count = 0
    var positive_z_sorted = true
    var last_positive_z = 0
    if has_absolute_node:
        i = 0
        # cpu-lane-loop-ok: fn paint pass 3 of 6: position:absolute boxes with z-index <= 0, plus collection of the positive-z indices consumed by pass 4. Bound is node_count, entered only when pass 1 saw an absolute node, budget-guarded
        while i < node_count:
            # Budget guard: stop scanning for absolute/z-index nodes on expiry.
            # This loop was unbounded — unlike the normal-flow background loop
            # right above it — so a page with any position:absolute node could
            # silently burn the rest of the paint slice here before the text
            # pass ever ran.
            if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_ABSOLUTE_LOW_Z):
                break
            val nd = nodes[i]
            val st = styles[i]
            if st.position_absolute and st.z_index <= 0:
                val x = bx[i]
                val y = by[i]
                val w = bw[i]
                val h = bh[i]
                val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
                val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
                val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
                val visible_box = visible_node and nd.tag != "#text" and y < fbh
                val non_widget_mode = not widget_mode
                if visible_box:
                    val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32))
                    val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
                    val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
                    val paint_shadow = not skip_widget_node_bg and st.box_shadow_color != 0u32
                    if paint_shadow or paint_bg or paint_border or paint_outline:
                        val clip = paint_clip_at(clip_cache, i)
                        if paint_shadow:
                            out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                        if paint_bg:
                            out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                        if paint_border:
                            out = fb_border_sides_clip(out, fbw, fbh, x, y, w, h, st.border_l, st.border_t, st.border_r, st.border_b, st.border_color_l, st.border_color_t, st.border_color_r, st.border_color_b, clip)
                        if paint_outline:
                            out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
                if non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
                    val panel_h = h
                    if st.bg == 0u32 and st.background_gradient_from == 0u32:
                        out = fb_rect(out, fbw, fbh, x, y, w, panel_h, argb(245, 245, 245))
                    if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                        out = fb_rect(out, fbw, fbh, x, y, w, 1, argb(0, 102, 204))
                if non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
                    if st.bg == 0u32 and st.background_gradient_from == 0u32:
                        out = fb_rect(out, fbw, fbh, x, y, w, h, argb(203, 213, 225))
            elif st.position_absolute and st.z_index > 0:
                if positive_z_count == 0 and positive_z_indices.len() == 0:
                    positive_z_indices = [0; node_count]
                val current_positive_z = st.z_index
                if positive_z_count > 0 and current_positive_z < last_positive_z:
                    positive_z_sorted = false
                last_positive_z = current_positive_z
                positive_z_indices[positive_z_count] = i
                positive_z_count = positive_z_count + 1
            i = i + 1
    if positive_z_count > 0:
        if not positive_z_sorted:
            positive_z_indices = _sort_positive_z_indices(positive_z_indices, positive_z_count, styles)
        var positive_z_pos = 0
        # cpu-lane-loop-ok: fn paint pass 4 of 6: the positive-z absolute boxes gathered by pass 3, walked in z-sorted order. Bound is positive_z_count (absolute nodes with z-index > 0), not node_count
        while positive_z_pos < positive_z_count:
            # Budget guard: stop painting positive-z absolute boxes on expiry.
            # positive_z_count bounds this pass below node_count, so it is not
            # runaway the way passes 1-3 were -- but "bounded" is not "free":
            # every iteration walks content_paint_hidden_by_ancestor and can
            # rasterise a shadow/gradient, and passes 5 (scrollbars) and 6
            # (text) run AFTER it. Leaving this one pass unguarded is exactly
            # how a truncated render loses its text and still reports success,
            # so it names its site like the other five rather than being the
            # single silent exit in the family.
            if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_ABSOLUTE_HIGH_Z):
                break
            i = positive_z_indices[positive_z_pos]
            val nd = nodes[i]
            val st = styles[i]
            val x = bx[i]
            val y = by[i]
            val w = bw[i]
            val h = bh[i]
            val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
            val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
            val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
            val visible_box = visible_node and nd.tag != "#text" and y < fbh
            val non_widget_mode = not widget_mode
            if visible_box:
                val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32))
                val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
                val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
                val paint_shadow = not skip_widget_node_bg and st.box_shadow_color != 0u32
                if paint_shadow or paint_bg or paint_border or paint_outline:
                    val clip = paint_clip_at(clip_cache, i)
                    if paint_shadow:
                        out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_bg:
                        out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_border:
                        out = fb_border_sides_clip(out, fbw, fbh, x, y, w, h, st.border_l, st.border_t, st.border_r, st.border_b, st.border_color_l, st.border_color_t, st.border_color_r, st.border_color_b, clip)
                    if paint_outline:
                        out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
            if non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
                val panel_h = h
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, panel_h, argb(245, 245, 245))
                if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, 1, argb(0, 102, 204))
            if non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, h, argb(203, 213, 225))
            positive_z_pos = positive_z_pos + 1
    if widget_mode:
        val widget_button_w = if fbw > 10: fbw - 10 else: fbw
        val widget_button_inner_w = if fbw > 12: fbw - 12 else: widget_button_w
        out = fb_rect(out, fbw, fbh, 0, 0, fbw, 1, argb(0, 102, 204))
        out = fb_rect(out, fbw, fbh, 0, fbh - 1, fbw, 1, argb(0, 102, 204))
        out = fb_rect(out, fbw, fbh, 0, 0, 1, fbh, argb(0, 102, 204))
        out = fb_rect(out, fbw, fbh, fbw - 1, 0, 1, fbh, argb(0, 102, 204))
        out = fb_rect(out, fbw, fbh, 5, 32, 24, 16, argb(37, 99, 235))
        out = fb_rect(out, fbw, fbh, 8, 36, 8, 7, argb(245, 158, 11))
        out = fb_rect(out, fbw, fbh, 18, 37, 8, 6, argb(34, 197, 94))
        out = fb_rect(out, fbw, fbh, 5, 50, widget_button_w, 16, argb(100, 116, 139))
        out = fb_rect(out, fbw, fbh, 6, 51, widget_button_inner_w, 14, argb(203, 213, 225))
        out = fb_rect(out, fbw, fbh, 10, 55, 6, 6, argb(37, 99, 235))
        if fbh <= 66:
            out = fb_rect(out, fbw, fbh, 1, fbh - 1, 4, 1, argb(245, 245, 245))
            out = fb_rect(out, fbw, fbh, fbw - 5, fbh - 1, 4, 1, argb(245, 245, 245))
    if not widget_mode:
        i = 0
        # cpu-lane-loop-ok: fn paint pass 5 of 6: vertical scrollbar chrome for overflow-auto-y scrollports, painted above box content and below text. Bound is node_count, non-widget mode only, budget-guarded
        while i < node_count:
            # Budget guard: stop drawing scrollbars on expiry. This loop sits
            # between two already-guarded passes (backgrounds above, text below)
            # but was itself unbounded — on a large real page it could silently
            # burn the entire remaining paint slice walking content_hidden_by_ancestor
            # for every node before the text pass ever got a chance to run.
            if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_SCROLLBARS):
                break
            val nd = nodes[i]
            val st = styles[i]
            if st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i) and nd.tag != "#text" and st.overflow_auto_y and st.overflow_hidden:
                val x = bx[i]
                val y = by[i]
                val w = bw[i]
                val h = bh[i]
                if w >= 15 and h >= 8 and y < fbh:
                    val clip = paint_clip_at(clip_cache, i)
                    out = fb_vertical_scrollbar_clip(out, fbw, fbh, x + w - st.border_r - 15, y + st.border_t, h - st.border_t - st.border_b, st.scrollbar_track_color, st.scrollbar_thumb_color, clip)
            i = i + 1
    # Text is the actually-visible content: restore the full paint-stage
    # deadline (undoing the halving above) so the text pass gets whatever
    # time is left, instead of sharing what the structural passes didn't use.
    _web_budget_rearm(paint_deadline_us)
    # text on top
    i = 0
    # cpu-lane-loop-ok: fn paint pass 6 of 6: the content-on-top pass - #text runs, input accent controls, input text, widget image placeholders and icon chips. Bound is node_count; text must paint after every box pass, so this cannot be fused into them
    while i < node_count:
        # Budget guard: stop drawing text on expiry; painted pixels are kept.
        if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_TEXT):
            break
        val nd = nodes[i]
        val st = styles[i]
        val x = bx[i]
        val y = by[i]
        val w = bw[i]
        val h = bh[i]
        val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
        val non_widget_mode = not widget_mode
        if non_widget_mode and visible_node and nd.tag == "input" and input_uses_accent_color(nd):
            val clip = paint_clip_at(clip_cache, i)
            out = fb_input_accent_control_clip(
                out, fbw, fbh, x, y, w, h,
                attr_value(nd.attrs_raw, "type").trim().lower(),
                input_is_checked(nd), st.accent_color, clip
            )
        if non_widget_mode and visible_node and nd.tag == "img" and nd.has_widget_image_class:
            val clip = paint_clip_at(clip_cache, i)
            out = fb_widget_image_placeholder_clip(out, fbw, fbh, x, y, w, h, st.object_fit, st.object_position, clip)
        if non_widget_mode and visible_node and nd.has_icon_image_class:
            val clip = paint_clip_at(clip_cache, i)
            val icon_color = if st.bg != 0u32: st.bg else: argb(37, 99, 235)
            out = fb_rect_clip(out, fbw, fbh, x, y, 6, 6, icon_color, clip)
        if (
            non_widget_mode and visible_node and nd.tag == "input" and
            not input_uses_accent_color(nd) and input_paints_text(nd)
        ):
            val scale = glyph_scale(st.font_size)
            val adv = style_text_advance(st)
            val space_adv = style_space_advance(st)
            val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
            if content_w > 0:
                val glyph_advance = if adv > 0: adv else: 1
                val max_glyphs = content_w / glyph_advance + 1
                val plan = input_text_paint_plan(
                    nd, st, x, y, w, h, paint_clip_at(clip_cache, i),
                    max_glyphs
                )
                if plan.text_value != "" and plan.baseline_y < fbh:
                    if st.text_shadow_color != 0u32:
                        out = fb_text_thin_scaled_clip_range(
                            out, fbw, fbh,
                            plan.baseline_x + st.text_shadow_x_px,
                            plan.baseline_y + st.text_shadow_y_px,
                            plan.text_value, 0, plan.text_value.len(),
                            st.text_shadow_color, scale, adv, space_adv,
                            st.font_style_italic, plan.clip
                        )
                    out = fb_text_thin_scaled_clip_range(
                        out, fbw, fbh, plan.baseline_x, plan.baseline_y,
                        plan.text_value, 0, plan.text_value.len(), plan.color,
                        scale, adv, space_adv, st.font_style_italic, plan.clip
                    )
        if visible_node and nd.tag == "#text":
            # Match the layout measure: white-space:pre/nowrap preserves raw text
            # (leading indentation), normal flow uses trimmed text.
            val raw_txt: text = if st.white_space_nowrap: nd.text_data else: nd.text_trimmed
            val transformed_txt = apply_text_transform_for_paint(raw_txt, st.text_transform)
            val txt = if st.direction_rtl: reverse_text_for_paint(transformed_txt) else: transformed_txt
            if txt.len() > 0 and y < fbh:
                val lh = style_line_h(st)
                val node_starts = wrap_cache.starts[i]
                val node_ends = wrap_cache.ends[i]
                val line_count = node_starts.len()
                if not chrome_widget_text:
                    if widget_mode:
                        val text_x = x + 8
                        var ly = y + 7
                        var line_i = 0
                        # cpu-lane-loop-ok: per-wrapped-line glyph emission for one #text node on the widget-chrome path; bound is line_count from the wrap cache and it stops early at ly >= fbh, so it is bounded by the visible lines of one node. The four sparse_* advance values at the top of the body are st-invariant and hoistable - recorded as a perf finding, not a shape defect
                        while line_i < line_count and ly < fbh:
                            val sparse_advance = 6 + st.letter_spacing_px
                            val sparse_stride = if sparse_advance > 0: sparse_advance else: 1
                            val sparse_space_advance = sparse_stride / 2 + st.word_spacing_px
                            val sparse_space_stride = if sparse_space_advance > 0: sparse_space_advance else: 1
                            val draw_txt = if st.text_overflow_ellipsis and line_i == 0: ellipsize_text_for_width(txt, node_starts[line_i], node_ends[line_i], w - st.text_indent_px, st, sparse_stride, sparse_space_stride) else: txt
                            val draw_start = if st.text_overflow_ellipsis and line_i == 0: 0 else: node_starts[line_i]
                            val draw_end = if st.text_overflow_ellipsis and line_i == 0: draw_txt.len() else: node_ends[line_i]
                            val line_base_x = if line_i == 0: text_x + st.text_indent_px else: text_x
                            val line_box_w = if line_i == 0: w - st.text_indent_px else: w
                            val line_w = if text_line_needs_paint_width(st, line_i, line_count): text_line_advance_width(draw_txt, draw_start, draw_end, sparse_stride, sparse_space_stride) else: 0
                            val line_text_x = text_line_aligned_x(line_base_x, line_box_w, line_w, st, line_i, line_count)
                            if st.text_shadow_color != 0u32:
                                out = fb_text_sparse_range(out, fbw, fbh, line_text_x + st.text_shadow_x_px, ly + st.text_shadow_y_px, draw_txt, draw_start, draw_end, st.text_shadow_color, sparse_stride, sparse_space_stride, st.font_style_italic)
                            out = fb_text_sparse_range(out, fbw, fbh, line_text_x, ly, draw_txt, draw_start, draw_end, st.fg, sparse_stride, sparse_space_stride, st.font_style_italic)
                            if st.text_decoration_underline or st.text_decoration_overline or st.text_decoration_line_through:
                                val underline_w = line_w
                                val underline_color = if st.text_decoration_color != 0u32: st.text_decoration_color else: st.fg
                                # One rule primitive, three y positions. Each is
                                # independent so combinations paint together.
                                if st.text_decoration_underline:
                                    out = fb_text_underline(out, fbw, fbh, line_text_x, ly + 8 + st.text_underline_offset_px, underline_w, st.text_decoration_thickness_px, st.text_decoration_style, underline_color)
                                if st.text_decoration_overline:
                                    out = fb_text_underline(out, fbw, fbh, line_text_x, ly, underline_w, st.text_decoration_thickness_px, st.text_decoration_style, underline_color)
                                if st.text_decoration_line_through:
                                    out = fb_text_underline(out, fbw, fbh, line_text_x, ly + 4, underline_w, st.text_decoration_thickness_px, st.text_decoration_style, underline_color)
                            line_i = line_i + 1
                            ly = ly + lh
                    else:
                        val scale = glyph_scale(st.font_size)
                        val adv = style_text_advance(st)
                        val space_adv = style_space_advance(st)
                        val text_x = x + text_ink_x_offset(st.font_size)
                        var ly = y + text_ink_y_offset(st.font_size)
                        if line_count > 0:
                            val clip = paint_clip_at(clip_cache, i)
                            # ONE advance table for this run, built from the
                            # metrics LAYOUT measured it with, and handed to
                            # both the aligned-width call and the glyph walk
                            # below so the two cannot disagree.
                            val txt_by = style_run_byte_advances(st, txt)
                            var line_i = 0
                            # cpu-lane-loop-ok: per-wrapped-line glyph emission for one #text node on the normal path; bound is line_count from the wrap cache and it stops early at ly >= fbh; scale/adv/space_adv are already hoisted above the loop
                            while line_i < line_count and ly < fbh:
                                val draw_txt = if st.text_overflow_ellipsis and line_i == 0: ellipsize_text_for_width(txt, node_starts[line_i], node_ends[line_i], w - st.text_indent_px, st, adv, space_adv) else: txt
                                val draw_start = if st.text_overflow_ellipsis and line_i == 0: 0 else: node_starts[line_i]
                                val draw_end = if st.text_overflow_ellipsis and line_i == 0: draw_txt.len() else: node_ends[line_i]
                                val line_base_x = if line_i == 0: text_x + st.text_indent_px else: text_x
                                val line_box_w = if line_i == 0: w - st.text_indent_px else: w
                                val line_by = if st.text_overflow_ellipsis and line_i == 0: [] else: txt_by
                                val line_w = if text_line_needs_paint_width(st, line_i, line_count): style_text_line_advance_width_with(line_by, draw_txt, draw_start, draw_end, adv, space_adv) else: 0
                                val line_text_x = text_line_aligned_x(line_base_x, line_box_w, line_w, st, line_i, line_count)
                                if st.text_shadow_color != 0u32:
                                    out = fb_text_thin_scaled_clip_range_adv(out, fbw, fbh, line_text_x + st.text_shadow_x_px, ly + st.text_shadow_y_px, draw_txt, draw_start, draw_end, st.text_shadow_color, scale, adv, space_adv, st.font_style_italic, clip, line_by)
                                out = fb_text_thin_scaled_clip_range_adv(out, fbw, fbh, line_text_x, ly, draw_txt, draw_start, draw_end, st.fg, scale, adv, space_adv, st.font_style_italic, clip, line_by)
                                if st.text_decoration_underline or st.text_decoration_overline or st.text_decoration_line_through:
                                    val underline_w = line_w
                                    val underline_y = ly + 7 * scale + st.text_underline_offset_px
                                    val underline_color = if st.text_decoration_color != 0u32: st.text_decoration_color else: st.fg
                                    if st.text_decoration_underline:
                                        out = fb_text_underline_clip(out, fbw, fbh, line_text_x, underline_y, underline_w, st.text_decoration_thickness_px * scale, st.text_decoration_style, underline_color, clip)
                                    if st.text_decoration_overline:
                                        out = fb_text_underline_clip(out, fbw, fbh, line_text_x, ly, underline_w, st.text_decoration_thickness_px * scale, st.text_decoration_style, underline_color, clip)
                                    if st.text_decoration_line_through:
                                        out = fb_text_underline_clip(out, fbw, fbh, line_text_x, ly + 4 * scale, underline_w, st.text_decoration_thickness_px * scale, st.text_decoration_style, underline_color, clip)
                                line_i = line_i + 1
                                ly = ly + lh
        i = i + 1
    if chrome_widget_text:
        out = fb_generated_widget_chrome_text(out, fbw, fbh)
    # Captured-Chromium overlays are not applied here: they paste expected
    # pixels instead of proving renderer behavior. Residual AA divergence vs a
    # browser font rasterizer is tracked as known-divergent in the manifest gate.
    out

# ---------------------------------------------------------------------------
# Tiled paint lane (T2 of tile_render_culling_plan): op-level culling on the
# 256px tile core, then rasterization through the unmodified paint(), so the
# surviving output is pixel-identical to the classic painter by construction.
# Gated by SIMPLE_WEB_TILE_PAINT at the render-entry dispatch site (default
# off; flag-off never enters this function).
# ---------------------------------------------------------------------------

fn _tile_style_hash(st: Style) -> i64:
    var h = st.bg as i64
    h = h ^ ((st.fg as i64) << 16)
    h = h ^ ((st.border_color_t as i64) << 8)
    h = h ^ ((st.opacity_pct as i64) << 48)
    h

fn _tile_abs_i32(v: i32) -> i32:
    if v < 0: -v else: v

fn _tile_hidden_op(i: i32) -> TileOp:
    tile_op(0, i, 0, 0, 0, 0, true, false, 0, -1)

# Culling record for one node's box-phase paint (backgrounds, borders,
# outlines, shadows, widget panel/button fills). Mirrors the per-pass
# predicates of paint() — the same visibility checks, not a reimplementation
# of different ones — and inflates the rect for paint that lands outside the
# border box (outline offset, box shadow). Non-widget path only: paint_tiled
# falls back to paint() for widget_mode.
fn _tile_box_op(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    clip_cache: PaintClipCache, fbh: i32, i: i32, has_widget_panel: bool
) -> TileOp:
    val nd = nodes[i]
    val st = styles[i]
    val x = bx[i]
    val y = by[i]
    val w = bw[i]
    val h = bh[i]
    val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
    val visible_node = (
        st.display != "none" and not st.visibility_hidden and
        not content_paint_hidden_by_ancestor(nodes, styles, i)
    )
    val visible_box = visible_node and nd.tag != "#text" and y < fbh
    val paint_bg = (
        not skip_widget_page_bg and
        (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32))
    )
    val paint_border = st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0
    val paint_outline = st.outline_w > 0 and st.outline_color != 0u32
    val paint_shadow = st.box_shadow_color != 0u32
    val paint_body_radial = skip_widget_page_bg and nd.tag == "body" and st.bg_layers_raw != ""
    val paint_panel = (
        visible_node and y < fbh and
        (nd.has_widget_panel_class or nd.has_widget_button_class) and
        st.bg == 0u32 and st.background_gradient_from == 0u32
    )
    val paints = (
        (visible_box and (paint_bg or paint_border or paint_outline or paint_shadow or paint_body_radial)) or
        paint_panel
    )
    if not paints:
        return _tile_hidden_op(i)
    var ix0 = x
    var iy0 = y
    var ix1 = x + w
    var iy1 = y + h
    if paint_outline:
        val o = st.outline_w + _tile_abs_i32(st.outline_offset_px)
        ix0 = ix0 - o
        iy0 = iy0 - o
        ix1 = ix1 + o
        iy1 = iy1 + o
    if paint_shadow:
        val spread = _tile_abs_i32(st.box_shadow_x_px) + _tile_abs_i32(st.box_shadow_y_px) + st.box_shadow_blur_px + 8
        ix0 = ix0 - spread
        iy0 = iy0 - spread
        ix1 = ix1 + spread
        iy1 = iy1 + spread
    # Panel/button fills paint through fb_rect (no clip); everything else
    # honors the ancestor clip, so clip-intersecting the rect keeps the bins
    # tight while staying conservative.
    if not paint_panel:
        val clip = paint_clip_at(clip_cache, i)
        if ix0 < clip.x0:
            ix0 = clip.x0
        if iy0 < clip.y0:
            iy0 = clip.y0
        if ix1 > clip.x1:
            ix1 = clip.x1
        if iy1 > clip.y1:
            iy1 = clip.y1
    # T3 opaque-occluder candidate: a plain full-alpha color fill over the
    # whole border box, nothing translucent/rounded/offset about it.
    val opaque = (
        visible_box and paint_bg and not paint_panel and
        not paint_shadow and not paint_outline and not paint_border and
        not paint_body_radial and
        st.background_gradient_from == 0u32 and st.background_gradient_to == 0u32 and
        st.bg_layers_raw == "" and st.background_image_uri == "" and
        st.background_clip == "border-box" and
        st.border_radius_px == 0 and st.border_radius_tl_px == 0 and
        st.border_radius_tr_px == 0 and st.border_radius_br_px == 0 and
        st.border_radius_bl_px == 0 and
        st.opacity_pct >= 100 and (((st.bg as i64) >> 24) & 255) == 255
    )
    tile_op(0, i, ix0, iy0, ix1 - ix0, iy1 - iy0, false, opaque, _tile_style_hash(st), -1)

# Culling record for one node's content-on-top phase (the text pass): #text
# runs, input text/accent controls, widget image placeholders, icon chips.
# Text may overflow its layout box horizontally (nowrap, ellipsis, spacing),
# so #text ops use a conservative full-clip-width band around the box's y
# range instead of the exact box rect.
fn _tile_text_op(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    clip_cache: PaintClipCache, fbh: i32, i: i32
) -> TileOp:
    val nd = nodes[i]
    val st = styles[i]
    val visible_node = (
        st.display != "none" and not st.visibility_hidden and
        not content_paint_hidden_by_ancestor(nodes, styles, i)
    )
    if not visible_node:
        return _tile_hidden_op(i)
    if nd.tag == "#text":
        val raw_txt: text = if st.white_space_nowrap: nd.text_data else: nd.text_trimmed
        if raw_txt.len() == 0 or by[i] >= fbh:
            return _tile_hidden_op(i)
        val clip = paint_clip_at(clip_cache, i)
        val overhang = 16 + _tile_abs_i32(st.text_shadow_y_px) + _tile_abs_i32(st.text_underline_offset_px)
        var y0 = by[i] - overhang
        var y1 = by[i] + bh[i] + overhang
        if y0 < clip.y0:
            y0 = clip.y0
        if y1 > clip.y1:
            y1 = clip.y1
        return tile_op(
            1, i, clip.x0, y0, clip.x1 - clip.x0, y1 - y0,
            false, false, _tile_style_hash(st), -1
        )
    val is_content = (
        nd.tag == "input" or (nd.tag == "img" and nd.has_widget_image_class) or
        nd.has_icon_image_class
    )
    if not is_content:
        return _tile_hidden_op(i)
    val clip = paint_clip_at(clip_cache, i)
    var x0 = bx[i] - 8
    var y0 = by[i] - 8
    var x1 = bx[i] + bw[i] + 8
    var y1 = by[i] + bh[i] + 8
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    tile_op(1, i, x0, y0, x1 - x0, y1 - y0, false, false, _tile_style_hash(st), -1)

# Emit culling records in paint() order — normal-flow boxes, relative-root
# boxes, absolute z<=0, absolute z>0 (z-sorted), scrollbars, then the text
# pass — so "later op occludes earlier op" in a tile bin matches real paint
# order (text paints after every box and is never occlusion-culled).
fn _tile_paint_ops(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    clip_cache: PaintClipCache, fbh: i32, has_widget_panel: bool
) -> [TileOp]:
    val node_count = nodes.len()
    if node_count <= 0:
        return []
    # Exactly one box and one text slot per node, plus at most one scrollbar.
    # Indexed stores give this hot path a bounded allocation profile regardless
    # of the runtime's bare-push growth strategy; tile_op_buffer_finish performs
    # one final linear trim.
    var ops: [TileOp] = [_tile_hidden_op(0); node_count * 3]
    var op_count = 0
    var i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 1 of 6: emits box culling ops for normal-flow nodes, mirroring fn paint pass 1's node set so tile bin order equals real paint order. Bound is node_count
    while i < node_count:
        val st = styles[i]
        if not st.position_absolute and not has_relative_paint_root(nodes, styles, i):
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i, has_widget_panel)
            op_count = op_count + 1
        i = i + 1
    i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 2 of 6: box ops for relative-paint-root nodes, mirroring fn paint pass 2. Disjoint from pass 1 and must stay a separate later pass so the bins record the true occlusion order
    while i < node_count:
        if has_relative_paint_root(nodes, styles, i) and not styles[i].position_absolute:
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i, has_widget_panel)
            op_count = op_count + 1
        i = i + 1
    i = 0
    var positive_z_indices: [i32] = [0; node_count]
    var positive_z_count = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 3 of 6: box ops for absolute z <= 0 nodes plus collection of the positive-z indices, mirroring fn paint pass 3. Bound is node_count
    while i < node_count:
        val st = styles[i]
        if st.position_absolute and st.z_index <= 0:
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i, has_widget_panel)
            op_count = op_count + 1
        elif st.position_absolute:
            positive_z_indices[positive_z_count] = i
            positive_z_count = positive_z_count + 1
        i = i + 1
    if positive_z_count > 0:
        val sorted_z = _sort_positive_z_indices(positive_z_indices, positive_z_count, styles)
        var zp = 0
        # cpu-lane-loop-ok: _tile_paint_ops pass 4 of 6: box ops for the z-sorted positive-z absolute nodes; bound is positive_z_count, not node_count
        while zp < positive_z_count:
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, sorted_z[zp], has_widget_panel)
            op_count = op_count + 1
            zp = zp + 1
    i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 5 of 6: scrollbar culling ops for overflow-auto-y scrollports, mirroring fn paint pass 5. Bound is node_count
    while i < node_count:
        val nd = nodes[i]
        val st = styles[i]
        if (
            st.overflow_auto_y and st.overflow_hidden and nd.tag != "#text" and
            st.display != "none" and not st.visibility_hidden and
            not content_paint_hidden_by_ancestor(nodes, styles, i) and
            bw[i] >= 15 and bh[i] >= 8 and by[i] < fbh
        ):
            val clip = paint_clip_at(clip_cache, i)
            var sx0 = bx[i] + bw[i] - st.border_r - 15
            var sy0 = by[i]
            var sx1 = bx[i] + bw[i]
            var sy1 = by[i] + bh[i]
            if sx0 < clip.x0:
                sx0 = clip.x0
            if sy0 < clip.y0:
                sy0 = clip.y0
            if sx1 > clip.x1:
                sx1 = clip.x1
            if sy1 > clip.y1:
                sy1 = clip.y1
            ops[op_count] = tile_op(2, i, sx0, sy0, sx1 - sx0, sy1 - sy0, false, false, _tile_style_hash(st), -1)
            op_count = op_count + 1
        i = i + 1
    i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 6 of 6: one text-phase culling op per node (hidden ops included so op indices stay dense and text is never occlusion-culled). Bound is node_count
    while i < node_count:
        ops[op_count] = _tile_text_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i)
        op_count = op_count + 1
        i = i + 1
    tile_op_buffer_finish(ops, op_count)

fn paint_tiled(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool,
    viewport_y: i32, viewport_h: i32
) -> [u32]:
    # Widget chrome framebuffers are tiny (< one tile) and use unclipped
    # chrome overdraw; tiling buys nothing there — keep the classic painter.
    if widget_mode:
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode)
    val need_widget_text = false
    val widget_flags = compute_widget_paint_flags(nodes, false, need_widget_text)
    val clip_cache = build_ancestor_clip_cache(nodes, styles, bx, by, bw, bh, fbw, fbh)
    val ops = _tile_paint_ops(
        nodes, styles, bx, by, bw, bh, clip_cache, fbh, widget_flags.has_widget_panel
    )
    val grid = tile_grid_make(0, 0, fbw, fbh)
    val bins = tile_bin_ops(ops, grid)
    val live = tile_live_set(grid, 0, viewport_y, fbw, viewport_h, TILE_MARGIN_PX)
    val surv = tile_survivors(ops, bins, grid, live)
    val node_count = nodes.len()
    var keep: [bool] = [false; node_count]
    var ops_total: i64 = 0
    var ops_painted: i64 = 0
    val op_count = ops.len()
    var oi = 0
    # cpu-lane-loop-ok: folds the emitted culling ops into the per-node keep[] mask and the ops_total/ops_painted tile stats; bound is op_count (about 6 ops per node), one linear fold
    while oi < op_count:
        val op = ops[oi]
        if not op.hidden:
            ops_total = ops_total + 1
            if surv[oi]:
                ops_painted = ops_painted + 1
                keep[op.node] = true
        oi = oi + 1
    val tiles = tile_count(grid)
    var tiles_live: i64 = 0
    var tiles_occluded: i64 = 0
    var t = 0
    # cpu-lane-loop-ok: counts live and occluded tiles for tile_stats_record; bound is tile_count(grid) = ceil(fbw/256) * ceil(fbh/256) tiles, not pixels or elements
    while t < tiles:
        if live[t]:
            tiles_live = tiles_live + 1
            if tile_occluder_slot(ops, bins, grid, t) > bins.starts[t]:
                tiles_occluded = tiles_occluded + 1
        t = t + 1
    tile_stats_record(
        ops_total, ops_painted, tiles as i64, tiles_live,
        (tiles as i64) - tiles_live, tiles_occluded
    )
    # Cull by marking non-survivors visibility:hidden for the duration of the
    # paint: that suppresses exactly the node's own paint in every paint()
    # pass without touching pass structure, clip cache, z-order, or sibling
    # paint — then the unmodified paint() rasters the survivors, so surviving
    # output is identical to the untiled painter by construction. Original
    # values are restored afterwards in case Style is shared by reference.
    var culled_styles = styles
    var prev_hidden: [bool] = [false; node_count]
    var ci = 0
    # cpu-lane-loop-ok: marks non-surviving nodes visibility:hidden so the unmodified paint() skips them; single O(node_count) pass over the style array
    while ci < node_count:
        prev_hidden[ci] = culled_styles[ci].visibility_hidden
        if not keep[ci]:
            var cst = culled_styles[ci]
            cst.visibility_hidden = true
            culled_styles[ci] = cst
        ci = ci + 1
    var out = paint(nodes, culled_styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, false)
    ci = 0
    # cpu-lane-loop-ok: restores the visibility_hidden values saved by the cull pass above; single O(node_count) pass, paired one-to-one with it
    while ci < node_count:
        if culled_styles[ci].visibility_hidden != prev_hidden[ci]:
            var rst = culled_styles[ci]
            rst.visibility_hidden = prev_hidden[ci]
            culled_styles[ci] = rst
        ci = ci + 1
    out

# =========================================================================
# `contain: paint` fast path for paint_selected. See containment.spl for
# why this reads the attribute the same array/index-positional way as the
# `contain: layout` lane in simple_web_html_layout_renderer_layout.spl
# (node_contain_layout / layout_contain_boundary / layout_selected there),
# rather than reusing that file's Dict-keyed cache.
#
# CSS semantics: a `contain: paint` node promises nothing inside its
# subtree paints outside its own border box (no overflow, no escaping
# absolutely-positioned descendants, no bleeding filters/shadows). That
# licenses the fast path below to repaint ONLY the contained subtree's
# nodes and leave every pixel outside it exactly as it was in the
# retained framebuffer -- it does NOT license the converse (nothing
# outside paints INTO the boundary's box area is not a CSS guarantee: a
# sibling with a higher z-index can still visually overlap it), so
# correctness never depends on that converse: the fast path only ever
# SUPPRESSES nodes strictly outside the boundary subtree from repainting
# (leaving their previously-painted pixels untouched); it never claims
# the boundary's screen region belongs exclusively to the subtree.
# =========================================================================

fn node_contain_paint(node: HNode) -> bool:
    contain_value_contains_paint(attr_value(node.attrs_raw, "contain"))

fn nearest_contain_paint_ancestor(nodes: [HNode], idx: i32) -> i32:
    var cur = nodes[idx].parent as i32
    while cur >= 0:
        if node_contain_paint(nodes[cur]):
            return cur
        cur = nodes[cur].parent as i32
    -1

# Nearest `contain: paint` ancestor shared by every dirty structural id.
# Same conservative all-or-nothing restriction as layout_contain_boundary:
# a mutation batch touching two different contained subtrees, or one that
# isn't contained at all, falls straight through to a full repaint below
# rather than attempting a partial region reuse.
fn paint_contain_boundary(nodes: [HNode], dirty_structural_ids: [i64]) -> i32:
    val node_count = nodes.len() as i32
    var boundary: i32 = -1
    var first = true
    for structural_id in dirty_structural_ids:
        val idx = (structural_id - 1) as i32
        if idx < 0 or idx >= node_count:
            return -1
        val b = nearest_contain_paint_ancestor(nodes, idx)
        if b < 0:
            return -1
        if first:
            boundary = b
            first = false
        elif b != boundary:
            return -1
    boundary

# True when node `i` is `boundary` itself or a descendant of it (walks the
# parent chain). Used to decide which nodes the fast path is allowed to
# repaint; every other node is suppressed via the same visibility_hidden
# trick paint_tiled already uses for tile culling (see paint_tiled above),
# so the unmodified `paint()` raster loop performs zero drawing work for
# them -- this is the actual "paint work skipped" the containment feature
# buys, not merely a trust-the-attribute shortcut.
fn node_in_paint_subtree(nodes: [HNode], boundary: i32, i: i32) -> bool:
    if i == boundary:
        return true
    var cur = nodes[i].parent as i32
    while cur >= 0:
        if cur == boundary:
            return true
        cur = nodes[cur].parent as i32
    false

fn paint_contain_subtree_members(nodes: [HNode], boundary: i32) -> [bool]:
    """Build the containment mask once for a retained repaint.

    The canonical parse_html HNode arena places parents before children, so
    membership is inherited in one forward pass rather than walking a parent
    chain for every node. Malformed/non-topological input retains the old exact
    chain walk, preserving the fast path's conservative behaviour.
    """
    var members: [bool] = []
    var i = 0
    while i < nodes.len():
        var inside = i == boundary
        if not inside:
            val parent = nodes[i].parent as i32
            if parent >= 0 and parent < i:
                inside = members[parent]
            elif parent >= 0:
                inside = node_in_paint_subtree(nodes, boundary, i)
        members.push(inside)
        i += 1
    members

fn paint_contain_subtree_node_count(nodes: [HNode], boundary: i32) -> i32:
    val members = paint_contain_subtree_members(nodes, boundary)
    var total = 0
    var i = 0
    while i < members.len():
        if members[i]:
            total = total + 1
        i = i + 1
    total

pub fn paint_contain_boundary_subtree_size(nodes: [HNode], dirty_structural_ids: [i64]) -> i32:
    """Public probe for the correctness/proportionality spec: the count of
    nodes the fast path actually re-runs paint work for, or the full node
    count when no `contain: paint` boundary covers the dirty set (i.e. no
    savings claimed, matching layout_contain_boundary_subtree_size)."""
    val boundary = paint_contain_boundary(nodes, dirty_structural_ids)
    if boundary < 0:
        return nodes.len() as i32
    paint_contain_subtree_node_count(nodes, boundary)

pub fn paint_selected(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    wrap_cache: TextWrapCache, retained_fb: [u32], retained_bw: i32, retained_bh: i32,
    fbw: i32, fbh: i32, widget_mode: bool, dirty_structural_ids: [i64]
) -> [u32]:
    """Incremental repaint entry point, mirroring layout_selected's shape.
    `retained_fb` is the pixel buffer produced by the last full (or fast-
    path) paint of this same document at size fbw x fbh; `retained_bw` /
    `retained_bh` are the `contain: paint` boundary candidate's own box
    dimensions AT THAT TIME. `dirty_structural_ids` (1-based, matching
    layout_selected's convention) lists every node whose content changed
    since then.

    Correctness does not rely on trusting the `contain: paint` attribute:
    the boundary's freshly recomputed box (bw[boundary]/bh[boundary]) is
    compared against `retained_bw`/`retained_bh` below, and any mismatch
    (a lying/violating `contain: paint`, or the boundary having moved or
    resized for any other reason since the retained frame) falls through
    to the unconditional full repaint, so this fast path can only ever
    produce output identical to `paint(...)`, never wrong output."""
    if dirty_structural_ids.len() == 0:
        return retained_fb
    if (
        nodes.len() != styles.len() or bx.len() != nodes.len() or
        by.len() != nodes.len() or bw.len() != nodes.len() or bh.len() != nodes.len() or
        retained_fb.len() != fbw * fbh
    ):
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)
    for structural_id in dirty_structural_ids:
        if structural_id <= 0 or structural_id > nodes.len():
            return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)

    val boundary = paint_contain_boundary(nodes, dirty_structural_ids)
    if boundary < 0:
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)
    if bw[boundary] != retained_bw or bh[boundary] != retained_bh:
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)

    val node_count = nodes.len()
    val subtree_members = paint_contain_subtree_members(nodes, boundary)
    var culled_styles = styles
    var i = 0
    # cpu-lane-loop-ok: suppresses every node outside the contain:paint
    # boundary subtree so the unmodified paint() call below performs no
    # raster work for them; bound is node_count, one linear pass
    while i < node_count:
        if not subtree_members[i]:
            var cst = culled_styles[i]
            cst.visibility_hidden = true
            culled_styles[i] = cst
        i = i + 1
    paint(nodes, culled_styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)

