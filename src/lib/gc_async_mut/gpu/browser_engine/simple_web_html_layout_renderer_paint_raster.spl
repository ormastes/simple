fn _paint_node_border(out: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, nd: HNode, st: Style, clip: ClipRect) -> [u32]:
    val is_ua_bordered = nd.tag == "hr" or nd.tag == "fieldset"
    val st_t = if is_ua_bordered and st.border_style_t == "none" and st.border_t > 0: "solid" else: st.border_style_t
    val st_b = if is_ua_bordered and st.border_style_b == "none" and st.border_b > 0: "solid" else: st.border_style_b
    fb_border_sides_styled_clip(
        out, fbw, fbh, x, y, w, h,
        st.border_l, st.border_t, st.border_r, st.border_b,
        st.border_color_l, st.border_color_t, st.border_color_r, st.border_color_b,
        st.border_style_l, st_t, st.border_style_r, st_b,
        st.border_radius_tl_px, st.border_radius_tr_px, st.border_radius_br_px, st.border_radius_bl_px,
        clip
    )

fn _paint_svg_round_milli(value: i64) -> i32:
    if value >= 0:
        return ((value + 500) / 1000).to_i32()
    (0 - ((0 - value + 500) / 1000)).to_i32()

fn _fb_paint_svg_rects_clip(out: [u32], fbw: i32, fbh: i32, nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], i: i32, clip: ClipRect) -> [u32]:
    val nd = nodes[i]
    val st = styles[i]
    val box_x = bx[i] + st.border_l + st.pad_l
    val box_y = by[i] + st.border_t + st.pad_t
    val box_w = bw[i] - st.border_l - st.border_r - st.pad_l - st.pad_r
    val box_h = bh[i] - st.border_t - st.border_b - st.pad_t - st.pad_b
    if box_w <= 0 or box_h <= 0:
        return out
    val svg_clip = clip_intersect(clip, box_x, box_y, box_x + box_w, box_y + box_h)
    if svg_clip.x1 <= svg_clip.x0 or svg_clip.y1 <= svg_clip.y0:
        return out
    var view_x: i64 = 0
    var view_y: i64 = 0
    var scale_num: i64 = 1
    var scale_den: i64 = 1
    var offset_x: i64 = 0
    var offset_y: i64 = 0
    val view_parts = svg_view_box_milli(nd.attrs_raw)
    if view_parts.len() == 4:
        val view_w = view_parts[2]
        val view_h = view_parts[3]
        view_x = view_parts[0]
        view_y = view_parts[1]
        if box_w.to_i64() * view_h <= box_h.to_i64() * view_w:
            scale_num = box_w.to_i64() * 1000
            scale_den = view_w
        else:
            scale_num = box_h.to_i64() * 1000
            scale_den = view_h
        offset_x = (box_w.to_i64() * 1000 - view_w * scale_num / scale_den) / 2
        offset_y = (box_h.to_i64() * 1000 - view_h * scale_num / scale_den) / 2
    var res = out
    val node_count = nodes.len() as i32
    var j = i + 1
    while j < node_count and nodes[j].parent >= i.to_i64():
        val shape = nodes[j]
        if shape.parent == i.to_i64() and shape.tag == "rect":
            var fill = decl_get(shape.style_attr, "fill").trim()
            if fill == "":
                fill = attr_value(shape.attrs_raw, "fill").trim()
            val color = if fill == "":
                web_argb(0, 0, 0)
            elif fill.lower() == "currentcolor":
                styles[j].fg
            else:
                parse_color(fill)
            val shape_w = svg_number_milli(attr_value(shape.attrs_raw, "width"))
            val shape_h = svg_number_milli(attr_value(shape.attrs_raw, "height"))
            if color != 0u32 and shape_w > 0 and shape_h > 0:
                val shape_x = svg_number_milli(attr_value(shape.attrs_raw, "x"))
                val shape_y = svg_number_milli(attr_value(shape.attrs_raw, "y"))
                var radius_raw = attr_value(shape.attrs_raw, "rx")
                if radius_raw == "":
                    radius_raw = attr_value(shape.attrs_raw, "ry")
                val x0 = box_x + _paint_svg_round_milli((shape_x - view_x) * scale_num / scale_den + offset_x)
                val y0 = box_y + _paint_svg_round_milli((shape_y - view_y) * scale_num / scale_den + offset_y)
                val x1 = box_x + _paint_svg_round_milli((shape_x + shape_w - view_x) * scale_num / scale_den + offset_x)
                val y1 = box_y + _paint_svg_round_milli((shape_y + shape_h - view_y) * scale_num / scale_den + offset_y)
                val rad = _paint_svg_round_milli(svg_number_milli(radius_raw) * scale_num / scale_den)
                if x1 > x0 and y1 > y0:
                    res = fb_rounded_rect_corners_opacity_clip(res, fbw, fbh, x0, y0, x1 - x0, y1 - y0, rad, rad, rad, rad, color, st.opacity_pct, svg_clip)
        j = j + 1
    res

fn _paint_shadow_pad(st: Style) -> i32:
    var pad = _tile_abs_i32(st.box_shadow_x_px) + _tile_abs_i32(st.box_shadow_y_px) + st.box_shadow_blur_px + 8
    if st.box_shadow_raw != "":
        val layers = split_top_level_commas(st.box_shadow_raw)
        for layer in layers:
            if not layer.contains("inset"):
                val prefix = shadow_length_prefix(layer)
                val ox = parse_signed_nth_int(prefix, 0)
                val oy = parse_signed_nth_int(prefix, 1)
                if ox != -1000000 and oy != -1000000:
                    var blur = parse_signed_nth_int(prefix, 2)
                    if blur == -1000000 or blur < 0:
                        blur = 0
                    var sp = parse_signed_nth_int(prefix, 3)
                    if sp == -1000000:
                        sp = 0
                    val sp_pad = if sp > 0: sp else: 0
                    val ext_x = _tile_abs_i32(ox) + blur + sp_pad + 8
                    val ext_y = _tile_abs_i32(oy) + blur + sp_pad + 8
                    if ext_x > pad:
                        pad = ext_x
                    if ext_y > pad:
                        pad = ext_y
    pad

fn has_visible_overflow_clip(styles: [Style]) -> bool:
    var i = 0
    val style_count = styles.len()
    # cpu-lane-loop-ok: existence scan over the style list for any overflow clip; bound is style_count and it returns on the first hit; runs once per paint to decide whether a per-node clip array is needed at all
    while i < style_count:
        val st = styles[i]
        if (st.overflow_hidden or st.overflow_auto_y) and st.display != "none":
            return true
        i = i + 1
    false

fn build_ancestor_clip_cache(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], fbw: i32, fbh: i32) -> PaintClipCache:
    val default_clip = ClipRect(x0: 0, y0: 0, x1: fbw, y1: fbh)
    if not has_visible_overflow_clip(styles):
        return PaintClipCache(has_node_clips: false, default_clip: default_clip, clips: [])
    val node_count = nodes.len()
    var clips: [ClipRect] = [default_clip; node_count]
    var i = 0
    # cpu-lane-loop-ok: single forward pass over the node list building each node's clip from its already-computed parent clip; this loop IS the bulk idiom that replaces a per-node ancestor walk, bound is node_count
    while i < node_count:
        var clip = default_clip
        val p = nodes[i].parent
        if p >= 0:
            clip = clips[p]
            val pst = styles[p]
            if (pst.overflow_hidden or pst.overflow_auto_y) and pst.display != "none":
                val cx0 = bx[p] + pst.border_l
                val cy0 = by[p] + pst.border_t
                val cx1 = bx[p] + bw[p] - pst.border_r
                val cy1 = by[p] + bh[p] - pst.border_b
                clip = clip_intersect(clip, cx0, cy0, cx1, cy1)
        clips[i] = clip
        i = i + 1
    PaintClipCache(has_node_clips: true, default_clip: default_clip, clips: clips)

fn paint_clip_at(cache: PaintClipCache, i: i32) -> ClipRect:
    if cache.has_node_clips:
        return cache.clips[i]
    cache.default_clip

fn has_relative_paint_root(nodes: [HNode], styles: [Style], i: i32) -> bool:
    var cur = i
    # cpu-lane-loop-ok: depth-bounded ancestor walk up nodes[].parent for position:relative; bound is DOM depth, not an element or pixel count, so this is a detector false positive under the bound-based rule of design section 6
    while cur >= 0:
        if styles[cur].position_relative:
            return true
        cur = nodes[cur].parent as i32
    false

fn content_hidden_by_ancestor(nodes: [HNode], styles: [Style], i: i32) -> bool:
    var cur = nodes[i].parent as i32
    # cpu-lane-loop-ok: depth-bounded ancestor walk up nodes[].parent for display:none / content-visibility:hidden / iframe; bound is DOM depth, not an element count, so this is a detector false positive under the bound-based rule
    while cur >= 0:
        # An <iframe> is a replaced element: its DOM subtree (fallback content or
        # any inline children) is NOT laid out or painted in the parent document.
        # The iframe's real content is rendered separately from srcdoc/src and
        # blitted over its box by _web_paint_iframes, so descendants stay hidden.
        if (
            styles[cur].display == "none" or
            styles[cur].content_visibility_hidden or nodes[cur].tag == "iframe"
        ):
            return true
        cur = nodes[cur].parent as i32
    false

fn content_paint_hidden_by_ancestor(
    nodes: [HNode], styles: [Style], i: i32
) -> bool:
    if styles[i].opacity_pct <= 0:
        return true
    var cur = nodes[i].parent as i32
    # cpu-lane-loop-ok: ONE depth-bounded ancestor walk testing both hiding
    # conditions. This used to be TWO walks of the same chain — a
    # content_hidden_by_ancestor call followed by an opacity-only walk — which
    # doubled the traversals of the hottest predicate in paint() (11 call
    # sites, most of them once per node per frame). Bound is DOM depth, not an
    # element count, so this is a detector false positive under the
    # bound-based rule.
    while cur >= 0:
        # An <iframe> is a replaced element: its DOM subtree is NOT laid out or
        # painted in the parent document — see content_hidden_by_ancestor above
        # for the full note.
        if (
            styles[cur].display == "none" or
            styles[cur].content_visibility_hidden or
            nodes[cur].tag == "iframe" or
            styles[cur].opacity_pct <= 0
        ):
            return true
        cur = nodes[cur].parent as i32
    false

fn fb_vertical_scrollbar_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, h: i32, track_color: u32, thumb_color: u32, clip: ClipRect) -> [u32]:
    val track = if track_color != 0u32: track_color else: web_argb(241, 241, 241)
    val thumb = if thumb_color != 0u32: thumb_color else: web_argb(163, 163, 163)
    val thumb_dark = if thumb_color != 0u32: thumb_color else: web_argb(80, 80, 80)
    var out = fb_rect_clip(fb, fbw, fbh, x, y, 15, h, track, clip)
    val mid_x = x + 7
    val up_y = y + 3
    var row = 0
    # cpu-lane-loop-ok: fixed 4-row up-arrow glyph of the scrollbar button; bound is the literal constant 4, not a pixel or element count, so this is a detector false positive
    while row < 4:
        val half = row
        out = fb_rect_clip(out, fbw, fbh, mid_x - half, up_y + row, half * 2 + 1, 1, thumb, clip)
        row = row + 1
    val down_y = y + h - 7
    row = 0
    # cpu-lane-loop-ok: fixed 4-row down-arrow glyph of the scrollbar button; bound is the literal constant 4, not a pixel or element count, so this is a detector false positive
    while row < 4:
        val half = 3 - row
        out = fb_rect_clip(out, fbw, fbh, mid_x - half, down_y + row, half * 2 + 1, 1, thumb_dark, clip)
        row = row + 1
    out

# Placeholder geometry for `<img class="widget-image">` (24x16 intrinsic):
# flat [x, y, w, h] per rect, painted in WIDGET_IMAGE_PLACEHOLDER_COLORS order.
# One source for the CPU raster and the Draw IR producer.
val WIDGET_IMAGE_PLACEHOLDER_COLORS: [u32] = [0xFF2563EBu32, 0xFFF59E0Bu32, 0xFF22C55Eu32]

fn widget_image_placeholder_rects(x: i32, y: i32, w: i32, h: i32, object_fit: text, object_position: text) -> [i32]:
    val intrinsic_w = 24
    val intrinsic_h = 16
    var draw_w = w
    var draw_h = h
    if object_fit == "contain" or object_fit == "scale-down":
        if w * intrinsic_h <= h * intrinsic_w:
            draw_w = w
            draw_h = (w * intrinsic_h) / intrinsic_w
        else:
            draw_h = h
            draw_w = (h * intrinsic_w) / intrinsic_h
    elif object_fit == "cover":
        if w * intrinsic_h >= h * intrinsic_w:
            draw_w = w
            draw_h = (w * intrinsic_h) / intrinsic_w
        else:
            draw_h = h
            draw_w = (h * intrinsic_w) / intrinsic_h
    elif object_fit == "none":
        draw_w = if intrinsic_w < w: intrinsic_w else: w
        draw_h = if intrinsic_h < h: intrinsic_h else: h
    if draw_w <= 0 or draw_h <= 0:
        return []
    val draw_x = x + (((w - draw_w) * object_position_x_pct(object_position)) / 100)
    val draw_y = y + (((h - draw_h) * object_position_y_pct(object_position)) / 100)
    val accent_w = if draw_w >= 8: 8 else: draw_w
    val accent_h = if draw_h >= 7: 7 else: draw_h
    val accent_x = draw_x + if draw_w > 11: 3 else: 0
    val accent_y = draw_y + if draw_h > 11: 4 else: 0
    var rects = [draw_x, draw_y, draw_w, draw_h, accent_x, accent_y, accent_w, accent_h]
    if draw_w >= 21 and draw_h >= 11:
        rects = rects + [draw_x + 13, draw_y + 5, 8, 6]
    rects

fn fb_widget_image_placeholder_clip(fb: [u32], fbw: i32, fbh: i32, x: i32, y: i32, w: i32, h: i32, object_fit: text, object_position: text, clip: ClipRect) -> [u32]:
    val rects = widget_image_placeholder_rects(x, y, w, h, object_fit, object_position)
    var out = fb
    var k = 0
    # cpu-lane-loop-ok: at most 3 placeholder rects
    while k * 4 < rects.len():
        out = fb_rect_clip(out, fbw, fbh, rects[k * 4], rects[k * 4 + 1], rects[k * 4 + 2], rects[k * 4 + 3], WIDGET_IMAGE_PLACEHOLDER_COLORS[k], clip)
        k = k + 1
    out

fn input_uses_accent_color(nd: HNode) -> bool:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    input_type == "checkbox" or input_type == "radio"

fn input_is_checked(nd: HNode) -> bool:
    attr_present(nd.attrs_raw, "checked")

fn input_paints_text(nd: HNode) -> bool:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val declared_value = attr_value(nd.attrs_raw, "value")
    if declared_value != "" and not text_is_valid_utf8(declared_value):
        return false
    input_type == "" or input_type == "text" or input_type == "search" or
        input_type == "url" or input_type == "tel" or
        input_type == "email" or input_type == "password" or
        input_type == "number" or input_type == "button" or
        input_type == "submit" or input_type == "reset"

pub fn input_accepts_text_overlay(nd: HNode) -> bool:
    val disabled_at = attr_key_index(nd.attrs_raw, "disabled", 8)
    if disabled_at >= 0:
        val disabled_end = disabled_at + 8
        if disabled_end >= nd.attrs_raw.byte_len():
            return false
        val after_disabled = nd.attrs_raw.substring(disabled_end, disabled_end + 1)
        if (
            after_disabled == "=" or after_disabled == " " or
            after_disabled == "\t" or after_disabled == "\n" or
            after_disabled == "\r" or after_disabled == "/"
        ):
            return false
    if not text_is_valid_utf8(attr_value(nd.attrs_raw, "value")):
        return false
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    input_type == "" or input_type == "text" or input_type == "search" or
        input_type == "url" or input_type == "tel" or
        input_type == "email" or input_type == "password" or
        input_type == "number"

fn input_text_prefix(value: text, max_glyphs: i32) -> text:
    if max_glyphs <= 0:
        return ""
    if text_codepoint_len(value) <= max_glyphs:
        return value
    val bytes = value.bytes()
    var byte_index: i64 = 0
    var glyph_index: i32 = 0
    # cpu-lane-loop-ok: UTF-8 sequence walk to find the byte offset of the max_glyphs-th glyph so the value can be sliced on a codepoint boundary; bound is min(value bytes, max_glyphs) where max_glyphs is the glyph count that fits the input's content box
    while byte_index < bytes.len() and glyph_index < max_glyphs:
        val sequence_length = utf8_seq_len(bytes[byte_index])
        if sequence_length > 0:
            byte_index = byte_index + sequence_length
        else:
            byte_index = byte_index + 1
        glyph_index = glyph_index + 1
    value.substring(0, byte_index)

# Chrome 159 masks a password value with U+2022 BULLET, one per codepoint
# (computed `-webkit-text-security: disc`; 8px Arial: 2.8px advance, ink in
# the vertical middle of the box, not the top-heavy `*`).
pub val INPUT_PASSWORD_MASK_GLYPH: text = "•"

# Advance of one password mask disc: the face's U+2022 advance at the
# control's font size, rounded to whole px. Chrome 159: 8px Arial 2.80, so
# three discs ink columns 3..10 (the 5x7 cell's 5px put them at 4..16).
# Measured at 10x the size and rounded, like the control-label widths. A
# lane with no resolvable face keeps the bitmap-cell advance.
fn _input_password_mask_advance(st: Style) -> i32:
    val family = browser_font_family_for_style(st.font_family, st.bold, st.font_style_italic)
    val metrics = resolve_font_metrics_with_language(family, INPUT_PASSWORD_MASK_GLYPH, st.font_size * 10, "")
    if not metrics.valid or metrics.width <= 0:
        return style_text_advance(st)
    var out = (metrics.width + 5) / 10 + st.letter_spacing_px
    if out < 1:
        out = 1
    out

# Per-glyph advance an input's painted value steps by: the mask advance for
# a masked password, else the style's flat advance. Every consumer -- the
# raster walk, the measured width, the caret/visual map -- takes it from here
# so they cannot disagree.
# reason: whole-px glyph advance shared by the raster walk, caret map and Draw IR producer
# @allow(primitive_api)
pub fn input_text_glyph_advance(nd: HNode, st: Style) -> i32:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    if input_type == "password" and _input_text_declared_value(nd) != "":
        return _input_password_mask_advance(st)
    style_text_advance(st)

# The whole value is painted; the caller clips it at the content box. Chrome
# 159 keeps an overflowing value intact (scrollWidth 56 for an 11-char 8px
# Arial value in a 36px content box) and clips it, it never truncates it.
fn input_text_for_paint(nd: HNode) -> text:
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val declared_value = attr_value(nd.attrs_raw, "value")
    if not text_is_valid_utf8(declared_value):
        return ""
    var value = declared_value
    if value == "":
        if input_type == "submit":
            value = "Submit"
        elif input_type == "reset":
            value = "Reset"
        else:
            value = attr_value(nd.attrs_raw, "placeholder")
    if input_type == "password" and declared_value != "":
        return INPUT_PASSWORD_MASK_GLYPH.repeat(text_codepoint_len(declared_value))
    value

# Shared resolved input text geometry used by the CPU pixel painter and the
# Draw IR producer. It contains only durable layout semantics: the executor
# receives the final text and clip, never renderer-local font/cache state.
pub struct InputTextPaintPlan:
    text_value: text
    baseline_x: i32
    baseline_y: i32
    measured_width: i32
    clip: ClipRect
    color: u32
    source_window_start_byte: i64
    source_window_end_byte: i64
    source_boundary_bytes: [i64]
    boundary_x_px: [i32]
    selection_present: bool
    selection_rect: ClipRect
    selection_color: u32
    caret_present: bool
    caret_rect: ClipRect
    caret_color: u32
    resolved_view_start_byte: i64

pub struct InputTextVisualMap:
    display_text: text
    source_boundary_bytes: [i64]
    boundary_x_px: [i32]

pub val INPUT_TEXT_SELECTION_ALPHA: u32 = 0x66u32

pub fn input_caret_color(st: Style) -> u32:
    if st.caret_color != 0u32: st.caret_color else: st.fg

pub fn input_selection_color(st: Style) -> u32:
    (INPUT_TEXT_SELECTION_ALPHA << 24) |
        (input_caret_color(st) & 0x00FFFFFFu32)

fn _input_text_empty_rect() -> ClipRect:
    ClipRect(x0: 0, y0: 0, x1: 0, y1: 0)

fn _input_text_declared_value(nd: HNode) -> text:
    attr_value(nd.attrs_raw, "value")

fn _input_text_source_boundaries(value: text) -> [i64]:
    var boundaries: [i64] = [0]
    val bytes = value.bytes()
    var cursor: i64 = 0
    # cpu-lane-loop-ok: one UTF-8 decode pass over a single input element's declared value building its codepoint boundary table; bound is that value's byte length, not page content
    while cursor < bytes.len():
        var count = utf8_seq_len(bytes[cursor])
        if count <= 0 or cursor + count > bytes.len():
            count = 1
        cursor = cursor + count
        boundaries.push(cursor)
    boundaries

pub fn input_text_visual_map(nd: HNode, st: Style) -> InputTextVisualMap:
    val source = _input_text_declared_value(nd)
    if not text_is_valid_utf8(source):
        return InputTextVisualMap(
            display_text: "",
            source_boundary_bytes: [],
            boundary_x_px: []
        )
    val source_boundaries = _input_text_source_boundaries(source)
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val transformed = if input_type == "password":
        INPUT_PASSWORD_MASK_GLYPH.repeat(source_boundaries.len() - 1)
    else:
        apply_text_transform_for_paint(source, st.text_transform)
    val display_text = if st.direction_rtl:
        bidi_visual_text_for_rtl(transformed)
    else:
        transformed
    val advance = input_text_glyph_advance(nd, st)
    val space_advance = style_space_advance(st)
    val total_width = style_text_line_advance_width(
        transformed, 0, transformed.byte_len(), st, advance, space_advance
    )
    # Carets mirror only for right-to-left text. A Latin/digit value keeps its
    # logical order under direction:rtl (Chrome 159), so its source
    # boundaries ascend left to right exactly as in ltr.
    val mirrored = st.direction_rtl and text_has_rtl_strong(transformed)
    var boundary_x_px: [i32] = []
    var boundary_index = 0
    while boundary_index < source_boundaries.len():
        val source_end = source_boundaries[boundary_index]
        val prefix = if input_type == "password":
            INPUT_PASSWORD_MASK_GLYPH.repeat(boundary_index)
        else:
            apply_text_transform_for_paint(
                source.substring(0, source_end), st.text_transform
            )
        val prefix_width = style_text_line_advance_width(
            prefix, 0, prefix.byte_len(), st, advance, space_advance
        )
        boundary_x_px.push(
            if mirrored:
                total_width - prefix_width
            else:
                prefix_width
        )
        boundary_index = boundary_index + 1
    InputTextVisualMap(
        display_text: display_text,
        source_boundary_bytes: source_boundaries,
        boundary_x_px: boundary_x_px
    )

fn _input_text_boundary_index(
    visual_map: InputTextVisualMap, source_byte: i64
) -> i32:
    var i = 0
    while i < visual_map.source_boundary_bytes.len():
        if visual_map.source_boundary_bytes[i] == source_byte:
            return i
        i = i + 1
    -1

pub fn input_text_x_at_source_byte(
    visual_map: InputTextVisualMap, source_byte: i64
) -> i32:
    val index = _input_text_boundary_index(visual_map, source_byte)
    if index < 0:
        return 0
    visual_map.boundary_x_px[index]

pub fn input_text_source_byte_at_x(
    visual_map: InputTextVisualMap, x: i32
) -> i64:
    if visual_map.source_boundary_bytes.len() == 0:
        return 0
    var best_index = 0
    var best_distance = visual_map.boundary_x_px[0] - x
    if best_distance < 0:
        best_distance = 0 - best_distance
    var i = 1
    while i < visual_map.source_boundary_bytes.len():
        var distance = visual_map.boundary_x_px[i] - x
        if distance < 0:
            distance = 0 - distance
        if distance < best_distance:
            best_index = i
            best_distance = distance
        i = i + 1
    visual_map.source_boundary_bytes[best_index]

fn _input_text_content_clip(ancestor_clip: ClipRect, x: i32, y: i32, w: i32, h: i32) -> ClipRect:
    val raw_clip = clip_intersect(ancestor_clip, x, y, x + w, y + h)
    var x1 = raw_clip.x1
    var y1 = raw_clip.y1
    if x1 < raw_clip.x0:
        x1 = raw_clip.x0
    if y1 < raw_clip.y0:
        y1 = raw_clip.y0
    ClipRect(x0: raw_clip.x0, y0: raw_clip.y0, x1: x1, y1: y1)

pub fn input_text_paint_plan(nd: HNode, st: Style, x: i32, y: i32, w: i32, h: i32, ancestor_clip: ClipRect) -> InputTextPaintPlan:
    val raw_text = input_text_for_paint(nd)
    val transformed_text = apply_text_transform_for_paint(
        raw_text, st.text_transform
    )
    val text_value = if st.direction_rtl:
        bidi_visual_text_for_rtl(transformed_text)
    else:
        transformed_text
    val content_x = x + st.border_l + st.pad_l
    val content_y = y + st.border_t + st.pad_t
    val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
    val content_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    val scale = web_glyph_scale(st.font_size)
    val baseline_y = content_y + if content_h > 7 * scale:
        (content_h - 7 * scale) / 2
    else:
        0
    val adv = input_text_glyph_advance(nd, st)
    val space_adv = style_space_advance(st)
    val measured_width = style_text_line_advance_width(
        text_value, 0, text_value.byte_len(), st, adv, space_adv
    )
    val input_type = attr_value(nd.attrs_raw, "type").trim().lower()
    val button_label = (
        input_type == "button" or input_type == "submit" or
        input_type == "reset"
    )
    val baseline_x = if button_label and measured_width <= content_w:
        content_x + (content_w - measured_width) / 2
    elif measured_width > content_w and st.direction_rtl:
        # An overflowing value is start-aligned whatever text-align says
        # (CSS Text 3 §6.1). Chrome 159: a centered 56px value in a 36px
        # content box paints ink columns 3..38, the same as start alignment;
        # RTL center/start/left overflow paint identical columns too.
        content_x + content_w - measured_width
    elif measured_width > content_w:
        content_x
    else:
        text_line_aligned_x(
            content_x, content_w, measured_width, st, 0, 1
        )
    # A button label is clipped at the padding box, not the content box.
    # Chrome 159, 30px submit (1px border, 2px padding, 8px Arial,
    # `ABCDEFGHIJK`, 58px): ink columns 3..28 (start-aligned, into the right
    # padding); under RTL 1..26 (end-anchored at the content right edge 27,
    # into the left padding). A label that fits stays centred.
    val clip = if button_label:
        _input_text_content_clip(
            ancestor_clip, x + st.border_l, y + st.border_t,
            w - st.border_l - st.border_r, h - st.border_t - st.border_b
        )
    else:
        _input_text_content_clip(
            ancestor_clip, content_x, content_y, content_w, content_h
        )
    val visual_map = input_text_visual_map(nd, st)
    var absolute_boundaries: [i32] = []
    # cpu-lane-loop-ok: maps one input's glyph-boundary x offsets to absolute x; bound is the boundary count of that input's own value, a single linear map with no nesting
    for boundary_x in visual_map.boundary_x_px:
        absolute_boundaries.push(baseline_x + boundary_x)
    # There is no computed ::placeholder color in Style yet. st.fg is the
    # canonical theme-derived fail-safe rather than a renderer-only gray.
    InputTextPaintPlan(
        text_value: text_value,
        baseline_x: baseline_x,
        baseline_y: baseline_y,
        measured_width: measured_width,
        clip: clip,
        color: st.fg,
        source_window_start_byte: 0,
        source_window_end_byte: if text_is_valid_utf8(
            _input_text_declared_value(nd)
        ):
            _input_text_declared_value(nd).len()
        else:
            0,
        source_boundary_bytes: visual_map.source_boundary_bytes,
        boundary_x_px: absolute_boundaries,
        selection_present: false,
        selection_rect: _input_text_empty_rect(),
        selection_color: input_selection_color(st),
        caret_present: false,
        caret_rect: _input_text_empty_rect(),
        caret_color: input_caret_color(st),
        resolved_view_start_byte: 0
    )

pub fn input_text_paint_plan_with_overlay(
    nd: HNode, st: Style, x: i32, y: i32, w: i32, h: i32,
    ancestor_clip: ClipRect, overlay: BrowserTextInputOverlay
) -> InputTextPaintPlan:
    if overlay.target_key == "":
        return input_text_paint_plan(nd, st, x, y, w, h, ancestor_clip)
    val visual_map = input_text_visual_map(nd, st)
    if visual_map.source_boundary_bytes.len() == 0:
        # Only an invalid-UTF-8 value has no boundaries; the static plan
        # paints nothing for it.
        return input_text_paint_plan(nd, st, x, y, w, h, ancestor_clip)
    var view_index = _input_text_boundary_index(
        visual_map, overlay.view_start_byte
    )
    if view_index < 0:
        view_index = 0
    var focus_index = _input_text_boundary_index(
        visual_map, overlay.focus_byte
    )
    if focus_index < 0:
        focus_index = visual_map.source_boundary_bytes.len() - 1
    val content_x = x + st.border_l + st.pad_l
    val content_y = y + st.border_t + st.pad_t
    val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
    val content_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    if focus_index < view_index:
        view_index = focus_index
    var focus_distance = (
        visual_map.boundary_x_px[focus_index] -
        visual_map.boundary_x_px[view_index]
    )
    if focus_distance < 0:
        focus_distance = 0 - focus_distance
    # cpu-lane-loop-ok: advances the horizontal scroll window start until the focused caret fits content_w; bound is focus_index inside one input's boundary table, and view_index only ever moves forward
    while view_index < focus_index and focus_distance >= content_w:
        view_index = view_index + 1
        focus_distance = (
            visual_map.boundary_x_px[focus_index] -
            visual_map.boundary_x_px[view_index]
        )
        if focus_distance < 0:
            focus_distance = 0 - focus_distance
    val resolved_view_start = visual_map.source_boundary_bytes[view_index]
    var window_end_index = view_index
    # cpu-lane-loop-ok: extends the visible window end while it still fits content_w; bound is one input's boundary count, single monotone forward scan
    while window_end_index + 1 < visual_map.source_boundary_bytes.len():
        var window_width = (
            visual_map.boundary_x_px[window_end_index + 1] -
            visual_map.boundary_x_px[view_index]
        )
        if window_width < 0:
            window_width = 0 - window_width
        if window_width > content_w:
            break
        window_end_index = window_end_index + 1
    val resolved_window_end = (
        visual_map.source_boundary_bytes[window_end_index]
    )
    val advance = input_text_glyph_advance(nd, st)
    val space_advance = style_space_advance(st)
    val visual_width = style_text_line_advance_width(
        visual_map.display_text, 0, visual_map.display_text.byte_len(),
        st, advance, space_advance
    )
    val static_plan = input_text_paint_plan(
        nd, st, x, y, w, h, ancestor_clip
    )
    val baseline_x = if view_index == 0:
        static_plan.baseline_x
    elif st.direction_rtl:
        content_x + content_w - visual_map.boundary_x_px[view_index]
    else:
        content_x - visual_map.boundary_x_px[view_index]
    val scale = web_glyph_scale(st.font_size)
    val text_height = 7 * scale
    val baseline_y = content_y + if content_h > text_height:
        (content_h - text_height) / 2
    else:
        0
    var absolute_boundaries: [i32] = []
    # cpu-lane-loop-ok: same absolute-x boundary mapping as input_text_paint_plan, overlay variant; bound is the boundary count of that one input's value
    for boundary_x in visual_map.boundary_x_px:
        absolute_boundaries.push(baseline_x + boundary_x)
    var anchor_x = baseline_x + input_text_x_at_source_byte(
        visual_map, overlay.anchor_byte
    )
    var focus_x = baseline_x + input_text_x_at_source_byte(
        visual_map, overlay.focus_byte
    )
    val selection_present = overlay.anchor_byte != overlay.focus_byte
    if anchor_x > focus_x:
        val swap = anchor_x
        anchor_x = focus_x
        focus_x = swap
    val caret_x = baseline_x + input_text_x_at_source_byte(
        visual_map, overlay.focus_byte
    )
    val clip = _input_text_content_clip(
        ancestor_clip, content_x, content_y, content_w, content_h
    )
    InputTextPaintPlan(
        text_value: visual_map.display_text,
        baseline_x: baseline_x,
        baseline_y: baseline_y,
        measured_width: visual_width,
        clip: clip,
        color: st.fg,
        source_window_start_byte: resolved_view_start,
        source_window_end_byte: resolved_window_end,
        source_boundary_bytes: visual_map.source_boundary_bytes,
        boundary_x_px: absolute_boundaries,
        selection_present: selection_present,
        selection_rect: ClipRect(
            x0: anchor_x, y0: baseline_y,
            x1: focus_x, y1: baseline_y + text_height
        ),
        selection_color: input_selection_color(st),
        caret_present: overlay.caret_visible and not selection_present,
        caret_rect: ClipRect(
            x0: caret_x, y0: baseline_y,
            x1: caret_x + 1, y1: baseline_y + text_height
        ),
        caret_color: input_caret_color(st),
        resolved_view_start_byte: resolved_view_start
    )

fn fb_input_accent_control_clip(
    fb: [u32], fbw: i32, fbh: i32,
    x: i32, y: i32, w: i32, h: i32,
    input_type: text, checked: bool, accent_color: u32, clip: ClipRect
) -> [u32]:
    val accent = if accent_color != 0u32: accent_color else: web_argb(37, 99, 235)
    # Chrome 159 draws the glyph as a square of side min(w, h), centred in
    # the border box: a 40x16 checkbox at (4,3) inks columns 16..31, rows
    # 3..18. A 13x13 box is unchanged.
    val side = if w < h: w else: h
    val control_w = side
    val control_h = side
    val gx = x + (w - side) / 2
    val gy = y + (h - side) / 2
    if control_w <= 0 or control_h <= 0:
        return fb
    val radio = input_type == "radio"
    var out = fb
    if radio:
        out = fb_rounded_rect_opacity_clip(
            out, fbw, fbh, gx, gy, control_w, control_h,
            control_w / 2, accent, 100, clip
        )
        if control_w > 2 and control_h > 2:
            out = fb_rounded_rect_opacity_clip(
                out, fbw, fbh, gx + 1, gy + 1,
                control_w - 2, control_h - 2,
                (control_w - 2) / 2, web_argb(248, 250, 252), 100, clip
            )
    else:
        out = fb_rect_clip(fb, fbw, fbh, gx, gy, control_w, control_h, web_argb(248, 250, 252), clip)
        out = fb_rect_clip(out, fbw, fbh, gx, gy, control_w, 1, accent, clip)
        out = fb_rect_clip(out, fbw, fbh, gx, gy + control_h - 1, control_w, 1, accent, clip)
        out = fb_rect_clip(out, fbw, fbh, gx, gy, 1, control_h, accent, clip)
        out = fb_rect_clip(out, fbw, fbh, gx + control_w - 1, gy, 1, control_h, accent, clip)
    if checked and control_w > 6 and control_h > 6:
        if radio:
            out = fb_rounded_rect_opacity_clip(
                out, fbw, fbh, gx + 3, gy + 3,
                control_w - 6, control_h - 6,
                (control_w - 6) / 2, accent, 100, clip
            )
        else:
            out = fb_rect_clip(out, fbw, fbh, gx + 3, gy + 3, control_w - 6, control_h - 6, accent, clip)
    out

# ---------------------------------------------------------------------------
# Paint into a staging [u32] framebuffer before Engine2D presentation.
# ---------------------------------------------------------------------------

fn _widget_rects_if_painted(acc: WidgetChromeRects, color: u32, rects: WidgetChromeRects) -> WidgetChromeRects:
    # An alpha-0 colour paints nothing (as a Draw IR rect does).
    if (color >> 24) == 0u32:
        return acc
    widget_chrome_rects_concat(acc, rects)

# Legacy widget offset text for one #text node: sparse 5x7 glyphs at the box
# origin + (8, 7), with shadow and decorations, as one ordered rect list. ONE
# source for the raster `paint` (fb_widget_chrome_rects) and the Draw IR
# producer (paint_layout.spl), used in legacy widget mode whenever the
# generated chrome text does not replace node text.
fn widget_offset_text_node_rects(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], wrap_cache: TextWrapCache, i: i32, fbw: i32, fbh: i32) -> WidgetChromeRects:
    var out = WidgetChromeRects(xs: [], ys: [], ws: [], hs: [], colors: [])
    val nd = nodes[i]
    val st = styles[i]
    val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
    if not visible_node or nd.tag != "#text" or html_text_paint_fully_transparent(nd, st):
        return out
    # Match the layout measure: white-space:pre/nowrap preserves raw text
    # (leading indentation), normal flow uses trimmed text.
    val raw_txt: text = if st.white_space_nowrap: nd.text_data else: nd.text_trimmed
    val transformed_txt = apply_text_transform_for_paint(raw_txt, st.text_transform)
    val txt = if st.direction_rtl: bidi_visual_text_for_rtl(transformed_txt) else: transformed_txt
    val y = by[i]
    if txt.len() == 0 or y >= fbh:
        return out
    val w = bw[i]
    val lh = style_line_h(st)
    val node_starts = wrap_cache.starts[i]
    val node_ends = wrap_cache.ends[i]
    val line_count = node_starts.len()
    val sparse_advance = 6 + st.letter_spacing_px
    val sparse_stride = if sparse_advance > 0: sparse_advance else: 1
    val sparse_space_advance = sparse_stride / 2 + st.word_spacing_px
    val sparse_space_stride = if sparse_space_advance > 0: sparse_space_advance else: 1
    val underline_color = if st.text_decoration_color != 0u32: st.text_decoration_color else: st.fg
    val thickness = style_decoration_thickness_px(st)
    val text_x = bx[i] + 8
    var ly = y + 7
    var line_i = 0
    # cpu-lane-loop-ok: per-wrapped-line glyph emission for one #text node on the widget-chrome path; bound is line_count from the wrap cache and it stops early at ly >= fbh, so it is bounded by the visible lines of one node
    while line_i < line_count and ly < fbh:
        # Per-line box (`text_line_box_dx` / `text_line_box_w`): a run that starts
        # mid-line insets its first line only; a run beside a left
        # float insets exactly the lines layout shortened.
        val draw_txt = if st.text_overflow_ellipsis and line_i == 0: ellipsize_text_for_width(txt, node_starts[line_i], node_ends[line_i], w - st.text_indent_px, st, sparse_stride, sparse_space_stride) else: txt
        val draw_start = if st.text_overflow_ellipsis and line_i == 0: 0 else: node_starts[line_i]
        val draw_end = if st.text_overflow_ellipsis and line_i == 0: draw_txt.byte_len() else: node_ends[line_i]
        val line_dx = text_line_box_dx(wrap_cache.first_line_dx, wrap_cache.line_boxes, i, line_i)
        val line_base_x = if line_i == 0: text_x + st.text_indent_px + line_dx else: text_x + line_dx
        val line_box_w = text_line_box_w(wrap_cache.first_line_dx, wrap_cache.line_boxes, i, line_i, w) - (if line_i == 0: st.text_indent_px else: 0)
        val line_w = if text_line_needs_paint_width(st, line_i, line_count): text_line_advance_width(draw_txt, draw_start, draw_end, sparse_stride, sparse_space_stride) else: 0
        val line_text_x = text_line_aligned_x(line_base_x, line_box_w, line_w, st, line_i, line_count)
        if st.text_shadow_color != 0u32:
            out = _widget_rects_if_painted(out, st.text_shadow_color, sparse_text_rects(fbw, fbh, line_text_x + st.text_shadow_x_px, ly + st.text_shadow_y_px, draw_txt, draw_start, draw_end, st.text_shadow_color, sparse_stride, sparse_space_stride, st.font_style_italic))
        out = _widget_rects_if_painted(out, st.fg, sparse_text_rects(fbw, fbh, line_text_x, ly, draw_txt, draw_start, draw_end, st.fg, sparse_stride, sparse_space_stride, st.font_style_italic))
        # One rule primitive, three y positions. Each is independent so
        # combinations paint together.
        if st.text_decoration_underline:
            out = _widget_rects_if_painted(out, underline_color, text_decoration_rects(line_text_x, ly + 8 + st.text_underline_offset_px, line_w, thickness, st.text_decoration_style, underline_color))
        if st.text_decoration_overline:
            out = _widget_rects_if_painted(out, underline_color, text_decoration_rects(line_text_x, ly, line_w, thickness, st.text_decoration_style, underline_color))
        if st.text_decoration_line_through:
            out = _widget_rects_if_painted(out, underline_color, text_decoration_rects(line_text_x, ly + 4, line_w, thickness, st.text_decoration_style, underline_color))
        line_i = line_i + 1
        ly = ly + lh
    out

# ---------------------------------------------------------------------------
# CSS opacity groups on the raster lane (Chrome 159 saveLayer semantics).
# A box with 0 < opacity < 1 whose subtree paints two or more items is
# rasterised into its own transparent layer, bounded to the subtree's clipped
# bounds, and restored with `css_opacity_group_composite_into`
# (SkBlendARGB32, engine2d/css_opacity_group.spl). One painted item keeps the
# per-element fold. Admission is deliberately narrow: a group is composited
# after the regular passes, which is Chrome's order for a z-index:auto
# stacking context relative to in-flow content, so a group is admitted only
# when no positioned box outside it that Chrome would paint ABOVE it (later
# in tree order, or z-index > 0) overlaps it. Iframes and widget pages stay on
# the per-element path. A nested group (an opacity root inside a group) is
# rasterised into its own layer and restored into its parent's layer at its
# tree-order slot; positioned siblings after it that overlap it are painted
# after that restore (`_raster_layer_passes`), matching Chrome 159.
# ---------------------------------------------------------------------------

fn _raster_group_alpha(c: u32) -> u32:
    (c >> 24) & 255u32

# Paint operations one node contributes to a group, as Chrome counts them
# (a box with background + border is two ops and already a group: Chrome 159
# paints ff7e7e, not the folded ff7f7f, for red bg + blue border at 0.5).
fn _raster_group_node_ops(nd: HNode, st: Style) -> i32:
    if nd.tag == "#text":
        return if nd.text_trimmed != "": 1 else: 0
    var ops = 0
    if _raster_group_alpha(st.bg) != 0u32:
        ops = ops + 1
    if st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0:
        ops = ops + 1
    if st.outline_w > 0 and st.outline_color != 0u32:
        ops = ops + 1
    if nd.tag == "img":
        ops = ops + 1
    if _raster_group_has_shadow(st):
        ops = ops + 1
    if _raster_group_has_image_layer(st):
        ops = ops + 1
    ops

# Outset shadow extent past each border-box edge [left, top, right, bottom]:
# offset toward that edge + spread + 2*blur (the blur ramp stays inside
# 2*blur), the max over layers. Directional and tighter than
# `_paint_shadow_pad`'s symmetric +8 tile margin, which would make a group
# overlap its neighbours and fail the overlap rule.
fn _raster_group_shadow_edges(ox: i32, oy: i32, blur: i32, sp: i32, ext: [i32]) -> [i32]:
    var out = ext
    val reach = sp + blur * 2
    val l = reach - ox
    val t = reach - oy
    val r = reach + ox
    val b = reach + oy
    if l > out[0]: out[0] = l
    if t > out[1]: out[1] = t
    if r > out[2]: out[2] = r
    if b > out[3]: out[3] = b
    out

fn _raster_group_shadow_extent(st: Style) -> [i32]:
    var ext: [i32] = [0, 0, 0, 0]
    if st.box_shadow_raw == "":
        return _raster_group_shadow_edges(st.box_shadow_x_px, st.box_shadow_y_px, st.box_shadow_blur_px, 0, ext)
    for layer in split_top_level_commas(st.box_shadow_raw):  # cpu-lane-loop-ok: one node's shadow layer list
        if not layer.contains("inset"):
            val prefix = shadow_length_prefix(layer)
            val ox = parse_signed_nth_int(prefix, 0)
            val oy = parse_signed_nth_int(prefix, 1)
            if ox != -1000000 and oy != -1000000:
                var blur = parse_signed_nth_int(prefix, 2)
                if blur == -1000000 or blur < 0:
                    blur = 0
                var sp = parse_signed_nth_int(prefix, 3)
                if sp == -1000000 or sp < 0:
                    sp = 0
                ext = _raster_group_shadow_edges(ox, oy, blur, sp, ext)
    ext

fn _raster_group_has_shadow(st: Style) -> bool:
    st.box_shadow_color != 0u32 or st.box_shadow_raw != ""

fn _raster_group_has_image_layer(st: Style) -> bool:
    (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32) or st.bg_layers_raw != "" or st.background_image_uri != ""

# The raster blenders treat a transparent destination as opaque black (and
# write alpha 255), so a layer is painted once over opaque black (B) -- whose
# colour channels are then exactly Chrome's premultiplied layer colour -- and,
# when the layer holds non-opaque paint, again over opaque white (W): the
# layer alpha is 255 - (W - B). That alpha is exact for one non-opaque paint
# per pixel over a not-yet-opaque pixel (any number of opaque paints): the
# white backdrop term of every Chrome rule is exactly 255 - a. Two non-opaque
# paints overlapping on a non-opaque pixel round differently (+-1), so a
# layer's non-opaque paint rects must be pairwise disjoint; otherwise the
# group stays on the per-element path (follow-up: a white-forced alpha pass
# at every raster pixel-write site). Form controls and SVG always decline.
fn _raster_group_node_layer_safe(nd: HNode, st: Style) -> bool:
    nd.tag != "input" and nd.tag != "svg" and nd.tag != "select" and nd.tag != "textarea" and nd.tag != "button"

# Non-opaque paint items one node contributes to a layer: an image, a shadow,
# a gradient or image layer that is not two opaque stops, translucent
# background / border / outline colours. Text over the root's opaque
# background (the only text the layer admits) is exact and is not counted.
fn _raster_group_node_translucent_items(nd: HNode, st: Style) -> i32:
    if nd.tag == "#text":
        return 0
    var items = 0
    if nd.tag == "img":
        items = items + 1
    if _raster_group_has_shadow(st):
        items = items + 1
    if st.bg_layers_raw != "" or st.background_image_uri != "":
        items = items + 1
    elif st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32 and (_raster_group_alpha(st.background_gradient_from) != 255u32 or _raster_group_alpha(st.background_gradient_to) != 255u32):
        items = items + 1
    val bga = _raster_group_alpha(st.bg)
    if bga != 0u32 and bga != 255u32:
        items = items + 1
    var border_translucent = false
    if st.border_l > 0 and _raster_group_alpha(st.border_color_l) != 255u32: border_translucent = true
    if st.border_t > 0 and _raster_group_alpha(st.border_color_t) != 255u32: border_translucent = true
    if st.border_r > 0 and _raster_group_alpha(st.border_color_r) != 255u32: border_translucent = true
    if st.border_b > 0 and _raster_group_alpha(st.border_color_b) != 255u32: border_translucent = true
    if border_translucent:
        items = items + 1
    if st.outline_w > 0 and st.outline_color != 0u32 and _raster_group_alpha(st.outline_color) != 255u32:
        items = items + 1
    items

fn _raster_group_visible(nodes: [HNode], styles: [Style], i: i32) -> bool:
    styles[i].display != "none" and not styles[i].visibility_hidden and
        not content_paint_hidden_by_ancestor(nodes, styles, i)

fn _raster_group_positioned(st: Style) -> bool:
    st.position_absolute or st.position_relative or st.position_fixed or st.position_sticky

struct _RasterOpacityGroup:
    root: i32
    members: [bool]
    x: i32
    y: i32
    w: i32
    h: i32
    two_pass: bool

# `nested` scans inside a parent group's layer (the parent root is at opacity
# 100 and everything outside it is hidden): one painted item is already a
# layer there (a fold onto the transparent layer is not exact on the raster),
# and the overlap rule is replaced by the tree-order interleave in
# `_raster_layer_passes`.
fn _raster_opacity_groups(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], fbw: i32, fbh: i32, nested: bool) -> [_RasterOpacityGroup]:
    var groups: [_RasterOpacityGroup] = []
    val n = nodes.len() as i32
    var claimed: [bool] = [false; n]
    var g = 0
    while g < n:  # cpu-lane-loop-ok: one scan for fractional-opacity roots; the per-root member/overlap passes run only for a root that is found, bound is node_count per root
        val gst = styles[g]
        val tag = nodes[g].tag
        if (
            gst.opacity_pct > 0 and gst.opacity_pct < 100 and not claimed[g] and
            tag != "html" and tag != "body" and tag != "#root" and
            _raster_group_visible(nodes, styles, g)
        ):
            var members: [bool] = [false; n]
            members[g] = true
            var painted = 0
            var reject = false  # iframe, or a member the layer cannot hold exactly
            var has_nested = false
            var has_text = false
            var has_z = false
            var two_pass = false
            var tx0: [i32] = []
            var ty0: [i32] = []
            var tx1: [i32] = []
            var ty1: [i32] = []
            var x0 = fbw
            var y0 = fbh
            var x1 = 0
            var y1 = 0
            var j = g
            while j < n:  # cpu-lane-loop-ok: subtree membership by parent pointer (pre-order DOM, parent index < child index); bound is node_count
                val parent = nodes[j].parent as i32
                if j == g or (parent >= g and members[parent]):
                    members[j] = true
                    val st = styles[j]
                    if j != g and st.opacity_pct < 100:
                        has_nested = true
                    if j != g and st.z_index != 0:
                        has_z = true
                    if nodes[j].tag == "iframe":
                        reject = true
                    val ops = if _raster_group_visible(nodes, styles, j): _raster_group_node_ops(nodes[j], st) else: 0
                    if ops > 0:
                        painted = painted + ops
                        if not _raster_group_node_layer_safe(nodes[j], st):
                            reject = true
                        val sh: [i32] = if _raster_group_has_shadow(st): _raster_group_shadow_extent(st) else: [0, 0, 0, 0]
                        val translucent = _raster_group_node_translucent_items(nodes[j], st)
                        if translucent > 1:
                            reject = true
                        if translucent == 1:
                            two_pass = true
                            val opad = if st.outline_w > 0: st.outline_w + _tile_abs_i32(st.outline_offset_px) else: 0
                            val rx0 = bx[j] - (if sh[0] > opad: sh[0] else: opad)
                            val ry0 = by[j] - (if sh[1] > opad: sh[1] else: opad)
                            val rx1 = bx[j] + bw[j] + (if sh[2] > opad: sh[2] else: opad)
                            val ry1 = by[j] + bh[j] + (if sh[3] > opad: sh[3] else: opad)
                            var q = 0
                            while q < tx0.len():  # cpu-lane-loop-ok: pairwise disjointness of this group's non-opaque paint rects; bound is that count
                                if rx0 < tx1[q] and rx1 > tx0[q] and ry0 < ty1[q] and ry1 > ty0[q]:
                                    reject = true
                                q = q + 1
                            tx0.push(rx0)
                            ty0.push(ry0)
                            tx1.push(rx1)
                            ty1.push(ry1)
                        # Antialiased text needs an opaque backdrop inside the
                        # layer: only a root with an opaque background gives one.
                        if nodes[j].tag == "#text":
                            has_text = true
                            if _raster_group_alpha(gst.bg) != 255u32:
                                reject = true
                        val pad = if st.outline_w > 0: st.outline_w + _tile_abs_i32(st.outline_offset_px) else: 0
                        val px0 = bx[j] - (if sh[0] > pad: sh[0] else: pad)
                        val py0 = by[j] - (if sh[1] > pad: sh[1] else: pad)
                        val px1 = bx[j] + bw[j] + (if sh[2] > pad: sh[2] else: pad)
                        val py1 = by[j] + bh[j] + (if sh[3] > pad: sh[3] else: pad)
                        if px0 < x0: x0 = px0
                        if py0 < y0: y0 = py0
                        if px1 > x1: x1 = px1
                        if py1 > y1: y1 = py1
                j = j + 1
            var k = g
            while k < n:  # cpu-lane-loop-ok: marks the subtree claimed so a descendant root is never a second group; bound is node_count
                if members[k]:
                    claimed[k] = true
                k = k + 1
            if x0 < 0: x0 = 0
            if y0 < 0: y0 = 0
            if x1 > fbw: x1 = fbw
            if y1 > fbh: y1 = fbh
            # Nested layers: text needs the opaque backdrop of its own layer
            # root and z-index reorders paint across the tree-order interleave.
            if has_nested and (has_text or has_z or two_pass):
                reject = true
            val min_painted = if nested: 1 else: 2
            var admitted = painted >= min_painted and not reject and x1 > x0 and y1 > y0
            if admitted and not nested:
                var a = 0
                while a < n:  # cpu-lane-loop-ok: overlap check against positioned boxes outside the group; bound is node_count
                    val ast = styles[a]
                    if (
                        not members[a] and _raster_group_positioned(ast) and
                        (a > g or ast.z_index > 0) and
                        _raster_group_visible(nodes, styles, a) and
                        bx[a] < x1 and bx[a] + bw[a] > x0 and by[a] < y1 and by[a] + bh[a] > y0
                    ):
                        # An ancestor of the group paints under it.
                        var anc = nodes[g].parent as i32
                        var is_ancestor = false
                        while anc >= 0:  # cpu-lane-loop-ok: depth-bounded ancestor walk
                            if anc == a:
                                is_ancestor = true
                            anc = nodes[anc].parent as i32
                        if not is_ancestor:
                            admitted = false
                    a = a + 1
            if admitted:
                groups.push(_RasterOpacityGroup(root: g, members: members, x: x0, y: y0, w: x1 - x0, h: y1 - y0, two_pass: two_pass))
        g = g + 1
    groups

# Runs the regular passes with the `hide` nodes marked visibility:hidden and
# `full_opacity_root` painted at opacity 100, then restores the styles (Style
# is shared by reference; same pattern as the tile-cull pass below).
# `layer` paints a group's layer content: nested groups inside it are layered
# again (`_raster_layer_passes`) instead of painted per element.
fn _raster_paint_hiding(nodes: [HNode], styles: [Style], hide: [bool], full_opacity_root: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool, layer: bool) -> [u32]:
    var work = styles
    val n = styles.len() as i32
    var prev_hidden: [bool] = [false; n]
    var i = 0
    while i < n:  # cpu-lane-loop-ok: marks the hidden set; single O(node_count) pass paired with the restore below
        prev_hidden[i] = work[i].visibility_hidden
        if hide[i]:
            var st = work[i]
            st.visibility_hidden = true
            work[i] = st
        i = i + 1
    var prev_opacity = 100
    if full_opacity_root >= 0:
        var rst = work[full_opacity_root]
        prev_opacity = rst.opacity_pct
        rst.opacity_pct = 100
        work[full_opacity_root] = rst
    val out = if layer: _raster_layer_passes(nodes, work, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode) else: _paint_passes(nodes, work, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode)
    if full_opacity_root >= 0:
        var rst = work[full_opacity_root]
        rst.opacity_pct = prev_opacity
        work[full_opacity_root] = rst
    i = 0
    while i < n:  # cpu-lane-loop-ok: restores the visibility_hidden values saved above; single O(node_count) pass
        if work[i].visibility_hidden != prev_hidden[i]:
            var st = work[i]
            st.visibility_hidden = prev_hidden[i]
            work[i] = st
        i = i + 1
    out

fn _raster_shifted(v: [i32], d: i32) -> [i32]:
    var out: [i32] = []
    for x in v:  # cpu-lane-loop-ok: per-node coordinate shift into a group layer's local space; bound is node_count
        out.push(x - d)
    out

# Paints `grp` alone into a bounded transparent layer (root at opacity 100,
# coordinates shifted into the layer) and restores it onto `fb`.
fn _raster_restore_group(nodes: [HNode], styles: [Style], grp: _RasterOpacityGroup, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool) -> [u32]:
    val n = nodes.len() as i32
    var outside: [bool] = [true; n]
    var i = 0
    while i < n:  # cpu-lane-loop-ok: complement of the group's members; bound is node_count
        if grp.members[i]:
            outside[i] = false
        i = i + 1
    val alpha8 = css_opacity_group_alpha8(styles[grp.root].opacity_pct)
    val lbx = _raster_shifted(bx, grp.x)
    val lby = _raster_shifted(by, grp.y)
    # Two-pass layers start OPAQUE black: some raster paths (gradient layers
    # via Engine2D blend) honour a transparent destination and would leave
    # straight, not premultiplied, colour in B.
    val black_fb: [u32] = [if grp.two_pass: 0xFF000000u32 else: 0u32; grp.w * grp.h]
    val black = _raster_paint_hiding(nodes, styles, outside, grp.root, lbx, lby, bw, bh, wrap_cache, black_fb, grp.w, grp.h, widget_mode, true)
    if not grp.two_pass:
        return css_opacity_group_composite_into(fb, fbw, fbh, black, grp.w, grp.h, grp.x, grp.y, alpha8)
    val white_fb: [u32] = [0xFFFFFFFFu32; grp.w * grp.h]
    val white = _raster_paint_hiding(nodes, styles, outside, grp.root, lbx, lby, bw, bh, wrap_cache, white_fb, grp.w, grp.h, widget_mode, true)
    css_opacity_group_composite_into(fb, fbw, fbh, _raster_group_layer_from_passes(black, white), grp.w, grp.h, grp.x, grp.y, alpha8)

fn _raster_group_unpremul(c: i32, a: i32) -> i32:
    val v = (c * 255 + a / 2) / a
    if v > 255: 255 else: v

# Straight-alpha layer from the black (B) and white (W) passes: alpha
# 255 - (W - B) (green channel; every channel carries the same backdrop
# term), colour = B's premultiplied channels divided back out.
fn _raster_group_layer_from_passes(black: [u32], white: [u32]) -> [u32]:
    val n = black.len()
    var out: [u32] = [0u32; n]
    var i: i64 = 0
    while i < n:  # cpu-lane-loop-ok: per-pixel alpha recovery over one bounded group layer
        val b = black[i]
        val w = white[i]
        if (b & 0x00FFFFFFu32) == (w & 0x00FFFFFFu32):
            out[i] = b | 0xFF000000u32
        else:
            val a = 255 - ((((w >> 8) & 255u32) as i32) - (((b >> 8) & 255u32) as i32))
            if a > 0:
                val r = _raster_group_unpremul(((b >> 16) & 255u32) as i32, a)
                val g = _raster_group_unpremul(((b >> 8) & 255u32) as i32, a)
                val bl = _raster_group_unpremul((b & 255u32) as i32, a)
                out[i] = ((a as u32) << 24) | ((r as u32) << 16) | ((g as u32) << 8) | (bl as u32)
        i = i + 1
    out

# A group's layer content. Without nested groups it is the regular passes.
# Otherwise the nested groups and every positioned box after a nested group
# that overlaps it ("late" boxes, with their subtrees) are held back; the rest
# paints first, then the nested-group restores and late subtrees run in tree
# order -- Chrome paints an opacity stacking context at its tree-order slot
# among the positioned, z-index:auto content of its parent context.
fn _raster_layer_passes(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool) -> [u32]:
    val inner = _raster_opacity_groups(nodes, styles, bx, by, bw, bh, fbw, fbh, true)
    if inner.len() == 0:
        return _paint_passes(nodes, styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode)
    val n = nodes.len() as i32
    var group_at: [i32] = [-1; n]
    var in_inner: [bool] = [false; n]
    var gi = 0
    while gi < inner.len():  # cpu-lane-loop-ok: union of the nested groups' members; bound is nested group count x node_count
        group_at[inner[gi].root] = gi
        var m = 0
        while m < n:  # cpu-lane-loop-ok: same union, inner node loop
            if inner[gi].members[m]:
                in_inner[m] = true
            m = m + 1
        gi = gi + 1
    var late_owner: [i32] = [-1; n]
    var hide: [bool] = [false; n]
    var i = 0
    while i < n:  # cpu-lane-loop-ok: one pre-order pass marking late subtrees (parent index < child index); bound is node_count x nested group count
        val parent = nodes[i].parent as i32
        if parent >= 0 and late_owner[parent] >= 0:
            late_owner[i] = late_owner[parent]
        elif not in_inner[i] and _raster_group_positioned(styles[i]) and _raster_group_visible(nodes, styles, i):
            for grp in inner:  # cpu-lane-loop-ok: overlap test against each nested group before this node
                if grp.root < i and bx[i] < grp.x + grp.w and bx[i] + bw[i] > grp.x and by[i] < grp.y + grp.h and by[i] + bh[i] > grp.y:
                    late_owner[i] = i
        hide[i] = in_inner[i] or late_owner[i] >= 0
        i = i + 1
    var out = _raster_paint_hiding(nodes, styles, hide, -1, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode, false)
    i = 0
    while i < n:  # cpu-lane-loop-ok: tree-order interleave of nested restores and late subtrees; each runs once
        if late_owner[i] == i:
            var only: [bool] = [true; n]
            var j = i
            while j < n:  # cpu-lane-loop-ok: the late subtree minus its nested groups; bound is node_count
                if late_owner[j] == i and not in_inner[j]:
                    only[j] = false
                j = j + 1
            out = _raster_paint_hiding(nodes, styles, only, -1, bx, by, bw, bh, wrap_cache, out, fbw, fbh, widget_mode, false)
        if group_at[i] >= 0:
            out = _raster_restore_group(nodes, styles, inner[group_at[i]], bx, by, bw, bh, wrap_cache, out, fbw, fbh, widget_mode)
        i = i + 1
    out

fn paint(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool) -> [u32]:
    if widget_mode:
        return _paint_passes(nodes, styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode)
    val groups = _raster_opacity_groups(nodes, styles, bx, by, bw, bh, fbw, fbh, false)
    if groups.len() == 0:
        return _paint_passes(nodes, styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode)
    val n = nodes.len() as i32
    var in_group: [bool] = [false; n]
    for grp in groups:  # cpu-lane-loop-ok: union of the admitted groups' members; bound is group count x node_count
        var i = 0
        while i < n:  # cpu-lane-loop-ok: same union, inner node loop
            if grp.members[i]:
                in_group[i] = true
            i = i + 1
    var out = _raster_paint_hiding(nodes, styles, in_group, -1, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode, false)
    for grp in groups:  # cpu-lane-loop-ok: one bounded layer paint + restore per admitted group
        out = _raster_restore_group(nodes, styles, grp, bx, by, bw, bh, wrap_cache, out, fbw, fbh, widget_mode)
    out

# Shared by Draw IR image lowering (`_html_draw_ir_fit_size`) and the raster <img> painter.
# reason: object-fit geometry helper over raw box/image extents
# @allow(primitive_api)
pub fn html_image_fit_size(
    object_fit: text, box_w: i32, box_h: i32,
    image_w: i32, image_h: i32
) -> (i32, i32):
    if object_fit == "fill":
        return (box_w, box_h)
    if object_fit == "none":
        return (image_w, image_h)
    val box_w64 = box_w.to_i64()
    val box_h64 = box_h.to_i64()
    val image_w64 = image_w.to_i64()
    val image_h64 = image_h.to_i64()
    val contain_by_width = box_w64 * image_h64 <= box_h64 * image_w64
    var contain_w = box_w
    var contain_h = (
        (box_w64 * image_h64) / image_w64
    ).to_i32()
    if not contain_by_width:
        contain_h = box_h
        contain_w = ((box_h64 * image_w64) / image_h64).to_i32()
    if object_fit == "contain":
        return (contain_w, contain_h)
    if object_fit == "scale-down":
        if image_w <= box_w and image_h <= box_h:
            return (image_w, image_h)
        return (contain_w, contain_h)
    val cover_by_width = box_w64 * image_h64 >= box_h64 * image_w64
    if cover_by_width:
        return (
            box_w, ((box_w64 * image_h64) / image_w64).to_i32()
        )
    (((box_h64 * image_w64) / image_h64).to_i32(), box_h)

# Decoded image resources for the current raster render. Set by
# `raster_set_images` around one paint; empty (the default) paints no <img>.
var _raster_images: [SimpleOsHostGpuImageResource] = []

# reason: renderer entry hands the decoded resource list to the raster painter
# @allow(primitive_api)
pub fn raster_set_images(images: [SimpleOsHostGpuImageResource]):
    _raster_images = images

fn _raster_image_for(uri: text) -> i32:
    var k = 0
    # cpu-lane-loop-ok: first valid resource per uri, same rule as _html_draw_ir_image_index_by_uri; bound is the supplied resource count
    while k < _raster_images.len():
        val im = _raster_images[k]
        if im.image_uri == uri and im.width > 0 and im.height > 0 and im.pixels.len() == im.width.to_i64() * im.height.to_i64():
            return k
        k = k + 1
    -1

# <img> pixels at the Draw IR geometry (content box, object-fit/position,
# content-box clip). ponytail: nearest-neighbour sampling - exact only for
# uniform images; Chrome resamples with a filter for non-uniform ones.
fn _raster_img_alpha(c: u32, opacity_pct: i32) -> u32:
    if opacity_pct >= 100:
        return c
    val a = ((c >> 24) & 255u32) as i32
    ((((a * opacity_pct + 50) / 100) as u32) << 24) | (c & 0x00FFFFFFu32)

fn _fb_paint_img_clip(out: [u32], fbw: i32, fbh: i32, nd: HNode, st: Style, x: i32, y: i32, w: i32, h: i32, clip: ClipRect) -> [u32]:
    val uri = attr_value(nd.attrs_raw, "src").trim()
    val idx = _raster_image_for(uri)
    if idx < 0:
        return out
    val box_x = x + st.border_l + st.pad_l
    val box_y = y + st.border_t + st.pad_t
    val box_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
    val box_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
    if box_w <= 0 or box_h <= 0:
        return out
    val im = _raster_images[idx]
    val (dw, dh) = html_image_fit_size(st.object_fit, box_w, box_h, im.width, im.height)
    if dw <= 0 or dh <= 0:
        return out
    val dx = box_x + ((box_w.to_i64() - dw.to_i64()) * object_position_x_pct(st.object_position).to_i64() / 100).to_i32()
    val dy = box_y + ((box_h.to_i64() - dh.to_i64()) * object_position_y_pct(st.object_position).to_i64() / 100).to_i32()
    val c = clip_intersect(clip, box_x, box_y, box_x + box_w, box_y + box_h)
    var x0 = if dx > c.x0: dx else: c.x0
    var y0 = if dy > c.y0: dy else: c.y0
    var x1 = if dx + dw < c.x1: dx + dw else: c.x1
    var y1 = if dy + dh < c.y1: dy + dh else: c.y1
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > fbw:
        x1 = fbw
    if y1 > fbh:
        y1 = fbh
    val opacity_pct = st.opacity_pct
    var res = out
    var py = y0
    # cpu-lane-loop-ok: one blend per covered pixel of the clipped image rect; bound is the visible rect area
    while py < y1:
        val sy = ((py - dy).to_i64() * im.height.to_i64() / dh.to_i64()).to_i32()
        var px = x0
        while px < x1:  # cpu-lane-loop-ok: row of the same clipped image rect
            val sx = ((px - dx).to_i64() * im.width.to_i64() / dw.to_i64()).to_i32()
            val at = py * fbw + px
            res[at] = engine2d_color_blend(_raster_img_alpha(im.pixels[sy * im.width + sx], opacity_pct), res[at])
            px = px + 1
        py = py + 1
    res

fn _paint_passes(nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool) -> [u32]:
    var out = fb
    # Reserve roughly half of whatever time remains in the paint stage for the
    # text pass. Draw order requires backgrounds/structural passes to run
    # first (text must land on top), but on a large real page those passes
    # alone can consume the entire remaining budget before the text pass —
    # the actually-visible content — ever gets a turn, leaving a degraded
    # render blank even though real geometry was computed. Restored to the
    # full paint deadline before the text pass below. In the common case
    # (budget never trips) this never matters: every pass finishes long
    # before either deadline.
    val paint_now_us = _web_budget_clock.now_micros()
    val paint_deadline_us = _web_render_deadline_us
    if paint_deadline_us > paint_now_us:
        _web_budget_rearm(paint_now_us + (paint_deadline_us - paint_now_us) / 2)
    val need_widget_text = widget_mode and widget_chrome_text_fits(fbw, fbh)
    val widget_flags = compute_widget_paint_flags(nodes, widget_mode, need_widget_text)
    val has_widget_panel = widget_flags.has_widget_panel
    val chrome_widget_text = need_widget_text and widget_flags.has_nonempty_widget_text
    val clip_cache = build_ancestor_clip_cache(nodes, styles, bx, by, bw, bh, fbw, fbh)
    # Outside widget mode a root gradient list is the canvas background: it
    # paints the canvas (positioned on the html box) instead of its own box.
    val canvas_src = if widget_mode: -1 else: canvas_gradient_source(nodes, styles)
    # backgrounds first (document order = back to front)
    val node_count = nodes.len()
    var i = 0
    var has_absolute_node = false
    # cpu-lane-loop-ok: fn paint pass 1 of 6: normal-flow (non-absolute, non-relative-root) box paint - shadow, background, border, outline plus widget panel and button fills, in document order = back to front. Bound is node_count; the CPU lane rasterises per node by design, and the pass is budget-guarded via _web_budget_expired_at
    while i < node_count:
        # Budget guard: stop painting backgrounds on expiry; the framebuffer keeps
        # whatever was painted so far (already sized width*height).
        if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_BACKGROUNDS):
            break
        val nd = nodes[i]
        val st = styles[i]
        if st.position_absolute:
            has_absolute_node = true
        val x = bx[i]
        val y = by[i]
        val w = bw[i]
        val h = bh[i]
        val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
        val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
        val relative_paint_root = has_relative_paint_root(nodes, styles, i)
        val normal_flow = not st.position_absolute and not relative_paint_root
        val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
        val visible_box = normal_flow and visible_node and nd.tag != "#text" and y < fbh
        val non_widget_mode = not widget_mode
        if visible_box:
            val paint_bg = i != canvas_src and not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32) or radial_gradient_box_paintable(st) or background_gradient_layers_paintable(st))
            val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
            if i == canvas_src:
                val canvas = canvas_background_extent(nodes, bx, by, bw, bh, fbw, fbh)
                val root_layers = canvas_gradient_layers(nodes, styles, bx, by, bw, bh, i)
                out = fb_gradient_layers_clip(out, fbw, fbh, 0, 0, canvas[0], canvas[1], root_layers, st.opacity_pct, paint_clip_at(clip_cache, i))
            val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
            val paint_shadow = not skip_widget_node_bg and (st.box_shadow_color != 0u32 or st.box_shadow_raw != "")
            if skip_widget_page_bg and nd.tag == "body" and st.bg_layers_raw != "":
                # widget pages suppress the flat page bg, but a radial-carrying
                # body background stack is the Chromium-visible page tint:
                # paint the linear base ramp, then the radial layers over it
                val clip = paint_clip_at(clip_cache, i)
                if st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32:
                    out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                # Chrome propagates the body background to the canvas: its
                # radial layers are positioned on, and paint, the canvas.
                # A gradient-only list paints every layer (linear too); any
                # other list keeps the radial-only stack painter.
                val canvas = canvas_background_extent(nodes, bx, by, bw, bh, fbw, fbh)
                val canvas_layers = background_gradient_layers(st.bg_layers_raw, 0, 0, canvas[0], canvas[1], st.font_size)
                if canvas_layers.len() > 0:
                    out = fb_gradient_layers_clip(out, fbw, fbh, 0, 0, canvas[0], canvas[1], canvas_layers, st.opacity_pct, clip)
                else:
                    out = fb_background_radial_stack_clip(out, fbw, fbh, 0, 0, canvas[0], canvas[1], st.bg_layers_raw, st.opacity_pct, clip)
            if paint_shadow or paint_bg or paint_border or paint_outline:
                val clip = paint_clip_at(clip_cache, i)
                if paint_shadow:
                    out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                if paint_bg:
                    out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                if paint_border:
                    out = _paint_node_border(out, fbw, fbh, x, y, w, h, nd, st, clip)
                if paint_outline:
                    out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
            if non_widget_mode and nd.tag == "img" and not nd.has_widget_image_class and _raster_images.len() > 0:
                out = _fb_paint_img_clip(out, fbw, fbh, nd, st, x, y, w, h, paint_clip_at(clip_cache, i))
        if normal_flow and non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
            val panel_h = h
            if st.bg == 0u32 and st.background_gradient_from == 0u32:
                out = fb_rect(out, fbw, fbh, x, y, w, panel_h, web_argb(245, 245, 245))
            if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                out = fb_rect(out, fbw, fbh, x, y, w, 1, web_argb(0, 102, 204))
        if normal_flow and non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
            if st.bg == 0u32 and st.background_gradient_from == 0u32:
                out = fb_rect(out, fbw, fbh, x, y, w, h, web_argb(203, 213, 225))
        i = i + 1
    i = 0
    # cpu-lane-loop-ok: fn paint pass 2 of 6: the relative-paint-root boxes pass 1 deliberately skipped, painted after normal flow so position:relative subtrees land above it. Disjoint node set from pass 1, so it cannot be fused without breaking paint order. Bound is node_count, budget-guarded
    while i < node_count:
        # Budget guard: stop scanning for relative-paint-root nodes on expiry.
        # This pass was completely unguarded — unlike every other O(node_count)
        # paint pass — so on a large real page it silently burned the rest of
        # the paint slice walking has_relative_paint_root/content_hidden_by_ancestor
        # for every node before the text pass ever got a chance to run, which is
        # why a degraded render still came out fully blank.
        if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_RELATIVE_ROOTS):
            break
        val nd = nodes[i]
        val st = styles[i]
        if has_relative_paint_root(nodes, styles, i) and not st.position_absolute:
            val x = bx[i]
            val y = by[i]
            val w = bw[i]
            val h = bh[i]
            val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
            val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
            val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
            val visible_box = visible_node and nd.tag != "#text" and y < fbh
            val non_widget_mode = not widget_mode
            if visible_box:
                val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32) or radial_gradient_box_paintable(st) or background_gradient_layers_paintable(st))
                val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
                val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
                val paint_shadow = not skip_widget_node_bg and (st.box_shadow_color != 0u32 or st.box_shadow_raw != "")
                if paint_shadow or paint_bg or paint_border or paint_outline:
                    val clip = paint_clip_at(clip_cache, i)
                    if paint_shadow:
                        out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_bg:
                        out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_border:
                        out = _paint_node_border(out, fbw, fbh, x, y, w, h, nd, st, clip)
                    if paint_outline:
                        out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
                if non_widget_mode and nd.tag == "img" and not nd.has_widget_image_class and _raster_images.len() > 0:
                    out = _fb_paint_img_clip(out, fbw, fbh, nd, st, x, y, w, h, paint_clip_at(clip_cache, i))
            if non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
                val panel_h = h
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, panel_h, web_argb(245, 245, 245))
                if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, 1, web_argb(0, 102, 204))
            if non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, h, web_argb(203, 213, 225))
        i = i + 1
    var positive_z_indices: [i32] = []
    var positive_z_count = 0
    var positive_z_sorted = true
    var last_positive_z = 0
    if has_absolute_node:
        i = 0
        # cpu-lane-loop-ok: fn paint pass 3 of 6: position:absolute boxes with z-index <= 0, plus collection of the positive-z indices consumed by pass 4. Bound is node_count, entered only when pass 1 saw an absolute node, budget-guarded
        while i < node_count:
            # Budget guard: stop scanning for absolute/z-index nodes on expiry.
            # This loop was unbounded — unlike the normal-flow background loop
            # right above it — so a page with any position:absolute node could
            # silently burn the rest of the paint slice here before the text
            # pass ever ran.
            if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_ABSOLUTE_LOW_Z):
                break
            val nd = nodes[i]
            val st = styles[i]
            if st.position_absolute and st.z_index <= 0:
                val x = bx[i]
                val y = by[i]
                val w = bw[i]
                val h = bh[i]
                val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
                val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
                val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
                val visible_box = visible_node and nd.tag != "#text" and y < fbh
                val non_widget_mode = not widget_mode
                if visible_box:
                    val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32) or radial_gradient_box_paintable(st) or background_gradient_layers_paintable(st))
                    val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
                    val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
                    val paint_shadow = not skip_widget_node_bg and (st.box_shadow_color != 0u32 or st.box_shadow_raw != "")
                    if paint_shadow or paint_bg or paint_border or paint_outline:
                        val clip = paint_clip_at(clip_cache, i)
                        if paint_shadow:
                            out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                        if paint_bg:
                            out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                        if paint_border:
                            out = _paint_node_border(out, fbw, fbh, x, y, w, h, nd, st, clip)
                        if paint_outline:
                            out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
                    if non_widget_mode and nd.tag == "img" and not nd.has_widget_image_class and _raster_images.len() > 0:
                        out = _fb_paint_img_clip(out, fbw, fbh, nd, st, x, y, w, h, paint_clip_at(clip_cache, i))
                if non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
                    val panel_h = h
                    if st.bg == 0u32 and st.background_gradient_from == 0u32:
                        out = fb_rect(out, fbw, fbh, x, y, w, panel_h, web_argb(245, 245, 245))
                    if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                        out = fb_rect(out, fbw, fbh, x, y, w, 1, web_argb(0, 102, 204))
                if non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
                    if st.bg == 0u32 and st.background_gradient_from == 0u32:
                        out = fb_rect(out, fbw, fbh, x, y, w, h, web_argb(203, 213, 225))
            elif st.position_absolute and st.z_index > 0:
                if positive_z_count == 0 and positive_z_indices.len() == 0:
                    positive_z_indices = [0; node_count]
                val current_positive_z = st.z_index
                if positive_z_count > 0 and current_positive_z < last_positive_z:
                    positive_z_sorted = false
                last_positive_z = current_positive_z
                positive_z_indices[positive_z_count] = i
                positive_z_count = positive_z_count + 1
            i = i + 1
    if positive_z_count > 0:
        if not positive_z_sorted:
            positive_z_indices = _sort_positive_z_indices(positive_z_indices, positive_z_count, styles)
        var positive_z_pos = 0
        # cpu-lane-loop-ok: fn paint pass 4 of 6: the positive-z absolute boxes gathered by pass 3, walked in z-sorted order. Bound is positive_z_count (absolute nodes with z-index > 0), not node_count
        while positive_z_pos < positive_z_count:
            # Budget guard: stop painting positive-z absolute boxes on expiry.
            # positive_z_count bounds this pass below node_count, so it is not
            # runaway the way passes 1-3 were -- but "bounded" is not "free":
            # every iteration walks content_paint_hidden_by_ancestor and can
            # rasterise a shadow/gradient, and passes 5 (scrollbars) and 6
            # (text) run AFTER it. Leaving this one pass unguarded is exactly
            # how a truncated render loses its text and still reports success,
            # so it names its site like the other five rather than being the
            # single silent exit in the family.
            if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_ABSOLUTE_HIGH_Z):
                break
            i = positive_z_indices[positive_z_pos]
            val nd = nodes[i]
            val st = styles[i]
            val x = bx[i]
            val y = by[i]
            val w = bw[i]
            val h = bh[i]
            val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
            val skip_widget_node_bg = widget_mode and (nd.has_widget_class or nd.has_icon_image_class)
            val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
            val visible_box = visible_node and nd.tag != "#text" and y < fbh
            val non_widget_mode = not widget_mode
            if visible_box:
                val paint_bg = not skip_widget_page_bg and not skip_widget_node_bg and (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32) or radial_gradient_box_paintable(st) or background_gradient_layers_paintable(st))
                val paint_border = not skip_widget_node_bg and (st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0)
                val paint_outline = not skip_widget_node_bg and st.outline_w > 0 and st.outline_color != 0u32
                val paint_shadow = not skip_widget_node_bg and (st.box_shadow_color != 0u32 or st.box_shadow_raw != "")
                if paint_shadow or paint_bg or paint_border or paint_outline:
                    val clip = paint_clip_at(clip_cache, i)
                    if paint_shadow:
                        out = paint_box_shadow(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_bg:
                        out = fb_style_background_opacity_clip(out, fbw, fbh, x, y, w, h, st, clip)
                    if paint_border:
                        out = _paint_node_border(out, fbw, fbh, x, y, w, h, nd, st, clip)
                    if paint_outline:
                        out = fb_outline_clip(out, fbw, fbh, x, y, w, h, st.outline_w, st.outline_offset_px, st.outline_color, clip)
                if non_widget_mode and nd.tag == "img" and not nd.has_widget_image_class and _raster_images.len() > 0:
                    out = _fb_paint_img_clip(out, fbw, fbh, nd, st, x, y, w, h, paint_clip_at(clip_cache, i))
            if non_widget_mode and visible_node and nd.has_widget_panel_class and y < fbh:
                val panel_h = h
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, panel_h, web_argb(245, 245, 245))
                if nd.has_focused_class and st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, 1, web_argb(0, 102, 204))
            if non_widget_mode and visible_node and nd.has_widget_button_class and y < fbh:
                if st.bg == 0u32 and st.background_gradient_from == 0u32:
                    out = fb_rect(out, fbw, fbh, x, y, w, h, web_argb(203, 213, 225))
            positive_z_pos = positive_z_pos + 1
    if widget_mode:
        out = fb_widget_chrome_rects(out, fbw, fbh, widget_frame_rects(fbw, fbh))
    if not widget_mode:
        i = 0
        # cpu-lane-loop-ok: fn paint pass 5 of 6: vertical scrollbar chrome for overflow-auto-y scrollports, painted above box content and below text. Bound is node_count, non-widget mode only, budget-guarded
        while i < node_count:
            # Budget guard: stop drawing scrollbars on expiry. This loop sits
            # between two already-guarded passes (backgrounds above, text below)
            # but was itself unbounded — on a large real page it could silently
            # burn the entire remaining paint slice walking content_hidden_by_ancestor
            # for every node before the text pass ever got a chance to run.
            if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_SCROLLBARS):
                break
            val nd = nodes[i]
            val st = styles[i]
            if st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i) and nd.tag != "#text" and st.overflow_auto_y and st.overflow_hidden:
                val x = bx[i]
                val y = by[i]
                val w = bw[i]
                val h = bh[i]
                if w >= 15 and h >= 8 and y < fbh:
                    val clip = paint_clip_at(clip_cache, i)
                    out = fb_vertical_scrollbar_clip(out, fbw, fbh, x + w - st.border_r - 15, y + st.border_t, h - st.border_t - st.border_b, st.scrollbar_track_color, st.scrollbar_thumb_color, clip)
            i = i + 1
    # Text is the actually-visible content: restore the full paint-stage
    # deadline (undoing the halving above) so the text pass gets whatever
    # time is left, instead of sharing what the structural passes didn't use.
    _web_budget_rearm(paint_deadline_us)
    # text on top
    i = 0
    # cpu-lane-loop-ok: fn paint pass 6 of 6: the content-on-top pass - #text runs, input accent controls, input text, widget image placeholders and icon chips. Bound is node_count; text must paint after every box pass, so this cannot be fused into them
    while i < node_count:
        # Budget guard: stop drawing text on expiry; painted pixels are kept.
        if _web_budget_expired_at(WEB_BUDGET_SITE_PAINT_TEXT):
            break
        val nd = nodes[i]
        val st = styles[i]
        val x = bx[i]
        val y = by[i]
        val w = bw[i]
        val h = bh[i]
        val visible_node = st.display != "none" and not st.visibility_hidden and not content_paint_hidden_by_ancestor(nodes, styles, i)
        val non_widget_mode = not widget_mode
        if non_widget_mode and visible_node and nd.tag == "input" and input_uses_accent_color(nd):
            val clip = paint_clip_at(clip_cache, i)
            out = fb_input_accent_control_clip(
                out, fbw, fbh, x, y, w, h,
                attr_value(nd.attrs_raw, "type").trim().lower(),
                input_is_checked(nd), st.accent_color, clip
            )
        if non_widget_mode and visible_node and nd.tag == "img" and nd.has_widget_image_class:
            val clip = paint_clip_at(clip_cache, i)
            out = fb_widget_image_placeholder_clip(out, fbw, fbh, x, y, w, h, st.object_fit, st.object_position, clip)
        if non_widget_mode and visible_node and nd.has_icon_image_class:
            val clip = paint_clip_at(clip_cache, i)
            val icon_color = if st.bg != 0u32: st.bg else: web_argb(37, 99, 235)
            out = fb_rect_clip(out, fbw, fbh, x, y, 6, 6, icon_color, clip)
        if non_widget_mode and visible_node and nd.tag == "select" and y < fbh and y + h > 0:
            val clip = paint_clip_at(clip_cache, i)
            out = fb_select_chevron_clip(
                out, fbw, fbh, x, y, w, h,
                st.pad_r, st.border_r, st.border_t, st.border_b,
                SELECT_ARROW_WIDTH_PX, st.fg, clip
            )
        if non_widget_mode and visible_node and nd.tag == "svg" and y < fbh and y + h > 0:
            val clip = paint_clip_at(clip_cache, i)
            out = _fb_paint_svg_rects_clip(out, fbw, fbh, nodes, styles, bx, by, bw, bh, i, clip)
        if (
            non_widget_mode and visible_node and nd.tag == "input" and
            not input_uses_accent_color(nd) and input_paints_text(nd)
        ):
            val scale = web_glyph_scale(st.font_size)
            val adv = input_text_glyph_advance(nd, st)
            val space_adv = style_space_advance(st)
            val content_w = w - st.border_l - st.border_r - st.pad_l - st.pad_r
            if content_w > 0:
                val plan = input_text_paint_plan(
                    nd, st, x, y, w, h, paint_clip_at(clip_cache, i)
                )
                if plan.text_value != "" and plan.baseline_y < fbh:
                    val use_ttf = (not web_bitmap_paint_lane()) and st.font_size > 8 and fb_text_ttf_available(st.resolved_font_identity, st.font_family, st.bold, st.font_style_italic)
                    if use_ttf:
                        val ttf_content_y = y + st.border_t + st.pad_t
                        val ttf_content_h = h - st.border_t - st.border_b - st.pad_t - st.pad_b
                        val ttf_base_y = fb_text_ttf_line_baseline_y(
                            ttf_content_y, ttf_content_h, st.font_size,
                            st.resolved_font_identity, st.font_family,
                            st.bold, st.font_style_italic
                        )
                        val input_by = style_run_byte_advances(st, plan.text_value)
                        if st.text_shadow_color != 0u32:
                            out = fb_text_ttf_aa_clip_range_adv(
                                out, fbw, fbh,
                                plan.baseline_x + st.text_shadow_x_px,
                                ttf_base_y + st.text_shadow_y_px,
                                plan.text_value, 0, plan.text_value.byte_len(),
                                st.text_shadow_color, st.font_size,
                                st.resolved_font_identity, st.font_family,
                                st.font_style_italic, st.bold, plan.clip, input_by
                            )
                        out = fb_text_ttf_aa_clip_range_adv(
                            out, fbw, fbh, plan.baseline_x, ttf_base_y,
                            plan.text_value, 0, plan.text_value.byte_len(),
                            plan.color, st.font_size,
                            st.resolved_font_identity, st.font_family,
                            st.font_style_italic, st.bold, plan.clip, input_by
                        )
                    else:
                        if st.text_shadow_color != 0u32:
                            out = fb_text_thin_scaled_clip_range(
                                out, fbw, fbh,
                                plan.baseline_x + st.text_shadow_x_px,
                                plan.baseline_y + st.text_shadow_y_px,
                                plan.text_value, 0, plan.text_value.byte_len(),
                                st.text_shadow_color, scale, adv, space_adv,
                                st.font_style_italic, st.bold, plan.clip
                            )
                        out = fb_text_thin_scaled_clip_range(
                            out, fbw, fbh, plan.baseline_x, plan.baseline_y,
                            plan.text_value, 0, plan.text_value.byte_len(), plan.color,
                            scale, adv, space_adv, st.font_style_italic, st.bold, plan.clip
                        )
        if visible_node and nd.tag == "#text" and not html_text_paint_fully_transparent(nd, st):
            # Match the layout measure: white-space:pre/nowrap preserves raw text
            # (leading indentation), normal flow uses trimmed text.
            val raw_txt: text = if st.white_space_nowrap: nd.text_data else: nd.text_trimmed
            val transformed_txt = apply_text_transform_for_paint(raw_txt, st.text_transform)
            val txt = if st.direction_rtl: bidi_visual_text_for_rtl(transformed_txt) else: transformed_txt
            if txt.len() > 0 and y < fbh:
                val lh = style_line_h(st)
                val node_starts = wrap_cache.starts[i]
                val node_ends = wrap_cache.ends[i]
                val line_count = node_starts.len()
                # Per-line box (`text_line_box_dx` / `text_line_box_w`): a run that starts
                # mid-line insets its first line only; a run beside a left
                # float insets exactly the lines layout shortened.
                if not chrome_widget_text:
                    if widget_mode:
                        out = fb_widget_chrome_rects(out, fbw, fbh, widget_offset_text_node_rects(nodes, styles, bx, by, bw, wrap_cache, i, fbw, fbh))
                    else:
                        val scale = web_glyph_scale(st.font_size)
                        val adv = style_text_advance(st)
                        val space_adv = style_space_advance(st)
                        val use_ttf = (not web_bitmap_paint_lane()) and st.font_size > 8 and fb_text_ttf_available(st.resolved_font_identity, st.font_family, st.bold, st.font_style_italic)
                        val text_x = x + text_ink_x_offset(st.font_size)
                        var ly = if use_ttf: y else: (y + text_ink_y_offset(st.font_size))
                        if line_count > 0:
                            val clip = paint_clip_at(clip_cache, i)
                            # ONE advance table for this run, built from the
                            # metrics LAYOUT measured it with, and handed to
                            # both the aligned-width call and the glyph walk
                            # below so the two cannot disagree.
                            val txt_by = style_run_byte_advances(st, txt)
                            val ttf_asc = if use_ttf: fb_text_ttf_ascent_px(st.font_size, st.resolved_font_identity, st.font_family, st.bold, st.font_style_italic) else: 0
                            var line_i = 0
                            # cpu-lane-loop-ok: per-wrapped-line glyph emission for one #text node on the normal path; bound is line_count from the wrap cache and it stops early at ly >= fbh; scale/adv/space_adv are already hoisted above the loop
                            while line_i < line_count and ly < fbh:
                                val draw_txt = if st.text_overflow_ellipsis and line_i == 0: ellipsize_text_for_width(txt, node_starts[line_i], node_ends[line_i], w - st.text_indent_px, st, adv, space_adv) else: txt
                                val draw_start = if st.text_overflow_ellipsis and line_i == 0: 0 else: node_starts[line_i]
                                val draw_end = if st.text_overflow_ellipsis and line_i == 0: draw_txt.byte_len() else: node_ends[line_i]
                                val line_dx = text_line_box_dx(wrap_cache.first_line_dx, wrap_cache.line_boxes, i, line_i)
                                val line_base_x = if line_i == 0: text_x + st.text_indent_px + line_dx else: text_x + line_dx
                                val line_box_w = text_line_box_w(wrap_cache.first_line_dx, wrap_cache.line_boxes, i, line_i, w) - (if line_i == 0: st.text_indent_px else: 0)
                                val line_by = if st.text_overflow_ellipsis and line_i == 0: [] else: txt_by
                                val line_w = if text_line_needs_paint_width(st, line_i, line_count): style_text_line_advance_width_with(line_by, draw_txt, draw_start, draw_end, adv, space_adv) else: 0
                                val line_text_x = text_line_aligned_x(line_base_x, line_box_w, line_w, st, line_i, line_count)
                                if use_ttf:
                                    val base_y = fb_text_ttf_line_baseline_y(ly, lh, st.font_size, st.resolved_font_identity, st.font_family, st.bold, st.font_style_italic)
                                    if st.text_shadow_color != 0u32:
                                        out = fb_text_ttf_aa_clip_range_adv(out, fbw, fbh, line_text_x + st.text_shadow_x_px, base_y + st.text_shadow_y_px, draw_txt, draw_start, draw_end, st.text_shadow_color, st.font_size, st.resolved_font_identity, st.font_family, st.font_style_italic, st.bold, clip, line_by)
                                    out = fb_text_ttf_aa_clip_range_adv(out, fbw, fbh, line_text_x, base_y, draw_txt, draw_start, draw_end, st.fg, st.font_size, st.resolved_font_identity, st.font_family, st.font_style_italic, st.bold, clip, line_by)
                                    if st.text_decoration_underline or st.text_decoration_overline or st.text_decoration_line_through:
                                        val underline_w = line_w
                                        val ul_gap = if st.font_size / 10 > 1: st.font_size / 10 else: 1
                                        val underline_y = base_y + ul_gap + st.text_underline_offset_px
                                        val underline_color = if st.text_decoration_color != 0u32: st.text_decoration_color else: st.fg
                                        if st.text_decoration_underline:
                                            out = fb_text_underline_clip(out, fbw, fbh, line_text_x, underline_y, underline_w, style_decoration_thickness_px(st), st.text_decoration_style, underline_color, clip)
                                        if st.text_decoration_overline:
                                            out = fb_text_underline_clip(out, fbw, fbh, line_text_x, base_y - ttf_asc, underline_w, style_decoration_thickness_px(st), st.text_decoration_style, underline_color, clip)
                                        if st.text_decoration_line_through:
                                            val strike_up = if st.font_size * 3 / 10 > 1: st.font_size * 3 / 10 else: 1
                                            out = fb_text_underline_clip(out, fbw, fbh, line_text_x, base_y - strike_up, underline_w, style_decoration_thickness_px(st), st.text_decoration_style, underline_color, clip)
                                else:
                                    if st.text_shadow_color != 0u32:
                                        out = fb_text_thin_scaled_clip_range_adv(out, fbw, fbh, line_text_x + st.text_shadow_x_px, ly + st.text_shadow_y_px, draw_txt, draw_start, draw_end, st.text_shadow_color, scale, adv, space_adv, st.font_style_italic, st.bold, clip, line_by)
                                    out = fb_text_thin_scaled_clip_range_adv(out, fbw, fbh, line_text_x, ly, draw_txt, draw_start, draw_end, st.fg, scale, adv, space_adv, st.font_style_italic, st.bold, clip, line_by)
                                    if st.text_decoration_underline or st.text_decoration_overline or st.text_decoration_line_through:
                                        val underline_w = line_w
                                        val underline_y = ly + 7 * scale + st.text_underline_offset_px
                                        val underline_color = if st.text_decoration_color != 0u32: st.text_decoration_color else: st.fg
                                        if st.text_decoration_underline:
                                            out = fb_text_underline_clip(out, fbw, fbh, line_text_x, underline_y, underline_w, style_decoration_thickness_px(st), st.text_decoration_style, underline_color, clip)
                                        if st.text_decoration_overline:
                                            out = fb_text_underline_clip(out, fbw, fbh, line_text_x, ly, underline_w, style_decoration_thickness_px(st), st.text_decoration_style, underline_color, clip)
                                        if st.text_decoration_line_through:
                                            out = fb_text_underline_clip(out, fbw, fbh, line_text_x, ly + 4 * scale, underline_w, style_decoration_thickness_px(st), st.text_decoration_style, underline_color, clip)
                                line_i = line_i + 1
                                ly = ly + lh
        i = i + 1
    if chrome_widget_text:
        out = fb_generated_widget_chrome_text(out, fbw, fbh)
    # Captured-Chromium overlays are not applied here: they paste expected
    # pixels instead of proving renderer behavior. Residual AA divergence vs a
    # browser font rasterizer is tracked as known-divergent in the manifest gate.
    out

# ---------------------------------------------------------------------------
# Tiled paint lane (T2 of tile_render_culling_plan): op-level culling on the
# 256px tile core, then rasterization through the unmodified paint(), so the
# surviving output is pixel-identical to the classic painter by construction.
# Gated by SIMPLE_WEB_TILE_PAINT at the render-entry dispatch site (default
# off; flag-off never enters this function).
# ---------------------------------------------------------------------------

fn _tile_style_hash(st: Style) -> i64:
    var h = st.bg as i64
    h = h ^ ((st.fg as i64) << 16)
    h = h ^ ((st.border_color_t as i64) << 8)
    h = h ^ ((st.opacity_pct as i64) << 48)
    h

fn _tile_abs_i32(v: i32) -> i32:
    if v < 0: -v else: v

fn _tile_hidden_op(i: i32) -> TileOp:
    tile_op(0, i, 0, 0, 0, 0, true, false, 0, -1)

# Culling record for one node's box-phase paint (backgrounds, borders,
# outlines, shadows, widget panel/button fills). Mirrors the per-pass
# predicates of paint() — the same visibility checks, not a reimplementation
# of different ones — and inflates the rect for paint that lands outside the
# border box (outline offset, box shadow). Non-widget path only: paint_tiled
# falls back to paint() for widget_mode.
fn _tile_box_op(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    clip_cache: PaintClipCache, fbh: i32, i: i32, has_widget_panel: bool
) -> TileOp:
    val nd = nodes[i]
    val st = styles[i]
    val x = bx[i]
    val y = by[i]
    val w = bw[i]
    val h = bh[i]
    val skip_widget_page_bg = has_widget_panel and (nd.tag == "html" or nd.tag == "body")
    val visible_node = (
        st.display != "none" and not st.visibility_hidden and
        not content_paint_hidden_by_ancestor(nodes, styles, i)
    )
    val visible_box = visible_node and nd.tag != "#text" and y < fbh
    val paint_bg = (
        not skip_widget_page_bg and
        (st.bg != 0u32 or (st.background_gradient_from != 0u32 and st.background_gradient_to != 0u32) or radial_gradient_box_paintable(st) or background_gradient_layers_paintable(st))
    )
    val paint_border = st.border_l > 0 or st.border_t > 0 or st.border_r > 0 or st.border_b > 0
    val paint_outline = st.outline_w > 0 and st.outline_color != 0u32
    val paint_shadow = st.box_shadow_color != 0u32 or st.box_shadow_raw != ""
    val paint_body_radial = skip_widget_page_bg and nd.tag == "body" and st.bg_layers_raw != ""
    val paint_panel = (
        visible_node and y < fbh and
        (nd.has_widget_panel_class or nd.has_widget_button_class) and
        st.bg == 0u32 and st.background_gradient_from == 0u32
    )
    val paints = (
        (visible_box and (paint_bg or paint_border or paint_outline or paint_shadow or paint_body_radial)) or
        paint_panel
    )
    if not paints:
        return _tile_hidden_op(i)
    var ix0 = x
    var iy0 = y
    var ix1 = x + w
    var iy1 = y + h
    if paint_outline:
        val o = st.outline_w + _tile_abs_i32(st.outline_offset_px)
        ix0 = ix0 - o
        iy0 = iy0 - o
        ix1 = ix1 + o
        iy1 = iy1 + o
    if paint_shadow:
        val spread = _paint_shadow_pad(st)
        ix0 = ix0 - spread
        iy0 = iy0 - spread
        ix1 = ix1 + spread
        iy1 = iy1 + spread
    if paint_body_radial:
        # The body radial stack is the propagated canvas background: it
        # paints the whole viewport (bounded by the clip below).
        ix0 = 0
        iy0 = 0
        ix1 = 1073741823
        iy1 = fbh
    # Panel/button fills paint through fb_rect (no clip); everything else
    # honors the ancestor clip, so clip-intersecting the rect keeps the bins
    # tight while staying conservative.
    if not paint_panel:
        val clip = paint_clip_at(clip_cache, i)
        if ix0 < clip.x0:
            ix0 = clip.x0
        if iy0 < clip.y0:
            iy0 = clip.y0
        if ix1 > clip.x1:
            ix1 = clip.x1
        if iy1 > clip.y1:
            iy1 = clip.y1
    # T3 opaque-occluder candidate: a plain full-alpha color fill over the
    # whole border box, nothing translucent/rounded/offset about it.
    val opaque = (
        visible_box and paint_bg and not paint_panel and
        not paint_shadow and not paint_outline and not paint_border and
        not paint_body_radial and
        st.background_gradient_from == 0u32 and st.background_gradient_to == 0u32 and
        st.bg_layers_raw == "" and st.background_image_uri == "" and
        st.background_clip == "border-box" and
        st.border_radius_px == 0 and st.border_radius_tl_px == 0 and
        st.border_radius_tr_px == 0 and st.border_radius_br_px == 0 and
        st.border_radius_bl_px == 0 and
        st.opacity_pct >= 100 and (((st.bg as i64) >> 24) & 255) == 255
    )
    tile_op(0, i, ix0, iy0, ix1 - ix0, iy1 - iy0, false, opaque, _tile_style_hash(st), -1)

# Culling record for one node's content-on-top phase (the text pass): #text
# runs, input text/accent controls, widget image placeholders, icon chips.
# Text may overflow its layout box horizontally (nowrap, ellipsis, spacing),
# so #text ops use a conservative full-clip-width band around the box's y
# range instead of the exact box rect.
fn _tile_text_op(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    clip_cache: PaintClipCache, fbh: i32, i: i32
) -> TileOp:
    val nd = nodes[i]
    val st = styles[i]
    val visible_node = (
        st.display != "none" and not st.visibility_hidden and
        not content_paint_hidden_by_ancestor(nodes, styles, i)
    )
    if not visible_node:
        return _tile_hidden_op(i)
    if nd.tag == "#text":
        val raw_txt: text = if st.white_space_nowrap: nd.text_data else: nd.text_trimmed
        if raw_txt.len() == 0 or by[i] >= fbh:
            return _tile_hidden_op(i)
        val clip = paint_clip_at(clip_cache, i)
        # Decoration ink overflows the glyph/line box independently. CSS px
        # thickness is not a bitmap-glyph scale; double adds a second stroke
        # and its one-pixel gap. Keep the ancestor overflow clip below intact.
        val thickness = style_decoration_thickness_px(st)
        val decoration_h = if st.text_decoration_style == "double": thickness * 2 + 1 else: thickness
        val overhang = 16 + _tile_abs_i32(st.text_shadow_y_px) + _tile_abs_i32(st.text_underline_offset_px) + decoration_h
        var y0 = by[i] - overhang
        var y1 = by[i] + bh[i] + overhang
        if y0 < clip.y0:
            y0 = clip.y0
        if y1 > clip.y1:
            y1 = clip.y1
        return tile_op(
            1, i, clip.x0, y0, clip.x1 - clip.x0, y1 - y0,
            false, false, _tile_style_hash(st), -1
        )
    val is_content = (
        nd.tag == "input" or nd.tag == "select" or nd.tag == "svg" or
        (nd.tag == "img" and nd.has_widget_image_class) or
        nd.has_icon_image_class
    )
    if not is_content:
        return _tile_hidden_op(i)
    val clip = paint_clip_at(clip_cache, i)
    var x0 = bx[i] - 8
    var y0 = by[i] - 8
    var x1 = bx[i] + bw[i] + 8
    var y1 = by[i] + bh[i] + 8
    if x0 < clip.x0:
        x0 = clip.x0
    if y0 < clip.y0:
        y0 = clip.y0
    if x1 > clip.x1:
        x1 = clip.x1
    if y1 > clip.y1:
        y1 = clip.y1
    tile_op(1, i, x0, y0, x1 - x0, y1 - y0, false, false, _tile_style_hash(st), -1)

# Emit culling records in paint() order — normal-flow boxes, relative-root
# boxes, absolute z<=0, absolute z>0 (z-sorted), scrollbars, then the text
# pass — so "later op occludes earlier op" in a tile bin matches real paint
# order (text paints after every box and is never occlusion-culled).
fn _tile_paint_ops(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    clip_cache: PaintClipCache, fbh: i32, has_widget_panel: bool
) -> [TileOp]:
    val node_count = nodes.len()
    if node_count <= 0:
        return []
    # Exactly one box and one text slot per node, plus at most one scrollbar.
    # Indexed stores give this hot path a bounded allocation profile regardless
    # of the runtime's bare-push growth strategy; tile_op_buffer_finish performs
    # one final linear trim.
    var ops: [TileOp] = [_tile_hidden_op(0); node_count * 3]
    var op_count = 0
    var i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 1 of 6: emits box culling ops for normal-flow nodes, mirroring fn paint pass 1's node set so tile bin order equals real paint order. Bound is node_count
    while i < node_count:
        val st = styles[i]
        if not st.position_absolute and not has_relative_paint_root(nodes, styles, i):
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i, has_widget_panel)
            op_count = op_count + 1
        i = i + 1
    i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 2 of 6: box ops for relative-paint-root nodes, mirroring fn paint pass 2. Disjoint from pass 1 and must stay a separate later pass so the bins record the true occlusion order
    while i < node_count:
        if has_relative_paint_root(nodes, styles, i) and not styles[i].position_absolute:
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i, has_widget_panel)
            op_count = op_count + 1
        i = i + 1
    i = 0
    var positive_z_indices: [i32] = [0; node_count]
    var positive_z_count = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 3 of 6: box ops for absolute z <= 0 nodes plus collection of the positive-z indices, mirroring fn paint pass 3. Bound is node_count
    while i < node_count:
        val st = styles[i]
        if st.position_absolute and st.z_index <= 0:
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i, has_widget_panel)
            op_count = op_count + 1
        elif st.position_absolute:
            positive_z_indices[positive_z_count] = i
            positive_z_count = positive_z_count + 1
        i = i + 1
    if positive_z_count > 0:
        val sorted_z = _sort_positive_z_indices(positive_z_indices, positive_z_count, styles)
        var zp = 0
        # cpu-lane-loop-ok: _tile_paint_ops pass 4 of 6: box ops for the z-sorted positive-z absolute nodes; bound is positive_z_count, not node_count
        while zp < positive_z_count:
            ops[op_count] = _tile_box_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, sorted_z[zp], has_widget_panel)
            op_count = op_count + 1
            zp = zp + 1
    i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 5 of 6: scrollbar culling ops for overflow-auto-y scrollports, mirroring fn paint pass 5. Bound is node_count
    while i < node_count:
        val nd = nodes[i]
        val st = styles[i]
        if (
            st.overflow_auto_y and st.overflow_hidden and nd.tag != "#text" and
            st.display != "none" and not st.visibility_hidden and
            not content_paint_hidden_by_ancestor(nodes, styles, i) and
            bw[i] >= 15 and bh[i] >= 8 and by[i] < fbh
        ):
            val clip = paint_clip_at(clip_cache, i)
            var sx0 = bx[i] + bw[i] - st.border_r - 15
            var sy0 = by[i]
            var sx1 = bx[i] + bw[i]
            var sy1 = by[i] + bh[i]
            if sx0 < clip.x0:
                sx0 = clip.x0
            if sy0 < clip.y0:
                sy0 = clip.y0
            if sx1 > clip.x1:
                sx1 = clip.x1
            if sy1 > clip.y1:
                sy1 = clip.y1
            ops[op_count] = tile_op(2, i, sx0, sy0, sx1 - sx0, sy1 - sy0, false, false, _tile_style_hash(st), -1)
            op_count = op_count + 1
        i = i + 1
    i = 0
    # cpu-lane-loop-ok: _tile_paint_ops pass 6 of 6: one text-phase culling op per node (hidden ops included so op indices stay dense and text is never occlusion-culled). Bound is node_count
    while i < node_count:
        ops[op_count] = _tile_text_op(nodes, styles, bx, by, bw, bh, clip_cache, fbh, i)
        op_count = op_count + 1
        i = i + 1
    tile_op_buffer_finish(ops, op_count)

fn paint_tiled(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    wrap_cache: TextWrapCache, fb: [u32], fbw: i32, fbh: i32, widget_mode: bool,
    viewport_y: i32, viewport_h: i32
) -> [u32]:
    # Widget chrome framebuffers are tiny (< one tile) and use unclipped
    # chrome overdraw; tiling buys nothing there — keep the classic painter.
    if widget_mode:
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, widget_mode)
    val need_widget_text = false
    val widget_flags = compute_widget_paint_flags(nodes, false, need_widget_text)
    val clip_cache = build_ancestor_clip_cache(nodes, styles, bx, by, bw, bh, fbw, fbh)
    val ops = _tile_paint_ops(
        nodes, styles, bx, by, bw, bh, clip_cache, fbh, widget_flags.has_widget_panel
    )
    val grid = tile_grid_make(0, 0, fbw, fbh)
    val bins = tile_bin_ops(ops, grid)
    val live = tile_live_set(grid, 0, viewport_y, fbw, viewport_h, TILE_MARGIN_PX)
    val surv = tile_survivors(ops, bins, grid, live)
    val node_count = nodes.len()
    var keep: [bool] = [false; node_count]
    var ops_total: i64 = 0
    var ops_painted: i64 = 0
    val op_count = ops.len()
    var oi = 0
    # cpu-lane-loop-ok: folds the emitted culling ops into the per-node keep[] mask and the ops_total/ops_painted tile stats; bound is op_count (about 6 ops per node), one linear fold
    while oi < op_count:
        val op = ops[oi]
        if not op.hidden:
            ops_total = ops_total + 1
            if surv[oi]:
                ops_painted = ops_painted + 1
                keep[op.node] = true
        oi = oi + 1
    val tiles = tile_count(grid)
    var tiles_live: i64 = 0
    var tiles_occluded: i64 = 0
    var t = 0
    # cpu-lane-loop-ok: counts live and occluded tiles for tile_stats_record; bound is tile_count(grid) = ceil(fbw/256) * ceil(fbh/256) tiles, not pixels or elements
    while t < tiles:
        if live[t]:
            tiles_live = tiles_live + 1
            if tile_occluder_slot(ops, bins, grid, t) > bins.starts[t]:
                tiles_occluded = tiles_occluded + 1
        t = t + 1
    tile_stats_record(
        ops_total, ops_painted, tiles as i64, tiles_live,
        (tiles as i64) - tiles_live, tiles_occluded
    )
    # Cull by marking non-survivors visibility:hidden for the duration of the
    # paint: that suppresses exactly the node's own paint in every paint()
    # pass without touching pass structure, clip cache, z-order, or sibling
    # paint — then the unmodified paint() rasters the survivors, so surviving
    # output is identical to the untiled painter by construction. Original
    # values are restored afterwards in case Style is shared by reference.
    var culled_styles = styles
    var prev_hidden: [bool] = [false; node_count]
    var ci = 0
    # cpu-lane-loop-ok: marks non-surviving nodes visibility:hidden so the unmodified paint() skips them; single O(node_count) pass over the style array
    while ci < node_count:
        prev_hidden[ci] = culled_styles[ci].visibility_hidden
        if not keep[ci]:
            var cst = culled_styles[ci]
            cst.visibility_hidden = true
            culled_styles[ci] = cst
        ci = ci + 1
    var out = paint(nodes, culled_styles, bx, by, bw, bh, wrap_cache, fb, fbw, fbh, false)
    ci = 0
    # cpu-lane-loop-ok: restores the visibility_hidden values saved by the cull pass above; single O(node_count) pass, paired one-to-one with it
    while ci < node_count:
        if culled_styles[ci].visibility_hidden != prev_hidden[ci]:
            var rst = culled_styles[ci]
            rst.visibility_hidden = prev_hidden[ci]
            culled_styles[ci] = rst
        ci = ci + 1
    out

# =========================================================================
# `contain: paint` fast path for paint_selected. See containment.spl for
# why this reads the attribute the same array/index-positional way as the
# `contain: layout` lane in simple_web_html_layout_renderer_layout.spl
# (node_contain_layout / layout_contain_boundary / layout_selected there),
# rather than reusing that file's Dict-keyed cache.
#
# CSS semantics: a `contain: paint` node promises nothing inside its
# subtree paints outside its own border box (no overflow, no escaping
# absolutely-positioned descendants, no bleeding filters/shadows). That
# licenses the fast path below to repaint ONLY the contained subtree's
# nodes and leave every pixel outside it exactly as it was in the
# retained framebuffer -- it does NOT license the converse (nothing
# outside paints INTO the boundary's box area is not a CSS guarantee: a
# sibling with a higher z-index can still visually overlap it), so
# correctness never depends on that converse: the fast path only ever
# SUPPRESSES nodes strictly outside the boundary subtree from repainting
# (leaving their previously-painted pixels untouched); it never claims
# the boundary's screen region belongs exclusively to the subtree.
# =========================================================================

fn node_contain_paint(node: HNode) -> bool:
    contain_value_contains_paint(attr_value(node.attrs_raw, "contain"))

fn nearest_contain_paint_ancestor(nodes: [HNode], idx: i32) -> i32:
    var cur = nodes[idx].parent as i32
    while cur >= 0:
        if node_contain_paint(nodes[cur]):
            return cur
        cur = nodes[cur].parent as i32
    -1

# Nearest `contain: paint` ancestor shared by every dirty structural id.
# Same conservative all-or-nothing restriction as layout_contain_boundary:
# a mutation batch touching two different contained subtrees, or one that
# isn't contained at all, falls straight through to a full repaint below
# rather than attempting a partial region reuse.
fn paint_contain_boundary(nodes: [HNode], dirty_structural_ids: [i64]) -> i32:
    val node_count = nodes.len() as i32
    var boundary: i32 = -1
    var first = true
    for structural_id in dirty_structural_ids:
        val idx = (structural_id - 1) as i32
        if idx < 0 or idx >= node_count:
            return -1
        val b = nearest_contain_paint_ancestor(nodes, idx)
        if b < 0:
            return -1
        if first:
            boundary = b
            first = false
        elif b != boundary:
            return -1
    boundary

# True when node `i` is `boundary` itself or a descendant of it (walks the
# parent chain). Used to decide which nodes the fast path is allowed to
# repaint; every other node is suppressed via the same visibility_hidden
# trick paint_tiled already uses for tile culling (see paint_tiled above),
# so the unmodified `paint()` raster loop performs zero drawing work for
# them -- this is the actual "paint work skipped" the containment feature
# buys, not merely a trust-the-attribute shortcut.
fn node_in_paint_subtree(nodes: [HNode], boundary: i32, i: i32) -> bool:
    if i == boundary:
        return true
    var cur = nodes[i].parent as i32
    while cur >= 0:
        if cur == boundary:
            return true
        cur = nodes[cur].parent as i32
    false

fn paint_contain_subtree_members(nodes: [HNode], boundary: i32) -> [bool]:
    """Build the containment mask once for a retained repaint.

    The canonical parse_html HNode arena places parents before children, so
    membership is inherited in one forward pass rather than walking a parent
    chain for every node. Malformed/non-topological input retains the old exact
    chain walk, preserving the fast path's conservative behaviour.
    """
    var members: [bool] = []
    var i = 0
    while i < nodes.len():
        var inside = i == boundary
        if not inside:
            val parent = nodes[i].parent as i32
            if parent >= 0 and parent < i:
                inside = members[parent]
            elif parent >= 0:
                inside = node_in_paint_subtree(nodes, boundary, i)
        members.push(inside)
        i += 1
    members

fn paint_contain_subtree_node_count(nodes: [HNode], boundary: i32) -> i32:
    val members = paint_contain_subtree_members(nodes, boundary)
    var total = 0
    var i = 0
    while i < members.len():
        if members[i]:
            total = total + 1
        i = i + 1
    total

pub fn paint_contain_boundary_subtree_size(nodes: [HNode], dirty_structural_ids: [i64]) -> i32:
    """Public probe for the correctness/proportionality spec: the count of
    nodes the fast path actually re-runs paint work for, or the full node
    count when no `contain: paint` boundary covers the dirty set (i.e. no
    savings claimed, matching layout_contain_boundary_subtree_size)."""
    val boundary = paint_contain_boundary(nodes, dirty_structural_ids)
    if boundary < 0:
        return nodes.len() as i32
    paint_contain_subtree_node_count(nodes, boundary)

pub fn paint_selected(
    nodes: [HNode], styles: [Style], bx: [i32], by: [i32], bw: [i32], bh: [i32],
    wrap_cache: TextWrapCache, retained_fb: [u32], retained_bw: i32, retained_bh: i32,
    fbw: i32, fbh: i32, widget_mode: bool, dirty_structural_ids: [i64]
) -> [u32]:
    """Incremental repaint entry point, mirroring layout_selected's shape.
    `retained_fb` is the pixel buffer produced by the last full (or fast-
    path) paint of this same document at size fbw x fbh; `retained_bw` /
    `retained_bh` are the `contain: paint` boundary candidate's own box
    dimensions AT THAT TIME. `dirty_structural_ids` (1-based, matching
    layout_selected's convention) lists every node whose content changed
    since then.

    Correctness does not rely on trusting the `contain: paint` attribute:
    the boundary's freshly recomputed box (bw[boundary]/bh[boundary]) is
    compared against `retained_bw`/`retained_bh` below, and any mismatch
    (a lying/violating `contain: paint`, or the boundary having moved or
    resized for any other reason since the retained frame) falls through
    to the unconditional full repaint, so this fast path can only ever
    produce output identical to `paint(...)`, never wrong output."""
    if dirty_structural_ids.len() == 0:
        return retained_fb
    if (
        nodes.len() != styles.len() or bx.len() != nodes.len() or
        by.len() != nodes.len() or bw.len() != nodes.len() or bh.len() != nodes.len() or
        retained_fb.len() != fbw * fbh
    ):
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)
    for structural_id in dirty_structural_ids:
        if structural_id <= 0 or structural_id > nodes.len():
            return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)

    val boundary = paint_contain_boundary(nodes, dirty_structural_ids)
    if boundary < 0:
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)
    if bw[boundary] != retained_bw or bh[boundary] != retained_bh:
        return paint(nodes, styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)

    val node_count = nodes.len()
    val subtree_members = paint_contain_subtree_members(nodes, boundary)
    var culled_styles = styles
    var i = 0
    # cpu-lane-loop-ok: suppresses every node outside the contain:paint
    # boundary subtree so the unmodified paint() call below performs no
    # raster work for them; bound is node_count, one linear pass
    while i < node_count:
        if not subtree_members[i]:
            var cst = culled_styles[i]
            cst.visibility_hidden = true
            culled_styles[i] = cst
        i = i + 1
    paint(nodes, culled_styles, bx, by, bw, bh, wrap_cache, retained_fb, fbw, fbh, widget_mode)

# ---------------------------------------------------------------------------
# Render entry
# ---------------------------------------------------------------------------
