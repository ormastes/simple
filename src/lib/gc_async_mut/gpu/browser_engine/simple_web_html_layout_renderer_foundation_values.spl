# Value parsers for the Simple web renderer: position-aware string find,
# nil-free CSS value parsers (color tokens, lengths, gradient stop pieces,
# transforms, line-height, object-position), declaration-table readers,
# and the raw declaration-text helpers (decl_get, ws_tokens).
# Split out of simple_web_html_layout_renderer_foundation.spl, which
# re-exports every name defined here.

use std.gc_async_mut.gpu.browser_engine.dom_color.{parse_color_value_checked}

# ---------------------------------------------------------------------------
# Position-aware string find (works around index_of(needle,pos) ignoring pos)
# ---------------------------------------------------------------------------

fn text_index_of(haystack: text, needle: text) -> i32:
    find_from(haystack, needle, 0)

fn text_matches_at(haystack: text, needle: text, offset: i32) -> bool:
    # BYTE-indexed. `offset` is a byte offset and every index below is a byte
    # index. This is the only self-consistent choice: `len()`, `slice()`,
    # `substring()` and `index_of()` are ALL byte-indexed, and callers feed the
    # offsets these scanners return straight into `substring`/`slice`.
    #
    # Do NOT reintroduce `char_code_at`/`char_at` here. Both are CHARACTER-
    # indexed, so bounding a loop with `len()` (bytes) while probing with
    # `char_code_at` (characters) silently returns a character index into a
    # byte-indexed world; on any multi-byte document every downstream
    # `substring` then cuts mid-sequence and truncates. That was the defect
    # this form replaces (regression guard:
    # test/01_unit/lib/gc_async_mut/gpu/browser_engine/
    # simple_web_html_layout_renderer_scan_index_space_spec.spl).
    #
    # `bytes()` keeps the original freestanding-safety property that motivated
    # `char_code_at`: the comparison is between two plain integers, so no
    # boolean crosses a runtime text-builtin boundary. The SimpleOS x86_64
    # kernel build mis-marshals boolean results from text builtins at depth
    # (doc/08_tracking/bug/x64_freestanding_text_char_at_starts_with.md,
    # residual item 3), which is what collapsed `_html_scan_events` to zero
    # events in the guest while the host produced a full DOM. It also avoids
    # the per-character heap string `char_at` would allocate.
    val needle_len = needle.byte_len() as i32
    if (offset < 0) or offset + needle_len > (haystack.byte_len() as i32):
        return false
    if needle_len == 0:
        return true
    val hb = haystack.bytes()
    val nb = needle.bytes()
    var j = 0
    while j < needle_len:
        if hb[offset + j] != nb[j]:
            return false
        j = j + 1
    true

# Freestanding-safe replacement for `s.starts_with(literal)`. Same rationale as
# text_matches_at: no boolean crosses a runtime call boundary.
fn text_starts_with_portable(s: text, prefix: text) -> bool:
    text_matches_at(s, prefix, 0)

# Advance past ASCII spaces. Defined in this base module because BOTH
# ..._style.spl (parse_font_shorthand_family) and ..._layout.spl call it, and
# _style sits below _layout in the import order.
fn skip_wrap_spaces(txt: text, off: i32) -> i32:
    # BYTE-indexed: `off` in, byte offset out, so the result composes with
    # `substring`/`slice`. A space is ASCII, but the INDEX still has to be a
    # byte index — `char_code_at` here returned a character index that callers
    # then cut on, truncating any string containing multi-byte text.
    var out = off
    val n = txt.byte_len() as i32
    if out >= n:
        return out
    val b = txt.bytes()
    while out < n and b[out] == 32:
        out = out + 1
    out

fn find_from(s: text, needle: text, pos: i32) -> i32:
    web_find_from(s, needle, pos)

# @allow(primitive_api): internal sibling-module byte-offset substring scan helper
pub fn web_find_from(s: text, needle: text, pos: i32) -> i32:
    # Positional search, BYTE-indexed throughout: `pos` in, byte index out.
    # Do not emulate this through substring(start).index_of(): native
    # substring can be an untagged slice and index_of then returns a bogus
    # near-zero offset for non-zero starts.
    #
    # The scan itself is the two-argument `index_of(needle, start)`, which the
    # interpreter (interpreter_method/string.rs) and the compiled lane
    # (`rt_text_find`) both implement as a native byte search from `start`.
    # It used to be an interpreted byte loop over `s.bytes()`: every call
    # copied the WHOLE haystack into a byte array before looking at a single
    # byte, so the stylesheet scanners (thousands of calls over a ~300 KB
    # sheet) were quadratic. Wikipedia's sheet took 13-16 s in CSS custom-
    # property collection alone, exhausting the render budget before the
    # first element was styled (0 pixels). The early returns below are kept
    # so the edge cases answer exactly as before (an empty needle returns
    # `start` even past the end, which native index_of would clamp).
    val start = if pos < 0: 0 else: pos
    val nlen = needle.byte_len() as i32
    if nlen == 0:
        return start
    val slen = s.byte_len() as i32
    if start >= slen or slen < nlen:
        return -1
    s.index_of(needle, start) as i32

fn html_attr_name_byte_equal(actual: i64, expected: i64) -> bool:
    var actual_folded = actual
    var expected_folded = expected
    if actual_folded >= 65 and actual_folded <= 90:
        actual_folded = actual_folded + 32
    if expected_folded >= 65 and expected_folded <= 90:
        expected_folded = expected_folded + 32
    actual_folded == expected_folded

fn attr_key_index(inner: text, key: text, key_len: i32) -> i32:
    if key_len == 0:
        return 0
    # BYTE-indexed, like the other scanners here: the returned index is used as
    # a byte offset by callers. `char_at` is CHARACTER-indexed, so pairing it
    # with `inner.len()` (bytes) mis-located every attribute in a tag whose
    # inner text contained multi-byte characters (e.g. a non-ASCII alt/title
    # value preceding the attribute being read).
    val inner_len = inner.byte_len() as i32
    if inner_len < key_len:
        return -1
    val ib = inner.bytes()
    val kb = key.bytes()
    val first = kb[0]
    val limit = inner_len - key_len
    var i = 0
    # Quote-aware scan: a key substring that lands INSIDE a quoted attribute
    # value is not a real attribute. This matters for values that embed markup —
    # e.g. an <iframe srcdoc="...div style='height:10px'..."> must not have its
    # own `style=`/`width=`/`height=` read from inside the srcdoc value.
    # 0 = not inside a quoted value; otherwise the opening quote byte
    # (34 = '"', 39 = '\''). Byte comparisons keep this freestanding-safe.
    var quote = 0
    while i <= limit:
        val ci = ib[i]
        if quote != 0:
            if ci == quote:
                quote = 0
            i = i + 1
            continue
        if ci == 34 or ci == 39:
            quote = ci
            i = i + 1
            continue
        if html_attr_name_byte_equal(ci, first):
            # Left word-boundary guard: a candidate match is only a real
            # attribute when it starts the inner text or follows ASCII
            # whitespace. Without this, a longer attribute name ending with
            # the key falsely matches — `align=` inside `valign=`, `bgcolor=`
            # inside `data-bgcolor=`, `width=` inside `data-width=`.
            var at_token_start = i == 0
            if not at_token_start:
                # 32 = space, 9 = tab, 10 = LF, 13 = CR
                val prev = ib[i - 1]
                at_token_start = prev == 32 or prev == 9 or prev == 10 or prev == 13
            if at_token_start:
                var j = 1
                var matched = true
                while j < key_len:
                    if not html_attr_name_byte_equal(ib[i + j], kb[j]):
                        matched = false
                        break
                    j = j + 1
                if matched:
                    return i
        i = i + 1
    -1

fn attr_present(inner: text, name: text) -> bool:
    if name.byte_len() == 0 or inner.byte_len() < name.byte_len():
        return false
    val ib = inner.bytes()
    val nb = name.bytes()
    val limit = inner.byte_len() - name.byte_len()
    var quote = 0
    var i = 0
    while i <= limit:
        val current = ib[i]
        if quote != 0:
            if current == quote:
                quote = 0
            i = i + 1
            continue
        if current == 34 or current == 39:
            quote = current
            i = i + 1
            continue
        var token_start = i == 0
        if not token_start:
            val previous = ib[i - 1]
            token_start = (
                previous == 32 or previous == 9 or
                previous == 10 or previous == 13
            )
        if token_start:
            var matched = true
            var j = 0
            val name_blen = name.byte_len()
            while j < name_blen:
                if not html_attr_name_byte_equal(ib[i + j], nb[j]):
                    matched = false
                    break
                j = j + 1
            if matched:
                val end = i + name_blen
                if end >= inner.byte_len():
                    return true
                val next = ib[end]
                if (
                    next == 32 or next == 9 or next == 10 or
                    next == 13 or next == 47 or next == 61
                ):
                    return true
        i = i + 1
    false

# Single-pass prefilter for presentational_attr_decls.
#
# presentational_attr_decls used to run six independent `attr_value*` /
# `attr_present` scans over every element's raw attribute text, and each of
# those materialises `inner.bytes()` again. Almost no element in a real page
# carries any of the five legacy presentational attributes, so the six scans
# almost always find nothing. This walks the byte array ONCE, quote-aware,
# using exactly the token-start + case-insensitive name rule the individual
# scans use, and answers whether any of the five names can possibly be found.
#
# Conservative by construction: a `false` answer means no scan for
# hidden/bgcolor/width/height/align can match a token start, so all six
# lookups would have returned nothing. It never suppresses a real match.
# reason: moved verbatim from simple_web_html_layout_renderer_foundation.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn html_has_presentational_attr(inner: text) -> bool:
    val inner_len = inner.byte_len()
    if inner_len == 0:
        return false
    val ib = inner.bytes()
    var quote = 0
    var i = 0
    while i < inner_len:  # cpu-lane-loop-ok: one quote-aware pass over ONE element's raw attribute text; bound is that element's attribute-text length
        val current = ib[i]
        if quote != 0:
            if current == quote:
                quote = 0
            i = i + 1
            continue
        if current == 34 or current == 39:
            quote = current
            i = i + 1
            continue
        var token_start = i == 0
        if not token_start:
            val previous = ib[i - 1]
            token_start = (
                previous == 32 or previous == 9 or
                previous == 10 or previous == 13
            )
        if token_start:
            if (
                _html_attr_name_at(ib, inner_len, i, "hidden") or
                _html_attr_name_at(ib, inner_len, i, "bgcolor") or
                _html_attr_name_at(ib, inner_len, i, "width") or
                _html_attr_name_at(ib, inner_len, i, "height") or
                _html_attr_name_at(ib, inner_len, i, "align")
            ):
                return true
        i = i + 1
    false

fn _html_attr_name_at(ib: [u8], inner_len: i64, at: i64, name: text) -> bool:
    val nb = name.bytes()
    val name_len = name.byte_len()
    if at + name_len > inner_len:
        return false
    var j = 0
    while j < name_len:  # cpu-lane-loop-ok: compares ONE fixed short attribute name at one offset; bound is that name's length
        if not html_attr_name_byte_equal(ib[at + j], nb[j]):
            return false
        j = j + 1
    true

fn is_void(tag: text) -> bool:
    tag == "meta" or tag == "br" or tag == "img" or tag == "input" or tag == "link" or tag == "hr" or tag == "area" or tag == "base" or tag == "col" or tag == "embed" or tag == "source" or tag == "track" or tag == "wbr"

# ---------------------------------------------------------------------------
# Minimal CSS color parsing (#rgb, #rrggbb, rgb()/rgba(), a few names)
# ---------------------------------------------------------------------------

fn hex_val(c: text) -> i32:
    if c == "0": return 0
    if c == "1": return 1
    if c == "2": return 2
    if c == "3": return 3
    if c == "4": return 4
    if c == "5": return 5
    if c == "6": return 6
    if c == "7": return 7
    if c == "8": return 8
    if c == "9": return 9
    val l = c.lower()
    if l == "a": return 10
    if l == "b": return 11
    if l == "c": return 12
    if l == "d": return 13
    if l == "e": return 14
    if l == "f": return 15
    0

fn dec_val(c: text) -> i32:
    if c == "0": return 0
    if c == "1": return 1
    if c == "2": return 2
    if c == "3": return 3
    if c == "4": return 4
    if c == "5": return 5
    if c == "6": return 6
    if c == "7": return 7
    if c == "8": return 8
    if c == "9": return 9
    10

fn web_argb(r: i32, g: i32, b: i32) -> u32:
    0xFF000000u32 | ((r.to_u32()) << 16) | ((g.to_u32()) << 8) | b.to_u32()

fn parse_int_range(s: text, start: i32, end: i32) -> i32:
    var i = start
    var v = 0
    var matched_any_digit = false
    while i < end:
        val c = s.substring(i, i + 1)
        val digit = dec_val(c)
        if digit < 10:
            v = v * 10 + digit
            matched_any_digit = true
        else:
            if matched_any_digit:
                break
        i = i + 1
    v

# reason: moved verbatim from simple_web_html_layout_renderer_foundation.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn _color_alpha_zero(raw: text) -> bool:
    if val rgba = parse_color_value_checked(raw.trim().lower()):
        return (rgba & 0xFFu32) == 0u32
    false

# reason: moved verbatim from simple_web_html_layout_renderer_foundation.spl by the parser-input split; signature unchanged
# @allow(primitive_api)
pub fn _decl_transparent_color(raw: text) -> bool:
    """True when a colour value, or the colour token of a border/outline
    shorthand, is fully transparent (`transparent`, `rgba(0,0,0,0)`,
    `#0000`). The colour parsers answer 0 for it -- the same 0 as "no colour
    in this value" -- so an applier asks this to tell "set to transparent"
    from "unset" and override the earlier colour, as Chrome does."""
    for tok in _decl_top_level_tokens(raw):
        # A length (`20px`, `0`) is never a colour; the delegate would read
        # its digits as one.
        if not "0123456789.-+".contains(tok.substring(0, 1)) and _color_alpha_zero(tok):
            return true
    false

# Whitespace-separated tokens of a value, a function (`rgb(0 0 0 / 0)`)
# kept whole.
pub fn _decl_top_level_tokens(raw: text) -> [text]:
    var out: [text] = []
    val s = raw.trim()
    val n = s.byte_len()
    var depth = 0
    var start = 0
    var i = 0
    while i <= n:
        val ch = if i < n: s.substring(i, i + 1) else: " "
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            depth = depth - 1
        elif depth == 0 and (ch == " " or ch == "\t" or ch == "\n"):
            if i > start:
                out.push(s.substring(start, i))
            start = i + 1
        i = i + 1
    out

# "0.09", ".5", "1" -> 0..255 alpha
fn parse_alpha_fraction_range(s: text, start: i32, end: i32) -> i32:
    var i = start
    var int_part = 0
    var frac_num = 0
    var frac_den = 1
    var seen_digit = false
    var in_frac = false
    while i < end:
        val c = s.substring(i, i + 1)
        val d = dec_val(c)
        if d < 10:
            seen_digit = true
            if in_frac:
                if frac_den < 1000:
                    frac_num = frac_num * 10 + d
                    frac_den = frac_den * 10
            else:
                int_part = int_part * 10 + d
        elif c == ".":
            in_frac = true
        elif seen_digit:
            break
        i = i + 1
    if int_part >= 1:
        return 255
    (frac_num * 255 + frac_den / 2) / frac_den

# True for a bare CSS angle token ("45deg", "-90deg", "0.5turn", "200grad",
# "1rad"). `parse_linear_gradient_color` and `parse_gradient_angle_deg` both
# need this to tell an angle apart from a color stop — a numeric angle has no
# color meaning and must never reach `parse_color_any`.
fn is_gradient_angle_token(s: text) -> bool:
    val n = s.byte_len()
    if n == 0:
        return false
    var i = 0
    if s.substring(0, 1) == "-" or s.substring(0, 1) == "+":
        i = 1
    var saw_digit = false
    while i < n:
        val c = s.substring(i, i + 1)
        val d = dec_val(c)
        if d < 10:
            saw_digit = true
            i = i + 1
        elif c == ".":
            i = i + 1
        else:
            break
    if not saw_digit:
        return false
    val suffix = s.substring(i, n)
    suffix == "deg" or suffix == "grad" or suffix == "rad" or suffix == "turn"

# Index of the `)` that closes the `(` at `lp`, or -1. A gradient whose stops
# are `rgba(...)`/`rgb(...)`/`hsl(...)` functions carries nested parens, so the
# first `)` after `lp` is NOT the gradient's own close paren.
fn gradient_matching_close(s: text, lp: i32) -> i32:
    var depth = 0
    var i = lp
    val n = s.byte_len()
    # BYTE-indexed for the same reason as split_top_level_commas_paren_aware:
    # a char_at probe here shifts the returned close-paren offset on any
    # multi-byte gradient value and truncates the `inner` text the splitter
    # then receives. ASCII `(` / `)` bytes never appear inside a UTF-8 sequence.
    val pb = s.bytes()
    while i < n:
        val c = pb[i]
        if c == 40:
            depth = depth + 1
        elif c == 41:
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    -1

# ============================================================================
# N-stop / angled / radial gradient upgrade (GAP-2)
#
# `parse_linear_gradient_color` above stays as the legacy 2-stop (from/to)
# accessor consumed by the existing DrawIR pipeline. The functions below are
# additive: a full stop list (N>=1, explicit or evenly-spaced positions),
# the gradient angle in degrees, and radial-vs-linear detection. Paired
# raster primitives that consume a stop list live in
# `std.gc_async_mut.gpu.engine2d.backend_emu` (`emu_draw_linear_gradient_stops`,
# `emu_draw_radial_gradient_stops`) so the paint side has no dependency on
# CSS string parsing.
# ============================================================================

struct GradientStopSpec:
    color: u32
    pos_permille: i32

# Split `s` on top-level commas only (parens — e.g. `rgba(0,0,0,0.5)` —
# nest depth so their internal commas are not stop separators).
fn split_top_level_commas_paren_aware(s: text) -> [text]:
    var parts: [text] = []
    var depth = 0
    var start = 0
    var i = 0
    val n = s.byte_len()
    # BYTE-indexed scan, like text_matches_at/skip_wrap_spaces: `len()` and
    # `substring()` are byte-indexed, while `char_at` is CHARACTER-indexed, so
    # a len()-bounded char_at probe shifts every split point after a multi-byte
    # character and cuts parts mid-UTF-8-sequence (regression guard:
    # test/01_unit/runtime/baremetal_string_split_abi_spec.spl). The compared
    # bytes are ASCII `(`, `)`, `,` (< 0x80), which never occur inside a UTF-8
    # multi-byte sequence, so byte probing is answer-identical on ASCII and
    # correct on multi-byte input.
    val cb = s.bytes()
    while i < n:
        val c = cb[i]
        if c == 40:
            depth = depth + 1
        elif c == 41:
            depth = depth - 1
        elif c == 44 and depth == 0:
            parts.push(s.substring(start, i).trim())
            start = i + 1
        i = i + 1
    parts.push(s.substring(start, n).trim())
    parts

# One background layer split after its leading `linear-gradient(...)` /
# `radial-gradient(...)` function: [function, tail]; [] otherwise.
fn gradient_layer_split(layer: text) -> [text]:
    val lower = layer.lower()
    var open = -1
    if text_starts_with_portable(lower, "linear-gradient("):
        open = "linear-gradient".len()
    elif text_starts_with_portable(lower, "radial-gradient("):
        open = "radial-gradient".len()
    if open < 0:
        return []
    val close = gradient_matching_close(layer, open)
    if close <= open:
        return []
    [layer.substring(0, close + 1), layer.substring(close + 1, layer.byte_len()).trim()]

# The `<position> [/ <size>] <repeat>` texts of a layer tail (each "" when
# absent), or [] when the tail holds anything else (a box, `fixed`, a colour,
# a 3/4-value position). `scroll` is the default attachment and is ignored.
fn gradient_layer_tail_parts(tail: text) -> [text]:
    var positions: [text] = []
    var sizes: [text] = []
    var repeats: [text] = []
    var after_slash = false
    var slash_seen = false
    var last_group = ""
    for raw_tok in tail.replace("/", " / ").split(" "):
        val tok = raw_tok.trim().lower()
        if tok == "":
            continue
        if after_slash:
            if (tok == "auto" or tok == "cover" or tok == "contain" or _bg_len_q10(tok).len() == 2) and sizes.len() < 2:
                sizes.push(tok)
                continue
            if sizes.len() == 0:
                return []
            after_slash = false
        if tok == "/":
            if slash_seen or positions.len() == 0 or last_group != "position":
                return []
            slash_seen = true
            after_slash = true
            last_group = "size"
        elif tok == "scroll":
            last_group = "scroll"
        elif tok == "repeat" or tok == "no-repeat" or tok == "repeat-x" or tok == "repeat-y" or tok == "space" or tok == "round":
            if repeats.len() > 0 and last_group != "repeat":
                return []
            repeats.push(tok)
            last_group = "repeat"
        elif tok == "left" or tok == "right" or tok == "top" or tok == "bottom" or tok == "center" or _bg_len_q10(tok).len() == 2:
            if (positions.len() > 0 and last_group != "position") or slash_seen:
                return []
            positions.push(tok)
            last_group = "position"
        else:
            return []
    if slash_seen and sizes.len() == 0:
        return []
    if positions.len() > 2 or repeats.len() > 2:
        return []
    [_bg_join(positions, " "), _bg_join(sizes, " "), _bg_join(repeats, " ")]

# A `<length-percentage>` token as [unit, value in Q10] (unit 1 = px,
# 2 = percent; a bare 0 is 0px), [] when it is anything else.
fn _bg_len_q10(tok: text) -> [i64]:
    var unit: i64 = 0
    var body = tok
    if tok.ends_with("px"):
        unit = 1
        body = tok.substring(0, tok.byte_len() - 2)
    elif tok.ends_with("%"):
        unit = 2
        body = tok.substring(0, tok.byte_len() - 1)
    var neg = false
    var i = 0
    if body.starts_with("-"):
        neg = true
        i = 1
    var int_part: i64 = 0
    var frac: i64 = 0
    var frac_scale: i64 = 1
    var digits = 0
    var dot = false
    while i < body.byte_len():
        val c = body.substring(i, i + 1)
        if c == ".":
            if dot:
                return []
            dot = true
        else:
            val d = dec_val(c)
            if d > 9:
                return []
            digits = digits + 1
            if dot:
                if frac_scale < 10000:
                    frac = frac * 10 + (d as i64)
                    frac_scale = frac_scale * 10
            else:
                int_part = int_part * 10 + (d as i64)
        i = i + 1
    if digits == 0:
        return []
    var v = int_part * 1024 + (frac * 1024 + frac_scale / 2) / frac_scale
    if neg:
        v = 0 - v
    if unit == 0:
        if v != 0:
            return []
        unit = 1
    [unit, v]

# `background-size` of one layer: [kind, w_unit, w_q10, h_unit, h_q10]
# (kind 0 = explicit, 1 = cover, 2 = contain; unit 0 = auto, 1 = px,
# 2 = percent), [] when invalid. "" is `auto`.
fn background_size_spec(t: text) -> [i64]:
    val toks = _bg_words(t)
    if toks.len() == 0:
        return [0, 0, 0, 0, 0]
    if toks.len() == 1 and toks[0] == "cover":
        return [1, 0, 0, 0, 0]
    if toks.len() == 1 and toks[0] == "contain":
        return [2, 0, 0, 0, 0]
    if toks.len() > 2:
        return []
    var out: [i64] = [0]
    for tok in toks:
        if tok == "auto":
            out.push(0)
            out.push(0)
        else:
            val l = _bg_len_q10(tok)
            if l.len() != 2 or l[1] < 0:
                return []
            out.push(l[0])
            out.push(l[1])
    if out.len() == 3:
        out.push(0)
        out.push(0)
    out

# `background-position` of one layer (1 or 2 values): [x_pct_q10, x_px_q10,
# y_pct_q10, y_px_q10] (offset = pct * (area - tile) / 100 + px), [] when
# invalid. "" is `0% 0%`.
fn background_position_spec(t: text) -> [i64]:
    val toks = _bg_words(t)
    if toks.len() == 0:
        return [0, 0, 0, 0]
    if toks.len() > 2:
        return []
    var xt = toks[0]
    var yt = "center"
    if toks.len() == 1:
        if xt == "top" or xt == "bottom":
            yt = xt
            xt = "center"
    else:
        yt = toks[1]
        if xt == "top" or xt == "bottom" or yt == "left" or yt == "right":
            if not _bg_position_keyword(xt) or not _bg_position_keyword(yt):
                return []
            val sw = xt
            xt = yt
            yt = sw
    val x = _bg_position_axis(xt, "left", "right")
    val y = _bg_position_axis(yt, "top", "bottom")
    if x.len() != 2 or y.len() != 2:
        return []
    [x[0], x[1], y[0], y[1]]

fn _bg_position_keyword(s: text) -> bool:
    s == "left" or s == "right" or s == "top" or s == "bottom" or s == "center"

fn _bg_words(t: text) -> [text]:
    var out: [text] = []
    for w in t.trim().lower().split(" "):
        if w.trim() != "":
            out.push(w.trim())
    out

fn _bg_join(parts: [text], sep: text) -> text:
    var out = ""
    var i = 0
    while i < parts.len():
        if i > 0:
            out = out + sep
        out = out + parts[i]
        i = i + 1
    out

fn _bg_position_axis(tok: text, start_kw: text, end_kw: text) -> [i64]:
    if tok == start_kw:
        return [0, 0]
    if tok == "center":
        return [51200, 0]
    if tok == end_kw:
        return [102400, 0]
    val l = _bg_len_q10(tok)
    if l.len() != 2:
        return []
    if l[0] == 2:
        return [l[1], 0]
    [0, l[1]]

# `background-repeat` of one layer: [repeat_x, repeat_y] (1 = repeat,
# 0 = no-repeat), [] for `space` / `round` (not implemented) or invalid.
# "" is `repeat`.
fn background_repeat_spec(t: text) -> [i64]:
    val toks = _bg_words(t)
    if toks.len() == 0:
        return [1, 1]
    if toks.len() == 1:
        val r = toks[0]
        if r == "repeat":
            return [1, 1]
        if r == "no-repeat":
            return [0, 0]
        if r == "repeat-x":
            return [1, 0]
        if r == "repeat-y":
            return [0, 1]
        return []
    if toks.len() != 2:
        return []
    var out: [i64] = []
    for r in toks:
        if r == "repeat":
            out.push(1)
        elif r == "no-repeat":
            out.push(0)
        else:
            return []
    out

# True when a layer's size / position / repeat texts leave its tile 0 on
# the positioning area: size auto / 100% (or cover / contain, which are the
# area for a gradient) and no px offset (a percentage offset of a full-area
# tile is 0). The repeat is not considered: it only changes the border area,
# which the untiled paths already paint by extrapolation (open). Invalid
# texts are not default (the painter fails closed on them).
fn background_layer_geometry_default(size: text, position: text, repeat: text) -> bool:
    val s = background_size_spec(size)
    val p = background_position_spec(position)
    val r = background_repeat_spec(repeat)
    if s.len() != 5 or p.len() != 4 or r.len() != 2:
        return false
    val full_w = s[1] == 0 or (s[1] == 2 and s[2] == 102400)
    val full_h = s[3] == 0 or (s[3] == 2 and s[4] == 102400)
    (s[0] != 0 or (full_w and full_h)) and p[1] == 0 and p[3] == 0

# The final top-level layer of a background list when it is a bare colour
# (no image or function other than a colour function), else "".
fn gradient_layer_list_color_text(raw: text) -> text:
    val parts = split_top_level_commas_paren_aware(raw.trim())
    val last = parts[parts.len() - 1]
    val lower = last.lower()
    if (lower == "" or lower.contains("gradient(") or lower.contains("url(") or
            lower.contains("image") or lower.contains("element(") or
            lower.contains("paint(") or lower.contains("var(")):
        return ""
    last

fn is_radial_gradient(raw: text) -> bool:
    text_index_of(raw.lower(), "radial-gradient(") >= 0

fn is_gradient_shape_or_position_token(s: text) -> bool:
    val lower = s.lower()
    (
        text_starts_with_portable(lower, "circle") or text_starts_with_portable(lower, "ellipse") or
        text_index_of(lower, "at ") >= 0 or lower == "closest-side" or
        lower == "closest-corner" or lower == "farthest-side" or
        lower == "farthest-corner"
    )

fn find_last_top_level_space(s: text) -> i32:
    var last: i32 = -1
    var depth = 0
    var i = 0
    val n = s.byte_len()
    while i < n:
        val c = s.substring(i, i + 1)
        if c == "(":
            depth = depth + 1
        elif c == ")":
            depth = depth - 1
        elif c == " " and depth == 0:
            last = i
        i = i + 1
    last

# "37%" / "12.5%" -> permille (0..1000). Returns -1 when `s` is not a
# percentage (no explicit stop position given).
fn parse_percent_permille(s: text) -> i32:
    val n = s.byte_len()
    if n == 0 or s.substring(n - 1, n) != "%":
        return -1
    var i = 0
    var int_part = 0
    var frac_num = 0
    var frac_den = 1
    var seen_digit = false
    var in_frac = false
    while i < n - 1:
        val c = s.substring(i, i + 1)
        val d = dec_val(c)
        if d < 10:
            seen_digit = true
            if in_frac:
                if frac_den < 100:
                    frac_num = frac_num * 10 + d
                    frac_den = frac_den * 10
            else:
                int_part = int_part * 10 + d
        elif c == ".":
            in_frac = true
        i = i + 1
    if not seen_digit:
        return -1
    (int_part * 1000 + frac_num * 1000 / frac_den) / 100

# Strip an optional trailing "NN%" position off a single gradient stop part,
# leaving just the color text.
fn gradient_stop_color_text(part: text) -> text:
    val ls = find_last_top_level_space(part)
    if ls < 0:
        return part
    val after = part.substring(ls + 1, part.byte_len()).trim()
    if parse_percent_permille(after) >= 0 or gradient_stop_token(after, 16)[0] != 0:
        return part.substring(0, ls).trim()
    part

fn gradient_stop_position_or_neg1(part: text) -> i32:
    val ls = find_last_top_level_space(part)
    if ls < 0:
        return -1
    val after = part.substring(ls + 1, part.byte_len()).trim()
    parse_percent_permille(after)

fn parse_signed_leading_int(s: text) -> i32:
    var i = 0
    var neg = false
    if s.len() > 0 and s.substring(0, 1) == "-":
        neg = true
        i = 1
    elif s.len() > 0 and s.substring(0, 1) == "+":
        i = 1
    var v = 0
    while i < s.byte_len():
        val d = dec_val(s.substring(i, i + 1))
        if d < 10:
            v = v * 10 + d
            i = i + 1
        else:
            break
    if neg:
        -v
    else:
        v

# A `<angle>` token (`deg`, `grad`, `rad`, `turn`, decimals allowed) in
# whole degrees, rounded and reduced to 0..359.
fn gradient_angle_token_deg(s: text) -> i32:
    val n = s.byte_len()
    var i = 0
    var neg = false
    if n > 0 and s.substring(0, 1) == "-":
        neg = true
        i = 1
    elif n > 0 and s.substring(0, 1) == "+":
        i = 1
    var v = 0.0
    var scale = 0.0
    while i < n:
        val c = s.substring(i, i + 1)
        val d = dec_val(c)
        if d < 10:
            if scale > 0.0:
                v = v + (d as f64) * scale
                scale = scale / 10.0
            else:
                v = v * 10.0 + (d as f64)
            i = i + 1
        elif c == "." and scale == 0.0:
            scale = 0.1
            i = i + 1
        else:
            break
    val unit = s.substring(i, n)
    var deg = v
    if unit == "grad":
        deg = v * 0.9
    elif unit == "rad":
        deg = v * 180.0 / 3.141592653589793
    elif unit == "turn":
        deg = v * 360.0
    val r = (deg + 0.5) as i32
    # Reduced to 0..359: values >= 1000 are the `to <corner>` codes, so
    # `3turn` or `1080deg` must never reach the painter unreduced.
    val m = (if neg: 0 - r else: r) % 360
    if m < 0: m + 360 else: m

# One stop's position token: [kind, value]. kind 0 = no position, 1 =
# percentage (value in permille, signed), 2 = length (value in Q10 px,
# signed; `em` is `em_px` px).
# reason: stop-position token scanner shared by the cascade and the gradient layer painters; value in permille or Q10 px
# @allow(primitive_api)
pub fn gradient_stop_token(tok: text, em_px: i32) -> [i64]:
    val t = tok.trim().lower()
    val n = t.byte_len()
    if n == 0:
        return [0, 0]
    val neg = t.substring(0, 1) == "-"
    val body = if neg or t.substring(0, 1) == "+": t.substring(1, n) else: t
    val bn = body.byte_len()
    if bn >= 2 and body.substring(bn - 1, bn) == "%":
        val pm = parse_percent_permille(body)
        if pm < 0:
            return [0, 0]
        return [1, if neg: 0 - (pm as i64) else: pm as i64]
    var unit_len = 0
    var scale: i64 = 0
    if bn >= 3 and body.substring(bn - 2, bn) == "px":
        unit_len = 2
        scale = 1
    elif bn >= 3 and body.substring(bn - 2, bn) == "em" and not (bn >= 4 and body.substring(bn - 3, bn) == "rem"):
        unit_len = 2
        scale = em_px as i64
    if unit_len == 0:
        return [0, 0]
    # Decimal magnitude in 1/1000 units.
    var int_part: i64 = 0
    var frac: i64 = 0
    var frac_den: i64 = 1
    var in_frac = false
    var seen = false
    var i = 0
    while i < bn - unit_len:
        val c = body.substring(i, i + 1)
        val d = dec_val(c)
        if d < 10:
            seen = true
            if in_frac:
                if frac_den < 1000:
                    frac = frac * 10 + (d as i64)
                    frac_den = frac_den * 10
            else:
                int_part = int_part * 10 + (d as i64)
        elif c == "." and not in_frac:
            in_frac = true
        else:
            return [0, 0]
        i = i + 1
    if not seen:
        return [0, 0]
    val milli = int_part * 1000 + frac * 1000 / frac_den
    val q10 = (milli * scale * 1024 + 500) / 1000
    [2, if neg: 0 - q10 else: q10]

# Rewrites every `<number>rem` length inside a gradient value to px against
# the root font size, at cascade time (the root size is reset after the
# cascade, so paint cannot resolve `rem`). Values without a gradient, and
# `rem` not preceded by a digit or followed by a name character (`url(2rem.png)`),
# are returned unchanged.
# reason: cascade-time text rewrite of one declaration value; root font in px
# @allow(primitive_api)
pub fn gradient_rem_stops_to_px(v: text, root_px: i32) -> text:
    if text_index_of(v, "rem") < 0 or text_index_of(v, "gradient(") < 0:
        return v
    var out = ""
    var start = 0
    var i = 0
    val n = v.byte_len()
    # cpu-lane-loop-ok: one pass over a declaration value; bound value byte length
    while i + 3 <= n:
        if v.substring(i, i + 3) == "rem" and i > 0 and dec_val(v.substring(i - 1, i)) < 10:
            val nx = if i + 3 < n: v.substring(i + 3, i + 4) else: " "
            val next_ok = dec_val(nx) >= 10 and nx.lower() == nx.upper() and nx != "." and nx != "-" and nx != "_"
            var b = i
            # cpu-lane-loop-ok: walks back over one number token; bound token length
            while b > start and (dec_val(v.substring(b - 1, b)) < 10 or v.substring(b - 1, b) == "."):
                b = b - 1
            val letter_before = b > 0 and v.substring(b - 1, b).lower() != v.substring(b - 1, b).upper()
            if next_ok and not letter_before:
                var int_part: i64 = 0
                var frac: i64 = 0
                var frac_den: i64 = 1
                var in_frac = false
                var j = b
                # cpu-lane-loop-ok: digits of one number token; bound token length
                while j < i:
                    val c = v.substring(j, j + 1)
                    if c == ".":
                        in_frac = true
                    elif in_frac:
                        if frac_den < 1000:
                            frac = frac * 10 + (dec_val(c) as i64)
                            frac_den = frac_den * 10
                    else:
                        int_part = int_part * 10 + (dec_val(c) as i64)
                    j = j + 1
                val px_milli = (int_part * 1000 + frac * 1000 / frac_den) * (root_px as i64)
                val whole = px_milli / 1000
                val part = px_milli % 1000
                val part_text = if part == 0: "" elif part < 10: ".00{part}" elif part < 100: ".0{part}" else: ".{part}"
                out = out + v.substring(start, b) + "{whole}" + part_text + "px"
                start = i + 3
                i = i + 3
                continue
        i = i + 1
    out + v.substring(start, n)

fn parse_int(s: text) -> i32:
    var i = 0
    var v = 0
    var matched_any_digit = false
    val s_len = s.byte_len()
    while i < s_len:
        val c = s.substring(i, i + 1)
        val digit = dec_val(c)
        if digit < 10:
            v = v * 10 + digit
            matched_any_digit = true
        else:
            if matched_any_digit:
                break
        i = i + 1
    v

fn parse_nth_int(s: text, target: i32) -> i32:
    var i = 0
    var seen = 0
    val s_len = s.byte_len()
    while i < s_len:
        val c = s.substring(i, i + 1)
        if dec_val(c) < 10:
            var v = 0
            while i < s_len:
                val d = s.substring(i, i + 1)
                val digit = dec_val(d)
                if digit >= 10:
                    break
                v = v * 10 + digit
                i = i + 1
            if seen == target:
                return v
            seen = seen + 1
        else:
            i = i + 1
    -1

fn parse_signed_nth_int(s: text, target: i32) -> i32:
    var i = 0
    var seen = 0
    val s_len = s.byte_len()
    while i < s_len:
        var sign = 1
        if s.substring(i, i + 1) == "-":
            sign = -1
            i = i + 1
        if i < s_len and dec_val(s.substring(i, i + 1)) < 10:
            var v = 0
            while i < s_len:
                val digit = dec_val(s.substring(i, i + 1))
                if digit >= 10:
                    break
                v = v * 10 + digit
                i = i + 1
            if seen == target:
                return v * sign
            seen = seen + 1
        else:
            i = i + 1
    -1000000

# Sentinel of the translate parsers below: no such component.
val TRANSLATE_NONE_MILLI: i64 = -1000000000000

fn parse_signed_nth_length_milli(s: text, target: i32, basis: i32) -> i64:
    """The `target`-th signed number of `s` in milli-px, a `%` resolved
    against `basis`; TRANSLATE_NONE_MILLI when there is none.

    CSS transform translate percentages resolve against the element's own
    border box (CSS Transforms 1 §3), so `basis` is the element width for the
    x axis and its height for the y axis. A unitless/px value is taken as px.
    A decimal is ONE number (`0.3px` is 300, not 0 and 3); digits past the
    thousandth are dropped.
    """
    var i = 0
    var seen = 0
    val s_len = s.byte_len()
    while i < s_len:
        var sign: i64 = 1
        if s.substring(i, i + 1) == "-":
            sign = -1
            i = i + 1
        val starts_frac = i + 1 < s_len and s.substring(i, i + 1) == "." and dec_val(s.substring(i + 1, i + 2)) < 10
        if i < s_len and (dec_val(s.substring(i, i + 1)) < 10 or starts_frac):
            var v: i64 = 0
            while i < s_len:
                val digit = dec_val(s.substring(i, i + 1))
                if digit >= 10:
                    break
                v = v * 10 + digit.to_i64()
                i = i + 1
            v = v * 1000
            if i < s_len and s.substring(i, i + 1) == ".":
                i = i + 1
                var place: i64 = 100
                while i < s_len:
                    val digit = dec_val(s.substring(i, i + 1))
                    if digit >= 10:
                        break
                    v = v + digit.to_i64() * place
                    place = place / 10
                    i = i + 1
            if seen == target:
                if i < s_len and s.substring(i, i + 1) == "%":
                    return (v * sign * basis.to_i64()) / 100
                return v * sign
            seen = seen + 1
        else:
            i = i + 1
    TRANSLATE_NONE_MILLI

# The x / y translation of a `transform` (translate / translateX /
# translateY) or of the individual `translate` property, in milli-px; 0 when
# it has none on that axis.
fn parse_transform_translate_x_milli(raw: text, box_w: i32) -> i64:
    val t = raw.trim().lower()
    if t == "none":
        return 0
    if text_index_of(t, "translatex(") >= 0 or text_index_of(t, "translate(") >= 0:
        val v = parse_signed_nth_length_milli(t, 0, box_w)
        return if v == TRANSLATE_NONE_MILLI: 0 else: v
    0

fn parse_transform_translate_y_milli(raw: text, box_h: i32) -> i64:
    val t = raw.trim().lower()
    if t == "none":
        return 0
    if text_index_of(t, "translatey(") >= 0:
        val v = parse_signed_nth_length_milli(t, 0, box_h)
        return if v == TRANSLATE_NONE_MILLI: 0 else: v
    if text_index_of(t, "translate(") >= 0:
        val v = parse_signed_nth_length_milli(t, 1, box_h)
        return if v == TRANSLATE_NONE_MILLI: 0 else: v
    0

fn parse_individual_translate_x_milli(raw: text, box_w: i32) -> i64:
    val t = raw.trim().lower()
    if t == "none":
        return 0
    val v = parse_signed_nth_length_milli(t, 0, box_w)
    if v == TRANSLATE_NONE_MILLI: 0 else: v

fn parse_individual_translate_y_milli(raw: text, box_h: i32) -> i64:
    val t = raw.trim().lower()
    if t == "none":
        return 0
    val v = parse_signed_nth_length_milli(t, 1, box_h)
    if v == TRANSLATE_NONE_MILLI: 0 else: v

fn parse_scale_pct(raw: text) -> i32:
    val t = raw.trim().lower()
    if t.len() == 0 or t == "none":
        return 100
    val v = parse_int(t)
    if v <= 0:
        return 100
    if t.contains("%"):
        return v
    v * 100

fn parse_transform_scale_pct(raw: text) -> i32:
    val t = raw.trim().lower()
    val start = text_index_of(t, "scale(")
    if start < 0:
        return 100
    val value_start = start + 6
    var value_end = find_from(t, ")", value_start)
    if value_end < 0:
        value_end = t.byte_len()
    parse_scale_pct(t.substring(value_start, value_end))

fn parse_rotate_quarter_turn(raw: text) -> bool:
    val t = raw.trim().lower()
    if t.len() == 0 or t == "none":
        return false
    val v = parse_signed_nth_int(t, 0)
    if v == -1000000:
        return false
    val normalized = ((v % 360) + 360) % 360
    normalized == 90 or normalized == 270

fn parse_transform_rotate_quarter_turn(raw: text) -> bool:
    val t = raw.trim().lower()
    val start = text_index_of(t, "rotate(")
    if start < 0:
        return false
    val value_start = start + 7
    var value_end = find_from(t, ")", value_start)
    if value_end < 0:
        value_end = t.byte_len()
    parse_rotate_quarter_turn(t.substring(value_start, value_end))

fn parse_clip_rect_value(raw: text, target: i32) -> i32:
    val t = raw.trim().lower()
    val rect_start = text_index_of(t, "rect(")
    if rect_start < 0:
        return 0
    val value_start = rect_start + 5
    var value_end = find_from(t, ")", value_start)
    if value_end < 0:
        value_end = t.byte_len()
    val v = parse_signed_nth_int(t.substring(value_start, value_end), target)
    if v == -1000000:
        return 0
    v

# reason: strict CSS <number>/<percentage> opacity parser returns 0..100 or -1 on invalid syntax
# @allow(primitive_api)
pub fn parse_opacity_pct_or_neg1(raw: text) -> i32:
    val t = raw.trim()
    val n = t.byte_len()
    if n == 0:
        return -1
    var is_pct = false
    var end_idx = n
    if t.ends_with("%"):
        is_pct = true
        end_idx = n - 1
    var start_idx = 0
    var neg = false
    if start_idx < end_idx:
        val sign_ch = t.substring(start_idx, start_idx + 1)
        if sign_ch == "-":
            neg = true
            start_idx = start_idx + 1
        elif sign_ch == "+":
            start_idx = start_idx + 1
    if start_idx >= end_idx:
        return -1
    val body = t.substring(start_idx, end_idx)
    val body_len = body.byte_len()
    val lower_body = body.lower()
    if text_index_of(lower_body, "e") >= 0:
        val signed_num = t.substring(0, end_idx)
        if not animation_number_token_is_valid(signed_num):
            return -1
        if val Some(fv) = signed_num.parse_f64():
            if fv != fv:
                return -1
            val scaled = if is_pct: fv else: fv * 100.0
            if scaled <= 0.0:
                return 0
            if scaled >= 100.0:
                return 100
            return (scaled + 0.5).to_i32()
        return -1
    var saw_digit = false
    var saw_dot = false
    var digit_after_dot = false
    var whole = 0
    var frac = 0
    var scale = 1
    var k = 0
    while k < body_len:
        val ch = body.substring(k, k + 1)
        if ch == ".":
            if saw_dot:
                return -1
            saw_dot = true
        elif ch >= "0" and ch <= "9":
            val d = dec_val(ch)
            saw_digit = true
            if not saw_dot:
                if whole < 1000:
                    whole = whole * 10 + d
            else:
                digit_after_dot = true
                if scale < 100:
                    frac = frac * 10 + d
                    scale = scale * 10
        else:
            return -1
        k = k + 1
    if not saw_digit or (saw_dot and not digit_after_dot):
        return -1
    if neg:
        return 0
    if is_pct:
        if whole >= 100:
            return 100
        val rounded = whole + (frac + scale / 2) / scale
        if rounded > 100:
            return 100
        return rounded
    if whole >= 1:
        return 100
    val pct = (frac * 100 + scale / 2) / scale
    if pct > 100:
        return 100
    pct

fn parse_opacity_pct(raw: text) -> i32:
    val parsed = parse_opacity_pct_or_neg1(raw)
    if parsed < 0:
        return 100
    parsed

fn parse_filter_opacity_pct(raw: text) -> i32:
    val t = raw.trim().lower()
    val start = text_index_of(t, "opacity(")
    if start < 0:
        return -1
    val value_start = start + 8
    val value_end = find_from(t, ")", value_start)
    if value_end < 0:
        return -1
    val inner = t.substring(value_start, value_end).trim()
    if inner.byte_len() == 0:
        return 100
    parse_opacity_pct_or_neg1(inner)

fn parse_css_time_ms(raw: text) -> i32:
    val t = raw.trim().lower()
    if t.len() == 0:
        return 0
    var sign = 1
    var magnitude = t
    if magnitude.starts_with("-"):
        sign = -1
        magnitude = magnitude.substring(1, magnitude.byte_len())
    elif magnitude.starts_with("+"):
        magnitude = magnitude.substring(1, magnitude.byte_len())
    var unit_ms = 0
    if magnitude.ends_with("ms"):
        unit_ms = 1
    elif magnitude.ends_with("s"):
        unit_ms = 1000
    else:
        return sign * parse_int(magnitude)
    val dot = text_index_of(magnitude, ".")
    if dot < 0:
        return sign * parse_int(magnitude) * unit_ms
    var whole = 0
    if dot > 0:
        whole = parse_int(magnitude.substring(0, dot))
    var frac = 0
    var scale = 1
    var i = dot + 1
    val magnitude_len = magnitude.byte_len()
    while i < magnitude_len:
        val c = magnitude.substring(i, i + 1)
        if c < "0" or c > "9":
            break
        frac = frac * 10 + dec_val(c)
        scale = scale * 10
        i = i + 1
    # The render clock stores integer milliseconds, rounded symmetrically.
    sign * (whole * unit_ms + ((frac * unit_ms + scale / 2) / scale))

fn transition_token_is_time(token: text) -> bool:
    val t = token.trim().lower()
    var unit_len = 0
    if t.ends_with("ms"):
        unit_len = 2
    elif t.ends_with("s"):
        unit_len = 1
    if unit_len == 0 or t.byte_len() <= unit_len:
        return false
    animation_number_token_is_valid(
        t.substring(0, t.byte_len() - unit_len)
    )

val CSS_TIMING_TOKEN_MAX_BYTES: i32 = 1024
val CSS_TIMING_TOKEN_MAX_DEPTH: i32 = 4
val CSS_TIMING_TOKEN_MAX_COUNT: i32 = 16

# Split one animation/transition shorthand on top-level ASCII whitespace.
# Internal functional commas survive; top-level commas (lists), unbalanced or
# excessively nested functions, and oversized token streams fail closed.
fn css_timing_shorthand_tokens(raw: text) -> [text]:
    var tokens: [text] = []
    if raw.len() == 0 or raw.byte_len() > CSS_TIMING_TOKEN_MAX_BYTES:
        return tokens
    val bytes = raw.bytes()
    var depth = 0
    var start = -1
    var i = 0
    while i <= bytes.len():
        val code = if i < bytes.len(): bytes[i] else: 32
        if i < bytes.len():
            if code == 40:
                depth = depth + 1
                if depth > CSS_TIMING_TOKEN_MAX_DEPTH:
                    return []
            elif code == 41:
                if depth <= 0:
                    return []
                depth = depth - 1
            elif code == 44 and depth == 0:
                # List-valued animation/transition timing is unsupported.
                return []
        val whitespace = (
            code == 9 or code == 10 or code == 12 or
            code == 13 or code == 32
        )
        if whitespace and depth == 0:
            if start >= 0:
                tokens.push(raw.substring(start, i))
                if tokens.len() > CSS_TIMING_TOKEN_MAX_COUNT:
                    return []
                start = -1
        elif start < 0:
            start = i
        i = i + 1
    if depth != 0:
        return []
    tokens

fn parse_transition_nth_time_ms(raw: text, target: i32) -> i32:
    var has_duration = false
    var duration_ms = 0
    var has_delay = false
    var delay_ms = 0
    for part in css_timing_shorthand_tokens(raw):
        val token = part.trim()
        if transition_token_is_time(token):
            val ms = parse_css_time_ms(token)
            if not animation_time_token_is_valid(token, false):
                if not has_delay:
                    delay_ms = ms
                    has_delay = true
            elif not has_duration:
                duration_ms = ms
                has_duration = true
            elif not has_delay:
                delay_ms = ms
                has_delay = true
    if target == 0:
        return duration_ms
    if target == 1:
        return delay_ms
    0

val CSS_ANIMATION_MAX_FINITE_ITERATIONS: f64 = 9223372036854774784.0

fn animation_number_token_is_valid(raw: text) -> bool:
    val token = raw.trim().lower()
    if token.len() == 0:
        return false
    val number_start = if (
        token.starts_with("+") or token.starts_with("-")
    ): 1 else: 0
    if number_start >= token.byte_len():
        return false
    var exponent_at = -1
    var scan = number_start
    while scan < token.byte_len():
        val c = token.substring(scan, scan + 1)
        if c == "e":
            if exponent_at >= 0:
                return false
            exponent_at = scan
        scan = scan + 1
    val number_end = if exponent_at >= 0: exponent_at else: token.byte_len()
    if exponent_at >= 0:
        var exponent_i = exponent_at + 1
        if exponent_i >= token.byte_len():
            return false
        if (
            token.substring(exponent_i, exponent_i + 1) == "+" or
            token.substring(exponent_i, exponent_i + 1) == "-"
        ):
            exponent_i = exponent_i + 1
        if exponent_i >= token.byte_len():
            return false
        while exponent_i < token.byte_len():
            val digit = dec_val(token.substring(exponent_i, exponent_i + 1))
            if digit >= 10:
                return false
            exponent_i = exponent_i + 1

    var saw_digit = false
    var saw_dot = false
    var digit_after_dot = false
    var i = number_start
    while i < number_end:
        val c = token.substring(i, i + 1)
        if c == "." and not saw_dot:
            saw_dot = true
        else:
            val digit = dec_val(c)
            if digit >= 10:
                return false
            saw_digit = true
            if saw_dot:
                digit_after_dot = true
        i = i + 1
    saw_digit and (not saw_dot or digit_after_dot)

fn animation_token_looks_numeric(token: text) -> bool:
    if token.len() == 0:
        return false
    val first = token.substring(0, 1)
    if first == "." or first == "+" or dec_val(first) < 10:
        return true
    (
        first == "-" and token.byte_len() > 1 and
        (token.substring(1, 2) == "." or dec_val(token.substring(1, 2)) < 10)
    )

fn parse_animation_direction(raw: text) -> text:
    for token in css_timing_shorthand_tokens(raw.lower()):
        if (
            token == "normal" or token == "reverse" or
            token == "alternate" or token == "alternate-reverse"
        ):
            return token
    "normal"

fn parse_animation_fill_mode(raw: text) -> text:
    for token in css_timing_shorthand_tokens(raw.lower()):
        if (
            token == "none" or token == "forwards" or
            token == "backwards" or token == "both"
        ):
            return token
    "none"

fn parse_animation_play_state(raw: text) -> text:
    for token in css_timing_shorthand_tokens(raw.lower()):
        if token == "paused" or token == "running":
            return token
    "running"

fn animation_time_token_is_valid(raw: text, allow_negative: bool) -> bool:
    val token = raw.trim().lower()
    val unit_len = if token.ends_with("ms"): 2 else: 1
    if (
        token.byte_len() <= unit_len or
        (unit_len == 1 and not token.ends_with("s"))
    ):
        return false
    val number = token.substring(0, token.byte_len() - unit_len)
    if not animation_number_token_is_valid(number):
        return false
    if val parsed = number.parse_f64():
        val milliseconds = if unit_len == 2:
            parsed
        else:
            parsed * 1000.0
        if (
            parsed == parsed and milliseconds == milliseconds and
            milliseconds >= -2147483648.0 and
            milliseconds <= 2147483647.0 and
            (allow_negative or parsed >= 0.0)
        ):
            return true
    false

fn parse_aspect_ratio_numerator(raw: text) -> i32:
    val value = raw.trim().lower()
    if value.len() == 0 or value == "auto":
        return 0
    val first = parse_nth_int(value, 0)
    if first > 0:
        return first
    0

fn parse_aspect_ratio_denominator(raw: text) -> i32:
    val value = raw.trim().lower()
    if value.len() == 0 or value == "auto":
        return 0
    val second = parse_nth_int(value, 1)
    if second > 0:
        return second
    1

fn css_word_contains(raw: text, word: text) -> bool:
    val padded = " " + raw.trim().lower() + " "
    text_index_of(padded, " " + word + " ") >= 0

# read a property value from a declaration block "a: b; c: d"
fn decl_get(decls: text, prop: text) -> text:
    var pos = 0
    var found = ""
    val decls_len = decls.byte_len()
    while pos < decls_len:
        val semi = find_from(decls, ";", pos)
        val end = if semi >= 0: semi else: decls_len
        val colon = find_from(decls, ":", pos)
        if colon >= 0 and colon < end:
            val name = decls.substring(pos, colon).trim().lower()
            if name == prop:
                found = decls.substring(colon + 1, end).trim()
        if semi < 0:
            break
        pos = semi + 1
    found

fn normalize_overflow_box_alignment(raw: text) -> text:
    val value = raw.trim().lower()
    if value == "safe center":
        return "safe-center"
    if value == "unsafe center":
        return "unsafe-center"
    if value.starts_with("safe "):
        return value.substring(5, value.byte_len()).trim()
    if value.starts_with("unsafe "):
        return value.substring(7, value.byte_len()).trim()
    value

fn supports_content_distribution_alignment(value: text) -> bool:
    value == "space-between" or value == "space-around" or value == "space-evenly" or value == "center" or value == "safe-center" or value == "unsafe-center" or value == "flex-end" or value == "flex-start" or value == "start" or value == "end"

fn supports_align_content_alignment(value: text) -> bool:
    supports_content_distribution_alignment(value) or value == "stretch" or value == "normal"

fn border_style_disables_paint(raw: text) -> bool:
    val value = raw.trim().lower()
    value == "none" or value == "hidden"

fn css_border_style_token(raw: text) -> text:
    for token in ws_tokens(raw.trim().lower()):
        if (
            token == "none" or token == "hidden" or token == "dotted" or
            token == "dashed" or token == "solid" or token == "double" or
            token == "groove" or token == "ridge" or token == "inset" or
            token == "outset"
        ):
            return token
    ""

fn border_shorthand_disables_paint(raw: text) -> bool:
    val value = raw.trim().lower()
    (
        value == "0" or value == "0px" or
        value == "none" or value == "hidden"
    )

fn css_border_style_side(raw: text, side: i32) -> text:
    var styles: [text] = []
    for token in ws_tokens(raw.trim().lower()):
        val style = css_border_style_token(token)
        if style != "":
            styles.push(style)
    if styles.len() == 0:
        return ""
    if styles.len() == 1:
        return styles[0]
    if styles.len() == 2:
        if side == 0 or side == 2: return styles[0]
        return styles[1]
    if styles.len() == 3:
        if side == 0: return styles[0]
        if side == 2: return styles[2]
        return styles[1]
    styles[side]

fn decl_last_pos(decls: text, prop: text) -> i32:
    var pos = 0
    var found = -1
    val decls_len = decls.byte_len()
    while pos < decls_len:
        val semi = find_from(decls, ";", pos)
        val end = if semi >= 0: semi else: decls_len
        val colon = find_from(decls, ":", pos)
        if colon >= 0 and colon < end:
            val name = decls.substring(pos, colon).trim().lower()
            if name == prop:
                found = pos
        if semi < 0:
            break
        pos = semi + 1
    found

# ---------------------------------------------------------------------------
# Parsed declaration table.
#
# `decl_get` / `decl_last_pos` each re-scan the WHOLE declaration string and
# allocate `substring().trim().lower()` per declaration examined. `apply_decls`
# issues 244 `decl_get` plus 32 `decl_last_pos` calls against one block, so a
# single rule costs 276 x O(len(decls)) scans and hundreds of throwaway strings
# — fatal on the guest's non-reclaiming bump heap.
#
# These helpers parse the block ONCE into a flat name/value table plus an
# aligned start-position table, so the 276 lookups become table scans.
# Semantics are byte-identical to the scanning versions: same trim/lower
# normalisation, same "an entry without a colon before its `;` is skipped",
# and LAST-WINS on duplicate names (the lookups walk the table BACKWARDS, which
# is why they must not stop at the first textual occurrence).
# ---------------------------------------------------------------------------

# Number of well-formed `name: value` entries in a declaration block.
fn decl_entry_count(decls: text) -> i32:
    var pos = 0
    var count = 0
    val decls_len = decls.byte_len()
    while pos < decls_len:
        val semi = find_from(decls, ";", pos)
        val end = if semi >= 0: semi else: decls_len
        val colon = find_from(decls, ":", pos)
        if colon >= 0 and colon < end:
            count = count + 1
        if semi < 0:
            break
        pos = semi + 1
    count

# ---------------------------------------------------------------------------
# Presence set over a declaration table.
#
# `_apply_decls_without_grid` probes ~283 property names against ONE table, and
# every probe below is a BACKWARDS LINEAR SCAN of that table. A node that
# matched many rules carries a merged table with hundreds of entries, so the
# full probe body costs 283 x E string comparisons -- measured at ~1.2 s for a
# single such node under the interpreter, and 22 of them accounted for ~26 s of
# the 26.2 s css-layout style stage even with the cascade memo answering 96% of
# nodes (doc/08_tracking/bug/
# web_style_cascade_apply_decls_reparses_per_node_2026-09-12.md).
#
# Building the set of property names present in the table costs one O(E) pass;
# each probe for an ABSENT property then answers in O(1). This is exactly
# behaviour-preserving and needs no reasoning about cascade order: if a name is
# not in the table at all, the scan it replaces was always going to return the
# empty/absent answer. Probes for names that ARE present still take the original
# scan, so last-wins and last-VALID semantics are untouched.
# ---------------------------------------------------------------------------
fn decl_tbl_presence(tbl: [text]) -> Dict<text, i32>:
    var present: Dict<text, i32> = {}
    var i = 0
    while i < tbl.len():  # cpu-lane-loop-ok: one pass over ONE declaration table recording which property names occur; bound is that table's entry count
        present[tbl[i]] = 1
        i = i + 2
    present

fn decl_tbl_get_p(tbl: [text], present: Dict<text, i32>, prop: text) -> text:
    if not present.has(prop):
        return ""
    decl_tbl_get(tbl, prop)

fn decl_tbl_last_index_p(tbl: [text], present: Dict<text, i32>, prop: text) -> i32:
    if not present.has(prop):
        return -1
    decl_tbl_last_index(tbl, prop)

# Table-backed `decl_get`. Backwards walk == last-wins on duplicates.
fn decl_tbl_get(tbl: [text], prop: text) -> text:
    var i = (tbl.len() as i32) - 2
    while i >= 0:
        if tbl[i] == prop:
            return tbl[i + 1]
        i = i - 2
    ""

# Invalid declarations do not participate in the cascade. Walk backwards so a
# malformed later value cannot displace the last display keyword we implement.
fn is_supported_display_keyword(value: text) -> bool:
    (
        value == "block" or value == "none" or value == "inline" or
        value == "inline-block" or value == "list-item" or
        value == "flex" or value == "grid" or value == "contents" or value == "flow-root"
    )

fn decl_tbl_get_last_valid_display(tbl: [text]) -> text:
    var i = (tbl.len() as i32) - 2
    while i >= 0:
        if tbl[i] == "display":
            val value = tbl[i + 1].trim().lower()
            if is_supported_display_keyword(value):
                return value
        i = i - 2
    ""

# CSS-wide values need cascade provenance and are resolved by compute_styles,
# not by the declaration applier. `revert-layer` stays excluded because the
# current parser flattens @layer and cannot identify the previous layer.
fn decl_tbl_get_last_cascading_display(tbl: [text]) -> text:
    var i = (tbl.len() as i32) - 2
    while i >= 0:
        if tbl[i] == "display":
            val value = tbl[i + 1].trim().lower()
            if (
                is_supported_display_keyword(value) or value == "initial" or
                value == "unset" or value == "inherit" or value == "revert"
            ):
                return value
        i = i - 2
    ""

# Table-backed replacement for `decl_last_pos`. Backwards walk == last-wins.
#
# Returns the ENTRY INDEX (0-based, in source order), NOT the byte offset that
# `decl_last_pos` returns. That substitution is sound because entry indices are
# strictly increasing in byte offset (the build loop advances `pos`
# monotonically), and `apply_decls` consumes these values ONLY as `a > b`,
# `a >= 0` and `a < 0` — never as an offset into `decls`. Order and the -1
# "absent" sentinel are therefore preserved exactly, which is all the cascade
# tie-breaking depends on. Verified exhaustively against `decl_last_pos` over
# 46 real+adversarial blocks x 244 properties (all ordered pairs agree).
#
# Keeping indices also lets us skip building a parallel byte-offset table,
# which removed a second full scan of every declaration block.
fn decl_tbl_last_index(tbl: [text], prop: text) -> i32:
    var i = (tbl.len() as i32) - 2
    while i >= 0:
        if tbl[i] == prop:
            return i / 2
        i = i - 2
    -1

fn parse_nth_box_int(raw: text, index: i32) -> i32:
    val normalized = raw.trim().lower()
    val parts = normalized.split(" ")
    val count = parts.len()
    if count == 0:
        return 0
    if count == 1:
        return parse_int(parts[0])
    if count == 2:
        if index == 0 or index == 2:
            return parse_int(parts[0])
        return parse_int(parts[1])
    if count == 3:
        if index == 0:
            return parse_int(parts[0])
        if index == 2:
            return parse_int(parts[2])
        return parse_int(parts[1])
    if index >= 0 and index < count:
        return parse_int(parts[index])
    0

# The normalized token parse_nth_box_int reads for `index`, so callers can
# tell `auto` apart from an authored 0. Same 1-4 value box mapping.
fn nth_box_token(raw: text, index: i32) -> text:
    val parts = raw.trim().lower().split(" ")
    val count = parts.len()
    if count == 0:
        return ""
    if count == 1:
        return parts[0]
    if count == 2:
        if index == 0 or index == 2:
            return parts[0]
        return parts[1]
    if count == 3:
        if index == 0:
            return parts[0]
        if index == 2:
            return parts[2]
        return parts[1]
    if index >= 0 and index < count:
        return parts[index]
    ""

# A `line-height` value as the Style encoding: > 0 is a length in px, < 0 is a
# factor times ten negated (1.6 -> -16), 0 is "not a value this parser takes".
# `normal` is NOT handled here (0 already means that in Style): the caller
# tests `line_height_value_is_normal` first.
#
# A percentage is a factor of the element's font size: `150%` is 1.5x. Until
# 2026-11-14 it fell into the unitless branch and became 150x (`-1500`).
# Precision is one decimal, as for a unitless number: 125% is 1.2x.
# `em` is taken as a factor too (`1.5em` -> -15).
fn line_height_value_is_normal(raw: text) -> bool:
    raw.trim().lower() == "normal"

# The Style line-height after a `normal` keyword (`line-height: normal`, or a
# `font` shorthand, which resets line-height to normal).
#
# On the measured host `normal` is 0, the Style encoding the face metric is
# read for. Every other host keeps `current` — exactly what this renderer did
# before `normal` was honoured, when the keyword was dropped. That matters for
# a form control, whose UA line height is carried as an inherited-looking
# factor: `<input style="line-height:normal">` must stay on it there, not fall
# to the 9 * scale element fallback.
fn line_height_after_normal_keyword(current: i32, measured_host: bool) -> i32:
    if measured_host: 0 else: current

fn parse_line_height_value(raw: text) -> i32:
    if raw.contains("%"):
        val tenths = parse_decimal_x10(raw) / 100
        if tenths > 0:
            return 0 - tenths
        return 0
    if raw.contains("px"):
        val lh = parse_int(raw)
        if lh > 0:
            return lh
        return 0
    val whole = parse_int(raw)
    var mult10 = whole * 10
    val dot = find_from(raw, ".", 0)
    if dot >= 0 and dot + 1 < raw.byte_len():
        mult10 = whole * 10 + parse_int(raw.substring(dot + 1, dot + 2))
    if mult10 > 0:
        return 0 - mult10
    0

# Parse a CSS decimal number to its value times ten (e.g. "1.5" -> 15, "2" -> 20,
# "0.8" -> 8). Only the first fractional digit is honored, matching the
# line-height parser's precision. Trailing units (em/rem/%) are ignored because
# parse_int stops at the first non-digit run.
fn parse_decimal_x10(raw: text) -> i32:
    val whole = parse_int(raw)
    var m10 = whole * 10
    val dot = find_from(raw, ".", 0)
    if dot >= 0 and dot + 1 < raw.byte_len():
        m10 = whole * 10 + parse_int(raw.substring(dot + 1, dot + 2))
    m10

# Computed font-size in milli-px from the whole-px size and its optional
# fractional companion (`Style.font_size_milli`, 0 = exact whole px).
# reason: font size scalars are Style fields in px and milli-px
# @allow(primitive_api)
pub fn font_milli_of(font_size: i32, font_size_milli: i32) -> i32:
    if font_size_milli > 0: font_size_milli else: font_size * 1000

# Whole px (nearest, an exact .5 goes down: Chrome 13.5 px ink rows equal the
# 13 px rows, not the 14 px ones) of a milli-px font size.
# reason: milli-px scalar to whole px
# @allow(primitive_api)
pub fn font_milli_round_px(milli: i32) -> i32:
    (milli + 499) / 1000

# The `Style.font_size_milli` encoding of a milli-px size: 0 when whole px.
# reason: milli-px scalar to the Style encoding
# @allow(primitive_api)
pub fn font_milli_store(milli: i32) -> i32:
    if milli % 1000 == 0: 0 else: milli

# Split on ASCII whitespace, dropping empty tokens.
fn ws_tokens(s: text) -> [text]:
    var out: [text] = []
    # Byte offsets compose with substring and avoid O(N²) UTF-8 indexing.
    val bytes = s.bytes()
    var i = 0
    var start = -1
    while i <= bytes.len():
        val code = if i < bytes.len(): bytes[i] else: 32
        val whitespace = (
            code == 9 or code == 10 or code == 12 or
            code == 13 or code == 32
        )
        if whitespace:
            if start >= 0:
                out.push(s.substring(start, i))
                start = -1
        elif start < 0:
            start = i
        i = i + 1
    out

# The signed number of a horizontal margin token whose magnitude parsed to `v`
# (`parse_int` / `parse_decimal_x10` read only digits): a leading `-` restores
# the sign. The unit is kept beside the number (Style.margin_l_pct /
# margin_r_pct) and applied by resolve_horizontal_margin.
fn horizontal_margin_signed(tok: text, v: i32) -> i32:
    val magnitude = if v < 0: 0 - v else: v
    if tok.trim().starts_with("-"): 0 - magnitude else: magnitude

# One horizontal margin token's signed number: px, or a percentage when the
# token ends in `%` (the caller records that unit).
fn margin_token_px(tok: text) -> i32:
    horizontal_margin_signed(tok, parse_int(tok))

fn margin_token_vh_px(tok: text) -> i32:
    if tok.ends_with("vh"):
        return 0 - (1000 + parse_int(tok))
    # parse_int() ignores a leading '-' (it only accumulates digits), so a
    # literal negative px margin like "-10px" must have its sign restored
    # here; resolve_vertical_margin_px() passes values in -999..-1 through
    # unchanged (only <= -1000 is the vh-percentage sentinel above).
    val magnitude = parse_int(tok)
    if tok.trim().starts_with("-"):
        return 0 - magnitude
    magnitude

fn object_position_axis_pct(token: text, horizontal: bool) -> i32:
    val t = token.trim().lower()
    if t == "left":
        return 0
    if t == "top":
        return 0
    if t == "center":
        return 50
    if t == "right":
        return 100
    if t == "bottom":
        return 100
    if t.ends_with("%"):
        val pct = parse_int(t)
        if pct < 0:
            return 0
        if pct > 100:
            return 100
        return pct
    if horizontal:
        return 50
    50

fn object_position_x_pct(raw: text) -> i32:
    val normalized = raw.trim().lower()
    if normalized.len() == 0:
        return 50
    val parts = normalized.split(" ")
    if parts.len() == 1:
        val token = parts[0].trim().lower()
        if token == "top" or token == "bottom":
            return 50
        return object_position_axis_pct(token, true)
    object_position_axis_pct(parts[0], true)

fn object_position_y_pct(raw: text) -> i32:
    val normalized = raw.trim().lower()
    if normalized.len() == 0:
        return 50
    val parts = normalized.split(" ")
    if parts.len() == 1:
        val token = parts[0].trim().lower()
        if token == "left" or token == "right":
            return 50
        return object_position_axis_pct(token, false)
    object_position_axis_pct(parts[1], false)
