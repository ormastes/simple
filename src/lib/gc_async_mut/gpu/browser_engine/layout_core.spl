
# CSS Layout Core — Block, Flex, Text Layout
#
# Ported 2026-08-15 onto the committed BeLayoutBox shape (layout_box.spl):
# f64 geometry, `node_id`/`kind`/`tag_name`/`style` fields, and
# content_x()/content_y()/content_width()/content_height() as METHODS.
# See doc/08_tracking/bug/layout_core_incompatible_with_committed_belayoutbox_2026-08-15.md
#
#   layout_node       — dispatch by display type
#   _layout_block_be  — block formatting context (CSS 2.1 §9.4.1, simplified)
#   layout_flex       — flexbox main-axis stacking (simplified)
#   flex_shift_boxes_x, flex_distribute_x — flex justify helpers
#   layout_text_node  — text node layout with break-opportunity-aware wrapping
#   layout_text_has_break_opportunity — whitespace/hyphen break scan
#
# All functions take BeLayoutBox (from layout_box.spl) and return BeLayoutBox.
# No dependency on layout.spl — no circular imports.

use std.gc_async_mut.gpu.browser_engine.layout_box.{BeLayoutBox, BeBoxKind}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_get_style,
    be_dom_get_display, be_dom_get_is_text, be_dom_get_text,
    be_dom_get_children}
use std.gc_async_mut.gpu.browser_engine.layout_float.{FloatContext}

# =========================================================================
# Layout Node Dispatcher
# =========================================================================

pub fn layout_node(node: BeDomNode, container: BeLayoutBox, parent_style: StyleProps, ctx: FloatContext) -> BeLayoutBox:
    """Lay out a single node within its container — dispatches by display type."""
    val disp = be_dom_get_display(node)
    if disp == "none":
        return BeLayoutBox.block_for(node, container.content_x(), container.content_y(), 0.0, 0.0)
    if be_dom_get_is_text(node):
        return layout_text_node(node, container, parent_style, ctx)
    val s = be_dom_get_style(node)
    if disp == "flex" or disp == "inline-flex":
        return layout_flex(node, container, s, ctx)
    return _layout_block_be(node, container, s, ctx)

# =========================================================================
# Block Layout (CSS 2.1 §9.4.1)
# =========================================================================

fn _plain_box(node: BeDomNode, x: f64, y: f64, width: f64, height: f64) -> BeLayoutBox:
    """A zero-inset container box: content area == border box."""
    BeLayoutBox(
        node_id: node.node_id,
        kind: BeBoxKind.Anonymous,
        x: x, y: y, width: width, height: height,
        margin_top: 0.0, margin_right: 0.0, margin_bottom: 0.0, margin_left: 0.0,
        padding_top: 0.0, padding_right: 0.0, padding_bottom: 0.0, padding_left: 0.0,
        border_width: 0.0,
        text_content: "", tag_name: node.tag_name, style: node.style,
        children: []
    )

pub fn _layout_block_be(node: BeDomNode, container: BeLayoutBox, style: StyleProps, ctx: FloatContext) -> BeLayoutBox:
    """Lay out a block-level element with the CSS box model and child recursion."""
    val cw = container.content_width()
    val ch = container.content_height()

    # Resolve width (block fills container by default minus margins; 0 = auto)
    var box_width = cw - style.margin_left - style.margin_right
    if style.width > 0.0:
        box_width = style.width
    if box_width < 0.0:
        box_width = 0.0

    val box_x = container.content_x() + style.margin_left
    val box_y = container.content_y() + style.margin_top

    # Provisional box so content_* methods resolve against this node's insets
    var box_ = BeLayoutBox.block_for(node, box_x, box_y, box_width, 0.0)

    var child_boxes: [BeLayoutBox] = []
    var cursor_y = box_.content_y()
    val kids = be_dom_get_children(node)
    var i = 0
    while i < kids.len():
        val child = kids[i]
        i = i + 1
        if be_dom_get_display(child) != "none":
            val child_container = _plain_box(
                child, box_.content_x(), cursor_y, box_.content_width(), 0.0)
            val child_box = layout_node(child, child_container, style, ctx)
            child_boxes.push(child_box)
            val child_style = be_dom_get_style(child)
            cursor_y = cursor_y + child_box.height + child_style.margin_top + child_style.margin_bottom

    var content_h = cursor_y - box_.content_y()
    if style.height > 0.0:
        content_h = style.height
    if content_h < 0.0:
        content_h = 0.0

    box_.height = content_h + style.padding_top + style.padding_bottom + style.border_width * 2.0
    box_.children = child_boxes
    box_

# =========================================================================
# Flexbox Layout (simplified main-axis stacking)
# =========================================================================

pub fn layout_flex(node: BeDomNode, container: BeLayoutBox, style: StyleProps, ctx: FloatContext) -> BeLayoutBox:
    """Lay out a flex container: stack children along the main axis."""
    val is_row = style.flex_direction != "column"
    var box_ = _layout_block_be(node, container, style, ctx)
    if not is_row:
        return box_
    # Re-stack children horizontally
    var cursor_x = box_.content_x()
    val top = box_.content_y()
    var max_h = 0.0
    var i = 0
    while i < box_.children.len():
        box_.children[i].x = cursor_x
        box_.children[i].y = top
        cursor_x = cursor_x + box_.children[i].width
        if box_.children[i].height > max_h:
            max_h = box_.children[i].height
        i = i + 1
    if style.height <= 0.0:
        box_.height = max_h + style.padding_top + style.padding_bottom + style.border_width * 2.0
    box_

pub fn flex_shift_boxes_x(boxes: [BeLayoutBox], offset: f64):
    """Shift all boxes along the X axis by offset."""
    var i = 0
    while i < boxes.len():
        boxes[i].x = boxes[i].x + offset
        i = i + 1

pub fn flex_distribute_x(boxes: [BeLayoutBox], start_x: f64, extra_per_item: f64, gap: f64):
    """Redistribute boxes along X axis with extra spacing."""
    var cursor = start_x
    var i = 0
    while i < boxes.len():
        boxes[i].x = cursor
        cursor = cursor + boxes[i].width + gap + extra_per_item
        i = i + 1

# =========================================================================
# Text Node Layout
# =========================================================================

pub fn layout_text_has_break_opportunity(s: text) -> bool:
    """True when the text contains a soft-wrap break opportunity
    (whitespace or hyphen)."""
    s.contains(" ") or s.contains("\t") or s.contains("\n") or s.contains("-")

pub fn layout_text_node(node: BeDomNode, container: BeLayoutBox, parent_style: StyleProps, ctx: FloatContext) -> BeLayoutBox:
    """Lay out a text node. Wraps only when the text has a break opportunity
    or overflow-wrap permits breaking within words (break-word/anywhere)."""
    val fs = parent_style.font_size.to_i32()
    val line_h = fs + fs / 5
    val char_w = fs * 3 / 5
    val txt = be_dom_get_text(node)
    val total = txt.len()
    val cw = container.content_width().to_i32()
    val raw_w = total * char_w
    val can_wrap = (layout_text_has_break_opportunity(txt) or
        parent_style.overflow_wrap == "break-word" or
        parent_style.overflow_wrap == "anywhere")
    var w = raw_w
    var lines = 1
    if can_wrap and cw > 0 and char_w > 0 and raw_w > cw:
        lines = (raw_w + cw - 1) / cw
        w = cw
    val h = lines * line_h
    BeLayoutBox.text_box(node, txt, container.content_x(), container.content_y(), w.to_f64(), h.to_f64())
