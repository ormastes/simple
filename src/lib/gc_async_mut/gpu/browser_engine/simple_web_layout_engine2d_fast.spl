# Unified web render entry: HTML -> layout -> Draw IR -> Engine2D fast mode.
#
# This is the native-accelerated counterpart to the software layout renderer
# (simple_web_layout_render_html_software_pixels) and the pinned heuristic
# renderer (simple_web_engine2d_render_html_pixels), which remain explicit
# compatibility oracles. This entry runs the real
# layout/paint Draw IR on an Engine2D created in no-mirror fast mode, so the
# per-op interpreted framebuffer mirror (the entire render cost at desktop
# resolution — see
# doc/08_tracking/bug/engine2d_interpreted_mirror_dominates_render_2026-07-03.md)
# is collapsed to a 1x1 clip and the framebuffer is read back from the GPU in a
# single FFI hop.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    SimpleWebLayoutDrawIrResult,
    SimpleWebLayoutMaterialWitness,
    simple_web_layout_last_render_degraded,
    simple_web_layout_material_provenance_after_backend_execution,
    simple_web_layout_render_html_draw_ir_result_with_images,
    simple_web_layout_render_html_draw_ir_result_at_time_with_animations_with_images
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{
    simple_web_layout_clear_render_degraded,
    simple_web_layout_render_budget_floor_ms,
    simple_web_layout_restore_render_budget_floor_ms,
    simple_web_layout_set_render_budget_floor_ms
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_engine2d_presenter.{
    WebGpuPaintTimingEvidence,
    present_layout_pixels_with_engine2d_readback,
    web_gpu_paint_backend_verdict,
    web_gpu_paint_enabled,
    web_gpu_paint_timing_evidence
}
use std.gc_async_mut.gpu.browser_engine.style.animation.{
    BrowserCssAnimationInstance
}
use std.gc_async_mut.io.mod_stub.{env_get}
use std.common.ui.ui_frame_clock.{FrameClock}
use std.nogc_sync_mut.ui.host_frame_clock.{default_frame_clock}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.helpers_availability.{backend_canonical_name}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dDrawIrAdvResult, Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_with_images,
    engine2d_resolved_draw_ir_image
}
use std.gc_async_mut.gpu.engine2d.backend.{Engine2DReadback, engine2d_readback}
use std.gc_async_mut.gpu.engine2d.backend_probe.{BackendStatus}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{vulkan_draw_census_line, vulkan_draw_census_reset, vulkan_readback_census_line, vulkan_readback_census_reset}
use common.ui.web_render_api.{WebRenderMaterialFallbackProvenance}
use common.ui.draw_ir.{DrawIrComposition}
use std.common.gpu.simpleos_host_gpu_draw_ir.{SimpleOsHostGpuImageResource}

# Shared clock for the perf-instrumentation start/end pairs below (phase
# timing, upload/gpu route timing). Module-level rather than per-call so it
# is constructed once, not once per timed call.
var _fast_clock: FrameClock = default_frame_clock()

class SimpleWebLayoutEngine2DExecutionResult:
    render: Engine2dDrawIrAdvResult
    material_fallback: WebRenderMaterialFallbackProvenance
    # True iff the layout/style pass that produced this result tripped its
    # wall-clock budget and stopped early (see
    # simple_web_layout_last_render_degraded). Every vector_font_* field below
    # is then derived from an INCOMPLETE cascade and must not be read as
    # evidence -- nodes the cascade never reached keep renderer_default_style()
    # (sans-serif/16px), so the reported identity and pixel size describe the
    # default face rather than the document's. Consumers gate on this FIRST.
    render_degraded: bool
    vector_font_identity: text
    vector_font_pixel_size: i32
    vector_font_execution_target: text
    vector_font_batch_identity: text
    vector_font_readback_source: text
    vector_font_device_checksum: i64
    vector_font_oracle_checksum: i64
    vector_font_readback_nonblank_pixels: i64
    vector_font_device_executed: bool
    vector_font_promotion_ready: bool

class SimpleWebLayoutEngine2DReadbackResult:
    readback: Engine2DReadback
    material_fallback: WebRenderMaterialFallbackProvenance
    # See SimpleWebLayoutEngine2DExecutionResult.render_degraded -- carried
    # through so readback consumers can fail closed on a truncated cascade
    # instead of trusting fabricated vector_font_* evidence.
    render_degraded: bool
    # The engine2d backend that actually produced `readback.pixels` -- see
    # commit ca75bf0700a ("label an artifact with the backend that produced
    # its pixels"). Explicit `text` annotation here (rather than leaving the
    # type to be inferred solely from call-site arguments) works around a HIR
    # lowering gap in the pure-Simple self-hosted compiler; see
    # doc/08_tracking/bug/hir_lowering_cannot_infer_struct_field_type_from_constructor_args_only_2026-08-08.md
    resolved_backend: text
    vector_font_identity: text
    vector_font_pixel_size: i32
    vector_font_execution_target: text
    vector_font_batch_identity: text
    vector_font_readback_source: text
    vector_font_device_checksum: i64
    vector_font_oracle_checksum: i64
    vector_font_readback_nonblank_pixels: i64
    vector_font_device_executed: bool
    vector_font_promotion_ready: bool

class _WebDrawIrRouteState:
    key: text
    # A non-zero DrawIr composition generation is an exact revision in this
    # admitted serial route owner, not a hash. Zero is not cache-eligible.
    scene_generation: i64
    upload_samples: [i64]
    gpu_samples: [i64]
    pixels_match: bool
    # Sticky, first-wins name for a sample that carried no device evidence
    # ("" while every sample did). Kept SEPARATE from `pixels_match` on purpose:
    # an absent readback refuses the route without claiming the pixels differed.
    readback_absence: text
    upload_device_proven: bool
    gpu_device_proven: bool
    commands_complete: bool
    device_identity: i64
    complete: bool
    evidence: WebGpuPaintTimingEvidence
    # Canonical oracle pixels from the first three exact device-vs-oracle
    # validations for this scene generation. Arrays have language-level value
    # semantics, so callers receive a copy-on-write value and cannot mutate the
    # retained owner slot through the returned value. The producer generation
    # and parked owner token authorize reuse; no hash authorizes it.
    validated_pixels: [u32]
    validated_device_token: text
    # Checksum of `validated_pixels` under the DEVICE fold (see
    # `_web_draw_ir_device_checksum`). Retained once at validation so a steady
    # re-validation frame compares one i64 instead of scanning 8.3M pixels.
    # 0 means "no compatible checksum was available" and the exact pixel
    # compare is used for that route instead.
    validated_checksum: i64

class _WebDrawIrTimedRoute:
    readback: Engine2DReadback
    oracle_pixels: [u32]
    elapsed_us: i64
    skipped_command_count: i32

# ponytail: process-local cache matches the current single-render-thread
# contract; move it into BrowserRenderer before concurrent renderers are admitted.
var _web_draw_ir_route_states: [_WebDrawIrRouteState] = []
var _web_draw_ir_route_consults: i32 = 0
var _web_draw_ir_route_canonical_submissions: i32 = 0
var _web_draw_ir_route_cached_reuses: i32 = 0
var _web_draw_ir_last_comparison_receipt: text = ""
var _web_draw_ir_last_evidence: WebGpuPaintTimingEvidence = web_gpu_paint_timing_evidence("", 0, 0, 0, 0, 0, false, false, false)
val WEB_DRAW_IR_ROUTE_CACHE_MAX: i32 = 16

# Item 1 of doc/08_tracking/todo/web_gpu_offload_buffer_residency_audit_2026-09-05.md:
# a whole Engine2D — and with it the framebuffer, staging and font device
# buffers that VulkanBackend.init / MetalBackend.init allocate — was created and
# destroyed on every route call, at a surface extent that had not changed
# between frames. Park the engine between calls instead, keyed on the only
# identity that determines whether the parked device state is still valid: the
# CANONICAL backend key plus the surface extent.
#
# A parked handle is never evidence that the device is healthy. `_web_fast_engine_healthy`
# is re-evaluated on both park and acquire, and anything it cannot vouch for is
# torn down and rebuilt: a different extent, a different backend, an engine that
# did not get the backend it was asked for (create_with_backend_fast never
# fails — it silently falls back, and a fallback surface must never be handed
# back as though the requested backend had initialized), or a device whose
# in-flight work state is unknown (`completion_unknown`, `vulkan_font_state_unknown`).
# Fail closed: when in doubt, discard and recreate.
class _WebFastEngineSlot:
    backend: text
    width: i32
    height: i32
    # Cache-owner lifecycle identity. Raw GPU handles can be recycled after
    # teardown, so they are never sufficient to distinguish two allocations.
    owner_generation: i64
    engine: Engine2D

var _web_fast_engine_slots: [_WebFastEngineSlot] = []
var _web_fast_engine_creates: i32 = 0
var _web_fast_engine_reuses: i32 = 0
var _web_fast_engine_discards: i32 = 0
var _web_fast_engine_next_owner_generation: i64 = 1
# One slot per canonical backend. The route runs at most two backends per frame
# (the software oracle and the requested lane); the cap only bounds a caller
# that cycles backend names.
val WEB_FAST_ENGINE_SLOT_MAX: i32 = 4

fn _web_fast_engine_healthy(
    engine: Engine2D, canonical_backend: text, width: i32, height: i32
) -> bool:
    if engine.w != width or engine.h != height:
        return false
    if engine.selected_backend_name != canonical_backend:
        return false
    if engine.vulkan_font_state_unknown:
        return false
    if val Some(vulkan) = engine.vulkan_backend:
        if not vulkan.initialized:
            return false
        if vulkan.completion_unknown:
            return false
    if val Some(metal) = engine.metal_backend:
        if not metal.initialized:
            return false
    true

fn _web_fast_engine_cached_device_token(
    width: i32, height: i32, backend_name: text
) -> text:
    """Return the parked surface/device generation token, or empty.

    This is an observation of the existing owner; it submits no work and does
    not make a device healthy.  A changed framebuffer handle or device
    identity therefore invalidates a retained frame before it can be reused.
    The cache-owner generation closes the raw-handle ABA hole after teardown.
    """
    val canonical = backend_canonical_name(backend_name)
    val found = _web_fast_engine_slot_index(canonical)
    if found < 0:
        return ""
    val slot = _web_fast_engine_slots[found]
    if slot.width != width or slot.height != height:
        return ""
    if not _web_fast_engine_healthy(slot.engine, canonical, width, height):
        return ""
    if slot.owner_generation <= 0:
        return ""
    if canonical == "vulkan":
        val handle = slot.engine.vulkan_framebuffer_handle()
        val device = slot.engine.vulkan_device_identity()
        if handle > 0 and device > 0:
            return "vulkan;owner=" + slot.owner_generation.to_text() +
                ";surface=" + handle.to_text() + ";device=" + device.to_text()
        return ""
    if canonical == "metal":
        if val Some(metal) = slot.engine.metal_backend:
            if metal.initialized and metal.d_framebuffer > 0 and metal.device_identity > 0:
                return "metal;owner=" + slot.owner_generation.to_text() +
                    ";surface=" + metal.d_framebuffer.to_text() +
                    ";device=" + metal.device_identity.to_text()
    ""

fn _web_fast_engine_validated_device_token(
    readback: Engine2DReadback, width: i32, height: i32, backend_name: text
) -> text:
    """Bind a proven readback to the exact currently parked cache owner."""
    if readback.backend_handle <= 0 or readback.device_identity <= 0:
        return ""
    val canonical = backend_canonical_name(backend_name)
    val found = _web_fast_engine_slot_index(canonical)
    if found < 0:
        return ""
    val slot = _web_fast_engine_slots[found]
    if (
        slot.owner_generation <= 0 or slot.width != width or slot.height != height or
        not _web_fast_engine_healthy(slot.engine, canonical, width, height)
    ):
        return ""
    if canonical == "vulkan":
        if (
            slot.engine.vulkan_framebuffer_handle() != readback.backend_handle or
            slot.engine.vulkan_device_identity() != readback.device_identity
        ):
            return ""
    elif canonical == "metal":
        if val Some(metal) = slot.engine.metal_backend:
            if (
                metal.d_framebuffer != readback.backend_handle or
                metal.device_identity != readback.device_identity
            ):
                return ""
        else:
            return ""
    else:
        return ""
    _web_fast_engine_cached_device_token(width, height, backend_name)

fn _web_fast_engine_slot_index(canonical_backend: text) -> i32:
    var index = 0
    while index < _web_fast_engine_slots.len():
        if _web_fast_engine_slots[index].backend == canonical_backend:
            return index
        index = index + 1
    -1

fn _web_fast_engine_acquire(
    width: i32, height: i32, backend_name: text
) -> _WebFastEngineSlot:
    val canonical = backend_canonical_name(backend_name)
    val found = _web_fast_engine_slot_index(canonical)
    if found >= 0:
        val slot = _web_fast_engine_slots[found]
        _web_fast_engine_slots.remove(found)
        var reusable = slot.width == width and slot.height == height
        if reusable:
            reusable = _web_fast_engine_healthy(slot.engine, canonical, width, height)
        if reusable:
            _web_fast_engine_reuses = _web_fast_engine_reuses + 1
            # A reused engine must start the frame with no pending compute
            # batch: the handle any surviving batch names was already submitted
            # and freed, so binding a pipeline on it fails and demotes the
            # whole frame to the CPU fallback.
            slot.engine.vulkan_discard_stale_pending_compute()
            return slot
        slot.engine.shutdown()
        _web_fast_engine_discards = _web_fast_engine_discards + 1
    _web_fast_engine_creates = _web_fast_engine_creates + 1
    val owner_generation = _web_fast_engine_next_owner_generation
    if _web_fast_engine_next_owner_generation > 0:
        if _web_fast_engine_next_owner_generation >= 9223372036854775807:
            # Exhaustion disables retained-frame authorization. The engine may
            # still render this call, but a zero generation is never cached.
            _web_fast_engine_next_owner_generation = 0
        else:
            _web_fast_engine_next_owner_generation =
                _web_fast_engine_next_owner_generation + 1
    _WebFastEngineSlot(
        backend: canonical, width: width, height: height,
        owner_generation: owner_generation,
        engine: Engine2D.create_with_backend_fast(width, height, backend_name))

fn _web_fast_engine_release(
    slot: _WebFastEngineSlot, width: i32, height: i32, backend_name: text
):
    val canonical = backend_canonical_name(backend_name)
    if (
        slot.backend != canonical or slot.width != width or slot.height != height or
        not _web_fast_engine_healthy(slot.engine, canonical, width, height)
    ):
        slot.engine.shutdown()
        _web_fast_engine_discards = _web_fast_engine_discards + 1
        return
    if _web_fast_engine_slots.len() >= WEB_FAST_ENGINE_SLOT_MAX:
        val evicted = _web_fast_engine_slots[0]
        _web_fast_engine_slots.remove(0)
        evicted.engine.shutdown()
        _web_fast_engine_discards = _web_fast_engine_discards + 1
    _web_fast_engine_slots.push(slot)

# Teardown for every parked engine. Called from web_draw_ir_gpu_route_policy_reset()
# so a parked device buffer can never outlive the policy that parked it, and so
# a caller shutting the route down releases them explicitly rather than leaking.
pub fn web_draw_ir_engine_cache_drain():
    var index = 0
    while index < _web_fast_engine_slots.len():
        _web_fast_engine_slots[index].engine.shutdown()
        _web_fast_engine_discards = _web_fast_engine_discards + 1
        index = index + 1
    _web_fast_engine_slots = []

pub fn web_draw_ir_engine_cache_create_count() -> i32:
    _web_fast_engine_creates

pub fn web_draw_ir_engine_cache_reuse_count() -> i32:
    _web_fast_engine_reuses

pub fn web_draw_ir_engine_cache_discard_count() -> i32:
    _web_fast_engine_discards

pub fn web_draw_ir_engine_cache_live_count() -> i32:
    _web_fast_engine_slots.len()

fn _web_draw_ir_copy_evidence(value: WebGpuPaintTimingEvidence) -> WebGpuPaintTimingEvidence:
    WebGpuPaintTimingEvidence(
        backend_name: value.backend_name,
        available: value.available,
        sample_count: value.sample_count,
        upload_bound_p50_us: value.upload_bound_p50_us,
        upload_bound_p95_us: value.upload_bound_p95_us,
        gpu_paint_p50_us: value.gpu_paint_p50_us,
        gpu_paint_p95_us: value.gpu_paint_p95_us,
        pixels_match: value.pixels_match,
        upload_device_proven: value.upload_device_proven,
        gpu_device_proven: value.gpu_device_proven,
        commands_complete: value.commands_complete,
        should_offload: value.should_offload,
        reason: value.reason,
        speed_verdict: value.speed_verdict
    )

pub fn web_draw_ir_gpu_route_policy_reset():
    web_draw_ir_engine_cache_drain()
    _web_fast_engine_creates = 0
    _web_fast_engine_reuses = 0
    _web_fast_engine_discards = 0
    _web_draw_ir_fingerprint_pixels_scanned = 0
    _web_draw_ir_pixels_equal_calls = 0
    _web_draw_ir_route_states = []
    _web_draw_ir_route_consults = 0
    _web_draw_ir_route_canonical_submissions = 0
    _web_draw_ir_route_cached_reuses = 0
    _web_draw_ir_last_comparison_receipt = ""
    _web_draw_ir_last_evidence = web_gpu_paint_timing_evidence(
        "", 0, 0, 0, 0, 0, false, false, false)

pub fn web_draw_ir_gpu_route_policy_consult_count() -> i32:
    _web_draw_ir_route_consults

pub fn web_draw_ir_gpu_route_canonical_submission_count() -> i32:
    _web_draw_ir_route_canonical_submissions

pub fn web_draw_ir_gpu_route_cached_reuse_count() -> i32:
    _web_draw_ir_route_cached_reuses

pub fn web_draw_ir_gpu_route_last_comparison_receipt() -> text:
    _web_draw_ir_last_comparison_receipt

pub fn web_draw_ir_gpu_route_last_evidence() -> WebGpuPaintTimingEvidence:
    _web_draw_ir_copy_evidence(_web_draw_ir_last_evidence)

fn _web_draw_ir_key_text(value: text) -> text:
    value.len().to_text() + ":" + value

fn _web_draw_ir_document_identity(composition: DrawIrComposition) -> text:
    """Identity of the DOCUMENT being painted, not of this frame's revision.

    Stable across a scroll, an animation tick and a repaint of the same page;
    changes when a different producer/document/backend target is painted.
    """
    composition.composition_id + ";" + composition.scene_key + ";" +
        composition.backend_target

pub fn web_draw_ir_route_key(
    document_identity: text, width: i32, height: i32, backend_name: text,
    device_token: text
) -> text:
    """Route-cache identity: device + surface + extent + document.

    It deliberately contains NO per-mutation counter and NO content hash.
    Keying on `composition.generation` (or on a SHA-256 of the serialized
    scene) gave every scroll, animation tick and tab switch a brand-new key,
    so the route sampler re-armed and re-ran the software oracle on a device
    it had already proven. Retained PIXEL reuse is still gated exactly, by
    `_web_draw_ir_cached_frame_reusable` (producer generation + parked owner
    token + extent) — that gate, not this key, is what keeps a stale frame off
    the screen.
    """
    (
        _web_draw_ir_key_text(document_identity) + ";" +
        width.to_text() + ";" + height.to_text() + ";" +
        _web_draw_ir_key_text(device_token) +
        _web_draw_ir_key_text(backend_name) +
        _web_draw_ir_key_text(_web_draw_ir_env("SIMPLE_ONE_CALL_UPLOAD")) +
        _web_draw_ir_key_text(_web_draw_ir_env("SIMPLE_BULK_UPLOAD")) +
        _web_draw_ir_key_text(_web_draw_ir_env("SIMPLE_SPL_GPU_TRANSFER_PATH")) +
        _web_draw_ir_key_text(_web_draw_ir_env("SIMPLE_ONE_CALL_READBACK"))
    )

fn _web_draw_ir_key(composition: DrawIrComposition, width: i32, height: i32, backend_name: text) -> text:
    web_draw_ir_route_key(
        _web_draw_ir_document_identity(composition), width, height, backend_name,
        _web_fast_engine_cached_device_token(width, height, backend_name))

pub fn web_draw_ir_composition_route_key(
    composition: DrawIrComposition, width: i32, height: i32, backend_name: text
) -> text:
    """The key the route cache actually uses for this composition.

    Exposed so a spec can assert that two compositions differing ONLY in
    `generation` land on the same route state.
    """
    _web_draw_ir_key(composition, width, height, backend_name)

fn _web_draw_ir_env(key: text) -> text:
    env_get(key) ?? ""

fn _simple_web_draw_ir_last_text_font_pixel_size(
    composition: DrawIrComposition, font_identity: text
) -> i32:
    if font_identity == "":
        return 0
    var pixel_size = 0
    for batch in composition.batches:
        for command in batch.commands:
            if command.kind == "text":
                var command_identity = ""
                var command_pixel_size = 0
                for prop in command.computed_style:
                    if prop.key == "font-identity":
                        command_identity = prop.value
                    elif prop.key == "font-size":
                        val parsed = prop.value.to_i64()
                        if parsed != nil and parsed > 0:
                            command_pixel_size = parsed.to_i32()
                if command_identity == font_identity:
                    pixel_size = command_pixel_size
    pixel_size

fn _simple_web_layout_execute_draw_ir_composition(
    composition: DrawIrComposition, material_witness: SimpleWebLayoutMaterialWitness,
    width: i32, height: i32, backend_name: text,
    image_resources: [SimpleOsHostGpuImageResource]
) -> SimpleWebLayoutEngine2DExecutionResult:
    val render = _simple_web_layout_render_draw_ir_composition(
        composition, width, height, backend_name, image_resources)
    # A caller that asked for an accelerated backend and got its pixels back
    # from a CPU fallback surface received a DEMOTED frame. Before 2026-08-02
    # that demotion was invisible here (`render_degraded` stayed false), which
    # is how a Vulkan lane poisoned mid-frame by a font-route failure could
    # publish a partial frame as a complete one. Latch it.
    val lane_demoted = (
        backend_name != "software" and backend_name != "cpu" and
        render.readback_source == "cpu_fallback")
    val material_fallback = simple_web_layout_material_provenance_after_backend_execution(
        material_witness,
        render.skipped_command_count,
        render.pixels.len(),
        width * height,
        render.cpu_composited_material_count,
        render.metal_device_glass_material_count,
        render.glass_execution_target,
        render.readback_source,
        render.glass_backend_handle,
        render.glass_device_identity
    )
    SimpleWebLayoutEngine2DExecutionResult(
        render: render, material_fallback: material_fallback,
        # Captured AFTER the layout/style pass has run, so it reflects any
        # budget break in that pass; the vector_font_* fields below are only
        # trustworthy when this is false.
        render_degraded: simple_web_layout_last_render_degraded() or lane_demoted,
        vector_font_identity: render.font_identity,
        vector_font_pixel_size:
            _simple_web_draw_ir_last_text_font_pixel_size(
                composition, render.font_identity),
        vector_font_execution_target: render.font_execution_target,
        vector_font_batch_identity: render.font_batch_identity,
        vector_font_readback_source: render.font_readback_source,
        vector_font_device_checksum: render.font_device_checksum,
        vector_font_oracle_checksum: render.font_oracle_checksum,
        vector_font_readback_nonblank_pixels:
            render.font_readback_nonblank_pixels,
        vector_font_device_executed: render.font_device_executed,
        vector_font_promotion_ready: render.font_promotion_ready)

fn _simple_web_layout_render_draw_ir_composition(
    composition: DrawIrComposition, width: i32, height: i32,
    backend_name: text, image_resources: [SimpleOsHostGpuImageResource]
) -> Engine2dDrawIrAdvResult:
    var slot = _web_fast_engine_acquire(width, height, backend_name)
    slot.engine.clear(0u32)
    var images: [Engine2dResolvedDrawIrImage] = []
    for image in image_resources:
        images.push(engine2d_resolved_draw_ir_image(
            image.image_uri, image.width, image.height, image.pixels
        ))
    val render = engine2d_draw_ir_adv_composition_with_images(
        slot.engine, composition, true, images
    )
    _web_fast_engine_release(slot, width, height, backend_name)
    render

fn _simple_web_layout_draw_ir_once(
    html: text, width: i32, height: i32, animation_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance],
    image_resources: [SimpleOsHostGpuImageResource]
) -> SimpleWebLayoutDrawIrResult:
    if animation_time_ms >= 0:
        return simple_web_layout_render_html_draw_ir_result_at_time_with_animations_with_images(
            html, width, height, animation_time_ms, animation_instances,
            image_resources
        )
    simple_web_layout_render_html_draw_ir_result_with_images(
        html, width, height, image_resources
    )

# One bounded retry floor for a budget-truncated cascade, matching the
# sanctioned showcase calibration (simple_web_layout_set_render_budget_floor_ms
# in web_showcase_full_gpu_offload_spec.spl). See
# _simple_web_layout_draw_ir_with_degraded_retry below.
val WEB_LAYOUT_DEGRADED_RETRY_FLOOR_MS: i64 = 900000

# A budget-truncated style cascade leaves every node past the break on
# renderer-default styles, so class/id-selector styling silently vanishes
# from the frame while the readback still reports plausible pixels (the
# "seems able but can't" family: observed 2026-08-01 as class-selector boxes
# dropping to 0 painted pixels on the readback-result entry under the
# interpreter, load-dependent). Documents needing selector matching must
# reach the REAL resolved cascade: retry the layout ONCE with the platform
# budget floor raised to the showcase calibration, then restore the caller's
# floor. If the retry still trips its (floored) deadline, render_degraded
# stays latched and is propagated — honest fallback, never a silent publish
# of dropped styling.
#
# Scope: the READBACK-RESULT entry only. The pixels parity lanes (cpu oracle
# vs offload lane in web_engine2d_gpu_offload_parity_spec) deliberately keep
# the single-pass layout: a retry there doubles interpreted layout ops per
# render and blows the spec runner's per-example operation limit, and both
# lanes of a parity comparison run the identical single-pass cascade anyway.
fn _simple_web_layout_draw_ir_with_degraded_retry(
    html: text, width: i32, height: i32, animation_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance],
    image_resources: [SimpleOsHostGpuImageResource]
) -> SimpleWebLayoutDrawIrResult:
    val first = _simple_web_layout_draw_ir_once(
        html, width, height, animation_time_ms, animation_instances,
        image_resources
    )
    if not simple_web_layout_last_render_degraded():
        return first
    val saved_floor = simple_web_layout_render_budget_floor_ms()
    if saved_floor >= WEB_LAYOUT_DEGRADED_RETRY_FLOOR_MS:
        # The first pass already ran under an adequate floor; a retry under
        # the same wall-clock budget cannot resolve more styles.
        return first
    simple_web_layout_set_render_budget_floor_ms(WEB_LAYOUT_DEGRADED_RETRY_FLOOR_MS)
    val retried = _simple_web_layout_draw_ir_once(
        html, width, height, animation_time_ms, animation_instances,
        image_resources
    )
    simple_web_layout_restore_render_budget_floor_ms(saved_floor)
    retried

# --- Steady-frame document pipeline cache ---------------------------------
#
# Parse, style, layout and Draw IR build re-ran on EVERY frame with no cache:
# on the native-readback lane that is ~10 ms of an ~18 ms steady frame at
# 900x760 (doc/10_metrics/ui/web_render_frame_profile_macos_2026-09-12.md).
# Nothing about those four stages depends on the frame number, so a frame whose
# document, viewport and animation clock are unchanged may reuse the composed
# result outright. Painting is NOT cached — the composition is re-executed on
# the backend every frame, so damage, device state and readback are untouched.
#
# One entry, held in a 0-or-1 element array because a module-level `var` of a
# class type has no sentinel value. The key is every input that can change the
# composed document at this funnel; the html source is compared by VALUE rather
# than digested, because a per-frame sha256 over multi-KB markup in the
# interpreter would itself cost more than the pipeline it replaces.
var _web_doc_cache_entry: [SimpleWebLayoutDrawIrResult] = []
var _web_doc_cache_key: text = ""
var _web_doc_cache_html: text = ""
var _web_doc_cache_hits: i32 = 0
var _web_doc_cache_misses: i32 = 0
var _web_doc_cache_last_hit: bool = false
var _web_doc_cache_last_pipeline_us: i64 = 0

pub fn web_document_cache_drain():
    """Drop the cached document. Call when a font set or any other input the
    key does not name changes; a drain only ever costs a recompose."""
    _web_doc_cache_entry = []
    _web_doc_cache_key = ""
    _web_doc_cache_html = ""
    _web_doc_cache_hits = 0
    _web_doc_cache_misses = 0
    _web_doc_cache_last_hit = false
    _web_doc_cache_last_pipeline_us = 0

pub fn web_document_cache_hit() -> bool:
    """Did the most recent render reuse the cached document pipeline?"""
    _web_doc_cache_last_hit

pub fn web_document_cache_hit_count() -> i32:
    _web_doc_cache_hits

pub fn web_document_cache_miss_count() -> i32:
    _web_doc_cache_misses

pub fn web_document_pipeline_ms() -> i64:
    """Wall-clock ms the most recent render spent in parse+style+layout+Draw IR
    build. On a hit this is the lookup cost only."""
    _web_doc_cache_last_pipeline_us / 1000

fn _web_document_cache_key(
    width: i32, height: i32, animation_time_ms: i64, retry_degraded: bool,
    scroll_y: i32, html_len_key: i32
) -> text:
    (
        width.to_text() + "x" + height.to_text() + ";t=" +
        animation_time_ms.to_text() + ";retry=" + (if retry_degraded: "1" else: "0") +
        ";scroll=" + scroll_y.to_text() +
        ";floor=" + simple_web_layout_render_budget_floor_ms().to_text() +
        # No device-scale or font-set term: `vector_fonts` is a hardcoded
        # `true` at every entry this funnel reaches
        # (simple_web_layout_render_html_draw_ir_result_with_images and its
        # at_time siblings), and no device-scale input reaches the compose at
        # all. Naming env vars nothing reads would be false coverage; a font
        # set that IS swapped at runtime must call web_document_cache_drain().
        ";budget=" + _web_draw_ir_key_text(_web_draw_ir_env("SIMPLE_WEB_RENDER_BUDGET_MS")) +
        ";len=" + html_len_key.to_text()
    )

# Frames carrying per-frame inputs the key does not name bypass the cache
# entirely and behave exactly as before.
fn _web_document_cache_eligible(
    animation_instances: [BrowserCssAnimationInstance],
    image_resources: [SimpleOsHostGpuImageResource]
) -> bool:
    animation_instances.len() == 0 and image_resources.len() == 0

fn _simple_web_layout_draw_ir_cached(
    html: text, width: i32, height: i32,
    animation_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance],
    image_resources: [SimpleOsHostGpuImageResource],
    retry_degraded: bool
) -> SimpleWebLayoutDrawIrResult:
    val start_us = _fast_clock.now_micros()
    val eligible = _web_document_cache_eligible(animation_instances, image_resources)
    val key = if eligible:
        _web_document_cache_key(width, height, animation_time_ms, retry_degraded, 0, html.len())
    else:
        ""
    if eligible and _web_doc_cache_entry.len() == 1 and key == _web_doc_cache_key and html == _web_doc_cache_html:
        _web_doc_cache_hits = _web_doc_cache_hits + 1
        _web_doc_cache_last_hit = true
        # The latch is cleared by starting a render, which a hit skips; the
        # cached result is only ever a non-degraded one (see below).
        simple_web_layout_clear_render_degraded()
        _web_doc_cache_last_pipeline_us = _fast_clock.now_micros() - start_us
        return _web_doc_cache_entry[0]
    _web_doc_cache_last_hit = false
    if eligible:
        _web_doc_cache_misses = _web_doc_cache_misses + 1
    val computed = if retry_degraded:
        _simple_web_layout_draw_ir_with_degraded_retry(
            html, width, height, animation_time_ms, animation_instances,
            image_resources
        )
    else:
        _simple_web_layout_draw_ir_once(
            html, width, height, animation_time_ms, animation_instances,
            image_resources
        )
    # Never cache an exhausted render: its composition is a truncated document
    # that would then be republished as a complete one on every later frame.
    if eligible and not computed.render_degraded and not simple_web_layout_last_render_degraded():
        _web_doc_cache_entry = [computed]
        _web_doc_cache_key = key
        _web_doc_cache_html = html
    else:
        _web_doc_cache_entry = []
        _web_doc_cache_key = ""
        _web_doc_cache_html = ""
    _web_doc_cache_last_pipeline_us = _fast_clock.now_micros() - start_us
    computed

fn _simple_web_layout_render_html_engine2d_execution(
    html: text, width: i32, height: i32, backend_name: text,
    animation_time_ms: i64,
    animation_instances: [BrowserCssAnimationInstance],
    image_resources: [SimpleOsHostGpuImageResource],
    retry_degraded: bool
) -> SimpleWebLayoutEngine2DExecutionResult:
    val _phase_on = (env_get("SIMPLE_WEB_PHASE_TRACE") ?? "") == "1"
    val layout_result = _simple_web_layout_draw_ir_cached(
        html, width, height, animation_time_ms,
        animation_instances, image_resources, retry_degraded
    )
    if _phase_on:
        print "[web-phase] phase=document elapsed_ms={web_document_pipeline_ms()} cache_hit={web_document_cache_hit()}"
    val _phase_paint_start_us = _fast_clock.now_micros()
    val _phase_execution = _simple_web_layout_execute_draw_ir_composition(
        layout_result.composition, layout_result.material_witness,
        width, height, backend_name, image_resources)
    if _phase_on:
        print "[web-phase] phase=paint elapsed_ms={(_fast_clock.now_micros() - _phase_paint_start_us) / 1000}"
    _phase_execution

# Every exact whole-surface compare is one interpreted loop iteration per
# pixel — 8,294,400 at 3840x2160. This counter is how a spec proves, on a host
# with no GPU device, that a steady frame avoided the scan rather than merely
# moving it. Reset with the rest of the route policy.
var _web_draw_ir_pixels_equal_calls: i32 = 0

pub fn web_draw_ir_pixels_equal_call_count() -> i32:
    _web_draw_ir_pixels_equal_calls

fn _web_draw_ir_pixels_equal(left: [u32], right: [u32]) -> bool:
    _web_draw_ir_pixels_equal_calls = _web_draw_ir_pixels_equal_calls + 1
    if left.len() != right.len():
        return false
    var index = 0
    while index < left.len():
        if left[index] != right[index]:
            return false
        index = index + 1
    true

# Item 2 of doc/08_tracking/todo/web_gpu_offload_buffer_residency_audit_2026-09-05.md:
# this is one interpreted loop iteration per pixel — 480,000 at 800x600,
# 8,294,400 at 3840x2160 — so every call has to be justified by a reader. The
# counter below is the evidence for that: it is the ONLY way a spec can show,
# on a host with no GPU device, that a scan was avoided rather than merely
# moved. Reset with the rest of the route policy.
var _web_draw_ir_fingerprint_pixels_scanned: i64 = 0

pub fn web_draw_ir_fingerprint_pixels_scanned() -> i64:
    _web_draw_ir_fingerprint_pixels_scanned

# Diagnostic seam retained to demonstrate why the order-independent
# Engine2DReadback.checksum is not a parity proof. The steady cache no longer
# uses this probabilistic value for authorization; it compares pixels exactly.
pub fn web_draw_ir_oracle_fingerprint(pixels: [u32]) -> i64:
    _web_draw_ir_pixel_fingerprint(pixels)

fn _web_draw_ir_pixel_fingerprint(pixels: [u32]) -> i64:
    _web_draw_ir_fingerprint_pixels_scanned = _web_draw_ir_fingerprint_pixels_scanned + pixels.len().to_i64()
    var first: i64 = 2166136261
    var second: i64 = 5381
    var index = 0
    while index < pixels.len():
        val pixel = pixels[index] as i64
        first = (first * 16777619 + pixel) % 2147483647
        second = (second * 1000003 + pixel + index.to_i64()) % 2147483629
        index = index + 1
    first * 2147483629 + second

pub fn web_draw_ir_device_checksum(pixels: [u32]) -> i64:
    """CPU twin of the DEVICE readback checksum fold.

    Mirrors `vulkan_sffi_readback_u32_into` (src/lib/nogc_sync_mut/gpu/engine2d/
    sffi_vulkan.spl:1015) and `rt_vulkan_readback_u32_checksum`
    (src/compiler_rust/runtime/src/vulkan_graphics_runtime_buffer.rs:464),
    both of which are defined as the sequential fold
    `acc = (acc + px) % 2147483647` starting from 0 over unsigned pixels.

    Computed at most ONCE per validation, never per steady frame.
    """
    var checksum: i64 = 0
    var index = 0
    while index < pixels.len():
        checksum = (checksum + (pixels[index] as i64)) % 2147483647
        index = index + 1
    checksum

fn _web_draw_ir_proven(readback: Engine2DReadback, pixel_count: i64, identity: i64) -> bool:
    readback.source == "device_readback" and
        readback.backend_handle > 0 and readback.device_identity > 0 and
        readback.pixel_count == pixel_count and
        (identity <= 0 or readback.device_identity == identity)

fn _web_draw_ir_p50(samples: [i64]) -> i64:
    if samples.len() == 0:
        return 0
    var sorted = samples
    sorted.sort()
    sorted[sorted.len() / 2]

fn _web_draw_ir_p95(samples: [i64]) -> i64:
    if samples.len() == 0:
        return 0
    var sorted = samples
    sorted.sort()
    sorted[sorted.len() - 1]

fn _web_draw_ir_state_index(key: text) -> i32:
    var index = 0
    while index < _web_draw_ir_route_states.len():
        if _web_draw_ir_route_states[index].key == key:
            return index
        index = index + 1
    -1

fn _web_draw_ir_state(
    key: text, backend_name: text, scene_generation: i64
) -> _WebDrawIrRouteState:
    val found = _web_draw_ir_state_index(key)
    if found >= 0:
        return _web_draw_ir_route_states[found]
    if _web_draw_ir_route_states.len() >= WEB_DRAW_IR_ROUTE_CACHE_MAX:
        _web_draw_ir_route_states.remove(0)
    val state = _WebDrawIrRouteState(
        key: key, scene_generation: scene_generation,
        upload_samples: [], gpu_samples: [],
        pixels_match: true, readback_absence: "",
        upload_device_proven: true,
        gpu_device_proven: true, commands_complete: true,
        device_identity: 0, complete: false,
        evidence: web_gpu_paint_timing_evidence(
            backend_name, 0, 0, 0, 0, 0, false, false, false),
        validated_pixels: [], validated_device_token: "",
        validated_checksum: 0
    )
    _web_draw_ir_route_states.push(state)
    state

fn _web_draw_ir_upload_route(
    composition: DrawIrComposition, width: i32, height: i32, backend_name: text
) -> _WebDrawIrTimedRoute:
    val start_us = _fast_clock.now_micros()
    _web_draw_ir_route_canonical_submissions = (
        _web_draw_ir_route_canonical_submissions + 1)
    val oracle = _simple_web_layout_render_draw_ir_composition(
        composition, width, height, "software", [])
    val readback = present_layout_pixels_with_engine2d_readback(
        oracle.pixels, width, height, backend_name, 0u32)
    val end_us = _fast_clock.now_micros()
    val elapsed_us = if start_us > 0 and end_us > start_us:
        end_us - start_us
    else:
        0
    _WebDrawIrTimedRoute(
        readback: readback, oracle_pixels: oracle.pixels, elapsed_us: elapsed_us,
        skipped_command_count: oracle.skipped_command_count)

# The upload route without its device leg: renders the canonical software
# oracle and nothing else. Used only where the device round trip records
# nothing (see the steady non-offload branch of _web_draw_ir_choose_route). It
# is still a canonical route submission and still reports the oracle's skipped
# command count, so both remain observable exactly as before.
fn _web_draw_ir_oracle_route(
    composition: DrawIrComposition, width: i32, height: i32
) -> _WebDrawIrTimedRoute:
    _web_draw_ir_route_canonical_submissions = _web_draw_ir_route_canonical_submissions + 1
    val oracle = _simple_web_layout_render_draw_ir_composition(
        composition, width, height, "software", [])
    _WebDrawIrTimedRoute(
        readback: engine2d_readback([], "not_requested"),
        oracle_pixels: oracle.pixels, elapsed_us: 0,
        skipped_command_count: oracle.skipped_command_count)

pub fn web_draw_ir_readback_absence(readback: Engine2DReadback) -> text:
    """Name why a readback carries no device evidence, or "" when it does.

    This is a CLASSIFIER, never a tolerance: every non-empty result refuses the
    route exactly as a mismatch would. It exists only so the failure is reported
    by its real cause. `device-lost` and `zero-length-readback` are distinct
    because they need different repairs -- the first is a backend that gave up
    (and says so in `source`), the second is a backend that claims success and
    returns nothing.
    """
    # SOURCE is checked before LENGTH, deliberately. A backend that has given up
    # reports `cpu_fallback` / `completion_unknown` / `readback_failed` AND
    # usually returns nothing; labelling that `zero-length-readback` would name
    # the symptom instead of the cause. `zero-length-readback` is reserved for
    # the stranger and more alarming case: a backend still claiming device
    # provenance while handing back an empty buffer.
    if readback.source != "device_readback" and
        readback.source != "host_cache_after_device_copy":
        return "device-lost"
    if readback.pixels.len() == 0:
        return "zero-length-readback"
    ""

fn _web_draw_ir_gpu_route(
    composition: DrawIrComposition, width: i32, height: i32,
    backend_name: text
) -> _WebDrawIrTimedRoute:
    val start_us = _fast_clock.now_micros()
    _web_draw_ir_route_canonical_submissions = (
        _web_draw_ir_route_canonical_submissions + 1)
    val render = _simple_web_layout_render_draw_ir_composition(
        composition, width, height, backend_name, [])
    _web_draw_ir_last_comparison_receipt = (
        "backend=" + render.selected_backend +
        ";source=" + render.readback_source +
        ";composition_id=" + render.unit_id +
        ";rendered=" + render.rendered_command_count.to_text() +
        ";skipped=" + render.skipped_command_count.to_text() +
        ";pixels=" + render.pixels.len().to_text()
    )
    val readback = Engine2DReadback(
        pixels: render.pixels, source: render.readback_source,
        backend_handle: render.backend_handle,
        device_identity: render.device_identity,
        pixel_count: render.pixels.len().to_i64(),
        checksum: render.readback_checksum)
    val end_us = _fast_clock.now_micros()
    val elapsed_us = if start_us > 0 and end_us > start_us:
        end_us - start_us
    else:
        0
    _WebDrawIrTimedRoute(
        readback: readback, oracle_pixels: [], elapsed_us: elapsed_us,
        skipped_command_count: render.skipped_command_count)

fn _web_draw_ir_cached_frame_reusable(
    scene_generation: i64, current_scene_generation: i64,
    validated_device_token: text, current_device_token: text,
    validated_pixel_count: i64, current_pixel_count: i64
) -> bool:
    # Exact producer revision + exact parked surface/device token + exact
    # extent.  A probabilistic checksum or hash is intentionally absent.
    scene_generation > 0 and
        scene_generation == current_scene_generation and
        validated_device_token != "" and
        validated_device_token == current_device_token and
        validated_pixel_count > 0 and
        validated_pixel_count == current_pixel_count

pub fn web_draw_ir_gpu_route_cache_generation_match(
    cached_scene_generation: i64, current_scene_generation: i64,
    cached_device_token: text, current_device_token: text,
    cached_pixel_count: i64, current_pixel_count: i64
) -> bool:
    """Pure contract seam for exact retained-frame invalidation tests."""
    _web_draw_ir_cached_frame_reusable(
        cached_scene_generation, current_scene_generation,
        cached_device_token, current_device_token,
        cached_pixel_count, current_pixel_count)

fn _web_draw_ir_device_authorized(state: _WebDrawIrRouteState) -> bool:
    """The device is PROVEN and CORRECT for this route key.

    This — not the timing margin — is what authorizes the GPU route on a
    steady frame. `evidence.should_offload` additionally requires the GPU to
    have beaten the upload path by a strict margin; a lost margin test used to
    divert every later frame of a proven, pixel-exact device onto the SOFTWARE
    oracle, which is both slower and pointless. The margin verdict is still
    recorded in the published evidence, as evidence only.
    """
    state.pixels_match and state.gpu_device_proven and state.commands_complete

pub fn web_draw_ir_route_device_authorized(
    pixels_match: bool, gpu_device_proven: bool, commands_complete: bool
) -> bool:
    """Pure contract seam for the steady-frame GPU authorization test."""
    pixels_match and gpu_device_proven and commands_complete

fn _web_draw_ir_choose_route(
    composition: DrawIrComposition, width: i32, height: i32,
    backend_name: text
) -> [u32]:
    val key = _web_draw_ir_key(composition, width, height, backend_name)
    var state = _web_draw_ir_state(key, backend_name, composition.generation)
    val exact_pixel_count = width.to_i64() * height.to_i64()
    _web_draw_ir_route_consults = _web_draw_ir_route_consults + 1

    if state.complete:
        if not state.commands_complete:
            _web_draw_ir_last_evidence = _web_draw_ir_copy_evidence(state.evidence)
            return []
        if state.evidence.should_offload or _web_draw_ir_device_authorized(state):
            val current_device_token = _web_fast_engine_cached_device_token(
                width, height, backend_name)
            if _web_draw_ir_cached_frame_reusable(
                state.scene_generation, composition.generation,
                state.validated_device_token, current_device_token,
                state.validated_pixels.len().to_i64(), exact_pixel_count
            ):
                _web_draw_ir_route_cached_reuses = _web_draw_ir_route_cached_reuses + 1
                _web_draw_ir_last_evidence = _web_draw_ir_copy_evidence(state.evidence)
                return state.validated_pixels
            val gpu = _web_draw_ir_gpu_route(
                composition, width, height, backend_name)
            val gpu_proven = _web_draw_ir_proven(
                gpu.readback, exact_pixel_count, state.device_identity)
            # Two distinct steady cases, and neither renders a software oracle.
            #
            # SAME scene revision: this is a re-validation of a frame we
            # already hold. Compare the DEVICE-side readback checksum against
            # the one retained at validation — one i64, not 8.3M interpreted
            # pixel compares. The exact whole-surface compare remains the
            # fallback for a readback that carries no compatible checksum
            # (checksum 0), so correctness never depends on the checksum
            # merely being present.
            #
            # NEW scene revision: no oracle for this content exists and none
            # should be rendered. A device already proven pixel-exact for this
            # key, still returning a proven readback with zero skipped
            # commands, IS the authority; re-anchor the retained frame to it.
            val same_scene = (
                state.scene_generation > 0 and
                state.scene_generation == composition.generation)
            # Same rule as the sampling path: an absent readback is classified,
            # never compared. Without this a steady frame whose device gave up
            # reports `pixel-mismatch` against a retained frame it never had the
            # pixels to disagree with.
            val steady_absence = web_draw_ir_readback_absence(gpu.readback)
            var gpu_match = true
            if same_scene and steady_absence == "":
                if state.validated_checksum > 0 and gpu.readback.checksum > 0:
                    gpu_match = gpu.readback.checksum == state.validated_checksum
                else:
                    gpu_match = _web_draw_ir_pixels_equal(
                        gpu.readback.pixels, state.validated_pixels)
            if gpu.skipped_command_count == 0 and gpu_proven and gpu_match:
                state.validated_device_token =
                    _web_fast_engine_validated_device_token(
                        gpu.readback, width, height, backend_name)
                if not same_scene and composition.generation > 0:
                    state.scene_generation = composition.generation
                    state.validated_pixels = gpu.readback.pixels
                    state.validated_checksum = gpu.readback.checksum
                val validated_index = _web_draw_ir_state_index(key)
                if validated_index >= 0:
                    _web_draw_ir_route_states[validated_index] = state
                _web_draw_ir_last_evidence = _web_draw_ir_copy_evidence(state.evidence)
                return gpu.readback.pixels
            val failed_evidence = web_gpu_paint_timing_evidence(
                backend_name,
                state.evidence.upload_bound_p50_us,
                state.evidence.upload_bound_p95_us,
                state.evidence.gpu_paint_p50_us,
                state.evidence.gpu_paint_p95_us,
                state.evidence.sample_count,
                state.pixels_match and gpu_match,
                state.upload_device_proven,
                state.gpu_device_proven and gpu_proven,
                gpu.skipped_command_count == 0,
                if state.readback_absence != "": state.readback_absence
                else: steady_absence)
            val invalidated = _web_draw_ir_state_index(key)
            if invalidated >= 0:
                _web_draw_ir_route_states.remove(invalidated)
            _web_draw_ir_last_evidence = _web_draw_ir_copy_evidence(failed_evidence)
            if gpu.skipped_command_count != 0:
                return []
            val fallback = _web_draw_ir_upload_route(
                composition, width, height, backend_name)
            if fallback.skipped_command_count != 0:
                return []
            return fallback.oracle_pixels

        # Item 7 of doc/08_tracking/todo/web_gpu_offload_buffer_residency_audit_2026-09-05.md.
        # This branch used to upload the oracle to the device, read the whole
        # surface back and compare it pixel-for-pixel. That round trip recorded
        # NOTHING: both outcomes published the cached `state.evidence`
        # unchanged, `state.pixels_match` was never updated, no comparison
        # receipt was written, and the pixels returned equalled the oracle on
        # either side of the comparison. It was pure waste, not an A/B whose
        # result anyone could read. The evidence that DECIDES this route is
        # gathered by the first-N sampling frames below (`state.complete ==
        # false`), which still run the full upload + gpu A/B and still latch
        # `pixels_match` / `*_device_proven`; only an already-decided steady
        # frame skips the device.
        #
        # Reached only when the device is NOT authorized for this key
        # (`_web_draw_ir_device_authorized` false: a pixel mismatch, an
        # unproven readback, or skipped commands). A merely LOST TIMING MARGIN
        # no longer lands here — that diverted a proven, pixel-exact device
        # onto the software raster for every steady frame. The margin verdict
        # is published in `state.evidence.should_offload` as evidence only.
        val oracle = _web_draw_ir_oracle_route(composition, width, height)
        if oracle.skipped_command_count != 0:
            return []
        _web_draw_ir_last_evidence = _web_draw_ir_copy_evidence(state.evidence)
        return oracle.oracle_pixels

    val sample = state.upload_samples.len()
    var upload = _WebDrawIrTimedRoute(
        readback: engine2d_readback([], "not_requested"),
        oracle_pixels: [], elapsed_us: 0, skipped_command_count: 0)
    var gpu = _WebDrawIrTimedRoute(
        readback: engine2d_readback([], "not_requested"),
        oracle_pixels: [], elapsed_us: 0, skipped_command_count: 0)
    if sample % 2 == 0:
        upload = _web_draw_ir_upload_route(composition, width, height, backend_name)
        gpu = _web_draw_ir_gpu_route(
            composition, width, height, backend_name)
    else:
        gpu = _web_draw_ir_gpu_route(
            composition, width, height, backend_name)
        upload = _web_draw_ir_upload_route(composition, width, height, backend_name)

    state.upload_samples.push(upload.elapsed_us)
    state.gpu_samples.push(gpu.elapsed_us)
    # Classify BEFORE comparing. A readback that carries no device pixels cannot
    # be compared with anything, and feeding it to `_web_draw_ir_pixels_equal`
    # -- which rejects on length before examining a pixel -- latched
    # `pixels_match` false and mislabelled the whole failure `pixel-mismatch`.
    # The route is still refused (the absence is recorded and kills
    # `available`), it is just named correctly now.
    val gpu_absence = web_draw_ir_readback_absence(gpu.readback)
    val upload_absence = web_draw_ir_readback_absence(upload.readback)
    state.readback_absence = if state.readback_absence != "":
        state.readback_absence
    elif gpu_absence != "":
        gpu_absence
    else:
        upload_absence
    if state.readback_absence == "":
        state.pixels_match = (
            state.pixels_match and
            _web_draw_ir_pixels_equal(upload.readback.pixels, upload.oracle_pixels) and
            _web_draw_ir_pixels_equal(gpu.readback.pixels, upload.oracle_pixels)
        )
    state.commands_complete = (
        state.commands_complete and upload.skipped_command_count == 0 and
        gpu.skipped_command_count == 0)
    state.upload_device_proven = (
        state.upload_device_proven and
        _web_draw_ir_proven(upload.readback, exact_pixel_count, state.device_identity))
    state.gpu_device_proven = (
        state.gpu_device_proven and
        _web_draw_ir_proven(gpu.readback, exact_pixel_count, state.device_identity))
    if (
        upload.readback.device_identity <= 0 or
        upload.readback.device_identity != gpu.readback.device_identity
    ):
        state.upload_device_proven = false
        state.gpu_device_proven = false
    elif state.device_identity == 0:
        state.device_identity = upload.readback.device_identity

    val evidence = web_gpu_paint_timing_evidence(
        backend_name,
        _web_draw_ir_p50(state.upload_samples),
        _web_draw_ir_p95(state.upload_samples),
        _web_draw_ir_p50(state.gpu_samples),
        _web_draw_ir_p95(state.gpu_samples),
        state.upload_samples.len(), state.pixels_match,
        state.upload_device_proven, state.gpu_device_proven,
        state.commands_complete, state.readback_absence)
    state.evidence = evidence
    state.complete = evidence.sample_count >= 3
    # The third sample has already compared both device paths with this oracle
    # pixel-for-pixel. Retain that exact canonical value and bind it to the
    # parked engine owner while all proof fields are still available. This
    # makes the first steady frame eligible for reuse and removes the former
    # probabilistic fingerprint authorization entirely.
    if state.complete and (
        evidence.should_offload or _web_draw_ir_device_authorized(state)
    ):
        state.validated_pixels = upload.oracle_pixels
        state.validated_device_token = _web_fast_engine_validated_device_token(
            gpu.readback, width, height, backend_name)
        # Retain the checksum ONCE, here, while both sides are still known
        # pixel-exact. Prefer the device's own value (free — the readback
        # already computed it); the CPU oracle route's readback carries none,
        # so fall back to the CPU twin of the identical fold. Never per frame.
        if gpu.readback.checksum > 0:
            state.validated_checksum = gpu.readback.checksum
        else:
            state.validated_checksum = web_draw_ir_device_checksum(
                upload.oracle_pixels)
    val state_index = _web_draw_ir_state_index(key)
    if state_index >= 0:
        _web_draw_ir_route_states[state_index] = state
    _web_draw_ir_last_evidence = _web_draw_ir_copy_evidence(evidence)
    if upload.skipped_command_count != 0 or gpu.skipped_command_count != 0:
        return []
    if not evidence.available:
        return upload.oracle_pixels
    if evidence.should_offload:
        return gpu.readback.pixels
    upload.readback.pixels

pub fn web_draw_ir_gpu_route_sample(
    composition: DrawIrComposition, width: i32, height: i32,
    backend_name: text
) -> [u32]:
    _web_draw_ir_choose_route(
        composition, width, height, backend_name.trim().lower())

# Render `html` to a flat ARGB [u32] framebuffer through the layout Draw IR on an
# Engine2D in native-only fast mode. On Metal this is GPU-rendered with a
# one-shot readback; on other backends Engine2D.create_with_backend_fast() falls
# back to the normal (correct but interpreter-bound) path.
#
# The framebuffer is cleared to transparent black (0) first, matching the
# zero-initialized software surface the Draw IR executor otherwise paints onto,
# and — for Metal — arming gpu_frame_complete so read_pixels() takes the GPU
# download path rather than the shrunken mirror.
pub fn simple_web_layout_render_html_engine2d_result(html: text, width: i32, height: i32, backend_name: text) -> Engine2dDrawIrAdvResult:
    _simple_web_layout_render_html_engine2d_execution(
        html, width, height, backend_name, -1, [], [], false
    ).render

pub fn simple_web_layout_render_html_engine2d_result_with_images(
    html: text, width: i32, height: i32, backend_name: text,
    images: [SimpleOsHostGpuImageResource]
) -> Engine2dDrawIrAdvResult:
    _simple_web_layout_render_html_engine2d_execution(
        html, width, height, backend_name, -1, [], images, false
    ).render

pub fn simple_web_layout_render_html_pixels_engine2d(html: text, width: i32, height: i32, backend_name: text) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    # Route through the degraded-retry wrapper (see
    # _simple_web_layout_draw_ir_with_degraded_retry above), not the raw
    # single-pass entry: this is the plain-pixels path that
    # render_html_to_pixels_with_viewport (browser_renderer.spl) resolves to
    # for any HTML containing <p>/<h1>/<button>/etc, and until this fix it was
    # the ONE call in this file's public pixel surface that never got the
    # retry -- every retry_degraded=false sibling below it and the readback
    # entry (which alone passed retry_degraded=true) bracket it, but this
    # function bypassed the flag entirely by calling the single-pass helper
    # directly. A wall-clock budget trip under host load then silently
    # returned truncated/blank pixels with no second chance, which is exactly
    # the "seems able but can't" class-selector-drop failure the retry wrapper
    # exists to catch -- see
    # doc/08_tracking/bug/web_render_pixels_entry_bypasses_degraded_retry_2026-08-05.md.
    # Through the document cache (which itself applies the degraded-retry
    # wrapper), not the wrapper directly: this entry is the one the plain
    # browser_renderer pixel path resolves to, so leaving it outside the cache
    # would leave the steady frame recomposing the document every frame.
    val layout_result = _simple_web_layout_draw_ir_cached(
        html, width, height, -1, [], [], true)
    if (
        web_gpu_paint_enabled() and
        web_gpu_paint_backend_verdict(backend_name) == "gpu-paint-candidate"
    ):
        return _web_draw_ir_choose_route(
            layout_result.composition, width, height, backend_name)
    val execution = _simple_web_layout_execute_draw_ir_composition(
        layout_result.composition, layout_result.material_witness,
        width, height, backend_name, [])
    if execution.render.skipped_command_count != 0:
        return []
    execution.render.pixels

pub fn simple_web_layout_render_html_pixels_engine2d_with_images(
    html: text, width: i32, height: i32, backend_name: text,
    images: [SimpleOsHostGpuImageResource]
) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    # Same degraded-retry gap as simple_web_layout_render_html_pixels_engine2d
    # above (render_html_to_pixels_with_viewport_with_images resolves here);
    # retry_degraded=true so a budget-tripped first pass gets the same
    # bounded second chance instead of silently publishing truncated pixels.
    val execution = _simple_web_layout_render_html_engine2d_execution(
        html, width, height, backend_name, -1, [], images, true
    )
    if execution.render.skipped_command_count != 0:
        return []
    execution.render.pixels

pub fn simple_web_layout_render_html_pixels_engine2d_at_time(html: text, width: i32, height: i32, backend_name: text, animation_time_ms: i64) -> [u32]:
    if width <= 0 or height <= 0:
        return []
    val execution = _simple_web_layout_render_html_engine2d_execution(
        html, width, height, backend_name, animation_time_ms, [], [], false
    )
    if execution.render.skipped_command_count != 0:
        return []
    execution.render.pixels

