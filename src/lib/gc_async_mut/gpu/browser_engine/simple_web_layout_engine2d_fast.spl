fn _simple_web_layout_render_html_readback_engine2d_result_at_time(html: text, width: i32, height: i32, backend_name: text, animation_time_ms: i64) -> SimpleWebLayoutEngine2DReadbackResult:
    if width <= 0 or height <= 0:
        return SimpleWebLayoutEngine2DReadbackResult(
            readback: engine2d_readback([], "unavailable"),
            material_fallback: WebRenderMaterialFallbackProvenance.none(),
            render_degraded: false,
            vector_font_identity: "", vector_font_pixel_size: 0,
            vector_font_execution_target: "", vector_font_batch_identity: "",
            vector_font_readback_source: "", vector_font_device_checksum: 0,
            vector_font_oracle_checksum: 0,
            vector_font_readback_nonblank_pixels: 0,
            vector_font_device_executed: false,
            vector_font_promotion_ready: false
        )
    val execution = _simple_web_layout_render_html_engine2d_execution(
        html, width, height, backend_name, animation_time_ms, [], [], true
    )
    if execution.render.skipped_command_count != 0:
        return SimpleWebLayoutEngine2DReadbackResult(
            readback: engine2d_readback([], "unavailable"),
            material_fallback: execution.material_fallback,
            render_degraded: execution.render_degraded,
            vector_font_identity: execution.vector_font_identity,
            vector_font_pixel_size: execution.vector_font_pixel_size,
            vector_font_execution_target: execution.vector_font_execution_target,
            vector_font_batch_identity: execution.vector_font_batch_identity,
            vector_font_readback_source: execution.vector_font_readback_source,
            vector_font_device_checksum: execution.vector_font_device_checksum,
            vector_font_oracle_checksum: execution.vector_font_oracle_checksum,
            vector_font_readback_nonblank_pixels:
                execution.vector_font_readback_nonblank_pixels,
            vector_font_device_executed: execution.vector_font_device_executed,
            vector_font_promotion_ready: execution.vector_font_promotion_ready
        )
    val pixel_count = execution.render.pixels.len().to_i64()
    val readback = Engine2DReadback(pixels: execution.render.pixels, source: execution.render.readback_source,
        backend_handle: execution.render.backend_handle, device_identity: execution.render.device_identity,
        pixel_count: pixel_count, checksum: execution.render.readback_checksum)
    SimpleWebLayoutEngine2DReadbackResult(
        readback: readback, material_fallback: execution.material_fallback,
        render_degraded: execution.render_degraded,
        vector_font_identity: execution.vector_font_identity,
        vector_font_pixel_size: execution.vector_font_pixel_size,
        vector_font_execution_target: execution.vector_font_execution_target,
        vector_font_batch_identity: execution.vector_font_batch_identity,
        vector_font_readback_source: execution.vector_font_readback_source,
        vector_font_device_checksum: execution.vector_font_device_checksum,
        vector_font_oracle_checksum: execution.vector_font_oracle_checksum,
        vector_font_readback_nonblank_pixels:
            execution.vector_font_readback_nonblank_pixels,
        vector_font_device_executed: execution.vector_font_device_executed,
        vector_font_promotion_ready: execution.vector_font_promotion_ready)

pub fn simple_web_layout_render_html_readback_engine2d_result(html: text, width: i32, height: i32, backend_name: text) -> SimpleWebLayoutEngine2DReadbackResult:
    _simple_web_layout_render_html_readback_engine2d_result_at_time(
        html, width, height, backend_name, -1
    )

pub fn simple_web_layout_render_html_readback_engine2d_result_at_time(html: text, width: i32, height: i32, backend_name: text, animation_time_ms: i64) -> SimpleWebLayoutEngine2DReadbackResult:
    _simple_web_layout_render_html_readback_engine2d_result_at_time(
        html, width, height, backend_name, animation_time_ms
    )

pub fn simple_web_layout_render_html_readback_engine2d(html: text, width: i32, height: i32, backend_name: text) -> Engine2DReadback:
    simple_web_layout_render_html_readback_engine2d_result(html, width, height, backend_name).readback

# True when the Metal native fast path is genuinely available, so callers (e.g.
# the WM compositor at desktop resolution) can gate on it before routing a large
# scene through the fast entry instead of silently falling back to the
# interpreter-bound software mirror.
pub fn engine2d_fast_metal_available() -> bool:
    val probe = Engine2D.probe_backend(1, 1, "metal")
    probe.status == BackendStatus.Initialized

