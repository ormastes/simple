# Render budget + CSS quotas (hostile-page hardening)
# ---------------------------------------------------------------------------
# A hostile or pathological page (a huge <style>, thousands of rules matching a
# single node, a giant DOM) can drive the O(rules) cascade or the O(nodes) paint
# loops for minutes. These guards degrade GRACEFULLY: on wall-clock budget expiry
# the current phase stops at a loop boundary and whatever has been resolved or
# painted so far is returned (never a panic, never an empty buffer — the
# framebuffer is always allocated at width*height before paint). CSS quotas
# silently drop over-limit rules/declarations so the first, load-bearing rules
# still win.
#
# _web_budget_clock is module-level (not per-call injected) because the
# budget deadline itself (_web_render_deadline_us below) is module-level
# state shared across every call site in this file and its sibling
# renderer_core.spl/paint_layout.spl; threading a clock parameter through
# that whole call graph would be a much larger change for the same effect.
# Real callers get the identical default host clock as before this tranche.
var _web_budget_clock: FrameClock = default_frame_clock()

# Test seam: swap the wall clock the budget guards read. WEB_RENDER_STAGE_MIN_SLICE_MS
# floors every stage at a real 2 s, so a tiny budget_ms can no longer starve a
# render on the host clock; a spec drives exhaustion with a stepping clock instead.
pub fn simple_web_layout_set_budget_clock(clock: FrameClock):
    _web_budget_clock = clock

pub fn simple_web_layout_reset_budget_clock():
    _web_budget_clock = default_frame_clock()

struct SimpleWebBackdropAdmission:
    admitted: bool
    realized_blur_px: i64
    realized_saturation_milli: i64

fn _simple_web_backdrop_rejected() -> SimpleWebBackdropAdmission:
    SimpleWebBackdropAdmission(
        admitted: false, realized_blur_px: 0, realized_saturation_milli: 0)

struct SimpleWebBackdropDecimal:
    admitted: bool
    value: i64
    next: i32

fn _simple_web_backdrop_bytes_match(
    input: [u8], offset: i32, literal: text
) -> bool:
    val expected = literal.bytes()
    if offset < 0 or offset + expected.len() > input.len():
        return false
    var i = 0
    while i < expected.len():
        if input[offset + i] != expected[i]:
            return false
        i = i + 1
    true

# Parse one non-empty ASCII decimal at `start` without text predicates,
# slicing, splitting, or numeric-conversion runtime calls. The caller supplies
# the semantic ceiling, which also makes multiply/add overflow-proof: once
# `value > (maximum - digit) / 10`, the token is rejected before arithmetic.
fn _simple_web_backdrop_decimal_at(
    input: [u8], start: i32, maximum: i64
) -> SimpleWebBackdropDecimal:
    if start < 0 or start >= input.len():
        return SimpleWebBackdropDecimal(admitted: false, value: 0, next: start)
    var value: i64 = 0
    var i = start
    while i < input.len():
        val byte = input[i] as i64
        if byte < 48 or byte > 57:
            break
        val digit = byte - 48
        if value > (maximum - digit) / 10:
            return SimpleWebBackdropDecimal(
                admitted: false, value: 0, next: i)
        value = value * 10 + digit
        i = i + 1
    # Preserve one canonical decimal spelling. This keeps receipts stable and
    # rejects aliases such as `030` that the former reconstruction check also
    # refused.
    if i - start > 1 and input[start] == 48:
        return SimpleWebBackdropDecimal(admitted: false, value: 0, next: i)
    SimpleWebBackdropDecimal(
        admitted: i > start, value: value, next: i)

# `blur(Npx)` alone is legitimate CSS (`saturate(...)` is not required
# alongside `backdrop-filter: blur(...)`) — this admits that single-term
# form, defaulting realized saturation to 100% (no-op), in addition to the
# already-admitted two-term `blur(Npx) saturate(M%)` form. See
# doc/08_tracking/bug/2026-08-05_wm_content_frame_web_provenance_unreachable_via_widget_panel.md
# — before this, every one-term `blur(...)`-only declaration in
# glass_css_components.spl (17 of 21 `backdrop-filter:` declarations,
# including `.widget-panel`, the WM content wrapper's own class) was
# unconditionally rejected, making the canonical WM content-frame wrapper
# unreachable end to end regardless of caller content.
# The `blur(<px>)` term of a backdrop-filter value as milli CSS px; 0 when
# absent, empty, negative or not in px. Other filter functions are ignored.
fn backdrop_blur_milli(raw: text) -> i32:
    val at = web_find_from(raw, "blur(", 0)
    if at < 0:
        return 0
    val close = web_find_from(raw, ")", at + 5)
    if close < 0:
        return 0
    val arg = raw.slice(at + 5, close).trim()
    if not arg.ends_with("px"):
        return 0
    if val v = arg.slice(0, arg.byte_len() - 2).trim().parse_f64():
        if v > 0.0 and v < 100000.0:
            return (v * 1000.0 + 0.5) as i32
    0

fn simple_web_backdrop_admission(backdrop: text) -> SimpleWebBackdropAdmission:
    # Keep the receipt parser entirely byte-indexed. The x86_64 freestanding
    # WM has already shown boolean text predicates returning the wrong value at
    # this call depth; admission must not depend on that ABI edge.
    val input = backdrop.bytes()
    if not _simple_web_backdrop_bytes_match(input, 0, "blur("):
        return _simple_web_backdrop_rejected()
    val blur_decimal = _simple_web_backdrop_decimal_at(input, 5, 1000000)
    if not blur_decimal.admitted:
        return _simple_web_backdrop_rejected()
    val after_blur = blur_decimal.next
    if not _simple_web_backdrop_bytes_match(input, after_blur, "px)"):
        return _simple_web_backdrop_rejected()
    val next_term = after_blur + 3
    if next_term == input.len():
        return SimpleWebBackdropAdmission(
            admitted: true,
            realized_blur_px: if blur_decimal.value > 4: 4 else: blur_decimal.value,
            realized_saturation_milli: 1000)
    if not _simple_web_backdrop_bytes_match(input, next_term, " saturate("):
        return _simple_web_backdrop_rejected()
    val saturation_start = next_term + 10
    val saturation_decimal = _simple_web_backdrop_decimal_at(
        input, saturation_start, 300)
    if not saturation_decimal.admitted:
        return _simple_web_backdrop_rejected()
    if (not _simple_web_backdrop_bytes_match(
            input, saturation_decimal.next, "%)") or
        saturation_decimal.next + 2 != input.len()):
        return _simple_web_backdrop_rejected()
    SimpleWebBackdropAdmission(
        admitted: true,
        realized_blur_px: if blur_decimal.value > 4: 4 else: blur_decimal.value,
        realized_saturation_milli: saturation_decimal.value * 10)

# Default wall-clock budget for one software render, in milliseconds. Sized
# for AOT/JIT-compiled execution. Under `bin/simple run` (tree-walking
# interpreter), parse_html/compute_styles/layout for even a small document
# (see doc header) routinely exceed this, so `_web_budget_expired()` (below)
# trips mid-paint and only the canvas-background command survives — a
# uniform-fill frame that still reports nonzero/varied-looking pixel stats
# at the framebuffer level but has no real content. This is NOT scaled up
# here by default (that would silently hide the interpreter-perf gap for
# every caller, including compiled ones close to the edge of their own
# budget). Interpreted-mode callers that need real content — showcase
# evidence capture, manual debugging via `bin/simple run` — must opt in via
# SIMPLE_WEB_RENDER_BUDGET_MS (see _web_render_budget_ms_env_override below).
# The interpreter-vs-budget gap itself is a perf defect, tracked separately
# from this render-budget mechanism; do not paper over it by raising this
# default.
val WEB_RENDER_BUDGET_MS: i64 = 10000
val SIMPLE_WEB_MAX_HTML_NODES: i32 = 65536
val SIMPLE_WEB_MAX_HTML_BYTES: i64 = BROWSER_RENDERER_MAX_PAYLOAD_BYTES
val SIMPLE_WEB_MAX_HTML_PARTS: i32 = 262144

fn _simple_web_html_source_admitted(html: text, byte_limit: i64) -> bool:
    if html.byte_len() > byte_limit:
        return false
    # BYTE-indexed, same rationale as text_matches_at/skip_wrap_spaces below.
    # This loop is bounded by `len()` (BYTES) and previously probed with
    # `char_code_at` (CHARACTERS), so on any non-ASCII document it ran past the
    # codepoint count; the tail iterations returned 0 for characters that do not
    # exist (proved: `"café,".len()` is 6 but the string has 5 characters, and
    # `char_code_at(5)` yields a phantom 0). Worse, `char_code_at` re-walks the
    # UTF-8 from byte 0 on every call, and the out-of-range calls walk the WHOLE
    # buffer before returning 0 — so this admission guard, which runs on
    # attacker-controlled input capped at BROWSER_RENDERER_MAX_PAYLOAD_BYTES
    # (1 MiB), was itself the DoS amplifier it exists to prevent.
    #
    # `byte_at` is O(1) and its index space matches `len()`. Switching is
    # answer-preserving HERE specifically because the compared literal is `<`
    # (60), which is < 128: no UTF-8 lead byte (0xC2-0xF4) or continuation byte
    # (0x80-0xBF) is ever < 0x80, so byte 60 can only ever occur as a genuine
    # ASCII `<` and never inside a multi-byte sequence. Do NOT generalise this
    # to call sites that compare against a codepoint >= 128 or that feed the
    # index to a character-indexed API.
    var part_count = 1
    var i = 0
    val n = html.byte_len()
    while i < n:
        if html.byte_at(i) == 60:
            part_count = part_count + 1
            if part_count > SIMPLE_WEB_MAX_HTML_PARTS:
                return false
        i = i + 1
    true

# Optional override for WEB_RENDER_BUDGET_MS, read from the environment at the
# start of every render so long/headless probes can raise the budget without
# threading an explicit i64 arg through the public entry points (an explicit
# i64 default-arg on those entry points has a known seed-interpreter bug that
# whites out painted backgrounds — see
# doc/08_tracking/bug/seed_interp_explicit_i64_default_arg_poisons_render_backgrounds_2026-07-11.md).
# Unset or non-numeric -> falls back to WEB_RENDER_BUDGET_MS / the caller's
# explicit budget_ms as before.
fn _web_render_budget_ms_env_override() -> i64:
    val raw = env_get("SIMPLE_WEB_RENDER_BUDGET_MS") ?? ""
    if raw == "":
        return 0
    val n = raw.trim().to_i64()
    if n == nil or n <= 0:
        return 0
    n

# Level-gated, default-off phase-boundary tracing (doc/08_tracking/bug/
# web_style_producer_4s_per_node_interpreted_lane_2026-07-29.md, "Module-
# compile-cost root cause" follow-up: settling whether style resolution or a
# later phase -- layout, shaping, paint -- is where wall-clock actually goes
# on a long run). Off by default (SIMPLE_WEB_PHASE_TRACE unset); set to "1"
# to emit `[web-phase] phase=<name> elapsed_ms=<n>` lines at each boundary
# and periodic per-node style-loop progress. Per the log-retention policy
# (doc/07_guide/infra/logging/log_retention_policy.md) this is landed as a
# permanent, level-gated instrument rather than a temporary probe to be
# reverted -- keep it in the tree.
fn _web_phase_trace_enabled() -> bool:
    (env_get("SIMPLE_WEB_PHASE_TRACE") ?? "") == "1"

# Level-gated, default-off `[web-style-producer]` diagnostic receipts (CSS
# custom-property stages, WM material-contract admission). They used to print
# unconditionally and flooded every real-site render's stdout. Set
# SIMPLE_WEB_STYLE_TRACE=1 to re-arm them. `budget-break` stays ungated: it is
# a once-per-render truth signal that the rendered output is degraded.
fn _web_style_trace_enabled() -> bool:
    (env_get("SIMPLE_WEB_STYLE_TRACE") ?? "") == "1"

# ---------------------------------------------------------------------------
# Level-gated style-stage cost counters (SIMPLE_WEB_STYLE_COUNTERS=1).
#
# The phase boundaries say the style stage is 86% of the cold document pipeline
# but not WHICH leaf owns it, and two plausible-looking fixes (a cascade memo, a
# presence-set short-circuit) each moved the total by ~10%, which is exactly the
# signature of attributing cost to the wrong leaf. These count calls and
# microseconds per leaf so the next change is chosen from a measurement.
# Permanent and default-off per the log-retention policy.
# ---------------------------------------------------------------------------
fn _web_style_counters_enabled() -> bool:
    (env_get("SIMPLE_WEB_STYLE_COUNTERS") ?? "") == "1"

var _wsc_on: bool = false
var _wsc_probe_calls: i64 = 0
var _wsc_probe_us: i64 = 0
var _wsc_dispatch_calls: i64 = 0
var _wsc_dispatch_us: i64 = 0
var _wsc_table_calls: i64 = 0
var _wsc_table_us: i64 = 0
var _wsc_table_entries: i64 = 0
var _wsc_selector_calls: i64 = 0
var _wsc_selector_us: i64 = 0
var _wsc_candidates: i64 = 0

pub fn web_style_counters_arm():
    _wsc_on = _web_style_counters_enabled()
    _wsc_probe_calls = 0
    _wsc_probe_us = 0
    _wsc_dispatch_calls = 0
    _wsc_dispatch_us = 0
    _wsc_table_calls = 0
    _wsc_table_us = 0
    _wsc_table_entries = 0
    _wsc_selector_calls = 0
    _wsc_selector_us = 0
    _wsc_candidates = 0
    _wsc_sec_a = 0
    _wsc_sec_b = 0
    _wsc_sec_c = 0
    _wsc_sec_d = 0
    _wsc_sec_e = 0
    _wsc_sec_f = 0
    _wsc_sec_g = 0
    _wsc_sec_h = 0
    _wsc_sec_i = 0
    _wsc_sub_0 = 0
    _wsc_sub_1 = 0
    _wsc_sub_2 = 0
    _wsc_sub_3 = 0
    _wsc_sub_4 = 0
    _wsc_sub_5 = 0
    _wsc_sub_6 = 0
    _wsc_sub_7 = 0
    _wsc_sub_8 = 0
    _wsc_sub_9 = 0
    _wsc_sub_10 = 0
    _wsc_sub_11 = 0
    _wsc_sub_12 = 0
    _wsc_sub_13 = 0


fn _wsc_armed() -> bool:
    _wsc_on

fn _wsc_now_us() -> i64:
    _web_budget_clock.now_micros()

fn _wsc_add_probe(us: i64):
    _wsc_probe_calls = _wsc_probe_calls + 1
    _wsc_probe_us = _wsc_probe_us + us

fn _wsc_add_dispatch(us: i64):
    _wsc_dispatch_calls = _wsc_dispatch_calls + 1
    _wsc_dispatch_us = _wsc_dispatch_us + us

fn _wsc_add_table(us: i64, entries: i64):
    _wsc_table_calls = _wsc_table_calls + 1
    _wsc_table_us = _wsc_table_us + us
    _wsc_table_entries = _wsc_table_entries + entries

fn _wsc_add_selector(us: i64):
    _wsc_selector_calls = _wsc_selector_calls + 1
    _wsc_selector_us = _wsc_selector_us + us

fn _wsc_add_candidates(n: i64):
    _wsc_candidates = _wsc_candidates + n

var _wsc_sec_a: i64 = 0
var _wsc_sec_b: i64 = 0
var _wsc_sec_c: i64 = 0
var _wsc_sec_d: i64 = 0
var _wsc_sec_e: i64 = 0
var _wsc_sec_f: i64 = 0
var _wsc_sec_g: i64 = 0
var _wsc_sec_h: i64 = 0
var _wsc_sec_i: i64 = 0

# Sub-bucket timers inside `sec_select` and `sec_cascade`. Round 5 left both as
# single opaque numbers (2331 ms and 2874 ms across the eight-page catalog) and
# recorded that splitting them was the first thing round 6 should do. Slots:
#   0 sel_match  - selector_group_matches_node_parts over a node's candidates
#   1 sel_sort   - _sort_candidates_by_specificity
#   2 cas_accum  - candidate decl accumulation loop (incl. the empty-cells probe)
#   3 cas_merge  - _merged_decls_within_quota on the normal + important strings
#   4 cas_pre    - inline priority split, writing-mode resolve, final display
#   5 cas_key    - cascade memo key build + lookup
#   6 cas_apply  - apply_decls on a memo MISS
#   7 cas_tail   - inline/important applies + final overflow normalisation
# Permanent and default-off, same idiom as the section timers above.
var _wsc_sub_0: i64 = 0
var _wsc_sub_1: i64 = 0
var _wsc_sub_2: i64 = 0
var _wsc_sub_3: i64 = 0
var _wsc_sub_4: i64 = 0
var _wsc_sub_5: i64 = 0
var _wsc_sub_6: i64 = 0
var _wsc_sub_7: i64 = 0
# Nested inside slot 7 (`cas_tail`), added in round 10. Slot 7 keeps measuring
# the same whole span, so its number stays comparable with rounds 5-9; these
# six split it into its leaves:
#   8  tail_inline   - inline_normal empty-cells probe + apply
#   9  tail_imp      - combined_important empty-cells probe + apply
#   10 tail_inlineimp- inline_important empty-cells probe + apply
#   11 tail_display  - final_display write / `display:contents` apply
#   12 tail_overflow - _normalize_final_overflow_axes
#   13 tail_struct   - details-hidden + selectedcontent applies
var _wsc_sub_8: i64 = 0
var _wsc_sub_9: i64 = 0
var _wsc_sub_10: i64 = 0
var _wsc_sub_11: i64 = 0
var _wsc_sub_12: i64 = 0
var _wsc_sub_13: i64 = 0

# The six nested timers cost six extra clock reads per node, which is enough to
# inflate slot 7 itself (measured 535 ms -> ~1.2 s across the catalog). They are
# therefore armed by their OWN env var, so a `SIMPLE_WEB_STYLE_COUNTERS=1` run
# still reports a `cas_tail_ms` comparable with rounds 5-9.
var _wsc_tail_sub_on: i32 = -1

fn _wsc_tail_sub_armed() -> bool:
    if _wsc_tail_sub_on < 0:
        _wsc_tail_sub_on = if (env_get("SIMPLE_WEB_TAIL_SUBTIMERS") ?? "") == "1": 1 else: 0
    _wsc_tail_sub_on == 1

fn _wsc_add_sub2(which: i32, us: i64):
    if which == 8:
        _wsc_sub_8 = _wsc_sub_8 + us
    elif which == 9:
        _wsc_sub_9 = _wsc_sub_9 + us
    elif which == 10:
        _wsc_sub_10 = _wsc_sub_10 + us
    elif which == 11:
        _wsc_sub_11 = _wsc_sub_11 + us
    elif which == 12:
        _wsc_sub_12 = _wsc_sub_12 + us
    else:
        _wsc_sub_13 = _wsc_sub_13 + us

fn _wsc_add_sub(which: i32, us: i64):
    if which == 0:
        _wsc_sub_0 = _wsc_sub_0 + us
    elif which == 1:
        _wsc_sub_1 = _wsc_sub_1 + us
    elif which == 2:
        _wsc_sub_2 = _wsc_sub_2 + us
    elif which == 3:
        _wsc_sub_3 = _wsc_sub_3 + us
    elif which == 4:
        _wsc_sub_4 = _wsc_sub_4 + us
    elif which == 5:
        _wsc_sub_5 = _wsc_sub_5 + us
    elif which == 6:
        _wsc_sub_6 = _wsc_sub_6 + us
    else:
        _wsc_sub_7 = _wsc_sub_7 + us

fn _wsc_add_section(which: i32, us: i64):
    if which == 0:
        _wsc_sec_a = _wsc_sec_a + us
    elif which == 1:
        _wsc_sec_b = _wsc_sec_b + us
    elif which == 2:
        _wsc_sec_c = _wsc_sec_c + us
    elif which == 3:
        _wsc_sec_d = _wsc_sec_d + us
    elif which == 4:
        _wsc_sec_e = _wsc_sec_e + us
    elif which == 5:
        _wsc_sec_f = _wsc_sec_f + us
    elif which == 6:
        _wsc_sec_g = _wsc_sec_g + us
    elif which == 7:
        _wsc_sec_h = _wsc_sec_h + us
    else:
        _wsc_sec_i = _wsc_sec_i + us

# ---------------------------------------------------------------------------
# Layout-stage cost counters (2026-09-13, round 13), same `_wsc_on` gate and
# same default-off discipline as the style counters above.
#
# Round 12 §4 recorded that `sec_layout*` had NO timers at all: the `layout()`
# window was the single largest unattributed mass in the cold pipeline and had
# never been profiled. These eight buckets are INCLUSIVE leaf timers on the
# layout helpers that do real work; nested ones are noted in the report's own
# doc rather than subtracted, exactly as `sec_resolve` nests in `sec_metrics`.
var _wlay_us: [i64] = [0; 10]
var _wlay_calls: [i64] = [0; 10]

fn _wlay_add(which: i32, us: i64, calls: i64):
    if _wsc_on:
        _wlay_us[which] = _wlay_us[which] + us
        _wlay_calls[which] = _wlay_calls[which] + calls

pub fn web_layout_counters_report() -> text:
    "lay_measure_ms={_wlay_us[0] / 1000} lay_measure_calls={_wlay_calls[0]}" +
        " lay_inline_ms={_wlay_us[1] / 1000} lay_inline_calls={_wlay_calls[1]}" +
        " lay_wrap_ms={_wlay_us[2] / 1000} lay_wrap_calls={_wlay_calls[2]}" +
        " lay_intrinsic_ms={_wlay_us[3] / 1000} lay_intrinsic_calls={_wlay_calls[3]}" +
        " lay_flex_ms={_wlay_us[4] / 1000} lay_flex_calls={_wlay_calls[4]}" +
        " lay_table_ms={_wlay_us[5] / 1000} lay_table_calls={_wlay_calls[5]}" +
        " lay_grid_ms={_wlay_us[6] / 1000} lay_grid_calls={_wlay_calls[6]}" +
        " lay_ellipsize_ms={_wlay_us[7] / 1000} lay_ellipsize_calls={_wlay_calls[7]}" +
        " lay_compose_resolve_ms={_wlay_us[8] / 1000} lay_compose_resolve_calls={_wlay_calls[8]}" +
        " lay_cps_ms={_wlay_us[9] / 1000} lay_cps_calls={_wlay_calls[9]}"

pub fn web_style_counters_report() -> text:
    "probe_calls={_wsc_probe_calls} probe_ms={_wsc_probe_us / 1000}" +
        " dispatch_calls={_wsc_dispatch_calls} dispatch_ms={_wsc_dispatch_us / 1000}" +
        " table_calls={_wsc_table_calls} table_ms={_wsc_table_us / 1000}" +
        " table_entries={_wsc_table_entries}" +
        " selector_calls={_wsc_selector_calls} selector_ms={_wsc_selector_us / 1000}" +
        " candidates={_wsc_candidates}" +
        " sec_inherit_ms={_wsc_sec_a / 1000} sec_select_ms={_wsc_sec_b / 1000}" +
        " sec_cascade_ms={_wsc_sec_c / 1000} sec_wm_ms={_wsc_sec_d / 1000}" +
        " sec_metrics_ms={_wsc_sec_e / 1000} sec_store_ms={_wsc_sec_f / 1000}" +
        " sec_lang_ms={_wsc_sec_g / 1000} sec_resolve_ms={_wsc_sec_h / 1000}" +
        " sec_digest_ms={_wsc_sec_i / 1000}" +
        " sel_match_ms={_wsc_sub_0 / 1000} sel_sort_ms={_wsc_sub_1 / 1000}" +
        " cas_accum_ms={_wsc_sub_2 / 1000} cas_merge_ms={_wsc_sub_3 / 1000}" +
        " cas_pre_ms={_wsc_sub_4 / 1000} cas_key_ms={_wsc_sub_5 / 1000}" +
        " cas_apply_ms={_wsc_sub_6 / 1000} cas_tail_ms={_wsc_sub_7 / 1000}" +
        " tail_inline_ms={_wsc_sub_8 / 1000} tail_imp_ms={_wsc_sub_9 / 1000}" +
        " tail_inlineimp_ms={_wsc_sub_10 / 1000}" +
        " tail_display_ms={_wsc_sub_11 / 1000}" +
        " tail_overflow_ms={_wsc_sub_12 / 1000}" +
        " tail_struct_ms={_wsc_sub_13 / 1000}" +
        " decl_tbl_hits={_decl_table_memo_hits}" +
        " decl_tbl_misses={_decl_table_memo_misses}"
# Cap on the number of style rules the cascade will apply per node; rules beyond
# this index (CSS source order) are skipped so the first rules keep their effect.
val WEB_STYLE_RULE_QUOTA: i32 = 4096
# Cap on declarations processed for a single rule; a rule with more is skipped.
pub val WEB_RULE_DECL_QUOTA: i32 = 256
# Maximum embedding depth for iframe rendering-inside-rendering. The top document
# is depth 0; each nested iframe child renders one level deeper. A child whose
# depth would EXCEED this cap is not recursed into — its content box is filled
# with a flat placeholder instead — so a page that embeds itself (or a cycle)
# can never drive unbounded recursion.
val WEB_IFRAME_DEPTH_CAP: i32 = 3
# Placeholder fill painted in place of an iframe whose child would exceed the
# depth cap (opaque grey).
val WEB_IFRAME_PLACEHOLDER: u32 = 0xFF888888u32

# Per-render mutable state (reset at the start of every public render entry).
var _web_render_deadline_us: i64 = 0
var _web_render_degraded: bool = false
# Name of the first budget-exhaustion site taken in the current render ("" until then).
var _web_render_degrade_site: text = ""

# Deterministic primary budget (bug web_paint_wallclock_budget_flake_2026-07-31):
# every guard check is one unit of work, and a render may spend
# budget_ms * WEB_RENDER_STEPS_PER_MS of them. Same input -> same verdict,
# whatever the host load. Wall-clock is kept only as a generous safety
# ceiling: the deadline plus (WEB_RENDER_WALLCLOCK_CEILING_FACTOR - 1) x budget.
val WEB_RENDER_STEPS_PER_MS: i64 = 1000
val WEB_RENDER_WALLCLOCK_CEILING_FACTOR: i64 = 10
var _web_render_steps: i64 = 0
var _web_render_step_budget: i64 = 0
var _web_render_wall_grace_us: i64 = 0

# Platform budget floor: slow/emulated platforms (e.g. SimpleOS under QEMU
# TCG, ~30x slower than native) legitimately need more wall-clock than the
# native-tuned defaults. The platform entry point may raise the floor once at
# startup; 0 means no floor. This is a calibration knob, not a budget bypass —
# the budget still expires past the floored deadline.
var _web_render_budget_floor_ms: i64 = 0
# Absolute floor deadline for the current render (begin-time + floor); rearm
# never lowers the deadline below this.
var _web_render_floor_deadline_us: i64 = 0

pub fn simple_web_layout_set_render_budget_floor_ms(ms: i64):
    if ms > 0:
        _web_render_budget_floor_ms = ms

# Current platform budget floor (ms); see setter above. Exposed so bounded
# degraded-retry callers (simple_web_layout_engine2d_fast) can capture the
# floor before a temporary raise and restore it afterwards.
pub fn simple_web_layout_render_budget_floor_ms() -> i64:
    _web_render_budget_floor_ms

# Scoped-restore counterpart to the raise-only public setter: accepts any
# value >= 0 (including lowering back to "no floor") so a degraded-retry
# caller can undo its temporary raise. Not a budget bypass — the retry it
# unwinds still ran against a real armed deadline.
pub fn simple_web_layout_restore_render_budget_floor_ms(ms: i64):
    if ms >= 0:
        _web_render_budget_floor_ms = ms

# Diagnostic: current clock vs armed deadline, as text (safe channel), for
# budget-break attribution receipts.
pub fn web_budget_now_and_deadline() -> text:
    val now = _web_budget_clock.now_micros()
    "now_us={now} deadline_us={_web_render_deadline_us}"

# True iff the most recent render tripped its wall-clock budget (a phase stopped
# early). Quota drops do NOT set this — they are silent by design.
pub fn simple_web_layout_last_render_degraded() -> bool:
    _web_render_degraded

# Clear the module-global degrade latch without arming a budget.
#
# The latch is normally cleared by `_web_budget_begin`, i.e. by STARTING a
# render. A document-pipeline cache hit skips the whole compose (and therefore
# the begin), so without this the latch would still carry whatever the last
# real render left behind, and the execution result — which reads
# `simple_web_layout_last_render_degraded()` AFTER compose — would report a
# cached, complete frame as degraded. Only cache hits of results whose own
# `render_degraded` field is false call this; a degraded result is never
# cached, so this can never launder an exhausted render into a clean one.
pub fn simple_web_layout_clear_render_degraded():
    _web_render_degraded = false
    _web_render_degrade_site = ""

# Short diagnostic suffix for the degrade_reason field callers append to their
# "reason=budget-exhausted:" receipt string (see simple_web_html_layout_renderer.spl).
# Until 2026-08-05 this function did not exist at all -- both call sites
# referenced an undefined symbol, so any render that took the degraded-result
# branch (which the _web_budget_expired_at fix above now reaches whenever the
# wall-clock budget actually trips) failed to compile/resolve. Empty when the
# last render was not degraded, matching simple_web_layout_last_render_degraded().
pub fn simple_web_layout_last_render_degrade_reason() -> text:
    if _web_render_degraded:
        if _web_render_degrade_site != "": _web_render_degrade_site else: "deadline-exceeded"
    else:
        ""

# Arm the budget for a fresh render: record the deadline and clear the flag.
# A budget_ms that is <= 0, or that is still the module default (i.e. the
# caller went through the public entry point's default arg rather than
# passing an explicit override), is subject to the SIMPLE_WEB_RENDER_BUDGET_MS
# env override; an explicit non-default budget_ms from the caller always wins.
fn _web_budget_begin(budget_ms: i64):
    val env_override = _web_render_budget_ms_env_override()
    val ms = if budget_ms <= 0 or budget_ms == WEB_RENDER_BUDGET_MS:
        if env_override > 0: env_override else: WEB_RENDER_BUDGET_MS
    else:
        budget_ms
    val floored_ms = if ms < _web_render_budget_floor_ms: _web_render_budget_floor_ms else: ms
    val begin_now = _web_budget_clock.now_micros()
    _web_render_deadline_us = begin_now + floored_ms * 1000
    _web_render_floor_deadline_us = if _web_render_budget_floor_ms > 0: begin_now + _web_render_budget_floor_ms * 1000 else: 0
    _web_render_steps = 0
    _web_render_step_budget = floored_ms * WEB_RENDER_STEPS_PER_MS
    _web_render_wall_grace_us = floored_ms * 1000 * (WEB_RENDER_WALLCLOCK_CEILING_FACTOR - 1)
    _web_render_degraded = false
    _web_render_degrade_site = ""

# Re-arm the deadline mid-render to hand the NEXT stage its own slice of the
# total budget, without ever extending the overall wall-clock past whatever
# the caller originally granted. Used to stage-partition a single budget_ms
# across style -> layout -> paint so an early stage exhausting its slice does
# not zero out every later stage (see simple_web_layout_render_html_software_pixels).
# A stage that already tripped the deadline stays expired: rearming only ever
# raises the deadline to a point <= the original total, so if the previous
# absolute deadline was already in the past, moving it later just grants the
# next stage its fresh slice; it never un-expires a stage's own past work.
#
# The stage slice is computed from render_start, so an EARLIER stage that
# overran the whole budget handed the next stage a deadline already in the
# past -- i.e. no slice at all. Every guarded per-node loop in that stage then
# breaks on its FIRST iteration, so layout and paint emit nothing and the
# frame comes back blank even though style had resolved every box. That is how
# one slow text node erased a sibling box that painted correctly on its own:
# the box was styled and its geometry known, and the paint pass was denied the
# single iteration it needed to emit the fill. Floor every rearm at a small
# slice measured from NOW so a stage always gets enough to emit what earlier
# stages already computed. This does NOT raise the default budget (see
# WEB_RENDER_BUDGET_MS above) and does not un-expire the current stage --
# _web_render_degraded stays latched and the overrun is still reported; the
# extra wall clock is bounded by one constant per stage boundary.
val WEB_RENDER_STAGE_MIN_SLICE_MS: i64 = 2000

fn _web_budget_rearm(deadline_us: i64):
    if _web_render_deadline_us > 0:
        val floored = if _web_render_floor_deadline_us > deadline_us: _web_render_floor_deadline_us else: deadline_us
        val min_slice_us = _web_budget_clock.now_micros() + WEB_RENDER_STAGE_MIN_SLICE_MS * 1000
        _web_render_deadline_us = if floored > min_slice_us: floored else: min_slice_us

# True once the step budget is spent or the wall-clock safety ceiling has
# passed; latches the degraded flag so callers can report the render as
# degraded. A deadline of 0 means "not armed" (guards are inert), so any code
# path that never called _web_budget_begin runs unbounded exactly as before.
fn _web_budget_expired() -> bool:
    if _web_render_deadline_us <= 0:
        return false
    _web_render_steps = _web_render_steps + 1
    if _web_render_step_budget > 0 and _web_render_steps > _web_render_step_budget:
        _web_render_degraded = true
        return true
    if _web_budget_clock.now_micros() > _web_render_deadline_us + _web_render_wall_grace_us:
        _web_render_degraded = true
        return true
    false

# Per-call-site identifiers for the budget guard below. Every layout/paint
# pass in simple_web_html_layout_renderer_layout.spl and
# simple_web_html_layout_renderer_paint_layout.spl names its own guard call
# site so a degraded-render diagnosis can attribute which pass broke on the
# deadline. Values only need to be distinct.
val WEB_BUDGET_SITE_LAYOUT_SUBTREE: i32 = 1
val WEB_BUDGET_SITE_PAINT_BACKGROUNDS: i32 = 2
val WEB_BUDGET_SITE_PAINT_RELATIVE_ROOTS: i32 = 3
val WEB_BUDGET_SITE_PAINT_ABSOLUTE_LOW_Z: i32 = 4
val WEB_BUDGET_SITE_PAINT_ABSOLUTE_HIGH_Z: i32 = 5
val WEB_BUDGET_SITE_PAINT_SCROLLBARS: i32 = 6
val WEB_BUDGET_SITE_PAINT_TEXT: i32 = 7

# Site-tagged wrapper the layout/paint passes above actually call. Until
# 2026-08-05 this function and the WEB_BUDGET_SITE_* constants above did not
# exist at all -- every _web_budget_expired_at(SITE) call site (7 of them,
# added across simple_web_html_layout_renderer_layout.spl and
# simple_web_html_layout_renderer_paint_layout.spl to fix an earlier "one slow
# text node erases a sibling box" budget bug, see the comment on
# _web_budget_rearm above and on the paint-pass-2 guard below) referenced an
# undefined function/undefined constants. Any render that reached this file's
# layout or paint pass (i.e. any HTML containing a tag the fast heuristic
# route does not recognize, including a bare <p> text node) hit this
# unresolved symbol and produced a blank frame -- including sibling boxes
# that had already laid out and would otherwise have painted correctly. See
# doc/08_tracking/bug/browser_text_node_blanks_frame_2026-08-05.md Defect 1.
# `site` is accepted for future per-site diagnostics/partial-budget
# attribution; the expiry check itself is the single shared wall-clock
# deadline armed by _web_budget_begin/_web_budget_rearm above.
fn _web_budget_expired_at(site: i32) -> bool:
    val expired = _web_budget_expired()
    if expired and _web_render_degrade_site == "":
        _web_render_degrade_site = _web_budget_site_name(site)
    expired

fn _web_budget_site_name(site: i32) -> text:
    if site == WEB_BUDGET_SITE_LAYOUT_SUBTREE: return "layout-subtree"
    if site == WEB_BUDGET_SITE_PAINT_BACKGROUNDS: return "paint-backgrounds"
    if site == WEB_BUDGET_SITE_PAINT_RELATIVE_ROOTS: return "paint-relative-roots"
    if site == WEB_BUDGET_SITE_PAINT_ABSOLUTE_LOW_Z: return "paint-absolute-low-z"
    if site == WEB_BUDGET_SITE_PAINT_ABSOLUTE_HIGH_Z: return "paint-absolute-high-z"
    if site == WEB_BUDGET_SITE_PAINT_SCROLLBARS: return "paint-scrollbars"
    if site == WEB_BUDGET_SITE_PAINT_TEXT: return "paint-text"
    "unknown-site"

# Style-cascade variant: same shared deadline, records which style loop tripped.
fn _web_budget_expired_in(name: text) -> bool:
    val expired = _web_budget_expired()
    if expired and _web_render_degrade_site == "":
        _web_render_degrade_site = name
    expired

# ---------------------------------------------------------------------------
# Flat node arena
# ---------------------------------------------------------------------------

# Tier 1 HNode attribute presence bits (lower 16 bits of HNode.attr_mask).
pub val HNODE_ATTR_ID_BIT: u32 = 1u32
pub val HNODE_ATTR_CLASS_BIT: u32 = 2u32
pub val HNODE_ATTR_STYLE_BIT: u32 = 4u32
pub val HNODE_ATTR_HIDDEN_BIT: u32 = 8u32
pub val HNODE_ATTR_DISABLED_BIT: u32 = 16u32
pub val HNODE_ATTR_CHECKED_BIT: u32 = 32u32
pub val HNODE_ATTR_SELECTED_BIT: u32 = 64u32
pub val HNODE_ATTR_OPEN_BIT: u32 = 128u32
pub val HNODE_ATTR_ROLE_BIT: u32 = 256u32
pub val HNODE_ATTR_TYPE_BIT: u32 = 512u32
pub val HNODE_ATTR_NAME_BIT: u32 = 1024u32
pub val HNODE_ATTR_HREF_BIT: u32 = 2048u32
pub val HNODE_ATTR_SRC_BIT: u32 = 4096u32
pub val HNODE_ATTR_LANG_BIT: u32 = 8192u32
pub val HNODE_ATTR_ARIA_BIT: u32 = 16384u32
pub val HNODE_ATTR_DATA_BIT: u32 = 32768u32

# reason: 32-bit Bloom filter mask for HNode attribute presence prefilter
# @allow(primitive_api)
pub fn hnode_attr_bloom_bit(attr_lower: text) -> u32:
    var h: u32 = 5381u32
    var i = 0
    val n = attr_lower.byte_len()
    while i < n:
        var ch = attr_lower.byte_at(i)
        if ch >= 65 and ch <= 90:
            ch = ch + 32
        h = ((h << 5) + h + ch.to_u32()) & 65535u32
        i = i + 1
    val slot = (h ^ (h >> 4)) & 15u32
    1u32 << (16u32 + slot)

# reason: HNode lower-16 presence bitmask aligned with HNODE_ATTR_* constants
# @allow(primitive_api)
pub fn hnode_hot_bit_for_name(attr_lower: text) -> u32:
    if attr_lower == "id": return HNODE_ATTR_ID_BIT
    if attr_lower == "class": return HNODE_ATTR_CLASS_BIT
    if attr_lower == "style": return HNODE_ATTR_STYLE_BIT
    if attr_lower == "hidden": return HNODE_ATTR_HIDDEN_BIT
    if attr_lower == "disabled": return HNODE_ATTR_DISABLED_BIT
    if attr_lower == "checked": return HNODE_ATTR_CHECKED_BIT
    if attr_lower == "selected": return HNODE_ATTR_SELECTED_BIT
    if attr_lower == "open": return HNODE_ATTR_OPEN_BIT
    if attr_lower == "role": return HNODE_ATTR_ROLE_BIT
    if attr_lower == "type": return HNODE_ATTR_TYPE_BIT
    if attr_lower == "name": return HNODE_ATTR_NAME_BIT
    if attr_lower == "href": return HNODE_ATTR_HREF_BIT
    if attr_lower == "src": return HNODE_ATTR_SRC_BIT
    if attr_lower == "lang": return HNODE_ATTR_LANG_BIT
    if attr_lower.starts_with("aria-"): return HNODE_ATTR_ARIA_BIT
    if attr_lower.starts_with("data-"): return HNODE_ATTR_DATA_BIT
    0u32

class _HNodeAttrScan:
    attr_mask: u32
    role_attr: text
    type_attr: text

fn _hnode_is_ws_byte(b: i64) -> bool:
    b == 32 or b == 9 or b == 10 or b == 13

fn _hnode_scan_attrs(inner: text, start_at: i32) -> _HNodeAttrScan:
    val n = inner.byte_len() as i32
    var mask: u32 = 0u32
    var role_val = ""
    var has_role = false
    var type_val = ""
    var has_type = false
    var i: i32 = start_at
    while i < n:  # cpu-lane-loop-ok: single linear scan of ONE element's raw attribute span in mk_element_node
        val b = inner.byte_at(i)
        if _hnode_is_ws_byte(b) or b == 47 or b == 62:
            i = i + 1
            continue
        val name_start = i
        var h: u32 = 5381u32
        while i < n:
            val nb = inner.byte_at(i)
            if _hnode_is_ws_byte(nb) or nb == 61 or nb == 47 or nb == 62:
                break
            var lb = nb
            if lb >= 65 and lb <= 90:
                lb = lb + 32
            h = ((h << 5) + h + lb.to_u32()) & 65535u32
            i = i + 1
        val name_len = i - name_start
        if name_len > 0:
            val slot = (h ^ (h >> 4)) & 15u32
            mask = mask | (1u32 << (16u32 + slot))
            val name_lower = inner.substring(name_start, i).lower()
            mask = mask | hnode_hot_bit_for_name(name_lower)
            while i < n and _hnode_is_ws_byte(inner.byte_at(i)):
                i = i + 1
            if i < n and inner.byte_at(i) == 61:
                i = i + 1
                while i < n and _hnode_is_ws_byte(inner.byte_at(i)):
                    i = i + 1
                var val_start = i
                var val_end = i
                if i < n and (inner.byte_at(i) == 34 or inner.byte_at(i) == 39):
                    val q = inner.byte_at(i)
                    i = i + 1
                    val_start = i
                    while i < n and inner.byte_at(i) != q:
                        i = i + 1
                    val_end = i
                    if i < n and inner.byte_at(i) == q:
                        i = i + 1
                else:
                    val_start = i
                    while i < n and not _hnode_is_ws_byte(inner.byte_at(i)) and inner.byte_at(i) != 62:
                        i = i + 1
                    val_end = i
                if not has_role and name_lower == "role":
                    role_val = inner.substring(val_start, val_end)
                    has_role = true
                elif not has_type and name_lower == "type":
                    type_val = inner.substring(val_start, val_end)
                    has_type = true
        else:
            i = i + 1
    _HNodeAttrScan(attr_mask: mask, role_attr: role_val, type_attr: type_val)

# reason: builds u32 attr presence/Bloom bitmask for HNode
# @allow(primitive_api)
pub fn hnode_compute_attr_mask(
    attrs_raw: text, id_attr: text, class_attr: text, style_attr: text,
    role_attr: text, type_attr: text
) -> u32:
    var mask = _hnode_scan_attrs(attrs_raw, 0).attr_mask
    if id_attr != "":
        mask = mask | HNODE_ATTR_ID_BIT | hnode_attr_bloom_bit("id")
    if class_attr != "":
        mask = mask | HNODE_ATTR_CLASS_BIT | hnode_attr_bloom_bit("class")
    if style_attr != "":
        mask = mask | HNODE_ATTR_STYLE_BIT | hnode_attr_bloom_bit("style")
    if role_attr != "":
        mask = mask | HNODE_ATTR_ROLE_BIT | hnode_attr_bloom_bit("role")
    if type_attr != "":
        mask = mask | HNODE_ATTR_TYPE_BIT | hnode_attr_bloom_bit("type")
    mask

class HNode:
    tag: text          # lowercased tag, "#text", or "#root"
    text_data: text    # text for #text nodes
    text_trimmed: text
    style_attr: text   # raw style="" value
    class_attr: text
    class_words: [text]
    has_widget_class: bool
    has_icon_image_class: bool
    has_widget_panel_class: bool
    has_widget_button_class: bool
    has_widget_image_class: bool
    has_focused_class: bool
    id_attr: text
    role_attr: text = ""
    type_attr: text = ""
    attr_mask: u32 = 0u32
    attrs_raw: text    # raw tag inner text for attribute selectors
    parent: i64        # index of parent in the arena (-1 for root)
    is_details_summary: bool # first direct summary owned by details
    # Raw source of whitespace-only text after an element ("" otherwise).
    # Where the computed white-space keeps newlines each "\n" in it is a
    # forced break (`html_kept_newlines`); `text_data` keeps its spaces.
    ws_raw: text = ""
    # On "#root" only: the source starts with a doctype, so the document is in
    # standards (no-quirks) mode. A document without one is in quirks mode.
    standards_mode: bool = false
    # On "#root" only: `simple_web_layout_uses_legacy_widget_chrome` holds (a
    # `widget-panel` page with no `<style>`), the mode whose painter fills panels.
    legacy_widget_chrome: bool = false

class HtmlChildIndex:
    first_child: [i32]
    next_sibling: [i32]
    child_count: [i32]

class SelectorContext:
    child_index: HtmlChildIndex
    element_position: [i32]
    element_sibling_count: [i32]
    has_content_child: [bool]
    # 1-based position among same-tag element siblings, and how many there are.
    # Built once per style pass so :nth-of-type / :nth-last-of-type are lookups.
    type_position: [i32]
    type_count: [i32]
    # Arena index of the previous ELEMENT sibling (-1 when first), for the
    # `+` and `~` combinators.
    prev_element: [i32]
    # Unique per build_selector_context() call; keys the pass-scoped selector
    # caches so they can never serve another document.
    pass_id: i64

class ClassFlags:
    has_widget_class: bool
    has_icon_image_class: bool
    has_widget_panel_class: bool
    has_widget_button_class: bool
    has_widget_image_class: bool
    has_focused_class: bool

fn mk_node(tag: text, parent: i64) -> HNode:
    HNode(tag: tag, text_data: "", text_trimmed: "", style_attr: "", class_attr: "", class_words: [], has_widget_class: false, has_icon_image_class: false, has_widget_panel_class: false, has_widget_button_class: false, has_widget_image_class: false, has_focused_class: false, id_attr: "", role_attr: "", type_attr: "", attr_mask: 0u32, attrs_raw: "", parent: parent, is_details_summary: false)

fn build_child_index(nodes: [HNode]) -> HtmlChildIndex:
    val node_count = nodes.len()
    var first_child: [i32] = [-1; node_count]
    var last_child: [i32] = [-1; node_count]
    var next_sibling: [i32] = [-1; node_count]
    var child_count: [i32] = [0; node_count]
    var i = 0
    while i < node_count:
        val parent = nodes[i].parent
        if parent >= 0 and parent < node_count:
            if first_child[parent] < 0:
                first_child[parent] = i
            else:
                next_sibling[last_child[parent]] = i
            last_child[parent] = i
            child_count[parent] = child_count[parent] + 1
        i = i + 1
    HtmlChildIndex(first_child: first_child, next_sibling: next_sibling, child_count: child_count)

var _selector_pass_counter: i64 = 0

fn build_selector_context(nodes: [HNode], child_index: HtmlChildIndex) -> SelectorContext:
    _selector_pass_counter = _selector_pass_counter + 1
    val node_count = nodes.len()
    var element_position: [i32] = [1; node_count]
    var element_sibling_count: [i32] = [1; node_count]
    var has_content_child: [bool] = [false; node_count]
    var type_position: [i32] = [1; node_count]
    var type_count: [i32] = [1; node_count]
    var prev_element: [i32] = [0 - 1; node_count]
    var parent = 0
    while parent < node_count:
        var element_count = 0
        var type_seen: Dict<text, i32> = {}
        var last_element = 0 - 1
        var child = child_index.first_child[parent]
        while child >= 0:
            val nd = nodes[child]
            if nd.tag == "#text":
                if nd.text_trimmed.len() > 0:
                    has_content_child[parent] = true
            else:
                has_content_child[parent] = true
                element_count = element_count + 1
                element_position[child] = element_count
                prev_element[child] = last_element
                last_element = child
                val seen = (type_seen.get(nd.tag) ?? 0) + 1
                type_seen[nd.tag] = seen
                type_position[child] = seen
            child = child_index.next_sibling[child]
        child = child_index.first_child[parent]
        while child >= 0:
            if nodes[child].tag != "#text":
                element_sibling_count[child] = element_count
                type_count[child] = type_seen.get(nodes[child].tag) ?? 1
            child = child_index.next_sibling[child]
        parent = parent + 1
    SelectorContext(child_index: child_index, element_position: element_position, element_sibling_count: element_sibling_count, has_content_child: has_content_child, type_position: type_position, type_count: type_count, prev_element: prev_element, pass_id: _selector_pass_counter)

# ---------------------------------------------------------------------------
# Attribute extraction (reads class/id/style out of the raw tag inner text)
# ---------------------------------------------------------------------------

fn attr_value(inner: text, name: text) -> text:
    # find name= and read the quoted value; simple, tolerant
    val key = name + "="
    attr_value_by_key(inner, key)

fn attr_value_by_key(inner: text, key: text) -> text:
    val key_len = key.byte_len()
    val kpos = attr_key_index(inner, key, key_len)
    if kpos < 0:
        return ""
    var i = kpos + key_len
    if i >= inner.byte_len():
        return ""
    val q = inner.slice(i, i + 1)
    if q == "\"" or q == "'":
        val end = find_from(inner, q, i + 1)
        if end < 0:
            return ""
        return decode_html_entities(inner.substring(i + 1, end))
    # unquoted: read to whitespace
    var j = i
    val inner_len = inner.byte_len()
    while j < inner_len:
        val c = inner.slice(j, j + 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "/":
            break
        j = j + 1
    decode_html_entities(inner.substring(i, j))

fn split_class_words_trimmed(class_attr: text) -> [text]:
    var word_count = 1
    var i = 0
    val class_len = class_attr.byte_len()
    while i < class_len:
        if class_attr.slice(i, i + 1) == " ":
            word_count = word_count + 1
        i = i + 1
    var words: [text] = [""; word_count]
    i = 0
    var start = 0
    var word_i = 0
    while i < class_len:
        if class_attr.slice(i, i + 1) == " ":
            words[word_i] = class_attr.substring(start, i).trim()
            word_i = word_i + 1
            start = i + 1
        i = i + 1
    words[word_i] = class_attr.substring(start, class_len).trim()
    words

fn class_flags_from_attr(class_attr: text) -> ClassFlags:
    var flags = ClassFlags(has_widget_class: false, has_icon_image_class: false, has_widget_panel_class: false, has_widget_button_class: false, has_widget_image_class: false, has_focused_class: false)
    var i = 0
    val class_len = class_attr.byte_len()
    while i < class_len:
        val c = class_attr.slice(i, i + 1)
        if c == "w":
            if not flags.has_widget_class and text_matches_at(class_attr, "widget-", i):
                flags.has_widget_class = true
            if not flags.has_widget_panel_class and text_matches_at(class_attr, "widget-panel", i):
                flags.has_widget_panel_class = true
            if not flags.has_widget_button_class and text_matches_at(class_attr, "widget-button", i):
                flags.has_widget_button_class = true
            if not flags.has_widget_image_class and text_matches_at(class_attr, "widget-image", i):
                flags.has_widget_image_class = true
        elif c == "i":
            if not flags.has_icon_image_class and text_matches_at(class_attr, "icon-image", i):
                flags.has_icon_image_class = true
        elif c == "f":
            if not flags.has_focused_class and text_matches_at(class_attr, "focused", i):
                flags.has_focused_class = true
        i = i + 1
    flags

fn mk_element_node(tag: text, parent: i64, inner: text) -> HNode:
    # Construct array-bearing node fields in one typed value. Mutating an
    # initially-empty [text] field and then copying the class into [HNode]
    # loses earlier siblings' array handles in native code.
    val class_attr: text = attr_value_by_key(inner, "class=")
    val class_words: [text] = if class_attr.len() > 0: split_class_words_trimmed(class_attr) else: []
    val flags: ClassFlags = class_flags_from_attr(class_attr)
    val id_attr: text = attr_value_by_key(inner, "id=")
    val style_attr: text = attr_value_by_key(inner, "style=")
    val tag_len = tag.byte_len() as i32
    val inner_len = inner.byte_len() as i32
    var scan_start: i32 = 0
    if tag_len > 0 and inner_len >= tag_len:
        if inner == tag:
            scan_start = tag_len
        elif inner_len > tag_len and inner.substring(0, tag_len).lower() == tag.lower():
            val next_b = inner.byte_at(tag_len)
            if _hnode_is_ws_byte(next_b) or next_b == 47 or next_b == 62:
                scan_start = tag_len
    val scanned = _hnode_scan_attrs(inner, scan_start)
    var attr_mask = scanned.attr_mask
    if id_attr != "":
        attr_mask = attr_mask | HNODE_ATTR_ID_BIT | hnode_attr_bloom_bit("id")
    if class_attr != "":
        attr_mask = attr_mask | HNODE_ATTR_CLASS_BIT | hnode_attr_bloom_bit("class")
    if style_attr != "":
        attr_mask = attr_mask | HNODE_ATTR_STYLE_BIT | hnode_attr_bloom_bit("style")
    HNode(
        tag: tag,
        text_data: "",
        text_trimmed: "",
        style_attr: style_attr,
        class_attr: class_attr,
        class_words: class_words,
        has_widget_class: flags.has_widget_class,
        has_icon_image_class: flags.has_icon_image_class,
        has_widget_panel_class: flags.has_widget_panel_class,
        has_widget_button_class: flags.has_widget_button_class,
        has_widget_image_class: flags.has_widget_image_class,
        has_focused_class: flags.has_focused_class,
        id_attr: id_attr,
        role_attr: scanned.role_attr,
        type_attr: scanned.type_attr,
        attr_mask: attr_mask,
        attrs_raw: inner,
        parent: parent,
        is_details_summary: false
    )

# ---------------------------------------------------------------------------
# Canonical projection -> renderer arena
# ---------------------------------------------------------------------------

# Encode a Unicode code point to UTF-8 text. The common-tier helper
# (char_from_codepoint) returns U+FFFD for bytes >= 128, so non-ASCII must go
# through the runtime byte->text boundary here instead.
use std.common.string_core.{bytes_to_text}

fn _codepoint_to_text(cp: i64) -> text:
    if cp <= 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
        return "�"
    var bytes: [u8] = []
    if cp < 0x80:
        bytes.push(cp)
    elif cp < 0x800:
        bytes.push(0xC0 + cp / 64)
        bytes.push(0x80 + cp % 64)
    elif cp < 0x10000:
        bytes.push(0xE0 + cp / 4096)
        bytes.push(0x80 + (cp / 64) % 64)
        bytes.push(0x80 + cp % 64)
    else:
        bytes.push(0xF0 + cp / 262144)
        bytes.push(0x80 + (cp / 4096) % 64)
        bytes.push(0x80 + (cp / 64) % 64)
        bytes.push(0x80 + cp % 64)
    bytes_to_text(bytes)

# Decode decimal (&#NNNN;) and hex (&#xHHHH;) numeric character references per
# the WHATWG character-reference rules. Runs BEFORE the named-entity replaces:
# "&amp;#38;" contains no literal "&#" pair, so double-decoding cannot occur.
fn _decode_numeric_entities(s: text) -> text:
    var start = find_from(s, "&#", 0)
    if start < 0:
        return s
    val n = s.byte_len()
    var out = ""
    var i = 0
    while start >= 0:
        out = out + s.substring(i, start)
        var j = start + 2
        var is_hex = false
        if j < n and (s.substring(j, j + 1) == "x" or s.substring(j, j + 1) == "X"):
            is_hex = true
            j = j + 1
        var cp = 0i64
        var digits = 0
        var valid = true
        while j < n and digits <= 7:
            val c = s.substring(j, j + 1)
            if c == ";":
                break
            var d = -1
            if c >= "0" and c <= "9":
                d = c.byte_at(0) - 48
            elif is_hex and c >= "a" and c <= "f":
                d = c.byte_at(0) - 87
            elif is_hex and c >= "A" and c <= "F":
                d = c.byte_at(0) - 55
            if d < 0:
                valid = false
                break
            cp = cp * (if is_hex: 16 else: 10) + d
            digits = digits + 1
            j = j + 1
        if valid and digits > 0 and j < n and s.substring(j, j + 1) == ";":
            out = out + _codepoint_to_text(cp)
            i = j + 1
        else:
            # Not a well-formed reference: emit "&#" literally and move on.
            out = out + "&#"
            i = start + 2
        start = find_from(s, "&#", i)
    out + s.substring(i, n)

# Decode the HTML character entities the markdown/office HTML emitters produce
# (markdown_escape_html: & < > " '). Text nodes carry escaped content, so the
# painter would otherwise show "&quot;" literally instead of a quote. Decode
# &amp; LAST so "&amp;lt;" round-trips to "&lt;", not "<".
fn decode_html_entities(s: text) -> text:
    if s.len() == 0:
        return s
    if find_from(s, "&", 0) < 0:
        return s
    var out = _decode_numeric_entities(s)
    out = out.replace("&lt;", "<")
    out = out.replace("&gt;", ">")
    out = out.replace("&quot;", "\"")
    out = out.replace("&#39;", "'")
    out = out.replace("&apos;", "'")
    out = out.replace("&nbsp;", " ")
    out = out.replace("&#32;", " ")
    out = out.replace("&#x20;", " ")
    out = out.replace("&#X20;", " ")
    out = out.replace("&#34;", "\"")
    out = out.replace("&#x22;", "\"")
    out = out.replace("&#X22;", "\"")
    out = out.replace("&#38;", "&")
    out = out.replace("&#x26;", "&")
    out = out.replace("&#X26;", "&")
    out = out.replace("&#60;", "<")
    out = out.replace("&#x3C;", "<")
    out = out.replace("&#x3c;", "<")
    out = out.replace("&#X3C;", "<")
    out = out.replace("&#X3c;", "<")
    out = out.replace("&#62;", ">")
    out = out.replace("&#x3E;", ">")
    out = out.replace("&#x3e;", ">")
    out = out.replace("&#X3E;", ">")
    out = out.replace("&#X3e;", ">")
    out.replace("&amp;", "&")

# True when the HTML source begins with a doctype, after any leading
# whitespace and comments: the document is then in standards (no-quirks) mode,
# which decides UA rules such as Chrome's quirks-only `input:not([type=image]),
# textarea { box-sizing: border-box }`. Legacy public identifiers that select
# quirks mode despite a doctype are not modelled.
fn html_source_has_doctype(html: text) -> bool:
    val n = html.byte_len()
    var i: i64 = 0
    # cpu-lane-loop-ok: leading whitespace and comments of one document; stops at its first tag
    while i < n:
        val ch = html.byte_at(i)
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 or ch == 12:
            i = i + 1
        elif i + 3 < n and ch == 60 and html.byte_at(i + 1) == 33 and html.byte_at(i + 2) == 45 and html.byte_at(i + 3) == 45:
            var j = i + 4
            # cpu-lane-loop-ok: one leading comment; bound is its byte length
            while j + 2 < n and not (html.byte_at(j) == 45 and html.byte_at(j + 1) == 45 and html.byte_at(j + 2) == 62):
                j = j + 1
            i = j + 3
        else:
            return i + 9 <= n and html.substring(i, i + 9).lower() == "<!doctype"
    false

fn parse_html(html: text) -> [HNode]:
    _parse_html_with_limits(
        html, SIMPLE_WEB_MAX_HTML_NODES, SIMPLE_WEB_MAX_HTML_BYTES
    )

fn _parse_html_with_node_limit(html: text, requested_node_limit: i32) -> [HNode]:
    _parse_html_with_limits(
        html, requested_node_limit, SIMPLE_WEB_MAX_HTML_BYTES
    )

# True when `parent` is or sits inside an element the UA stylesheet makes
# preformatted (`pre`, `textarea`, `listing`, `plaintext`).
fn _html_in_preformatted(nodes: [HNode], parent: i32) -> bool:
    var p = parent
    while p >= 0:
        val tag = nodes[p].tag
        if tag == "pre" or tag == "textarea" or tag == "listing" or tag == "plaintext":
            return true
        p = nodes[p].parent
    false

# The spaces of whitespace-only text after an element: one per space or tab
# in the source, at least one (a newline alone is one space).
fn _html_ws_spaces(raw: text) -> text:
    var out = ""
    for ch in raw.chars():
        if ch == " " or ch == "\t":
            out = out + " "
    if out == "": " " else: out

# Forced breaks a whitespace-only text node makes: its newline count where
# the computed white-space keeps newlines (`Style.white_space_newline`),
# else 0.
fn html_kept_newlines(node: HNode, keeps_newlines: bool) -> i32:
    if not keeps_newlines or node.ws_raw == "" or node.text_trimmed != "":
        return 0
    var n = 0
    for ch in node.ws_raw.chars():
        if ch == "\n":
            n = n + 1
    n

fn _parse_html_with_limits(
    html: text, requested_node_limit: i32, requested_byte_limit: i64
) -> [HNode]:
    val node_limit = if requested_node_limit < 1:
        1
    elif requested_node_limit > SIMPLE_WEB_MAX_HTML_NODES:
        SIMPLE_WEB_MAX_HTML_NODES
    else:
        requested_node_limit
    val byte_limit = if requested_byte_limit < 0:
        0
    elif requested_byte_limit > SIMPLE_WEB_MAX_HTML_BYTES:
        SIMPLE_WEB_MAX_HTML_BYTES
    else:
        requested_byte_limit
    if not _simple_web_html_source_admitted(html, byte_limit):
        return [mk_node("#root", -1)]
    val projected = html_tree_builder_flat_projection_with_limits(
        html, node_limit, SIMPLE_WEB_MAX_HTML_PARTS, 65536
    )
    var flat_to_hnode: [i32] = [-1; projected.nodes.len()]
    var skip_subtree: [bool] = [false; projected.nodes.len()]
    var details_has_summary: [bool] = [false; node_limit]
    # Tag of the latest child of each flat parent, so whitespace after an
    # element is kept for the cascade to judge.
    var prev_child_tag: [text] = [""; projected.nodes.len()]
    var nodes: [HNode] = []
    var i = 0
    while i < projected.nodes.len() and nodes.len() < node_limit:
        val flat = projected.nodes[i]
        val parent_skipped = (
            flat.parent >= 0 and skip_subtree[flat.parent]
        )
        val skip = (
            parent_skipped or flat.tag == "head" or flat.tag == "style" or
            flat.tag == "script" or flat.tag == "title" or
            flat.tag == "meta" or flat.tag == "link" or flat.tag == "base"
        )
        skip_subtree[i] = skip
        if skip:
            i = i + 1
            continue
        val parent = if flat.parent < 0:
            -1
        else:
            flat_to_hnode[flat.parent]
        val prev_child_tag_before = if flat.parent >= 0: prev_child_tag[flat.parent] else: ""
        if flat.parent >= 0:
            prev_child_tag[flat.parent] = flat.tag
        if flat.tag == "#text":
            val trimmed = flat.text_data.trim()
            # Whitespace after an element is kept as one collapsible space:
            # between inline-level boxes it is one (`<canvas></canvas>\n<svg>`
            # puts 4.45px between them in Chrome). Whether it renders at all
            # depends on computed display, so compute_styles hides it beside
            # block-level boxes and inside flex/grid/table containers. A
            # newline in it is remembered (`ws_raw`): where the computed
            # white-space keeps newlines the layout breaks the line there.
            # Only a lone " " survived here before.
            val after_element = trimmed.len() == 0 and prev_child_tag_before != "" and prev_child_tag_before != "#text"
            # Inside a preformatted element the spaces keep their count
            # (`<pre><b>a</b>  <b>b</b>` is a two-space gap); elsewhere the
            # layout would not collapse them, so one space is stored.
            val text_data = if not after_element: flat.text_data elif _html_in_preformatted(nodes, parent): _html_ws_spaces(flat.text_data) else: " "
            if trimmed.len() > 0 or after_element or text_data == " ":
                if (nodes.len() > 0 and nodes[nodes.len() - 1].tag == "#text" and
                    nodes[nodes.len() - 1].parent == parent):
                    val previous_index = nodes.len() - 1
                    var previous = nodes[previous_index]
                    previous.text_data = previous.text_data + text_data
                    previous.text_trimmed = previous.text_data.trim()
                    nodes[previous_index] = previous
                    flat_to_hnode[i] = previous_index
                else:
                    var text_node = mk_node("#text", parent)
                    text_node.text_data = text_data
                    text_node.text_trimmed = trimmed
                    if after_element:
                        text_node.ws_raw = flat.text_data
                    flat_to_hnode[i] = nodes.len() as i32
                    nodes.push(text_node)
        else:
            val tag = if flat.tag == "#document": "#root" else: flat.tag
            flat_to_hnode[i] = nodes.len() as i32
            var element = mk_element_node(
                tag, parent, tag + flat.normalized_attrs
            )
            if tag == "#root":
                element.standards_mode = html_source_has_doctype(html)
                element.legacy_widget_chrome = simple_web_layout_uses_legacy_widget_chrome(html)
            if (
                tag == "summary" and parent >= 0 and
                nodes[parent].tag == "details" and
                not details_has_summary[parent]
            ):
                element.is_details_summary = true
                details_has_summary[parent] = true
            nodes.push(element)
            # ::marker synthesis (bug browser_engine_no_list_marker_boxes_
            # 2026-08-19): every <li> in a list context owns a marker box
            # child, as Chrome's layout tree does. Visibility is decided in
            # compute_styles from list-style(-type); geometry comes from the
            # ::marker post-pass in layout(). First child by construction.
            if (
                tag == "li" and parent >= 0 and nodes.len() < node_limit and
                (nodes[parent].tag == "ul" or nodes[parent].tag == "ol" or
                 nodes[parent].tag == "menu")
            ):
                nodes.push(mk_node("::marker", (nodes.len() - 1) as i64))
        i = i + 1
    if nodes.len() == 0:
        return [mk_node("#root", -1)]
    nodes

pub fn simple_web_layout_debug_capped_node_count(
    html: text, requested_node_limit: i32
) -> i32:
    _parse_html_with_node_limit(html, requested_node_limit).len() as i32

pub fn simple_web_layout_debug_capped_input_node_count(
    html: text, requested_byte_limit: i64
) -> i32:
    _parse_html_with_limits(
        html, SIMPLE_WEB_MAX_HTML_NODES, requested_byte_limit
    ).len() as i32

pub fn simple_web_layout_debug_dump_nodes(html: text) -> text:
    """Permanent debug entry point (bounded module-internal parse_html/HNode
    are not otherwise externally testable): one line per node,
    'index|tag|parent|id_attr|style_attr_len|attrs_raw_len'. Used to isolate
    the vector-font-evidence style-attribute-loss defect -- see
    doc/08_tracking/bug/jit_run_file_pipeline_gaps_2026-07-30.md section 16."""
    val nodes = parse_html(html)
    var out: [text] = []
    var i = 0
    while i < nodes.len():
        val node = nodes[i]
        out.push(
            i.to_text() + "|" + node.tag + "|" + node.parent.to_text() + "|" +
            node.id_attr + "|" + node.style_attr.len().to_text() + "|" +
            node.attrs_raw.len().to_text()
        )
        i = i + 1
    out.join("\n")

pub fn simple_web_layout_debug_attr_by_id(html: text, id: text, attr: text) -> text:
    val nodes = parse_html(html)
    var i = 0
    val node_count = nodes.len()
    while i < node_count:
        val node = nodes[i]
        if node.id_attr == id:
            if attr == "style":
                return node.style_attr
            if attr == "class":
                return node.class_attr
            if attr == "id":
                return node.id_attr
            return attr_value(node.attrs_raw, attr)
        i = i + 1
    ""


pub fn simple_web_layout_uses_legacy_widget_chrome(html: text) -> bool:
    html.contains("widget-panel") and not html.contains("<style")

# returns packed u32, or 0 for "none/transparent/empty"
fn parse_color(raw: text) -> u32:
    val s = raw.trim().lower()
    if s.len() == 0 or s == "transparent" or s == "none" or s == "inherit":
        return 0u32
    if s == "white": return web_argb(255, 255, 255)
    if s == "black": return web_argb(0, 0, 0)
    # CSS Color 5 `light-dark(<light>, <dark>)`: this renderer paints the
    # light color scheme, so the first top-level argument wins. Without this
    # example.com's `background: light-dark(#eee,#222)` decoded as garbage.
    if s.starts_with("light-dark(") and s.ends_with(")"):
        val inner = s.slice(11, s.byte_len() - 1)
        var depth = 0
        var i = 0
        while i < inner.byte_len():
            val ch = inner.substring(i, i + 1)
            if ch == "(":
                depth = depth + 1
            elif ch == ")":
                depth = depth - 1
            elif ch == "," and depth == 0:
                return parse_color(inner.slice(0, i))
            i = i + 1
        return 0u32
    if s.substring(0, 1) == "#":
        val h_len = s.byte_len() - 1
        if h_len == 8:
            val r = hex_val(s.substring(1, 2)) * 16 + hex_val(s.substring(2, 3))
            val g = hex_val(s.substring(3, 4)) * 16 + hex_val(s.substring(4, 5))
            val b = hex_val(s.substring(5, 6)) * 16 + hex_val(s.substring(6, 7))
            val a = hex_val(s.substring(7, 8)) * 16 + hex_val(s.substring(8, 9))
            if a == 0:
                # Fully transparent (`#0000`, `#ff000000`): 0, the value every
                # painter skips. Packed as-is its alpha byte of 0 read as opaque.
                return 0u32
            return (a.to_u32() << 24) | (r.to_u32() << 16) | (g.to_u32() << 8) | b.to_u32()
        if h_len >= 6:
            val r = hex_val(s.substring(1, 2)) * 16 + hex_val(s.substring(2, 3))
            val g = hex_val(s.substring(3, 4)) * 16 + hex_val(s.substring(4, 5))
            val b = hex_val(s.substring(5, 6)) * 16 + hex_val(s.substring(6, 7))
            return web_argb(r, g, b)
        if h_len == 4:
            val r = hex_val(s.substring(1, 2)) * 17
            val g = hex_val(s.substring(2, 3)) * 17
            val b = hex_val(s.substring(3, 4)) * 17
            val a = hex_val(s.substring(4, 5)) * 17
            if a == 0:
                return 0u32
            return (a.to_u32() << 24) | (r.to_u32() << 16) | (g.to_u32() << 8) | b.to_u32()
        if h_len == 3:
            val r = hex_val(s.substring(1, 2)) * 17
            val g = hex_val(s.substring(2, 3)) * 17
            val b = hex_val(s.substring(3, 4)) * 17
            return web_argb(r, g, b)
        return 0u32
    # rgb()/rgba()/hsl()/hsla() in every syntax keep their alpha through the
    # delegate (legacy comma rgba() was forced opaque here until 2026-11-15);
    # invalid input is 0 -- not a colour -- never black.
    _parse_color_delegated(s)

fn _parse_color_delegated(lowered: text) -> u32:
    """Named colors, hsl()/hsla() and the other CSS color forms this local
    parser never learned, delegated to the browser-engine color parser
    (`dom_color.parse_color_value_checked`, RGBA-packed) and converted to the
    ARGB packing used here. `currentcolor` is excluded: it needs the inherited
    text color, which this context-free entry point does not have, and the
    delegate would silently answer opaque black."""
    if lowered == "currentcolor":
        return 0u32
    val first = if lowered.len() > 0: lowered.substring(0, 1) else: ""
    if dec_val(first) < 10 or first == ".":
        # The delegate ends with a bare `parse_i64`, so `1` would come back as
        # a nonzero "color". No CSS color starts with a digit or a dot, and
        # callers here read nonzero as "a color was found".
        return 0u32
    val parsed = parse_color_value_checked(lowered)
    if parsed == nil:
        return 0u32
    val rgba = parsed ?? 0u32
    val a = rgba & 0xFFu32
    if a == 0u32:
        return 0u32
    (a << 24) | ((rgba >> 8) & 0xFFFFFFu32)

fn parse_color_any(raw: text) -> u32:
    val direct = parse_color(raw)
    if direct != 0u32:
        return direct
    # The colour token of a shorthand (`4px solid blue`): a named colour was
    # never found here, so `border:1px solid black` painted no border.
    val tok = _shorthand_color_token(raw)
    if tok != 0u32:
        return tok
    val lower = raw.lower()
    # The first colour function inside a shorthand (`4px solid hsl(...)`):
    # rgb()/rgba() and hsl()/hsla() alike.
    val rgb_at = text_index_of(lower, "rgb")
    val hsl_at = text_index_of(lower, "hsl")
    val rgb = if rgb_at < 0 or (hsl_at >= 0 and hsl_at < rgb_at): hsl_at else: rgb_at
    if rgb >= 0:
        val rp = find_from(raw, ")", rgb)
        if rp >= 0:
            val cv = parse_color(raw.substring(rgb, rp + 1))
            if cv != 0u32:
                return cv
    val hash = text_index_of(raw, "#")
    if hash >= 0:
        return parse_color(raw.substring(hash, raw.byte_len()))
    0u32

# First top-level token of a shorthand that parses as a colour; a length
# (`4px`, `0`) is skipped, since the delegate would read its digits as one.
fn _shorthand_color_token(raw: text) -> u32:
    for tok in _decl_top_level_tokens(raw):
        if not "0123456789.-+".contains(tok.substring(0, 1)):
            val c = parse_color(tok)
            if c != 0u32:
                return c
    0u32

# Alpha-aware CSS color: 0 for none/transparent, else ARGB with true alpha
# (rgba() keeps its alpha; every other form is opaque like parse_color_any).
fn parse_color_alpha(raw: text) -> u32:
    val s = raw.trim().lower()
    if text_matches_at(s, "rgb", 0) or text_matches_at(s, "hsl", 0):
        # dom_color's CSS Color 4 parser: comma or space syntax, `/ alpha`,
        # percentages, hue units; 0 when invalid or fully transparent.
        return _parse_color_delegated(s)
    val rgba_at = text_index_of(s, "rgba")
    if rgba_at >= 0:
        val lp = find_from(s, "(", rgba_at)
        val rp = if lp >= 0: find_from(s, ")", lp + 1) else: -1
        if lp >= 0 and rp > lp:
            val c1 = find_from(s, ",", lp + 1)
            val c2 = if c1 >= 0: find_from(s, ",", c1 + 1) else: -1
            val c3 = if c2 >= 0: find_from(s, ",", c2 + 1) else: -1
            if c1 >= 0 and c2 >= 0 and c3 >= 0 and c3 < rp:
                val a255 = parse_alpha_fraction_range(s, c3 + 1, rp)
                if a255 <= 0:
                    return 0u32
                val r = parse_int_range(s, lp + 1, c1)
                val g = parse_int_range(s, c1 + 1, c2)
                val b = parse_int_range(s, c2 + 1, c3)
                return (a255.to_u32() << 24) | ((r.to_u32()) << 16) | ((g.to_u32()) << 8) | b.to_u32()
    parse_color_any(raw)

fn parse_linear_gradient_color(raw: text, target: i32) -> u32:
    # BUG (fixed here): a numeric angle token ("45deg", ...) used to fall
    # through to `elif item_index == target: return parse_color_any(part)`
    # exactly like a real color stop, because only the `to <side>` keyword
    # form was recognized as a direction token. That shifted every stop
    # index by one whenever the gradient carried an explicit angle: target=0
    # returned the (non-color) angle text as 0u32 instead of the first stop,
    # and target=1 returned the first stop instead of the second.
    val lower = raw.lower()
    val start = text_index_of(lower, "linear-gradient(")
    if start < 0:
        return 0u32
    # BUG (fixed here, second defect): the close paren used to be the FIRST
    # `)` after `lp`, and the stop scan split `inner` on EVERY comma. Both
    # break as soon as a stop is itself a function -- for
    # `linear-gradient(180deg, rgba(255,255,255,0.09), rgba(...))` the inner
    # text was truncated to `180deg, rgba(255,255,255,0.09` and then shredded
    # into `rgba(255` / `255` / `255` / `0.09`, so BOTH from and to came back
    # 0u32 and the layer was never recognised as a typed gradient at all.
    val lp = find_from(raw, "(", start)
    if lp < 0:
        return 0u32
    val rp = gradient_matching_close(raw, lp)
    if rp <= lp:
        return 0u32
    val inner = raw.substring(lp + 1, rp)
    var item_index = 0
    for raw_part in split_top_level_commas_paren_aware(inner):
        val part = raw_part.trim()
        if text_starts_with_portable(part, "to ") or part == "top" or part == "bottom" or part == "left" or part == "right" or is_gradient_angle_token(part):
            item_index = item_index - 1
        elif item_index == target:
            # Alpha-aware: glass-theme gradients carry rgba() stops whose alpha
            # IS the sheen (e.g. rgba(255,255,255,0.08)); parse_color_any made
            # every stop opaque (0xFFFFFFFF), erasing the translucency the CPU
            # material admission keys on.
            # A positioned stop (`#0f0 60%`) is still that colour.
            return parse_color_alpha(gradient_stop_color_text(part))
        item_index = item_index + 1
    0u32

# Text inside the outer `linear-gradient(...)`/`radial-gradient(...)` parens,
# or "" if neither prefix is present.
fn gradient_inner(raw: text) -> text:
    val lower = raw.lower()
    var start = text_index_of(lower, "linear-gradient(")
    var open_len = "linear-gradient(".len()
    if start < 0:
        start = text_index_of(lower, "radial-gradient(")
        open_len = "radial-gradient(".len()
    if start < 0:
        return ""
    val lp = start + open_len - 1
    # Same nested-paren defect as parse_linear_gradient_color above: the first
    # `)` closes an `rgba(...)` stop, not the gradient.
    val rp = gradient_matching_close(raw, lp)
    if rp <= lp:
        return ""
    raw.substring(lp + 1, rp)

# The image layers of a `background` / `background-image` list when every
# one is a plain `linear-gradient(...)` or `radial-gradient(...)` with at least
# two stops, in CSS order (the first paints on top). A trailing colour-only
# layer (the `background` shorthand's final layer) is not an image and is
# left out; `gradient_layer_list_color_text` returns it. Anything else
# (url(), repeating-/conic- gradients, a colour inside an image layer, a
# malformed layer) returns [] so the whole list stays fail-closed.
#
# A layer may carry a shorthand tail after its function,
# `<position> [/ <size>] <repeat>` (`gradient_layer_tail_parts`); the list is
# [] when any tail is outside that subset, and only the functions are
# returned here (`gradient_layer_entries` keeps the tails).
fn gradient_layer_list(raw: text) -> [text]:
    var layers: [text] = []
    for entry in gradient_layer_entries(raw):
        val split = gradient_layer_split(entry)
        if gradient_layer_tail_parts(split[1]).len() == 0:
            return []
        layers.push(split[0])
    layers

# The image layers of a gradient-only background list with their tails,
# whatever the tail holds; [] when any image layer is not a plain linear /
# radial gradient function with >= 2 stops.
fn gradient_layer_entries(raw: text) -> [text]:
    val parts = split_top_level_commas_paren_aware(raw.trim())
    var count = parts.len()
    if count > 1 and gradient_layer_list_color_text(raw) != "":
        count = count - 1
    var layers: [text] = []
    var i = 0
    while i < count:
        val layer = parts[i].trim()
        val split = gradient_layer_split(layer)
        if split.len() != 2 or parse_gradient_stops(split[0]).len() < 2:
            return []
        layers.push(layer)
        i = i + 1
    layers

# A gradient list rewritten so every image layer carries its own
# `<position> / <size> <repeat>` tail: the per-layer entry of each
# non-empty longhand list (repeated cyclically, CSS Backgrounds 3 §2.2),
# else the layer's shorthand tail. "" when `raw` is not a gradient list or
# every layer keeps the default geometry (nothing to rewrite).
fn gradient_layer_list_apply_longhands(raw: text, size_list: text, position_list: text, repeat_list: text) -> text:
    val entries = gradient_layer_entries(raw)
    if entries.len() == 0:
        return ""
    val sizes = if size_list.trim() == "": [] else: split_top_level_commas_paren_aware(size_list.trim())
    val positions = if position_list.trim() == "": [] else: split_top_level_commas_paren_aware(position_list.trim())
    val repeats = if repeat_list.trim() == "": [] else: split_top_level_commas_paren_aware(repeat_list.trim())
    # One tail-less layer that does not repeat stays on the typed
    # single-gradient path: it already places one sized tile, with Chrome's
    # ordered dither, which the layer path does not carry.
    if entries.len() == 1 and gradient_layer_split(entries[0])[1].trim() == "" and repeats.len() > 0:
        val rx_ry = background_repeat_spec(repeats[0].trim())
        if rx_ry.len() == 2 and rx_ry[0] == 0 and rx_ry[1] == 0:
            return ""
    var out: [text] = []
    var any_change = false
    var i = 0
    while i < entries.len():
        val split = gradient_layer_split(entries[i])
        var tail = gradient_layer_tail_parts(split[1])
        if tail.len() == 0:
            # An unsupported shorthand tail stays as authored (fail-closed).
            out.push(entries[i])
            any_change = true
        else:
            val pos = if positions.len() > 0: positions[i % positions.len()].trim() else: tail[0]
            val size = if sizes.len() > 0: sizes[i % sizes.len()].trim() else: tail[1]
            val rep = if repeats.len() > 0: repeats[i % repeats.len()].trim() else: tail[2]
            if not background_layer_geometry_default(size, pos, rep):
                any_change = true
            val p = if pos == "": "0% 0%" else: pos
            val s = if size == "": "auto" else: size
            val r = if rep == "": "repeat" else: rep
            out.push(split[0] + " " + p + " / " + s + " " + r)
        i = i + 1
    if not any_change:
        return ""
    val color = gradient_layer_list_color_text(raw)
    if color != "" and split_top_level_commas_paren_aware(raw.trim()).len() > entries.len():
        out.push(color.trim())
    _bg_join(out, ", ")

# Linear-gradient angle in CSS degrees (0 = to top, 90 = to right, 180 (the
# CSS default) = to bottom, 270 = to left). Radial gradients have no angle.
fn parse_gradient_angle_deg(raw: text) -> i32:
    val inner = gradient_inner(raw)
    if inner.len() == 0:
        return 180
    val parts = split_top_level_commas_paren_aware(inner)
    if parts.len() == 0:
        return 180
    val first = parts[0].trim()
    if is_gradient_angle_token(first):
        return gradient_angle_token_deg(first)
    # `to <corner>`: the angle depends on the box, resolved at paint time
    # (`gradient_corner_dir_q16`); 1000 + the square-box angle.
    if first == "to top right" or first == "to right top":
        return 1045
    if first == "to bottom right" or first == "to right bottom":
        return 1135
    if first == "to bottom left" or first == "to left bottom":
        return 1225
    if first == "to top left" or first == "to left top":
        return 1315
    if first == "to top":
        return 0
    if first == "to right":
        return 90
    if first == "to bottom":
        return 180
    if first == "to left":
        return 270
    180

# Full N-stop list for a `linear-gradient(...)`/`radial-gradient(...)` value
# with every stop position in permille of the gradient line. Length stops
# (`px`, `em`) cannot be placed without a line; here they are unpositioned
# (`parse_gradient_stops_on_line` resolves them against a known line).
fn parse_gradient_stops(raw: text) -> [GradientStopSpec]:
    parse_gradient_stops_on_line(raw, 0, 16)

# True when any stop of the gradient function `raw` is positioned by a
# length: such a gradient can only be resolved per box (and per tile), so
# the cascade's typed single-layer projections must leave it to the
# gradient layer path.
# reason: cascade-time predicate over raw CSS gradient text
# @allow(primitive_api)
pub fn gradient_has_length_stop(raw: text) -> bool:
    val inner = gradient_inner(raw)
    if inner.len() == 0:
        return false
    for part in split_top_level_commas_paren_aware(inner):
        val ls = find_last_top_level_space(part)
        if ls >= 0:
            if gradient_stop_token(part.substring(ls + 1, part.byte_len()), 16)[0] == 2:
                return true
    false

# Full N-stop list resolved against a gradient line `line_q10` long (Q10 px;
# 0 = unknown, length stops then stay unpositioned). Explicit stops are
# honored (percentages, or lengths as a share of the line, rounded to the
# nearest permille); CSS Images 3 §3.4.3 fix-up: an unpositioned first stop
# is 0%, an unpositioned last stop 100%, a stop below the largest position
# before it is raised to it, and runs of unpositioned stops are spaced
# evenly between their positioned neighbours. Positions may lie outside
# 0..1000.
# reason: shared stop resolver for the cascade (line unknown) and the per-layer painters; line in Q10 px, font size in px
# @allow(primitive_api)
pub fn parse_gradient_stops_on_line(raw: text, line_q10: i64, em_px: i32) -> [GradientStopSpec]:
    val inner = gradient_inner(raw)
    var stops: [GradientStopSpec] = []
    if inner.len() == 0:
        return stops
    val radial = is_radial_gradient(raw)
    val parts = split_top_level_commas_paren_aware(inner)
    var color_parts: [text] = []
    var idx = 0
    while idx < parts.len():
        val part = parts[idx]
        val skip = if radial:
            is_gradient_shape_or_position_token(part)
        else:
            text_starts_with_portable(part, "to ") or part == "top" or part == "bottom" or part == "left" or part == "right" or is_gradient_angle_token(part)
        if not skip:
            color_parts.push(part)
        idx = idx + 1
    val n = color_parts.len()
    if n == 0:
        return stops
    var colors: [u32] = []
    var raw_pos: [i32] = []
    var placed: [bool] = []
    var i2 = 0
    while i2 < n:
        val cp = color_parts[i2]
        colors.push(parse_color_any(gradient_stop_color_text(cp)))
        val ls = find_last_top_level_space(cp)
        val tok = if ls >= 0: gradient_stop_token(cp.substring(ls + 1, cp.byte_len()), em_px) else: [0, 0]
        if tok[0] == 1:
            raw_pos.push(tok[1] as i32)
            placed.push(true)
        elif tok[0] == 2 and line_q10 > 0:
            val num = tok[1] * 1000
            val pm = if num >= 0: (num + line_q10 / 2) / line_q10 else: 0 - ((0 - num + line_q10 / 2) / line_q10)
            raw_pos.push(pm as i32)
            placed.push(true)
        else:
            raw_pos.push(0)
            placed.push(false)
        i2 = i2 + 1
    if not placed[0]:
        raw_pos[0] = 0
        placed[0] = true
    if not placed[n - 1]:
        raw_pos[n - 1] = if raw_pos[0] > 1000: raw_pos[0] else: 1000
        placed[n - 1] = true
    # CSS Images 3 §3.4.3: a positioned stop below the largest position
    # before it is raised to that position (a hard edge).
    var run_max = raw_pos[0]
    var q = 1
    while q < n:
        if placed[q]:
            if raw_pos[q] < run_max:
                raw_pos[q] = run_max
            run_max = raw_pos[q]
        q = q + 1
    var k = 1
    while k < n - 1:
        if not placed[k]:
            var j = k + 1
            while j < n - 1 and not placed[j]:
                j = j + 1
            val prev_pos = raw_pos[k - 1]
            val next_pos = raw_pos[j]
            val span = j - (k - 1)
            var m = k
            while m < j:
                raw_pos[m] = prev_pos + (next_pos - prev_pos) * (m - (k - 1)) / span
                m = m + 1
            k = j
        else:
            k = k + 1
    var i3 = 0
    while i3 < n:
        stops.push(GradientStopSpec(color: colors[i3], pos_permille: raw_pos[i3]))
        i3 = i3 + 1
    stops

fn parse_transition_property_name(raw: text) -> text:
    for part in css_timing_shorthand_tokens(raw):
        val token = part.trim().lower()
        if (
            token.len() > 0 and not transition_token_is_time(token) and
            parse_timing_function(token) == nil
        ):
            return token
    "all"

fn parse_transition_timing(raw: text) -> text:
    for raw_token in css_timing_shorthand_tokens(raw):
        val token = raw_token.trim().lower()
        if parse_timing_function(token) != nil:
            return token
    "ease"

fn animation_token_is_reserved(token: text) -> bool:
    val t = token.trim().lower()
    transition_token_is_time(t) or parse_timing_function(t) != nil or t == "infinite" or t == "normal" or t == "reverse" or t == "alternate" or t == "alternate-reverse" or t == "none" or t == "forwards" or t == "backwards" or t == "both" or t == "running" or t == "paused"

fn parse_animation_iteration_number_token(raw: text) -> f64?:
    if not animation_number_token_is_valid(raw):
        return nil
    val token = raw.trim().lower()
    if token.starts_with("-"):
        var mantissa_i = 1
        while (
            mantissa_i < token.byte_len() and
            token.substring(mantissa_i, mantissa_i + 1) != "e"
        ):
            val digit = dec_val(token.substring(mantissa_i, mantissa_i + 1))
            if digit > 0 and digit < 10:
                return nil
            mantissa_i = mantissa_i + 1
    if val parsed = token.parse_f64():
        if (
            parsed == parsed and parsed >= 0.0 and
            parsed <= CSS_ANIMATION_MAX_FINITE_ITERATIONS
        ):
            return Some(parsed)
    nil

fn parse_animation_name(raw: text) -> text:
    val parts = css_timing_shorthand_tokens(raw)
    for part in parts:
        val token = part.trim().lower()
        if (
            animation_token_looks_numeric(token) and
            not transition_token_is_time(token) and
            parse_animation_iteration_number_token(token) == nil
        ):
            return "none"
    for part in parts:
        val token = part.trim()
        val lowered = token.lower()
        if (
            token.len() > 0 and not animation_token_is_reserved(lowered) and
            parse_animation_iteration_number_token(lowered) == nil
        ):
            return token
    "none"

fn parse_animation_iteration_count(raw: text) -> text:
    val parts = css_timing_shorthand_tokens(raw)
    for part in parts:
        val token = part.trim().lower()
        if token == "infinite":
            return "infinite"
        if (
            token.len() > 0 and
            parse_animation_iteration_number_token(token) != nil and
            not transition_token_is_time(token)
        ):
            return token
    "1"

fn animation_shorthand_is_valid(raw: text) -> bool:
    val parts = css_timing_shorthand_tokens(raw.trim().lower())
    if parts.len() == 0:
        return false
    var time_count = 0
    var name_count = 0
    var timing_count = 0
    var iteration_count = 0
    var direction_count = 0
    var fill_count = 0
    var play_count = 0
    for part in parts:
        if transition_token_is_time(part):
            if (
                time_count >= 2 or
                not animation_time_token_is_valid(part, time_count == 1)
            ):
                return false
            time_count = time_count + 1
        elif parse_timing_function(part) != nil:
            timing_count = timing_count + 1
            if timing_count > 1:
                return false
        elif part == "infinite" or animation_token_looks_numeric(part):
            if (
                iteration_count > 0 or
                (
                    part != "infinite" and
                    parse_animation_iteration_number_token(part) == nil
                )
            ):
                return false
            iteration_count = iteration_count + 1
        elif (
            part == "normal" or part == "reverse" or
            part == "alternate" or part == "alternate-reverse"
        ):
            direction_count = direction_count + 1
            if direction_count > 1:
                return false
        elif (
            part == "none" or part == "forwards" or
            part == "backwards" or part == "both"
        ):
            fill_count = fill_count + 1
            if fill_count > 1:
                return false
        elif part == "running" or part == "paused":
            play_count = play_count + 1
            if play_count > 1:
                return false
        else:
            if part.contains("(") or part.contains(")"):
                return false
            name_count = name_count + 1
            if name_count > 1:
                return false
    true

fn animation_declaration_value_is_valid(prop: text, raw: text) -> bool:
    val value = raw.trim().lower()
    if value.len() == 0:
        return false
    if prop == "animation":
        return animation_shorthand_is_valid(value)
    if prop == "animation-name":
        val tokens = css_timing_shorthand_tokens(value)
        return (
            tokens.len() == 1 and
            not animation_token_looks_numeric(value)
        )
    if prop == "animation-duration":
        return animation_time_token_is_valid(value, false)
    if prop == "animation-delay":
        return animation_time_token_is_valid(value, true)
    if prop == "animation-timing-function":
        return parse_timing_function(value) != nil
    if prop == "animation-iteration-count":
        return (
            value == "infinite" or
            parse_animation_iteration_number_token(value) != nil
        )
    if prop == "animation-direction":
        return (
            value == "normal" or value == "reverse" or
            value == "alternate" or value == "alternate-reverse"
        )
    if prop == "animation-fill-mode":
        return (
            value == "none" or value == "forwards" or
            value == "backwards" or value == "both"
        )
    if prop == "animation-play-state":
        return value == "running" or value == "paused"
    false

fn transition_shorthand_is_valid(raw: text) -> bool:
    val parts = css_timing_shorthand_tokens(raw.trim().lower())
    if parts.len() == 0:
        return false
    var time_count = 0
    var timing_count = 0
    var property_count = 0
    for part in parts:
        if transition_token_is_time(part):
            if (
                time_count >= 2 or
                not animation_time_token_is_valid(part, time_count == 1)
            ):
                return false
            time_count = time_count + 1
        elif parse_timing_function(part) != nil:
            timing_count = timing_count + 1
            if timing_count > 1:
                return false
        else:
            if (
                part.contains("(") or part.contains(")") or
                animation_token_looks_numeric(part)
            ):
                return false
            property_count = property_count + 1
            if property_count > 1:
                return false
    true

fn transition_declaration_value_is_valid(prop: text, raw: text) -> bool:
    val value = raw.trim().lower()
    if value.len() == 0:
        return false
    if prop == "transition":
        return transition_shorthand_is_valid(value)
    if prop == "transition-property":
        val parts = css_timing_shorthand_tokens(value)
        return (
            parts.len() == 1 and not parts[0].contains("(") and
            not parts[0].contains(")") and
            not animation_token_looks_numeric(parts[0])
        )
    if prop == "transition-duration":
        return animation_time_token_is_valid(value, false)
    if prop == "transition-delay":
        return animation_time_token_is_valid(value, true)
    if prop == "transition-timing-function":
        return parse_timing_function(value) != nil
    false

fn decl_tbl_last_valid_transition_index(
    tbl: [text], prop: text
) -> i32:
    var i = (tbl.len() as i32) - 2
    while i >= 0:
        if (
            tbl[i] == prop and
            transition_declaration_value_is_valid(prop, tbl[i + 1])
        ):
            return i / 2
        i = i - 2
    -1

fn decl_tbl_get_last_valid_transition(tbl: [text], prop: text) -> text:
    val index = decl_tbl_last_valid_transition_index(tbl, prop)
    if index < 0:
        return ""
    tbl[index * 2 + 1]

fn decl_tbl_last_valid_animation_index(
    tbl: [text], prop: text
) -> i32:
    var i = (tbl.len() as i32) - 2
    while i >= 0:
        if (
            tbl[i] == prop and
            animation_declaration_value_is_valid(prop, tbl[i + 1])
        ):
            return i / 2
        i = i - 2
    -1

fn decl_tbl_get_last_valid_animation(tbl: [text], prop: text) -> text:
    val index = decl_tbl_last_valid_animation_index(tbl, prop)
    if index < 0:
        return ""
    tbl[index * 2 + 1]

# Flat table, stride 2: [name0, value0, name1, value1, ...] in source order.
# Names are trimmed+lowered, values trimmed — exactly as `decl_get` does.
#
# MEMO (2026-09-13): the table is a pure function of `decls`, but the style
# cascade rebuilds it PER NODE over a rule set that never changes within a
# document — 2190 builds for 908 nodes on css-layout, each materialising the
# whole table with a `substring().trim().lower()` per entry
# (doc/10_metrics/ui/web_document_pipeline_profile_macos_2026-09-12.md, defect 3).
# Every caller treats the returned array as READ-ONLY (verified: the four call
# sites only pass it to `decl_tbl_*` readers), so one shared instance per
# distinct block is byte-identical to a fresh build. Bounded so a pathological
# document cannot grow it without limit; `decl_table_memo_reset()` clears it.
val DECL_TABLE_MEMO_LIMIT: i64 = 4096
var _decl_table_memo: Dict<text, [text]> = {}
var _decl_table_memo_hits: i64 = 0
var _decl_table_memo_misses: i64 = 0

pub fn decl_table_memo_hits() -> i64:
    _decl_table_memo_hits

pub fn decl_table_memo_misses() -> i64:
    _decl_table_memo_misses

pub fn decl_table_memo_reset():
    _decl_table_memo = {}
    _decl_table_memo_hits = 0
    _decl_table_memo_misses = 0

fn decl_table_build(decls: text) -> [text]:
    if _decl_table_memo.has(decls):
        _decl_table_memo_hits = _decl_table_memo_hits + 1
        return _decl_table_memo[decls]
    _decl_table_memo_misses = _decl_table_memo_misses + 1
    val table = if _wsc_armed():
        val t0 = _wsc_now_us()
        val built = _decl_table_build_inner(decls)
        _wsc_add_table(_wsc_now_us() - t0, (built.len() as i64) / 2)
        built
    else:
        _decl_table_build_inner(decls)
    if _decl_table_memo.len() < DECL_TABLE_MEMO_LIMIT:
        _decl_table_memo[decls] = table
    table

fn _decl_table_build_inner(decls: text) -> [text]:
    val n = decl_entry_count(decls)
    if n == 0:
        val empty: [text] = []
        return empty
    # Preallocated + indexed store: `.push` in a loop clones the array (O(N^2)).
    # A border/outline shorthand also stores up to 12 longhands (below); the
    # table is cut to the used length at the end, so the lookups that scan it
    # whole never see the spare slots.
    val per_decl = if text_index_of(decls, "border") >= 0 or text_index_of(decls, "outline") >= 0: 26 else: 2
    # `outline` is dispatch-handled alone; its longhands (not dispatch props)
    # are only needed when an outline longhand can be overridden.
    val expand_outline = text_index_of(decls, "outline-") >= 0
    var tbl: [text] = [""; n * per_decl]
    var pos = 0
    var idx = 0
    val decls_len = decls.byte_len()
    while pos < decls_len:
        val semi = find_from(decls, ";", pos)
        val end = if semi >= 0: semi else: decls_len
        val colon = find_from(decls, ":", pos)
        if colon >= 0 and colon < end:
            val prop = decls.substring(pos, colon).trim().lower()
            val value = decls.substring(colon + 1, end).trim()
            var longhands: [text] = []
            if prop != "outline" or expand_outline:
                longhands = _border_shorthand_longhands(prop, value)
            if not _decl_invalid_color_function(prop, value) and not (longhands.len() == 1 and longhands[0] == "!"):
                # A logical property that expanded is stored as its physical
                # longhands only, so its fixed-order applier cannot re-apply
                # it over a later physical declaration.
                if longhands.len() == 0 or not _border_logical_prop(prop):
                    tbl[idx] = prop
                    tbl[idx + 1] = value
                    idx = idx + 2
                # The shorthand's longhands at its own source position, so the
                # last-wins lookup of a longhand sees a shorthand authored
                # after it (`border-top-color:red;border-color:blue` -> blue).
                for item in longhands:
                    tbl[idx] = item
                    idx = idx + 1
        if semi < 0:
            break
        pos = semi + 1
    if idx == tbl.len():
        return tbl
    var used: [text] = [""; idx]
    var k = 0
    while k < idx:
        used[k] = tbl[k]
        k = k + 1
    used

fn _border_logical_prop(prop: text) -> bool:
    prop.starts_with("border-block") or prop.starts_with("border-inline")

# Physical sides of a logical border property name (horizontal-tb, ltr --
# the mapping the logical appliers use), or [] when it is not one.
fn _border_logical_sides(name: text) -> [text]:
    if name == "border-block": return ["top", "bottom"]
    if name == "border-block-start": return ["top"]
    if name == "border-block-end": return ["bottom"]
    if name == "border-inline": return ["left", "right"]
    if name == "border-inline-start": return ["left"]
    if name == "border-inline-end": return ["right"]
    []

fn _border_kind_ok(kind: text, tok: text) -> bool:
    if kind == "color": return _border_color_token(tok)
    if kind == "width": return _border_width_token(tok)
    css_border_style_token(tok) != ""

# `thin`/`medium`/`thick` as the px the width appliers parse (Chrome 159:
# 1, 3, 5).
fn _border_width_px(tok: text) -> text:
    val t = tok.lower()
    if t == "thin": return "1px"
    if t == "medium": return "3px"
    if t == "thick": return "5px"
    tok

# The physical side longhands a border (or outline) property sets, as flat
# (property, value) pairs. ["!"] marks a declaration CSS drops whole: a
# `border-color` with a token that is not a colour or more than four values,
# so the earlier value stays. A shorthand also resets the parts it omits
# (width medium, style none, color currentcolor). A value with `var()`, or
# a width/style list the appliers must judge, is left to the appliers.
fn _border_shorthand_longhands(prop: text, value: text) -> [text]:
    var out: [text] = []
    if text_index_of(value, "var(") >= 0:
        return out
    val toks = _decl_top_level_tokens(value)
    if prop == "outline":
        return _border_parts_longhands(toks, ["outline"])
    if not prop.starts_with("border"):
        return out
    val sides = ["top", "right", "bottom", "left"]
    if prop == "border-color" or prop == "border-width" or prop == "border-style":
        val n = toks.len()
        val kind = prop.substring(7, prop.byte_len())
        if n < 1 or n > 4:
            if kind == "color" and n > 4:
                return ["!"]
            return out
        var k = 0
        while k < n:
            if not _border_kind_ok(kind, toks[k]):
                if kind == "color":
                    return ["!"]
                return out
            k = k + 1
        val r_tok = if n >= 2: toks[1] else: toks[0]
        val b_tok = if n >= 3: toks[2] else: toks[0]
        val l_tok = if n >= 4: toks[3] else: r_tok
        val per_side = [toks[0], r_tok, b_tok, l_tok]
        var s = 0
        while s < 4:
            val v = if kind == "width": _border_width_px(per_side[s]) else: per_side[s]
            out.push("border-" + sides[s] + "-" + kind)
            out.push(v)
            s = s + 1
        return out
    # Logical longhands: `border-inline-start-color` -> `border-left-color`;
    # `border-block-width: 1px 2px` -> top 1px, bottom 2px.
    for kind in ["width", "style", "color"]:
        val suffix = "-" + kind
        if prop.ends_with(suffix) and _border_logical_prop(prop):
            val lsides = _border_logical_sides(prop.substring(0, prop.byte_len() - suffix.byte_len()))
            if lsides.len() == 0 or toks.len() < 1 or toks.len() > lsides.len():
                return out
            for tok in toks:
                if not _border_kind_ok(kind, tok):
                    if kind == "color":
                        return ["!"]
                    return out
            var si = 0
            while si < lsides.len():
                val tok = if si < toks.len(): toks[si] else: toks[0]
                val v = if kind == "width": _border_width_px(tok) else: tok
                out.push("border-" + lsides[si] + "-" + kind)
                out.push(v)
                si = si + 1
            return out
    var targets: [text] = []
    if prop == "border":
        targets = sides
    elif prop == "border-top" or prop == "border-right" or prop == "border-bottom" or prop == "border-left":
        targets = [prop.substring(7, prop.byte_len())]
    else:
        targets = _border_logical_sides(prop)
    if targets.len() == 0:
        return out
    var names: [text] = []
    for side in targets:
        names.push("border-" + side)
    _border_parts_longhands(toks, names)

# Longhands `<name>-width/-style/-color` for every name in `names` from a
# width/style/color shorthand value; a part it omits is reset to its
# initial value. A token of no kind, a kind given twice or a CSS-wide
# keyword leaves it unexpanded, so the appliers keep their old reading.
fn _border_parts_longhands(toks: [text], names: [text]) -> [text]:
    var out: [text] = []
    for tok in toks:
        val t = tok.lower()
        if t == "inherit" or t == "initial" or t == "unset" or t == "revert":
            return out
    var width = ""
    var style = ""
    var color = ""
    for tok in toks:
        if _border_width_token(tok) and width == "":
            width = _border_width_px(tok)
        elif (css_border_style_token(tok) != "" or (tok.lower() == "auto" and names[0] == "outline")) and style == "":
            style = tok
        elif _border_color_token(tok) and color == "":
            color = tok
        else:
            return out
    if width == "":
        width = "3px"
    if style == "":
        style = "none"
    if color == "":
        color = "currentcolor"
    for name in names:
        out.push(name + "-width")
        out.push(width)
        out.push(name + "-style")
        out.push(style)
        out.push(name + "-color")
        out.push(color)
    out

# Painted width of an `outline` shorthand (Chrome 159): an omitted width is
# medium (3px); an omitted, `none` or `hidden` style paints nothing; `auto`
# paints the focus ring, modelled as its 1px outer column.
fn outline_shorthand_paint_width_px(raw: text) -> i32:
    var width = -1
    var styled = false
    var auto_style = false
    for tok in _decl_top_level_tokens(raw.trim().lower()):
        if tok == "auto":
            auto_style = true
        elif css_border_style_token(tok) != "":
            if border_style_disables_paint(tok):
                return 0
            styled = true
        elif width < 0 and _border_width_token(tok):
            width = parse_int(_border_width_px(tok))
    if width == 0 or (not styled and not auto_style):
        return 0
    if auto_style and not styled:
        return 1
    if width < 0: 3 else: width

fn _border_width_token(tok: text) -> bool:
    val t = tok.lower()
    t == "thin" or t == "medium" or t == "thick" or "0123456789.".contains(tok.substring(0, 1))

fn _border_color_token(tok: text) -> bool:
    val t = tok.lower()
    if t == "currentcolor" or t == "inherit" or t == "initial" or t == "unset" or t == "revert":
        return true
    not _border_width_token(tok) and (parse_color(tok) != 0u32 or _decl_transparent_color(tok))

# A colour property whose value holds a malformed rgb()/rgba()/hsl()/hsla()
# is an invalid declaration: CSS drops it whole, so the earlier (or
# inherited) value stays. Leaving it in the table let the last-wins lookup
# read it as "no colour" and lose the earlier one -- for a longhand
# (`background-color: hsl(foo, bar, baz)`) and for a shorthand
# (`background: rgb(1,2)`, `border: 3px solid hsl(foo,1%,2%)`), which also
# resets its other longhands (css_color_parse_chrome159_spec.spl AC-9, AC-10).
fn _decl_invalid_color_function(prop: text, value: text) -> bool:
    if not (
        prop == "color" or prop == "background-color" or
        prop == "background" or prop == "border" or
        prop == "border-color" or prop == "border-top" or
        prop == "border-right" or prop == "border-bottom" or
        prop == "border-left" or prop == "border-top-color" or
        prop == "border-right-color" or prop == "border-bottom-color" or
        prop == "border-left-color" or prop == "outline" or
        prop == "outline-color" or prop == "text-decoration-color" or
        prop == "caret-color"
    ):
        return false
    val v = value.lower()
    # Nothing a later stage substitutes is judged here.
    if text_index_of(v, "var(") >= 0 or text_index_of(v, "calc(") >= 0 or text_index_of(v, "env(") >= 0 or text_index_of(v, "attr(") >= 0:
        return false
    var i = 0
    val n = v.byte_len()
    while i < n:
        val lp = find_from(v, "(", i)
        if lp < 0:
            return false
        var start = lp
        while start > 0 and _decl_ident_char(v.substring(start - 1, start)):
            start = start - 1
        val name = v.substring(start, lp)
        val rp = find_from(v, ")", lp)
        if rp < 0:
            return false
        if name == "rgb" or name == "rgba" or name == "hsl" or name == "hsla":
            if parse_color_value_checked(v.substring(start, rp + 1)) == nil:
                return true
        i = rp + 1
    false

fn _decl_ident_char(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or ch == "-"

fn svg_number_milli(raw: text) -> i64:
    """SVG number in thousandths of a user unit; a unit suffix is ignored."""
    val s = raw.trim()
    val n = s.len() as i32
    var i = 0
    var negative = false
    if i < n and s.char_at(i) == "-":
        negative = true
        i = i + 1
    var value: i64 = 0
    while i < n and dec_val(s.char_at(i)) < 10:
        value = value * 10 + dec_val(s.char_at(i)).to_i64()
        i = i + 1
    value = value * 1000
    if i < n and s.char_at(i) == ".":
        i = i + 1
        var place: i64 = 100
        while i < n and dec_val(s.char_at(i)) < 10:
            value = value + dec_val(s.char_at(i)).to_i64() * place
            place = place / 10
            i = i + 1
    if negative: 0 - value else: value

fn svg_view_box_milli(attrs_raw: text) -> [i64]:
    """The four `viewBox` numbers (min-x, min-y, width, height) of an `<svg>`
    in thousandths, or an empty list when the attribute is absent, malformed
    or has a non-positive width/height (SVG 2 §8.6: such a viewBox is not
    applied). The numbers may be separated by commas and any whitespace."""
    var raw = attr_value(attrs_raw, "viewBox")
    if raw == "":
        raw = attr_value(attrs_raw, "viewbox")
    var parts: [i64] = []
    # cpu-lane-loop-ok: converts the four viewBox tokens of one <svg>; bound is the attribute's token count
    for token in ws_tokens(raw.replace(",", " ")):
        parts.push(svg_number_milli(token))
    if parts.len() != 4 or parts[2] <= 0 or parts[3] <= 0:
        return []
    parts

# ---------------------------------------------------------------------------
# Computed style
# ---------------------------------------------------------------------------

# Per-codepoint advances with CSS letter-spacing (after every codepoint) and
# word-spacing (each space/tab/newline) folded in at milli-px. Each advance is
# the difference of the ROUNDED cumulative pen, so a fractional spacing
# (`0.1em` = 1.6 px) lands every glyph where Chrome's float pen does and the
# run width is round(natural + n * spacing); whole-px spacing reduces to
# `advance + spacing`. An advance never drops under 1 px.
# reason: per-codepoint advance table in, same-shape table out; no domain type exists for the raw pen arrays.
# @allow(primitive_api)
pub fn spaced_advances_milli(advances: [i32], cps: [i64], letter_milli: i32, word_milli: i32) -> [i32]:
    var out: [i32] = []
    var natural: i64 = 0
    var extra: i64 = 0
    var placed: i64 = 0
    var i = 0
    while i < advances.len():  # cpu-lane-loop-ok: one pass over one text run's per-codepoint advances; bound is its codepoint count
        natural = natural + advances[i].to_i64()
        val cp = cps[i]
        # Chrome adds no letter-spacing after an Arabic-script letter (joined or
        # isolated); spaces, digits and Latin inside the run still take it.
        if script_of(cp as u32) != Script.Arabic:
            extra = extra + letter_milli.to_i64()
        if cp == 32 or cp == 9 or cp == 10 or cp == 13:
            extra = extra + word_milli.to_i64()
        val pen = natural * 1000 + extra
        val target = if pen >= 0: (pen + 500) / 1000 else: 0 - ((500 - pen) / 1000)
        var a = target - placed
        if a < 1:
            a = 1
        placed = placed + a
        out.push(a.to_i32())
        i = i + 1
    out
