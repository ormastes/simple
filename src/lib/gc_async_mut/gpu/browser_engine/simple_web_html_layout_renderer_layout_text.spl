fn ellipsize_text_for_width(txt: text, start: i32, endv: i32, max_width: i32, st: Style, advance: i32, space_advance: i32) -> text:
    if not _wsc_on:
        return _lay_ellipsize_text_for_width_inner(txt, start, endv, max_width, st, advance, space_advance)
    val t0 = _wsc_now_us()
    val out = _lay_ellipsize_text_for_width_inner(txt, start, endv, max_width, st, advance, space_advance)
    _wlay_add(7, _wsc_now_us() - t0, 1)
    out
