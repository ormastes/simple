# codex-impl: pure state and semantic markup for web renderer showcase tabs.

class WebShowcaseTab:
    id: text
    label: text

class WebShowcaseState:
    tabs: [WebShowcaseTab]
    focused_index: i32
    selected_index: i32

pub fn web_showcase_tabs() -> [WebShowcaseTab]:
    [
        WebShowcaseTab(id: "overview", label: "Overview"),
        WebShowcaseTab(id: "html", label: "HTML"),
        WebShowcaseTab(id: "css-layout", label: "CSS Layout"),
        WebShowcaseTab(id: "css-paint", label: "CSS Paint"),
        WebShowcaseTab(id: "forms-media", label: "Forms & Media"),
        WebShowcaseTab(id: "animation", label: "Animation"),
        WebShowcaseTab(id: "evidence", label: "Evidence")
    ]

pub fn web_showcase_state() -> WebShowcaseState:
    WebShowcaseState(tabs: web_showcase_tabs(), focused_index: 0, selected_index: 0)

fn clamp_tab_index(state: WebShowcaseState, index: i32) -> i32:
    if state.tabs.len() == 0:
        return 0
    if index < 0:
        return 0
    if index >= state.tabs.len():
        return state.tabs.len() - 1
    index

pub fn web_showcase_focus_key(state: WebShowcaseState, key: text) -> WebShowcaseState:
    if state.tabs.len() == 0:
        return WebShowcaseState(tabs: [], focused_index: 0, selected_index: 0)
    var next = state.focused_index
    if key == "ArrowRight":
        next = next + 1
        if next >= state.tabs.len():
            next = 0
    elif key == "ArrowLeft":
        next = next - 1
        if next < 0:
            next = state.tabs.len() - 1
    elif key == "Home":
        next = 0
    elif key == "End":
        next = state.tabs.len() - 1
    WebShowcaseState(tabs: state.tabs, focused_index: clamp_tab_index(state, next), selected_index: state.selected_index)

pub fn web_showcase_activate_focused(state: WebShowcaseState, key: text) -> WebShowcaseState:
    if state.tabs.len() == 0:
        return WebShowcaseState(tabs: [], focused_index: 0, selected_index: 0)
    if key != "Enter" and key != "Space":
        return state
    WebShowcaseState(tabs: state.tabs, focused_index: state.focused_index, selected_index: state.focused_index)

pub fn web_showcase_activate_pointer(state: WebShowcaseState, index: i32) -> WebShowcaseState:
    if state.tabs.len() == 0:
        return WebShowcaseState(tabs: [], focused_index: 0, selected_index: 0)
    val selected = clamp_tab_index(state, index)
    WebShowcaseState(tabs: state.tabs, focused_index: selected, selected_index: selected)

pub fn web_showcase_tab_markup(state: WebShowcaseState) -> text:
    if state.tabs.len() == 0 or state.selected_index < 0 or state.selected_index >= state.tabs.len():
        return ""
    var out = "<nav role=\"tablist\" aria-label=\"Web renderer feature groups\">"
    var i = 0
    while i < state.tabs.len():
        val tab = state.tabs[i]
        val selected = i == state.selected_index
        val focused = i == state.focused_index
        val tabindex = if focused: "0" else: "-1"
        out = out + "<button role=\"tab\" id=\"tab-" + tab.id + "\" aria-controls=\"panel-" + tab.id + "\" aria-selected=\"{selected}\" tabindex=\"" + tabindex + "\">" + tab.label + "</button>"
        i = i + 1
    val active = state.tabs[state.selected_index]
    out + "</nav><section role=\"tabpanel\" id=\"panel-" + active.id + "\" aria-labelledby=\"tab-" + active.id + "\"></section>"
