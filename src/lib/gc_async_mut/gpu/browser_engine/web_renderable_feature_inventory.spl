# codex-impl: typed, fail-closed inventory for the canonical Simple Web showcase.
#
# A row is never promoted by lexical occurrence in a fixture. `renderable` is
# reserved for a production path with a direct layout or paint effect;
# incomplete value families are `partial`, document-only behavior is
# `nonpaint`, and names without a renderer effect are `unsupported`.

use common.string_builder.{RtStringBuilder}
use std.gc_async_mut.gpu.browser_engine.web_renderable_feature_witness.{web_feature_witness_markup}

pub val WEB_FEATURE_HTML: text = "html-tag"
pub val WEB_FEATURE_CSS: text = "css-property"

pub val WEB_RENDERABLE: text = "renderable"
pub val WEB_PARTIAL: text = "partial"
pub val WEB_NONPAINT: text = "nonpaint"
pub val WEB_UNSUPPORTED: text = "unsupported"

pub val WEB_HTML_CANONICAL_COUNT: i32 = 113
pub val WEB_CSS_CANONICAL_COUNT: i32 = 284

class WebRenderableFeatureRow:
    id: text
    kind: text
    name: text
    value_family: text
    status: text
    production_owner: text
    test_owner: text
    showcase_tab: text

class WebRenderableFeatureInventory:
    version: text
    rows: [WebRenderableFeatureRow]

val _WEB_HTML_NAMES: [text] = "a abbr address area article aside audio b base bdi bdo blockquote body br button canvas caption cite code col colgroup data datalist dd del details dfn dialog div dl dt em embed fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 head header hgroup hr html i iframe img input ins kbd label legend li link main map mark menu meta meter nav noscript object ol optgroup option output p picture pre progress q rp rt ruby s samp script search section select selectedcontent slot small source span strong style sub summary sup table tbody td template textarea tfoot th thead time title tr track u ul var video wbr".split(" ")

# Catalog scope follows CSS_SUPPORTED in check-html-css-sspec-traceability.shs.
# That source is a claim list, not proof of renderer support.
val _WEB_CSS_NAMES: [text] = "accent-color align-content align-items align-self animation animation-delay animation-direction animation-duration animation-fill-mode animation-iteration-count animation-name animation-play-state animation-timing-function aspect-ratio backface-visibility background background-attachment background-blend-mode background-clip background-color background-image background-origin background-position background-repeat background-size block-size border border-block border-block-color border-block-end border-block-end-color border-block-end-style border-block-end-width border-block-start border-block-start-color border-block-start-style border-block-start-width border-block-style border-block-width border-bottom border-bottom-color border-bottom-left-radius border-bottom-right-radius border-bottom-style border-bottom-width border-collapse border-color border-end-end-radius border-end-start-radius border-inline border-inline-color border-inline-end border-inline-end-color border-inline-end-style border-inline-end-width border-inline-start border-inline-start-color border-inline-start-style border-inline-start-width border-inline-style border-inline-width border-left border-left-color border-left-style border-left-width border-radius border-right border-right-color border-right-style border-right-width border-spacing border-start-end-radius border-start-start-radius border-style border-top border-top-color border-top-left-radius border-top-right-radius border-top-style border-top-width border-width bottom box-shadow box-sizing caption-side caret-color clear clip clip-path color color-adjust color-scheme column-count column-gap column-rule column-rule-color column-rule-style column-rule-width column-width columns contain content content-visibility cursor direction display empty-cells filter flex flex-basis flex-direction flex-flow flex-grow flex-shrink flex-wrap float font font-family font-feature-settings font-kerning font-language-override font-optical-sizing font-palette font-size font-size-adjust font-stretch font-style font-synthesis font-synthesis-position font-synthesis-small-caps font-synthesis-style font-synthesis-weight font-variant font-variant-alternates font-variant-caps font-variant-east-asian font-variant-emoji font-variant-ligatures font-variant-numeric font-variant-position font-variation-settings font-weight font-width forced-color-adjust gap grid grid-area grid-auto-flow grid-column grid-column-gap grid-column-start grid-gap grid-row grid-row-gap grid-row-start grid-template grid-template-areas grid-template-columns grid-template-rows height hyphens image-rendering inline-size inset inset-block inset-block-end inset-block-start inset-inline inset-inline-end inset-inline-start justify-content justify-items justify-self left letter-spacing line-break line-height list-style list-style-image list-style-position list-style-type margin margin-block margin-block-end margin-block-start margin-bottom margin-inline margin-inline-end margin-inline-start margin-left margin-right margin-top max-block-size max-height max-inline-size max-width min-block-size min-height min-inline-size min-width object-fit object-position opacity order orphans outline outline-color outline-offset outline-style outline-width overflow overflow-wrap overflow-x overflow-y padding padding-block padding-block-end padding-block-start padding-bottom padding-inline padding-inline-end padding-inline-start padding-left padding-right padding-top place-content place-items place-self position print-color-adjust quotes resize right rotate row-gap scale scrollbar-color scrollbar-width tab-size table-layout text-align text-align-all text-align-last text-combine-upright text-decoration text-decoration-color text-decoration-line text-decoration-style text-decoration-thickness text-emphasis text-emphasis-color text-emphasis-position text-emphasis-style text-indent text-justify text-orientation text-overflow text-shadow text-transform text-underline-offset text-underline-position top transform transform-box transform-origin transform-style transition transition-delay transition-duration transition-property transition-timing-function translate unicode-bidi vertical-align visibility white-space widows width will-change word-break word-spacing word-wrap writing-mode z-index".split(" ")

# Logical declarations lower into existing physical layout/paint fields.
val _WEB_CSS_ADDITIONAL_LAYOUT: text = "aspect-ratio block-size border-collapse border-spacing caption-side content-visibility empty-cells flex-flow float grid-area grid-auto-flow grid-column grid-row grid-template-areas grid-template-columns grid-template-rows inline-size inset inset-block inset-block-end inset-block-start inset-inline inset-inline-end inset-inline-start margin-block margin-block-end margin-block-start margin-inline margin-inline-end margin-inline-start max-block-size max-inline-size min-block-size min-inline-size padding-block padding-block-end padding-block-start padding-inline padding-inline-end padding-inline-start place-content place-items place-self table-layout vertical-align writing-mode"

# These are retained declaration/Draw IR metadata in this renderer, without a
# verified pixel effect. Nonpaint does not claim CSS behavior is implemented.
val _WEB_CSS_METADATA_ONLY: text = "color-adjust forced-color-adjust print-color-adjust orphans widows will-change font-feature-settings font-kerning font-language-override font-optical-sizing font-palette font-size-adjust font-stretch font-synthesis font-synthesis-position font-synthesis-small-caps font-synthesis-style font-synthesis-weight font-variant font-variant-alternates font-variant-caps font-variant-east-asian font-variant-emoji font-variant-ligatures font-variant-numeric font-variant-position font-variation-settings font-width hyphens image-rendering line-break text-combine-upright text-justify text-orientation"

fn _web_name_in(name: text, names: text) -> bool:
    (" " + names + " ").contains(" " + name + " ")

fn _html_status(name: text) -> text:
    if _web_name_in(name, "area base col head link meta script source style template title track"):
        return WEB_NONPAINT
    if _web_name_in(name, "embed iframe object selectedcontent"):
        return WEB_UNSUPPORTED
    if _web_name_in(name, "audio button canvas datalist details dialog fieldset form img input label map meter noscript optgroup option output picture progress ruby rp rt select slot table tbody td textarea tfoot th thead tr video"):
        return WEB_PARTIAL
    WEB_RENDERABLE

fn _html_owner(status: text) -> text:
    if status == WEB_RENDERABLE:
        return "simple_web_html_layout_renderer.spl"
    if status == WEB_PARTIAL:
        return "simple_web_html_layout_renderer_paint_layout.spl"
    if status == WEB_NONPAINT:
        return "html_tree_builder.spl"
    "none"

fn _html_tab(name: text) -> text:
    if _web_name_in(name, "audio button canvas datalist dialog embed fieldset form iframe img input label map meter object optgroup option output picture progress select selectedcontent source textarea track video"):
        return "forms-media"
    "html"

fn _css_status(name: text) -> text:
    if _web_name_in(name, "cursor resize"):
        return WEB_NONPAINT
    if _web_name_in(name, _WEB_CSS_METADATA_ONLY):
        return WEB_NONPAINT
    if _web_name_in(name, "caret-color tab-size transform-box transform-style unicode-bidi"):
        return WEB_UNSUPPORTED
    if _web_name_in(name, _WEB_CSS_ADDITIONAL_LAYOUT):
        return WEB_PARTIAL
    if name.starts_with("border-block") or name.starts_with("border-inline"):
        return WEB_PARTIAL
    if _web_name_in(name, "accent-color background-attachment border-end-end-radius border-end-start-radius border-start-end-radius border-start-start-radius clip color-scheme contain filter font-family list-style list-style-type object-fit object-position rotate scale scrollbar-color scrollbar-width text-align-all translate"):
        return WEB_PARTIAL
    if name.starts_with("animation") or name.starts_with("transition"):
        return WEB_PARTIAL
    if _web_name_in(name, "align-content align-items align-self background background-clip background-image background-origin background-position background-repeat background-size border border-bottom border-bottom-style border-color border-left border-left-style border-right border-right-style border-style border-top border-top-style border-width box-sizing direction display flex flex-basis flex-direction flex-grow flex-shrink flex-wrap font gap justify-content opacity order outline overflow overflow-wrap overflow-x overflow-y position text-align-last text-decoration text-decoration-line text-decoration-style text-decoration-thickness text-indent text-overflow text-shadow text-transform text-underline-offset text-underline-position transform transform-origin visibility white-space word-break word-wrap z-index"):
        return WEB_PARTIAL
    if _web_name_in(name, "background-color border-bottom-color border-bottom-width border-left-color border-left-width border-right-color border-right-width border-top-color border-top-width border-radius border-bottom-left-radius border-bottom-right-radius border-top-left-radius border-top-right-radius bottom box-shadow color column-gap font-size font-style font-weight height left letter-spacing line-height margin margin-bottom margin-left margin-right margin-top max-height max-width min-height min-width outline-color outline-offset outline-style outline-width padding padding-bottom padding-left padding-right padding-top right row-gap text-align text-decoration-color top width word-spacing"):
        return WEB_RENDERABLE
    # New names require explicit ownership evidence before a support promotion.
    WEB_UNSUPPORTED

fn _css_value_family(name: text) -> text:
    if name.starts_with("grid"):
        return "grid-tracks-placement"
    if name == "aspect-ratio":
        return "ratio-auto"
    if name.starts_with("animation") or name.starts_with("transition"):
        return "time-and-keyword"
    if name.contains("color") or name == "color":
        return "color"
    if name.starts_with("background"):
        return "color-image-position-size"
    if name.starts_with("border") or name.starts_with("outline"):
        return "width-style-color-radius"
    if _web_name_in(name, "height width min-height min-width max-height max-width top right bottom left margin margin-top margin-right margin-bottom margin-left padding padding-top padding-right padding-bottom padding-left gap row-gap column-gap letter-spacing line-height text-indent word-spacing"):
        return "length-percentage-auto"
    if name.starts_with("transform"):
        return "transform-list"
    if name.starts_with("font"):
        return "font"
    "keyword-number"

fn _css_owner(name: text, status: text) -> text:
    if status == WEB_UNSUPPORTED:
        return "none"
    if status == WEB_NONPAINT:
        return "simple_web_html_layout_renderer_decl_apply.spl"
    if name.starts_with("border-block") or name.starts_with("border-inline"):
        return "simple_web_html_layout_renderer_decl_apply.spl"
    if _web_name_in(name, "border-end-end-radius border-end-start-radius border-start-end-radius border-start-start-radius"):
        return "simple_web_css_box_effects.spl"
    if _web_name_in(name, _WEB_CSS_ADDITIONAL_LAYOUT):
        return "simple_web_html_layout_renderer_layout.spl"
    if _web_name_in(name, "clip color-scheme contain filter rotate scale text-align-all translate"):
        return "simple_web_html_layout_renderer_decl_apply.spl"
    if name.starts_with("animation") or name.starts_with("transition") or name.starts_with("transform"):
        return "simple_web_html_layout_renderer.spl"
    if _web_name_in(name, "display flex flex-basis flex-direction flex-grow flex-shrink flex-wrap gap row-gap column-gap align-content align-items align-self justify-content order position top right bottom left width height min-width min-height max-width max-height margin margin-top margin-right margin-bottom margin-left padding padding-top padding-right padding-bottom padding-left box-sizing overflow overflow-x overflow-y"):
        return "simple_web_html_layout_renderer_layout.spl"
    "simple_web_html_layout_renderer_paint_layout.spl"

fn _css_tab(name: text) -> text:
    if name.starts_with("animation") or name.starts_with("transition") or name.starts_with("transform") or _web_name_in(name, "backface-visibility rotate scale translate"):
        return "animation"
    if _web_name_in(name, _WEB_CSS_ADDITIONAL_LAYOUT) or name.starts_with("grid") or name.starts_with("column") or _web_name_in(name, "clear content justify-items justify-self list-style list-style-image list-style-position list-style-type orphans quotes widows"):
        return "css-layout"
    if _web_name_in(name, "display flex flex-basis flex-direction flex-grow flex-shrink flex-wrap gap row-gap column-gap align-content align-items align-self justify-content order position top right bottom left width height min-width min-height max-width max-height margin margin-top margin-right margin-bottom margin-left padding padding-top padding-right padding-bottom padding-left box-sizing overflow overflow-x overflow-y"):
        return "css-layout"
    "css-paint"

fn _web_html_rows() -> [WebRenderableFeatureRow]:
    var rows: [WebRenderableFeatureRow] = []
    for name in _WEB_HTML_NAMES:
        val status = _html_status(name)
        val test_owner = if status == WEB_UNSUPPORTED: "web_renderable_feature_inventory_contract_spec.spl" else: "simple_web_generated_html_css_combinations_spec.spl"
        rows.push(WebRenderableFeatureRow(
            id: "html:" + name,
            kind: WEB_FEATURE_HTML,
            name: name,
            value_family: "element",
            status: status,
            production_owner: _html_owner(status),
            test_owner: test_owner,
            showcase_tab: _html_tab(name)
        ))
    rows

fn _web_css_rows() -> [WebRenderableFeatureRow]:
    var rows: [WebRenderableFeatureRow] = []
    for name in _WEB_CSS_NAMES:
        val status = _css_status(name)
        val test_owner = if status == WEB_UNSUPPORTED: "simple_web_css_inventory_traceability_spec.spl" else: "simple_web_generated_html_css_combinations_spec.spl"
        rows.push(WebRenderableFeatureRow(
            id: "css:" + name,
            kind: WEB_FEATURE_CSS,
            name: name,
            value_family: _css_value_family(name),
            status: status,
            production_owner: _css_owner(name, status),
            test_owner: test_owner,
            showcase_tab: _css_tab(name)
        ))
    rows

pub fn web_renderable_feature_inventory() -> WebRenderableFeatureInventory:
    var rows = _web_html_rows()
    for row in _web_css_rows():
        rows.push(row)
    WebRenderableFeatureInventory(version: "web-renderable-feature-inventory-v1", rows: rows)

pub fn web_renderable_rows_for_kind(inventory: WebRenderableFeatureInventory, kind: text) -> [WebRenderableFeatureRow]:
    [for row in inventory.rows if row.kind == kind: row]

pub fn web_renderable_rows_for_status(inventory: WebRenderableFeatureInventory, status: text) -> [WebRenderableFeatureRow]:
    [for row in inventory.rows if row.status == status: row]

pub fn web_renderable_rows_for_tab(inventory: WebRenderableFeatureInventory, tab: text) -> [WebRenderableFeatureRow]:
    [for row in inventory.rows if row.showcase_tab == tab: row]

pub fn web_renderable_count_kind(inventory: WebRenderableFeatureInventory, kind: text) -> i32:
    web_renderable_rows_for_kind(inventory, kind).len()

pub fn web_renderable_count_status(inventory: WebRenderableFeatureInventory, status: text) -> i32:
    web_renderable_rows_for_status(inventory, status).len()

pub fn web_renderable_count_tab(inventory: WebRenderableFeatureInventory, tab: text) -> i32:
    web_renderable_rows_for_tab(inventory, tab).len()

pub fn web_renderable_find(inventory: WebRenderableFeatureInventory, kind: text, name: text) -> WebRenderableFeatureRow?:
    for row in inventory.rows:
        if row.kind == kind and row.name == name:
            return row
    nil

pub fn web_renderable_feature_inventory_markup(inventory: WebRenderableFeatureInventory) -> text:
    var out = RtStringBuilder.new()
    out.push("<section id=\"feature-inventory\" data-inventory-version=\"")
    out.push(inventory.version)
    out.push("\"><h2>Renderable HTML and CSS inventory</h2><p>Every row is classified from production ownership; partial, nonpaint, and unsupported rows are not passing pixels.</p><ul>")
    for row in inventory.rows:
        out.push("<li data-feature-id=\"")
        out.push(row.id)
        out.push("\" data-kind=\"")
        out.push(row.kind)
        out.push("\" data-status=\"")
        out.push(row.status)
        out.push("\" data-showcase-tab=\"")
        out.push(row.showcase_tab)
        out.push("\"><code>")
        out.push(row.name)
        out.push("</code> — ")
        out.push(row.status)
        out.push("; values=")
        out.push(row.value_family)
        out.push("; owner=")
        out.push(row.production_owner)
        out.push("</li>")
    out.push("</ul></section>")
    out.finish()

# Build the inventory in the panel that owns the feature group.  The canonical
# page supplies the replacement slots; keeping the rows here prevents Chrome
# and Simple from silently drifting to separately-maintained catalogs.
pub fn web_renderable_feature_inventory_tab_markup(
    inventory: WebRenderableFeatureInventory, tab: text
) -> text:
    var out = RtStringBuilder.new()
    out.push("<section class=\"feature-inventory\" data-inventory-version=\"")
    out.push(inventory.version)
    out.push("\" data-inventory-tab=\"")
    out.push(tab)
    out.push("\"><h3>Feature examples and support</h3><p>Examples show selected values; pixel correctness is unverified. Partial, nonpaint, and unsupported features remain classified explicitly.</p><ul>")
    for row in inventory.rows:
        if row.showcase_tab == tab:
            out.push("<li data-feature-id=\"")
            out.push(row.id)
            out.push("\" data-kind=\"")
            out.push(row.kind)
            out.push("\" data-status=\"")
            out.push(row.status)
            out.push("\"><code>")
            out.push(row.name)
            out.push("</code> — ")
            out.push(row.status)
            out.push("; values=")
            out.push(row.value_family)
            out.push("; owner=")
            out.push(row.production_owner)
            out.push(web_feature_witness_markup(row.kind, row.name, row.status))
            out.push("</li>")
    out.push("</ul></section>")
    out.finish()

pub fn web_renderable_feature_inventory_apply_to_showcase(
    source: text, inventory: WebRenderableFeatureInventory
) -> text:
    var rendered = source.replace("<!-- simple-web-inventory:html -->",
        web_renderable_feature_inventory_tab_markup(inventory, "html"))
    rendered = rendered.replace("<!-- simple-web-inventory:forms-media -->",
        web_renderable_feature_inventory_tab_markup(inventory, "forms-media"))
    rendered = rendered.replace("<!-- simple-web-inventory:css-layout -->",
        web_renderable_feature_inventory_tab_markup(inventory, "css-layout"))
    rendered = rendered.replace("<!-- simple-web-inventory:css-paint -->",
        web_renderable_feature_inventory_tab_markup(inventory, "css-paint"))
    rendered = rendered.replace("<!-- simple-web-inventory:animation -->",
        web_renderable_feature_inventory_tab_markup(inventory, "animation"))
    rendered
