# Browser layout invalidation frontier construction.

use std.common.structural.invalidation.contracts.{
    DIRTY_INTRINSIC_MEASURE, DIRTY_LAYOUT, DIRTY_HIT_TEST, DIRTY_RESOURCE
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.contracts.{
    StyleDifference, WebLayoutMutationKind, WebLayoutChange,
    WebLayoutDirtyNode, WebLayoutFrontier
}

val WEB_DIRTY_GEOMETRY: i64 = DIRTY_LAYOUT | DIRTY_HIT_TEST
val WEB_DIRTY_INTRINSIC: i64 = (
    DIRTY_INTRINSIC_MEASURE | DIRTY_LAYOUT | DIRTY_HIT_TEST
)
val WEB_DIRTY_FONT_RESOURCE: i64 = WEB_DIRTY_INTRINSIC | DIRTY_RESOURCE

fn _web_layout_merge_dirty(
    nodes: [WebLayoutDirtyNode], id: i64, dirty_bits: i64
) -> [WebLayoutDirtyNode]:
    if id <= 0 or dirty_bits == 0:
        return nodes
    var merged = nodes
    var index = 0
    while index < merged.len():
        if merged[index].id == id:
            merged[index] = WebLayoutDirtyNode(
                id: id,
                dirty_bits: merged[index].dirty_bits | dirty_bits
            )
            return merged
        index = index + 1
    merged.push(WebLayoutDirtyNode(id: id, dirty_bits: dirty_bits))
    merged

fn _web_layout_merge_many(
    nodes: [WebLayoutDirtyNode], ids: [i64], dirty_bits: i64
) -> [WebLayoutDirtyNode]:
    var merged = nodes
    for id in ids:
        merged = _web_layout_merge_dirty(merged, id, dirty_bits)
    merged

fn _web_layout_style_frontier(
    nodes: [WebLayoutDirtyNode], change: WebLayoutChange
) -> [WebLayoutDirtyNode]:
    var merged = nodes
    match change.difference:
        StyleDifference.NoChange: return merged
        StyleDifference.InheritedOnly: return merged
        StyleDifference.PaintOnly: return merged
        StyleDifference.CompositeOnly: return merged
        StyleDifference.IntrinsicMeasure:
            merged = _web_layout_merge_dirty(
                merged, change.node_id, WEB_DIRTY_INTRINSIC
            )
            merged = _web_layout_merge_dirty(
                merged, change.containing_context_id, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_many(
                merged, change.line_box_ids, WEB_DIRTY_INTRINSIC
            )
            merged = _web_layout_merge_many(
                merged, change.intrinsic_ancestor_ids, WEB_DIRTY_INTRINSIC
            )
        StyleDifference.LayoutSelf:
            merged = _web_layout_merge_dirty(
                merged, change.node_id, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_dirty(
                merged, change.containing_context_id, WEB_DIRTY_GEOMETRY
            )
        StyleDifference.LayoutSubtree:
            merged = _web_layout_merge_dirty(
                merged, change.node_id, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_many(
                merged, change.subtree_ids, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_dirty(
                merged, change.containing_context_id, WEB_DIRTY_GEOMETRY
            )
        StyleDifference.RebuildFormattingContext:
            merged = _web_layout_merge_dirty(
                merged, change.node_id, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_many(
                merged, change.subtree_ids, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_dirty(
                merged, change.containing_context_id, WEB_DIRTY_GEOMETRY
            )
    merged

fn _web_layout_change_frontier(
    nodes: [WebLayoutDirtyNode], change: WebLayoutChange
) -> [WebLayoutDirtyNode]:
    var merged = nodes
    match change.kind:
        WebLayoutMutationKind.Style:
            merged = _web_layout_style_frontier(merged, change)
        WebLayoutMutationKind.Insert:
            merged = _web_layout_merge_many(
                merged, change.inserted_ids, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_dirty(
                merged, change.containing_context_id, WEB_DIRTY_GEOMETRY
            )
            merged = _web_layout_merge_many(
                merged, change.downstream_sibling_ids, WEB_DIRTY_GEOMETRY
            )
        WebLayoutMutationKind.FontResource:
            merged = _web_layout_merge_many(
                merged, change.font_metric_ids, WEB_DIRTY_FONT_RESOURCE
            )
            merged = _web_layout_merge_many(
                merged, change.line_box_ids, WEB_DIRTY_INTRINSIC
            )
            merged = _web_layout_merge_many(
                merged, change.intrinsic_ancestor_ids,
                WEB_DIRTY_INTRINSIC
            )
        WebLayoutMutationKind.Viewport:
            merged = _web_layout_merge_many(
                merged, change.viewport_geometry_ids, WEB_DIRTY_GEOMETRY
            )
    merged

fn web_layout_dirty_frontier(
    changes: [WebLayoutChange]
) -> WebLayoutFrontier:
    var dirty_nodes: [WebLayoutDirtyNode] = []
    for change in changes:
        dirty_nodes = _web_layout_change_frontier(dirty_nodes, change)
    var invalidated_ids: [i64] = []
    for node in dirty_nodes:
        invalidated_ids.push(node.id)
    WebLayoutFrontier(
        dirty_nodes: dirty_nodes,
        invalidated_ids: invalidated_ids,
        fault: ""
    )

export web_layout_dirty_frontier
