# Browser layout invalidation frontier construction.

use std.common.structural.invalidation.contracts.{
    DIRTY_INTRINSIC_MEASURE, DIRTY_LAYOUT, DIRTY_HIT_TEST, DIRTY_RESOURCE
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.contracts.{
    StyleDifference, WebLayoutMutationKind, WebLayoutChange,
    WebLayoutDirtyNode, WebLayoutFrontier
}

val WEB_DIRTY_GEOMETRY: i64 = DIRTY_LAYOUT | DIRTY_HIT_TEST
val WEB_DIRTY_INTRINSIC: i64 = (
    DIRTY_INTRINSIC_MEASURE | DIRTY_LAYOUT | DIRTY_HIT_TEST
)
val WEB_DIRTY_FONT_RESOURCE: i64 = WEB_DIRTY_INTRINSIC | DIRTY_RESOURCE

class _WebLayoutDirtyMerge:
    # The frontier's external ordering is first occurrence order.  The index
    # removes the former O(unique_nodes) scan for every merged dependency.
    nodes: [WebLayoutDirtyNode]
    index_by_id: Dict<i64, i64>

    static fn create() -> _WebLayoutDirtyMerge:
        _WebLayoutDirtyMerge(nodes: [], index_by_id: {})

    me merge(id: i64, dirty_bits: i64):
        if id <= 0 or dirty_bits == 0:
            return
        val existing = self.index_by_id.get(id)
        if val Some(index) = existing:
            val node = self.nodes[index]
            self.nodes[index] = WebLayoutDirtyNode(
                id: id, dirty_bits: node.dirty_bits | dirty_bits
            )
            return
        val index = self.nodes.len()
        self.nodes.push(WebLayoutDirtyNode(id: id, dirty_bits: dirty_bits))
        self.index_by_id[id] = index

    me merge_many(ids: [i64], dirty_bits: i64):
        for id in ids:
            self.merge(id, dirty_bits)

fn _web_layout_style_frontier(
    merged: _WebLayoutDirtyMerge, change: WebLayoutChange
):
    match change.difference:
        StyleDifference.NoChange: return
        StyleDifference.InheritedOnly: return
        StyleDifference.PaintOnly: return
        StyleDifference.CompositeOnly: return
        StyleDifference.IntrinsicMeasure:
            merged.merge(change.node_id, WEB_DIRTY_INTRINSIC)
            merged.merge(change.containing_context_id, WEB_DIRTY_GEOMETRY)
            merged.merge_many(change.line_box_ids, WEB_DIRTY_INTRINSIC)
            merged.merge_many(change.intrinsic_ancestor_ids, WEB_DIRTY_INTRINSIC)
        StyleDifference.LayoutSelf:
            merged.merge(change.node_id, WEB_DIRTY_GEOMETRY)
            merged.merge(change.containing_context_id, WEB_DIRTY_GEOMETRY)
        StyleDifference.LayoutSubtree:
            merged.merge(change.node_id, WEB_DIRTY_GEOMETRY)
            merged.merge_many(change.subtree_ids, WEB_DIRTY_GEOMETRY)
            merged.merge(change.containing_context_id, WEB_DIRTY_GEOMETRY)
        StyleDifference.RebuildFormattingContext:
            merged.merge(change.node_id, WEB_DIRTY_GEOMETRY)
            merged.merge_many(change.subtree_ids, WEB_DIRTY_GEOMETRY)
            merged.merge(change.containing_context_id, WEB_DIRTY_GEOMETRY)

fn _web_layout_change_frontier(
    merged: _WebLayoutDirtyMerge, change: WebLayoutChange
):
    match change.kind:
        WebLayoutMutationKind.StyleMutation:
            _web_layout_style_frontier(merged, change)
        WebLayoutMutationKind.Insert:
            merged.merge_many(change.inserted_ids, WEB_DIRTY_GEOMETRY)
            merged.merge(change.containing_context_id, WEB_DIRTY_GEOMETRY)
            merged.merge_many(change.downstream_sibling_ids, WEB_DIRTY_GEOMETRY)
        WebLayoutMutationKind.FontResource:
            merged.merge_many(change.font_metric_ids, WEB_DIRTY_FONT_RESOURCE)
            merged.merge_many(change.line_box_ids, WEB_DIRTY_INTRINSIC)
            merged.merge_many(change.intrinsic_ancestor_ids, WEB_DIRTY_INTRINSIC)
        WebLayoutMutationKind.Viewport:
            merged.merge_many(change.viewport_geometry_ids, WEB_DIRTY_GEOMETRY)

fn web_layout_dirty_frontier(
    changes: [WebLayoutChange]
) -> WebLayoutFrontier:
    val merged = _WebLayoutDirtyMerge.create()
    for change in changes:
        _web_layout_change_frontier(merged, change)
    var invalidated_ids: [i64] = []
    for node in merged.nodes:
        invalidated_ids.push(node.id)
    WebLayoutFrontier(
        dirty_nodes: merged.nodes,
        invalidated_ids: invalidated_ids,
        fault: ""
    )

export web_layout_dirty_frontier
