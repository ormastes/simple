# Stateful browser coordinator that delegates layout work to the shared framework.

use std.common.structural.layout.{
    LayoutSnapshot,
    layout_input,
    layout_run_full,
    layout_run_incremental,
    layout_text_measure_port_unavailable
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.adapter.{
    web_layout_framework_input,
    web_layout_validate_snapshot
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.contracts.*

val WEB_LAYOUT_MAX_EPOCH: i64 = 9223372036854775807

struct WebLayoutManagerStep:
    manager: WebLayoutManager
    result: WebLayoutRunResult

fn _web_layout_empty_layout(snapshot: WebLayoutSnapshot) -> LayoutSnapshot:
    layout_run_full(
        layout_input([], [], [], snapshot.execution, snapshot.fixed_point_cap),
        layout_text_measure_port_unavailable()
    )

fn _web_layout_fault_step(
    manager: WebLayoutManager,
    snapshot: WebLayoutSnapshot,
    stale: bool,
    fault: text
) -> WebLayoutManagerStep:
    WebLayoutManagerStep(
        manager: manager,
        result: WebLayoutRunResult(
            generation: snapshot.generation,
            epoch: manager.epoch,
            layout: _web_layout_empty_layout(snapshot),
            hit_regions: [],
            stale: stale,
            fault: fault
        )
    )

fn _web_layout_dom_route(snapshot: WebLayoutSnapshot, structural_id: i64) -> i64:
    for node in snapshot.nodes:
        if node.id == structural_id:
            return node.dom_route_id
    0

fn _web_layout_hit_regions(
    snapshot: WebLayoutSnapshot,
    layout: LayoutSnapshot,
    epoch: i64
) -> [WebLayoutHitRegion]:
    var regions: [WebLayoutHitRegion] = []
    for box in layout.boxes:
        regions.push(WebLayoutHitRegion(
            generation: snapshot.generation,
            epoch: epoch,
            structural_id: box.id,
            dom_route_id: _web_layout_dom_route(snapshot, box.id),
            box: box
        ))
    regions

fn _web_layout_run(
    manager: WebLayoutManager,
    snapshot: WebLayoutSnapshot,
    frontier: WebLayoutFrontier,
    incremental: bool
) -> WebLayoutManagerStep:
    if snapshot.generation != manager.generation:
        return _web_layout_fault_step(manager, snapshot, true, "stale-dom-generation")
    if frontier.fault != "":
        return _web_layout_fault_step(manager, snapshot, false, frontier.fault)
    val validation_fault = web_layout_validate_snapshot(snapshot)
    if validation_fault != "":
        return _web_layout_fault_step(manager, snapshot, false, validation_fault)
    if manager.epoch == WEB_LAYOUT_MAX_EPOCH:
        return _web_layout_fault_step(manager, snapshot, false, "epoch-exhausted")

    val input = web_layout_framework_input(snapshot, frontier)
    val layout = if incremental:
        layout_run_incremental(input, layout_text_measure_port_unavailable())
    else:
        layout_run_full(input, layout_text_measure_port_unavailable())
    if layout.fault != "":
        return _web_layout_fault_step(manager, snapshot, false, layout.fault)

    val next_epoch = manager.epoch + 1
    val next_manager = WebLayoutManager(generation: manager.generation, epoch: next_epoch)
    WebLayoutManagerStep(
        manager: next_manager,
        result: WebLayoutRunResult(
            generation: snapshot.generation,
            epoch: next_epoch,
            layout: layout,
            hit_regions: _web_layout_hit_regions(snapshot, layout, next_epoch),
            stale: false,
            fault: ""
        )
    )

fn web_layout_run_full(
    manager: WebLayoutManager,
    snapshot: WebLayoutSnapshot,
    frontier: WebLayoutFrontier
) -> WebLayoutManagerStep:
    _web_layout_run(manager, snapshot, frontier, false)

fn web_layout_run_incremental(
    manager: WebLayoutManager,
    snapshot: WebLayoutSnapshot,
    frontier: WebLayoutFrontier
) -> WebLayoutManagerStep:
    _web_layout_run(manager, snapshot, frontier, true)

export WEB_LAYOUT_MAX_EPOCH, WebLayoutManagerStep
export web_layout_run_full, web_layout_run_incremental

