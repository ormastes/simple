"""CUDA execution port for the first exact browser layout slice."""

use std.common.structural.layout.{
    LAYOUT_LENGTH_AUTO,
    LAYOUT_LENGTH_PX,
    LAYOUT_OVERFLOW_AUTO,
    LAYOUT_OVERFLOW_SCROLL,
    LAYOUT_OVERFLOW_VISIBLE,
    LAYOUT_POSITION_ABSOLUTE,
    LAYOUT_POSITION_STATIC,
    LayoutBox,
    LayoutExecutionPort,
    LayoutExecutionProof,
    LayoutExecutionRequest,
    LayoutFragment,
    LayoutIterationResult,
    LayoutLineBox,
    LayoutLength,
    LayoutNodeInput,
    LayoutOverflow,
    layout_box,
    layout_fragment,
    layout_overflow
}
use std.gc_async_mut.cuda.{
    CUDA_SUCCESS, cuda_memcpy_dtoh, cuda_memcpy_htod
}
use std.gc_async_mut.gpu.engine2d.cuda_session.{CudaSession}
use std.nogc_sync_mut.ptr.raw.{
    raw_alloc, raw_free, raw_read_i32, raw_write_i64,
    raw_write_u32s_checksum
}

val WEB_CUDA_LAYOUT_BLOCK_SIZE: i64 = 256
val WEB_CUDA_LAYOUT_INPUT_WORDS: i64 = 13
val WEB_CUDA_LAYOUT_OUTPUT_WORDS: i64 = 5
val WEB_CUDA_LAYOUT_OVERFLOW_WORDS: i64 = 7
val WEB_CUDA_LAYOUT_ARG_BYTES: i64 = 40

class CudaLayoutExecutionPort:
    oracle_boxes: [LayoutBox]

fn _web_cuda_layout_ptx() -> text:
    ".version 7.0\n.target sm_52\n.address_size 64\n\n.visible .entry web_layout_fixed_children(\n    .param .u64 input,\n    .param .u64 tracks,\n    .param .u64 output,\n    .param .u32 count\n) {\n    .reg .pred %p<8>;\n    .reg .b32 %r<32>;\n    .reg .b64 %rd<12>;\n    mov.u32 %r0, %ctaid.x;\n    mov.u32 %r1, %ntid.x;\n    mov.u32 %r2, %tid.x;\n    mad.lo.u32 %r3, %r0, %r1, %r2;\n    ld.param.u32 %r4, [count];\n    setp.ge.u32 %p0, %r3, %r4;\n    @%p0 bra done;\n    ld.param.u64 %rd0, [input];\n    ld.param.u64 %rd1, [tracks];\n    ld.param.u64 %rd2, [output];\n    mul.wide.u32 %rd3, %r3, 52;\n    add.u64 %rd4, %rd0, %rd3;\n    ld.global.u32 %r5, [%rd4];\n    ld.global.u32 %r6, [%rd4+4];\n    ld.global.u32 %r7, [%rd4+8];\n    ld.global.u32 %r8, [%rd4+12];\n    ld.global.u32 %r9, [%rd4+16];\n    mov.u32 %r20, 0;\n    mov.u32 %r21, 0;\n    mov.u32 %r22, %r8;\n    mov.u32 %r23, %r9;\n    setp.eq.u32 %p1, %r6, 0;\n    @%p1 bra store;\n    setp.eq.u32 %p2, %r7, 4;\n    @%p2 bra grid;\n    mov.u32 %r10, 0;\nsibling_loop:\n    setp.ge.u32 %p3, %r10, %r3;\n    @%p3 bra store;\n    mul.wide.u32 %rd5, %r10, 52;\n    add.u64 %rd6, %rd0, %rd5;\n    ld.global.u32 %r11, [%rd6+4];\n    setp.ne.u32 %p4, %r11, %r6;\n    @%p4 bra sibling_next;\n    setp.eq.u32 %p5, %r7, 2;\n    @%p5 bra sibling_row;\n    ld.global.u32 %r12, [%rd6+16];\n    add.u32 %r21, %r21, %r12;\n    bra sibling_next;\nsibling_row:\n    ld.global.u32 %r12, [%rd6+12];\n    add.u32 %r20, %r20, %r12;\nsibling_next:\n    add.u32 %r10, %r10, 1;\n    bra sibling_loop;\ngrid:\n    ld.global.u32 %r13, [%rd4+20];\n    ld.global.u32 %r14, [%rd4+28];\n    ld.global.u32 %r15, [%rd4+36];\n    ld.global.u32 %r16, [%rd4+40];\n    ld.global.u32 %r17, [%rd4+44];\n    ld.global.u32 %r18, [%rd4+48];\n    mov.u32 %r22, 0;\n    mov.u32 %r23, 0;\n    mov.u32 %r10, 0;\ngrid_x_before:\n    setp.ge.u32 %p3, %r10, %r15;\n    @%p3 bra grid_x_span_start;\n    add.u32 %r19, %r13, %r10;\n    mul.wide.u32 %rd7, %r19, 4;\n    add.u64 %rd8, %rd1, %rd7;\n    ld.global.u32 %r24, [%rd8];\n    add.u32 %r20, %r20, %r24;\n    add.u32 %r10, %r10, 1;\n    bra grid_x_before;\ngrid_x_span_start:\n    mov.u32 %r10, 0;\ngrid_x_span:\n    setp.ge.u32 %p3, %r10, %r16;\n    @%p3 bra grid_y_before_start;\n    add.u32 %r19, %r13, %r15;\n    add.u32 %r19, %r19, %r10;\n    mul.wide.u32 %rd7, %r19, 4;\n    add.u64 %rd8, %rd1, %rd7;\n    ld.global.u32 %r24, [%rd8];\n    add.u32 %r22, %r22, %r24;\n    add.u32 %r10, %r10, 1;\n    bra grid_x_span;\ngrid_y_before_start:\n    mov.u32 %r10, 0;\ngrid_y_before:\n    setp.ge.u32 %p3, %r10, %r17;\n    @%p3 bra grid_y_span_start;\n    add.u32 %r19, %r14, %r10;\n    mul.wide.u32 %rd7, %r19, 4;\n    add.u64 %rd8, %rd1, %rd7;\n    ld.global.u32 %r24, [%rd8];\n    add.u32 %r21, %r21, %r24;\n    add.u32 %r10, %r10, 1;\n    bra grid_y_before;\ngrid_y_span_start:\n    mov.u32 %r10, 0;\ngrid_y_span:\n    setp.ge.u32 %p3, %r10, %r18;\n    @%p3 bra store;\n    add.u32 %r19, %r14, %r17;\n    add.u32 %r19, %r19, %r10;\n    mul.wide.u32 %rd7, %r19, 4;\n    add.u64 %rd8, %rd1, %rd7;\n    ld.global.u32 %r24, [%rd8];\n    add.u32 %r23, %r23, %r24;\n    add.u32 %r10, %r10, 1;\n    bra grid_y_span;\nstore:\n    mul.wide.u32 %rd9, %r3, 20;\n    add.u64 %rd10, %rd2, %rd9;\n    st.global.u32 [%rd10], %r5;\n    st.global.u32 [%rd10+4], %r20;\n    st.global.u32 [%rd10+8], %r21;\n    st.global.u32 [%rd10+12], %r22;\n    st.global.u32 [%rd10+16], %r23;\ndone:\n    ret;\n}\n"

fn _web_cuda_layout_artifact_ptx() -> text:
    "\n.visible .entry web_layout_absolute(\n    .param .u64 input,\n    .param .u64 output,\n    .param .u32 count\n) {\n    .reg .pred %p<8>;\n    .reg .b32 %r<32>;\n    .reg .b64 %rd<12>;\n    mov.u32 %r0, %ctaid.x;\n    mov.u32 %r1, %ntid.x;\n    mov.u32 %r2, %tid.x;\n    mad.lo.u32 %r3, %r0, %r1, %r2;\n    ld.param.u32 %r4, [count];\n    setp.ge.u32 %p0, %r3, %r4;\n    @%p0 bra abs_done;\n    ld.param.u64 %rd0, [input];\n    ld.param.u64 %rd1, [output];\n    mul.wide.u32 %rd2, %r3, 52;\n    add.u64 %rd3, %rd0, %rd2;\n    ld.global.u32 %r5, [%rd3+8];\n    setp.ne.u32 %p1, %r5, 5;\n    @%p1 bra abs_done;\n    ld.global.u32 %r6, [%rd3+4];\n    setp.eq.u32 %p2, %r6, 0;\n    @%p2 bra abs_done;\n    mov.u32 %r7, 0;\nabs_parent_loop:\n    setp.ge.u32 %p3, %r7, %r4;\n    @%p3 bra abs_done;\n    mul.wide.u32 %rd4, %r7, 52;\n    add.u64 %rd5, %rd0, %rd4;\n    ld.global.u32 %r8, [%rd5];\n    setp.eq.u32 %p4, %r8, %r6;\n    @%p4 bra abs_parent_found;\n    add.u32 %r7, %r7, 1;\n    bra abs_parent_loop;\nabs_parent_found:\n    mul.wide.u32 %rd6, %r7, 20;\n    add.u64 %rd7, %rd1, %rd6;\n    ld.global.s32 %r9, [%rd7+4];\n    ld.global.s32 %r10, [%rd7+8];\n    ld.global.s32 %r11, [%rd7+12];\n    ld.global.s32 %r12, [%rd7+16];\n    ld.global.s32 %r13, [%rd3+12];\n    ld.global.s32 %r14, [%rd3+16];\n    ld.global.s32 %r15, [%rd3+20];\n    ld.global.u32 %r16, [%rd3+24];\n    ld.global.s32 %r17, [%rd3+28];\n    ld.global.u32 %r18, [%rd3+32];\n    ld.global.s32 %r19, [%rd3+36];\n    ld.global.u32 %r20, [%rd3+40];\n    ld.global.s32 %r21, [%rd3+44];\n    ld.global.u32 %r22, [%rd3+48];\n    add.s32 %r23, %r9, %r15;\n    setp.eq.u32 %p5, %r20, 0;\n    @%p5 bra abs_y;\n    add.s32 %r23, %r9, %r11;\n    sub.s32 %r23, %r23, %r13;\n    sub.s32 %r23, %r23, %r19;\nabs_y:\n    add.s32 %r24, %r10, %r17;\n    setp.eq.u32 %p6, %r22, 0;\n    @%p6 bra abs_store;\n    add.s32 %r24, %r10, %r12;\n    sub.s32 %r24, %r24, %r14;\n    sub.s32 %r24, %r24, %r21;\nabs_store:\n    mul.wide.u32 %rd8, %r3, 20;\n    add.u64 %rd9, %rd1, %rd8;\n    st.global.s32 [%rd9+4], %r23;\n    st.global.s32 [%rd9+8], %r24;\nabs_done:\n    ret;\n}\n\n.visible .entry web_layout_overflow(\n    .param .u64 input,\n    .param .u64 output,\n    .param .u64 overflow,\n    .param .u32 count\n) {\n    .reg .pred %p<5>;\n    .reg .b32 %r<32>;\n    .reg .b64 %rd<12>;\n    mov.u32 %r0, %ctaid.x;\n    mov.u32 %r1, %ntid.x;\n    mov.u32 %r2, %tid.x;\n    mad.lo.u32 %r3, %r0, %r1, %r2;\n    ld.param.u32 %r4, [count];\n    setp.ge.u32 %p0, %r3, %r4;\n    @%p0 bra overflow_done;\n    ld.param.u64 %rd0, [input];\n    ld.param.u64 %rd1, [output];\n    ld.param.u64 %rd2, [overflow];\n    mul.wide.u32 %rd3, %r3, 20;\n    add.u64 %rd4, %rd1, %rd3;\n    ld.global.u32 %r5, [%rd4];\n    ld.global.s32 %r6, [%rd4+4];\n    ld.global.s32 %r7, [%rd4+8];\n    ld.global.s32 %r8, [%rd4+12];\n    ld.global.s32 %r9, [%rd4+16];\n    mov.s32 %r10, %r8;\n    mov.s32 %r11, %r9;\n    mov.u32 %r12, 0;\noverflow_child_loop:\n    setp.ge.u32 %p1, %r12, %r4;\n    @%p1 bra overflow_store;\n    mul.wide.u32 %rd5, %r12, 52;\n    add.u64 %rd6, %rd0, %rd5;\n    ld.global.u32 %r13, [%rd6+4];\n    setp.ne.u32 %p2, %r13, %r5;\n    @%p2 bra overflow_next;\n    mul.wide.u32 %rd7, %r12, 20;\n    add.u64 %rd8, %rd1, %rd7;\n    ld.global.s32 %r14, [%rd8+4];\n    ld.global.s32 %r15, [%rd8+8];\n    ld.global.s32 %r16, [%rd8+12];\n    ld.global.s32 %r17, [%rd8+16];\n    add.s32 %r18, %r14, %r16;\n    sub.s32 %r18, %r18, %r6;\n    add.s32 %r19, %r15, %r17;\n    sub.s32 %r19, %r19, %r7;\n    max.s32 %r10, %r10, %r18;\n    max.s32 %r11, %r11, %r19;\noverflow_next:\n    add.u32 %r12, %r12, 1;\n    bra overflow_child_loop;\noverflow_store:\n    mul.wide.u32 %rd9, %r3, 28;\n    add.u64 %rd10, %rd2, %rd9;\n    st.global.u32 [%rd10], %r5;\n    st.global.s32 [%rd10+4], %r6;\n    st.global.s32 [%rd10+8], %r7;\n    st.global.s32 [%rd10+12], %r8;\n    st.global.s32 [%rd10+16], %r9;\n    st.global.s32 [%rd10+20], %r10;\n    st.global.s32 [%rd10+24], %r11;\noverflow_done:\n    ret;\n}\n"

fn _web_cuda_layout_contains(values: [i64], value: i64) -> bool:
    for candidate in values:
        if candidate == value:
            return true
    false

fn _web_cuda_layout_selected(
    request: LayoutExecutionRequest, node_id: i64
) -> bool:
    for island in request.islands:
        if (
            _web_cuda_layout_contains(
                request.selected_island_ids, island.root_id
            ) and
            _web_cuda_layout_contains(island.node_ids, node_id)
        ):
            return true
    false

fn _web_cuda_layout_profile_supported(profile_id: text) -> bool:
    (profile_id == "block" or profile_id == "flex" or profile_id == "grid" or
        profile_id == "absolute-sticky" or profile_id == "scroll")

fn _web_cuda_layout_node_for(
    request: LayoutExecutionRequest, id: i64
) -> LayoutNodeInput:
    for node in request.input.nodes:
        if node.id == id:
            return node
    request.input.nodes[0]

fn _web_cuda_layout_profile_code(
    profile_id: text, direction: text
) -> i64:
    if profile_id == "block": return 1
    if profile_id == "flex": return if direction == "row": 2 else: 3
    if profile_id == "grid": return 4
    if profile_id == "absolute-sticky": return 5
    6

fn _web_cuda_layout_offset_supported(length: LayoutLength) -> bool:
    (length.unit == LAYOUT_LENGTH_AUTO or
        (length.unit == LAYOUT_LENGTH_PX and
            length.value >= 0 and length.value <= 2147483647))

fn _web_cuda_layout_absolute_supported(node: LayoutNodeInput) -> bool:
    val position = node.semantics.position
    if node.parent_id == 0:
        return position.kind == LAYOUT_POSITION_STATIC
    (position.kind == LAYOUT_POSITION_ABSOLUTE and
        _web_cuda_layout_offset_supported(position.left) and
        _web_cuda_layout_offset_supported(position.top) and
        _web_cuda_layout_offset_supported(position.right) and
        _web_cuda_layout_offset_supported(position.bottom) and
        (position.left.unit == LAYOUT_LENGTH_PX or position.right.unit == LAYOUT_LENGTH_PX) and
        (position.top.unit == LAYOUT_LENGTH_PX or position.bottom.unit == LAYOUT_LENGTH_PX))

fn _web_cuda_layout_scroll_supported(node: LayoutNodeInput) -> bool:
    val overflow = node.semantics.overflow
    if node.parent_id == 0:
        return (overflow.x == LAYOUT_OVERFLOW_VISIBLE and
            (overflow.y == LAYOUT_OVERFLOW_AUTO or overflow.y == LAYOUT_OVERFLOW_SCROLL))
    overflow.x == LAYOUT_OVERFLOW_VISIBLE and overflow.y == LAYOUT_OVERFLOW_VISIBLE

fn _web_cuda_layout_fixed_box_supported(node: LayoutNodeInput) -> bool:
    val box = node.semantics.box
    (box.width.unit == LAYOUT_LENGTH_PX and
     box.height.unit == LAYOUT_LENGTH_PX and
     box.width.value > 0 and box.height.value > 0 and
     box.width.value <= 2147483647 and box.height.value <= 2147483647 and
     box.min_width_px == 0 and box.max_width_px == 0 and
     box.min_height_px == 0 and box.max_height_px == 0 and
     not box.border_box and
     box.padding.left == 0 and box.padding.top == 0 and
     box.padding.right == 0 and box.padding.bottom == 0 and
     box.border.left == 0 and box.border.top == 0 and
     box.border.right == 0 and box.border.bottom == 0 and
     box.margin_left.unit == LAYOUT_LENGTH_PX and
     box.margin_top.unit == LAYOUT_LENGTH_PX and
     box.margin_right.unit == LAYOUT_LENGTH_PX and
     box.margin_bottom.unit == LAYOUT_LENGTH_PX and
     box.margin_left.value == 0 and box.margin_top.value == 0 and
     box.margin_right.value == 0 and box.margin_bottom.value == 0 and
     box.margin_auto_bits == 0 and box.gap_px == 0 and
     box.row_gap_px == 0 and box.column_gap_px == 0)

fn _web_cuda_layout_flex_supported(node: LayoutNodeInput) -> bool:
    val flex = node.semantics.flex
    if node.parent_id == 0:
        return ((flex.direction == "row" or flex.direction == "column") and
                flex.wrap == "nowrap" and
                flex.justify_content == "flex-start" and
                (flex.align_items == "flex-start" or
                 flex.align_items == "stretch") and
                not flex.direction_rtl)
    ((flex.align_self == "auto" or flex.align_self == "flex-start") and
     flex.grow == 0 and flex.shrink == 0 and flex.order == 0 and
     flex.basis.unit == LAYOUT_LENGTH_AUTO)

fn _web_cuda_layout_grid_root_supported(
    request: LayoutExecutionRequest, node: LayoutNodeInput
) -> bool:
    val grid = node.semantics.grid
    if (grid.column_track_count <= 0 or grid.row_track_count <= 0 or
        grid.column_track_start < 0 or grid.row_track_start < 0 or
        grid.column_track_start + grid.column_track_count > request.input.grid_tracks.len() or
        grid.row_track_start + grid.row_track_count > request.input.grid_tracks.len() or
        grid.align_items_authored):
        return false
    var index = grid.column_track_start
    while index < grid.column_track_start + grid.column_track_count:
        if request.input.grid_tracks[index] <= 0 or request.input.grid_tracks[index] > 2147483647:
            return false
        index = index + 1
    index = grid.row_track_start
    while index < grid.row_track_start + grid.row_track_count:
        if request.input.grid_tracks[index] <= 0 or request.input.grid_tracks[index] > 2147483647:
            return false
        index = index + 1
    true

fn _web_cuda_layout_grid_child_supported(
    parent: LayoutNodeInput, node: LayoutNodeInput
) -> bool:
    val grid = node.semantics.grid
    (grid.column_start >= 0 and grid.row_start >= 0 and
     grid.column_span > 0 and grid.row_span > 0 and
     grid.column_start + grid.column_span <= parent.semantics.grid.column_track_count and
     grid.row_start + grid.row_span <= parent.semantics.grid.row_track_count and
     not grid.align_items_authored)

fn _web_cuda_layout_admission_fault(
    request: LayoutExecutionRequest
) -> text:
    var profile = ""
    var selected_count: i64 = 0
    for island in request.islands:
        if _web_cuda_layout_contains(
            request.selected_island_ids, island.root_id
        ):
            if not _web_cuda_layout_profile_supported(island.profile_id):
                return "cuda-layout-profile-unsupported"
            if profile == "":
                profile = island.profile_id
            elif profile != island.profile_id:
                return "cuda-layout-batch-heterogeneous"
            if island.node_ids.len() == 0 or island.node_ids[0] != island.root_id:
                return "cuda-layout-node-order-unsupported"
            val root = _web_cuda_layout_node_for(request, island.root_id)
            if root.id != island.root_id or root.parent_id != 0:
                return "cuda-layout-root-missing"
            if island.node_ids.len() != root.semantics.child_count + 1:
                return "cuda-layout-child-count-mismatch"
            var child_index: i64 = 1
            var expected_child = root.semantics.first_child_id
            while child_index < island.node_ids.len():
                if island.node_ids[child_index] != expected_child:
                    return "cuda-layout-node-order-unsupported"
                val child = _web_cuda_layout_node_for(request, expected_child)
                expected_child = child.semantics.next_sibling_id
                child_index = child_index + 1
            if expected_child != 0:
                return "cuda-layout-node-order-unsupported"
            selected_count = selected_count + 1
    if selected_count == 0:
        return "cuda-layout-empty-selection"
    for node in request.input.nodes:
        if _web_cuda_layout_selected(request, node.id):
            if node.id <= 0 or node.id > 2147483647:
                return "cuda-layout-id-out-of-range"
            if node.semantics.gpu_admission_flags != 0:
                return "cuda-layout-semantic-pre-rejection"
            if not _web_cuda_layout_fixed_box_supported(node):
                return "cuda-layout-fixed-size-required"
            if node.parent_id == 0:
                var direct_children: i64 = 0
                for child in request.input.nodes:
                    if (_web_cuda_layout_selected(request, child.id) and
                        child.parent_id == node.id):
                        if child.semantics.child_count != 0:
                            return "cuda-layout-one-level-required"
                        direct_children = direct_children + 1
                if direct_children != node.semantics.child_count:
                    return "cuda-layout-child-count-mismatch"
                # A childless grid root is a fixed leaf: the kernel's root
                # path (parent_id == 0) stores its fixed box directly and
                # never reads grid tracks, so track validation only applies
                # when the root actually places children.
                if (profile == "grid" and node.semantics.child_count > 0 and
                    not _web_cuda_layout_grid_root_supported(request, node)):
                    return "cuda-layout-fixed-grid-required"
            else:
                val parent = _web_cuda_layout_node_for(request, node.parent_id)
                if parent.id != node.parent_id or parent.parent_id != 0:
                    return "cuda-layout-one-level-required"
                if profile == "grid" and not _web_cuda_layout_grid_child_supported(parent, node):
                    return "cuda-layout-explicit-grid-placement-required"
            if profile == "flex" and not _web_cuda_layout_flex_supported(node):
                return "cuda-layout-flex-feature-unsupported"
            if profile == "absolute-sticky" and not _web_cuda_layout_absolute_supported(node):
                return "cuda-layout-absolute-feature-unsupported"
            if profile == "scroll" and not _web_cuda_layout_scroll_supported(node):
                return "cuda-layout-overflow-feature-unsupported"
    ""

fn _web_cuda_layout_oracle_for(
    oracle_boxes: [LayoutBox], id: i64
) -> LayoutBox:
    for box in oracle_boxes:
        if box.id == id:
            return box
    layout_box(id, 0, 0, 0, 0)

fn _web_cuda_layout_boxes_equal(
    actual: [LayoutBox], oracle_boxes: [LayoutBox]
) -> bool:
    for box in actual:
        val oracle = _web_cuda_layout_oracle_for(oracle_boxes, box.id)
        if (
            box.id != oracle.id or box.x != oracle.x or
            box.y != oracle.y or box.width != oracle.width or
            box.height != oracle.height
        ):
            return false
    true

fn _web_cuda_layout_result(
    candidate: text,
    boxes: [LayoutBox],
    submitted: bool,
    synchronized: bool,
    readback: bool,
    verified: bool,
    fault: text,
    device_overflows: [LayoutOverflow] = []
) -> LayoutIterationResult:
    var fragments: [LayoutFragment] = []
    var overflows: [LayoutOverflow] = []
    var no_line_boxes: [LayoutLineBox] = []
    if fault == "":
        for box in boxes:
            fragments.push(layout_fragment(
                box.id, box.id, box, "principal", 0
            ))
        overflows = device_overflows
    LayoutIterationResult(
        boxes: boxes,
        fragments: fragments,
        line_boxes: no_line_boxes,
        overflows: overflows,
        proof: LayoutExecutionProof(
            candidate_backend: candidate,
            executed_backend: "hybrid_vector_gpu",
            executed: submitted,
            submitted: submitted,
            synchronized: synchronized,
            device_readback: readback,
            oracle_verified: verified,
            reason: fault
        ),
        fault: fault
    )

fn _web_cuda_layout_cleanup(
    session: CudaSession,
    device_input: i64,
    device_tracks: i64,
    device_output: i64,
    device_overflow: i64,
    host_input: i64,
    host_tracks: i64,
    host_output: i64,
    host_overflow: i64,
    values_ptr: i64,
    args_ptr: i64,
    input_bytes: i64,
    track_bytes: i64,
    output_bytes: i64,
    overflow_bytes: i64
):
    if device_input > 0: session.free(device_input)
    if device_tracks > 0: session.free(device_tracks)
    if device_output > 0: session.free(device_output)
    if device_overflow > 0: session.free(device_overflow)
    if host_input != 0: raw_free(host_input, input_bytes)
    if host_tracks != 0: raw_free(host_tracks, track_bytes)
    if host_output != 0: raw_free(host_output, output_bytes)
    if host_overflow != 0: raw_free(host_overflow, overflow_bytes)
    if values_ptr != 0: raw_free(values_ptr, WEB_CUDA_LAYOUT_ARG_BYTES)
    if args_ptr != 0: raw_free(args_ptr, WEB_CUDA_LAYOUT_ARG_BYTES)
    session.shutdown()

impl LayoutExecutionPort for CudaLayoutExecutionPort:
    fn backend_name() -> text:
        "hybrid_vector_gpu"

    fn execute(request: LayoutExecutionRequest) -> LayoutIterationResult:
        val admission_fault = _web_cuda_layout_admission_fault(request)
        if admission_fault != "":
            return _web_cuda_layout_result(
                request.candidate_backend, [], false, false, false, false,
                admission_fault
            )
        var packed: [u32] = []
        for node in request.input.nodes:
            if _web_cuda_layout_selected(request, node.id):
                val parent = if node.parent_id == 0:
                    node
                else:
                    _web_cuda_layout_node_for(request, node.parent_id)
                packed.push(node.id as u32)
                packed.push(node.parent_id as u32)
                packed.push(_web_cuda_layout_profile_code(
                    parent.profile_id, parent.semantics.flex.direction
                ) as u32)
                packed.push(node.semantics.box.width.value as u32)
                packed.push(node.semantics.box.height.value as u32)
                if parent.profile_id == "absolute-sticky":
                    val position = node.semantics.position
                    packed.push(position.left.value as u32)
                    packed.push(if position.left.unit == LAYOUT_LENGTH_PX: 1u32 else: 0u32)
                    packed.push(position.top.value as u32)
                    packed.push(if position.top.unit == LAYOUT_LENGTH_PX: 1u32 else: 0u32)
                    packed.push(position.right.value as u32)
                    packed.push(if position.right.unit == LAYOUT_LENGTH_PX: 1u32 else: 0u32)
                    packed.push(position.bottom.value as u32)
                    packed.push(if position.bottom.unit == LAYOUT_LENGTH_PX: 1u32 else: 0u32)
                else:
                    packed.push(parent.semantics.grid.column_track_start as u32)
                    packed.push(parent.semantics.grid.column_track_count as u32)
                    packed.push(parent.semantics.grid.row_track_start as u32)
                    packed.push(parent.semantics.grid.row_track_count as u32)
                    packed.push(node.semantics.grid.column_start as u32)
                    packed.push(node.semantics.grid.column_span as u32)
                    packed.push(node.semantics.grid.row_start as u32)
                    packed.push(node.semantics.grid.row_span as u32)
        val count = packed.len().to_i64() / WEB_CUDA_LAYOUT_INPUT_WORDS
        val input_bytes = packed.len().to_i64() * 4
        var packed_tracks: [u32] = []
        for track in request.input.grid_tracks:
            packed_tracks.push(track as u32)
        if packed_tracks.len() == 0:
            packed_tracks.push(0)
        val track_bytes = packed_tracks.len().to_i64() * 4
        val output_bytes = count * WEB_CUDA_LAYOUT_OUTPUT_WORDS * 4
        val overflow_bytes = count * WEB_CUDA_LAYOUT_OVERFLOW_WORDS * 4
        var session = CudaSession.create()
        if session.init() != CUDA_SUCCESS or session.activate() != CUDA_SUCCESS:
            session.shutdown()
            return _web_cuda_layout_result(
                request.candidate_backend, [], false, false, false, false,
                "cuda-layout-init-failed"
            )
        if session.load_module(_web_cuda_layout_ptx() + _web_cuda_layout_artifact_ptx()) <= 0:
            session.shutdown()
            return _web_cuda_layout_result(
                request.candidate_backend, [], false, false, false, false,
                "cuda-layout-module-load-failed"
            )
        val device_input = session.alloc(input_bytes)
        val device_tracks = session.alloc(track_bytes)
        val device_output = session.alloc(output_bytes)
        val device_overflow = session.alloc(overflow_bytes)
        val host_input = raw_alloc(input_bytes)
        val host_tracks = raw_alloc(track_bytes)
        val host_output = raw_alloc(output_bytes)
        val host_overflow = raw_alloc(overflow_bytes)
        val values_ptr = raw_alloc(WEB_CUDA_LAYOUT_ARG_BYTES)
        val args_ptr = raw_alloc(WEB_CUDA_LAYOUT_ARG_BYTES)
        if (
            device_input <= 0 or device_tracks <= 0 or device_output <= 0 or device_overflow <= 0 or
            host_input == 0 or host_tracks == 0 or host_output == 0 or host_overflow == 0 or
            values_ptr == 0 or args_ptr == 0
        ):
            _web_cuda_layout_cleanup(
                session, device_input, device_tracks, device_output, device_overflow,
                host_input, host_tracks, host_output, host_overflow, values_ptr, args_ptr,
                input_bytes, track_bytes, output_bytes, overflow_bytes
            )
            return _web_cuda_layout_result(
                request.candidate_backend, [], false, false, false, false,
                "cuda-layout-allocation-failed"
            )
        raw_write_u32s_checksum(host_input, packed, packed.len().to_i64())
        raw_write_u32s_checksum(
            host_tracks, packed_tracks, packed_tracks.len().to_i64()
        )
        val uploaded = (
            cuda_memcpy_htod(device_input, host_input, input_bytes) ==
            CUDA_SUCCESS and
            cuda_memcpy_htod(device_tracks, host_tracks, track_bytes) ==
            CUDA_SUCCESS
        )
        raw_write_i64(values_ptr, 0, device_input)
        raw_write_i64(values_ptr, 8, device_tracks)
        raw_write_i64(values_ptr, 16, device_output)
        raw_write_i64(values_ptr, 24, count)
        raw_write_i64(args_ptr, 0, values_ptr)
        raw_write_i64(args_ptr, 8, values_ptr + 8)
        raw_write_i64(args_ptr, 16, values_ptr + 16)
        raw_write_i64(args_ptr, 24, values_ptr + 24)
        val geometry_submitted = uploaded and session.launch_kernel_args(
            "web_layout_fixed_children",
            (count + WEB_CUDA_LAYOUT_BLOCK_SIZE - 1) /
                WEB_CUDA_LAYOUT_BLOCK_SIZE,
            1, 1, WEB_CUDA_LAYOUT_BLOCK_SIZE, 1, 1, args_ptr
        ) == CUDA_SUCCESS
        raw_write_i64(args_ptr, 0, values_ptr)
        raw_write_i64(args_ptr, 8, values_ptr + 16)
        raw_write_i64(args_ptr, 16, values_ptr + 24)
        val absolute_submitted = geometry_submitted and session.launch_kernel_args(
            "web_layout_absolute",
            (count + WEB_CUDA_LAYOUT_BLOCK_SIZE - 1) /
                WEB_CUDA_LAYOUT_BLOCK_SIZE,
            1, 1, WEB_CUDA_LAYOUT_BLOCK_SIZE, 1, 1, args_ptr
        ) == CUDA_SUCCESS
        raw_write_i64(values_ptr, 32, device_overflow)
        raw_write_i64(args_ptr, 0, values_ptr)
        raw_write_i64(args_ptr, 8, values_ptr + 16)
        raw_write_i64(args_ptr, 16, values_ptr + 32)
        raw_write_i64(args_ptr, 24, values_ptr + 24)
        val submitted = absolute_submitted and session.launch_kernel_args(
            "web_layout_overflow",
            (count + WEB_CUDA_LAYOUT_BLOCK_SIZE - 1) /
                WEB_CUDA_LAYOUT_BLOCK_SIZE,
            1, 1, WEB_CUDA_LAYOUT_BLOCK_SIZE, 1, 1, args_ptr
        ) == CUDA_SUCCESS
        val synchronized = submitted and session.sync() == CUDA_SUCCESS
        val readback = (synchronized and
            cuda_memcpy_dtoh(host_output, device_output, output_bytes) == CUDA_SUCCESS and
            cuda_memcpy_dtoh(host_overflow, device_overflow, overflow_bytes) == CUDA_SUCCESS)
        var boxes: [LayoutBox] = []
        var overflows: [LayoutOverflow] = []
        if readback:
            var index: i64 = 0
            while index < count:
                val offset = index * WEB_CUDA_LAYOUT_OUTPUT_WORDS * 4
                boxes.push(layout_box(
                    raw_read_i32(host_output, offset) as i64,
                    raw_read_i32(host_output, offset + 4) as i64,
                    raw_read_i32(host_output, offset + 8) as i64,
                    raw_read_i32(host_output, offset + 12) as i64,
                    raw_read_i32(host_output, offset + 16) as i64
                ))
                val overflow_offset = index * WEB_CUDA_LAYOUT_OVERFLOW_WORDS * 4
                overflows.push(layout_overflow(
                    raw_read_i32(host_overflow, overflow_offset) as i64,
                    layout_box(
                        raw_read_i32(host_overflow, overflow_offset) as i64,
                        raw_read_i32(host_overflow, overflow_offset + 4) as i64,
                        raw_read_i32(host_overflow, overflow_offset + 8) as i64,
                        raw_read_i32(host_overflow, overflow_offset + 12) as i64,
                        raw_read_i32(host_overflow, overflow_offset + 16) as i64
                    ),
                    raw_read_i32(host_overflow, overflow_offset + 20) as i64,
                    raw_read_i32(host_overflow, overflow_offset + 24) as i64
                ))
                index = index + 1
        val verified = readback and _web_cuda_layout_boxes_equal(
            boxes, self.oracle_boxes
        )
        _web_cuda_layout_cleanup(
            session, device_input, device_tracks, device_output, device_overflow,
            host_input, host_tracks, host_output, host_overflow, values_ptr, args_ptr,
            input_bytes, track_bytes, output_bytes, overflow_bytes
        )
        val fault = if not uploaded:
            "cuda-layout-upload-failed"
        elif not submitted:
            "cuda-layout-submit-failed"
        elif not synchronized:
            "cuda-layout-sync-failed"
        elif not readback:
            "cuda-layout-readback-failed"
        elif not verified:
            "cuda-layout-oracle-mismatch"
        else:
            ""
        _web_cuda_layout_result(
            request.candidate_backend, boxes, submitted, synchronized,
            readback, verified, fault, overflows
        )

fn web_cuda_layout_execution_port(
    oracle_boxes: [LayoutBox]
) -> CudaLayoutExecutionPort:
    CudaLayoutExecutionPort(oracle_boxes: oracle_boxes)

export CudaLayoutExecutionPort, web_cuda_layout_execution_port
