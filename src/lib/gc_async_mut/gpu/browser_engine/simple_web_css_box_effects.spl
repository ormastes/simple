# Pure CSS border-radius and box-shadow parsing for the Simple web renderer.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.*

const CSS_INTEGER_PX_INVALID: i32 = -1000001
const CSS_INTEGER_PX_ABS_MAX: i32 = 1000000

pub class CssCornerRadii:
    valid: bool
    top_left_px: i32
    top_right_px: i32
    bottom_right_px: i32
    bottom_left_px: i32

pub class WebBoxShadowLayer:
    kind: text
    offset_x_px: i32
    offset_y_px: i32
    blur_radius_px: i32
    spread_radius_px: i32
    color_rgba: u32

pub class WebBoxShadowParseResult:
    valid: bool
    layers: [WebBoxShadowLayer]

fn _css_integer_px_token(token: text, allow_negative: bool) -> i32:
    val value = token.trim().lower()
    if value == "":
        return CSS_INTEGER_PX_INVALID
    var digit_end = value.len()
    if value.ends_with("px"):
        digit_end = digit_end - 2
    elif value != "0" and value != "-0":
        return CSS_INTEGER_PX_INVALID
    var index = 0
    var sign = 1
    if index < digit_end and value.char_at(index) == "-":
        if not allow_negative:
            return CSS_INTEGER_PX_INVALID
        sign = -1
        index = index + 1
    if index >= digit_end:
        return CSS_INTEGER_PX_INVALID
    var number = 0
    while index < digit_end:
        val digit = dec_val(value.char_at(index))
        if digit >= 10:
            return CSS_INTEGER_PX_INVALID
        if number > (CSS_INTEGER_PX_ABS_MAX - digit) / 10:
            return CSS_INTEGER_PX_INVALID
        number = number * 10 + digit
        index = index + 1
    number * sign

fn _css_top_level_space_tokens(value: text) -> [text]:
    var tokens: [text] = []
    var depth = 0
    var start = 0
    var index = 0
    while index < value.len():
        val ch = value.char_at(index)
        if ch == "(":
            depth = depth + 1
        elif ch == ")" and depth > 0:
            depth = depth - 1
        elif (
            depth == 0 and
            (ch == " " or ch == "\t" or ch == "\n" or ch == "\r")
        ):
            val token = value.substring(start, index).trim()
            if token != "":
                tokens.push(token)
            start = index + 1
        index = index + 1
    val final_token = value.substring(start, value.len()).trim()
    if final_token != "":
        tokens.push(final_token)
    tokens

pub fn parse_border_radius_shorthand(value: text) -> CssCornerRadii:
    val normalized = value.trim().lower()
    if normalized == "" or normalized.contains("/"):
        return CssCornerRadii(
            valid: false, top_left_px: 0, top_right_px: 0,
            bottom_right_px: 0, bottom_left_px: 0)
    val tokens = _css_top_level_space_tokens(normalized)
    if tokens.len() < 1 or tokens.len() > 4:
        return CssCornerRadii(
            valid: false, top_left_px: 0, top_right_px: 0,
            bottom_right_px: 0, bottom_left_px: 0)
    var values: [i32] = []
    var index = 0
    while index < tokens.len():
        val parsed = _css_integer_px_token(tokens[index], false)
        if parsed < 0:
            return CssCornerRadii(
                valid: false, top_left_px: 0, top_right_px: 0,
                bottom_right_px: 0, bottom_left_px: 0)
        values.push(parsed)
        index = index + 1
    var top_left = values[0]
    var top_right = values[0]
    var bottom_right = values[0]
    var bottom_left = values[0]
    if values.len() == 2:
        top_right = values[1]
        bottom_left = values[1]
    elif values.len() == 3:
        top_right = values[1]
        bottom_left = values[1]
        bottom_right = values[2]
    elif values.len() == 4:
        top_right = values[1]
        bottom_right = values[2]
        bottom_left = values[3]
    CssCornerRadii(
        valid: true, top_left_px: top_left, top_right_px: top_right,
        bottom_right_px: bottom_right, bottom_left_px: bottom_left)

fn _parse_border_radius_longhand(value: text) -> CssCornerRadii:
    if _css_top_level_space_tokens(value.trim().lower()).len() != 1:
        return CssCornerRadii(
            valid: false, top_left_px: 0, top_right_px: 0,
            bottom_right_px: 0, bottom_left_px: 0)
    parse_border_radius_shorthand(value)

pub fn resolve_authored_border_radii(
    decl_tbl: [text], current_top_left: i32, current_top_right: i32,
    current_bottom_right: i32, current_bottom_left: i32
) -> CssCornerRadii:
    var resolved = CssCornerRadii(
        valid: false, top_left_px: current_top_left,
        top_right_px: current_top_right,
        bottom_right_px: current_bottom_right,
        bottom_left_px: current_bottom_left)
    var top_left_pos = -1
    var top_right_pos = -1
    var bottom_right_pos = -1
    var bottom_left_pos = -1

    val shorthand_pos = decl_tbl_last_index(decl_tbl, "border-radius")
    val shorthand = parse_border_radius_shorthand(
        decl_tbl_get(decl_tbl, "border-radius"))
    if shorthand_pos >= 0 and shorthand.valid:
        resolved.valid = true
        resolved.top_left_px = shorthand.top_left_px
        resolved.top_right_px = shorthand.top_right_px
        resolved.bottom_right_px = shorthand.bottom_right_px
        resolved.bottom_left_px = shorthand.bottom_left_px
        top_left_pos = shorthand_pos
        top_right_pos = shorthand_pos
        bottom_right_pos = shorthand_pos
        bottom_left_pos = shorthand_pos

    val physical_top_left_pos = decl_tbl_last_index(
        decl_tbl, "border-top-left-radius")
    val physical_top_left = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-top-left-radius"))
    if physical_top_left.valid and physical_top_left_pos > top_left_pos:
        resolved.valid = true
        resolved.top_left_px = physical_top_left.top_left_px
        top_left_pos = physical_top_left_pos
    val logical_top_left_pos = decl_tbl_last_index(
        decl_tbl, "border-start-start-radius")
    val logical_top_left = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-start-start-radius"))
    if logical_top_left.valid and logical_top_left_pos > top_left_pos:
        resolved.valid = true
        resolved.top_left_px = logical_top_left.top_left_px

    val physical_top_right_pos = decl_tbl_last_index(
        decl_tbl, "border-top-right-radius")
    val physical_top_right = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-top-right-radius"))
    if physical_top_right.valid and physical_top_right_pos > top_right_pos:
        resolved.valid = true
        resolved.top_right_px = physical_top_right.top_left_px
        top_right_pos = physical_top_right_pos
    val logical_top_right_pos = decl_tbl_last_index(
        decl_tbl, "border-start-end-radius")
    val logical_top_right = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-start-end-radius"))
    if logical_top_right.valid and logical_top_right_pos > top_right_pos:
        resolved.valid = true
        resolved.top_right_px = logical_top_right.top_left_px

    val physical_bottom_right_pos = decl_tbl_last_index(
        decl_tbl, "border-bottom-right-radius")
    val physical_bottom_right = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-bottom-right-radius"))
    if (
        physical_bottom_right.valid and
        physical_bottom_right_pos > bottom_right_pos
    ):
        resolved.valid = true
        resolved.bottom_right_px = physical_bottom_right.top_left_px
        bottom_right_pos = physical_bottom_right_pos
    val logical_bottom_right_pos = decl_tbl_last_index(
        decl_tbl, "border-end-end-radius")
    val logical_bottom_right = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-end-end-radius"))
    if (
        logical_bottom_right.valid and
        logical_bottom_right_pos > bottom_right_pos
    ):
        resolved.valid = true
        resolved.bottom_right_px = logical_bottom_right.top_left_px

    val physical_bottom_left_pos = decl_tbl_last_index(
        decl_tbl, "border-bottom-left-radius")
    val physical_bottom_left = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-bottom-left-radius"))
    if (
        physical_bottom_left.valid and
        physical_bottom_left_pos > bottom_left_pos
    ):
        resolved.valid = true
        resolved.bottom_left_px = physical_bottom_left.top_left_px
        bottom_left_pos = physical_bottom_left_pos
    val logical_bottom_left_pos = decl_tbl_last_index(
        decl_tbl, "border-end-start-radius")
    val logical_bottom_left = _parse_border_radius_longhand(
        decl_tbl_get(decl_tbl, "border-end-start-radius"))
    if (
        logical_bottom_left.valid and
        logical_bottom_left_pos > bottom_left_pos
    ):
        resolved.valid = true
        resolved.bottom_left_px = logical_bottom_left.top_left_px
    resolved

fn _css_effects_split_top_level_commas(value: text) -> [text]:
    var parts: [text] = []
    var depth = 0
    var start = 0
    var index = 0
    while index < value.len():
        val ch = value.char_at(index)
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            if depth > 0:
                depth = depth - 1
        elif ch == "," and depth == 0:
            if parts.len() >= 24:
                return []
            parts.push(value.substring(start, index))
            start = index + 1
        index = index + 1
    if parts.len() >= 24:
        return []
    parts.push(value.substring(start, value.len()))
    parts

fn _box_shadow_value_is_balanced_and_bounded(value: text) -> bool:
    var depth = 0
    var layer_count = 1
    var index = 0
    while index < value.len():
        val ch = value.char_at(index)
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            if depth == 0:
                return false
            depth = depth - 1
        elif ch == "," and depth == 0:
            layer_count = layer_count + 1
            if layer_count > 24:
                return false
        index = index + 1
    depth == 0

fn _box_shadow_is_hex_digit(ch: text) -> bool:
    (
        (ch >= "0" and ch <= "9") or
        (ch >= "a" and ch <= "f") or
        (ch >= "A" and ch <= "F")
    )

fn _box_shadow_hex_color(token: text) -> (bool, u32):
    val length = token.len()
    if length != 4 and length != 5 and length != 7 and length != 9:
        return (false, 0u32)
    var index = 1
    while index < length:
        if not _box_shadow_is_hex_digit(token.char_at(index)):
            return (false, 0u32)
        index = index + 1
    var red = 0
    var green = 0
    var blue = 0
    var alpha = 255
    if length == 4 or length == 5:
        red = hex_val(token.char_at(1)) * 17
        green = hex_val(token.char_at(2)) * 17
        blue = hex_val(token.char_at(3)) * 17
        if length == 5:
            alpha = hex_val(token.char_at(4)) * 17
    else:
        red = hex_val(token.char_at(1)) * 16 + hex_val(token.char_at(2))
        green = hex_val(token.char_at(3)) * 16 + hex_val(token.char_at(4))
        blue = hex_val(token.char_at(5)) * 16 + hex_val(token.char_at(6))
        if length == 9:
            alpha = hex_val(token.char_at(7)) * 16 + hex_val(token.char_at(8))
    val color = (
        (alpha.to_u32() << 24) | (red.to_u32() << 16) |
        (green.to_u32() << 8) | blue.to_u32()
    )
    (true, color)

fn _box_shadow_decimal_component(
    token: text, maximum: i32
) -> (bool, i32):
    val normalized = token.trim()
    if normalized == "":
        return (false, 0)
    var number = 0
    var index = 0
    while index < normalized.len():
        val digit = dec_val(normalized.char_at(index))
        if digit >= 10:
            return (false, 0)
        if number > (maximum - digit) / 10:
            return (false, 0)
        number = number * 10 + digit
        index = index + 1
    (true, number)

fn _box_shadow_alpha_component(token: text) -> (bool, i32):
    val normalized = token.trim()
    if normalized == "0":
        return (true, 0)
    if normalized == "1":
        return (true, 255)
    var dot = -1
    var one_prefix = false
    if normalized.starts_with("0."):
        dot = 1
    elif normalized.starts_with("1."):
        dot = 1
        one_prefix = true
    elif normalized.starts_with("."):
        dot = 0
    else:
        return (false, 0)
    val fractional_start = dot + 1
    val fractional_digits = normalized.len() - fractional_start
    if fractional_digits < 1 or fractional_digits > 3:
        return (false, 0)
    var numerator = 0
    var denominator = 1
    var index = fractional_start
    while index < normalized.len():
        val digit = dec_val(normalized.char_at(index))
        if digit >= 10:
            return (false, 0)
        if one_prefix and digit != 0:
            return (false, 0)
        numerator = numerator * 10 + digit
        denominator = denominator * 10
        index = index + 1
    if one_prefix:
        return (true, 255)
    (true, (numerator * 255 + denominator / 2) / denominator)

fn _box_shadow_rgb_color(token: text, with_alpha: bool) -> (bool, u32):
    val prefix_length = if with_alpha: 5 else: 4
    if token.len() <= prefix_length or not token.ends_with(")"):
        return (false, 0u32)
    val inner = token.substring(prefix_length, token.len() - 1)
    val components = _css_effects_split_top_level_commas(inner)
    val expected = if with_alpha: 4 else: 3
    if components.len() != expected:
        return (false, 0u32)
    val (red_valid, red) = _box_shadow_decimal_component(
        components[0], 255)
    val (green_valid, green) = _box_shadow_decimal_component(
        components[1], 255)
    val (blue_valid, blue) = _box_shadow_decimal_component(
        components[2], 255)
    if not red_valid or not green_valid or not blue_valid:
        return (false, 0u32)
    var alpha = 255
    if with_alpha:
        val (alpha_valid, parsed_alpha) = _box_shadow_alpha_component(
            components[3])
        if not alpha_valid:
            return (false, 0u32)
        alpha = parsed_alpha
    val color = (
        (alpha.to_u32() << 24) | (red.to_u32() << 16) |
        (green.to_u32() << 8) | blue.to_u32()
    )
    (true, color)

fn _box_shadow_token_color(
    token: text, current_color: u32
) -> (bool, u32):
    val normalized = token.trim().lower()
    if normalized == "currentcolor":
        return (true, current_color)
    if normalized == "transparent":
        return (true, 0u32)
    if normalized.starts_with("#"):
        return _box_shadow_hex_color(normalized)
    if normalized.starts_with("rgba("):
        return _box_shadow_rgb_color(normalized, true)
    if normalized.starts_with("rgb("):
        return _box_shadow_rgb_color(normalized, false)
    if (
        normalized == "black" or normalized == "white" or
        normalized == "red"
    ):
        return (true, parse_color_alpha(normalized))
    (false, 0u32)

pub fn parse_box_shadow_layers(
    value: text, current_color: u32
) -> WebBoxShadowParseResult:
    val normalized = value.trim().lower()
    if normalized == "" or normalized == "none":
        return WebBoxShadowParseResult(valid: true, layers: [])
    if not _box_shadow_value_is_balanced_and_bounded(normalized):
        return WebBoxShadowParseResult(valid: false, layers: [])
    val authored_layers = _css_effects_split_top_level_commas(normalized)
    if authored_layers.len() == 0:
        return WebBoxShadowParseResult(valid: false, layers: [])
    var parsed_layers: [WebBoxShadowLayer] = []
    var layer_index = 0
    while layer_index < authored_layers.len():
        val layer = authored_layers[layer_index].trim()
        if layer == "":
            return WebBoxShadowParseResult(valid: false, layers: [])
        val tokens = _css_top_level_space_tokens(layer)
        var lengths: [i32] = []
        var kind = "outer"
        var saw_inset = false
        var saw_color = false
        var color = current_color
        var token_index = 0
        while token_index < tokens.len():
            val token = tokens[token_index]
            if token == "inset":
                if saw_inset:
                    return WebBoxShadowParseResult(valid: false, layers: [])
                kind = "inset"
                saw_inset = true
            else:
                val (is_color, parsed_color) = _box_shadow_token_color(
                    token, current_color)
                if is_color:
                    if saw_color:
                        return WebBoxShadowParseResult(
                            valid: false, layers: [])
                    color = parsed_color
                    saw_color = true
                else:
                    val length = _css_integer_px_token(token, true)
                    if (
                        length == CSS_INTEGER_PX_INVALID or
                        lengths.len() >= 4
                    ):
                        return WebBoxShadowParseResult(
                            valid: false, layers: [])
                    lengths.push(length)
            token_index = token_index + 1
        if lengths.len() < 2:
            return WebBoxShadowParseResult(valid: false, layers: [])
        val blur = if lengths.len() >= 3: lengths[2] else: 0
        if blur < 0:
            return WebBoxShadowParseResult(valid: false, layers: [])
        val spread = if lengths.len() >= 4: lengths[3] else: 0
        parsed_layers.push(WebBoxShadowLayer(
            kind: kind, offset_x_px: lengths[0], offset_y_px: lengths[1],
            blur_radius_px: blur, spread_radius_px: spread,
            color_rgba: color))
        layer_index = layer_index + 1
    WebBoxShadowParseResult(valid: true, layers: parsed_layers)
