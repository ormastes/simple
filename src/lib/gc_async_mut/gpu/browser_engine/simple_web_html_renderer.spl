# A second `pub fn simple_web_render_html_to_pixels` used to live at the bottom
# of this file, returning an all-white stub framebuffer. It collided with the
# real declaration in simple_web_renderer.spl (co-compiled, same bare name) and
# was a fail-open sabotage trap: a BINDMARK probe that changed the stub's fill
# to 0xFF00FF00 and rendered `background:#3050a0` at 8x4 got px0=4281356448
# (the real rendered blue) from BOTH `use ...simple_web_renderer` AND from
# `pixels_for_html` in THIS file -- never 4278255360. Sabotaging that
# declaration had literally no effect on any call site, so any spec targeting
# it proved nothing. It is deleted; the import below makes the surviving
# binding explicit instead of leaving it to bare-name resolution.
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels}

class SimpleWebHtmlPixelCache:
    width: i32
    height: i32
    last_html: text
    last_pixels: [u32]
    hits: i32
    stores: i32

impl SimpleWebHtmlPixelCache:
    static fn create(width: i32, height: i32) -> SimpleWebHtmlPixelCache:
        SimpleWebHtmlPixelCache(
            width: width,
            height: height,
            last_html: "",
            last_pixels: [],
            hits: 0,
            stores: 0
        )

    me pixels_for_html(html: text) -> [u32]:
        if html == self.last_html and self.last_pixels.len() == self.width * self.height:
            self.hits = self.hits + 1
            return self.last_pixels
        val pixels = simple_web_render_html_to_pixels(html, self.width, self.height)
        self.last_html = html
        self.last_pixels = pixels
        self.stores = self.stores + 1
        pixels
