            # A fixed box is sized against the viewport, its containing block.
            val absolute_containing_h = if cst.position_fixed and viewport_h > 0: viewport_h else: content_height_limit + st.pad_t + st.pad_b
            val absolute_containing_w = absolute_containing_width(st, cst, iw, viewport_w)
