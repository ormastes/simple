            # i.e. the flow cursor after the pending sibling margin. ponytail:
            # block flow only; an inline run and position:fixed keep the old y.
            val static_y = cst.top_auto and cst.bottom_px < 0 and not cst.position_fixed and not in_inline_run
            val ay = if static_y: cy + cursor_advance_px(cy_frac, prev_margin_b) + absolute_margin_t(style_with_resolved_percent_margins(cst, iw + st.pad_l + st.pad_r, 0)) else: absolute_child_y(nodes, styles, c, y, st, nodes[c], style_with_resolved_percent_margins(cst, iw + st.pad_l + st.pad_r, 0), absolute_containing_h, viewport_h)
            var absolute_w = absolute_outer_width(nodes, styles, child_index, c, st, nodes[c], cst, absolute_containing_w)
            var resolved_cst = absolute_child_style(st, cst, absolute_containing_w, absolute_containing_h, nodes[c].tag)
