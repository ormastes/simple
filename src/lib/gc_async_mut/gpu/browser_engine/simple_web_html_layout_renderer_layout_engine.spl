                val float_y = float_ctx_place_y(float_min_y, float_outer_w, cst.clear_mode, ix, ix + iw)
                val float_x = if cst.float_mode == 1:
                    float_ctx_left_edge(float_y, float_y + 1, ix) + fml
                else:
                    float_ctx_right_edge(float_y, float_y + 1, ix + iw) - fmr - float_w
                val fchild = layout_with_style(nodes, styles, child_index, c, float_x, float_y + fmt, float_w, viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, float_style)
                out_bx = fchild.bx
                out_by = fchild.by
                out_bw = fchild.bw
                out_bh = fchild.bh
                out_wrap_starts = fchild.wrap_starts
                out_wrap_ends = fchild.wrap_ends
                out_intrinsic_widths = fchild.intrinsic_widths
