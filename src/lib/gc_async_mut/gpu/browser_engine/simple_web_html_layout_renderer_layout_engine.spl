# --- Float context (CSS 2.2 section 9.5) -----------------------------------
# Every placed float's MARGIN box, in page coordinates, in placement order.
# `g_float_base` is the first float that belongs to the block formatting
# context being laid out: a box that establishes a new context neither sees
# the floats outside it nor leaks its own (`layout_with_style` scopes the
# list). A zero-height float is recorded but shortens no line box.
var g_float_side: [i32] = []
var g_float_x0: [i32] = []
var g_float_x1: [i32] = []
var g_float_y0: [i32] = []
var g_float_y1: [i32] = []
var g_float_base: i32 = 0
# Lowest float bottom in the current context slice (smallest i32 when it has
# no float): every query returns at once for a row at or below it, so text
# below the floats costs nothing however many floats there are.
var g_float_max_y1: i32 = -2147483648

# Start fraction hand-off (milli-px, in [-500, 500)): a container's own y is the
# ROUNDED cursor, so true y = y*1000 + frac. The caller stores the fraction here
# right before layout_with_style; layout_with_style_flow reads and clears it at
# entry, so it can only reach the box it was set for.
var g_origin_frac_milli: i32 = 0

fn float_ctx_reset():
    g_float_side = []
    g_float_x0 = []
    g_float_x1 = []
    g_float_y0 = []
    g_float_y1 = []
    g_float_base = 0
    g_float_max_y1 = -2147483648

fn float_ctx_count() -> i32:
    g_float_side.len() as i32

fn float_ctx_add(side: i32, x0: i32, x1: i32, y0: i32, y1: i32):
    g_float_side = g_float_side.push(side)
    g_float_x0 = g_float_x0.push(x0)
    g_float_x1 = g_float_x1.push(x1)
    g_float_y0 = g_float_y0.push(y0)
    g_float_y1 = g_float_y1.push(y1)
    if y1 > g_float_max_y1:
        g_float_max_y1 = y1

# Drop every float from index `n` on (leaving a formatting context).
fn float_ctx_truncate(n: i32):
    if n >= float_ctx_count():
        return
    var side: [i32] = []
    var x0: [i32] = []
    var x1: [i32] = []
    var y0: [i32] = []
    var y1: [i32] = []
    var k = 0
    while k < n:
        side = side.push(g_float_side[k])
        x0 = x0.push(g_float_x0[k])
        x1 = x1.push(g_float_x1[k])
        y0 = y0.push(g_float_y0[k])
        y1 = y1.push(g_float_y1[k])
        k = k + 1
    g_float_side = side
    g_float_x0 = x0
    g_float_x1 = x1
    g_float_y0 = y0
    g_float_y1 = y1

# Move the floats placed since `from` with the subtree that holds them.
fn float_ctx_shift(from: i32, dx: i32, dy: i32):
    var k = if from > g_float_base: from else: g_float_base
    val n = float_ctx_count()
    while k < n:
        g_float_x0[k] = g_float_x0[k] + dx
        g_float_x1[k] = g_float_x1[k] + dx
        g_float_y0[k] = g_float_y0[k] + dy
        g_float_y1[k] = g_float_y1[k] + dy
        k = k + 1
    float_ctx_refresh_max()

# Left edge available to a box spanning [y, y_end) whose containing block
# starts at `cb_left`: the rightmost margin edge of the left floats beside it.
fn float_ctx_left_edge(y: i32, y_end: i32, cb_left: i32) -> i32:
    if y >= g_float_max_y1:
        return cb_left
    var edge = cb_left
    var k = g_float_base
    val n = float_ctx_count()
    while k < n:
        if g_float_side[k] == 1 and g_float_y0[k] < y_end and g_float_y1[k] > y and g_float_x1[k] > edge:
            edge = g_float_x1[k]
        k = k + 1
    edge

fn float_ctx_right_edge(y: i32, y_end: i32, cb_right: i32) -> i32:
    if y >= g_float_max_y1:
        return cb_right
    var edge = cb_right
    var k = g_float_base
    val n = float_ctx_count()
    while k < n:
        if g_float_side[k] == 2 and g_float_y0[k] < y_end and g_float_y1[k] > y and g_float_x0[k] < edge:
            edge = g_float_x0[k]
        k = k + 1
    edge

# Nearest float bottom below `y` among the floats beside the row at `y`: the
# next y at which the available width can change. Returns `y` when no float
# is beside the row.
fn float_ctx_next_bottom(y: i32) -> i32:
    if y >= g_float_max_y1:
        return y
    var best = y
    var k = g_float_base
    val n = float_ctx_count()
    while k < n:
        if g_float_y0[k] <= y and g_float_y1[k] > y:
            if best == y or g_float_y1[k] < best:
                best = g_float_y1[k]
        k = k + 1
    best

# Bottom of the lowest float `clear` names (1 left, 2 right, 3 both), or the
# smallest i32 when there is none.
fn float_ctx_clear_bottom(clear_mode: i32) -> i32:
    var bottom = -2147483648
    var k = g_float_base
    val n = float_ctx_count()
    while k < n:
        if (clear_mode == 3 or g_float_side[k] == clear_mode) and g_float_y1[k] > bottom:
            bottom = g_float_y1[k]
        k = k + 1
    bottom

# Bottom of the lowest float placed since `from`, or the smallest i32.
fn float_ctx_max_bottom(from: i32) -> i32:
    var bottom = -2147483648
    var k = if from > g_float_base: from else: g_float_base
    val n = float_ctx_count()
    while k < n:
        if g_float_y1[k] > bottom:
            bottom = g_float_y1[k]
        k = k + 1
    bottom

# Rule 5 of 9.5.1: a float's top may not be above the top of an earlier one.
fn float_ctx_last_top() -> i32:
    val n = float_ctx_count()
    if n <= g_float_base:
        return -2147483648
    g_float_y0[n - 1]

# Top of the margin box of a float `outer_w` wide whose containing block is
# [cb_left, cb_right): the first y at or below `min_y` where it fits beside
# the floats already placed (or where no float is left to move below).
fn float_ctx_place_y(min_y: i32, outer_w: i32, clear_mode: i32, cb_left: i32, cb_right: i32) -> i32:
    var fy = min_y
    val last_top = float_ctx_last_top()
    if last_top > fy:
        fy = last_top
    if clear_mode != 0:
        val cleared = float_ctx_clear_bottom(clear_mode)
        if cleared > fy:
            fy = cleared
    var guard = float_ctx_count() + 1
    while guard > 0:
        val room = float_ctx_right_edge(fy, fy + 1, cb_right) - float_ctx_left_edge(fy, fy + 1, cb_left)
        if room >= outer_w:
            return fy
        val next_y = float_ctx_next_bottom(fy)
        if next_y <= fy:
            return fy
        fy = next_y
        guard = guard - 1
    fy

# Recompute the lowest float bottom of the current context slice.
fn float_ctx_refresh_max():
    g_float_max_y1 = float_ctx_max_bottom(g_float_base)

# Nearest float bottom below `y` among the floats that intersect the rows
# [y, y_end): where a box of that height can next find different room.
# Returns `y` when no float intersects the span.
fn float_ctx_next_bottom_span(y: i32, y_end: i32) -> i32:
    if y >= g_float_max_y1:
        return y
    var best = y
    var k = g_float_base
    val n = float_ctx_count()
    while k < n:
        if g_float_y0[k] < y_end and g_float_y1[k] > y:
            if best == y or g_float_y1[k] < best:
                best = g_float_y1[k]
        k = k + 1
    best

# Line boxes for successive lines of height `line_h` starting at `y` inside
# the containing block [cb_left, cb_right): flat (dx from cb_left, width)
# pairs, one per line, for as long as any float reaches below the line's top.
# Each line is bounded by ALL floats that intersect its own vertical span.
fn float_ctx_line_boxes(y: i32, line_h: i32, cb_left: i32, cb_right: i32) -> [i32]:
    var pairs: [i32] = []
    if line_h <= 0:
        return pairs
    var line_y = y
    var guard = 4096
    while line_y < g_float_max_y1 and guard > 0:
        val left = float_ctx_left_edge(line_y, line_y + line_h, cb_left)
        val right = float_ctx_right_edge(line_y, line_y + line_h, cb_right)
        pairs = pairs.push(left - cb_left)
        pairs = pairs.push(if right > left: right - left else: 0)
        line_y = line_y + line_h
        guard = guard - 1
    pairs

# True when any line box in `pairs` is inset or narrower than `full_w`.
fn line_boxes_shorten(pairs: [i32], full_w: i32) -> bool:
    var k = 0
    while k + 1 < pairs.len():
        if pairs[k] > 0 or pairs[k + 1] < full_w:
            return true
        k = k + 2
    false

# The (dx, width) pairs of the first `lines` lines: what a run that wrapped
# to `lines` lines actually uses, so a short run beside a tall float does not
# keep a pair for every line down to the float's bottom.
fn line_boxes_prefix(pairs: [i32], lines: i32) -> [i32]:
    if pairs.len() <= lines * 2:
        return pairs
    var out: [i32] = []
    var k = 0
    while k < lines * 2:
        out = out.push(pairs[k])
        k = k + 1
    out

# CSS 2.1 9.4.2: an inline subtree with no text, no preserved white space, no
# replaced/atomic box and no non-zero horizontal margin/padding/border opens no
# line box (Chrome 159: `<div><span></span></div>` is 0 tall).
fn inline_subtree_is_empty(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, c: i32) -> bool:
    val n = nodes[c]
    val st = styles[c]
    if n.tag == "#text":
        return n.text_trimmed == "" and not st.white_space_pre
    if st.display != "inline" or n.tag == "br" or grid_item_is_replaced(n):
        return false
    if st.pad_l != 0 or st.pad_r != 0 or st.border_l != 0 or st.border_r != 0:
        return false
    if st.margin_l != 0 or st.margin_r != 0:
        return false
    var k = child_index.first_child[c]
    while k >= 0:
        if not inline_subtree_is_empty(nodes, styles, child_index, k):
            return false
        k = child_index.next_sibling[k]
    true

# Width the first unbreakable piece of inline child `c` needs on a line: the
# first word of a text run (the whole run under nowrap), descending into
# plain inline elements; `atomic_w` for an atomic box.
fn inline_first_fit_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, c: i32, atomic_w: i32) -> i32:
    val st = styles[c]
    if nodes[c].tag == "#text":
        if st.white_space_nowrap or st.white_space_pre:
            return inline_text_advance_width(nodes[c], st)
        return first_word_advance_width(nodes[c], st)
    if inline_box_is_plain_element(nodes[c], st):
        val first = child_index.first_child[c]
        if first < 0:
            return 0
        return inline_first_fit_w(nodes, styles, child_index, first, 0)
    atomic_w

# True when `c` is the only in-flow child of `i`: floats, out-of-flow boxes
# and display:none siblings do not count.
fn block_sole_inflow_child(styles: [Style], child_index: HtmlChildIndex, i: i32, c: i32) -> bool:
    var k = child_index.first_child[i]
    while k >= 0:
        if k != c:
            val kst = styles[k]
            if kst.float_mode == 0 and not kst.position_absolute and not kst.position_fixed and kst.display != "none":
                return false
        k = child_index.next_sibling[k]
    true

# A box that establishes a new block formatting context (CSS 2.2 9.4.1):
# floats, out-of-flow boxes, non-`visible` overflow, every display that is
# not a plain block/inline box, flex and grid items, `contain: layout` boxes,
# and the root.
fn float_ctx_establishes_bfc(nodes: [HNode], styles: [Style], i: i32, st: Style) -> bool:
    if nodes[i].tag == "#text":
        return false
    if st.float_mode != 0 or st.position_absolute or st.position_fixed:
        return true
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return true
    if st.display != "block" and st.display != "list-item" and st.display != "inline":
        return true
    val parent = nodes[i].parent as i32
    if parent < 0:
        return true
    val parent_display = styles[parent].display
    if parent_display == "flex" or parent_display == "inline-flex" or parent_display == "grid" or parent_display == "inline-grid":
        return true
    # `contain: layout` makes the box an independent formatting context. It is
    # also the boundary `layout_selected` re-lays-out WITHOUT going through
    # `layout()`, so its floats must not outlive that partial pass.
    nodes[i].attrs_raw.len() > 0 and node_contain_layout(nodes[i])

# An explicit zero flex-basis (`flex: 1`, `flex: 2 1 0`, `flex-basis: 0`):
# the basis wins over `width`, so the flex base size is the item's padding
# and border whatever its width says.
fn flex_item_zero_basis(st: Style) -> bool:
    st.flex_basis_zero

fn flex_item_frame_w(st: Style) -> i32:
    st.pad_l + st.pad_r + st.border_l + st.border_r

# Advance of the longest word of a run: from the resolved per-byte advances,
# or -- when the style has no such table (no resolved face) -- from the cell
# width layout itself wraps with (`style_char_w`), one cell per codepoint.
# Never the whole run: a paragraph's minimum is one word.
fn text_longest_word_advance(txt: text, st: Style) -> i32:
    val n = txt.byte_len()
    if n == 0:
        return 0
    val by = style_run_byte_advances(st, txt)
    val measured = by.len() == n
    val cell = style_char_w(st)
    val tb = txt.bytes()
    var longest = 0
    var cur = 0
    var k = 0
    while k < n:
        if tb[k] == 32 or tb[k] == 9 or tb[k] == 10:
            cur = 0
        else:
            cur = cur + (if measured: by[k] else: cell)
            if cur > longest:
                longest = cur
        k = if measured: k + 1 else: next_codepoint_start(txt, k)
    longest

# Min-content OUTER width of a flex item: its longest word (the whole run
# under `white-space: nowrap | pre`) or widest child, plus its own padding
# and border. Scope: each text run and child is taken on its own (adjacent
# inline boxes are not joined into one word), and a replaced child without a
# width counts as its padding and border.
fn flex_item_min_content_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32) -> i32:
    var widest = 0
    var c = child_index.first_child[i]
    while c >= 0:  # cpu-lane-loop-ok: one pass over a flex item's subtree while sizing its row, not on any paint path
        val cst = styles[c]
        if nodes[c].tag == "#text":
            val word_w = if cst.white_space_nowrap or cst.white_space_pre:
                inline_text_advance_width(nodes[c], cst)
            else:
                text_longest_word_advance(nodes[c].text_trimmed, cst)
            if word_w > widest:
                widest = word_w
        elif cst.display != "none" and cst.display != "marker" and not cst.position_absolute:
            val child_w = if cst.width_px > 0 or cst.width_zero:
                css_outer_width(nodes[c], cst, cst.width_px)
            else:
                flex_item_min_content_w(nodes, styles, child_index, c)
            if child_w > widest:
                widest = child_w
        c = child_index.next_sibling[c]
    widest + flex_item_frame_w(styles[i])

# Outer width below which a zero-basis item does not go: its automatic
# minimum size (CSS Flexbox 4.5, `min-width: auto`) -- the min-content width,
# capped by a specified `width`. A declared `min-width`
# replaces it: the floor is that min-width as an outer size, so the freeze
# loop re-shares the rest (Flexbox 9.7). No floor when the item scrolls/clips.
fn flex_zero_basis_floor_w(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, item: i32, st: Style, container_w: i32) -> i32:
    val frame = flex_item_frame_w(st)
    if st.min_width_set:
        val min_outer = if st.border_box: st.min_width_px else: st.min_width_px + frame
        return if min_outer > frame: min_outer else: frame
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return frame
    var content = flex_item_min_content_w(nodes, styles, child_index, item)
    val authored = flex_item_authored_outer_w(nodes[item], st, container_w)
    if authored > 0 and authored < content:
        content = authored
    if content > frame: content else: frame

# Outer width a `width` declaration gives the item (0 for auto).
fn flex_item_authored_outer_w(node: HNode, st: Style, container_w: i32) -> i32:
    if st.width_px > 0 or st.width_zero:
        if node.has_widget_class or node.has_icon_image_class or st.border_box:
            return st.width_px
        return st.width_px + st.pad_l + st.pad_r + st.border_l + st.border_r
    if st.width_px < 0:
        return container_w * (0 - st.width_px) / 100
    0

# Outer base size of a flex item whose main size is definite: its
# `flex-basis`, else its `width` (px or % of the container), 0 when both are
# auto and the base size has to come from the content. A zero basis that
# overrides a width (`flex_item_zero_basis`) is definite too and may be 0.
fn flex_item_definite_base_w(node: HNode, st: Style, container_w: i32) -> i32:
    if flex_item_zero_basis(st):
        return st.pad_l + st.pad_r + st.border_l + st.border_r
    if st.flex_basis_px > 0:
        return st.flex_basis_px
    flex_item_authored_outer_w(node, st, container_w)

# Outer height below which a column flex item does not shrink: a declared
# min-height, else its automatic minimum (Flexbox 4.5). -1 = never shrink.
# ponytail: the min-content height is known only for an empty item (frame)
# and a lone text child (one line); an item with element children, and an
# anonymous text item, are never shrunk. Measure the content to lift this.
fn col_flex_shrink_floor_h(nodes: [HNode], child_index: HtmlChildIndex, item: i32, st: Style) -> i32:
    if nodes[item].tag == "#text":
        return -1
    val frame = st.pad_t + st.pad_b + st.border_t + st.border_b
    if st.min_height_px > 0:
        val min_outer = if st.border_box: st.min_height_px else: st.min_height_px + frame
        return if min_outer > frame: min_outer else: frame
    if st.overflow_hidden or st.overflow_auto_y or st.overflow_scroll_y:
        return frame
    val first = child_index.first_child[item]
    if first < 0:
        return frame
    if nodes[first].tag == "#text" and child_index.next_sibling[first] < 0:
        return frame + style_line_h(st)
    -1

# Outer flex base size of a column flex item (Flexbox 9.2.3): a zero basis is
# its frame, a px basis follows box-sizing, a definite height is that height.
# An auto height is its content: the frame when empty, one line for a lone
# text child. -1 = not known (element children): the caller gives up.
fn col_flex_base_h(nodes: [HNode], child_index: HtmlChildIndex, item: i32, st: Style) -> i32:
    val frame = st.pad_t + st.pad_b + st.border_t + st.border_b
    if flex_item_zero_basis(st):
        return frame
    if st.flex_basis_px > 0:
        return if st.border_box: st.flex_basis_px else: st.flex_basis_px + frame
    if st.height_px > 0 or nodes[item].tag == "#text":
        return flex_item_outer_height(nodes[item], st)
    val first = child_index.first_child[item]
    if first < 0:
        return frame
    if nodes[first].tag == "#text" and child_index.next_sibling[first] < 0:
        return frame + style_line_h(st)
    -1

# Used outer heights of the children of column flex container `i`, in sibling
# order (-1 = keep the hypothetical height), when its main size is definite:
# a `height`, or a max-/min-height that clamps the summed bases (Flexbox 9.7).
# Grow shares positive free space by flex-grow; shrink shares a deficit by
# flex-shrink x base and freezes an item at its floor. Empty = nothing to do.
# `min_h` is the resolved min-height in px (`min-height: 100vh` arrives as the
# viewport height; the style keeps only the vh flag).
# Legacy widget chrome (a `widget-panel` page with no `<style>`) fills its panels
# to the viewport bottom. A CSS page lays a `widget-panel` out by its CSS alone,
# as Chrome 159 does.
fn legacy_panel_fill(nodes: [HNode], i: i32) -> bool:
    nodes[i].has_widget_panel_class and nodes[0].legacy_widget_chrome

fn col_flex_target_heights(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, st: Style, iw: i32, content_height_limit: i32, legacy_widget_box: bool, min_h: i32) -> [i32]:
    if st.height_px <= 0 and st.max_height_px <= 0 and min_h <= 0:
        return []
    val frame_y = st.pad_t + st.pad_b + st.border_t + st.border_b
    val outer_is_box = legacy_widget_box or st.border_box
    var base: [i32] = []
    var grow: [i32] = []
    var shrink: [i32] = []
    var floor: [i32] = []
    var fixed = 0
    var items = 0
    var c = child_index.first_child[i]
    while c >= 0:
        val kst = style_with_resolved_percent_min_max(style_with_resolved_percent_margins(style_with_resolved_percent_padding(styles[c], iw), iw, 0), iw, content_height_limit)
        if kst.position_absolute or simple_web_style_hot_is_display_none(computed_style_hot_from(kst)):
            base = base.push(-1)
            grow = grow.push(0)
            shrink = shrink.push(0)
            floor = floor.push(-1)
        else:
            val kh = resolve_percent_height_px(kst.height_px, content_height_limit)
            val rst = if kh > 0 and kh != kst.height_px: style_with_height(kst, kh) else: kst
            val kbase = col_flex_base_h(nodes, child_index, c, rst)
            # ponytail: an auto-height item with element children has no
            # measured content height here, so the whole container keeps its
            # hypothetical heights. Measure the subtree to lift this.
            if kbase < 0:
                return []
            base = base.push(kbase)
            grow = grow.push(rst.flex_grow)
            shrink = shrink.push(rst.flex_shrink)
            floor = floor.push(col_flex_shrink_floor_h(nodes, child_index, c, rst))
            if not rst.margin_t_auto:
                fixed = fixed + rst.margin_t
            if not rst.margin_b_auto:
                fixed = fixed + rst.margin_b
            items = items + 1
        c = child_index.next_sibling[c]
    if items > 1:
        fixed = fixed + st.row_gap_px * (items - 1)
    val n = base.len()
    var sum = fixed
    var k = 0
    while k < n:
        if base[k] >= 0:
            sum = sum + base[k]
        k = k + 1
    var main = -1
    if st.height_px > 0:
        main = if outer_is_box: st.height_px - frame_y else: st.height_px
    elif st.max_height_px > 0:
        val max_main = if outer_is_box: st.max_height_px - frame_y else: st.max_height_px
        if sum > max_main:
            main = max_main
    if main < 0 and st.height_px <= 0 and min_h > 0:
        val min_main = if outer_is_box: min_h - frame_y else: min_h
        if sum < min_main:
            main = min_main
    if main < 0 or main == sum:
        return []
    var target: [i32] = [-1; n]
    if main > sum:
        var grow_total = 0
        k = 0
        while k < n:
            if base[k] >= 0:
                grow_total = grow_total + grow[k]
            k = k + 1
        if grow_total == 0:
            return []
        val free = main - sum
        var used = 0
        var assigned = 0
        k = 0
        while k < n:
            if base[k] >= 0 and grow[k] > 0:
                val after = free * (used + grow[k]) / grow_total
                target[k] = base[k] + after - assigned
                used = used + grow[k]
                assigned = after
            k = k + 1
        return target
    var frozen: [bool] = [false; n]
    var changed = true
    while changed:
        changed = false
        var avail = main - fixed
        var scaled = 0
        k = 0
        while k < n:
            if base[k] >= 0:
                if frozen[k]:
                    avail = avail - target[k]
                elif shrink[k] > 0 and floor[k] >= 0:
                    avail = avail - base[k]
                    scaled = scaled + shrink[k] * base[k]
                else:
                    avail = avail - base[k]
            k = k + 1
        if scaled == 0 or avail >= 0:
            changed = false
        else:
            k = 0
            while k < n:
                if base[k] >= 0 and not frozen[k] and shrink[k] > 0 and floor[k] >= 0:
                    val t = base[k] + avail * shrink[k] * base[k] / scaled
                    if t < floor[k]:
                        target[k] = floor[k]
                        frozen[k] = true
                        changed = true
                    else:
                        target[k] = t
                k = k + 1
    target

# A flex item's percentage min-/max- sizes are of the flex container's
# content box; an abspos child resolves its own in absolute_child_style.
fn flex_item_percent_style(cst: Style, container_w: i32, container_h: i32) -> Style:
    if cst.position_absolute:
        return cst
    val out = style_with_resolved_percent_min_max(style_with_resolved_percent_margins(style_with_resolved_percent_padding(cst, container_w), container_w, 0), container_w, container_h)
    if cst.flex_basis_permille < 0 or container_w <= 0:
        return out
    # A percentage flex-basis is of the container content width (Flexbox 7.2.3).
    val basis = style_with_width(out, out.width_px)
    basis.flex_basis_px = container_w * cst.flex_basis_permille / 1000
    basis.flex_basis_zero = basis.flex_basis_px == 0
    basis.flex_basis_permille = -1
    basis

# Shifts placed inline items on a closing line for `text-align: center | right`
# (and logical `end` / RTL `start`). Widened sole `#text` runs already fill to
# `line_iw`, giving `free_w <= 0` and zero double shift.
fn align_inline_line_horizontal(
    child_index: HtmlChildIndex, st: Style,
    line_nodes: [i32],
    line_iw: i32, inline_x: i32,
    bx: [i32], by: [i32]
) -> PositionOffsetResult:
    if line_nodes.len() == 0 or st.display == "inline":
        return PositionOffsetResult(bx: bx, by: by)
    val free_w = line_iw - inline_x
    if free_w <= 0:
        return PositionOffsetResult(bx: bx, by: by)
    var align = st.text_align
    if align == "start":
        align = if st.direction_rtl: "right" else: "left"
    elif align == "end":
        align = if st.direction_rtl: "left" else: "right"
    var dx = 0
    if align == "center":
        dx = free_w / 2
    elif align == "right":
        dx = free_w
    if dx <= 0:
        return PositionOffsetResult(bx: bx, by: by)
    var out_bx = bx
    var out_by = by
    var k = 0
    while k < line_nodes.len():
        val shifted = offset_layout_subtree(child_index, line_nodes[k], dx, 0, out_bx, out_by)
        out_bx = shifted.bx
        out_by = shifted.by
        k = k + 1
    PositionOffsetResult(bx: out_bx, by: out_by)

# Intrinsic outer width for non-growing auto-width row-flex items, covering form
# controls, replaced media boxes, nested flex containers, inline horizontal
# margins, and max-content boxes before falling back to `auto_weight`.
fn inline_subtree_horizontal_margins_w(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    i: i32, iw: i32
) -> i32:
    var total = 0
    var c = child_index.first_child[i]
    while c >= 0:
        val cst = styles[c]
        if (
            (cst.display == "inline" or cst.display == "inline-block") and
            nodes[c].tag != "#text" and cst.float_mode == 0 and
            not cst.position_absolute and not cst.position_fixed
        ):
            val cml = if cst.margin_l_auto: 0 else: resolve_horizontal_margin_px(cst.margin_l, iw)
            val cmr = if cst.margin_r_auto: 0 else: resolve_horizontal_margin_px(cst.margin_r, iw)
            total = total + cml + cmr
            total = total + inline_subtree_horizontal_margins_w(nodes, styles, child_index, c, iw)
        c = child_index.next_sibling[c]
    total

fn row_flex_item_auto_intrinsic_w(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    item: i32, st: Style, iw: i32, widths: [i32]
) -> IntrinsicWidthResult:
    val node = nodes[item]
    val border_x = st.border_l + st.border_r
    if node.tag == "select":
        val select_w = (
            form_control_widest_option_label_px(nodes, styles, child_index, item) +
            SELECT_ARROW_WIDTH_PX + st.pad_l + st.pad_r + border_x
        )
        return IntrinsicWidthResult(
            width: constrained_outer_width(node, st, select_w),
            widths: widths
        )
    if node.tag == "input" or node.tag == "textarea":
        val input_type = attr_value(node.attrs_raw, "type").trim().lower()
        if node.tag == "input" and (input_type == "checkbox" or input_type == "radio"):
            return IntrinsicWidthResult(
                width: constrained_outer_width(node, st, 13),
                widths: widths
            )
        if node.tag == "input" and input_type == "hidden":
            return IntrinsicWidthResult(width: 0, widths: widths)
        val control_w = input_auto_content_w(node, st, form_control_cols(node)) + st.pad_l + st.pad_r + border_x
        return IntrinsicWidthResult(
            width: constrained_outer_width(node, st, control_w),
            widths: widths
        )
    if replaced_default_box_w(node.tag) > 0 or node.tag == "img":
        val rep_w = replaced_auto_box_w(node, st, iw)
        if rep_w > 0:
            return IntrinsicWidthResult(
                width: constrained_outer_width(node, st, rep_w),
                widths: widths
            )
        return IntrinsicWidthResult(width: 0, widths: widths)
    if st.display == "flex" or st.display == "inline-flex":
        var out_widths = widths
        val is_col = st.flex_direction == "column" or st.flex_direction == "column-reverse"
        var total_w = 0
        var flex_item_count = 0
        var c = child_index.first_child[item]
        while c >= 0:
            val cst = styles[c]
            if cst.display != "none" and not cst.position_absolute and not cst.position_fixed:
                var cw = if cst.flex_basis_px > 0:
                    cst.flex_basis_px
                elif cst.width_px > 0:
                    css_outer_width(nodes[c], cst, cst.width_px)
                else:
                    val sub = row_flex_item_auto_intrinsic_w(nodes, styles, child_index, c, cst, iw, out_widths)
                    out_widths = sub.widths
                    sub.width
                val cml = resolve_horizontal_margin_px(cst.margin_l, iw)
                val cmr = resolve_horizontal_margin_px(cst.margin_r, iw)
                val item_w = cw + cml + cmr
                if is_col:
                    if item_w > total_w:
                        total_w = item_w
                else:
                    if flex_item_count > 0:
                        total_w = total_w + st.column_gap_px
                    total_w = total_w + item_w
                flex_item_count = flex_item_count + 1
            c = child_index.next_sibling[c]
        if total_w > 0:
            val outer = total_w + st.pad_l + st.pad_r + border_x
            return IntrinsicWidthResult(
                width: constrained_outer_width(node, st, outer),
                widths: out_widths
            )
    val intrinsic = intrinsic_text_width(nodes, styles, child_index, item, widths)
    val pct_pad_w = percent_padding_extra_w(styles[item], st)
    if intrinsic.width > 0:
        val inline_margins_w = inline_subtree_horizontal_margins_w(nodes, styles, child_index, item, iw)
        if inline_margins_w > 0 or pct_pad_w > 0:
            return IntrinsicWidthResult(
                width: constrained_outer_width(node, st, intrinsic.width + inline_margins_w + pct_pad_w),
                widths: intrinsic.widths
            )
        return intrinsic
    val max_content_w = flex_item_max_content_width(nodes, styles, child_index, item)
    if max_content_w > 0:
        return IntrinsicWidthResult(
            width: constrained_outer_width(node, st, max_content_w + pct_pad_w),
            widths: intrinsic.widths
        )
    intrinsic

fn layout_with_style(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32], authored_st: Style) -> LayoutResult:
    # Callers resolve percentage min-/max- sizes against the real containing
    # block (normal flow, inline atomic, float, abspos, flex). One still
    # unresolved here (a table cell, which ignores max-width) is `none`.
    val st = style_with_resolved_percent_min_max(authored_st, 0, 0)
    if not float_ctx_establishes_bfc(nodes, styles, i, st):
        return layout_with_style_flow(nodes, styles, child_index, i, x, y, w, viewport_w, viewport_h, bx, by, bw, bh, wrap_starts, wrap_ends, intrinsic_widths, st)
    val outer_base = g_float_base
    val outer_count = float_ctx_count()
    g_float_base = outer_count
    val outer_max = g_float_max_y1
    g_float_max_y1 = -2147483648
    val scoped = layout_with_style_flow(nodes, styles, child_index, i, x, y, w, viewport_w, viewport_h, bx, by, bw, bh, wrap_starts, wrap_ends, intrinsic_widths, st)
    float_ctx_truncate(outer_count)
    g_float_base = outer_base
    g_float_max_y1 = outer_max
    scoped

fn layout(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32]) -> LayoutResult:
    web_html_layout_tree(nodes, styles, child_index, i, x, y, w, viewport_w, viewport_h, bx, by, bw, bh, wrap_starts, wrap_ends, intrinsic_widths)

# Chrome 159 centres a `<button>`'s content vertically in its content box (the
# anonymous content box is centred). Runs after layout, so a height from CSS
# or from a flex row's stretch is already final. Content taller than the box
# keeps its top-aligned place. A flex or grid button lays its items out itself.
fn button_content_centre_pass(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, bx: [i32], by: [i32], bh: [i32]) -> PositionOffsetResult:
    var out_bx = bx
    var out_by = by
    var b = 0
    val n = nodes.len() as i32
    while b < n:  # cpu-lane-loop-ok: one pass per full layout over the node list; each button walks only its direct children; bound is node_count
        val st = styles[b]
        val d = st.display
        if nodes[b].tag == "button" and d != "none" and d != "contents" and d != "flex" and d != "inline-flex" and d != "grid" and d != "inline-grid":
            var top = 0
            var bottom = 0
            var any = false
            var c = child_index.first_child[b]
            while c >= 0:
                val cst = styles[c]
                if not cst.position_absolute and cst.display != "none" and bh[c] > 0:
                    if not any or out_by[c] < top:
                        top = out_by[c]
                    if not any or out_by[c] + bh[c] > bottom:
                        bottom = out_by[c] + bh[c]
                    any = true
                c = child_index.next_sibling[c]
            val content_top = out_by[b] + st.border_t + st.pad_t
            val content_h = bh[b] - st.border_t - st.border_b - st.pad_t - st.pad_b
            val dy = content_top + (content_h - (bottom - top)) / 2 - top
            if any and dy > 0:
                var k = child_index.first_child[b]
                while k >= 0:
                    val moved = offset_layout_subtree(child_index, k, 0, dy, out_bx, out_by)
                    out_bx = moved.bx
                    out_by = moved.by
                    k = child_index.next_sibling[k]
        b = b + 1
    PositionOffsetResult(bx: out_bx, by: out_by)

# @allow(primitive_api): internal sibling-module layout pass over flat i32 box coordinate arrays
pub fn web_html_layout_tree(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32]) -> LayoutResult:
    # Fresh layout pass: no float carries over from a previous document.
    float_ctx_reset()
    text_first_line_dx_reset()
    text_pen_origin_reset()
    text_line_boxes_reset()
    text_device_dy_reset()
    box_device_top_reset()
    box_device_extra_h_reset()
    box_frac_w_reset()
    val flow = layout_with_style(nodes, styles, child_index, i, x, y, w, viewport_w, viewport_h, bx, by, bw, bh, wrap_starts, wrap_ends, intrinsic_widths, styles[i])
    # ::marker box post-pass (bug browser_engine_no_list_marker_boxes_
    # 2026-08-19). list-style-position outside default: the marker box sits
    # in the li's start margin, 16px left of the content edge (Chrome UA
    # metrics) — a 6px disc slot for ul/menu, a 16px number slot for ol.
    # Scope: geometry only, disc/decimal defaults; marker box height follows
    # the li box (Chrome uses the first line box — identical for one-line lis).
    var out_bx = flow.bx
    var out_by = flow.by
    var out_bw = flow.bw
    var out_bh = flow.bh
    var marker_i = 0
    val marker_n = nodes.len() as i32
    while marker_i < marker_n:  # cpu-lane-loop-ok: one pass per full layout
        if nodes[marker_i].tag == "::marker" and styles[marker_i].display == "marker":
            val marker_li = nodes[marker_i].parent as i32
            if marker_li >= 0:
                val marker_list = nodes[marker_li].parent as i32
                val marker_ordered = marker_list >= 0 and nodes[marker_list].tag == "ol"
                out_bx[marker_i] = out_bx[marker_li] - 16
                out_by[marker_i] = out_by[marker_li]
                out_bw[marker_i] = if marker_ordered: 16 else: 6
                out_bh[marker_i] = out_bh[marker_li]
        marker_i = marker_i + 1
    val centred = button_content_centre_pass(nodes, styles, child_index, out_bx, out_by, out_bh)
    out_bx = centred.bx
    out_by = centred.by
    LayoutResult(bx: out_bx, by: out_by, bw: out_bw, bh: out_bh, wrap_starts: flow.wrap_starts, wrap_ends: flow.wrap_ends, intrinsic_widths: flow.intrinsic_widths, height: flow.height, first_line_dx: g_text_first_line_dx, line_boxes: g_text_line_boxes, pen_origin_milli: g_text_pen_origin_milli, device_dy: text_device_dy_first_table(), device_dy_rest: text_device_dy_rest_table(), device_top: box_device_top_table())

# =========================================================================
# `contain: layout` fast path for layout_selected. See containment.spl for
# why this is wired here (array/index-positional) rather than reusing that
# file's Dict-keyed LayoutContainState.
#
# node_contain_layout: reads the node's `contain` attribute the same way
# every other attribute is read in this file (attr_value(node.attrs_raw,
# name), e.g. the "width"/"height" reads a few lines above) and checks the
# "layout" token via containment.spl's shared token matcher.
# =========================================================================

fn node_contain_layout(node: HNode) -> bool:
    contain_value_contains_layout(attr_value(node.attrs_raw, "contain"))

fn nearest_contain_layout_ancestor(nodes: [HNode], idx: i32) -> i32:
    var cur = nodes[idx].parent as i32
    while cur >= 0:
        if node_contain_layout(nodes[cur]):
            return cur
        cur = nodes[cur].parent as i32
    -1

# Nearest `contain: layout` ancestor shared by every selected structural id.
# Returns -1 (no fast path) unless ALL selected ids resolve to the exact
# same boundary node — a conservative but always-correct restriction: a
# mutation batch touching two different contained subtrees, or one that
# isn't contained at all, falls straight through to the full recompute
# below rather than attempting a partial splice.
fn layout_contain_boundary(nodes: [HNode], selected_structural_ids: [i64]) -> i32:
    val node_count = nodes.len() as i32
    var boundary: i32 = -1
    var first = true
    for structural_id in selected_structural_ids:
        val idx = (structural_id - 1) as i32
        if idx < 0 or idx >= node_count:
            return -1
        val b = nearest_contain_layout_ancestor(nodes, idx)
        if b < 0:
            return -1
        if first:
            boundary = b
            first = false
        elif b != boundary:
            return -1
    boundary

# Structural node count of the subtree rooted at `i` (i inclusive). This is
# an upper bound on how many `layout_with_style` calls the fast path below
# performs: every recursive call in `layout_with_style` passes a child index
# drawn from `child_index.first_child`/`next_sibling` of the current node,
# so the recursion can never step outside this subtree. Used as the
# proportionality oracle in the spec (subtree size vs. total node count).
fn subtree_node_count(child_index: HtmlChildIndex, i: i32) -> i32:
    var total = 1
    var child = child_index.first_child[i]
    while child >= 0:
        total = total + subtree_node_count(child_index, child)
        child = child_index.next_sibling[child]
    total

fn layout_contain_boundary_subtree_size(nodes: [HNode], child_index: HtmlChildIndex, selected_structural_ids: [i64]) -> i32:
    """Public probe for the correctness/proportionality spec: the subtree
    size a fast-path recompute is bounded by, or the full node count when no
    `contain: layout` boundary covers the selection (i.e. no savings claimed)."""
    val boundary = layout_contain_boundary(nodes, selected_structural_ids)
    if boundary < 0:
        return nodes.len() as i32
    subtree_node_count(child_index, boundary)

pub fn layout_selected(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex,
    selected_structural_ids: [i64], width: i32, viewport_h: i32,
    retained: LayoutResult
) -> LayoutSelectedResult:
    if selected_structural_ids.len() == 0:
        return LayoutSelectedResult(layout: retained, fault: "")
    if nodes.len() != styles.len():
        return LayoutSelectedResult(layout: retained, fault: "cpu-layout-style-shape-mismatch")
    for structural_id in selected_structural_ids:
        if structural_id <= 0 or structural_id > nodes.len():
            return LayoutSelectedResult(layout: retained, fault: "cpu-layout-selection-out-of-range")
    val retained_empty = retained.bx.len() == 0
    if not retained_empty and (
        retained.bx.len() != nodes.len() or retained.by.len() != nodes.len() or
        retained.bw.len() != nodes.len() or retained.bh.len() != nodes.len() or
        retained.wrap_starts.len() != nodes.len() or
        retained.wrap_ends.len() != nodes.len() or
        retained.intrinsic_widths.len() != nodes.len()
    ):
        return LayoutSelectedResult(layout: retained, fault: "cpu-layout-retained-shape-mismatch")

    # contain:layout fast path. `contain: layout` promises the boundary
    # node's own box does not depend on how its subtree is laid out, so a
    # mutation confined to that subtree can be relaid-out starting from the
    # boundary, seeded from the previously-RETAINED box arrays everywhere
    # else, instead of recomputing from the document root. Correctness does
    # not rely on trusting the `contain` attribute: the recomputed
    # boundary's own box (bw/bh) is compared against the retained value
    # afterward, and any mismatch (a lying/violating `contain: layout`, or
    # any other reason the boundary's box actually changed) falls through
    # to the unconditional full recompute below, so the fast path can only
    # ever produce output identical to the full recompute, never wrong
    # output.
    if not retained_empty:
        val boundary = layout_contain_boundary(nodes, selected_structural_ids)
        if boundary >= 0:
            val bst = styles[boundary]
            # The subtree relayout bypasses `layout()`: carry the retained
            # first-line insets in, so nodes outside the boundary keep theirs
            # and nodes inside it are re-recorded.
            g_text_first_line_dx_pending = 0
            g_text_first_line_dx = retained.first_line_dx
            g_text_line_boxes = retained.line_boxes
            g_text_line_boxes_pending = []
            text_pen_origin_restore(retained.pen_origin_milli)
            text_device_dy_restore(retained.device_dy, retained.device_dy_rest)
            box_device_top_restore(retained.device_top)
            val sub = layout_with_style(
                nodes, styles, child_index, boundary,
                retained.bx[boundary], retained.by[boundary], retained.bw[boundary],
                width, viewport_h, retained.bx, retained.by, retained.bw, retained.bh,
                retained.wrap_starts, retained.wrap_ends, retained.intrinsic_widths, bst
            )
            if sub.bw[boundary] == retained.bw[boundary] and sub.bh[boundary] == retained.bh[boundary]:
                # Same post-layout pass as `web_html_layout_tree`; it is
                # idempotent, so retained (already centred) buttons stay put.
                val centred = button_content_centre_pass(nodes, styles, child_index, sub.bx, sub.by, sub.bh)
                return LayoutSelectedResult(
                    layout: LayoutResult(
                        bx: centred.bx, by: centred.by, bw: sub.bw, bh: sub.bh,
                        wrap_starts: sub.wrap_starts, wrap_ends: sub.wrap_ends,
                        intrinsic_widths: sub.intrinsic_widths, height: sub.height,
                        trailing_margin_b: sub.trailing_margin_b,
                        leading_margin_t: sub.leading_margin_t,
                        first_line_dx: g_text_first_line_dx,
                        line_boxes: g_text_line_boxes,
                        pen_origin_milli: g_text_pen_origin_milli,
                        device_dy: text_device_dy_first_table(),
                        device_dy_rest: text_device_dy_rest_table(),
                        device_top: box_device_top_table()
                    ),
                    fault: ""
                )

    val node_count = nodes.len() as i32
    # Canonical recursion remains the one authority. The selected seam controls
    # which island artifacts the execution port returns; recomputing from the
    # document root preserves containing-block and sibling constraints.
    val computed = web_html_layout_tree(
        nodes, styles, child_index, 0, 0, 0, width, width, viewport_h,
        zero_i32_list(node_count), zero_i32_list(node_count),
        zero_i32_list(node_count), zero_i32_list(node_count),
        empty_i32_lists(node_count), empty_i32_lists(node_count),
        neg_one_i32_list(node_count)
    )
    LayoutSelectedResult(layout: computed, fault: "")

# Containing block of an out-of-flow child whose PARENT `i` is an inline box,
# as `[left x, width, explicit height or 0]`. An out-of-flow box is never
# sized against the span it merely sits in. A float uses the nearest block
# container's content box. An absolutely positioned box uses the nearest
# POSITIONED ancestor -- every ancestor is tested while climbing, an inline
# one included, whose box then is the containing block (Chrome 159: an
# absolute svg in a 48 px `position:relative` span with `left:0` is 48x48) --
# and the root when there is none. Ancestors are laid out before their
# descendants, so their boxes are already in `bx`/`bw`.
fn inline_parent_containing_block(nodes: [HNode], styles: [Style], i: i32, positioned: bool, bx: [i32], bw: [i32]) -> [i32]:
    var a = i
    if positioned:
        while a > 0 and not (
            styles[a].position_relative or styles[a].position_absolute or
            styles[a].position_fixed or styles[a].position_sticky
        ):
            a = nodes[a].parent
    else:
        while a > 0 and styles[a].display == "inline":
            a = nodes[a].parent
    if a < 0:
        a = 0
    val ast = styles[a]
    val explicit_h = if ast.height_px > 0: ast.height_px else: 0
    if positioned:
        return [bx[a] + ast.border_l, bw[a] - ast.border_l - ast.border_r, explicit_h]
    [
        bx[a] + ast.border_l + ast.pad_l,
        bw[a] - ast.border_l - ast.border_r - ast.pad_l - ast.pad_r,
        explicit_h
    ]

# Paint reads `styles[i]`, where a percent padding is still unresolved (px 0),
# so every content-box reader (background-clip / -origin, a replaced element's
# content box, a control's text inset, the overflow clip) saw padding 0.
# Returns `styles` with each percent padding resolved against the containing
# block inline size layout used: the parent's content width (past inline
# ancestors), the parent's padding box for an absolutely positioned box, the
# grid area for a grid item (its column is the last track starting at or
# before its left edge). Returns `styles` itself when nothing is a percent.
pub fn web_styles_with_painted_percent_padding(nodes: [HNode], styles: [Style], bx: [i32], bw: [i32]) -> [Style]:
    var first_percent = -1
    var scan = 0
    while scan < styles.len() as i32 and first_percent < 0:
        val sst = styles[scan]
        if sst.pad_l_pct != 0 or sst.pad_t_pct != 0 or sst.pad_r_pct != 0 or sst.pad_b_pct != 0:
            first_percent = scan
        scan = scan + 1
    if first_percent < 0:
        return styles
    # Parents precede their children in the node arena, so `out[p]` is final.
    var out: [Style] = []
    var i = 0
    while i < styles.len() as i32:
        val st = styles[i]
        if i < first_percent or (st.pad_l_pct == 0 and st.pad_t_pct == 0 and st.pad_r_pct == 0 and st.pad_b_pct == 0):
            out.push(st)
            i = i + 1
            continue
        var p = nodes[i].parent as i32
        var basis = bw[i]
        if p >= 0 and p < i and st.position_absolute:
            basis = bw[p] - out[p].border_l - out[p].border_r
        elif p >= 0 and p < i:
            while out[p].display == "inline" and nodes[p].parent >= 0:
                p = nodes[p].parent as i32
            val pst = out[p]
            basis = bw[p] - pst.border_l - pst.border_r - pst.pad_l - pst.pad_r
            val columns = if pst.display == "grid": grid_track_sizes(pst.grid_template_columns, basis, pst.column_gap_px) else: []
            if columns.len() > 0:
                val left = bx[i] - bx[p] - pst.border_l - pst.pad_l
                var column = 0
                while column + 1 < columns.len() as i32 and grid_track_offset(columns, pst.column_gap_px, column + 1) <= left:
                    column = column + 1
                var span = grid_placement_span(st.grid_column)
                if st.grid_area != "":
                    for rect in grid_template_area_rects(pst.grid_template_areas):
                        if rect.area == st.grid_area:
                            span = rect.col_span
                basis = grid_track_span_size(columns, pst.column_gap_px, column, span)
        # A full copy: the layout clone behind style_with_resolved_percent_padding
        # keeps only what layout reads.
        val padded = style_with_resolved_percent_padding(st, if basis > 0: basis else: 0)
        var painted = renderer_default_style()
        painted.copy_from(st)
        painted.pad_l = padded.pad_l
        painted.pad_t = padded.pad_t
        painted.pad_r = padded.pad_r
        painted.pad_b = padded.pad_b
        painted.pad_l_pct = 0
        painted.pad_t_pct = 0
        painted.pad_r_pct = 0
        painted.pad_b_pct = 0
        out.push(painted)
        i = i + 1
    out

# Row, column, row span and column span of every child of grid `i`: four i32
# per child in sibling order, -1 four times for a `display:none` child. CSS
# Grid 8.5 auto-placement over `grid_column_count` columns and
# `grid_row_capacity` rows; column flow fills `flow_row_bound` rows per column.
fn grid_item_placements(
    styles: [Style], child_index: HtmlChildIndex, i: i32, st: Style,
    area_rects: [GridAreaRect], grid_column_count: i32,
    grid_row_capacity: i32, flow_row_bound: i32
) -> [i32]:
    var placements: [i32] = []
    var occupied: [bool] = [
        false; grid_row_capacity * grid_column_count
    ]
    # Sparse packing (CSS Grid 8.5): an auto-row item is searched from the
    # auto-placement cursor, never back-filling cells an earlier item skipped.
    var grid_auto_cursor = 0
    # Items with a definite row AND column claim their cells before any
    # auto-placed item, whatever the source order (CSS Grid 8.5 step 1).
    var grid_definite = child_index.first_child[i]
    while grid_definite >= 0:
        val definite_style = styles[grid_definite]
        val definite_column = grid_placement_start(definite_style.grid_column)
        val definite_row = grid_placement_start(definite_style.grid_row)
        val definite_column_span = grid_placement_span(definite_style.grid_column)
        var definite_row_span = grid_placement_span(definite_style.grid_row)
        if (
            definite_column >= 0 and definite_row >= 0 and
            definite_style.grid_area == "" and
            definite_row < grid_row_capacity and
            definite_column + definite_column_span <= grid_column_count and
            not simple_web_style_hot_is_display_none(computed_style_hot_from(definite_style))
        ):
            if definite_row + definite_row_span > grid_row_capacity:
                definite_row_span = grid_row_capacity - definite_row
            var definite_mark = 0
            while definite_mark < definite_column_span * definite_row_span:
                occupied[
                    (definite_row + definite_mark / definite_column_span) * grid_column_count +
                    definite_column + definite_mark % definite_column_span
                ] = true
                definite_mark = definite_mark + 1
        grid_definite = child_index.next_sibling[grid_definite]
    var grid_child = child_index.first_child[i]
    while grid_child >= 0:
        val grid_child_style = styles[grid_child]
        if simple_web_style_hot_is_display_none(computed_style_hot_from(grid_child_style)):
            placements.push(-1)
            placements.push(-1)
            placements.push(-1)
            placements.push(-1)
            grid_child = child_index.next_sibling[grid_child]
            continue
        var grid_column = grid_placement_start(
            grid_child_style.grid_column
        )
        var grid_row = grid_placement_start(grid_child_style.grid_row)
        var grid_column_span = grid_placement_span(
            grid_child_style.grid_column
        )
        var grid_row_span = grid_placement_span(grid_child_style.grid_row)
        if grid_child_style.grid_area != "":
            var area_idx = 0
            var area_found = -1
            while area_idx < area_rects.len():
                if area_rects[area_idx].area == grid_child_style.grid_area:
                    area_found = area_idx as i32
                area_idx = area_idx + 1
            if area_found >= 0:
                grid_column = area_rects[area_found].col_start
                grid_row = area_rects[area_found].row_start
                grid_column_span = area_rects[area_found].col_span
                grid_row_span = area_rects[area_found].row_span
        if grid_column_span > grid_column_count:
            grid_column_span = grid_column_count
        if grid_row_span > grid_row_capacity:
            grid_row_span = grid_row_capacity
        # A declared line beyond this bounded layout pass cannot index the
        # occupancy/row arrays. Treat it as auto-placement, preserving the
        # same fail-closed behavior as unsupported/invalid placement.
        if grid_row >= grid_row_capacity:
            grid_row = -1
        if (
            grid_column >= grid_column_count or
            grid_column + grid_column_span > grid_column_count
        ):
            grid_column = -1
        if grid_column < 0 or grid_row < 0:
            # `grid-auto-flow: column` walks column-major: fill down each
            # column (`flow_row_bound` rows, CSS Grid 8.5) before advancing
            # to the next one, instead of the default row-major walk.
            val candidate_limit = if st.grid_auto_flow_column:
                flow_row_bound * grid_column_count
            else:
                grid_row_capacity * grid_column_count
            val grid_cursor_item = grid_row < 0 and not st.grid_auto_flow_column
            var candidate = if grid_cursor_item: grid_auto_cursor else: 0
            var placed = false
            while (
                candidate < candidate_limit and not placed
            ):
                val candidate_row = if st.grid_auto_flow_column:
                    candidate % flow_row_bound
                else:
                    candidate / grid_column_count
                val candidate_column = if st.grid_auto_flow_column:
                    candidate / flow_row_bound
                else:
                    candidate % grid_column_count
                var admitted = (
                    (grid_row < 0 or candidate_row == grid_row) and
                    (grid_column < 0 or candidate_column == grid_column) and
                    candidate_column + grid_column_span <=
                        grid_column_count and
                    candidate_row + grid_row_span <= grid_row_capacity
                )
                var span_index = 0
                while admitted and span_index < grid_column_span * grid_row_span:
                    if occupied[
                        (candidate_row + span_index / grid_column_span) * grid_column_count +
                        candidate_column + span_index % grid_column_span
                    ]:
                        admitted = false
                    span_index = span_index + 1
                if admitted:
                    grid_row = candidate_row
                    grid_column = candidate_column
                    placed = true
                candidate = candidate + 1
            if placed and grid_cursor_item:
                grid_auto_cursor = grid_row * grid_column_count + grid_column + grid_column_span
        if grid_row < 0:
            grid_row = 0
        if grid_column < 0:
            grid_column = 0
        if grid_row + grid_row_span > grid_row_capacity:
            grid_row_span = grid_row_capacity - grid_row
        var mark_index = 0
        while mark_index < grid_column_span * grid_row_span:
            occupied[
                (grid_row + mark_index / grid_column_span) * grid_column_count +
                grid_column + mark_index % grid_column_span
            ] = true
            mark_index = mark_index + 1
        placements.push(grid_row)
        placements.push(grid_column)
        placements.push(grid_row_span)
        placements.push(grid_column_span)
        grid_child = child_index.next_sibling[grid_child]
    placements

# [columns, rows] the children of grid `i` reach by their own placement: a
# definite start line plus its span, or the span alone. At least 1 each.
fn grid_item_line_extents(styles: [Style], child_index: HtmlChildIndex, i: i32) -> [i32]:
    var column_extent = 1
    var row_extent = 1
    var c = child_index.first_child[i]
    while c >= 0:  # cpu-lane-loop-ok: one pass over a grid's children during layout, never on a paint path
        val cst = styles[c]
        if cst.grid_area == "" and not simple_web_style_hot_is_display_none(computed_style_hot_from(cst)):
            val column_start = grid_placement_start(cst.grid_column)
            val column_end = (if column_start > 0: column_start else: 0) + grid_placement_span(cst.grid_column)
            if column_end > column_extent:
                column_extent = column_end
            val row_start = grid_placement_start(cst.grid_row)
            val row_end = (if row_start > 0: row_start else: 0) + grid_placement_span(cst.grid_row)
            if row_end > row_extent:
                row_extent = row_end
        c = child_index.next_sibling[c]
    [column_extent, row_extent]

# Column sizes of a grid with implicit columns (CSS Grid 7.6, 12.5; Chrome
# 159): the template tracks, then one `grid-auto-columns` track per implicit
# column, cycled (`auto` when the property is unset). An `auto` column is as
# wide as the widest margin box lying in it alone; the template shares what
# the implicit columns leave; `fr` implicit columns, else the `auto` ones
# (justify-content: normal), share the rest equally.
# ponytail: an implicit `fr` column beside a template `fr` gets no share.
fn grid_column_sizes_with_implicit(
    nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, st: Style,
    placements: [i32], explicit_count: i32, column_count: i32,
    available_w: i32, widths: [i32]
) -> [i32]:
    val gap = st.column_gap_px
    val auto_tracks = if st.grid_auto_columns == "": [] else: st.grid_auto_columns.split(" ")
    var sizes: [i32] = [0; column_count]
    var fr: [i32] = [0; column_count]
    var is_auto: [bool] = [false; column_count]
    var fr_total = 0
    var auto_count = 0
    var column = explicit_count
    while column < column_count:
        val track = if auto_tracks.len() > 0: auto_tracks[(column - explicit_count) % (auto_tracks.len() as i32)] else: "auto"
        if track.ends_with("fr"):
            fr[column] = parse_int(track)
            fr_total = fr_total + fr[column]
        elif track.ends_with("%"):
            sizes[column] = available_w * parse_int(track) / 100
        elif track.ends_with("px"):
            sizes[column] = parse_int(track)
        else:
            if track != "auto":
                sizes[column] = parse_int(track)
            is_auto[column] = true
            auto_count = auto_count + 1
        column = column + 1
    if auto_count > 0:
        var c = child_index.first_child[i]
        var placement = 0
        while c >= 0:  # cpu-lane-loop-ok: one pass over a grid's children during layout, never on a paint path
            val item_column = placements[placement + 1]
            if placements[placement] >= 0 and placements[placement + 3] == 1 and item_column >= explicit_count and is_auto[item_column]:
                val cst = styles[c]
                val border_box_w = if cst.width_px > 0:
                    css_outer_width(nodes[c], cst, cst.width_px)
                else:
                    row_flex_item_auto_intrinsic_w(nodes, styles, child_index, c, cst, available_w, widths).width
                val margin_l = if cst.margin_l_auto: 0 else: resolve_horizontal_margin_px(cst.margin_l, 0)
                val margin_r = if cst.margin_r_auto: 0 else: resolve_horizontal_margin_px(cst.margin_r, 0)
                if border_box_w + margin_l + margin_r > sizes[item_column]:
                    sizes[item_column] = border_box_w + margin_l + margin_r
            placement = placement + 4
            c = child_index.next_sibling[c]
    var used_w = gap * (column_count - 1)
    column = explicit_count
    while column < column_count:
        used_w = used_w + sizes[column]
        column = column + 1
    val explicit = grid_track_sizes(
        st.grid_template_columns, available_w - used_w + gap * (explicit_count - 1), gap
    )
    column = 0
    while column < explicit_count and column < explicit.len() as i32:
        sizes[column] = explicit[column]
        used_w = used_w + explicit[column]
        column = column + 1
    val free_w = available_w - used_w
    val stretch_auto = st.justify_content == "flex-start" or st.justify_content == "normal" or st.justify_content == "stretch"
    if free_w > 0 and (fr_total > 0 or (auto_count > 0 and stretch_auto)):
        column = explicit_count
        while column < column_count:
            if fr_total > 0:
                sizes[column] = sizes[column] + free_w * fr[column] / fr_total
            elif is_auto[column]:
                sizes[column] = sizes[column] + free_w / auto_count
            column = column + 1
    sizes

# Used style of a grid item stretched to `outer_h`, the border-box height its
# row span leaves it after its block margins.
fn grid_stretched_item_style(node: HNode, authored: Style, resolved: Style, outer_h: i32) -> Style:
    var style_h = if outer_h < 1: 1 else: outer_h
    if not (node.has_widget_class or node.has_icon_image_class or authored.border_box):
        style_h = style_h - resolved.pad_t - resolved.pad_b - authored.border_t - authored.border_b
    if style_h < 1:
        style_h = 1
    style_with_height(resolved, style_h)

fn layout_with_style_flow(nodes: [HNode], styles: [Style], child_index: HtmlChildIndex, i: i32, x: i32, y: i32, w: i32, viewport_w: i32, viewport_h: i32, bx: [i32], by: [i32], bw: [i32], bh: [i32], wrap_starts: [[i32]], wrap_ends: [[i32]], intrinsic_widths: [i32], st: Style) -> LayoutResult:
    var out_bx = bx
    var out_by = by
    var out_bw = bw
    var out_bh = bh
    var out_wrap_starts = wrap_starts
    var out_wrap_ends = wrap_ends
    var out_intrinsic_widths = intrinsic_widths
    val origin_frac = g_origin_frac_milli
    g_origin_frac_milli = 0
    box_frac_w_take(nodes.len() as i32, i)
    out_bx[i] = x
    out_by[i] = y
    val node = nodes[i]
    # Budget guard: short-circuit layout of not-yet-processed subtrees on expiry.
    # Emit a zero-size box for this node and return a valid LayoutResult so the
    # recursion unwinds cleanly while already-computed boxes stay intact.
    if _web_budget_expired_at(WEB_BUDGET_SITE_LAYOUT_SUBTREE):
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    val legacy_widget_box = node.has_widget_class or node.has_icon_image_class
    if simple_web_style_hot_is_display_none(computed_style_hot_from(st)):
        out_bw[i] = 0
        out_bh[i] = 0
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, 0)
    if st.display == "contents":
        out_bw[i] = w
        var cy_contents = y
        var c_contents = child_index.first_child[i]
        var child_count_contents = 0
        var prev_margin_b_contents = 0
        while c_contents >= 0:
            val cst = styles[c_contents]
            val cml = resolve_horizontal_margin_px(cst.margin_l, w)
            val cmr = resolve_horizontal_margin_px(cst.margin_r, w)
            if child_count_contents > 0:
                cy_contents = cy_contents + st.gap_px
            val cst_margin_t_contents = vertical_margin_px_in(cst, true, viewport_h, w)
            val collapsed_margin_contents = collapse_margins_signed(prev_margin_b_contents, cst_margin_t_contents)
            cy_contents = cy_contents + collapsed_margin_contents
            var child_w_contents = w - cml - cmr
            if child_w_contents < 1:
                child_w_contents = 1
            val child = layout_with_style(nodes, styles, child_index, c_contents, x + cml, cy_contents, child_w_contents, viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, styles[c_contents])
            out_bx = child.bx
            out_by = child.by
            out_bw = child.bw
            out_bh = child.bh
            out_wrap_starts = child.wrap_starts
            out_wrap_ends = child.wrap_ends
            out_intrinsic_widths = child.intrinsic_widths
            cy_contents = cy_contents + child.height
            prev_margin_b_contents = vertical_margin_px_in(cst, false, viewport_h, w)
            child_count_contents = child_count_contents + 1
            c_contents = child_index.next_sibling[c_contents]
        if child_count_contents > 0:
            cy_contents = cy_contents + prev_margin_b_contents
        val h_contents = cy_contents - y
        out_bh[i] = h_contents
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h_contents)
    val border_x = st.border_l + st.border_r
    val border_y = st.border_t + st.border_b
    val explicit_node_w = css_outer_width(node, st, st.width_px)
    # width_px > 0: explicit px. width_px < 0: percentage of available width
    # (negative sentinel from apply_decls). width_px == 0: fill available width.
    var node_w = if st.width_px > 0 or st.width_zero: explicit_node_w else: w
    if st.flex_basis_px > 0 and w > 0:
        node_w = w
    if st.width_px < 0:
        node_w = css_outer_width(nodes[i], st, w * (0 - st.width_px) / 100)
        if node_w < 1:
            node_w = 1
    out_bw[i] = node_w
    if node.tag != "#text" and st.width_px == 0 and not st.width_zero and st.white_space_nowrap:
        val nowrap_intrinsic = intrinsic_text_width(nodes, styles, child_index, i, out_intrinsic_widths)
        out_intrinsic_widths = nowrap_intrinsic.widths
        if nowrap_intrinsic.width > node_w:
            node_w = nowrap_intrinsic.width
    node_w = constrained_outer_width(node, st, node_w)
    out_bw[i] = node_w
    if replaced_default_box_w(node.tag) > 0:
        # Replaced element with no intrinsic media loaded: fixed box from CSS
        # width/height, else the width/height HTML attributes, else the UA
        # default for the tag (CSS 2.1 §10.3.2/§10.6.2 give 300x150; Chrome's
        # `<audio controls>` widget default is 300x54). The subtree is never
        # laid out (returns without recursing into children). An auto axis
        # is sized by `replaced_auto_box_w` / `replaced_auto_box_h`, shared
        # with the inline pen prediction below.
        # `display:inline-flex` is laid out as a full-width flex row here
        # (Chrome shrinks it to fit, where a ratio-only svg is 0 wide), so
        # filling the "available" width would make the svg 900x900. An
        # unsized svg there keeps the UA default box instead.
        val unsized_in_inline_flex = (
            node.tag == "svg" and st.width_px == 0 and st.height_px <= 0 and
            node.parent >= 0 and styles[node.parent].display_inline_flex_authored and
            parse_int(attr_value(node.attrs_raw, "width")) <= 0 and
            parse_int(attr_value(node.attrs_raw, "height")) <= 0
        )
        if unsized_in_inline_flex:
            out_bw[i] = constrained_outer_width(
                node, st, replaced_default_box_w(node.tag) + st.pad_l + st.pad_r + st.border_l + st.border_r
            )
        elif st.width_px == 0 and not st.width_zero:
            out_bw[i] = constrained_outer_width(
                node, st, replaced_auto_box_w(node, st, w)
            )
        val explicit_replaced_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        var replaced_h = explicit_replaced_h
        # A negative height is a percentage no caller could resolve (the
        # containing block's height is auto): CSS 2.1 §10.5 computes it to
        # `auto`. Chrome 159: `<svg height="100%">` in an auto-height div is
        # 150 px tall.
        if unsized_in_inline_flex:
            replaced_h = replaced_default_box_h(node.tag) + st.pad_t + st.pad_b + border_y
        elif st.height_px <= 0:
            replaced_h = replaced_auto_box_h(node, st, out_bw[i])
        replaced_h = constrained_outer_height(node, st, replaced_h)
        out_bh[i] = replaced_h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, replaced_h)
    if node.tag == "#text":
        # white-space:pre/nowrap (st.white_space_nowrap, inherited from e.g. a
        # <pre> code block) preserves the raw text incl. leading indentation;
        # normal flow uses the trimmed text. Measure and paint must agree on which.
        val txt: text = if st.white_space_nowrap: node.text_data else: node.text_trimmed
        val txt_len = if st.white_space_nowrap: node.text_data.byte_len() else: node.text_trimmed.byte_len()
        val cw = style_char_w(st)
        var cpl = node_w / cw
        if cpl < 1:
            cpl = 1
        # If the whole run fits the box at its real advance width, keep it on
        # one line. An inline #text box is sized by advance width (5px/char at
        # scale 1) while cpl divides by cell width (6px/char), so without this
        # check a run that exactly fits its box spuriously wraps at ~5/6 of its
        # length ("Simple Editor" -> "Simple"/"Editor", "EDITOR" -> "EDITO"/"R").
        val full_adv = style_measured_run_advance(txt, txt_len, st)
        # A `<button>` label is shaped at the control's real 13.333px font,
        # while a flex row snaps the button to whole CSS px: Chrome keeps the
        # 61.5 px `CSS Paint` on one line of its 79.5 px button, here it is 62
        # px in a 79 px one. Less than 1 px over is rounding, not overflow.
        # A row flex item placed at its exact (LayoutUnit) width hands its
        # remainder over the whole-px box: `CSS Paint` is 73.8125 px in a 73 px
        # box (44..117) and stays on one line in Chrome. Compare exact widths.
        val parent_frac_w = box_frac_w_at(node.parent as i32)
        val run_fits = if parent_frac_w == BOX_FRAC_W_UNSET:
            full_adv <= node_w
        else:
            text_run_exact_width_milli_px(nodes, i, st, txt, full_adv) <= node_w * 1000 + parent_frac_w
        # First-line inset handed over by the inline run loop: this run
        # starts mid-line, so line 0 only has `node_w - first_dx` and every
        # later line the whole line box. Consumed here, for this node only.
        val first_dx = g_text_first_line_dx_pending
        g_text_first_line_dx_pending = 0
        # Line boxes handed over by the inline run loop: floats shorten
        # some of this run's lines. Consumed here, for this node only.
        val band_boxes = g_text_line_boxes_pending
        g_text_line_boxes_pending = []
        if st.white_space_pre:
            # `white-space: pre` PRESERVES newlines as forced line breaks — the
            # one thing that distinguishes it from `nowrap`, which collapses
            # them. Both used to share the single-line branch below, so a
            # `<pre>` block was one line however many rows it held: Chrome
            # gives `<pre>A\nB</pre>` two lines, Simple gave one, and the
            # catalog's `<pre>` sample was 24 px short with every later row on
            # that page dragged up behind it.
            val pre_ranges = compute_preserved_newline_ranges(txt, txt_len)
            out_wrap_starts[i] = pre_ranges.starts
            out_wrap_ends[i] = pre_ranges.ends
        elif st.white_space_nowrap:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        elif first_dx > 0:
            val first_ranges = compute_style_wrap_ranges_first_line(txt, node_w - first_dx, node_w, st, cpl)
            out_wrap_starts[i] = first_ranges.starts
            out_wrap_ends[i] = first_ranges.ends
        elif band_boxes.len() > 0:
            val band_ranges = compute_style_wrap_ranges_float_band(txt, node_w, band_boxes, st)
            out_wrap_starts[i] = band_ranges.starts
            out_wrap_ends[i] = band_ranges.ends
        elif run_fits:
            out_wrap_starts[i] = [0; 1]
            out_wrap_ends[i] = [txt_len; 1]
        else:
            val ranges = compute_style_wrap_ranges(txt, node_w, st, cpl)
            out_wrap_starts[i] = ranges.starts
            out_wrap_ends[i] = ranges.ends
        val lines = out_wrap_starts[i].len()
        val h = lines * style_line_h(st)
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if node.tag == "input" or node.tag == "select" or node.tag == "textarea":
        # Form controls are WIDGETS, not block containers: the UA gives them a
        # box from their own metrics and never lays their children out as boxes
        # (Chrome reports every `<option>` as 0x0 — a `<select>` renders its
        # options in a popup, not in flow). This branch returns before the
        # child recursion for exactly that reason.
        #
        # Height is the content line plus the element's own padding and border.
        # `box-sizing` only reinterprets a SPECIFIED height, so an auto-height
        # control is content + padding + border either way; charging only the
        # content line is what made every control 18 px short (and is the
        # `expected 19 to equal 21` in web_css_table_replaced_forms_spec).
        val input_type = attr_value(node.attrs_raw, "type")
        if node.tag == "input" and (input_type == "checkbox" or input_type == "radio"):
            # Chrome's UA sizes these two to a 13x13 glyph box and ignores
            # author padding on them; an authored width/height is the border
            # box (UA `box-sizing: border-box`). Chrome 159:
            # `width:40px;height:16px;padding:2px` gives 40x16.
            val check_w = if st.width_px > 0: css_outer_width(node, st, st.width_px) else: 13
            out_bw[i] = constrained_outer_width(node, st, check_w)
            val check_auto_h = if st.height_px > 0: css_outer_height(node, st, st.height_px) else: 13
            val check_h = constrained_outer_height(node, st, check_auto_h)
            out_bh[i] = check_h
            return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, check_h)
        val control_line_h = style_line_h(st)
        val control_rows = if node.tag == "textarea": form_control_rows(node) else: 1
        val explicit_control_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        # A <select>'s content box holds its one line plus the menulist's own
        # 1 px of block padding on each side (Chrome 159: 19 on a 15 px line).
        val control_inner_pad = if node.tag == "select": SELECT_INNER_BLOCK_PADDING_PX else: 0
        val auto_control_h = control_rows * control_line_h + control_inner_pad + st.pad_t + st.pad_b + border_y
        val h = constrained_outer_height(node, st, if st.height_px > 0: explicit_control_h else: auto_control_h)
        if st.height_px <= 0 and h == auto_control_h:
            box_device_extra_h_record(nodes.len() as i32, i, form_control_device_extra_h(node, st, control_rows))
        out_bh[i] = h
        if st.width_px == 0 and not st.width_zero:
            # Intrinsic width: `size` columns for <input>, `cols` for
            # <textarea>, the widest <option> label for <select> — each in the
            # control's own UA font, plus its padding and border.
            val cols = form_control_cols(node)
            var control_w = input_auto_content_w(node, st, cols) + st.pad_l + st.pad_r + border_x
            if node.tag == "select":
                # Chrome: ceil(widest option label, at the control's REAL font
                # size) + the 20 px interior + the select's own padding and
                # border. Not `flex_item_max_content_width`: that sums the
                # integer-px run the label would be painted with at the
                # truncated 13 px size, which is 1-3 px short of the 13.3333 px
                # label Chrome measures and cannot ceil a fraction it never had.
                control_w = (
                    form_control_widest_option_label_px(nodes, styles, child_index, i) +
                    SELECT_ARROW_WIDTH_PX + st.pad_l + st.pad_r + border_x
                )
            out_bw[i] = constrained_outer_width(node, st, control_w)
            # Device scale k > 1: Chrome sizes the control in device px, which
            # is not k x the CSS width (see `g_box_device_extra_w`).
            var control_extra_w = 0
            if layout_device_scale() > 1 and out_bw[i] == control_w:
                if node.tag == "select":
                    control_extra_w = select_device_extra_w(nodes, styles, child_index, i)
                elif node.tag == "textarea" or input_type_is_column_sized(input_type):
                    control_extra_w = (
                        form_control_intrinsic_content_device_w(node, st, cols, layout_device_scale()) -
                        layout_device_scale() * form_control_intrinsic_content_w(node, st, cols)
                    )
            box_device_extra_w_record(nodes.len() as i32, i, control_extra_w)
        # The one text a control shows in its own box -- a textarea's value, a
        # select's current option label -- is laid out in the content box so
        # paint can draw it. Nothing else below the control gets a box.
        val label_text_i = form_control_label_text_node(nodes, child_index, i)
        if label_text_i >= 0:
            val label_inset_x = if node.tag == "select": SELECT_LABEL_INLINE_START_PX else: 0
            val label_inset_y = if node.tag == "select": SELECT_INNER_BLOCK_PADDING_PX / 2 else: 0
            var label_w = out_bw[i] - st.pad_l - st.pad_r - border_x - label_inset_x
            if label_w < 1:
                label_w = 1
            if node.tag == "select" and styles[label_text_i].resolved_font_width >= label_w:
                # A select shows ONE line however narrow an author makes it;
                # the label overflows (and is clipped) rather than wrapping
                # onto rows the control has no height for.
                label_w = styles[label_text_i].resolved_font_width + 1
            val label_layout = layout_with_style(
                nodes, styles, child_index, label_text_i,
                x + st.border_l + st.pad_l + label_inset_x,
                y + st.border_t + st.pad_t + label_inset_y,
                label_w, viewport_w, viewport_h,
                out_bx, out_by, out_bw, out_bh,
                out_wrap_starts, out_wrap_ends, out_intrinsic_widths,
                styles[label_text_i]
            )
            box_device_inline_dy_record(nodes.len() as i32, label_text_i, form_control_label_device_dy(node, st))
            out_bx = label_layout.bx
            out_by = label_layout.by
            out_bw = label_layout.bw
            out_bh = label_layout.bh
            out_wrap_starts = label_layout.wrap_starts
            out_wrap_ends = label_layout.wrap_ends
            out_intrinsic_widths = label_layout.intrinsic_widths
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if node.tag == "img":
        # `<img>` is a replaced element, so its WIDTH is its own (attribute or
        # CSS), never the container's. Before round 19 this branch set only the
        # height and left `out_bw[i]` at the block-path container width, which
        # was invisible while `img` was block-level and full-width anyway — and
        # becomes a line-wide box the moment it is routed inline. No UA default
        # box is invented here: `replaced_default_box_w("img")` stays 0 because
        # no page in the eight-page catalog carries an `<img>` to measure one
        # against.
        #
        # Stated rather than glossed: a SIZELESS `<img>` does change behaviour.
        # It used to take the block path's container width (810 px on the
        # catalog's content column); routed inline with no attribute and no CSS
        # it now takes the inline pen prediction, which for a childless
        # replaced box is 1 px. Chrome gives a srcless, sizeless `<img>` a 0x0
        # box, so the new value is the closer of the two — but it is a change,
        # and it is unmeasured by this catalog, not verified by it.
        if st.width_px == 0 and not st.width_zero:
            val img_attr_w = parse_int(attr_value(node.attrs_raw, "width"))
            if img_attr_w > 0:
                out_bw[i] = constrained_outer_width(node, st, img_attr_w)
        val explicit_node_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        var img_auto_h = style_line_h(st)
        if st.width_px == 0 and not st.width_zero and parse_int(attr_value(node.attrs_raw, "width")) <= 0:
            # A supplied resource sizes an auto width: natural, or the height's aspect ratio.
            val img_res_w = img_resource_auto_outer_w(node, st)
            if img_res_w > 0:
                out_bw[i] = constrained_outer_width(node, st, img_res_w)
        val img_res_h = img_resource_auto_outer_h(node, st, out_bw[i])
        if img_res_h > 0:
            img_auto_h = img_res_h
        val img_attr_h = parse_int(attr_value(node.attrs_raw, "height"))
        if img_attr_h > 0:
            img_auto_h = img_attr_h
            # `height:auto` keeps the attribute aspect ratio at the used width
            # (Chrome 159: width=300 height=150, max-width:100% in 100 px -> 100x50).
            val img_ratio_w = parse_int(attr_value(node.attrs_raw, "width"))
            val img_used_w = out_bw[i] - st.pad_l - st.pad_r - st.border_l - st.border_r
            if img_ratio_w > 0 and img_used_w > 0:
                img_auto_h = (img_attr_h * img_used_w + img_ratio_w / 2) / img_ratio_w
        val h = constrained_outer_height(node, st, if st.height_px > 0: explicit_node_h else: img_auto_h)
        out_bh[i] = h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    if st.content_visibility_hidden:
        var hidden_h = st.pad_t + st.pad_b + border_y
        if st.height_px > 0:
            hidden_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
        if st.min_height_px > 0:
            val min_hidden_h = css_outer_height(node, st, st.min_height_px)
            if min_hidden_h > hidden_h:
                hidden_h = min_hidden_h
        if hidden_h < 1:
            hidden_h = 1
        out_bh[i] = hidden_h
        return relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, hidden_h)
    val ix = x + st.border_l + st.pad_l
    var iw = node_w - st.pad_l - st.pad_r - border_x
    if iw < 1:
        iw = 1
    # border-spacing does not apply in the collapsing border model (CSS 2.1
    # 17.6.2). The UA default is `table { border-spacing: 2px }`, so reading
    # the style value directly would space out every collapsed table.
    val table_spacing_x = if st.border_collapse == "collapse": 0 else: st.border_spacing_x_px
    val table_spacing_y = if st.border_collapse == "collapse": 0 else: st.border_spacing_y_px
    val scrollbar_gutter = 15
    val content_height_limit = definite_content_height_limit(node, st)
    # border-collapse geometry (uniform-border slice, honest limits): the
    # grid tracks are sized with half-borders shared between neighbours
    # (see explicit_auto_table_column_offsets); the outer half-border of
    # the first column/row shifts the grid origin by round-half-up, the
    # last column's outer half (rounded down) is taken off the width the
    # columns fill -- Chrome's `width:400px` collapsed table spans its
    # cells over 399px, 0.5px in from each side
    # (table_collapsed_border_paint_chrome159_spec.spl) -- and each row
    # sheds the shared half of its cells' top+bottom borders.
    # Non-uniform per-edge winner widths and row/col spans are NOT
    # modelled here -- they keep the plain separate-model geometry.
    val table_collapse = st.display == "table" and st.border_collapse == "collapse"
    var collapse_outer_x = 0
    var collapse_outer_r = 0
    var collapse_outer_y = 0
    var collapse_outer_b = 0
    var collapse_row_shave = 0
    if table_collapse:
        val collapse_rows = simple_web_collect_table_rows(nodes, child_index, i)
        if collapse_rows.rows.len() > 0:
            var probe_cell = child_index.first_child[collapse_rows.rows[0]]
            while probe_cell >= 0 and styles[probe_cell].display != "table-cell":
                probe_cell = child_index.next_sibling[probe_cell]
            if probe_cell >= 0:
                collapse_outer_x = (styles[probe_cell].border_l + 1) / 2
                collapse_outer_r = styles[probe_cell].border_r / 2
                collapse_outer_y = (styles[probe_cell].border_t + 1) / 2
                collapse_outer_b = styles[probe_cell].border_b / 2
                collapse_row_shave = (
                    styles[probe_cell].border_t + styles[probe_cell].border_b
                ) / 2
    val auto_column_offsets = if (
        st.display == "table" and st.table_layout == "auto"
    ):
        # width:auto tables shrink to fit: pass 0 as the available inner
        # width so no leftover space is distributed across the columns.
        explicit_auto_table_column_offsets(
            nodes, styles, child_index, i,
            iw - collapse_outer_x - collapse_outer_r,
            table_spacing_x, table_spacing_y,
            # A table FILLS a width it states — and a PERCENTAGE width is stated
            # too. `width_px` holds a percentage as a NEGATIVE value, so the
            # obvious `width_px > 0` reads `table { width: 100% }` as
            # `width: auto` and shrink-to-fits it. Measured on the `html`
            # catalog page (whose stylesheet says exactly that at line 19),
            # that single misread moved 21 elements away from Chrome.
            st.width_px != 0
        )
    else:
        []
    if (
        st.display == "table" and (
            st.table_layout == "fixed" or
            auto_column_offsets.len() > 0 or
            table_spacing_x > 0 or
            table_spacing_y > 0
        )
    ):
        val table_rows = simple_web_collect_table_rows(
            nodes, child_index, i
        )
        val column_count = simple_web_fixed_table_column_count(
            nodes, child_index, table_rows
        )
        var table_grid_width = if (
            st.table_layout == "auto" and
            auto_column_offsets.len() > column_count
        ):
            auto_column_offsets[column_count]
        else:
            (
                iw - collapse_outer_x - collapse_outer_r -
                table_spacing_x * (column_count + 1)
            )
        if table_grid_width < column_count:
            table_grid_width = column_count
        val table_inner_width = (
            table_grid_width +
            table_spacing_x * (column_count + 1)
        )
        if table_inner_width > iw:
            out_bw[i] = out_bw[i] + table_inner_width - iw
        elif st.width_px <= 0 and auto_column_offsets.len() > 0:
            # width:auto table shrinks to fit its columns instead of filling
            # the containing block.
            out_bw[i] = (
                table_inner_width + st.pad_l + st.pad_r + border_x +
                collapse_outer_x
            )
        var table_row_width = (
            table_grid_width +
            table_spacing_x * (column_count - 1)
        )
        if table_row_width < 1:
            table_row_width = 1
        var table_y = y + st.border_t + st.pad_t
        var table_child = child_index.first_child[i]
        while table_child >= 0:
            if (
                styles[table_child].display == "table-caption" and
                styles[table_child].caption_side != "bottom"
            ):
                val caption = layout_with_style(
                    nodes, styles, child_index, table_child,
                    ix, table_y, table_inner_width, viewport_w, viewport_h,
                    out_bx, out_by, out_bw, out_bh,
                    out_wrap_starts, out_wrap_ends,
                    out_intrinsic_widths, styles[table_child]
                )
                out_bx = caption.bx
                out_by = caption.by
                out_bw = caption.bw
                out_bh = caption.bh
                out_wrap_starts = caption.wrap_starts
                out_wrap_ends = caption.wrap_ends
                out_intrinsic_widths = caption.intrinsic_widths
                table_y = table_y + caption.height
            table_child = child_index.next_sibling[table_child]
        if table_rows.rows.len() > 0:
            table_y = table_y + table_spacing_y + collapse_outer_y
        var table_row_index = 0
        while table_row_index < table_rows.rows.len():
            val table_row = table_rows.rows[table_row_index]
            val table_group = table_rows.groups[table_row_index]
            if table_group >= 0 and out_bh[table_group] == 0:
                out_bx[table_group] = ix + table_spacing_x + collapse_outer_x
                out_by[table_group] = table_y
                out_bw[table_group] = table_row_width
            out_bx[table_row] = ix + table_spacing_x + collapse_outer_x
            out_by[table_row] = table_y
            out_bw[table_row] = table_row_width
            var row_h = 1
            var used_columns = 0
            var cell = child_index.first_child[table_row]
            while cell >= 0:
                if styles[cell].display == "table-cell":
                    val span = simple_web_fixed_table_cell_span(
                        nodes[cell], column_count
                    )
                    val cell_x = if (
                        st.table_layout == "auto" and
                        auto_column_offsets.len() > used_columns
                    ):
                        (
                            ix + collapse_outer_x +
                            table_spacing_x * (used_columns + 1) +
                            auto_column_offsets[used_columns]
                        )
                    else:
                        (
                            ix + collapse_outer_x +
                            table_spacing_x * (used_columns + 1) +
                            (table_grid_width * used_columns * 2 + column_count) /
                            (column_count * 2)
                        )
                    var next_columns = used_columns + span
                    if next_columns > column_count:
                        next_columns = column_count
                    val cell_right = if (
                        st.table_layout == "auto" and
                        auto_column_offsets.len() > next_columns
                    ):
                        (
                            ix + collapse_outer_x +
                            table_spacing_x * next_columns +
                            auto_column_offsets[next_columns]
                        )
                    else:
                        (
                            ix + collapse_outer_x +
                            table_spacing_x * next_columns +
                            (table_grid_width * next_columns * 2 + column_count) /
                            (column_count * 2)
                        )
                    # border-collapse: the tracks share each border half and
                    # half, so a cell's box reaches out over the outer half of
                    # its own borders -- (b+1)/2 before, b/2 after -- and
                    # neighbouring boxes overlap on the one shared line, which
                    # is where Chrome paints it and puts the content after it
                    # (table_collapsed_border_paint_chrome159_spec.spl).
                    val lead_x = if table_collapse: (styles[cell].border_l + 1) / 2 else: 0
                    val lead_y = if table_collapse: (styles[cell].border_t + 1) / 2 else: 0
                    val box_x = cell_x - lead_x
                    val allocated_cell_width = (
                        cell_right - box_x +
                        (if table_collapse: styles[cell].border_r / 2 else: 0)
                    )
                    var cell_layout_style = styles[cell]
                    if st.table_layout == "auto":
                        var cell_layout_width = allocated_cell_width
                        if not styles[cell].border_box:
                            cell_layout_width = (
                                cell_layout_width -
                                styles[cell].pad_l - styles[cell].pad_r -
                                styles[cell].border_l - styles[cell].border_r
                            )
                        cell_layout_style = style_with_width(
                            styles[cell],
                            if cell_layout_width > 0: cell_layout_width else: 1
                        )
                    val cell_result = layout_with_style(
                        nodes, styles, child_index, cell,
                        box_x, table_y - lead_y, allocated_cell_width,
                        viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh,
                        out_wrap_starts, out_wrap_ends,
                        out_intrinsic_widths, cell_layout_style
                    )
                    out_bx = cell_result.bx
                    out_by = cell_result.by
                    out_bw = cell_result.bw
                    out_bh = cell_result.bh
                    out_wrap_starts = cell_result.wrap_starts
                    out_wrap_ends = cell_result.wrap_ends
                    out_intrinsic_widths = cell_result.intrinsic_widths
                    if cell_result.height > row_h:
                        row_h = cell_result.height
                    used_columns = next_columns
                cell = child_index.next_sibling[cell]
            if collapse_row_shave > 0 and row_h > collapse_row_shave:
                row_h = row_h - collapse_row_shave
            cell = child_index.first_child[table_row]
            while cell >= 0:
                if styles[cell].display == "table-cell":
                    out_bh[cell] = if table_collapse:
                        (
                            row_h + (styles[cell].border_t + 1) / 2 +
                            styles[cell].border_b / 2
                        )
                    else:
                        row_h
                cell = child_index.next_sibling[cell]
            out_bh[table_row] = row_h
            table_y = table_y + row_h + table_spacing_y
            if table_group >= 0:
                out_bh[table_group] = (
                    table_y - table_spacing_y -
                    out_by[table_group]
                )
            table_row_index = table_row_index + 1
        # The last row's outer bottom half-border (rounded down) is part of
        # the table: a 2px collapsed border otherwise overhangs it by 1px.
        if table_rows.rows.len() > 0:
            table_y = table_y + collapse_outer_b
        table_child = child_index.first_child[i]
        while table_child >= 0:
            if (
                styles[table_child].display == "table-caption" and
                styles[table_child].caption_side == "bottom"
            ):
                val caption = layout_with_style(
                    nodes, styles, child_index, table_child,
                    ix, table_y, table_inner_width, viewport_w, viewport_h,
                    out_bx, out_by, out_bw, out_bh,
                    out_wrap_starts, out_wrap_ends,
                    out_intrinsic_widths, styles[table_child]
                )
                out_bx = caption.bx
                out_by = caption.by
                out_bw = caption.bw
                out_bh = caption.bh
                out_wrap_starts = caption.wrap_starts
                out_wrap_ends = caption.wrap_ends
                out_intrinsic_widths = caption.intrinsic_widths
                table_y = table_y + caption.height
            table_child = child_index.next_sibling[table_child]
        var table_h = (
            table_y - y + st.pad_b + st.border_b
        )
        if st.height_px > 0:
            table_h = css_outer_height(node, st, st.height_px)
        out_bh[i] = table_h
        return relative_layout_result(
            child_index, i, st, out_bx, out_by, out_bw, out_bh,
            out_wrap_starts, out_wrap_ends, out_intrinsic_widths,
            table_h
        )
    val grid_explicit_columns = grid_track_sizes(
        st.grid_template_columns, iw, st.column_gap_px
    )
    # Without a column template the grid still has columns when implicit ones
    # are sized (`grid-auto-columns`) or made by the flow (`grid-auto-flow:
    # column`); any other template-less grid stays on the block path below.
    if st.display == "grid" and (grid_explicit_columns.len() > 0 or st.grid_auto_columns != "" or st.grid_auto_flow_column):
        # Row `fr` tracks would need the container's resolved content height,
        # which isn't generally known ahead of auto-height row sizing;
        # available_w=0 here means an `fr` row track resolves to 0px rather
        # than participating in flexible sizing (row-axis fr is out of scope
        # for this simplification — see the bug doc above).
        val explicit_rows = grid_track_sizes(st.grid_template_rows, 0, st.row_gap_px)
        val grid_child_count = child_index.child_count[i]
        val grid_row_capacity = (
            grid_child_count + explicit_rows.len() as i32 + 1
        )
        # `grid-template-areas` named-area rectangles, resolved against
        # `grid-area:<name>` references below (CSS Grid SS7.1); see
        # grid_template_area_rects for the rectangularity-validation and
        # scope notes.
        val area_rects = grid_template_area_rects(st.grid_template_areas)
        # Implicit columns (CSS Grid 7.6): a definite column or a span past
        # the template widens the row-flow grid; column flow fills
        # `grid_flow_rows` rows per column and opens a column whenever they
        # are full, so it is placed over one spare column per item and the
        # grid keeps the columns it used.
        val grid_explicit_column_count = grid_explicit_columns.len() as i32
        val grid_extents = grid_item_line_extents(styles, child_index, i)
        val grid_flow_rows = if not st.grid_auto_flow_column:
            grid_row_capacity
        elif explicit_rows.len() as i32 > 0:
            explicit_rows.len() as i32
        elif grid_extents[1] < grid_row_capacity:
            grid_extents[1]
        else:
            grid_row_capacity
        var grid_placement_columns = if grid_extents[0] > grid_explicit_column_count: grid_extents[0] else: grid_explicit_column_count
        if st.grid_auto_flow_column:
            grid_placement_columns = grid_placement_columns + grid_child_count
        val grid_placements = grid_item_placements(
            styles, child_index, i, st, area_rects,
            grid_placement_columns, grid_row_capacity, grid_flow_rows
        )
        var grid_column_count = grid_explicit_column_count
        var grid_placement_index = 0
        while grid_placement_index < grid_placements.len() as i32:
            val placed_column_end = grid_placements[grid_placement_index + 1] + grid_placements[grid_placement_index + 3]
            if grid_placements[grid_placement_index] >= 0 and placed_column_end > grid_column_count:
                grid_column_count = placed_column_end
            grid_placement_index = grid_placement_index + 4
        grid_placement_index = 0
        val grid_columns = if grid_column_count == grid_explicit_column_count:
            grid_explicit_columns
        else:
            grid_column_sizes_with_implicit(
                nodes, styles, child_index, i, st, grid_placements,
                grid_explicit_column_count, grid_column_count, iw, out_intrinsic_widths
            )
        var grid_rows: [i32] = [0; grid_row_capacity]
        # A FIXED row (explicit, or a `grid-auto-rows` length) never grows with
        # its items; every other implicit row is content sized from its
        # `grid-auto-rows` floor, and `fr` implicit rows are equalized below.
        var grid_row_fixed: [bool] = [false; grid_row_capacity]
        var grid_row_fr: [i32] = [0; grid_row_capacity]
        val grid_auto_tracks = if st.grid_auto_rows == "": [] else: st.grid_auto_rows.split(" ")
        var explicit_row_index = 0
        while explicit_row_index < grid_row_capacity:
            if explicit_row_index < explicit_rows.len() as i32:
                grid_rows[explicit_row_index] = explicit_rows[explicit_row_index]
                grid_row_fixed[explicit_row_index] = true
            elif grid_auto_tracks.len() > 0:
                val auto_track = grid_auto_tracks[(explicit_row_index - explicit_rows.len() as i32) % (grid_auto_tracks.len() as i32)]
                if auto_track.ends_with("fr"):
                    grid_row_fr[explicit_row_index] = parse_int(auto_track)
                elif auto_track != "auto":
                    grid_rows[explicit_row_index] = parse_int(auto_track)
                    grid_row_fixed[explicit_row_index] = auto_track.ends_with("px")
            explicit_row_index = explicit_row_index + 1
        # Items are laid out once in source order, then re-laid in a second
        # pass when the final row sizes move or stretch them.
        var grid_item_nodes: [i32] = []
        var grid_item_rows: [i32] = []
        var grid_item_row_spans: [i32] = []
        var grid_item_xs: [i32] = []
        var grid_item_ys: [i32] = []
        var grid_item_ws: [i32] = []
        var grid_item_margin_ts: [i32] = []
        var grid_item_margin_ys: [i32] = []
        var grid_item_heights: [i32] = []
        var grid_item_stretch: [bool] = []
        var grid_item_aligns: [text] = []
        var grid_item_styles: [Style] = []
        var max_grid_row = explicit_rows.len() as i32
        var grid_child = child_index.first_child[i]
        while grid_child >= 0:
            val grid_child_style = styles[grid_child]
            if simple_web_style_hot_is_display_none(computed_style_hot_from(grid_child_style)):
                out_bw[grid_child] = 0
                out_bh[grid_child] = 0
                grid_placement_index = grid_placement_index + 4
                grid_child = child_index.next_sibling[grid_child]
                continue
            val grid_row = grid_placements[grid_placement_index]
            val grid_column = grid_placements[grid_placement_index + 1]
            val grid_row_span = grid_placements[grid_placement_index + 2]
            val grid_column_span = grid_placements[grid_placement_index + 3]
            grid_placement_index = grid_placement_index + 4
            # The grid AREA is the item's containing block (CSS Grid 6.1 / 11.1):
            # percent margins on all four sides are of its inline size, and the
            # item's margin box fills it (Chrome 159). Auto inline margins
            # keep the legacy 0 here.
            val grid_child_width = grid_track_span_size(
                grid_columns, st.column_gap_px,
                grid_column, grid_column_span
            )
            val grid_margin_l = if grid_child_style.margin_l_auto: 0 else: resolve_horizontal_margin_px(grid_child_style.margin_l, grid_child_width)
            val grid_margin_r = if grid_child_style.margin_r_auto: 0 else: resolve_horizontal_margin_px(grid_child_style.margin_r, grid_child_width)
            val grid_child_x = (
                ix + grid_track_offset(
                    grid_columns, st.column_gap_px, grid_column
                ) + grid_margin_l
            )
            val grid_margin_t = vertical_margin_px_in(
                grid_child_style, true, viewport_h, grid_child_width
            )
            val grid_margin_b = vertical_margin_px_in(
                grid_child_style, false, viewport_h, grid_child_width
            )
            val grid_child_y = (
                y + st.border_t + st.pad_t +
                grid_track_offset(grid_rows, st.row_gap_px, grid_row) +
                grid_margin_t
            )
            val grid_item_align = effective_item_align(
                st, grid_child_style
            )
            val grid_child_is_replaced = grid_item_is_replaced(
                nodes[grid_child]
            )
            val grid_explicit_stretch = (
                grid_item_align == "stretch" and (
                    grid_child_style.align_self == "stretch" or
                    st.align_items_authored
                )
            )
            # `normal` stretches only when automatic sizing has not already
            # produced an intrinsic/aspect-ratio block size. Explicit stretch
            # may replace that automatic used size for this bounded slice.
            val grid_normal_stretch = (
                (
                    grid_item_align == "normal" or (
                        grid_child_style.align_self == "auto" and
                        not st.align_items_authored
                    )
                ) and
                grid_child_style.height_px == 0
            )
            # Percentage min-/max- sizes are of the grid area.
            var resolved_grid_child_style = style_with_resolved_percent_min_max(style_with_resolved_percent_margins(style_with_resolved_percent_padding(grid_child_style, grid_child_width), grid_child_width, viewport_h), grid_child_width, 0)
            # An auto-width item's margin box fills the area; a specified
            # (px or percent) width still resolves against the whole area.
            val grid_auto_w = grid_child_style.width_px == 0 and not grid_child_style.width_zero
            var grid_item_w = if grid_auto_w: grid_child_width - grid_margin_l - grid_margin_r else: grid_child_width
            if grid_item_w < 0:
                grid_item_w = 0
            if grid_auto_w and (grid_child_style.min_width_px < 0 or grid_child_style.max_width_px < 0):
                grid_item_w = constrained_outer_width(nodes[grid_child], resolved_grid_child_style, grid_item_w)
            # Stretch only an auto-size, non-replaced item (in one column or
            # spanning several), when block-axis auto margins do not own the
            # free space. Rows that are all FIXED are already final, so the
            # item stretches now; a content sized row is only known after
            # every item, so it stretches in the second pass.
            val grid_stretches = (
                (grid_explicit_stretch or grid_normal_stretch) and
                grid_child_style.height_auto and
                not grid_child_style.margin_t_auto and
                not grid_child_style.margin_b_auto and
                not grid_child_is_replaced
            )
            var grid_rows_final = true
            var grid_final_index = 0
            while grid_final_index < grid_row_span:
                if not grid_row_fixed[grid_row + grid_final_index]:
                    grid_rows_final = false
                grid_final_index = grid_final_index + 1
            if grid_stretches and grid_rows_final:
                resolved_grid_child_style = grid_stretched_item_style(
                    nodes[grid_child], grid_child_style, resolved_grid_child_style,
                    grid_track_span_size(grid_rows, st.row_gap_px, grid_row, grid_row_span) -
                        grid_margin_t - grid_margin_b
                )
            val grid_result = layout_with_style(
                nodes, styles, child_index, grid_child,
                grid_child_x, grid_child_y, grid_item_w, viewport_w, viewport_h,
                out_bx, out_by, out_bw, out_bh,
                out_wrap_starts, out_wrap_ends, out_intrinsic_widths,
                resolved_grid_child_style
            )
            out_bx = grid_result.bx
            out_by = grid_result.by
            out_bw = grid_result.bw
            out_bh = grid_result.bh
            out_wrap_starts = grid_result.wrap_starts
            out_wrap_ends = grid_result.wrap_ends
            out_intrinsic_widths = grid_result.intrinsic_widths
            if (
                grid_row_span == 1 and not grid_row_fixed[grid_row] and
                grid_result.height + grid_margin_t + grid_margin_b > grid_rows[grid_row]
            ):
                grid_rows[grid_row] = grid_result.height + grid_margin_t + grid_margin_b
            if grid_row + grid_row_span > max_grid_row:
                max_grid_row = grid_row + grid_row_span
            grid_item_nodes.push(grid_child)
            grid_item_rows.push(grid_row)
            grid_item_row_spans.push(grid_row_span)
            grid_item_xs.push(grid_child_x)
            grid_item_ys.push(grid_child_y)
            grid_item_ws.push(grid_item_w)
            grid_item_margin_ts.push(grid_margin_t)
            grid_item_margin_ys.push(grid_margin_t + grid_margin_b)
            grid_item_heights.push(grid_result.height)
            grid_item_stretch.push(grid_stretches and not grid_rows_final)
            grid_item_aligns.push(if grid_stretches: "stretch" else: grid_item_align)
            grid_item_styles.push(resolved_grid_child_style)
            grid_child = child_index.next_sibling[grid_child]
        # A row-spanning item shares what its rows still lack equally among
        # the content sized rows it spans (CSS Grid 12.5 step 3; Chrome 159).
        var grid_span_item = 0
        while grid_span_item < grid_item_nodes.len() as i32:
            val span_row = grid_item_rows[grid_span_item]
            val span_count = grid_item_row_spans[grid_span_item]
            var span_growable = 0
            var span_index = 0
            while span_index < span_count:
                if not grid_row_fixed[span_row + span_index]:
                    span_growable = span_growable + 1
                span_index = span_index + 1
            val span_deficit = (
                grid_item_heights[grid_span_item] + grid_item_margin_ys[grid_span_item] -
                grid_track_span_size(grid_rows, st.row_gap_px, span_row, span_count)
            )
            if span_count > 1 and span_growable > 0 and span_deficit > 0:
                var span_given = 0
                span_index = 0
                while span_index < span_count:
                    if not grid_row_fixed[span_row + span_index]:
                        span_given = span_given + 1
                        grid_rows[span_row + span_index] = (
                            grid_rows[span_row + span_index] +
                            span_deficit * span_given / span_growable -
                            span_deficit * (span_given - 1) / span_growable
                        )
                    span_index = span_index + 1
            grid_span_item = grid_span_item + 1
        # `fr` implicit rows of an auto-height grid share one flex fraction:
        # the largest content size per `fr` among them (CSS Grid 12.7.1).
        var grid_fr_unit = 0
        var grid_fr_row = 0
        while grid_fr_row < max_grid_row:
            if grid_row_fr[grid_fr_row] > 0:
                val fr_unit = (grid_rows[grid_fr_row] + grid_row_fr[grid_fr_row] - 1) / grid_row_fr[grid_fr_row]
                if fr_unit > grid_fr_unit:
                    grid_fr_unit = fr_unit
            grid_fr_row = grid_fr_row + 1
        grid_fr_row = 0
        while grid_fr_row < max_grid_row:
            if grid_row_fr[grid_fr_row] > 0:
                grid_rows[grid_fr_row] = grid_fr_unit * grid_row_fr[grid_fr_row]
            grid_fr_row = grid_fr_row + 1
        # Second pass: the rows are final. Re-lay an item whose row offset
        # moved, that stretches to a content sized row, or that `align-self`
        # / `align-items` centres or end-aligns in its rows.
        var grid_final_item = 0
        while grid_final_item < grid_item_nodes.len() as i32:
            val final_node = grid_item_nodes[grid_final_item]
            val final_row = grid_item_rows[grid_final_item]
            val final_free = (
