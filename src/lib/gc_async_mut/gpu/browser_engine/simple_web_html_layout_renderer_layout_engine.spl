                    var float_fit = flex_item_max_content_width(nodes, styles, child_index, c)
                    val float_inline_fit = intrinsic_text_width(nodes, styles, child_index, c, out_intrinsic_widths)
                    out_intrinsic_widths = float_inline_fit.widths
                    if float_inline_fit.width > float_fit:
                        float_fit = float_inline_fit.width
                    float_fit = float_fit + percent_padding_extra_w(styles[c], cst)
                    if float_fit > iw - fml - fmr:
