                    if in_inline_run:
                        ax = inline_x
                    abs_containing_w = abs_cb_x + abs_cb_w - ax
                    if abs_containing_w < 0:
                        abs_containing_w = 0
                elif not cst.left_auto:
                    ax = abs_cb_x + cst.left_px
