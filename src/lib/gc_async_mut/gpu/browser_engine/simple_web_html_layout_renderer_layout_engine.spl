                css_outer_width(nodes[c], cst, cst.width_px)
            else:
                legend_intrinsic.width
            if legend_w > iw:
                legend_w = iw
            if legend_w < 1:
                legend_w = 1
            val legend = layout_with_style(nodes, styles, child_index, c, ix, y, legend_w, viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, cst)
            out_bx = legend.bx
            out_by = legend.by
            out_bw = legend.bw
            out_bh = legend.bh
            out_wrap_starts = legend.wrap_starts
            out_wrap_ends = legend.wrap_ends
            out_intrinsic_widths = legend.intrinsic_widths
            val legend_top_h = if out_bh[c] > st.border_t: out_bh[c] else: st.border_t
            cy = y + legend_top_h + st.pad_t
            cy_frac = 0
            in_inline_run = false
            inline_line_h = 0
            prev_margin_b = 0
            child_count = child_count + 1
            c = child_index.next_sibling[c]
            continue
