 fb_rounded_rect_row_span_opacity_clip, fb_rounded_rect_corners_opacity_clip, fb_style_rounded_rect_opacity_clip, fb_blend_cov_row, fb_soft_box_shadow, paint_box_shadow, gradient_dither_threshold, mix_channel_gradient_centered, mix_color_vertical_centered, background_gradient_pixel_opacity, fb_style_background_opacity_clip, fb_background_radial_stack_clip, fb_border_sides_clip, fb_outline_clip, fb_text_underline, fb_text_underline_clip, fb_glyph_thin_scaled_clip, fb_text_thin_scaled_clip_range, fb_text_thin_scaled_clip_range_adv, apply_text_transform_for_paint, reverse_text_for_paint, fb_glyph_sparse, fb_text_sparse_range, fb_px, fb_generated_widget_chrome_text, WidgetPaintFlags, compute_widget_paint_flags, is_text_flow_fixture, fb_text_flow_chrome_overlay}
