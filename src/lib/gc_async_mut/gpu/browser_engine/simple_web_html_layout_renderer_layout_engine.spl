                # parent's padding back and subtract the insets themselves.
                abs_containing_w = abs_containing_w - st.pad_l - st.pad_r
                val abs_containing_h = if abs_cb[2] > 0: abs_cb[2] else: absolute_containing_h
                resolved_cst = absolute_child_style(st, cst, abs_containing_w, abs_containing_h, nodes[c].tag)
                absolute_w = absolute_outer_width(
                    nodes, styles, child_index, c, st, nodes[c], cst, abs_containing_w
                )
                if cst.left_auto and cst.right_px >= 0:
                    ax = abs_cb_x + abs_cb_w - cst.right_px - absolute_w
            val child = layout_with_style(nodes, styles, child_index, c, ax, ay, absolute_w, viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
            out_bx = child.bx
            out_by = child.by
            out_bw = child.bw
            out_bh = child.bh
            out_wrap_starts = child.wrap_starts
            out_wrap_ends = child.wrap_ends
