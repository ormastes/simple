                # with both auto the box starts at its static position, the
                # pen (a ratio-only svg after an 8.9 px `a` is 891x891).
                val abs_cb = inline_parent_containing_block(nodes, styles, i, true, out_bx, out_bw)
                val abs_cb_x = abs_cb[0]
                val abs_cb_w = abs_cb[1]
                var abs_containing_w = abs_cb_w
