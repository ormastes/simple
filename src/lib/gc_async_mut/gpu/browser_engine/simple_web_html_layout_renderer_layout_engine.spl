                # Short inline pieces (intrinsic <= available) are unaffected.
                # white-space:nowrap remains intrinsic width unless the parent
                # requested text-overflow:ellipsis, which needs a bounded box.
                # White-space collapsing keeps ONE space between an inline
                # sibling and a following text run on the SAME line; only a
                # space at the START OF A LINE is dropped (CSS 2.1 §16.6.1).
                # `text_trimmed` trims unconditionally, so a `#text` placed at a
                # non-zero pen lost the space that separates it from the
                # `<code>`/`<span>` before it — measured on the catalog `<li>`s:
                # `<code>align-self</code> — partial; …` is 88 px in Chrome and
                # 64 in Simple, while the same markup with the space DELETED is
                # 64 in Chrome too, and the same text at pen 0 is 64 in both.
                # The missing ~4 px let a 631 px run sit inside a 632 px gap
                # that Chrome wraps, costing one line box per such `<li>`.
                if (
                    nodes[c].tag == "#text" and
                    not cst.white_space_nowrap and
                    inline_x > inline_start_x and
                    text_starts_with_collapsible_space(nodes[c].text_data)
                ):
                    inline_x = inline_x + resolved_space_advance(
                        cst, text_codepoints(nodes[c].text_trimmed)
                    )
                if nodes[c].tag == "#text" and (not cst.white_space_nowrap or cst.text_overflow_ellipsis):
                    val avail_inline = iw - inline_x
                    if avail_inline > 0 and inline_w > avail_inline:
                        inline_w = avail_inline
                # text-align: paint aligns each wrapped line within the #text
                # BOX, so a shrink-to-fit lone text run can never center/right.
                # Give a sole #text child of an aligned block the full content
                # width; the paint-side text_line_aligned_x does the rest.
                # Scope, stated honestly: single-#text-child runs only —
                # multi-child inline runs still need run-level shifting.
                if (
                    nodes[c].tag == "#text" and
                    (st.text_align == "center" or st.text_align == "right") and
                    child_index.child_count[i] == 1 and
                    not cst.white_space_nowrap
                ):
                    val full_inline = iw - inline_x
                    if full_inline > inline_w:
                        inline_w = full_inline
                val inline_outer_w = (
                    inline_margin_l + inline_w + inline_margin_r
                )
                # An inline REPLACED box is atomic exactly like an inline-block:
                # it cannot be split across lines, so it wraps whole when it no
                # longer fits the remainder of the current line.
                if (
                    (inline_block or inline_replaced) and inline_x > 0 and
                    inline_x + inline_outer_w > iw
                ):
                    val aligned = align_inline_line_baselines(
                        child_index, st, nodes, inline_baseline_nodes,
                        inline_baseline_margin_ts, inline_baseline_margin_bs,
                        styles, cy,
                        inline_line_h, out_bx, out_by, out_bh
                    )
                    out_bx = aligned.bx
                    out_by = aligned.by
                    cy = cy + aligned.height
                    inline_x = inline_start_x
                    inline_line_h = style_line_h(cst)
                    inline_baseline_nodes = []
                    inline_baseline_margin_ts = []
                    inline_baseline_margin_bs = []
                var inline_y = cy
                if cst.vertical_align == "sub" or cst.vertical_align == "super":
                    val baseline_shift = st.font_size / 4
                    inline_y = inline_y + if cst.vertical_align == "sub": baseline_shift else: 0 - baseline_shift
                val child = layout_with_style(nodes, styles, child_index, c, ix + inline_x + inline_margin_l, inline_y, inline_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_inline_style)
                out_bx = child.bx
                out_by = child.by
                out_bw = child.bw
                out_bh = child.bh
                out_wrap_starts = child.wrap_starts
                out_wrap_ends = child.wrap_ends
                out_intrinsic_widths = child.intrinsic_widths
                if nodes[c].tag == "#text":
                    # Reserve the WRAPPED height: a text node that wraps to N
                    # lines occupies N*line-height, not one line. Collapsing it to
                    # a single line under-counts the inline run height, so cy
                    # advances too little and the next block overlaps the wrapped
                    # tail (see web_render_line_height_overlap_at_bottom).
                    val wrap_lines = out_wrap_starts[c].len()
                    val text_lines = if wrap_lines > 0: wrap_lines else: 1
                    out_bh[c] = text_lines * style_line_h(cst)
                elif (
                    cst.display == "inline" and
                    not grid_item_is_replaced(nodes[c])
                ):
                    # An inline element that fits on one line is its CONTENT
                    # AREA, not the whole line box — see
                    # inline_content_area_height. A taller box means the element
                    # genuinely wrapped, and keeps the height layout gave it.
                    # REPLACED elements (img/input/select/video/...) are excluded:
                    # their box is their intrinsic size, not a font metric.
                    val inline_content_h = inline_content_area_height(cst)
                    if out_bh[c] > 1 and out_bh[c] <= style_line_h(cst):
                        out_bh[c] = inline_content_h
                var inline_contribution_h = out_bh[c]
                if nodes[c].tag == "button":
                    inline_contribution_h = inline_contribution_h + 3
                if inline_contribution_h > inline_line_h:
                    inline_line_h = inline_contribution_h
                if cst.vertical_align == "baseline" and (
                    cst.display == "inline" or
                    child_index.child_count[c] == 0
                ):
                    inline_baseline_nodes = inline_baseline_nodes.push(c)
                    # Baseline math consumes resolved pixels, never the Style
                    # vh/negative sentinel encoding.
                    inline_baseline_margin_ts = inline_baseline_margin_ts.push(
                        resolve_vertical_margin_px(cst.margin_t, viewport_h)
                    )
                    inline_baseline_margin_bs = inline_baseline_margin_bs.push(
                        resolve_vertical_margin_px(cst.margin_b, viewport_h)
                    )
                inline_x = (
                    inline_x + inline_margin_l + out_bw[c] +
                    inline_margin_r
                )
                prev_margin_b = 0
                child_count = child_count + 1
                c = child_index.next_sibling[c]
                continue
            if in_inline_run:
                val aligned = align_inline_line_baselines(
                    child_index, st, nodes, inline_baseline_nodes,
                    inline_baseline_margin_ts, inline_baseline_margin_bs,
                    styles, cy,
                    inline_line_h, out_bx, out_by, out_bh
                )
                out_bx = aligned.bx
                out_by = aligned.by
                cy = cy + aligned.height
                in_inline_run = false
                inline_x = inline_start_x
                inline_line_h = 0
                inline_baseline_nodes = []
                inline_baseline_margin_ts = []
                inline_baseline_margin_bs = []
            if child_count > 0:
                cy = cy + st.gap_px
            val prev_margin_b_before_child = prev_margin_b
            val resolved_cst_margin_t = resolve_vertical_margin_px(cst.margin_t, viewport_h)
            val collapsed_margin = collapse_margins_signed(prev_margin_b, resolved_cst_margin_t)
            var child_top_advance = 0
            if child_count == 0 and nodes[i].tag == "body" and st.border_t == 0 and st.pad_t == 0:
                val resolved_st_margin_t = resolve_vertical_margin_px(st.margin_t, viewport_h)
                val collapsed_body_top = collapse_margins_signed(resolved_st_margin_t, resolved_cst_margin_t)
                child_top_advance = collapsed_body_top - resolved_st_margin_t
                cy = cy + child_top_advance
            else:
                child_top_advance = collapsed_margin
                cy = cy + collapsed_margin
            var child_inner_w = iw
            if st.overflow_auto_y and content_height_limit > 0:
                child_inner_w = child_inner_w - scrollbar_gutter
            if child_inner_w < 1:
                child_inner_w = 1
            val cml = resolve_horizontal_margin_px(cst.margin_l, child_inner_w)
            val cmr = resolve_horizontal_margin_px(cst.margin_r, child_inner_w)
            var child_w = child_inner_w - cml - cmr
            if child_w < 1:
                child_w = 1
            # Horizontal margin:auto centering. When an in-flow block has an
            # explicit (non-auto) width narrower than the available space and
            # left/right margins are auto, the free space is distributed: both
            # auto -> centered, one auto -> pushed to that side.
            var auto_offset = 0
            if cst.margin_l_auto or cst.margin_r_auto:
                val child_outer = if cst.width_px > 0:
                    css_outer_width(nodes[c], cst, cst.width_px)
                elif cst.width_px < 0:
                    css_outer_width(nodes[c], cst, child_w * (0 - cst.width_px) / 100)
                else:
                    0
                if child_outer > 0 and child_outer < child_w:
                    val free = child_w - child_outer
                    if cst.margin_l_auto and cst.margin_r_auto:
                        auto_offset = free / 2
                    elif cst.margin_l_auto:
                        auto_offset = free
            val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
            val resolved_cst = if child_height_px > 0 and child_height_px != cst.height_px:
                style_with_height(cst, child_height_px)
            else:
                cst
            val child = layout_with_style(nodes, styles, child_index, c, ix + cml + auto_offset, cy, child_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
            out_bx = child.bx
            out_by = child.by
            out_bw = child.bw
            out_bh = child.bh
            out_wrap_starts = child.wrap_starts
            out_wrap_ends = child.wrap_ends
            out_intrinsic_widths = child.intrinsic_widths
            # CSS 2.2 8.3.1 leading half. The child's EFFECTIVE top margin is
            # its declared margin-top collapsed with whatever margin escaped
            # through its own top edge (child.leading_margin_t), and that is
            # only known after the child is laid out -- the advance above was
            # computed from the declared value alone. Correct the difference by
            # translating the child subtree, which is the same two-phase
            # mechanics offset_layout_subtree already serves elsewhere.
            val effective_cst_margin_t = collapse_margins_signed(
                resolved_cst_margin_t, child.leading_margin_t)
            var corrected_top_advance = child_top_advance
            if child.leading_margin_t != 0:
                if child_count == 0 and nodes[i].tag == "body" and st.border_t == 0 and st.pad_t == 0:
                    val body_margin_t = resolve_vertical_margin_px(st.margin_t, viewport_h)
                    corrected_top_advance = collapse_margins_signed(
                        body_margin_t, effective_cst_margin_t) - body_margin_t
                else:
                    corrected_top_advance = collapse_margins_signed(
                        prev_margin_b_before_child, effective_cst_margin_t)
            # When THIS block also lets a top margin through, the whole
            # effective leading margin leaves the box: the first in-flow child
            # sits on the content top edge and the margin becomes this block's
            # own leading margin for its parent to collapse.
            val escapes_top = (
                child_count == 0 and
                block_top_margin_collapses_through(nodes, styles, i, st)
            )
            if escapes_top:
                leading_margin_t = effective_cst_margin_t
                corrected_top_advance = 0
            if corrected_top_advance != child_top_advance:
                val retopped = offset_layout_subtree(
                    child_index, c, 0, corrected_top_advance - child_top_advance,
                    out_bx, out_by)
                out_bx = retopped.bx
                out_by = retopped.by
                cy = cy + (corrected_top_advance - child_top_advance)
                child_top_advance = corrected_top_advance
            cy = cy + child.height
            val resolved_cst_margin_b = resolve_vertical_margin_px(cst.margin_b, viewport_h)
            # CSS 2.2 §8.3.1 self-collapsing block: an in-flow block with no
            # border, padding, height, or content collapses its own top and
            # bottom margins into ONE margin that then collapses with the
            # adjacent siblings'. Without this, every blank markdown line in
            # the office WYSIWYG preview (an empty <p> with 1em margins)
            # pushed later blocks ~20px below where Chromium/WebKitGTK put
            # them (three-host office capture diff, 2026-08-19).
            # child.height <= 1: an empty block is floored to 1px by the
            # min-size clamp, so 0 and 1 both mean "no content"; a real 1px
            # box declares height:1px and is excluded by height_px == 0.
            val self_collapsing = child.height <= 1 and
                nodes[c].tag != "#text" and
                cst.border_t == 0 and cst.border_b == 0 and
                cst.pad_t == 0 and cst.pad_b == 0 and
                cst.height_px == 0 and cst.min_height_px == 0
            if self_collapsing:
                # Pull back the top-margin advance and carry the collapsed
                # (prev_bottom, own top, own bottom) margin to the next sibling.
                cy = cy - child_top_advance - child.height
                out_by[c] = cy
                prev_margin_b = collapse_margins_signed(
                    prev_margin_b_before_child,
                    collapse_margins_signed(
                        resolved_cst_margin_t,
                        collapse_margins_signed(
                            resolved_cst_margin_b, child.trailing_margin_b)))
            else:
                # The child's own trailing margin (one that collapsed through
                # it, CSS 2.2 8.3.1) collapses with the child's declared
                # bottom margin and becomes what separates it from the next
                # sibling.
                prev_margin_b = collapse_margins_signed(
                    resolved_cst_margin_b, child.trailing_margin_b)
            child_count = child_count + 1
        c = child_index.next_sibling[c]
    if child_count > 0:
        if in_inline_run:
            val aligned = align_inline_line_baselines(
                child_index, st, nodes, inline_baseline_nodes,
                inline_baseline_margin_ts, inline_baseline_margin_bs,
                styles, cy,
                inline_line_h, out_bx, out_by, out_bh
            )
            out_bx = aligned.bx
            out_by = aligned.by
            cy = cy + aligned.height
        if block_bottom_margin_collapses_through(nodes, styles, i, st):
            trailing_margin_b = prev_margin_b
        else:
            cy = cy + prev_margin_b
    var h = (cy - y) + st.pad_b + st.border_b
    val explicit_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
    if st.height_px > 0:
        h = explicit_h
    if st.min_height_px > 0:
        val min_h = css_outer_height(node, st, st.min_height_px)
        if min_h > h:
            h = min_h
    if st.max_height_px > 0:
        val max_h = css_outer_height(node, st, st.max_height_px)
        if max_h < h:
            h = max_h
    if st.min_height_vh and viewport_h > h:
        h = viewport_h
    val generated_panel_fill = nodes[i].has_widget_panel_class
    if st.flex_fill or generated_panel_fill:
        val fill_bottom_blk = viewport_h - ancestor_bottom_inset(nodes, styles, i)
        if fill_bottom_blk - y > h:
            h = fill_bottom_blk - y
    if h < 1:
        h = 1
    out_bh[i] = h
    val placed = relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    LayoutResult(bx: placed.bx, by: placed.by, bw: placed.bw, bh: placed.bh, wrap_starts: placed.wrap_starts, wrap_ends: placed.wrap_ends, intrinsic_widths: placed.intrinsic_widths, height: placed.height, trailing_margin_b: trailing_margin_b, leading_margin_t: leading_margin_t)

# ---------------------------------------------------------------------------
# Layout-stage leaf timers (2026-09-13, round 13).
#
# Round 12 §4 recorded that the `layout()` window had NO timers at all and was
# the largest unattributed mass in the cold pipeline. These wrappers are the
# whole instrument: each delegates to the untouched `_lay_*_inner` body, so
# behaviour is unchanged, and charges its INCLUSIVE wall time to one bucket of
# `web_layout_counters_report()` only while `SIMPLE_WEB_STYLE_COUNTERS=1` is
# armed. When it is not armed the wrapper is a straight tail call and reads no
# clock, matching the default-off discipline of every counter in this engine.
#
# Nesting is real and is NOT subtracted, exactly as `sec_resolve` nests inside
# `sec_metrics`: `lay_wrap` contains the fallback `compute_wrap_ranges`,
# `lay_intrinsic` contains its own recursion over a subtree, and the flex and
# table buckets call the measure leaves. Read the buckets as "time under this
# helper", never as a partition that must sum to the layout window.
