                line_iw = float_ctx_right_edge(cy, cy + line_probe_h, ix + iw) - ix
                inline_x = inline_start_x
                inline_line_h = 0
                inline_baseline_nodes = []
                line_nodes = []
                inline_baseline_margin_ts = []
                inline_baseline_margin_bs = []
            if child_count > 0:
                cy = cy + st.gap_px
            val prev_margin_b_before_child = prev_margin_b
            val resolved_cst_margin_t = block_margin_milli(cst, true, viewport_h, iw)
            val collapsed_margin = collapse_margins_signed(prev_margin_b, resolved_cst_margin_t)
            val cy_frac_before_top = cy_frac
            var top_frac_restore = cy_frac_before_top
            var child_top_milli = 0
            if child_count == 0 and nodes[i].tag == "body" and st.border_t == 0 and st.pad_t == 0:
                val resolved_st_margin_t = block_margin_milli(st, true, viewport_h, viewport_w)
                val collapsed_body_top = collapse_margins_signed(resolved_st_margin_t, resolved_cst_margin_t)
                child_top_milli = collapsed_body_top - resolved_st_margin_t
            else:
                child_top_milli = collapsed_margin
            var child_top_advance = cursor_advance_px(cy_frac, child_top_milli)
            cy_frac = cursor_advance_frac(cy_frac, child_top_milli)
            cy = cy + child_top_advance
            # `clear` (CSS 2.2 9.5.2): the block's border top goes below the
            # margin box of every float it names; that clearance replaces
            # whatever part of the collapsed top margin it covers.
            var clearance_y = -2147483648
            if cst.clear_mode != 0:
                clearance_y = float_ctx_clear_bottom(cst.clear_mode)
                if clearance_y > cy:
                    cy = clearance_y
                    cy_frac = 0
                    top_frac_restore = 0
            var child_inner_w = iw
            if st.overflow_auto_y and content_height_limit > 0:
                child_inner_w = child_inner_w - scrollbar_gutter
            if child_inner_w < 1:
                child_inner_w = 1
            val cml = resolve_horizontal_margin_px(cst.margin_l, child_inner_w)
            val cmr = resolve_horizontal_margin_px(cst.margin_r, child_inner_w)
            var child_w = child_inner_w - cml - cmr
            if child_w < 1:
                child_w = 1
            # Percentage min-/max- sizes resolve against this containing block
            # (`max-width:80%; margin:0 auto` centres on the resolved clamp).
            val pct_cst = style_with_resolved_percent_min_max(cst, child_inner_w, content_height_limit)
            # Horizontal margin:auto centering. When an in-flow block has an
            # explicit (non-auto) width narrower than the available space and
            # left/right margins are auto, the free space is distributed: both
            # auto -> centered, one auto -> pushed to that side.
            var auto_offset = 0
            if cst.margin_l_auto or cst.margin_r_auto:
                # A px or % width is clamped by max-width BEFORE the free space
                # is measured: `width: min(1100px, 100%)` is `width: 100%` plus
                # an implied max-width, and 100% of the container left nothing
                # to share (test/01_unit/browser_engine/
                # margin_auto_clamped_width_centering_spec.spl).
                val authored_w = if cst.width_px > 0 or cst.width_zero:
                    cst.width_px
                elif cst.width_px < 0:
                    child_w * (0 - cst.width_px) / 100
                else:
                    0
                val max_clamped_w = if pct_cst.max_width_px > 0 and authored_w > pct_cst.max_width_px:
                    pct_cst.max_width_px
                else:
                    authored_w
                # min-width wins over max-width (CSS 2.1 10.4), auto width included.
                val clamped_w = if pct_cst.min_width_px > 0 and (max_clamped_w > 0 or pct_cst.max_width_px > 0):
                    val floor_w = if max_clamped_w > 0: max_clamped_w else: pct_cst.max_width_px
                    if floor_w < pct_cst.min_width_px: pct_cst.min_width_px else: floor_w
                else:
                    max_clamped_w
                val child_outer = if clamped_w > 0:
                    css_outer_width(nodes[c], cst, clamped_w)
                elif pct_cst.max_width_px > 0:
                    # width:auto clamped by max-width (gap B, 2026-10-05):
                    # the used width is min(available, max-width), so the
                    # auto margins share whatever the clamp leaves free -
                    # `max-width: 26em; margin: auto` (example.com) centres.
                    css_outer_width(nodes[c], cst, pct_cst.max_width_px)
                else:
                    0
                if child_outer > 0 and child_outer < child_w:
                    val free = child_w - child_outer
                    if cst.margin_l_auto and cst.margin_r_auto:
                        auto_offset = free / 2
                    elif cst.margin_l_auto:
                        auto_offset = free
            val child_height_px = resolve_percent_height_px(cst.height_px, content_height_limit)
            val resolved_cst = if child_height_px > 0 and child_height_px != cst.height_px:
                style_with_height(pct_cst, child_height_px)
            else:
                pct_cst
            # A block that establishes a new formatting context may not
            # overlap a float's margin box anywhere over its HEIGHT (CSS 2.2
            # 9.5): it takes the room the floats leave over [top, top +
            # height) -- narrowed when its width is auto -- or moves below
            # the nearest float bottom and tries again. An auto height is
            # measured by laying the box out at the candidate position; that
            # trial is kept as the final layout when the box stays there.
            var child_x = ix + cml + auto_offset
            var trial_valid = false
            var trial_x = 0
            var trial_y = 0
            var trial_w = 0
            var trial_height = 0
            var trial_leading_margin_t = 0
            var trial_trailing_margin_b = 0
            var trial_end_frac = 0
            var trial_end_valid = false
            val cy_before_beside = cy
            if float_ctx_count() > g_float_base and cy < g_float_max_y1 and float_ctx_establishes_bfc(nodes, styles, c, cst):
                val beside_x0 = child_x
                val beside_w0 = child_w
                val beside_min_w = if cst.width_px > 0 or cst.width_zero: css_outer_width(nodes[c], cst, cst.width_px) else: 1
                var beside_guard = float_ctx_count() + 2
                while beside_guard > 0:
                    val top_left = float_ctx_left_edge(cy, cy + 1, beside_x0)
                    val top_right = float_ctx_right_edge(cy, cy + 1, beside_x0 + beside_w0)
                    var beside_h = 1
                    if top_right - top_left >= beside_min_w:
                        if resolved_cst.height_px > 0:
                            beside_h = css_outer_height(nodes[c], resolved_cst, resolved_cst.height_px)
                        else:
                            val beside_try_w = if cst.width_px == 0 and not cst.width_zero: top_right - top_left else: beside_w0
                            g_origin_frac_milli = if cy == cy_before_beside: cy_frac else: 0
                            box_device_top_record(nodes.len() as i32, c, g_origin_frac_milli)
                            val beside_try = layout_with_style(nodes, styles, child_index, c, top_left, cy, beside_try_w, viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
                            out_bx = beside_try.bx
                            out_by = beside_try.by
                            out_bw = beside_try.bw
                            out_bh = beside_try.bh
                            out_wrap_starts = beside_try.wrap_starts
                            out_wrap_ends = beside_try.wrap_ends
                            out_intrinsic_widths = beside_try.intrinsic_widths
                            trial_valid = true
                            trial_x = top_left
                            trial_y = cy
                            trial_w = beside_try_w
                            trial_height = beside_try.height
                            trial_leading_margin_t = beside_try.leading_margin_t
                            trial_trailing_margin_b = beside_try.trailing_margin_b
                            trial_end_frac = beside_try.end_frac_milli
                            trial_end_valid = beside_try.end_frac_valid
                            beside_h = beside_try.height
                            if beside_h < 1:
                                beside_h = 1
                    val span_left = float_ctx_left_edge(cy, cy + beside_h, beside_x0)
                    val span_right = float_ctx_right_edge(cy, cy + beside_h, beside_x0 + beside_w0)
                    if top_right - top_left >= beside_min_w and span_right - span_left >= beside_min_w:
                        # Fits here; an auto width takes the narrowest room
                        # over the box's height.
                        child_x = span_left
                        if cst.width_px == 0 and not cst.width_zero:
                            child_w = span_right - span_left
                        beside_guard = 0
                    else:
                        val beside_next = float_ctx_next_bottom_span(cy, cy + beside_h)
                        if beside_next <= cy:
                            beside_guard = 0
                        else:
                            cy = beside_next
                            beside_guard = beside_guard - 1
                if child_w < 1:
                    child_w = 1
            val floats_before_child = float_ctx_count()
            # The trial layout made while fitting the box beside floats IS the
            # layout when the box ends where it was tried; laying the subtree
            # out again would double the work at every nesting level.
            var child_height = trial_height
            var child_leading_margin_t = trial_leading_margin_t
            var child_trailing_margin_b = trial_trailing_margin_b
            var child_end_frac = trial_end_frac
            var child_end_valid = trial_end_valid
            val child_start_frac = if cy == cy_before_beside: cy_frac else: 0
            if not (trial_valid and trial_x == child_x and trial_y == cy and trial_w == child_w):
                g_origin_frac_milli = child_start_frac
                box_device_top_record(nodes.len() as i32, c, child_start_frac)
                val child = layout_with_style(nodes, styles, child_index, c, child_x, cy, child_w, viewport_w, viewport_h, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, resolved_cst)
                out_bx = child.bx
                out_by = child.by
                out_bw = child.bw
                out_bh = child.bh
                out_wrap_starts = child.wrap_starts
                out_wrap_ends = child.wrap_ends
                out_intrinsic_widths = child.intrinsic_widths
                child_height = child.height
                child_leading_margin_t = child.leading_margin_t
                child_trailing_margin_b = child.trailing_margin_b
                child_end_frac = child.end_frac_milli
                child_end_valid = child.end_frac_valid
            # CSS 2.2 8.3.1 leading half. The child's EFFECTIVE top margin is
            # its declared margin-top collapsed with whatever margin escaped
            # through its own top edge (child_leading_margin_t), and that is
            # only known after the child is laid out -- the advance above was
            # computed from the declared value alone. Correct the difference by
            # translating the child subtree, which is the same two-phase
            # mechanics offset_layout_subtree already serves elsewhere.
            val effective_cst_margin_t = collapse_margins_signed(
                resolved_cst_margin_t, child_leading_margin_t)
            var corrected_top_milli = child_top_milli
            if child_leading_margin_t != 0:
                if child_count == 0 and nodes[i].tag == "body" and st.border_t == 0 and st.pad_t == 0:
                    val body_margin_t = block_margin_milli(st, true, viewport_h, viewport_w)
                    corrected_top_milli = collapse_margins_signed(
                        body_margin_t, effective_cst_margin_t) - body_margin_t
                else:
                    corrected_top_milli = collapse_margins_signed(
                        prev_margin_b_before_child, effective_cst_margin_t)
            # When THIS block also lets a top margin through, the whole
            # effective leading margin leaves the box: the first in-flow child
            # sits on the content top edge and the margin becomes this block's
            # own leading margin for its parent to collapse.
            val escapes_top = (
                child_count == 0 and
                block_top_margin_collapses_through(nodes, styles, i, st)
            )
            if escapes_top:
                leading_margin_t = effective_cst_margin_t
                corrected_top_milli = 0
            if corrected_top_milli != child_top_milli:
                val corrected_top_advance = cursor_advance_px(top_frac_restore, corrected_top_milli)
                cy_frac = cursor_advance_frac(top_frac_restore, corrected_top_milli)
                if layout_device_scale() > 1:
                    box_device_top_shift(child_index, c, cy_frac - child_start_frac)
                if corrected_top_advance != child_top_advance:
                    val retopped = offset_layout_subtree(
                        child_index, c, 0, corrected_top_advance - child_top_advance,
                        out_bx, out_by)
                    out_bx = retopped.bx
                    out_by = retopped.by
                    cy = cy + (corrected_top_advance - child_top_advance)
                    float_ctx_shift(floats_before_child, 0, corrected_top_advance - child_top_advance)
                    child_top_advance = corrected_top_advance
                child_top_milli = corrected_top_milli
            cy = cy + child_height
            # The child returns where ITS cursor ended (start fraction + its own
            # sub-pixel content), so the next sibling continues from the true
            # bottom instead of the rounded one. A top-margin retop moved the
            # start by (cy_frac - child_start_frac); the shifted residual is
            # used only while it stays a valid cursor residual.
            if child_end_valid:
                val child_end_shifted = child_end_frac + (cy_frac - child_start_frac)
                if child_end_shifted >= -500 and child_end_shifted < 500:
                    cy_frac = child_end_shifted
            val resolved_cst_margin_b = block_margin_milli(cst, false, viewport_h, iw)
            # CSS 2.2 §8.3.1 self-collapsing block: an in-flow block with no
            # border, padding, height, or content collapses its own top and
            # bottom margins into ONE margin that then collapses with the
            # adjacent siblings'. Without this, every blank markdown line in
            # the office WYSIWYG preview (an empty <p> with 1em margins)
            # pushed later blocks ~20px below where Chromium/WebKitGTK put
            # them (three-host office capture diff, 2026-08-19).
            # A block with any content is at least 1 px high and keeps its
            # margins apart (Chrome 159).
            val self_collapsing = child_height == 0 and
                nodes[c].tag != "#text" and
                cst.border_t == 0 and cst.border_b == 0 and
                cst.pad_t == 0 and cst.pad_b == 0 and
                cst.height_px == 0 and cst.min_height_px == 0
            if self_collapsing:
                # Pull back the top-margin advance and carry the collapsed
                # (prev_bottom, own top, own bottom) margin to the next sibling.
                cy = cy - child_top_advance - child_height
                cy_frac = top_frac_restore
                if cy < clearance_y:
                    cy = clearance_y
                out_by[c] = cy
                prev_margin_b = collapse_margins_signed(
                    prev_margin_b_before_child,
                    collapse_margins_signed(
                        resolved_cst_margin_t,
                        collapse_margins_signed(
                            resolved_cst_margin_b, child_trailing_margin_b)))
            else:
                # The child's own trailing margin (one that collapsed through
                # it, CSS 2.2 8.3.1) collapses with the child's declared
                # bottom margin and becomes what separates it from the next
                # sibling.
                prev_margin_b = collapse_margins_signed(
                    resolved_cst_margin_b, child_trailing_margin_b)
            child_count = child_count + 1
        c = child_index.next_sibling[c]
    if child_count > 0:
        if in_inline_run:
            val tail_h_aligned = align_inline_line_horizontal(
                child_index, st, line_nodes, line_iw, inline_x,
                out_bx, out_by
            )
            out_bx = tail_h_aligned.bx
            out_by = tail_h_aligned.by
            val aligned = align_inline_line_baselines(
                child_index, st, nodes, inline_baseline_nodes,
                inline_baseline_margin_ts, inline_baseline_margin_bs,
                styles, cy,
                inline_line_h, out_bx, out_by, out_bh
            )
            out_bx = aligned.bx
            out_by = aligned.by
            if inline_run_has_content:
                cy = cy + aligned.height + cursor_advance_px(cy_frac, aligned.height_frac_milli)
                cy_frac = cursor_advance_frac(cy_frac, aligned.height_frac_milli)
        if block_bottom_margin_collapses_through(nodes, styles, i, st):
            trailing_margin_b = prev_margin_b
        else:
            val tail_px = cursor_advance_px(cy_frac, prev_margin_b)
            cy_frac = cursor_advance_frac(cy_frac, prev_margin_b)
            cy = cy + tail_px
    # The auto height of a formatting-context root encloses the floats placed
    # inside it (CSS 2.2 10.6.7); any other block lets them overflow.
    if float_ctx_count() > g_float_base and float_ctx_establishes_bfc(nodes, styles, i, st):
        val enclosed_float_bottom = float_ctx_max_bottom(g_float_base)
        if enclosed_float_bottom > cy:
            cy = enclosed_float_bottom
    var h = (cy - y) + st.pad_b + st.border_b
    val content_h = h
    val explicit_h = if legacy_widget_box or st.border_box: st.height_px else: st.height_px + st.pad_t + st.pad_b + border_y
    if st.height_px > 0:
        h = explicit_h
    # `contain: size` (bug browser_engine_css_contain_size_unimplemented_
    # 2026-08-08): the box's own height must not depend on its contents.
    # An explicit height already won above; otherwise fall back to
    # `contain-intrinsic-size` (treated as content-box, like an explicit
    # height), and with no intrinsic size collapse to padding+border only.
    # Children are still laid out (their own paint/clip is unaffected);
    # only this box's reported height — and the flow advance of following
    # siblings — becomes content-independent.
    if st.contain_size and st.height_px <= 0:
        h = if legacy_widget_box or st.border_box: st.contain_intrinsic_h_px else: st.contain_intrinsic_h_px + st.pad_t + st.pad_b + border_y
    if st.min_height_px > 0:
        val min_h = css_outer_height(node, st, st.min_height_px)
        if min_h > h:
            h = min_h
    if st.max_height_px > 0:
        val max_h = css_outer_height(node, st, st.max_height_px)
        if max_h < h:
            h = max_h
    if st.min_height_vh and viewport_h > h:
        h = viewport_h
    val generated_panel_fill = legacy_panel_fill(nodes, i)
    if st.flex_fill or generated_panel_fill:
        val fill_bottom_blk = viewport_h - ancestor_bottom_inset(nodes, styles, i)
        if fill_bottom_blk - y > h:
            h = fill_bottom_blk - y
    out_bh[i] = h
    val placed = relative_layout_result(child_index, i, st, out_bx, out_by, out_bw, out_bh, out_wrap_starts, out_wrap_ends, out_intrinsic_widths, h)
    # An authored or clamped height makes the bottom edge start + h exactly, so the
    # residual is the start fraction; a content height ends where the cursor did.
    val end_frac = if h == content_h and st.height_px <= 0 and not st.contain_size: cy_frac else: origin_frac
    box_device_extra_h_record(nodes.len() as i32, i, box_device_top_px((end_frac - origin_frac) * layout_device_scale()))
    if node.tag == "button" and layout_device_scale() > 1 and st.width_px <= 0 and st.flex_grow <= 0:
        box_device_extra_w_record(nodes.len() as i32, i, button_device_extra_w(nodes, styles, child_index, i))
    LayoutResult(bx: placed.bx, by: placed.by, bw: placed.bw, bh: placed.bh, wrap_starts: placed.wrap_starts, wrap_ends: placed.wrap_ends, intrinsic_widths: placed.intrinsic_widths, height: placed.height, trailing_margin_b: trailing_margin_b, leading_margin_t: leading_margin_t, end_frac_milli: end_frac, end_frac_valid: true)

# ---------------------------------------------------------------------------
# Layout-stage leaf timers (2026-09-13, round 13).
#
# Round 12 §4 recorded that the `layout()` window had NO timers at all and was
# the largest unattributed mass in the cold pipeline. These wrappers are the
# whole instrument: each delegates to the untouched `_lay_*_inner` body, so
# behaviour is unchanged, and charges its INCLUSIVE wall time to one bucket of
# `web_layout_counters_report()` only while `SIMPLE_WEB_STYLE_COUNTERS=1` is
# armed. When it is not armed the wrapper is a straight tail call and reads no
# clock, matching the default-off discipline of every counter in this engine.
#
# Nesting is real and is NOT subtracted, exactly as `sec_resolve` nests inside
# `sec_metrics`: `lay_wrap` contains the fallback `compute_wrap_ranges`,
# `lay_intrinsic` contains its own recursion over a subtree, and the flex and
# table buckets call the measure leaves. Read the buckets as "time under this
# helper", never as a partition that must sum to the layout window.
