extern fn rt_bytes_alloc(n: i64) -> [u8]?

# Largest RGBA buffer the placeholder entry will request. Sizes that are
# negative or would exceed this bound are refused before any allocation.
val SIMPLE_WEB_PLACEHOLDER_MAX_BYTES: i64 = 268435456

# Refused (nil) allocation yields [], which the caller treats as a failed render.
fn simple_web_placeholder_alloc_bytes(n: i64) -> [u8]:
    if val buf = rt_bytes_alloc(n):
        return buf
    []

pub fn simple_web_render_placeholder_url_to_pixels(url: text, width: i64, height: i64) -> [u8]:
    if width < 0 or height < 0:
        return []
    if width > 0 and height > (SIMPLE_WEB_PLACEHOLDER_MAX_BYTES / 4) / width:
        return []
    val n_bytes = width * height * 4
    val pixels = simple_web_placeholder_alloc_bytes(n_bytes)
    if pixels.len().to_i64() < n_bytes:
        return []
    var i = 0
    while i < n_bytes:
        pixels[i] = 255
        i = i + 1
    pixels
