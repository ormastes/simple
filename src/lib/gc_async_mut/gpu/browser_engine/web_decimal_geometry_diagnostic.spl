# Public arbitrary-HTML diagnostic for the rectangle-only Web admission.
# The renderer computes this verdict over all styles before paint culling.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result}

pub fn web_decimal_geometry_rejection_reason(html: text) -> text:
    val rendered = simple_web_layout_render_html_draw_ir_result(html, 640, 480)
    if rendered.document_html != html or rendered.render_degraded or
        rendered.degrade_reason != "":
        return "web-layout-input-or-budget-degraded"
    rendered.box_geometry_rejection_reason
