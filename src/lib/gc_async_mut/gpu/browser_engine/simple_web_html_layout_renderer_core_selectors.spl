fn unquote_css_attr_value(raw: text) -> text:
    val v = raw.trim()
    if v.byte_len() >= 2:
        val first = v.substring(0, 0 + 1)
        # Exact last-byte slice: the quote characters being tested are
        # ASCII; a multi-byte final character simply never matches.
        val last = v.substring(v.byte_len() - 1, v.byte_len())
        if (first == "\"" and last == "\"") or (first == "'" and last == "'"):
            return v.substring(1, v.byte_len() - 1)
    v

fn attr_selector_matches(attrs: text, expr: text) -> bool:
    var raw = expr.trim()
    if raw.len() == 0:
        return false
    var case_insensitive = false
    if raw.ends_with(" i") or raw.ends_with(" I"):
        case_insensitive = true
        raw = raw.substring(0, raw.byte_len() - 2).trim()
    elif raw.ends_with(" s") or raw.ends_with(" S"):
        # Explicit case-sensitive flag; comparison below already has that
        # behavior, but remove the flag before unquoting the operand.
        raw = raw.substring(0, raw.byte_len() - 2).trim()
    val prefix_op = text_index_of(raw, "^=")
    if prefix_op >= 0:
        val name = raw.substring(0, prefix_op).trim()
        val want = unquote_css_attr_value(raw.substring(prefix_op + 2, raw.byte_len()))
        val actual = attr_value(attrs, name)
        if case_insensitive:
            return actual.len() > 0 and actual.lower().starts_with(want.lower())
        return actual.len() > 0 and actual.starts_with(want)
    val suffix_op = text_index_of(raw, "$=")
    if suffix_op >= 0:
        val name = raw.substring(0, suffix_op).trim()
        val want = unquote_css_attr_value(raw.substring(suffix_op + 2, raw.byte_len()))
        val actual = attr_value(attrs, name)
        if case_insensitive:
            return actual.len() > 0 and actual.lower().ends_with(want.lower())
        return actual.len() > 0 and actual.ends_with(want)
    # Substring, whitespace-token, and dash-match operators must be
    # inspected before the bare "=" scan below: their marker characters
    # (*, ~, |) sit immediately left of the same "=" the exact branch
    # would otherwise claim, misreading `data-tags*='beta'` as an exact
    # match on the literal attribute name `data-tags*`.
    val substr_op = text_index_of(raw, "*=")
    if substr_op >= 0:
        val name = raw.substring(0, substr_op).trim()
        val want = unquote_css_attr_value(raw.substring(substr_op + 2, raw.byte_len()))
        val actual = attr_value(attrs, name)
        if case_insensitive:
            return actual.len() > 0 and actual.lower().contains(want.lower())
        return actual.len() > 0 and actual.contains(want)
    val token_op = text_index_of(raw, "~=")
    if token_op >= 0:
        val name = raw.substring(0, token_op).trim()
        val want = unquote_css_attr_value(raw.substring(token_op + 2, raw.byte_len()))
        # CSS Selectors 4: an empty ~= operand can never match.
        if want.len() == 0:
            return false
        val actual = attr_value(attrs, name)
        val words = split_class_words_trimmed(actual)
        var wi = 0
        while wi < words.len():  # cpu-lane-loop-ok: linear scan of ONE node's attribute token list for one wanted token; bound is that attribute's token count
            if case_insensitive:
                if words[wi].lower() == want.lower():
                    return true
            else:
                if words[wi] == want:
                    return true
            wi = wi + 1
        return false
    val dash_op = text_index_of(raw, "|=")
    if dash_op >= 0:
        val name = raw.substring(0, dash_op).trim()
        val want = unquote_css_attr_value(raw.substring(dash_op + 2, raw.byte_len()))
        val actual = attr_value(attrs, name)
        if case_insensitive:
            val a = actual.lower()
            val w = want.lower()
            return a == w or a.starts_with(w + "-")
        return actual == want or actual.starts_with(want + "-")
    val exact_op = text_index_of(raw, "=")
    if exact_op >= 0:
        val name = raw.substring(0, exact_op).trim()
        val want = unquote_css_attr_value(raw.substring(exact_op + 1, raw.byte_len()))
        if case_insensitive:
            return attr_value(attrs, name).lower() == want.lower()
        return attr_value(attrs, name) == want
    # Bare [name]: CSS presence semantics. A valueless boolean attribute
    # (`<div data-tone>`) and an empty-valued one (`data-tone=""`) both
    # match; attr_value alone cannot see either, so check for the name
    # token with proper boundaries.
    attr_value(attrs, raw).len() > 0 or attr_name_present(attrs, raw)

fn attr_name_present(attrs: text, name: text) -> bool:
    val name_len = name.byte_len()
    if name_len == 0:
        return false
    val attrs_len = attrs.byte_len()
    var pos = 0
    var guard = 0
    while guard < 200:  # cpu-lane-loop-ok: walks occurrences of ONE attribute name inside ONE tag's attribute text via native find_from, capped at 200 probes
        guard = guard + 1
        val hit = find_from(attrs, name, pos)
        if hit < 0:
            return false
        val before_ok = if hit == 0:
            true
        else:
            val b = attrs.substring(hit - 1, hit)
            b == " " or b == "\t" or b == "\n" or b == "\r"
        val after = hit + name_len
        val after_ok = if after >= attrs_len:
            true
        else:
            val a = attrs.substring(after, after + 1)
            a == " " or a == "\t" or a == "\n" or a == "\r" or a == "=" or a == "/" or a == ">"
        if before_ok and after_ok:
            return true
        pos = hit + 1
    false

fn class_words_has(words: [text], want: text) -> bool:
    var i = 0
    val word_count = words.len()
    while i < word_count:  # cpu-lane-loop-ok: linear scan of ONE node's class-word list for one wanted class; bound is that node's class count (single digits in practice)
        if words[i] == want:
            return true
        i = i + 1
    false

fn base_selector_matches(base: text, tag: text, cls: text, class_words: [text], id: text) -> bool:
    if base.len() == 0:
        return true
    # universal selector (e.g. the `*, *::before, *::after` margin/padding reset)
    if base == "*":
        return true
    val toks = _compound_base_tokens(base)
    if toks[1] == "x":
        return false
    if toks[0] != "" and toks[0] != tag:
        return false
    if toks[1] == "1" and toks[2] != id:
        return false
    var k = 3
    while k < toks.len():  # cpu-lane-loop-ok: one compound's wanted classes; bound is that selector's class count
        if not class_words_has(class_words, toks[k]):
            return false
        k = k + 1
    true

# A compound selector base (`div.a#t.b`, `.a#t`, `#t.a`) as
# [tag, id_state, id, class...]. Parts come in any order (Selectors 4 3.1);
# `*` or no leading name is an empty tag. id_state is "" (no id), "1", or
# "x" for two different ids, which can never match.
# reason: shared with ..._core_rule_index.spl (bucket keys, specificity).
# @allow(primitive_api)
pub fn _compound_base_tokens(base: text) -> [text]:
    val n = base.byte_len()
    var out: [text] = ["", "", ""]
    var i = 0
    while i < n and base.substring(i, i + 1) != "." and base.substring(i, i + 1) != "#":  # cpu-lane-loop-ok: scans ONE selector's leading tag name at parse time
        i = i + 1
    val tag = base.substring(0, i)
    out[0] = if tag == "*": "" else: tag
    while i < n:  # cpu-lane-loop-ok: walks ONE compound's `#id`/`.class` parts at parse time; bound is that selector's length
        val kind = base.substring(i, i + 1)
        var j = i + 1
        while j < n and base.substring(j, j + 1) != "." and base.substring(j, j + 1) != "#":  # cpu-lane-loop-ok: scans one part name
            j = j + 1
        val name = base.substring(i + 1, j)
        if kind == "#":
            if out[1] == "1" and out[2] != name:
                out[1] = "x"
            elif out[1] == "":
                out[1] = "1"
                out[2] = name
        elif name != "":
            out.push(name)
        i = j
    out

# Check :not(), :is(), :where() pseudo-class against this element's base properties.
# Returns true if the selector pseudo condition is satisfied.
# Does a :not()/:is()/:where() option carry a pseudo-class that needs the
# node's sibling context (position or emptiness)? Such an option used to be
# evaluated context-free, where positional pseudo-classes are skipped, so
# `:not(:nth-child(2))` matched nothing and `:is(:first-child)` everything.
fn _option_needs_ctx(opt: text) -> bool:
    (
        opt.contains(":nth-") or opt.contains(":first-child") or
        opt.contains(":last-child") or opt.contains(":only-child") or
        opt.contains("-of-type") or
        opt.contains(":empty") or opt.contains(":has(")
    )

fn _pseudo_list_matches(
    pseudo: text, arg: text, tag: text, cls: text,
    class_words: [text], id: text, attrs: text,
    recursion_depth: i32 = 0
) -> bool:
    if recursion_depth > 32:
        return false
    # Split arg on commas (not inside parens) to get individual options
    var options: [text] = [""; 16]
    var opt_count = 0
    var depth = 0
    var i = 0
    val arg_len = arg.byte_len()
    var option_start = 0
    while i < arg_len:  # cpu-lane-loop-ok: splits ONE :not()/:is()/:where() argument on top-level commas; bound is that argument's length
        val ch = arg.substring(i, i + 1)
        if ch == "(":
            depth = depth + 1
            if depth > 32:
                return false
        elif ch == ")":
            depth = depth - 1
            if depth < 0:
                return false
        elif ch == "," and depth == 0:
            if opt_count >= 16:
                return false
            val option = arg.substring(option_start, i).trim()
            if option.len() == 0:
                return false
            options[opt_count] = option
            opt_count = opt_count + 1
            option_start = i + 1
        i = i + 1
    if depth != 0:
        return false
    val tail = arg.substring(option_start, arg_len).trim()
    if tail.len() == 0:
        return false
    if tail.len() > 0 and opt_count >= 16:
        return false
    if tail.len() > 0:
        options[opt_count] = tail
        opt_count = opt_count + 1
    if pseudo == "not":
        # :not(sel, ...) — match if NONE of the options match
        var j = 0
        while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 parsed :not() options, returning false at the first option that matches
            val opt = options[j]
            # An option with a positional pseudo-class cannot be decided
            # without the node's sibling context; _list_ctx_matches() decides
            # it in the context phase. Here it is left undecided (no match).
            if (
                opt.len() > 0 and not _option_needs_ctx(opt) and simple_match(
                    opt, tag, cls, class_words, id, attrs,
                    recursion_depth
                )
            ):
                return false
            j = j + 1
        return true
    if pseudo == "is" or pseudo == "where":
        # :is(sel, ...) / :where(sel, ...) — match if ANY option matches
        var j = 0
        while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 parsed :is()/:where() options, returning true at the first option that matches
            val opt = options[j]
            if opt.len() > 0 and _option_needs_ctx(opt):
                return true
            if (
                opt.len() > 0 and simple_match(
                    opt, tag, cls, class_words, id, attrs,
                    recursion_depth
                )
            ):
                return true
            j = j + 1
        return false
    # Unknown pseudo-class: treat as non-matching for reject tests, but allow pass-through
    # for unknown structural pseudos (handled in full context).
    false

fn simple_match(
    sel: text, tag: text, cls: text, class_words: [text],
    id: text, attrs: text, recursion_depth: i32 = 0
) -> bool:
    if sel.len() == 0 or recursion_depth > 32:
        return false
    # Pseudo-element selectors (::before, ::after, ::selection, ...) target
    # boxes this engine does not render; they must never match the host
    # element (previously "body::before" applied its decls to <body> itself).
    if text_index_of(sel, "::") >= 0:
        return false
    # Split off the base (before the first colon at depth 0)
    var base = sel
    val colon = text_index_of(base, ":")
    if colon >= 0:
        base = base.substring(0, colon)
    val attr_start = text_index_of(base, "[")
    if attr_start >= 0:
        val attr_end = text_index_of(base, "]")
        if attr_end < attr_start:
            return false
        val node_base = base.substring(0, attr_start).trim()
        if not base_selector_matches(node_base, tag, cls, class_words, id):
            return false
        # A compound selector may carry SEVERAL attribute groups
        # ("[role=tabpanel][hidden]"); every one of them must match. Evaluating
        # only the first group applied "[role=tabpanel][hidden]{display:none}"
        # to the *visible* panel and blanked the page.
        var group_start = attr_start
        var group_count = 0
        while group_start >= 0 and group_count < 32:  # cpu-lane-loop-ok: walks the bracket groups of ONE compound selector, capped at 32
            group_count = group_count + 1
            val rest = base.substring(group_start + 1, base.byte_len())
            val rel_end = text_index_of(rest, "]")
            if rel_end < 0:
                return false
            if not attr_selector_matches(attrs, rest.substring(0, rel_end)):
                return false
            val tail = rest.substring(rel_end + 1, rest.byte_len())
            val next_rel = text_index_of(tail, "[")
            if next_rel < 0:
                group_start = 0 - 1
            else:
                group_start = group_start + 1 + rel_end + 1 + next_rel
    else:
        if not base_selector_matches(base, tag, cls, class_words, id):
            return false
    # Now check pseudo-classes (at the current element level, no node-position context)
    if colon < 0:
        return true
    var pseudo_pos = colon
    var pseudo_count = 0
    val sel_blen = sel.byte_len()
    while pseudo_pos < sel_blen:  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector; bound is that selector's length with a hard pseudo_count cap of 32
        pseudo_count = pseudo_count + 1
        if pseudo_count > 32 or sel.substring(pseudo_pos, pseudo_pos + 1) != ":":
            return false
        val name_start = pseudo_pos + 1
        var name_end = name_start
        # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
        while (
            name_end < sel_blen and sel.substring(name_end, name_end + 1) != ":" and
            sel.substring(name_end, name_end + 1) != "(" and sel.substring(name_end, name_end + 1) != "["
        ):
            name_end = name_end + 1
        val pseudo = sel.substring(name_start, name_end)
        if pseudo.len() == 0:
            return false
        var arg = ""
        if name_end < sel_blen and sel.substring(name_end, name_end + 1) == "(":
            var functional_depth = 1
            var close = name_end + 1
            while close < sel_blen and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo-class argument; bound is the remaining selector length, paren depth capped at 32
                val ch = sel.substring(close, close + 1)
                if ch == "(":
                    functional_depth = functional_depth + 1
                    if functional_depth > 32:
                        return false
                elif ch == ")":
                    functional_depth = functional_depth - 1
                close = close + 1
            if functional_depth != 0:
                return false
            arg = sel.substring(name_end + 1, close - 1).trim()
            pseudo_pos = close
        else:
            pseudo_pos = name_end
            if (
                pseudo == "root" and pseudo_pos < sel_blen and
                sel.substring(pseudo_pos, pseudo_pos + 1) == "["
            ):
                val attr_close = find_from(sel, "]", pseudo_pos + 1)
                if attr_close < 0 or not attr_selector_matches(
                    attrs, sel.substring(pseudo_pos + 1, attr_close)
                ):
                    return false
                pseudo_pos = attr_close + 1
        if pseudo == "not" or pseudo == "is" or pseudo == "where":
            if not _pseudo_list_matches(
                pseudo, arg, tag, cls, class_words, id, attrs,
                recursion_depth + 1
            ):
                return false
        elif pseudo == "checked":
            # A static render has no user state, but the `checked` attribute
            # is the element's initial checkedness.
            if not _element_is_checked(tag, attrs):
                return false
        elif _is_interaction_state_pseudo(pseudo, attrs):
            return false
        elif pseudo == "root":
            if tag != "html":
                return false
        elif (
            pseudo != "empty" and pseudo != "first-child" and
            pseudo != "last-child" and pseudo != "only-child" and
            pseudo != "nth-child" and pseudo != "nth-last-child" and
            pseudo != "nth-of-type" and pseudo != "nth-last-of-type" and
            pseudo != "first-of-type" and pseudo != "last-of-type" and
            pseudo != "only-of-type" and
            pseudo != "has"
        ):
            return false
    true

# `:checked` for a static render: a checkbox or radio input carrying the
# `checked` attribute, or an <option> carrying `selected` (HTML "checkedness"
# / "selectedness" as authored). Any other element never matches.
fn _element_is_checked(tag: text, attrs: text) -> bool:
    # Attribute names and the `type` keyword are ASCII case-insensitive.
    val lowered = attrs.lower()
    if tag == "input":
        if not attr_selector_matches(lowered, "checked"):
            return false
        return (
            attr_selector_matches(lowered, "type=checkbox") or
            attr_selector_matches(lowered, "type=radio")
        )
    if tag == "option":
        return attr_selector_matches(lowered, "selected")
    false

# Interaction/UA-state pseudo-classes a static renderer must treat as
# unsatisfied. `:disabled` honors an actual disabled attribute when present.
fn _is_interaction_state_pseudo(pseudo: text, attrs: text) -> bool:
    if pseudo == "hover":
        return true
    if pseudo == "active":
        return true
    if pseudo == "focus":
        return true
    if pseudo == "focus-visible":
        return true
    if pseudo == "focus-within":
        return true
    if pseudo == "visited":
        return true
    if pseudo == "target":
        return true
    if pseudo == "placeholder-shown":
        return true
    if pseudo == "autofill":
        return true
    if pseudo == "disabled":
        return not attrs.contains("disabled")
    false

fn class_has_all(words: [text], wants: text) -> bool:
    val wants_len = wants.byte_len()
    var start = 0
    var i = 0
    while i <= wants_len:  # cpu-lane-loop-ok: splits a `.a.b.c` compound class selector on `.`; bound is that compound's text length
        if i == wants_len or wants.substring(i, i + 1) == ".":
            if i > start:
                val want = wants.substring(start, i)
                if not class_words_has(words, want):
                    return false
            start = i + 1
        i = i + 1
    true

fn class_contains(cls: text, want: text) -> bool:
    cls.contains(want)

# Count element-type siblings of node[idx] up to and including idx (1-based child position).
fn _child_position(ctx: SelectorContext, idx: i32) -> i32:
    if idx < 0 or idx >= ctx.element_position.len():
        return 1
    ctx.element_position[idx]

# Count total element-type children of parent of node[idx].
fn _sibling_count(ctx: SelectorContext, idx: i32) -> i32:
    if idx < 0 or idx >= ctx.element_sibling_count.len():
        return 1
    ctx.element_sibling_count[idx]

# 1-based position of node[idx] among the element siblings that share its tag
# (precomputed per parent in build_selector_context).
fn _type_position(ctx: SelectorContext, idx: i32) -> i32:
    if idx < 0 or idx >= ctx.type_position.len():
        return 1
    ctx.type_position[idx]

# Number of element siblings (including node[idx]) that share its tag.
fn _type_count(ctx: SelectorContext, idx: i32) -> i32:
    if idx < 0 or idx >= ctx.type_count.len():
        return 1
    ctx.type_count[idx]

# Does node i match any option of a selector list (with sibling context)?
fn _any_option_matches_ctx(opts: [text], nodes: [HNode], ctx: SelectorContext, i: i32) -> bool:
    val nd = nodes[i]
    var j = 0
    val opt_count = opts.len()
    while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 options of ONE `of S` selector list for one node
        if opts[j].len() > 0 and simple_match_ctx(opts[j], nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, nodes, ctx, i):
            return true
        j = j + 1
    false

# Pass-scoped selector state. CSS is untrusted input, so one selector match
# is bounded by SELECTOR_STEP_BUDGET compound evaluations; the caches make the
# sibling-indexed lookups linear per rule instead of quadratic.
val SELECTOR_STEP_BUDGET: i64 = 100000
var _sel_steps: i64 = 0
var _sel_depth: i32 = 0
var _sel_budget_hits: i64 = 0
var _sel_cache_pass: i64 = 0 - 1
var _sel_cache: Dict<text, i32> = {}

# How many selector matches were abandoned because they exceeded the step
# budget (the rule then does not match). Diagnostic only.
pub fn simple_web_selector_budget_exhausted_count() -> i64:
    _sel_budget_hits

fn _sel_budget_blown() -> bool:
    _sel_steps > SELECTOR_STEP_BUDGET

# Counts one compound evaluation; true when the budget is exhausted.
fn _sel_step() -> bool:
    _sel_steps = _sel_steps + 1
    if _sel_steps == SELECTOR_STEP_BUDGET + 1:
        _sel_budget_hits = _sel_budget_hits + 1
    _sel_steps > SELECTOR_STEP_BUDGET

# Cached value for `key` in this style pass, or -1 when absent.
fn _sel_cache_get(ctx: SelectorContext, key: text) -> i32:
    if _sel_cache_pass != ctx.pass_id:
        _sel_cache = {}
        _sel_cache_pass = ctx.pass_id
    _sel_cache.get(key) ?? (0 - 1)

fn _sel_cache_put(key: text, value: i32):
    _sel_cache[key] = value

# Index for `:nth-child(An+B of S)` / `:nth-last-child(An+B of S)`: the
# 1-based position of node idx among the element siblings that match S,
# counted from the start or the end; -1 when the node itself does not match S.
# The positions of ALL siblings are computed in one pass over the parent's
# children and cached per (parent, S) for the style pass.
fn _nth_of_index(code: i32, opts: [text], nodes: [HNode], ctx: SelectorContext, idx: i32) -> i32:
    val parent = nodes[idx].parent as i32
    if parent < 0 or parent >= ctx.child_index.first_child.len():
        return if _any_option_matches_ctx(opts, nodes, ctx, idx): 1 else: 0 - 1
    # Length-prefixed selector list: no option text can imitate a key.
    var list_key = "|"
    for opt in opts:  # cpu-lane-loop-ok: the <=16 options of ONE `of S` selector list
        list_key = list_key + opt.byte_len().to_string() + ":" + opt
    val node_key = "o" + idx.to_string() + list_key
    val total_key = "n" + parent.to_string() + list_key
    var position = _sel_cache_get(ctx, node_key)
    if position < 0:
        var children: [i32] = []
        var positions: [i32] = []
        var count = 0
        var c = ctx.child_index.first_child[parent]
        while c >= 0 and not _sel_step():  # cpu-lane-loop-ok: one pass over ONE parent's children per (parent, S) per style pass; also bounded by the step budget
            if nodes[c].tag != "#text":
                children.push(c)
                if _any_option_matches_ctx(opts, nodes, ctx, c):
                    count = count + 1
                    positions.push(count)
                else:
                    positions.push(0)
            c = ctx.child_index.next_sibling[c]
        if _sel_budget_blown():
            # Answers computed while exhausted are unknown, not "no match":
            # never store them for a later rule to read.
            return 0 - 1
        var w = 0
        while w < children.len():  # cpu-lane-loop-ok: writes the per-sibling positions computed above
            _sel_cache_put("o" + children[w].to_string() + list_key, positions[w])
            w = w + 1
        _sel_cache_put(total_key, count)
        position = _sel_cache_get(ctx, node_key)
    if position <= 0:
        return 0 - 1
    if code == PSEUDO_NTH_LAST_CHILD:
        return _sel_cache_get(ctx, total_key) - position + 1
    position

# Byte offset of the ` of ` keyword in an :nth-child()/:nth-last-child()
# argument, or -1. Chrome requires whitespace before a lower-case `of`.
# reason: shared with ..._core_rule_index.spl (rule admission, specificity).
# @allow(primitive_api)
pub fn _nth_of_offset(code: i32, arg: text) -> i32:
    if code != PSEUDO_NTH_CHILD and code != PSEUDO_NTH_LAST_CHILD:
        return 0 - 1
    # Offsets are unchanged by the 1:1 whitespace normalisation.
    val normalized = arg.replace("\t", " ").replace("\n", " ").replace("\r", " ").replace("\x0c", " ")
    text_index_of(normalized, " of ") as i32

# The 1-based index an An+B argument is tested against for each structural
# pseudo-class: from the start or the end, among all element siblings or only
# those of the same type.
fn _nth_index_for(code: i32, nodes: [HNode], ctx: SelectorContext, idx: i32) -> i32:
    if code == PSEUDO_NTH_LAST_CHILD:
        return _sibling_count(ctx, idx) - _child_position(ctx, idx) + 1
    if code == PSEUDO_NTH_OF_TYPE:
        return _type_position(ctx, idx)
    if code == PSEUDO_NTH_LAST_OF_TYPE:
        return _type_count(ctx, idx) - _type_position(ctx, idx) + 1
    _child_position(ctx, idx)

# Check whether any node that is a child of parent_idx matches simple selector sel_arg.
# Combinator codes shared by the text and pre-parsed chain walkers.
val COMB_DESCENDANT: i32 = 0
val COMB_CHILD: i32 = 1
val COMB_NEXT_SIBLING: i32 = 2
val COMB_SUBSEQUENT_SIBLING: i32 = 3

# Combinator code of a selector-part token, or -1 when it is a compound.
# reason: shared with ..._core_rule_index.spl (bucket keys, specificity).
# @allow(primitive_api)
pub fn _comb_code_of_part(part: text) -> i32:
    if part == ">":
        return COMB_CHILD
    if part == "+":
        return COMB_NEXT_SIBLING
    if part == "~":
        return COMB_SUBSEQUENT_SIBLING
    0 - 1

# Is element `e` related to `anchor` by `comb` (e is the right-hand side)?
fn _relates_to_anchor(nodes: [HNode], ctx: SelectorContext, e: i32, anchor: i32, comb: i32) -> bool:
    if comb == COMB_CHILD:
        return (nodes[e].parent as i32) == anchor
    if comb == COMB_NEXT_SIBLING:
        return ctx.prev_element[e] == anchor
    if comb == COMB_SUBSEQUENT_SIBLING:
        var s = ctx.prev_element[e]
        while s >= 0 and not _sel_step():  # cpu-lane-loop-ok: walks the previous element siblings of ONE node; bound is its sibling count and the step budget
            if s == anchor:
                return true
            s = ctx.prev_element[s]
        return false
    var a = nodes[e].parent as i32
    while a >= 0 and not _sel_step():  # cpu-lane-loop-ok: walks the parent chain of ONE node; bound is its tree depth and the step budget
        if a == anchor:
            return true
        a = nodes[a].parent as i32
    false

# Cache key for "does some sibling match parts[..j]": the selector prefix.
# Keys are `<space><node>|` followed by length-prefixed parts, so no selector
# text can imitate another key or its separators.
fn _sel_prefix_key_text(parts: [text], j: i32, parent: i32) -> text:
    var key = "t" + parent.to_string() + "|"
    var i = 0
    while i <= j:  # cpu-lane-loop-ok: joins the prefix parts of ONE selector group for a cache key
        key = key + parts[i].byte_len().to_string() + ":" + parts[i]
        i = i + 1
    key

# Right-to-left match of the complex selector `parts[..k]` with compound k on
# node idx. Return codes:
#   1  match
#   0  this candidate fails; another candidate of an enclosing walk may match
#   2  a descendant walk ran out of ancestors: every other candidate of every
#      enclosing walk has a subset of those ancestors, so the match has failed
#   3  no EARLIER SIBLING can satisfy the left side: definitive for an
#      enclosing `~` / `+` (earlier candidates have a subset of the previous
#      siblings), not for an enclosing descendant walk (other parents)
#   4  abort: step budget exhausted or the selector is invalid
# Codes 2 and 3 keep chained combinators linear: without 3, `a~b~b~b` retried
# every earlier sibling at every level (about C(W, m+1) compound matches).
#
# `anchor >= 0` is the :has() scope element: the leftmost compound must then
# relate to it by the selector's leading combinator (descendant when absent).
fn _chain_match_text(nodes: [HNode], ctx: SelectorContext, idx: i32, parts: [text], k: i32, anchor: i32) -> i32:
    if _sel_step():
        return 4
    val nd = nodes[idx]
    val compound_ok = simple_match_ctx(parts[k], nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, nodes, ctx, idx)
    # Checked whether the compound matched or not: a nested :has() may have
    # exhausted the budget inside it, and a "match" computed that way is void.
    if _sel_budget_blown():
        return 4
    if not compound_ok:
        return 0
    var comb = COMB_DESCENDANT
    var comb_tokens = 0
    var j = k - 1
    while j >= 0:  # cpu-lane-loop-ok: skips the empty/combinator tokens between two compounds of ONE selector group
        val token = parts[j]
        if token.len() == 0:
            j = j - 1
        else:
            val code = _comb_code_of_part(token)
            if code < 0:
                break
            comb = code
            comb_tokens = comb_tokens + 1
            j = j - 1
    if comb_tokens > 1:
        # Two combinators in a row (`a > + b`): invalid, the rule is dropped.
        return 4
    if j < 0:
        if anchor < 0:
            # A selector that starts with a combinator has no left-hand side.
            return if comb_tokens == 0: 1 else: 4
        return if _relates_to_anchor(nodes, ctx, idx, anchor, comb): 1 else: 0
    if comb == COMB_CHILD:
        val parent = nd.parent as i32
        if parent < 0:
            return 0
        return _chain_match_text(nodes, ctx, parent, parts, j, anchor)
    if comb == COMB_NEXT_SIBLING:
        val prev = ctx.prev_element[idx]
        if prev < 0:
            return 3
        return _chain_match_text(nodes, ctx, prev, parts, j, anchor)
    if comb == COMB_SUBSEQUENT_SIBLING:
        val parent = nd.parent as i32
        if parent < 0:
            return 3
        if anchor < 0:
            # `X ~ subject` only asks whether SOME earlier sibling matches X:
            # the earliest such sibling decides for every later one. Found
            # once per (parent, selector prefix) per style pass.
            val key = _sel_prefix_key_text(parts, j, parent)
            var earliest = _sel_cache_get(ctx, key)
            if earliest < 0:
                earliest = 0
                var c = ctx.child_index.first_child[parent]
                while c >= 0:  # cpu-lane-loop-ok: one forward pass over ONE parent's children per (parent, selector prefix) per style pass
                    if nodes[c].tag != "#text":
                        val r = _chain_match_text(nodes, ctx, c, parts, j, anchor)
                        if r == 4:
                            return 4
                        if r == 1:
                            earliest = ctx.element_position[c]
                            break
                        if r == 2:
                            break
                    c = ctx.child_index.next_sibling[c]
                if _sel_budget_blown():
                    return 4
                _sel_cache_put(key, earliest)
            return if earliest > 0 and earliest < ctx.element_position[idx]: 1 else: 3
        var s = ctx.prev_element[idx]
        while s >= 0:  # cpu-lane-loop-ok: `~` walk over the previous element siblings of ONE node inside :has(); bound is its sibling count
            val r = _chain_match_text(nodes, ctx, s, parts, j, anchor)
            if r != 0:
                return r
            s = ctx.prev_element[s]
        return 3
    var a = nd.parent as i32
    while a >= 0:  # cpu-lane-loop-ok: descendant-combinator walk up the parent chain of ONE node; bound is its tree depth
        val r = _chain_match_text(nodes, ctx, a, parts, j, anchor)
        if r == 1 or r == 2 or r == 4:
            return r
        a = nodes[a].parent as i32
    2

# Next node after `cur` in a pre-order walk of root's subtree, or -1. Uses the
# child/sibling/parent links, so :has() needs no per-call stack allocation.
fn _subtree_next(nodes: [HNode], ctx: SelectorContext, root: i32, cur: i32) -> i32:
    val first = ctx.child_index.first_child[cur]
    if first >= 0:
        return first
    var c = cur
    while c != root and c >= 0:  # cpu-lane-loop-ok: climbs from ONE leaf toward the :has() scope root; bound is the tree depth
        val next = ctx.child_index.next_sibling[c]
        if next >= 0:
            return next
        c = nodes[c].parent as i32
    0 - 1

# Does any node of root's subtree (root itself when include_root) end a match
# of the relative selector `parts` anchored at `anchor`?
fn _has_scan_subtree(nodes: [HNode], ctx: SelectorContext, root: i32, include_root: bool, parts: [text], right: i32, anchor: i32) -> bool:
    if include_root and nodes[root].tag != "#text":
        if _chain_match_text(nodes, ctx, root, parts, right, anchor) == 1:
            return true
    var cur = _subtree_next(nodes, ctx, root, root)
    while cur >= 0 and not _sel_budget_blown():  # cpu-lane-loop-ok: pre-order walk of ONE :has() scope subtree; bound is that subtree's node count and the step budget
        if nodes[cur].tag != "#text":
            if _chain_match_text(nodes, ctx, cur, parts, right, anchor) == 1:
                return true
        cur = _subtree_next(nodes, ctx, root, cur)
    false

# One :has() option: a relative selector (optional leading `>`, `+` or `~`,
# then a full complex selector) evaluated WITH sibling context for every
# compound. Nested :has() shares the enclosing match's step budget.
fn _has_option_matches(nodes: [HNode], ctx: SelectorContext, idx: i32, opt: text) -> bool:
    val top = _sel_depth == 0
    if top:
        _sel_steps = 0
    _sel_depth = _sel_depth + 1
    val inner_matched = _has_option_matches_inner(nodes, ctx, idx, opt)
    _sel_depth = _sel_depth - 1
    val matched = inner_matched and not _sel_budget_blown()
    if top:
        _sel_steps = 0
    matched

fn _has_option_matches_inner(nodes: [HNode], ctx: SelectorContext, idx: i32, opt: text) -> bool:
    val trimmed = opt.trim()
    if trimmed.len() == 0:
        return false
    if idx < 0 or idx >= ctx.child_index.first_child.len():
        return false
    var parts: [text] = [trimmed]
    if (
        trimmed.contains(" ") or trimmed.contains(">") or
        trimmed.contains("+") or trimmed.contains("~")
    ):
        parts = selector_group_parts(trimmed)
    var right = (parts.len() as i32) - 1
    while right >= 0 and parts[right].len() == 0:  # cpu-lane-loop-ok: skips trailing empty tokens of ONE :has() option
        right = right - 1
    if right < 0 or _comb_code_of_part(parts[right]) >= 0:
        # Empty, or ends in a combinator (`:has(a >)`): invalid.
        return false
    # Shape of the relative selector: its leading combinator, how many
    # compounds it has, and whether any of them is reached through a
    # descendant or child combinator (only then can the subject be deeper
    # than the candidates the leading combinator names).
    var lead = COMB_DESCENDANT
    var compounds = 0
    var tree_inside = false
    var pending = 0 - 1
    var pi = 0
    while pi <= right:  # cpu-lane-loop-ok: classifies the tokens of ONE :has() option
        val token = parts[pi]
        if token.len() > 0:
            val code = _comb_code_of_part(token)
            if code >= 0:
                pending = code
            else:
                if compounds == 0:
                    if pending >= 0:
                        lead = pending
                elif pending < 0 or pending == COMB_CHILD:
                    tree_inside = true
                compounds = compounds + 1
                pending = 0 - 1
        pi = pi + 1
    if lead == COMB_NEXT_SIBLING or lead == COMB_SUBSEQUENT_SIBLING:
        var s = ctx.child_index.next_sibling[idx]
        var seen_element = false
        while s >= 0 and not _sel_budget_blown():  # cpu-lane-loop-ok: following siblings of ONE :has() scope element; bound is its sibling count and the step budget
            if nodes[s].tag != "#text":
                if tree_inside:
                    if _has_scan_subtree(nodes, ctx, s, true, parts, right, idx):
                        return true
                elif _chain_match_text(nodes, ctx, s, parts, right, idx) == 1:
                    return true
                seen_element = true
                # `:has(+ x)` can only be satisfied by the next element sibling.
                if lead == COMB_NEXT_SIBLING and compounds == 1 and seen_element:
                    return false
            s = ctx.child_index.next_sibling[s]
        return false
    if lead == COMB_CHILD and not tree_inside:
        # `:has(> x)` / `:has(> x + y)`: the subject is one of the children.
        var c = ctx.child_index.first_child[idx]
        while c >= 0 and not _sel_budget_blown():  # cpu-lane-loop-ok: children of ONE :has() scope element; bound is its child count and the step budget
            if nodes[c].tag != "#text":
                if _chain_match_text(nodes, ctx, c, parts, right, idx) == 1:
                    return true
            c = ctx.child_index.next_sibling[c]
        return false
    _has_scan_subtree(nodes, ctx, idx, false, parts, right, idx)

# Check whether a node has any child element (non-text) or non-whitespace text children.
fn _node_is_empty(ctx: SelectorContext, idx: i32) -> bool:
    if idx < 0 or idx >= ctx.has_content_child.len():
        return true
    not ctx.has_content_child[idx]

# Context phase of :not()/:is()/:where(): decides the options that need the
# node's sibling context. Options without a positional pseudo-class were
# already decided context-free; when no option needs context this is a no-op.
fn _list_ctx_matches(negate: bool, opts: [text], nodes: [HNode], ctx: SelectorContext, idx: i32) -> bool:
    val nd = nodes[idx]
    var any_ctx = false
    var matched = false
    var j = 0
    val opt_count = opts.len()
    while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 options of ONE :not()/:is()/:where() argument for one node
        val opt = opts[j]
        if opt.len() > 0:
            if _option_needs_ctx(opt):
                any_ctx = true
                if simple_match_ctx(opt, nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, nodes, ctx, idx):
                    matched = true
            elif not negate and simple_match(opt, nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, 1):
                matched = true
        j = j + 1
    if _sel_budget_blown():
        # Aborted: an exhausted option is unknown, not false. Never negate it.
        return false
    if not any_ctx:
        return true
    if negate:
        return not matched
    matched

# Full-context pseudo-class check. Called after simple_match() passes the base check.
# Returns true if all pseudo-class conditions on sel are satisfied given node context.
fn _pseudo_ctx_matches(sel: text, nodes: [HNode], ctx: SelectorContext, idx: i32) -> bool:
    val colon = text_index_of(sel, ":")
    if colon < 0:
        return true
    var pseudo_pos = colon
    var pseudo_count = 0
    val sel_blen = sel.byte_len()
    while pseudo_pos < sel_blen:  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector in the positional-pseudo pass; bound is that selector's length, pseudo_count capped at 32
        pseudo_count = pseudo_count + 1
        if pseudo_count > 32 or sel.substring(pseudo_pos, pseudo_pos + 1) != ":":
            return false
        val name_start = pseudo_pos + 1
        var name_end = name_start
        # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
        while (
            name_end < sel_blen and sel.substring(name_end, name_end + 1) != ":" and
            sel.substring(name_end, name_end + 1) != "(" and sel.substring(name_end, name_end + 1) != "["
        ):
            name_end = name_end + 1
        val pseudo = sel.substring(name_start, name_end)
        if pseudo.len() == 0:
            return false
        var arg = ""
        if name_end < sel_blen and sel.substring(name_end, name_end + 1) == "(":
            var functional_depth = 1
            var close = name_end + 1
            while close < sel_blen and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo-class argument in the positional pass; paren depth capped at 32
                val ch = sel.substring(close, close + 1)
                if ch == "(":
                    functional_depth = functional_depth + 1
                    if functional_depth > 32:
                        return false
                elif ch == ")":
                    functional_depth = functional_depth - 1
                close = close + 1
            if functional_depth != 0:
                return false
            arg = sel.substring(name_end + 1, close - 1).trim()
            pseudo_pos = close
        else:
            pseudo_pos = name_end
            if (
                pseudo == "root" and pseudo_pos < sel_blen and
                sel.substring(pseudo_pos, pseudo_pos + 1) == "["
            ):
                val attr_close = find_from(sel, "]", pseudo_pos + 1)
                if attr_close < 0:
                    return false
                pseudo_pos = attr_close + 1
        if pseudo == "empty":
            if not _node_is_empty(ctx, idx):
                return false
        elif pseudo == "first-child":
            if _child_position(ctx, idx) != 1:
                return false
        elif pseudo == "last-child":
            if _child_position(ctx, idx) != _sibling_count(ctx, idx):
                return false
        elif pseudo == "only-child":
            if _sibling_count(ctx, idx) != 1:
                return false
        elif pseudo == "first-of-type":
            if _type_position(ctx, idx) != 1:
                return false
        elif pseudo == "last-of-type":
            if _type_position(ctx, idx) != _type_count(ctx, idx):
                return false
        elif pseudo == "only-of-type":
            if _type_count(ctx, idx) != 1:
                return false
        elif (
            pseudo == "nth-child" or pseudo == "nth-last-child" or
            pseudo == "nth-of-type" or pseudo == "nth-last-of-type"
        ):
            val nth_code = _pseudo_code_for(pseudo)
            val of_at = _nth_of_offset(nth_code, arg)
            if of_at >= 0:
                val of_opts = _split_pseudo_options(arg.substring(of_at + 4, arg.byte_len()).trim())
                if not css_nth_matches(arg.substring(0, of_at), _nth_of_index(nth_code, of_opts, nodes, ctx, idx) as i64):
                    return false
            elif not css_nth_matches(arg, _nth_index_for(nth_code, nodes, ctx, idx) as i64):
                return false
        elif pseudo == "not" or pseudo == "is" or pseudo == "where":
            if not _list_ctx_matches(pseudo == "not", _split_pseudo_options(arg), nodes, ctx, idx):
                return false
        elif pseudo == "has":
            var opts: [text] = [""; 16]
            var opt_count = 0
            var depth = 0
            var i = 0
            var option_start = 0
            while i < arg.byte_len():  # cpu-lane-loop-ok: splits ONE :has() argument on top-level commas; bound is that argument's length
                val ch = arg.substring(i, i + 1)
                if ch == "(":
                    depth = depth + 1
                    if depth > 32:
                        return false
                elif ch == ")":
                    depth = depth - 1
                    if depth < 0:
                        return false
                elif ch == "," and depth == 0:
                    if opt_count >= opts.len():
                        return false
                    val option = arg.substring(option_start, i).trim()
                    if option.len() == 0:
                        return false
                    opts[opt_count] = option
                    opt_count = opt_count + 1
                    option_start = i + 1
                i = i + 1
            if depth != 0:
                return false
            val tail = arg.substring(option_start, arg.byte_len()).trim()
            if tail.len() == 0 or opt_count >= opts.len():
                return false
            if tail.len() > 0:
                opts[opt_count] = tail
                opt_count = opt_count + 1
            var matched = false
            var j = 0
            while j < opt_count and not matched:  # cpu-lane-loop-ok: walks the <=16 parsed :has() options, stopping at the first that matches
                matched = _has_option_matches(
                    nodes, ctx, idx, opts[j]
                )
                j = j + 1
            if not matched:
                return false
        elif not (
            pseudo == "root" or pseudo == "hover" or pseudo == "active" or
            pseudo == "focus" or pseudo == "focus-visible" or
            pseudo == "focus-within" or pseudo == "visited" or
            pseudo == "target" or pseudo == "checked" or
            pseudo == "placeholder-shown" or pseudo == "autofill" or
            pseudo == "disabled"
        ):
            # The state pseudo-classes above were decided by simple_match();
            # any other name is unknown.
            return false
    not _sel_budget_blown()

# Full-context simple match: base match + pseudo-class positional check.
fn simple_match_ctx(sel: text, tag: text, cls: text, class_words: [text], id: text, attrs: text, nodes: [HNode], ctx: SelectorContext, idx: i32) -> bool:
    # A top-level entry of its own (the text/pre-parsed oracle calls it
    # directly): open a budget scope here so an exhausted :has() inside a
    # negation cannot come back as a match.
    val top = _sel_depth == 0
    if top:
        _sel_steps = 0
    _sel_depth = _sel_depth + 1
    var matched = simple_match(sel, tag, cls, class_words, id, attrs)
    if matched:
        matched = _pseudo_ctx_matches(sel, nodes, ctx, idx)
    _sel_depth = _sel_depth - 1
    matched = matched and not _sel_budget_blown()
    if top:
        _sel_steps = 0
    matched

# ---------------------------------------------------------------------------
# Pre-parsed selector parts (round 9)
#
# `simple_match` / `simple_match_ctx` re-parse the selector TEXT of every
# candidate rule on EVERY node: base splitting, `.a.b` class splitting inside
# `class_has_all`, `[...]` group walking, `^=`/`$=`/`=` probing inside
# `attr_selector_matches`, the pseudo-class chain walk (twice -- once in
# `simple_match`, once in `_pseudo_ctx_matches`), the `:not()/:is()/:where()`
# and `:has()` comma splits, and the shared `css_nth_parse` An+B parse. All of
# that is node-INDEPENDENT, and the catalog pages run it ~4000x per render.
#
# `parse_selector_part` derives the same information ONCE per selector part,
# at `build_rule_buckets` time, into `ParsedSel`. The per-node path
# (`simple_match_parsed` / `_pseudo_ctx_matches_parsed`) then consumes only
# the record and never touches selector text again.
#
# Semantics are byte-identical by construction: the parser uses the SAME
# splitting/scanning code the text matcher uses, and `dead` is set ONLY for
# the cases where the text path returns `false` regardless of the node
# (a `::` pseudo-element, a malformed attribute/pseudo/functional argument,
# an unknown pseudo-class name, and every interaction-state pseudo --
# `:disabled` included, see _pseudo_code_for for why that one is subtle).
# Node-dependent arms (`:root`, `:root[...]`) stay runtime.
# Equivalence is pinned by web_selector_parsed_equivalence_spec.spl, which
# runs BOTH paths over every selector of the 8 catalog stylesheets and an
# adversarial fixture list, for every node, and compares per node.
#
# Residuals (deliberately left as text, both rare in the catalogs):
#   - `:not()/:is()/:where()` options and `:has()` options are pre-SPLIT but
#     not recursively pre-parsed; they still run the text `simple_match`.
#   - the `:root[attr]` attribute expression stays text.
# ---------------------------------------------------------------------------

# Pseudo-class codes. Unknown names never reach here (they set `dead`).
val PSEUDO_NOT: i32 = 1
val PSEUDO_ANY: i32 = 2          # :is() / :where()
val PSEUDO_ROOT: i32 = 5
val PSEUDO_EMPTY: i32 = 6
val PSEUDO_FIRST_CHILD: i32 = 7
val PSEUDO_LAST_CHILD: i32 = 8
val PSEUDO_ONLY_CHILD: i32 = 9
val PSEUDO_NTH_CHILD: i32 = 10
val PSEUDO_HAS: i32 = 11
pub val PSEUDO_NTH_LAST_CHILD: i32 = 12
val PSEUDO_NTH_OF_TYPE: i32 = 13
val PSEUDO_NTH_LAST_OF_TYPE: i32 = 14
val PSEUDO_CHECKED: i32 = 15
val PSEUDO_FIRST_OF_TYPE: i32 = 16
val PSEUDO_LAST_OF_TYPE: i32 = 17
val PSEUDO_ONLY_OF_TYPE: i32 = 18

# Attribute operators, in the order `attr_selector_matches` probes them.
val ATTR_OP_PRESENT: i32 = 0     # bare [name]
val ATTR_OP_EXACT: i32 = 1       # =
val ATTR_OP_PREFIX: i32 = 2      # ^=
val ATTR_OP_SUFFIX: i32 = 3      # $=
val ATTR_OP_SUBSTR: i32 = 4      # *=
val ATTR_OP_TOKEN: i32 = 5       # ~=
val ATTR_OP_DASH: i32 = 6        # |=

fn _dead_parsed_sel() -> ParsedSel:
    ParsedSel(
        kind: 0, dead: true, check_tag: false, want_tag: "", check_id: false,
        want_id: "", want_classes: [], attr_tests: [], pseudo_codes: [],
        pseudo_root_attrs: [], pseudo_opts: [], pseudo_nth_kind: [],
        pseudo_nth_a: [], pseudo_nth_b: []
    )

# Pre-parse ONE `[...]` expression the way attr_selector_matches() reads it.
pub fn _parse_attr_test(expr: text) -> ParsedAttr:
    var raw = expr.trim()
    if raw.len() == 0:
        # attr_selector_matches returns false for an empty expression;
        # parsed_attr_matches reproduces that from an empty presence test.
        return ParsedAttr(name: "", op: ATTR_OP_PRESENT, want: "", want_lower: "", ci: false)
    var case_insensitive = false
    if raw.ends_with(" i") or raw.ends_with(" I"):
        case_insensitive = true
        raw = raw.substring(0, raw.byte_len() - 2).trim()
    elif raw.ends_with(" s") or raw.ends_with(" S"):
        raw = raw.substring(0, raw.byte_len() - 2).trim()
    val prefix_op = text_index_of(raw, "^=")
    if prefix_op >= 0:
        val name = raw.substring(0, prefix_op).trim()
        val want = unquote_css_attr_value(raw.substring(prefix_op + 2, raw.byte_len()))
        return ParsedAttr(name: name, op: ATTR_OP_PREFIX, want: want, want_lower: want.lower(), ci: case_insensitive)
    val suffix_op = text_index_of(raw, "$=")
    if suffix_op >= 0:
        val name = raw.substring(0, suffix_op).trim()
        val want = unquote_css_attr_value(raw.substring(suffix_op + 2, raw.byte_len()))
        return ParsedAttr(name: name, op: ATTR_OP_SUFFIX, want: want, want_lower: want.lower(), ci: case_insensitive)
    # Substring/token/dash probes mirror attr_selector_matches: they run
    # before the bare "=" scan so the marker char left of the same "=" is
    # not swallowed into the attribute name of an exact test.
    val substr_op = text_index_of(raw, "*=")
    if substr_op >= 0:
        val name = raw.substring(0, substr_op).trim()
        val want = unquote_css_attr_value(raw.substring(substr_op + 2, raw.byte_len()))
        return ParsedAttr(name: name, op: ATTR_OP_SUBSTR, want: want, want_lower: want.lower(), ci: case_insensitive)
    val token_op = text_index_of(raw, "~=")
    if token_op >= 0:
        val name = raw.substring(0, token_op).trim()
        val want = unquote_css_attr_value(raw.substring(token_op + 2, raw.byte_len()))
        return ParsedAttr(name: name, op: ATTR_OP_TOKEN, want: want, want_lower: want.lower(), ci: case_insensitive)
    val dash_op = text_index_of(raw, "|=")
    if dash_op >= 0:
        val name = raw.substring(0, dash_op).trim()
        val want = unquote_css_attr_value(raw.substring(dash_op + 2, raw.byte_len()))
        return ParsedAttr(name: name, op: ATTR_OP_DASH, want: want, want_lower: want.lower(), ci: case_insensitive)
    val exact_op = text_index_of(raw, "=")
    if exact_op >= 0:
        val name = raw.substring(0, exact_op).trim()
        val want = unquote_css_attr_value(raw.substring(exact_op + 1, raw.byte_len()))
        return ParsedAttr(name: name, op: ATTR_OP_EXACT, want: want, want_lower: want.lower(), ci: case_insensitive)
    ParsedAttr(name: raw, op: ATTR_OP_PRESENT, want: "", want_lower: "", ci: case_insensitive)

fn _attr_op_eval_value(
    actual: text, present: bool, op: i32, want: text, want_lower: text, ci: bool
) -> bool:
    if op == ATTR_OP_PRESENT:
        return present
    if op == ATTR_OP_PREFIX:
        if ci:
            return actual.len() > 0 and actual.lower().starts_with(want_lower)
        return actual.len() > 0 and actual.starts_with(want)
    if op == ATTR_OP_SUFFIX:
        if ci:
            return actual.len() > 0 and actual.lower().ends_with(want_lower)
        return actual.len() > 0 and actual.ends_with(want)
    if op == ATTR_OP_SUBSTR:
        if ci:
            return actual.len() > 0 and actual.lower().contains(want_lower)
        return actual.len() > 0 and actual.contains(want)
    if op == ATTR_OP_TOKEN:
        if want.len() == 0:
            return false
        val words = split_class_words_trimmed(actual)
        var wi = 0
        while wi < words.len():
            if ci:
                if words[wi].lower() == want_lower:
                    return true
            else:
                if words[wi] == want:
                    return true
            wi = wi + 1
        return false
    if op == ATTR_OP_DASH:
        if ci:
            val a = actual.lower()
            return a == want_lower or a.starts_with(want_lower + "-")
        return actual == want or actual.starts_with(want + "-")
    if op == ATTR_OP_EXACT:
        if ci:
            return actual.lower() == want_lower
        return actual == want
    false

# reason: hot-path HNode bitmask CSS attribute matcher returns bool
# @allow(primitive_api)
pub fn parsed_attr_matches_node(nd: HNode, t: ParsedAttr) -> bool:
    if t.name.len() == 0 or nd.attr_mask == 0u32:
        return false
    val lower = t.name.lower()
    if (nd.attr_mask & hnode_attr_bloom_bit(lower)) == 0u32:
        return false
    val hot = hnode_hot_bit_for_name(lower)
    if hot != 0u32 and (nd.attr_mask & hot) == 0u32:
        return false
    if lower == "id":
        return _attr_op_eval_value(nd.id_attr, true, t.op, t.want, t.want_lower, t.ci)
    if lower == "class":
        return _attr_op_eval_value(nd.class_attr, true, t.op, t.want, t.want_lower, t.ci)
    if lower == "style":
        return _attr_op_eval_value(nd.style_attr, true, t.op, t.want, t.want_lower, t.ci)
    if lower == "role":
        return _attr_op_eval_value(nd.role_attr, true, t.op, t.want, t.want_lower, t.ci)
    if lower == "type":
        return _attr_op_eval_value(nd.type_attr, true, t.op, t.want, t.want_lower, t.ci)
    if t.op == ATTR_OP_PRESENT and hot != 0u32 and (
        hot == HNODE_ATTR_HIDDEN_BIT or hot == HNODE_ATTR_DISABLED_BIT or
        hot == HNODE_ATTR_CHECKED_BIT or hot == HNODE_ATTR_SELECTED_BIT or
        hot == HNODE_ATTR_OPEN_BIT
    ):
        return true
    parsed_attr_matches(nd.attrs_raw, t)

# reason: hot-path HNode bitmask CSS attribute selector helper returns bool
# @allow(primitive_api)
pub fn attr_selector_matches_node(nd: HNode, expr: text) -> bool:
    if nd.attr_mask == 0u32:
        return false
    parsed_attr_matches_node(nd, _parse_attr_test(expr))

# reason: hot-path HNode bitmask :checked pseudo predicate returns bool
# @allow(primitive_api)
pub fn _element_is_checked_node(nd: HNode) -> bool:
    if nd.tag == "input":
        if (nd.attr_mask & HNODE_ATTR_CHECKED_BIT) == 0u32:
            return false
        if (nd.attr_mask & HNODE_ATTR_TYPE_BIT) == 0u32:
            return false
        val tl = nd.type_attr.lower()
        return tl == "checkbox" or tl == "radio"
    if nd.tag == "option":
        return (nd.attr_mask & HNODE_ATTR_SELECTED_BIT) != 0u32
    false

# reason: hot-path HNode interaction pseudo-class predicate returns bool
# @allow(primitive_api)
pub fn _is_interaction_state_pseudo_node(pseudo: text, nd: HNode) -> bool:
    if pseudo == "disabled":
        return (nd.attr_mask & HNODE_ATTR_DISABLED_BIT) == 0u32
    _is_interaction_state_pseudo(pseudo, nd.attrs_raw)

fn parsed_attr_matches(attrs: text, t: ParsedAttr) -> bool:
    if t.op == ATTR_OP_PREFIX:
        val actual = attr_value(attrs, t.name)
        if t.ci:
            return actual.len() > 0 and actual.lower().starts_with(t.want_lower)
        return actual.len() > 0 and actual.starts_with(t.want)
    if t.op == ATTR_OP_SUFFIX:
        val actual = attr_value(attrs, t.name)
        if t.ci:
            return actual.len() > 0 and actual.lower().ends_with(t.want_lower)
        return actual.len() > 0 and actual.ends_with(t.want)
    if t.op == ATTR_OP_SUBSTR:
        val actual = attr_value(attrs, t.name)
        if t.ci:
            return actual.len() > 0 and actual.lower().contains(t.want_lower)
        return actual.len() > 0 and actual.contains(t.want)
    if t.op == ATTR_OP_TOKEN:
        # CSS Selectors 4: an empty ~= operand can never match.
        if t.want.len() == 0:
            return false
        val words = split_class_words_trimmed(attr_value(attrs, t.name))
        var wi = 0
        while wi < words.len():  # cpu-lane-loop-ok: linear scan of ONE node's attribute token list for one wanted token; bound is that attribute's token count
            if t.ci:
                if words[wi].lower() == t.want_lower:
                    return true
            else:
                if words[wi] == t.want:
                    return true
            wi = wi + 1
        return false
    if t.op == ATTR_OP_DASH:
        val actual = attr_value(attrs, t.name)
        if t.ci:
            val a = actual.lower()
            return a == t.want_lower or a.starts_with(t.want_lower + "-")
        return actual == t.want or actual.starts_with(t.want + "-")
    if t.op == ATTR_OP_EXACT:
        if t.ci:
            return attr_value(attrs, t.name).lower() == t.want_lower
        return attr_value(attrs, t.name) == t.want
    if t.name.len() == 0:
        # Mirrors attr_selector_matches' empty-expression rejection.
        return false
    attr_value(attrs, t.name).len() > 0 or attr_name_present(attrs, t.name)

# Split a functional pseudo argument on top-level commas exactly the way
# _pseudo_list_matches() and the `:has` arm of _pseudo_ctx_matches() do.
# Returns an empty list when those splitters would have returned false.
fn _split_pseudo_options(arg: text) -> [text]:
    var options: [text] = []
    var opt_count = 0
    var depth = 0
    var i = 0
    val arg_len = arg.byte_len()
    var option_start = 0
    while i < arg_len:  # cpu-lane-loop-ok: splits ONE functional pseudo argument on top-level commas at parse time (once per selector part); bound is that argument's length
        val ch = arg.substring(i, i + 1)
        if ch == "(":
            depth = depth + 1
            if depth > 32:
                return []
        elif ch == ")":
            depth = depth - 1
            if depth < 0:
                return []
        elif ch == "," and depth == 0:
            if opt_count >= 16:
                return []
            val option = arg.substring(option_start, i).trim()
            if option.len() == 0:
                return []
            options.push(option)
            opt_count = opt_count + 1
            option_start = i + 1
        i = i + 1
    if depth != 0:
        return []
    val tail = arg.substring(option_start, arg_len).trim()
    if tail.len() == 0 or opt_count >= 16:
        return []
    options.push(tail)
    options

fn _pseudo_code_for(name: text) -> i32:
    if name == "not":
        return PSEUDO_NOT
    if name == "is" or name == "where":
        return PSEUDO_ANY
    if name == "root":
        return PSEUDO_ROOT
    if name == "empty":
        return PSEUDO_EMPTY
    if name == "first-child":
        return PSEUDO_FIRST_CHILD
    if name == "last-child":
        return PSEUDO_LAST_CHILD
    if name == "only-child":
        return PSEUDO_ONLY_CHILD
    if name == "nth-child":
        return PSEUDO_NTH_CHILD
    if name == "nth-last-child":
        return PSEUDO_NTH_LAST_CHILD
    if name == "nth-of-type":
        return PSEUDO_NTH_OF_TYPE
    if name == "nth-last-of-type":
        return PSEUDO_NTH_LAST_OF_TYPE
    if name == "first-of-type":
        return PSEUDO_FIRST_OF_TYPE
    if name == "last-of-type":
        return PSEUDO_LAST_OF_TYPE
    if name == "only-of-type":
        return PSEUDO_ONLY_OF_TYPE
    if name == "checked":
        return PSEUDO_CHECKED
    if name == "has":
        return PSEUDO_HAS
    # hover/active/focus/focus-visible/focus-within/visited/target/
    # placeholder-shown/autofill are unconditionally unsatisfied for a static
    # render, and every other name is unknown; both make the part dead.
    #
    # `:disabled` is in that same dead set, which is NOT obvious from
    # _is_interaction_state_pseudo() and was caught only by the adversarial
    # half of web_selector_parsed_equivalence_spec.spl. In simple_match()'s
    # elif-chain, `:disabled` on an element WITHOUT the attribute takes the
    # `_is_interaction_state_pseudo` arm (which answers `not
    # attrs.contains("disabled")` = true) and returns false; on an element
    # WITH the attribute that arm answers false, so the chain falls through
    # to the final `pseudo != empty/first-child/last-child/only-child/
    # nth-child/has` arm -- which is also true -- and returns false again.
    # So `:disabled` never matches on EITHER branch. That is pre-existing
    # renderer behaviour, and this pre-parse reproduces it exactly rather
    # than quietly "fixing" it; see the round 9 metrics record.
    0 - 1

# Pre-decode an An+B argument with the shared evaluator (css_nth.spl):
# [kind, a, b] where kind 2 is a valid argument and -1 an invalid one, which
# matches nothing.
fn _parse_nth(expr: text) -> [i32]:
    val parsed = css_nth_parse(expr)
    if not parsed.valid:
        return [0 - 1, 0, 0]
    [2, parsed.a as i32, parsed.b as i32]

fn _nth_matches_parsed(kind: i32, a: i32, b: i32, pos: i32) -> bool:
    kind == 2 and css_nth_index_matches(a as i64, b as i64, pos as i64)

# Derive the ParsedSel record for ONE selector-group part. Mirrors
# simple_match()'s check order exactly; see the header comment above.
fn parse_selector_part(part: text) -> ParsedSel:
    if part.len() == 0:
        return ParsedSel(
            kind: 1, dead: false, check_tag: false, want_tag: "", check_id: false,
            want_id: "", want_classes: [], attr_tests: [], pseudo_codes: [],
            pseudo_root_attrs: [], pseudo_opts: [], pseudo_nth_kind: [],
            pseudo_nth_a: [], pseudo_nth_b: []
        )
    # Combinator tokens: kind 2 is `>`, 3 is `+`, 4 is `~`.
    val comb_code = _comb_code_of_part(part)
    if comb_code >= 0:
        return ParsedSel(
            kind: comb_code + 1, dead: false, check_tag: false, want_tag: "", check_id: false,
            want_id: "", want_classes: [], attr_tests: [], pseudo_codes: [],
            pseudo_root_attrs: [], pseudo_opts: [], pseudo_nth_kind: [],
            pseudo_nth_a: [], pseudo_nth_b: [], src: part
        )
    val sel = part
    # Pseudo-element selectors never match the host element.
    if text_index_of(sel, "::") >= 0:
        return _dead_parsed_sel()
    var base = sel
    val colon = text_index_of(base, ":")
    if colon >= 0:
        base = base.substring(0, colon)
    var attr_tests: [ParsedAttr] = []
    var node_base = base
    val attr_start = text_index_of(base, "[")
    if attr_start >= 0:
        val attr_end = text_index_of(base, "]")
        if attr_end < attr_start:
            return _dead_parsed_sel()
        node_base = base.substring(0, attr_start).trim()
        var group_start = attr_start
        var group_count = 0
        while group_start >= 0 and group_count < 32:  # cpu-lane-loop-ok: walks the bracket groups of ONE compound selector at parse time, capped at 32
            group_count = group_count + 1
            val rest = base.substring(group_start + 1, base.byte_len())
            val rel_end = text_index_of(rest, "]")
            if rel_end < 0:
                return _dead_parsed_sel()
            attr_tests.push(_parse_attr_test(rest.substring(0, rel_end)))
            val tail = rest.substring(rel_end + 1, rest.byte_len())
            val next_rel = text_index_of(tail, "[")
            if next_rel < 0:
                group_start = 0 - 1
            else:
                group_start = group_start + 1 + rel_end + 1 + next_rel
    # Base compound: the same _compound_base_tokens split base_selector_matches uses.
    var check_tag = false
    var want_tag = ""
    var check_id = false
    var want_id = ""
    var want_classes: [text] = []
    if node_base.len() > 0 and node_base != "*":
        val toks = _compound_base_tokens(node_base)
        if toks[1] == "x":
            return _dead_parsed_sel()
        check_tag = toks[0] != ""
        want_tag = toks[0]
        check_id = toks[1] == "1"
        want_id = toks[2]
        var k = 3
        while k < toks.len():  # cpu-lane-loop-ok: one compound's wanted classes at parse time
            want_classes.push(toks[k])
            k = k + 1
    # Pseudo-class chain: one parse, replacing the two independent walks in
    # simple_match() and _pseudo_ctx_matches().
    var pseudo_codes: [i32] = []
    var pseudo_root_attrs: [text] = []
    var pseudo_opts: [[text]] = []
    var pseudo_nth_kind: [i32] = []
    var pseudo_nth_a: [i32] = []
    var pseudo_nth_b: [i32] = []
    if colon >= 0:
        var pseudo_pos = colon
        var pseudo_count = 0
        val sel_blen = sel.byte_len()
        while pseudo_pos < sel_blen:  # cpu-lane-loop-ok: walks the pseudo-class chain of ONE selector at parse time; bound is that selector's length, pseudo_count capped at 32
            pseudo_count = pseudo_count + 1
            if pseudo_count > 32 or sel.substring(pseudo_pos, pseudo_pos + 1) != ":":
                return _dead_parsed_sel()
            val name_start = pseudo_pos + 1
            var name_end = name_start
            # cpu-lane-loop-ok: scans ONE pseudo-class NAME until `:`, `(` or `[`; bound is that name's length
            while (
                name_end < sel_blen and sel.substring(name_end, name_end + 1) != ":" and
                sel.substring(name_end, name_end + 1) != "(" and sel.substring(name_end, name_end + 1) != "["
            ):
                name_end = name_end + 1
            val pseudo = sel.substring(name_start, name_end)
            if pseudo.len() == 0:
                return _dead_parsed_sel()
            var arg = ""
            # Only the `:root[...]` form carries an attribute test. A
            # FUNCTIONAL argument on `root` (`:root(x)`) is parsed and then
            # ignored by the text path, whose `root` arm checks only
            # `tag != "html"` -- so it must not become an attribute test here.
            var root_attr = ""
            if name_end < sel_blen and sel.substring(name_end, name_end + 1) == "(":
                var functional_depth = 1
                var close = name_end + 1
                while close < sel_blen and functional_depth > 0:  # cpu-lane-loop-ok: matches the closing paren of ONE functional pseudo argument at parse time; paren depth capped at 32
                    val ch = sel.substring(close, close + 1)
                    if ch == "(":
                        functional_depth = functional_depth + 1
                        if functional_depth > 32:
                            return _dead_parsed_sel()
                    elif ch == ")":
                        functional_depth = functional_depth - 1
                    close = close + 1
                if functional_depth != 0:
                    return _dead_parsed_sel()
                arg = sel.substring(name_end + 1, close - 1).trim()
                pseudo_pos = close
            else:
                pseudo_pos = name_end
                if (
                    pseudo == "root" and pseudo_pos < sel_blen and
                    sel.substring(pseudo_pos, pseudo_pos + 1) == "["
                ):
                    val attr_close = find_from(sel, "]", pseudo_pos + 1)
                    if attr_close < 0:
                        return _dead_parsed_sel()
                    root_attr = sel.substring(pseudo_pos + 1, attr_close)
                    pseudo_pos = attr_close + 1
            val code = _pseudo_code_for(pseudo)
            if code < 0:
                return _dead_parsed_sel()
            var opts: [text] = []
            if code == PSEUDO_NOT or code == PSEUDO_ANY:
                # `simple_match` splits :not/:is/:where itself and returns
                # false when the split fails, regardless of the node.
                opts = _split_pseudo_options(arg)
                if opts.len() == 0:
                    return _dead_parsed_sel()
            elif code == PSEUDO_HAS:
                # `:has` is NOT dead on a split failure. `simple_match`'s
                # elif-chain excludes `has`, so it never inspects the
                # argument and passes `ul:has()` through as MATCHING; only
                # `_pseudo_ctx_matches` splits it and rejects. That
                # distinction is invisible on a rightmost part (both end up
                # false) but decides an ANCESTOR part, where only
                # `simple_match` runs. An empty opts list here reproduces it:
                # `simple_match_parsed` ignores HAS entirely and
                # `_pseudo_ctx_matches_parsed` returns false on empty opts.
                opts = _split_pseudo_options(arg)
            var nth_kind = 0
            var nth_a = 0
            var nth_b = 0
            if (
                code == PSEUDO_NTH_CHILD or code == PSEUDO_NTH_LAST_CHILD or
                code == PSEUDO_NTH_OF_TYPE or code == PSEUDO_NTH_LAST_OF_TYPE
            ):
                # `An+B of S`: the An+B part is pre-parsed and S's options
                # ride in pseudo_opts (empty for the plain form).
                val of_at = _nth_of_offset(code, arg)
                var anb = arg
                if of_at >= 0:
                    anb = arg.substring(0, of_at)
                    opts = _split_pseudo_options(arg.substring(of_at + 4, arg.byte_len()).trim())
                val nth = _parse_nth(anb)
                nth_kind = nth[0]
                nth_a = nth[1]
                nth_b = nth[2]
                if of_at >= 0 and opts.len() == 0:
                    nth_kind = 0 - 1
            pseudo_codes.push(code)
            pseudo_root_attrs.push(root_attr)
            pseudo_opts.push(opts)
            pseudo_nth_kind.push(nth_kind)
            pseudo_nth_a.push(nth_a)
            pseudo_nth_b.push(nth_b)
    ParsedSel(
        kind: 0, dead: false, check_tag: check_tag, want_tag: want_tag,
        check_id: check_id, want_id: want_id, want_classes: want_classes,
        attr_tests: attr_tests, pseudo_codes: pseudo_codes,
        pseudo_root_attrs: pseudo_root_attrs, pseudo_opts: pseudo_opts,
        pseudo_nth_kind: pseudo_nth_kind, pseudo_nth_a: pseudo_nth_a,
        pseudo_nth_b: pseudo_nth_b, src: part
    )

fn parse_selector_group(parts: [text]) -> [ParsedSel]:
    var out: [ParsedSel] = []
    var i = 0
    val n = parts.len()
    while i < n:  # cpu-lane-loop-ok: pre-parses the parts of ONE selector group, once per style invalidation; bound is that group's part count
        out.push(parse_selector_part(parts[i]))
        i = i + 1
    out

# Node-independent-work-free equivalent of simple_match().
fn simple_match_parsed(
    p: ParsedSel, tag: text, cls: text, class_words: [text], id: text, attrs: text
) -> bool:
    if p.dead or p.kind != 0:
        return false
    if p.check_tag and p.want_tag != tag:
        return false
    if p.check_id and p.want_id != id:
        return false
    var ci = 0
    val class_wanted = p.want_classes.len()
    while ci < class_wanted:  # cpu-lane-loop-ok: checks the pre-split class wants of ONE compound selector against ONE node; bound is that compound's class count
        if not class_words_has(class_words, p.want_classes[ci]):
            return false
        ci = ci + 1
    var ai = 0
    val attr_count = p.attr_tests.len()
    while ai < attr_count:  # cpu-lane-loop-ok: checks the pre-parsed attribute tests of ONE compound selector against ONE node; capped at 32 at parse time
        if not parsed_attr_matches(attrs, p.attr_tests[ai]):
            return false
        ai = ai + 1
    var pi = 0
    val pseudo_count = p.pseudo_codes.len()
    while pi < pseudo_count:  # cpu-lane-loop-ok: evaluates the pre-parsed pseudo-class chain of ONE selector against ONE node; capped at 32 at parse time
        val code = p.pseudo_codes[pi]
        if code == PSEUDO_NOT:
            val opts = p.pseudo_opts[pi]
            var j = 0
            val opt_count = opts.len()
            while j < opt_count:  # cpu-lane-loop-ok: walks the <=16 pre-split :not() options, returning false at the first that matches
                if not _option_needs_ctx(opts[j]) and simple_match(opts[j], tag, cls, class_words, id, attrs, 1):
                    return false
                j = j + 1
        elif code == PSEUDO_ANY:
            val opts = p.pseudo_opts[pi]
            var any_matched = false
            var j = 0
            val opt_count = opts.len()
            while j < opt_count and not any_matched:  # cpu-lane-loop-ok: walks the <=16 pre-split :is()/:where() options, stopping at the first that matches
                any_matched = _option_needs_ctx(opts[j]) or simple_match(opts[j], tag, cls, class_words, id, attrs, 1)
                j = j + 1
            if not any_matched:
                return false
        elif code == PSEUDO_CHECKED:
            if not _element_is_checked(tag, attrs):
                return false
        elif code == PSEUDO_ROOT:
            if tag != "html":
                return false
            val root_attr = p.pseudo_root_attrs[pi]
            if root_attr.len() > 0 and not attr_selector_matches(attrs, root_attr):
                return false
        pi = pi + 1
    true

# Node-independent-work-free equivalent of _pseudo_ctx_matches(). Consumes the
# SAME pre-parsed chain simple_match_parsed() walks, so the duplicate
# pseudo-chain walk of the two-pass text path disappears with it.
fn _pseudo_ctx_matches_parsed(
    p: ParsedSel, nodes: [HNode], ctx: SelectorContext, idx: i32
) -> bool:
    var pi = 0
    val pseudo_count = p.pseudo_codes.len()
    while pi < pseudo_count:  # cpu-lane-loop-ok: evaluates the positional arms of ONE selector's pre-parsed pseudo chain; capped at 32 at parse time
        val code = p.pseudo_codes[pi]
        if code == PSEUDO_EMPTY:
            if not _node_is_empty(ctx, idx):
                return false
        elif code == PSEUDO_FIRST_CHILD:
            if _child_position(ctx, idx) != 1:
                return false
        elif code == PSEUDO_LAST_CHILD:
            if _child_position(ctx, idx) != _sibling_count(ctx, idx):
                return false
        elif code == PSEUDO_ONLY_CHILD:
            if _sibling_count(ctx, idx) != 1:
                return false
        elif code == PSEUDO_FIRST_OF_TYPE:
            if _type_position(ctx, idx) != 1:
                return false
        elif code == PSEUDO_LAST_OF_TYPE:
            if _type_position(ctx, idx) != _type_count(ctx, idx):
                return false
        elif code == PSEUDO_ONLY_OF_TYPE:
            if _type_count(ctx, idx) != 1:
                return false
        elif (
            code == PSEUDO_NTH_CHILD or code == PSEUDO_NTH_LAST_CHILD or
            code == PSEUDO_NTH_OF_TYPE or code == PSEUDO_NTH_LAST_OF_TYPE
        ):
            val of_opts = p.pseudo_opts[pi]
            val nth_index = if of_opts.len() > 0: _nth_of_index(code, of_opts, nodes, ctx, idx) else: _nth_index_for(code, nodes, ctx, idx)
            if not _nth_matches_parsed(
                p.pseudo_nth_kind[pi], p.pseudo_nth_a[pi], p.pseudo_nth_b[pi],
                nth_index
            ):
                return false
        elif code == PSEUDO_NOT or code == PSEUDO_ANY:
            if not _list_ctx_matches(code == PSEUDO_NOT, p.pseudo_opts[pi], nodes, ctx, idx):
                return false
        elif code == PSEUDO_HAS:
            val opts = p.pseudo_opts[pi]
            var matched = false
            var j = 0
            val opt_count = opts.len()
            while j < opt_count and not matched:  # cpu-lane-loop-ok: walks the <=16 pre-split :has() options, stopping at the first that matches
                matched = _has_option_matches(nodes, ctx, idx, opts[j])
                j = j + 1
            if not matched:
                return false
        pi = pi + 1
    not _sel_budget_blown()

# reason: hot-path parsed selector matcher against HNode returns bool
# @allow(primitive_api)
pub fn simple_match_parsed_node(p: ParsedSel, nd: HNode) -> bool:
    if p.dead or p.kind != 0:
        return false
    if p.check_tag and p.want_tag != nd.tag:
        return false
    if p.check_id and p.want_id != nd.id_attr:
        return false
    var ci = 0
    val class_wanted = p.want_classes.len()
    while ci < class_wanted:
        if not class_words_has(nd.class_words, p.want_classes[ci]):
            return false
        ci = ci + 1
    var ai = 0
    val attr_count = p.attr_tests.len()
    while ai < attr_count:
        if not parsed_attr_matches_node(nd, p.attr_tests[ai]):
            return false
        ai = ai + 1
    var pi = 0
    val pseudo_count = p.pseudo_codes.len()
    while pi < pseudo_count:
        val code = p.pseudo_codes[pi]
        if code == PSEUDO_NOT:
            val opts = p.pseudo_opts[pi]
            var j = 0
            val opt_count = opts.len()
            while j < opt_count:
                if not _option_needs_ctx(opts[j]) and simple_match(opts[j], nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, 1):
                    return false
                j = j + 1
        elif code == PSEUDO_ANY:
            val opts = p.pseudo_opts[pi]
            var any_matched = false
            var j = 0
            val opt_count = opts.len()
            while j < opt_count and not any_matched:
                any_matched = _option_needs_ctx(opts[j]) or simple_match(opts[j], nd.tag, nd.class_attr, nd.class_words, nd.id_attr, nd.attrs_raw, 1)
                j = j + 1
            if not any_matched:
                return false
        elif code == PSEUDO_CHECKED:
            if not _element_is_checked_node(nd):
                return false
        elif code == PSEUDO_ROOT:
            if nd.tag != "html":
                return false
            val root_attr = p.pseudo_root_attrs[pi]
            if root_attr.len() > 0 and not attr_selector_matches_node(nd, root_attr):
                return false
        pi = pi + 1
    true

fn simple_match_ctx_parsed_node(
    p: ParsedSel, nd: HNode, nodes: [HNode], ctx: SelectorContext, idx: i32
) -> bool:
    val top = _sel_depth == 0
    if top:
        _sel_steps = 0
    _sel_depth = _sel_depth + 1
    var matched = simple_match_parsed_node(p, nd)
    if matched:
        matched = _pseudo_ctx_matches_parsed(p, nodes, ctx, idx)
    _sel_depth = _sel_depth - 1
    matched = matched and not _sel_budget_blown()
    if top:
        _sel_steps = 0
    matched

fn simple_match_ctx_parsed(
    p: ParsedSel, tag: text, cls: text, class_words: [text], id: text,
    attrs: text, nodes: [HNode], ctx: SelectorContext, idx: i32
) -> bool:
    val top = _sel_depth == 0
    if top:
        _sel_steps = 0
    _sel_depth = _sel_depth + 1
    var matched = simple_match_parsed(p, tag, cls, class_words, id, attrs)
    if matched:
        matched = _pseudo_ctx_matches_parsed(p, nodes, ctx, idx)
    _sel_depth = _sel_depth - 1
    matched = matched and not _sel_budget_blown()
    if top:
        _sel_steps = 0
    matched

fn selector_group_matches_node_parsed(
    nodes: [HNode], ctx: SelectorContext, idx: i32, parsed: [ParsedSel]
) -> bool:
    if _wsc_armed():
        val t0 = _wsc_now_us()
        val matched = _selector_group_matches_node_parsed_inner(nodes, ctx, idx, parsed)
        _wsc_add_selector(_wsc_now_us() - t0)
        return matched
    _selector_group_matches_node_parsed_inner(nodes, ctx, idx, parsed)

fn _sel_prefix_key_parsed(parsed: [ParsedSel], j: i32, parent: i32) -> text:
    var key = "p" + parent.to_string() + "|"
    var i = 0
    while i <= j:  # cpu-lane-loop-ok: joins the prefix parts of ONE selector group for a cache key
        key = key + parsed[i].src.byte_len().to_string() + ":" + parsed[i].src
        i = i + 1
    key

# Pre-parsed twin of _chain_match_text() (no :has() anchor): same return
# codes, same budget, same per-pass sibling cache under its own key space.
fn _chain_match_parsed(nodes: [HNode], ctx: SelectorContext, idx: i32, parsed: [ParsedSel], k: i32) -> i32:
    if _sel_step():
        return 4
    val nd = nodes[idx]
    val compound_ok = simple_match_ctx_parsed_node(
        parsed[k], nd, nodes, ctx, idx
    )
    if _sel_budget_blown():
        return 4
    if not compound_ok:
        return 0
    var comb = COMB_DESCENDANT
    var comb_tokens = 0
    var j = k - 1
    while j >= 0:  # cpu-lane-loop-ok: skips the empty/combinator tokens between two compounds of ONE selector group
        val kind = parsed[j].kind
        if kind == 1:
            j = j - 1
        elif kind >= 2:
            comb = kind - 1
            comb_tokens = comb_tokens + 1
            j = j - 1
        else:
            break
    if comb_tokens > 1:
        return 4
    if j < 0:
        return if comb_tokens == 0: 1 else: 4
    if comb == COMB_CHILD:
        val parent = nd.parent as i32
        if parent < 0:
            return 0
        return _chain_match_parsed(nodes, ctx, parent, parsed, j)
    if comb == COMB_NEXT_SIBLING:
        val prev = ctx.prev_element[idx]
        if prev < 0:
            return 3
        return _chain_match_parsed(nodes, ctx, prev, parsed, j)
    if comb == COMB_SUBSEQUENT_SIBLING:
        val parent = nd.parent as i32
        if parent < 0:
            return 3
        val key = _sel_prefix_key_parsed(parsed, j, parent)
        var earliest = _sel_cache_get(ctx, key)
        if earliest < 0:
            earliest = 0
            var c = ctx.child_index.first_child[parent]
            while c >= 0:  # cpu-lane-loop-ok: one forward pass over ONE parent's children per (parent, selector prefix) per style pass
                if nodes[c].tag != "#text":
                    val r = _chain_match_parsed(nodes, ctx, c, parsed, j)
                    if r == 4:
                        return 4
                    if r == 1:
                        earliest = ctx.element_position[c]
                        break
                    if r == 2:
                        break
                c = ctx.child_index.next_sibling[c]
            if _sel_budget_blown():
                return 4
            _sel_cache_put(key, earliest)
        return if earliest > 0 and earliest < ctx.element_position[idx]: 1 else: 3
    var a = nd.parent as i32
    while a >= 0:  # cpu-lane-loop-ok: descendant-combinator walk up the parent chain of ONE node; bound is its tree depth
        val r = _chain_match_parsed(nodes, ctx, a, parsed, j)
        if r == 1 or r == 2 or r == 4:
            return r
        a = nodes[a].parent as i32
    2

fn _selector_group_matches_node_parsed_inner(
    nodes: [HNode], ctx: SelectorContext, idx: i32, parsed: [ParsedSel]
) -> bool:
    var right = (parsed.len() as i32) - 1
    while right >= 0 and parsed[right].kind == 1:  # cpu-lane-loop-ok: skips trailing empty parts of ONE selector group; bound is that group's part count
        right = right - 1
    if right < 0 or parsed[right].kind != 0:
        # Empty, or ends in a combinator (`div >`): invalid, matches nothing.
        return false
    if parsed.len() > CSS_SELECTOR_PART_CAP:
        return false
    val top = _sel_depth == 0
    if top:
        _sel_steps = 0
    _sel_depth = _sel_depth + 1
    val chain_matched = _chain_match_parsed(nodes, ctx, idx, parsed, right) == 1
    _sel_depth = _sel_depth - 1
    # Exhaustion is sticky for the whole match: whatever negation or list the
    # exhausted part sat in, the rule does not match.
    val matched = chain_matched and not _sel_budget_blown()
    if top:
        _sel_steps = 0
    matched

# ---------------------------------------------------------------------------
# Ancestor-feature prefilter (2026-10-04).
#
# A candidate such as `.c5x > a:hover` is bucketed under its RIGHTMOST compound
# (`a`), so every <a> in the document is offered every such rule and runs the
# full right-to-left walk above just to discover that no ancestor carries
# `.c5x`. Measured on a google-shaped page: 106,381 group matches, 38 s of a
# 74 s style stage. This is the interpreter-lane equivalent of Blink's
# ancestor bloom filter, but EXACT (a counted multiset, no false positives).
#
# Soundness, from `_selector_group_matches_node_parsed_inner` above: every
# part left of the rightmost compound is either skipped (kind 1), a `>` marker
# (kind 2), or must be satisfied by `simple_match_parsed` on SOME node of the
# `.parent` chain. `simple_match_parsed` requires `tag == want_tag` when
# `check_tag`, `id == want_id` when `check_id`, and every `want_classes` entry
# to be present in `class_words`; it rejects dead and non-zero-kind parts
# outright. So whenever the matcher returns true, each of those features is on
# some ancestor. The keys below are exactly those features, and the node keys
# are built from the same `tag`/`id_attr`/`class_words` fields the matcher
# reads, so a missing key proves the matcher would return false. A group with
# a part that can never match gets the key `!`, which no node ever carries.
# The filter only skips calls whose answer is already false.
fn selector_group_ancestor_keys(parsed: [ParsedSel]) -> [text]:
    # A compound is an ANCESTOR of the subject exactly when the combinator on
    # its right is descendant or child: the element to its right is then the
    # subject, an ancestor of it, or a previous sibling of one of those, and a
    # sibling shares its ancestors. A compound whose right combinator is `+`
    # or `~` is a sibling, so its features are not required on the ancestor
    # chain and it contributes no key. A dead compound anywhere still makes
    # the group unmatchable.
    var keys: [text] = []
    var right = (parsed.len() as i32) - 1
    while right >= 0 and parsed[right].kind != 0:  # cpu-lane-loop-ok: mirrors the matcher's trailing-token skip for ONE selector group; bound is its part count
        right = right - 1
    var right_comb_is_sibling = false
    var want = right - 1
    while want >= 0:  # cpu-lane-loop-ok: walks ONE selector group's parts once per rule per style pass (cached by the caller); bound is that group's part count
        val part = parsed[want]
        if part.kind == 3 or part.kind == 4:
            right_comb_is_sibling = true
        elif part.kind == 2:
            right_comb_is_sibling = false
        elif part.kind == 0:
            if part.dead:
                return ["!"]
            if not right_comb_is_sibling:
                if part.check_tag:
                    keys.push("t:" + part.want_tag)
                if part.check_id:
                    keys.push("i:" + part.want_id)
                var ci = 0
                while ci < part.want_classes.len():  # cpu-lane-loop-ok: the wanted classes of ONE ancestor compound; bound is that compound's class count
                    keys.push("c:" + part.want_classes[ci])
                    ci = ci + 1
            right_comb_is_sibling = false
        want = want - 1
    keys

fn selector_node_feature_keys(nd: HNode) -> [text]:
    var keys: [text] = ["t:" + nd.tag, "i:" + nd.id_attr]
    var ci = 0
    while ci < nd.class_words.len():  # cpu-lane-loop-ok: ONE node's class words; bound is that node's class count
        keys.push("c:" + nd.class_words[ci])
        ci = ci + 1
    keys

fn selector_ancestor_keys_present(counts: Dict<text, i32>, keys: [text]) -> bool:
    var ki = 0
    while ki < keys.len():  # cpu-lane-loop-ok: required ancestor features of ONE selector group; bound is that group's feature count
        val key = keys[ki]
        if not counts.has(key):
            return false
        if counts[key] <= 0:
            return false
        ki = ki + 1
    true

fn split_selector_groups(sel: text) -> [text]:
    var depth = 0
    var i = 0
    val sel_len = sel.byte_len()
    var group_count = 0
    var group_start = 0
    while i < sel_len:  # cpu-lane-loop-ok: counting pass over ONE selector's characters to size the comma-group array; bound is that selector's length
        val ch = sel.substring(i, i + 1)
        if ch == "(":
            depth = depth + 1
            if depth > 32:
                return []
        elif ch == ")":
            depth = depth - 1
            if depth < 0:
                return []
        elif ch == "," and depth == 0:
            if sel.substring(group_start, i).trim().len() == 0:
                return []
            group_count = group_count + 1
            if group_count >= CSS_SELECTOR_GROUP_CAP:
                return []
            group_start = i + 1
        i = i + 1
    if depth != 0:
        return []
    if sel.substring(group_start, sel_len).trim().len() == 0:
        return []
    group_count = group_count + 1
    if group_count == 0 or group_count > CSS_SELECTOR_GROUP_CAP:
        return []
    var groups: [text] = [""; group_count]
    depth = 0
    i = 0
    var group_i = 0
    group_start = 0
    while i < sel_len and group_i < group_count:  # cpu-lane-loop-ok: emit pass over the same selector, filling the <=CSS_SELECTOR_GROUP_CAP group array
        val ch = sel.substring(i, i + 1)
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            if depth > 0:
                depth = depth - 1
        elif ch == "," and depth == 0:
            groups[group_i] = sel.substring(group_start, i).trim()
            group_i = group_i + 1
            group_start = i + 1
        i = i + 1
    if group_i < groups.len():
        val tail = sel.substring(group_start, sel_len).trim()
        if tail.len() > 0:
            groups[group_i] = tail
    groups

# Surround every top-level combinator (`>`, `+`, `~`) with spaces so that
# selector_group_parts() emits it as its own token. "Top level" excludes
# parentheses (`:nth-child(2n+1)`, `:has(> a)`) and brackets (`[rel~="x"]`).
fn normalize_child_combinators(group: text) -> text:
    var i = 0
    val group_len = group.byte_len()
    var depth = 0
    var combinator_count = 0
    while i < group_len and combinator_count <= CSS_SELECTOR_PART_CAP:  # cpu-lane-loop-ok: counting pass over ONE selector group's characters; bound is that group's length
        val ch = group.substring(i, i + 1)
        if ch == "\\":
            # A backslash escapes the next character (`.a\+b` is one class).
            i = i + 1
        elif ch == "(" or ch == "[":
            depth = depth + 1
        elif ch == ")" or ch == "]":
            if depth > 0:
                depth = depth - 1
        elif (ch == ">" or ch == "+" or ch == "~") and depth == 0:
            combinator_count = combinator_count + 1
        i = i + 1
    if combinator_count > CSS_SELECTOR_PART_CAP:
        return ""
    if combinator_count == 0:
        return group.trim()
    val chunk_count = combinator_count * 2 + 1
    var chunks: [text] = [""; chunk_count]
    var chunk_i = 0
    var start = 0
    i = 0
    depth = 0
    while i < group_len:  # cpu-lane-loop-ok: emit pass over the same group, splitting it around each top-level combinator
        val ch = group.substring(i, i + 1)
        if ch == "\\":
            i = i + 1
        elif ch == "(" or ch == "[":
            depth = depth + 1
        elif ch == ")" or ch == "]":
            if depth > 0:
                depth = depth - 1
        elif (ch == ">" or ch == "+" or ch == "~") and depth == 0:
            chunks[chunk_i] = group.substring(start, i)
            chunk_i = chunk_i + 1
            chunks[chunk_i] = " " + ch + " "
            chunk_i = chunk_i + 1
            start = i + 1
        i = i + 1
    chunks[chunk_i] = group.substring(start, group_len)
    chunks.join("").trim()

fn selector_group_parts(group: text) -> [text]:
    # Split on spaces at depth-0 only: depth counts ( ) and [ ] so that spaces
    # inside :has(> .x) args and [attr='val with spaces'] are preserved.
    val normalized = normalize_child_combinators(group)
    val norm_len = normalized.byte_len()
    # First pass: count tokens
    var token_count = 0
    var depth = 0
    var in_token = false
    var pi = 0
    while pi < norm_len and token_count <= CSS_SELECTOR_PART_CAP:  # cpu-lane-loop-ok: token-counting pass over ONE normalized selector group; bound is that group's length, capped at CSS_SELECTOR_PART_CAP tokens
        val ch = normalized.substring(pi, pi + 1)
        if ch == "(" or ch == "[":
            depth = depth + 1
            if not in_token:
                token_count = token_count + 1
                in_token = true
        elif ch == ")" or ch == "]":
            if depth > 0:
                depth = depth - 1
        elif ch == " " and depth == 0:
            in_token = false
        else:
            if not in_token:
                token_count = token_count + 1
                in_token = true
        pi = pi + 1
    if token_count > CSS_SELECTOR_PART_CAP:
        return []
    if token_count == 0:
        return [""]
    var parts: [text] = [""; token_count]
    var part_i = 0
    depth = 0
    in_token = false
    var token_start = -1
    pi = 0
    while pi < norm_len:  # cpu-lane-loop-ok: token-emit pass over the same normalized group, slicing each depth-0 whitespace-separated part
        val ch = normalized.substring(pi, pi + 1)
        if ch == "(" or ch == "[":
            if not in_token:
                token_start = pi
            depth = depth + 1
            in_token = true
        elif ch == ")" or ch == "]":
            if not in_token:
                token_start = pi
            if depth > 0:
                depth = depth - 1
            in_token = true
        elif ch == " " and depth == 0:
            if in_token:
                if part_i < token_count:
                    parts[part_i] = normalized.substring(token_start, pi).trim()
                    part_i = part_i + 1
                token_start = -1
                in_token = false
        else:
            if not in_token:
                token_start = pi
            in_token = true
        pi = pi + 1
    if token_start >= 0 and part_i < token_count:
        val tail = normalized.substring(token_start, norm_len).trim()
        if tail.len() > 0:
            parts[part_i] = tail
    var ci = 0
    while ci < parts.len():  # cpu-lane-loop-ok: canonicalises each part of ONE selector group
        parts[ci] = _canonical_compound(parts[ci])
        ci = ci + 1
    parts

# Reorder ONE compound selector into the tag, #id, .class, [attr], :pseudo
# order both matchers read, so `div.a.b#t` and `:is(p, div).k` match
# like Chrome. Relative order within each kind is kept; a malformed compound
# comes back unchanged.
fn _canonical_compound(part: text) -> text:
    val n = part.byte_len()
    if n == 0 or _comb_code_of_part(part) >= 0:
        return part
    var i = 0
    while i < n and not ".#[:".contains(part.substring(i, i + 1)):  # cpu-lane-loop-ok: leading type selector of ONE compound
        if part.substring(i, i + 1) == "\\":
            i = i + 1
        i = i + 1
    if i >= n:
        return part
    val tag = part.substring(0, i)
    var ids = ""
    var classes = ""
    var attrs = ""
    var pseudos = ""
    while i < n:  # cpu-lane-loop-ok: walks the simple selectors of ONE compound
        val start = i
        val ch = part.substring(i, i + 1)
        if ch == "[":
            val close = find_from(part, "]", i + 1)
            if close < 0:
                return part
            i = close + 1
            attrs = attrs + part.substring(start, i)
        elif ch == ":":
            i = i + 1
            if i < n and part.substring(i, i + 1) == ":":
                i = i + 1
            while i < n and not ".#[:(".contains(part.substring(i, i + 1)):  # cpu-lane-loop-ok: ONE pseudo name
                if part.substring(i, i + 1) == "\\":
                    i = i + 1
                i = i + 1
            if i < n and part.substring(i, i + 1) == "(":
                var depth = 1
                i = i + 1
                while i < n and depth > 0:  # cpu-lane-loop-ok: ONE functional argument
                    val c = part.substring(i, i + 1)
                    if c == "(":
                        depth = depth + 1
                    elif c == ")":
                        depth = depth - 1
                    i = i + 1
                if depth != 0:
                    return part
            pseudos = pseudos + part.substring(start, i)
        else:
            i = i + 1
            while i < n and not ".#[:".contains(part.substring(i, i + 1)):  # cpu-lane-loop-ok: ONE class or id name
                if part.substring(i, i + 1) == "\\":
                    i = i + 1
                i = i + 1
            if ch == "#":
                ids = ids + part.substring(start, i)
            else:
                classes = classes + part.substring(start, i)
    tag + ids + classes + attrs + pseudos

# Elements whose text child is metadata, not rendered content (HTML "metadata
# content" plus the raw-text elements the tokenizer already treats specially at
# :850). Their text is never laid out or painted, so it needs no font metrics.
fn _html_metadata_text_container(tag: text) -> bool:
    # `noscript` is deliberately NOT in this list: this engine runs no scripts,
    # so a real browser in the same configuration RENDERS its content.
    tag == "style" or tag == "script" or tag == "title" or tag == "head" or
        tag == "meta" or tag == "link" or tag == "base" or tag == "template"

fn selector_group_matches_node_parts(nodes: [HNode], ctx: SelectorContext, idx: i32, parts: [text]) -> bool:
    if _wsc_armed():
        val t0 = _wsc_now_us()
        val matched = _selector_group_matches_node_parts_inner(nodes, ctx, idx, parts)
        _wsc_add_selector(_wsc_now_us() - t0)
        return matched
    _selector_group_matches_node_parts_inner(nodes, ctx, idx, parts)

fn _selector_group_matches_node_parts_inner(nodes: [HNode], ctx: SelectorContext, idx: i32, parts: [text]) -> bool:
    var right = (parts.len() as i32) - 1
    while right >= 0 and parts[right].len() == 0:  # cpu-lane-loop-ok: skips trailing empty parts of ONE selector group; bound is that group's part count
        right = right - 1
    if right < 0 or _comb_code_of_part(parts[right]) >= 0:
        # Empty, or ends in a combinator (`div >`): invalid, matches nothing.
        return false
    if parts.len() > CSS_SELECTOR_PART_CAP:
        return false
    val top = _sel_depth == 0
    if top:
        _sel_steps = 0
    _sel_depth = _sel_depth + 1
    val chain_matched = _chain_match_text(nodes, ctx, idx, parts, right, 0 - 1) == 1
    _sel_depth = _sel_depth - 1
    # Exhaustion is sticky for the whole match: whatever negation or list the
    # exhausted part sat in, the rule does not match.
    val matched = chain_matched and not _sel_budget_blown()
    if top:
        _sel_steps = 0
    matched
