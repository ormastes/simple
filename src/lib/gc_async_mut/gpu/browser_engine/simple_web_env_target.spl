@cfg("os", "simpleos")
use std.gc_async_mut.gpu.browser_engine.simple_web_env_simpleos.{simple_web_env_get as _simple_web_env_get_target}

@cfg(macos or linux or windows or freebsd or openbsd or netbsd or android)
use std.gc_async_mut.io.mod_stub.{env_get as _simple_web_env_get_target}

# Own a concrete wrapper symbol instead of re-exporting an imported private
# alias. Native entry-closure otherwise binds consumers to the hosted raw
# env_get owner even when cfg discovery selected the SimpleOS provider.
fn env_get(key: text) -> text?:
    _simple_web_env_get_target(key)

export env_get
