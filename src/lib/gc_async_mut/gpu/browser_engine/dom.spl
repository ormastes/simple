class StyleProps:
    """Inline CSS properties on a browser engine node."""
    display: text          # "block", "inline", "flex", "none", ""
    width: f64             # px, 0 = auto
    height: f64            # px, 0 = auto
    margin_top: f64
    margin_right: f64
    margin_bottom: f64
    margin_left: f64
    padding_top: f64
    padding_right: f64
    padding_bottom: f64
    padding_left: f64
    color: text            # CSS color string
    background_color: text
    font_size: f64         # px
    font_weight: text      # "normal", "bold"
    font_family: text
    line_height: f64       # px; 0 = "normal" (resolved at layout)
    text_align: text       # "left", "center", "right"
    border_width: f64
    border_color: text
    border_style: text
    flex_direction: text   # "row", "column"
    flex_grow: f64
    position: text         # "static", "relative", "absolute", "fixed"
    top: f64
    left: f64
    z_index: i64
    overflow: text         # "visible", "hidden", "scroll"
    float_css: text        # "none", "left", "right"
    clear_css: text        # "none", "left", "right", "both"

impl StyleProps:
    static fn empty() -> StyleProps:
        StyleProps(
            display: "",
            width: 0.0,
            height: 0.0,
            margin_top: 0.0,
            margin_right: 0.0,
            margin_bottom: 0.0,
            margin_left: 0.0,
            padding_top: 0.0,
            padding_right: 0.0,
            padding_bottom: 0.0,
            padding_left: 0.0,
            color: "",
            background_color: "",
            font_size: 16.0,
            font_weight: "normal",
            font_family: "sans-serif",
            line_height: 0.0,
            text_align: "left",
            border_width: 0.0,
            border_color: "",
            border_style: "none",
            flex_direction: "row",
            flex_grow: 0.0,
            position: "static",
            top: 0.0,
            left: 0.0,
            z_index: 0,
            overflow: "visible",
            float_css: "none",
            clear_css: "none"
        )

# =========================================================================
# CSS value helpers
#
# These live in dom.spl (rather than css.spl) on purpose: css.spl imports
# StyleProps from here, so calling into it from `set_style` would close an
# import cycle. They are deliberately small and self-contained.
# =========================================================================

# Marks which CSS properties were explicitly declared on a node, so the
# inheritance pass can tell "computed 0/empty" from "never declared".
# StyleProps carries non-neutral defaults (font_size 16.0, font_family
# "sans-serif", text_align "left", font_weight "normal"), so the field value
# alone is an ambiguous sentinel and cannot answer that question.
#
# Stored under a NUL-prefixed attribute key, the convention already used by
# `set_attr` for its render-cache sentinels; DOM consumers filter that prefix.
val CSS_SET_MARKER_PREFIX: text = "\u0000simple-css-set:"

fn css_split_ws(value: text) -> [text]:
    """Split a CSS value on runs of whitespace, dropping empty parts."""
    val norm = value.trim().replace("\t", " ").replace("\n", " ").replace("\r", " ")
    val parts = norm.split(" ")
    var out: [text] = []
    var i = 0
    while i < parts.len():
        val p = parts[i].trim()
        if p != "":
            out.push(p)
        i = i + 1
    out

fn css_length_px(value: text, font_px: f64) -> f64:
    """Resolve a CSS <length> to px. Percentages need a containing block, so
    they resolve to 0.0 here and are left to layout."""
    val v = value.trim().lower()
    if v == "" or v == "auto" or v == "none" or v == "inherit" or v == "initial":
        return 0.0
    # border-width keywords
    if v == "thin": return 1.0
    if v == "medium": return 3.0
    if v == "thick": return 5.0
    # "rem" must be tested before "em" -- "rem".ends_with("em") is true.
    if v.ends_with("rem"):
        return (v.substring(0, v.len() - 3).trim().parse_f64() ?? 0.0) * 16.0
    if v.ends_with("px"):
        return v.substring(0, v.len() - 2).trim().parse_f64() ?? 0.0
    if v.ends_with("em"):
        return (v.substring(0, v.len() - 2).trim().parse_f64() ?? 0.0) * font_px
    if v.ends_with("pt"):
        return (v.substring(0, v.len() - 2).trim().parse_f64() ?? 0.0) * 4.0 / 3.0
    if v.ends_with("%"):
        return 0.0
    v.parse_f64() ?? 0.0

fn css_font_size_px(value: text, parent_px: f64) -> f64:
    """Resolve a CSS <font-size> to px. Absolute keywords use the CSS2.1
    medium=16px scale; relative units resolve against `parent_px`."""
    val v = value.trim().lower()
    if v == "medium": return 16.0
    if v == "xx-small": return 9.0
    if v == "x-small": return 10.0
    if v == "small": return 13.0
    if v == "large": return 18.0
    if v == "x-large": return 24.0
    if v == "xx-large": return 32.0
    if v == "smaller": return parent_px / 1.2
    if v == "larger": return parent_px * 1.2
    if v.ends_with("%"):
        val pct = v.substring(0, v.len() - 1).trim().parse_f64() ?? 100.0
        return parent_px * pct / 100.0
    css_length_px(v, parent_px)

fn css_is_length_token(tok: text) -> bool:
    """True when `tok` looks like a <length> rather than a color or keyword."""
    val v = tok.trim().lower()
    if v == "thin" or v == "medium" or v == "thick": return true
    if v == "": return false
    (
        v.ends_with("px") or v.ends_with("em") or v.ends_with("rem") or
        v.ends_with("pt") or v.ends_with("%") or (v.parse_f64() ?? -1.0) >= 0.0
    )

fn css_is_unit_length(tok: text) -> bool:
    """True when `tok` carries an explicit length unit (so it is NOT a bare
    unitless number such as a `line-height: 1.5` multiplier)."""
    val v = tok.trim().lower()
    (
        v.ends_with("px") or v.ends_with("em") or v.ends_with("rem") or
        v.ends_with("pt") or v.ends_with("%")
    )

fn css_is_border_style_token(tok: text) -> bool:
    val v = tok.trim().lower()
    (
        v == "none" or v == "hidden" or v == "dotted" or v == "dashed" or
        v == "solid" or v == "double" or v == "groove" or v == "ridge" or
        v == "inset" or v == "outset"
    )

fn css_box_sides(value: text, font_px: f64) -> [f64]:
    """Expand a 1/2/3/4-value box shorthand into [top, right, bottom, left]."""
    val parts = css_split_ws(value)
    if parts.len() == 0:
        return [0.0, 0.0, 0.0, 0.0]
    val a = css_length_px(parts[0], font_px)
    if parts.len() == 1:
        return [a, a, a, a]
    val b = css_length_px(parts[1], font_px)
    if parts.len() == 2:
        return [a, b, a, b]
    val c = css_length_px(parts[2], font_px)
    if parts.len() == 3:
        return [a, b, c, b]
    val d = css_length_px(parts[3], font_px)
    [a, b, c, d]

class BeDomNode:
    """A node in the browser engine document tree.

    Represents both element and text nodes. Text nodes have
    tag_name == "#text" and data populated.
    """
    node_id: i64
    tag_name: text          # e.g. "div", "span", "#text", "#document"
    data: text              # text content for #text nodes
    attributes: Dict<text, text>
    style: StyleProps
    children: [BeDomNode]
    parent_id: i64          # -1 for root
    event_listener_types: [text]
    event_listener_actions: [text]
    event_listener_capture: [bool]

    me add_event_listener_with_capture(event_type: text, action: text, capture: bool):
        """Register a listener, appending to the parallel listener arrays."""
        self.event_listener_types.push(event_type.trim().lower())
        self.event_listener_actions.push(action)
        self.event_listener_capture.push(capture)

class BeDomEvent:
    event_type: text
    namespace_uri: text
    target_id: text
    current_target_id: text
    related_target_id: text
    bubbles: bool
    cancelable: bool
    default_prevented: bool
    propagation_stopped: bool

    static fn create(event_type: text, namespace_uri: text, target_id: text, current_target_id: text, related_target_id: text, bubbles: bool, cancelable: bool) -> BeDomEvent:
        BeDomEvent(event_type: event_type, namespace_uri: namespace_uri, target_id: target_id, current_target_id: current_target_id, related_target_id: related_target_id, bubbles: bubbles, cancelable: cancelable, default_prevented: false, propagation_stopped: false)

    me prevent_default():
        self.default_prevented = true

    me stop_propagation():
        self.propagation_stopped = true

class BeDomEventDispatch:
    actions: [text]

fn normalize_dom_event_type(event_type: text) -> text:
    event_type.trim().lower()

fn be_dom_find_by_id(node: BeDomNode, id_value: text) -> BeDomNode?:
    if node.attributes.get("id") ?? "" == id_value:
        return Some(node)
    for child in node.children:
        val found = be_dom_find_by_id(child, id_value)
        if found.?:
            return found
    nil

fn be_dom_query_selector(node: BeDomNode, selector: text) -> BeDomNode?:
    if selector.starts_with("#"):
        return be_dom_find_by_id(node, selector.substring(1, selector.len()))
    if node.tag_name == selector:
        return Some(node)
    for child in node.children:
        val found = be_dom_query_selector(child, selector)
        if found.?:
            return found
    nil

fn be_dom_get_text_content(node: BeDomNode) -> text:
    if node.tag_name == "#text":
        return node.data
    var out = ""
    for child in node.children:
        out = out + be_dom_get_text_content(child)
    out

impl BeDomNode:
    static fn element(tag_name: text) -> BeDomNode:
        """Construct an element node with auto node_id=0."""
        BeDomNode(
            node_id: 0,
            tag_name: tag_name,
            data: "",
            attributes: {},
            style: StyleProps.empty(),
            children: [],
            parent_id: -1
        )

    static fn element(node_id: i64, tag_name: text) -> BeDomNode:
        """Construct an element node."""
        BeDomNode(
            node_id: node_id,
            tag_name: tag_name,
            data: "",
            attributes: {},
            style: StyleProps.empty(),
            children: [],
            parent_id: -1
        )

    static fn text_node(node_id: i64, data: text) -> BeDomNode:
        """Construct a text node."""
        BeDomNode(
            node_id: node_id,
            tag_name: "#text",
            data: data,
            attributes: {},
            style: StyleProps.empty(),
            children: [],
            parent_id: -1
        )

    static fn document() -> BeDomNode:
        """Construct a root document node."""
        BeDomNode(
            node_id: 0,
            tag_name: "#document",
            data: "",
            attributes: {},
            style: StyleProps.empty(),
            children: [],
            parent_id: -1
        )

    fn is_element() -> bool:
        self.tag_name != "#text" and self.tag_name != "#document"

    fn is_text() -> bool:
        self.tag_name == "#text"

    fn get_attr(name: text) -> text:
        self.attributes.get(name) ?? ""

    fn set_attr(name: text, value: text):
        self.attributes[name] = value

    me remove_attr(name: text):
        self.attributes.remove(name)

    me add_child(child: BeDomNode):
        var c = child
        c.parent_id = self.node_id
        self.children.push(c)

    me mark_css_declared(prop: text):
        """Record that `prop` was explicitly declared on this node."""
        self.attributes[CSS_SET_MARKER_PREFIX + prop] = "1"

    fn css_declared(prop: text) -> bool:
        """True when `prop` was explicitly declared on this node."""
        self.attributes.has(CSS_SET_MARKER_PREFIX + prop)

    me set_style(prop: text, value: text):
        """Set a CSS property on this node's inline style by name.

        Longhands are stored directly; the margin/padding/border shorthands are
        expanded here because StyleProps has no shorthand slot to hold them.
        Lengths resolve against this node's own font-size (already cascaded by
        the time a dependent longhand arrives, since declarations are applied in
        source order and `font-size` is inherited before the subtree is walked).
        """
        val p = prop.trim().lower()
        val v = value.trim()
        val fpx = self.style.font_size
        # --- keyword / text-valued longhands -----------------------------
        if p == "display":
            s.display = v
        elif p == "float":
            s.float_css = v
        elif p == "clear":
            s.clear_css = v
        elif p == "overflow":
            s.overflow = v
        elif p == "position":
            s.position = v
        elif p == "color":
            s.color = v
        elif p == "background-color":
            s.background_color = v
        elif p == "font-weight":
            self.style.font_weight = v
        elif p == "font-family":
            self.style.font_family = v
        elif p == "text-align":
            self.style.text_align = v
        elif p == "flex-direction":
            self.style.flex_direction = v
        elif p == "border-color":
            self.style.border_color = v
        elif p == "border-style":
            self.style.border_style = v
        # --- font-size (its own unit rules; must precede em-relative use) --
        elif p == "font-size":
            self.style.font_size = css_font_size_px(v, fpx)
        # --- box dimensions ----------------------------------------------
        elif p == "width":
            self.style.width = css_length_px(v, fpx)
        elif p == "height":
            self.style.height = css_length_px(v, fpx)
        elif p == "top":
            self.style.top = css_length_px(v, fpx)
        elif p == "left":
            self.style.left = css_length_px(v, fpx)
        elif p == "flex-grow":
            self.style.flex_grow = v.parse_f64() ?? 0.0
        elif p == "z-index":
            self.style.z_index = v.to_i64() ?? 0
        # --- margin ------------------------------------------------------
        elif p == "margin-top":
            self.style.margin_top = css_length_px(v, fpx)
        elif p == "margin-right":
            self.style.margin_right = css_length_px(v, fpx)
        elif p == "margin-bottom":
            self.style.margin_bottom = css_length_px(v, fpx)
        elif p == "margin-left":
            self.style.margin_left = css_length_px(v, fpx)
        elif p == "margin":
            val m = css_box_sides(v, fpx)
            self.style.margin_top = m[0]
            self.style.margin_right = m[1]
            self.style.margin_bottom = m[2]
            self.style.margin_left = m[3]
        # --- padding -----------------------------------------------------
        elif p == "padding-top":
            self.style.padding_top = css_length_px(v, fpx)
        elif p == "padding-right":
            self.style.padding_right = css_length_px(v, fpx)
        elif p == "padding-bottom":
            self.style.padding_bottom = css_length_px(v, fpx)
        elif p == "padding-left":
            self.style.padding_left = css_length_px(v, fpx)
        elif p == "padding":
            val pd = css_box_sides(v, fpx)
            self.style.padding_top = pd[0]
            self.style.padding_right = pd[1]
            self.style.padding_bottom = pd[2]
            self.style.padding_left = pd[3]
        # --- border ------------------------------------------------------
        # StyleProps keeps ONE border_width, so per-side widths collapse onto
        # it. That is lossy for asymmetric borders; noted, not fixed here.
        elif (
            p == "border-width" or p == "border-top-width" or
            p == "border-right-width" or p == "border-bottom-width" or
            p == "border-left-width"
        ):
            self.style.border_width = css_length_px(v, fpx)
        elif p == "border":
            # `border: <width> || <style> || <color>` in any order.
            val toks = css_split_ws(v)
            var ti = 0
            while ti < toks.len():
                val tok = toks[ti]
                ti = ti + 1
                if css_is_border_style_token(tok):
                    self.style.border_style = tok.lower()
                elif css_is_length_token(tok):
                    self.style.border_width = css_length_px(tok, fpx)
                else:
                    self.style.border_color = tok
            if toks.len() > 0 and self.style.border_style == "none":
                # `border: 2px blue` with no style keyword paints nothing in
                # CSS, and a zero width is how this engine expresses that.
                self.style.border_width = 0.0
        elif p == "line-height":
            # No dedicated slot; a unitless multiplier resolves against the
            # node's font-size, matching the CSS used-value rule.
            val raw = v.lower()
            if raw == "normal":
                self.style.line_height = fpx * 1.2
            elif (raw.parse_f64() ?? -1.0) >= 0.0 and not css_is_unit_length(raw):
                self.style.line_height = (raw.parse_f64() ?? 0.0) * fpx
            else:
                self.style.line_height = css_length_px(raw, fpx)
        else:
            return
        self.mark_css_declared(p)

# =========================================================================
# Inheritance
# =========================================================================

# The CSS inherited properties this engine models. `width`, `margin-*`,
# `padding-*`, `border-*` and `display` are deliberately absent -- they are
# NOT inherited in CSS.
fn css_inherited_property_names() -> [text]:
    ["color", "font-family", "font-size", "font-weight", "line-height", "text-align"]

fn inherit_style_into(parent: BeDomNode, child: BeDomNode) -> BeDomNode:
    """Copy each inherited property the child did not declare itself."""
    var c = child
    if not c.css_declared("color"):
        c.style.color = parent.style.color
    if not c.css_declared("font-family"):
        c.style.font_family = parent.style.font_family
    if not c.css_declared("font-size"):
        c.style.font_size = parent.style.font_size
    if not c.css_declared("font-weight"):
        c.style.font_weight = parent.style.font_weight
    if not c.css_declared("line-height"):
        c.style.line_height = parent.style.line_height
    if not c.css_declared("text-align"):
        c.style.text_align = parent.style.text_align
    c

pub fn apply_style_inheritance(root: BeDomNode) -> BeDomNode:
    """Propagate inherited CSS properties down the tree, parent before child.

    Must run AFTER the cascade: a child's own declaration wins over the
    inherited value, and `css_declared` is what records that it had one.
    """
    var node = root
    var kids: [BeDomNode] = []
    var i = 0
    while i < node.children.len():
        val inherited = inherit_style_into(node, node.children[i])
        kids.push(apply_style_inheritance(inherited))
        i = i + 1
    node.children = kids
    node

export StyleProps
export BeDomNode
export apply_style_inheritance
export BeDomEvent
export BeDomEventDispatch
export normalize_dom_event_type
export be_dom_find_by_id
export be_dom_query_selector
export be_dom_get_text_content
