use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    simple_web_engine2d_render_html_pixels,
    simple_web_engine2d_render_html_pixels_at_time,
    simple_web_engine2d_render_html_pixels_at_time_with_animations,
    simple_web_html_background_color
}
use std.gc_async_mut.gpu.browser_engine.style.animation.{
    BrowserCssAnimationInstance
}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_with_images,
    simple_web_layout_render_html_pixels_engine2d_at_time_with_images,
    simple_web_layout_render_html_pixels_engine2d_at_time_with_animations_with_images
}
use std.common.gpu.simpleos_host_gpu_draw_ir.{SimpleOsHostGpuImageResource}
use std.gc_async_mut.gpu.browser_engine.layout.{BeLayoutBox, layout_tree, layout_get_x, layout_get_y, layout_get_width, layout_get_height, layout_get_children}
use std.common.render_scene.scene.{RenderScene, SceneCommand, render_scene}

class BrowserSceneCommand:
    kind: text
    color: u32

class BrowserRenderScene:
    width: i32
    height: i32
    commands: [BrowserSceneCommand]

class BeRenderResult:
    pixels: [u8]
    pixel_data: [u32]
    width: i32
    height: i32
    title: text
    source_html: text
    ok: bool
    error: text
    scene: BrowserRenderScene
    node_count: i32

impl BeRenderResult:
    static fn success_argb(pixels: [u32], width: i32, height: i32, title: text, scene: BrowserRenderScene) -> BeRenderResult:
        BeRenderResult(pixels: [], pixel_data: pixels, width: width, height: height, title: title, source_html: "", ok: true, error: "", scene: scene, node_count: 0)

    static fn success_html(pixels: [u32], width: i32, height: i32, title: text, source_html: text, scene: BrowserRenderScene) -> BeRenderResult:
        BeRenderResult(pixels: [], pixel_data: pixels, width: width, height: height, title: title, source_html: source_html, ok: true, error: "", scene: scene, node_count: 0)

    static fn failure(width: i32, height: i32, error: text) -> BeRenderResult:
        BeRenderResult(pixels: [], pixel_data: [], width: width, height: height, title: "", source_html: "", ok: false, error: error, scene: BrowserRenderScene(width: width, height: height, commands: []), node_count: 0)

    fn byte_count() -> i64:
        self.width.to_i64() * self.height.to_i64() * 4

    fn to_scene() -> BrowserRenderScene:
        self.scene

    fn has_html_capture() -> bool:
        self.source_html != ""

class BrowserRenderer:
    width: i32
    height: i32
    backend_value: text
    # Why the requested backend was not selected. Empty when backend_value is
    # exactly what the caller asked for (honest provenance — a "software"
    # backend_value with a non-empty reason means a GPU request fell back).
    backend_fallback: text
    engine: bool?

impl BrowserRenderer:
    static fn create(width: i32, height: i32) -> BrowserRenderer:
        BrowserRenderer(width: width, height: height, backend_value: "software", backend_fallback: "", engine: nil)

    static fn create_with_backend(width: i32, height: i32, backend_name: text) -> BrowserRenderer:
        if backend_name == "software" or backend_name == "cpu" or backend_name == "metal":
            return BrowserRenderer(width: width, height: height, backend_value: backend_name, backend_fallback: "", engine: true)
        if backend_name == "vulkan" or backend_name == "webgpu":
            # Route through Engine2D's real name dispatch instead of silently
            # degrading. Probe the requested backend for real; on success the
            # renderer carries the ACTUAL initialized backend name, on failure
            # it reports software WITH the reason — never "vulkan" over software.
            val created = Engine2D.create_requested_backend(width, height, backend_name)
            match created:
                Ok(engine):
                    val actual = engine.selected_backend_name
                    engine.shutdown()
                    return BrowserRenderer(width: width, height: height, backend_value: actual, backend_fallback: "", engine: true)
                Err(reason):
                    return BrowserRenderer(width: width, height: height, backend_value: "software", backend_fallback: "{backend_name} unavailable: {reason}", engine: nil)
        BrowserRenderer(width: width, height: height, backend_value: "software", backend_fallback: "unknown backend '{backend_name}'", engine: nil)

    fn backend_name() -> text:
        self.backend_value

    fn backend_fallback_reason() -> text:
        """Empty when the requested backend actually initialized; otherwise
        the honest reason this renderer runs on software instead."""
        self.backend_fallback

    fn render_html(html: text) -> BeRenderResult:
        self.render_html_to_pixels(html)

    fn render_html_to_pixels(html: text) -> BeRenderResult:
        val pixels = simple_web_engine2d_render_html_pixels(html, self.width, self.height, self.backend_value)
        val scene = BrowserRenderScene(width: self.width, height: self.height, commands: [BrowserSceneCommand(kind: "fill_rect", color: _browser_scene_color(html, pixels))])
        BeRenderResult.success_html(pixels, self.width, self.height, _browser_title(html), html, scene)

    fn render_html_with_images(
        html: text, images: [SimpleOsHostGpuImageResource]
    ) -> BeRenderResult:
        self.render_html_to_pixels_with_images(html, images)

    fn render_html_to_pixels_with_images(
        html: text, images: [SimpleOsHostGpuImageResource]
    ) -> BeRenderResult:
        val pixels = simple_web_layout_render_html_pixels_engine2d_with_images(
            html, self.width, self.height, self.backend_value, images
        )
        val scene = BrowserRenderScene(
            width: self.width, height: self.height,
            commands: [BrowserSceneCommand(
                kind: "fill_rect", color: _browser_scene_color(html, pixels)
            )]
        )
        BeRenderResult.success_html(
            pixels, self.width, self.height, _browser_title(html), html, scene
        )

    fn render_html_to_pixels_at_time(html: text, animation_time_ms: i64) -> BeRenderResult:
        val pixels = simple_web_engine2d_render_html_pixels_at_time(
            html, self.width, self.height, self.backend_value,
            animation_time_ms
        )
        val scene = BrowserRenderScene(width: self.width, height: self.height, commands: [BrowserSceneCommand(kind: "fill_rect", color: _browser_scene_color(html, pixels))])
        BeRenderResult.success_html(pixels, self.width, self.height, _browser_title(html), html, scene)

    fn render_html_to_pixels_at_time_with_images(
        html: text, animation_time_ms: i64,
        images: [SimpleOsHostGpuImageResource]
    ) -> BeRenderResult:
        val pixels = (
            simple_web_layout_render_html_pixels_engine2d_at_time_with_images(
                html, self.width, self.height, self.backend_value,
                animation_time_ms, images
            )
        )
        val scene = BrowserRenderScene(
            width: self.width, height: self.height,
            commands: [BrowserSceneCommand(
                kind: "fill_rect", color: _browser_scene_color(html, pixels)
            )]
        )
        BeRenderResult.success_html(
            pixels, self.width, self.height, _browser_title(html), html, scene
        )

    fn render_html_to_pixels_at_time_with_animations(
        html: text, animation_time_ms: i64,
        animation_instances: [BrowserCssAnimationInstance]
    ) -> BeRenderResult:
        val pixels = (
            simple_web_engine2d_render_html_pixels_at_time_with_animations(
                html, self.width, self.height, self.backend_value,
                animation_time_ms, animation_instances
            )
        )
        val scene = BrowserRenderScene(
            width: self.width, height: self.height,
            commands: [BrowserSceneCommand(
                kind: "fill_rect", color: _browser_scene_color(html, pixels)
            )]
        )
        BeRenderResult.success_html(
            pixels, self.width, self.height, _browser_title(html), html, scene
        )

    fn render_html_to_pixels_at_time_with_animations_with_images(
        html: text, animation_time_ms: i64,
        animation_instances: [BrowserCssAnimationInstance],
        images: [SimpleOsHostGpuImageResource]
    ) -> BeRenderResult:
        val pixels = (
            simple_web_layout_render_html_pixels_engine2d_at_time_with_animations_with_images(
                html, self.width, self.height, self.backend_value,
                animation_time_ms, animation_instances, images
            )
        )
        val scene = BrowserRenderScene(
            width: self.width, height: self.height,
            commands: [BrowserSceneCommand(
                kind: "fill_rect", color: _browser_scene_color(html, pixels)
            )]
        )
        BeRenderResult.success_html(
            pixels, self.width, self.height, _browser_title(html), html, scene
        )

    # Render a decorated DOM tree into a canonical RenderScene by running the
    # real block-layout pass and emitting a fill_rect paint command per box.
    fn render_dom(dom: BeDomNode) -> RenderScene:
        val box = layout_tree(dom, self.width.to_f64(), self.height.to_f64())
        var commands: [SceneCommand] = [SceneCommand.fill_rect(0, 0, self.width, self.height, 16777215)]
        commands = _browser_paint_boxes(box, commands)
        render_scene(commands, self.width, self.height)

fn _browser_paint_boxes(box: BeLayoutBox, commands: [SceneCommand]) -> [SceneCommand]:
    val x = layout_get_x(box).to_i32()
    val y = layout_get_y(box).to_i32()
    val w = layout_get_width(box).to_i32()
    val h = layout_get_height(box).to_i32()
    var out = commands
    if w > 0 and h > 0:
        out = out.push(SceneCommand.stroke_rect(x, y, w, h, 13421772, 1))
    val children = layout_get_children(box)
    var idx = 0
    val child_count = children.len()
    while idx < child_count:
        out = _browser_paint_boxes(children[idx], out)
        idx = idx + 1
    out

fn _browser_title(html: text) -> text:
    val lower = html.lower()
    val start = lower.index_of("<title>")
    if start < 0:
        return ""
    val content_start = start + 7
    val tail = lower.substring(content_start, lower.len())
    val end_rel = tail.index_of("</title>")
    if end_rel < 0:
        return ""
    val end = content_start + end_rel
    html.substring(content_start, end).trim()

fn _browser_scene_color(html: text, pixels: [u32]) -> u32:
    val bg = simple_web_html_background_color(html)
    if bg != 0xFFFFFFFFu32:
        return bg
    # Scan for first non-white pixel — represents the dominant colored element
    var idx: i32 = 0
    val pixel_count = pixels.len()
    while idx < pixel_count:
        if pixels[idx] != 0xFFFFFFFFu32:
            return pixels[idx]
        idx = idx + 1
    0xFFFFFFFFu32

fn browser_renderer_html_string_to_dom(html: text) -> BeDomNode:
    var root = BeDomNode.document()
    var body = BeDomNode.element_with_id(1, "body")
    body.children.push(BeDomNode.text_node(2, html))
    root.children.push(body)
    root

pub fn render_html_to_pixels_with_viewport(html: text, width: i32, height: i32) -> BeRenderResult:
    # Split rather than chained: the seed interpreter cannot dispatch a method
    # on a static-call result in a nested call context.
    val renderer = BrowserRenderer.create(width, height)
    renderer.render_html_to_pixels(html)

pub fn render_html_to_pixels_with_viewport_with_images(
    html: text, width: i32, height: i32,
    images: [SimpleOsHostGpuImageResource]
) -> BeRenderResult:
    BrowserRenderer.create(width, height).render_html_to_pixels_with_images(
        html, images
    )

pub fn render_html_to_pixel_array(html: text, width: i32, height: i32) -> [u32]:
    render_html_to_pixels_with_viewport(html, width, height).pixel_data
