use std.gc_async_mut.gpu.browser_engine.dom.{
    BeDomNode, BeDomEvent, StyleProps,
    normalize_dom_event_type
}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomIdentityIndex, DomNodeRoute, DomRadioGroupKey
}
use common.web.html_escape.{html_escape_core}

fn be_dom_add_child(mut parent: BeDomNode, child: BeDomNode):
    """Append a child node to parent.children and set child.parent_id."""
    var c = child
    c.parent_id = parent.node_id
    parent.children.push(c)

fn be_dom_get_children(node: BeDomNode) -> [BeDomNode]:
    """Return the direct children of a node."""
    node.children

fn be_dom_remove_child(mut parent: BeDomNode, child_id: i64):
    """Remove the first child with the given node_id from parent.children."""
    val kept_count = be_dom_child_count_except(parent, child_id)
    if kept_count == 0:
        parent.children = []
        return
    var new_children: [BeDomNode] = [parent.children[0]; kept_count]
    var i = 0
    var out_idx = 0
    val child_count = parent.children.len()
    while i < child_count:
        val child = parent.children[i]
        if child.node_id != child_id:
            new_children[out_idx] = child
            out_idx = out_idx + 1
        i = i + 1
    parent.children = new_children

fn be_dom_child_count_except(parent: BeDomNode, child_id: i64) -> i32:
    var count = 0
    var i = 0
    val child_count = parent.children.len()
    while i < child_count:
        if parent.children[i].node_id != child_id:
            count = count + 1
        i = i + 1
    count

fn be_dom_insert_before(mut parent: BeDomNode, new_child: BeDomNode, ref_id: i64):
    """Insert new_child immediately before the child with ref_id."""
    val child_count = parent.children.len()
    val output_count = child_count + 1
    var new_children: [BeDomNode] = [new_child; output_count]
    var inserted = false
    var i = 0
    var out_idx = 0
    var nc = new_child
    nc.parent_id = parent.node_id
    while i < child_count:
        if parent.children[i].node_id == ref_id:
            new_children[out_idx] = nc
            out_idx = out_idx + 1
            inserted = true
        new_children[out_idx] = parent.children[i]
        out_idx = out_idx + 1
        i = i + 1
    if not inserted:
        new_children[out_idx] = nc
    parent.children = new_children

fn be_dom_set_attr(mut node: BeDomNode, name: text, value: text):
    """Set an attribute on a node."""
    node.set_attr(name, value)

fn be_dom_get_attr(node: BeDomNode, name: text) -> text:
    """Get an attribute value, returning "" if absent."""
    node.attributes.get(name) ?? ""

fn _be_dom_void_tag(tag: text) -> bool:
    (
        tag == "area" or tag == "base" or tag == "br" or tag == "col" or
        tag == "embed" or tag == "hr" or tag == "img" or tag == "input" or
        tag == "link" or tag == "meta" or tag == "param" or tag == "source" or
        tag == "track" or tag == "wbr"
    )

val BE_DOM_HTML_SERIALIZE_MAX_DEPTH: i32 = 512
val BE_DOM_HTML_SERIALIZE_MAX_FRAGMENTS: i64 = 262144
val BE_DOM_HTML_SERIALIZE_MAX_OUTPUT_LENGTH: i64 = 50 * 1024 * 1024

class _BeDomHtmlSerializationState:
    parts: [text]
    fragment_count: i64
    output_length: i64
    failed: bool

    static fn create() -> _BeDomHtmlSerializationState:
        _BeDomHtmlSerializationState(
            parts: [], fragment_count: 0, output_length: 0, failed: false
        )

    me fail_closed():
        self.parts = []
        self.failed = true

    me remaining_output_length() -> i64:
        BE_DOM_HTML_SERIALIZE_MAX_OUTPUT_LENGTH - self.output_length

    me can_push_length(length: i64) -> bool:
        if self.failed:
            return false
        if (
            length < 0 or
            self.fragment_count >= BE_DOM_HTML_SERIALIZE_MAX_FRAGMENTS or
            length > self.remaining_output_length()
        ):
            self.fail_closed()
            return false
        true

    me push_known_length(fragment: text, length: i64):
        if not self.can_push_length(length):
            return
        self.parts.push(fragment)
        self.fragment_count = self.fragment_count + 1
        self.output_length = self.output_length + length

fn _be_dom_html_escaped_length_within(value: text, limit: i64) -> i64:
    """Return escaped length, or -1 before allocation when over budget."""
    if limit < 0:
        return -1
    var length: i64 = 0
    for ch in value:
        var added = ch.len().to_i64()
        if ch == "&":
            added = 5
        elif ch == "<" or ch == ">":
            added = 4
        elif ch == "\"":
            added = 6
        elif ch == "'":
            added = 5
        if added > limit - length:
            return -1
        length = length + added
    length

fn _be_dom_push_escaped_html(
    state: _BeDomHtmlSerializationState, value: text
):
    if not state.can_push_length(0):
        return
    val length = _be_dom_html_escaped_length_within(
        value, state.remaining_output_length()
    )
    if length < 0:
        state.fail_closed()
        return
    # Preflight happens before html_escape_core's expanding replacements.
    state.push_known_length(html_escape_core(value), length)

fn _be_dom_push_html_attribute(
    state: _BeDomHtmlSerializationState, name: text, value: text
):
    val framing_length = name.len().to_i64() + 4
    if not state.can_push_length(framing_length):
        return
    val escaped_length = _be_dom_html_escaped_length_within(
        value, state.remaining_output_length() - framing_length
    )
    if escaped_length < 0:
        state.fail_closed()
        return
    val length = framing_length + escaped_length
    # Both escaped value and final attribute are bounded before construction.
    state.push_known_length(
        " " + name + "=\"" + html_escape_core(value) + "\"", length
    )

fn _be_dom_open_html_node(
    node: BeDomNode, render_only: bool,
    state: _BeDomHtmlSerializationState
) -> bool:
    """Emit a node's own opening markup.

    Returns true when the caller must still walk `node.children` and then emit
    the matching closing markup; false when the node is already complete (text
    node, void element) or the state has failed closed.
    """
    if node.tag_name == "#text":
        _be_dom_push_escaped_html(state, node.data)
        return false
    if node.tag_name == "#document":
        return true
    val open_tag_length = node.tag_name.len().to_i64() + 1
    if not state.can_push_length(open_tag_length):
        return false
    state.push_known_length("<" + node.tag_name, open_tag_length)
    for name in node.attributes.keys():
        if not name.starts_with("\u0000"):
            val authored_value = be_dom_get_attr(node, name)
            val render_value = if render_only and name == "src":
                node.attributes.get(
                    "\u0000simple-render-image-src"
                ) ?? authored_value
            elif render_only and name == "poster":
                node.attributes.get(
                    "\u0000simple-render-image-poster"
                ) ?? authored_value
            elif render_only and name == "style":
                node.attributes.get(
                    "\u0000simple-render-image-style"
                ) ?? authored_value
            else:
                authored_value
            _be_dom_push_html_attribute(state, name, render_value)
            if state.failed:
                return false
    state.push_known_length(">", 1)
    if _be_dom_void_tag(node.tag_name):
        return false
    return not state.failed

fn _be_dom_close_html_node(
    node: BeDomNode, state: _BeDomHtmlSerializationState
):
    """Emit a node's closing markup. A `#document` node has none."""
    if node.tag_name == "#document":
        return
    val close_tag_length = node.tag_name.len().to_i64() + 3
    if not state.can_push_length(close_tag_length):
        return
    state.push_known_length("</" + node.tag_name + ">", close_tag_length)

fn _be_dom_collect_html(
    node: BeDomNode, render_only: bool,
    state: _BeDomHtmlSerializationState, depth: i32
):
    """Serialize `node` and its subtree using an explicit work stack.

    This walk used to recurse once per DOM level, so a document nested deeper
    than the native stack allows aborted the entire process ("has overflowed
    its stack") before `BE_DOM_HTML_SERIALIZE_MAX_DEPTH` could fail closed —
    a renderer denial of service, since the HTML tree builder admits documents
    right up to that cap. Depth is now bounded by the heap, and the depth cap
    is what actually stops the walk.

    Per-node work stays O(1) amortized: the frame stacks are grown with `push`
    only while descending past the deepest level reached so far (at most
    `BE_DOM_HTML_SERIALIZE_MAX_DEPTH` pushes for an entire document) and are
    reused in place by index assignment afterwards, so a wide sibling list can
    never turn the walk into repeated whole-array copies.
    """
    if state.failed:
        return
    if depth > BE_DOM_HTML_SERIALIZE_MAX_DEPTH:
        state.fail_closed()
        return
    if not _be_dom_open_html_node(node, render_only, state):
        return
    # Frame `k` holds an already-opened node at DOM depth `depth + k`;
    # `frame_next` is the index of its next unvisited child.
    var frame_nodes: [BeDomNode] = [node]
    var frame_next: [i32] = [0]
    var frame_count: [i32] = [node.children.len()]
    var top: i32 = 0
    while top >= 0:
        val cursor = frame_nodes[top]
        val next_child = frame_next[top]
        if next_child >= frame_count[top]:
            _be_dom_close_html_node(cursor, state)
            if state.failed:
                return
            top = top - 1
        else:
            frame_next[top] = next_child + 1
            if depth + top + 1 > BE_DOM_HTML_SERIALIZE_MAX_DEPTH:
                state.fail_closed()
                return
            val child = cursor.children[next_child]
            val descend = _be_dom_open_html_node(child, render_only, state)
            if state.failed:
                return
            if descend:
                top = top + 1
                if top < frame_nodes.len():
                    frame_nodes[top] = child
                    frame_next[top] = 0
                    frame_count[top] = child.children.len()
                else:
                    frame_nodes.push(child)
                    frame_next.push(0)
                    frame_count.push(child.children.len())

fn _be_dom_serialize_html(node: BeDomNode, render_only: bool) -> text:
    val state = _BeDomHtmlSerializationState.create()
    _be_dom_collect_html(node, render_only, state, 1)
    if state.failed:
        return ""
    state.parts.join("")

class _BeDomHtmlSerializationMetrics:
    html: text
    fragment_count: i64
    output_length: i64
    work_units: i64
    failed: bool

fn _be_dom_measure_html_serialization(
    node: BeDomNode
) -> _BeDomHtmlSerializationMetrics:
    """Test diagnostic: actual fragment appends plus final-join output copies."""
    val state = _BeDomHtmlSerializationState.create()
    _be_dom_collect_html(node, false, state, 1)
    val html = if state.failed: "" else: state.parts.join("")
    _BeDomHtmlSerializationMetrics(
        html: html,
        fragment_count: state.fragment_count,
        output_length: state.output_length,
        work_units: state.fragment_count + state.output_length,
        failed: state.failed
    )

fn be_dom_serialize_html(node: BeDomNode) -> text:
    _be_dom_serialize_html(node, false)

fn be_dom_serialize_html_for_render(node: BeDomNode) -> text:
    _be_dom_serialize_html(node, true)

fn be_dom_serialize_children(node: BeDomNode) -> text:
    val state = _BeDomHtmlSerializationState.create()
    for child in node.children:
        _be_dom_collect_html(child, false, state, 1)
        if state.failed:
            return ""
    state.parts.join("")

fn be_dom_set_style(mut node: BeDomNode, style: StyleProps):
    """Replace the node's inline style."""
    node.style = style

fn be_dom_get_style(node: BeDomNode) -> StyleProps:
    """Return the node's current inline style."""
    node.style

fn be_dom_set_text_content(mut node: BeDomNode, text_content: text):
    """Set the text content of a node (clears children, sets data)."""
    node.children = []
    node.data = text_content

fn be_dom_get_text_content(node: BeDomNode) -> text:
    """Return the text content: data for text nodes, or concatenated child text."""
    if node.is_text():
        return node.data
    val child_count = node.children.len()
    if child_count == 0:
        return ""
    var parts: [text] = [""; child_count]
    var i = 0
    while i < child_count:
        parts[i] = be_dom_get_text_content(node.children[i])
        i = i + 1
    parts.join("")

fn be_dom_find_by_id(root: BeDomNode, node_id: i64) -> BeDomNode?:
    """DFS search for a node with the given node_id."""
    if root.node_id == node_id:
        return Some(root)
    var i = 0
    val child_count = root.children.len()
    while i < child_count:
        val found = be_dom_find_by_id(root.children[i], node_id)
        if found != nil:
            return found
        i = i + 1
    nil

fn be_dom_find_by_tag(root: BeDomNode, tag_name: text) -> [BeDomNode]:
    """Collect all descendant nodes with the given tag name."""
    val result_count = be_dom_count_by_tag(root, tag_name)
    if result_count == 0:
        return []
    var result: [BeDomNode] = [root; result_count]
    var out_idx = 0
    if root.tag_name == tag_name:
        result[out_idx] = root
        out_idx = out_idx + 1
    var i = 0
    val child_count = root.children.len()
    while i < child_count:
        val children_found = be_dom_find_by_tag(root.children[i], tag_name)
        var j = 0
        val found_count = children_found.len()
        while j < found_count:
            result[out_idx] = children_found[j]
            out_idx = out_idx + 1
            j = j + 1
        i = i + 1
    result

fn be_dom_count_by_tag(root: BeDomNode, tag_name: text) -> i32:
    var count = 0
    if root.tag_name == tag_name:
        count = count + 1
    var i = 0
    val child_count = root.children.len()
    while i < child_count:
        count = count + be_dom_count_by_tag(root.children[i], tag_name)
        i = i + 1
    count

fn be_dom_get_tag(node: BeDomNode) -> text:
    node.tag_name

fn be_dom_get_id(node: BeDomNode) -> text:
    node.attributes.get("id") ?? ""

fn be_dom_get_display(node: BeDomNode) -> text:
    if node.style.display == "":
        return "block"
    node.style.display

fn be_dom_get_classes(node: BeDomNode) -> [text]:
    val class_text = node.attributes.get("class") ?? ""
    if class_text == "":
        return []
    class_text.split(" ")

fn be_dom_has_attr(node: BeDomNode, name: text) -> bool:
    node.attributes.has(name)

fn be_dom_get_visibility(node: BeDomNode) -> text:
    "visible"

fn be_dom_get_bg_color(node: BeDomNode) -> text:
    node.style.background_color

fn be_dom_get_opacity(node: BeDomNode) -> f64:
    1.0

fn be_dom_get_border_radius(node: BeDomNode) -> f64:
    0.0

fn be_dom_get_padding_left(node: BeDomNode) -> f64:
    node.style.padding_left

fn be_dom_get_padding_top(node: BeDomNode) -> f64:
    node.style.padding_top

fn be_dom_get_padding_h(node: BeDomNode) -> f64:
    node.style.padding_left + node.style.padding_right

fn be_dom_get_padding_v(node: BeDomNode) -> f64:
    node.style.padding_top + node.style.padding_bottom

fn be_dom_get_box_shadows(node: BeDomNode) -> [text]:
    []

fn be_dom_get_backdrop_blur(node: BeDomNode) -> f64:
    0.0

fn be_dom_get_has_gradient(node: BeDomNode) -> bool:
    false

fn be_dom_get_gradient_c1(node: BeDomNode) -> text:
    node.style.background_color

fn be_dom_get_gradient_c2(node: BeDomNode) -> text:
    node.style.background_color

fn be_dom_get_border_width(node: BeDomNode) -> f64:
    node.style.border_width

fn be_dom_get_border_color(node: BeDomNode) -> text:
    node.style.border_color

fn be_dom_get_border_style(node: BeDomNode) -> text:
    node.style.border_style

fn be_dom_get_color(node: BeDomNode) -> text:
    node.style.color

fn be_dom_get_font_size(node: BeDomNode) -> f64:
    node.style.font_size

fn be_dom_get_text_decoration(node: BeDomNode) -> text:
    "none"

fn be_dom_query_selector(node: BeDomNode, selector: text) -> BeDomNode?:
    if selector.starts_with("#") and be_dom_get_id(node) == selector.substring(1, selector.len()):
        return Some(node)
    if node.tag_name == selector:
        return Some(node)
    for child in node.children:
        val found = be_dom_query_selector(child, selector)
        if found.?:
            return found
    nil

fn be_dom_dispatch_event_actions(node: BeDomNode, event_type: text) -> [text]:
    val normalized = normalize_dom_event_type(event_type)
    var actions: [text] = []
    val inline_action = be_dom_get_attr(node, "on" + normalized)
    if inline_action != "":
        actions.push(inline_action)
    var i = 0
    while i < node.event_listener_types.len():
        if node.event_listener_types[i] == normalized:
            actions.push(node.event_listener_actions[i])
        i = i + 1
    actions

fn be_dom_get_event_listener_count(node: BeDomNode, event_type: text) -> i32:
    val normalized = normalize_dom_event_type(event_type)
    var count = 0
    var i = 0
    while i < node.event_listener_types.len():
        if node.event_listener_types[i] == normalized:
            count = count + 1
        i = i + 1
    count

fn _be_dom_apply_listener_control(event: BeDomEvent, action: text) -> BeDomEvent:
    var next = event
    if action == "prevent-default":
        next.prevent_default()
    elif action == "stop-propagation":
        next.stop_propagation()
    elif action == "stop-immediate-propagation":
        next.stop_immediate_propagation()
    next

fn _be_dom_default_listener_executor(
    event: BeDomEvent, node: BeDomNode, action: text, phase: text
) -> BeDomEvent:
    _be_dom_apply_listener_control(event, action)


fn _be_dom_button_type(node: BeDomNode) -> text:
    val declared_type = be_dom_get_attr(node, "type").lower()
    if declared_type == "button" or declared_type == "reset":
        return declared_type
    "submit"

fn _be_dom_details_summary_owner_index(path: [BeDomNode]) -> i64:
    var summary_index = path.len() - 1
    while summary_index > 0:
        val summary = path[summary_index]
        val details = path[summary_index - 1]
        if summary.tag_name == "summary" and details.tag_name == "details":
            for child in details.children:
                if child.tag_name == "summary":
                    if child.node_id == summary.node_id:
                        return summary_index - 1
                    break
        summary_index = summary_index - 1
    -1

fn _be_dom_click_action(node: BeDomNode) -> text:
    if be_dom_has_attr(node, "disabled"):
        return ""
    if node.tag_name == "a":
        val href = be_dom_get_attr(node, "href")
        if href != "":
            val target = be_dom_get_attr(node, "target")
            val normalized_target = target.lower()
            if (
                target != "" and normalized_target != "_self" and
                normalized_target != "_parent" and normalized_target != "_top"
            ):
                return (
                    "navigate-popup:" + target.len().to_text() + ":" +
                    target + href
                )
            return "navigate:" + href
        return ""
    if node.tag_name == "input":
        val input_type = be_dom_get_attr(node, "type").lower()
        if input_type == "checkbox":
            return "input-checkbox-toggle"
        if input_type == "radio":
            return "input-radio-select"
        if input_type == "submit":
            return "button-activate"
        if input_type == "reset":
            return "form-reset"
        return "focus-element"
    if node.tag_name == "button":
        if _be_dom_button_type(node) == "reset":
            return "form-reset"
        return "button-activate"
    ""

fn _be_dom_click_owner_index(path: [BeDomNode]) -> i64:
    var index = path.len() - 1
    while index >= 0:
        val node = path[index]
        if (
            node.tag_name == "input" or node.tag_name == "button" or
            (node.tag_name == "a" and be_dom_get_attr(node, "href") != "")
        ):
            return index
        index = index - 1
    -1

fn _be_dom_default_action(path: [BeDomNode], event_type: text) -> text:
    if path.len() == 0:
        return ""
    val node = path[path.len() - 1]
    if be_dom_has_attr(node, "disabled"):
        return ""
    val normalized = normalize_dom_event_type(event_type)
    if normalized == "submit" and node.tag_name == "form":
        return "form-submit"
    if normalized == "focus":
        return "focus-element"
    if normalized == "mousedown" and _be_dom_is_focusable_node(node):
        return "focus-element"
    if normalized != "click":
        return ""
    val click_owner_index = _be_dom_click_owner_index(path)
    if click_owner_index >= 0:
        return _be_dom_click_action(path[click_owner_index])
    if _be_dom_details_summary_owner_index(path) >= 0:
        return "details-toggle"
    ""

fn _be_dom_is_natively_focusable(node: BeDomNode) -> bool:
    if node.tag_name == "a":
        return be_dom_get_attr(node, "href") != ""
    if node.tag_name == "input":
        return be_dom_get_attr(node, "type").lower() != "hidden"
    node.tag_name == "button" or node.tag_name == "select" or
        node.tag_name == "textarea"

fn _be_dom_is_focusable_node(node: BeDomNode) -> bool:
    if (
        be_dom_has_attr(node, "hidden") or
        be_dom_get_display(node) == "none" or
        be_dom_has_attr(node, "disabled")
    ):
        return false
    var focusable = (
        _be_dom_is_natively_focusable(node) or
        (be_dom_has_attr(node, "contenteditable") and
         be_dom_get_attr(node, "contenteditable").lower() != "false")
    )
    val raw_tab_index = be_dom_get_attr(node, "tabindex").trim()
    if raw_tab_index != "":
        if val Some(_) = raw_tab_index.to_i64():
            focusable = true
    focusable

fn be_dom_input_blocks_implicit_submission(node: BeDomNode) -> bool:
    if node.tag_name != "input":
        return false
    val input_type = be_dom_get_attr(node, "type").lower()
    (
        input_type != "button" and input_type != "checkbox" and
        input_type != "color" and input_type != "file" and
        input_type != "hidden" and input_type != "image" and
        input_type != "radio" and input_type != "range" and
        input_type != "reset" and input_type != "submit"
    )

fn be_dom_apply_default_action(node: BeDomNode, action: text) -> BeDomNode:
    var next = node
    if action == "input-checkbox-toggle":
        if be_dom_has_attr(next, "checked"):
            next.remove_attr("checked")
        else:
            next.set_attr("checked", "checked")
    elif action == "input-radio-select":
        next.set_attr("checked", "checked")
    elif action == "focus-element":
        next.set_attr("data-focused", "true")
    elif action == "button-activate":
        next.set_attr("data-activated", "true")
    elif action == "form-submit":
        next.set_attr("data-submitted", "true")
    elif action == "details-toggle":
        if be_dom_has_attr(next, "open"):
            next.remove_attr("open")
        else:
            next.set_attr("open", "open")
    elif action.starts_with("navigate:"):
        next.set_attr("data-navigation", action.substring(9, action.len()))
    next

fn _be_dom_clear_focus(node: BeDomNode) -> BeDomNode:
    var next = node
    next.remove_attr("data-focused")
    var children: [BeDomNode] = []
    for child in next.children:
        children.push(_be_dom_clear_focus(child))
    be_dom_set_children(next, children)

fn be_dom_keyboard_activation_event_for_target(node: BeDomNode, key: text) -> text:
    if be_dom_has_attr(node, "disabled"):
        return ""
    val normalized = key.trim().lower()
    val is_enter = normalized == "enter" or normalized == "return"
    val is_space = normalized == "space" or normalized == "spacebar" or key == " "
    if node.tag_name == "a":
        if is_enter:
            return "click"
        return ""
    if node.tag_name == "button":
        if is_enter or is_space:
            return "click"
        return ""
    if node.tag_name == "input":
        val input_type = be_dom_get_attr(node, "type").lower()
        if input_type == "checkbox" or input_type == "radio":
            if is_space:
                return "click"
        if input_type == "button" and (is_enter or is_space):
            return "click"
        if input_type == "reset" and (is_enter or is_space):
            return "click"
        if input_type == "submit" and (is_enter or is_space):
            return "click"
    ""

fn be_dom_get_is_text(node: BeDomNode) -> bool:
    node.tag_name == "#text"

fn be_dom_get_text(node: BeDomNode) -> text:
    node.data

fn be_dom_set_children(node: BeDomNode, children: [BeDomNode]) -> BeDomNode:
    BeDomNode(
        node_id: node.node_id,
        tag_name: node.tag_name,
        attributes: node.attributes,
        style: node.style,
        children: children,
        data: node.data,
        parent_id: node.parent_id,
        event_listener_types: node.event_listener_types,
        event_listener_actions: node.event_listener_actions,
        event_listener_capture: node.event_listener_capture)

fn be_dom_path_for_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute
) -> [BeDomNode]:
    if not index.contains_route(route):
        return []
    val ordinals = match index.path_for_route(route):
        Some(value): value
        nil: return []
    var current = root
    var path: [BeDomNode] = [current]
    for ordinal in ordinals:
        if ordinal < 0 or ordinal >= current.children.len():
            return []
        current = current.children[ordinal]
        path.push(current)
    if current.node_id != route.node_id:
        return []
    path

fn be_dom_node_for_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute
) -> BeDomNode?:
    val path = be_dom_path_for_route(root, index, route)
    if path.len() == 0:
        return nil
    Some(path[path.len() - 1])

fn be_dom_default_action_to_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    event_type: text
) -> text:
    _be_dom_default_action(be_dom_path_for_route(root, index, route), event_type)

class BeDomRouteEventDispatch:
    event: BeDomEvent
    target_route: DomNodeRoute
    related_target_route: DomNodeRoute?
    actions: [text]
    phases: [text]
    current_targets: [DomNodeRoute]
    default_action: text
    default_action_allowed: bool

fn _be_dom_empty_route_dispatch(
    event: BeDomEvent, target_route: DomNodeRoute
) -> BeDomRouteEventDispatch:
    BeDomRouteEventDispatch(
        event: event,
        target_route: target_route,
        related_target_route: nil,
        actions: [],
        phases: [],
        current_targets: [],
        default_action: "",
        default_action_allowed: false
    )

fn _be_dom_create_route_event(
    target: BeDomNode, event_type: text, bubbles: bool, cancelable: bool
) -> BeDomEvent:
    var event = BeDomEvent.create(
        normalize_dom_event_type(event_type), "", bubbles, cancelable
    )
    event.target_tag = target.tag_name
    event

fn _be_dom_append_route_action(
    dispatch: BeDomRouteEventDispatch, node: BeDomNode,
    current_route: DomNodeRoute, action: text, phase: text,
    executor: fn(BeDomEvent, BeDomNode, text, text) -> BeDomEvent
) -> BeDomRouteEventDispatch:
    var next = dispatch
    next.actions.push(action)
    next.phases.push(phase)
    next.current_targets.push(current_route)
    next.event.current_target_tag = node.tag_name
    next.event = executor(next.event, node, action, phase)
    next

fn _be_dom_dispatch_route_node(
    dispatch: BeDomRouteEventDispatch, node: BeDomNode,
    current_route: DomNodeRoute, phase: text, listener_mode: text,
    include_inline: bool,
    executor: fn(BeDomEvent, BeDomNode, text, text) -> BeDomEvent
) -> BeDomRouteEventDispatch:
    var next = dispatch
    val normalized = next.event.event_type
    if include_inline:
        val inline_action = be_dom_get_attr(node, "on" + normalized)
        if inline_action != "":
            next = _be_dom_append_route_action(
                next, node, current_route, inline_action, phase, executor
            )
            if next.event.immediate_propagation_stopped:
                return next
    var listener_index = 0
    while listener_index < node.event_listener_types.len():
        val type_matches = (
            node.event_listener_types[listener_index] == normalized
        )
        var phase_matches = listener_mode == "all"
        if listener_mode == "capture":
            phase_matches = node.event_listener_capture[listener_index]
        elif listener_mode == "bubble":
            phase_matches = not node.event_listener_capture[listener_index]
        if type_matches and phase_matches:
            next = _be_dom_append_route_action(
                next, node, current_route,
                node.event_listener_actions[listener_index], phase, executor
            )
            if next.event.immediate_propagation_stopped:
                return next
        listener_index = listener_index + 1
    next

fn _be_dom_finish_route_default_action(
    dispatch: BeDomRouteEventDispatch, path: [BeDomNode], event_type: text
) -> BeDomRouteEventDispatch:
    var next = dispatch
    next.default_action = _be_dom_default_action(path, event_type)
    next.default_action_allowed = (
        next.default_action != "" and not next.event.default_prevented
    )
    next

fn _be_dom_dispatch_route_path_with_event_executor(
    path: [BeDomNode], routes: [DomNodeRoute], target_route: DomNodeRoute,
    event: BeDomEvent, event_type: text, bubbles: bool,
    include_inline_target: bool,
    executor: fn(BeDomEvent, BeDomNode, text, text) -> BeDomEvent
) -> BeDomRouteEventDispatch:
    if path.len() == 0 or routes.len() != path.len():
        return _be_dom_empty_route_dispatch(event, target_route)
    var route_index = 0
    while route_index < routes.len():
        if path[route_index].node_id != routes[route_index].node_id:
            return _be_dom_empty_route_dispatch(event, target_route)
        route_index = route_index + 1
    val target = path[path.len() - 1]
    if (
        normalize_dom_event_type(event_type) == "click" and
        be_dom_has_attr(target, "disabled")
    ):
        return _be_dom_empty_route_dispatch(event, target_route)
    var dispatch = _be_dom_empty_route_dispatch(event, target_route)
    var path_index = 0
    while path_index + 1 < path.len():
        dispatch = _be_dom_dispatch_route_node(
            dispatch, path[path_index], routes[path_index],
            "capture", "capture", false, executor
        )
        if dispatch.event.propagation_stopped:
            return _be_dom_finish_route_default_action(
                dispatch, path, event_type
            )
        path_index = path_index + 1
    val target_index = path.len() - 1
    dispatch = _be_dom_dispatch_route_node(
        dispatch, target, routes[target_index],
        "target", "capture", false, executor
    )
    if not dispatch.event.immediate_propagation_stopped:
        dispatch = _be_dom_dispatch_route_node(
            dispatch, target, routes[target_index],
            "target", "bubble", include_inline_target, executor
        )
    if dispatch.event.propagation_stopped:
        return _be_dom_finish_route_default_action(
            dispatch, path, event_type
        )
    if bubbles:
        var ancestor_index = path.len() - 2
        while ancestor_index >= 0:
            dispatch = _be_dom_dispatch_route_node(
                dispatch, path[ancestor_index], routes[ancestor_index],
                "bubble", "bubble", false, executor
            )
            if dispatch.event.propagation_stopped:
                return _be_dom_finish_route_default_action(
                    dispatch, path, event_type
                )
            ancestor_index = ancestor_index - 1
    _be_dom_finish_route_default_action(dispatch, path, event_type)

fn be_dom_dispatch_event_to_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    event_type: text, bubbles: bool, cancelable: bool,
    include_inline_target: bool,
    executor: fn(BeDomEvent, BeDomNode, text, text) -> BeDomEvent =
        _be_dom_default_listener_executor
) -> BeDomRouteEventDispatch:
    val path = be_dom_path_for_route(root, index, route)
    val routes = index.event_path_for_route(route)
    if path.len() == 0:
        val event = BeDomEvent.create(
            normalize_dom_event_type(event_type), "", bubbles, cancelable
        )
        return _be_dom_empty_route_dispatch(event, route)
    _be_dom_dispatch_route_path_with_event_executor(
        path, routes, route,
        _be_dom_create_route_event(
            path[path.len() - 1], event_type, bubbles, cancelable
        ),
        event_type, bubbles, include_inline_target, executor
    )

fn be_dom_dispatch_keyboard_event_to_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    event_type: text, bubbles: bool, cancelable: bool, key: text,
    code: text, shift_key: bool, include_inline_target: bool,
    executor: fn(BeDomEvent, BeDomNode, text, text) -> BeDomEvent =
        _be_dom_default_listener_executor
) -> BeDomRouteEventDispatch:
    val path = be_dom_path_for_route(root, index, route)
    val routes = index.event_path_for_route(route)
    if path.len() == 0:
        var event = BeDomEvent.create(
            normalize_dom_event_type(event_type), "", bubbles, cancelable
        )
        event.key = key
        event.code = code
        event.shift_key = shift_key
        return _be_dom_empty_route_dispatch(event, route)
    var event = _be_dom_create_route_event(
        path[path.len() - 1], event_type, bubbles, cancelable
    )
    event.key = key
    event.code = code
    event.shift_key = shift_key
    _be_dom_dispatch_route_path_with_event_executor(
        path, routes, route, event,
        event_type, bubbles, include_inline_target, executor
    )

fn be_dom_dispatch_input_event_to_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    event_type: text, bubbles: bool, cancelable: bool, input_data: text?,
    input_type: text, is_composing: bool, include_inline_target: bool,
    executor: fn(BeDomEvent, BeDomNode, text, text) -> BeDomEvent =
        _be_dom_default_listener_executor
) -> BeDomRouteEventDispatch:
    val path = be_dom_path_for_route(root, index, route)
    val routes = index.event_path_for_route(route)
    if path.len() == 0:
        var event = BeDomEvent.create(
            normalize_dom_event_type(event_type), "", bubbles, cancelable
        )
        event.input_data = input_data
        event.input_type = input_type
        event.is_composing = is_composing
        return _be_dom_empty_route_dispatch(event, route)
    var event = _be_dom_create_route_event(
        path[path.len() - 1], event_type, bubbles, cancelable
    )
    event.input_data = input_data
    event.input_type = input_type
    event.is_composing = is_composing
    _be_dom_dispatch_route_path_with_event_executor(
        path, routes, route, event,
        event_type, bubbles, include_inline_target, executor
    )

fn _be_dom_focused_route(
    node: BeDomNode, index: DomIdentityIndex
) -> DomNodeRoute?:
    val route = DomNodeRoute(
        generation: index.generation, node_id: node.node_id
    )
    if index.contains_route(route) and be_dom_has_attr(node, "data-focused"):
        return Some(route)
    for child in node.children:
        if val Some(found) = _be_dom_focused_route(child, index):
            return Some(found)
    nil

fn be_dom_focused_route(
    root: BeDomNode, index: DomIdentityIndex
) -> DomNodeRoute?:
    _be_dom_focused_route(root, index)

fn _be_dom_is_form_control(node: BeDomNode) -> bool:
    (
        node.tag_name == "button" or node.tag_name == "input" or
        node.tag_name == "select" or node.tag_name == "textarea"
    )

fn _be_dom_fieldset_first_legend_id(fieldset: BeDomNode) -> i64:
    for child in fieldset.children:
        if child.tag_name == "legend":
            return child.node_id
    -1

fn be_dom_disabled_fieldset_state(fieldset: BeDomNode) -> (bool, i64):
    val disabled = (
        fieldset.tag_name == "fieldset" and
        be_dom_has_attr(fieldset, "disabled")
    )
    var first_legend_id: i64 = -1
    if disabled:
        first_legend_id = _be_dom_fieldset_first_legend_id(fieldset)
    (disabled, first_legend_id)

fn be_dom_disabled_fieldset_blocks_child(
    fieldset: (bool, i64), child: BeDomNode
) -> bool:
    fieldset.0 and child.node_id != fieldset.1

fn be_dom_control_is_disabled_in_context(
    node: BeDomNode, disabled_by_fieldset: bool
) -> bool:
    (
        _be_dom_is_form_control(node) and
        (disabled_by_fieldset or be_dom_has_attr(node, "disabled"))
    )

fn be_dom_control_is_effectively_disabled(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute
) -> bool:
    val path = be_dom_path_for_route(root, index, route)
    if path.len() == 0:
        return false
    var control_index = path.len() - 1
    while (
        control_index >= 0 and
        not _be_dom_is_form_control(path[control_index])
    ):
        control_index = control_index - 1
    if control_index < 0:
        return false
    var disabled_by_fieldset = false
    var path_index = 0
    while path_index < control_index:
        disabled_by_fieldset = (
            disabled_by_fieldset or
            be_dom_disabled_fieldset_blocks_child(
                be_dom_disabled_fieldset_state(path[path_index]),
                path[path_index + 1]
            )
        )
        path_index = path_index + 1
    be_dom_control_is_disabled_in_context(
        path[control_index], disabled_by_fieldset
    )

fn _be_dom_same_route(left: DomNodeRoute, right: DomNodeRoute) -> bool:
    left.generation.value == right.generation.value and
        left.node_id == right.node_id

class _BeDomFocusRouteOrder:
    positive_routes: [DomNodeRoute]
    positive_tab_indexes: [i64]
    regular_routes: [DomNodeRoute]
    dom_routes: [DomNodeRoute]

fn _be_dom_collect_focus_route_order(
    node: BeDomNode, index: DomIdentityIndex, order: _BeDomFocusRouteOrder,
    current_route: DomNodeRoute?, disabled_by_fieldset: bool
):
    if be_dom_has_attr(node, "hidden") or be_dom_get_display(node) == "none":
        return
    val route = DomNodeRoute(
        generation: index.generation, node_id: node.node_id
    )
    if (
        index.contains_route(route) and _be_dom_is_focusable_node(node) and
        not be_dom_control_is_disabled_in_context(
            node, disabled_by_fieldset
        )
    ):
        var tab_index: i64 = 0
        var sequential = true
        val raw_tab_index = be_dom_get_attr(node, "tabindex").trim()
        if raw_tab_index != "":
            if val Some(parsed_tab_index) = raw_tab_index.to_i64():
                tab_index = parsed_tab_index
                sequential = parsed_tab_index >= 0
        var in_dom_order = sequential
        if not sequential:
            if val Some(current) = current_route:
                in_dom_order = _be_dom_same_route(route, current)
        if in_dom_order:
            order.dom_routes.push(route)
        if sequential:
            if tab_index > 0:
                var insert_at = 0
                while (
                    insert_at < order.positive_tab_indexes.len() and
                    order.positive_tab_indexes[insert_at] <= tab_index
                ):
                    insert_at = insert_at + 1
                order.positive_routes.insert(insert_at, route)
                order.positive_tab_indexes.insert(insert_at, tab_index)
            else:
                order.regular_routes.push(route)
    val fieldset = be_dom_disabled_fieldset_state(node)
    for child in node.children:
        _be_dom_collect_focus_route_order(
            child, index, order, current_route,
            (disabled_by_fieldset or
             be_dom_disabled_fieldset_blocks_child(fieldset, child))
        )

fn be_dom_next_focus_route(
    root: BeDomNode, index: DomIdentityIndex,
    current_route: DomNodeRoute?, reverse: bool
) -> DomNodeRoute?:
    if val Some(current) = current_route:
        if not index.contains_route(current):
            return nil
    val order = _BeDomFocusRouteOrder(
        positive_routes: [], positive_tab_indexes: [], regular_routes: [],
        dom_routes: []
    )
    _be_dom_collect_focus_route_order(
        root, index, order, current_route, false
    )
    var routes = order.positive_routes
    for route in order.regular_routes:
        routes.push(route)
    if routes.len() == 0:
        return nil
    var current_index = -1
    if val Some(current) = current_route:
        var index_value = 0
        while index_value < routes.len():
            if _be_dom_same_route(routes[index_value], current):
                current_index = index_value
                break
            index_value = index_value + 1
        if current_index < 0:
            index_value = 0
            while index_value < order.dom_routes.len():
                if _be_dom_same_route(order.dom_routes[index_value], current):
                    routes = order.dom_routes
                    current_index = index_value
                    break
                index_value = index_value + 1
    if reverse:
        if current_index <= 0:
            return Some(routes[routes.len() - 1])
        return Some(routes[current_index - 1])
    if current_index < 0 or current_index + 1 >= routes.len():
        return Some(routes[0])
    Some(routes[current_index + 1])

fn be_dom_form_owner_route(
    index: DomIdentityIndex, route: DomNodeRoute
) -> DomNodeRoute?:
    index.form_owner_for_route(route)

fn be_dom_submit_form_owner_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute
) -> DomNodeRoute?:
    val target = match be_dom_node_for_route(root, index, route):
        Some(node): node
        nil: return nil
    if target.tag_name == "input":
        if be_dom_get_attr(target, "type").lower() != "submit":
            return nil
    elif target.tag_name == "button":
        if _be_dom_button_type(target) != "submit":
            return nil
    else:
        return nil
    index.form_owner_for_route(route)

fn be_dom_reset_form_owner_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute
) -> DomNodeRoute?:
    val target = match be_dom_node_for_route(root, index, route):
        Some(node): node
        nil: return nil
    if target.tag_name == "input":
        if be_dom_get_attr(target, "type").lower() != "reset":
            return nil
    elif target.tag_name == "button":
        if _be_dom_button_type(target) != "reset":
            return nil
    else:
        return nil
    index.form_owner_for_route(route)

class BeDomImplicitSubmitRouteResult:
    default_submitter_route: DomNodeRoute?
    allows_direct_submit: bool

class _BeDomImplicitSubmitRouteScan:
    default_submitter_route: DomNodeRoute?
    blocker_count: i32

fn _be_dom_scan_implicit_submit_routes(
    node: BeDomNode, index: DomIdentityIndex, form_route: DomNodeRoute,
    scan: _BeDomImplicitSubmitRouteScan
):
    val route = DomNodeRoute(
        generation: index.generation, node_id: node.node_id
    )
    if index.contains_route(route):
        if val Some(owner) = index.form_owner_for_route(route):
            if (
                owner.node_id == form_route.node_id and
                owner.generation.value == form_route.generation.value
            ):
                if (
                    scan.default_submitter_route == nil and
                    not be_dom_has_attr(node, "disabled") and
                    ((node.tag_name == "button" and
                      _be_dom_button_type(node) == "submit") or
                     (node.tag_name == "input" and
                      be_dom_get_attr(node, "type").lower() == "submit"))
                ):
                    scan.default_submitter_route = Some(route)
                if be_dom_input_blocks_implicit_submission(node):
                    scan.blocker_count = scan.blocker_count + 1
    for child in node.children:
        _be_dom_scan_implicit_submit_routes(child, index, form_route, scan)

fn be_dom_implicit_submit_route_result(
    root: BeDomNode, index: DomIdentityIndex, form_route: DomNodeRoute
) -> BeDomImplicitSubmitRouteResult:
    val form = match be_dom_node_for_route(root, index, form_route):
        Some(node): node
        nil: return BeDomImplicitSubmitRouteResult(
            default_submitter_route: nil, allows_direct_submit: false
        )
    if form.tag_name != "form":
        return BeDomImplicitSubmitRouteResult(
            default_submitter_route: nil, allows_direct_submit: false
        )
    val scan = _BeDomImplicitSubmitRouteScan(
        default_submitter_route: nil, blocker_count: 0
    )
    _be_dom_scan_implicit_submit_routes(root, index, form_route, scan)
    BeDomImplicitSubmitRouteResult(
        default_submitter_route: scan.default_submitter_route,
        allows_direct_submit: scan.blocker_count <= 1
    )

fn be_dom_checked_radio_route_for_target(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute
) -> DomNodeRoute?:
    val group = match index.radio_group_for_route(route):
        Some(value): value
        nil: return nil
    for member in index.radio_members(group):
        if val Some(node) = be_dom_node_for_route(root, index, member):
            if be_dom_has_attr(node, "checked"):
                return Some(member)
    nil

fn be_dom_radio_group_for_route(
    index: DomIdentityIndex, route: DomNodeRoute
) -> DomRadioGroupKey?:
    index.radio_group_for_route(route)

fn be_dom_radio_group_members(
    index: DomIdentityIndex, group: DomRadioGroupKey
) -> [DomNodeRoute]:
    index.radio_members(group)

fn _be_dom_mutate_at_ordinals(
    node: BeDomNode, ordinals: [i32], ordinal_index: i32,
    action: text, uncheck_radio: bool
) -> BeDomNode:
    if ordinal_index >= ordinals.len():
        if uncheck_radio:
            var unchecked = node
            unchecked.remove_attr("checked")
            return unchecked
        return be_dom_apply_default_action(node, action)
    val child_index = ordinals[ordinal_index]
    if child_index < 0 or child_index >= node.children.len():
        return node
    var children: [BeDomNode] = []
    for child in node.children:
        children.push(child)
    children[child_index] = _be_dom_mutate_at_ordinals(
        children[child_index], ordinals, ordinal_index + 1,
        action, uncheck_radio
    )
    be_dom_set_children(node, children)

fn _be_dom_mutate_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    action: text, uncheck_radio: bool
) -> BeDomNode:
    if be_dom_node_for_route(root, index, route) == nil:
        return root
    val ordinals = match index.path_for_route(route):
        Some(value): value
        nil: return root
    _be_dom_mutate_at_ordinals(root, ordinals, 0, action, uncheck_radio)

fn _be_dom_apply_default_action_to_route_with_focus_policy(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    action: text, allow_focus_default: bool
) -> BeDomNode:
    val path = be_dom_path_for_route(root, index, route)
    if path.len() == 0:
        return root
    if action == "focus-element" and not allow_focus_default:
        return root
    if action == "details-toggle":
        val owner_index = _be_dom_details_summary_owner_index(path)
        if owner_index < 0:
            return root
        val details_route = DomNodeRoute(
            generation: index.generation,
            node_id: path[owner_index].node_id
        )
        return _be_dom_mutate_route(
            root, index, details_route, action, false
        )
    val click_owner_index = _be_dom_click_owner_index(path)
    if (
        click_owner_index >= 0 and
        _be_dom_click_action(path[click_owner_index]) == action and
        click_owner_index != path.len() - 1
    ):
        val click_owner_route = DomNodeRoute(
            generation: index.generation,
            node_id: path[click_owner_index].node_id
        )
        return _be_dom_apply_default_action_to_route_with_focus_policy(
            root, index, click_owner_route, action, allow_focus_default
        )
    var next = root
    if allow_focus_default and (
        action == "focus-element" or action == "button-activate" or
        action == "input-checkbox-toggle" or
        action == "input-radio-select"
    ):
        next = _be_dom_clear_focus(next)
        if action != "focus-element":
            next = _be_dom_mutate_route(
                next, index, route, "focus-element", false
            )
    if action == "input-radio-select":
        if val Some(group) = index.radio_group_for_route(route):
            for member in index.radio_members(group):
                if not _be_dom_same_route(member, route):
                    next = _be_dom_mutate_route(
                        next, index, member, "", true
                    )
    _be_dom_mutate_route(next, index, route, action, false)

fn be_dom_apply_default_action_to_route(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    action: text
) -> BeDomNode:
    _be_dom_apply_default_action_to_route_with_focus_policy(
        root, index, route, action, true
    )

fn be_dom_apply_default_action_to_route_without_focus(
    root: BeDomNode, index: DomIdentityIndex, route: DomNodeRoute,
    action: text
) -> BeDomNode:
    _be_dom_apply_default_action_to_route_with_focus_policy(
        root, index, route, action, false
    )

