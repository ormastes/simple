"""
# Browsing Context — the enforcement seam

`security/{origin_policy,cookie_policy,permission_policy}.spl` model the
same-origin policy. This module is what *calls* them.

Before this module existed there was no place in the engine that held an
origin: `dom.spl` has documents with no origin, `resource_loader.spl` sniffs
Content-Type with no notion of who asked, and `script/*` had ungated clipboard,
storage and navigator surfaces. A model nothing calls is documentation.

A `BrowsingContext` owns the origin-bearing state — documents, the cookie
store, partitioned storage, and the permission set — and exposes exactly the
operations that need a security decision. Every one of those operations is
delegated:

| operation | decision made by |
|---|---|
| `read_document_root` / `read_document_text` | `origin_policy.can_access_document` |
| `read_response` / `can_read_response_from` | `origin_policy.can_read_response` |
| `storage_get` / `storage_set` | `origin_policy.storage_key` |
| `shares_storage_with` | `origin_policy.same_storage_partition` |
| `request_cookie_header` | `cookie_policy.cookie_applies` |
| `document_cookie` | `cookie_policy.script_visible` + `cookie_applies` |
| `set_cookie_from` | `cookie_policy.validate_set_cookie` |
| `call_gated` / `permission_state` | `permission_policy.PermissionSet.query` |

Deny-wins and fail-closed throughout: a refused read yields an empty
`#document` / empty text, never partial content.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, be_dom_get_text_content}
use std.gc_async_mut.gpu.browser_engine.net.cookie_store.{CookieStore}
use std.gc_async_mut.gpu.browser_engine.net.entity.cookie_types.{Cookie}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use std.gc_async_mut.gpu.browser_engine.script.storage_api.{
    BrowserStorage,
    storage_get_item,
    storage_set_item,
    storage_remove_item,
    storage_length
}
use std.gc_async_mut.gpu.browser_engine.security.cookie_policy.{CookieVerdict}
use std.gc_async_mut.gpu.browser_engine.security.origin_policy.{
    can_access_document,
    can_read_response,
    origin_from_url_text,
    same_storage_partition,
    storage_key
}
use std.gc_async_mut.gpu.browser_engine.security.permission_policy.{
    PermissionSet,
    PermissionState,
    state_is_granted
}

pub fn context_origin_from_url(raw: text, nonce: text) -> Origin:
    """Derive a document origin from a URL string.

    Routed through `origin_policy.origin_from_url_text` rather than the URL
    parser, so `data:`, `about:`, `javascript:` and every malformed input
    become a FRESH opaque origin instead of collapsing into one mutually
    same-origin bucket.
    """
    return origin_from_url_text(raw, nonce)

pub class BrowsingDocument:
    """A document, with the origin that owns it."""
    name: text
    origin: Origin
    root: BeDomNode

    static fn create(name: text, origin: Origin, root: BeDomNode) -> BrowsingDocument:
        return BrowsingDocument(name: name, origin: origin, root: root)

pub class ResponseRead:
    """Outcome of a response body read. `body` is empty when refused."""
    allowed: bool
    body: text
    reason: text

    static fn readable(body: text) -> ResponseRead:
        return ResponseRead(allowed: true, body: body, reason: "ok")

    static fn refuse(reason: text) -> ResponseRead:
        return ResponseRead(allowed: false, body: "", reason: reason)

pub class PartitionedStorage:
    """Web Storage partitioned by origin.

    `script/storage_api.BrowserStorage` is a bare key/value bag with no notion
    of who is reading it; used directly it is one global storage area shared by
    every origin — which is what the engine had. The partition key here comes
    from `origin_policy.storage_key`, which returns the empty text for an
    opaque or malformed origin. An empty key means NO storage: such an origin
    can neither read nor write, and its writes are dropped rather than routed
    into a shared bucket.
    """
    _keys: [text]
    _stores: [BrowserStorage]

    static fn create() -> PartitionedStorage:
        return PartitionedStorage(_keys: [], _stores: [])

    me fn partition_key(origin: Origin) -> text:
        """The partition this origin writes to. Empty text = no storage."""
        return storage_key(origin)

    me fn _index_of(key: text) -> i64:
        var i = 0
        while i < self._keys.len():
            if self._keys[i] == key:
                return i
            i = i + 1
        return -1

    me fn _ensure(key: text) -> i64:
        val found = self._index_of(key)
        if found >= 0:
            return found
        self._keys.push(key)
        self._stores.push(BrowserStorage.new())
        return self._keys.len() - 1

    me fn set_item(origin: Origin, key: text, value: text) -> bool:
        """Write into this origin's partition. False when the origin has none."""
        val partition = self.partition_key(origin)
        if partition == "":
            return false
        val idx = self._ensure(partition)
        # Extract, mutate, WRITE BACK: mutating `self._stores[idx]` through the
        # extracted handle alone is dropped on the interpreter.
        var store = self._stores[idx]
        store = storage_set_item(store, key, value)
        self._stores[idx] = store
        return true

    me fn get_item(origin: Origin, key: text) -> text:
        """Read from this origin's partition. Empty text when absent or refused."""
        val partition = self.partition_key(origin)
        if partition == "":
            return ""
        val idx = self._index_of(partition)
        if idx < 0:
            return ""
        val found = storage_get_item(self._stores[idx], key)
        if found.?:
            return found!
        return ""

    me fn remove_item(origin: Origin, key: text) -> bool:
        val partition = self.partition_key(origin)
        if partition == "":
            return false
        val idx = self._index_of(partition)
        if idx < 0:
            return false
        var store = self._stores[idx]
        store = storage_remove_item(store, key)
        self._stores[idx] = store
        return true

    me fn length_for(origin: Origin) -> i64:
        val partition = self.partition_key(origin)
        if partition == "":
            return 0
        val idx = self._index_of(partition)
        if idx < 0:
            return 0
        return storage_length(self._stores[idx])

    me fn partition_count() -> i64:
        return self._keys.len()

pub class BrowsingContext:
    """The origin-bearing state of one browsing context, with enforcement."""
    _doc_names: [text]
    _docs: [BrowsingDocument]
    _cookies: CookieStore
    _storage: PartitionedStorage
    _permissions: PermissionSet

    static fn create() -> BrowsingContext:
        return BrowsingContext(
            _doc_names: [],
            _docs: [],
            _cookies: CookieStore.new(),
            _storage: PartitionedStorage.create(),
            _permissions: PermissionSet.create()
        )

    # -- documents ---------------------------------------------------------

    me fn install_document(doc: BrowsingDocument):
        """Register a document. Installation is not an access decision."""
        var i = 0
        while i < self._doc_names.len():
            if self._doc_names[i] == doc.name:
                self._docs[i] = doc
                return
            i = i + 1
        self._doc_names.push(doc.name)
        self._docs.push(doc)

    me fn _doc_index(name: text) -> i64:
        var i = 0
        while i < self._doc_names.len():
            if self._doc_names[i] == name:
                return i
            i = i + 1
        return -1

    me fn document_count() -> i64:
        return self._doc_names.len()

    me fn can_access(subject: Origin, target_name: text) -> bool:
        """May `subject` reach into the named document? `can_access_document` decides."""
        val idx = self._doc_index(target_name)
        if idx < 0:
            return false
        return can_access_document(subject, self._docs[idx].origin)

    me fn read_document_root(subject: Origin, target_name: text) -> BeDomNode:
        """The target's DOM root, or an empty `#document` when refused.

        This is the call site a cross-document read has to pass through; there
        is no other way to reach another document's tree from a context.
        """
        if not self.can_access(subject, target_name):
            return BeDomNode.document()
        val idx = self._doc_index(target_name)
        return self._docs[idx].root

    me fn read_document_text(subject: Origin, target_name: text) -> text:
        """Text content of the target document, or empty text when refused."""
        if not self.can_access(subject, target_name):
            return ""
        val idx = self._doc_index(target_name)
        return be_dom_get_text_content(self._docs[idx].root)

    # -- responses ---------------------------------------------------------

    me fn can_read_response_from(
        requester: Origin,
        response_origin: Origin,
        allow_origin_header: text,
        with_credentials: bool
    ) -> bool:
        return can_read_response(requester, response_origin, allow_origin_header, with_credentials)

    me fn read_response(
        requester: Origin,
        response_origin: Origin,
        allow_origin_header: text,
        with_credentials: bool,
        body: text
    ) -> ResponseRead:
        """Hand `body` to `requester`, or refuse. `can_read_response` decides.

        A refused read yields an EMPTY body, not a truncated one — an opaque
        response must leak neither content nor length.
        """
        if not can_read_response(requester, response_origin, allow_origin_header, with_credentials):
            return ResponseRead.refuse("cross-origin-read-refused")
        return ResponseRead.readable(body)

    # -- storage -----------------------------------------------------------

    me fn storage_partition_key(origin: Origin) -> text:
        return self._storage.partition_key(origin)

    me fn storage_set(origin: Origin, key: text, value: text) -> bool:
        var store = self._storage
        val ok = store.set_item(origin, key, value)
        self._storage = store
        return ok

    me fn storage_get(origin: Origin, key: text) -> text:
        return self._storage.get_item(origin, key)

    me fn storage_length(origin: Origin) -> i64:
        return self._storage.length_for(origin)

    me fn shares_storage_with(left: Origin, right: Origin) -> bool:
        return same_storage_partition(left, right)

    # -- cookies -----------------------------------------------------------

    me fn set_cookie_from(cookie: Cookie, origin: Origin, now: i64) -> CookieVerdict:
        var jar = self._cookies
        val verdict = jar.store_from_origin(cookie, origin, now)
        self._cookies = jar
        return verdict

    me fn request_cookie_header(
        origin: Origin,
        request_path: text,
        site_for_cookies: Origin?,
        method: text,
        is_top_level_navigation: bool,
        now: i64
    ) -> text:
        """Cookie header for a network request from this context."""
        return self._cookies.get_header_for_origin(
            origin, request_path, site_for_cookies, method, is_top_level_navigation, now
        )

    me fn document_cookie(origin: Origin, request_path: text, now: i64) -> text:
        """`document.cookie` as script sees it — `HttpOnly` filtered out here."""
        return self._cookies.script_cookie_header(origin, request_path, now)

    # -- permissions -------------------------------------------------------

    me fn grant(origin: Origin, feature: text) -> bool:
        var perms = self._permissions
        val ok = perms.grant(origin, feature)
        self._permissions = perms
        return ok

    me fn revoke(origin: Origin, feature: text) -> bool:
        var perms = self._permissions
        val ok = perms.revoke(origin, feature)
        self._permissions = perms
        return ok

    me fn permission_state(origin: Origin, feature: text) -> PermissionState:
        return self._permissions.query(origin, feature)

    me fn permission_granted(origin: Origin, feature: text) -> bool:
        return state_is_granted(self._permissions.query(origin, feature))

    me fn call_gated(origin: Origin, feature: text) -> bool:
        """The gate every permission-backed API must pass. Default-deny."""
        return state_is_granted(self._permissions.query(origin, feature))

    me fn granted_count() -> i64:
        return self._permissions.granted_count()
