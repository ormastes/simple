"""
# Cookie Store

RFC 6265 cookie storage: Set-Cookie parsing, domain/path matching,
per-domain cap enforcement, and Cookie header generation.
No network calls — pure logic.

## Ownership

The store keeps jars; it does not decide anything. Admission
(`store_from_origin`) is `cookie_policy.validate_set_cookie`, attachment
(`get_header_for_origin`) is `cookie_policy.cookie_applies`, and the
`document.cookie` surface (`script_cookie_header`) additionally passes
`cookie_policy.script_visible` so an `HttpOnly` cookie never reaches script.

The old `get_header(host, path)` is gone. It matched on domain and path only
and therefore attached `Secure` cookies over `http:`, sent `SameSite=Strict`
cookies cross-site, sent expired cookies, and had no script/network
distinction at all.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.net.entity.cookie_types.{Cookie, SameSite}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use std.gc_async_mut.gpu.browser_engine.security.cookie_policy.{
    CookieVerdict,
    cookie_applies,
    canonical_domain,
    script_visible,
    validate_set_cookie,
    effective_domain,
    is_expired,
    path_matches as policy_path_matches
}
use std.gc_async_mut.gpu.browser_engine.security.origin_policy.{is_potentially_trustworthy}
use common.web.host_policy.{is_ip_host_literal}

val MAX_TOTAL_COOKIES: i64 = 3000

fn _jar_allows_cookie(jar_key: text, cookie: Cookie, origin: Origin) -> bool:
    if canonical_domain(cookie.domain) == "":
        return jar_key == origin.host.trim().to_lower()
    return true

pub fn parse_set_cookie(header: text) -> Cookie:
    """Parse a Set-Cookie header value into a Cookie struct.

    Handles: name=value; Domain=...; Path=...; Secure; HttpOnly; SameSite=...
    Defaults: path="/", same_site=Lax, secure=false, http_only=false.
    """
    var name = ""
    var value = ""
    var domain = ""
    var path = "/"
    var secure = false
    var http_only = false
    var same_site = SameSite.Lax

    val parts = header.split(";")
    var i = 0
    while i < parts.len():
        val part = parts[i].trim()
        i = i + 1
        if i == 1:
            # First part: name=value
            val eq = part.index_of("=")
            if eq >= 0:
                name = part.slice(0, eq).trim()
                value = part.slice(eq + 1, part.len()).trim()
            else:
                name = part
        else:
            val lowered = part.lower()
            if lowered.starts_with("domain="):
                val eq = part.index_of("=")
                domain = part.slice(eq + 1, part.len()).trim()
            elif lowered.starts_with("path="):
                val eq = part.index_of("=")
                path = part.slice(eq + 1, part.len()).trim()
            elif lowered == "secure":
                secure = true
            elif lowered == "httponly":
                http_only = true
            elif lowered.starts_with("samesite="):
                val eq = part.index_of("=")
                val ss_val = part.slice(eq + 1, part.len()).trim().lower()
                if ss_val == "strict":
                    same_site = SameSite.Strict
                elif ss_val == "none":
                    same_site = SameSite.None
                else:
                    same_site = SameSite.Lax

    return Cookie {
        name: name,
        value: value,
        domain: domain,
        path: path,
        secure: secure,
        http_only: http_only,
        same_site: same_site,
        expires_at: 0
    }

pub fn apply_default_path(cookie: Cookie, header: text, request_path: text) -> Cookie:
    """Apply RFC 6265 default-path when Path is absent or not absolute."""
    var path_attribute = ""
    for raw_part in header.split(";"):
        val part = raw_part.trim()
        if part.to_lower().starts_with("path="):
            val eq = part.index_of("=")
            if eq >= 0:
                path_attribute = part.slice(eq + 1, part.len()).trim()
    if path_attribute.starts_with("/"):
        return cookie

    var path = "/"
    if request_path.starts_with("/"):
        val last_slash = request_path.last_index_of("/")
        if last_slash > 0:
            path = request_path.slice(0, last_slash)
    return Cookie {
        name: cookie.name, value: cookie.value, domain: cookie.domain, path: path,
        secure: cookie.secure, http_only: cookie.http_only,
        same_site: cookie.same_site, expires_at: cookie.expires_at
    }

pub class CookieJar:
    """A collection of cookies for a single domain."""
    cookies: [Cookie]

    static fn new() -> CookieJar:
        return CookieJar { cookies: [] }

    me fn add(c: Cookie):
        """Add or replace a cookie with the same name."""
        var replaced = false
        var i = 0
        while i < self.cookies.len():
            val existing = self.cookies[i]
            i = i + 1
            if existing.name == c.name and existing.path == c.path:
                self.cookies[i - 1] = c
                replaced = true
        if not replaced:
            self.cookies.push(c)

    me fn count() -> i64:
        return self.cookies.len()

pub class CookieStore:
    """RFC 6265 cookie store: stores cookies per domain, enforces caps."""
    _jars: [CookieJar]
    _domains: [text]
    _max_per_domain: i64

    static fn new() -> CookieStore:
        """Create an empty CookieStore with default per-domain cap of 50."""
        return CookieStore {
            _jars: [],
            _domains: [],
            _max_per_domain: 50
        }

    static fn domain_matches(cookie_domain: text, request_host: text) -> bool:
        """RFC 6265 domain matching.

        Exact match always succeeds.
        Dot-prefixed cookie domain matches any subdomain of the suffix.
        """
        if cookie_domain == request_host:
            return true
        if cookie_domain.starts_with("."):
            val suffix = cookie_domain.slice(1, cookie_domain.len())
            if request_host == suffix:
                return true
            if request_host.ends_with("." + suffix):
                return true
        return false

    static fn path_matches(cookie_path: text, request_path: text) -> bool:
        """RFC 6265 path matching.

        The cookie path must be a prefix of the request path.
        If cookie_path == request_path: match.
        If cookie_path ends with /: prefix match.
        Otherwise: request_path must start with cookie_path followed by /.
        """
        if cookie_path == request_path:
            return true
        if cookie_path == "/":
            return true
        if request_path.starts_with(cookie_path + "/"):
            return true
        return false

    me fn _ensure_jar(domain: text) -> i64:
        """Return index of jar for domain, creating it if needed."""
        var i = 0
        while i < self._domains.len():
            if self._domains[i] == domain:
                return i
            i = i + 1
        self._domains.push(domain)
        self._jars.push(CookieJar.new())
        return self._domains.len() - 1

    me fn _prune(now: i64):
        var kept_domains: [text] = []
        var kept_jars: [CookieJar] = []
        var i = 0
        while i < self._domains.len():
            var live: [Cookie] = []
            for cookie in self._jars[i].cookies:
                if not is_expired(cookie, now):
                    live.push(cookie)
            if live.len() > 0:
                kept_domains.push(self._domains[i])
                kept_jars.push(CookieJar(cookies: live))
            i = i + 1
        self._domains = kept_domains
        self._jars = kept_jars

    fn _total_count() -> i64:
        var total = 0
        for jar in self._jars:
            total = total + jar.cookies.len()
        return total

    me fn _evict_one():
        var kept_domains: [text] = []
        var kept_jars: [CookieJar] = []
        var evicted = false
        var i = 0
        while i < self._domains.len():
            var cookies = self._jars[i].cookies
            if not evicted and cookies.len() > 0:
                var tail: [Cookie] = []
                var j = 1
                while j < cookies.len():
                    tail.push(cookies[j])
                    j = j + 1
                cookies = tail
                evicted = true
            if cookies.len() > 0:
                kept_domains.push(self._domains[i])
                kept_jars.push(CookieJar(cookies: cookies))
            i = i + 1
        self._domains = kept_domains
        self._jars = kept_jars

    me fn _store_under(jar_key: text, c: Cookie):
        """Place `c` in the jar for `jar_key`, enforcing the per-domain cap.

        Mutates a local jar and WRITES IT BACK into `self._jars`. Mutating
        `self._jars[idx]` through the extracted handle alone is silently
        dropped on the interpreter (2+ field hops), which is why the store
        previously read back empty.
        """
        var idx = self._ensure_jar(jar_key)
        var jar = self._jars[idx]

        var is_replace = false
        var j = 0
        while j < jar.cookies.len():
            val existing = jar.cookies[j]
            j = j + 1
            if existing.name == c.name and existing.path == c.path:
                is_replace = true

        if jar.count() >= self._max_per_domain and not is_replace:
            val old_cookies = jar.cookies
            var new_cookies: [Cookie] = []
            var k = 1
            while k < old_cookies.len():
                new_cookies.push(old_cookies[k])
                k = k + 1
            jar.cookies = new_cookies

        self._jars[idx] = jar
        if not is_replace and self._total_count() >= MAX_TOTAL_COOKIES:
            self._evict_one()
            idx = self._ensure_jar(jar_key)
            jar = self._jars[idx]

        var kept: [Cookie] = []
        var replaced = false
        var m = 0
        while m < jar.cookies.len():
            val existing = jar.cookies[m]
            m = m + 1
            if existing.name == c.name and existing.path == c.path:
                kept.push(c)
                replaced = true
            else:
                kept.push(existing)
        if not replaced:
            kept.push(c)
        jar.cookies = kept
        self._jars[idx] = jar

    me fn _remove_under(jar_key: text, c: Cookie):
        var index = 0
        while index < self._domains.len():
            if self._domains[index] == jar_key:
                var jar = self._jars[index]
                var kept: [Cookie] = []
                for existing in jar.cookies:
                    if existing.name != c.name or existing.path != c.path:
                        kept.push(existing)
                jar.cookies = kept
                self._jars[index] = jar
                self._prune(0)
                return
            index = index + 1

    static fn _domains_overlap(left: text, right: text) -> bool:
        if left == right:
            return true
        if is_ip_host_literal(left) or is_ip_host_literal(right):
            return false
        return left.ends_with("." + right) or right.ends_with("." + left)

    me fn _secure_cookie_collision(jar_key: text, c: Cookie) -> bool:
        var index = 0
        while index < self._domains.len():
            if CookieStore._domains_overlap(self._domains[index], jar_key):
                for existing in self._jars[index].cookies:
                    if (existing.secure and existing.name == c.name and
                        policy_path_matches(existing.path, c.path)):
                        return true
            index = index + 1
        return false

    me fn store(c: Cookie):
        """Store a cookie under its own Domain attribute as the jar key.

        Performs NO admission check — `store_from_origin` is the enforcing
        entrypoint. This raw form exists for jar-mechanics tests only.
        """
        self._store_under(c.domain, c)

    me fn store_from_origin(c: Cookie, origin: Origin, now: i64) -> CookieVerdict:
        """Admit a `Set-Cookie` from `origin`. The enforcing store entrypoint.

        The verdict is `cookie_policy.validate_set_cookie`; a rejected cookie
        is never written. The jar key is `cookie_policy.effective_domain`, so a
        host-only cookie is keyed by the setting origin's host rather than the
        empty string.
        """
        self._prune(now)
        var admitted = c
        if is_expired(c, now):
            admitted = Cookie(
                name: c.name, value: c.value, domain: c.domain, path: c.path,
                secure: c.secure, http_only: c.http_only,
                same_site: c.same_site, expires_at: 0
            )
        val verdict = validate_set_cookie(admitted, origin, now)
        if not verdict.accepted:
            return verdict
        val jar_key = effective_domain(admitted, origin)
        if (not is_potentially_trustworthy(origin) and
            self._secure_cookie_collision(jar_key, c)):
            return CookieVerdict.reject("insecure-origin-cannot-replace-secure-cookie")
        if is_expired(c, now):
            self._remove_under(jar_key, c)
            return verdict
        self._store_under(jar_key, c)
        return verdict

    me fn store_from_script(c: Cookie, origin: Origin, now: i64) -> CookieVerdict:
        """Admit `document.cookie` without exposing or replacing HttpOnly rows."""
        self._prune(now)
        if c.http_only:
            return CookieVerdict.reject("script-cannot-set-httponly")
        val jar_key = effective_domain(c, origin)
        var i = 0
        while i < self._domains.len():
            if self._domains[i] == jar_key:
                for existing in self._jars[i].cookies:
                    if (existing.http_only and existing.name == c.name and
                        existing.path == c.path):
                        return CookieVerdict.reject("script-cannot-overwrite-httponly")
            i = i + 1
        return self.store_from_origin(c, origin, now)

    fn count() -> i64:
        return self._total_count()

    me fn get_header_for_origin(
        origin: Origin,
        request_path: text,
        site_for_cookies: Origin?,
        method: text,
        is_top_level_navigation: bool,
        now: i64
    ) -> text:
        """Cookie header for a network request. Every cookie passes `cookie_applies`.

        `Secure` over a non-secure origin, expired cookies, and `SameSite`
        violations are all refused by the policy, not by this module.
        """
        var result = ""
        var i = 0
        while i < self._domains.len():
            val jar = self._jars[i]
            i = i + 1
            var j = 0
            while j < jar.cookies.len():
                val c = jar.cookies[j]
                j = j + 1
                if (_jar_allows_cookie(self._domains[i - 1], c, origin) and
                    cookie_applies(c, origin, request_path, site_for_cookies, method, is_top_level_navigation, now)):
                    if result != "":
                        result = result + "; "
                    result = result + c.name + "=" + c.value
        return result

    me fn script_cookie_header(origin: Origin, request_path: text, now: i64) -> text:
        """The `document.cookie` value visible to script in `origin`.

        Same attachment rule as a same-site request, plus
        `cookie_policy.script_visible`: an `HttpOnly` cookie is filtered out
        HERE, at the point script reads it.
        """
        var result = ""
        var i = 0
        while i < self._domains.len():
            val jar = self._jars[i]
            i = i + 1
            var j = 0
            while j < jar.cookies.len():
                val c = jar.cookies[j]
                j = j + 1
                if (script_visible(c) and
                    _jar_allows_cookie(self._domains[i - 1], c, origin)):
                    if cookie_applies(c, origin, request_path, Some(origin), "GET", true, now):
                        if result != "":
                            result = result + "; "
                        result = result + c.name + "=" + c.value
        return result

    me fn fill_for_domain(domain: text, n: i64) -> i64:
        """Fill the store with n cookies for domain. Returns actual count stored."""
        var i = 0
        while i < n:
            val c = Cookie {
                name: "cookie" + i.to_text(),
                value: "val" + i.to_text(),
                domain: domain,
                path: "/",
                secure: false,
                http_only: false,
                same_site: SameSite.Lax,
        expires_at: 0
            }
            self.store(c)
            i = i + 1
        return self.count_for_domain(domain)

    me fn count_for_domain(domain: text) -> i64:
        """Return the number of cookies stored for the given domain key."""
        var i = 0
        while i < self._domains.len():
            if self._domains[i] == domain:
                return self._jars[i].count()
            i = i + 1
        return 0
