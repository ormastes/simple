"""
# URL Types

Entity types for URL and Origin — pure value types with no externs.
"""

use std.gc_async_mut.http_client.types.{parse_url}

pub class Url:
    """A parsed URL with scheme, host, port, path, query, and fragment."""
    scheme: text
    host: text
    port: i64
    path: text
    query: text
    fragment: text

    static fn create(scheme: text, host: text, port: i64, path: text) -> Url:
        Url(scheme: scheme, host: host, port: port, path: path, query: "", fragment: "")

    static fn parse(raw: text) -> Url:
        val parsed = parse_url(raw)
        Url(
            scheme: parsed.0.to_lower(),
            host: parsed.1.to_lower(),
            port: parsed.2,
            path: parsed.3,
            query: parsed.4,
            fragment: parsed.5
        )

    fn authority() -> text:
        var out = self.host
        val default_port = (self.scheme == "http" and self.port == 80) or (self.scheme == "https" and self.port == 443)
        if self.port > 0 and not default_port:
            out = out + ":{self.port}"
        out

    fn to_text() -> text:
        var out = "{self.scheme}://{self.authority()}"
        out = out + self.path
        if self.query != "":
            out = out + "?{self.query}"
        if self.fragment != "":
            out = out + "#{self.fragment}"
        out

pub class Origin:
    """The security origin of a URL: scheme + host + port."""
    scheme: text
    host: text
    port: i64

    static fn from_url(url: Url) -> Origin:
        Origin(scheme: url.scheme.to_lower(), host: url.host.to_lower(), port: url.port)

    fn to_text() -> text:
        var out = "{self.scheme}://{self.host}"
        val default_port = (self.scheme == "http" and self.port == 80) or (self.scheme == "https" and self.port == 443)
        if self.port > 0 and not default_port:
            out = out + ":{self.port}"
        out
