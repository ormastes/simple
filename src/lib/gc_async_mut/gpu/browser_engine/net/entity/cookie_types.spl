"""
# Cookie Types

Entity types for HTTP cookies — pure value types with no externs.
"""

pub enum SameSite:
    """RFC 6265 SameSite attribute values."""
    Strict
    Lax
    None

pub class Cookie:
    """An HTTP cookie with all RFC 6265 attributes.

    `expires_at` is an absolute expiry in unix seconds; `0` means a session
    cookie with no clock expiry. Always set it explicitly at construction
    sites — an omitted field is nil-filled rather than defaulted on the
    native/JIT path, which would silently make the cookie look already-expired.
    """
    name: text
    value: text
    domain: text
    path: text
    secure: bool
    http_only: bool
    same_site: SameSite
    partitioned: bool = false
    partition_key: text = ""
    expires_at: i64 = 0
