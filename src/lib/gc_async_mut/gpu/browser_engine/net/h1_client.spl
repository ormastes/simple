#![allow(REQC001)]
#![allow(REQC004)]
#![allow(unnamed_duplicate_typed_args)]
# HTTP/1.1 client for the Simple Browser Platform.
# Implements connection pooling, request serialization, and response parsing
# including chunked transfer encoding and keep-alive management.
# Plain HTTP socket I/O delegates to hosted TCP primitives.

use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{FetchRequest, FetchResponse, HttpMethod}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.Url
use std.gc_async_mut.gpu.browser_engine.net.entity.tls_types.{TlsConfig, TlsVersion}
use std.gc_async_mut.gpu.browser_engine.net.tls.{TlsManager, TlsConnection}
use std.gc_async_mut.gpu.browser_engine.net.dns.DnsResolver
use std.gc_async_mut.gpu.browser_engine.shared.error.{BrowserResult, BrowserError, network_error, parse_error}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{Logger, BrowserLogLevel}
use std.string_core.{char_from_code}
use std.js.types.pair.{Pair}

extern fn rt_io_tcp_connect_timeout(addr: text, ms: i64) -> i64
extern fn rt_io_tcp_read(fd: i64, size: i64) -> [u8]
extern fn rt_io_tcp_write_text(fd: i64, data: text) -> i64
extern fn rt_io_tcp_flush(fd: i64) -> bool
extern fn rt_io_tcp_close(fd: i64) -> bool
extern fn rt_io_tcp_set_nodelay(fd: i64, enabled: bool) -> bool
extern fn rt_io_tcp_set_read_timeout(fd: i64, ms: i64?) -> bool
extern fn rt_io_tcp_set_write_timeout(fd: i64, ms: i64?) -> bool
use std.common.string_core.{text_to_bytes}

val H1_TOTAL_TIMEOUT_MS: i64 = 5000

fn h1_deadline_remaining_ms(now_ms: i64, deadline_ms: i64) -> i64:
    val remaining = deadline_ms - now_ms
    if remaining > 0: remaining else: 0

fn h1_connect_address(address: text, port: i64) -> text:
    if address.contains(":"): "[{address}]:{port}" else: "{address}:{port}"

pub fn h1_tls_ipv6_literal_identity(host: text) -> text?:
    """Return the unbracketed TLS identity for a canonical IPv6 URL host.

    URL authority retains brackets, while the numeric TLS peer identity and
    resolved connect address must not. Non-literal hosts keep the DNS path.
    """
    if host.len() <= 2 or not host.starts_with("[") or not host.ends_with("]"):
        return nil
    val parsed = Url.parse("https://" + host + "/")
    if not parsed.?:
        return nil
    if parsed.unwrap().host != host:
        return nil
    val identity = host.slice(1, host.len() - 1)
    Some(identity)

# --- MockResponseRegistry ---
# Provides canned HTTP responses for testing without real socket I/O.
# Register URL patterns and their responses; the H1 client checks this
# before attempting network access.

class MockResponseEntry:
    url_pattern: text
    status: i64
    status_text: text
    headers: [Pair<text, text>]
    body: text

    static fn create(url_pattern: text, status: i64, body: text) -> MockResponseEntry:
        MockResponseEntry(
            url_pattern: url_pattern,
            status: status,
            status_text: status_text_for_code(status),
            headers: [],
            body: body
        )

class MockResponseRegistry:
    entries: [MockResponseEntry]

    static fn create() -> MockResponseRegistry:
        MockResponseRegistry(entries: [])

    me register(url_pattern: text, status: i64, body: text):
        val entry = MockResponseEntry.create(url_pattern, status, body)
        self.entries.push(entry)

    me register_with_headers(url_pattern: text, status: i64, headers: [Pair<text, text>], body: text):
        var entry = MockResponseEntry.create(url_pattern, status, body)
        entry.headers = headers
        self.entries.push(entry)

    fn lookup(url: text) -> MockResponseEntry?:
        for entry in self.entries:
            if url.contains(entry.url_pattern):
                return entry
        return nil

    fn size() -> i64:
        self.entries.len()

# Global mock registry instance for test wiring
var _global_mock_registry: MockResponseRegistry? = nil

fn get_mock_registry() -> MockResponseRegistry:
    if _global_mock_registry.?:
        return _global_mock_registry.unwrap()
    var reg = MockResponseRegistry.create()
    _global_mock_registry = reg
    return reg

fn set_mock_registry(registry: MockResponseRegistry):
    _global_mock_registry = registry

fn observed_mock_request(url_pattern: text) -> FetchRequest?:
    val registry = get_mock_registry()
    for request in registry.observed_requests:
        if request.url.to_text().contains(url_pattern):
            return request
    nil

fn observed_mock_request_count(url_pattern: text, method: text = "") -> i64:
    val registry = get_mock_registry()
    val expected_method = method.to_upper()
    var count: i64 = 0
    for request in registry.observed_requests:
        if request.url.to_text().contains(url_pattern):
            if expected_method == "" or request.method.to_upper() == expected_method:
                count = count + 1
    count

fn h1_mock_response(req: FetchRequest) -> Result<FetchResponse, BrowserError>?:
    h1_mock_response_until(req, 0)

fn h1_mock_response_until(
    req: FetchRequest, deadline_ms: i64
) -> Result<FetchResponse, BrowserError>?:
    var registry = get_mock_registry()
    registry.observed_requests.push(req)
    _global_mock_registry = registry
    if val Some(mock) = registry.lookup(req.url.to_text()):
        if not h1_response_size_allowed(0, mock.body.len()):
            return Some(Err(network_error(
                "h1: response exceeds 50 MiB limit"
            )))
        var headers: [Pair<text, text>] = []
        for header in mock.headers:
            headers.push(header)
        if find_header(headers, "content-type").? == false:
            headers.push(Pair("Content-Type", "text/html; charset=utf-8"))
        headers.push(Pair("Content-Length", "{mock.body.len()}"))
        headers.push(Pair("Connection", "close"))
        headers.push(Pair("X-Simple-Browser", "mock-response"))
        return Some(Ok(FetchResponse(
            status: mock.status,
            headers: serialize_headers(headers),
            body: rt_text_to_bytes(mock.body)
        )))
    nil

fn h1_deadline_now_ms() -> i64:
    val registry = get_mock_registry()
    if registry.now_ms > 0: registry.now_ms else: browser_monotonic_ms()

fn h1_deadline_expired(deadline_ms: i64) -> bool:
    h1_deadline_remaining_ms(h1_deadline_now_ms(), deadline_ms) == 0

fn h1_default_deadline_ms() -> i64:
    h1_deadline_now_ms() + H1_TOTAL_TIMEOUT_MS

# --- H1Connection ---

class H1Connection:
    host: text
    port: i64
    is_tls: bool
    tls_conn: TlsConnection?
    tcp_fd: i64
    is_keep_alive: bool
    logger: Logger

    static fn create(host: text, port: i64, is_tls: bool, logger: Logger) -> H1Connection:
        H1Connection(
            host: host,
            port: port,
            is_tls: is_tls,
            tls_conn: nil,
            tcp_fd: -1,
            is_keep_alive: true,
            logger: logger
        )

    fn description() -> text:
        val scheme = if self.is_tls: "https" else: "http"
        val alive = if self.is_keep_alive: "keep-alive" else: "close"
        "{scheme}://{self.host}:{self.port} ({alive})"

    fn matches(host: text, port: i64, is_tls: bool) -> bool:
        self.host == host and self.port == port and self.is_tls == is_tls

# --- H1Client ---

class H1Client:
    logger: Logger
    dns: DnsResolver
    tls: TlsManager
    connections: [H1Connection]
    max_connections_per_host: i64

    static fn new(logger: Logger, dns: DnsResolver, tls: TlsManager) -> H1Client:
        H1Client(
            logger: logger,
            dns: dns,
            tls: tls,
            connections: [],
            max_connections_per_host: 6
        )

    # Send an HTTP/1.1 request and return the parsed response.
    me request(req: FetchRequest, deadline_ms: i64 = 0) -> Result<FetchResponse, BrowserError>:
        val request_deadline_ms = if deadline_ms > 0:
            deadline_ms
        else:
            h1_default_deadline_ms()
        if h1_deadline_expired(request_deadline_ms):
            return Err(network_error(
                "h1: aggregate request deadline exceeded"
            ))
        if req.url.scheme != "http" and req.url.scheme != "https":
            return Err(network_error("h1: unsupported URL scheme '{req.url.scheme}'"))
        val host = req.url.host
        val port = get_port(req.url)
        val is_tls = req.url.scheme == "https"

        self.logger.info("h1: {method_to_text(req.method)} {req.url.to_text()}")

        # Step 1: Get or create a connection (connection pooling)
        var conn = self.get_connection(host, port, is_tls)?

        # ponytail: one-shot connections until response framing can preserve a
        # live socket; both response readers currently consume-to-EOF and close.
        val deadline_ms = browser_monotonic_ms() + H1_TOTAL_TIMEOUT_MS
        var conn = self.get_connection(host, port, is_tls, deadline_ms)?

        if is_tls and conn.tls_conn.? == false:
            var service_identity = host
            var addresses: [text] = []
            if val identity = h1_tls_ipv6_literal_identity(host):
                service_identity = identity
                addresses = [identity]
            else:
                addresses = self.dns.resolve(host)?
            var tls_conn: TlsConnection? = nil
            for address in addresses:
                val remaining = h1_deadline_remaining_ms(
                    browser_monotonic_ms(), deadline_ms
                )
                if remaining == 0:
                    break
                match self.tls.handshake_address(
                    address, host, port, remaining
                ):
                    Ok(connected):
                        tls_conn = Some(connected)
                        break
                    Err(_):
                        pass_dn
            if tls_conn == nil:
                return Err(network_error(
                    "h1: TLS connection failed for {host}:{port}"
                ))
            val established = tls_conn.unwrap()
            if h1_deadline_remaining_ms(
                browser_monotonic_ms(), deadline_ms
            ) == 0:
                val _ = established.close()
                return Err(network_error("h1: TLS handshake deadline exceeded"))
            conn.tls_conn = Some(established)
            self.logger.debug("h1: TLS established for {host}:{port}")

        # Step 3: Build request bytes
        val request_bytes = build_request_bytes(req)
        self.logger.trace("h1: sending request:\n{request_bytes}")

        # Step 4: Check mock registry for a canned response
        val mock_reg = get_mock_registry()
        val url_text = req.url.to_text()
        if mock_reg.size() > 0 and mock_reg.lookup(url_text).?:
            val entry = mock_reg.lookup(url_text).unwrap()
            self.logger.debug("h1: mock response for {url_text} -> {entry.status}")
            var mock_headers: [Pair<text, text>] = []
            for mh in entry.headers:
                mock_headers.push(mh)
            if find_header(mock_headers, "content-type").? == false:
                mock_headers.push(Pair("Content-Type", "text/html; charset=utf-8"))
            mock_headers.push(Pair("Content-Length", "{entry.body.len()}"))
            mock_headers.push(Pair("Connection", "keep-alive"))
            mock_headers.push(Pair("X-Simple-Browser", "mock-response"))
            return Ok(FetchResponse(
                status: entry.status,
                status_text: entry.status_text,
                headers: mock_headers,
                body: entry.body,
                url: req.url,
                redirected: false
            ))

        # Step 5: No mock — use real transport.
        if is_tls:
            return self.execute_tls_http(req, conn, request_bytes)
        return self.execute_plain_http(req, conn, request_bytes)

    # Look up an existing pooled connection or create a new one.
    me get_connection(host: text, port: i64, is_tls: bool) -> Result<H1Connection>:
        # Check pool for a reusable keep-alive connection
        var idx = 0
        while idx < self.connections.len():
            val conn = self.connections.get(idx)
            if conn.matches(host, port, is_tls) and conn.is_keep_alive:
                self.logger.debug("h1: reusing pooled connection to {host}:{port}")
                return Ok(conn)
            idx = idx + 1

        # Count existing connections to this host
        val host_count = self.count_connections(host, port)
        if host_count >= self.max_connections_per_host:
            return Err(network_error("h1: max connections ({self.max_connections_per_host}) reached for {host}:{port}"))

        # DNS resolve
        val addresses = self.dns.resolve(host)?
        if addresses.is_empty():
            return Err(network_error("h1: DNS resolution returned no addresses for {host}"))

        var fd: i64 = -1
        for address in addresses:
            val remaining = h1_deadline_remaining_ms(
                browser_monotonic_ms(), deadline_ms
            )
            if remaining == 0:
                break
            val connect_addr = h1_connect_address(address, port)
            self.logger.debug(
                "h1: opening TCP stream to {connect_addr} for host {host}"
            )
            fd = rt_io_tcp_connect_timeout(connect_addr, remaining)
            if fd >= 0:
                break
        if fd < 0:
            return Err(network_error("h1: TCP connect failed for {host}:{port}"))
        val remaining = h1_deadline_remaining_ms(
            browser_monotonic_ms(), deadline_ms
        )
        if remaining == 0:
            val _ = rt_io_tcp_close(fd)
            return Err(network_error("h1: TCP connect deadline exceeded"))
        val _ = rt_io_tcp_set_nodelay(fd, true)
        val _ = rt_io_tcp_set_read_timeout(fd, Some(remaining))
        val _ = rt_io_tcp_set_write_timeout(fd, Some(remaining))
        conn.tcp_fd = fd

        Ok(conn)

    me execute_plain_http(
        req: FetchRequest, conn: H1Connection, request_bytes: text,
        deadline_ms: i64
    ) -> Result<FetchResponse, BrowserError>:
        if conn.tcp_fd < 0:
            return Err(network_error("h1: missing TCP stream for {conn.host}:{conn.port}"))
        val write_budget = h1_deadline_remaining_ms(
            browser_monotonic_ms(), deadline_ms
        )
        if write_budget == 0:
            val _ = rt_io_tcp_close(conn.tcp_fd)
            return Err(network_error("h1: TCP write deadline exceeded"))
        val _ = rt_io_tcp_set_write_timeout(
            conn.tcp_fd, Some(write_budget)
        )
        val written = rt_io_tcp_write_text(conn.tcp_fd, request_bytes)
        if not h1_write_complete(written, request_bytes.len()):
            val _ = rt_io_tcp_close(conn.tcp_fd)
            return Err(network_error("h1: incomplete TCP write for {conn.host}:{conn.port}"))
        val flushed = rt_io_tcp_flush(conn.tcp_fd)
        if not flushed:
            val _ = rt_io_tcp_close(conn.tcp_fd)
            return Err(network_error("h1: TCP flush failed for {conn.host}:{conn.port}"))
        val read_result = read_tcp_response_bytes(conn.tcp_fd, deadline_ms)
        val _ = rt_io_tcp_close(conn.tcp_fd)
        val raw_response = read_result?
        if raw_response.len() == 0:
            return Err(network_error("h1: TCP read returned no response for {conn.host}:{conn.port}"))
        val parsed = parse_http_response(raw_response)?
        return Ok(FetchResponse(
            status: parsed.status,
            status_text: parsed.status_text,
            headers: parsed.headers,
            body: parsed.body,
            url: req.url,
            redirected: parsed.redirected
        ))

    me execute_tls_http(
        req: FetchRequest, conn: H1Connection, request_bytes: text,
        deadline_ms: i64
    ) -> Result<FetchResponse, BrowserError>:
        if val tls_conn = conn.tls_conn:
            val written = tls_conn.write_text(request_bytes)
            if written <= 0:
                val _ = tls_conn.close()
                return Err(network_error("h1: TLS write failed for {conn.host}:{conn.port}"))
            val raw_response = read_tls_response_text(tls_conn)
            val _ = tls_conn.close()
            conn.is_keep_alive = false
            if raw_response.len() == 0:
                return Err(network_error("h1: TLS read returned no response for {conn.host}:{conn.port}"))
            # NOTE: the pure-Simple TLS transport (rt_tls_client_*) is not yet
            # wired to a real implementation (see execute_host_https above) so
            # this path is not exercised against live servers today. It still
            # goes through rt_text_to_bytes here so any future TLS-transport
            # fix inherits the same byte-accurate framing as the plain-HTTP
            # path rather than reintroducing the char/byte mismatch bug.
            match parse_http_response_bytes(rt_text_to_bytes(raw_response)):
                Ok(parsed):
                    return Ok(FetchResponse(
                        status: parsed.status,
                        status_text: parsed.status_text,
                        headers: parsed.headers,
                        body: parsed.body,
                        url: req.url,
                        redirected: parsed.redirected
                    ))
                Err(e):
                    return Err(e)
        Err(network_error("h1: missing TLS connection for {conn.host}:{conn.port}"))

    # Count active connections to a specific host:port.
    fn count_connections(host: text, port: i64) -> i64:
        var count = 0
        for conn in self.connections:
            if conn.host == host and conn.port == port:
                count = count + 1
        count

    # Remove a connection from the pool.
    me remove_connection(host: text, port: i64, is_tls: bool):
        var new_conns: [H1Connection] = []
        var removed = false
        for conn in self.connections:
            if not removed and conn.matches(host, port, is_tls):
                removed = true
                self.logger.debug("h1: removed connection to {host}:{port} from pool")
            else:
                new_conns.push(conn)
        self.connections = new_conns

    # Close all pooled connections.
    me close_all():
        self.logger.info("h1: closing all {self.connections.len()} pooled connections")
        self.connections = []

# --- Request serialization ---

fn build_request_bytes(req: FetchRequest) -> text:
    # Build an HTTP/1.1 request string from a FetchRequest.
    # Format:
    #   METHOD /path HTTP/1.1\r\n
    #   Host: hostname\r\n
    #   [headers]\r\n
    #   \r\n
    #   [body]
    val method = method_to_text(req.method)
    val path = if req.url.path.len() > 0: req.url.path else: "/"
    val query_str = if req.url.query.len() > 0: "?{req.url.query}" else: ""

    var result = "{method} {path}{query_str} HTTP/1.1\r\n"
    result = result + "Host: {req.url.host}\r\n"

    # Add user-provided headers
    var has_content_length = false
    var has_user_agent = false
    var has_accept = false
    var has_connection = false
    for header in req.headers:
        val name_lower = net_ascii_lower("{header.first}")
        if name_lower == "content-length":
            has_content_length = true
        if name_lower == "user-agent":
            has_user_agent = true
        if name_lower == "accept":
            has_accept = true
        if name_lower == "connection":
            has_connection = true
        result = result + "{header.first}: {header.second}\r\n"

    # Add default headers if not already present
    if not has_user_agent:
        result = result + "User-Agent: SimpleBrowser/1.0\r\n"
    if not has_accept:
        result = result + "Accept: */*\r\n"
    if not has_connection:
        result = result + "Connection: close\r\n"

    # Add Content-Length for methods with bodies
    if req.body.len() > 0 and not has_content_length:
        result = result + "Content-Length: {req.body.len()}\r\n"

    # End of headers
    result = result + "\r\n"

    # Append body if present
    if req.body.len() > 0:
        result = result + h1_bytes_to_text(req.body)

    result

# --- Response parsing ---

fn read_tcp_response_bytes(fd: i64) -> [u8]:
    var bytes: [u8] = []
    while true:
        val remaining = h1_deadline_remaining_ms(
            browser_monotonic_ms(), deadline_ms
        )
        if remaining == 0:
            return Err(network_error("h1: TCP response deadline exceeded"))
        val _ = rt_io_tcp_set_read_timeout(fd, Some(remaining))
        val chunk = rt_io_tcp_read(fd, 8192)
        if chunk.len() == 0:
            if h1_deadline_remaining_ms(
                browser_monotonic_ms(), deadline_ms
            ) == 0:
                return Err(network_error("h1: TCP response deadline exceeded"))
            break
        if not h1_response_size_allowed(bytes.len(), chunk.len()):
            return Err(network_error("h1: response exceeds 50 MiB limit"))
        bytes = bytes + chunk
    Ok(bytes)

fn read_tls_response_text(conn: TlsConnection) -> text:
    var response = ""
    while true:
        val chunk = conn.read_text(8192)
        if chunk.len() == 0:
            break
        val chunk_bytes = rt_text_to_bytes(chunk)
        val _ = browser_runtime_string_free(chunk)
        if not h1_response_size_allowed(response.len(), chunk_bytes.len()):
            return Err(network_error("h1: response exceeds 50 MiB limit"))
        response = response + chunk_bytes
    Ok(response)

# Parse a raw HTTP/1.x response given as bytes.
# NOTE: operates on [u8] rather than `text` for the header/body split and
# body-length accounting. Content-Length and chunk sizes are BYTE counts
# per RFC 7230; a real response body routinely contains multi-byte UTF-8
# characters (curly quotes, non-Latin text, emoji), and `text.len()`/`s[i]`
# character-indexing goes out of sync with those byte counts on such input
# (observed crash: "string index out of bounds" fetching real google.com/
# wikipedia.org bodies). Only the header block — which is ASCII per spec —
# is decoded to `text` for line-based parsing.
fn parse_http_response_bytes(raw: [u8]) -> Result<FetchResponse, BrowserError>:
    val parts = split_header_body_bytes(raw)
    val header_text = h1_bytes_to_text(parts.first)
    val header_lines = split_lines(header_text)
    if header_lines.len() == 0:
        return Err(parse_error("h1: empty HTTP response"))
    val status = parse_status_line(header_lines[0])?
    var raw_headers = ""
    var i = 1
    while i < header_lines.len():
        raw_headers = raw_headers + header_lines[i] + "\r\n"
        i = i + 1
    val headers = parse_headers(raw_headers)
    val body = read_response_body_bytes(parts.second, headers)
    return Ok(FetchResponse(
        status: status.first,
        status_text: status.second,
        headers: headers,
        body: body,
        url: Url.create("http", "", 0, ""),
        redirected: false
    ))

fn parse_status_line(line: text) -> Result<Pair<i64, text>>:
    # Parse an HTTP/1.1 status line: "HTTP/1.1 200 OK"
    # Returns (status_code, status_text).
    if line.len() < 12:
        return Err(parse_error("h1: status line too short: '{line}'"))

    # Validate HTTP version prefix
    val version_prefix = h1_substring(line, 0, 9)
    if version_prefix != "HTTP/1.1 " and version_prefix != "HTTP/1.0 ":
        return Err(parse_error("h1: invalid HTTP version in status line: '{line}'"))

    # Extract status code (3 digits at position 9)
    val code_str = h1_substring(line, 9, 12)
    val code = _h1_parse_int(code_str)
    if code < 100 or code > 599:
        return Err(parse_error("h1: invalid status code: '{code_str}'"))

    # Extract status text (everything after "HTTP/1.1 NNN ")
    var status_text = ""
    if line.len() > 13:
        status_text = h1_substring(line, 13, line.len())
    else:
        status_text = status_text_for_code(code)

    Ok(Pair(code, status_text))

fn parse_header_line(line: text) -> Pair<text, text>?:
    # Parse a single header line: "Content-Type: text/html"
    # Returns nil for malformed lines.
    val colon_pos = h1_find_char(line, ":")
    if colon_pos < 0:
        return nil

    val name = h1_substring(line, 0, colon_pos).trim()
    var value = ""
    if colon_pos + 1 < line.len():
        value = h1_substring(line, colon_pos + 1, line.len()).trim()

    if name.len() == 0:
        return nil

    Pair(name, value)

fn parse_headers(raw: text) -> [Pair<text, text>]:
    # Parse a block of HTTP headers (separated by \r\n).
    var headers: [Pair<text, text>] = []
    val lines = split_lines(raw)
    for line in lines:
        if line.len() > 0:
            val parsed = parse_header_line(line)
            if val p = parsed:
                headers.push(p)
    headers

fn read_response_body_bytes(raw_body: [u8], headers: [Pair<text, text>]) -> [u8]:
    # Read the response body based on headers.
    # Supports Content-Length and chunked transfer encoding.
    val transfer_encoding = find_header(headers, "transfer-encoding")
    if val te = transfer_encoding:
        if net_ascii_lower("{te}").contains("chunked"):
            return parse_chunked_body(raw_body)

    val content_length_str = find_header(headers, "content-length")
    if val cl_str = content_length_str:
        val cl = parse_int(cl_str)
        if cl >= 0 and cl <= raw_body.len():
            return h1_substring(raw_body, 0, cl)

    # Fall back to returning the entire body
    raw_body

fn parse_chunked_body_bytes(raw: [u8]) -> [u8]:
    # Decode a chunked transfer-encoded body.
    # Format:
    #   <chunk-size-hex>\r\n
    #   <chunk-data>\r\n
    #   ...
    #   0\r\n
    #   \r\n
    var result: [u8] = []
    var pos = 0

    while pos < raw.len():
        # Find end of chunk size line
        val line_end = h1_find_crlf(raw, pos)
        if line_end < 0:
            break

        # Parse chunk size (hex) — the size line is pure ASCII
        val size_str = h1_bytes_to_text(raw.slice(pos, line_end)).trim()
        val chunk_size = h1_chunk_size_value(size_str)
        if chunk_size < 0:
            return Err(parse_error("h1: invalid or oversized chunk"))
        if chunk_size == 0:
            if line_end + 4 > raw.len() or raw[line_end + 2] != 13 or raw[line_end + 3] != 10:
                return Err(parse_error("h1: incomplete terminal chunk"))
            return Ok(result)

        # Read chunk data
        val data_start = line_end + 2  # Skip \r\n after size
        val data_end = data_start + chunk_size

        if data_end + 2 > raw.len():
            return Err(parse_error("h1: truncated chunk data"))
        if raw[data_end] != 13 or raw[data_end + 1] != 10:
            return Err(parse_error("h1: missing chunk terminator"))
        if not h1_response_size_allowed(result.len(), chunk_size):
            return Err(parse_error("h1: decoded body exceeds 50 MiB limit"))

        result = result + raw.slice(data_start, data_end)

        # Skip \r\n after chunk data
        pos = data_end + 2

    result

# --- URL and header helpers ---

fn get_port(url: Url) -> i64:
    # Determine the port from the URL. Uses explicit port if set,
    # otherwise defaults to 80 for HTTP and 443 for HTTPS.
    if url.port > 0:
        return url.port
    if url.scheme == "https":
        return 443
    80

fn find_header(headers: [Pair<text, text>], name: text) -> text?:
    # Find the first header value matching the given name (case-insensitive).
    val name_lower = net_ascii_lower("{name}")
    for header in headers:
        val header_name = net_ascii_lower("{header.first}")
        if header_name == name_lower:
            return header.second
    nil

fn method_to_text(method: HttpMethod) -> text:
    match method:
        HttpMethod.Get: "GET"
        HttpMethod.Post: "POST"
        HttpMethod.Put: "PUT"
        HttpMethod.Delete: "DELETE"
        HttpMethod.Head: "HEAD"
        HttpMethod.Options: "OPTIONS"
        HttpMethod.Patch: "PATCH"

fn status_text_for_code(code: i64) -> text:
    # Return the standard reason phrase for common HTTP status codes.
    if code == 100: return "Continue"
    if code == 101: return "Switching Protocols"
    if code == 200: return "OK"
    if code == 201: return "Created"
    if code == 204: return "No Content"
    if code == 301: return "Moved Permanently"
    if code == 302: return "Found"
    if code == 304: return "Not Modified"
    if code == 307: return "Temporary Redirect"
    if code == 308: return "Permanent Redirect"
    if code == 400: return "Bad Request"
    if code == 401: return "Unauthorized"
    if code == 403: return "Forbidden"
    if code == 404: return "Not Found"
    if code == 405: return "Method Not Allowed"
    if code == 408: return "Request Timeout"
    if code == 413: return "Payload Too Large"
    if code == 429: return "Too Many Requests"
    if code == 500: return "Internal Server Error"
    if code == 502: return "Bad Gateway"
    if code == 503: return "Service Unavailable"
    if code == 504: return "Gateway Timeout"
    "Unknown"

# --- String utility helpers ---

fn h1_find_char(s: text, ch: text) -> i64:
    # Find the index of the first occurrence of ch in s. Returns -1 if not found.
    var i = 0
    while i < s.len():
        if s[i] == ch:
            return i
        i = i + 1
    -1

fn h1_find_crlf(s: text, start: i64) -> i64:
    # Find the index of "\r\n" in s starting from the given position.
    # Returns the index of '\r', or -1 if not found.
    var i = start
    while i < s.len() - 1:
        if s[i] == "\r" and s[i + 1] == "\n":
            return i
        i = i + 1
    -1

fn h1_substring(s: text, start: i64, end: i64) -> text:
    var result = ""
    var i = start
    while i < end and i < s.len():
        result = result + s[i]
        i = i + 1
    result

fn h1_bytes_to_text(bytes: [u8]) -> text:
    # Convert raw bytes to text without runtime FFI. This avoids evaluator
    # failures where `rt_bytes_to_text([u8])` may return an empty string.
    # ASCII is used for HTTP protocol framing; malformed UTF-8 bytes become '?'.
    var result = ""
    var i = 0
    val n = bytes.len()
    while i < n:
        val first = bytes[i] as i64
        if first < 0x80:
            result = result + char_from_code(first)
            i = i + 1
        else if first < 0xC0:
            result = result + "?"
            i = i + 1
        else if first < 0xE0:
            if i + 1 >= n:
                result = result + "?"
                i = i + 1
            else:
                val second = bytes[i + 1] as i64
                if (second & 0xC0) == 0x80:
                    val cp = ((first & 0x1F) << 6) | (second & 0x3F)
                    if cp >= 0x80:
                        result = result + char_from_code(cp)
                        i = i + 2
                    else:
                        result = result + "?"
                        i = i + 1
                else:
                    result = result + "?"
                    i = i + 1
        else if first < 0xF0:
            if i + 2 >= n:
                result = result + "?"
                i = i + 1
            else:
                val second = bytes[i + 1] as i64
                val third = bytes[i + 2] as i64
                if (second & 0xC0) == 0x80 and (third & 0xC0) == 0x80:
                    val cp = ((first & 0x0F) << 12) |
                        ((second & 0x3F) << 6) |
                        (third & 0x3F)
                    result = result + char_from_code(cp)
                    i = i + 3
                else:
                    result = result + "?"
                    i = i + 1
        else if first < 0xF8:
            if i + 3 >= n:
                result = result + "?"
                i = i + 1
            else:
                val second = bytes[i + 1] as i64
                val third = bytes[i + 2] as i64
                val fourth = bytes[i + 3] as i64
                if (second & 0xC0) == 0x80 and
                    (third & 0xC0) == 0x80 and (fourth & 0xC0) == 0x80:
                    val cp = ((first & 0x07) << 18) |
                        ((second & 0x3F) << 12) |
                        ((third & 0x3F) << 6) |
                        (fourth & 0x3F)
                    result = result + char_from_code(cp)
                    i = i + 4
                else:
                    result = result + "?"
                    i = i + 1
        else:
            result = result + "?"
            i = i + 1
    result

fn net_ascii_lower(s: text) -> text:
    var result = ""
    var i = 0
    while i < s.len():
        result = result + net_ascii_lower_char(s[i])
        i = i + 1
    result

fn net_ascii_lower_char(ch: text) -> text:
    if ch == "A": return "a"
    if ch == "B": return "b"
    if ch == "C": return "c"
    if ch == "D": return "d"
    if ch == "E": return "e"
    if ch == "F": return "f"
    if ch == "G": return "g"
    if ch == "H": return "h"
    if ch == "I": return "i"
    if ch == "J": return "j"
    if ch == "K": return "k"
    if ch == "L": return "l"
    if ch == "M": return "m"
    if ch == "N": return "n"
    if ch == "O": return "o"
    if ch == "P": return "p"
    if ch == "Q": return "q"
    if ch == "R": return "r"
    if ch == "S": return "s"
    if ch == "T": return "t"
    if ch == "U": return "u"
    if ch == "V": return "v"
    if ch == "W": return "w"
    if ch == "X": return "x"
    if ch == "Y": return "y"
    if ch == "Z": return "z"
    ch

fn split_header_body(raw: text) -> Pair<text, text>:
    # Split an HTTP response into header section and body, separated by \r\n\r\n.
    var i = 0
    while i < raw.len() - 3:
        if (raw[i] == "\r" and raw[i + 1] == "\n"
            and raw[i + 2] == "\r" and raw[i + 3] == "\n"):
            val headers = h1_substring(raw, 0, i)
            val body = h1_substring(raw, i + 4, raw.len())
            return Pair(headers, body)
        i = i + 1
    # No separator found — treat entire response as headers with empty body
    Pair(raw, [])

fn bytes_find_crlf(raw: [u8], start: i64) -> i64:
    # Find the index of "\r\n" (bytes 13,10) in raw starting from `start`.
    # Returns the index of '\r', or -1 if not found.
    var i = start
    while i < raw.len() - 1:
        if raw[i] == 13 and raw[i + 1] == 10:
            return i
        i = i + 1
    -1

fn split_lines(s: text) -> [text]:
    # Split a string by \r\n line endings.
    var lines: [text] = []
    var start = 0
    var i = 0
    while i < s.len() - 1:
        if s[i] == "\r" and s[i + 1] == "\n":
            lines.push(h1_substring(s, start, i))
            start = i + 2
            i = i + 2
        else:
            i = i + 1
    # Add remaining text after last \r\n
    if start < s.len():
        lines.push(h1_substring(s, start, s.len()))
    lines

fn _h1_parse_int(s: text) -> i64:
    # Parse a decimal integer string. Returns 0 on invalid input.
    var result = 0
    var negative = false
    var i = 0

    if s.len() > 0 and s[0] == "-":
        negative = true
        i = 1

    while i < s.len():
        val ch = s[i]
        val digit = char_to_digit(ch)
        if digit < 0:
            return 0
        result = result * 10 + digit
        i = i + 1

    if negative: 0 - result else: result

fn parse_hex(s: text) -> i64:
    # Parse a hexadecimal integer string. Returns 0 on invalid input.
    var result = 0
    var i = 0

    # Skip optional "0x" prefix
    if s.len() >= 2 and s[0] == "0" and (s[1] == "x" or s[1] == "X"):
        i = 2

    while i < s.len():
        val ch = net_ascii_lower(s[i])
        val digit = hex_char_to_digit(ch)
        if digit < 0:
            return result  # Stop at first non-hex character
        result = result * 16 + digit
        i = i + 1

    result

# NOTE: the trailing "not found" value below is `return -1`, not a bare
# `-1` expression. A bare negative-integer literal immediately after a run
# of single-line `if cond: return X` statements is silently dropped by the
# interpreter (the function implicitly returns nil instead) — confirmed by
# isolated repro; see doc/08_tracking/bug/browser_net_real_site_gaps_2026-07-11.md.
# This is exactly what corrupted chunked-transfer decoding for real sites
# (parse_hex("d2c") returned 32 instead of 3372 because hex_char_to_digit
# returned nil/0 for 'd' and 'c').
fn char_to_digit(ch: text) -> i64:
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    -1

fn hex_char_to_digit(ch: text) -> i64:
    val d = char_to_digit(ch)
    if d >= 0:
        return d
    if ch == "a": return 10
    if ch == "b": return 11
    if ch == "c": return 12
    if ch == "d": return 13
    if ch == "e": return 14
    if ch == "f": return 15
    -1
