#![allow(REQC001)]
#![allow(REQC004)]
#![allow(unnamed_duplicate_typed_args)]
# Fetch API implementation for the Simple Browser Platform.
# This is the main network entry point — all resource loading flows through fetch().
# Implements the Fetch specification's request lifecycle: CORS check, cache lookup,
# DNS resolution, HTTP request, redirect handling, cookie storage, and response caching.

use std.gc_async_mut.gpu.browser_engine.net.entity.request_types {FetchRequest, FetchResponse, HttpMethod, RequestMode, RequestCredentials}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types {Url, Origin}
use std.gc_async_mut.gpu.browser_engine.net.entity.cors_types {PreflightResult}
use std.gc_async_mut.gpu.browser_engine.shared.error {BrowserError, BrowserResult, network_error}
use std.gc_async_mut.gpu.browser_engine.shared.logging {Logger, LogLevel}
use std.gc_async_mut.gpu.browser_engine.net.dns {DnsResolver}
use std.gc_async_mut.gpu.browser_engine.net.cors {CorsChecker, is_simple_method, needs_preflight}
use std.gc_async_mut.gpu.browser_engine.net.h1_client {H1Client}
use std.gc_async_mut.gpu.browser_engine.net.tls {TlsManager, TlsConnection}
use std.gc_async_mut.gpu.browser_engine.net.entity.tls_types {TlsConfig, TlsVersion}

use std.gc_async_mut.gpu.browser_engine.net.cache.{HttpCache}
use std.gc_async_mut.gpu.browser_engine.net.cookie_store.{CookieStore, parse_set_cookie}

# Default maximum number of HTTP redirects to follow before aborting.
val DEFAULT_MAX_REDIRECTS = 20

# Default DNS cache TTL in seconds.
val DEFAULT_DNS_TTL = 300

# The Fetch engine orchestrates the full request lifecycle.
# Each fetch() call runs through: CORS preflight (if needed), cache check,
# DNS resolution, HTTP transport, redirect following, cookie management,
# and response caching.
class FetchEngine:
    dns: DnsResolver
    cache: HttpCache
    cookie_store: CookieStore
    cors: CorsChecker
    logger: Logger
    max_redirects: i64

    static fn new(logger: Logger) -> FetchEngine:
        FetchEngine(
            dns: DnsResolver.new(logger, DEFAULT_DNS_TTL),
            cache: HttpCache.new(logger, 50),
            cookie_store: CookieStore.new(),
            cors: CorsChecker.new(""),
            logger: logger,
            max_redirects: DEFAULT_MAX_REDIRECTS
        )

    # The main fetch function. Implements the Fetch specification request lifecycle.
    # Steps: CORS check -> cache -> DNS -> HTTP -> redirects -> cookies -> cache store.
    me fetch(request: FetchRequest) -> Result<FetchResponse, BrowserError>:
        self.fetch_with_redirect(
            request, 0, h1_default_deadline_ms()
        )

    # Execute exactly one request URL. Redirect responses are returned unchanged
    # so higher-level browser policy can inspect and commit every hop.
    me fetch_single_hop(
        request: FetchRequest, deadline_ms: i64 = 0
    ) -> Result<FetchResponse, BrowserError>:
        val request_deadline_ms = if deadline_ms > 0:
            deadline_ms
        else:
            h1_default_deadline_ms()
        val prepared = self.prepare_single_hop(
            request, "", false, request_deadline_ms
        )?
        if val Some(response) = prepared.response:
            return Ok(response)
        val response = self.execute_http(prepared.request)?
        self.finalize_single_hop(prepared.request, response)

    me prepare_single_hop(
        request: FetchRequest,
        site_for_cookies_url: text = "",
        is_top_level_navigation: bool = false,
        deadline_ms: i64 = 0
    ) -> Result<FetchSingleHopPreparation, BrowserError>:
        self.logger.info("fetch: {request.method.to_upper()} {request.url.to_text()}")
        val policy_request = self.cors.prepare_actual_request(request)

        match policy_request.mode:
            RequestMode.SameOrigin:
                if not self.cors.is_same_origin(policy_request.url):
                    return Err(network_error("Same-origin request denied"))
            _:
                pass_do_nothing

        # Step 1: CORS preflight if the request mode is Cors
        match request.mode:
            RequestMode.Cors:
                val preflight_result = self.handle_cors_preflight(request)?
                if not preflight_result:
                    return Err(network_error("CORS preflight denied"))
            _:
                pass_do_nothing

        self._prepare_single_hop_after_cors_preflight(
            policy_request, site_for_cookies_url, is_top_level_navigation
        )

    me build_cors_preflight(
        request: FetchRequest
    ) -> FetchCorsPreflightPlan:
        val actual_request = self.cors.prepare_actual_request(request)
        val preflight_request = if (
            actual_request.mode == RequestMode.Cors and
            self.cors.needs_preflight(actual_request)
        ):
            Some(self.cors.create_preflight(actual_request))
        else:
            nil
        FetchCorsPreflightPlan(
            actual_request: actual_request,
            preflight_request: preflight_request
        )

    me validate_cors_preflight(
        actual_request: FetchRequest, response: FetchResponse
    ) -> Result<bool, BrowserError>:
        if response.status < 200 or response.status >= 300:
            return Ok(false)
        if self.cors.validate_preflight_method_with_credentials(
            response.headers,
            actual_request.method,
            actual_request.credentials
        ) == PreflightResult.Denied:
            return Ok(false)
        val requested_headers = cors_unsafe_request_header_names(
            actual_request.headers
        )
        if (requested_headers != "" and
            self.cors.validate_preflight_headers_with_credentials(
                response.headers,
                requested_headers,
                actual_request.credentials
            ) == PreflightResult.Denied):
            return Ok(false)
        Ok(true)

    me prepare_single_hop_after_cors_preflight(
        request: FetchRequest,
        site_for_cookies_url: text = "",
        is_top_level_navigation: bool = false
    ) -> Result<FetchSingleHopPreparation, BrowserError>:
        val policy_request = self.cors.prepare_actual_request(request)
        match policy_request.mode:
            RequestMode.SameOrigin:
                if not self.cors.is_same_origin(policy_request.url):
                    return Err(network_error("Same-origin request denied"))
            _:
                pass_do_nothing
        self._prepare_single_hop_after_cors_preflight(
            policy_request, site_for_cookies_url, is_top_level_navigation
        )

    fn _prepare_single_hop_after_cors_preflight(
        policy_request: FetchRequest,
        site_for_cookies_url: text,
        is_top_level_navigation: bool
    ) -> Result<FetchSingleHopPreparation, BrowserError>:
        # Step 2: Check the HTTP cache
        val cached = self.cache.lookup(request)
        if val response = cached:
            self.logger.debug("fetch: cache hit for {request.url.to_text()}")
            return Ok(response)

        # Step 3: Attach cookies to the request
        val request_with_cookies = self.attach_cookies(
            policy_request, site_for_cookies_url, is_top_level_navigation
        )
        Ok(FetchSingleHopPreparation.pending(request_with_cookies))

    me finalize_single_hop(
        request: FetchRequest, response: FetchResponse
    ) -> Result<FetchResponse, BrowserError>:
        val validated = self.validate_response_policy(request, response)?

        # Step 6: Store cookies only when the request credentials permit it.
        if credentials_allow_request_cookies(
            request.credentials,
            self.cors.is_same_origin(request.url)
        ):
            val target_origin = Origin.from_url(request.url)
            val partition_key = cookie_partition_key(
                self.cors.requester_origin()
            )
            val now = time_now_unix_micros() / 1000000
            var cookie_store = self.cookie_store
            for line in validated.headers.split("\r\n"):
                val lower_line = line.to_lower()
                if lower_line.starts_with("set-cookie:"):
                    val raw_cookie_value = line.slice(11, line.len())
                    if _cookie_source_boundary_valid(raw_cookie_value):
                        val cookie_value = raw_cookie_value.trim()
                        val cookie = apply_max_age(
                            apply_default_path(
                                parse_set_cookie(cookie_value), cookie_value,
                                request.url.path
                            ),
                            cookie_value, now
                        )
                        val _ = cookie_store.store_from_origin(
                            cookie, target_origin, now, partition_key
                        )
            self.cookie_store = cookie_store

        # Step 7: Cache the response if eligible
        if request_cache_eligible(request) and is_cacheable(validated):
            self.logger.debug("fetch: caching response for {request.url.to_text()}")
            val _ = self.cache.store(
                request.url.to_text(), validated.body, validated.headers
            )

        Ok(validated)

    fn validate_response_policy(
        request: FetchRequest, response: FetchResponse
    ) -> Result<FetchResponse, BrowserError>:
        # Step 5: CORS response validation (for Cors mode)
        match request.mode:
            RequestMode.Cors:
                if not self.cors.is_same_origin(request.url):
                    val preflight_result = self.cors.validate_response(response.headers, request.credentials)
                    match preflight_result:
                        PreflightResult.Denied:
                            return Err(network_error("CORS response validation failed"))
                        _:
                            pass_do_nothing
            _:
                pass_do_nothing

        Ok(response)

    # Internal fetch loop that follows redirects up to max_redirects.
    # Each redirect decrements the remaining count and constructs a new request
    # targeting the Location header URL.
    me fetch_with_redirect(
        request: FetchRequest, redirect_count: i64, deadline_ms: i64
    ) -> Result<FetchResponse, BrowserError>:
        if h1_deadline_expired(deadline_ms):
            return Err(network_error(
                "h1: aggregate request deadline exceeded"
            ))
        if redirect_count > self.max_redirects:
            self.logger.error("fetch: exceeded maximum redirects ({self.max_redirects})")
            return Err(network_error("Too many redirects (max: {self.max_redirects})"))

        # Step 3a: Resolve DNS for the target host
        val url = request.url
        val addresses = self.dns.resolve(url.host)?

        if addresses.is_empty():
            return Err(network_error("DNS resolution returned no addresses for {url.host}"))

        val target_addr = addresses.get(0).unwrap_or("127.0.0.1")
        self.logger.debug("fetch: resolved {url.host} -> {target_addr}")

        # Step 3b: Attach cookies to the request
        val request_with_cookies = self.attach_cookies(request)

        # Step 3c: Perform the actual HTTP request
        val response = self.execute_http(request_with_cookies, target_addr)?

        # Step 3d: CORS response validation (for Cors mode)
        match request.mode:
            RequestMode.Cors:
                self.cors.check(request, response.headers)?
            _:
                pass_do_nothing

        # Step 3e: Store cookies from Set-Cookie response headers
        for line in response.headers.split("\r\n"):
            val lower_line = line.to_lower()
            if lower_line.starts_with("set-cookie:"):
                val cookie_value = line.slice(11, line.len()).trim()
                val cookie = parse_set_cookie(cookie_value)
                self.cookie_store.store(cookie)

        # Step 3f: Handle redirects (301, 302, 303, 307, 308)
        if should_redirect(response.status):
            val location = self.get_header(response.headers, "location")
            if val loc = location:
                self.logger.info("fetch: redirect {response.status} -> {loc}")
                val redirect_url = self.resolve_redirect_url(request.url, loc)
                val redirect_request = self.create_redirect_request(request, redirect_url, response.status)
                return self.fetch_with_redirect(redirect_request, redirect_count + 1)
            else:
                self.logger.warn("fetch: redirect status {response.status} but no Location header")

        # Step 3g: Cache the response if eligible
        if is_cacheable(response):
            self.logger.debug("fetch: caching response for {request.url.to_text()}")
            self.cache.store(request, response)

        Ok(response)

    # Execute the CORS preflight sequence if needed.
    # Returns true if the request is allowed, false if denied.
    me handle_cors_preflight(
        request: FetchRequest, deadline_ms: i64 = 0
    ) -> Result<bool, BrowserError>:
        val plan = self.build_cors_preflight(request)
        if plan.preflight_request == nil:
            self.logger.debug("fetch: no preflight needed")
            return Ok(true)

        self.logger.info("fetch: sending CORS preflight for {request.url.to_text()}")
        val preflight_req = self.cors.create_preflight(request)

        # Resolve DNS for preflight (same host)
        val addresses = self.dns.resolve(request.url.host)?
        val target_addr = addresses.get(0).unwrap_or("127.0.0.1")

        # Send the OPTIONS preflight
        val preflight_response = self.execute_http(preflight_req, target_addr)?

        # Validate the preflight response
        val result = self.cors.validate_preflight(preflight_response, request)
        match result:
            PreflightResult.Allowed:
                self.logger.debug("fetch: CORS preflight allowed")
                Ok(true)
            PreflightResult.Denied(reason):
                self.logger.warn("fetch: CORS preflight denied: {reason}")
                Ok(false)

    # Attach stored cookies to the request as a Cookie header.
    # NOTE: FetchRequest.headers/credentials are declared as raw `text`
    # (see entity/request_types.spl), not [Pair]/enum — this must stay
    # text-in, text-out or it corrupts the header block on redirects.
    fn attach_cookies(request: FetchRequest) -> FetchRequest:
        # Only attach cookies if credentials mode allows it
        val should_send = match request.credentials:
            RequestCredentials.Omit: false
            RequestCredentials.SameOrigin: true
            RequestCredentials.Include: true

        if not should_send:
            return request

        # CookieStore exposes the already-formatted "name=value; name2=value2"
        # header text via get_header(host, path) — there is no
        # get_cookies_for(Url) method (a prior version of this call site
        # referenced one that was never defined; that would throw as soon
        # as any non-Omit credentials mode reached this code).
        val cookie_header = self.cookie_store.get_header(request.url.host, request.url.path)
        if cookie_header.len() == 0:
            return request

        # Append Cookie header to the request
        var new_headers: [Pair<text, text>] = []
        for h in request.headers:
            new_headers.push(h)
        new_headers.push(Pair("Cookie", cookie_header))

        FetchRequest(
            url: request.url,
            method: request.method,
            headers: new_headers,
            body: request.body,
            mode: request.mode,
            credentials: request.credentials
        )

    # Perform the actual HTTP request over the network.
    # Routes through the H1 client which supports mock registry and plain HTTP TCP.
    me execute_http(
        request: FetchRequest, deadline_ms: i64 = 0
    ) -> Result<FetchResponse, BrowserError>:
        self.logger.debug("fetch: HTTP {request.method.to_upper()} for {request.url.to_text()}")

        # Build a temporary H1 client to handle the request.
        # The H1 client checks the mock registry first, then uses real plain HTTP TCP.
        val tls_config = default_tls_config()
        var tls_mgr = TlsManager.new(self.logger, tls_config)
        var h1 = H1Client.new(self.logger, self.dns, tls_mgr)
        val response = h1.request(request)?
        Ok(response)

    # Resolve a redirect Location URL against the original request URL.
    # Handles both absolute URLs and relative paths.
    fn resolve_redirect_url(base: Url, location: text) -> Url:
        # Absolute URL (starts with scheme://)
        if location.contains("://"):
            return Url.parse(location)

        # Protocol-relative URL (starts with //)
        if location.starts_with("//"):
            return Url.parse("{base.scheme}:{location}")

        # Absolute path (starts with /)
        if location.starts_with("/"):
            return Url.create(base.scheme, base.host, base.port, location)

        # Relative path — resolve against the base path
        val base_dir = if base.path.contains("/"):
            val last_slash = base.path.last_index_of("/")
            base.path.substring(0, last_slash + 1)
        else:
            "/"
        val resolved_path = "{base_dir}{location}"
        Url.create(base.scheme, base.host, base.port, resolved_path)

    # Create a new request for a redirect, adjusting the method per HTTP semantics.
    # 303 always becomes GET; 301/302 become GET for POST; 307/308 preserve method.
    fn create_redirect_request(original: FetchRequest, new_url: Url, status: i64) -> FetchRequest:
        val redirect_method = if status == 303:
            # 303 See Other: always use GET
            HttpMethod.Get
        else if status == 301 or status == 302:
            # 301/302: POST becomes GET (historical browser behavior), others preserved
            match original.method:
                HttpMethod.Post: HttpMethod.Get
                _: original.method
        else:
            # 307/308: preserve original method
            original.method

        val redirect_body = match redirect_method:
            HttpMethod.Get: ""
            HttpMethod.Head: ""
            _: original.body

        # Strip sensitive headers on cross-origin redirect
        val original_origin = Origin.from_url(original.url)
        val new_origin = Origin.from_url(new_url)
        val is_cross_origin = (original_origin.to_text() != new_origin.to_text())

        var new_headers = ""
        for line in original.headers.split("\r\n"):
            val colon = line.index_of(":")
            if colon > 0:
                val name = line.slice(0, colon).trim().to_lower()
                # Strip Authorization and Cookie headers on cross-origin redirects
                if is_cross_origin and (name == "authorization" or name == "cookie"):
                    pass_do_nothing
                else:
                    new_headers = new_headers + line.trim() + "\r\n"

        FetchRequest(
            url: new_url,
            method: redirect_method,
            headers: new_headers,
            body: redirect_body,
            mode: original.mode,
            credentials: original.credentials
        )

    # Extract a header value by name (case-insensitive) from a header list.
    fn get_header(headers: [Pair<text, text>], name: text) -> text?:
        val lower_name = name.to_lowercase()
        for header in headers:
            if header.first.to_lowercase() == lower_name:
                return header.second
        nil

# -- Module-level functions --

# Determine whether cookies should be attached for a request's credentials
# mode. FetchRequest.credentials is raw `text` (doc convention:
# "omit"/"same-origin"/"include"); tolerate the enum's own to_text() form
# ("RequestCredentials::Omit") since some callers assign the enum value
# directly into the text field. Only an explicit "omit" suppresses cookies.
fn credentials_allows_cookies(value: text) -> bool:
    # Some callers store the RequestCredentials enum itself in this
    # nominally-`text` field; stringify defensively before inspecting it.
    var v = "{value}"
    if v.contains("::"):
        val idx = v.last_index_of(":")
        v = v.slice(idx + 1, v.len())
    v.to_lower() != "omit"

# Determine whether an HTTP status code indicates a redirect.
fn should_redirect(status: i64) -> bool:
    status == 301 or status == 302 or status == 303 or status == 307 or status == 308

# Determine whether a response is eligible for HTTP caching.
# Checks status code, Cache-Control, and Vary headers.
fn is_cacheable(response: FetchResponse) -> bool:
    # Only cache successful responses
    if response.status < 200 or response.status >= 300:
        return false

    # Check Cache-Control for no-store directive
    for header in response.headers:
        if header.first.to_lowercase() == "cache-control":
            val value = header.second.to_lowercase()
            if value.contains("no-store"):
                return false
            if value.contains("no-cache"):
                return false

    # Only cache GET/HEAD responses
    # (we cannot check the method from the response alone, so cache all
    # successful responses and let the cache layer handle method matching)
    true

# Convert an HttpMethod to its text representation.
# Create a default TLS configuration for use by the fetch transport.
fn default_tls_config() -> TlsConfig:
    TlsConfig(
        min_version: TlsVersion.Tls13,
        verify_peer: true,
        sni_hostname: "",
        root_store: [[]],
        enable_x25519_mlkem768: false,
        require_x25519_mlkem768: false
    )
