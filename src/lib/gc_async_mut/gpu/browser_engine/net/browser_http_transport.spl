"""
# Browser HTTP transport

Renderer-neutral adapter from `NetDelegate` / `FetchDispatch` to the canonical
HTTP/1 client.  This module owns no socket and implements no private HTTP
parser: `H1Client` remains the owner of DNS, TCP, TLS, wire serialization, and
response parsing.

The renderer-facing interfaces cannot return `Result`, so a transport failure
is represented by their documented status-zero response and retained as typed
`last_failure` state for callers that need the reason.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{
    FetchRequest, FetchResponse, RequestMode
}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Url}
use std.gc_async_mut.gpu.browser_engine.net.entity.tls_types.{
    TlsConfig, TlsVersion, hosted_system_root_store
}
use std.gc_async_mut.gpu.browser_engine.net.h1_client.{H1Client}
use std.gc_async_mut.gpu.browser_engine.net.dns.{DnsResolver}
use std.gc_async_mut.gpu.browser_engine.net.tls.{TlsManager}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{
    Logger, BrowserLogLevel
}

pub class BrowserTransportFailure:
    operation: text
    url: text
    message: text

pub class BrowserHttpTransport:
    h1: H1Client
    last_failure: BrowserTransportFailure?

    static fn new() -> BrowserHttpTransport:
        val logger = Logger.new("browser-http", BrowserLogLevel.Warn)
        val tls_config = TlsConfig(
            min_version: TlsVersion.Tls13,
            verify_peer: true,
            sni_hostname: "",
            root_store: hosted_system_root_store(),
            enable_x25519_mlkem768: false,
            require_x25519_mlkem768: false
        )
        BrowserHttpTransport(
            h1: H1Client.new(
                logger,
                DnsResolver.new(logger, 300),
                TlsManager.new(logger, tls_config)
            ),
            last_failure: nil
        )

    static fn with_client(h1: H1Client) -> BrowserHttpTransport:
        """Inject the canonical client for deterministic transport tests."""
        BrowserHttpTransport(h1: h1, last_failure: nil)

    me fn navigate(url: Url) -> FetchResponse:
        val request = FetchRequest(
            method: "GET",
            url: url,
            headers: "",
            body: [],
            mode: RequestMode.Navigate,
            credentials: "same-origin"
        )
        self._send("navigate", request)

    me fn fetch(request: FetchRequest) -> FetchResponse:
        self._send("fetch", request)

    me fn dispatch(request: FetchRequest) -> FetchResponse:
        """Allow the same adapter to satisfy the script FetchDispatch seam."""
        self._send("dispatch", request)

    fn failure() -> BrowserTransportFailure?:
        self.last_failure

    me _send(operation: text, request: FetchRequest) -> FetchResponse:
        self.last_failure = nil
        match self.h1.request(request):
            Ok(response):
                response
            Err(error):
                self.last_failure = Some(BrowserTransportFailure(
                    operation: operation,
                    url: request.url.to_text(),
                    message: error.message
                ))
                FetchResponse(status: 0, headers: "", body: [])
