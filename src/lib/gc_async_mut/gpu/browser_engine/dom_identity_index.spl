# Generation-qualified DOM identity and association owner.

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_limits.{
    HTML_MAX_TREE_DEPTH, HTML_MAX_NODES
}
use std.common.encoding.utf8.{text_byte_len}

val DOM_ROUTE_TEXT_MAX_BYTES: i64 = 52
val DOM_LAYOUT_PATH_MAX_BYTES: i64 = (
    5 + HTML_MAX_TREE_DEPTH.to_i64() * 11 - 1
)

class DomDocumentGeneration:
    value: i64

    static fn create(value: i64) -> Result<DomDocumentGeneration, text>:
        if value <= 0:
            return Err("invalid_generation")
        Ok(DomDocumentGeneration(value: value))

    fn next() -> Result<DomDocumentGeneration, text>:
        if self.value >= 9223372036854775807:
            return Err("generation_exhausted")
        DomDocumentGeneration.create(self.value + 1)

class DomNodeRoute:
    generation: DomDocumentGeneration
    node_id: i64

class DomRadioGroupKey:
    generation: DomDocumentGeneration
    form_owner: DomNodeRoute?
    name: text

class DomIdentityIndexCounters:
    pass_count: i32
    build_visit_count: i64
    node_count: i64
    duplicate_author_id_count: i64
    resolved_association_count: i64
    unresolved_association_count: i64
    layout_relation_count: i64

class _DomIdentityEntry:
    route: DomNodeRoute
    parent_route: DomNodeRoute?
    child_ordinal: i32
    layout_parent_route: DomNodeRoute?
    layout_ordinal: i32
    tag_name: text
    author_id: text
    form_reference: text
    label_for: text
    radio_name: text
    input_type: text
    nearest_form_route: DomNodeRoute?
    nearest_label_route: DomNodeRoute?

class _DomIdentityBuildFrame:
    node: BeDomNode
    parent_route: DomNodeRoute?
    child_ordinal: i32
    depth: i32
    nearest_form_route: DomNodeRoute?
    nearest_label_route: DomNodeRoute?
    layout_parent_route: DomNodeRoute?
    layout_ordinal: i32
    layout_enabled: bool

class DomIdentityIndex:
    generation: DomDocumentGeneration
    entries: [_DomIdentityEntry]
    route_indices: Dict<text, i32>
    author_route_indices: Dict<text, i32>
    layout_route_indices: Dict<text, i32>
    form_owner_indices: Dict<text, i32>
    label_control_indices: Dict<text, i32>
    radio_group_indices_by_route: Dict<text, i32>
    radio_group_indices_by_key: Dict<text, i32>
    radio_groups: [DomRadioGroupKey]
    radio_group_members: [[DomNodeRoute]]
    body_route: DomNodeRoute?
    counters: DomIdentityIndexCounters

    fn _entry_index(route: DomNodeRoute) -> i32:
        if route.generation.value != self.generation.value:
            return -1
        self.route_indices.get(_dom_route_key(route)) ?? -1

    fn contains_route(route: DomNodeRoute) -> bool:
        self._entry_index(route) >= 0

    fn route_for_author_id(author_id: text) -> DomNodeRoute?:
        if author_id == "":
            return nil
        val index = self.author_route_indices.get(author_id) ?? -1
        if index < 0 or index >= self.entries.len():
            return nil
        Some(self.entries[index].route)

    fn author_id_for_route(route: DomNodeRoute) -> text?:
        val index = self._entry_index(route)
        if index < 0:
            return nil
        val author_id = self.entries[index].author_id
        if author_id == "":
            return nil
        Some(author_id)

    fn path_for_route(route: DomNodeRoute) -> [i32]?:
        var index = self._entry_index(route)
        if index < 0:
            return nil
        var reversed: [i32] = []
        var remaining = HTML_MAX_TREE_DEPTH
        while index >= 0 and remaining > 0:
            val entry = self.entries[index]
            if val Some(parent) = entry.parent_route:
                reversed.push(entry.child_ordinal)
                index = self._entry_index(parent)
                if index < 0:
                    return nil
            else:
                index = -1
            remaining = remaining - 1
        if remaining <= 0 and index >= 0:
            return nil
        var path: [i32] = []
        var reverse_index = reversed.len() - 1
        while reverse_index >= 0:
            path.push(reversed[reverse_index])
            reverse_index = reverse_index - 1
        Some(path)

    fn event_path_for_route(route: DomNodeRoute) -> [DomNodeRoute]:
        var index = self._entry_index(route)
        if index < 0:
            return []
        var reversed: [DomNodeRoute] = []
        var remaining = HTML_MAX_TREE_DEPTH
        while index >= 0 and remaining > 0:
            val entry = self.entries[index]
            reversed.push(entry.route)
            if val Some(parent) = entry.parent_route:
                index = self._entry_index(parent)
                if index < 0:
                    return []
            else:
                index = -1
            remaining = remaining - 1
        if remaining <= 0 and index >= 0:
            return []
        var path: [DomNodeRoute] = []
        var reverse_index = reversed.len() - 1
        while reverse_index >= 0:
            path.push(reversed[reverse_index])
            reverse_index = reverse_index - 1
        path

    fn form_owner_for_route(route: DomNodeRoute) -> DomNodeRoute?:
        val owner_index = self.form_owner_indices.get(
            _dom_route_key_checked(self, route)
        ) ?? -1
        if owner_index < 0 or owner_index >= self.entries.len():
            return nil
        Some(self.entries[owner_index].route)

    fn control_for_label_route(route: DomNodeRoute) -> DomNodeRoute?:
        val control_index = self.label_control_indices.get(
            _dom_route_key_checked(self, route)
        ) ?? -1
        if control_index < 0 or control_index >= self.entries.len():
            return nil
        Some(self.entries[control_index].route)

    fn radio_group_for_route(route: DomNodeRoute) -> DomRadioGroupKey?:
        val group_index = self.radio_group_indices_by_route.get(
            _dom_route_key_checked(self, route)
        ) ?? -1
        if group_index < 0 or group_index >= self.radio_groups.len():
            return nil
        Some(self.radio_groups[group_index])

    fn radio_members(group: DomRadioGroupKey) -> [DomNodeRoute]:
        if group.generation.value != self.generation.value:
            return []
        val group_index = self.radio_group_indices_by_key.get(
            _dom_radio_group_key(group)
        ) ?? -1
        if group_index < 0 or group_index >= self.radio_group_members.len():
            return []
        self.radio_group_members[group_index]

    fn route_for_layout_target_key(
        target_key: text
    ) -> Result<DomNodeRoute, text>:
        if target_key.starts_with("id:"):
            val author_id = target_key.slice(3, target_key.len())
            if author_id == "":
                return Err("invalid_target")
            if val Some(route) = self.route_for_author_id(author_id):
                return Ok(route)
            return Err("target_not_found")
        if not target_key.starts_with("path:"):
            return Err("invalid_target")
        if text_byte_len(target_key) > DOM_LAYOUT_PATH_MAX_BYTES:
            return Err("invalid_target")
        val path_text = target_key.slice(5, target_key.len())
        val body = match self.body_route:
            Some(route): route
            nil: return Err("target_not_found")
        if path_text == "":
            return Ok(body)
        val parts = path_text.split("/")
        if parts.len() > HTML_MAX_TREE_DEPTH:
            return Err("invalid_target")
        var current = body
        for part in parts:
            val ordinal = match _dom_parse_canonical_ordinal(part):
                Some(value): value
                nil: return Err("invalid_target")
            val child_index = self.layout_route_indices.get(
                _dom_layout_key(current, ordinal)
            ) ?? -1
            if child_index < 0 or child_index >= self.entries.len():
                return Err("target_not_found")
            current = self.entries[child_index].route
        Ok(current)

    fn layout_target_key_for_route(route: DomNodeRoute) -> text?:
        var entry_index = self._entry_index(route)
        if entry_index < 0:
            return nil
        val body = match self.body_route:
            Some(value): value
            nil: return nil
        var reversed: [text] = []
        var remaining = HTML_MAX_TREE_DEPTH
        while remaining > 0:
            val entry = self.entries[entry_index]
            if entry.route.node_id == body.node_id:
                var parts: [text] = []
                var reverse_index = reversed.len() - 1
                while reverse_index >= 0:
                    parts.push(reversed[reverse_index])
                    reverse_index = reverse_index - 1
                return Some("path:" + parts.join("/"))
            val parent = match entry.layout_parent_route:
                Some(value): value
                nil: return nil
            if entry.layout_ordinal < 0:
                return nil
            reversed.push(entry.layout_ordinal.to_text())
            entry_index = self._entry_index(parent)
            if entry_index < 0:
                return nil
            remaining = remaining - 1
        nil

fn _dom_route_key(route: DomNodeRoute) -> text:
    route.node_id.to_text()

fn _dom_route_key_checked(index: DomIdentityIndex, route: DomNodeRoute) -> text:
    if route.generation.value != index.generation.value:
        return ""
    _dom_route_key(route)

fn _dom_layout_key(parent: DomNodeRoute, ordinal: i32) -> text:
    parent.node_id.to_text() + ":" + ordinal.to_text()

fn _dom_attr(node: BeDomNode, name: text) -> text:
    node.attributes.get(name) ?? ""

fn _dom_radio_group_key(group: DomRadioGroupKey) -> text:
    val owner_id = match group.form_owner:
        Some(route): route.node_id
        nil: 0
    group.generation.value.to_text() + ":" + owner_id.to_text() + ":" + group.name

fn _dom_layout_element(node: BeDomNode) -> bool:
    (
        node.tag_name != "#text" and node.tag_name != "style" and
        node.tag_name != "script" and node.tag_name != "title" and
        node.tag_name != "head" and node.tag_name != "meta" and
        node.tag_name != "link" and node.tag_name != "base"
    )

fn _dom_form_associated(tag_name: text) -> bool:
    (
        tag_name == "button" or tag_name == "fieldset" or
        tag_name == "input" or tag_name == "object" or
        tag_name == "output" or tag_name == "select" or
        tag_name == "textarea"
    )

fn _dom_labelable(entry: _DomIdentityEntry) -> bool:
    if entry.tag_name == "input" and entry.input_type == "hidden":
        return false
    (
        entry.tag_name == "button" or entry.tag_name == "input" or
        entry.tag_name == "meter" or entry.tag_name == "output" or
        entry.tag_name == "progress" or entry.tag_name == "select" or
        entry.tag_name == "textarea"
    )

fn _dom_parse_canonical_positive(value: text) -> i64?:
    if value == "" or (value.len() > 1 and value.starts_with("0")):
        return nil
    if val Some(parsed) = value.parse_i64():
        if parsed > 0 and parsed.to_text() == value:
            return Some(parsed)
    nil

fn _dom_parse_canonical_ordinal(value: text) -> i32?:
    if value == "" or (value.len() > 1 and value.starts_with("0")):
        return nil
    if val Some(parsed) = value.parse_i64():
        if parsed >= 0 and parsed <= 2147483647 and parsed.to_text() == value:
            return Some(parsed.to_i32())
    nil

fn dom_node_route_text(route: DomNodeRoute) -> text:
    "dom-route-v1:" + route.generation.value.to_text() + ":" + route.node_id.to_text()

fn dom_node_route_parse(value: text) -> Result<DomNodeRoute, text>:
    if text_byte_len(value) > DOM_ROUTE_TEXT_MAX_BYTES:
        return Err("invalid_route")
    val parts = value.split(":")
    if parts.len() != 3 or parts[0] != "dom-route-v1":
        return Err("invalid_route")
    val generation_value = match _dom_parse_canonical_positive(parts[1]):
        Some(parsed): parsed
        nil: return Err("invalid_route")
    val node_id = match _dom_parse_canonical_positive(parts[2]):
        Some(parsed): parsed
        nil: return Err("invalid_route")
    val generation = match DomDocumentGeneration.create(generation_value):
        Ok(valid): valid
        Err(_): return Err("invalid_route")
    Ok(DomNodeRoute(generation: generation, node_id: node_id))

fn dom_identity_index_build(
    root: BeDomNode, generation: DomDocumentGeneration
) -> Result<DomIdentityIndex, text>:
    if generation.value <= 0:
        return Err("invalid_generation")
    var entries: [_DomIdentityEntry] = []
    var route_indices: Dict<text, i32> = {}
    var author_route_indices: Dict<text, i32> = {}
    var layout_route_indices: Dict<text, i32> = {}
    var duplicate_author_id_count: i64 = 0
    var layout_relation_count: i64 = 0
    var body_route: DomNodeRoute? = nil
    var stack: [_DomIdentityBuildFrame] = [
        _DomIdentityBuildFrame(
            node: root,
            parent_route: nil,
            child_ordinal: -1,
            depth: 0,
            nearest_form_route: nil,
            nearest_label_route: nil,
            layout_parent_route: nil,
            layout_ordinal: -1,
            layout_enabled: false
        )
    ]
    while stack.len() > 0:
        val frame = stack.pop()
        if frame.depth >= HTML_MAX_TREE_DEPTH:
            return Err("tree_depth_exceeded")
        if entries.len() >= HTML_MAX_NODES:
            return Err("node_limit_exceeded")
        if frame.node.node_id <= 0:
            return Err("invalid_node_id")
        val route = DomNodeRoute(
            generation: generation, node_id: frame.node.node_id
        )
        val route_key = _dom_route_key(route)
        # contains_key, not `.get()` guard: `if val Some(_) = dict.get(key)`
        # never matches under the current engine (see .claude/rules/
        # code-style.md, Native-Codegen Dict Pitfalls), leaving duplicate
        # detection dead.
        if route_indices.contains_key(route_key):
            return Err("duplicate_node_id")
        val author_id = _dom_attr(frame.node, "id")
        val entry_index = entries.len().to_i32()
        entries.push(
            _DomIdentityEntry(
                route: route,
                parent_route: frame.parent_route,
                child_ordinal: frame.child_ordinal,
                layout_parent_route: frame.layout_parent_route,
                layout_ordinal: frame.layout_ordinal,
                tag_name: frame.node.tag_name,
                author_id: author_id,
                form_reference: _dom_attr(frame.node, "form"),
                label_for: _dom_attr(frame.node, "for"),
                radio_name: _dom_attr(frame.node, "name"),
                input_type: _dom_attr(frame.node, "type").lower(),
                nearest_form_route: frame.nearest_form_route,
                nearest_label_route: frame.nearest_label_route
            )
        )
        route_indices[route_key] = entry_index
        if author_id != "":
            # contains_key keeps the stated first-wins binding: a duplicate
            # author id only bumps the counter and never rebinds the route.
            if author_route_indices.contains_key(author_id):
                duplicate_author_id_count = duplicate_author_id_count + 1
            else:
                author_route_indices[author_id] = entry_index
        if frame.layout_enabled:
            if val Some(layout_parent) = frame.layout_parent_route:
                layout_route_indices[
                    _dom_layout_key(layout_parent, frame.layout_ordinal)
                ] = entry_index
                layout_relation_count = layout_relation_count + 1
        val current_layout_enabled = if (
            frame.node.tag_name == "body" and body_route == nil
        ):
            body_route = Some(route)
            true
        else:
            frame.layout_enabled
        val child_form_route = if frame.node.tag_name == "form":
            Some(route)
        else:
            frame.nearest_form_route
        val child_label_route = if frame.node.tag_name == "label":
            Some(route)
        else:
            frame.nearest_label_route
        var layout_child_count = 0
        if current_layout_enabled:
            for child in frame.node.children:
                if _dom_layout_element(child):
                    layout_child_count = layout_child_count + 1
        var child_index = frame.node.children.len() - 1
        while child_index >= 0:
            val child = frame.node.children[child_index]
            val child_layout_enabled = (
                current_layout_enabled and _dom_layout_element(child)
            )
            var child_layout_ordinal = -1
            if child_layout_enabled:
                layout_child_count = layout_child_count - 1
                child_layout_ordinal = layout_child_count
            stack.push(
                _DomIdentityBuildFrame(
                    node: child,
                    parent_route: Some(route),
                    child_ordinal: child_index.to_i32(),
                    depth: frame.depth + 1,
                    nearest_form_route: child_form_route,
                    nearest_label_route: child_label_route,
                    layout_parent_route: if child_layout_enabled:
                        Some(route)
                    else:
                        nil,
                    layout_ordinal: child_layout_ordinal,
                    layout_enabled: child_layout_enabled
                )
            )
            child_index = child_index - 1

    var form_owner_indices: Dict<text, i32> = {}
    var label_control_indices: Dict<text, i32> = {}
    var radio_group_indices_by_route: Dict<text, i32> = {}
    var radio_group_indices_by_key: Dict<text, i32> = {}
    var radio_groups: [DomRadioGroupKey] = []
    var radio_group_members: [[DomNodeRoute]] = []
    var resolved_association_count: i64 = 0
    var unresolved_association_count: i64 = 0
    var pass_two_index = 0
    while pass_two_index < entries.len():
        val entry = entries[pass_two_index]
        var form_owner: DomNodeRoute? = nil
        if _dom_form_associated(entry.tag_name):
            if entry.form_reference != "":
                val referenced_index = author_route_indices.get(
                    entry.form_reference
                ) ?? -1
                if (
                    referenced_index >= 0 and
                    entries[referenced_index].tag_name == "form"
                ):
                    form_owner = Some(entries[referenced_index].route)
                    resolved_association_count = resolved_association_count + 1
                else:
                    unresolved_association_count = unresolved_association_count + 1
            elif val Some(ancestor_form) = entry.nearest_form_route:
                form_owner = Some(ancestor_form)
                resolved_association_count = resolved_association_count + 1
            if val Some(owner) = form_owner:
                form_owner_indices[_dom_route_key(entry.route)] = (
                    route_indices.get(_dom_route_key(owner)) ?? -1
                )

        if entry.tag_name == "label" and entry.label_for != "":
            val control_index = author_route_indices.get(entry.label_for) ?? -1
            if control_index >= 0 and _dom_labelable(entries[control_index]):
                label_control_indices[_dom_route_key(entry.route)] = control_index
                resolved_association_count = resolved_association_count + 1
            else:
                unresolved_association_count = unresolved_association_count + 1
        elif _dom_labelable(entry):
            if val Some(label_route) = entry.nearest_label_route:
                val label_index = route_indices.get(
                    _dom_route_key(label_route)
                ) ?? -1
                if (
                    label_index >= 0 and entries[label_index].label_for == "" and
                    (label_control_indices.get(
                        _dom_route_key(label_route)
                    ) ?? -1) < 0
                ):
                    label_control_indices[_dom_route_key(label_route)] = pass_two_index
                    resolved_association_count = resolved_association_count + 1

        if (
            entry.tag_name == "input" and entry.input_type == "radio" and
            entry.radio_name != ""
        ):
            val group = DomRadioGroupKey(
                generation: generation,
                form_owner: form_owner,
                name: entry.radio_name
            )
            val group_key = _dom_radio_group_key(group)
            var group_index = radio_group_indices_by_key.get(group_key) ?? -1
            if group_index < 0:
                group_index = radio_groups.len().to_i32()
                radio_group_indices_by_key[group_key] = group_index
                radio_groups.push(group)
                radio_group_members.push([])
            radio_group_indices_by_route[
                _dom_route_key(entry.route)
            ] = group_index
            radio_group_members[group_index].push(entry.route)
        pass_two_index = pass_two_index + 1

    Ok(DomIdentityIndex(
        generation: generation,
        entries: entries,
        route_indices: route_indices,
        author_route_indices: author_route_indices,
        layout_route_indices: layout_route_indices,
        form_owner_indices: form_owner_indices,
        label_control_indices: label_control_indices,
        radio_group_indices_by_route: radio_group_indices_by_route,
        radio_group_indices_by_key: radio_group_indices_by_key,
        radio_groups: radio_groups,
        radio_group_members: radio_group_members,
        body_route: body_route,
        counters: DomIdentityIndexCounters(
            pass_count: 2,
            build_visit_count: entries.len() * 2,
            node_count: entries.len(),
            duplicate_author_id_count: duplicate_author_id_count,
            resolved_association_count: resolved_association_count,
            unresolved_association_count: unresolved_association_count,
            layout_relation_count: layout_relation_count
        )
    ))

export DomDocumentGeneration, DomNodeRoute, DomRadioGroupKey
export DomIdentityIndexCounters, DomIdentityIndex
export dom_identity_index_build, dom_node_route_text, dom_node_route_parse
