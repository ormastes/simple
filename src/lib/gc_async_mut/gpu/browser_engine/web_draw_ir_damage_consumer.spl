# Canonical Web DrawIR damage consumer.
#
# This adapter owns no WebIR, tiles, GPU cache, or presentation state. It
# turns the shared composition comparison into the one Engine2D clipped-DrawIR
# execution entry point and preserves full-frame fallback provenance.

use common.ui.draw_ir.{DrawIrComposition}
use common.ui.render_opt.composition_damage.{composition_damage_between}
use common.ui.render_opt.damage_plan.{
    DAMAGE_PLAN_FULL, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_NONE
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dDrawIrAdvResult,
    Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_with_images,
    engine2d_draw_ir_render_composition_damaged_with_images
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

class WebDrawIrDamageConsumerResult:
    engine: Engine2D
    result: Engine2dDrawIrAdvResult
    # This is the execution owner's plan, not the Web producer's provisional
    # decision.  A presentation owner can therefore transfer exactly the
    # rects that survived DrawIR safety validation, or the explicit viewport
    # fallback when resources, batch replay, or clipping are unsafe.
    effective_plan_mode: i64
    effective_plan_rects: [i64]
    reason: text

fn _web_draw_ir_gpu_backend(selected: text) -> bool:
    selected != "software" and selected != "cpu" and selected != "cpu_simd"

fn web_draw_ir_consume_damage(
    engine: Engine2D,
    prior: DrawIrComposition,
    current: DrawIrComposition,
    images: [Engine2dResolvedDrawIrImage],
    viewport_stable: bool,
    resources_stable: bool
) -> WebDrawIrDamageConsumerResult:
    val decision = composition_damage_between(
        prior, current, engine.width(), engine.height(),
        viewport_stable, resources_stable)
    var effective_plan_mode = DAMAGE_PLAN_FULL
    var effective_plan_rects: [i64] = []
    var effective_reason = decision.reason
    # NONE is valid only for the exact retained decision.  Any discrepancy
    # between the producer decision and execution result fails closed to a
    # whole-surface update; never hand a direct presenter stale retained data.
    if decision.mode == DAMAGE_PLAN_LOCAL:
        val replay = engine2d_draw_ir_render_composition_damaged_with_images(
            engine, current, images, decision.rects, true)
        val surface_pixels = (
            engine.width().to_i64() * engine.height().to_i64())
        if (
            replay.readback.source != "preflight_rejected" and
            replay.engine.backend_name() == engine.backend_name() and
            replay.readback.pixels.len() == surface_pixels
        ):
            effective_plan_mode = DAMAGE_PLAN_LOCAL
            effective_plan_rects = decision.rects
            val result = Engine2dDrawIrAdvResult(
                schema: current.schema, unit_id: current.composition_id,
                selected_backend: replay.engine.backend_name(),
                fallback_required: false, fallback_reason: "",
                rendered_command_count: replay.ops_rendered,
                skipped_command_count: replay.ops_skipped,
                pixels: replay.readback.pixels,
                readback_source: replay.readback.source,
                backend_handle: replay.readback.backend_handle,
                device_identity: replay.readback.device_identity,
                readback_checksum: replay.readback.checksum)
            return WebDrawIrDamageConsumerResult(
                engine: replay.engine, result: result,
                effective_plan_mode: effective_plan_mode,
                effective_plan_rects: effective_plan_rects,
                reason: effective_reason)
        effective_reason = "{decision.reason}:{replay.unsupported_kinds}"
    # NONE is a caller-owned retained-cache no-op. Any non-local decision, or
    # a local execution rejection, takes the canonical complete renderer and
    # publishes an exact full viewport plan instead of stale pixels.
    val full = engine2d_draw_ir_adv_composition_with_images(
        engine, current, _web_draw_ir_gpu_backend(engine.backend_name()), images)
    if (decision.mode == DAMAGE_PLAN_NONE and not full.fallback_required and
        full.skipped_command_count == 0):
        effective_plan_mode = DAMAGE_PLAN_NONE
    else:
        effective_plan_mode = DAMAGE_PLAN_FULL
        if engine.width() > 0 and engine.height() > 0:
            effective_plan_rects = [
                0, 0, engine.width() as i64, engine.height() as i64]
    WebDrawIrDamageConsumerResult(
        engine: engine, result: full,
        effective_plan_mode: effective_plan_mode,
        effective_plan_rects: effective_plan_rects,
        reason: effective_reason)

export WebDrawIrDamageConsumerResult, web_draw_ir_consume_damage
