# Strict source geometry for the first Web fractional DrawIR producer mode.
# Integer layout supplies only the containing block origin. Leaf geometry is
# parsed again from winning cascade tokens before integer visibility culling.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{HNode}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{Style}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_layout_foundation.{LayoutResult}
use std.gc_async_mut.gpu.browser_engine.simple_web_box_geometry_provenance.{
    web_box_geometry_tokens_reason}

class WebFractionalLeafRect:
    node_index: i32
    x: f64
    y: f64
    width: f64
    height: f64
    translate_x: f64 = 0.0
    translate_y: f64 = 0.0
    rotation_deg: f64 = 0.0
    rotated: bool = false

class WebFractionalSceneResolution:
    leaves: [WebFractionalLeafRect]
    reason: text
    painted_scene_index: i32 = -1
    background_node_indexes: [i32] = []

fn _web_fractional_solid_hex(value: text) -> bool:
    if value == "white":
        return true
    if (value.len() != 7 and value.len() != 4) or
        not value.starts_with("#"):
        return false
    var i = 1
    while i < value.len():
        val code = value.char_code_at(i)
        if not (code >= 48 and code <= 57) and
            not (code >= 97 and code <= 102):
            return false
        i = i + 1
    true

# Unknown declarations may have been ignored by the integer Style parser.
# This list is intentionally smaller than the ordinary Web renderer grammar.
fn _web_fractional_authored_reason(
    st: Style, scene_role: bool = false, transformed_leaf: bool = false
) -> text:
    for entry in st.fractional_authored_decls:
        val parts = entry.split("=")
        if parts.len() < 2:
            return "malformed-authored-declaration"
        val key = parts[0]
        val value = entry.substring(key.len() + 1, entry.len())
        if key == "position":
            if value != "absolute" and value != "relative":
                return "unsupported-position-value"
        elif key == "box-sizing":
            if value != "border-box":
                return "unsupported-box-sizing-value"
        elif key == "background" or key == "background-color":
            if not _web_fractional_solid_hex(value):
                return "unsupported-background-value"
        elif key == "display":
            if value != "block":
                return "unsupported-display-value"
        elif key == "overflow" and scene_role:
            if value != "hidden":
                return "unsupported-scene-overflow"
        elif (key == "color" or key == "font") and scene_role:
            if value == "" or (key == "color" and
                not _web_fractional_solid_hex(value)):
                return "unsupported-scene-inert-text-style"
        elif key == "transform" and transformed_leaf:
            if value != st.transform_raw:
                return "transform-source-mismatch"
        elif key == "width" or key == "height" or
            key == "left" or key == "top":
            continue
        elif key == "margin" or key.starts_with("margin-") or
            key == "padding" or key.starts_with("padding-") or
            key == "border" or key.starts_with("border-") or
            key == "outline" or key.starts_with("outline-"):
            if value != "0" and value != "0px":
                return "nonzero-authored-decoration:{key}"
        else:
            return "unsupported-authored-property:{key}"
    ""

fn _web_fractional_decimal(number: text) -> f64?:
    var i = 0
    if number.starts_with("-") or number.starts_with("+"):
        i = 1
    if i >= number.len():
        return nil
    var digits = 0
    var dots = 0
    while i < number.len():
        val code = number.char_code_at(i)
        if code >= 48 and code <= 57:
            digits = digits + 1
        elif code == 46:
            dots = dots + 1
            if dots > 1:
                return nil
        else:
            return nil
        i = i + 1
    if digits == 0:
        return nil
    val normalized = if number.starts_with("."):
        "0" + number
    elif number.starts_with("-.") or number.starts_with("+."):
        number.substring(0, 1) + "0" +
            number.substring(1, number.len())
    else:
        number
    if val parsed = normalized.parse_f64():
        if parsed == parsed and parsed > -2147483648.0 and
            parsed < 2147483648.0:
            return Some(parsed)
    nil

fn _web_fractional_px(token: text) -> f64?:
    if not token.ends_with("px") or token.len() <= 2:
        return nil
    _web_fractional_decimal(token.substring(0, token.len() - 2))

class WebFractionalRotateTranslate:
    translate_x: f64
    translate_y: f64
    rotation_deg: f64

# Exact two-function grammar. The ordinary Web transform parser can accept a
# prefix of malformed CSS; strict DrawIR must consume the entire winning token.
fn _web_fractional_rotate_translate(raw: text) -> Result<WebFractionalRotateTranslate, text>:
    if not raw.starts_with("translate(") or not raw.ends_with(")"):
        return Err("unsupported-transform-grammar")
    val separator = raw.index_of(") rotate(")
    if separator < 0:
        return Err("unsupported-transform-function-order")
    val arguments = raw.substring(10, separator).split(",")
    if arguments.len() != 2:
        return Err("unsupported-translate-arity")
    val tx = match _web_fractional_px(arguments[0].trim()):
        case Some(value): value
        case nil: return Err("unsupported-translate-x")
    val ty = match _web_fractional_px(arguments[1].trim()):
        case Some(value): value
        case nil: return Err("unsupported-translate-y")
    val rotation_token = raw.substring(separator + 9, raw.len() - 1)
    if not rotation_token.ends_with("deg"):
        return Err("unsupported-rotation-unit")
    val degrees_text = rotation_token.substring(0,
        rotation_token.len() - 3)
    val degrees = match _web_fractional_decimal(degrees_text):
        case Some(value): value
        case nil: return Err("unsupported-rotation-number")
    if degrees != degrees or degrees <= -45.0 or degrees >= 45.0 or
        degrees == 0.0:
        return Err("unsupported-rotation-range")
    Ok(WebFractionalRotateTranslate(
        translate_x: tx, translate_y: ty, rotation_deg: degrees))

fn _web_fractional_neutral(
    st: Style, allow_scene_overflow: bool = false,
    allow_leaf_transform: bool = false
) -> bool:
    st.opacity_pct == 100 and st.background_image_uri == "" and
        st.bg_layers_raw == "" and st.background_gradient_from == 0u32 and
        st.background_gradient_to == 0u32 and
        st.background_gradient_stop_colors.len() == 0 and
        st.background_gradient_stop_positions.len() == 0 and
        not st.background_gradient_is_radial and
        st.box_shadow_raw == "" and st.box_shadow_color == 0u32 and
        st.box_shadow_blur_px == 0 and st.box_shadow_x_px == 0 and
        st.box_shadow_y_px == 0 and st.backdrop_filter_raw == "" and
        st.border_w == 0 and st.border_l == 0 and st.border_t == 0 and
        st.border_r == 0 and st.border_b == 0 and
        st.border_radius_px == 0 and st.border_radius_tl_px == 0 and
        st.border_radius_tr_px == 0 and st.border_radius_br_px == 0 and
        st.border_radius_bl_px == 0 and st.outline_w == 0 and
        st.outline_offset_px == 0 and st.pad_l == 0 and st.pad_t == 0 and
        st.pad_r == 0 and st.pad_b == 0 and
        (not st.overflow_hidden or allow_scene_overflow) and
        not st.overflow_auto_y and
        not st.overflow_scroll_y and not st.visibility_hidden and
        not st.content_visibility_hidden and st.display == "block" and
        st.float_mode == 0 and
        not st.position_fixed and
        not st.position_sticky and st.z_index == 0 and
        st.transform_style == "flat" and
        st.transform_origin == "center center" and
        st.transform_box == "border-box" and
        (st.transform_raw == "none" or allow_leaf_transform) and
        st.translate_raw == "none" and
        st.scale_raw == "none" and st.rotate_raw == "none" and
        st.animation_name == "none" and st.transition_property == "none" and
        st.text_shadow_x_px == 0 and st.text_shadow_y_px == 0 and
        st.text_shadow_color == 0u32 and
        not st.text_decoration_underline

fn _web_fractional_leaf_tokens(st: Style) -> text:
    var seen_left = false
    var seen_top = false
    var seen_width = false
    var seen_height = false
    for entry in st.box_geometry_raw_tokens:
        val parts = entry.split("=")
        if parts.len() < 2:
            return "malformed-token"
        val key = parts[0]
        val value = entry.substring(key.len() + 1, entry.len())
        if key == "left":
            seen_left = _web_fractional_px(value) != nil
        elif key == "top":
            seen_top = _web_fractional_px(value) != nil
        elif key == "width":
            seen_width = _web_fractional_px(value) != nil
        elif key == "height":
            seen_height = _web_fractional_px(value) != nil
        elif key.starts_with("margin") or key.starts_with("padding") or
            key.starts_with("border") or key == "outline" or
            key == "outline-width" or key == "outline-offset":
            if value != "0" and value != "0px":
                return "nonzero-decoration:{key}"
        else:
            return "competing-box-property:{key}"
    if not seen_left or not seen_top or not seen_width or not seen_height:
        return "missing-or-invalid-explicit-px-geometry"
    ""

fn _web_fractional_token(st: Style, key: text) -> f64?:
    val prefix = "{key}="
    for entry in st.box_geometry_raw_tokens:
        if entry.starts_with(prefix):
            return _web_fractional_px(entry.substring(prefix.len(), entry.len()))
    nil

fn _web_fractional_ancestor_reason(
    nodes: [HNode], styles: [Style], boxes: LayoutResult, parent: i32,
    viewport_width: i32, viewport_height: i32
) -> text:
    if parent < 0 or parent >= nodes.len() or
        not styles[parent].position_relative:
        return "immediate-containing-block-not-relative"
    var current = parent
    while current >= 0 and current < nodes.len():
        val st = styles[current]
        if not _web_fractional_neutral(st) or st.position_absolute or
            st.box_geometry_unresolved or
            web_box_geometry_tokens_reason(st.box_geometry_raw_tokens) != "":
            return "unsupported-containing-ancestor:{current}"
        if nodes[current].tag != "html" and nodes[current].tag != "body" and
            nodes[current].tag != "#root" and st.bg != 0u32:
            return "painted-containing-ancestor:{current}"
        if current == parent and (
            boxes.bw[current] <= 0 or boxes.bh[current] <= 0 or
            boxes.bx[current] < 0 or boxes.by[current] < 0 or
            boxes.bx[current].to_i64() + boxes.bw[current].to_i64() > viewport_width.to_i64() or
            boxes.by[current].to_i64() + boxes.bh[current].to_i64() > viewport_height.to_i64()
        ):
            return "containing-block-outside-viewport:{current}"
        current = nodes[current].parent as i32
    ""

# The result is all-or-nothing. A rejected scene never supplies a partial list
# for the caller to emit, even if earlier leaves were individually resolvable.
fn web_resolve_absolute_px_leaf_boxes(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    viewport_width: i32, viewport_height: i32
) -> WebFractionalSceneResolution:
    var leaves: [WebFractionalLeafRect] = []
    if viewport_width <= 0 or viewport_height <= 0 or
        nodes.len() != styles.len() or nodes.len() != boxes.bx.len():
        return WebFractionalSceneResolution(leaves: [], reason: "invalid-scene-shape")
    var case02_requested = false
    var request_index = 0
    while request_index < nodes.len():
        if nodes[request_index].id_attr == "scene" and
            styles[request_index].overflow_hidden:
            case02_requested = true
        request_index = request_index + 1
    if case02_requested:
        return _web_resolve_fractional_two_leaf_scene(
            nodes, styles, boxes, viewport_width, viewport_height)
    var html_canvas_count = 0
    var body_canvas_count = 0
    var i = 0
    while i < nodes.len():
        val node = nodes[i]
        val st = styles[i]
        if node.tag == "#text":
            if node.text_trimmed != "":
                return WebFractionalSceneResolution(leaves: [], reason: "text-node:{i}")
            i = i + 1
            continue
        if not _web_fractional_neutral(st):
            return WebFractionalSceneResolution(leaves: [], reason: "unsupported-style:{i}")
        val authored_reason = _web_fractional_authored_reason(st)
        if authored_reason != "":
            return WebFractionalSceneResolution(leaves: [], reason: "authored:{i}:{authored_reason}")
        if node.tag != "#root" and node.tag != "html" and
            node.tag != "body" and node.tag != "div":
            return WebFractionalSceneResolution(leaves: [], reason: "unsupported-element-paint:{i}:{node.tag}")
        if node.attrs_raw.contains("data-wm-theme-") or
            node.has_widget_class or node.has_icon_image_class or
            node.has_widget_panel_class or node.has_widget_button_class or
            node.has_widget_image_class:
            return WebFractionalSceneResolution(leaves: [], reason: "unsupported-element-attributes:{i}")
        if not st.position_absolute and st.box_geometry_unresolved:
            return WebFractionalSceneResolution(leaves: [], reason: "unresolved-other-node:{i}")
        if node.tag == "#root" and st.bg != 0u32:
            return WebFractionalSceneResolution(leaves: [], reason: "root-background-not-canvas")
        if node.tag == "html" and st.bg != 0u32:
            if ((st.bg >> 24) & 255u32) != 255u32:
                return WebFractionalSceneResolution(leaves: [], reason: "translucent-html-canvas")
            html_canvas_count = html_canvas_count + 1
        if node.tag == "body" and st.bg != 0u32:
            if ((st.bg >> 24) & 255u32) != 255u32:
                return WebFractionalSceneResolution(leaves: [], reason: "translucent-body-canvas")
            body_canvas_count = body_canvas_count + 1
        if st.position_absolute:
            var child = i + 1
            while child < nodes.len():
                if (nodes[child].parent as i32) == i:
                    return WebFractionalSceneResolution(leaves: [], reason: "absolute-node-not-leaf:{i}")
                child = child + 1
            if not st.border_box or ((st.bg >> 24) & 255u32) != 255u32:
                return WebFractionalSceneResolution(leaves: [], reason: "absolute-leaf-not-opaque-border-box:{i}")
            val token_reason = _web_fractional_leaf_tokens(st)
            if token_reason != "":
                return WebFractionalSceneResolution(leaves: [], reason: "fractional-leaf:{i}:{token_reason}")
            val parent = node.parent as i32
            val ancestor_reason = _web_fractional_ancestor_reason(
                nodes, styles, boxes, parent, viewport_width, viewport_height
            )
            if ancestor_reason != "":
                return WebFractionalSceneResolution(leaves: [], reason: ancestor_reason)
            val left = _web_fractional_token(st, "left") ?? 0.0
            val top = _web_fractional_token(st, "top") ?? 0.0
            val width = _web_fractional_token(st, "width") ?? 0.0
            val height = _web_fractional_token(st, "height") ?? 0.0
            val x = boxes.bx[parent].to_f64() + left
            val y = boxes.by[parent].to_f64() + top
            if width <= 0.0 or height <= 0.0 or x < 0.0 or y < 0.0 or
                x + width > viewport_width.to_f64() or
                y + height > viewport_height.to_f64() or
                x + width <= x or y + height <= y:
                return WebFractionalSceneResolution(leaves: [], reason: "fractional-leaf-outside-viewport:{i}")
            leaves.push(WebFractionalLeafRect(
                node_index: i, x: x, y: y, width: width, height: height
            ))
        elif node.tag != "#root" and node.tag != "html" and
            node.tag != "body":
            if st.bg != 0u32:
                return WebFractionalSceneResolution(leaves: [], reason: "other-painted-node:{i}")
        i = i + 1
    if html_canvas_count > 1 or body_canvas_count > 1 or
        (html_canvas_count > 0 and body_canvas_count > 0):
        return WebFractionalSceneResolution(leaves: [], reason: "multiple-canvas-backgrounds")
    if leaves.len() == 0:
        return WebFractionalSceneResolution(leaves: [], reason: "no-fractional-leaf")
    if leaves.len() != 1:
        return WebFractionalSceneResolution(leaves: [], reason: "multiple-fractional-leaves")
    WebFractionalSceneResolution(leaves: leaves, reason: "")

# The clipped two-leaf form admits only a full-viewport painted scene. Every
# painted background and both leaves are returned; no accepted prefix escapes.
fn _web_resolve_fractional_two_leaf_scene(
    nodes: [HNode], styles: [Style], boxes: LayoutResult,
    viewport_width: i32, viewport_height: i32
) -> WebFractionalSceneResolution:
    var scene_index = -1
    var html_index = -1
    var body_index = -1
    var index = 0
    while index < nodes.len():
        val node = nodes[index]
        if node.id_attr == "scene":
            if scene_index >= 0 or node.tag != "div":
                return WebFractionalSceneResolution(leaves: [],
                    reason: "ambiguous-painted-scene")
            scene_index = index
        if node.tag == "html":
            if html_index >= 0:
                return WebFractionalSceneResolution(leaves: [],
                    reason: "multiple-html-backgrounds")
            html_index = index
        if node.tag == "body":
            if body_index >= 0:
                return WebFractionalSceneResolution(leaves: [],
                    reason: "multiple-body-backgrounds")
            body_index = index
        index = index + 1
    if scene_index < 0 or html_index < 0 or body_index < 0 or
        nodes[scene_index].parent != body_index or
        nodes[body_index].parent != html_index:
        return WebFractionalSceneResolution(leaves: [],
            reason: "painted-scene-dom-missing")
    # The source geometry of every containing background must be exact before
    # its rounded integer layout box can establish the local origin or clip.
    var provenance_index = 0
    while provenance_index < nodes.len():
        if nodes[provenance_index].tag == "#root" or
            provenance_index == html_index or
            provenance_index == body_index or
            provenance_index == scene_index:
            val source_style = styles[provenance_index]
            val source_reason = web_box_geometry_tokens_reason(
                source_style.box_geometry_raw_tokens)
            if source_style.box_geometry_unresolved or source_reason != "":
                return WebFractionalSceneResolution(leaves: [],
                    reason: "background-source-geometry-unresolved:{provenance_index}:{source_reason}")
        provenance_index = provenance_index + 1
    for background_index in [html_index, body_index, scene_index]:
        val st = styles[background_index]
        if st.bg != 0xFFFFFFFFu32 or
            boxes.bx[background_index] != 0 or
            boxes.by[background_index] != 0 or
            boxes.bw[background_index] != viewport_width or
            boxes.bh[background_index] != viewport_height:
            return WebFractionalSceneResolution(leaves: [],
                reason: "painted-background-not-full-viewport:{background_index}")
    val scene_style = styles[scene_index]
    if not scene_style.position_relative or
        not scene_style.overflow_hidden or
        not scene_style.border_box:
        return WebFractionalSceneResolution(leaves: [],
            reason: "painted-scene-containment-unproved")
    var leaves: [WebFractionalLeafRect] = []
    var rotated_count = 0
    var bar_count = 0
    index = 0
    while index < nodes.len():
        val node = nodes[index]
        val st = styles[index]
        if node.tag == "#text":
            val parent = node.parent as i32
            val metadata_text = parent >= 0 and parent < nodes.len() and
                (nodes[parent].tag == "style" or
                    nodes[parent].tag == "title")
            if node.text_trimmed != "" and not metadata_text:
                return WebFractionalSceneResolution(leaves: [],
                    reason: "visible-text-unhandled:{index}")
            index = index + 1
            continue
        if node.tag == "head" or node.tag == "meta" or
            node.tag == "title" or node.tag == "style":
            if st.bg != 0u32 or
                (boxes.bw[index] > 0 and boxes.bh[index] > 0):
                return WebFractionalSceneResolution(leaves: [],
                    reason: "metadata-paint-unhandled:{index}")
            index = index + 1
            continue
        if node.tag != "#root" and node.tag != "html" and
            node.tag != "body" and node.tag != "div":
            return WebFractionalSceneResolution(leaves: [],
                reason: "element-paint-unhandled:{index}:{node.tag}")
        if node.attrs_raw.contains("data-wm-theme-") or
            node.has_widget_class or node.has_icon_image_class or
            node.has_widget_panel_class or node.has_widget_button_class or
            node.has_widget_image_class:
            return WebFractionalSceneResolution(leaves: [],
                reason: "element-attribute-unhandled:{index}")
        val is_scene = index == scene_index
        val is_leaf = node.tag == "div" and not is_scene
        val is_rotated = is_leaf and node.class_attr == "tile"
        if not _web_fractional_neutral(st, is_scene, is_rotated):
            return WebFractionalSceneResolution(leaves: [],
                reason: "unsupported-style:{index}")
        val authored_reason = _web_fractional_authored_reason(
            st, is_scene, is_rotated)
        if authored_reason != "":
            return WebFractionalSceneResolution(leaves: [],
                reason: "authored:{index}:{authored_reason}")
        if is_scene:
            if st.box_geometry_unresolved or
                web_box_geometry_tokens_reason(st.box_geometry_raw_tokens) != "":
                return WebFractionalSceneResolution(leaves: [],
                    reason: "scene-geometry-unresolved")
        elif is_leaf:
            if node.parent != scene_index or not st.position_absolute or
                not st.border_box or
                ((st.bg >> 24) & 255u32) != 255u32:
                return WebFractionalSceneResolution(leaves: [],
                    reason: "fractional-leaf-role-unhandled:{index}")
            var child = index + 1
            while child < nodes.len():
                if nodes[child].parent == index:
                    return WebFractionalSceneResolution(leaves: [],
                        reason: "absolute-node-not-leaf:{index}")
                child = child + 1
            val token_reason = _web_fractional_leaf_tokens(st)
            if token_reason != "":
                return WebFractionalSceneResolution(leaves: [],
                    reason: "fractional-leaf:{index}:{token_reason}")
            val left = _web_fractional_token(st, "left") ?? 0.0
            val top = _web_fractional_token(st, "top") ?? 0.0
            val width = _web_fractional_token(st, "width") ?? 0.0
            val height = _web_fractional_token(st, "height") ?? 0.0
            val x = boxes.bx[scene_index].to_f64() + left
            val y = boxes.by[scene_index].to_f64() + top
            if width <= 0.0 or height <= 0.0 or x < 0.0 or y < 0.0 or
                x + width > viewport_width.to_f64() or
                y + height > viewport_height.to_f64() or
                x + width <= x or y + height <= y:
                return WebFractionalSceneResolution(leaves: [],
                    reason: "fractional-leaf-outside-viewport:{index}")
            var tx = 0.0
            var ty = 0.0
            var rotation = 0.0
            if is_rotated:
                val transform = match _web_fractional_rotate_translate(
                    st.transform_raw):
                    case Ok(value): value
                    case Err(reason):
                        return WebFractionalSceneResolution(leaves: [],
                            reason: "fractional-transform:{index}:{reason}")
                tx = transform.translate_x
                ty = transform.translate_y
                rotation = transform.rotation_deg
                rotated_count = rotated_count + 1
            else:
                if node.class_attr != "" or st.transform_raw != "none":
                    return WebFractionalSceneResolution(leaves: [],
                        reason: "fractional-bar-transform-unhandled:{index}")
                bar_count = bar_count + 1
            leaves.push(WebFractionalLeafRect(
                node_index: index, x: x, y: y,
                width: width, height: height,
                translate_x: tx, translate_y: ty,
                rotation_deg: rotation, rotated: is_rotated))
        elif node.tag == "#root":
            if st.bg != 0u32:
                return WebFractionalSceneResolution(leaves: [],
                    reason: "root-background-not-canvas")
        elif index != html_index and index != body_index:
            return WebFractionalSceneResolution(leaves: [],
                reason: "extra-painted-node:{index}")
        index = index + 1
    if leaves.len() != 2 or rotated_count != 1 or bar_count != 1:
        return WebFractionalSceneResolution(leaves: [],
            reason: "two-leaf-paint-inventory-incomplete")
    WebFractionalSceneResolution(
        leaves: leaves, reason: "", painted_scene_index: scene_index,
        background_node_indexes: [html_index, body_index, scene_index])
