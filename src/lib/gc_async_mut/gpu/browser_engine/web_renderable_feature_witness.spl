# Small, inert examples used by both Simple and Chrome's generated fixture.
# Examples exercise selected declarations; their presence is not pixel evidence.
# This module owns markup only and cannot change support classification.

fn _witness_name_in(name: text, names: text) -> bool:
    (" " + names + " ").contains(" " + name + " ")

pub fn web_feature_html_witness(name: text) -> text:
    # Document roots and singleton landmarks belong to the enclosing fixture.
    if _witness_name_in(name, "html body main"):
        return ""
    if name == "caption":
        return "<table><caption>Table caption</caption><tbody><tr><td>Cell</td></tr></tbody></table>"
    if name == "colgroup":
        return ""  # structural table columns have no standalone pixel sample
    if name == "legend":
        return "<fieldset><legend>Group legend</legend><p>Group content</p></fieldset>"
    if name == "summary":
        return "<details open><summary>Disclosure summary</summary><p>Expanded content</p></details>"
    if _witness_name_in(name, "dt dd dl"):
        return "<dl><dt>Term</dt><dd>Definition</dd></dl>"
    if name == "li":
        return "<ul><li>List item</li></ul>"
    if _witness_name_in(name, "ul ol menu"):
        return "<" + name + "><li>First item</li><li>Second item</li></" + name + ">"
    if name == "hgroup":
        return "<hgroup><h3>Heading group</h3><p>Supporting text</p></hgroup>"
    if name == "figcaption":
        return "<figure><p>Figure content</p><figcaption>Figure caption</figcaption></figure>"
    if name == "br":
        return "Line one<br>Line two"
    if name == "hr":
        return "Before rule<hr>After rule"
    if name == "wbr":
        return "<p style=\"width:80px\">LongWord<wbr>BreakHere</p>"
    if name == "bdo":
        return "<bdo dir=\"rtl\">Direction override</bdo>"
    if name == "data":
        return "<data value=\"42\">Forty two</data>"
    if name == "time":
        return "<time datetime=\"2026-09-05\">5 September 2026</time>"
    if name == "pre":
        return "<pre>Column A    Column B\nRow two     Aligned</pre>"
    # Closed allowlist prevents unknown inventory names becoming executable or
    # resource-loading elements. Context-sensitive elements are handled above.
    if _witness_name_in(name, "a abbr address article aside b bdi blockquote cite code del dfn div em figure footer h1 h2 h3 h4 h5 h6 header i ins kbd mark nav p q s samp search section small span strong sub sup u var"):
        return "<" + name + ">" + name + " example</" + name + ">"
    ""

pub fn web_feature_css_witness_declaration(name: text) -> text:
    if _witness_name_in(name, "background-color color border-bottom-color border-left-color border-right-color border-top-color outline-color text-decoration-color"):
        return name + ":#d04060"
    if _witness_name_in(name, "border-bottom-width border-left-width border-right-width border-top-width outline-width"):
        return name + ":4px"
    if _witness_name_in(name, "border-radius border-bottom-left-radius border-bottom-right-radius border-top-left-radius border-top-right-radius"):
        return name + ":12px"
    if _witness_name_in(name, "margin margin-bottom margin-left margin-right margin-top padding padding-bottom padding-left padding-right padding-top row-gap column-gap"):
        return name + ":12px"
    if _witness_name_in(name, "bottom left right top outline-offset"):
        return name + ":8px"
    if _witness_name_in(name, "height min-height max-height"):
        return name + ":48px"
    if _witness_name_in(name, "width min-width max-width"):
        return name + ":160px"
    if name == "box-shadow":
        return "box-shadow:4px 4px 2px #8090a0"
    if name == "font-size":
        return "font-size:24px"
    if name == "font-style":
        return "font-style:italic"
    if name == "font-weight":
        return "font-weight:bold"
    if name == "letter-spacing":
        return "letter-spacing:2px"
    if name == "line-height":
        return "line-height:32px"
    if name == "outline-style":
        return "outline-style:dashed"
    if name == "text-align":
        return "text-align:center"
    if name == "word-spacing":
        return "word-spacing:8px"
    ""

pub fn web_feature_witness_markup(kind: text, name: text, status: text) -> text:
    if status != "renderable":
        return "<p data-witness=\"classification-only\">No complete rendering claim for this feature.</p>"
    if kind == "html-tag":
        val sample = web_feature_html_witness(name)
        if sample == "":
            return "<p data-witness=\"structural\">Document or table structure; no standalone visual example.</p>"
        return "<div class=\"feature-example\" data-witness=\"html-example\">" + sample + "</div><p>Example; rendered pixels unverified.</p>"
    if kind == "css-property":
        val declaration = web_feature_css_witness_declaration(name)
        if declaration != "":
            # Fixed supporting declarations establish the formatting context for
            # border, offset, gap, and text-decoration samples. The candidate
            # declaration is last so it controls its own property.
            val base = "position:relative;display:block;width:200px;min-height:24px;background-color:#e8edf3;border:1px solid #8090a0;outline:1px solid #607080;text-decoration:underline;"
            var context = ""
            var content = "Sample words<br>Second line"
            if name == "min-width":
                context = "width:80px;"
            if name == "max-height":
                context = "height:80px;overflow:hidden;"
            if name == "row-gap":
                context = "display:flex;flex-direction:column;"
                content = "<span>First row</span><span>Second row</span>"
            if name == "column-gap":
                context = "display:flex;"
                content = "<span>First</span><span>Second</span>"
            return "<div class=\"feature-example\" data-witness=\"css-example\" data-sample=\"" + declaration + "\" style=\"" + base + context + declaration + "\">" + content + "</div><p>Selected value example; rendered pixels unverified.</p>"
    "<p data-witness=\"classification-only\">No safe example registered.</p>"
