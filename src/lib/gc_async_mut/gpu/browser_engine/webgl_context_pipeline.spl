    me generate_mipmap(target: i32) -> bool:
        if not self.ensure_context_available():
            return false
        val texture_index = self.bound_texture_index_for_upload(target)
        if texture_index < 0:
            return false
        var texture = self.textures[texture_index]
        if not texture.initialized or texture.width <= 0 or texture.height <= 0:
            self.last_error = WEBGL_INVALID_OPERATION
            return false
        if self.version == 1 and (not webgl_power_of_two(texture.width) or not webgl_power_of_two(texture.height)):
            self.last_error = WEBGL_INVALID_OPERATION
            return false
        texture.mipmap_generated = true
        self.textures[texture_index] = texture
        self.render_commands.push(webgl_render_command_generate_mipmap(target))
        true

    me tex_image_2d(target: i32, level: i32, internal_format: i32, width: i32, height: i32, border: i32, format: i32, pixel_type: i32, pixels: [u8]) -> bool:
        if not self.ensure_context_available():
            return false
        val texture_index = self.bound_texture_index_for_upload(target)
        if texture_index < 0:
            return false
        if not self.validate_texture_image_args(level, internal_format, width, height, border, format, pixel_type):
            return false
        val bytes_per_pixel = webgl_texture_pixel_bytes(format, pixel_type)
        val required = webgl_required_texture_bytes_safe(width, height, bytes_per_pixel, self.unpack_alignment)
        if required < 0:
            self.last_error = WEBGL_INVALID_VALUE
            return false
        if pixels.len() > 0 and pixels.len() < required:
            self.last_error = WEBGL_INVALID_OPERATION
            return false
        var texture = self.textures[texture_index]
        texture.target = webgl_texture_binding_target(target)
        texture.width = width
        texture.height = height
        texture.level = level
        texture.internal_format = internal_format
        texture.format = format
        texture.pixel_type = pixel_type
        texture.initialized = true
        texture.mipmap_generated = false
        if pixels.len() == 0:
            texture.pixels = webgl_zero_bytes(required)
        else:
            texture.pixels = webgl_copy_bytes(pixels, required)
        self.textures[texture_index] = texture
        self.render_commands.push(webgl_render_command_tex_image_2d(target, level, internal_format, width, height, format, pixel_type))
        true

    me tex_sub_image_2d(target: i32, level: i32, xoffset: i32, yoffset: i32, width: i32, height: i32, format: i32, pixel_type: i32, pixels: [u8]) -> bool:
        if not self.ensure_context_available():
            return false
        val texture_index = self.bound_texture_index_for_upload(target)
        if texture_index < 0:
            return false
        var texture = self.textures[texture_index]
        if not texture.initialized:
            self.last_error = WEBGL_INVALID_OPERATION
            return false
        if level != texture.level:
            self.last_error = WEBGL_INVALID_VALUE
            return false
        if format != texture.format or pixel_type != texture.pixel_type:
            self.last_error = WEBGL_INVALID_OPERATION
            return false
        if xoffset < 0 or yoffset < 0 or width < 0 or height < 0 or xoffset + width > texture.width or yoffset + height > texture.height:
            self.last_error = WEBGL_INVALID_VALUE
            return false
        val bpp = webgl_texture_pixel_bytes(format, pixel_type)
        if bpp == 0:
            self.last_error = WEBGL_INVALID_ENUM
            return false
        val required = webgl_required_texture_bytes_safe(width, height, bpp, self.unpack_alignment)
        if required < 0:
            self.last_error = WEBGL_INVALID_VALUE
            return false
        if pixels.len() < required:
            self.last_error = WEBGL_INVALID_OPERATION
            return false
        texture.pixels = webgl_replace_texture_region(texture.pixels, texture.width, bpp, xoffset, yoffset, width, height, self.unpack_alignment, pixels)
        self.textures[texture_index] = texture
        self.render_commands.push(webgl_render_command_tex_sub_image_2d(target, level, xoffset, yoffset, width, height, format, pixel_type))
        true

