
# CSS Paint Pass — colour helpers
#
# _apply_opacity — blend an ARGB color by an opacity factor
#
# `_paint_box` used to live here. It was latent dead code written against a
# BeLayoutBox shape that does not exist (`box.node` as a field; `content_x`
# et al. as fields rather than methods), so it could never execute; nothing
# imported it, and the live paint walk is `_browser_paint_boxes` in
# browser_renderer.spl. Removed 2026-08-17 — see
# doc/08_tracking/bug/layout_paint_paint_box_dead_code_wrong_belayoutbox_shape_2026-08-15.md
# and the contract pin spec test/01_unit/browser_engine/layout_paint_contract_pin_spec.spl.

pub fn _apply_opacity(argb: u32, opacity: f32) -> u32:
    """Blend an ARGB color value by an opacity factor [0.0, 1.0]."""
    if opacity >= 1.0:
        return argb
    if opacity <= 0.0:
        return argb & 0x00FFFFFF
    val a = (argb >> 24) & 0xFF
    var new_a = (a.to_f32() * opacity).to_u32()
    if new_a > 255:
        new_a = 255
    return (new_a << 24) | (argb & 0x00FFFFFF)
