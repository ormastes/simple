
# CSS Paint Pass helpers
#
# _apply_opacity — blend an ARGB color by an opacity factor
#
# NOTE: a `_paint_box` tree walker used to live here. It was latent dead
# code written against a nonexistent BeLayoutBox shape (`box.node`,
# `content_x` as a field) and stale dom_accessors contracts (`.value` on
# plain f64/text returns), had zero callers, and could never execute.
# Deleted 2026-08-17; the live painters are `layout.spl:paint_box` and
# `browser_renderer.spl:_browser_paint_boxes`. See
# doc/08_tracking/bug/layout_paint_paint_box_dead_code_wrong_belayoutbox_shape_2026-08-15.md

pub fn _apply_opacity(argb: u32, opacity: f32) -> u32:
    """Blend an ARGB color value by an opacity factor [0.0, 1.0]."""
    if opacity >= 1.0:
        return argb
    if opacity <= 0.0:
        return argb & 0x00FFFFFF
    val a = (argb >> 24) & 0xFF
    var new_a = (a.to_f32() * opacity).to_u32()
    if new_a > 255:
        new_a = 255
    return (new_a << 24) | (argb & 0x00FFFFFF)

