    margin_t: i32
    margin_r: i32
    margin_b: i32
    margin_l_auto: bool
    margin_r_auto: bool
    margin_t_auto: bool
    margin_b_auto: bool
    display: text       # block / grid / inline / inline-block / contents / none
    grid_template_columns: text = ""
    grid_template_rows: text = ""
    grid_column: text = ""
    grid_row: text = ""
    grid_template_areas: text = ""
    grid_area: text = ""
