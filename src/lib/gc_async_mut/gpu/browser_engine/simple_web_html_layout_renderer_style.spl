    text_decoration_line_through: bool = false
    scrollbar_width_none: bool = false
    # GAP-2 (doc/03_plan/ui/unified_2d_engine/drawir_feature_gap_2026-07-31.md):
    # N-stop / angled / radial gradient model, additive alongside the legacy
    # 2-stop background_gradient_from/to above. Appended at the END with
    # defaults for the same reason as the fields above — mid-struct insertion
    # breaks positional construction. Empty background_gradient_stop_colors
    # means "no N-stop gradient parsed" and the legacy from/to fields remain
