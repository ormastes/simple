# Computed styles and CSS cascade for the Simple web renderer.

export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.*

const SIMPLE_WEB_STICKY_TOP_AUTO: i32 = -2147483647

class Style:
    bg: u32
    background_gradient_from: u32
    background_gradient_to: u32
    background_repeat: text
    background_size_w_px: i32
    background_size_h_px: i32
    background_position_x_px: i32
    background_position_y_px: i32
    background_clip: text
    background_origin: text
    background_attachment: text
    background_image_uri: text = ""
    fg: u32
    font_size: i32
    font_family: text
    resolved_font_identity: text
    resolved_font_advances: [i32]
    resolved_font_width: i32
    resolved_font_line_height: i32
    line_height_px: i32
    width_px: i32
    height_px: i32
    # True only while the winning physical block-size declaration is `auto`
    # (including the initial/absent state). Numeric zero is authored sizing.
    height_auto: bool = true
    # The shared default string is `stretch` for legacy Flex behavior. Grid
    # needs to distinguish that omitted declaration from authored stretch,
    # whose initial `normal` semantics differ for aspect-ratio items.
    align_items_authored: bool = false
    # CSS float: 0=none, 1=left, 2=right. Scope (bug browser_engine_float_no_
    # inline_wrap_beside_float_2026-08-19): only float:left participates in
    # layout (a left exclusion band that narrows following line boxes);
    # float:right is parsed but not yet laid out.
    float_mode: i32 = 0
    border_box: bool
    min_width_px: i32
    max_width_px: i32
    min_height_px: i32
    max_height_px: i32
    min_height_vh: bool
    flex_fill: bool
    flex_grow: i32
    flex_shrink: i32
    flex_basis_px: i32
    order: i32
    flex_wrap: text
    justify_content: text
    align_items: text
    align_self: text
    align_content: text
    pad_l: i32
    pad_t: i32
    pad_r: i32
    pad_b: i32
    border_w: i32
    border_color: u32
    border_l: i32
