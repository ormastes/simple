# HTML Tokenizer — WHATWG §13.2.5 state-machine tokenizer
#
# Produces a flat list of HtmlToken from raw HTML text.
# No DOM dependency — pure text-in, tokens-out.
# Ported from examples/browser/feature/parser/html_tokenizer.spl
# with adaptations for canonical engine types.

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.html_named_character_references.{
    HTML_NAMED_REFERENCE_MAX_LENGTH,
    HTML_NAMED_REFERENCE_NAMES,
    HTML_NAMED_REFERENCE_VALUES
}

extern fn rt_text_to_bytes(value: text) -> [u8]
extern fn rt_bytes_to_text(value: [u8]) -> text

pub fn html_max_tokens() -> i32: 262144
pub fn html_max_attributes() -> i32: 65536

# =========================================================================
# Token types
# =========================================================================

pub enum HtmlTokenKind:
    Doctype
    StartTag
    EndTag
    Character
    Comment
    Eof

pub class HtmlAttr:
    """A single HTML attribute name/value pair."""
    name: text
    value: text

pub class HtmlToken:
    """A single lexical token emitted by the HTML tokenizer."""
    token_kind: HtmlTokenKind
    tag_name: text
    attrs: [HtmlAttr]
    self_closing: bool
    data: text

# =========================================================================
# HtmlTokenizer class
# =========================================================================

pub class HtmlTokenizer:
    """WHATWG §13.2.5 state-machine tokenizer."""
    html: text
    pos: i32
    length: i32

pub class HtmlTokenizeResult:
    tokens: [HtmlToken]
    truncated: bool

fn _raw_tag_char_matches(c: text, lower: text) -> bool:
    if c == lower:
        return true
    val c_bytes = rt_text_to_bytes(c)
    val lower_bytes = rt_text_to_bytes(lower)
    if c_bytes.len() != 1 or lower_bytes.len() != 1:
        return false
    val code = c_bytes[0] as i64
    val lower_code = lower_bytes[0] as i64
    code >= 65 and code <= 90 and code + 32 == lower_code

fn _find_raw_end_tag(html: text, tag: text, start: i32) -> i32:
    var pos = start
    while pos < html.len():
        if (
            html.slice(pos, pos + 2) == "</" and
            pos + 2 + tag.len() <= html.len()
        ):
            var tag_i = 0
            while (
                tag_i < tag.len() and
                _raw_tag_char_matches(
                    html.slice(pos + 2 + tag_i, pos + 3 + tag_i),
                    tag.slice(tag_i, tag_i + 1)
                )
            ):
                tag_i = tag_i + 1
            if tag_i == tag.len():
                val boundary_pos = pos + 2 + tag.len()
                val boundary = if boundary_pos < html.len():
                    html.slice(boundary_pos, boundary_pos + 1)
                else:
                    ""
                if (
                    boundary == ">" or boundary == " " or boundary == "\t" or
                    boundary == "\n" or boundary == "\r" or boundary == "/"
                ):
                    var close = boundary_pos
                    while (
                        close < html.len() and
                        html.slice(close, close + 1) != ">" and
                        html.slice(close, close + 1) != "<"
                    ):
                        close = close + 1
                    if (
                        close < html.len() and
                        html.slice(close, close + 1) == ">"
                    ):
                        return pos
                    if close < html.len():
                        pos = close
                        continue
        pos = pos + 1
    -1

class _TokenSink:
    tokens: [HtmlToken]
    limit: i32
    truncated: bool
    kind_ids: [i32]
    tags: [text]
    data_out: [text]
    self_closing_ids: [i32]
    attr_offsets: [i32]
    attr_names: [text]
    attr_values: [text]

    me record_flat_values(kind_id: i32, tag: text, data_value: text, self_closing_id: i32, attrs_value: [HtmlAttr]):
        if self.attr_offsets.len() == 0:
            self.attr_offsets.push(0)
        self.kind_ids.push(kind_id)
        self.tags.push(tag)
        self.data_out.push(data_value)
        self.self_closing_ids.push(self_closing_id)
        for delivered_attr in attrs_value:
            self.attr_names.push(delivered_attr.name)
            self.attr_values.push(delivered_attr.value)
        self.attr_offsets.push(self.attr_names.len())

    me push_values(kind_id: i32, tag: text, attrs_value: [HtmlAttr], self_closing_id: i32, data_value: text) -> bool:
        if self.tokens.len() >= self.limit:
            self.truncated = true
            return false
        self.record_flat_values(
            kind_id, tag, data_value, self_closing_id, attrs_value)
        val token_kind = if kind_id == 0:
            HtmlTokenKind.Doctype
        elif kind_id == 1:
            HtmlTokenKind.StartTag
        elif kind_id == 2:
            HtmlTokenKind.EndTag
        elif kind_id == 3:
            HtmlTokenKind.Character
        elif kind_id == 4:
            HtmlTokenKind.Comment
        else:
            HtmlTokenKind.Eof
        self.tokens.push(HtmlToken(
            token_kind: token_kind, tag_name: tag, attrs: attrs_value,
            self_closing: self_closing_id == 1, data: data_value))
        true

    me push_start_flat(tag: text, flat_attr_names: [text], flat_attr_values: [text], self_closing_id: i32) -> bool:
        if self.tokens.len() >= self.limit:
            self.truncated = true
            return false
        if self.attr_offsets.len() == 0:
            self.attr_offsets.push(0)
        self.kind_ids.push(1)
        self.tags.push(tag)
        self.data_out.push("")
        self.self_closing_ids.push(self_closing_id)
        var legacy_attrs: [HtmlAttr] = []
        var flat_i = 0
        while flat_i < flat_attr_names.len():
            self.attr_names.push(flat_attr_names[flat_i])
            self.attr_values.push(flat_attr_values[flat_i])
            legacy_attrs.push(HtmlAttr(
                name: flat_attr_names[flat_i],
                value: flat_attr_values[flat_i]))
            flat_i = flat_i + 1
        self.attr_offsets.push(self.attr_names.len())
        self.tokens.push(HtmlToken(
            token_kind: HtmlTokenKind.StartTag, tag_name: tag,
            attrs: legacy_attrs, self_closing: self_closing_id == 1, data: ""))
        true

pub fn html_tokenizer_new(html: text) -> HtmlTokenizer:
    """Create a new tokenizer for the given HTML string."""
    HtmlTokenizer(html: html, pos: 0, length: html.len())

pub fn html_tokenizer_tokenize(t: HtmlTokenizer) -> [HtmlToken]:
    """Tokenize the entire input, returning all tokens including final EOF."""
    html_tokenizer_tokenize_with_limit(t, html_max_tokens()).tokens

pub fn html_tokenizer_tokenize_with_limit(
    t: HtmlTokenizer, requested_token_limit: i32
) -> HtmlTokenizeResult:
    html_tokenizer_tokenize_with_limits(
        t, requested_token_limit, html_max_attributes()
    )

pub fn html_tokenizer_tokenize_with_limits(
    t: HtmlTokenizer, requested_token_limit: i32,
    requested_attr_limit: i32
) -> HtmlTokenizeResult:
    _html_tokenizer_tokenize_with_limits_into_impl(
        t, requested_token_limit, requested_attr_limit, [], [],
        [], [], [], [], [], [], []
    )

pub fn html_tokenizer_tokenize_with_limits_into(
    t: HtmlTokenizer, requested_token_limit: i32,
    requested_attr_limit: i32, destination: [HtmlToken], status: [i32]
):
    _html_tokenizer_tokenize_with_limits_into_impl(
        t, requested_token_limit, requested_attr_limit, destination, status,
        [], [], [], [], [], [], []
    )

pub fn html_tokenizer_tokenize_with_limits_flat_into(
    t: HtmlTokenizer, requested_token_limit: i32,
    requested_attr_limit: i32, kind_ids: [i32], tags: [text], data: [text],
    self_closing_ids: [i32], attr_offsets: [i32], attr_names: [text],
    attr_values: [text], status: [i32]
):
    _html_tokenizer_tokenize_with_limits_into_impl(
        t, requested_token_limit, requested_attr_limit, [], status,
        kind_ids, tags, data, self_closing_ids, attr_offsets,
        attr_names, attr_values
    )

fn _html_tokenizer_tokenize_with_limits_into_impl(
    t: HtmlTokenizer, requested_token_limit: i32,
    requested_attr_limit: i32, destination: [HtmlToken], status: [i32],
    kind_ids: [i32], tags: [text], data_out: [text],
    self_closing_ids: [i32], attr_offsets: [i32], attr_names: [text],
    attr_values: [text]
) -> HtmlTokenizeResult:
    val token_limit = if requested_token_limit < 1:
        1
    elif requested_token_limit > html_max_tokens():
        html_max_tokens()
    else:
        requested_token_limit
    val attr_limit = if requested_attr_limit < 0:
        0
    elif requested_attr_limit > html_max_attributes():
        html_max_attributes()
    else:
        requested_attr_limit
    val sink = _TokenSink(
        tokens: [], limit: token_limit, truncated: false,
        kind_ids: kind_ids, tags: tags, data_out: data_out,
        self_closing_ids: self_closing_ids, attr_offsets: attr_offsets,
        attr_names: attr_names, attr_values: attr_values
    )
    var pos = 0
    val html = t.html
    val n = html.len()
    var retained_attrs = 0
    # Raw-text mode for script/style and RCDATA mode for textarea.
    var raw_text_tag = ""
    var raw_text_decodes_entities = false
    while pos < n and not sink.truncated:
        val ch = html.slice(pos, pos + 1)
        if raw_text_tag != "":
            val current_raw_tag = raw_text_tag
            val found_end = _find_raw_end_tag(html, current_raw_tag, pos)
            val raw_end = if found_end < 0: n else: found_end
            val raw_data = html.slice(pos, raw_end)
            if raw_data.len() > 0:
                if raw_text_decodes_entities:
                    var raw_pos = 0
                    while raw_pos < raw_data.len() and not sink.truncated:
                        val amp = _find_char(raw_data, "&", raw_pos)
                        if amp < 0:
                            val _ = sink.push_values(
                                3, "", [], 0,
                                raw_data.slice(raw_pos, raw_data.len()))
                            raw_pos = raw_data.len()
                        else:
                            if amp > raw_pos:
                                val _ = sink.push_values(
                                    3, "", [], 0,
                                    raw_data.slice(raw_pos, amp))
                            val entity = _parse_entity(raw_data, amp, false)
                            val _ = sink.push_values(3, "", [], 0, entity.decoded)
                            raw_pos = entity.end_pos
                else:
                    val _ = sink.push_values(3, "", [], 0, raw_data)
            if found_end < 0:
                pos = n
            else:
                pos = found_end
                # Emit the end tag
                val close_end = _find_char(html, ">", pos)
                if close_end < 0:
                    pos = n
                else:
                    pos = close_end + 1
                val _ = sink.push_values(2, current_raw_tag, [], 0, "")
            raw_text_tag = ""
            raw_text_decodes_entities = false
        elif ch == "<":
            # Peek at next char
            if pos + 1 >= n:
                # Lone < at end — emit as character
                val _ = sink.push_values(3, "", [], 0, "<")
                pos = pos + 1
            else:
                val next = html.slice(pos + 1, pos + 2)
                val next_byte = html.byte_at(pos + 1)
                print "[html-tag-peek] pos={pos} next_len={next.len()} next_code={next.char_code_at(0)} next_byte={next_byte}"
                if next == "!":
                    # Comment or doctype
                    if pos + 3 < n and html.slice(pos + 2, pos + 4) == "--":
                        # Comment: <!-- ... -->
                        if (
                            pos + 4 < n and
                            html.slice(pos + 4, pos + 5) == ">"
                        ):
                            val _ = sink.push_values(4, "", [], 0, "")
                            pos = pos + 5
                        elif (
                            pos + 5 < n and
                            html.slice(pos + 4, pos + 6) == "->"
                        ):
                            val _ = sink.push_values(4, "", [], 0, "")
                            pos = pos + 6
                        else:
                            val comment_end = _find_substr(
                                html, "-->", pos + 4
                            )
                            if comment_end < 0:
                                val comment_data = html.slice(pos + 4, n)
                                val _ = sink.push_values(4, "", [], 0, comment_data)
                                pos = n
                            else:
                                val comment_data2 = html.slice(
                                    pos + 4, comment_end
                                )
                                val _ = sink.push_values(4, "", [], 0, comment_data2)
                                pos = comment_end + 3
                    elif pos + 8 < n and html.slice(pos + 2, pos + 9).lower() == "doctype":
                        # Doctype
                        val gt = _find_char(html, ">", pos)
                        if gt < 0:
                            pos = n
                        else:
                            val dt_inner = html.slice(pos + 9, gt).trim()
                            val dt_parts = _split_first_word(dt_inner)
                            val _ = sink.push_values(0, dt_parts, [], 0, "")
                            pos = gt + 1
                    else:
                        # Unknown <! sequence — skip to >
                        val gt2 = _find_char(html, ">", pos)
                        if gt2 < 0:
                            pos = n
                        else:
                            pos = gt2 + 1
                elif next == "/":
                    # End tag
                    val gt = _find_char(html, ">", pos + 2)
                    if gt < 0:
                        val _ = sink.push_values(3, "", [], 0, "<")
                        pos = pos + 1
                    else:
                        val tag_raw = html.slice(pos + 2, gt).trim().lower()
                        val tag_name = _strip_tag_name(tag_raw)
                        val _ = sink.push_values(2, tag_name, [], 0, "")
                        pos = gt + 1
                elif next == "?":
                    # Processing instruction — skip to >
                    val gt3 = _find_char(html, ">", pos)
                    if gt3 < 0:
                        pos = n
                    else:
                        pos = gt3 + 1
                elif ((next_byte >= 65 and next_byte <= 90) or
                      (next_byte >= 97 and next_byte <= 122)):
                    # Start tag
                    val gt4 = _find_tag_close(html, pos + 1)
                    if gt4 < 0:
                        val _ = sink.push_values(3, "", [], 0, "<")
                        pos = pos + 1
                    else:
                        val self_closing = (
                            gt4 > 0 and html.slice(gt4 - 1, gt4) == "/"
                        )
                        val inner = html.slice(pos + 1, if self_closing: gt4 - 1 else: gt4).trim()
                        val self_closing_id = if self_closing: 1 else: 0
                        print "[html-start-scan] pos={pos} close={gt4} next_code={next.char_code_at(0)} self_closing_id={self_closing_id}"
                        var parsed_tag: [text] = [""]
                        var parsed_attr_names: [text] = []
                        var parsed_attr_values: [text] = []
                        var parsed_status: [i32] = [0]
                        _parse_start_tag_flat(
                            inner, attr_limit - retained_attrs,
                            parsed_tag, parsed_attr_names,
                            parsed_attr_values, parsed_status
                        )
                        print "[html-start-flat] inner_len={inner.len()} tag_len={parsed_tag[0].len()} attrs={parsed_attr_names.len()} status={parsed_status[0]}"
                        val tag_name2 = parsed_tag[0]
                        if parsed_status[0] == 1:
                            sink.truncated = true
                        else:
                            retained_attrs = (
                                retained_attrs + parsed_attr_names.len())
                            val _ = sink.push_start_flat(
                                tag_name2, parsed_attr_names,
                                parsed_attr_values,
                                if self_closing: 1 else: 0)
                        pos = gt4 + 1
                        if (tag_name2 == "script" or tag_name2 == "style" or
                            tag_name2 == "title" or tag_name2 == "textarea"):
                            raw_text_tag = tag_name2
                            raw_text_decodes_entities = (
                                tag_name2 == "title" or tag_name2 == "textarea"
                            )
                else:
                    # Stray < — emit as character
                    val _ = sink.push_values(3, "", [], 0, "<")
                    pos = pos + 1
        elif ch == "&":
            # Named entity reference
            val entity_result = _parse_entity(html, pos, false)
            val _ = sink.push_values(3, "", [], 0, entity_result.decoded)
            pos = entity_result.end_pos
        else:
            # Regular character data — accumulate until < or &
            val end_pos = _scan_char_data(html, pos)
            val char_data = html.slice(pos, end_pos)
            if char_data.len() > 0:
                val _ = sink.push_values(3, "", [], 0, char_data)
            pos = end_pos
    val eof_token = HtmlToken(
        token_kind: HtmlTokenKind.Eof, tag_name: "", attrs: [],
        self_closing: false, data: "")
    sink.tokens.push(eof_token)
    sink.record_flat_values(5, "", "", 0, [])
    if destination.len() == 0:
        for delivered_token in sink.tokens:
            destination.push(delivered_token)
    if status.len() > 0:
        status[0] = if sink.truncated: 1 else: 0
    HtmlTokenizeResult(tokens: sink.tokens, truncated: sink.truncated)

# =========================================================================
# Tag parsing helpers
# =========================================================================

class _ParsedTag:
    tag_name: text
    attrs: [HtmlAttr]
    truncated: bool

fn _parse_start_tag(inner: text, attr_limit: i32) -> _ParsedTag:
    """Parse tag name and attributes from the inner content of a start tag."""
    val n = inner.len()
    if n == 0:
        return _ParsedTag(tag_name: "", attrs: [], truncated: false)
    # Extract tag name: up to first whitespace
    var name_end = 0
    while name_end < n:
        val c = inner.slice(name_end, name_end + 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "/":
            name_end = n  # break out
        else:
            name_end = name_end + 1
    # Re-find actual end of tag name
    var ne = 0
    while ne < n:
        val c2 = inner.slice(ne, ne + 1)
        if c2 == " " or c2 == "\t" or c2 == "\n" or c2 == "\r" or c2 == "/":
            ne = n + 1  # signal exit
        else:
            ne = ne + 1
    # Since we can't break easily, do it differently
    var tag_end = 0
    var found_ws = false
    while tag_end < n and not found_ws:
        val cc = inner.slice(tag_end, tag_end + 1)
        if cc == " " or cc == "\t" or cc == "\n" or cc == "\r":
            found_ws = true
        else:
            tag_end = tag_end + 1
    val tag_name = inner.slice(0, tag_end).lower()
    # Parse attributes from the remainder
    val attrs_str = if tag_end < n: inner.slice(tag_end, n).trim() else: ""
    val parsed_attrs = _parse_attrs(attrs_str, attr_limit)
    _ParsedTag(
        tag_name: tag_name, attrs: parsed_attrs.attrs,
        truncated: parsed_attrs.truncated
    )

fn _is_ws(c: text) -> bool:
    c == " " or c == "\t" or c == "\n" or c == "\r"

fn _skip_ws(s: text, start: i32) -> i32:
    """Return the first index >= start that is not whitespace."""
    val n = s.len()
    var i = start
    var done = false
    while i < n and not done:
        if _is_ws(s.slice(i, i + 1)):
            i = i + 1
        else:
            done = true
    i

class _ParsedAttrs:
    attrs: [HtmlAttr]
    truncated: bool

fn _parse_attrs(s: text, attr_limit: i32) -> _ParsedAttrs:
    """Parse attribute string into list of HtmlAttr."""
    var attrs: [HtmlAttr] = []
    val n = s.len()
    if n == 0:
        return _ParsedAttrs(attrs: attrs, truncated: false)
    var seen: Dict<text, bool> = {}
    var pos = _skip_ws(s, 0)
    while pos < n:
        # Read attribute name: until = or whitespace or end
        var name_end = pos
        var ne_done = false
        while name_end < n and not ne_done:
            val nc = s.slice(name_end, name_end + 1)
            if nc == "=" or _is_ws(nc):
                ne_done = true
            else:
                name_end = name_end + 1
        val attr_name = s.slice(pos, name_end).lower()
        val keep_attr = attr_name.len() > 0 and not seen.has(attr_name)
        if keep_attr:
            if attrs.len() >= attr_limit:
                return _ParsedAttrs(attrs: attrs, truncated: true)
            seen[attr_name] = true
        pos = _skip_ws(s, name_end)
        # Check for =
        if pos < n and s.slice(pos, pos + 1) == "=":
            pos = _skip_ws(s, pos + 1)
            # Read value
            var attr_val = ""
            if pos < n:
                val qc = s.slice(pos, pos + 1)
                if qc == "\"" or qc == "'":
                    pos = pos + 1
                    val val_end = _find_char(s, qc, pos)
                    if val_end < 0:
                        attr_val = s.slice(pos, n)
                        pos = n
                    else:
                        attr_val = s.slice(pos, val_end)
                        pos = val_end + 1
                else:
                    # Unquoted value: until whitespace
                    var uq_end = pos
                    var uq_done = false
                    while uq_end < n and not uq_done:
                        if _is_ws(s.slice(uq_end, uq_end + 1)):
                            uq_done = true
                        else:
                            uq_end = uq_end + 1
                    attr_val = s.slice(pos, uq_end)
                    pos = uq_end
            if keep_attr:
                attrs.push(HtmlAttr(
                    name: attr_name,
                    value: _decode_character_references(attr_val)
                ))
        else:
            # Boolean attribute
            if keep_attr:
                attrs.push(HtmlAttr(name: attr_name, value: ""))
        pos = _skip_ws(s, pos)
    _ParsedAttrs(attrs: attrs, truncated: false)

# Native/freestanding-safe start-tag projection. All semantic fields are
# written before either `_ParsedTag` or `_ParsedAttrs` can cross an aggregate
# return boundary.
fn _parse_start_tag_flat(
    inner: text, attr_limit: i32, tag_out: [text], names_out: [text],
    values_out: [text], status: [i32]
):
    if tag_out.len() == 0 or status.len() == 0:
        return
    val n = inner.len()
    var tag_end = 0
    var found_ws = false
    while tag_end < n and not found_ws:
        val cc = inner.slice(tag_end, tag_end + 1)
        if cc == " " or cc == "\t" or cc == "\n" or cc == "\r":
            found_ws = true
        else:
            tag_end = tag_end + 1
    tag_out[0] = inner.slice(0, tag_end).lower()
    val attrs_source = if tag_end < n:
        inner.slice(tag_end, n).trim()
    else:
        ""
    var seen: Dict<text, bool> = {}
    var pos = _skip_ws(attrs_source, 0)
    while pos < attrs_source.len():
        var name_end = pos
        var name_done = false
        while name_end < attrs_source.len() and not name_done:
            val nc = attrs_source.slice(name_end, name_end + 1)
            if nc == "=" or _is_ws(nc):
                name_done = true
            else:
                name_end = name_end + 1
        val attr_name = attrs_source.slice(pos, name_end).lower()
        val keep_attr = attr_name.len() > 0 and not seen.has(attr_name)
        if keep_attr:
            if names_out.len() >= attr_limit:
                status[0] = 1
                return
            seen[attr_name] = true
        pos = _skip_ws(attrs_source, name_end)
        var attr_value = ""
        if pos < attrs_source.len() and attrs_source.slice(pos, pos + 1) == "=":
            pos = _skip_ws(attrs_source, pos + 1)
            if pos < attrs_source.len():
                val quote = attrs_source.slice(pos, pos + 1)
                if quote == "\"" or quote == "'":
                    pos = pos + 1
                    val value_end = _find_char(attrs_source, quote, pos)
                    if value_end < 0:
                        attr_value = attrs_source.slice(pos, attrs_source.len())
                        pos = attrs_source.len()
                    else:
                        attr_value = attrs_source.slice(pos, value_end)
                        pos = value_end + 1
                else:
                    var value_end = pos
                    while value_end < attrs_source.len() and not _is_ws(
                        attrs_source.slice(value_end, value_end + 1)):
                        value_end = value_end + 1
                    attr_value = attrs_source.slice(pos, value_end)
                    pos = value_end
        if keep_attr:
            names_out.push(attr_name)
            values_out.push(_decode_character_references(attr_value))
        pos = _skip_ws(attrs_source, pos)
    status[0] = 0

# =========================================================================
# Entity parsing
# =========================================================================

class _EntityResult:
    decoded: text
    end_pos: i32

fn _normalize_numeric_character_reference(code: i64) -> i64:
    if (
        code <= 0 or code > 0x10FFFF or
        (code >= 0xD800 and code <= 0xDFFF)
    ):
        return 0xFFFD
    if code == 0x80: return 0x20AC
    if code == 0x82: return 0x201A
    if code == 0x83: return 0x0192
    if code == 0x84: return 0x201E
    if code == 0x85: return 0x2026
    if code == 0x86: return 0x2020
    if code == 0x87: return 0x2021
    if code == 0x88: return 0x02C6
    if code == 0x89: return 0x2030
    if code == 0x8A: return 0x0160
    if code == 0x8B: return 0x2039
    if code == 0x8C: return 0x0152
    if code == 0x8E: return 0x017D
    if code == 0x91: return 0x2018
    if code == 0x92: return 0x2019
    if code == 0x93: return 0x201C
    if code == 0x94: return 0x201D
    if code == 0x95: return 0x2022
    if code == 0x96: return 0x2013
    if code == 0x97: return 0x2014
    if code == 0x98: return 0x02DC
    if code == 0x99: return 0x2122
    if code == 0x9A: return 0x0161
    if code == 0x9B: return 0x203A
    if code == 0x9C: return 0x0153
    if code == 0x9E: return 0x017E
    if code == 0x9F: return 0x0178
    code

fn _codepoint_text(cp: i64) -> text:
    var code = cp
    if (
        code <= 0 or code > 0x10FFFF or
        (code >= 0xD800 and code <= 0xDFFF)
    ):
        code = 0xFFFD
    var bytes: [u8] = []
    if code < 0x80:
        bytes.push(code as u8)
    elif code < 0x800:
        bytes.push((0xC0 | (code >> 6)) as u8)
        bytes.push((0x80 | (code & 0x3F)) as u8)
    elif code < 0x10000:
        bytes.push((0xE0 | (code >> 12)) as u8)
        bytes.push((0x80 | ((code >> 6) & 0x3F)) as u8)
        bytes.push((0x80 | (code & 0x3F)) as u8)
    else:
        bytes.push((0xF0 | (code >> 18)) as u8)
        bytes.push((0x80 | ((code >> 12) & 0x3F)) as u8)
        bytes.push((0x80 | ((code >> 6) & 0x3F)) as u8)
        bytes.push((0x80 | (code & 0x3F)) as u8)
    rt_bytes_to_text(bytes)

fn _entity_digit(byte_text: text, hex: bool) -> i64:
    val bytes = rt_text_to_bytes(byte_text)
    if bytes.len() != 1:
        return -1
    val b = bytes[0] as i64
    if b >= 48 and b <= 57:
        return b - 48
    if hex and b >= 65 and b <= 70:
        return b - 55
    if hex and b >= 97 and b <= 102:
        return b - 87
    -1

fn _named_reference_text_less(left: text, right: text) -> bool:
    val limit = if left.len() < right.len(): left.len() else: right.len()
    var index = 0
    while index < limit:
        val left_code = left.char_code_at(index)
        val right_code = right.char_code_at(index)
        if left_code < right_code:
            return true
        if left_code > right_code:
            return false
        index = index + 1
    left.len() < right.len()

fn _named_reference_index(name: text) -> i32:
    var low = 0
    var high = HTML_NAMED_REFERENCE_NAMES.len()
    while low < high:
        val middle = low + (high - low) / 2
        val candidate = HTML_NAMED_REFERENCE_NAMES[middle]
        if candidate == name:
            return middle
        if _named_reference_text_less(candidate, name):
            low = middle + 1
        else:
            high = middle
    -1

fn _is_ascii_alnum_or_equals(value: text) -> bool:
    (
        value == "=" or _is_alpha_char(value) or
        (value >= "0" and value <= "9")
    )

fn _parse_entity(
    html: text, pos: i32, in_attribute: bool
) -> _EntityResult:
    """Parse an HTML entity reference starting at pos (which points to &)."""
    val n = html.len()
    if pos + 1 >= n:
        return _EntityResult(decoded: "&", end_pos: pos + 1)
    val next = html.slice(pos + 1, pos + 2)
    if next == "#":
        var cursor = pos + 2
        var hex = false
        if (
            cursor < n and
            (html.slice(cursor, cursor + 1) == "x" or
             html.slice(cursor, cursor + 1) == "X")
        ):
            hex = true
            cursor = cursor + 1
        val digit_start = cursor
        var code = 0i64
        var valid = true
        while cursor < n and valid:
            val digit = _entity_digit(
                html.slice(cursor, cursor + 1), hex
            )
            if digit < 0:
                valid = false
            else:
                if code <= 0x110000:
                    code = code * (if hex: 16 else: 10) + digit
                    if code > 0x110000:
                        code = 0x110000
                cursor = cursor + 1
        if cursor == digit_start:
            return _EntityResult(decoded: "&", end_pos: pos + 1)
        if cursor < n and html.slice(cursor, cursor + 1) == ";":
            cursor = cursor + 1
        return _EntityResult(
            decoded: _codepoint_text(_normalize_numeric_character_reference(code)),
            end_pos: cursor
        )
    var match_length = n - pos - 1
    if match_length > HTML_NAMED_REFERENCE_MAX_LENGTH:
        match_length = HTML_NAMED_REFERENCE_MAX_LENGTH
    while match_length > 0:
        val entity_end = pos + 1 + match_length
        val entity_name = html.slice(pos + 1, entity_end)
        val named_index = _named_reference_index(entity_name)
        if named_index >= 0:
            val has_semicolon = entity_name.ends_with(";")
            val next = if entity_end < n:
                html.slice(entity_end, entity_end + 1)
            else:
                ""
            if (
                not has_semicolon and in_attribute and
                _is_ascii_alnum_or_equals(next)
            ):
                return _EntityResult(
                    decoded: html.slice(pos, entity_end),
                    end_pos: entity_end
                )
            return _EntityResult(
                decoded: HTML_NAMED_REFERENCE_VALUES[named_index],
                end_pos: entity_end
            )
        match_length = match_length - 1
    _EntityResult(decoded: "&", end_pos: pos + 1)

fn _decode_character_references(value: text) -> text:
    if not value.contains("&"):
        return value
    var parts: [text] = []
    var pos = 0
    var literal_start = 0
    while pos < value.len():
        if value.slice(pos, pos + 1) == "&":
            if pos > literal_start:
                parts.push(value.slice(literal_start, pos))
            val entity = _parse_entity(value, pos, true)
            parts.push(entity.decoded)
            pos = entity.end_pos
            literal_start = pos
        else:
            pos = pos + 1
    if literal_start < value.len():
        parts.push(value.slice(literal_start, value.len()))
    parts.join("")

# =========================================================================
# String scanning utilities
# =========================================================================

fn _find_char(s: text, ch: text, start: i32) -> i32:
    """Find first occurrence of single char ch in s starting at start. Returns -1 if not found."""
    val n = s.len()
    var i = start
    while i < n:
        if s.slice(i, i + 1) == ch:
            return i
        i = i + 1
    -1

fn _find_substr(s: text, needle: text, start: i32) -> i32:
    """Find first occurrence of needle in s starting at start. Returns -1 if not found."""
    val n = s.len()
    val m = needle.len()
    if m == 0:
        return start
    val limit = n - m
    var i = start
    while i <= limit:
        if s.slice(i, i + m) == needle:
            return i
        i = i + 1
    -1

fn _find_tag_close(s: text, start: i32) -> i32:
    """Find the closing > of a tag, respecting quoted attribute values."""
    val n = s.len()
    var i = start
    var in_quote = ""
    while i < n:
        val c = s.slice(i, i + 1)
        if in_quote != "":
            if c == in_quote:
                in_quote = ""
        elif c == "\"" or c == "'":
            in_quote = c
        elif c == ">":
            return i
        i = i + 1
    -1

fn _scan_char_data(s: text, start: i32) -> i32:
    """Scan from start until < or & or end. Returns end position."""
    val n = s.len()
    var i = start
    while i < n:
        val c = s.slice(i, i + 1)
        if c == "<" or c == "&":
            return i
        i = i + 1
    n

fn _is_alpha_char(c: text) -> bool:
    """True if c is a letter a-z or A-Z."""
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")

fn _strip_tag_name(raw: text) -> text:
    """Extract just the tag name from a raw end-tag inner string."""
    val n = raw.len()
    var end = 0
    var done = false
    while end < n and not done:
        val c = raw.slice(end, end + 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "/":
            done = true
        else:
            end = end + 1
    raw.slice(0, end).lower()

fn _split_first_word(s: text) -> text:
    """Return the first whitespace-delimited word from s."""
    val n = s.len()
    var end = 0
    var done = false
    while end < n and not done:
        val c = s.slice(end, end + 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            done = true
        else:
            end = end + 1
    s.slice(0, end)
