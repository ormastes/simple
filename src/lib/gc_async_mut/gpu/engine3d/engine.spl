# 3D Engine — Engine Facade
#
# High-level entry point that auto-selects the best available 3D rendering
# backend and delegates all operations to it.
#
# Backend priority: CPU scene renderer plus optional Vulkan font adapter.
#
# Usage:
#   use std.gpu.engine3d.engine.{Engine3D}
#
#   var engine = Engine3D.create(800, 600)
#   engine.clear(0xFF000000)
#   engine.present()
#   val pixels = engine.read_pixels()
#
# @tag:stdlib
# @tag:api
# @tag:gpu

use std.gpu.engine3d.backend.{RenderBackend3D}
use std.gpu.engine3d.backend_cpu.{CpuBackend3D}
use std.gpu.engine3d.types3d.{Vertex3D, Material3DParams, LightParams3D, mat4_identity}
use std.gpu.engine3d.resource_pool.{ResourcePool3D, TextureHandle3D, BufferHandle3D, ShaderHandle3D, PipelineHandle3D}
use std.gpu.engine3d.texture3d.{TextureDescriptor3D, SamplerDescriptor3D, TextureView3D}
use std.gpu.engine3d.texture3d.{TEX_DIM_2D, TEX_DIM_3D, TEX_DIM_CUBE, TEX_FMT_RGBA8_UNORM, TEX_FMT_DEPTH32_FLOAT}
use std.gpu.engine3d.texture3d.{TEX_USAGE_TEXTURE_BINDING, TEX_USAGE_COPY_DST}
use std.gc_async_mut.text_layout.font_renderer.{
    FontCacheStats, FontGlyphRun, FontRenderBatch, FontRenderConfig, FontRenderer,
    font_execution_plan_into, font_render_config_selection_supported
}
use std.gc_async_mut.gpu.engine2d.font_owner.{Engine2DFontOwner}
use std.common.gpu.font_atlas_composite.{font_atlas_subrect_pixels, font_destination_origin}
use std.gpu.engine3d.color3d.{blend3d}
use std.gpu.engine3d.vulkan_font_adapter.{VulkanFontAdapter3D, VulkanFontAdapter3DEvidence}
use std.common.gpu.font_owner_fault_receipt.{FONT_OWNER_FAULT_NONE}

fn engine3d_font_frame_target_allows(current: text, requested: text) -> bool:
    current == "" or current == requested

fn engine3d_font_completion_target(completed: bool, cpu_fallback_count: i64) -> text:
    if completed: return "vulkan"
    if cpu_fallback_count > 0: return "cpu"
    "unavailable"

val ENGINE3D_FONT_EXECUTION_TARGETS: [text] = ["vulkan", "cpu"]

class _PendingFontCpuFallback:
    x: i32
    y: i32
    batch: FontRenderBatch

# ============================================================================
# Engine3D
# ============================================================================

class Engine3D:
    """3D rendering engine with automatic backend selection.

    Creates the best available backend at initialization time. All rendering
    methods delegate to the active backend through the RenderBackend3D trait.

    Lifecycle:
        1. Engine3D.create(width, height)  — auto-detect and init backend
        2. clear(), submit_triangle(), present() — render frames
        3. shutdown()                      — release resources

    Example:
        var engine = Engine3D.create(800, 600)
        engine.clear(0xFF333333)
        engine.present()
        val pixels = engine.read_pixels()
        engine.shutdown()
    """

    _cpu: CpuBackend3D
    _backend_name: text
    _w: i32
    _h: i32
    _resources: ResourcePool3D
    # One-slot ownership avoids returning or unwrapping FontRenderer across a
    # native aggregate boundary. Direct array-element access is the same
    # proven channel used by Engine2D.
    _font_owner: Engine2DFontOwner
    _vulkan_font: VulkanFontAdapter3D? = nil
    _vulkan_font_evidence: VulkanFontAdapter3DEvidence? = nil
    _font_receipt_frame_sequence: i64 = 0
    _font_receipt_ready: bool = false
    _font_receipt_atlas_handle: i64 = 0
    _font_receipt_texture_binding_ready: bool = false
    _font_receipt_atlas_width: i64 = 0
    _font_receipt_atlas_height: i64 = 0
    _font_receipt_atlas_upload_count: i64 = 0
    _font_receipt_atlas_uploaded_bytes: i64 = 0
    _font_receipt_hud_vertex_upload_count: i64 = 0
    _font_receipt_hud_vertex_uploaded_bytes: i64 = 0
    _font_receipt_world_vertex_upload_count: i64 = 0
    _font_receipt_world_vertex_uploaded_bytes: i64 = 0
    _font_cpu_comparator: bool = false
    _vulkan_pixels: [u32] = []
    _font_frame_target: text = ""
    _font_readback_target: text = ""
    last_font_execution_attempts: [text] = []
    last_font_execution_target: text = ""
    _pending_font_cpu_fallbacks: [_PendingFontCpuFallback] = []
    _predrawn_font_cpu_fallback_count: i64
    _font_plan_scratch: [text]
    _font_attempt_scratch: [text]
    _font_screen_x: i32
    _font_screen_y: i32
    _font_screen_depth: f32
    _font_owner_fault_mask: i64
    _font_owner_last_fault: i64
    _font_owner_fault_sequence: i64
    _font_device_loss_sequence: i64
    _font_owner_fault_identity_unchanged: bool
    _font_owner_fault_fallback_count: i64
    _font_shutdown_wait_idle_observed: bool
    _font_adapter_observed_sequence: i64
    _font_adapter_observed_fallback_count: i64
    _font_install_failure_pending: bool
    _view: [f32]
    _proj: [f32]

    me _ensure_font_renderer():
        if self._font_owner.active.len() == 0:
            self._font_owner.active = [FontRenderer.new()]

    me _capture_vulkan_font_fault_state(adapter: VulkanFontAdapter3D):
        val adapter_sequence = adapter.font_fault_sequence
        if adapter_sequence < self._font_adapter_observed_sequence:
            self._font_adapter_observed_sequence = 0
        val previous_sequence = self._font_owner_fault_sequence
        val sequence_delta = adapter_sequence - self._font_adapter_observed_sequence
        if sequence_delta > 0:
            self._font_owner_fault_sequence = self._font_owner_fault_sequence + sequence_delta
            self._font_owner_fault_mask = self._font_owner_fault_mask | adapter.font_fault_mask
            self._font_owner_last_fault = adapter.font_last_fault
            if adapter.font_device_loss_sequence > self._font_adapter_observed_sequence:
                self._font_device_loss_sequence = previous_sequence + (
                    adapter.font_device_loss_sequence - self._font_adapter_observed_sequence
                )
        self._font_owner_fault_identity_unchanged = (self._font_owner_fault_identity_unchanged and
            adapter.font_fault_identity_unchanged)
        self._font_adapter_observed_sequence = adapter_sequence
        val adapter_fallbacks = adapter.font_fault_fallback_count
        if adapter_fallbacks < self._font_adapter_observed_fallback_count:
            self._font_adapter_observed_fallback_count = 0
        val fallback_delta = adapter_fallbacks - self._font_adapter_observed_fallback_count
        if fallback_delta > 0:
            self._font_owner_fault_fallback_count = self._font_owner_fault_fallback_count + fallback_delta
        self._font_adapter_observed_fallback_count = adapter_fallbacks
        self._font_shutdown_wait_idle_observed = (
            self._font_shutdown_wait_idle_observed or adapter.shutdown_wait_idle_observed())

    # ========================================================================
    # Constructors
    # ========================================================================

    static fn create(width: i32, height: i32) -> Engine3D:
        """Create engine with auto-detected best backend.

        The CPU scene renderer remains the portable default. Call
        `create_with_backend(..., "vulkan")` for native font composition.

        Args:
            width: Framebuffer width in pixels
            height: Framebuffer height in pixels

        Returns:
            Initialized Engine3D
        """
        Engine3D.create_with_backend(width, height, "cpu")

    static fn create_with_backend(width: i32, height: i32, backend_name: text) -> Engine3D:
        """Create engine with a specific backend.

        Args:
            width: Framebuffer width in pixels
            height: Framebuffer height in pixels
            backend_name: `"cpu"`, `"vulkan"`, or `"vulkan-font"`; both
                Vulkan aliases install the font adapter while retaining the
                CPU scene renderer

        Returns:
            Initialized Engine3D (falls back to cpu for unknown names)
        """
        var cpu = CpuBackend3D.create()
        cpu.init(width, height)
        var engine = Engine3D(
            _cpu: cpu,
            _backend_name: "cpu",
            _w: width,
            _h: height,
            _resources: ResourcePool3D.create(),
            _font_owner: Engine2DFontOwner.new(),
            last_font_execution_attempts: [],
            _pending_font_cpu_fallbacks: [],
            _predrawn_font_cpu_fallback_count: 0,
            _font_plan_scratch: [],
            _font_attempt_scratch: [],
            _font_screen_x: 0,
            _font_screen_y: 0,
            _font_screen_depth: 0.0f32,
            _font_owner_fault_mask: 0,
            _font_owner_last_fault: FONT_OWNER_FAULT_NONE,
            _font_owner_fault_sequence: 0,
            _font_device_loss_sequence: 0,
            _font_owner_fault_identity_unchanged: true,
            _font_owner_fault_fallback_count: 0,
            _font_shutdown_wait_idle_observed: false,
            _font_adapter_observed_sequence: 0,
            _font_adapter_observed_fallback_count: 0,
            _font_install_failure_pending: false,
            _view: mat4_identity(),
            _proj: mat4_identity()
        )
        if backend_name == "vulkan" or backend_name == "vulkan-font":
            engine.install_vulkan_font_backend()
        engine

    # ========================================================================
    # Backend Info
    # ========================================================================

    fn backend_name() -> text:
        """Get the honest scene/font backend identity."""
        self._backend_name

    me install_vulkan_font_backend() -> bool:
        val installed = self._vulkan_font
        if installed != nil:
            return installed.?.ready
        var adapter = VulkanFontAdapter3D.create(self._w, self._h)
        self._font_adapter_observed_sequence = 0
        self._font_adapter_observed_fallback_count = 0
        self._capture_vulkan_font_fault_state(adapter)
        if not adapter.ready:
            adapter.shutdown()
            self._capture_vulkan_font_fault_state(adapter)
            self._font_install_failure_pending = true
            return false
        self._vulkan_font = adapter
        self._font_install_failure_pending = false
        self._backend_name = "vulkan-font"
        true

    me enable_font_cpu_comparator(enabled: bool):
        self._font_cpu_comparator = enabled

    fn vulkan_font_evidence() -> VulkanFontAdapter3DEvidence?:
        self._vulkan_font_evidence

    fn vulkan_font_receipt_frame_sequence() -> i64: self._font_receipt_frame_sequence
    fn vulkan_font_receipt_ready() -> bool: self._font_receipt_ready
    fn vulkan_font_receipt_atlas_handle() -> i64: self._font_receipt_atlas_handle
    fn vulkan_font_receipt_texture_binding_ready() -> bool: self._font_receipt_texture_binding_ready
    fn vulkan_font_receipt_atlas_width() -> i64: self._font_receipt_atlas_width
    fn vulkan_font_receipt_atlas_height() -> i64: self._font_receipt_atlas_height
    fn vulkan_font_receipt_atlas_upload_count() -> i64: self._font_receipt_atlas_upload_count
    fn vulkan_font_receipt_atlas_uploaded_bytes() -> i64: self._font_receipt_atlas_uploaded_bytes
    fn vulkan_font_receipt_hud_vertex_upload_count() -> i64: self._font_receipt_hud_vertex_upload_count
    fn vulkan_font_receipt_hud_vertex_uploaded_bytes() -> i64: self._font_receipt_hud_vertex_uploaded_bytes
    fn vulkan_font_receipt_world_vertex_upload_count() -> i64: self._font_receipt_world_vertex_upload_count
    fn vulkan_font_receipt_world_vertex_uploaded_bytes() -> i64: self._font_receipt_world_vertex_uploaded_bytes

    fn font_owner_fault_receipt() -> i64: self._font_owner_last_fault
    fn font_owner_fault_mask() -> i64: self._font_owner_fault_mask
    fn font_owner_fault_sequence() -> i64: self._font_owner_fault_sequence
    fn font_device_loss_sequence() -> i64: self._font_device_loss_sequence
    fn font_device_loss_observed() -> bool: self._font_device_loss_sequence > 0
    fn font_owner_fault_identity_unchanged() -> bool: self._font_owner_fault_identity_unchanged
    fn font_owner_fault_fallback_count() -> i64: self._font_owner_fault_fallback_count
    fn vulkan_font_shutdown_wait_idle_observed() -> bool:
        self._font_shutdown_wait_idle_observed

    me _clear_vulkan_font_receipts():
        self._font_receipt_frame_sequence = 0
        self._font_receipt_ready = false
        self._font_receipt_atlas_handle = 0
        self._font_receipt_texture_binding_ready = false
        self._font_receipt_atlas_width = 0
        self._font_receipt_atlas_height = 0
        self._font_receipt_atlas_upload_count = 0
        self._font_receipt_atlas_uploaded_bytes = 0
        self._font_receipt_hud_vertex_upload_count = 0
        self._font_receipt_hud_vertex_uploaded_bytes = 0
        self._font_receipt_world_vertex_upload_count = 0
        self._font_receipt_world_vertex_uploaded_bytes = 0

    fn font_execution_attempts() -> [text]:
        var snapshot: [text] = []
        for attempt in self.last_font_execution_attempts:
            snapshot.push(attempt)
        snapshot
    fn font_execution_target() -> text: self.last_font_execution_target

    # ========================================================================
    # Core — Identity & Lifecycle
    # ========================================================================

    fn name() -> text:
        self._cpu.name()

    me init(width: i32, height: i32) -> bool:
        val initialized = self._cpu.init(width, height)
        if initialized:
            self._w = width
            self._h = height
        initialized

    me shutdown():
        self.unload_font()
        val active = self._vulkan_font
        if active != nil:
            var vulkan = active.?
            vulkan.shutdown()
            self._capture_vulkan_font_fault_state(vulkan)
            if vulkan.shutdown_complete():
                self._vulkan_font = nil
            else:
                self._vulkan_font = vulkan
        else:
            self._vulkan_font = nil
        self._clear_vulkan_font_receipts()
        self._font_install_failure_pending = false
        self._pending_font_cpu_fallbacks.clear()
        self._predrawn_font_cpu_fallback_count = 0
        self.last_font_execution_attempts = []
        self._font_attempt_scratch.clear()
        self._font_plan_scratch.clear()
        self._cpu.shutdown()

    me begin_frame():
        self._cpu.begin_frame()
        self._vulkan_pixels = []
        self._vulkan_font_evidence = nil
        self._clear_vulkan_font_receipts()
        self._font_frame_target = ""
        self._font_readback_target = ""
        self._pending_font_cpu_fallbacks.clear()
        self._predrawn_font_cpu_fallback_count = 0
        self.last_font_execution_attempts = []
        self._font_attempt_scratch.clear()
        self._font_plan_scratch.clear()
        self.last_font_execution_target = ""
        val active = self._vulkan_font
        if active != nil:
            var vulkan = active.?
            if vulkan.font_device_loss_sequence == 0:
                vulkan.begin_frame()
            self._capture_vulkan_font_fault_state(vulkan)
            self._vulkan_font = vulkan

    me end_frame():
        val active = self._vulkan_font
        if active != nil:
            var vulkan = active.?
            val evidence = vulkan.end_frame()
            self._capture_vulkan_font_fault_state(vulkan)
            self._vulkan_font_evidence = evidence
            self._font_receipt_frame_sequence = evidence.frame_sequence
            self._font_receipt_ready = evidence.ready
            self._font_receipt_atlas_handle = evidence.atlas_handle
            self._font_receipt_texture_binding_ready = evidence.device.texture_binding_ready
            self._font_receipt_atlas_width = evidence.atlas_width
            self._font_receipt_atlas_height = evidence.atlas_height
            self._font_receipt_atlas_upload_count = evidence.atlas_upload_count
            self._font_receipt_atlas_uploaded_bytes = evidence.atlas_uploaded_bytes
            self._font_receipt_hud_vertex_upload_count = evidence.hud_vertex_upload_count
            self._font_receipt_hud_vertex_uploaded_bytes = evidence.hud_vertex_uploaded_bytes
            self._font_receipt_world_vertex_upload_count = evidence.world_vertex_upload_count
            self._font_receipt_world_vertex_uploaded_bytes = evidence.world_vertex_uploaded_bytes
            self._vulkan_pixels = []
            val expected_bytes = self._w.to_i64() * self._h.to_i64() * 4
            val completed = (self._font_frame_target == "vulkan" and evidence.ready and
                evidence.hud_draws + evidence.world_draws > 0 and
                evidence.pixels_rgba8.len() == expected_bytes)
            val completion_target = engine3d_font_completion_target(
                completed, self._pending_font_cpu_fallbacks.len() + self._predrawn_font_cpu_fallback_count
            )
            if self._font_frame_target == "vulkan":
                var completion_attempts: [text] = []
                for attempt in self.last_font_execution_attempts:
                    completion_attempts.push(attempt)
                val completion_reason = if evidence.reason == "": "completion-failed" else: evidence.reason
                completion_attempts.push(if completed: "vulkan:success" else: "vulkan:" + completion_reason)
                self.last_font_execution_attempts = completion_attempts
            if completion_target == "vulkan":
                var i: i64 = 0
                while i + 3 < evidence.pixels_rgba8.len():
                    val r = evidence.pixels_rgba8[i].to_u32()
                    val g = evidence.pixels_rgba8[i + 1].to_u32()
                    val b = evidence.pixels_rgba8[i + 2].to_u32()
                    val a = evidence.pixels_rgba8[i + 3].to_u32()
                    self._vulkan_pixels.push((a << 24u32) | (r << 16u32) | (g << 8u32) | b)
                    i = i + 4
                self._font_readback_target = "vulkan"
                self.last_font_execution_target = "vulkan"
            elif completion_target == "cpu":
                var replayed = true
                if self._pending_font_cpu_fallbacks.len() > 0:
                    val target_w = self._cpu.width()
                    val target_h = self._cpu.height()
                    var target = self._cpu.read_pixels()
                    var drawn = false
                    for pending in self._pending_font_cpu_fallbacks:
                        if self._draw_font_batch_hud_into(
                            pending.x, pending.y, pending.batch, target_w, target_h, target
                        ):
                            drawn = true
                        else:
                            replayed = false
                    if drawn:
                        self._cpu.draw_image(0, 0, target_w, target_h, target)
                if replayed:
                    vulkan.record_font_fallback()
                    self._capture_vulkan_font_fault_state(vulkan)
                    self._font_frame_target = "cpu"
                    self._font_readback_target = "cpu"
                    self.last_font_execution_target = "cpu"
                    var fallback_attempts: [text] = []
                    for attempt in self.last_font_execution_attempts:
                        fallback_attempts.push(attempt)
                    fallback_attempts.push("cpu:deferred-success")
                    self.last_font_execution_attempts = fallback_attempts
                else:
                    self._font_readback_target = "unavailable"
                    self.last_font_execution_target = ""
            elif self._font_frame_target == "vulkan":
                self._font_readback_target = "unavailable"
                self.last_font_execution_target = ""
            self._pending_font_cpu_fallbacks.clear()
            self._predrawn_font_cpu_fallback_count = 0
            self._vulkan_font = vulkan
        self._cpu.end_frame()

    me present():
        self._cpu.present()

    # ========================================================================
    # Core — View
    # ========================================================================

    me set_camera(view: [f32], proj: [f32]):
        self._view = view
        self._proj = proj
        self._cpu.set_camera(view, proj)

    me set_viewport(x: i32, y: i32, w: i32, h: i32):
        self._cpu.set_viewport(x, y, w, h)

    # ========================================================================
    # Core — Clear
    # ========================================================================

    me clear(color: u32):
        self._cpu.clear(color)

    me clear_depth():
        self._cpu.clear_depth()

    # ========================================================================
    # Core — Geometry Submission
    # ========================================================================

    me submit_triangle(v0: Vertex3D, v1: Vertex3D, v2: Vertex3D, material: Material3DParams, model: [f32]):
        self._cpu.submit_triangle(v0, v1, v2, material, model)

    # ========================================================================
    # Core — Lighting
    # ========================================================================

    me set_lights(lights: [LightParams3D]):
        self._cpu.set_lights(lights)

    me set_ambient(color: u32, intensity: f32):
        self._cpu.set_ambient(color, intensity)

    # ========================================================================
    # Core — Render State
    # ========================================================================

    me set_depth_test(enabled: bool):
        self._cpu.set_depth_test(enabled)

    me set_cull_mode(mode: i32):
        self._cpu.set_cull_mode(mode)

    me set_blend_mode(mode: i32):
        self._cpu.set_blend_mode(mode)

    # ========================================================================
    # Core — Stencil
    # ========================================================================

    me set_stencil_mask(mask: [u8], w: i32, h: i32):
        self._cpu.set_stencil_mask(mask, w, h)

    me clear_stencil_mask():
        self._cpu.clear_stencil_mask()

    # ========================================================================
    # Core — Render Target
    # ========================================================================

    me set_render_target(pixels: [u32], w: i32, h: i32):
        self._cpu.set_render_target(pixels, w, h)

    me reset_render_target():
        self._cpu.reset_render_target()

    # ========================================================================
    # Core — Pixel I/O
    # ========================================================================

    me draw_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        self._cpu.draw_image(x, y, w, h, pixels)

    me load_font(path: text) -> bool:
        self._ensure_font_renderer()
        var fonts: FontRenderer = self._font_owner.active[0]
        val loaded = fonts.try_load_runtime_ttf(path)
        self._font_owner.active[0] = fonts
        loaded

    me unload_font():
        if self._font_owner.active.len() > 0:
            var fonts: FontRenderer = self._font_owner.active[0]
            fonts.clear_ttf()
            self._font_owner.active[0] = fonts
        self._font_owner.active = []

    me font_cache_stats() -> FontCacheStats:
        self._ensure_font_renderer()
        var fonts: FontRenderer = self._font_owner.active[0]
        val stats = fonts.cache_stats()
        self._font_owner.active[0] = fonts
        stats

    me _draw_font_batch_hud_into(x: i32, y: i32, batch: FontRenderBatch,
                                 target_w: i32, target_h: i32, target: [u32]) -> bool:
        if not batch.material_supported() or batch.is_empty():
            return false
        var drawn = false
        var i = 0
        while i < batch.quads.len():
            val quad = batch.quads[i]
            val dst_x = font_destination_origin(x, quad.dst_x, quad.width)
            val dst_y = font_destination_origin(y, quad.dst_y, quad.height)
            if (dst_x != nil and dst_y != nil and quad.width > 0 and quad.height > 0 and
                dst_x.?.to_i64() < target_w.to_i64() and dst_y.?.to_i64() < target_h.to_i64() and
                dst_x.?.to_i64() + quad.width.to_i64() > 0 and dst_y.?.to_i64() + quad.height.to_i64() > 0):
                val pixels = font_atlas_subrect_pixels(batch.atlas_pixels, batch.atlas_width, batch.atlas_height,
                    quad.atlas_x, quad.atlas_y, quad.width, quad.height, quad.color)
                if pixels.len() > 0:
                    var row = 0
                    while row < quad.height:
                        var col = 0
                        while col < quad.width:
                            val tx = dst_x.?.to_i64() + col.to_i64()
                            val ty = dst_y.?.to_i64() + row.to_i64()
                            if tx >= 0 and tx < target_w.to_i64() and ty >= 0 and ty < target_h.to_i64():
                                val src = pixels[row * quad.width + col]
                                val target_index = ty * target_w.to_i64() + tx
                                if src != 0u32 and target_index.to_i64() < target.len():
                                    target[target_index] = blend3d(src, target[target_index])
                                    drawn = true
                            col = col + 1
                        row = row + 1
            i = i + 1
        drawn

    me _draw_font_batch_hud(x: i32, y: i32, batch: FontRenderBatch) -> bool:
        val target_w = self._cpu.width()
        val target_h = self._cpu.height()
        var target = self._cpu.read_pixels()
        val drawn = self._draw_font_batch_hud_into(x, y, batch, target_w, target_h, target)
        if drawn:
            self._cpu.draw_image(0, 0, target_w, target_h, target)
        drawn

    me _draw_font_batch_policy(x: i32, y: i32, depth: f32, world: bool,
                               batch: FontRenderBatch, plan: [text]) -> bool:
        if not batch.material_supported() or plan.len() == 0:
            return false
        var attempts = self._font_attempt_scratch
        attempts.clear()
        var winner = ""
        var vulkan_failed = false
        for target in plan:
            if not engine3d_font_frame_target_allows(self._font_frame_target, target):
                attempts.push(target + ":frame-target=" + self._font_frame_target)
            elif target == "vulkan":
                val active = self._vulkan_font
                if active == nil:
                    attempts.push("vulkan:unavailable")
                    if self._font_install_failure_pending:
                        vulkan_failed = true
                else:
                    var vulkan = active.?
                    if vulkan.font_device_loss_sequence > 0:
                        attempts.push("vulkan:device-lost")
                        vulkan_failed = true
                        self._vulkan_font = vulkan
                    else:
                        val drawn = if world:
                            vulkan.draw_world(x, y, depth, batch)
                        else:
                            vulkan.draw_hud(x, y, batch)
                        self._capture_vulkan_font_fault_state(vulkan)
                        self._vulkan_font = vulkan
                        val failure_reason = if vulkan.reason == "": "failed" else: vulkan.reason
                        attempts.push(if drawn: "vulkan:pending" else: "vulkan:" + failure_reason)
                        if drawn:
                            winner = "vulkan-pending"
                            self._font_frame_target = "vulkan"
                            var cpu_ready = false
                            if self._font_cpu_comparator and plan.contains("cpu"):
                                cpu_ready = self._draw_font_batch_hud(x, y, batch)
                            if plan.contains("cpu"):
                                if cpu_ready:
                                    self._predrawn_font_cpu_fallback_count = self._predrawn_font_cpu_fallback_count + 1
                                else:
                                    self._pending_font_cpu_fallbacks.push(
                                        _PendingFontCpuFallback(x: x, y: y, batch: batch)
                                    )
                        else:
                            vulkan_failed = true
            elif target == "cpu":
                val drawn = self._draw_font_batch_hud(x, y, batch)
                attempts.push(if drawn: "cpu:success" else: "cpu:failed")
                if drawn:
                    if vulkan_failed:
                        val failed_active = self._vulkan_font
                        if failed_active != nil:
                            var failed_vulkan = failed_active.?
                            failed_vulkan.record_font_fallback()
                            self._capture_vulkan_font_fault_state(failed_vulkan)
                            self._vulkan_font = failed_vulkan
                        else:
                            self._font_owner_fault_fallback_count = self._font_owner_fault_fallback_count + 1
                        self._font_install_failure_pending = false
                    winner = "cpu"
                    self._font_frame_target = "cpu"
            if winner != "":
                break
        self._font_attempt_scratch = attempts
        self.last_font_execution_attempts = attempts
        self.last_font_execution_target = winner
        if winner == "vulkan-pending":
            self._font_readback_target = "vulkan-pending"
        elif winner == "cpu":
            self._font_readback_target = "cpu"
        winner != ""

    # Materialize the renderer's staged payload locally and pass the batch only
    # inbound. Returning FontRenderBatch across a native call can lose its
    # array fields, while live receiver fields and inbound aggregates are the
    # established safe transfer used by Engine2D.
    me _draw_staged_font_batch_policy(x: i32, y: i32, depth: f32, world: bool,
                                      plan: [text]) -> bool:
        if self._font_owner.active.len() == 0:
            return false
        val batch = FontRenderBatch(
            program_version: self._font_owner.active[0].staged_program_version,
            transform_identity: self._font_owner.active[0].staged_transform_identity,
            font_identity: self._font_owner.active[0].staged_font_identity,
            face_generation: self._font_owner.active[0].staged_face_generation,
            valid: self._font_owner.active[0].staged_valid,
            atlas_width: self._font_owner.active[0].staged_atlas_width,
            atlas_height: self._font_owner.active[0].staged_atlas_height,
            atlas_pixels: self._font_owner.active[0].atlas_pixels,
            quads: self._font_owner.active[0].staged_quads,
            atlas_generation: self._font_owner.active[0].staged_atlas_generation,
            dirty_rects: self._font_owner.active[0].staged_dirty_rects,
            atlas_owner_generation: self._font_owner.active[0].staged_atlas_owner_generation,
            render_config_identity: self._font_owner.active[0].staged_render_config_identity,
            execution_target: self._font_owner.active[0].staged_execution_target,
            execution_policy: self._font_owner.active[0].staged_execution_policy
        )
        self._draw_font_batch_policy(x, y, depth, world, batch, plan)

    me draw_glyph_run_hud(x: i32, y: i32, run: FontGlyphRun, color: u32, font_size: i32) -> bool:
        self._ensure_font_renderer()
        var fonts: FontRenderer = self._font_owner.active[0]
        val staged_count = fonts.stage_glyph_run(run, color, font_size)
        self._font_owner.active[0] = fonts
        if staged_count <= 0:
            return false
        val drawn = self._draw_staged_font_batch_policy(
            x, y, 0.0f32, false, ENGINE3D_FONT_EXECUTION_TARGETS)
        drawn

    me draw_text_hud(x: i32, y: i32, content: text, color: u32, font_size: i32) -> bool:
        self.draw_text_hud_configured(
            x, y, content, color, FontRenderConfig.default_for_size(font_size)
        )

    me draw_text_hud_configured(x: i32, y: i32, content: text, color: u32, config: FontRenderConfig) -> bool:
        var plan = self._font_plan_scratch
        val plan_count = font_execution_plan_into(config, ENGINE3D_FONT_EXECUTION_TARGETS, plan)
        self._font_plan_scratch = plan
        if plan_count <= 0:
            return false
        if plan.len() == 0:
            return false
        if not font_render_config_selection_supported(config):
            return false
        self._ensure_font_renderer()
        var fonts: FontRenderer = self._font_owner.active[0]
        fonts.stage_text_configured(content, color, config)
        self._font_owner.active[0] = fonts
        val drawn = self._draw_staged_font_batch_policy(x, y, 0.0f32, false, plan)
        drawn

    me _font_world_screen_into(x: f32, y: f32, z: f32) -> bool:
        val target_w = self._cpu.width()
        val target_h = self._cpu.height()
        if self._view.len() != 16 or self._proj.len() != 16 or target_w <= 0 or target_h <= 0:
            return false
        val view_x = self._view[0] * x + self._view[4] * y + self._view[8] * z + self._view[12]
        val view_y = self._view[1] * x + self._view[5] * y + self._view[9] * z + self._view[13]
        val view_z = self._view[2] * x + self._view[6] * y + self._view[10] * z + self._view[14]
        val view_w = self._view[3] * x + self._view[7] * y + self._view[11] * z + self._view[15]
        val clip_x = self._proj[0] * view_x + self._proj[4] * view_y + self._proj[8] * view_z + self._proj[12] * view_w
        val clip_y = self._proj[1] * view_x + self._proj[5] * view_y + self._proj[9] * view_z + self._proj[13] * view_w
        val clip_z = self._proj[2] * view_x + self._proj[6] * view_y + self._proj[10] * view_z + self._proj[14] * view_w
        val clip_w = self._proj[3] * view_x + self._proj[7] * view_y + self._proj[11] * view_z + self._proj[15] * view_w
        if clip_w <= 0.0:
            return false
        val ndc_x = clip_x / clip_w
        val ndc_y = clip_y / clip_w
        val ndc_z = clip_z / clip_w
        if ndc_x < -1.0 or ndc_x > 1.0 or ndc_y < -1.0 or ndc_y > 1.0 or ndc_z < -1.0 or ndc_z > 1.0:
            return false
        val screen_x = ((ndc_x + 1.0) * (target_w as f32) / 2.0) as i32
        val screen_y = ((1.0 - ndc_y) * (target_h as f32) / 2.0) as i32
        self._font_screen_x = screen_x
        self._font_screen_y = screen_y
        self._font_screen_depth = ndc_z
        true

    me draw_text_world(x: f32, y: f32, z: f32, content: text, color: u32, font_size: i32) -> bool:
        self.draw_text_world_configured(
            x, y, z, content, color, FontRenderConfig.default_for_size(font_size)
        )

    me draw_text_world_configured(x: f32, y: f32, z: f32, content: text, color: u32, config: FontRenderConfig) -> bool:
        var plan = self._font_plan_scratch
        val plan_count = font_execution_plan_into(config, ENGINE3D_FONT_EXECUTION_TARGETS, plan)
        self._font_plan_scratch = plan
        if plan_count <= 0:
            return false
        if plan.len() == 0:
            return false
        if not font_render_config_selection_supported(config):
            return false
        if not self._font_world_screen_into(x, y, z):
            return false
        self._ensure_font_renderer()
        var fonts: FontRenderer = self._font_owner.active[0]
        fonts.stage_text_configured(content, color, config)
        self._font_owner.active[0] = fonts
        val drawn = self._draw_staged_font_batch_policy(
            self._font_screen_x, self._font_screen_y, self._font_screen_depth, true, plan)
        drawn

    me draw_glyph_run_world(x: f32, y: f32, z: f32, run: FontGlyphRun, color: u32, font_size: i32) -> bool:
        if not self._font_world_screen_into(x, y, z):
            return false
        self._ensure_font_renderer()
        var fonts: FontRenderer = self._font_owner.active[0]
        val staged_count = fonts.stage_glyph_run(run, color, font_size)
        self._font_owner.active[0] = fonts
        if staged_count <= 0:
            return false
        val drawn = self._draw_staged_font_batch_policy(
            self._font_screen_x, self._font_screen_y, self._font_screen_depth,
            true, ENGINE3D_FONT_EXECUTION_TARGETS)
        drawn

    fn read_pixels() -> [u32]:
        if self._font_readback_target == "vulkan-pending" or self._font_readback_target == "unavailable":
            return []
        if (self._font_readback_target == "vulkan" and self._vulkan_font != nil and
            self._vulkan_pixels.len() == self._w.to_i64() * self._h.to_i64()):
            return self._vulkan_pixels
        self._cpu.read_pixels()

    fn read_cpu_comparator_pixels() -> [u32]:
        self._cpu.read_pixels()

    fn read_depth() -> [f32]:
        self._cpu.read_depth()

    fn width() -> i32:
        self._cpu.width()

    fn height() -> i32:
        self._cpu.height()

    # ========================================================================
    # Advanced — Primitive Shapes
    # ========================================================================

    me draw_cube(model: [f32], material: Material3DParams):
        self._cpu.draw_cube(model, material)

    me draw_sphere(model: [f32], material: Material3DParams, segments: i32):
        self._cpu.draw_sphere(model, material, segments)

    me draw_plane(model: [f32], material: Material3DParams):
        self._cpu.draw_plane(model, material)

    me draw_cylinder(model: [f32], material: Material3DParams, segments: i32):
        self._cpu.draw_cylinder(model, material, segments)

    me draw_cone(model: [f32], material: Material3DParams, segments: i32):
        self._cpu.draw_cone(model, material, segments)

    # ========================================================================
