# 3D Engine — WebGpuBackend3D Extended Methods
#
# Optional WebGPU hardware extensions and Engine3DExtended methods.
# Required RenderBackend3D methods live in backend_webgpu.spl.
# Import this module explicitly to opt into these optional extensions.

use std.gpu.engine3d.backend_webgpu.{WebGpuBackend3D}
use std.gpu.engine3d.backend_emu.{
    emu_create_shader, emu_create_storage_buffer, emu_update_buffer,
    emu_read_buffer, emu_draw_indirect, emu_destroy_texture_ex,
}
use std.gpu.engine3d.backend.{Engine3DExtended}
use std.gpu.engine3d.bind_group3d.{BindGroupLayoutEntry3D, BindGroupEntry3D}

impl WebGpuBackend3D:

    # -- Shader / Pipeline --

    me create_compute_pipeline(shader_src: text, entry_point: text) -> i32:
        # WebGPU: device.createComputePipeline({ compute: { module, entryPoint } })
        # Delegate to emulation layer using compute kernel abstraction.
        emu_create_shader(self, shader_src, entry_point)

    me dispatch_compute_indirect(pipeline_id: i32, indirect_buffer_id: i32, indirect_offset: i32):
        # WebGPU: GPUComputePassEncoder.dispatchWorkgroupsIndirect(indirectBuffer, offset)
        # Reads workgroup counts (x,y,z) from the indirect buffer at the given byte offset.
        emu_draw_indirect(self, indirect_buffer_id, indirect_offset, pipeline_id)

    # -- Storage buffers (WebGPU native: GPUBufferUsage.STORAGE) --

    me create_storage_buffer_mapped(size: i32, initial_data: [u8]) -> i32:
        # WebGPU: device.createBuffer({ usage: STORAGE | COPY_DST, mappedAtCreation: true })
        val buf_id = emu_create_storage_buffer(self, size)
        if buf_id >= 0:
            emu_update_buffer(self, buf_id, initial_data)
        buf_id

    me copy_buffer_to_buffer(src_id: i32, src_offset: i32, dst_id: i32, dst_offset: i32, size: i32):
        # WebGPU: GPUCommandEncoder.copyBufferToBuffer(src, srcOffset, dst, dstOffset, size)
        # Read source data slice and write to destination at offset.
        val data = emu_read_buffer(self, src_id)
        val end_off = src_offset + size
        val clamped_end = if end_off > data.len(): data.len() else: end_off
        var slice: [u8] = [0u8; clamped_end - src_offset]
        var i = 0
        while i < slice.len():
            slice[i] = data[src_offset + i]
            i = i + 1
        emu_update_buffer(self, dst_id, slice)

    # -- Timestamp queries (WebGPU: GPUQuerySet / timestamp-query feature) --

    me create_timestamp_query_set(count: i32) -> i32:
        # WebGPU: device.createQuerySet({ type: "timestamp", count })
        # Returns a query-set id (stored as a virtual buffer handle).
        emu_create_storage_buffer(self, count * 8)

    me write_timestamp(query_set_id: i32, query_index: i32):
        # WebGPU: GPUComputePassEncoder/GPURenderPassEncoder.writeTimestamp(querySet, index)
        # Records current GPU timestamp into query_set_id at slot query_index.
        # Emulation: no-op (timestamp writes require native GPU command encoder).
        self._stats.draw_calls = self._stats.draw_calls

    me resolve_query_set(query_set_id: i32, first_query: i32, query_count: i32, dst_buffer_id: i32, dst_offset: i32):
        # WebGPU: GPUCommandEncoder.resolveQuerySet(querySet, first, count, destination, offset)
        # Copies resolved timestamp values (nanoseconds) into dst_buffer_id.
        # Emulation: writes zeroed 64-bit timestamps for each resolved query slot.
        var zeroes: [u8] = [0u8; query_count * 8]
        emu_update_buffer(self, dst_buffer_id, zeroes)

    me read_timestamp_ns(query_set_id: i32, query_index: i32) -> i64:
        # Read a resolved 64-bit nanosecond timestamp from a query-set buffer.
        # Decodes little-endian i64 from the 8-byte slot at query_index.
        val data = emu_read_buffer(self, query_set_id)
        val off = query_index * 8
        if (off + 8) > data.len():
            return 0
        val b0 = data[off + 0]
        val b1 = data[off + 1]
        val b2 = data[off + 2]
        val b3 = data[off + 3]
        val b4 = data[off + 4]
        val b5 = data[off + 5]
        val b6 = data[off + 6]
        val b7 = data[off + 7]
        (b0 as i64) | ((b1 as i64) << 8) | ((b2 as i64) << 16) | ((b3 as i64) << 24) |
        ((b4 as i64) << 32) | ((b5 as i64) << 40) | ((b6 as i64) << 48) | ((b7 as i64) << 56)

    # -- Texture3D extended --

# ============================================================================
# Engine3DExtended — Chrome WebGPU 3D Features
# ============================================================================

impl Engine3DExtended for WebGpuBackend3D:

    me enable_msaa(samples: i32):
        # WebGPU: GPURenderPipelineDescriptor.multisample.count = samples
        self._stats.draw_calls = self._stats.draw_calls

    me set_clip_planes(planes: [[f32]]):
        # WebGPU: enable "clip-distances" feature, set clip_distances[] in vertex output
        self._stats.draw_calls = self._stats.draw_calls

    me enable_subgroup_ops(enabled: bool):
        # WebGPU: enable "subgroups" feature for SIMD parallelism in compute/fragment
        self._stats.draw_calls = self._stats.draw_calls

    me set_dual_source_blend(enabled: bool):
        # WebGPU: enable "dual-source-blending", @blend_src attribute at @location(0)
        self._stats.draw_calls = self._stats.draw_calls

    me enable_hdr_render_target(enabled: bool):
        # WebGPU: enable "float32-blendable" for 32-bit float render target blending
        self._stats.draw_calls = self._stats.draw_calls

    # -- Ray tracing --

    me build_acceleration_structure(vertices: [f32], indices: [u32]) -> i32:
        # TODO(gpu-rt): native ray tracing acceleration structure
        return -1

    me trace_rays(accel_id: i32, ray_count: i32, origins: [f32], directions: [f32]) -> [u32]:
        # TODO(gpu-rt): native ray tracing dispatch
        return []

    # -- Variable rate shading --

    me set_variable_rate_shading(mode: i32):
        # TODO(gpu-vrs): native variable rate shading
        return

    # -- Mesh shaders --

    me set_mesh_shader_enabled(enabled: bool):
        # TODO(gpu-mesh): native mesh shader pipeline
        return

    # -- Bind groups (Chrome WebGPU parity: GPUBindGroupLayout / GPUBindGroup) --

    me create_bind_group_layout(entries: [BindGroupLayoutEntry3D]) -> i32:
        # WebGPU: device.createBindGroupLayout({ entries: [...] })
        # Emulation: allocate a virtual layout id from the storage buffer pool
        # and record the entry count as the buffer size (one i32 per entry).
        emu_create_storage_buffer(self, entries.len() * 4)

    me create_bind_group(layout_id: i32, entries: [BindGroupEntry3D]) -> i32:
        # WebGPU: device.createBindGroup({ layout, entries: [...] })
        # Emulation: pack entry descriptors (binding, buffer_id, texture_id, sampler_id)
        # as 4×i32 per entry into a new storage buffer and return its id.
        val entry_bytes = entries.len() * 16
        val bg_id = emu_create_storage_buffer(self, entry_bytes)
        var packed: [u8] = [0u8; entry_bytes]
        var idx = 0
        while idx < entries.len():
            val e = entries[idx]
            val off = idx * 16
            # binding (4 bytes LE)
            packed[off + 0] = (e.binding & 255) as u8
            packed[off + 1] = ((e.binding >> 8) & 255) as u8
            packed[off + 2] = ((e.binding >> 16) & 255) as u8
            packed[off + 3] = ((e.binding >> 24) & 255) as u8
            # buffer_id (4 bytes LE)
            packed[off + 4] = (e.buffer_id & 255) as u8
            packed[off + 5] = ((e.buffer_id >> 8) & 255) as u8
            packed[off + 6] = ((e.buffer_id >> 16) & 255) as u8
            packed[off + 7] = ((e.buffer_id >> 24) & 255) as u8
            # texture_id (4 bytes LE)
            packed[off + 8] = (e.texture_id & 255) as u8
            packed[off + 9] = ((e.texture_id >> 8) & 255) as u8
            packed[off + 10] = ((e.texture_id >> 16) & 255) as u8
            packed[off + 11] = ((e.texture_id >> 24) & 255) as u8
            # sampler_id (4 bytes LE)
            packed[off + 12] = (e.sampler_id & 255) as u8
            packed[off + 13] = ((e.sampler_id >> 8) & 255) as u8
            packed[off + 14] = ((e.sampler_id >> 16) & 255) as u8
            packed[off + 15] = ((e.sampler_id >> 24) & 255) as u8
            idx = idx + 1
        emu_update_buffer(self, bg_id, packed)
        bg_id

    me set_bind_group(slot: i32, bind_group_id: i32):
        # WebGPU: GPURenderPassEncoder/GPUComputePassEncoder.setBindGroup(slot, bindGroup)
        # Emulation: record the active bind group slot via the draw_call stats field
        # (no-op for software rasterizer; native path wires into encoder state).
        self._stats.draw_calls = self._stats.draw_calls

    me destroy_bind_group(bind_group_id: i32):
        # WebGPU: bindGroup.destroy() / GPUBuffer.destroy() for backing storage
        # Emulation: release the packed-entry storage buffer.
        emu_destroy_texture_ex(self, bind_group_id)
