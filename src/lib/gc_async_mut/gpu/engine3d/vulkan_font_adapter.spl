# Public Engine3D adapter for the dedicated native Vulkan font pipelines.

use std.nogc_sync_mut.engine.render.backend3d.{
    RenderBackend3D, PipelineHandle, BufferHandle, TextureHandle, RenderPassHandle,
    TextureFormat3D
}
use std.nogc_sync_mut.engine.render.vulkan_backend3d.{
    VulkanRenderBackend3D, VulkanBackend3DDeviceEvidence
}
use std.gc_async_mut.text_layout.font_renderer.{FontRenderBatch, font_render_batch_atlas_owner_identity}
use std.gpu.engine3d.font_hud_material.{font_hud_vertices_into, font_world_vertices_into}
use std.gpu.engine3d.font_vulkan_spirv.{
    font_hud_vulkan_vertex_spirv, font_world_vulkan_vertex_spirv,
    font_vulkan_fragment_spirv
}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.gpu.font_atlas_composite.{font_atlas_composite_cache_identity}

class VulkanFontAdapter3DEvidence:
    ready: bool
    reason: text
    device: VulkanBackend3DDeviceEvidence
    hud_pipeline_handle: i64
    world_pipeline_handle: i64
    atlas_handle: i64
    atlas_owner_identity: text
    atlas_generation: i64
    atlas_payload_sha256: text
    frame_sequence: i64
    atlas_width: i64
    atlas_height: i64
    atlas_upload_count: i64
    atlas_uploaded_bytes: i64
    hud_vertex_upload_count: i64
    hud_vertex_uploaded_bytes: i64
    world_vertex_upload_count: i64
    world_vertex_uploaded_bytes: i64
    sampler_handle: i64
    hud_draws: i64
    world_draws: i64
    pixels_rgba8: [u8]

fn vulkan_font_atlas_upload_required(cached_owner: text, cached_generation: i64,
                                     target_owner: text, batch: FontRenderBatch) -> bool:
    target_owner == "" or cached_owner != target_owner or cached_generation != batch.atlas_generation

class VulkanFontAdapter3D:
    backend: VulkanRenderBackend3D
    hud_pipeline: PipelineHandle
    world_pipeline: PipelineHandle
    color: TextureHandle
    depth: TextureHandle
    atlas: TextureHandle
    pending_atlas: TextureHandle
    frame_atlas: TextureHandle
    retired_atlases: [TextureHandle]
    transient_vertices: [BufferHandle]
    transient_vertex_capacities: [i64]
    reusable_vertices: [BufferHandle]
    reusable_vertex_capacities: [i64]
    acquired_vertex_capacity: i64
    atlas_width: i32
    atlas_height: i32
    atlas_generation: i64
    atlas_owner_identity: text
    atlas_payload_sha256: text
    pending_atlas_width: i32
    pending_atlas_height: i32
    pending_atlas_generation: i64
    pending_atlas_owner_identity: text
    pending_atlas_payload_sha256: text
    pending_atlas_draw_recorded: bool
    atlas_alpha_scratch: [u8]
    vertex_bytes_scratch: [u8]
    font_artifact_sha256: text
    frame_sequence: i64
    atlas_upload_count: i64
    atlas_uploaded_bytes: i64
    hud_vertex_upload_count: i64
    hud_vertex_uploaded_bytes: i64
    world_vertex_upload_count: i64
    world_vertex_uploaded_bytes: i64
    pass_handle: RenderPassHandle
    width: i32
    height: i32
    frame_active: bool
    ready: bool
    reason: text
    hud_draws: i64
    world_draws: i64
    last_pixels: [u8]
    font_fault_mask: i64
    font_last_fault: i64
    font_fault_sequence: i64
    font_device_loss_sequence: i64
    font_fault_identity_unchanged: bool
    font_fault_fallback_count: i64

    static fn create(width: i32, height: i32) -> VulkanFontAdapter3D:
        var backend = VulkanRenderBackend3D.create()
        var ready = width > 0 and height > 0 and backend.init(width.to_i64(), height.to_i64())
        var reason = if ready: "" else: "vulkan-font-adapter-init-failed"
        var hud_pipeline = PipelineHandle.invalid()
        var world_pipeline = PipelineHandle.invalid()
        var color = TextureHandle.invalid()
        var depth = TextureHandle.invalid()
        if ready:
            val fragment = font_vulkan_fragment_spirv()
            hud_pipeline = backend.create_font_pipeline(font_hud_vulkan_vertex_spirv(), fragment)
            world_pipeline = backend.create_font_world_pipeline(font_world_vulkan_vertex_spirv(), fragment)
            color = backend.create_texture(width.to_i64(), height.to_i64(), TextureFormat3D.Rgba8Unorm)
            depth = backend.create_texture(width.to_i64(), height.to_i64(), TextureFormat3D.Depth32Float)
            ready = (backend.pipeline_native_handle(hud_pipeline) > 0 and
                backend.pipeline_native_handle(world_pipeline) > 0 and
                backend.texture_native_handle(color) > 0 and
                backend.texture_native_handle(depth) > 0)
            if not ready:
                if (backend.pipeline_native_handle(hud_pipeline) <= 0 or
                    backend.pipeline_native_handle(world_pipeline) <= 0):
                    reason = "vulkan-font-program-compile-failed"
                else:
                    reason = "vulkan-font-target-create-failed"
        if not ready:
            backend.record_font_fault_from_runtime(reason, true)
        VulkanFontAdapter3D(
            backend: backend,
            hud_pipeline: hud_pipeline,
            world_pipeline: world_pipeline,
            color: color,
            depth: depth,
            atlas: TextureHandle.invalid(),
            pending_atlas: TextureHandle.invalid(),
            frame_atlas: TextureHandle.invalid(),
            retired_atlases: [],
            transient_vertices: [],
            transient_vertex_capacities: [],
            reusable_vertices: [],
            reusable_vertex_capacities: [],
            acquired_vertex_capacity: 0,
            atlas_width: 0,
            atlas_height: 0,
            atlas_generation: -1,
            atlas_owner_identity: "",
            atlas_payload_sha256: "",
            pending_atlas_width: 0,
            pending_atlas_height: 0,
            pending_atlas_generation: -1,
            pending_atlas_owner_identity: "",
            pending_atlas_payload_sha256: "",
            pending_atlas_draw_recorded: false,
            atlas_alpha_scratch: [],
            vertex_bytes_scratch: [],
            font_artifact_sha256: "",
            frame_sequence: 0,
            atlas_upload_count: 0,
            atlas_uploaded_bytes: 0,
            hud_vertex_upload_count: 0,
            hud_vertex_uploaded_bytes: 0,
            world_vertex_upload_count: 0,
            world_vertex_uploaded_bytes: 0,
            pass_handle: RenderPassHandle.invalid(),
            width: width,
            height: height,
            frame_active: false,
            ready: ready,
            reason: reason,
            hud_draws: 0,
            world_draws: 0,
            last_pixels: [],
            font_fault_mask: backend.font_fault_mask,
            font_last_fault: backend.font_last_fault,
            font_fault_sequence: backend.font_fault_sequence,
            font_device_loss_sequence: backend.font_device_loss_sequence,
            font_fault_identity_unchanged: backend.font_fault_identity_unchanged,
            font_fault_fallback_count: backend.font_fault_fallback_count
        )

    me _sync_backend_fault_state():
        self.font_fault_mask = self.backend.font_fault_mask
        self.font_last_fault = self.backend.font_last_fault
        self.font_fault_sequence = self.backend.font_fault_sequence
        self.font_device_loss_sequence = self.backend.font_device_loss_sequence
        self.font_fault_identity_unchanged = self.backend.font_fault_identity_unchanged
        self.font_fault_fallback_count = self.backend.font_fault_fallback_count
        if self.backend.font_device_loss_sequence > 0:
            self.ready = false

    me record_font_fault(reason: text, identity_unchanged: bool):
        self.reason = reason
        self.backend.record_font_fault(reason, identity_unchanged)
        self._sync_backend_fault_state()

    me _stage_atlas_alpha(batch: FontRenderBatch):
        self.atlas_alpha_scratch.clear()
        for pixel in batch.atlas_pixels:
            self.atlas_alpha_scratch.push(((pixel >> 24u32) & 255u32).to_u8())

    me record_font_fallback():
        # Keep nested aggregate transport scalar for native self-hosting.
        self.backend.font_fault_fallback_count = self.backend.font_fault_fallback_count + 1
        self._sync_backend_fault_state()

    me _take_vertex_buffer(byte_count: i64) -> BufferHandle:
        var i: i64 = 0
        while i < self.reusable_vertices.len():
            if self.reusable_vertex_capacities[i] >= byte_count:
                val vertices = self.reusable_vertices[i]
                self.acquired_vertex_capacity = self.reusable_vertex_capacities[i]
                self.reusable_vertices.remove(i)
                self.reusable_vertex_capacities.remove(i)
                return vertices
            i = i + 1
        if self.reusable_vertices.len() > 0:
            self.backend.destroy_buffer(self.reusable_vertices[0])
            self.reusable_vertices.remove(0)
            self.reusable_vertex_capacities.remove(0)
        self.acquired_vertex_capacity = byte_count
        self.backend.create_vertex_buffer(byte_count)

    fn font_owner_fault_receipt() -> i64: self.font_last_fault
    fn font_owner_fault_mask() -> i64: self.font_fault_mask
    fn font_owner_fault_sequence() -> i64: self.font_fault_sequence
    fn font_device_loss_sequence() -> i64: self.font_device_loss_sequence
    fn font_device_loss_observed() -> bool: self.font_device_loss_sequence > 0
    fn font_owner_fault_identity_unchanged() -> bool: self.font_fault_identity_unchanged
    fn font_owner_fault_fallback_count() -> i64: self.font_fault_fallback_count
    fn shutdown_complete() -> bool: not self.backend.initialized

    me _retain_active_identity_after_fault(handle_before: i64, owner_before: text,
                                           generation_before: i64, payload_before: text,
                                           fault_sequence_before: i64):
        if self.backend.font_fault_sequence > fault_sequence_before:
            val identity_unchanged = (self.atlas.id == handle_before and
                self.atlas_owner_identity == owner_before and
                self.atlas_generation == generation_before and
                self.atlas_payload_sha256 == payload_before)
            self.backend.retain_font_identity_unchanged(identity_unchanged)
            self._sync_backend_fault_state()

    me begin_frame() -> bool:
        val handle_before = self.atlas.id
        val owner_before = self.atlas_owner_identity
        val generation_before = self.atlas_generation
        val payload_before = self.atlas_payload_sha256
        val fault_sequence_before = self.backend.font_fault_sequence
        val begun = self._begin_frame_impl()
        self._retain_active_identity_after_fault(
            handle_before, owner_before, generation_before, payload_before, fault_sequence_before)
        begun

    me _begin_frame_impl() -> bool:
        if not self.ready:
            self.record_font_fault("vulkan-font-adapter-not-ready", true)
            return false
        if self.frame_active:
            self.record_font_fault("vulkan-font-frame-already-active", true)
            return false
        self.reason = ""
        self.frame_atlas = TextureHandle.invalid()
        self.atlas_upload_count = 0
        self.atlas_uploaded_bytes = 0
        self.hud_vertex_upload_count = 0
        self.hud_vertex_uploaded_bytes = 0
        self.world_vertex_upload_count = 0
        self.world_vertex_uploaded_bytes = 0
        self.backend.begin_frame()
        if self.backend.command_handle <= 0:
            self._sync_backend_fault_state()
            if self.backend.blocker_reason == "device-lost":
                self.reason = "device-lost"
            else:
                self.reason = "vulkan-graphics-command-begin-failed"
            return false
        self.pass_handle = self.backend.begin_render_pass(self.color, self.depth)
        if self.backend.recording_blocked:
            self.backend.record_font_fault_from_runtime("vulkan-font-framebuffer-unavailable", true)
            self._sync_backend_fault_state()
            self.reason = self.backend.blocker_reason
            self.backend.end_frame()
            return false
        self.frame_sequence = self.frame_sequence + 1
        self.frame_active = true
        self.hud_draws = 0
        self.world_draws = 0
        self.last_pixels = []
        true

    me _upload_atlas(batch: FontRenderBatch) -> bool:
        val handle_before = self.atlas.id
        val owner_before = self.atlas_owner_identity
        val generation_before = self.atlas_generation
        val payload_before = self.atlas_payload_sha256
        val fault_sequence_before = self.backend.font_fault_sequence
        val uploaded = self._upload_atlas_impl(batch)
        self._retain_active_identity_after_fault(
            handle_before, owner_before, generation_before, payload_before, fault_sequence_before)
        uploaded

    me _upload_atlas_impl(batch: FontRenderBatch) -> bool:
        if not batch.material_supported():
            val reason = if batch.valid: "unsupported-font-program-version" else: "invalid-font-atlas"
            self.record_font_fault(reason, true)
            return false
        if (batch.atlas_width <= 0 or batch.atlas_height <= 0 or
            batch.atlas_pixels.len() != batch.atlas_width.to_i64() * batch.atlas_height.to_i64()):
            self.record_font_fault("invalid-font-atlas", true)
            return false
        val device_features = if self.backend.device_name != "" and self.backend.device_type != "" and self.backend.driver_identity != "":
            "name=" + self.backend.device_name + ";type=" + self.backend.device_type + ";driver=" + self.backend.driver_identity
        else: ""
        if (self.font_artifact_sha256 == "" and self.backend.pipeline_native_handle(self.hud_pipeline) > 0 and
            self.backend.pipeline_native_handle(self.world_pipeline) > 0):
            val hud_sha256 = sha256_u8_hex(font_hud_vulkan_vertex_spirv())
            val world_sha256 = sha256_u8_hex(font_world_vulkan_vertex_spirv())
            val fragment_sha256 = sha256_u8_hex(font_vulkan_fragment_spirv())
            if hud_sha256.len() == 64 and world_sha256.len() == 64 and fragment_sha256.len() == 64:
                self.font_artifact_sha256 = "hud-sha256=" + hud_sha256 +
                    ";world-sha256=" + world_sha256 + ";fragment-sha256=" + fragment_sha256
        val artifact_identity = if (self.backend.pipeline_native_handle(self.hud_pipeline) > 0 and
            self.backend.pipeline_native_handle(self.world_pipeline) > 0 and self.font_artifact_sha256 != ""):
            self.font_artifact_sha256 + ";hud=" + self.backend.pipeline_native_handle(self.hud_pipeline).to_string() +
                ";world=" + self.backend.pipeline_native_handle(self.world_pipeline).to_string()
        else: ""
        val dependency_identity = if self.backend.device_handle > 0 and self.backend.sampler_handle > 0:
            "device=" + self.backend.device_handle.to_string() + ";sampler=" + self.backend.sampler_handle.to_string()
        else: ""
        val owner_identity = font_atlas_composite_cache_identity(
            font_render_batch_atlas_owner_identity(batch), "vulkan3d", device_features,
            artifact_identity, dependency_identity)
        if owner_identity == "":
            self.record_font_fault("invalid-font-atlas", true)
            return false
        if not vulkan_font_atlas_upload_required(
            self.atlas_owner_identity, self.atlas_generation, owner_identity, batch
        ):
            self.frame_atlas = self.atlas
            return self.frame_atlas.id >= 0
        if self.pending_atlas.id >= 0:
            val same_pending_owner = (self.pending_atlas_owner_identity == owner_identity and
                self.pending_atlas_width == batch.atlas_width and
                self.pending_atlas_height == batch.atlas_height)
            if same_pending_owner and self.pending_atlas_generation == batch.atlas_generation:
                self.frame_atlas = self.pending_atlas
                return true
            if same_pending_owner and batch.atlas_generation > self.pending_atlas_generation:
                self._stage_atlas_alpha(batch)
                if not self.backend.upload_texture_checked(self.pending_atlas, self.atlas_alpha_scratch):
                    self.backend.recording_blocked = true
                    self._sync_backend_fault_state()
                    self.reason = if self.backend.blocker_reason == "device-lost":
                        "device-lost"
                    else:
                        "vulkan-font-atlas-upload-failed"
                    return false
                self.pending_atlas_generation = batch.atlas_generation
                self.pending_atlas_payload_sha256 = sha256_u8_hex(self.atlas_alpha_scratch)
                self.frame_atlas = self.pending_atlas
                self.atlas_upload_count = self.atlas_upload_count + 1
                self.atlas_uploaded_bytes = self.atlas_uploaded_bytes + self.atlas_alpha_scratch.len()
                return true
            self.record_font_fault("vulkan-font-atlas-pending-conflict", true)
            return false
        if self.retired_atlases.len() > 0:
            self.record_font_fault("vulkan-font-atlas-retire-failed", true)
            return false
        val fresh = self.backend.create_texture(
            batch.atlas_width.to_i64(), batch.atlas_height.to_i64(), TextureFormat3D.R8Unorm
        )
        if self.backend.texture_native_handle(fresh) <= 0:
            self.backend.record_font_fault_from_runtime("vulkan-font-atlas-allocation-failed", true)
            val allocation_reason = self.backend.blocker_reason
            self.backend.destroy_texture(fresh)
            self._sync_backend_fault_state()
            self.reason = if self.backend.blocker_reason == "device-lost": "device-lost" else: allocation_reason
            return false
        self._stage_atlas_alpha(batch)
        if not self.backend.upload_texture_checked(fresh, self.atlas_alpha_scratch):
            if not self.backend.destroy_texture(fresh):
                self.retired_atlases.push(fresh)
            self._sync_backend_fault_state()
            self.reason = if self.backend.blocker_reason == "device-lost":
                "device-lost"
            else:
                "vulkan-font-atlas-upload-failed"
            return false
        self.pending_atlas = fresh
        self.pending_atlas_width = batch.atlas_width
        self.pending_atlas_height = batch.atlas_height
        self.pending_atlas_generation = batch.atlas_generation
        self.pending_atlas_owner_identity = owner_identity
        self.pending_atlas_payload_sha256 = sha256_u8_hex(self.atlas_alpha_scratch)
        self.pending_atlas_draw_recorded = false
        self.frame_atlas = fresh
        self.atlas_upload_count = self.atlas_upload_count + 1
        self.atlas_uploaded_bytes = self.atlas_uploaded_bytes + self.atlas_alpha_scratch.len()
        true

    me draw_hud(origin_x: i32, origin_y: i32, batch: FontRenderBatch) -> bool:
        val handle_before = self.atlas.id
        val owner_before = self.atlas_owner_identity
        val generation_before = self.atlas_generation
        val payload_before = self.atlas_payload_sha256
        val fault_sequence_before = self.backend.font_fault_sequence
        val drawn = self._draw_hud_impl(origin_x, origin_y, batch)
        self._retain_active_identity_after_fault(
            handle_before, owner_before, generation_before, payload_before, fault_sequence_before)
        drawn

    me _draw_hud_impl(origin_x: i32, origin_y: i32, batch: FontRenderBatch) -> bool:
        if not self.frame_active:
            self.record_font_fault("vulkan-font-frame-inactive", true)
            return false
        if not self._upload_atlas(batch):
            return false
        font_hud_vertices_into(batch, origin_x, origin_y, self.width, self.height, self.vertex_bytes_scratch)
        if self.vertex_bytes_scratch.len() == 0:
            self.record_font_fault("invalid-font-quad", true)
            return false
        val vertices = self._take_vertex_buffer(self.vertex_bytes_scratch.len())
        if not self.backend.upload_buffer_checked(vertices, self.vertex_bytes_scratch, 0):
            self.backend.destroy_buffer(vertices)
            self._sync_backend_fault_state()
            self.reason = if self.backend.blocker_reason == "device-lost": "device-lost" else: "vulkan-font-vertex-upload-failed"
            return false
        self.hud_vertex_upload_count = self.hud_vertex_upload_count + 1
        self.hud_vertex_uploaded_bytes = self.hud_vertex_uploaded_bytes + self.vertex_bytes_scratch.len()
        self.transient_vertices.push(vertices)
        self.transient_vertex_capacities.push(self.acquired_vertex_capacity)
        self.backend.set_pipeline(self.pass_handle, self.hud_pipeline)
        self.backend.bind_vertex_buffer(self.pass_handle, vertices, 0)
        self.backend.bind_font_texture(self.pass_handle, self.hud_pipeline, self.frame_atlas)
        val draws = self.vertex_bytes_scratch.len() / 20
        self.backend.draw_font_vertices(self.pass_handle, draws)
        if self.frame_atlas.id == self.pending_atlas.id:
            self.pending_atlas_draw_recorded = true
        self.hud_draws = self.hud_draws + draws
        true

    me draw_world(origin_x: i32, origin_y: i32, clip_z: f32, batch: FontRenderBatch) -> bool:
        val handle_before = self.atlas.id
        val owner_before = self.atlas_owner_identity
        val generation_before = self.atlas_generation
        val payload_before = self.atlas_payload_sha256
        val fault_sequence_before = self.backend.font_fault_sequence
        val drawn = self._draw_world_impl(origin_x, origin_y, clip_z, batch)
        self._retain_active_identity_after_fault(
            handle_before, owner_before, generation_before, payload_before, fault_sequence_before)
        drawn

    me _draw_world_impl(origin_x: i32, origin_y: i32, clip_z: f32, batch: FontRenderBatch) -> bool:
        if not self.frame_active:
            self.record_font_fault("vulkan-font-frame-inactive", true)
            return false
        if not self._upload_atlas(batch):
            return false
        font_world_vertices_into(batch, origin_x, origin_y, self.width, self.height, clip_z, self.vertex_bytes_scratch)
        if self.vertex_bytes_scratch.len() == 0:
            self.record_font_fault("invalid-font-quad", true)
            return false
        val vertices = self._take_vertex_buffer(self.vertex_bytes_scratch.len())
        if not self.backend.upload_buffer_checked(vertices, self.vertex_bytes_scratch, 0):
            self.backend.destroy_buffer(vertices)
            self._sync_backend_fault_state()
            self.reason = if self.backend.blocker_reason == "device-lost": "device-lost" else: "vulkan-font-vertex-upload-failed"
            return false
        self.world_vertex_upload_count = self.world_vertex_upload_count + 1
        self.world_vertex_uploaded_bytes = self.world_vertex_uploaded_bytes + self.vertex_bytes_scratch.len()
        self.transient_vertices.push(vertices)
        self.transient_vertex_capacities.push(self.acquired_vertex_capacity)
        self.backend.set_pipeline(self.pass_handle, self.world_pipeline)
        self.backend.bind_vertex_buffer(self.pass_handle, vertices, 0)
        self.backend.bind_font_texture(self.pass_handle, self.world_pipeline, self.frame_atlas)
        val draws = self.vertex_bytes_scratch.len() / 24
        self.backend.draw_font_vertices(self.pass_handle, draws)
        if self.frame_atlas.id == self.pending_atlas.id:
            self.pending_atlas_draw_recorded = true
        self.world_draws = self.world_draws + draws
        true

    me end_frame() -> VulkanFontAdapter3DEvidence:
        val handle_before = self.atlas.id
        val owner_before = self.atlas_owner_identity
        val generation_before = self.atlas_generation
        val payload_before = self.atlas_payload_sha256
        val fault_sequence_before = self.backend.font_fault_sequence
        if self.frame_active:
            self.backend.end_render_pass(self.pass_handle)
            self.backend.end_frame()
            self.frame_active = false
        self._sync_backend_fault_state()
        val submission_device = self.backend.device_evidence()
        self.last_pixels = self.backend.readback_last_color_rgba8()
        if not self.backend.completion_unknown:
            var vertex_index: i64 = 0
            while vertex_index < self.transient_vertices.len():
                self.reusable_vertices.push(self.transient_vertices[vertex_index])
                self.reusable_vertex_capacities.push(self.transient_vertex_capacities[vertex_index])
                vertex_index = vertex_index + 1
            self.transient_vertices.clear()
            self.transient_vertex_capacities.clear()
            if self.pending_atlas.id >= 0:
                val completed_atlas = self.pending_atlas
                if submission_device.status == "font-ready" and self.pending_atlas_draw_recorded:
                    val old_atlas = self.atlas
                    self.atlas = completed_atlas
                    self.atlas_width = self.pending_atlas_width
                    self.atlas_height = self.pending_atlas_height
                    self.atlas_generation = self.pending_atlas_generation
                    self.atlas_owner_identity = self.pending_atlas_owner_identity
                    self.atlas_payload_sha256 = self.pending_atlas_payload_sha256
                    if old_atlas.id >= 0:
                        self.retired_atlases.push(old_atlas)
                else:
                    self.retired_atlases.push(completed_atlas)
                self.pending_atlas = TextureHandle.invalid()
                self.pending_atlas_width = 0
                self.pending_atlas_height = 0
                self.pending_atlas_generation = -1
                self.pending_atlas_owner_identity = ""
                self.pending_atlas_payload_sha256 = ""
                self.pending_atlas_draw_recorded = false
            if self.retired_atlases.len() > 0:
                var retired_index = self.retired_atlases.len() - 1
                while retired_index >= 0:
                    if self.backend.destroy_texture(self.retired_atlases[retired_index]):
                        self.retired_atlases.remove(retired_index)
                    retired_index = retired_index - 1
            self._sync_backend_fault_state()
        self._retain_active_identity_after_fault(
            handle_before, owner_before, generation_before, payload_before, fault_sequence_before)
        var device = self.backend.device_evidence()
        if self.backend.font_device_loss_sequence > 0:
            device.status = "unavailable"
            device.reason = "device-lost"
            device.texture_binding_ready = false
        if device.reason != "" and device.status != "font-ready":
            if self.reason == "" or device.reason == "device-lost":
                self.reason = device.reason
        VulkanFontAdapter3DEvidence(
            ready: device.status == "font-ready" and self.last_pixels.len() > 0,
            reason: self.reason,
            device: device,
            hud_pipeline_handle: self.backend.pipeline_native_handle(self.hud_pipeline),
            world_pipeline_handle: self.backend.pipeline_native_handle(self.world_pipeline),
            atlas_handle: self.backend.texture_native_handle(self.atlas),
            atlas_owner_identity: self.atlas_owner_identity,
            atlas_generation: self.atlas_generation,
            atlas_payload_sha256: self.atlas_payload_sha256,
            frame_sequence: self.frame_sequence,
            atlas_width: self.atlas_width.to_i64(),
            atlas_height: self.atlas_height.to_i64(),
            atlas_upload_count: self.atlas_upload_count,
            atlas_uploaded_bytes: self.atlas_uploaded_bytes,
            hud_vertex_upload_count: self.hud_vertex_upload_count,
            hud_vertex_uploaded_bytes: self.hud_vertex_uploaded_bytes,
            world_vertex_upload_count: self.world_vertex_upload_count,
            world_vertex_uploaded_bytes: self.world_vertex_uploaded_bytes,
            sampler_handle: self.backend.sampler_handle,
            hud_draws: if device.status == "font-ready": self.hud_draws else: 0,
            world_draws: if device.status == "font-ready": self.world_draws else: 0,
            pixels_rgba8: self.last_pixels
        )

    me shutdown():
        self.backend.shutdown()
        self._sync_backend_fault_state()
        if self.backend.initialized:
            self.reason = self.backend.blocker_reason
            return
        self.atlas = TextureHandle.invalid()
        self.pending_atlas = TextureHandle.invalid()
        self.frame_atlas = TextureHandle.invalid()
        self.retired_atlases = []
        self.atlas_width = 0
        self.atlas_height = 0
        self.atlas_generation = -1
        self.atlas_owner_identity = ""
        self.atlas_payload_sha256 = ""
        self.pending_atlas_width = 0
        self.pending_atlas_height = 0
        self.pending_atlas_generation = -1
        self.pending_atlas_owner_identity = ""
        self.pending_atlas_payload_sha256 = ""
        self.pending_atlas_draw_recorded = false
        self.transient_vertices.clear()
        self.transient_vertex_capacities.clear()
        self.reusable_vertices.clear()
        self.reusable_vertex_capacities.clear()
        self.acquired_vertex_capacity = 0
        self.vertex_bytes_scratch.clear()
        self.font_artifact_sha256 = ""
        self.ready = false
        self.frame_active = false

export VulkanFontAdapter3D, VulkanFontAdapter3DEvidence, vulkan_font_atlas_upload_required
