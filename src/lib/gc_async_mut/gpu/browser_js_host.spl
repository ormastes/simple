# Host adapter: JS interpreter runtime bridge for `browser_engine/script`.
#
# Lives outside wm_lane_scope_dirs() (`src/lib/gc_async_mut/gpu/browser_engine/`
# is a scope root; this file is a sibling on the `gpu` render sub-lane, matching
# `engine2d_host_clock.spl`), keeping direct `std.nogc_sync_mut.*` imports out
# of the portable `browser_engine/` lane while using tier-explicit `nogc_sync_mut`.
export use std.nogc_sync_mut.js.engine.runtime.{
    JsRuntime,
    js_runtime_with_default_logger,
    NATIVE_STORAGE_GET_ITEM,
    NATIVE_STORAGE_SET_ITEM,
    NATIVE_STORAGE_REMOVE_ITEM,
    NATIVE_STORAGE_CLEAR,
    NATIVE_STORAGE_KEY,
    NATIVE_DOM_EVENT_TARGET_ADD,
    NATIVE_DOM_EVENT_TARGET_REMOVE,
    NATIVE_DOM_EVENT_TARGET_DISPATCH
}
