# @gc — module uses GC runtime
#
# hip_compute — ROCm (AMD HIP) compute backend of the GPU API.
#
# Layering: slang -> pure LLM runner -> GPU API -> ROCm. This module is
# the ROCm leg: device init, f32 device buffers, bulk host<->device byte copy,
# runtime kernel compile through hipRTC (cached per device by kernel name),
# kernel launch, synchronize. HIP and hipRTC are loaded with the dynamic helper
# the slang backend uses (spl_dlopen / spl_dlsym / spl_wffi_call_i64); every
# HIP status other than 0 surfaces as Err(text).
#
# Host memory is handled without any rt_* extern: blocks come from the C
# runtime's malloc/free/memcpy (called through spl_wffi_call_i64 and
# spl_wffi_call_i64_with_bytes, the latter passing a [u8] straight to memcpy or
# hipMemcpyHtoD as the source pointer), and reads use
# std.nogc_sync_mut.sffi.raw_bytes.bytes_from_raw.
# Launch uses hipDrvLaunchKernelEx (4 integer arguments), so no wide-arity C
# forwarder is needed. Kernel parameter convention: device pointers first
# (8 bytes each), then 32-bit words (ints, or float bit patterns).

use std.nogc_sync_mut.sffi.dynamic.{spl_dlopen, spl_dlsym, spl_dlclose, spl_wffi_call_i64}
use std.nogc_sync_mut.sffi.raw_bytes.{bytes_from_raw}
use std.common.binary_io.{f32_to_bits}
use std.common.text_bytes.{bytes_to_text, text_to_utf8_bytes}
use std.gc_async_mut.slang.host.slang_host.{host_os_name, host_env, host_file_exists, host_join, rocm_bin_default_for, hip_lib_names, hiprtc_lib_names, host_libc_name}

@unsafe(reason: "passes a bounded caller-owned byte payload as one pointer argument", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64_with_bytes(fptr: i64, prefix_args: [i64], bytes: [u8], offset: i64, length: i64, suffix_args: [i64]) -> i64

# Launch scratch layout: argv at 0, kernel-param pointer array at 1024, config at 2048.
val LAUNCH_PARAMS_OFF = 1024
val LAUNCH_CFG_OFF = 2048

# ROCm directory: SLANG_ROCM_BIN when set, else the per-OS install default
# (Windows 7.2 bin dir, /opt/rocm/lib on Linux). Nothing is loaded here; HIP and
# hipRTC are dlopen'ed only by rocm_open_at, i.e. on first GPU use.
pub fn rocm_bin_default() -> text:
    val env_dir = host_env("SLANG_ROCM_BIN")
    if env_dir != "":
        return env_dir
    rocm_bin_default_for(host_os_name())

# First candidate file name present in `bin_dir`, as a full path; "" when none.
fn _find_lib(bin_dir: text, names: [text]) -> text:
    val os = host_os_name()
    for name in names:
        val path = host_join(os, bin_dir, name)
        if host_file_exists(path):
            return path
    ""

pub fn rocm_available_at(bin_dir: text) -> bool:
    val os = host_os_name()
    _find_lib(bin_dir, hip_lib_names(os)) != "" and _find_lib(bin_dir, hiprtc_lib_names(os)) != ""

pub class RocmDevice:
    name: text
    f_malloc: i64
    f_free: i64
    f_htod: i64
    f_dtoh: i64
    f_sync: i64
    f_modload: i64
    f_getfn: i64
    f_launch: i64
    f_rtc_create: i64
    f_rtc_compile: i64
    f_rtc_log_size: i64
    f_rtc_log: i64
    f_rtc_code_size: i64
    f_rtc_code: i64
    f_rtc_destroy: i64
    c_malloc: i64
    c_free: i64
    c_memcpy: i64
    scratch: i64
    launch_scratch: i64
    kernels: Dict<text, i64>

fn _need(lib: i64, sym: text) -> Result<i64, text>:
    val f = spl_dlsym(lib, sym)
    if f == 0:
        return Err("ROCm: missing symbol {sym}")
    Ok(f)

fn _hip_err(what: text, rc: i64) -> text:
    "ROCm: {what} failed rc={rc}"

# Little-endian i64 stored at host address `addr`.
fn _read_i64(addr: i64) -> i64:
    val b = bytes_from_raw(addr, 8)
    var v: i64 = 0
    var i: i64 = 7
    while i >= 0:
        v = v * 256 + (b[i] as i64)
        i = i - 1
    v

# Copy `length` bytes of `bytes` (from `offset`) to host address `dst`.
fn _host_write(dev: RocmDevice, dst: i64, bytes: [u8], offset: i64, length: i64) -> i64:
    spl_wffi_call_i64_with_bytes(dev.c_memcpy, [dst], bytes, offset, length, [length])

fn _i64_bytes(v: i64) -> [u8]:
    var out: [u8] = []
    var x = v
    var i: i64 = 0
    while i < 8:
        out.push((x & 255) as u8)
        x = x >> 8
        i = i + 1
    out

fn _i32_bytes(v: i64) -> [u8]:
    var out: [u8] = []
    var x = v
    var i: i64 = 0
    while i < 4:
        out.push((x & 255) as u8)
        x = x >> 8
        i = i + 1
    out

fn _cstring(dev: RocmDevice, s: text) -> i64:
    var b: [u8] = text_to_utf8_bytes(s)
    b.push(0)
    val p = spl_wffi_call_i64(dev.c_malloc, [b.len()], 1)
    _host_write(dev, p, b, 0, b.len())
    p

# Host text from a NUL-terminated byte window of `cap` bytes at `addr`.
fn _text_at(addr: i64, cap: i64) -> text:
    val raw = bytes_from_raw(addr, cap)
    var out: [u8] = []
    var i: i64 = 0
    while i < raw.len() and raw[i] != 0:
        out.push(raw[i])
        i = i + 1
    bytes_to_text(out)

# Load HIP + hipRTC from `bin_dir` (nothing is loaded at import; this is the only
# place the libraries are opened), initialise HIP, and read the device name.
# Any failure releases every library this call loaded, so a failed probe leaves
# no GPU library resident. Kernels compile lazily in rocm_kernel.
pub fn rocm_open_at(bin_dir: text) -> Result<RocmDevice, text>:
    val os = host_os_name()
    val hip_path = _find_lib(bin_dir, hip_lib_names(os))
    val rtc_path = _find_lib(bin_dir, hiprtc_lib_names(os))
    if hip_path == "" or rtc_path == "":
        return Err("ROCm: HIP/hipRTC library not found in {bin_dir} for {os}")
    val ucrt = spl_dlopen(host_libc_name(os))
    val hip = spl_dlopen(hip_path)
    val rtc = spl_dlopen(rtc_path)
    if ucrt == 0 or hip == 0 or rtc == 0:
        _release_libs([ucrt, hip, rtc])
        return Err("ROCm: dlopen failed for libc, HIP or hipRTC")
    val r = _rocm_open_loaded(ucrt, hip, rtc)
    if r.is_err():
        _release_libs([ucrt, hip, rtc])
    r

# True when the HIP or hipRTC DLL is mapped into this process (a pure query:
# GetModuleHandleA never loads anything). Lets callers assert that no GPU
# library was loaded by an import or by a non-ROCm backend.
@allow(primitive_api)  # reason: boolean presence query; no domain type exists for a yes/no probe
pub fn rocm_library_loaded() -> bool:
    val os = host_os_name()
    gpu_dll_loaded(hip_lib_names(os) + hiprtc_lib_names(os))

# True when any of the named DLLs is already mapped in this process (Windows
# GetModuleHandleA only; it never loads anything). The GPU providers share it to
# assert that selecting one backend loaded no other backend's library.
@allow(primitive_api)  # reason: boolean presence query over module names; no domain type exists for a yes/no probe
pub fn gpu_dll_loaded(names: [text]) -> bool:
    val ucrt = spl_dlopen("ucrtbase.dll")
    val k32 = spl_dlopen("kernel32.dll")
    if ucrt == 0 or k32 == 0:
        return false
    val c_malloc = spl_dlsym(ucrt, "malloc")
    val c_free = spl_dlsym(ucrt, "free")
    val c_memcpy = spl_dlsym(ucrt, "memcpy")
    val get_module = spl_dlsym(k32, "GetModuleHandleA")
    if c_malloc == 0 or c_free == 0 or c_memcpy == 0 or get_module == 0:
        return false
    var loaded = false
    for name in names:
        var b: [u8] = text_to_utf8_bytes(name)
        b.push(0)
        val p = spl_wffi_call_i64(c_malloc, [b.len()], 1)
        spl_wffi_call_i64_with_bytes(c_memcpy, [p], b, 0, b.len(), [b.len()])
        if spl_wffi_call_i64(get_module, [p], 1) != 0:
            loaded = true
        spl_wffi_call_i64(c_free, [p], 1)
    loaded

fn _release_libs(handles: [i64]):
    for h in handles:
        if h != 0:
            spl_dlclose(h)

fn _rocm_open_loaded(ucrt: i64, hip: i64, rtc: i64) -> Result<RocmDevice, text>:
    val f_init = _need(hip, "hipInit")?
    val f_name = _need(hip, "hipDeviceGetName")?
    val c_malloc = _need(ucrt, "malloc")?
    val dev = RocmDevice(
        name: "",
        f_malloc: _need(hip, "hipMalloc")?,
        f_free: _need(hip, "hipFree")?,
        f_htod: _need(hip, "hipMemcpyHtoD")?,
        f_dtoh: _need(hip, "hipMemcpyDtoH")?,
        f_sync: _need(hip, "hipDeviceSynchronize")?,
        f_modload: _need(hip, "hipModuleLoadData")?,
        f_getfn: _need(hip, "hipModuleGetFunction")?,
        f_launch: _need(hip, "hipDrvLaunchKernelEx")?,
        f_rtc_create: _need(rtc, "hiprtcCreateProgram")?,
        f_rtc_compile: _need(rtc, "hiprtcCompileProgram")?,
        f_rtc_log_size: _need(rtc, "hiprtcGetProgramLogSize")?,
        f_rtc_log: _need(rtc, "hiprtcGetProgramLog")?,
        f_rtc_code_size: _need(rtc, "hiprtcGetCodeSize")?,
        f_rtc_code: _need(rtc, "hiprtcGetCode")?,
        f_rtc_destroy: _need(rtc, "hiprtcDestroyProgram")?,
        c_malloc: c_malloc,
        c_free: _need(ucrt, "free")?,
        c_memcpy: _need(ucrt, "memcpy")?,
        scratch: spl_wffi_call_i64(c_malloc, [512], 1),
        launch_scratch: spl_wffi_call_i64(c_malloc, [4096], 1),
        kernels: {}
    )
    val rc_init = spl_wffi_call_i64(f_init, [0], 1)
    if rc_init != 0:
        return Err(_hip_err("hipInit", rc_init))
    val rc_name = spl_wffi_call_i64(f_name, [dev.scratch, 256, 0], 3)
    if rc_name != 0:
        return Err(_hip_err("hipDeviceGetName", rc_name))
    dev.name = _text_at(dev.scratch, 256)
    Ok(dev)

# Device buffer of `n_floats` f32 values.
pub fn rocm_buffer_alloc(dev: RocmDevice, n_floats: i64) -> Result<i64, text>:
    val rc = spl_wffi_call_i64(dev.f_malloc, [dev.scratch, n_floats * 4], 2)
    if rc != 0:
        return Err(_hip_err("hipMalloc", rc))
    Ok(_read_i64(dev.scratch))

pub fn rocm_buffer_free(dev: RocmDevice, ptr: i64) -> Result<i64, text>:
    val rc = spl_wffi_call_i64(dev.f_free, [ptr], 1)
    if rc != 0:
        return Err(_hip_err("hipFree", rc))
    Ok(0)

# Bulk upload: `byte_len` bytes of `bytes` starting at `offset` go to device
# address `buf` (little-endian f32 payload, no per-element staging). One
# hipMemcpyHtoD per call.
pub fn rocm_buffer_upload_bytes(dev: RocmDevice, buf: i64, bytes: [u8], offset: i64, byte_len: i64) -> Result<i64, text>:
    if offset < 0 or byte_len < 0 or offset + byte_len > bytes.len():
        return Err("ROCm: upload range {offset}+{byte_len} outside {bytes.len()} bytes")
    val rc = spl_wffi_call_i64_with_bytes(dev.f_htod, [buf], bytes, offset, byte_len, [byte_len])
    if rc != 0:
        return Err(_hip_err("hipMemcpyHtoD", rc))
    Ok(byte_len)

# Bulk download of `byte_len` bytes at device address `buf` as raw bytes.
pub fn rocm_buffer_download_bytes(dev: RocmDevice, buf: i64, byte_len: i64) -> Result<[u8], text>:
    val host = spl_wffi_call_i64(dev.c_malloc, [byte_len + 8], 1)
    val rc = spl_wffi_call_i64(dev.f_dtoh, [host, buf, byte_len], 3)
    if rc != 0:
        spl_wffi_call_i64(dev.c_free, [host], 1)
        return Err(_hip_err("hipMemcpyDtoH", rc))
    val out = bytes_from_raw(host, byte_len)
    spl_wffi_call_i64(dev.c_free, [host], 1)
    Ok(out)

# Host f64 -> little-endian f32 bytes (small activations; weights use the
# byte-range path).
pub fn rocm_f32_bytes(values: [f64]) -> [u8]:
    var out: [u8] = []
    for v in values:
        val bits = f32_to_bits(v as f32) as i64
        out.push((bits & 255) as u8)
        out.push(((bits >> 8) & 255) as u8)
        out.push(((bits >> 16) & 255) as u8)
        out.push(((bits >> 24) & 255) as u8)
    out

pub fn rocm_upload_f32(dev: RocmDevice, dptr: i64, values: [f64]) -> Result<i64, text>:
    val b = rocm_f32_bytes(values)
    rocm_buffer_upload_bytes(dev, dptr, b, 0, b.len())?
    Ok(values.len())

pub fn rocm_sync(dev: RocmDevice) -> Result<i64, text>:
    val rc = spl_wffi_call_i64(dev.f_sync, [], 0)
    if rc != 0:
        return Err(_hip_err("hipDeviceSynchronize", rc))
    Ok(0)

# Compile `source` with hipRTC, load the code object, return the kernel
# function handle for `kernel`. Cached per device by `kernel`: the second call
# for the same name returns the cached handle without compiling.
# The program handle stays in scratch[0..8] until it is destroyed; every other
# out-parameter (sizes, module, function) uses the slot at scratch+16.
pub fn rocm_kernel(dev: RocmDevice, kernel: text, source: text) -> Result<i64, text>:
    val cached = dev.kernels.get(kernel)
    if cached.is_some():
        return Ok(cached.unwrap())
    val s = dev.scratch
    val w = s + 16
    val c_src = _cstring(dev, source)
    val c_name = _cstring(dev, kernel + ".hip")
    val rc_create = spl_wffi_call_i64(dev.f_rtc_create, [s, c_src, c_name, 0, 0, 0], 6)
    spl_wffi_call_i64(dev.c_free, [c_src], 1)
    spl_wffi_call_i64(dev.c_free, [c_name], 1)
    if rc_create != 0:
        return Err(_hip_err("hiprtcCreateProgram", rc_create))
    val prog = _read_i64(s)
    val rc_compile = spl_wffi_call_i64(dev.f_rtc_compile, [prog, 0, 0], 3)
    if rc_compile != 0:
        spl_wffi_call_i64(dev.f_rtc_log_size, [prog, w], 2)
        val log_n = _read_i64(w)
        val log_buf = spl_wffi_call_i64(dev.c_malloc, [log_n + 8], 1)
        spl_wffi_call_i64(dev.f_rtc_log, [prog, log_buf], 2)
        val log = _text_at(log_buf, log_n)
        spl_wffi_call_i64(dev.c_free, [log_buf], 1)
        spl_wffi_call_i64(dev.f_rtc_destroy, [s], 1)
        return Err("ROCm: hiprtc compile of {kernel} failed rc={rc_compile}: {log}")
    spl_wffi_call_i64(dev.f_rtc_code_size, [prog, w], 2)
    val code_n = _read_i64(w)
    val code = spl_wffi_call_i64(dev.c_malloc, [code_n + 8], 1)
    spl_wffi_call_i64(dev.f_rtc_code, [prog, code], 2)
    # The code object was copied into `code`, so the program is no longer needed.
    spl_wffi_call_i64(dev.f_rtc_destroy, [s], 1)
    val rc_load = spl_wffi_call_i64(dev.f_modload, [w, code], 2)
    # `code` is intentionally NOT freed: the HIP docs do not say whether
    # hipModuleLoadData copies the image or keeps a pointer into it. Kernels are
    # cached per device, so this is one small buffer per distinct kernel.
    if rc_load != 0:
        spl_wffi_call_i64(dev.c_free, [code], 1)
        return Err(_hip_err("hipModuleLoadData", rc_load))
    val module = _read_i64(w)
    val c_kernel = _cstring(dev, kernel)
    val rc_fn = spl_wffi_call_i64(dev.f_getfn, [w, module, c_kernel], 3)
    spl_wffi_call_i64(dev.c_free, [c_kernel], 1)
    if rc_fn != 0:
        return Err(_hip_err("hipModuleGetFunction({kernel})", rc_fn))
    val kfn = _read_i64(w)
    dev.kernels[kernel] = kfn
    Ok(kfn)

# f32 bit pattern of `v`, as the i32 word a kernel `float` parameter receives.
pub fn rocm_f32_word(v: f64) -> i64:
    (f32_to_bits(v as f32) as i64) & 4294967295

# Launch `kfn` on a 1-D grid. `ptr_args` are device pointers, `word_args` are
# 32-bit words (ints or rocm_f32_word values), in kernel parameter order.
# Asynchronous: call rocm_sync before reading results. The argument block lives
# in the device's launch scratch, so launches are issued one at a time from one
# thread per device handle.
pub fn rocm_launch(dev: RocmDevice, kfn: i64, grid_x: i64, block_x: i64, ptr_args: [i64], word_args: [i64]) -> Result<i64, text>:
    val np = ptr_args.len()
    val nw = word_args.len()
    if np * 8 + nw * 4 > LAUNCH_PARAMS_OFF or (np + nw) * 8 > LAUNCH_CFG_OFF - LAUNCH_PARAMS_OFF:
        return Err("ROCm: too many kernel arguments")
    val base = dev.launch_scratch
    var argv: [u8] = []
    var params: [u8] = []
    var i: i64 = 0
    while i < np:
        argv = argv + _i64_bytes(ptr_args[i])
        params = params + _i64_bytes(base + i * 8)
        i = i + 1
    var j: i64 = 0
    while j < nw:
        argv = argv + _i32_bytes(word_args[j])
        params = params + _i64_bytes(base + np * 8 + j * 4)
        j = j + 1
    var cfg: [u8] = _i32_bytes(grid_x) + _i32_bytes(1) + _i32_bytes(1) + _i32_bytes(block_x) + _i32_bytes(1) + _i32_bytes(1) + _i32_bytes(0) + _i32_bytes(0)
    cfg = cfg + _i64_bytes(0) + _i64_bytes(0) + _i64_bytes(0)
    _host_write(dev, base, argv, 0, argv.len())
    _host_write(dev, base + LAUNCH_PARAMS_OFF, params, 0, params.len())
    _host_write(dev, base + LAUNCH_CFG_OFF, cfg, 0, cfg.len())
    val rc = spl_wffi_call_i64(dev.f_launch, [base + LAUNCH_CFG_OFF, kfn, base + LAUNCH_PARAMS_OFF, 0], 4)
    if rc != 0:
        return Err(_hip_err("hipDrvLaunchKernelEx", rc))
    Ok(0)
