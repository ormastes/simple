# Host adapter: environment, target platform detection, and SFNT file reads
# for engine2d's backend auto-probing and hosted font loading.
#
# Lives outside wm_lane_scope_dirs() (`src/lib/gc_async_mut/gpu/engine2d/` is a
# scope root; this file is a sibling on the `gpu` render sub-lane, matching
# `engine2d_host_clock.spl`), keeping direct `std.io_runtime` and host-env
# edges out of the portable `engine2d/` lane.
export use std.gc_async_mut.io.env_ops.{env_get}
export use std.nogc_sync_mut.io_runtime.{platform_name, file_exists, file_read_bytes_result}
