# Browser session — URL utility functions.
#
# Free functions for:
# - normalize_browser_url: normalise any user-supplied URL string
# - resolve_relative_url: resolve href against a base URL
# - url_protocol / url_pathname / url_origin / url_host / url_search / url_hash
# - without_fragment / without_query / base_dir
# - normalize_runtime_request_url: fix up JS runtime fetch URLs
# - find_text: low-level substring search used by many helpers

use std.common.string_core.{text_to_bytes}
use std.common.encoding.utf8.{
    text_is_valid_utf8, text_without_last_codepoint
}
use std.gc_async_mut.http_client.types.{parse_url}

val BROWSER_ADDRESS_MAX_BYTES: i64 = 2048

fn _browser_utf8_continuation(byte: i64) -> bool:
    byte >= 0x80 and byte <= 0xBF

fn _browser_input_error(input: text, max_bytes: i64) -> text:
    if not text_is_valid_utf8(input):
        return "address-invalid-utf8"
    val bytes = text_to_bytes(input)
    if max_bytes > 0 and bytes.len() > max_bytes:
        return "address-too-long"
    var index = 0
    while index < bytes.len():
        val lead = bytes[index] as i64
        var scalar = lead
        var width = 1
        if lead < 0x80:
            width = 1
        elif lead >= 0xC2 and lead <= 0xDF:
            if (
                index + 1 >= bytes.len() or
                not _browser_utf8_continuation(
                    bytes[index + 1] as i64
                )
            ):
                return "address-invalid-utf8"
            scalar = (
                ((lead & 0x1F) << 6) |
                ((bytes[index + 1] as i64) & 0x3F)
            )
            width = 2
        elif lead >= 0xE0 and lead <= 0xEF:
            if index + 2 >= bytes.len():
                return "address-invalid-utf8"
            val second = bytes[index + 1] as i64
            val third = bytes[index + 2] as i64
            val second_valid = if lead == 0xE0:
                second >= 0xA0 and second <= 0xBF
            elif lead == 0xED:
                second >= 0x80 and second <= 0x9F
            else:
                _browser_utf8_continuation(second)
            if (
                not second_valid or
                not _browser_utf8_continuation(third)
            ):
                return "address-invalid-utf8"
            scalar = (
                ((lead & 0x0F) << 12) |
                ((second & 0x3F) << 6) |
                (third & 0x3F)
            )
            width = 3
        elif lead >= 0xF0 and lead <= 0xF4:
            if index + 3 >= bytes.len():
                return "address-invalid-utf8"
            val second = bytes[index + 1] as i64
            val third = bytes[index + 2] as i64
            val fourth = bytes[index + 3] as i64
            val second_valid = if lead == 0xF0:
                second >= 0x90 and second <= 0xBF
            elif lead == 0xF4:
                second >= 0x80 and second <= 0x8F
            else:
                _browser_utf8_continuation(second)
            if (
                not second_valid or
                not _browser_utf8_continuation(third) or
                not _browser_utf8_continuation(fourth)
            ):
                return "address-invalid-utf8"
            scalar = (
                ((lead & 0x07) << 18) |
                ((second & 0x3F) << 12) |
                ((third & 0x3F) << 6) |
                (fourth & 0x3F)
            )
            width = 4
        else:
            return "address-invalid-utf8"
        if (
            scalar < 32 or scalar == 127 or
            (scalar >= 128 and scalar <= 159)
        ):
            return "address-invalid-control"
        index = index + width
    # Unicode noncharacters are valid scalars and remain allowed in drafts.
    ""

fn browser_address_input_error(input: text) -> text:
    _browser_input_error(input, BROWSER_ADDRESS_MAX_BYTES)

fn browser_address_update(
    current: text, value: text, replace: bool
) -> Result<text, text>:
    val updated = if replace: value else: current + value
    val reason = browser_address_input_error(updated)
    if reason != "":
        return Err(reason)
    Ok(updated)

fn browser_address_backspace(
    current: text, replace: bool
) -> Result<text, text>:
    val reason = browser_address_input_error(current)
    if reason != "":
        return Err(reason)
    Ok(if replace: "" else: text_without_last_codepoint(current))

fn browser_address_draft_after_control_press(
    control: text, document_url: text, draft: text
) -> text:
    if control == "address" or control == "go":
        return draft
    if document_url != "": document_url else: "about:blank"

fn browser_url_form_encode(value: text) -> text:
    var out = ""
    for byte in text_to_bytes(value):
        val code = byte as i64
        val unreserved = (code >= 48 and code <= 57) or
            (code >= 65 and code <= 90) or
            (code >= 97 and code <= 122) or
            code == 45 or code == 46 or code == 95 or code == 126
        if unreserved:
            out = out + code.to_char()
        elif code == 32:
            out = out + "+"
        else:
            val hex = code.to_hex().upper()
            out = out + "%" + (if hex.len() == 1: "0" + hex else: hex)
    out

fn find_text(haystack: text, needle: text, start: i64) -> i64:
    if start < 0 or start > haystack.len() or needle.len() == 0:
        return -1
    var idx = start
    val last = haystack.len() - needle.len()
    val first = needle.slice(0, 1)
    while idx <= last:
        if haystack.slice(idx, idx + 1) == first:
            if haystack.slice(idx, idx + needle.len()) == needle:
                return idx
        idx = idx + 1
    -1

fn normalize_browser_url(input: text) -> text:
    val clean = input.trim()
    if clean.len() == 0:
        return "about:blank"
    val lower = clean.lower()
    if lower.starts_with("about:"):
        return lower
    if lower.starts_with("file://"):
        return "file://" + clean.slice(7, clean.len())
    if lower.starts_with("http://"):
        return "http://" + clean.slice(7, clean.len())
    if lower.starts_with("https://"):
        return "https://" + clean.slice(8, clean.len())
    if clean.starts_with("/"):
        return "file://{clean}"
    if clean.contains(".") and not clean.contains(" "):
        return "https://{clean}"
    "https://search.example.com/?q={browser_url_form_encode(clean)}"

fn _normalize_network_navigation_url_checked(
    input: text
) -> Result<text, text>:
    val clean = input.trim()
    val lower = clean.lower()
    if lower == "about:blank":
        return Ok("about:blank")
    if lower.starts_with("file:"):
        return Err("unsupported scheme: file")
    if (
        lower.starts_with("javascript:") or lower.starts_with("data:") or
        lower.starts_with("blob:") or lower.starts_with("ftp:") or
        lower.starts_with("ws:") or lower.starts_with("wss:")
    ):
        return Err("unsupported navigation scheme")
    if clean.contains("://") and not lower.starts_with("http://") and not lower.starts_with("https://"):
        return Err("unsupported navigation scheme")
    val normalized = normalize_browser_url(clean)
    if not normalized.starts_with("http://") and not normalized.starts_with("https://"):
        return Err("unsupported navigation scheme")
    val authority = url_authority(normalized)
    if not network_navigation_authority_valid(authority):
        return Err("invalid navigation authority")
    Ok(normalized)

fn normalize_network_navigation_url(input: text) -> Result<text, text>:
    val reason = _browser_input_error(input, 0)
    if reason == "address-invalid-utf8":
        return Err("invalid UTF-8 in navigation URL")
    if reason == "address-invalid-control":
        return Err("invalid control character in navigation URL")
    _normalize_network_navigation_url_checked(input)

fn network_navigation_port_valid(port: text) -> bool:
    if port == "" or port.len() > 5:
        return false
    var value: i64 = 0
    var i = 0
    while i < port.len():
        val code = port.char_code_at(i)
        if code < 48 or code > 57:
            return false
        value = value * 10 + (code - 48)
        i = i + 1
    value > 0 and value <= 65535

fn network_navigation_hostname_valid(host: text) -> bool:
    if host == "" or host.len() > 253 or host.starts_with(".") or host.ends_with("."):
        return false
    var label_len = 0
    var i = 0
    while i < host.len():
        val ch = host.slice(i, i + 1)
        val code = host.char_code_at(i)
        if ch == ".":
            if label_len == 0 or host.slice(i - 1, i) == "-":
                return false
            label_len = 0
        else:
            val alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
            val digit = code >= 48 and code <= 57
            if not alpha and not digit and ch != "-":
                return false
            if label_len == 0 and ch == "-":
                return false
            label_len = label_len + 1
            if label_len > 63:
                return false
        i = i + 1
    label_len > 0 and not host.ends_with("-")

fn network_navigation_authority_valid(authority: text) -> bool:
    if authority == "" or authority.contains("@") or authority.contains(" ") or authority.contains("\\"):
        return false
    if authority.starts_with("["):
        val close = authority.index_of("]")
        if close <= 1:
            return false
        val tail = authority.slice(close + 1, authority.len())
        if tail != "" and (
            not tail.starts_with(":") or
            not network_navigation_port_valid(
                tail.slice(1, tail.len())
            )
        ):
            return false
        # Reuse the canonical URL parser for the IPv6 literal itself.
        val parsed = parse_url("http://{authority}/")
        if not parsed.?:
            return false
        val url = parsed!
        url.host.starts_with("[") and url.host.ends_with("]")
    if authority.contains("[") or authority.contains("]"):
        return false
    val colon = authority.index_of(":")
    if colon < 0:
        return network_navigation_hostname_valid(authority)
    val last_colon = authority.last_index_of(":")
    if last_colon != colon:
        return false
    network_navigation_hostname_valid(authority.slice(0, colon)) and
        network_navigation_port_valid(authority.slice(colon + 1, authority.len()))

fn resolve_relative_url(base_url: text, href: text) -> text:
    if href == "":
        return base_url
    if href.starts_with("http://") or href.starts_with("https://") or href.starts_with("file://") or href.starts_with("about:"):
        return href
    if href.starts_with("//"):
        return url_protocol(base_url) + href
    if href.starts_with("#"):
        return without_fragment(base_url) + href
    if href.starts_with("?"):
        return without_query(base_url) + href
    if href.starts_with("/"):
        val origin = url_origin(base_url)
        if origin != "":
            return origin + href
        return href
    base_dir(base_url) + href

pub fn browser_history_resolve_url(base_url: text, raw_url: text) -> text:
    resolve_relative_url(base_url, raw_url)

# Collapse "." and ".." segments in a URL's path per RFC 3986 remove_dot_segments,
# leaving scheme/host (origin) and any query/fragment tail untouched.
# Applied selectively by callers (e.g. CSS @import resolution) that want
# normalised URLs; resolve_relative_url itself preserves raw joins because
# other consumers (JS module dependency extraction) assert on the unnormalised
# form.
fn collapse_url_dot_segments(url: text) -> text:
    val origin = url_origin(url)
    val rest = url.slice(origin.len(), url.len())
    # Split off query/fragment so we only normalise the path portion.
    var cut = rest.len()
    val q = find_text(rest, "?", 0)
    if q >= 0 and q < cut:
        cut = q
    val h = find_text(rest, "#", 0)
    if h >= 0 and h < cut:
        cut = h
    val path = rest.slice(0, cut)
    val tail = rest.slice(cut, rest.len())
    origin + remove_dot_segments(path) + tail

fn normalize_browser_address_reference_url(
    base_url: text, input: text
) -> Result<text, text>:
    val reason = browser_address_input_error(input)
    if reason != "":
        return Err(reason)
    val clean = input.trim()
    val is_reference = (
        clean == "." or clean == ".." or
        clean.starts_with("/") or
        clean.starts_with("./") or clean.starts_with("../") or
        clean.starts_with("?") or clean.starts_with("#")
    )
    val candidate = if is_reference:
        collapse_url_dot_segments(
            browser_history_resolve_url(base_url, clean)
        )
    else:
        clean
    _normalize_network_navigation_url_checked(candidate)

fn normalize_script_navigation_reference_url(
    base_url: text, input: text
) -> Result<text, text>:
    val reason = _browser_input_error(input, 0)
    if reason == "address-invalid-utf8":
        return Err("invalid UTF-8 in navigation URL")
    if reason == "address-invalid-control":
        return Err("invalid control character in navigation URL")
    val clean = input.trim()
    var scheme_end: i64 = -1
    var scan: i64 = 0
    var scheme_candidate = clean.len() > 0
    while scan < clean.len() and scheme_end < 0 and scheme_candidate:
        val ch = clean.slice(scan, scan + 1)
        if ch == ":":
            if scan > 0:
                scheme_end = scan
            scheme_candidate = false
        elif ch == "/" or ch == "?" or ch == "#":
            scheme_candidate = false
        else:
            val code = clean.char_code_at(scan)
            val alpha = (
                (code >= 65 and code <= 90) or
                (code >= 97 and code <= 122)
            )
            val digit = code >= 48 and code <= 57
            val valid = if scan == 0:
                alpha
            else:
                alpha or digit or ch == "+" or ch == "-" or ch == "."
            if valid:
                scan = scan + 1
            else:
                scheme_candidate = false
    if scheme_end >= 0:
        val scheme = clean.slice(0, scheme_end).lower()
        if scheme == "about" and clean.lower() == "about:blank":
            return Ok("about:blank")
        if scheme != "http" and scheme != "https":
            return Err("unsupported navigation scheme")
        if (
            (scheme == "http" and
             not clean.lower().starts_with("http://")) or
            (scheme == "https" and
             not clean.lower().starts_with("https://"))
        ):
            return Err("invalid navigation authority")
        return _normalize_network_navigation_url_checked(clean)
    val resolved = collapse_url_dot_segments(
        resolve_relative_url(base_url, clean)
    )
    if (
        not resolved.lower().starts_with("http://") and
        not resolved.lower().starts_with("https://") and
        resolved.lower() != "about:blank"
    ):
        return Err("unsupported navigation scheme")
    _normalize_network_navigation_url_checked(resolved)

# RFC 3986 §5.2.4 remove_dot_segments operating on a path string.
fn remove_dot_segments(path: text) -> text:
    var input = path
    var output = ""
    while input.len() > 0:
        if input.starts_with("../"):
            input = input.slice(3, input.len())
        elif input.starts_with("./"):
            input = input.slice(2, input.len())
        elif input.starts_with("/./"):
            input = "/" + input.slice(3, input.len())
        elif input == "/.":
            input = "/"
        elif input.starts_with("/../"):
            input = "/" + input.slice(4, input.len())
            output = _drop_last_segment(output)
        elif input == "/..":
            input = "/"
            output = _drop_last_segment(output)
        elif input == "." or input == "..":
            input = ""
        else:
            # Move the first path segment (leading "/" plus chars up to next "/").
            var seg_end = input.len()
            var i = 0
            if input.starts_with("/"):
                i = 1
            while i < input.len():
                if input.slice(i, i + 1) == "/":
                    seg_end = i
                    i = input.len()
                else:
                    i = i + 1
            output = output + input.slice(0, seg_end)
            input = input.slice(seg_end, input.len())
    output

fn _drop_last_segment(output: text) -> text:
    var idx = output.len() - 1
    while idx >= 0:
        if output.slice(idx, idx + 1) == "/":
            return output.slice(0, idx)
        idx = idx - 1
    ""

fn url_protocol(url: text) -> text:
    if url.starts_with("https://"):
        return "https:"
    if url.starts_with("http://"):
        return "http:"
    if url.starts_with("file://"):
        return "file:"
    if url.starts_with("about:"):
        return "about:"
    ""

fn url_pathname(url: text) -> text:
    if url.starts_with("file://"):
        return without_query(url.slice(7, url.len()))
    if url.starts_with("about:"):
        return url
    val scheme_pos = find_text(url, "://", 0)
    if scheme_pos < 0:
        return "/"
    val path_start = find_text(url, "/", scheme_pos + 3)
    if path_start < 0:
        return "/"
    without_query(url.slice(path_start, url.len()))

fn url_origin(url: text) -> text:
    val scheme_pos = find_text(url, "://", 0)
    if scheme_pos < 0:
        return ""
    var host = url_host(url)
    if host == "":
        return ""
    val colon = host.last_index_of(":")
    if colon > 0 and host.index_of(":") == colon:
        val port_text = host.slice(colon + 1, host.len())
        if network_navigation_port_valid(port_text):
            val port = port_text.to_i64()
            val is_default = (url.starts_with("https://") and port == 443) or
                (url.starts_with("http://") and port == 80)
            if is_default:
                host = host.slice(0, colon)
    url.slice(0, scheme_pos + 3) + host

fn without_fragment(url: text) -> text:
    val idx = find_text(url, "#", 0)
    if idx < 0:
        return url
    url.slice(0, idx)

fn without_query(url: text) -> text:
    val clean = without_fragment(url)
    val idx = find_text(clean, "?", 0)
    if idx < 0:
        return clean
    clean.slice(0, idx)

fn base_dir(url: text) -> text:
    val clean = without_query(url)
    val origin = url_origin(clean)
    if origin == "":
        return ""
    if clean == origin:
        return origin + "/"
    val rel = clean.slice(origin.len(), clean.len())
    var idx = rel.len() - 1
    while idx >= 0:
        if rel.slice(idx, idx + 1) == "/":
            return origin + rel.slice(0, idx + 1)
        idx = idx - 1
    origin + "/"

fn url_authority(url: text) -> text:
    val scheme_pos = find_text(url, "://", 0)
    if scheme_pos < 0:
        return ""
    val host_start = scheme_pos + 3
    var authority_end = url.len()
    val path_start = find_text(url, "/", host_start)
    if path_start >= 0 and path_start < authority_end:
        authority_end = path_start
    val query_start = find_text(url, "?", host_start)
    if query_start >= 0 and query_start < authority_end:
        authority_end = query_start
    val fragment_start = find_text(url, "#", host_start)
    if fragment_start >= 0 and fragment_start < authority_end:
        authority_end = fragment_start
    url.slice(host_start, authority_end)

fn url_host(url: text) -> text:
    val authority = url_authority(url)
    val credentials_end = authority.last_index_of("@")
    if credentials_end >= 0:
        return authority.slice(credentials_end + 1, authority.len())
    authority

fn url_hostname(url: text) -> text:
    val host = url_host(url)
    if host.starts_with("["):
        val bracket_end = host.index_of("]")
        if bracket_end > 0:
            return host.slice(1, bracket_end)
        return ""
    val port_start = host.index_of(":")
    if port_start >= 0:
        return host.slice(0, port_start)
    host

fn url_search(url: text) -> text:
    val clean = without_fragment(url)
    val idx = find_text(clean, "?", 0)
    if idx < 0:
        return ""
    clean.slice(idx, clean.len())

fn url_hash(url: text) -> text:
    val idx = find_text(url, "#", 0)
    if idx < 0:
        return ""
    url.slice(idx, url.len())

fn normalize_runtime_request_url(base_url: text, request_url: text) -> text:
    if request_url.starts_with("http://") or
       request_url.starts_with("https://") or
       request_url.starts_with("file://") or
       request_url.starts_with("about:"):
        return request_url
    if request_url.starts_with("nil/"):
        return resolve_relative_url(base_url, request_url.slice(3, request_url.len()))
    resolve_relative_url(base_url, request_url)
