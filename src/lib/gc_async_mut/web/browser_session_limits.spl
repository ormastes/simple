# Browser session shared capacity limits.
# These lived in browser_session.spl, but that module imports browser_session_html.spl
# and browser_session_loading.spl back, and both val-import these limits: a val
# import from a still-loading module is rejected. They live in this import-free
# module; browser_session.spl re-exports them via `export use`.

# Retained image-source ceiling per session document.
pub val BROWSER_MAX_IMAGE_RESOURCES: i64 = 64
# Per-image decoded pixel budget; larger images are skipped with a warning.
pub val BROWSER_MAX_IMAGE_PIXELS: i64 = 131072

export BROWSER_MAX_IMAGE_RESOURCES, BROWSER_MAX_IMAGE_PIXELS
