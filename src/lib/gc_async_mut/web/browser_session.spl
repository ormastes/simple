val BROWSER_RUNTIME_FLUSH_ROUND_LIMIT: i32 = 8
val BROWSER_DOM_BRIDGE_MAX_ELEMENTS: i32 = 4096
val BROWSER_DOM_BRIDGE_MAX_PLAN_BYTES: i64 = 64 * 1024 * 1024
val BROWSER_DOM_BRIDGE_OVERSIZE = "\u0000simple-dom-oversize"
val BROWSER_HISTORY_MAX_ENTRIES: i32 = 64
val BROWSER_WARNING_MAX_ENTRIES: i64 = 128
val BROWSER_WARNING_MAX_BYTES: i64 = 4096

class BrowserHistoryEntry:
    url: text
    title: text
    source_html: text
    content_security_policy: text

    static fn create(url: text, title: text, source_html: text) -> BrowserHistoryEntry:
        BrowserHistoryEntry.create_with_policy(url, title, source_html, "")

    static fn create_with_policy(url: text, title: text, source_html: text, policy: text) -> BrowserHistoryEntry:
        BrowserHistoryEntry(
            url: url,
            title: title,
            source_html: source_html,
            content_security_policy: policy
        )

fn browser_history_push_bounded(
    history: [BrowserHistoryEntry], current_index: i32,
    entry: BrowserHistoryEntry
) -> [BrowserHistoryEntry]:
    """Drop stale forward/oldest entries after per-document size validation."""
    # ponytail: reload replacement can retain two resource budgets; introduce a
    # target-index rebasing result only if the 100 MiB ceiling proves material.
    var keep_count = current_index + 1
    if keep_count < 0:
        keep_count = 0
    if keep_count > history.len():
        keep_count = history.len()
    var candidates: [BrowserHistoryEntry] = []
    var i = 0
    while i < keep_count:
        candidates.push(history[i])
        i = i + 1
    candidates.push(entry)

    var start = candidates.len()
    var retained_count = 0
    var retained_bytes: i64 = 0
    while start > 0 and retained_count < BROWSER_HISTORY_MAX_ENTRIES:
        val size = candidates[start - 1].source_html.len()
        if (retained_count > 0 and
            size > BROWSER_MAX_RESOURCE_BYTES - retained_bytes):
            break
        start = start - 1
        retained_count = retained_count + 1
        retained_bytes = retained_bytes + size
    if start == 0:
        return candidates
    var bounded: [BrowserHistoryEntry] = []
    while start < candidates.len():
        bounded.push(candidates[start])
        start = start + 1
    bounded

class BrowserBookmarkSnapshot:
    entries: [Pair<text, text>]

    static fn create(entries: [Pair<text, text>]) -> BrowserBookmarkSnapshot:
        BrowserBookmarkSnapshot(entries: entries)

class BrowserRequest:
    id: text
    kind: text
    url: text
    method: text
    headers: text
    body: text
    content_type: text
    redirect_count: i32
    redirect_origin_url: text
    site_for_cookies_url: text
    credentials: text
    is_top_level_navigation: bool

    static fn create(id: text, kind: text, url: text, method: text, headers: text, body: text, content_type: text) -> BrowserRequest:
        BrowserRequest(
            id: id,
            kind: kind,
            url: url,
            method: method,
            headers: headers,
            body: body,
            content_type: content_type,
            redirect_count: 0,
            redirect_origin_url: url,
            site_for_cookies_url: "",
            credentials: "include",
            is_top_level_navigation: kind == "document"
        )

class BrowserResponse:
    request_id: text
    kind: text
    url: text
    status: i32
    headers: text
    body: text
    error: text

    static fn create(request_id: text, kind: text, url: text, status: i32, headers: text, body: text, error: text) -> BrowserResponse:
        BrowserResponse(
            request_id: request_id,
            kind: kind,
            url: url,
            status: status,
            headers: headers,
            body: body,
            error: error
        )

fn browser_status_is_redirect(status: i32) -> bool:
    status == 301 or status == 302 or status == 303 or status == 307 or status == 308

fn browser_status_is_success(status: i32) -> bool:
    status >= 200 and status < 300

fn browser_header_location(headers: text) -> text:
    browser_header_value(headers, "location")

fn browser_document_content_type_supported(headers: text) -> bool:
    var found = false
    var content_type = ""
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if (colon > 0 and
            line.slice(0, colon).trim().lower() == "content-type"):
            found = true
            content_type = line.slice(colon + 1, line.len()).trim().lower()
            break
    if not found:
        return true
    val separator = content_type.index_of(";")
    if separator >= 0:
        content_type = content_type.slice(0, separator)
    content_type.trim() == "text/html"

fn browser_header_value(headers: text, expected_name: text) -> text:
    val expected = expected_name.lower()
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if (colon > 0 and
            line.slice(0, colon).trim().lower() == expected):
            return line.slice(colon + 1, line.len()).trim()
    ""

fn browser_header_content_security_policy(headers: text) -> text:
    var policies = ""
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if colon > 0 and
           line.substring(0, colon).trim().lower() == "content-security-policy":
            if policies != "":
                policies = policies + "\n"
            policies = policies + line.substring(colon + 1).trim()
    policies

