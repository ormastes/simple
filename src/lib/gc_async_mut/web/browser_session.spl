class BrowserHistoryEntry:
    url: text
    title: text
    source_html: text
    persisted_html: text
    content_security_policy: text
    request_method: text
    request_body: text
    request_content_type: text

    static fn create(url: text, title: text, source_html: text) -> BrowserHistoryEntry:
        BrowserHistoryEntry.create_with_policy(url, title, source_html, "")

    static fn create_with_policy(url: text, title: text, source_html: text, policy: text) -> BrowserHistoryEntry:
        BrowserHistoryEntry.create_with_request(
            url, title, source_html, policy, "GET", "", ""
        )

    static fn create_with_request(
        url: text, title: text, source_html: text, policy: text,
        request_method: text, request_body: text, request_content_type: text
    ) -> BrowserHistoryEntry:
        BrowserHistoryEntry(
            url: url,
            title: title,
            source_html: source_html,
            persisted_html: "",
            content_security_policy: policy,
            request_method: request_method,
            request_body: request_body,
            request_content_type: request_content_type
        )

pub struct BrowserRenderRevisions:
    document_revision: i64
    style_revision: i64
    resource_revision: i64

pub struct BrowserRenderSnapshot:
    revisions: BrowserRenderRevisions
    document_html: text?
    resources_changed: bool

fn browser_history_push_bounded(
    history: [BrowserHistoryEntry], current_index: i32,
    entry: BrowserHistoryEntry
) -> [BrowserHistoryEntry]:
    """Drop stale forward/oldest entries after per-document size validation."""
    # ponytail: reload replacement can retain two resource budgets; introduce a
    # target-index rebasing result only if the 100 MiB ceiling proves material.
    var keep_count = current_index + 1
    if keep_count < 0:
        keep_count = 0
    if keep_count > history.len():
        keep_count = history.len()
    var candidates: [BrowserHistoryEntry] = []
    var i = 0
    while i < keep_count:
        candidates.push(history[i])
        i = i + 1
    candidates.push(entry)

    var start = candidates.len()
    var retained_count = 0
    var retained_bytes: i64 = 0
    while start > 0 and retained_count < BROWSER_HISTORY_MAX_ENTRIES:
        val size = (
            candidates[start - 1].source_html.len() +
            candidates[start - 1].persisted_html.len() +
            candidates[start - 1].request_method.len() +
            candidates[start - 1].request_body.len() +
            candidates[start - 1].request_content_type.len()
        )
        if (retained_count > 0 and
            size > BROWSER_MAX_RESOURCE_BYTES - retained_bytes):
            break
        start = start - 1
        retained_count = retained_count + 1
        retained_bytes = retained_bytes + size
    if start == 0:
        return candidates
    var bounded: [BrowserHistoryEntry] = []
    while start < candidates.len():
        bounded.push(candidates[start])
        start = start + 1
    bounded

class BrowserBookmarkSnapshot:
    entries: [Pair<text, text>]

    static fn create(entries: [Pair<text, text>]) -> BrowserBookmarkSnapshot:
        BrowserBookmarkSnapshot(entries: entries)

pub fn browser_bookmark_stored_title(raw_title: text) -> text:
    val title = raw_title.trim()
    if not hosted_browser_title_is_valid(title):
        return ""
    title

pub fn browser_bookmark_title_or_url(
    stored_title: text, canonical_url: text
) -> text:
    val title = browser_bookmark_stored_title(stored_title)
    if title != "": title else: canonical_url

