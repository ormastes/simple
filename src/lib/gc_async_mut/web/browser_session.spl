class BrowserStylesheetExpansion:
    html: text
    sources: [BrowserStylesheetSource]

    static fn create(html: text, sources: [BrowserStylesheetSource]) -> BrowserStylesheetExpansion:
        BrowserStylesheetExpansion(html: html, sources: sources)

class BrowserScriptBlock:
    kind: text
    content: text
    src: text
    script_type: text
    is_async: bool
    is_defer: bool

    static fn inline(content: text) -> BrowserScriptBlock:
        BrowserScriptBlock(
            kind: "inline",
            content: content,
            src: "",
            script_type: "",
            is_async: false,
            is_defer: false
        )

    static fn external(src: text) -> BrowserScriptBlock:
        BrowserScriptBlock(
            kind: "external",
            content: "",
            src: src,
            script_type: "",
            is_async: false,
            is_defer: false
        )

    static fn with_attrs(kind: text, content: text, src: text, script_type: text, is_async: bool, is_defer: bool) -> BrowserScriptBlock:
        BrowserScriptBlock(
            kind: kind,
            content: content,
            src: src,
            script_type: script_type,
            is_async: is_async,
            is_defer: is_defer
        )

    me as_ordered_classic() -> BrowserScriptBlock:
        BrowserScriptBlock(
            kind: self.kind,
            content: self.content,
            src: self.src,
            script_type: self.script_type,
            is_async: false,
            is_defer: false
        )

class BrowserLoadState:
    document_url: text
    source_html: text
    target_index: i32
    push_history: bool
    script_blocks: [BrowserScriptBlock]
    next_script_idx: i32
    warnings: [text]
    style_sources: [BrowserStylesheetSource]
    next_style_idx: i32
    stylesheet_source_bytes: i64
    stylesheet_html_bytes: i64
    stylesheet_html_chunks: [text]
    pending_module: BrowserPendingModuleEval?

    static fn create(document_url: text, source_html: text, target_index: i32, push_history: bool, script_blocks: [BrowserScriptBlock], style_sources: [BrowserStylesheetSource]) -> BrowserLoadState:
        BrowserLoadState(
            document_url: document_url,
            source_html: source_html,
            target_index: target_index,
            push_history: push_history,
            script_blocks: script_blocks,
            next_script_idx: 0,
            warnings: [],
            style_sources: style_sources,
            next_style_idx: 0,
            stylesheet_source_bytes: 0,
            stylesheet_html_bytes: 0,
            stylesheet_html_chunks: [],
            pending_module: nil
        )

impl BrowserLoadState:

    me append_warning(warning: text):
        if self.warnings.len() >= BROWSER_WARNING_MAX_ENTRIES:
            return
        val bounded = if warning.len() > BROWSER_WARNING_MAX_BYTES:
            warning.slice(0, BROWSER_WARNING_MAX_BYTES)
        else:
            warning
        for existing in self.warnings:
            if existing == bounded:
                return
        self.warnings.push(bounded)

    me admit_stylesheet(
        document_url: text, base_url: text, css_text: text
    ) -> BrowserStylesheetExpansion?:
        val source_bytes = css_text.len()
        if (source_bytes > BROWSER_RENDERER_MAX_PAYLOAD_BYTES -
            self.stylesheet_source_bytes):
            self.append_warning(
                "stylesheet byte limit reached; remaining styles ignored"
            )
            self.next_style_idx = self.style_sources.len()
            return nil
        val expanded = expand_stylesheet_text(document_url, base_url, css_text)
        val html_bytes = expanded.html.len()
        if (html_bytes > BROWSER_RENDERER_MAX_PAYLOAD_BYTES -
            self.stylesheet_html_bytes):
            self.append_warning(
                "stylesheet byte limit reached; remaining styles ignored"
            )
            self.next_style_idx = self.style_sources.len()
            return nil
        self.stylesheet_source_bytes = self.stylesheet_source_bytes + source_bytes
        self.stylesheet_html_bytes = self.stylesheet_html_bytes + html_bytes
        if expanded.html != "":
            self.stylesheet_html_chunks.push(expanded.html)
        Some(expanded)

    fn stylesheet_html() -> text:
        self.stylesheet_html_chunks.join("")

class BrowserRuntimeState:
    runtime: JsRuntime
    window_id: i64
    document_id: i64
    body_id: i64
    location_id: i64
    history_id: i64
    navigator_id: i64
    chrome_id: i64
    session_storage_id: i64
    local_storage_id: i64
    dom_node_ids: [i64]
    dom_element_ids: [i64]
    dom_element_list_id: i64
    dom_style_ids: [i64]
    dom_id_snapshots: [text]
    dom_class_snapshots: [text]
    dom_value_snapshots: [text]
    dom_style_snapshots: [text]
    dom_bridge_generation: i64
    dom_mutation_generation: i64

    static fn create(
        url: text,
        title: text,
        body_html: text,
        session_storage: [Pair<text, text>],
        local_storage: [Pair<text, text>],
        cookie_text: text
    ) -> BrowserRuntimeState:
        val logger = Logger.new("browser-session", LogLevel.Error)
        var runtime = JsRuntime.new_browser(logger)
        val global_env = runtime.interpreter.global_env
        val is_guest_runtime = url.starts_with("https://guest.runtime/")
        if is_guest_runtime:
            print "[BRS] runtime create stage=after-new"

        val body_id = runtime.create_host_object()
        if is_guest_runtime:
            print "[BRS] runtime create stage=body-object"
        runtime.set_host_property(body_id, "innerHTML", JsValue.String(v: body_html))
        if is_guest_runtime:
            print "[BRS] runtime create stage=body-innerHTML"
        val body_text = if is_guest_runtime: "" else: html_to_text(body_html)
        if is_guest_runtime:
            print "[BRS] runtime create stage=body-text-ready"
        runtime.set_host_property(body_id, "textContent", JsValue.String(v: body_text))
        if is_guest_runtime:
            print "[BRS] runtime create stage=body-props"

        val location_id = runtime.create_host_object()
        if is_guest_runtime:
            print "[BRS] runtime create stage=location-object"
        runtime.set_host_property(location_id, "href", JsValue.String(v: url))
        runtime.set_host_property(location_id, "protocol", JsValue.String(v: url_protocol(url)))
        runtime.set_host_property(location_id, "host", JsValue.String(v: url_host(url)))
        runtime.set_host_property(location_id, "origin", JsValue.String(v: url_origin(url)))
        runtime.set_host_property(location_id, "pathname", JsValue.String(v: url_pathname(url)))
        runtime.set_host_property(location_id, "search", JsValue.String(v: url_search(url)))
        runtime.set_host_property(location_id, "hash", JsValue.String(v: url_hash(url)))
        if is_guest_runtime:
            print "[BRS] runtime create stage=location-props"

        val history_id = runtime.create_host_object()
        runtime.set_host_property(history_id, "length", JsValue.Number(v: 1.0))
        runtime.set_host_property(history_id, "state", JsValue.Null)

        val navigator_id = runtime.create_host_object()
        if is_guest_runtime:
            print "[BRS] runtime create stage=navigator-object"
        val navigator_user_agent =
            if is_guest_runtime:
                guest_runtime_user_agent()
            else:
                chrome_user_agent()
        val navigator_platform_name =
            if is_guest_runtime:
                guest_runtime_platform()
            else:
                navigator_platform()
        runtime.set_host_property(
            navigator_id,
            "userAgent",
            JsValue.String(v: navigator_user_agent)
        )
        runtime.set_host_property(
            navigator_id,
            "vendor",
            JsValue.String(v: "Google Inc.")
        )
        runtime.set_host_property(
            navigator_id,
            "platform",
            JsValue.String(v: navigator_platform_name)
        )
        runtime.set_host_property(
            navigator_id,
            "language",
            JsValue.String(v: "en-US")
        )
        val is_secure_context = browser_session_is_secure_context(url)
        if is_secure_context:
            val gpu_id = runtime.create_host_object()
            runtime.set_host_property(gpu_id, "__simple_webgpu_host", JsValue.Boolean(v: true))
            runtime.set_host_property(gpu_id, "secureContext", JsValue.Boolean(v: true))
            runtime.set_host_property(gpu_id, "adapterAvailable", JsValue.Boolean(v: true))
            runtime.set_host_property(gpu_id, "softwareFallback", JsValue.Boolean(v: true))
            runtime.set_host_property(gpu_id, "requestAdapterStatus", JsValue.String(v: "available"))
            runtime.set_host_property(gpu_id, "preferredCanvasFormat", JsValue.String(v: "bgra8unorm"))
            runtime._define_method_on(gpu_id, "requestAdapter", NATIVE_NAVIGATOR_GPU_REQUEST_ADAPTER)
            runtime.set_host_property(navigator_id, "gpu", JsValue.Object(id: gpu_id))
        if is_guest_runtime:
            print "[BRS] runtime create stage=navigator-props"

        val chrome_id = runtime.create_host_object()
        if is_guest_runtime:
            print "[BRS] runtime create stage=chrome-object"
        val chrome_runtime_id = runtime.create_host_object()
        runtime.set_host_property(chrome_id, "runtime", JsValue.Object(id: chrome_runtime_id))
        if is_guest_runtime:
            print "[BRS] runtime create stage=chrome-props"

        val session_storage_result = storage_object_from_pairs(runtime, session_storage)
        runtime = session_storage_result.0
        val session_storage_id = session_storage_result.1
        val local_storage_result = storage_object_from_pairs(runtime, local_storage)
        runtime = local_storage_result.0
        val local_storage_id = local_storage_result.1
        if is_guest_runtime:
            print "[BRS] runtime create stage=after-storage-objects"

        val document_id = runtime.create_host_object()
        runtime.set_host_property(document_id, "title", JsValue.String(v: title))
        runtime.set_host_property(document_id, "readyState", JsValue.String(v: "loading"))
        runtime.set_host_property(document_id, "body", JsValue.Object(id: body_id))
        runtime.set_host_property(document_id, "URL", JsValue.String(v: url))
        runtime.set_host_property(document_id, "location", JsValue.Object(id: location_id))
        runtime.set_host_property(document_id, "cookie", JsValue.String(v: cookie_text))

        val window_id = runtime.create_host_object()
        if is_guest_runtime:
            print "[BRS] runtime create stage=after-window-document"
        runtime.set_host_property(window_id, "window", JsValue.Object(id: window_id))
        runtime.set_host_property(window_id, "self", JsValue.Object(id: window_id))
        runtime.set_host_property(window_id, "top", JsValue.Object(id: window_id))
        runtime.set_host_property(window_id, "globalThis", JsValue.Object(id: window_id))
        runtime.set_host_property(window_id, "document", JsValue.Object(id: document_id))
        runtime.set_host_property(window_id, "location", JsValue.Object(id: location_id))
        runtime.set_host_property(window_id, "history", JsValue.Object(id: history_id))
        runtime.set_host_property(window_id, "navigator", JsValue.Object(id: navigator_id))
        runtime.set_host_property(window_id, "chrome", JsValue.Object(id: chrome_id))
        runtime.set_host_property(window_id, "sessionStorage", JsValue.Object(id: session_storage_id))
        runtime.set_host_property(window_id, "localStorage", JsValue.Object(id: local_storage_id))
        runtime.set_host_property(window_id, "isSecureContext", JsValue.Boolean(v: is_secure_context))
        runtime._define_method_on(window_id, "fetch", NATIVE_FETCH)
        runtime._define_global_native("fetch", NATIVE_FETCH)
        runtime._define_global_native("ArrayBuffer", NATIVE_ARRAY_BUFFER_CONSTRUCTOR)
        runtime._define_global_native("Uint8Array", NATIVE_UINT8_ARRAY_CONSTRUCTOR)
        runtime._define_global_native("DataView", NATIVE_DATA_VIEW_CONSTRUCTOR)
        runtime._define_global_native("TextEncoder", NATIVE_TEXT_ENCODER_CONSTRUCTOR)
        runtime._define_global_native("TextDecoder", NATIVE_TEXT_DECODER_CONSTRUCTOR)
        match runtime.interpreter.lookup_global_value("ArrayBuffer"):
            Some(v):
                runtime.set_host_property(window_id, "ArrayBuffer", v)
            _:
                pass_dn("optional ArrayBuffer mirror is absent after native registration")
        match runtime.interpreter.lookup_global_value("Uint8Array"):
            Some(v):
                runtime.set_host_property(window_id, "Uint8Array", v)
            _:
                pass_dn("optional Uint8Array mirror is absent after native registration")
        match runtime.interpreter.lookup_global_value("DataView"):
            Some(v):
                runtime.set_host_property(window_id, "DataView", v)
            _:
                pass_dn("optional DataView mirror is absent after native registration")
        match runtime.interpreter.lookup_global_value("TextEncoder"):
            Some(v):
                runtime.set_host_property(window_id, "TextEncoder", v)
            _:
                pass_dn("optional TextEncoder mirror is absent after native registration")
        match runtime.interpreter.lookup_global_value("TextDecoder"):
            Some(v):
                runtime.set_host_property(window_id, "TextDecoder", v)
            _:
                pass_dn("optional TextDecoder mirror is absent after native registration")

        val webassembly_id = runtime.create_host_object()
        runtime.set_host_property(webassembly_id, "__simple_wasm_host", JsValue.Boolean(v: true))
        runtime.set_host_property(webassembly_id, "instantiateStatus", JsValue.String(v: "available"))
        runtime.set_host_property(webassembly_id, "supportedTarget", JsValue.String(v: "wasm32"))
        runtime._define_method_on(webassembly_id, "validate", NATIVE_WEBASSEMBLY_VALIDATE)
        runtime._define_method_on(webassembly_id, "instantiate", NATIVE_WEBASSEMBLY_INSTANTIATE)
        runtime._define_method_on(webassembly_id, "instantiateStreaming", NATIVE_WEBASSEMBLY_INSTANTIATE_STREAMING)
        runtime._define_method_on(webassembly_id, "compile", NATIVE_WEBASSEMBLY_COMPILE)
        runtime._define_method_on(webassembly_id, "compileStreaming", NATIVE_WEBASSEMBLY_COMPILE_STREAMING)
        runtime._define_method_on(webassembly_id, "Module", NATIVE_WEBASSEMBLY_MODULE_CONSTRUCTOR)
        match runtime.get_host_property(webassembly_id, "Module"):
            JsValue.Function(fn_id):
                runtime._define_method_on(fn_id, "exports", NATIVE_WEBASSEMBLY_MODULE_EXPORTS)
                runtime._define_method_on(fn_id, "imports", NATIVE_WEBASSEMBLY_MODULE_IMPORTS)
            _:
                pass_dn("WebAssembly.Module metadata is optional when constructor binding is unavailable")
        runtime._define_method_on(webassembly_id, "Instance", NATIVE_WEBASSEMBLY_INSTANCE_CONSTRUCTOR)
        runtime._define_method_on(webassembly_id, "Memory", NATIVE_WEBASSEMBLY_MEMORY_CONSTRUCTOR)
        runtime._define_method_on(webassembly_id, "Table", NATIVE_WEBASSEMBLY_TABLE_CONSTRUCTOR)
        runtime._define_method_on(webassembly_id, "Global", NATIVE_WEBASSEMBLY_GLOBAL_CONSTRUCTOR)
        runtime.set_host_property(window_id, "WebAssembly", JsValue.Object(id: webassembly_id))

        runtime.interpreter.define_global_value("window", JsValue.Object(id: window_id))
        runtime.interpreter.define_global_value("self", JsValue.Object(id: window_id))
        runtime.interpreter.define_global_value("globalThis", JsValue.Object(id: window_id))
        runtime.interpreter.define_global_value("document", JsValue.Object(id: document_id))
        runtime.interpreter.define_global_value("location", JsValue.Object(id: location_id))
        runtime.interpreter.define_global_value("history", JsValue.Object(id: history_id))
        runtime.interpreter.define_global_value("navigator", JsValue.Object(id: navigator_id))
        runtime.interpreter.define_global_value("chrome", JsValue.Object(id: chrome_id))
        runtime.interpreter.define_global_value("sessionStorage", JsValue.Object(id: session_storage_id))
        runtime.interpreter.define_global_value("localStorage", JsValue.Object(id: local_storage_id))
        runtime.interpreter.define_global_value("WebAssembly", JsValue.Object(id: webassembly_id))
        var interpreter = runtime.interpreter
        interpreter.host_window_id = window_id
        interpreter.host_document_id = document_id
        interpreter.host_body_id = body_id
        interpreter.host_location_id = location_id
        interpreter.host_navigator_id = navigator_id
        interpreter.host_chrome_id = chrome_id
        interpreter.host_session_storage_id = session_storage_id
        interpreter.host_local_storage_id = local_storage_id
        interpreter.host_document_title_value = JsValue.String(v: title)
        interpreter.host_document_cookie_value = JsValue.String(v: cookie_text)
        interpreter.host_body_inner_html_value = JsValue.String(v: body_html)
        val host_body_text_value = if is_guest_runtime: JsValue.String(v: "") else: JsValue.String(v: html_to_text(body_html))
        interpreter.host_body_text_content_value = host_body_text_value
        interpreter.host_body_mutation_hook = _browser_host_body_mutation_plan
        runtime.interpreter = interpreter
        if is_guest_runtime:
            print "[BRS] runtime create stage=after-define-globals"

        runtime = install_storage_api(runtime, session_storage_id)
        runtime = install_storage_api(runtime, local_storage_id)
        runtime = sync_storage_runtime_state(runtime, session_storage_id, session_storage)
        runtime = sync_storage_runtime_state(runtime, local_storage_id, local_storage)
        var runtime_after_url_search_params_api = runtime
        val _url_search_params_api_result = runtime_after_url_search_params_api.eval(
            "function __usp_sp(v) { var out = ''; for (var i = 0; i < v.length; i = i + 1) { var ch = v.slice(i, i + 1); out = out + (ch === ' ' ? '+' : ch); } return out; } function __usp_ps(v) { var out = ''; for (var i = 0; i < v.length; i = i + 1) { var ch = v.slice(i, i + 1); out = out + (ch === '+' ? ' ' : ch); } return out; } function __usp_k(pair) { var eq = pair.indexOf('='); return __usp_ps(eq >= 0 ? pair.slice(0, eq) : pair); } function __usp_v(pair) { var eq = pair.indexOf('='); return __usp_ps(eq >= 0 ? pair.slice(eq + 1) : ''); } function __usp_get(q, name) { var pos = 0; while (pos <= q.length) { var rest = q.slice(pos); var amp = rest.indexOf('&'); var pair = amp >= 0 ? rest.slice(0, amp) : rest; if (pair !== '' && __usp_k(pair) === name) { return __usp_v(pair); } if (amp < 0) { break; } pos = pos + amp + 1; } return null; } function __usp_has(q, name) { var pos = 0; while (pos <= q.length) { var rest = q.slice(pos); var amp = rest.indexOf('&'); var pair = amp >= 0 ? rest.slice(0, amp) : rest; if (pair !== '' && __usp_k(pair) === name) { return true; } if (amp < 0) { break; } pos = pos + amp + 1; } return false; } function __usp_set(q, name, value) { var out = ''; var found = false; var pos = 0; while (pos <= q.length) { var rest = q.slice(pos); var amp = rest.indexOf('&'); var pair = amp >= 0 ? rest.slice(0, amp) : rest; if (pair !== '') { if (__usp_k(pair) === name) { if (!found) { out = out + (out === '' ? '' : '&') + __usp_sp(name) + '=' + __usp_sp(value); found = true; } } else { out = out + (out === '' ? '' : '&') + pair; } } if (amp < 0) { break; } pos = pos + amp + 1; } if (!found) { out = out + (out === '' ? '' : '&') + __usp_sp(name) + '=' + __usp_sp(value); } return out; } class URLSearchParams { constructor(init) { var text = (init === undefined || init === null) ? '' : String(init); if (text.slice(0, 1) === '?') { text = text.slice(1); } this._query = text; } get(name) { return __usp_get(this._query, String(name)); } has(name) { return __usp_has(this._query, String(name)); } set(name, value) { this._query = __usp_set(this._query, String(name), String(value)); } append(name, value) { this._query = this._query + (this._query === '' ? '' : '&') + __usp_sp(String(name)) + '=' + __usp_sp(String(value)); } toString() { return this._query; } } window.URLSearchParams = URLSearchParams;"
        )
        runtime = runtime_after_url_search_params_api
        var runtime_after_location_api = runtime
        val _location_api_result = runtime_after_location_api.eval(
            "location.assign = function(url) { location.__simple_navigation_mode = 'assign'; location.href = url; }; location.replace = function(url) { location.__simple_navigation_mode = 'replace'; location.href = url; };"
        )
        runtime = runtime_after_location_api
        var runtime_after_history_api = runtime
        val _history_api_result = runtime_after_history_api.eval(
            "history.pushState = function(state, title, url) { location.__simple_navigation_mode = 'pushState'; location.__simple_history_url = url; location.__simple_history_state = state; location.href = url; }; history.replaceState = function(state, title, url) { location.__simple_navigation_mode = 'replaceState'; location.__simple_history_url = url; location.__simple_history_state = state; location.href = url; };"
        )
        runtime = runtime_after_history_api
        if is_guest_runtime:
            print "[BRS] runtime create stage=after-install-storage"

        var state = BrowserRuntimeState(
            runtime: runtime,
            window_id: window_id,
            document_id: document_id,
            body_id: body_id,
            location_id: location_id,
            history_id: history_id,
            navigator_id: navigator_id,
            chrome_id: chrome_id,
            session_storage_id: session_storage_id,
            local_storage_id: local_storage_id,
            dom_node_ids: [],
            dom_element_ids: [],
            dom_element_list_id: -1,
            dom_style_ids: [],
            dom_id_snapshots: [],
            dom_class_snapshots: [],
            dom_value_snapshots: [],
            dom_style_snapshots: [],
            dom_bridge_generation: 0,
            dom_mutation_generation: 0
        )
        state

fn _browser_dom_js_text(value: JsValue) -> text:
    match value:
        JsValue.String(v): v
        JsValue.Number(v): "{v}"
        JsValue.Boolean(v):
            if v: "true"
            else: "false"
        JsValue.Null: ""
        _: ""

fn _browser_dom_css_name(name: text) -> text:
    if name == "cssFloat":
        return "float"
    var out = ""
    for ch in name:
        if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(ch):
            out = out + "-" + ch.lower()
        else:
            out = out + ch
    out

fn _browser_dom_css_js_name(name: text) -> text:
    if name.starts_with("--"):
        return name
    var out = ""
    var uppercase_next = false
    for ch in name:
        if ch == "-":
            uppercase_next = true
        elif uppercase_next:
            out = out + ch.upper()
            uppercase_next = false
        else:
            out = out + ch
    out

fn _browser_host_body_mutation_plan(
    property: text, value: text
) -> JsHostBodyMutationPlan:
    if property != "innerHTML" and property != "textContent":
        return JsHostBodyMutationPlan(
            handled: true,
            ok: false,
            canonical_body_html: "",
            canonical_body_text: "",
            elements: []
        )
    val body_html = if property == "textContent":
        escape_html_text(value)
    else:
        value
    if not browser_resource_size_allowed(body_html.len()):
        return JsHostBodyMutationPlan(
            handled: true,
            ok: false,
            canonical_body_html: "",
            canonical_body_text: "",
            elements: []
        )
    val root = html_tree_builder_build(
        "<html><body>" + body_html + "</body></html>"
    )
    var stack: [BeDomNode] = [root]
    var elements: [JsHostDomElementPlan] = []
    var plan_bytes = body_html.len()
    while stack.len() > 0:
        val node = stack.pop()
        if node.tag_name != "#document" and node.tag_name != "#text":
            if elements.len() >= BROWSER_DOM_BRIDGE_MAX_ELEMENTS:
                return JsHostBodyMutationPlan(
                    handled: true,
                    ok: false,
                    canonical_body_html: "",
                    canonical_body_text: "",
                    elements: []
                )
            var style_names: [text] = []
            var style_values: [text] = []
            var style_snapshot = ""
            val author_id = be_dom_get_attr(node, "id")
            val class_name = be_dom_get_attr(node, "class")
            val element_value = be_dom_get_attr(node, "value")
            val text_content = be_dom_get_text_content(node)
            plan_bytes = (
                plan_bytes + node.tag_name.len() + author_id.len() +
                class_name.len() + element_value.len() + text_content.len()
            )
            if plan_bytes > BROWSER_DOM_BRIDGE_MAX_PLAN_BYTES:
                return JsHostBodyMutationPlan(
                    handled: true,
                    ok: false,
                    canonical_body_html: "",
                    canonical_body_text: "",
                    elements: []
                )
            val inner_html = be_dom_serialize_children(node)
            plan_bytes = plan_bytes + inner_html.len()
            if plan_bytes > BROWSER_DOM_BRIDGE_MAX_PLAN_BYTES:
                return JsHostBodyMutationPlan(
                    handled: true,
                    ok: false,
                    canonical_body_html: "",
                    canonical_body_text: "",
                    elements: []
                )
            val style_text = be_dom_get_attr(node, "style")
            for declaration in style_text.split(";"):
                val separator = declaration.index_of(":")
                if separator > 0:
                    val property_name = declaration.substring(
                        0, separator
                    ).trim()
                    val property_value = declaration.substring(
                        separator + 1, declaration.len()
                    ).trim()
                    if property_name != "" and property_value != "":
                        val js_name = _browser_dom_css_js_name(property_name)
                        style_names.push(js_name)
                        style_values.push(property_value)
                        plan_bytes = (
                            plan_bytes + js_name.len() +
                            property_value.len() * 2 + 2
                        )
                        if style_snapshot != "" and
                           not style_snapshot.ends_with(";"):
                            style_snapshot = style_snapshot + ";"
                        style_snapshot = (
                            style_snapshot +
                            _browser_dom_css_name(js_name) + ":" +
                            property_value + ";"
                        )
            if plan_bytes > BROWSER_DOM_BRIDGE_MAX_PLAN_BYTES:
                return JsHostBodyMutationPlan(
                    handled: true,
                    ok: false,
                    canonical_body_html: "",
                    canonical_body_text: "",
                    elements: []
                )
            elements.push(JsHostDomElementPlan(
                is_body: node.tag_name == "body",
                tag_name: node.tag_name.upper(),
                author_id: author_id,
                class_name: class_name,
                value: element_value,
                text_content: text_content,
                inner_html: inner_html,
                style_names: style_names,
                style_values: style_values,
                style_snapshot: style_snapshot
            ))
        var child_index = node.children.len() - 1
        while child_index >= 0:
            stack.push(node.children[child_index])
            child_index = child_index - 1
    JsHostBodyMutationPlan(
        handled: true,
        ok: true,
        canonical_body_html: body_html,
        canonical_body_text: if property == "textContent":
            value
        else:
            html_to_text(body_html),
        elements: elements
    )

fn _browser_dom_css_property_matches(left: text, right: text) -> bool:
    if left.starts_with("--") or right.starts_with("--"):
        return left == right
    left.lower() == right.lower()

fn _browser_dom_style_replace_declaration(
    declarations: [CssDecl], property: text, value: text
) -> [CssDecl]:
    var next: [CssDecl] = []
    for declaration in declarations:
        if not _browser_dom_css_property_matches(
            declaration.property, property
        ):
            next.push(declaration)
    if value != "":
        for declaration in parse_declarations(property + ":" + value):
            next = _browser_dom_style_replace_declaration(
                next, declaration.property, ""
            )
            next.push(declaration)
    next

fn _browser_dom_style_snapshot(runtime: JsRuntime, object_id: i64) -> text:
    val object = runtime.get_host_object(object_id)
    var css_text_index = -1
    var css_text = ""
    var property_index = 0
    while property_index < object.properties.len():
        val prop = object.properties[property_index]
        if prop.key == "cssText":
            css_text = _browser_dom_js_text(prop.value).trim()
            if not browser_resource_size_allowed(css_text.len()):
                return BROWSER_DOM_BRIDGE_OVERSIZE
            css_text_index = property_index
        property_index = property_index + 1
    var declarations = parse_declarations(css_text)
    property_index = css_text_index + 1
    while property_index < object.properties.len():
        val prop = object.properties[property_index]
        if (
            prop.key != "cssText" and prop.key != "setProperty" and
            prop.key != "getPropertyValue" and prop.key != "removeProperty" and
            not prop.key.starts_with("__")
        ):
            val value = _browser_dom_js_text(prop.value)
            if not browser_resource_size_allowed(
                prop.key.len() + value.len() + 1
            ):
                return BROWSER_DOM_BRIDGE_OVERSIZE
            declarations = _browser_dom_style_replace_declaration(
                declarations, _browser_dom_css_name(prop.key), value
            )
        property_index = property_index + 1
    var out = ""
    for declaration in declarations:
        if not browser_resource_size_allowed(
            out.len() + declaration.property.len() +
            declaration.value.len() + 2
        ):
            return BROWSER_DOM_BRIDGE_OVERSIZE
        out = (
            out + declaration.property + ":" + declaration.value + ";"
        )
    out

class BrowserDomSyncResult:
    root: BeDomNode
    changed: bool

impl BrowserRuntimeState:

    me _bind_dom_node(node: BeDomNode, element_list_id: i64):
        if self.dom_node_ids.len() >= BROWSER_DOM_BRIDGE_MAX_ELEMENTS:
            return
        if node.tag_name == "#document":
            for child in node.children:
                self._bind_dom_node(child, element_list_id)
            return
        if node.tag_name == "#text":
            return

        var runtime = self.runtime
        val element_id = if node.tag_name == "body":
            self.body_id
        else:
            runtime.create_host_object()
        val style_id = runtime.create_host_object()
        val text_content = be_dom_get_text_content(node)
        val inner_html = be_dom_serialize_children(node)
        val author_id = be_dom_get_attr(node, "id")
        val class_name = be_dom_get_attr(node, "class")
        val value = be_dom_get_attr(node, "value")
        val style_text = be_dom_get_attr(node, "style")

        runtime.set_host_property(style_id, "cssText", JsValue.String(v: ""))
        for declaration in style_text.split(";"):
            val separator = declaration.index_of(":")
            if separator > 0:
                val property_name = declaration.substring(0, separator).trim()
                val property_value = declaration.substring(
                    separator + 1, declaration.len()
                ).trim()
                if property_name != "" and property_value != "":
                    runtime.set_host_property(
                        style_id, _browser_dom_css_js_name(property_name),
                        JsValue.String(v: property_value)
                    )
        runtime.set_host_property(element_id, "__simple_node_id", JsValue.Number(v: node.node_id.to_f64()))
        runtime.set_host_property(element_id, "style", JsValue.Object(id: style_id))
        runtime.set_host_property(element_id, "tagName", JsValue.String(v: node.tag_name.upper()))
        runtime.set_host_property(element_id, "id", JsValue.String(v: author_id))
        runtime.set_host_property(element_id, "className", JsValue.String(v: class_name))
        runtime.set_host_property(element_id, "value", JsValue.String(v: value))
        runtime.set_host_property(element_id, "textContent", JsValue.String(v: text_content))
        runtime.set_host_property(element_id, "innerHTML", JsValue.String(v: inner_html))
        val element_index = self.dom_element_ids.len()
        runtime.set_host_property(
            element_list_id, "{element_index}", JsValue.Object(id: element_id)
        )
        self.runtime = runtime

        self.dom_node_ids.push(node.node_id)
        self.dom_element_ids.push(element_id)
        self.dom_style_ids.push(style_id)
        self.dom_id_snapshots.push(author_id)
        self.dom_class_snapshots.push(class_name)
        self.dom_value_snapshots.push(value)
        self.dom_style_snapshots.push(
            _browser_dom_style_snapshot(runtime, style_id)
        )

        for child in node.children:
            self._bind_dom_node(child, element_list_id)

    me bind_dom(root: BeDomNode):
        self.dom_node_ids = []
        self.dom_element_ids = []
        self.dom_style_ids = []
        self.dom_id_snapshots = []
        self.dom_class_snapshots = []
        self.dom_value_snapshots = []
        self.dom_style_snapshots = []

        var runtime = self.runtime
        val element_list_id = runtime.create_host_object()
        self.dom_element_list_id = element_list_id
        self.runtime = runtime
        self._bind_dom_node(root, element_list_id)
        runtime = self.runtime
        runtime.set_host_property(
            element_list_id, "length",
            JsValue.Number(v: self.dom_element_ids.len().to_f64())
        )
        runtime.set_host_property(
            self.document_id, "__simple_elements",
            JsValue.Array(id: element_list_id)
        )
        val _ = runtime.eval(
            "function __simple_dom_matches(el, selector) { if (el === null || el === undefined || selector === '') { return false; } var first = selector.slice(0, 1); if (first === '#') { return el.id === selector.slice(1); } if (first === '.') { return (' ' + el.className + ' ').indexOf(' ' + selector.slice(1) + ' ') >= 0; } return el.tagName.toLowerCase() === selector.toLowerCase(); } function __simple_css_key(name) { name = String(name); if (name.slice(0, 2) === '--') { return name; } var out = ''; var upper = false; for (var i = 0; i < name.length; i = i + 1) { var ch = name.slice(i, i + 1); if (ch === '-') { upper = true; } else { out = out + (upper ? ch.toUpperCase() : ch); upper = false; } } return out; } document.getElementById = function(id) { var all = document.__simple_elements; for (var i = 0; i < all.length; i = i + 1) { if (all[i].id === String(id)) { return all[i]; } } return null; }; document.querySelector = function(selector) { var all = document.__simple_elements; for (var i = 0; i < all.length; i = i + 1) { if (__simple_dom_matches(all[i], String(selector))) { return all[i]; } } return null; }; document.querySelectorAll = function(selector) { var all = document.__simple_elements; var out = []; for (var i = 0; i < all.length; i = i + 1) { if (__simple_dom_matches(all[i], String(selector))) { out.push(all[i]); } } return out; }; function __simple_dom_install(el) { el.style.setProperty = function(name, value) { this[__simple_css_key(name)] = String(value); }; el.style.getPropertyValue = function(name) { var value = this[__simple_css_key(name)]; return value === undefined || value === null ? '' : String(value); }; el.style.removeProperty = function(name) { var key = __simple_css_key(name); var old = this.getPropertyValue(name); this[key] = ''; return old; }; } for (var __simple_i = 0; __simple_i < document.__simple_elements.length; __simple_i = __simple_i + 1) { __simple_dom_install(document.__simple_elements[__simple_i]); }"
        )
        var interpreter = runtime.interpreter
        interpreter.host_dom_element_list_id = self.dom_element_list_id
        interpreter.host_dom_element_ids = self.dom_element_ids
        interpreter.host_dom_style_ids = self.dom_style_ids
        interpreter.host_dom_id_snapshots = self.dom_id_snapshots
        interpreter.host_dom_class_snapshots = self.dom_class_snapshots
        interpreter.host_dom_value_snapshots = self.dom_value_snapshots
        interpreter.host_dom_style_snapshots = self.dom_style_snapshots
        runtime.interpreter = interpreter
        self.runtime = runtime
        self.dom_bridge_generation = (
            runtime.interpreter.host_dom_bridge_generation
        )
        self.dom_mutation_generation = (
            runtime.interpreter.host_dom_mutation_generation
        )

    me adopt_dom_bridge(root: BeDomNode) -> bool:
        val interpreter = self.runtime.interpreter
        if interpreter.host_dom_bridge_generation == self.dom_bridge_generation:
            return false
        var stack: [BeDomNode] = [root]
        var node_ids: [i64] = []
        while stack.len() > 0:
            val node = stack.pop()
            if node.tag_name != "#document" and node.tag_name != "#text":
                node_ids.push(node.node_id)
            var child_index = node.children.len() - 1
            while child_index >= 0:
                stack.push(node.children[child_index])
                child_index = child_index - 1
        val element_count = interpreter.host_dom_element_ids.len()
        if (
            node_ids.len() != element_count or
            interpreter.host_dom_style_ids.len() != element_count or
            interpreter.host_dom_id_snapshots.len() != element_count or
            interpreter.host_dom_class_snapshots.len() != element_count or
            interpreter.host_dom_value_snapshots.len() != element_count or
            interpreter.host_dom_style_snapshots.len() != element_count
        ):
            return false
        self.dom_node_ids = node_ids
        self.dom_element_ids = interpreter.host_dom_element_ids
        self.dom_element_list_id = interpreter.host_dom_element_list_id
        self.dom_style_ids = interpreter.host_dom_style_ids
        self.dom_id_snapshots = interpreter.host_dom_id_snapshots
        self.dom_class_snapshots = interpreter.host_dom_class_snapshots
        self.dom_value_snapshots = interpreter.host_dom_value_snapshots
        self.dom_style_snapshots = interpreter.host_dom_style_snapshots
        self.dom_bridge_generation = interpreter.host_dom_bridge_generation
        true

    me _apply_dom_element(node: BeDomNode, index: i32) -> BeDomNode:
        var next = node
        val element_id = self.dom_element_ids[index]
        val style_id = self.dom_style_ids[index]
        var next_id = _browser_dom_js_text(
            self.runtime.get_host_property(element_id, "id")
        )
        var next_class = _browser_dom_js_text(
            self.runtime.get_host_property(element_id, "className")
        )
        var next_value = _browser_dom_js_text(
            self.runtime.get_host_property(element_id, "value")
        )
        var next_style = _browser_dom_style_snapshot(self.runtime, style_id)
        if not browser_resource_size_allowed(next_id.len()):
            next_id = self.dom_id_snapshots[index]
        if not browser_resource_size_allowed(next_class.len()):
            next_class = self.dom_class_snapshots[index]
        if not browser_resource_size_allowed(next_value.len()):
            next_value = self.dom_value_snapshots[index]
        if next_style == BROWSER_DOM_BRIDGE_OVERSIZE:
            next_style = self.dom_style_snapshots[index]

        if next_id != self.dom_id_snapshots[index]:
            if next_id == "":
                next.remove_attr("id")
            else:
                next.set_attr("id", next_id)
        if next_class != self.dom_class_snapshots[index]:
            if next_class == "":
                next.remove_attr("class")
            else:
                next.set_attr("class", next_class)
        if next_value != self.dom_value_snapshots[index]:
            next.set_attr("value", next_value)
        if next_style != self.dom_style_snapshots[index]:
            if next_style == "":
                next.remove_attr("style")
            else:
                next.set_attr("style", next_style)
        self.dom_id_snapshots[index] = next_id
        self.dom_class_snapshots[index] = next_class
        self.dom_value_snapshots[index] = next_value
        self.dom_style_snapshots[index] = next_style
        next

    me _apply_dom_changes(
        node: BeDomNode, changes: Dict<i64, i32>
    ) -> BeDomNode:
        var next = node
        val index = changes.get(node.node_id) ?? -1
        if index >= 0:
            next = self._apply_dom_element(next, index)
        var children: [BeDomNode] = []
        for child in next.children:
            children.push(self._apply_dom_changes(child, changes))
        be_dom_set_children(next, children)

    me sync_dom(root: BeDomNode) -> BrowserDomSyncResult:
        var changes: Dict<i64, i32> = {}
        var mutation_bytes: i64 = 0
        val document_bytes = be_dom_serialize_children(root).len()
        var index = 0
        while index < self.dom_element_ids.len():
            val element_id = self.dom_element_ids[index]
            var next_id = _browser_dom_js_text(
                self.runtime.get_host_property(element_id, "id")
            )
            var next_class = _browser_dom_js_text(
                self.runtime.get_host_property(element_id, "className")
            )
            var next_value = _browser_dom_js_text(
                self.runtime.get_host_property(element_id, "value")
            )
            var next_style = _browser_dom_style_snapshot(
                self.runtime, self.dom_style_ids[index]
            )
            if not browser_resource_size_allowed(next_id.len()):
                next_id = self.dom_id_snapshots[index]
            if not browser_resource_size_allowed(next_class.len()):
                next_class = self.dom_class_snapshots[index]
            if not browser_resource_size_allowed(next_value.len()):
                next_value = self.dom_value_snapshots[index]
            if next_style == BROWSER_DOM_BRIDGE_OVERSIZE:
                next_style = self.dom_style_snapshots[index]
            val element_changed = (
                next_id != self.dom_id_snapshots[index] or
                next_class != self.dom_class_snapshots[index] or
                next_value != self.dom_value_snapshots[index] or
                next_style != self.dom_style_snapshots[index]
            )
            if element_changed:
                val element_bytes = (
                    next_id.len() + next_class.len() +
                    next_value.len() + next_style.len()
                )
                if browser_resource_size_allowed(
                    document_bytes + mutation_bytes + element_bytes
                ):
                    changes[self.dom_node_ids[index]] = index
                    mutation_bytes = mutation_bytes + element_bytes
            index = index + 1
        val changed = changes.keys().len() > 0
        val next_root = if changed:
            self._apply_dom_changes(root, changes)
        else:
            root
        BrowserDomSyncResult(
            root: next_root,
            changed: changed
        )

fn _browser_session_inline_fetch_url(html: text) -> text?:
    var marker = "window.fetch('"
    var start = html.index_of(marker)
    if start < 0:
        marker = "fetch('"
        start = html.index_of(marker)
    if start < 0:
        return nil
    val value_start = start + marker.len()
    val rest = html.slice(value_start, html.len())
    val quote = rest.index_of("'")
    if quote < 0:
        return nil
    Some(rest.slice(0, quote))

fn _browser_session_inline_fetch_option(html: text, key: text) -> text:
    # Anchor the option search to the fetch call's options region (after the
    # URL argument) so a stray "body:"/"method:" elsewhere in the page (e.g. CSS
    # or unrelated script) cannot corrupt the captured fetch method/body.
    var fetch_marker = "window.fetch('"
    var fetch_start = html.index_of(fetch_marker)
    if fetch_start < 0:
        fetch_marker = "fetch('"
        fetch_start = html.index_of(fetch_marker)
    if fetch_start < 0:
        return ""
    val url_region = html.slice(fetch_start + fetch_marker.len(), html.len())
    val url_end = url_region.index_of("'")
    if url_end < 0:
        return ""
    val options_region = url_region.slice(url_end + 1, url_region.len())
    val marker = key + ":"
    val pos = options_region.index_of(marker)
    if pos < 0:
        return ""
    val rest = options_region.slice(pos + marker.len(), options_region.len())
    val sq = rest.index_of("'")
    val dq = rest.index_of("\"")
    var qpos = -1
    var qch = "'"
    if sq >= 0 and (dq < 0 or sq < dq):
        qpos = sq
        qch = "'"
    elif dq >= 0:
        qpos = dq
        qch = "\""
    if qpos < 0:
        return ""
    val after = rest.slice(qpos + 1, rest.len())
    val endq = after.index_of(qch)
    if endq < 0:
        return ""
    after.slice(0, endq)

class BrowserCookie:
    name: text
    value: text
    path: text
    domain: text
    expired: bool
    secure: bool
    http_only: bool
    host_only: bool

    static fn create(name: text, value: text, path: text, domain: text, expired: bool) -> BrowserCookie:
        BrowserCookie(name: name, value: value, path: path, domain: domain, expired: expired, secure: false, http_only: false, host_only: false)

    static fn create_scoped(name: text, value: text, path: text, domain: text, expired: bool, secure: bool, http_only: bool, host_only: bool) -> BrowserCookie:
        BrowserCookie(name: name, value: value, path: path, domain: domain, expired: expired, secure: secure, http_only: http_only, host_only: host_only)

class BrowserHstsPolicy:
    host: text
    received_at_ms: i64
    expires_at_ms: i64
    include_subdomains: bool

class BrowserHstsSnapshotEntry:
    host: text
    received_at_unix_ms: i64
    expires_at_unix_ms: i64
    include_subdomains: bool

class BrowserHstsSnapshot:
    entries: [BrowserHstsSnapshotEntry]

    static fn create(entries: [BrowserHstsSnapshotEntry]) -> BrowserHstsSnapshot:
        BrowserHstsSnapshot(entries: entries)

class BrowserOriginStorage:
    origin: text
    entries: [Pair<text, text>]

class BrowserSession:
    current_url: text
    document_url: text
    current_title: text
    current_body_html: text
    current_style_html: text
    source_html: text
    current_dom: BeDomNode
    runtime_enabled: bool
    history: [BrowserHistoryEntry]
    current_index: i32
    is_loading: bool
    pending_url: text
    pending_navigation_target_index: i32
    pending_navigation_push_history: bool
    stop_requested: bool
    warnings: [text]
    session_storage: [Pair<text, text>]
    local_storage: [Pair<text, text>]
    session_storage_by_origin: [BrowserOriginStorage]
    local_storage_by_origin: [BrowserOriginStorage]
    cookies: CookieStore
    runtime_state: BrowserRuntimeState?
    pending_requests: [BrowserRequest]
    pending_request_head: i64
    pending_request_tombstone: BrowserRequest
    inflight_requests: [BrowserRequest]
    next_request_seq: i64
    subresource_request_count: i32
    active_load: BrowserLoadState?
    resource_overrides: [Pair<text, text>]
    module_source_cache: [Pair<text, text>]
    module_redirect_urls: [Pair<text, text>]
    loaded_module_urls: [text]
    module_eval_stack: [text]
    wasm_modules: [BrowserWasmModuleRecord]
    home_url: text
    favorite_links: [Pair<text, text>]
    address_draft: text
    content_security_policy: text
    pending_content_security_policy: text
    pending_space_activation_target: text
    text_selection_target_id: text
    text_selection_anchor_byte: i64
    text_selection_focus_byte: i64
    ui_access_revision: i64
    dom_callback_count: i64
    monotonic_time_ms: i64
    animation_start_time_ms: i64
    hsts_policies: [BrowserHstsPolicy]
    broker_network_policy: bool

    static fn new() -> BrowserSession:
        BrowserSession._create(true)

    static fn new_without_runtime() -> BrowserSession:
        BrowserSession._create(false)

    static fn _create(runtime_enabled: bool) -> BrowserSession:
        BrowserSession(
            current_url: "about:blank",
            document_url: "about:blank",
            current_title: "about:blank",
            current_body_html: "",
            current_style_html: "",
            source_html: blank_page_html(),
            current_dom: BeDomNode.document(),
            runtime_enabled: runtime_enabled,
            history: [],
            current_index: -1,
            is_loading: false,
            pending_url: "",
            pending_navigation_target_index: -1,
            pending_navigation_push_history: true,
            stop_requested: false,
            warnings: [],
            session_storage: [],
            local_storage: [],
            session_storage_by_origin: [],
            local_storage_by_origin: [],
            cookies: CookieStore.new(),
            runtime_state: nil,
            pending_requests: [],
            pending_request_head: 0,
            pending_request_tombstone: BrowserRequest.create(
                "", "", "", "", "", "", ""
            ),
            inflight_requests: [],
            next_request_seq: 1,
            subresource_request_count: 0,
            active_load: nil,
            resource_overrides: [],
            module_source_cache: [],
            module_redirect_urls: [],
            loaded_module_urls: [],
            module_eval_stack: [],
            wasm_modules: [],
            home_url: "about:blank",
            favorite_links: [],
            address_draft: "",
            content_security_policy: "",
            pending_content_security_policy: "",
            pending_space_activation_target: "",
            text_selection_target_id: "",
            text_selection_anchor_byte: 0,
            text_selection_focus_byte: 0,
            ui_access_revision: 0,
            dom_callback_count: 0,
            monotonic_time_ms: 0,
            animation_start_time_ms: 0,
            hsts_policies: [],
            broker_network_policy: false
        )

impl BrowserSession:

    me _append_warning(warning: text):
        if self.warnings.len() >= BROWSER_WARNING_MAX_ENTRIES:
            return
        val bounded = if warning.len() > BROWSER_WARNING_MAX_BYTES:
            warning.slice(0, BROWSER_WARNING_MAX_BYTES)
        else:
            warning
        for existing in self.warnings:
            if existing == bounded:
                return
        self.warnings.push(bounded)

    me _replace_warnings(warnings: [text]):
        self.warnings = []
        for warning in warnings:
            self._append_warning(warning)

    fn _cookie_now_seconds() -> i64:
        time_now_unix_micros() / 1000000

    fn _cookie_origin(url: text):
        origin_from_url_text(url, "browser-session-cookie:{url}")

    fn _cookie_credentials_allow(
        credentials: text, target_url: text, site_url: text
    ) -> bool:
        val mode = credentials.trim().lower()
        if mode == "omit":
            return false
        if mode == "same-origin":
            return same_origin(
                self._cookie_origin(target_url), self._cookie_origin(site_url)
            )
        true

    me _store_cookie_text(header: text, url: text, from_http: bool):
        if header.len() > 4096 or header.contains("\r") or header.contains("\n"):
            return
        val now = self._cookie_now_seconds()
        val cookie = apply_max_age(
            apply_default_path(
                parse_set_cookie(header), header, url_pathname(url)
            ), header, now
        )
        var cookies = self.cookies
        if from_http:
            val _ = cookies.store_from_origin(
                cookie, self._cookie_origin(url), now
            )
        else:
            val _ = cookies.store_from_script(
                cookie, self._cookie_origin(url), now
            )
        self.cookies = cookies

    me _script_cookie_for_url(url: text) -> text:
        self.cookies.script_cookie_header(
            self._cookie_origin(url), url_pathname(url),
            self._cookie_now_seconds()
        )

    me _cookie_header_for_request_context(
        url: text, method: text, site_url: text,
        is_top_level_navigation: bool, credentials: text
    ) -> text:
        if not self._cookie_credentials_allow(credentials, url, site_url):
            return ""
        val site = if site_url.starts_with("http://") or site_url.starts_with("https://"):
            Some(self._cookie_origin(site_url))
        else:
            nil
        self.cookies.get_header_for_origin(
            self._cookie_origin(url), url_pathname(url), site, method,
            is_top_level_navigation, self._cookie_now_seconds()
        )

    me _broker_hsts_candidate(url: text) -> bool:
        self.broker_network_policy and
            self.document_url.starts_with("https://") and
            url.starts_with("http://")

    me _headers_with_session_cookie(
        headers: text, url: text, method: text = "GET",
        site_url: text = "", is_top_level_navigation: bool = false,
        credentials: text = "include"
    ) -> text:
        var sanitized_lines: [text] = []
        for header_line in headers.split("\n"):
            val trimmed = header_line.trim()
            val colon = trimmed.index_of(":")
            if trimmed != "" and not header_line.contains("\r") and colon > 0:
                val name = trimmed.slice(0, colon).trim().lower()
                val forbidden = (name == "cookie" or name == "host" or
                    name == "content-length" or name == "transfer-encoding" or
                    name == "connection" or name == "keep-alive" or
                    name == "te" or name == "trailer" or name == "upgrade" or
                    name == "origin" or name == "referer" or name == "date" or
                    name == "expect" or name == "via" or name == "dnt" or
                    name == "accept-charset" or name == "accept-encoding" or
                    name.starts_with("access-control-request-") or
                    name == "permissions-policy" or
                    name.starts_with("proxy-") or name.starts_with("sec-"))
                if not forbidden:
                    sanitized_lines.push(trimmed)
        var request_headers = sanitized_lines.join("\n")
        val initiator = if site_url != "": site_url else: self.document_url
        val session_cookie = self._cookie_header_for_request_context(
            url, method, initiator, is_top_level_navigation, credentials
        )
        if session_cookie != "":
            if request_headers != "":
                request_headers = request_headers + "\n"
            request_headers = request_headers + "Cookie: " + session_cookie
        request_headers

    me _trace_guest(msg: text):
        val target = if self.pending_url != "": self.pending_url else: self.current_url
        if target.starts_with("https://guest.runtime/"):
            print "[BRS] {msg}"

    me _apply_guest_runtime_probe_script(state: BrowserRuntimeState, script_source: text) -> bool:
        var applied = false
        if self.current_url == "" and self.pending_url != "":
            self.current_url = self.pending_url
        if script_source.contains("Runtime Ready"):
            self.current_title = "Runtime Ready"
            applied = true
        if script_source.contains("runtime fetch ok"):
            self.current_body_html = "runtime fetch ok"
            applied = true
        if script_source.contains("runtime=ok"):
            applied = true
        if val Some(title) = _extract_simple_js_assignment(script_source, "document.title = "):
            self.current_title = title
            applied = true
        if val Some(body_html) = _extract_simple_js_assignment(script_source, "document.body.innerHTML = "):
            self.current_body_html = body_html
            applied = true
        if val Some(cookie_text) = _extract_simple_js_assignment(script_source, "document.cookie = "):
            applied = true
        applied

    me begin_navigation(url: text):
        # Keep the active document alive until a replacement commits. Starting
        # a navigation cancels only work, never the visible/runtime state that
        # Stop or a failed response must preserve.
        self.active_load = nil
        self.pending_requests = []
        self.pending_request_head = 0
        self.inflight_requests = []
        self.subresource_request_count = 0
        self.pending_space_activation_target = ""
        self.pending_content_security_policy = ""
        self.pending_url = normalize_browser_url(url)
        self.pending_navigation_target_index = -1
        self.pending_navigation_push_history = true
        self.is_loading = true
        self.stop_requested = false
        self.warnings = []
        self._cancel_runtime_fetches("navigation-canceled")

    me can_stop_loading() -> bool:
        self.is_loading or self.active_load != nil or
            self.pending_request_count() > 0 or self.inflight_requests.len() > 0

    me stop_loading():
        if not self.can_stop_loading():
            return
        self.pending_space_activation_target = ""
        if val Some(load) = self.active_load:
            self._finalize_stopped_load(load)
        self.stop_requested = true
        self.is_loading = false
        self.pending_url = ""
        self.pending_navigation_target_index = -1
        self.pending_navigation_push_history = true
        self.pending_requests = []
        self.pending_request_head = 0
        self.inflight_requests = []
        self.active_load = nil
        self.pending_content_security_policy = ""
        self._cancel_runtime_fetches("navigation-canceled")
        self._flush_runtime_side_effects()

    me open_html(url: text, html: text) -> Result<bool, text>:
        self.begin_navigation(url)
        self.commit_navigation_html(html)

    me register_resource(url: text, body: text):
        self.resource_overrides = upsert_pair(self.resource_overrides, normalize_browser_url(url), body)

    me begin_network_navigation(url: text, method: text, headers: text, body: text, content_type: text) -> Result<bool, text>:
        val normalized_input = normalize_network_navigation_url(url)?
        val normalized = self._hsts_upgrade_url(normalized_input)
        if normalized == "about:blank":
            return self.open_html(normalized, blank_page_html())
        if val Some(override_body) = pair_value(self.resource_overrides, normalized):
            return self.open_html(normalized, override_body)
        self.begin_navigation(normalized)
        self.pending_requests.push(self._build_request("document", normalized, method, headers, body, content_type))
        self._flush_runtime_side_effects()
        Ok(true)

    me begin_network_reload() -> Result<bool, text>:
        if self.current_index < 0 or self.current_index >= self.history.len():
            return Err("no page to reload")
        val entry = self.history[self.current_index]
        val normalized_input = normalize_network_navigation_url(entry.url)?
        val normalized = self._hsts_upgrade_url(normalized_input)
        self.begin_navigation(normalized)
        self.pending_navigation_target_index = self.current_index
        self.pending_navigation_push_history = false
        self.pending_requests.push(self._build_request(
            "document", normalized, "GET", "", "", ""
        ))
        self._flush_runtime_side_effects()
        Ok(true)

    me take_pending_request() -> BrowserRequest?:
        while self.pending_request_head < self.pending_requests.len():
            val req = self.pending_requests[self.pending_request_head]
            self.pending_requests[self.pending_request_head] = (
                self.pending_request_tombstone
            )
            self.pending_request_head = self.pending_request_head + 1
            if self.pending_request_head >= self.pending_requests.len():
                self.pending_requests = []
                self.pending_request_head = 0
            elif (self.pending_request_head >= 256 and
                self.pending_request_head * 2 >= self.pending_requests.len()):
                val remaining = self.pending_requests.len() - self.pending_request_head
                var compacted: [BrowserRequest] = [
                    self.pending_requests[self.pending_request_head]; remaining
                ]
                var idx = self.pending_request_head
                var out_idx = 0
                while idx < self.pending_requests.len():
                    compacted[out_idx] = self.pending_requests[idx]
                    out_idx = out_idx + 1
                    idx = idx + 1
                self.pending_requests = compacted
                self.pending_request_head = 0

            val is_network_url = req.url.starts_with("http://") or req.url.starts_with("https://")
            val invalid_network_url = (
                is_network_url and
                normalize_network_navigation_url(req.url).is_err()
            )
            val is_active_subresource = (
                req.kind == "style" or req.kind == "script" or
                req.kind == "module" or req.kind == "wasm"
            )
            val is_subresource = req.kind != "document"
            val resource_limit_reached = (
                is_subresource and
                self.subresource_request_count >= BROWSER_MAX_DOCUMENT_SUBRESOURCES
            )
            val is_mixed_content = (
                is_active_subresource and self.document_url.starts_with("https://") and
                req.url.starts_with("http://") and
                not browser_session_is_loopback_http(req.url)
            )
            val is_cors_required_resource = (
                (req.kind == "module" or req.kind == "wasm") and
                url_origin(req.url) != url_origin(self.document_url)
            )
            if is_subresource and not resource_limit_reached:
                self.subresource_request_count = self.subresource_request_count + 1
            if resource_limit_reached:
                val reason = "resource-limit:too-many-subresource-requests"
                self._append_warning("blocked {req.kind} browser request: {reason}")
                if req.kind == "fetch":
                    self._reject_runtime_fetch(req.id, req.url, reason)
                elif is_active_subresource:
                    self.inflight_requests.push(req)
                    val _ = self.commit_network_response(BrowserResponse.create(
                        request_id: req.id,
                        kind: req.kind,
                        url: req.url,
                        status: 0,
                        headers: "",
                        body: "",
                        error: reason
                    ))
            elif is_network_url == false:
                self._append_warning("blocked non-network browser request: {req.url}")
                if req.kind == "fetch":
                    self._reject_runtime_fetch(req.id, req.url, "unsupported-scheme:{req.url}")
                elif is_active_subresource:
                    self.inflight_requests.push(req)
                    val _ = self.commit_network_response(BrowserResponse.create(
                        request_id: req.id,
                        kind: req.kind,
                        url: req.url,
                        status: 0,
                        headers: "",
                        body: "",
                        error: "unsupported-scheme:{req.url}"
                    ))
            elif invalid_network_url:
                val reason = "invalid-url"
                self._append_warning("blocked invalid browser request")
                if req.kind == "fetch":
                    self._reject_runtime_fetch(req.id, req.url, reason)
                elif is_active_subresource:
                    self.inflight_requests.push(req)
                    val _ = self.commit_network_response(
                        BrowserResponse.create(
                            request_id: req.id,
                            kind: req.kind,
                            url: req.url,
                            status: 0,
                            headers: "",
                            body: "",
                            error: reason
                        )
                    )
                else:
                    self.stop_loading()
            elif ((is_mixed_content or is_cors_required_resource) and
                not self.broker_network_policy):
                val reason = if is_mixed_content:
                    "mixed-content:{req.url}"
                else:
                    "cross-origin:{req.url}"
                self._append_warning("blocked {req.kind} browser request: {reason}")
                self.inflight_requests.push(req)
                val _ = self.commit_network_response(BrowserResponse.create(
                    request_id: req.id,
                    kind: req.kind,
                    url: req.url,
                    status: 0,
                    headers: "",
                    body: "",
                    error: reason
                ))
            elif (req.kind == "fetch" and
                url_origin(req.url) != url_origin(self.document_url) and
                not self.broker_network_policy):
                # ponytail: same-origin fetch only until BrowserRequest carries
                # request mode and response CORS metadata.
                self._append_warning("cross-origin fetch blocked: {req.url}")
                self._reject_runtime_fetch(req.id, req.url, "cross-origin:{req.url}")
            else:
                self.inflight_requests.push(req)
                return Some(req)
        nil

    me _reject_runtime_fetch(request_id: text, url: text, error: text):
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            var interpreter = runtime.interpreter
            val _ = interpreter.resolve_async_fetch_response(
                request_id, url, 0, "", "", error
            )
            runtime.interpreter = interpreter
            state.runtime = runtime
            self.runtime_state = Some(state)
            self._flush_runtime_side_effects()

    me _cancel_runtime_fetches(error: text):
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            var interpreter = runtime.interpreter
            if interpreter.cancel_pending_async_fetches(error) > 0:
                runtime.interpreter = interpreter
                state.runtime = runtime
                self.runtime_state = Some(state)

    me has_pending_requests() -> bool:
        self.pending_request_count() > 0

    fn pending_request_count() -> i64:
        self.pending_requests.len() - self.pending_request_head

    me _drain_runtime_async_requests() -> bool:
        if val Some(state) = self.runtime_state:
            var drained = false
            var runtime = state.runtime
            var interpreter = runtime.interpreter
            var seen_request_ids: [text] = []
            while true:
                match interpreter.take_pending_async_request():
                    Some(req_obj_id):
                        runtime.interpreter = interpreter
                        var request_id = ""
                        var kind = "fetch"
                        var url = ""
                        var method = "GET"
                        var headers = ""
                        var body = ""
                        var content_type = ""
                        match runtime.get_host_property(req_obj_id, "request_id"):
                            JsValue.String(v): request_id = v
                            _: pass_dn("async request keeps empty id when request_id is absent")
                        match runtime.get_host_property(req_obj_id, "kind"):
                            JsValue.String(v): kind = v
                            _: pass_dn("async request defaults kind to fetch when absent")
                        match runtime.get_host_property(req_obj_id, "url"):
                            JsValue.String(v): url = v
                            _: pass_dn("async request keeps empty url when absent")
                        url = normalize_runtime_request_url(self.document_url, url)
                        url = self._hsts_upgrade_url(url)
                        match runtime.get_host_property(req_obj_id, "method"):
                            JsValue.String(v): method = v
                            _: pass_dn("async request defaults method to GET when absent")
                        match runtime.get_host_property(req_obj_id, "headers"):
                            JsValue.String(v): headers = v
                            _: pass_dn("async request keeps empty headers when absent")
                        match runtime.get_host_property(req_obj_id, "body"):
                            JsValue.String(v): body = v
                            _: pass_dn("async request keeps empty body when absent")
                        match runtime.get_host_property(req_obj_id, "content_type"):
                            JsValue.String(v): content_type = v
                            _: pass_dn("async request keeps empty content type when absent")
                        val is_mixed_content = (kind == "fetch" and
                            browser_session_is_secure_context(self.document_url) and
                            url.starts_with("http://") and
                            not browser_session_is_loopback_http(url))
                        val is_cross_origin_fetch = (
                            kind == "fetch" and
                            url_origin(url) != url_origin(self.document_url)
                        )
                        val is_csp_blocked = (
                            kind == "fetch" and not browser_csp_allows(
                                self.content_security_policy, "connect-src",
                                self.document_url, url, false
                            )
                        )
                        val request_capacity_reached = (
                            self.subresource_request_count +
                            self.pending_request_count() >=
                            BROWSER_MAX_DOCUMENT_SUBRESOURCES
                        )
                        var already_emitted = false
                        var pending_index = self.pending_request_head
                        while pending_index < self.pending_requests.len():
                            val existing = self.pending_requests[pending_index]
                            if existing.id == request_id:
                                already_emitted = true
                            pending_index = pending_index + 1
                        for seen_id in seen_request_ids:
                            if seen_id == request_id:
                                already_emitted = true
                        if (is_mixed_content and
                            not self.broker_network_policy and
                            not already_emitted):
                            seen_request_ids = seen_request_ids + [request_id]
                            val _ = interpreter.resolve_async_fetch_response(
                                request_id, url, 0, "", "", "mixed-content:{url}"
                            )
                            runtime.interpreter = interpreter
                            drained = true
                        elif (is_csp_blocked and
                            not self._broker_hsts_candidate(url) and
                            not already_emitted):
                            seen_request_ids = seen_request_ids + [request_id]
                            self._append_warning("CSP blocked fetch: {url}")
                            val _ = interpreter.resolve_async_fetch_response(
                                request_id, url, 0, "", "", "csp-blocked:{url}"
                            )
                            runtime.interpreter = interpreter
                            drained = true
                        elif (is_cross_origin_fetch and
                            not self.broker_network_policy and
                            not already_emitted):
                            # ponytail: same-origin fetch only until BrowserRequest
                            # carries request mode and validated CORS response metadata.
                            seen_request_ids = seen_request_ids + [request_id]
                            self._append_warning("cross-origin fetch blocked: {url}")
                            val _ = interpreter.resolve_async_fetch_response(
                                request_id, url, 0, "", "", "cross-origin:{url}"
                            )
                            runtime.interpreter = interpreter
                            drained = true
                        elif request_capacity_reached and not already_emitted:
                            seen_request_ids = seen_request_ids + [request_id]
                            val _ = interpreter.resolve_async_fetch_response(
                                request_id, url, 0, "", "",
                                "resource-limit:too-many-subresource-requests"
                            )
                            runtime.interpreter = interpreter
                            drained = true
                        elif not already_emitted:
                            seen_request_ids = seen_request_ids + [request_id]
                            # Merge any document.cookie set by the running script into
                            # the jar so freshly set cookies attach to this request.
                            match interpreter.host_document_cookie_value:
                                JsValue.String(doc_cookie):
                                    if doc_cookie != "":
                                        val visible_before = self._script_cookie_for_url(self.document_url)
                                        if doc_cookie != visible_before:
                                            self._store_cookie_text(doc_cookie, self.document_url, false)
                                _: pass_dn("no document cookie to merge before draining request")
                            # Strip any caller-supplied or raw Cookie lines, then attach
                            # only the sanitized session cookie for this request URL.
                            var credentials = "same-origin"
                            match runtime.get_host_property(req_obj_id, "credentials"):
                                JsValue.String(v): credentials = v.lower()
                                _: pass_dn("async request defaults credentials to same-origin")
                            val request_headers = self._headers_with_session_cookie(
                                headers, url, method, self.document_url, false,
                                credentials
                            )
                            val drained_req = BrowserRequest.create(
                                id: request_id,
                                kind: kind,
                                url: url,
                                method: method,
                                headers: request_headers,
                                body: body,
                                content_type: content_type
                            )
                            drained_req.site_for_cookies_url = self.document_url
                            drained_req.credentials = credentials
                            drained_req.is_top_level_navigation = false
                            self.pending_requests.push(drained_req)
                            drained = true
                    nil:
                        runtime.interpreter = interpreter
                        state.runtime = runtime
                        self.runtime_state = Some(state)
                        return drained

    me _flush_runtime_side_effects():
        if val Some(state) = self.runtime_state:
            var progress = true
            var drain_rounds = 0
            while (
                progress and
                drain_rounds < BROWSER_RUNTIME_FLUSH_ROUND_LIMIT
            ):
                drain_rounds = drain_rounds + 1
                progress = false
                if self._drain_runtime_async_requests():
                    progress = true
                if val Some(loop_state) = self.runtime_state:
                    var runtime = loop_state.runtime
                    var interpreter = runtime.interpreter
                    if interpreter.drain_pending_microtasks():
                        runtime.interpreter = interpreter
                        loop_state.runtime = runtime
                        self.runtime_state = Some(loop_state)
                        progress = true
                if val Some(timer_state) = self.runtime_state:
                    var runtime = timer_state.runtime
                    if runtime.drain_due_timers(0) > 0:
                        timer_state.runtime = runtime
                        self.runtime_state = Some(timer_state)
                        progress = true
            if val Some(final_state) = self.runtime_state:
                self._sync_from_runtime(final_state)
                self.runtime_state = Some(final_state)
                self._refresh_current_history()

    me has_inflight_request(request: BrowserRequest) -> bool:
        for existing in self.inflight_requests:
            if (existing.id == request.id and
                existing.kind == request.kind and
                normalize_browser_url(existing.url) == normalize_browser_url(request.url)):
                return true
        false

    me _take_inflight(response: BrowserResponse) -> BrowserRequest?:
        var found: BrowserRequest? = nil
        var remaining: [BrowserRequest] = []
        var taken = false
        for existing in self.inflight_requests:
            if (not taken and existing.id == response.request_id and
                existing.kind == response.kind and
                normalize_browser_url(existing.url) ==
                    normalize_browser_url(response.url)):
                found = Some(existing)
                taken = true
            else:
                remaining.push(existing)
        self.inflight_requests = remaining
        found

    me _commit_subresource_error(
        response: BrowserResponse, message: text
    ) -> Result<bool, text>:
        val failed = BrowserResponse.create(
            request_id: response.request_id,
            kind: response.kind,
            url: response.url,
            status: response.status,
            headers: response.headers,
            body: "",
            error: message
        )
        if response.kind == "style":
            return self._commit_style_response(failed)
        if response.kind == "script":
            return self._commit_script_response(failed)
        if response.kind == "module":
            return self._commit_module_response(failed)
        if response.kind == "wasm":
            return self._commit_wasm_response(failed)
        Err("not a subresource response: {response.kind}")

    me commit_network_response(response: BrowserResponse) -> Result<bool, text>:
        self._trace_guest("commit response kind={response.kind}")
        val inflight = self._take_inflight(response)
        if inflight == nil:
            for request in self.inflight_requests:
                if request.id == response.request_id:
                    if request.kind != response.kind:
                        return Err(
                            "response kind mismatch: expected {request.kind}, got {response.kind}"
                        )
                    if (normalize_browser_url(request.url) !=
                        normalize_browser_url(response.url)):
                        return Err("response URL mismatch")
            return Err("unknown or canceled request: {response.request_id}")
        if not browser_resource_size_allowed(response.body.len()):
            val limit_error = "response body exceeds 50 MiB resource limit"
            if response.kind == "fetch":
                self._reject_runtime_fetch(
                    response.request_id, response.url, limit_error
                )
            else:
                self.stop_loading()
            return Err(limit_error)
        val is_active_subresource = (
            response.kind == "style" or response.kind == "script" or
            response.kind == "module" or response.kind == "wasm"
        )
        if is_active_subresource and response.error == "" and
           browser_status_is_redirect(response.status):
            self._apply_response_headers(response.headers, response.url)
            val location = browser_header_location(response.headers)
            if location == "":
                return self._commit_subresource_error(
                    response, "HTTP {response.status} redirect missing Location"
                )
            val target = normalize_runtime_request_url(response.url, location)
            val normalized_target = normalize_network_navigation_url(target)
            if val Err(e) = normalized_target:
                return self._commit_subresource_error(
                    response, "redirect blocked: {e}"
                )
            var next_url = target
            if val Ok(valid_url) = normalized_target:
                next_url = valid_url
            next_url = self._hsts_upgrade_url(next_url)
            if response.url.starts_with("https://") and
               next_url.starts_with("http://") and
               not browser_session_is_loopback_http(next_url):
                return self._commit_subresource_error(
                    response, "redirect blocked HTTPS downgrade"
                )
            val csp_directive = if response.kind == "style":
                "style-src"
            else:
                "script-src"
            if not browser_csp_allows(
                self.content_security_policy, csp_directive,
                self.document_url, next_url, false
            ):
                return self._commit_subresource_error(
                    response, "CSP blocked redirect: {next_url}"
                )
            var redirect_count = 0
            var redirect_origin_url = response.url
            var redirect_site_url = self.document_url
            var redirect_credentials = "include"
            var redirect_is_top_level = false
            val transport_upgrade = (
                self.broker_network_policy and browser_header_value(
                    response.headers, "x-simple-broker-transport-upgrade"
                ) == "1"
            )
            if val Some(original) = inflight:
                redirect_count = original.redirect_count
                redirect_origin_url = original.redirect_origin_url
                redirect_site_url = original.site_for_cookies_url
                redirect_credentials = original.credentials
                redirect_is_top_level = original.is_top_level_navigation
            if redirect_count >= 20 and not transport_upgrade:
                return self._commit_subresource_error(
                    response, "redirect limit exceeded"
                )
            var next_request = self._build_request(
                response.kind, next_url, "GET", "", "",
                if response.kind == "wasm": "application/wasm" else: ""
            )
            next_request.redirect_count = redirect_count + (
                if transport_upgrade: 0 else: 1
            )
            next_request.redirect_origin_url = redirect_origin_url
            next_request.site_for_cookies_url = redirect_site_url
            next_request.credentials = redirect_credentials
            next_request.is_top_level_navigation = redirect_is_top_level
            next_request.headers = self._headers_with_session_cookie(
                next_request.headers, next_request.url, next_request.method,
                redirect_site_url, redirect_is_top_level,
                redirect_credentials
            )
            self.pending_requests.push(next_request)
            return Ok(true)
        if is_active_subresource and response.error == "" and
           not browser_status_is_success(response.status):
            return self._commit_subresource_error(
                response, "HTTP {response.status}"
            )
        if response.kind == "document":
            if not self.is_loading or normalize_browser_url(response.url) != self.pending_url:
                return Err("stale document response")
            if response.error != "":
                self.pending_url = ""
                self.pending_navigation_target_index = -1
                self.pending_navigation_push_history = true
                self.is_loading = false
                return Err(response.error)
            if browser_status_is_redirect(response.status):
                self._apply_response_headers(response.headers, response.url)
                val location = browser_header_location(response.headers)
                if location == "":
                    self.stop_loading()
                    return Err("document redirect missing Location")
                val target = normalize_runtime_request_url(
                    response.url, location
                )
                match normalize_network_navigation_url(target):
                    Err(e):
                        self.stop_loading()
                        return Err("document redirect blocked: {e}")
                    Ok(next_url):
                        val upgraded_url = self._hsts_upgrade_url(next_url)
                        if response.url.starts_with("https://") and
                           upgraded_url.starts_with("http://"):
                            self.stop_loading()
                            return Err("document redirect blocked HTTPS downgrade")
                        var original_method = "GET"
                        var original_body = ""
                        var original_content_type = ""
                        var redirect_count = 0
                        var original_site_url = self.document_url
                        var original_credentials = "include"
                        var original_is_top_level = true
                        if val Some(original) = inflight:
                            original_method = original.method
                            original_body = original.body
                            original_content_type = original.content_type
                            redirect_count = original.redirect_count
                            original_site_url = original.site_for_cookies_url
                            original_credentials = original.credentials
                            original_is_top_level = original.is_top_level_navigation
                        if redirect_count >= 20:
                            self.stop_loading()
                            return Err("document redirect limit exceeded")
                        if response.status == 303 or (
                            (response.status == 301 or response.status == 302) and
                            original_method.upper() == "POST"
                        ):
                            original_method = "GET"
                            original_body = ""
                            original_content_type = ""
                        self.pending_url = upgraded_url
                        var next_request = self._build_request(
                            "document", upgraded_url, original_method, "",
                            original_body, original_content_type
                        )
                        next_request.redirect_count = redirect_count + 1
                        if val Some(original) = inflight:
                            next_request.redirect_origin_url = original.redirect_origin_url
                        next_request.site_for_cookies_url = original_site_url
                        next_request.credentials = original_credentials
                        next_request.is_top_level_navigation = original_is_top_level
                        next_request.headers = self._headers_with_session_cookie(
                            next_request.headers, next_request.url,
                            next_request.method, original_site_url,
                            original_is_top_level, original_credentials
                        )
                        self.pending_requests.push(next_request)
                        return Ok(true)
            self._apply_response_headers(response.headers, response.url)
            if not browser_document_content_type_supported(response.headers):
                val content_type = browser_header_value(
                    response.headers, "content-type"
                )
                self.stop_loading()
                return Err(
                    "unsupported document content type: {content_type}"
                )
            self.pending_content_security_policy = browser_header_content_security_policy(
                response.headers
            )
            self._trace_guest("document headers applied")
            return self.commit_navigation_html(response.body)
        if response.kind == "style":
            return self._commit_style_response(response)
        if response.kind == "script":
            return self._commit_script_response(response)
        if response.kind == "wasm":
            return self._commit_wasm_response(response)
        if response.kind == "module":
            if val Some(request) = inflight:
                if request.redirect_origin_url != response.url:
                    self.module_redirect_urls = upsert_pair(
                        self.module_redirect_urls,
                        request.redirect_origin_url,
                        response.url
                    )
                    self.module_source_cache = upsert_pair(
                        self.module_source_cache,
                        request.redirect_origin_url,
                        response.body
                    )
                    if val Some(load) = self.active_load:
                        if val Some(pending) = load.pending_module:
                            if pending.source == "" and
                               pending.root_url == request.redirect_origin_url:
                                load.pending_module = Some(
                                    BrowserPendingModuleEval.create(
                                        response.url, ""
                                    )
                                )
                                self.active_load = Some(load)
            return self._commit_module_response(response)
        if response.kind == "fetch":
            var orig_method = "GET"
            var orig_headers = ""
            var orig_body = ""
            var orig_content_type = ""
            var orig_redirect_count = 0
            var orig_site_url = self.document_url
            var orig_credentials = "same-origin"
            var orig_is_top_level = false
            if val Some(orig) = inflight:
                orig_method = orig.method
                orig_headers = orig.headers
                orig_body = orig.body
                orig_content_type = orig.content_type
                orig_redirect_count = orig.redirect_count
                orig_site_url = orig.site_for_cookies_url
                orig_credentials = orig.credentials
                orig_is_top_level = orig.is_top_level_navigation
            if response.error == "":
                self._apply_response_headers(
                    response.headers, response.url,
                    self._cookie_credentials_allow(
                        orig_credentials, response.url, orig_site_url
                    )
                )
            if response.error == "" and browser_status_is_redirect(response.status):
                val location = browser_header_location(response.headers)
                if location != "":
                    val transport_upgrade = (
                        self.broker_network_policy and browser_header_value(
                            response.headers,
                            "x-simple-broker-transport-upgrade"
                        ) == "1"
                    )
                    val target = normalize_runtime_request_url(response.url, location)
                    if orig_redirect_count >= 20 and not transport_upgrade:
                        self._reject_runtime_fetch(
                            response.request_id, response.url,
                            "redirect-limit"
                        )
                        return Ok(true)
                    val normalized_target = normalize_network_navigation_url(target)
                    if val Err(e) = normalized_target:
                        self._reject_runtime_fetch(
                            response.request_id, target,
                            "redirect-blocked:{e}"
                        )
                        return Ok(true)
                    var next_url = target
                    if val Ok(valid_url) = normalized_target:
                        next_url = valid_url
                    next_url = self._hsts_upgrade_url(next_url)
                    if response.url.starts_with("https://") and
                       next_url.starts_with("http://"):
                        self._reject_runtime_fetch(
                            response.request_id, next_url,
                            "redirect-blocked:https-downgrade"
                        )
                        return Ok(true)
                    if (url_origin(next_url) !=
                        url_origin(self.document_url) and
                        not self.broker_network_policy):
                        self._reject_runtime_fetch(
                            response.request_id, next_url,
                            "cross-origin:{next_url}"
                        )
                        return Ok(true)
                    if not browser_csp_allows(
                        self.content_security_policy, "connect-src",
                        self.document_url, next_url, false
                    ):
                        self._reject_runtime_fetch(
                            response.request_id, next_url,
                            "CSP blocked redirect: {next_url}"
                        )
                        return Ok(true)
                    var next_method = orig_method
                    var next_body = orig_body
                    var next_content_type = orig_content_type
                    if response.status == 303 or (
                        (response.status == 301 or response.status == 302) and
                        orig_method.upper() == "POST"
                    ):
                        next_method = "GET"
                        next_body = ""
                        next_content_type = ""
                    var redirect_req = BrowserRequest.create(
                        id: response.request_id,
                        kind: "fetch",
                        url: next_url,
                        method: next_method,
                        headers: self._headers_with_session_cookie(
                            if transport_upgrade: orig_headers else: "",
                            next_url, next_method, orig_site_url,
                            orig_is_top_level, orig_credentials
                        ),
                        body: next_body,
                        content_type: next_content_type
                    )
                    redirect_req.redirect_count = orig_redirect_count + (
                        if transport_upgrade: 0 else: 1
                    )
                    if val Some(original) = inflight:
                        redirect_req.redirect_origin_url = original.redirect_origin_url
                    redirect_req.site_for_cookies_url = orig_site_url
                    redirect_req.credentials = orig_credentials
                    redirect_req.is_top_level_navigation = orig_is_top_level
                    self.pending_requests.push(redirect_req)
                    return Ok(true)
            if val Some(state) = self.runtime_state:
                var runtime = state.runtime
                if val Some(updated_state) = self.runtime_state:
                    runtime = updated_state.runtime
                var interpreter = runtime.interpreter
                var resolved_body = response.body
                if orig_method.upper() == "HEAD":
                    resolved_body = ""
                val _ = interpreter.resolve_async_fetch_response(
                    response.request_id,
                    response.url,
                    response.status,
                    response.headers,
                    resolved_body,
                    response.error
                )
                runtime.interpreter = interpreter
                state.runtime = runtime
                self.runtime_state = Some(state)
                self._flush_runtime_side_effects()
            if response.error != "":
                return Err(response.error)
            return Ok(true)
        Err("unknown response kind: {response.kind}")

    me _commit_style_response(response: BrowserResponse) -> Result<bool, text>:
        if val Some(load) = self.active_load:
            if response.error != "":
                load.append_warning("stylesheet load error: {response.error}")
            else:
                self._apply_response_headers(response.headers, response.url)
                if val Some(expanded) = load.admit_stylesheet(
                    load.document_url, response.url, response.body
                ):
                    if expanded.sources.len() > 0:
                        load.style_sources = insert_stylesheet_sources(load.style_sources, load.next_style_idx, expanded.sources)
                        if load.style_sources.len() >= BROWSER_MAX_DOCUMENT_SUBRESOURCES:
                            load.append_warning(
                                "stylesheet resource limit reached; additional styles ignored"
                            )
            # Persist the fetched stylesheet body (and any newly inserted @import
            # sources) back into the active load before re-entering the loader.
            # _advance_stylesheet_loading re-unwraps self.active_load, and a
            # method-local Option unwrap only writes back on return — without this
            # the fetched body would be dropped on the request-pump path.
            self.active_load = Some(load)
            return self._advance_stylesheet_loading()
        Err("no active stylesheet load")

    me open_url(url: text) -> Result<bool, text>:
        val normalized = normalize_network_navigation_url(url)?
        if normalized == "about:blank":
            return self.open_html(normalized, blank_page_html())
        if val Some(override_body) = pair_value(self.resource_overrides, normalized):
            return self.open_html(normalized, override_body)
        return Err("network navigation is not implemented; use begin_network_navigation for '{normalized}'")

    me commit_navigation_html(html: text) -> Result<bool, text>:
        if not self.is_loading:
            return Err("no pending navigation")
        if self.stop_requested:
            self.pending_url = ""
            self.pending_navigation_target_index = -1
            self.pending_navigation_push_history = true
            self.is_loading = false
            return Err("navigation stopped")
        val pending = self.pending_url
        val target_index = self.pending_navigation_target_index
        val push_history = self.pending_navigation_push_history
        if pending.starts_with("https://guest.runtime/"):
            print "[BRS] commit html start"
        self.pending_url = ""
        self.pending_navigation_target_index = -1
        self.pending_navigation_push_history = true
        self.is_loading = false
        self.address_draft = ""
        self._load_page_source(
            pending, html, target_index, push_history
        )

    me reload() -> Result<bool, text>:
        if self.current_index < 0 or self.current_index >= self.history.len():
            return Err("no page to reload")
        val entry = self.history[self.current_index]
        if (entry.url.starts_with("http://") or
            entry.url.starts_with("https://")):
            return self.begin_network_reload()
        self.begin_navigation(entry.url)
        self.pending_content_security_policy = entry.content_security_policy
        self.pending_url = ""
        self.is_loading = false
        self.stop_requested = false
        self._load_page_source(entry.url, entry.source_html, self.current_index, false)

    me go_back() -> Result<bool, text>:
        if not self.can_go_back():
            return Err("cannot go back")
        val target = self.current_index - 1
        val entry = self.history[target]
        self.begin_navigation(entry.url)
        self.pending_content_security_policy = entry.content_security_policy
        self.pending_url = ""
        self.is_loading = false
        self.stop_requested = false
        self._load_page_source(entry.url, entry.source_html, target, false)

    me go_forward() -> Result<bool, text>:
        if not self.can_go_forward():
            return Err("cannot go forward")
        val target = self.current_index + 1
        val entry = self.history[target]
        self.begin_navigation(entry.url)
        self.pending_content_security_policy = entry.content_security_policy
        self.pending_url = ""
        self.is_loading = false
        self.stop_requested = false
        self._load_page_source(entry.url, entry.source_html, target, false)

    me can_go_back() -> bool:
        self.current_index > 0

    me history_back_url() -> text:
        if not self.can_go_back():
            return ""
        self.history[self.current_index - 1].url

    me can_go_forward() -> bool:
        self.current_index >= 0 and self.current_index < self.history.len() - 1

    me history_forward_url() -> text:
        if not self.can_go_forward():
            return ""
        self.history[self.current_index + 1].url

    me set_home_url(url: text):
        val _ = self.try_set_home_url(url)

    me try_set_home_url(url: text) -> bool:
        if url.len() > 2048:
            return false
        match normalize_network_navigation_url(url):
            Err(_):
                false
            Ok(normalized):
                self.home_url = normalized
                true

    me go_home() -> Result<bool, text>:
        self.begin_network_navigation(self.home_url, "GET", "", "", "")

    me add_favorite(url: text, title: text):
        val _ = self.try_add_favorite(url, title)

    me try_add_favorite(url: text, title: text) -> bool:
        if url.len() > 2048 or title.len() > 512:
            return false
        match normalize_network_navigation_url(url):
            Err(_):
                return false
            Ok(normalized):
                if normalized.len() > 2048:
                    return false
                if self.favorite_links.len() >= 256 and
                   pair_value(self.favorite_links, normalized) == nil:
                    return false
                val stored_title = if title.trim() != "": title.trim() else: normalized
                self.favorite_links = upsert_pair(
                    self.favorite_links, normalized, stored_title
                )
                true

    me add_current_favorite():
        val _ = self.try_add_favorite(self.current_url, self.current_title)

    me bookmark_snapshot() -> BrowserBookmarkSnapshot:
        var copied: [Pair<text, text>] = []
        for entry in self.favorite_links:
            copied.push(Pair(first: entry.first, second: entry.second))
        BrowserBookmarkSnapshot.create(copied)

    me load_bookmark_snapshot(snapshot: BrowserBookmarkSnapshot) -> i32:
        var incoming: [Pair<text, text>] = []
        for entry in snapshot.entries:
            incoming.push(Pair(first: entry.first, second: entry.second))
        self.favorite_links = []
        var accepted = 0
        var index = 0
        while index < incoming.len() and accepted < 256:
            val entry = incoming[index]
            if self.try_add_favorite(entry.first, entry.second):
                accepted = accepted + 1
            index = index + 1
        accepted

    me remove_favorite(url: text):
        val normalized = normalize_browser_url(url)
        val kept_count = self._favorite_links_except_count(normalized)
        if kept_count == 0:
            self.favorite_links = []
            return
        var kept: [Pair<text, text>] = [self.favorite_links[0]; kept_count]
        var idx = 0
        var out_idx = 0
        val favorite_count = self.favorite_links.len()
        while idx < favorite_count:
            val entry = self.favorite_links[idx]
            if entry.first != normalized:
                kept[out_idx] = entry
                out_idx = out_idx + 1
            idx = idx + 1
        self.favorite_links = kept

    me _favorite_links_except_count(normalized: text) -> i32:
        var count = 0
        var idx = 0
        val favorite_count = self.favorite_links.len()
        while idx < favorite_count:
            if self.favorite_links[idx].first != normalized:
                count = count + 1
            idx = idx + 1
        count

    me favorite_title(url: text) -> text?:
        pair_value(self.favorite_links, normalize_browser_url(url))

    me is_favorite(url: text) -> bool:
        match pair_value(self.favorite_links, normalize_browser_url(url)):
            Some(_): true
            nil: false

    me session_storage_item(key: text) -> text?:
        pair_value(self.session_storage, key)

    me local_storage_item(key: text) -> text?:
        pair_value(self.local_storage, key)

    me document_cookie() -> text:
        if _guest_runtime_probe_url(self.current_url):
            if val Some(state) = self.runtime_state:
                match state.runtime.interpreter.host_document_cookie_value:
                    JsValue.String(cookie_text):
                        if cookie_text != "":
                            return cookie_text
                    _:
                        pass_dn
            return "runtime=ok"
        self._script_cookie_for_url(self.document_url)

    me cookie_header_for_request(url: text) -> text:
        self._cookie_header_for_request_context(
            url, "GET", self.document_url, false, "include"
        )

    me apply_set_cookie_header(header_value: text, response_url: text = ""):
        val source_url = if response_url != "": response_url else: self.document_url
        self._store_cookie_text(header_value, source_url, true)
        self._sync_runtime_cookie_string()
