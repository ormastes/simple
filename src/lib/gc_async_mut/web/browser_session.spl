val BROWSER_HISTORY_MAX_ENTRIES: i32 = 64
val BROWSER_WARNING_MAX_ENTRIES: i64 = 128
val BROWSER_WARNING_MAX_BYTES: i64 = 4096
val BROWSER_PENDING_SCRIPT_COOKIE_WRITE_MAX_ENTRIES: i64 = 32
