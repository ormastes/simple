    initiator_origin: text
    site_for_cookies_url: text
    credentials: text
    is_top_level_navigation: bool
    script_cookie_writes: [text]
    image_resource_key: text
    csp_policy: text
    csp_document_url: text

    static fn create(id: text, kind: text, url: text, method: text, headers: text, body: text, content_type: text) -> BrowserRequest:
        BrowserRequest(
            id: id,
            kind: kind,
            url: url,
            method: method,
            headers: headers,
            body: body,
            content_type: content_type,
            redirect_count: 0,
            redirect_origin_url: url,
            initiator_origin: "",
            site_for_cookies_url: "",
            credentials: "include",
            is_top_level_navigation: kind == "document",
            script_cookie_writes: [],
            image_resource_key: "",
            csp_policy: "",
            csp_document_url: ""
        )

class BrowserResponse:
    request_id: text
    kind: text
    url: text
    status: i32
    headers: text
    body: text
    error: text

    static fn create(request_id: text, kind: text, url: text, status: i32, headers: text, body: text, error: text) -> BrowserResponse:
        BrowserResponse(
            request_id: request_id,
            kind: kind,
            url: url,
            status: status,
            headers: headers,
            body: body,
            error: error
        )

fn browser_status_is_redirect(status: i32) -> bool:
    status == 301 or status == 302 or status == 303 or status == 307 or status == 308

fn browser_redirect_rewrites_to_get(status: i32, method: text) -> bool:
    val normalized = method.upper()
    (
        (status == 303 and normalized != "GET" and normalized != "HEAD") or
        ((status == 301 or status == 302) and normalized == "POST")
    )

fn browser_status_is_success(status: i32) -> bool:
    status >= 200 and status < 300

fn browser_header_location(headers: text) -> text:
    browser_header_value(headers, "location")

fn browser_header_value(headers: text, expected_name: text) -> text:
    val expected = expected_name.lower()
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if (colon > 0 and
            line.slice(0, colon).trim().lower() == expected):
            return line.slice(colon + 1, line.len()).trim()
    ""

pub fn browser_header_has_attachment_disposition(headers: text) -> bool:
    """Whether any Content-Disposition field selects attachment handling."""
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if (colon > 0 and
            line.slice(0, colon).trim().lower() == "content-disposition"):
            val value = line.slice(colon + 1, line.len())
            if value.split(";")[0].trim().lower() == "attachment":
                return true
    false

fn browser_header_media_type(headers: text) -> text:
    val value = browser_header_value(headers, "content-type").lower()
    value.split(";")[0].trim()

fn browser_header_is_javascript(headers: text) -> bool:
    val media_type = browser_header_media_type(headers)
    media_type == "text/javascript" or
        media_type == "application/javascript"

fn browser_header_has_nosniff(headers: text) -> bool:
    browser_header_value(
        headers, "x-content-type-options"
    ).lower().trim() == "nosniff"

pub fn browser_header_content_security_policy(headers: text) -> text:
    var policies = ""
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if (
            colon > 0 and
            line.substring(0, colon).trim().lower() == "content-security-policy"
        ):
            if policies != "":
                policies = policies + "\n"
            policies = policies + line.substring(colon + 1).trim()
    policies

