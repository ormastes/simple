class BrowserHistoryEntry:
    url: text
    title: text
    source_html: text
    content_security_policy: text

    static fn create(url: text, title: text, source_html: text) -> BrowserHistoryEntry:
        BrowserHistoryEntry.create_with_policy(url, title, source_html, "")

    static fn create_with_policy(url: text, title: text, source_html: text, policy: text) -> BrowserHistoryEntry:
        BrowserHistoryEntry(
            url: url,
            title: title,
            source_html: source_html,
            content_security_policy: policy
        )

class BrowserBookmarkSnapshot:
    entries: [Pair<text, text>]

    static fn create(entries: [Pair<text, text>]) -> BrowserBookmarkSnapshot:
        BrowserBookmarkSnapshot(entries: entries)

class BrowserRequest:
    id: text
    kind: text
    url: text
    method: text
    headers: text
    body: text
    content_type: text
    redirect_count: i32
    redirect_origin_url: text

    static fn create(id: text, kind: text, url: text, method: text, headers: text, body: text, content_type: text) -> BrowserRequest:
        BrowserRequest(
            id: id,
            kind: kind,
            url: url,
            method: method,
            headers: headers,
            body: body,
            content_type: content_type,
            redirect_count: 0,
            redirect_origin_url: url
        )

class BrowserResponse:
    request_id: text
    kind: text
    url: text
    status: i32
    headers: text
    body: text
    error: text

    static fn create(request_id: text, kind: text, url: text, status: i32, headers: text, body: text, error: text) -> BrowserResponse:
        BrowserResponse(
            request_id: request_id,
            kind: kind,
            url: url,
            status: status,
            headers: headers,
            body: body,
            error: error
        )

fn browser_status_is_redirect(status: i32) -> bool:
    status == 301 or status == 302 or status == 303 or status == 307 or status == 308

fn browser_status_is_success(status: i32) -> bool:
    status >= 200 and status < 300

fn browser_header_location(headers: text) -> text:
    var found = ""
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val parts = line.split(":")
        if parts.len() >= 2 and found == "":
            val key = parts[0].trim().lower()
            if key == "location":
                var value = parts[1]
                var i = 2
                while i < parts.len():
                    value = value + ":" + parts[i]
                    i = i + 1
                found = value.trim()
    found

fn browser_header_content_security_policy(headers: text) -> text:
    var policies = ""
    for raw_line in headers.split("\n"):
        val line = raw_line.trim()
        val colon = line.index_of(":")
        if colon > 0 and
           line.substring(0, colon).trim().lower() == "content-security-policy":
            if policies != "":
                policies = policies + "\n"
            policies = policies + line.substring(colon + 1).trim()
    policies

class BrowserPendingModuleEval:
    root_url: text
    source: text

    static fn create(root_url: text, source: text) -> BrowserPendingModuleEval:
        BrowserPendingModuleEval(root_url: root_url, source: source)

