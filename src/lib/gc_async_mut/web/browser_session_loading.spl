use std.gc_async_mut.web.browser_session_storage.{pair_value, upsert_pair}
use std.gc_async_mut.web.browser_session_url.{
    network_navigation_hostname_valid, normalize_network_navigation_url,
    resolve_relative_url, url_hostname
}
use common.web.public_suffix.{is_public_suffix}
use common.web.host_policy.{is_ip_host_literal}
use std.gc_async_mut.web.browser_session_html.{
    insert_stylesheet_sources, _guest_runtime_probe_url,
    html_to_text, escape_html_text
}
