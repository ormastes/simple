# Browser session — HTML/text utilities and stylesheet handling.
#
# Free functions for:
# - extract_title_text / extract_body_inner_html / own_text / html_to_text
# - escape_html_text / escape_js_string
# - strip_script_blocks / strip_tag_block
# - _guest_runtime_probe_url / _extract_simple_js_assignment
# - BrowserStylesheetExpansion class
# - extract_stylesheet_sources / extract_attr_value / has_tag_attr / rel_contains_stylesheet
# - expand_stylesheet_text / extract_css_import_sources / strip_css_imports
# - extract_css_import_href / trim_css_import_url / insert_stylesheet_sources

use common.web.html_escape.{html_escape_core}
use common.string_builder.{StringBuilder}
use std.gc_async_mut.web.browser_session.{
    BrowserStylesheetSource, BrowserStylesheetExpansion, BrowserScriptBlock,
    BrowserImageSource, BROWSER_MAX_IMAGE_RESOURCES
}
use std.gc_async_mut.web.browser_session_url.{find_text, resolve_relative_url, collapse_url_dot_segments}
use std.gc_async_mut.web.browser_session_context.{
    browser_meta_content_security_policy
}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{
    BROWSER_MAX_DOCUMENT_SUBRESOURCES
}
use std.common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_MAX_IMAGE_URI_BYTES
}

use std.common.string_core.{text_to_bytes}

fn _find_ascii_case_insensitive(
    haystack: text, lowercase_needle: text, start: i64
) -> i64:
    if start < 0 or start > haystack.len() or lowercase_needle.len() == 0:
        return -1
    val haystack_bytes = text_to_bytes(haystack)
    val needle_bytes = text_to_bytes(lowercase_needle)
    var index = start
    val last = haystack_bytes.len() - needle_bytes.len()
    while index <= last:
        var offset = 0
        while offset < needle_bytes.len():
            val candidate = haystack_bytes[index + offset] as i64
            val expected = needle_bytes[offset] as i64
            if (
                candidate != expected and
                not (
                    candidate >= 65 and candidate <= 90 and
                    candidate + 32 == expected
                )
            ):
                break
            offset = offset + 1
        if offset == needle_bytes.len():
            return index
        index = index + 1
    -1

fn extract_title_text(html: text) -> text:
    val start = _find_ascii_case_insensitive(html, "<title>", 0)
    if start < 0:
        return ""
    val content_start = start + 7
    val end = _find_ascii_case_insensitive(html, "</title>", content_start)
    if end < 0:
        return ""
    html[content_start:end].trim()

fn extract_body_inner_html(html: text) -> text:
    val body_open = _find_ascii_case_insensitive(html, "<body", 0)
    if body_open < 0:
        return ""
    val open_end = find_text(html, ">", body_open)
    if open_end < 0:
        return ""
    val body_close = _find_ascii_case_insensitive(
        html, "</body>", open_end + 1
    )
    if body_close < 0:
        return html[open_end + 1:html.len()]
    html[open_end + 1:body_close]

fn own_text(value: text) -> text:
    # Force a fresh owned text value instead of retaining a borrowed slice.
    "{value}"

fn html_to_text(html: text) -> text:
    var out = ""
    var in_tag = false
    var tag_buf = ""
    var hidden_text_tag = ""
    var closed_details = false
    var details_in_summary = false
    var ruby_text_tag = ""
    var ruby_annotation_text = ""
    var edit_text_tag = ""
    var edit_text_value = ""
    var table_row_cell_count = 0
    var pos = 0
    val html_len = html.len()
    while pos < html_len:
        val ch = html.slice(pos, pos + 1)
        if ch == "<":
            in_tag = true
            tag_buf = ""
        else if ch == ">":
            val tag_name = html_tag_name(tag_buf)
            val closing = html_tag_is_closing(tag_buf)
            if hidden_text_tag != "":
                if closing and tag_name == hidden_text_tag:
                    hidden_text_tag = ""
            else if closed_details:
                if not closing and tag_name == "summary":
                    details_in_summary = true
                else if closing and tag_name == "summary":
                    details_in_summary = false
                else if closing and tag_name == "details":
                    closed_details = false
                    details_in_summary = false
            else if ruby_text_tag != "":
                if closing and tag_name == "rt":
                    val annotation = ruby_annotation_text.trim()
                    if annotation != "":
                        out = out + "(" + annotation + ")"
                    ruby_annotation_text = ""
                    ruby_text_tag = ""
                else if closing and tag_name == ruby_text_tag:
                    ruby_text_tag = ""
            else if edit_text_tag != "":
                if closing and tag_name == edit_text_tag:
                    val edit_text = edit_text_value.trim()
                    if edit_text != "":
                        if edit_text_tag == "ins":
                            out = out + "[+" + edit_text + "]"
                        else:
                            out = out + "[-" + edit_text + "]"
                    edit_text_tag = ""
                    edit_text_value = ""
            else if not closing and tag_name == "rt":
                ruby_text_tag = "rt"
                ruby_annotation_text = ""
            else if not closing and tag_name == "rp":
                ruby_text_tag = "rp"
            else if not closing and (tag_name == "ins" or tag_name == "del"):
                edit_text_tag = tag_name
                edit_text_value = ""
            else if not closing and tag_name == "details":
                if not has_tag_attr(tag_buf, "open"):
                    closed_details = true
                    details_in_summary = false
            else if not closing and tag_name == "dialog":
                if not has_tag_attr(tag_buf, "open"):
                    hidden_text_tag = "dialog"
            else if not closing and html_tag_hides_text(tag_name):
                hidden_text_tag = tag_name
            else if not closing and html_tag_breaks_before(tag_name):
                if out != "" and not out.ends_with("\n"):
                    out = out + "\n"
            else if closing and html_tag_breaks_after(tag_name):
                if out != "" and not out.ends_with("\n"):
                    out = out + "\n"
            else if not closing and tag_name == "tr":
                if out != "" and not out.ends_with("\n"):
                    out = out + "\n"
                table_row_cell_count = 0
            else if not closing and (tag_name == "td" or tag_name == "th"):
                if table_row_cell_count > 0:
                    out = out + "\t"
                table_row_cell_count = table_row_cell_count + 1
            else if not closing and tag_name == "li":
                if out != "" and not out.ends_with("\n"):
                    out = out + "\n"
            else if not closing and tag_name == "dt":
                if out != "" and not out.ends_with("\n"):
                    out = out + "\n"
            else if not closing and tag_name == "dd":
                if out != "" and not out.ends_with(": ") and not out.ends_with("\n"):
                    out = out + ": "
            else if tag_name == "br":
                out = out + "\n"
            else if not closing and tag_name == "hr":
                if out != "" and not out.ends_with("\n"):
                    out = out + "\n"
            else if not closing and (tag_name == "img" or tag_name == "area"):
                val alt_text = extract_attr_value(tag_buf, "alt")
                if alt_text != "":
                    out = out + alt_text
            else if not closing and tag_name == "input":
                val value_text = extract_attr_value(tag_buf, "value")
                if value_text != "":
                    out = out + value_text
            else if not closing and (tag_name == "progress" or tag_name == "meter"):
                val value_text = extract_attr_value(tag_buf, "value")
                val max_text = extract_attr_value(tag_buf, "max")
                if value_text != "" and max_text != "":
                    out = out + value_text + "/" + max_text
                else if value_text != "":
                    out = out + value_text
            in_tag = false
            tag_buf = ""
        else if in_tag:
            tag_buf = tag_buf + ch
        else if hidden_text_tag != "":
            pass
        else if closed_details and not details_in_summary:
            pass
        else if ruby_text_tag == "rt":
            ruby_annotation_text = ruby_annotation_text + ch
        else if edit_text_tag != "":
            edit_text_value = edit_text_value + ch
        else if ruby_text_tag == "":
            out = out + ch
        pos = pos + 1
    out.trim()

fn html_tag_name(tag_text: text) -> text:
    var trimmed = tag_text.trim().lower()
    if trimmed.starts_with("/"):
        trimmed = trimmed.slice(1, trimmed.len()).trim()
    var out = ""
    var pos = 0
    val trimmed_len = trimmed.len()
    while pos < trimmed_len:
        val ch = trimmed.slice(pos, pos + 1)
        if ch == " " or ch == "/" or ch == "\n" or ch == "\t":
            return out
        out = out + ch
        pos = pos + 1
    out

fn html_tag_is_closing(tag_text: text) -> bool:
    tag_text.trim().starts_with("/")

fn html_tag_hides_text(tag_name: text) -> bool:
    tag_name == "head" or tag_name == "title" or tag_name == "style" or tag_name == "script" or tag_name == "template"

fn html_tag_breaks_before(tag_name: text) -> bool:
    html_section_text_block_tag(tag_name)

fn html_tag_breaks_after(tag_name: text) -> bool:
    html_section_text_block_tag(tag_name)

fn html_section_text_block_tag(tag_name: text) -> bool:
    tag_name == "h1" or tag_name == "h2" or tag_name == "h3" or tag_name == "h4" or tag_name == "h5" or tag_name == "h6" or tag_name == "hgroup" or tag_name == "address"

fn escape_html_text(text_value: text) -> text:
    html_escape_core(text_value)

fn escape_js_string(value: text) -> text:
    var out = ""
    var i = 0
    val value_len = value.len()
    while i < value_len:
        val ch = value.slice(i, i + 1)
        if ch == "\\":
            out = out + "\\\\"
        else if ch == "\"":
            out = out + "\\\""
        else:
            out = out + ch
        i = i + 1
    out

fn strip_script_blocks(html: text) -> text:
    strip_tag_block(html, "script")

fn strip_template_blocks(html: text) -> text:
    strip_tag_block(html, "template")

fn strip_noscript_blocks(html: text) -> text:
    strip_tag_block(html, "noscript")

fn strip_tag_block(html: text, tag_name: text) -> text:
    var result = ""
    var pos = 0
    val open_tag = "<{tag_name}"
    val close_tag = "</{tag_name}>"
    val html_len = html.len()
    while pos < html_len:
        val start = find_text(html, open_tag, pos)
        if start < 0:
            result = "{result}{html[pos:html.len()]}"
            return result
        result = "{result}{html[pos:start]}"
        val open_end = find_text(html, ">", start)
        if open_end < 0:
            return result
        val end = find_text(html, close_tag, open_end + 1)
        if end < 0:
            return result
        pos = end + close_tag.len()
    result

fn _guest_runtime_probe_url(url: text) -> bool:
    url.starts_with("https://guest.runtime/")

fn _extract_simple_js_assignment(script: text, prefix: text) -> Option<text>:
    if not script.contains(prefix):
        return nil
    # index_of returns a plain i64 (-1 == not found), not an Option.
    val start_idx = script.index_of(prefix)
    if start_idx >= 0:
        val value_start = start_idx + prefix.len()
        if value_start >= script.len():
            return nil
        val quote = script[value_start:value_start + 1]
        if quote != "'" and quote != "\"":
            return nil
        val rest = script.substring(value_start + 1, script.len())
        val rel_end = rest.index_of(quote)
        if rel_end >= 0:
            return Some(rest.substring(0, rel_end))
    nil

fn extract_attr_value(tag_content: text, attr_name: text) -> text:
    val lower = tag_content.lower()
    val needle = attr_name.lower() + "="
    val idx = find_text(lower, needle, 0)
    if idx < 0:
        return ""
    val start = idx + needle.len()
    if start >= tag_content.len():
        return ""
    val quote = tag_content.slice(start, start + 1)
    if quote == "\"" or quote == "'":
        val end = find_text(tag_content, quote, start + 1)
        if end < 0:
            return ""
        return tag_content.slice(start + 1, end)
    var end = start
    val tag_len = tag_content.len()
    while end < tag_len:
        val ch = tag_content.slice(end, end + 1)
        if ch == " " or ch == ">" or ch == "\n" or ch == "\t":
            return tag_content.slice(start, end)
        end = end + 1
    tag_content.slice(start, tag_content.len())

fn has_tag_attr(tag_content: text, attr_name: text) -> bool:
    val lower = tag_content.lower()
    val padded = " " + attr_name.lower()
    lower.contains(padded + " ") or
        lower.contains(padded + ">") or
        lower.contains(padded + "=") or
        lower.ends_with(padded)

val BROWSER_MAX_META_CSP_POLICIES: i32 = 64
val BROWSER_MAX_META_CSP_BYTES: i64 = 4096

class BrowserDocumentResourcePlan:
    script_blocks: [BrowserScriptBlock]
    style_sources: [BrowserStylesheetSource]
    image_sources: [BrowserImageSource]
    warnings: [text]
    final_csp_policy: text

fn _browser_html_tag_end(html: text, start: i64) -> i64:
    var quote = ""
    var pos = start
    while pos < html.len():
        val ch = html.slice(pos, pos + 1)
        if quote != "":
            if ch == quote:
                quote = ""
        elif ch == "\"" or ch == "'":
            quote = ch
        elif ch == ">":
            return pos
        pos = pos + 1
    -1

fn _browser_policy_append(existing: text, addition: text) -> text:
    if addition == "":
        return existing
    if existing == "":
        return addition
    existing + "\n" + addition

fn _browser_plan_append_image(
    images: [BrowserImageSource], authored: text, document_url: text,
    source_offset: i64, csp_policy: text
) -> [BrowserImageSource]:
    var out = images
    if (
        authored == "" or
        authored.len() > SIMPLEOS_HOST_GPU_MAX_IMAGE_URI_BYTES or
        out.len() >= BROWSER_MAX_IMAGE_RESOURCES
    ):
        return out
    val resolved = collapse_url_dot_segments(
        resolve_relative_url(document_url, authored)
    )
    if resolved.len() > SIMPLEOS_HOST_GPU_MAX_IMAGE_URI_BYTES:
        return out
    out.push(
        BrowserImageSource.create(
            authored, resolved
        ).with_policy(source_offset, csp_policy)
    )
    out

fn browser_document_resource_plan(
    html: text, document_url: text, header_policy: text
) -> BrowserDocumentResourcePlan:
    var scripts: [BrowserScriptBlock] = []
    var styles: [BrowserStylesheetSource] = []
    var images: [BrowserImageSource] = []
    var warnings: [text] = []
    var policy = header_policy
    var meta_policy_count = 0
    var meta_fail_closed = false
    var head_active = true
    var template_depth = 0
    var template_depth_overflow = false
    val lower = html.lower()
    var pos = 0
    val html_len = html.len()
    while pos < html_len:
        val start = find_text(lower, "<", pos)
        if start < 0:
            break
        val prefix_end = if start + 4 < html_len:
            start + 4
        else:
            html_len
        if lower.slice(start, prefix_end) == "<!--":
            val comment_end = find_text(lower, "-->", start + 4)
            if comment_end < 0:
                break
            pos = comment_end + 3
            continue
        val tag_end = _browser_html_tag_end(html, start + 1)
        if tag_end < 0:
            break
        val tag_content = html.slice(start, tag_end + 1)
        val tag_name = html_tag_name(
            html.slice(start + 1, tag_end)
        )
        val closing = html_tag_is_closing(
            html.slice(start + 1, tag_end)
        )
        if closing:
            val was_in_template = (
                template_depth > 0 or template_depth_overflow
            )
            if tag_name == "template" and template_depth > 0:
                template_depth = template_depth - 1
            if was_in_template:
                pos = tag_end + 1
                continue
            if tag_name == "head":
                head_active = false
            pos = tag_end + 1
            continue
        if tag_name == "template":
            if template_depth < 512:
                template_depth = template_depth + 1
            else:
                # Fail closed: an over-depth inert subtree cannot reactivate.
                template_depth_overflow = true
            pos = tag_end + 1
            continue
        if template_depth > 0 or template_depth_overflow:
            # Raw-text bodies may contain tag-shaped strings. Skip to their
            # exact closing token while the containing template is inert.
            if tag_name == "style" or tag_name == "script":
                val raw_close = find_text(
                    lower, "</{tag_name}>", tag_end + 1
                )
                if raw_close < 0:
                    break
                pos = raw_close + tag_name.len() + 3
            else:
                pos = tag_end + 1
            continue
        if tag_name == "body":
            head_active = false
        if (
            tag_name == "meta" and head_active and
            extract_attr_value(tag_content, "http-equiv").trim().lower() ==
                "content-security-policy"
        ):
            val raw_policy = extract_attr_value(tag_content, "content")
            if raw_policy.len() > BROWSER_MAX_META_CSP_BYTES:
                if not meta_fail_closed:
                    policy = _browser_policy_append(
                        policy, "default-src 'none'"
                    )
                    warnings.push(
                        "meta CSP exceeds 4096-byte limit; following resources blocked"
                    )
                    meta_fail_closed = true
            elif meta_policy_count >= BROWSER_MAX_META_CSP_POLICIES:
                if not meta_fail_closed:
                    policy = _browser_policy_append(
                        policy, "default-src 'none'"
                    )
                    warnings.push(
                        "meta CSP policy limit reached; following resources blocked"
                    )
                    meta_fail_closed = true
            else:
                val admitted = browser_meta_content_security_policy(raw_policy)
                policy = _browser_policy_append(policy, admitted)
                meta_policy_count = meta_policy_count + 1
            pos = tag_end + 1
            continue
        if tag_name == "style":
            val close = find_text(lower, "</style>", tag_end + 1)
            if close < 0:
                break
            val content = html[tag_end + 1:close].trim()
            if (
                content != "" and
                styles.len() < BROWSER_MAX_DOCUMENT_SUBRESOURCES
            ):
                styles.push(
                    BrowserStylesheetSource.inline(content).with_policy(
                        start, policy
                    )
                )
            pos = close + 8
            continue
        if tag_name == "script":
            val close = find_text(lower, "</script>", tag_end + 1)
            if close < 0:
                break
            if scripts.len() < BROWSER_MAX_DOCUMENT_SUBRESOURCES:
                val src_value = extract_attr_value(tag_content, "src")
                val script_type = extract_attr_value(
                    tag_content, "type"
                ).lower()
                val is_async = has_tag_attr(tag_content, "async")
                val is_defer = has_tag_attr(tag_content, "defer")
                if src_value != "":
                    scripts.push(BrowserScriptBlock.with_attrs(
                        "external", "", src_value, script_type,
                        is_async, is_defer
                    ).with_policy(start, policy))
                else:
                    val content = html[tag_end + 1:close]
                    if content.trim() != "":
                        scripts.push(BrowserScriptBlock.with_attrs(
                            "inline", content, "", script_type,
                            is_async, is_defer
                        ).with_policy(start, policy))
            pos = close + 9
            continue
        if tag_name == "link":
            val rel_value = extract_attr_value(tag_content, "rel").lower()
            val href_value = extract_attr_value(tag_content, "href")
            if (
                href_value != "" and rel_contains_stylesheet(rel_value) and
                styles.len() < BROWSER_MAX_DOCUMENT_SUBRESOURCES
            ):
                styles.push(
                    BrowserStylesheetSource.external(href_value).with_policy(
                        start, policy
                    )
                )
        if tag_name == "img" or tag_name == "video":
            val image_attr = if tag_name == "video": "poster" else: "src"
            val authored = extract_attr_value(
                tag_content, image_attr
            ).trim()
            if authored.len() > SIMPLEOS_HOST_GPU_MAX_IMAGE_URI_BYTES:
                warnings.push(
                    "image URI limit reached; image ignored"
                )
            elif authored != "" and images.len() >= BROWSER_MAX_IMAGE_RESOURCES:
                warnings.push(
                    "image resource limit reached; additional images ignored"
                )
            images = _browser_plan_append_image(
                images, authored, document_url, start, policy
            )
        val inline_style = extract_attr_value(tag_content, "style")
        if inline_style != "":
            for authored in _css_background_image_urls(inline_style):
                if images.len() >= BROWSER_MAX_IMAGE_RESOURCES:
                    warnings.push(
                        "image resource limit reached; additional images ignored"
                    )
                    break
                images = _browser_plan_append_image(
                    images, authored, document_url, start, policy
                )
        pos = tag_end + 1
    BrowserDocumentResourcePlan(
        script_blocks: scripts,
        style_sources: styles,
        image_sources: images,
        warnings: warnings,
        final_csp_policy: policy
    )

pub fn browser_document_csp_policy(
    html: text, document_url: text, header_policy: text
) -> text:
    browser_document_resource_plan(
        html, document_url, header_policy
    ).final_csp_policy

fn extract_stylesheet_sources(html: text) -> [BrowserStylesheetSource]:
    browser_document_resource_plan(html, "", "").style_sources

fn rel_contains_stylesheet(rel_value: text) -> bool:
    for part in rel_value.split(" "):
        if part.trim() == "stylesheet":
            return true
    false

class BrowserCssBackgroundUrlSpan:
    authored: text
    token_start: i64
    token_end: i64

fn _css_background_url_safe(url: text) -> bool:
    if (
        url.contains("\"") or url.contains("'") or url.contains("\\") or
        url.contains("<") or url.contains(">") or
        url.contains("{") or url.contains("}")
    ):
        return false
    for byte in text_to_bytes(url):
        if byte < 32u8 or byte == 127u8:
            return false
    true

fn _css_background_url_spans_in_value(
    value: text, value_start: i64
) -> [BrowserCssBackgroundUrlSpan]:
    val lower = value.lower()
    if (
        lower.contains("gradient(") or lower.contains("image-set(") or
        lower.contains("cross-fade(") or lower.contains("var(")
    ):
        return []
    var pos = 0
    var found_spans: [BrowserCssBackgroundUrlSpan] = []
    var top_level_commas = 0
    while pos < value.len():
        if (
            pos + 1 < value.len() and
            value.slice(pos, pos + 2) == "/*"
        ):
            val close = find_text(value, "*/", pos + 2)
            if close < 0:
                return []
            pos = close + 2
            continue
        val ch = value.slice(pos, pos + 1)
        if ch == ",":
            top_level_commas = top_level_commas + 1
            pos = pos + 1
            continue
        if ch == "\"" or ch == "'":
            val quote = ch
            pos = pos + 1
            var closed_quote = false
            while pos < value.len() and not closed_quote:
                val quoted_ch = value.slice(pos, pos + 1)
                if quoted_ch == "\\" and pos + 1 < value.len():
                    pos = pos + 2
                else:
                    pos = pos + 1
                    closed_quote = quoted_ch == quote
            if not closed_quote:
                return []
            continue
        if pos + 4 <= value.len() and lower.slice(pos, pos + 4) == "url(":
            val token_start = pos
            pos = pos + 4
            while pos < value.len() and (
                value.slice(pos, pos + 1) == " " or
                value.slice(pos, pos + 1) == "\n" or
                value.slice(pos, pos + 1) == "\r" or
                value.slice(pos, pos + 1) == "\t"
            ):
                pos = pos + 1
            var authored_start = pos
            var authored_end = pos
            var valid = false
            if pos < value.len() and (
                value.slice(pos, pos + 1) == "\"" or
                value.slice(pos, pos + 1) == "'"
            ):
                val quote = value.slice(pos, pos + 1)
                pos = pos + 1
                authored_start = pos
                var closed_quote = false
                while pos < value.len() and not closed_quote:
                    val quoted_ch = value.slice(pos, pos + 1)
                    if quoted_ch == "\\" and pos + 1 < value.len():
                        pos = pos + 2
                    else:
                        if quoted_ch == quote:
                            authored_end = pos
                            closed_quote = true
                        pos = pos + 1
                while pos < value.len() and (
                    value.slice(pos, pos + 1) == " " or
                    value.slice(pos, pos + 1) == "\n" or
                    value.slice(pos, pos + 1) == "\r" or
                    value.slice(pos, pos + 1) == "\t"
                ):
                    pos = pos + 1
                valid = closed_quote and pos < value.len() and (
                    value.slice(pos, pos + 1) == ")"
                )
            else:
                while pos < value.len() and (
                    value.slice(pos, pos + 1) != ")"
                ):
                    pos = pos + 1
                authored_end = pos
                valid = pos < value.len()
            if not valid:
                return []
            val authored = value.slice(authored_start, authored_end).trim()
            val authored_lower = authored.lower()
            if (authored == "" or authored_lower.starts_with("data:") or
                authored_lower.starts_with("blob:") or
                not _css_background_url_safe(authored)):
                return []
            found_spans.push(BrowserCssBackgroundUrlSpan(
                authored: authored,
                token_start: value_start + token_start,
                token_end: value_start + pos + 1
            ))
            if found_spans.len() > 2:
                return []
            pos = pos + 1
            continue
        pos = pos + 1
    if found_spans.len() == 0 or (
        found_spans.len() == 1 and top_level_commas != 0
    ) or (found_spans.len() == 2 and top_level_commas != 1):
        return []
    # The browser's declared two-image profile shares the exact existing URL
    # admission path. More layers stay invisible here, so they cannot be
    # partially fetched or claimed by the renderer.
    found_spans

fn _css_append_background_url_span(
    css_text: text, declaration_start: i64, colon: i64,
    declaration_end: i64, spans: [BrowserCssBackgroundUrlSpan]
) -> [BrowserCssBackgroundUrlSpan]:
    var out = spans
    if colon < declaration_start or colon >= declaration_end:
        return out
    val property = css_text.slice(
        declaration_start, colon
    ).trim().lower()
    if property != "background" and property != "background-image":
        return out
    val candidates = _css_background_url_spans_in_value(
        css_text.slice(colon + 1, declaration_end), colon + 1
    )
    # The shorthand remains on its existing single-image admission path.
    # Two-layer shorthand parsing is deliberately not part of this slice.
    if property == "background" and candidates.len() != 1:
        return out
    for span in candidates:
        out.push(span)
    out

fn _css_background_image_url_spans(
    css_text: text
) -> [BrowserCssBackgroundUrlSpan]:
    var spans: [BrowserCssBackgroundUrlSpan] = []
    val has_blocks = css_text.contains("{")
    var brace_depth = 0
    var paren_depth = 0
    var declaration_start = 0
    var colon = -1
    var pos = 0
    while pos < css_text.len():
        if (
            pos + 1 < css_text.len() and
            css_text.slice(pos, pos + 2) == "/*"
        ):
            val close = find_text(css_text, "*/", pos + 2)
            if close < 0:
                return spans
            if (
                colon < 0 and
                css_text.slice(declaration_start, pos).trim() == ""
            ):
                declaration_start = close + 2
            pos = close + 2
            continue
        val ch = css_text.slice(pos, pos + 1)
        if ch == "\"" or ch == "'":
            val quote = ch
            pos = pos + 1
            var closed_quote = false
            while pos < css_text.len() and not closed_quote:
                val quoted_ch = css_text.slice(pos, pos + 1)
                if quoted_ch == "\\" and pos + 1 < css_text.len():
                    pos = pos + 2
                else:
                    pos = pos + 1
                    if quoted_ch == quote:
                        closed_quote = true
            if not closed_quote:
                return spans
            continue
        val declarations_active = not has_blocks or brace_depth > 0
        if ch == "(" and declarations_active:
            paren_depth = paren_depth + 1
        elif ch == ")" and declarations_active and paren_depth > 0:
            paren_depth = paren_depth - 1
        elif ch == "{" and paren_depth == 0:
            brace_depth = brace_depth + 1
            declaration_start = pos + 1
            colon = -1
        elif ch == "}" and paren_depth == 0:
            if declarations_active:
                spans = _css_append_background_url_span(
                    css_text, declaration_start, colon, pos, spans
                )
            if brace_depth > 0:
                brace_depth = brace_depth - 1
            declaration_start = pos + 1
            colon = -1
        elif declarations_active and paren_depth == 0 and ch == ";":
            spans = _css_append_background_url_span(
                css_text, declaration_start, colon, pos, spans
            )
            declaration_start = pos + 1
            colon = -1
        elif (
            declarations_active and paren_depth == 0 and
            ch == ":" and colon < 0
        ):
            colon = pos
        pos = pos + 1
    if not has_blocks:
        spans = _css_append_background_url_span(
            css_text, declaration_start, colon, css_text.len(), spans
        )
    spans

fn _css_background_image_urls(css_text: text) -> [text]:
    var urls: [text] = []
    for span in _css_background_image_url_spans(css_text):
        urls.push(span.authored)
    urls

fn _css_network_url(url: text) -> bool:
    url.starts_with("http://") or url.starts_with("https://")

fn _rewrite_css_background_image_urls(
    css_text: text, base_url: text
) -> text:
    val spans = _css_background_image_url_spans(css_text)
    if spans.len() == 0:
        return css_text
    val out = StringBuilder.new()
    var copy_start = 0
    for span in spans:
        out.push(css_text.slice(copy_start, span.token_start))
        val resolved = collapse_url_dot_segments(
            resolve_relative_url(base_url, span.authored)
        )
        if (
            _css_network_url(resolved) and
            _css_background_url_safe(resolved)
        ):
            out.push("url(\"{resolved}\")")
        else:
            out.push(css_text.slice(span.token_start, span.token_end))
        copy_start = span.token_end
    if copy_start < css_text.len():
        out.push(css_text.slice(copy_start, css_text.len()))
    out.build()

fn bind_render_background_url(
    css_text: text, document_url: text, resolved_url: text,
    render_resource_key: text
) -> text:
    val spans = _css_background_image_url_spans(css_text)
    for span in spans:
        val resolved = collapse_url_dot_segments(
            resolve_relative_url(document_url, span.authored)
        )
        if resolved == resolved_url:
            return (
                css_text.slice(0, span.token_start) +
                "url(\"{render_resource_key}\")" +
                css_text.slice(span.token_end, css_text.len())
            )
    css_text

class BrowserRenderImageUrlSpan:
    authored: text
    token_start: i64
    token_end: i64

fn _browser_render_css_image_spans(
    css_text: text, css_start: i64,
    spans: [BrowserRenderImageUrlSpan]
) -> [BrowserRenderImageUrlSpan]:
    var out = spans
    for span in _css_background_image_url_spans(css_text):
        out.push(BrowserRenderImageUrlSpan(
            authored: span.authored,
            token_start: css_start + span.token_start,
            token_end: css_start + span.token_end
        ))
    out

fn _browser_render_image_url_spans(
    html: text
) -> [BrowserRenderImageUrlSpan]:
    var spans: [BrowserRenderImageUrlSpan] = []
    val lower = html.lower()
    var pos = 0
    while pos < html.len():
        val start = find_text(lower, "<", pos)
        if start < 0:
            break
        val tag_end = _browser_html_tag_end(html, start + 1)
        if tag_end < 0:
            break
        val tag_name = html_tag_name(html.slice(start + 1, tag_end))
        if tag_name == "style":
            val close = find_text(lower, "</style>", tag_end + 1)
            if close < 0:
                break
            spans = _browser_render_css_image_spans(
                html.slice(tag_end + 1, close), tag_end + 1, spans
            )
            pos = close + 8
            continue
        pos = tag_end + 1
    spans

fn bind_render_stylesheet_image_urls(
    html: text, document_url: text, bindings: [BrowserImageSource]
) -> text:
    if bindings.len() == 0:
        return html
    val spans = _browser_render_image_url_spans(html)
    if spans.len() == 0:
        return html
    val out = StringBuilder.new()
    var copy_start = 0
    var binding_start = 0
    for span in spans:
        val resolved = collapse_url_dot_segments(
            resolve_relative_url(document_url, span.authored)
        )
        var binding_index = binding_start
        var matched = -1
        while binding_index < bindings.len() and matched < 0:
            if (
                bindings[binding_index].render_node_id < 0 and
                bindings[binding_index].resolved_url == resolved
            ):
                matched = binding_index
            binding_index = binding_index + 1
        if matched < 0:
            continue
        val admitted_key = bindings[matched].render_resource_key
        val render_key = if admitted_key != "":
            admitted_key
        else:
            "simple-blocked-image:" + matched.to_text()
        out.push(html.slice(copy_start, span.token_start))
        out.push("url(\"{render_key}\")")
        copy_start = span.token_end
        binding_start = matched + 1
    if copy_start == 0:
        return html
    if copy_start < html.len():
        out.push(html.slice(copy_start, html.len()))
    out.build()

fn expand_stylesheet_text(document_url: text, base_url: text, css_text: text) -> BrowserStylesheetExpansion:
    val imports = extract_css_import_sources(base_url, css_text)
    val cleaned = strip_css_imports(css_text).trim()
    val html = if cleaned != "": "<style>{cleaned}</style>" else: ""
    BrowserStylesheetExpansion.create(html, imports)

fn extract_css_import_sources(base_url: text, css_text: text) -> [BrowserStylesheetSource]:
    val source_count = css_import_source_count(css_text)
    if source_count == 0:
        return []
    var sources: [BrowserStylesheetSource] = [BrowserStylesheetSource.external(""); source_count]
    var write_idx = 0
    var pos = 0
    val css_len = css_text.len()
    while pos < css_len and write_idx < source_count:
        val at = find_text(css_text, "@import", pos)
        if at < 0:
            return sources
        val semi = find_text(css_text, ";", at)
        if semi < 0:
            return sources
        val stmt = css_text.slice(at, semi + 1)
        val href = extract_css_import_href(stmt)
        if href != "":
            sources[write_idx] = BrowserStylesheetSource.external(collapse_url_dot_segments(resolve_relative_url(base_url, href)))
            write_idx = write_idx + 1
        pos = semi + 1
    sources

fn css_import_source_count(css_text: text) -> i32:
    var count = 0
    var pos = 0
    val css_len = css_text.len()
    while pos < css_len:
        val at = find_text(css_text, "@import", pos)
        if at < 0:
            return count
        val semi = find_text(css_text, ";", at)
        if semi < 0:
            return count
        val stmt = css_text.slice(at, semi + 1)
        val href = extract_css_import_href(stmt)
        if href != "":
            count = count + 1
            if count >= BROWSER_MAX_DOCUMENT_SUBRESOURCES:
                return count
        pos = semi + 1
    count

fn strip_css_imports(css_text: text) -> text:
    var out = ""
    var pos = 0
    val css_len = css_text.len()
    while pos < css_len:
        val at = find_text(css_text, "@import", pos)
        if at < 0:
            return out + css_text.slice(pos, css_text.len())
        out = out + css_text.slice(pos, at)
        val semi = find_text(css_text, ";", at)
        if semi < 0:
            return out
        pos = semi + 1
    out

fn extract_css_import_href(stmt: text) -> text:
    val url_idx = find_text(stmt.lower(), "url(", 0)
    if url_idx >= 0:
        val close = find_text(stmt, ")", url_idx + 4)
        if close > url_idx:
            return trim_css_import_url(stmt.slice(url_idx + 4, close))
    val single = find_text(stmt, "'", 0)
    if single >= 0:
        val end = find_text(stmt, "'", single + 1)
        if end > single:
            return stmt.slice(single + 1, end)
    val double = find_text(stmt, "\"", 0)
    if double >= 0:
        val end = find_text(stmt, "\"", double + 1)
        if end > double:
            return stmt.slice(double + 1, end)
    ""

fn trim_css_import_url(value: text) -> text:
    var trimmed = value.trim()
    if trimmed.starts_with("'") and trimmed.ends_with("'") and trimmed.len() >= 2:
        trimmed = trimmed.slice(1, trimmed.len() - 1)
    else if trimmed.starts_with("\"") and trimmed.ends_with("\"") and trimmed.len() >= 2:
        trimmed = trimmed.slice(1, trimmed.len() - 1)
    trimmed

fn insert_stylesheet_sources(existing: [BrowserStylesheetSource], index: i32, additions: [BrowserStylesheetSource]) -> [BrowserStylesheetSource]:
    val remaining = BROWSER_MAX_DOCUMENT_SUBRESOURCES - existing.len()
    val additions_count = if additions.len() < remaining:
        additions.len()
    else:
        if remaining > 0: remaining else: 0
    if additions_count == 0:
        return existing
    val existing_count = existing.len()
    val seed = if existing_count > 0: existing[0] else: additions[0]
    var out: [BrowserStylesheetSource] = [seed; existing_count + additions_count]
    var i = 0
    var write_idx = 0
    while i < existing_count:
        if i == index:
            var add_idx = 0
            while add_idx < additions_count:
                out[write_idx] = additions[add_idx]
                write_idx = write_idx + 1
                add_idx = add_idx + 1
        out[write_idx] = existing[i]
        write_idx = write_idx + 1
        i = i + 1
    if index >= existing_count:
        var add_idx = 0
        while add_idx < additions_count:
            out[write_idx] = additions[add_idx]
            write_idx = write_idx + 1
            add_idx = add_idx + 1
    out
