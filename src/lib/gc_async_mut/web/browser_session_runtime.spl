use std.common.encoding.utf8.{
    text_is_valid_utf8, text_without_last_codepoint, utf8_decode_one
}
use std.common.convert.{digit_value}

extern fn rt_text_to_bytes(value: text) -> [u8]

val BROWSER_STORAGE_MAX_ORIGINS: i32 = 64
val BROWSER_STORAGE_MAX_RETAINED_BYTES: i64 = 16777216

fn _browser_session_previous_utf8_boundary(value: text, index: i64) -> i64:
    val bytes = rt_text_to_bytes(value)
    if index <= 0 or bytes.len() == 0:
        return 0
    var previous = if index > bytes.len(): bytes.len() - 1 else: index - 1
    while previous > 0 and (bytes[previous] & 0xC0u8) == 0x80u8:
        previous = previous - 1
    previous

fn _browser_session_next_utf8_boundary(value: text, index: i64) -> i64:
    val bytes = rt_text_to_bytes(value)
    if index < 0:
        return 0
    if index >= bytes.len():
        return bytes.len()
    var next = index + 1
    while next < bytes.len() and (bytes[next] & 0xC0u8) == 0x80u8:
        next = next + 1
    next

fn _browser_session_is_utf8_boundary(value: text, index: i64) -> bool:
    if not text_is_valid_utf8(value):
        return false
    val bytes = rt_text_to_bytes(value)
    index == bytes.len() or (
        index >= 0 and index < bytes.len() and
        (bytes[index] & 0xC0u8) != 0x80u8
    )

fn _browser_session_text_control_value(target: BeDomNode) -> text:
    if target.tag_name == "input":
        return be_dom_get_attr(target, "value")
    if target.tag_name == "textarea":
        return html_to_text(be_dom_serialize_children(target))
    ""

fn _browser_session_parse_maxlength(raw: text) -> i64?:
    val value = raw.trim()
    if value == "":
        return nil
    var index: i64 = 0
    if value[0] == "+":
        index = 1
    elif value[0] == "-":
        return nil
    var parsed: i64 = 0
    var digits: i64 = 0
    while index < value.len():
        val digit = digit_value(value[index])
        if digit < 0:
            break
        if parsed > 115292150460684697:
            return nil
        parsed = parsed * 10
        if parsed > 1152921504606846975 - digit:
            return nil
        parsed = parsed + digit
        digits = digits + 1
        index = index + 1
    if digits == 0:
        return nil
    parsed

fn _browser_session_utf16_units(value: text) -> i64:
    val bytes = value.bytes()
    var offset: i64 = 0
    var units: i64 = 0
    while offset < bytes.len():
        val decoded = utf8_decode_one(bytes, offset)
        val consumed = decoded[1]
        if consumed <= 0:
            return units
        units = units + (if decoded[0] > 0xFFFF: 2 else: 1)
        offset = offset + consumed
    units

fn _browser_session_utf16_prefix(value: text, limit: i64) -> text:
    if limit <= 0:
        return ""
    val bytes = value.bytes()
    var offset: i64 = 0
    var units: i64 = 0
    while offset < bytes.len():
        val decoded = utf8_decode_one(bytes, offset)
        val consumed = decoded[1]
        if consumed <= 0:
            break
        val next_units = units + (if decoded[0] > 0xFFFF: 2 else: 1)
        if next_units > limit:
            break
        units = next_units
        offset = offset + consumed
    if offset >= bytes.len():
        return value
    value.slice(0, offset)

fn _browser_session_text_maxlength(target: BeDomNode) -> i64?:
    if not be_dom_has_attr(target, "maxlength"):
        return nil
    if target.tag_name == "textarea":
        return _browser_session_parse_maxlength(
            be_dom_get_attr(target, "maxlength")
        )
    if target.tag_name != "input":
        return nil
    val input_type = be_dom_get_attr(target, "type").lower()
    if not (
        input_type == "" or input_type == "text" or
        input_type == "search" or input_type == "url" or
        input_type == "tel" or input_type == "email" or
        input_type == "password"
    ):
        return nil
    _browser_session_parse_maxlength(be_dom_get_attr(target, "maxlength"))

pub fn dom_text_control_selectable(target: BeDomNode) -> bool:
    if be_dom_has_attr(target, "disabled"):
        return false
    if target.tag_name != "input" and target.tag_name != "textarea":
        return false
    if not text_is_valid_utf8(_browser_session_text_control_value(target)):
        return false
    if target.tag_name == "textarea":
        return true
    val input_type = be_dom_get_attr(target, "type").lower()
    input_type == "" or input_type == "text" or input_type == "search" or
        input_type == "url" or input_type == "tel" or
        input_type == "email" or input_type == "password" or
        input_type == "number"

pub fn dom_text_control_mutable(target: BeDomNode) -> bool:
    dom_text_control_selectable(target) and
        not be_dom_has_attr(target, "readonly")

fn browser_storage_origin_key(url: text) -> text:
    val origin = url_origin(url)
    if origin != "":
        return origin
    url

fn browser_storage_entries_for_origin(
    buckets: [BrowserOriginStorage], origin: text
) -> [Pair<text, text>]:
    for bucket in buckets:
        if bucket.origin == origin:
            return bucket.entries
    []

fn browser_storage_bucket_retained_bytes(
    bucket: BrowserOriginStorage
) -> i64:
    var retained = bucket.origin.len()
    for entry in bucket.entries:
        val entry_bytes = entry.first.len() + entry.second.len()
        if entry_bytes > BROWSER_STORAGE_MAX_RETAINED_BYTES - retained:
            return BROWSER_STORAGE_MAX_RETAINED_BYTES + 1
        retained = retained + entry_bytes
    retained

fn browser_storage_replace_origin(
    buckets: [BrowserOriginStorage],
    origin: text,
    entries: [Pair<text, text>]
) -> [BrowserOriginStorage]:
    var candidates: [BrowserOriginStorage] = []
    for bucket in buckets:
        if bucket.origin != origin and bucket.entries.len() > 0:
            candidates.push(bucket)
    if entries.len() > 0:
        candidates.push(BrowserOriginStorage(origin: origin, entries: entries))

    var start = candidates.len()
    var retained_origins = 0
    var retained_bytes: i64 = 0
    while start > 0 and retained_origins < BROWSER_STORAGE_MAX_ORIGINS:
        val bucket_bytes = browser_storage_bucket_retained_bytes(
            candidates[start - 1]
        )
        if bucket_bytes > BROWSER_STORAGE_MAX_RETAINED_BYTES - retained_bytes:
            break
        start = start - 1
        retained_origins = retained_origins + 1
        retained_bytes = retained_bytes + bucket_bytes

    var retained: [BrowserOriginStorage] = []
    while start < candidates.len():
        retained.push(candidates[start])
        start = start + 1
    retained

fn _browser_session_dom_node_count(node: BeDomNode) -> i32:
    var count = 1
    for child in node.children:
        count = count + _browser_session_dom_node_count(child)
    count

fn _browser_session_replace_body_children(
    node: BeDomNode, children: [BeDomNode]
) -> BeDomNode:
    if node.tag_name == "body":
        return be_dom_set_children(node, children)
    var next_children: [BeDomNode] = []
    for child in node.children:
        next_children.push(_browser_session_replace_body_children(
            child, children
        ))
    be_dom_set_children(node, next_children)

fn _browser_session_dom_action(action: text) -> bool:
    action.starts_with("set-text:") or action.starts_with("set-attr:") or
        action.starts_with("remove-attr:") or action.starts_with("add-class:") or
        action.starts_with("remove-class:") or action.starts_with("toggle-class:")

fn _browser_session_event_control(action: text) -> bool:
    action == "prevent-default" or action == "stop-propagation" or
        action == "stop-immediate-propagation"

fn _browser_session_focus_default(action: text) -> bool:
    action == "focus-element" or action == "button-activate" or
        action == "input-checkbox-toggle" or action == "input-radio-select" or
        action == "form-reset"

fn _browser_session_dom_route_id(root: BeDomNode, target_id: text) -> text:
    val path = be_dom_find_path_to_id(root, target_id)
    if path.len() == 0:
        return target_id
    be_dom_route_identity(path[path.len() - 1])

fn _browser_session_replace_dom_path(
    path: [BeDomNode], replacement: BeDomNode
) -> BeDomNode:
    var next = replacement
    var ancestor = path.len() - 2
    while ancestor >= 0:
        val parent = path[ancestor]
        var children: [BeDomNode] = []
        for child in parent.children:
            if child.node_id == next.node_id:
                children.push(next)
            else:
                children.push(child)
        next = be_dom_set_children(parent, children)
        ancestor = ancestor - 1
    next

fn _browser_session_checkable_click_action(
    root: BeDomNode, target_id: text, event_type: text
) -> text:
    if event_type != "click":
        return ""
    val path = be_dom_find_path_to_id(root, target_id)
    if path.len() == 0:
        return ""
    val target = path[path.len() - 1]
    if target.tag_name != "input" or be_dom_has_attr(target, "disabled"):
        return ""
    match be_dom_get_attr(target, "type").lower():
        "checkbox": "input-checkbox-toggle"
        "radio": "input-radio-select"
        _: ""

fn _browser_session_accepts_implicit_submit(target: BeDomNode) -> bool:
    if target.tag_name != "input" or be_dom_has_attr(target, "disabled") or
       be_dom_has_attr(target, "readonly"):
        return false
    be_dom_input_blocks_implicit_submission(target)

fn storage_pairs_from_object(state: BrowserRuntimeState, object_id: i64) -> [Pair<text, text>]:
    val obj = state.runtime.get_host_object(object_id)
    var out: [Pair<text, text>] = []
    for prop in obj.properties:
        if is_storage_internal_property(prop.key):
            out = upsert_pair(out, storage_public_key_from_internal(prop.key), js_value_to_storage_text(prop.value))
        else if not is_storage_api_property(prop.key):
            out = upsert_pair(out, prop.key, js_value_to_storage_text(prop.value))
    out

impl BrowserSession:

    me _advance_ui_access_revision():
        self.ui_access_revision = if self.ui_access_revision >= 9223372036854775806:
            1
        else:
            self.ui_access_revision + 1

    me _replace_current_body_children(body_html: text):
        val replacement = form_capture_defaults(html_tree_builder_build(
            "<html><body>" + body_html + "</body></html>"
        ))
        val replacement_bodies = be_dom_find_by_tag(replacement, "body")
        val current_bodies = be_dom_find_by_tag(self.current_dom, "body")
        if replacement_bodies.len() == 0 or current_bodies.len() == 0:
            self.current_dom = replacement
            self._advance_ui_access_revision()
            return
        self.current_dom = _browser_session_replace_body_children(
            self.current_dom, replacement_bodies[0].children
        )
        self._advance_ui_access_revision()

    me _submit_dom_form(
        form_id: text, submitter_id: text
    ) -> BeDomEventDispatch:
        val submit_dispatch = self.dispatch_dom_event(
            form_id, "submit", true, true
        )
        if submit_dispatch.default_action_allowed:
            val submission = browser_form_submission(
                self.current_dom, form_id, submitter_id, self.document_url
            )
            if submission.error != "":
                self._append_warning(submission.error)
            else:
                val started = self.begin_network_navigation(
                    submission.url, submission.method, "",
                    submission.body, submission.content_type
                )
                if val Err(e) = started:
                    self._append_warning("form navigation blocked: {e}")
        submit_dispatch

    me _reset_dom_form(form_id: text):
        val reset_dispatch = self.dispatch_dom_event(
            form_id, "reset", true, true
        )
        if reset_dispatch.event.default_prevented:
            return
        val form_path = be_dom_find_path_to_id(self.current_dom, form_id)
        if form_path.len() == 0:
            return
        self.current_dom = _browser_session_replace_dom_path(
            form_path, form_reset(form_path[form_path.len() - 1])
        )
        self._advance_ui_access_revision()
        self._sync_runtime_body_from_dom()

    me _ensure_dom_text_selection(
        target_id: text, target: BeDomNode
    ) -> text:
        val value = _browser_session_text_control_value(target)
        if (
            self.text_selection_target_id != target_id or
            self.text_selection_anchor_byte < 0 or
            self.text_selection_focus_byte < 0 or
            self.text_selection_anchor_byte > value.len() or
            self.text_selection_focus_byte > value.len() or
            not _browser_session_is_utf8_boundary(
                value, self.text_selection_anchor_byte
            ) or
            not _browser_session_is_utf8_boundary(
                value, self.text_selection_focus_byte
            )
        ):
            val _ = self.set_dom_text_selection(
                target_id, value.len(), value.len()
            )
        value

    me set_dom_text_selection(
        target_id: text, anchor_byte: i64, focus_byte: i64
    ) -> bool:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return false
        val target = path[path.len() - 1]
        if not dom_text_control_selectable(target):
            return false
        val value = _browser_session_text_control_value(target)
        if (
            anchor_byte < 0 or focus_byte < 0 or
            anchor_byte > value.len() or focus_byte > value.len() or
            not _browser_session_is_utf8_boundary(value, anchor_byte) or
            not _browser_session_is_utf8_boundary(value, focus_byte)
        ):
            return false
        self.text_selection_target_id = target_id
        self.text_selection_anchor_byte = anchor_byte
        self.text_selection_focus_byte = focus_byte
        true

    me clear_dom_text_selection():
        self.text_selection_target_id = ""
        self.text_selection_anchor_byte = 0
        self.text_selection_focus_byte = 0

    me ensure_dom_text_selection(target_id: text) -> bool:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return false
        val target = path[path.len() - 1]
        if not dom_text_control_selectable(target):
            return false
        val _ = self._ensure_dom_text_selection(target_id, target)
        true

    me _persist_storage_for_url(url: text):
        if url == "":
            return
        val origin = browser_storage_origin_key(url)
        self.session_storage_by_origin = browser_storage_replace_origin(
            self.session_storage_by_origin, origin, self.session_storage
        )
        self.local_storage_by_origin = browser_storage_replace_origin(
            self.local_storage_by_origin, origin, self.local_storage
        )

    me _activate_storage_for_url(url: text):
        val origin = browser_storage_origin_key(url)
        self.session_storage = browser_storage_entries_for_origin(
            self.session_storage_by_origin, origin
        )
        self.local_storage = browser_storage_entries_for_origin(
            self.local_storage_by_origin, origin
        )

    me eval_script(script: text) -> Result<JsValue, text>:
        if self.runtime_state == nil:
            val _ = self._ensure_runtime_state()
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            val result = runtime.eval(script)
            state.runtime = runtime
            self.runtime_state = Some(state)
            match result:
                Ok(value):
                    self._flush_runtime_side_effects()
                    return Ok(value)
                Err(e):
                    return Err(e.message)
        Err("no active page runtime")

    me advance_time(current_time_ms: i64) -> i64:
        """Run page timers due at a deterministic monotonic timestamp."""
        if current_time_ms < 0:
            return 0
        if current_time_ms > self.monotonic_time_ms:
            self.monotonic_time_ms = current_time_ms
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            val ran = runtime.drain_due_timers(self.monotonic_time_ms)
            state.runtime = runtime
            self.runtime_state = Some(state)
            if ran > 0:
                self._flush_runtime_side_effects()
            return ran
        0

    fn next_script_timer_due_ms() -> i64:
        if val Some(state) = self.runtime_state:
            val runtime = state.runtime
            val interpreter = runtime.interpreter
            var earliest: i64 = -1
            for task in interpreter.pending_timer_tasks:
                val due = task.scheduled_at_ms + task.delay_ms
                if earliest < 0 or due < earliest:
                    earliest = due
            return earliest
        -1

    me dom_root() -> BeDomNode:
        self.current_dom

    me _sync_body_html_from_dom():
        val bodies = be_dom_find_by_tag(self.current_dom, "body")
        if bodies.len() > 0:
            self.current_body_html = be_dom_serialize_children(bodies[0])

    me _sync_runtime_body_from_dom():
        self._sync_body_html_from_dom()
        self._mark_css_animation_reconcile(false)
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            val body_text = html_to_text(self.current_body_html)
            runtime.set_host_property(
                state.body_id, "innerHTML",
                JsValue.String(v: self.current_body_html)
            )
            runtime.set_host_property(
                state.body_id, "textContent",
                JsValue.String(v: body_text)
            )
            var interpreter = runtime.interpreter
            interpreter.host_body_inner_html_value = JsValue.String(v: self.current_body_html)
            interpreter.host_body_text_content_value = JsValue.String(v: body_text)
            interpreter.host_body_inner_html_dirty = false
            interpreter.host_body_text_content_dirty = false
            runtime.interpreter = interpreter
            state.runtime = runtime
            self.runtime_state = Some(state)

    me dispatch_dom_event(target_id: text, event_type: text, bubbles: bool, cancelable: bool) -> BeDomEventDispatch:
        val target_route_id = _browser_session_dom_route_id(
            self.current_dom, target_id
        )
        val checkable_action = _browser_session_checkable_click_action(
            self.current_dom, target_route_id, event_type
        )
        var checked_before = false
        var checked_radio_before = ""
        if checkable_action != "":
            val focused_id = be_dom_focused_route_id(self.current_dom)
            if focused_id != "" and focused_id != target_route_id:
                val _ = self._blur_dom_focus(focused_id)
            val path = be_dom_find_path_to_id(self.current_dom, target_route_id)
            if path.len() > 0:
                checked_before = be_dom_has_attr(
                    path[path.len() - 1], "checked"
                )
            if checkable_action == "input-radio-select":
                checked_radio_before = be_dom_checked_radio_id_for_target(
                    self.current_dom, target_route_id
                )
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_route_id, checkable_action, true
            )
            self._sync_runtime_body_from_dom()
        val dispatch = be_dom_dispatch_event_to_id(
            self.current_dom, target_route_id, event_type, bubbles, cancelable
        )
        self.dom_callback_count = (
            self.dom_callback_count + dispatch.actions.len().to_i64()
        )
        var action_index = 0
        while action_index < dispatch.actions.len():
            val action = dispatch.actions[action_index]
            if _browser_session_dom_action(action):
                self.current_dom = script_host_apply_action_to_id(
                    self.current_dom,
                    dispatch.current_target_route_ids[action_index],
                    action,
                    false
                )
            elif _browser_session_event_control(action) == false:
                self._sync_runtime_body_from_dom()
                val _ = self.eval_script(action)
            action_index = action_index + 1
        if checkable_action != "" and not dispatch.default_action_allowed:
            val restore_action = if checked_before:
                "set-attr:checked:checked"
            else:
                "remove-attr:checked"
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_route_id, restore_action, false
            )
            if (
                checkable_action == "input-radio-select" and
                checked_radio_before != "" and
                checked_radio_before != target_route_id
            ):
                self.current_dom = script_host_apply_action_to_id(
                    self.current_dom, checked_radio_before,
                    "set-attr:checked:checked", false
                )
        if dispatch.default_action_allowed:
            var focus_changed = false
            if _browser_session_focus_default(dispatch.default_action):
                val focused_id = be_dom_focused_route_id(self.current_dom)
                focus_changed = focused_id != dispatch.target_route_id
                if focused_id != "" and
                   focused_id != dispatch.target_route_id:
                    val _ = self._blur_dom_focus(focused_id)
            if dispatch.default_action.starts_with("navigate:"):
                val href = dispatch.default_action.substring(9, dispatch.default_action.len())
                val target = resolve_relative_url(self.document_url, href)
                val started = self.begin_network_navigation(target, "GET", "", "", "")
                if val Err(e) = started:
                    self._append_warning("default navigation blocked: {e}")
                return dispatch
            if checkable_action == "":
                self.current_dom = script_host_apply_action_to_id(
                    self.current_dom, dispatch.target_route_id,
                    dispatch.default_action, true
                )
            else:
                self._sync_body_html_from_dom()
                val _ = self.dispatch_dom_event(
                    dispatch.target_route_id, "input", true, false
                )
                val _ = self.dispatch_dom_event(
                    dispatch.target_route_id, "change", true, false
                )
            if focus_changed:
                if event_type != "focus":
                    val _ = self.dispatch_dom_event(
                        dispatch.target_route_id, "focus", false, false
                    )
                val _ = self.dispatch_dom_event(
                    dispatch.target_route_id, "focusin", true, false
                )
            if event_type == "click" and dispatch.default_action == "button-activate":
                val form_id = be_dom_submit_form_owner_id(
                    self.current_dom, dispatch.target_route_id
                )
                if form_id != "":
                    val _ = self._submit_dom_form(
                        form_id, dispatch.target_route_id
                    )
            elif event_type == "click" and
                 dispatch.default_action == "form-reset":
                val form_id = be_dom_reset_form_owner_id(
                    self.current_dom, dispatch.target_route_id
                )
                if form_id != "":
                    self._reset_dom_form(form_id)
        self._sync_body_html_from_dom()
        dispatch

    me dispatch_dom_keyboard_activation(
        target_id: text, key: text
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM keyboard target not found")
        val key_dispatch = self.dispatch_dom_event(
            target_id, "keydown", true, true
        )
        if key_dispatch.event.default_prevented:
            return Ok(key_dispatch)
        val current_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if current_path.len() == 0:
            return Err("DOM keyboard target was removed")
        val event_type = be_dom_keyboard_activation_event_for_target(
            current_path[current_path.len() - 1], key
        )
        if event_type == "":
            return Err("key does not activate target")
        Ok(self.dispatch_dom_event(target_id, event_type, true, true))

    me dispatch_dom_keyboard_event(
        target_id: text, key: text, pressed: bool
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM keyboard target not found")
        val event_type = if pressed: "keydown" else: "keyup"
        val key_dispatch = self.dispatch_dom_event(
            target_id, event_type, true, true
        )
        if key_dispatch.event.default_prevented:
            self.pending_space_activation_target = ""
            return Ok(key_dispatch)
        val current_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if current_path.len() == 0:
            self.pending_space_activation_target = ""
            return Err("DOM keyboard target was removed")
        val target = current_path[current_path.len() - 1]
        val normalized_key = key.trim().lower()
        val is_space = (
            normalized_key == "space" or normalized_key == "spacebar" or
            key == " "
        )
        if pressed and (normalized_key == "backspace" or key == "8"):
            self.pending_space_activation_target = ""
            if (
                (target.tag_name == "input" or target.tag_name == "textarea") and
                not be_dom_has_attr(target, "disabled") and
                not be_dom_has_attr(target, "readonly")
            ):
                val value = if target.tag_name == "input":
                    be_dom_get_attr(target, "value")
                else:
                    html_to_text(be_dom_serialize_children(target))
                if value != "":
                    return self.set_dom_text_input(
                        target_id, text_without_last_codepoint(value)
                    )
            return Ok(key_dispatch)
        if pressed and (
            normalized_key == "enter" or normalized_key == "return"
        ) and _browser_session_accepts_implicit_submit(target):
            val form_id = be_dom_form_owner_id(self.current_dom, target_id)
            val submitter_id = be_dom_default_submitter_id(
                self.current_dom, form_id
            )
            if submitter_id != "":
                return Ok(self.dispatch_dom_event(
                    submitter_id, "click", true, true
                ))
            if be_dom_form_allows_direct_implicit_submit(
                self.current_dom, form_id
            ):
                return Ok(self._submit_dom_form(form_id, ""))
        val activation_event = be_dom_keyboard_activation_event_for_target(
            target, key
        )
        if activation_event == "":
            self.pending_space_activation_target = ""
            return Ok(key_dispatch)
        if is_space:
            if pressed:
                self.pending_space_activation_target = target_id
                return Ok(key_dispatch)
            val armed = self.pending_space_activation_target == target_id
            self.pending_space_activation_target = ""
            if not armed:
                return Ok(key_dispatch)
        elif not pressed:
            return Ok(key_dispatch)
        else:
            self.pending_space_activation_target = ""
        Ok(self.dispatch_dom_event(target_id, activation_event, true, true))

    me dispatch_dom_keyboard_event_with_shift(
        target_id: text, key: text, pressed: bool, shift_key: bool
    ) -> Result<BeDomEventDispatch, text>:
        val normalized_key = key.trim().lower()
        val is_tab = normalized_key == "tab" or key == "9"
        val is_left = normalized_key == "arrowleft" or key == "37"
        val is_right = normalized_key == "arrowright" or key == "39"
        val is_home = normalized_key == "home" or key == "36"
        val is_end = normalized_key == "end" or key == "35"
        val is_backspace = normalized_key == "backspace" or key == "8"
        val is_delete = normalized_key == "delete" or key == "127"
        val is_edit_key = (
            is_left or is_right or is_home or is_end or
            is_backspace or is_delete
        )
        if pressed and not is_tab and is_edit_key and target_id != "":
            val path = be_dom_find_path_to_id(self.current_dom, target_id)
            if path.len() > 0:
                val target = path[path.len() - 1]
                if dom_text_control_selectable(target):
                    val key_dispatch = self.dispatch_dom_event(
                        target_id, "keydown", true, true
                    )
                    if key_dispatch.event.default_prevented:
                        return Ok(key_dispatch)
                    val value = self._ensure_dom_text_selection(
                        target_id, target
                    )
                    if is_left or is_right or is_home or is_end:
                        var next_focus = self.text_selection_focus_byte
                        val has_selection = (
                            self.text_selection_anchor_byte !=
                            self.text_selection_focus_byte
                        )
                        if is_left and not shift_key and has_selection:
                            next_focus = self.text_selection_anchor_byte
                            if self.text_selection_focus_byte < next_focus:
                                next_focus = self.text_selection_focus_byte
                        elif is_right and not shift_key and has_selection:
                            next_focus = self.text_selection_anchor_byte
                            if self.text_selection_focus_byte > next_focus:
                                next_focus = self.text_selection_focus_byte
                        elif is_left:
                            next_focus = _browser_session_previous_utf8_boundary(
                                value, next_focus
                            )
                        elif is_right:
                            next_focus = _browser_session_next_utf8_boundary(
                                value, next_focus
                            )
                        elif is_home:
                            next_focus = 0
                        else:
                            next_focus = value.len()
                        self.text_selection_focus_byte = next_focus
                        if not shift_key:
                            self.text_selection_anchor_byte = next_focus
                        return Ok(key_dispatch)
                    if not dom_text_control_mutable(target):
                        return Ok(key_dispatch)
                    var start = self.text_selection_anchor_byte
                    var end = self.text_selection_focus_byte
                    if start > end:
                        val swap = start
                        start = end
                        end = swap
                    if start == end and is_backspace:
                        start = _browser_session_previous_utf8_boundary(
                            value, start
                        )
                    elif start == end and is_delete:
                        end = _browser_session_next_utf8_boundary(value, end)
                    if start == end:
                        return Ok(key_dispatch)
                    val updated = self.set_dom_text_input(
                        target_id,
                        value.slice(0, start) + value.slice(end, value.len())
                    )
                    if updated.is_ok():
                        self.text_selection_target_id = target_id
                        self.text_selection_anchor_byte = start
                        self.text_selection_focus_byte = start
                    return updated
        if not is_tab or not pressed:
            return self.dispatch_dom_keyboard_event(target_id, key, pressed)
        self.pending_space_activation_target = ""
        if target_id != "":
            val current_route_id = _browser_session_dom_route_id(
                self.current_dom, target_id
            )
            val key_dispatch = self.dispatch_dom_event(
                target_id, "keydown", true, true
            )
            if key_dispatch.event.default_prevented:
                return Ok(key_dispatch)
            val next_id = be_dom_next_focus_route_id(
                self.current_dom, current_route_id, shift_key
            )
            if next_id == "" or next_id == current_route_id:
                return Ok(key_dispatch)
            val _ = self._blur_dom_focus(target_id)
            return Ok(self.dispatch_dom_event(
                next_id, "focus", false, false
            ))
        val next_id = be_dom_next_focus_route_id(
            self.current_dom, "", shift_key
        )
        if next_id == "":
            return Err("DOM has no focusable target")
        Ok(self.dispatch_dom_event(next_id, "focus", false, false))

    me _apply_dom_text_edit(
        target_id: text, prefix: text, insertion: text, suffix: text,
        replace_all: bool
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM input target not found")
        val target = path[path.len() - 1]
        if not dom_text_control_mutable(target):
            return Err("DOM input target is not editable")
        if (
            not text_is_valid_utf8(prefix) or
            not text_is_valid_utf8(insertion) or
            not text_is_valid_utf8(suffix)
        ):
            return Err("DOM input value is not valid UTF-8")
        val target_route_id = be_dom_route_identity(target)
        if be_dom_focused_route_id(self.current_dom) != target_route_id:
            val _ = self.dispatch_dom_event(
                target_id, "focus", false, false
            )
        val before_input = self.dispatch_dom_event(
            target_id, "beforeinput", true, true
        )
        if before_input.event.default_prevented:
            return Ok(before_input)

        val current_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if current_path.len() == 0:
            return Err("DOM input target was removed")
        val current_target = current_path[current_path.len() - 1]
        if not dom_text_control_mutable(current_target):
            return Err("DOM input target is not editable")
        val current_value = _browser_session_text_control_value(current_target)
        var accepted_insertion = insertion
        var next_value = prefix + insertion + suffix
        val maxlength = _browser_session_text_maxlength(current_target)
        if maxlength != nil:
            val limit = maxlength ?? 0
            if replace_all:
                val current_units = _browser_session_utf16_units(current_value)
                val next_units = _browser_session_utf16_units(next_value)
                if not (current_units > limit and next_units < current_units):
                    accepted_insertion = _browser_session_utf16_prefix(
                        insertion, limit
                    )
                    next_value = accepted_insertion
            else:
                val fixed_units = (
                    _browser_session_utf16_units(prefix) +
                    _browser_session_utf16_units(suffix)
                )
                val available = if fixed_units >= limit:
                    0
                else:
                    limit - fixed_units
                accepted_insertion = _browser_session_utf16_prefix(
                    insertion, available
                )
                next_value = prefix + accepted_insertion + suffix
        if next_value == current_value:
            return Ok(before_input)

        if current_target.tag_name == "input":
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_id,
                "set-attr:value=" + next_value, false
            )
        else:
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_id, "set-text:" + next_value, false
            )
        self.current_dom = script_host_apply_action_to_id(
            self.current_dom, target_id,
            "set-attr:data-input-dirty=true", false
        )
        val input_dispatch = self.dispatch_dom_event(
            target_id, "input", true, false
        )
        val caret = if replace_all:
            next_value.len()
        else:
            prefix.len() + accepted_insertion.len()
        self.text_selection_target_id = target_id
        self.text_selection_anchor_byte = caret
        self.text_selection_focus_byte = caret
        Ok(input_dispatch)

    me set_dom_select_value(
        target_id: text, value: text
    ) -> Result<bool, text>:
        val initial_path = be_dom_find_path_to_id(
            self.current_dom, target_id
        )
        if initial_path.len() == 0:
            return Err("DOM select target not found")
        val initial_target = initial_path[initial_path.len() - 1]
        if initial_target.tag_name != "select":
            return Err("DOM target is not a select")
        if be_dom_has_attr(initial_target, "disabled"):
            return Err("DOM select target is disabled")
        if not browser_select_has_value(initial_target, value):
            return Err("DOM select value is unavailable")

        val route_id = be_dom_route_identity(initial_target)
        val focused_id = be_dom_focused_route_id(self.current_dom)
        if focused_id != route_id:
            if focused_id != "":
                val _ = self._blur_dom_focus(focused_id)
            val _ = self.dispatch_dom_event(
                route_id, "focus", false, false
            )

        val current_path = be_dom_find_path_to_id(
            self.current_dom, route_id
        )
        if current_path.len() == 0:
            return Err("DOM select target was removed")
        val current_target = current_path[current_path.len() - 1]
        if (
            current_target.tag_name != "select" or
            be_dom_has_attr(current_target, "disabled")
        ):
            return Err("DOM select target is no longer editable")
        val update = browser_select_update(current_target, value)
        if not update.found:
            return Err("DOM select value is no longer available")
        if not update.changed:
            return Ok(false)

        self.current_dom = _browser_session_replace_dom_path(
            current_path, update.node
        )
        self._sync_body_html_from_dom()
        val _ = self.dispatch_dom_event(
            route_id, "input", true, false
        )
        if be_dom_find_path_to_id(self.current_dom, route_id).len() > 0:
            val _ = self.dispatch_dom_event(
                route_id, "change", true, false
            )
        Ok(true)

    me set_dom_text_input(
        target_id: text, value: text
    ) -> Result<BeDomEventDispatch, text>:
        self._apply_dom_text_edit(target_id, "", value, "", true)

    me append_dom_text_input(
        target_id: text, value: text
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM input target not found")
        val target = path[path.len() - 1]
        if not dom_text_control_mutable(target):
            return Err("DOM input target is not editable")
        val current_value = self._ensure_dom_text_selection(
            target_id, target
        )
        var start = self.text_selection_anchor_byte
        var end = self.text_selection_focus_byte
        if start > end:
            val swap = start
            start = end
            end = swap
        self._apply_dom_text_edit(
            target_id,
            current_value.slice(0, start),
            value,
            current_value.slice(end, current_value.len()),
            false
        )

    me _blur_dom_focus(target_id: text) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM focus target not found")
        val target = path[path.len() - 1]
        if (target.tag_name == "input" or target.tag_name == "textarea") and
           be_dom_has_attr(target, "data-input-dirty"):
            val _ = self.dispatch_dom_event(target_id, "change", true, false)
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_id,
                "remove-attr:data-input-dirty", false
            )
        self.current_dom = script_host_apply_action_to_id(
            self.current_dom, target_id, "remove-attr:data-focused", false
        )
        val blur_dispatch = self.dispatch_dom_event(
            target_id, "blur", false, false
        )
        val _ = self.dispatch_dom_event(
            target_id, "focusout", true, false
        )
        if self.text_selection_target_id == target_id:
            self.clear_dom_text_selection()
        Ok(blur_dispatch)

    me blur_dom_text_input(target_id: text) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM input target not found")
        val target = path[path.len() - 1]
        if target.tag_name != "input" and target.tag_name != "textarea":
            return Err("DOM input target is not text-editable")
        self._blur_dom_focus(target_id)

    me clear_dom_focus():
        val focused_id = be_dom_focused_route_id(self.current_dom)
        if focused_id != "":
            val _ = self._blur_dom_focus(focused_id)
        self.clear_dom_text_selection()

    me discard_dom_focus_for_navigation():
        val focused_id = be_dom_focused_route_id(self.current_dom)
        if focused_id != "":
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, focused_id,
                "remove-attr:data-focused", false
            )
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, focused_id,
                "remove-attr:data-input-dirty", false
            )
            self._sync_runtime_body_from_dom()
        self.clear_dom_text_selection()

    me render(width: i32, height: i32) -> BeRenderResult:
        var renderer = BrowserRenderer.create(width, height)
        self.prepare_css_animation_instances(width)
        val html = self.render_html_document()
        val animation_time_ms = self.monotonic_time_ms - self.animation_start_time_ms
        var result = renderer.render_html_to_pixels_at_time_with_animations_with_images(
            html, animation_time_ms, self.css_animation_instances,
            self.image_resources
        )
        result.node_count = _browser_session_dom_node_count(self.current_dom)
        result

    me render_to_pixels(width: i32, height: i32) -> BeRenderResult:
        var renderer = BrowserRenderer.create(width, height)
        self.prepare_css_animation_instances(width)
        val html = self.render_html_document()
        val animation_time_ms = self.monotonic_time_ms - self.animation_start_time_ms
        var result = renderer.render_html_to_pixels_at_time_with_animations_with_images(
            html, animation_time_ms, self.css_animation_instances,
            self.image_resources
        )
        result.node_count = _browser_session_dom_node_count(self.current_dom)
        result

    me render_html_document() -> text:
        val title = if self.current_title != "": self.current_title else: self.current_url
        val bodies = be_dom_find_by_tag(self.current_dom, "body")
        val body_html = if bodies.len() > 0:
            be_dom_serialize_html(bodies[0])
        else:
            "<body>" + self.current_body_html + "</body>"
        val style_html = self.current_style_html
        "<!DOCTYPE html><html><head><title>{escape_html_text(title)}</title>{style_html}</head>{body_html}</html>"

    me _mark_css_animation_reconcile(reset_descendants: bool):
        val elapsed = self.monotonic_time_ms - self.animation_start_time_ms
        self.css_animation_reconcile_epoch_ms = if elapsed > 0:
            elapsed
        else:
            0
        self.css_animation_reconcile_pending = true
        if reset_descendants:
            self.css_animation_reset_descendants = true

    me prepare_css_animation_instances(width: i32):
        if width != self.css_animation_viewport_width:
            self._mark_css_animation_reconcile(false)
            self.css_animation_viewport_width = width
        if not self.css_animation_reconcile_pending:
            return
        val elapsed = self.monotonic_time_ms - self.animation_start_time_ms
        val current_time_ms = if elapsed > 0: elapsed else: 0
        self.css_animation_instances = (
            simple_web_layout_reconcile_animation_instances(
                self.render_html_document(), width, current_time_ms,
                self.css_animation_reconcile_epoch_ms,
                self.css_animation_reset_descendants,
                self.css_animation_instances
            )
        )
        self.css_animation_reconcile_pending = false
        self.css_animation_reset_descendants = false

    me current_entry() -> BrowserHistoryEntry?:
        if self.current_index >= 0 and self.current_index < self.history.len():
            return Some(self.history[self.current_index])
        nil

    me _load_page_source(
        url: text,
        html: text,
        target_index: i32,
        push_history: bool
    ) -> Result<bool, text>:
        if not browser_resource_size_allowed(html.len()):
            self.stop_loading()
            return Err("document exceeds 50 MiB resource limit")
        val previous_document_url = self.document_url
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] load page source start"
        val script_blocks = extract_script_blocks(html)
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] script blocks={script_blocks.len()}"
        val has_runtime_scripts = self.runtime_enabled and script_blocks.len() > 0
        val cleaned_html = if has_runtime_scripts:
            html
        else:
            strip_script_blocks(html)
        val template_visible_html = strip_template_blocks(cleaned_html)
        val visible_html = if self.runtime_enabled:
            strip_noscript_blocks(template_visible_html)
        else:
            template_visible_html
        val visible_parse = html_tree_builder_build_with_scripts(visible_html)
        if visible_parse.truncated:
            self.stop_loading()
            return Err("resource_limit: DOM node limit exceeded (65536)")
        val initial_title = own_text(extract_title_text(html))
        val initial_body_html = own_text(extract_body_inner_html(visible_html))
        val body_html = if initial_body_html.len() > 0:
            initial_body_html
        else:
            own_text(cleaned_html)
        val visible_bodies = be_dom_find_by_tag(visible_parse.doc, "body")
        val final_parse = if visible_bodies.len() > 0:
            html_tree_builder_build_with_scripts(
                "<html>" + be_dom_serialize_html(visible_bodies[0]) + "</html>"
            )
        else:
            html_tree_builder_build_with_scripts(
                "<html><body>" + body_html + "</body></html>"
            )
        if final_parse.truncated:
            self.stop_loading()
            return Err("resource_limit: DOM node limit exceeded (65536)")
        # Atomic document replacement: the previous page survives until all
        # response and parser validation above has succeeded.
        if val Some(previous_state) = self.runtime_state:
            val next_fetch_seq = (
                previous_state.runtime.interpreter.next_async_request_seq
            )
            if next_fetch_seq > self.next_request_seq:
                self.next_request_seq = next_fetch_seq
        self.runtime_state = nil
        self.active_load = nil
        self.pending_requests = []
        self.pending_request_head = 0
        self.inflight_requests = []
        self.subresource_request_count = 0
        self.module_source_cache = []
        self.module_redirect_urls = []
        self.loaded_module_urls = []
        self.module_eval_stack = []
        self.wasm_modules = []
        self.image_resources = []
        self.pending_space_activation_target = ""
        self.text_selection_target_id = ""
        self.text_selection_anchor_byte = 0
        self.text_selection_focus_byte = 0
        self.content_security_policy = self.pending_content_security_policy
        self.pending_content_security_policy = ""
        val style_sources = extract_stylesheet_sources(html)
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] style sources={style_sources.len()}"

        self._persist_storage_for_url(previous_document_url)
        self._activate_storage_for_url(url)
        var native_globals_diagnostic = ""
        if self.runtime_enabled and script_blocks.len() > 0:
            val cookie_text = self._script_cookie_for_url(url)
            var state = BrowserRuntimeState.create(
                own_text(url),
                initial_title,
                body_html,
                self.session_storage,
                self.local_storage,
                own_text(cookie_text)
            )
            state.runtime.interpreter.next_async_request_seq = (
                self.next_request_seq
            )
            state.runtime.interpreter.timer_current_time_ms = self.monotonic_time_ms
            state.runtime.interpreter.timer_time_origin_ms = self.monotonic_time_ms
            var runtime = state.runtime
            match runtime.eval(
                "typeof require + ':' + typeof process + ':' + typeof Buffer"
            ):
                Ok(JsValue.String(value)):
                    native_globals_diagnostic = "browser native globals: {value}"
                Ok(_):
                    native_globals_diagnostic = "browser native globals: invalid-result"
                Err(error):
                    native_globals_diagnostic = "browser native globals check failed: {error.message}"
            state.runtime = runtime
            self.runtime_state = Some(state)
            if url.starts_with("https://guest.runtime/"):
                print "[BRS] runtime state created"
        else:
            self.runtime_state = nil
        self.current_url = own_text(url)
        self.document_url = own_text(url)
        self.animation_start_time_ms = self.monotonic_time_ms
        self.css_animation_instances = []
        self.css_animation_reconcile_pending = true
        self.css_animation_reconcile_epoch_ms = 0
        self.css_animation_reset_descendants = true
        self.css_animation_viewport_width = -1
        self.current_title = if initial_title.len() > 0: initial_title else: own_text(url)
        self.current_body_html = body_html
        self.current_style_html = ""
        self.source_html = own_text(html)
        self.current_dom = form_capture_defaults(final_parse.doc)
        self._advance_ui_access_revision()
        if val Some(state) = self.runtime_state:
            state.bind_dom(self.current_dom)
            self.runtime_state = Some(state)

        var image_sources: [BrowserImageSource] = []
        var image_source_overflow = false
        for image_node in be_dom_find_by_tag(final_parse.doc, "img"):
            val raw_source = be_dom_get_attr(image_node, "src").trim()
            if raw_source == "":
                continue
            if raw_source.len() > SIMPLEOS_HOST_GPU_MAX_IMAGE_URI_BYTES:
                image_source_overflow = true
                continue
            val resolved_source = resolve_relative_url(url, raw_source)
            var duplicate_source = false
            for existing_source in image_sources:
                if (existing_source.authored_src == raw_source and
                    existing_source.resolved_url == resolved_source):
                    duplicate_source = true
            if duplicate_source:
                continue
            if image_sources.len() >= BROWSER_MAX_IMAGE_RESOURCES:
                image_source_overflow = true
                continue
            image_sources.push(BrowserImageSource.create(
                raw_source, resolved_source
            ))

        var load = BrowserLoadState.create(
            document_url: url,
            source_html: html,
            target_index: target_index,
            push_history: push_history,
            script_blocks: script_blocks,
            style_sources: style_sources,
            image_sources: image_sources
        )
        if image_source_overflow:
            load.append_warning(
                "image resource limit reached; additional images ignored"
            )
        if native_globals_diagnostic != "":
            load.append_warning(native_globals_diagnostic)
        if script_blocks.len() >= BROWSER_MAX_DOCUMENT_SUBRESOURCES:
            load.append_warning(
                "script resource limit reached; additional scripts ignored"
            )
        if style_sources.len() >= BROWSER_MAX_DOCUMENT_SUBRESOURCES:
            load.append_warning(
                "stylesheet resource limit reached; additional styles ignored"
            )
        self.active_load = Some(load)
        if not has_runtime_scripts:
            if val Some(fetch_url) = _browser_session_inline_fetch_url(html):
                val resolved_fetch_url = self._hsts_upgrade_url(
                    resolve_relative_url(url, fetch_url)
                )
                val is_mixed_content = (browser_session_is_secure_context(url) and
                    resolved_fetch_url.starts_with("http://") and
                    not browser_session_is_loopback_http(resolved_fetch_url))
                val is_csp_blocked = not browser_csp_allows(
                    self.content_security_policy, "connect-src",
                    url, resolved_fetch_url, false
                )
                if ((not is_mixed_content or self.broker_network_policy) and
                    (not is_csp_blocked or
                        self._broker_hsts_candidate(resolved_fetch_url))):
                    val inline_method_raw = _browser_session_inline_fetch_option(html, "method")
                    val inline_method = if inline_method_raw != "": inline_method_raw.upper() else: "GET"
                    val inline_body = _browser_session_inline_fetch_option(html, "body")
                    val inline_credentials_raw = _browser_session_inline_fetch_option(html, "credentials").trim().lower()
                    val inline_credentials = if (inline_credentials_raw == "omit" or
                        inline_credentials_raw == "include"):
                        inline_credentials_raw
                    else:
                        "same-origin"
                    self.pending_requests.push(self._build_request(
                        "fetch", resolved_fetch_url, inline_method, "",
                        inline_body, "", inline_credentials
                    ))
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] active load created"
        self._advance_stylesheet_loading()

    me _ensure_runtime_state() -> BrowserRuntimeState?:
        if not self.runtime_enabled:
            return nil
        if val Some(state) = self.runtime_state:
            return Some(state)
        val cookie_text = self._script_cookie_for_url(self.document_url)
        var state = BrowserRuntimeState.create(
            self.document_url,
            self.current_title,
            self.current_body_html,
            self.session_storage,
            self.local_storage,
            cookie_text
        )
        state.runtime.interpreter.next_async_request_seq = self.next_request_seq
        state.runtime.interpreter.timer_current_time_ms = self.monotonic_time_ms
        state.runtime.interpreter.timer_time_origin_ms = self.animation_start_time_ms
        state.bind_dom(self.current_dom)
        self.runtime_state = Some(state)
        Some(state)

    me _sync_from_runtime(state: BrowserRuntimeState):
        var title_val = state.runtime.interpreter.host_document_title_value
        if strict_equals(title_val, JsValue.Undefined):
            title_val = state.runtime.get_host_property(
                state.document_id,
                "title"
            )
        match title_val:
            JsValue.String(title):
                if title.len() > 0:
                    self.current_title = title
            _:
                pass_dn

        val old_url = self.current_url
        val active_document_url = self.document_url
        var navigation_mode = ""
        val navigation_mode_val = state.runtime.get_host_property(
            state.location_id,
            "__simple_navigation_mode"
        )
        match navigation_mode_val:
            JsValue.String(mode):
                navigation_mode = mode
                state.runtime.set_host_property(
                    state.location_id,
                    "__simple_navigation_mode",
                    JsValue.String(v: "")
                )
            _:
                pass_dn
        val history_mode_val = state.runtime.get_host_property(
            state.history_id,
            "__simple_navigation_mode"
        )
        match history_mode_val:
            JsValue.String(mode):
                if mode != "":
                    navigation_mode = mode
                state.runtime.set_host_property(
                    state.history_id,
                    "__simple_navigation_mode",
                    JsValue.String(v: "")
                )
            _:
                pass_dn

        val href_val = state.runtime.get_host_property(
            state.location_id,
            "href"
        )
        match href_val:
            JsValue.String(href):
                if href.len() > 0:
                    var next_href = resolve_relative_url(
                        active_document_url, href
                    )
                    if navigation_mode == "pushState" or navigation_mode == "replaceState":
                        var history_url_val = state.runtime.get_host_property(
                            state.location_id,
                            "__simple_history_url"
                        )
                        if strict_equals(history_url_val, JsValue.Undefined):
                            history_url_val = state.runtime.get_host_property(
                                state.history_id,
                                "__simple_url"
                            )
                        match history_url_val:
                            JsValue.String(history_url):
                                if history_url.len() > 0:
                                    val candidate = resolve_relative_url(
                                        active_document_url, history_url
                                    )
                                    val document_origin = url_origin(active_document_url)
                                    if (
                                        document_origin != "" and
                                        url_origin(candidate) == document_origin and
                                        rt_text_to_bytes(candidate).len() <= 8192
                                    ):
                                        next_href = candidate
                                    else:
                                        next_href = active_document_url
                                        navigation_mode = ""
                                        self._append_warning(
                                            "invalid history URL blocked"
                                        )
                            _:
                                pass_dn
                        val history_state_val = state.runtime.get_host_property(
                            state.location_id,
                            "__simple_history_state"
                        )
                        if (
                            navigation_mode != "" and
                            not strict_equals(history_state_val, JsValue.Undefined)
                        ):
                            state.runtime.set_host_property(
                                state.history_id,
                                "state",
                                history_state_val
                            )
                        state.runtime.set_host_property(
                            state.location_id,
                            "__simple_history_url",
                            JsValue.String(v: "")
                        )
                    self.current_url = next_href
                    if navigation_mode == "pushState" or navigation_mode == "replaceState":
                        self.document_url = next_href
                    browser_session_sync_location_object(state, next_href)
                    state.runtime.set_host_property(
                        state.document_id,
                        "URL",
                        JsValue.String(v: next_href)
                    )
                    if navigation_mode == "assign" and next_href != old_url:
                        self._push_runtime_history_entry()
                    else if navigation_mode == "pushState":
                        self._push_runtime_history_entry()
            _:
                pass_dn

        # Track whether the latest body mutation came from script setting innerHTML or
        # textContent. Page load primes both host_body_*_value fields directly (not via
        # eval), so the values alone can't tell us which a script most recently wrote;
        # the dirty flags do. Setting innerHTML by script clears the textContent dirty
        # flag (and vice-versa) so this resolves to last-write-wins, matching the DOM.
        val inner_html_dirty = state.runtime.interpreter.host_body_inner_html_dirty
        val text_content_dirty = state.runtime.interpreter.host_body_text_content_dirty
        var inner_html_val = state.runtime.interpreter.host_body_inner_html_value
        if strict_equals(inner_html_val, JsValue.Undefined):
            inner_html_val = state.runtime.get_host_property(
                state.body_id,
                "innerHTML"
            )
        var text_content_val = state.runtime.interpreter.host_body_text_content_value
        if strict_equals(text_content_val, JsValue.Undefined):
            text_content_val = state.runtime.get_host_property(
                state.body_id,
                "textContent"
            )

        var next_body_html = self.current_body_html
        match inner_html_val:
            JsValue.String(body_html):
                next_body_html = body_html
            _:
                pass_dn

        # textContent overrides the resolved innerHTML only when a script explicitly set
        # textContent more recently than innerHTML, or when neither was script-set (the
        # page-load values are mutually consistent). This stops a stale page-load
        # textContent from clobbering a freshly script-assigned innerHTML.
        if text_content_dirty or not inner_html_dirty:
            match text_content_val:
                JsValue.String(body_text):
                    val rendered_text = escape_html_text(body_text)
                    if rendered_text != escape_html_text(html_to_text(next_body_html)):
                        next_body_html = rendered_text
                _:
                    pass_dn

        val body_changed = next_body_html != self.current_body_html
        self.current_body_html = next_body_html
        if body_changed:
            self._replace_current_body_children(next_body_html)
        val bridge_changed = (
            state.runtime.interpreter.host_dom_bridge_generation !=
            state.dom_bridge_generation
        )
        val dom_mutation_changed = (
            state.runtime.interpreter.host_dom_mutation_generation !=
            state.dom_mutation_generation
        )
        if body_changed or bridge_changed:
            if not state.adopt_dom_bridge(self.current_dom):
                state.bind_dom(self.current_dom)
        if body_changed or bridge_changed or dom_mutation_changed:
            val dom_sync = state.sync_dom(self.current_dom)
            if dom_sync.changed:
                self.current_dom = dom_sync.root
                self._advance_ui_access_revision()
                self._sync_body_html_from_dom()
                val synced_body_text = html_to_text(self.current_body_html)
                state.runtime.set_host_property(
                    state.body_id, "innerHTML",
                    JsValue.String(v: self.current_body_html)
                )
                state.runtime.set_host_property(
                    state.body_id, "textContent",
                    JsValue.String(v: synced_body_text)
                )
                var synced_interpreter = state.runtime.interpreter
                synced_interpreter.host_body_inner_html_value = JsValue.String(
                    v: self.current_body_html
                )
                synced_interpreter.host_body_text_content_value = JsValue.String(
                    v: synced_body_text
                )
                synced_interpreter.host_body_inner_html_dirty = false
                synced_interpreter.host_body_text_content_dirty = false
                state.runtime.interpreter = synced_interpreter
            state.dom_mutation_generation = (
                state.runtime.interpreter.host_dom_mutation_generation
            )
            self._mark_css_animation_reconcile(
                body_changed
            )
        self.session_storage = storage_pairs_from_object(state, state.session_storage_id)
        self.local_storage = storage_pairs_from_object(state, state.local_storage_id)
        self._persist_storage_for_url(active_document_url)
        state.runtime = sync_storage_runtime_state(state.runtime, state.session_storage_id, self.session_storage)
        state.runtime = sync_storage_runtime_state(state.runtime, state.local_storage_id, self.local_storage)

        var cookie_interpreter = state.runtime.interpreter
        if cookie_interpreter.host_document_cookie_write_overflow:
            self.script_cookie_write_overflow = true
            cookie_interpreter.host_document_cookie_write_overflow = false
        val cookie_writes = (
            cookie_interpreter.pending_host_document_cookie_writes
        )
        cookie_interpreter.pending_host_document_cookie_writes = []
        state.runtime.interpreter = cookie_interpreter
        for cookie_write in cookie_writes:
            self._store_cookie_text(
                cookie_write, active_document_url, false
            )

        var cookie_val = state.runtime.interpreter.host_document_cookie_value
        if strict_equals(cookie_val, JsValue.Undefined):
            cookie_val = state.runtime.get_host_property(
                state.document_id,
                "cookie"
            )
        match cookie_val:
            JsValue.String(cookie_text):
                val visible_cookie_before_sync = self._script_cookie_for_url(active_document_url)
                if (cookie_writes.len() == 0 and
                    cookie_text != visible_cookie_before_sync):
                    self._store_cookie_text(cookie_text, active_document_url, false)
            _:
                pass_dn

        val visible_cookie_text = self._script_cookie_for_url(active_document_url)
        var runtime = state.runtime
        var interpreter = runtime.interpreter
        interpreter.host_document_cookie_value = JsValue.String(v: visible_cookie_text)
        runtime.interpreter = interpreter
        state.runtime = runtime
        state.runtime.set_host_property(
            state.document_id,
            "readyState",
            JsValue.String(v: "complete")
        )

    me _push_runtime_history_entry():
        var source_html = self.source_html
        if self.current_index >= 0 and self.current_index < self.history.len():
            source_html = self.history[self.current_index].source_html
        val entry = BrowserHistoryEntry.create_with_policy(
            url: self.current_url,
            title: self.current_title,
            source_html: source_html,
            policy: self.content_security_policy
        )
        self.history = browser_history_push_bounded(
            self.history, self.current_index, entry
        )
        self.current_index = self.history.len() - 1

    me _sync_runtime_cookie_string():
        if val Some(state) = self.runtime_state:
            val visible_cookie_text = self._script_cookie_for_url(self.document_url)
            var runtime = state.runtime
            var interpreter = runtime.interpreter
            interpreter.host_document_cookie_value = JsValue.String(v: visible_cookie_text)
            runtime.interpreter = interpreter
            runtime.set_host_property(
                state.document_id,
                "cookie",
                JsValue.String(v: visible_cookie_text)
            )
            state.runtime = runtime
            self.runtime_state = Some(state)

    me _build_request(
        kind: text, url: text, method: text, headers: text, body: text,
        content_type: text, credentials: text = "include"
    ) -> BrowserRequest:
        val request_url = self._hsts_upgrade_url(url)
        val normalized_method = if method.trim() != "": method.upper() else: "GET"
        val site_for_cookies_url = self.document_url
        val is_top_level_navigation = kind == "document"
        val request_headers = self._headers_with_session_cookie(
            headers, request_url, normalized_method, site_for_cookies_url,
            is_top_level_navigation, credentials
        )
        val request_id = "{kind}-{self.next_request_seq}"
        self.next_request_seq = self.next_request_seq + 1
        val request = BrowserRequest.create(
            id: request_id,
            kind: kind,
            url: request_url,
            method: normalized_method,
            headers: request_headers,
            body: body,
            content_type: content_type
        )
        request.site_for_cookies_url = site_for_cookies_url
        request.credentials = credentials
        request.is_top_level_navigation = is_top_level_navigation
        request.script_cookie_writes = self.take_pending_script_cookie_writes()
        request

fn browser_session_sync_location_object(state: BrowserRuntimeState, href: text):
    state.runtime.set_host_property(state.location_id, "href", JsValue.String(v: href))
    state.runtime.set_host_property(state.location_id, "protocol", JsValue.String(v: url_protocol(href)))
    state.runtime.set_host_property(state.location_id, "host", JsValue.String(v: url_host(href)))
    state.runtime.set_host_property(state.location_id, "origin", JsValue.String(v: url_origin(href)))
    state.runtime.set_host_property(state.location_id, "pathname", JsValue.String(v: url_pathname(href)))
    state.runtime.set_host_property(state.location_id, "search", JsValue.String(v: url_search(href)))
    state.runtime.set_host_property(state.location_id, "hash", JsValue.String(v: url_hash(href)))
