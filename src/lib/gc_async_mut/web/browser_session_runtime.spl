extern fn rt_text_to_bytes(value: text) -> [u8]

val BROWSER_STORAGE_MAX_ORIGINS: i32 = 64
val BROWSER_STORAGE_MAX_RETAINED_BYTES: i64 = 16777216
val BROWSER_INLINE_STYLE_MAX_DEPTH: i32 = 256

fn _queue_inline_style_background_images(
    node: BeDomNode, load: BrowserLoadState, document_url: text, depth: i32,
    csp_policy: text
):
    if depth >= BROWSER_INLINE_STYLE_MAX_DEPTH:
        load.append_warning(
            "inline style discovery depth limit reached"
        )
        return
    val inline_style = be_dom_get_attr(node, "style").trim()
    if inline_style != "":
        load._queue_background_image_sources(
            inline_style, document_url, false, csp_policy, -1, node.node_id
        )
    for child in node.children:
        _queue_inline_style_background_images(
            child, load, document_url, depth + 1, csp_policy
        )

fn _bind_next_body_image_source(
    mut sources: [BrowserImageSource], source_index: i64,
    body_source_start: i64, resolved_url: text, node_id: i64,
    node_kind: text
) -> i64:
    var index = source_index
    while index < sources.len():
        val source = sources[index]
        if (
            source.source_offset >= body_source_start and
            source.resolved_url == resolved_url
        ):
            sources[index] = source.with_render_node(node_id, node_kind)
            return index + 1
        index = index + 1
    source_index

fn _bind_body_image_source_nodes(
    node: BeDomNode, document_url: text,
    mut sources: [BrowserImageSource], source_index: i64,
    body_source_start: i64
) -> i64:
    var next_index = source_index
    if node.tag_name == "img" or node.tag_name == "video":
        val node_kind = if node.tag_name == "video": "poster" else: "src"
        val authored = be_dom_get_attr(node, node_kind).trim()
        if authored != "":
            next_index = _bind_next_body_image_source(
                sources, next_index, body_source_start,
                collapse_url_dot_segments(
                    resolve_relative_url(document_url, authored)
                ),
                node.node_id, node_kind
            )
    val inline_style = be_dom_get_attr(node, "style").trim()
    if inline_style != "":
        for authored in _css_background_image_urls(inline_style):
            next_index = _bind_next_body_image_source(
                sources, next_index, body_source_start,
                collapse_url_dot_segments(
                    resolve_relative_url(document_url, authored)
                ),
                node.node_id, "background"
            )
    for child in node.children:
        next_index = _bind_body_image_source_nodes(
            child, document_url, sources, next_index, body_source_start
        )
    next_index

fn _set_node_image_render_key(
    node: BeDomNode, target_node_id: i64, node_kind: text,
    resolved_url: text, render_resource_key: text, document_url: text
) -> BeDomNode:
    var next = node
    if next.node_id == target_node_id:
        if node_kind == "src":
            next.set_attr(
                "\u0000simple-render-image-src", render_resource_key
            )
        elif node_kind == "poster":
            next.set_attr(
                "\u0000simple-render-image-poster", render_resource_key
            )
        elif node_kind == "background":
            val authored_style = be_dom_get_attr(next, "style")
            val hidden_style = be_dom_get_attr(
                next, "\u0000simple-render-image-style"
            )
            val render_style = if hidden_style != "":
                hidden_style
            else:
                authored_style
            next.set_attr(
                "\u0000simple-render-image-style",
                bind_render_background_url(
                    render_style, document_url, resolved_url,
                    render_resource_key
                )
            )
        return next
    var children: [BeDomNode] = []
    for child in next.children:
        children.push(_set_node_image_render_key(
            child, target_node_id, node_kind, resolved_url,
            render_resource_key, document_url
        ))
    next.children = children
    next

fn _browser_session_previous_utf8_boundary(value: text, index: i64) -> i64:
    val bytes = rt_text_to_bytes(value)
    if index <= 0 or bytes.len() == 0:
        return 0
    var previous = if index > bytes.len(): bytes.len() - 1 else: index - 1
    while previous > 0 and (bytes[previous] & 0xC0u8) == 0x80u8:
        previous = previous - 1
    previous

fn _browser_session_next_utf8_boundary(value: text, index: i64) -> i64:
    val bytes = rt_text_to_bytes(value)
    if index < 0:
        return 0
    if index >= bytes.len():
        return bytes.len()
    var next = index + 1
    while next < bytes.len() and (bytes[next] & 0xC0u8) == 0x80u8:
        next = next + 1
    next

fn _browser_session_is_utf8_boundary(value: text, index: i64) -> bool:
    if not text_is_valid_utf8(value):
        return false
    val bytes = rt_text_to_bytes(value)
    index == bytes.len() or (
        index >= 0 and index < bytes.len() and
        (bytes[index] & 0xC0u8) != 0x80u8
    )

fn _browser_session_text_control_value(target: BeDomNode) -> text:
    if target.tag_name == "input":
        return be_dom_get_attr(target, "value")
    if target.tag_name == "textarea":
        return html_to_text(be_dom_serialize_children(target))
    ""

fn _browser_session_parse_maxlength(raw: text) -> i64?:
    val value = raw.trim()
    if value == "":
        return nil
    var index: i64 = 0
    if value[0] == "+":
        index = 1
    elif value[0] == "-":
        return nil
    var parsed: i64 = 0
    var digits: i64 = 0
    while index < value.len():
        val digit = digit_value(value[index])
        if digit < 0:
            break
        if parsed > 115292150460684697:
            return nil
        parsed = parsed * 10
        if parsed > 1152921504606846975 - digit:
            return nil
        parsed = parsed + digit
        digits = digits + 1
        index = index + 1
    if digits == 0:
        return nil
    parsed

fn _browser_session_utf16_units(value: text) -> i64:
    val bytes = value.bytes()
    var offset: i64 = 0
    var units: i64 = 0
    while offset < bytes.len():
        val decoded = utf8_decode_one(bytes, offset)
        val consumed = decoded[1]
        if consumed <= 0:
            return units
        units = units + (if decoded[0] > 0xFFFF: 2 else: 1)
        offset = offset + consumed
    units

fn _browser_session_utf16_prefix(value: text, limit: i64) -> text:
    if limit <= 0:
        return ""
    val bytes = value.bytes()
    var offset: i64 = 0
    var units: i64 = 0
    while offset < bytes.len():
        val decoded = utf8_decode_one(bytes, offset)
        val consumed = decoded[1]
        if consumed <= 0:
            break
        val next_units = units + (if decoded[0] > 0xFFFF: 2 else: 1)
        if next_units > limit:
            break
        units = next_units
        offset = offset + consumed
    if offset >= bytes.len():
        return value
    value.slice(0, offset)

fn _browser_session_text_maxlength(target: BeDomNode) -> i64?:
    if not be_dom_has_attr(target, "maxlength"):
        return nil
    if target.tag_name == "textarea":
        return _browser_session_parse_maxlength(
            be_dom_get_attr(target, "maxlength")
        )
    if target.tag_name != "input":
        return nil
    val input_type = be_dom_get_attr(target, "type").lower()
    if not (
        input_type == "" or input_type == "text" or
        input_type == "search" or input_type == "url" or
        input_type == "tel" or input_type == "email" or
        input_type == "password"
    ):
        return nil
    _browser_session_parse_maxlength(be_dom_get_attr(target, "maxlength"))

pub fn dom_text_control_selectable(target: BeDomNode) -> bool:
    if be_dom_has_attr(target, "disabled"):
        return false
    if target.tag_name != "input" and target.tag_name != "textarea":
        return false
    if not text_is_valid_utf8(_browser_session_text_control_value(target)):
        return false
    if target.tag_name == "textarea":
        return true
    val input_type = be_dom_get_attr(target, "type").lower()
    input_type == "" or input_type == "text" or input_type == "search" or
        input_type == "url" or input_type == "tel" or
        input_type == "email" or input_type == "password" or
        input_type == "number"

pub fn dom_text_control_mutable(target: BeDomNode) -> bool:
    dom_text_control_selectable(target) and
        not be_dom_has_attr(target, "readonly")

fn browser_storage_origin_key(url: text) -> text:
    val origin = url_origin(url)
    if origin != "":
        return origin
    url

fn browser_storage_entries_for_origin(
    buckets: [BrowserOriginStorage], origin: text
) -> [Pair<text, text>]:
    for bucket in buckets:
        if bucket.origin == origin:
            return bucket.entries
    []

fn browser_storage_bucket_retained_bytes(
    bucket: BrowserOriginStorage
) -> i64:
    var retained = bucket.origin.len()
    for entry in bucket.entries:
        val entry_bytes = entry.first.len() + entry.second.len()
        if entry_bytes > BROWSER_STORAGE_MAX_RETAINED_BYTES - retained:
            return BROWSER_STORAGE_MAX_RETAINED_BYTES + 1
        retained = retained + entry_bytes
    retained

fn browser_storage_replace_origin(
    buckets: [BrowserOriginStorage],
    origin: text,
    entries: [Pair<text, text>]
) -> [BrowserOriginStorage]:
    var candidates: [BrowserOriginStorage] = []
    for bucket in buckets:
        if bucket.origin != origin and bucket.entries.len() > 0:
            candidates.push(bucket)
    if entries.len() > 0:
        candidates.push(BrowserOriginStorage(origin: origin, entries: entries))

    var start = candidates.len()
    var retained_origins = 0
    var retained_bytes: i64 = 0
    while start > 0 and retained_origins < BROWSER_STORAGE_MAX_ORIGINS:
        val bucket_bytes = browser_storage_bucket_retained_bytes(
            candidates[start - 1]
        )
        if bucket_bytes > BROWSER_STORAGE_MAX_RETAINED_BYTES - retained_bytes:
            break
        start = start - 1
        retained_origins = retained_origins + 1
        retained_bytes = retained_bytes + bucket_bytes

    var retained: [BrowserOriginStorage] = []
    while start < candidates.len():
        retained.push(candidates[start])
        start = start + 1
    retained

fn _browser_session_dom_node_count(node: BeDomNode) -> i32:
    var count = 1
    for child in node.children:
        count = count + _browser_session_dom_node_count(child)
    count

fn _browser_session_replace_body_children(
    node: BeDomNode, children: [BeDomNode]
) -> BeDomNode:
    if node.tag_name == "body":
        return be_dom_set_children(node, children)
    var next_children: [BeDomNode] = []
    for child in node.children:
        next_children.push(_browser_session_replace_body_children(
            child, children
        ))
    be_dom_set_children(node, next_children)

fn _browser_session_dom_action(action: text) -> bool:
    action.starts_with("set-text:") or action.starts_with("set-attr:") or
        action.starts_with("remove-attr:") or action.starts_with("add-class:") or
        action.starts_with("remove-class:") or action.starts_with("toggle-class:")

fn _browser_session_event_control(action: text) -> bool:
    action == "prevent-default" or action == "stop-propagation" or
        action == "stop-immediate-propagation"

val BROWSER_DOM_CALLABLE_TOKEN = "\u{0000}js-listener:"
val BROWSER_DOM_DISPATCH_LISTENER_MAX: i32 = 4096

fn _browser_session_same_callable(left: JsValue, right: JsValue) -> bool:
    match left:
        JsValue.Function(left_id):
            match right:
                JsValue.Function(right_id): left_id == right_id
                _: false
        _: false

fn _browser_session_object_id_for_node(
    state: BrowserRuntimeState, node: BeDomNode
) -> i64:
    if node.tag_name == "window":
        return state.window_id
    if node.tag_name == "#document":
        return state.document_id
    var index = 0
    while index < state.dom_node_ids.len():
        if state.dom_node_ids[index] == node.node_id:
            return state.dom_element_ids[index]
        index = index + 1
    -1

fn _browser_session_add_callable_tokens(
    node: BeDomNode, state: BrowserRuntimeState, event_type: text
) -> BeDomNode:
    var next = node
    val object_id = _browser_session_object_id_for_node(state, node)
    var index = 0
    while index < state.dom_callable_listeners.len():
        val listener = state.dom_callable_listeners[index]
        if (
            listener.event_type == event_type and
            listener.target_object_id == object_id
        ):
            next.add_event_listener_with_capture(
                event_type, BROWSER_DOM_CALLABLE_TOKEN + "{index}",
                listener.capture
            )
        index = index + 1
    next

fn _browser_session_callable_dispatch_root(
    path: [BeDomNode], state: BrowserRuntimeState, event_type: text
) -> BeDomNode:
    var child = _browser_session_add_callable_tokens(
        path[path.len() - 1], state, event_type
    )
    child.children = path[path.len() - 1].children
    var index = path.len() - 2
    while index >= 0:
        var parent = _browser_session_add_callable_tokens(
            path[index], state, event_type
        )
        parent.children = [child]
        child = parent
        index = index - 1
    var window_node = child
    window_node.node_id = -2
    window_node.tag_name = "window"
    window_node.data = ""
    window_node.parent_id = -1
    window_node.children = [child]
    window_node.event_listener_types = []
    window_node.event_listener_actions = []
    window_node.event_listener_capture = []
    _browser_session_add_callable_tokens(window_node, state, event_type)

fn _browser_session_js_bool(runtime: JsRuntime, object_id: i64, key: text) -> bool:
    match runtime.get_host_property(object_id, key):
        JsValue.Boolean(value): value
        _: false

class BrowserDomEventExecutor:
    runtime: JsRuntime
    listeners: [BrowserDomCallableListener]
    dispatch_active: [bool]
    node_ids: [i64]
    element_ids: [i64]
    window_id: i64
    document_id: i64
    target_object_id: i64
    event_object_id: i64
    event_prevent_default_fn_id: i64
    event_stop_propagation_fn_id: i64
    event_stop_immediate_propagation_fn_id: i64
    error: text

    me drain_listener_ops():
        var interpreter = self.runtime.interpreter
        val count = interpreter.pending_host_event_ops.len()
        var op_index = 0
        while op_index < count:
            val operation = interpreter.pending_host_event_ops[op_index]
            val target_id =
                interpreter.pending_host_event_target_ids[op_index]
            val event_type =
                interpreter.pending_host_event_types[op_index]
            val callback =
                interpreter.pending_host_event_callbacks[op_index]
            val capture =
                interpreter.pending_host_event_captures[op_index]
            val once =
                interpreter.pending_host_event_once_flags[op_index]
            var matching = -1
            var tombstone = -1
            var listener_index = 0
            while listener_index < self.listeners.len():
                val listener = self.listeners[listener_index]
                if (
                    listener.event_type == event_type and
                    listener.target_object_id == target_id and
                    _browser_session_same_callable(
                        listener.callback, callback
                    ) and
                    listener.capture == capture
                ):
                    matching = listener_index
                if tombstone < 0 and listener.event_type == "":
                    tombstone = listener_index
                listener_index = listener_index + 1
            if operation == "remove" and matching >= 0:
                self.listeners[matching].event_type = ""
                self.listeners[matching].callback = JsValue.Undefined
                self.dispatch_active[matching] = false
            elif operation == "add" and matching < 0:
                val added = BrowserDomCallableListener(
                    target_object_id: target_id,
                    event_type: event_type,
                    callback: callback,
                    capture: capture,
                    once: once
                )
                if tombstone >= 0:
                    self.listeners[tombstone] = added
                    # This slot was not active in the frozen token snapshot.
                    self.dispatch_active[tombstone] = false
                elif (
                    self.listeners.len() < BROWSER_DOM_DISPATCH_LISTENER_MAX
                ):
                    self.listeners.push(added)
                    self.dispatch_active.push(false)
            op_index = op_index + 1
        interpreter.pending_host_event_ops = []
        interpreter.pending_host_event_target_ids = []
        interpreter.pending_host_event_types = []
        interpreter.pending_host_event_callbacks = []
        interpreter.pending_host_event_captures = []
        interpreter.pending_host_event_once_flags = []
        self.runtime.interpreter = interpreter

    me finish_event():
        if self.event_object_id < 0:
            return
        self.runtime.set_host_property(
            self.event_object_id, "currentTarget", JsValue.Null
        )
        self.runtime.set_host_property(
            self.event_object_id, "eventPhase", JsValue.Number(v: 0.0)
        )

    me object_id_for_node(node: BeDomNode) -> i64:
        if node.tag_name == "window":
            return self.window_id
        if node.tag_name == "#document":
            return self.document_id
        var index = 0
        while index < self.node_ids.len():
            if self.node_ids[index] == node.node_id:
                return self.element_ids[index]
            index = index + 1
        -1

    me ensure_event(event: BeDomEvent):
        if self.event_object_id >= 0:
            return
        val event_id = self.runtime.create_host_object()
        self.runtime.set_host_property(
            event_id, "type", JsValue.String(v: event.event_type)
        )
        self.runtime.set_host_property(
            event_id, "target", JsValue.Object(id: self.target_object_id)
        )
        self.runtime.set_host_property(
            event_id, "bubbles", JsValue.Boolean(v: event.bubbles)
        )
        self.runtime.set_host_property(
            event_id, "cancelable", JsValue.Boolean(v: event.cancelable)
        )
        self.runtime.set_host_property(
            event_id, "key", JsValue.String(v: event.key)
        )
        self.runtime.set_host_property(
            event_id, "code", JsValue.String(v: event.code)
        )
        self.runtime.set_host_property(
            event_id, "shiftKey", JsValue.Boolean(v: event.shift_key)
        )
        self.runtime.set_host_property(
            event_id, "altKey", JsValue.Boolean(v: event.alt_key)
        )
        self.runtime.set_host_property(
            event_id, "ctrlKey", JsValue.Boolean(v: event.ctrl_key)
        )
        self.runtime.set_host_property(
            event_id, "metaKey", JsValue.Boolean(v: event.meta_key)
        )
        self.runtime.set_host_property(
            event_id, "repeat", JsValue.Boolean(v: event.repeat)
        )
        if event.input_type != "":
            val input_data = match event.input_data:
                Some(value): JsValue.String(v: value)
                nil: JsValue.Null
            self.runtime.set_host_property(event_id, "data", input_data)
            self.runtime.set_host_property(
                event_id, "inputType", JsValue.String(v: event.input_type)
            )
            self.runtime.set_host_property(
                event_id, "isComposing",
                JsValue.Boolean(v: event.is_composing)
            )
        self.runtime.set_host_property(
            event_id, "defaultPrevented", JsValue.Boolean(v: false)
        )
        self.runtime.set_host_property(
            event_id, "propagationStopped", JsValue.Boolean(v: false)
        )
        self.runtime.set_host_property(
            event_id, "immediatePropagationStopped",
            JsValue.Boolean(v: false)
        )
        self.runtime.set_host_property(
            event_id, "preventDefault",
            JsValue.Function(id: self.event_prevent_default_fn_id)
        )
        self.runtime.set_host_property(
            event_id, "stopPropagation",
            JsValue.Function(id: self.event_stop_propagation_fn_id)
        )
        self.runtime.set_host_property(
            event_id, "stopImmediatePropagation",
            JsValue.Function(id: self.event_stop_immediate_propagation_fn_id)
        )
        var interpreter = self.runtime.interpreter
        interpreter.define_global_value(
            "event", JsValue.Object(id: event_id)
        )
        self.runtime.interpreter = interpreter
        self.event_object_id = event_id

    me execute(
        event: BeDomEvent, node: BeDomNode, action: text, phase: text
    ) -> BeDomEvent:
        var next = event
        if action == "prevent-default":
            next.prevent_default()
            return next
        if action == "stop-propagation":
            next.stop_propagation()
            return next
        if action == "stop-immediate-propagation":
            next.stop_immediate_propagation()
            return next
        if _browser_session_dom_action(action):
            return next
        self.ensure_event(next)
        val current_target_id = self.object_id_for_node(node)
        self.runtime.set_host_property(
            self.event_object_id, "currentTarget",
            JsValue.Object(id: current_target_id)
        )
        val event_phase = if phase == "capture":
            1.0
        elif phase == "target":
            2.0
        else:
            3.0
        self.runtime.set_host_property(
            self.event_object_id, "eventPhase",
            JsValue.Number(v: event_phase)
        )
        if action.starts_with(BROWSER_DOM_CALLABLE_TOKEN):
            val index = action.substring(
                BROWSER_DOM_CALLABLE_TOKEN.len(), action.len()
            ).to_i64() ?? -1
            if index >= 0 and index < self.listeners.len():
                val listener = self.listeners[index]
                if (
                    self.dispatch_active[index] and
                    listener.event_type == next.event_type
                ):
                    val callback = listener.callback
                    if listener.once:
                        self.listeners[index].event_type = ""
                        self.listeners[index].callback = JsValue.Undefined
                        self.listeners[index].once = false
                        self.dispatch_active[index] = false
                    val invoked = self.runtime.invoke_callable_with_this(
                        callback,
                        [JsValue.Object(id: self.event_object_id)],
                        JsValue.Object(id: current_target_id)
                    )
                    if val Err(e) = invoked:
                        self.error = e.message
                    self.drain_listener_ops()
        else:
            val evaluated = self.runtime.eval(action)
            if val Err(e) = evaluated:
                self.error = e.message
            self.drain_listener_ops()
        next.default_prevented = _browser_session_js_bool(
            self.runtime, self.event_object_id, "defaultPrevented"
        )
        next.propagation_stopped = _browser_session_js_bool(
            self.runtime, self.event_object_id, "propagationStopped"
        )
        next.immediate_propagation_stopped = _browser_session_js_bool(
            self.runtime, self.event_object_id,
            "immediatePropagationStopped"
        )
        next

fn _browser_session_focus_default(action: text) -> bool:
    action == "focus-element" or action == "button-activate" or
        action == "input-checkbox-toggle" or action == "input-radio-select" or
        action == "form-reset"

fn _browser_session_checkable_default(action: text) -> bool:
    action == "input-checkbox-toggle" or
        action == "input-radio-select"

fn _browser_session_dom_route_id(root: BeDomNode, target_id: text) -> text:
    val path = be_dom_find_path_to_id(root, target_id)
    if path.len() == 0:
        return target_id
    be_dom_route_identity(path[path.len() - 1])

fn _browser_session_replace_dom_path(
    path: [BeDomNode], replacement: BeDomNode
) -> BeDomNode:
    var next = replacement
    var ancestor = path.len() - 2
    while ancestor >= 0:
        val parent = path[ancestor]
        var children: [BeDomNode] = []
        for child in parent.children:
            if child.node_id == next.node_id:
                children.push(next)
            else:
                children.push(child)
        next = be_dom_set_children(parent, children)
        ancestor = ancestor - 1
    next

fn _browser_session_checkable_click_action(
    root: BeDomNode, target_id: text, event_type: text
) -> text:
    if event_type != "click":
        return ""
    val path = be_dom_find_path_to_id(root, target_id)
    if path.len() == 0:
        return ""
    val target = path[path.len() - 1]
    if target.tag_name != "input" or be_dom_has_attr(target, "disabled"):
        return ""
    match be_dom_get_attr(target, "type").lower():
        "checkbox": "input-checkbox-toggle"
        "radio": "input-radio-select"
        _: ""

fn _browser_session_accepts_implicit_submit(target: BeDomNode) -> bool:
    if target.tag_name != "input" or be_dom_has_attr(target, "disabled") or
       be_dom_has_attr(target, "readonly"):
        return false
    be_dom_input_blocks_implicit_submission(target)

fn storage_pairs_from_object(state: BrowserRuntimeState, object_id: i64) -> [Pair<text, text>]:
    val obj = state.runtime.get_host_object(object_id)
    var out: [Pair<text, text>] = []
    for prop in obj.properties:
        if is_storage_internal_property(prop.key):
            out = upsert_pair(out, storage_public_key_from_internal(prop.key), js_value_to_storage_text(prop.value))
        else if not is_storage_api_property(prop.key):
            out = upsert_pair(out, prop.key, js_value_to_storage_text(prop.value))
    out

fn browser_dom_keyboard_key(key_code: i64, shift_key: bool) -> text:
    if key_code >= 65 and key_code <= 90:
        return if shift_key:
            key_code.to_char()
        else:
            (key_code + 32).to_char()
    if key_code >= 48 and key_code <= 57:
        if not shift_key:
            return key_code.to_char()
        match key_code:
            48: ")"
            49: "!"
            50: "@"
            51: "#"
            52: "$"
            53: "%"
            54: "^"
            55: "&"
            56: "*"
            _: "("
    if key_code >= 112 and key_code <= 123:
        return "F" + (key_code - 111).to_text()
    match key_code:
        8: "Backspace"
        9: "Tab"
        13: "Enter"
        16: "Shift"
        17: "Control"
        18: "Alt"
        27: "Escape"
        32: " "
        33: "PageUp"
        34: "PageDown"
        35: "End"
        36: "Home"
        37: "ArrowLeft"
        38: "ArrowUp"
        39: "ArrowRight"
        40: "ArrowDown"
        45: "Insert"
        46: "Delete"
        91: "Meta"
        127: "Delete"
        186: if shift_key: ":" else: ";"
        187: if shift_key: "+" else: "="
        188: if shift_key: "<" else: ","
        189: if shift_key: "_" else: "-"
        190: if shift_key: ">" else: "."
        191: if shift_key: "?" else: "/"
        192: if shift_key: "~" else: "`"
        219: if shift_key: "{" else: "["
        220: if shift_key: "|" else: "\\"
        221: if shift_key: "}" else: "]"
        222: if shift_key: "\"" else: "'"
        _: "Unidentified"

fn browser_dom_keyboard_code(key_code: i64) -> text:
    if key_code >= 65 and key_code <= 90:
        return "Key" + key_code.to_char()
    if key_code >= 48 and key_code <= 57:
        return "Digit" + key_code.to_char()
    if key_code >= 112 and key_code <= 123:
        return "F" + (key_code - 111).to_text()
    match key_code:
        8: "Backspace"
        9: "Tab"
        13: "Enter"
        16: "ShiftLeft"
        17: "ControlLeft"
        18: "AltLeft"
        27: "Escape"
        32: "Space"
        33: "PageUp"
        34: "PageDown"
        35: "End"
        36: "Home"
        37: "ArrowLeft"
        38: "ArrowUp"
        39: "ArrowRight"
        40: "ArrowDown"
        45: "Insert"
        46: "Delete"
        91: "MetaLeft"
        127: "Delete"
        186: "Semicolon"
        187: "Equal"
        188: "Comma"
        189: "Minus"
        190: "Period"
        191: "Slash"
        192: "Backquote"
        219: "BracketLeft"
        220: "Backslash"
        221: "BracketRight"
        222: "Quote"
        _: "Unidentified"

fn browser_dom_keyboard_code_from_key(key: text) -> text:
    if key == " ":
        return "Space"
    val normalized = key.trim().lower()
    match normalized:
        "space": "Space"
        "spacebar": "Space"
        "8": "Backspace"
        "backspace": "Backspace"
        "9": "Tab"
        "tab": "Tab"
        "13": "Enter"
        "enter": "Enter"
        "return": "Enter"
        "27": "Escape"
        "escape": "Escape"
        "35": "End"
        "end": "End"
        "36": "Home"
        "home": "Home"
        "37": "ArrowLeft"
        "arrowleft": "ArrowLeft"
        "38": "ArrowUp"
        "arrowup": "ArrowUp"
        "39": "ArrowRight"
        "arrowright": "ArrowRight"
        "40": "ArrowDown"
        "arrowdown": "ArrowDown"
        "46": "Delete"
        "127": "Delete"
        "delete": "Delete"
        _: if key.len() == 1: key else: "Unidentified"

pub class BrowserPrimaryPointerDownDispatch:
    suppress_compat_mouse: bool
    default_prevented: bool
    mouse_default_action_allowed: bool

impl BrowserSession:

    me _advance_ui_access_revision():
        self.ui_access_revision = if self.ui_access_revision >= 9223372036854775806:
            9223372036854775806
        else:
            self.ui_access_revision + 1

    me _advance_style_revision():
        self.style_revision = if self.style_revision >= 9223372036854775806:
            9223372036854775806
        else:
            self.style_revision + 1

    me _advance_resource_revision():
        self.resource_revision = if self.resource_revision >= 9223372036854775806:
            9223372036854775806
        else:
            self.resource_revision + 1

    me _replace_current_body_children(body_html: text):
        val replacement = form_capture_defaults(html_tree_builder_build(
            "<html><body>" + body_html + "</body></html>"
        ))
        val replacement_bodies = be_dom_find_by_tag(replacement, "body")
        val current_bodies = be_dom_find_by_tag(self.current_dom, "body")
        if replacement_bodies.len() == 0 or current_bodies.len() == 0:
            self.current_dom = replacement
            self._advance_ui_access_revision()
            return
        self.current_dom = _browser_session_replace_body_children(
            self.current_dom, replacement_bodies[0].children
        )
        self._advance_ui_access_revision()

    me _submit_dom_form(
        form_id: text, submitter_id: text
    ) -> BeDomEventDispatch:
        val submit_dispatch = self.dispatch_dom_event(
            form_id, "submit", true, true
        )
        if (
            submit_dispatch.default_action_allowed and
            not self.csp_sandbox_policy.allow_forms
        ):
            self._append_warning("CSP sandbox blocked form submission")
        elif (
            submit_dispatch.default_action_allowed and
            not self.csp_sandbox_policy.allow_top_navigation
        ):
            self._append_warning("CSP sandbox blocked top navigation")
        elif submit_dispatch.default_action_allowed:
            val submission = browser_form_submission(
                self.current_dom, form_id, submitter_id, self.document_url
            )
            if submission.error != "":
                self._append_warning(submission.error)
            elif not browser_csp_form_action_allows(
                self.content_security_policy, self.document_url,
                submission.url
            ):
                self._append_warning(
                    "CSP blocked form submission: {submission.url}"
                )
            else:
                val started = self._begin_network_navigation_with_form_action_policy(
                    submission.url, submission.method, "",
                    submission.body, submission.content_type,
                    self.content_security_policy, self.document_url
                )
                if val Err(e) = started:
                    self._append_warning("form navigation blocked: {e}")
        submit_dispatch

    me _reset_dom_form(form_id: text):
        val reset_dispatch = self.dispatch_dom_event(
            form_id, "reset", true, true
        )
        if reset_dispatch.event.default_prevented:
            return
        val form_path = be_dom_find_path_to_id(self.current_dom, form_id)
        if form_path.len() == 0:
            return
        self.current_dom = _browser_session_replace_dom_path(
            form_path, form_reset(form_path[form_path.len() - 1])
        )
        self._advance_ui_access_revision()
        self._sync_runtime_body_from_dom()

    me _ensure_dom_text_selection(
        target_id: text, target: BeDomNode
    ) -> text:
        val value = _browser_session_text_control_value(target)
        if (
            self.text_selection_target_id != target_id or
            self.text_selection_anchor_byte < 0 or
            self.text_selection_focus_byte < 0 or
            self.text_selection_anchor_byte > value.len() or
            self.text_selection_focus_byte > value.len() or
            not _browser_session_is_utf8_boundary(
                value, self.text_selection_anchor_byte
            ) or
            not _browser_session_is_utf8_boundary(
                value, self.text_selection_focus_byte
            )
        ):
            val _ = self.set_dom_text_selection(
                target_id, value.len(), value.len()
            )
        value

    me set_dom_text_selection(
        target_id: text, anchor_byte: i64, focus_byte: i64
    ) -> bool:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return false
        val target = path[path.len() - 1]
        if not dom_text_control_selectable(target):
            return false
        val value = _browser_session_text_control_value(target)
        if (
            anchor_byte < 0 or focus_byte < 0 or
            anchor_byte > value.len() or focus_byte > value.len() or
            not _browser_session_is_utf8_boundary(value, anchor_byte) or
            not _browser_session_is_utf8_boundary(value, focus_byte)
        ):
            return false
        self.text_selection_target_id = target_id
        self.text_selection_anchor_byte = anchor_byte
        self.text_selection_focus_byte = focus_byte
        true

    me set_dom_text_selection_route(
        route: DomNodeRoute, anchor_byte: i64, focus_byte: i64
    ) -> bool:
        val target_id = match self._event_target_id_for_route(route):
            Ok(value): value
            Err(_): return false
        self.set_dom_text_selection(target_id, anchor_byte, focus_byte)

    me clear_dom_text_selection():
        self.text_selection_target_id = ""
        self.text_selection_anchor_byte = 0
        self.text_selection_focus_byte = 0

    me _set_dom_text_runtime_state(
        target_id: text, value: text, anchor_byte: i64, focus_byte: i64
    ):
        if val Some(state) = self.runtime_state:
            val path = be_dom_find_path_to_id(self.current_dom, target_id)
            if path.len() == 0:
                return
            val object_id = _browser_session_object_id_for_node(
                state, path[path.len() - 1]
            )
            if object_id < 0:
                return
            var runtime = state.runtime
            runtime.set_host_property(
                object_id, "value", JsValue.String(v: value)
            )
            runtime.set_host_property(
                object_id, "selectionStart",
                JsValue.Number(v: anchor_byte.to_f64())
            )
            runtime.set_host_property(
                object_id, "selectionEnd",
                JsValue.Number(v: focus_byte.to_f64())
            )
            state.runtime = runtime
            self.runtime_state = Some(state)

    me _read_dom_text_runtime_selection(
        target_id: text, value: text
    ) -> bool:
        if val Some(state) = self.runtime_state:
            val path = be_dom_find_path_to_id(self.current_dom, target_id)
            if path.len() == 0:
                return false
            val object_id = _browser_session_object_id_for_node(
                state, path[path.len() - 1]
            )
            if object_id < 0:
                return false
            val anchor_number = match state.runtime.get_host_property(
                object_id, "selectionStart"
            ):
                JsValue.Number(v): v
                _: return false
            val focus_number = match state.runtime.get_host_property(
                object_id, "selectionEnd"
            ):
                JsValue.Number(v): v
                _: return false
            val anchor = anchor_number.to_i64()
            val focus = focus_number.to_i64()
            if (
                anchor_number != anchor.to_f64() or
                focus_number != focus.to_f64() or
                anchor < 0 or focus < 0 or
                anchor > value.len() or focus > value.len() or
                not _browser_session_is_utf8_boundary(value, anchor) or
                not _browser_session_is_utf8_boundary(value, focus)
            ):
                return false
            self.text_selection_target_id = target_id
            self.text_selection_anchor_byte = anchor
            self.text_selection_focus_byte = focus
        true

    me ensure_dom_text_selection(target_id: text) -> bool:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return false
        val target = path[path.len() - 1]
        if not dom_text_control_selectable(target):
            return false
        val _ = self._ensure_dom_text_selection(target_id, target)
        true

    me ensure_dom_text_selection_route(route: DomNodeRoute) -> bool:
        val target_id = match self._event_target_id_for_route(route):
            Ok(value): value
            Err(_): return false
        self.ensure_dom_text_selection(target_id)

    me _persist_storage_for_url(url: text):
        if url == "" or not self.csp_sandbox_policy.allow_same_origin:
            return
        val origin = browser_storage_origin_key(url)
        self.session_storage_by_origin = browser_storage_replace_origin(
            self.session_storage_by_origin, origin, self.session_storage
        )
        self.local_storage_by_origin = browser_storage_replace_origin(
            self.local_storage_by_origin, origin, self.local_storage
        )

    me _activate_storage_for_url(url: text):
        if not self.csp_sandbox_policy.allow_same_origin:
            self.session_storage = []
            self.local_storage = []
            return
        val origin = browser_storage_origin_key(url)
        self.session_storage = browser_storage_entries_for_origin(
            self.session_storage_by_origin, origin
        )
        self.local_storage = browser_storage_entries_for_origin(
            self.local_storage_by_origin, origin
        )

    me eval_script(script: text) -> Result<JsValue, text>:
        if not self.csp_sandbox_policy.allow_scripts:
            return Err("CSP sandbox blocked script execution")
        if self.runtime_state == nil:
            val _ = self._ensure_runtime_state()
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            val result = runtime.eval(script)
            state.runtime = runtime
            self.runtime_state = Some(state)
            self._flush_runtime_side_effects_and_pump_history()
            match result:
                Ok(value):
                    return Ok(value)
                Err(e):
                    return Err(e.message)
        Err("no active page runtime")

    me advance_time(current_time_ms: i64) -> i64:
        """Advance browser time, then run admitted page timers that are due."""
        if current_time_ms < 0:
            return 0
        if current_time_ms > self.monotonic_time_ms:
            self.monotonic_time_ms = current_time_ms
        if not self.csp_sandbox_policy.allow_scripts:
            return 0
        var ran: i64 = 0
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            val js_ran = runtime.drain_due_timers(self.monotonic_time_ms)
            state.runtime = runtime
            self.runtime_state = Some(state)
            if js_ran > 0:
                self._flush_runtime_side_effects_and_pump_history()
            ran = ran + js_ran
        val simple_callbacks = self.simple_script_executor.tick(
            self.monotonic_time_ms * 1000
        )
        for callback_source in simple_callbacks:
            self._execute_simple_script(callback_source, nil)
        ran + simple_callbacks.len().to_i64()

    fn next_script_timer_due_ms() -> i64:
        val simple_due = self.simple_script_executor.next_due_ms()
        if val Some(state) = self.runtime_state:
            val runtime = state.runtime
            val interpreter = runtime.interpreter
            var earliest: i64 = -1
            for task in interpreter.pending_timer_tasks:
                val due = task.due_at_ms()
                if due >= 0 and (earliest < 0 or due < earliest):
                    earliest = due
            if simple_due >= 0 and (earliest < 0 or simple_due < earliest):
                return simple_due
            return earliest
        simple_due

    fn simple_script_callback_count() -> i64:
        self.simple_script_executor.callback_count()

    me dom_root() -> BeDomNode:
        self.current_dom

    fn focused_dom_route() -> DomNodeRoute?:
        """Return a live focus route; never project a legacy node identity."""
        if val Some(index) = self.current_dom_identity_index():
            return be_dom_focused_route(self.current_dom, index)
        nil

    me _sync_body_html_from_dom():
        val bodies = be_dom_find_by_tag(self.current_dom, "body")
        if bodies.len() > 0:
            self.current_body_html = be_dom_serialize_children(bodies[0])

    me _sync_runtime_body_from_dom():
        self._sync_body_html_from_dom()
        self._mark_css_animation_reconcile(false)
        if val Some(state) = self.runtime_state:
            var runtime = state.runtime
            val body_text = html_to_text(self.current_body_html)
            runtime.set_host_property(
                state.body_id, "innerHTML",
                JsValue.String(v: self.current_body_html)
            )
            runtime.set_host_property(
                state.body_id, "textContent",
                JsValue.String(v: body_text)
            )
            var interpreter = runtime.interpreter
            interpreter.host_body_inner_html_value = JsValue.String(v: self.current_body_html)
            interpreter.host_body_text_content_value = JsValue.String(v: body_text)
            interpreter.host_body_inner_html_dirty = false
            interpreter.host_body_text_content_dirty = false
            runtime.interpreter = interpreter
            state.runtime = runtime
            self.runtime_state = Some(state)

    me _append_dynamic_image_warning(
        load: BrowserLoadState?, warning: text
    ):
        if val Some(active) = load:
            active.append_warning(warning)
        else:
            self._append_warning(warning)

    me _record_node_image_render_key(
        source: BrowserImageSource, render_resource_key: text
    ):
        if source.render_node_id < 0:
            return
        self.current_dom = _set_node_image_render_key(
            self.current_dom, source.render_node_id,
            source.render_node_kind, source.resolved_url,
            render_resource_key, self.document_url
        )

    me _reconcile_dynamic_image_sources(load: BrowserLoadState?):
        val admitted_count = self.admitted_image_sources.len()
        var known_sources: [BrowserImageSource] = []
        for source in self.admitted_image_sources:
            known_sources.push(source)
        var discovered = BrowserLoadState.create(
            self.document_url, "", "GET", "", "", -1, false, [], [],
            known_sources
        )
        _queue_inline_style_background_images(
            self.current_dom, discovered, self.document_url, 0,
            self.content_security_policy
        )
        for style_node in be_dom_find_by_tag(self.current_dom, "style"):
            discovered._queue_background_image_sources(
                be_dom_get_text_content(style_node),
                self.document_url,
                false,
                self.content_security_policy,
                -1
            )
        for warning in discovered.warnings:
            self._append_dynamic_image_warning(load, warning)

        var source_index = admitted_count
        while source_index < discovered.image_sources.len():
            val started = self._start_image_source(
                discovered.image_sources[source_index]
            )
            if val Err(warning) = started:
                self._append_dynamic_image_warning(load, warning)
            source_index = source_index + 1

    me dispatch_dom_event(target_id: text, event_type: text, bubbles: bool, cancelable: bool) -> BeDomEventDispatch:
        self._dispatch_dom_event_with_payload(
            target_id, event_type, bubbles, cancelable, "", "", false,
            nil, "", false, true
        )

    fn _event_target_id_for_route(route: DomNodeRoute) -> Result<text, text>:
        if route.generation.value != self.document_generation().value:
            return Err("stale_target")
        val index = match self.current_dom_identity_index():
            Some(value): value
            nil: return Err("invalid_document")
        if be_dom_node_for_route(self.current_dom, index, route) == nil:
            return Err("stale_target")
        Err("legacy_route_bridge_removed")

    me dispatch_dom_event_route(
        route: DomNodeRoute, event_type: text, bubbles: bool, cancelable: bool
    ) -> Result<BeDomRouteEventDispatch, text>:
        """Dispatch through a live typed route without text authorization."""
        if route.generation.value != self.document_generation().value:
            return Err("stale_target")
        val index = match self.current_dom_identity_index():
            Some(value): value
            nil: return Err("invalid_document")
        if not index.contains_route(route):
            return Err("stale_target")
        Ok(be_dom_dispatch_event_to_route(
            self.current_dom, index, route, event_type, bubbles, cancelable,
            self.csp_sandbox_policy.allow_scripts
        ))

    me dispatch_dom_primary_pointer_down_by_id(
        target_id: text
    ) -> BrowserPrimaryPointerDownDispatch:
        """Dispatch primary pointerdown and its permitted mouse compatibility.

        Canceling pointerdown sets the Pointer Events PREVENT MOUSE EVENT state,
        so mousedown is not produced and the caller must retain suppression
        until the matching pointerup.
        """
        val pointer_down = self.dispatch_dom_event(
            target_id, "pointerdown", true, true
        )
        if pointer_down.event.default_prevented:
            return BrowserPrimaryPointerDownDispatch(
                suppress_compat_mouse: true,
                default_prevented: true,
                mouse_default_action_allowed: false
            )
        val mouse_down = self.dispatch_dom_event(
            target_id, "mousedown", true, true
        )
        BrowserPrimaryPointerDownDispatch(
            suppress_compat_mouse: false,
            default_prevented: mouse_down.event.default_prevented,
            mouse_default_action_allowed: mouse_down.default_action_allowed
        )

    me dispatch_dom_primary_pointer_up_by_id(
        target_id: text, suppress_compat_mouse: bool, activate_click: bool
    ):
        """Finish a primary pointer stream without dropping pointerup/click."""
        val _ = self.dispatch_dom_event(
            target_id, "pointerup", true, true
        )
        if not suppress_compat_mouse:
            val _ = self.dispatch_dom_event(
                target_id, "mouseup", true, true
            )
        if activate_click:
            val _ = self._dispatch_dom_event_with_payload(
                target_id, "click", true, true, "", "", false,
                nil, "", false, not suppress_compat_mouse
            )

    me dispatch_dom_primary_pointer_down(
        route: DomNodeRoute
    ) -> Result<BrowserPrimaryPointerDownDispatch, text>:
        val target_id = self._event_target_id_for_route(route)?
        Ok(self.dispatch_dom_primary_pointer_down_by_id(target_id))

    me dispatch_dom_primary_pointer_up(
        route: DomNodeRoute, suppress_compat_mouse: bool, activate_click: bool
    ) -> Result<bool, text>:
        val target_id = self._event_target_id_for_route(route)?
        self.dispatch_dom_primary_pointer_up_by_id(
            target_id, suppress_compat_mouse, activate_click
        )
        Ok(true)

    me _dispatch_dom_input_event(
        target_id: text, event_type: text, bubbles: bool, cancelable: bool,
        input_data: text?, input_type: text
    ) -> BeDomEventDispatch:
        self._dispatch_dom_event_with_payload(
            target_id, event_type, bubbles, cancelable, "", "", false,
            input_data, input_type, false, true
        )

    me _dispatch_dom_event_with_payload(
        target_id: text, event_type: text, bubbles: bool, cancelable: bool,
        key: text, code: text, shift_key: bool, input_data: text?,
        input_type: text, is_composing: bool, allow_focus_default: bool
    ) -> BeDomEventDispatch:
        val target_route_id = _browser_session_dom_route_id(
            self.current_dom, target_id
        )
        val checkable_action = _browser_session_checkable_click_action(
            self.current_dom, target_route_id, event_type
        )
        var checked_before = false
        var checked_radio_before = ""
        if checkable_action != "":
            val focused_id = be_dom_focused_route_id(self.current_dom)
            if (
                allow_focus_default and focused_id != "" and
                focused_id != target_route_id
            ):
                val _ = self._blur_dom_focus(focused_id)
            val path = be_dom_find_path_to_id(self.current_dom, target_route_id)
            if path.len() > 0:
                checked_before = be_dom_has_attr(
                    path[path.len() - 1], "checked"
                )
            if checkable_action == "input-radio-select":
                checked_radio_before = be_dom_checked_radio_id_for_target(
                    self.current_dom, target_route_id
                )
            self.current_dom = if allow_focus_default:
                script_host_apply_action_to_id(
                    self.current_dom, target_route_id, checkable_action, true
                )
            else:
                be_dom_apply_default_action_to_id_without_focus(
                    self.current_dom, target_route_id, checkable_action
                )
            self._sync_runtime_body_from_dom()
        val normalized_event_type = normalize_dom_event_type(event_type)
        var focus_transitioned = false
        if normalized_event_type == "focus":
            val initial_focus_path = be_dom_find_path_to_id(
                self.current_dom, target_route_id
            )
            if (
                initial_focus_path.len() > 0 and
                not be_dom_has_attr(
                    initial_focus_path[initial_focus_path.len() - 1],
                    "disabled"
                )
            ):
                val focused_id = be_dom_focused_route_id(self.current_dom)
                if focused_id != target_route_id:
                    if focused_id != "":
                        val _ = self._blur_dom_focus(focused_id)
                    val current_focus_path = be_dom_find_path_to_id(
                        self.current_dom, target_route_id
                    )
                    if current_focus_path.len() > 0:
                        self.current_dom = script_host_apply_action_to_id(
                            self.current_dom, target_route_id,
                            "focus-element", true
                        )
                        self._sync_runtime_body_from_dom()
                        focus_transitioned = true
        val dispatch_path = be_dom_find_path_to_id(
            self.current_dom, target_route_id
        )
        val inline_action = if dispatch_path.len() > 0:
            be_dom_get_attr(
                dispatch_path[dispatch_path.len() - 1],
                "on" + normalized_event_type
            )
        else:
            ""
        val inline_allowed = (
            inline_action == "" or (
                self.csp_sandbox_policy.allow_scripts and
                browser_csp_allows(
                    self.content_security_policy, "script-src",
                    self.document_url, self.document_url, true
                )
            )
        )
        if inline_action != "" and not inline_allowed:
            self._append_warning(
                "CSP blocked inline event handler: {normalized_event_type}"
        )
        var callable_executor_used = false
        var dispatch = if input_type != "":
            be_dom_dispatch_input_event_to_id(
                self.current_dom, target_route_id, event_type, bubbles,
                cancelable, input_data, input_type, is_composing,
                inline_allowed
            )
        elif key == "" and code == "":
            be_dom_dispatch_event_to_id(
                self.current_dom, target_route_id, event_type, bubbles,
                cancelable, inline_allowed
            )
        else:
            be_dom_dispatch_keyboard_event_to_id(
                self.current_dom, target_route_id, event_type, bubbles,
                cancelable, key, code, shift_key, inline_allowed
            )
        if val Some(state) = self.runtime_state:
            val _ = state.drain_dom_callable_listener_ops()
            if dispatch_path.len() > 0:
                val callable_root = _browser_session_callable_dispatch_root(
                    dispatch_path, state, normalized_event_type
                )
                val target_object_id = _browser_session_object_id_for_node(
                    state, dispatch_path[dispatch_path.len() - 1]
                )
                var dispatch_active: [bool] = []
                for listener in state.dom_callable_listeners:
                    dispatch_active.push(listener.event_type != "")
                var executor = BrowserDomEventExecutor(
                    runtime: state.runtime,
                    listeners: state.dom_callable_listeners,
                    dispatch_active: dispatch_active,
                    node_ids: state.dom_node_ids,
                    element_ids: state.dom_element_ids,
                    window_id: state.window_id,
                    document_id: state.document_id,
                    target_object_id: target_object_id,
                    event_object_id: -1,
                    event_prevent_default_fn_id:
                        state.event_prevent_default_fn_id,
                    event_stop_propagation_fn_id:
                        state.event_stop_propagation_fn_id,
                    event_stop_immediate_propagation_fn_id:
                        state.event_stop_immediate_propagation_fn_id,
                    error: ""
                )
                dispatch = if input_type != "":
                    be_dom_dispatch_input_event_to_id(
                        callable_root, target_route_id, event_type, bubbles,
                        cancelable, input_data, input_type, is_composing,
                        inline_allowed,
                        fn(event: BeDomEvent, node: BeDomNode, action: text,
                           phase: text) -> BeDomEvent:
                            executor.execute(event, node, action, phase)
                    )
                elif key == "" and code == "":
                    be_dom_dispatch_event_to_id(
                        callable_root, target_route_id, event_type, bubbles,
                        cancelable, inline_allowed,
                        fn(event: BeDomEvent, node: BeDomNode, action: text,
                           phase: text) -> BeDomEvent:
                            executor.execute(event, node, action, phase)
                    )
                else:
                    be_dom_dispatch_keyboard_event_to_id(
                        callable_root, target_route_id, event_type, bubbles,
                        cancelable, key, code, shift_key, inline_allowed,
                        fn(event: BeDomEvent, node: BeDomNode, action: text,
                           phase: text) -> BeDomEvent:
                            executor.execute(event, node, action, phase)
                    )
                executor.finish_event()
                state.runtime = executor.runtime
                state.dom_callable_listeners = executor.listeners
                self.runtime_state = Some(state)
                callable_executor_used = true
                if executor.error != "":
                    self._append_warning(
                        "DOM event listener failed: {executor.error}"
                    )
                self._flush_runtime_side_effects_and_pump_history()
        self.dom_callback_count = (
            self.dom_callback_count + dispatch.actions.len().to_i64()
        )
        var action_index = 0
        while action_index < dispatch.actions.len():
            val action = dispatch.actions[action_index]
            if _browser_session_dom_action(action):
                self.current_dom = script_host_apply_action_to_id(
                    self.current_dom,
                    dispatch.current_target_route_ids[action_index],
                    action,
                    false
                )
            elif (
                _browser_session_event_control(action) == false and
                not action.starts_with(BROWSER_DOM_CALLABLE_TOKEN) and
                not callable_executor_used
            ):
                self._sync_runtime_body_from_dom()
                val _ = self.eval_script(action)
            action_index = action_index + 1
        if (
            dispatch.default_action_allowed and
            normalized_event_type == "click"
        ):
            dispatch.default_action = be_dom_default_action_to_id(
                self.current_dom, dispatch.target_route_id, event_type
            )
            dispatch.default_action_allowed = dispatch.default_action != ""
        val live_checkable_action = if (
            dispatch.default_action_allowed and
            _browser_session_checkable_default(dispatch.default_action)
        ):
            dispatch.default_action
        else:
            ""
        val preactivation_matches_live = (
            checkable_action != "" and
            checkable_action == live_checkable_action
        )
        if checkable_action != "" and not preactivation_matches_live:
            val restore_action = if checked_before:
                "set-attr:checked:checked"
            else:
                "remove-attr:checked"
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_route_id, restore_action, false
            )
            if (
                checkable_action == "input-radio-select" and
                checked_radio_before != "" and
                checked_radio_before != target_route_id
            ):
                self.current_dom = script_host_apply_action_to_id(
                    self.current_dom, checked_radio_before,
                    "set-attr:checked:checked", false
                )
        if dispatch.default_action_allowed:
            var focus_changed = focus_transitioned
            if (
                _browser_session_focus_default(dispatch.default_action) and
                not focus_transitioned and allow_focus_default
            ):
                val focused_id = be_dom_focused_route_id(self.current_dom)
                focus_changed = focused_id != dispatch.target_route_id
                if focused_id != "" and
                   focused_id != dispatch.target_route_id:
                    val _ = self._blur_dom_focus(focused_id)
            if dispatch.default_action.starts_with("navigate-popup:"):
                dispatch.default_action_allowed = false
                if not self.csp_sandbox_policy.allow_popups:
                    self._append_warning("CSP sandbox blocked popup")
                else:
                    self._append_warning("popup-context-unavailable")
                return dispatch
            if dispatch.default_action.starts_with("navigate:"):
                if not self.csp_sandbox_policy.allow_top_navigation:
                    self._append_warning(
                        "CSP sandbox blocked top navigation"
                    )
                    return dispatch
                val href = dispatch.default_action.substring(9, dispatch.default_action.len())
                val target = resolve_relative_url(self.document_url, href)
                val started = self.begin_network_navigation(target, "GET", "", "", "")
                if val Err(e) = started:
                    self._append_warning("default navigation blocked: {e}")
                return dispatch
            if live_checkable_action == "":
                self.current_dom = if allow_focus_default:
                    script_host_apply_action_to_id(
                        self.current_dom, dispatch.target_route_id,
                        dispatch.default_action, true
                    )
                else:
                    be_dom_apply_default_action_to_id_without_focus(
                        self.current_dom, dispatch.target_route_id,
                        dispatch.default_action
                    )
            else:
                if not preactivation_matches_live:
                    self.current_dom = if allow_focus_default:
                        script_host_apply_action_to_id(
                            self.current_dom, dispatch.target_route_id,
                            live_checkable_action, true
                        )
                    else:
                        be_dom_apply_default_action_to_id_without_focus(
                            self.current_dom, dispatch.target_route_id,
                            live_checkable_action
                        )
                self._sync_body_html_from_dom()
                val _ = self.dispatch_dom_event(
                    dispatch.target_route_id, "input", true, false
                )
                val _ = self.dispatch_dom_event(
                    dispatch.target_route_id, "change", true, false
                )
            if focus_changed:
                if normalized_event_type != "focus":
                    val _ = self.dispatch_dom_event(
                        dispatch.target_route_id, "focus", false, false
                    )
                val _ = self.dispatch_dom_event(
                    dispatch.target_route_id, "focusin", true, false
                )
            if event_type == "click" and dispatch.default_action == "button-activate":
                val form_id = be_dom_submit_form_owner_id(
                    self.current_dom, dispatch.target_route_id
                )
                if form_id != "":
                    val _ = self._submit_dom_form(
                        form_id, dispatch.target_route_id
                    )
            elif event_type == "click" and
                 dispatch.default_action == "form-reset":
                val form_id = be_dom_reset_form_owner_id(
                    self.current_dom, dispatch.target_route_id
                )
                if form_id != "":
                    self._reset_dom_form(form_id)
        self._sync_body_html_from_dom()
        dispatch

    me dispatch_dom_keyboard_activation(
        target_id: text, key: text
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM keyboard target not found")
        val key_dispatch = self._dispatch_dom_event_with_payload(
            target_id, "keydown", true, true, key,
            browser_dom_keyboard_code_from_key(key), false, nil, "", false,
            true
        )
        if key_dispatch.event.default_prevented:
            return Ok(key_dispatch)
        val current_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if current_path.len() == 0:
            return Err("DOM keyboard target was removed")
        val event_type = be_dom_keyboard_activation_event_for_target(
            current_path[current_path.len() - 1], key
        )
        if event_type == "":
            return Err("key does not activate target")
        Ok(self.dispatch_dom_event(target_id, event_type, true, true))

    me dispatch_dom_keyboard_event(
        target_id: text, key: text, pressed: bool
    ) -> Result<BeDomEventDispatch, text>:
        self._dispatch_dom_keyboard_event_with_payload(
            target_id, key, browser_dom_keyboard_code_from_key(key),
            pressed, false
        )

    me _dispatch_dom_keyboard_event_with_payload(
        target_id: text, key: text, code: text, pressed: bool,
        shift_key: bool
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM keyboard target not found")
        val event_type = if pressed: "keydown" else: "keyup"
        val key_dispatch = self._dispatch_dom_event_with_payload(
            target_id, event_type, true, true, key, code, shift_key,
            nil, "", false, true
        )
        if key_dispatch.event.default_prevented:
            self.pending_space_activation_target = ""
            return Ok(key_dispatch)
        val current_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if current_path.len() == 0:
            self.pending_space_activation_target = ""
            return Err("DOM keyboard target was removed")
        val target = current_path[current_path.len() - 1]
        val normalized_key = key.trim().lower()
        val is_space = (
            normalized_key == "space" or normalized_key == "spacebar" or
            key == " "
        )
        if pressed and (normalized_key == "backspace" or key == "8"):
            self.pending_space_activation_target = ""
            if (
                (target.tag_name == "input" or target.tag_name == "textarea") and
                not be_dom_has_attr(target, "disabled") and
                not be_dom_has_attr(target, "readonly")
            ):
                val value = if target.tag_name == "input":
                    be_dom_get_attr(target, "value")
                else:
                    html_to_text(be_dom_serialize_children(target))
                if value != "":
                    return self._apply_dom_text_edit(
                        target_id, "", false, "deleteContentBackward"
                    )
            return Ok(key_dispatch)
        if pressed and (
            normalized_key == "enter" or normalized_key == "return"
        ) and _browser_session_accepts_implicit_submit(target):
            val form_id = be_dom_form_owner_id(self.current_dom, target_id)
            val submitter_id = be_dom_default_submitter_id(
                self.current_dom, form_id
            )
            if submitter_id != "":
                return Ok(self.dispatch_dom_event(
                    submitter_id, "click", true, true
                ))
            if be_dom_form_allows_direct_implicit_submit(
                self.current_dom, form_id
            ):
                return Ok(self._submit_dom_form(form_id, ""))
        val activation_event = be_dom_keyboard_activation_event_for_target(
            target, key
        )
        if activation_event == "":
            # A Space event on a non-activatable target ends stale ownership;
            # unrelated key events do not own the pending Space press.
            if is_space:
                self.pending_space_activation_target = ""
            return Ok(key_dispatch)
        if is_space:
            if pressed:
                self.pending_space_activation_target = target_id
                return Ok(key_dispatch)
            val armed = self.pending_space_activation_target == target_id
            self.pending_space_activation_target = ""
            if not armed:
                return Ok(key_dispatch)
        elif not pressed:
            return Ok(key_dispatch)
        else:
            self.pending_space_activation_target = ""
        Ok(self.dispatch_dom_event(target_id, activation_event, true, true))

    me dispatch_dom_keyboard_event_with_shift(
        target_id: text, key: text, pressed: bool, shift_key: bool
    ) -> Result<BeDomEventDispatch, text>:
        self._dispatch_dom_keyboard_event_with_shift_payload(
            target_id, key, browser_dom_keyboard_code_from_key(key),
            pressed, shift_key
        )

    me dispatch_dom_keyboard_code_event_by_id(
        target_id: text, key_code: i64, pressed: bool, shift_key: bool
    ) -> Result<BeDomEventDispatch, text>:
        self._dispatch_dom_keyboard_event_with_shift_payload(
            target_id,
            browser_dom_keyboard_key(key_code, shift_key),
            browser_dom_keyboard_code(key_code),
            pressed, shift_key
        )

    me dispatch_dom_keyboard_code_event(
        focused_route: DomNodeRoute?, key_code: i64, pressed: bool,
        shift_key: bool
    ) -> Result<BeDomEventDispatch, text>:
        val key = browser_dom_keyboard_key(key_code, shift_key)
        val target_id = match focused_route:
            Some(route): self._event_target_id_for_route(route)?
            nil:
                if key.trim().lower() != "tab" and key != "9":
                    return Err("stale_target")
                ""
        self._dispatch_dom_keyboard_event_with_shift_payload(
            target_id, key, browser_dom_keyboard_code(key_code),
            pressed, shift_key
        )

    me _dispatch_dom_keyboard_event_with_shift_payload(
        target_id: text, key: text, code: text, pressed: bool,
        shift_key: bool
    ) -> Result<BeDomEventDispatch, text>:
        val normalized_key = key.trim().lower()
        val is_tab = normalized_key == "tab" or key == "9"
        val is_left = normalized_key == "arrowleft" or key == "37"
        val is_right = normalized_key == "arrowright" or key == "39"
        val is_home = normalized_key == "home" or key == "36"
        val is_end = normalized_key == "end" or key == "35"
        val is_backspace = normalized_key == "backspace" or key == "8"
        val is_delete = normalized_key == "delete" or key == "127"
        val is_edit_key = (
            is_left or is_right or is_home or is_end or
            is_backspace or is_delete
        )
        if pressed and not is_tab and is_edit_key and target_id != "":
            val path = be_dom_find_path_to_id(self.current_dom, target_id)
            if path.len() > 0:
                val target = path[path.len() - 1]
                if dom_text_control_selectable(target):
                    val key_dispatch = self._dispatch_dom_event_with_payload(
                        target_id, "keydown", true, true,
                        key, code, shift_key, nil, "", false, true
                    )
                    if key_dispatch.event.default_prevented:
                        return Ok(key_dispatch)
                    val value = self._ensure_dom_text_selection(
                        target_id, target
                    )
                    if is_left or is_right or is_home or is_end:
                        var next_focus = self.text_selection_focus_byte
                        val has_selection = (
                            self.text_selection_anchor_byte !=
                            self.text_selection_focus_byte
                        )
                        if is_left and not shift_key and has_selection:
                            next_focus = self.text_selection_anchor_byte
                            if self.text_selection_focus_byte < next_focus:
                                next_focus = self.text_selection_focus_byte
                        elif is_right and not shift_key and has_selection:
                            next_focus = self.text_selection_anchor_byte
                            if self.text_selection_focus_byte > next_focus:
                                next_focus = self.text_selection_focus_byte
                        elif is_left:
                            next_focus = _browser_session_previous_utf8_boundary(
                                value, next_focus
                            )
                        elif is_right:
                            next_focus = _browser_session_next_utf8_boundary(
                                value, next_focus
                            )
                        elif is_home:
                            next_focus = 0
                        else:
                            next_focus = value.len()
                        self.text_selection_focus_byte = next_focus
                        if not shift_key:
                            self.text_selection_anchor_byte = next_focus
                        return Ok(key_dispatch)
                    if not dom_text_control_mutable(target):
                        return Ok(key_dispatch)
                    var start = self.text_selection_anchor_byte
                    var end = self.text_selection_focus_byte
                    if start > end:
                        val swap = start
                        start = end
                        end = swap
                    if start == end and is_backspace:
                        start = _browser_session_previous_utf8_boundary(
                            value, start
                        )
                    elif start == end and is_delete:
                        end = _browser_session_next_utf8_boundary(value, end)
                    if start == end:
                        return Ok(key_dispatch)
                    val input_type = if is_backspace:
                        "deleteContentBackward"
                    else:
                        "deleteContentForward"
                    val updated = self._apply_dom_text_edit(
                        target_id, "", false, input_type
                    )
                    return updated
        if not is_tab or not pressed:
            return self._dispatch_dom_keyboard_event_with_payload(
                target_id, key, code, pressed, shift_key
            )
        self.pending_space_activation_target = ""
        if target_id != "":
            val current_route_id = _browser_session_dom_route_id(
                self.current_dom, target_id
            )
            val key_dispatch = self._dispatch_dom_event_with_payload(
                target_id, "keydown", true, true, key, code, shift_key,
                nil, "", false, true
            )
            if key_dispatch.event.default_prevented:
                return Ok(key_dispatch)
            val next_id = be_dom_next_focus_route_id(
                self.current_dom, current_route_id, shift_key
            )
            if next_id == "" or next_id == current_route_id:
                return Ok(key_dispatch)
            val _ = self._blur_dom_focus(target_id)
            return Ok(self.dispatch_dom_event(
                next_id, "focus", false, false
            ))
        val next_id = be_dom_next_focus_route_id(
            self.current_dom, "", shift_key
        )
        if next_id == "":
            return Err("DOM has no focusable target")
        Ok(self.dispatch_dom_event(next_id, "focus", false, false))

    me _apply_dom_text_edit(
        target_id: text, insertion: text, replace_all: bool,
        input_type: text
    ) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM input target not found")
        val target = path[path.len() - 1]
        if not dom_text_control_mutable(target):
            return Err("DOM input target is not editable")
        if not text_is_valid_utf8(insertion):
            return Err("DOM input value is not valid UTF-8")
        val target_route_id = be_dom_route_identity(target)
        if be_dom_focused_route_id(self.current_dom) != target_route_id:
            val _ = self.dispatch_dom_event(
                target_id, "focus", false, false
            )
        val focused_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if focused_path.len() == 0:
            return Err("DOM input target was removed")
        if not dom_text_control_mutable(focused_path[focused_path.len() - 1]):
            return Err("DOM input target is not editable")
        val focused_target = focused_path[focused_path.len() - 1]
        val focused_value = self._ensure_dom_text_selection(
            target_id, focused_target
        )
        self._set_dom_text_runtime_state(
            target_id, focused_value, self.text_selection_anchor_byte,
            self.text_selection_focus_byte
        )
        val input_data: text? = if input_type.starts_with("delete"):
            nil
        else:
            Some(insertion)
        val before_input = self._dispatch_dom_input_event(
            target_id, "beforeinput", true, true, input_data, input_type
        )
        if before_input.event.default_prevented:
            val canceled_path = be_dom_find_path_to_id(
                self.current_dom, target_id
            )
            if canceled_path.len() > 0:
                val canceled_value = _browser_session_text_control_value(
                    canceled_path[canceled_path.len() - 1]
                )
                if text_is_valid_utf8(canceled_value):
                    val _ = self._read_dom_text_runtime_selection(
                        target_id, canceled_value
                    )
            return Ok(before_input)

        val current_path = be_dom_find_path_to_id(self.current_dom, target_id)
        if current_path.len() == 0:
            return Err("DOM input target was removed")
        val current_target = current_path[current_path.len() - 1]
        if not dom_text_control_mutable(current_target):
            return Err("DOM input target is not editable")
        val current_value = _browser_session_text_control_value(current_target)
        if not text_is_valid_utf8(current_value):
            return Err("DOM input value is not valid UTF-8")
        if not self._read_dom_text_runtime_selection(
            target_id, current_value
        ):
            return Err("DOM input selection is not valid UTF-8")
        var start = 0
        var end = current_value.len()
        if not replace_all:
            start = self.text_selection_anchor_byte
            end = self.text_selection_focus_byte
            if start > end:
                val swap = start
                start = end
                end = swap
            if start == end and input_type == "deleteContentBackward":
                start = _browser_session_previous_utf8_boundary(
                    current_value, start
                )
            elif start == end and input_type == "deleteContentForward":
                end = _browser_session_next_utf8_boundary(current_value, end)
        val prefix = current_value.slice(0, start)
        val suffix = current_value.slice(end, current_value.len())
        var accepted_insertion = insertion
        var next_value = prefix + insertion + suffix
        val maxlength = _browser_session_text_maxlength(current_target)
        if maxlength != nil:
            val limit = maxlength ?? 0
            if replace_all:
                val current_units = _browser_session_utf16_units(current_value)
                val next_units = _browser_session_utf16_units(next_value)
                if not (current_units > limit and next_units < current_units):
                    accepted_insertion = _browser_session_utf16_prefix(
                        insertion, limit
                    )
                    next_value = accepted_insertion
            else:
                val fixed_units = (
                    _browser_session_utf16_units(prefix) +
                    _browser_session_utf16_units(suffix)
                )
                val available = if fixed_units >= limit:
                    0
                else:
                    limit - fixed_units
                accepted_insertion = _browser_session_utf16_prefix(
                    insertion, available
                )
                next_value = prefix + accepted_insertion + suffix
        if next_value == current_value:
            return Ok(before_input)

        if current_target.tag_name == "input":
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_id,
                "set-attr:value=" + next_value, false
            )
        else:
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_id, "set-text:" + next_value, false
            )
        self.current_dom = script_host_apply_action_to_id(
            self.current_dom, target_id,
            "set-attr:data-input-dirty=true", false
        )
        val caret = prefix.len() + accepted_insertion.len()
        self.text_selection_target_id = target_id
        self.text_selection_anchor_byte = caret
        self.text_selection_focus_byte = caret
        self._set_dom_text_runtime_state(
            target_id, next_value, caret, caret
        )
        val accepted_data: text? = if input_type.starts_with("delete"):
            nil
        else:
            Some(accepted_insertion)
        val input_dispatch = self._dispatch_dom_input_event(
            target_id, "input", true, false,
            accepted_data, input_type
        )
        Ok(input_dispatch)

    me set_dom_select_value(
        target_id: text, value: text
    ) -> Result<bool, text>:
        val initial_path = be_dom_find_path_to_id(
            self.current_dom, target_id
        )
        if initial_path.len() == 0:
            return Err("DOM select target not found")
        val initial_target = initial_path[initial_path.len() - 1]
        if initial_target.tag_name != "select":
            return Err("DOM target is not a select")
        if be_dom_has_attr(initial_target, "disabled"):
            return Err("DOM select target is disabled")
        if not browser_select_has_value(initial_target, value):
            return Err("DOM select value is unavailable")

        val route_id = be_dom_route_identity(initial_target)
        val focused_id = be_dom_focused_route_id(self.current_dom)
        if focused_id != route_id:
            if focused_id != "":
                val _ = self._blur_dom_focus(focused_id)
            val _ = self.dispatch_dom_event(
                route_id, "focus", false, false
            )

        val current_path = be_dom_find_path_to_id(
            self.current_dom, route_id
        )
        if current_path.len() == 0:
            return Err("DOM select target was removed")
        val current_target = current_path[current_path.len() - 1]
        if (
            current_target.tag_name != "select" or
            be_dom_has_attr(current_target, "disabled")
        ):
            return Err("DOM select target is no longer editable")
        val update = browser_select_update(current_target, value)
        if not update.found:
            return Err("DOM select value is no longer available")
        if not update.changed:
            return Ok(false)

        self.current_dom = _browser_session_replace_dom_path(
            current_path, update.node
        )
        self._sync_body_html_from_dom()
        val _ = self.dispatch_dom_event(
            route_id, "input", true, false
        )
        if be_dom_find_path_to_id(self.current_dom, route_id).len() > 0:
            val _ = self.dispatch_dom_event(
                route_id, "change", true, false
            )
        Ok(true)

    me set_dom_select_value_route(
        route: DomNodeRoute, value: text
    ) -> Result<bool, text>:
        self.set_dom_select_value(self._event_target_id_for_route(route)?, value)

    me set_dom_text_input(
        target_id: text, value: text
    ) -> Result<BeDomEventDispatch, text>:
        self._apply_dom_text_edit(
            target_id, value, true, "insertReplacementText"
        )

    me set_dom_text_input_route(
        route: DomNodeRoute, value: text
    ) -> Result<BeDomEventDispatch, text>:
        self.set_dom_text_input(self._event_target_id_for_route(route)?, value)

    me append_dom_text_input(
        target_id: text, value: text
    ) -> Result<BeDomEventDispatch, text>:
        self._apply_dom_text_edit(
            target_id, value, false, "insertText"
        )

    me append_dom_text_input_route(
        route: DomNodeRoute, value: text
    ) -> Result<BeDomEventDispatch, text>:
        self.append_dom_text_input(self._event_target_id_for_route(route)?, value)

    me _blur_dom_focus(target_id: text) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM focus target not found")
        val target = path[path.len() - 1]
        if (target.tag_name == "input" or target.tag_name == "textarea") and
           be_dom_has_attr(target, "data-input-dirty"):
            val _ = self.dispatch_dom_event(target_id, "change", true, false)
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, target_id,
                "remove-attr:data-input-dirty", false
            )
        self.current_dom = script_host_apply_action_to_id(
            self.current_dom, target_id, "remove-attr:data-focused", false
        )
        val blur_dispatch = self.dispatch_dom_event(
            target_id, "blur", false, false
        )
        val _ = self.dispatch_dom_event(
            target_id, "focusout", true, false
        )
        if self.text_selection_target_id == target_id:
            self.clear_dom_text_selection()
        Ok(blur_dispatch)

    me blur_dom_text_input(target_id: text) -> Result<BeDomEventDispatch, text>:
        val path = be_dom_find_path_to_id(self.current_dom, target_id)
        if path.len() == 0:
            return Err("DOM input target not found")
        val target = path[path.len() - 1]
        if target.tag_name != "input" and target.tag_name != "textarea":
            return Err("DOM input target is not text-editable")
        self._blur_dom_focus(target_id)

    me blur_dom_text_input_route(
        route: DomNodeRoute
    ) -> Result<BeDomEventDispatch, text>:
        self.blur_dom_text_input(self._event_target_id_for_route(route)?)

    me clear_dom_focus():
        val focused_id = be_dom_focused_route_id(self.current_dom)
        if focused_id != "":
            val _ = self._blur_dom_focus(focused_id)
        self.clear_dom_text_selection()

    me discard_dom_focus_for_navigation():
        val focused_id = be_dom_focused_route_id(self.current_dom)
        if focused_id != "":
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, focused_id,
                "remove-attr:data-focused", false
            )
            self.current_dom = script_host_apply_action_to_id(
                self.current_dom, focused_id,
                "remove-attr:data-input-dirty", false
            )
            self._sync_runtime_body_from_dom()
        self.clear_dom_text_selection()

    me render(width: i32, height: i32) -> BeRenderResult:
        var renderer = BrowserRenderer.create(width, height)
        val html = self.render_html_document()
        self.prepare_css_animation_instances_with_html(width, html)
        val animation_time_ms = self.monotonic_time_ms - self.animation_start_time_ms
        var result = renderer.render_html_to_pixels_at_time_with_animations_with_images(
            html, animation_time_ms, self.css_animation_instances,
            self.image_resources
        )
        result.node_count = _browser_session_dom_node_count(self.current_dom)
        result

    me render_to_pixels(width: i32, height: i32) -> BeRenderResult:
        var renderer = BrowserRenderer.create(width, height)
        val html = self.render_html_document()
        self.prepare_css_animation_instances_with_html(width, html)
        val animation_time_ms = self.monotonic_time_ms - self.animation_start_time_ms
        var result = renderer.render_html_to_pixels_at_time_with_animations_with_images(
            html, animation_time_ms, self.css_animation_instances,
            self.image_resources
        )
        result.node_count = _browser_session_dom_node_count(self.current_dom)
        result

    me render_html_document() -> text:
        val title = if self.current_title != "": self.current_title else: self.current_url
        val bodies = be_dom_find_by_tag(self.current_dom, "body")
        val body_html = if bodies.len() > 0:
            be_dom_serialize_html_for_render(bodies[0])
        else:
            "<body>" + self.current_body_html + "</body>"
        val style_html = bind_render_stylesheet_image_urls(
            self.current_style_html, self.document_url,
            self.admitted_image_sources
        )
        "<!DOCTYPE html><html><head><title>{escape_html_text(title)}</title>{style_html}</head>{body_html}</html>"

    fn render_revisions() -> BrowserRenderRevisions:
        BrowserRenderRevisions(
            document_revision: self.ui_access_revision,
            style_revision: self.style_revision,
            resource_revision: self.resource_revision
        )

    me render_snapshot_since(
        document_revision: i64,
        style_revision: i64,
        resource_revision: i64
    ) -> BrowserRenderSnapshot:
        val revisions = self.render_revisions()
        val document_html = if (
            revisions.document_revision != document_revision or
            revisions.style_revision != style_revision
        ):
            Some(self.render_html_document())
        else:
            nil
        BrowserRenderSnapshot(
            revisions: revisions,
            document_html: document_html,
            resources_changed:
                revisions.resource_revision != resource_revision
        )

    me close():
        self.runtime_state = nil
        self.active_load = nil
        self.is_loading = false
        self.stop_requested = true
        self.pending_url = ""
        self.pending_navigation_target_index = -1
        self.pending_navigation_push_history = true
        self.pending_history_traversal_delta = 0
        self.history_traversal_pump_active = false
        self.pending_requests = []
        self.pending_request_head = 0
        self.inflight_requests = []
        self.subresource_request_count = 0
        self.module_source_cache = []
        self.module_redirect_urls = []
        self.loaded_module_urls = []
        self.module_eval_stack = []
        self.wasm_modules = []
        self.image_resources = []
        self.admitted_image_sources = []
        self.resource_overrides = []
        self.pending_script_cookie_writes = []
        self.css_animation_instances = []
        self.css_animation_reconcile_pending = false
        self.current_body_html = ""
        self.current_style_html = ""
        self.source_html = ""
        self.current_dom = BeDomNode.document()
        self.simple_script_executor.reset(self.current_dom)
        self.history = []
        self.current_index = -1
        self.warnings = []
        self._advance_ui_access_revision()
        self._advance_style_revision()
        self._advance_resource_revision()

    me _mark_css_animation_reconcile(reset_descendants: bool):
        val elapsed = self.monotonic_time_ms - self.animation_start_time_ms
        self.css_animation_reconcile_epoch_ms = if elapsed > 0:
            elapsed
        else:
            0
        self.css_animation_reconcile_pending = true
        if reset_descendants:
            self.css_animation_reset_descendants = true

    me prepare_css_animation_instances(width: i32):
        self.prepare_css_animation_instances_with_html(
            width, self.render_html_document()
        )

    me prepare_css_animation_instances_with_html(width: i32, html: text):
        if width != self.css_animation_viewport_width:
            self._mark_css_animation_reconcile(false)
            self.css_animation_viewport_width = width
        if not self.css_animation_reconcile_pending:
            return
        val elapsed = self.monotonic_time_ms - self.animation_start_time_ms
        val current_time_ms = if elapsed > 0: elapsed else: 0
        self.css_animation_instances = (
            simple_web_layout_reconcile_animation_instances(
                html, width, current_time_ms,
                self.css_animation_reconcile_epoch_ms,
                self.css_animation_reset_descendants,
                self.css_animation_instances
            )
        )
        self.css_animation_reconcile_pending = false
        self.css_animation_reset_descendants = false

    me current_entry() -> BrowserHistoryEntry?:
        if self.current_index >= 0 and self.current_index < self.history.len():
            return Some(self.history[self.current_index])
        nil

    me _load_page_source(
        url: text,
        html: text,
        history_source_html: text,
        target_index: i32,
        push_history: bool,
        request_method: text = "GET",
        request_body: text = "",
        request_content_type: text = ""
    ) -> Result<bool, text>:
        if not browser_resource_size_allowed(html.len()):
            self.stop_loading()
            return Err("document exceeds 50 MiB resource limit")
        val previous_document_url = self.document_url
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] load page source start"
        val resource_plan = browser_document_resource_plan(
            html, url, self.pending_content_security_policy
        )
        val script_blocks = resource_plan.script_blocks
        val next_sandbox_policy = browser_csp_header_sandbox(
            resource_plan.final_csp_policy
        )
        var admitted_script_blocks: [BrowserScriptBlock] = []
        if next_sandbox_policy.allow_scripts:
            admitted_script_blocks = script_blocks
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] script blocks={script_blocks.len()}"
        val has_runtime_scripts = (
            self.runtime_enabled and admitted_script_blocks.len() > 0
        )
        val cleaned_html = if has_runtime_scripts:
            html
        else:
            strip_script_blocks(html)
        val template_visible_html = strip_template_blocks(cleaned_html)
        val visible_html = if self.runtime_enabled:
            strip_noscript_blocks(template_visible_html)
        else:
            template_visible_html
        val visible_parse = html_tree_builder_build_with_scripts(visible_html)
        if visible_parse.truncated:
            self.stop_loading()
            return Err("resource_limit: DOM node limit exceeded (65536)")
        val initial_title = own_text(extract_title_text(html))
        val initial_body_html = own_text(extract_body_inner_html(visible_html))
        val body_html = if initial_body_html.len() > 0:
            initial_body_html
        else:
            own_text(cleaned_html)
        # Atomic document replacement: the previous page survives until all
        # response and parser validation above has succeeded.
        if val Some(previous_state) = self.runtime_state:
            val next_fetch_seq = (
                previous_state.runtime.interpreter.next_async_request_seq
            )
            if next_fetch_seq > self.next_request_seq:
                self.next_request_seq = next_fetch_seq
        self.runtime_state = nil
        self.active_load = nil
        self.pending_requests = []
        self.pending_request_head = 0
        self.inflight_requests = []
        self.subresource_request_count = 0
        self.module_source_cache = []
        self.module_redirect_urls = []
        self.loaded_module_urls = []
        self.module_eval_stack = []
        self.wasm_modules = []
        self.image_resources = []
        self.admitted_image_sources = []
        self.pending_space_activation_target = ""
        self.text_selection_target_id = ""
        self.text_selection_anchor_byte = 0
        self.text_selection_focus_byte = 0
        val style_sources = resource_plan.style_sources
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] style sources={style_sources.len()}"

        self._persist_storage_for_url(previous_document_url)
        self.content_security_policy = resource_plan.final_csp_policy
        self.csp_sandbox_policy = next_sandbox_policy
        self.pending_content_security_policy = ""
        self._activate_storage_for_url(url)
        var native_globals_diagnostic = ""
        if self.runtime_enabled and admitted_script_blocks.len() > 0:
            val cookie_text = self._script_cookie_for_url(url)
            var state = BrowserRuntimeState.create(
                own_text(url),
                initial_title,
                body_html,
                self.session_storage,
                self.local_storage,
                own_text(cookie_text),
                next_sandbox_policy.allow_same_origin
            )
            state.runtime.interpreter.next_async_request_seq = (
                self.next_request_seq
            )
            state.runtime.interpreter.timer_current_time_ms = self.monotonic_time_ms
            state.runtime.interpreter.timer_time_origin_ms = self.monotonic_time_ms
            var runtime = state.runtime
            match runtime.eval(
                "typeof require + ':' + typeof process + ':' + typeof Buffer"
            ):
                Ok(JsValue.String(value)):
                    native_globals_diagnostic = "browser native globals: {value}"
                Ok(_):
                    native_globals_diagnostic = "browser native globals: invalid-result"
                Err(error):
                    native_globals_diagnostic = "browser native globals check failed: {error.message}"
            state.runtime = runtime
            self.runtime_state = Some(state)
            if url.starts_with("https://guest.runtime/"):
                print "[BRS] runtime state created"
        else:
            self.runtime_state = nil
        self.current_url = own_text(url)
        self.document_url = own_text(url)
        self.animation_start_time_ms = self.monotonic_time_ms
        self.css_animation_instances = []
        self.css_animation_reconcile_pending = true
        self.css_animation_reconcile_epoch_ms = 0
        self.css_animation_reset_descendants = true
        self.css_animation_viewport_width = -1
        self.current_title = if initial_title.len() > 0: initial_title else: own_text(url)
        self.current_body_html = body_html
        self.current_style_html = ""
        self.source_html = own_text(history_source_html)
        self.current_dom = form_capture_defaults(visible_parse.doc)
        val published = self.publish_dom_snapshot(self.current_dom, true)
        if published.? == false:
            self._append_warning("DOM identity publication failed")
        self._advance_ui_access_revision()
        self._advance_style_revision()
        self._advance_resource_revision()
        var image_sources = resource_plan.image_sources
        val _ = _bind_body_image_source_nodes(
            self.current_dom, url, image_sources, 0, 0
        )

        var load = BrowserLoadState.create(
            document_url: url,
            source_html: history_source_html,
            request_method: request_method,
            request_body: request_body,
            request_content_type: request_content_type,
            target_index: target_index,
            push_history: push_history,
            script_blocks: admitted_script_blocks,
            style_sources: style_sources,
            image_sources: image_sources
        )
        for warning in resource_plan.warnings:
            load.append_warning(warning)
        if native_globals_diagnostic != "":
            load.append_warning(native_globals_diagnostic)
        if script_blocks.len() > 0 and not next_sandbox_policy.allow_scripts:
            load.append_warning("CSP sandbox blocked script execution")
        if script_blocks.len() >= BROWSER_MAX_DOCUMENT_SUBRESOURCES:
            load.append_warning(
                "script resource limit reached; additional scripts ignored"
            )
        if style_sources.len() >= BROWSER_MAX_DOCUMENT_SUBRESOURCES:
            load.append_warning(
                "stylesheet resource limit reached; additional styles ignored"
            )
        self.active_load = Some(load)
        if not has_runtime_scripts and next_sandbox_policy.allow_scripts:
            if val Some(fetch_url) = _browser_session_inline_fetch_url(html):
                val resolved_fetch_url = self._hsts_upgrade_url(
                    resolve_relative_url(url, fetch_url)
                )
                val is_mixed_content = (browser_session_is_secure_context(url) and
                    resolved_fetch_url.starts_with("http://") and
                    not browser_session_is_loopback_http(resolved_fetch_url))
                val is_csp_blocked = not browser_csp_allows(
                    self.content_security_policy, "connect-src",
                    url, resolved_fetch_url, false
                )
                if ((not is_mixed_content or self.broker_network_policy) and
                    (not is_csp_blocked or
                        self._broker_hsts_candidate(resolved_fetch_url))):
                    val inline_method_raw = _browser_session_inline_fetch_option(html, "method")
                    val inline_method = if inline_method_raw != "": inline_method_raw.upper() else: "GET"
                    val inline_body = _browser_session_inline_fetch_option(html, "body")
                    val inline_credentials_raw = _browser_session_inline_fetch_option(html, "credentials").trim().lower()
                    val inline_credentials = if (inline_credentials_raw == "omit" or
                        inline_credentials_raw == "include"):
                        inline_credentials_raw
                    else:
                        "same-origin"
                    self.pending_requests.push(self._build_request(
                        "fetch", resolved_fetch_url, inline_method, "",
                        inline_body, "", inline_credentials
                    ))
        if url.starts_with("https://guest.runtime/"):
            print "[BRS] active load created"
        self._advance_stylesheet_loading()

    me _ensure_runtime_state() -> BrowserRuntimeState?:
        if not self.runtime_enabled or not self.csp_sandbox_policy.allow_scripts:
            return nil
        if val Some(state) = self.runtime_state:
            return Some(state)
        val cookie_text = self._script_cookie_for_url(self.document_url)
        var state = BrowserRuntimeState.create(
            self.document_url,
            self.current_title,
            self.current_body_html,
            self.session_storage,
            self.local_storage,
            cookie_text,
            self.csp_sandbox_policy.allow_same_origin
        )
        state.runtime.interpreter.next_async_request_seq = self.next_request_seq
        state.runtime.interpreter.timer_current_time_ms = self.monotonic_time_ms
        state.runtime.interpreter.timer_time_origin_ms = self.animation_start_time_ms
        self.runtime_state = Some(state)
        val published = self.publish_dom_snapshot(self.current_dom, false)
        if published.? == false:
            self.runtime_state = nil
            return nil
        self.runtime_state

    me _sync_from_runtime(state: BrowserRuntimeState):
        var title_val = state.runtime.interpreter.host_document_title_value
        if strict_equals(title_val, JsValue.Undefined):
            title_val = state.runtime.get_host_property(
                state.document_id,
                "title"
            )
        match title_val:
            JsValue.String(title):
                if title.len() > 0:
                    self.current_title = title
            _:
                pass_dn

        val old_url = self.current_url
        val active_document_url = self.document_url
        var navigation_mode = ""
        val navigation_mode_val = state.runtime.get_host_property(
            state.location_id,
            "__simple_navigation_mode"
        )
        match navigation_mode_val:
            JsValue.String(mode):
                navigation_mode = mode
                state.runtime.set_host_property(
                    state.location_id,
                    "__simple_navigation_mode",
                    JsValue.String(v: "")
                )
            _:
                pass_dn
        val history_mode_val = state.runtime.get_host_property(
            state.history_id,
            "__simple_navigation_mode"
        )
        match history_mode_val:
            JsValue.String(mode):
                if mode != "":
                    navigation_mode = mode
                state.runtime.set_host_property(
                    state.history_id,
                    "__simple_navigation_mode",
                    JsValue.String(v: "")
                )
            _:
                pass_dn

        val href_val = state.runtime.get_host_property(
            state.location_id,
            "href"
        )
        match href_val:
            JsValue.String(href):
                if href.len() > 0:
                    var next_href = old_url
                    match normalize_script_navigation_reference_url(
                        active_document_url, href
                    ):
                        Ok(valid_href):
                            next_href = valid_href
                        Err(reason):
                            navigation_mode = ""
                            self.history_proposal_action = ""
                            self.history_proposal_url_kind = ""
                            self.history_proposal_raw_url = ""
                            self._append_warning(
                                "script navigation blocked: {reason}"
                            )
                    if navigation_mode == "pushState" or navigation_mode == "replaceState":
                        self.history_proposal_action = ""
                        self.history_proposal_url_kind = ""
                        self.history_proposal_raw_url = ""
                        var history_url_val = state.runtime.get_host_property(
                            state.location_id,
                            "__simple_history_url"
                        )
                        if strict_equals(history_url_val, JsValue.Undefined):
                            history_url_val = state.runtime.get_host_property(
                                state.history_id,
                                "__simple_url"
                            )
                        var history_url_kind = "O"
                        var history_raw_url = ""
                        match history_url_val:
                            JsValue.String(history_url):
                                history_url_kind = "V"
                                history_raw_url = history_url
                            JsValue.Null:
                                history_url_kind = "N"
                                history_raw_url = "null"
                            JsValue.Undefined:
                                pass_dn
                            _:
                                navigation_mode = ""
                                self._append_warning(
                                    "invalid history URL blocked"
                                )
                        if navigation_mode != "":
                            var candidate = active_document_url
                            var candidate_valid = true
                            if history_url_kind != "O":
                                match normalize_script_navigation_reference_url(
                                    active_document_url, history_raw_url
                                ):
                                    Ok(valid_history_url):
                                        candidate = valid_history_url
                                    Err(_):
                                        candidate_valid = false
                            val document_origin = url_origin(active_document_url)
                            if (
                                candidate_valid and
                                document_origin != "" and
                                url_origin(candidate) == document_origin and
                                rt_text_to_bytes(candidate).len() <= 8192
                            ):
                                next_href = candidate
                                self.history_proposal_action = if (
                                    navigation_mode == "pushState"
                                ):
                                    "P"
                                else:
                                    "R"
                                self.history_proposal_url_kind = (
                                    history_url_kind
                                )
                                self.history_proposal_raw_url = if (
                                    history_url_kind == "V"
                                ):
                                    history_raw_url
                                else:
                                    ""
                            else:
                                next_href = active_document_url
                                navigation_mode = ""
                                self._append_warning(
                                    "invalid history URL blocked"
                                )
                        val history_state_val = state.runtime.get_host_property(
                            state.location_id,
                            "__simple_history_state"
                        )
                        if (
                            navigation_mode != "" and
                            not strict_equals(history_state_val, JsValue.Undefined)
                        ):
                            state.runtime.set_host_property(
                                state.history_id,
                                "state",
                                history_state_val
                            )
                        state.runtime.set_host_property(
                            state.location_id,
                            "__simple_history_url",
                            JsValue.String(v: "")
                        )
                    if (
                        next_href != old_url and
                        not self.csp_sandbox_policy.allow_top_navigation
                    ):
                        next_href = old_url
                        navigation_mode = ""
                        self._append_warning(
                            "CSP sandbox blocked top navigation"
                        )
                    self.current_url = next_href
                    if navigation_mode == "pushState" or navigation_mode == "replaceState":
                        self.document_url = next_href
                    browser_session_sync_location_object(
                        state, next_href,
                        self.csp_sandbox_policy.allow_same_origin
                    )
                    state.runtime.set_host_property(
                        state.document_id,
                        "URL",
                        JsValue.String(v: next_href)
                    )
                    if navigation_mode == "assign" and next_href != old_url:
                        self._push_runtime_history_entry()
                    else if navigation_mode == "pushState":
                        self._push_runtime_history_entry()
                    else if (navigation_mode == "replaceState" and
                        self.current_index >= 0 and
                        self.current_index < self.history.len()):
                        val current_entry = self.history[self.current_index]
                        self.history[self.current_index] = (
                            BrowserHistoryEntry.create_with_policy(
                                next_href,
                                self.current_title,
                                current_entry.source_html,
                                current_entry.content_security_policy
                            )
                        )
            _:
                pass_dn

        # Track whether the latest body mutation came from script setting innerHTML or
        # textContent. Page load primes both host_body_*_value fields directly (not via
        # eval), so the values alone can't tell us which a script most recently wrote;
        # the dirty flags do. Setting innerHTML by script clears the textContent dirty
        # flag (and vice-versa) so this resolves to last-write-wins, matching the DOM.
        val inner_html_dirty = state.runtime.interpreter.host_body_inner_html_dirty
        val text_content_dirty = state.runtime.interpreter.host_body_text_content_dirty
        var inner_html_val = state.runtime.interpreter.host_body_inner_html_value
        if strict_equals(inner_html_val, JsValue.Undefined):
            inner_html_val = state.runtime.get_host_property(
                state.body_id,
                "innerHTML"
            )
        var text_content_val = state.runtime.interpreter.host_body_text_content_value
        if strict_equals(text_content_val, JsValue.Undefined):
            text_content_val = state.runtime.get_host_property(
                state.body_id,
                "textContent"
            )

        var next_body_html = self.current_body_html
        match inner_html_val:
            JsValue.String(body_html):
                next_body_html = body_html
            _:
                pass_dn

        # textContent overrides the resolved innerHTML only when a script explicitly set
        # textContent more recently than innerHTML, or when neither was script-set (the
        # page-load values are mutually consistent). This stops a stale page-load
        # textContent from clobbering a freshly script-assigned innerHTML.
        if text_content_dirty or not inner_html_dirty:
            match text_content_val:
                JsValue.String(body_text):
                    val rendered_text = escape_html_text(body_text)
                    if rendered_text != escape_html_text(html_to_text(next_body_html)):
                        next_body_html = rendered_text
                _:
                    pass_dn

        val body_changed = next_body_html != self.current_body_html
        self.current_body_html = next_body_html
        if body_changed:
            self._replace_current_body_children(next_body_html)
        val bridge_changed = (
            state.runtime.interpreter.host_dom_bridge_generation !=
            state.dom_bridge_generation
        )
        val dom_mutation_changed = (
            state.runtime.interpreter.host_dom_mutation_generation !=
            state.dom_mutation_generation
        )
        if body_changed or bridge_changed:
            if not state.adopt_dom_bridge(self.current_dom):
                if val Some(index) = self.current_dom_identity_index():
                    val _ = state.publish_dom(
                        self.current_dom, self.document_generation(), index
                    )
        if body_changed or bridge_changed or dom_mutation_changed:
            val dom_sync = state.sync_dom(self.current_dom)
            if dom_sync.changed:
                self.current_dom = dom_sync.root
                self._advance_ui_access_revision()
                self._sync_body_html_from_dom()
                val synced_body_text = html_to_text(self.current_body_html)
                state.runtime.set_host_property(
                    state.body_id, "innerHTML",
                    JsValue.String(v: self.current_body_html)
                )
                state.runtime.set_host_property(
                    state.body_id, "textContent",
                    JsValue.String(v: synced_body_text)
                )
                var synced_interpreter = state.runtime.interpreter
                synced_interpreter.host_body_inner_html_value = JsValue.String(
                    v: self.current_body_html
                )
                synced_interpreter.host_body_text_content_value = JsValue.String(
                    v: synced_body_text
                )
                synced_interpreter.host_body_inner_html_dirty = false
                synced_interpreter.host_body_text_content_dirty = false
                state.runtime.interpreter = synced_interpreter
            state.dom_mutation_generation = (
                state.runtime.interpreter.host_dom_mutation_generation
            )
            self._mark_css_animation_reconcile(
                body_changed or bridge_changed
            )
            if (
                self.active_load == nil and not self.is_loading and
                (
                    (
                        (body_changed or bridge_changed) and
                        self.current_body_html.lower().contains("url(")
                    ) or
                    dom_sync.image_source_changed
                )
            ):
                self._reconcile_dynamic_image_sources(nil)
        if self.csp_sandbox_policy.allow_same_origin:
            self.session_storage = storage_pairs_from_object(
                state, state.session_storage_id
            )
            self.local_storage = storage_pairs_from_object(
                state, state.local_storage_id
            )
            self._persist_storage_for_url(active_document_url)
            state.runtime = sync_storage_runtime_state(
                state.runtime, state.session_storage_id, self.session_storage
            )
            state.runtime = sync_storage_runtime_state(
                state.runtime, state.local_storage_id, self.local_storage
            )
        else:
            self.session_storage = []
            self.local_storage = []

        var cookie_interpreter = state.runtime.interpreter
        if cookie_interpreter.host_document_cookie_write_overflow:
            self.script_cookie_write_overflow = true
            cookie_interpreter.host_document_cookie_write_overflow = false
        val cookie_writes = (
            cookie_interpreter.pending_host_document_cookie_writes
        )
        cookie_interpreter.pending_host_document_cookie_writes = []
        state.runtime.interpreter = cookie_interpreter
        for cookie_write in cookie_writes:
            self._store_cookie_text(
                cookie_write, active_document_url, false
            )

        var cookie_val = state.runtime.interpreter.host_document_cookie_value
        if strict_equals(cookie_val, JsValue.Undefined):
            cookie_val = state.runtime.get_host_property(
                state.document_id,
                "cookie"
            )
        match cookie_val:
            JsValue.String(cookie_text):
                val visible_cookie_before_sync = self._script_cookie_for_url(active_document_url)
                if (cookie_writes.len() == 0 and
                    cookie_text != visible_cookie_before_sync):
                    self._store_cookie_text(cookie_text, active_document_url, false)
            _:
                pass_dn

        val visible_cookie_text = self._script_cookie_for_url(active_document_url)
        var runtime = state.runtime
        var interpreter = runtime.interpreter
        interpreter.host_document_cookie_value = (
            if self.csp_sandbox_policy.allow_same_origin:
                JsValue.String(v: visible_cookie_text)
            else:
                JsValue.Undefined
        )
        runtime.interpreter = interpreter
        state.runtime = runtime
        state.runtime.set_host_property(
            state.document_id,
            "readyState",
            JsValue.String(v: "complete")
        )

    me _push_runtime_history_entry():
        var source_html = self.source_html
        if self.current_index >= 0 and self.current_index < self.history.len():
            source_html = self.history[self.current_index].source_html
        val entry = BrowserHistoryEntry.create_with_policy(
            url: self.current_url,
            title: self.current_title,
            source_html: source_html,
            policy: self.content_security_policy
        )
        self.history = browser_history_push_bounded(
            self.history, self.current_index, entry
        )
        self.current_index = self.history.len() - 1

    me _sync_runtime_cookie_string():
        if val Some(state) = self.runtime_state:
            val visible_cookie_text = self._script_cookie_for_url(self.document_url)
            val cookie_value = if self.csp_sandbox_policy.allow_same_origin:
                JsValue.String(v: visible_cookie_text)
            else:
                JsValue.Undefined
            var runtime = state.runtime
            var interpreter = runtime.interpreter
            interpreter.host_document_cookie_value = cookie_value
            runtime.interpreter = interpreter
            runtime.set_host_property(
                state.document_id,
                "cookie",
                cookie_value
            )
            state.runtime = runtime
            self.runtime_state = Some(state)

    me _build_request(
        kind: text, url: text, method: text, headers: text, body: text,
        content_type: text, credentials: text = "include"
    ) -> BrowserRequest:
        val request_url = without_fragment(self._hsts_upgrade_url(url))
        val normalized_method = if method.trim() != "": method.upper() else: "GET"
        val opaque_initiator = (
            self.csp_sandbox_policy.active and
            not self.csp_sandbox_policy.allow_same_origin
        )
        val initiator_origin = if opaque_initiator:
            "null"
        else:
            url_origin(self.document_url)
        val site_for_cookies_url = if opaque_initiator:
            ""
        else:
            self.document_url
        val effective_credentials = if opaque_initiator:
            "omit"
        else:
            credentials
        val is_top_level_navigation = kind == "document"
        val request_headers = self._headers_with_session_cookie(
            headers, request_url, normalized_method, site_for_cookies_url,
            is_top_level_navigation, effective_credentials
        )
        val request_id = "{kind}-{self.next_request_seq}"
        self.next_request_seq = self.next_request_seq + 1
        val request = BrowserRequest.create(
            id: request_id,
            kind: kind,
            url: request_url,
            method: normalized_method,
            headers: request_headers,
            body: body,
            content_type: content_type
        )
        request.initiator_origin = initiator_origin
        request.site_for_cookies_url = site_for_cookies_url
        request.credentials = effective_credentials
        request.is_top_level_navigation = is_top_level_navigation
        val cookie_writes = self.take_pending_script_cookie_writes()
        if not opaque_initiator:
            request.script_cookie_writes = cookie_writes
        request

fn browser_session_sync_location_object(
    state: BrowserRuntimeState, href: text,
    origin_storage_allowed: bool = true
):
    state.runtime.set_host_property(state.location_id, "href", JsValue.String(v: href))
    state.runtime.set_host_property(state.location_id, "protocol", JsValue.String(v: url_protocol(href)))
    state.runtime.set_host_property(state.location_id, "host", JsValue.String(v: url_host(href)))
    state.runtime.set_host_property(
        state.location_id, "origin",
        JsValue.String(
            v: if origin_storage_allowed: url_origin(href) else: "null"
        )
    )
    state.runtime.set_host_property(state.location_id, "pathname", JsValue.String(v: url_pathname(href)))
    state.runtime.set_host_property(state.location_id, "search", JsValue.String(v: url_search(href)))
    state.runtime.set_host_property(state.location_id, "hash", JsValue.String(v: url_hash(href)))
