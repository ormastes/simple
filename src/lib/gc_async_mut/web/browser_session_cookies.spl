# Browser session — cookie management functions.
#
# Free functions for:
# - merge_cookie_text: merge a Set-Cookie header value into the cookie jar
# - parse_cookie_line: parse a single cookie string into BrowserCookie
# - upsert_cookie: add-or-replace a cookie in the jar
# - cookie_text_for_url: build a Cookie: header value for a given URL
# - cookie_matches_url: test whether a stored cookie applies to a URL
# - normalize_cookie_path / normalize_cookie_domain
# - cookie_max_age_is_expired / cookie_expires_is_past
# - cookie_text_has_attributes / split_cookie_assignments
# - split_text / join_text: text-splitting helpers used by cookie parsing

use common.string_builder.{StringBuilder}
use std.gc_async_mut.web.browser_session.{BrowserCookie}
use std.gc_async_mut.web.browser_session_url.{find_text, url_pathname, url_hostname}
use common.web.public_suffix.{is_public_suffix}
use common.web.host_policy.{is_ip_host_literal}

val BROWSER_COOKIE_BYTES_LIMIT = 4096
val BROWSER_COOKIES_PER_DOMAIN_LIMIT = 50
val BROWSER_COOKIE_JAR_LIMIT = 3000

fn split_text(input: text, delimiter: text) -> [text]:
    val delimiter_len = delimiter.len()
    if delimiter_len == 0:
        return [input]
    val input_len = input.len()
    val part_count = count_split_text_parts(input, delimiter, delimiter_len, input_len)
    var out: [text] = [input; part_count]
    var pos = 0
    var out_idx = 0
    while pos <= input_len:
        val next = find_text(input, delimiter, pos)
        if next < 0:
            out[out_idx] = input.slice(pos, input_len)
            return out
        out[out_idx] = input.slice(pos, next)
        out_idx = out_idx + 1
        pos = next + delimiter_len
    out

fn count_split_text_parts(input: text, delimiter: text, delimiter_len: i32, input_len: i32) -> i32:
    var count = 1
    var pos = 0
    while pos <= input_len:
        val next = find_text(input, delimiter, pos)
        if next < 0:
            return count
        count = count + 1
        pos = next + delimiter_len
    count

fn join_text(parts: [text], delimiter: text) -> text:
    val sb = StringBuilder.new()
    var i = 0
    val part_count = parts.len()
    while i < part_count:
        if i > 0:
            sb.push(delimiter)
        sb.push(parts[i])
        i = i + 1
    sb.to_text()

fn merge_cookie_text(existing: [BrowserCookie], cookie_text: text) -> [BrowserCookie]:
    var jar = existing
    if cookie_text_has_attributes(cookie_text):
        if val Some(cookie) = parse_cookie_line(cookie_text):
            return upsert_cookie(jar, cookie)
    val cookie_lines = split_cookie_assignments(cookie_text)
    for line in cookie_lines:
        if val Some(cookie) = parse_cookie_line(line):
            jar = upsert_cookie(jar, cookie)
    jar

fn merge_cookie_text_for_url(existing: [BrowserCookie], cookie_text: text, url: text, from_http: bool) -> [BrowserCookie]:
    var jar = existing
    if cookie_text_has_attributes(cookie_text):
        if val Some(cookie) = parse_cookie_line_for_url(cookie_text, url, from_http):
            return upsert_cookie(jar, cookie)
        return jar
    for line in split_cookie_assignments(cookie_text):
        if val Some(cookie) = parse_cookie_line_for_url(line, url, from_http):
            jar = upsert_cookie(jar, cookie)
    jar

fn cookie_text_has_attributes(cookie_text: text) -> bool:
    val segments = split_text(cookie_text.trim(), ";")
    var i = 1
    val segment_count = segments.len()
    while i < segment_count:
        val seg = segments[i].trim()
        val eq = find_text(seg, "=", 0)
        val key = if eq > 0:
            seg.slice(0, eq).trim().lower()
        else:
            seg.lower()
        if key == "path" or
           key == "domain" or
           key == "expires" or
           key == "max-age" or
           key == "secure" or
           key == "samesite" or
           key == "httponly" or
           key == "partitioned":
            return true
        i = i + 1
    false

fn split_cookie_assignments(cookie_text: text) -> [text]:
    val part_count = count_cookie_assignments(cookie_text)
    if part_count == 0:
        return []
    var parts: [text] = [""; part_count]
    var i = 0
    var part_idx = 0
    val segments = split_text(cookie_text, ";")
    val segment_count = segments.len()
    while i < segment_count:
        val trimmed = segments[i].trim()
        if trimmed.len() > 0 and trimmed.contains("="):
            parts[part_idx] = trimmed
            part_idx = part_idx + 1
        i = i + 1
    parts

fn count_cookie_assignments(cookie_text: text) -> i32:
    var count = 0
    var i = 0
    val segments = split_text(cookie_text, ";")
    val segment_count = segments.len()
    while i < segment_count:
        val trimmed = segments[i].trim()
        if trimmed.len() > 0 and trimmed.contains("="):
            count = count + 1
        i = i + 1
    count

fn parse_cookie_line(cookie_line: text) -> BrowserCookie?:
    val trimmed = cookie_line.trim()
    if trimmed.len() == 0 or trimmed.len() > BROWSER_COOKIE_BYTES_LIMIT or
       cookie_line.contains("\r") or cookie_line.contains("\n"):
        return nil
    val segments = split_text(trimmed, ";")
    if segments.len() == 0:
        return nil
    val base = segments[0].trim()
    val eq = find_text(base, "=", 0)
    if eq <= 0:
        return nil
    val name = base.slice(0, eq).trim()
    val value = base.slice(eq + 1, base.len()).trim()
    val lowered_name = name.lower()
    if lowered_name == "path" or
       lowered_name == "domain" or
       lowered_name == "expires" or
       lowered_name == "max-age" or
       lowered_name == "secure" or
       lowered_name == "samesite" or
       lowered_name == "httponly" or
       lowered_name == "partitioned":
        return nil
    var path = ""
    var domain = ""
    var expired = false
    var i = 1
    val segment_count = segments.len()
    while i < segment_count:
        val seg = segments[i].trim()
        val seg_eq = find_text(seg, "=", 0)
        if seg_eq > 0:
            val key = seg.slice(0, seg_eq).trim().lower()
            val attr_value = seg.slice(seg_eq + 1, seg.len()).trim()
            if key == "path":
                path = normalize_cookie_path(attr_value)
            else if key == "domain":
                domain = normalize_cookie_domain(attr_value)
            else if key == "max-age":
                expired = cookie_max_age_is_expired(attr_value)
            else if key == "expires":
                expired = cookie_expires_is_past(attr_value)
        i = i + 1
    Some(BrowserCookie.create(name: name, value: value, path: path, domain: domain, expired: expired))

fn parse_cookie_line_for_url(cookie_line: text, url: text, from_http: bool) -> BrowserCookie?:
    val parsed = parse_cookie_line(cookie_line)
    if parsed == nil:
        return nil
    if val Some(cookie) = parsed:
        val host = normalize_cookie_domain(url_hostname(url))
        if host == "":
            return nil
        val secure = cookie_has_flag(cookie_line, "secure")
        val http_only = from_http and cookie_has_flag(cookie_line, "httponly")
        val https = url.starts_with("https://")
        val has_domain_attribute = cookie_has_attribute(cookie_line, "domain")
        val partitioned = cookie_has_attribute(cookie_line, "partitioned")
        if partitioned:
            return nil
        if val Some(same_site) = cookie_attribute_value(cookie_line, "samesite"):
            if same_site.lower() == "none" and not secure:
                return nil
        if cookie.name.starts_with("__Secure-") and (not secure or not https):
            return nil
        if cookie.name.starts_with("__Host-"):
            if not secure or not https or has_domain_attribute:
                return nil
            if cookie_attribute_value(cookie_line, "path") != Some("/"):
                return nil
        val host_only = cookie.domain == ""
        if has_domain_attribute:
            if cookie.domain == "" or is_ip_host_literal(host):
                return nil
            if is_public_suffix(cookie.domain):
                return nil
        val domain = if host_only: host else: cookie.domain
        if not host_only and host != domain and not host.ends_with(".{domain}"):
            return nil
        if secure and not https:
            return nil
        var path = browser_cookie_default_path(url)
        if val Some(path_attribute) = cookie_attribute_value(
            cookie_line, "path"
        ):
            if path_attribute.starts_with("/"):
                path = normalize_cookie_path(path_attribute)
        return Some(BrowserCookie.create_scoped(cookie.name, cookie.value, path, domain, cookie.expired, secure, http_only, host_only))
    nil

fn browser_cookie_default_path(url: text) -> text:
    val pathname = url_pathname(url)
    if not pathname.starts_with("/"):
        return "/"
    val last_slash = pathname.last_index_of("/")
    if last_slash <= 0:
        return "/"
    pathname.slice(0, last_slash)

fn cookie_has_flag(cookie_line: text, name: text) -> bool:
    val segments = split_text(cookie_line, ";")
    var index = 1
    while index < segments.len():
        if segments[index].trim().lower() == name:
            return true
        index = index + 1
    false

fn cookie_has_attribute(cookie_line: text, name: text) -> bool:
    val segments = split_text(cookie_line, ";")
    var index = 1
    while index < segments.len():
        val segment = segments[index].trim()
        val eq = find_text(segment, "=", 0)
        val key = if eq < 0: segment else: segment.slice(0, eq).trim()
        if key.lower() == name:
            return true
        index = index + 1
    false

fn cookie_attribute_value(cookie_line: text, name: text) -> text?:
    val segments = split_text(cookie_line, ";")
    var index = 1
    while index < segments.len():
        val segment = segments[index].trim()
        val eq = find_text(segment, "=", 0)
        if eq > 0 and segment.slice(0, eq).trim().lower() == name:
            return Some(segment.slice(eq + 1, segment.len()).trim())
        index = index + 1
    nil


fn upsert_cookie(existing: [BrowserCookie], cookie: BrowserCookie) -> [BrowserCookie]:
    val existing_count = existing.len()
    val found_index = cookie_index(existing, cookie)
    if found_index < 0 and not cookie.expired:
        if existing_count >= BROWSER_COOKIE_JAR_LIMIT:
            return existing
        var domain_count = 0
        for current in existing:
            if current.domain == cookie.domain:
                domain_count = domain_count + 1
        if domain_count >= BROWSER_COOKIES_PER_DOMAIN_LIMIT:
            return existing
    val output_count = if found_index >= 0:
        if cookie.expired: existing_count - 1 else: existing_count
    else:
        if cookie.expired: existing_count else: existing_count + 1
    if output_count == 0:
        return []
    val seed = if existing_count > 0: existing[0] else: cookie
    var out: [BrowserCookie] = [seed; output_count]
    var found_existing = false
    var out_idx = 0
    for current in existing:
        if current.name == cookie.name and current.path == cookie.path and current.domain == cookie.domain:
            if not cookie.expired:
                out[out_idx] = cookie
                out_idx = out_idx + 1
            found_existing = true
        else:
            out[out_idx] = current
            out_idx = out_idx + 1
    if not found_existing and not cookie.expired:
        out[out_idx] = cookie
    out

fn cookie_index(existing: [BrowserCookie], cookie: BrowserCookie) -> i32:
    var idx = 0
    val existing_count = existing.len()
    while idx < existing_count:
        val current = existing[idx]
        if current.name == cookie.name and current.path == cookie.path and current.domain == cookie.domain:
            return idx
        idx = idx + 1
    -1

fn cookie_text_for_url(cookies: [BrowserCookie], url: text) -> text:
    val part_count = count_cookies_for_url(cookies, url)
    if part_count == 0:
        return ""
    var parts: [text] = [""; part_count]
    var idx = 0
    var part_idx = 0
    val cookie_count = cookies.len()
    while idx < cookie_count:
        val cookie = cookies[idx]
        if cookie_matches_url(cookie, url):
            parts[part_idx] = "{cookie.name}={cookie.value}"
            part_idx = part_idx + 1
        idx = idx + 1
    join_text(parts, "; ")

fn document_cookie_text_for_url(cookies: [BrowserCookie], url: text) -> text:
    var visible: [BrowserCookie] = []
    for cookie in cookies:
        if not cookie.http_only:
            visible.push(cookie)
    cookie_text_for_url(visible, url)

fn count_cookies_for_url(cookies: [BrowserCookie], url: text) -> i32:
    var count = 0
    var idx = 0
    val cookie_count = cookies.len()
    while idx < cookie_count:
        if cookie_matches_url(cookies[idx], url):
            count = count + 1
        idx = idx + 1
    count

fn cookie_matches_url(cookie: BrowserCookie, url: text) -> bool:
    if cookie.secure and not url.starts_with("https://"):
        return false
    if cookie.domain.len() > 0:
        val host = normalize_cookie_domain(url_hostname(url))
        if cookie.host_only and host != cookie.domain:
            return false
        if not cookie.host_only and host != cookie.domain and not host.ends_with(".{cookie.domain}"):
            return false
    if cookie.path.len() > 0:
        val pathname = url_pathname(url)
        if pathname != cookie.path and
           not cookie.path.ends_with("/") and
           not pathname.starts_with(cookie.path + "/"):
            return false
        if cookie.path.ends_with("/") and not pathname.starts_with(cookie.path):
            return false
    true

fn normalize_cookie_path(path: text) -> text:
    val trimmed = path.trim()
    if trimmed.len() == 0:
        return ""
    if trimmed.starts_with("/"):
        return trimmed
    "/" + trimmed

fn normalize_cookie_domain(domain: text) -> text:
    var normalized = domain.trim().lower()
    var normalized_len = normalized.len()
    while normalized.starts_with(".") and normalized_len > 1:
        normalized = normalized.slice(1, normalized.len())
        normalized_len = normalized.len()
    normalized

fn cookie_max_age_is_expired(value: text) -> bool:
    val trimmed = value.trim()
    trimmed == "0" or trimmed.starts_with("-")

fn cookie_expires_is_past(value: text) -> bool:
    val lowered = value.trim().lower()
    lowered.contains("01 jan 1970") or
        lowered.contains("jan 1970") or
        lowered.contains("1970") or
        lowered.contains("1969")
