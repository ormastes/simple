# Browser session secure-context helper.
#
# Extracted from browser_session.spl — kept separate so BrowserRuntimeState.create
# can call it without pulling in the full session module.

use std.gc_async_mut.web.browser_session_url.{
    url_hostname, url_origin, url_pathname
}

fn browser_session_is_loopback_http(url: text) -> bool:
    if not url.starts_with("http://"):
        return false
    val host = url_hostname(url).lower()
    host == "localhost" or host == "127.0.0.1" or host == "::1"

fn browser_session_is_secure_context(url: text) -> bool:
    if url.starts_with("https://"):
        return true
    if browser_session_is_loopback_http(url):
        return true
    if url.starts_with("file://") or url.starts_with("about:"):
        return true
    false

fn browser_meta_content_security_policy(policy: text) -> text:
    var kept: [text] = []
    for raw_directive in policy.split(";"):
        val directive = raw_directive.trim()
        if directive == "":
            continue
        val name = directive.replace(
            "\t", " "
        ).replace("\n", " ").replace("\r", " ").split(" ")[0].lower()
        if (
            name == "report-uri" or name == "frame-ancestors" or
            name == "sandbox"
        ):
            continue
        kept.push(directive)
    kept.join("; ")

fn _browser_csp_normalize_http_scheme(url: text) -> text:
    val lower = url.lower()
    if lower.starts_with("https://"):
        return "https://" + url.slice(8, url.len())
    if lower.starts_with("http://"):
        return "http://" + url.slice(7, url.len())
    url

fn _browser_csp_source_origin_matches_url(
    source: text, target_url: text
) -> bool:
    val source_url = _browser_csp_normalize_http_scheme(source)
    val target = _browser_csp_normalize_http_scheme(target_url)
    url_origin(source_url).lower() == url_origin(target).lower()

fn _browser_csp_normalize_path(path: text) -> text:
    val raw_segments = path.split("/")
    var segments: [text] = []
    var segment_index = 0
    for raw_segment in raw_segments:
        val dot_segment = raw_segment.lower().replace("%2e", ".")
        if dot_segment == "..":
            if segments.len() > 0:
                segments.pop()
        elif dot_segment != ".":
            if segment_index > 0 or raw_segment != "":
                segments.push(raw_segment)
        segment_index = segment_index + 1
    if segments.len() == 0:
        return "/"
    var normalized = "/" + segments.join("/")
    val last_segment = raw_segments[raw_segments.len() - 1]
    val last_dot_segment = last_segment.lower().replace("%2e", ".")
    if normalized != "/" and (
        last_dot_segment == "." or last_dot_segment == ".."
    ):
        normalized = normalized + "/"
    normalized

pub fn browser_csp_source_matches_url(
    source: text, target_url: text
) -> bool:
    val source_url = _browser_csp_normalize_http_scheme(source)
    val target = _browser_csp_normalize_http_scheme(target_url)
    if not _browser_csp_source_origin_matches_url(source, target_url):
        return false
    val source_path = _browser_csp_normalize_path(url_pathname(source_url))
    val target_path = _browser_csp_normalize_path(url_pathname(target))
    if source_path == "" or source_path == "/":
        return true
    if source_path.ends_with("/"):
        return target_path.starts_with(source_path)
    target_path == source_path

fn browser_csp_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool
) -> bool:
    _browser_csp_allows(
        policy, directive, document_url, target_url, is_inline, false
    )

fn browser_csp_allows_after_redirect(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool
) -> bool:
    _browser_csp_allows(
        policy, directive, document_url, target_url, is_inline, true
    )

fn _browser_csp_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool,
    after_redirect: bool
) -> bool:
    if policy.trim() == "":
        return true
    for raw_policy in policy.split("\n"):
        if raw_policy.trim() != "" and not browser_csp_single_policy_allows(
            raw_policy, directive, document_url, target_url, is_inline,
            after_redirect
        ):
            return false
    true

fn browser_csp_single_policy_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool,
    after_redirect: bool
) -> bool:
    var sources = ""
    var found = false
    for raw_directive in policy.replace("\t", " ").split(";"):
        val parts = raw_directive.trim().split(" ")
        if not found and parts.len() > 0 and
           parts[0].trim().lower() == directive:
            sources = raw_directive.trim().substring(parts[0].len()).trim()
            found = true
    if not found and directive != "default-src":
        return browser_csp_single_policy_allows(
            policy, "default-src", document_url, target_url, is_inline,
            after_redirect
        )
    if not found:
        return true
    for raw_source in sources.split(" "):
        val source = raw_source.trim()
        val lower_source = source.lower()
        if source == "":
            continue
        if lower_source == "'none'":
            continue
        if is_inline:
            if lower_source == "'unsafe-inline'":
                return true
            continue
        if source == "*":
            return true
        if lower_source == "'self'" and
           url_origin(target_url) == url_origin(document_url):
            return true
        if lower_source.ends_with(":") and
           target_url.lower().starts_with(lower_source):
            return true
        if (lower_source.starts_with("http://") or
            lower_source.starts_with("https://")) and
           ((after_redirect and
             _browser_csp_source_origin_matches_url(source, target_url)) or
            (not after_redirect and
             browser_csp_source_matches_url(source, target_url))):
            return true
    false
