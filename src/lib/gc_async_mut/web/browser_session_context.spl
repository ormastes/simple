# Browser session secure-context helper.
#
# Extracted from browser_session.spl — kept separate so BrowserRuntimeState.create
# can call it without pulling in the full session module.

fn browser_session_is_secure_context(url: text) -> bool:
    if url.starts_with("https://"):
        return true
    if url.starts_with("http://localhost") or url.starts_with("http://127.0.0.1"):
        return true
    if url.starts_with("file://") or url.starts_with("about:"):
        return true
    false

fn browser_meta_content_security_policy(policy: text) -> text:
    var kept: [text] = []
    for raw_directive in policy.split(";"):
        val directive = raw_directive.trim()
        if directive == "":
            continue
        val name = directive.replace(
            "\t", " "
        ).replace("\n", " ").replace("\r", " ").split(" ")[0].lower()
        if (
            name == "report-uri" or name == "frame-ancestors" or
            name == "sandbox"
        ):
            continue
        kept.push(directive)
    kept.join("; ")

fn _browser_csp_normalize_http_scheme(url: text) -> text:
    val lower = url.lower()
    if lower.starts_with("https://"):
        return "https://" + url.slice(8, url.len())
    if lower.starts_with("http://"):
        return "http://" + url.slice(7, url.len())
    url

fn _browser_csp_port_valid(port: text) -> bool:
    if port == "*":
        return true
    if port == "" or port.len() > 5:
        return false
    var value: i64 = 0
    var i = 0
    while i < port.len():
        val code = port.char_code_at(i)
        if code < 48 or code > 57:
            return false
        value = value * 10 + (code - 48)
        i = i + 1
    value > 0 and value <= 65535

fn _browser_csp_host_port(host: text) -> text:
    if host.starts_with("["):
        val bracket_end = host.index_of("]")
        if bracket_end < 0 or bracket_end + 1 >= host.len():
            return ""
        if host.slice(bracket_end + 1, bracket_end + 2) != ":":
            return "\u0000invalid"
        if bracket_end + 2 >= host.len():
            return "\u0000invalid"
        return host.slice(bracket_end + 2, host.len())
    val colon = host.last_index_of(":")
    if colon < 0:
        return ""
    if colon + 1 >= host.len():
        return "\u0000invalid"
    host.slice(colon + 1, host.len())

fn _browser_csp_default_port(protocol: text) -> text:
    if protocol == "https:": "443" elif protocol == "http:": "80" else: ""

fn _browser_csp_effective_port(url: text) -> text:
    val explicit = _browser_csp_host_port(url_host(url))
    if explicit != "": explicit else: _browser_csp_default_port(url_protocol(url))

fn _browser_csp_scheme_matches(
    source_protocol: text, document_protocol: text, target_protocol: text
) -> bool:
    val expected = if source_protocol != "":
        source_protocol
    else:
        document_protocol
    target_protocol == expected or (
        expected == "http:" and target_protocol == "https:"
    )

fn _browser_csp_hostname_matches(source_host: text, target_host: text) -> bool:
    val source_lower = source_host.lower()
    val target_lower = target_host.lower()
    if source_lower == "*":
        return target_lower != ""
    if source_lower.starts_with("*."):
        val suffix = source_lower.slice(2, source_lower.len())
        return (
            suffix != "" and target_lower != suffix and
            target_lower.ends_with("." + suffix)
        )
    source_lower != "" and source_lower == target_lower

fn _browser_csp_host_source_url(source: text, document_url: text) -> text:
    val normalized = _browser_csp_normalize_http_scheme(source.trim())
    if normalized.starts_with("http://") or normalized.starts_with("https://"):
        return normalized
    val protocol = url_protocol(_browser_csp_normalize_http_scheme(document_url))
    if protocol != "http:" and protocol != "https:":
        return ""
    protocol + "//" + normalized

fn _browser_csp_source_origin_matches_url(
    source: text, document_url: text, target_url: text
) -> bool:
    val source_has_scheme = (
        source.lower().starts_with("http://") or
        source.lower().starts_with("https://")
    )
    val source_url = _browser_csp_host_source_url(source, document_url)
    val document = _browser_csp_normalize_http_scheme(document_url)
    val target = _browser_csp_normalize_http_scheme(target_url)
    if source_url == "" or not _browser_csp_scheme_matches(
        if source_has_scheme: url_protocol(source_url) else: "",
        url_protocol(document), url_protocol(target)
    ):
        return false
    if not _browser_csp_hostname_matches(
        url_hostname(source_url), url_hostname(target)
    ):
        return false
    val source_port = _browser_csp_host_port(url_host(source_url))
    if source_port == "\u0000invalid" or not (
        source_port == "" or _browser_csp_port_valid(source_port)
    ):
        return false
    if source_port == "*":
        return true
    if source_port != "":
        return source_port == _browser_csp_effective_port(target)
    _browser_csp_effective_port(target) == _browser_csp_default_port(
        url_protocol(target)
    )

fn _browser_csp_normalize_path(path: text) -> text:
    val raw_segments = path.split("/")
    var segments: [text] = []
    var segment_index = 0
    for raw_segment in raw_segments:
        val dot_segment = raw_segment.lower().replace("%2e", ".")
        if dot_segment == "..":
            if segments.len() > 0:
                segments.pop()
        elif dot_segment != ".":
            if segment_index > 0 or raw_segment != "":
                segments.push(raw_segment)
        segment_index = segment_index + 1
    if segments.len() == 0:
        return "/"
    var normalized = "/" + segments.join("/")
    val last_segment = raw_segments[raw_segments.len() - 1]
    val last_dot_segment = last_segment.lower().replace("%2e", ".")
    if normalized != "/" and (
        last_dot_segment == "." or last_dot_segment == ".."
    ):
        normalized = normalized + "/"
    normalized

pub fn browser_csp_source_matches_url(
    source: text, target_url: text
) -> bool:
    val source_url = _browser_csp_host_source_url(source, target_url)
    val target = _browser_csp_normalize_http_scheme(target_url)
    if not _browser_csp_source_origin_matches_url(
        source, target_url, target_url
    ):
        return false
    val source_path = _browser_csp_normalize_path(url_pathname(source_url))
    val target_path = _browser_csp_normalize_path(url_pathname(target))
    if source_path == "" or source_path == "/":
        return true
    if source_path.ends_with("/"):
        return target_path.starts_with(source_path)
    target_path == source_path

pub fn browser_csp_policy_valid(policy: text) -> bool:
    if policy.len() > BROWSER_CSP_SANDBOX_MAX_POLICY_BYTES:
        return false
    var policy_count: i64 = 0
    for raw_policy in policy.split("\n"):
        if raw_policy.trim() != "":
            policy_count = policy_count + 1
            if policy_count > BROWSER_CSP_SANDBOX_MAX_POLICIES:
                return false
    true

pub fn browser_csp_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool
) -> bool:
    _browser_csp_allows(
        policy, directive, document_url, target_url, is_inline, false, true
    )

pub fn browser_csp_form_action_allows(
    policy: text, document_url: text, target_url: text
) -> bool:
    """Apply form-action without the fetch-directive default-src fallback."""
    _browser_csp_allows(
        policy, "form-action", document_url, target_url, false, false, false
    )

pub fn browser_csp_form_action_allows_after_redirect(
    policy: text, document_url: text, target_url: text
) -> bool:
    """Reauthorize a form redirect while preserving its initiating policy."""
    _browser_csp_allows(
        policy, "form-action", document_url, target_url, false, true, false
    )

fn browser_csp_allows_after_redirect(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool
) -> bool:
    _browser_csp_allows(
        policy, directive, document_url, target_url, is_inline, true, true
    )

fn _browser_csp_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool,
    after_redirect: bool,
    default_src_fallback: bool
) -> bool:
    if policy.trim() == "":
        return true
    for raw_policy in policy.split("\n"):
        if raw_policy.trim() != "" and not browser_csp_single_policy_allows(
            raw_policy, directive, document_url, target_url, is_inline,
            after_redirect, default_src_fallback
        ):
            return false
    true

fn browser_csp_single_policy_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool,
    after_redirect: bool,
    default_src_fallback: bool
) -> bool:
    var sources = ""
    var found = false
    for raw_directive in policy.replace("\t", " ").split(";"):
        val parts = raw_directive.trim().split(" ")
        if not found and parts.len() > 0 and
           parts[0].trim().lower() == directive:
            sources = raw_directive.trim().substring(parts[0].len()).trim()
            found = true
    if (not found and default_src_fallback and
        directive != "default-src"):
        return browser_csp_single_policy_allows(
            policy, "default-src", document_url, target_url, is_inline,
            after_redirect, false
        )
    if not found:
        return true
    for raw_source in sources.split(" "):
        val source = raw_source.trim()
        val lower_source = source.lower()
        if source == "":
            continue
        if lower_source == "'none'":
            continue
        if is_inline:
            if lower_source == "'unsafe-inline'":
                return true
            continue
        if source == "*":
            return true
        if lower_source == "'self'" and
           url_origin(target_url).lower() == url_origin(document_url).lower():
            return true
        if lower_source.ends_with(":") and
           not lower_source.contains("/") and
           _browser_csp_scheme_matches(
               lower_source,
               url_protocol(_browser_csp_normalize_http_scheme(document_url)),
               url_protocol(_browser_csp_normalize_http_scheme(target_url))
           ):
            return true
        val host_source = (
            lower_source.starts_with("http://") or
            lower_source.starts_with("https://") or
            (not lower_source.contains("://") and
             not lower_source.ends_with(":") and
             not lower_source.starts_with("'"))
        )
        if host_source and _browser_csp_source_origin_matches_url(
            source, document_url, target_url
        ) and (after_redirect or
            _browser_csp_normalize_path(url_pathname(
                _browser_csp_host_source_url(source, document_url)
            )) == "/" or
            browser_csp_source_matches_url(
                _browser_csp_host_source_url(source, document_url), target_url
            )):
            return true
    false
