# Browser session secure-context helper.
#
# Extracted from browser_session.spl — kept separate so BrowserRuntimeState.create
# can call it without pulling in the full session module.

use std.gc_async_mut.web.browser_session_url.{
    url_hostname, url_origin, url_pathname
}

val BROWSER_CSP_SANDBOX_MAX_POLICIES: i64 = 64
val BROWSER_CSP_SANDBOX_MAX_POLICY_BYTES: i64 = 65536
val BROWSER_CSP_SANDBOX_MAX_TOKENS: i64 = 64

pub class BrowserCspSandboxPolicy:
    active: bool
    allow_scripts: bool
    allow_forms: bool
    allow_same_origin: bool
    allow_popups: bool
    allow_top_navigation: bool

    static fn unrestricted() -> BrowserCspSandboxPolicy:
        BrowserCspSandboxPolicy(
            active: false,
            allow_scripts: true,
            allow_forms: true,
            allow_same_origin: true,
            allow_popups: true,
            allow_top_navigation: true
        )

    static fn deny_all() -> BrowserCspSandboxPolicy:
        BrowserCspSandboxPolicy(
            active: true,
            allow_scripts: false,
            allow_forms: false,
            allow_same_origin: false,
            allow_popups: false,
            allow_top_navigation: false
        )

fn _browser_csp_sandbox_has_token(
    directive: text, expected: text
) -> bool:
    var token_count: i64 = 0
    var found = false
    for raw_token in directive.replace(
        "\t", " "
    ).replace("\r", " ").replace("\n", " ").split(" "):
        val token = raw_token.trim().lower()
        if token == "":
            continue
        token_count = token_count + 1
        if token_count > BROWSER_CSP_SANDBOX_MAX_TOKENS:
            return false
        if token == expected:
            found = true
    found

pub fn browser_csp_header_sandbox(policy: text) -> BrowserCspSandboxPolicy:
    """Intersect response-header CSP sandbox capabilities; meta strips sandbox."""
    if policy.len() > BROWSER_CSP_SANDBOX_MAX_POLICY_BYTES:
        return BrowserCspSandboxPolicy.deny_all()
    var result = BrowserCspSandboxPolicy.unrestricted()
    var policy_count: i64 = 0
    for raw_policy in policy.replace(",", "\n").split("\n"):
        if raw_policy.trim() == "":
            continue
        policy_count = policy_count + 1
        if policy_count > BROWSER_CSP_SANDBOX_MAX_POLICIES:
            return BrowserCspSandboxPolicy.deny_all()
        var saw_sandbox = false
        for raw_directive in raw_policy.split(";"):
            val directive = raw_directive.trim()
            if directive == "":
                continue
            val name = directive.replace(
                "\t", " "
            ).replace("\r", " ").replace("\n", " ").split(" ")[0].lower()
            if name != "sandbox" or saw_sandbox:
                continue
            saw_sandbox = true
            val allow_scripts = _browser_csp_sandbox_has_token(
                directive, "allow-scripts"
            )
            val allow_forms = _browser_csp_sandbox_has_token(
                directive, "allow-forms"
            )
            val allow_same_origin = _browser_csp_sandbox_has_token(
                directive, "allow-same-origin"
            )
            val allow_popups = _browser_csp_sandbox_has_token(
                directive, "allow-popups"
            )
            val allow_top_navigation = (
                _browser_csp_sandbox_has_token(
                    directive, "allow-top-navigation"
                )
            )
            if not result.active:
                result = BrowserCspSandboxPolicy(
                    active: true,
                    allow_scripts: allow_scripts,
                    allow_forms: allow_forms,
                    allow_same_origin: allow_same_origin,
                    allow_popups: allow_popups,
                    allow_top_navigation: allow_top_navigation
                )
            else:
                result.allow_scripts = result.allow_scripts and allow_scripts
                result.allow_forms = result.allow_forms and allow_forms
                result.allow_same_origin = (
                    result.allow_same_origin and allow_same_origin
                )
                result.allow_popups = result.allow_popups and allow_popups
                result.allow_top_navigation = (
                    result.allow_top_navigation and allow_top_navigation
                )
    result

fn browser_session_is_loopback_http(url: text) -> bool:
    if not url.starts_with("http://"):
        return false
    val host = url_hostname(url).lower()
    host == "localhost" or host == "127.0.0.1" or host == "::1"

fn browser_session_is_secure_context(url: text) -> bool:
    if url.starts_with("https://"):
        return true
    if browser_session_is_loopback_http(url):
        return true
    if url.starts_with("file://") or url.starts_with("about:"):
        return true
    false

fn browser_meta_content_security_policy(policy: text) -> text:
    var kept: [text] = []
    for raw_directive in policy.split(";"):
        val directive = raw_directive.trim()
        if directive == "":
            continue
        val name = directive.replace(
            "\t", " "
        ).replace("\n", " ").replace("\r", " ").split(" ")[0].lower()
        if (
            name == "report-uri" or name == "frame-ancestors" or
            name == "sandbox"
        ):
            continue
        kept.push(directive)
    kept.join("; ")

fn _browser_csp_normalize_http_scheme(url: text) -> text:
    val lower = url.lower()
    if lower.starts_with("https://"):
        return "https://" + url.slice(8, url.len())
    if lower.starts_with("http://"):
        return "http://" + url.slice(7, url.len())
    url

fn _browser_csp_source_origin_matches_url(
    source: text, target_url: text
) -> bool:
    val source_url = _browser_csp_normalize_http_scheme(source)
    val target = _browser_csp_normalize_http_scheme(target_url)
    url_origin(source_url).lower() == url_origin(target).lower()

fn _browser_csp_normalize_path(path: text) -> text:
    val raw_segments = path.split("/")
    var segments: [text] = []
    var segment_index = 0
    for raw_segment in raw_segments:
        val dot_segment = raw_segment.lower().replace("%2e", ".")
        if dot_segment == "..":
            if segments.len() > 0:
                segments.pop()
        elif dot_segment != ".":
            if segment_index > 0 or raw_segment != "":
                segments.push(raw_segment)
        segment_index = segment_index + 1
    if segments.len() == 0:
        return "/"
    var normalized = "/" + segments.join("/")
    val last_segment = raw_segments[raw_segments.len() - 1]
    val last_dot_segment = last_segment.lower().replace("%2e", ".")
    if normalized != "/" and (
        last_dot_segment == "." or last_dot_segment == ".."
    ):
        normalized = normalized + "/"
    normalized

pub fn browser_csp_source_matches_url(
    source: text, target_url: text
) -> bool:
    val source_url = _browser_csp_normalize_http_scheme(source)
    val target = _browser_csp_normalize_http_scheme(target_url)
    if not _browser_csp_source_origin_matches_url(source, target_url):
        return false
    val source_path = _browser_csp_normalize_path(url_pathname(source_url))
    val target_path = _browser_csp_normalize_path(url_pathname(target))
    if source_path == "" or source_path == "/":
        return true
    if source_path.ends_with("/"):
        return target_path.starts_with(source_path)
    target_path == source_path

pub fn browser_csp_policy_valid(policy: text) -> bool:
    if policy.len() > BROWSER_CSP_SANDBOX_MAX_POLICY_BYTES:
        return false
    var policy_count: i64 = 0
    for raw_policy in policy.split("\n"):
        if raw_policy.trim() != "":
            policy_count = policy_count + 1
            if policy_count > BROWSER_CSP_SANDBOX_MAX_POLICIES:
                return false
    true

pub fn browser_csp_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool
) -> bool:
    _browser_csp_allows(
        policy, directive, document_url, target_url, is_inline, false
    )

fn browser_csp_allows_after_redirect(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool
) -> bool:
    _browser_csp_allows(
        policy, directive, document_url, target_url, is_inline, true
    )

fn _browser_csp_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool,
    after_redirect: bool
) -> bool:
    if policy.trim() == "":
        return true
    for raw_policy in policy.split("\n"):
        if raw_policy.trim() != "" and not browser_csp_single_policy_allows(
            raw_policy, directive, document_url, target_url, is_inline,
            after_redirect
        ):
            return false
    true

fn browser_csp_single_policy_allows(
    policy: text,
    directive: text,
    document_url: text,
    target_url: text,
    is_inline: bool,
    after_redirect: bool
) -> bool:
    var sources = ""
    var found = false
    for raw_directive in policy.replace("\t", " ").split(";"):
        val parts = raw_directive.trim().split(" ")
        if not found and parts.len() > 0 and
           parts[0].trim().lower() == directive:
            sources = raw_directive.trim().substring(parts[0].len()).trim()
            found = true
    if not found and directive != "default-src":
        return browser_csp_single_policy_allows(
            policy, "default-src", document_url, target_url, is_inline,
            after_redirect
        )
    if not found:
        return true
    for raw_source in sources.split(" "):
        val source = raw_source.trim()
        val lower_source = source.lower()
        if source == "":
            continue
        if lower_source == "'none'":
            continue
        if is_inline:
            if lower_source == "'unsafe-inline'":
                return true
            continue
        if source == "*":
            return true
        if lower_source == "'self'" and
           url_origin(target_url) == url_origin(document_url):
            return true
        if lower_source.ends_with(":") and
           target_url.lower().starts_with(lower_source):
            return true
        if (lower_source.starts_with("http://") or
            lower_source.starts_with("https://")) and
           ((after_redirect and
             _browser_csp_source_origin_matches_url(source, target_url)) or
            (not after_redirect and
             browser_csp_source_matches_url(source, target_url))):
            return true
    false
