# BrowserSession adapter for the common textual UI access protocol.

use common.ui.access.{
    UiAccessProp,
    UiAccessNode,
    UiAccessSurface,
    UiAccessEvent,
    UiAccessSnapshot,
    WinTextActionRequest,
    WinTextActionResult,
    ui_access_canonical_id,
    ui_access_find_node
}
use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.web.browser_session_url.{resolve_relative_url}
use std.gc_async_mut.web.browser_session_form.{browser_select_value}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_find_by_tag, be_dom_get_attr, be_dom_get_text_content,
    be_dom_has_attr
}

val BROWSER_SESSION_SURFACE_ID = "browser:session"
val BROWSER_SESSION_SOURCE_ID = "browser_session"

fn _browser_node(
    widget_id: text,
    kind: text,
    text_value: text,
    enabled: bool,
    selected: bool,
    action_names: [text],
    props: [UiAccessProp]
) -> UiAccessNode:
    UiAccessNode(
        canonical_id: ui_access_canonical_id(BROWSER_SESSION_SURFACE_ID, widget_id),
        surface_id: BROWSER_SESSION_SURFACE_ID,
        widget_id: widget_id,
        kind: kind,
        visible: true,
        focused: false,
        enabled: enabled,
        selected: selected,
        text_value: text_value,
        props: props,
        child_ids: [],
        action_names: action_names
    )

fn _browser_control_props(control: text) -> [UiAccessProp]:
    [
        UiAccessProp(key: "source", value: BROWSER_SESSION_SOURCE_ID),
        UiAccessProp(key: "control", value: control)
    ]

fn _browser_link_props(href: text, target_id: text) -> [UiAccessProp]:
    [
        UiAccessProp(key: "source", value: BROWSER_SESSION_SOURCE_ID),
        UiAccessProp(key: "control", value: "link"),
        UiAccessProp(key: "href", value: href),
        UiAccessProp(key: "dom_target", value: target_id)
    ]

fn _browser_bookmark_props(href: text) -> [UiAccessProp]:
    [
        UiAccessProp(key: "source", value: BROWSER_SESSION_SOURCE_ID),
        UiAccessProp(key: "control", value: "bookmark"),
        UiAccessProp(key: "href", value: href)
    ]

fn _browser_dom_control_props(control: text, target_id: text) -> [UiAccessProp]:
    [
        UiAccessProp(key: "source", value: BROWSER_SESSION_SOURCE_ID),
        UiAccessProp(key: "control", value: control),
        UiAccessProp(key: "dom_target", value: target_id)
    ]

fn _browser_node_prop(node: UiAccessNode, key: text) -> text:
    for prop in node.props:
        if prop.key == key:
            return prop.value
    ""

fn _browser_dom_target(node: UiAccessNode) -> text:
    val node_id = _browser_node_prop(node, "dom_target")
    if node_id == "":
        return ""
    "\u{0000}route-node:{node_id}"

fn _browser_collapse_parent_segments(url: text) -> text:
    var out = url
    while out.contains("/../"):
        val marker = out.index_of("/../")
        if marker < 0:
            return out
        val before = out.slice(0, marker)
        val previous_slash = before.last_index_of("/")
        if previous_slash < 0:
            return out
        out = out.slice(0, previous_slash) + out.slice(marker + 3, out.len())
    out

fn _browser_link_nodes(dom: BeDomNode, base_url: text) -> [UiAccessNode]:
    val links = be_dom_find_by_tag(dom, "a")
    var nodes: [UiAccessNode] = []
    var index = 0
    while index < links.len():
        val link = links[index]
        val href = be_dom_get_attr(link, "href")
        val label = be_dom_get_text_content(link).trim()
        if href != "" and label != "":
            val resolved = _browser_collapse_parent_segments(resolve_relative_url(base_url, href))
            nodes.push(_browser_node(
                "link_{index}", "link", label, true, false, ["click", "key"],
                _browser_link_props(resolved, link.node_id.to_text())
            ))
        index = index + 1
    nodes

fn _browser_bookmark_nodes(session: BrowserSession) -> [UiAccessNode]:
    var nodes: [UiAccessNode] = []
    var index = 0
    while index < session.favorite_links.len():
        val favorite = session.favorite_links[index]
        nodes.push(_browser_node(
            "bookmark_{index}", "link", favorite.second, true, false, ["click"],
            _browser_bookmark_props(favorite.first)
        ))
        index = index + 1
    nodes

class _BrowserPageControlBuckets:
    buttons: [BeDomNode]
    inputs: [BeDomNode]
    textareas: [BeDomNode]
    selects: [BeDomNode]

fn _browser_collect_page_controls(
    node: BeDomNode, buckets: _BrowserPageControlBuckets
):
    if node.tag_name == "button":
        buckets.buttons.push(node)
    elif node.tag_name == "input":
        buckets.inputs.push(node)
    elif node.tag_name == "textarea":
        buckets.textareas.push(node)
    elif node.tag_name == "select":
        buckets.selects.push(node)
    for child in node.children:
        _browser_collect_page_controls(child, buckets)

fn _browser_page_control_nodes(
    dom: BeDomNode, ui_access_revision: i64
) -> [UiAccessNode]:
    var nodes: [UiAccessNode] = []
    val buckets = _BrowserPageControlBuckets(
        buttons: [], inputs: [], textareas: [], selects: []
    )
    _browser_collect_page_controls(dom, buckets)
    val buttons = buckets.buttons
    var button_index = 0
    while button_index < buttons.len():
        val button = buttons[button_index]
        var label = be_dom_get_text_content(button).trim()
        if label == "":
            label = "Button"
        var access_node = _browser_node(
            "page_button_{button_index}", "button", label,
            be_dom_has_attr(button, "disabled") == false, false, ["click", "key"],
            _browser_dom_control_props("page_button", button.node_id.to_text())
        )
        access_node.focused = be_dom_has_attr(button, "data-focused")
        nodes.push(access_node)
        button_index = button_index + 1

    val inputs = buckets.inputs
    var input_index = 0
    while input_index < inputs.len():
        val input = inputs[input_index]
        val declared_type = be_dom_get_attr(input, "type").lower()
        val input_type = if declared_type == "": "text" else: declared_type
        val enabled = be_dom_has_attr(input, "disabled") == false
        if input_type == "hidden":
            pass_dn("hidden form state is not an interactive UI node")
        elif input_type == "checkbox" or input_type == "radio":
            var access_node = _browser_node(
                "page_input_{input_index}", input_type, be_dom_get_attr(input, "value"),
                enabled, be_dom_has_attr(input, "checked"), ["click", "key"],
                _browser_dom_control_props("page_input", input.node_id.to_text())
            )
            access_node.focused = be_dom_has_attr(input, "data-focused")
            nodes.push(access_node)
        elif input_type == "button" or input_type == "submit":
            var access_node = _browser_node(
                "page_input_{input_index}", "button", be_dom_get_attr(input, "value"),
                enabled, false, ["click", "key"],
                _browser_dom_control_props("page_button", input.node_id.to_text())
            )
            access_node.focused = be_dom_has_attr(input, "data-focused")
            nodes.push(access_node)
        else:
            val editable = enabled and not be_dom_has_attr(input, "readonly")
            val visible_value = if input_type == "password": "" else: be_dom_get_attr(input, "value")
            var access_node = _browser_node(
                "page_input_{input_index}", "textfield", visible_value,
                editable, false, if editable: ["set_value", "blur"] else: [],
                _browser_dom_control_props("page_input", input.node_id.to_text())
            )
            access_node.focused = be_dom_has_attr(input, "data-focused")
            nodes.push(access_node)
        input_index = input_index + 1

    val textareas = buckets.textareas
    var textarea_index = 0
    while textarea_index < textareas.len():
        val textarea = textareas[textarea_index]
        val editable = not be_dom_has_attr(textarea, "disabled") and
            not be_dom_has_attr(textarea, "readonly")
        var access_node = _browser_node(
            "page_textarea_{textarea_index}", "textfield",
            be_dom_get_text_content(textarea), editable, false,
            if editable: ["set_value", "blur"] else: [],
            _browser_dom_control_props(
                "page_input", textarea.node_id.to_text()
            )
        )
        access_node.focused = be_dom_has_attr(textarea, "data-focused")
        nodes.push(access_node)
        textarea_index = textarea_index + 1

    var select_index = 0
    while select_index < buckets.selects.len():
        val select = buckets.selects[select_index]
        val enabled = not be_dom_has_attr(select, "disabled")
        var access_node = _browser_node(
            "page_select_{ui_access_revision}_{select.node_id}", "select",
            browser_select_value(select), enabled, false,
            if enabled: ["set_value"] else: [],
            _browser_dom_control_props(
                "page_select", select.node_id.to_text()
            )
        )
        access_node.focused = be_dom_has_attr(select, "data-focused")
        nodes.push(access_node)
        select_index = select_index + 1
    nodes

fn _browser_action_result(ok: bool, code: text, message: text, target_id: text, action: text) -> WinTextActionResult:
    WinTextActionResult(
        ok: ok,
        code: code,
        message: message,
        source_id: BROWSER_SESSION_SOURCE_ID,
        target_id: target_id,
        action: action
    )

impl BrowserSession:

    me ui_access_snapshot() -> UiAccessSnapshot:
        val surface = UiAccessSurface(
            surface_id: BROWSER_SESSION_SURFACE_ID,
            title: self.current_title,
            active: true,
            window_id: "browser-session",
            app_id: "simple-browser",
            root_canonical_id: ui_access_canonical_id(BROWSER_SESSION_SURFACE_ID, "root")
        )
        val link_nodes = _browser_link_nodes(self.current_dom, self.current_url)
        val bookmark_nodes = _browser_bookmark_nodes(self)
        val page_control_nodes = _browser_page_control_nodes(
            self.current_dom, self.ui_access_revision
        )
        val fixed_count = 8
        val node_count = fixed_count + bookmark_nodes.len() + link_nodes.len() + page_control_nodes.len()
        var nodes: [UiAccessNode] = [_browser_node("back", "button", "Back", self.can_go_back(), false, ["click"], _browser_control_props("back")); node_count]
        nodes[1] = _browser_node("forward", "button", "Forward", self.can_go_forward(), false, ["click"], _browser_control_props("forward"))
        nodes[2] = _browser_node("stop", "button", "Stop", self.can_stop_loading(), false, ["click"], _browser_control_props("stop"))
        nodes[3] = _browser_node("reload", "button", "Reload", self.current_index >= 0 and not self.is_loading, false, ["click"], _browser_control_props("reload"))
        nodes[4] = _browser_node("home", "button", "Home", true, false, ["click"], _browser_control_props("home"))
        nodes[5] = _browser_node("favorite", "button", "Favorite", true, self.is_favorite(self.current_url), ["click"], _browser_control_props("favorite"))
        val address_text = if self.address_draft != "": self.address_draft else: self.current_url
        nodes[6] = _browser_node("address", "textfield", address_text, true, false, ["set_value", "submit"], _browser_control_props("address"))
        nodes[7] = _browser_node("title", "label", self.current_title, true, false, [], _browser_control_props("title"))
        var bookmark_idx = 0
        while bookmark_idx < bookmark_nodes.len():
            nodes[fixed_count + bookmark_idx] = bookmark_nodes[bookmark_idx]
            bookmark_idx = bookmark_idx + 1
        var link_idx = 0
        val link_count = link_nodes.len()
        while link_idx < link_count:
            nodes[fixed_count + bookmark_nodes.len() + link_idx] = link_nodes[link_idx]
            link_idx = link_idx + 1
        var control_idx = 0
        while control_idx < page_control_nodes.len():
            nodes[fixed_count + bookmark_nodes.len() + link_count + control_idx] = page_control_nodes[control_idx]
            control_idx = control_idx + 1
        UiAccessSnapshot(
            protocol_version: 1,
            snapshot_revision: self.ui_access_revision,
            mode: "browser_session",
            active_surface: BROWSER_SESSION_SURFACE_ID,
            surfaces: [surface],
            nodes: nodes,
            recent_events: []
        )

    me ui_access_act(request: WinTextActionRequest) -> WinTextActionResult:
        val snapshot = self.ui_access_snapshot()
        val node = ui_access_find_node(snapshot, request.target_id)
        if node == nil:
            return _browser_action_result(false, "target_not_found", "target not found", request.target_id, request.action)
        if node.widget_id == "address":
            if request.action == "set_value":
                self.address_draft = request.text_value
                return _browser_action_result(true, "ok", "address updated", request.target_id, request.action)
            if request.action == "submit":
                val address = if request.text_value != "": request.text_value else: self.address_draft
                match self.begin_network_navigation(address, "GET", "", "", ""):
                    Ok(_): return _browser_action_result(true, "ok", "address submitted", request.target_id, request.action)
                    Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
            return _browser_action_result(false, "unsupported_operation", "unsupported address action '{request.action}'", request.target_id, request.action)
        val control = _browser_node_prop(node, "control")
        if control == "page_input" and node.kind == "textfield":
            val dom_target = _browser_dom_target(node)
            if request.action == "blur":
                match self.blur_dom_text_input(dom_target):
                    Ok(_):
                        return _browser_action_result(
                            true, "ok", "input blurred",
                            request.target_id, request.action
                        )
                    Err(e):
                        return _browser_action_result(
                            false, "action_failed", e,
                            request.target_id, request.action
                        )
            if request.action != "set_value":
                return _browser_action_result(false, "unsupported_operation", "unsupported input action '{request.action}'", request.target_id, request.action)
            match self.set_dom_text_input(dom_target, request.text_value):
                Ok(dispatch):
                    if dispatch.event.default_prevented:
                        return _browser_action_result(
                            true, "ok", "input edit canceled",
                            request.target_id, request.action
                        )
                    return _browser_action_result(true, "ok", "input updated", request.target_id, request.action)
                Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
        if control == "page_select":
            if not node.enabled:
                return _browser_action_result(
                    false, "disabled", "control disabled",
                    request.target_id, request.action
                )
            if request.action != "set_value":
                return _browser_action_result(
                    false, "unsupported_operation",
                    "unsupported select action '{request.action}'",
                    request.target_id, request.action
                )
            val dom_target = _browser_dom_target(node)
            match self.set_dom_select_value(dom_target, request.text_value):
                Ok(changed):
                    return _browser_action_result(
                        true, "ok",
                        if changed: "selection updated" else: "selection unchanged",
                        request.target_id, request.action
                    )
                Err(e):
                    return _browser_action_result(
                        false, "action_failed", e,
                        request.target_id, request.action
                    )
        if not node.enabled:
            return _browser_action_result(false, "disabled", "control disabled", request.target_id, request.action)
        if request.action != "click":
            if request.action == "key" and (
                node.kind == "link" or node.kind == "button" or
                node.kind == "checkbox" or node.kind == "radio"
            ):
                val dom_target = _browser_dom_target(node)
                match self.dispatch_dom_keyboard_activation(
                    dom_target, request.text_value
                ):
                    Ok(dispatch):
                        val message = if dispatch.default_action_allowed:
                            "control key activated"
                        else:
                            "control key event canceled"
                        return _browser_action_result(
                            true, "ok", message,
                            request.target_id, request.action
                        )
                    Err(e):
                        return _browser_action_result(
                            false, "action_failed", e,
                            request.target_id, request.action
                        )
            return _browser_action_result(false, "unsupported_operation", "unsupported action '{request.action}'", request.target_id, request.action)
        if node.widget_id == "back":
            match self.go_back():
                Ok(_): return _browser_action_result(true, "ok", "went back", request.target_id, request.action)
                Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
        if node.widget_id == "forward":
            match self.go_forward():
                Ok(_): return _browser_action_result(true, "ok", "went forward", request.target_id, request.action)
                Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
        if node.widget_id == "stop":
            self.stop_loading()
            return _browser_action_result(true, "ok", "stopped loading", request.target_id, request.action)
        if node.widget_id == "reload":
            match self.reload():
                Ok(_): return _browser_action_result(true, "ok", "reloaded page", request.target_id, request.action)
                Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
        if node.widget_id == "home":
            match self.go_home():
                Ok(_): return _browser_action_result(true, "ok", "went home", request.target_id, request.action)
                Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
        if node.widget_id == "favorite":
            if self.is_favorite(self.current_url):
                self.remove_favorite(self.current_url)
                return _browser_action_result(true, "ok", "favorite removed", request.target_id, request.action)
            self.add_current_favorite()
            return _browser_action_result(true, "ok", "favorite added", request.target_id, request.action)
        if control == "bookmark":
            val href = _browser_node_prop(node, "href")
            match self.begin_network_navigation(href, "GET", "", "", ""):
                Ok(_): return _browser_action_result(true, "ok", "opened bookmark", request.target_id, request.action)
                Err(e): return _browser_action_result(false, "action_failed", e, request.target_id, request.action)
        if node.kind == "link":
            val dom_target = _browser_dom_target(node)
            if dom_target == "":
                return _browser_action_result(false, "action_failed", "link missing DOM target", request.target_id, request.action)
            val dispatch = self.dispatch_dom_event(dom_target, "click", true, true)
            if dispatch.default_action_allowed:
                return _browser_action_result(true, "ok", "opened link", request.target_id, request.action)
            return _browser_action_result(true, "ok", "link event canceled", request.target_id, request.action)
        if control == "page_button" or control == "page_input":
            val dom_target = _browser_dom_target(node)
            if dom_target == "":
                return _browser_action_result(false, "action_failed", "control missing DOM target", request.target_id, request.action)
            val dispatch = self.dispatch_dom_event(dom_target, "click", true, true)
            if dispatch.default_action_allowed or dispatch.actions.len() > 0:
                return _browser_action_result(true, "ok", "control activated", request.target_id, request.action)
            return _browser_action_result(true, "ok", "control event dispatched", request.target_id, request.action)
        _browser_action_result(false, "unsupported_operation", "unsupported browser control", request.target_id, request.action)
