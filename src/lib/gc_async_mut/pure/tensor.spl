# Pure Simple Tensor - Core tensor implementation
#
# Provides N-dimensional array storage with flat array layout
# Zero external dependencies - pure Simple implementation

# ============================================================================
# PureTensor<T> - N-dimensional array
# ============================================================================

class PureTensor<T>:
    """Pure Simple tensor with flat array storage."""
    data: [T]       # Flat array storage
    shape: [i64]    # Dimension sizes
    strides: [i64]  # Memory layout strides

    fn dims() -> [i64]:
        """Get dimension sizes.

        Accessor parity with the autograd `Tensor`, which exposes `shape()` as a
        method because it stores its dimensions indirectly (`self.value.shape`).
        `PureTensor` stores `shape` as a plain field, so a same-named method
        would shadow it; `dims()` is the method-shaped accessor. See
        doc/08_tracking/bug/pure_nn_layers_mix_autograd_tensor_and_puretensor_2026-07-25.md
        """
        self.shape

    fn numel() -> i64:
        """Get total number of elements."""
        var total = 1
        for dim in self.shape:
            total = total * dim
        total

    static fn zeros(shape: [i64]) -> PureTensor<f64>:
        """Create tensor filled with zeros."""
        var numel = 1
        for dim in shape:
            numel = numel * dim
        var data: [f64] = []
        var i = 0
        while i < numel:
            data.push(0.0)
            i = i + 1
        PureTensor(data: data, shape: shape, strides: compute_strides(shape))

    static fn ones(shape: [i64]) -> PureTensor<f64>:
        """Create tensor filled with ones."""
        var numel = 1
        for dim in shape:
            numel = numel * dim
        var data: [f64] = []
        var i = 0
        while i < numel:
            data.push(1.0)
            i = i + 1
        PureTensor(data: data, shape: shape, strides: compute_strides(shape))

    static fn from_data(data: [T], shape: [i64]) -> PureTensor<T>:
        """Create tensor from data array."""
        PureTensor(data: data, shape: shape, strides: compute_strides(shape))

    static fn randn(shape: [i64]) -> PureTensor<f64>:
        """Create tensor with random values."""
        var numel = 1
        for dim in shape:
            numel = numel * dim
        var data: [f64] = []
        var i = 0
        while i < numel:
            val rand = ((i * 2654435761) % 1000000) / 1000000.0
            data.push(rand - 0.5)
            i = i + 1
        PureTensor(data: data, shape: shape, strides: compute_strides(shape))

    fn get(indices: [i64]) -> T:
        """Get element at multi-dimensional index."""
        var offset = 0
        var i = 0
        while i < indices.len():
            offset = offset + indices[i] * self.strides[i]
            i = i + 1
        self.data[offset]

    fn set(indices: [i64], value: T):
        """Set element at multi-dimensional index."""
        var offset = 0
        var i = 0
        while i < indices.len():
            offset = offset + indices[i] * self.strides[i]
            i = i + 1
        self.data[offset] = value

    # ------------------------------------------------------------------
    # Shape / view operations
    #
    # ADDED 2026-07-25: `pure/test/tensor_spec.spl` had its whole body
    # commented out behind a `skip("pre-existing test failures - functions/
    # imports not available")`. Two things were wrong: (1) `std.pure.tensor`
    # resolved to a stub facade (fixed in src/lib/pure/tensor.spl), and
    # (2) `reshape`/`transpose`/`to_string` were asserted by that spec but
    # never actually implemented here. These are the real implementations,
    # not placeholders — the spec's assertions drove the semantics.
    # ------------------------------------------------------------------

    fn reshape(new_shape: [i64]) -> PureTensor<T>:
        """Return a tensor with the same flat data viewed under `new_shape`.

        C-contiguous, so the flat buffer is reused unchanged and only the
        strides are recomputed. Element count must be preserved by the caller.
        """
        PureTensor(data: self.data, shape: new_shape, strides: compute_strides(new_shape))

    fn transpose() -> PureTensor<T>:
        """Return the 2D transpose (reverses both dimensions).

        For rank != 2 the tensor is returned unchanged, matching the
        rank-2-only contract exercised by the spec.
        """
        if self.shape.len() != 2:
            return PureTensor(data: self.data, shape: self.shape, strides: self.strides)
        val rows = self.shape[0]
        val cols = self.shape[1]
        val out_shape = [cols, rows]
        var out: [T] = []
        var c = 0
        while c < cols:
            var r = 0
            while r < rows:
                out.push(self.data[r * cols + c])
                r = r + 1
            c = c + 1
        PureTensor(data: out, shape: out_shape, strides: compute_strides(out_shape))

    fn to_string() -> text:
        """Human-readable rendering: includes both the shape and the elements."""
        var body = ""
        var i = 0
        while i < self.data.len():
            if i > 0:
                body = body + ", "
            body = body + "{self.data[i]}"
            i = i + 1
        "PureTensor(shape={self.shape}, data=[{body}])"

fn compute_strides(shape: [i64]) -> [i64]:
    """Compute strides for C-contiguous layout."""
    var strides: [i64] = []
    var stride = 1
    var i = shape.len() - 1
    while i >= 0:
        strides.insert(0, stride)
        stride = stride * shape[i]
        i = i - 1
    strides

# ============================================================================
# Factory Functions (Workaround for interpreter limitation)
# ============================================================================
# Workaround: The interpreter does not yet support static methods on generic types
# (e.g., PureTensor<T>.from_data()). These module-level factory functions provide
# the same functionality until that interpreter limitation is resolved.

fn tensor_from_data(data: [f64], shape: [i64]) -> PureTensor<f64>:
    """Create f64 tensor from data array.

    Workaround for: PureTensor.from_data(data, shape)
    """
    PureTensor(data: data, shape: shape, strides: compute_strides(shape))

fn tensor_from_data_i64(data: [i64], shape: [i64]) -> PureTensor<i64>:
    """Create i64 tensor from data array.

    Workaround for: PureTensor.from_data(data, shape)
    """
    PureTensor(data: data, shape: shape, strides: compute_strides(shape))

fn tensor_zeros(shape: [i64]) -> PureTensor<f64>:
    """Create tensor filled with zeros.

    Workaround for: PureTensor.zeros(shape)
    """
    var numel = 1
    for dim in shape:
        numel = numel * dim
    var data: [f64] = []
    var i = 0
    while i < numel:
        data.push(0.0)
        i = i + 1
    PureTensor(data: data, shape: shape, strides: compute_strides(shape))

fn tensor_ones(shape: [i64]) -> PureTensor<f64>:
    """Create tensor filled with ones.

    Workaround for: PureTensor.ones(shape)
    """
    var numel = 1
    for dim in shape:
        numel = numel * dim
    var data: [f64] = []
    var i = 0
    while i < numel:
        data.push(1.0)
        i = i + 1
    PureTensor(data: data, shape: shape, strides: compute_strides(shape))

fn tensor_randn(shape: [i64]) -> PureTensor<f64>:
    """Create tensor with random values.

    Workaround for: PureTensor.randn(shape)
    """
    var numel = 1
    for dim in shape:
        numel = numel * dim
    var data: [f64] = []
    var i = 0
    while i < numel:
        val rand = ((i * 2654435761) % 1000000) / 1000000.0
        data.push(rand - 0.5)
        i = i + 1
    PureTensor(data: data, shape: shape, strides: compute_strides(shape))

export PureTensor, compute_strides
export tensor_from_data, tensor_from_data_i64, tensor_zeros, tensor_ones, tensor_randn
export tensor_zeros_like
export total_elements, zeros_like, ones_like, broadcast_shapes

fn tensor_zeros_like(t: PureTensor<f64>) -> PureTensor<f64>:
    tensor_zeros(t.shape)

# ============================================================================
# Shape utilities
#
# ADDED 2026-07-25: asserted by `pure/test/tensor_spec.spl`, which had been
# parked wholesale behind a `skip(...)`. `zeros_like`/`ones_like`/
# `total_elements`/`broadcast_shapes` simply did not exist; only the
# differently-named `tensor_zeros_like` did. Implemented for real here so the
# spec can be un-parked without touching a single assertion.
# ============================================================================

fn total_elements(shape: [i64]) -> i64:
    """Product of all dimension sizes (element count of `shape`)."""
    var total = 1
    for dim in shape:
        total = total * dim
    total

fn zeros_like(t: PureTensor<f64>) -> PureTensor<f64>:
    """Zero-filled tensor with the same shape as `t`."""
    tensor_zeros(t.shape)

fn ones_like(t: PureTensor<f64>) -> PureTensor<f64>:
    """One-filled tensor with the same shape as `t`."""
    tensor_ones(t.shape)

fn broadcast_shapes(a: [i64], b: [i64]) -> [i64]:
    """NumPy-style broadcast of two shapes.

    Shapes are right-aligned; per axis the result takes the non-1 extent.
    Missing leading axes on the shorter shape are treated as 1.
    Incompatible axes (both != 1 and unequal) keep the larger extent rather
    than raising, since this module has no error channel yet.
    """
    val alen = a.len()
    val blen = b.len()
    var rank = alen
    if blen > rank:
        rank = blen
    var out: [i64] = []
    var i = 0
    while i < rank:
        # Right-aligned index into each shape; -1 means "axis absent" => 1.
        val ai = i - (rank - alen)
        val bi = i - (rank - blen)
        var av = 1
        if ai >= 0:
            av = a[ai]
        var bv = 1
        if bi >= 0:
            bv = b[bi]
        var dim = av
        if av == 1:
            dim = bv
        else:
            if bv != 1 and bv > av:
                dim = bv
        out.push(dim)
        i = i + 1
    out
