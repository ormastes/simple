# Pure Simple Collection Utilities
# Advanced collection operations

export range, take, drop, chunk, flatten
export unique, group_by, group_by_hashed, partition
export zip, unzip, cartesian_product
export find, find_index, all_match, any_match

# Generate range of numbers
fn range(start: i64, end: i64) -> [i64]:
    var result: [i64] = []
    var i = start
    while i < end:
        result.push(i)
        i = i + 1
    result

# Take first n elements
fn take<T>(list: [T], n: i64) -> [T]:
    if n >= list.len():
        list
    else:
        list[0:n]

# Drop first n elements
fn drop<T>(list: [T], n: i64) -> [T]:
    if n >= list.len():
        []
    else:
        list[n:]

# Split list into chunks
fn chunk<T>(list: [T], size: i64) -> [[T]]:
    var result: [[T]] = []
    var i = 0
    while i < list.len():
        val end = if i + size < list.len(): i + size else: list.len()
        result.push(list[i:end])
        i = i + size
    result

# Flatten nested list
fn flatten<T>(nested: [[T]]) -> [T]:
    var result: [T] = []
    var i = 0
    while i < nested.len():
        var j = 0
        while j < nested[i].len():
            result.push(nested[i][j])
            j = j + 1
        i = i + 1
    result

# Get unique elements
# Keeps first occurrence of each element, in input order.
#
# Dict membership replaces the former inner scan over `result`, which made this
# O(n^2). Uses only the verified-safe Dict subset: `d[k] = v` (never `.set()`,
# which silently drops inserts under native codegen) and `contains_key` (never
# `.get()`). See doc/07_guide/language/dict_native_pitfalls.md.
fn unique<T>(list: [T]) -> [T]:
    var seen: Dict<T, bool> = {}
    var result: [T] = []
    for item in list:
        if not seen.contains_key(item):
            seen[item] = true
            result.push(item)
    result

# Group elements by key function
# Groups appear in first-encounter order of their key; members keep input order.
#
# Keys and member buckets live in two parallel arrays because an array-of-arrays
# is mutable through index (`members[j].push(item)` reaches the stored bucket),
# unlike a tuple field (`groups[j].1.push(item)` mutates a discarded copy, which
# dropped every member after the first). The pairs are zipped only at the end.
# ponytail: slot lookup is a linear scan over `keys`, O(n * distinct_keys);
# upgrade path is a dict-slot lookup (Dict<K, i64> key -> slot index).
fn group_by<T, K>(list: [T], key_fn: fn(T) -> K) -> [(K, [T])]:
    var keys: [K] = []
    var members: [[T]] = []
    var i = 0
    while i < list.len():
        val item = list[i]
        val key = key_fn(item)

        # Find or create slot
        var found = false
        var j = 0
        while j < keys.len():
            if keys[j] == key:
                members[j].push(item)
                found = true
                break
            j = j + 1

        if not found:
            keys.push(key)
            members.push([item])

        i = i + 1

    var groups: [(K, [T])] = []
    var g = 0
    while g < keys.len():
        groups.push((keys[g], members[g]))
        g = g + 1
    groups

# Explicit hashed grouping; equality-only group_by remains available unchanged.
# key_fn and hash_fn are called once per item in input order. Callbacks must be
# deterministic and must not mutate keys/input; equal_fn must be an equivalence
# relation, and equal keys MUST have equal hashes. Equality verifies collisions.
# First key representatives, group order, and member order follow the input.
# With constant-time callbacks and amortized pushes: O(n + chain visits),
# expected O(n) for well-distributed hashes, worst O(n^2) with collisions.
# Auxiliary storage is O(n), including one bucket head per input element.
# Example: group_by_hashed([3, 1, 3], identity, integer_hash, integer_equal)
# produces [(3, [3, 3]), (1, [1])]. No generic runtime Hash/Eq is assumed.
fn group_by_hashed<T, K>(list: [T], key_fn: fn(T) -> K, hash_fn: fn(K) -> i64, equal_fn: fn(K, K) -> bool) -> [(K, [T])]:
    var groups: [(K, [T])] = []
    val count = list.len()
    if count == 0:
        return groups

    var heads: [i64] = []
    var i = 0
    while i < count:
        heads.push(-1)
        i = i + 1
    var links: [i64] = []
    var hashes: [i64] = []
    var keys: [K] = []
    var members: [[T]] = []
    i = 0
    while i < count:
        val item = list[i]
        val key = key_fn(item)
        val hash_value = hash_fn(key)
        # Positive divisor and conditional remainder adjustment handle i64 MIN
        # without abs(), negation, or overflow-prone hash+count arithmetic.
        var bucket = hash_value % count
        if bucket < 0:
            bucket = bucket + count
        var slot = heads[bucket]
        var found = false
        while slot >= 0:
            if hashes[slot] == hash_value:
                if equal_fn(keys[slot], key):
                    members[slot].push(item)
                    found = true
                    break
            slot = links[slot]
        if not found:
            val new_slot = keys.len()
            keys.push(key)
            members.push([item])
            hashes.push(hash_value)
            links.push(heads[bucket])
            heads[bucket] = new_slot
        i = i + 1

    var g = 0
    while g < keys.len():
        groups.push((keys[g], members[g]))
        g = g + 1
    groups

# Partition list by predicate
fn partition<T>(list: [T], predicate: fn(T) -> bool) -> ([T], [T]):
    var true_list: [T] = []
    var false_list: [T] = []
    var i = 0
    while i < list.len():
        if predicate(list[i]):
            true_list.push(list[i])
        else:
            false_list.push(list[i])
        i = i + 1
    (true_list, false_list)

# Zip two lists together
fn zip<A, B>(list_a: [A], list_b: [B]) -> [(A, B)]:
    var result: [(A, B)] = []
    val min_len = if list_a.len() < list_b.len(): list_a.len() else: list_b.len()
    var i = 0
    while i < min_len:
        result.push((list_a[i], list_b[i]))
        i = i + 1
    result

# Unzip list of pairs
fn unzip<A, B>(pairs: [(A, B)]) -> ([A], [B]):
    var list_a: [A] = []
    var list_b: [B] = []
    var i = 0
    while i < pairs.len():
        list_a.push(pairs[i].0)
        list_b.push(pairs[i].1)
        i = i + 1
    (list_a, list_b)

# Cartesian product
fn cartesian_product<A, B>(list_a: [A], list_b: [B]) -> [(A, B)]:
    var result: [(A, B)] = []
    var i = 0
    while i < list_a.len():
        var j = 0
        while j < list_b.len():
            result.push((list_a[i], list_b[j]))
            j = j + 1
        i = i + 1
    result

# Find first element matching predicate
fn find<T>(list: [T], predicate: fn(T) -> bool) -> T?:
    var i = 0
    while i < list.len():
        if predicate(list[i]):
            return Some(list[i])
        i = i + 1
    nil

# Find index of first matching element
fn find_index<T>(list: [T], predicate: fn(T) -> bool) -> i64?:
    var i = 0
    while i < list.len():
        if predicate(list[i]):
            return Some(i)
        i = i + 1
    nil

# Check if all elements match predicate
fn all_match<T>(list: [T], predicate: fn(T) -> bool) -> bool:
    var i = 0
    while i < list.len():
        if not predicate(list[i]):
            return false
        i = i + 1
    true

# Check if any element matches predicate
fn any_match<T>(list: [T], predicate: fn(T) -> bool) -> bool:
    var i = 0
    while i < list.len():
        if predicate(list[i]):
            return true
        i = i + 1
    false
