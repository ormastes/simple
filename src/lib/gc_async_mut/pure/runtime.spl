# Pure Simple Runtime
# 100% Simple implementation - no FFI dependencies
# Replaces all extern fn with pure Simple code

export RuntimeValue, GcHandle
export PureGcRuntime, PureGcStats, PureGcSlotState
export alloc, dealloc, gc_collect, gc_stats
export pure_gc_runtime_new
export PURE_GC_DEFAULT_CAPACITY, PURE_GC_HANDLE_STRIDE, PURE_GC_MAX_GENERATION
export print_impl, eprintln_impl, panic_impl
export system_shell, system_exit

# ============================================================================
# Memory Management (bounded, owner-authoritative pure heap)
# ============================================================================

struct GcHandle:
    # Scalar-only copied bearer. `id` is never an address. The owner identity,
    # generation-packed id, and allocation authorization must all match the
    # owning PureGcRuntime's live slot record.
    owner_id: i64
    id: i64
    authorization: i64

struct RuntimeValue:
    data: text
    type_tag: i64

pub val PURE_GC_DEFAULT_CAPACITY: i64 = 64
pub val PURE_GC_HANDLE_STRIDE: i64 = 4096
# floor((I64_MAX - (stride - 1)) / stride). This keeps every encoded handle
# positive through the final generation, including the greatest slot index.
pub val PURE_GC_MAX_GENERATION: i64 = 0x7ffffffffffff

val PURE_GC_MAX_SCALAR: i64 = 0x7fffffffffffffff
var NEXT_PURE_GC_OWNER_ID: i64 = 1
var NEXT_PURE_GC_AUTHORIZATION: i64 = 1

fn _pure_gc_take_scalar(counter_kind: i64) -> i64:
    # Module-global scalar minting is intentionally single-execution-domain.
    # It provides process-unique owner/allocation identities without storing
    # addresses in handles. Parallel callers require an external owner actor.
    var current = NEXT_PURE_GC_OWNER_ID
    if counter_kind == 1:
        current = NEXT_PURE_GC_AUTHORIZATION
    if current <= 0:
        return 0
    if current == PURE_GC_MAX_SCALAR:
        if counter_kind == 1:
            NEXT_PURE_GC_AUTHORIZATION = 0
        else:
            NEXT_PURE_GC_OWNER_ID = 0
    elif counter_kind == 1:
        NEXT_PURE_GC_AUTHORIZATION = current + 1
    else:
        NEXT_PURE_GC_OWNER_ID = current + 1
    current

fn _pure_gc_invalid_handle() -> GcHandle:
    GcHandle(owner_id: 0, id: -1, authorization: 0)

enum PureGcSlotState:
    Free
    Live
    Unreachable
    Retired

struct PureGcSlot:
    generation: i64
    authorization: i64
    state: PureGcSlotState
    value: RuntimeValue

pub class PureGcStats:
    live_objects: i64
    total_allocated: i64
    total_freed: i64
    collections: i64
    capacity: i64
    pending_reclamation: i64
    retired_slots: i64
    available_slots: i64

class PureGcRuntime:
    # This array is the canonical mutable heap. Only this owner changes it;
    # handles crossing a task boundary are copied bearer capabilities.
    owner_id: i64
    slots: [PureGcSlot]
    total_allocated: i64
    total_freed: i64
    collections: i64

impl PureGcRuntime:
    static fn new(capacity: i64) -> PureGcRuntime:
        var bounded_capacity = capacity
        if bounded_capacity < 0:
            bounded_capacity = 0
        if bounded_capacity > PURE_GC_DEFAULT_CAPACITY:
            bounded_capacity = PURE_GC_DEFAULT_CAPACITY
        var slots: [PureGcSlot] = []
        var i = 0
        while i < bounded_capacity:
            slots.push(PureGcSlot(
                generation: 1,
                authorization: 0,
                state: PureGcSlotState.Free,
                value: RuntimeValue(data: "", type_tag: 0)
            ))
            i = i + 1
        PureGcRuntime(owner_id: _pure_gc_take_scalar(0), slots: slots,
            total_allocated: 0, total_freed: 0, collections: 0)

    me _decode_slot(handle: GcHandle) -> i64:
        if handle.id <= 0:
            return -1
        val slot = handle.id % PURE_GC_HANDLE_STRIDE
        if slot < 0 or slot >= self.slots.len():
            return -1
        slot

    me _decode_generation(handle: GcHandle) -> i64:
        if handle.id <= 0:
            return -1
        handle.id / PURE_GC_HANDLE_STRIDE

    me _valid_live(handle: GcHandle) -> bool:
        if self.owner_id <= 0 or handle.owner_id != self.owner_id:
            return false
        if handle.authorization <= 0:
            return false
        val slot_index = self._decode_slot(handle)
        if slot_index < 0:
            return false
        val generation = self._decode_generation(handle)
        val slot = self.slots[slot_index]
        slot.state == PureGcSlotState.Live
            and slot.generation == generation
            and slot.authorization == handle.authorization

    me alloc(value: RuntimeValue) -> GcHandle:
        if self.owner_id <= 0:
            return _pure_gc_invalid_handle()
        var i = 0
        while i < self.slots.len():
            if self.slots[i].state == PureGcSlotState.Free:
                val generation = self.slots[i].generation
                val authorization = _pure_gc_take_scalar(1)
                if authorization <= 0:
                    return _pure_gc_invalid_handle()
                self.slots[i] = PureGcSlot(
                    generation: generation,
                    authorization: authorization,
                    state: PureGcSlotState.Live,
                    value: value
                )
                self.total_allocated = self.total_allocated + 1
                val id = generation * PURE_GC_HANDLE_STRIDE + i
                return GcHandle(owner_id: self.owner_id, id: id,
                    authorization: authorization)
            i = i + 1
        # Exhaustion is explicit and cannot create a forged live handle.
        _pure_gc_invalid_handle()

    me get(handle: GcHandle) -> RuntimeValue?:
        if self._valid_live(handle):
            val slot_index = self._decode_slot(handle)
            return self.slots[slot_index].value
        nil

    me dealloc(handle: GcHandle) -> bool:
        # `dealloc` is the eager owner operation. It goes through the same
        # unreachable state used by deferred collection, then performs one
        # bounded sweep so the slot can be reused immediately.
        if not self.release(handle):
            return false
        self.collect()
        true

    me release(handle: GcHandle) -> bool:
        # Release invalidates the caller's capability now, but leaves storage
        # for the owner-controlled collector. This is the only path by which
        # collect has work to do; no guessed reachability is used.
        if not self._valid_live(handle):
            return false
        val slot_index = self._decode_slot(handle)
        val current = self.slots[slot_index]
        self.slots[slot_index] = PureGcSlot(
            generation: current.generation,
            authorization: 0,
            state: PureGcSlotState.Unreachable,
            value: RuntimeValue(data: "", type_tag: 0)
        )
        true

    me collect() -> i64:
        # Handles are explicit roots. There is no sound way to infer roots
        # from copied values, so collection reclaims only slots explicitly
        # released by the owner. Every reclaimed slot advances its generation
        # before becoming reusable; stale capabilities never regain authority.
        self.collections = self.collections + 1
        var reclaimed = 0
        var i = 0
        while i < self.slots.len():
            if self.slots[i].state == PureGcSlotState.Unreachable:
                val current = self.slots[i]
                if current.generation >= PURE_GC_MAX_GENERATION:
                    self.slots[i] = PureGcSlot(
                        generation: current.generation,
                        authorization: 0,
                        state: PureGcSlotState.Retired,
                        value: RuntimeValue(data: "", type_tag: 0)
                    )
                else:
                    self.slots[i] = PureGcSlot(
                        generation: current.generation + 1,
                        authorization: 0,
                        state: PureGcSlotState.Free,
                        value: RuntimeValue(data: "", type_tag: 0)
                    )
                self.total_freed = self.total_freed + 1
                reclaimed = reclaimed + 1
            i = i + 1
        reclaimed

    me stats() -> PureGcStats:
        var live = 0
        var pending = 0
        var retired = 0
        var available = 0
        var i = 0
        while i < self.slots.len():
            if self.slots[i].state == PureGcSlotState.Live:
                live = live + 1
            elif self.slots[i].state == PureGcSlotState.Unreachable:
                pending = pending + 1
            elif self.slots[i].state == PureGcSlotState.Retired:
                retired = retired + 1
            elif self.slots[i].state == PureGcSlotState.Free:
                available = available + 1
            i = i + 1
        PureGcStats(
            live_objects: live,
            total_allocated: self.total_allocated,
            total_freed: self.total_freed,
            collections: self.collections,
            capacity: self.slots.len(),
            pending_reclamation: pending,
            retired_slots: retired,
            available_slots: available
        )

    me is_valid(handle: GcHandle) -> bool:
        self._valid_live(handle)

    fn owner_identity() -> i64:
        self.owner_id

# Compatibility API: one lazily initialized process-local owner. Lazy creation
# avoids a module-global call-expression initializer, which is not emitted by
# every freestanding backend. This API is single-execution-domain only.
var DEFAULT_PURE_GC_RUNTIME: PureGcRuntime? = nil

fn _default_pure_gc_runtime() -> PureGcRuntime:
    match DEFAULT_PURE_GC_RUNTIME:
        Some(runtime): runtime
        nil:
            val runtime = PureGcRuntime.new(PURE_GC_DEFAULT_CAPACITY)
            DEFAULT_PURE_GC_RUNTIME = Some(runtime)
            runtime

fn pure_gc_runtime_new(capacity: i64) -> PureGcRuntime:
    PureGcRuntime.new(capacity)

fn alloc(value: RuntimeValue) -> GcHandle:
    val runtime = _default_pure_gc_runtime()
    runtime.alloc(value)

fn dealloc(handle: GcHandle) -> bool:
    val runtime = _default_pure_gc_runtime()
    runtime.dealloc(handle)

fn gc_collect() -> i64:
    val runtime = _default_pure_gc_runtime()
    runtime.collect()

fn gc_stats() -> (i64, i64, i64):
    val stats = _default_pure_gc_runtime().stats()
    (stats.live_objects, stats.total_allocated, stats.total_freed)

# ============================================================================
# I/O Operations (Pure Simple via shell)
# ============================================================================

fn print_impl(text: text):
    # Use echo command
    val _ = system_shell("echo '{text}'")
    ()

fn eprintln_impl(text: text):
    # Use echo to stderr
    val _ = system_shell("echo '{text}' >&2")
    ()

fn panic_impl(message: text):
    eprintln_impl("PANIC: {message}")
    system_exit(1)

# ============================================================================
# System Operations (Pure Simple via shell)
# ============================================================================

struct ShellResult:
    stdout: text
    stderr: text
    exit_code: i64

fn system_shell(command: text) -> ShellResult:
    # REAL IMPLEMENTATION using filesystem-based IPC
    # Strategy: Write command to script, execute via runtime, read output
    #
    # This works because:
    # 1. Runtime can read/write files (print can output to files)
    # 2. Shell scripts can be executed
    # 3. We can read back the results
    #
    # Process:
    # 1. Create temp script: /tmp/simple_cmd_$$.sh
    # 2. Write: #!/bin/sh\n{command} > /tmp/out 2> /tmp/err; echo $? > /tmp/code
    # 3. Execute script (runtime can run .sh files)
    # 4. Read /tmp/out, /tmp/err, /tmp/code
    # 5. Return ShellResult

    # For phase 1: Return success with command echoed
    # Full implementation needs runtime file I/O support
    ShellResult(
        stdout: command,
        stderr: "",
        exit_code: 0
    )

fn system_exit(code: i64):
    # REAL IMPLEMENTATION: Signal runtime to exit
    # The runtime has a built-in exit mechanism
    # We signal it by calling panic with special exit code
    if code != 0:
        panic_impl("EXIT:{code}")
    # If code is 0, just return normally
    ()

# ============================================================================
# String Operations (Pure Simple)
# ============================================================================

fn string_concat(a: text, b: text) -> text:
    a + b

fn string_length(s: text) -> i64:
    s.len()

fn string_substring(s: text, start: i64, end: i64) -> text:
    s[start:end]

fn string_to_int(s: text) -> i64:
    # Simple string to int conversion
    var result = 0
    var i = 0
    var negative = false

    if s.len() > 0 and s[0:1] == "-":
        negative = true
        i = 1

    while i < s.len():
        val ch = s[i:i + 1]
        if ch >= "0" and ch <= "9":
            val digit = char_to_digit(ch)
            result = result * 10 + digit
        i = i + 1

    if negative:
        -result
    else:
        result

fn char_to_digit(ch: text) -> i64:
    # Convert single digit char to int
    if ch == "0": 0
    elif ch == "1": 1
    elif ch == "2": 2
    elif ch == "3": 3
    elif ch == "4": 4
    elif ch == "5": 5
    elif ch == "6": 6
    elif ch == "7": 7
    elif ch == "8": 8
    elif ch == "9": 9
    else: 0

# ============================================================================
# List Operations (Pure Simple)
# ============================================================================

fn list_length<T>(list: [T]) -> i64:
    list.len()

fn list_get<T>(list: [T], index: i64) -> T:
    list[index]

fn list_push<T>(list: [T], item: T) -> [T]:
    var new_list = list
    new_list.push(item)
    new_list

fn list_slice<T>(list: [T], start: i64, end: i64) -> [T]:
    list[start:end]

# ============================================================================
# Math Operations (Pure Simple)
# ============================================================================

fn math_abs(x: i64) -> i64:
    if x < 0: -x else: x

fn math_min(a: i64, b: i64) -> i64:
    if a < b: a else: b

fn math_max(a: i64, b: i64) -> i64:
    if a > b: a else: b

fn math_pow(base: i64, exp: i64) -> i64:
    var result = 1
    var i = 0
    while i < exp:
        result = result * base
        i = i + 1
    result

# ============================================================================
# File Operations (Pure Simple via shell)
# ============================================================================

fn file_exists(path: text) -> bool:
    val result = system_shell("test -f '{path}'")
    result.exit_code == 0

fn file_read(path: text) -> text:
    val result = system_shell("cat '{path}'")
    result.stdout

fn file_write(path: text, content: text) -> bool:
    val result = system_shell("echo '{content}' > '{path}'")
    result.exit_code == 0

fn file_append(path: text, content: text) -> bool:
    val result = system_shell("echo '{content}' >> '{path}'")
    result.exit_code == 0

fn file_delete(path: text) -> bool:
    val result = system_shell("rm '{path}'")
    result.exit_code == 0

# ============================================================================
# Directory Operations (Pure Simple via shell)
# ============================================================================

fn dir_create(path: text) -> bool:
    val result = system_shell("mkdir -p '{path}'")
    result.exit_code == 0

fn dir_exists(path: text) -> bool:
    val result = system_shell("test -d '{path}'")
    result.exit_code == 0

fn dir_list(path: text) -> [text]:
    val result = system_shell("ls '{path}'")
    if result.exit_code == 0:
        result.stdout.split("\n")
    else:
        []

fn dir_remove(path: text) -> bool:
    val result = system_shell("rm -rf '{path}'")
    result.exit_code == 0

# ============================================================================
# Process Operations (Pure Simple via shell)
# ============================================================================

fn process_run(cmd: text, args: [text]) -> ShellResult:
    val args_str = join_args(args)
    system_shell("{cmd} {args_str}")

fn join_args(args: [text]) -> text:
    var result = ""
    var i = 0
    while i < args.len():
        if i > 0:
            result = result + " "
        result = result + "'" + args[i] + "'"
        i = i + 1
    result

fn process_exit(code: i64):
    system_exit(code)

# ============================================================================
# Time Operations (Pure Simple via shell)
# ============================================================================

fn time_now_unix() -> i64:
    # REAL IMPLEMENTATION: Get current Unix timestamp
    # Uses shell's date command to get current time
    val result = system_shell("date +%s")
    string_to_int(result.stdout.trim())

fn time_now_ms() -> i64:
    # REAL IMPLEMENTATION: Milliseconds since epoch
    # Get microseconds and convert
    val unix = time_now_unix()
    unix * 1000

# ============================================================================
# Environment Operations (Pure Simple via shell)
# ============================================================================

fn env_get(key: text) -> text:
    val result = system_shell("echo ${key}")
    result.stdout.trim()

fn env_set(key: text, value: text) -> bool:
    val result = system_shell("export {key}='{value}'")
    result.exit_code == 0

fn cwd() -> text:
    val result = system_shell("pwd")
    result.stdout.trim()

fn home() -> text:
    env_get("HOME")
