# TensorF64 value operations. Conversion happens below the autograd tape.
use std.pure.tensor.{PureTensor}
use std.pure.tensor_f64.{TensorF64}
use std.pure.tensor_ops.{add as raw_add, sub as raw_sub, mul as raw_mul, matmul as raw_matmul, div as raw_div, transpose as raw_transpose, neg as raw_neg, tensor_exp as raw_tensor_exp, tensor_log as raw_tensor_log, tensor_sqrt as raw_tensor_sqrt, sigmoid as raw_sigmoid, tanh as raw_tanh, softmax as raw_softmax, mul_scalar as raw_mul_scalar, add_scalar as raw_add_scalar, div_scalar as raw_div_scalar}

fn raw(t: TensorF64) -> PureTensor<f64>:
    PureTensor(data: t.data, shape: t.shape, strides: t.strides)

fn typed(t: PureTensor<f64>) -> TensorF64:
    TensorF64(data: t.data, shape: t.shape, strides: t.strides)

fn add(a: TensorF64, b: TensorF64) -> TensorF64:
    typed(raw_add(raw(a), raw(b)))

fn sub(a: TensorF64, b: TensorF64) -> TensorF64:
    typed(raw_sub(raw(a), raw(b)))

fn mul(a: TensorF64, b: TensorF64) -> TensorF64:
    typed(raw_mul(raw(a), raw(b)))

fn matmul(a: TensorF64, b: TensorF64) -> TensorF64:
    typed(raw_matmul(raw(a), raw(b)))

fn div(a: TensorF64, b: TensorF64) -> TensorF64:
    typed(raw_div(raw(a), raw(b)))

fn transpose(t: TensorF64) -> TensorF64:
    typed(raw_transpose(raw(t)))

fn neg(t: TensorF64) -> TensorF64:
    typed(raw_neg(raw(t)))

fn tensor_exp(t: TensorF64) -> TensorF64:
    typed(raw_tensor_exp(raw(t)))

fn tensor_log(t: TensorF64) -> TensorF64:
    typed(raw_tensor_log(raw(t)))

fn tensor_sqrt(t: TensorF64) -> TensorF64:
    typed(raw_tensor_sqrt(raw(t)))

fn sigmoid(t: TensorF64) -> TensorF64:
    typed(raw_sigmoid(raw(t)))

fn tanh(t: TensorF64) -> TensorF64:
    typed(raw_tanh(raw(t)))

fn softmax(t: TensorF64) -> TensorF64:
    typed(raw_softmax(raw(t)))

fn mul_scalar(t: TensorF64, scalar: f64) -> TensorF64:
    typed(raw_mul_scalar(raw(t), scalar))

fn add_scalar(t: TensorF64, scalar: f64) -> TensorF64:
    typed(raw_add_scalar(raw(t), scalar))

fn div_scalar(t: TensorF64, scalar: f64) -> TensorF64:
    typed(raw_div_scalar(raw(t), scalar))

export add, sub, mul, matmul, div, transpose, neg, tensor_exp, tensor_log, tensor_sqrt, sigmoid, tanh, softmax, mul_scalar, add_scalar, div_scalar
