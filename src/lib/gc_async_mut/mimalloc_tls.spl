@no_gc
# Thread-local mimalloc heap adapter.
# Registry ownership: one module mutex serializes every registry/TLS transition.
# TLS transports a positive generation, never a pointer; zero means unbound.
# Records are retained only until reinitialization or explicit thread teardown.
# Module initialization must finish before spawning threads using this adapter.

use std.gc_async_mut.mimalloc.{MiHeap, mi_heap_new}
use std.nogc_sync_mut.runtime.thread_local.{
    thread_local_i64_new, thread_local_i64_get, thread_local_i64_set
}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}

struct MiThreadHeap:
    """Heap value paired with its unique positive registration generation."""
    heap: MiHeap
    thread_id: i64

struct MiTlsRegistry:
    """Only live registrations, plus the process-lifetime TLS handle."""
    heaps: [MiThreadHeap]
    tls_handle: i64

var _g_tls_registry = MiTlsRegistry(heaps: [], tls_handle: 0)
var _g_tls_next_slot: i64 = 1
val _g_tls_mutex = mutex_raw_create()

# The provider returns zero for an unbound thread. Registration generations
# begin at one so a fresh worker can never alias another thread's heap.
val _TLS_NO_SLOT: i64 = 0

fn _tls_lock():
    if not mutex_raw_lock(_g_tls_mutex):
        panic("mimalloc TLS registry mutex unavailable")

fn _tls_remove_heap(slot_id: i64):
    # Caller owns _g_tls_mutex. Never retain tombstones or reuse generations.
    if slot_id <= _TLS_NO_SLOT:
        return
    var remaining: [MiThreadHeap] = []
    for record in _g_tls_registry.heaps:
        if record.thread_id != slot_id:
            remaining = remaining.push(record)
    _g_tls_registry = MiTlsRegistry(
        heaps: remaining, tls_handle: _g_tls_registry.tls_handle)

fn mi_heap_new_thread() -> MiHeap:
    """Create an independent heap value without registering it."""
    mi_heap_new()

fn mimalloc_thread_init() -> MiThreadHeap:
    """Register a fresh heap, replacing this thread's previous registration.

    A generation is never reused. TLS exhaustion or generation exhaustion
    fails explicitly without publishing a record. Call destroy before exit.
    """
    val heap = mi_heap_new_thread()
    _tls_lock()
    if _g_tls_registry.tls_handle == 0:
        val handle = thread_local_i64_new()
        if handle <= 0:
            mutex_raw_unlock(_g_tls_mutex)
            panic("mimalloc TLS provider exhausted")
        _g_tls_registry = MiTlsRegistry(heaps: [], tls_handle: handle)
    if _g_tls_next_slot == 9223372036854775807:
        mutex_raw_unlock(_g_tls_mutex)
        panic("mimalloc TLS registration generation exhausted")
    val handle = _g_tls_registry.tls_handle
    val previous = thread_local_i64_get(handle)
    _tls_remove_heap(previous)
    val slot_id = _g_tls_next_slot
    _g_tls_next_slot = slot_id + 1
    val record = MiThreadHeap(heap: heap, thread_id: slot_id)
    val heaps = _g_tls_registry.heaps.push(record)
    _g_tls_registry = MiTlsRegistry(heaps: heaps, tls_handle: handle)
    thread_local_i64_set(handle, slot_id)
    mutex_raw_unlock(_g_tls_mutex)
    record

fn mimalloc_thread_heap() -> MiHeap:
    """Return this thread's registered heap, or a fresh unregistered heap."""
    _tls_lock()
    if _g_tls_registry.tls_handle != 0:
        val slot_id = thread_local_i64_get(_g_tls_registry.tls_handle)
        if slot_id > _TLS_NO_SLOT:
            for record in _g_tls_registry.heaps:
                if record.thread_id == slot_id:
                    val heap = record.heap
                    mutex_raw_unlock(_g_tls_mutex)
                    return heap
    mutex_raw_unlock(_g_tls_mutex)
    mi_heap_new()

fn mimalloc_thread_destroy():
    """Remove this thread's record and clear TLS; repeated teardown is safe."""
    _tls_lock()
    val handle = _g_tls_registry.tls_handle
    if handle != 0:
        val slot_id = thread_local_i64_get(handle)
        if slot_id > _TLS_NO_SLOT:
            _tls_remove_heap(slot_id)
            thread_local_i64_set(handle, _TLS_NO_SLOT)
    mutex_raw_unlock(_g_tls_mutex)

fn mimalloc_thread_registry_count() -> i64:
    """Return the number of retained live registrations for diagnostics."""
    _tls_lock()
    val count = _g_tls_registry.heaps.len()
    mutex_raw_unlock(_g_tls_mutex)
    count

export MiThreadHeap, MiTlsRegistry, mi_heap_new_thread
export mimalloc_thread_init, mimalloc_thread_heap, mimalloc_thread_destroy
export mimalloc_thread_registry_count
