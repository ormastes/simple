"""Bridge genuine CUDA WebIR/layout evidence into strict web-server admission."""

use std.common.structural.layout.{LayoutExecutionProof}
use std.web_db_offload.web_route.{WebGpuRouteKind}
use std.web_db_offload.web_profile.{
    WebGpuOffloadProfile,
    WebGpuProfileValidatedDeviceExecution,
    web_gpu_profile_execute_device_validated
}
use std.web_db_offload.device_backend.{
    GpuWdbDeviceBackend,
    GpuWdbDeviceReceipt,
    gpu_wdb_device_receipt
}

fn web_cuda_layout_device_receipt(
    proof: LayoutExecutionProof
) -> GpuWdbDeviceReceipt:
    val completed = (proof.executed_backend == "hybrid_vector_gpu" and
        proof.executed and proof.submitted and proof.synchronized and
        proof.device_readback and proof.oracle_verified)
    gpu_wdb_device_receipt(
        completed,
        proof.backend_handle,
        proof.device_identity,
        proof.readback_source,
        proof.expected_checksum,
        proof.actual_checksum,
        proof.mismatch_count,
        false)

fn web_cuda_layout_execute_device_validated(
    profile: WebGpuOffloadProfile,
    route: text,
    route_kind: WebGpuRouteKind,
    item_count: i64,
    bytes_per_item: i64,
    cpu_status: i64,
    cpu_body: text,
    gpu_candidate_status: i64,
    gpu_candidate_body: text,
    backend: GpuWdbDeviceBackend,
    expected_generation: i64,
    started_us: i64,
    finished_us: i64,
    proof: LayoutExecutionProof
) -> WebGpuProfileValidatedDeviceExecution:
    web_gpu_profile_execute_device_validated(
        profile,
        route,
        route_kind,
        item_count,
        bytes_per_item,
        cpu_status,
        cpu_body,
        backend,
        expected_generation,
        gpu_candidate_status,
        gpu_candidate_body,
        started_us,
        finished_us,
        proof.device_time_us,
        "cuda:web-layout-processing-ir",
        web_cuda_layout_device_receipt(proof))

export web_cuda_layout_device_receipt
export web_cuda_layout_execute_device_validated
