# Legacy network FFI spelling
#
# Keep one compatibility spelling, not another raw declaration authority.
# This is a compile-time re-export and therefore adds no hot-path work.

export use std.gc_async_mut.net.sffi.{udp_socket_bind,
    udp_socket_recv_from, udp_socket_send_to, udp_socket_connect,
    udp_socket_send, udp_socket_recv, udp_socket_local_addr,
    udp_socket_set_broadcast, udp_socket_set_multicast_loop,
    udp_socket_join_multicast, udp_socket_leave_multicast,
    udp_socket_set_read_timeout, udp_socket_set_nonblocking, udp_socket_close,
    bytes_to_string, file_write_bytes, url_encode, url_decode,
    http_request}
