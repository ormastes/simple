# Network SFFI compatibility facade
#
# Raw network declarations are owned once by the no-GC async module selected
# by `std.net.sffi`. This compile-time re-export prevents a second ABI owner
# without adding runtime lookup, allocation, copy, or dispatch.

export use std.nogc_async_mut.net.sffi.{bytes_to_string, file_write_bytes,
    url_encode, url_decode}
