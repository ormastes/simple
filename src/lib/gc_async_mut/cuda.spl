# CUDA Module — GC async variant
# @tag:internal
#
# Re-exports the canonical CUDA bindings from the nogc sffi layer.
# The gc_async_mut variant is identical at the handle/function level —
# the only differences are in ownership/lifecycle of callers, not in
# the CUDA API itself.
#
# Consumers: use std.gc_async_mut.cuda.{cuda_available, cuda_init, ...}
#
# See also: std.nogc_sync_mut.cuda (same API, different module path)

use std.nogc_sync_mut.cuda.sffi.*

extern fn rt_is_interpreter_runtime() -> bool
extern fn rt_text_to_bytes(value: text) -> [u8]
extern fn rt_cuda_module_load_data_array(bytes: [u8]) -> i64
extern fn rt_cuda_launch_kernel_name_array(
    module: i64, name: [u8], grid_x: i64, grid_y: i64, grid_z: i64,
    block_x: i64, block_y: i64, block_z: i64, args_ptr: i64) -> i64

val CUDA_SUCCESS = 0
val CUDA_ERROR_INVALID_VALUE = -1
val CUDA_ERROR_OUT_OF_MEMORY = -2
val CUDA_ERROR_NOT_INITIALIZED = -3
val CUDA_ERROR_NO_DEVICE = -100

fn cuda_available() -> bool:
    rt_cuda_available() != 0

fn cuda_init() -> i64:
    rt_cuda_init()

fn cuda_device_count() -> i64:
    rt_cuda_device_count()

fn cuda_device_get(device_id: i64) -> i64:
    rt_cuda_device_get(device_id)

fn cuda_device_name(device: i64) -> text:
    rt_cuda_device_name(device)

fn cuda_device_compute_capability(device: i64) -> i64:
    rt_cuda_device_compute_capability(device)

fn cuda_ctx_create(device: i64) -> i64:
    rt_cuda_ctx_create(device)

fn cuda_ctx_set_current(ctx: i64) -> i64:
    rt_cuda_ctx_set_current(ctx)

fn cuda_ctx_destroy(ctx: i64) -> i64:
    rt_cuda_ctx_destroy(ctx)

fn cuda_ctx_synchronize() -> i64:
    rt_cuda_ctx_synchronize()

fn cuda_mem_alloc(size: i64) -> i64:
    rt_cuda_mem_alloc(size)

fn cuda_mem_free(ptr: i64) -> i64:
    rt_cuda_mem_free(ptr)

fn cuda_memcpy_htod(dst: i64, src: i64, size: i64) -> i64:
    rt_cuda_memcpy_htod(dst, src, size)

fn cuda_memcpy_dtoh(dst: i64, src: i64, size: i64) -> i64:
    rt_cuda_memcpy_dtoh(dst, src, size)

fn cuda_memcpy_dtod(dst: i64, src: i64, size: i64) -> i64:
    rt_cuda_memcpy_dtod(dst, src, size)

fn cuda_memset(ptr: i64, value: i64, size: i64) -> i64:
    rt_cuda_memset(ptr, value, size)

fn cuda_module_load(path: text) -> i64:
    rt_cuda_module_load(path)

fn cuda_module_load_data(ptx: text) -> i64:
    if rt_is_interpreter_runtime():
        return rt_cuda_module_load_data(ptx)
    val bytes = rt_text_to_bytes(ptx)
    rt_cuda_module_load_data_array(bytes)

# Load an already-admitted cubin/fatbin byte image. Keeping the artifact in a
# Simple byte array binds the bytes hashed by the provider to the bytes passed
# to cuModuleLoadData and removes the path re-open TOCTOU window.
fn cuda_module_load_binary(bytes: [u8]) -> i64:
    if bytes.len() == 0:
        return 0
    rt_cuda_module_load_data_array(bytes)

fn cuda_module_unload(module: i64) -> i64:
    rt_cuda_module_unload(module)

fn cuda_module_get_function(module: i64, func_name: text) -> i64:
    rt_cuda_module_get_function(module, func_name)

fn cuda_launch_kernel(module: i64, func_name: text, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, args_ptr: i64) -> i64:
    if rt_is_interpreter_runtime():
        return rt_cuda_launch_kernel(module, func_name, grid_x, grid_y, grid_z, block_x, block_y, block_z, args_ptr)
    val name_bytes = rt_text_to_bytes(func_name)
    rt_cuda_launch_kernel_name_array(
        module, name_bytes,
        grid_x, grid_y, grid_z, block_x, block_y, block_z, args_ptr)

fn cuda_sync() -> i64:
    rt_cuda_sync()

fn cuda_get_error_string(error_code: i64) -> text:
    rt_cuda_get_error_string(error_code)

export CUDA_SUCCESS, CUDA_ERROR_INVALID_VALUE, CUDA_ERROR_OUT_OF_MEMORY, CUDA_ERROR_NOT_INITIALIZED, CUDA_ERROR_NO_DEVICE
export cuda_available, cuda_init, cuda_device_count, cuda_device_get, cuda_device_name
export cuda_device_compute_capability, cuda_ctx_create, cuda_ctx_set_current, cuda_ctx_destroy, cuda_ctx_synchronize
export cuda_mem_alloc, cuda_mem_free, cuda_memcpy_htod, cuda_memcpy_dtoh, cuda_memcpy_dtod
export cuda_memset, cuda_module_load, cuda_module_load_data
export cuda_module_load_binary, cuda_module_unload
export cuda_module_get_function, cuda_launch_kernel, cuda_sync, cuda_get_error_string
