# Shared facade from WebRenderRequest envelopes to Simple Web pixels.
#
# This module intentionally sits above the concrete browser-engine renderer so
# UI and compositor code can depend on the common web-render API shape without
# importing the low-level Simple Web renderer directly.

use std.common.ui.web_render_api.{
    WEB_RENDER_QUEUE_STATUS_DRAINED,
    WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED,
    WEB_RENDER_QUEUE_STATUS_SUBMITTED,
    WEB_RENDER_QUEUE_STATUS_UNAVAILABLE,
    WEB_RENDER_TARGET_PURE_SIMPLE,
    WebRenderArtifact,
    WebRenderMaterialFallbackProvenance,
    WebRenderRequest,
    web_render_artifact_with_backend_readback,
    web_render_artifact_with_backend_readback_source,
    web_render_artifact_with_material_fallback,
    web_render_artifact_with_runtime_queue,
    web_render_artifact_with_runtime_queue_handle,
    web_render_dynamic_region_count,
    web_render_engine2d_rendered_artifact,
    web_render_engine2d_unavailable_artifact,
    web_render_full_html,
    web_render_pixel_artifact,
    web_render_url_request
}
use std.common.ui.draw_ir.{DrawIrComposition}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels,
    simple_web_render_html_to_pixels_with_engine2d_backend,
    simple_web_render_html_to_readback_result_with_engine2d_backend,
    simple_web_render_html_to_readback_result_with_engine2d_backend_at_time,
    simple_web_render_html_to_pixels_with_engine2d_backend_at_time_into,
    simple_web_render_html_to_pixels_with_engine2d_backend_at_time_into_receipt,
    simple_web_render_url_to_pixels,
    simple_web_resolved_engine2d_backend_name
}
use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    SIMPLE_WEB_PIXEL_CACHE_MODE_TERMINAL,
    SIMPLE_WEB_PIXEL_CACHE_MODE_UNTIMED_STATIC,
    SimpleWebEngine2DStaticPixelCache
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_animation_end_ms
}
use std.gc_async_mut.gpu.engine2d.engine_target.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_draw_ir_adv_composition}
@cfg("os", "simpleos")
use std.gc_async_mut.ui.web_render_runtime_queue_simpleos.{web_render_artifact_with_runtime_queue_evidence}
@cfg("os", "macos")
use std.gc_async_mut.ui.web_render_runtime_queue_hosted.{web_render_artifact_with_runtime_queue_evidence}
@cfg("os", "linux")
use std.gc_async_mut.ui.web_render_runtime_queue_hosted.{web_render_artifact_with_runtime_queue_evidence}
@cfg("os", "windows")
use std.gc_async_mut.ui.web_render_runtime_queue_hosted.{web_render_artifact_with_runtime_queue_evidence}

fn web_render_runtime_queue_available(backend_name: text) -> bool:
    if backend_name == "metal":
        return true
    if backend_name == "cuda":
        return true
    if backend_name == "rocm" or backend_name == "hip":
        return true
    if backend_name == "vulkan":
        return true
    false

# SimpleOS WM pixels travel through the narrow cache-owned delivery lane below.
# Never place the live array handle in the large WebRenderArtifact aggregate:
# native freestanding decorator returns can overwrite the pointed RuntimeArray
# header/items field while reconstructing that aggregate. Hosted targets retain
# the existing artifact pixel contract.
@cfg("os", "simpleos")
fn _web_render_cache_artifact_pixels(pixels: [u32]) -> [u32]:
    []

@cfg(macos or linux or windows or freebsd or openbsd or netbsd or android)
fn _web_render_cache_artifact_pixels(pixels: [u32]) -> [u32]:
    pixels

fn web_render_backend_readback_checksum(pixels: [u32]) -> i64:
    var checksum: i64 = 0
    var i = 0
    while i < pixels.len():
        checksum = (checksum + pixels[i].to_i64() * (i.to_i64() + 1)) % 2147483647
        i = i + 1
    checksum

fn web_render_artifact_with_backend_readback_evidence(artifact: WebRenderArtifact, backend_name: text) -> WebRenderArtifact:
    if not web_render_runtime_queue_available(backend_name):
        return artifact
    web_render_artifact_with_backend_readback(artifact, "readback", backend_name, artifact.pixels.len().to_i64(), web_render_backend_readback_checksum(artifact.pixels), "same-frame Engine2D read_pixels")

fn web_render_artifact_with_backend_readback_source_evidence(artifact: WebRenderArtifact, backend_name: text, source: text) -> WebRenderArtifact:
    if artifact.pixels.len() == 0:
        return artifact
    val receipt_source = if source == "": "engine2d_pixel_readback" else: source
    web_render_artifact_with_backend_readback_source(artifact, "readback", backend_name, artifact.pixels.len().to_i64(), web_render_backend_readback_checksum(artifact.pixels), "same-frame Engine2D read_pixels", receipt_source)

pub fn web_render_draw_ir_request_to_pixel_artifact(req: WebRenderRequest, composition: DrawIrComposition, backend_name: text) -> WebRenderArtifact:
    val backend = simple_web_resolved_engine2d_backend_name(req.viewport_w, req.viewport_h, backend_name)
    val empty = web_render_pixel_artifact(req.with_pixel_output(), [])
    if req.viewport_w <= 0 or req.viewport_h <= 0:
        return web_render_engine2d_unavailable_artifact(empty, backend, "invalid Draw IR viewport")
    var engine = Engine2D.create_with_backend_fast(req.viewport_w, req.viewport_h, backend)
    engine.clear(0u32)
    val selected = engine.backend_name()
    val result = engine2d_draw_ir_adv_composition(engine, composition, true)
    engine.shutdown()
    if result.skipped_command_count != 0 or result.pixels.len() != req.viewport_w * req.viewport_h:
        return web_render_engine2d_unavailable_artifact(empty, selected, "Draw IR execution incomplete")
    val rendered = web_render_engine2d_rendered_artifact(web_render_pixel_artifact(req.with_pixel_output(), result.pixels), selected)
    val readback = web_render_artifact_with_backend_readback_source_evidence(rendered, selected, result.readback_source)
    # Generic Draw IR does not carry the producer-owned typed material witness
    # emitted by the HTML layout renderer. Even a complete CPU execution must
    # not recover provenance from copied nested computed_style metadata.
    web_render_artifact_with_material_fallback(
        readback,
        WebRenderMaterialFallbackProvenance.none())

class WebRenderPixelArtifactCache:
    width: i32
    height: i32
    backend_name: text
    resolved_backend_name: text
    pixel_cache: SimpleWebEngine2DStaticPixelCache
    animation_revision: i64
    animation_epoch_ms: i64
    animation_end_ms: i64
    animation_next_frame_ms: i64

impl WebRenderPixelArtifactCache:
    static fn create(width: i32, height: i32, backend_name: text) -> WebRenderPixelArtifactCache:
        val resolved = web_render_resolved_engine2d_backend_name(width, height, backend_name)
        WebRenderPixelArtifactCache(
            width: width,
            height: height,
            backend_name: backend_name,
            resolved_backend_name: resolved,
            pixel_cache: SimpleWebEngine2DStaticPixelCache.create(width, height, resolved),
            animation_revision: -1,
            animation_epoch_ms: 0,
            animation_end_ms: -1,
            animation_next_frame_ms: -1
        )

    me _record_wm_receipt(
        receipt: [text], status: text, backend: text, reason: text,
        material_kind: text, material_reason: text, material_sha256: text
    ):
        if receipt.len() < 6:
            return
        receipt[0] = status
        receipt[1] = backend
        receipt[2] = reason
        receipt[3] = material_kind
        receipt[4] = material_reason
        receipt[5] = material_sha256

    me _html_request_to_pixel_artifact_with_revision(
        req: WebRenderRequest, full_html: text, content_revision: i64,
        wm_receipt: [text]
    ) -> WebRenderArtifact:
        if req.viewport_w != self.width or req.viewport_h != self.height:
            return web_render_html_request_to_pixel_artifact_with_backend(req, full_html, self.backend_name)
        if web_render_dynamic_region_count(req) > 0:
            return web_render_html_request_to_pixel_artifact_with_backend(req, full_html, self.backend_name)
        var pixel_cache = self.pixel_cache
        val result = pixel_cache.result_for_html(
            full_html, SIMPLE_WEB_PIXEL_CACHE_MODE_UNTIMED_STATIC,
            content_revision
        )
        self.pixel_cache = pixel_cache
        val rendered_pixels = result.readback.pixels
        self._record_wm_receipt(
            wm_receipt, "engine2d_rendered", self.resolved_backend_name,
            "rendered through Engine2D", result.material_fallback.kind,
            result.material_fallback.reason,
            result.material_fallback.material_sha256
        )
        val artifact = web_render_artifact_with_backend_readback_source_evidence(web_render_engine2d_rendered_artifact(web_render_pixel_artifact(req.with_pixel_output(), _web_render_cache_artifact_pixels(rendered_pixels)), self.resolved_backend_name), self.resolved_backend_name, result.readback.source)
        val queued = web_render_artifact_with_runtime_queue_evidence(artifact, self.resolved_backend_name)
        web_render_artifact_with_material_fallback(queued, result.material_fallback)

    me html_request_to_pixel_artifact(
        req: WebRenderRequest, full_html: text
    ) -> WebRenderArtifact:
        self._html_request_to_pixel_artifact_with_revision(
            req, full_html, -1, []
        )

    me request_to_pixel_artifact_with_wm_receipt(
        req: WebRenderRequest, wm_receipt: [text]
    ) -> WebRenderArtifact:
        self._html_request_to_pixel_artifact_with_revision(
            req, web_render_full_html(req), -1, wm_receipt
        )

    me request_to_pixel_artifact(req: WebRenderRequest) -> WebRenderArtifact:
        self.html_request_to_pixel_artifact(
            req, web_render_full_html(req)
        )

    me request_to_pixel_artifact_at_time(
        req: WebRenderRequest, content_revision: i64, now_ms: i64,
        wm_receipt: [text]
    ) -> WebRenderArtifact:
        val full_html = web_render_full_html(req)
        var pixel_cache = self.pixel_cache
        if self.animation_revision != content_revision:
            self.animation_revision = content_revision
            self.animation_epoch_ms = now_ms
            self.animation_end_ms = simple_web_layout_animation_end_ms(
                full_html, req.viewport_w
            )
            if self.animation_end_ms != -1:
                pixel_cache.invalidate()
                self.pixel_cache = pixel_cache
        if self.animation_end_ms == -1:
            self.animation_next_frame_ms = -1
            return self._html_request_to_pixel_artifact_with_revision(
                req, full_html, content_revision, wm_receipt
            )
        val elapsed = if now_ms > self.animation_epoch_ms:
            now_ms - self.animation_epoch_ms
        else:
            0
        val terminal = (
            self.animation_end_ms >= 0 and
            elapsed >= self.animation_end_ms
        )
        val terminal_cacheable = (
            terminal and req.viewport_w == self.width and
            req.viewport_h == self.height and
            web_render_dynamic_region_count(req) == 0
        )
        if terminal_cacheable:
            if val Some(cached) = pixel_cache.cached_result_for_html(
                full_html, SIMPLE_WEB_PIXEL_CACHE_MODE_TERMINAL,
                content_revision
            ):
                self.pixel_cache = pixel_cache
                self.animation_next_frame_ms = -1
                self._record_wm_receipt(
                    wm_receipt, "engine2d_rendered",
                    self.resolved_backend_name, "rendered through Engine2D",
                    cached.material_fallback.kind,
                    cached.material_fallback.reason,
                    cached.material_fallback.material_sha256
                )
                val artifact = web_render_artifact_with_backend_readback_source_evidence(
                    web_render_engine2d_rendered_artifact(
                        web_render_pixel_artifact(
                            req.with_pixel_output(),
                            _web_render_cache_artifact_pixels(cached.readback.pixels)
                        ),
                        self.resolved_backend_name
                    ),
                    self.resolved_backend_name,
                    cached.readback.source
                )
                val queued = web_render_artifact_with_runtime_queue_evidence(
                    artifact, self.resolved_backend_name
                )
                return web_render_artifact_with_material_fallback(
                    queued, cached.material_fallback
                )
        val result = (
            simple_web_render_html_to_readback_result_with_engine2d_backend_at_time(
                full_html, req.viewport_w, req.viewport_h,
                self.backend_name, elapsed
            )
        )
        self._record_wm_receipt(
            wm_receipt, "engine2d_rendered", self.resolved_backend_name,
            "rendered through Engine2D", result.material_fallback.kind,
            result.material_fallback.reason,
            result.material_fallback.material_sha256
        )
        # Preserve the direct array handle before any large WebRenderArtifact
        # reconstruction. Nonterminal animation frames are not normal cache
        # entries, but the compositor still needs this exact rendered frame.
        pixel_cache.retain_delivered_pixels(result.readback.pixels)
        if self.animation_end_ms == -2:
            self.animation_next_frame_ms = now_ms + 16
        elif elapsed >= self.animation_end_ms:
            self.animation_next_frame_ms = -1
        else:
            val final_frame_ms = self.animation_epoch_ms + self.animation_end_ms
            val cadence_frame_ms = now_ms + 16
            self.animation_next_frame_ms = if cadence_frame_ms < final_frame_ms:
                cadence_frame_ms
            else:
                final_frame_ms
        if terminal_cacheable:
            pixel_cache.retain_result_for_html(
                full_html, SIMPLE_WEB_PIXEL_CACHE_MODE_TERMINAL,
                content_revision, result
            )
        self.pixel_cache = pixel_cache
        val artifact = web_render_artifact_with_backend_readback_source_evidence(
            web_render_engine2d_rendered_artifact(
                web_render_pixel_artifact(
                    req.with_pixel_output(),
                    _web_render_cache_artifact_pixels(result.readback.pixels)
                ),
                self.resolved_backend_name
            ),
            self.resolved_backend_name,
            result.readback.source
        )
        val queued = web_render_artifact_with_runtime_queue_evidence(
            artifact, self.resolved_backend_name
        )
        web_render_artifact_with_material_fallback(
            queued, result.material_fallback
        )

    fn animation_frame_due(now_ms: i64) -> bool:
        self.animation_next_frame_ms >= 0 and now_ms >= self.animation_next_frame_ms

    fn hits() -> i32:
        self.pixel_cache.hits

    fn retained_pixels_after_metadata(expected_count: i32) -> [u32]:
        self.pixel_cache.retained_pixels(expected_count)

    # Produce the live pixel array only AFTER all large WebRenderArtifact
    # metadata returns have completed. Native freestanding aggregate lowering
    # can overwrite an array referenced by that metadata path even when the
    # final SimpleOS artifact payload is empty. This direct renderer has no
    # subsequent artifact boundary; WM consumes/checksums it immediately.
    me render_pixels_after_metadata_html_at_time_into(
        full_html: text, viewport_w: i32, viewport_h: i32,
        content_revision: i64, now_ms: i64,
        destination: [u32], wm_receipt: [text]
    ) -> i32:
        if viewport_w != self.width or viewport_h != self.height:
            return -5
        if now_ms >= 0 and self.animation_revision != content_revision:
            self.animation_revision = content_revision
            self.animation_epoch_ms = now_ms
            self.animation_end_ms = simple_web_layout_animation_end_ms(
                full_html, viewport_w
            )
        var elapsed: i64 = -1
        if now_ms < 0:
            elapsed = -1
        elif self.animation_end_ms == -1:
            elapsed = -1
        elif now_ms > self.animation_epoch_ms:
            elapsed = now_ms - self.animation_epoch_ms
        else:
            elapsed = 0
        var material_receipt: [text] = ["", "", "", "", "", "", "", "", ""]
        val status = simple_web_render_html_to_pixels_with_engine2d_backend_at_time_into_receipt(
            full_html, viewport_w, viewport_h,
            self.backend_name, elapsed, destination, material_receipt
        )
        if status == 1:
            if material_receipt[0] == "":
                var has_material_witness = false
                if material_receipt[3] != "":
                    if material_receipt[3] != "0":
                        has_material_witness = true
                if material_receipt[4] != "":
                    if material_receipt[4] != "0":
                        has_material_witness = true
                if material_receipt[7] != "":
                    if material_receipt[7] != "0":
                        has_material_witness = true
                if not has_material_witness:
                    material_receipt[0] = "none"
                    material_receipt[1] = "not-requested"
                    material_receipt[2] = ""
        if wm_receipt.len() >= 3:
            if status == 1:
                wm_receipt[0] = "engine2d_rendered"
                wm_receipt[1] = self.resolved_backend_name
                wm_receipt[2] = "rendered through Engine2D"
            else:
                wm_receipt[0] = "engine2d_unavailable"
                wm_receipt[1] = self.resolved_backend_name
                wm_receipt[2] = "Engine2D destination render failed"
        if wm_receipt.len() >= 6:
            wm_receipt[3] = material_receipt[0]
            wm_receipt[4] = material_receipt[1]
            wm_receipt[5] = material_receipt[2]
        if wm_receipt.len() >= 12:
            wm_receipt[6] = material_receipt[3]
            wm_receipt[7] = material_receipt[4]
            wm_receipt[8] = material_receipt[5]
            wm_receipt[9] = material_receipt[6]
            wm_receipt[10] = material_receipt[7]
            wm_receipt[11] = material_receipt[8]
        status

    fn stores() -> i32:
        self.pixel_cache.stores

pub fn web_render_request_to_pixels(req: WebRenderRequest) -> [u32]:
    simple_web_render_html_to_pixels(web_render_full_html(req), req.viewport_w, req.viewport_h)

pub fn web_render_request_to_pixels_with_backend(req: WebRenderRequest, backend_name: text) -> [u32]:
    simple_web_render_html_to_pixels_with_engine2d_backend(web_render_full_html(req), req.viewport_w, req.viewport_h, backend_name)

pub fn web_render_html_request_to_pixels(req: WebRenderRequest, full_html: text) -> [u32]:
    simple_web_render_html_to_pixels(full_html, req.viewport_w, req.viewport_h)

pub fn web_render_html_request_to_pixels_with_backend(req: WebRenderRequest, full_html: text, backend_name: text) -> [u32]:
    simple_web_render_html_to_pixels_with_engine2d_backend(full_html, req.viewport_w, req.viewport_h, backend_name)

pub fn web_render_request_to_pixel_artifact(req: WebRenderRequest) -> WebRenderArtifact:
    val backend = web_render_resolved_engine2d_backend_name(req.viewport_w, req.viewport_h, "auto")
    val result = simple_web_render_html_to_readback_result_with_engine2d_backend(web_render_full_html(req), req.viewport_w, req.viewport_h, backend)
    val artifact = web_render_artifact_with_backend_readback_source_evidence(web_render_engine2d_rendered_artifact(web_render_pixel_artifact(req.with_pixel_output(), result.readback.pixels), backend), backend, result.readback.source)
    val queued = web_render_artifact_with_runtime_queue_evidence(artifact, backend)
    web_render_artifact_with_material_fallback(queued, result.material_fallback)

pub fn web_render_html_request_to_pixel_artifact(req: WebRenderRequest, full_html: text) -> WebRenderArtifact:
    val backend = web_render_resolved_engine2d_backend_name(req.viewport_w, req.viewport_h, "auto")
    val result = simple_web_render_html_to_readback_result_with_engine2d_backend(full_html, req.viewport_w, req.viewport_h, backend)
    val artifact = web_render_artifact_with_backend_readback_source_evidence(web_render_engine2d_rendered_artifact(web_render_pixel_artifact(req.with_pixel_output(), result.readback.pixels), backend), backend, result.readback.source)
    val queued = web_render_artifact_with_runtime_queue_evidence(artifact, backend)
    web_render_artifact_with_material_fallback(queued, result.material_fallback)

pub fn web_render_html_request_to_pixel_artifact_with_backend(req: WebRenderRequest, full_html: text, backend_name: text) -> WebRenderArtifact:
    val backend = web_render_resolved_engine2d_backend_name(req.viewport_w, req.viewport_h, backend_name)
    val result = simple_web_render_html_to_readback_result_with_engine2d_backend(full_html, req.viewport_w, req.viewport_h, backend_name)
    val artifact = web_render_artifact_with_backend_readback_source_evidence(web_render_engine2d_rendered_artifact(web_render_pixel_artifact(req.with_pixel_output(), result.readback.pixels), backend), backend, result.readback.source)
    val queued = web_render_artifact_with_runtime_queue_evidence(artifact, backend)
    web_render_artifact_with_material_fallback(queued, result.material_fallback)

pub fn web_render_pixel_artifact_cache(width: i32, height: i32, backend_name: text) -> WebRenderPixelArtifactCache:
    WebRenderPixelArtifactCache.create(width, height, backend_name)

pub fn web_render_url_request_to_pixels(req: WebRenderRequest) -> [u32]:
    web_render_request_to_pixels(req.with_pixel_output())

pub fn web_render_url_to_request(target: text, url: text, width: i32, height: i32) -> WebRenderRequest:
    web_render_url_request(target, url, width, height).with_pixel_output()

pub fn web_render_url_to_pixels(url: text, width: i64, height: i64) -> [u8]:
    simple_web_render_url_to_pixels(url, width, height)

pub fn web_render_default_page_html(url: text) -> text:
    web_render_full_html(web_render_url_request(WEB_RENDER_TARGET_PURE_SIMPLE, url, 0, 0))

pub fn web_render_resolved_engine2d_backend_name(width: i32, height: i32, backend_name: text) -> text:
    simple_web_resolved_engine2d_backend_name(width, height, backend_name)
