# Hosted Engine2D runtime-queue evidence owner.

use std.common.ui.web_render_api.{
    WEB_RENDER_QUEUE_STATUS_DRAINED,
    WEB_RENDER_QUEUE_STATUS_SUBMITTED,
    WEB_RENDER_QUEUE_STATUS_UNAVAILABLE,
    WebRenderArtifact,
    web_render_artifact_with_runtime_queue_handle
}
use std.gc_async_mut.gpu.engine2d.backend_lane.{
    ENGINE2D_HOST_GPU_LANE_GPU,
    ENGINE2D_HOST_GPU_LANE_HOST,
    engine2d_host_gpu_lane_schedule
}
use std.gc_async_mut.gpu.engine2d.host_gpu_event_queue.{
    engine2d_host_gpu_event,
    engine2d_host_gpu_event_handler_decision,
    engine2d_host_gpu_event_submit_to_runtime,
    engine2d_host_gpu_runtime_drain,
    engine2d_host_gpu_runtime_queue_with_backend_handle
}

fn _web_render_runtime_queue_available(backend_name: text) -> bool:
    backend_name == "metal" or backend_name == "cuda" or
    backend_name == "rocm" or backend_name == "hip" or
    backend_name == "vulkan"

fn web_render_artifact_with_runtime_queue_evidence(
    artifact: WebRenderArtifact, backend_name: text
) -> WebRenderArtifact:
    if not _web_render_runtime_queue_available(backend_name):
        return artifact
    val packet_bytes = artifact.viewport_w.to_i64() * artifact.viewport_h.to_i64() * 4
    val queue = engine2d_host_gpu_runtime_queue_with_backend_handle(
        backend_name, 1, 7, true, packet_bytes + 4096)
    val lane_result = engine2d_host_gpu_lane_schedule(
        ENGINE2D_HOST_GPU_LANE_HOST,
        ENGINE2D_HOST_GPU_LANE_GPU,
        "frame_batch",
        packet_bytes,
        queue.max_packet_bytes,
        false,
        false,
        true,
        1
    )
    val event = engine2d_host_gpu_event(
        "web-render-frame", ENGINE2D_HOST_GPU_LANE_GPU, "frame_batch",
        packet_bytes, queue.max_packet_bytes, false, false, false, true)
    val decision = engine2d_host_gpu_event_handler_decision(event, lane_result)
    val submit = engine2d_host_gpu_event_submit_to_runtime(queue, decision, lane_result)
    val drain = if submit.submitted:
        engine2d_host_gpu_runtime_drain(queue, 1)
    else:
        engine2d_host_gpu_runtime_drain(queue, 0)
    val submit_status = if submit.submitted:
        WEB_RENDER_QUEUE_STATUS_SUBMITTED
    else:
        WEB_RENDER_QUEUE_STATUS_UNAVAILABLE
    val drain_status = if drain.drained > 0:
        WEB_RENDER_QUEUE_STATUS_DRAINED
    else:
        WEB_RENDER_QUEUE_STATUS_UNAVAILABLE
    web_render_artifact_with_runtime_queue_handle(
        artifact, submit_status, drain_status, submit.packet_id,
        drain.drained, drain.last_backend_handle, drain.diagnostic)
