# Hosted GUI producer for the shared WM content-frame boundary.

use common.ui.wm_gui_content_frame.{wm_gui_content_frame_from_pixels}
use common.ui.window_scene.{WmContentFrame}
use nogc_sync_mut.ui.session.{UISession}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_with_images,
}
use std.gc_async_mut.gpu.engine2d.engine_target.{Engine2D}

fn gui_content_frame_clear_color() -> u32:
    """The canonical widget composition owns its first theme-derived seed."""
    0u32

fn gui_session_content_frame(
    session: UISession,
    window_id: text,
    parent_window_id: text,
    offset_x: i32,
    offset_y: i32,
    width: i32,
    height: i32,
    scene_revision: i64,
    content_revision: i64,
    images: [Engine2dResolvedDrawIrImage],
) -> WmContentFrame:
    if width <= 0 or height <= 0:
        return wm_gui_content_frame_from_pixels(
            window_id, parent_window_id, offset_x, offset_y,
            width, height, [], scene_revision, content_revision
        )
    val composition = session.submit_widget_draw_ir(width, height, "cpu")
    var engine = Engine2D.create_with_backend(width, height, "cpu")
    # The canonical widget Draw IR begins with its package-derived opaque
    # surface initializer. Keep the renderer neutral so it cannot shadow or
    # compete with the selected ThemeRenderSnapshot.
    engine.clear(gui_content_frame_clear_color())
    val rendered = engine2d_draw_ir_adv_composition_with_images(
        engine, composition, false, images
    )
    engine.shutdown()
    if (rendered.fallback_required or rendered.skipped_command_count != 0 or
        rendered.pixels.len() != width * height):
        return wm_gui_content_frame_from_pixels(
            window_id, parent_window_id, offset_x, offset_y,
            width, height, [], scene_revision, content_revision
        )
    wm_gui_content_frame_from_pixels(
        window_id, parent_window_id, offset_x, offset_y,
        width, height, rendered.pixels, scene_revision, content_revision
    )

export gui_content_frame_clear_color
