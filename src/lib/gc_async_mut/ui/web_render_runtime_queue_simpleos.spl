# SimpleOS uses the WM frame executor/IVSHMEM bridge for device transport.
# Hosted runtime queue telemetry is unavailable and must not be fabricated.

use std.common.ui.web_render_api.{WebRenderArtifact}

fn web_render_artifact_with_runtime_queue_evidence(
    artifact: WebRenderArtifact, backend_name: text
) -> WebRenderArtifact:
    artifact

