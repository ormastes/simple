# Crypto-owned persistent CUDA session.
#
# This adapter is the only CUDA lifecycle surface used by crypto providers.
# It delegates to the canonical CUDA facade and deliberately has no raw FFI
# declarations or dependencies on rendering/Engine2D ownership.

mod std.gc_async_mut.crypto_accel.cuda_session

use std.gc_async_mut.cuda.{cuda_available, cuda_init, cuda_device_count,
    cuda_device_get, cuda_ctx_create, cuda_ctx_set_current, cuda_ctx_destroy,
    cuda_mem_alloc, cuda_mem_free, cuda_memcpy_htod, cuda_memcpy_dtoh,
    cuda_memset, cuda_module_load_data, cuda_module_load_binary,
    cuda_module_unload,
    cuda_launch_kernel, cuda_sync, CUDA_SUCCESS}
use std.gc_async_mut.gpu_ffi.{cuda_device_identity, cuda_device_name,
    cuda_device_compute_capability}

class CryptoCudaSession:
    device_ordinal: i64
    device: i64
    context: i64
    module: i64
    initialized: bool
    completion_unknown: bool
    generation: i64

    static fn create() -> CryptoCudaSession:
        CryptoCudaSession.create_for_device(0)

    static fn create_for_device(device_ordinal: i64) -> CryptoCudaSession:
        CryptoCudaSession(device_ordinal: device_ordinal,
            device: 0, context: 0, module: 0,
            initialized: false, completion_unknown: false, generation: 0)

    me is_valid() -> bool:
        self.initialized and self.context != 0 and
            not self.completion_unknown

    me init() -> i64:
        if self.initialized or self.context != 0 or self.completion_unknown:
            return 1
        if self.device_ordinal < 0:
            return 1
        val cuda_missing = not cuda_available()
        if cuda_missing:
            return 1
        val initialization_failed = cuda_init() != CUDA_SUCCESS
        if initialization_failed:
            return 1
        val device_count = cuda_device_count()
        if device_count < 1 or self.device_ordinal >= device_count:
            return 1
        self.device = cuda_device_get(self.device_ordinal)
        self.context = cuda_ctx_create(self.device)
        if self.context == 0:
            self.device = 0
            return 1
        self.initialized = true
        self.generation = self.generation + 1
        CUDA_SUCCESS

    me activate() -> i64:
        if not self.is_valid():
            return 1
        cuda_ctx_set_current(self.context)

    me load_module(source: text) -> i64:
        if not self.is_valid() or source == "":
            return 0
        val loaded = cuda_module_load_data(source)
        if loaded <= 0:
            return 0
        if self.module != 0:
            val _unloaded = cuda_module_unload(self.module)
        self.module = loaded
        loaded

    me load_module_binary(bytes: [u8]) -> i64:
        if not self.is_valid() or bytes.len() == 0:
            return 0
        val loaded = cuda_module_load_binary(bytes)
        if loaded <= 0:
            return 0
        if self.module != 0:
            val _unloaded = cuda_module_unload(self.module)
        self.module = loaded
        loaded

    me alloc(byte_count: i64) -> i64:
        if byte_count <= 0 or not self.is_valid():
            return 0
        cuda_mem_alloc(byte_count)

    me free(ptr: i64):
        if ptr != 0 and not self.completion_unknown:
            val _freed = cuda_mem_free(ptr)

    me upload(dst: i64, src: i64, byte_count: i64) -> i64:
        if not self.is_valid() or dst == 0 or src == 0 or byte_count <= 0:
            return 1
        cuda_memcpy_htod(dst, src, byte_count)

    me readback(dst: i64, src: i64, byte_count: i64) -> i64:
        if not self.is_valid() or dst == 0 or src == 0 or byte_count <= 0:
            return 1
        cuda_memcpy_dtoh(dst, src, byte_count)

    me clear(ptr: i64, byte_count: i64) -> i64:
        if not self.is_valid() or ptr == 0 or byte_count <= 0:
            return 1
        cuda_memset(ptr, 0, byte_count)

    me launch(entry: text, grid_x: i64, block_x: i64,
            args_ptr: i64) -> i64:
        val session_invalid = not self.is_valid()
        if session_invalid:
            return 1
        val entry_invalid = self.module == 0 or entry == ""
        val shape_invalid = grid_x <= 0 or block_x <= 0 or args_ptr == 0
        if entry_invalid or shape_invalid:
            return 1
        cuda_launch_kernel(self.module, entry,
            grid_x, 1, 1, block_x, 1, 1, args_ptr)

    me sync() -> i64:
        if not self.is_valid():
            return 1
        val rc = cuda_sync()
        if rc != CUDA_SUCCESS:
            self.completion_unknown = true
        rc

    me identity() -> i64:
        if not self.is_valid():
            return 0
        cuda_device_identity(self.device)

    me stable_device_name() -> text:
        if not self.is_valid():
            return ""
        val name = cuda_device_name(self.device)
        if name == "Unknown" or name == "No CUDA": "" else: name

    me stable_device_capability() -> i64:
        if not self.is_valid():
            return 0
        cuda_device_compute_capability(self.device)

    me shutdown():
        # A failed synchronization cannot prove that the driver stopped using
        # the module/context. Retain the entire dependency graph in that state.
        if self.completion_unknown:
            return
        if self.module != 0 and not self.completion_unknown:
            val _module_unloaded = cuda_module_unload(self.module)
        self.module = 0
        if self.context != 0:
            val _context_destroyed = cuda_ctx_destroy(self.context)
        self.context = 0
        self.device = 0
        self.initialized = false
        self.completion_unknown = false

export CryptoCudaSession
