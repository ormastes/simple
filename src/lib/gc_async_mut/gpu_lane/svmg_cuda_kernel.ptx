//
// SVM-G stack-machine interpreter -- CUDA PTX kernel (Task B3).
//
// Implements the full 50-opcode SVM-G ISA (src/lib/common/svmg/opcodes.spl)
// as a fetch-decode-execute loop running on thread 0 of block 0 only (design
// doc doc/05_design/runtime/gpu_remote_interpreter_architecture.md S4.1,
// S4.3, S5.2), against a GMB-1 mailbox arena (mailbox_const.spl /
// gpu_mailbox.spl) uploaded by the host.
//
// Semantics mirror src/lib/common/svmg/ref_vm.spl (SvmgVm.step/run)
// instruction-for-instruction: same PC model (code array offset, not
// absolute arena offset), same i32-wraparound-on-stack representation, same
// trap values (TRAP_OOB=1, TRAP_DIV0=2), same sentinel values
// (0xCAFE0000|code on clean exit, 0xDEAD0000 exactly on budget exhaustion),
// same LOG/RECORD ring layout.
//
// Single kernel parameter: a 64-bit device pointer to the 128 KiB GMB-1
// arena (see src/lib/common/svmg/sgp.spl for the 36-byte SGP header at
// arena+0, mailbox_const.spl for the arena layout past DATA).
//
// Regenerate: scripts/build/regen_svmg_cuda_kernel.shs (hand-maintained; no
// .cu source -- this file IS the source, matching the existing checked-in
// x25519_mlkem768 CUDA PTX kernel pattern of hand-written PTX with no .cu
// counterpart: src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.ptx).
//
.version 7.0
.target sm_75
.address_size 64

.visible .entry svmg_interpret(
    .param .u64 arena_ptr
)
{
    .reg .pred %p<20>;
    .reg .b32  %r<200>;
    .reg .f32  %f<10>;
    .reg .b64  %rd<30>;

    // ------------------------------------------------------------------
    // Only thread 0 of block 0 executes; every other thread returns
    // immediately (design S4.1: SVM-G runs as a single logical thread).
    // ------------------------------------------------------------------
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    or.b32  %r3, %r1, %r2;
    setp.ne.u32 %p1, %r3, 0;
    @%p1 bra L_RETURN;

    ld.param.u64 %rd1, [arena_ptr];
    cvta.to.global.u64 %rd2, %rd1;         // %rd2 = arena base (global)

    // ------------------------------------------------------------------
    // Decode the 36-byte SGP header (sgp.spl): fields 2..7 (code_off,
    // code_len, data_off, data_len, step_budget, entry_pc). magic/version
    // (fields 0/1) are validated host-side before upload (sgp.decode_sgp_header)
    // and are not re-checked here -- matching ref_vm.run(), which is handed an
    // already-decoded header and never re-validates it either.
    // ------------------------------------------------------------------
    ld.global.u32 %r10, [%rd2+8];          // code_off
    ld.global.u32 %r11, [%rd2+12];         // code_len
    ld.global.u32 %r13, [%rd2+24];         // step_budget
    ld.global.u32 %r14, [%rd2+28];         // entry_pc

    mov.u32 %r20, %r14;                    // %r20 = pc (code-relative)
    mov.u32 %r21, %r13;                    // %r21 = steps_remaining
    mov.u32 %r22, 0;                       // %r22 = sp (operand stack ptr)
    mov.u32 %r23, 0;                       // %r23 = csp (call stack ptr)
    mov.u32 %r24, 0;                       // %r24 = seq (record/log seq ctr)
    mov.u32 %r25, 0;                       // %r25 = record_count

    ld.global.u32 %r26, [%rd2+0x10024];    // log_cap (LOG_CAP_OFFSET, host-initialized)
    ld.global.u32 %r27, [%rd2+0x10020];    // log_head (LOG_HEAD_OFFSET)
    add.u32 %r28, %r26, 0x10028;           // %r28 = record_ring base = LOG_DATA_OFFSET(0x10028) + log_cap

    .local .align 4 .b32 opstack[256];
    .local .align 4 .b32 callstack[32];
    mov.u64 %rd10, opstack;
    mov.u64 %rd11, callstack;

    // ------------------------------------------------------------------
    // DBG-1 launch-time restore (mailbox_const.spl DBG_* offsets; mirrors
    // ref_vm.SvmgVm.new's dbg block instruction-for-instruction).
    //
    // Register map added by DBG-1/PROF-1:
    //   %r110 = dbg_flags   %r111 = dbg_on      %r112 = single_step
    //   %r113 = first_instruction (1/0)         %r114 = resumed (1/0)
    //   %r115 = step_count (PROF-1, accumulates ACROSS resumes)
    //   %r116 = dbg_break_count
    //   %r117..%r120 scratch, %rd20..%rd22 scratch
    //
    // The DBG-1 block lives at 0x1F000..0x20000, i.e. ABOVE ARENA_DATA_SIZE
    // (0x10000). Every access below is an ABSOLUTE arena byte offset from
    // %rd2, exactly like the REG/LOG/RECORD accesses above -- SVM-G never
    // addresses the arena relative to data_off. Because 0x1F000 is past
    // ARENA_DATA_SIZE, the VM's own bounds_ok (OP_LOAD*/OP_STORE*) can never
    // reach this block, so a program cannot forge its own breakpoints.
    //
    // When DBG_FLAGS == 0 this is one global load + one predicated branch,
    // and nothing else is touched.
    // ------------------------------------------------------------------
    ld.global.u32 %r110, [%rd2+0x1F000];   // DBG_FLAGS_OFFSET
    and.b32 %r111, %r110, 1;               // DBG_FLAG_ENABLED
    mov.u32 %r112, 0;                      // single_step = false
    mov.u32 %r113, 1;                      // first_instruction = true
    mov.u32 %r114, 0;                      // resumed = false
    mov.u32 %r115, 0;                      // step_count = 0
    mov.u32 %r116, 0;                      // dbg_break_count = 0
    setp.eq.u32 %p4, %r111, 0;
    @%p4 bra L_DBG_INIT_DONE;

    and.b32 %r117, %r110, 4;               // DBG_FLAG_SINGLE_STEP
    setp.ne.u32 %p5, %r117, 0;
    selp.u32 %r112, 1, 0, %p5;
    ld.global.u32 %r116, [%rd2+0x1F004];   // DBG_BREAK_COUNT_OFFSET
    // ref_vm PANICS when break_count > DBG_MAX_BREAKPOINTS. A device kernel
    // has no panic channel, so surface it as a TRAP with a distinguishing
    // value (4) rather than silently truncating -- a dropped breakpoint is a
    // debugger that lies about where it stopped.
    setp.gt.u32 %p5, %r116, 16;
    @%p5 bra L_DBG_BAD_BREAK_COUNT;
    ld.global.u32 %r115, [%rd2+0x1F054];   // DBG_STEP_COUNT_OFFSET (accumulated)
    and.b32 %r117, %r110, 2;               // DBG_FLAG_RESUME
    setp.eq.u32 %p5, %r117, 0;
    @%p5 bra L_DBG_INIT_DONE;

    mov.u32 %r114, 1;                      // resumed = true
    ld.global.u32 %r24, [%rd2+0x1F4D8];    // DBG_SAVED_SEQ_OFFSET
    ld.global.u32 %r25, [%rd2+0x1F4DC];    // DBG_SAVED_RECORD_COUNT_OFFSET
    ld.global.u32 %r20, [%rd2+0x1F048];    // DBG_SAVED_PC_OFFSET
    ld.global.u32 %r22, [%rd2+0x1F04C];    // DBG_SAVED_SP_OFFSET
    ld.global.u32 %r23, [%rd2+0x1F050];    // DBG_SAVED_CSP_OFFSET
    // Operand stack: the saved words are the same i32 bit patterns this
    // kernel already keeps in local memory, so no sign conversion is needed
    // here (ref_vm converts only because its stack holds i64).
    mov.u32 %r118, 0;
L_DBG_RESTORE_STACK:
    setp.ge.u32 %p5, %r118, 256;
    @%p5 bra L_DBG_RESTORE_CALLS;
    mul.wide.u32 %rd20, %r118, 4;
    add.s64 %rd21, %rd2, %rd20;
    ld.global.u32 %r119, [%rd21+0x1F058];  // DBG_SAVED_STACK_OFFSET
    add.s64 %rd22, %rd10, %rd20;
    st.local.u32 [%rd22], %r119;
    add.u32 %r118, %r118, 1;
    bra L_DBG_RESTORE_STACK;
L_DBG_RESTORE_CALLS:
    mov.u32 %r118, 0;
L_DBG_RESTORE_CALLS_LOOP:
    setp.ge.u32 %p5, %r118, 32;
    @%p5 bra L_DBG_INIT_DONE;
    mul.wide.u32 %rd20, %r118, 4;
    add.s64 %rd21, %rd2, %rd20;
    ld.global.u32 %r119, [%rd21+0x1F458];  // DBG_SAVED_CALLS_OFFSET
    add.s64 %rd22, %rd11, %rd20;
    st.local.u32 [%rd22], %r119;
    add.u32 %r118, %r118, 1;
    bra L_DBG_RESTORE_CALLS_LOOP;
L_DBG_INIT_DONE:

// ==========================================================================
// Helpers realized inline per use (PTX has no reusable-callable macros
// without a real subroutine call, and SVM-G's own CALL/RET must not be
// confused with PTX-level calls) -- pop/push/read-operand-byte are expanded
// at each call site below. Each opcode block ends by branching to L_LOOP
// (fall-through instructions) or directly sets %r20 (pc) itself (jumps).
// ==========================================================================

L_LOOP:
    // steps_remaining <= 0 -> TIMEOUT sentinel (0xDEAD0000 exactly)
    setp.le.s32 %p2, %r21, 0;
    @%p2 bra L_TIMEOUT;
    // pc >= code_len -> clean exit(0), same as ref_vm falling off the code array
    setp.ge.u32 %p3, %r20, %r11;
    @%p3 bra L_EXIT0;

    // ---- DBG-1 breakpoint check, BEFORE executing (ref_vm.run) ----
    // Leaves pc ON the breakpoint so a resume re-executes that instruction
    // exactly once. The (first_instruction and resumed) suppression is what
    // makes that true: without it a resume would immediately re-break on the
    // same pc and the debugger could never make progress.
    // Inert path when DBG_FLAGS == 0: one setp + one predicated branch.
    setp.eq.u32 %p4, %r111, 0;
    @%p4 bra L_DBG_NO_BREAK;
    and.b32 %r117, %r113, %r114;           // first_instruction and resumed
    setp.ne.u32 %p4, %r117, 0;
    @%p4 bra L_DBG_NO_BREAK;
    mov.u32 %r118, 0;
L_DBG_BP_SCAN:
    setp.ge.u32 %p4, %r118, %r116;
    @%p4 bra L_DBG_NO_BREAK;
    mul.wide.u32 %rd20, %r118, 4;
    add.s64 %rd21, %rd2, %rd20;
    ld.global.u32 %r119, [%rd21+0x1F008];  // DBG_BREAK_PCS_OFFSET
    setp.eq.u32 %p4, %r119, %r20;
    @%p4 bra L_DEBUG_BREAK;
    add.u32 %r118, %r118, 1;
    bra L_DBG_BP_SCAN;
L_DBG_NO_BREAK:

    sub.u32 %r21, %r21, 1;                 // steps_remaining -= 1

    // fetch opcode byte at arena[code_off + pc]
    add.u32 %r30, %r10, %r20;              // %r30 = code_off + pc (arena byte offset)
    cvt.s64.s32 %rd12, %r30;
    add.s64 %rd13, %rd2, %rd12;
    ld.global.u8 %r31, [%rd13];            // %r31 = opcode

    // ---- dispatch chain (opcode byte values from opcodes.spl) ----
    setp.eq.u32 %p1, %r31, 0x00; @%p1 bra OP_NOP;
    setp.eq.u32 %p1, %r31, 0x01; @%p1 bra OP_HALT;
    setp.eq.u32 %p1, %r31, 0x02; @%p1 bra OP_TRAP;
    setp.eq.u32 %p1, %r31, 0x10; @%p1 bra OP_PUSHI;
    setp.eq.u32 %p1, %r31, 0x11; @%p1 bra OP_PUSHF;
    setp.eq.u32 %p1, %r31, 0x12; @%p1 bra OP_DUP;
    setp.eq.u32 %p1, %r31, 0x13; @%p1 bra OP_DROP;
    setp.eq.u32 %p1, %r31, 0x14; @%p1 bra OP_SWAP;
    setp.eq.u32 %p1, %r31, 0x20; @%p1 bra OP_ADD;
    setp.eq.u32 %p1, %r31, 0x21; @%p1 bra OP_SUB;
    setp.eq.u32 %p1, %r31, 0x22; @%p1 bra OP_MUL;
    setp.eq.u32 %p1, %r31, 0x23; @%p1 bra OP_DIV;
    setp.eq.u32 %p1, %r31, 0x24; @%p1 bra OP_REM;
    setp.eq.u32 %p1, %r31, 0x28; @%p1 bra OP_FADD;
    setp.eq.u32 %p1, %r31, 0x29; @%p1 bra OP_FSUB;
    setp.eq.u32 %p1, %r31, 0x2A; @%p1 bra OP_FMUL;
    setp.eq.u32 %p1, %r31, 0x2B; @%p1 bra OP_FDIV;
    setp.eq.u32 %p1, %r31, 0x30; @%p1 bra OP_AND;
    setp.eq.u32 %p1, %r31, 0x31; @%p1 bra OP_OR;
    setp.eq.u32 %p1, %r31, 0x32; @%p1 bra OP_XOR;
    setp.eq.u32 %p1, %r31, 0x33; @%p1 bra OP_SHL;
    setp.eq.u32 %p1, %r31, 0x34; @%p1 bra OP_SHR;
    setp.eq.u32 %p1, %r31, 0x35; @%p1 bra OP_SAR;
    setp.eq.u32 %p1, %r31, 0x38; @%p1 bra OP_EQ;
    setp.eq.u32 %p1, %r31, 0x39; @%p1 bra OP_NE;
    setp.eq.u32 %p1, %r31, 0x3A; @%p1 bra OP_LT;
    setp.eq.u32 %p1, %r31, 0x3B; @%p1 bra OP_LE;
    setp.eq.u32 %p1, %r31, 0x3C; @%p1 bra OP_GT;
    setp.eq.u32 %p1, %r31, 0x3D; @%p1 bra OP_GE;
    setp.eq.u32 %p1, %r31, 0x3E; @%p1 bra OP_FEQ;
    setp.eq.u32 %p1, %r31, 0x3F; @%p1 bra OP_FNE;
    setp.eq.u32 %p1, %r31, 0x40; @%p1 bra OP_FLT;
    setp.eq.u32 %p1, %r31, 0x41; @%p1 bra OP_FLE;
    setp.eq.u32 %p1, %r31, 0x42; @%p1 bra OP_FGT;
    setp.eq.u32 %p1, %r31, 0x43; @%p1 bra OP_FGE;
    setp.eq.u32 %p1, %r31, 0x50; @%p1 bra OP_LOAD32;
    setp.eq.u32 %p1, %r31, 0x51; @%p1 bra OP_STORE32;
    setp.eq.u32 %p1, %r31, 0x52; @%p1 bra OP_LOAD8;
    setp.eq.u32 %p1, %r31, 0x53; @%p1 bra OP_STORE8;
    setp.eq.u32 %p1, %r31, 0x60; @%p1 bra OP_JMP;
    setp.eq.u32 %p1, %r31, 0x61; @%p1 bra OP_JZ;
    setp.eq.u32 %p1, %r31, 0x62; @%p1 bra OP_JNZ;
    setp.eq.u32 %p1, %r31, 0x68; @%p1 bra OP_CALL;
    setp.eq.u32 %p1, %r31, 0x69; @%p1 bra OP_RET;
    setp.eq.u32 %p1, %r31, 0x70; @%p1 bra OP_SYS_PUTC;
    setp.eq.u32 %p1, %r31, 0x71; @%p1 bra OP_SYS_EXIT;
    setp.eq.u32 %p1, %r31, 0x72; @%p1 bra OP_SYS_RESULT;
    setp.eq.u32 %p1, %r31, 0x78; @%p1 bra OP_TID;
    setp.eq.u32 %p1, %r31, 0x79; @%p1 bra OP_NTID;
    setp.eq.u32 %p1, %r31, 0x7A; @%p1 bra OP_PARFOR;
    // Unknown opcode: fail-fast via TRAP-style exit rather than a silent
    // fallback (repo policy) -- reuse TRAP_OOB_EXIT_CODE(0x7F) with a
    // distinguishing trap value 0xBADBAD (not one of ref_vm's own trap
    // codes 1/2, so a host comparing against ref_vm on a *valid* program
    // never legitimately observes it; only a corrupt/foreign SGP blob would).
    mov.u32 %r40, 0xBADBAD;
    bra L_TRAP;

// --------------------------------------------------------------------
// NOP / control
// --------------------------------------------------------------------
OP_NOP:
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_HALT:
    // operand: 1 byte code at pc+1
    add.u32 %r41, %r30, 1;
    cvt.s64.s32 %rd12, %r41; add.s64 %rd13, %rd2, %rd12;
    ld.global.u8 %r40, [%rd13];
    bra L_EXIT_CODE;

OP_TRAP:
    add.u32 %r41, %r30, 1;
    cvt.s64.s32 %rd12, %r41; add.s64 %rd13, %rd2, %rd12;
    ld.global.u8 %r40, [%rd13];
    bra L_TRAP;

// --------------------------------------------------------------------
// Stack ops
// --------------------------------------------------------------------
OP_PUSHI:
OP_PUSHF:
    // operand: 4-byte little-endian imm32 at pc+1 (byte-wise: code may be
    // unaligned, so read 4 individual bytes and combine, exactly like
    // ref_vm._u32_le_at).
    add.u32 %r41, %r30, 1;
    cvt.s64.s32 %rd12, %r41; add.s64 %rd14, %rd2, %rd12;
    ld.global.u8 %r50, [%rd14+0];
    ld.global.u8 %r51, [%rd14+1];
    ld.global.u8 %r52, [%rd14+2];
    ld.global.u8 %r53, [%rd14+3];
    shl.b32 %r51, %r51, 8;
    shl.b32 %r52, %r52, 16;
    shl.b32 %r53, %r53, 24;
    or.b32 %r50, %r50, %r51;
    or.b32 %r50, %r50, %r52;
    or.b32 %r50, %r50, %r53;
    // push %r50
    mul.wide.u32 %rd15, %r22, 4;
    add.s64 %rd15, %rd10, %rd15;
    st.local.u32 [%rd15], %r50;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 5;                 // pc_next = pc + 1 + 4
    bra L_STEP_DONE;

OP_DUP:
    sub.u32 %r60, %r22, 1;
    mul.wide.u32 %rd15, %r60, 4; add.s64 %rd15, %rd10, %rd15;
    ld.local.u32 %r61, [%rd15];
    mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15;
    st.local.u32 [%rd15], %r61;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_DROP:
    sub.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_SWAP:
    sub.u32 %r60, %r22, 1;
    sub.u32 %r61, %r22, 2;
    mul.wide.u32 %rd15, %r60, 4; add.s64 %rd15, %rd10, %rd15;
    ld.local.u32 %r62, [%rd15];            // y
    mul.wide.u32 %rd16, %r61, 4; add.s64 %rd16, %rd10, %rd16;
    ld.local.u32 %r63, [%rd16];            // x
    st.local.u32 [%rd15], %r63;
    st.local.u32 [%rd16], %r62;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

// --------------------------------------------------------------------
// Integer arithmetic (pop b, pop a, push a OP b)
// --------------------------------------------------------------------
OP_ADD:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r71, [%rd15];
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r70, [%rd16];
    add.s32 %r72, %r70, %r71;
    st.local.u32 [%rd16], %r72;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_SUB:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r71, [%rd15];
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r70, [%rd16];
    sub.s32 %r72, %r70, %r71;
    st.local.u32 [%rd16], %r72;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_MUL:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r71, [%rd15];
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r70, [%rd16];
    mul.lo.s32 %r72, %r70, %r71;
    st.local.u32 [%rd16], %r72;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_DIV:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r71, [%rd15];
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r70, [%rd16];
    setp.eq.s32 %p4, %r71, 0;
    @%p4 bra L_TRAP_DIV0;
    div.s32 %r72, %r70, %r71;
    st.local.u32 [%rd16], %r72;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_REM:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r71, [%rd15];
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r70, [%rd16];
    setp.eq.s32 %p4, %r71, 0;
    @%p4 bra L_TRAP_DIV0;
    rem.s32 %r72, %r70, %r71;
    st.local.u32 [%rd16], %r72;
    add.u32 %r22, %r22, 1;
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

// --------------------------------------------------------------------
// Float arithmetic -- stack values are raw f32 bit patterns in .b32 slots;
// `mov.b32` between .b32 and .f32 registers is a bit-preserving
// reinterpret cast (matches ref_vm.pop_f32/push_f32's f32_from_bits /
// f32_to_bits -- never a numeric int->float convert).
// --------------------------------------------------------------------
OP_FADD:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r71, [%rd15];
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r70, [%rd16];
    mov.b32 %f1, %r70; mov.b32 %f2, %r71;
    add.f32 %f3, %f1, %f2;
    mov.b32 %r72, %f3;
