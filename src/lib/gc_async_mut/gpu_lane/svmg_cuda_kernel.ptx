    shl.b32 %r91, %r91, 8;
    or.b32 %r90, %r90, %r91;               // %r90 = target (u16, unsigned)
    add.u32 %r93, %r20, 3;                 // pc_next (return address)
    mul.wide.u32 %rd18, %r23, 4; add.s64 %rd18, %rd11, %rd18;
    st.local.u32 [%rd18], %r93;
    add.u32 %r23, %r23, 1;
    mov.u32 %r20, %r90;
    bra L_STEP_DONE;

OP_RET:
    setp.eq.u32 %p10, %r23, 0;
    @%p10 bra L_EXIT0;                     // RET at top level -> exit_clean(0)
    sub.u32 %r23, %r23, 1;
    mul.wide.u32 %rd18, %r23, 4; add.s64 %rd18, %rd11, %rd18;
    ld.local.u32 %r20, [%rd18];
    bra L_STEP_DONE;

// --------------------------------------------------------------------
// SYS_* / thread-id
// --------------------------------------------------------------------
OP_SYS_PUTC:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r96, [%rd15]; // ch
    bra L_APPEND_LOG_AND_CONTINUE;

OP_SYS_EXIT:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r40, [%rd15]; // code
    bra L_EXIT_CODE;

OP_SYS_RESULT:
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15; ld.local.u32 %r97, [%rd15]; // value
    sub.u32 %r22, %r22, 1; mul.wide.u32 %rd16, %r22, 4; add.s64 %rd16, %rd10, %rd16; ld.local.u32 %r98, [%rd16]; // pass
    // write_record(pass, value): 12-byte record at record_base + record_count*12
    mul.lo.u32 %r99, %r25, 12;
    add.u32 %r99, %r99, %r28;
    cvt.s64.s32 %rd19, %r99; add.s64 %rd19, %rd2, %rd19;
    st.global.u32 [%rd19+0], %r24;         // seq
    st.global.u32 [%rd19+4], %r98;         // pass
    st.global.u32 [%rd19+8], %r97;         // value
    add.u32 %r25, %r25, 1;                 // record_count += 1
    add.u32 %r24, %r24, 1;                 // seq += 1
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

OP_TID:
    mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15;
    mov.u32 %r100, 0;
    st.local.u32 [%rd15], %r100;
    add.u32 %r22, %r22, 1; add.u32 %r20, %r20, 1; bra L_STEP_DONE;

OP_NTID:
    mul.wide.u32 %rd15, %r22, 4; add.s64 %rd15, %rd10, %rd15;
    mov.u32 %r100, 1;
    st.local.u32 [%rd15], %r100;
    add.u32 %r22, %r22, 1; add.u32 %r20, %r20, 1; bra L_STEP_DONE;

OP_PARFOR:
    // Single-thread host: PARFOR degenerates to a fall-through (design
    // S4.1 / ref_vm's PARFOR comment) -- the fanned region executes once,
    // in place, as thread 0. Operand (2-byte len) is consumed but unused,
    // exactly like ref_vm.
    add.u32 %r20, %r20, 3;
    bra L_STEP_DONE;

// ==========================================================================
// Shared tail helpers
// ==========================================================================

L_APPEND_LOG_AND_CONTINUE:
    // append_log_byte: LOG ring slot = log_head % log_cap
    rem.u32 %r101, %r27, %r26;
    add.u32 %r101, %r101, 0x10028;         // LOG_DATA_OFFSET + slot
    cvt.s64.s32 %rd19, %r101; add.s64 %rd19, %rd2, %rd19;
    st.global.u8 [%rd19], %r96;
    add.u32 %r27, %r27, 1;                 // log_head += 1
    st.global.u32 [%rd2+0x10020], %r27;    // persist LOG_HEAD_OFFSET
    add.u32 %r24, %r24, 1;                 // seq += 1 (ref_vm.append_log_byte)
    add.u32 %r20, %r20, 1;
    bra L_STEP_DONE;

L_TRAP_OOB:
    mov.u32 %r40, 1;                       // TRAP_OOB
    bra L_TRAP;

L_TRAP_DIV0:
    mov.u32 %r40, 2;                       // TRAP_DIV0
    bra L_TRAP;

L_CALLSTACK_OVERFLOW:
    // ref_vm.step's OP_CALL panics on call-stack overflow (a host/assembler
    // bug, not a program-level trap) -- there is no GMB-1 wire encoding for
    // "panic" on real hardware, so this maps to the same TRAP_OOB path used
    // for out-of-bounds memory, distinguished by trap value 3 (not used by
    // ref_vm) so a host comparing traces sees a distinct, documented code
    // rather than a silent misattribution to a bounds trap.
    mov.u32 %r40, 3;
    bra L_TRAP;

// ==========================================================================
// DBG-1 / PROF-1 tail
// ==========================================================================

L_STEP_DONE:
    // Post-step hook every FALL-THROUGH opcode returns through (ref_vm.run's
    // "step_count += 1; if single_step and not halted: halt_debug_break").
    // Halting opcodes (HALT / TRAP / SYS_EXIT) do NOT come through here --
    // they branch straight to L_EXIT_CODE / L_TRAP, which do their own
    // step_count += 1. That split is exactly ref_vm's "not self.halted"
    // guard: an instruction that ENDED the program is not a single-step
    // stop, and reporting it as one would make resume-to-completion loop
    // forever.
    // Inert path when DBG_FLAGS == 0: one setp + one predicated branch.
    setp.eq.u32 %p4, %r111, 0;
    @%p4 bra L_STEP_DONE_NODBG;
    add.u32 %r115, %r115, 1;               // PROF-1 step_count += 1
    setp.ne.u32 %p4, %r112, 0;
    @%p4 bra L_DEBUG_BREAK;                // single-step stop
L_STEP_DONE_NODBG:
    mov.u32 %r113, 0;                      // first_instruction = false
    bra L_LOOP;

L_DEBUG_BREAK:
    // Stopped for a DEBUG reason. NOTE: SENTINEL_DEBUG_BREAK (0xCAFE00DB)
    // deliberately aliases a clean exit with code 0xDB, so exit code 0xDB is
    // RESERVED and host code must use VmRunResult.debug_break -- never an
    // exit-code comparison -- to tell a breakpoint from a program exit.
    mov.u32 %r120, 0xCAFE00DB;
    st.global.u32 [%rd2+0x8000], %r120;
    bra L_DBG_SAVE_AND_RETURN;

L_DBG_BAD_BREAK_COUNT:
    mov.u32 %r40, 4;
    bra L_TRAP;

L_TRAP:
    // write_record(0, trap_value) then EXIT sentinel with TRAP_OOB_EXIT_CODE(0x7F)
    mul.lo.u32 %r99, %r25, 12;
    add.u32 %r99, %r99, %r28;
    cvt.s64.s32 %rd19, %r99; add.s64 %rd19, %rd2, %rd19;
    st.global.u32 [%rd19+0], %r24;
    mov.u32 %r102, 0;
    st.global.u32 [%rd19+4], %r102;
    st.global.u32 [%rd19+8], %r40;
    // ref_vm.write_record bumps BOTH counters; the pre-DBG-1 kernel skipped
    // them because they die with the launch. Under DBG-1 they are PERSISTED,
    // so they must now be exact or a resume would rewind the record ring.
    add.u32 %r25, %r25, 1;                 // record_count += 1
    add.u32 %r24, %r24, 1;                 // seq += 1
    mov.u32 %r103, 0xCAFE007F;             // SENTINEL_EXIT_MASK | 0x7F
    st.global.u32 [%rd2+0x8000], %r103;
    // A trapping instruction still RETIRED (ref_vm bumps step_count after
    // step() regardless of whether step() halted).
    setp.eq.u32 %p4, %r111, 0;
    @%p4 bra L_DBG_SAVE_AND_RETURN;
    add.u32 %r115, %r115, 1;
    bra L_DBG_SAVE_AND_RETURN;

L_EXIT_CODE:
    // exit_clean(code): sentinel = 0xCAFE0000 | (code & 0xFFFF)
    and.b32 %r40, %r40, 0xFFFF;
    or.b32 %r104, %r40, 0xCAFE0000;
    st.global.u32 [%rd2+0x8000], %r104;
    add.u32 %r24, %r24, 1;                 // ref_vm.exit_clean: seq += 1
    setp.eq.u32 %p4, %r111, 0;
    @%p4 bra L_DBG_SAVE_AND_RETURN;
    add.u32 %r115, %r115, 1;               // HALT / SYS_EXIT retired
    bra L_DBG_SAVE_AND_RETURN;

L_EXIT0:
    // pc ran off the end of the code array: NO instruction retired, so
    // step_count is deliberately not bumped here.
    mov.u32 %r105, 0xCAFE0000;
    st.global.u32 [%rd2+0x8000], %r105;
    add.u32 %r24, %r24, 1;                 // ref_vm.exit_clean: seq += 1
    bra L_DBG_SAVE_AND_RETURN;

L_TIMEOUT:
    mov.u32 %r106, 0xDEAD0000;
    st.global.u32 [%rd2+0x8000], %r106;
    bra L_DBG_SAVE_AND_RETURN;

L_DBG_SAVE_AND_RETURN:
    // ref_vm.save_debug_state: on EVERY halt with bit0 set, park the full
    // execution state so "why did it stop" is inspectable and the next
    // launch can resume. Entirely skipped when DBG_FLAGS == 0.
    setp.eq.u32 %p4, %r111, 0;
    @%p4 bra L_RETURN;
    st.global.u32 [%rd2+0x1F048], %r20;    // DBG_SAVED_PC_OFFSET
    st.global.u32 [%rd2+0x1F04C], %r22;    // DBG_SAVED_SP_OFFSET
    st.global.u32 [%rd2+0x1F050], %r23;    // DBG_SAVED_CSP_OFFSET
    st.global.u32 [%rd2+0x1F054], %r115;   // DBG_STEP_COUNT_OFFSET
    st.global.u32 [%rd2+0x1F4D8], %r24;    // DBG_SAVED_SEQ_OFFSET
    st.global.u32 [%rd2+0x1F4DC], %r25;    // DBG_SAVED_RECORD_COUNT_OFFSET
    mov.u32 %r118, 0;
L_DBG_SAVE_STACK:
    setp.ge.u32 %p4, %r118, 256;
    @%p4 bra L_DBG_SAVE_CALLS;
    mul.wide.u32 %rd20, %r118, 4;
    add.s64 %rd22, %rd10, %rd20;
    ld.local.u32 %r119, [%rd22];
    add.s64 %rd21, %rd2, %rd20;
    st.global.u32 [%rd21+0x1F058], %r119;  // DBG_SAVED_STACK_OFFSET
    add.u32 %r118, %r118, 1;
    bra L_DBG_SAVE_STACK;
L_DBG_SAVE_CALLS:
    mov.u32 %r118, 0;
L_DBG_SAVE_CALLS_LOOP:
    setp.ge.u32 %p4, %r118, 32;
    @%p4 bra L_RETURN;
    mul.wide.u32 %rd20, %r118, 4;
    add.s64 %rd22, %rd11, %rd20;
    ld.local.u32 %r119, [%rd22];
    add.s64 %rd21, %rd2, %rd20;
    st.global.u32 [%rd21+0x1F458], %r119;  // DBG_SAVED_CALLS_OFFSET
    add.u32 %r118, %r118, 1;
    bra L_DBG_SAVE_CALLS_LOOP;

L_RETURN:
    ret;
}
