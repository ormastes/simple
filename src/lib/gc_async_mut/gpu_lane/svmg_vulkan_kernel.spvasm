; SVM-G stack-machine interpreter -- Vulkan SPIR-V compute shader (Task C3).
;
; Implements the 50-opcode SVM-G ISA (src/lib/common/svmg/opcodes.spl) as a
; fetch-decode-execute loop, single invocation (dispatch 1x1x1, local size
; 1x1x1) -- design doc doc/05_design/runtime/gpu_remote_interpreter_architecture.md
; S4.1/S4.3/S6.3, mirroring the CUDA PTX sibling
; (src/lib/gc_async_mut/gpu_lane/svmg_cuda_kernel.ptx) instruction-for-
; instruction and both matching the host reference VM
; (src/lib/common/svmg/ref_vm.spl, SvmgVm.step/run): same PC model (code-
; array-relative, fetched at arena[code_off+pc]), same i32-wraparound-on-
; stack representation (32-bit words carry raw bit patterns; ordinary 32-bit
; OpIAdd/OpISub/OpIMul already wrap the same way _wrap_i32 does), same trap
; values (TRAP_OOB=1, TRAP_DIV0=2; call-stack overflow reuses 3, matching
; the CUDA sibling's L_CALLSTACK_OVERFLOW convention -- ref_vm.step panics
; there instead, since it is a host/assembler bug, not a device-representable
; trap), same sentinel values (0xCAFE0000|code clean exit, 0xDEAD0000 exactly
; on budget exhaustion), same LOG/RECORD ring layout (mailbox_const.spl).
;
; No .glsl/.comp source: there is no glslangValidator/glslc/dxc on this repo's
; build hosts (verified), and the byte-addressable arena buffer this
; interpreter needs (arbitrary unaligned 1/2/4-byte reads/writes into a
; uint32-word SSBO) has no natural GLSL expression anyway -- so this checked-
; in SPIR-V assembly text IS the source, exactly the same precedent as the
; checked-in CUDA PTX kernel (hand-written .ptx, no .cu) and the existing
; x25519_mlkem768 CUDA kernel (ml_kem_ntt_forward.ptx). Byte-level access is
; implemented directly against the uint32 SSBO via shift/mask (read-modify-
; write for stores), since there is no 8-bit-storage capability assumed here.
;
; Single SSBO binding: set 0, binding 0 -- the 128 KiB GMB-1 arena
; (src/lib/common/svmg/sgp.spl for the 36-byte SGP header at arena+0,
; mailbox_const.spl for the arena layout past DATA), matching
; VulkanLaneSession's single-arena-buffer dispatch contract exactly like the
; CUDA lane's single arena_ptr kernel parameter.
;
; Regenerate: scripts/build/regen_svmg_vulkan_kernel.shs (spirv-as + spirv-val).

               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main"
               OpExecutionMode %main LocalSize 1 1 1

; ============================================================================
; Decorations
; ============================================================================
               OpDecorate %rtarr ArrayStride 4
               OpMemberDecorate %arena_struct 0 Offset 0
               OpDecorate %arena_struct BufferBlock
               OpDecorate %arena DescriptorSet 0
               OpDecorate %arena Binding 0

; ============================================================================
; Types
; ============================================================================
       %void = OpTypeVoid
   %void_fn_t = OpTypeFunction %void
       %uint = OpTypeInt 32 0
      %float = OpTypeFloat 32
       %bool = OpTypeBool

  %uint_fn_from_uint_t = OpTypeFunction %uint %uint
  %void_fn_from_uint_uint_t = OpTypeFunction %void %uint %uint
  %void_fn_from_uint_t = OpTypeFunction %void %uint
  %uint_fn_void_t = OpTypeFunction %uint

; SSBO: arena as a runtime array of uint32 words (byte-addressed manually).
      %rtarr = OpTypeRuntimeArray %uint
%arena_struct = OpTypeStruct %rtarr
%arena_struct_ptr = OpTypePointer Uniform %arena_struct
      %arena = OpVariable %arena_struct_ptr Uniform
%arena_word_ptr = OpTypePointer Uniform %uint

; Function-local "register" globals (Private storage class -- single
; invocation only, never touched by another thread, so no shared-memory
; hazard from module-scope mutable state here).
%uint_ptr_priv = OpTypePointer Private %uint
      %g_pc = OpVariable %uint_ptr_priv Private
      %g_sp = OpVariable %uint_ptr_priv Private
     %g_csp = OpVariable %uint_ptr_priv Private
   %g_steps = OpVariable %uint_ptr_priv Private
     %g_seq = OpVariable %uint_ptr_priv Private
%g_reccount = OpVariable %uint_ptr_priv Private
 %g_codeoff = OpVariable %uint_ptr_priv Private
 %g_codelen = OpVariable %uint_ptr_priv Private
  %g_logcap = OpVariable %uint_ptr_priv Private
 %g_recbase = OpVariable %uint_ptr_priv Private
; DBG-1 / PROF-1 state (mirrors ref_vm.SvmgVm's dbg_* fields and run()'s
; hoisted dbg_on / single_step / first_instruction locals). All of these are
; 0 and never re-read when DBG_FLAGS == 0.
     %g_dbgon = OpVariable %uint_ptr_priv Private
%g_singlestep = OpVariable %uint_ptr_priv Private
  %g_firstinsn = OpVariable %uint_ptr_priv Private
    %g_resumed = OpVariable %uint_ptr_priv Private
  %g_stepcount = OpVariable %uint_ptr_priv Private
 %g_breakcount = OpVariable %uint_ptr_priv Private
       %g_dbgi = OpVariable %uint_ptr_priv Private
     %g_dbgres = OpVariable %uint_ptr_priv Private

%uint_256 = OpConstant %uint 256
%uint_32c = OpConstant %uint 32
%arr256_t = OpTypeArray %uint %uint_256
%arr32_t  = OpTypeArray %uint %uint_32c
%arr256_ptr_priv = OpTypePointer Private %arr256_t
%arr32_ptr_priv  = OpTypePointer Private %arr32_t
%g_opstack = OpVariable %arr256_ptr_priv Private
%g_callstack = OpVariable %arr32_ptr_priv Private

; ============================================================================
; Constants
; ============================================================================
        %c_0 = OpConstant %uint 0
        %c_1 = OpConstant %uint 1
        %c_2 = OpConstant %uint 2
        %c_3 = OpConstant %uint 3
        %c_4 = OpConstant %uint 4
        %c_8 = OpConstant %uint 8
       %c_12 = OpConstant %uint 12
       %c_16 = OpConstant %uint 16
       %c_24 = OpConstant %uint 24
       %c_31 = OpConstant %uint 31
       %c_32 = OpConstant %uint 32
     %c_0xFF = OpConstant %uint 255
   %c_0xFFFF = OpConstant %uint 65535
%c_sentinel_widx = OpConstant %uint 8192
%c_CAFE0000 = OpConstant %uint 3405643776
%c_DEAD0000 = OpConstant %uint 3735879680
     %c_0x7F = OpConstant %uint 127
%c_TRAP_OOB  = OpConstant %uint 1
%c_TRAP_DIV0 = OpConstant %uint 2
%c_TRAP_CALLOF = OpConstant %uint 3
%c_BADBAD    = OpConstant %uint 12245933
%c_LOG_HEAD_OFFSET = OpConstant %uint 65568
%c_LOG_CAP_OFFSET  = OpConstant %uint 65572
%c_LOG_DATA_OFFSET = OpConstant %uint 65576
%c_NEG_SIGN_BIT = OpConstant %uint 2147483648
%c_SIGN_EXT_ADD = OpConstant %uint 4294901760
%c_ARENA_DATA_SIZE = OpConstant %uint 65536
      %c_28 = OpConstant %uint 28
   %c_32768 = OpConstant %uint 32768

; ---- DBG-1 block (mailbox_const.spl). These are ABSOLUTE arena byte
; offsets -- SVM-G addresses the arena by absolute offset ONLY, never
; relative to the SGP data_off, and the u32-word index used by the read_u32 /
; write_u32 helpers below is therefore derived purely as (offset >> 2). The
; block sits at 0x1F000, ABOVE ARENA_DATA_SIZE (0x10000), so the VM's own
; OP_LOAD*/OP_STORE* bounds check can never reach it and a guest program
; cannot forge its own breakpoints.
%c_DBG_FLAGS       = OpConstant %uint 126976     ; 0x1F000
%c_DBG_BREAK_COUNT = OpConstant %uint 126980     ; 0x1F004
%c_DBG_BREAK_PCS   = OpConstant %uint 126984     ; 0x1F008  u32[16]
%c_DBG_SAVED_PC    = OpConstant %uint 127048     ; 0x1F048
%c_DBG_SAVED_SP    = OpConstant %uint 127052     ; 0x1F04C
%c_DBG_SAVED_CSP   = OpConstant %uint 127056     ; 0x1F050
%c_DBG_STEP_COUNT  = OpConstant %uint 127060     ; 0x1F054
%c_DBG_SAVED_STACK = OpConstant %uint 127064     ; 0x1F058  u32[256]
%c_DBG_SAVED_CALLS = OpConstant %uint 128088     ; 0x1F458  u32[32]
%c_DBG_SAVED_SEQ   = OpConstant %uint 128216     ; 0x1F4D8
%c_DBG_SAVED_RECCOUNT = OpConstant %uint 128220  ; 0x1F4DC
; SENTINEL_DEBUG_BREAK. NOTE: 0xCAFE00DB deliberately aliases a clean exit
; with code 0xDB, so exit code 0xDB is RESERVED -- host code must use
; VmRunResult.debug_break, never an exit-code comparison, to tell a
; breakpoint stop from a program exit.
%c_SENT_DBGBRK = OpConstant %uint 3405643995     ; 0xCAFE00DB

; ============================================================================
; read_u8(off) -> uint : arena[off], byte-addressed against the uint32 SSBO.
; ============================================================================
   %read_u8 = OpFunction %uint None %uint_fn_from_uint_t
   %ru8_off = OpFunctionParameter %uint
 %ru8_entry = OpLabel
  %ru8_widx = OpShiftRightLogical %uint %ru8_off %c_2
%ru8_shiftb = OpBitwiseAnd %uint %ru8_off %c_3
 %ru8_shift = OpShiftLeftLogical %uint %ru8_shiftb %c_3
   %ru8_ptr = OpAccessChain %arena_word_ptr %arena %c_0 %ru8_widx
  %ru8_word = OpLoad %uint %ru8_ptr Volatile
%ru8_shifted = OpShiftRightLogical %uint %ru8_word %ru8_shift
  %ru8_byte = OpBitwiseAnd %uint %ru8_shifted %c_0xFF
               OpReturnValue %ru8_byte
               OpFunctionEnd

; ============================================================================
; write_u8(off, val) -> void : read-modify-write the containing word.
; ============================================================================
  %write_u8 = OpFunction %void None %void_fn_from_uint_uint_t
   %wu8_off = OpFunctionParameter %uint
   %wu8_val = OpFunctionParameter %uint
 %wu8_entry = OpLabel
  %wu8_widx = OpShiftRightLogical %uint %wu8_off %c_2
%wu8_shiftb = OpBitwiseAnd %uint %wu8_off %c_3
 %wu8_shift = OpShiftLeftLogical %uint %wu8_shiftb %c_3
   %wu8_ptr = OpAccessChain %arena_word_ptr %arena %c_0 %wu8_widx
  %wu8_word = OpLoad %uint %wu8_ptr Volatile
 %wu8_mask8 = OpShiftLeftLogical %uint %c_0xFF %wu8_shift
%wu8_invmask = OpNot %uint %wu8_mask8
%wu8_cleared = OpBitwiseAnd %uint %wu8_word %wu8_invmask
%wu8_valmasked = OpBitwiseAnd %uint %wu8_val %c_0xFF
%wu8_valshift = OpShiftLeftLogical %uint %wu8_valmasked %wu8_shift
   %wu8_new = OpBitwiseOr %uint %wu8_cleared %wu8_valshift
               OpStore %wu8_ptr %wu8_new Volatile
               OpReturn
               OpFunctionEnd

; ============================================================================
; read_u32(off) -> uint : little-endian 4-byte combine, fully inlined (no
; nested OpFunctionCall to read_u8) -- see the fix note above write_u8.
; ============================================================================
  %read_u32 = OpFunction %uint None %uint_fn_from_uint_t
   %r32_off = OpFunctionParameter %uint
 %r32_entry = OpLabel
%r32_widx0 = OpShiftRightLogical %uint %r32_off %c_2
%r32_shb0 = OpBitwiseAnd %uint %r32_off %c_3
%r32_sh0 = OpShiftLeftLogical %uint %r32_shb0 %c_3
%r32_ptr0 = OpAccessChain %arena_word_ptr %arena %c_0 %r32_widx0
%r32_word0 = OpLoad %uint %r32_ptr0 Volatile
%r32_shd0 = OpShiftRightLogical %uint %r32_word0 %r32_sh0
    %r32_b0 = OpBitwiseAnd %uint %r32_shd0 %c_0xFF
    %r32_o1 = OpIAdd %uint %r32_off %c_1
%r32_widx1 = OpShiftRightLogical %uint %r32_o1 %c_2
%r32_shb1 = OpBitwiseAnd %uint %r32_o1 %c_3
%r32_sh1 = OpShiftLeftLogical %uint %r32_shb1 %c_3
%r32_ptr1 = OpAccessChain %arena_word_ptr %arena %c_0 %r32_widx1
%r32_word1 = OpLoad %uint %r32_ptr1 Volatile
%r32_shd1 = OpShiftRightLogical %uint %r32_word1 %r32_sh1
    %r32_b1 = OpBitwiseAnd %uint %r32_shd1 %c_0xFF
    %r32_o2 = OpIAdd %uint %r32_off %c_2
%r32_widx2 = OpShiftRightLogical %uint %r32_o2 %c_2
%r32_shb2 = OpBitwiseAnd %uint %r32_o2 %c_3
%r32_sh2 = OpShiftLeftLogical %uint %r32_shb2 %c_3
%r32_ptr2 = OpAccessChain %arena_word_ptr %arena %c_0 %r32_widx2
%r32_word2 = OpLoad %uint %r32_ptr2 Volatile
%r32_shd2 = OpShiftRightLogical %uint %r32_word2 %r32_sh2
    %r32_b2 = OpBitwiseAnd %uint %r32_shd2 %c_0xFF
    %r32_o3 = OpIAdd %uint %r32_off %c_3
%r32_widx3 = OpShiftRightLogical %uint %r32_o3 %c_2
%r32_shb3 = OpBitwiseAnd %uint %r32_o3 %c_3
%r32_sh3 = OpShiftLeftLogical %uint %r32_shb3 %c_3
%r32_ptr3 = OpAccessChain %arena_word_ptr %arena %c_0 %r32_widx3
%r32_word3 = OpLoad %uint %r32_ptr3 Volatile
%r32_shd3 = OpShiftRightLogical %uint %r32_word3 %r32_sh3
    %r32_b3 = OpBitwiseAnd %uint %r32_shd3 %c_0xFF
    %r32_s1 = OpShiftLeftLogical %uint %r32_b1 %c_8
    %r32_s2 = OpShiftLeftLogical %uint %r32_b2 %c_16
    %r32_s3 = OpShiftLeftLogical %uint %r32_b3 %c_24
    %r32_t1 = OpBitwiseOr %uint %r32_b0 %r32_s1
    %r32_t2 = OpBitwiseOr %uint %r32_t1 %r32_s2
 %r32_result = OpBitwiseOr %uint %r32_t2 %r32_s3
               OpReturnValue %r32_result
               OpFunctionEnd

; ============================================================================
; read_u16(off) -> uint : little-endian 2-byte combine (unsigned), fully
; inlined (no nested OpFunctionCall to read_u8).
; ============================================================================
  %read_u16 = OpFunction %uint None %uint_fn_from_uint_t
   %r16_off = OpFunctionParameter %uint
 %r16_entry = OpLabel
%r16_widx0 = OpShiftRightLogical %uint %r16_off %c_2
%r16_shb0 = OpBitwiseAnd %uint %r16_off %c_3
%r16_sh0 = OpShiftLeftLogical %uint %r16_shb0 %c_3
%r16_ptr0 = OpAccessChain %arena_word_ptr %arena %c_0 %r16_widx0
%r16_word0 = OpLoad %uint %r16_ptr0 Volatile
%r16_shd0 = OpShiftRightLogical %uint %r16_word0 %r16_sh0
    %r16_b0 = OpBitwiseAnd %uint %r16_shd0 %c_0xFF
    %r16_o1 = OpIAdd %uint %r16_off %c_1
%r16_widx1 = OpShiftRightLogical %uint %r16_o1 %c_2
%r16_shb1 = OpBitwiseAnd %uint %r16_o1 %c_3
%r16_sh1 = OpShiftLeftLogical %uint %r16_shb1 %c_3
%r16_ptr1 = OpAccessChain %arena_word_ptr %arena %c_0 %r16_widx1
%r16_word1 = OpLoad %uint %r16_ptr1 Volatile
%r16_shd1 = OpShiftRightLogical %uint %r16_word1 %r16_sh1
    %r16_b1 = OpBitwiseAnd %uint %r16_shd1 %c_0xFF
    %r16_s1 = OpShiftLeftLogical %uint %r16_b1 %c_8
%r16_result = OpBitwiseOr %uint %r16_b0 %r16_s1
               OpReturnValue %r16_result
               OpFunctionEnd

; ============================================================================
; write_u32(off, val) -> void : little-endian 4-byte split, fully inlined
; (no nested OpFunctionCall to write_u8) -- an earlier version routed
; through 4 write_u8 calls and was observed, empirically, on a live NVIDIA
; Vulkan driver, to occasionally cross-contaminate one byte lane of the
; written word with a stale value from an unrelated PRIOR write_u8 call
; elsewhere in the same dispatch (reproduced against the D3
; mem_store_load_byte conformance vector: the record's `pass` word came
; back with byte 2 holding STORE8's operand value instead of 0). Marking
; the loads/stores Volatile did not change the outcome, so this was
; resolved by removing the nested-call boundary entirely rather than
; continuing to chase a suspected driver/codegen interaction -- each byte's
; read-modify-write is now fully self-contained in this function body.
; ============================================================================
 %write_u32 = OpFunction %void None %void_fn_from_uint_uint_t
   %w32_off = OpFunctionParameter %uint
   %w32_val = OpFunctionParameter %uint
 %w32_entry = OpLabel
    %w32_b0 = OpBitwiseAnd %uint %w32_val %c_0xFF
    %w32_s1v = OpShiftRightLogical %uint %w32_val %c_8
    %w32_b1 = OpBitwiseAnd %uint %w32_s1v %c_0xFF
    %w32_s2v = OpShiftRightLogical %uint %w32_val %c_16
    %w32_b2 = OpBitwiseAnd %uint %w32_s2v %c_0xFF
    %w32_s3v = OpShiftRightLogical %uint %w32_val %c_24
    %w32_b3 = OpBitwiseAnd %uint %w32_s3v %c_0xFF
%w32_widx0 = OpShiftRightLogical %uint %w32_off %c_2
%w32_shb0 = OpBitwiseAnd %uint %w32_off %c_3
%w32_sh0 = OpShiftLeftLogical %uint %w32_shb0 %c_3
%w32_ptr0 = OpAccessChain %arena_word_ptr %arena %c_0 %w32_widx0
%w32_word0 = OpLoad %uint %w32_ptr0 Volatile
%w32_mask0 = OpShiftLeftLogical %uint %c_0xFF %w32_sh0
%w32_invm0 = OpNot %uint %w32_mask0
%w32_cleared0 = OpBitwiseAnd %uint %w32_word0 %w32_invm0
%w32_vshift0 = OpShiftLeftLogical %uint %w32_b0 %w32_sh0
%w32_new0 = OpBitwiseOr %uint %w32_cleared0 %w32_vshift0
               OpStore %w32_ptr0 %w32_new0 Volatile
    %w32_o1 = OpIAdd %uint %w32_off %c_1
%w32_widx1 = OpShiftRightLogical %uint %w32_o1 %c_2
%w32_shb1 = OpBitwiseAnd %uint %w32_o1 %c_3
%w32_sh1 = OpShiftLeftLogical %uint %w32_shb1 %c_3
%w32_ptr1 = OpAccessChain %arena_word_ptr %arena %c_0 %w32_widx1
%w32_word1 = OpLoad %uint %w32_ptr1 Volatile
%w32_mask1 = OpShiftLeftLogical %uint %c_0xFF %w32_sh1
%w32_invm1 = OpNot %uint %w32_mask1
%w32_cleared1 = OpBitwiseAnd %uint %w32_word1 %w32_invm1
%w32_vshift1 = OpShiftLeftLogical %uint %w32_b1 %w32_sh1
%w32_new1 = OpBitwiseOr %uint %w32_cleared1 %w32_vshift1
               OpStore %w32_ptr1 %w32_new1 Volatile
    %w32_o2 = OpIAdd %uint %w32_off %c_2
%w32_widx2 = OpShiftRightLogical %uint %w32_o2 %c_2
%w32_shb2 = OpBitwiseAnd %uint %w32_o2 %c_3
%w32_sh2 = OpShiftLeftLogical %uint %w32_shb2 %c_3
%w32_ptr2 = OpAccessChain %arena_word_ptr %arena %c_0 %w32_widx2
%w32_word2 = OpLoad %uint %w32_ptr2 Volatile
%w32_mask2 = OpShiftLeftLogical %uint %c_0xFF %w32_sh2
%w32_invm2 = OpNot %uint %w32_mask2
%w32_cleared2 = OpBitwiseAnd %uint %w32_word2 %w32_invm2
%w32_vshift2 = OpShiftLeftLogical %uint %w32_b2 %w32_sh2
%w32_new2 = OpBitwiseOr %uint %w32_cleared2 %w32_vshift2
               OpStore %w32_ptr2 %w32_new2 Volatile
    %w32_o3 = OpIAdd %uint %w32_off %c_3
%w32_widx3 = OpShiftRightLogical %uint %w32_o3 %c_2
%w32_shb3 = OpBitwiseAnd %uint %w32_o3 %c_3
%w32_sh3 = OpShiftLeftLogical %uint %w32_shb3 %c_3
%w32_ptr3 = OpAccessChain %arena_word_ptr %arena %c_0 %w32_widx3
%w32_word3 = OpLoad %uint %w32_ptr3 Volatile
%w32_mask3 = OpShiftLeftLogical %uint %c_0xFF %w32_sh3
%w32_invm3 = OpNot %uint %w32_mask3
%w32_cleared3 = OpBitwiseAnd %uint %w32_word3 %w32_invm3
%w32_vshift3 = OpShiftLeftLogical %uint %w32_b3 %w32_sh3
%w32_new3 = OpBitwiseOr %uint %w32_cleared3 %w32_vshift3
               OpStore %w32_ptr3 %w32_new3 Volatile
               OpReturn
               OpFunctionEnd

; ============================================================================
; vm_push(v) -> void ; vm_pop() -> uint : operand stack (g_opstack/g_sp).
; ============================================================================
   %vm_push = OpFunction %void None %void_fn_from_uint_t
  %push_v = OpFunctionParameter %uint
%push_entry = OpLabel
%push_spval = OpLoad %uint %g_sp
%push_ptr = OpAccessChain %uint_ptr_priv %g_opstack %push_spval
               OpStore %push_ptr %push_v
%push_spnew = OpIAdd %uint %push_spval %c_1
               OpStore %g_sp %push_spnew
               OpReturn
               OpFunctionEnd

    %vm_pop = OpFunction %uint None %uint_fn_void_t
 %pop_entry = OpLabel
%pop_spval = OpLoad %uint %g_sp
%pop_spnew = OpISub %uint %pop_spval %c_1
               OpStore %g_sp %pop_spnew
   %pop_ptr = OpAccessChain %uint_ptr_priv %g_opstack %pop_spnew
   %pop_val = OpLoad %uint %pop_ptr
               OpReturnValue %pop_val
               OpFunctionEnd

; ============================================================================
; write_record(pass, value) -> void : 12-byte RECORD ring entry, matching
; ref_vm.write_record exactly (seq/pass/value words at record_base +
; reccount*12; reccount and seq both advance by 1).
; ============================================================================
%write_record = OpFunction %void None %void_fn_from_uint_uint_t
   %wr_pass = OpFunctionParameter %uint
  %wr_value = OpFunctionParameter %uint
 %wr_entry = OpLabel
     %wr_rc = OpLoad %uint %g_reccount
    %wr_seq = OpLoad %uint %g_seq
     %wr_rb = OpLoad %uint %g_recbase
   %wr_off1 = OpIMul %uint %wr_rc %c_12
    %wr_off = OpIAdd %uint %wr_rb %wr_off1
 %wr_off_p4 = OpIAdd %uint %wr_off %c_4
 %wr_off_p8 = OpIAdd %uint %wr_off %c_8
    %wr_c0 = OpFunctionCall %void %write_u32 %wr_off %wr_seq
    %wr_c1 = OpFunctionCall %void %write_u32 %wr_off_p4 %wr_pass
    %wr_c2 = OpFunctionCall %void %write_u32 %wr_off_p8 %wr_value
   %wr_rc2 = OpIAdd %uint %wr_rc %c_1
               OpStore %g_reccount %wr_rc2
  %wr_seq2 = OpIAdd %uint %wr_seq %c_1
               OpStore %g_seq %wr_seq2
               OpReturn
               OpFunctionEnd

; ============================================================================
; do_trap(val) -> void : write_record(0, val), sentinel = 0xCAFE007F.
; do_exit(code) -> void : sentinel = 0xCAFE0000 | (code & 0xFFFF).
; ============================================================================
   %do_trap = OpFunction %void None %void_fn_from_uint_t
    %dt_val = OpFunctionParameter %uint
 %dt_entry = OpLabel
     %dt_c0 = OpFunctionCall %void %write_record %c_0 %dt_val
%dt_sentinel = OpBitwiseOr %uint %c_CAFE0000 %c_0x7F
   %dt_ptr = OpAccessChain %arena_word_ptr %arena %c_0 %c_sentinel_widx
               OpStore %dt_ptr %dt_sentinel Volatile
               OpReturn
               OpFunctionEnd

   %do_exit = OpFunction %void None %void_fn_from_uint_t
   %de_code = OpFunctionParameter %uint
 %de_entry = OpLabel
%de_masked = OpBitwiseAnd %uint %de_code %c_0xFFFF
%de_sentinel = OpBitwiseOr %uint %c_CAFE0000 %de_masked
   %de_ptr = OpAccessChain %arena_word_ptr %arena %c_0 %c_sentinel_widx
               OpStore %de_ptr %de_sentinel Volatile
; ref_vm.exit_clean bumps seq. The pre-DBG-1 kernel skipped this because seq
; died with the launch; under DBG-1 seq is PERSISTED into the DBG block and a
; resume that started from a rewound seq would overwrite records written
; before the breakpoint, so it must now be exact.
    %de_seq = OpLoad %uint %g_seq
   %de_seq2 = OpIAdd %uint %de_seq %c_1
               OpStore %g_seq %de_seq2
               OpReturn
               OpFunctionEnd

; ============================================================================
; append_log_byte(b) -> void : LOG ring write, matching ref_vm.append_log_byte
; (slot = log_head % log_cap; log_head persisted back into the arena; seq++).
; ============================================================================
%append_log_byte = OpFunction %void None %void_fn_from_uint_t
     %alb_b = OpFunctionParameter %uint
%alb_entry = OpLabel
  %alb_head = OpFunctionCall %uint %read_u32 %c_LOG_HEAD_OFFSET
   %alb_cap = OpLoad %uint %g_logcap
  %alb_slot = OpUMod %uint %alb_head %alb_cap
  %alb_addr = OpIAdd %uint %alb_slot %c_LOG_DATA_OFFSET
   %alb_c0 = OpFunctionCall %void %write_u8 %alb_addr %alb_b
 %alb_head2 = OpIAdd %uint %alb_head %c_1
   %alb_c1 = OpFunctionCall %void %write_u32 %c_LOG_HEAD_OFFSET %alb_head2
   %alb_seq = OpLoad %uint %g_seq
  %alb_seq2 = OpIAdd %uint %alb_seq %c_1
               OpStore %g_seq %alb_seq2
               OpReturn
               OpFunctionEnd

; ============================================================================
; DBG-1 / PROF-1 -- mirrors ref_vm.SvmgVm.new's dbg block, save_debug_state,
; halt_debug_break and run()'s dbg_on/single_step/first_instruction handling,
; and the CUDA sibling's L_DBG_* / L_STEP_DONE tail.
;
; FULLY INERT when DBG_FLAGS == 0: dbg_init performs exactly one arena read
; (the flags word) and then returns; every other helper's first act is to
; test the already-hoisted %g_dbgon and return, so there is no extra arena
; read, no extra write, and no breakpoint-table scan.
; ============================================================================

; save_debug_state(): park pc/sp/csp/step_count/seq/record_count plus the
; full 256-word operand stack and 32-word call stack into the DBG-1 block.
; Skipped entirely when %g_dbgon is 0. The saved words are the same raw i32
; bit patterns this kernel already keeps in %g_opstack/%g_callstack, so no
; sign conversion is needed (ref_vm converts only because its stack is i64).
  %dbg_save = OpFunction %void None %void_fn_t
%dbgs_entry = OpLabel
   %dbgs_on = OpLoad %uint %g_dbgon
  %dbgs_onb = OpINotEqual %bool %dbgs_on %c_0
               OpSelectionMerge %dbgs_ret None
               OpBranchConditional %dbgs_onb %dbgs_do %dbgs_ret
  %dbgs_do = OpLabel
   %dbgs_pc = OpLoad %uint %g_pc
   %dbgs_c0 = OpFunctionCall %void %write_u32 %c_DBG_SAVED_PC %dbgs_pc
   %dbgs_sp = OpLoad %uint %g_sp
   %dbgs_c1 = OpFunctionCall %void %write_u32 %c_DBG_SAVED_SP %dbgs_sp
  %dbgs_csp = OpLoad %uint %g_csp
   %dbgs_c2 = OpFunctionCall %void %write_u32 %c_DBG_SAVED_CSP %dbgs_csp
   %dbgs_sc = OpLoad %uint %g_stepcount
   %dbgs_c3 = OpFunctionCall %void %write_u32 %c_DBG_STEP_COUNT %dbgs_sc
  %dbgs_seq = OpLoad %uint %g_seq
   %dbgs_c4 = OpFunctionCall %void %write_u32 %c_DBG_SAVED_SEQ %dbgs_seq
   %dbgs_rc = OpLoad %uint %g_reccount
   %dbgs_c5 = OpFunctionCall %void %write_u32 %c_DBG_SAVED_RECCOUNT %dbgs_rc
               OpStore %g_dbgi %c_0
               OpBranch %dbgs_lh
  %dbgs_lh = OpLabel
               OpLoopMerge %dbgs_lm %dbgs_lc None
               OpBranch %dbgs_lb
  %dbgs_lb = OpLabel
    %dbgs_i = OpLoad %uint %g_dbgi
  %dbgs_cmp = OpULessThan %bool %dbgs_i %uint_256
               OpBranchConditional %dbgs_cmp %dbgs_body %dbgs_lm
%dbgs_body = OpLabel
 %dbgs_sptr = OpAccessChain %uint_ptr_priv %g_opstack %dbgs_i
   %dbgs_sv = OpLoad %uint %dbgs_sptr
 %dbgs_boff = OpIMul %uint %dbgs_i %c_4
 %dbgs_addr = OpIAdd %uint %dbgs_boff %c_DBG_SAVED_STACK
   %dbgs_c6 = OpFunctionCall %void %write_u32 %dbgs_addr %dbgs_sv
               OpBranch %dbgs_lc
  %dbgs_lc = OpLabel
   %dbgs_i2 = OpLoad %uint %g_dbgi
   %dbgs_i3 = OpIAdd %uint %dbgs_i2 %c_1
               OpStore %g_dbgi %dbgs_i3
               OpBranch %dbgs_lh
  %dbgs_lm = OpLabel
               OpStore %g_dbgi %c_0
               OpBranch %dbgs_kh
  %dbgs_kh = OpLabel
               OpLoopMerge %dbgs_km %dbgs_kc None
               OpBranch %dbgs_kb
  %dbgs_kb = OpLabel
    %dbgs_j = OpLoad %uint %g_dbgi
 %dbgs_kcmp = OpULessThan %bool %dbgs_j %uint_32c
               OpBranchConditional %dbgs_kcmp %dbgs_kbody %dbgs_km
%dbgs_kbody = OpLabel
 %dbgs_cptr = OpAccessChain %uint_ptr_priv %g_callstack %dbgs_j
   %dbgs_cv = OpLoad %uint %dbgs_cptr
 %dbgs_koff = OpIMul %uint %dbgs_j %c_4
 %dbgs_kaddr = OpIAdd %uint %dbgs_koff %c_DBG_SAVED_CALLS
   %dbgs_c7 = OpFunctionCall %void %write_u32 %dbgs_kaddr %dbgs_cv
               OpBranch %dbgs_kc
  %dbgs_kc = OpLabel
   %dbgs_j2 = OpLoad %uint %g_dbgi
   %dbgs_j3 = OpIAdd %uint %dbgs_j2 %c_1
               OpStore %g_dbgi %dbgs_j3
               OpBranch %dbgs_kh
  %dbgs_km = OpLabel
               OpBranch %dbgs_ret
 %dbgs_ret = OpLabel
               OpReturn
               OpFunctionEnd

; halt_debug_break(): sentinel = SENTINEL_DEBUG_BREAK, then save_debug_state.
; Only ever reached with %g_dbgon != 0.
 %dbg_break = OpFunction %void None %void_fn_t
%dbgb_entry = OpLabel
   %dbgb_ptr = OpAccessChain %arena_word_ptr %arena %c_0 %c_sentinel_widx
               OpStore %dbgb_ptr %c_SENT_DBGBRK Volatile
    %dbgb_c0 = OpFunctionCall %void %dbg_save
               OpReturn
               OpFunctionEnd

; retire_and_save(): the halting-opcode tail (HALT / TRAP / SYS_EXIT /
; top-level RET / any trap). ref_vm bumps step_count AFTER step() regardless
; of whether step() halted, so a halting instruction still RETIRED and must
; bump the counter -- but it must NOT take the single-step break (ref_vm's
; "not self.halted" guard), since a program that ended is not "stopped at a
; breakpoint" and reporting it as one would make resume-to-completion loop
; forever. Falling off the end of the code array retires no instruction and
; therefore uses %dbg_save directly, not this.
%dbg_retire_save = OpFunction %void None %void_fn_t
%dbgr_entry = OpLabel
   %dbgr_on = OpLoad %uint %g_dbgon
  %dbgr_onb = OpINotEqual %bool %dbgr_on %c_0
               OpSelectionMerge %dbgr_after None
               OpBranchConditional %dbgr_onb %dbgr_do %dbgr_after
  %dbgr_do = OpLabel
   %dbgr_sc = OpLoad %uint %g_stepcount
  %dbgr_sc2 = OpIAdd %uint %dbgr_sc %c_1
               OpStore %g_stepcount %dbgr_sc2
               OpBranch %dbgr_after
%dbgr_after = OpLabel
   %dbgr_c0 = OpFunctionCall %void %dbg_save
               OpReturn
               OpFunctionEnd

; check_breakpoint() -> 1 if the loop must stop BEFORE executing arena pc.
; Breaking before execution leaves pc ON the breakpoint so a resume
; re-executes it exactly once; the (first_instruction and resumed)
; suppression is what stops a resume from immediately re-breaking on the
; same pc forever.
 %dbg_check = OpFunction %uint None %uint_fn_void_t
%dbgc_entry = OpLabel
               OpStore %g_dbgres %c_0
   %dbgc_on = OpLoad %uint %g_dbgon
   %dbgc_fi = OpLoad %uint %g_firstinsn
   %dbgc_rs = OpLoad %uint %g_resumed
  %dbgc_sup = OpBitwiseAnd %uint %dbgc_fi %dbgc_rs
 %dbgc_nsup = OpISub %uint %c_1 %dbgc_sup
  %dbgc_act = OpBitwiseAnd %uint %dbgc_on %dbgc_nsup
 %dbgc_actb = OpINotEqual %bool %dbgc_act %c_0
               OpSelectionMerge %dbgc_done None
               OpBranchConditional %dbgc_actb %dbgc_scan %dbgc_done
 %dbgc_scan = OpLabel
               OpStore %g_dbgi %c_0
               OpBranch %dbgc_lh
   %dbgc_lh = OpLabel
               OpLoopMerge %dbgc_lm %dbgc_lc None
               OpBranch %dbgc_lb
   %dbgc_lb = OpLabel
    %dbgc_i = OpLoad %uint %g_dbgi
   %dbgc_bc = OpLoad %uint %g_breakcount
  %dbgc_cmp = OpULessThan %bool %dbgc_i %dbgc_bc
               OpBranchConditional %dbgc_cmp %dbgc_body %dbgc_lm
 %dbgc_body = OpLabel
 %dbgc_boff = OpIMul %uint %dbgc_i %c_4
 %dbgc_addr = OpIAdd %uint %dbgc_boff %c_DBG_BREAK_PCS
   %dbgc_bp = OpFunctionCall %uint %read_u32 %dbgc_addr
   %dbgc_pc = OpLoad %uint %g_pc
  %dbgc_hit = OpIEqual %bool %dbgc_bp %dbgc_pc
 %dbgc_curr = OpLoad %uint %g_dbgres
 %dbgc_newr = OpSelect %uint %dbgc_hit %c_1 %dbgc_curr
               OpStore %g_dbgres %dbgc_newr
               OpBranch %dbgc_lc
   %dbgc_lc = OpLabel
   %dbgc_i2 = OpLoad %uint %g_dbgi
   %dbgc_i3 = OpIAdd %uint %dbgc_i2 %c_1
               OpStore %g_dbgi %dbgc_i3
               OpBranch %dbgc_lh
   %dbgc_lm = OpLabel
               OpBranch %dbgc_done
 %dbgc_done = OpLabel
    %dbgc_r = OpLoad %uint %g_dbgres
               OpReturnValue %dbgc_r
               OpFunctionEnd

; post_step() -> 1 if the loop must stop AFTER this fall-through instruction.
; PROF-1 step_count += 1 here; every fall-through opcode routes through this.
  %dbg_post = OpFunction %uint None %uint_fn_void_t
%dbgp_entry = OpLabel
               OpStore %g_dbgres %c_0
   %dbgp_on = OpLoad %uint %g_dbgon
  %dbgp_onb = OpINotEqual %bool %dbgp_on %c_0
               OpSelectionMerge %dbgp_done None
               OpBranchConditional %dbgp_onb %dbgp_do %dbgp_done
  %dbgp_do = OpLabel
   %dbgp_sc = OpLoad %uint %g_stepcount
  %dbgp_sc2 = OpIAdd %uint %dbgp_sc %c_1
               OpStore %g_stepcount %dbgp_sc2
   %dbgp_ss = OpLoad %uint %g_singlestep
               OpStore %g_dbgres %dbgp_ss
               OpBranch %dbgp_done
 %dbgp_done = OpLabel
               OpStore %g_firstinsn %c_0
    %dbgp_r = OpLoad %uint %g_dbgres
               OpReturnValue %dbgp_r
               OpFunctionEnd

; dbg_init() -> 1 if the launch is FATALLY misconfigured (break_count >
; DBG_MAX_BREAKPOINTS; ref_vm panics there, a device kernel has no panic
; channel so it surfaces as a TRAP with the distinguishing value 4 -- a
; silently truncated breakpoint table is a debugger that lies about where it
; stopped). Called from main AFTER the ordinary header init, so the resume
; path's pc/sp/csp/seq/record_count overwrite those defaults.
  %dbg_init = OpFunction %uint None %uint_fn_void_t
%dbgi_entry = OpLabel
%dbgi_flags = OpFunctionCall %uint %read_u32 %c_DBG_FLAGS
   %dbgi_en = OpBitwiseAnd %uint %dbgi_flags %c_1
   %dbgi_on = OpINotEqual %bool %dbgi_en %c_0
  %dbgi_onu = OpSelect %uint %dbgi_on %c_1 %c_0
               OpStore %g_dbgon %dbgi_onu
               OpStore %g_singlestep %c_0
               OpStore %g_firstinsn %c_1
               OpStore %g_resumed %c_0
               OpStore %g_stepcount %c_0
               OpStore %g_breakcount %c_0
               OpStore %g_dbgres %c_0
               OpSelectionMerge %dbgi_done None
               OpBranchConditional %dbgi_on %dbgi_en_blk %dbgi_done
%dbgi_en_blk = OpLabel
  %dbgi_ssb = OpBitwiseAnd %uint %dbgi_flags %c_4
 %dbgi_ssbb = OpINotEqual %bool %dbgi_ssb %c_0
  %dbgi_ssu = OpSelect %uint %dbgi_ssbb %c_1 %c_0
               OpStore %g_singlestep %dbgi_ssu
   %dbgi_bc = OpFunctionCall %uint %read_u32 %c_DBG_BREAK_COUNT
               OpStore %g_breakcount %dbgi_bc
  %dbgi_bad = OpUGreaterThan %bool %dbgi_bc %c_16
               OpSelectionMerge %dbgi_bcok None
               OpBranchConditional %dbgi_bad %dbgi_badbc %dbgi_bcok
%dbgi_badbc = OpLabel
   %dbgi_t0 = OpFunctionCall %void %do_trap %c_4
   %dbgi_t1 = OpFunctionCall %void %dbg_retire_save
               OpReturnValue %c_1
 %dbgi_bcok = OpLabel
   %dbgi_sc = OpFunctionCall %uint %read_u32 %c_DBG_STEP_COUNT
               OpStore %g_stepcount %dbgi_sc
  %dbgi_rsb = OpBitwiseAnd %uint %dbgi_flags %c_2
 %dbgi_rsbb = OpINotEqual %bool %dbgi_rsb %c_0
               OpSelectionMerge %dbgi_rdone None
               OpBranchConditional %dbgi_rsbb %dbgi_resume %dbgi_rdone
%dbgi_resume = OpLabel
               OpStore %g_resumed %c_1
  %dbgi_seq = OpFunctionCall %uint %read_u32 %c_DBG_SAVED_SEQ
               OpStore %g_seq %dbgi_seq
   %dbgi_rc = OpFunctionCall %uint %read_u32 %c_DBG_SAVED_RECCOUNT
               OpStore %g_reccount %dbgi_rc
   %dbgi_pc = OpFunctionCall %uint %read_u32 %c_DBG_SAVED_PC
               OpStore %g_pc %dbgi_pc
   %dbgi_sp = OpFunctionCall %uint %read_u32 %c_DBG_SAVED_SP
               OpStore %g_sp %dbgi_sp
  %dbgi_csp = OpFunctionCall %uint %read_u32 %c_DBG_SAVED_CSP
               OpStore %g_csp %dbgi_csp
               OpStore %g_dbgi %c_0
               OpBranch %dbgi_lh
   %dbgi_lh = OpLabel
               OpLoopMerge %dbgi_lm %dbgi_lc None
               OpBranch %dbgi_lb
   %dbgi_lb = OpLabel
    %dbgi_i = OpLoad %uint %g_dbgi
  %dbgi_cmp = OpULessThan %bool %dbgi_i %uint_256
               OpBranchConditional %dbgi_cmp %dbgi_body %dbgi_lm
 %dbgi_body = OpLabel
 %dbgi_boff = OpIMul %uint %dbgi_i %c_4
 %dbgi_addr = OpIAdd %uint %dbgi_boff %c_DBG_SAVED_STACK
    %dbgi_v = OpFunctionCall %uint %read_u32 %dbgi_addr
 %dbgi_sptr = OpAccessChain %uint_ptr_priv %g_opstack %dbgi_i
               OpStore %dbgi_sptr %dbgi_v
               OpBranch %dbgi_lc
   %dbgi_lc = OpLabel
   %dbgi_i2 = OpLoad %uint %g_dbgi
   %dbgi_i3 = OpIAdd %uint %dbgi_i2 %c_1
               OpStore %g_dbgi %dbgi_i3
               OpBranch %dbgi_lh
   %dbgi_lm = OpLabel
               OpStore %g_dbgi %c_0
               OpBranch %dbgi_kh
   %dbgi_kh = OpLabel
               OpLoopMerge %dbgi_km %dbgi_kc None
               OpBranch %dbgi_kb
   %dbgi_kb = OpLabel
    %dbgi_j = OpLoad %uint %g_dbgi
 %dbgi_kcmp = OpULessThan %bool %dbgi_j %uint_32c
               OpBranchConditional %dbgi_kcmp %dbgi_kbody %dbgi_km
%dbgi_kbody = OpLabel
 %dbgi_koff = OpIMul %uint %dbgi_j %c_4
%dbgi_kaddr = OpIAdd %uint %dbgi_koff %c_DBG_SAVED_CALLS
   %dbgi_kv = OpFunctionCall %uint %read_u32 %dbgi_kaddr
 %dbgi_cptr = OpAccessChain %uint_ptr_priv %g_callstack %dbgi_j
               OpStore %dbgi_cptr %dbgi_kv
               OpBranch %dbgi_kc
   %dbgi_kc = OpLabel
   %dbgi_j2 = OpLoad %uint %g_dbgi
   %dbgi_j3 = OpIAdd %uint %dbgi_j2 %c_1
               OpStore %g_dbgi %dbgi_j3
               OpBranch %dbgi_kh
   %dbgi_km = OpLabel
               OpBranch %dbgi_rdone
%dbgi_rdone = OpLabel
               OpBranch %dbgi_done
 %dbgi_done = OpLabel
    %dbgi_r = OpLoad %uint %g_dbgres
               OpReturnValue %dbgi_r
               OpFunctionEnd

; ============================================================================
; main() -- header decode, then the flat fetch-decode-execute loop.
; ============================================================================
      %main = OpFunction %void None %void_fn_t
%main_entry = OpLabel
%m_codeoff = OpFunctionCall %uint %read_u32 %c_8
               OpStore %g_codeoff %m_codeoff
%m_codelen = OpFunctionCall %uint %read_u32 %c_12
               OpStore %g_codelen %m_codelen
%m_stepbudget = OpFunctionCall %uint %read_u32 %c_24
               OpStore %g_steps %m_stepbudget
%m_entrypc = OpFunctionCall %uint %read_u32 %c_28
               OpStore %g_pc %m_entrypc
               OpStore %g_sp %c_0
               OpStore %g_csp %c_0
               OpStore %g_seq %c_0
               OpStore %g_reccount %c_0
%m_logcap = OpFunctionCall %uint %read_u32 %c_LOG_CAP_OFFSET
               OpStore %g_logcap %m_logcap
%m_recbase = OpIAdd %uint %m_logcap %c_LOG_DATA_OFFSET
               OpStore %g_recbase %m_recbase
; DBG-1 launch-time restore. Must run AFTER the header defaults above so the
; resume path overwrites pc/sp/csp/seq/record_count.
%m_dbgfatal = OpFunctionCall %uint %dbg_init
%m_dbgfatalb = OpINotEqual %bool %m_dbgfatal %c_0
               OpSelectionMerge %m_dbg_ok None
               OpBranchConditional %m_dbgfatalb %m_dbg_bad %m_dbg_ok
%m_dbg_bad = OpLabel
               OpReturn
 %m_dbg_ok = OpLabel
               OpBranch %loop_header

%loop_header = OpLabel
               OpLoopMerge %loop_merge %loop_continue None
               OpBranch %loop_check

%loop_check = OpLabel
  %lc_steps = OpLoad %uint %g_steps
%lc_timedout = OpIEqual %bool %lc_steps %c_0
               OpSelectionMerge %lc_after_to None
               OpBranchConditional %lc_timedout %timeout_block %lc_after_to

%timeout_block = OpLabel
    %tb_ptr = OpAccessChain %arena_word_ptr %arena %c_0 %c_sentinel_widx
               OpStore %tb_ptr %c_DEAD0000 Volatile
; Budget exhaustion retires NO instruction, so step_count is deliberately
; not bumped here -- save only.
     %tb_c0 = OpFunctionCall %void %dbg_save
               OpReturn

  %lc_after_to = OpLabel
     %lc_pc = OpLoad %uint %g_pc
%lc_codelen = OpLoad %uint %g_codelen
  %lc_atend = OpUGreaterThanEqual %bool %lc_pc %lc_codelen
               OpSelectionMerge %fetch_block None
               OpBranchConditional %lc_atend %exit0_block %fetch_block

%exit0_block = OpLabel
; pc ran off the end of the code array: ref_vm calls exit_clean(0) (which
; bumps seq) and retires NO instruction, so step_count is deliberately not
; bumped here -- save only.
     %e0_c0 = OpFunctionCall %void %do_exit %c_0
     %e0_c1 = OpFunctionCall %void %dbg_save
               OpReturn

%fetch_block = OpLabel
; DBG-1 breakpoint check: after the timeout and end-of-code checks and
; BEFORE the steps_remaining decrement / execution, exactly as ref_vm.run.
     %fb_bp = OpFunctionCall %uint %dbg_check
    %fb_bpb = OpINotEqual %bool %fb_bp %c_0
               OpSelectionMerge %fb_go None
               OpBranchConditional %fb_bpb %fb_break %fb_go
 %fb_break = OpLabel
    %fb_bk0 = OpFunctionCall %void %dbg_break
               OpReturn
    %fb_go = OpLabel
   %fb_steps = OpLoad %uint %g_steps
  %fb_steps2 = OpISub %uint %fb_steps %c_1
               OpStore %g_steps %fb_steps2
      %fb_pc = OpLoad %uint %g_pc
 %fb_codeoff = OpLoad %uint %g_codeoff
%fb_fetchoff = OpIAdd %uint %fb_codeoff %fb_pc
  %fb_opcode = OpFunctionCall %uint %read_u8 %fb_fetchoff
               OpSelectionMerge %switch_merge None
               OpSwitch %fb_opcode %case_default
                 0 %case_nop 1 %case_halt 2 %case_trap
                 16 %case_pushi 17 %case_pushf 18 %case_dup 19 %case_drop 20 %case_swap
                 32 %case_add 33 %case_sub 34 %case_mul 35 %case_div 36 %case_rem
                 40 %case_fadd 41 %case_fsub 42 %case_fmul 43 %case_fdiv
                 48 %case_and 49 %case_or 50 %case_xor 51 %case_shl 52 %case_shr 53 %case_sar
                 56 %case_eq 57 %case_ne 58 %case_lt 59 %case_le 60 %case_gt 61 %case_ge
                 62 %case_feq 63 %case_fne 64 %case_flt 65 %case_fle 66 %case_fgt 67 %case_fge
                 80 %case_load32 81 %case_store32 82 %case_load8 83 %case_store8
                 96 %case_jmp 97 %case_jz 98 %case_jnz
                 104 %case_call 105 %case_ret
                 112 %case_sys_putc 113 %case_sys_exit 114 %case_sys_result
                 120 %case_tid 121 %case_ntid 122 %case_parfor

%case_default = OpLabel
    %cd_c0 = OpFunctionCall %void %do_trap %c_BADBAD
    %cd_ds = OpFunctionCall %void %dbg_retire_save
               OpReturn

; ---- control ---------------------------------------------------------
  %case_nop = OpLabel
    %nop_pc = OpLoad %uint %g_pc
   %nop_pc2 = OpIAdd %uint %nop_pc %c_1
               OpStore %g_pc %nop_pc2
               OpBranch %switch_merge

 %case_halt = OpLabel
%halt_codeoff = OpLoad %uint %g_codeoff
   %halt_pc = OpLoad %uint %g_pc
 %halt_base = OpIAdd %uint %halt_codeoff %halt_pc
 %halt_immoff = OpIAdd %uint %halt_base %c_1
 %halt_code = OpFunctionCall %uint %read_u8 %halt_immoff
     %h_c0 = OpFunctionCall %void %do_exit %halt_code
     %h_ds = OpFunctionCall %void %dbg_retire_save
               OpReturn

 %case_trap = OpLabel
%trap_codeoff = OpLoad %uint %g_codeoff
   %trap_pc = OpLoad %uint %g_pc
 %trap_base = OpIAdd %uint %trap_codeoff %trap_pc
 %trap_immoff = OpIAdd %uint %trap_base %c_1
 %trap_code = OpFunctionCall %uint %read_u8 %trap_immoff
     %t_c0 = OpFunctionCall %void %do_trap %trap_code
     %t_ds = OpFunctionCall %void %dbg_retire_save
               OpReturn

; ---- stack ops ---------------------------------------------------------
%case_pushi = OpLabel
%pi_codeoff = OpLoad %uint %g_codeoff
    %pi_pc = OpLoad %uint %g_pc
  %pi_base = OpIAdd %uint %pi_codeoff %pi_pc
%pi_immoff = OpIAdd %uint %pi_base %c_1
   %pi_val = OpFunctionCall %uint %read_u32 %pi_immoff
    %pi_c0 = OpFunctionCall %void %vm_push %pi_val
   %pi_pc5 = OpIAdd %uint %pi_pc %c_4
   %pi_pc5b = OpIAdd %uint %pi_pc5 %c_1
               OpStore %g_pc %pi_pc5b
               OpBranch %switch_merge

%case_pushf = OpLabel
%pf_codeoff = OpLoad %uint %g_codeoff
    %pf_pc = OpLoad %uint %g_pc
  %pf_base = OpIAdd %uint %pf_codeoff %pf_pc
%pf_immoff = OpIAdd %uint %pf_base %c_1
   %pf_val = OpFunctionCall %uint %read_u32 %pf_immoff
    %pf_c0 = OpFunctionCall %void %vm_push %pf_val
   %pf_pc5 = OpIAdd %uint %pf_pc %c_4
   %pf_pc5b = OpIAdd %uint %pf_pc5 %c_1
               OpStore %g_pc %pf_pc5b
               OpBranch %switch_merge

  %case_dup = OpLabel
   %dup_sp = OpLoad %uint %g_sp
  %dup_idx = OpISub %uint %dup_sp %c_1
  %dup_ptr = OpAccessChain %uint_ptr_priv %g_opstack %dup_idx
  %dup_val = OpLoad %uint %dup_ptr
   %dup_c0 = OpFunctionCall %void %vm_push %dup_val
    %dup_pc = OpLoad %uint %g_pc
