   %jz_rel = OpSelect %uint %jz_isneg2 %jz_negval %jz_raw
  %jz_pc3 = OpIAdd %uint %jz_pc %c_3
%jz_taken = OpIAdd %uint %jz_pc3 %jz_rel
%jz_iszero = OpIEqual %bool %jz_cond %c_0
   %jz_new = OpSelect %uint %jz_iszero %jz_taken %jz_pc3
               OpStore %g_pc %jz_new
               OpBranch %switch_merge

