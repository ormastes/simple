; ---- control flow ----------------------------------------------------
  %case_jmp = OpLabel
%jmp_codeoff = OpLoad %uint %g_codeoff
    %jmp_pc = OpLoad %uint %g_pc
  %jmp_base = OpIAdd %uint %jmp_codeoff %jmp_pc
%jmp_immoff = OpIAdd %uint %jmp_base %c_1
  %jmp_raw = OpFunctionCall %uint %read_u16 %jmp_immoff
%jmp_isneg2 = OpUGreaterThanEqual %bool %jmp_raw %c_32768
%jmp_negval = OpIAdd %uint %jmp_raw %c_SIGN_EXT_ADD
   %jmp_rel = OpSelect %uint %jmp_isneg2 %jmp_negval %jmp_raw
  %jmp_pc3 = OpIAdd %uint %jmp_pc %c_3
  %jmp_new = OpIAdd %uint %jmp_pc3 %jmp_rel
               OpStore %g_pc %jmp_new
               OpBranch %switch_merge

   %case_jz = OpLabel
