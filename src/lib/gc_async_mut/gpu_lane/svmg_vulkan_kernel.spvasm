    %cl_ds = OpFunctionCall %void %dbg_retire_save
               OpReturn
  %cl_ok = OpLabel
%cl_codeoff = OpLoad %uint %g_codeoff
    %cl_pc = OpLoad %uint %g_pc
  %cl_base = OpIAdd %uint %cl_codeoff %cl_pc
%cl_immoff = OpIAdd %uint %cl_base %c_1
%cl_target = OpFunctionCall %uint %read_u16 %cl_immoff
   %cl_ret = OpIAdd %uint %cl_pc %c_3
   %cl_ptr = OpAccessChain %uint_ptr_priv %g_callstack %cl_csp
               OpStore %cl_ptr %cl_ret
  %cl_csp2 = OpIAdd %uint %cl_csp %c_1
               OpStore %g_csp %cl_csp2
               OpStore %g_pc %cl_target
               OpBranch %switch_merge

  %case_ret = OpLabel
    %rt_csp = OpLoad %uint %g_csp
%rt_iszero = OpIEqual %bool %rt_csp %c_0
               OpSelectionMerge %rt_pop None
               OpBranchConditional %rt_iszero %rt_topexit %rt_pop
%rt_topexit = OpLabel
    %rt_e0 = OpFunctionCall %void %do_exit %c_0
    %rt_ds = OpFunctionCall %void %dbg_retire_save
               OpReturn
  %rt_pop = OpLabel
  %rt_csp2 = OpISub %uint %rt_csp %c_1
   %rt_ptr = OpAccessChain %uint_ptr_priv %g_callstack %rt_csp2
   %rt_pcv = OpLoad %uint %rt_ptr
               OpStore %g_csp %rt_csp2
               OpStore %g_pc %rt_pcv
               OpBranch %switch_merge

; ---- SYS_* / thread-id -------------------------------------------------
%case_sys_putc = OpLabel
    %sp_ch = OpFunctionCall %uint %vm_pop
    %sp_c0 = OpFunctionCall %void %append_log_byte %sp_ch
    %sp_pc = OpLoad %uint %g_pc
   %sp_pc2 = OpIAdd %uint %sp_pc %c_1
               OpStore %g_pc %sp_pc2
               OpBranch %switch_merge

%case_sys_exit = OpLabel
   %se_code = OpFunctionCall %uint %vm_pop
    %se_c0 = OpFunctionCall %void %do_exit %se_code
    %se_ds = OpFunctionCall %void %dbg_retire_save
               OpReturn

%case_sys_result = OpLabel
  %sr_value = OpFunctionCall %uint %vm_pop
   %sr_pass = OpFunctionCall %uint %vm_pop
    %sr_c0 = OpFunctionCall %void %write_record %sr_pass %sr_value
    %sr_pc = OpLoad %uint %g_pc
   %sr_pc2 = OpIAdd %uint %sr_pc %c_1
               OpStore %g_pc %sr_pc2
               OpBranch %switch_merge

  %case_tid = OpLabel
   %tid_c0 = OpFunctionCall %void %vm_push %c_0
   %tid_pc = OpLoad %uint %g_pc
  %tid_pc2 = OpIAdd %uint %tid_pc %c_1
               OpStore %g_pc %tid_pc2
               OpBranch %switch_merge

 %case_ntid = OpLabel
  %ntid_c0 = OpFunctionCall %void %vm_push %c_1
  %ntid_pc = OpLoad %uint %g_pc
 %ntid_pc2 = OpIAdd %uint %ntid_pc %c_1
               OpStore %g_pc %ntid_pc2
               OpBranch %switch_merge

%case_parfor = OpLabel
    %pf2_pc = OpLoad %uint %g_pc
   %pf2_pc3 = OpIAdd %uint %pf2_pc %c_3
               OpStore %g_pc %pf2_pc3
               OpBranch %switch_merge

%switch_merge = OpLabel
; Post-step hook every FALL-THROUGH opcode returns through: PROF-1
; step_count += 1, then the single-step stop. Halting opcodes never reach
; here -- they OpReturn from their own case block after %dbg_retire_save.
    %sm_stop = OpFunctionCall %uint %dbg_post
   %sm_stopb = OpINotEqual %bool %sm_stop %c_0
               OpSelectionMerge %sm_cont None
               OpBranchConditional %sm_stopb %sm_break %sm_cont
 %sm_break = OpLabel
    %sm_bk0 = OpFunctionCall %void %dbg_break
               OpReturn
  %sm_cont = OpLabel
               OpBranch %loop_continue

%loop_continue = OpLabel
               OpBranch %loop_header

%loop_merge = OpLabel
               OpUnreachable

               OpFunctionEnd
