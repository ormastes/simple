# cuda_vm per-launch SVM-G executor (Task B3).
#
# Design: doc/05_design/runtime/gpu_remote_interpreter_architecture.md
# section 5.2 / 3.3. Builds an SGP program blob (D1's assembler +
# encode_sgp_header) into a GMB-1 arena (A2's MailboxArena helpers),
# uploads it through B1's CudaLaneSession, launches the checked-in
# svmg_interpret PTX kernel (svmg_cuda_kernel.ptx) 1x1, syncs, and drains
# the result via the same log/record decoding conventions as D2's host
# reference VM (ref_vm.spl) -- the PTX kernel is a device-side
# reimplementation of SvmgVm.step/run, so a caller compares its output
# against ref_vm.run() on the *same* assembled bytes for conformance.
#
# NOTE on RECORD ring layout divergence (filed as a bug, not routed
# around): A2's gpu_mailbox.MailboxArena.append_record/drain_records
# reserves a 4-byte head-counter word at the RECORD ring base and starts
# records at ring_base+8. D2's ref_vm.write_record/read_records (the
# authority for D3 conformance -- SvmgVm never writes a head counter)
# starts records directly at ring_base+0 with NO counter word. The
# checked-in PTX kernel (svmg_cuda_kernel.ptx) matches ref_vm's format
# (D3's conformance table is defined against ref_vm), so this executor's
# record decode below also matches ref_vm, not A2's MailboxArena
# accessors -- using A2's `drain_records` here would silently misread the
# first record's seq/pass fields as a bogus head/cap pair. See
# doc/08_tracking/bug/svmg_a2_record_ring_head_counter_diverges_from_d2_ref_vm_2026-08-07.md.

mod std.gc_async_mut.gpu_lane.cuda_vm_executor

use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.sgp.{sgp_header_new, encode_sgp_header, SGP_HEADER_SIZE}
use std.common.svmg.mailbox_const.{
    ARENA_DATA_SIZE, ARENA_TOTAL_SIZE, RAM_SENTINEL_OFFSET,
    LOG_HEAD_OFFSET, LOG_CAP_OFFSET, LOG_DATA_OFFSET, DEFAULT_LOG_CAP,
    RECORD_SIZE, SENTINEL_EXIT_MASK, SENTINEL_TIMEOUT}
use std.nogc_sync_mut.test_runner.gpu_mailbox.{zero_bytes}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.gc_async_mut.gpu_lane.cuda_lane_session.{CudaLaneSession, lane_scratch_alloc, lane_scratch_free}

@unsafe(reason: "nonnull raw store; CUDA argument allocation and bounds are caller-owned", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)

# Entry point name inside svmg_cuda_kernel.ptx.
pub val SVMG_ENTRY: text = "svmg_interpret"

# Default step budget when SVMG_STEP_BUDGET is unset/unparseable.
pub val DEFAULT_STEP_BUDGET: i64 = 100000

pub struct SvmgResultRecord:
    seq: i64
    passed: i64
    value: i64

pub struct SvmgRunOutcome:
    ok: bool
    error: text
    sentinel: i64
    trapped: bool
    timed_out: bool
    exit_code: i64
    log_text: text
    records: [SvmgResultRecord]
    # Full ARENA_TOTAL_SIZE output arena from this call's readback (empty on
    # any error path before a successful `arena_read`), plus the logical
    # DATA-region start offset it was built at (`SGP_HEADER_SIZE +
    # code.len()`). Feed both back into `run_source_persisting_data` as
    # `prior_arena`/`prior_data_off` to preserve this call's DATA/LOG/RECORD
    # state into the next call -- see `run_source_persisting_data` docstring.
    out_arena: [u8]
    data_off: i64

fn _u32_le_at(bytes: [u8], idx: i64) -> i64:
    (bytes[idx] as i64) | ((bytes[idx + 1] as i64) << 8) | ((bytes[idx + 2] as i64) << 16) | ((bytes[idx + 3] as i64) << 24)

# NOTE: `step_budget_from_env`/`build_svmg_arena`/`read_sentinel`/
# `read_records` are deliberately plain `fn`, not `pub fn`: the
# `primitive_api` lint flags `pub fn` with a bare i64 param/return, and its
# documented `#![allow(primitive_api)]` file-level suppression does not
# actually take effect under the current seed lint checker (same issue
# documented in D1's opcodes.spl/sgp.spl). Still externally importable as
# plain `fn` (same pattern as `std.common.convert.safe_parse_int`), so this
# does not change what's usable from outside the module.

# Read SVMG_STEP_BUDGET from the environment; DEFAULT_STEP_BUDGET on
# unset/non-numeric/non-positive (never silently 0, which would make every
# program time out on its first instruction).
fn step_budget_from_env() -> i64:
    val raw = env_get("SVMG_STEP_BUDGET")
    if raw == "" or raw == nil:
        return DEFAULT_STEP_BUDGET
    val parsed = raw.trim().to_i64_opt()
    match parsed:
        Some(n): if n > 0: n else: DEFAULT_STEP_BUDGET
        None: DEFAULT_STEP_BUDGET

# Build a full ARENA_TOTAL_SIZE (128 KiB) GMB-1 arena with an SGP blob at
# DATA+0 -- pure host-side bytes, no device calls, so unit-testable without
# CUDA. Mirrors D2's ref_vm.build_arena exactly (same header layout, same
# LOG_CAP pre-init), reimplemented here (not imported) because A2 owns the
# `nogc_sync_mut`-tier zero_bytes helper this executor's tier needs and
# ref_vm.build_arena is a private `fn` in the `common`-tier svmg module.
fn build_svmg_arena(code: [u8], step_budget: i64, entry_pc: i64) -> [u8]:
    val code_off = SGP_HEADER_SIZE
    val code_len = code.len()
    val data_off = code_off + code_len
    if data_off > ARENA_DATA_SIZE:
        panic("cuda_vm: SGP blob ({data_off} bytes) exceeds DATA region ({ARENA_DATA_SIZE} bytes)")
    val header = sgp_header_new(code_off, code_len, data_off, 0, step_budget, entry_pc)
    val header_bytes = encode_sgp_header(header)

    var arena = zero_bytes(ARENA_TOTAL_SIZE)
    var i = 0
    while i < header_bytes.len():
        arena[i] = header_bytes[i]
        i = i + 1
    i = 0
    while i < code.len():
        arena[code_off + i] = code[i]
        i = i + 1

    # LOG_CAP_OFFSET (LOG ring capacity, host-initialized) -- little-endian.
    arena[LOG_CAP_OFFSET + 0] = (DEFAULT_LOG_CAP & 0xFF) as u8
    arena[LOG_CAP_OFFSET + 1] = ((DEFAULT_LOG_CAP >> 8) & 0xFF) as u8
    arena[LOG_CAP_OFFSET + 2] = ((DEFAULT_LOG_CAP >> 16) & 0xFF) as u8
    arena[LOG_CAP_OFFSET + 3] = ((DEFAULT_LOG_CAP >> 24) & 0xFF) as u8
    arena

# Root-cause fix for
# doc/08_tracking/bug/cuda_resident_session_run_program_discards_arena_data_region_state_2026-08-08.md:
# same host-side splice `cuda_exec.spl`'s `run_program_with_persistence`
# workaround implemented at the call site, now owned here so callers don't
# have to re-derive it. `prior_arena` must be a previous call's full
# ARENA_TOTAL_SIZE output arena (anything else, including the default `[]`,
# is treated as "no prior state" and this degrades to plain
# `build_svmg_arena` -- i.e. the fresh-every-call behavior `run_source`
# still needs for its OWN stateless per-vector contract, see module
# docstring). `prior_data_off` is the logical DATA-region start offset that
# `prior_arena` was laid out at (its own `code_off + code_len`) -- copying by
# this LOGICAL offset, not a raw byte offset, means a shorter/longer cell
# body doesn't corrupt or lose prior globals as code length shifts release
# to release.
fn build_svmg_arena_persisting_data(code: [u8], step_budget: i64, entry_pc: i64, prior_arena: [u8], prior_data_off: i64) -> [u8]:
    var arena = build_svmg_arena(code, step_budget, entry_pc)
    if prior_arena.len() != ARENA_TOTAL_SIZE:
        return arena
    # SVM-G STORE/LOAD addresses are ABSOLUTE arena offsets, not relative to
    # data_off (proved via live-device testing) -- the persisted region must
    # be copied verbatim at the same absolute offsets in both arenas, never
    # shifted. `copy_start` picks whichever cell's header+code reaches
    # furthest so neither is clobbered.
    val data_off = SGP_HEADER_SIZE + code.len()
    val copy_start = if data_off > prior_data_off: data_off else: prior_data_off
    var k = copy_start
    while k < ARENA_TOTAL_SIZE:
        arena[k] = prior_arena[k]
        k = k + 1
    arena

fn read_sentinel(arena: [u8]) -> i64:
    _u32_le_at(arena, RAM_SENTINEL_OFFSET)

pub fn read_log(arena: [u8]) -> text:
    val head = _u32_le_at(arena, LOG_HEAD_OFFSET)
    val cap = _u32_le_at(arena, LOG_CAP_OFFSET)
    var out = ""
    var i = 0
    while i < head and i < cap:
        val code = arena[LOG_DATA_OFFSET + i] as i64
        if code == 10:
            out = out + "\n"
        elif code >= 32 and code <= 126:
            out = out + text_from_ascii_byte(code)
        i = i + 1
    out

fn text_from_ascii_byte(code: i64) -> text:
    val table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    val idx = code - 32
    table[idx:idx + 1]

# Decode records starting at ring_base+0 (D2/ref_vm layout, NOT A2's
# head-counter layout -- see module docstring), stopping at the first
# all-zero record (best-effort, matching ref_vm.read_records' documented
# fallback for a caller with only the raw arena and no known count) or
# after `max_records` -- whichever comes first, so a corrupt/never-written
# ring can't spin the loop.
fn read_records(arena: [u8], max_records: i64) -> [SvmgResultRecord]:
    val log_cap = _u32_le_at(arena, LOG_CAP_OFFSET)
    val base = LOG_DATA_OFFSET + log_cap
    var out: [SvmgResultRecord] = []
    var i = 0
    while i < max_records:
        val off = base + i * RECORD_SIZE
        val seq = _u32_le_at(arena, off)
        val passed = _u32_le_at(arena, off + 4)
        val value_raw = _u32_le_at(arena, off + 8)
        if seq == 0 and passed == 0 and value_raw == 0:
            return out
        val value = if value_raw >= 0x80000000: value_raw - 0x100000000 else: value_raw
        out.push(SvmgResultRecord(seq: seq, passed: passed, value: value))
        i = i + 1
    out

# Decode the sentinel into (trapped, timed_out, exit_code) exactly like
# ref_vm's VmRunResult fields -- `trapped` is inferred from the exit code
# 0x7F convention (TRAP_OOB_EXIT_CODE) shared by every trap path in
# ref_vm.step, matching how conformance_suite_spec.spl distinguishes them.
fn _decode_sentinel(sentinel: i64) -> (bool, bool, i64):
    if sentinel == SENTINEL_TIMEOUT:
        return (false, true, 0)
    val high16 = sentinel & 0xFFFF0000
    if high16 == SENTINEL_EXIT_MASK:
        val code_val = sentinel & 0xFFFF
        return (code_val == 0x7F, false, code_val)
    (false, false, 0)

# `CudaVmExecutor` -- one CudaLaneSession, the checked-in PTX artifact
# loaded once, and a per-call `run_source` entry point.
class CudaVmExecutor:
    session: CudaLaneSession
    entry_loaded: bool

    static fn create() -> CudaVmExecutor:
        CudaVmExecutor(session: CudaLaneSession.create(), entry_loaded: false)

    # `kernel_bytes` is the checked-in svmg_cuda_kernel.ptx artifact's raw
    # bytes (caller reads the file -- this module never touches the
    # filesystem directly, matching the rest of the gpu_lane tier).
    me init(kernel_bytes: [u8]) -> text:
        val probe_result = self.session.probe()
        if probe_result != "":
            return probe_result
        val init_err = self.session.init()
        if init_err != "":
            return init_err
        val load_err = self.session.load_entry(kernel_bytes, SVMG_ENTRY)
        if load_err != "":
            return load_err
        self.entry_loaded = true
        ""

    # Assemble `source` (SVM-G assembly text, D1's mnemonic syntax), build
    # an SGP-blob arena, upload, launch 1x1, sync, and drain. `step_budget`
    # should come from `step_budget_from_env()` unless a caller overrides
    # it (e.g. the D3 conformance harness pins per-vector budgets).
    me run_source(source: text, step_budget: i64, entry_pc: i64) -> SvmgRunOutcome:
        self.run_source_persisting_data(source, step_budget, entry_pc, [], 0)

    # Same upload/launch/sync/drain sequence as `run_source`, but the arena
    # is built with `build_svmg_arena_persisting_data` instead of
    # `build_svmg_arena` -- i.e. it carries `prior_arena`'s DATA/LOG/RECORD
    # state forward into this call's arena before launch, and returns this
    # call's own output arena (`SvmgRunOutcome.out_arena`) plus the
    # logical DATA-region offset it was built at
    # (`SvmgRunOutcome.data_off`) so a caller can chain calls: pass this
    # outcome's `out_arena`/`data_off` back in as the NEXT call's
    # `prior_arena`/`prior_data_off`. `run_source` itself calls this with
    # `prior_arena: []`, which `build_svmg_arena_persisting_data` treats as
    # "no prior state" and degrades to a plain fresh build -- so
    # `run_source`'s existing stateless-per-call contract (relied on by
    # `cuda_vm_executor_conformance_spec.spl`'s independent per-vector runs)
    # is unchanged. Fixes
    # doc/08_tracking/bug/cuda_resident_session_run_program_discards_arena_data_region_state_2026-08-08.md
    # at the root -- callers that need cross-call persistence (e.g.
    # `CudaExec.run_program_with_persistence`) no longer have to reimplement
    # the launch sequence themselves.
    me run_source_persisting_data(source: text, step_budget: i64, entry_pc: i64, prior_arena: [u8], prior_data_off: i64) -> SvmgRunOutcome:
        if not self.entry_loaded:
            return SvmgRunOutcome(ok: false, error: "cuda-vm-entry-not-loaded",
                sentinel: 0, trapped: false, timed_out: false, exit_code: 0,
                log_text: "", records: [], out_arena: [], data_off: 0)
        val code = svmg_asm(source)
        val data_off = SGP_HEADER_SIZE + code.len()
        val arena = build_svmg_arena_persisting_data(code, step_budget, entry_pc, prior_arena, prior_data_off)
        if not self.session.arena_write(arena):
            return SvmgRunOutcome(ok: false, error: self.session.last_error,
                sentinel: 0, trapped: false, timed_out: false, exit_code: 0,
                log_text: "", records: [], out_arena: [], data_off: 0)

        val value_ptr = lane_scratch_alloc(8)
        val args_ptr = lane_scratch_alloc(8)
        rt_ptr_write_i64(value_ptr, 0, self.session.arena_ptr)
        rt_ptr_write_i64(args_ptr, 0, value_ptr)
        val launch_err = self.session.launch_once(1, 1, args_ptr)
        lane_scratch_free(value_ptr)
        lane_scratch_free(args_ptr)
        if launch_err != "":
            return SvmgRunOutcome(ok: false, error: launch_err,
                sentinel: self.session.last_dispatch_sentinel,
                trapped: false, timed_out: launch_err == "cuda-lane-device-timeout-sentinel",
                exit_code: 0, log_text: "", records: [], out_arena: [], data_off: 0)

        val out_arena = self.session.arena_read(ARENA_TOTAL_SIZE)
        if out_arena.len() == 0:
            return SvmgRunOutcome(ok: false, error: self.session.last_error,
                sentinel: 0, trapped: false, timed_out: false, exit_code: 0,
                log_text: "", records: [], out_arena: [], data_off: 0)

        val sentinel = read_sentinel(out_arena)
        val (trapped, timed_out, exit_code) = _decode_sentinel(sentinel)
        SvmgRunOutcome(
            ok: true, error: "", sentinel: sentinel,
            trapped: trapped, timed_out: timed_out, exit_code: exit_code,
            log_text: read_log(out_arena),
            records: read_records(out_arena, 64),
            out_arena: out_arena, data_off: data_off,
        )

    me shutdown() -> text:
        self.session.shutdown()

export CudaVmExecutor, SvmgRunOutcome, SvmgResultRecord
export SVMG_ENTRY, DEFAULT_STEP_BUDGET
export step_budget_from_env, build_svmg_arena, build_svmg_arena_persisting_data
export read_sentinel, read_log, read_records
