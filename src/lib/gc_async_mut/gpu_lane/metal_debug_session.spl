# `MetalDebugSession` -- DBG-1 / PROF-1 debugging over the Metal SVM-G lane.
#
# Stream P8 of the unified debug/profile plan. Design:
# doc/05_design/app/tools/unified_debug_profile_capability_architecture_2026-08-09.md
#
# THIN BY CONSTRUCTION. This module owns no dispatch sequence, no device
# handles, and no arena layout of its own. Every launch delegates to
# `MetalVmExecutor.run_source_persisting_data`, which already does assemble ->
# build arena -> upload -> dispatch 1x1x1 -> wait -> read back. The only thing
# added here is: poke the DBG-1 block in the arena BEFORE a launch, and read
# the saved state back out AFTER it.
#
# WHY THIS IS THE VULKAN TWIN AND NOT THE CUDA ONE
# ------------------------------------------------
# Architecturally Metal sits next to Vulkan, not next to CUDA: a compute
# pipeline state object is built once at init and then dispatched, with no
# resident/persistent-kernel submode to choose between. So the launch
# primitive here is the Vulkan one verbatim. The ONE lane-level difference is
# the kernel artifact's TYPE: CUDA takes `.ptx` bytes and Vulkan takes `.spv`
# bytes, but Metal compiles MSL SOURCE TEXT at runtime through
# `rt_metal_compile_shader`, so `attach_kernel` takes `text`, not `[u8]`.
# That is not a stylistic choice -- there is no offline `metal`/`metallib`
# toolchain on a non-macOS build host, so there is no compiled artifact to
# check in. See `metal_vm_executor.spl`'s module docstring.
#
# WHY THE PERSISTED-ARENA PATH IS THE WHOLE MECHANISM
# ---------------------------------------------------
# `build_svmg_arena_persisting_data` copies `prior_arena[copy_start ..
# ARENA_TOTAL_SIZE]` verbatim into the next launch's arena. DBG-1 lives at
# 0x1F000..0x20000, i.e. inside that copied range and ABOVE every code/data
# region, so the debug block rides forward across launches for free. That is
# why "break, inspect, resume" needs no new executor entry point.
#
# ABSOLUTE OFFSETS -- THE TRAP THIS FILE MUST NOT REINTRODUCE
# -----------------------------------------------------------
# SVM-G STORE/LOAD and the DBG-1 block address the arena by ABSOLUTE byte
# offset, never relative to `data_off`. Every DBG access below goes through
# `ref_vm`'s `dbg_*` accessors, which take absolute offsets from
# `mailbox_const.spl` -- this file never computes a DBG offset itself,
# precisely so the trap has no place to reappear. (Only a CROSS-CELL test
# with DIFFERING code lengths can catch a regression in the copy itself; that
# is `metal_vm_arena_persist_spec.spl`'s job, not this module's.)
#
# WHY A PROGRAM CANNOT FORGE ITS OWN BREAKPOINTS
# ----------------------------------------------
# 0x1F000 is past `ARENA_DATA_SIZE` (0x10000), and the VM's `bounds_ok`
# rejects any LOAD/STORE at or beyond that, so SVM-G bytecode cannot reach
# the DBG-1 block. Only the host (this file) can write it.
#
# ===========================================================================
# DEVICE VERIFICATION STATUS -- READ BEFORE TRUSTING A GREEN RUN
# ===========================================================================
# No line of this file has ever run against a Metal device. The repo's hosts
# are Linux, where `rt_metal_is_available()` hard-returns false, so
# `attach_kernel` returns "skip:metal-unavailable-not-macos" and every
# device-touching path below is unreached. The unit spec
# (test/01_unit/lib/gpu_lane/metal_debug_session_spec.spl) exercises only the
# host-side halves that are reachable without a device -- capability
# reporting, fail-closed-before-attach, breakpoint bookkeeping, `read_mem`
# bounds, and the profile-report CONTRACT. That is real coverage of real
# code, and it is NOT evidence that a Metal device produces correct debug
# state. Tracked, with the steps that would close it, in
# doc/08_tracking/bug/metal_gpu_lane_device_verification_pending_2026-08-09.md.

use std.common.debug.capability.{CapLevel}
use std.common.debug.debug_target.{
    DebugState, debug_state_new, PC_KIND_SVMG,
    STOP_BREAKPOINT, STOP_STEP, STOP_HALT, STOP_TRAP, STOP_TIMEOUT,
}
use std.common.debug.profile_target.{ProfileReport, PROFILE_ABSENT, profile_report_new}
use std.common.debug.session_core.{AttachOpts}
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.mailbox_const.{
    DBG_FLAG_ENABLED, DBG_FLAG_RESUME, DBG_FLAG_SINGLE_STEP,
    SENTINEL_DEBUG_BREAK, SENTINEL_TIMEOUT,
}
use std.common.svmg.ref_vm.{
    dbg_set_flags, dbg_set_breakpoints, dbg_read_saved_pc, dbg_read_saved_sp,
    dbg_read_saved_csp, dbg_read_step_count, dbg_read_saved_stack_slot,
    dbg_read_saved_call_slot,
}
use std.gc_async_mut.gpu_lane.metal_vm_executor.{
    MetalVmExecutor, SvmgResultRecord, build_svmg_arena,
}

# The detail string every Metal PROF-1 report carries. Spelled out as a
# constant so the unit spec can assert the EXACT text rather than a substring
# that a fallback message could also satisfy.
pub val METAL_PROFILE_DETAIL: text =
    "target=metal-svmg; steps=measured(DBG_STEP_COUNT, exact); " +
    "wall_ns=absent(no host clock read on this path); " +
    "device_ns=absent(no MTLCounterSampleBuffer on this path)"

# The one error a pre-attach call must produce. A constant, so a spec cannot
# pass on a differently-worded error that happens to be non-empty.
pub val METAL_DEBUG_NOT_ATTACHED: text = "metal-debug-not-attached"

# One launch's observables, in the same field vocabulary the D3 debug
# conformance vectors are written in, so an env spec can diff device-vs-ref
# FIELD FOR FIELD rather than on a summary string.
pub struct MetalDebugOutcome:
    ok: bool
    error: text
    debug_break: bool
    trapped: bool
    timed_out: bool
    sentinel: i64
    saved_pc: i64
    saved_sp: i64
    saved_csp: i64
    stack: [i64]
    calls: [i64]
    step_count: i64
    log_text: text
    records: [SvmgResultRecord]

fn _stop_reason(o: MetalDebugOutcome) -> text:
    if o.debug_break:
        return STOP_BREAKPOINT
    if o.trapped:
        return STOP_TRAP
    if o.timed_out:
        return STOP_TIMEOUT
    STOP_HALT

class MetalDebugSession:
    exec: MetalVmExecutor
    source: text
    code: [u8]
    step_budget: i64
    entry_pc: i64
    # Full ARENA_TOTAL_SIZE arena carried between launches; the DBG-1 block
    # inside it IS the debugger's state.
    arena: [u8]
    data_off: i64
    breaks: [i64]
    attached: bool
    # PROF-1 is armed AT ATTACH, not later: DBG_FLAG_ENABLED is what makes
    # the kernel maintain DBG_STEP_COUNT at all, and it is read at launch
    # time from an already-uploaded arena. A session attached without it
    # cannot be upgraded to a profiling one afterwards.
    profile_armed: bool
    profile_base_steps: i64
    profiling: bool
    last: MetalDebugOutcome

    static fn create() -> MetalDebugSession:
        MetalDebugSession(
            exec: MetalVmExecutor.create(), source: "", code: [], step_budget: 0,
            entry_pc: 0, arena: [], data_off: 0, breaks: [], attached: false,
            profile_armed: false, profile_base_steps: 0, profiling: false,
            last: _empty_outcome(),
        )

    # Host capability probe forwarded from the executor/session, so a caller
    # can decide to SKIP before constructing anything device-side. Returns ""
    # when a live Metal device is usable, or "skip:<reason>". On Linux this
    # always returns "skip:metal-unavailable-not-macos".
    me probe() -> text:
        self.exec.probe()

    # `kernel_msl` is the checked-in svmg_metal_kernel.metal SOURCE TEXT (the
    # caller reads the file; this tier never touches the filesystem). Returns
    # "" on success, or the underlying error/skip string verbatim -- a
    # "skip:" prefix is passed through UNCHANGED so a caller can tell a
    # missing device apart from a real failure. It is never rewritten into a
    # generic error, and never swallowed into a fake success.
    me attach_kernel(kernel_msl: text, source: text, opts: AttachOpts) -> text:
        val init_err = self.exec.init(kernel_msl)
        if init_err != "":
            return init_err
        self.source = source
        self.code = svmg_asm(source)
        self.step_budget = opts.step_budget
        self.entry_pc = opts.entry_pc
        self.data_off = 0
        self.breaks = []
        self.profile_armed = opts.profile
        self.profile_base_steps = 0
        self.profiling = false
        # Fresh arena with DBG-1 armed. `build_svmg_arena` zeroes the whole
        # REG/LOG/RECORD/DBG region, so every DBG field starts at 0 and the
        # kernel's launch-time restore sees flags==ENABLED, resume unset.
        self.arena = build_svmg_arena(self.code, self.step_budget, self.entry_pc)
        self.attached = true
        self.last = _empty_outcome()
        ""

    # --- the one launch primitive everything else delegates to ---------
    me launch(resume: bool, single_step: bool, set_breakpoints: bool, breakpoints: [i64]) -> MetalDebugOutcome:
        if not self.attached:
            return _err_outcome(METAL_DEBUG_NOT_ATTACHED)
        if set_breakpoints:
            self.breaks = breakpoints
            self.arena = dbg_set_breakpoints(self.arena, breakpoints)
        var flags = DBG_FLAG_ENABLED
        if resume:
            flags = flags | DBG_FLAG_RESUME
        if single_step:
            flags = flags | DBG_FLAG_SINGLE_STEP
        self.arena = dbg_set_flags(self.arena, flags)

        val r = self.exec.run_source_persisting_data(
            self.source, self.step_budget, self.entry_pc, self.arena, self.data_off)
        if not r.ok:
            return _err_outcome(r.error)

        self.arena = r.out_arena
        self.data_off = r.data_off

        # Stop reason. The kernel writes SENTINEL_DEBUG_BREAK (0xCAFE00DB)
        # explicitly on a debug stop; it never infers one from an exit code.
        # On the host side the sentinel IS the wire signal, which is exactly
        # why exit code 0xDB is RESERVED (mailbox_const.spl) -- 0xCAFE00DB is
        # indistinguishable from a clean exit(0xDB), so no conformance
        # program may exit with that code, and NOTHING here may branch on
        # `exit_code` to detect a break.
        val dbg_break = r.sentinel == SENTINEL_DEBUG_BREAK
        val saved_sp = dbg_read_saved_sp(self.arena)
        val saved_csp = dbg_read_saved_csp(self.arena)
        var stack: [i64] = []
        var i = 0
        while i < saved_sp:
            stack.push(dbg_read_saved_stack_slot(self.arena, i))
            i = i + 1
        var calls: [i64] = []
        i = 0
        while i < saved_csp:
            calls.push(dbg_read_saved_call_slot(self.arena, i))
            i = i + 1

        val out = MetalDebugOutcome(
            ok: true, error: "",
            debug_break: dbg_break,
            # A debug stop is not a trap and not a timeout, even though the
            # executor's sentinel decoder only sees a 0xCAFE-family word.
            trapped: r.trapped and not dbg_break,
            timed_out: r.sentinel == SENTINEL_TIMEOUT,
            sentinel: r.sentinel,
            saved_pc: dbg_read_saved_pc(self.arena),
            saved_sp: saved_sp,
            saved_csp: saved_csp,
            stack: stack,
            calls: calls,
            step_count: dbg_read_step_count(self.arena),
            log_text: r.log_text,
            records: r.records,
        )
        self.last = out
        out

    me shutdown() -> text:
        self.attached = false
        self.exec.shutdown()

    # ---------------- DebugProfiler surface (P2 traits) ----------------
    # Every mutating method is `me`, never `fn`: a `fn` method receives a
    # COPY of the receiver and silently discards the mutation, which for a
    # debugger would mean a `step()` that never advances.
    fn kind() -> text:
        "metal"

    fn debug_level() -> CapLevel:
        # Emulated, not Native: breakpoints are SVM-G-level, maintained by
        # our own MSL kernel, not by Metal's own debug facilities (Xcode
        # GPU capture / MTLCaptureManager are not wired here at all).
        CapLevel.Emulated

    me set_breakpoint(loc: i64) -> bool:
        for b in self.breaks:
            if b == loc:
                return true
        var next = self.breaks
        next.push(loc)
        self.breaks = next
        self.arena = dbg_set_breakpoints(self.arena, next)
        true

    me clear_breakpoint(loc: i64) -> bool:
        var next: [i64] = []
        var found = false
        for b in self.breaks:
            if b == loc:
                found = true
            else:
                next.push(b)
        if not found:
            return false
        self.breaks = next
        self.arena = dbg_set_breakpoints(self.arena, next)
        true

    me breakpoints() -> [i64]:
        self.breaks

    me step() -> DebugState:
        val o = self.launch(true, true, false, [])
        _to_state(o, STOP_STEP)

    me resume() -> DebugState:
        val o = self.launch(true, false, false, [])
        _to_state(o, _stop_reason(o))

    me state() -> DebugState:
        _to_state(self.last, _stop_reason(self.last))

    me read_mem(offset: i64, len: i64) -> [u8]:
        var out: [u8] = []
        if offset < 0 or len <= 0:
            return out
        var i = 0
        while i < len and (offset + i) < self.arena.len():
            out.push(self.arena[offset + i])
            i = i + 1
        out

    me detach() -> text:
        self.shutdown()

    fn profile_level() -> CapLevel:
        # Emulated: DBG_STEP_COUNT is an exact instruction count maintained
        # by our kernel, NOT a device-timestamp measurement.
        CapLevel.Emulated

    me profile_begin():
        self.profile_base_steps = self.last.step_count
        self.profiling = true

    me profile_end() -> ProfileReport:
        val steps = self.last.step_count - self.profile_base_steps
        self.profiling = false
        # wall_ns and device_ns are PROFILE_ABSENT (-1), never 0. Zero is a
        # LEGITIMATE measurement, so reporting it for a quantity that was
        # never measured reads as "instantaneous" instead of "not measured"
        # -- exactly what profile_target.spl's contract forbids ("it is
        # exactly -1 -- never 0"). This class reads no host clock and creates
        # no MTLCounterSampleBuffer, so neither number exists. P7 found and
        # fixed this same zero-reporting bug in the CUDA session; it is not
        # reintroduced here.
        profile_report_new(
            CapLevel.Emulated,
            PROFILE_ABSENT,
            PROFILE_ABSENT,
            steps,
            METAL_PROFILE_DETAIL,
        )

fn _empty_outcome() -> MetalDebugOutcome:
    MetalDebugOutcome(
        ok: false, error: "", debug_break: false, trapped: false,
        timed_out: false, sentinel: 0, saved_pc: 0, saved_sp: 0, saved_csp: 0,
        stack: [], calls: [], step_count: 0, log_text: "", records: [],
    )

fn _err_outcome(err: text) -> MetalDebugOutcome:
    MetalDebugOutcome(
        ok: false, error: err, debug_break: false, trapped: false,
        timed_out: false, sentinel: 0, saved_pc: 0, saved_sp: 0, saved_csp: 0,
        stack: [], calls: [], step_count: 0, log_text: "", records: [],
    )

fn _to_state(o: MetalDebugOutcome, reason: text) -> DebugState:
    debug_state_new(o.saved_pc, PC_KIND_SVMG, o.saved_sp, o.stack, o.calls, reason)

# Single-accessor group acquisition (P2 design section 3): the DebugProfiler
# group is ONE trait over ONE value. Acquiring it by PAIRING a `debug()` and a
# `profile()` accessor would hand back two INDEPENDENT copies of the session
# (classes have value semantics here), so stepping the debug half would leave
# the profile half at zero steps.
#
# !! CALL-SITE CONSTRAINT -- READ BEFORE USING THIS ACCESSOR !!
# The returned handle STOPS ALIASING its target unless the acquisition is a
# function's TAIL EXPRESSION. Bind it to a local or stash it in a struct field
# or registry in the frame that built the session, and the handle half-dies in
# a way that is very hard to read as a host bug:
#   * `step()` / `resume()` KEEP WORKING, so the handle looks alive;
#   * `set_breakpoint()` and `profile_begin()` are SILENTLY DISCARDED --
#     breakpoints never arm and every profile reports zero steps, which reads
#     as "this backend cannot profile" rather than as a language defect.
# The container is irrelevant; only the acquisition's syntactic position
# matters, and writing the handle back does NOT fix it. See
# doc/08_tracking/bug/ref_debug_profiler_handle_stops_aliasing_unless_tail_expression_2026-08-09.md
#
# NOTE: neither `metal_debug_session_spec.spl` nor
# `metal_debug_session_conformance_spec.spl` goes through this accessor --
# both hold a CLASS-TYPED session directly and drive `launch`/`set_breakpoint`
# on it, so their results cannot be corrupted by the aliasing defect above.
pub fn metal_debug_profiler(session: MetalDebugSession) -> MetalDebugSession:
    session

export MetalDebugSession, MetalDebugOutcome, metal_debug_profiler
export METAL_PROFILE_DETAIL, METAL_DEBUG_NOT_ATTACHED
