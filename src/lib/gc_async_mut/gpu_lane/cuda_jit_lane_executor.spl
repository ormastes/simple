# cuda_jit lane executor -- GpuLaneExecutor for jit(remote(cuda(...))) (Task B2).
#
# Design: doc/05_design/runtime/gpu_remote_interpreter_architecture.md §5.1.
# Plan: doc/03_plan/agent_tasks/gpu_remote_interpreter_parallel_plan_2026-08-07.md
# (Stream B, task B2).
#
# Pipeline per §5.1:
#   1. Lower a test kernel via the EXISTING PTX emitter -- the same
#      frontend -> HIR -> MIR -> `CudaBackend` pipeline used by
#      `test/02_integration/rendering/cuda_compiler_ptx_live_spec.spl` -- and
#      validate the artifact structurally (SHA-256, `.target`, entry names)
#      per the ten-row negative table in
#      doc/03_plan/sys_test/cuda_host_validation_2026-07-11.md. This part is
#      pure text/host logic: no CUDA driver call, fully unit-testable on any
#      host (the "malformed PTX"/"nonexistent entry"/"rejected target" rows
#      of that table become deterministic FAIL, never SKIP).
#   2. Record the artifact (SHA-256/.target/entries) into a host-side GMB-1
#      `MailboxArena` LOG ring (A2) -- the lane's own bookkeeping log, kept
#      separate from CUDA device memory so it never depends on a live device.
#   3. `prepare()` probes/inits the B1 `CudaLaneSession`, loads the validated
#      PTX artifact, and resolves the entry.
#   4. `run_program()` uploads kernel operands into the B1 session's guarded
#      device arena, launches, syncs (via B1's `launch_once`), reads back,
#      and compares against a CPU oracle. On a verified match it appends a
#      GMB-1 RECORD (A2 `append_record`) and writes the GMB-1 EXIT sentinel
#      `0xCAFE0000 | 0` into the lane log arena; on mismatch it appends a
#      failing RECORD and returns `Err`.
#   5. `teardown()` shuts the B1 session down.

mod std.gc_async_mut.gpu_lane.cuda_jit_lane_executor

use std.test_runner.gpu_lane_common.{GpuLaneExecutor}
use std.gc_async_mut.gpu_lane.cuda_lane_session.{CudaLaneSession}
use std.nogc_sync_mut.test_runner.gpu_mailbox.{
    MailboxArena, ARENA_SIZE, SENTINEL_EXIT_MASK, ResultRecord,
    drain_log, drain_records}
use std.common.crypto.sha256.{sha256_text}
use std.common.base_encoding.{base_encoding_facade_text_to_bytes as text_to_bytes}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir.*
use compiler.backend.backend.cuda_backend.{CudaBackend}

extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)

# =========================================================================
# Test kernel source (the "hello" vector-add kernel B2's verify step needs).
# =========================================================================

val VECTOR_ADD_ENTRY: text = "vector_add"

fn vector_add_kernel_source() -> text:
    "@gpu(\"cuda\")\n" +
    "fn {VECTOR_ADD_ENTRY}(mut output: [u32], a: [u32], b: [u32], n: u32) -> ():\n" +
    "    val i = gpu_global_id(0)\n" +
    "    if i < n:\n" +
    "        output[i] = a[i] + b[i]\n"

# =========================================================================
# PtxArtifact -- SHA-256/.target/entries recorded per §5.1 step 1.
# =========================================================================

struct PtxArtifact:
    ptx: text
    sha256: text
    target: text
    entries: [text]

fn extract_ptx_target(ptx: text) -> text:
    """Parse the `.target sm_XX` line. "" if absent (malformed PTX)."""
    for line in ptx.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with(".target "):
            return trimmed[8:trimmed.len()].trim()
    ""

fn extract_ptx_entries(ptx: text) -> [text]:
    """Parse every `.visible .entry NAME(` declaration."""
    var out: [text] = []
    for line in ptx.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with(".visible .entry "):
            val rest = trimmed[16:trimmed.len()]
            val paren = rest.find("(")
            if paren >= 0:
                out = out.push(rest[0:paren].trim())
    out

fn ptx_has_header_markers(ptx: text) -> bool:
    """`.version`, `.target`, and `.address_size` are the three mandatory
    PTX module-header directives -- absence of any one is the
    "malformed PTX" row of the validation table."""
    ptx.contains(".version") and ptx.contains(".target") and ptx.contains(".address_size")

fn ptx_target_is_valid_sm(target: text) -> bool:
    """`sm_NN` where NN is 2+ ASCII digits -- rejects the "rejected
    target/version" row (garbage or missing arch token)."""
    if not target.starts_with("sm_"):
        return false
    val digits = target[3:target.len()]
    if digits.len() < 2:
        return false
    for ch in digits:
        if ch < "0" or ch > "9":
            return false
    true

fn validate_ptx_artifact(ptx: text, expected_entry: text) -> Result<PtxArtifact, text>:
    """Pure, host-independent structural validation -- no CUDA driver call.
    Every branch here is one row of the ten-row CUDA validation table
    (doc/03_plan/sys_test/cuda_host_validation_2026-07-11.md) and MUST
    produce FAIL (`Err`), never SKIP, regardless of host GPU availability."""
    if ptx.trim() == "":
        return Err("cuda-jit-ptx-empty")
    if not ptx_has_header_markers(ptx):
        return Err("cuda-jit-ptx-malformed-header")
    val target = extract_ptx_target(ptx)
    if target == "":
        return Err("cuda-jit-ptx-missing-target")
    if not ptx_target_is_valid_sm(target):
        return Err("cuda-jit-ptx-rejected-target")
    val entries = extract_ptx_entries(ptx)
    if entries.len() == 0:
        return Err("cuda-jit-ptx-no-entries")
    if not entries.contains(expected_entry):
        return Err("cuda-jit-ptx-nonexistent-entry")
    var seen: [text] = []
    for entry in entries:
        if seen.contains(entry):
            return Err("cuda-jit-ptx-duplicate-entry")
        seen = seen.push(entry)
    Ok(PtxArtifact(ptx: ptx, sha256: sha256_text(ptx), target: target, entries: entries))

# =========================================================================
# Lowering via the EXISTING PTX emitter -- reused, not reimplemented.
# =========================================================================

fn lower_vector_add_ptx() -> Result<text, text>:
    """Lower `vector_add_kernel_source()` to PTX through the SAME
    frontend -> HIR -> MIR -> `CudaBackend` pipeline as
    `cuda_compiler_ptx_live_spec.spl` -- no PTX text is hand-authored here."""
    val source = vector_add_kernel_source()
    val parsed = parse_full_frontend(source, "cuda_jit_lane_hello.spl", "cuda_jit_lane_hello", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("cuda_jit_lane_hello.spl")
    val hir = hir_lowering.lower_module(parsed)
    if hir_lowering.errors.len() > 0:
        return Err("cuda-jit-hir-lowering-failed")
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    if mir_lowering.errors.len() > 0:
        return Err("cuda-jit-mir-lowering-failed")
    val compiled = CudaBackend.create((8, 6)).compile(mir)
    if not compiled.is_ok():
        return Err("cuda-jit-backend-compile-failed")
    Ok(compiled.unwrap().ptx)

# =========================================================================
# Lane log line + LOG ring recording (§5.1 step: "record ... in the lane log")
# =========================================================================

fn format_lane_log_line(artifact: PtxArtifact) -> text:
    val entry_list = artifact.entries.join(",")
    "ptx sha256={artifact.sha256} target={artifact.target} entries=[{entry_list}]\n"

fn record_artifact_in_lane_log(arena: MailboxArena, artifact: PtxArtifact):
    """Append `format_lane_log_line` to the arena's LOG ring one byte at a
    time via A2's `append_log_byte` (the same byte-at-a-time contract the
    device-simulation helper uses, so `drain_log` round-trips it exactly)."""
    for byte in text_to_bytes(format_lane_log_line(artifact)):
        arena.append_log_byte(byte)

# =========================================================================
# CudaJitLaneExecutor -- GpuLaneExecutor for jit(remote(cuda(...)))
# =========================================================================

class CudaJitLaneExecutor:
    session: CudaLaneSession
    lane_log: MailboxArena
    artifact_sha256: text
    artifact_target: text
    prepared: bool
    next_seq: i64

    static fn create() -> CudaJitLaneExecutor:
        val lane_log = MailboxArena.new(ARENA_SIZE)
        lane_log.init_log_ring(0x1000)
        lane_log.init_record_ring(16)
        CudaJitLaneExecutor(
            session: CudaLaneSession.create(),
            lane_log: lane_log,
            artifact_sha256: "", artifact_target: "",
            prepared: false, next_seq: 0)

    me prepare(session_id: text) -> Result<bool, text>:
        val probe = self.session.probe()
        if probe != "":
            return Err(probe)
        val ptx_result = lower_vector_add_ptx()
        if not ptx_result.is_ok():
            return Err(ptx_result.unwrap_err())
        val validated = validate_ptx_artifact(ptx_result.unwrap(), VECTOR_ADD_ENTRY)
        if not validated.is_ok():
            return Err(validated.unwrap_err())
        val artifact = validated.unwrap()
        record_artifact_in_lane_log(self.lane_log, artifact)
        self.artifact_sha256 = artifact.sha256
        self.artifact_target = artifact.target
        val init_result = self.session.init()
        if init_result != "":
            return Err(init_result)
        val load_result = self.session.load_entry(text_to_bytes(artifact.ptx), VECTOR_ADD_ENTRY)
        if load_result != "":
            return Err(load_result)
        self.prepared = true
        Ok(true)

    # `blob` encodes the vector length as a little-endian u32; empty blob
    # defaults to 8 elements (the "hello" smoke size).
    me run_program(blob: [u8]) -> Result<[u8], text>:
        if not self.prepared:
            return Err("cuda-jit-not-prepared")
        val n = if blob.len() >= 4:
            (blob[0].to_i64()) | (blob[1].to_i64() << 8) | (blob[2].to_i64() << 16) | (blob[3].to_i64() << 24)
        else:
            8
        if n <= 0 or n * 4 * 3 > self.session.arena_capacity:
            return Err("cuda-jit-vector-length-invalid")

        var data: [u8] = []
        var i: i64 = 0
        while i < n:
            data = data.push((i & 0xFF).to_u8())
            data = data.push(((i >> 8) & 0xFF).to_u8())
            data = data.push(0u8)
            data = data.push(0u8)
            i = i + 1
        i = 0
        while i < n:
            val bv = 2 * i
            data = data.push((bv & 0xFF).to_u8())
            data = data.push(((bv >> 8) & 0xFF).to_u8())
            data = data.push(0u8)
            data = data.push(0u8)
            i = i + 1
        i = 0
        while i < n:
            data = data.push(0u8)
            data = data.push(0u8)
            data = data.push(0u8)
            data = data.push(0u8)
            i = i + 1

        if not self.session.arena_write(data):
            self._record_fail("cuda-jit-arena-write-failed")
            return Err("cuda-jit-arena-write-failed")

        val out_dev = self.session.arena_ptr + 2 * n * 4
        val a_dev = self.session.arena_ptr
        val b_dev = self.session.arena_ptr + n * 4

        val values = rt_alloc(32)
        val args = rt_alloc(32)
        if values == 0 or args == 0:
            if values != 0: rt_free(values)
            if args != 0: rt_free(args)
            self._record_fail("cuda-jit-args-alloc-failed")
            return Err("cuda-jit-args-alloc-failed")
        rt_ptr_write_i64(values, 0, out_dev)
        rt_ptr_write_i64(values, 8, a_dev)
        rt_ptr_write_i64(values, 16, b_dev)
        rt_ptr_write_i64(values, 24, n)
        rt_ptr_write_i64(args, 0, values + 0)
        rt_ptr_write_i64(args, 8, values + 8)
        rt_ptr_write_i64(args, 16, values + 16)
        rt_ptr_write_i64(args, 24, values + 24)

        val block_x = if n < 32: n else: 32
        val launch_result = self.session.launch_once(1, block_x, args)
        rt_free(values)
        rt_free(args)
        if launch_result != "":
            self._record_fail(launch_result)
            return Err(launch_result)

        val readback = self.session.arena_read(3 * n * 4)
        if readback.len() != 3 * n * 4:
            self._record_fail("cuda-jit-readback-short")
            return Err("cuda-jit-readback-short")

        var mismatch = false
        i = 0
        while i < n:
            val out_off = 2 * n * 4 + i * 4
            val actual = readback[out_off].to_i64()
            val expected = (i + 2 * i) & 0xFF
            if actual != expected:
                mismatch = true
            i = i + 1

        if mismatch:
            self._record_fail("cuda-jit-oracle-mismatch")
            return Err("cuda-jit-oracle-mismatch")

        self.lane_log.append_record(self.next_seq.to_u32(), 1u32, n)
        self.next_seq = self.next_seq + 1
        self.lane_log.set_u32(0x08000, SENTINEL_EXIT_MASK)
        Ok(readback)

    me _record_fail(reason: text):
        self.lane_log.append_record(self.next_seq.to_u32(), 0u32, 0)
        self.next_seq = self.next_seq + 1

    me fn lane_log_text() -> text:
        drain_log(self.lane_log)

    me fn lane_log_records() -> [ResultRecord]:
        drain_records(self.lane_log)

    me fn lane_sentinel() -> u32:
        self.lane_log.get_u32(0x08000)

    me teardown() -> bool:
        self.session.shutdown() == ""

export VECTOR_ADD_ENTRY, vector_add_kernel_source
export PtxArtifact
export extract_ptx_target, extract_ptx_entries
export ptx_has_header_markers, ptx_target_is_valid_sm
export validate_ptx_artifact, lower_vector_add_ptx
export format_lane_log_line, record_artifact_in_lane_log
export CudaJitLaneExecutor
