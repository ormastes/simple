@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# GPU Operations — high-level API, intrinsics, typed transfers, BLAS/Thrust stubs

use gc_async_mut.gpu_sffi.{
    cuda_init,
    cuda_mem_alloc,
    cuda_mem_free,
    cuda_memcpy_htod,
    cuda_memcpy_dtoh,
    cuda_memcpy_dtod,
    cuda_memset,
    cuda_memset_d32,
    cuda_launch_kernel,
    cuda_sync,
    cuda_device_get,
    cuda_device_count,
    cuda_device_name,
    cuda_device_compute_capability,
    cuda_ctx_create
}
use gc_async_mut.gpu_types.{GpuError, GpuPtr, GpuModule, GpuLaunchConfig}
use std.common.binary_io.{f32_to_bits, f32_from_bits, f64_to_bits, f64_from_bits}

# Raw host scratch for typed transfers. A boxed `[T]` has NO contiguous
# element storage: `.data_ptr()` on it returns the address of the interpreter's
# Vec<Value> (tag+payload slots), so a byte memcpy into it corrupts Value tags
# and the next index SEGVs. Stage through rt_alloc'd bytes instead (same route
# as gpu_lane/cuda_lane_session.spl).
extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_ptr_read_i32(addr: i64, offset: i64) -> i32
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
extern fn rt_ptr_write_i32(addr: i64, offset: i64, value: i32)
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)

# ============================================================================
# Top-Level API Functions
# ============================================================================

fn gpu_status(result: i64) -> Result<(), GpuError>:
    """Map a CUDA driver status word to a Result.

    CUDA_SUCCESS is 0 and every CUresult error enumerator is NON-ZERO
    (CUDA_ERROR_INVALID_VALUE = 1, CUDA_ERROR_OUT_OF_MEMORY = 2,
    CUDA_ERROR_NOT_INITIALIZED = 3, ...), so failure is `result != 0`.

    The runtime hooks behind these wrappers are inconsistent about sign: some
    negate the driver status, some return it raw. Every wrapper used to inline
    its own `result < 0` test, which silently accepted the raw-positive
    failures as success. Observed live on a 2x NVIDIA box: cuda_init()
    returned 3 while gpu_init() returned Ok. Keep the comparison here, once.
    """
    if result != 0:
        return Err(GpuError.from_code(result))
    Ok(())

fn gpu_init() -> Result<(), GpuError>:
    """Initialize the GPU runtime. Must be called before any other GPU operations."""
    gpu_status(cuda_init())

fn gpu_alloc(size: i64) -> Result<GpuPtr, GpuError>:
    """Allocate device memory of given size in bytes."""
    val ptr = cuda_mem_alloc(size)
    if ptr < 0:
        return Err(GpuError.from_code(ptr))
    Ok(GpuPtr(device_ptr: ptr, size: size, is_valid: true))

fn gpu_free(gpu_ptr: GpuPtr) -> Result<(), GpuError>:
    """Free device memory."""
    if gpu_ptr.is_null():
        return Ok(())
    gpu_status(cuda_mem_free(gpu_ptr.device_ptr))

fn gpu_upload(gpu_ptr: GpuPtr, host_ptr: i64, size: i64) -> Result<(), GpuError>:
    """Copy data from host memory to device memory."""
    gpu_status(cuda_memcpy_htod(gpu_ptr.device_ptr, host_ptr, size))

fn gpu_download(gpu_ptr: GpuPtr, host_ptr: i64, size: i64) -> Result<(), GpuError>:
    """Copy data from device memory to host memory."""
    gpu_status(cuda_memcpy_dtoh(host_ptr, gpu_ptr.device_ptr, size))

fn gpu_memset(gpu_ptr: GpuPtr, value: i64, size: i64) -> Result<(), GpuError>:
    """Set device memory to a value.

    BYTE granularity (CUDA cuMemsetD8_v2): `value` is truncated to one byte and
    `size` is a BYTE count. Only correct when the intended fill is byte-uniform.
    For 32-bit element fills use gpu_memset_d32.
    """
    gpu_status(cuda_memset(gpu_ptr.device_ptr, value, size))

fn gpu_i32_fill_pattern(value: i64) -> i64:
    """The 32-bit word an i32 fill of `value` must write.

    Two's-complement low 32 bits, so -1 becomes 0xFFFFFFFF. Split out from the
    memset wrappers so the granularity contract is directly testable without a
    device.
    """
    value & 0xFFFFFFFF

fn gpu_f32_fill_pattern(value: f32) -> i64:
    """The 32-bit word an f32 fill of `value` must write.

    This is the IEEE-754 single-precision bit pattern, NOT a numeric conversion:
    filling with 3.14f must write 0x4048F5C3 into each element. That pattern is
    not byte-uniform, which is exactly why no cuMemsetD8 call can express an f32
    fill at any value -- it needs cuMemsetD32_v2 plus this bitcast.

    Split out from the memset wrapper so the conversion is directly testable
    against the IEEE-754 oracle without a device.
    """
    f32_to_bits(value) as i64

fn gpu_memset_d32(gpu_ptr: GpuPtr, pattern: i64, count: i64) -> Result<(), GpuError>:
    """Fill device memory with a 32-bit pattern (CUDA cuMemsetD32_v2).

    `count` is a number of 32-BIT ELEMENTS, NOT bytes. Passing a byte count here
    would write four times past the buffer.
    """
    gpu_status(cuda_memset_d32(gpu_ptr.device_ptr, pattern, count))

fn gpu_launch(module: GpuModule, func_name: text, config: GpuLaunchConfig, args_ptr: i64) -> Result<(), GpuError>:
    """Launch a GPU kernel with the given configuration."""
    val result = cuda_launch_kernel(
        module.handle,
        func_name,
        config.grid_x,
        config.grid_y,
        config.grid_z,
        config.block_x,
        config.block_y,
        config.block_z,
        args_ptr
    )
    gpu_status(result)

fn gpu_sync() -> Result<(), GpuError>:
    """Synchronize the device - wait for all pending operations to complete."""
    gpu_status(cuda_sync())

# ============================================================================
# Device Info Wrappers
# ============================================================================

fn gpu_device_name(device_id: i64) -> text:
    """Get GPU device name by ID."""
    cuda_device_name(cuda_device_get(device_id))

fn gpu_device_compute_capability(device_id: i64) -> (i64, i64):
    """Get compute capability as (major, minor) tuple."""
    val cap = cuda_device_compute_capability(cuda_device_get(device_id))
    (cap / 10, cap % 10)

fn gpu_device_total_memory(device_id: i64) -> i64:
    """Get total device memory in bytes.
    Note: Returns 0 until memory query SFFI is added."""
    0

fn gpu_set_device(device_id: i64) -> Result<(), GpuError>:
    """Set the active GPU device (creates context)."""
    val handle = cuda_ctx_create(cuda_device_get(device_id))
    if handle < 0:
        return Err(GpuError.from_code(handle))
    Ok(())

fn gpu_device_count() -> i64:
    """Get number of available GPU devices."""
    cuda_device_count()

# ============================================================================
# Typed Memory Transfer
# ============================================================================

fn _gpu_upload_words(gpu_ptr: GpuPtr, words: [i64], width: i64) -> Result<(), GpuError>:
    """Upload raw 32/64-bit words via an rt_alloc'd host staging buffer."""
    val n = words.len()
    if n == 0:
        return Ok(())
    val host = rt_alloc(n * width)
    for i in 0..n:
        if width == 4:
            rt_ptr_write_i32(host, i * 4, words[i] as i32)
        else:
            rt_ptr_write_i64(host, i * 8, words[i])
    val r = gpu_upload(gpu_ptr, host, n * width)
    rt_free(host)
    r

fn _gpu_download_words(gpu_ptr: GpuPtr, count: i64, width: i64) -> Result<[i64], GpuError>:
    """Download raw 32/64-bit words via an rt_alloc'd host staging buffer."""
    if count <= 0:
        return Ok([])
    val host = rt_alloc(count * width)
    val r = gpu_download(gpu_ptr, host, count * width)
    var out: [i64] = []
    if r.is_ok():
        for i in 0..count:
            if width == 4:
                out.push(rt_ptr_read_i32(host, i * 4) as i64)
            else:
                out.push(rt_ptr_read_i64(host, i * 8))
    rt_free(host)
    match r:
        case Ok(_):
            Ok(out)
        case Err(e):
            Err(e)

fn gpu_upload_f32(gpu_ptr: GpuPtr, data: [f32]) -> Result<(), GpuError>:
    """Upload f32 array from host to device."""
    var words: [i64] = []
    for x in data:
        words.push(f32_to_bits(x) as i64)
    _gpu_upload_words(gpu_ptr, words, 4)

fn gpu_download_f32(gpu_ptr: GpuPtr, count: i64) -> Result<[f32], GpuError>:
    """Download f32 array from device to host."""
    match _gpu_download_words(gpu_ptr, count, 4):
        case Ok(words):
            var result: [f32] = []
            for w in words:
                result.push(f32_from_bits((w & 0xFFFFFFFF) as u32))
            Ok(result)
        case Err(e):
            Err(e)

fn gpu_upload_i32(gpu_ptr: GpuPtr, data: [i32]) -> Result<(), GpuError>:
    """Upload i32 array from host to device."""
    var words: [i64] = []
    for x in data:
        words.push(x as i64)
    _gpu_upload_words(gpu_ptr, words, 4)

fn gpu_upload_i64(gpu_ptr: GpuPtr, data: [i64]) -> Result<(), GpuError>:
    """Upload i64 array from host to device."""
    _gpu_upload_words(gpu_ptr, data, 8)

fn gpu_upload_f64(gpu_ptr: GpuPtr, data: [f64]) -> Result<(), GpuError>:
    """Upload f64 array from host to device."""
    var words: [i64] = []
    for x in data:
        words.push(f64_to_bits(x) as i64)
    _gpu_upload_words(gpu_ptr, words, 8)

fn gpu_download_i32(gpu_ptr: GpuPtr, count: i64) -> Result<[i32], GpuError>:
    """Download i32 array from device to host."""
    match _gpu_download_words(gpu_ptr, count, 4):
        case Ok(words):
            var result: [i32] = []
            for w in words:
                result.push(w as i32)
            Ok(result)
        case Err(e):
            Err(e)

fn gpu_download_i64(gpu_ptr: GpuPtr, count: i64) -> Result<[i64], GpuError>:
    """Download i64 array from device to host."""
    _gpu_download_words(gpu_ptr, count, 8)

fn gpu_download_f64(gpu_ptr: GpuPtr, count: i64) -> Result<[f64], GpuError>:
    """Download f64 array from device to host."""
    match _gpu_download_words(gpu_ptr, count, 8):
        case Ok(words):
            var result: [f64] = []
            for w in words:
                result.push(f64_from_bits(w as u64))
            Ok(result)
        case Err(e):
            Err(e)

# ============================================================================
# Typed Allocation
# ============================================================================

fn gpu_alloc_f32(count: i64) -> Result<GpuPtr, GpuError>:
    """Allocate f32 device memory by element count."""
    gpu_alloc(count * 4)

fn gpu_alloc_i32(count: i64) -> Result<GpuPtr, GpuError>:
    """Allocate i32 device memory by element count."""
    gpu_alloc(count * 4)

fn gpu_alloc_i64(count: i64) -> Result<GpuPtr, GpuError>:
    """Allocate i64 device memory by element count."""
    gpu_alloc(count * 8)

fn gpu_alloc_f64(count: i64) -> Result<GpuPtr, GpuError>:
    """Allocate f64 device memory by element count."""
    gpu_alloc(count * 8)

# ============================================================================
# Typed Memset/Copy
# ============================================================================

fn gpu_memset_f32(ptr: GpuPtr, value: f32, count: i64) -> Result<(), GpuError>:
    """Fill `count` f32 elements with `value`.

    The old body was `gpu_memset(ptr, 0, count * 4)`: it never read `value` at
    all, filled the buffer with zeros, and still returned Ok(()). Routed through
    the 32-bit primitive with the IEEE-754 bit pattern of `value`.
    """
    gpu_memset_d32(ptr, gpu_f32_fill_pattern(value), count)

fn gpu_memset_i32(ptr: GpuPtr, value: i64, count: i64) -> Result<(), GpuError>:
    """Fill `count` i32 elements with `value`.

    Routed through the 32-bit primitive: the old byte-granularity path wrote
    `value` into every BYTE, so a request for 1 filled each i32 with 0x01010101
    (16843009) and still returned Ok(()).
    """
    gpu_memset_d32(ptr, gpu_i32_fill_pattern(value), count)

fn gpu_copy_f32(dst: GpuPtr, src: GpuPtr, count: i64) -> Result<(), GpuError>:
    """Copy f32 device memory between buffers."""
    gpu_status(cuda_memcpy_dtod(dst.device_ptr, src.device_ptr, count * 4))

fn gpu_copy_i32(dst: GpuPtr, src: GpuPtr, count: i64) -> Result<(), GpuError>:
    """Copy i32 device memory between buffers."""
    gpu_status(cuda_memcpy_dtod(dst.device_ptr, src.device_ptr, count * 4))

fn gpu_copy(dst: GpuPtr, src: GpuPtr, bytes: i64) -> Result<(), GpuError>:
    """Copy bytes between device buffers."""
    gpu_status(cuda_memcpy_dtod(dst.device_ptr, src.device_ptr, bytes))

# ============================================================================
# GPU Intrinsic Stubs (interpreter mode)
# These are recognized as intrinsics by the MIR->PTX backend at compile time
# (backends replace the calls), so the host bodies below only execute on the
# CPU path. They read executor state so cpu_kernel_run_1d (W4.1) can run any
# kernel-shaped function over a real 1D ndrange; at rest the state holds the
# single-thread defaults (ids 0, dims 1) the old constant stubs returned.
# ============================================================================

var _exec_block_id_x = 0
var _exec_local_id_x = 0
var _exec_block_dim_x = 1
var _exec_grid_dim_x = 1
var _exec_block_id_y = 0
var _exec_local_id_y = 0
var _exec_block_dim_y = 1
var _exec_grid_dim_y = 1
var _exec_block_id_z = 0
var _exec_local_id_z = 0
var _exec_block_dim_z = 1
var _exec_grid_dim_z = 1

fn gpu_block_id_x() -> i64:
    """Block ID in X dimension. PTX: %ctaid.x"""
    _exec_block_id_x

fn gpu_block_id_y() -> i64:
    """Block ID in Y dimension. PTX: %ctaid.y"""
    _exec_block_id_y

fn gpu_block_id_z() -> i64:
    """Block ID in Z dimension. PTX: %ctaid.z"""
    _exec_block_id_z

fn gpu_block_dim_x() -> i64:
    """Block dimension in X. PTX: %ntid.x"""
    _exec_block_dim_x

fn gpu_block_dim_y() -> i64:
    """Block dimension in Y. PTX: %ntid.y"""
    _exec_block_dim_y

fn gpu_block_dim_z() -> i64:
    """Block dimension in Z. PTX: %ntid.z"""
    _exec_block_dim_z

fn gpu_local_id_x() -> i64:
    """Thread ID within block, X. PTX: %tid.x"""
    _exec_local_id_x

fn gpu_local_id_y() -> i64:
    """Thread ID within block, Y. PTX: %tid.y"""
    _exec_local_id_y

fn gpu_local_id_z() -> i64:
    """Thread ID within block, Z. PTX: %tid.z"""
    _exec_local_id_z

fn gpu_thread_id_x() -> i64:
    """Alias for thread ID within block, X. PTX: %tid.x"""
    gpu_local_id_x()

fn gpu_thread_id_y() -> i64:
    """Alias for thread ID within block, Y. PTX: %tid.y"""
    gpu_local_id_y()

fn gpu_thread_id_z() -> i64:
    """Alias for thread ID within block, Z. PTX: %tid.z"""
    gpu_local_id_z()

fn gpu_grid_dim_x() -> i64:
    """Grid dimension in X. PTX: %nctaid.x"""
    _exec_grid_dim_x

fn gpu_grid_dim_y() -> i64:
    """Grid dimension in Y. PTX: %nctaid.y"""
    _exec_grid_dim_y

fn gpu_grid_dim_z() -> i64:
    """Grid dimension in Z. PTX: %nctaid.z"""
    _exec_grid_dim_z

fn gpu_global_id_x() -> i64:
    """Global thread ID in X = blockIdx.x * blockDim.x + threadIdx.x"""
    _exec_block_id_x * _exec_block_dim_x + _exec_local_id_x

fn gpu_global_id_y() -> i64:
    """Global thread ID in Y = blockIdx.y * blockDim.y + threadIdx.y"""
    _exec_block_id_y * _exec_block_dim_y + _exec_local_id_y

fn gpu_global_id_z() -> i64:
    """Global thread ID in Z = blockIdx.z * blockDim.z + threadIdx.z"""
    _exec_block_id_z * _exec_block_dim_z + _exec_local_id_z

fn gpu_syncthreads():
    """Synchronize threads within a block. PTX: bar.sync 0"""
    pass_dn

fn gpu_barrier():
    """Block-level barrier synchronization."""
    pass_dn

fn cpu_kernel_run_1d(total: i64, block_size: i64, kernel: fn()) -> i64:
    """Generic CPU executor (W4.1): run a kernel-shaped function over a 1D
    ndrange. While kernel() runs, gpu_block_id_x/gpu_local_id_x/
    gpu_block_dim_x/gpu_grid_dim_x/gpu_global_id_x reflect the current
    work-item, so the same body that compiles to PTX/OpenCL executes
    correctly on the host. Tail items beyond total are not invoked.

    Serial semantics: kernels that exchange data across threads via shared
    memory + gpu_syncthreads are NOT supported on this path (syncthreads is
    a no-op when execution is one item at a time).

    Returns the number of work-items executed (0 for invalid shapes).
    """
    if total <= 0 or block_size <= 0:
        return 0
    val blocks = (total + block_size - 1) / block_size
    _exec_grid_dim_x = blocks
    _exec_block_dim_x = block_size
    var executed = 0
    var b = 0
    while b < blocks:
        _exec_block_id_x = b
        var t = 0
        while t < block_size:
            if b * block_size + t < total:
                _exec_local_id_x = t
                kernel()
                executed = executed + 1
            t = t + 1
        b = b + 1
    _exec_block_id_x = 0
    _exec_local_id_x = 0
    _exec_block_dim_x = 1
    _exec_grid_dim_x = 1
    executed

# TODO: (gpu) model shared-memory exchange and a real gpu_syncthreads barrier in this
# executor -- run a block cooperatively instead of one work-item at a time -- so tiled
# reduction and transpose kernels can be verified without a device.
fn gpu_launch_emulated(grid: (i64, i64, i64), block: (i64, i64, i64), kernel: fn()) -> i64:
    """3-D CPU executor: the host meaning of `kernel<<<grid: g, block: b>>>(args)`.
    Runs `kernel` once per work-item of a grid x block ndrange, serially, with
    gpu_block_id_{x,y,z} / gpu_local_id_{x,y,z} / gpu_block_dim_* / gpu_grid_dim_*
    / gpu_global_id_* reflecting the current item -- the same body that lowers
    to PTX runs unchanged on the host. Serial semantics: shared-memory exchange
    across threads plus gpu_syncthreads is NOT modelled (syncthreads is a
    no-op). Returns the number of work-items executed (0 for invalid shapes).
    Interpreter-mode `<<<>>>` desugars to this function (plan E3)."""
    val (gx, gy, gz) = grid
    val (bx, by, bz) = block
    if gx <= 0 or gy <= 0 or gz <= 0 or bx <= 0 or by <= 0 or bz <= 0:
        return 0
    _exec_grid_dim_x = gx
    _exec_grid_dim_y = gy
    _exec_grid_dim_z = gz
    _exec_block_dim_x = bx
    _exec_block_dim_y = by
    _exec_block_dim_z = bz
    var executed = 0
    var cz = 0
    while cz < gz:
        _exec_block_id_z = cz
        var cy = 0
        while cy < gy:
            _exec_block_id_y = cy
            var cx = 0
            while cx < gx:
                _exec_block_id_x = cx
                var tz = 0
                while tz < bz:
                    _exec_local_id_z = tz
                    var ty = 0
                    while ty < by:
                        _exec_local_id_y = ty
                        var tx = 0
                        while tx < bx:
                            _exec_local_id_x = tx
                            kernel()
                            executed = executed + 1
                            tx = tx + 1
                        ty = ty + 1
                    tz = tz + 1
                cx = cx + 1
            cy = cy + 1
        cz = cz + 1
    _exec_block_id_x = 0
    _exec_block_id_y = 0
    _exec_block_id_z = 0
    _exec_local_id_x = 0
    _exec_local_id_y = 0
    _exec_local_id_z = 0
    _exec_block_dim_x = 1
    _exec_block_dim_y = 1
    _exec_block_dim_z = 1
    _exec_grid_dim_x = 1
    _exec_grid_dim_y = 1
    _exec_grid_dim_z = 1
    executed

fn gpu_load_f32(ptr: GpuPtr, index: i64) -> f32:
    """Load f32 from device memory at index. PTX: ld.global.f32"""
    0.0

fn gpu_store_f32(ptr: GpuPtr, index: i64, value: f32):
    """Store f32 to device memory at index. PTX: st.global.f32"""
    pass_dn

fn gpu_atomic_add_i64(ptr: GpuPtr, index: i64, value: i64) -> i64:
