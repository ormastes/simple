    0

fn gpu_atomic_cas_i64(ptr: GpuPtr, index: i64, compare: i64, value: i64) -> i64:
    """Atomic compare-and-swap on device memory. PTX: atom.global.cas.b64"""
    0

fn gpu_load_f64(ptr: i64, index: i64) -> f64:
    """Load f64 from device memory at index. PTX: ld.global.f64"""
    0.0

fn gpu_store_f64(ptr: i64, index: i64, value: f64):
