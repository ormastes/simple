# @gc — module uses GC runtime
#
# Video input for chat: turn one encoded video into a few still JPEG frames the
# model's image projector can take (design §4). slang decodes no video
# container of its own, so the frame source is an ffmpeg the OPERATOR points at
# with SLANG_FFMPEG; with none configured video stays refused (serving_chat).
#
# The video is written to a temp file with an unguessable name, ffmpeg is run
# once for its duration and frame rate and once to emit up to `n` distinct
# frames as an mjpeg image2pipe stream, and the stream is split on the JPEG
# SOI/EOI markers. The temp file is removed on every path after it is written.
#
# Frame selection (video_frame_filter): with a known duration d, frame k is the
# source frame that is showing at (k + 0.5) * d / n, the middle of its interval,
# not t = 0. ffmpeg's `select` passes each source frame at most once and
# `-fps_mode passthrough` stops the muxer from duplicating it, so a clip with
# fewer frames than `n` (a one-frame clip) yields each frame once. With an
# unknown duration, one frame per second is decoded for the first
# VIDEO_UNKNOWN_SCAN seconds and `n` of them are picked evenly; a longer clip
# with no duration in its container is only sampled over that first stretch.
# `-fps_mode` needs ffmpeg 5.1 or newer (ffmpeg 9 removed the old `-vsync`).

use std.common.encoding.external_text.{bytes_to_text_checked}
use std.io_runtime.{time_now_unix_micros}
use std.gc_async_mut.slang.host.slang_host.{host_env, host_file_write_bytes, host_file_delete, host_temp_dir, host_random_hex, host_run_bounded_bytes}

const VIDEO_DEFAULT_FRAMES: i64 = 4
const VIDEO_MAX_FRAMES: i64 = 32
# Decoded size of a video slang will take. Matches the HTTP layer's 10 MiB body
# limit, so an in-process caller is held to the same bound a client is.
const VIDEO_MAX_BYTES: i64 = 10485760
const VIDEO_TIMEOUT_MS: i64 = 30000
# rt_process_run_bounded_bytes refuses a cap above 16 MiB and then never spawns
# (env_process.rs / runtime_process.c), so stay at that hard limit. 64 frames
# at 384px mjpeg q4 are far below it.
const VIDEO_MAX_OUTPUT_BYTES: i64 = 16777216
# Video parts one request may carry: each one costs two ffmpeg runs.
const VIDEO_MAX_PARTS: i64 = 1
# Prefix of a sample_frames reason that is the server's fault (temp file,
# spawn, timeout), not the client's input; callers answer it 503, not 400.
const VIDEO_SERVER_FAULT: text = "server: "
# Long edge of a sampled frame: small enough that n frames fit a small VLM's
# context, large enough for it to read the scene.
const VIDEO_FRAME_EDGE: i64 = 384
# Seconds (at one frame per second) decoded when the duration is unknown.
const VIDEO_UNKNOWN_SCAN: i64 = 64

# The ffmpeg executable path, or "" when video sampling is not configured.
fn video_ffmpeg_path() -> text:
    host_env("SLANG_FFMPEG").trim()

fn video_max_bytes() -> i64:
    VIDEO_MAX_BYTES

fn video_max_parts() -> i64:
    VIDEO_MAX_PARTS

# True when an ffmpeg run failed for a server reason, not because of the input.
# Exit -1 is what every rt_process_run_bounded_bytes lane reports for a spawn
# failure, a timeout (C and Rust runtimes carry no marker on the bytes path) and
# a signal kill, so it is always the server's fault, whatever was written first.
# The interpreter lane appends "Process timed out"; the text lane's
# "[TIMEOUT: ...]" marker is accepted too. Any OTHER negative exit is ffmpeg's
# own AVERROR (e.g. -1094995529, INVALIDDATA, on Windows) for a corrupt client
# video: the client's fault.
fn video_run_is_server_fault(exit_code: i64, stderr_text: text) -> bool:
    if exit_code == -1:
        return true
    stderr_text.contains("Process timed out") or stderr_text.contains("[TIMEOUT: Process killed after")

# True when a sample_frames reason is a server fault rather than bad input.
fn video_reason_is_server_fault(reason: text) -> bool:
    reason.starts_with(VIDEO_SERVER_FAULT)

# Frames taken per video: SLANG_VIDEO_FRAMES, default 4, clamped to 1..32.
fn video_frame_count() -> i64:
    val raw = host_env("SLANG_VIDEO_FRAMES").trim()
    var n = VIDEO_DEFAULT_FRAMES
    if raw != "":
        match raw.parse_i64():
            case Some(parsed):
                if parsed > 0:
                    n = parsed
            case None: ()
    if n > VIDEO_MAX_FRAMES:
        n = VIDEO_MAX_FRAMES
    n

fn _run_ffmpeg(exe: text, args: [text]) -> ([u8], [u8], i64):
    host_run_bounded_bytes(exe, args, VIDEO_TIMEOUT_MS, VIDEO_MAX_OUTPUT_BYTES)

# Temp file for one video: an OS-random component, so another local user can
# neither predict the name nor plant a file there first.
fn video_temp_path(dir: text) -> text:
    dir + "/slang_video_" + host_random_hex() + "_" + time_now_unix_micros().to_text() + ".bin"

# Seconds from the "Duration: HH:MM:SS.cc" line ffmpeg prints for `-i` alone;
# 0 when it prints none (a stream with no known duration).
fn _duration_seconds(banner: text) -> f64:
    val at = banner.find("Duration: ")
    if at < 0:
        return 0.0
    val clock = banner.slice(at + 10, at + 21)
    val fields = clock.split(":")
    if fields.len() != 3:
        return 0.0
    match (fields[0].parse_f64(), fields[1].parse_f64(), fields[2].parse_f64()):
        case (Some(h), Some(m), Some(s)):
            h * 3600.0 + m * 60.0 + s
        case _:
            0.0

# Frame rate from the "..., 25 fps, ..." of ffmpeg's stream line; 0 if absent.
fn video_fps_from_banner(banner: text) -> f64:
    val at = banner.find(" fps")
    if at < 0:
        return 0.0
    var start = at
    while start > 0 and banner[start - 1:start] != " ":
        start = start - 1
    match banner.slice(start, at).parse_f64():
        case Some(fps):
            if fps > 0.0: fps else: 0.0
        case None:
            0.0

# Fixed-point seconds with 6 decimals ("0.062500", "-0.035000"): an ffmpeg
# expression must never receive exponent notation.
fn video_seconds_text(seconds: f64) -> text:
    val rounding = if seconds < 0.0: -0.5 else: 0.5
    var micros = (seconds * 1000000.0 + rounding).to_i64()
    var sign = ""
    if micros < 0:
        sign = "-"
        micros = 0 - micros
    var frac = (micros % 1000000).to_text()
    while frac.len() < 6:
        frac = "0" + frac
    sign + (micros / 1000000).to_text() + "." + frac

# The -vf chain for `n` frames of a clip of `seconds` at `fps` (0 = unknown).
# Target k is (k + 0.5) * seconds / n; a frame is passed when it starts at or
# after the target minus one frame time, i.e. it is the frame on screen at the
# target. Without a known fps the tolerance is half an interval, so the first
# frame always qualifies.
fn video_frame_filter(n: i64, seconds: f64, fps: f64) -> text:
    val edge = VIDEO_FRAME_EDGE.to_text()
    val scale = "scale=" + edge + ":" + edge + ":force_original_aspect_ratio=decrease"
    if seconds <= 0.0:
        return "select=gte(t\\,selected_n*1.000000)," + scale
    val step = seconds / n.to_f64()
    val half = step / 2.0
    var tolerance = half
    if fps > 0.0 and 1.0 / fps < half:
        tolerance = 1.0 / fps
    "select=gte(t\\," + video_seconds_text(half - tolerance) + "+selected_n*" + video_seconds_text(step) + ")," + scale

# `n` of `frames` spread evenly, first and last included; all of them when
# there are no more than `n`.
fn video_pick_evenly(frames: [[u8]], n: i64) -> [[u8]]:
    val total = frames.len()
    if n <= 0:
        return []
    if total <= n:
        return frames
    if n == 1:
        return [frames[0]]
    var picked: [[u8]] = []
    var k = 0
    while k < n:
        picked.push(frames[(k * (total - 1)) / (n - 1)])
        k = k + 1
    picked

# The JPEG files of an mjpeg stream, in order: each runs from an SOI (FF D8)
# to the next EOI (FF D9). JPEG byte-stuffs FF in entropy data, so an FF D9
# pair cannot occur inside a frame.
fn split_mjpeg(stream: [u8]) -> [[u8]]:
    var frames: [[u8]] = []
    val n = stream.len()
    var i = 0
    var start = -1
    while i + 1 < n:
        if start < 0:
            if stream[i] == 255 and stream[i + 1] == 216:
                start = i
                i = i + 2
            else:
                i = i + 1
        elif stream[i] == 255 and stream[i + 1] == 217:
            frames.push(stream.slice(start, i + 2))
            start = -1
            i = i + 2
        else:
            i = i + 1
    frames

# Up to `n` JPEG frames sampled across `blob`, an encoded video.
# Err carries the reason: ffmpeg missing, failing, or yielding no frame.
fn sample_frames(blob: [u8], n: i64) -> Result<[[u8]], text>:
    val exe = video_ffmpeg_path()
    if exe == "":
        return Err("SLANG_FFMPEG is not set")
    if blob.len() == 0:
        return Err("the video is empty")
    val tmp = host_temp_dir()
    if tmp == "":
        return Err(VIDEO_SERVER_FAULT + "no temp directory (set SLANG_VIDEO_TMP, TEMP, TMP or TMPDIR)")
    val path = video_temp_path(tmp)
    if not host_file_write_bytes(path, blob):
        # A failed write can leave a partial file behind.
        host_file_delete(path)
        return Err(VIDEO_SERVER_FAULT + "could not stage the video in a temp file")
    # Input pinned to plain files: an uploaded "video" that is really a playlist
    # (HLS, concat) must not make ffmpeg open other local files or URLs.
    # `-i` with no output always exits non-zero, so only a server fault counts.
    val probe = _run_ffmpeg(exe, ["-hide_banner", "-nostdin", "-protocol_whitelist", "file", "-i", path])
    val banner = match bytes_to_text_checked(probe.1):
        case Ok(decoded): decoded
        case Err(_):
            host_file_delete(path)
            return Err("the duration probe diagnostics are not valid UTF-8")
    if video_run_is_server_fault(probe.2, banner):
        host_file_delete(path)
        return Err(VIDEO_SERVER_FAULT + "the duration probe did not finish (exit " + probe.2.to_text() + ")")
    val seconds = _duration_seconds(banner)
    val limit = if seconds > 0.0: n else: VIDEO_UNKNOWN_SCAN
    val run = _run_ffmpeg(exe, ["-v", "error", "-nostdin", "-protocol_whitelist", "file", "-i", path, "-an", "-vf", video_frame_filter(n, seconds, video_fps_from_banner(banner)), "-fps_mode", "passthrough", "-frames:v", limit.to_text(), "-f", "image2pipe", "-c:v", "mjpeg", "-q:v", "4", "pipe:1"])
    host_file_delete(path)
    val run_stderr = match bytes_to_text_checked(run.1):
        case Ok(decoded): decoded
        case Err(_): return Err("the frame sampler diagnostics are not valid UTF-8")
    if video_run_is_server_fault(run.2, run_stderr):
        return Err(VIDEO_SERVER_FAULT + "the frame sampler did not finish (exit " + run.2.to_text() + ")")
    # A non-zero exit with some frames is a truncated or partly broken clip;
    # answering from part of it would describe a video the client did not send.
    if run.2 != 0:
        return Err("the video could not be fully decoded (ffmpeg exit " + run.2.to_text() + ")")
    val frames = split_mjpeg(run.0)
    if frames.len() == 0:
        return Err("no frame could be decoded; is the input a video?")
    Ok(video_pick_evenly(frames, n))

export video_ffmpeg_path, video_max_bytes, video_max_parts, video_reason_is_server_fault, video_run_is_server_fault, video_frame_count, split_mjpeg, sample_frames
export video_temp_path, video_fps_from_banner, video_seconds_text, video_frame_filter, video_pick_evenly
