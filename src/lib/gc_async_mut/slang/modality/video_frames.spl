# @gc — module uses GC runtime
#
# Video input for chat: turn one encoded video into a few still JPEG frames the
# model's image projector can take (design §4). slang decodes no video
# container of its own, so the frame source is an ffmpeg the OPERATOR points at
# with SLANG_FFMPEG; with none configured video stays refused (serving_chat).
#
# The video is written to a temp file, ffmpeg is run once for its duration and
# once to emit `n` evenly spaced frames as an mjpeg image2pipe stream, and the
# stream is split on the JPEG SOI/EOI markers. The temp file is always removed.

use std.io_runtime.{env_get, file_write_bytes, file_delete, getpid, time_now_unix_micros}
use std.common.text_bytes.{bytes_to_text}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded_bytes}

const VIDEO_DEFAULT_FRAMES: i64 = 4
const VIDEO_MAX_FRAMES: i64 = 32
# Decoded size of a video slang will take. Matches the HTTP layer's 10 MiB body
# limit, so an in-process caller is held to the same bound a client is.
const VIDEO_MAX_BYTES: i64 = 10485760
const VIDEO_TIMEOUT_MS: i64 = 120000
const VIDEO_MAX_OUTPUT_BYTES: i64 = 67108864
# Long edge of a sampled frame: small enough that n frames fit a small VLM's
# context, large enough for it to read the scene.
const VIDEO_FRAME_EDGE: i64 = 384

# The ffmpeg executable path, or "" when video sampling is not configured.
fn video_ffmpeg_path() -> text:
    (env_get("SLANG_FFMPEG") ?? "").trim()

fn video_max_bytes() -> i64:
    VIDEO_MAX_BYTES

# Frames taken per video: SLANG_VIDEO_FRAMES, default 4, clamped to 1..32.
fn video_frame_count() -> i64:
    val raw = (env_get("SLANG_VIDEO_FRAMES") ?? "").trim()
    var n = VIDEO_DEFAULT_FRAMES
    if raw != "":
        val parsed = raw.parse_i64()
        if parsed != nil and parsed! > 0:
            n = parsed!
    if n > VIDEO_MAX_FRAMES:
        n = VIDEO_MAX_FRAMES
    n

# ONE-LINE LOCAL WRAPPER, marked for replacement: L2 lands
# sosix_process_run_bounded_bytes; swap this body for it then.
fn _run_ffmpeg(exe: text, args: [text]) -> ([u8], [u8], i64):
    process_run_bounded_bytes(exe, args, VIDEO_TIMEOUT_MS, VIDEO_MAX_OUTPUT_BYTES)

fn _temp_dir() -> text:
    for key in ["SLANG_VIDEO_TMP", "TEMP", "TMP", "TMPDIR"]:
        val v = (env_get(key) ?? "").trim()
        if v != "":
            return v
    "."

# Seconds from the "Duration: HH:MM:SS.cc" line ffmpeg prints for `-i` alone;
# 0 when it prints none (a stream with no known duration).
fn _duration_seconds(banner: text) -> f64:
    val at = banner.find("Duration: ")
    if at < 0:
        return 0.0
    val clock = banner.slice(at + 10, at + 21)
    val fields = clock.split(":")
    if fields.len() != 3:
        return 0.0
    val h = fields[0].parse_f64()
    val m = fields[1].parse_f64()
    val s = fields[2].parse_f64()
    if h == nil or m == nil or s == nil:
        return 0.0
    h! * 3600.0 + m! * 60.0 + s!

# The JPEG files of an mjpeg stream, in order: each runs from an SOI (FF D8)
# to the next EOI (FF D9). JPEG byte-stuffs FF in entropy data, so an FF D9
# pair cannot occur inside a frame.
fn split_mjpeg(stream: [u8]) -> [[u8]]:
    var frames: [[u8]] = []
    val n = stream.len()
    var i = 0
    var start = -1
    while i + 1 < n:
        if start < 0:
            if stream[i] == 255 and stream[i + 1] == 216:
                start = i
                i = i + 2
            else:
                i = i + 1
        elif stream[i] == 255 and stream[i + 1] == 217:
            frames.push(stream.slice(start, i + 2))
            start = -1
            i = i + 2
        else:
            i = i + 1
    frames

fn _frame_filter(n: i64, seconds: f64) -> text:
    val edge = VIDEO_FRAME_EDGE.to_text()
    val scale = "scale=" + edge + ":" + edge + ":force_original_aspect_ratio=decrease"
    if seconds <= 0.0:
        return scale
    # n frames spread over the clip, each taken mid-interval.
    "fps=" + n.to_text() + "/" + seconds.to_text() + "," + scale

# Up to `n` JPEG frames sampled evenly across `blob`, an encoded video.
# Err carries the reason: ffmpeg missing, failing, or yielding no frame.
fn sample_frames(blob: [u8], n: i64) -> Result<[[u8]], text>:
    val exe = video_ffmpeg_path()
    if exe == "":
        return Err("SLANG_FFMPEG is not set")
    if blob.len() == 0:
        return Err("the video is empty")
    val path = _temp_dir() + "/slang_video_" + getpid().to_text() + "_" + time_now_unix_micros().to_text() + ".bin"
    if not file_write_bytes(path, blob):
        return Err("could not write the video to a temp file under " + _temp_dir())
    val probe = _run_ffmpeg(exe, ["-hide_banner", "-nostdin", "-i", path])
    val seconds = _duration_seconds(bytes_to_text(probe.1))
    val run = _run_ffmpeg(exe, ["-v", "error", "-nostdin", "-i", path, "-an", "-vf", _frame_filter(n, seconds), "-frames:v", n.to_text(), "-f", "image2pipe", "-c:v", "mjpeg", "-q:v", "4", "pipe:1"])
    file_delete(path)
    val frames = split_mjpeg(run.0)
    if frames.len() == 0:
        val why = bytes_to_text(run.1).trim()
        if why == "":
            return Err("ffmpeg produced no frame (exit " + run.2.to_text() + "); is the input a video?")
        return Err("ffmpeg produced no frame: " + why)
    Ok(frames)

export video_ffmpeg_path, video_max_bytes, video_frame_count, split_mjpeg, sample_frames
