# @gc — module uses GC runtime
#
# Kind resolver — which ModelKind a model directory holds, and what it takes in
# and gives out. Design: doc/05_design/ml/slang/slang_pluggable_modalities.md
# §3.2.
#
# `general.architecture` alone cannot name the kind (an OuteTTS GGUF is a plain
# llama decoder; bge embedder and reranker are both `bert`; a VLM's modality
# lives in its projector), so `resolve_kind` is an ordered chain where the first
# decisive step wins:
#   1. a `slang_kind.sdn` override (`kind: tts`, `vocoder: <file>`)
#   2. a projector companion: Chat, inputs from clip.has_vision_encoder /
#      clip.has_audio_encoder
#   3. a WavTokenizer vocoder companion -> Tts
#   4. `<arch>.pooling_type` (u32: 0 none, 1 mean, 2 cls, 3 last, 4 rank);
#      with none written, an encoder whose tensor-info table holds a
#      classification head (`cls.output.weight` / `cls.weight`) -> Rerank
#   5. the architecture table
#   6. magic sniff: `lmgg` ggml -> Asr; SD UNet safetensors -> ImageGen;
#      LlamaForCausalLM safetensors -> Chat on the pure runner
# Ambiguous models are settled with a slang_kind.sdn override, never with a
# code special case.
#
# GGUF metadata is read as BINARY: every key and value length is a u64 read
# from the bytes, and the walk ends at the first tensor-info entry (after
# kv_count entries) or at the tokenizer block, whichever is first. Bytes come
# from a growing ranged read of the prefix, never the whole file. Every length
# and count is checked against the bytes left in the FILE before it is used: a
# negative (top-bit) or oversized value is Malformed, never a long loop.

use std.gc_async_mut.slang.modality.kinds.{Modality, ModelKind, KindProfile, kind_profile, kind_default_inputs, model_kind_from_text}
use std.gc_async_mut.slang.engine.runner_dispatch.{RunnerKind}
use std.common.encoding.external_text.{bytes_to_text_checked}
use std.gc_async_mut.slang.host.slang_host.{host_file_exists, host_file_read, host_dir_list, host_is_dir, host_file_size, host_file_mtime, host_read_bytes_at}

val KIND_OVERRIDE_FILE = "slang_kind.sdn"
val GGUF_FIRST_READ = 4096
val GGUF_MAX_READ = 67108864

# GGUF value type ids (gguf.h).
val GGUF_T_U8 = 0
val GGUF_T_I8 = 1
val GGUF_T_U16 = 2
val GGUF_T_I16 = 3
val GGUF_T_U32 = 4
val GGUF_T_I32 = 5
val GGUF_T_F32 = 6
val GGUF_T_BOOL = 7
val GGUF_T_STRING = 8
val GGUF_T_ARRAY = 9
val GGUF_T_U64 = 10
val GGUF_T_I64 = 11
val GGUF_T_F64 = 12

# The few metadata facts the resolver reads. `pooling_type` is -1 when the key
# is absent.
struct GgufFacts:
    arch: text
    general_type: text
    pooling_type: i64
    has_vision: bool
    has_audio: bool
    has_cls_head: bool

# Why a walk stopped short: the bytes read so far end mid-entry, so a larger
# read is needed; or the file is not a GGUF this reader understands.
enum GgufWalkStop:
    NeedMore
    Malformed(text)

fn _join(root: text, name: text) -> text:
    if root.ends_with("/"):
        return root + name
    root + "/" + name

fn _u64_at(b: [u8], at: i64) -> i64:
    var v: i64 = 0
    var i = 7
    while i >= 0:
        v = (v << 8) | (b[at + i] as i64)
        i = i - 1
    v

fn _u32_at(b: [u8], at: i64) -> i64:
    (b[at] as i64) | ((b[at + 1] as i64) << 8) | ((b[at + 2] as i64) << 16) | ((b[at + 3] as i64) << 24)

fn _bytes_text(b: [u8], at: i64, n: i64) -> text:
    var out: [u8] = []
    var i = 0
    while i < n:
        out.push(b[at + i])
        i = i + 1
    match bytes_to_text_checked(out):
        case Ok(t): t
        case Err(_): ""

fn _bytes_are(b: [u8], at: i64, n: i64, want: text) -> bool:
    val w = want.bytes()
    if w.len() != n:
        return false
    var i = 0
    while i < n:
        if b[at + i] != w[i]:
            return false
        i = i + 1
    true

fn _bytes_start(b: [u8], at: i64, n: i64, prefix: text) -> bool:
    val w = prefix.bytes()
    if w.len() > n:
        return false
    var i = 0
    while i < w.len():
        if b[at + i] != w[i]:
            return false
        i = i + 1
    true

# Width in bytes of a fixed-size scalar type; -1 for string and array.
fn _scalar_width(t: i64) -> i64:
    if t == GGUF_T_U8 or t == GGUF_T_I8 or t == GGUF_T_BOOL:
        return 1
    if t == GGUF_T_U16 or t == GGUF_T_I16:
        return 2
    if t == GGUF_T_U32 or t == GGUF_T_I32 or t == GGUF_T_F32:
        return 4
    if t == GGUF_T_U64 or t == GGUF_T_I64 or t == GGUF_T_F64:
        return 8
    -1

# True when a length or count `n` read at `at` can fit in the `total` bytes of
# the file. A negative value is a u64 with the top bit set; both are hostile.
fn _fits(n: i64, at: i64, total: i64) -> bool:
    n >= 0 and at <= total and n <= total - at

# Offset just past one value of type `t` at `at`, or a stop. `total` is the
# whole file's size: a length past the bytes in hand but inside the file is
# NeedMore, a length past the file is Malformed.
fn _gguf_skip_value(b: [u8], at: i64, t: i64, total: i64) -> Result<i64, GgufWalkStop>:
    val width = _scalar_width(t)
    if width > 0:
        if not _fits(width, at, total):
            return Err(GgufWalkStop.Malformed("value runs past the end of the file"))
        if at + width > b.len():
            return Err(GgufWalkStop.NeedMore)
        return Ok(at + width)
    if t == GGUF_T_STRING:
        if not _fits(8, at, total):
            return Err(GgufWalkStop.Malformed("string length runs past the end of the file"))
        if at + 8 > b.len():
            return Err(GgufWalkStop.NeedMore)
        val len = _u64_at(b, at)
        if not _fits(len, at + 8, total):
            return Err(GgufWalkStop.Malformed("string length " + len.to_text() + " is out of range"))
        val end = at + 8 + len
        if end > b.len():
            return Err(GgufWalkStop.NeedMore)
        return Ok(end)
    if t == GGUF_T_ARRAY:
        if not _fits(12, at, total):
            return Err(GgufWalkStop.Malformed("array header runs past the end of the file"))
        if at + 12 > b.len():
            return Err(GgufWalkStop.NeedMore)
        val elem = _u32_at(b, at)
        val count = _u64_at(b, at + 4)
        val start = at + 12
        val elem_width = _scalar_width(elem)
        if elem_width > 0:
            # Divide before multiplying: count * elem_width can overflow i64.
            if count < 0 or count > (total - start) / elem_width:
                return Err(GgufWalkStop.Malformed("array count " + count.to_text() + " is out of range"))
            val end = start + count * elem_width
            if end > b.len():
                return Err(GgufWalkStop.NeedMore)
            return Ok(end)
        if elem == GGUF_T_STRING:
            if count < 0 or count > (total - start) / 8:
                return Err(GgufWalkStop.Malformed("string array count " + count.to_text() + " is out of range"))
            var p = start
            var i: i64 = 0
            while i < count:
                if p + 8 > b.len():
                    return Err(GgufWalkStop.NeedMore)
                val len = _u64_at(b, p)
                if not _fits(len, p + 8, total):
                    return Err(GgufWalkStop.Malformed("string length " + len.to_text() + " is out of range"))
                p = p + 8 + len
                i = i + 1
            if p > b.len():
                return Err(GgufWalkStop.NeedMore)
            return Ok(p)
        return Err(GgufWalkStop.Malformed("nested GGUF array type " + elem.to_text()))
    Err(GgufWalkStop.Malformed("unknown GGUF value type " + t.to_text()))

fn _scalar_int(b: [u8], at: i64, t: i64) -> i64:
    val width = _scalar_width(t)
    if width == 8:
        return _u64_at(b, at)
    if width == 4:
        return _u32_at(b, at)
    if width == 2:
        return (b[at] as i64) | ((b[at + 1] as i64) << 8)
    b[at] as i64

# The smallest KV entry: u64 key length, empty key, u32 type, one u8 value.
val GGUF_MIN_KV = 13
# The smallest tensor-info entry: u64 name length, u32 n_dims, u32 type, u64 offset.
val GGUF_MIN_TENSOR_INFO = 24
val GGUF_MAX_DIMS = 8

# Walk every KV entry of the GGUF bytes `b` (a prefix of a `total`-byte file)
# and keep the facts the resolver reads. A cheap walk (`full` false) ends at the
# tokenizer block; a full walk crosses it and reads the tensor-info table for
# the classification-head tensors.
fn gguf_walk_bytes(b: [u8], total: i64, full: bool) -> Result<GgufFacts, GgufWalkStop>:
    if total < 24:
        return Err(GgufWalkStop.Malformed("shorter than a GGUF header"))
    if b.len() < 24:
        return Err(GgufWalkStop.NeedMore)
    if not _bytes_are(b, 0, 4, "GGUF"):
        return Err(GgufWalkStop.Malformed("no GGUF magic"))
    val version = _u32_at(b, 4)
    if version < 2:
        return Err(GgufWalkStop.Malformed("GGUF version " + version.to_text() + " is not supported (need 2 or 3)"))
    val tensor_count = _u64_at(b, 8)
    val kv_count = _u64_at(b, 16)
    if kv_count < 0 or kv_count > (total - 24) / GGUF_MIN_KV:
        return Err(GgufWalkStop.Malformed("kv_count " + kv_count.to_text() + " is out of range"))
    if tensor_count < 0 or tensor_count > (total - 24) / GGUF_MIN_TENSOR_INFO:
        return Err(GgufWalkStop.Malformed("tensor_count " + tensor_count.to_text() + " is out of range"))
    var arch = ""
    var general_type = ""
    var pooling: i64 = -1
    var vision = false
    var audio = false
    var p: i64 = 24
    var k: i64 = 0
    var reached_tensors = true
    while k < kv_count:
        if not _fits(8, p, total):
            return Err(GgufWalkStop.Malformed("key length runs past the end of the file"))
        if p + 8 > b.len():
            return Err(GgufWalkStop.NeedMore)
        val key_len = _u64_at(b, p)
        val key_at = p + 8
        if not _fits(key_len, key_at, total) or not _fits(4, key_at + key_len, total):
            return Err(GgufWalkStop.Malformed("key length " + key_len.to_text() + " is out of range"))
        if key_at + key_len + 4 > b.len():
            return Err(GgufWalkStop.NeedMore)
        # The tokenizer block (vocab and merges, megabytes of string arrays) is
        # written after the general.* / clip.* / <arch>.* keys and holds no
        # fact the resolver reads; a cheap walk ends there. A file that breaks
        # that order is settled by a slang_kind.sdn override.
        if not full and _bytes_start(b, key_at, key_len, "tokenizer."):
            reached_tensors = false
            break
        val t = _u32_at(b, key_at + key_len)
        val v = key_at + key_len + 4
        match _gguf_skip_value(b, v, t, total):
            Err(stop):
                return Err(stop)
            Ok(next):
                if next <= p:
                    return Err(GgufWalkStop.Malformed("KV entry does not advance"))
                if t == GGUF_T_STRING and _bytes_are(b, key_at, key_len, "general.architecture"):
                    arch = _bytes_text(b, v + 8, _u64_at(b, v))
                elif t == GGUF_T_STRING and _bytes_are(b, key_at, key_len, "general.type"):
                    general_type = _bytes_text(b, v + 8, _u64_at(b, v))
                elif t == GGUF_T_BOOL and _bytes_are(b, key_at, key_len, "clip.has_vision_encoder"):
                    vision = b[v] != 0
                elif t == GGUF_T_BOOL and _bytes_are(b, key_at, key_len, "clip.has_audio_encoder"):
                    audio = b[v] != 0
                elif _scalar_width(t) > 0 and arch != "" and _bytes_are(b, key_at, key_len, arch + ".pooling_type"):
                    pooling = _scalar_int(b, v, t)
                p = next
        k = k + 1
    var cls_head = false
    if full and reached_tensors:
        var ti: i64 = 0
        while ti < tensor_count:
            if not _fits(8, p, total):
                return Err(GgufWalkStop.Malformed("tensor name length runs past the end of the file"))
            if p + 8 > b.len():
                return Err(GgufWalkStop.NeedMore)
            val name_len = _u64_at(b, p)
            val name_at = p + 8
            if not _fits(name_len, name_at, total) or not _fits(4, name_at + name_len, total):
                return Err(GgufWalkStop.Malformed("tensor name length " + name_len.to_text() + " is out of range"))
            if name_at + name_len + 4 > b.len():
                return Err(GgufWalkStop.NeedMore)
            val n_dims = _u32_at(b, name_at + name_len)
            if n_dims > GGUF_MAX_DIMS:
                return Err(GgufWalkStop.Malformed("tensor n_dims " + n_dims.to_text() + " is out of range"))
            val next = name_at + name_len + 4 + n_dims * 8 + 4 + 8
            if next > total:
                return Err(GgufWalkStop.Malformed("tensor info runs past the end of the file"))
            if next > b.len():
                return Err(GgufWalkStop.NeedMore)
            if _bytes_are(b, name_at, name_len, "cls.output.weight") or _bytes_are(b, name_at, name_len, "cls.weight"):
                cls_head = true
            p = next
            ti = ti + 1
    Ok(GgufFacts(arch: arch, general_type: general_type, pooling_type: pooling, has_vision: vision, has_audio: audio, has_cls_head: cls_head))

# The cheap walk of a whole in-memory GGUF (fixtures and specs).
fn gguf_facts_from_bytes(b: [u8]) -> Result<GgufFacts, GgufWalkStop>:
    gguf_walk_bytes(b, b.len(), false)

fn _is_embedding(k: ModelKind) -> bool:
    match k:
        ModelKind.Embedding: true
        _: false

# Bytes of GGUF header read from disk by this process (a measurement for specs
# and the /v1/models cost note; a racy increment only skews the count).
var GGUF_HEADER_BYTES_READ: i64 = 0

fn gguf_header_bytes_read() -> i64:
    GGUF_HEADER_BYTES_READ

# The walk of one file over ONE growing buffer: each step reads only the bytes
# past what is already held (a bulk ranged read), never the prefix again. An
# encoder that names no pooling type (the bge-reranker-v2-m3 GGUF writes none)
# is walked again in full over the same buffer: its classification head
# (`cls.output.weight`) lives in the tensor-info table, after the tokenizer
# block, and is what tells a reranker from an embedder. A full walk that fails
# keeps the cheap facts: the head is evidence for rerank, its absence is no
# evidence against the rest.
fn _gguf_facts_uncached(path: text, size: i64) -> Result<GgufFacts, text>:
    var buf: [u8] = []
    var want = GGUF_FIRST_READ
    var full = false
    var cheap = GgufFacts(arch: "", general_type: "", pooling_type: -1, has_vision: false, has_audio: false, has_cls_head: false)
    while true:
        match gguf_walk_bytes(buf, size, full):
            Ok(facts):
                if full:
                    return Ok(facts)
                if facts.pooling_type >= 0 or not _is_embedding(arch_kind(facts.arch)):
                    return Ok(facts)
                cheap = facts
                full = true
            Err(GgufWalkStop.Malformed(why)):
                if full:
                    return Ok(cheap)
                return Err(path + ": " + why)
            Err(GgufWalkStop.NeedMore):
                if buf.len() >= size:
                    if full:
                        return Ok(cheap)
                    return Err(path + ": truncated GGUF metadata")
                if buf.len() >= GGUF_MAX_READ:
                    if full:
                        return Ok(cheap)
                    return Err(path + ": GGUF metadata is larger than " + GGUF_MAX_READ.to_text() + " bytes")
                val target = if want > size: size else: want
                if target > buf.len():
                    match host_read_bytes_at(path, buf.len(), target - buf.len()):
                        Err(why):
                            return Err(why)
                        Ok(chunk):
                            GGUF_HEADER_BYTES_READ = GGUF_HEADER_BYTES_READ + chunk.len()
                            if chunk.len() != target - buf.len():
                                return Err(path + ": short read")
                            buf = buf + chunk
                want = want * 4
    Err(path + ": unreachable")

# One cached walk, keyed by what makes it stale.
struct GgufFactsCacheRow:
    path: text
    size: i64
    mtime: i64
    facts: GgufFacts

val GGUF_FACTS_CACHE_MAX = 512

# Copy-on-write snapshot: a reader iterates the list it read, a writer builds a
# new list and publishes it with one assignment. Two concurrent inserts may
# lose one, which only costs a re-walk later (lockless by design, no lock).
var GGUF_FACTS_CACHE: [GgufFactsCacheRow] = []

fn _facts_cache_publish(row: GgufFactsCacheRow):
    val old = GGUF_FACTS_CACHE
    var drop = 0
    if old.len() >= GGUF_FACTS_CACHE_MAX:
        drop = old.len() - GGUF_FACTS_CACHE_MAX + 1
    var next: [GgufFactsCacheRow] = []
    var i = 0
    for r in old:
        if i >= drop and r.path != row.path:
            next.push(r)
        i = i + 1
    next.push(row)
    GGUF_FACTS_CACHE = next

# GGUF facts of the file at `path`, walked once per (path, size, mtime): a
# /v1/models listing and the per-request kind check of a chat route reuse the
# walk instead of re-reading headers. An mtime of 0 (unavailable) is never
# cached. Reads a growing prefix, never past GGUF_MAX_READ.
fn gguf_facts(path: text) -> Result<GgufFacts, text>:
    val size = host_file_size(path)
    val mtime = host_file_mtime(path)
    if mtime > 0 and size >= 0:
        for row in GGUF_FACTS_CACHE:
            if row.path == path and row.size == size and row.mtime == mtime:
                return Ok(row.facts)
    match _gguf_facts_uncached(path, size):
        Err(why):
            Err(why)
        Ok(facts):
            if mtime > 0 and size >= 0:
                _facts_cache_publish(GgufFactsCacheRow(path: path, size: size, mtime: mtime, facts: facts))
            Ok(facts)

# True when `facts` describe a multimodal projector rather than a model.
fn gguf_facts_are_projector(facts: GgufFacts) -> bool:
    facts.arch == "clip" or facts.general_type == "mmproj"

# True when `facts` describe a WavTokenizer vocoder (vocoder-only, never served
# on its own).
fn gguf_facts_are_vocoder(facts: GgufFacts) -> bool:
    facts.arch == "wavtokenizer-dec"

# The architecture table: the one place an architecture names a kind. Adding a
# model family is one row. Architectures not listed are decoders served as Chat.
#
# Diffusion GGUFs (stable-diffusion.cpp / city96 conversions: flux, sd1, sd2,
# sdxl, sd3, aura) and their T5 text encoder (t5encoder) are image-generation
# parts, never a chat decoder.
fn arch_kind(arch: text) -> ModelKind:
    for row in [("bert", ModelKind.Embedding), ("nomic-bert", ModelKind.Embedding), ("jina-bert-v2", ModelKind.Embedding),
                ("flux", ModelKind.ImageGen), ("sd1", ModelKind.ImageGen), ("sd2", ModelKind.ImageGen), ("sdxl", ModelKind.ImageGen),
                ("sd3", ModelKind.ImageGen), ("aura", ModelKind.ImageGen), ("t5encoder", ModelKind.ImageGen)]:
        if row.0 == arch:
            return row.1
    ModelKind.Chat

# Kind from `<arch>.pooling_type`: 4 is rank, 1-3 are pooled embeddings.
fn pooling_kind(pooling: i64) -> ModelKind?:
    if pooling == 4:
        return Some(ModelKind.Rerank)
    if pooling >= 1 and pooling <= 3:
        return Some(ModelKind.Embedding)
    None

# `key: value` from a slang_kind.sdn override, "" when absent.
fn kind_override_field(dir: text, key: text) -> text:
    val path = _join(dir, KIND_OVERRIDE_FILE)
    if not host_file_exists(path):
        return ""
    for line in host_file_read(path).split("\n"):
        val t = line.trim()
        if t.starts_with(key + ":"):
            return _unquote(t.slice(key.byte_len() + 1, t.byte_len()).trim())
    ""

# `"tts"` and `'tts'` are the SDN-quoted forms of `tts`.
fn _unquote(v: text) -> text:
    if v.byte_len() >= 2 and ((v.starts_with("\"") and v.ends_with("\"")) or (v.starts_with("'") and v.ends_with("'"))):
        return v.slice(1, v.byte_len() - 1).trim()
    v

fn _runner_for_kind(k: ModelKind) -> RunnerKind:
    match k:
        ModelKind.Asr: RunnerKind.Whisper
        ModelKind.ImageGen: RunnerKind.StableDiffusion
        _: RunnerKind.Ggml

# Why a resolved kind cannot be served yet. Chat is served by llm_engine; the
# other kinds name the lane that owns their serving module.
fn kind_unserved_reason(k: ModelKind) -> text:
    match k:
        ModelKind.Chat: ""
        ModelKind.Asr: "asr serving (/v1/audio/transcriptions) is not implemented in this build"
        ModelKind.Tts: "tts serving (/v1/audio/speech) is not implemented in this build"
        ModelKind.ImageGen: "image generation serving (/v1/images/generations) is not implemented in this build"
        # Served by serving/serving_pooling.spl on their own routes; still not
        # runnable on the chat path, and the reason says where they are served.
        ModelKind.Embedding: "embedding serving is on /v1/embeddings; this is not a chat model"
        ModelKind.Rerank: "rerank serving is on /v1/rerank; this is not a chat model"

fn _profile(k: ModelKind, inputs: [Modality], runner: RunnerKind) -> KindProfile:
    kind_profile(k, inputs, runner, kind_unserved_reason(k))

fn _files(dir: text) -> [text]:
    var out: [text] = []
    match host_dir_list(dir):
        case Some(names):
            for name in names:
                if not host_is_dir(_join(dir, name)):
                    out.push(name)
        case None:
            pass
    out

# First 4 bytes of `path` as text ("" when unreadable).
fn _magic(path: text) -> text:
    match host_read_bytes_at(path, 0, 4):
        Ok(b):
            if b.len() == 4:
                match bytes_to_text_checked(b):
                    case Ok(t): return t
                    case Err(_): return ""
            ""
        Err(_):
            ""

# True when a safetensors file's JSON header names an SD UNet tensor
# (`model.diffusion_model.` prefix). Only the header is read.
fn safetensors_is_sd_unet(path: text) -> bool:
    match host_read_bytes_at(path, 0, 8):
        Err(_):
            return false
        Ok(head):
            if head.len() != 8:
                return false
            val header_len = _u64_at(head, 0)
            if header_len <= 0 or header_len > GGUF_MAX_READ:
                return false
            match host_read_bytes_at(path, 8, header_len):
                Ok(json):
                    match bytes_to_text_checked(json):
                        case Ok(t): t.contains("\"model.diffusion_model.")
                        case Err(_): false
                Err(_):
                    false

fn _is_whisper_ggml(path: text) -> bool:
    match host_read_bytes_at(path, 0, 48):
        Err(_):
            false
        Ok(b):
            if b.len() != 48 or not _bytes_are(b, 0, 4, "lmgg"):
                return false
            val n_audio_ctx = _u32_at(b, 8)
            val n_mels = _u32_at(b, 40)
            n_audio_ctx == 1500 and (n_mels == 80 or n_mels == 128)

# The lowest-named file in `dir` carrying the legacy ggml magic (`lmgg`, the
# whisper.cpp model format), "" when there is none.
#
# The legacy llama.cpp ggml format shares the `lmgg` magic, so the magic alone is
# not Asr: a whisper.cpp header is 11 i32 hparams (n_vocab, n_audio_ctx,
# n_audio_state, n_audio_head, n_audio_layer, n_text_ctx, n_text_state,
# n_text_head, n_text_layer, n_mels, ftype) with n_audio_ctx 1500 (30 s of
# audio) and n_mels 80 or 128; a llama ggml header has n_embd there instead.
fn ggml_magic_file(dir: text) -> text:
    var best = ""
    for name in _files(dir):
        if (best == "" or name < best) and _is_whisper_ggml(_join(dir, name)):
            best = name
    if best == "":
        return ""
    _join(dir, best)

# One GGUF file in a directory, with its facts.
struct GgufFile:
    name: text
    facts: GgufFacts

# Metadata decides; only a file whose metadata names no architecture and no
# type falls back to the `mmproj` filename prefix.
fn gguf_file_is_projector(f: GgufFile) -> bool:
    if f.facts.arch == "" and f.facts.general_type == "":
        return f.name.starts_with("mmproj")
    gguf_facts_are_projector(f.facts)

# Every `.gguf` in `dir` carrying the GGUF magic, each header walked once. A
# file whose KV block cannot be walked (truncated, GGUF v1, unknown value type)
# is kept with empty facts rather than dropped: the magic is still evidence,
# and it then resolves by filename and as Chat.
fn gguf_files(dir: text) -> [GgufFile]:
    var out: [GgufFile] = []
    for name in _files(dir):
        if name.ends_with(".gguf"):
            val path = _join(dir, name)
            match gguf_facts(path):
                Ok(facts):
                    out.push(GgufFile(name: name, facts: facts))
                Err(_):
                    if _magic(path) == "GGUF":
                        out.push(GgufFile(name: name, facts: GgufFacts(arch: "", general_type: "", pooling_type: -1, has_vision: false, has_audio: false, has_cls_head: false)))
    out

fn _override_profile(dir: text, kind_name: text) -> KindProfile:
    match model_kind_from_text(kind_name):
        Err(why):
            kind_profile(ModelKind.Chat, [Modality.Text], RunnerKind.Ggml, KIND_OVERRIDE_FILE + ": " + why)
        Ok(k):
            val p = _profile(k, kind_default_inputs(k), _runner_for_kind(k))
            if _is_tts(k):
                val vocoder = kind_override_field(dir, "vocoder")
                if vocoder == "" or not host_file_exists(_join(dir, vocoder)):
                    return kind_profile(k, p.inputs, p.runner, KIND_OVERRIDE_FILE + " names kind tts but its vocoder file '" + vocoder + "' is missing")
            p

fn _is_tts(k: ModelKind) -> bool:
    match k:
        ModelKind.Tts: true
        _: false

# The kind profile of the model in `dir`. Never fails: an unrecognised
# directory resolves to Chat with the reason it cannot be served.
fn resolve_kind(dir: text) -> KindProfile:
    resolve_kind_from(dir, gguf_files(dir))

# resolve_kind over the directory's already-walked GGUF files.
fn resolve_kind_from(dir: text, gguf: [GgufFile]) -> KindProfile:
    # 1. manifest override
    val override_kind = kind_override_field(dir, "kind")
    if override_kind != "":
        return _override_profile(dir, override_kind)
    var projectors: [GgufFacts] = []
    var vocoders = 0
    var models: [GgufFacts] = []
    var entry_name = ""
    var entry_has_arch = false
    for f in gguf:
        if gguf_file_is_projector(f):
            projectors.push(f.facts)
        elif gguf_facts_are_vocoder(f.facts):
            vocoders = vocoders + 1
        else:
            # The entry is the lowest-named model file that names an
            # architecture (shard 1 of a split carries general.*; later shards
            # may not), never whichever the directory listing returned first.
            val has_arch = f.facts.arch != ""
            if models.len() == 0 or (has_arch and not entry_has_arch) or (has_arch == entry_has_arch and f.name < entry_name):
                models = [f.facts] + models
                entry_name = f.name
                entry_has_arch = has_arch
            else:
                models.push(f.facts)
    # 2. projector companion -> Chat with the projector's input modalities
    if models.len() > 0 and projectors.len() == 1:
        var inputs = [Modality.Text]
        if projectors[0].has_vision:
            inputs.push(Modality.Image)
        if projectors[0].has_audio:
            inputs.push(Modality.Audio)
        return _profile(ModelKind.Chat, inputs, RunnerKind.Ggml)
    # 3. vocoder companion -> Tts
    if models.len() > 0 and vocoders > 0:
        return _profile(ModelKind.Tts, [Modality.Text], RunnerKind.Ggml)
    if models.len() > 0:
        # 4. pooling type, then 5. the architecture table
        match pooling_kind(models[0].pooling_type):
            case Some(k):
                return _profile(k, [Modality.Text], RunnerKind.Ggml)
            case None:
                # 4b. an encoder with a classification head is a reranker
                if models[0].has_cls_head and _is_embedding(arch_kind(models[0].arch)):
                    return _profile(ModelKind.Rerank, [Modality.Text], RunnerKind.Ggml)
                val k = arch_kind(models[0].arch)
                return _profile(k, [Modality.Text], _runner_for_kind(k))
    if vocoders > 0:
        return kind_profile(ModelKind.Tts, [Modality.Text], RunnerKind.Ggml, "only a WavTokenizer vocoder (wavtokenizer-dec) was found; it needs a TTS model GGUF beside it")
    # 6. magic sniff
    if ggml_magic_file(dir) != "":
        return _profile(ModelKind.Asr, [Modality.Audio], RunnerKind.Whisper)
    for name in _files(dir):
        val path = _join(dir, name)
        if name.ends_with(".safetensors") and safetensors_is_sd_unet(path):
            return _profile(ModelKind.ImageGen, [Modality.Text], RunnerKind.StableDiffusion)
    val cfg = _join(dir, "config.json")
    if host_file_exists(cfg) and host_file_read(cfg).contains("\"LlamaForCausalLM\""):
        return _profile(ModelKind.Chat, [Modality.Text], RunnerKind.Pure)
    kind_profile(ModelKind.Chat, [Modality.Text], RunnerKind.Ggml, "no kind could be resolved: no " + KIND_OVERRIDE_FILE + ", no GGUF model, no ggml (lmgg) file and no recognised safetensors")

export GgufFacts, GgufWalkStop, GgufFile
export gguf_facts_from_bytes, gguf_walk_bytes, gguf_header_bytes_read, gguf_facts, gguf_facts_are_projector, gguf_file_is_projector, gguf_facts_are_vocoder, gguf_files
export arch_kind, pooling_kind, kind_override_field, kind_unserved_reason, safetensors_is_sd_unet, ggml_magic_file, resolve_kind, resolve_kind_from
