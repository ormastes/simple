# @gc — module uses GC runtime
#
# slang engine — the resident model and the one place a load decision is made.
#
# Master plan slot A5. What is present: model residency (load once, serve many),
# admission control against the host memory budget, and request-level
# generation, independently owned request contexts, bounded serial prefix
# snapshots, and optional physical paged-KV ownership. Continuous batching,
# chunked prefill, and parallel execution remain absent. Requests are still
# advanced by one serial owner at a time.
#
# RESIDENCY IS THE WHOLE POINT. These models are 46-78 GB; loading per request
# would take minutes and, on a machine whose memory is unified with the GPU,
# a second concurrent load would take the host down. The engine holds exactly
# one model and refuses a switch it cannot afford, rather than letting an HTTP
# handler decide.

use std.gc_async_mut.slang.model_executor.backend.{MediaBlob, BackendMediaGenerationRequest, generate_media_request, load_mmproj, GgmlBackend, BackendError, BackendGenerationRequest, PrefixCacheStats, INVALID_NONNEGATIVE_I64_TEXT, parse_nonnegative_i64_text_exact, backend_error_text, open_backend, load_model, configure_matched_cpu_context, open_context, generate_observed_request, configure_prefix_cache, prefix_cache_stats, gpu_offload_supported, model_offloaded, physical_page_provider_status, physical_page_allocated_bytes, physical_page_bytes, close_backend}
use std.gc_async_mut.slang.model_executor.paged_backend.{PhysicalModelSupport, PhysicalPageActivation, KvExecutionMode, physical_page_activation, kv_execution_mode, kv_execution_mode_text, physical_page_activation_text}
use std.gc_async_mut.slang.model_executor.paged_executor.{PagedGenerationRequest, paged_executor_error_text, paged_executor_active, paged_executor_pool, paged_executor_telemetry, paged_executor_bind_backend, paged_executor_clear_pending_backend, paged_executor_activate_config, paged_executor_configuration_text, paged_executor_shutdown, paged_executor_generate_observed_request}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, describe_model, scan_model_root}
use std.gc_async_mut.slang.model_executor.model_loader.memory_budget.{check_fit, default_headroom_bytes, estimate_runtime_overhead_bytes}
use std.gc_async_mut.slang.engine.runner_dispatch.{RunnerKind, runner_kind_text, select_runner}
use std.gc_async_mut.slang.engine.pure_lane.{PureLane, pure_lane_load, pure_lane_generate}
use std.io_runtime.{file_exists, env_get, host_os}

# Resident state. Module-level because the model IS the process's memory: two
# engines in one process would mean two copies of a 46 GB tensor set.
var ENGINE_LOADED_ID = ""
var ENGINE_BACKEND: GgmlBackend? = nil
# The pure runner's resident model + its one KvSession (kept across requests so
# a request sharing a prefix re-uses it). At most one of ENGINE_BACKEND /
# ENGINE_PURE is set: loading either unloads the other.
var ENGINE_PURE: PureLane? = nil
var ENGINE_LAST_RUNNER = ""
var ENGINE_PURE_LAST_REUSED = 0
var ENGINE_PURE_LAST_EVALUATED = 0
# Empty = resolve via engine_lib_path() (SLANG_GGML_LIB, then per-OS default).
var ENGINE_LIB_PATH = ""
# Non-empty once engine_preload pinned the resident model for a threaded server.
var ENGINE_PINNED_ID = ""
# Media the resident model can take: 1 = images, 2 = audio, 0 = text only. Set
# when a projector (NativeModel.mmproj_path) loaded through a shim built with
# mtmd, so it reports what actually works, not what the directory holds.
var ENGINE_MEDIA_CAPS = 0
var ENGINE_N_CTX = 4096
var ENGINE_MATCHED_CPU_THREADS = -1
# -1 = offload every layer (default); 0 = keep the model on the CPU.
var ENGINE_GPU_LAYERS = -1
var ENGINE_PREFIX_CACHE_ENTRIES = 4
var ENGINE_PREFIX_CACHE_BYTES = 2147483648
var ENGINE_PHYSICAL_PAGES_ENABLED = false
var ENGINE_PHYSICAL_PAGE_TOKENS = 256
var ENGINE_PHYSICAL_PAGE_CAPACITY = 128
var ENGINE_PHYSICAL_REQUEST_CAPACITY = 1
var ENGINE_PHYSICAL_PREFIX_CAPACITY = 4
var ENGINE_PHYSICAL_BYTE_LIMIT = 2147483648

struct EngineKvReadiness:
    mode: KvExecutionMode
    cache_ready: bool
    physical_activation: PhysicalPageActivation

struct EngineGenerationObservation:
    generated_tokens: text
    output: text

struct EngineGenerationRequest:
    prompt: text
    max_tokens: text

fn engine_set_lib_path(path: text):
    ENGINE_LIB_PATH = path

fn engine_set_n_ctx_text(value: text) -> bool:
    val parsed = parse_nonnegative_i64_text_exact(value)
    if parsed <= 0:
        return false
    ENGINE_N_CTX = parsed
    true

# Negative text means "all layers"; only applies to the next model load.
fn engine_set_gpu_layers_text(value: text) -> bool:
    if ENGINE_BACKEND != nil:
        return false
    if value == "-1":
        ENGINE_GPU_LAYERS = -1
        return true
    val layers = parse_nonnegative_i64_text_exact(value)
    if layers == INVALID_NONNEGATIVE_I64_TEXT:
        return false
    ENGINE_GPU_LAYERS = layers
    true

fn engine_set_matched_cpu_threads_text(value: text) -> bool:
    val threads = parse_nonnegative_i64_text_exact(value)
    if ENGINE_BACKEND != nil or threads <= 0:
        return false
    ENGINE_MATCHED_CPU_THREADS = threads
    true

fn engine_set_physical_pages_config(config: text) -> bool:
    val fields = config.split("|")
    if fields.len() != 5:
        return false
    val enabled = fields[0] == "true"
    if fields[0] != "true" and fields[0] != "false":
        return false
    if ENGINE_BACKEND != nil:
        return false
    if enabled and (parse_nonnegative_i64_text_exact(fields[1]) <= 0 or
                    parse_nonnegative_i64_text_exact(fields[2]) <= 0 or
                    parse_nonnegative_i64_text_exact(fields[3]) <= 0 or
                    parse_nonnegative_i64_text_exact(fields[4]) <= 0):
        return false
    ENGINE_PHYSICAL_PAGES_ENABLED = enabled
    ENGINE_PHYSICAL_PAGE_TOKENS = parse_nonnegative_i64_text_exact(fields[1])
    ENGINE_PHYSICAL_PAGE_CAPACITY = parse_nonnegative_i64_text_exact(fields[2])
    ENGINE_PHYSICAL_PREFIX_CAPACITY = parse_nonnegative_i64_text_exact(fields[3])
    ENGINE_PHYSICAL_BYTE_LIMIT = parse_nonnegative_i64_text_exact(fields[4])
    true

fn engine_set_prefix_cache_limits(entries: i64, bytes: i64) -> bool:
    if entries < 0 or entries > 8 or bytes < 0:
        return false
    ENGINE_PREFIX_CACHE_ENTRIES = entries
    ENGINE_PREFIX_CACHE_BYTES = bytes
    if ENGINE_BACKEND == nil:
        return true
    configure_prefix_cache(ENGINE_BACKEND!, entries, bytes)

# One resolver for every reader (advertise, availability, load) so they cannot
# disagree. Precedence: engine_set_lib_path > SLANG_GGML_LIB > per-OS default
# (build-slang-ggml-shim.shs emits slang_ggml.dll on Windows, .so elsewhere).
fn engine_lib_path() -> text:
    val env_path = env_get("SLANG_GGML_LIB")
    if ENGINE_LIB_PATH != "":
        ENGINE_LIB_PATH
    elif env_path != "":
        env_path
    elif host_os() == "windows":
        "build/sffi/slang_ggml.dll"
    else:
        "build/sffi/libslang_ggml.so"

# Whether a ggml backend is configured AND present. Callers use this to decide
# what to advertise, so it must answer about the file on disk, not about intent.
fn engine_backend_available() -> bool:
    file_exists(engine_lib_path())

fn engine_loaded_model() -> text:
    ENGINE_LOADED_ID

# Offload evidence read from the resident shim: (supported, model_offloaded).
fn engine_gpu_offload_status() -> (bool, bool)?:
    if ENGINE_BACKEND == nil:
        return nil
    val b = ENGINE_BACKEND!
    (gpu_offload_supported(b), model_offloaded(b))

fn engine_prefix_cache_stats() -> PrefixCacheStats?:
    if ENGINE_BACKEND == nil:
        return nil
    if paged_executor_active():
        val physical = paged_executor_telemetry()
        if physical == nil:
            return nil
        val backend_stats = prefix_cache_stats(ENGINE_BACKEND!)
        return PrefixCacheStats(
            capabilities: backend_stats.capabilities,
            hits: physical!.prefix_hits.to_i64(),
            misses: physical!.prefix_misses.to_i64(),
            tokens_reused: physical!.reused_tokens.to_i64(),
            tokens_prefilled: physical!.prefilled_tokens.to_i64(),
            admissions: physical!.prefix_admissions.to_i64(),
            evictions: physical!.prefix_evictions.to_i64(),
            resident_entries: physical!.active_prefixes,
            resident_bytes: physical!.allocated_bytes,
            rejected_bytes: physical!.busy_rejects.to_i64(),
            restore_failures: physical!.generation_failures.to_i64())
    prefix_cache_stats(ENGINE_BACKEND!)

fn engine_physical_page_allocated_bytes() -> Result<i64, text>:
    if ENGINE_BACKEND == nil or not paged_executor_active():
        return Err("physical page executor is inactive")
    match physical_page_allocated_bytes(ENGINE_BACKEND!, paged_executor_pool()):
        Err(e): Err(backend_error_text(e))
        Ok(bytes): Ok(bytes)

fn engine_physical_page_bytes() -> Result<i64, text>:
    if ENGINE_BACKEND == nil or not paged_executor_active():
        return Err("physical page executor is inactive")
    match physical_page_bytes(ENGINE_BACKEND!, paged_executor_pool()):
        Err(e): Err(backend_error_text(e))
        Ok(bytes): Ok(bytes)

# Physical-page ABI discovery is not activation. Until a model-specific tensor
# provider creates a pool and connects the owner dispatch, generation must stay
# on the proven snapshot path.
fn engine_physical_page_activation() -> PhysicalPageActivation:
    if ENGINE_BACKEND == nil:
        return PhysicalPageActivation.ProviderUnavailable
    if paged_executor_active():
        return physical_page_activation(
            physical_page_provider_status(ENGINE_BACKEND!),
            PhysicalModelSupport.Supported, paged_executor_pool(), true)
    physical_page_activation(physical_page_provider_status(ENGINE_BACKEND!),
        PhysicalModelSupport.Unknown, 0, false)

fn engine_kv_readiness() -> EngineKvReadiness:
    val context_ready = ENGINE_BACKEND != nil and ENGINE_LOADED_ID != ""
    val activation = engine_physical_page_activation()
    val mode = kv_execution_mode(context_ready, activation)
    EngineKvReadiness(
        mode: mode,
        cache_ready: mode != KvExecutionMode.Unavailable,
        physical_activation: activation)

fn engine_kv_execution_mode() -> KvExecutionMode:
    engine_kv_readiness().mode

fn engine_kv_execution_mode_text() -> text:
    kv_execution_mode_text(engine_kv_execution_mode())

fn engine_physical_page_reason() -> text:
    physical_page_activation_text(engine_physical_page_activation())

fn engine_unload() -> Result<(), text>:
    ENGINE_PURE = nil
    if ENGINE_BACKEND != nil:
        if paged_executor_active():
            match paged_executor_shutdown():
                Err(error): return Err(paged_executor_error_text(error))
                Ok(_): ()
        match close_backend(ENGINE_BACKEND!):
            Err(e): return Err(backend_error_text(e))
            Ok(_): ()
        ENGINE_BACKEND = nil
    ENGINE_LOADED_ID = ""
    ENGINE_MEDIA_CAPS = 0
    Ok(())

# Makes `model` the resident model, unloading whatever was resident first.
# Err carries a caller-facing reason; every failure path leaves the engine with
# no model rather than a half-open one. The runner is chosen by select_runner.
fn engine_ensure_loaded(model: NativeModel) -> Result<(), text>:
    match select_runner(model):
        Err(reason):
            return Err(reason)
        Ok(kind):
            match kind:
                RunnerKind.Pure:
                    return _ensure_pure_loaded(model)
                RunnerKind.Ggml:
                    return _ensure_ggml_loaded(model)

fn _ensure_pure_loaded(model: NativeModel) -> Result<(), text>:
    if ENGINE_LOADED_ID == model.id and ENGINE_PURE != nil:
        return Ok(())
    if ENGINE_PINNED_ID != "" and model.id != ENGINE_PINNED_ID:
        return Err("this server is pinned to model '" + ENGINE_PINNED_ID + "'; swapping models under concurrent requests is refused")
    match engine_unload():
        Err(reason): return Err("resident model is busy: " + reason)
        Ok(_): ()
    # The pure runner holds every weight as f64 (8 bytes per element), so a
    # bf16/f32 checkpoint costs up to 4x its file size.
    val fit = check_fit(model.bytes * 4, 0, default_headroom_bytes())
    if not fit.fits:
        return Err("refusing to load '" + model.id + "': " + fit.reason)
    match pure_lane_load(model.root):
        Err(reason):
            return Err("pure runner load failed for '" + model.id + "': " + reason)
        Ok(lane):
            ENGINE_PURE = lane
            ENGINE_LOADED_ID = model.id
            Ok(())

fn _ensure_ggml_loaded(model: NativeModel) -> Result<(), text>:
    if ENGINE_LOADED_ID == model.id and ENGINE_BACKEND != nil:
        return Ok(())
    if ENGINE_PINNED_ID != "" and model.id != ENGINE_PINNED_ID:
        return Err("this server is pinned to model '" + ENGINE_PINNED_ID + "'; swapping models under concurrent requests is refused")
    if not model.runnable:
        return Err(model.reason)
    if model.entry_path == "":
        return Err("model '" + model.id + "' has no loadable entry file")
    # Unload BEFORE the fit check: the memory the outgoing model holds is
    # memory the incoming one can have, and checking first would refuse a swap
    # that actually fits.
    match engine_unload():
        Err(reason): return Err("resident model is busy: " + reason)
        Ok(_): ()
    val fit = check_fit(model.bytes, estimate_runtime_overhead_bytes(model.bytes, ENGINE_N_CTX), default_headroom_bytes())
    if not fit.fits:
        return Err("refusing to load '" + model.id + "': " + fit.reason)
    val lib_path = engine_lib_path()
    match open_backend(lib_path):
        Err(e):
            return Err("backend unavailable at " + lib_path + ": " + backend_error_text(e))
        Ok(b):
            val gpu_layers = if ENGINE_PHYSICAL_PAGES_ENABLED or ENGINE_MATCHED_CPU_THREADS > 0: 0 else: ENGINE_GPU_LAYERS
            match load_model(b, model.entry_path, gpu_layers):
                Err(e):
                    close_backend(b)
                    return Err("load failed for '" + model.id + "': " + backend_error_text(e))
                Ok(_):
                    if ENGINE_MATCHED_CPU_THREADS > 0:
                        match configure_matched_cpu_context(b, ENGINE_MATCHED_CPU_THREADS):
                            Err(e):
                                close_backend(b)
                                return Err("matched CPU context failed for '" + model.id + "': " + backend_error_text(e))
                            Ok(_): ()
                    if ENGINE_PHYSICAL_PAGES_ENABLED:
                        if not paged_executor_bind_backend(b):
                            close_backend(b)
                            return Err("physical page backend binding failed for '" + model.id + "'")
                        val physical_config = ENGINE_N_CTX.to_text() + "|" +
                            ENGINE_PHYSICAL_PAGE_TOKENS.to_text() + "|" +
                            ENGINE_PHYSICAL_PAGE_CAPACITY.to_text() + "|" +
                            ENGINE_PHYSICAL_REQUEST_CAPACITY.to_text() + "|" +
                            ENGINE_PHYSICAL_PREFIX_CAPACITY.to_text() + "|" +
                            ENGINE_PHYSICAL_BYTE_LIMIT.to_text()
                        val activated = paged_executor_activate_config(physical_config)
                        match activated:
                            Err(error):
                                paged_executor_clear_pending_backend()
                                val activation_reason = paged_executor_error_text(error)
                                match close_backend(b):
                                    Err(close_error):
                                        # Retain ownership so engine_unload can retry teardown.
                                        ENGINE_BACKEND = b
                                        ENGINE_LOADED_ID = model.id
                                        return Err("physical page activation failed for '" +
                                            model.id + "': " + activation_reason +
                                            "; cleanup failed: " + backend_error_text(close_error))
                                    Ok(_):
                                        return Err("physical page activation failed for '" +
                                            model.id + "': " + activation_reason)
                            Ok(_):
                                ENGINE_BACKEND = b
                                ENGINE_LOADED_ID = model.id
                                return Ok(())
                    match open_context(b, ENGINE_N_CTX):
                        Err(e):
                            close_backend(b)
                            return Err("context failed for '" + model.id + "': " + backend_error_text(e))
                        Ok(_):
                            configure_prefix_cache(b, ENGINE_PREFIX_CACHE_ENTRIES, ENGINE_PREFIX_CACHE_BYTES)
                            # A projector that cannot be attached (shim built
                            # without mtmd, or a projector the model rejects)
                            # leaves the model text-only; it never fails the load.
                            if model.mmproj_path != "":
                                match load_mmproj(b, model.mmproj_path):
                                    Ok(caps): ENGINE_MEDIA_CAPS = caps
                                    Err(_): ENGINE_MEDIA_CAPS = 0
                            ENGINE_BACKEND = b
                            ENGINE_LOADED_ID = model.id
                            Ok(())

# Media kinds the resident model takes right now: bit 1 images, bit 2 audio.
fn engine_media_caps() -> i64:
    ENGINE_MEDIA_CAPS

# Loads `model_id` (as engine_complete_chat does) and reports what media it can
# take: Ok(0) is a text-only model.
fn engine_media_caps_for(model_root: text, model_id: text) -> Result<i64, text>:
    var found: NativeModel? = nil
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.id == model_id:
            found = m
    if found == nil:
        return Err("model '" + model_id + "' was not found under " + model_root)
    match engine_ensure_loaded(found!):
        Err(reason): Err(reason)
        Ok(_): Ok(ENGINE_MEDIA_CAPS)

# Chat completion whose frames carry media markers; `media` holds one encoded
# file per marker, in order. Never uses the prefix cache.
fn engine_complete_chat_media(model_id: text, framed: text, media: [MediaBlob], max_tokens: i64) -> Result<text, text>:
    if ENGINE_PURE != nil:
        return Err("media is not available on the pure runner (text only); the request is not routed to another runner")
    if ENGINE_BACKEND == nil or ENGINE_LOADED_ID != model_id:
        return Err("model '" + model_id + "' is not resident")
    if ENGINE_MEDIA_CAPS <= 0:
        return Err("the resident model has no media projector attached")
    if paged_executor_active():
        return Err("media is not available on the physical page executor")
    var budget = max_tokens
    if budget <= 0:
        budget = 256
    match generate_media_request(BackendMediaGenerationRequest(
          max_tokens: budget.to_text(), prompt: framed, backend: ENGINE_BACKEND!, media: media)):
        Err(e): Err(backend_error_text(e))
        Ok(observed): Ok(observed.output)

fn engine_generate_observed_request(input: EngineGenerationRequest) -> Result<EngineGenerationObservation, text>:
    val prompt = input.prompt
    val max_tokens = parse_nonnegative_i64_text_exact(input.max_tokens)
    if max_tokens == INVALID_NONNEGATIVE_I64_TEXT:
        return Err("max_tokens must be a nonnegative signed 64-bit integer")
    if ENGINE_BACKEND == nil:
        return Err("no model is resident")
    var budget = max_tokens
    if budget <= 0:
        budget = 256
    if paged_executor_active():
        match paged_executor_generate_observed_request(PagedGenerationRequest(
              max_tokens: budget.to_text(), prompt: prompt)):
            Err(error): return Err(paged_executor_error_text(error))
            Ok(observed): return Ok(EngineGenerationObservation(
                output: observed.output, generated_tokens: observed.generated_tokens))
    match generate_observed_request(BackendGenerationRequest(
          max_tokens: budget.to_text(), prompt: prompt, backend: ENGINE_BACKEND!, chat: false)):
        Err(e):
            Err(backend_error_text(e))
        Ok(observed):
            Ok(EngineGenerationObservation(
                output: observed.output, generated_tokens: observed.generated_tokens))

fn engine_generate(prompt: text, max_tokens: i64) -> Result<text, text>:
    match engine_generate_observed_request(EngineGenerationRequest(
          prompt: prompt, max_tokens: max_tokens.to_text())):
        Err(reason): Err(reason)
        Ok(observed): Ok(observed.output)

fn engine_generate_observed(prompt: text, max_tokens: i64) -> Result<EngineGenerationObservation, text>:
    engine_generate_observed_request(EngineGenerationRequest(
        prompt: prompt, max_tokens: max_tokens.to_text()))

# Load-and-generate in one step, which is what an HTTP handler wants: it has a
# model name and a prompt and no business knowing whether a load is needed.
fn engine_complete(model_root: text, model_id: text, prompt: text, max_tokens: i64) -> Result<text, text>:
    var found: NativeModel? = nil
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.id == model_id:
            found = m
    if found == nil:
        return Err("model '" + model_id + "' was not found under " + model_root)
    match engine_ensure_loaded(found!):
        Err(reason):
            Err(reason)
        Ok(_):
            engine_generate(prompt, max_tokens)

# Loads `model_id` on the CALLING thread and pins it. A server that handles each
# connection on its own thread must call this before it starts accepting: under
# the interpreter a spawned thread starts from a snapshot of module state and
# its writes stay thread-local, so a model loaded lazily inside one connection
# thread is invisible to the next one. That thread then re-enters the load
# path against a backend whose C side is already populated, fails, and tears
# the resident model down (measured 2026-11-12: every second request answered
# 503 "model failed to load" and unloaded the model). Preloading on the owner
# thread puts the backend handle into every later thread's snapshot, so handlers
# only ever open and close their own request context.
fn engine_preload(model_root: text, model_id: text) -> Result<(), text>:
    var found: NativeModel? = nil
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.id == model_id:
            found = m
    if found == nil:
        return Err("model '" + model_id + "' was not found under " + model_root)
    match engine_ensure_loaded(found!):
        Err(reason):
            Err(reason)
        Ok(_):
            ENGINE_PINNED_ID = model_id
            Ok(())

# Chat completion: `framed` is every message of the conversation, in order, as
# backend chat frames. The backend renders them through the model's own chat
# template, so the model sees its system prompt and the whole history and
# stops at its own end-of-turn token.
#
# THE DISPATCH POINT: this is the one place a model id becomes a loaded model
# and a generate call, and where select_runner picks the runner. `plain_prompt`
# is the same conversation as plain text for a runner with no chat template
# (see pure_lane.spl); the ggml lane ignores it.
struct EngineChatResult:
    content: text
    prompt_tokens: i64
    completion_tokens: i64
    runner: text

fn engine_complete_chat(model_root: text, model_id: text, framed: text, plain_prompt: text, max_tokens: i64) -> Result<EngineChatResult, text>:
    _engine_dispatch(model_root, model_id, framed, plain_prompt, max_tokens, true)

# Legacy /v1/completions: the raw prompt, no chat template, through the same
# dispatch (and the same usage counts) as chat.
fn engine_complete_text(model_root: text, model_id: text, prompt: text, max_tokens: i64) -> Result<EngineChatResult, text>:
    _engine_dispatch(model_root, model_id, prompt, prompt, max_tokens, false)

fn _engine_dispatch(model_root: text, model_id: text, framed: text, plain_prompt: text, max_tokens: i64, chat: bool) -> Result<EngineChatResult, text>:
    ENGINE_LAST_RUNNER = ""
    var found: NativeModel? = nil
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.id == model_id:
            found = m
    if found == nil:
        return Err("model '" + model_id + "' was not found under " + model_root)
    var kind = RunnerKind.Ggml
    match select_runner(found!):
        Err(reason):
            return Err(reason)
        Ok(k):
            kind = k
    match engine_ensure_loaded(found!):
        Err(reason):
            return Err(reason)
        Ok(_): ()
    ENGINE_LAST_RUNNER = runner_kind_text(kind)
    match kind:
        RunnerKind.Pure:
            return _complete_pure(plain_prompt, max_tokens)
        RunnerKind.Ggml:
            return _complete_ggml(framed, max_tokens, chat)

fn _complete_pure(prompt: text, max_tokens: i64) -> Result<EngineChatResult, text>:
    if ENGINE_PURE == nil:
        return Err("no pure model is resident")
    match pure_lane_generate(ENGINE_PURE!, prompt, max_tokens):
        Err(reason): Err(reason)
        Ok(done):
            ENGINE_PURE = done.lane
            ENGINE_PURE_LAST_REUSED = done.reused_positions
            ENGINE_PURE_LAST_EVALUATED = done.evaluated_positions
            Ok(EngineChatResult(content: done.output, prompt_tokens: done.prompt_tokens,
                completion_tokens: done.completion_tokens, runner: "pure"))

fn _complete_ggml(framed: text, max_tokens: i64, chat: bool) -> Result<EngineChatResult, text>:
    if paged_executor_active():
        return Err("chat templating and usage counts are not available on the physical page executor")
    var budget = max_tokens
    if budget <= 0:
        budget = 256
    match generate_observed_request(BackendGenerationRequest(
          max_tokens: budget.to_text(), prompt: framed, backend: ENGINE_BACKEND!, chat: chat)):
        Err(e): Err(backend_error_text(e))
        Ok(observed):
            Ok(EngineChatResult(content: observed.output, prompt_tokens: observed.prompt_tokens,
                completion_tokens: parse_nonnegative_i64_text_exact(observed.generated_tokens), runner: "ggml"))

# The ggml lane of engine_complete_chat with the backend's generated-token
# count kept (no plain-text prompt: a pure runner would be given an empty one,
# so this is for models known to be GGUF, e.g. the model variety spec).
fn engine_complete_chat_observed(model_root: text, model_id: text, framed: text, max_tokens: i64) -> Result<EngineGenerationObservation, text>:
    match engine_complete_chat(model_root, model_id, framed, "", max_tokens):
        Err(reason): Err(reason)
        Ok(done):
            if done.runner != "ggml":
                return Err("engine_complete_chat_observed serves the ggml lane; model '" + model_id + "' was served by the " + done.runner + " runner")
            Ok(EngineGenerationObservation(output: done.content, generated_tokens: done.completion_tokens.to_text()))

# Runner that served the most recent chat request ("" before the first).
fn engine_last_runner() -> text:
    ENGINE_LAST_RUNNER

# Pure runner prefix-reuse evidence for the most recent request: positions
# re-used from the resident KvSession and positions actually evaluated, plus the
# session's lifetime evaluated total. nil when no pure model is resident.
struct PureRunnerStats:
    last_reused_positions: i64
    last_evaluated_positions: i64
    total_evaluated_positions: i64
    requests: i64

fn engine_pure_stats() -> PureRunnerStats?:
    if ENGINE_PURE == nil:
        return nil
    val lane = ENGINE_PURE!
    PureRunnerStats(last_reused_positions: ENGINE_PURE_LAST_REUSED,
        last_evaluated_positions: ENGINE_PURE_LAST_EVALUATED,
        total_evaluated_positions: lane.session.positions_evaluated,
        requests: lane.requests)

export engine_complete_text, EngineChatResult, engine_last_runner, engine_pure_stats, PureRunnerStats
