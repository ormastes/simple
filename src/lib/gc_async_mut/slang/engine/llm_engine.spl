# @gc — module uses GC runtime
#
# slang engine — the resident model and the one place a load decision is made.
#
# Master plan slot A5. What is present: model residency (load once, serve many),
# admission control against the host memory budget, and request-level
# generation, independently owned request contexts, bounded serial prefix
# snapshots, and optional physical paged-KV ownership. Continuous batching,
# chunked prefill, and parallel execution remain absent. Requests are still
# advanced by one serial owner at a time.
#
# RESIDENCY IS THE WHOLE POINT. These models are 46-78 GB; loading per request
# would take minutes and, on a machine whose memory is unified with the GPU,
# a second concurrent load would take the host down. The engine holds exactly
# one model and refuses a switch it cannot afford, rather than letting an HTTP
# handler decide.

use std.gc_async_mut.slang.model_executor.backend.{GgmlBackend, BackendError, PrefixCacheStats, backend_error_text, open_backend, load_model, configure_matched_cpu_context, open_context, generate, configure_prefix_cache, prefix_cache_stats, physical_page_provider_status, physical_page_allocated_bytes, physical_page_bytes, close_backend}
use std.gc_async_mut.slang.model_executor.paged_backend.{PhysicalModelSupport, PhysicalPageActivation, KvExecutionMode, physical_page_activation, kv_execution_mode, kv_execution_mode_text, physical_page_activation_text}
use std.gc_async_mut.slang.model_executor.paged_executor.{paged_executor_error_text, paged_executor_active, paged_executor_pool, paged_executor_telemetry, paged_executor_activate, paged_executor_shutdown, paged_executor_generate}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, describe_model, scan_model_root}
use std.gc_async_mut.slang.model_executor.model_loader.memory_budget.{check_fit, default_headroom_bytes}
use std.io_runtime.{file_exists}

# Resident state. Module-level because the model IS the process's memory: two
# engines in one process would mean two copies of a 46 GB tensor set.
var ENGINE_LOADED_ID = ""
var ENGINE_BACKEND: GgmlBackend? = nil
var ENGINE_LIB_PATH = "build/sffi/libslang_ggml.so"
var ENGINE_N_CTX = 4096
var ENGINE_MATCHED_CPU_THREADS = -1
var ENGINE_PREFIX_CACHE_ENTRIES = 4
var ENGINE_PREFIX_CACHE_BYTES = 2147483648
var ENGINE_PHYSICAL_PAGES_ENABLED = false
var ENGINE_PHYSICAL_PAGE_TOKENS = 256
var ENGINE_PHYSICAL_PAGE_CAPACITY = 128
var ENGINE_PHYSICAL_REQUEST_CAPACITY = 1
var ENGINE_PHYSICAL_PREFIX_CAPACITY = 4
var ENGINE_PHYSICAL_BYTE_LIMIT = 2147483648

struct EngineKvReadiness:
    mode: KvExecutionMode
    cache_ready: bool
    physical_activation: PhysicalPageActivation

fn engine_set_lib_path(path: text):
    ENGINE_LIB_PATH = path

fn engine_set_n_ctx(n: i64):
    ENGINE_N_CTX = n

fn engine_set_matched_cpu_threads(threads: i64) -> bool:
    if ENGINE_BACKEND != nil or threads <= 0:
        return false
    ENGINE_MATCHED_CPU_THREADS = threads
    true

fn engine_set_physical_pages(enabled: bool, page_tokens: i64 = 256,
                             page_capacity: i64 = 128,
                             prefix_capacity: i64 = 4,
                             byte_limit: i64 = 2147483648) -> bool:
    if ENGINE_BACKEND != nil:
        return false
    if enabled and (page_tokens <= 0 or page_capacity <= 0 or
                    prefix_capacity <= 0 or byte_limit <= 0):
        return false
    ENGINE_PHYSICAL_PAGES_ENABLED = enabled
    ENGINE_PHYSICAL_PAGE_TOKENS = page_tokens
    ENGINE_PHYSICAL_PAGE_CAPACITY = page_capacity
    ENGINE_PHYSICAL_PREFIX_CAPACITY = prefix_capacity
    ENGINE_PHYSICAL_BYTE_LIMIT = byte_limit
    true

fn engine_set_prefix_cache_limits(entries: i64, bytes: i64) -> bool:
    if entries < 0 or entries > 8 or bytes < 0:
        return false
    ENGINE_PREFIX_CACHE_ENTRIES = entries
    ENGINE_PREFIX_CACHE_BYTES = bytes
    if ENGINE_BACKEND == nil:
        return true
    configure_prefix_cache(ENGINE_BACKEND!, entries, bytes)

fn engine_lib_path() -> text:
    ENGINE_LIB_PATH

# Whether a ggml backend is configured AND present. Callers use this to decide
# what to advertise, so it must answer about the file on disk, not about intent.
fn engine_backend_available() -> bool:
    file_exists(ENGINE_LIB_PATH)

fn engine_loaded_model() -> text:
    ENGINE_LOADED_ID

fn engine_prefix_cache_stats() -> PrefixCacheStats?:
    if ENGINE_BACKEND == nil:
        return nil
    if paged_executor_active():
        val physical = paged_executor_telemetry()
        if physical == nil:
            return nil
        val backend_stats = prefix_cache_stats(ENGINE_BACKEND!)
        return PrefixCacheStats(
            capabilities: backend_stats.capabilities,
            hits: physical!.prefix_hits.to_i64(),
            misses: physical!.prefix_misses.to_i64(),
            tokens_reused: physical!.reused_tokens.to_i64(),
            tokens_prefilled: physical!.prefilled_tokens.to_i64(),
            admissions: physical!.prefix_admissions.to_i64(),
            evictions: physical!.prefix_evictions.to_i64(),
            resident_entries: physical!.active_prefixes,
            resident_bytes: physical!.allocated_bytes,
            rejected_bytes: physical!.busy_rejects.to_i64(),
            restore_failures: physical!.generation_failures.to_i64())
    prefix_cache_stats(ENGINE_BACKEND!)

fn engine_physical_page_allocated_bytes() -> Result<i64, text>:
    if ENGINE_BACKEND == nil or not paged_executor_active():
        return Err("physical page executor is inactive")
    match physical_page_allocated_bytes(ENGINE_BACKEND!, paged_executor_pool()):
        Err(e): Err(backend_error_text(e))
        Ok(bytes): Ok(bytes)

fn engine_physical_page_bytes() -> Result<i64, text>:
    if ENGINE_BACKEND == nil or not paged_executor_active():
        return Err("physical page executor is inactive")
    match physical_page_bytes(ENGINE_BACKEND!, paged_executor_pool()):
        Err(e): Err(backend_error_text(e))
        Ok(bytes): Ok(bytes)

# Physical-page ABI discovery is not activation. Until a model-specific tensor
# provider creates a pool and connects the owner dispatch, generation must stay
# on the proven snapshot path.
fn engine_physical_page_activation() -> PhysicalPageActivation:
    if ENGINE_BACKEND == nil:
        return PhysicalPageActivation.ProviderUnavailable
    if paged_executor_active():
        return physical_page_activation(
            physical_page_provider_status(ENGINE_BACKEND!),
            PhysicalModelSupport.Supported, paged_executor_pool(), true)
    physical_page_activation(physical_page_provider_status(ENGINE_BACKEND!),
        PhysicalModelSupport.Unknown, 0, false)

fn engine_kv_readiness() -> EngineKvReadiness:
    val context_ready = ENGINE_BACKEND != nil and ENGINE_LOADED_ID != ""
    val activation = engine_physical_page_activation()
    val mode = kv_execution_mode(context_ready, activation)
    EngineKvReadiness(
        mode: mode,
        cache_ready: mode != KvExecutionMode.Unavailable,
        physical_activation: activation)

fn engine_kv_execution_mode() -> KvExecutionMode:
    engine_kv_readiness().mode

fn engine_kv_execution_mode_text() -> text:
    kv_execution_mode_text(engine_kv_execution_mode())

fn engine_physical_page_reason() -> text:
    physical_page_activation_text(engine_physical_page_activation())

# KV cache and activations for a context of this size. A per-token-per-layer
# estimate would need the model's own hyperparameters, which are not read until
# the backend opens the file; this is a deliberately conservative flat figure
# used only for admission, never for allocation.
fn _runtime_overhead_bytes() -> i64:
    6 * 1024 * 1024 * 1024

fn engine_unload() -> Result<(), text>:
    if ENGINE_BACKEND != nil:
        if paged_executor_active():
            match paged_executor_shutdown():
                Err(error): return Err(paged_executor_error_text(error))
                Ok(_): ()
        match close_backend(ENGINE_BACKEND!):
            Err(e): return Err(backend_error_text(e))
            Ok(_): ()
        ENGINE_BACKEND = nil
    ENGINE_LOADED_ID = ""
    Ok(())

# Makes `model` the resident model, unloading whatever was resident first.
# Err carries a caller-facing reason; every failure path leaves the engine with
# no model rather than a half-open one.
fn engine_ensure_loaded(model: NativeModel) -> Result<(), text>:
    if ENGINE_LOADED_ID == model.id and ENGINE_BACKEND != nil:
        return Ok(())
    if not model.runnable:
        return Err(model.reason)
    if model.entry_path == "":
        return Err("model '" + model.id + "' has no loadable entry file")
    # Unload BEFORE the fit check: the memory the outgoing model holds is
    # memory the incoming one can have, and checking first would refuse a swap
    # that actually fits.
    match engine_unload():
        Err(reason): return Err("resident model is busy: " + reason)
        Ok(_): ()
    val fit = check_fit(model.bytes, _runtime_overhead_bytes(), default_headroom_bytes())
    if not fit.fits:
        return Err("refusing to load '" + model.id + "': " + fit.reason)
    match open_backend(ENGINE_LIB_PATH):
        Err(e):
            return Err("backend unavailable at " + ENGINE_LIB_PATH + ": " + backend_error_text(e))
        Ok(b):
            val gpu_layers = if ENGINE_PHYSICAL_PAGES_ENABLED: 0 else: -1
            match load_model(b, model.entry_path, gpu_layers):
                Err(e):
                    close_backend(b)
                    return Err("load failed for '" + model.id + "': " + backend_error_text(e))
                Ok(_):
                    if ENGINE_MATCHED_CPU_THREADS > 0:
                        match configure_matched_cpu_context(b, ENGINE_MATCHED_CPU_THREADS):
                            Err(e):
                                close_backend(b)
                                return Err("matched CPU context failed for '" + model.id + "': " + backend_error_text(e))
                            Ok(_): ()
                    if ENGINE_PHYSICAL_PAGES_ENABLED:
                        val activated = paged_executor_activate(
                            b, ENGINE_N_CTX, ENGINE_PHYSICAL_PAGE_TOKENS,
                            ENGINE_PHYSICAL_PAGE_CAPACITY,
                            ENGINE_PHYSICAL_REQUEST_CAPACITY,
                            ENGINE_PHYSICAL_PREFIX_CAPACITY,
                            ENGINE_PHYSICAL_BYTE_LIMIT)
                        if activated.is_ok():
                            ENGINE_BACKEND = b
                            ENGINE_LOADED_ID = model.id
                            return Ok(())
                    match open_context(b, ENGINE_N_CTX):
                        Err(e):
                            close_backend(b)
                            return Err("context failed for '" + model.id + "': " + backend_error_text(e))
                        Ok(_):
                            configure_prefix_cache(b, ENGINE_PREFIX_CACHE_ENTRIES, ENGINE_PREFIX_CACHE_BYTES)
                            ENGINE_BACKEND = b
                            ENGINE_LOADED_ID = model.id
                            Ok(())

fn engine_generate(prompt: text, max_tokens: i64) -> Result<text, text>:
    if ENGINE_BACKEND == nil:
        return Err("no model is resident")
    var budget = max_tokens
    if budget <= 0:
        budget = 256
    if paged_executor_active():
        match paged_executor_generate(prompt, budget):
            Err(error): return Err(paged_executor_error_text(error))
            Ok(txt): return Ok(txt)
    match generate(ENGINE_BACKEND!, prompt, budget):
        Err(e):
            Err(backend_error_text(e))
        Ok(txt):
            Ok(txt)

# Load-and-generate in one step, which is what an HTTP handler wants: it has a
# model name and a prompt and no business knowing whether a load is needed.
fn engine_complete(model_root: text, model_id: text, prompt: text, max_tokens: i64) -> Result<text, text>:
    var found: NativeModel? = nil
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.id == model_id:
            found = m
    if found == nil:
        return Err("model '" + model_id + "' was not found under " + model_root)
    match engine_ensure_loaded(found!):
        Err(reason):
            Err(reason)
        Ok(_):
            engine_generate(prompt, max_tokens)

export engine_set_lib_path, engine_set_n_ctx, engine_set_matched_cpu_threads, engine_set_physical_pages, engine_set_prefix_cache_limits, engine_lib_path, engine_backend_available
export engine_loaded_model, engine_prefix_cache_stats, engine_unload, engine_ensure_loaded, engine_generate, engine_complete
export engine_physical_page_allocated_bytes, engine_physical_page_bytes
export engine_physical_page_activation, engine_kv_execution_mode
export engine_kv_execution_mode_text, engine_physical_page_reason
export EngineKvReadiness, engine_kv_readiness
