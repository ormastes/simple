# @gc — module uses GC runtime
#
# slang engine — the resident model and the one place a load decision is made.
#
# Master plan slot A5. What is present: model residency (load once, serve many),
# admission control against the host memory budget, and request-level
# generation. What is deliberately absent: continuous batching, chunked prefill
# and prefix caching, which are the rest of A5 and need the A4 paged KV cache
# underneath them. Requests are therefore served one at a time.
#
# RESIDENCY IS THE WHOLE POINT. These models are 46-78 GB; loading per request
# would take minutes and, on a machine whose memory is unified with the GPU,
# a second concurrent load would take the host down. The engine holds exactly
# one model and refuses a switch it cannot afford, rather than letting an HTTP
# handler decide.

use std.gc_async_mut.slang.model_executor.backend.{GgmlBackend, BackendError, backend_error_text, open_backend, load_model, open_context, generate, close_backend}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, describe_model, scan_model_root}
use std.gc_async_mut.slang.model_executor.model_loader.memory_budget.{check_fit, default_headroom_bytes}
use std.io_runtime.{file_exists}

# Resident state. Module-level because the model IS the process's memory: two
# engines in one process would mean two copies of a 46 GB tensor set.
var ENGINE_LOADED_ID = ""
var ENGINE_BACKEND: GgmlBackend? = nil
var ENGINE_LIB_PATH = "build/sffi/libslang_ggml.so"
var ENGINE_N_CTX = 4096

fn engine_set_lib_path(path: text):
    ENGINE_LIB_PATH = path

fn engine_set_n_ctx(n: i64):
    ENGINE_N_CTX = n

fn engine_lib_path() -> text:
    ENGINE_LIB_PATH

# Whether a ggml backend is configured AND present. Callers use this to decide
# what to advertise, so it must answer about the file on disk, not about intent.
fn engine_backend_available() -> bool:
    file_exists(ENGINE_LIB_PATH)

fn engine_loaded_model() -> text:
    ENGINE_LOADED_ID

# KV cache and activations for a context of this size. A per-token-per-layer
# estimate would need the model's own hyperparameters, which are not read until
# the backend opens the file; this is a deliberately conservative flat figure
# used only for admission, never for allocation.
fn _runtime_overhead_bytes() -> i64:
    6 * 1024 * 1024 * 1024

fn engine_unload():
    if ENGINE_BACKEND != nil:
        close_backend(ENGINE_BACKEND!)
        ENGINE_BACKEND = nil
    ENGINE_LOADED_ID = ""

# Makes `model` the resident model, unloading whatever was resident first.
# Err carries a caller-facing reason; every failure path leaves the engine with
# no model rather than a half-open one.
fn engine_ensure_loaded(model: NativeModel) -> Result<(), text>:
    if ENGINE_LOADED_ID == model.id and ENGINE_BACKEND != nil:
        return Ok(())
    if not model.runnable:
        return Err(model.reason)
    if model.entry_path == "":
        return Err("model '" + model.id + "' has no loadable entry file")
    # Unload BEFORE the fit check: the memory the outgoing model holds is
    # memory the incoming one can have, and checking first would refuse a swap
    # that actually fits.
    engine_unload()
    val fit = check_fit(model.bytes, _runtime_overhead_bytes(), default_headroom_bytes())
    if not fit.fits:
        return Err("refusing to load '" + model.id + "': " + fit.reason)
    match open_backend(ENGINE_LIB_PATH):
        Err(e):
            return Err("backend unavailable at " + ENGINE_LIB_PATH + ": " + backend_error_text(e))
        Ok(b):
            match load_model(b, model.entry_path, -1):
                Err(e):
                    close_backend(b)
                    return Err("load failed for '" + model.id + "': " + backend_error_text(e))
                Ok(_):
                    match open_context(b, ENGINE_N_CTX):
                        Err(e):
                            close_backend(b)
                            return Err("context failed for '" + model.id + "': " + backend_error_text(e))
                        Ok(_):
                            ENGINE_BACKEND = b
                            ENGINE_LOADED_ID = model.id
                            Ok(())

fn engine_generate(prompt: text, max_tokens: i64) -> Result<text, text>:
    if ENGINE_BACKEND == nil:
        return Err("no model is resident")
    var budget = max_tokens
    if budget <= 0:
        budget = 256
    match generate(ENGINE_BACKEND!, prompt, budget):
        Err(e):
            Err(backend_error_text(e))
        Ok(txt):
            Ok(txt)

# Load-and-generate in one step, which is what an HTTP handler wants: it has a
# model name and a prompt and no business knowing whether a load is needed.
fn engine_complete(model_root: text, model_id: text, prompt: text, max_tokens: i64) -> Result<text, text>:
    var found: NativeModel? = nil
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.id == model_id:
            found = m
    if found == nil:
        return Err("model '" + model_id + "' was not found under " + model_root)
    match engine_ensure_loaded(found!):
        Err(reason):
            Err(reason)
        Ok(_):
            engine_generate(prompt, max_tokens)

export engine_set_lib_path, engine_set_n_ctx, engine_lib_path, engine_backend_available
export engine_loaded_model, engine_unload, engine_ensure_loaded, engine_generate, engine_complete
