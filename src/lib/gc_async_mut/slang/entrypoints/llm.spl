# @gc — module uses GC runtime
#
# slang offline entrypoint — mirrors vllm/entrypoints/llm.py.
#
# The in-process counterpart to entrypoints/openai/. Same engine, same
# residency and same memory admission; no socket. vLLM ships both for the same
# reason slang does: a caller inside the process should not have to stand up an
# HTTP server, serialise a request and talk to itself to run a prompt.
#
# It is also the path that works today. slang's HTTP surface is currently
# unreachable on the bootstrap seed for two reasons that have nothing to do
# with slang -- see
#   doc/08_tracking/bug/seed_jit_cannot_resolve_text_dot_from_char_code_2026-09-04.md
#   doc/08_tracking/bug/seed_http_server_handle_connection_dispatch_2026-09-04.md
# -- so this entrypoint is what lets a caller reach a real model until a
# pure-Simple binary is deployed.

use std.gc_async_mut.slang.engine.llm_engine.{engine_complete, engine_backend_available, engine_lib_path, engine_set_lib_path, engine_set_n_ctx, engine_loaded_model, engine_unload}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, scan_model_root}

# One answer, plus the provenance a caller needs to know it was real. `backend`
# names what produced the tokens, so a caller can never mistake a stubbed reply
# for a generated one -- there is no code path here that fills `content` without
# a model having produced it.
struct SlangCompletion:
    content: text
    model: text
    backend: text
    is_error: bool
    error: text

fn slang_models(model_root: text) -> [NativeModel]:
    scan_model_root(model_root, engine_backend_available())

# Configure and run in one call. `lib_path` empty keeps the engine's default.
fn slang_generate(model_root: text, model_id: text, prompt: text, max_tokens: i64, lib_path: text, n_ctx: i64) -> SlangCompletion:
    if lib_path != "":
        engine_set_lib_path(lib_path)
    if n_ctx > 0:
        engine_set_n_ctx(n_ctx)
    if prompt.trim() == "":
        return SlangCompletion(content: "", model: model_id, backend: "none",
            is_error: true, error: "prompt is empty")
    match engine_complete(model_root, model_id, prompt, max_tokens):
        Err(reason):
            SlangCompletion(content: "", model: model_id, backend: "none",
                is_error: true, error: reason)
        Ok(text_out):
            SlangCompletion(content: text_out, model: model_id, backend: "ggml",
                is_error: false, error: "")

fn slang_release():
    engine_unload()

export SlangCompletion, slang_models, slang_generate, slang_release
export engine_backend_available, engine_lib_path, engine_loaded_model
