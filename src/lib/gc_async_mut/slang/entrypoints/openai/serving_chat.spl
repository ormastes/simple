# @gc — module uses GC runtime
#
# /v1/chat/completions handler.
#
# THE RULE THIS FILE ENFORCES: a completion is returned only when a model
# actually produced one. Everything else is a typed error naming what is
# missing. Canned prose returned here would be indistinguishable from real
# inference to the caret client, which is the one outcome this file exists to
# prevent — and it stayed a pure stub for exactly as long as slang had no way
# to run a forward pass.
#
# It now has one. A GGUF model, with the ggml backend built, is served by the
# engine in std.gc_async_mut.slang.engine.llm_engine: slang owns the decode
# loop, the residency decision and the memory budget; ggml supplies the
# kernels. Every OTHER case still refuses:
#   - a slang pack     -> 503, byte-for-byte the SAME announced-stub payload it
#                        returned before this file gained an engine at all,
#                        with the SAME stub payload it returned before
#   - safetensors      -> 503, the ggml backend reads GGUF only
#   - no backend built -> 503, naming the library that is absent
#   - will not fit     -> 503, naming the arithmetic that refused it

use std.gc_async_mut.slang.entrypoints.openai.protocol.{ApiResponse, parse_chat_request, openai_error_response, openai_chat_completion_response, json_string_field_last}
use std.gc_async_mut.slang.entrypoints.openai.serving_models.{SlangModelEntry, discover_models, find_model}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, scan_model_root}
use std.gc_async_mut.slang.engine.llm_engine.{engine_backend_available, engine_complete, engine_lib_path}

# The most advanced phase of slang's OWN engine that is actually present.
# Unchanged at A1, deliberately: the ggml backend routes AROUND the native
# inference path rather than implementing any part of it, so neither this value
# nor the list below may move on account of it. The ggml-backed path announces
# itself separately, through engine_refusal_response's `"stub":false` and
# `"backend":"ggml"`, precisely so these two fields keep meaning exactly what
# they meant before that path existed.
fn slang_implemented_phase() -> text:
    "A1"

# Phases the native inference path still needs. Unchanged, for the same reason.
fn slang_missing_inference_phases() -> [text]:
    ["A3", "A4", "A5"]

fn _missing_phases_json() -> text:
    var joined = ""
    var i = 0
    val phases = slang_missing_inference_phases()
    while i < phases.len():
        if i > 0:
            joined = joined + ","
        joined = joined + "\"" + phases[i] + "\""
        i = i + 1
    "[" + joined + "]"

fn _not_runnable_detail(entry: SlangModelEntry) -> text:
    "\"slang\":{\"stub\":true,\"engine\":\"slang\",\"implemented_phase\":\"" + slang_implemented_phase() + "\",\"missing_inference_phases\":" + _missing_phases_json() + ",\"pack_root\":\"" + entry.pack_root + "\",\"tensor_count\":" + entry.tensor_count.to_text() + ",\"chunk_count\":" + entry.chunk_count.to_text() + ",\"design_doc\":\"doc/05_design/ml/slang/slang_master_plan.md\"}"

fn model_not_runnable_response(entry: SlangModelEntry) -> ApiResponse:
    val message = "model '" + entry.id + "' is present on disk and its manifest parsed (" + entry.tensor_count.to_text() + " tensors, " + entry.chunk_count.to_text() + " chunks), but slang has no native executor for a slang pack: phases A3/A4/A5 (streaming loader, paged KV cache + paged attention, scheduler/worker/engine) are absent. This build will not fabricate a completion."
    openai_error_response(503, message, "server_error", "model_not_runnable", _not_runnable_detail(entry))

fn model_not_found_response(model: text) -> ApiResponse:
    openai_error_response(404, "model '" + model + "' was not found under the configured slang model root", "invalid_request_error", "model_not_found", "")

# A refusal from the engine. The engine's own reason is passed through verbatim
# rather than being summarised: it already names the format, the missing
# backend or the memory arithmetic, and rewording it here would only lose that.
fn engine_refusal_response(model: text, reason: text) -> ApiResponse:
    val detail = "\"slang\":{\"stub\":false,\"engine\":\"slang\",\"backend\":\"ggml\",\"backend_library\":\"" + engine_lib_path() + "\",\"backend_available\":" + (if engine_backend_available(): "true" else: "false") + ",\"implemented_phase\":\"" + slang_implemented_phase() + "\",\"missing_inference_phases\":" + _missing_phases_json() + "}"
    openai_error_response(503, "model '" + model + "' cannot be served: " + reason, "server_error", "model_not_runnable", detail)

# The prompt is the newest message's content. Requests with no readable content
# are refused rather than served an empty prompt, which a model would answer
# with plausible noise.
fn _prompt_from_body(body: text) -> text:
    json_string_field_last(body, "content")

fn serve_chat_completions(model_root: text, body: text) -> ApiResponse:
    match parse_chat_request(body):
        Err(reason):
            openai_error_response(400, reason, "invalid_request_error", "invalid_request", "")
        Ok(request):
            val prompt = _prompt_from_body(body)
            if prompt.trim() == "":
                return openai_error_response(400, "no readable message content in the request", "invalid_request_error", "invalid_request", "")
            # A native slang pack is answered by the pack-aware refusal, which
            # can report tensor and chunk counts the generic path cannot.
            val pack = find_model(discover_models(model_root), request.model)
            if pack != nil:
                return model_not_runnable_response(pack!)
            var found: NativeModel? = nil
            for m in scan_model_root(model_root, engine_backend_available()):
                if m.id == request.model:
                    found = m
            if found == nil:
                return model_not_found_response(request.model)
            match engine_complete(model_root, request.model, prompt, request.max_tokens):
                Err(reason):
                    engine_refusal_response(request.model, reason)
                Ok(content):
                    openai_chat_completion_response(request.model, content, 0, 0)

export slang_implemented_phase, slang_missing_inference_phases
export model_not_runnable_response, model_not_found_response, engine_refusal_response
export serve_chat_completions
