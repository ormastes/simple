# @gc — module uses GC runtime
#
# /v1/chat/completions handler.
#
# THE RULE THIS FILE ENFORCES: a completion is returned only when a model
# actually produced one. Everything else is a typed error naming what is
# missing. Canned prose returned here would be indistinguishable from real
# inference to the caret client, which is the one outcome this file exists to
# prevent — and it stayed a pure stub for exactly as long as slang had no way
# to run a forward pass.
#
# It now has one. A GGUF model, with the ggml backend built, is served by the
# engine in std.gc_async_mut.slang.engine.llm_engine: slang owns the decode
# loop, the residency decision and the memory budget; ggml supplies the
# kernels. A safetensors Llama the pure runner supports is served by the pure
# runner; the engine's select_runner (engine/runner_dispatch.spl) picks, and
# SLANG_RUNNER=pure|ggml forces. Every OTHER case still refuses:
#   - a slang pack     -> 503, byte-for-byte the SAME announced-stub payload it
#                        returned before this file gained an engine at all,
#                        with the SAME stub payload it returned before
#   - other safetensors -> 503, no runner supports it (reason names why)
#   - no backend built -> 503, naming the library that is absent
#   - will not fit     -> 503, naming the arithmetic that refused it

use std.gc_async_mut.slang.modality.video_frames.{video_ffmpeg_path, video_max_bytes, video_max_parts, video_reason_is_server_fault, video_frame_count, sample_frames}
use std.common.base_encoding.base64.{base64_encode_bytes}
use std.io_runtime.{file_exists}
use std.gc_async_mut.slang.entrypoints.openai.protocol.{ApiResponse, ChatMessage, ChatPart, ChatRequest, chat_message_media_count, parse_chat_request, openai_error_response, openai_chat_completion_response, openai_chat_completion_response_finish, chat_messages_from_body, chat_messages_parse}
use std.gc_async_mut.slang.entrypoints.openai.serving_models.{SlangModelEntry, discover_models, find_model}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, scan_model_root}
use std.gc_async_mut.slang.engine.llm_engine.{engine_backend_available, engine_complete_chat_stops, engine_complete_chat_media, engine_media_caps_for, engine_lib_path}
use std.gc_async_mut.slang.engine.runner_dispatch.{RunnerKind, select_runner}
use std.gc_async_mut.slang.model_executor.backend.{MediaBlob}
use std.common.base_encoding.base64.{base64_decode_bytes}
use std.gc_async_mut.slang.model_executor.backend.{chat_frame, SLANG_MEDIA_MARKER}

# The most advanced phase of slang's OWN engine that is actually present.
# Unchanged at A1, deliberately: the ggml backend routes AROUND the native
# inference path rather than implementing any part of it, so neither this value
# nor the list below may move on account of it. The ggml-backed path announces
# itself separately, through engine_refusal_response's `"stub":false` and
# `"backend":"ggml"`, precisely so these two fields keep meaning exactly what
# they meant before that path existed.
fn slang_implemented_phase() -> text:
    "A1"

# Phases the native inference path still needs. Unchanged, for the same reason.
fn slang_missing_inference_phases() -> [text]:
    ["A3", "A4", "A5"]

fn _missing_phases_json() -> text:
    var joined = ""
    var i = 0
    val phases = slang_missing_inference_phases()
    while i < phases.len():
        if i > 0:
            joined = joined + ","
        joined = joined + "\"" + phases[i] + "\""
        i = i + 1
    "[" + joined + "]"

fn _not_runnable_detail(entry: SlangModelEntry) -> text:
    "\"slang\":{\"stub\":true,\"engine\":\"slang\",\"implemented_phase\":\"" + slang_implemented_phase() + "\",\"missing_inference_phases\":" + _missing_phases_json() + ",\"pack_root\":\"" + entry.pack_root + "\",\"tensor_count\":" + entry.tensor_count.to_text() + ",\"chunk_count\":" + entry.chunk_count.to_text() + ",\"design_doc\":\"doc/05_design/ml/slang/slang_master_plan.md\"}"

fn model_not_runnable_response(entry: SlangModelEntry) -> ApiResponse:
    val message = "model '" + entry.id + "' is present on disk and its manifest parsed (" + entry.tensor_count.to_text() + " tensors, " + entry.chunk_count.to_text() + " chunks), but slang has no native executor for a slang pack: phases A3/A4/A5 (streaming loader, paged KV cache + paged attention, scheduler/worker/engine) are absent. This build will not fabricate a completion."
    openai_error_response(503, message, "server_error", "model_not_runnable", _not_runnable_detail(entry))

fn model_not_found_response(model: text) -> ApiResponse:
    openai_error_response(404, "model '" + model + "' was not found under the configured slang model root", "invalid_request_error", "model_not_found", "")

# A refusal from the engine. The engine's own reason is passed through verbatim
# rather than being summarised: it already names the format, the missing
# backend or the memory arithmetic, and rewording it here would only lose that.
fn engine_refusal_response(model: text, reason: text) -> ApiResponse:
    val detail = "\"slang\":{\"stub\":false,\"engine\":\"slang\",\"backend\":\"ggml\",\"backend_library\":\"" + engine_lib_path() + "\",\"backend_available\":" + (if engine_backend_available(): "true" else: "false") + ",\"implemented_phase\":\"" + slang_implemented_phase() + "\",\"missing_inference_phases\":" + _missing_phases_json() + "}"
    openai_error_response(503, "model '" + model + "' cannot be served: " + reason, "server_error", "model_not_runnable", detail)

# The prompt is EVERY message, in order: a client that sends a system prompt
# and the running history (an agent tool loop does both) must have the model
# see all of it. Requests with no readable content are refused rather than
# served an empty prompt, which a model would answer with plausible noise.
# Each media part becomes one SLANG_MEDIA_MARKER at its place in the message,
# so a model that can take the medium sees it exactly where the client put it.
# A message holding only media is readable: the marker is its content.
fn chat_frames_from_messages(messages: [ChatMessage]) -> text:
    var framed = ""
    var readable = false
    for message in messages:
        var content = ""
        for part in message.parts:
            if part.kind == "text":
                content = content + part.text
            else:
                content = content + SLANG_MEDIA_MARKER
        if content.trim() != "":
            readable = true
        framed = framed + chat_frame(message.role, content)
    if readable:
        framed
    else:
        ""

fn chat_frames_from_body(body: text) -> text:
    chat_frames_from_messages(chat_messages_from_body(body))

fn _unsupported_modality(message: text) -> ApiResponse:
    openai_error_response(400, message, "invalid_request_error", "unsupported_modality", "")

# Refuses media the served model cannot take, BEFORE any generation: answering
# such a request as text-only would be a fabricated answer about an image or a
# recording the model never saw. Ok means every part can be served.
fn media_refusal(model_id: text, messages: [ChatMessage], projector: text) -> Result<(), ApiResponse>:
    var video = 0
    var media = 0
    for message in messages:
        for part in message.parts:
            if part.kind == "video":
                video = video + 1
                media = media + 1
            elif part.kind != "text":
                media = media + 1
    # With an ffmpeg configured, a video part that is still here belongs to a
    # request whose model has no projector; the text-only refusal below says so.
    # Each video part costs two ffmpeg runs; a request with many of them would
    # hold the handler for minutes.
    if video > video_max_parts():
        return Err(openai_error_response(400, "the request carries " + video.to_text() + " video parts; slang takes at most " + video_max_parts().to_text() + " per request", "invalid_request_error", "too_many_video_parts", ""))
    if video > 0 and video_ffmpeg_path() == "":
        return Err(_unsupported_modality("video input is not supported by this slang build: slang has no video container decoder of its own and does not run external tools such as ffmpeg/ffprobe; send sampled frames as image_url parts instead"))
    if media > 0 and projector == "":
        return Err(_unsupported_modality("model '" + model_id + "' accepts text only (no multimodal projector next to the model); the request carries " + media.to_text() + " image/audio/video part(s) and slang will not answer it as if they were absent"))
    Ok(())

# Replaces every video part by its sampled JPEG frames, as image parts at the
# video's place in the message (design §4), so the image path serves them.
# Err is the response to send: 413 for a video over the size bound, 503 when
# SLANG_FFMPEG names no file, 400 when the video yields no frame.
fn expand_video_parts(messages: [ChatMessage]) -> Result<[ChatMessage], ApiResponse>:
    var expanded: [ChatMessage] = []
    for message in messages:
        var parts: [ChatPart] = []
        for part in message.parts:
            if part.kind != "video":
                parts.push(part)
            else:
                val blob = base64_decode_bytes(part.data)
                if blob.len() > video_max_bytes():
                    return Err(openai_error_response(413, "video is " + blob.len().to_text() + " bytes; slang takes at most " + video_max_bytes().to_text() + " bytes of video per part", "invalid_request_error", "request_too_large", ""))
                if not file_exists(video_ffmpeg_path()):
                    return Err(openai_error_response(503, "SLANG_FFMPEG is set to '" + video_ffmpeg_path() + "', which is not a file; video sampling is unavailable", "server_error", "video_decoder_unavailable", ""))
                match sample_frames(blob, video_frame_count()):
                    Err(reason):
                        if video_reason_is_server_fault(reason):
                            return Err(openai_error_response(503, "video sampling failed on the server; retry later", "server_error", "video_sampling_failed", ""))
                        return Err(openai_error_response(400, "video could not be sampled: " + reason, "invalid_request_error", "invalid_media", ""))
                    Ok(frames):
                        for frame in frames:
                            parts.push(ChatPart(kind: "image", text: "", data: base64_encode_bytes(frame), format: "jpeg"))
        expanded.push(ChatMessage(role: message.role, content: message.content, parts: parts))
    Ok(expanded)

fn media_part_count(messages: [ChatMessage]) -> i64:
    var n = 0
    for message in messages:
        n = n + chat_message_media_count(message)
    n

# The media of the request in client order, one encoded file per marker.
fn media_blobs(messages: [ChatMessage]) -> [MediaBlob]:
    var blobs: [MediaBlob] = []
    for message in messages:
        for part in message.parts:
            if part.kind != "text":
                blobs.push(MediaBlob(bytes: base64_decode_bytes(part.data)))
    blobs

# Media bit each kind needs from the projector: 1 images, 2 audio.
fn _caps_missing(caps: i64, messages: [ChatMessage]) -> text:
    for message in messages:
        for part in message.parts:
            if part.kind == "image" and (caps & 1) == 0:
                return "image"
            if part.kind == "audio" and (caps & 2) == 0:
                return "audio"
    ""

# A request with image/audio parts for a model that has a projector directory
# entry. The model is loaded first because only the loaded projector knows
# whether this backend build and this model really take the medium.
fn serve_media_chat(model_root: text, model_id: text, framed: text, messages: [ChatMessage], max_tokens: i64) -> ApiResponse:
    match engine_media_caps_for(model_root, model_id):
        Err(reason):
            return engine_refusal_response(model_id, reason)
        Ok(caps):
            if caps <= 0:
                return _unsupported_modality("model '" + model_id + "' has a multimodal projector but this slang backend cannot use it (shim built without mtmd, or the projector failed to load); slang will not answer the request as if the media were absent")
            val missing = _caps_missing(caps, messages)
            if missing != "":
                return _unsupported_modality("model '" + model_id + "' does not accept " + missing + " input")
    match engine_complete_chat_media(model_id, framed, media_blobs(messages), max_tokens):
        Err(reason):
            if reason.find("media was rejected") >= 0:
                return openai_error_response(400, reason, "invalid_request_error", "invalid_media", "")
            engine_refusal_response(model_id, reason)
        Ok(content):
            openai_chat_completion_response(model_id, content, 0, 0)
# The same conversation as plain text, for a runner with no chat template (the
# pure runner on a base model such as stories15M): the non-empty message
# contents in order, newline-separated, with no role names or special tokens.
fn chat_plain_prompt_from_body(body: text) -> text:
    var parts: [text] = []
    for message in chat_messages_from_body(body):
        if message.content.trim() != "":
            parts.push(message.content)
    parts.join("\n")

# A chat request that passed every check that does not need the engine: parsed,
# readable, addressed to a model that exists on disk and can take its media.
struct ChatPlan:
    request: ChatRequest
    messages: [ChatMessage]
    framed: text
    model: NativeModel

fn chat_prepare(model_root: text, body: text) -> Result<ChatPlan, ApiResponse>:
    match parse_chat_request(body):
        Err(reason):
            Err(openai_error_response(400, reason, "invalid_request_error", "invalid_request", ""))
        Ok(request):
            var messages: [ChatMessage] = []
            match chat_messages_parse(body):
                Err(error):
                    return Err(openai_error_response(400, error.message, "invalid_request_error", error.code, ""))
                Ok(parsed):
                    messages = parsed
            val framed = chat_frames_from_messages(messages)
            if framed == "":
                return Err(openai_error_response(400, "no readable message content in the request", "invalid_request_error", "invalid_request", ""))
            # A native slang pack is answered by the pack-aware refusal, which
            # can report tensor and chunk counts the generic path cannot.
            val pack = find_model(discover_models(model_root), request.model)
            if pack != nil:
                return Err(model_not_runnable_response(pack!))
            var found: NativeModel? = nil
            for m in scan_model_root(model_root, engine_backend_available()):
                if m.id == request.model:
                    found = m
            if found == nil:
                return Err(model_not_found_response(request.model))
            # Refusals (video-part cap, text-only model) run on the request as
            # sent, BEFORE expansion: expansion turns video parts into images,
            # so a cap checked afterwards would never see them.
            match media_refusal(request.model, messages, found!.mmproj_path):
                Err(refusal):
                    return Err(refusal)
                Ok(_): ()
            var served = messages
            var served_frames = framed
            if found!.mmproj_path != "" and video_ffmpeg_path() != "":
                match expand_video_parts(messages):
                    Err(refusal):
                        return Err(refusal)
                    Ok(expanded):
                        served = expanded
                        served_frames = chat_frames_from_messages(expanded)
            match media_refusal(request.model, served, found!.mmproj_path):
                Err(refusal):
                    return Err(refusal)
                Ok(_): ()
            Ok(ChatPlan(request: request, messages: served, framed: served_frames, model: found!))

fn serve_chat_completions(model_root: text, body: text) -> ApiResponse:
    match parse_chat_request(body):
        Err(reason):
            return openai_error_response(400, reason, "invalid_request_error", "invalid_request", "")
        Ok(early):
            if early.stream:
                return openai_error_response(400, "stream=true needs the streaming transport (serving_stream.spl); this dispatcher returns whole bodies only", "invalid_request_error", "invalid_request", "")
    match chat_prepare(model_root, body):
        Err(refusal):
            refusal
        Ok(plan):
            val request = plan.request
            if media_part_count(plan.messages) > 0:
                match select_runner(plan.model):
                    Ok(RunnerKind.Pure):
                        return _unsupported_modality("model '" + request.model + "' is served by the pure runner, which is text only; the request carries image/audio part(s) and slang will not route them to another runner or answer as if they were absent")
                    _: ()
                return serve_media_chat(model_root, request.model, plan.framed, plan.messages, request.max_tokens)
            match engine_complete_chat_stops(model_root, request.model, plan.framed, chat_plain_prompt_from_body(body), request.max_tokens, request.stop):
                Err(reason):
                    engine_refusal_response(request.model, reason)
                Ok(done):
                    openai_chat_completion_response_finish(request.model, done.content, done.prompt_tokens, done.completion_tokens, done.finish_reason)

export slang_implemented_phase, slang_missing_inference_phases
export model_not_runnable_response, model_not_found_response, engine_refusal_response
export serve_chat_completions, chat_frames_from_body, chat_frames_from_messages, chat_plain_prompt_from_body, media_refusal
export ChatPlan, chat_prepare, media_part_count
