# @gc — module uses GC runtime
#
# /v1/images/generations — stub until lane L6 (image generation) replaces this file.
# Design: doc/05_design/ml/slang/slang_pluggable_modalities.md §3.5.
# A model of another kind is 400 wrong_model_kind; a ImageGen model is 501
# not_implemented with the runner's reason.

use std.gc_async_mut.slang.entrypoints.openai.protocol.{ApiResponse}
use std.gc_async_mut.slang.entrypoints.openai.serving_models.{model_for_kind, kind_not_implemented_response}
use std.gc_async_mut.slang.modality.kinds.{ModelKind}

fn serve_images(model_root: text, body: text) -> ApiResponse:
    match model_for_kind(model_root, body, ModelKind.ImageGen, "/v1/images/generations"):
        Err(refusal): refusal
        Ok(model): kind_not_implemented_response(model, "/v1/images/generations")

export serve_images
