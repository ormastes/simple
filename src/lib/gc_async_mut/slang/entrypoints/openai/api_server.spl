# @gc — module uses GC runtime
#
# OpenAI-compatible request dispatcher — phase A6.
#
# Transport-free by design: the caller hands over a method, a path, a body and
# the model root, and gets back a status plus a JSON body. src/app/slang_server/
# is the only place that owns a socket, so the whole routing contract below is
# provable from a unit spec.
#
# Routes:
#   GET  /v1/models           -> 200 model list (empty list when no packs)
#   POST /v1/chat/completions -> 400 / 404 / 503, see serving_chat.spl
#   POST /v1/completions      -> legacy text completion (raw prompt, no chat template)
#   GET  /health              -> 200 {"status":"ok"}
#   POST /v1/audio/transcriptions, /v1/audio/speech, /v1/images/generations,
#        /v1/embeddings, /v1/rerank -> serving/ modules (kind_routes below)
# A route asked for a model of another kind answers 400 wrong_model_kind.
# Anything else is 404; a known path with the wrong method is 405.
# stream=true is served by serving_stream.spl over a socket; this transport-free
# dispatcher returns whole bodies, so it answers stream=true with a 400.

use std.gc_async_mut.slang.entrypoints.openai.protocol.{ApiResponse, openai_error_response, openai_models_response, openai_text_completion_response, parse_completion_request}
use std.gc_async_mut.slang.entrypoints.openai.serving_models.{discover_models, model_ids, models_list_response, kind_mismatch}
use std.gc_async_mut.slang.entrypoints.openai.protocol.{json_string_field}
use std.gc_async_mut.slang.entrypoints.openai.serving.serving_transcriptions.{serve_transcriptions}
use std.gc_async_mut.slang.entrypoints.openai.serving.serving_speech.{serve_speech}
use std.gc_async_mut.slang.entrypoints.openai.serving.serving_images.{serve_images}
use std.gc_async_mut.slang.entrypoints.openai.serving.serving_pooling.{serve_embeddings, serve_rerank}
use std.gc_async_mut.slang.modality.kinds.{ModelKind}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel, scan_model_root}
use std.gc_async_mut.slang.engine.llm_engine.{engine_backend_available, engine_complete_text_stops}
use std.gc_async_mut.slang.entrypoints.openai.serving_chat.{serve_chat_completions, model_not_found_response, engine_refusal_response}

fn _strip_query(path: text) -> text:
    val at = path.find("?")
    if at < 0:
        return path
    path.slice(0, at)

fn _normalize(path: text) -> text:
    val bare = _strip_query(path).trim()
    if bare.len() > 1 and bare.ends_with("/"):
        return bare.slice(0, bare.byte_len() - 1)
    bare

# Everything under the model root that slang RECOGNISES, whether or not it can
# run it. Listing only runnable models would leave a client unable to tell an
# empty directory from three models in a format this build cannot execute --
# which is exactly what /v1/models did before, silently, for real HuggingFace
# checkouts. The reason a model is not runnable is reported by
# /v1/chat/completions, which is where a client asks for one.
# Each entry carries slang_kind, input_modalities and output_modalities.
fn serve_models(model_root: text) -> ApiResponse:
    var natives: [NativeModel] = []
    for m in scan_model_root(model_root, engine_backend_available()):
        if m.format != "slang-pack" and m.format != "unknown":
            natives.push(m)
    models_list_response(discover_models(model_root), natives, "slang")

# The route table: path -> the model kind it serves. Chat routes are handled
# above it by serving_chat; each other route has one serving/ module.
struct KindRoute:
    path: text
    kind: ModelKind

fn kind_routes() -> [KindRoute]:
    [KindRoute(path: "/v1/chat/completions", kind: ModelKind.Chat),
     KindRoute(path: "/v1/completions", kind: ModelKind.Chat),
     KindRoute(path: "/v1/audio/transcriptions", kind: ModelKind.Asr),
     KindRoute(path: "/v1/audio/speech", kind: ModelKind.Tts),
     KindRoute(path: "/v1/images/generations", kind: ModelKind.ImageGen),
     KindRoute(path: "/v1/embeddings", kind: ModelKind.Embedding),
     KindRoute(path: "/v1/rerank", kind: ModelKind.Rerank)]

fn _serve_kind_route(route: text, model_root: text, body: text) -> ApiResponse:
    if route == "/v1/audio/transcriptions":
        return serve_transcriptions(model_root, body)
    if route == "/v1/audio/speech":
        return serve_speech(model_root, body)
    if route == "/v1/images/generations":
        return serve_images(model_root, body)
    if route == "/v1/embeddings":
        return serve_embeddings(model_root, body)
    serve_rerank(model_root, body)

# 400 wrong_model_kind before a chat route runs a model of another kind.
fn _chat_kind_check(model_root: text, body: text, route: text) -> Result<(), ApiResponse>:
    var natives: [NativeModel] = []
    for m in scan_model_root(model_root, engine_backend_available()):
        natives.push(m)
    kind_mismatch(natives, json_string_field(body, "model"), ModelKind.Chat, route)

fn serve_completions(model_root: text, body: text) -> ApiResponse:
    match parse_completion_request(body):
        Err(reason):
            openai_error_response(400, reason, "invalid_request_error", "invalid_request", "")
        Ok(request):
            if request.stream:
                return openai_error_response(400, "stream=true needs the streaming transport (serving_stream.spl); this dispatcher returns whole bodies only", "invalid_request_error", "invalid_request", "")
            var known = false
            for m in scan_model_root(model_root, engine_backend_available()):
                if m.id == request.model:
                    known = true
            if not known:
                return model_not_found_response(request.model)
            match engine_complete_text_stops(model_root, request.model, request.prompt, request.max_tokens, request.stop):
                Err(reason):
                    engine_refusal_response(request.model, reason)
                Ok(done):
                    openai_text_completion_response(request.model, done.content, done.prompt_tokens, done.completion_tokens, done.finish_reason)

fn slang_api_dispatch(method: text, path: text, body: text, model_root: text) -> ApiResponse:
    val route = _normalize(path)
    val verb = method.trim().to_upper()
    if route == "/v1/models":
        if verb != "GET":
            return openai_error_response(405, "method " + verb + " is not allowed on /v1/models", "invalid_request_error", "method_not_allowed", "")
        return serve_models(model_root)
    if route == "/v1/chat/completions":
        if verb != "POST":
            return openai_error_response(405, "method " + verb + " is not allowed on /v1/chat/completions", "invalid_request_error", "method_not_allowed", "")
        match _chat_kind_check(model_root, body, route):
            Err(refusal):
                return refusal
            Ok(_): ()
        return serve_chat_completions(model_root, body)
    if route == "/v1/completions":
        if verb != "POST":
            return openai_error_response(405, "method " + verb + " is not allowed on /v1/completions", "invalid_request_error", "method_not_allowed", "")
        match _chat_kind_check(model_root, body, route):
            Err(refusal):
                return refusal
            Ok(_): ()
        return serve_completions(model_root, body)
    for r in kind_routes():
        if r.path == route:
            if verb != "POST":
                return openai_error_response(405, "method " + verb + " is not allowed on " + route, "invalid_request_error", "method_not_allowed", "")
            return _serve_kind_route(route, model_root, body)
    if route == "/health":
        if verb != "GET":
            return openai_error_response(405, "method " + verb + " is not allowed on /health", "invalid_request_error", "method_not_allowed", "")
        return ApiResponse(status: 200, body: "{\"status\":\"ok\"}")
    openai_error_response(404, "unknown route " + route, "invalid_request_error", "not_found", "")

export serve_models, serve_completions, slang_api_dispatch, KindRoute, kind_routes
