# @gc — module uses GC runtime
#
# OpenAI-compatible request dispatcher — phase A6.
#
# Transport-free by design: the caller hands over a method, a path, a body and
# the model root, and gets back a status plus a JSON body. src/app/slang_server/
# is the only place that owns a socket, so the whole routing contract below is
# provable from a unit spec.
#
# Routes:
#   GET  /v1/models           -> 200 model list (empty list when no packs)
#   POST /v1/chat/completions -> 400 / 404 / 503, see serving_chat.spl
# Anything else is 404; a known path with the wrong method is 405.
# Streaming is out of scope and is rejected as a 400 by the request parser.

use std.gc_async_mut.slang.entrypoints.openai.protocol.{ApiResponse, openai_error_response, openai_models_response}
use std.gc_async_mut.slang.entrypoints.openai.serving_models.{discover_models, model_ids}
use std.gc_async_mut.slang.entrypoints.openai.serving_chat.{serve_chat_completions}

fn _strip_query(path: text) -> text:
    val at = path.find("?")
    if at < 0:
        return path
    path.slice(0, at)

fn _normalize(path: text) -> text:
    val bare = _strip_query(path).trim()
    if bare.len() > 1 and bare.ends_with("/"):
        return bare.slice(0, bare.len() - 1)
    bare

fn serve_models(model_root: text) -> ApiResponse:
    openai_models_response(model_ids(discover_models(model_root)), "slang")

fn slang_api_dispatch(method: text, path: text, body: text, model_root: text) -> ApiResponse:
    val route = _normalize(path)
    val verb = method.trim().to_upper()
    if route == "/v1/models":
        if verb != "GET":
            return openai_error_response(405, "method " + verb + " is not allowed on /v1/models", "invalid_request_error", "method_not_allowed", "")
        return serve_models(model_root)
    if route == "/v1/chat/completions":
        if verb != "POST":
            return openai_error_response(405, "method " + verb + " is not allowed on /v1/chat/completions", "invalid_request_error", "method_not_allowed", "")
        return serve_chat_completions(model_root, body)
    openai_error_response(404, "unknown route " + route, "invalid_request_error", "not_found", "")

export serve_models, slang_api_dispatch
