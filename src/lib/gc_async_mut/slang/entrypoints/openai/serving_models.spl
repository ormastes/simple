# @gc — module uses GC runtime
#
# Model discovery for the OpenAI-compatible surface — phase A6.
#
# The list served by GET /v1/models is derived ONLY from what the phase-A1
# loader can actually read off disk: a directory under the model root is a
# model iff it holds a manifest.sdn that `parse_manifest` accepts. Nothing is
# invented, and a root with no packs yields an empty list rather than an error.

use std.gc_async_mut.slang.model_executor.model_loader.manifest.{parse_manifest}
use std.gc_async_mut.slang.host.slang_host.{host_file_exists, host_file_read, host_dir_list, host_is_dir}
use std.gc_async_mut.slang.entrypoints.openai.protocol.{ApiResponse, json_text_literal, openai_error_response}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel}
use std.gc_async_mut.slang.modality.kinds.{KindProfile, ModelKind, Modality, kind_profile, model_kind_text, model_kind_eq, modalities_json}
use std.gc_async_mut.slang.engine.runner_dispatch.{RunnerKind}
use std.gc_async_mut.slang.engine.llm_engine.{engine_backend_available}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{describe_model}
use std.gc_async_mut.slang.entrypoints.openai.protocol.{json_string_field}

# A model the loader can see. `id` is the manifest's own model_id, so what the
# API advertises is exactly what the loader would be asked to load.
struct SlangModelEntry:
    id: text
    pack_root: text
    revision: text
    tensor_count: i64
    chunk_count: i64

fn _join(root: text, name: text) -> text:
    if root.ends_with("/"):
        return root + name
    root + "/" + name

# Read one candidate directory. Returns nil when it is not a valid pack.
fn read_model_entry(pack_root: text) -> SlangModelEntry?:
    val manifest_path = _join(pack_root, "manifest.sdn")
    if not host_file_exists(manifest_path):
        return None
    match parse_manifest(host_file_read(manifest_path)):
        Err(_):
            nil
        Ok(m):
            SlangModelEntry(
                id: m.model_id,
                pack_root: pack_root,
                revision: m.revision,
                tensor_count: m.tensor_count,
                chunk_count: m.chunk_count
            )

# Every valid pack directly under `model_root`. An unreadable or missing root
# yields an empty list.
fn discover_models(model_root: text) -> [SlangModelEntry]:
    var out: [SlangModelEntry] = []
    if model_root.trim() == "":
        return out
    match host_dir_list(model_root):
        case Some(names):
            for name in names:
                val entry = read_model_entry(_join(model_root, name))
                if entry.is_some():
                    out.push(entry!)
        case nil:
            pass
    out

fn model_ids(entries: [SlangModelEntry]) -> [text]:
    var out: [text] = []
    for e in entries:
        out.push(e.id)
    out

fn find_model(entries: [SlangModelEntry], id: text) -> SlangModelEntry?:
    for e in entries:
        if e.id == id:
            return e
    nil

# A slang pack is a text Chat model with no runner of its own yet.
fn pack_profile() -> KindProfile:
    kind_profile(ModelKind.Chat, [Modality.Text], RunnerKind.Pure, "slang pack recognised; slang has no engine of its own yet (master plan A3/A4/A5)")

fn _model_json(id: text, owner: text, p: KindProfile) -> text:
    "{\"id\":" + json_text_literal(id) + ",\"object\":\"model\",\"created\":0,\"owned_by\":" + json_text_literal(owner) + ",\"slang_kind\":\"" + model_kind_text(p.kind) + "\",\"input_modalities\":" + modalities_json(p.inputs) + ",\"output_modalities\":" + modalities_json(p.outputs) + "}"

# GET /v1/models: every slang pack plus every recognised native model, each
# with its slang_kind and input/output modalities.
fn models_list_response(packs: [SlangModelEntry], natives: [NativeModel], owner: text) -> ApiResponse:
    var data = ""
    for e in packs:
        if data != "":
            data = data + ","
        data = data + _model_json(e.id, owner, pack_profile())
    for m in natives:
        if data != "":
            data = data + ","
        data = data + _model_json(m.id, owner, m.profile)
    ApiResponse(status: 200, body: "{\"object\":\"list\",\"data\":[" + data + "]}")

# The native model directory named `id` directly under `model_root`, described
# alone (no root scan). `id` is matched against the directory listing, never
# joined into a path unchecked.
fn native_model_named(model_root: text, id: text) -> NativeModel?:
    if id == "" or model_root.trim() == "":
        return None
    match host_dir_list(model_root):
        case Some(names):
            for name in names:
                if name == id:
                    val dir = _join(model_root, name)
                    if host_is_dir(dir):
                        val m = describe_model(dir, engine_backend_available())
                        # An empty or unrecognised directory is not a model:
                        # /v1/models does not list it, so a route says 404.
                        if m.format == "unknown":
                            return None
                        return Some(m)
        case None:
            pass
    None

# True when a slang pack under `model_root` advertises `id` as its manifest
# model_id (the id /v1/models lists for it, which need not be the dir name).
fn _pack_named(model_root: text, id: text) -> bool:
    for e in discover_models(model_root):
        if e.id == id:
            return true
    false

fn _wrong_kind_response(id: text, have: ModelKind, want: ModelKind, route: text) -> ApiResponse:
    openai_error_response(400, "model '" + id + "' is a " + model_kind_text(have) + " model; " + route + " needs a " + model_kind_text(want) + " model", "invalid_request_error", "wrong_model_kind", "")

# True when a model with profile `p` can serve a `want` route. A kind serves
# its own route; a Chat model whose inputs include Audio also serves Asr
# (design §2: ASR path (a), an audio-LLM with a transcription prompt).
fn kind_serves(p: KindProfile, want: ModelKind) -> bool:
    if model_kind_eq(p.kind, want):
        return true
    if model_kind_eq(want, ModelKind.Asr) and model_kind_eq(p.kind, ModelKind.Chat):
        for m in p.inputs:
            match m:
                Modality.Audio: return true
                _: ()
    false

# 400 wrong_model_kind when the native model `id` resolves to a kind other than
# `want`; Ok when it matches or is not a native model (the route handler
# reports a missing model itself).
fn kind_mismatch(model_root: text, id: text, want: ModelKind, route: text) -> Result<(), ApiResponse>:
    match native_model_named(model_root, id):
        case Some(m):
            if not kind_serves(m.profile, want):
                return Err(_wrong_kind_response(id, m.profile.kind, want, route))
        case None:
            if id != "" and _pack_named(model_root, id) and not kind_serves(pack_profile(), want):
                return Err(_wrong_kind_response(id, pack_profile().kind, want, route))
    Ok(())

# The native model a kind route is asked for: 400 when the body names none,
# 404 when it is not under the model root, 400 wrong_model_kind when it
# resolves to another kind.
fn model_for_kind(model_root: text, body: text, want: ModelKind, route: text) -> Result<NativeModel, ApiResponse>:
    val id = json_string_field(body, "model")
    if id == "":
        return Err(openai_error_response(400, "missing or empty required field: model", "invalid_request_error", "invalid_request", ""))
    match native_model_named(model_root, id):
        case Some(m):
            if not kind_serves(m.profile, want):
                return Err(_wrong_kind_response(id, m.profile.kind, want, route))
            return Ok(m)
        case None:
            # A pack is listed by its manifest model_id; it is a Chat model, so
            # a kind route asked for it is the wrong kind, not a missing model.
            if _pack_named(model_root, id):
                return Err(_wrong_kind_response(id, pack_profile().kind, want, route))
    Err(openai_error_response(404, "model '" + id + "' was not found under the configured slang model root", "invalid_request_error", "model_not_found", ""))

export SlangModelEntry, read_model_entry, discover_models, model_ids, find_model
export pack_profile, models_list_response, native_model_named, kind_serves, kind_mismatch, model_for_kind
