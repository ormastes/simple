# Releases the model, context and sampler, then the library itself. Callers that
# stop a model mid-session rely on this leaving no handle behind.
fn close_backend(b: GgmlBackend) -> Result<(), BackendError>:
    if _call0(b.f_free) < 0:
        return Err(BackendError.NotOpen)
    spl_dlclose(b.lib)
    Ok(())

