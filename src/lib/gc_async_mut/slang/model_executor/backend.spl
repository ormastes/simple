        return Err(BackendError.PhysicalPageOperationFailed)
    val abort_fptr = b.f_page_table_abort
    if boundary_token_index < 0 or boundary_position < 0:
        _call1(abort_fptr, transaction)
        return Err(BackendError.PhysicalPageOperationFailed)
    if _call3(b.f_page_boundary_logits, transaction, boundary_token_index,
              boundary_position) != 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    Ok(())

fn physical_page_table_commit(b: GgmlBackend,
                              transaction: i64) -> Result<(), BackendError>:
    if b.physical_page_status != PhysicalPageProviderStatus.Ready:
        return Err(BackendError.PhysicalPagesUnavailable)
    if transaction <= 0 or _call1(b.f_page_table_commit, transaction) != 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    Ok(())

fn physical_page_table_abort(b: GgmlBackend,
                             transaction: i64) -> Result<(), BackendError>:
    if b.physical_page_status != PhysicalPageProviderStatus.Ready:
        return Err(BackendError.PhysicalPagesUnavailable)
    if transaction <= 0 or _call1(b.f_page_table_abort, transaction) != 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    Ok(())

fn physical_page_allocated_bytes(b: GgmlBackend, pool: i64) -> Result<i64, BackendError>:
    if b.physical_page_status != PhysicalPageProviderStatus.Ready:
        return Err(BackendError.PhysicalPagesUnavailable)
    if pool <= 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    val bytes = _call1(b.f_page_allocated_bytes, pool)
    if bytes < 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    Ok(bytes)

fn physical_page_bytes(b: GgmlBackend, pool: i64) -> Result<i64, BackendError>:
    if b.physical_page_status != PhysicalPageProviderStatus.Ready:
        return Err(BackendError.PhysicalPagesUnavailable)
    if pool <= 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    val bytes = _call1(b.f_page_bytes, pool)
    if bytes <= 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    Ok(bytes)

# Releases the model, context and sampler, then the library itself. Callers that
# stop a model mid-session rely on this leaving no handle behind.
fn close_backend(b: GgmlBackend) -> Result<(), BackendError>:
    # The projector was built on the model: release it first.
    if b.f_mm_free != 0:
        _call0(b.f_mm_free)
    if _call0(b.f_free) < 0:
        return Err(BackendError.NotOpen)
    spl_dlclose(b.lib)
    Ok(())

