fn physical_page_table_push(b: GgmlBackend, transaction: i64, page: i64,
                            valid_rows: i64,
                            writable_capacity: i64) -> Result<(), BackendError>:
    if b.physical_page_status != PhysicalPageProviderStatus.Ready:
        return Err(BackendError.PhysicalPagesUnavailable)
    if transaction <= 0:
        return Err(BackendError.PhysicalPageOperationFailed)
    val abort_fptr = b.f_page_table_abort
    if page <= 0 or valid_rows < 0 or writable_capacity < 0:
        _call1(abort_fptr, transaction)
        return Err(BackendError.PhysicalPageOperationFailed)
    if _call4(b.f_page_table_push, transaction, page, valid_rows,
              writable_capacity) != 0:
        # The request owner cancels on provider failure. Cancellation owns
        # transaction abort/detach and does not require another WFFI dispatch
        # through a value live across the failed foreign call.
        return Err(BackendError.PhysicalPageOperationFailed)
    Ok(())

