# @gc — module uses GC runtime
#
# stop — stop conditions for a generation loop: EOS ids, a new-token budget and
# stop STRINGS matched on the decoded text so far (a stop string may span
# several tokens). Offsets are text `len()` / `substring()` / `index_of()`
# units (the same family throughout; stop strings in practice are ASCII).
#
# `stop_scan` returns the text truncated before the earliest stop string and,
# when nothing matched yet, `hold_back`: the length of the longest trailing
# piece of the text that is a proper prefix of some stop string. A streaming
# consumer must not be sent those trailing units until a later token resolves
# them either way, so a partial stop match is never emitted.

pub struct StopConfig:
    eos_ids: [i64]
    max_new_tokens: i64
    stop_strings: [text]

pub struct StopScan:
    matched: bool
    text: text
    hold_back: i64

pub fn stop_is_eos(cfg: StopConfig, id: i64) -> bool:
    for e in cfg.eos_ids:
        if e == id:
            return true
    false

pub fn stop_length_reached(cfg: StopConfig, n_generated: i64) -> bool:
    n_generated >= cfg.max_new_tokens

pub fn stop_scan(t: text, stops: [text]) -> StopScan:
    var best: i64 = -1
    for s in stops:
        if s.len() > 0:
            val at = t.index_of(s)
            if at >= 0 and (best < 0 or at < best):
                best = at
    if best >= 0:
        return StopScan(matched: true, text: t.substring(0, best), hold_back: 0)
    val n = t.len()
    var hold: i64 = 0
    for s in stops:
        var l = s.len() - 1
        if l > n:
            l = n
        while l > hold:
            if s.starts_with(t.substring(n - l, n)):
                hold = l
            l = l - 1
    StopScan(matched: false, text: t, hold_back: hold)

# Length of the part of `scan.text` that is safe to hand to a stream consumer.
pub fn stop_safe_len(scan: StopScan) -> i64:
    scan.text.len() - scan.hold_back
