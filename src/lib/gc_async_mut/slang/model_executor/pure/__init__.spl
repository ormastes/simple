# @gc — module uses GC runtime
#
# pure — pure-Simple inference backend (no llama.cpp, no C):
#   - tensor_ops.spl : the single compute seam (CPU [f64] provider today)
#   - weights.spl    : safetensors -> named PureTensor values (F32, BF16)
#   - llama_forward.spl : Llama-2 forward pass over tensor_ops
#   - kv_cache.spl   : incremental KV cache + prefix reuse
#   - compute_backend.spl : backend-neutral GPU compute interface (ROCm via tensor_ops_rocm.spl, CPU)
#   - llama_forward_gpu.spl : the same forward pass through compute_backend
#   - tokenizer.spl  : SentencePiece-BPE from tokenizer.json
#   - sampler.spl / stop.spl / generate.spl : temperature/top-k/top-p/penalty sampling, stop conditions, streaming generation loop

export PureTensor, tensor_from_values, tensor_zeros, tensor_numel, tensor_shape, tensor_value_at
export PureWeights, pure_weights_from_bytes, pure_weights_load, pure_weights_find, pure_weights_count
export LlamaConfig, LlamaModel, LlamaKvRows, llama_load, llama_step, llama_logits, llama_greedy_token, llama_forward_logits
export KvSession, KvGenResult, kv_session_new, kv_generate_greedy, kv_generate_greedy_nocache
export PureTokenizer, pure_tokenizer_load, pure_tokenizer_from_json, pure_tokenizer_encode, pure_tokenizer_decode
export SamplerConfig, SamplerState, SampleOut, sampler_config_greedy, sampler_state_new, sampler_sample
export StopConfig, StopScan, stop_is_eos, stop_length_reached, stop_scan, stop_safe_len
export GenConfig, GenState, GenResult, gen_begin, gen_next, generate
