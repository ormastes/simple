# @gc — module uses GC runtime
#
# compute_backend — the backend-neutral GPU compute interface of the pure LLM
# runner:  slang -> pure runner -> compute_* (this file) -> ROCm | CUDA | Vulkan | CPU.
#
# `DeviceTensor` is one f32 tensor on whichever backend owns it. For the three
# GPU kinds `ptr` is the device buffer and `host` is empty. For `Cpu` there is no
# device: `ptr` is 0 and `host` carries the data (the CPU `[f64]` provider of
# tensor_ops.spl wrapped as-is), so the CPU fallback is the numeric reference
# and a Cpu `DeviceTensor` is just a PureTensor with a kind tag.
#
# `ComputeOps` carries the kind plus the opened provider handle. Each compute_*
# function dispatches by `match` on the tensor/ops kind to the provider's own
# functions (`rocm_tensor_*`, `cuda_tensor_*`, `vk_tensor_*`); providers keep
# their own files. Every arm is ONE line. All three GPU providers are wired; a
# Vulkan tensor additionally carries its VkBuffer in `DeviceTensor.vkbuf` (the
# buffer is four handles, not one).
#
# Dynamic loading: nothing here (or in any provider module) loads a native
# library at import or does top-level work; provider modules hold only constants
# and functions. A provider's libraries are dlopen'ed inside its open function,
# reached only from compute_open for that kind, and a failed open releases what
# it loaded (so an auto-probe leaves nothing resident). Kernels compile lazily on
# the first op and are cached per device. Imports themselves are static (Simple
# has no conditional module import), so importing this file parses the provider
# sources but runs none of them.
#
# Mutation contract: compute_kv_write returns the buffer to use afterwards.
# GPU providers write in place and return the same handle; the CPU provider is
# value-returning. Callers must always keep the returned tensor.

use std.gc_async_mut.slang.host.slang_host.{host_env}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops.{PureTensor, tensor_zeros, tensor_decode_f32_le, tensor_row, tensor_matvec, tensor_rmsnorm, tensor_add, tensor_mul, tensor_silu, tensor_rope, tensor_kv_write, tensor_attention, tensor_argmax}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops_rocm.{RocmOps, RocmTensor, rocm_ops_open, rocm_ops_device_name, rocm_tensor_upload, rocm_tensor_upload_f32_bytes, rocm_tensor_download, rocm_tensor_free, rocm_tensor_matvec, rocm_tensor_rmsnorm, rocm_tensor_add, rocm_tensor_mul, rocm_tensor_silu, rocm_tensor_rope, rocm_tensor_kv_write, rocm_tensor_row, rocm_tensor_attention, rocm_tensor_argmax, rocm_buffer_alloc_tensor, rocm_ops_sync}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops_cuda.{CudaOps, CudaTensor, cuda_ops_open, cuda_ops_device_name, cuda_tensor_upload, cuda_tensor_upload_f32_bytes, cuda_tensor_download, cuda_tensor_free, cuda_tensor_matvec, cuda_tensor_rmsnorm, cuda_tensor_add, cuda_tensor_mul, cuda_tensor_silu, cuda_tensor_rope, cuda_tensor_kv_write, cuda_tensor_row, cuda_tensor_attention, cuda_tensor_argmax, cuda_buffer_alloc_tensor, cuda_ops_sync}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops_vulkan.{VkOps, VkTensor, vk_ops_open, vk_ops_device_name, vk_tensor_upload, vk_tensor_upload_f32_bytes, vk_tensor_download, vk_tensor_free, vk_tensor_matvec, vk_tensor_rmsnorm, vk_tensor_add, vk_tensor_mul, vk_tensor_silu, vk_tensor_rope, vk_tensor_kv_write, vk_tensor_row, vk_tensor_attention, vk_tensor_argmax, vk_buffer_alloc_tensor, vk_ops_sync}
use std.gc_async_mut.gpu.vulkan.vk_compute.{VkBuffer}
use std.gc_async_mut.gpu.rocm.hip_compute.{gpu_dll_loaded}

pub enum ComputeKind:
    Cpu
    Rocm
    Cuda
    Vulkan

pub struct DeviceTensor:
    kind: ComputeKind
    ptr: i64
    n: i64
    shape: [i64]
    host: [f64]
    vkbuf: Option<VkBuffer>

pub struct ComputeOps:
    kind: ComputeKind
    rocm: Option<RocmOps>
    cuda: Option<CudaOps>
    vulkan: Option<VkOps>
    diag: text

# True when any GPU provider's native library is mapped in this process (each
# provider lane ORs in its own query here).
@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_gpu_library_loaded() -> bool:
    gpu_dll_loaded(["amdhip64_7.dll", "hiprtc0702.dll", "nvcuda.dll", "vulkan-1.dll"])

pub fn compute_kind_name(k: ComputeKind) -> text:
    match k:
        ComputeKind.Cpu: "cpu"
        ComputeKind.Rocm: "rocm"
        ComputeKind.Cuda: "cuda"
        ComputeKind.Vulkan: "vulkan"

# "rocm" | "cuda" | "vulkan" | "cpu" (case-insensitive) -> kind; None otherwise.
pub fn compute_parse_kind(name: text) -> Option<ComputeKind>:
    val s = name.lower()
    if s == "rocm":
        return Some(ComputeKind.Rocm)
    if s == "cuda":
        return Some(ComputeKind.Cuda)
    if s == "vulkan":
        return Some(ComputeKind.Vulkan)
    if s == "cpu":
        return Some(ComputeKind.Cpu)
    None

fn _numel(shape: [i64]) -> i64:
    var n: i64 = 1
    for d in shape:
        n = n * d
    n

# ---- converters between the neutral tensor and a provider's own tensor ----

# A tensor handed to a provider must belong to that provider. A mixed-kind call
# (a Cpu tensor with ptr 0 given to a GPU op, a HIP pointer bound as a VkBuffer,
# a GPU tensor's empty host data given to the CPU op) is an Err here instead of
# a null or foreign handle reaching the device.
fn _expect_kind(t: DeviceTensor, want: ComputeKind) -> Result<i64, text>:
    if compute_kind_name(t.kind) != compute_kind_name(want):
        return Err("compute: {compute_kind_name(t.kind)} tensor passed to a {compute_kind_name(want)} op")
    Ok(0)

fn _from_rocm(t: RocmTensor) -> DeviceTensor:
    DeviceTensor(kind: ComputeKind.Rocm, ptr: t.ptr, n: t.n, shape: t.shape, host: [], vkbuf: None)

fn _to_rocm(t: DeviceTensor) -> Result<RocmTensor, text>:
    _expect_kind(t, ComputeKind.Rocm)?
    Ok(RocmTensor(ptr: t.ptr, n: t.n, shape: t.shape))

fn _from_cuda(t: CudaTensor) -> DeviceTensor:
    DeviceTensor(kind: ComputeKind.Cuda, ptr: t.ptr, n: t.n, shape: t.shape, host: [], vkbuf: None)

fn _to_cuda(t: DeviceTensor) -> Result<CudaTensor, text>:
    _expect_kind(t, ComputeKind.Cuda)?
    Ok(CudaTensor(ptr: t.ptr, n: t.n, shape: t.shape))

fn _wrap_cuda(r: Result<CudaTensor, text>) -> Result<DeviceTensor, text>:
    val t = r?
    Ok(_from_cuda(t))

fn _cuda_h(ops: ComputeOps) -> Result<CudaOps, text>:
    if val h = ops.cuda:
        return Ok(h)
    Err("compute ops of kind {compute_kind_name(ops.kind)} carry no CUDA handle")

fn _from_vk(t: VkTensor) -> DeviceTensor:
    DeviceTensor(kind: ComputeKind.Vulkan, ptr: t.buf.buf, n: t.n, shape: t.shape, host: [], vkbuf: Some(t.buf))

fn _to_vk(t: DeviceTensor) -> Result<VkTensor, text>:
    _expect_kind(t, ComputeKind.Vulkan)?
    if val b = t.vkbuf:
        return Ok(VkTensor(buf: b, n: t.n, shape: t.shape))
    Err("compute: Vulkan tensor carries no VkBuffer")

fn _wrap_vk(r: Result<VkTensor, text>) -> Result<DeviceTensor, text>:
    val t = r?
    Ok(_from_vk(t))

fn _vk_h(ops: ComputeOps) -> Result<VkOps, text>:
    if val h = ops.vulkan:
        return Ok(h)
    Err("compute ops of kind {compute_kind_name(ops.kind)} carry no Vulkan handle")

fn _from_cpu(t: PureTensor) -> DeviceTensor:
    DeviceTensor(kind: ComputeKind.Cpu, ptr: 0, n: t.data.len(), shape: t.shape, host: t.data, vkbuf: None)

fn _to_cpu(t: DeviceTensor) -> Result<PureTensor, text>:
    _expect_kind(t, ComputeKind.Cpu)?
    Ok(PureTensor(data: t.host, shape: t.shape))

fn _wrap_rocm(r: Result<RocmTensor, text>) -> Result<DeviceTensor, text>:
    val t = r?
    Ok(_from_rocm(t))

fn _rocm_h(ops: ComputeOps) -> Result<RocmOps, text>:
    if val h = ops.rocm:
        return Ok(h)
    Err("compute ops of kind {compute_kind_name(ops.kind)} carry no ROCm handle")

# ---- open ----

fn _cpu_ops(diag: text) -> ComputeOps:
    ComputeOps(kind: ComputeKind.Cpu, rocm: None, cuda: None, vulkan: None, diag: diag)

fn _open_kind(kind: ComputeKind) -> Result<ComputeOps, text>:
    match kind:
        ComputeKind.Cpu: Ok(_cpu_ops(""))
        ComputeKind.Rocm: _open_rocm()
        ComputeKind.Cuda: _open_cuda()
        ComputeKind.Vulkan: _open_vulkan()

fn _open_rocm() -> Result<ComputeOps, text>:
    val h = rocm_ops_open()?
    Ok(ComputeOps(kind: ComputeKind.Rocm, rocm: Some(h), cuda: None, vulkan: None, diag: ""))

fn _open_cuda() -> Result<ComputeOps, text>:
    val h = cuda_ops_open()?
    Ok(ComputeOps(kind: ComputeKind.Cuda, rocm: None, cuda: Some(h), vulkan: None, diag: ""))

fn _open_vulkan() -> Result<ComputeOps, text>:
    val h = vk_ops_open()?
    Ok(ComputeOps(kind: ComputeKind.Vulkan, rocm: None, cuda: None, vulkan: Some(h), diag: ""))

# Open a backend. pref: "auto" (or "") | "rocm" | "cuda" | "vulkan" | "cpu".
# For "auto" the env var SLANG_GPU (rocm|cuda|vulkan|cpu) overrides the order; an
# overridden backend that fails to open is an error (no silent fallback). With
# no override, auto tries Rocm, Cuda, Vulkan, Cpu and the first that opens wins;
# the reasons earlier ones failed are recorded in `ComputeOps.diag`.
# (host_env returns "" when the variable is unset.)
pub fn compute_open(pref: text) -> Result<ComputeOps, text>:
    var want = pref.lower()
    if want == "" or want == "auto":
        val env = host_env("SLANG_GPU").lower()
        if env != "" and env != "auto":
            want = env
    if want != "" and want != "auto":
        val k = compute_parse_kind(want)
        if k.is_none():
            return Err("unknown compute backend '{want}' (expected auto|rocm|cuda|vulkan|cpu)")
        val kind = k.unwrap()
        val r = _open_kind(kind)
        if r.is_err():
            return Err("{compute_kind_name(kind)}: {r.unwrap_err()}")
        return r
    var diag = ""
    for kind in [ComputeKind.Rocm, ComputeKind.Cuda, ComputeKind.Vulkan]:
        val r = _open_kind(kind)
        if r.is_ok():
            val o = r.unwrap()
            return Ok(ComputeOps(kind: o.kind, rocm: o.rocm, cuda: o.cuda, vulkan: o.vulkan, diag: diag))
        diag = diag + "{compute_kind_name(kind)}: {r.unwrap_err()}; "
    Ok(_cpu_ops(diag))

pub fn compute_device_name(ops: ComputeOps) -> text:
    match ops.kind:
        ComputeKind.Cpu: "cpu"
        ComputeKind.Rocm: _rocm_name(ops)
        ComputeKind.Cuda: _cuda_name(ops)
        ComputeKind.Vulkan: _vk_name(ops)

fn _rocm_name(ops: ComputeOps) -> text:
    if val h = ops.rocm:
        return rocm_ops_device_name(h)
    "rocm"

fn _cuda_name(ops: ComputeOps) -> text:
    if val h = ops.cuda:
        return cuda_ops_device_name(h)
    "cuda"

fn _vk_name(ops: ComputeOps) -> text:
    if val h = ops.vulkan:
        return vk_ops_device_name(h)
    "vulkan"

# ---- transfer ----

pub fn compute_upload(ops: ComputeOps, t: PureTensor) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(t))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_upload(_rocm_h(ops)?, t))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_upload(_cuda_h(ops)?, t))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_upload(_vk_h(ops)?, t))

# Little-endian F32 bytes[offset .. offset + numel*4] straight to the backend.
@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_upload_f32_bytes(ops: ComputeOps, bytes: [u8], offset: i64, shape: [i64]) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_decode_f32_le(bytes, offset, _numel(shape), shape)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_upload_f32_bytes(_rocm_h(ops)?, bytes, offset, shape))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_upload_f32_bytes(_cuda_h(ops)?, bytes, offset, shape))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_upload_f32_bytes(_vk_h(ops)?, bytes, offset, shape))

pub fn compute_download(ops: ComputeOps, t: DeviceTensor) -> Result<PureTensor, text>:
    match t.kind:
        ComputeKind.Cpu: _to_cpu(t)
        ComputeKind.Rocm: rocm_tensor_download(_rocm_h(ops)?, _to_rocm(t)?)
        ComputeKind.Cuda: cuda_tensor_download(_cuda_h(ops)?, _to_cuda(t)?)
        ComputeKind.Vulkan: vk_tensor_download(_vk_h(ops)?, _to_vk(t)?)

# Uninitialised (zeroed on Cpu) tensor of `shape`, e.g. a KV buffer.
pub fn compute_alloc(ops: ComputeOps, shape: [i64]) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_zeros(shape)))
        ComputeKind.Rocm: _wrap_rocm(rocm_buffer_alloc_tensor(_rocm_h(ops)?, shape))
        ComputeKind.Cuda: _wrap_cuda(cuda_buffer_alloc_tensor(_cuda_h(ops)?, shape))
        ComputeKind.Vulkan: _wrap_vk(vk_buffer_alloc_tensor(_vk_h(ops)?, shape))

pub fn compute_free(ops: ComputeOps, t: DeviceTensor) -> Result<i64, text>:
    match t.kind:
        ComputeKind.Cpu: Ok(0)
        ComputeKind.Rocm: rocm_tensor_free(_rocm_h(ops)?, _to_rocm(t)?)
        ComputeKind.Cuda: cuda_tensor_free(_cuda_h(ops)?, _to_cuda(t)?)
        ComputeKind.Vulkan: vk_tensor_free(_vk_h(ops)?, _to_vk(t)?)

# Block until all launched work finished (GPU ops are asynchronous).
pub fn compute_sync(ops: ComputeOps) -> Result<i64, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(0)
        ComputeKind.Rocm: rocm_ops_sync(_rocm_h(ops)?)
        ComputeKind.Cuda: cuda_ops_sync(_cuda_h(ops)?)
        ComputeKind.Vulkan: vk_ops_sync(_vk_h(ops)?)

# ---- ops (each returns a new tensor; inputs stay valid) ----

# y = W x for W stored [out, in].
pub fn compute_matvec(ops: ComputeOps, w: DeviceTensor, x: DeviceTensor) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_matvec(_to_cpu(w)?, _to_cpu(x)?)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_matvec(_rocm_h(ops)?, _to_rocm(w)?, _to_rocm(x)?))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_matvec(_cuda_h(ops)?, _to_cuda(w)?, _to_cuda(x)?))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_matvec(_vk_h(ops)?, _to_vk(w)?, _to_vk(x)?))

@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_rmsnorm(ops: ComputeOps, x: DeviceTensor, w: DeviceTensor, eps: f64) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_rmsnorm(_to_cpu(x)?, _to_cpu(w)?, eps)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_rmsnorm(_rocm_h(ops)?, _to_rocm(x)?, _to_rocm(w)?, eps))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_rmsnorm(_cuda_h(ops)?, _to_cuda(x)?, _to_cuda(w)?, eps))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_rmsnorm(_vk_h(ops)?, _to_vk(x)?, _to_vk(w)?, eps))

pub fn compute_add(ops: ComputeOps, a: DeviceTensor, b: DeviceTensor) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_add(_to_cpu(a)?, _to_cpu(b)?)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_add(_rocm_h(ops)?, _to_rocm(a)?, _to_rocm(b)?))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_add(_cuda_h(ops)?, _to_cuda(a)?, _to_cuda(b)?))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_add(_vk_h(ops)?, _to_vk(a)?, _to_vk(b)?))

pub fn compute_mul(ops: ComputeOps, a: DeviceTensor, b: DeviceTensor) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_mul(_to_cpu(a)?, _to_cpu(b)?)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_mul(_rocm_h(ops)?, _to_rocm(a)?, _to_rocm(b)?))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_mul(_cuda_h(ops)?, _to_cuda(a)?, _to_cuda(b)?))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_mul(_vk_h(ops)?, _to_vk(a)?, _to_vk(b)?))

pub fn compute_silu(ops: ComputeOps, x: DeviceTensor) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_silu(_to_cpu(x)?)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_silu(_rocm_h(ops)?, _to_rocm(x)?))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_silu(_cuda_h(ops)?, _to_cuda(x)?))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_silu(_vk_h(ops)?, _to_vk(x)?))

# Causal multi-head attention for one query against KV rows [0, n_pos).
@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_attention(ops: ComputeOps, q: DeviceTensor, k_buf: DeviceTensor, v_buf: DeviceTensor, n_pos: i64, n_heads: i64, head_dim: i64) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_attention(_to_cpu(q)?, _to_cpu(k_buf)?, _to_cpu(v_buf)?, n_pos, n_heads, head_dim)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_attention(_rocm_h(ops)?, _to_rocm(q)?, _to_rocm(k_buf)?, _to_rocm(v_buf)?, n_pos, n_heads, head_dim))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_attention(_cuda_h(ops)?, _to_cuda(q)?, _to_cuda(k_buf)?, _to_cuda(v_buf)?, n_pos, n_heads, head_dim))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_attention(_vk_h(ops)?, _to_vk(q)?, _to_vk(k_buf)?, _to_vk(v_buf)?, n_pos, n_heads, head_dim))

# RoPE on a [n_heads * head_dim] vector at position `pos`.
@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_rope(ops: ComputeOps, x: DeviceTensor, pos: i64, n_heads: i64, head_dim: i64, theta: f64) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_rope(_to_cpu(x)?, pos, n_heads, head_dim, theta)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_rope(_rocm_h(ops)?, _to_rocm(x)?, pos, n_heads, head_dim, theta))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_rope(_cuda_h(ops)?, _to_cuda(x)?, pos, n_heads, head_dim, theta))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_rope(_vk_h(ops)?, _to_vk(x)?, pos, n_heads, head_dim, theta))

# Write `row` into row `pos` of the [capacity, dim] buffer; returns the buffer to
# keep using (same handle on GPU, updated value on Cpu).
@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_kv_write(ops: ComputeOps, buf: DeviceTensor, pos: i64, row: DeviceTensor) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_kv_write(_to_cpu(buf)?, pos, _to_cpu(row)?)))
        ComputeKind.Rocm: _kv_rocm(ops, buf, pos, row)
        ComputeKind.Cuda: _kv_cuda(ops, buf, pos, row)
        ComputeKind.Vulkan: _kv_vk(ops, buf, pos, row)

fn _kv_rocm(ops: ComputeOps, buf: DeviceTensor, pos: i64, row: DeviceTensor) -> Result<DeviceTensor, text>:
    rocm_tensor_kv_write(_rocm_h(ops)?, _to_rocm(buf)?, pos, _to_rocm(row)?)?
    Ok(buf)

fn _kv_cuda(ops: ComputeOps, buf: DeviceTensor, pos: i64, row: DeviceTensor) -> Result<DeviceTensor, text>:
    cuda_tensor_kv_write(_cuda_h(ops)?, _to_cuda(buf)?, pos, _to_cuda(row)?)?
    Ok(buf)

fn _kv_vk(ops: ComputeOps, buf: DeviceTensor, pos: i64, row: DeviceTensor) -> Result<DeviceTensor, text>:
    vk_tensor_kv_write(_vk_h(ops)?, _to_vk(buf)?, pos, _to_vk(row)?)?
    Ok(buf)

# Row `row` of a [rows, cols] table as a new [cols] tensor.
@allow(primitive_api)  # reason: tensor positions, head counts and argmax indices mirror the provider kernel parameters
pub fn compute_row(ops: ComputeOps, table: DeviceTensor, row: i64) -> Result<DeviceTensor, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(_from_cpu(tensor_row(_to_cpu(table)?, row)))
        ComputeKind.Rocm: _wrap_rocm(rocm_tensor_row(_rocm_h(ops)?, _to_rocm(table)?, row))
        ComputeKind.Cuda: _wrap_cuda(cuda_tensor_row(_cuda_h(ops)?, _to_cuda(table)?, row))
        ComputeKind.Vulkan: _wrap_vk(vk_tensor_row(_vk_h(ops)?, _to_vk(table)?, row))

# Index of the largest element (lowest index on ties).
pub fn compute_argmax(ops: ComputeOps, x: DeviceTensor) -> Result<i64, text>:
    match ops.kind:
        ComputeKind.Cpu: Ok(tensor_argmax(_to_cpu(x)?))
        ComputeKind.Rocm: rocm_tensor_argmax(_rocm_h(ops)?, _to_rocm(x)?)
        ComputeKind.Cuda: cuda_tensor_argmax(_cuda_h(ops)?, _to_cuda(x)?)
        ComputeKind.Vulkan: vk_tensor_argmax(_vk_h(ops)?, _to_vk(x)?)
