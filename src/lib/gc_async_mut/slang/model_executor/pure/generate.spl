# @gc — module uses GC runtime
#
# generate — one generation loop for the pure-Simple runner: the KV-cache step
# API (`llama_step` / `llama_logits`, same prefix-reuse rule as
# `kv_generate_greedy`) + `sampler` + `stop`. kv_cache.spl is not touched.
#
# Streaming: `gen_begin` evaluates the prompt, each `gen_next` produces one
# token and `delta`, the text newly safe to send (stop-string hold-back
# applied; whatever was held is flushed when generation ends without a match).
# `generate` drives the loop and returns the per-token deltas as `pieces`.
# With temperature 0 `ids` equals `kv_generate_greedy` (the EOS id, if hit, is
# the last id but contributes no text). finish_reason: "stop" = EOS or stop
# string, "length" = token budget or context window exhausted.

use std.gc_async_mut.slang.model_executor.pure.llama_forward.{LlamaModel, llama_step, llama_logits}
use std.gc_async_mut.slang.model_executor.pure.kv_cache.{KvSession}
use std.gc_async_mut.slang.model_executor.pure.sampler.{SamplerConfig, SamplerState, sampler_state_new, sampler_sample}
use std.gc_async_mut.slang.model_executor.pure.stop.{StopConfig, stop_is_eos, stop_length_reached, stop_scan}
use std.gc_async_mut.slang.model_executor.pure.tokenizer.{PureTokenizer, pure_tokenizer_decode}

pub struct GenConfig:
    sampler: SamplerConfig
    seed: i64
    stop: StopConfig

pub struct GenState:
    session: KvSession
    ids: [i64]
    generated: [i64]
    sampler: SamplerState
    prompt_tokens: i64
    start_positions: i64
    reused_positions: i64
    text: text
    emitted: i64
    delta: text
    finished: bool
    finish_reason: text

pub struct GenResult:
    session: KvSession
    ids: [i64]
    text: text
    pieces: [text]
    finish_reason: text
    prompt_tokens: i64
    completion_tokens: i64
    positions_evaluated: i64
    reused_positions: i64

fn _common_prefix(a: [i64], b: [i64]) -> i64:
    var n: i64 = 0
    while n < a.len() and n < b.len() and a[n] == b[n]:
        n = n + 1
    n

fn _extend(m: LlamaModel, s: KvSession, ids: [i64], reuse: i64) -> KvSession:
    var kv = s.kv
    var hidden = s.hidden
    var evaluated = s.positions_evaluated
    var pos = reuse
    while pos < ids.len():
        val out = llama_step(m, kv, ids[pos], pos)
        kv = out.kv
        hidden = out.hidden
        evaluated = evaluated + 1
        pos = pos + 1
    KvSession(kv: kv, cached_ids: ids, hidden: hidden, positions_evaluated: evaluated)

fn _tail(t: text, from: i64) -> text:
    if from >= t.byte_len():
        return ""
    t.substring(from, t.byte_len())

# Err on an empty prompt or one that leaves no room in the context window.
pub fn gen_begin(m: LlamaModel, session: KvSession, prompt_ids: [i64], cfg: GenConfig) -> Result<GenState, text>:
    if prompt_ids.len() == 0:
        return Err("empty prompt")
    if prompt_ids.len() >= m.config.max_pos:
        return Err("prompt of {prompt_ids.len()} tokens does not fit the {m.config.max_pos}-position context")
    var reuse = _common_prefix(session.cached_ids, prompt_ids)
    if reuse >= prompt_ids.len():
        reuse = prompt_ids.len() - 1
    val start = session.positions_evaluated
    val s = _extend(m, session, prompt_ids, reuse)
    Ok(GenState(session: s, ids: prompt_ids, generated: [], sampler: sampler_state_new(cfg.seed), prompt_tokens: prompt_ids.len(), start_positions: start, reused_positions: reuse, text: "", emitted: 0, delta: "", finished: false, finish_reason: ""))

fn _finish(st: GenState, session: KvSession, ids: [i64], generated: [i64], text: text, reason: text) -> GenState:
    GenState(session: session, ids: ids, generated: generated, sampler: st.sampler, prompt_tokens: st.prompt_tokens, start_positions: st.start_positions, reused_positions: st.reused_positions, text: text, emitted: text.byte_len(), delta: _tail(text, st.emitted), finished: true, finish_reason: reason)

# Produce one token. No-op once finished.
pub fn gen_next(m: LlamaModel, tok: PureTokenizer, st: GenState, cfg: GenConfig) -> GenState:
    if st.finished:
        return st
    if stop_length_reached(cfg.stop, st.generated.len()) or st.ids.len() >= m.config.max_pos:
        return _finish(st, st.session, st.ids, st.generated, st.text, "length")
    val out = sampler_sample(cfg.sampler, st.sampler, llama_logits(m, st.session.hidden), st.ids)
    val next = out.token
    var generated = st.generated
    generated.push(next)
    val moved = GenState(session: st.session, ids: st.ids, generated: generated, sampler: out.state, prompt_tokens: st.prompt_tokens, start_positions: st.start_positions, reused_positions: st.reused_positions, text: st.text, emitted: st.emitted, delta: "", finished: false, finish_reason: "")
    if stop_is_eos(cfg.stop, next):
        return _finish(moved, st.session, st.ids, generated, st.text, "stop")
    var ids = st.ids
    ids.push(next)
    val scan = stop_scan(pure_tokenizer_decode(tok, generated), cfg.stop.stop_strings)
    if scan.matched:
        return _finish(moved, st.session, ids, generated, scan.text, "stop")
    if stop_length_reached(cfg.stop, generated.len()) or ids.len() >= m.config.max_pos:
        return _finish(moved, st.session, ids, generated, scan.text, "length")
    val safe = scan.text.byte_len() - scan.hold_back
    var delta = ""
    var emitted = st.emitted
    if safe > emitted:
        delta = scan.text.substring(emitted, safe)
        emitted = safe
    val s = _extend(m, st.session, ids, ids.len() - 1)
    GenState(session: s, ids: ids, generated: generated, sampler: out.state, prompt_tokens: st.prompt_tokens, start_positions: st.start_positions, reused_positions: st.reused_positions, text: scan.text, emitted: emitted, delta: delta, finished: false, finish_reason: "")

pub fn generate(m: LlamaModel, tok: PureTokenizer, session: KvSession, prompt_ids: [i64], cfg: GenConfig) -> Result<GenResult, text>:
    var st = gen_begin(m, session, prompt_ids, cfg)?
    var pieces: [text] = []
    while not st.finished:
        st = gen_next(m, tok, st, cfg)
        pieces.push(st.delta)
    Ok(GenResult(session: st.session, ids: st.generated, text: st.text, pieces: pieces, finish_reason: st.finish_reason, prompt_tokens: st.prompt_tokens, completion_tokens: st.generated.len(), positions_evaluated: st.session.positions_evaluated - st.start_positions, reused_positions: st.reused_positions))
