# @gc — module uses GC runtime
#
# tensor_ops_vulkan_kernels — SPIR-V compute kernels of the Vulkan ops provider,
# generated with the pure-Simple emitter (gpu/vulkan/spirv_compute.spl). Each
# kernel is the f32 twin of the HIP kernel of the same name in
# tensor_ops_rocm.spl: same work split (one workgroup per matvec row / head),
# same shared-memory tree reduction (256 lanes, halving strides), same
# arithmetic order. Buffers are set 0 bindings 0..n-1; sizes and the rmsnorm
# epsilon are push constants (0 = uint, 1 = float).

use std.gc_async_mut.gpu.vulkan.spirv_compute.{SpvModule, spv_module_new, SPV_BUILTIN_WORKGROUP_ID, SPV_BUILTIN_LOCAL_INVOCATION_ID, SPV_BUILTIN_GLOBAL_INVOCATION_ID}

pub val VK_REDUCE_LANES = 256
pub val VK_ATTENTION_LANES = 128

# In-place tree reduction of red[0..256) by lane `lid` (strides 128 .. 1); red[0] holds the sum.
fn _vk_reduce_sum(m: SpvModule, red: i64, lid: i64):
    var s = VK_REDUCE_LANES / 2
    while s >= 1:
        val branch = m.if_begin(m.ult(lid, m.cu(s)))
        val lo = m.sh_ptr(red, lid)
        val hi = m.sh_ptr(red, m.iadd(lid, m.cu(s)))
        m.store(lo, m.fadd(m.load_f(lo), m.load_f(hi)))
        m.if_end(branch)
        m.barrier()
        s = s / 2

# One workgroup per row: y[row] = dot(A[row, :], x). Push: M, K.
pub fn vk_spv_matvec() -> [u8]:
    val m = spv_module_new()
    val a = m.ssbo()
    val x = m.ssbo()
    val y = m.ssbo()
    m.push_block([0, 0])
    val wg = m.builtin_uvec3(SPV_BUILTIN_WORKGROUP_ID)
    val li = m.builtin_uvec3(SPV_BUILTIN_LOCAL_INVOCATION_ID)
    val red = m.shared_f32(VK_REDUCE_LANES)
    m.begin_main()
    val row = m.builtin_x(wg)
    val lid = m.builtin_x(li)
    val kk = m.pc(1)
    val acc = m.fvar_f32()
    val k = m.fvar_u32()
    m.store(acc, m.cf(0.0))
    m.store(k, lid)
    val rowbase = m.imul(row, kk)
    val lp = m.loop_begin()
    val kv = m.load_u(k)
    m.loop_cond(lp, m.ult(kv, kk))
    val av = m.load_f(m.buf_ptr(a, m.iadd(rowbase, kv)))
    val xv = m.load_f(m.buf_ptr(x, kv))
    m.store(acc, m.fadd(m.load_f(acc), m.fmul(av, xv)))
    m.loop_cont(lp)
    m.store(k, m.iadd(m.load_u(k), m.cu(VK_REDUCE_LANES)))
    m.loop_end(lp)
    m.store(m.sh_ptr(red, lid), m.load_f(acc))
    m.barrier()
    _vk_reduce_sum(m, red, lid)
    val first = m.if_begin(m.ueq(lid, m.cu(0)))
    m.store(m.buf_ptr(y, row), m.load_f(m.sh_ptr(red, m.cu(0))))
    m.if_end(first)
    m.finish(VK_REDUCE_LANES)

# Single workgroup: out = x * (1 / sqrt(sum(x^2) / n + eps)) * w. Push: n, eps.
pub fn vk_spv_rmsnorm() -> [u8]:
    val m = spv_module_new()
    val x = m.ssbo()
    val w = m.ssbo()
    val out = m.ssbo()
    m.push_block([0, 1])
    val li = m.builtin_uvec3(SPV_BUILTIN_LOCAL_INVOCATION_ID)
    val red = m.shared_f32(VK_REDUCE_LANES)
    m.begin_main()
    val lid = m.builtin_x(li)
    val n = m.pc(0)
    val eps = m.pc(1)
    val acc = m.fvar_f32()
    val i = m.fvar_u32()
    m.store(acc, m.cf(0.0))
    m.store(i, lid)
    val l1 = m.loop_begin()
    val iv = m.load_u(i)
    m.loop_cond(l1, m.ult(iv, n))
    val xv = m.load_f(m.buf_ptr(x, iv))
    m.store(acc, m.fadd(m.load_f(acc), m.fmul(xv, xv)))
    m.loop_cont(l1)
    m.store(i, m.iadd(m.load_u(i), m.cu(VK_REDUCE_LANES)))
    m.loop_end(l1)
    m.store(m.sh_ptr(red, lid), m.load_f(acc))
    m.barrier()
    _vk_reduce_sum(m, red, lid)
    val mean = m.fdiv(m.load_f(m.sh_ptr(red, m.cu(0))), m.u_to_f(n))
    val scale = m.fdiv(m.cf(1.0), m.fsqrt(m.fadd(mean, eps)))
    m.store(i, lid)
    val l2 = m.loop_begin()
    val jv = m.load_u(i)
    m.loop_cond(l2, m.ult(jv, n))
    val xj = m.load_f(m.buf_ptr(x, jv))
    val wj = m.load_f(m.buf_ptr(w, jv))
    m.store(m.buf_ptr(out, jv), m.fmul(m.fmul(xj, scale), wj))
    m.loop_cont(l2)
    m.store(i, m.iadd(m.load_u(i), m.cu(VK_REDUCE_LANES)))
    m.loop_end(l2)
    m.finish(VK_REDUCE_LANES)

# out[i] = a[i] <op> b[i] for i < n; op 0 = add, 1 = mul. Push: n.
fn _vk_spv_elementwise2(is_mul: bool) -> [u8]:
    val m = spv_module_new()
    val a = m.ssbo()
    val b = m.ssbo()
    val out = m.ssbo()
    m.push_block([0])
    val gi = m.builtin_uvec3(SPV_BUILTIN_GLOBAL_INVOCATION_ID)
    m.begin_main()
    val gid = m.builtin_x(gi)
    val guard = m.if_begin(m.ult(gid, m.pc(0)))
    val av = m.load_f(m.buf_ptr(a, gid))
    val bv = m.load_f(m.buf_ptr(b, gid))
    if is_mul:
        m.store(m.buf_ptr(out, gid), m.fmul(av, bv))
    else:
        m.store(m.buf_ptr(out, gid), m.fadd(av, bv))
    m.if_end(guard)
    m.finish(256)

pub fn vk_spv_add() -> [u8]:
    _vk_spv_elementwise2(false)

pub fn vk_spv_mul() -> [u8]:
    _vk_spv_elementwise2(true)

# out[i] = x[i] / (1 + exp(-x[i])). Push: n.
pub fn vk_spv_silu() -> [u8]:
    val m = spv_module_new()
    val x = m.ssbo()
    val out = m.ssbo()
    m.push_block([0])
    val gi = m.builtin_uvec3(SPV_BUILTIN_GLOBAL_INVOCATION_ID)
    m.begin_main()
    val gid = m.builtin_x(gi)
    val guard = m.if_begin(m.ult(gid, m.pc(0)))
    val xv = m.load_f(m.buf_ptr(x, gid))
    val den = m.fadd(m.cf(1.0), m.fexp(m.fneg(xv)))
    m.store(m.buf_ptr(out, gid), m.fdiv(xv, den))
    m.if_end(guard)
    m.finish(256)

# Causal multi-head attention for one query, one workgroup per head; scores live
# in workgroup memory (n_pos <= 1024). Push: n_pos, head_dim, dim.
pub fn vk_spv_attention() -> [u8]:
    val m = spv_module_new()
    val q = m.ssbo()
    val kb = m.ssbo()
    val vb = m.ssbo()
    val out = m.ssbo()
    m.push_block([0, 0, 0])
    val wg = m.builtin_uvec3(SPV_BUILTIN_WORKGROUP_ID)
    val li = m.builtin_uvec3(SPV_BUILTIN_LOCAL_INVOCATION_ID)
    val sc = m.shared_f32(1024)
    val tot = m.shared_f32(1)
    m.begin_main()
    val h = m.builtin_x(wg)
    val lid = m.builtin_x(li)
    val n_pos = m.pc(0)
    val hd = m.pc(1)
    val dim = m.pc(2)
    val hb = m.imul(h, hd)
    val scale = m.fdiv(m.cf(1.0), m.fsqrt(m.u_to_f(hd)))
    val lanes = m.cu(VK_ATTENTION_LANES)
    val t = m.fvar_u32()
    val i = m.fvar_u32()
    val dot = m.fvar_f32()
    # scores: sc[t] = scale * dot(q_h, k_t,h) for t = lid, lid + 128, ...
    m.store(t, lid)
    val lt = m.loop_begin()
    val tv = m.load_u(t)
    m.loop_cond(lt, m.ult(tv, n_pos))
    m.store(dot, m.cf(0.0))
    m.store(i, m.cu(0))
    val li1 = m.loop_begin()
    val iv = m.load_u(i)
    m.loop_cond(li1, m.ult(iv, hd))
    val qv = m.load_f(m.buf_ptr(q, m.iadd(hb, iv)))
    val kv = m.load_f(m.buf_ptr(kb, m.iadd(m.imul(tv, dim), m.iadd(hb, iv))))
    m.store(dot, m.fadd(m.load_f(dot), m.fmul(qv, kv)))
    m.loop_cont(li1)
    m.store(i, m.iadd(m.load_u(i), m.cu(1)))
    m.loop_end(li1)
    m.store(m.sh_ptr(sc, tv), m.fmul(m.load_f(dot), scale))
    m.loop_cont(lt)
    m.store(t, m.iadd(m.load_u(t), lanes))
    m.loop_end(lt)
    m.barrier()
    # lane 0: softmax over sc[0..n_pos) (max, exp, sum) and the sum into tot[0]
    val mx = m.fvar_f32()
    val sum = m.fvar_f32()
    val lead = m.if_begin(m.ueq(lid, m.cu(0)))
    m.store(mx, m.load_f(m.sh_ptr(sc, m.cu(0))))
    m.store(t, m.cu(1))
    val lm = m.loop_begin()
    val tm = m.load_u(t)
    m.loop_cond(lm, m.ult(tm, n_pos))
    val sv = m.load_f(m.sh_ptr(sc, tm))
    val bigger = m.if_begin(m.fgt(sv, m.load_f(mx)))
    m.store(mx, sv)
    m.if_end(bigger)
    m.loop_cont(lm)
    m.store(t, m.iadd(m.load_u(t), m.cu(1)))
    m.loop_end(lm)
    m.store(sum, m.cf(0.0))
    m.store(t, m.cu(0))
    val le = m.loop_begin()
    val te = m.load_u(t)
    m.loop_cond(le, m.ult(te, n_pos))
    val ev = m.fexp(m.fsub(m.load_f(m.sh_ptr(sc, te)), m.load_f(mx)))
    m.store(m.sh_ptr(sc, te), ev)
    m.store(sum, m.fadd(m.load_f(sum), ev))
    m.loop_cont(le)
    m.store(t, m.iadd(m.load_u(t), m.cu(1)))
    m.loop_end(le)
    m.store(m.sh_ptr(tot, m.cu(0)), m.load_f(sum))
    m.if_end(lead)
    m.barrier()
    # out[hb + i] = (sum_t sc[t] * v[t, hb + i]) / total for i = lid, lid + 128, ...
    val inv = m.fdiv(m.cf(1.0), m.load_f(m.sh_ptr(tot, m.cu(0))))
    val acc = m.fvar_f32()
    val t2 = m.fvar_u32()
    m.store(i, lid)
    val lo = m.loop_begin()
    val io = m.load_u(i)
    m.loop_cond(lo, m.ult(io, hd))
    m.store(acc, m.cf(0.0))
    m.store(t2, m.cu(0))
    val lv = m.loop_begin()
    val tw = m.load_u(t2)
    m.loop_cond(lv, m.ult(tw, n_pos))
    val vv = m.load_f(m.buf_ptr(vb, m.iadd(m.imul(tw, dim), m.iadd(hb, io))))
    m.store(acc, m.fadd(m.load_f(acc), m.fmul(m.load_f(m.sh_ptr(sc, tw)), vv)))
    m.loop_cont(lv)
    m.store(t2, m.iadd(m.load_u(t2), m.cu(1)))
    m.loop_end(lv)
    m.store(m.buf_ptr(out, m.iadd(hb, io)), m.fmul(m.load_f(acc), inv))
    m.loop_cont(lo)
    m.store(i, m.iadd(m.load_u(i), lanes))
    m.loop_end(lo)
    m.finish(VK_ATTENTION_LANES)

# One thread per (head, rotated pair). cs = [cos[0..half), sin[0..half)] computed
# on the host in f64 like the CPU op. Push: pairs (= n_heads * half), half, head_dim.
pub fn vk_spv_rope() -> [u8]:
    val m = spv_module_new()
    val x = m.ssbo()
    val cs = m.ssbo()
    val out = m.ssbo()
    m.push_block([0, 0, 0])
    val gi = m.builtin_uvec3(SPV_BUILTIN_GLOBAL_INVOCATION_ID)
    m.begin_main()
    val t = m.builtin_x(gi)
    val half = m.pc(1)
    val guard = m.if_begin(m.ult(t, m.pc(0)))
    val base = m.imul(m.udiv(t, half), m.pc(2))
    val i = m.umod(t, half)
    val lo = m.iadd(base, i)
    val hi = m.iadd(lo, half)
    val x0 = m.load_f(m.buf_ptr(x, lo))
    val x1 = m.load_f(m.buf_ptr(x, hi))
    val c = m.load_f(m.buf_ptr(cs, i))
    val s = m.load_f(m.buf_ptr(cs, m.iadd(half, i)))
    m.store(m.buf_ptr(out, lo), m.fsub(m.fmul(x0, c), m.fmul(x1, s)))
    m.store(m.buf_ptr(out, hi), m.fadd(m.fmul(x1, c), m.fmul(x0, s)))
    m.if_end(guard)
    m.finish(256)

# buf[pos * dim + i] = row[i] for i < dim, in place. Push: pos, dim.
pub fn vk_spv_kv_write() -> [u8]:
    val m = spv_module_new()
    val buf = m.ssbo()
    val row = m.ssbo()
    m.push_block([0, 0])
    val gi = m.builtin_uvec3(SPV_BUILTIN_GLOBAL_INVOCATION_ID)
    m.begin_main()
    val i = m.builtin_x(gi)
    val dim = m.pc(1)
    val guard = m.if_begin(m.ult(i, dim))
    m.store(m.buf_ptr(buf, m.iadd(m.imul(m.pc(0), dim), i)), m.load_f(m.buf_ptr(row, i)))
    m.if_end(guard)
    m.finish(256)

# out[i] = table[row * cols + i] for i < cols. Push: row, cols.
pub fn vk_spv_row() -> [u8]:
    val m = spv_module_new()
    val table = m.ssbo()
    val out = m.ssbo()
    m.push_block([0, 0])
    val gi = m.builtin_uvec3(SPV_BUILTIN_GLOBAL_INVOCATION_ID)
    m.begin_main()
    val i = m.builtin_x(gi)
    val cols = m.pc(1)
    val guard = m.if_begin(m.ult(i, cols))
    m.store(m.buf_ptr(out, i), m.load_f(m.buf_ptr(table, m.iadd(m.imul(m.pc(0), cols), i))))
    m.if_end(guard)
    m.finish(256)

# Single workgroup; ties resolve to the lowest index. out[0] holds the index as
# raw u32 bits. Push: n (>= 1).
pub fn vk_spv_argmax() -> [u8]:
    val m = spv_module_new()
    val x = m.ssbo()
    val out = m.ssbo()
    m.push_block([0])
    val li = m.builtin_uvec3(SPV_BUILTIN_LOCAL_INVOCATION_ID)
    val sv = m.shared_f32(VK_REDUCE_LANES)
    val si = m.shared_u32(VK_REDUCE_LANES)
    m.begin_main()
    val lid = m.builtin_x(li)
    val n = m.pc(0)
    val bi = m.fvar_u32()
    val bv = m.fvar_f32()
    val i = m.fvar_u32()
    m.store(bi, lid)
    val clamp = m.if_begin(m.ult(n, m.iadd(lid, m.cu(1))))
    m.store(bi, m.cu(0))
    m.if_end(clamp)
    m.store(bv, m.load_f(m.buf_ptr(x, m.load_u(bi))))
    m.store(i, m.iadd(lid, m.cu(VK_REDUCE_LANES)))
    val lp = m.loop_begin()
    val iv = m.load_u(i)
    m.loop_cond(lp, m.ult(iv, n))
    val xv = m.load_f(m.buf_ptr(x, iv))
    val better = m.if_begin(m.fgt(xv, m.load_f(bv)))
    m.store(bv, xv)
    m.store(bi, iv)
    m.if_end(better)
    m.loop_cont(lp)
    m.store(i, m.iadd(m.load_u(i), m.cu(VK_REDUCE_LANES)))
    m.loop_end(lp)
    m.store(m.sh_ptr(sv, lid), m.load_f(bv))
    m.store(m.sh_ptr_u(si, lid), m.load_u(bi))
    m.barrier()
    var s = VK_REDUCE_LANES / 2
    while s >= 1:
        val active = m.if_begin(m.ult(lid, m.cu(s)))
        val other = m.iadd(lid, m.cu(s))
        val ov = m.load_f(m.sh_ptr(sv, other))
        val mv = m.load_f(m.sh_ptr(sv, lid))
        val oi = m.load_u(m.sh_ptr_u(si, other))
        val mi = m.load_u(m.sh_ptr_u(si, lid))
        val take = m.lor(m.fgt(ov, mv), m.land(m.feq(ov, mv), m.ult(oi, mi)))
        val doit = m.if_begin(take)
        m.store(m.sh_ptr(sv, lid), ov)
        m.store(m.sh_ptr_u(si, lid), oi)
        m.if_end(doit)
        m.if_end(active)
        m.barrier()
        s = s / 2
    val first = m.if_begin(m.ueq(lid, m.cu(0)))
    m.store(m.buf_ptr(out, m.cu(0)), m.bitcast_f(m.load_u(m.sh_ptr_u(si, m.cu(0)))))
    m.if_end(first)
    m.finish(VK_REDUCE_LANES)
