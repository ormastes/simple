# @gc — module uses GC runtime
#
# llama_forward_rocm — the LLaMA-2 forward pass of llama_forward.spl on the AMD
# GPU through the ROCm ops provider (slang -> pure LLM runner -> GPU API ->
# ROCm). Weights are uploaded once as raw F32 bytes; the hidden state and the
# per-layer K/V rows stay on the device. Per token only the id goes in (a row
# lookup index) and a single i32 (argmax) comes back. Every intermediate device
# buffer of a step is freed before the step returns, so a long generation does
# not grow device memory. Greedy generation uses the same prefix-reuse rule as
# kv_cache.spl (kv_reuse_len) and counts `positions_evaluated`.
#
# Error paths do not free the step's live intermediates: a failed HIP call
# means the device is unusable and the caller drops the whole model.

use std.gc_async_mut.slang.model_executor.pure.tensor_ops_rocm.{RocmOps, RocmTensor, rocm_tensor_upload_f32_bytes, rocm_tensor_free, rocm_tensor_matvec, rocm_tensor_rmsnorm, rocm_tensor_add, rocm_tensor_mul, rocm_tensor_silu, rocm_tensor_rope, rocm_tensor_kv_write, rocm_tensor_row, rocm_tensor_attention, rocm_tensor_argmax, rocm_buffer_alloc_tensor}
use std.gc_async_mut.slang.model_executor.pure.llama_forward.{LlamaConfig, llama_config_from_json}
use std.gc_async_mut.slang.model_executor.pure.weights.{PureF32Range, pure_weights_f32_ranges}
use std.gc_async_mut.slang.model_executor.pure.kv_cache.{kv_reuse_len}
use std.io_runtime.{file_exists, read_file, file_read_bytes}

pub struct RocmLayer:
    attn_norm: RocmTensor
    wq: RocmTensor
    wk: RocmTensor
    wv: RocmTensor
    wo: RocmTensor
    ffn_norm: RocmTensor
    w_gate: RocmTensor
    w_up: RocmTensor
    w_down: RocmTensor

pub struct RocmLlama:
    config: LlamaConfig
    embed: RocmTensor
    layers: [RocmLayer]
    final_norm: RocmTensor
    lm_head: RocmTensor
    tied: bool

pub struct RocmKvRows:
    keys: [RocmTensor]
    values: [RocmTensor]

pub struct RocmKvSession:
    kv: RocmKvRows
    cached_ids: [i64]
    hidden: RocmTensor
    positions_evaluated: i64

pub struct RocmGenResult:
    session: RocmKvSession
    generated: [i64]
    reused_positions: i64

fn _rocm_upload(ops: RocmOps, bytes: [u8], ranges: [PureF32Range], name: text) -> Result<RocmTensor, text>:
    for r in ranges:
        if r.name == name:
            return rocm_tensor_upload_f32_bytes(ops, bytes, r.offset, r.shape)
    Err("missing F32 tensor {name}")

fn _rocm_has(ranges: [PureF32Range], name: text) -> bool:
    for r in ranges:
        if r.name == name:
            return true
    false

# Load config.json + model.safetensors (F32) from a HF model directory onto the device.
pub fn rocm_llama_load(ops: RocmOps, model_dir: text) -> Result<RocmLlama, text>:
    val cfg_path = model_dir + "/config.json"
    if not file_exists(cfg_path):
        return Err("config.json not found in {model_dir}")
    val cfg = llama_config_from_json(read_file(cfg_path))?
    val st_path = model_dir + "/model.safetensors"
    if not file_exists(st_path):
        return Err("weights file not found: {st_path}")
    val bytes = file_read_bytes(st_path)
    val ranges = pure_weights_f32_ranges(bytes)?
    var layers: [RocmLayer] = []
    var l: i64 = 0
    while l < cfg.n_layers:
        val p = "model.layers.{l}."
        layers.push(RocmLayer(
            attn_norm: _rocm_upload(ops, bytes, ranges, p + "input_layernorm.weight")?,
            wq: _rocm_upload(ops, bytes, ranges, p + "self_attn.q_proj.weight")?,
            wk: _rocm_upload(ops, bytes, ranges, p + "self_attn.k_proj.weight")?,
            wv: _rocm_upload(ops, bytes, ranges, p + "self_attn.v_proj.weight")?,
            wo: _rocm_upload(ops, bytes, ranges, p + "self_attn.o_proj.weight")?,
            ffn_norm: _rocm_upload(ops, bytes, ranges, p + "post_attention_layernorm.weight")?,
            w_gate: _rocm_upload(ops, bytes, ranges, p + "mlp.gate_proj.weight")?,
            w_up: _rocm_upload(ops, bytes, ranges, p + "mlp.up_proj.weight")?,
            w_down: _rocm_upload(ops, bytes, ranges, p + "mlp.down_proj.weight")?
        ))
        l = l + 1
    # Tied checkpoints may store only one of embed_tokens / lm_head.
    val has_embed = _rocm_has(ranges, "model.embed_tokens.weight")
    val has_head = _rocm_has(ranges, "lm_head.weight")
    if not has_embed and not has_head:
        return Err("missing embedding / lm_head tensor")
    val embed_name = if has_embed: "model.embed_tokens.weight" else: "lm_head.weight"
    val embed = _rocm_upload(ops, bytes, ranges, embed_name)?
    val tied = not has_embed or not has_head
    val head = if tied: embed else: _rocm_upload(ops, bytes, ranges, "lm_head.weight")?
    val final_norm = _rocm_upload(ops, bytes, ranges, "model.norm.weight")?
    Ok(RocmLlama(config: cfg, embed: embed, layers: layers, final_norm: final_norm, lm_head: head, tied: tied))

fn _rocm_free_all(ops: RocmOps, ts: [RocmTensor]) -> Result<i64, text>:
    for t in ts:
        rocm_tensor_free(ops, t)?
    Ok(0)

pub fn rocm_llama_free(ops: RocmOps, m: RocmLlama) -> Result<i64, text>:
    for ly in m.layers:
        _rocm_free_all(ops, [ly.attn_norm, ly.wq, ly.wk, ly.wv, ly.wo, ly.ffn_norm, ly.w_gate, ly.w_up, ly.w_down])?
    _rocm_free_all(ops, [m.embed, m.final_norm])?
    if not m.tied:
        rocm_tensor_free(ops, m.lm_head)?
    Ok(0)

# Device K/V capacity in positions (attention keeps scores in shared memory: <= 1024).
fn _rocm_capacity(m: RocmLlama) -> i64:
    if m.config.max_pos < 1024:
        return m.config.max_pos
    1024

pub fn rocm_kv_session_new(ops: RocmOps, m: RocmLlama) -> Result<RocmKvSession, text>:
    val cap = _rocm_capacity(m)
    var keys: [RocmTensor] = []
    var values: [RocmTensor] = []
    var l: i64 = 0
    while l < m.config.n_layers:
        keys.push(rocm_buffer_alloc_tensor(ops, [cap, m.config.dim])?)
        values.push(rocm_buffer_alloc_tensor(ops, [cap, m.config.dim])?)
        l = l + 1
    Ok(RocmKvSession(kv: RocmKvRows(keys: keys, values: values), cached_ids: [], hidden: RocmTensor(ptr: 0, n: 0, shape: [0]), positions_evaluated: 0))

pub fn rocm_kv_session_free(ops: RocmOps, s: RocmKvSession) -> Result<i64, text>:
    _rocm_free_all(ops, s.kv.keys)?
    _rocm_free_all(ops, s.kv.values)?
    if s.hidden.ptr != 0:
        rocm_tensor_free(ops, s.hidden)?
    Ok(0)

# Evaluate `token` at `pos` (K/V rows [0, pos) already filled; row `pos` is
# written in place). Returns the final residual stream as a new device tensor.
pub fn llama_step_rocm(ops: RocmOps, m: RocmLlama, kv: RocmKvRows, token: i64, pos: i64) -> Result<RocmTensor, text>:
    val cfg = m.config
    var x = rocm_tensor_row(ops, m.embed, token)?
    var l: i64 = 0
    while l < cfg.n_layers:
        val ly = m.layers[l]
        val xn = rocm_tensor_rmsnorm(ops, x, ly.attn_norm, cfg.eps)?
        val q0 = rocm_tensor_matvec(ops, ly.wq, xn)?
        val k0 = rocm_tensor_matvec(ops, ly.wk, xn)?
        val v = rocm_tensor_matvec(ops, ly.wv, xn)?
        val q = rocm_tensor_rope(ops, q0, pos, cfg.n_heads, cfg.head_dim, cfg.rope_theta)?
        val k = rocm_tensor_rope(ops, k0, pos, cfg.n_heads, cfg.head_dim, cfg.rope_theta)?
        rocm_tensor_kv_write(ops, kv.keys[l], pos, k)?
        rocm_tensor_kv_write(ops, kv.values[l], pos, v)?
        val att = rocm_tensor_attention(ops, q, kv.keys[l], kv.values[l], pos + 1, cfg.n_heads, cfg.head_dim)?
        val o = rocm_tensor_matvec(ops, ly.wo, att)?
        val x1 = rocm_tensor_add(ops, x, o)?
        _rocm_free_all(ops, [xn, q0, k0, v, q, k, att, o, x])?
        val hn = rocm_tensor_rmsnorm(ops, x1, ly.ffn_norm, cfg.eps)?
        val g = rocm_tensor_matvec(ops, ly.w_gate, hn)?
        val u = rocm_tensor_matvec(ops, ly.w_up, hn)?
        val sg = rocm_tensor_silu(ops, g)?
        val ff = rocm_tensor_mul(ops, sg, u)?
        val d = rocm_tensor_matvec(ops, ly.w_down, ff)?
        val x2 = rocm_tensor_add(ops, x1, d)?
        _rocm_free_all(ops, [hn, g, u, sg, ff, d, x1])?
        x = x2
        l = l + 1
    Ok(x)

# Device logits [vocab] for a hidden state (caller frees).
pub fn llama_logits_rocm(ops: RocmOps, m: RocmLlama, hidden: RocmTensor) -> Result<RocmTensor, text>:
    val hn = rocm_tensor_rmsnorm(ops, hidden, m.final_norm, m.config.eps)?
    val logits = rocm_tensor_matvec(ops, m.lm_head, hn)?
    rocm_tensor_free(ops, hn)?
    Ok(logits)

pub fn llama_greedy_token_rocm(ops: RocmOps, m: RocmLlama, hidden: RocmTensor) -> Result<i64, text>:
    val logits = llama_logits_rocm(ops, m, hidden)?
    val id = rocm_tensor_argmax(ops, logits)?
    rocm_tensor_free(ops, logits)?
    Ok(id)

# Evaluate ids[reuse..] on top of the cached rows [0, reuse).
fn _rocm_extend(ops: RocmOps, m: RocmLlama, s: RocmKvSession, ids: [i64], reuse: i64) -> Result<RocmKvSession, text>:
    var hidden = s.hidden
    var evaluated = s.positions_evaluated
    var pos = reuse
    while pos < ids.len():
        val h = llama_step_rocm(ops, m, s.kv, ids[pos], pos)?
        if hidden.ptr != 0:
            rocm_tensor_free(ops, hidden)?
        hidden = h
        evaluated = evaluated + 1
        pos = pos + 1
    Ok(RocmKvSession(kv: s.kv, cached_ids: ids, hidden: hidden, positions_evaluated: evaluated))

# Greedy generation with the device cache. Stops at EOS or after n_new tokens.
pub fn rocm_generate_greedy(ops: RocmOps, m: RocmLlama, session: RocmKvSession, prompt_ids: [i64], n_new: i64) -> Result<RocmGenResult, text>:
    if prompt_ids.len() == 0:
        return Err("rocm_generate_greedy: empty prompt")
    val cap = _rocm_capacity(m)
    if prompt_ids.len() > cap:
        return Err("rocm_generate_greedy: prompt longer than the device KV capacity {cap}")
    val reuse = kv_reuse_len(session.cached_ids, prompt_ids)
    var s = _rocm_extend(ops, m, session, prompt_ids, reuse)?
    var ids = prompt_ids
    var generated: [i64] = []
    while generated.len() < n_new and ids.len() < cap:
        val next = llama_greedy_token_rocm(ops, m, s.hidden)?
        generated.push(next)
        if next == m.config.eos_id:
            break
        ids.push(next)
        if generated.len() < n_new and ids.len() < cap:
            s = _rocm_extend(ops, m, s, ids, ids.len() - 1)?
    Ok(RocmGenResult(session: s, generated: generated, reused_positions: reuse))
