# @gc — module uses GC runtime
#
# tts_runner — text -> speech, a 2-stage pipeline (design
# doc/05_design/ml/slang/slang_pluggable_modalities.md, kind Tts):
#   1. OuteTTS-0.2 (a plain llama/qwen2 decoder) turns a prompt into audio-code
#      tokens `<|N|>` through the ggml request API;
#   2. the WavTokenizer vocoder maps the codes to spectrogram rows, which
#      runners/istft.spl turns into 24 kHz samples.
#
# The prompt format, text normalisation and the default speaker are ported
# from llama.cpp `tools/tts/tts.cpp` at commit 67b2b7f2f2d (the last OuteTTS
# revision of that tool) — process_text, number_to_words and the en_male_1
# speaker block from edwko/OuteTTS default_speakers.

use std.common.string_core.{bytes_to_text, text_to_utf8_bytes}
use std.gc_async_mut.slang.model_executor.backend.{prepare_request_tokens, GgmlBackend, GgmlModelHandle, GgmlRequest, BackendActiveGenerationRequest, SamplerConfig, POOLING_NONE, open_backend, open_model_handle, close_model_handle, open_request_for, close_backend_request, request_configure_sampler, generate_on_request, request_embed_configure, request_set_tokens, request_embeddings, f32_le_to_floats, backend_error_text, release_backend_library}
use std.gc_async_mut.slang.model_executor.runners.istft.{wavtokenizer_istft_params, embd_to_audio}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{NativeModel}
use std.gc_async_mut.slang.modality.kinds.{Modality, KindRequest, KindResult, OutputPart}
use std.gc_async_mut.slang.modality.kind_registry.{kind_override_field, gguf_files, gguf_facts_are_vocoder}
use std.gc_async_mut.slang.engine.llm_engine.{engine_lib_path, engine_backend_available}
use std.common.audio.wav_encode.{encode_wav_pcm16}
use std.io_runtime.{time_now_monotonic_ms}
use std.gc_async_mut.slang.host.slang_host.{host_file_exists}

const OUTETTS_TEXT_SEP: text = "<|text_sep|>"
# Prefix of a tts_run error caused by the input itself (answered 400, not 500).
const TTS_INPUT_FAULT: text = "input: "

# ---------------------------------------------------------------------------
# Default speaker (OuteTTS en_male_1), verbatim from tts.cpp 67b2b7f2f2d.
# ---------------------------------------------------------------------------

fn _speaker_text() -> text:
    "<|text_start|>the<|text_sep|>overall<|text_sep|>package<|text_sep|>from<|text_sep|>just<|text_sep|>two<|text_sep|>people<|text_sep|>is<|text_sep|>pretty<|text_sep|>remarkable<|text_sep|>sure<|text_sep|>i<|text_sep|>have<|text_sep|>some<|text_sep|>critiques<|text_sep|>about<|text_sep|>some<|text_sep|>of<|text_sep|>the<|text_sep|>gameplay<|text_sep|>aspects<|text_sep|>but<|text_sep|>its<|text_sep|>still<|text_sep|>really<|text_sep|>enjoyable<|text_sep|>and<|text_sep|>it<|text_sep|>looks<|text_sep|>lovely<|text_sep|>"

