fn _speaker_audio() -> text:
    var out = "<|audio_start|>"
    for line in _speaker_audio_lines():
        out = out + "\n" + line
    out

# ---------------------------------------------------------------------------
# Text normalisation (tts.cpp process_text, OuteTTS v0.2): numbers to words,
# lower case, [-_/,.\] to spaces, drop everything but a-z and whitespace,
# collapse and trim whitespace, then each space becomes <|text_sep|>.
# ---------------------------------------------------------------------------

fn _ones(n: i64) -> text:
    val words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
                 "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
                 "seventeen", "eighteen", "nineteen"]
    words[n]

fn _tens(n: i64) -> text:
    val words = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    words[n]

fn _below_thousand(num: i64) -> text:
    var n = num
    var out = ""
    if n >= 100:
        out = out + _ones(n / 100) + " hundred "
        n = n % 100
    if n >= 20:
        out = out + _tens(n / 10)
        if n % 10 > 0:
            out = out + "-" + _ones(n % 10)
    elif n > 0:
        out = out + _ones(n)
    out

fn _is_digit(b: i64) -> bool:
    b >= 48 and b <= 57

# One `\d+(\.\d+)?` match. tts.cpp parses the integer part with std::stoi and
# answers " " when it throws (more than 2^31 - 1).
fn _number_words(int_digits: [i64], frac_digits: [i64], has_frac: bool) -> text:
    var value: i64 = 0
    for d in int_digits:
        value = value * 10 + (d - 48)
        if value > 2147483647:
            return " "
    var out = ""
    if value == 0:
        out = "zero"
    else:
        var n = value
        if n >= 1000000000:
            out = out + _below_thousand(n / 1000000000) + " billion "
            n = n % 1000000000
        if n >= 1000000:
            out = out + _below_thousand(n / 1000000) + " million "
            n = n % 1000000
        if n >= 1000:
            out = out + _below_thousand(n / 1000) + " thousand "
            n = n % 1000
        if n > 0:
            out = out + _below_thousand(n)
    if has_frac:
        out = out + " point"
        for d in frac_digits:
            out = out + " " + _ones(d - 48)
    out

fn _replace_numbers(src: [i64]) -> [i64]:
    var out: [i64] = []
    var i: i64 = 0
    val n = src.len()
    while i < n:
        if not _is_digit(src[i]):
            out.push(src[i])
            i = i + 1
            continue
        var int_digits: [i64] = []
        while i < n and _is_digit(src[i]):
            int_digits.push(src[i])
            i = i + 1
        var frac_digits: [i64] = []
        var has_frac = false
        if i + 1 < n and src[i] == 46 and _is_digit(src[i + 1]):
            has_frac = true
            i = i + 1
            while i < n and _is_digit(src[i]):
                frac_digits.push(src[i])
                i = i + 1
        for b in text_to_utf8_bytes(_number_words(int_digits, frac_digits, has_frac)):
            out.push(b.to_i64())
    out

fn _is_space(b: i64) -> bool:
    b == 32 or (b >= 9 and b <= 13)

fn outetts_process_text(input: text) -> text:
    var src: [i64] = []
    for b in text_to_utf8_bytes(input):
        src.push(b.to_i64())
    val numbered = _replace_numbers(src)
    # lower case, separators to space, keep only a-z and whitespace
    var kept: [i64] = []
    for raw in numbered:
        var b = raw
        if b >= 65 and b <= 90:
            b = b + 32
        if b == 45 or b == 95 or b == 47 or b == 44 or b == 46 or b == 92:
            b = 32
        if (b >= 97 and b <= 122) or _is_space(b):
            kept.push(b)
    # collapse whitespace runs, trim, and separate words with <|text_sep|>
    var out = ""
    var word: [u8] = []
    var words = 0
    var i: i64 = 0
    while i <= kept.len():
        if i == kept.len() or _is_space(kept[i]):
            if word.len() > 0:
                if words > 0:
                    out = out + OUTETTS_TEXT_SEP
                out = out + bytes_to_text(word)
                words = words + 1
                word = []
        else:
            word.push(kept[i].to_u8())
        i = i + 1
    out

# The full OuteTTS-0.2 completion prompt with the default speaker:
#   <|im_start|>\n <speaker words><text words><|text_end|>\n <speaker audio>
# The model continues with "\n<word><|t_..|><|code_start|><|N|>...<|code_end|>"
# per word and ends with <|audio_end|>.
fn outetts_prompt(input: text) -> text:
    "<|im_start|>\n" + _speaker_text() + outetts_process_text(input) + "<|text_end|>\n" + _speaker_audio()

# The codes the model spoke for the input: generation ends at the first
# <|audio_end|>, and only the first `words` word segments (each closed by
# <|code_end|>) are kept. A safety net: before request-scoped EOG (L4
# cdaba0b8b52) generation on a model handle ran to its cap, and OuteTTS
# invented more words (measured: ASR heard extra sentences).
fn outetts_spoken_codes(generated: text, words: i64) -> [i64]:
    var body = generated
    val end = body.find("<|audio_end|>")
    if end >= 0:
        body = body.substring(0, end)
    val segments = body.split("<|code_end|>")
    var kept = ""
    var n: i64 = 0
    while n < segments.len() and n < words:
        kept = kept + segments[n]
        n = n + 1
    _codes_of(kept)

# Words of the normalised input, i.e. the word segments OuteTTS should speak.
fn outetts_word_count(input: text) -> i64:
    val p = outetts_process_text(input)
    if p == "":
        return 0
    p.split(OUTETTS_TEXT_SEP).len()

# Every `<|N|>` (N all digits, <= 4100) in order; `<|t_0.08|>`, `<|code_start|>`
# and the like are skipped. tts.cpp keeps token ids 151672..155772, which are
# exactly `<|0|>`..`<|4100|>`.
fn _codes_of(generated: text) -> [i64]:
    val b = text_to_utf8_bytes(generated)
    val n = b.len()
    var codes: [i64] = []
    var i: i64 = 0
    while i + 4 < n:
        if b[i].to_i64() == 60 and b[i + 1].to_i64() == 124:
            var j = i + 2
            var value: i64 = 0
            while j < n and _is_digit(b[j].to_i64()) and value <= 4100:
                value = value * 10 + (b[j].to_i64() - 48)
                j = j + 1
            if j > i + 2 and j + 1 < n and b[j].to_i64() == 124 and b[j + 1].to_i64() == 62 and value <= 4100:
                codes.push(value)
                i = j + 2
                continue
        i = i + 1
    codes


# ---------------------------------------------------------------------------
# The runner: tts_available / tts_open / tts_run / tts_close (the runner
# contract). Both models are loaded only in tts_open, as handles BESIDE any
# resident chat model, and tts_close releases exactly what tts_open took: the
# two handles and this module's reference to the library. It never calls
# close_backend, which would free the chat engine's global model too.
# ---------------------------------------------------------------------------

# WavTokenizer-Large-75 output rate and its codebook size.
const TTS_SAMPLE_RATE: i32 = 24000
const TTS_CODEBOOK: i64 = 4096
# The en_male_1 prompt is ~1k tokens; 8192 (tts.cpp's n_ctx) leaves room for
# TTS_MAX_WORDS words at the per-word budget below.
const TTS_N_CTX: i64 = 8192
# Generation budget: measured ~27 tokens per spoken word (6 words -> 159
# codes plus framing); twice that plus slack.
const TTS_TOKENS_PER_WORD: i64 = 64
const TTS_MAX_WORDS: i64 = 100


var TTS_BACKEND: GgmlBackend? = None
var TTS_LLM: GgmlModelHandle? = None
var TTS_VOCODER: GgmlModelHandle? = None
var TTS_MODEL_ID = ""
# tts.cpp's sampler: top-k 4 at the default temperature 0.8, fixed seed.
var TTS_SAMPLER = SamplerConfig(temperature_milli: 800, top_k: 4, top_p_milli: 1000, repeat_penalty_milli: 1000, seed: 42)
var TTS_LAST_TIMINGS = ""

fn tts_set_sampler(config: SamplerConfig):
    TTS_SAMPLER = config

# "generate_ms=.. codes=.. vocoder_ms=.. istft_wav_ms=.. samples=.." of the last run.
fn tts_last_timings() -> text:
    TTS_LAST_TIMINGS

fn tts_available() -> bool:
    engine_backend_available()

fn _join(root: text, name: text) -> text:
    if root.ends_with("/") or root.ends_with("\\"): root + name else: root + "/" + name

# The vocoder GGUF of a Tts model directory: the slang_kind.sdn `vocoder:`
# file, else the one GGUF whose architecture is wavtokenizer-dec.
fn tts_vocoder_path(dir: text) -> Result<text, text>:
    val named = kind_override_field(dir, "vocoder")
    if named != "":
        val path = _join(dir, named)
        if host_file_exists(path):
            return Ok(path)
        return Err("slang_kind.sdn names vocoder " + named + " but " + path + " does not exist")
    for f in gguf_files(dir):
        if gguf_facts_are_vocoder(f.facts):
            return Ok(_join(dir, f.name))
    Err("no WavTokenizer vocoder (wavtokenizer-dec GGUF) in " + dir)

fn tts_close():
    match TTS_BACKEND:
        case Some(b):
            match TTS_LLM:
                case Some(h): close_model_handle(b, h)
                case None: ()
            match TTS_VOCODER:
                case Some(h): close_model_handle(b, h)
                case None: ()
            release_backend_library(b)
        case None: ()
    TTS_BACKEND = None
    TTS_LLM = None
    TTS_VOCODER = None
    TTS_MODEL_ID = ""

fn tts_open(model: NativeModel) -> Result<(), text>:
    if TTS_MODEL_ID == model.id and TTS_BACKEND.?:
        return Ok(())
    tts_close()
    if model.entry_path == "":
        return Err("model " + model.id + " has no TTS model GGUF")
    var vocoder = ""
    match tts_vocoder_path(model.root):
        Err(reason): return Err(reason)
        Ok(path): vocoder = path
    val lib_path = engine_lib_path()
    match open_backend(lib_path):
        Err(e):
            return Err("ggml backend unavailable at " + lib_path + ": " + backend_error_text(e))
        Ok(b):
            match open_model_handle(b, model.entry_path, -1):
                Err(e):
                    release_backend_library(b)
                    return Err("TTS model load failed for " + model.id + ": " + backend_error_text(e))
                Ok(llm):
                    match open_model_handle(b, vocoder, -1):
                        Err(e):
                            close_model_handle(b, llm)
                            release_backend_library(b)
                            return Err("vocoder load failed (" + vocoder + "): " + backend_error_text(e))
                        Ok(voc):
                            TTS_BACKEND = Some(b)
                            TTS_LLM = Some(llm)
                            TTS_VOCODER = Some(voc)
                            TTS_MODEL_ID = model.id
                            Ok(())

fn _request_text(req: KindRequest) -> text:
    var out = ""
    for p in req.parts:
        if p.kind == "text":
            if out != "":
                out = out + " "
            out = out + p.text
    out

fn _count_of(digits: text) -> i64:
    var n: i64 = 0
    for b in text_to_utf8_bytes(digits):
        val d = b.to_i64() - 48
        if d < 0 or d > 9:
            return 0
        n = n * 10 + d
    n

struct TtsGeneration:
    output: text
    prompt_tokens: i64
    completion_tokens: i64

# Stage 1: prompt -> generated text, on a fresh request of the LLM handle.
fn _generate_codes(b: GgmlBackend, llm: GgmlModelHandle, prompt: text, max_tokens: i64) -> Result<TtsGeneration, text>:
    match open_request_for(b, llm, TTS_N_CTX):
        Err(e): Err("TTS request failed: " + backend_error_text(e))
        Ok(request):
            match request_configure_sampler(b, request, TTS_SAMPLER):
                Err(e):
                    close_backend_request(b, request)
                    return Err("TTS sampler configure failed: " + backend_error_text(e))
                Ok(_): ()
            # Refuse, before any decode, a budget the prompt leaves no room for.
            match prepare_request_tokens(b, request, prompt):
                Err(e):
                    close_backend_request(b, request)
                    return Err("TTS prompt tokenize failed: " + backend_error_text(e))
                Ok(count):
                    if count + max_tokens > TTS_N_CTX:
                        close_backend_request(b, request)
                        return Err(TTS_INPUT_FAULT + "TTS prompt (" + count.to_text() + " tokens) plus a " + max_tokens.to_text() + " token budget exceeds the " + TTS_N_CTX.to_text() + " token context")
            val generated = generate_on_request(BackendActiveGenerationRequest(max_tokens: max_tokens.to_text(), prompt: prompt, backend: b, request: request, chat: false, stops: []))
            close_backend_request(b, request)
            match generated:
                Err(e): Err("TTS generation failed: " + backend_error_text(e))
                Ok(g): Ok(TtsGeneration(output: g.output, prompt_tokens: g.prompt_tokens, completion_tokens: _count_of(g.generated_tokens)))

# Stage 2: codes -> spectrogram rows (pooling none: one row per code).
fn _vocode(b: GgmlBackend, voc: GgmlModelHandle, codes: [i64]) -> Result<[f64], text>:
    match open_request_for(b, voc, codes.len()):
        Err(e): Err("vocoder request failed: " + backend_error_text(e))
        Ok(request):
            val rows = _vocode_on(b, request, codes)
            close_backend_request(b, request)
            rows

fn _vocode_on(b: GgmlBackend, request: GgmlRequest, codes: [i64]) -> Result<[f64], text>:
    match request_embed_configure(b, request, POOLING_NONE):
        Err(e): return Err("vocoder embeddings configure failed: " + backend_error_text(e))
        Ok(_): ()
    match request_set_tokens(b, request, codes):
        Err(e): return Err("vocoder rejected the codes: " + backend_error_text(e))
        Ok(_): ()
    match request_embeddings(b, request):
        Err(e): Err("vocoder eval failed: " + backend_error_text(e))
        Ok(bytes): Ok(f32_le_to_floats(bytes))

fn tts_run(req: KindRequest) -> Result<KindResult, text>:
    val input = _request_text(req)
    if input.trim() == "":
        return Err("no text to speak")
    match TTS_BACKEND:
        case None: return Err("tts runner is not open")
        case Some(b):
            match TTS_LLM:
                case None: return Err("tts runner is not open")
                case Some(llm):
                    match TTS_VOCODER:
                        case None: return Err("tts runner is not open")
                        case Some(voc): return _synthesize(b, llm, voc, input, req.params.max_tokens)

fn _synthesize(b: GgmlBackend, llm: GgmlModelHandle, voc: GgmlModelHandle, input: text, max_tokens_param: i64) -> Result<KindResult, text>:
    val words = outetts_word_count(input)
    # The cap bounds a model that does not stop (see outetts_spoken_codes).
    if words > TTS_MAX_WORDS:
        return Err("input has " + words.to_text() + " words; the TTS limit is " + TTS_MAX_WORDS.to_text())
    val max_tokens = if max_tokens_param > 0: max_tokens_param else: 128 + TTS_TOKENS_PER_WORD * words
    val t0 = time_now_monotonic_ms()
    var gen = TtsGeneration(output: "", prompt_tokens: 0, completion_tokens: 0)
    match _generate_codes(b, llm, outetts_prompt(input), max_tokens):
        Err(reason): return Err(reason)
        Ok(g): gen = g
    var codes: [i64] = []
    for c in outetts_spoken_codes(gen.output, words):
        if c < TTS_CODEBOOK:
            codes.push(c)
    if codes.len() == 0:
        return Err("the TTS model generated no audio codes (" + gen.completion_tokens.to_text() + " tokens)")
    val t1 = time_now_monotonic_ms()
    var rows: [f64] = []
    match _vocode(b, voc, codes):
        Err(reason): return Err(reason)
        Ok(r): rows = r
    if rows.len() == 0 or rows.len() % codes.len() != 0:
        return Err("vocoder returned " + rows.len().to_text() + " floats for " + codes.len().to_text() + " codes")
    val t2 = time_now_monotonic_ms()
    var samples: [f64] = []
    match embd_to_audio(rows, codes.len(), rows.len() / codes.len(), wavtokenizer_istft_params()):
        Err(reason): return Err(reason)
        Ok(s): samples = s
    # tts.cpp zeroes the first 0.25 s (the speaker prompt's tail bleeds in).
    # Built in one pass rather than zeroed in place.
    val quiet = TTS_SAMPLE_RATE.to_i64() / 4
    var pcm: [f32] = []
    var i: i64 = 0
    for s in samples:
        if i < quiet:
            pcm.push(0.0 as f32)
        else:
            pcm.push(s as f32)
        i = i + 1
    val wav = encode_wav_pcm16(pcm, 1, TTS_SAMPLE_RATE)
    val t3 = time_now_monotonic_ms()
    TTS_LAST_TIMINGS = "generate_ms=" + (t1 - t0).to_text() + " prompt_tokens=" + gen.prompt_tokens.to_text() + " tokens=" + gen.completion_tokens.to_text() + " codes=" + codes.len().to_text() + " vocoder_ms=" + (t2 - t1).to_text() + " istft_wav_ms=" + (t3 - t2).to_text() + " samples=" + samples.len().to_text()
    Ok(KindResult(parts: [OutputPart(modality: Modality.Audio, text: "", bytes: wav, mime: "audio/wav")], prompt_tokens: gen.prompt_tokens, completion_tokens: gen.completion_tokens))

export outetts_process_text, outetts_prompt, outetts_spoken_codes, outetts_word_count
export TTS_SAMPLE_RATE, TTS_MAX_WORDS, TTS_INPUT_FAULT, tts_available, tts_open, tts_run, tts_close, tts_vocoder_path, tts_set_sampler, tts_last_timings
