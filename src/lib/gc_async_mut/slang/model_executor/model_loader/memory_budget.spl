# @gc — module uses GC runtime
#
# Admission control for model loads.
#
# WHY THIS IS A GATE AND NOT A HINT
# ---------------------------------
# This host is a DGX Spark (GB10): 128 GB of memory UNIFIED between CPU and GPU.
# There is no separate VRAM pool to fall back on, so a model that does not fit
# does not swap or spill — it takes the whole machine down with it, along with
# whatever else was running. During this module's own bring-up a 46 GB model
# loaded alongside a 42 GB compiler build left 23 GB of headroom; a second model
# would have been fatal.
#
# So the fit check runs BEFORE a load is attempted, refuses in typed form, and
# reports the arithmetic it used. A refusal a caller can read is worth more than
# a verdict it has to trust.

use std.gc_async_mut.slang.host.slang_host.{host_os_name, host_file_read, host_run_int, host_run_text, parse_meminfo_bytes, parse_vm_stat_page_size, parse_vm_stat_available_pages, darwin_available_bytes}

# Bytes to leave for the OS, the page cache and whatever else shares this
# machine. Deliberately generous: the cost of being wrong upward is a refused
# load, and the cost of being wrong downward is the host.
#
# This was a FLAT 8 GiB, which is 6.25% of the 128 GB host it was calibrated on
# and 50%+ of an ordinary laptop -- there, an 8 GiB reserve alone exceeded what
# was free, so NOTHING could ever be admitted regardless of size. The reserve is
# now that same 6.25% of physical memory, so the DGX gets approximately its old
# reserve back while a smaller host gets one proportionate to it. Approximately,
# not exactly: Linux MemTotal excludes the kernel's own reserve, so a 128 GB box
# lands nearer 7.5 GiB than 8 -- marginally laxer than before on the one host
# where over-admission takes the machine down, and worth confirming there. The
# 1 GiB floor keeps a tiny or unreadable-total host from reserving nothing.
fn default_headroom_bytes() -> i64:
    val total = mem_total_bytes()
    val floor_bytes = 1024 * 1024 * 1024
    if total <= 0:
        return 8 * 1024 * 1024 * 1024
    val proportional = total / 16
    if proportional < floor_bytes:
        return floor_bytes
    proportional

# Physical memory. Distinct from mem_available_bytes: this one never changes
# under load, which is exactly what a reserve should be sized against.
fn mem_total_bytes() -> i64:
    val os = host_os_name()
    if os == "linux":
        return parse_meminfo_bytes(host_file_read("/proc/meminfo"), "MemTotal")
    if os == "windows":
        return _win32_os_kib("TotalVisibleMemorySize")
    host_run_int("sysctl", ["-n", "hw.memsize"])

# Windows has neither /proc/meminfo nor sysctl. Win32_OperatingSystem reports
# TotalVisibleMemorySize in KiB (same PowerShell/CIM probe the test runner's
# system_monitor uses). -1 when the probe fails, which check_fit turns into a
# refusal.
fn _win32_os_kib(field: text) -> i64:
    val kib = host_run_int("powershell", ["-NoProfile", "-Command", "(Get-CimInstance Win32_OperatingSystem)." + field])
    if kib <= 0:
        return -1
    kib * 1024

# MemAvailable analogue on Windows: Win32_PerfFormattedData_PerfOS_Memory
# AvailableBytes = free + zeroed + STANDBY (file-cache) pages. Win32_OperatingSystem
# FreePhysicalMemory excludes the standby list, so after a process reads multi-GB
# model files it collapses while the OS can still hand the memory out: on
# 2026-11-15 slang refused a 256M-parameter model ("needs 10 GiB ... only 6 GiB
# available") for 30+ minutes with ~38 GiB available. Measured 2026-11-15 on a
# heavily loaded host (7B GGUF already cached, so the gap did not reappear):
# FreePhysicalMemory 26.56 GB (54 s), AvailableBytes 27.05 GB (135 s), Get-Counter
# 26.29 GB (92 s); after re-reading the file 26.25 / 27.05 / 27.58 GB. Probe wall
# times are load noise (all three within 54-135 s), so the CIM class is chosen
# over Get-Counter because it is not localised.
fn _win32_available_bytes() -> i64:
    val bytes = host_run_int("powershell", ["-NoProfile", "-Command", "(Get-CimInstance Win32_PerfFormattedData_PerfOS_Memory).AvailableBytes"])
    if bytes <= 0:
        return -1
    bytes

struct FitVerdict:
    fits: bool
    model_bytes: i64
    available_bytes: i64
    headroom_bytes: i64
    reason: text

# MemAvailable, not MemFree: free memory excludes reclaimable page cache and so
# under-reports what a load can actually use, which would refuse loads that fit.
#
# Returns -1 when the host's memory cannot be established at all. That is
# deliberately not "assume it fits": `check_fit` turns -1 into a refusal.
fn mem_available_bytes() -> i64:
    val os = host_os_name()
    if os == "linux":
        return parse_meminfo_bytes(host_file_read("/proc/meminfo"), "MemAvailable")
    if os == "windows":
        return _win32_available_bytes()
    if os == "macos":
        return _mem_available_darwin()
    -1

# macOS has no /proc, so the Linux lane above returns -1 there and every load
# was refused with "could not read MemAvailable" on a machine with plenty of
# free memory — a fit gate that refuses everything is not a gate, it is an
# outage. Apple silicon is also UNIFIED memory, exactly the topology the
# headroom rule above exists for, so the check matters more here, not less.
#
# `vm_stat` reports pages, not bytes, and there is no MemAvailable analogue, so
# availability is the pages vm_stat itself calls reclaimable: free + inactive +
# speculative, capped at hw.memsize. Purgeable pages are left out (they overlap
# active/inactive), and memory vm_stat does not account for at all (GPU and
# firmware carve-outs on Apple silicon) is never counted as available — the
# old "total minus active+wired+compressed" did count it. The page size comes
# from vm_stat's own header, so the counts and their unit share one source;
# hw.pagesize is only the fallback.
fn _mem_available_darwin() -> i64:
    val total = host_run_int("sysctl", ["-n", "hw.memsize"])
    if total <= 0:
        return -1
    # No shell pipe: vm_stat runs directly and slang_host parses its text.
    val stat = host_run_text("vm_stat", [])
    var page_size = parse_vm_stat_page_size(stat)
    if page_size <= 0:
        page_size = host_run_int("sysctl", ["-n", "hw.pagesize"])
    darwin_available_bytes(total, page_size, parse_vm_stat_available_pages(stat))

fn _gib(bytes: i64) -> text:
    (bytes / (1024 * 1024 * 1024)).to_text() + " GiB"

# A model needs its weights plus room for the KV cache and activations.
# `overhead_bytes` is the caller's estimate of that second part; it is not
# guessed here because it depends on context length, which is the caller's
# choice.
fn check_fit(model_bytes: i64, overhead_bytes: i64, headroom_bytes: i64) -> FitVerdict:
    check_fit_with_available(model_bytes, overhead_bytes, headroom_bytes, mem_available_bytes())

# The arithmetic of `check_fit` against an availability the caller already
# probed. Two probes seconds apart are not the same number (Windows
# FreePhysicalMemory measured drifting ~270 MB between calls), so a caller that
# must compare several verdicts against ONE budget probes once and passes it
# here. -1 still means "unknown" and still refuses. A negative `model_bytes`
# (dir_byte_size could not list the model directory) is likewise unknown and
# refuses.
fn check_fit_with_available(model_bytes: i64, overhead_bytes: i64, headroom_bytes: i64, available: i64) -> FitVerdict:
    val needed = model_bytes + overhead_bytes + headroom_bytes
    if model_bytes < 0:
        return FitVerdict(fits: false, model_bytes: model_bytes, available_bytes: available,
            headroom_bytes: headroom_bytes,
            reason: "could not establish the model size (model directory could not be listed); refusing rather than loading blind")
    if available < 0:
        return FitVerdict(fits: false, model_bytes: model_bytes, available_bytes: -1,
            headroom_bytes: headroom_bytes,
            reason: "could not establish available memory (no MemAvailable in /proc/meminfo, no usable sysctl/vm_stat, and no Win32_OperatingSystem via PowerShell); refusing rather than loading blind")
    if needed > available:
        return FitVerdict(fits: false, model_bytes: model_bytes, available_bytes: available,
            headroom_bytes: headroom_bytes,
            reason: "needs " + _gib(needed) + " (" + _gib(model_bytes) + " weights + " + _gib(overhead_bytes) + " runtime + " + _gib(headroom_bytes) + " headroom) but only " + _gib(available) + " is available")
    FitVerdict(fits: true, model_bytes: model_bytes, available_bytes: available,
        headroom_bytes: headroom_bytes, reason: "")

# Runtime cost beyond the weights, for admission only (never for allocation).
#
# GGUF hyperparameters (layers, kv heads, head dim) are not readable before the
# backend opens the file, so the exact KV size
# (2 * n_layers * n_ctx * n_kv_heads * head_dim * 2 bytes, f16) cannot be
# computed here. Instead: KV bytes = n_ctx * kv_bytes_per_token, with
# kv_bytes_per_token = model_bytes / 32768 clamped to [16 KiB, 512 KiB]. Checked
# against real shapes: Qwen2.5-1.5B Q4 (~1 GB file) is 28 KiB/token vs 32 KiB
# here; Qwen2.5-7B Q4 (~4.4 GB) is 56 KiB vs 134 KiB; Llama-3-8B (GQA) 128 KiB vs 150 KiB; Llama-3-70B
# (GQA) 320 KiB vs the 512 KiB cap. Not covered: MHA models (Llama-2-7B is 512 KiB
# vs 116 KiB), which are rare now and still bounded by the headroom. Plus 512 MiB for compute
# buffers. A 1.5B Q4 model at n_ctx 4096 therefore needs ~0.6 GiB, not 6 GiB.
fn estimate_runtime_overhead_bytes(model_bytes: i64, n_ctx: i64) -> i64:
    val kib = 1024
    val compute_slack = 512 * 1024 * 1024
    var per_token = model_bytes / 32768
    if per_token < 16 * kib:
        per_token = 16 * kib
    if per_token > 512 * kib:
        per_token = 512 * kib
    var ctx = n_ctx
    if ctx < 0:
        ctx = 0
    ctx * per_token + compute_slack

export FitVerdict, default_headroom_bytes, mem_available_bytes, mem_total_bytes, check_fit, check_fit_with_available, estimate_runtime_overhead_bytes
