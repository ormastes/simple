"""Fail-closed scalar protocol for a future structured SSR service.

The socket worker remains the owner of ``HttpRequestData``.  A future runtime
adapter may copy bounded request bytes into an owner-managed payload registry
and send only ``SsrScalarRenderCommandV1`` words to one long-lived renderer
service.  The payload token is an opaque lease identifier, never an address.

The reciprocal completion is also fixed-width scalar metadata.  A result blob
can only be named by an owner-managed blob lease; this module has no runtime
port, payload registry, or blob registry, and therefore cannot mint a lease,
accept a completion, or release a result.  Cancellation and release below are
fail-closed protocol contracts for that future single owner, including the
required late-result rejection path.

This module deliberately cannot advertise a ready bridge yet.  The current
runtime pool has no trap-safe, structured long-lived service lifecycle, so a
per-request detached task would leak its handle and leave cancellation
unprovable.  Callers can query the capability and fail closed without spawning
anything.  A runtime adapter must add a private readiness mint plus bounded
enqueue/dequeue and join receipts before this owner may accept commands.
"""

use std.http_server.ssr_renderer_owner.{
    SSR_RENDER_MAX_BODY_BYTES,
    SSR_RENDER_MAX_PIXELS,
    SSR_RENDER_MAX_QUEUE_DEPTH,
    SSR_RENDER_MAX_VIEWPORT_HEIGHT,
    SSR_RENDER_MAX_VIEWPORT_WIDTH
}

val SSR_SCALAR_SERVICE_PROTOCOL_V1: i64 = 1
val SSR_SCALAR_SERVICE_COMMAND_WORDS_V1: i64 = 9
val SSR_SCALAR_SERVICE_COMPLETION_WORDS_V1: i64 = 9
val SSR_SCALAR_SERVICE_RESULT_WORDS_V1: i64 = 7

# The bounded native transport owns fixed copied buffers.  These limits are
# deliberately narrower than the general renderer maximum; a future capacity
# increase needs a native memory-budget measurement, not an implicit accept
# that fails after a lease has been minted.
val SSR_SCALAR_MAX_PAYLOAD_BYTES: i64 = 65536
val SSR_SCALAR_MAX_RESULT_BYTES: i64 = 262144

val SSR_SCALAR_BACKEND_AUTO: i64 = 0
val SSR_SCALAR_BACKEND_CPU: i64 = 1
val SSR_SCALAR_BACKEND_GPU: i64 = 2

val SSR_SCALAR_RECEIPT_REJECTED: i64 = 0
val SSR_SCALAR_RECEIPT_ENQUEUED: i64 = 1
val SSR_SCALAR_RECEIPT_COMPLETED: i64 = 2
val SSR_SCALAR_RECEIPT_CANCELED: i64 = 3
val SSR_SCALAR_RECEIPT_RELEASED: i64 = 4
val SSR_SCALAR_RECEIPT_LATE_RESULT: i64 = 5

val SSR_SCALAR_LIFECYCLE_UNAVAILABLE: i64 = 0
val SSR_SCALAR_LIFECYCLE_STARTING: i64 = 1
val SSR_SCALAR_LIFECYCLE_RUNNING: i64 = 2
val SSR_SCALAR_LIFECYCLE_DRAINING: i64 = 3
val SSR_SCALAR_LIFECYCLE_STOPPED: i64 = 4

val SSR_SCALAR_LEASE_NONE: i64 = 0
val SSR_SCALAR_LEASE_PENDING: i64 = 1
val SSR_SCALAR_LEASE_CANCELED: i64 = 2
val SSR_SCALAR_LEASE_COMPLETED: i64 = 3
val SSR_SCALAR_LEASE_RELEASED: i64 = 4

val SSR_SCALAR_REASON_NONE: i64 = 0
val SSR_SCALAR_REASON_INVALID_COMMAND: i64 = 1
val SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE: i64 = 2
val SSR_SCALAR_REASON_QUEUE_FULL: i64 = 3
val SSR_SCALAR_REASON_PROTOCOL_VIOLATION: i64 = 4
val SSR_SCALAR_REASON_RESULT_INVALID: i64 = 5
val SSR_SCALAR_REASON_NOT_OWNED: i64 = 6
val SSR_SCALAR_REASON_ALREADY_TERMINAL: i64 = 7
val SSR_SCALAR_REASON_LATE_RESULT: i64 = 8

struct SsrScalarRenderCommandV1:
    """Fixed scalar command; contains no request aggregate or host address."""
    job_id: i64
    payload_lease_id: i64
    payload_bytes: i64
    width: i64
    height: i64
    max_body_bytes: i64
    backend_code: i64
    config_revision: i64
    completion_port_id: i64

struct SsrScalarServiceReceiptV1:
    """Fixed scalar admission/completion evidence bound to one job."""
    job_id: i64
    service_lease_id: i64
    status_code: i64
    reason_code: i64

struct SsrScalarRenderCompletionV1:
    """Fixed scalar completion; blob material stays in an owner registry."""
    job_id: i64
    service_lease_id: i64
    payload_lease_id: i64
    result_blob_lease_id: i64
    result_bytes: i64
    status_code: i64
    reason_code: i64
    config_revision: i64
    completion_port_id: i64

struct SsrScalarResultMetadataV1:
    """Bounded result receipt, never a PNG aggregate or backing address."""
    job_id: i64
    service_lease_id: i64
    result_blob_lease_id: i64
    result_bytes: i64
    content_type_code: i64
    content_status_code: i64
    config_revision: i64

struct SsrScalarServiceCapabilityV1:
    """Read-only startup capability; readiness is never inferred."""
    protocol_revision: i64
    command_words: i64
    queue_limit: i64
    bridge_ready: bool

struct SsrScalarServiceOwnerV1:
    """Canonical service capability owner on the parent execution domain."""
    capability_state: SsrScalarServiceCapabilityV1
    active_count: i64
    rejected_count: i64
    next_service_lease_id: i64
    lifecycle_state: i64

fn ssr_scalar_backend_known(backend_code: i64) -> bool:
    backend_code == SSR_SCALAR_BACKEND_AUTO
        or backend_code == SSR_SCALAR_BACKEND_CPU
        or backend_code == SSR_SCALAR_BACKEND_GPU

fn ssr_scalar_command_well_formed(command: SsrScalarRenderCommandV1) -> bool:
    if command.job_id <= 0 or command.payload_lease_id <= 0:
        return false
    if command.payload_bytes <= 0
            or command.payload_bytes > command.max_body_bytes:
        return false
    if command.payload_bytes > SSR_SCALAR_MAX_PAYLOAD_BYTES:
        return false
    if command.max_body_bytes <= 0
            or command.max_body_bytes > SSR_RENDER_MAX_BODY_BYTES:
        return false
    if command.max_body_bytes > SSR_SCALAR_MAX_RESULT_BYTES:
        return false
    if command.width <= 0 or command.width > SSR_RENDER_MAX_VIEWPORT_WIDTH:
        return false
    if command.height <= 0 or command.height > SSR_RENDER_MAX_VIEWPORT_HEIGHT:
        return false
    if command.width > SSR_RENDER_MAX_PIXELS / command.height:
        return false
    if not ssr_scalar_backend_known(command.backend_code):
        return false
    command.config_revision > 0 and command.completion_port_id > 0

fn ssr_scalar_completion_well_formed(
        completion: SsrScalarRenderCompletionV1) -> bool:
    if completion.job_id <= 0 or completion.service_lease_id <= 0:
        return false
    if completion.payload_lease_id <= 0 or completion.completion_port_id <= 0:
        return false
    if completion.config_revision <= 0:
        return false
    if completion.status_code == SSR_SCALAR_RECEIPT_COMPLETED:
        return completion.result_blob_lease_id > 0
            and completion.result_bytes > 0
            and completion.result_bytes <= SSR_SCALAR_MAX_RESULT_BYTES
    completion.result_blob_lease_id == 0 and completion.result_bytes == 0

fn ssr_scalar_completion_matches_command(
        command: SsrScalarRenderCommandV1,
        completion: SsrScalarRenderCompletionV1) -> bool:
    command.job_id == completion.job_id
        and command.payload_lease_id == completion.payload_lease_id
        and command.config_revision == completion.config_revision
        and command.completion_port_id == completion.completion_port_id

fn ssr_scalar_result_metadata_well_formed(
        result: SsrScalarResultMetadataV1) -> bool:
    result.job_id > 0 and result.service_lease_id > 0
        and result.result_blob_lease_id > 0
        and result.result_bytes > 0
        and result.result_bytes <= SSR_RENDER_MAX_BODY_BYTES
        and result.content_type_code > 0
        and result.content_status_code >= 100
        and result.content_status_code <= 599
        and result.config_revision > 0

fn ssr_scalar_lease_state_known(lease_state: i64) -> bool:
    lease_state == SSR_SCALAR_LEASE_NONE
        or lease_state == SSR_SCALAR_LEASE_PENDING
        or lease_state == SSR_SCALAR_LEASE_CANCELED
        or lease_state == SSR_SCALAR_LEASE_COMPLETED
        or lease_state == SSR_SCALAR_LEASE_RELEASED

fn ssr_scalar_can_cancel(lease_state: i64) -> bool:
    lease_state == SSR_SCALAR_LEASE_PENDING

fn ssr_scalar_can_release(lease_state: i64) -> bool:
    lease_state == SSR_SCALAR_LEASE_CANCELED
        or lease_state == SSR_SCALAR_LEASE_COMPLETED

fn ssr_scalar_completion_is_late(lease_state: i64) -> bool:
    lease_state == SSR_SCALAR_LEASE_CANCELED
        or lease_state == SSR_SCALAR_LEASE_RELEASED

fn ssr_scalar_rejected(job_id: i64, reason_code: i64) -> SsrScalarServiceReceiptV1:
    SsrScalarServiceReceiptV1(job_id: job_id, service_lease_id: 0,
        status_code: SSR_SCALAR_RECEIPT_REJECTED, reason_code: reason_code)

impl SsrScalarServiceOwnerV1:
    static fn unavailable(queue_limit: i64) -> SsrScalarServiceOwnerV1:
        """Create the only presently valid capability: explicit unavailable."""
        var bounded_limit = queue_limit
        if bounded_limit <= 0 or bounded_limit > SSR_RENDER_MAX_QUEUE_DEPTH:
            bounded_limit = 0
        SsrScalarServiceOwnerV1(
            capability_state: SsrScalarServiceCapabilityV1(
                protocol_revision: SSR_SCALAR_SERVICE_PROTOCOL_V1,
                command_words: SSR_SCALAR_SERVICE_COMMAND_WORDS_V1,
                queue_limit: bounded_limit,
                bridge_ready: false),
            active_count: 0,
            rejected_count: 0,
            next_service_lease_id: 1,
            lifecycle_state: SSR_SCALAR_LIFECYCLE_UNAVAILABLE)

    fn capability() -> SsrScalarServiceCapabilityV1:
        self.capability_state

    fn pending_count() -> i64:
        self.active_count

    fn lifecycle() -> i64:
        self.lifecycle_state

    fn rejected_total() -> i64:
        self.rejected_count

    me submit(command: SsrScalarRenderCommandV1) -> SsrScalarServiceReceiptV1:
        """Reject without spawning until a structured bridge owns lifecycle."""
        if not ssr_scalar_command_well_formed(command):
            self.rejected_count = self.rejected_count + 1
            return ssr_scalar_rejected(command.job_id,
                SSR_SCALAR_REASON_INVALID_COMMAND)
        if not self.capability_state.bridge_ready:
            self.rejected_count = self.rejected_count + 1
            return ssr_scalar_rejected(command.job_id,
                SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE)
        if self.capability_state.queue_limit <= 0
                or self.active_count >= self.capability_state.queue_limit:
            self.rejected_count = self.rejected_count + 1
            return ssr_scalar_rejected(command.job_id,
                SSR_SCALAR_REASON_QUEUE_FULL)

        # Unreachable in v1: readiness has no public mint.  Keeping an explicit
        # rejection protects this boundary if state is corrupted or decoded
        # from an untrusted aggregate in a future adapter.
        self.rejected_count = self.rejected_count + 1
        ssr_scalar_rejected(command.job_id,
            SSR_SCALAR_REASON_PROTOCOL_VIOLATION)

    me cancel(job_id: i64, service_lease_id: i64) -> SsrScalarServiceReceiptV1:
        """Future adapters may revoke only a pending scalar lease.

        The current capability owns no runtime port or lease registry, so it
        never fabricates cancellation success.  A completion received after a
        future cancellation or release must be reported as a late result and
        its blob lease released by that adapter, never committed to HTTP.
        """
        self.rejected_count = self.rejected_count + 1
        if job_id <= 0 or service_lease_id <= 0:
            return ssr_scalar_rejected(job_id, SSR_SCALAR_REASON_INVALID_COMMAND)
        ssr_scalar_rejected(job_id, SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE)

    me release(job_id: i64, service_lease_id: i64) -> SsrScalarServiceReceiptV1:
        """Fail closed until one owner can release payload and blob leases."""
        self.rejected_count = self.rejected_count + 1
        if job_id <= 0 or service_lease_id <= 0:
            return ssr_scalar_rejected(job_id, SSR_SCALAR_REASON_INVALID_COMMAND)
        ssr_scalar_rejected(job_id, SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE)

export SSR_SCALAR_SERVICE_PROTOCOL_V1, SSR_SCALAR_SERVICE_COMMAND_WORDS_V1
export SSR_SCALAR_SERVICE_COMPLETION_WORDS_V1, SSR_SCALAR_SERVICE_RESULT_WORDS_V1
export SSR_SCALAR_BACKEND_AUTO, SSR_SCALAR_BACKEND_CPU, SSR_SCALAR_BACKEND_GPU
export SSR_SCALAR_RECEIPT_REJECTED, SSR_SCALAR_RECEIPT_ENQUEUED
export SSR_SCALAR_RECEIPT_COMPLETED
export SSR_SCALAR_RECEIPT_CANCELED, SSR_SCALAR_RECEIPT_RELEASED
export SSR_SCALAR_RECEIPT_LATE_RESULT
export SSR_SCALAR_MAX_PAYLOAD_BYTES, SSR_SCALAR_MAX_RESULT_BYTES
export SSR_SCALAR_LIFECYCLE_UNAVAILABLE, SSR_SCALAR_LIFECYCLE_STARTING
export SSR_SCALAR_LIFECYCLE_RUNNING, SSR_SCALAR_LIFECYCLE_DRAINING
export SSR_SCALAR_LIFECYCLE_STOPPED
export SSR_SCALAR_LEASE_NONE, SSR_SCALAR_LEASE_PENDING, SSR_SCALAR_LEASE_CANCELED
export SSR_SCALAR_LEASE_COMPLETED, SSR_SCALAR_LEASE_RELEASED
export SSR_SCALAR_REASON_NONE, SSR_SCALAR_REASON_INVALID_COMMAND
export SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE, SSR_SCALAR_REASON_QUEUE_FULL
export SSR_SCALAR_REASON_PROTOCOL_VIOLATION
export SSR_SCALAR_REASON_RESULT_INVALID, SSR_SCALAR_REASON_NOT_OWNED
export SSR_SCALAR_REASON_ALREADY_TERMINAL, SSR_SCALAR_REASON_LATE_RESULT
export SsrScalarRenderCommandV1, SsrScalarServiceReceiptV1
export SsrScalarRenderCompletionV1, SsrScalarResultMetadataV1
export SsrScalarServiceCapabilityV1, SsrScalarServiceOwnerV1
export ssr_scalar_backend_known, ssr_scalar_command_well_formed
export ssr_scalar_completion_well_formed, ssr_scalar_completion_matches_command
export ssr_scalar_result_metadata_well_formed, ssr_scalar_lease_state_known
export ssr_scalar_can_cancel, ssr_scalar_can_release, ssr_scalar_completion_is_late
