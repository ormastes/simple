"""
# Hosted asynchronous server-side web renderer

Bridges the no-GC HTTP worker callback contract into the canonical hosted web
renderer.  Request HTML is already resident in ``HttpRequestData.body``: this
hot path never reads source files.  Layout produces ``DrawIrComposition`` and
Engine2D owns rasterization through
``simple_web_render_html_to_pixels_with_engine2d_backend``.

The HTTP worker's ``AsyncHandlerLifecycle`` is the admission/capacity owner.
Accepted jobs use the process shared bounded worker/task facade and always send
one completion message, including validation and render failures.
"""

use std.http_server.handler.{HandlerRegistry}
use std.http_server.types.{HttpRequestData, HttpResponseData, LocationConfig}
use std.http_server.async_handler_lifecycle.{send_async_handler_completion}
use std.concurrent.multicore_green.{multicore_green_spawn}
use std.concurrent.mutex.{mutex_new, mutex_with_lock_keeping, Mutex}
use std.gc_async_mut.gpu.browser_engine.simple_web_ssr_renderer.{
    simple_web_ssr_render_html_to_pixels
}
use std.common.image.png_encode.{encode_argb_to_png}
use std.http_server.ssr_renderer_owner.{SsrRenderJob, SsrRendererOwner}

class SsrAsyncConfig:
    width: i32
    height: i32
    max_html_bytes: i64
    engine2d_backend: text

    static fn production(width: i32, height: i32, max_html_bytes: i64,
                         engine2d_backend: text = "auto") -> SsrAsyncConfig:
        SsrAsyncConfig(
            width: width,
            height: height,
            max_html_bytes: max_html_bytes,
            engine2d_backend: engine2d_backend
        )

var SSR_ASYNC_CONFIG = SsrAsyncConfig.production(1280, 720, 1048576, "auto")
var SSR_ASYNC_REGISTERED = false
# Engine2D/layout still owns process-global route, timing, and font caches.
# The gate is deliberately a fixed sentinel: the renderer owner state below
# stays in this module and every renderer state transition happens while the
# gate is held. Request preparation can run on the worker pool; only the
# global-cache render section serializes.
var SSR_RENDERER_GATE: Mutex = mutex_new(0)
var SSR_RENDERER_OWNER = SsrRendererOwner(
    queue_limit: 1, queue_depth: 0, gpu_available: false, active_job_id: 0,
    active_lease_id: 0, next_lease_id: 1, accepted_count: 0,
    completed_count: 0, rejected_count: 0, gpu_admission_count: 0,
    cpu_fallback_count: 0)

fn _ssr_response(status: i64, reason: text, content_type: text,
                 body: text, body_bytes: [u8] = []) -> HttpResponseData:
    HttpResponseData(
        status: status,
        reason: reason,
        headers: [("Content-Type", content_type), ("Server", "SimpleServer")],
        body: body,
        body_bytes: body_bytes,
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: false
    )

fn _render_ssr_request_unlocked(request: HttpRequestData,
                                config: SsrAsyncConfig) -> HttpResponseData:
    """Render one in-memory HTML request through web layout and Engine2D."""
    if request.method != "POST":
        return _ssr_response(405, "Method Not Allowed", "text/plain", "SSR requires POST")
    if request.body.len() == 0:
        return _ssr_response(400, "Bad Request", "text/plain", "SSR HTML body is empty")
    if config.max_html_bytes <= 0 or request.body.len() > config.max_html_bytes:
        return _ssr_response(413, "Payload Too Large", "text/plain", "SSR HTML body exceeds configured limit")
    if config.width <= 0 or config.height <= 0:
        return _ssr_response(500, "Internal Server Error", "text/plain", "SSR viewport is invalid")

    val pixels = simple_web_ssr_render_html_to_pixels(
        request.body, config.width, config.height, config.engine2d_backend
    )
    val expected_pixels = config.width.to_i64() * config.height.to_i64()
    if pixels.len() != expected_pixels:
        return _ssr_response(500, "Internal Server Error", "text/plain", "SSR Engine2D render failed")
    val png = encode_argb_to_png(pixels, config.width, config.height)
    if png.len() == 0:
        return _ssr_response(500, "Internal Server Error", "text/plain", "SSR PNG encoding failed")
    _ssr_response(200, "OK", "image/png", "", png)

fn _render_ssr_request_with_owner(request: HttpRequestData,
        config: SsrAsyncConfig, job_id: i64) -> HttpResponseData:
    # Engine2D has several concrete CPU backend labels (for example
    # ``cpu_simd``). Admission needs only the coarse device class; preserve
    # the exact label for the actual renderer below.
    val requested_backend = if config.engine2d_backend == "auto" or
            config.engine2d_backend == "gpu":
        config.engine2d_backend
    else:
        "cpu"
    val job = match SsrRenderJob.create(job_id, request.method, request.body,
            config.width.to_i64(), config.height.to_i64(),
            config.max_html_bytes, requested_backend, 1):
        Some(value): value
        nil: return _ssr_response(400, "Bad Request", "text/plain",
            "SSR request is outside renderer admission bounds")
    val admission = SSR_RENDERER_OWNER.admit(job)
    if not admission.accepted:
        return _ssr_response(503, "Service Unavailable", "text/plain",
            "SSR renderer is busy")
    val admitted_config = SsrAsyncConfig.production(config.width,
        config.height, config.max_html_bytes, admission.selected_backend)
    val response = _render_ssr_request_unlocked(request, admitted_config)
    val receipt = SSR_RENDERER_OWNER.complete(admission, response.status == 200)
    if not receipt.completed:
        return _ssr_response(500, "Internal Server Error", "text/plain",
            "SSR renderer completion receipt failed")
    response

fn render_ssr_request_with_job_id(request: HttpRequestData,
        config: SsrAsyncConfig, job_id: i64) -> HttpResponseData:
    # Keep global Engine2D/layout/font state under one owner lease. The
    # closure and its captured request live in this module, after the async
    # worker has reconstructed a child-owned HttpRequestData.
    mutex_with_lock_keeping(SSR_RENDERER_GATE, 0,
        \: _render_ssr_request_with_owner(request, config, job_id))

fn render_ssr_request(request: HttpRequestData,
                      config: SsrAsyncConfig) -> HttpResponseData:
    # Synchronous/unit callers have no external lifecycle id. Production
    # async submission invokes the job-bound overload above.
    render_ssr_request_with_job_id(request, config, 1)

fn _complete_ssr_job(job_id: i64, completion_channel_id: i64,
                     request_method: text, request_body: text,
                     width: i32, height: i32, max_html_bytes: i64,
                     engine2d_backend: text) -> i64:
    # The runtime pool boundary carries only immutable scalar/text fields.
    # Rebuild the request inside the child so headers/params dictionaries from
    # the socket worker never cross into a parallel execution domain.  This is
    # an ownership boundary, not merely a smaller struct: the child owns the
    # request value it renders and returns only the typed completion response.
    val child_request = HttpRequestData(
        method: request_method,
        path: "/render",
        query: "",
        version: "HTTP/1.1",
        headers: [],
        body: request_body,
        params: {},
        peer_addr: ""
    )
    val config = SsrAsyncConfig.production(width, height, max_html_bytes,
        engine2d_backend)
    val response = render_ssr_request_with_job_id(child_request, config, job_id)
    if send_async_handler_completion(completion_channel_id, job_id, response):
        return 1
    0

fn submit_ssr_async(job_id: i64, completion_channel_id: i64,
                    request: HttpRequestData,
                    location: LocationConfig) -> bool:
    """Registry callback. Admission was bounded by the worker before this call."""
    if location.handler_type == "":
        return false
    # Copy the immutable request fields before submitting.  HttpRequestData is
    # a worker-owned aggregate and must not be captured by the pool closure.
    # Registration freezes this scalar configuration before any worker is
    # created. Do not read SSR_ASYNC_CONFIG from the pool closure after a
    # request is submitted: captures are immutable child-owned values.
    val width = SSR_ASYNC_CONFIG.width
    val height = SSR_ASYNC_CONFIG.height
    val max_html_bytes = SSR_ASYNC_CONFIG.max_html_bytes
    val engine2d_backend = SSR_ASYNC_CONFIG.engine2d_backend
    val request_method = request.method
    val request_body = request.body
    val handle = multicore_green_spawn(\: _complete_ssr_job(
        job_id, completion_channel_id, request_method, request_body, width,
        height, max_html_bytes, engine2d_backend
    ))
    handle.used_runtime_pool()

fn register_ssr_async_handler(mut registry: HandlerRegistry,
                              name: text,
                              config: SsrAsyncConfig) -> bool:
    """Install the hosted SSR adapter in a worker registry.

    The callback ABI has no context parameter, so the hosted server owns one
    process-wide SSR configuration. Register it once during startup, before
    workers accept requests.
    """
    if name == "" or config.width <= 0 or config.height <= 0 or config.max_html_bytes <= 0:
        return false
    if SSR_ASYNC_REGISTERED:
        return false
    # Startup-only API: callers register before workers are created. A live
    # config replacement would need a renderer-owner versioned queue.
    SSR_ASYNC_CONFIG = config
    SSR_ASYNC_REGISTERED = true
    registry.register_async(name, submit_ssr_async)
    true

export SsrAsyncConfig, render_ssr_request, render_ssr_request_with_job_id
export submit_ssr_async
export register_ssr_async_handler
