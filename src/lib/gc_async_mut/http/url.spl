# HTTP URL Handling
#
# Provides URL encoding/decoding and query string handling.

use std.common.binary_inspect.{percent_hex_encode_byte, percent_hex_decode_pair}

# ============================================================================
# Query String Handling
# ============================================================================

# Parse query string into list of (name, value) tuples
# Example: "name=Alice&age=30" -> [("name", "Alice"), ("age", "30")]
fn parse_query_string(query: text) -> list:
    if query.length() == 0:
        return []

    val pairs = query.split("&")
    var params = []

    var i = 0
    while i < pairs.length():
        val pair = pairs[i]
        val param = parse_query_param(pair)
        params.push(param)
        i = i + 1

    return params

# Parse single query parameter
# Example: "name=Alice" -> ("name", "Alice")
fn parse_query_param(pair: text) -> tuple:
    val eq_pos = pair.index_of("=")

    if eq_pos < 0:
        return (pair, "")

    val name = pair.substring(0, eq_pos)
    val value_encoded = pair.substring(eq_pos + 1, pair.length())
    val value = url_decode(value_encoded)

    return (name, value)

# Build query string from list of (name, value) tuples
fn build_query_string(params: list) -> text:
    if params.length() == 0:
        return ""

    var parts = []
    var i = 0
    while i < params.length():
        val param = params[i]
        val name = param[0]
        val value = param[1]

        val encoded_value = url_encode(value)

        val part = name + "=" + encoded_value

        parts.push(part)
        i = i + 1

    return "&".join(parts)

# Encode query parameter value
fn encode_query_param(value: text) -> text:
    return url_encode(value)

# Get query parameter value by name
fn get_query_param(params: list, name: text) -> text:
    var i = 0
    while i < params.length():
        val param = params[i]
        val param_name = param[0]
        val param_value = param[1]

        if param_name == name:
            return param_value

        i = i + 1

    return nil

# ============================================================================
# URL Encoding/Decoding
# ============================================================================

# URL encode text (percent encoding)
#
# RFC 3986 §2.5: textual data is first encoded as UTF-8 octets, then every
# octet outside the unreserved set is percent-encoded. So the scan is over
# BYTES, not codepoints -- `text.length()` is a byte count while `text[i]` is
# codepoint-indexed, and mixing them mangles any non-ASCII input.
fn url_encode(text: text) -> text:
    var parts: [text] = []
    val raw = text.bytes()
    val n = raw.len()
    var i = 0

    while i < n:
        val b = (raw[i] as i64) & 0xff

        if is_unreserved_byte(b):
            parts.push(b.chr())
        else:
            parts.push("%" + url_to_hex(b))

        i = i + 1

    return parts.join("")

# Whether a raw octet is in RFC 3986 §2.3 unreserved: A-Z a-z 0-9 - _ . ~
fn is_unreserved_byte(b: i64) -> bool:
    if b >= 65 and b <= 90:
        return true
    if b >= 97 and b <= 122:
        return true
    if b >= 48 and b <= 57:
        return true
    if b == 45 or b == 95 or b == 46 or b == 126:
        return true
    false

# Percent encode a single character (all of its UTF-8 octets, RFC 3986 §2.5)
fn percent_encode_char(ch: text) -> text:
    val raw = ch.bytes()
    var result = ""
    var i = 0
    while i < raw.len():
        result = result + "%" + url_to_hex((raw[i] as i64) & 0xff)
        i = i + 1
    return result

# Convert integer to hex string (2 digits)
# goal-7 dedup: delegates to std.common.binary_inspect (canonical owner)
fn url_to_hex(n: i64) -> text:
    return percent_hex_encode_byte(n)

# URL decode text (percent decoding)
#
# Each `%XX` escape yields one OCTET, not one character: a non-ASCII character
# arrives as several escapes (`é` is `%C3%A9`). Octets are accumulated first
# and UTF-8-decoded once at the end.
fn url_decode(encoded: text) -> text:
    val raw = encoded.bytes()
    val n = raw.len()
    var out: [i64] = []
    var i = 0

    while i < n:
        val b = (raw[i] as i64) & 0xff

        if b == 37:  # '%'
            # Decode percent-encoded octet
            if i + 2 < n:
                val b1 = (raw[i + 1] as i64) & 0xff
                val b2 = (raw[i + 2] as i64) & 0xff
                val hex1 = b1.chr()
                val hex2 = b2.chr()
                if is_hex_digit(hex1) and is_hex_digit(hex2):
                    out.push(from_hex(hex1: hex1, hex2: hex2))
                else:
                    out.push(b)
                    out.push(b1)
                    out.push(b2)
                i = i + 3
            else:
                out.push(b)
                i = i + 1
        else:
            if b == 43:  # '+'
                out.push(32)
            else:
                out.push(b)
            i = i + 1

    return utf8_bytes_to_text(out)

# Check whether a character is a hex digit.
fn is_hex_digit(ch: text) -> bool:
    if ch >= "0" and ch <= "9":
        return true
    if ch >= "A" and ch <= "F":
        return true
    if ch >= "a" and ch <= "f":
        return true
    false

# Convert two hex digits to integer
# goal-7 dedup: delegates to std.common.binary_inspect (canonical owner)
fn from_hex(hex1: text, hex2: text) -> i64:
    return percent_hex_decode_pair(hex1, hex2)

# Decode a UTF-8 octet sequence into text.
# Ill-formed octets become U+FFFD REPLACEMENT CHARACTER (one per bad octet),
# matching the WHATWG "UTF-8 decode without BOM" behaviour.
fn utf8_bytes_to_text(bytes: [i64]) -> text:
    var out = ""
    val n = bytes.len()
    var i = 0

    while i < n:
        val b0 = bytes[i]
        var size = 0
        var acc = 0

        if b0 < 0x80:
            size = 1
            acc = b0
        if b0 >= 0xc2 and b0 <= 0xdf:
            size = 2
            acc = b0 & 0x1f
        if b0 >= 0xe0 and b0 <= 0xef:
            size = 3
            acc = b0 & 0x0f
        if b0 >= 0xf0 and b0 <= 0xf4:
            size = 4
            acc = b0 & 0x07

        var cp = -1
        if size == 1:
            cp = acc
        if size > 1 and i + size <= n:
            var ok = true
            var k = 1
            while k < size:
                val bk = bytes[i + k]
                if bk < 0x80 or bk > 0xbf:
                    ok = false
                    k = size
                else:
                    acc = (acc << 6) | (bk & 0x3f)
                    k = k + 1
            if ok:
                # Reject overlongs, surrogates and out-of-range scalars.
                var valid = true
                if size == 3 and acc < 0x800:
                    valid = false
                if size == 4 and acc < 0x10000:
                    valid = false
                if acc >= 0xd800 and acc <= 0xdfff:
                    valid = false
                if acc > 0x10ffff:
                    valid = false
                if valid:
                    cp = acc

        if cp >= 0:
            out = out + cp.chr()
            i = i + size
        else:
            out = out + (0xfffd).chr()
            i = i + 1

    return out

# URL encode component (encodes more characters than url_encode)
fn url_encode_component(text: text) -> text:
    # For now, same as url_encode
    return url_encode(text)
