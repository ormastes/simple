# Shim: std.gc_async_mut.torch.dyn_ffi -> std.common.torch.dyn_sffi_ops
#
# Legacy `dyn_ffi` spelling kept as a compatibility alias for the current
# `dyn_sffi` modules (the shared torch FFI layer was renamed ffi -> sffi).
# The shared implementation lives in src/lib/common/torch/dyn_sffi_ops.spl and
# src/lib/common/torch/dyn_sffi_tensor_ops.spl.
# All three torch variants (nogc_sync_mut, nogc_async_mut, gc_async_mut) delegate here.

use std.common.torch.dyn_sffi.*
use std.common.torch.dyn_sffi_ops.*
use std.common.torch.dyn_sffi_tensor_ops.*
