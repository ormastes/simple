"""
# GC Async Atomics

Compatibility facade over the canonical no-GC sync atomic backend. Atomic
runtime handles are synchronous low-level operations, so the GC async family
must not own duplicate raw SFFI declarations or a divergent RMW algorithm.
"""

export use std.nogc_sync_mut.atomic.{
    MemoryOrdering, ordering_to_i32,
    AtomicI64, AtomicUsize, AtomicBool,
    atomic_i64_new, atomic_usize_new, atomic_bool_new, fence
}
