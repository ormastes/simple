# ============================================================================

fn mqtt_create_connect_packet(client_id: text, clean_session: bool, keep_alive: i64, protocol_version: i64) -> MqttPacket:
    """Create a CONNECT packet."""
    var flags = 0
    if clean_session:
        flags = flags | CONNECT_FLAG_CLEAN_SESSION

    val headers = (protocol_version, flags, keep_alive, client_id, nil, nil, nil, nil, nil, nil, nil)
    mqtt_create_packet(PACKET_TYPE_CONNECT, 0, MqttHeaders.Connect(headers), MqttPayload.NoPayload)

fn mqtt_connect_headers_or_default(headers: MqttHeaders) -> (i64, i64, i64, text, text?, text?, i64?, bool?, text?, text?, text?):
    match headers:
        MqttHeaders.Connect(parts):
            return parts
        _:
            return (MQTT_VERSION_3_1_1, 0, 0, "", nil, nil, 0, false, nil, nil, nil)

fn mqtt_connect_set_credentials(packet: MqttPacket?, username: text?, password: text?) -> MqttPacket:
    """Set username and password in CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    val protocol_version = parts[0]
    val old_flags = parts[1]
    val keep_alive = parts[2]
    val client_id = parts[3]
    val will_topic = parts[4]
    val will_message = parts[5]
    val will_qos = parts[6]
    val will_retain = parts[7]
    val properties = parts[8]
    val will_properties = parts[9]
    val auth_method = parts[10]

    var flags = old_flags
    if username != nil:
        flags = flags | CONNECT_FLAG_USERNAME
    if password != nil:
        flags = flags | CONNECT_FLAG_PASSWORD

    val new_headers = (protocol_version, flags, keep_alive, client_id, will_topic, will_message, will_qos, will_retain, properties, will_properties, auth_method)
    mqtt_set_packet_headers(packet, MqttHeaders.Connect(new_headers))

fn mqtt_connect_set_will(packet: MqttPacket?, will_topic: text, will_message: text, will_qos: i64, will_retain: bool) -> MqttPacket:
    """Set Last Will and Testament in CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    val protocol_version = parts[0]
    val old_flags = parts[1]
    val keep_alive = parts[2]
    val client_id = parts[3]
    val properties = parts[8]
    val will_properties = parts[9]
    val auth_method = parts[10]

    var flags = old_flags | CONNECT_FLAG_WILL_FLAG

    if will_qos == 1:
        flags = flags | CONNECT_FLAG_WILL_QOS_1
    else:
        if will_qos == 2:
            flags = flags | CONNECT_FLAG_WILL_QOS_2

    if will_retain:
        flags = flags | CONNECT_FLAG_WILL_RETAIN

    val new_headers = (protocol_version, flags, keep_alive, client_id, will_topic, will_message, will_qos, will_retain, properties, will_properties, auth_method)
    mqtt_set_packet_headers(packet, MqttHeaders.Connect(new_headers))

fn mqtt_connect_get_client_id(packet: MqttPacket?) -> text:
    """Get client ID from CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    parts[3]

fn mqtt_connect_get_keep_alive(packet: MqttPacket?) -> i64:
    """Get keep alive interval from CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    parts[2]

fn mqtt_connect_get_protocol_version(packet: MqttPacket?) -> i64:
    """Get protocol version from CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    parts[0]

fn mqtt_connect_has_clean_session(packet: MqttPacket?) -> bool:
    """Check if clean session flag is set in CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    val flags = parts[1]
    (flags & CONNECT_FLAG_CLEAN_SESSION) != 0

fn mqtt_connect_has_will(packet: MqttPacket?) -> bool:
    """Check if will flag is set in CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    val flags = parts[1]
    (flags & CONNECT_FLAG_WILL_FLAG) != 0

fn mqtt_connect_get_will_qos(packet: MqttPacket?) -> i64?:
    """Get will QoS from CONNECT packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_connect_headers_or_default(headers)
    parts[6]

# ============================================================================
# CONNACK Packet Functions
# ============================================================================

export mqtt_create_connect_packet, mqtt_connect_headers_or_default, mqtt_connect_set_credentials, mqtt_connect_set_will, mqtt_connect_get_client_id, mqtt_connect_get_keep_alive, mqtt_connect_get_protocol_version, mqtt_connect_has_clean_session, mqtt_connect_has_will, mqtt_connect_get_will_qos
