# ============================================================================

fn mqtt_create_puback_packet(packet_id: i64):
    """Create a PUBACK packet."""
    val headers = (packet_id, nil)
    mqtt_create_packet(PACKET_TYPE_PUBACK, 0, MqttHeaders.PacketId(headers), MqttPayload.NoPayload)

fn mqtt_create_pubrec_packet(packet_id: i64):
    """Create a PUBREC packet."""
    val headers = (packet_id, nil)
    mqtt_create_packet(PACKET_TYPE_PUBREC, 0, MqttHeaders.PacketId(headers), MqttPayload.NoPayload)

fn mqtt_create_pubrel_packet(packet_id: i64):
    """Create a PUBREL packet."""
    val headers = (packet_id, nil)
    mqtt_create_packet(PACKET_TYPE_PUBREL, 2, MqttHeaders.PacketId(headers), MqttPayload.NoPayload)

fn mqtt_create_pubcomp_packet(packet_id: i64):
    """Create a PUBCOMP packet."""
    val headers = (packet_id, nil)
    mqtt_create_packet(PACKET_TYPE_PUBCOMP, 0, MqttHeaders.PacketId(headers), MqttPayload.NoPayload)

fn mqtt_packet_id_headers_or_default(headers: MqttHeaders) -> (i64, text?):
    match headers:
        MqttHeaders.PacketId(parts):
            return parts
        _:
            return (0, nil)

fn mqtt_pubx_get_packet_id(packet):
    """Get packet ID from PUBACK/PUBREC/PUBREL/PUBCOMP packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_packet_id_headers_or_default(headers)
    parts[0]

# ============================================================================
# SUBSCRIBE Packet Functions
# ============================================================================

fn mqtt_create_subscribe_packet(packet_id: i64, topic_filters: [(text, i64)]):
    """Create a SUBSCRIBE packet.
    topic_filters: list of (topic, qos) tuples."""
    val headers = (packet_id, nil)
    mqtt_create_packet(PACKET_TYPE_SUBSCRIBE, 2, MqttHeaders.PacketId(headers), MqttPayload.Filters(topic_filters))

fn mqtt_subscribe_get_packet_id(packet):
    """Get packet ID from SUBSCRIBE packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_packet_id_headers_or_default(headers)
    parts[0]

fn mqtt_subscribe_get_topic_filters(packet) -> [(text, i64)]:
    """Get topic filters from SUBSCRIBE packet."""
    val payload = mqtt_packet_payload(packet)
    match payload:
        MqttPayload.Filters(items):
            return items
        _:
            return []

fn mqtt_subscribe_add_topic_filter(packet, topic: text, qos: i64):
    """Add a topic filter to SUBSCRIBE packet."""
    val old_filters = mqtt_subscribe_get_topic_filters(packet)
    val new_filter = (topic, qos)
    val new_filters = old_filters + [new_filter]
    mqtt_set_packet_payload(packet, MqttPayload.Filters(new_filters))

# ============================================================================
# SUBACK Packet Functions
# ============================================================================

fn mqtt_create_suback_packet(packet_id: i64, return_codes: [i64]):
    """Create a SUBACK packet."""
    val headers = (packet_id, nil)
    mqtt_create_packet(PACKET_TYPE_SUBACK, 0, MqttHeaders.PacketId(headers), MqttPayload.Codes(return_codes))

fn mqtt_suback_get_packet_id(packet):
    """Get packet ID from SUBACK packet."""
    val headers = mqtt_packet_headers(packet)
    val parts = mqtt_packet_id_headers_or_default(headers)
    parts[0]

fn mqtt_suback_get_return_codes(packet) -> [i64]:
    """Get return codes from SUBACK packet."""
    val payload = mqtt_packet_payload(packet)
    match payload:
        MqttPayload.Codes(items):
            return items
        _:
            return []

