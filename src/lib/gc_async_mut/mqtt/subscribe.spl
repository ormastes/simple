fn mqtt_unsubscribe_get_topics(packet) -> [text]:
    """Get topics from UNSUBSCRIBE packet."""
    val payload = mqtt_packet_payload(packet)
    match payload:
        MqttPayload.Topics(items):
            return items
        _:
