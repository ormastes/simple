"""Disabled-by-default test seam for live ProcessingIR backend failures."""

use std.io_runtime.{env_get}

var _processing_ir_fault_match_count: i64 = 0
var _processing_ir_fault_target: text = ""

fn processing_ir_fault_injected(backend: text, phase: text) -> bool:
    val target = backend + ":" + phase
    if env_get("SIMPLE_GPU_TEST") != "1" or
       env_get("SIMPLE_GPU_FAULT_INJECT") != target:
        return false
    if _processing_ir_fault_target != target:
        _processing_ir_fault_target = target
        _processing_ir_fault_match_count = 0
    _processing_ir_fault_match_count = _processing_ir_fault_match_count + 1
    env_get("SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES") != "1" or
        _processing_ir_fault_match_count > 1

fn processing_ir_fault_reason(backend: text, phase: text) -> text:
    if not processing_ir_fault_injected(backend, phase):
        return ""
    if phase == "unavailable":
        return backend + "-unavailable"
    if phase == "init":
        return backend + "-init-failed"
    if phase == "submit":
        return backend + "-submit-failed"
    if phase == "readback":
        return backend + "-readback-failed"
    if phase == "mismatch":
        return "checksum-mismatch"
    if phase == "dispatch-ineligible":
        return backend + "-dispatch-ineligible"
    ""

export processing_ir_fault_injected, processing_ir_fault_reason
