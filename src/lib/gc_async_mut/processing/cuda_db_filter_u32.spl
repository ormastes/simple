"""CUDA execution for the shared data-bearing DB filter ProcessingIR."""

use std.common.processing.db_filter_u32_ir.{
    ProcessingDbFilterU32Ir,
    processing_db_filter_u32_validate,
    processing_db_filter_u32_cpu_mask,
    processing_db_filter_u32_row_ids,
    processing_db_filter_u32_mask_checksum,
    processing_db_filter_u32_mismatch_count
}
use std.gc_async_mut.cuda.{cuda_memcpy_htod, cuda_memcpy_dtoh, CUDA_SUCCESS}
use std.gc_async_mut.processing.fault_injection.{processing_ir_fault_reason}
use std.gc_async_mut.gpu_ffi.{cuda_device_identity}
use std.gc_async_mut.gpu.engine2d.cuda_session.{CudaSession}
use std.nogc_sync_mut.ptr.raw.{
    raw_alloc, raw_free, raw_write_i64, raw_write_u32s_checksum, raw_read_u32s
}
use std.nogc_sync_mut.io.time_ops.{time_now_nanos}
use std.web_db_offload.device_backend.{
    GpuWdbDeviceReceipt,
    gpu_wdb_device_receipt,
    gpu_wdb_device_receipt_unavailable
}

val PROCESSING_DB_CUDA_BLOCK_SIZE: i64 = 256
val PROCESSING_DB_CUDA_ARG_BYTES: i64 = 40

struct ProcessingDbCudaResult:
    completed: bool
    reason: text
    mask: [u32]
    row_ids: [i64]
    backend_handle: i64
    device_identity: i64
    input_stage_us: i64
    ir_prepare_us: i64
    upload_us: i64
    kernel_us: i64
    readback_us: i64
    oracle_us: i64
    total_us: i64
    device_time_us: i64
    receipt: GpuWdbDeviceReceipt

fn _processing_db_cuda_ptx() -> text:
    ".version 7.0\n.target sm_52\n.address_size 64\n\n.visible .entry processing_db_filter_u32(\n    .param .u64 input,\n    .param .u64 output,\n    .param .u32 minimum,\n    .param .u32 maximum,\n    .param .u32 count\n) {\n    .reg .pred %p<4>;\n    .reg .b32 %r<10>;\n    .reg .b64 %rd<8>;\n    mov.u32 %r0, %ctaid.x;\n    mov.u32 %r1, %ntid.x;\n    mov.u32 %r2, %tid.x;\n    mad.lo.u32 %r3, %r0, %r1, %r2;\n    ld.param.u32 %r4, [count];\n    setp.ge.u32 %p0, %r3, %r4;\n    @%p0 bra done;\n    ld.param.u64 %rd0, [input];\n    ld.param.u64 %rd1, [output];\n    mul.wide.u32 %rd2, %r3, 4;\n    add.u64 %rd3, %rd0, %rd2;\n    add.u64 %rd4, %rd1, %rd2;\n    ld.global.u32 %r5, [%rd3];\n    ld.param.u32 %r6, [minimum];\n    ld.param.u32 %r7, [maximum];\n    setp.ge.u32 %p1, %r5, %r6;\n    setp.le.u32 %p2, %r5, %r7;\n    and.pred %p3, %p1, %p2;\n    selp.u32 %r8, 1, 0, %p3;\n    st.global.u32 [%rd4], %r8;\ndone:\n    ret;\n}\n"

fn _processing_db_cuda_failure(reason: text) -> ProcessingDbCudaResult:
    ProcessingDbCudaResult(
        completed: false, reason: reason, mask: [], row_ids: [],
        backend_handle: 0, device_identity: 0,
        input_stage_us: 0, ir_prepare_us: 0,
        upload_us: 0, kernel_us: 0,
        readback_us: 0, oracle_us: 0, total_us: 0, device_time_us: 0,
        receipt: gpu_wdb_device_receipt_unavailable())

fn _processing_db_elapsed_us(started: i64, finished: i64) -> i64:
    if finished > started:
        return (finished - started + 999) / 1000
    0

fn processing_db_cuda_not_dispatched(reason: text) -> ProcessingDbCudaResult:
    _processing_db_cuda_failure(reason)

class ProcessingDbCudaExecutor:
    session: CudaSession
    closed: bool
    device_input: i64
    device_output: i64
    host_input: i64
    host_output: i64
    buffer_capacity: i64
    values_ptr: i64
    args_ptr: i64

    static fn create() -> ProcessingDbCudaExecutor:
        ProcessingDbCudaExecutor(
            session: CudaSession.create(), closed: false,
            device_input: 0, device_output: 0,
            host_input: 0, host_output: 0, buffer_capacity: 0,
            values_ptr: 0, args_ptr: 0)

    me _ensure_ready() -> text:
        if self.closed:
            return "cuda-db-executor-closed"
        if not self.session.is_valid() and self.session.init() != CUDA_SUCCESS:
            return "cuda-db-init-failed"
        if self.session.activate() != CUDA_SUCCESS:
            self.session.shutdown()
            return "cuda-db-context-activate-failed"
        if self.session.module_cache > 0:
            return ""
        if self.session.load_module(_processing_db_cuda_ptx()) <= 0:
            self.session.shutdown()
            return "cuda-db-module-load-failed"
        ""

    me _release_buffers():
        if self.device_input > 0:
            self.session.free(self.device_input)
        if self.device_output > 0:
            self.session.free(self.device_output)
        if self.host_input != 0:
            raw_free(self.host_input, self.buffer_capacity)
        if self.host_output != 0:
            raw_free(self.host_output, self.buffer_capacity)
        if self.values_ptr != 0:
            raw_free(self.values_ptr, PROCESSING_DB_CUDA_ARG_BYTES)
        if self.args_ptr != 0:
            raw_free(self.args_ptr, PROCESSING_DB_CUDA_ARG_BYTES)
        self.device_input = 0
        self.device_output = 0
        self.host_input = 0
        self.host_output = 0
        self.buffer_capacity = 0
        self.values_ptr = 0
        self.args_ptr = 0

    me _ensure_capacity(byte_count: i64) -> text:
        if self.values_ptr == 0:
            self.values_ptr = raw_alloc(PROCESSING_DB_CUDA_ARG_BYTES)
        if self.args_ptr == 0:
            self.args_ptr = raw_alloc(PROCESSING_DB_CUDA_ARG_BYTES)
        if self.values_ptr == 0 or self.args_ptr == 0:
            self._release_buffers()
            return "cuda-db-argument-allocation-failed"
        if (self.buffer_capacity >= byte_count and self.device_input > 0 and
            self.device_output > 0 and self.host_input != 0 and self.host_output != 0):
            return ""
        val next_host_input = raw_alloc(byte_count)
        val next_host_output = raw_alloc(byte_count)
        val next_device_input = self.session.alloc(byte_count)
        val next_device_output = self.session.alloc(byte_count)
        if (next_host_input == 0 or next_host_output == 0 or
            next_device_input <= 0 or next_device_output <= 0):
            if next_host_input != 0:
                raw_free(next_host_input, byte_count)
            if next_host_output != 0:
                raw_free(next_host_output, byte_count)
            if next_device_input > 0:
                self.session.free(next_device_input)
            if next_device_output > 0:
                self.session.free(next_device_output)
            return "cuda-db-buffer-allocation-failed"
        self._release_data_buffers()
        self.host_input = next_host_input
        self.host_output = next_host_output
        self.device_input = next_device_input
        self.device_output = next_device_output
        self.buffer_capacity = byte_count
        ""

    me _release_data_buffers():
        if self.device_input > 0:
            self.session.free(self.device_input)
        if self.device_output > 0:
            self.session.free(self.device_output)
        if self.host_input != 0:
            raw_free(self.host_input, self.buffer_capacity)
        if self.host_output != 0:
            raw_free(self.host_output, self.buffer_capacity)
        self.device_input = 0
        self.device_output = 0
        self.host_input = 0
        self.host_output = 0
        self.buffer_capacity = 0

    me shutdown():
        self._release_buffers()
        self.closed = true
        self.session.shutdown()

fn processing_db_filter_u32_execute_cuda_with_executor(
        executor: ProcessingDbCudaExecutor,
        ir: ProcessingDbFilterU32Ir) -> ProcessingDbCudaResult:
    val validation = processing_db_filter_u32_validate(ir)
    if not validation.valid:
        return _processing_db_cuda_failure(validation.reason)
    val unavailable_fault = processing_ir_fault_reason("cuda", "unavailable")
    if unavailable_fault != "":
        return _processing_db_cuda_failure(unavailable_fault)
    val init_fault = processing_ir_fault_reason("cuda", "init")
    if init_fault != "":
        return _processing_db_cuda_failure(init_fault)
    val ready_reason = executor._ensure_ready()
    if ready_reason != "":
        return _processing_db_cuda_failure(ready_reason)
    val count = ir.values.len().to_i64()
    val byte_count = count * 4
    val capacity_reason = executor._ensure_capacity(byte_count)
    if capacity_reason != "":
        return _processing_db_cuda_failure(capacity_reason)

    val total_started = time_now_nanos()
    val stage_started = total_started
    raw_write_u32s_checksum(executor.host_input, ir.values, count)
    val stage_finished = time_now_nanos()
    val prepare_started = stage_finished
    raw_write_i64(executor.values_ptr, 0, executor.device_input)
    raw_write_i64(executor.values_ptr, 8, executor.device_output)
    raw_write_i64(executor.values_ptr, 16, ir.minimum.to_i64())
    raw_write_i64(executor.values_ptr, 24, ir.maximum.to_i64())
    raw_write_i64(executor.values_ptr, 32, count)
    raw_write_i64(executor.args_ptr, 0, executor.values_ptr)
    raw_write_i64(executor.args_ptr, 8, executor.values_ptr + 8)
    raw_write_i64(executor.args_ptr, 16, executor.values_ptr + 16)
    raw_write_i64(executor.args_ptr, 24, executor.values_ptr + 24)
    raw_write_i64(executor.args_ptr, 32, executor.values_ptr + 32)
    val prepare_finished = time_now_nanos()

    val submit_fault = processing_ir_fault_reason("cuda", "submit")
    if submit_fault != "":
        return _processing_db_cuda_failure(submit_fault)
    val upload_started = time_now_nanos()
    val uploaded = cuda_memcpy_htod(
        executor.device_input, executor.host_input, byte_count) == CUDA_SUCCESS
    val upload_finished = time_now_nanos()
    val kernel_started = upload_finished
    val launched = uploaded and executor.session.launch_kernel_args(
        "processing_db_filter_u32",
        (count + PROCESSING_DB_CUDA_BLOCK_SIZE - 1) / PROCESSING_DB_CUDA_BLOCK_SIZE,
        1, 1, PROCESSING_DB_CUDA_BLOCK_SIZE, 1, 1,
        executor.args_ptr) == CUDA_SUCCESS
    val synced = launched and executor.session.sync() == CUDA_SUCCESS
    val kernel_finished = time_now_nanos()
    val readback_fault = processing_ir_fault_reason("cuda", "readback")
    if synced and readback_fault != "":
        return _processing_db_cuda_failure(readback_fault)
    val readback_started = kernel_finished
    val copied = synced and cuda_memcpy_dtoh(
        executor.host_output, executor.device_output, byte_count) == CUDA_SUCCESS
    val readback_finished = time_now_nanos()
    if not uploaded:
        return _processing_db_cuda_failure("cuda-db-upload-failed")
    if not launched or not synced:
        executor._release_buffers()
        executor.session.shutdown()
        return _processing_db_cuda_failure("cuda-db-dispatch-failed")
    if not copied:
        executor._release_buffers()
        executor.session.shutdown()
        return _processing_db_cuda_failure("cuda-db-readback-failed")

    val oracle_started = readback_finished
    val actual = raw_read_u32s(executor.host_output, count)
    val expected = processing_db_filter_u32_cpu_mask(ir)
    val mismatch_fault = processing_ir_fault_reason("cuda", "mismatch")
    if copied and mismatch_fault != "":
        return _processing_db_cuda_failure(mismatch_fault)
    val mismatch_count = processing_db_filter_u32_mismatch_count(expected, actual)
    val oracle_finished = time_now_nanos()
    val identity = cuda_device_identity(executor.session.device)
    val prepare_us = _processing_db_elapsed_us(prepare_started, prepare_finished)
    val input_stage_us = _processing_db_elapsed_us(stage_started, stage_finished)
    val upload_us = _processing_db_elapsed_us(upload_started, upload_finished)
    val kernel_us = _processing_db_elapsed_us(kernel_started, kernel_finished)
    val readback_us = _processing_db_elapsed_us(readback_started, readback_finished)
    val oracle_us = _processing_db_elapsed_us(oracle_started, oracle_finished)
    val total_us = _processing_db_elapsed_us(total_started, oracle_finished)
    val elapsed_us = upload_us + kernel_us + readback_us
    val expected_checksum = processing_db_filter_u32_mask_checksum(expected)
    val actual_checksum = processing_db_filter_u32_mask_checksum(actual)
    val valid = (actual.len() == expected.len() and mismatch_count == 0 and
        identity > 0 and elapsed_us > 0)
    val receipt = gpu_wdb_device_receipt(
        valid, executor.session.ctx + 1, identity, "device_readback",
        expected_checksum, actual_checksum, mismatch_count, false)
    if not valid:
        return ProcessingDbCudaResult(
            completed: false, reason: "cuda-db-oracle-mismatch", mask: [], row_ids: [],
            backend_handle: 0, device_identity: 0,
            input_stage_us: input_stage_us,
            ir_prepare_us: prepare_us, upload_us: upload_us,
            kernel_us: kernel_us, readback_us: readback_us,
            oracle_us: oracle_us, total_us: total_us,
            device_time_us: elapsed_us,
            receipt: receipt)
    ProcessingDbCudaResult(
        completed: true, reason: "ok", mask: actual,
        row_ids: processing_db_filter_u32_row_ids(ir, actual),
        backend_handle: executor.session.ctx + 1,
        device_identity: identity,
        input_stage_us: input_stage_us,
        ir_prepare_us: prepare_us, upload_us: upload_us,
        kernel_us: kernel_us, readback_us: readback_us,
        oracle_us: oracle_us, total_us: total_us,
        device_time_us: elapsed_us,
        receipt: receipt)

fn processing_db_filter_u32_execute_cuda(
        ir: ProcessingDbFilterU32Ir) -> ProcessingDbCudaResult:
    var executor = ProcessingDbCudaExecutor.create()
    val result = processing_db_filter_u32_execute_cuda_with_executor(executor, ir)
    executor.shutdown()
    result

export ProcessingDbCudaResult, ProcessingDbCudaExecutor
export processing_db_filter_u32_execute_cuda
export processing_db_filter_u32_execute_cuda_with_executor
export processing_db_cuda_not_dispatched
