# std.pure.autograd — re-export facade over the real pure-Simple autograd.
#
# WHY THIS FILE CHANGED (2026-07-25):
# This module used to be a 5-line stub exporting a single field-only
# `Variable` class. Because `src/std` is a symlink to `lib`, `std.pure.autograd`
# resolved to that stub and SHADOWED the real implementation in
# `std.gc_async_mut.pure.autograd`.
#
# This was not merely a test-visibility problem: the real
# `src/lib/gc_async_mut/pure/training.spl:11` does `use std.pure.autograd
# (Tensor)`, and the stub exported no `Tensor` at all — so the shipped training
# module was importing a name that did not exist on the module it actually
# resolved to.
#
# `Variable` is still exported, so this forwarding is source-compatible with
# every existing consumer.

export use std.gc_async_mut.pure.autograd.{Tensor, Variable, backward, OpType}
export use std.gc_async_mut.pure.autograd.{tensor_add, tensor_sub, tensor_mul, tensor_matmul}
export use std.gc_async_mut.pure.autograd.{tensor_relu, tensor_sigmoid, tensor_tanh, tensor_softmax}
export use std.gc_async_mut.pure.autograd.{tensor_sum, tensor_mean, tensor_mul_scalar, tensor_div}
export use std.gc_async_mut.pure.autograd.{tensor_exp_op, tensor_log_op, tensor_neg}
export use std.gc_async_mut.pure.autograd.{tensor_div_scalar, tensor_add_scalar}
export use std.gc_async_mut.pure.autograd.{detach, requires_grad}
export use std.gc_async_mut.pure.autograd.{tensor_from_data, tensor_from_value, tensor_zeros, tensor_ones}
