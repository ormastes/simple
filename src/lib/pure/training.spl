# std.pure.training — re-export facade over the real pure-Simple training loop.
#
# WHY THIS FILE CHANGED (2026-07-25):
# This module used to be a 36-line stub whose implementations were not merely
# thin, they were WRONG-BY-CONSTRUCTION placeholders:
#     fn mse_loss(pred: any, target: any) -> f64:  0.0
#     fn train_step(batch_x: any, batch_y: any) -> f64:  0.0
#     class SGD:  fn zero_grad(): ()   fn step(): ()      # no-op optimiser
#     class Adam: fn zero_grad(): ()   fn step(): ()      # no-op optimiser
# Because `src/std` is a symlink to `lib`, `std.pure.training` resolved to this
# stub and SHADOWED the real 650-line implementation in
# `std.gc_async_mut.pure.training`.
#
# That means `src/lib/nogc_async_mut/ml/async_training.spl:6`, which imports
# `std.pure.training.{mse_loss, SGD, Adam, TrainingHistory}`, has been training
# with an optimiser whose `step()` does nothing and a loss that always reports
# 0.0 — a silent always-succeeds training loop in shipped code. This is the
# same stub-shadowing class of defect that had `pure/test/training_spec.spl`
# parked behind "functions/imports not available".
#
# The stub surface (TrainingHistory, mse_loss, SGD, Adam, train_step) is a
# strict subset of the real module's exports, so this forwarding is
# source-compatible with every existing consumer.

export use std.gc_async_mut.pure.training.{mse_loss, mae_loss, binary_cross_entropy_loss, compute_mse}
export use std.gc_async_mut.pure.training.{cross_entropy_loss, huber_loss, smooth_l1_loss}
export use std.gc_async_mut.pure.training.{SGD, Adam, RMSprop, AdamW}
export use std.gc_async_mut.pure.training.{StepLR, ExponentialLR, CosineAnnealingLR}
export use std.gc_async_mut.pure.training.{accuracy, accuracy_from_logits}
export use std.gc_async_mut.pure.training.{TrainingHistory, Trainer}
export use std.gc_async_mut.pure.training.{LinearModel, compute_gradients}
export use std.gc_async_mut.pure.training.{no_grad_begin, no_grad_end, is_grad_enabled}
export use std.gc_async_mut.pure.training.{train_step, evaluate}
