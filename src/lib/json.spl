# Compatibility facade for the historical `std.json` root.
# Canonical declarations remain in std.common.json's physical owner modules;
# explicit re-exports keep native entry-closure discovery from depending on
# member-star exports in common/json/__init__.spl.
export use std.common.json.parser.*
export use std.common.json.serializer.*
export use std.common.json.object_ops.*
export use std.common.json.array_ops.*
export use std.common.json.types.*
