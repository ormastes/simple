# CC Layer base — Chromium-mirroring compositor input layer type.
#
# Provides: LayerId, LayerType, Layer, layer_id_new, layer_new.

use std.skia.entity.geometry.{SkRect}

class LayerId:
    value: i64

fn layer_id_new(v: i64) -> LayerId:
    LayerId(value: v)

enum LayerType:
    Content
    Picture
    SolidColor
    Scrollbar
    Root

class Layer:
    id: LayerId
    parent_id: i64
    bounds: SkRect
    layer_type: LayerType
    opacity: f64
    is_drawable: bool
    contents_opaque: bool
    transform_tree_index: i64
    clip_tree_index: i64
    effect_tree_index: i64
    scroll_tree_index: i64
    children_ids: [i64]

    fn is_root() -> bool:
        self.parent_id == -1

    me set_opacity(v: f64):
        var clamped = v
        if clamped < 0.0:
            clamped = 0.0
        elif clamped > 1.0:
            clamped = 1.0
        me.opacity = clamped

    me set_bounds(new_bounds: SkRect):
        me.bounds = new_bounds

    me add_child(child_id: i64):
        me.children_ids.push(child_id)

    me remove_child(child_id: i64) -> bool:
        var next_ids: [i64] = []
        var removed = false
        var i: i64 = 0
        while i < me.children_ids.len():
            val cid = me.children_ids[i]
            if cid == child_id and not removed:
                removed = true
            else:
                next_ids.push(cid)
            i = i + 1
        me.children_ids = next_ids
        removed

    fn child_count() -> i64:
        self.children_ids.len()

fn layer_new(id: LayerId, bounds: SkRect, layer_type: LayerType) -> Layer:
    Layer(
        id: id,
        parent_id: -1,
        bounds: bounds,
        layer_type: layer_type,
        opacity: 1.0,
        is_drawable: true,
        contents_opaque: false,
        transform_tree_index: -1,
        clip_tree_index: -1,
        effect_tree_index: -1,
        scroll_tree_index: -1,
        children_ids: []
    )

export LayerId, LayerType, Layer, layer_id_new, layer_new
