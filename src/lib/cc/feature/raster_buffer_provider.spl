# CC RasterBufferProvider — supplies raster buffers/bitmaps for tile rasterization.
#
# Provides: RasterBufferProvider.

use std.skia.capability.{SkCapability}
use std.skia.backend.cpu.raster_prims.{Bitmap}

class RasterBufferProvider:
    capability: SkCapability

    static fn new(cap: SkCapability) -> RasterBufferProvider:
        RasterBufferProvider(capability: cap)

    fn allocate_tile_bitmap(width: i64, height: i64) -> Bitmap:
        val w = if width > 0: width else: 1
        val h = if height > 0: height else: 1
        Bitmap.zeros(w, h)

export RasterBufferProvider
