# CC RasterSource — wraps an immutable SkPicture for compositor rasterization.
#
# Provides: RasterSource.

use std.skia.entity.geometry.{SkRect}
use std.skia.entity.picture.{SkPicture}

class RasterSource:
    picture: SkPicture
    cull_rect: SkRect

    static fn from_picture(pic: SkPicture) -> RasterSource:
        RasterSource(picture: pic, cull_rect: pic.cull_rect)

    fn op_count() -> i64:
        self.picture.op_count

    fn is_empty() -> bool:
        self.picture.op_count <= 0

export RasterSource
