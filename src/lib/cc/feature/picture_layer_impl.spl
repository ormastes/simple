# CC PictureLayerImpl — active/pending tree picture layer owning a RasterSource.
#
# Provides: PictureLayerImpl.

use std.cc.entity.layer.{Layer}
use std.cc.feature.raster_source.{RasterSource}

class PictureLayerImpl:
    base: Layer
    raster_source: RasterSource

    static fn from_layer(base: Layer, raster_source: RasterSource) -> PictureLayerImpl:
        PictureLayerImpl(base: base, raster_source: raster_source)

    fn is_drawable() -> bool:
        self.base.is_drawn() and not self.raster_source.is_empty()

export PictureLayerImpl
