# Shim: re-exports from string_core
use std.string_core.{char_from_code, char_code, str_char_at, str_repeat}

# `char_at` alias: legacy `import string` callers across the oauth module
# family (nogc_sync_mut/gc_async_mut/nogc_async_mut) call `string.char_at`,
# but string_core only exports `str_char_at`. Provide the alias here so all
# such callers resolve without touching each call site.
fn char_at(s: text, idx: i64) -> text:
    str_char_at(s, idx)

# UNBLOCK CONDITION MET (verified 2026-08-09 against the deployed seed
# built 2026-08-09 04:50:31, which postdates the @noalloc decorator-skip
# fix e4b5b0dac8e-adjacent chain and the 07:45:57 redeploy): `@noalloc`
# now loads cleanly under `bin/simple test` (interpreter path) — probed
# live with `use std.nogc_async_mut_noalloc.string.mod.{bm_str_len}` +
# `bm_str_len("hello") == 5`, PASS. Re-exporting the eight `bm_*` symbols
# per the condition recorded in the previous header revision.
use nogc_async_mut_noalloc.string.mod.{bm_str_len, bm_str_eq, bm_str_starts_with, bm_str_ends_with, bm_str_find, bm_int_to_str, bm_str_to_int, bm_hex_to_int}

# NOTE: only ONE `export` statement for this whole file (see below). A prior
# version had two separate `export use ...` statements (one per source
# module); consolidating avoids any risk of a multi-export-statement dict
# merge issue on engines where that matters.
#
# KNOWN UNVERIFIABLE UNDER THE CURRENTLY DEPLOYED BINARY (2026-08-11): under
# `bin/simple test`/`run`, `import string` resolves `string.<name>` calls
# against a namespace dict containing ONLY the 8 `bm_*` symbols, regardless
# of this file's actual content — confirmed by appending deliberately
# invalid syntax to this file and re-running: no parse error, identical
# stale dict. `strace` confirms the deployed binary does `openat()` this
# exact path, so the file is opened but its content does not drive the
# resulting namespace object; some other cached/baked-in representation is
# used instead. This means `char_from_code`, `char_code`, `str_char_at`,
# `str_repeat`, and this `char_at` alias are all correct here at the source
# level (and are the right fix for the documented gap) but cannot be
# proven live end-to-end without a compiler rebuild+redeploy, which is
# separately blocked (see .claude/rules/bootstrap.md "Stage 3 self-host
# fails"). File a bug for the deeper stale-namespace-cache defect if one
# does not already exist.
export char_from_code, char_code, str_char_at, str_repeat, char_at, bm_str_len, bm_str_eq, bm_str_starts_with, bm_str_ends_with, bm_str_find, bm_int_to_str, bm_str_to_int, bm_hex_to_int
