# I/O Facade
#
# Re-exports sync and async I/O under `use std.io.*`. Keep module documentation
# in line comments: native Stage4's streaming parser cannot safely retain a
# leading triple-quoted literal as a declaration-free module header yet.

# --- Shared types ---
use std.io.types.{IoErrorKind, IoError, SeekFrom, IoMode, Interest, ReadyState, IoEvent, FileMode, FileMetadata, Shutdown}

# Re-export the real sync I/O package so `use std.io.{env_get, file_read, ...}`
# resolves to the same runtime helpers as `use std.nogc_sync_mut.io.{...}`.
use std.nogc_sync_mut.io.*

# --- Sync traits ---
use std.io.traits.{Read, Write, Seek, Close}

# --- Async traits ---
@cfg(interpreter)
use std.io.async_traits.{AsyncRead, AsyncWrite, AsyncSeek, AsyncClose}

# --- Sync implementations ---
use std.nogc_sync_mut.io.file.{FileHandle, File}
use std.nogc_sync_mut.io.tcp.{TcpListener, TcpStream}
use std.nogc_sync_mut.io.udp.{UdpSocket}
use std.nogc_sync_mut.io.buffer.{BufferedReader, BufferedWriter}
use std.nogc_sync_mut.io.pipe.{Stdin, Stdout, Stderr}

# --- Async implementations ---
@cfg(interpreter)
use std.nogc_async_mut.io.file.{ThreadPool, AsyncFileHandle, AsyncFile}
@cfg(interpreter)
use std.nogc_async_mut.io.tcp.{AsyncTcpListener, AsyncTcpStream}
@cfg(interpreter)
use std.nogc_async_mut.io.udp.{AsyncUdpSocket}
@cfg(interpreter)
use std.nogc_async_mut.io.buffer.{AsyncBufferedReader, AsyncBufferedWriter}
@cfg(interpreter)
use std.nogc_async_mut.io.event_loop.{Waker, EventLoop}

# ============================================================================
# Exports
# ============================================================================

export use std.nogc_sync_mut.io.{
    file_exists, file_read, file_write, file_copy, file_delete, file_atomic_write,
    file_append, file_modified_time, file_remove, file_hash_sha256, file_read_lines,
    file_read_text, file_read_bytes, file_write_bytes, file_mmap_read_text, file_mmap_read_bytes,
    file_read_text_at, file_write_text_at, file_fsync, file_fsync_cached,
    time_now_unix_micros, current_time_unix, current_time_ms, time_now_nanos, time_now_micros,
    file_lock, file_read_text,
    cwd, home, env_get, env_set, env_vars,
    dir_create, dir_create_all, dir_walk, dir_walk_native, dir_remove_all, is_dir,
    dir_list, dir_remove,
    host_arch, host_os,
    getpid, hostname, cpu_count, path_basename,
    process_kill, process_run, process_run_timeout, process_spawn_async,
    process_wait, process_is_running, process_run_with_limits,
    shell, shell_output, shell_int, shell_lines, shell_bool, shell_output_trimmed, ProcessResult,
    file_unlock, file_size_raw,
    thread_sleep_ms,
    timestamp_year, timestamp_month, timestamp_day,
    timestamp_hour, timestamp_minute, timestamp_second,
    rt_timestamp_now, rt_debug_set_active,
    time_now_nanos
}
export use std.nogc_sync_mut.io.file.{FileHandle, File}
@cfg(interpreter)
export use std.nogc_async_mut.io.file.{ThreadPool, AsyncFileHandle, AsyncFile}
export use std.nogc_sync_mut.io.pipe.{Stdin, Stdout, Stderr}
