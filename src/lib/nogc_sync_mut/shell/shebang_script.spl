# Shebang parsing and MSYS argument quoting, shared by the sync-tier process
# spawners (std.nogc_sync_mut.io.process_ops) and the async-tier shim
# (std.nogc_async_mut.env.shebang). Text only: no process or file access.

fn _shebang_basename(path: text) -> text:
    val normalized = path.replace("\\", "/")
    val parts = normalized.split("/")
    parts[parts.len() - 1]

pub fn shebang_interpreter_argv(first_line: text) -> [text]:
    """Parse a `#!` line into the argv prefix that runs the script.

    Returns an empty list when the line carries no shebang. The interpreter is
    reduced to its basename so a POSIX absolute path such as `/bin/sh` resolves
    through PATH on a Windows host, and a `/usr/bin/env NAME` form collapses to
    `NAME` because `env` is not a Windows image either.

    Example:
        shebang_interpreter_argv("#!/bin/sh")              # ["sh"]
        shebang_interpreter_argv("#!/usr/bin/env python3") # ["python3"]
        shebang_interpreter_argv("plain text")             # []
    """
    if not first_line.starts_with("#!"):
        return []
    val body = first_line.replace("\t", " ").replace("\r", "").trim()
    var tokens: [text] = []
    for token in body.split(" "):
        if token != "" and token != "#!":
            tokens = tokens + [token]
    if tokens.len() == 0:
        return []
    var first = tokens[0]
    if first.starts_with("#!"):
        first = first.replace("#!", "")
    if first == "":
        return []
    var argv: [text] = [_shebang_basename(first)]
    var index = 1
    if argv[0] == "env" and tokens.len() > 1:
        argv = [_shebang_basename(tokens[1])]
        index = 2
    while index < tokens.len():
        argv = argv + [tokens[index]]
        index = index + 1
    argv

pub fn shebang_is_posix_shell(interpreter: text) -> bool:
    interpreter == "sh" or interpreter == "bash" or interpreter == "dash"

val MSYS_SAFE_CHARS: text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_./:=,@+%"

# True when MS-CRT quoting and the MSYS argv parser both leave `word` unchanged.
pub fn shebang_msys_safe_word(word: text) -> bool:
    if word == "":
        return false
    var index = 0
    while index < word.len():
        if not MSYS_SAFE_CHARS.contains(word[index]):
            return false
        index = index + 1
    true

fn _shebang_posix_quoted(word: text) -> text:
    "'" + word.replace("'", "'\\''") + "'"

# The host builds the Windows command line with MS-CRT quoting (`c"d` becomes
# `c\"d`, quoted only when it holds a space), but a Windows sh is MSYS/Cygwin,
# whose own argv parser ends the argument differently, drops backslashes inside
# quotes and globs unquoted words. A `-c` script always holds a space, so it
# crosses that boundary as one quoted word; POSIX single quotes then carry each
# real argument literally.
pub fn shebang_exec_script(interpreter: text, argv: [text]) -> text:
    var script = "exec " + _shebang_posix_quoted(interpreter)
    for arg in argv:
        script = script + " " + _shebang_posix_quoted(arg)
    shebang_msys_quoted_word(script)

# Same boundary as shebang_exec_script, for a child whose pid the caller owns:
# on MSYS `exec` starts a new Windows process and leaves the spawned one as a
# stub, so closing the tracked pid would orphan the script. Sourcing keeps the
# script in the spawned process.
pub fn shebang_source_script(script_path: text, argv: [text]) -> text:
    var script = "set --"
    for arg in argv:
        script = script + " " + _shebang_posix_quoted(arg)
    shebang_msys_quoted_word(script + "; . " + _shebang_posix_quoted(script_path))

# Inside a quoted word MSYS reads `\\` as one backslash and drops a lone one.
# A backslash run directly before `"` is already doubled by MS-CRT quoting.
pub fn shebang_msys_quoted_word(word: text) -> text:
    var out = ""
    var index = 0
    while index < word.len():
        var run_end = index
        while run_end < word.len() and word[run_end] == "\\":
            run_end = run_end + 1
        if run_end == index:
            out = out + word[index]
            index = index + 1
        else:
            var run = word.substring(index, run_end)
            if run_end == word.len() or word[run_end] != "\"":
                run = run + run
            out = out + run
            index = run_end
    out

export shebang_interpreter_argv, shebang_is_posix_shell, shebang_msys_safe_word
export shebang_exec_script, shebang_source_script, shebang_msys_quoted_word
