# Shell Dir Module - Directory operations namespace
#
# Provides a `dir` namespace object with common directory operations.
# Backed by io_runtime extern fn wrappers.
#
# Usage (via mod.spl):
#   use std.shell.{dir}
#   dir.exist(path)              -> bool
#   dir.create(path)             -> bool
#   dir.create_recursive(path)   -> bool
#   dir.remove(path)             -> bool
#   dir.remove_recursive(path)   -> bool
#   dir.list(path)               -> [text]

extern fn rt_dir_create(path: text, recursive: bool) -> bool
use std.io_runtime.{dir_create_all}
extern fn rt_dir_remove(path: text, recursive: bool) -> bool
extern fn rt_dir_remove_all(path: text) -> bool
use std.io_runtime.{dir_list}
use std.io_runtime.{dir_exists}

fn exist(path: text) -> bool:
    # Direct rt-backed check (`rt_dir_exists`). The previous implementation
    # shelled out to `/bin/sh -c "test -d ..."`, which cannot work on Windows
    # (CreateProcess has no /bin/sh) and paid a process spawn per call on
    # Unix. NOTE: io_runtime's `is_dir` still shells out too — use
    # `dir_exists`, which is the no-shell primitive.
    dir_exists(path)

fn create(path: text) -> bool:
    rt_dir_create(path, false)

fn create_recursive(path: text) -> bool:
    dir_create_all(path)

fn remove(path: text) -> bool:
    rt_dir_remove(path, false)

fn remove_recursive(path: text) -> bool:
    rt_dir_remove(path, true)

fn list(path: text) -> [text]:
    dir_list(path)
