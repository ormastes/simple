# Shell Environment Module
#
# Simple facade module for environment variable operations.
# Provides SFFI access to environment variables and working directory.
#
# Used by: test/01_unit/std/env_spec.spl
#
# Functions:
#   get(key) -> text           Get environment variable
#   set(key, value) -> bool    Set environment variable
#   cwd() -> text              Get current working directory

# SFFI declarations for runtime functions
use std.io_runtime.{env_get}
use std.io_runtime.{env_set}
use std.io_runtime.{process_run}
use std.io_runtime.{cwd_process}

# Get environment variable value
# Returns empty string if not set
fn get(key: text) -> text:
    val result = env_get(key)
    if result == nil:
        ""
    else:
        result

# Set environment variable
# Returns true on success, false on failure
fn set(key: text, value: text) -> bool:
    env_set(key, value)

# Lazy-initialized current working directory cache
# Prevents SFFI hang during module initialization
var _cwd_cache: text? = nil

# Get current working directory
# Uses shell command 'pwd' to get the path
# Cached to avoid repeated SFFI calls
fn cwd() -> text:
    # Return cached value if available
    if val cached = _cwd_cache:
        return cached

    # NO-SHELL (2026-09-02): was `process_run("/bin/sh", ["-c", "pwd"])`, which
    # needs a shell that does not exist on a bare Windows host. rt_env_cwd is
    # the native primitive and cannot fail to a wrong-but-plausible ".".
    val result = cwd_process()

    # Cache for future calls
    _cwd_cache = Some(result)
    result

