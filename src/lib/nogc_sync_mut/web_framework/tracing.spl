"""
# W3C Trace Context (Simplified)

Distributed tracing support implementing a simplified W3C Trace Context
specification. Provides trace/span ID generation, context propagation
via the `traceparent` header, and OTLP-compatible span export.

## Usage

```simple
# Create a fresh trace
val ctx = TraceContext.new()

# Parse from incoming header
val ctx = TraceContext.from_traceparent("00-abc...def-1234...5678-01")

# Create child span
val child = ctx.child_span()

# Record a span
var span = TraceSpan.new(child, "handle_request")
span.set_attribute("http.method", "GET")
span.set_status("ok")
span.end()

# Export spans
var exporter = TraceExporter.new(1000)
exporter.add_span(span)
val json = exporter.export_json()

# Export spans as OTLP/JSON (resourceSpans -> scopeSpans -> spans)
exporter.set_service_name("my-service")
val otlp_json = exporter.export_otlp_json()
```
"""

use std.http_server.types.{HttpRequestData}
use std.log.{LogContextSnapshot, log_context_set, log_context_snapshot, log_context_restore}

extern fn rt_random_i64() -> i64
use std.io_runtime.{time_now_unix_micros}

fn _trace_time_now_ms() -> i64:
    time_now_unix_micros() / 1000

# ============================================================================
# Hex Conversion Helpers
# ============================================================================

fn i64_to_hex_padded(n: i64, width: i64) -> text:
    """Convert an i64 to a zero-padded hex string of the given width."""
    val hex_chars = "0123456789abcdef"
    var result = ""
    var remaining = n
    var i = 0
    while i < width:
        val nibble = remaining & 0xF
        result = hex_chars[nibble:nibble + 1] + result
        remaining = remaining >> 4
        i = i + 1
    result

fn hex_char_to_i64(c: text) -> i64:
    """Convert a single hex character to its integer value, or -1."""
    if c == "0": return 0
    if c == "1": return 1
    if c == "2": return 2
    if c == "3": return 3
    if c == "4": return 4
    if c == "5": return 5
    if c == "6": return 6
    if c == "7": return 7
    if c == "8": return 8
    if c == "9": return 9
    if c == "a": return 10
    if c == "b": return 11
    if c == "c": return 12
    if c == "d": return 13
    if c == "e": return 14
    if c == "f": return 15
    if c == "A": return 10
    if c == "B": return 11
    if c == "C": return 12
    if c == "D": return 13
    if c == "E": return 14
    if c == "F": return 15
    -1

fn hex_to_i64(s: text) -> i64:
    """Parse a hex string into an i64. Returns 0 on invalid input."""
    var result: i64 = 0
    var i = 0
    while i < s.len():
        val digit = hex_char_to_i64(s[i:i + 1])
        if digit < 0:
            return 0
        result = (result << 4) + digit
        i = i + 1
    result

# ============================================================================
# TraceId — 128-bit trace identifier as two i64s
# ============================================================================

struct TraceId:
    """128-bit trace identifier stored as two 64-bit halves."""
    high: i64
    low: i64

fn trace_id_generate() -> TraceId:
    """Generate a random TraceId."""
    TraceId(high: rt_random_i64(), low: rt_random_i64())

fn trace_id_to_hex(tid: TraceId) -> text:
    """Serialize to a 32-character lowercase hex string."""
    i64_to_hex_padded(tid.high, 16) + i64_to_hex_padded(tid.low, 16)

fn trace_id_from_hex(s: text) -> TraceId?:
    """Parse a 32-character hex string into a TraceId."""
    if s.len() != 32:
        return nil
    var i = 0
    while i < 32:
        if hex_char_to_i64(s[i:i + 1]) < 0:
            return nil
        i = i + 1
    val high = hex_to_i64(s[0:16])
    val low = hex_to_i64(s[16:32])
    Some(TraceId(high: high, low: low))

# ============================================================================
# SpanId — 64-bit span identifier
# ============================================================================

struct SpanId:
    """64-bit span identifier."""
    value: i64

fn span_id_generate() -> SpanId:
    """Generate a random SpanId."""
    SpanId(value: rt_random_i64())

fn span_id_to_hex(sid: SpanId) -> text:
    """Serialize to a 16-character lowercase hex string."""
    i64_to_hex_padded(sid.value, 16)

# ============================================================================
# TraceContext — W3C traceparent propagation
# ============================================================================

class TraceContext:
    """W3C Trace Context carrying trace_id, span_id, parent, and sampled flag."""
    trace_id: TraceId
    span_id: SpanId
    parent_span_id: SpanId?
    sampled: bool

    static fn new() -> TraceContext:
        """Create a fresh trace context with no parent."""
        TraceContext(
            trace_id: trace_id_generate(),
            span_id: span_id_generate(),
            parent_span_id: nil,
            sampled: true
        )

    static fn from_traceparent(header: text) -> TraceContext?:
        """Parse a W3C traceparent header value.

        Format: `00-{32hex_trace_id}-{16hex_span_id}-{2hex_flags}`

        Args:
            header: The raw traceparent header value

        Returns:
            Parsed TraceContext or nil if invalid
        """
        val parts = header.split("-")
        if parts.len() != 4:
            return nil

        val version = parts[0]
        val trace_hex = parts[1]
        val parent_hex = parts[2]
        val flags_hex = parts[3]

        if version != "00":
            return nil
        if trace_hex.len() != 32:
            return nil
        if parent_hex.len() != 16:
            return nil
        if flags_hex.len() != 2:
            return nil

        val tid_opt = trace_id_from_hex(trace_hex)
        if tid_opt == nil:
            return nil
        val tid = tid_opt ?? TraceId(high: 0, low: 0)

        val parent_sid = SpanId(value: hex_to_i64(parent_hex))
        val flags_val = hex_to_i64(flags_hex)
        val is_sampled = (flags_val & 1) == 1

        Some(TraceContext(
            trace_id: tid,
            span_id: span_id_generate(),
            parent_span_id: Some(parent_sid),
            sampled: is_sampled
        ))

    fn to_traceparent() -> text:
        """Serialize to a W3C traceparent header value.

        Returns:
            String in format `00-{trace_id}-{span_id}-{flags}`
        """
        val tid_hex = trace_id_to_hex(self.trace_id)
        val sid_hex = span_id_to_hex(self.span_id)
        val flags = if self.sampled: "01" else: "00"
        "00-{tid_hex}-{sid_hex}-{flags}"

    fn child_span() -> TraceContext:
        """Create a child context: same trace_id, new span_id, current becomes parent."""
        TraceContext(
            trace_id: self.trace_id,
            span_id: span_id_generate(),
            parent_span_id: Some(self.span_id),
            sampled: self.sampled
        )

# ============================================================================
# ObserveContext — shared correlation ids for log/tracing/scheduler
# ============================================================================
#
# ObserveContext wraps a W3C TraceContext with optional scheduler
# correlation ids so that std.log call sites, the tracing middleware, and
# (eventually) the actor/task scheduler can all stamp the same trace/span
# ids onto their output. Only the tracing side populates it today: wiring
# std.log record emission and the scheduler's task/actor spawn paths to
# carry an ObserveContext is a follow-up lane, not part of this exporter
# change. task_id/actor_id are plain i64 (not the async-tier ActorId/task
# handle types) because this module lives below the async tier and must
# not import it.

struct ObserveContext:
    """Correlation ids shared across log/tracing/scheduler subsystems."""
    trace_ctx: TraceContext
    task_id: i64?
    actor_id: i64?

fn observe_context_new(ctx: TraceContext) -> ObserveContext:
    """Wrap a TraceContext with no scheduler correlation ids attached."""
    ObserveContext(trace_ctx: ctx, task_id: nil, actor_id: nil)

fn observe_context_with_task(ctx: ObserveContext, task_id: i64) -> ObserveContext:
    """Return a copy of ctx with task_id attached."""
    ObserveContext(trace_ctx: ctx.trace_ctx, task_id: Some(task_id), actor_id: ctx.actor_id)

fn observe_context_with_actor(ctx: ObserveContext, actor_id: i64) -> ObserveContext:
    """Return a copy of ctx with actor_id attached."""
    ObserveContext(trace_ctx: ctx.trace_ctx, task_id: ctx.task_id, actor_id: Some(actor_id))

# ----------------------------------------------------------------------
# std.log wiring (Lane OBS1, follow-up to the OTLP exporter above) — stamp
# an ObserveContext's ids onto std.log's current-context so log records
# (SyslogRecord) carry the same trace/task/actor correlation ids the
# tracing/OTLP side already has. Absent task_id/actor_id become 0 (per
# std.log's absent/zero convention); ids stay plain i64 the whole way down.
# ----------------------------------------------------------------------

fn observe_context_activate(ctx: ObserveContext) -> LogContextSnapshot:
    """Snapshot std.log's current context, then activate ctx's ids onto it.

    Returns the pre-activation snapshot — the caller MUST pass it to
    observe_context_deactivate() (or log_context_restore() directly) when
    the scope ends. This is what makes nested set/restore safe: activating
    a new context inside an already-active one restores the outer context
    afterward instead of clearing it.
    """
    val snap = log_context_snapshot()
    val task = ctx.task_id ?? 0
    val actor = ctx.actor_id ?? 0
    log_context_set(ctx.trace_ctx.trace_id.high, ctx.trace_ctx.trace_id.low, task, actor)
    snap

fn observe_context_deactivate(snap: LogContextSnapshot):
    """Restore std.log's context to a snapshot from observe_context_activate()."""
    log_context_restore(snap)

# ============================================================================
# TraceSpan — timed operation within a trace
# ============================================================================

class TraceSpan:
    """A single timed operation within a trace, OTLP-compatible."""
    context: TraceContext
    name: text
    start_time: i64
    end_time: i64
    attributes: [(text, text)]
    status: text
    kind: text

    static fn new(ctx: TraceContext, name: text) -> TraceSpan:
        """Create a new span starting now."""
        TraceSpan(
            context: ctx,
            name: name,
            start_time: _trace_time_now_ms(),
            end_time: 0,
            attributes: [],
            status: "unset",
            kind: "internal"
        )

    me set_attribute(key: text, value: text):
        """Add or overwrite a key-value attribute."""
        self.attributes = self.attributes + [(key, value)]

    me set_status(status: text):
        """Set span status (unset, ok, error)."""
        self.status = status

    me set_kind(kind: text):
        """Set OTLP span kind (internal, server, client, producer, consumer)."""
        self.kind = kind

    me end():
        """Mark the span as finished with the current timestamp."""
        self.end_time = _trace_time_now_ms()

    fn duration_ms() -> i64:
        """Duration in milliseconds, or 0 if not ended."""
        if self.end_time == 0:
            return 0
        self.end_time - self.start_time

    fn to_json() -> text:
        """Serialize to OTLP-compatible JSON."""
        val tid = trace_id_to_hex(self.context.trace_id)
        val sid = span_id_to_hex(self.context.span_id)

        var parent_str = ""
        val psid = self.context.parent_span_id
        if psid != nil:
            val p = psid ?? SpanId(value: 0)
            parent_str = span_id_to_hex(p)

        var attrs_parts: [text] = []
        for attr in self.attributes:
            val k = attr.0
            val v = attr.1
            attrs_parts = attrs_parts + ["{\"key\":\"{k}\",\"value\":{\"stringValue\":\"{v}\"}}"]

        val attrs_json = "[" + join_texts(attrs_parts, ",") + "]"
        val dur = self.duration_ms()

        var json = "{"
        json = json + "\"traceId\":\"{tid}\""
        json = json + ",\"spanId\":\"{sid}\""
        if parent_str.len() > 0:
            json = json + ",\"parentSpanId\":\"{parent_str}\""
        json = json + ",\"name\":\"{self.name}\""
        json = json + ",\"startTimeUnixMs\":{self.start_time}"
        json = json + ",\"endTimeUnixMs\":{self.end_time}"
        json = json + ",\"durationMs\":{dur}"
        json = json + ",\"status\":\"{self.status}\""
        json = json + ",\"attributes\":{attrs_json}"
        json = json + "}"
        json

    fn to_otlp_span_json() -> text:
        """Serialize to a single OTLP JSON span object (nanosecond timestamps)."""
        val tid = trace_id_to_hex(self.context.trace_id)
        val sid = span_id_to_hex(self.context.span_id)

        var parent_str = ""
        val psid = self.context.parent_span_id
        if psid != nil:
            val p = psid ?? SpanId(value: 0)
            parent_str = span_id_to_hex(p)

        var attrs_parts: [text] = []
        for attr in self.attributes:
            val k = attr.0
            val v = attr.1
            attrs_parts = attrs_parts + ["{\"key\":\"{k}\",\"value\":{\"stringValue\":\"{v}\"}}"]

        val attrs_json = "[" + join_texts(attrs_parts, ",") + "]"
        val kind_int = span_kind_to_otlp_int(self.kind)
        val status_int = span_status_to_otlp_int(self.status)
        # OTLP JSON encodes fixed64 fields (uint64 nanosecond timestamps) as
        # quoted decimal strings, not numbers.
        val start_ns = self.start_time * 1000000
        val end_ns = self.end_time * 1000000

        var json = "{"
        json = json + "\"traceId\":\"{tid}\""
        json = json + ",\"spanId\":\"{sid}\""
        if parent_str.len() > 0:
            json = json + ",\"parentSpanId\":\"{parent_str}\""
        json = json + ",\"name\":\"{self.name}\""
        json = json + ",\"kind\":{kind_int}"
        json = json + ",\"startTimeUnixNano\":\"{start_ns}\""
        json = json + ",\"endTimeUnixNano\":\"{end_ns}\""
        json = json + ",\"attributes\":{attrs_json}"
        json = json + ",\"status\":{"
        json = json + "\"code\":{status_int}"
        json = json + "}"
        json = json + "}"
        json

# ============================================================================
# OTLP Enum Mapping Helpers
# ============================================================================

fn span_kind_to_otlp_int(kind: text) -> i64:
    """Map a span kind name to its OTLP SpanKind enum integer."""
    if kind == "internal": return 1
    if kind == "server": return 2
    if kind == "client": return 3
    if kind == "producer": return 4
    if kind == "consumer": return 5
    0

fn span_status_to_otlp_int(status: text) -> i64:
    """Map a span status name to its OTLP Status.code enum integer."""
    if status == "ok": return 1
    if status == "error": return 2
    0

# ============================================================================
# TraceExporter — buffers and exports spans
# ============================================================================

class TraceExporter:
    """Collects spans and exports them as a JSON array or as OTLP/JSON."""
    spans: [TraceSpan]
    max_buffer: i64
    service_name: text

    static fn new(max_buffer: i64) -> TraceExporter:
        TraceExporter(spans: [], max_buffer: max_buffer, service_name: "simple-app")

    me set_service_name(name: text):
        """Set the OTLP resource `service.name` attribute value."""
        self.service_name = name

    me add_span(span: TraceSpan):
        """Buffer a completed span. Drops oldest if over max_buffer."""
        if self.spans.len() >= self.max_buffer:
            self.spans = self.spans[1:]
        self.spans = self.spans + [span]

    fn export_json() -> text:
        """Export all buffered spans as a JSON array."""
        var parts: [text] = []
        for span in self.spans:
            parts = parts + [span.to_json()]
        "[" + join_texts(parts, ",") + "]"

    fn export_otlp_json() -> text:
        """Export all buffered spans as an OTLP/JSON `resourceSpans` document.

        Shape: resourceSpans[].{resource, scopeSpans[].{scope, spans[]}} —
        suitable for writing to a file that an external OTLP/HTTP collector
        can ingest. No network I/O happens here; wire transport is a
        follow-up lane.
        """
        var span_parts: [text] = []
        for span in self.spans:
            span_parts = span_parts + [span.to_otlp_span_json()]
        val spans_json = "[" + join_texts(span_parts, ",") + "]"

        val svc = self.service_name
        # Each fragment below carries at most one literal `{`/`}` (or a
        # single isolated `{var}` interpolation) — never two brace-pairs in
        # one string literal, since nested `{...}` inside a string is
        # parsed as interpolation and would try to evaluate the JSON
        # content between them as a Simple expression.
        var doc = "{"
        doc = doc + "\"resourceSpans\":["
        doc = doc + "{"
        doc = doc + "\"resource\":"
        doc = doc + "{"
        doc = doc + "\"attributes\":["
        doc = doc + "{"
        doc = doc + "\"key\":\"service.name\""
        doc = doc + ",\"value\":"
        doc = doc + "{"
        doc = doc + "\"stringValue\":\"{svc}\""
        doc = doc + "}"
        doc = doc + "}"
        doc = doc + "]"
        doc = doc + "}"
        doc = doc + ",\"scopeSpans\":["
        doc = doc + "{"
        doc = doc + "\"scope\":"
        doc = doc + "{"
        doc = doc + "\"name\":\"simple.web_framework.tracing\""
        doc = doc + "}"
        doc = doc + ",\"spans\":{spans_json}"
        doc = doc + "}"
        doc = doc + "]"
        doc = doc + "}"
        doc = doc + "]"
        doc = doc + "}"
        doc

    me flush():
        """Clear all buffered spans."""
        self.spans = []

# ============================================================================
# Tracing Middleware
# ============================================================================

fn tracing_middleware(ctx: TraceContext, request: HttpRequestData) -> (TraceContext, HttpRequestData):
    """Extract or propagate trace context from an HTTP request.

    If the request carries a `traceparent` header, parses it to create
    a child span context. Otherwise creates a child from the provided ctx.

    Args:
        ctx: Fallback trace context (used when no traceparent header present)
        request: Incoming HTTP request

    Returns:
        Tuple of (active TraceContext, original request)
    """
    for header in request.headers:
        if header.0.lower() == "traceparent":
            val parsed = TraceContext.from_traceparent(header.1)
            if parsed != nil:
                val trace_ctx = parsed ?? ctx.child_span()
                return (trace_ctx, request)

    (ctx.child_span(), request)

# ============================================================================
# Text Helpers
# ============================================================================

fn join_texts(parts: [text], sep: text) -> text:
    """Join a list of text values with a separator."""
    var result = ""
    var i = 0
    for part in parts:
        if i > 0:
            result = result + sep
        result = result + part
        i = i + 1
    result
