"""
# Enterprise Warehouse — bin topology, putaway, FEFO/FIFO picking, pack

Warehouse vertical of the Simple Enterprise Suite over the durable enterprise
store, following the FROZEN foundation contracts (`enterprise_sale/foundation.spl`
and `enterprise_sale/rbac_registry.spl` are never edited). This module owns
BIN-LEVEL topology only — where stock physically sits and how it moves between
bins. Aggregate on-hand quantities belong to `enterprise_inventory` and
inter-site movement to `enterprise_transfer`; neither is imported or edited here,
so the lane is standalone.

## Storage model (insert-only + pure fold)

Three insert-only tables, no UPDATE anywhere:

- `wh_bins (tenant_id, bin_code, zone, capacity, set_by)` — a re-register of the
  same `bin_code` appends a row and the LATEST row wins (same insert-only
  re-rate idiom as `enterprise_tax`). A bin is UNKNOWN until registered.
- `wh_putaway (tenant_id, bin_code, sku, qty, lot, expiry_day, put_by)` — one row
  per putaway. Occupancy of a bin is the pure SUM of its putaway rows minus the
  rows already picked out of it.
- `wh_picked (tenant_id, bin_code, sku, qty, lot, order_id)` — one row per
  confirmed pack line, so occupancy is `sum(putaway) - sum(picked)` by a pure
  fold over both tables. Nothing is mutated in place.

## Capacity rule

`capacity` is an integer unit count. Putaway of `qty` into `bin` is accepted only
when `used(bin) + qty <= capacity(bin)`; otherwise it is denied. Capacity is
checked against the CURRENT occupancy fold, so a pick frees capacity for a later
putaway.

Denial reasons come ONLY from the frozen closed set in `foundation.reason_set()`
— that list is byte-fenced by a conformance spec and adding a reason needs an
ADR, so this module does NOT invent `unknown-bin`/`bin-full`. It maps the two
warehouse-specific conditions onto existing members: an unregistered bin denies
**`not-found`** (the bin genuinely does not exist for that tenant) and an
over-capacity putaway denies **`conflict`** (the write conflicts with the bin's
current occupancy). The `detail` string carries the bin/sku/qty so the specific
condition is still machine-readable downstream.

## Expiry unit

`expiry_day` is an integer day number (e.g. `20260817` as yyyymmdd, or any
monotone day index) — an integer keeps ordering total and float-free. A lot with
no expiry uses `0`, which sorts FIRST under FEFO; callers that want no-expiry
stock picked LAST should pass a large sentinel instead.

## Pick ordering — FEFO with FIFO tie-break (deterministic, total)

`wh_pick_list` orders the candidate putaway rows by `(expiry_day, id)` ascending:
First-Expired-First-Out, and among rows sharing an expiry the lowest row id —
i.e. the earliest putaway — wins, which is FIFO. Because `id` is unique the
ordering is TOTAL: two runs over the same store always produce byte-identical
pick lines. The sort is an explicit stable selection over the folded rows, not a
library sort, so the ordering rule is readable at the call site.

## Short picks

`wh_pick_list` allocates greedily in FEFO order until the requested quantity is
met. When available stock is less than requested it returns everything it can
and reports `short_qty > 0` with `complete: false` — a short pick is a normal
outcome, never an error, and the caller decides whether to pack it.

## Pack confirmation

`wh_pack_confirm` is the guarded write that turns a pick plan line into a
`wh_picked` row, decrementing bin occupancy. It runs the frozen sequence
session -> rbac -> validation -> idempotency -> effects in one UoW and refuses to
pack more than the bin currently holds (`insufficient-stock`).

## RBAC (reuse, not a new grant)

All three commands REUSE the existing `ops` role via the LOCAL `wh_role_allows`
gate. The frozen `role_allows` table is NOT edited and `rbac_registry.spl` is
deliberately NOT touched (its equivalence spec is byte-fenced to the frozen
table). Audit hashing goes only through `records.audit_append` (the
`enterprise_store.audit_hash.audit_sha256_hex` facade) — this module never
imports `std.common.crypto.sha256`.

Lane: .spipe/simple_enterprise_suite (W23-FAN, warehouse).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema — three insert-only tables
# =============================================================================

fn warehouse_setup(store: EnterpriseStore) -> bool:
    store_migrate(store, "wh_001_bins",
        "CREATE TABLE IF NOT EXISTS wh_bins (id INTEGER PRIMARY KEY, tenant_id TEXT, bin_code TEXT, zone TEXT, capacity TEXT, set_by TEXT)")
    store_migrate(store, "wh_002_putaway",
        "CREATE TABLE IF NOT EXISTS wh_putaway (id INTEGER PRIMARY KEY, tenant_id TEXT, bin_code TEXT, sku TEXT, qty TEXT, lot TEXT, expiry_day TEXT, put_by TEXT)")
    store_migrate(store, "wh_003_picked",
        "CREATE TABLE IF NOT EXISTS wh_picked (id INTEGER PRIMARY KEY, tenant_id TEXT, bin_code TEXT, sku TEXT, qty TEXT, lot TEXT, order_id TEXT)")

# =============================================================================
# RBAC — reuse the ops role (see module docstring)
# =============================================================================

# wh_role_allows gates warehouse commands. admin passes for everything (matching
# the frozen blanket rule); the ops role is REUSED for warehouse actions.
fn wh_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "ops":
        return action == "warehouse.bin.register" or action == "warehouse.putaway" or action == "warehouse.pack"
    false

# =============================================================================
# Pure folds — bin topology and occupancy
# =============================================================================

# wh_bin_capacity folds the insert-only bin rows and returns the LATEST capacity
# (by insert order) for (tenant, bin_code), or -1 when the bin is UNKNOWN.
fn wh_bin_capacity(store: EnterpriseStore, tenant_id: text, bin_code: text) -> i64:
    var cap: i64 = -1
    val rows = store_rows(store, "wh_bins", "id, tenant_id, bin_code, zone, capacity, set_by")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "bin_code") == bin_code:
            cap = int(sqlite_row_get(row, "capacity"))
    cap

# wh_bin_known reports whether a bin has ever been registered for the tenant.
fn wh_bin_known(store: EnterpriseStore, tenant_id: text, bin_code: text) -> bool:
    wh_bin_capacity(store, tenant_id, bin_code) >= 0

# wh_bin_used folds putaway MINUS picked for (tenant, bin) — the current
# occupancy in units. A pick frees capacity for a later putaway.
fn wh_bin_used(store: EnterpriseStore, tenant_id: text, bin_code: text) -> i64:
    var used: i64 = 0
    val puts = store_rows(store, "wh_putaway", "id, tenant_id, bin_code, sku, qty, lot, expiry_day, put_by")
    for row in puts:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "bin_code") == bin_code:
            used = used + int(sqlite_row_get(row, "qty"))
    val picks = store_rows(store, "wh_picked", "id, tenant_id, bin_code, sku, qty, lot, order_id")
    for row in picks:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "bin_code") == bin_code:
            used = used - int(sqlite_row_get(row, "qty"))
    used

# wh_bin_free is the remaining capacity of a bin: -1 for an unknown bin.
fn wh_bin_free(store: EnterpriseStore, tenant_id: text, bin_code: text) -> i64:
    val cap = wh_bin_capacity(store, tenant_id, bin_code)
    if cap < 0:
        return -1
    cap - wh_bin_used(store, tenant_id, bin_code)

# =============================================================================
# Pick planning — FEFO with FIFO tie-break
# =============================================================================

# One available lot sitting in one bin, as folded from the putaway/picked rows.
struct WhLot:
    row_id: i64
    bin_code: text
    sku: text
    lot: text
    expiry_day: i64
    qty: i64

# One line of a pick plan: take `qty` of `lot` from `bin_code`.
struct WhPickLine:
    bin_code: text
    sku: text
    lot: text
    expiry_day: i64
    qty: i64

# A pick plan. `complete` is false exactly when `short_qty > 0`.
struct WhPickPlan:
    sku: text
    requested_qty: i64
    picked_qty: i64
    short_qty: i64
    complete: bool
    lines: [WhPickLine]

# wh_available_lots folds the per-(bin, lot) available quantity for one sku:
# putaway qty minus already-picked qty, dropping anything at or below zero.
fn wh_available_lots(store: EnterpriseStore, tenant_id: text, sku: text) -> [WhLot]:
    var lots: [WhLot] = []
    val puts = store_rows(store, "wh_putaway", "id, tenant_id, bin_code, sku, qty, lot, expiry_day, put_by")
    for row in puts:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sku") == sku:
            lots.push(WhLot(
                row_id: int(sqlite_row_get(row, "id")),
                bin_code: sqlite_row_get(row, "bin_code"),
                sku: sku,
                lot: sqlite_row_get(row, "lot"),
                expiry_day: int(sqlite_row_get(row, "expiry_day")),
                qty: int(sqlite_row_get(row, "qty"))))
    # subtract already-picked quantity from the matching (bin, lot)
    val picks = store_rows(store, "wh_picked", "id, tenant_id, bin_code, sku, qty, lot, order_id")
    for row in picks:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sku") == sku:
            val pbin = sqlite_row_get(row, "bin_code")
            val plot = sqlite_row_get(row, "lot")
            var remaining: i64 = int(sqlite_row_get(row, "qty"))
            var i: i64 = 0
            while i < lots.len():
                if remaining > 0 and lots[i].bin_code == pbin and lots[i].lot == plot and lots[i].qty > 0:
                    var take: i64 = lots[i].qty
                    if remaining < take:
                        take = remaining
                    lots[i] = WhLot(row_id: lots[i].row_id, bin_code: lots[i].bin_code, sku: lots[i].sku,
                        lot: lots[i].lot, expiry_day: lots[i].expiry_day, qty: lots[i].qty - take)
                    remaining = remaining - take
                i = i + 1
    var live: [WhLot] = []
    for lot in lots:
        if lot.qty > 0:
            live.push(lot)
    live

# wh_sort_fefo orders lots by (expiry_day, row_id) ascending — FEFO, FIFO on a
# tie. Explicit selection sort so the ordering rule is readable; row_id is
# unique so the order is TOTAL and therefore reproducible.
fn wh_sort_fefo(lots: [WhLot]) -> [WhLot]:
    var pool: [WhLot] = []
    for lot in lots:
        pool.push(lot)
    var out: [WhLot] = []
    while pool.len() > 0:
        var best: i64 = 0
        var i: i64 = 1
        while i < pool.len():
            # NOTE: the candidate/incumbent fields are bound to locals before
            # being compared. Writing the comparison inline as
            # `pool[i].expiry_day < pool[best].expiry_day` makes the parser read
            # `< pool[...] >` as a generic argument list and emit a spurious
            # "Deprecated syntax for type parameters" warning (the code still
            # evaluates correctly). Filed as a grammar defect rather than
            # silently normalised — see doc/07_guide/app/enterprise/warehouse.md.
            val cand_expiry = pool[i].expiry_day
            val cand_id = pool[i].row_id
            val best_expiry = pool[best].expiry_day
            val best_id = pool[best].row_id
            val earlier = cand_expiry < best_expiry
            val same_expiry_older = cand_expiry == best_expiry and cand_id < best_id
            if earlier or same_expiry_older:
                best = i
            i = i + 1
        out.push(pool[best])
        var rest: [WhLot] = []
        var j: i64 = 0
        while j < pool.len():
            if j != best:
                rest.push(pool[j])
            j = j + 1
        pool = rest
    out

# wh_pick_list plans a pick of `qty` units of `sku` for the session's tenant in
# FEFO order. A pure read gated by session validity. When stock is insufficient
# it returns every line it could allocate plus a positive `short_qty` — a short
# pick is a normal outcome, not an error.
fn wh_pick_list(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, sku: text, qty: i64) -> WhPickPlan:
    if not session_valid(session, tenant, who) or qty <= 0:
        return WhPickPlan(sku: sku, requested_qty: qty, picked_qty: 0, short_qty: qty, complete: false, lines: [])
    val ordered = wh_sort_fefo(wh_available_lots(store, session.tenant_id, sku))
    var lines: [WhPickLine] = []
    var remaining: i64 = qty
    for lot in ordered:
        if remaining > 0:
            var take: i64 = lot.qty
            if remaining < take:
                take = remaining
            lines.push(WhPickLine(bin_code: lot.bin_code, sku: sku, lot: lot.lot, expiry_day: lot.expiry_day, qty: take))
            remaining = remaining - take
    val picked = qty - remaining
    WhPickPlan(sku: sku, requested_qty: qty, picked_qty: picked, short_qty: remaining, complete: remaining == 0, lines: lines)

# =============================================================================
# Guarded commands (frozen sequence)
# =============================================================================

# wh_bin_register records a bin with its unit capacity. Insert-only: registering
# the same code again appends a row and the latest capacity wins.
fn wh_bin_register(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, bin_code: text, zone: text, capacity: i64) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", bin_code)
    # 2. rbac (reuse ops/admin)
    if not wh_role_allows(who.role, "warehouse.bin.register"):
        return denied("forbidden", bin_code)
    # 3. domain validation — non-empty code/zone, positive capacity
    if bin_code == "" or zone == "" or capacity <= 0:
        return denied("invalid-record", bin_code)
    # 4. idempotency
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects — one unit of work
    val detail = bin_code + "@" + zone + ":{capacity}"
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO wh_bins (tenant_id, bin_code, zone, capacity, set_by) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, bin_code, zone, "{capacity}", who.actor_id]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "warehouse.bin.register", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "warehouse.bin.register", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

# wh_putaway places `qty` of a lot into a bin. Denies `unknown-bin` for a bin
# that was never registered and `bin-full` when the putaway would exceed the
# bin's capacity against its CURRENT occupancy.
fn wh_putaway(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, bin_code: text, sku: text, lot: text, expiry_day: i64, qty: i64) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", bin_code)
    # 2. rbac
    if not wh_role_allows(who.role, "warehouse.putaway"):
        return denied("forbidden", bin_code)
    # 3. domain validation
    if bin_code == "" or sku == "" or qty <= 0 or expiry_day < 0:
        return denied("invalid-record", bin_code)
    val detail = bin_code + "/" + sku + "/" + lot + ":{qty}"
    # 3b. state-dependent validation — the bin must exist and must have room.
    val cap = wh_bin_capacity(store, session.tenant_id, bin_code)
    if cap < 0:
        return denied("not-found", detail)
    if wh_bin_used(store, session.tenant_id, bin_code) + qty > cap:
        return denied("conflict", detail)
    # 4. idempotency
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO wh_putaway (tenant_id, bin_code, sku, qty, lot, expiry_day, put_by) VALUES (?, ?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, bin_code, sku, "{qty}", lot, "{expiry_day}", who.actor_id]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "warehouse.putaway", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "warehouse.putaway", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

# wh_pack_confirm consumes `qty` of a lot out of a bin for an order, recording a
# `wh_picked` row that decrements the bin's occupancy. Refuses to pack more than
# the bin currently holds for that sku (`insufficient-stock`).
fn wh_pack_confirm(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, order_id: text, bin_code: text, sku: text, lot: text, qty: i64) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", order_id)
    # 2. rbac
    if not wh_role_allows(who.role, "warehouse.pack"):
        return denied("forbidden", order_id)
    # 3. domain validation
    if order_id == "" or bin_code == "" or sku == "" or qty <= 0:
        return denied("invalid-record", order_id)
    val detail = order_id + "/" + bin_code + "/" + sku + "/" + lot + ":{qty}"
    # 3b. state-dependent validation
    if not wh_bin_known(store, session.tenant_id, bin_code):
        return denied("not-found", detail)
    var available: i64 = 0
    for l in wh_available_lots(store, session.tenant_id, sku):
        if l.bin_code == bin_code and l.lot == lot:
            available = available + l.qty
    if available < qty:
        return denied("insufficient-stock", detail)
    # 4. idempotency
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO wh_picked (tenant_id, bin_code, sku, qty, lot, order_id) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, bin_code, sku, "{qty}", lot, order_id]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "warehouse.pack", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "warehouse.pack", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

export warehouse_setup
export wh_role_allows
export wh_bin_capacity, wh_bin_known, wh_bin_used, wh_bin_free
export WhLot, WhPickLine, WhPickPlan
export wh_available_lots, wh_sort_fefo, wh_pick_list
export wh_bin_register, wh_putaway, wh_pack_confirm
