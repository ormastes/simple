# FTS BM25 Scoring — integer-approximated BM25 ranking.
#
# Uses fixed-point arithmetic (score * 1000) to avoid f64 issues.
# Exports: FtsSearchResult, fts_bm25_score, fts_bm25_search

use std.io_runtime
use std.db.dbfs_engine.fts.tokenizer.{fts_tokenize, FtsToken}
use std.db.dbfs_engine.fts.inverted_index.{FtsInvertedIndex, FtsPosting}
use std.common.search.ranking.{bm25_score_default}

# ── Search result ──────────────────────────────────────────────────────────────

struct FtsSearchResult:
    doc_id: i64
    score: i64

struct FtsBm25Explanation:
    score_contract: text
    term_frequency: i64
    document_frequency: i64
    document_length: i64
    average_document_length_fixed: i64
    document_count: i64
    score_milli: i64

fn fts_bm25_score_fixed(tf: i64, df: i64, doc_len: i64,
                        avg_dl_fixed: i64, total_docs: i64) -> i64:
    if tf <= 0 or df <= 0 or avg_dl_fixed <= 0 or total_docs <= 0:
        return 0
    val score = bm25_score_default([tf], [df], doc_len,
                                   avg_dl_fixed, total_docs)
    score.raw_value()

fn fts_bm25_explain(tf: i64, df: i64, doc_len: i64,
                    avg_dl_fixed: i64, total_docs: i64) -> FtsBm25Explanation:
    FtsBm25Explanation(
        score_contract: "bm25-fixed-v1",
        term_frequency: tf,
        document_frequency: df,
        document_length: doc_len,
        average_document_length_fixed: avg_dl_fixed,
        document_count: total_docs,
        score_milli: fts_bm25_score_fixed(tf, df, doc_len,
                                         avg_dl_fixed, total_docs)
    )

# ── BM25 score (integer approximation) ────────────────────────────────────────
#
# k1 = 1.2  -> k1_scaled = 1200 (scaled by 1000)
# b  = 0.75 -> b_scaled  = 750  (scaled by 1000)
#
# IDF = (N - df + 1) * 1000 / (df + 1)     -- simplified ratio
# TF_component = tf * (k1_scaled + 1000)
#              / (tf * 1000 + k1_scaled * (1000 - b_scaled + b_scaled * doc_len / avg_dl))
# score = idf * tf_component / 1000

fn fts_bm25_score(tf: i64, df: i64, doc_len: i64, avg_dl: i64, total_docs: i64) -> i64:
    if tf <= 0 or df <= 0 or avg_dl <= 0 or total_docs <= 0:
        return 0
    fts_bm25_score_fixed(tf, df, doc_len, avg_dl * 1000000, total_docs)

fn _fts_bm25_score_fixed(tf: i64, df: i64, doc_len: i64,
                         avg_dl_fixed: i64, total_docs: i64) -> i64:
    fts_bm25_score_fixed(tf, df, doc_len, avg_dl_fixed, total_docs)

# ── BM25 multi-term search ────────────────────────────────────────────────────

fn fts_bm25_search(index: FtsInvertedIndex, query: text) -> [FtsSearchResult]:
    val tokens = fts_tokenize(query)
    val total_docs = index.doc_count()
    val avg_dl_fixed = index.avg_doc_length_fixed()

    # Accumulate scores per doc_id
    var scores: Dict<text, i64> = {}

    var ti: i32 = 0
    while ti < tokens.len() as i32:
        val term = tokens[ti].term
        val postings = index.search(term)
        val df = index.doc_freq(term)
        var pi: i32 = 0
        while pi < postings.len() as i32:
            val posting = postings[pi]
            val p_doc_id = posting.doc_id
            val doc_key = "{p_doc_id}"
            val doc_len = index.doc_length(p_doc_id)
            val sc = _fts_bm25_score_fixed(posting.term_freq, df, doc_len,
                                           avg_dl_fixed, total_docs)
            if scores.contains_key(doc_key):
                scores[doc_key] = scores[doc_key] + sc
            else:
                scores[doc_key] = sc
            pi = pi + 1
        ti = ti + 1

    # Collect results
    var results: [FtsSearchResult] = []
    val score_keys = scores.keys()
    var ski: i32 = 0
    while ski < score_keys.len() as i32:
        val doc_key = score_keys[ski]
        results.push(FtsSearchResult(doc_id: _parse_i64(doc_key), score: scores[doc_key]))
        ski = ski + 1

    # Sort by score descending (insertion sort)
    var si: i64 = 1
    while si < results.len():
        val key_result = results[si as i32]
        var sj: i64 = si - 1
        while (sj >= 0 and
               (results[sj as i32].score < key_result.score or
                (results[sj as i32].score == key_result.score and
                 key_result.doc_id < results[sj as i32].doc_id))):
            results[(sj + 1) as i32] = results[sj as i32]
            sj = sj - 1
        results[(sj + 1) as i32] = key_result
        si = si + 1

    results

# ── Helper: parse i64 from text ────────────────────────────────────────────────

fn _parse_i64(s: text) -> i64:
    var result: i64 = 0
    var neg = false
    var idx: i32 = 0
    if s.len() > 0 and s.char_at(0) == "-":
        neg = true
        idx = 1
    while idx < s.len() as i32:
        val ch = s.char_at(idx)
        if ch == "0":
            result = result * 10
        elif ch == "1":
            result = result * 10 + 1
        elif ch == "2":
            result = result * 10 + 2
        elif ch == "3":
            result = result * 10 + 3
        elif ch == "4":
            result = result * 10 + 4
        elif ch == "5":
            result = result * 10 + 5
        elif ch == "6":
            result = result * 10 + 6
        elif ch == "7":
            result = result * 10 + 7
        elif ch == "8":
            result = result * 10 + 8
        elif ch == "9":
            result = result * 10 + 9
        idx = idx + 1
    if neg:
        result = 0 - result
    result
