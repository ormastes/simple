# DbFsDriver — DBFS filesystem driver for the VFS mount table.
#
# In-memory implementation backed by module-level inode/fd stores keyed by
# instance_id. This works around the interpreter value-semantics limitation
# (field mutations on struct copies are lost when dispatching through MountTable).
#
# Maps to: AC-1, AC-2, AC-6, AC-9, D1.

use nogc_sync_mut.db.dbfs_driver.namespace_io.*
use nogc_sync_mut.db.dbfs_driver.streaming_ingest.*
use std.fs_driver.error.{FsError}
use std.fs_driver.types.{FileHandle, DirHandle, Path, OpenFlags, DirEntry, StatInfo}
use std.fs_driver.capability.{Capability, FsCapabilitySet}
use std.fs_driver.extension.{Extension, PosixCompatExt, DirectIoExt}
use std.fs_driver.direct_io.{DirectIoExtent}
use std.db.dbfs_engine.wal.{DbfsWal, WalRecord, WAL_RECORD_DATA}
# Construct through the canonical struct, matching dbfs_engine/checkpoint.spl,
# which already calls SharedCheckpointRing.* directly. `DbfsWal` is a
# `type DbfsWal = SharedWal` back-compat alias for external callers, and a
# static call on an alias does not resolve (see bug
# type_alias_static_dispatch_unresolved_2026-08-04.md).
use std.storage.shared.wal.{SharedWal}
use std.db.dbfs_engine.txn.{DbfsTxn, TxnId}
use std.db.dbfs_engine.raw_nvme_arena.{RawNvmeArena}
use std.fs_driver.block_device.{BlockDevice}
use nogc_sync_mut.db.dbfs_driver.device_commit_owner.{
    DbfsNamespaceEntry,
    dbfs_text_to_bytes, dbfs_bytes_to_text, dbfs_slice_bytes,
    dbfs_device_serialization_blocker, dbfs_device_serialization_ready,
    dbfs_device_append_unbound,
    dbfs_owner_transaction_begin, dbfs_owner_transaction_end,
    dbfs_device_register_locked, dbfs_device_unregister_locked,
    dbfs_device_data_capacity_locked, dbfs_device_blob_binding_locked,
    dbfs_device_mount_seal_epoch_locked,
    dbfs_device_durable_root_snapshot_locked,
    dbfs_device_restore_blob_locked, dbfs_device_commit_blob_locked,
    dbfs_device_append_unbound_locked, dbfs_device_read_bytes_locked,
    dbfs_device_recover_locked, dbfs_device_persist_namespace_locked,
    dbfs_device_flush_locked
}
use std.storage.storage_class.{StorageClass}
use std.storage.nvme_feature_policy.{samsung_mzql2960hcjr_sysfs_facts, nvme_policy_for_class}

extern fn rt_text_to_bytes(s: text) -> [u8]
extern fn rt_string_len(value: text) -> i64

# --- Internal inode kinds ---

enum DbFsKind:
    File
    Dir

# --- Internal inode (stored in module-level table) ---

struct DbFsInode:
    inst_id:  i64
    id:       u64
    kind:     DbFsKind
    name:     text
    content:  text
    content_bytes: [u8]
    parent:   u64
    size:     i64
    unlinked: bool

# --- Open file descriptor entry (stored in module-level table) ---

struct DbFsFd:
    inst_id:    i64
    handle_id:  u64
    inode_id:   u64
    is_dir:     bool
    closed:     bool

# --- Canonical namespace state ---
# Keyed by inst_id so multiple driver instances are isolated. These arrays are
# private state of device_commit_owner's transaction domain; helpers carrying
# `_locked` may only run after dbfs_owner_transaction_begin().

var _dbfs_inodes: [DbFsInode] = []
var _dbfs_fds:    [DbFsFd] = []
var _dbfs_next_inst: i64 = 1
# --- DbFsDriver struct ---

struct DbFsDriver:
    """DBFS filesystem driver.

    name             — driver identifier returned by driver_name().
    inst_id          — unique instance ID (keys into _dbfs_inodes / _dbfs_fds).
    next_id          — next inode id to assign (module-level ops use this as seed).
    next_fd          — next handle id to assign.
    wal              — write-ahead log for group-commit.
    flush_count      — number of group_commit() / WAL flush calls.
    arena_base       — base_block of the backing RawNvmeArena, or -1 for in-memory.
    arena_block_count — block_count of the backing RawNvmeArena (0 if not device-backed).
    io_unit_bytes    — preferred physical write unit.
    batch_bytes      — preferred batch size for WAL/data writes.
    trim_supported   — backing namespace supports discard/deallocate.
    write_zeroes_supported — backing namespace supports write-zeroes.
    direct_io        — present only for a SimpleOS NVMe lease-backed mount.
    """
    name:             text
    inst_id:          i64
    next_id:          u64
    next_fd:          u64
    wal:              DbfsWal
    flush_count:      i64
    arena_base:       i64
    arena_block_count: i64
    io_unit_bytes:    i64
    batch_bytes:      i64
    trim_supported:   bool
    write_zeroes_supported: bool
    direct_io:        Option<DirectIoExt>

# --- Module-level store helpers ---

fn _find_inode_idx(inst_id: i64, path: text) -> i32:
    """Return index in _dbfs_inodes for (inst_id, path), or -1."""
    var i: i32 = 0
    while i < _dbfs_inodes.len() as i32:
        val n = _dbfs_inodes[i]
        if n.inst_id == inst_id and n.name == path and not n.unlinked:
            return i
        i = i + 1
    -1

fn _find_fd_idx(inst_id: i64, handle_id: u64) -> i32:
    """Return index in _dbfs_fds for (inst_id, handle_id), or -1."""
    var i: i32 = 0
    while i < _dbfs_fds.len() as i32:
        val f = _dbfs_fds[i]
        if f.inst_id == inst_id and f.handle_id == handle_id:
            return i
        i = i + 1
    -1

fn _fd_inode_idx(inst_id: i64, handle_id: u64) -> i32:
    """Return inode index for an open (non-closed) fd, or -1."""
    val fd_idx = _find_fd_idx(inst_id, handle_id)
    if fd_idx < 0:
        return -1
    val fd = _dbfs_fds[fd_idx]
    if fd.closed:
        return -1
    var j: i32 = 0
    while j < _dbfs_inodes.len() as i32:
        if _dbfs_inodes[j].inst_id == inst_id and _dbfs_inodes[j].id == fd.inode_id:
            return j
        j = j + 1
    -1

fn _alloc_inst_id() -> i64:
    """Allocate a fresh instance id and advance the counter."""
    val id = _dbfs_next_inst
    _dbfs_next_inst = _dbfs_next_inst + 1
    id

fn _alloc_inode_id(inst_id: i64) -> u64:
    """Return max inode id for this instance + 1 (for new allocation)."""
    var max_id: u64 = 1
    for n in _dbfs_inodes:
        if n.inst_id == inst_id and n.id >= max_id:
            max_id = n.id + 1
    max_id

fn _alloc_fd_id(inst_id: i64) -> u64:
    """Return max fd id for this instance + 1 (for new allocation)."""
    var max_id: u64 = 1
    for f in _dbfs_fds:
        if f.inst_id == inst_id and f.handle_id >= max_id:
            max_id = f.handle_id + 1
    max_id

fn _dbfs_namespace_entries_locked(inst_id: i64) -> Result<[DbfsNamespaceEntry], FsError>:
    var entries: [DbfsNamespaceEntry] = []
    for inode in _dbfs_inodes:
        if inode.inst_id == inst_id and not inode.unlinked and inode.id != 1u64:
            val is_dir = match inode.kind:
                case Dir: true
                case File: false
            val binding = dbfs_device_blob_binding_locked(inst_id, inode.id)
            val blob_offset = if is_dir: 0 else: binding.offset
            val blob_length = if is_dir: 0 else: binding.length
            val blob_checksum = if is_dir: 1 else: binding.checksum
            if not is_dir and (not binding.exists or blob_offset < 0 or blob_length < 0 or blob_checksum < 0):
                return Err(FsError.Corrupt)
            entries.push(DbfsNamespaceEntry(
                inode_id: inode.id,
                is_dir: is_dir,
                size: inode.size,
                blob_offset: blob_offset,
                blob_length: blob_length,
                blob_checksum: blob_checksum,
                path: inode.name
            ))
    Ok(entries)

fn _dbfs_register_device_instance(inst_id: i64):
    if _dbfs_device_next_idx(inst_id) >= 0:
        return
    _dbfs_device_next_inst_ids.push(inst_id)
    _dbfs_device_next_offsets.push(0)

fn _dbfs_device_blob_idx(inst_id: i64, inode_id: u64) -> i32:
    var i: i32 = 0
    while i < _dbfs_device_blob_inst_ids.len() as i32:
        if _dbfs_device_blob_inst_ids[i] == inst_id and _dbfs_device_blob_inode_ids[i] == inode_id:
            return i
        i = i + 1
    -1

fn _dbfs_record_device_blob(inst_id: i64, inode_id: u64, offset: i64, length: i64):
    val idx = _dbfs_device_blob_idx(inst_id, inode_id)
    if idx >= 0:
        _dbfs_device_blob_offsets[idx] = offset
        _dbfs_device_blob_lengths[idx] = length
        return
    _dbfs_device_blob_inst_ids.push(inst_id)
    _dbfs_device_blob_inode_ids.push(inode_id)
    _dbfs_device_blob_offsets.push(offset)
    _dbfs_device_blob_lengths.push(length)

fn _dbfs_device_store_idx(inst_id: i64) -> i32:
    var i: i32 = 0
    while i < _dbfs_device_store_inst_ids.len() as i32:
        if _dbfs_device_store_inst_ids[i] == inst_id:
            return i
        i = i + 1
    -1

fn _dbfs_register_device_store(inst_id: i64, dev: BlockDevice):
    val idx = _dbfs_device_store_idx(inst_id)
    if idx >= 0:
        _dbfs_device_store_devices[idx] = dev
        return
    _dbfs_device_store_inst_ids.push(inst_id)
    _dbfs_device_store_devices.push(dev)

fn _dbfs_set_device_next_offset(inst_id: i64, offset: i64):
    val idx = _dbfs_device_next_idx(inst_id)
    if idx >= 0:
        _dbfs_device_next_offsets[idx] = offset

fn _dbfs_namespace_lba(base_block: i64, block_count: i64) -> u64:
    (base_block + block_count - 1) as u64

fn _dbfs_sector_size(inst_id: i64) -> i64:
    val idx = _dbfs_device_store_idx(inst_id)
    if idx < 0:
        return 512
    _dbfs_device_store_devices[idx].sector_size() as i64

fn _dbfs_zero_sector(size: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < size:
        out.push(0)
        i = i + 1
    out

fn _dbfs_pad_sector(bytes: [u8], size: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < size and i < bytes.len():
        out.push(bytes[i])
        i = i + 1
    while i < size:
        out.push(0)
        i = i + 1
    out

fn _dbfs_write_device_bytes(inst_id: i64, base_block: i64, block_count: i64, offset: i64, data: [u8]) -> Result<i64, FsError>:
    val dev_idx = _dbfs_device_store_idx(inst_id)
    if dev_idx < 0:
        return Err(FsError.Unsupported)
    if offset < 0:
        return Err(FsError.InvalidArg)
    val sector_size = _dbfs_sector_size(inst_id)
    val max_data_bytes = (block_count - 2) * sector_size
    val data_len: i64 = data.len() as i64
    if offset + data_len > max_data_bytes:
        return Err(FsError.TooLarge)

    var written: i64 = 0
    while written < data_len:
        val absolute = offset + written
        val sector_idx = absolute / sector_size
        val intra = absolute - sector_idx * sector_size
        val lba = (base_block + 1 + sector_idx) as u64
        val read = _dbfs_device_store_devices[dev_idx].read_sector(lba)
        var sector: [u8] = match read:
            Ok(bytes): bytes
            Err(_): _dbfs_zero_sector(sector_size)
        if sector.len() == 0:
            sector = _dbfs_zero_sector(sector_size)
        var pos = intra
        while pos < sector_size and written < data_len:
            sector[pos] = data[written]
            pos = pos + 1
            written = written + 1
        val ok = _dbfs_device_store_devices[dev_idx].write_sector(lba, _dbfs_pad_sector(sector, sector_size))
        if ok.is_err():
            return Err(FsError.IoError(code: 0))
    Ok(written)

fn _dbfs_read_device_bytes(inst_id: i64, base_block: i64, offset: i64, length: i64) -> Result<[u8], FsError>:
    val dev_idx = _dbfs_device_store_idx(inst_id)
    if dev_idx < 0:
        return Err(FsError.Unsupported)
    if offset < 0 or length < 0:
        return Err(FsError.InvalidArg)
    val sector_size = _dbfs_sector_size(inst_id)
    var out: [u8] = []
    var read_count: i64 = 0
    while read_count < length:
        val absolute = offset + read_count
        val sector_idx = absolute / sector_size
        val intra = absolute - sector_idx * sector_size
        val lba = (base_block + 1 + sector_idx) as u64
        val read = _dbfs_device_store_devices[dev_idx].read_sector(lba)
        if read.is_err():
            return Err(FsError.IoError(code: 0))
        val sector: [u8] = match read:
            Ok(bytes): bytes
            Err(_): return Err(FsError.IoError(code: 0))
        var pos = intra
        while pos < sector_size and read_count < length and pos < sector.len():
            out.push(sector[pos])
            pos = pos + 1
            read_count = read_count + 1
    Ok(out)

fn _dbfs_persist_namespace(inst_id: i64, base_block: i64, block_count: i64) -> Result<(), FsError>:
    val dev_idx = _dbfs_device_store_idx(inst_id)
    if dev_idx < 0:
        return Ok(())
    val sector_size = _dbfs_sector_size(inst_id)
    var content = "DBFSNS1\n"
    for inode in _dbfs_inodes:
        if inode.inst_id == inst_id and not inode.unlinked and inode.id != 1:
            val blob_idx = _dbfs_device_blob_idx(inst_id, inode.id)
            val blob_offset = if blob_idx >= 0: _dbfs_device_blob_offsets[blob_idx] else: 0
            val blob_len = if blob_idx >= 0: _dbfs_device_blob_lengths[blob_idx] else: 0
            val kind = match inode.kind:
                case Dir: "D"
                case File: "F"
            content = content + kind + "|" + inode.id.to_text() + "|" + inode.size.to_text() + "|" + blob_offset.to_text() + "|" + blob_len.to_text() + "|" + inode.name + "\n"
    val bytes = _dbfs_text_to_bytes(content)
    if bytes.len() as i64 > sector_size:
        return Err(FsError.TooLarge)
    val sector = _dbfs_pad_sector(bytes, sector_size)
    val write = _dbfs_device_store_devices[dev_idx].write_sector(_dbfs_namespace_lba(base_block, block_count), sector)
    if write.is_err():
        return Err(FsError.IoError(code: 0))
    Ok(())

fn _dbfs_replay_namespace_locked(inst_id: i64, base_block: i64, block_count: i64) -> Result<u64, FsError>:
    val recovered = dbfs_device_recover_locked(inst_id, base_block, block_count)
    if recovered.is_err():
        return Err(recovered.unwrap_err())
    val snapshot = recovered.unwrap()
    for entry in snapshot.entries:
        _dbfs_inodes.push(DbFsInode(
            inst_id: inst_id,
            id: entry.inode_id,
            kind: if entry.is_dir: DbFsKind.Dir else: DbFsKind.File,
            name: entry.path,
            content: "",
            content_bytes: [],
            parent: 1u64,
            size: entry.size,
            unlinked: false
        ))
    Ok(snapshot.next_inode)

fn _dbfs_finish_driver_result(result: Result<DbFsDriver, FsError>) -> Result<DbFsDriver, FsError>:
    if dbfs_owner_transaction_end(): return result
    Err(FsError.IoError(code: 0u32))

fn _dbfs_finish_result<T>(result: Result<T, FsError>) -> Result<T, FsError>:
    if dbfs_owner_transaction_end(): return result
    Err(FsError.IoError(code: 0u32))

impl DbFsDriver:
    pub fn device_instance_id() -> i64: self.inst_id

    pub fn device_backing_close_preflight(expected_inst_id: i64) -> Result<bool, FsError>:
        """Prove exact device teardown is currently non-busy without mutation."""
        if expected_inst_id <= 0 or self.inst_id != expected_inst_id or self.arena_base < 0:
            return Err(FsError.StaleHandle)
        if not dbfs_owner_transaction_begin(): return Err(FsError.Transient(code: 0u32))
        if dbfs_device_mount_seal_epoch_locked(
                expected_inst_id, self.arena_block_count).is_err():
            return _dbfs_finish_result(Err(FsError.StaleHandle))
        var fd_index: i32 = 0
        while fd_index < _dbfs_fds.len() as i32:
            if _dbfs_fds[fd_index].inst_id == expected_inst_id and not _dbfs_fds[fd_index].closed:
                return _dbfs_finish_result(Err(FsError.Busy))
            fd_index = fd_index + 1
        if dbfs_stream_ingest_active_locked(expected_inst_id):
            return _dbfs_finish_result(Err(FsError.Busy))
        _dbfs_finish_result(Ok(true))

    pub fn close_device_backing(expected_inst_id: i64) -> Result<bool, FsError>:
        """Close one exact device-backed instance; true only on first release.

        The canonical DBFS transaction owns the busy check, unregister, cache
        reclamation, and bounded replay receipt. A copied or field-mutated
        driver cannot redirect cleanup to another instance.
        """
        if expected_inst_id <= 0 or self.inst_id != expected_inst_id or self.arena_base < 0:
            return Err(FsError.StaleHandle)
        if not dbfs_owner_transaction_begin(): return Err(FsError.Transient(code: 0u32))
        var terminal_index: i32 = 0
        while terminal_index < _dbfs_closed_device_ids.len() as i32:
            if _dbfs_closed_device_ids[terminal_index] == expected_inst_id:
                return _dbfs_finish_result(Ok(false))
            terminal_index = terminal_index + 1
        if dbfs_device_mount_seal_epoch_locked(
                expected_inst_id, self.arena_block_count).is_err():
            return _dbfs_finish_result(Err(FsError.StaleHandle))
        var fd_index: i32 = 0
        while fd_index < _dbfs_fds.len() as i32:
            if _dbfs_fds[fd_index].inst_id == expected_inst_id and not _dbfs_fds[fd_index].closed:
                return _dbfs_finish_result(Err(FsError.Busy))
            fd_index = fd_index + 1
        if dbfs_stream_ingest_active_locked(expected_inst_id):
            return _dbfs_finish_result(Err(FsError.Busy))
        val unregistered = dbfs_device_unregister_locked(expected_inst_id)
        if unregistered.is_err() or not unregistered.unwrap():
            return _dbfs_finish_result(Err(
                if unregistered.is_err(): unregistered.unwrap_err() else: FsError.IoError(code: 0u32)))
        var inode_index = _dbfs_inodes.len() as i32 - 1
        while inode_index >= 0:
            if _dbfs_inodes[inode_index].inst_id == expected_inst_id:
                _dbfs_inodes.remove(inode_index)
            inode_index = inode_index - 1
        var closed_fd_index = _dbfs_fds.len() as i32 - 1
        while closed_fd_index >= 0:
            if _dbfs_fds[closed_fd_index].inst_id == expected_inst_id:
                _dbfs_fds.remove(closed_fd_index)
            closed_fd_index = closed_fd_index - 1
        if _dbfs_closed_device_ids.len() >= _DBFS_CLOSED_DEVICE_RECEIPT_CAPACITY:
            _dbfs_closed_device_ids.remove(0)
        _dbfs_closed_device_ids.push(expected_inst_id)
        _dbfs_finish_result(Ok(true))
    static fn device_durability_blocker() -> text:
        """Machine-readable provider admission result for device-backed DBFS."""
        dbfs_device_serialization_blocker()

    fn _fstat_locked(handle: FileHandle) -> Result<FileStat, FsError>:
        val inode_idx = _fd_inode_idx_locked(self.inst_id, handle.id)
        if inode_idx < 0:
            return Err(FsError.StaleHandle)
        val inode = _dbfs_inodes[inode_idx]
        Ok(FileStat(
            inode: inode.id,
            size: inode.size as u64,
            blocks: ((inode.size as u64) + 4095u64) / 4096u64,
            block_size: 4096,
            mode: (if inode.kind == DbFsKind.Dir: 0o755 else 0o644) |
                (if inode.kind == DbFsKind.Dir: 0o040000 else 0),
            uid: 0,
            gid: 0,
            nlinks: 1,
            atime_ns: 0u64,
            mtime_ns: 0u64,
            ctime_ns: 0u64,
            birth_time_ns: 0u64
        ))

    fn fstat(handle: FileHandle) -> Result<FileStat, FsError>:
        if not dbfs_owner_transaction_begin(): return Err(FsError.Unsupported)
        _dbfs_finish_result(self._fstat_locked(handle))
    static fn new_hosted() -> DbFsDriver:
        """Create a new in-memory DBFS driver with a root inode."""
        # The legacy signature cannot report lock admission failure.  Return
        # an unusable, negative-id handle in that case; every operation will
        # fail the same owner boundary rather than touching shared state.
        if not dbfs_owner_transaction_begin():
            return DbFsDriver(
                name: "DbFsDriverUnavailable", inst_id: -1, next_id: 0,
                next_fd: 0, wal: SharedWal.new(), flush_count: 0,
                arena_base: -1, arena_block_count: 0, io_unit_bytes: 512,
                batch_bytes: 4096, trim_supported: false,
                write_zeroes_supported: false, direct_io: None)
        val iid = _alloc_inst_id_locked()
        # Install root inode
        _dbfs_inodes.push(DbFsInode(
            inst_id:  iid,
            id:       1,
            kind:     DbFsKind.Dir,
            name:     "/",
            content:  "",
            content_bytes: [],
            parent:   0,
            size:     0,
            unlinked: false,
        ))
        DbFsDriver(
            name:              "DbFsDriver",
            inst_id:           iid,
            next_id:           2,
            next_fd:           1,
            wal:               DbfsWal.new(),
            flush_count:       0,
            arena_base:        -1,
            arena_block_count: 0,
            io_unit_bytes:     512,
            batch_bytes:       4096,
            trim_supported:    false,
            write_zeroes_supported: false,
            direct_io:         None,
        )

    static fn open_on_device(dev: BlockDevice, base_block: i64, block_count: i64) -> Result<DbFsDriver, FsError>:
        """Create a DBFS driver backed by a real BlockDevice region.

        Registers the device with the sole DBFS commit owner. The final two
        blocks are alternating generation roots; on sufficiently large arenas
        each root authenticates a bounded preceding multi-sector checkpoint
        payload. Legacy one-sector namespace checkpoints remain readable.
        Returns Ok(DbFsDriver) with arena_base set; all writes go through the
        same serialized device commit owner.
        """
        if block_count < 3:
            return Err(FsError.InvalidArg)
        if not dbfs_owner_transaction_begin(): return Err(FsError.Unsupported)
        val iid = _alloc_inst_id_locked()
        val registered = dbfs_device_register_locked(iid, dev)
        if registered.is_err() or not registered.unwrap():
            return _dbfs_finish_driver_result(Err(
                if registered.is_err(): registered.unwrap_err() else: FsError.Unsupported))
        # Install root inode in the in-memory layer (same as new_hosted).
        _dbfs_inodes.push(DbFsInode(
            inst_id:  iid,
            id:       1,
            kind:     DbFsKind.Dir,
            name:     "/",
            content:  "",
            content_bytes: [],
            parent:   0,
            size:     0,
            unlinked: false,
        ))
        val next_inode = _dbfs_replay_namespace(iid, dev, base_block, block_count)
        Ok(DbFsDriver(
            name:              "DbFsDriver",
            inst_id:           iid,
            next_id:           next_inode,
            next_fd:           1,
            wal:               DbfsWal.new(),
            flush_count:       0,
            arena_base:        base_block,
            arena_block_count: block_count,
            io_unit_bytes:     dev.sector_size() as i64,
            batch_bytes:       dev.sector_size() as i64,
            trim_supported:    false,
            write_zeroes_supported: false,
            direct_io:         None,
        ))

    static fn open_on_device_with_direct_io(dev: BlockDevice, base_block: i64, block_count: i64, direct_io: DirectIoExt) -> Result<DbFsDriver, FsError>:
        val opened = DbFsDriver.open_on_device(dev, base_block, block_count)
        if opened.is_err():
            return opened
        var driver = match opened:
            Ok(value): value
            Err(err): return Err(err)
        driver.direct_io = Some(direct_io)
        Ok(driver)

    static fn open_on_samsung_business_nvme(dev: BlockDevice, base_block: i64, block_count: i64) -> Result<DbFsDriver, FsError>:
        """Open DBFS on the attached Samsung business NVMe policy.

        The current observed MZQL2960HCJR namespace is conventional NVMe
        (not ZNS/FDP) with 4 KiB physical blocks, 128 KiB optimal I/O, discard,
        and write-zeroes. This constructor carries those policy facts into the
        DBFS driver without issuing raw admin/vendor commands.
        """
        val opened = DbFsDriver.open_on_device(dev, base_block, block_count)
        if opened.is_err():
            return opened
        var driver = match opened:
            Ok(value): value
            Err(err): return Err(err)
        val facts = samsung_mzql2960hcjr_sysfs_facts()
        val policy = nvme_policy_for_class(facts, StorageClass.DB_WAL)
        driver.io_unit_bytes = policy.io_unit_bytes
        driver.batch_bytes = policy.batch_bytes
        driver.trim_supported = policy.uses_discard
        driver.write_zeroes_supported = policy.uses_write_zeroes
        Ok(driver)

    fn preferred_io_unit_bytes() -> i64:
        self.io_unit_bytes

    fn preferred_batch_bytes() -> i64:
        self.batch_bytes

    fn has_trim_support() -> bool:
        self.trim_supported

    fn has_write_zeroes_support() -> bool:
        self.write_zeroes_supported

    fn durability_serialization_ready() -> bool:
        self.arena_base >= 0 and dbfs_device_serialization_ready()

    fn durability_serialization_blocker() -> text:
        if self.arena_base < 0: return "not-device-backed"
        dbfs_device_serialization_blocker()

    fn transactional_replace_ready() -> bool:
        """DBFS rename commits one replacement checkpoint under this owner."""
        self.arena_base >= 0 and self.arena_block_count >= 4 and
            dbfs_device_instance_registered(self.inst_id)

    fn issue_server_data_root_mount_identity() -> Result<(i64, u64, u64), FsError>:
        """Issue DBFS identity plus a process-lifetime unique mount-seal nonce.

        DBFS namespace rename is serialized by the same transaction owner that
        persists namespace checkpoints.  A hosted instance, quarantined
        instance, or unavailable device owner therefore cannot be represented
        as a durable transactional-replace root by a mount-table caller.
        """
        if self.inst_id <= 0 or self.arena_base < 0 or self.arena_block_count < 4:
            return Err(FsError.Unsupported)
        if not dbfs_owner_transaction_begin(): return Err(FsError.Unsupported)
        val mutation_epoch = dbfs_device_mount_seal_epoch_locked(
            self.inst_id, self.arena_block_count)
        if mutation_epoch.is_err():
            return _dbfs_finish_result(Err(mutation_epoch.unwrap_err()))
        if _dbfs_next_mount_seal_nonce == 0xFFFFFFFFFFFFFFFFu64:
            return _dbfs_finish_result(Err(FsError.TooLarge))
        val nonce = _dbfs_next_mount_seal_nonce
        _dbfs_next_mount_seal_nonce = _dbfs_next_mount_seal_nonce + 1u64
        _dbfs_finish_result(Ok((self.inst_id, nonce, mutation_epoch.unwrap())))

    fn server_data_root_instance_identity() -> Result<(i64, u64), FsError>:
        """Observe the admitted identity without minting another seal nonce."""
        if self.inst_id <= 0 or self.arena_base < 0 or self.arena_block_count < 4:
            return Err(FsError.Unsupported)
        if not dbfs_owner_transaction_begin(): return Err(FsError.Unsupported)
        val epoch = dbfs_device_mount_seal_epoch_locked(self.inst_id, self.arena_block_count)
        if epoch.is_err(): return _dbfs_finish_result(Err(epoch.unwrap_err()))
        _dbfs_finish_result(Ok((self.inst_id, epoch.unwrap())))

    fn durable_root_snapshot_admission_v1() -> Result<(i64, u64, i64, i32), FsError>:
        """Return quiescent durable-root facts for a retained-bundle owner.

        This intentionally mints no mount nonce and changes no state.  The
        caller can retain the result only while it continues to validate the
        returned mutation epoch through its own owner-held lease protocol.
        """
        if self.inst_id <= 0 or self.arena_base < 0 or self.arena_block_count < 4:
            return Err(FsError.Unsupported)
        if not dbfs_owner_transaction_begin(): return Err(FsError.Unsupported)
        val snapshot = dbfs_device_durable_root_snapshot_locked(
            self.inst_id, self.arena_block_count)
        if snapshot.is_err(): return _dbfs_finish_result(Err(snapshot.unwrap_err()))
        val value = snapshot.unwrap()
        _dbfs_finish_result(Ok((
            value.instance_id, value.mutation_epoch,
            value.durable_generation, value.durable_slot)))

    fn _direct_io_extent_for_consumer_locked(handle: FileHandle, file_offset: i64, byte_len: u64, consumer: text) -> Result<DirectIoExtent, FsError>:
        """Map a file-relative direct-I/O range onto the DBFS data region."""
        if self.direct_io.is_none():
            return Err(FsError.Unsupported)
        if self.arena_base < 0 or self.arena_block_count <= 1:
            return Err(FsError.Unsupported)
        if self.io_unit_bytes <= 0:
            return Err(FsError.InvalidArg)
        if file_offset < 0 or byte_len == 0u64:
            return Err(FsError.InvalidArg)
        val len_i64 = byte_len as i64
        if file_offset % self.io_unit_bytes != 0 or len_i64 % self.io_unit_bytes != 0:
            return Err(FsError.InvalidArg)
        val inode_idx = _fd_inode_idx(self.inst_id, handle.id as u64)
        if inode_idx < 0:
            return Err(FsError.NotFound)
        val fd_idx = _find_fd_idx(self.inst_id, handle.id as u64)
        if fd_idx < 0 or _dbfs_fds[fd_idx].is_dir:
            return Err(FsError.InvalidArg)
        val max_data_bytes = (self.arena_block_count - 1) * self.io_unit_bytes
        if file_offset + len_i64 > max_data_bytes:
            return Err(FsError.TooLarge)
        val blob_idx = _dbfs_device_blob_idx(self.inst_id, _dbfs_inodes[inode_idx].id)
        if blob_idx < 0:
            return Err(FsError.Unsupported)
        val blob_offset = _dbfs_device_blob_offsets[blob_idx]
        val blob_len = _dbfs_device_blob_lengths[blob_idx]
        if file_offset + len_i64 > blob_len:
            return Err(FsError.TooLarge)
        val storage_offset = blob_offset + file_offset
        if storage_offset < 0 or (storage_offset % self.io_unit_bytes) != 0:
            return Err(FsError.InvalidArg)
        val relative_lba = storage_offset / self.io_unit_bytes
        Ok(DirectIoExtent(
            consumer: consumer,
            file_offset: file_offset,
            storage_lba: (self.arena_base + 1 + relative_lba) as u64,
            byte_len: byte_len,
            sector_size: self.io_unit_bytes as u32
        ))

    fn direct_io_extent_for_handle(handle: FileHandle, file_offset: i64, byte_len: u64) -> Result<DirectIoExtent, FsError>:
        self.direct_io_extent_for_consumer(handle, file_offset, byte_len, "dbfs")

    fn write_passthrough(data: [u8]) -> Result<i64, FsError>:
        """Write raw bytes directly to the backing BlockDevice via RawNvmeArena.

        Only available when the driver was constructed via open_on_device.
        Returns Ok(bytes_written) on success, Err(FsError.Unsupported) when
        the driver is in-memory only (arena_base == -1).
        """
        if self.arena_base < 0:
            return Err(FsError.Unsupported)
        val arena = RawNvmeArena(base_block: self.arena_base, block_count: self.arena_block_count - 1)
        val handle = arena.arena_handle()
        val r = arena.arena_append(handle, data, DurabilityClass.BestEffort)
        if r.generation < 0:
            return Err(FsError.IoError(code: 0))
        Ok(r.bytes_written)

    fn _commit_inode_bytes_to_device(inode_id: u64, data: [u8]) -> Result<bool, FsError>:
        """Append the current file image to the device arena and map it to inode."""
        if self.arena_base < 0:
            return Ok(false)
        val next_idx = _dbfs_device_next_idx(self.inst_id)
        if next_idx < 0:
            return Err(FsError.IoError(code: 0))
        val offset = _dbfs_device_next_offsets[next_idx]
        val r = _dbfs_write_device_bytes(self.inst_id, self.arena_base, self.arena_block_count, offset, data)
        if r.is_err():
            return Err(FsError.IoError(code: 0))
        val written = match r:
            Ok(value): value
            Err(_): return Err(FsError.IoError(code: 0))
        if written != data.len() as i64:
            return Err(FsError.IoError(code: 0))
        _dbfs_record_device_blob(self.inst_id, inode_id, offset, written)
        _dbfs_device_next_offsets[next_idx] = offset + written
        val persisted = _dbfs_persist_namespace(self.inst_id, self.arena_base, self.arena_block_count)
        if persisted.is_err():
            return Err(FsError.IoError(code: 0))
        Ok(true)

    fn _read_inode_bytes_from_device(inode_id: u64, length: i64) -> Result<[u8], FsError>:
        if self.arena_base < 0:
            return Err(FsError.Unsupported)
        val blob_idx = _dbfs_device_blob_idx(self.inst_id, inode_id)
        if blob_idx < 0:
            return Err(FsError.Unsupported)
        val blob_len = _dbfs_device_blob_lengths[blob_idx]
        val want = if length < blob_len: length else: blob_len
        val bytes = _dbfs_read_device_bytes(self.inst_id, self.arena_base, _dbfs_device_blob_offsets[blob_idx], want)
        if bytes.is_err():
            return bytes
        val out = match bytes:
            Ok(value): value
            Err(err): return Err(err)
        if out.len() < want:
            return Err(FsError.IoError(code: 0))
        Ok(out)

    fn _read_inode_range_from_device_locked(
        inode_id: u64, file_offset: i64, length: i64
    ) -> Result<[u8], FsError>:
        """Read only a validated inode subrange while the DBFS owner is held."""
        if self.arena_base < 0:
            return Err(FsError.Unsupported)
        if file_offset < 0 or length < 0:
            return Err(FsError.InvalidArg)
        val binding = dbfs_device_blob_binding_locked(self.inst_id, inode_id)
        if not binding.exists or binding.offset < 0 or binding.length < 0:
            return Err(FsError.Unsupported)
        if file_offset > binding.length or length > binding.length - file_offset:
            return Err(FsError.InvalidArg)
        if binding.offset > 0x7FFFFFFFFFFFFFFF - file_offset:
            return Err(FsError.TooLarge)
        val bytes = dbfs_device_read_bytes_locked(
            self.inst_id, self.arena_base, self.arena_block_count,
            binding.offset + file_offset, length
        )
        if bytes.is_err():
            return bytes
        val out = match bytes:
            Ok(value): value
            Err(err): return Err(err)
        if out.len() as i64 != length:
            return Err(FsError.IoError(code: 0))
        Ok(out)

    # --- capability / extension ---

    fn probe(cap: Capability) -> Option<Extension>:
        """Return capability extension handle for DBFS-supported capabilities."""
        match cap:
            case DirectIo:
                match self.direct_io:
                    Some(ext):
                        Some(Extension.DirectIo(ext: ext))
                    None:
                        None
            case PosixCompat:
                Some(Extension.PosixCompat(ext: PosixCompatExt(flags: 0, mode: 0)))
            case Xattr:
                Some(Extension.PosixCompat(ext: PosixCompatExt(flags: 0, mode: 0)))
            case Acl:
                Some(Extension.PosixCompat(ext: PosixCompatExt(flags: 0, mode: 0)))
            case Snapshot:
                Some(Extension.PosixCompat(ext: PosixCompatExt(flags: 0, mode: 0)))
            case COW:
                Some(Extension.PosixCompat(ext: PosixCompatExt(flags: 0, mode: 0)))
            case LargeFiles:
                Some(Extension.PosixCompat(ext: PosixCompatExt(flags: 0, mode: 0)))
            case _:
                None

    fn capabilities() -> FsCapabilitySet:
        """Return the set of capabilities this driver supports."""
        var caps = FsCapabilitySet.empty()
            .with(Capability.PosixCompat)
            .with(Capability.Xattr)
            .with(Capability.Acl)
            .with(Capability.Snapshot)
            .with(Capability.COW)
            .with(Capability.LargeFiles)
        if self.direct_io.is_some():
            caps = caps.with(Capability.DirectIo)
        caps

    # --- transaction ---

    fn begin_txn() -> DbfsTxn:
        """Begin a new transaction on this driver."""
        val txn_id = TxnId(value: _alloc_fd_id(self.inst_id) as i64)
        DbfsTxn.new(txn_id)

    fn flush_call_count() -> i64:
        """Return number of WAL flush calls (DURABLE_GROUP_COMMIT counter)."""
        self.flush_count

    me fn group_commit() -> Result<(), text>:
        """Flush all pending WAL records (DURABLE_GROUP_COMMIT)."""
        val r = self.wal.flush_wal()
        if r.is_ok():
            self.flush_count = self.flush_count + 1
        r
