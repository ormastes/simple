# std.nogc_sync_mut.crash.failure_slot_v1 — bounded first-fault record (DHR P2).
#
# Plan: doc/03_plan/app/debug/dhr_debug_spy_replay_recovery_plan_2026-11-17.md §7.2.
# A fault path writes ONE fixed record into this slot before frames are lost;
# an independent broker later take()s it. Rules:
#   - first fault wins: a nested fault never overwrites a valid record, it only
#     bumps nested_faults (DBG-06);
#   - the valid marker is set LAST, so a reader never sees a half-written record;
#   - no allocation beyond the caller-provided text, no I/O, no callbacks.
# First consumer: os.smf.kernel_plugin.recovery_worker (worker failure exits).
# Second consumer: the interpreter assert hook (publish_assert_failure below),
# behind the `dhr` build feature (SIMPLE_FEATURES=dhr). The C signal handler is
# not wired yet: it needs the externs in
# doc/08_tracking/bug/crash_signal_bundle_extern_gap_2026-07-29.md.

use std.nogc_sync_mut.io_runtime.{env_get_opt}

pub enum FailureKindV1:
    Assert
    Panic
    Signal
    Deadline
    WorkerExit

pub struct FailureRecordV1:
    kind: FailureKindV1
    site: text
    message: text
    module_generation: u64
    execution_epoch: u64
    sequence: u64
    nested_faults: u64

class FailureSlotV1:
    var valid: bool
    var kind: FailureKindV1
    var site: text
    var message: text
    var module_generation: u64
    var execution_epoch: u64
    var sequence: u64
    var nested_faults: u64

    static fn create() -> FailureSlotV1:
        FailureSlotV1(valid: false, kind: FailureKindV1.Panic, site: "", message: "",
            module_generation: 0, execution_epoch: 0, sequence: 0, nested_faults: 0)

    # @allow(primitive_api) generation/epoch are the KPF identities current at the fault
    me publish(kind: FailureKindV1, site: text, message: text, module_generation: u64, execution_epoch: u64) -> bool:
        """Record a fault; returns false (and counts it) if a fault is already held."""
        if self.valid:
            self.nested_faults = self.nested_faults + 1
            return false
        self.kind = kind
        self.site = site
        self.message = message
        self.module_generation = module_generation
        self.execution_epoch = execution_epoch
        self.sequence = self.sequence + 1
        self.valid = true
        true

    me take() -> Option<FailureRecordV1>:
        """Hand the held record to the broker and free the slot."""
        if not self.valid:
            return None
        val record = FailureRecordV1(kind: self.kind, site: self.site, message: self.message,
            module_generation: self.module_generation, execution_epoch: self.execution_epoch,
            sequence: self.sequence, nested_faults: self.nested_faults)
        self.valid = false
        self.nested_faults = 0
        Some(record)

# Process-wide slot fed by the interpreter assert hook. Only reachable when a
# compiler file imports this module, which it does only under
# `@when(feature = "dhr")`, so the default closure never holds it (DHR OFF-01).
var _process_failure_slot: FailureSlotV1 = FailureSlotV1.create()

pub fn dhr_profile_active() -> bool:
    """True when SIMPLE_FEATURES lists `dhr`. Same comma/space separated,
    case-insensitive parse as the compiler's cfg_feature_enabled, so the build
    feature and the runtime profile are one switch."""
    val raw = env_get_opt("SIMPLE_FEATURES") ?? ""
    for part in raw.replace(",", " ").split(" "):
        if part.trim().to_lower() == "dhr":
            return true
    false

# @allow(primitive_api) site/message are the interpreter's own assert text; no KPF identity exists there
pub fn publish_assert_failure(site: text, message: text) -> bool:
    """Assert hook: record a failing assert in the process slot before the
    normal failure path continues. A no-op returning false when the dhr profile
    is off. Generation and epoch are 0: an interpreted program has no KPF
    module generation."""
    if not dhr_profile_active():
        return false
    _process_failure_slot.publish(FailureKindV1.Assert, site, message, 0, 0)

pub fn take_process_failure() -> Option<FailureRecordV1>:
    """Broker side of the process slot."""
    _process_failure_slot.take()
