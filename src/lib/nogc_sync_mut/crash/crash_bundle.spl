# std.nogc_sync_mut.crash.crash_bundle — CrashBundleV1
#
# DS7 (mission-critical robustness plan, Batch D, lane crash-native).
#
# Scope note (read before extending this file): the C runtime already
# installs an ALWAYS-ON SIGSEGV/SIGBUS handler (`rt_install_crash_handler`,
# src/runtime/runtime.c:1921, wired at process start from `spl_init_args`,
# runtime.c:1301). It is async-signal-safe (uses raw `write()`, not
# `fprintf`), prints a `backtrace_symbols_fd` dump to stderr, then `_exit`s.
# It is NOT reachable from Simple code today — there is no extern that lets
# a signal fire a Simple callback, no register/context snapshot crosses the
# signal boundary, and it does not cover SIGABRT. Making it produce a
# CrashBundleV1 would need new externs; see
# doc/08_tracking/bug/crash_signal_bundle_extern_gap_2026-07-29.md for the
# exact signatures filed instead of stubbing something that pretends to see
# registers it cannot see.
#
# What IS reachable today, and what this file builds from:
#   - `spl_panic` (runtime.c:1845) already best-effort writes a raw crash
#     log; this module gives .spl-level panic-adjacent call sites (anything
#     that has a message + can call into std code before unwinding/exiting)
#     a structured, serializable bundle instead of loose stderr text.
#   - `std.log`'s RingBackend (src/lib/log.spl) for recent log records —
#     previously module-internal; exported for this lane (see log.spl's
#     "DS7 crash-bundle capture" export comment). `log_text_from_handle`
#     resolves the text-intern handle carried in a record's p0 field back
#     to the original message for records that came from the text-based
#     logging API (log_info/error/warn/... -> log_dispatch_text).
#   - `rt_getpid` / `rt_time_now_unix_micros` (already-extern, already
#     wrapped as `std.io_runtime.{getpid, time_now_unix_micros}`).
#
# No fake register/stack capture: fields this module cannot honestly fill
# (build_id, source_location) are left "" rather than fabricated.

use std.fs.{write_file}
use std.io_runtime.{getpid, time_now_unix_micros}
use std.common.serialization.{quote_string}
use std.log.{
    RingBackend, ring_backend_new, ring_backend_clear, ring_backend_count,
    ring_backend_subsys_at, ring_backend_seq_at, ring_backend_level_at,
    log_register_backend, log_remove_backend, log_text_from_handle
}

val CRASH_BUNDLE_VERSION: i32 = 1

# Default cap on how many trailing ring records ride along in a bundle.
# Keeps the bundle bounded even if the ring backend has accumulated a long
# run of records since it was registered.
val CRASH_BUNDLE_DEFAULT_MAX_RECORDS: i64 = 64

struct CrashRingRecordV1:
    subsys: i64
    level: i64
    # Resolved log message text. "" when the record's p0 payload is not a
    # live text-intern handle (e.g. a record pushed via log_dispatch_record
    # with a raw numeric payload, or a handle already overwritten by the
    # text-intern table's wraparound) — never a fabricated/guessed string.
    message: text

struct CrashBundleV1:
    version: i32
    build_id: text
    timestamp_unix_micros: i64
    pid: i64
    # e.g. "panic", "signal:SIGSEGV" (caller-classified — this module does
    # not itself observe signals; see the extern-gap note above), or any
    # caller-supplied fault classification.
    fault_kind: text
    message: text
    source_location: text
    ring_records: [CrashRingRecordV1]

impl CrashBundleV1:
    # Builds a bundle from a fault description plus the trailing entries of
    # `ring`, a RingBackend the caller registered earlier via
    # `log_register_backend` (typically once, near process start).
    static fn capture(fault_kind: text, message: text, source_location: text, ring: RingBackend) -> CrashBundleV1:
        CrashBundleV1.capture_n(fault_kind, message, source_location, ring, CRASH_BUNDLE_DEFAULT_MAX_RECORDS)

    static fn capture_n(fault_kind: text, message: text, source_location: text, ring: RingBackend, max_records: i64) -> CrashBundleV1:
        var records: [CrashRingRecordV1] = []
        val count = ring_backend_count(ring)
        var start = 0
        if count > max_records:
            start = count - max_records
        var i = start
        while i < count:
            val subsys = ring_backend_subsys_at(ring, i)
            val level = ring_backend_level_at(ring, i)
            val handle = ring_backend_seq_at(ring, i)
            val text_msg = log_text_from_handle(handle)
            records.push(CrashRingRecordV1(subsys: subsys, level: level, message: text_msg))
            i = i + 1
        CrashBundleV1(
            version: CRASH_BUNDLE_VERSION,
            build_id: "",
            timestamp_unix_micros: time_now_unix_micros(),
            pid: getpid(),
            fault_kind: fault_kind,
            message: message,
            source_location: source_location,
            ring_records: records
        )

    fn to_sdn() -> text:
        var lines: [text] = []
        lines.push("crash_bundle:")
        lines.push("  format: \"simple-crash-bundle\"")
        lines.push("  version: {self.version}")
        lines.push("")
        lines.push("bundle:")
        lines.push("  build_id: {quote_string(self.build_id)}")
        lines.push("  timestamp_unix_micros: {self.timestamp_unix_micros}")
        lines.push("  pid: {self.pid}")
        lines.push("  fault_kind: {quote_string(self.fault_kind)}")
        lines.push("  message: {quote_string(self.message)}")
        lines.push("  source_location: {quote_string(self.source_location)}")
        lines.push("")
        lines.push("ring_records:")
        lines.push("  count: {self.ring_records.len()}")
        var i = 0
        while i < self.ring_records.len():
            val r = self.ring_records[i]
            lines.push("  - subsys: {r.subsys}, level: {r.level}, message: {quote_string(r.message)}")
            i = i + 1
        lines.join("\n")

    fn write_to(path: text) -> bool:
        write_file(path, self.to_sdn())

# ---------------------------------------------------------------------------
# Convenience: register a fresh RingBackend for crash capture. Callers that
# already run their own RingBackend (e.g. an existing test/log harness) can
# skip this and pass their own RingBackend straight to `capture`/`capture_n`.
# ---------------------------------------------------------------------------
fn crash_ring_register(capacity: i64) -> (RingBackend, i64):
    val rb = ring_backend_new(capacity)
    val id = log_register_backend(rb.ops)
    (rb, id)

fn crash_ring_clear(ring: RingBackend):
    ring_backend_clear(ring)

fn crash_ring_unregister(id: i64) -> bool:
    log_remove_backend(id)
