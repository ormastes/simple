# Policy bytes come only from the current enrolled deployment and native store.
# This does not authorize input or prove that a provider supports a control kind.
use std.nogc_sync_mut.orchestration.host_local_root_v3.HostLocalRootV3

pub fn host_primary_connection_policy_bytes_v3(local: HostLocalRootV3) -> Result<text, text>:
    match local:
        case HostLocalRootV3.Windows(owner):
            val metadata = owner.current_v3()?
            Ok(metadata.broker_policy_bytes)
        case HostLocalRootV3.Linux(_):
            Err("host-primary-connection-direct-route-unsupported")
        case HostLocalRootV3.LinuxService(_):
            Err("host-primary-connection-direct-route-unsupported")
