use std.nogc_sync_mut.orchestration.controller_agent_task_objects_v1.*
use std.common.contracts.distributed_operation_history_v2.DistributedOperationJournalHistoryBatchV2

pub struct ControllerWorkloadStoreV1:
    controller_id: text
    journal: DistributedOperationJournalV2
    rows: {text: ControllerWorkloadFenceV1}

struct WorkloadReplayV1:
    rows: {text: ControllerWorkloadFenceV1}
    pending: [ControllerWorkloadFenceV1]
    pending_inputs: [OperationEnvelopeV2]

# Internal metadata operation, not a workload resource grant. Positive unit
# fields satisfy the existing envelope codec; they are never capacity charges.
pub fn workload_store_operation_v1(state: ControllerWorkloadFenceV1) -> Result<OperationEnvelopeV2, text>:
    val bytes = workload_fence_encode_v1(state)?
    val authority = controller_assignment_authority_v1(state.controller_id)?
    val id = sha256_text("WORKLOAD-REVISION-V1\n{state.controller_id}\n{state.workload_uid}\n{state.revision}\n")
    Ok(OperationEnvelopeV2(version: 2, id: "workload-" + id, payload_digest: sha256_text(bytes),
        principal: state.controller_id, project: state.controller_id, host_id: state.controller_id,
        operation: "controller_workload_revision_v1", environment_digest: authority, policy_revision: 1,
        revocation_epoch: 0, session_generation: state.controller_epoch, memory_bytes: 1, duration_ms: 1))

fn workload_store_current_v1(owner: ControllerWorkloadStoreV1) -> Result<bool, text>:
    val authority = controller_assignment_authority_v1(owner.controller_id)?
    if owner.journal.authority_digest != authority: return Err("workload-store-authority-mismatch")
    # Indexed lookup verifies both the writer lease and published WAL revision.
    match distributed_operation_journal_lookup_v2(owner.journal, "workload-owner-check"):
        case Ok(_): return Err("workload-store-reserved-id")
        case Err(reason):
            if reason != "OPERATION_NOT_FOUND": return Err(reason)
    Ok(true)

fn workload_store_replay_v1(journal: DistributedOperationJournalV2, controller_id: text) -> Result<WorkloadReplayV1, text>:
    if journal.operations.len() > 4096: return Err("workload-store-history-bound")
    var versions: {text: ControllerWorkloadFenceV1} = {}
    var rows: {text: ControllerWorkloadFenceV1} = {}
    var pending: [ControllerWorkloadFenceV1] = []
    var pending_inputs: [OperationEnvelopeV2] = []
    var cancelled_inputs: [text] = []
    var bindings: {text: ControllerAssignmentBindingV1} = {}
    var task_history: Option<DistributedOperationJournalHistoryBatchV2> = None
    for id in journal.operations.keys():
        val record = distributed_operation_journal_lookup_v2(journal, id)?
        val operation = distributed_decode_operation_v2(record.envelope)?
        if operation.operation == "controller_agent_task_retain_v1" or operation.operation == "controller_agent_task_use_v1":
            if operation.operation == "controller_agent_task_retain_v1":
                val task = controller_agent_task_object_read_v1(journal, operation, controller_id)?
            else:
                if task_history.is_none(): task_history = Some(distributed_operation_journal_history_batch_v2(journal)?)
                val checked = controller_agent_task_use_history_v1(journal, operation, controller_id, task_history.unwrap())?
            if record.state == "completed":
                if record.outcome_digest != operation.payload_digest: return Err("agent-task-outcome-mismatch")
            elif record.state == "admitted" or record.state == "executing" or record.state == "outcome-unknown":
                pending_inputs.push(operation)
            else:
                return Err("agent-task-terminal-invalid")
            continue
        if operation.operation == "controller_agent_preflight_v1":
            val binding = agent_preflight_objects_read_v1(journal, operation, controller_id)?
            if record.state == "completed":
                if record.outcome_digest != operation.payload_digest: return Err("agent-preflight-outcome-mismatch")
            elif record.state == "admitted" or record.state == "executing" or record.state == "outcome-unknown":
                pending_inputs.push(operation)
            else:
                return Err("agent-preflight-terminal-invalid")
            continue
        if operation.operation == "controller_agent_policy_v1":
            val policy = controller_agent_policy_read_v1(journal, operation, controller_id)?
            if record.state == "completed":
                if record.outcome_digest != operation.payload_digest: return Err("policy-snapshot-outcome-mismatch")
            elif record.state == "admitted" or record.state == "executing" or record.state == "outcome-unknown":
                pending_inputs.push(operation)
            else:
                return Err("policy-snapshot-terminal-invalid")
            continue
        if operation.operation == "controller_desired_input_v1" or operation.operation == "controller_desired_cancel_v1":
            val input = controller_desired_objects_read_owned_v3(journal, operation, controller_id)?
            if operation.operation == "controller_desired_cancel_v1":
                val parent = controller_desired_cancel_parent_v1(journal, input.input)?
                cancelled_inputs.push(input.input.workload_uid)
            if record.state == "completed":
                if record.outcome_digest != operation.payload_digest: return Err("desired-input-outcome-mismatch")
            elif record.state == "admitted" or record.state == "executing" or record.state == "outcome-unknown":
                pending_inputs.push(operation)
            else:
                return Err("desired-input-terminal-invalid")
            continue
        if operation.operation == "controller_assignment_v1":
            if operation.host_id != controller_id: return Err("workload-store-scope-invalid")
            continue
        if operation.operation != "controller_workload_revision_v1": return Err("workload-store-foreign-operation")
        val bytes = if not distributed_operation_journal_protected_v3(journal):
            file_read_regular_no_follow_bounded(journal.root + "/workload-payloads/" + operation.payload_digest + ".sdn", 8192)?
        else:
            distributed_operation_journal_read_required_v3(journal, "workload-payloads/" + operation.payload_digest + ".sdn", 8192)?
        val state = workload_fence_decode_v1(bytes)?
        if state.controller_id != controller_id or state.revision > 4096: return Err("workload-store-scope-invalid")
        val expected = workload_store_operation_v1(state)?
        val envelope = distributed_encode_operation_v2(expected)?
        if envelope != record.envelope: return Err("workload-store-payload-mismatch")
        if state.assignment_digest != "":
            if not bindings.contains_key(state.assignment_digest):
                bindings[state.assignment_digest] = assignment_objects_read_owned_v3(journal, state.assignment_digest)?
            val matched = controller_workload_matches_v1(state, bindings[state.assignment_digest])?
        if record.state == "completed":
            if record.outcome_digest != sha256_text(bytes): return Err("workload-store-outcome-mismatch")
            val key = state.workload_uid + ":" + str(state.revision)
            if versions.contains_key(key): return Err("workload-store-revision-conflict")
            versions[key] = state
            if not rows.contains_key(state.workload_uid):
                rows[state.workload_uid] = state
            elif rows[state.workload_uid].revision < state.revision:
                rows[state.workload_uid] = state
        elif record.state == "admitted" or record.state == "executing" or record.state == "outcome-unknown":
            pending.push(state)
        else:
            return Err("workload-store-terminal-invalid")
    if pending.len() + pending_inputs.len() > 1: return Err("workload-store-pending-conflict")
    for uid in cancelled_inputs:
        if rows.contains_key(uid): return Err("desired-cancel-resolved-workload-conflict")
        for state in pending:
            if state.workload_uid == uid: return Err("desired-cancel-resolved-workload-conflict")
    for uid in rows.keys():
        val initial_key = uid + ":1"
        if not versions.contains_key(initial_key): return Err("workload-store-history-gap")
        var prior = versions[initial_key]
        if not workload_fence_initial_v1(prior): return Err("workload-store-initial-invalid")
        var revision: i64 = 2
        while revision <= rows[uid].revision:
            val key = uid + ":" + str(revision)
            if not versions.contains_key(key): return Err("workload-store-history-gap")
            val next = versions[key]
            if not workload_fence_successor_v1(prior, next): return Err("workload-store-transition-invalid")
            prior = next
            revision = revision + 1
    for state in pending:
        if rows.contains_key(state.workload_uid):
            if not workload_fence_successor_v1(rows[state.workload_uid], state): return Err("workload-store-pending-invalid")
        elif not workload_fence_initial_v1(state):
            return Err("workload-store-pending-invalid")
    Ok(WorkloadReplayV1(rows: rows, pending: pending, pending_inputs: pending_inputs))

fn workload_store_complete_metadata_v1(journal: DistributedOperationJournalV2,
        state: ControllerWorkloadFenceV1) -> Result<DistributedOperationJournalV2, text>:
    val operation = workload_store_operation_v1(state)?
    val prior = daemon_operation_exact_v2(journal, operation)?
    var current = journal
    if prior.state == "admitted": current = daemon_operation_begin_v2(current, operation)?
    daemon_operation_record_outcome_v2(current, operation, "completed", operation.payload_digest)

# Shared projection preserves every existing replay domain and recovery rule.
# On failure the caller still owns the original lease; completed metadata may
# advance WAL revision, but never transfers the lock or changes lease identity.
fn workload_store_project_v2(journal_owner: DistributedOperationJournalV2,
        controller_id: text) -> Result<ControllerWorkloadStoreV1, text>:
    var journal = journal_owner
    val replay = workload_store_replay_v1(journal, controller_id)?
    var rows = replay.rows
    for pending in replay.pending:
        journal = workload_store_complete_metadata_v1(journal, pending)?
        rows[pending.workload_uid] = pending
    for operation in replay.pending_inputs:
        journal = controller_desired_complete_v1(journal, operation)?
    Ok(ControllerWorkloadStoreV1(controller_id: controller_id, journal: journal, rows: rows))

# Adopt an already-open actual journal from the protected Controller owner.
# No new journal/store/lease is acquired. On Err the caller retains the same
# native owner; pending replay may advance WAL but never transfers its lease.
pub fn controller_workload_store_project_owned_v3(journal: DistributedOperationJournalV2,
        controller_id: text) -> Result<ControllerWorkloadStoreV1, text>:
    val authority = controller_assignment_authority_v1(controller_id)?
    if journal.authority_digest != authority: return Err("workload-store-authority-mismatch")
    val current = workload_store_current_v1(ControllerWorkloadStoreV1(controller_id: controller_id, journal: journal, rows: {}))?
    workload_store_project_v2(journal, controller_id)

pub enum ControllerWorkloadStoreOpenV2:
    Ready(ControllerWorkloadStoreV1)
    Rejected(text)
    CleanupRequired(DistributedOperationJournalOpenCleanupV2, text)

pub fn controller_workload_store_open_owned_v2(root: text, controller_id: text, nonce: text,
        maximum_events: i64) -> ControllerWorkloadStoreOpenV2:
    val authority = match controller_assignment_authority_v1(controller_id):
        case Ok(value): value
        case Err(reason): return ControllerWorkloadStoreOpenV2.Rejected(reason)
    val journal = match distributed_operation_journal_open_owned_v2(root, authority, nonce, maximum_events):
        case DistributedOperationJournalOpenV2.Ready(value): value
        case DistributedOperationJournalOpenV2.Rejected(reason): return ControllerWorkloadStoreOpenV2.Rejected(reason)
        case DistributedOperationJournalOpenV2.CleanupRequired(cleanup, reason):
            return ControllerWorkloadStoreOpenV2.CleanupRequired(cleanup, reason)
    match workload_store_project_v2(journal, controller_id):
        case Ok(value): ControllerWorkloadStoreOpenV2.Ready(value)
        case Err(reason):
            val released = distributed_operation_journal_close_owned_v2(journal)
            if val cleanup = released.cleanup:
                return ControllerWorkloadStoreOpenV2.CleanupRequired(cleanup, reason + ":" + released.error)
            # No owner remains, but consumed-error/stale/error is still failure.
            val error = if released.error == "": reason else: reason + ":" + released.error
            ControllerWorkloadStoreOpenV2.Rejected(error)

pub fn controller_workload_store_close_owned_v2(owner: ControllerWorkloadStoreV1) -> DistributedOperationJournalCleanupTurnV2:
    # Preserve closed/state/error exactly: nil+closed+error is NOT success.
    distributed_operation_journal_close_owned_v2(owner.journal)

pub fn controller_workload_store_open_v1(root: text, controller_id: text, nonce: text,
        maximum_events: i64) -> Result<ControllerWorkloadStoreV1, text>:
    val authority = controller_assignment_authority_v1(controller_id)?
    val journal = distributed_operation_journal_open_v2(root, authority, nonce, maximum_events)?
    val projected = workload_store_project_v2(journal, controller_id)
    if projected.is_err():
        val closed = distributed_operation_journal_close_v2(journal)
        return Err(projected.unwrap_err())
    projected

pub fn controller_workload_store_lookup_v1(owner: ControllerWorkloadStoreV1,
        uid: text) -> Result<ControllerWorkloadFenceV1, text>:
    val current = workload_store_current_v1(owner)?
    if not owner.rows.contains_key(uid): return Err("workload-not-found")
    Ok(owner.rows[uid])

# Trusted internal extension port: caller authentication and approvals belong
# to the service boundary; this function grants no authority by itself.
pub fn workload_store_publish_v1(owner: ControllerWorkloadStoreV1,
        next: ControllerWorkloadFenceV1) -> Result<ControllerWorkloadStoreV1, text>:
    val current = workload_store_current_v1(owner)?
    if next.controller_id != owner.controller_id: return Err("workload-store-scope-invalid")
    val bytes = workload_fence_encode_v1(next)?
    if owner.rows.contains_key(next.workload_uid):
        val prior = owner.rows[next.workload_uid]
        val prior_bytes = workload_fence_encode_v1(prior)?
        if prior_bytes == bytes: return Ok(owner)
        if not workload_fence_successor_v1(prior, next): return Err("workload-store-transition-invalid")
    elif not workload_fence_initial_v1(next):
        return Err("workload-store-initial-invalid")
    if owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    val operation = workload_store_operation_v1(next)?
    val relative = "workload-payloads/" + operation.payload_digest + ".sdn"
    if not distributed_operation_journal_relative_v3(relative): return Err("workload-store-record-path-bounds")
    if not distributed_operation_journal_protected_v3(owner.journal):
        val path = owner.journal.root + "/" + relative
        if file_exists(path):
            val retained = file_read_regular_no_follow_bounded(path, 8192)?
            if retained != bytes: return Err("workload-store-payload-mismatch")
        else:
            dir_create(owner.journal.root + "/workload-payloads", true)
            if not file_atomic_write(path, bytes): return Err("workload-store-publication-failed")
            val retained = file_read_regular_no_follow_bounded(path, 8192)?
            if retained != bytes: return Err("workload-store-publication-mismatch")
    else:
        val published = distributed_operation_journal_publish_v3(owner.journal, relative, bytes)?
        val retained = distributed_operation_journal_read_required_v3(owner.journal, relative, 8192)?
        if retained != bytes:
            return Err(if published: "workload-store-publication-mismatch" else: "workload-store-payload-mismatch")
    val admitted = daemon_operation_admit_v2(owner.journal, operation)?
    val committed = workload_store_complete_metadata_v1(admitted.journal, next)?
    var rows = owner.rows
    rows[next.workload_uid] = next
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: committed, rows: rows))

pub fn controller_workload_store_create_v1(owner: ControllerWorkloadStoreV1,
        state: ControllerWorkloadFenceV1) -> Result<ControllerWorkloadStoreV1, text>:
    if not workload_fence_initial_v1(state): return Err("workload-store-initial-invalid")
    val desired_id = controller_desired_operation_id_v1(owner.controller_id, state.workload_uid)?
    val desired = distributed_operation_journal_lookup_v2(owner.journal, desired_id)
    if desired.is_ok(): return Err("desired-input-resolution-required")
    if desired.unwrap_err() != "OPERATION_NOT_FOUND": return Err(desired.unwrap_err())
    workload_store_publish_v1(owner, state)

# Trusted local controller boundary. Caller authentication precedes this API;
# schema-valid input is not an execution plan or a scheduling authorization.
pub fn controller_workload_store_submit_agent_v1(owner: ControllerWorkloadStoreV1,
        uid: text, source: text, ns: text, name: text) -> Result<ControllerWorkloadStoreV1, text>:
    val current = workload_store_current_v1(owner)?
    val input = controller_desired_input_select_v1(owner.controller_id, uid, source, ns, name)?
    val operation = controller_desired_operation_v1(input)?
    val existing = distributed_operation_journal_lookup_v2(owner.journal, operation.id)
    if existing.is_ok():
        val prior = existing.unwrap()
        if prior.envelope != distributed_encode_operation_v2(operation)?: return Err("desired-input-identity-reused")
        val retained = controller_desired_objects_read_owned_v3(owner.journal, operation, owner.controller_id)?
        if prior.state != "completed": return Err("desired-input-recovery-required")
        if prior.outcome_digest != operation.payload_digest: return Err("desired-input-outcome-mismatch")
        if controller_workload_store_agent_cancelled_v1(owner, uid)?: return Err("desired-input-cancelled")
        return Ok(owner)
    if existing.unwrap_err() != "OPERATION_NOT_FOUND": return Err(existing.unwrap_err())
    if owner.rows.contains_key(uid): return Err("desired-input-workload-already-exists")
    if owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    val saved = controller_desired_objects_retain_owned_v3(owner.journal, input, source)?
    val admitted = daemon_operation_admit_v2(owner.journal, operation)?
    val committed = controller_desired_complete_v1(admitted.journal, operation)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: committed, rows: owner.rows))

pub fn controller_workload_store_agent_source_v1(owner: ControllerWorkloadStoreV1,
        uid: text) -> Result<text, text>:
    val current = workload_store_current_v1(owner)?
    val id = controller_desired_operation_id_v1(owner.controller_id, uid)?
    val record = distributed_operation_journal_lookup_v2(owner.journal, id)?
    val operation = distributed_decode_operation_v2(record.envelope)?
    if record.state != "completed" or record.outcome_digest != operation.payload_digest:
        return Err("desired-input-not-committed")
    val retained = controller_desired_objects_read_owned_v3(owner.journal, operation, owner.controller_id)?
    Ok(retained.source)

# Read-only policy resolution. No plan is admitted or assigned by this call.
pub fn controller_workload_store_agent_policy_v1(owner: ControllerWorkloadStoreV1,
        uid: text, catalog: text, ns: text, name: text) -> Result<AgentPolicyResolutionV1, text>:
    val source = controller_workload_store_agent_source_v1(owner, uid)?
    if controller_workload_store_agent_cancelled_v1(owner, uid)?: return Err("desired-input-cancelled")
    val selected = controller_desired_input_select_v1(owner.controller_id, uid, source, ns, name)?
    val exact = daemon_operation_exact_v2(owner.journal, controller_desired_operation_v1(selected)?)?
    val snapshot_operation = controller_agent_policy_operation_v1(selected, sha256_text(catalog))?
    val snapshot = distributed_operation_journal_lookup_v2(owner.journal, snapshot_operation.id)
    if snapshot.is_ok():
        val prior = daemon_operation_exact_v2(owner.journal, snapshot_operation)?
        if prior.state != "completed" or prior.outcome_digest != snapshot_operation.payload_digest:
            return Err("policy-snapshot-recovery-required")
        return controller_agent_policy_read_v1(owner.journal, snapshot_operation, owner.controller_id)
    if snapshot.unwrap_err() != "OPERATION_NOT_FOUND": return Err(snapshot.unwrap_err())
    resolve_agent_policy_v1(source, catalog, ns, name)

# Trusted controller metadata commit, not execution approval. Catalog policy
# authorization belongs at the service boundary before this internal call.
pub fn controller_workload_store_pin_policy_v1(owner: ControllerWorkloadStoreV1,
        uid: text, catalog: text, ns: text, name: text) -> Result<ControllerWorkloadStoreV1, text>:
    val policy = controller_workload_store_agent_policy_v1(owner, uid, catalog, ns, name)?
    val source = controller_workload_store_agent_source_v1(owner, uid)?
    val input = controller_desired_input_select_v1(owner.controller_id, uid, source, ns, name)?
    val operation = controller_agent_policy_operation_v1(input, policy.catalog_digest)?
    val existing = distributed_operation_journal_lookup_v2(owner.journal, operation.id)
    if existing.is_ok():
        val prior = daemon_operation_exact_v2(owner.journal, operation)?
        val retained = controller_agent_policy_read_v1(owner.journal, operation, owner.controller_id)?
        if prior.state != "completed": return Err("policy-snapshot-recovery-required")
        if prior.outcome_digest != operation.payload_digest: return Err("policy-snapshot-outcome-mismatch")
        return Ok(owner)
    if existing.unwrap_err() != "OPERATION_NOT_FOUND": return Err(existing.unwrap_err())
    if owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    val saved = controller_agent_policy_retain_owned_v3(owner.journal, input, catalog)?
    val admitted = daemon_operation_admit_v2(owner.journal, operation)?
    val completed = controller_desired_complete_v1(admitted.journal, operation)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: completed, rows: owner.rows))

pub fn controller_workload_store_pinned_policy_v1(owner: ControllerWorkloadStoreV1,
        uid: text) -> Result<AgentPolicyResolutionV1, text>:
    if controller_workload_store_agent_cancelled_v1(owner, uid)?: return Err("desired-input-cancelled")
    val id = "policy-" + controller_desired_operation_id_v1(owner.controller_id, uid)?
    val record = distributed_operation_journal_lookup_v2(owner.journal, id)?
    val operation = distributed_decode_operation_v2(record.envelope)?
    if record.state != "completed" or record.outcome_digest != operation.payload_digest: return Err("policy-snapshot-not-committed")
    controller_agent_policy_read_v1(owner.journal, operation, owner.controller_id)

# Trusted metadata admission only. The service must authenticate the task/image
# and the later probe execution separately; this association grants no effects.
pub fn controller_workload_store_preflight_v1(owner: ControllerWorkloadStoreV1,
        binding: AgentPreflightBindingV1) -> Result<ControllerWorkloadStoreV1, text>:
    val current = workload_store_current_v1(owner)?
    if binding.controller_id != owner.controller_id: return Err("agent-preflight-controller-mismatch")
    val policy = controller_workload_store_pinned_policy_v1(owner, binding.session_uid)?
    val matched = agent_preflight_policy_match_v1(binding, policy)?
    val operation = agent_preflight_operation_v1(binding)?
    val existing = distributed_operation_journal_lookup_v2(owner.journal, operation.id)
    if existing.is_ok():
        val exact = daemon_operation_exact_v2(owner.journal, operation)?
        val retained = agent_preflight_objects_read_v1(owner.journal, operation, owner.controller_id)?
        if exact.state != "completed" or exact.outcome_digest != operation.payload_digest:
            return Err("agent-preflight-recovery-required")
        return Ok(owner)
    if existing.unwrap_err() != "OPERATION_NOT_FOUND": return Err(existing.unwrap_err())
    if owner.rows.contains_key(binding.preflight.workload_uid): return Err("agent-preflight-workload-already-exists")
    if (agent_preflight_for_workload_v1(owner.journal, owner.controller_id, binding.preflight.workload_uid)?).is_some():
        return Err("agent-preflight-workload-conflict")
    val desired_probe = distributed_operation_journal_lookup_v2(owner.journal,
        controller_desired_operation_id_v1(owner.controller_id, binding.preflight.workload_uid)?)
    if desired_probe.is_ok(): return Err("agent-preflight-workload-is-agent-session")
    if desired_probe.unwrap_err() != "OPERATION_NOT_FOUND": return Err(desired_probe.unwrap_err())
    if owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    val saved = agent_preflight_objects_retain_owned_v3(owner.journal, binding)?
    val admitted = daemon_operation_admit_v2(owner.journal, operation)?
    val committed = controller_desired_complete_v1(admitted.journal, operation)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: committed, rows: owner.rows))

# Called before every probe preparation/execution. Cancellation of its parent
# remains authoritative even when the child has not acquired a workload row.
pub fn controller_workload_store_preflight_guard_v1(owner: ControllerWorkloadStoreV1,
        plan: ContainerExecutionPlanV2) -> Result<bool, text>:
    val current = workload_store_current_v1(owner)?
    val association = agent_preflight_for_workload_v1(owner.journal, owner.controller_id, plan.workload_uid)?
    match association:
        case None: Ok(true)
        case Some(binding):
            if controller_workload_store_agent_cancelled_v1(owner, binding.session_uid)?:
                return Err("agent-preflight-parent-cancelled")
            if container_execution_plan_bytes_v2(binding.preflight)? != container_execution_plan_bytes_v2(plan)?:
                return Err("agent-preflight-execution-plan-mismatch")
            Ok(true)

# Read source remains allowed after cancellation for inspection. This separate
# query is mandatory before future resolution; cancellation never implies reap.
pub fn controller_workload_store_agent_cancelled_v1(owner: ControllerWorkloadStoreV1,
        uid: text) -> Result<bool, text>:
    val current = workload_store_current_v1(owner)?
    val id = controller_desired_operation_id_v1(owner.controller_id, uid)?
    val original = distributed_operation_journal_lookup_v2(owner.journal, id)?
    val operation = distributed_decode_operation_v2(original.envelope)?
    val retained = controller_desired_objects_read_owned_v3(owner.journal, operation, owner.controller_id)?
    val parent = controller_desired_cancel_parent_v1(owner.journal, retained.input)?
    val cancellation = controller_desired_cancel_operation_v1(retained.input)?
    val result = distributed_operation_journal_lookup_v2(owner.journal, cancellation.id)
    if result.is_err():
        if result.unwrap_err() == "OPERATION_NOT_FOUND": return Ok(false)
        return Err(result.unwrap_err())
    val record = daemon_operation_exact_v2(owner.journal, cancellation)?
    if record.state == "completed":
        if record.outcome_digest != cancellation.payload_digest: return Err("desired-cancel-outcome-mismatch")
    elif record.state != "admitted" and record.state != "executing" and record.state != "outcome-unknown":
        return Err("desired-cancel-terminal-invalid")
    Ok(true)

pub fn controller_workload_store_cancel_agent_v1(owner: ControllerWorkloadStoreV1,
        uid: text, expected_source_digest: text) -> Result<ControllerWorkloadStoreV1, text>:
    val current = workload_store_current_v1(owner)?
    if owner.rows.contains_key(uid): return Err("desired-cancel-requires-workload-owner")
    val id = controller_desired_operation_id_v1(owner.controller_id, uid)?
    val record = distributed_operation_journal_lookup_v2(owner.journal, id)?
    val original = distributed_decode_operation_v2(record.envelope)?
    val retained = controller_desired_objects_read_owned_v3(owner.journal, original, owner.controller_id)?
    val parent = controller_desired_cancel_parent_v1(owner.journal, retained.input)?
    if retained.input.source_digest != expected_source_digest: return Err("desired-cancel-source-mismatch")
    # Publish the exact child's sticky cancellation first. A crash before the
    # parent marker cannot revive that child; retry completes the same marker.
    # This requests reconciliation only, never native teardown or charge release.
    var current_owner = owner
    val preflight_id = agent_preflight_operation_id_v1(owner.controller_id, uid)?
    val preflight_record = distributed_operation_journal_lookup_v2(current_owner.journal, preflight_id)
    if preflight_record.is_ok():
        val preflight_operation = distributed_decode_operation_v2(preflight_record.unwrap().envelope)?
        val binding = agent_preflight_objects_read_v1(current_owner.journal, preflight_operation, owner.controller_id)?
        if current_owner.rows.contains_key(binding.preflight.workload_uid):
            val child = current_owner.rows[binding.preflight.workload_uid]
            if not child.cancellation_requested:
                current_owner = controller_workload_store_cancel_v1(current_owner, child.workload_uid, child.revision)?
    elif preflight_record.unwrap_err() != "OPERATION_NOT_FOUND":
        return Err(preflight_record.unwrap_err())
    val operation = controller_desired_cancel_operation_v1(retained.input)?
    if controller_workload_store_agent_cancelled_v1(current_owner, uid)?:
        val prior = daemon_operation_exact_v2(current_owner.journal, operation)?
        if prior.state != "completed": return Err("desired-input-recovery-required")
        return Ok(current_owner)
    if current_owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    val admitted = daemon_operation_admit_v2(current_owner.journal, operation)?
    val committed = controller_desired_complete_v1(admitted.journal, operation)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: committed, rows: current_owner.rows))

pub fn controller_workload_store_bind_v1(owner: ControllerWorkloadStoreV1, uid: text,
        expected_revision: i64, binding: ControllerAssignmentBindingV1) -> Result<ControllerWorkloadStoreV1, text>:
    val current = workload_store_current_v1(owner)?
    val desired_id = controller_desired_operation_id_v1(owner.controller_id, uid)?
    val desired = distributed_operation_journal_lookup_v2(owner.journal, desired_id)
    if desired.is_ok(): return Err("agent-assignment-retained-request-required")
    if desired.unwrap_err() != "OPERATION_NOT_FOUND": return Err(desired.unwrap_err())
    workload_store_bind_checked_v1(owner, uid, expected_revision, binding)

# Trusted internal extension port: caller authentication and approvals belong
# to the service boundary; this function grants no authority by itself.
pub fn workload_store_bind_checked_v1(owner: ControllerWorkloadStoreV1, uid: text,
        expected_revision: i64, binding: ControllerAssignmentBindingV1) -> Result<ControllerWorkloadStoreV1, text>:
    val prior = controller_workload_store_lookup_v1(owner, uid)?
    val next = controller_workload_bind_v1(prior, expected_revision, binding)?
    if prior.assignment_digest == "":
        val retained = assignment_objects_retain_owned_v3(owner.journal, binding)?
        if retained != next.assignment_digest: return Err("workload-assignment-object-mismatch")
    else:
        # Missing/corrupt committed objects are evidence loss, not permission
        # to silently repair them from a caller-provided request.
        val retained = assignment_objects_read_owned_v3(owner.journal, prior.assignment_digest)?
        val matching = controller_workload_matches_v1(prior, retained)?
    workload_store_publish_v1(owner, next)

pub fn controller_workload_store_assignment_v1(owner: ControllerWorkloadStoreV1,
        uid: text) -> Result<ControllerAssignmentBindingV1, text>:
    val state = controller_workload_store_lookup_v1(owner, uid)?
    if state.assignment_digest == "": return Err("workload-not-assigned")
    val binding = assignment_objects_read_owned_v3(owner.journal, state.assignment_digest)?
    val matching = controller_workload_matches_v1(state, binding)?
    Ok(binding)

fn workload_store_exact_binding_v1(owner: ControllerWorkloadStoreV1,
        binding: ControllerAssignmentBindingV1) -> Result<ControllerAssignmentBindingV1, text>:
    val retained = controller_workload_store_assignment_v1(owner, binding.workload_uid)?
    val expected = controller_assignment_bytes_v1(retained)?
    val received = controller_assignment_bytes_v1(binding)?
    if received != expected: return Err("workload-assignment-object-mismatch")
    Ok(retained)

pub fn controller_workload_store_cancel_v1(owner: ControllerWorkloadStoreV1, uid: text,
        expected_revision: i64) -> Result<ControllerWorkloadStoreV1, text>:
    val prior = controller_workload_store_lookup_v1(owner, uid)?
    val next = controller_workload_cancel_v1(prior, expected_revision)?
    workload_store_publish_v1(owner, next)

# Refresh from the current writer-owned projection instead of trusting a copied
# context. The same journal revision guards the ensuing preparation commit.
pub fn controller_workload_store_admit_assignment_v1(owner: ControllerWorkloadStoreV1,
        binding: ControllerAssignmentBindingV1, operation: OperationEnvelopeV2,
        grant: ExecutionGrantV2, context: ControllerAssignmentContextV1) -> Result<ControllerWorkloadStoreV1, text>:
    var fresh = context
    fresh.workload = controller_workload_store_lookup_v1(owner, binding.workload_uid)?
    val retained = workload_store_exact_binding_v1(owner, binding)?
    val journal = controller_assignment_admit_v1(owner.journal, retained, operation, grant, fresh)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: journal, rows: owner.rows))

pub fn controller_workload_store_begin_prepare_v1(owner: ControllerWorkloadStoreV1,
        binding: ControllerAssignmentBindingV1, operation: OperationEnvelopeV2,
        grant: ExecutionGrantV2, context: ControllerAssignmentContextV1) -> Result<ControllerWorkloadStoreV1, text>:
    var fresh = context
    fresh.workload = controller_workload_store_lookup_v1(owner, binding.workload_uid)?
    val retained = workload_store_exact_binding_v1(owner, binding)?
    val journal = controller_assignment_begin_prepare_v1(owner.journal, retained, operation, grant, fresh)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: journal, rows: owner.rows))

# milestone_0030 C5: the admit-build-row step. The remote build request (operation build|test, id == the Host operation
# id) becomes ONE `executing` row on the store's own journal (the single controller writer); the terminal transition is
# made later by the session accept through controller_workload_store_edit_journal_v1. Nothing here touches Host state or
# continuity. Authority is re-verified from the installed snapshot at `now` on every call (an expired approval is refused
# also after a restart); issuer must be this controller. An existing row with the same envelope in executing or
# outcome-unknown is kept, one left `admitted` by an interrupted admit is completed, any other row for the id is a
# conflict. Pre-commit refusals return the unchanged store with the code.
pub struct ControllerRemoteBuildAdmitV1:
    # The most advanced store: the caller MUST retain it even when `error` is set, because a failed second commit leaves
    # the first (`admitted`) commit already published and the original store revision-stale.
    store: ControllerWorkloadStoreV1
    error: text = ""

fn remote_build_admit_refused_v1(owner: ControllerWorkloadStoreV1, code: text) -> ControllerRemoteBuildAdmitV1:
    ControllerRemoteBuildAdmitV1(store: owner, error: code)

pub fn controller_workload_store_admit_remote_build_v1(owner: ControllerWorkloadStoreV1,
        snapshot: DistributedAuthoritySnapshotV2, session_generation: i64, signed: DistributedSignedGrantV2,
        approval: DistributedSignedApprovalV2, request: OperationEnvelopeV2, now: i64) -> ControllerRemoteBuildAdmitV1:
    if signed.issuer_id != owner.controller_id: return remote_build_admit_refused_v1(owner, "remote-build-admit-issuer")
    if request.operation != "build" and request.operation != "test":
        return remote_build_admit_refused_v1(owner, "remote-build-admit-operation")
    val verified = distributed_verify_grant_approval_from_snapshot_v2(snapshot, signed, approval, request, now,
        snapshot.generation, snapshot.policy_revision, snapshot.revocation_epoch, session_generation)
    if verified.is_err(): return remote_build_admit_refused_v1(owner, verified.unwrap_err())
    val encoded = distributed_encode_operation_v2(request)
    if encoded.is_err(): return remote_build_admit_refused_v1(owner, encoded.unwrap_err())
    val envelope = encoded.unwrap()
    val prior = distributed_operation_journal_lookup_v2(owner.journal, request.id)
    var journal = owner.journal
    var row: Option<DistributedOperationStateV2> = None
    if prior.is_ok():
        val found = prior.unwrap()
        if found.envelope != envelope or found.envelope_digest != sha256_text(envelope):
            return remote_build_admit_refused_v1(owner, "remote-build-admit-conflict")
        if found.state == "executing" or found.state == "outcome-unknown": return ControllerRemoteBuildAdmitV1(store: owner)
        # An exact-envelope row an interrupted admit left `admitted` is completed, never a conflict.
        if found.state != "admitted": return remote_build_admit_refused_v1(owner, "remote-build-admit-conflict")
        row = Some(found)
    else:
        if prior.unwrap_err() != "OPERATION_NOT_FOUND": return remote_build_admit_refused_v1(owner, prior.unwrap_err())
        val initial = distributed_operation_initial_v2(envelope)
        if initial.is_err(): return remote_build_admit_refused_v1(owner, initial.unwrap_err())
        val admitted = distributed_operation_journal_commit_v2(journal, initial.unwrap())
        if admitted.is_err(): return remote_build_admit_refused_v1(owner, admitted.unwrap_err())
        journal = admitted.unwrap()
        row = Some(initial.unwrap())
    val next = distributed_operation_transition_v2(row.unwrap(), "executing", "")
    if next.is_err():
        return remote_build_admit_refused_v1(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: journal, rows: owner.rows), next.unwrap_err())
    val executing = distributed_operation_journal_commit_v2(journal, next.unwrap())
    if executing.is_err():
        return remote_build_admit_refused_v1(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: journal, rows: owner.rows), executing.unwrap_err())
    ControllerRemoteBuildAdmitV1(store: ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: executing.unwrap(), rows: owner.rows))

# milestone_0030 C3: the session accept runs on THE controller journal. The closure receives the store's journal and
# returns the journal it produced plus a result text; the caller retains the returned store (root.retain_v3).
pub fn controller_workload_store_edit_journal_v1(owner: ControllerWorkloadStoreV1,
        edit: fn(DistributedOperationJournalV2) -> Result<(DistributedOperationJournalV2, text), text>) -> Result<(ControllerWorkloadStoreV1, text), text>:
    val edited = edit(owner.journal)?
    Ok((ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: edited.0, rows: owner.rows), edited.1))

pub fn controller_workload_store_close_v1(owner: ControllerWorkloadStoreV1) -> Result<bool, text>:
    distributed_operation_journal_close_v2(owner.journal)

# Cancellation does not discard a host receipt that raced the cancellation.
# It is still committed for reconciliation, but cannot become execution-ready.
pub fn controller_workload_store_commit_assignment_v1(owner: ControllerWorkloadStoreV1,
        uid: text, operation: OperationEnvelopeV2, receipt: HostPreparedReservationReceiptV1,
        grant: ExecutionGrantV2, context: ControllerAssignmentContextV1) -> Result<ControllerWorkloadStoreV1, text>:
    var fresh = context
    fresh.workload = controller_workload_store_lookup_v1(owner, uid)?
    val binding = controller_workload_store_assignment_v1(owner, uid)?
    val journal = controller_assignment_commit_v1(owner.journal, binding, operation, receipt, grant, fresh)?
    Ok(ControllerWorkloadStoreV1(controller_id: owner.controller_id, journal: journal, rows: owner.rows))

pub fn controller_workload_store_execution_ready_v1(owner: ControllerWorkloadStoreV1,
        uid: text, operation: OperationEnvelopeV2, grant: ExecutionGrantV2,
        context: ControllerAssignmentContextV1) -> Result<ControllerExecutionReadinessV1, text>:
    var fresh = context
    fresh.workload = controller_workload_store_lookup_v1(owner, uid)?
    val binding = controller_workload_store_assignment_v1(owner, uid)?
    controller_assignment_execution_ready_v1(owner.journal, binding, operation, grant, fresh)

# Trusted internal storage only. Actual service command owners independently
# verify retain/access signatures, installed authority and fresh wall time.
# The returned owner ALWAYS retains the latest actual journal returned by a
# completed phase, including failure after admission/begin. Primitive Err with
# no returned owner preserves the latest known same-lease owner, never guesses
# WAL state. effect_attempted conservatively includes object publication.
pub struct ControllerTaskStoreTurnV1:
    owner: ControllerWorkloadStoreV1
    error: text
    effect_attempted: bool

fn workload_store_task_turn_v1(owner: ControllerWorkloadStoreV1, error: text,
        attempted: bool) -> ControllerTaskStoreTurnV1:
    ControllerTaskStoreTurnV1(owner: owner, error: error, effect_attempted: attempted)

fn workload_store_task_commit_v1(owner: ControllerWorkloadStoreV1,
        operation: OperationEnvelopeV2) -> ControllerTaskStoreTurnV1:
    var current = owner
    val admitted = match daemon_operation_admit_v2(current.journal, operation):
        case Ok(value): value
        case Err(reason): return workload_store_task_turn_v1(current, reason, true)
    current.journal = admitted.journal
    if admitted.state == "admitted":
        val begun = match daemon_operation_begin_v2(current.journal, operation):
            case Ok(value): value
            case Err(reason): return workload_store_task_turn_v1(current, reason, true)
        current.journal = begun
    val completed = match daemon_operation_record_outcome_v2(current.journal, operation, "completed", operation.payload_digest):
        case Ok(value): value
        case Err(reason): return workload_store_task_turn_v1(current, reason, true)
    current.journal = completed
    workload_store_task_turn_v1(current, "", true)

fn workload_store_task_retain_prepare_v1(owner: ControllerWorkloadStoreV1,
        task: AgentTaskInputV1) -> Result<Option<OperationEnvelopeV2>, text>:
    val current = workload_store_current_v1(owner)?
    val operation = controller_agent_task_retain_operation_v1(owner.controller_id, task)?
    val existing = distributed_operation_journal_lookup_v2(owner.journal, operation.id)
    if existing.is_ok():
        val prior = daemon_operation_exact_v2(owner.journal, operation)?
        val retained = controller_agent_task_object_read_v1(owner.journal, operation, owner.controller_id)?
        if prior.state != "completed" or prior.outcome_digest != operation.payload_digest:
            return Err("agent-task-recovery-required")
        return Ok(None)
    if existing.unwrap_err() != "OPERATION_NOT_FOUND": return Err(existing.unwrap_err())
    if owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    Ok(Some(operation))

pub fn controller_workload_store_task_retain_v1(owner: ControllerWorkloadStoreV1,
        task: AgentTaskInputV1) -> ControllerTaskStoreTurnV1:
    val prepared = match workload_store_task_retain_prepare_v1(owner, task):
        case Ok(value): value
        case Err(reason): return workload_store_task_turn_v1(owner, reason, false)
    val operation = match prepared:
        case Some(value): value
        case None: return workload_store_task_turn_v1(owner, "", false)
    match controller_agent_task_object_retain_v1(owner.journal, task):
        case Ok(_): ()
        case Err(reason): return workload_store_task_turn_v1(owner, reason, true)
    workload_store_task_commit_v1(owner, operation)

fn workload_store_task_guard_v1(owner: ControllerWorkloadStoreV1,
        binding: AgentTaskUseBindingV1) -> Result<bool, text>:
    val current = workload_store_current_v1(owner)?
    if binding.controller_id != owner.controller_id: return Err("agent-task-use-controller-mismatch")
    val policy = controller_agent_task_policy_v1(owner.journal, binding)?
    if controller_workload_store_agent_cancelled_v1(owner, binding.session_uid)?: return Err("agent-task-use-cancelled")
    if owner.rows.contains_key(binding.session_uid):
        if owner.rows[binding.session_uid].cancellation_requested: return Err("agent-task-use-cancelled")
    Ok(true)

fn workload_store_task_use_prepare_v1(owner: ControllerWorkloadStoreV1,
        binding: AgentTaskUseBindingV1) -> Result<Option<OperationEnvelopeV2>, text>:
    val guarded = workload_store_task_guard_v1(owner, binding)?
    val operation = controller_agent_task_use_operation_v1(binding)?
    val existing = distributed_operation_journal_lookup_v2(owner.journal, operation.id)
    if existing.is_ok():
        val prior = daemon_operation_exact_v2(owner.journal, operation)?
        val retained = controller_agent_task_use_read_v1(owner.journal, operation, owner.controller_id)?
        if prior.state != "completed" or prior.outcome_digest != operation.payload_digest:
            return Err("agent-task-use-recovery-required")
        return Ok(None)
    if existing.unwrap_err() != "OPERATION_NOT_FOUND": return Err(existing.unwrap_err())
    val task = controller_agent_task_committed_v1(owner.journal, binding)?
    if owner.journal.operations.len() >= 4096: return Err("workload-store-history-bound")
    Ok(Some(operation))

pub fn controller_workload_store_task_use_v1(owner: ControllerWorkloadStoreV1,
        binding: AgentTaskUseBindingV1) -> ControllerTaskStoreTurnV1:
    val prepared = match workload_store_task_use_prepare_v1(owner, binding):
        case Ok(value): value
        case Err(reason): return workload_store_task_turn_v1(owner, reason, false)
    val operation = match prepared:
        case Some(value): value
        case None: return workload_store_task_turn_v1(owner, "", false)
    match controller_agent_task_use_retain_v1(owner.journal, binding):
        case Ok(_): ()
        case Err(reason): return workload_store_task_turn_v1(owner, reason, true)
    workload_store_task_commit_v1(owner, operation)

# Access must be independently reverified by the service for EACH call. A
# historical binding proves identity only. It never authorizes prompt export.
pub fn controller_workload_store_task_materialize_v1(owner: ControllerWorkloadStoreV1,
        binding: AgentTaskUseBindingV1) -> Result<AgentTaskInputV1, text>:
    val guarded = workload_store_task_guard_v1(owner, binding)?
    val operation = controller_agent_task_use_operation_v1(binding)?
    val committed = daemon_operation_exact_v2(owner.journal, operation)?
    if committed.state != "completed" or committed.outcome_digest != operation.payload_digest:
        return Err("agent-task-use-not-committed")
    val retained = controller_agent_task_use_read_v1(owner.journal, operation, owner.controller_id)?
    controller_agent_task_committed_v1(owner.journal, retained)
