# 30 s: the collector deadline (provider_cli_container_probe_v1.spl:302-303) and the per-probe timeout cap.
const HOST_AGENT_PROBE_TIMEOUT_MS_V4: i64 = 30000
const HOST_AGENT_INVOKE_MAX_BYTES_V4: i64 = 2097152
const HOST_AGENT_CANCEL_MAX_BYTES_V4: i64 = 65536

# The agent owner (DESIGN section 2). Transfer holder: exactly one of `container`, `fresh`, `collector` is Some
# while the transfer is held. Fields after `error` are the bounded-step cursors (deviation D17).
pub struct HostLinuxServiceAgentV4:
    container: Option<SimpleContainerOwnerV2> = None
    fresh: Option<LinuxFreshWorkloadOwnerV2> = None
    collector: Option<ProviderCliContainedProbeOwnerV2> = None
    root: Option<LinuxWorkspaceRootBorrowV3> = None
    # U-01: aliases the capsule's source custody; dropped at `stopping`, never used after it.
    source: Option<LinuxWorkspaceSourceLoanV3> = None
    receipts: [ProviderCliContainedProbeReceiptV2] = []
    selection: Option<ProviderCliContainedSelectionV2> = None
    operation_id: text = ""
    association_digest: text = ""
    payload_digest: text = ""
    workload_index: i64 = 0
    helper_roots: [text] = []
    root_nonce: text = ""
    stage: text = "transfer"
    workload_closed: bool = false
    # P2R1-F2: the service loan on the transfer has ended; release then retries only the epoch close.
    loan_ended: bool = false
    error: text = ""
    probe_count: i64 = 0
    pending: bool = false
    cleanup_action: text = ""
    reserved: bool = false
    intent: Option<ProviderCliInteractiveIntentDataV1> = None
    created: Option<RuntimeIdentityV1> = None
    probe_settles: [text] = []
    # milestone_0021 PR3 (D19): the agent lifecycle's released machine-charge row digest, read at stage `settle`.
    machine_settle: text = ""
    outcome: text = ""
    exit_digest: text = ""
    destroy_digest: text = ""
    observed: bool = false
    # A probe record was reserved by Select and is not yet settled; the current lifecycle is closed (probe-close
    # done, advance not yet).
    probe_record: bool = false
    # P3R1-F4: the probe Settle committed and its released-charge read is still outstanding (resumable).
    probe_settle_read: bool = false
    lifecycle_closed: bool = false
    # milestone_0021 PR3b (13.1): the primary attachment (never persisted), consumed once per incarnation (set
    # when the attach archive is written, never reset), and its summary kept after `returned`.
    attachment: Option<HostAgentAttachmentV4> = None
    attachment_consumed: bool = false
    attachment_summary: Option<HostAgentAttachmentSummaryV4> = None
    # 14A F2/D3: a stop cause seen while a native step is pending; outcome and exit digest are fixed when this is
    # first set (first cause kept) and begin_stop runs once the step drained.
    stop_requested: bool = false
    # D7: the last `grant_clock` a step saw (monotonic max); cancel, pane io and close read it as `now`.
    clock_ms: i64 = 0
    # milestone_0023 part B: the signed window end the last step saw (manifest `not_after`, re-derived by every
    # step from the signed manifest); an attach reads it as its window. 0 until a step ran: no attach before that.
    not_after: i64 = 0

# Canonical invoke payload: {operation_id, manifest bytes}. The manifest is untrusted transport; only the
# signed association digest admits it (section 4 check 1).
pub struct HostAgentInvokeRequestV4:
    operation_id: text
    manifest: text

# Everything a step reads that is not agent state: re-derived by the service owner on EVERY call from the
# archived signed execute and its live clock, never carried across calls.
pub struct HostAgentStepInputV4:
    execute: HostExecuteAssociatedRequestV3
    manifest: AgentWorkspaceInvocationManifestV2
    provider: ProviderCliProviderV1
    request: LinuxOciRequestV1
    template: GroupProcessStreamLaunchV2
    clock: HostReservationAuthorizationContextV1
    service_scope: text
    fence: text
    # P2R1-F3: the SIGNED enrollment provider identity (records.binding), never the held epoch's own value.
    expected_provider: text

pub struct HostLinuxServiceAgentTurnV4:
    agent: HostLinuxServiceAgentV4
    capacity: HostCapacityOwnerV1
    response: text
    error: text
    effect_attempted: bool

# Stage `transfer` result: the agent on success or post-transfer failure, else the admission returned whole.
pub struct HostLinuxServiceAgentOpenV4:
    agent: Option<HostLinuxServiceAgentV4> = None
    admission: Option<MachineFreshEpochAdmissionOwnerV1> = None
    # A pre-transfer root whose loan end was refused (3.3 N-05): the service owner keeps and ends it first.
    root: Option<LinuxWorkspaceRootBorrowV3> = None
    error: text = ""

pub struct HostLinuxServiceAgentCloseV4:
    agent: HostLinuxServiceAgentV4
    # 13.5: the capacity owner after the C2 attachment release (adopted by the service owner when Some).
    capacity: Option<HostCapacityOwnerV1>
    closed: bool
    error: text

# ---- codec ----

pub fn host_agent_invoke_request_encode_v4(value: HostAgentInvokeRequestV4) -> Result<text, text>:
    if not builder_identifier_valid_v1(value.operation_id): return Err("linux-host-agent-invoke-operation")
    if value.manifest.byte_len() == 0 or value.manifest.contains("\0"): return Err("linux-host-agent-invoke-manifest")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-invoke"),
        "operationId": SdnValue.String(value.operation_id), "manifest": SdnValue.String(value.manifest)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if bytes.byte_len() > HOST_AGENT_INVOKE_MAX_BYTES_V4: return Err("linux-host-agent-invoke-size")
    Ok(bytes)

fn host_agent_invoke_text_v4(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("linux-host-agent-invoke-field:" + name)

pub fn host_agent_invoke_request_decode_v4(source: text) -> Result<HostAgentInvokeRequestV4, text>:
    if source.byte_len() == 0 or source.byte_len() > HOST_AGENT_INVOKE_MAX_BYTES_V4: return Err("linux-host-agent-invoke-size")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: HOST_AGENT_INVOKE_MAX_BYTES_V4,
            max_depth: 2, max_nodes: 16, max_rows: 0, max_cells: 0, max_columns: 8)):
        case Ok(value): value
        case Err(issue): return Err("linux-host-agent-invoke-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("linux-host-agent-invoke-object")
    if fields.len() != 4: return Err("linux-host-agent-invoke-fields")
    for name in ["version", "kind", "operationId", "manifest"]:
        if not fields.contains_key(name): return Err("linux-host-agent-invoke-fields")
    val value = HostAgentInvokeRequestV4(operation_id: host_agent_invoke_text_v4(fields, "operationId")?,
        manifest: host_agent_invoke_text_v4(fields, "manifest")?)
    # Canonical bytes only (version and kind included).
    if host_agent_invoke_request_encode_v4(value)? != source: return Err("linux-host-agent-invoke-noncanonical")
    Ok(value)

# ---- controller-signed cancel (milestone_0021 PR3a, review P3R1-F1) ----

# Canonical cancel payload: the run's operation id and association digest, plus the controller-signed
# operation/grant/approval triple. Never the invoke bytes: those carry no signature and anyone who saw an
# invoke could replay them as a cancel. The operation is DERIVED from the archived signed execute's envelope
# (host_agent_cancel_operation_v4), so a cancel can only stop the run that execute admitted.
pub struct HostAgentCancelRequestV4:
    operation_id: text
    association_digest: text
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

fn host_agent_cancel_payload_digest_v4(operation_id: text, association_digest: text) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-cancel"),
        "operationId": SdnValue.String(operation_id), "associationDigest": SdnValue.String(association_digest)}
    sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)))

# The cancel's own operation kind (precedent: controller_desired_cancel_operation_v1): same principal, project,
# host, environment and budget as the archived execute, a distinct id and kind, a payload digest bound to the
# operation id and the association digest, and the LIVE policy revision, revocation epoch and session generation
# so a controller can still cancel after a session rollover while an old-session packet cannot be replayed.
pub fn host_agent_cancel_operation_v4(execute: OperationEnvelopeV2, association_digest: text,
        context: HostReservationAuthorizationContextV1) -> Result<OperationEnvelopeV2, text>:
    if not builder_digest_valid_v1(association_digest): return Err("linux-host-agent-cancel-association")
    # PR3b: one derivation for every controller-signed agent action (cancel, attach, detach).
    host_agent_action_operation_v4("host_agent_cancel_v4", execute, host_agent_cancel_payload_digest_v4(execute.id,
        association_digest), context)

pub fn host_agent_cancel_request_encode_v4(value: HostAgentCancelRequestV4) -> Result<text, text>:
    if not builder_identifier_valid_v1(value.operation_id): return Err("linux-host-agent-cancel-operation")
    if not builder_digest_valid_v1(value.association_digest): return Err("linux-host-agent-cancel-association")
    if (value.operation.operation != "host_agent_cancel_v4" or value.operation.id != "cancel-" + value.operation_id or
            value.operation.payload_digest != host_agent_cancel_payload_digest_v4(value.operation_id, value.association_digest)):
        return Err("linux-host-agent-cancel-operation-mismatch")
    if (not value.signed.grant.operations.contains("host_agent_cancel_v4") or
            value.approval.request_digest != sha256_text(distributed_encode_operation_v2(value.operation)?) or
            value.approval.grant_digest != distributed_grant_digest_v2(value.signed.grant)?):
        return Err("linux-host-agent-cancel-proof-binding")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-cancel"),
        "operationId": SdnValue.String(value.operation_id), "associationDigest": SdnValue.String(value.association_digest),
        "operation": SdnValue.String(distributed_encode_operation_v2(value.operation)?),
        "signed": SdnValue.String(distributed_encode_signed_grant_v2(value.signed)?),
        "approval": SdnValue.String(distributed_encode_signed_approval_v2(value.approval)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if bytes.byte_len() > HOST_AGENT_CANCEL_MAX_BYTES_V4: return Err("linux-host-agent-cancel-size")
    Ok(bytes)

fn host_agent_cancel_text_v4(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("linux-host-agent-cancel-field:" + name)

pub fn host_agent_cancel_request_decode_v4(source: text) -> Result<HostAgentCancelRequestV4, text>:
    if source.byte_len() == 0 or source.byte_len() > HOST_AGENT_CANCEL_MAX_BYTES_V4: return Err("linux-host-agent-cancel-size")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: HOST_AGENT_CANCEL_MAX_BYTES_V4,
            max_depth: 2, max_nodes: 16, max_rows: 0, max_cells: 0, max_columns: 8)):
        case Ok(value): value
        case Err(issue): return Err("linux-host-agent-cancel-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("linux-host-agent-cancel-object")
    if fields.len() != 7: return Err("linux-host-agent-cancel-fields")
    for name in ["version", "kind", "operationId", "associationDigest", "operation", "signed", "approval"]:
        if not fields.contains_key(name): return Err("linux-host-agent-cancel-fields")
    val value = HostAgentCancelRequestV4(operation_id: host_agent_cancel_text_v4(fields, "operationId")?,
        association_digest: host_agent_cancel_text_v4(fields, "associationDigest")?,
        operation: distributed_decode_operation_v2(host_agent_cancel_text_v4(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(host_agent_cancel_text_v4(fields, "signed")?)?,
        approval: distributed_decode_signed_approval_v2(host_agent_cancel_text_v4(fields, "approval")?)?)
    # Canonical bytes only (version and kind included).
    if host_agent_cancel_request_encode_v4(value)? != source: return Err("linux-host-agent-cancel-noncanonical")
    Ok(value)

# Gate order of the cancel authorization (mirrors the associated execute): the request names the held run; the
# archived execute's association digest equals the request's and the held agent's; the operation is exactly the
# one derived from the archived execute under the live context; the issuer is the configured controller; and
# issuer and approver signatures verify under the installed authority snapshot. Pure: the owner glue supplies
# the archived execute, the held ids and the live context, and archives the packet only after this returns Ok.
# PR3b: a wrapper over host_linux_service_agent_action_authorize_v4 (same gates, same errors, same order).
pub fn host_linux_service_agent_cancel_authorize_v4(snapshot: DistributedAuthoritySnapshotV2, controller_ref: text,
        request: HostAgentCancelRequestV4, execute_operation: OperationEnvelopeV2, execute_association_digest: text,
        held_operation_id: text, held_association_digest: text,
        context: HostReservationAuthorizationContextV1) -> Result<ExecutionGrantV2, text>:
    host_linux_service_agent_action_authorize_v4("host_agent_cancel_v4", snapshot, controller_ref, request.operation_id,
        request.association_digest, request.operation, request.signed, request.approval,
        host_agent_cancel_payload_digest_v4(execute_operation.id, execute_association_digest), execute_operation,
        execute_association_digest, held_operation_id, held_association_digest, context)

# No-replace archive of the signed cancel: Ok(true) is an exact-bytes retry (idempotent, answered without a
# second verification); a different packet for an archived cancel is a conflict.
pub fn host_agent_cancel_archive_check_v4(archived: Option<text>, source: text) -> Result<bool, text>:
    if archived.is_none(): return Ok(false)
    if archived.unwrap() != source: return Err("linux-host-agent-cancel-packet-conflict")
    Ok(true)

# ---- stored-bytes gates (section 2 gates 2-5; gate 1 and the archive/association reads are the service owner's) ----

# Gate 2: the archived signed execute for exactly this operation. Gates 4-5 run on the STORED association bytes.
pub fn host_linux_service_agent_execute_v4(archived: Option<text>, operation_id: text) -> Result<HostExecuteAssociatedRequestV3, text>:
    if archived.is_none(): return Err("linux-host-agent-execute-unarchived")
    val execute = host_execute_associated_decode_v3(archived.unwrap())
    if execute.is_err(): return Err("linux-host-agent-execute-unarchived")
    if execute.unwrap().prepare.prepare.operation.id != operation_id: return Err("linux-host-agent-execute-foreign")
    Ok(execute.unwrap())

# Gates 3-5 and section 4 checks 1-2 over the archived execute and the stored association bytes. Returns the
# decoded signed manifest; nothing from the payload is used except through it. `replay` (P2R1-F1, DESIGN section 2
# gate 1b before gates 2-5): the caller's agent matched this op and payload and is at `settled` or `host-settle`,
# so a `completed` row is also admitted and the step performs 1b against the row and the outcome record. Every
# other gate still runs.
pub fn host_linux_service_agent_admit_v4(capacity: HostCapacityOwnerV1, scope: ContainerHostScopeV2,
        execute: HostExecuteAssociatedRequestV3, stored_association: Option<text>,
        invoke: HostAgentInvokeRequestV4, replay: bool) -> Result<AgentWorkspaceInvocationManifestV2, text>:
    val row = daemon_operation_exact_v2(capacity.journal, execute.prepare.prepare.operation)?
    if row.state != "executing" and not (replay and row.state == "completed"): return Err("linux-host-agent-row-not-executing")
    if stored_association.is_none(): return Err("linux-host-agent-association-missing")
    if host_execution_association_encode_v3(execute.association)? != stored_association.unwrap():
        return Err("linux-host-agent-association-foreign")
    if container_host_scope_bytes_v2(execute.association.service_scope)? != container_host_scope_bytes_v2(scope)?:
        return Err("linux-host-agent-association-fence")
    val association = execute.association
    if not association.readonly_rootfs: return Err("linux-host-agent-root-not-read-only")
    if (not builder_digest_valid_v1(association.agent_invocation_manifest_digest) or
            not builder_digest_valid_v1(association.agent_probe_list_digest)):
        return Err("linux-host-agent-binding-unsigned")
    val manifest = agent_workspace_invocation_manifest_decode_v2(invoke.manifest)
    if manifest.is_err(): return Err("linux-host-agent-manifest-unsigned")
    if sha256_text(agent_workspace_invocation_manifest_encode_v2(manifest.unwrap())?) != association.agent_invocation_manifest_digest:
        return Err("linux-host-agent-manifest-unsigned")
    # Check 2: the backend projection of the signed request is read-only with no writable output mount.
    val request = linux_oci_retained_request_decode_v1(association.execution.request_bytes)?
    if request.filesystem_policy != "read-only" or request.build_output_root != "":
        return Err("linux-host-agent-root-not-read-only")
    Ok(manifest.unwrap())

# The per-call step input from the archived execute and the decoded manifest.
pub fn host_linux_service_agent_input_v4(execute: HostExecuteAssociatedRequestV3, manifest: AgentWorkspaceInvocationManifestV2,
        template: GroupProcessStreamLaunchV2, clock: HostReservationAuthorizationContextV1,
        service_scope: text, scope: ContainerHostScopeV2, expected_provider: text) -> Result<HostAgentStepInputV4, text>:
    val provider = decode_provider_cli_provider_v1(manifest.base.task_use.provider)?
    val request = linux_oci_retained_request_decode_v1(execute.association.execution.request_bytes)?
    Ok(HostAgentStepInputV4(execute: execute, manifest: manifest, provider: provider, request: request,
        template: template, clock: clock, service_scope: service_scope, fence: container_scope_fence_id_v2(scope)?,
        expected_provider: expected_provider))

# 3.4 step 1: n probes at min(timeout, 30 s) plus the agent must fit the signed operation duration.
pub fn host_linux_service_agent_budget_v4(input: HostAgentStepInputV4) -> Result<(), text>:
    val n = provider_cli_probe_count_v1(input.provider)
    val agent = input.request.timeout_ms
    val probe = if agent < HOST_AGENT_PROBE_TIMEOUT_MS_V4: agent else: HOST_AGENT_PROBE_TIMEOUT_MS_V4
    if n < 1 or agent <= 0 or n * probe + agent > input.execute.operation.duration_ms:
        return Err("linux-host-agent-duration-budget")
    Ok(())

# ---- probe request (3.4a, r5 V-04) ----

# Pure: the signed request with ONLY the probe fields replaced, and the signed plan with ONLY request_digest
# replaced. A distinct request per index gives a distinct machine record id.
pub fn host_linux_service_agent_probe_request_v4(execution: ContainerExecutionRequestV2,
        manifest: AgentWorkspaceInvocationManifestV2, provider: ProviderCliProviderV1,
        index: i64) -> Result<ContainerExecutionRequestV2, text>:
    val signed = linux_oci_retained_request_decode_v1(execution.request_bytes)?
    val argv = manifest.base.inner_argv
    if argv.len() == 0 or not argv[0].starts_with("/"): return Err("linux-host-agent-probe-program")
    if not signed.image.contains("@sha256:"): return Err("linux-host-agent-probe-image")
    val timeout = if signed.timeout_ms < HOST_AGENT_PROBE_TIMEOUT_MS_V4: signed.timeout_ms else: HOST_AGENT_PROBE_TIMEOUT_MS_V4
    val probe = LinuxOciRequestV1(pod_uid: signed.pod_uid, attempt: signed.attempt, operation_id: signed.operation_id,
        image: signed.image, bundle_path: "", command: [argv[0]], args: provider_cli_probe_argv_v1(provider, index)?,
        timeout_ms: timeout, cpu_limit_millis: signed.cpu_limit_millis, memory_limit_bytes: signed.memory_limit_bytes,
        pid_limit: signed.pid_limit, network_policy: "none", filesystem_policy: "read-only", build_input_root: "",
        build_output_root: "", replace_entrypoint: true, environment: [], working_directory: "", terminal_mode: "none",
        mounts: [])
    var plan = execution.plan
    plan.request_digest = linux_oci_request_digest_v1(probe)?
    Ok(ContainerExecutionRequestV2(plan: plan, request_bytes: linux_oci_retained_request_encode_v1(probe)?))

# ---- transfer holder twins (3.5: the epoch through whichever holder has the transfer) ----

pub fn host_linux_service_agent_epoch_v4(agent: HostLinuxServiceAgentV4) -> Result<MachineFreshEpochRecordV1, text>:
    if val held = agent.container: return simple_container_epoch_current_v3(held)
    if val held = agent.fresh: return held.epoch_current_v3()
    if val held = agent.collector: return held.epoch_current_v3()
    Err("linux-host-agent-transfer-missing")

fn host_agent_turn_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1, response: text, error: text,
        effect_attempted: bool) -> HostLinuxServiceAgentTurnV4:
    HostLinuxServiceAgentTurnV4(agent: agent, capacity: capacity, response: response, error: error,
        effect_attempted: effect_attempted)

# Reply DATA: never a grant. `pending` until stage settled.
pub fn host_linux_service_agent_reply_v4(agent: HostLinuxServiceAgentV4) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-invoke-reply"),
        "operationId": SdnValue.String(agent.operation_id), "associationDigest": SdnValue.String(agent.association_digest),
        "stage": SdnValue.String(agent.stage), "workloadIndex": SdnValue.Int(agent.workload_index),
        "outcome": SdnValue.String(agent.outcome), "pending": SdnValue.Bool(agent.stage != "settled")}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

# Terminal: wedged keeps the Host row executing and charged (U-02); it drains at reopen (rec4:227-230/236).
fn host_agent_wedged_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1, error: text) -> HostLinuxServiceAgentTurnV4:
    var retained = agent
    if retained.error == "": retained.error = error
    retained.stage = "wedged"
    retained.pending = false
    host_agent_turn_v4(retained, capacity, "", retained.error, true)

# A failure with no unsettled machine record (pre-enable): the run ends; 3.7 closes the lifecycle (T-04).
fn host_agent_failed_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1, error: text) -> HostLinuxServiceAgentTurnV4:
    var retained = agent
    if retained.error == "": retained.error = error
    retained.stage = "failed"
    retained.pending = false
    host_agent_turn_v4(retained, capacity, "", retained.error, true)

fn host_agent_pending_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1) -> HostLinuxServiceAgentTurnV4:
    host_agent_turn_v4(agent, capacity, host_linux_service_agent_reply_v4(agent), "", true)

# ---- stage `transfer` (3.4 steps 1-4) ----

# The admission moves whole into the factory. On a pre-transfer failure the admission comes back whole (its
# root loan ended and R3 closed by the factory); on a post-transfer failure the agent holds the fresh owner in
# stage `failed`. The template is validated against the HELD epoch before any reserve.
pub fn host_linux_service_agent_open_v4(admission: MachineFreshEpochAdmissionOwnerV1,
        native: LinuxServiceNativeIdentityBorrowV3, input: HostAgentStepInputV4, operation_id: text,
        association_digest: text, payload_digest: text) -> HostLinuxServiceAgentOpenV4:
    val budget = host_linux_service_agent_budget_v4(input)
    if budget.is_err(): return HostLinuxServiceAgentOpenV4(admission: Some(admission), error: budget.unwrap_err())
    # Per-incarnation CSPRNG nonce drawn BEFORE any effect, so an entropy failure is retryable.
    val nonce = sosix_random_hex(8) ?? ""
    if not host_service_hex_shape_v6(nonce, 16): return HostLinuxServiceAgentOpenV4(admission: Some(admission),
        error: "linux-host-agent-entropy-unavailable")
    val opened = simple_container_open_lent_v4(admission, native, input.template)
    val shell = HostLinuxServiceAgentV4(operation_id: operation_id, association_digest: association_digest,
        payload_digest: payload_digest, root_nonce: nonce, probe_count: provider_cli_probe_count_v1(input.provider))
    if opened.admission_cleanup.is_some():
        return HostLinuxServiceAgentOpenV4(admission: opened.admission_cleanup, root: opened.root,
            error: if opened.error != "": opened.error else: "linux-host-agent-transfer-refused")
    if opened.fresh_cleanup.is_some():
        var failed = shell
        failed.fresh = opened.fresh_cleanup
        failed.root = opened.root
        failed.stage = "failed"
        failed.error = if opened.error != "": opened.error else: "linux-host-agent-transfer-failed"
        return HostLinuxServiceAgentOpenV4(agent: Some(failed), error: failed.error)
    if opened.owner.is_none():
        # P2R1-F6: carry the root (unreachable path, see the factory) so the service owner still ends its loan.
        return HostLinuxServiceAgentOpenV4(root: opened.root,
            error: if opened.error != "": opened.error else: "linux-host-agent-transfer-owner-missing")
    var agent = shell
    agent.container = opened.owner
    # The root stays inside the fresh owner (few take/end twins); the agent takes it only at close (3.7 step 2).
    val first = host_agent_lifecycle_root_v4(input.template, nonce, 0)
    val rooted = simple_container_set_lifecycle_root_v3(agent.container.unwrap(), first)
    agent.container = Some(rooted.owner)
    if rooted.error != "":
        agent.stage = "failed"
        agent.error = rooted.error
        return HostLinuxServiceAgentOpenV4(agent: Some(agent), error: agent.error)
    var bound = input.template
    bound.root = first
    val valid = simple_container_validate_helper_template_v3(agent.container.unwrap(), bound)
    if valid.is_err():
        agent.stage = "failed"
        agent.error = "linux-host-agent-helper-template-invalid:" + valid.unwrap_err()
        return HostLinuxServiceAgentOpenV4(agent: Some(agent), error: agent.error)
    agent.stage = "probe-reserve"
    HostLinuxServiceAgentOpenV4(agent: Some(agent))

# `<pinned root>-<nonce>-w<index>`: distinct per lifecycle and per incarnation (r5 V-01).
fn host_agent_lifecycle_root_v4(template: GroupProcessStreamLaunchV2, nonce: text, index: i64) -> text:
    template.root + "-" + nonce + "-w" + index.to_text()

# ---- probe stages (3.4a) ----

fn host_agent_probe_call_v4(agent: HostLinuxServiceAgentV4, request: ContainerExecutionRequestV2,
        call: MachineFreshProbeCallV3) -> (HostLinuxServiceAgentV4, MachineFreshProbeReplyV3):
    var retained = agent
    val turn = simple_container_probe_v3(retained.container.unwrap(), request, call)
    retained.container = Some(turn.owner)
    (retained, turn.result)

fn host_agent_completion_v4(reply: MachineFreshProbeReplyV3) -> Result<(), text>:
    match reply:
        case MachineFreshProbeReplyV3.Completion(actual): actual
        case _: Err("linux-host-agent-probe-turn-mismatch")

fn host_agent_progress_v4(reply: MachineFreshProbeReplyV3) -> Result<bool, text>:
    match reply:
        case MachineFreshProbeReplyV3.Progress(actual): actual
        case _: Err("linux-host-agent-probe-turn-mismatch")

fn host_agent_probe_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val index = state.workload_index
    val built = host_linux_service_agent_probe_request_v4(input.execute.association.execution, input.manifest,
        input.provider, index)
    if built.is_err(): return host_agent_failed_v4(state, capacity, built.unwrap_err())
    val request = built.unwrap()
    val deadline = container_effect_deadline_v1(request.plan.request_digest, request.plan.operation_id,
        ["create", "start"], input.manifest.base.not_after)
    if deadline.is_err(): return host_agent_failed_v4(state, capacity, deadline.unwrap_err())
    if state.stage == "probe-reserve":
        if index > 0:
            val rooted = simple_container_set_lifecycle_root_v3(state.container.unwrap(),
                host_agent_lifecycle_root_v4(input.template, state.root_nonce, index))
            state.container = Some(rooted.owner)
            if rooted.error != "": return host_agent_failed_v4(state, capacity, rooted.error)
        val selected = host_agent_probe_call_v4(state, request, MachineFreshProbeCallV3.Select(request, input.provider, index))
        state = selected.0
        val accepted = host_agent_completion_v4(selected.1)
        # Select reserves the probe's own record; a refusal cannot prove no record exists: fail closed.
        state.probe_record = true
        if accepted.is_err(): return host_agent_wedged_v4(state, capacity, accepted.unwrap_err())
        state.stage = "probe-workflow"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "probe-workflow":
        val call = if state.pending: MachineFreshProbeCallV3.WorkflowStep
            else: MachineFreshProbeCallV3.WorkflowBegin(ContainerWorkspaceActionV3.Create, Some(deadline.unwrap()))
        val moved = host_agent_probe_call_v4(state, request, call)
        state = moved.0
        if not state.pending:
            val begun = host_agent_completion_v4(moved.1)
            if begun.is_err(): return host_agent_wedged_v4(state, capacity, begun.unwrap_err())
            state.pending = true
            return host_agent_pending_v4(state, capacity)
        val operation = match moved.1:
            case MachineFreshProbeReplyV3.Operation(result): result
            case _: Err("linux-host-agent-probe-turn-mismatch")
        if operation.is_err(): return host_agent_wedged_v4(state, capacity, operation.unwrap_err())
        if operation.unwrap().is_none(): return host_agent_pending_v4(state, capacity)
        if operation.unwrap().unwrap().status != RUNTIME_STATUS_OK:
            return host_agent_wedged_v4(state, capacity, "linux-host-agent-probe-create:" + operation.unwrap().unwrap().reason)
        state.pending = false
        state.stage = "probe-start"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "probe-start":
        val call = if state.pending: MachineFreshProbeCallV3.StartStep(false) else: MachineFreshProbeCallV3.Start(Some(deadline.unwrap()))
        val moved = host_agent_probe_call_v4(state, request, call)
        state = moved.0
        if not state.pending:
            val begun = host_agent_completion_v4(moved.1)
            if begun.is_err(): return host_agent_wedged_v4(state, capacity, begun.unwrap_err())
            state.pending = true
            return host_agent_pending_v4(state, capacity)
        val progressed = host_agent_progress_v4(moved.1)
        if progressed.is_err(): return host_agent_wedged_v4(state, capacity, progressed.unwrap_err())
        if not progressed.unwrap(): return host_agent_pending_v4(state, capacity)
        state.pending = false
        state.stage = "probe-collect"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "probe-collect": return host_agent_collect_step_v4(state, capacity, input, request)
    if state.stage == "probe-cleanup":
        val action = if state.cleanup_action == "absence": LinuxFreshWorkloadActionV2.Absence else: LinuxFreshWorkloadActionV2.Remove
        val call = if state.pending: MachineFreshProbeCallV3.CleanupStep(action, false) else: MachineFreshProbeCallV3.CleanupBegin(action)
        val moved = host_agent_probe_call_v4(state, request, call)
        state = moved.0
        if not state.pending:
            val begun = host_agent_completion_v4(moved.1)
            if begun.is_err(): return host_agent_wedged_v4(state, capacity, begun.unwrap_err())
            state.pending = true
            return host_agent_pending_v4(state, capacity)
        val progressed = host_agent_progress_v4(moved.1)
        if progressed.is_err(): return host_agent_wedged_v4(state, capacity, progressed.unwrap_err())
        if not progressed.unwrap(): return host_agent_pending_v4(state, capacity)
        state.pending = false
        if state.cleanup_action == "absence":
            state.cleanup_action = ""
            state.stage = "probe-settle"
        else:
            state.cleanup_action = "absence"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "probe-settle":
        if not state.probe_settle_read:
            val moved = host_agent_probe_call_v4(state, request, MachineFreshProbeCallV3.Settle)
            state = moved.0
            val settled = host_agent_completion_v4(moved.1)
            if settled.is_err(): return host_agent_wedged_v4(state, capacity, settled.unwrap_err())
            state.probe_record = false
            state.probe_settle_read = true
        # D19 (PR3): the probe lifecycle's released machine-charge row, replayed from the store by the transfer.
        # P3R1-F4: Settle is committed once `probe_settle_read` is set, so a refused read keeps the stage and
        # retries ONLY the read on the next call (never a second Settle), like stage `settle` below.
        val digest = simple_container_released_charge_digest_v3(state.container.unwrap())
        if digest.is_err(): return host_agent_turn_v4(state, capacity, "", digest.unwrap_err(), true)
        state.probe_settle_read = false
        state.probe_settles.push(digest.unwrap())
        state.stage = "probe-close"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "probe-close":
        state = host_agent_copy_helper_dirs_v4(state)
        val closed = simple_container_close_workload_v3(state.container.unwrap())
        if closed.is_err(): return host_agent_failed_v4(state, capacity, closed.unwrap_err())
        state.lifecycle_closed = true
        state.stage = "advance"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "advance":
        val advanced = simple_container_advance_workload_v3(state.container.unwrap())
        state.container = Some(advanced.owner)
        if advanced.error != "": return host_agent_failed_v4(state, capacity, advanced.error)
        state.lifecycle_closed = false
        state.workload_index = index + 1
        state.stage = if state.workload_index < state.probe_count: "probe-reserve" else: "selection"
        return host_agent_pending_v4(state, capacity)
    host_agent_failed_v4(state, capacity, "linux-host-agent-stage-invalid")

# The original collector deadline (30 s, monotonic) is fixed at begin; pp2 keeps it for every later step.
fn host_agent_collect_begin_v4(state: HostLinuxServiceAgentV4, input: HostAgentStepInputV4,
        request: ContainerExecutionRequestV2) -> ProviderCliContainedProbeTurnV2:
    val now = time_sample_monotonic_nanos_or_failure()
    if now <= 0 or now > 9223372036854775807 - HOST_AGENT_PROBE_TIMEOUT_MS_V4 * 1000000:
        return ProviderCliContainedProbeTurnV2(owner: state.container.unwrap(), probe: None, receipt: None,
            error: "linux-host-agent-probe-clock")
    provider_cli_profiled_probe_begin_v2(state.container.unwrap(), request, input.provider, state.workload_index,
        now + HOST_AGENT_PROBE_TIMEOUT_MS_V4 * 1000000)

# One collector step (pp2). The container moves into `collector` while a collection is in flight and comes
# back with the receipt; a collection that ends without one leaves the probe Unknown (pown:140/168/225): wedged.
fn host_agent_collect_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4, request: ContainerExecutionRequestV2) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    if state.collector.is_none() and state.container.is_none():
        return host_agent_failed_v4(state, capacity, "linux-host-agent-transfer-missing")
    val turn = if state.collector.is_some(): provider_cli_profiled_probe_step_v2(state.collector.unwrap(), false)
        else: host_agent_collect_begin_v4(state, input, request)
    state.container = None
    state.collector = turn.probe
    if turn.probe.is_none(): state.container = Some(turn.owner)
    if turn.receipt.is_some():
        state.receipts.push(turn.receipt.unwrap())
        state.stage = "probe-cleanup"
        state.cleanup_action = "remove"
        return host_agent_pending_v4(state, capacity)
    if turn.error != "" and turn.probe.is_none(): return host_agent_wedged_v4(state, capacity, turn.error)
    host_agent_pending_v4(state, capacity)

# 3.4 step 4: copy the action directories the current lifecycle's begins created, before its close or at agent
# close for a wedged lifecycle (deduplicated). Removal happens only after the epoch close, on exactly these paths.
fn host_agent_copy_helper_dirs_v4(agent: HostLinuxServiceAgentV4) -> HostLinuxServiceAgentV4:
    var state = agent
    var dirs: Result<[text], text> = Err("linux-host-agent-transfer-missing")
    if state.container.is_some(): dirs = simple_container_helper_dirs_v3(state.container.unwrap())
    elif state.fresh.is_some(): dirs = state.fresh.unwrap().helper_dirs_v3()
    if dirs.is_err(): return state
    for path in dirs.unwrap():
        if not state.helper_roots.contains(path): state.helper_roots.push(path)
    state

# ---- agent stages (3.4b) ----

fn host_agent_reservation_row_v4(input: HostAgentStepInputV4) -> (i64, i64, text):
    val row = input.execute.prepare.prepare.intent.reservation
    (row.cpu_millis, row.memory_bytes, row.id)

# U-01: V7's source bindings (awe:186-203) with the intent from the REAL selection, the association plan and the
# associated Host row. Runs before every non-running agent step.
fn host_agent_source_check_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> Result<(), text>:
    if agent.source.is_none() or agent.intent.is_none(): return Err("linux-host-agent-source-missing")
    val row = host_agent_reservation_row_v4(input)
    val projection = host_agent_workspace_source_projection_check_v2(agent.source.unwrap(),
        input.execute.association.execution.request_bytes, input.manifest, agent.intent.unwrap(),
        input.execute.association.execution.plan, row.0, row.1, input.execute.operation.duration_ms, capacity,
        input.execute.prepare.prepare.operation, row.2, "executing")?
    Ok(())

fn host_agent_grant_expiry_v4(execute: HostExecuteAssociatedRequestV3) -> i64:
    if execute.approval.expires_at < execute.signed.grant.expires_at: return execute.approval.expires_at
    execute.signed.grant.expires_at

# Check 3 (stage `selection`): the real selection reproduces the signed probe list and selection binding.
fn host_agent_selection_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val selection = provider_cli_profiled_selection_v2(input.provider, state.receipts)
    if selection.is_err(): return host_agent_failed_v4(state, capacity, selection.unwrap_err())
    val listed = provider_cli_profiled_probe_list_digest_v2(selection.unwrap())
    if listed.is_err(): return host_agent_failed_v4(state, capacity, listed.unwrap_err())
    if listed.unwrap() != input.execute.association.agent_probe_list_digest:
        return host_agent_failed_v4(state, capacity, "linux-host-agent-probe-list-mismatch")
    if selection.unwrap().binding_digest_v2() != input.manifest.base.selection_binding_digest:
        return host_agent_failed_v4(state, capacity, "linux-host-agent-selection-binding-mismatch")
    state.selection = Some(selection.unwrap())
    state.stage = "source"
    host_agent_pending_v4(state, capacity)

# Check 3a then the source open (stage `source`, on the AGENT lifecycle, before any agent record).
fn host_agent_source_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val container = state.container.unwrap()
    val resolved = host_agent_workspace_manifest_check_v2(input.manifest, input.execute.association.execution.plan,
        capacity.ledger.capacity, container, input.expected_provider, input.service_scope,
        input.clock.grant_clock, host_agent_grant_expiry_v4(input.execute))
    if resolved.is_err(): return host_agent_failed_v4(state, capacity, resolved.unwrap_err())
    val selection = state.selection.unwrap()
    val version = state.receipts[0].snapshot_v2()
    if version.is_err(): return host_agent_failed_v4(state, capacity, version.unwrap_err())
    val manifest = input.manifest.base
    val intent = build_provider_cli_interactive_intent_from_data_v1(selection.version_data_v2(), selection.binding_digest_v2(),
        version.unwrap().base, manifest.desired, resolved.unwrap(), manifest.task,
        ProviderCliCodexInteractiveRequestDataV1(prompt: manifest.task.content, model: manifest.task_use.model))
    if intent.is_err(): return host_agent_failed_v4(state, capacity, intent.unwrap_err())
    val scope_digest = container_host_scope_bytes_v2(simple_container_scope_v2(container))
    if scope_digest.is_err(): return host_agent_failed_v4(state, capacity, scope_digest.unwrap_err())
    val built = intent.unwrap()
    if (built.binding_digest != manifest.interactive_intent_digest or built.program_binding_digest != manifest.selection_binding_digest or
            built.image_config_id != manifest.image_config_id or sha256_text(built.scope_bytes) != sha256_text(scope_digest.unwrap()) or
            built.argv != manifest.inner_argv):
        return host_agent_failed_v4(state, capacity, "linux-host-agent-intent-mismatch")
    state.intent = Some(built)
    # R3 into the agent lifecycle (no record, source phase none), the agent root, then the source.
    val adopted = simple_container_adopt_lent_workspace_reader_v3(container)
    state.container = Some(adopted.owner)
    if adopted.error != "": return host_agent_failed_v4(state, capacity, adopted.error)
    val rooted = simple_container_set_lifecycle_root_v3(state.container.unwrap(),
        host_agent_lifecycle_root_v4(input.template, state.root_nonce, state.workload_index))
    state.container = Some(rooted.owner)
    if rooted.error != "": return host_agent_failed_v4(state, capacity, rooted.error)
    val opened = simple_container_workspace_source_open_installed_v3(state.container.unwrap(), input.execute.association.execution)
    state.container = Some(opened.owner)
    if opened.error != "" or opened.pending or opened.source.is_none():
        return host_agent_failed_v4(state, capacity, if opened.error != "": opened.error else: "linux-host-agent-source-open-pending")
    state.source = opened.source
    val checked = host_agent_source_check_v4(state, capacity, input)
    if checked.is_err(): return host_agent_failed_v4(state, capacity, checked.unwrap_err())
    state.stage = "stage"
    host_agent_pending_v4(state, capacity)

fn host_agent_runtime_match_v4(agent: HostLinuxServiceAgentV4, input: HostAgentStepInputV4, runtime: RuntimeIdentityV1) -> bool:
    val plan = input.execute.association.execution.plan
    val scope = ContainerHostScopeV2(physical_host_id: plan.physical_host_id, service_scope_id: plan.service_scope_id,
        boot_id: plan.boot_id, provider_generation: plan.provider_generation, native_machine_id: plan.native_machine_id,
        continuity_mode: plan.continuity_mode, continuity_id: plan.continuity_id)
    val fence = container_scope_fence_id_v2(scope)
    (fence.is_ok() and runtime.pod_uid == plan.workload_uid and runtime.attempt == plan.attempt and
        runtime.operation_id == plan.operation_id and runtime.provider_generation == plan.provider_generation and
        runtime.engine == "podman" and builder_digest_valid_v1(runtime.native_id) and runtime.node_boot_id == fence.unwrap() and
        (agent.created.is_none() or runtime == agent.created.unwrap()))

fn host_agent_observation_v4(agent: HostLinuxServiceAgentV4, input: HostAgentStepInputV4, container: SimpleContainerOwnerV2,
        operation: RuntimeOperationV1) -> Result<HostExecutionObservationV2, text>:
    val host = input.execute.prepare.prepare
    val epoch = simple_container_epoch_current_v3(container)?
    Ok(HostExecutionObservationV2(scope: simple_container_scope_v2(container), operation_id: host.operation.id,
        operation_digest: sha256_text(distributed_encode_operation_v2(host.operation)?), plan_digest: host.intent.plan_digest,
        request_digest: input.execute.association.execution.plan.request_digest, grant_id: input.execute.signed.grant.id,
        principal: input.execute.signed.grant.principal, issuer_id: input.execute.signed.issuer_id,
        approver_id: input.execute.approval.approver_id, provider_identity_digest: epoch.provider_identity_digest,
        observed_unix_ms: input.clock.grant_clock, observed_monotonic_ms: input.clock.monotonic_ms,
        runtime: operation.state.identity, phase: operation.state.phase, create_status: "ok", start_status: "ok",
        inspect_status: operation.status, reason: "V4 agent native primary observation; no readiness is inferred"))

fn host_agent_digest_fields_v4(kind: text, operation: RuntimeOperationV1) -> text:
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String(kind), "status": SdnValue.String(operation.status),
        "phase": SdnValue.String(operation.state.phase), "nativeId": SdnValue.String(operation.state.identity.native_id),
        "exitCode": SdnValue.Int(operation.state.exit_code)}
    sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)))

# Stages stage .. running (V4's own drivers, not V7's native step). After `enable` an agent record exists and,
# until association, a native error leaves it Unknown and unsettleable (F22): every effect error is `wedged`.
fn host_agent_native_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val request = input.execute.association.execution
    val manifest_bytes = agent_workspace_invocation_manifest_encode_v2(input.manifest)
    val digest = agent_workspace_invocation_manifest_digest_v2(input.manifest)
    if manifest_bytes.is_err() or digest.is_err(): return host_agent_failed_v4(state, capacity, "linux-host-agent-manifest-unsigned")
    if state.stage != "running" and not state.pending:
        val checked = host_agent_source_check_v4(state, capacity, input)
        if checked.is_err():
            if state.reserved: return host_agent_wedged_v4(state, capacity, checked.unwrap_err())
            return host_agent_failed_v4(state, capacity, checked.unwrap_err())
    if state.stage == "stage":
        val staged = state.source.unwrap().stage_agent_invocation_v2(request.request_bytes,
            input.manifest.base.workspace_manifest, digest.unwrap(), manifest_bytes.unwrap())
        state.source = Some(staged.loan)
        if staged.error != "" or not staged.ready:
            return host_agent_failed_v4(state, capacity, if staged.error != "": staged.error else: "linux-host-agent-stage-incomplete")
        state.stage = "enable"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "enable":
        # The agent's WorkspaceV3 record is reserved here (enable_workspace_source_v3 -> reserve_workspace_v3).
        val enabled = simple_container_enable_workspace_v3(state.container.unwrap(), request,
            input.manifest.base.workspace_manifest, digest.unwrap(), manifest_bytes.unwrap())
        state.container = Some(enabled.owner)
        state.reserved = true
        if enabled.error != "": return host_agent_wedged_v4(state, capacity, enabled.error)
        state.stage = "prepare"
        return host_agent_pending_v4(state, capacity)
    val action = match state.stage:
        case "prepare": ContainerWorkspaceActionV3.Prepare
        case "create": ContainerWorkspaceActionV3.Create
        case "configuration": ContainerWorkspaceActionV3.InputConfiguration
        case "start": ContainerWorkspaceActionV3.Start
        case "inspect": ContainerWorkspaceActionV3.Inspect
        case "running": ContainerWorkspaceActionV3.Inspect
        case _: return host_agent_wedged_v4(state, capacity, "linux-host-agent-stage-invalid")
    val deadline = container_effect_deadline_v1(request.plan.request_digest, request.plan.operation_id,
        ["create", "start"], input.manifest.base.not_after)
    if deadline.is_err(): return host_agent_wedged_v4(state, capacity, deadline.unwrap_err())
    val turn = if state.pending: simple_container_workspace_step_v3(state.container.unwrap(), request)
        else: simple_container_workspace_begin_v3(state.container.unwrap(), action, request,
            if state.stage == "running": None else: Some(deadline.unwrap()))
    state.container = Some(turn.owner)
    state.pending = turn.pending
    if turn.error != "": return host_agent_wedged_v4(state, capacity, turn.error)
    if state.pending: return host_agent_pending_v4(state, capacity)
    if turn.operation.is_none(): return host_agent_wedged_v4(state, capacity, "linux-host-agent-operation-missing")
    val operation = turn.operation.unwrap()
    if operation.status != RUNTIME_STATUS_OK:
        return host_agent_wedged_v4(state, capacity, "linux-host-agent-" + state.stage + ":" + operation.reason)
    if state.stage == "prepare": state.stage = "create"
    elif state.stage == "create":
        if operation.state.phase != RUNTIME_PHASE_CREATED or not host_agent_runtime_match_v4(state, input, operation.state.identity):
            return host_agent_wedged_v4(state, capacity, "linux-host-agent-created-identity")
        state.created = Some(operation.state.identity)
        val intent = simple_container_intent_v2(state.container.unwrap(), request)
        if intent.is_err(): return host_agent_wedged_v4(state, capacity, intent.unwrap_err())
        val stored = host_execution_intent_store_owned_v3(capacity.journal, intent.unwrap())
        if stored.is_err(): return host_agent_wedged_v4(state, capacity, stored.unwrap_err())
        state.stage = "configuration"
    elif state.stage == "configuration":
        val decoded = container_execution_input_configuration_decode_v1(operation.stdout)
        if decoded.is_err(): return host_agent_wedged_v4(state, capacity, decoded.unwrap_err())
        val observed = decoded.unwrap()
        var expected_argv = input.request.command
        for arg in input.request.args: expected_argv.push(arg)
        if (state.created.is_none() or observed.configuration.runtime != state.created.unwrap() or
                observed.configuration.scope != simple_container_scope_v2(state.container.unwrap()) or
                observed.configuration.request_digest != request.plan.request_digest or
                observed.configuration.requested_image_ref != input.request.image or
                observed.configuration.image_config_id != input.manifest.base.image_config_id or
                observed.configuration.primary_argv != expected_argv or
                observed.configuration.working_directory != input.request.working_directory or
                not observed.configuration.readonly_rootfs or not observed.open_stdin or not observed.tty or observed.stdin_once):
            return host_agent_wedged_v4(state, capacity, "linux-host-agent-effective-configuration-mismatch")
        state.stage = "start"
    elif state.stage == "start":
        if not host_agent_runtime_match_v4(state, input, operation.state.identity):
            return host_agent_wedged_v4(state, capacity, "linux-host-agent-started-identity")
        state.stage = "inspect"
    else:
        if not host_agent_runtime_match_v4(state, input, operation.state.identity):
            return host_agent_wedged_v4(state, capacity, "linux-host-agent-inspect-identity")
        if not state.observed:
            # Write-once observation artifact on the borrowed writer; not a ledger or row mutation.
            val observation = host_agent_observation_v4(state, input, state.container.unwrap(), operation)
            if observation.is_err(): return host_agent_wedged_v4(state, capacity, observation.unwrap_err())
            val saved = host_execution_observation_store_owned_v3(capacity.journal, observation.unwrap())
            if saved.is_err(): return host_agent_wedged_v4(state, capacity, saved.unwrap_err())
            state.observed = true
        state.stage = "running"
        # The workload left `running` (exited/stopped): the Inspect-observed exit keeps today's digest. The signed
        # window end is the other cause (14A F2: its own marker digest, no operation). The first cause is kept;
        # this Inspect has completed (pending false), so begin_stop may run now (D3).
        if operation.state.phase != RUNTIME_PHASE_RUNNING:
            state = host_agent_stop_cause_v4(state, if operation.state.exit_code == 0: "succeeded" else: "failed",
                host_agent_digest_fields_v4("linux-host-agent-exit", operation))
        if input.clock.grant_clock >= input.manifest.base.not_after:
            state = host_agent_stop_cause_v4(state, "failed",
                host_agent_window_end_digest_v4(input.manifest.base.not_after, state.clock_ms))
        if state.stop_requested: state = host_agent_begin_stop_v4(state, state.clock_ms)
    host_agent_pending_v4(state, capacity)

# ---- settle (3.6): machine release first, then ONE Host settle ----

fn host_agent_release_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val request = input.execute.association.execution
    if state.stage == "stopping":
        # F21: the source loan aliases custody that the source return releases; never used after this point.
        state.source = None
        val turn = if state.pending: simple_container_workspace_step_v3(state.container.unwrap(), request)
            else: simple_container_workspace_begin_v3(state.container.unwrap(), ContainerWorkspaceActionV3.Destroy, request, None)
        state.container = Some(turn.owner)
        state.pending = turn.pending
        if turn.error != "": return host_agent_wedged_v4(state, capacity, turn.error)
        if state.pending: return host_agent_pending_v4(state, capacity)
        if turn.operation.is_none(): return host_agent_wedged_v4(state, capacity, "linux-host-agent-destroy-missing")
        if turn.operation.unwrap().status != RUNTIME_STATUS_OK:
            return host_agent_wedged_v4(state, capacity, "linux-host-agent-destroy:" + turn.operation.unwrap().reason)
        state.destroy_digest = host_agent_digest_fields_v4("linux-host-agent-destroy", turn.operation.unwrap())
        state.stage = "settle"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "settle":
        # A refusal here precedes any write (T-01 gates): the stage resumes on the next call.
        val settled = simple_container_settle_workspace_v3(state.container.unwrap())
        if settled.is_err(): return host_agent_turn_v4(state, capacity, "", settled.unwrap_err(), true)
        # D19 (PR3): the released workspace charge row. The settle above is idempotent (settled -> Ok), so a
        # refused read resumes this stage on the next call.
        val charge = simple_container_released_charge_digest_v3(state.container.unwrap())
        if charge.is_err(): return host_agent_turn_v4(state, capacity, "", charge.unwrap_err(), true)
        state.machine_settle = charge.unwrap()
        state.stage = "source-return"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "source-return":
        val returned = simple_container_return_settled_workspace_source_v3(state.container.unwrap())
        if returned.is_err(): return host_agent_turn_v4(state, capacity, "", returned.unwrap_err(), true)
        state.stage = "host-settle"
        return host_agent_pending_v4(state, capacity)
    if state.stage == "host-settle": return host_agent_host_settle_v4(state, capacity, input)
    host_agent_wedged_v4(state, capacity, "linux-host-agent-stage-invalid")

pub fn host_linux_service_agent_outcome_v4(agent: HostLinuxServiceAgentV4, input: HostAgentStepInputV4) -> HostAgentOutcomeRecordV4:
    HostAgentOutcomeRecordV4(operation_id: input.execute.prepare.prepare.operation.id, fence: input.fence,
        association_digest: agent.association_digest, payload_digest: agent.payload_digest, outcome: agent.outcome,
        exit_observation_digest: agent.exit_digest, probe_settle_digests: agent.probe_settles,
        selection_binding_digest: input.manifest.base.selection_binding_digest, destroy_digest: agent.destroy_digest,
        absence_result: "absent", machine_settle_digest: agent.machine_settle, source_return: "returned")

fn host_agent_host_settle_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val evidence = host_agent_outcome_encode_v4(host_linux_service_agent_outcome_v4(state, input))
    if evidence.is_err(): return host_agent_turn_v4(state, capacity, "", evidence.unwrap_err(), true)
    val settled = host_capacity_owner_settle_associated_v3(capacity, input.execute.prepare.prepare.operation,
        input.execute.association, state.outcome, evidence.unwrap())
    # The returned journal owner is the single writer: adopted even on error.
    if settled.error != "": return host_agent_turn_v4(state, settled.owner, "", settled.error, true)
    state.stage = "settled"
    host_agent_turn_v4(state, settled.owner, host_linux_service_agent_reply_v4(state), "", true)

# Gate 1b (U-03): terminal ONLY when the row is `completed` with outcome digest == sha256(record bytes) and the
# record carries this payload digest. A record whose row is still `executing` resumes at `host-settle`.
fn host_agent_settled_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    var state = agent
    val operation = input.execute.prepare.prepare.operation
    val stored = distributed_operation_journal_read_v3(capacity.journal, host_agent_outcome_relative_v4(operation.id), 65536)
    if stored.is_err(): return host_agent_turn_v4(state, capacity, "", stored.unwrap_err(), false)
    if stored.unwrap().is_none():
        state.stage = "host-settle"
        return host_agent_host_settle_v4(state, capacity, input)
    val record = host_agent_outcome_decode_v4(stored.unwrap().unwrap())
    if record.is_err(): return host_agent_turn_v4(state, capacity, "", record.unwrap_err(), false)
    if record.unwrap().payload_digest != state.payload_digest:
        return host_agent_turn_v4(state, capacity, "", "linux-host-agent-invoke-conflict", false)
    val row = daemon_operation_exact_v2(capacity.journal, operation)
    if row.is_err(): return host_agent_turn_v4(state, capacity, "", row.unwrap_err(), false)
    if row.unwrap().state == "completed" and row.unwrap().outcome_digest == sha256_text(stored.unwrap().unwrap()):
        return host_agent_turn_v4(state, capacity, host_linux_service_agent_reply_v4(state), "", false)
    state.stage = "host-settle"
    host_agent_host_settle_v4(state, capacity, input)

# ---- primary attachment machine (milestone_0021 PR3b part 1: DESIGN 13.3, 14 tables T-A..T-G, 14A, 14B) ----

const HOST_AGENT_ATTACHMENT_INVARIANT_V4 = "linux-host-agent-attachment-invariant"
const HOST_AGENT_ATTACHMENT_BLOCKED_V4 = "linux-host-agent-attachment-release-blocked"
const HOST_AGENT_ATTACHMENT_PENDING_V4 = "linux-host-agent-attachment-release-pending"
const HOST_AGENT_ATTACHMENT_STALLED_V4 = "linux-host-agent-attachment-no-progress"
const HOST_AGENT_ATTACHMENT_EXPIRE_OVERDUE_V4 = "linux-host-agent-attachment-expire-overdue"

# 14A F2: the window-end stop marker (no Inspect operation exists for it).
fn host_agent_window_end_digest_v4(not_after: i64, clock_ms: i64) -> text:
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("linux-host-agent-window-end"),
        "notAfter": SdnValue.Int(not_after), "clockMs": SdnValue.Int(clock_ms)}
    sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)))

# F2/D3: the FIRST stop cause is fixed when `stop_requested` is first set (outcome + exit digest); later causes
# are ignored, so the begin_stop that follows needs no operation.
fn host_agent_stop_cause_v4(agent: HostLinuxServiceAgentV4, outcome: text, exit_digest: text) -> HostLinuxServiceAgentV4:
    var state = agent
    if not state.stop_requested:
        state.stop_requested = true
        state.outcome = outcome
        state.exit_digest = exit_digest
    state

# 13.3 + D1/D3/F4: the ONLY writer of `stopping`/`detach` from `running` (the F1 hook is the only other writer
# of `stopping`). A NO-OP unless the agent is running and no native step is pending, so `detach|stopping` are
# never entered with a pending Inspect (I2). A live attachment goes to `detach` with the grace bound (kept if
# later); none or a non-live one (RF/RT) goes straight to `stopping`.
# allow(primitive_api): reviewed agent clock DATA word (milestone_0021 14A F4, D7)
pub fn host_agent_begin_stop_v4(agent: HostLinuxServiceAgentV4, now: i64) -> HostLinuxServiceAgentV4:
    if agent.stage != "running" or agent.pending: return agent
    var state = agent
    if host_agent_attachment_live_v4(state.attachment):
        state.stage = "detach"
        state.attachment = Some(host_agent_attachment_arm_bound_v4(state.attachment.unwrap(),
            now + HOST_AGENT_DETACH_GRACE_MS_V4))
        return state
    state.stage = "stopping"
    state

# 14A F1: called by EVERY path that writes RT or RF (signed detach, step driver, close, expire). A `detach` agent
# whose attachment is no longer live moves to `stopping` in the same call (I3).
pub fn host_agent_after_release_write_v4(agent: HostLinuxServiceAgentV4) -> HostLinuxServiceAgentV4:
    var state = agent
    if state.stage == "detach" and not host_agent_attachment_live_v4(state.attachment): state.stage = "stopping"
    state

# D10: I1 (a live attachment only at running|detach|wedged|failed; and, T-G/F7, no attach state of any kind at
# a pre-running stage, since an attach is only admitted at `running`), I2 (`detach` never pending), I4 (RB only at
# wedged). I3 is restored by the hook; I5 holds by construction. "" when they hold.
fn host_agent_attachment_invariant_v4(agent: HostLinuxServiceAgentV4) -> text:
    val past_running = ["running", "detach", "wedged", "failed", "stopping", "settle", "source-return", "host-settle",
        "settled"].contains(agent.stage)
    if not past_running and (agent.attachment_consumed or agent.attachment.is_some() or agent.attachment_summary.is_some()):
        return HOST_AGENT_ATTACHMENT_INVARIANT_V4
    if val att = agent.attachment:
        if att.attach_stage == HOST_AGENT_ATTACH_BLOCKED_V4:
            if agent.stage == "wedged": return ""
            return HOST_AGENT_ATTACHMENT_INVARIANT_V4
        if (host_agent_attachment_live_v4(agent.attachment) and
                not ["running", "detach", "wedged", "failed"].contains(agent.stage)):
            return HOST_AGENT_ATTACHMENT_INVARIANT_V4
    if agent.stage == "detach" and agent.pending: return HOST_AGENT_ATTACHMENT_INVARIANT_V4
    ""

pub struct HostAgentAttachmentDriveV4:
    agent: HostLinuxServiceAgentV4
    acted: bool
    error: text
    # The capacity owner the release port advanced (13.5): the caller adopts it when Some (single writer).
    capacity: Option<HostCapacityOwnerV1> = None

fn host_agent_drive_v4(agent: HostLinuxServiceAgentV4, acted: bool, error: text) -> HostAgentAttachmentDriveV4:
    HostAgentAttachmentDriveV4(agent: agent, acted: acted, error: error)

# Writes the attachment back: `returned` becomes RT (attachment None, summary kept, final stage `failed` when the
# attach failed) and RT/RF run the F1 hook.
fn host_agent_attachment_write_v4(agent: HostLinuxServiceAgentV4, attachment: HostAgentAttachmentV4) -> HostLinuxServiceAgentV4:
    var state = agent
    if attachment.attach_stage == HOST_AGENT_ATTACH_RETURNED_V4:
        state.attachment = None
        state.attachment_summary = Some(HostAgentAttachmentSummaryV4(attach_digest: attachment.attach_digest,
            detach_digest: attachment.detach_digest,
            final_stage: if attachment.first_error == "": HOST_AGENT_ATTACH_RETURNED_V4 else: HOST_AGENT_ATTACH_FAILED_V4,
            error: attachment.first_error))
        return host_agent_after_release_write_v4(state)
    state.attachment = Some(attachment)
    if attachment.attach_stage == HOST_AGENT_ATTACH_REFUSED_V4: return host_agent_after_release_write_v4(state)
    state

# 13.3 DETACH BOUND -> `release-blocked` (TERMINAL) and stage `wedged` (I4). Never called while `pending`.
fn host_agent_attachment_block_v4(agent: HostLinuxServiceAgentV4, attachment: HostAgentAttachmentV4,
        error: text) -> HostLinuxServiceAgentV4:
    var state = agent
    var att = attachment
    if att.first_error == "": att.first_error = error
    att.attach_stage = HOST_AGENT_ATTACH_BLOCKED_V4
    att.attach_pending = false
    state.attachment = Some(att)
    if state.error == "": state.error = HOST_AGENT_ATTACHMENT_BLOCKED_V4
    state.stage = "wedged"
    state

# d1 REVOKE (13.4): epoch + 1 (the pane lease dies without an ack), stage `revoked`. Not progress (F4: from FL it
# is never progress); the bound is initialised here only when not already set.
fn host_agent_attachment_revoke_v4(agent: HostLinuxServiceAgentV4, attachment: HostAgentAttachmentV4,
        now: i64) -> HostAgentAttachmentDriveV4:
    var att = attachment
    att.lease_epoch = att.lease_epoch + 1
    att.attach_stage = HOST_AGENT_ATTACH_REVOKED_V4
    if not att.detach_bound: att = host_agent_attachment_arm_bound_v4(att, now + HOST_AGENT_DETACH_GRACE_MS_V4)
    host_agent_drive_v4(host_agent_attachment_write_v4(agent, att), true, "")

# P2-1: a non-advancing answer is counted; at the cap the attachment is RB (never while a native step is pending:
# I2, the count is re-checked on the next call after the drain).
fn host_agent_attachment_stalled_v4(agent: HostLinuxServiceAgentV4, attachment: HostAgentAttachmentV4) -> HostAgentAttachmentDriveV4:
    var att = attachment
    att.non_advancing = att.non_advancing + 1
    if att.non_advancing >= HOST_AGENT_NON_ADVANCING_LIMIT_V4 and not agent.pending:
        return host_agent_drive_v4(host_agent_attachment_block_v4(agent, att, HOST_AGENT_ATTACHMENT_STALLED_V4), true,
            HOST_AGENT_ATTACHMENT_STALLED_V4)
    host_agent_drive_v4(host_agent_attachment_write_v4(agent, att), true, "")

fn host_agent_attachment_blocked_v4(agent: HostLinuxServiceAgentV4, step: HostAgentAttachmentReleaseStepV4) -> HostAgentAttachmentDriveV4:
    var att = step.attachment
    if agent.pending:
        att.detach_refusals = att.detach_refusals + 1
        return host_agent_drive_v4(host_agent_attachment_write_v4(agent, att), true, step.error)
    host_agent_drive_v4(host_agent_attachment_block_v4(agent, att, step.error), true, step.error)

fn host_agent_attachment_refused_v4(agent: HostLinuxServiceAgentV4, step: HostAgentAttachmentReleaseStepV4,
        now: i64) -> HostAgentAttachmentDriveV4:
    var att = step.attachment
    att.detach_refusals = att.detach_refusals + 1
    val bound = att.detach_refusals >= HOST_AGENT_DETACH_REFUSAL_LIMIT_V4 or (att.detach_bound and now > att.detach_deadline_ms)
    if bound and not agent.pending:
        return host_agent_drive_v4(host_agent_attachment_block_v4(agent, att, step.error), true, step.error)
    host_agent_drive_v4(host_agent_attachment_write_v4(agent, att), true, step.error)

# The two uncounted waits (port contract, att PORT OBLIGATIONS): a wait while a native step is pending (D8, the
# step driver drains it first) and the RP `prepare-not-expired` wait (D2c), which is bounded by
# `prepare_deadline_ms + HOST_AGENT_EXPIRE_SLACK_MS_V4` (D2b): past it the receipt should long have expired, so
# the attachment is RB. Every other Wait is non-advancing.
fn host_agent_attachment_waited_v4(agent: HostLinuxServiceAgentV4, before: HostAgentAttachmentV4,
        step: HostAgentAttachmentReleaseStepV4, now: i64) -> HostAgentAttachmentDriveV4:
    if agent.pending: return host_agent_drive_v4(host_agent_attachment_write_v4(agent, step.attachment), true, "")
    if before.attach_stage == HOST_AGENT_ATTACH_EXPIRE_PENDING_V4:
        if now > before.prepare_deadline_ms + HOST_AGENT_EXPIRE_SLACK_MS_V4:
            return host_agent_drive_v4(host_agent_attachment_block_v4(agent, step.attachment, HOST_AGENT_ATTACHMENT_EXPIRE_OVERDUE_V4),
                true, HOST_AGENT_ATTACHMENT_EXPIRE_OVERDUE_V4)
        return host_agent_drive_v4(host_agent_attachment_write_v4(agent, step.attachment), true, "")
    host_agent_attachment_stalled_v4(agent, step.attachment)

# Progress counts only when it reaches a LATER sub-step (F4); the open core completing (OP -> RD, both rank 0) is
# one. A same-rank Progress is non-advancing (P2-1).
fn host_agent_attachment_progressed_v4(agent: HostLinuxServiceAgentV4, before: HostAgentAttachmentV4,
        step: HostAgentAttachmentReleaseStepV4, now: i64) -> HostAgentAttachmentDriveV4:
    var att = step.attachment
    val opened = before.attach_stage == HOST_AGENT_ATTACH_OPENING_V4 and att.attach_stage == HOST_AGENT_ATTACH_READY_V4
    if not opened and host_agent_attachment_rank_v4(att.attach_stage) <= host_agent_attachment_rank_v4(before.attach_stage):
        return host_agent_attachment_stalled_v4(agent, att)
    att.detach_refusals = 0
    att.non_advancing = 0
    if att.detach_bound: att.detach_deadline_ms = now + HOST_AGENT_DETACH_GRACE_MS_V4
    if opened:
        att.attach_pending = false
        att.ready_deadline_ms = now + HOST_AGENT_ATTACH_READY_MS_V4
    host_agent_drive_v4(host_agent_attachment_write_v4(agent, att), true, "")

# Folds one port answer back (D5/F4, P2-1): Progress to a LATER sub-step re-arms the deadline and resets both
# counters; a non-advancing answer counts toward the 64 cap; Refused counts and then checks 64 / the deadline;
# Blocked is RB. While a native step is pending nothing wedges.
fn host_agent_attachment_apply_v4(agent: HostLinuxServiceAgentV4, before: HostAgentAttachmentV4,
        step: HostAgentAttachmentReleaseStepV4, now: i64) -> HostAgentAttachmentDriveV4:
    match step.outcome:
        case HostAgentReleaseOutcomeV4.Blocked: host_agent_attachment_blocked_v4(agent, step)
        case HostAgentReleaseOutcomeV4.Refused: host_agent_attachment_refused_v4(agent, step, now)
        case HostAgentReleaseOutcomeV4.Wait: host_agent_attachment_waited_v4(agent, before, step, now)
        case HostAgentReleaseOutcomeV4.Progress: host_agent_attachment_progressed_v4(agent, before, step, now)

# The agent with the port's write-back folded in (13.4, I5): the container the port returned (lent for the
# call) replaces the agent's copy when Some.
fn host_agent_attachment_carrier_v4(agent: HostLinuxServiceAgentV4, answer: HostAgentAttachmentReleaseStepV4) -> HostLinuxServiceAgentV4:
    var state = agent
    if answer.container.is_some(): state.container = answer.container
    state

fn host_agent_drive_capacity_v4(driven: HostAgentAttachmentDriveV4, capacity: Option<HostCapacityOwnerV1>) -> HostAgentAttachmentDriveV4:
    var result = driven
    if capacity.is_some(): result.capacity = capacity
    result

# ONE attachment sub-step (13.4, D8). `release` forces d1 from RD/AD (signed detach, `detach`, wedged/failed);
# at `running` RD/AD revoke only on a lapsed ready/io deadline. FL first asks the port to CLASSIFY (read-only,
# F4/P3-2): charged-forever -> RB in this same call, else d1. OP/RP/RV/CL/ST go to the port.
fn host_agent_attachment_drive_step_v4(agent: HostLinuxServiceAgentV4, now: i64, release: bool,
        port: fn(HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4) -> HostAgentAttachmentDriveV4:
    if agent.attachment.is_none(): return host_agent_drive_v4(agent, false, "")
    val att = agent.attachment.unwrap()
    val stage = att.attach_stage
    if stage == HOST_AGENT_ATTACH_BLOCKED_V4 or stage == HOST_AGENT_ATTACH_REFUSED_V4:
        return host_agent_drive_v4(agent, false, "")
    if stage == HOST_AGENT_ATTACH_READY_V4 or stage == HOST_AGENT_ATTACH_ADOPTED_V4:
        val lapsed = (stage == HOST_AGENT_ATTACH_READY_V4 and now > att.ready_deadline_ms) or
            (stage == HOST_AGENT_ATTACH_ADOPTED_V4 and now > att.io_deadline_ms)
        if not release and agent.stage == "running" and not lapsed: return host_agent_drive_v4(agent, false, "")
        return host_agent_attachment_revoke_v4(agent, att, now)
    val answer = port(HostAgentAttachmentPortCallV4(attachment: att, now: now, pending: agent.pending,
        container: agent.container, release: release, runtime: agent.created))
    val carried = host_agent_attachment_carrier_v4(agent, answer)
    if stage == HOST_AGENT_ATTACH_FAILED_V4:
        match answer.outcome:
            case HostAgentReleaseOutcomeV4.Blocked:
                return host_agent_drive_capacity_v4(host_agent_attachment_blocked_v4(carried, answer), answer.capacity)
            case _: return host_agent_drive_capacity_v4(host_agent_attachment_revoke_v4(carried, att, now), answer.capacity)
    host_agent_drive_capacity_v4(host_agent_attachment_apply_v4(carried, att, answer, now), answer.capacity)

pub struct HostAgentAttachmentStepV4:
    agent: HostLinuxServiceAgentV4
    # true: the unchanged native/release driver runs next in this call (NATIVE cells of 14.2).
    native: bool
    error: text
    # The capacity owner the release port advanced; the caller adopts it when Some (13.5).
    capacity: Option<HostCapacityOwnerV1> = None

# E3 (14.2), the attachment half of the step driver, pure given the port. D9 order at `running`: (1) the window
# / stop check FIRST; (2) drain a pending native step; (3) one attachment sub-step; (4) the native Inspect,
# only when 1-3 did nothing and no attach sub-step is in flight. An invariant violation wedges and never Destroys.
# allow(primitive_api): reviewed grant clock / not_after DATA words (milestone_0021 14.1 D9, D7)
pub fn host_agent_attachment_step_v4(agent: HostLinuxServiceAgentV4, grant_clock: i64, not_after: i64,
        port: fn(HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4) -> HostAgentAttachmentStepV4:
    var state = agent
    if grant_clock > state.clock_ms: state.clock_ms = grant_clock
    state.not_after = not_after
    val now = state.clock_ms
    val broken = host_agent_attachment_invariant_v4(state)
    if broken != "":
        if state.error == "": state.error = broken
        state.stage = "wedged"
        state.pending = false
        return HostAgentAttachmentStepV4(agent: state, native: false, error: broken)
    # F1/I3: a `detach` agent with a non-live attachment advances to `stopping`; the release step runs next call.
    if state.stage == "detach" and not host_agent_attachment_live_v4(state.attachment):
        return HostAgentAttachmentStepV4(agent: host_agent_after_release_write_v4(state), native: false, error: "")
    if state.stage == "wedged" or state.stage == "failed":
        # T-F / H-29: one release step for a live attachment, then the stored error. RB never retries.
        if host_agent_attachment_live_v4(state.attachment):
            val released = host_agent_attachment_drive_step_v4(state, now, true, port)
            return HostAgentAttachmentStepV4(agent: released.agent, native: false, error: released.agent.error,
                capacity: released.capacity)
        return HostAgentAttachmentStepV4(agent: state, native: false, error: state.error)
    if state.stage == "detach":
        val driven = host_agent_attachment_drive_step_v4(state, now, true, port)
        return HostAgentAttachmentStepV4(agent: driven.agent, native: false, error: driven.error, capacity: driven.capacity)
    if state.stage != "running": return HostAgentAttachmentStepV4(agent: state, native: true, error: "")
    # A run with no live attachment keeps its final Inspect at the window end: the native Inspect step
    # records the exit first and the window end only when the workload still runs (m23 item 2).
    if grant_clock >= not_after and host_agent_attachment_live_v4(state.attachment):
        state = host_agent_stop_cause_v4(state, "failed", host_agent_window_end_digest_v4(not_after, now))
    if state.stop_requested and not state.pending:
        return HostAgentAttachmentStepV4(agent: host_agent_begin_stop_v4(state, now), native: false, error: "")
    if state.pending: return HostAgentAttachmentStepV4(agent: state, native: true, error: "")
    val driven = host_agent_attachment_drive_step_v4(state, now, false, port)
    if driven.acted:
        return HostAgentAttachmentStepV4(agent: driven.agent, native: false, error: driven.error, capacity: driven.capacity)
    if val att = state.attachment:
        if host_agent_attachment_in_flight_v4(att): return HostAgentAttachmentStepV4(agent: state, native: false, error: "")
    HostAgentAttachmentStepV4(agent: state, native: true, error: "")

# ---- signed attach / detach transitions (13.2, F5, F8, 14B) ----

# The transfer holder (13.0: attach has ONE holder, `container`).
pub fn host_agent_transfer_holder_v4(agent: HostLinuxServiceAgentV4) -> text:
    if agent.container.is_some(): return "container"
    if agent.fresh.is_some(): return "fresh"
    if agent.collector.is_some(): return "collector"
    "none"

# The PURE transition check (before any archive): invariant; stage running; not consumed (a failed attach is
# final per incarnation); no native step pending; holder `container`; not stopping (F8); then the facts.
pub fn host_agent_attach_check_core_v4(agent: HostLinuxServiceAgentV4, holder: text,
        facts: HostAgentAttachFactsV4) -> Result<(), text>:
    val broken = host_agent_attachment_invariant_v4(agent)
    if broken != "": return Err(broken)
    if agent.stage != "running": return Err("attach-stage")
    if agent.attachment_consumed or agent.attachment.is_some(): return Err("attach-consumed")
    if agent.pending: return Err("attach-native-pending")
    if holder != "container": return Err("attach-holder")
    if agent.stop_requested or agent.clock_ms >= facts.not_after: return Err("attach-stopping")
    host_agent_attach_facts_check_v4(facts, agent.operation_id)

# Gate order after the signature gates (13.2): the exact archived bytes are a REPLAY (Ok(true), answered from
# state via host_linux_service_agent_attachment_inspect_v4, never re-executed); otherwise the pure check (so a
# consumed slot answers `attach-consumed`); otherwise a different archived packet is `attach-packet-conflict`.
# Ok(false): archive no-replace + read-back next (host_agent_attach_apply_v4 does both, then consumes the slot).
pub fn host_agent_attach_admit_core_v4(agent: HostLinuxServiceAgentV4, holder: text, archived: Option<text>,
        source: text, facts: HostAgentAttachFactsV4) -> Result<bool, text>:
    if val prior = archived:
        if prior == source: return Ok(true)
    val checked = host_agent_attach_check_core_v4(agent, holder, facts)
    if checked.is_err(): return Err(checked.unwrap_err())
    host_agent_action_archive_check_v4(archived, source, "attach-packet-conflict")

# The controller-signed authority of an agent action (13.2): the installed snapshot, the configured controller,
# the archived signed execute and its association, and the live authorization context.
pub struct HostAgentActionAuthorityV4:
    snapshot: DistributedAuthoritySnapshotV2
    controller_ref: text
    execute_operation: OperationEnvelopeV2
    execute_association_digest: text
    context: HostReservationAuthorizationContextV1

# The service-owned inputs of an attach: the journal that holds the archive slot (its fence), the service's OWN
# live incarnation/epoch (14B), and the D7 stored inputs (not_after, policy bytes, helper store root).
pub struct HostAgentAttachServiceV4:
    journal: DistributedOperationJournalV2
    fence: text
    live_incarnation: text
    live_epoch: i64
    not_after: i64
    policy_bytes: text
    store_root: text
    # The monotonic clock of the receipt's prepare deadline (the agent clock is the grant clock; m23 P2-5).
    monotonic_ms: i64

# One composed action answer: `replay` = the exact archived bytes, answered from state (inspect), no effect.
pub struct HostAgentActionApplyV4:
    agent: HostLinuxServiceAgentV4
    replay: bool
    error: text
    # The capacity owner a detach's release step advanced; the caller adopts it when Some (13.5).
    capacity: Option<HostCapacityOwnerV1> = None

fn host_agent_action_refused_v4(agent: HostLinuxServiceAgentV4, error: text) -> HostAgentActionApplyV4:
    HostAgentActionApplyV4(agent: agent, replay: false, error: error)

# The archive was written AND read back (only host_agent_attach_apply_core_v4 calls this): the slot is consumed
# for this incarnation (never reset) and the attachment exists at `opening` with the D7/14B stored inputs; the
# effects (prepare, begin, open core) run from there through the release port (part 2) on the next E3.
fn host_agent_attach_archived_v4(agent: HostLinuxServiceAgentV4, request: HostAgentAttachRequestV4,
        parts: HostAgentAttachPartsV4, authority: HostAgentActionAuthorityV4, service: HostAgentAttachServiceV4,
        attach_digest: text) -> HostLinuxServiceAgentV4:
    var state = agent
    state.attachment_consumed = true
    state.attachment = Some(HostAgentAttachmentV4(parent: Some(authority.execute_operation), plan: Some(parts.plan),
        binding: Some(parts.binding), not_after: service.not_after, policy_bytes: service.policy_bytes,
        helper_request_bytes: request.helper_request, store_root: service.store_root,
        helper_execute_signed: Some(request.helper_execute_signed),
        helper_execute_approval: Some(request.helper_execute_approval), stream_policy: Some(parts.stream_policy),
        prepare_deadline_ms: host_agent_attach_grant_deadline_v4(parts.helper.intent.reservation.prepare_deadline_ms,
            state.clock_ms, service.monotonic_ms),
        attach_stage: HOST_AGENT_ATTACH_OPENING_V4,
        attach_pending: true, attach_digest: attach_digest))
    state

# 13.2 E1, the ONE composed attach entry, in the mandated order: decode; authorize (held run, association, the
# operation derived from the archived execute and the payload SIGNED over the packet's named digests, issuer,
# signatures); the helper prepare grant and the `host_helper_execute_v1` grant (same gates, part B); 14C
# `attach-binding-plan` (plan/binding bytes are the signed ones); the helper store opened, the Create runtime
# identity known and equal to the plan's (the open core reproduces the plan with it); read the archive slot;
# the pure transition check with replay/conflict; `admit`, the caller's read-only helper admission check on the
# service's capacity owner; archive no-replace + read-back; only THEN consume the slot and create the attachment.
# Any refusal before the read-back leaves the agent unchanged (the slot stays usable): every check that can
# refuse without an effect runs before the archive (milestone_0023 part B).
pub fn host_agent_attach_apply_core_v4(agent: HostLinuxServiceAgentV4, holder: text, source: text,
        authority: HostAgentActionAuthorityV4, service: HostAgentAttachServiceV4,
        admit: fn(HostHelperRequestV1) -> Result<(), text>) -> HostAgentActionApplyV4:
    val decoded = host_agent_attach_request_decode_v4(source)
    if decoded.is_err(): return host_agent_action_refused_v4(agent, decoded.unwrap_err())
    val request = decoded.unwrap()
    val split = host_agent_attach_request_parts_v4(request)
    if split.is_err(): return host_agent_action_refused_v4(agent, split.unwrap_err())
    val parts = split.unwrap()
    val granted = host_linux_service_agent_action_authorize_v4("host_agent_attach_v4", authority.snapshot,
        authority.controller_ref, request.operation_id, request.association_digest, request.operation, request.signed,
        request.approval, parts.payload_digest, authority.execute_operation, authority.execute_association_digest,
        agent.operation_id, agent.association_digest, authority.context)
    if granted.is_err(): return host_agent_action_refused_v4(agent, granted.unwrap_err())
    val helper_granted = host_agent_attach_helper_authorize_v4(authority.snapshot, authority.controller_ref, request, parts,
        authority.context)
    if helper_granted.is_err(): return host_agent_action_refused_v4(agent, helper_granted.unwrap_err())
    val paired = host_agent_attach_binding_plan_check_v4(request, parts)
    if paired.is_err(): return host_agent_action_refused_v4(agent, paired.unwrap_err())
    if service.store_root == "": return host_agent_action_refused_v4(agent, "attach-helper-store")
    if agent.created.is_none(): return host_agent_action_refused_v4(agent, "attach-runtime-missing")
    # The open core reproduces the plan with the observed runtime: a plan signed for another runtime identity could
    # only be refused there, after helper begin.
    if parts.plan.runtime != agent.created.unwrap(): return host_agent_action_refused_v4(agent, "attach-plan-runtime")
    val relative = host_agent_attach_archive_relative_v4(service.fence, agent.operation_id)
    val archived = distributed_operation_journal_read_v3(service.journal, relative, HOST_AGENT_ATTACH_MAX_BYTES_V4)
    if archived.is_err(): return host_agent_action_refused_v4(agent, archived.unwrap_err())
    val facts = host_agent_attach_facts_v4(parts, service.live_incarnation, service.live_epoch, service.not_after,
        agent.clock_ms, service.monotonic_ms)
    val admitted = host_agent_attach_admit_core_v4(agent, holder, archived.unwrap(), source, facts)
    if admitted.is_err(): return host_agent_action_refused_v4(agent, admitted.unwrap_err())
    if admitted.unwrap(): return HostAgentActionApplyV4(agent: agent, replay: true, error: "")
    val admissible = admit(parts.helper)
    if admissible.is_err(): return host_agent_action_refused_v4(agent, admissible.unwrap_err())
    val written = host_agent_action_archive_v4(service.journal, relative, source, "attach-packet-conflict")
    if written.is_err(): return host_agent_action_refused_v4(agent, written.unwrap_err())
    HostAgentActionApplyV4(agent: host_agent_attach_archived_v4(agent, request, parts, authority, service, sha256_text(source)),
        replay: false, error: "")

pub fn host_agent_attach_apply_v4(agent: HostLinuxServiceAgentV4, source: text, authority: HostAgentActionAuthorityV4,
        service: HostAgentAttachServiceV4, admit: fn(HostHelperRequestV1) -> Result<(), text>) -> HostAgentActionApplyV4:
    host_agent_attach_apply_core_v4(agent, host_agent_transfer_holder_v4(agent), source, authority, service, admit)

# ANY failure after the archive is FINAL (13.2): RF / RP / FL / RT per the writer rule, then the hook.
# allow(primitive_api): reviewed post-begin flag (milestone_0021 14.0, 14A F6)
pub fn host_agent_attach_failed_v4(agent: HostLinuxServiceAgentV4, error: text, post_begin: bool) -> HostLinuxServiceAgentV4:
    if agent.attachment.is_none(): return agent
    host_agent_attachment_write_v4(agent, host_agent_attachment_failure_v4(agent.attachment.unwrap(), error, post_begin,
        agent.clock_ms))

# The attach digest a detach packet must name (live attachment, else the kept summary).
pub fn host_agent_detach_attach_digest_v4(agent: HostLinuxServiceAgentV4) -> text:
    if val att = agent.attachment: return att.attach_digest
    if val kept = agent.attachment_summary: return kept.attach_digest
    ""

# E2 pure check (14.2, F5). `attach_digest` is the one the signed detach packet names: it must be this agent's
# attachment (`detach-attach-digest` otherwise). Ok(true): exact archived bytes, REPLAY (then the same REL step as
# E3); Ok(false): first packet (archive, then host_agent_detach_release_v4). Nothing is archived on Err.
pub fn host_agent_detach_check_v4(agent: HostLinuxServiceAgentV4, archived: Option<text>, source: text,
        attach_digest: text) -> Result<bool, text>:
    val broken = host_agent_attachment_invariant_v4(agent)
    if broken != "": return Err(broken)
    val exact = archived.is_some() and archived.unwrap() == source
    if agent.attachment.is_none():
        if agent.attachment_summary.is_none(): return Err("detach-unattached")
        if attach_digest != host_agent_detach_attach_digest_v4(agent): return Err("detach-attach-digest")
        if exact: return Ok(true)
        # F5: RT at running = released by the driver before stop; past running = the stage moved on.
        if agent.stage == "running": return Err("detach-unattached")
        return Err("detach-stage")
    val stage = agent.attachment.unwrap().attach_stage
    if stage == HOST_AGENT_ATTACH_REFUSED_V4: return Err("detach-unattached")
    if stage == HOST_AGENT_ATTACH_BLOCKED_V4: return Err("detach-stage")
    if stage == HOST_AGENT_ATTACH_EXPIRE_PENDING_V4: return Err("detach-pending-expire")
    if stage == HOST_AGENT_ATTACH_OPENING_V4: return Err("detach-attach-pending")
    if attach_digest != host_agent_detach_attach_digest_v4(agent): return Err("detach-attach-digest")
    if archived.is_some():
        if exact: return Ok(true)
        return Err("detach-stage")
    Ok(false)

# E2 effect: record the detach digest once and run ONE forced release step (d1 from RD/AD/FL, else resume).
pub fn host_agent_detach_release_v4(agent: HostLinuxServiceAgentV4, detach_digest: text,
        port: fn(HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4) -> HostAgentAttachmentDriveV4:
    if agent.attachment.is_none(): return host_agent_drive_v4(agent, false, "")
    var state = agent
    var att = state.attachment.unwrap()
    if att.detach_digest == "": att.detach_digest = detach_digest
    state.attachment = Some(att)
    host_agent_attachment_drive_step_v4(state, state.clock_ms, true, port)

# 13.2 E2, the ONE composed detach entry: decode; authorize (payload recomputed from the packet's own fields);
# the pure check, which binds the packet's attach digest to this agent's attachment; archive no-replace +
# read-back for a first packet (a replay is idempotent); then ONE forced release step (F5: a replay proceeds with
# the same REL step as E3).
pub fn host_agent_detach_apply_v4(agent: HostLinuxServiceAgentV4, source: text, authority: HostAgentActionAuthorityV4,
        journal: DistributedOperationJournalV2, fence: text,
        port: fn(HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4) -> HostAgentActionApplyV4:
    val decoded = host_agent_detach_request_decode_v4(source)
    if decoded.is_err(): return host_agent_action_refused_v4(agent, decoded.unwrap_err())
    val request = decoded.unwrap()
    val granted = host_linux_service_agent_action_authorize_v4("host_agent_detach_v4", authority.snapshot,
        authority.controller_ref, request.operation_id, request.association_digest, request.operation, request.signed,
        request.approval, host_agent_detach_payload_digest_v4(request.operation_id, request.association_digest,
            request.attach_digest), authority.execute_operation, authority.execute_association_digest,
        agent.operation_id, agent.association_digest, authority.context)
    if granted.is_err(): return host_agent_action_refused_v4(agent, granted.unwrap_err())
    val relative = host_agent_detach_archive_relative_v4(fence, agent.operation_id)
    val archived = distributed_operation_journal_read_v3(journal, relative, HOST_AGENT_DETACH_MAX_BYTES_V4)
    if archived.is_err(): return host_agent_action_refused_v4(agent, archived.unwrap_err())
    val checked = host_agent_detach_check_v4(agent, archived.unwrap(), source, request.attach_digest)
    if checked.is_err(): return host_agent_action_refused_v4(agent, checked.unwrap_err())
    if not checked.unwrap():
        val written = host_agent_action_archive_v4(journal, relative, source, "detach-stage")
        if written.is_err(): return host_agent_action_refused_v4(agent, written.unwrap_err())
    val driven = host_agent_detach_release_v4(agent, sha256_text(source), port)
    HostAgentActionApplyV4(agent: driven.agent, replay: checked.unwrap(), error: driven.error, capacity: driven.capacity)

# 13.5 C2 verdict for close (part 2 runs the release step first): "" = continue the existing close; RB ->
# `attachment-release-blocked` immediately (D6); any other live attachment -> `attachment-release-pending`.
pub fn host_agent_attachment_close_verdict_v4(agent: HostLinuxServiceAgentV4) -> text:
    val broken = host_agent_attachment_invariant_v4(agent)
    if broken != "": return broken
    if not host_agent_attachment_live_v4(agent.attachment): return ""
    if agent.attachment.unwrap().attach_stage == HOST_AGENT_ATTACH_BLOCKED_V4: return HOST_AGENT_ATTACHMENT_BLOCKED_V4
    HOST_AGENT_ATTACHMENT_PENDING_V4

pub struct HostAgentAttachmentCloseV4:
    agent: HostLinuxServiceAgentV4
    error: text
    capacity: Option<HostCapacityOwnerV1> = None

# 13.5 C2 (pure given the port; part 2's close_v4 calls it after `owner.closed = true` and BEFORE the wedged
# return): RB answers `attachment-release-blocked` with no retry (D6); a live attachment gets ONE forced release
# step (expire for RP, the open core for OP, else REL) and then the verdict; "" lets the existing close continue.
pub fn host_agent_attachment_close_v4(agent: HostLinuxServiceAgentV4,
        port: fn(HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4) -> HostAgentAttachmentCloseV4:
    val first = host_agent_attachment_close_verdict_v4(agent)
    if first == "" or first == HOST_AGENT_ATTACHMENT_BLOCKED_V4 or first == HOST_AGENT_ATTACHMENT_INVARIANT_V4:
        return HostAgentAttachmentCloseV4(agent: agent, error: first)
    val driven = host_agent_attachment_drive_step_v4(agent, agent.clock_ms, true, port)
    HostAgentAttachmentCloseV4(agent: driven.agent, error: host_agent_attachment_close_verdict_v4(driven.agent),
        capacity: driven.capacity)

# 13.2 inspect/progress: read-only, never runs release.
pub fn host_linux_service_agent_attachment_inspect_v4(agent: HostLinuxServiceAgentV4) -> text:
    host_agent_attachment_report_v4(agent.operation_id, agent.attachment, agent.attachment_summary)

# The service inspect's report: the same read-only report plus the terminal-authority verdict ("" omits it).
pub fn host_linux_service_agent_attachment_authority_inspect_v4(agent: HostLinuxServiceAgentV4, terminal_authority: text) -> text:
    host_agent_attachment_authority_report_v4(agent.operation_id, agent.attachment, agent.attachment_summary, terminal_authority)

# ---- agent-terminal authority (milestone_0023 part B; consumed by the smux pane consumer and the rights lane) ----

# The controller-signed authority behind an attach-ready attachment, as verified NOW: which run and attachment,
# who issued it (always the configured controller), under which grant and snapshot generation, until when, and
# the verified pane binding with the live lease epoch. DATA: holding one grants nothing by itself, and it is never
# cached (every read verifies again).
pub struct HostAgentTerminalAuthorityV4:
    operation_id: text
    association_digest: text
    attach_digest: text
    issuer_id: text
    grant_id: text
    expires_at: i64
    snapshot_generation: i64
    binding: HostAgentPaneBindingV4
    lease_epoch: i64

# Read-only and pure given the archived attach packet bytes: the agent runs with a `ready` or `adopted`
# attachment; the archived packet is exactly the one that attachment was created from; it still passes the SAME
# gates as at attach and as cancel (held run, association, operation derived under the LIVE context, issuer ==
# controller, issuer + approver signatures, clock, generation, revocation: an expired or revoked approval is
# refused); its plan/binding bytes are the signed ones; and the binding names the service's OWN live incarnation
# and epoch. Anything else is Err. Pane or smux state is never consulted.
# allow(primitive_api): reviewed live epoch DATA word (milestone_0021 14B)
pub fn host_agent_terminal_authority_v4(agent: HostLinuxServiceAgentV4, archived: Option<text>,
        authority: HostAgentActionAuthorityV4, live_incarnation: text,
        live_epoch: i64) -> Result<HostAgentTerminalAuthorityV4, text>:
    val broken = host_agent_attachment_invariant_v4(agent)
    if broken != "": return Err(broken)
    if agent.stage != "running": return Err("attach-stage")
    if agent.attachment.is_none(): return Err("attach-no-attachment")
    val att = agent.attachment.unwrap()
    if att.attach_stage != HOST_AGENT_ATTACH_READY_V4 and att.attach_stage != HOST_AGENT_ATTACH_ADOPTED_V4:
        return Err("attach-not-ready")
    if archived.is_none(): return Err("attach-unarchived")
    if sha256_text(archived.unwrap()) != att.attach_digest: return Err("attach-packet-conflict")
    val request = host_agent_attach_request_decode_v4(archived.unwrap())?
    val parts = host_agent_attach_request_parts_v4(request)?
    val grant = host_linux_service_agent_action_authorize_v4("host_agent_attach_v4", authority.snapshot,
        authority.controller_ref, request.operation_id, request.association_digest, request.operation, request.signed,
        request.approval, parts.payload_digest, authority.execute_operation, authority.execute_association_digest,
        agent.operation_id, agent.association_digest, authority.context)?
    host_agent_attach_binding_plan_check_v4(request, parts)?
    host_agent_pane_binding_live_check_v4(parts.binding, live_incarnation, live_epoch)?
    Ok(HostAgentTerminalAuthorityV4(operation_id: agent.operation_id, association_digest: agent.association_digest,
        attach_digest: att.attach_digest, issuer_id: request.signed.issuer_id, grant_id: grant.id,
        expires_at: if request.approval.expires_at < grant.expires_at: request.approval.expires_at else: grant.expires_at,
        snapshot_generation: authority.snapshot.generation, binding: parts.binding, lease_epoch: att.lease_epoch))

# ---- pane lease and pane io (13.1, D9, F3) ----

pub struct HostAgentPaneLeaseTurnV4:
    agent: HostLinuxServiceAgentV4
    lease: Option<HostAgentPaneLeaseV4>
    error: text

fn host_agent_pane_gate_v4(agent: HostLinuxServiceAgentV4) -> text:
    val broken = host_agent_attachment_invariant_v4(agent)
    if broken != "": return broken
    if agent.attachment.is_none():
        if agent.attachment_summary.is_some(): return "attach-lease-revoked"
        return "attach-no-attachment"
    val stage = agent.attachment.unwrap().attach_stage
    # 14.2 E4 column order: RB, then `detach` (T-C RP too), then RF/RP, then wedged/failed (T-F OP..FL).
    if stage == HOST_AGENT_ATTACH_BLOCKED_V4: return "attach-lease-revoked"
    if agent.stage == "detach": return "attach-detaching"
    if stage == HOST_AGENT_ATTACH_REFUSED_V4 or stage == HOST_AGENT_ATTACH_EXPIRE_PENDING_V4: return "attach-no-attachment"
    if agent.stage == "wedged" or agent.stage == "failed": return "attach-agent-wedged"
    if stage == HOST_AGENT_ATTACH_OPENING_V4: return "attach-not-ready"
    if stage != HOST_AGENT_ATTACH_READY_V4 and stage != HOST_AGENT_ATTACH_ADOPTED_V4: return "attach-lease-revoked"
    ""

# The pane lease, handed out ONCE per attachment (second -> attach-lease-held).
pub fn host_linux_service_agent_attachment_lease_v4(agent: HostLinuxServiceAgentV4) -> HostAgentPaneLeaseTurnV4:
    val gate = host_agent_pane_gate_v4(agent)
    if gate != "": return HostAgentPaneLeaseTurnV4(agent: agent, lease: None, error: gate)
    var state = agent
    var att = state.attachment.unwrap()
    if att.lease_issued: return HostAgentPaneLeaseTurnV4(agent: agent, lease: None, error: "attach-lease-held")
    att.lease_issued = true
    state.attachment = Some(att)
    HostAgentPaneLeaseTurnV4(agent: state, lease: Some(host_agent_pane_lease_v4(state.operation_id, att.lease_epoch,
        att.attach_digest)), error: "")

pub struct HostAgentPaneIoTurnV4:
    agent: HostLinuxServiceAgentV4
    result: HostAgentPaneIoResultV4

fn host_agent_pane_refused_v4(agent: HostLinuxServiceAgentV4, error: text) -> HostAgentPaneIoTurnV4:
    HostAgentPaneIoTurnV4(agent: agent, result: host_agent_pane_io_refused_v4(error))

# D9: ResizePoll needs a geometry owner; Resize starts one only when none is held (one at a time, H-36); Write
# shape bounds (H-37). "" = shape accepted.
fn host_agent_pane_write_error_v4(write: HostAgentPaneWriteV4) -> text:
    match host_agent_pane_write_check_v4(write):
        case Ok(_): ""
        case Err(reason): reason

fn host_agent_pane_shape_v4(op: HostAgentPaneOpV4, attachment: HostAgentAttachmentV4) -> text:
    match op:
        case HostAgentPaneOpV4.Read: ""
        case HostAgentPaneOpV4.ResizePoll: if attachment.geometry.is_none(): "attach-no-geometry" else: ""
        case HostAgentPaneOpV4.Resize(_): if attachment.geometry.is_some(): "attach-geometry-busy" else: ""
        case HostAgentPaneOpV4.Write(write): host_agent_pane_write_error_v4(write)

# The pane io gate (13.1, D9, F3), pure given the io port. The gate and the lease (epoch/fingerprint against the
# attachment's OWN epoch) run FIRST on the incoming agent: a refusal there returns the agent UNCHANGED (13.1: an
# epoch mismatch leaves state unchanged; a stale or forged lease cannot advance clock_ms or set stop_requested).
# Only then does `now` advance the agent clock and the signed window apply (lapsed -> refuse and set
# stop_requested; step 1 owns begin_stop). The first accepted op moves ready -> adopted; every accepted op renews
# io_deadline_ms; eof is sticky. The attachment is written back through the F1-hook writer.
# allow(primitive_api): reviewed pane clock DATA word (milestone_0021 14A F3)
pub fn host_agent_pane_io_core_v4(agent: HostLinuxServiceAgentV4, lease: HostAgentPaneLeaseV4, op: HostAgentPaneOpV4, now: i64,
        io: fn(HostAgentPaneIoCallV4) -> HostAgentPaneIoPortTurnV4) -> HostAgentPaneIoTurnV4:
    val gate = host_agent_pane_gate_v4(agent)
    if gate != "": return host_agent_pane_refused_v4(agent, gate)
    var att = agent.attachment.unwrap()
    if (not att.lease_issued or lease.operation_id != agent.operation_id or lease.epoch != att.lease_epoch or
            lease.fingerprint != host_agent_pane_lease_v4(agent.operation_id, att.lease_epoch, att.attach_digest).fingerprint):
        return host_agent_pane_refused_v4(agent, "attach-lease-revoked")
    var state = agent
    if now > state.clock_ms: state.clock_ms = now
    if state.clock_ms >= att.not_after or state.stop_requested:
        if state.clock_ms >= att.not_after:
            state = host_agent_stop_cause_v4(state, "failed", host_agent_window_end_digest_v4(att.not_after, state.clock_ms))
        return host_agent_pane_refused_v4(state, "attach-stopping")
    val shape = host_agent_pane_shape_v4(op, att)
    if shape != "": return host_agent_pane_refused_v4(state, shape)
    val turn = io(HostAgentPaneIoCallV4(attachment: att, op: op, now: state.clock_ms, container: state.container))
    att = turn.attachment
    var result = turn.result
    if result.eof: att.eof = true
    result.eof = att.eof
    if result.error == "":
        if att.attach_stage == HOST_AGENT_ATTACH_READY_V4: att.attach_stage = HOST_AGENT_ATTACH_ADOPTED_V4
        att.io_deadline_ms = state.clock_ms + HOST_AGENT_PANE_IO_MS_V4
    HostAgentPaneIoTurnV4(agent: host_agent_attachment_write_v4(state, att), result: result)

# allow(primitive_api): reviewed pane clock DATA word (milestone_0021 14A F3)
pub fn host_linux_service_agent_pane_io_v4(agent: HostLinuxServiceAgentV4, lease: HostAgentPaneLeaseV4, op: HostAgentPaneOpV4, now: i64) -> HostAgentPaneIoTurnV4:
    val io = fn(call: HostAgentPaneIoCallV4) -> HostAgentPaneIoPortTurnV4: host_agent_pane_io_port_v4(call)
    host_agent_pane_io_core_v4(agent, lease, op, now, io)

# ---- one bounded step per call ----

# 13.5: the store is HostHelperStoreV1(helper_store, Some(capacity.journal)) from the service owner. The attachment
# half runs first (E3 of 14.2) through the production step-driver port (release + the attach effects); the capacity
# owner it advanced is adopted for the rest of the call and returned in the turn (single journal writer).
# milestone_0023 part B: `policy`, `scope` and `refresh` are the service's installed policy, live scope and clock
# refresh for helper prepare/begin; the open context is rebuilt on every call from them and the archived signed
# execute in `input` (the parent is the journal row's prepare operation).
pub fn host_linux_service_agent_step_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4, store: HostHelperStoreV1, policy: LocalAuthorityPolicyV1, scope: ContainerHostScopeV2,
        refresh: fn() -> HostReservationAuthorizationContextV1) -> HostLinuxServiceAgentTurnV4:
    val context = HostAgentReleaseContextV4(capacity: capacity, store: store, monotonic_ms: input.clock.monotonic_ms)
    val open = HostAgentOpenContextV4(policy: policy, scope: scope, context: input.clock,
        parent: input.execute.prepare.prepare.operation, execution: input.execute.association.execution)
    val port = fn(call: HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4: host_agent_attachment_open_step_v4(call, context, open, refresh)
    val pre = host_agent_attachment_step_v4(agent, input.clock.grant_clock, input.manifest.base.not_after, port)
    var current = capacity
    if pre.capacity.is_some(): current = pre.capacity.unwrap()
    if not pre.native:
        if pre.agent.stage == "wedged" or pre.agent.stage == "failed":
            var error = pre.agent.error
            if pre.error != "": error = pre.error
            return host_agent_turn_v4(pre.agent, current, "", error, true)
        if pre.error != "": return host_agent_turn_v4(pre.agent, current, "", pre.error, true)
        return host_agent_pending_v4(pre.agent, current)
    return host_agent_dispatch_v4(pre.agent, current, input)

# The existing stage dispatch (13.0 :961-975); `detach` and wedged/failed are fully handled above.
fn host_agent_dispatch_v4(agent: HostLinuxServiceAgentV4, capacity: HostCapacityOwnerV1,
        input: HostAgentStepInputV4) -> HostLinuxServiceAgentTurnV4:
    val stage = agent.stage
    if stage == "settled": return host_agent_settled_v4(agent, capacity, input)
    if agent.container.is_none() and stage != "probe-collect":
        return host_agent_failed_v4(agent, capacity, "linux-host-agent-transfer-missing")
    if stage.starts_with("probe-") or stage == "advance": return host_agent_probe_step_v4(agent, capacity, input)
    if stage == "selection": return host_agent_selection_step_v4(agent, capacity, input)
    if stage == "source": return host_agent_source_step_v4(agent, capacity, input)
    if (stage == "stopping" or stage == "settle" or stage == "source-return" or stage == "host-settle"):
        return host_agent_release_step_v4(agent, capacity, input)
    host_agent_native_step_v4(agent, capacity, input)

# ---- cancel (milestone_0021 PR3: the re-pointed V7 cancel handler, D21) ----

pub struct HostLinuxServiceAgentCancelV4:
    agent: HostLinuxServiceAgentV4
    response: text
    error: text
    effect_attempted: bool

# P3R1-F5: the exit marker is bound to the digest of the controller-signed cancel packet that caused it, so the
# outcome record carries signed evidence of why the run failed (still not an observed runtime exit).
fn host_agent_cancel_digest_v4(agent: HostLinuxServiceAgentV4, cancel_digest: text) -> text:
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("linux-host-agent-cancelled"),
        "operationId": SdnValue.String(agent.operation_id), "associationDigest": SdnValue.String(agent.association_digest),
        "cancelDigest": SdnValue.String(cancel_digest)}
    sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)))

# Cancel is a state transition only (no container, journal or clock): a running, idle agent takes the same exit the
# signed window's end takes (stage `stopping`, outcome `failed`), and the step driver then runs Destroy and the 3.6
# settle on later invoke calls. From `stopping` on it is a no-op. A pending running step and every earlier stage
# are refused unchanged: their machine records settle through their own stages, bounded by the signed window.
pub fn host_linux_service_agent_request_cancel_v4(agent: HostLinuxServiceAgentV4, cancel_digest: text) -> HostLinuxServiceAgentCancelV4:
    var state = agent
    if not builder_digest_valid_v1(cancel_digest):
        return HostLinuxServiceAgentCancelV4(agent: state, response: "", error: "linux-host-agent-cancel-digest", effect_attempted: false)
    val broken = host_agent_attachment_invariant_v4(state)
    if broken != "": return HostLinuxServiceAgentCancelV4(agent: state, response: "", error: broken, effect_attempted: false)
    if state.stage == "wedged" or state.stage == "failed":
        return HostLinuxServiceAgentCancelV4(agent: state, response: "",
            error: if state.error != "": state.error else: "linux-host-agent-" + state.stage, effect_attempted: true)
    # PR3b (13.3): `detach` is treated like `stopping` (idempotent, first cause kept).
    if ["detach", "stopping", "settle", "source-return", "host-settle", "settled"].contains(state.stage):
        return HostLinuxServiceAgentCancelV4(agent: state, response: host_linux_service_agent_reply_v4(state), error: "",
            effect_attempted: false)
    if state.stage != "running":
        return HostLinuxServiceAgentCancelV4(agent: state, response: "", error: "linux-host-agent-cancel-stage:" + state.stage,
            effect_attempted: false)
    if state.pending:
        return HostLinuxServiceAgentCancelV4(agent: state, response: "", error: "linux-host-agent-cancel-pending",
            effect_attempted: false)
    # PR3b (D3/D7): the cancel is the stop cause (first cause kept) and begin_stop moves the idle running agent to
    # `stopping`, or to `detach` when a live attachment must release first; `now` is the agent's own clock.
    state = host_agent_stop_cause_v4(state, "failed", host_agent_cancel_digest_v4(state, cancel_digest))
    state = host_agent_begin_stop_v4(state, state.clock_ms)
    HostLinuxServiceAgentCancelV4(agent: state, response: host_linux_service_agent_reply_v4(state), error: "",
        effect_attempted: false)

# ---- staged close (3.7), agent half ----

fn host_agent_close_reply_v4(agent: HostLinuxServiceAgentV4, capacity: Option<HostCapacityOwnerV1>, closed: bool,
        error: text) -> HostLinuxServiceAgentCloseV4:
    HostLinuxServiceAgentCloseV4(agent: agent, capacity: capacity, closed: closed, error: error)

# Steps 0, 2, 3. Step 1 (3.6) is the step driver's: a reserved agent record that is not settled keeps the
# agent open and the close pending (the Host row stays executing and drains at reopen). The transfer, custody,
# R2, N's lender and the authority stay in the holder.
# PR3b (13.5) order: C1 collector close; C2 ONE attachment release step BEFORE the wedged return (release-blocked
# -> attachment-release-blocked, any other live attachment -> attachment-release-pending, and nothing later
# runs); C3 wedged; C4 settle-pending; C5 probe record; C6 root loan end; C7 workload close. Close takes
# the caller's REAL monotonic clock for the RP expire (m23 P2-4: a constant would answer `prepare-not-expired`
# forever once no step driver runs). C2 runs only for a LIVE attachment (m23 P2-3): a refused one holds nothing.
# `capacity` is needed only for C2 (an attachment); a retried close after the service released it still runs C3..C7.
# allow(primitive_api): reviewed monotonic clock DATA word (m23 P2-4)
pub fn host_linux_service_agent_close_v4(agent: HostLinuxServiceAgentV4, capacity: Option<HostCapacityOwnerV1>,
        store: HostHelperStoreV1, monotonic_ms: i64) -> HostLinuxServiceAgentCloseV4:
    var state = agent
    var current = capacity
    if state.workload_closed: return host_agent_close_reply_v4(state, current, true, "")
    var turns = 0
    while state.collector.is_some() and turns < 64:
        val turn = provider_cli_profiled_probe_step_v2(state.collector.unwrap(), true)
        state.collector = turn.probe
        if turn.probe.is_none():
            state.container = Some(turn.owner)
            # A cancel mid-collection turns the probe Unknown (pown:140/168/225): no clean probe settle.
            state.stage = "wedged"
            if state.error == "": state.error = "linux-host-agent-collection-cancelled"
        turns = turns + 1
    if state.collector.is_some(): return host_agent_close_reply_v4(state, current, false, "linux-host-agent-collector-close-pending")
    state = host_agent_copy_helper_dirs_v4(state)
    # The invariant verdict runs for ANY attachment (a broken one stops the close); only a LIVE one needs C2.
    val broken = host_agent_attachment_invariant_v4(state)
    if broken != "": return host_agent_close_reply_v4(state, current, false, broken)
    if host_agent_attachment_live_v4(state.attachment):
        if current.is_none(): return host_agent_close_reply_v4(state, current, false, "linux-host-service-acquisition-incomplete")
        val context = HostAgentReleaseContextV4(capacity: current.unwrap(), store: store, monotonic_ms: monotonic_ms)
        val port = fn(call: HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4: host_agent_attachment_release_step_v4(call, context)
        val released = host_agent_attachment_close_v4(state, port)
        state = released.agent
        if released.capacity.is_some(): current = released.capacity
        if released.error != "": return host_agent_close_reply_v4(state, current, false, released.error)
    if state.stage == "wedged": return host_agent_close_reply_v4(state, current, false, "linux-host-agent-wedged")
    if state.reserved and state.stage != "settled": return host_agent_close_reply_v4(state, current, false, "linux-host-agent-settle-pending")
    # An unsettled probe record is never closed from here (fail closed).
    if state.probe_record: return host_agent_close_reply_v4(state, current, false, "linux-host-agent-probe-settle-pending")
    # Step 2 (*): end the workspace-root loan BEFORE the workload close (the borrow aliases R3).
    if val held = state.container:
        val taken = simple_container_take_workspace_root_v3(held)
        state.container = Some(taken.owner)
        if taken.root.is_some():
            state.root = taken.root
    elif val held = state.fresh:
        val taken = held.take_workspace_root_v3()
        state.fresh = Some(taken.owner)
        if taken.root.is_some():
            state.root = taken.root
    if val root = state.root:
        if val held = state.container:
            val ended = simple_container_end_workspace_root_loan_v3(held, root)
            state.container = Some(ended.owner)
            state.root = ended.root
            if ended.error != "": return host_agent_close_reply_v4(state, current, false, ended.error)
        elif val held = state.fresh:
            val ended = held.end_workspace_root_loan_v3(root)
            state.fresh = Some(ended.owner)
            state.root = ended.root
            if ended.error != "": return host_agent_close_reply_v4(state, current, false, ended.error)
        state.root = None
    # Step 3. A lifecycle already closed by `probe-close` and not yet advanced has nothing left to close.
    if not state.lifecycle_closed:
        var closed: Result<(), text> = Err("linux-host-agent-transfer-missing")
        if state.container.is_some(): closed = simple_container_close_workload_v3(state.container.unwrap())
        elif state.fresh.is_some(): closed = state.fresh.unwrap().close_workload_v3()
        if closed.is_err(): return host_agent_close_reply_v4(state, current, false, closed.unwrap_err())
        state.lifecycle_closed = true
    state.workload_closed = true
    host_agent_close_reply_v4(state, current, true, "")

pub struct HostLinuxServiceAgentReleaseV4:
    agent: Option<HostLinuxServiceAgentV4>
    native: Option<LinuxServiceNativeIdentityBorrowV3>
    released: bool
    error: text

# Service close steps 3-4 and 6 (3.7): end the service loan on the transfer's admission, close the epoch
# (authority, R2, never-adopted R3, custody, phase closed), then remove exactly the copied helper roots. A
# failed removal is residue only (reported, not fatal). The agent is dropped only once the epoch close completed.
pub fn host_linux_service_agent_release_v4(agent: HostLinuxServiceAgentV4,
        native: Option<LinuxServiceNativeIdentityBorrowV3>) -> HostLinuxServiceAgentReleaseV4:
    var state = agent
    if not state.workload_closed:
        return HostLinuxServiceAgentReleaseV4(agent: Some(state), native: native, released: false,
            error: "linux-host-agent-close-pending")
    if state.container.is_none() and state.fresh.is_none():
        return HostLinuxServiceAgentReleaseV4(agent: Some(state), native: native, released: false,
            error: "linux-host-agent-transfer-missing")
    # Step 3, once: the service loan. After it ends the borrow is consumed (native None) and a failed epoch
    # close below is retried on the next close without it (P2R1-F2).
    if not state.loan_ended:
        if native.is_none():
            return HostLinuxServiceAgentReleaseV4(agent: Some(state), native: None, released: false,
                error: "linux-host-service-loan-borrow-missing")
        var ended_error = ""
        if val held = state.container:
            val ended = simple_container_end_service_loan_v3(held, native.unwrap())
            state.container = Some(ended.owner)
            ended_error = ended.error
        elif val held = state.fresh:
            val ended = held.end_service_loan_v3(native.unwrap())
            state.fresh = Some(ended.owner)
            ended_error = ended.error
        if ended_error != "":
            return HostLinuxServiceAgentReleaseV4(agent: Some(state), native: native, released: false, error: ended_error)
        state.loan_ended = true
    # Step 4: the epoch close (retryable).
    var closed = false
    var error = ""
    if val held = state.container:
        val turn = simple_container_close_epoch_v3(held)
        state.container = turn.owner
        closed = turn.closed and turn.owner.is_none()
        error = turn.error
    elif val held = state.fresh:
        val turn = held.close_v2()
        state.fresh = turn.owner
        closed = turn.closed and turn.owner.is_none()
        error = turn.error
    if not closed:
        return HostLinuxServiceAgentReleaseV4(agent: Some(state), native: None, released: false,
            error: if error != "": error else: "linux-host-agent-epoch-close-pending")
    var residue = ""
    for path in state.helper_roots:
        if not dir_remove_all(path) and residue == "": residue = "linux-host-agent-helper-root-residue:" + path
    HostLinuxServiceAgentReleaseV4(agent: None, native: None, released: true, error: residue)

