# Compatibility is shape-only: verify each original signed plan hash before
# conversion. Never rewrite the reservation intent or archived packet bytes.
use std.common.contracts.orchestration.host_execute_request_v2.{HostExecuteRequestV2, host_execute_request_decode_v2}
use std.common.contracts.orchestration.host_execute_request_v1.host_execute_request_decode_v1
use std.common.contracts.orchestration.host_reservation_codec_v1.{HostReservationIntentV1, HostPreparedReservationReceiptV1}
use std.common.contracts.orchestration.linux_launch_plan_v1.host_linux_launch_plan_digest_v1
use std.common.contracts.container.execution_v2.{ContainerExecutionPlanV2, ContainerExecutionRequestV2, ContainerHostScopeV2, container_execution_plan_digest_v2, container_scope_fence_id_v2}
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}

pub struct HostExecutionEnvelopeV2:
    legacy_v1: bool
    intent: HostReservationIntentV1
    operation: OperationEnvelopeV2
    receipt: HostPreparedReservationReceiptV1
    execution: ContainerExecutionRequestV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn host_execution_decode_v2(payload: text, scope: ContainerHostScopeV2) -> Result<HostExecutionEnvelopeV2, text>:
    val current = host_execute_request_decode_v2(payload)
    if current.is_ok():
        val request = current.unwrap()
        if container_execution_plan_digest_v2(request.execution.plan)? != request.intent.plan_digest:
            return Err("host-execution-original-plan-mismatch")
        val plan = request.execution.plan
        val packet_scope = ContainerHostScopeV2(physical_host_id: plan.physical_host_id, service_scope_id: plan.service_scope_id,
            boot_id: plan.boot_id, provider_generation: plan.provider_generation, native_machine_id: plan.native_machine_id,
            continuity_mode: plan.continuity_mode, continuity_id: plan.continuity_id)
        val fence = container_scope_fence_id_v2(scope)?
        if container_scope_fence_id_v2(packet_scope)? != fence or request.intent.fence.boot_id != fence:
            return Err("host-execution-trusted-scope-mismatch")
        return Ok(HostExecutionEnvelopeV2(legacy_v1: false, intent: request.intent, operation: request.operation,
            receipt: request.receipt, execution: request.execution, signed: request.signed, approval: request.approval))
    val historical = host_execute_request_decode_v1(payload)
    if historical.is_err(): return Err("host-execution-envelope-invalid:" + current.unwrap_err())
    val request = historical.unwrap()
    if host_linux_launch_plan_digest_v1(request.plan)? != request.intent.plan_digest:
        return Err("host-execution-original-plan-mismatch")
    val scope_checked = container_scope_fence_id_v2(scope)?
    if (scope.continuity_mode != "native-boot-incarnation-v1" or scope.boot_id != request.plan.boot_id or
            scope.boot_id != request.intent.fence.boot_id or scope.physical_host_id != request.plan.physical_host_id or
            scope.service_scope_id != request.plan.service_scope_id or scope.provider_generation != request.plan.provider_generation):
        return Err("host-execution-legacy-scope-mismatch")
    # This common plan is an execution adapter. Its hash is intentionally NOT
    # substituted for the original signed V1 plan digest in the reservation.
    val plan = ContainerExecutionPlanV2(backend: "linux-podman", workload_uid: request.plan.workload_uid,
        attempt: request.plan.attempt, operation_id: request.operation.id, request_digest: request.plan.request_digest,
        physical_host_id: request.plan.physical_host_id, service_scope_id: request.plan.service_scope_id,
        boot_id: request.plan.boot_id, provider_generation: request.plan.provider_generation, native_machine_id: scope.native_machine_id,
        continuity_mode: scope.continuity_mode, continuity_id: scope.continuity_id)
    val execution = ContainerExecutionRequestV2(plan: plan, request_bytes: request.request_bytes)
    Ok(HostExecutionEnvelopeV2(legacy_v1: true, intent: request.intent, operation: request.operation,
        receipt: request.receipt, execution: execution, signed: request.signed, approval: request.approval))
