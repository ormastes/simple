use std.nogc_sync_mut.daemon_sdk.framed_io_v1.daemon_read_frame_v1
use std.common.base_encoding.utilities.validated_utf8_bytes_to_text_linear
use std.common.contracts.orchestration.host_prepare_request_v1.host_prepare_request_decode_v1
# Trusted service composition: snapshots and clocks are supplied by the local
# service owner, never decoded from a remote request. No listener/enrollment here.
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.orchestration.host_reservation_codec_v1.HostReservationIntentV1
use std.common.contracts.orchestration.host_reservation_codec_v1.host_reservation_receipt_v1
use std.common.contracts.orchestration.host_prepare_response_v1.host_prepare_response_encode_v1
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.{DistributedAuthoritySnapshotV2, distributed_verify_grant_approval_from_snapshot_v2}
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.*

pub struct HostPreparedReplyV1:
    owner: HostCapacityOwnerV1
    response: text

# Precompute the deterministic reply before admission so a serialization failure
# cannot discard an updated owner. Transport delivery is a subsequent operation:
# the service must retain result.owner even when its response write fails.
pub fn host_authorized_prepare_reply_v1(owner: HostCapacityOwnerV1, payload: text,
        snapshot: DistributedAuthoritySnapshotV2, expected_generation: i64,
        context: HostReservationAuthorizationContextV1,
        refresh_context: fn() -> HostReservationAuthorizationContextV1) -> Result<HostPreparedReplyV1, text>:
    val request = host_prepare_request_decode_v1(payload)?
    val receipt = host_reservation_receipt_v1(request.intent, request.operation)?
    val response = host_prepare_response_encode_v1(receipt, request.intent, request.operation)?
    val prepared = host_authorized_prepare_v1(owner, request.intent, request.operation,
        request.signed, request.approval, snapshot, expected_generation, context, refresh_context)?
    Ok(HostPreparedReplyV1(owner: prepared, response: response))

# @workaround bug=runner_callback_field_owner_2026_10_11 reason=retain nominal context after indirect record return; explicit local annotation alone fails
fn host_authorization_context_owner_v1(value: HostReservationAuthorizationContextV1) -> HostReservationAuthorizationContextV1:
    value

pub fn host_authorized_prepare_v1(owner: HostCapacityOwnerV1,
        intent: HostReservationIntentV1, operation: OperationEnvelopeV2,
        signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2,
        snapshot: DistributedAuthoritySnapshotV2, expected_generation: i64,
        context: HostReservationAuthorizationContextV1,
        refresh_context: fn() -> HostReservationAuthorizationContextV1) -> Result<HostCapacityOwnerV1, text>:
    # Verify exact request bytes and both distinct publisher roles before any
    # reservation payload, journal event or capacity mutation is published.
    val grant = distributed_verify_grant_approval_from_snapshot_v2(snapshot, signed,
        approval, operation, context.grant_clock, expected_generation,
        context.policy_revision, context.revocation_epoch, context.session_generation)?
    val fresh = host_authorization_context_owner_v1(refresh_context())
    if fresh.grant_clock < context.grant_clock or fresh.monotonic_ms < context.monotonic_ms:
        return Err("host-authorization-clock-regressed")
    if fresh.policy_revision != context.policy_revision or fresh.revocation_epoch != context.revocation_epoch or
            fresh.session_generation != context.session_generation:
        return Err("host-authorization-context-changed")
    if approval.expires_at <= fresh.grant_clock: return Err("APPROVAL_EXPIRED")
    if grant.expires_at <= fresh.grant_clock: return Err("GRANT_EXPIRED")
    host_capacity_owner_prepare_v1(owner, intent, operation, grant, fresh)

# Only the bounded request payload is untrusted. Service state is supplied from
# protected composition, never from additional request fields or file paths.
pub fn host_authorized_prepare_request_v1(owner: HostCapacityOwnerV1, payload: text,
        snapshot: DistributedAuthoritySnapshotV2, expected_generation: i64,
        context: HostReservationAuthorizationContextV1,
        refresh_context: fn() -> HostReservationAuthorizationContextV1) -> Result<HostCapacityOwnerV1, text>:
    val request = host_prepare_request_decode_v1(payload)?
    host_authorized_prepare_v1(owner, request.intent, request.operation, request.signed,
        request.approval, snapshot, expected_generation, context, refresh_context)

# The service supplies the owned, deadline-bounded transport reader. Framing
# does not authenticate a peer; signed request admission remains mandatory.
pub fn host_authorized_prepare_stream_v1(owner: HostCapacityOwnerV1,
        read: fn(i64) -> Result<[u8], text>, snapshot: DistributedAuthoritySnapshotV2,
        expected_generation: i64, context: HostReservationAuthorizationContextV1,
        refresh_context: fn() -> HostReservationAuthorizationContextV1) -> Result<HostCapacityOwnerV1, text>:
    val bytes = daemon_read_frame_v1(read, 1048576)?
    val payload = validated_utf8_bytes_to_text_linear(bytes)?
    host_authorized_prepare_request_v1(owner, payload, snapshot, expected_generation, context, refresh_context)
