# SAME protected-journal historical correlation. No path opens, publication,
# launch, repaired metadata, live stream/lease decoder or fresh permission.
use std.common.task_runner.distributed_operation_journal_v2.{DistributedOperationJournalV2,
    distributed_operation_journal_read_v3, distributed_operation_journal_read_required_v3,
    distributed_operation_journal_lookup_v2, distributed_operation_journal_linux_current_v3}
use std.common.contracts.orchestration.host_broker_recovery_policy_v1.HostBrokerRecoveryDomainV1
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.{distributed_decode_operation_v2, distributed_encode_operation_v2}
use std.common.contracts.orchestration.host_reservation_codec_v1.{host_helper_reservation_receipt_v1, host_reservation_encode_intent_v1}
use std.common.contracts.container.stream_v2.*
use std.common.contracts.container.execution_v2.ContainerHostScopeV2
use std.common.contracts.container.primary_attach_v1.container_primary_attach_admission_validate_v1
use std.common.contracts.container.effect_deadline_v1.container_effect_deadline_v1
use std.common.build_manager.grouped_execution_contract.GroupedActionLeaseV1
use std.common.build_manager.group_process_stream_protocol_v2.{group_process_stream_launch_decode_profiled_v3,
    group_process_stream_launch_encode_profiled_v3}
use std.nogc_sync_mut.orchestration.host_helper_stream_record_v1.*
use std.nogc_sync_mut.orchestration.host_primary_attach_record_v1.{host_primary_attach_consumed_decode_v1,
    host_primary_attach_consumed_encode_v1, host_primary_attach_native_match_v1}
use std.nogc_sync_mut.orchestration.host_helper_settlement_receipt_v1.host_helper_stream_native_match_v1
use std.nogc_sync_mut.orchestration.host_helper_request_v1.*
use std.nogc_sync_mut.io.group_process_owner.GroupProcessStreamOwnerV2
use std.nogc_sync_mut.io.group_process_recovery_owner_v3.GroupProcessStreamRecoveryOwnerV3
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

pub struct HostBrokerRecoveryRecordsV7:
    operation: OperationEnvelopeV2
    journal_state: text
    domain: HostBrokerRecoveryDomainV1
    scope: ContainerHostScopeV2
    identity: ContainerOutputIdentityV2
    stream_policy_digest: text
    native: GroupProcessStreamOwnerV2
    lease: GroupedActionLeaseV1
    request_digest: text
    prepared_receipt_digest: text
    consumption_digest: text
    settlement_kind: text
    settlement_category: text

fn broker_record_read_v7(journal: DistributedOperationJournalV2, id: text, category: text) -> Result<text, text>:
    distributed_operation_journal_read_required_v3(journal, "host-helper-stream-" + category + "/" + sha256_text(id) + ".sdn", 8388608)

fn broker_admission_v7(journal: DistributedOperationJournalV2, operation: OperationEnvelopeV2,
        id: text, operation_digest: text, packet_digest: text, proof_digest: text,
        receipt_digest: text, deadline_ms: i64) -> Result<HostHelperAdmissionContextV1, text>:
    if id != operation.id or operation_digest != sha256_text(distributed_encode_operation_v2(operation)?):
        return Err("helper-stream-original-operation-mismatch")
    val request = host_helper_request_load_owned_v2(journal, id)?
    if (distributed_encode_operation_v2(request.operation)? != distributed_encode_operation_v2(operation)? or
            sha256_text(host_helper_request_encode_v1(request)?) != packet_digest): return Err("helper-stream-retained-request-mismatch")
    # Correlate both actual same-journal reservation parents, not packet DTOs.
    val helper_payload = distributed_operation_journal_read_required_v3(journal, "reservation-payloads/" + operation.payload_digest + ".sdn", 65536)?
    if helper_payload != host_reservation_encode_intent_v1(request.intent)?: return Err("broker-helper-retained-intent")
    val parent = request.parent_binding.host_operation
    val parent_row = distributed_operation_journal_lookup_v2(journal, parent.id)?
    if parent_row.envelope != distributed_encode_operation_v2(parent)?: return Err("broker-helper-retained-parent")
    val parent_payload = distributed_operation_journal_read_required_v3(journal, "reservation-payloads/" + parent.payload_digest + ".sdn", 65536)?
    if parent_payload != host_reservation_encode_intent_v1(request.parent_binding.host_intent)?: return Err("broker-helper-retained-parent-intent")
    val proof_bytes = host_helper_execution_proof_load_owned_v2(journal, id)?
    if sha256_text(proof_bytes) != proof_digest: return Err("helper-stream-execution-proof-mismatch")
    val proof = host_helper_execution_proof_decode_v1(request, proof_bytes)?
    val receipt = host_helper_reservation_receipt_v1(request.intent, operation)?
    if receipt.receipt_digest != receipt_digest: return Err("helper-stream-prepared-receipt-mismatch")
    var expiry = proof.signed.grant.expires_at
    for bound in [proof.approval.expires_at, request.budget_proof.signed.grant.expires_at, request.budget_proof.approval.expires_at]:
        if bound < expiry: expiry = bound
    if expiry != deadline_ms: return Err("helper-stream-retained-deadline-mismatch")
    val deadline = container_effect_deadline_v1(request.plan.request_digest, operation.id, ["attach"], expiry)?
    val admission = ContainerHelperAdmissionV2(intent: request.intent, plan: request.plan, operation: operation, receipt: receipt,
        deadline: deadline, grant_id: proof.signed.grant.id, issuer_id: proof.signed.issuer_id, approver_id: proof.approval.approver_id,
        cpu_millis: request.intent.reservation.cpu_millis, memory_bytes: request.intent.reservation.memory_bytes)
    Ok(HostHelperAdmissionContextV1(request, proof, admission))

pub fn host_broker_recovery_records_load_v7(journal: DistributedOperationJournalV2, id: text,
        domain: HostBrokerRecoveryDomainV1) -> Result<HostBrokerRecoveryRecordsV7, text>:
    distributed_operation_journal_linux_current_v3(journal)?
    val row = distributed_operation_journal_lookup_v2(journal, id)?
    val operation = distributed_decode_operation_v2(row.envelope)?
    if operation.operation != "host_helper_reservation_v1" or not ["executing", "outcome-unknown", "completed"].contains(row.state):
        return Err("broker-recovery-original-helper-obligation-required")
    val key = sha256_text(id) + ".sdn"
    val output = distributed_operation_journal_read_v3(journal, "host-helper-stream-consumed/" + key, 8388608)?
    val primary = distributed_operation_journal_read_v3(journal, "host-helper-stream-primary-consumed/" + key, 8388608)?
    val connection = distributed_operation_journal_read_v3(journal, "primary-connection-consumed/" + key, 8388608)?
    if connection.is_some() or (output.is_some() and primary.is_some()): return Err("helper-settlement-domain-ambiguous")
    var source = ""
    var policy_digest = ""
    var identity: Option<ContainerOutputIdentityV2> = None
    var scope: Option<ContainerHostScopeV2> = None
    var context: Option<HostHelperAdmissionContextV1> = None
    var category = ""
    var kind = ""
    var request_digest = ""
    match domain:
        case HostBrokerRecoveryDomainV1.OutputFollow:
            if output.is_none() or primary.is_some(): return Err("helper-settlement-domain-missing-or-mismatch")
            val consumed = host_helper_stream_consumed_decode_v1(output.unwrap())?
            source = host_helper_stream_consumed_encode_v1(consumed)?
            val checked = broker_admission_v7(journal, operation, consumed.operation_id, consumed.operation_digest,
                consumed.packet_digest, consumed.execution_proof_digest, consumed.prepared_receipt_digest, consumed.deadline_unix_ms)?
            val matched = container_output_admission_validate_v2(consumed.output_plan, checked.admission)?
            context = Some(checked)
            identity = Some(consumed.output_plan.identity)
            val workload = consumed.output_plan.workload
            scope = Some(ContainerHostScopeV2(workload.physical_host_id, workload.service_scope_id, workload.boot_id,
                workload.provider_generation, workload.native_machine_id, workload.continuity_mode, workload.continuity_id))
            policy_digest = consumed.output_plan.policy_digest
            request_digest = container_output_plan_digest_v2(consumed.output_plan)?
            category = "native"
            kind = "host-helper-stream-native"
        case HostBrokerRecoveryDomainV1.PrimaryAttach:
            if primary.is_none() or output.is_some(): return Err("helper-settlement-domain-missing-or-mismatch")
            val consumed = host_primary_attach_consumed_decode_v1(primary.unwrap())?
            source = host_primary_attach_consumed_encode_v1(consumed)?
            val checked = broker_admission_v7(journal, operation, consumed.operation_id, consumed.operation_digest,
                consumed.packet_digest, consumed.execution_proof_digest, consumed.prepared_receipt_digest, consumed.deadline_unix_ms)?
            val matched = container_primary_attach_admission_validate_v1(consumed.primary_plan, checked.admission)?
            context = Some(checked)
            identity = Some(consumed.primary_plan.identity)
            val workload = consumed.primary_plan.workload
            scope = Some(ContainerHostScopeV2(workload.physical_host_id, workload.service_scope_id, workload.boot_id,
                workload.provider_generation, workload.native_machine_id, workload.continuity_mode, workload.continuity_id))
            policy_digest = consumed.primary_plan.policy_digest
            request_digest = consumed.primary_plan.request_digest
            category = "primary-native"
            kind = "host-primary-attach-native"
    val admission = context.unwrap()
    val native_source = broker_record_read_v7(journal, id, category)?
    val fields = host_helper_stream_fields_v1(native_source, kind, ["version", "kind", "operationDigest", "consumptionDigest", "identityDigest", "launch"])?
    if (host_helper_stream_text_v1(fields, "operationDigest")? != sha256_text(distributed_encode_operation_v2(operation)?) or
            host_helper_stream_text_v1(fields, "consumptionDigest")? != sha256_text(source)):
        return Err("broker-recovery-native-consumption-mismatch")
    val launch_source = host_helper_stream_text_v1(fields, "launch")?
    val launch = group_process_stream_launch_decode_profiled_v3(launch_source)?
    if group_process_stream_launch_encode_profiled_v3(launch) != launch_source: return Err("broker-recovery-native-launch-noncanonical")
    val native = GroupProcessStreamOwnerV2(launch: launch, identity_digest: host_helper_stream_text_v1(fields, "identityDigest")?)
    match domain:
        case HostBrokerRecoveryDomainV1.OutputFollow:
            val consumed = host_helper_stream_consumed_decode_v1(source)?
            host_helper_stream_native_match_v1(HostHelperStreamContextV1(consumed, admission.request, admission.proof, admission.admission), native)?
        case HostBrokerRecoveryDomainV1.PrimaryAttach:
            host_primary_attach_native_match_v1(host_primary_attach_consumed_decode_v1(source)?, native)?
    val lease = GroupedActionLeaseV1(group_id: admission.request.plan.parent_operation_id, action_id: id, worker_id: id,
        generation: admission.request.plan.scope.provider_generation, lease_id: admission.admission.receipt.receipt_digest,
        snapshot_digest: native.launch.snapshot_digest, cache_identity: native.launch.cache_identity, completed: true)
    Ok(HostBrokerRecoveryRecordsV7(operation, row.state, domain, scope.unwrap(), identity.unwrap(), policy_digest, native, lease, request_digest,
        admission.admission.receipt.receipt_digest, sha256_text(source),
        if domain == HostBrokerRecoveryDomainV1.OutputFollow: "host-helper-stream-settlement" else: "host-primary-attach-settlement",
        if domain == HostBrokerRecoveryDomainV1.OutputFollow: "settlement" else: "primary-settlement"))

pub fn host_broker_recovery_evidence_owned_v7(journal: DistributedOperationJournalV2,
        records: HostBrokerRecoveryRecordsV7, recovery: GroupProcessStreamRecoveryOwnerV3) -> Result<text, text>:
    # Borrowed actual view validates ORIGINAL held-root terminal/resource/reap;
    # DATA native/lease fields are restrictive comparisons, never release proof.
    val cleanup = recovery.cleanup_proof_v3()?
    val reap = recovery.validate_reap_v3(records.lease)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String(records.settlement_kind),
        "operationId": SdnValue.String(records.operation.id), "operationDigest": SdnValue.String(sha256_text(distributed_encode_operation_v2(records.operation)?)),
        "requestDigest": SdnValue.String(records.request_digest), "preparedReceiptDigest": SdnValue.String(records.prepared_receipt_digest),
        "consumptionDigest": SdnValue.String(records.consumption_digest), "nativeIdentityDigest": SdnValue.String(records.native.identity_digest),
        "treeReceiptDigest": SdnValue.String(reap.tree_receipt_digest)}
    val expected = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if broker_record_read_v7(journal, records.operation.id, records.settlement_category)? != expected:
        return Err("broker-recovery-settlement-retained-mismatch")
    distributed_operation_journal_linux_current_v3(journal)?
    recovery.current_v3()?
    Ok(expected)
