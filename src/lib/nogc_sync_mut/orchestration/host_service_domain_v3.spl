pub struct HostServiceDomainV3:
    local: HostLocalRootV3

pub struct HostServiceTurnV3:
    owner: HostServiceDomainV3
    exit_code: i64
    response: text

pub enum HostServiceCleanupV3:
    Linux(DistributedOperationJournalOpenCleanupV2)
    Windows(HostWindowsLocalCleanupV3)
    LinuxService(HostLinuxServiceCurrentV4)

pub enum HostServiceDomainOpenV3:
    Ready(HostServiceDomainV3)
    Pending(HostServiceDomainV3, text)
    Rejected(text)
    CleanupRequired(HostServiceCleanupV3, text)

pub struct HostServiceCloseV3:
    cleanup: Option<HostServiceCleanupV3>
    closed: bool
    error: text

pub fn host_service_domain_open_linux_v3(root: text) -> HostServiceDomainOpenV3:
    match host_service_domain_open_v2(root):
        case HostServiceDomainOpenV2.Ready(domain):
            HostServiceDomainOpenV3.Ready(HostServiceDomainV3(HostLocalRootV3.Linux(domain.local)))
        case HostServiceDomainOpenV2.Rejected(error): HostServiceDomainOpenV3.Rejected(error)
        case HostServiceDomainOpenV2.CleanupRequired(cleanup, error):
            HostServiceDomainOpenV3.CleanupRequired(HostServiceCleanupV3.Linux(cleanup), error)

# Installed signed-enrollment Linux service. `anchor` is the administrator's
# installed child root. The one service owner carries every acquired owner,
# including the lending fresh-epoch admission; a failed start is its cleanup.
pub fn host_service_domain_open_linux_service_v3(anchor: text) -> HostServiceDomainOpenV3:
    val started = host_linux_service_open_installed_v4(anchor)
    if started.error != "":
        return HostServiceDomainOpenV3.CleanupRequired(HostServiceCleanupV3.LinuxService(started.owner), started.error)
    HostServiceDomainOpenV3.Ready(HostServiceDomainV3(HostLocalRootV3.LinuxService(started.owner)))

# anchor is administrator-installed configuration, never a remote request field.
# The deployment factory verifies actual ACLs, signed enrollment and pinned bytes.
pub fn host_service_domain_open_windows_v3(anchor: HostWindowsDeploymentAnchorV2,
        binding: HostServiceEnrollmentBindingV2) -> HostServiceDomainOpenV3:
    var deployment: Option<HostWindowsDeploymentOwnerV2> = nil
    match host_windows_deployment_reopen_v2(anchor, binding):
        case HostWindowsDeploymentOpenV2.Ready(owner): deployment = Some(owner)
        case HostWindowsDeploymentOpenV2.Rejected(error): return HostServiceDomainOpenV3.Rejected(error)
        case HostWindowsDeploymentOpenV2.RecoveryRequired(_, error):
            return HostServiceDomainOpenV3.Rejected("host-deployment-recovery-required:" + error)
        case HostWindowsDeploymentOpenV2.CleanupRequired(cleanup, error):
            return HostServiceDomainOpenV3.CleanupRequired(HostServiceCleanupV3.Windows(
                HostWindowsLocalCleanupV3(deployment: nil, deployment_cleanup: Some(cleanup))), error)
    match host_windows_local_open_v3(deployment.unwrap()):
        case HostWindowsLocalOpenV3.Ready(local):
            HostServiceDomainOpenV3.Ready(HostServiceDomainV3(HostLocalRootV3.Windows(local)))
        case HostWindowsLocalOpenV3.Pending(local, error):
            HostServiceDomainOpenV3.Pending(HostServiceDomainV3(HostLocalRootV3.Windows(local)), error)
        case HostWindowsLocalOpenV3.Rejected(error): HostServiceDomainOpenV3.Rejected(error)
        case HostWindowsLocalOpenV3.CleanupRequired(cleanup, error):
            HostServiceDomainOpenV3.CleanupRequired(HostServiceCleanupV3.Windows(cleanup), error)

pub fn host_service_cleanup_v3(cleanup: HostServiceCleanupV3) -> HostServiceCloseV3:
    match cleanup:
        case HostServiceCleanupV3.Linux(original):
            val closed = distributed_operation_journal_open_cleanup_v2(original)
            val pending = if closed.cleanup.is_some(): Some(HostServiceCleanupV3.Linux(closed.cleanup.unwrap())) else: nil
            HostServiceCloseV3(pending, closed.closed, closed.error)
        case HostServiceCleanupV3.Windows(original):
            val closed = host_windows_local_cleanup_v3(original)
            val pending = if closed.cleanup.is_some(): Some(HostServiceCleanupV3.Windows(closed.cleanup.unwrap())) else: nil
            HostServiceCloseV3(pending, closed.closed, closed.error)
        case HostServiceCleanupV3.LinuxService(original): service_linux_close_v3(original)

# The retained Linux service owner IS its cleanup carrier until every
# owner-bearing part is released; a sticky earlier failure stays in error.
fn service_linux_close_v3(original: HostLinuxServiceCurrentV4) -> HostServiceCloseV3:
    val closed = host_linux_service_close_v4(original)
    val pending = if closed.released_all: None else: Some(HostServiceCleanupV3.LinuxService(closed.owner))
    HostServiceCloseV3(pending, closed.released_all, closed.error)

pub fn host_service_domain_close_v3(owner: HostServiceDomainV3) -> HostServiceCloseV3:
    match owner.local:
        case HostLocalRootV3.Linux(local):
            val closed = host_service_domain_close_v2(HostServiceDomainV2(local))
            val pending = if closed.cleanup.is_some(): Some(HostServiceCleanupV3.Linux(closed.cleanup.unwrap())) else: nil
            HostServiceCloseV3(pending, closed.closed, closed.error)
        case HostLocalRootV3.Windows(local):
            val closed = host_windows_local_close_v3(local)
            val pending = if closed.cleanup.is_some(): Some(HostServiceCleanupV3.Windows(closed.cleanup.unwrap())) else: nil
            HostServiceCloseV3(pending, closed.closed, closed.error)
        case HostLocalRootV3.LinuxService(local): service_linux_close_v3(local)

fn service_windows_status_v3(local: HostWindowsLocalRootV3) -> Result<text, text>:
    val checked = local.current_v3()?
    val ledger = local.capacity_v3().ledger
    val available = host_available_capacity_v1(ledger)?
    val binding = local.binding_v3()
    val scope = local.scope_v3()
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(3), "kind": SdnValue.String("host-local-status"),
        "backend": SdnValue.String(binding.backend), "physicalHostId": SdnValue.String(binding.physical_host_id),
        "serviceScopeId": SdnValue.String(binding.service_scope_id), "authorityId": SdnValue.String(ledger.capacity.authority_id),
        "continuityMode": SdnValue.String(scope.continuity_mode), "continuityId": SdnValue.String(scope.continuity_id),
        "fenceId": SdnValue.String(ledger.capacity.boot_id), "nativeMachineId": SdnValue.String(scope.native_machine_id),
        "providerIdentityDigest": SdnValue.String(binding.provider_identity_digest), "ready": SdnValue.Bool(local.ready_v3()),
        "availableCpuMillis": SdnValue.Int(available.cpu_millis), "availableMemoryBytes": SdnValue.Int(available.memory_bytes),
        "retainedReservations": SdnValue.Int(ledger.reservations.len()), "revision": SdnValue.Int(ledger.revision),
        "durabilityProfile": SdnValue.String("process-crash-v1")}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

# The dispatch returns the same owner on every path; it is put back into the
# domain before any refusal is reported. An attempted effect needs recovery (2).
fn service_linux_prepare_v3(local: HostLinuxServiceCurrentV4, request: HostServiceRequestV2) -> HostServiceTurnV3:
    val reply = host_linux_service_dispatch_installed_v4(local, "host_prepare_associated_v3", request.payload)
    val domain = HostServiceDomainV3(HostLocalRootV3.LinuxService(reply.owner))
    if reply.error != "":
        return HostServiceTurnV3(domain, if reply.effect_attempted: 2 else: 1,
            host_service_error_payload_v2(request, reply.error, reply.effect_attempted))
    if reply.response.byte_len() > HOST_SERVICE_MAX_RESPONSE_BYTES_V2:
        return HostServiceTurnV3(domain, 2, host_service_error_payload_v2(request, "host-service-response-size", true))
    HostServiceTurnV3(domain, 0, reply.response)

# milestone_0021 R-03 route half: `host-agent-invoke` exists on the LinuxService arm only. The V2 action lists
# (host_service_domain_v2.spl) are untouched (N-07: a 9th entry would make a full-grant V2 peer rule
# unencodable), so the Linux V2 and Windows arms keep refusing it as host-service-action-unsupported. Same
# bounds as host_service_request_error_v2 (v2:65-73); the payload must name the request's operation id.
fn host_service_agent_invoke_request_error_v3(request: HostServiceRequestV2) -> text:
    if not builder_identifier_valid_v1(request.operation_id) or request.operation_id.byte_len() > HOST_SERVICE_MAX_OPERATION_BYTES_V2:
        return "host-service-operation-invalid"
    if request.payload.byte_len() == 0 or request.payload.byte_len() > HOST_SERVICE_MAX_PAYLOAD_BYTES_V2:
        return "host-service-payload-size"
    if request.payload.contains("\u{0}"): return "host-service-payload-nul"
    val decoded = host_agent_invoke_request_decode_v4(request.payload)
    if decoded.is_err(): return decoded.unwrap_err()
    if decoded.unwrap().operation_id != request.operation_id: return "host-service-agent-invoke-operation-mismatch"
    ""

# The PR3a cancel carries a controller-signed packet (HostAgentCancelRequestV4), not the invoke bytes: the same
# bounds, and the signed packet must name the request's operation id. Signatures are verified by the owner.
fn host_service_agent_cancel_request_error_v3(request: HostServiceRequestV2) -> text:
    val framed = host_service_agent_frame_error_v3(request)
    if framed != "": return framed
    val decoded = host_agent_cancel_request_decode_v4(request.payload)
    if decoded.is_err(): return decoded.unwrap_err()
    if decoded.unwrap().operation_id != request.operation_id: return "host-service-agent-cancel-operation-mismatch"
    ""

fn host_service_agent_frame_error_v3(request: HostServiceRequestV2) -> text:
    if not builder_identifier_valid_v1(request.operation_id) or request.operation_id.byte_len() > HOST_SERVICE_MAX_OPERATION_BYTES_V2:
        return "host-service-operation-invalid"
    if request.payload.byte_len() == 0 or request.payload.byte_len() > HOST_SERVICE_MAX_PAYLOAD_BYTES_V2:
        return "host-service-payload-size"
    if request.payload.contains("\u{0}"): return "host-service-payload-nul"
    ""

# milestone_0021 PR3b: attach/detach carry controller-signed packets naming the run; inspect names the run in
# its payload (read-only). Each packet's operation id must equal the request's.
fn host_service_agent_attachment_request_error_v3(request: HostServiceRequestV2) -> text:
    val framed = host_service_agent_frame_error_v3(request)
    if framed != "": return framed
    var named = request.payload
    if request.action == "host-agent-attach":
        val attach = host_agent_attach_request_decode_v4(request.payload)
        if attach.is_err(): return attach.unwrap_err()
        named = attach.unwrap().operation_id
    elif request.action == "host-agent-detach":
        val detach = host_agent_detach_request_decode_v4(request.payload)
        if detach.is_err(): return detach.unwrap_err()
        named = detach.unwrap().operation_id
    if named != request.operation_id: return "host-service-agent-attachment-operation-mismatch"
    ""

# EFFECT actions (invoke, and the PR3 cancel): an effect-attempted refusal maps to exit 2 with the recovery flag in
# the error payload (as service_linux_prepare_v3); a plain refusal is 1.
fn service_linux_agent_action_v3(local: HostLinuxServiceCurrentV4, request: HostServiceRequestV2, action: text) -> HostServiceTurnV3:
    val reply = host_linux_service_dispatch_installed_v4(local, action, request.payload)
    val domain = HostServiceDomainV3(HostLocalRootV3.LinuxService(reply.owner))
    if reply.error != "":
        return HostServiceTurnV3(domain, if reply.effect_attempted: 2 else: 1,
            host_service_error_payload_v2(request, reply.error, reply.effect_attempted))
    if reply.response.byte_len() > HOST_SERVICE_MAX_RESPONSE_BYTES_V2:
        return HostServiceTurnV3(domain, 2, host_service_error_payload_v2(request, "host-service-response-size", true))
    HostServiceTurnV3(domain, 0, reply.response)

# ---- milestone_0024 PR3c S0: pane lease and brokered pane io through the domain ----

pub struct HostServiceLeaseTurnV3:
    owner: HostServiceDomainV3
    lease: Option<HostAgentPaneLeaseV4>
    error: text

pub struct HostServicePaneIoTurnV3:
    owner: HostServiceDomainV3
    result: HostAgentPaneIoResultV4

pub fn host_service_domain_attachment_lease_v3(owner: HostServiceDomainV3, expected_binding_uid: text) -> HostServiceLeaseTurnV3:
    match owner.local:
        case HostLocalRootV3.LinuxService(local):
            val turn = host_linux_service_attachment_lease_v4(local, expected_binding_uid)
            HostServiceLeaseTurnV3(owner: HostServiceDomainV3(HostLocalRootV3.LinuxService(turn.owner)), lease: turn.lease, error: turn.error)
        case _: HostServiceLeaseTurnV3(owner: owner, lease: None, error: "host-linux-service-action-route")

pub fn host_service_domain_pane_io_v3(owner: HostServiceDomainV3, expected_binding_uid: text,
        lease: HostAgentPaneLeaseV4, op: HostAgentPaneOpV4) -> HostServicePaneIoTurnV3:
    match owner.local:
        case HostLocalRootV3.LinuxService(local):
            val turn = host_linux_service_pane_io_v4(local, expected_binding_uid, lease, op)
            HostServicePaneIoTurnV3(owner: HostServiceDomainV3(HostLocalRootV3.LinuxService(turn.owner)), result: turn.result)
        case _: HostServicePaneIoTurnV3(owner: owner, result: host_agent_pane_io_refused_v4("host-linux-service-action-route"))

pub fn host_service_domain_turn_v3(owner: HostServiceDomainV3, request: HostServiceRequestV2) -> HostServiceTurnV3:
    match owner.local:
        case HostLocalRootV3.Linux(local):
            val turn = host_service_domain_turn_v2(HostServiceDomainV2(local), request)
            HostServiceTurnV3(HostServiceDomainV3(HostLocalRootV3.Linux(turn.owner.local)), turn.exit_code, turn.response)
        case HostLocalRootV3.LinuxService(local):
            # Status, and associated prepare through the installed dispatch.
            # Execute is host_service_execution_v4's route; validate, inspect,
            # wait and cancel stay explicit refusals. The agent invoke and the agent
            # cancel are checked before the V2 validator, whose action list they
            # are deliberately not in.
            if request.action == "host-agent-invoke":
                val invoke_invalid = host_service_agent_invoke_request_error_v3(request)
                if invoke_invalid != "": return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, invoke_invalid, false))
                val recheck = local.current_v4()
                if recheck.is_err(): return HostServiceTurnV3(owner, 2, host_service_error_payload_v2(request, recheck.unwrap_err(), true))
                return service_linux_agent_action_v3(local, request, "host_agent_invoke_v4")
            # milestone_0021 PR3a (D21, P3R1-F1): cancel carries a controller-signed packet and takes its own
            # validator; it stays out of the V2 lists for the same N-07 reason.
            if request.action == "host-agent-cancel":
                val cancel_invalid = host_service_agent_cancel_request_error_v3(request)
                if cancel_invalid != "": return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, cancel_invalid, false))
                val cancel_recheck = local.current_v4()
                if cancel_recheck.is_err(): return HostServiceTurnV3(owner, 2, host_service_error_payload_v2(request, cancel_recheck.unwrap_err(), true))
                return service_linux_agent_action_v3(local, request, "host_agent_cancel_v4")
            if request.action == "host-agent-attach" or request.action == "host-agent-detach" or request.action == "host-agent-inspect":
                val attachment_invalid = host_service_agent_attachment_request_error_v3(request)
                if attachment_invalid != "": return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, attachment_invalid, false))
                val attachment_recheck = local.current_v4()
                if attachment_recheck.is_err(): return HostServiceTurnV3(owner, 2, host_service_error_payload_v2(request, attachment_recheck.unwrap_err(), true))
                var routed = "host_agent_inspect_v4"
                if request.action == "host-agent-attach": routed = "host_agent_attach_v4"
                if request.action == "host-agent-detach": routed = "host_agent_detach_v4"
                return service_linux_agent_action_v3(local, request, routed)
            val invalid = host_service_request_error_v2(request)
            if invalid != "": return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, invalid, false))
            if request.action != "host-status" and request.action != "host-prepare":
                return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, "host-linux-service-action-route", false))
            # Mirror Windows: a failed current check needs recovery (2); a
            # status refusal over a current owner is a plain refusal (1).
            val current = local.current_v4()
            if current.is_err(): return HostServiceTurnV3(owner, 2, host_service_error_payload_v2(request, current.unwrap_err(), true))
            if request.action == "host-prepare": return service_linux_prepare_v3(local, request)
            val status = local.status_v4()
            if status.is_err(): return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, status.unwrap_err(), false))
            if status.unwrap().byte_len() > HOST_SERVICE_MAX_RESPONSE_BYTES_V2:
                return HostServiceTurnV3(owner, 2, host_service_error_payload_v2(request, "host-service-response-size", true))
            HostServiceTurnV3(owner, 0, status.unwrap())
        case HostLocalRootV3.Windows(original):
            var local = original
            val invalid = host_service_request_error_v2(request)
            if invalid != "": return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, invalid, false))
            val current = local.current_v3()
            if current.is_err(): return HostServiceTurnV3(owner, 2, host_service_error_payload_v2(request, current.unwrap_err(), true))
            var response: Result<text, text> = Err("host-service-effect-dispatch-required")
            var mutation_attempted = false
            if request.action == "host-status": response = service_windows_status_v3(local)
            elif request.action == "host-validate":
                response = host_local_validate_payload_v2(local.container_v3(), request.payload, request.operation_id)
            elif request.action == "host-prepare":
                val decoded = host_prepare_request_decode_v1(request.payload)
                if decoded.is_err(): response = Err(decoded.unwrap_err())
                elif decoded.unwrap().operation.id != request.operation_id: response = Err("host-service-operation-mismatch")
                else:
                    mutation_attempted = true
                    response = local.prepare_v3(request.payload)
            elif request.action == "host-parent-budget":
                val decoded = host_parent_budget_record_decode_v1(request.payload)
                if decoded.is_err(): response = Err(decoded.unwrap_err())
                elif decoded.unwrap().parent_binding.host_operation.id != request.operation_id:
                    response = Err("host-service-operation-mismatch")
                else:
                    mutation_attempted = true
                    val stored = local.parent_budget_v3(request.payload)
                    if stored.is_err(): response = Err(stored.unwrap_err())
                    else:
                        val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
                            "kind": SdnValue.String("host-parent-budget-reference"),
                            "parentOperationId": SdnValue.String(request.operation_id),
                            "budgetDigest": SdnValue.String(stored.unwrap())}
                        response = Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")
            val retained = HostServiceDomainV3(HostLocalRootV3.Windows(local))
            if response.is_err():
                return HostServiceTurnV3(retained, if mutation_attempted: 2 else: 1,
                    host_service_error_payload_v2(request, response.unwrap_err(), mutation_attempted))
            if response.unwrap().byte_len() > HOST_SERVICE_MAX_RESPONSE_BYTES_V2:
                return HostServiceTurnV3(retained, 2, host_service_error_payload_v2(request, "host-service-response-size", true))
            HostServiceTurnV3(retained, 0, response.unwrap())

fn service_execution_reply_v3(owner: HostServiceDomainV3, request: HostServiceRequestV2,
        observation: Option<HostExecutionObservationV2>, recovery: bool, error: text) -> HostServiceTurnV3:
    if val observed = observation:
        val encoded = host_execution_observation_encode_v2(observed)
        if encoded.is_err(): return HostServiceTurnV3(owner, 2,
            host_service_error_payload_v2(request, encoded.unwrap_err(), true))
        return HostServiceTurnV3(owner, if error == "": 0 else: 2, encoded.unwrap())
    HostServiceTurnV3(owner, if recovery: 2 else: 1, host_service_error_payload_v2(request, error, recovery))

# Explicit finite effect-worker entry. Keep the retained owner in that worker
# across signed prepare and execute; never call it on the control poll callback.
pub fn host_service_domain_effect_turn_v3(owner: HostServiceDomainV3,
        request: HostServiceRequestV2) -> HostServiceTurnV3:
    host_service_domain_effect_constrained_turn_v3(owner, request, nil)

pub fn host_service_domain_effect_constrained_turn_v3(owner: HostServiceDomainV3,
        request: HostServiceRequestV2, constraint: Option<ContainerPreStartConstraintV1>) -> HostServiceTurnV3:
    host_service_domain_effect_restricted_turn_v3(owner, request, constraint, nil)

pub fn host_service_domain_effect_input_constrained_turn_v3(owner: HostServiceDomainV3,
        request: HostServiceRequestV2, input: ContainerPreStartInputConstraintV1) -> HostServiceTurnV3:
    host_service_domain_effect_restricted_turn_v3(owner, request, nil, Some(container_pre_start_input_constraint_copy_v1(input)))

fn host_service_domain_effect_restricted_turn_v3(owner: HostServiceDomainV3,
        request: HostServiceRequestV2, constraint: Option<ContainerPreStartConstraintV1>,
        input: Option<ContainerPreStartInputConstraintV1>) -> HostServiceTurnV3:
    val invalid = host_service_request_error_v2(request)
    if invalid != "" or request.action != "host-execute":
        return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request,
            if invalid != "": invalid else: "host-service-effect-action", false))
    match owner.local:
        case HostLocalRootV3.Linux(original):
            var local = original
            val decoded = host_execution_decode_v2(request.payload, local.scope)
            if decoded.is_err() or decoded.unwrap().operation.id != request.operation_id:
                return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, "host-service-execute-envelope", false))
            val root = local.root
            val binding = local.binding
            val refresh = fn() -> HostReservationAuthorizationContextV1:
                host_local_refresh_context_v1(root, binding)
            val turn = if input.is_some():
                host_authorized_execute_input_constrained_v2(local.capacity, local.container, request.payload, local.policy,
                    binding.provider_identity_digest, local.config.service_scope_id, host_local_context_v1(local.policy), refresh, input.unwrap())
            else:
                host_authorized_execute_constrained_v2(local.capacity, local.container, request.payload, local.policy,
                    binding.provider_identity_digest, local.config.service_scope_id, host_local_context_v1(local.policy), refresh, constraint)
            local.capacity = turn.owner
            local.container = turn.container
            service_execution_reply_v3(HostServiceDomainV3(HostLocalRootV3.Linux(local)), request,
                turn.observation, turn.recovery_required, turn.error)
        case HostLocalRootV3.LinuxService(_):
            HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, "host-linux-service-execution-route", false))
        case HostLocalRootV3.Windows(original):
            var local = original
            val decoded = host_execution_decode_v2(request.payload, local.scope_v3())
            if decoded.is_err() or decoded.unwrap().operation.id != request.operation_id:
                return HostServiceTurnV3(owner, 1, host_service_error_payload_v2(request, "host-service-execute-envelope", false))
            val turn = if input.is_some():
                local.execute_input_constrained_v3(request.payload, input.unwrap())
            else:
                local.execute_constrained_v3(request.payload, constraint)
            service_execution_reply_v3(HostServiceDomainV3(HostLocalRootV3.Windows(local)), request,
                turn.observation, turn.recovery_required, turn.error)
