# Historical validation is separate from live root/transaction ownership.
use std.nogc_sync_mut.orchestration.host_policy_installation_data_v1.{HostPolicyInstallationKindV1, host_policy_installation_error_v1}
use std.nogc_sync_mut.orchestration.host_policy_installation_projection_v1.host_policy_installation_projection_v1
use std.common.contracts.orchestration.host_capacity_v1.HostCapacityV1
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.task_runner.distributed_operation_journal_v2.DistributedOperationJournalV2

pub fn host_exec_control_installation_projection_v3(journal: DistributedOperationJournalV2,
        capacity: HostCapacityV1, operation: OperationEnvelopeV2) -> Result<bool, text>:
    val result = host_policy_installation_projection_v1(HostPolicyInstallationKindV1.ExecControlV3, journal, capacity, operation)
    if result.is_err(): return Err(host_policy_installation_error_v1(HostPolicyInstallationKindV1.ExecControlV3, result.unwrap_err()))
    result
