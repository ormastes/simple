# Fixed signed installation under one original protected parent writer.
# This creates no service incarnation, native provider, capacity reservation,
# journal format, or launch authority. The supplied native loan and original
# protected parent reader remain borrowed and are returned on every path.
# Signing step 5: the writer is reachable only through the proof-gated
# owner_health entry; this module calls no private owner_health function.
use std.common.contracts.orchestration.host_linux_service_enrollment_v3.*
use std.common.task_runner.distributed_operation_owner_health_v2.{OperationHealthLinuxInstallCleanupV1,
    operation_health_linux_install_v1, operation_health_linux_install_close_v1}
use std.nogc_sync_mut.io.linux_protected_root_reader_v1.*
use std.nogc_sync_mut.io.linux_service_native_identity_v3.*
use std.nogc_sync_mut.io.host_linux_service_records_v4.{LinuxServiceVerifiedEnrollmentV1,
    linux_service_enrollment_verify_v1, host_linux_service_root_path_v4, host_linux_service_claim_name_v4}
use std.nogc_sync_mut.io.host_enrollment_v1.HostEnrollmentCredentialV1
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.container.machine_authority_v1.{MachineFreshEpochAdmissionTurnV1,
    machine_container_authority_open_fresh_epoch_v1}
use std.nogc_sync_mut.container.machine_fresh_epoch_cleanup_v1.machine_fresh_epoch_admission_turn_close_v1

pub struct HostLinuxServiceInstallRequestV3:
    binding: HostLinuxServiceEnrollmentBindingV3
    credential: HostEnrollmentCredentialV1
    configuration_bytes: text
    engine_policy_bytes: text
    broker_policy_bytes: text
    # milestone_0021 F15 (B): installed as agent-helper-template.sdn, pinned by the signed enrollment.
    agent_helper_template_bytes: text
    remote_build_template_bytes: text = ""

# DATA about durable residue, never a cleanup/recovery permission.
pub struct HostLinuxServiceInstallResidueV3:
    root: text
    claim_name: text
    binding_digest: text
    phase: text

# `cleanup` is present only when the owner could not finish draining its own
# descriptors; it admits only host_linux_service_install_close_v3.
pub struct HostLinuxServiceInstallTurnV3:
    cleanup: Option<OperationHealthLinuxInstallCleanupV1>
    parent: LinuxProtectedRootReaderV1
    native: LinuxServiceNativeIdentityBorrowV3
    residue: Option<HostLinuxServiceInstallResidueV3>
    installed: bool
    duplicate: bool
    error: text
    # Owner close diagnostic, kept even when the install itself succeeded.
    close_error: text = ""

pub struct HostLinuxServiceInstallCloseV3:
    cleanup: Option<OperationHealthLinuxInstallCleanupV1>
    closed: bool
    error: text

fn service_install_policy_v3(parent: LinuxProtectedRootReaderV1,
        binding: HostLinuxServiceEnrollmentBindingV3) -> Result<text, text>:
    linux_protected_root_reader_require_root_v1(parent, binding.machine_parent)?
    val source = linux_protected_root_reader_read_v1(parent, "authority-policy.sdn", 1048576)?
    if source.is_none(): return Err("linux-service-install-parent-policy-missing")
    if sha256_text(source.unwrap()) != binding.policy_digest:
        return Err("linux-service-install-parent-policy-pin")
    Ok(source.unwrap())

# Native identity and the original parent reader both import owner_health, so
# the owner cannot re-check them; they bracket the whole owner entry here.
fn service_install_context_v3(parent: LinuxProtectedRootReaderV1, native: LinuxServiceNativeIdentityBorrowV3,
        request: HostLinuxServiceInstallRequestV3, policy: text) -> Result<(), text>:
    val observed = native.current_v3()?
    if observed.native_machine_id != request.binding.native_machine_id:
        return Err("linux-service-install-native-machine-mismatch")
    if service_install_policy_v3(parent, request.binding)? != policy:
        return Err("linux-service-install-parent-policy-changed")
    linux_protected_root_reader_current_v1(parent)

fn service_install_proof_v3(parent: LinuxProtectedRootReaderV1, request: HostLinuxServiceInstallRequestV3,
        native: LinuxServiceNativeIdentityBorrowV3) -> Result<(LinuxServiceVerifiedEnrollmentV1, text), text>:
    val binding = request.binding
    host_linux_service_enrollment_encode_v3(binding)?
    val observation = native.current_v3()?
    if observation.native_machine_id != binding.native_machine_id:
        return Err("linux-service-install-native-machine-mismatch")
    val policy = service_install_policy_v3(parent, binding)?
    val proof = linux_service_enrollment_verify_v1(policy, binding, request.credential,
        request.configuration_bytes, request.engine_policy_bytes, request.broker_policy_bytes,
        request.agent_helper_template_bytes, request.remote_build_template_bytes)?
    val repeated = native.current_v3()?
    if repeated.native_machine_id != observation.native_machine_id or repeated.native_boot_id != observation.native_boot_id or
            repeated.owner_generation != observation.owner_generation or repeated.process_identity_digest != observation.process_identity_digest or
            repeated.process_generation != observation.process_generation or repeated.authority_namespace_id != observation.authority_namespace_id:
        return Err("linux-service-install-native-changed")
    linux_protected_root_reader_current_v1(parent)?
    Ok((proof, policy))

pub fn host_linux_service_install_v3(parent: LinuxProtectedRootReaderV1,
        native: LinuxServiceNativeIdentityBorrowV3, request: HostLinuxServiceInstallRequestV3) -> HostLinuxServiceInstallTurnV3:
    val verified = service_install_proof_v3(parent, request, native)
    if verified.is_err(): return HostLinuxServiceInstallTurnV3(None, parent, native, None, false, false, verified.unwrap_err())
    val digest = host_linux_service_enrollment_digest_v3(request.binding)
    if digest.is_err(): return HostLinuxServiceInstallTurnV3(None, parent, native, None, false, false, digest.unwrap_err())
    val root = host_linux_service_root_path_v4(request.binding)
    if root.is_err(): return HostLinuxServiceInstallTurnV3(None, parent, native, None, false, false, root.unwrap_err())
    val proof = verified.unwrap().0
    val policy = verified.unwrap().1
    # The owner opens writer=true/create_final=false, re-verifies the proof
    # against policy read through its own writer before and after every
    # publication, and drains its descriptors before returning.
    val outcome = operation_health_linux_install_v1(proof)
    val residue = HostLinuxServiceInstallResidueV3(root.unwrap(), host_linux_service_claim_name_v4(request.binding),
        digest.unwrap(), outcome.phase)
    var error = outcome.error
    if error == "":
        val after = service_install_context_v3(parent, native, request, policy)
        if after.is_err(): error = after.unwrap_err()
    # Close never undoes an install (an unfinished close is signalled by the
    # returned carrier); a failed install keeps the close reason too.
    if outcome.close_error != "" and error != "": error = error + ";close:" + outcome.close_error
    HostLinuxServiceInstallTurnV3(outcome.cleanup, parent, native, Some(residue), outcome.installed and error == "",
        outcome.duplicate and error == "", error, outcome.close_error)

pub fn host_linux_service_install_close_v3(cleanup: OperationHealthLinuxInstallCleanupV1) -> HostLinuxServiceInstallCloseV3:
    # Drains exact owned descriptors only. Claims and installed records remain
    # durable residue; borrowed native/parent owners are untouched.
    val closed = operation_health_linux_install_close_v1(cleanup)
    HostLinuxServiceInstallCloseV3(closed.cleanup, closed.closed, closed.error)


# Local provisioning owns the parent reader and actual epoch admission.
# The installer borrows both and returns only its own outstanding writer.
pub class HostLinuxServiceProvisionCleanupV3:
    writer: Option<OperationHealthLinuxInstallCleanupV1> = None
    parent: Option<LinuxProtectedRootReaderV1> = None
    admission: Option<MachineFreshEpochAdmissionTurnV1> = None
    loan: Option<LinuxServiceNativeIdentityBorrowV3> = None
    diagnostic: text = ""

pub enum HostLinuxServiceProvisionStateV3:
    Refused
    Installed
    Existing

pub struct HostLinuxServiceProvisionTurnV3:
    cleanup: Option<HostLinuxServiceProvisionCleanupV3>
    residue: Option<HostLinuxServiceInstallResidueV3>
    state: HostLinuxServiceProvisionStateV3
    error: text

pub struct HostLinuxServiceProvisionCloseV3:
    cleanup: Option<HostLinuxServiceProvisionCleanupV3>
    error: text

pub fn host_linux_service_provision_close_v3(original: HostLinuxServiceProvisionCleanupV3) -> HostLinuxServiceProvisionCloseV3:
    var owner = original
    if val writer = owner.writer:
        val closed = host_linux_service_install_close_v3(writer)
        owner.writer = closed.cleanup
        if owner.diagnostic == "" and closed.error != "": owner.diagnostic = closed.error
        if owner.writer.is_some(): return HostLinuxServiceProvisionCloseV3(Some(owner), owner.diagnostic)
        if not closed.closed and owner.diagnostic == "": owner.diagnostic = "linux-service-provision-writer-release-unconfirmed"
    if val parent = owner.parent:
        val closed = linux_protected_root_reader_close_v1(parent)
        owner.parent = closed.owner
        if owner.diagnostic == "" and closed.error != "": owner.diagnostic = closed.error
        if owner.parent.is_some(): return HostLinuxServiceProvisionCloseV3(Some(owner), owner.diagnostic)
        if not closed.completed and owner.diagnostic == "": owner.diagnostic = "linux-service-provision-parent-release-unconfirmed"
    if val borrow = owner.loan:
        if owner.admission.is_none() or owner.admission.unwrap().owner.is_none():
            return HostLinuxServiceProvisionCloseV3(Some(owner), "linux-service-provision-loan-owner-missing")
        var admission = owner.admission.unwrap()
        val returned = admission.owner.unwrap().end_service_loan_v1(borrow)
        admission.owner = Some(returned.owner)
        owner.admission = Some(admission)
        if returned.error != "":
            if owner.diagnostic == "": owner.diagnostic = returned.error
            return HostLinuxServiceProvisionCloseV3(Some(owner), owner.diagnostic)
        owner.loan = None
    if val admission = owner.admission:
        val closed = machine_fresh_epoch_admission_turn_close_v1(admission)
        owner.admission = closed.retained
        if owner.diagnostic == "" and closed.error != "": owner.diagnostic = closed.error
        if owner.admission.is_some(): return HostLinuxServiceProvisionCloseV3(Some(owner), owner.diagnostic)
        if not closed.closed and owner.diagnostic == "": owner.diagnostic = "linux-service-provision-admission-release-unconfirmed"
    HostLinuxServiceProvisionCloseV3(None, owner.diagnostic)

fn service_provision_finish_v3(owner: HostLinuxServiceProvisionCleanupV3,
        residue: Option<HostLinuxServiceInstallResidueV3>, installed: bool,
        duplicate: bool, error: text) -> HostLinuxServiceProvisionTurnV3:
    val closed = host_linux_service_provision_close_v3(owner)
    var reason = error
    if closed.error != "":
        reason = if reason == "": closed.error else: reason + ":cleanup:" + closed.error
    if closed.cleanup.is_some() and reason == "": reason = "linux-service-provision-cleanup-pending"
    val state = if reason != "" or not installed: HostLinuxServiceProvisionStateV3.Refused else:
        if duplicate: HostLinuxServiceProvisionStateV3.Existing else: HostLinuxServiceProvisionStateV3.Installed
    HostLinuxServiceProvisionTurnV3(closed.cleanup, residue, state, reason)

pub fn host_linux_service_provision_v3(request: HostLinuxServiceInstallRequestV3) -> HostLinuxServiceProvisionTurnV3:
    val binding = request.binding
    val canonical = host_linux_service_enrollment_encode_v3(binding)
    if canonical.is_err(): return HostLinuxServiceProvisionTurnV3(None, None, HostLinuxServiceProvisionStateV3.Refused, canonical.unwrap_err())
    val opened = linux_protected_root_reader_open_v1(binding.machine_parent)
    var owner = HostLinuxServiceProvisionCleanupV3(parent: opened.owner)
    if not opened.ready or opened.owner.is_none() or opened.error != "":
        val reason = if opened.error == "": "linux-service-provision-parent-unavailable" else: opened.error
        return service_provision_finish_v3(owner, None, false, false, reason)
    val parent = opened.owner.unwrap()
    val policy = service_install_policy_v3(parent, binding)
    if policy.is_err(): return service_provision_finish_v3(owner, None, false, false, policy.unwrap_err())
    # Reject bad or stale signatures before opening the machine admission.
    val verified = linux_service_enrollment_verify_v1(policy.unwrap(), binding, request.credential,
        request.configuration_bytes, request.engine_policy_bytes, request.broker_policy_bytes,
        request.agent_helper_template_bytes, request.remote_build_template_bytes)
    if verified.is_err(): return service_provision_finish_v3(owner, None, false, false, verified.unwrap_err())
    var admission = machine_container_authority_open_fresh_epoch_v1()
    owner.admission = Some(admission)
    if admission.error != "" or admission.owner.is_none():
        val reason = if admission.error == "": "linux-service-provision-admission-unavailable" else: admission.error
        return service_provision_finish_v3(owner, None, false, false, reason)
    val lent = admission.owner.unwrap().lend_service_identity_v1()
    admission.owner = Some(lent.owner)
    owner.admission = Some(admission)
    owner.loan = lent.native
    if lent.error != "" or lent.native.is_none():
        val reason = if lent.error == "": "linux-service-provision-native-unavailable" else: lent.error
        return service_provision_finish_v3(owner, None, false, false, reason)
    val installed = host_linux_service_install_v3(parent, lent.native.unwrap(), request)
    owner.writer = installed.cleanup
    owner.parent = Some(installed.parent)
    owner.diagnostic = installed.close_error
    val reason = if installed.error == "" and not installed.installed: "linux-service-provision-publication-unconfirmed" else: installed.error
    service_provision_finish_v3(owner, installed.residue, installed.installed, installed.duplicate, reason)
