# Exactly one consumed evidence domain. Corrupt selected archives are errors,
# never a reason to try another namespace. No native or ledger effects here.
use std.nogc_sync_mut.orchestration.host_helper_stream_record_v1.host_helper_archive_present_v1
use std.nogc_sync_mut.orchestration.host_helper_settlement_receipt_v1.host_helper_settlement_evidence_v1
use std.nogc_sync_mut.orchestration.host_primary_attach_settlement_receipt_v1.host_primary_attach_settlement_evidence_v1
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2

pub fn host_helper_completion_domain_v1(root: text, operation_id: text) -> Result<text, text>:
    val output = host_helper_archive_present_v1(root, operation_id, "consumed")?
    val primary = host_helper_archive_present_v1(root, operation_id, "primary-consumed")?
    if output and primary: return Err("helper-settlement-domain-ambiguous")
    if primary: return Ok("primary-attach")
    if output: return Ok("output-follow")
    Err("helper-settlement-domain-missing")

pub fn host_helper_completion_evidence_v1(root: text,
        operation: OperationEnvelopeV2) -> Result<text, text>:
    val domain = host_helper_completion_domain_v1(root, operation.id)?
    if domain == "primary-attach": return host_primary_attach_settlement_evidence_v1(root, operation)
    host_helper_settlement_evidence_v1(root, operation)
