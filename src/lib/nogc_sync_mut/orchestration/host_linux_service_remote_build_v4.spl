    simple_container_end_workspace_root_loan_v3, simple_container_end_service_loan_v3,
    simple_container_adopt_lent_workspace_reader_v3, simple_container_set_lifecycle_root_v3, simple_container_epoch_current_v3,
    simple_container_validate_helper_template_v3, simple_container_settle_workspace_v3,
    simple_container_released_charge_digest_v3, simple_container_return_settled_workspace_source_v3,
