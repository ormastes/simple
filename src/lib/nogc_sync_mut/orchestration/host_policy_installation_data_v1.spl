# Internal fixed-domain data adapter. Decoding is not signature verification or live authority.
use std.common.contracts.orchestration.host_exec_control_installation_v3.*
use std.common.contracts.orchestration.host_containment_installation_v1.*
use std.common.contracts.container.execution_v2.ContainerHostScopeV2
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}

pub enum HostPolicyInstallationKindV1:
    ExecControlV3
    ContainmentV1

pub struct HostPolicyInstallationIntentV1:
    operation_id: text
    enrollment_binding_digest: text
    scope: ContainerHostScopeV2
    provider_identity_digest: text
    control_policy_bytes: text
    canonical_bytes: text

pub struct HostPolicyInstallationRequestV1:
    intent: HostPolicyInstallationIntentV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2
    original_bytes: text

pub fn host_policy_installation_decode_v1(kind: HostPolicyInstallationKindV1, bytes: text) -> Result<HostPolicyInstallationRequestV1, text>:
    match kind:
        case HostPolicyInstallationKindV1.ExecControlV3:
            val request = host_exec_control_installation_request_decode_v3(bytes)?
            val intent = request.intent
            Ok(HostPolicyInstallationRequestV1(HostPolicyInstallationIntentV1(intent.operation_id,
                intent.enrollment_binding_digest, intent.scope, intent.provider_identity_digest,
                intent.control_policy_bytes, host_exec_control_installation_intent_encode_v3(intent)?),
                request.operation, request.signed, request.approval, bytes))
        case HostPolicyInstallationKindV1.ContainmentV1:
            val request = host_containment_installation_request_decode_v1(bytes)?
            val intent = request.intent
            Ok(HostPolicyInstallationRequestV1(HostPolicyInstallationIntentV1(intent.operation_id,
                intent.enrollment_binding_digest, intent.scope, intent.provider_identity_digest,
                intent.containment_policy_bytes, host_containment_installation_intent_encode_v1(intent)?),
                request.operation, request.signed, request.approval, bytes))

pub fn host_policy_installation_action_v1(kind: HostPolicyInstallationKindV1) -> text:
    match kind:
        case HostPolicyInstallationKindV1.ExecControlV3: "host_exec_control_install_v3"
        case HostPolicyInstallationKindV1.ContainmentV1: "host_containment_install_v1"

pub fn host_policy_installation_directory_v1(kind: HostPolicyInstallationKindV1, part: text) -> text:
    match kind:
        case HostPolicyInstallationKindV1.ExecControlV3:
            if part == "packet": "host-exec-control-installations"
            elif part == "artifact": "host-exec-control-installation-artifacts"
            else: "host-exec-control-installed-v3"
        case HostPolicyInstallationKindV1.ContainmentV1:
            if part == "packet": "host-containment-installations-v1"
            elif part == "artifact": "host-containment-installation-artifacts-v1"
            else: "host-containment-installed-v1"

pub fn host_policy_installation_version_v1(kind: HostPolicyInstallationKindV1) -> i64:
    match kind:
        case HostPolicyInstallationKindV1.ExecControlV3: 3
        case HostPolicyInstallationKindV1.ContainmentV1: 1

pub fn host_policy_installation_reference_kind_v1(kind: HostPolicyInstallationKindV1) -> text:
    match kind:
        case HostPolicyInstallationKindV1.ExecControlV3: "host-exec-control-installed"
        case HostPolicyInstallationKindV1.ContainmentV1: "host-containment-installed"

pub fn host_policy_installation_error_v1(kind: HostPolicyInstallationKindV1, error: text) -> text:
    match kind:
        case HostPolicyInstallationKindV1.ExecControlV3: error
        case HostPolicyInstallationKindV1.ContainmentV1: error.replace("host-exec-install-", "host-containment-install-")
