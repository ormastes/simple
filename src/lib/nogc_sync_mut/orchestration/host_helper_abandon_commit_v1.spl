# milestone_0036: the service side of the controller-signed `helper-abandon` operator command. Verify (issuer ==
# controller_ref, V4 signatures at THIS clock/generation/revocation/session, so an expired or old-session abandon is
# refused), check the named row and the operator's observed marker text against the journal, record the proof and marker
# through the single journal writer, then release the Host helper charge with the ordinary capacity settle on the marker
# evidence (host_helper_abandoned_evidence_v1). Never a continuity flip; the capacity owner is returned on every path.
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.{HostCapacityOwnerV1, host_capacity_owner_settle_v1,
    host_capacity_completion_evidence_owned_v2}
use std.nogc_sync_mut.orchestration.host_helper_settlement_commit_v1.HostHelperCancelTurnV1
use std.nogc_sync_mut.orchestration.host_helper_abandon_record_v1.{HostHelperAbandonedV1, host_helper_abandoned_encode_v1,
    host_helper_abandoned_decode_v1, host_helper_abandoned_relative_v1, host_helper_abandon_proof_relative_v1,
    host_helper_abandon_observed_v1}
use std.nogc_sync_mut.orchestration.host_linux_helper_store_v1.host_linux_helper_attach_expected_v1
use std.nogc_sync_mut.io.local_authority_policy_v1.LocalAuthorityPolicyV1
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.distributed_verify_grant_approval_from_snapshot_v2
use std.nogc_sync_mut.daemon_sdk.operation_dispatch_v2.daemon_operation_exact_v2
use std.common.contracts.orchestration.host_helper_abandon_v1.{HostHelperAbandonV1, HostHelperAbandonProofV1,
    host_helper_abandon_proof_decode_v1, host_helper_abandon_match_v1, host_helper_abandon_bytes_v1,
    HOST_HELPER_ABANDON_WIRE_V1, HOST_HELPER_ABANDON_CUSTODY_V1}
use std.common.contracts.orchestration.host_authorization_context_v1.HostReservationAuthorizationContextV1
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.task_runner.distributed_operation_journal_v2.{DistributedOperationJournalV2, distributed_operation_journal_lookup_v2,
    distributed_operation_journal_publish_v3, distributed_operation_journal_read_required_v3}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

# Retain `owner` even on error (single-writer rule, as host_capacity_owner_settle_v1).
# `effect_attempted` is true from the first record write on: a later error may have left the proof or the marker behind.
pub struct HostHelperAbandonTurnV1:
    owner: HostCapacityOwnerV1
    reply: text
    error: text
    effect_attempted: bool

pub fn host_helper_abandon_verify_v1(policy: LocalAuthorityPolicyV1, controller_ref: text,
        context: HostReservationAuthorizationContextV1, host_id: text, source: text) -> Result<HostHelperAbandonProofV1, text>:
    val proof = host_helper_abandon_proof_decode_v1(source)?
    if proof.signed.issuer_id != controller_ref: return Err("linux-host-service-controller-mismatch")
    val _matched = host_helper_abandon_match_v1(proof.abandon, proof.operation)?
    if proof.abandon.physical_host_id != host_id: return Err("helper-abandon-operation-mismatch")
    val _grant = distributed_verify_grant_approval_from_snapshot_v2(policy.snapshot, proof.signed, proof.approval, proof.operation,
        context.grant_clock, policy.snapshot.generation, context.policy_revision, context.revocation_epoch,
        context.session_generation)?
    Ok(proof)

# PURE precondition table over the journal-derived facts. Only an attach-broker helper row that is charged and live
# (executing or outcome-unknown) is abandoned; every digest is the journal's own; the operator voids only the marker
# state they observed. milestone_0043 (REVIEW_B P2-1): a digest or observed-text refusal echoes the journal-derived
# expected value beside the given one (digests and marker tokens only, never a secret), and only after the signed command
# verified, so the operator can re-sign exactly what this service will accept. milestone_0046: the read-only inspect
# (host_helper_abandon_inspect_v1) now returns the same expected values unsigned, over the authenticated V6 channel only;
# they are journal digests and marker tokens, never secrets, and grant nothing.
pub fn host_helper_abandon_check_v1(abandon: HostHelperAbandonV1, operation: OperationEnvelopeV2, row_state: text,
        helper_kind: text, request_digest: text, prepared_receipt_digest: text, observed: text) -> Result<(), text>:
    if operation.operation != "host_helper_reservation_v1" or helper_kind != "attach-broker":
        return Err("helper-abandon-not-attach-broker-helper")
    if abandon.operation_id != operation.id or abandon.operation_digest != sha256_text(distributed_encode_operation_v2(operation)?):
        return Err("helper-abandon-operation-mismatch")
    if row_state != "executing" and row_state != "outcome-unknown": return Err("helper-abandon-row-state")
    if abandon.request_digest != request_digest or abandon.prepared_receipt_digest != prepared_receipt_digest:
        return Err("helper-abandon-request-mismatch:expected-request=" + request_digest + ";given-request=" +
            abandon.request_digest + ";expected-receipt=" + prepared_receipt_digest + ";given-receipt=" +
            abandon.prepared_receipt_digest)
    if abandon.observed != observed:
        return Err("helper-abandon-observed-mismatch:expected=" + observed + "|given=" + abandon.observed)
    Ok(())

# Proof first (keyed by its digest: an orphan left by a crash before the marker is harmless and a freshly signed abandon
# writes its own), then the marker, no-replace and read back; the marker bytes are returned. milestone_0043 (REVIEW_B
# P3-5, P2-4): a marker already present for the SAME helper binding (operation, operation/request/receipt digests) is
# accepted and returned unchanged, so a freshly signed, live-verified abandon finishes a settle that failed or whose
# recorded approval expired; the fresh proof stays retained beside it by its own digest. Any other marker is refused.
pub fn host_helper_abandon_record_publish_v1(journal: DistributedOperationJournalV2, proof: HostHelperAbandonProofV1,
        source: text) -> Result<text, text>:
    val abandon = proof.abandon
    val digest = sha256_text(source)
    val evidence_path = host_helper_abandon_proof_relative_v1(abandon.operation_id, digest)
    val evidence = distributed_operation_journal_publish_v3(journal, evidence_path, source)?
    if not evidence:
        val retained = distributed_operation_journal_read_required_v3(journal, evidence_path, 262144)?
        if retained != source: return Err("helper-abandon-exists")
    val marker = host_helper_abandoned_encode_v1(HostHelperAbandonedV1(operation_id: abandon.operation_id,
        operation_digest: abandon.operation_digest, request_digest: abandon.request_digest,
        prepared_receipt_digest: abandon.prepared_receipt_digest, abandon_digest: digest))?
    val marker_path = host_helper_abandoned_relative_v1(abandon.operation_id)
    val saved = distributed_operation_journal_publish_v3(journal, marker_path, marker)?
    if not saved:
        val existing = distributed_operation_journal_read_required_v3(journal, marker_path, 4096)?
        val recorded = host_helper_abandoned_decode_v1(existing)?
        if (recorded.operation_id != abandon.operation_id or recorded.operation_digest != abandon.operation_digest or
                recorded.request_digest != abandon.request_digest or
                recorded.prepared_receipt_digest != abandon.prepared_receipt_digest):
            return Err("helper-abandon-exists")
        return Ok(existing)
    val readback = distributed_operation_journal_read_required_v3(journal, marker_path, 4096)?
    if readback != marker: return Err("helper-abandon-readback")
    Ok(marker)

# milestone_0043 (REVIEW_B P2-4): what the start resume needs to re-verify a recorded abandon, from the service's own
# verified records and its live clock (the same inputs the in-incarnation command verifies against).
pub struct HostHelperAbandonRecheckV1:
    policy: LocalAuthorityPolicyV1
    controller_ref: text
    context: HostReservationAuthorizationContextV1
    host_id: text

fn helper_abandon_recorded_v1(journal: DistributedOperationJournalV2, operation: OperationEnvelopeV2,
        recheck: HostHelperAbandonRecheckV1) -> Result<(), text>:
    val marker = distributed_operation_journal_read_required_v3(journal, host_helper_abandoned_relative_v1(operation.id), 4096)?
    val record = host_helper_abandoned_decode_v1(marker)?
    val source = distributed_operation_journal_read_required_v3(journal,
        host_helper_abandon_proof_relative_v1(operation.id, record.abandon_digest), 262144)?
    if sha256_text(source) != record.abandon_digest: return Err("helper-abandoned-proof-digest")
    val proof = host_helper_abandon_verify_v1(recheck.policy, recheck.controller_ref, recheck.context, recheck.host_id, source)?
    if proof.abandon.operation_id != operation.id: return Err("helper-abandoned-proof-mismatch")
    Ok(())

# The start resume's re-verification of a recorded abandon before its settle, like the service-handoff twin: the retained
# signed proof must verify again at THIS clock, policy generation, revocation epoch and session. An approval that expired
# or was revoked since it was recorded is an Err: the row stays held (never settled on a stale decision) and the error is
# reported; a freshly signed abandon then finishes it on the same marker (host_helper_abandon_record_publish_v1).
pub fn host_helper_abandon_recorded_verify_v1(journal: DistributedOperationJournalV2, operation: OperationEnvelopeV2,
        recheck: HostHelperAbandonRecheckV1) -> Result<(), text>:
    val verified = helper_abandon_recorded_v1(journal, operation, recheck)
    if verified.is_err(): return Err("helper-abandon-recorded-unverified:" + verified.unwrap_err())
    Ok(())

# Release on the recorded marker evidence: the evidence arm returns the marker bytes verbatim, so sha256(outcome) is the
# recorded outcome digest. A row already completed with that outcome is an idempotent Ok.
pub fn host_helper_abandon_commit_v1(owner: HostCapacityOwnerV1, operation: OperationEnvelopeV2) -> HostHelperCancelTurnV1:
    val evidence = host_capacity_completion_evidence_owned_v2(owner.journal, owner.ledger.capacity, operation)
    if evidence.is_err(): return HostHelperCancelTurnV1(owner, None, evidence.unwrap_err())
    val outcome = evidence.unwrap()
    val committed = host_capacity_owner_settle_v1(owner, operation)
    if not committed.settled: return HostHelperCancelTurnV1(committed.owner, None, committed.error)
    val state = daemon_operation_exact_v2(committed.owner.journal, operation)
    if state.is_err(): return HostHelperCancelTurnV1(committed.owner, None, state.unwrap_err())
    if state.unwrap().state != "completed" or state.unwrap().outcome_digest != sha256_text(outcome):
        return HostHelperCancelTurnV1(committed.owner, None, "helper-abandon-journal-settlement-mismatch")
    HostHelperCancelTurnV1(committed.owner, None, "")

fn helper_abandon_reply_v1(operation_id: text, digest: text) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("helper-abandoned"),
        "operationId": SdnValue.String(operation_id), "digest": SdnValue.String(digest)}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

# milestone_0046: ONE derivation of the abandon record this service accepts for a helper row right now, used by the
# signed command (host_helper_abandon_v1) and by the read-only inspect the controller reads before the operator signs.
# The row's kind and state gate run on the derived record itself, so an inspect of a row no abandon can release refuses
# with the same code the command would. Unsigned DATA: it grants nothing; the command re-derives it after verification.
pub struct HostHelperAbandonExpectedV1:
    operation: OperationEnvelopeV2
    row_state: text
    helper_kind: text
    record: HostHelperAbandonV1

pub fn host_helper_abandon_expected_v1(journal: DistributedOperationJournalV2, operation_id: text,
        host_id: text) -> Result<HostHelperAbandonExpectedV1, text>:
    val state = distributed_operation_journal_lookup_v2(journal, operation_id)?
    val operation = distributed_decode_operation_v2(state.envelope)?
    val expected = host_linux_helper_attach_expected_v1(journal, operation)?
    val record = HostHelperAbandonV1(wire_version: HOST_HELPER_ABANDON_WIRE_V1, operation_id: operation.id,
        operation_digest: sha256_text(distributed_encode_operation_v2(operation)?), request_digest: expected.request_digest,
        prepared_receipt_digest: expected.prepared_receipt_digest,
        observed: host_helper_abandon_observed_v1(journal, operation.id, state.state), custody: HOST_HELPER_ABANDON_CUSTODY_V1,
        physical_host_id: host_id)
    host_helper_abandon_check_v1(record, operation, state.state, expected.plan.helper_kind, record.request_digest,
        record.prepared_receipt_digest, record.observed)?
    Ok(HostHelperAbandonExpectedV1(operation: operation, row_state: state.state, helper_kind: expected.plan.helper_kind,
        record: record))

# The read-only inspect reply: the canonical record bytes (host_helper_abandon_decode_v1 accepts exactly these).
pub fn host_helper_abandon_inspect_v1(journal: DistributedOperationJournalV2, operation_id: text, host_id: text) -> Result<text, text>:
    host_helper_abandon_bytes_v1((host_helper_abandon_expected_v1(journal, operation_id, host_id)?).record)

# The operator command. `owner` is the held capacity owner (single journal writer); it is returned on every path.
pub fn host_helper_abandon_v1(owner: HostCapacityOwnerV1, policy: LocalAuthorityPolicyV1, controller_ref: text,
        context: HostReservationAuthorizationContextV1, host_id: text, source: text) -> HostHelperAbandonTurnV1:
    val proof = host_helper_abandon_verify_v1(policy, controller_ref, context, host_id, source)
    if proof.is_err(): return HostHelperAbandonTurnV1(owner, "", proof.unwrap_err(), false)
    val abandon = proof.unwrap().abandon
    val derived = host_helper_abandon_expected_v1(owner.journal, abandon.operation_id, host_id)
    if derived.is_err(): return HostHelperAbandonTurnV1(owner, "", derived.unwrap_err(), false)
    val expected = derived.unwrap()
    val checked = host_helper_abandon_check_v1(abandon, expected.operation, expected.row_state, expected.helper_kind,
        expected.record.request_digest, expected.record.prepared_receipt_digest, expected.record.observed)
    if checked.is_err(): return HostHelperAbandonTurnV1(owner, "", checked.unwrap_err(), false)
    val marker = host_helper_abandon_record_publish_v1(owner.journal, proof.unwrap(), source)
    if marker.is_err(): return HostHelperAbandonTurnV1(owner, "", marker.unwrap_err(), true)
    val committed = host_helper_abandon_commit_v1(owner, expected.operation)
    if committed.error != "": return HostHelperAbandonTurnV1(committed.owner, "", committed.error, true)
    HostHelperAbandonTurnV1(committed.owner, helper_abandon_reply_v1(abandon.operation_id, sha256_text(marker.unwrap())), "", true)
