# Explicit retained-service route. Existing local-inprocess V2 admission is
# unchanged; neither route may be relabeled to bypass its installed selection.
use std.nogc_sync_mut.orchestration.controller_dispatch_config_v1.ControllerDispatchContextV1
use std.nogc_sync_mut.orchestration.controller_dispatch_authority_v2.ControllerDispatchProofsV2
use std.common.contracts.orchestration.controller_dispatch_request_v2.{ControllerDispatchRequestV2, controller_dispatch_request_encode_v2}
use std.common.contracts.distributed_control_v2.{ExecutionGrantV2, OperationEnvelopeV2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.distributed_verify_grant_approval_from_snapshot_v2

fn controller_route_proof_v3(context: ControllerDispatchContextV1,
        signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2,
        original: OperationEnvelopeV2, action: text, now: i64) -> Result<ExecutionGrantV2, text>:
    var operation = original
    operation.operation = action
    val snapshot = context.policy.snapshot
    distributed_verify_grant_approval_from_snapshot_v2(snapshot, signed, approval, operation, now,
        snapshot.generation, snapshot.policy_revision, snapshot.revocation_epoch, context.policy.session_generation)

pub fn controller_dispatch_authorize_v3(context: ControllerDispatchContextV1,
        packet: ControllerDispatchRequestV2, now: i64) -> Result<ControllerDispatchProofsV2, text>:
    if now <= 0: return Err("dispatch-wall-clock-unavailable")
    val encoded = controller_dispatch_request_encode_v2(packet)?
    if context.config.target != "retained-host-service-v1": return Err("dispatch-host-route-mismatch")
    if (packet.binding.controller_id != context.config.controller_id or
            packet.binding.controller_epoch != context.config.controller_epoch):
        return Err("dispatch-controller-scope-mismatch")
    if packet.binding.host_intent.fence.authority_id != context.config.host_authority_id:
        return Err("dispatch-host-route-mismatch")
    val assignment = controller_route_proof_v3(context, packet.assignment_signed, packet.assignment_approval,
        packet.operation, "controller_assignment_v1", now)?
    val execution = controller_route_proof_v3(context, packet.execution_signed, packet.execution_approval,
        packet.operation, "controller_execute_v1", now)?
    val prepared = controller_route_proof_v3(context, packet.prepare_signed, packet.prepare_approval,
        packet.binding.host_operation, "host_reservation_v1", now)?
    val launched = controller_route_proof_v3(context, packet.host_execution_signed, packet.host_execution_approval,
        packet.binding.host_operation, "host_execute_v1", now)?
    Ok(ControllerDispatchProofsV2(assignment, execution))
