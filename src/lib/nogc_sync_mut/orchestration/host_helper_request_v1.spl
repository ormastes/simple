# Canonical untrusted request/data persistence, never a helper lease decoder.
# Store root is supplied only by the trusted journal owner. Digest/readback
# protects immutable bytes; callers MUST revalidate current proofs/context.
use std.common.contracts.orchestration.host_helper_plan_v1.*
use std.common.contracts.orchestration.controller_parent_budget_v1.*
use std.common.contracts.orchestration.assignment_v1.{ControllerAssignmentBindingV1, controller_assignment_bytes_v1, controller_assignment_decode_reference_v1, controller_assignment_restore_v1}
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.sdn.value.SdnValue
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.encode.sdn_encode_canonical
use std.common.string_core.str_len
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.io.file_ops.{file_exists, file_create_exclusive, file_read_regular_no_follow_bounded, file_fsync, directory_fsync}
use std.nogc_sync_mut.io_runtime.dir_create
use std.nogc_sync_mut.file_system.permissions.file_set_mode

pub struct HostHelperRequestV1:
    plan: HostHelperPlanV1
    intent: HostReservationIntentV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2
    budget_proof: ControllerParentBudgetProofV1
    parent_binding: ControllerAssignmentBindingV1
    parent_controller_operation: OperationEnvelopeV2

pub fn host_helper_request_encode_v1(request: HostHelperRequestV1) -> Result<text, text>:
    val matching = host_helper_reservation_match_operation_v1(request.intent, request.operation)?
    val budget = request.budget_proof.budget
    val parent = controller_parent_budget_match_v1(budget, request.budget_proof.operation,
        request.parent_binding, request.parent_controller_operation)?
    if (request.intent.plan_digest != host_helper_plan_digest_v1(request.plan)? or request.plan.operation_id != request.operation.id or
            request.plan.parent_budget_digest != controller_parent_budget_digest_v1(budget)? or
            request.plan.parent_operation_id != budget.parent_operation_id or request.plan.parent_operation_digest != budget.parent_operation_digest or
            request.plan.parent_assignment_digest != budget.parent_assignment_digest):
        return Err("helper-request-binding-mismatch")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("host-helper-request"),
        "plan": SdnValue.String(host_helper_plan_bytes_v1(request.plan)?),
        "reservation": SdnValue.String(host_reservation_encode_intent_v1(request.intent)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(request.operation)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(request.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(request.approval)?),
        "budgetProof": SdnValue.String(controller_parent_budget_proof_encode_v1(request.budget_proof)?),
        "parentBinding": SdnValue.String(controller_assignment_bytes_v1(request.parent_binding)?),
        "parentIntent": SdnValue.String(host_reservation_encode_intent_v1(request.parent_binding.host_intent)?),
        "parentHostOperation": SdnValue.String(distributed_encode_operation_v2(request.parent_binding.host_operation)?),
        "parentControllerOperation": SdnValue.String(distributed_encode_operation_v2(request.parent_controller_operation)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(bytes) > 2097152: return Err("helper-request-size")
    Ok(bytes)

fn helper_request_fields_v1(source: text) -> Result<Dict<text, SdnValue>, text>:
    if str_len(source) == 0 or str_len(source) > 2097152: return Err("helper-request-size")
    val limits = SdnStrictLimitsV1(max_source_bytes: 2097152, max_depth: 2, max_nodes: 32,
        max_rows: 0, max_cells: 0, max_columns: 16)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err("helper-request-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(items): items
        case _: return Err("helper-request-object-required")
    Ok(fields)

fn helper_request_text_v1(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("helper-request-text-required:" + name)

pub fn host_helper_request_decode_v1(source: text) -> Result<HostHelperRequestV1, text>:
    val fields = helper_request_fields_v1(source)?
    val names = ["version", "kind", "plan", "reservation", "operation", "signedGrant", "signedApproval", "budgetProof",
        "parentBinding", "parentIntent", "parentHostOperation", "parentControllerOperation"]
    for name in fields.keys():
        if not names.contains(name): return Err("helper-request-unknown-field:" + name)
    for name in names:
        if not fields.contains_key(name): return Err("helper-request-missing-field:" + name)
    if fields["version"] != SdnValue.Int(1) or helper_request_text_v1(fields, "kind")? != "host-helper-request":
        return Err("helper-request-version")
    val reference = controller_assignment_decode_reference_v1(helper_request_text_v1(fields, "parentBinding")?)?
    val binding = controller_assignment_restore_v1(reference, helper_request_text_v1(fields, "parentIntent")?,
        helper_request_text_v1(fields, "parentHostOperation")?)?
    val request = HostHelperRequestV1(plan: host_helper_plan_decode_v1(helper_request_text_v1(fields, "plan")?)?,
        intent: host_reservation_decode_intent_v1(helper_request_text_v1(fields, "reservation")?)?,
        operation: distributed_decode_operation_v2(helper_request_text_v1(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(helper_request_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(helper_request_text_v1(fields, "signedApproval")?)?,
        budget_proof: controller_parent_budget_proof_decode_v1(helper_request_text_v1(fields, "budgetProof")?)?,
        parent_binding: binding, parent_controller_operation: distributed_decode_operation_v2(helper_request_text_v1(fields, "parentControllerOperation")?)?)
    if host_helper_request_encode_v1(request)? != source: return Err("helper-request-noncanonical")
    Ok(request)

fn helper_request_publish_v1(root: text, directory_name: text, key: text, bytes: text) -> Result<text, text>:
    val directory = root + "/" + directory_name
    if not file_exists(directory) and not dir_create(directory, true): return Err("helper-request-directory-unavailable")
    val path = directory + "/" + key + ".sdn"
    val created = file_create_exclusive(path, bytes)
    if created and not file_set_mode(path, 0o600): return Err("helper-request-mode-failed")
    # An existing partial/unknown/symlink entry is evidence, not replaceable
    # cache space. Exact regular no-follow readback also checks create failure.
    if file_read_regular_no_follow_bounded(path, 2097152)? != bytes: return Err("helper-request-retained-mismatch")
    if not file_fsync(path) or not directory_fsync(directory) or not directory_fsync(root): return Err("helper-request-sync-failed")
    Ok(path)

pub fn host_helper_request_store_v1(root: text, request: HostHelperRequestV1) -> Result<text, text>:
    val bytes = host_helper_request_encode_v1(request)?
    val digest = sha256_text(bytes)
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("host-helper-request-reference"),
        "operationId": SdnValue.String(request.operation.id), "packetDigest": SdnValue.String(digest)}
    val reference = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    val index_path = root + "/host-helper-requests/" + sha256_text(request.operation.id) + ".sdn"
    if file_exists(index_path):
        if file_read_regular_no_follow_bounded(index_path, 4096)? != reference: return Err("helper-request-retained-mismatch")
    val packet = helper_request_publish_v1(root, "host-helper-request-packets", digest, bytes)?
    helper_request_publish_v1(root, "host-helper-requests", sha256_text(request.operation.id), reference)

pub fn host_helper_request_load_v1(root: text, operation_id: text) -> Result<HostHelperRequestV1, text>:
    if not builder_identifier_valid_v1(operation_id): return Err("helper-request-operation-invalid")
    val reference = file_read_regular_no_follow_bounded(root + "/host-helper-requests/" + sha256_text(operation_id) + ".sdn", 4096)?
    val fields = helper_request_fields_v1(reference)?
    val names = ["version", "kind", "operationId", "packetDigest"]
    for name in fields.keys():
        if not names.contains(name): return Err("helper-request-reference-unknown-field")
    for name in names:
        if not fields.contains_key(name): return Err("helper-request-reference-missing-field")
    if fields["version"] != SdnValue.Int(1) or helper_request_text_v1(fields, "kind")? != "host-helper-request-reference":
        return Err("helper-request-reference-version")
    if helper_request_text_v1(fields, "operationId")? != operation_id: return Err("helper-request-operation-mismatch")
    val digest = helper_request_text_v1(fields, "packetDigest")?
    if str_len(digest) != 64 or not builder_digest_valid_v1(digest): return Err("helper-request-reference-digest-invalid")
    if sdn_encode_canonical(SdnValue.Dict(fields)) + "\n" != reference: return Err("helper-request-reference-noncanonical")
    val bytes = file_read_regular_no_follow_bounded(root + "/host-helper-request-packets/" + digest + ".sdn", 2097152)?
    if sha256_text(bytes) != digest: return Err("helper-request-packet-digest-mismatch")
    val request = host_helper_request_decode_v1(bytes)?
    if request.operation.id != operation_id: return Err("helper-request-operation-mismatch")
    Ok(request)

# Execution proof data, not an encoded lease/capability. Caller verifies current
# publishers, parent budget and context before publication/begin/effects.
pub fn host_helper_execution_proof_encode_v1(request: HostHelperRequestV1,
        signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2) -> Result<text, text>:
    val request_bytes = host_helper_request_encode_v1(request)?
    val operation = distributed_encode_operation_v2(request.operation)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("host-helper-execution-proof"),
        "requestDigest": SdnValue.String(sha256_text(request_bytes)), "operationDigest": SdnValue.String(sha256_text(operation)),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(approval)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(bytes) > 1048576: return Err("helper-execution-proof-size")
    Ok(bytes)

pub fn host_helper_execution_proof_store_v1(root: text, request: HostHelperRequestV1,
        signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2) -> Result<text, text>:
    val retained = host_helper_request_load_v1(root, request.operation.id)?
    if host_helper_request_encode_v1(retained)? != host_helper_request_encode_v1(request)?:
        return Err("helper-execution-proof-request-mismatch")
    val bytes = host_helper_execution_proof_encode_v1(request, signed, approval)?
    helper_request_publish_v1(root, "host-helper-execution-proofs", sha256_text(request.operation.id), bytes)

pub fn host_helper_execution_proof_load_v1(root: text, operation_id: text) -> Result<text, text>:
    val request = host_helper_request_load_v1(root, operation_id)?
    val bytes = file_read_regular_no_follow_bounded(root + "/host-helper-execution-proofs/" + sha256_text(operation_id) + ".sdn", 1048576)?
    val fields = helper_request_fields_v1(bytes)?
    val names = ["version", "kind", "requestDigest", "operationDigest", "signedGrant", "signedApproval"]
    for name in fields.keys():
        if not names.contains(name): return Err("helper-execution-proof-unknown-field")
    for name in names:
        if not fields.contains_key(name): return Err("helper-execution-proof-missing-field")
    if fields["version"] != SdnValue.Int(1) or helper_request_text_v1(fields, "kind")? != "host-helper-execution-proof":
        return Err("helper-execution-proof-version")
    val signed = distributed_decode_signed_grant_v2(helper_request_text_v1(fields, "signedGrant")?)?
    val approval = distributed_decode_signed_approval_v2(helper_request_text_v1(fields, "signedApproval")?)?
    if host_helper_execution_proof_encode_v1(request, signed, approval)? != bytes:
        return Err("helper-execution-proof-binding-or-canonical-mismatch")
    Ok(bytes)
