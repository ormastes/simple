# 13.3 / 14.1 D2 / 13.1 bounds (ms, on the agent clock `clock_ms`).
pub const HOST_AGENT_DETACH_GRACE_MS_V4: i64 = 120000
pub const HOST_AGENT_ATTACH_PREPARE_TTL_MS_V4: i64 = 60000
pub const HOST_AGENT_EXPIRE_SLACK_MS_V4: i64 = 5000
pub const HOST_AGENT_ATTACH_READY_MS_V4: i64 = 30000
pub const HOST_AGENT_PANE_IO_MS_V4: i64 = 60000
pub const HOST_AGENT_DETACH_REFUSAL_LIMIT_V4: i64 = 64
# P2-1: the hard cap on consecutive non-advancing port answers (a counted Wait, or Progress without a later
# sub-step); the same 64 bound semantic as D5, on its own counter.
pub const HOST_AGENT_NON_ADVANCING_LIMIT_V4: i64 = 64
pub const HOST_AGENT_ATTACH_MAX_BYTES_V4: i64 = 1048576
pub const HOST_AGENT_DETACH_MAX_BYTES_V4: i64 = 65536

# attach_stage values (14.0 rows; RT = attachment None + summary, N0 = attachment None, no summary).
pub const HOST_AGENT_ATTACH_REFUSED_V4 = "refused"
pub const HOST_AGENT_ATTACH_EXPIRE_PENDING_V4 = "refused-expire-pending"
pub const HOST_AGENT_ATTACH_OPENING_V4 = "opening"
pub const HOST_AGENT_ATTACH_READY_V4 = "ready"
pub const HOST_AGENT_ATTACH_ADOPTED_V4 = "adopted"
pub const HOST_AGENT_ATTACH_REVOKED_V4 = "revoked"
pub const HOST_AGENT_ATTACH_CLEANED_V4 = "cleaned"
pub const HOST_AGENT_ATTACH_SETTLING_V4 = "settling"
pub const HOST_AGENT_ATTACH_RETURNED_V4 = "returned"
pub const HOST_AGENT_ATTACH_FAILED_V4 = "failed"
pub const HOST_AGENT_ATTACH_BLOCKED_V4 = "release-blocked"

# The attachment (13.1 + 14A F6 + D7 stored inputs + 14B binding). NO capacity and NO container inside: the
# agent's `container` is the one holder and is only borrowed within one call (I5). Never persisted (13.6).
pub struct HostAgentAttachmentV4:
    # Native carriers; part 2's port writes each back after every call (one canonical session copy).
    helper: Option<HostHelperLeaseV1> = None
    session: Option<ContainerPrimaryAttachSessionV1> = None
    cleanup_spawn: Option<PipedProcessOwnedSpawnV2> = None
    native_retirement: Option<ContainerPrimaryTransportRetirementV3> = None
    # F d2 done: the spawn's native group was proven quiet; d3 (the container-side retirement) is next.
    fallback_quiesced: bool = false
    # milestone_0031 (DESIGN 11.4): sha256 of the quiesce proof of the spawn carrier, set by d2 of F and B. B drops
    # the carrier right then, so this digest is all that is kept of it; it is reported and survives in the summary.
    quiesce_proof_digest: text = ""
    settlement: Option<HostHelperSettlementAckV1> = None
    geometry: Option<ContainerPrimaryGeometryOwnerV1> = None
    # 13.4: the geometry owner was cancelled by the release and is being drained (one step per call).
    geometry_cancelled: bool = false
    consumption_attempted: bool = false
    # D7: every input a later unsigned call needs (driver, close, pane io). Option only so the shape has a
    # default; an attachment created by host_agent_attach_apply_v4 always carries them.
    parent: Option<OperationEnvelopeV2> = None
    plan: Option<ContainerPrimaryAttachPlanV1> = None
    binding: Option<HostAgentPaneBindingV4> = None
    not_after: i64 = 0
    policy_bytes: text = ""
    helper_request_bytes: text = ""
    store_root: text = ""
    # milestone_0023 part B: the controller-signed `host_helper_execute_v1` grant and stream policy of the VERIFIED
    # attach packet (both covered by the signed attach payload digest); helper begin re-verifies the grant live.
    helper_execute_signed: Option<DistributedSignedGrantV2> = None
    helper_execute_approval: Option<DistributedSignedApprovalV2> = None
    stream_policy: Option<ContainerStreamPolicyV2> = None
    # A prepared-but-not-begun helper receipt (RP until expired, 13.2).
    prepared_receipt_digest: text = ""
    prepare_deadline_ms: i64 = 0
    # F6: helper begin committed an executing owner without returning a lease (recovery required): held.
    begin_attempted: bool = false
    # D8: an open/cleanup/settle core step is in flight (not an attach_stage).
    attach_pending: bool = false
    eof: bool = false
    attach_stage: text = "opening"
    lease_epoch: i64 = 0
    # The pane lease is handed out once per attachment (13.1 lease-once).
    lease_issued: bool = false
    ready_deadline_ms: i64 = 0
    io_deadline_ms: i64 = 0
    # D5/F4: the detach bound; `detach_bound` records that the deadline was initialised.
    detach_bound: bool = false
    detach_deadline_ms: i64 = 0
    detach_refusals: i64 = 0
    # P2-1: consecutive non-advancing port answers since the last later sub-step (cap HOST_AGENT_NON_ADVANCING_LIMIT_V4).
    non_advancing: i64 = 0
    attach_digest: text = ""
    detach_digest: text = ""
    first_error: text = ""

# Kept on the agent after `returned` (13.1).
pub struct HostAgentAttachmentSummaryV4:
    attach_digest: text
    detach_digest: text
    final_stage: text
    error: text
    # The attachment's `quiesce_proof_digest` ("" when no spawn carrier was ever quiesced).
    quiesce_proof_digest: text = ""

# ---- classification (14.0) ----

# held(att): any native carrier, a prepared receipt, or a committed begin without a lease (F6).
# allow(primitive_api): reviewed classification predicate (milestone_0021 14.0)
pub fn host_agent_attachment_held_v4(attachment: HostAgentAttachmentV4) -> bool:
    (attachment.helper.is_some() or attachment.session.is_some() or attachment.cleanup_spawn.is_some() or
        attachment.native_retirement.is_some() or attachment.geometry.is_some() or
        attachment.prepared_receipt_digest != "" or attachment.begin_attempted)

# LIVE = attach_stage not in {RT, RF} (D1); RT is the absent attachment, so only `refused` is non-live here.
# allow(primitive_api): reviewed classification predicate (milestone_0021 14.0 D1)
pub fn host_agent_attachment_live_v4(attachment: Option<HostAgentAttachmentV4>) -> bool:
    if val held = attachment:
        return held.attach_stage != HOST_AGENT_ATTACH_REFUSED_V4 and held.attach_stage != HOST_AGENT_ATTACH_RETURNED_V4
    false

# An attach sub-step in flight defers the native Inspect (13.3, D8): opening/revoked/cleaned/settling or a core
# step pending. ready/adopted never do.
# allow(primitive_api): reviewed classification predicate (milestone_0021 13.3)
pub fn host_agent_attachment_in_flight_v4(attachment: HostAgentAttachmentV4) -> bool:
    attachment.attach_pending or [HOST_AGENT_ATTACH_OPENING_V4, HOST_AGENT_ATTACH_REVOKED_V4, HOST_AGENT_ATTACH_CLEANED_V4,
        HOST_AGENT_ATTACH_SETTLING_V4].contains(attachment.attach_stage)

# F4 progress order: d1 (revoked) < d2 (cleaned) < d3 (settling) < returned/refused. `failed` ranks WITH revoked,
# so d1 alone from FL is not progress; release-blocked ranks below everything (terminal).
# allow(primitive_api): reviewed progress rank (milestone_0021 14A F4)
pub fn host_agent_attachment_rank_v4(stage: text) -> i64:
    if stage == HOST_AGENT_ATTACH_BLOCKED_V4: return -1
    if stage == HOST_AGENT_ATTACH_FAILED_V4 or stage == HOST_AGENT_ATTACH_REVOKED_V4: return 1
    if stage == HOST_AGENT_ATTACH_CLEANED_V4: return 2
    if stage == HOST_AGENT_ATTACH_SETTLING_V4: return 3
    if stage == HOST_AGENT_ATTACH_RETURNED_V4 or stage == HOST_AGENT_ATTACH_REFUSED_V4: return 4
    0

# Initialise the detach bound once, or keep the LATER deadline (F4, r7 P3-2).
# allow(primitive_api): reviewed deadline DATA word (milestone_0021 14A F4)
pub fn host_agent_attachment_arm_bound_v4(attachment: HostAgentAttachmentV4, deadline_ms: i64) -> HostAgentAttachmentV4:
    var att = attachment
    if not att.detach_bound:
        att.detach_bound = true
        att.detach_deadline_ms = deadline_ms
        att.detach_refusals = 0
    elif deadline_ms > att.detach_deadline_ms:
        att.detach_deadline_ms = deadline_ms
    att

# The post-archive failure writer rule (14.0 P1-1, D2b, F6): a prepared-not-begun receipt -> RP (deadline per D2b);
# anything held -> FL (bound initialised); nothing held -> RF before helper begin, else RT (`returned` with the
# error kept; the agent records summary.final_stage = "failed").
# allow(primitive_api): reviewed post-begin flag + clock DATA word (milestone_0021 14.0, 14A F6)
pub fn host_agent_attachment_failure_v4(attachment: HostAgentAttachmentV4, error: text, post_begin: bool, now: i64) -> HostAgentAttachmentV4:
    var att = attachment
    if att.first_error == "": att.first_error = error
    att.attach_pending = false
    if att.prepared_receipt_digest != "" and att.helper.is_none() and not att.begin_attempted:
        att.attach_stage = HOST_AGENT_ATTACH_EXPIRE_PENDING_V4
        var deadline = now + HOST_AGENT_DETACH_GRACE_MS_V4
        if att.prepare_deadline_ms + HOST_AGENT_EXPIRE_SLACK_MS_V4 > deadline:
            deadline = att.prepare_deadline_ms + HOST_AGENT_EXPIRE_SLACK_MS_V4
        return host_agent_attachment_arm_bound_v4(att, deadline)
    if host_agent_attachment_held_v4(att):
        att.attach_stage = HOST_AGENT_ATTACH_FAILED_V4
        return host_agent_attachment_arm_bound_v4(att, now + HOST_AGENT_DETACH_GRACE_MS_V4)
    att.attach_stage = if post_begin: HOST_AGENT_ATTACH_RETURNED_V4 else: HOST_AGENT_ATTACH_REFUSED_V4
    att

# ---- release / pane-io PORTS (13.4, 13.5, 14 D8/D9, 14A F4) ----

# Progress = the port reached a later sub-step (the machine re-checks with the rank; OP -> RD counts as one);
# Wait = nothing to do yet; Refused = a retryable refusal (counted, D5); Blocked = a typed non-retryable error or
# a charged-forever state (F4) -> RB.
#
# PORT OBLIGATIONS (the production port below honours them; the machine enforces the bounds either way):
# - Finiteness (P2-1). Every answer must eventually be a later sub-step, a refusal or Blocked. The machine counts
#   consecutive non-advancing answers in `non_advancing` (a Wait, or a Progress that is not a later sub-step,
#   e.g. a d2 cleanup answering Progress at the same sub-step, or a geometry drain) and takes the attachment to
#   RB at HOST_AGENT_NON_ADVANCING_LIMIT_V4. Exactly two waits are uncounted because they are bounded elsewhere:
#   (a) a Wait while `pending` (D8 deferred d4: the step driver drains the native step first); (b) an RP
#   `prepare-not-expired` Wait (D2c), bounded by `prepare_deadline_ms + HOST_AGENT_EXPIRE_SLACK_MS_V4` (D2b),
#   past which the machine takes RB. Every OTHER answer while `pending` (Refused, Blocked, a same-rank Progress)
#   is still counted; it only never wedges until the native step drained (I2).
# - Classification up front (F4, P3-2). At FL the machine first calls the port as a READ-ONLY classifier: a
#   charged-forever state answers Blocked (RB in that same call, at `running` as well as `detach`); any other
#   answer lets the machine take d1. The port must not change anything at FL.
# - Write-back (13.4, 13.5, I5). The machine lends `agent.container` in the call and adopts `step.container`
#   when it is Some; the capacity owner the port advanced comes back in `step.capacity` and the caller adopts it
#   (single journal writer). The session in `step.attachment` is the ONE canonical copy.
pub enum HostAgentReleaseOutcomeV4:
    Progress
    Wait
    Refused
    Blocked

pub struct HostAgentAttachmentPortCallV4:
    attachment: HostAgentAttachmentV4
    now: i64
    # agent.pending: d4 session_return needs the container and WAITs while a native step is in flight (D8).
    pending: bool
    # The agent's transfer holder, lent for this call only (I5).
    container: Option<SimpleContainerOwnerV2> = None
    # A FORCED release (signed detach, stage `detach`, wedged/failed, close): OP never prepares or begins then.
    release: bool = false
    # The runtime identity the agent observed at Create (agent.created); the open core reproduces the plan with it.
    runtime: Option<RuntimeIdentityV1> = None

pub struct HostAgentAttachmentReleaseStepV4:
    attachment: HostAgentAttachmentV4
    outcome: HostAgentReleaseOutcomeV4
    error: text
    capacity: Option<HostCapacityOwnerV1> = None
    container: Option<SimpleContainerOwnerV2> = None

# What the production port needs that is not attachment state (13.5): the service's capacity owner (the journal
# writer), the helper store `HostHelperStoreV1(helper_store, Some(capacity.journal))`, and the monotonic clock
# of the prepared-receipt expire (the receipt's deadline is monotonic). The attachment's own `prepare_deadline_ms`
# is stored on the GRANT clock (host_agent_attach_grant_deadline_v4), the clock every attachment bound runs on.
# Built by the caller for ONE call, captured by the port closure, never stored.
pub struct HostAgentReleaseContextV4:
    capacity: HostCapacityOwnerV1
    store: HostHelperStoreV1
    monotonic_ms: i64

# 13.2 effects never start under a forced release or through a port without open context (close, signed detach):
# an OP attachment then ends by the 14.0 writer rule with this error (RF with nothing held, RP with a receipt).
pub const HOST_AGENT_ATTACH_OPEN_ABANDONED_V4 = "linux-host-agent-attach-open-abandoned"
const HOST_AGENT_ATTACH_OPEN_INPUT_V4 = "linux-host-agent-attach-open-input-missing"

# What the attach effects need that is neither attachment state nor the release context (milestone_0023 part B):
# the installed policy and live service scope of helper prepare/begin, the authorization context of this call,
# and the parent of the open core, re-derived by the step driver on EVERY call from the archived signed execute
# (`parent` is the journal row's prepare operation; `execution` is the association's execution request). Built for
# ONE call next to a `refresh` closure, captured by the port closure, never stored.
pub struct HostAgentOpenContextV4:
    policy: LocalAuthorityPolicyV1
    scope: ContainerHostScopeV2
    context: HostReservationAuthorizationContextV1
    parent: OperationEnvelopeV2
    execution: ContainerExecutionRequestV2
# One geometry drain step (the native step budget is 1..25 ms; 1 matches terminal_primary_geometry_v2).
const HOST_AGENT_GEOMETRY_STEP_MS_V4: i64 = 1

fn host_agent_release_answer_v4(attachment: HostAgentAttachmentV4, outcome: HostAgentReleaseOutcomeV4, error: text,
        capacity: HostCapacityOwnerV1, container: Option<SimpleContainerOwnerV2>) -> HostAgentAttachmentReleaseStepV4:
    HostAgentAttachmentReleaseStepV4(attachment: attachment, outcome: outcome, error: error, capacity: Some(capacity),
        container: container)

# F4 classification, read-only: "" = a release exists (S or U'); otherwise the typed charged-forever reason
# (milestone_0022 16 P3-2: begin without a lease, a Rejected spawn carrier, `{PA}` alone = no journal refusal R
# for a helper with no session whose consume publish was attempted).
# milestone_0031: `{}` alone is NOT charged forever any more. A helper with no session, no spawn and no R whose
# open core never reached its consume publish (`consumption_attempted` false: the entry guard refused, or the
# pre-consume R publish itself failed) was never consumed, so U' can still record that refusal and cancel.
fn host_agent_release_charged_v4(attachment: HostAgentAttachmentV4, store: HostHelperStoreV1) -> text:
    if attachment.helper.is_none(): return "linux-host-agent-attach-begin-without-lease"
    if store.root == "": return "linux-host-agent-attach-store-unopened"
    # F/B (milestone_0026): a Rejected spawn carries no owner, so the absence of a live member cannot be proven.
    if val held = attachment.cleanup_spawn:
        match held:
            case PipedProcessOwnedSpawnV2.Rejected(_): return "linux-host-agent-attach-native-absence-unproven"
            case _: ()
    if attachment.plan.is_none(): return "linux-host-agent-attach-plan-missing"
    # S has a session; F/B have a spawn carrier and never a journal refusal R (R is only written with neither).
    if attachment.session.is_some() or attachment.cleanup_spawn.is_some(): return ""
    if store.journal.is_none(): return "linux-host-agent-attach-store-journal-missing"
    val relative = host_linux_helper_journal_relative_v1("primary-refusal", attachment.helper.unwrap().operation.id)
    match distributed_operation_journal_read_v3(store.journal.unwrap(), relative, 65536):
        case Ok(found):
            if found.is_some() or not attachment.consumption_attempted: "" else: "linux-host-agent-attach-unrecorded-helper"
        case Err(reason): reason

# An attach that ends at OP or during its effects is FINAL per the 14.0 writer rule: nothing held -> RF (rank 4),
# a prepared receipt -> RP, anything else held -> FL. Answered Progress (the machine ranks the new stage).
# allow(primitive_api): reviewed post-begin flag (milestone_0021 14.0, 14A F6)
fn host_agent_open_failed_v4(call: HostAgentAttachmentPortCallV4, attachment: HostAgentAttachmentV4, error: text,
        post_begin: bool, capacity: HostCapacityOwnerV1, container: Option<SimpleContainerOwnerV2>) -> HostAgentAttachmentReleaseStepV4:
    host_agent_release_answer_v4(host_agent_attachment_failure_v4(attachment, error, post_begin, call.now),
        HostAgentReleaseOutcomeV4.Progress, "", capacity, container)

# OP reached through the RELEASE port (a forced release, or a port with no open context): the effects never start
# here, so an OP attachment holds at most a prepared receipt (begin and open run in one call, see the open step).
fn host_agent_release_open_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    host_agent_open_failed_v4(call, call.attachment, HOST_AGENT_ATTACH_OPEN_ABANDONED_V4,
        call.attachment.helper.is_some() or call.attachment.begin_attempted, context.capacity, call.container)

# OP sub-step 1 (13.2 effects): the signed helper request is prepared on the service's capacity owner. A refusal
# with no journal row is RF; a row that exists, or a lookup that fails for any other reason (the prepare may have
# committed before the error, e.g. a projection that needs a reopen), is treated as a prepared receipt: RP then
# expires it, or ends release-blocked when this owner can no longer write (never a silent leak).
fn host_agent_open_prepare_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4,
        open: HostAgentOpenContextV4, refresh: fn() -> HostReservationAuthorizationContextV1) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    val request = host_helper_request_decode_v1(att.helper_request_bytes)
    if request.is_err(): return host_agent_open_failed_v4(call, att, request.unwrap_err(), false, context.capacity, call.container)
    val expected = host_helper_reservation_receipt_v1(request.unwrap().intent, request.unwrap().operation)
    if expected.is_err(): return host_agent_open_failed_v4(call, att, expected.unwrap_err(), false, context.capacity, call.container)
    val prepared = host_helper_prepare_v1(context.capacity, request.unwrap(), open.policy, open.scope, open.context, refresh)
    if prepared.error != "" or prepared.receipt.is_none():
        val row = daemon_operation_exact_v2(prepared.owner.journal, request.unwrap().operation)
        if not (row.is_err() and row.unwrap_err() == "OPERATION_NOT_FOUND"):
            att.prepared_receipt_digest = expected.unwrap().receipt_digest
        return host_agent_open_failed_v4(call, att,
            if prepared.error != "": prepared.error else: "linux-host-agent-attach-prepare-unreceipted", false, prepared.owner,
            call.container)
    att.prepared_receipt_digest = prepared.receipt.unwrap().receipt_digest
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", prepared.owner, call.container)

# OP sub-step 2 (13.2 effects), ONE call: helper begin under the packet's controller-signed execute grant
# (re-verified live by host_helper_begin_v1), the open core on the agent's lent container, and the adoption from
# the VERIFIED pane binding (14B). Begin and open are never split across calls. Begin without a lease: the row
# still `admitted` keeps the receipt (RP); anything else is F6 (begin_attempted, held). After begin every failure is
# FL with what the core left held; the release classification (U', S, F/B) decides from there.
# milestone_0031, what can still refuse AFTER begin and how it is released: the lease-bound consumption checks and
# a plan the provider no longer reproduces (the precheck passed moments earlier) write the pre-consume refusal R,
# and U' cancels; when that R could not be written (or the entry guard refused, which writes nothing) nothing was
# consumed, and U' records the refusal itself before cancelling (host_agent_release_cancel_v4). Only a consume
# publish that was attempted without a typed refusal stays charged (PA may exist: restart recovery owns it).
fn host_agent_open_begin_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4,
        open: HostAgentOpenContextV4, refresh: fn() -> HostReservationAuthorizationContextV1) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    val request = host_helper_request_decode_v1(att.helper_request_bytes)
    if request.is_err(): return host_agent_open_failed_v4(call, att, request.unwrap_err(), false, context.capacity, call.container)
    if (att.helper_execute_signed.is_none() or att.helper_execute_approval.is_none() or att.stream_policy.is_none() or
            att.plan.is_none() or att.binding.is_none() or call.container.is_none() or call.runtime.is_none()):
        return host_agent_open_failed_v4(call, att, HOST_AGENT_ATTACH_OPEN_INPUT_V4, false, context.capacity, call.container)
    val receipt = host_helper_reservation_receipt_v1(request.unwrap().intent, request.unwrap().operation)
    if receipt.is_err() or receipt.unwrap().receipt_digest != att.prepared_receipt_digest:
        return host_agent_open_failed_v4(call, att, "linux-host-agent-attach-receipt-mismatch", false, context.capacity, call.container)
    val plan = att.plan.unwrap()
    # milestone_0031: the read-only half of the open core (entry guard, parent executing, the provider's own
    # reproduction of the signed plan) runs BEFORE helper begin. A refusal here holds only the prepared receipt
    # (RP, expired by the release), never an executing helper.
    val checked = host_primary_attach_open_precheck_v1(HostPrimaryAttachCoreInputV1(store: context.store,
        capacity: context.capacity, container: call.container.unwrap(), parent: open.parent), plan,
        request.unwrap().operation.id, att.stream_policy.unwrap(), open.execution, call.runtime.unwrap())
    if checked.error != "":
        return host_agent_open_failed_v4(call, att, checked.error, false, checked.capacity, Some(checked.container))
    val begun = host_helper_begin_v1(checked.capacity, request.unwrap(), receipt.unwrap(), att.helper_execute_signed.unwrap(),
        att.helper_execute_approval.unwrap(), open.policy, open.scope, open.context, refresh)
    if begun.lease.is_none():
        val reason = if begun.error != "": begun.error else: "linux-host-agent-attach-begin-unleased"
        val row = daemon_operation_exact_v2(begun.owner.journal, request.unwrap().operation)
        if row.is_ok() and row.unwrap().state == "admitted":
            return host_agent_open_failed_v4(call, att, reason, false, begun.owner, Some(checked.container))
        att.begin_attempted = true
        att.prepared_receipt_digest = ""
        return host_agent_open_failed_v4(call, att, reason, true, begun.owner, Some(checked.container))
    att.helper = begun.lease
    att.prepared_receipt_digest = ""
    val opened = host_primary_attach_open_core_v1(HostPrimaryAttachCoreInputV1(store: context.store, capacity: begun.owner,
        container: checked.container, parent: open.parent), plan, begun.lease.unwrap(), att.stream_policy.unwrap(),
        open.execution, call.runtime.unwrap())
    att.session = opened.session
    att.cleanup_spawn = opened.cleanup_spawn
    att.consumption_attempted = opened.consumption_attempted
    if opened.error != "" or opened.session.is_none():
        return host_agent_open_failed_v4(call, att,
            if opened.error != "": opened.error else: "linux-host-agent-attach-session-missing", true, opened.capacity,
            Some(opened.container))
    val adopted = host_agent_attach_adopt_v4(opened.session.unwrap(), att.binding.unwrap(), plan.identity.parent_operation_id,
        att.lease_epoch)
    att.session = Some(adopted.session)
    if adopted.error != "":
        return host_agent_open_failed_v4(call, att, adopted.error, true, opened.capacity, Some(opened.container))
    att.attach_stage = HOST_AGENT_ATTACH_READY_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", opened.capacity, Some(opened.container))

# RP (13.2, D2): expire the prepared receipt on the monotonic clock. `prepare-not-expired` is a WAIT (D2c);
# a projection that needs a reopen is non-retryable; anything else is a counted refusal. Expired -> RF.
fn host_agent_release_expire_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    val request = host_helper_request_decode_v1(att.helper_request_bytes)
    if request.is_err():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, request.unwrap_err(), context.capacity, call.container)
    val expired = host_capacity_owner_expire_prepared_owned_v3(context.capacity, request.unwrap().operation.id,
        context.monotonic_ms)
    if expired.error == "prepare-not-expired":
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", expired.owner, call.container)
    if expired.error == "host-projection-reopen-required":
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, expired.error, expired.owner, call.container)
    if expired.error != "" or not expired.settled:
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused,
            if expired.error != "": expired.error else: "linux-host-agent-attach-expire-unsettled", expired.owner, call.container)
    att.prepared_receipt_digest = ""
    att.attach_stage = HOST_AGENT_ATTACH_REFUSED_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", expired.owner, call.container)

# 13.4 "cancel then drain" of the ONE geometry owner, before any native cleanup: cancel once, then one step per
# call until the native exchange is done with nothing to clean. Non-advancing (Wait) while it drains.
fn host_agent_release_drained_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4,
        turn: ContainerPrimaryGeometryTurnV1) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    att.geometry_cancelled = true
    if turn.owner.is_none() or (turn.phase == "done" and not turn.cleanup_pending):
        att.geometry = None
        att.geometry_cancelled = false
    else:
        att.geometry = turn.owner
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", context.capacity, call.container)

fn host_agent_release_geometry_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    val att = call.attachment
    val owner = att.geometry.unwrap()
    if not att.geometry_cancelled:
        return host_agent_release_drained_v4(call, context, simple_container_primary_geometry_cancel_v1(owner, "attach-revoked"))
    if call.container.is_none() or att.session.is_none():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked,
            "linux-host-agent-attachment-geometry-carrier-missing", context.capacity, call.container)
    host_agent_release_drained_v4(call, context, simple_container_primary_geometry_step_v1(call.container.unwrap(),
        att.session.unwrap(), owner, owner.request, HOST_AGENT_GEOMETRY_STEP_MS_V4))

fn host_agent_release_retained_v4(attachment: HostAgentAttachmentV4, context: HostAgentReleaseContextV4) -> HostPrimaryAttachCoreRetainedV1:
    HostPrimaryAttachCoreRetainedV1(store: context.store, capacity: context.capacity, helper: attachment.helper.unwrap(),
        plan: attachment.plan.unwrap(), session: attachment.session, cleanup_spawn: attachment.cleanup_spawn)

# U' (13.4): no session and no spawn, journal R present (or still recordable, see below) -> the refusal-authorized
# helper cancel, inputs re-derived from the journal-stored signed request and bound to R (as the restart resume
# does) -> returned.
fn host_agent_release_cancel_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    val operation = att.helper.unwrap().operation
    val journal = context.store.journal.unwrap()
    val relative = host_linux_helper_journal_relative_v1("primary-refusal", operation.id)
    # milestone_0031: the open core refused before its consume publish but left no R (the entry guard writes
    # nothing; an R publish can fail). Nothing was consumed, so the pre-consume refusal is recorded HERE, through
    # the same writer and precondition (store bound, every marker absent), with the attachment's first error as its
    # reason (deliberately: it is the error that ended the open, the one the attachment reports). One sub-step: the cancel runs on the next call. A publish this store can never accept (a marker is
    # present, the store is not this journal's valid store) is Blocked at once with its typed reason; any other
    # publish failure (IO) is a counted refusal. DESIGN 14.3 has the open core write R before it returns; this
    # release-port writer is the deliberate exception for the one case the core could not record (11.4 U).
    if not att.consumption_attempted:
        val present = distributed_operation_journal_read_v3(journal, relative, 65536)
        if present.is_err():
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, present.unwrap_err(), context.capacity, call.container)
        if present.unwrap().is_none():
            val recorded = host_linux_helper_refusal_publish_v1(context.store, operation,
                att.helper.unwrap().receipt.receipt_digest, "", att.first_error)
            if recorded.is_err():
                val permanent = ["host-primary-refusal-precondition", "linux-helper-store-invalid"].contains(recorded.unwrap_err())
                val outcome = if permanent: HostAgentReleaseOutcomeV4.Blocked else: HostAgentReleaseOutcomeV4.Refused
                return host_agent_release_answer_v4(att, outcome, recorded.unwrap_err(), context.capacity, call.container)
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", context.capacity, call.container)
    val expected = host_linux_helper_attach_expected_v1(journal, operation)
    if expected.is_err():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, expected.unwrap_err(), context.capacity, call.container)
    val bytes = distributed_operation_journal_read_required_v3(journal, relative, 65536)
    if bytes.is_err():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, bytes.unwrap_err(), context.capacity, call.container)
    val refusal = host_primary_attach_refusal_decode_v1(bytes.unwrap())
    if refusal.is_err():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, refusal.unwrap_err(), context.capacity, call.container)
    val bound = host_linux_helper_attach_binding_check_v1(refusal.unwrap(), None, expected.unwrap())
    if bound.is_err():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, bound.unwrap_err(), context.capacity, call.container)
    val cancelled = host_helper_cancel_unconsumed_v1(context.capacity, context.store.root, operation, expected.unwrap().plan,
        expected.unwrap().request_digest, expected.unwrap().prepared_receipt_digest)
    if cancelled.error != "":
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, cancelled.error, cancelled.owner, call.container)
    att.helper = None
    att.attach_stage = HOST_AGENT_ATTACH_RETURNED_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", cancelled.owner, call.container)

# F (spawn only) and B (session and spawn), 13.4: ONE bounded sub-step per call. d2 quiesces the spawn's native
# group (proof only, no descriptor retirement) and stores the proof digest. B then DROPS the spawn (settle refuses
# multiple native carriers) and continues on the S path; the dropped spawn is "kept only in the proof" (DESIGN
# 11.4), i.e. in `quiesce_proof_digest`, and is never dropped without one. F takes d3, the container-side retirement
# (`simple_container_primary_attach_cleanup_v3`, which yields the retirement), and moves to `cleaned`, where d4 is
# `settle_retired`. d3 repeats until the container reports no error: a retirement with an error is kept but never advances.
fn host_agent_release_fallback_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    var container = call.container
    if not att.fallback_quiesced:
        val quiet = host_primary_attach_quiesce_fallback_core_v3(host_agent_release_retained_v4(att, context))
        att.cleanup_spawn = quiet.retained.cleanup_spawn
        if quiet.error != "":
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, quiet.error, quiet.retained.capacity, container)
        # No error and no proof yet: the group is still tearing down, which is a (counted) wait, not a refusal.
        if not quiet.proof_ready:
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", quiet.retained.capacity, container)
        att.quiesce_proof_digest = quiet.proof_digest
        if att.session.is_some():
            att.cleanup_spawn = None
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", quiet.retained.capacity, container)
        att.fallback_quiesced = true
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", quiet.retained.capacity, container)
    # d3 re-runs until the container publishes the retirement cleanly (fallback_cleanup_v3 is idempotent at
    # native-retired); a retirement captured WITH an error authorizes no Host release (workspace_api_v3).
    if call.pending: return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", context.capacity, container)
    if container.is_none():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked,
            "linux-host-agent-attachment-fallback-carrier-missing", context.capacity, container)
    val returned = simple_container_primary_attach_cleanup_v3(call.container.unwrap())
    container = Some(returned.owner)
    if returned.retirement.is_some(): att.native_retirement = returned.retirement
    if returned.error != "" or att.native_retirement.is_none():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused,
            if returned.error != "": returned.error else: "linux-host-agent-attach-retirement-missing", context.capacity, container)
    att.attach_stage = HOST_AGENT_ATTACH_CLEANED_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", context.capacity, container)

# S d2 (13.4, D4): the core's adopted-session arm runs container_terminal_cleanup_v1(PrimaryAttach(session)) (the
# agent is the terminal owner) and returns the cleaned session, written back as the one canonical copy.
fn host_agent_release_cleanup_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    val cleaned = host_primary_attach_cleanup_core_v1(host_agent_release_retained_v4(att, context))
    att.session = cleaned.retained.session
    if cleaned.error != "":
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, cleaned.error, cleaned.retained.capacity, call.container)
    if not cleaned.cleaned:
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", cleaned.retained.capacity, call.container)
    att.attach_stage = HOST_AGENT_ATTACH_CLEANED_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", cleaned.retained.capacity, call.container)

# S d3: the settlement ack (helper charge released through the V4 evidence arm).
fn host_agent_release_settle_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    val retained = host_agent_release_retained_v4(att, context)
    # F: no session and a container-side retirement -> settle from the retirement; otherwise the S settle.
    val settled = if att.session.is_none() and att.native_retirement.is_some():
        host_primary_attach_settle_retired_core_v3(retained, att.native_retirement.unwrap())
    else:
        host_primary_attach_settle_core_v1(retained)
    att.session = settled.retained.session
    att.cleanup_spawn = settled.retained.cleanup_spawn
    if not settled.settled or settled.ack.is_none():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused,
            if settled.error != "": settled.error else: "linux-host-agent-attach-settle-unacknowledged", settled.retained.capacity,
            call.container)
    att.settlement = settled.ack
    att.attach_stage = HOST_AGENT_ATTACH_SETTLING_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", settled.retained.capacity, call.container)

# S d4 (D8): the session returns to the agent's container; a WAIT while a native step is in flight on it.
fn host_agent_release_return_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    var att = call.attachment
    if call.pending: return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", context.capacity, call.container)
    if att.session.is_none() and att.native_retirement.is_some():
        # F: the container-side retirement already returned the transport; nothing is left to give back.
        att.native_retirement = None
        att.fallback_quiesced = false
        att.attach_stage = HOST_AGENT_ATTACH_RETURNED_V4
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", context.capacity, call.container)
    if call.container.is_none() or att.session.is_none():
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, "linux-host-agent-attachment-return-carrier-missing",
            context.capacity, call.container)
    val returned = simple_container_primary_session_return_v3(call.container.unwrap(), att.session.unwrap())
    if returned.retirement.is_some(): att.native_retirement = returned.retirement
    if returned.error != "":
        return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Refused, returned.error, context.capacity,
            Some(returned.owner))
    att.session = None
    att.attach_stage = HOST_AGENT_ATTACH_RETURNED_V4
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Progress, "", context.capacity, Some(returned.owner))

# The production release port (13.4): ONE bounded sub-step per call, resuming at the stored sub-step (d1 is the
# machine's). OP -> abandoned (the effects run only through host_agent_attachment_open_step_v4); RP -> expire; FL -> read-only classification; RV -> geometry
# drain, then the charged-forever classification, then U' (cancel) or S d2; CL -> d3; ST -> d4.
pub fn host_agent_attachment_release_step_v4(call: HostAgentAttachmentPortCallV4,
        context: HostAgentReleaseContextV4) -> HostAgentAttachmentReleaseStepV4:
    val att = call.attachment
    val stage = att.attach_stage
    if stage == HOST_AGENT_ATTACH_OPENING_V4: return host_agent_release_open_v4(call, context)
    if stage == HOST_AGENT_ATTACH_EXPIRE_PENDING_V4: return host_agent_release_expire_v4(call, context)
    if stage == HOST_AGENT_ATTACH_FAILED_V4 or stage == HOST_AGENT_ATTACH_REVOKED_V4:
        if stage == HOST_AGENT_ATTACH_REVOKED_V4 and att.geometry.is_some(): return host_agent_release_geometry_v4(call, context)
        val charged = host_agent_release_charged_v4(att, context.store)
        if charged != "":
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, charged, context.capacity, call.container)
        if stage == HOST_AGENT_ATTACH_FAILED_V4:
            return host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Wait, "", context.capacity, call.container)
        if att.cleanup_spawn.is_some(): return host_agent_release_fallback_v4(call, context)
        if att.session.is_none(): return host_agent_release_cancel_v4(call, context)
        return host_agent_release_cleanup_v4(call, context)
    if stage == HOST_AGENT_ATTACH_CLEANED_V4: return host_agent_release_settle_v4(call, context)
    if stage == HOST_AGENT_ATTACH_SETTLING_V4: return host_agent_release_return_v4(call, context)
    host_agent_release_answer_v4(att, HostAgentReleaseOutcomeV4.Blocked, "linux-host-agent-attachment-release-stage:" + stage,
        context.capacity, call.container)

# The production STEP-DRIVER port (milestone_0023 part B): the release port plus the attach effects. An OP
# attachment that is not being force-released runs ONE effect sub-step (prepare while no receipt is held, then
# begin + open + adopt); everything else, and every forced release, is the release port unchanged.
pub fn host_agent_attachment_open_step_v4(call: HostAgentAttachmentPortCallV4, context: HostAgentReleaseContextV4,
        open: HostAgentOpenContextV4, refresh: fn() -> HostReservationAuthorizationContextV1) -> HostAgentAttachmentReleaseStepV4:
    if call.attachment.attach_stage != HOST_AGENT_ATTACH_OPENING_V4 or call.release:
        return host_agent_attachment_release_step_v4(call, context)
    if call.attachment.prepared_receipt_digest == "": return host_agent_open_prepare_v4(call, context, open, refresh)
    host_agent_open_begin_v4(call, context, open, refresh)

pub struct HostAgentPaneIoCallV4:
    attachment: HostAgentAttachmentV4
    op: HostAgentPaneOpV4
    now: i64
    # The agent's transfer holder, lent for this call only (geometry begin/step need it).
    container: Option<SimpleContainerOwnerV2> = None

pub struct HostAgentPaneIoPortTurnV4:
    attachment: HostAgentAttachmentV4
    result: HostAgentPaneIoResultV4

fn host_agent_pane_io_turn_v4(attachment: HostAgentAttachmentV4, result: HostAgentPaneIoResultV4) -> HostAgentPaneIoPortTurnV4:
    HostAgentPaneIoPortTurnV4(attachment: attachment, result: result)

fn host_agent_pane_disposition_v4(value: ContainerPrimaryInputDispositionV2) -> text:
    match value:
        case ContainerPrimaryInputDispositionV2.Rejected: "rejected"
        case ContainerPrimaryInputDispositionV2.Queued: "queued"
        case ContainerPrimaryInputDispositionV2.Completed: "completed"
        case ContainerPrimaryInputDispositionV2.Unknown: "unknown"

# A geometry turn folded into the attachment (at most one owner, D9): `pending` while the native exchange runs,
# `done` (owner dropped) once it finished with nothing to clean; a native error ends the owner too.
fn host_agent_pane_geometry_v4(attachment: HostAgentAttachmentV4, turn: ContainerPrimaryGeometryTurnV1) -> HostAgentPaneIoPortTurnV4:
    var att = attachment
    val done = turn.owner.is_none() or (turn.phase == "done" and not turn.cleanup_pending)
    att.geometry = if done: None else: turn.owner
    if turn.error != "": return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4(turn.error))
    host_agent_pane_io_turn_v4(att, HostAgentPaneIoResultV4(geometry: if done: "done" else: "pending"))

# Production pane io port (13.1, 14C): output ONLY through container_primary_output_read_v1 (adoption-gated, one
# non-blocking read, eof sticky: once seen no further native read happens); Write through the adoption-gated
# primary input (partial accept is the native answer; the legacy primary ignores `frame_sequence`, which is set
# to the attempt to satisfy its bounds); Resize begins the ONE geometry owner, ResizePoll steps it. The lease,
# epoch, window and io deadline are enforced by the machine (host_agent_pane_io_core_v4) before this runs.
# milestone_0025 PR4: the native input gate must carry THIS write's lease before the leaf writes. A prior unresolved
# or unknown outcome refuses (it never self-clears); otherwise the old holder is revoked and the lease installed,
# then the installed gate is read back and must be this lease's revision. "" when the write may proceed.
fn host_agent_pane_input_install_v4(session: ContainerPrimaryAttachSessionV1, write: HostAgentPaneWriteV4) -> text:
    val owned = ContainerOwnedTerminalSessionV2.Legacy(ContainerOwnedTerminalSessionV1.PrimaryAttach(session))
    val before = container_primary_input_gate_v2(owned)
    if before.is_err(): return before.unwrap_err()
    if before.unwrap().pending or before.unwrap().unknown: return "attach-pane-input-unresolved"
    val revoked = container_primary_input_revoke_v2(owned)
    if revoked.is_err(): return revoked.unwrap_err()
    val installed = container_primary_input_install_v2(owned, write.lease, write.target, write.principal, write.nonce)
    if installed.is_err():
        host_agent_pane_input_close_v4(session)
        return installed.unwrap_err()
    val gate = installed.unwrap()
    if (not gate.controlled or not gate.active or gate.pending or gate.unknown or gate.revision != write.lease.revision):
        host_agent_pane_input_close_v4(session)
        return "attach-pane-input-install-not-current"
    ""

# The native input gate lives exactly as long as one Write: closed on return and on every error path after the
# install, so it never outlives the per-Write control lease. "" when closed (or nothing was active).
fn host_agent_pane_input_close_v4(session: ContainerPrimaryAttachSessionV1) -> text:
    val closed = container_primary_input_revoke_v2(ContainerOwnedTerminalSessionV2.Legacy(
        ContainerOwnedTerminalSessionV1.PrimaryAttach(session)))
    if closed.is_err(): return "attach-pane-input-gate-revoke:" + closed.unwrap_err()
    ""

# milestone_0025 PR4: the control target of the agent's own pane, built ONLY from the verified terminal-authority
# binding, the lease epoch of that authority, the attachment's retained plan and the attached session's adoption
# (never smux state, never the caller). The client identity is a fixed agent-pane prefix plus the signed binding uid
# and the attachment generation is the authority's lease epoch + 1 (the epoch starts at 0 and the target requires a
# generation >= 1, like child_incarnation), so a revoke (epoch + 1) changes the target.
# Err unless the session is adopted exactly as the signed binding names it and the plan matches the target.
# allow(primitive_api): reviewed lease epoch DATA word (milestone_0025 PR4)
pub fn host_agent_pane_control_target_v4(attachment: HostAgentAttachmentV4, binding: HostAgentPaneBindingV4,
        lease_epoch: i64) -> Result<SessionRuntimeControlTargetV1, text>:
    if attachment.session.is_none() or attachment.plan.is_none(): return Err("attach-no-session")
    val adoption = match container_primary_attach_adoption_v1(attachment.session.unwrap()):
        case Some(value): value
        case None: return Err("attach-not-adopted")
    if (adoption.binding_uid != binding.binding_uid or adoption.service_incarnation != binding.service_incarnation or
            adoption.session_id != binding.session_id or adoption.window_id != binding.window_id or
            adoption.pane_id != binding.pane_id or adoption.service_epoch != binding.service_epoch):
        return Err("attach-adoption-binding-mismatch")
    val plan = attachment.plan.unwrap()
    val workload = plan.workload
    val scope = ContainerHostScopeV2(physical_host_id: workload.physical_host_id, service_scope_id: workload.service_scope_id,
        boot_id: workload.boot_id, provider_generation: workload.provider_generation,
        native_machine_id: workload.native_machine_id, continuity_mode: workload.continuity_mode,
        continuity_id: workload.continuity_id)
    val target = SessionRuntimeControlTargetV1(scope: scope, runtime: plan.runtime,
        workload_request_digest: workload.request_digest, binding_uid: binding.binding_uid,
        binding_digest: plan.identity.binding_digest, service_incarnation: binding.service_incarnation,
        session_id: binding.session_id, window_id: binding.window_id, pane_id: binding.pane_id,
        service_epoch: binding.service_epoch, child_incarnation: adoption.child_incarnation,
        client_id: "agent-pane-" + binding.binding_uid, attachment_generation: lease_epoch + 1,
        execution_kind: "primary", native_exec_id: "", exec_request_digest: "")
    session_runtime_control_target_validate_v1(target)?
    container_primary_input_plan_match_v1(plan, target)?
    Ok(target)

pub fn host_agent_pane_io_port_v4(call: HostAgentPaneIoCallV4) -> HostAgentPaneIoPortTurnV4:
    var att = call.attachment
    if att.session.is_none(): return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4("attach-no-session"))
    val session = att.session.unwrap()
    match call.op:
        case HostAgentPaneOpV4.Read:
            if att.eof: return host_agent_pane_io_turn_v4(att, HostAgentPaneIoResultV4(eof: true))
            val read = container_primary_output_read_v1(session)
            att.session = Some(read.session)
            host_agent_pane_io_turn_v4(att, HostAgentPaneIoResultV4(chunks: read.chunks, eof: read.eof, error: read.error))
        case HostAgentPaneOpV4.Write(write):
            val request = ContainerPrimaryInputRequestV2(lease: write.lease, target: write.target, principal: write.principal,
                nonce: write.nonce, attempt: write.attempt, frame_sequence: write.attempt, payload: write.data,
                offset: write.offset, maximum: write.maximum)
            val derived = if att.binding.is_some(): host_agent_pane_control_target_v4(att, att.binding.unwrap(), att.lease_epoch)
                else: Err("attach-no-binding")
            if derived.is_err(): return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4(derived.unwrap_err()))
            val matched = session_runtime_control_target_match_v1(write.target, derived.unwrap())
            if matched.is_err(): return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4("attach-pane-write-target"))
            val installed = host_agent_pane_input_install_v4(session, write)
            if installed != "": return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4(installed))
            val written = container_primary_input_write_v2(ContainerOwnedTerminalSessionV2.Legacy(
                ContainerOwnedTerminalSessionV1.PrimaryAttach(session)), request)
            val gate_error = host_agent_pane_input_close_v4(session)
            if written.is_err():
                return host_agent_pane_io_turn_v4(att, HostAgentPaneIoResultV4(error: written.unwrap_err(), gate_error: gate_error))
            host_agent_pane_io_turn_v4(att, HostAgentPaneIoResultV4(
                disposition: host_agent_pane_disposition_v4(written.unwrap().disposition),
                accepted_bytes: written.unwrap().accepted_bytes, error: written.unwrap().error, gate_error: gate_error))
        case HostAgentPaneOpV4.Resize(request):
            if call.container.is_none(): return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4("attach-container-missing"))
            host_agent_pane_geometry_v4(att, simple_container_primary_geometry_begin_v1(call.container.unwrap(), session,
                att.policy_bytes, request))
        case HostAgentPaneOpV4.ResizePoll:
            if call.container.is_none(): return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4("attach-container-missing"))
            if att.geometry.is_none(): return host_agent_pane_io_turn_v4(att, host_agent_pane_io_refused_v4("attach-no-geometry"))
            val owner = att.geometry.unwrap()
            host_agent_pane_geometry_v4(att, simple_container_primary_geometry_step_v1(call.container.unwrap(), session, owner,
                owner.request, HOST_AGENT_GEOMETRY_STEP_MS_V4))

# ---- controller-signed actions: cancel, attach, detach (13.2) ----

pub fn host_agent_action_tag_v4(kind: text) -> Result<text, text>:
    if kind == "host_agent_cancel_v4": return Ok("cancel")
    if kind == "host_agent_attach_v4": return Ok("attach")
    if kind == "host_agent_detach_v4": return Ok("detach")
    Err("linux-host-agent-action-kind")

# The action's own operation (precedent: host_agent_cancel_operation_v4): the archived execute's principal,
# project, host, environment and budget; id `<tag>-<execute id>`; kind; the given payload digest; and the LIVE
# policy revision, revocation epoch and session generation.
pub fn host_agent_action_operation_v4(kind: text, execute: OperationEnvelopeV2, payload_digest: text,
        context: HostReservationAuthorizationContextV1) -> Result<OperationEnvelopeV2, text>:
    val tag = host_agent_action_tag_v4(kind)?
    var operation = execute
    operation.id = tag + "-" + execute.id
    operation.operation = kind
    operation.payload_digest = payload_digest
    operation.policy_revision = context.policy_revision
    operation.revocation_epoch = context.revocation_epoch
    operation.session_generation = context.session_generation
    val encoded = distributed_encode_operation_v2(operation)
    if encoded.is_err(): return Err(encoded.unwrap_err())
    Ok(operation)

# One gate order for every controller-signed agent action (the cancel authorize is a wrapper over this): the
# request names the held run; the archived execute's association equals the request's and the held agent's
# (and is a digest); the operation is exactly the one derived from the archived execute and `payload_digest`
# (which the caller recomputes from the packet's OWN contents) under the live context; issuer == controller;
# issuer and approver signatures verify under the installed snapshot. Errors carry the action tag.
pub fn host_linux_service_agent_action_authorize_v4(kind: text, snapshot: DistributedAuthoritySnapshotV2,
        controller_ref: text, request_operation_id: text, request_association_digest: text,
        request_operation: OperationEnvelopeV2, signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2,
        payload_digest: text, execute_operation: OperationEnvelopeV2, execute_association_digest: text,
        held_operation_id: text, held_association_digest: text,
        context: HostReservationAuthorizationContextV1) -> Result<ExecutionGrantV2, text>:
    val tag = host_agent_action_tag_v4(kind)?
    if request_operation_id != held_operation_id or execute_operation.id != held_operation_id:
        return Err("linux-host-agent-incarnation-consumed")
    if (request_association_digest != execute_association_digest or
            execute_association_digest != held_association_digest or not builder_digest_valid_v1(execute_association_digest)):
        return Err("linux-host-agent-" + tag + "-association")
    val expected = host_agent_action_operation_v4(kind, execute_operation, payload_digest, context)?
    if distributed_encode_operation_v2(request_operation)? != distributed_encode_operation_v2(expected)?:
        return Err("linux-host-agent-" + tag + "-operation-mismatch")
    if signed.issuer_id != controller_ref: return Err("linux-host-service-controller-mismatch")
    distributed_verify_grant_approval_from_snapshot_v2(snapshot, signed, approval, request_operation,
        context.grant_clock, snapshot.generation, context.policy_revision, context.revocation_epoch,
        context.session_generation)

# The digest of the packet's `host_helper_execute_v1` grant: the canonical signed grant and approval bytes.
pub fn host_agent_attach_helper_execute_digest_v4(signed: DistributedSignedGrantV2,
        approval: DistributedSignedApprovalV2) -> Result<text, text>:
    Ok(sha256_text(distributed_encode_signed_grant_v2(signed)? + "\n" + distributed_encode_signed_approval_v2(approval)?))

# 14B + milestone_0023 part B: attach digest = {operationId, associationDigest, planDigest, helperRequestDigest,
# paneBindingDigest, helperExecuteDigest, streamPolicyDigest}.
pub fn host_agent_attach_payload_digest_v4(operation_id: text, association_digest: text, plan_digest: text,
        helper_request_digest: text, pane_binding_digest: text, helper_execute_digest: text,
        stream_policy_digest: text) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-attach"),
        "operationId": SdnValue.String(operation_id), "associationDigest": SdnValue.String(association_digest),
        "planDigest": SdnValue.String(plan_digest), "helperRequestDigest": SdnValue.String(helper_request_digest),
        "paneBindingDigest": SdnValue.String(pane_binding_digest),
        "helperExecuteDigest": SdnValue.String(helper_execute_digest),
        "streamPolicyDigest": SdnValue.String(stream_policy_digest)}
    sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)))

# 13.2: detach digest = {operationId, associationDigest, attachDigest}.
pub fn host_agent_detach_payload_digest_v4(operation_id: text, association_digest: text, attach_digest: text) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-detach"),
        "operationId": SdnValue.String(operation_id), "associationDigest": SdnValue.String(association_digest),
        "attachDigest": SdnValue.String(attach_digest)}
    sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)))

# ---- attach packet (13.2 + 14B) ----

# Canonical {operation_id, association_digest, operation, signed, approval} plus the signed helper request
# bytes, the primary plan bytes and the controller-signed pane binding bytes. The packet also NAMES the plan and
# pane binding digests it was signed over (`plan_digest`, `pane_binding_digest`): the signed payload digest is
# computed from those named digests (and the recomputed helper request digest), and 14C requires a packet whose
# plan or binding bytes are not the ones those signed digests name to be refused `attach-binding-plan`.
# milestone_0023 part B: the packet also carries the controller-signed `host_helper_execute_v1` grant of helper
# begin (`helper_execute_signed`, `helper_execute_approval`) and the canonical stream policy bytes of the open core;
# both are covered by the signed payload digest through their digests recomputed from the packet's own bytes.
pub struct HostAgentAttachRequestV4:
    operation_id: text
    association_digest: text
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2
    helper_request: text
    plan: text
    pane_binding: text
    plan_digest: text
    pane_binding_digest: text
    helper_execute_signed: DistributedSignedGrantV2
    helper_execute_approval: DistributedSignedApprovalV2
    stream_policy: text

# The packet's decoded contents: `plan_digest`/`binding_digest` are RECOMPUTED from the bytes, and
# `payload_digest` is the signed payload over the packet's NAMED plan/binding digests and the recomputed helper
# request digest (never taken from the operation). host_agent_attach_binding_plan_check_v4 compares the two.
pub struct HostAgentAttachPartsV4:
    plan: ContainerPrimaryAttachPlanV1
    helper: HostHelperRequestV1
    binding: HostAgentPaneBindingV4
    plan_digest: text
    helper_request_digest: text
    binding_digest: text
    payload_digest: text
    stream_policy: ContainerStreamPolicyV2

# The exact envelope the packet's execute grant is signed over (and host_helper_begin_v1 verifies): the helper
# request's own operation with `operation = "host_helper_execute_v1"`.
pub fn host_agent_attach_helper_execute_operation_v4(helper: HostHelperRequestV1) -> OperationEnvelopeV2:
    var operation = helper.operation
    operation.operation = "host_helper_execute_v1"
    operation

pub fn host_agent_attach_request_parts_v4(request: HostAgentAttachRequestV4) -> Result<HostAgentAttachPartsV4, text>:
    val plan = container_primary_attach_plan_decode_v1(request.plan)?
    val plan_digest = container_primary_attach_plan_digest_v1(plan)?
    val helper = host_helper_request_decode_v1(request.helper_request)?
    val binding = host_agent_pane_binding_decode_v4(request.pane_binding)?
    val binding_digest = host_agent_pane_binding_digest_v4(binding)?
    val helper_digest = sha256_text(request.helper_request)
    # The stream policy must be the one the SIGNED plan names (its bytes are canonical, so their digest is the
    # policy digest); refused before any signature work and long before the archive.
    val stream_policy = container_stream_policy_decode_v2(request.stream_policy)?
    if container_stream_policy_digest_v2(stream_policy)? != plan.policy_digest: return Err("attach-stream-policy")
    Ok(HostAgentAttachPartsV4(plan: plan, helper: helper, binding: binding, plan_digest: plan_digest,
        helper_request_digest: helper_digest, binding_digest: binding_digest,
        payload_digest: host_agent_attach_payload_digest_v4(request.operation_id, request.association_digest,
            request.plan_digest, helper_digest, request.pane_binding_digest,
            host_agent_attach_helper_execute_digest_v4(request.helper_execute_signed, request.helper_execute_approval)?,
            sha256_text(request.stream_policy)), stream_policy: stream_policy))

# milestone_0023 part B, run BEFORE the archive with the same gates as the action authorize (and cancel): the
# helper request's own prepare grant and the packet's `host_helper_execute_v1` grant are both issued by the
# configured controller and verify (issuer + approver signatures, clock, generation, policy revision, revocation
# epoch, session generation) under the installed snapshot and the LIVE context. Nothing is cached: helper prepare
# and begin verify again with a fresh clock, so an approval that expired since is refused there.
pub fn host_agent_attach_helper_authorize_v4(snapshot: DistributedAuthoritySnapshotV2, controller_ref: text,
        request: HostAgentAttachRequestV4, parts: HostAgentAttachPartsV4,
        context: HostReservationAuthorizationContextV1) -> Result<ExecutionGrantV2, text>:
    if parts.helper.signed.issuer_id != controller_ref or request.helper_execute_signed.issuer_id != controller_ref:
        return Err("linux-host-service-controller-mismatch")
    val prepare = distributed_verify_grant_approval_from_snapshot_v2(snapshot, parts.helper.signed, parts.helper.approval,
        parts.helper.operation, context.grant_clock, snapshot.generation, context.policy_revision, context.revocation_epoch,
        context.session_generation)?
    distributed_verify_grant_approval_from_snapshot_v2(snapshot, request.helper_execute_signed, request.helper_execute_approval,
        host_agent_attach_helper_execute_operation_v4(parts.helper), context.grant_clock, snapshot.generation,
        context.policy_revision, context.revocation_epoch, context.session_generation)

# milestone_0031: the plan<->helper association the open core checks AFTER helper begin
# (container_primary_attach_admission_validate_v1 on the lease), run BEFORE the archive on the admission begin
# would return: the helper request's own plan, intent and operation, the receipt derived from them, the effect
# deadline of the verified execute grant with the action begin derives from the helper kind (host_helper_begin_v1),
# and that grant's principals. Only the deadline's instant differs from the lease's (begin narrows it); the check
# reads it for `> 0` alone. Same refusals, same reasons.
pub fn host_agent_attach_association_check_v4(request: HostAgentAttachRequestV4, parts: HostAgentAttachPartsV4,
        execute: ExecutionGrantV2) -> Result<(), text>:
    val helper = parts.helper
    val action = if ["attach-broker", "primary-connection"].contains(helper.plan.helper_kind): "attach" else: "exec"
    val admission = ContainerHelperAdmissionV2(plan: helper.plan, intent: helper.intent, operation: helper.operation,
        receipt: host_helper_reservation_receipt_v1(helper.intent, helper.operation)?,
        deadline: container_effect_deadline_v1(helper.plan.request_digest, helper.operation.id, [action], execute.expires_at)?,
        grant_id: execute.id, issuer_id: request.helper_execute_signed.issuer_id,
        approver_id: request.helper_execute_approval.approver_id, cpu_millis: helper.intent.reservation.cpu_millis,
        memory_bytes: helper.intent.reservation.memory_bytes)
    container_primary_attach_admission_validate_v1(parts.plan, admission)?
    Ok(())

# 14C: run AFTER the signature over `parts.payload_digest` verified. The plan<->binding pairing is carried only by
# the signed digests, so plan or binding bytes that are not the ones the signed payload names are refused before
# any archive.
pub fn host_agent_attach_binding_plan_check_v4(request: HostAgentAttachRequestV4, parts: HostAgentAttachPartsV4) -> Result<(), text>:
    if parts.plan_digest != request.plan_digest or parts.binding_digest != request.pane_binding_digest:
        return Err("attach-binding-plan")
    Ok(())

pub fn host_agent_attach_request_encode_v4(value: HostAgentAttachRequestV4) -> Result<text, text>:
    if not builder_identifier_valid_v1(value.operation_id): return Err("linux-host-agent-attach-operation")
    if not builder_digest_valid_v1(value.association_digest): return Err("linux-host-agent-attach-association")
    if not builder_digest_valid_v1(value.plan_digest) or not builder_digest_valid_v1(value.pane_binding_digest):
        return Err("linux-host-agent-attach-digest")
    val parts = host_agent_attach_request_parts_v4(value)?
    if (value.operation.operation != "host_agent_attach_v4" or value.operation.id != "attach-" + value.operation_id or
            value.operation.payload_digest != parts.payload_digest):
        return Err("linux-host-agent-attach-operation-mismatch")
    if (not value.signed.grant.operations.contains("host_agent_attach_v4") or
            value.approval.request_digest != sha256_text(distributed_encode_operation_v2(value.operation)?) or
            value.approval.grant_digest != distributed_grant_digest_v2(value.signed.grant)?):
        return Err("linux-host-agent-attach-proof-binding")
    if (not value.helper_execute_signed.grant.operations.contains("host_helper_execute_v1") or
            value.helper_execute_approval.request_digest != sha256_text(distributed_encode_operation_v2(
                host_agent_attach_helper_execute_operation_v4(parts.helper))?) or
            value.helper_execute_approval.grant_digest != distributed_grant_digest_v2(value.helper_execute_signed.grant)?):
        return Err("linux-host-agent-attach-helper-execute-binding")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-attach"),
        "operationId": SdnValue.String(value.operation_id), "associationDigest": SdnValue.String(value.association_digest),
        "operation": SdnValue.String(distributed_encode_operation_v2(value.operation)?),
        "signed": SdnValue.String(distributed_encode_signed_grant_v2(value.signed)?),
        "approval": SdnValue.String(distributed_encode_signed_approval_v2(value.approval)?),
        "helperRequest": SdnValue.String(value.helper_request), "plan": SdnValue.String(value.plan),
        "paneBinding": SdnValue.String(value.pane_binding), "planDigest": SdnValue.String(value.plan_digest),
        "paneBindingDigest": SdnValue.String(value.pane_binding_digest),
        "helperExecuteSigned": SdnValue.String(distributed_encode_signed_grant_v2(value.helper_execute_signed)?),
        "helperExecuteApproval": SdnValue.String(distributed_encode_signed_approval_v2(value.helper_execute_approval)?),
        "streamPolicy": SdnValue.String(value.stream_policy)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if bytes.byte_len() > HOST_AGENT_ATTACH_MAX_BYTES_V4: return Err("linux-host-agent-attach-size")
    Ok(bytes)

fn host_agent_action_text_v4(fields: Dict<text, SdnValue>, name: text, tag: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("linux-host-agent-" + tag + "-field:" + name)

fn host_agent_action_fields_v4(source: text, maximum: i64, tag: text, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if source.byte_len() == 0 or source.byte_len() > maximum: return Err("linux-host-agent-" + tag + "-size")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: maximum,
            max_depth: 2, max_nodes: 64, max_rows: 0, max_cells: 0, max_columns: 16)):
        case Ok(value): value
        case Err(issue): return Err("linux-host-agent-" + tag + "-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("linux-host-agent-" + tag + "-object")
    if fields.len() != names.len(): return Err("linux-host-agent-" + tag + "-fields")
    for name in names:
        if not fields.contains_key(name): return Err("linux-host-agent-" + tag + "-fields")
    Ok(fields)

pub fn host_agent_attach_request_decode_v4(source: text) -> Result<HostAgentAttachRequestV4, text>:
    val fields = host_agent_action_fields_v4(source, HOST_AGENT_ATTACH_MAX_BYTES_V4, "attach", ["version", "kind",
        "operationId", "associationDigest", "operation", "signed", "approval", "helperRequest", "plan", "paneBinding",
        "planDigest", "paneBindingDigest", "helperExecuteSigned", "helperExecuteApproval", "streamPolicy"])?
    val value = HostAgentAttachRequestV4(operation_id: host_agent_action_text_v4(fields, "operationId", "attach")?,
        association_digest: host_agent_action_text_v4(fields, "associationDigest", "attach")?,
        operation: distributed_decode_operation_v2(host_agent_action_text_v4(fields, "operation", "attach")?)?,
        signed: distributed_decode_signed_grant_v2(host_agent_action_text_v4(fields, "signed", "attach")?)?,
        approval: distributed_decode_signed_approval_v2(host_agent_action_text_v4(fields, "approval", "attach")?)?,
        helper_request: host_agent_action_text_v4(fields, "helperRequest", "attach")?,
        plan: host_agent_action_text_v4(fields, "plan", "attach")?,
        pane_binding: host_agent_action_text_v4(fields, "paneBinding", "attach")?,
        plan_digest: host_agent_action_text_v4(fields, "planDigest", "attach")?,
        pane_binding_digest: host_agent_action_text_v4(fields, "paneBindingDigest", "attach")?,
        helper_execute_signed: distributed_decode_signed_grant_v2(host_agent_action_text_v4(fields, "helperExecuteSigned", "attach")?)?,
        helper_execute_approval: distributed_decode_signed_approval_v2(
            host_agent_action_text_v4(fields, "helperExecuteApproval", "attach")?)?,
        stream_policy: host_agent_action_text_v4(fields, "streamPolicy", "attach")?)
    # Canonical bytes only (version and kind included).
    if host_agent_attach_request_encode_v4(value)? != source: return Err("linux-host-agent-attach-noncanonical")
    Ok(value)

# ---- detach packet (13.2) ----

pub struct HostAgentDetachRequestV4:
    operation_id: text
    association_digest: text
    attach_digest: text
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn host_agent_detach_request_encode_v4(value: HostAgentDetachRequestV4) -> Result<text, text>:
    if not builder_identifier_valid_v1(value.operation_id): return Err("linux-host-agent-detach-operation")
    if not builder_digest_valid_v1(value.association_digest) or not builder_digest_valid_v1(value.attach_digest):
        return Err("linux-host-agent-detach-association")
    if (value.operation.operation != "host_agent_detach_v4" or value.operation.id != "detach-" + value.operation_id or
            value.operation.payload_digest != host_agent_detach_payload_digest_v4(value.operation_id, value.association_digest,
                value.attach_digest)):
        return Err("linux-host-agent-detach-operation-mismatch")
    if (not value.signed.grant.operations.contains("host_agent_detach_v4") or
            value.approval.request_digest != sha256_text(distributed_encode_operation_v2(value.operation)?) or
            value.approval.grant_digest != distributed_grant_digest_v2(value.signed.grant)?):
        return Err("linux-host-agent-detach-proof-binding")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-detach"),
        "operationId": SdnValue.String(value.operation_id), "associationDigest": SdnValue.String(value.association_digest),
        "attachDigest": SdnValue.String(value.attach_digest),
        "operation": SdnValue.String(distributed_encode_operation_v2(value.operation)?),
        "signed": SdnValue.String(distributed_encode_signed_grant_v2(value.signed)?),
        "approval": SdnValue.String(distributed_encode_signed_approval_v2(value.approval)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if bytes.byte_len() > HOST_AGENT_DETACH_MAX_BYTES_V4: return Err("linux-host-agent-detach-size")
    Ok(bytes)

pub fn host_agent_detach_request_decode_v4(source: text) -> Result<HostAgentDetachRequestV4, text>:
    val fields = host_agent_action_fields_v4(source, HOST_AGENT_DETACH_MAX_BYTES_V4, "detach", ["version", "kind",
        "operationId", "associationDigest", "attachDigest", "operation", "signed", "approval"])?
    val value = HostAgentDetachRequestV4(operation_id: host_agent_action_text_v4(fields, "operationId", "detach")?,
        association_digest: host_agent_action_text_v4(fields, "associationDigest", "detach")?,
        attach_digest: host_agent_action_text_v4(fields, "attachDigest", "detach")?,
        operation: distributed_decode_operation_v2(host_agent_action_text_v4(fields, "operation", "detach")?)?,
        signed: distributed_decode_signed_grant_v2(host_agent_action_text_v4(fields, "signed", "detach")?)?,
        approval: distributed_decode_signed_approval_v2(host_agent_action_text_v4(fields, "approval", "detach")?)?)
    if host_agent_detach_request_encode_v4(value)? != source: return Err("linux-host-agent-detach-noncanonical")
    Ok(value)

# ---- archive (13.2: no-replace + read-back; F5) ----

pub fn host_agent_attach_archive_relative_v4(fence: text, operation_id: text) -> text:
    "host-agent-attach/" + sha256_text(fence + "\n" + operation_id) + ".sdn"

pub fn host_agent_detach_archive_relative_v4(fence: text, operation_id: text) -> text:
    "host-agent-detach/" + sha256_text(fence + "\n" + operation_id) + ".sdn"

# Ok(true): the archived bytes are exactly `source` (REPLAY, answered from state); Ok(false): nothing archived;
# a different packet for the slot is `conflict` (nothing is replaced).
pub fn host_agent_action_archive_check_v4(archived: Option<text>, source: text, conflict: text) -> Result<bool, text>:
    if archived.is_none(): return Ok(false)
    if archived.unwrap() != source: return Err(conflict)
    Ok(true)

# No-replace publish then read-back: the slot must hold exactly `source` afterwards (an existing slot is never
# replaced; its bytes are what the read-back compares).
pub fn host_agent_action_archive_v4(journal: DistributedOperationJournalV2, relative: text, source: text,
        conflict: text) -> Result<(), text>:
    val published = distributed_operation_journal_publish_v3(journal, relative, source)
    if published.is_err(): return Err(published.unwrap_err())
    if distributed_operation_journal_read_required_v3(journal, relative, HOST_AGENT_ATTACH_MAX_BYTES_V4)? != source:
        return Err(conflict)
    Ok(())

# ---- the pure attach facts check (13.2, D2a, F8, 14B, 14C) ----

# Everything the pure check reads that is not agent state. TWO clocks (m23 P2-5): `now` is the grant clock of
# `not_after`; `monotonic_ms` is the clock of the receipt's `prepare_deadline_ms`. The glue passes both; live incarnation/epoch come from the service's OWN state.
# 14C: `plan.identity.binding_digest` is the control-target binding digest (primary_input_v1), NOT the pane
# binding digest, so it is not a fact here; the plan<->binding pairing is the signed digests' job
# (host_agent_attach_binding_plan_check_v4).
pub struct HostAgentAttachFactsV4:
    helper_kind: text
    plan_parent_operation_id: text
    binding: HostAgentPaneBindingV4
    live_incarnation: text
    live_epoch: i64
    prepare_deadline_ms: i64
    not_after: i64
    now: i64
    monotonic_ms: i64

# allow(primitive_api): reviewed live epoch + clock DATA words (milestone_0021 14B, D2a)
pub fn host_agent_attach_facts_v4(parts: HostAgentAttachPartsV4, live_incarnation: text, live_epoch: i64, not_after: i64, now: i64,
        monotonic_ms: i64) -> HostAgentAttachFactsV4:
    HostAgentAttachFactsV4(helper_kind: parts.helper.plan.helper_kind,
        plan_parent_operation_id: parts.plan.identity.parent_operation_id, binding: parts.binding,
        live_incarnation: live_incarnation, live_epoch: live_epoch,
        prepare_deadline_ms: parts.helper.intent.reservation.prepare_deadline_ms, not_after: not_after, now: now,
        monotonic_ms: monotonic_ms)

# The receipt's monotonic prepare deadline expressed on the grant clock the attachment machine runs on (m23 P2-5):
# the remaining prepare budget added to the grant clock now. Stored once at attach; the expire core still reads the
# receipt's own monotonic deadline.
# allow(primitive_api): reviewed clock DATA words (m23 P2-5)
pub fn host_agent_attach_grant_deadline_v4(prepare_deadline_ms: i64, now: i64, monotonic_ms: i64) -> i64:
    now + (prepare_deadline_ms - monotonic_ms)

# The facts half of the pure transition check; the agent half (stage, consumed, pending, holder, stop) runs
# first in host_agent_attach_check_core_v4. A prepare that already expired (P3-3) can only fail after the archive,
# so it is refused here with the D2a window error; an epoch-0 binding is refused by the binding validation
# inside the live check (14C, `host-agent-pane-binding-epoch-invalid`).
pub fn host_agent_attach_facts_check_v4(facts: HostAgentAttachFactsV4, operation_id: text) -> Result<(), text>:
    if facts.helper_kind != "attach-broker": return Err("attach-helper-kind")
    if facts.plan_parent_operation_id != operation_id: return Err("attach-plan-parent")
    if facts.now >= facts.not_after: return Err("attach-stopping")
    if (facts.prepare_deadline_ms <= facts.monotonic_ms or
            facts.prepare_deadline_ms - facts.monotonic_ms > HOST_AGENT_ATTACH_PREPARE_TTL_MS_V4):
        return Err("attach-prepare-window")
    host_agent_pane_binding_live_check_v4(facts.binding, facts.live_incarnation, facts.live_epoch)

# ---- read-only report (13.2 inspect/progress: never runs release) ----

pub fn host_agent_attachment_report_v4(operation_id: text, attachment: Option<HostAgentAttachmentV4>,
        summary: Option<HostAgentAttachmentSummaryV4>) -> text:
    host_agent_attachment_authority_report_v4(operation_id, attachment, summary, "")

# The report of the service inspect (milestone_0023 part B): `terminal_authority` is the verdict of the service's
# terminal-authority accessor for a ready/adopted attachment ("verified", or its refusal); "" omits the field.
pub fn host_agent_attachment_authority_report_v4(operation_id: text, attachment: Option<HostAgentAttachmentV4>,
        summary: Option<HostAgentAttachmentSummaryV4>, terminal_authority: text) -> text:
    var fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-agent-attachment"),
        "operationId": SdnValue.String(operation_id)}
    if val att = attachment:
        fields["attachStage"] = SdnValue.String(att.attach_stage)
        fields["leaseEpoch"] = SdnValue.Int(att.lease_epoch)
        fields["readyDeadlineMs"] = SdnValue.Int(att.ready_deadline_ms)
        fields["ioDeadlineMs"] = SdnValue.Int(att.io_deadline_ms)
        fields["detachDeadlineMs"] = SdnValue.Int(att.detach_deadline_ms)
        fields["attachDigest"] = SdnValue.String(att.attach_digest)
        fields["detachDigest"] = SdnValue.String(att.detach_digest)
        fields["error"] = SdnValue.String(att.first_error)
        if att.quiesce_proof_digest != "": fields["quiesceProofDigest"] = SdnValue.String(att.quiesce_proof_digest)
        if terminal_authority != "": fields["terminalAuthority"] = SdnValue.String(terminal_authority)
    elif val kept = summary:
        fields["attachStage"] = SdnValue.String(kept.final_stage)
        fields["attachDigest"] = SdnValue.String(kept.attach_digest)
        fields["detachDigest"] = SdnValue.String(kept.detach_digest)
        fields["error"] = SdnValue.String(kept.error)
        if kept.quiesce_proof_digest != "": fields["quiesceProofDigest"] = SdnValue.String(kept.quiesce_proof_digest)
    else:
        fields["attachStage"] = SdnValue.String("none")
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
