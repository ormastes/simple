# Explicit helper cleanup and proof-only Host settlement. Neither operation
# stops the container workload. smux/Caret consumption remains a separate step.
use std.nogc_sync_mut.orchestration.host_primary_attach_owner_v1.HostPrimaryAttachTurnV1
use std.nogc_sync_mut.orchestration.host_primary_attach_record_v1.*
use std.nogc_sync_mut.orchestration.host_primary_attach_settlement_receipt_v1.*
use std.nogc_sync_mut.orchestration.host_helper_stream_record_v1.{HostHelperAdmissionContextV1, HostHelperStoreV1,
    host_helper_store_legacy_v1, host_helper_store_rebind_v1}
use std.nogc_sync_mut.orchestration.host_linux_helper_store_v1.host_helper_store_primary_domain_v1
use std.nogc_sync_mut.orchestration.host_helper_settlement_commit_v1.HostHelperSettlementAckV1
use std.nogc_sync_mut.orchestration.host_primary_attach_recovery_v1.host_primary_attach_commit_reap_core_v1
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.HostCapacityOwnerV1
use std.nogc_sync_mut.orchestration.host_helper_owner_v1.HostHelperLeaseV1
use std.nogc_async_mut.container.terminal_session_v1.ContainerPrimaryAttachSessionV1
use std.nogc_sync_mut.daemon_sdk.operation_dispatch_v2.daemon_operation_exact_v2
use std.nogc_async_mut.container.terminal_session_v1.{ContainerOwnedTerminalSessionV1,
    container_primary_attach_plan_v1, container_primary_attach_native_matches_v1,
    container_primary_attach_adoption_v1, container_primary_attach_native_cleaned_v1,
    container_terminal_cleanup_v1, container_primary_attach_collect_reap_v1}
use std.common.contracts.container.primary_attach_v1.{ContainerPrimaryAttachPlanV1,
    container_primary_attach_plan_encode_v1, container_primary_attach_admission_validate_v1}
use std.common.contracts.container.stream_v2.ContainerHelperAdmissionV2
use std.common.contracts.orchestration.host_helper_plan_v1.host_helper_plan_bytes_v1
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.nogc_sync_mut.io.group_process_owner.{GroupProcessStreamOwnerV2, group_process_stream_collect_reap_v2}
use std.nogc_sync_mut.io.process_ops.{PipedProcessOwnedSpawnV2, PipedProcessRefV1,
    process_cleanup_piped_owned_v2, process_retire_piped_owned_v2}

pub struct HostPrimaryAttachCleanupTurnV1:
    retained: HostPrimaryAttachTurnV1
    cleaned: bool
    error: text

pub struct HostPrimaryAttachSettlementTurnV1:
    retained: HostPrimaryAttachTurnV1
    settled: bool
    ack: HostHelperSettlementAckV1?
    error: text

# milestone_0022 N1 (DESIGN 15.1): what cleanup/settle actually need, without a
# HostLocalRootV1. The container owner is not part of it: neither cleanup nor
# settle calls the container owner (cleanup goes through the terminal session).
pub struct HostPrimaryAttachCoreRetainedV1:
    store: HostHelperStoreV1
    capacity: HostCapacityOwnerV1
    helper: HostHelperLeaseV1
    plan: ContainerPrimaryAttachPlanV1
    session: Option<ContainerPrimaryAttachSessionV1>
    cleanup_spawn: Option<PipedProcessOwnedSpawnV2>

pub struct HostPrimaryAttachCoreCleanupTurnV1:
    retained: HostPrimaryAttachCoreRetainedV1
    cleaned: bool
    error: text

pub struct HostPrimaryAttachCoreSettlementTurnV1:
    retained: HostPrimaryAttachCoreRetainedV1
    settled: bool
    ack: Option<HostHelperSettlementAckV1>
    error: text

struct PrimarySettlementContextV1:
    consumed: HostPrimaryAttachConsumedV1
    authority: HostHelperAdmissionContextV1
    native: GroupProcessStreamOwnerV2

fn primary_reference_matches_v1(native: GroupProcessStreamOwnerV2,
        reference: PipedProcessRefV1?) -> Result<(), text>:
    match reference:
        case Some(value):
            if (value.pid <= 0 or value.generation != native.launch.transport_generation or
                    value.group_root != native.launch.root or value.group_identity != native.identity_digest):
                return Err("host-primary-reference-mismatch")
        case None: ()
    Ok(())

# Legacy turn <-> core retained. The legacy store is the capacity journal root.
fn primary_core_retained_v1(turn: HostPrimaryAttachTurnV1) -> HostPrimaryAttachCoreRetainedV1:
    HostPrimaryAttachCoreRetainedV1(store: host_helper_store_legacy_v1(turn.local.capacity.journal.root),
        capacity: turn.local.capacity, helper: turn.helper, plan: turn.plan, session: turn.session,
        cleanup_spawn: turn.cleanup_spawn)

fn primary_legacy_retained_v1(turn: HostPrimaryAttachTurnV1, core: HostPrimaryAttachCoreRetainedV1) -> HostPrimaryAttachTurnV1:
    var current = turn
    current.local.capacity = core.capacity
    current.session = core.session
    current.cleanup_spawn = core.cleanup_spawn
    current

fn primary_retained_context_v1(retained: HostPrimaryAttachCoreRetainedV1) -> Result<PrimarySettlementContextV1, text>:
    val helper = retained.helper
    val store = host_helper_store_rebind_v1(retained.store, retained.capacity.journal)
    val state = daemon_operation_exact_v2(retained.capacity.journal, helper.operation)?
    if not ["executing", "outcome-unknown", "completed"].contains(state.state):
        return Err("host-primary-settlement-execution-required")
    # Legacy: the pathname classifier; V4: the store-aware classifier (DESIGN 15.1).
    host_helper_store_primary_domain_v1(store, helper.operation.id)?
    val consumed = host_primary_attach_consumed_load_core_v1(store, helper.operation)?
    val context = host_primary_attach_validate_record_core_v1(store, helper.operation, consumed)?
    if (container_primary_attach_plan_encode_v1(retained.plan)? != container_primary_attach_plan_encode_v1(consumed.primary_plan)? or
            host_helper_plan_bytes_v1(helper.plan)? != host_helper_plan_bytes_v1(context.request.plan)? or
            distributed_encode_operation_v2(helper.operation)? != distributed_encode_operation_v2(context.request.operation)? or
            helper.receipt.receipt_digest != consumed.prepared_receipt_digest or
            helper.deadline.expires_at_unix_ms != consumed.deadline_unix_ms or
            helper.grant_id != context.admission.grant_id or helper.issuer_id != context.admission.issuer_id or
            helper.approver_id != context.admission.approver_id):
        return Err("host-primary-retained-bundle-mismatch")
    val admission = ContainerHelperAdmissionV2(intent: helper.intent, plan: helper.plan, operation: helper.operation,
        receipt: helper.receipt, deadline: helper.deadline, grant_id: helper.grant_id,
        issuer_id: helper.issuer_id, approver_id: helper.approver_id, cpu_millis: helper.cpu_millis,
        memory_bytes: helper.memory_bytes)
    val checked = container_primary_attach_admission_validate_v1(consumed.primary_plan, admission)?
    # Current journal ownership was checked before possible metadata repair.
    val native = host_primary_attach_native_recover_core_v1(store, helper.operation)?
    match retained.session:
        case Some(session):
            if retained.cleanup_spawn.is_some(): return Err("host-primary-multiple-native-carriers")
            if (container_primary_attach_plan_encode_v1(container_primary_attach_plan_v1(session))? !=
                    container_primary_attach_plan_encode_v1(consumed.primary_plan)?):
                return Err("host-primary-session-plan-mismatch")
            container_primary_attach_native_matches_v1(session, native)?
        case None:
            val held = match retained.cleanup_spawn:
                case Some(value): value
                case None: return Err("host-primary-native-carrier-required")
            val live = match held:
                case PipedProcessOwnedSpawnV2.Ready(value, reference):
                    primary_reference_matches_v1(value, Some(reference))?
                    value
                case PipedProcessOwnedSpawnV2.CleanupRequired(value, reference, _):
                    primary_reference_matches_v1(value, reference)?
                    value
                case PipedProcessOwnedSpawnV2.Rejected(_): return Err("host-primary-native-absence-unproven")
            host_primary_attach_native_match_v1(consumed, live)?
            if live.identity_digest != native.identity_digest: return Err("host-primary-native-owner-mismatch")
    Ok(PrimarySettlementContextV1(consumed, context, native))

# Before adoption only. After handoff, the canonical terminal owner performs
# cleanup and returns its updated session for settlement. Value copies are not
# mechanically revoked: callers must retain exactly the returned canonical turn.
# The adoption guard lives HERE ONLY (DESIGN 20); the core accepts adopted sessions.
pub fn host_primary_attach_cleanup_v1(retained: HostPrimaryAttachTurnV1) -> HostPrimaryAttachCleanupTurnV1:
    match retained.session:
        case Some(session):
            if container_primary_attach_adoption_v1(session).is_some():
                return HostPrimaryAttachCleanupTurnV1(retained, false, "host-primary-cleanup-belongs-to-terminal-owner")
        case None: ()
    val cleaned = host_primary_attach_cleanup_core_v1(primary_core_retained_v1(retained))
    HostPrimaryAttachCleanupTurnV1(primary_legacy_retained_v1(retained, cleaned.retained), cleaned.cleaned, cleaned.error)

# Accepts an adopted session: the V4 agent cleans an adopted primary attach through
# container_terminal_cleanup_v1(PrimaryAttach(session)) on this path (DESIGN 20).
pub fn host_primary_attach_cleanup_core_v1(retained: HostPrimaryAttachCoreRetainedV1) -> HostPrimaryAttachCoreCleanupTurnV1:
    val checked = primary_retained_context_v1(retained)
    if checked.is_err(): return HostPrimaryAttachCoreCleanupTurnV1(retained, false, checked.unwrap_err())
    var current = retained
    match retained.session:
        case Some(session):
            val cleaned = container_terminal_cleanup_v1(ContainerOwnedTerminalSessionV1.PrimaryAttach(session))
            match cleaned.session:
                case ContainerOwnedTerminalSessionV1.PrimaryAttach(updated): current.session = Some(updated)
                case _: return HostPrimaryAttachCoreCleanupTurnV1(current, false, "host-primary-cleanup-session-kind")
            HostPrimaryAttachCoreCleanupTurnV1(current, cleaned.cleaned, cleaned.error)
        case None:
            val native = checked.unwrap().native
            val reference = match retained.cleanup_spawn.unwrap():
                case PipedProcessOwnedSpawnV2.Ready(_, value): Some(value)
                case PipedProcessOwnedSpawnV2.CleanupRequired(_, value, _): value
                case PipedProcessOwnedSpawnV2.Rejected(_):
                    return HostPrimaryAttachCoreCleanupTurnV1(current, false, "host-primary-native-absence-unproven")
            val cleaned = process_cleanup_piped_owned_v2(native, reference)
            if cleaned.is_err(): return HostPrimaryAttachCoreCleanupTurnV1(current, false, cleaned.unwrap_err())
            # Exact native retirement succeeded. Retain cleanup authority while
            # removing the stale descriptor reference; charge remains retained.
            current.cleanup_spawn = Some(PipedProcessOwnedSpawnV2.CleanupRequired(native, None,
                "host-primary-cleaned-awaiting-settlement"))
            HostPrimaryAttachCoreCleanupTurnV1(current, true, "")

# Observation-only: missing native proof never invokes cancel or workload stop.
# Every failed turn retains session progress and the newest journal/capacity owner.
pub fn host_primary_attach_settle_v1(retained: HostPrimaryAttachTurnV1) -> HostPrimaryAttachSettlementTurnV1:
    val settled = host_primary_attach_settle_core_v1(primary_core_retained_v1(retained))
    var current = primary_legacy_retained_v1(retained, settled.retained)
    if settled.settled:
        current.recovery_required = false
        current.error = ""
    HostPrimaryAttachSettlementTurnV1(current, settled.settled, settled.ack, settled.error)

pub fn host_primary_attach_settle_core_v1(retained: HostPrimaryAttachCoreRetainedV1) -> HostPrimaryAttachCoreSettlementTurnV1:
    val checked = primary_retained_context_v1(retained)
    if checked.is_err(): return HostPrimaryAttachCoreSettlementTurnV1(retained, false, None, checked.unwrap_err())
    val context = checked.unwrap()
    val lease_result = host_primary_attach_grouped_lease_v1(context.consumed, context.authority, context.native)
    if lease_result.is_err(): return HostPrimaryAttachCoreSettlementTurnV1(retained, false, None, lease_result.unwrap_err())
    val lease = lease_result.unwrap()
    var current = retained
    match retained.session:
        case Some(session):
            if (container_primary_attach_adoption_v1(session).is_some() and
                    not container_primary_attach_native_cleaned_v1(session)):
                return HostPrimaryAttachCoreSettlementTurnV1(current, false, None, "host-primary-terminal-owner-cleanup-required")
            val reaped = container_primary_attach_collect_reap_v1(session, context.authority.admission, lease)
            current.session = Some(reaped.session)
            if reaped.error != "": return HostPrimaryAttachCoreSettlementTurnV1(current, false, None, reaped.error)
            if reaped.receipt.is_none(): return HostPrimaryAttachCoreSettlementTurnV1(current, false, None, "host-primary-reap-required")
        case None:
            # Canonical proof was acquired above. No stale native-ref retries.
            val retired = process_retire_piped_owned_v2(context.native, None)
            if retired.is_err(): return HostPrimaryAttachCoreSettlementTurnV1(current, false, None, retired.unwrap_err())
            current.cleanup_spawn = Some(PipedProcessOwnedSpawnV2.CleanupRequired(context.native, None,
                "host-primary-cleaned-awaiting-settlement"))
            val reaped = group_process_stream_collect_reap_v2(context.native, lease)
            if reaped.is_err(): return HostPrimaryAttachCoreSettlementTurnV1(current, false, None, reaped.unwrap_err())
    val committed = host_primary_attach_commit_reap_core_v1(current.store, current.capacity, current.helper.operation)
    current.capacity = committed.owner
    if committed.ack.is_none(): return HostPrimaryAttachCoreSettlementTurnV1(current, false, None, committed.error)
    HostPrimaryAttachCoreSettlementTurnV1(current, true, committed.ack, "")
