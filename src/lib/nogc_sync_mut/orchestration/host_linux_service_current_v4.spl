    host_linux_service_agent_input_v4, host_linux_service_agent_budget_v4, host_linux_service_agent_open_v4,
    host_linux_service_agent_step_v4, host_linux_service_agent_reply_v4, host_linux_service_agent_epoch_v4,
    host_linux_service_agent_close_v4, host_linux_service_agent_release_v4, host_linux_service_agent_request_cancel_v4,
    host_agent_cancel_request_decode_v4, host_agent_cancel_archive_check_v4, host_linux_service_agent_cancel_authorize_v4}
