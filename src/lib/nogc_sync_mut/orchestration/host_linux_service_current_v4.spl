# Owner of one genuine Linux service startup. Every acquired owner is retained
# here, including on a failed turn. `published` is set only after the immutable
# current record was read back byte-exact from the same Host journal, and
# status_v4 is the only ready/status producer: it cannot run before that.
pub class HostLinuxServiceCurrentV4:
    root: text
    root_reader: Option<LinuxProtectedRootReaderV1> = None
    parent_reader: Option<LinuxProtectedRootReaderV1> = None
    proof: Option<LinuxServiceVerifiedEnrollmentV1> = None
    native: Option<LinuxServiceNativeIdentityBorrowV3> = None
    # Offline store-inventory borrow lent by the same admission; handed back
    # after a proved startup reconcile, else before the native loan ends.
    inventory: Option<LinuxFreshEpochStoreInventoryBorrowV1> = None
    # Set only by linux_service_inventory_return_v4 after the exact borrow was
    # handed back; current_v4 then requires the in-memory continuity proof.
    inventory_returned: bool = false
    native_snapshot: Option<LinuxServiceNativeIdentitySnapshotV3> = None
    records: Option<HostLinuxServiceRecordsV4> = None
    capacity: Option<HostCapacityOwnerV1> = None
    journal_cleanup: Option<DistributedOperationJournalOpenCleanupV2> = None
    scope: Option<ContainerHostScopeV2> = None
    initial_epoch: text = ""
    current_relative: text = ""
    current_bytes: text = ""
    published: bool = false
    reconcile_error: text = ""
    closed: bool = false
    close_error: text = ""
    # Installed opener only: the fresh-epoch admission that lent `native`.
    # Owned for the whole service lifetime and closed last, after the loan ends.
    admission: Option<MachineFreshEpochAdmissionTurnV1> = None
    # milestone_0021 PR2 (DESIGN section 2): the ONE agent of this incarnation. After its transfer the admission
    # owner lives in the agent's holder and `admission` keeps only the residue (F9).
    agent: Option<HostLinuxServiceAgentV4> = None
    agent_consumed: bool = false
    # N-06/T-08 slot: set before the agent prepare charges; one agent operation per incarnation.
    agent_operation_id: text = ""
    # P2R1-F8: the slot's signed operation envelope, for the public exact lookup (set with agent_operation_id).
    agent_operation: Option<OperationEnvelopeV2> = None
    # milestone_0030 s1: the slot's workload kind ("", "agent", "remote-build"), set and cleared with agent_operation_id.
    slot_kind: text = ""
    # milestone_0030: the ONE remote-build executor of this incarnation (never set together with `agent`); after its
    # transfer the admission owner lives in its holder. The port is the app half (F5), installed by the composition.
    build: Option<HostRemoteBuildExecutorV3> = None
    remote_build_port: Option<HostRemoteBuildPortV4> = None
    # 3.3 N-05: a pre-transfer workspace-root borrow whose loan end the lender refused; ended first at close.
    agent_root: Option<LinuxWorkspaceRootBorrowV3> = None
    # U-05 (hco:366-368): a post-outcome projection failure of the slot expiry; sticky until restart.
    journal_quarantine: text = ""
    # milestone_0022 13.1/14.2 (custody wiring deferred from N1 to PR3b): the verified helper store root, opened
    # after the journal and before any attach; "" when not opened (an attach then refuses). Pathname store: no
    # handle to close; it outlives every attachment release and is left in place across restarts.
    helper_store: text = ""
    # AT-OPS-01: set only after a verified controller-signed handoff was published; this owner then admits nothing
    # (inspect only) and is to be closed. The successor adopts the record at its own start.
    draining: bool = false

    # milestone_0030 N11: the installed facts the remote-build port is built from, taken from the service's own
    # re-verified records (never a caller path): the verified policy snapshot and the physical host identity.
    pub fn remote_build_facts_v4() -> Result<(LocalAuthorityPolicyV1, text), text>:
        val metadata = self.current_v4()?
        if self.records.is_none(): return Err("linux-host-remote-build-records-required")
        Ok((metadata.policy, self.records.unwrap().binding.physical_host_id))

    # Rechecks readers, installed records, the sealed proof under freshly read
    # installed policy, the actual native identity, Linux-protected journal
    # currency and the stored current record before returning metadata.
    pub fn current_v4() -> Result<HostPrivateMetadataV2, text>:
        if self.closed: return Err("linux-host-service-closed")
        if self.journal_quarantine != "": return Err(self.journal_quarantine)
        if not self.published or self.current_bytes == "" or self.current_relative == "":
            return Err("linux-host-service-current-unpublished")
        if (self.root_reader.is_none() or self.parent_reader.is_none() or self.proof.is_none() or
                self.native.is_none() or self.native_snapshot.is_none() or self.records.is_none() or
                self.capacity.is_none() or self.scope.is_none()):
            return Err("linux-host-service-acquisition-incomplete")
        # The lending admission (installed opener) must still be current, still
        # lent to this service, and still the exact epoch whose digest it lent.
        if self.agent.is_some() and self.build.is_some(): return Err("linux-host-service-workload-duplicated")
        if val agent = self.agent:
            # 3.5: after the transfer the epoch is read through whichever holder has it; workload liveness is
            # never consulted. The inventory can only be returned and proven here (a transfer follows the handoff).
            if self.admission.is_some() and self.admission.unwrap().owner.is_some():
                return Err("linux-host-service-admission-duplicated")
            if (not self.inventory_returned or self.inventory.is_some() or
                    not self.capacity.unwrap().ledger.continuity_proven):
                return Err("linux-host-service-inventory-return-unproven")
            val epoch = host_linux_service_agent_epoch_v4(agent)?
            if sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?) != self.initial_epoch:
                return Err("linux-host-service-epoch-changed")
        elif self.build.is_some() and self.agent_consumed:
            # s11 F2: the transferred-keyed build branch (a pre-transfer build still reads the lent admission below).
            val build = self.build.unwrap()
            if self.admission.is_some() and self.admission.unwrap().owner.is_some():
                return Err("linux-host-service-admission-duplicated")
            if (not self.inventory_returned or self.inventory.is_some() or
                    not self.capacity.unwrap().ledger.continuity_proven):
                return Err("linux-host-service-inventory-return-unproven")
            val epoch = host_remote_build_epoch_v4(build)?
            if sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?) != self.initial_epoch:
                return Err("linux-host-service-epoch-changed")
        elif val admission = self.admission:
            if admission.owner.is_none(): return Err("linux-host-service-admission-missing")
            val lender = admission.owner.unwrap()
            if not lender.service_loaned: return Err("linux-host-service-loan-inactive")
            # The store loan is either still out (held here, not returned) or
            # was returned by the post-reconcile handoff, which needs the proof.
            if lender.store_inventory_loaned:
                if self.inventory.is_none() or self.inventory_returned:
                    return Err("linux-host-service-inventory-loan-inactive")
            elif (not self.inventory_returned or self.inventory.is_some() or
                    not self.capacity.unwrap().ledger.continuity_proven):
                return Err("linux-host-service-inventory-return-unproven")
            val epoch = lender.current_v1()?
            if sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?) != self.initial_epoch:
                return Err("linux-host-service-epoch-changed")
        val loaded = host_linux_service_records_load_v4(self.root, self.root_reader.unwrap(), self.parent_reader.unwrap())?
        linux_service_records_same_v4(self.records.unwrap(), loaded)?
        linux_service_proof_read_v4(self.proof.unwrap(), loaded.binding, loaded.credential, self.root_reader.unwrap())?
        val native = self.native.unwrap().current_v3()?
        if linux_service_native_key_v4(native) != linux_service_native_key_v4(self.native_snapshot.unwrap()):
            return Err("linux-host-service-native-changed")
        val capacity = self.capacity.unwrap()
        host_capacity_owner_linux_current_v3(capacity)?
        if capacity.journal.root != linux_service_journal_root_v4(self.root, loaded.metadata):
            return Err("linux-host-service-journal-root-mismatch")
        if distributed_operation_journal_read_required_v3(capacity.journal, self.current_relative, 16384)? != self.current_bytes:
            return Err("linux-host-service-current-record-changed")
        if linux_service_current_bytes_v4(loaded.binding, self.scope.unwrap(), native, self.initial_epoch,
                loaded.claim_digest, capacity.journal)? != self.current_bytes:
            return Err("linux-host-service-current-binding-mismatch")
        Ok(loaded.metadata)

    # Scope for correlation through the shared Host domain. Before startup it
    # is an empty scope whose fence id is refused, never a fabricated one.
    pub fn scope_v4() -> ContainerHostScopeV2:
        if self.scope.is_some(): return self.scope.unwrap()
        ContainerHostScopeV2(physical_host_id: "", service_scope_id: "", boot_id: "", provider_generation: 0,
            native_machine_id: "", continuity_mode: "", continuity_id: "")

    # The only ready/status publication. Unreconciled historical reservations
    # keep the service quarantined; no empty-ledger assertion releases them.
    pub fn status_v4() -> Result<text, text>:
        val metadata = self.current_v4()?
        if self.draining: return Err("linux-host-service-draining")
        if self.reconcile_error != "": return Err("linux-host-service-reconciliation-required:" + self.reconcile_error)
        if not self.capacity.unwrap().ledger.continuity_proven:
            return Err("linux-host-service-reconciliation-required")
        linux_service_status_bytes_v4(self.records.unwrap().binding, self.scope.unwrap(), self.current_bytes, self.published)

pub struct HostLinuxServiceStartTurnV4:
    owner: HostLinuxServiceCurrentV4
    error: text

pub struct HostLinuxServiceReplyV4:
    owner: HostLinuxServiceCurrentV4
    response: text
    error: text
    effect_attempted: bool

fn linux_service_start_error_v4(owner: HostLinuxServiceCurrentV4, error: text) -> HostLinuxServiceStartTurnV4:
    HostLinuxServiceStartTurnV4(owner: owner, error: error)

fn linux_service_reply_v4(owner: HostLinuxServiceCurrentV4, response: text, error: text,
        effect_attempted: bool) -> HostLinuxServiceReplyV4:
    HostLinuxServiceReplyV4(owner: owner, response: response, error: error, effect_attempted: effect_attempted)

fn linux_service_native_key_v4(native: LinuxServiceNativeIdentitySnapshotV3) -> text:
    native.native_machine_id + "\n" + native.native_boot_id + "\n" + native.architecture + "\n" +
        native.owner_generation.to_text() + "\n" + native.process_identity_digest + "\n" +
        native.process_generation.to_text() + "\n" + native.authority_namespace_id

# Canonical identity comparison, never struct equality.
fn linux_service_records_same_v4(original: HostLinuxServiceRecordsV4, loaded: HostLinuxServiceRecordsV4) -> Result<(), text>:
    if (host_linux_service_enrollment_digest_v3(original.binding)? != host_linux_service_enrollment_digest_v3(loaded.binding)? or
            original.claim_digest != loaded.claim_digest or original.authorized_at != loaded.authorized_at or
            original.metadata.policy.source_digest != loaded.metadata.policy.source_digest):
        return Err("linux-host-service-installed-records-changed")
    Ok(())

# The proof must be this installed association AND its installed credential,
# and must re-verify, with a fresh clock, against policy bytes `held` that the
# caller read through its OWN protected reader. An approval that expired while
# down is refused here.
fn linux_service_proof_held_v4(proof: LinuxServiceVerifiedEnrollmentV1, binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, held: Option<text>) -> Result<(), text>:
    if proof.binding_digest()? != host_linux_service_enrollment_digest_v3(binding)?:
        return Err("linux-host-service-proof-binding-mismatch")
    if proof.credential_digest()? != sha256_text(host_enrollment_credential_encode_v1(credential)?):
        return Err("linux-host-service-proof-credential-mismatch")
    linux_service_enrollment_installed_v1(proof, held)

fn linux_service_proof_read_v4(proof: LinuxServiceVerifiedEnrollmentV1, binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, reader: LinuxProtectedRootReaderV1) -> Result<(), text>:
    val held = host_linux_service_read_v4(reader, "authority-policy.sdn")?
    linux_service_proof_held_v4(proof, binding, credential, Some(held))

# Stable service scope: signed physical/service IDs, actual native machine and
# provider generation, empty boot and one fresh OS-random incarnation.
fn linux_service_scope_v4(binding: HostLinuxServiceEnrollmentBindingV3, native: LinuxServiceNativeIdentitySnapshotV3,
        incarnation: text) -> Result<ContainerHostScopeV2, text>:
    if not host_service_hex_shape_v6(incarnation, 32): return Err("linux-host-service-entropy-unavailable")
    if native.native_machine_id != binding.native_machine_id: return Err("linux-host-service-native-machine-mismatch")
    if native.owner_generation < 1: return Err("linux-host-service-native-generation")
    val scope = ContainerHostScopeV2(physical_host_id: binding.physical_host_id, service_scope_id: binding.service_scope_id,
        boot_id: "", provider_generation: native.owner_generation, native_machine_id: native.native_machine_id,
        continuity_mode: "service-incarnation-v1", continuity_id: incarnation)
    val valid = container_host_scope_bytes_v2(scope)?
    Ok(scope)

fn linux_service_capacity_v4(binding: HostLinuxServiceEnrollmentBindingV3, scope: ContainerHostScopeV2) -> Result<HostCapacityV1, text>:
    val allowed = host_linux_service_allocatable_v3(binding)?
    Ok(HostCapacityV1(physical_host_id: binding.physical_host_id,
        authority_id: "host-" + host_linux_service_enrollment_digest_v3(binding)?,
        boot_id: container_scope_fence_id_v2(scope)?, provider_generation: scope.provider_generation,
        cpu_millis: allowed.cpu_millis, memory_bytes: allowed.memory_bytes, exclusive_devices: []))

# The installed journal root, never a caller-chosen path.
fn linux_service_journal_root_v4(root: text, metadata: HostPrivateMetadataV2) -> text:
    root + "/" + metadata.configuration.journal_root

# The protected open must reproduce exactly the fenced capacity it was given.
fn linux_service_capacity_same_v4(owner: HostCapacityOwnerV1, expected: HostCapacityV1) -> Result<(), text>:
    val actual = owner.ledger.capacity
    if (actual.physical_host_id != expected.physical_host_id or actual.authority_id != expected.authority_id or
            actual.boot_id != expected.boot_id or actual.provider_generation != expected.provider_generation or
            actual.cpu_millis != expected.cpu_millis or actual.memory_bytes != expected.memory_bytes or
            actual.exclusive_devices.len() != 0):
        return Err("linux-host-service-capacity-mismatch")
    Ok(())

fn linux_service_status_bytes_v4(binding: HostLinuxServiceEnrollmentBindingV3, scope: ContainerHostScopeV2,
        current_bytes: text, published: bool) -> Result<text, text>:
    if not published or current_bytes == "": return Err("linux-host-service-current-unpublished")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-service-status"),
        "enrollmentDigest": SdnValue.String(host_linux_service_enrollment_digest_v3(binding)?),
        "scope": SdnValue.String(container_host_scope_bytes_v2(scope)?),
        "currentRecordDigest": SdnValue.String(sha256_text(current_bytes)), "state": SdnValue.String("ready")}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

# Actual startup. `initial_epoch_digest` is the lent epoch digest
# (MachineFreshEpochServiceLoanTurnV1.epoch_digest); prepare binds every
# projected plan to service_scope_id == "epoch-" + this digest (start itself
# only validates its shape). The sole Host capacity journal is opened here, Linux-protected, at the
# installed journal root, for exactly the fenced capacity of this incarnation.
pub fn host_linux_service_start_v4(root: text, root_reader: LinuxProtectedRootReaderV1,
        parent_reader: LinuxProtectedRootReaderV1, proof: LinuxServiceVerifiedEnrollmentV1,
        native: LinuxServiceNativeIdentityBorrowV3, initial_epoch_digest: text,
        inventory: LinuxFreshEpochStoreInventoryBorrowV1) -> HostLinuxServiceStartTurnV4:
    var owner = HostLinuxServiceCurrentV4(root: root, root_reader: Some(root_reader), parent_reader: Some(parent_reader),
        proof: Some(proof), native: Some(native), inventory: Some(inventory))
    if not builder_digest_valid_v1(initial_epoch_digest): return linux_service_start_error_v4(owner, "linux-host-service-epoch-digest")
    owner.initial_epoch = initial_epoch_digest
    val loaded = host_linux_service_records_load_v4(root, root_reader, parent_reader)
    if loaded.is_err(): return linux_service_start_error_v4(owner, loaded.unwrap_err())
    owner.records = Some(loaded.unwrap())
    val binding = loaded.unwrap().binding
    val proved = linux_service_proof_read_v4(proof, binding, loaded.unwrap().credential, root_reader)
    if proved.is_err(): return linux_service_start_error_v4(owner, proved.unwrap_err())
    val observed = native.current_v3()
    if observed.is_err(): return linux_service_start_error_v4(owner, observed.unwrap_err())
    owner.native_snapshot = Some(observed.unwrap())
    val incarnation = sosix_random_hex(16) ?? ""
    val journal_nonce = sosix_random_hex(32) ?? ""
    if not host_service_hex_shape_v6(journal_nonce, 64): return linux_service_start_error_v4(owner, "linux-host-service-entropy-unavailable")
    val scope = linux_service_scope_v4(binding, observed.unwrap(), incarnation)
    if scope.is_err(): return linux_service_start_error_v4(owner, scope.unwrap_err())
    owner.scope = Some(scope.unwrap())
    val expected = linux_service_capacity_v4(binding, scope.unwrap())
    if expected.is_err(): return linux_service_start_error_v4(owner, expected.unwrap_err())
    val configuration = loaded.unwrap().metadata.configuration
    match host_capacity_owner_open_linux_v3(linux_service_journal_root_v4(root, loaded.unwrap().metadata), expected.unwrap(),
            journal_nonce, configuration.maximum_journal_events):
        case HostCapacityOpenV2.Rejected(reason): return linux_service_start_error_v4(owner, reason)
        case HostCapacityOpenV2.CleanupRequired(cleanup, reason):
            owner.journal_cleanup = Some(cleanup)
            return linux_service_start_error_v4(owner, reason)
        case HostCapacityOpenV2.Ready(actual): owner.capacity = Some(actual)
    val journal = owner.capacity.unwrap().journal
    val same = linux_service_capacity_same_v4(owner.capacity.unwrap(), expected.unwrap())
    if same.is_err(): return linux_service_start_error_v4(owner, same.unwrap_err())
    # No current record is ever written to an unprotected or stale journal.
    val protected = host_capacity_owner_linux_current_v3(owner.capacity.unwrap())
    if protected.is_err(): return linux_service_start_error_v4(owner, protected.unwrap_err())
    val bytes = linux_service_current_bytes_v4(binding, scope.unwrap(), observed.unwrap(), initial_epoch_digest,
        loaded.unwrap().claim_digest, journal)
    if bytes.is_err(): return linux_service_start_error_v4(owner, bytes.unwrap_err())
    val relative = "linux-service-current/" + incarnation + ".sdn"
    val stored = distributed_operation_journal_publish_v3(journal, relative, bytes.unwrap())
    if stored.is_err(): return linux_service_start_error_v4(owner, stored.unwrap_err())
    # A fresh incarnation path that already exists is never adopted.
    if not stored.unwrap(): return linux_service_start_error_v4(owner, "linux-host-service-current-record-exists")
    val readback = distributed_operation_journal_read_required_v3(journal, relative, 16384)
    if readback.is_err(): return linux_service_start_error_v4(owner, readback.unwrap_err())
    if readback.unwrap() != bytes.unwrap(): return linux_service_start_error_v4(owner, "linux-host-service-current-record-readback")
    owner.current_relative = relative
    owner.current_bytes = bytes.unwrap()
    owner.published = true
    val current = owner.current_v4()
    if current.is_err(): return linux_service_start_error_v4(owner, current.unwrap_err())
    # milestone_0049: this incarnation records remote-build stage intents (held writer, before any reap or admit).
    val regime = host_remote_build_stage_regime_publish_v1(owner.capacity.unwrap().journal,
        owner.capacity.unwrap().ledger.capacity.boot_id)
    if regime.is_err(): return linux_service_start_error_v4(owner, regime.unwrap_err())
    # milestone_0022 14.2: the helper store opens AFTER the journal and BEFORE any attach (and before the
    # reconcile). A refused store never fails startup: `helper_store` stays "" and an attach refuses. Only a journal
    # refusal row R that needs the store (an unsettled charged helper) still quarantines the ledger proof below.
    val store = host_linux_helper_store_open_v1(owner.capacity.unwrap().journal.root)
    if store.is_ok(): owner.helper_store = store.unwrap()
    # Fail-closed reconcile (milestone_0018 F, milestone_0019 M3), AFTER the
    # journal writer is held: two offline store reads through the lent borrow,
    # continuity flipped in memory only. The inventory must be lent for the
    # same epoch as this service; on any refusal startup stays published but
    # quarantined (status_v4 refuses).
    # AT-OPS-01 (D1/D2): a pending controller-signed handoff is VERIFIED here, with the journal writer held and before
    # any continuity flip; a refused one quarantines like a refused reconcile. It is consumed only after the reconcile
    # below re-proved exclusion.
    val adopted = host_service_handoff_verify_v1(journal, scope.unwrap(), loaded.unwrap().metadata.policy,
        loaded.unwrap().metadata.configuration.controller_ref, host_local_context_v1(loaded.unwrap().metadata.policy), relative)
    if adopted.is_err(): owner.reconcile_error = adopted.unwrap_err()
    elif inventory.epoch_digest != initial_epoch_digest: owner.reconcile_error = "linux-host-service-inventory-epoch-mismatch"
    else:
        # milestone_0022 N3 (16, 17(C)): helper-cancel-resume runs FIRST; its owner is
        # adopted even on error (single writer); an error quarantines and skips the
        # flip, which itself is unchanged and re-compares the journal identity.
        val resumed = host_linux_service_helper_cancel_resume_v4(owner)
        owner = resumed.owner
        if resumed.error != "": owner.reconcile_error = resumed.error
        else:
            val flipped = host_linux_service_reconcile_flip_v4(owner.capacity.unwrap(), native, inventory)
            if flipped.is_err(): owner.reconcile_error = flipped.unwrap_err()
            else:
                owner.capacity = Some(flipped.unwrap())
                val consumed = host_service_handoff_consume_v1(owner.capacity.unwrap().journal, relative, adopted.unwrap())
                if consumed.is_err(): owner.reconcile_error = consumed.unwrap_err()
                else:
                    # milestone_0030 PR-2 (13.4): reap a prior incarnation's started remote builds before the first
                    # admit. Borrowed writer: owner.capacity.unwrap().journal; the owner is adopted on every path.
                    val reaped = host_remote_build_reap_v4(owner.capacity.unwrap(),
                        host_local_context_v1(loaded.unwrap().metadata.policy).grant_clock)
                    owner.capacity = Some(reaped.capacity)
                    if reaped.error != "": owner.reconcile_error = reaped.error
    linux_service_start_error_v4(owner, "")

# milestone_0022 N3 (14.3 P2-E, 15.5, 16 P1-1/P2-5): resume every executing or
# outcome-unknown attach helper row whose JOURNAL refusal R exists: regenerate the
# mirrors, publish X, settle. Inputs are RE-DERIVED from the journal-stored signed
# request and checked against R; a mismatch is an Err for that row (it stays
# charged). Never starts an attach and never touches the parent reservation (17(F)).
# `turn.owner` always carries the possibly-advanced capacity owner.
pub struct HostLinuxServiceResumeTurnV4:
    owner: HostLinuxServiceCurrentV4
    resumed: i64
    error: text

# Ok(None): not a resumable row (another operation, another state, or no journal R).
fn linux_service_helper_cancel_row_v4(capacity: HostCapacityOwnerV1, store_root: text,
        operation_id: text, reap: Option<HostHelperReapFactsV1>,
        recheck: Option<HostHelperAbandonRecheckV1>) -> Result<Option<HostHelperCancelTurnV1>, text>:
    val row = distributed_operation_journal_lookup_v2(capacity.journal, operation_id)?
    if row.state != "executing" and row.state != "outcome-unknown": return Ok(None)
    val operation = distributed_decode_operation_v2(row.envelope)?
    if operation.operation != "host_helper_reservation_v1": return Ok(None)
    # milestone_0036: a recorded controller-signed abandon whose settle did not complete is finished first (DESIGN A6).
    # milestone_0043 (REVIEW_B P2-4/P3-1, REVIEW_PRA_R1 P3-1, REVIEW_PRA_R2 P2-1): its approval is re-verified first. An
    # expired or revoked approval, an unreadable marker or missing verify facts keep the row charged and are the resume
    # error, so the startup quarantine names the reason (a charged unresolved row quarantines through the drain anyway).
    # A marked row never reaches the reap or R.
    val pending = host_helper_abandoned_pending_v1(capacity.journal, operation)
    if pending.is_err(): return Err("helper-abandon-marker-unreadable:" + pending.unwrap_err())
    if pending.unwrap():
        val checked = match recheck:
            case Some(facts): facts
            case None: return Err("helper-abandon-recheck-unavailable")
        host_helper_abandon_recorded_verify_v1(capacity.journal, operation, checked)?
        return Ok(Some(host_helper_abandon_commit_v1(capacity, operation)))
    # milestone_0036 deadline reap: when the signed deadline passed and the helper spawn is proven dead, the refusal R is
    # written here (single writer) and the read below finds it; any condition not met leaves the row untouched.
    if val facts = reap:
        val _reaped = host_helper_deadline_reap_v1(capacity.journal, store_root, operation, facts)
    val refusal_bytes = distributed_operation_journal_read_v3(capacity.journal,
        host_linux_helper_journal_relative_v1("primary-refusal", operation.id), 65536)?
    if refusal_bytes.is_none(): return Ok(None)
    val refusal = host_primary_attach_refusal_decode_v1(refusal_bytes.unwrap())?
    val expected = host_linux_helper_attach_expected_v1(capacity.journal, operation)?
    host_linux_helper_attach_binding_check_v1(refusal, None, expected)?
    Ok(Some(host_helper_cancel_unconsumed_v1(capacity, store_root, operation, expected.plan,
        expected.request_digest, expected.prepared_receipt_digest)))

pub fn host_linux_service_helper_cancel_resume_v4(original: HostLinuxServiceCurrentV4) -> HostLinuxServiceResumeTurnV4:
    var owner = original
    if owner.capacity.is_none():
        return HostLinuxServiceResumeTurnV4(owner: owner, resumed: 0, error: "linux-host-service-acquisition-incomplete")
    var capacity = owner.capacity.unwrap()
    val store_root = host_linux_helper_store_root_v1(capacity.journal.root)
    var resumed = 0
    var error = ""
    # Row ids from the startup journal; each row is re-read from the CURRENT journal.
    val operation_ids = capacity.journal.operations.keys()
    # milestone_0036: the facts the reap needs come from the service's own verified records and clock; without records
    # the reap is simply not offered when they are absent.
    var reap: Option<HostHelperReapFactsV1> = None
    var recheck: Option<HostHelperAbandonRecheckV1> = None
    if val records = owner.records:
        val policy = records.metadata.policy
        reap = Some(HostHelperReapFactsV1(policy_generation: policy.snapshot.generation,
            policy_revision: policy.snapshot.policy_revision, revocation_epoch: policy.snapshot.revocation_epoch,
            now_ms: host_local_context_v1(policy).grant_clock))
        if val scope = owner.scope:
            recheck = Some(HostHelperAbandonRecheckV1(policy: policy, controller_ref: records.metadata.configuration.controller_ref,
                context: host_local_context_v1(policy), host_id: scope.physical_host_id))
    for operation_id in operation_ids:
        val row = linux_service_helper_cancel_row_v4(capacity, store_root, operation_id, reap, recheck)
        if row.is_err():
            if error == "": error = row.unwrap_err()
            continue
        match row.unwrap():
            case Some(turn):
                capacity = turn.owner
                if turn.error != "":
                    if error == "": error = turn.error
                else: resumed = resumed + 1
            case None: ()
    owner.capacity = Some(capacity)
    HostLinuxServiceResumeTurnV4(owner: owner, resumed: resumed, error: error)

# Administrator anchor = the installed child root `<parent>/host-root-<64 hex>`
# (the root the signed installer reports as residue). The parent is this string
# prefix only, never a decoded field; decoded bytes must later reproduce both.
pub fn host_linux_service_anchor_parent_v4(anchor: text) -> Result<text, text>:
    if (anchor.byte_len() < 2 or anchor.byte_len() > 4096 or not anchor.starts_with("/") or anchor.ends_with("/") or
            anchor.contains("\0") or anchor.contains("\n") or anchor.contains("\r") or anchor.contains("\\")):
        return Err("linux-host-service-anchor-invalid")
    val split = anchor.last_index_of("/")
    if split < 1: return Err("linux-host-service-anchor-invalid")
    val leaf = anchor.substring(split + 1, anchor.byte_len())
    if not leaf.starts_with("host-root-") or leaf.byte_len() != 74 or not builder_digest_valid_v1(leaf.substring(10, 74)):
        return Err("linux-host-service-anchor-leaf")
    for part in anchor.substring(1, split).split("/"):
        if part == "" or part == "." or part == "..": return Err("linux-host-service-anchor-invalid")
    Ok(anchor.substring(0, split))

# Rebuilds the sealed proof from the INSTALLED fixed files only, read through
# the two protected readers whose actual canonical roots are first pinned to
# the anchor and its parent. The decoded binding must reproduce both paths
# before any of its fields is used. Policy is the parent's (the installer's
# verify input); the root's six fixed files must then equal, byte for byte,
# what this proof would publish.
fn linux_service_installed_proof_v4(anchor: text, parent: text, root_reader: LinuxProtectedRootReaderV1,
        parent_reader: LinuxProtectedRootReaderV1) -> Result<LinuxServiceVerifiedEnrollmentV1, text>:
    linux_protected_root_reader_require_root_v1(root_reader, anchor)?
    linux_protected_root_reader_require_root_v1(parent_reader, parent)?
    val binding = host_linux_service_enrollment_decode_v3(host_linux_service_read_v4(root_reader, "linux-service-enrollment-v3.sdn")?)?
    if host_linux_service_root_path_v4(binding)? != anchor or binding.machine_parent != parent:
        return Err("linux-host-service-anchor-binding-mismatch")
    val credential = host_enrollment_credential_decode_v1(
        host_linux_service_read_v4(root_reader, "linux-service-enrollment-credential-v3.sdn")?)?
    val proof = linux_service_enrollment_verify_v1(host_linux_service_read_v4(parent_reader, "authority-policy.sdn")?,
        binding, credential, host_linux_service_read_v4(root_reader, "host-config.sdn")?,
        host_linux_service_read_v4(root_reader, "engine-policy.sdn")?, host_linux_service_read_v4(root_reader, "broker-policy.sdn")?)?
    val prefix = proof.child()? + "/"
    for item in linux_service_enrollment_fixed_files_v1(proof)?:
        if not item.0.starts_with(prefix): return Err("linux-host-service-installed-file-path")
        val leaf = item.0.substring(prefix.byte_len(), item.0.byte_len())
        if host_linux_service_read_v4(root_reader, leaf)? != item.1: return Err("linux-host-service-installed-file-mismatch:" + leaf)
    linux_protected_root_reader_require_root_v1(root_reader, anchor)?
    linux_protected_root_reader_require_root_v1(parent_reader, parent)?
    Ok(proof)

fn linux_service_readers_pinned_v4(anchor: text, parent: text, root_reader: LinuxProtectedRootReaderV1,
        parent_reader: LinuxProtectedRootReaderV1) -> Result<(), text>:
    linux_protected_root_reader_require_root_v1(root_reader, anchor)?
    linux_protected_root_reader_require_root_v1(parent_reader, parent)?
    Ok(())

fn linux_service_open_error_v4(owner: HostLinuxServiceCurrentV4, error: text, fallback: text) -> HostLinuxServiceStartTurnV4:
    linux_service_start_error_v4(owner, if error != "": error else: fallback)

# Installed opener (administrator startup, never a request decoder). Order:
# every READ-ONLY check first (anchor, protected root + parent readers,
# installed proof), so a missing, tampered or mismatched install never
# consumes a fresh epoch; only then the durable fresh-epoch admission and the
# native identity lend, a re-pin of both reader roots, and
# host_linux_service_start_v4 with the lent borrow and digest. Every acquired
# owner is in the returned owner on every path; the admission is retained for
# the service lifetime.
pub fn host_linux_service_open_installed_v4(anchor: text) -> HostLinuxServiceStartTurnV4:
    var shell = HostLinuxServiceCurrentV4(root: anchor)
    val parent = host_linux_service_anchor_parent_v4(anchor)
    if parent.is_err(): return linux_service_start_error_v4(shell, parent.unwrap_err())
    val opened = linux_protected_root_reader_open_v1(anchor)
    shell.root_reader = opened.owner
    if not opened.ready or opened.owner.is_none() or opened.error != "":
        return linux_service_open_error_v4(shell, opened.error, "linux-host-service-root-reader")
    val opened_parent = linux_protected_root_reader_open_v1(parent.unwrap())
    shell.parent_reader = opened_parent.owner
    if not opened_parent.ready or opened_parent.owner.is_none() or opened_parent.error != "":
        return linux_service_open_error_v4(shell, opened_parent.error, "linux-host-service-parent-reader")
    val proof = linux_service_installed_proof_v4(anchor, parent.unwrap(), opened.owner.unwrap(), opened_parent.owner.unwrap())
    if proof.is_err(): return linux_service_start_error_v4(shell, proof.unwrap_err())
    var admission = machine_container_authority_open_fresh_epoch_v1()
    shell.admission = Some(admission)
    if admission.error != "" or admission.owner.is_none():
        return linux_service_open_error_v4(shell, admission.error, "linux-host-service-admission-missing")
    val lent = admission.owner.unwrap().lend_service_identity_v1()
    admission.owner = Some(lent.owner)
    shell.admission = Some(admission)
    if lent.error != "" or lent.native.is_none():
        return linux_service_open_error_v4(shell, lent.error, "linux-host-service-native-loan-missing")
    shell.native = lent.native
    # The offline store inventory for the startup reconcile, from the SAME
    # admission, reader and successor custody (the provider stays masked).
    val stored = admission.owner.unwrap().lend_store_inventory_v1()
    admission.owner = Some(stored.owner)
    shell.admission = Some(admission)
    if stored.error != "" or stored.inventory.is_none():
        return linux_service_open_error_v4(shell, stored.error, "linux-host-service-inventory-loan-missing")
    shell.inventory = stored.inventory
    # The admission ran between the proof and start: the readers must still be
    # pinned to the anchor and its parent before start re-reads through them.
    val repinned = linux_service_readers_pinned_v4(anchor, parent.unwrap(), opened.owner.unwrap(), opened_parent.owner.unwrap())
    if repinned.is_err(): return linux_service_start_error_v4(shell, repinned.unwrap_err())
    val started = host_linux_service_start_v4(anchor, opened.owner.unwrap(), opened_parent.owner.unwrap(), proof.unwrap(),
        lent.native.unwrap(), lent.epoch_digest, stored.inventory.unwrap())
    var owner = started.owner
    owner.admission = shell.admission
    if started.error != "": return HostLinuxServiceStartTurnV4(owner: owner, error: started.error)
    # A quarantined start keeps the inventory lent (status_v4 keeps refusing).
    if owner.reconcile_error != "" or owner.capacity.is_none() or not owner.capacity.unwrap().ledger.continuity_proven:
        return HostLinuxServiceStartTurnV4(owner: owner, error: "")
    linux_service_inventory_handoff_v4(owner)

# Post-reconcile handoff (milestone_0021 PR1). The store-inventory loan exists
# for the startup reconcile only. Once that reconcile PROVED continuity on this
# owner's published journal, the exact lent borrow goes back to the lender.
# Returning it grants nothing: start_provider_v1 and transfer_workload_v2 still
# refuse a once-lent epoch (retained service reader).
fn linux_service_inventory_handoff_v4(owner: HostLinuxServiceCurrentV4) -> HostLinuxServiceStartTurnV4:
    if (not owner.published or owner.reconcile_error != "" or owner.capacity.is_none() or
            not owner.capacity.unwrap().ledger.continuity_proven):
        return linux_service_start_error_v4(owner, "linux-host-service-inventory-handoff-unproven")
    linux_service_inventory_return_v4(owner)

# The exact-borrow return behind the proof gate above. The lender verifies the
# borrow aliases its own reader and custody; a refusal keeps the borrow here
# and the loan active, so close still hands it back first.
fn linux_service_inventory_return_v4(original: HostLinuxServiceCurrentV4) -> HostLinuxServiceStartTurnV4:
    var owner = original
    if owner.inventory_returned: return linux_service_start_error_v4(owner, "linux-host-service-inventory-returned")
    if owner.inventory.is_none(): return linux_service_start_error_v4(owner, "linux-host-service-inventory-borrow-missing")
    if owner.admission.is_none() or owner.admission.unwrap().owner.is_none():
        return linux_service_start_error_v4(owner, "linux-host-service-admission-missing")
    var admission = owner.admission.unwrap()
    val returned = admission.owner.unwrap().end_store_inventory_loan_v1(owner.inventory.unwrap())
    admission.owner = Some(returned.owner)
    owner.admission = Some(admission)
    if returned.error != "": return linux_service_start_error_v4(owner, returned.error)
    owner.inventory = None
    owner.inventory_returned = true
    linux_service_start_error_v4(owner, "")

# Signed associated prepare authorization: transport bounds, exact live scope,
# configured controller and fresh issuer + approver signatures under the
# installed policy. Returns the verified grant only; no capacity is touched.
fn linux_service_prepare_authorize_v4(scope: ContainerHostScopeV2, policy: LocalAuthorityPolicyV1, controller_ref: text,
        request: HostPrepareAssociatedRequestV3, context: HostReservationAuthorizationContextV1) -> Result<ExecutionGrantV2, text>:
    val transport = host_prepare_associated_transport_v3(request)?
    if container_host_scope_bytes_v2(request.service_scope)? != container_host_scope_bytes_v2(scope)?:
        return Err("linux-host-service-prepare-scope-mismatch")
    val signed = request.prepare
    if signed.signed.issuer_id != controller_ref: return Err("linux-host-service-controller-mismatch")
    distributed_verify_grant_approval_from_snapshot_v2(policy.snapshot, signed.signed, signed.approval, signed.operation,
        context.grant_clock, policy.snapshot.generation, context.policy_revision, context.revocation_epoch,
        context.session_generation)

# Binds the exact unchanged provider request to the actual native boot,
# provider generation, machine and startup epoch. The projected plan is DATA
# from the upper port and is checked here against the actual native borrow.
fn linux_service_association_v4(binding: HostLinuxServiceEnrollmentBindingV3, scope: ContainerHostScopeV2,
        epoch_digest: text, native: LinuxServiceNativeIdentitySnapshotV3, prepare: HostPrepareAssociatedRequestV3,
        receipt: HostPreparedReservationReceiptV1, execution: ContainerExecutionRequestV2) -> Result<HostExecutionAssociationV3, text>:
    val plan = execution.plan
    if (plan.boot_id != native.native_boot_id or plan.provider_generation != native.owner_generation or
            plan.native_machine_id != native.native_machine_id or plan.service_scope_id != "epoch-" + epoch_digest):
        return Err("linux-host-service-native-projection-mismatch")
    val association = HostExecutionAssociationV3(enrollment_digest: host_linux_service_enrollment_digest_v3(binding)?,
        service_scope: scope, intent_digest: sha256_text(host_reservation_encode_intent_v1(prepare.prepare.intent)?),
        prepared_receipt_digest: receipt.receipt_digest, prepared_revision: receipt.prepared_revision,
        epoch_record_digest: epoch_digest, service_process_identity_digest: native.process_identity_digest,
        execution: execution, readonly_rootfs: prepare.draft.readonly_rootfs,
        agent_invocation_manifest_digest: prepare.draft.agent_invocation_manifest_digest,
        agent_probe_list_digest: prepare.draft.agent_probe_list_digest,
        remote_build_task_digest: prepare.draft.remote_build_task_digest)
    host_execution_association_match_v3(association, prepare, receipt)?
    Ok(association)

# Keyed by this service incarnation's fence and the operation ID, so an ID
# reused under a later incarnation never collides with an older record.
fn linux_service_association_relative_v4(scope: ContainerHostScopeV2, operation_id: text) -> Result<text, text>:
    Ok("host-execution-associations/" + sha256_text(container_scope_fence_id_v2(scope)? + "\n" + operation_id) + ".sdn")

# Associated execute authorization. The request association must be the exact
# bytes this owner stored for that operation; the operation must be the
# association-bound envelope; signatures must verify under installed policy.
fn linux_service_execute_authorize_core_v4(scope: ContainerHostScopeV2, policy: LocalAuthorityPolicyV1, controller_ref: text,
        request: HostExecuteAssociatedRequestV3, stored: Option<text>,
        context: HostReservationAuthorizationContextV1) -> Result<ExecutionGrantV2, text>:
    if stored.is_none(): return Err("linux-host-service-association-missing")
    if host_execution_association_encode_v3(request.association)? != stored.unwrap():
        return Err("linux-host-service-association-foreign")
    val live = container_host_scope_bytes_v2(scope)?
    if (container_host_scope_bytes_v2(request.association.service_scope)? != live or
            container_host_scope_bytes_v2(request.prepare.service_scope)? != live):
        return Err("linux-host-service-execute-scope-mismatch")
    val bound = host_execute_associated_encode_v3(request)?
    if request.signed.issuer_id != controller_ref: return Err("linux-host-service-controller-mismatch")
    distributed_verify_grant_approval_from_snapshot_v2(policy.snapshot, request.signed, request.approval, request.operation,
        context.grant_clock, policy.snapshot.generation, context.policy_revision, context.revocation_epoch,
        context.session_generation)

# Prepare: authorize, admit through the landed capacity owner (an exact
# same-ID replay re-reads the retained intent, so the original deadline is
# kept and any renewed intent is refused), project, associate, publish and
# read back on the same journal, and only then return the prepared reply.
pub fn host_linux_service_prepare_v4(original: HostLinuxServiceCurrentV4, source: text,
        project: fn(ContainerExecutionDraftV3) -> Result<ContainerExecutionRequestV2, text>) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if not owner.capacity.unwrap().ledger.continuity_proven or owner.reconcile_error != "":
        return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    val request = host_prepare_associated_decode_v3(source)
    if request.is_err(): return linux_service_reply_v4(owner, "", request.unwrap_err(), false)
    val policy = metadata.unwrap().policy
    val grant = linux_service_prepare_authorize_v4(owner.scope.unwrap(), policy, metadata.unwrap().configuration.controller_ref,
        request.unwrap(), host_local_context_v1(policy))
    if grant.is_err(): return linux_service_reply_v4(owner, "", grant.unwrap_err(), false)
    val intent = request.unwrap().prepare.intent
    val operation = request.unwrap().prepare.operation
    # N-06/T-08/U-05: one agent per incarnation, enforced BEFORE any charge; the slot is reserved first.
    # milestone_0030 s1: the slot check runs for ANY workload draft (agent or remote-build); `agent_draft` keeps its
    # name for minimal hunks and means "workload draft". A same-id re-prepare of another kind is refused first.
    val workload_kind = linux_service_workload_kind_v4(request.unwrap().draft.agent_invocation_manifest_digest,
        request.unwrap().draft.remote_build_task_digest)
    val agent_draft = workload_kind != ""
    if agent_draft:
        val kind_gate = linux_service_prepare_kind_gate_v4(owner, operation.id, workload_kind)
        if kind_gate != "": return linux_service_reply_v4(owner, "", kind_gate, false)
        val enrolled_gate = linux_service_remote_build_enrolled_gate_v4(owner, workload_kind)
        if enrolled_gate != "": return linux_service_reply_v4(owner, "", enrolled_gate, false)
        # A remote-build charge the service could never settle (no app port installed) is never taken.
        if workload_kind == "remote-build" and owner.remote_build_port.is_none():
            return linux_service_reply_v4(owner, "", "linux-host-remote-build-port-missing", false)
        val reaped_gate = host_remote_build_prepare_reaped_gate_v4(owner.capacity.unwrap().journal, operation.id,
            request.unwrap().draft.remote_build_task_digest)
        if reaped_gate != "": return linux_service_reply_v4(owner, "", reaped_gate, false)
        val profile_gate = linux_service_remote_build_profile_gate_v4(owner, workload_kind, operation,
            request.unwrap().draft.request_bytes)
        if profile_gate != "": return linux_service_reply_v4(owner, "", profile_gate, false)
        val slot = linux_service_agent_slot_v4(owner, operation.id, host_local_context_v1(policy).monotonic_ms)
        owner = slot.owner
        if slot.error != "": return slot
        # P2R2-F1: record only into an EMPTY slot, so a same-id re-prepare with a different signed envelope never
        # replaces the admitted one (prepare_v1 refuses it with OPERATION_PAYLOAD_MISMATCH below).
        if owner.agent_operation_id == "":
            owner.agent_operation_id = operation.id
            owner.agent_operation = Some(operation)
            owner.slot_kind = workload_kind
    val admitted = host_capacity_owner_prepare_v1(owner.capacity.unwrap(), intent, operation, grant.unwrap(), host_local_context_v1(policy))
    # An error may follow a committed admission: report it as attempted. The slot is cleared only when the
    # journal has no row for this operation (refused before the charge).
    if admitted.is_err():
        # P2R1-F8: cleared only on the explicit not-found reason; any other lookup error keeps the slot (fail closed).
        # P2R2-F1: and only when the slot holds exactly this envelope.
        if agent_draft and linux_service_agent_slot_exact_v4(owner.agent_operation, operation):
            val prior = daemon_operation_exact_v2(owner.capacity.unwrap().journal, operation)
            if prior.is_err() and prior.unwrap_err() == "OPERATION_NOT_FOUND":
                owner.agent_operation_id = ""
                owner.agent_operation = None
                owner.slot_kind = ""
        return linux_service_reply_v4(owner, "", admitted.unwrap_err(), true)
    owner.capacity = Some(admitted.unwrap())
    # P3R1-F2: an Ok admission means the journal row is exactly THIS envelope (prepare_v1 refuses a mismatched one
    # when a row exists), so the slot always names the admitted envelope, even after an earlier lookup-error prepare
    # kept a different one.
    if agent_draft: owner.agent_operation = Some(operation)
    val receipt = host_capacity_owner_prepared_receipt_v1(owner.capacity.unwrap(), intent, operation, grant.unwrap(),
        host_local_context_v1(policy))
    if receipt.is_err(): return linux_service_reply_v4(owner, "", receipt.unwrap_err(), true)
    val execution = project(request.unwrap().draft)
    if execution.is_err(): return linux_service_reply_v4(owner, "", execution.unwrap_err(), true)
    val native = owner.native.unwrap().current_v3()
    if native.is_err(): return linux_service_reply_v4(owner, "", native.unwrap_err(), true)
    val association = linux_service_association_v4(owner.records.unwrap().binding, owner.scope.unwrap(), owner.initial_epoch,
        native.unwrap(), request.unwrap(), receipt.unwrap(), execution.unwrap())
    if association.is_err(): return linux_service_reply_v4(owner, "", association.unwrap_err(), true)
    val bytes = host_execution_association_encode_v3(association.unwrap())
    if bytes.is_err(): return linux_service_reply_v4(owner, "", bytes.unwrap_err(), true)
    val journal = owner.capacity.unwrap().journal
    val relative = linux_service_association_relative_v4(owner.scope.unwrap(), operation.id)
    if relative.is_err(): return linux_service_reply_v4(owner, "", relative.unwrap_err(), true)
    # No-replace publication: a same-ID retry must reproduce the original bytes.
    val saved = distributed_operation_journal_publish_v3(journal, relative.unwrap(), bytes.unwrap())
    if saved.is_err(): return linux_service_reply_v4(owner, "", saved.unwrap_err(), true)
    val readback = distributed_operation_journal_read_required_v3(journal, relative.unwrap(), 2097152)
    if readback.is_err(): return linux_service_reply_v4(owner, "", readback.unwrap_err(), true)
    if readback.unwrap() != bytes.unwrap(): return linux_service_reply_v4(owner, "", "linux-host-service-association-retained-mismatch", true)
    val current = owner.current_v4()
    if current.is_err(): return linux_service_reply_v4(owner, "", current.unwrap_err(), true)
    val reply = host_prepared_associated_reply_encode_v3(HostPreparedAssociatedReplyV3(request.unwrap(), receipt.unwrap(), association.unwrap()))
    if reply.is_err(): return linux_service_reply_v4(owner, "", reply.unwrap_err(), true)
    linux_service_reply_v4(owner, reply.unwrap(), "", true)

# Verified authorization only; host_linux_service_execute_v4 commits.
# The preparation must still be live: its signed prepare re-verifies now and
# the capacity owner reissues the identical receipt for the retained intent
# (expired, aborted or consumed preparations get none). Fail closed.
pub fn host_linux_service_execute_authorize_v4(owner: HostLinuxServiceCurrentV4, source: text) -> Result<ExecutionGrantV2, text>:
    val metadata = owner.current_v4()?
    val request = host_execute_associated_decode_v3(source)?
    val journal = owner.capacity.unwrap().journal
    val scope = owner.scope.unwrap()
    val stored = distributed_operation_journal_read_v3(journal,
        linux_service_association_relative_v4(scope, request.prepare.prepare.operation.id)?, 2097152)?
    val policy = metadata.policy
    val controller = metadata.configuration.controller_ref
    val grant = linux_service_execute_authorize_core_v4(scope, policy, controller, request, stored, host_local_context_v1(policy))?
    val prepared = linux_service_prepare_authorize_v4(scope, policy, controller, request.prepare, host_local_context_v1(policy))?
    val live = host_capacity_owner_prepared_receipt_v1(owner.capacity.unwrap(), request.prepare.prepare.intent,
        request.prepare.prepare.operation, prepared, host_local_context_v1(policy))?
    if live.receipt_digest != request.receipt.receipt_digest or live.prepared_revision != request.receipt.prepared_revision:
        return Err("linux-host-service-execute-receipt-stale")
    val current = owner.current_v4()?
    Ok(grant)

fn linux_service_execute_relative_v4(scope: ContainerHostScopeV2, operation_id: text) -> Result<text, text>:
    Ok("host-execute-associated/" + sha256_text(container_scope_fence_id_v2(scope)? + "\n" + operation_id) + ".sdn")

fn linux_service_admitted_reply_v4(owner: HostLinuxServiceCurrentV4, operation_id: text, association_digest: text,
        effect_attempted: bool) -> HostLinuxServiceReplyV4:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-execution-admission"),
        "operationId": SdnValue.String(operation_id), "associationDigest": SdnValue.String(association_digest),
        "state": SdnValue.String("execution-admitted"), "pending": SdnValue.Bool(true)}
    linux_service_reply_v4(owner, sdn_encode_canonical(SdnValue.Dict(fields)) + "\n", "", effect_attempted)

# Execute commit. A same-ID retry of the exact archived packet whose journal
# row already left "admitted" is answered from the journal with no new
# effect; a different packet for that operation is refused. Otherwise:
# full re-authorization, a no-replace archive of the exact signed packet
# (read back), then ONE associated begin on the original reservation row.
# The actually returned journal is adopted even on error. Admission only:
# the native launch is not composed here (DESIGN.md, milestone_0018).
pub fn host_linux_service_execute_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    # A handoff consume that failed after the reconcile flip leaves continuity proven AND reconcile_error set.
    if owner.reconcile_error != "": return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    val request = host_execute_associated_decode_v3(source)
    if request.is_err(): return linux_service_reply_v4(owner, "", request.unwrap_err(), false)
    val prepare = request.unwrap().prepare.prepare
    # N-06 / milestone_0030 s1: no second executing workload row; a workload association must be the slot's, of the
    # slot's kind, refused before the archive.
    val execute_gate = linux_service_execute_kind_gate_v4(owner, prepare.operation.id,
        linux_service_workload_kind_v4(request.unwrap().association.agent_invocation_manifest_digest,
            request.unwrap().association.remote_build_task_digest))
    if execute_gate != "": return linux_service_reply_v4(owner, "", execute_gate, false)
    val digest = host_execution_association_digest_v3(request.unwrap().association)
    if digest.is_err(): return linux_service_reply_v4(owner, "", digest.unwrap_err(), false)
    val relative = linux_service_execute_relative_v4(owner.scope.unwrap(), prepare.operation.id)
    if relative.is_err(): return linux_service_reply_v4(owner, "", relative.unwrap_err(), false)
    val journal = owner.capacity.unwrap().journal
    val archived = distributed_operation_journal_read_v3(journal, relative.unwrap(), 2097152)
    if archived.is_err(): return linux_service_reply_v4(owner, "", archived.unwrap_err(), false)
    if archived.unwrap().is_some():
        if archived.unwrap().unwrap() != source: return linux_service_reply_v4(owner, "", "linux-host-service-execution-packet-conflict", false)
        val row = daemon_operation_exact_v2(journal, prepare.operation)
        if row.is_err(): return linux_service_reply_v4(owner, "", row.unwrap_err(), false)
        if row.unwrap().state != "admitted":
            if row.unwrap().state != "executing": return linux_service_reply_v4(owner, "", "linux-host-service-execution-state-changed", true)
            return linux_service_admitted_reply_v4(owner, prepare.operation.id, digest.unwrap(), false)
    # Freshness baseline taken BEFORE authorization, so the commit-time gate
    # covers the whole authorize -> archive -> begin window.
    val before = host_local_context_v1(metadata.unwrap().policy)
    val grant = host_linux_service_execute_authorize_v4(owner, source)
    if grant.is_err(): return linux_service_reply_v4(owner, "", grant.unwrap_err(), false)
    val approval = request.unwrap().approval
    val deadline = if approval.expires_at < grant.unwrap().expires_at: approval.expires_at else: grant.unwrap().expires_at
    # No-replace: an existing archive must be these exact bytes.
    val saved = distributed_operation_journal_publish_v3(journal, relative.unwrap(), source)
    if saved.is_err(): return linux_service_reply_v4(owner, "", saved.unwrap_err(), true)
    val readback = distributed_operation_journal_read_required_v3(journal, relative.unwrap(), 2097152)
    if readback.is_err(): return linux_service_reply_v4(owner, "", readback.unwrap_err(), true)
    if readback.unwrap() != source: return linux_service_reply_v4(owner, "", "linux-host-service-execution-packet-conflict", true)
    # Re-read installed policy after the archive; the commit refresh uses it.
    val recheck = owner.current_v4()
    if recheck.is_err(): return linux_service_reply_v4(owner, "", recheck.unwrap_err(), true)
    val policy = recheck.unwrap().policy
    val capacity = owner.capacity.unwrap()
    val fence = HostLedgerFenceV1(capacity.ledger.capacity.authority_id, capacity.ledger.capacity.boot_id,
        capacity.ledger.capacity.provider_generation, capacity.ledger.revision)
    val refresh = fn() -> HostReservationAuthorizationContextV1: host_local_context_v1(policy)
    val begun = host_capacity_owner_begin_associated_v3(capacity, prepare.intent, prepare.operation, request.unwrap().receipt,
        fence, request.unwrap().association, request.unwrap().operation, grant.unwrap(), before, deadline, refresh)
    owner.capacity = Some(begun.owner)
    if begun.error != "": return linux_service_reply_v4(owner, "", begun.error, true)
    linux_service_admitted_reply_v4(owner, prepare.operation.id, digest.unwrap(), true)

# milestone_0030 N5 (13.3.6): a remote-build draft needs the enrollment-pinned remote-build template; refused
# before the slot record and the charge (r4.2 placement).
fn linux_service_remote_build_enrolled_gate_v4(owner: HostLinuxServiceCurrentV4, kind: text) -> text:
    if kind != "remote-build": return ""
    if owner.records.is_none() or owner.records.unwrap().remote_build_template.is_none(): return "linux-host-remote-build-not-enrolled"
    ""

# milestone_0030 P2-a: a remote-build draft whose request bytes do not match the build projection the installed profile
# determines is refused before the slot record and the charge. The profile is read non-consumingly through the
# admission owner (still held here before the transfer); no profile or no admission refuses.
fn linux_service_remote_build_profile_gate_v4(owner: HostLinuxServiceCurrentV4, kind: text, operation: OperationEnvelopeV2,
        request_bytes: text) -> text:
    if kind != "remote-build": return ""
    # A re-prepare of the EXACT admitted envelope: the slot already holds it (its first prepare passed this gate before
    # the admission moved into the holder at transfer), so the idempotent replay is answered by the later gates.
    if linux_service_agent_slot_exact_v4(owner.agent_operation, operation): return ""
    if owner.admission.is_none() or owner.admission.unwrap().owner.is_none(): return "linux-host-remote-build-profile-unavailable"
    val source = owner.admission.unwrap().owner.unwrap().read_build_workspace_profile_v3()
    if source.is_err(): return "linux-host-remote-build-profile-unavailable"
    val gate = host_remote_build_profile_gate_v4(request_bytes, source.unwrap())
    if gate.is_err(): return gate.unwrap_err()
    ""

# milestone_0030 s1: the workload kind named by the signed marker fields (the codecs refuse both kinds together).
fn linux_service_workload_kind_v4(agent_manifest_digest: text, remote_build_task_digest: text) -> text:
    if remote_build_task_digest != "": return "remote-build"
    if agent_manifest_digest != "": return "agent"
    ""

# s1: a same-id re-prepare of a different workload kind is refused before any charge. Busy-ness of the other kind is
# the unchanged slot check (one slot for both kinds).
fn linux_service_prepare_kind_gate_v4(owner: HostLinuxServiceCurrentV4, operation_id: text, kind: text) -> text:
    if kind != "" and owner.agent_operation_id == operation_id and owner.slot_kind != kind:
        return "linux-host-workload-kind-differs"
    ""

# s1 execute gate (generalises the agent-only N-06 check): a workload association must name the slot's operation
# and the slot's kind. A plain association is not gated by the slot.
fn linux_service_execute_kind_gate_v4(owner: HostLinuxServiceCurrentV4, operation_id: text, kind: text) -> text:
    if kind == "": return ""
    if operation_id != owner.agent_operation_id: return "linux-host-agent-incarnation-busy"
    if kind != owner.slot_kind: return "linux-host-workload-kind-differs"
    ""

# P2R2-F1: the slot holds exactly this signed envelope (whole-value equality), not merely its operation id.
fn linux_service_agent_slot_exact_v4(slot: Option<OperationEnvelopeV2>, operation: OperationEnvelopeV2) -> bool:
    if slot.is_none(): return false
    slot.unwrap() == operation

# milestone_0043 (opus re-review P1-2): the window of an executed-but-never-opened remote-build slot is the execute pair's
# own (the earlier of its approval and grant expiry, host_remote_build_deadline_v4). The open glue refuses after it too, so
# once it ended no open can ever be admitted and nothing can have run in that slot.
fn linux_service_remote_build_unopened_deadline_v4(approval_expires_at: i64, grant_expires_at: i64) -> i64:
    host_remote_build_deadline_v4(approval_expires_at, grant_expires_at, grant_expires_at)

# Settles that slot cancelled/no-workload on the single journal writer once the service GRANT clock passed the window, checks
# the ledger row reads Released and clears the slot. Anything it cannot prove (no current record, no archived execute, the window
# still open) keeps the slot busy: never a guessed release. The returned capacity owner is adopted on every path.
fn linux_service_remote_build_unopened_expire_v4(original: HostLinuxServiceCurrentV4, slot: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val busy = "linux-host-agent-incarnation-busy"
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", busy, false)
    val execute = linux_service_remote_build_execute_v4(owner, slot)
    if execute.is_err(): return linux_service_reply_v4(owner, "", busy, false)
    val window = linux_service_remote_build_unopened_deadline_v4(execute.unwrap().approval.expires_at,
        execute.unwrap().signed.grant.expires_at)
    if host_local_context_v1(metadata.unwrap().policy).grant_clock < window: return linux_service_reply_v4(owner, "", busy, false)
    val fence = container_scope_fence_id_v2(owner.scope.unwrap())
    if fence.is_err(): return linux_service_reply_v4(owner, "", busy, false)
    val operation = execute.unwrap().prepare.prepare.operation
    val settled = host_remote_build_settle_no_workload_v4(owner.capacity.unwrap(), operation, execute.unwrap().association,
        fence.unwrap(), "deadline")
    owner.capacity = Some(settled.owner)
    if settled.error != "": return linux_service_reply_v4(owner, "", settled.error, true)
    # The no-workload settle commits the daemon row `completed` (the cancelled outcome is in its published record) and
    # releases the charge: the ledger row must now read Released, else the slot is kept.
    var released = false
    for row in owner.capacity.unwrap().ledger.reservations:
        if row.operation_id == slot and row.state == HostReservationStateV1.Released: released = true
    if not released: return linux_service_reply_v4(owner, "", "linux-host-remote-build-unopened-expiry-readback", true)
    owner.agent_operation_id = ""
    owner.agent_operation = None
    owner.slot_kind = ""
    linux_service_reply_v4(owner, "", "", true)

# N-06/T-08/U-05 slot check for an agent-draft prepare, before any charge. Busy when the incarnation's agent
# is consumed, or the slot names an admitted (unexpired) or executing row of another operation. An admitted
# slot row past its prepare deadline (the hco:288-290 monotonic rule) is expired through the SAME journal
# writer, read back `cancelled`, and the slot cleared. A post-outcome projection failure stores the returned
# journal (single writer) and quarantines the owner until restart.
fn linux_service_agent_slot_v4(original: HostLinuxServiceCurrentV4, operation_id: text,
        now_ms: i64) -> HostLinuxServiceReplyV4:
    var owner = original
    if owner.agent_operation_id == operation_id: return linux_service_reply_v4(owner, "", "", false)
    if owner.agent_consumed: return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-busy", false)
    if owner.agent_operation_id == "": return linux_service_reply_v4(owner, "", "", false)
    val slot = owner.agent_operation_id
    var state = ""
    var deadline: i64 = 0
    for row in owner.capacity.unwrap().ledger.reservations:
        if row.operation_id != slot: continue
        if row.state == HostReservationStateV1.Prepared:
            state = "admitted"
            deadline = row.prepare_deadline_ms
        elif row.state == HostReservationStateV1.Executing: state = "executing"
        else: state = "ended"
    # milestone_0043 P1-2: an executed remote-build slot that was never opened holds no build, so no cancel, collect or step
    # deadline can reach it; once its signed window ended it is settled here instead of blocking until a restart.
    if state == "executing" and owner.slot_kind == "remote-build" and owner.build.is_none() and not owner.agent_consumed:
        return linux_service_remote_build_unopened_expire_v4(owner, slot)
    if state == "executing": return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-busy", false)
    if state == "admitted":
        if now_ms < deadline: return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-busy", false)
        val expired = host_capacity_owner_expire_prepared_owned_v3(owner.capacity.unwrap(), slot, now_ms)
        owner.capacity = Some(expired.owner)
        if expired.error == "host-projection-reopen-required":
            owner.journal_quarantine = "linux-host-service-journal-quarantined"
            return linux_service_reply_v4(owner, "", owner.journal_quarantine, true)
        if not expired.settled or expired.error != "": return linux_service_reply_v4(owner, "", expired.error, false)
        if owner.agent_operation.is_none(): return linux_service_reply_v4(owner, "", "linux-host-agent-slot-operation-missing", true)
        val readback = daemon_operation_exact_v2(owner.capacity.unwrap().journal, owner.agent_operation.unwrap())
        if readback.is_err(): return linux_service_reply_v4(owner, "", readback.unwrap_err(), true)
        if readback.unwrap().state != "cancelled":
            return linux_service_reply_v4(owner, "", "linux-host-agent-slot-expiry-readback", true)
    owner.agent_operation_id = ""
    owner.agent_operation = None
    owner.slot_kind = ""
    linux_service_reply_v4(owner, "", "", state == "admitted")

# Agent invoke glue (milestone_0021 PR2, DESIGN section 2; deviation D14: the owner-bound entry lives here
# because the agent module cannot import this one). Gate 1 here; gates 2-5 and every effect in the agent module,
# over the bytes this owner stored. Every call re-derives the step input from the archived signed execute and
# a fresh clock; each call advances at most one bounded step. An error after stage `transfer` is effect-attempted.
pub fn host_linux_service_agent_invoke_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if not owner.capacity.unwrap().ledger.continuity_proven:
        return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    if owner.reconcile_error != "" or not owner.inventory_returned:
        return linux_service_reply_v4(owner, "", "linux-host-agent-before-reconcile", false)
    val invoke = host_agent_invoke_request_decode_v4(source)
    if invoke.is_err(): return linux_service_reply_v4(owner, "", invoke.unwrap_err(), false)
    val operation_id = invoke.unwrap().operation_id
    val payload_digest = sha256_text(source)
    if val agent = owner.agent:
        if agent.operation_id != operation_id: return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-consumed", false)
        if agent.payload_digest != payload_digest: return linux_service_reply_v4(owner, "", "linux-host-agent-invoke-conflict", false)
    elif owner.agent_consumed: return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-consumed", false)
    elif owner.agent_operation_id != operation_id: return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-busy", false)
    val scope = owner.scope.unwrap()
    val journal = owner.capacity.unwrap().journal
    val execute_path = linux_service_execute_relative_v4(scope, operation_id)
    if execute_path.is_err(): return linux_service_reply_v4(owner, "", execute_path.unwrap_err(), false)
    val archived = distributed_operation_journal_read_v3(journal, execute_path.unwrap(), 2097152)
    if archived.is_err(): return linux_service_reply_v4(owner, "", archived.unwrap_err(), false)
    val execute = host_linux_service_agent_execute_v4(archived.unwrap(), operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), false)
    val association_path = linux_service_association_relative_v4(scope, operation_id)
    if association_path.is_err(): return linux_service_reply_v4(owner, "", association_path.unwrap_err(), false)
    val stored = distributed_operation_journal_read_v3(journal, association_path.unwrap(), 2097152)
    if stored.is_err(): return linux_service_reply_v4(owner, "", stored.unwrap_err(), false)
    # Gate 1b first (P2R1-F1): a matching agent at `settled`/`host-settle` takes the replay/resume path.
    var replay = false
    if val agent = owner.agent: replay = agent.stage == "settled" or agent.stage == "host-settle"
    val manifest = host_linux_service_agent_admit_v4(owner.capacity.unwrap(), scope, execute.unwrap(), stored.unwrap(),
        invoke.unwrap(), replay)
    if manifest.is_err(): return linux_service_reply_v4(owner, "", manifest.unwrap_err(), owner.agent.is_some())
    # F15 (B): the enrollment-pinned template, statically re-checked by every current_v4 records reload.
    val template = owner.records.unwrap().agent_helper_template
    if template.is_none(): return linux_service_reply_v4(owner, "", "linux-host-agent-helper-template-invalid", owner.agent.is_some())
    val input = host_linux_service_agent_input_v4(execute.unwrap(), manifest.unwrap(), template.unwrap(),
        host_local_context_v1(metadata.unwrap().policy), "epoch-" + owner.initial_epoch, scope,
        owner.records.unwrap().binding.provider_identity_digest)
    if input.is_err(): return linux_service_reply_v4(owner, "", input.unwrap_err(), owner.agent.is_some())
    if owner.agent.is_none():
        # Stage `transfer` (3.4): the budget gate before any effect, then the admission owner moves whole into
        # the factory and lives in exactly one place afterwards.
        val budget = host_linux_service_agent_budget_v4(input.unwrap())
        if budget.is_err(): return linux_service_reply_v4(owner, "", budget.unwrap_err(), false)
        val association_digest = host_execution_association_digest_v3(execute.unwrap().association)
        if association_digest.is_err(): return linux_service_reply_v4(owner, "", association_digest.unwrap_err(), false)
        if owner.admission.is_none() or owner.admission.unwrap().owner.is_none() or owner.native.is_none():
            return linux_service_reply_v4(owner, "", "linux-host-service-admission-missing", false)
        if owner.agent_root.is_some(): return linux_service_reply_v4(owner, "", "linux-host-agent-root-loan-retained", false)
        var admission = owner.admission.unwrap()
        val lender = admission.owner.unwrap()
        admission.owner = None
        val opened = host_linux_service_agent_open_v4(lender, owner.native.unwrap(), input.unwrap(), operation_id,
            association_digest.unwrap(), payload_digest)
        # T-04: a pre-transfer failure returns the admission whole (retryable unless the lend kept R3); a
        # post-transfer failure is an agent in stage `failed`. No live Host release either way.
        admission.owner = opened.admission
        owner.admission = Some(admission)
        if opened.root.is_some(): owner.agent_root = opened.root
        if opened.agent.is_some():
            owner.agent = opened.agent
            owner.agent_consumed = true
            if opened.error != "": return linux_service_reply_v4(owner, "", opened.error, true)
            return linux_service_reply_v4(owner, host_linux_service_agent_reply_v4(opened.agent.unwrap()), "", true)
        return linux_service_reply_v4(owner, "", if opened.error != "": opened.error else: "linux-host-agent-transfer-refused", true)
    # milestone_0023 part B: the attach effects (helper prepare/begin) verify under the installed policy, the live
    # service scope and a clock re-read from that policy.
    val step_policy = metadata.unwrap().policy
    val step_refresh = fn() -> HostReservationAuthorizationContextV1: host_local_context_v1(step_policy)
    val turn = host_linux_service_agent_step_v4(owner.agent.unwrap(), owner.capacity.unwrap(), input.unwrap(),
        linux_service_helper_store_v4(owner), step_policy, scope, step_refresh)
    owner.agent = Some(turn.agent)
    # The returned Host capacity owner is the single journal writer: adopted on every path.
    owner.capacity = Some(turn.capacity)
    linux_service_reply_v4(owner, turn.response, turn.error, turn.effect_attempted)

# Agent cancel glue (milestone_0021 PR3a, D21). The request is a CONTROLLER-SIGNED cancel packet (review P3R1-F1),
# verified like the associated execute: the held run, the archived signed execute and its association digest, the
# derived cancel operation, issuer == the configured controller, and issuer + approver signatures under the
# installed policy snapshot (host_linux_service_agent_cancel_authorize_v4). The verified packet is archived
# no-replace and read back before the agent changes: an exact-bytes retry is answered without a second
# verification, a different packet for the same run is a conflict. Cancel is a state transition only; Destroy
# and the 3.6 settle run on later host-agent-invoke calls through the step driver. Same reconcile gate as invoke.
pub fn host_linux_service_agent_cancel_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if not owner.capacity.unwrap().ledger.continuity_proven:
        return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    if owner.reconcile_error != "" or not owner.inventory_returned:
        return linux_service_reply_v4(owner, "", "linux-host-agent-before-reconcile", false)
    val cancel = host_agent_cancel_request_decode_v4(source)
    if cancel.is_err(): return linux_service_reply_v4(owner, "", cancel.unwrap_err(), false)
    if owner.agent.is_none(): return linux_service_reply_v4(owner, "", "linux-host-agent-cancel-unstarted", false)
    val agent = owner.agent.unwrap()
    val operation_id = cancel.unwrap().operation_id
    if agent.operation_id != operation_id: return linux_service_reply_v4(owner, "", "linux-host-agent-incarnation-consumed", false)
    val scope = owner.scope.unwrap()
    val journal = owner.capacity.unwrap().journal
    val execute_path = linux_service_execute_relative_v4(scope, operation_id)
    if execute_path.is_err(): return linux_service_reply_v4(owner, "", execute_path.unwrap_err(), false)
    val archived_execute = distributed_operation_journal_read_v3(journal, execute_path.unwrap(), 2097152)
    if archived_execute.is_err(): return linux_service_reply_v4(owner, "", archived_execute.unwrap_err(), false)
    val execute = host_linux_service_agent_execute_v4(archived_execute.unwrap(), operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), false)
    val association = host_execution_association_digest_v3(execute.unwrap().association)
    if association.is_err(): return linux_service_reply_v4(owner, "", association.unwrap_err(), false)
    val cancel_path = linux_service_cancel_relative_v4(scope, operation_id)
    if cancel_path.is_err(): return linux_service_reply_v4(owner, "", cancel_path.unwrap_err(), false)
    val prior = distributed_operation_journal_read_v3(journal, cancel_path.unwrap(), 131072)
    if prior.is_err(): return linux_service_reply_v4(owner, "", prior.unwrap_err(), false)
    val retained = host_agent_cancel_archive_check_v4(prior.unwrap(), source)
    if retained.is_err(): return linux_service_reply_v4(owner, "", retained.unwrap_err(), false)
    # An archived packet was fully verified before it was archived; only a first sighting verifies.
    if not retained.unwrap():
        val policy = metadata.unwrap().policy
        val grant = host_linux_service_agent_cancel_authorize_v4(policy.snapshot, metadata.unwrap().configuration.controller_ref,
            cancel.unwrap(), execute.unwrap().operation, association.unwrap(), agent.operation_id, agent.association_digest,
            host_local_context_v1(policy))
        if grant.is_err(): return linux_service_reply_v4(owner, "", grant.unwrap_err(), false)
    # Pure transition computed BEFORE the archive, so a refused stage never archives a cancel.
    val cancelled = host_linux_service_agent_request_cancel_v4(agent, sha256_text(source))
    if cancelled.error != "": return linux_service_reply_v4(owner, "", cancelled.error, cancelled.effect_attempted)
    if not retained.unwrap():
        # No-replace: an existing archive must be these exact bytes.
        val saved = distributed_operation_journal_publish_v3(journal, cancel_path.unwrap(), source)
        if saved.is_err(): return linux_service_reply_v4(owner, "", saved.unwrap_err(), true)
        val readback = distributed_operation_journal_read_required_v3(journal, cancel_path.unwrap(), 131072)
        if readback.is_err(): return linux_service_reply_v4(owner, "", readback.unwrap_err(), true)
        if readback.unwrap() != source: return linux_service_reply_v4(owner, "", "linux-host-agent-cancel-packet-conflict", true)
    owner.agent = Some(cancelled.agent)
    linux_service_reply_v4(owner, cancelled.response, "", cancelled.effect_attempted)

# ---- milestone_0030 remote-build route glue (integration item 7, DESIGN s4). Effects live in
# host_linux_service_remote_build_v4; this glue owns the journal paths, the slot, the admission and the port. ----

# Collect, output and cancel stay admitted while draining (as inspect/detach/cancel for the agent).
val REMOTE_BUILD_DRAINING_ACTIONS_V4 = ["host_remote_build_collect_v4", "host_remote_build_output_v4", "host_remote_build_cancel_v4"]

# The agent invoke's reconcile gate, shared by every remote-build action.
fn linux_service_remote_build_ready_v4(owner: HostLinuxServiceCurrentV4) -> text:
    val metadata = owner.current_v4()
    if metadata.is_err(): return metadata.unwrap_err()
    if not owner.capacity.unwrap().ledger.continuity_proven: return "linux-host-service-startup-quarantine"
    if owner.reconcile_error != "" or not owner.inventory_returned: return "linux-host-remote-build-before-reconcile"
    ""

# The archived signed execute of the slot's operation (written by the associated execute).
fn linux_service_remote_build_execute_v4(owner: HostLinuxServiceCurrentV4, operation_id: text) -> Result<HostExecuteAssociatedRequestV3, text>:
    val path = linux_service_execute_relative_v4(owner.scope.unwrap(), operation_id)?
    val archived = distributed_operation_journal_read_v3(owner.capacity.unwrap().journal, path, 2097152)?
    if archived.is_none(): return Err("linux-host-remote-build-execute-unarchived")
    val execute = host_execute_associated_decode_v3(archived.unwrap())?
    if execute.prepare.prepare.operation.id != operation_id: return Err("linux-host-remote-build-execute-foreign")
    if execute.association.remote_build_task_digest == "": return Err("linux-host-remote-build-not-build")
    Ok(execute)

# 13.4 reap: a run indexed by the startup reap never collects; its controller gets the reset-failure path.
fn linux_service_remote_build_reaped_v4(owner: HostLinuxServiceCurrentV4, operation_id: text) -> text:
    val index = distributed_operation_journal_read_v3(owner.capacity.unwrap().journal,
        host_remote_build_reap_index_relative_v4(operation_id), 4096)
    if index.is_err(): return index.unwrap_err()
    if index.unwrap().is_some(): return "linux-host-remote-build-reaped-incomplete"
    # P3-a: a run skipped by the reap (outcome published before `completed`) answers terminal, never `unopened`.
    if owner.build.is_some() and owner.build.unwrap().operation_id == operation_id: return ""
    host_remote_build_published_answer_v4(owner.capacity.unwrap().journal, operation_id)

fn linux_service_remote_build_held_v4(owner: HostLinuxServiceCurrentV4, operation_id: text) -> text:
    if owner.build.is_none(): return "linux-host-remote-build-unopened"
    if owner.build.unwrap().operation_id != operation_id: return "linux-host-remote-build-incarnation-consumed"
    ""

# open: slot is this executing remote-build operation; any refusal BEFORE the transfer settles the row
# cancelled/no-workload (r4.1b), which releases the charge; the incarnation is not consumed (slot reusable).
pub fn host_linux_service_remote_build_open_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val ready = linux_service_remote_build_ready_v4(owner)
    if ready != "": return linux_service_reply_v4(owner, "", ready, false)
    val frame = host_remote_build_frame_decode_v4(source)
    if frame.is_err(): return linux_service_reply_v4(owner, "", frame.unwrap_err(), false)
    val operation_id = frame.unwrap().operation_id
    if val build = owner.build:
        if build.operation_id != operation_id: return linux_service_reply_v4(owner, "", "linux-host-remote-build-incarnation-consumed", false)
        if build.open_record != frame.unwrap().payload: return linux_service_reply_v4(owner, "", "linux-host-remote-build-open-conflict", false)
        return linux_service_reply_v4(owner, host_remote_build_reply_v4(build), "", false)
    if owner.agent_consumed or owner.agent.is_some(): return linux_service_reply_v4(owner, "", "linux-host-remote-build-incarnation-consumed", false)
    if owner.slot_kind != "remote-build" or owner.agent_operation_id != operation_id:
        return linux_service_reply_v4(owner, "", "linux-host-remote-build-slot", false)
    if owner.remote_build_port.is_none(): return linux_service_reply_v4(owner, "", "linux-host-remote-build-port-missing", false)
    val execute = linux_service_remote_build_execute_v4(owner, operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), false)
    val metadata = owner.current_v4().unwrap()
    val scope = owner.scope.unwrap()
    val fence = container_scope_fence_id_v2(scope)
    if fence.is_err(): return linux_service_reply_v4(owner, "", fence.unwrap_err(), false)
    # milestone_0043 P1-2: never open after the execute pair's own window (the same bound the slot expiry settles on), so an
    # unopened slot's outcome never depends on whether a later prepare happened to arrive first.
    val window = linux_service_remote_build_unopened_deadline_v4(execute.unwrap().approval.expires_at,
        execute.unwrap().signed.grant.expires_at)
    if host_local_context_v1(metadata.policy).grant_clock >= window:
        val expired = host_remote_build_settle_no_workload_v4(owner.capacity.unwrap(), execute.unwrap().prepare.prepare.operation,
            execute.unwrap().association, fence.unwrap(), "deadline")
        owner.capacity = Some(expired.owner)
        if expired.error != "": return linux_service_reply_v4(owner, "", "linux-host-remote-build-deadline;settle:" + expired.error, true)
        return linux_service_reply_v4(owner, "", "linux-host-remote-build-deadline", true)
    val opened = host_remote_build_open_v4(owner.capacity.unwrap().journal, owner.remote_build_port.unwrap(),
        metadata.policy, metadata.configuration.controller_ref, owner.records.unwrap().binding.physical_host_id,
        execute.unwrap().association, fence.unwrap(), frame.unwrap().payload, host_local_context_v1(metadata.policy))
    if opened.is_err():
        val settled = host_remote_build_settle_no_workload_v4(owner.capacity.unwrap(), execute.unwrap().prepare.prepare.operation,
            execute.unwrap().association, fence.unwrap(), host_remote_build_failed_cause_v4(opened.unwrap_err()))
        # The returned capacity owner is the single journal writer: adopted on every path.
        owner.capacity = Some(settled.owner)
        if settled.error != "": return linux_service_reply_v4(owner, "", opened.unwrap_err() + ";settle:" + settled.error, true)
        return linux_service_reply_v4(owner, "", opened.unwrap_err(), true)
    owner.build = Some(opened.unwrap())
    linux_service_reply_v4(owner, host_remote_build_reply_v4(opened.unwrap()), "", true)

pub fn host_linux_service_remote_build_input_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val ready = linux_service_remote_build_ready_v4(owner)
    if ready != "": return linux_service_reply_v4(owner, "", ready, false)
    val frame = host_remote_build_frame_decode_v4(source)
    if frame.is_err(): return linux_service_reply_v4(owner, "", frame.unwrap_err(), false)
    val held = linux_service_remote_build_held_v4(owner, frame.unwrap().operation_id)
    if held != "": return linux_service_reply_v4(owner, "", held, false)
    val stored = host_remote_build_input_v4(owner.build.unwrap(), owner.capacity.unwrap().journal, frame.unwrap().index,
        frame.unwrap().payload)
    if stored.is_err(): return linux_service_reply_v4(owner, "", stored.unwrap_err(), true)
    owner.build = Some(stored.unwrap())
    linux_service_reply_v4(owner, host_remote_build_reply_v4(stored.unwrap()), "", true)

# start: every input archived -> the admission moves whole into the factory (as the agent stage `transfer`).
pub fn host_linux_service_remote_build_start_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val ready = linux_service_remote_build_ready_v4(owner)
    if ready != "": return linux_service_reply_v4(owner, "", ready, false)
    val frame = host_remote_build_frame_decode_v4(source)
    if frame.is_err(): return linux_service_reply_v4(owner, "", frame.unwrap_err(), false)
    val held = linux_service_remote_build_held_v4(owner, frame.unwrap().operation_id)
    if held != "": return linux_service_reply_v4(owner, "", held, false)
    if owner.agent_consumed: return linux_service_reply_v4(owner, host_remote_build_reply_v4(owner.build.unwrap()), "", false)
    # r4.1b: a window that ended before the transfer settles cancelled/no-workload; the slot stays reusable.
    if host_local_context_v1(owner.current_v4().unwrap().policy).grant_clock >= owner.build.unwrap().deadline:
        val execute = linux_service_remote_build_execute_v4(owner, frame.unwrap().operation_id)
        if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), false)
        val settled = host_remote_build_settle_no_workload_v4(owner.capacity.unwrap(), execute.unwrap().prepare.prepare.operation,
            execute.unwrap().association, owner.build.unwrap().fence, "deadline")
        owner.capacity = Some(settled.owner)
        if settled.error != "": return linux_service_reply_v4(owner, "", settled.error, true)
        owner.build = None
        return linux_service_reply_v4(owner, "", "linux-host-remote-build-deadline", true)
    val template = owner.records.unwrap().remote_build_template
    if template.is_none(): return linux_service_reply_v4(owner, "", "linux-host-remote-build-not-enrolled", false)
    if owner.admission.is_none() or owner.admission.unwrap().owner.is_none() or owner.native.is_none():
        return linux_service_reply_v4(owner, "", "linux-host-service-admission-missing", false)
    if owner.agent_root.is_some(): return linux_service_reply_v4(owner, "", "linux-host-agent-root-loan-retained", false)
    var admission = owner.admission.unwrap()
    val lender = admission.owner.unwrap()
    admission.owner = None
    val opened = host_remote_build_transfer_v4(owner.build.unwrap(), lender, owner.native.unwrap(), template.unwrap())
    admission.owner = opened.admission
    owner.admission = Some(admission)
    if opened.root.is_some(): owner.agent_root = opened.root
    if opened.executor.is_some():
        owner.build = opened.executor
        owner.agent_consumed = true
        if opened.error != "": return linux_service_reply_v4(owner, "", opened.error, true)
        return linux_service_reply_v4(owner, host_remote_build_reply_v4(opened.executor.unwrap()), "", true)
    # r4.1b (DL-05): a returned admission proves nothing ran, so settle cancelled/no-workload. A lost admission
    # (owner-missing, admission-lost) may follow the transfer: held consumed and `failed`, so no deadline or cancel path
    # can settle it no-workload. No epoch holder is kept, so service close refuses with transfer-missing and the service
    # refuses until restart (fail closed). Incomplete inputs stay retryable and ran nothing.
    val refused = if opened.error != "": opened.error else: "linux-host-remote-build-transfer-refused"
    if opened.admission.is_none():
        var lost_build = owner.build.unwrap()
        lost_build.stage = "failed"
        lost_build.error = refused
        owner.build = Some(lost_build)
        owner.agent_consumed = true
        return linux_service_reply_v4(owner, "", refused, true)
    if refused == "linux-host-remote-build-inputs-incomplete": return linux_service_reply_v4(owner, "", refused, false)
    val execute = linux_service_remote_build_execute_v4(owner, frame.unwrap().operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", refused + ";settle:" + execute.unwrap_err(), true)
    val settled = host_remote_build_settle_no_workload_v4(owner.capacity.unwrap(), execute.unwrap().prepare.prepare.operation,
        execute.unwrap().association, owner.build.unwrap().fence, host_remote_build_failed_cause_v4(refused))
    owner.capacity = Some(settled.owner)
    if settled.error != "": return linux_service_reply_v4(owner, "", refused + ";settle:" + settled.error, true)
    owner.build = None
    linux_service_reply_v4(owner, "", refused, true)

# collect: one bounded step of the executor (a pre-transfer executor answers its stage).
pub fn host_linux_service_remote_build_collect_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val ready = linux_service_remote_build_ready_v4(owner)
    if ready != "": return linux_service_reply_v4(owner, "", ready, false)
    val frame = host_remote_build_frame_decode_v4(source)
    if frame.is_err(): return linux_service_reply_v4(owner, "", frame.unwrap_err(), false)
    val reaped = linux_service_remote_build_reaped_v4(owner, frame.unwrap().operation_id)
    if reaped == "linux-host-remote-build-reaped-incomplete":
        # milestone_0039: a Host-signed reset-failure reply archived before the restart is answered byte-identically; no
        # valid archive keeps the refusal below (the typed reaped refusal). A replay makes no effect.
        val stored = host_remote_build_reset_failure_stored_v4(owner.capacity.unwrap().journal, frame.unwrap().operation_id)
        if stored != "": return linux_service_reply_v4(owner, stored, "", false)
        # milestone_0045 (owner decision 4): no archived reply yet, so the restarted Host signs the reaped outcome itself
        # (service-restart, archived before it is answered; a signature and a journal archive, no workload effect). Without
        # a port, an open archive or a signature the typed refusal below stays (the controller settles outcome-unknown).
        if owner.remote_build_port.is_some():
            val signed = host_remote_build_reaped_receipt_v4(owner.capacity.unwrap().journal, owner.remote_build_port.unwrap(),
                frame.unwrap().operation_id, host_local_context_v1(owner.current_v4().unwrap().policy).grant_clock)
            if signed != "": return linux_service_reply_v4(owner, signed, "", false)
    if reaped != "": return linux_service_reply_v4(owner, "", reaped, false)
    val held = linux_service_remote_build_held_v4(owner, frame.unwrap().operation_id)
    if held != "": return linux_service_reply_v4(owner, "", held, false)
    val execute = linux_service_remote_build_execute_v4(owner, frame.unwrap().operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), true)
    val template = owner.records.unwrap().remote_build_template
    if template.is_none() or owner.remote_build_port.is_none():
        return linux_service_reply_v4(owner, "", "linux-host-remote-build-not-enrolled", true)
    val turn = host_remote_build_step_v4(owner.build.unwrap(), owner.capacity.unwrap(), execute.unwrap().prepare.prepare.operation,
        execute.unwrap().association, owner.remote_build_port.unwrap(), template.unwrap(),
        host_local_context_v1(owner.current_v4().unwrap().policy))
    owner.build = Some(turn.executor)
    # A pre-transfer deadline settle (r4.1b) ends the holder; the slot clears through the ended path.
    if turn.executor.stage == "settled" and not owner.agent_consumed: owner.build = None
    # The returned Host capacity owner is the single journal writer: adopted on every path.
    owner.capacity = Some(turn.capacity)
    linux_service_reply_v4(owner, turn.response, turn.error, turn.effect_attempted)

pub fn host_linux_service_remote_build_output_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    val owner = original
    val frame = host_remote_build_frame_decode_v4(source)
    if frame.is_err(): return linux_service_reply_v4(owner, "", frame.unwrap_err(), false)
    val reaped = linux_service_remote_build_reaped_v4(owner, frame.unwrap().operation_id)
    if reaped != "": return linux_service_reply_v4(owner, "", reaped, false)
    val held = linux_service_remote_build_held_v4(owner, frame.unwrap().operation_id)
    if held != "": return linux_service_reply_v4(owner, "", held, false)
    val chunk = host_remote_build_output_v4(owner.capacity.unwrap().journal, owner.build.unwrap(), frame.unwrap().index)
    if chunk.is_err(): return linux_service_reply_v4(owner, "", chunk.unwrap_err(), false)
    linux_service_reply_v4(owner, chunk.unwrap(), "", false)

# cancel: the controller-signed agent cancel packet, verified exactly as the agent cancel (issuer == controller,
# snapshot pair, the archived execute's association). A pre-transfer executor settles cancelled/no-workload now.
pub fn host_linux_service_remote_build_cancel_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val ready = linux_service_remote_build_ready_v4(owner)
    if ready != "": return linux_service_reply_v4(owner, "", ready, false)
    val frame = host_remote_build_frame_decode_v4(source)
    if frame.is_err(): return linux_service_reply_v4(owner, "", frame.unwrap_err(), false)
    val cancel = host_agent_cancel_request_decode_v4(frame.unwrap().payload)
    if cancel.is_err(): return linux_service_reply_v4(owner, "", cancel.unwrap_err(), false)
    val held = linux_service_remote_build_held_v4(owner, cancel.unwrap().operation_id)
    if held != "" or frame.unwrap().operation_id != cancel.unwrap().operation_id:
        return linux_service_reply_v4(owner, "", if held != "": held else: "linux-host-remote-build-cancel-operation", false)
    val build = owner.build.unwrap()
    val execute = linux_service_remote_build_execute_v4(owner, build.operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), false)
    val metadata = owner.current_v4().unwrap()
    val grant = host_linux_service_agent_cancel_authorize_v4(metadata.policy.snapshot, metadata.configuration.controller_ref,
        cancel.unwrap(), execute.unwrap().operation, build.association_digest, build.operation_id, build.association_digest,
        host_local_context_v1(metadata.policy))
    if grant.is_err(): return linux_service_reply_v4(owner, "", grant.unwrap_err(), false)
    val cancelled = host_remote_build_request_cancel_v4(build, "controller-cancel")
    if cancelled.error != "": return linux_service_reply_v4(owner, "", cancelled.error, true)
    if cancelled.pretransfer:
        val settled = host_remote_build_settle_no_workload_v4(owner.capacity.unwrap(), execute.unwrap().prepare.prepare.operation,
            execute.unwrap().association, build.fence, "controller-cancel")
        owner.capacity = Some(settled.owner)
        if settled.error != "": return linux_service_reply_v4(owner, "", settled.error, true)
        owner.build = None
        return linux_service_reply_v4(owner, host_remote_build_reply_v4(cancelled.executor), "", true)
    owner.build = Some(cancelled.executor)
    linux_service_reply_v4(owner, host_remote_build_reply_v4(cancelled.executor), "", false)

# F5: the service composition installs the app half of the remote-build port once, before serving.
pub fn host_linux_service_install_remote_build_port_v4(original: HostLinuxServiceCurrentV4,
        port: HostRemoteBuildPortV4) -> HostLinuxServiceCurrentV4:
    var owner = original
    owner.remote_build_port = Some(port)
    owner

# milestone_0023 part B (c): the service's LIVE epoch, derived read-only from the verified epoch record. The
# record is read through the agent's transfer holder, must still be the exact record whose digest this service
# was lent (`initial_epoch`, the same comparison current_v4 makes), and its `epoch_generation` is the epoch. No
# field stores it and nothing sets it.
fn linux_service_live_epoch_v4(owner: HostLinuxServiceCurrentV4) -> Result<i64, text>:
    if owner.agent.is_none(): return Err("linux-host-agent-attach-unstarted")
    val record = host_linux_service_agent_epoch_v4(owner.agent.unwrap())?
    if sha256_text(machine_fresh_epoch_record_bytes_v1(record)?) != owner.initial_epoch:
        return Err("linux-host-service-epoch-changed")
    if record.epoch_generation <= 0: return Err("linux-host-service-epoch-generation")
    Ok(record.epoch_generation)

# The held-run inputs every controller-signed attachment action re-derives (attach, the terminal authority): the
# archived signed execute of the held agent and its association digest, as HostAgentActionAuthorityV4 under the
# installed policy and a fresh clock.
fn linux_service_agent_authority_v4(owner: HostLinuxServiceCurrentV4, metadata: HostPrivateMetadataV2) -> Result<HostAgentActionAuthorityV4, text>:
    if owner.agent.is_none() or owner.capacity.is_none() or owner.scope.is_none():
        return Err("linux-host-agent-attach-unstarted")
    val operation_id = owner.agent.unwrap().operation_id
    val archived = distributed_operation_journal_read_v3(owner.capacity.unwrap().journal,
        linux_service_execute_relative_v4(owner.scope.unwrap(), operation_id)?, 2097152)?
    val execute = host_linux_service_agent_execute_v4(archived, operation_id)?
    val policy = metadata.policy
    Ok(HostAgentActionAuthorityV4(snapshot: policy.snapshot, controller_ref: metadata.configuration.controller_ref,
        execute_operation: execute.operation, execute_association_digest: host_execution_association_digest_v3(execute.association)?,
        context: host_local_context_v1(policy)))

# The read-only helper admission of an attach, run before its archive: the helper operation must be NEW on this
# journal (a reused id could only fail at prepare, after the slot was consumed), the open core's entry guard holds
# on `store` (milestone_0031: this journal's own valid helper store with no marker of the operation; it could only
# refuse after helper begin otherwise), then the read-only twin of helper prepare's own checks.
fn linux_service_attach_admit_v4(capacity: HostCapacityOwnerV1, store: HostHelperStoreV1, helper: HostHelperRequestV1,
        policy: LocalAuthorityPolicyV1, scope: ContainerHostScopeV2,
        context: HostReservationAuthorizationContextV1) -> Result<(), text>:
    val row = daemon_operation_exact_v2(capacity.journal, helper.operation)
    if row.is_ok(): return Err("attach-helper-operation-reused")
    if row.unwrap_err() != "OPERATION_NOT_FOUND": return Err(row.unwrap_err())
    host_primary_attach_open_entry_check_v1(store, helper.operation.id)?
    host_helper_prepare_check_v1(capacity, helper, policy, scope, context)

# milestone_0021 13.2 E1 attach (bound by milestone_0023 part B): the same held-run gates as cancel, then the ONE
# composed entry (host_agent_attach_apply_v4). Service-owned inputs: the journal and fence of the archive slot,
# the service's OWN live incarnation (its scope's continuity id) and live epoch (the verified epoch record), the
# signed window the last step saw, the verified helper store, and `admit`, the read-only helper admission check
# on THIS capacity owner. Every one of them, and every gate inside the entry, refuses BEFORE the archive, so a
# refusal here never consumes the one attach slot of the incarnation. The effects (helper prepare, then begin +
# open + adoption) run on later host-agent-invoke calls through the step driver.
pub fn host_linux_service_agent_attach_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if not owner.capacity.unwrap().ledger.continuity_proven:
        return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    if owner.reconcile_error != "" or not owner.inventory_returned:
        return linux_service_reply_v4(owner, "", "linux-host-agent-before-reconcile", false)
    if owner.agent.is_none(): return linux_service_reply_v4(owner, "", "linux-host-agent-attach-unstarted", false)
    val agent = owner.agent.unwrap()
    val scope = owner.scope.unwrap()
    val capacity = owner.capacity.unwrap()
    val authority = linux_service_agent_authority_v4(owner, metadata.unwrap())
    if authority.is_err(): return linux_service_reply_v4(owner, "", authority.unwrap_err(), false)
    val fence = container_scope_fence_id_v2(scope)
    if fence.is_err(): return linux_service_reply_v4(owner, "", fence.unwrap_err(), false)
    val live_epoch = linux_service_live_epoch_v4(owner)
    if live_epoch.is_err(): return linux_service_reply_v4(owner, "", live_epoch.unwrap_err(), false)
    val policy = metadata.unwrap().policy
    val context = authority.unwrap().context
    # F15 (B) / milestone_0031: the enrollment-pinned template the packet's stream policy must repeat.
    val template = owner.records.unwrap().agent_helper_template
    if template.is_none(): return linux_service_reply_v4(owner, "", "linux-host-agent-helper-template-invalid", false)
    val store = linux_service_helper_store_v4(owner)
    # Geometry needs an installed-policy-v3 source this service does not have: `policy_bytes` stays empty and a
    # pane Resize is refused by the adapter.
    val service = HostAgentAttachServiceV4(journal: capacity.journal, fence: fence.unwrap(),
        live_incarnation: scope.continuity_id, live_epoch: live_epoch.unwrap(), not_after: agent.not_after,
        policy_bytes: "", store_root: store.root, monotonic_ms: context.monotonic_ms, template: template.unwrap())
    val admit = fn(helper: HostHelperRequestV1) -> Result<(), text>: linux_service_attach_admit_v4(capacity, store, helper, policy, scope, context)
    val applied = host_agent_attach_apply_v4(agent, source, authority.unwrap(), service, admit)
    if applied.error != "": return linux_service_reply_v4(owner, "", applied.error, false)
    owner.agent = Some(applied.agent)
    # A replay is answered from state; a first packet was archived and consumed the slot.
    linux_service_reply_v4(owner, host_linux_service_agent_attachment_inspect_v4(applied.agent), "", not applied.replay)

# milestone_0023 part B (f): the controller-signed agent-terminal authority of this service's attach-ready
# attachment, verified NOW. Read-only (the owner is not changed and nothing is cached): the full current_v4
# recheck, the reconcile gates, the archived attach packet of the held run read back from this journal, and
# host_agent_terminal_authority_v4 under the installed policy, a fresh clock and the service's OWN live
# incarnation and epoch. Err for anything else (no agent, attachment not ready/adopted, an expired or revoked
# approval, a changed policy generation, a binding of another incarnation or epoch).
pub fn host_linux_service_agent_terminal_authority_v4(owner: HostLinuxServiceCurrentV4) -> Result<HostAgentTerminalAuthorityV4, text>:
    val metadata = owner.current_v4()?
    if not owner.capacity.unwrap().ledger.continuity_proven: return Err("linux-host-service-startup-quarantine")
    if owner.reconcile_error != "" or not owner.inventory_returned: return Err("linux-host-agent-before-reconcile")
    val authority = linux_service_agent_authority_v4(owner, metadata)?
    val scope = owner.scope.unwrap()
    val agent = owner.agent.unwrap()
    val archived = distributed_operation_journal_read_v3(owner.capacity.unwrap().journal,
        host_agent_attach_archive_relative_v4(container_scope_fence_id_v2(scope)?, agent.operation_id),
        HOST_AGENT_ATTACH_MAX_BYTES_V4)?
    host_agent_terminal_authority_v4(agent, archived, authority, scope.continuity_id, linux_service_live_epoch_v4(owner)?)

# milestone_0025 PR4: the control target of the agent's own pane for the smux control lease. Err unless the
# terminal-authority accessor above is Ok NOW (so an expired or revoked approval, a changed policy generation or a
# binding of another incarnation yields no target); derived only from that verified authority and the attached
# session (host_agent_pane_control_target_v4). Read-only, never cached: every control issue and every Write asks again.
pub fn host_linux_service_agent_pane_control_target_v4(owner: HostLinuxServiceCurrentV4) -> Result<SessionRuntimeControlTargetV1, text>:
    val authority = host_linux_service_agent_terminal_authority_v4(owner)?
    if owner.agent.is_none() or owner.agent.unwrap().attachment.is_none(): return Err("attach-no-attachment")
    host_agent_pane_control_target_v4(owner.agent.unwrap().attachment.unwrap(), authority.binding, authority.lease_epoch)

# ---- milestone_0024 PR3c S0: the pane lease and brokered pane io the smux consumer calls ----

pub struct HostLinuxServiceLeaseTurnV4:
    owner: HostLinuxServiceCurrentV4
    lease: Option<HostAgentPaneLeaseV4>
    error: text

pub struct HostLinuxServicePaneIoTurnV4:
    owner: HostLinuxServiceCurrentV4
    result: HostAgentPaneIoResultV4

# "" when a pane entry may reach the agent: a held agent whose controller-signed attach still verifies under the
# installed policy, a fresh clock and the service's own live incarnation/epoch (so an expired or revoked approval
# is refused, also after a restart). Pane and smux state are never consulted.
# It also pins the caller's pane: `expected_binding_uid` must equal the controller-signed binding's uid, so a
# Host-route caller that does not name the bound pane never claims or reads it.
fn linux_service_pane_gate_v4(owner: HostLinuxServiceCurrentV4, expected_binding_uid: text,
        registry_check: fn(HostAgentPaneBindingV4) -> text) -> text:
    if owner.agent.is_none(): return "attach-no-attachment"
    match host_linux_service_agent_terminal_authority_v4(owner):
        case Ok(authority):
            if authority.binding.binding_uid != expected_binding_uid: return "attach-binding-mismatch"
            # smux's own registry consistency check on the VERIFIED binding (never authority).
            registry_check(authority.binding)
        case Err(reason): reason

# The pane lease of the agent's attachment, handed out ONCE (13.1). The updated owner is always returned.
pub fn host_linux_service_attachment_lease_v4(original: HostLinuxServiceCurrentV4, expected_binding_uid: text,
        registry_check: fn(HostAgentPaneBindingV4) -> text) -> HostLinuxServiceLeaseTurnV4:
    var owner = original
    val gate = linux_service_pane_gate_v4(owner, expected_binding_uid, registry_check)
    if gate != "": return HostLinuxServiceLeaseTurnV4(owner: owner, lease: None, error: gate)
    val turn = host_linux_service_agent_attachment_lease_v4(owner.agent.unwrap())
    owner.agent = Some(turn.agent)
    HostLinuxServiceLeaseTurnV4(owner: owner, lease: turn.lease, error: turn.error)

# Brokered pane io. There is NO caller `now`: the clock is the service's own grant clock under the installed policy,
# so a pane caller can neither advance the agent clock nor end the signed window.
pub fn host_linux_service_pane_io_v4(original: HostLinuxServiceCurrentV4, expected_binding_uid: text,
        registry_check: fn(HostAgentPaneBindingV4) -> text, lease: HostAgentPaneLeaseV4, op: HostAgentPaneOpV4) -> HostLinuxServicePaneIoTurnV4:
    var owner = original
    val gate = linux_service_pane_gate_v4(owner, expected_binding_uid, registry_check)
    if gate != "":
        return HostLinuxServicePaneIoTurnV4(owner: owner, result: host_agent_pane_io_refused_v4(gate))
    val metadata = owner.current_v4()
    if metadata.is_err():
        return HostLinuxServicePaneIoTurnV4(owner: owner, result: host_agent_pane_io_refused_v4(metadata.unwrap_err()))
    val turn = host_linux_service_agent_pane_io_v4(owner.agent.unwrap(), lease, op,
        host_local_context_v1(metadata.unwrap().policy).grant_clock)
    owner.agent = Some(turn.agent)
    HostLinuxServicePaneIoTurnV4(owner: owner, result: turn.result)

# The inspect field of the accessor above: "" unless the attachment is ready/adopted, else "verified" or the
# accessor's refusal (so an operator sees WHY a ready attachment has no usable authority).
fn linux_service_terminal_authority_state_v4(owner: HostLinuxServiceCurrentV4) -> text:
    if owner.agent.is_none() or owner.agent.unwrap().attachment.is_none(): return ""
    val stage = owner.agent.unwrap().attachment.unwrap().attach_stage
    if stage != HOST_AGENT_ATTACH_READY_V4 and stage != HOST_AGENT_ATTACH_ADOPTED_V4: return ""
    match host_linux_service_agent_terminal_authority_v4(owner):
        case Ok(_): "verified"
        case Err(reason): reason

# milestone_0021 13.2 E2 detach: the same held-run gates as cancel, then the composed entry
# (host_agent_detach_apply_v4: authorize, bind to this attachment, archive no-replace + read-back, ONE forced
# release step through the production port). The capacity owner the release advanced is adopted (13.5).
pub fn host_linux_service_agent_detach_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if not owner.capacity.unwrap().ledger.continuity_proven:
        return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    if owner.reconcile_error != "" or not owner.inventory_returned:
        return linux_service_reply_v4(owner, "", "linux-host-agent-before-reconcile", false)
    if owner.agent.is_none(): return linux_service_reply_v4(owner, "", "linux-host-agent-detach-unstarted", false)
    val agent = owner.agent.unwrap()
    val scope = owner.scope.unwrap()
    val capacity = owner.capacity.unwrap()
    val execute_path = linux_service_execute_relative_v4(scope, agent.operation_id)
    if execute_path.is_err(): return linux_service_reply_v4(owner, "", execute_path.unwrap_err(), false)
    val archived_execute = distributed_operation_journal_read_v3(capacity.journal, execute_path.unwrap(), 2097152)
    if archived_execute.is_err(): return linux_service_reply_v4(owner, "", archived_execute.unwrap_err(), false)
    val execute = host_linux_service_agent_execute_v4(archived_execute.unwrap(), agent.operation_id)
    if execute.is_err(): return linux_service_reply_v4(owner, "", execute.unwrap_err(), false)
    val association = host_execution_association_digest_v3(execute.unwrap().association)
    if association.is_err(): return linux_service_reply_v4(owner, "", association.unwrap_err(), false)
    val fence = container_scope_fence_id_v2(scope)
    if fence.is_err(): return linux_service_reply_v4(owner, "", fence.unwrap_err(), false)
    val policy = metadata.unwrap().policy
    val context = host_local_context_v1(policy)
    val authority = HostAgentActionAuthorityV4(snapshot: policy.snapshot, controller_ref: metadata.unwrap().configuration.controller_ref,
        execute_operation: execute.unwrap().operation, execute_association_digest: association.unwrap(), context: context)
    val release = HostAgentReleaseContextV4(capacity: capacity, store: linux_service_helper_store_v4(owner),
        monotonic_ms: context.monotonic_ms)
    val port = fn(call: HostAgentAttachmentPortCallV4) -> HostAgentAttachmentReleaseStepV4: host_agent_attachment_release_step_v4(call, release)
    val applied = host_agent_detach_apply_v4(agent, source, authority, capacity.journal, fence.unwrap(), port)
    owner.agent = Some(applied.agent)
    if applied.capacity.is_some(): owner.capacity = applied.capacity
    # The release ran (a capacity owner came back) or the detach fully applied: an effect was attempted.
    val effect = applied.error == "" or applied.capacity.is_some()
    if applied.error != "": return linux_service_reply_v4(owner, "", applied.error, effect)
    linux_service_reply_v4(owner, host_linux_service_agent_attachment_inspect_v4(applied.agent), "", effect)

# 13.2 inspect: the read-only attachment report; never runs a release step. `source` names the run. A
# ready/adopted attachment also reports its terminal-authority verdict (milestone_0023 part B).
pub fn host_linux_service_agent_inspect_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    val owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if owner.agent.is_none() or owner.agent.unwrap().operation_id != source:
        return linux_service_reply_v4(owner, "", "linux-host-agent-inspect-unknown", false)
    linux_service_reply_v4(owner, host_linux_service_agent_attachment_authority_inspect_v4(owner.agent.unwrap(),
        linux_service_terminal_authority_state_v4(owner)), "", false)

fn linux_service_cancel_relative_v4(scope: ContainerHostScopeV2, operation_id: text) -> Result<text, text>:
    Ok("host-agent-cancel/" + sha256_text(container_scope_fence_id_v2(scope)? + "\n" + operation_id) + ".sdn")

# Accepted-connection dispatch: the two associated actions, the agent invoke (milestone_0021 PR2), the agent
# cancel (PR3) and the attachment attach/detach/inspect (PR3b).
pub fn host_linux_service_dispatch_v4(owner: HostLinuxServiceCurrentV4, action: text, source: text,
        project: fn(ContainerExecutionDraftV3) -> Result<ContainerExecutionRequestV2, text>) -> HostLinuxServiceReplyV4:
    # Draining admits nothing new; inspect, detach and cancel stay so a live attachment can still release the writer.
    if owner.draining and action != "host_agent_inspect_v4" and action != "host_agent_detach_v4" and action != "host_agent_cancel_v4" and
            not REMOTE_BUILD_DRAINING_ACTIONS_V4.contains(action):
        return linux_service_reply_v4(owner, "", "linux-host-service-draining", false)
    if action == "host_service_handoff_v1": return linux_service_handoff_v4(owner, source)
    if action == "host_service_handoff_abandon_v1": return linux_service_handoff_abandon_v4(owner, source)
    if action == "host_helper_abandon_v1": return linux_service_helper_abandon_v4(owner, source)
    if action == "host_helper_inspect_v1": return linux_service_helper_inspect_v4(owner, source)
    if action == "host_retention_release_v1": return linux_service_retention_release_v4(owner, source)
    if action == "host_retention_inspect_v1": return linux_service_retention_inspect_v4(owner, source)
    if action == "host_service_handoff_inspect_v1": return linux_service_handoff_inspect_v4(owner)
    if action == "host_prepare_associated_v3": return host_linux_service_prepare_v4(owner, source, project)
    if action == "host_execute_associated_v3": return host_linux_service_execute_v4(owner, source)
    if action == "host_agent_invoke_v4": return host_linux_service_agent_invoke_v4(owner, source)
    if action == "host_agent_cancel_v4": return host_linux_service_agent_cancel_v4(owner, source)
    if action == "host_agent_attach_v4": return host_linux_service_agent_attach_v4(owner, source)
    if action == "host_agent_detach_v4": return host_linux_service_agent_detach_v4(owner, source)
    if action == "host_agent_inspect_v4": return host_linux_service_agent_inspect_v4(owner, source)
    if action == "host_remote_build_open_v4": return host_linux_service_remote_build_open_v4(owner, source)
    if action == "host_remote_build_input_v4": return host_linux_service_remote_build_input_v4(owner, source)
    if action == "host_remote_build_start_v4": return host_linux_service_remote_build_start_v4(owner, source)
    if action == "host_remote_build_collect_v4": return host_linux_service_remote_build_collect_v4(owner, source)
    if action == "host_remote_build_output_v4": return host_linux_service_remote_build_output_v4(owner, source)
    if action == "host_remote_build_cancel_v4": return host_linux_service_remote_build_cancel_v4(owner, source)
    linux_service_reply_v4(owner, "", "linux-host-service-action-unknown", false)

# AT-OPS-01 drain: verify the controller-signed handoff against THIS owner's live state, publish it as the pending
# handoff on the single journal, and only then stop admitting. The caller closes the owner next (exit-then-adopt).
fn linux_service_handoff_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    if not owner.capacity.unwrap().ledger.continuity_proven:
        return linux_service_reply_v4(owner, "", "linux-host-service-startup-quarantine", false)
    if owner.reconcile_error != "" or not owner.inventory_returned:
        return linux_service_reply_v4(owner, "", "linux-host-service-handoff-before-reconcile", false)
    val reply = host_service_handoff_commit_v1(owner.capacity.unwrap().journal, owner.scope.unwrap(), metadata.unwrap().policy,
        metadata.unwrap().configuration.controller_ref, host_local_context_v1(metadata.unwrap().policy), owner.current_relative,
        owner.current_bytes, owner.agent_operation, source)
    if reply.is_err():
        # Published but unverified: the record is on the journal, so admission stops and recovery is flagged.
        if reply.unwrap_err().starts_with(HOST_SERVICE_HANDOFF_UNVERIFIED_V1):
            owner.draining = true
            return linux_service_reply_v4(owner, "", reply.unwrap_err(), true)
        return linux_service_reply_v4(owner, "", reply.unwrap_err(), false)
    owner.draining = true
    linux_service_reply_v4(owner, reply.unwrap(), "", true)

# AT-OPS-01 recovery: a controller-signed abandon voids the one pending handoff this (quarantined) successor could not
# verify. Deliberately NOT gated on the quarantine it exists to clear: only a verified abandon is accepted, written
# through the single journal writer. The unit is then restarted; the next start finds the sequence consumed. After a
# failed post-flip consume the voided record had been verified: harmless, the next start re-proves exclusion anyway.
fn linux_service_handoff_abandon_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    val reply = host_service_handoff_abandon_v1(owner.capacity.unwrap().journal, owner.scope.unwrap(), metadata.unwrap().policy,
        metadata.unwrap().configuration.controller_ref, host_local_context_v1(metadata.unwrap().policy), source)
    if reply.is_err(): return linux_service_reply_v4(owner, "", reply.unwrap_err(), false)
    linux_service_reply_v4(owner, reply.unwrap(), "", true)

# milestone_0036: a controller-signed abandon releases the Host charge of one attach-broker helper row whose death cannot be
# proven by the deadline reap or whose records are permanently unreadable. Like the handoff abandon it is deliberately NOT
# gated on the quarantine it clears; the capacity owner (single journal writer) is adopted on every path. While this
# service's own agent still holds that helper's attachment in any stage but `release-blocked` the command is refused: a
# live attachment is released by its own port, never freed from underneath.
fn linux_service_helper_abandon_guard_v4(owner: HostLinuxServiceCurrentV4, source: text) -> text:
    val decoded = host_helper_abandon_proof_decode_v1(source)
    if decoded.is_err(): return decoded.unwrap_err()
    linux_service_helper_attachment_guard_v4(owner, decoded.unwrap().abandon.operation_id)

# milestone_0046: the same live-attachment refusal for the read-only inspect, so the plan phase never prints a record the
# signed command would refuse. Keyed by the helper operation id.
fn linux_service_helper_attachment_guard_v4(owner: HostLinuxServiceCurrentV4, operation_id: text) -> text:
    val agent = match owner.agent:
        case Some(actual): actual
        case None: return ""
    val attachment = match agent.attachment:
        case Some(actual): actual
        case None: return ""
    val request = host_helper_request_decode_v1(attachment.helper_request_bytes)
    if request.is_err(): return "linux-host-service-helper-abandon-attachment-unreadable"
    if request.unwrap().operation.id != operation_id: return ""
    if attachment.attach_stage != HOST_AGENT_ATTACH_BLOCKED_V4: return "linux-host-service-helper-abandon-attachment-live"
    ""

fn linux_service_helper_abandon_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    val live = linux_service_helper_abandon_guard_v4(owner, source)
    if live != "": return linux_service_reply_v4(owner, "", live, false)
    val turn = host_helper_abandon_v1(owner.capacity.unwrap(), metadata.unwrap().policy,
        metadata.unwrap().configuration.controller_ref, host_local_context_v1(metadata.unwrap().policy),
        owner.scope.unwrap().physical_host_id, source)
    owner.capacity = Some(turn.owner)
    if turn.error != "": return linux_service_reply_v4(owner, "", turn.error, turn.effect_attempted)
    linux_service_reply_v4(owner, turn.reply, "", true)

# milestone_0046: the read-only inspects the controller's `helper-abandon` / `handoff-abandon` commands read before the
# operator signs: the exact canonical record the signed command must carry, derived by the same function the command
# uses. They write nothing and grant nothing; like the abandons they are not gated on the startup quarantine and are
# refused while draining. `source` names the helper row.
fn linux_service_helper_inspect_v4(owner: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    val live = linux_service_helper_attachment_guard_v4(owner, source)
    if live != "": return linux_service_reply_v4(owner, "", live, false)
    val record = host_helper_abandon_inspect_v1(owner.capacity.unwrap().journal, source, owner.scope.unwrap().physical_host_id)
    if record.is_err(): return linux_service_reply_v4(owner, "", record.unwrap_err(), false)
    linux_service_reply_v4(owner, record.unwrap(), "", false)

# milestone_0045 retention release (owner decision 2): the controller-signed release of a remote build's retained
# workspace, per run since milestone_0047 (owner decision 1): only the run's own child of the provisioned leaf is deleted.
# Runs only in an incarnation with a free slot (no agent, no build, no admitted slot row, nothing consumed, no root loan
# held) after continuity and reconcile: each incarnation runs one workload, so a retained run is released by a later
# incarnation. Admission (verify, derive, check, record proof + marker) is journaled BEFORE any effect; the root loan is
# lent for the provider effect only and ended before the archive. The provider admits its OWN native lease of the leaf
# (no workload ran in this incarnation, so no in-process holder exists) and drops that hold on every exit (milestone_0047
# bug fix): the next workload prepare admits the leaf afresh in the same incarnation, no restart.
# A re-issued release converges after any crash (host_remote_build_retention_release_v1). Never a continuity flip.
fn linux_service_retention_release_v4(original: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    var owner = original
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    val ready = linux_service_remote_build_ready_v4(owner)
    if ready != "": return linux_service_reply_v4(owner, "", ready, false)
    if (owner.agent.is_some() or owner.build.is_some() or owner.agent_consumed or owner.agent_root.is_some() or
            owner.agent_operation_id != ""):
        return linux_service_reply_v4(owner, "", "linux-host-retention-release-slot-busy", false)
    if owner.admission.is_none() or owner.admission.unwrap().owner.is_none():
        return linux_service_reply_v4(owner, "", "linux-host-service-admission-missing", false)
    val policy = metadata.unwrap().policy
    val admitted = host_retention_release_admit_v1(owner.capacity.unwrap().journal, owner.capacity.unwrap().ledger, policy,
        metadata.unwrap().configuration.controller_ref, host_local_context_v1(policy), owner.scope.unwrap().physical_host_id, source)
    # A refusal after verification may have left the proof or the marker behind (both harmless and idempotent).
    if admitted.is_err(): return linux_service_reply_v4(owner, "", admitted.unwrap_err(), true)
    if admitted.unwrap().archived != "": return linux_service_reply_v4(owner, admitted.unwrap().archived, "", true)
    var admission = owner.admission.unwrap()
    val lent = admission.owner.unwrap().lend_workspace_root_v1()
    admission.owner = Some(lent.owner)
    owner.admission = Some(admission)
    if lent.error != "" or lent.root.is_none():
        return linux_service_reply_v4(owner, "", if lent.error != "": lent.error else: "linux-host-retention-release-root-missing", true)
    # milestone_0049: an absent run child settles for a resumed release or a proven never-staged reaped run.
    val effect = linux_workspace_retention_release_v1(lent.root.unwrap(), admitted.unwrap().request_bytes,
        admitted.unwrap().resumed or admitted.unwrap().never_staged)
    val ended = admission.owner.unwrap().end_workspace_root_loan_v1(lent.root.unwrap())
    admission.owner = Some(ended.owner)
    owner.admission = Some(admission)
    # A refused loan end keeps the borrow here; the close path ends it first (3.3 N-05).
    if ended.error != "": owner.agent_root = lent.root
    if effect.error != "": return linux_service_reply_v4(owner, "", effect.error, true)
    val archived = host_retention_release_archive_v1(owner.capacity.unwrap().journal, admitted.unwrap().operation_id,
        sha256_text(admitted.unwrap().marker), HostRetentionReleaseEffectV1(charge: effect.charge, used_bytes: effect.used_bytes,
        used_inodes: effect.used_inodes, removed: effect.removed), host_local_context_v1(policy).grant_clock)
    if archived.is_err(): return linux_service_reply_v4(owner, "", archived.unwrap_err(), true)
    if ended.error != "": return linux_service_reply_v4(owner, archived.unwrap(), ended.error, true)
    linux_service_reply_v4(owner, archived.unwrap(), "", true)

# milestone_0045 retention-release inspect: the canonical Host part of the record (no controller fields) the controller's
# `retention-release` command reads before it adds its own terminal state and the operator signs. Read-only DATA.
fn linux_service_retention_inspect_v4(owner: HostLinuxServiceCurrentV4, source: text) -> HostLinuxServiceReplyV4:
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    val record = host_retention_release_inspect_v1(owner.capacity.unwrap().journal, owner.capacity.unwrap().ledger, source,
        owner.scope.unwrap().physical_host_id)
    if record.is_err(): return linux_service_reply_v4(owner, "", record.unwrap_err(), false)
    linux_service_reply_v4(owner, record.unwrap(), "", false)

fn linux_service_handoff_inspect_v4(owner: HostLinuxServiceCurrentV4) -> HostLinuxServiceReplyV4:
    val metadata = owner.current_v4()
    if metadata.is_err(): return linux_service_reply_v4(owner, "", metadata.unwrap_err(), false)
    val record = host_service_handoff_abandon_inspect_v1(owner.capacity.unwrap().journal, owner.scope.unwrap())
    if record.is_err(): return linux_service_reply_v4(owner, "", record.unwrap_err(), false)
    linux_service_reply_v4(owner, record.unwrap(), "", false)

# The workload scope of this service's lending epoch: the bound host (the same
# physical_host_id association_match_v3 compares), "epoch-" + the lent digest
# and the startup native snapshot (machine_fresh_workload_scope_v2 convention).
# Prepare re-verifies it against a fresh native observation.
fn linux_service_native_scope_v4(owner: HostLinuxServiceCurrentV4) -> Result<ContainerHostScopeV2, text>:
    if owner.native_snapshot.is_none(): return Err("linux-host-service-projection-native-required")
    val native = owner.native_snapshot.unwrap()
    Ok(ContainerHostScopeV2(physical_host_id: owner.scope_v4().physical_host_id, service_scope_id: "epoch-" + owner.initial_epoch,
        boot_id: native.native_boot_id, provider_generation: native.owner_generation, native_machine_id: native.native_machine_id,
        continuity_mode: "native-boot-incarnation-v1", continuity_id: native.native_boot_id))

# Production entry for the V6 Host routes (host_service_domain_turn_v3 prepare,
# host_service_execution_v4 execute). The full current_v4 recheck runs first so
# its refusal is the one reported (recovery required, like the Windows arm).
# The projector binds the request's draft to this owner's own epoch scope;
# nothing in the request selects the scope.
pub fn host_linux_service_dispatch_installed_v4(owner: HostLinuxServiceCurrentV4, action: text,
        source: text) -> HostLinuxServiceReplyV4:
    val current = owner.current_v4()
    if current.is_err(): return linux_service_reply_v4(owner, "", current.unwrap_err(), true)
    val scope = linux_service_native_scope_v4(owner)
    if scope.is_err(): return linux_service_reply_v4(owner, "", scope.unwrap_err(), false)
    val bound = scope.unwrap()
    host_linux_service_dispatch_v4(owner, action, source,
        fn(draft: ContainerExecutionDraftV3) -> Result<ContainerExecutionRequestV2, text>: container_execution_draft_bind_v3(draft, bound))

pub struct HostLinuxServiceCloseV4:
    owner: HostLinuxServiceCurrentV4
    completed: bool
    released_all: bool
    error: text

fn linux_service_close_reason_v4(error: text, fallback: text) -> text:
    if error != "": return error
    fallback

# 13.5: the helper store context of every agent step/close: the verified store root and this journal.
# m23 item 3 (14.2): the opened store is rechecked HERE, per helper-dependent operation, never in current_v4. A store
# that is no longer the derived, valid one is lent as unopened (root ""), so only attach / release / charged-state
# checks refuse; status, prepare, execute and the helper evidence rows of other domains are unaffected.
fn linux_service_helper_store_v4(owner: HostLinuxServiceCurrentV4) -> HostHelperStoreV1:
    if owner.capacity.is_none(): return HostHelperStoreV1(root: "", journal: None)
    val journal = owner.capacity.unwrap().journal
    var root = ""
    if owner.helper_store != "":
        val checked = host_linux_helper_store_check_v1(journal.root)
        if checked.is_ok():
            match checked.unwrap():
                case HostLinuxHelperStoreStateV1.Valid(valid):
                    if valid == owner.helper_store: root = valid
                case HostLinuxHelperStoreStateV1.Absent: ()
    HostHelperStoreV1(root: root, journal: Some(journal))

# The close-time monotonic clock (m23 P2-4): read from the installed policy of the loaded records, never a
# constant. 0 only when the records were never loaded, in which case no attachment can exist.
fn linux_service_close_monotonic_v4(owner: HostLinuxServiceCurrentV4) -> i64:
    if owner.records.is_none(): return 0
    host_local_context_v1(owner.records.unwrap().metadata.policy).monotonic_ms

# Shutdown. `closed` is set first so no status/prepare/execute can follow.
# Owner-bearing carriers stay ONLY in the returned owner: the journal owner is
# cleared only once its close completed or its cleanup carrier was taken over;
# readers are replaced by whatever the landed close retained. A failed release
# is sticky in `close_error`, so a retry never reports a clean completion over
# an earlier failure. The native identity borrow is released with its upper
# parent: the retained lending admission, closed after the loan ends. An
# inventory already returned after the proof is skipped (store loan inactive).
#
# milestone_0021 3.7 order with an agent: (1) the agent close (collector cancel, workspace-root loan end, workload
# close), (2) journal and readers, (3) the service loan on the transfer's admission, (4) the epoch close then the
# helper-root removal, (5) the admission residue, (6) agent = None. A wedged agent or a pending stop/settle
# keeps the agent and its transfer here (fail closed): steps 3-6 do not run; the next start's reconcile drains.
pub fn host_linux_service_close_v4(original: HostLinuxServiceCurrentV4) -> HostLinuxServiceCloseV4:
    var owner = original
    owner.closed = true
    var error = ""
    if val agent = owner.agent:
        if not agent.workload_closed:
            val closed = host_linux_service_agent_close_v4(agent, owner.capacity, linux_service_helper_store_v4(owner),
                linux_service_close_monotonic_v4(owner))
            owner.agent = Some(closed.agent)
            # The returned capacity owner is the single journal writer (13.5).
            if closed.capacity.is_some(): owner.capacity = closed.capacity
            if not closed.closed and error == "": error = closed.error
    elif val build = owner.build:
        # A pre-transfer build holds nothing (its executing row is reaped at the next start); a transferred one closes
        # like the agent: wedged or reserved-unsettled keeps everything (fail closed).
        if not owner.agent_consumed: owner.build = None
        else:
            val closed = host_remote_build_close_v4(build)
            if closed.is_ok(): owner.build = Some(closed.unwrap())
            elif error == "": error = closed.unwrap_err()
    # milestone_0021 13.5: while the agent's attachment is live the helper-settlement writer must survive, so the
    # capacity owner and the journal stay open (no capacity close, no journal cleanup).
    var attachment_live = false
    if val agent = owner.agent: attachment_live = host_agent_attachment_live_v4(agent.attachment)
    if attachment_live:
        if error == "": error = "linux-host-agent-attachment-release-pending"
    elif owner.journal_cleanup.is_some():
        val turn = distributed_operation_journal_open_cleanup_v2(owner.journal_cleanup.unwrap())
        owner.journal_cleanup = turn.cleanup
        if (not turn.closed or turn.error != "") and error == "":
            error = linux_service_close_reason_v4(turn.error, "linux-host-service-journal-close-pending")
    if not attachment_live and owner.capacity.is_some() and owner.journal_cleanup.is_none():
        val turn = host_capacity_owner_close_owned_v2(owner.capacity.unwrap())
        if turn.closed and turn.error == "":
            owner.capacity = None
        elif turn.cleanup.is_some():
            owner.capacity = None
            owner.journal_cleanup = turn.cleanup
        if not turn.closed or turn.error != "":
            if error == "": error = linux_service_close_reason_v4(turn.error, "linux-host-service-journal-close-pending")
    elif not attachment_live and owner.capacity.is_some():
        if error == "": error = "linux-host-service-journal-cleanup-pending"
    # m23 P2-4: with a live attachment the readers stay open with the capacity owner and journal (one order: the
    # readers are released only after the helper-settlement writer is).
    if not attachment_live and owner.parent_reader.is_some():
        val closed = linux_protected_root_reader_close_v1(owner.parent_reader.unwrap())
        owner.parent_reader = closed.owner
        if not closed.completed and error == "": error = linux_service_close_reason_v4(closed.error, "linux-host-service-reader-close-pending")
    if not attachment_live and owner.root_reader.is_some():
        val closed = linux_protected_root_reader_close_v1(owner.root_reader.unwrap())
        owner.root_reader = closed.owner
        if not closed.completed and error == "": error = linux_service_close_reason_v4(closed.error, "linux-host-service-reader-close-pending")
    # Lending admission last, and only once every service part above is
    # released: drop the native borrow, end the loan, then close the owner.
    # Anything pending keeps the admission (and its loan) in this owner.
    val service_released = (owner.capacity.is_none() and owner.journal_cleanup.is_none() and owner.parent_reader.is_none() and
        owner.root_reader.is_none())
    if val agent = owner.agent:
        if not service_released:
            if error == "": error = "linux-host-service-admission-close-pending"
        elif agent.workload_closed:
            # The release ends the service loan once, then (re)tries the epoch close (P2R1-F2).
            val released = host_linux_service_agent_release_v4(agent, owner.native)
            owner.agent = released.agent
            owner.native = released.native
            if released.error != "" and error == "": error = released.error
            if owner.agent.is_none() and owner.admission.is_some():
                # Step 5: the residue turn; its owner already moved into the closed transfer.
                val closed = machine_fresh_epoch_admission_turn_close_v1(owner.admission.unwrap())
                owner.admission = closed.retained
                if (not closed.closed or closed.retained.is_some() or closed.error != "") and error == "":
                    error = linux_service_close_reason_v4(closed.error, "linux-host-service-admission-close-pending")
    elif val build = owner.build:
        if not service_released:
            if error == "": error = "linux-host-service-admission-close-pending"
        elif build.workload_closed:
            val released = host_remote_build_release_v4(build, owner.native)
            owner.build = released.executor
            owner.native = released.native
            if released.error != "" and error == "": error = released.error
            if owner.build.is_none() and owner.admission.is_some():
                val closed = machine_fresh_epoch_admission_turn_close_v1(owner.admission.unwrap())
                owner.admission = closed.retained
                if (not closed.closed or closed.retained.is_some() or closed.error != "") and error == "":
                    error = linux_service_close_reason_v4(closed.error, "linux-host-service-admission-close-pending")
    elif owner.admission.is_some():
        if not service_released:
            if error == "": error = "linux-host-service-admission-close-pending"
        else:
            # The loan ends only by handing the exact lent borrow back; the
            # lender verifies it aliases its own reader and custody. A refused
            # or impossible return keeps the borrow, loan and admission here.
            var admission = owner.admission.unwrap()
            var loan_error = ""
            if val held = admission.owner:
                # The store-inventory loan ends first: the lender refuses to
                # end the service loan while it is active.
                var lender = held
                # 3.3 N-05: a pre-transfer root whose loan end was refused is ended first (it also closes a
                # never-adopted R3), before the store and service loans.
                if val root = owner.agent_root:
                    val ended = lender.end_workspace_root_loan_v1(root)
                    lender = ended.owner
                    admission.owner = Some(lender)
                    if ended.error != "": loan_error = ended.error
                    else: owner.agent_root = None
                if loan_error == "" and lender.store_inventory_loaned:
                    if owner.inventory.is_none(): loan_error = "linux-host-service-inventory-borrow-missing"
                    else:
                        val returned = lender.end_store_inventory_loan_v1(owner.inventory.unwrap())
                        lender = returned.owner
                        admission.owner = Some(lender)
                        if returned.error != "": loan_error = returned.error
                        else: owner.inventory = None
                if loan_error == "" and lender.service_loaned:
                    if owner.native.is_none(): loan_error = "linux-host-service-loan-borrow-missing"
                    else:
                        val ended = lender.end_service_loan_v1(owner.native.unwrap())
                        admission.owner = Some(ended.owner)
                        if ended.error != "": loan_error = ended.error
            owner.admission = Some(admission)
            if loan_error != "":
                if error == "": error = loan_error
            else:
                owner.native = None
                val closed = machine_fresh_epoch_admission_turn_close_v1(admission)
                owner.admission = closed.retained
                if (not closed.closed or closed.retained.is_some() or closed.error != "") and error == "":
                    error = linux_service_close_reason_v4(closed.error, "linux-host-service-admission-close-pending")
    if error != "": owner.close_error = error
    val reported = if error != "": error else: owner.close_error
    # released_all: nothing owner-bearing is retained now, even if an earlier
    # attempt failed (that failure stays visible in `error`/`completed`).
    val released = service_released and owner.admission.is_none() and owner.agent.is_none() and owner.build.is_none()
    HostLinuxServiceCloseV4(owner: owner, completed: reported == "", released_all: released, error: reported)

