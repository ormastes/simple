# Tagged local authority preserves each platform's actual enrollment provenance.
use std.nogc_sync_mut.orchestration.host_local_root_v1.HostLocalRootV1
use std.nogc_sync_mut.orchestration.host_windows_local_root_v3.HostWindowsLocalRootV3
use std.nogc_sync_mut.orchestration.host_linux_service_current_v4.HostLinuxServiceCurrentV4

pub enum HostLocalRootV3:
    Linux(HostLocalRootV1)
    Windows(HostWindowsLocalRootV3)
    # Signed-enrollment Linux service (service 40). Through the shared domain
    # only status and close reach it; associated prepare/execute use
    # host_linux_service_dispatch_v4. The authenticated V6 listener serves it
    # (policy, journal binding, ready publication, controller status). Every
    # V2 effect and direct primary-connection (terminal) route refuses it.
    LinuxService(HostLinuxServiceCurrentV4)
