# JS Interpreter Types
# Environment, scope chain, call frames, and JS value coercion utilities.

use std.js.types.js_types.{JsValue, JsObject, JsProperty}
use std.js.types.ast_types.{JsStatement, JsExpression}
use std.nogc_sync_mut.js.engine.js_error.{js_nan}

pub val RETURN_SIGNAL = "__return__"

# Per-script execution-step budget. Lives here (not in interpreter.spl) because
# js/engine/runtime.spl imports interpreter.spl back: class/fn imports tolerate
# that cycle, a val import from a still-loading module does not.
pub val MAX_SCRIPT_EXECUTION_STEPS: i64 = 100000

# Host-DOM mutation retention ceilings, enforced where scripted DOM mutations
# are staged into the host document. Same cycle-breaking move as above:
# interpreter_eval_member.spl imports interpreter.spl back (impl JsInterpreter).
pub val JS_HOST_DOM_MUTATION_MAX_RETAINED_OBJECTS: i64 = 32768
pub val JS_HOST_DOM_MUTATION_MAX_RETAINED_BYTES: i64 = 64 * 1024 * 1024

class Environment:
    bindings: Dict<text, JsValue>
    is_strict: bool
    parent: i64

    fn clone() -> Environment:
        Environment(bindings: self.bindings, is_strict: self.is_strict, parent: self.parent)

fn env_new() -> Environment:
    Environment(bindings: {}, is_strict: false, parent: -1)

class EnvironmentStack:
    frames: [Environment]
    # Flat parent view of the same chain the frames walk uses: env_parent_ids[i]
    # is the parent of env i (or -1 for a root). Maintained in lockstep with
    # frames by create_env so owners can inspect or reject forged links without
    # a hop-bound walk. next_id mirrors frames.len() and is the rejection
    # oracle: a parent at or beyond it is a future/self alias.
    env_parent_ids: [i64]
    next_id: i64

fn env_stack_new() -> EnvironmentStack:
    # Interpreter entry: frame 0 is the pre-created global the JsInterpreter
    # addresses as env 0 from birth.
    EnvironmentStack(frames: [env_new()], env_parent_ids: [-1], next_id: 1)

impl EnvironmentStack:
    static fn new() -> EnvironmentStack:
        # Standalone entry (specs, fixtures): an empty stack; the first
        # create_env(-1) allocates the root env as id 0.
        EnvironmentStack(frames: [], env_parent_ids: [], next_id: 0)

    fn clone() -> EnvironmentStack:
        var cloned_frames: [Environment] = []
        var i = 0
        while i < self.frames.len():
            cloned_frames.push(self.frames[i].clone())
            i = i + 1
        var cloned_parents: [i64] = []
        var j = 0
        while j < self.env_parent_ids.len():
            cloned_parents.push(self.env_parent_ids[j])
            j = j + 1
        EnvironmentStack(frames: cloned_frames, env_parent_ids: cloned_parents, next_id: self.next_id)

    me create_env(parent: i64) -> i64:
        # Reject future/self aliases (parent at or beyond the next id, or below
        # the root sentinel) without creating anything; a stale or forged id
        # must not occupy a slot. Valid parents create the frame and record the
        # parent in both views.
        if parent < -1 or parent >= self.next_id:
            return -1
        var frame = env_new()
        if parent >= 0:
            frame.parent = parent
        val new_id = self.next_id
        self.frames.push(frame)
        self.env_parent_ids.push(parent)
        self.next_id = self.next_id + 1
        new_id

    me define_var(env: i64, name: text, value: JsValue):
        if env < 0 or env >= self.frames.len():
            return
        var frame = self.frames[env]
        frame.bindings[name] = value
        self.frames[env] = frame

    # Walk the parent chain from `env` looking for an existing binding.
    # Returns the env id holding the binding, or -1 if none in the chain.
    me _resolve_env(env: i64, name: text) -> i64:
        var current = env
        var hops = 0
        val max_hops = self.frames.len()
        while current >= 0 and current < self.frames.len() and hops <= max_hops:
            val frame = self.frames[current]
            if frame.bindings.has(name):
                return current
            current = frame.parent
            hops = hops + 1
        -1

    me set_var(env: i64, name: text, value: JsValue):
        val holder = self._resolve_env(env, name)
        if holder >= 0:
            var frame = self.frames[holder]
            frame.bindings[name] = value
            self.frames[holder] = frame
            return
        if env != 0 and self.frames.len() > 0:
            var global_frame = self.frames[0]
            if global_frame.bindings.has(name):
                global_frame.bindings[name] = value
                self.frames[0] = global_frame
                return
        if env >= 0 and env < self.frames.len():
            var fallback_frame = self.frames[env]
            fallback_frame.bindings[name] = value
            self.frames[env] = fallback_frame
            return
        self.define_var(0, name, value)

    me get_var(env: i64, name: text) -> JsValue?:
        val holder = self._resolve_env(env, name)
        if holder >= 0:
            val frame = self.frames[holder]
            return Some(frame.bindings[name])
        if env != 0 and self.frames.len() > 0:
            val global_frame = self.frames[0]
            if global_frame.bindings.has(name):
                return Some(global_frame.bindings[name])
        nil

class CallFrame:
    function_name: text
    env_id: i64
    line: i64
    this_value: JsValue
    return_value: JsValue
    has_return: bool

    fn clone() -> CallFrame:
        CallFrame(
            function_name: self.function_name,
            env_id: self.env_id,
            line: self.line,
            this_value: self.this_value,
            return_value: self.return_value,
            has_return: self.has_return
        )

fn call_frame_new(name: text) -> CallFrame:
    CallFrame(function_name: name, env_id: -1, line: 0, this_value: JsValue.Undefined, return_value: JsValue.Undefined, has_return: false)

class JsFunction:
    name: text
    params: [text]
    body: [JsStatement]
    closure_env: i64
    is_arrow: bool

    static fn create(name: text, params: [text], body: [JsStatement], closure_env: i64) -> JsFunction:
        JsFunction(name: name, params: params, body: body, closure_env: closure_env, is_arrow: false)

class NativeIdMapping:
    first: i64
    second: i64

# NaN is produced via js_nan() (float overflow, no division) rather than the
# literal `0.0 / 0.0`, which the Simple runtime traps as a fatal E2001 —
# `to_number` of a non-numeric JsValue used to crash the interpreter.
fn to_number(v: JsValue) -> f64:
    match v:
        JsValue.Undefined: js_nan()
        JsValue.Null: 0.0
        JsValue.Boolean(b): if b: 1.0 else: 0.0
        JsValue.Number(n): n
        JsValue.String(s): s.parse_f64() ?? js_nan()
        JsValue.Object(_): js_nan()
        JsValue.Array(_): 0.0
        JsValue.Function(_): js_nan()

fn js_number_to_string(n: f64) -> text:
    """ECMA-262 ToString(Number): an integral value carries no fractional part."""
    if n != n:
        return "NaN"
    val s = "{n}"
    if s.ends_with(".0"):
        return s.slice(0, s.byte_len() - 2)
    s

fn js_to_string(v: JsValue) -> text:
    match v:
        JsValue.Undefined: "undefined"
        JsValue.Null: "null"
        JsValue.Boolean(b): if b: "true" else: "false"
        JsValue.Number(n): js_number_to_string(n)
        JsValue.String(s): s
        JsValue.Object(_): "[object Object]"
        JsValue.Array(_): ""
        JsValue.Function(_): "function() {}"

fn to_boolean(v: JsValue) -> bool:
    match v:
        JsValue.Undefined: false
        JsValue.Null: false
        JsValue.Boolean(b): b
        JsValue.Number(n): n != 0.0 and n == n
        JsValue.String(s): s.len() > 0
        JsValue.Object(_): true
        JsValue.Array(_): true
        JsValue.Function(_): true

fn is_truthy(v: JsValue) -> bool:
    to_boolean(v)

fn typeof_value(v: JsValue) -> text:
    match v:
        JsValue.Undefined: "undefined"
        JsValue.Null: "object"
        JsValue.Boolean(_): "boolean"
        JsValue.Number(_): "number"
        JsValue.String(_): "string"
        JsValue.Object(_): "object"
        JsValue.Array(_): "object"
        JsValue.Function(_): "function"

fn strict_equals(a: JsValue, b: JsValue) -> bool:
    match a:
        JsValue.Undefined:
            match b:
                JsValue.Undefined: true
                _: false
        JsValue.Null:
            match b:
                JsValue.Null: true
                _: false
        JsValue.Boolean(av):
            match b:
                JsValue.Boolean(bv): av == bv
                _: false
        JsValue.Number(an):
            match b:
                JsValue.Number(bn): an == bn
                _: false
        JsValue.String(a_str):
            match b:
                JsValue.String(b_str): a_str == b_str
                _: false
        JsValue.Object(ai):
            match b:
                JsValue.Object(bi): ai == bi
                _: false
        JsValue.Array(ai):
            match b:
                JsValue.Array(bi): ai == bi
                _: false
        JsValue.Function(ai):
            match b:
                JsValue.Function(bi): ai == bi
                _: false

fn abstract_equals(a: JsValue, b: JsValue) -> bool:
    strict_equals(a, b)

fn _is_array_method(name: text) -> bool:
    name == "push" or name == "pop" or name == "shift" or name == "unshift" or
    name == "splice" or name == "slice" or name == "concat" or name == "join" or
    name == "indexOf" or name == "lastIndexOf" or name == "includes" or
    name == "map" or name == "filter" or name == "reduce" or name == "forEach" or
    name == "find" or name == "findIndex" or name == "some" or name == "every" or
    name == "sort" or name == "reverse" or name == "fill" or name == "flat" or
    name == "flatMap" or name == "entries" or name == "keys" or name == "values" or
    name == "length" or name == "from" or name == "isArray"

fn _is_string_method(name: text) -> bool:
    name == "length" or name == "charAt" or name == "charCodeAt" or
    name == "indexOf" or name == "lastIndexOf" or name == "includes" or
    name == "startsWith" or name == "endsWith" or name == "slice" or
    name == "substring" or name == "toUpperCase" or name == "toLowerCase" or
    name == "trim" or name == "trimStart" or name == "trimEnd" or
    name == "split" or name == "replace" or name == "replaceAll" or
    name == "match" or name == "search" or name == "padStart" or name == "padEnd" or
    name == "repeat" or name == "concat" or name == "fromCharCode"

fn _get_obj_id(v: JsValue) -> i64:
    match v:
        JsValue.Object(id): id
        JsValue.Array(id): id
        JsValue.Function(id): id
        _: -1

fn _get_fn_id(v: JsValue) -> i64:
    match v:
        JsValue.Function(id): id
        _: -1

fn f64_to_i64(n: f64) -> i64:
    if n != n:
        return 0
    val s = "{n}"
    val slen = s.byte_len()
    if slen == 0 or s == "inf" or s == "Infinity" or s == "-inf" or s == "-Infinity":
        return 0
    var i = 0
    var neg = false
    if s.byte_at(0) == 45:
        neg = true
        i = 1
    var out: i64 = 0
    while i < slen:
        val b = s.byte_at(i)
        if b == 46:
            i = slen
        elif b == 101 or b == 69:
            return n.to_i64()
        else:
            val d = _digit_val(b)
            if d >= 0:
                out = out * 10 + d
        i = i + 1
    if neg:
        return 0 - out
    out

fn _js_is_ws_byte(b: i64) -> bool:
    b == 32 or b == 9 or b == 10 or b == 13

fn js_parse_int_str(raw: text, has_radix: bool, radix_arg: f64) -> f64:
    val slen = raw.byte_len()
    var i = 0
    while i < slen and _js_is_ws_byte(raw.byte_at(i)):
        i = i + 1
    if i >= slen:
        return js_nan()
    var neg = false
    val sign_b = raw.byte_at(i)
    if sign_b == 45:
        neg = true
        i = i + 1
    elif sign_b == 43:
        i = i + 1
    var radix: i64 = 10
    if has_radix:
        radix = f64_to_i64(radix_arg)
        if radix == 0:
            radix = 10
    if (not has_radix or radix == 16) and i + 1 < slen and raw.byte_at(i) == 48:
        val next_b = raw.byte_at(i + 1)
        if next_b == 120 or next_b == 88:
            radix = 16
            i = i + 2
    if radix < 2 or radix > 36:
        return js_nan()
    var acc: i64 = 0
    var count = 0
    while i < slen:
        val d = _digit_val(raw.byte_at(i))
        if d < 0 or d >= radix:
            break
        acc = acc * radix + d
        count = count + 1
        i = i + 1
    if count == 0:
        return js_nan()
    val res = acc.to_f64()
    if neg:
        return 0.0 - res
    res

fn js_parse_float_str(raw: text) -> f64:
    val slen = raw.byte_len()
    var i = 0
    while i < slen and _js_is_ws_byte(raw.byte_at(i)):
        i = i + 1
    if i >= slen:
        return js_nan()
    val start = i
    val sb = raw.byte_at(i)
    if sb == 45 or sb == 43:
        i = i + 1
    var digits = 0
    while i < slen and raw.byte_at(i) >= 48 and raw.byte_at(i) <= 57:
        digits = digits + 1
        i = i + 1
    if i < slen and raw.byte_at(i) == 46:
        i = i + 1
        while i < slen and raw.byte_at(i) >= 48 and raw.byte_at(i) <= 57:
            digits = digits + 1
            i = i + 1
    if digits == 0:
        return js_nan()
    if i < slen and (raw.byte_at(i) == 101 or raw.byte_at(i) == 69):
        val exp_save = i
        i = i + 1
        if i < slen and (raw.byte_at(i) == 45 or raw.byte_at(i) == 43):
            i = i + 1
        var exp_digits = 0
        while i < slen and raw.byte_at(i) >= 48 and raw.byte_at(i) <= 57:
            exp_digits = exp_digits + 1
            i = i + 1
        if exp_digits == 0:
            i = exp_save
    val slice = raw.slice(start, i)
    if val Some(n) = slice.parse_f64():
        return n
    js_nan()

fn _digit_val(ch: i64) -> i64:
    if ch >= 48 and ch <= 57:
        return ch - 48
    if ch >= 65 and ch <= 90:
        return ch - 55
    if ch >= 97 and ch <= 122:
        return ch - 87
    -1

fn js_math_floor(x: f64) -> f64:
    if x != x:
        return js_nan()
    val iv: i64 = f64_to_i64(x)
    val fv: f64 = iv.to_f64()
    if x < 0.0 and fv != x:
        return fv - 1.0
    return fv

fn js_math_ceil(x: f64) -> f64:
    if x != x:
        return js_nan()
    return 0.0 - js_math_floor(0.0 - x)

fn js_math_round(x: f64) -> f64:
    if x != x:
        return js_nan()
    return js_math_floor(x + 0.5)

export RETURN_SIGNAL
export MAX_SCRIPT_EXECUTION_STEPS
export JS_HOST_DOM_MUTATION_MAX_RETAINED_OBJECTS
export JS_HOST_DOM_MUTATION_MAX_RETAINED_BYTES
export Environment, EnvironmentStack, CallFrame, JsFunction
export env_new, env_stack_new, call_frame_new
export to_number, js_to_string, to_boolean, is_truthy, typeof_value
export strict_equals, abstract_equals
export _is_array_method, _is_string_method, _get_obj_id, _get_fn_id, f64_to_i64, _digit_val
export js_parse_int_str, js_parse_float_str, js_math_floor, js_math_ceil, js_math_round
