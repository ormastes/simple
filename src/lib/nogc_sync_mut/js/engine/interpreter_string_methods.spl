# JsInterpreter — string method dispatch and function invocation.

use std.js.engine.js_error.{JsError, js_script_error, JsLogger, LogLevel, JsBrowserResult, JsBrowserError, js_nan, js_infinity, js_neg_infinity, is_nan}
use std.js.types.js_types.JsValue
use std.js.types.ast_types.JsExpression
use std.js.engine.interpreter_types.{Environment, EnvironmentStack, CallFrame, JsFunction, to_number, js_to_string, to_boolean, is_truthy, typeof_value, strict_equals, abstract_equals, RETURN_SIGNAL, _is_array_method, _is_string_method, _get_obj_id, _get_fn_id, f64_to_i64, _digit_val}
use std.js.engine.vm_object_store.{ObjectStore}
use std.nogc_sync_mut.js.engine.interpreter.{JsInterpreter}
use std.nogc_sync_mut.js.engine.interpreter_object.{JsInterpreter}
use common.js.engine.string_trim.{js_trim_text}
use std.js.builtins.regexp.{RegExpObj, regexp_exec}
use std.nogc_sync_mut.js.engine.interpreter_exec.{JsInterpreter}

impl JsInterpreter:
    # String method dispatch
    me _dispatch_string_method(str_val: text, method: text, args: [JsExpression], env: i64) -> JsBrowserResult<JsValue>:
        if method == "indexOf":
            if args.len() > 0:
                val search = self.eval_expression(args.get(0), env)?
                val search_str = js_to_string(search)
                val slen = str_val.len()
                val needle_len = search_str.len()
                if needle_len == 0:
                    return Ok(JsValue.Number(v: 0.0))
                var i = 0
                while i <= slen - needle_len:
                    var matched = true
                    var j = 0
                    while j < needle_len:
                        if str_val[i + j] != search_str[j]:
                            matched = false
                            j = needle_len
                        j = j + 1
                    if matched:
                        return Ok(JsValue.Number(v: i.to_f64()))
                    i = i + 1
            return Ok(JsValue.Number(v: -1.0))

        if method == "lastIndexOf":
            if args.len() > 0:
                val search = self.eval_expression(args.get(0), env)?
                val search_str = js_to_string(search)
                val slen = str_val.len()
                val needle_len = search_str.len()
                if needle_len == 0:
                    return Ok(JsValue.Number(v: slen.to_f64()))
                var last_found = -1
                var i = 0
                while i <= slen - needle_len:
                    var matched = true
                    var j = 0
                    while j < needle_len:
                        if str_val[i + j] != search_str[j]:
                            matched = false
                            j = needle_len
                        j = j + 1
                    if matched:
                        last_found = i
                    i = i + 1
                return Ok(JsValue.Number(v: last_found.to_f64()))
            return Ok(JsValue.Number(v: -1.0))

        if method == "toLowerCase":
            var result = ""
            val upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
            val lower = "abcdefghijklmnopqrstuvwxyz"
            var i = 0
            val slen = str_val.len()
            while i < slen:
                val ch = str_val[i]
                var found = -1
                var j = 0
                while j < 26:
                    if upper[j] == ch:
                        found = j
                        j = 26
                    j = j + 1
                if found >= 0:
                    result = result + lower[found]
                else:
                    result = result + ch
                i = i + 1
            return Ok(JsValue.String(v: result))

        if method == "toUpperCase":
            var result = ""
            val upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
            val lower = "abcdefghijklmnopqrstuvwxyz"
            var i = 0
            val slen = str_val.len()
            while i < slen:
                val ch = str_val[i]
                var found = -1
                var j = 0
                while j < 26:
                    if lower[j] == ch:
                        found = j
                        j = 26
                    j = j + 1
                if found >= 0:
                    result = result + upper[found]
                else:
                    result = result + ch
                i = i + 1
            return Ok(JsValue.String(v: result))

        if method == "trim":
            return Ok(JsValue.String(v: js_trim_text(str_val, true, true)))

        if method == "trimStart":
            return Ok(JsValue.String(v: js_trim_text(str_val, true, false)))

        if method == "trimEnd":
            return Ok(JsValue.String(v: js_trim_text(str_val, false, true)))

        if method == "split":
            var sep = ""
            if args.len() > 0:
                val sep_val = self.eval_expression(args.get(0), env)?
                sep = js_to_string(sep_val)
            val result_id = self.create_object()
            if sep == "":
                # Split each character
                var i = 0
                val slen = str_val.len()
                while i < slen:
                    self.set_object_property(result_id, "{i}", JsValue.String(v: str_val[i]))
                    i = i + 1
                self.set_object_property(result_id, "length", JsValue.Number(v: slen.to_f64()))
            else:
                # Split by separator
                var parts = 0
                var start = 0
                val slen = str_val.len()
                val sep_len = sep.len()
                var i = 0
                while i <= slen - sep_len:
                    var matched = true
                    var j = 0
                    while j < sep_len:
                        if str_val[i + j] != sep[j]:
                            matched = false
                            j = sep_len
                        j = j + 1
                    if matched:
                        var part = ""
                        var pi = start
                        while pi < i:
                            part = part + str_val[pi]
                            pi = pi + 1
                        self.set_object_property(result_id, "{parts}", JsValue.String(v: part))
                        parts = parts + 1
                        start = i + sep_len
                        i = start
                    else:
                        i = i + 1
                # Last part
                var last = ""
                var li = start
                while li < slen:
                    last = last + str_val[li]
                    li = li + 1
                self.set_object_property(result_id, "{parts}", JsValue.String(v: last))
                parts = parts + 1
                self.set_object_property(result_id, "length", JsValue.Number(v: parts.to_f64()))
            return Ok(JsValue.Array(id: result_id))

        if method == "slice" or method == "substring":
            var start = 0
            var end = str_val.len()
            if args.len() > 0:
                val s = self.eval_expression(args.get(0), env)?
                start = f64_to_i64(to_number(s))
                if start < 0:
                    start = str_val.len() + start
                    if start < 0:
                        start = 0
            if args.len() > 1:
                val e = self.eval_expression(args.get(1), env)?
                end = f64_to_i64(to_number(e))
                if end < 0:
                    end = str_val.len() + end
            if end > str_val.len():
                end = str_val.len()
            var result = ""
            var i = start
            while i < end:
                result = result + str_val[i]
                i = i + 1
            return Ok(JsValue.String(v: result))

        if method == "charAt":
            if args.len() > 0:
                val idx_val = self.eval_expression(args.get(0), env)?
                val idx = f64_to_i64(to_number(idx_val))
                if idx >= 0 and idx < str_val.len():
                    return Ok(JsValue.String(v: str_val[idx]))
            return Ok(JsValue.String(v: ""))

        if method == "charCodeAt":
            if args.len() > 0:
                val idx_val = self.eval_expression(args.get(0), env)?
                val idx = f64_to_i64(to_number(idx_val))
                if idx >= 0 and idx < str_val.len():
                    val ch = str_val[idx]
                    return Ok(JsValue.Number(v: ch.char_code_at(0).to_f64()))
            return Ok(JsValue.Number(v: js_nan()))

        if method == "startsWith":
            if args.len() > 0:
                val prefix_val = self.eval_expression(args.get(0), env)?
                val prefix = js_to_string(prefix_val)
                return Ok(JsValue.Boolean(v: str_val.starts_with(prefix)))
            return Ok(JsValue.Boolean(v: true))

        if method == "endsWith":
            if args.len() > 0:
                val suffix_val = self.eval_expression(args.get(0), env)?
                val suffix = js_to_string(suffix_val)
                return Ok(JsValue.Boolean(v: str_val.ends_with(suffix)))
            return Ok(JsValue.Boolean(v: true))

        if method == "includes":
            if args.len() > 0:
                val search_val = self.eval_expression(args.get(0), env)?
                val search_s = js_to_string(search_val)
                val slen = str_val.len()
                val needle_len = search_s.len()
                if needle_len == 0:
                    return Ok(JsValue.Boolean(v: true))
                var i = 0
                while i <= slen - needle_len:
                    var matched = true
                    var j = 0
                    while j < needle_len:
                        if str_val[i + j] != search_s[j]:
                            matched = false
                            j = needle_len
                        j = j + 1
                    if matched:
                        return Ok(JsValue.Boolean(v: true))
                    i = i + 1
            return Ok(JsValue.Boolean(v: false))

        if method == "replace":
            if args.len() >= 2:
                val search_val = self.eval_expression(args.get(0), env)?
                val replace_val = self.eval_expression(args.get(1), env)?
                match self._regexp_of(_get_obj_id(search_val)):
                    Some(re): return self._regexp_replace(str_val, re, replace_val, env)
                    nil: pass_dn
                val search_s = js_to_string(search_val)
                val slen = str_val.len()
                val needle_len = search_s.len()
                if needle_len == 0:
                    val head = self._replace_expand(replace_val, "", 0, str_val, env)?
                    return Ok(JsValue.String(v: head + str_val))
                var i = 0
                while i <= slen - needle_len:
                    var matched = true
                    var j = 0
                    while j < needle_len:
                        if str_val[i + j] != search_s[j]:
                            matched = false
                            j = needle_len
                        j = j + 1
                    if matched:
                        var result = ""
                        var bi = 0
                        while bi < i:
                            result = result + str_val[bi]
                            bi = bi + 1
                        result = result + self._replace_expand(replace_val, search_s, i, str_val, env)?
                        var ai = i + needle_len
                        while ai < slen:
                            result = result + str_val[ai]
                            ai = ai + 1
                        return Ok(JsValue.String(v: result))
                    i = i + 1
            return Ok(JsValue.String(v: str_val))

        if method == "match":
            if args.len() >= 1:
                val pat_val = self.eval_expression(args.get(0), env)?
                var re = RegExpObj.create(js_to_string(pat_val), "")
                match self._regexp_of(_get_obj_id(pat_val)):
                    Some(found): re = RegExpObj.create(found.source, found.flags)
                    nil: pass_dn
                var values: [JsValue] = []
                var first_index = 0
                var pos = 0
                while pos <= str_val.len():
                    re.last_index = pos
                    val m = regexp_exec(re, str_val)
                    if not m.matched:
                        break
                    values.push(JsValue.String(v: m.value))
                    first_index = m.index
                    if not re.global:
                        break
                    pos = m.index + (if m.value.len() == 0: 1 else: m.value.len())
                if values.len() == 0:
                    return Ok(JsValue.Null)
                val arr_id = self._js_array_from(values)
                if not re.global:
                    self.set_object_property(arr_id, "index", JsValue.Number(v: first_index.to_f64()))
                    self.set_object_property(arr_id, "input", JsValue.String(v: str_val))
                return Ok(JsValue.Array(id: arr_id))
            return Ok(JsValue.Null)

        if method == "replaceAll":
            if args.len() >= 2:
                val search_val = self.eval_expression(args.get(0), env)?
                val replace_val = self.eval_expression(args.get(1), env)?
                val search = js_to_string(search_val)
                val replace_str = js_to_string(replace_val)
                val slen = str_val.len()
                val needle_len = search.len()
                if needle_len == 0:
                    return Ok(JsValue.String(v: str_val))
                var result = ""
                var i = 0
                while i <= slen - needle_len:
                    var matched = true
                    var j = 0
                    while j < needle_len:
                        if str_val[i + j] != search[j]:
                            matched = false
                            j = needle_len
                        j = j + 1
                    if matched:
                        result = result + replace_str
                        i = i + needle_len
                    else:
                        result = result + str_val[i]
                        i = i + 1
                while i < slen:
                    result = result + str_val[i]
                    i = i + 1
                return Ok(JsValue.String(v: result))
            return Ok(JsValue.String(v: str_val))

        if method == "repeat":
            if args.len() > 0:
                val count_val = self.eval_expression(args.get(0), env)?
                val count = f64_to_i64(to_number(count_val))
                var result = ""
                var i = 0
                while i < count:
                    result = result + str_val
                    i = i + 1
                return Ok(JsValue.String(v: result))
            return Ok(JsValue.String(v: ""))

        if method == "padStart":
            if args.len() > 0:
                val target_len_val = self.eval_expression(args.get(0), env)?
                val target_len = f64_to_i64(to_number(target_len_val))
                var pad_str = " "
                if args.len() > 1:
                    val ps = self.eval_expression(args.get(1), env)?
                    pad_str = js_to_string(ps)
                if pad_str.len() == 0:
                    return Ok(JsValue.String(v: str_val))
                var result = ""
                val needed = target_len - str_val.len()
                var i = 0
                while i < needed:
                    result = result + pad_str[i % pad_str.len()]
                    i = i + 1
                result = result + str_val
                return Ok(JsValue.String(v: result))
            return Ok(JsValue.String(v: str_val))

        if method == "padEnd":
            if args.len() > 0:
                val target_len_val = self.eval_expression(args.get(0), env)?
                val target_len = f64_to_i64(to_number(target_len_val))
                var pad_str = " "
                if args.len() > 1:
                    val ps = self.eval_expression(args.get(1), env)?
                    pad_str = js_to_string(ps)
                if pad_str.len() == 0:
                    return Ok(JsValue.String(v: str_val))
                var result = str_val
                val needed = target_len - str_val.len()
                var i = 0
                while i < needed:
                    result = result + pad_str[i % pad_str.len()]
                    i = i + 1
                return Ok(JsValue.String(v: result))
            return Ok(JsValue.String(v: str_val))

        if method == "concat":
            var result = str_val
            var i = 0
            while i < args.len():
                val arg_val = self.eval_expression(args.get(i), env)?
                result = result + js_to_string(arg_val)
                i = i + 1
            return Ok(JsValue.String(v: result))

        if method == "at":
            if args.len() > 0:
                val idx_val = self.eval_expression(args.get(0), env)?
                var idx = f64_to_i64(to_number(idx_val))
                if idx < 0:
                    idx = str_val.len() + idx
                if idx >= 0 and idx < str_val.len():
                    return Ok(JsValue.String(v: str_val[idx]))
            return Ok(JsValue.Undefined)

        self.logger.warn("Unknown string method: {method}")
        Ok(JsValue.Undefined)

    # String.prototype.replace with a RegExp search value: every match when
    # the `g` flag is set, otherwise only the first.
    me _regexp_replace(input: text, re_in: RegExpObj, replace_val: JsValue, env: i64) -> JsBrowserResult<JsValue>:
        # Own the cursor: `last_index` is advanced per match, and mutating a
        # class argument in place is unreliable under the seed interpreter.
        var re = RegExpObj.create(re_in.source, re_in.flags)
        var result = ""
        var last = 0
        var pos = 0
        val n = input.len()
        while pos <= n:
            re.last_index = pos
            val m = regexp_exec(re, input)
            if not m.matched:
                break
            result = result + input.slice(last, m.index)
            result = result + self._replace_expand(replace_val, m.value, m.index, input, env)?
            last = m.index + m.value.len()
            if not re.global:
                break
            pos = if m.value.len() == 0: last + 1 else: last
        result = result + input.slice(last, n)
        Ok(JsValue.String(v: result))

    # Replacement text for one match: a function replacer is called with
    # (match, offset, string); a string replacer expands `$&` and `$$`.
    # Capture groups (`$1`) are not available — the regexp engine does not
    # record them.
    me _replace_expand(replace_val: JsValue, matched: text, index: i64, input: text, env: i64) -> JsBrowserResult<text>:
        match replace_val:
            JsValue.Function(fn_id):
                val call_args = [JsValue.String(v: matched), JsValue.Number(v: index.to_f64()), JsValue.String(v: input)]
                val r = self._invoke_function(fn_id, call_args, env)?
                return Ok(js_to_string(r))
            _: pass_dn
        val tmpl = js_to_string(replace_val)
        var out = ""
        var i = 0
        while i < tmpl.len():
            val ch = tmpl.slice(i, i + 1)
            val nx = if i + 1 < tmpl.len(): tmpl.slice(i + 1, i + 2) else: ""
            if ch == "$" and nx == "&":
                out = out + matched
                i = i + 2
            else if ch == "$" and nx == "$":
                out = out + "$"
                i = i + 2
            else:
                out = out + ch
                i = i + 1
        Ok(out)

    # Allocate a JS array holding `values`; returns its object id.
    me _js_array_from(values: [JsValue]) -> i64:
        val arr_id = self.create_object()
        var i = 0
        while i < values.len():
            self.set_object_property(arr_id, "{i}", values.get(i))
            i = i + 1
        self.set_object_property(arr_id, "length", JsValue.Number(v: values.len().to_f64()))
        arr_id

    # Invoke a JS function by id with the given argument values
    me _invoke_function(fn_id: i64, arg_vals: [JsValue], env: i64) -> JsBrowserResult<JsValue>:
        self._invoke_function_with_this(fn_id, arg_vals, env, JsValue.Undefined)

    me _invoke_function_with_this(fn_id: i64, arg_vals: [JsValue], env: i64, this_val: JsValue) -> JsBrowserResult<JsValue>:
        var bound_i = 0
        while bound_i < self.bound_function_ids.len():
            if self.bound_function_ids.get(bound_i) == fn_id:
                val target_id = self.bound_function_target_ids.get(bound_i)
                val bound_this = self.bound_function_this_values.get(bound_i)
                val bound_args_id = self.bound_function_arg_array_ids.get(bound_i)
                var combined_args: [JsValue] = []
                var stored_len = 0
                match self.get_object_property(bound_args_id, "length"):
                    JsValue.Number(v):
                        stored_len = f64_to_i64(v)
                    _:
                        pass_dn
                var stored_i = 0
                while stored_i < stored_len:
                    combined_args.push(self.get_object_property(bound_args_id, stored_i.to_text()))
                    stored_i = stored_i + 1
                var arg_i = 0
                while arg_i < arg_vals.len():
                    combined_args.push(arg_vals.get(arg_i))
                    arg_i = arg_i + 1
                return self._invoke_function_with_this(target_id, combined_args, env, bound_this)
            bound_i = bound_i + 1
        if fn_id < 0 or fn_id >= self.functions.len():
            return Ok(JsValue.Undefined)
        val js_fn = self.functions.get(fn_id)
        val params = js_fn.params
        val fn_env = self.env_stack.create_env(js_fn.closure_env)
        var pi = 0
        while pi < params.len():
            var pv = JsValue.Undefined
            if pi < arg_vals.len():
                pv = arg_vals.get(pi)
            self.env_stack.define_var(fn_env, params.get(pi), pv)
            pi = pi + 1
        val args_obj_id = self.create_object()
        var ai = 0
        while ai < arg_vals.len():
            self.set_object_property(args_obj_id, ai.to_text(), arg_vals.get(ai))
            ai = ai + 1
        self.set_object_property(args_obj_id, "length", JsValue.Number(v: arg_vals.len().to_f64()))
        self.env_stack.define_var(fn_env, "arguments", JsValue.Object(id: args_obj_id))
        self.env_stack.define_var(fn_env, "this", this_val)
        val frame = CallFrame(function_name: js_fn.name, env_id: fn_env, line: 0, this_value: this_val)
        self.call_stack.push(frame)
        val saved = self.control_return
        self.control_return = false
        var result = JsValue.Undefined
        var bi = 0
        while bi < js_fn.body.len():
            result = self.exec_statement(js_fn.body.get(bi), fn_env)?
            if self.control_return:
                result = self.return_value
                break
            bi = bi + 1
        self.call_stack.pop()
        self.control_return = saved
        Ok(result)

export use std.nogc_sync_mut.js.engine.interpreter.{JsInterpreter}
