# JS VM Object Store
# Manages the heap of JS objects and arrays by integer ID.

use std.js.types.js_types.{JsValue, JsObject, JsProperty}

class ObjectStore:
    next_id: i64
    prop_obj_ids: [i64]
    prop_ref_ids: [i64]
    prop_ref_tags: [i64]
    prop_keys: [text]
    prop_values: [JsValue]
    prop_enumerables: [bool]
    prop_configurables: [bool]
    obj_proto_ids: [i64]
    # Ids reclaimed by collect_unreachable(), reused by alloc_object() in LIFO
    # order so the object heap stops growing once garbage exists. Object ids
    # are never renumbered: every reference (property values, host bindings,
    # listener registries) stays valid across a collection.
    free_object_ids: [i64]
    # Lookup index over the flat property arrays: "{obj_id}:{key}" -> the
    # LAST slot holding that (obj_id, key), i.e. exactly what the backward
    # scans return. Entries [0, prop_slot_indexed) are indexed; appends are
    # folded in by sync_prop_slots(), and any shrink of the arrays (removal,
    # compaction) forces a full rebuild. find_prop_slot() only trusts the
    # index when it covers every slot, otherwise it falls back to the scan.
    prop_slot_index: Dict<text, i64>
    prop_slot_indexed: i64
    # "{obj_id}" -> every slot of that object, ascending (same order a
    # forward scan visits them). Maintained together with prop_slot_index.
    obj_slot_index: Dict<text, [i64]>

fn _prop_slot_key(obj_id: i64, key: text) -> text:
    # obj_id is an integer, so the first ':' always ends it: unambiguous.
    "{obj_id}:{key}"

impl ObjectStore:
    static fn create() -> ObjectStore:
        ObjectStore(
            next_id: 1,
            prop_obj_ids: [],
            prop_ref_ids: [],
            prop_ref_tags: [],
            prop_keys: [],
            prop_values: [],
            prop_enumerables: [],
            prop_configurables: [],
            obj_proto_ids: [],
            free_object_ids: [],
            prop_slot_index: {},
            prop_slot_indexed: 0,
            obj_slot_index: {}
        )

    me reindex_prop_slots():
        """Rebuild the slot index from scratch. Call after any operation that
        removes or reorders property slots (remove_property, compaction)."""
        self.prop_slot_index = {}
        self.obj_slot_index = {}
        self.prop_slot_indexed = 0
        self.sync_prop_slots()

    me sync_prop_slots():
        """Fold appended slots into the index; rebuild if slots were removed."""
        val n = self.prop_obj_ids.len()
        if n != self.prop_keys.len():
            return
        if n < self.prop_slot_indexed:
            self.prop_slot_index = {}
            self.obj_slot_index = {}
            self.prop_slot_indexed = 0
        var i = self.prop_slot_indexed
        while i < n:
            val obj_id = self.prop_obj_ids[i]
            self.prop_slot_index[_prop_slot_key(obj_id, self.prop_keys[i])] = i
            val obj_key = "{obj_id}"
            var slots: [i64] = self.obj_slot_index.get(obj_key) ?? []
            slots.push(i)
            self.obj_slot_index[obj_key] = slots
            i = i + 1
        self.prop_slot_indexed = n

    fn object_slots(obj_id: i64) -> [i64]:
        """Every slot of obj_id in ascending order (what a forward scan visits)."""
        val n = self.prop_obj_ids.len()
        if n == self.prop_slot_indexed and n == self.prop_keys.len():
            return self.obj_slot_index.get("{obj_id}") ?? []
        var slots: [i64] = []
        var i = 0
        while i < n:
            if self.prop_obj_ids[i] == obj_id:
                slots.push(i)
            i = i + 1
        slots

    fn find_prop_slot(obj_id: i64, key: text) -> i64:
        """Latest slot holding (obj_id, key), or -1. Same answer as a backward
        linear scan; O(1) when the index is in sync, the scan otherwise."""
        val n = self.prop_obj_ids.len()
        if n == self.prop_slot_indexed and n == self.prop_keys.len():
            val slot = self.prop_slot_index.get(_prop_slot_key(obj_id, key)) ?? -1
            if slot < 0:
                return -1
            if slot < n and self.prop_obj_ids[slot] == obj_id and self.prop_keys[slot] == key:
                return slot
        var i = n - 1
        while i >= 0:
            if self.prop_obj_ids[i] == obj_id and self.prop_keys[i] == key:
                return i
            i = i - 1
        -1

    me alloc_object() -> i64:
        if self.free_object_ids.len() > 0:
            val reused = self.free_object_ids.get(
                self.free_object_ids.len() - 1
            )
            self.free_object_ids.pop()
            self.obj_proto_ids[reused - 1] = -1
            return reused
        val id = self.next_id
        self.next_id = self.next_id + 1
        self.obj_proto_ids.push(-1)
        id

    me alloc_array() -> i64:
        self.alloc_object()

    # --- Reachability-based reclamation ---

    me collect_unreachable(root_obj_ids: [i64]) -> i64:
        """Reclaim objects proven unreachable from `root_obj_ids`.

        Marks roots and everything reachable through property values and
        prototype slots, then drops property slots of unmarked objects and
        recycles their ids through the free list. Object ids are never
        renumbered, so outstanding references to surviving objects stay
        valid. Must only be called at quiescence points (no dispatch or
        script execution in flight).
        """
        val object_count = self.obj_proto_ids.len()
        if object_count == 0:
            return 0
        self.sync_prop_slots()
        var marked: [bool] = []
        var fill = 0
        while fill < object_count:
            marked.push(false)
            fill = fill + 1
        var worklist: [i64] = []
        for root_id in root_obj_ids:
            if root_id >= 1 and root_id <= object_count:
                if not marked.get(root_id - 1):
                    marked[root_id - 1] = true
                    worklist.push(root_id)
        while worklist.len() > 0:
            val current = worklist.get(worklist.len() - 1)
            worklist.pop()
            val proto = self.obj_proto_ids.get(current - 1)
            if proto >= 1 and proto <= object_count:
                if not marked.get(proto - 1):
                    marked[proto - 1] = true
                    worklist.push(proto)
            for slot in self.object_slots(current):
                match self.prop_values.get(slot):
                    JsValue.Object(ref_id):
                        if ref_id >= 1 and ref_id <= object_count:
                            if not marked.get(ref_id - 1):
                                marked[ref_id - 1] = true
                                worklist.push(ref_id)
                    JsValue.Array(ref_id):
                        if ref_id >= 1 and ref_id <= object_count:
                            if not marked.get(ref_id - 1):
                                marked[ref_id - 1] = true
                                worklist.push(ref_id)
                    _:
                        pass_dn
        var reclaimed = 0
        var obj_id = 1
        while obj_id <= object_count:
            if not marked.get(obj_id - 1):
                self.obj_proto_ids[obj_id - 1] = -1
                self.free_object_ids.push(obj_id)
                reclaimed = reclaimed + 1
            obj_id = obj_id + 1
        if reclaimed == 0:
            return 0
        var keep_prop_obj_ids: [i64] = []
        var keep_prop_ref_ids: [i64] = []
        var keep_prop_ref_tags: [i64] = []
        var keep_prop_keys: [text] = []
        var keep_prop_values: [JsValue] = []
        var keep_prop_enumerables: [bool] = []
        var keep_prop_configurables: [bool] = []
        var slot_index = 0
        val total_slots = self.prop_obj_ids.len()
        while slot_index < total_slots:
            val owner = self.prop_obj_ids.get(slot_index)
            val owner_live = (
                owner >= 1 and owner <= object_count and
                marked.get(owner - 1)
            )
            if owner_live:
                keep_prop_obj_ids.push(self.prop_obj_ids.get(slot_index))
                keep_prop_ref_ids.push(self.prop_ref_ids.get(slot_index))
                keep_prop_ref_tags.push(self.prop_ref_tags.get(slot_index))
                keep_prop_keys.push(self.prop_keys.get(slot_index))
                keep_prop_values.push(self.prop_values.get(slot_index))
                keep_prop_enumerables.push(
                    self.prop_enumerables.get(slot_index)
                )
                keep_prop_configurables.push(
                    self.prop_configurables.get(slot_index)
                )
            slot_index = slot_index + 1
        self.prop_obj_ids = keep_prop_obj_ids
        self.prop_ref_ids = keep_prop_ref_ids
        self.prop_ref_tags = keep_prop_ref_tags
        self.prop_keys = keep_prop_keys
        self.prop_values = keep_prop_values
        self.prop_enumerables = keep_prop_enumerables
        self.prop_configurables = keep_prop_configurables
        self.reindex_prop_slots()
        reclaimed

    me get_object(id: i64) -> JsObject:
        var props: [JsProperty] = []
        for i in self.object_slots(id):
            props.push(JsProperty(
                key: self.prop_keys[i],
                value: self.prop_values[i],
                enumerable: self.prop_enumerables[i]
            ))
        JsObject(properties: props)

    me set_property(obj_id: i64, key: text, value: JsValue):
        var i = 0
        while i < self.prop_obj_ids.len():
            if self.prop_obj_ids[i] == obj_id and self.prop_keys[i] == key:
                self.prop_values[i] = value
                return
            i = i + 1
        self.prop_obj_ids.push(obj_id)
        self.prop_ref_ids.push(obj_id)
        self.prop_ref_tags.push(0)
        self.prop_keys.push(key)
        self.prop_values.push(value)
        self.prop_enumerables.push(true)
        self.prop_configurables.push(true)

    # Slot mutators for JsInterpreter.set_object_property. They exist because
    # the seed interpreter drops a nested `self.object_store.<array>.push(x)` /
    # `[i] = x` made from another class's `me` method (the array is read as a
    # copy), while a `me` call on the nested store mutates it in place.
    me update_slot(i: i64, value: JsValue):
        self.prop_values[i] = value
        self.prop_ref_tags[i] = 0
        self.prop_ref_ids[i] = 0

    me append_slot(obj_id: i64, key: text, value: JsValue):
        self.prop_obj_ids.push(obj_id)
        self.prop_keys.push(key)
        self.prop_values.push(value)
        self.prop_ref_tags.push(0)
        self.prop_ref_ids.push(obj_id)
        self.prop_enumerables.push(true)
        self.prop_configurables.push(true)

    me get_property(obj_id: i64, key: text) -> JsValue:
        # Writes append rather than update in place (see JsInterpreter.set_object_property),
        # so a property can have multiple entries with the latest appended last. Scan from
        # the end so host-side reads observe the most recent write — matching the
        # interpreter's own get_object_property (last-match-wins) semantics.
        val slot = self.find_prop_slot(obj_id, key)
        if slot >= 0:
            return self.prop_values[slot]
        JsValue.Undefined

    me remove_property(obj_id: i64, key: text):
        var i = self.prop_obj_ids.len() - 1
        while i >= 0:
            if self.prop_obj_ids[i] == obj_id and self.prop_keys[i] == key:
                self.prop_obj_ids.remove(i)
                self.prop_ref_ids.remove(i)
                self.prop_ref_tags.remove(i)
                self.prop_keys.remove(i)
                self.prop_values.remove(i)
                self.prop_enumerables.remove(i)
                self.prop_configurables.remove(i)
            i = i - 1
        self.reindex_prop_slots()

    me array_length(arr_id: i64) -> i64:
        var max_idx = -1
        var i = 0
        while i < self.prop_obj_ids.len():
            if self.prop_obj_ids[i] == arr_id:
                val k = self.prop_keys[i]
                val idx = k.parse_int() ?? -1
                if idx > max_idx:
                    max_idx = idx
            i = i + 1
        max_idx + 1

    me get_by_index(arr_id: i64, idx: i64) -> JsValue:
        self.get_property(arr_id, "{idx}")

    me set_by_index(arr_id: i64, idx: i64, value: JsValue):
        self.set_property(arr_id, "{idx}", value)

    me create_array_from(values: [JsValue]) -> i64:
        val id = self.alloc_array()
        var i = 0
        while i < values.len():
            self.set_by_index(id, i, values[i])
            i = i + 1
        id
