# Node.js os module — operating system info

use std.js.types.pair.{Pair}
use std.js.types.js_types.{JsValue}

use std.io_runtime.{env_get}

fn os_platform(args: [JsValue]) -> JsValue:
    JsValue.String(v: "simpleos")

fn os_arch(args: [JsValue]) -> JsValue:
    JsValue.String(v: "x86_64")

fn os_homedir(args: [JsValue]) -> JsValue:
    val home = env_get("HOME")
    if home != "" and home != nil:
        return JsValue.String(v: home)
    JsValue.String(v: "/root")

fn os_tmpdir(args: [JsValue]) -> JsValue:
    JsValue.String(v: "/tmp")

fn os_hostname(args: [JsValue]) -> JsValue:
    JsValue.String(v: "simpleos")

# `std.js.engine.interpreter_native` imports the full eight-helper node `os`
# surface from this tier module. The four below were missing, so every native
# link of a closure containing the JS engine resolved them as bare C externs
# and died with `undefined reference to os_type/os_release/os_endianness/os_eol`.
fn os_type(args: [JsValue]) -> JsValue:
    JsValue.String(v: "SimpleOS")

fn os_release(args: [JsValue]) -> JsValue:
    JsValue.String(v: "0.0.0-simple")

fn os_endianness(args: [JsValue]) -> JsValue:
    JsValue.String(v: "LE")

fn os_eol(args: [JsValue]) -> JsValue:
    JsValue.String(v: "\n")

fn create_os_module() -> [Pair<text, JsValue>]:
    var methods: [Pair<text, JsValue>] = []
    methods
