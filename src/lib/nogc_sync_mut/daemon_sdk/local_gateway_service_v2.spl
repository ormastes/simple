# One domain owner, two configured ingress lanes, no application/WAL imports.
use std.nogc_sync_mut.io.local_ipc_v1.*
use std.nogc_sync_mut.daemon_sdk.local_gateway_v1.*

pub enum LocalGatewayDispatchClassV2:
    ControlRead
    Work

pub struct LocalGatewayServiceConfigV2:
    work_path: text
    control_path: text
    service_uid: i64
    client_uid: i64
    work_connections: i64
    control_connections: i64
    request_timeout_ms: i64

pub struct LocalGatewayLaneV2:
    listener: LocalUnixListenerV1?
    connections: [LocalGatewayConnectionV1?]
    cursor: i64

pub struct LocalGatewayServiceV2<T>:
    owner: T
    config: LocalGatewayServiceConfigV2
    work: LocalGatewayLaneV2
    control: LocalGatewayLaneV2
    # 0 opening; 1 accepting; 2 stopping; 3 transport closed; 4 blocked open.
    phase: i64
    error: text

pub struct LocalGatewayServiceTurnV2<T>:
    service: LocalGatewayServiceV2<T>
    handled_control: i64
    handled_work: i64
    error: text

struct GatewayLaneTurnV2<T>:
    owner: T
    lane: LocalGatewayLaneV2
    handled: bool
    error: text

struct GatewayLaneCloseV2:
    lane: LocalGatewayLaneV2
    closed: bool
    error: text

fn gateway_lane_v2(capacity: i64) -> LocalGatewayLaneV2:
    var connections: [LocalGatewayConnectionV1?] = []
    for index in 0..capacity: connections = connections.push(nil)
    LocalGatewayLaneV2(listener: nil, connections: connections, cursor: 0)

# The returned service always retains the domain and every acquired listener,
# including a partially failed open. Native listen independently verifies EUID.
pub fn local_gateway_service_open_v2<T>(owner: T, config: LocalGatewayServiceConfigV2) -> LocalGatewayServiceV2<T>:
    var service = LocalGatewayServiceV2(owner: owner, config: config,
        work: gateway_lane_v2(0), control: gateway_lane_v2(0), phase: 4, error: "gateway-service-config")
    if (config.work_path == config.control_path or config.work_path == "" or config.control_path == "" or
            config.service_uid < 0 or config.client_uid < 0 or config.service_uid == config.client_uid or
            config.work_connections < 1 or config.work_connections > 16 or
            config.control_connections < 1 or config.control_connections > 4 or
            config.request_timeout_ms < 1 or config.request_timeout_ms > 30000):
        return service
    service.work = gateway_lane_v2(config.work_connections)
    service.control = gateway_lane_v2(config.control_connections)
    # Control opens first; ordinary admission cannot consume its listener slot.
    val control = local_unix_listen_v1(config.control_path, config.service_uid, config.control_connections)
    service.control.listener = control.owner
    if control.error != "" or control.owner == nil:
        service.error = if control.error == "": "gateway-control-listener-unavailable" else: control.error
        return service
    val work = local_unix_listen_v1(config.work_path, config.service_uid, config.work_connections)
    service.work.listener = work.owner
    if work.error != "" or work.owner == nil:
        service.error = if work.error == "": "gateway-work-listener-unavailable" else: work.error
        return service
    service.phase = 1
    service.error = ""
    service

fn gateway_refuse_v2<T>(owner: T, request: LocalGatewayRequestV1) -> LocalGatewayOwnedResponseV1<T>:
    LocalGatewayOwnedResponseV1(owner, LocalGatewayResponseV1(request.request_id, 77, "gateway-request-refused"))

fn gateway_control_refuse_v2<T>(owner: T, request: LocalGatewayRequestV1) -> LocalGatewayOwnedResponseV1<T>:
    LocalGatewayOwnedResponseV1(owner, LocalGatewayResponseV1(request.request_id, 75, "gateway-control-port-refused"))

fn gateway_lane_step_v2<T>(owner: T, lane: LocalGatewayLaneV2, config: LocalGatewayServiceConfigV2,
        control_only: bool,
        classify: fn(T, LocalGatewayRequestV1) -> Result<LocalGatewayDispatchClassV2, text>,
        handler: fn(T, LocalGatewayRequestV1) -> LocalGatewayOwnedResponseV1<T>) -> GatewayLaneTurnV2<T>:
    var current = lane
    var current_owner = owner
    if current.connections.len() == 0 or current.listener == nil:
        return GatewayLaneTurnV2(current_owner, current, false, "gateway-lane-unavailable")
    if current.cursor < 0 or current.cursor >= current.connections.len():
        return GatewayLaneTurnV2(current_owner, current, false, "gateway-lane-cursor")
    val index = current.cursor
    current.cursor = (current.cursor + 1) % current.connections.len()
    if current.connections[index] == nil:
        val accepted = local_gateway_accept_v1(current.listener.unwrap(), config.client_uid, config.request_timeout_ms)
        current.listener = Some(accepted.listener)
        current.connections[index] = accepted.connection
        val error = if accepted.error == "local_unix_would_block" or accepted.error == "local_unix_busy": "" else: accepted.error
        return GatewayLaneTurnV2(current_owner, current, false, error)
    var connection = current.connections[index].unwrap()
    var handled = false
    var error = ""
    if connection.phase == 0 or connection.phase == 1 or connection.phase == 5:
        val received = local_gateway_receive_v2(connection)
        connection = received.connection
        error = received.error
        if received.request != nil:
            val request = received.request.unwrap()
            match classify(current_owner, request):
                case Err(reason):
                    val refused = local_gateway_dispatch_owned_v2(current_owner, connection, gateway_refuse_v2)
                    current_owner = refused.owner
                    connection = refused.connection
                    error = if refused.error == "": reason else: refused.error
                case Ok(kind):
                    if control_only and kind != LocalGatewayDispatchClassV2.ControlRead:
                        val refused = local_gateway_dispatch_owned_v2(current_owner, connection, gateway_control_refuse_v2)
                        current_owner = refused.owner
                        connection = refused.connection
                        error = refused.error
                    else:
                        val dispatched = local_gateway_dispatch_owned_v2(current_owner, connection, handler)
                        current_owner = dispatched.owner
                        connection = dispatched.connection
                        handled = dispatched.handled
                        error = dispatched.error
    elif connection.phase == 2:
        val published = local_gateway_publish_v2(connection)
        connection = published.connection
        error = published.error
    elif connection.phase == 4 and connection.response != nil:
        # The caller must account for a failed publication before explicitly
        # disposing its response/possibly staged byte descriptor. Never turn a
        # send failure into an implicit retry or discard of the domain owner.
        error = connection.error
    else:
        # Closed/blocked request slots are reusable only after native disposal.
        # A failed receipt or retained close owner continues occupying its slot.
        val closed = local_unix_close_v1(connection.native)
        if closed.owner != nil:
            connection.native = closed.owner.unwrap()
        if closed.closed and closed.owner == nil:
            current.connections[index] = nil
            return GatewayLaneTurnV2(current_owner, current, false, closed.error)
        error = if closed.error == "": "gateway-connection-close-unconfirmed" else: closed.error
    current.connections[index] = Some(connection)
    GatewayLaneTurnV2(current_owner, current, handled, error)

# Explicit transport-only disposal after the domain has retained its outcome.
# The expected native generation token prevents a stale slot selector from
# disposing a later connection. No native process or WAL authority is released.
pub fn local_gateway_service_discard_failed_v2<T>(service: LocalGatewayServiceV2<T>,
        control_lane: bool, slot_index: i64, expected_connection_token: i64) -> LocalGatewayServiceTurnV2<T>:
    var current = service
    var lane = if control_lane: current.control else: current.work
    if slot_index < 0 or slot_index >= lane.connections.len() or expected_connection_token <= 0:
        return LocalGatewayServiceTurnV2(current, 0, 0, "gateway-failed-selector")
    if lane.connections[slot_index] == nil:
        return LocalGatewayServiceTurnV2(current, 0, 0, "gateway-failed-selector")
    var connection = lane.connections[slot_index].unwrap()
    if (connection.native.token != expected_connection_token or connection.phase != 4 or
            connection.response == nil):
        return LocalGatewayServiceTurnV2(current, 0, 0, "gateway-failed-selector")
    val closed = local_unix_close_v1(connection.native)
    if closed.closed and closed.owner == nil:
        lane.connections[slot_index] = nil
    elif closed.owner != nil:
        connection.native = closed.owner.unwrap()
        lane.connections[slot_index] = Some(connection)
    if control_lane: current.control = lane
    else: current.work = lane
    val error = if not closed.closed and closed.error == "": "gateway-connection-close-unconfirmed" else: closed.error
    LocalGatewayServiceTurnV2(current, 0, 0, error)

# One bounded turn visits every reserved control slot before one ordinary slot.
# Classifier/handler must themselves be bounded and domain-owned. This does not
# turn synchronous provider probes or WAL IO into asynchronous jobs.
pub fn local_gateway_service_turn_v2<T>(service: LocalGatewayServiceV2<T>,
        classify: fn(T, LocalGatewayRequestV1) -> Result<LocalGatewayDispatchClassV2, text>,
        handler: fn(T, LocalGatewayRequestV1) -> LocalGatewayOwnedResponseV1<T>) -> LocalGatewayServiceTurnV2<T>:
    var current = service
    if current.phase != 1: return LocalGatewayServiceTurnV2(current, 0, 0, current.error)
    var control_handled = 0
    var error = ""
    for index in 0..current.control.connections.len():
        val control = gateway_lane_step_v2(current.owner, current.control, current.config, true, classify, handler)
        current.owner = control.owner
        current.control = control.lane
        if control.handled: control_handled = control_handled + 1
        if control.error != "": error = control.error
    val work = gateway_lane_step_v2(current.owner, current.work, current.config, false, classify, handler)
    current.owner = work.owner
    current.work = work.lane
    if work.error != "": error = work.error
    LocalGatewayServiceTurnV2(current, control_handled, if work.handled: 1 else: 0, error)

fn gateway_lane_close_v2(lane: LocalGatewayLaneV2) -> GatewayLaneCloseV2:
    var current = lane
    var complete = true
    var error = ""
    if current.listener != nil:
        val closed = local_unix_listener_close_v1(current.listener.unwrap())
        current.listener = closed.owner
        if not closed.closed or closed.owner != nil: complete = false
        if closed.error != "": error = closed.error
    for index in 0..current.connections.len():
        if current.connections[index] != nil:
            var connection = current.connections[index].unwrap()
            val closed = local_unix_close_v1(connection.native)
            if closed.closed and closed.owner == nil:
                current.connections[index] = nil
            else:
                complete = false
                if closed.owner != nil: connection.native = closed.owner.unwrap()
                current.connections[index] = Some(connection)
            if closed.error != "": error = closed.error
    GatewayLaneCloseV2(current, complete, error)

# Stops admission immediately and attempts exact transport cleanup only. The
# returned service still owns T; Host must separately close its canonical WAL
# and native jobs. Phase3 means transport handles consumed, not domain release.
pub fn local_gateway_service_stop_v2<T>(service: LocalGatewayServiceV2<T>) -> LocalGatewayServiceTurnV2<T>:
    var current = service
    if current.phase == 3: return LocalGatewayServiceTurnV2(current, 0, 0, current.error)
    current.phase = 2
    val control = gateway_lane_close_v2(current.control)
    current.control = control.lane
    val work = gateway_lane_close_v2(current.work)
    current.work = work.lane
    if control.error != "": current.error = control.error
    if work.error != "": current.error = work.error
    if control.closed and work.closed: current.phase = 3
    LocalGatewayServiceTurnV2(current, 0, 0, current.error)
