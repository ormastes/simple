# Daemon SDK Runner — Generic daemon poll loop with request dispatch
#
# Provides a composable daemon runner that handles lock acquisition,
# directory setup, poll cycles, and request dispatch via callback.


use std.daemon_sdk.types.{
    DaemonConfig, DaemonState, DaemonRequest, DaemonResponse,
    daemon_state_new, daemon_response_new,
    DAEMON_IDLE, DAEMON_POLLING, DAEMON_PROCESSING, DAEMON_SHUTTING_DOWN,
    DAEMON_PUBLICATION_BLOCKED, DAEMON_ACKNOWLEDGEMENT_BLOCKED
}
use std.daemon_sdk.lock.{
    DaemonLockReceiptV1, try_acquire_daemon_lock_owned, release_daemon_lock_owned
}
use std.daemon_sdk.protocol.{
    read_daemon_requests, write_daemon_response, acknowledge_processed_requests,
    clear_old_responses
}

use std.io_runtime.{mkdir_p}
use std.io_runtime.{time_now_unix_micros}
use std.io_runtime.{thread_sleep}

# ============================================================================
# Daemon Runner
# ============================================================================

# A handler returns the domain owner before the runner publishes its response.
# Callers must retain the owner returned by run_poll_cycle_owned_v1.
struct DaemonOwnedResponseV1<T>:
    owner: T
    response: DaemonResponse

class DaemonRunner:
    config: DaemonConfig
    state: DaemonState
    lock_pid: i64
    lock_receipt: DaemonLockReceiptV1
    running: bool

impl DaemonRunner:
    fn is_running() -> bool:
        self.running

    fn get_state() -> DaemonState:
        self.state

    fn get_config() -> DaemonConfig:
        self.config

    # --- Poll cycle: read requests, dispatch to handler, write responses ---

    me run_poll_cycle(handler: fn(DaemonRequest) -> DaemonResponse):
        # Compatibility adapter captures only the immutable handler. Mutable
        # domain owners are explicit arguments/results of the shared core.
        val ignored = self.run_poll_cycle_owned_v1(0i64, \state, request:
            DaemonOwnedResponseV1(owner: state, response: handler(request)))

    me run_poll_cycle_owned_v1<T>(owner: T,
            handler: fn(T, DaemonRequest) -> DaemonOwnedResponseV1<T>) -> T:
        var current_owner = owner
        if not self.running:
            return current_owner

        self.state.status = DAEMON_POLLING
        self.state.last_poll_time = time_now_unix_micros()

        val requests = read_daemon_requests(self.config.request_dir)
        if requests.len() == 0:
            self.state.cycle_count = self.state.cycle_count + 1
            self.state.status = DAEMON_IDLE
            return current_owner

        self.state.status = DAEMON_PROCESSING

        var processed_ids: [text] = []
        var count = 0
        var i = 0
        while i < requests.len() and count < self.config.max_concurrent:
            val req = requests[i]
            val handled = handler(current_owner, req)
            # Retain effects in the domain owner even when publication or
            # acknowledgement subsequently fails and stops the runner.
            current_owner = handled.owner
            val resp = handled.response
            if resp.request_id != req.id or not write_daemon_response(resp, self.config.response_dir):
                # V1 has no durable execution ledger: retain the unacknowledged
                # request and stop rather than re-run its handler next poll.
                # Recovery requires the domain owner; a restart is not proof
                # that the effect did not happen. Remote work uses V2 operations.
                self.state.errors_count = self.state.errors_count + 1
                self.state.status = DAEMON_PUBLICATION_BLOCKED
                self.running = false
                break
            processed_ids.push(req.id)
            count = count + 1
            i = i + 1

        if not acknowledge_processed_requests(self.config.request_dir, processed_ids):
            self.state.errors_count = self.state.errors_count + 1
            self.state.status = DAEMON_ACKNOWLEDGEMENT_BLOCKED
            self.running = false
        self.state.items_processed = self.state.items_processed + count
        self.state.cycle_count = self.state.cycle_count + 1
        if self.running:
            self.state.status = DAEMON_IDLE
        current_owner

    # --- Main loop: poll + sleep + periodic cleanup ---

    me run_loop(handler: fn(DaemonRequest) -> DaemonResponse):
        while self.running:
            self.run_poll_cycle(handler)
            if not self.running:
                break
            # Periodic response cleanup every 100 cycles
            if self.state.cycle_count % 100 == 0:
                val max_age_ms = self.config.request_timeout_ms * 10
                clear_old_responses(self.config.response_dir, max_age_ms)
            thread_sleep(self.config.poll_interval_ms)

    # --- Shutdown ---

    me shutdown():
        self.running = false
        self.state.status = DAEMON_SHUTTING_DOWN
        release_daemon_lock_owned(self.lock_receipt)

# ============================================================================
# Factory
# ============================================================================

fn daemon_runner_start(config: DaemonConfig) -> DaemonRunner:
    mkdir_p(config.request_dir)
    mkdir_p(config.response_dir)

    val receipt = try_acquire_daemon_lock_owned(config.lock_path)

    DaemonRunner(
        config: config,
        state: daemon_state_new(),
        lock_pid: receipt.pid,
        lock_receipt: receipt,
        running: receipt.acquired
    )
