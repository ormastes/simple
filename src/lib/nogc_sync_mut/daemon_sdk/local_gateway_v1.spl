# One request per connection, explicit owner writeback, bounded zero-wait IO.
# This layer transports metadata only. Domain handlers must verify installed
# peer policy and application grants; a kernel UID alone grants no operation.
use std.common.string_core.str_len
use std.common.text_bytes.{boxed_text_bytes_checked, utf8_bytes_valid}
use std.nogc_sync_mut.io.time_ops.time_sample_monotonic_nanos_or_failure
use std.nogc_sync_mut.io.local_ipc_v1.*
use std.nogc_sync_mut.io.process_ops.PipedProcessRefV1
use std.nogc_sync_mut.daemon_sdk.local_gateway_protocol_v1.*
use std.nogc_sync_mut.daemon_sdk.local_gateway_frame_v1.*

pub struct LocalGatewayRequestV1:
    action: text
    operation_id: text
    payload: text
    peer_uid: i64
    request_id: text

pub struct LocalGatewayResponseV1:
    request_id: text
    exit_code: i64
    payload: text
    output_handoff: LocalGatewayOutputHandoffV1? = nil

# Internal-only descriptor staging request. The domain keeps its full process
# owner and journal authority. Metadata is encoded by the domain's common
# contract; the SDK never turns it into an application grant or cleanup proof.
pub struct LocalGatewayOutputHandoffV1:
    source: PipedProcessRefV1
    binding_digest: text
    metadata: text

pub struct LocalGatewayOwnedResponseV1<T>:
    owner: T
    response: LocalGatewayResponseV1

pub struct LocalGatewayConnectionV1:
    native: LocalUnixConnectionV1
    expected_peer_uid: i64
    deadline_monotonic_ms: i64
    reader: LocalGatewayFrameReaderV1?
    # 0 receive; 1 require input EOF; 2 send; 3 complete; 4 blocked; 5 ready.
    phase: i64
    response: LocalGatewayResponseV1?
    reply_prefix: [u8]
    reply_header: [u8]
    reply_payload: [u8]
    reply_part: i64
    reply_offset: i64
    error: text
    ready_request: LocalGatewayRequestV1? = nil

pub struct LocalGatewayReceiveTurnV2:
    connection: LocalGatewayConnectionV1
    request: LocalGatewayRequestV1?
    error: text

pub struct LocalGatewayConnectionTurnV2:
    connection: LocalGatewayConnectionV1
    error: text

pub struct LocalGatewayAcceptTurnV1:
    listener: LocalUnixListenerV1
    connection: LocalGatewayConnectionV1?
    error: text

pub struct LocalGatewayOwnedTurnV1<T>:
    owner: T
    connection: LocalGatewayConnectionV1
    handled: bool
    error: text

pub fn local_gateway_accept_v1(listener: LocalUnixListenerV1, expected_client_uid: i64,
        timeout_ms: i64) -> LocalGatewayAcceptTurnV1:
    if timeout_ms <= 0 or timeout_ms > 30000:
        return LocalGatewayAcceptTurnV1(listener: listener, connection: nil, error: "gateway-timeout-bound")
    val accepted = local_unix_accept_v1(listener, expected_client_uid)
    if accepted.connection == nil:
        return LocalGatewayAcceptTurnV1(listener: accepted.listener, connection: nil, error: accepted.error)
    var connection = LocalGatewayConnectionV1(native: accepted.connection.unwrap(),
        expected_peer_uid: expected_client_uid, deadline_monotonic_ms: 0, reader: nil, phase: 4,
        response: nil, reply_prefix: [], reply_header: [], reply_payload: [], reply_part: 0,
        reply_offset: 0, error: accepted.error)
    if accepted.error != "":
        return LocalGatewayAcceptTurnV1(accepted.listener, Some(connection), accepted.error)
    val now = time_sample_monotonic_nanos_or_failure()
    if now < 0:
        connection.error = "gateway-clock-unavailable"
        return LocalGatewayAcceptTurnV1(accepted.listener, Some(connection), connection.error)
    connection.deadline_monotonic_ms = now / 1000000 + timeout_ms
    connection.reader = match local_gateway_frame_reader_v1(false):
        case Ok(value): Some(value)
        case Err(reason):
            connection.error = reason
            return LocalGatewayAcceptTurnV1(accepted.listener, Some(connection), reason)
    connection.phase = 0
    LocalGatewayAcceptTurnV1(accepted.listener, Some(connection), "")

fn gateway_waiting_v1(error: text) -> bool:
    error == "local_unix_would_block" or error == "local_unix_busy"

# Deadline checks do not consume dispatch or discard a retained response.
fn gateway_check_deadline_v2(connection: LocalGatewayConnectionV1) -> LocalGatewayConnectionV1:
    var current = connection
    if current.phase == 3 or current.phase == 4: return current
    val now = time_sample_monotonic_nanos_or_failure()
    if now < 0 or now / 1000000 >= current.deadline_monotonic_ms:
        current.phase = 4
        current.error = if now < 0: "gateway-clock-unavailable" else: "gateway-timeout"
    current

fn gateway_ready_request_v2(connection: LocalGatewayConnectionV1) -> LocalGatewayRequestV1?:
    if connection.phase == 5: connection.ready_request else: nil

# Advances at most one receive chunk and verifies actual EOF/peer identity.
# A ready request is scheduling metadata, not application authorization. No
# handler, one-use dispatch claim, descriptor staging or reply write occurs.
pub fn local_gateway_receive_v2(connection: LocalGatewayConnectionV1) -> LocalGatewayReceiveTurnV2:
    var current = gateway_check_deadline_v2(connection)
    if current.phase != 0 and current.phase != 1:
        return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
    if current.phase <= 1:
        # Avoid allocating a maximum-sized read receipt for idle connections.
        # Read still handles readiness races as would-block, never by waiting.
        val ready = local_unix_poll_v1(current.native, true, false)
        current.native = ready.owner
        if ready.error != "":
            if not gateway_waiting_v1(ready.error):
                current.phase = 4
                current.error = ready.error
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
        if not ready.readable and not ready.hangup:
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), "")
    if current.phase == 0:
        if current.reader == nil:
            current.phase = 4
            current.error = "gateway-frame-owner-missing"
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
        var reader = current.reader.unwrap()
        val received = local_unix_read_now_v1(current.native, reader.read_limit())
        current.native = received.owner
        if received.bytes.len() > 0:
            match reader.feed(received.bytes):
                case Ok(_): ()
                case Err(reason):
                    current.phase = 4
                    current.error = reason
        if received.eof and not reader.complete():
            val rejected = reader.end_of_stream()
            current.phase = 4
            current.error = reader.error
        current.reader = Some(reader)
        if received.error != "" and not gateway_waiting_v1(received.error):
            current.phase = 4
            current.error = received.error
        if current.phase != 4 and reader.complete(): current.phase = 1
        return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
    if current.phase == 1:
        # Actual EOF is the frame boundary. A timeout or empty would-block is
        # never an EOF proof; any trailing byte blocks dispatch permanently.
        val trailing = local_unix_read_now_v1(current.native, 1)
        current.native = trailing.owner
        if trailing.bytes.len() > 0:
            current.phase = 4
            current.error = "gateway-frame-trailing-data"
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
        if trailing.error != "":
            if not gateway_waiting_v1(trailing.error):
                current.phase = 4
                current.error = trailing.error
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
        if not trailing.eof: return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), "")
        val peer = local_unix_peer_v1(current.native)
        current.native = peer.owner
        if peer.error != "" or peer.peer == nil:
            if not gateway_waiting_v1(peer.error):
                current.phase = 4
                current.error = if peer.error == "": "gateway-peer-unavailable" else: peer.error
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
        if peer.peer.unwrap().uid != current.expected_peer_uid:
            current.phase = 4
            current.error = "gateway-peer-mismatch"
            return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)
        if current.reader == nil or current.reader.unwrap().header == nil:
            current.phase = 4
            current.error = "gateway-frame-owner-missing"
            return LocalGatewayReceiveTurnV2(current, nil, current.error)
        val reader = current.reader.unwrap()
        val header = reader.header.unwrap()
        val payload = match local_gateway_payload_decode_v1(header, reader.payload):
            case Ok(value): value
            case Err(reason):
                current.phase = 4
                current.error = reason
                return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), reason)
        current.ready_request = Some(LocalGatewayRequestV1(action: header.action,
            operation_id: header.operation_id, payload: payload, peer_uid: peer.peer.unwrap().uid,
            request_id: header.request_id))
        current.phase = 5
        return LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), "")
    LocalGatewayReceiveTurnV2(current, gateway_ready_request_v2(current), current.error)

# Dispatches only an EOF-validated ready connection. The native claim still
# consumes exactly once across copied local connection values. The domain
# verifies its installed peer policy and grants; scheduling is not authority.
pub fn local_gateway_dispatch_owned_v2<T>(owner: T, connection: LocalGatewayConnectionV1,
        handler: fn(T, LocalGatewayRequestV1) -> LocalGatewayOwnedResponseV1<T>) -> LocalGatewayOwnedTurnV1<T>:
    var current = gateway_check_deadline_v2(connection)
    var current_owner = owner
    var handled = false
    if current.phase == 3 or current.phase == 4:
        return LocalGatewayOwnedTurnV1(current_owner, current, false, current.error)
    if current.phase != 5 or current.ready_request == nil:
        return LocalGatewayOwnedTurnV1(current_owner, current, false, "gateway-request-not-ready")
    val request = current.ready_request.unwrap()
    val peer = local_unix_peer_v1(current.native)
    current.native = peer.owner
    if peer.error != "" or peer.peer == nil:
        if not gateway_waiting_v1(peer.error):
            current.phase = 4
            current.error = if peer.error == "": "gateway-peer-unavailable" else: peer.error
        return LocalGatewayOwnedTurnV1(current_owner, current, false, current.error)
    if peer.peer.unwrap().uid != current.expected_peer_uid or request.peer_uid != current.expected_peer_uid:
        current.phase = 4
        current.error = "gateway-peer-mismatch"
        return LocalGatewayOwnedTurnV1(current_owner, current, false, current.error)
    # Native connection phase consumes dispatch once even if a local caller
    # copied this completed reader. The domain still verifies its operation
    # journal and grants; connection consumption is not application authority.
    val claim = local_unix_claim_request_v1(current.native, request.request_id)
    current.native = claim.owner
    if claim.error != "" or not claim.claimed:
        if not gateway_waiting_v1(claim.error):
            current.phase = 4
            current.error = if claim.error == "": "gateway-request-not-claimed" else: claim.error
        return LocalGatewayOwnedTurnV1(current_owner, current, false, current.error)
    val result = handler(current_owner, request)
    # Writeback happens before any fallible response encoding or IO.
    current_owner = result.owner
    current.ready_request = nil
    current.response = Some(result.response)
    current.phase = 4
    handled = true
    if result.response.request_id != request.request_id:
        current.error = "gateway-response-correlation"
        return LocalGatewayOwnedTurnV1(current_owner, current, handled, current.error)
    val response_header = LocalGatewayHeaderV1(response: true, request_id: request.request_id,
        action: "", operation_id: "", exit_code: result.response.exit_code,
        payload_bytes: str_len(result.response.payload),
        handoff_metadata: if result.response.output_handoff == nil: "" else: result.response.output_handoff.unwrap().metadata)
    val encoded = match local_gateway_header_encode_v1(response_header):
        case Ok(value): value
        case Err(reason):
            current.error = reason
            return LocalGatewayOwnedTurnV1(current_owner, current, handled, reason)
    current.reply_payload = match boxed_text_bytes_checked(result.response.payload):
        case Ok(value): value
        case Err(_):
            current.error = "gateway-response-allocation"
            return LocalGatewayOwnedTurnV1(current_owner, current, handled, current.error)
    if not utf8_bytes_valid(current.reply_payload):
        current.error = "gateway-response-utf8"
        return LocalGatewayOwnedTurnV1(current_owner, current, handled, current.error)
    current.reply_header = match boxed_text_bytes_checked(encoded):
        case Ok(value): value
        case Err(_):
            current.error = "gateway-response-allocation"
            return LocalGatewayOwnedTurnV1(current_owner, current, handled, current.error)
    current.reply_prefix = match local_gateway_prefix_encode_v1(response_header):
        case Ok(value): value
        case Err(reason):
            current.error = reason
            return LocalGatewayOwnedTurnV1(current_owner, current, handled, reason)
    if result.response.output_handoff != nil:
        val handoff = result.response.output_handoff.unwrap()
        val staged = local_unix_stage_stdout_v1(current.native, handoff.source, handoff.binding_digest)
        current.native = staged.owner
        if staged.error != "" or not staged.staged:
            current.error = if staged.error == "": "gateway-handoff-not-staged" else: staged.error
            return LocalGatewayOwnedTurnV1(current_owner, current, handled, current.error)
    current.phase = 2
    return LocalGatewayOwnedTurnV1(current_owner, current, handled, "")

# Advances at most one reply chunk/half-close. This cannot invoke a handler or
# repeat descriptor staging, including after a prior publication failure.
pub fn local_gateway_publish_v2(connection: LocalGatewayConnectionV1) -> LocalGatewayConnectionTurnV2:
    var current = gateway_check_deadline_v2(connection)
    if current.phase == 3 or current.phase == 4:
        return LocalGatewayConnectionTurnV2(current, current.error)
    if current.phase != 2:
        return LocalGatewayConnectionTurnV2(current, "gateway-response-not-ready")
    val bytes = match current.reply_part:
        case 0: current.reply_prefix
        case 1: current.reply_header
        case _: current.reply_payload
    if current.reply_offset == bytes.len():
        if current.reply_part == 2:
            val shutdown = local_unix_shutdown_write_v1(current.native)
            current.native = shutdown.owner
            if shutdown.error != "" or not shutdown.shutdown:
                if not gateway_waiting_v1(shutdown.error):
                    current.phase = 4
                    current.error = if shutdown.error == "": "gateway-response-shutdown" else: shutdown.error
                return LocalGatewayConnectionTurnV2(current, current.error)
        current.reply_offset = 0
        current.reply_part = current.reply_part + 1
        if current.reply_part > 2: current.phase = 3
        return LocalGatewayConnectionTurnV2(current, "")
    val remaining = bytes.len() - current.reply_offset
    val maximum = if remaining > 65536: 65536 else: remaining
    val ready = local_unix_poll_v1(current.native, false, true)
    current.native = ready.owner
    if ready.error != "":
        if not gateway_waiting_v1(ready.error):
            current.phase = 4
            current.error = ready.error
        return LocalGatewayConnectionTurnV2(current, current.error)
    if not ready.writable and not ready.hangup:
        return LocalGatewayConnectionTurnV2(current, "")
    val sent = local_unix_write_some_now_v1(current.native, bytes, current.reply_offset, maximum)
    current.native = sent.owner
    current.reply_offset = current.reply_offset + sent.accepted_bytes
    if sent.error != "" and not gateway_waiting_v1(sent.error):
        current.phase = 4
        current.error = sent.error
    LocalGatewayConnectionTurnV2(current, current.error)

# Compatibility turn delegates to the same receive/claim/publication core.
# Owner writeback remains before every fallible response operation.
pub fn local_gateway_turn_owned_v1<T>(owner: T, connection: LocalGatewayConnectionV1,
        handler: fn(T, LocalGatewayRequestV1) -> LocalGatewayOwnedResponseV1<T>) -> LocalGatewayOwnedTurnV1<T>:
    var current = connection
    if current.phase == 0 or current.phase == 1:
        val received = local_gateway_receive_v2(current)
        current = received.connection
        if current.phase != 5:
            return LocalGatewayOwnedTurnV1(owner, current, false, received.error)
    if current.phase == 5:
        return local_gateway_dispatch_owned_v2(owner, current, handler)
    if current.phase == 2:
        val published = local_gateway_publish_v2(current)
        return LocalGatewayOwnedTurnV1(owner, published.connection, false, published.error)
    LocalGatewayOwnedTurnV1(owner, current, false, current.error)
