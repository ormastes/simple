# HTTP Response Writer — Lightweight Embedded Web Server
#
# Part of std.nogc_sync_mut.http_server
# Full standalone example: examples/06_io/simple_web_server/
# Design: doc/05_design/simple_web_server_lib_api.md

use std.nogc_sync_mut.io.tcp.{TcpStream}
use std.nogc_sync_mut.http_server.types.{
    HttpResponse, HttpStatus, http_status_code, http_status_reason
}
use std.common.base_encoding.{text_to_bytes}

fn write_response(stream: TcpStream, resp: HttpResponse) -> bool:
    _write_response_wire(stream, serialize_response(resp))

# Canonical bounded writer used by the production listener.  It builds at
# most one complete wire response and then uses write_all, so an oversized
# application response is never truncated into a syntactically valid prefix.
# The fallback is generated through the same serializer and carries the same
# baseline security headers as every other server-owned error.
fn write_response_limited(stream: TcpStream, resp: HttpResponse, max_response_bytes: i64) -> bool:
    val wire = bounded_response_wire(resp, max_response_bytes)
    if wire == "":
        return false
    _write_response_wire(stream, wire)

fn _write_response_wire(stream: TcpStream, wire: text) -> bool:
    match stream.write_all(text_to_bytes(wire)):
        Ok(_):
            return true
        Err(_):
            return false

# Apply baseline browser hardening on the canonical response path. Existing
# application choices win, so this never emits ambiguous duplicate headers.
# HSTS is emitted only after an encrypted transport has actually succeeded.
fn with_default_security_headers(resp: HttpResponse, tls_active: bool) -> HttpResponse:
    var result = resp
    result = _header_default(result, "Content-Security-Policy", "default-src 'self'; object-src 'none'; frame-ancestors 'none'")
    result = _header_default(result, "X-Content-Type-Options", "nosniff")
    result = _header_default(result, "X-Frame-Options", "DENY")
    result = _header_default(result, "Referrer-Policy", "no-referrer")
    if tls_active:
        result = _header_default(result, "Strict-Transport-Security", "max-age=31536000; includeSubDomains")
    result

fn _header_default(resp: HttpResponse, name: text, value: text) -> HttpResponse:
    for pair in resp.headers:
        if pair.0.to_lower() == name.to_lower() and _application_header_is_safe(pair.0, pair.1):
            return resp
    resp.with_header(name, value)

# Response framing belongs to the server writer, never to application code.
# Dropping an unsafe pair keeps the emitted response parseable while the
# canonical Content-Length and Connection fields below remain authoritative.
fn _header_name_is_token(name: text) -> bool:
    if name == "":
        return false
    for ch in name.chars():
        val code = ch.code_point()
        val alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
        val digit = code >= 48 and code <= 57
        val symbol = (
            code == 33 or code == 35 or code == 36 or code == 37 or
            code == 38 or code == 39 or code == 42 or code == 43 or
            code == 45 or code == 46 or code == 94 or code == 95 or
            code == 96 or code == 124 or code == 126
        )
        if not alpha and not digit and not symbol:
            return false
    true

fn _header_value_is_safe(value: text) -> bool:
    for ch in value.chars():
        val code = ch.code_point()
        if code < 32 or code == 127:
            return false
    true

# Shared lexical policy for HTTP/1.1 and HTTP/2 response writers. Protocol
# owners still reject their own hop-by-hop/framing fields after this check.
fn response_header_name_is_token(name: text) -> bool:
    _header_name_is_token(name)

fn response_header_value_is_safe(value: text) -> bool:
    _header_value_is_safe(value)

fn _application_header_is_safe(name: text, value: text) -> bool:
    if not _header_name_is_token(name) or not _header_value_is_safe(value):
        return false
    val normalized = name.to_lower()
    normalized != "content-length" and normalized != "transfer-encoding" and normalized != "connection"

fn _serialize_response_head(resp: HttpResponse) -> text:
    val status_code = http_status_code(resp.status)
    val reason = http_status_reason(resp.status)
    val body_len = resp.body.len()

    var wire = "HTTP/1.1 {status_code} {reason}\r\n"
    wire = "{wire}Content-Length: {body_len}\r\n"
    wire = "{wire}Connection: close\r\n"

    var has_content_type = false
    for pair in resp.headers:
        if _application_header_is_safe(pair.0, pair.1):
            wire = "{wire}{pair.0}: {pair.1}\r\n"
            if pair.0.to_lower() == "content-type":
                has_content_type = true

    if not has_content_type:
        wire = "{wire}Content-Type: text/plain; charset=utf-8\r\n"

    wire = "{wire}\r\n"
    return wire

fn serialize_response(resp: HttpResponse) -> text:
    "{_serialize_response_head(resp)}{resp.body}"

fn response_wire_size(resp: HttpResponse) -> i64:
    _serialize_response_head(resp).len() + resp.body.len()

fn response_wire_fits(resp: HttpResponse, max_response_bytes: i64) -> bool:
    max_response_bytes > 0 and response_wire_size(resp) <= max_response_bytes

# Returns one complete response or an empty string.  The empty result means
# even the fixed, security-hardened 500 response does not fit; callers close
# the connection without emitting a partial response.
fn bounded_response_wire(resp: HttpResponse, max_response_bytes: i64) -> text:
    if response_wire_fits(resp, max_response_bytes):
        return serialize_response(resp)
    val fallback = with_default_security_headers(
        HttpResponse.error(HttpStatus.InternalError, "response exceeds configured byte limit"),
        false
    )
    if response_wire_fits(fallback, max_response_bytes):
        return serialize_response(fallback)
    ""

fn write_error(stream: TcpStream, status: HttpStatus, message: text) -> bool:
    val resp = with_default_security_headers(HttpResponse.error(status, message), false)
    write_response(stream, resp)

fn write_error_limited(stream: TcpStream, status: HttpStatus, message: text, max_response_bytes: i64) -> bool:
    val resp = with_default_security_headers(HttpResponse.error(status, message), false)
    write_response_limited(stream, resp, max_response_bytes)

# =============================================================================
# Error Page Generation
# =============================================================================

fn generate_error_page(status_code: i32, reason: text, message: text) -> text:
    var html = "<!DOCTYPE html>\n<html>\n<head>\n"
    html = "{html}<title>{status_code} {reason}</title>\n"
    html = "{html}<style>body{open_brace()}font-family:sans-serif;margin:40px;color:#333{close_brace()}"
    html = "{html}h1{open_brace()}color:#c00{close_brace()}</style>\n"
    html = "{html}</head>\n<body>\n"
    html = "{html}<h1>{status_code} {reason}</h1>\n"
    html = "{html}<p>{message}</p>\n"
    html = "{html}</body>\n</html>"
    return html

fn open_brace() -> text:
    return "{"

fn close_brace() -> text:
    return "}"

fn html_not_found_page(path: text) -> HttpResponse:
    val body = generate_error_page(404, "Not Found", "The requested path '{path}' was not found.")
    HttpResponse(
        status: HttpStatus.NotFound,
        headers: [("Content-Type", "text/html; charset=utf-8")],
        body: body
    )

fn html_error_page(status: HttpStatus, message: text) -> HttpResponse:
    val code = http_status_code(status)
    val reason = http_status_reason(status)
    val body = generate_error_page(code, reason, message)
    HttpResponse(
        status: status,
        headers: [("Content-Type", "text/html; charset=utf-8")],
        body: body
    )

export write_response, write_response_limited, write_error, write_error_limited
export serialize_response, response_wire_size, response_wire_fits, bounded_response_wire
export with_default_security_headers
export response_header_name_is_token, response_header_value_is_safe
export generate_error_page, html_not_found_page, html_error_page
