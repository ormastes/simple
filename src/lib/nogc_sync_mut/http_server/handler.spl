# HTTP Server Handler Module
# Request parsing and handling utilities

use nogc_sync_mut.http.url.{url_encode, url_decode}
use std.common.text_bytes.{text_to_utf8_bytes}
use std.nogc_sync_mut.io.external_text_io.{io_legacy_utf8}

# =============================================================================
# Request Parsing
# =============================================================================

# Parse HTTP request line: "GET /path HTTP/1.1"
fn parse_request_line(line: text) -> list:
    var parts = line.split(" ")
    var method = ""
    var path = "/"
    var version = "HTTP/1.1"

    if parts.length() >= 1:
        method = parts[0]
    if parts.length() >= 2:
        path = parts[1]
    if parts.length() >= 3:
        version = parts[2]

    [method, path, version]

# Parse header line: "Content-Type: application/json"
fn parse_header(line: text) -> list:
    var name = ""
    var value = ""

    var colon_idx = line.index_of(":")
    if colon_idx > 0:
        name = line.substring(0, colon_idx).trim().lower()
        var rest_start = colon_idx + 1
        value = line.substring(rest_start, line.byte_len()).trim()

    [name, value]

# Extract query string from path: "/api/users?page=1&limit=10"
fn extract_query_string(path: text) -> list:
    var clean_path = path
    var query = ""

    var question_idx = path.index_of("?")
    if question_idx >= 0:
        clean_path = path.substring(0, question_idx)
        var query_start = question_idx + 1
        query = path.substring(query_start, path.byte_len())

    [clean_path, query]

# Parse query parameters: "page=1&limit=10&sort=name"
# Returns list of [key, value] pairs
fn parse_query_params(query: text) -> list:
    var params = []

    if query.length() == 0:
        return params

    var pairs = query.split("&")
    var i = 0
    while i < pairs.length():
        var pair = pairs[i]
        var eq_idx = pair.index_of("=")

        if eq_idx > 0:
            var key = pair.substring(0, eq_idx)
            var vstart = eq_idx + 1
            var value = pair.substring(vstart, pair.byte_len())
            var decoded_key = url_decode(key)
            var decoded_value = url_decode(value)
            params.append([decoded_key, decoded_value])

        i = i + 1

    params

# =============================================================================
# Request Validation
# =============================================================================

# Validate HTTP method
fn is_valid_method(method: text) -> bool:
    var valid = false

    if method == "GET":
        valid = true
    if method == "POST":
        valid = true
    if method == "PUT":
        valid = true
    if method == "DELETE":
        valid = true
    if method == "PATCH":
        valid = true
    if method == "HEAD":
        valid = true
    if method == "OPTIONS":
        valid = true
    if method == "TRACE":
        valid = true
    if method == "CONNECT":
        valid = true

    valid

# Validate Content-Type for method
fn requires_content_type(method: text) -> bool:
    var needs_content = false

    if method == "POST":
        needs_content = true
    if method == "PUT":
        needs_content = true
    if method == "PATCH":
        needs_content = true

    needs_content

# =============================================================================
# Multipart Form Data Parsing
# =============================================================================

# Multipart boundary from a Content-Type header: case-insensitive `boundary=`
# parameter, quoted or bare; "" when absent.
fn parse_multipart_boundary(content_type: text) -> text:
    header_param(content_type, "boundary")

# Parse form field from multipart part
fn parse_form_field(part: text) -> list:
    var name = ""
    var value = ""

    var lines = part.split("\r\n")
    var in_headers = true
    var body_lines = []

    var i = 0
    while i < lines.length():
        var line = lines[i]

        if in_headers:
            if line.length() == 0:
                in_headers = false

            var has_disposition = line.starts_with("Content-Disposition:")
            if has_disposition:
                var name_idx = line.index_of("name=\"")
                if name_idx >= 0:
                    var name_start = name_idx + 6
                    var name_end = line.index_of("\"", name_start)
                    if name_end > name_start:
                        name = line.substring(name_start, name_end)

        if in_headers == false:
            if line.length() > 0:
                body_lines.append(line)

        i = i + 1

    value = body_lines.join("\n")
    [name, value]

# =============================================================================
# Cookie Handling
# =============================================================================

# Parse cookie header: "session=abc123; theme=dark"
fn parse_cookies(cookie_header: text) -> list:
    var cookies = []

    if cookie_header.length() == 0:
        return cookies

    var pairs = cookie_header.split(";")
    var i = 0
    while i < pairs.length():
        var pair = pairs[i].trim()
        var eq_idx = pair.index_of("=")

        if eq_idx > 0:
            var name = pair.substring(0, eq_idx)
            var vstart = eq_idx + 1
            var value = pair.substring(vstart, pair.byte_len())
            cookies.append([name, value])

        i = i + 1

    cookies

# Create Set-Cookie header value
fn create_cookie(name: text, value: text, max_age: i64, path: text, http_only: bool) -> text:
    var cookie = "{name}={value}"

    if max_age > 0:
        cookie = cookie + "; Max-Age={max_age}"

    if path.length() > 0:
        cookie = cookie + "; Path={path}"

    if http_only:
        cookie = cookie + "; HttpOnly"

    cookie

# =============================================================================
# Session Management
# =============================================================================

# Generate session ID (simple implementation)
fn generate_session_id(timestamp: i64, random_seed: i64) -> text:
    var combined = timestamp * 1000 + random_seed
    var id_str = combined.to_string()
    "session_{id_str}"

# Create session: [id, data, expires]
fn create_session(session_id: text, expires: i64) -> list:
    var data = []
    [session_id, data, expires]

# Add data to session
fn session_add_data(session: list, key: text, value: text) -> list:
    var session_id = session[0]
    var data = session[1]
    var expires = session[2]

    var new_data = data
    new_data.append([key, value])

    [session_id, new_data, expires]

# Get data from session
fn session_get_data(session: list, key: text) -> text:
    var data = session[1]
    var result = ""

    var i = 0
    while i < data.length():
        var pair = data[i]
        var data_key = pair[0]
        var data_value = pair[1]

        if data_key == key:
            result = data_value
            break

        i = i + 1

    result

# Check if session is expired
fn is_session_expired(session: list, current_time: i64) -> bool:
    var expires = session[2]
    current_time >= expires

# =============================================================================
# Authentication Utilities
# =============================================================================

# Parse Basic Auth header: "Basic dXNlcjpwYXNz"
fn parse_basic_auth(auth_header: text) -> list:
    var username = ""
    var password = ""

    var basic_prefix = "Basic "
    if auth_header.starts_with(basic_prefix):
        var encoded_start = basic_prefix.length()
        var encoded = auth_header.substring(encoded_start, auth_header.byte_len())
        var decoded = base64_decode_simple(encoded)
        var colon_idx = decoded.index_of(":")

        if colon_idx > 0:
            username = decoded.substring(0, colon_idx)
            var pass_start = colon_idx + 1
            password = decoded.substring(pass_start, decoded.byte_len())


    [username, password]

# Parse Bearer token: "Bearer abc123xyz"
fn parse_bearer_token(auth_header: text) -> text:
    var token = ""

    var bearer_prefix = "Bearer "
    if auth_header.starts_with(bearer_prefix):
        var token_start = bearer_prefix.length()
        token = auth_header.substring(token_start, auth_header.byte_len())

    token

# Simple base64 decode (limited character set)
fn base64_decode_simple(encoded: text) -> text:
    var result = encoded
    result

# =============================================================================
# Binary multipart/form-data (raw request bytes)
# =============================================================================

# One multipart part; `data` is the raw part body (binary-safe).
pub struct MultipartPart:
    name: text
    filename: text
    content_type: text
    data: [u8]

# `;`-separated `key=value` parameters of a header value (quote-aware, so a
# `;` inside "..." stays in the value). Keys are lower-cased; quoted values are
# unquoted; a segment without `=` (the media type itself) is skipped.
fn header_params(value: text) -> [(text, text)]:
    var segments: [text] = []
    var current = ""
    var quoted = false
    for ch in value.chars():
        if ch == "\"":
            quoted = not quoted
            current = current + ch
        elif ch == ";" and not quoted:
            segments.push(current)
            current = ""
        else:
            current = current + ch
    segments.push(current)
    var params: [(text, text)] = []
    for segment in segments:
        var key = ""
        var raw = ""
        var seen_eq = false
        for ch in segment.chars():
            if seen_eq:
                raw = raw + ch
            elif ch == "=":
                seen_eq = true
            else:
                key = key + ch
        if not seen_eq:
            continue
        var item = raw.trim()
        val count = item.chars().len()
        if count >= 2 and item.starts_with("\"") and item.ends_with("\""):
            var inner = ""
            var index = 0
            for ch in item.chars():
                if index > 0 and index < count - 1:
                    inner = inner + ch
                index = index + 1
            item = inner
        params.push((key.trim().to_lower(), item))
    params

fn header_param(value: text, key: text) -> text:
    val wanted = key.to_lower()
    for pair in header_params(value):
        if pair.0 == wanted:
            return pair.1
    ""

fn _multipart_find(hay: [u8], needle: [u8], from: i64) -> i64:
    val n = needle.len()
    if n == 0:
        return -1
    val first = needle[0]
    var i = from
    val last = hay.len() - n
    while i <= last:
        if hay[i] == first:
            var k = 1
            while k < n and hay[i + k] == needle[k]:
                k = k + 1
            if k == n:
                return i
        i = i + 1
    -1

# Just past a delimiter line (`--B` + transport padding + CRLF) whose boundary
# text ends at `at`; -2 for the close delimiter (`--B--`); -1 when the bytes
# at `at` do not finish a delimiter line.
fn _multipart_delimiter_end(body: [u8], at: i64) -> i64:
    var cursor = at
    if cursor + 2 <= body.len() and body[cursor] == 45 and body[cursor + 1] == 45:
        return -2
    while cursor < body.len() and (body[cursor] == 32 or body[cursor] == 9):
        cursor = cursor + 1
    if cursor + 2 <= body.len() and body[cursor] == 13 and body[cursor + 1] == 10:
        return cursor + 2
    -1

# Next line-anchored delimiter (`CRLF--B` then `--`, padding or CRLF) at or
# after `from`; the position of its CRLF, or -1.
fn _multipart_next_delimiter(body: [u8], crlf_dash_boundary: [u8], from: i64) -> i64:
    var at = from
    while true:
        val found = _multipart_find(body, crlf_dash_boundary, at)
        if found < 0:
            return -1
        if _multipart_delimiter_end(body, found + crlf_dash_boundary.len()) != -1:
            return found
        at = found + 1
    -1

# Cap on one part's header block (octets between its delimiter line and the
# blank line that ends it).
val MULTIPART_PART_HEADER_LIMIT: i64 = 16384

# Split a multipart/form-data body (HttpRequest.body_bytes) into parts whose
# data stays raw bytes, so binary uploads (wav, png) survive unchanged.
pub fn parse_multipart_bytes(body: [u8], content_type: text) -> Result<[MultipartPart], text>:
    val boundary = parse_multipart_boundary(content_type)
    if boundary == "":
        return Err("multipart: missing boundary")
    val dash_boundary = text_to_utf8_bytes("--{boundary}")
    val crlf_dash_boundary = text_to_utf8_bytes("\r\n--{boundary}")
    val header_end = text_to_utf8_bytes("\r\n\r\n")
    # The first delimiter starts the body or a line; any preamble is ignored.
    # _multipart_next_delimiter only returns real delimiter lines, so from
    # here on cursor is a part start (>= 0) or the close delimiter (-2).
    var cursor: i64 = -1
    if _multipart_find(body, dash_boundary, 0) == 0:
        cursor = _multipart_delimiter_end(body, dash_boundary.len())
    if cursor == -1:
        val found = _multipart_next_delimiter(body, crlf_dash_boundary, 0)
        if found < 0:
            return Err("multipart: boundary not found")
        cursor = _multipart_delimiter_end(body, found + crlf_dash_boundary.len())
    var parts: [MultipartPart] = []
    while cursor != -2:
        # A delimiter line right after a delimiter line: an empty part.
        if _multipart_find(body, dash_boundary, cursor) == cursor:
            val next = _multipart_delimiter_end(body, cursor + dash_boundary.len())
            if next != -1:
                parts.push(MultipartPart(name: "", filename: "", content_type: "", data: []))
                cursor = next
                continue
        var header_text = ""
        var data_start: i64 = 0
        var data_stop: i64 = 0
        if cursor + 2 <= body.len() and body[cursor] == 13 and body[cursor + 1] == 10:
            # Empty header block: the part starts with its blank line. With an
            # empty body that CRLF is also the next delimiter's CRLF.
            data_stop = _multipart_next_delimiter(body, crlf_dash_boundary, cursor)
            if data_stop < 0:
                return Err("multipart: missing closing boundary")
            data_start = if data_stop == cursor: cursor else: cursor + 2
        else:
            val headers_stop = _multipart_find(body, header_end, cursor)
            if headers_stop < 0:
                return Err("multipart: unterminated part headers")
            if headers_stop - cursor > MULTIPART_PART_HEADER_LIMIT:
                return Err("multipart: part header block exceeds {MULTIPART_PART_HEADER_LIMIT} bytes")
            val inner = _multipart_next_delimiter(body, crlf_dash_boundary, cursor)
            if inner >= 0 and inner < headers_stop:
                return Err("multipart: part header block contains the boundary")
            header_text = match io_legacy_utf8(body.slice(cursor, headers_stop)):
                Ok(value): value
                Err(_): return Err("multipart: part headers are not UTF-8")
            data_start = headers_stop + header_end.len()
            # An empty body leaves the delimiter's CRLF right at data_start.
            data_stop = _multipart_next_delimiter(body, crlf_dash_boundary, data_start)
            if data_stop < 0:
                return Err("multipart: missing closing boundary")
        var name = ""
        var filename = ""
        var part_type = ""
        for line in header_text.split("\r\n"):
            val colon = line.index_of(":")
            if colon <= 0:
                continue
            val field_name = line.slice(0, colon).trim().to_lower()
            val field_value = line.slice(colon + 1, line.byte_len())
            if field_name == "content-disposition":
                name = header_param(field_value, "name")
                filename = header_param(field_value, "filename")
            elif field_name == "content-type":
                part_type = field_value.trim()
        parts.push(MultipartPart(name: name, filename: filename, content_type: part_type,
            data: body.slice(data_start, data_stop)))
        cursor = _multipart_delimiter_end(body, data_stop + crlf_dash_boundary.len())
    Ok(parts)
