# HTTP Request Parser — Lightweight Embedded Web Server
#
# Part of std.nogc_sync_mut.http_server
# Full standalone example: examples/06_io/simple_web_server/
# Design: doc/05_design/simple_web_server_lib_api.md

use std.nogc_sync_mut.io.tcp.{TcpStream}
use std.nogc_sync_mut.http_server.types.{
    HttpRequest, HttpMethod, http_method_from_text
}
# Shared protocol core — single source of truth for limits and header policy
# across the sync and async servers (see src/lib/common/net/http_core.spl).
# `export use` so existing importers of this module keep seeing the limit
# constants and content_length_from_text at their historical path.
export use std.common.net.http_core.{
    MAX_REQUEST_LINE, MAX_HEADER_COUNT, MAX_HEADER_LINE, MAX_BODY_SIZE,
    content_length_from_text, body_decision
}

# The native `read_line` API uses a 4096-byte buffer (4095 payload bytes plus
# its terminator). It stops at that boundary even
# when no newline was found, silently returning a truncated line that is
# indistinguishable from a short one by length alone — so a `> max` length
# check can never fire for such input (see
# doc/08_tracking/bug/lab_http_parser_oversized_header_line_silently_truncated_not_rejected_2026-08-07.md).
# The truncation signature IS detectable here: `read_line()` returns the line
# INCLUDING its terminating newline, so a raw line that is >= the runtime cap
# and does NOT end in "\n" was cut mid-line and must be rejected, not parsed.
val RUNTIME_READ_LINE_CAP: i32 = 4096

fn line_truncated_by_runtime(raw: text) -> bool:
    (raw.len() >= RUNTIME_READ_LINE_CAP - 1 and not raw.ends_with("\n"))

# =============================================================================
# Public API
# =============================================================================

fn parse_request(stream: TcpStream) -> Result<HttpRequest, text>:
    return parse_request_with_policy_limits(stream, MAX_REQUEST_LINE, MAX_HEADER_COUNT, MAX_HEADER_LINE, MAX_BODY_SIZE, MAX_HEADER_COUNT + 1)

# parse_request_with_limits parses an HTTP/1.x request from `stream` enforcing
# caller-supplied limits.  Returns Err with a descriptive message on any
# violation so the caller can send a 400/413/431 response.
#
# max_read_iters caps the number of header read_line calls so that a slow
# client cannot hold the handler thread indefinitely (AC-4).
fn parse_request_with_limits(stream: TcpStream, max_request_line: i32, max_header_count: i32, max_header_line: i32, max_body: i32) -> Result<HttpRequest, text>:
    return parse_request_with_policy_limits(stream, max_request_line, max_header_count, max_header_line, max_body, max_header_count + 1)

fn parse_request_with_policy_limits(stream: TcpStream, max_request_line: i32, max_header_count: i32, max_header_line: i32, max_body: i32, max_read_iters: i32) -> Result<HttpRequest, text>:
    match stream.read_line():
        Err(e):
            return Err("Failed to read request line: {e}")
        Ok(request_line):
            # Reject a runtime-truncated (no-newline, at-cap) request line —
            # the `> max_request_line` check below can never see it.
            if line_truncated_by_runtime(request_line):
                return Err("431 Request line too long: truncated at {RUNTIME_READ_LINE_CAP} bytes without a newline")
            if not request_line.ends_with("\n"):
                return Err("400 Incomplete request line")
            val line = request_line_without_terminator(request_line)
            if line == "":
                return Err("Empty request line")

            # Count the request-line payload exactly. Trimming first would let
            # leading/trailing whitespace evade the configured byte bound.
            if line.len() > max_request_line:
                return Err("431 Request line too long: {line.len()} bytes")

            val parsed = parse_request_line(line)
            val method_str = parsed.0
            val raw_path = parsed.1
            val version = parsed.2

            if method_str == "" or raw_path == "" or not _method_supported(method_str):
                return Err("Malformed request line: {line}")
            if version != "HTTP/1.1" and version != "HTTP/1.0":
                return Err("Unsupported HTTP version: {version}")

            val method = http_method_from_text(method_str)

            var path = raw_path
            var query = ""
            val qmark = raw_path.index_of("?")
            if qmark >= 0:
                path = raw_path.slice(0, qmark)
                query = raw_path.slice(qmark + 1, raw_path.len())

            var headers: [(text, text)] = []
            var header_count: i32 = 0
            var read_iters: i32 = 0
            loop:
                read_iters = read_iters + 1
                if read_iters > max_read_iters:
                    return Err("408 Request header read iteration limit exceeded")
                match stream.read_line():
                    Ok(header_line):
                        # Reject a runtime-truncated (no-newline, at-cap)
                        # header line — the `> max_header_line` check below is
                        # structurally unreachable for it (the runtime already
                        # cut the line to exactly the cap).
                        if line_truncated_by_runtime(header_line):
                            return Err("431 Header line too long: truncated at {RUNTIME_READ_LINE_CAP} bytes without a newline")
                        if not header_line.ends_with("\n"):
                            return Err("400 Incomplete request headers")
                        val header_payload = request_line_without_terminator(header_line)
                        if header_payload.len() > max_header_line:
                            return Err("431 Header line too long: {header_payload.len()} bytes")
                        if header_payload == "":
                            break
                        if header_payload.starts_with(" ") or header_payload.starts_with("\t"):
                            return Err("400 Obsolete folded header is not supported")
                        val hl = header_payload.trim()
                        if hl == "":
                            return Err("400 Malformed whitespace-only header line")
                        # AC-1 / finding 2: header count limit
                        header_count = header_count + 1
                        if header_count > max_header_count:
                            return Err("431 Too many headers: {header_count}")
                        val colon = hl.index_of(":")
                        if colon <= 0:
                            return Err("400 Malformed header line")
                        val name = hl.slice(0, colon).trim()
                        val value = hl.slice(colon + 1, hl.len()).trim()
                        if name == "" or name.contains(" ") or name.contains("\t"):
                            return Err("400 Invalid header name")
                        headers.push((name, value))
                    Err(_):
                        # EOF before the empty header terminator is incomplete
                        # framing, not an implicit end-of-headers marker.
                        return Err("400 Incomplete request headers")

            val decision = headers_decision(headers, max_body)
            if decision.0 != "":
                return Err(decision.0)
            val content_length = decision.1

            var body = ""
            if content_length > 0:
                match stream.read_bytes(content_length):
                    Ok(data):
                        if data.len() != content_length:
                            return Err("400 Incomplete request body")
                        body = data
                    Err(_):
                        return Err("400 Failed to read request body")

            return Ok(HttpRequest(
                method: method,
                path: path,
                query: query,
                version: version,
                headers: headers,
                body: body,
                remote_addr: ""
            ))

# headers_decision inspects parsed headers and decides how the body must be
# handled. Returns (err, content_length): err is "" when the request is
# acceptable, otherwise a status-prefixed message (400/413/501).
# Delegates to the shared http_core body_decision with chunked disallowed —
# the sync server does not decode chunked bodies, so it fails closed (501).
fn headers_decision(headers: [(text, text)], max_body: i32) -> (text, i32):
    val d = body_decision(headers, max_body, false)
    (d.0, d.1)

fn parse_request_line(line: text) -> (text, text, text):
    # HTTP/1 request-line is exactly method SP request-target SP version.
    # Empty components, tabs, leading/trailing SP, and extra tokens reject.
    if line.contains("\t") or line.starts_with(" ") or line.ends_with(" "):
        return ("", "", "")
    val parts = line.split(" ")
    if parts.len() != 3 or parts[0] == "" or parts[1] == "" or parts[2] == "":
        return ("", "", "")
    (parts[0], parts[1], parts[2])

fn request_line_without_terminator(raw: text) -> text:
    if raw == "":
        return ""
    var end = raw.len() - 1
    if end > 0 and raw.char_at(end - 1) == "\r":
        end = end - 1
    raw.slice(0, end)

fn _method_supported(method: text) -> bool:
    (method == "GET" or method == "POST" or method == "PUT" or
        method == "DELETE" or method == "PATCH" or method == "HEAD" or
        method == "OPTIONS")

# content_length_from_text is re-exported from the shared http_core.

# to_i32_safe is kept for backward compatibility.  New callers should prefer
# content_length_from_text which returns -1 on error instead of 0.
fn to_i32_safe(s: text) -> i32:
    val v = content_length_from_text(s)
    if v < 0:
        return 0
    return v

export parse_request, parse_request_with_limits, parse_request_with_policy_limits, parse_request_line
export request_line_without_terminator
export to_i32_safe, headers_decision
export RUNTIME_READ_LINE_CAP
