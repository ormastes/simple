# HTTP Server — Lightweight Embedded Web Server
#
# Part of std.nogc_sync_mut.http_server
# Full standalone example: examples/06_io/simple_web_server/
# Design: doc/05_design/ui/web/simple_web_server_lib_api.md

use std.nogc_sync_mut.io.tcp.{TcpListener, TcpStream}
use std.nogc_sync_mut.http_server.types.{HttpRequest, HttpResponse, HttpStatus}
use std.nogc_sync_mut.http_server.parser.{parse_request_with_policy_limits, MAX_REQUEST_LINE, MAX_HEADER_COUNT, MAX_HEADER_LINE, MAX_BODY_SIZE}
use std.nogc_sync_mut.http_server.response.{write_response, write_error, with_default_security_headers}
use std.nogc_sync_mut.http_server.router.{Router}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
use std.concurrent.thread.{thread_spawn_with_args}

# Default maximum number of header read iterations before we consider the
# client too slow and abort.  Each iteration corresponds to one read_line call
# for a header.  At MAX_HEADER_COUNT (100) headers this gives headroom for
# normal requests while bounding worst-case handler occupation.
val DEFAULT_MAX_READ_ITERS: i32 = 200
val DEFAULT_MAX_CONNECTIONS: i64 = 128

class ConnectionAdmission:
    active: AtomicI64
    limit: i64

    static fn new(limit: i64) -> ConnectionAdmission:
        ConnectionAdmission(active: atomic_i64_new(0), limit: limit)

    fn try_acquire() -> bool:
        var current = self.active.load(MemoryOrdering.Acquire)
        while current < self.limit:
            if self.active.compare_exchange(current, current + 1,
                    MemoryOrdering.AcqRel, MemoryOrdering.Acquire):
                return true
            current = self.active.load(MemoryOrdering.Acquire)
        false

    fn release():
        var current = self.active.load(MemoryOrdering.Acquire)
        while current > 0:
            if self.active.compare_exchange(current, current - 1,
                    MemoryOrdering.AcqRel, MemoryOrdering.Acquire):
                return
            current = self.active.load(MemoryOrdering.Acquire)

    fn count() -> i64:
        self.active.load(MemoryOrdering.Acquire)

# An explicit authority object is required to expose a plaintext listener.
# Merely mutating policy data cannot enable the API by accident.
class PlaintextDevelopmentCapability:
    reason: text

fn plaintext_development_capability(reason: text) -> Result<PlaintextDevelopmentCapability, text>:
    val accepted = reason.trim()
    if accepted == "":
        return Err("plaintext development requires a non-empty audit reason")
    Ok(PlaintextDevelopmentCapability(reason: accepted))

class SecureServerPolicy:
    max_request_line: i32
    max_header_count: i32
    max_header_line: i32
    max_body: i32
    max_read_iters: i32
    read_timeout_ms: i64
    write_timeout_ms: i64
    max_keep_alive_requests: i32
    max_connections: i64
    plaintext_development: bool

    static fn production() -> SecureServerPolicy:
        SecureServerPolicy(
            max_request_line: MAX_REQUEST_LINE,
            max_header_count: MAX_HEADER_COUNT,
            max_header_line: MAX_HEADER_LINE,
            max_body: MAX_BODY_SIZE,
            max_read_iters: DEFAULT_MAX_READ_ITERS,
            read_timeout_ms: 5000,
            write_timeout_ms: 5000,
            max_keep_alive_requests: 1,
            max_connections: DEFAULT_MAX_CONNECTIONS,
            plaintext_development: false
        )

    static fn plaintext_dev(capability: PlaintextDevelopmentCapability) -> SecureServerPolicy:
        var policy = SecureServerPolicy.production()
        policy.plaintext_development = capability.reason.trim() != ""
        policy

fn secure_server_policy_error(policy: SecureServerPolicy) -> text:
    if policy.max_request_line <= 0:
        return "max_request_line must be positive"
    if policy.max_header_count <= 0:
        return "max_header_count must be positive"
    if policy.max_header_line <= 0:
        return "max_header_line must be positive"
    if policy.max_body < 0:
        return "max_body must not be negative"
    if policy.max_read_iters <= 0 or policy.max_read_iters < policy.max_header_count + 1:
        return "max_read_iters must cover the bounded header set and terminator"
    if policy.read_timeout_ms <= 0 or policy.write_timeout_ms <= 0:
        return "socket timeouts must be positive"
    if policy.max_keep_alive_requests != 1:
        return "this connection-close server requires max_keep_alive_requests=1"
    if policy.max_connections <= 0:
        return "max_connections must be positive"
    ""

fn request_parse_error_status(message: text) -> HttpStatus:
    if message.starts_with("413"):
        return HttpStatus.PayloadTooLarge
    if message.starts_with("431"):
        return HttpStatus.RequestHeaderFieldsTooLarge
    if message.starts_with("501"):
        return HttpStatus.NotImplemented
    if message.starts_with("408"):
        return HttpStatus.BadRequest
    HttpStatus.BadRequest

class SimpleHttpServer:
    host: text
    port: i32
    router: Router
    running: bool
    policy: SecureServerPolicy
    admission: ConnectionAdmission

    static fn new(host: text, port: i32, router: Router) -> SimpleHttpServer:
        SimpleHttpServer(
            host: host,
            port: port,
            router: router,
            running: false,
            policy: SecureServerPolicy.production(),
            admission: ConnectionAdmission.new(DEFAULT_MAX_CONNECTIONS)
        )

    me with_policy(policy: SecureServerPolicy) -> SimpleHttpServer:
        self.policy = policy
        self.admission = ConnectionAdmission.new(policy.max_connections)
        self

    me start() -> Result<(), text>:
        Err("production policy requires TLS; use start_plaintext(capability) only for audited development")

    me start_plaintext(capability: PlaintextDevelopmentCapability) -> Result<(), text>:
        if not self.policy.plaintext_development or capability.reason.trim() == "":
            return Err("plaintext listener requires explicit development policy and capability")
        val policy_error = secure_server_policy_error(self.policy)
        if policy_error != "":
            return Err("invalid secure server policy: {policy_error}")
        self.running = true
        val addr = "{self.host}:{self.port}"
        match TcpListener.bind(addr):
            Err(e):
                self.running = false
                return Err("failed to bind to {addr}: {e}")
            Ok(listener):
                print "SimpleHttpServer listening on {addr}"
                self.serve_loop(listener)
                Ok(())

    me start_with_callback(capability: PlaintextDevelopmentCapability, on_ready: fn(text, i32)) -> Result<(), text>:
        if not self.policy.plaintext_development or capability.reason.trim() == "":
            return Err("production policy requires TLS; plaintext listener refused")
        val policy_error = secure_server_policy_error(self.policy)
        if policy_error != "":
            return Err("invalid secure server policy: {policy_error}")
        self.running = true
        val addr = "{self.host}:{self.port}"
        match TcpListener.bind(addr):
            Err(e):
                self.running = false
                return Err("failed to bind to {addr}: {e}")
            Ok(listener):
                on_ready(self.host, self.port)
                self.serve_loop(listener)
                Ok(())

    me stop():
        self.running = false

    me serve_loop(listener: TcpListener):
        while self.running:
            match listener.accept():
                Ok(stream):
                    if not self.admission.try_acquire():
                        val _ = stream.close()
                        continue
                    val handler = thread_spawn_with_args(stream, self, \conn_stream, server:
                        val srv: SimpleHttpServer = server
                        SimpleHttpServer.handle_connection_admitted(srv, conn_stream)
                    )
                    if handler.handle < 0:
                        SimpleHttpServer.handle_connection_admitted(self, stream)
                    else:
                        handler.free()
                Err(e):
                    if self.running:
                        print "Accept error: {e}"
        val _ = listener.close()

    static fn handle_connection_admitted(server: SimpleHttpServer, stream: TcpStream):
        defer server.admission.release()
        server.handle_connection(stream)

    me handle_connection(stream: TcpStream):
        if not stream.set_read_timeout_status(self.policy.read_timeout_ms):
            val _ = stream.close()
            return
        match stream.set_write_timeout(Some(self.policy.write_timeout_ms)):
            Err(_):
                val _ = stream.close()
                return
            Ok(_): pass
        var remote_addr = ""
        match stream.peer_addr():
            Ok(peer): remote_addr = peer
            Err(_):
                val _ = stream.close()
                return
        match parse_request_with_policy_limits(stream, self.policy.max_request_line,
                self.policy.max_header_count, self.policy.max_header_line,
                self.policy.max_body, self.policy.max_read_iters):
            Ok(req):
                var request = req
                request.remote_addr = remote_addr
                val resp = with_default_security_headers(self.router.dispatch(request), false)
                if not write_response(stream, resp):
                    val _ = stream.close()
                    return
            Err(e):
                if not write_error(stream, request_parse_error_status(e), e):
                    val _ = stream.close()
                    return
        val _ = stream.close()

export SimpleHttpServer, SecureServerPolicy, PlaintextDevelopmentCapability, ConnectionAdmission
export plaintext_development_capability, secure_server_policy_error, request_parse_error_status
export DEFAULT_MAX_CONNECTIONS
