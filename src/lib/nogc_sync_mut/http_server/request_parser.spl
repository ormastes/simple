# Request-parser strategy seam for explicitly configured HTTP servers.
# The default server keeps using the existing scalar parser and does not load
# any dynamic-provider module.

use std.nogc_sync_mut.io.tcp.{TcpStream}
use std.nogc_sync_mut.http_server.types.{HttpRequest}

class HttpRequestParseOwnedV1:
    request: HttpRequest?
    error: text
    buffered_remainder: [u8]
    provider_attempts: i64
    provider_successes: i64
    provider_used: bool
    parser: HttpRequestParserV1?

class HttpRequestParserCloseOwnedV1:
    parser: HttpRequestParserV1?
    status: i32
    reason: text

trait HttpRequestParserV1:
    fn parse_request_owned_v1(stream: TcpStream, max_request_line: i32,
        max_header_count: i32, max_header_line: i32, max_body: i32,
        max_read_iters: i32) -> HttpRequestParseOwnedV1

    fn close_owned_v1() -> HttpRequestParserCloseOwnedV1

fn http_request_parser_close_owned_v1(
        parser: HttpRequestParserV1) -> HttpRequestParserCloseOwnedV1:
    parser.close_owned_v1()

export HttpRequestParseOwnedV1, HttpRequestParserV1
export HttpRequestParserCloseOwnedV1, http_request_parser_close_owned_v1
