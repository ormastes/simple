use std.test_runner.test_runner_fork.{run_test_file_fork}
use std.test_runner.test_runner_coverage.{record_coverage_sdn, record_compiler_decision_manifest_sdn}
use std.test_runner.test_runner_metrics.{test_resource_class, test_execution_cohort_id}
use std.io.{file_exists, file_write, file_delete}
use std.io.{env_set, env_get}
use nogc_sync_mut.io.crypto_sffi.{random_hex as test_runner_random_hex}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_size_raw, file_modified_time}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.io.process_ops.{ProcessResult}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass, standard_resource_budget, execution_resource_scope_with_budget, run_in_execution_resource_scope}
use std.common.perf.execution_metrics.{ResourceUsage, ResourceEvidenceQuality, ResourceBudget, DecisionStatus, TerminationCause, evaluate_resource_budget, decision_status_name}

# Import from split-out files (same directory, but need use for re-export)
use std.test_runner.test_executor_parsing.{
    find_simple_new_binary, find_runtime_lib_dir, find_simple_binary,
    extract_error_message, parse_test_output,
    extract_number_before, extract_number_after_colon,
    build_child_args, make_result_from_output,
    make_result_from_structured_evidence,
    coverage_wrapper_suffix, build_coverage_wrapper,
    extract_coverage_sdn, strip_coverage_blocks,
    COVERAGE_BEGIN, COVERAGE_END,
    extract_compiler_mcdc_obligation_manifest,
    list_tests_static, extract_static_test_name,
    _tp_get_temp_dir
}

# Direct import from the concrete defining module (bypassing the `std.`
# variant-resolution facade) — the seed mangler bare-externs calls whose
# import chain crosses that facade indirection. See
# doc/08_tracking/bug/stage4_link_undefined_peer_symbols_2026-07-28.md
export use nogc_sync_mut.test_runner.test_executor_parsing.{
    extract_compiler_coverage_manifest_sdn, strip_compiler_coverage_manifest_blocks
}

struct ScopedChildRun:
    result: ProcessResult
    usage: ResourceUsage?
    budget_status: text

fn _run_scoped_child(resource_class: ExecutionResourceClass, cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_ms: i64, max_fds: i64, max_pids: i64, enforce_class_defaults: bool) -> ScopedChildRun:
    val defaults = standard_resource_budget(resource_class)
    val effective_memory = if memory_bytes > 0: memory_bytes elif enforce_class_defaults: defaults.max_tree_charge_bytes else: 0
    val effective_cpu = if cpu_ms > 0: cpu_ms elif enforce_class_defaults: defaults.max_cpu_ms else: 0
    val effective_fds = if max_fds > 0: max_fds elif enforce_class_defaults: defaults.max_fds else: 0
    val effective_pids = if max_pids > 0: max_pids elif enforce_class_defaults: defaults.max_pids else: 0
    val budget = ResourceBudget(
        max_wall_ms: timeout_ms, max_cpu_ms: effective_cpu,
        max_tree_charge_bytes: effective_memory, max_direct_child_rss_bytes: effective_memory,
        max_io_read_bytes: if enforce_class_defaults: defaults.max_io_read_bytes else: 0,
        max_io_write_bytes: if enforce_class_defaults: defaults.max_io_write_bytes else: 0,
        max_pids: effective_pids,
        max_fds: effective_fds)
    val scope = execution_resource_scope_with_budget(resource_class, budget, TEST_OUTPUT_CAPTURE_BYTES)
    val scoped = run_in_execution_resource_scope(scope, cmd, args)
    val termination = scoped.process.usage.termination
    val limit_type = if (termination == TerminationCause.MemoryMax or
            (scoped.budget_decision.status == DecisionStatus.Failure and scoped.budget_decision.reason.contains("memory"))):
        "memory"
    elif (termination == TerminationCause.ProcessLimit or
            (scoped.budget_decision.status == DecisionStatus.Failure and scoped.budget_decision.reason.contains("process"))):
        "procs"
    elif termination == TerminationCause.CpuLimit:
        "cpu"
    elif termination == TerminationCause.WallTimeout:
        "timeout"
    elif effective_fds > 0 and scoped.process.stderr.lower().contains("too many open files"):
        "fds"
    elif scoped.budget_decision.status == DecisionStatus.Failure:
        "budget"
    else:
        ""
    ScopedChildRun(
        result: ProcessResult(stdout: scoped.process.stdout, stderr: scoped.process.stderr,
            exit_code: scoped.process.usage.exit_code, limit_exceeded: limit_type != "", limit_type: limit_type),
        usage: scoped.process.usage,
        budget_status: decision_status_name(scoped.budget_decision.status))

fn _attach_scope_evidence(result: TestFileResult, usage: ResourceUsage?, budget_status: text, file_path: text, options: TestOptions, compile_ms: i64 = 0, execution_ms: i64 = 0) -> TestFileResult:
    TestFileResult(
        path: result.path, passed: result.passed, failed: result.failed,
        skipped: result.skipped, pending: result.pending,
        duration_ms: result.duration_ms, setup_ms: result.setup_ms,
        error: result.error, timed_out: result.timed_out, cached: result.cached,
        compile_ms: compile_ms, execution_ms: execution_ms,
        resource_usage: usage,
        resource_class: if file_path.contains("/03_system/"): "system" elif file_path.contains("/02_integration/"): "integration" else: "unit",
        cohort_id: test_execution_cohort_id(file_path, options),
        budget_status: budget_status, anomaly_status: "provisional")

fn _combine_usage(first: ResourceUsage?, second: ResourceUsage?) -> ResourceUsage?:
    val left = match first:
        case Some(value): value
        case nil: return second
    val right = match second:
        case Some(value): value
        case nil: return first
    val quality = if left.evidence_quality == ResourceEvidenceQuality.Unavailable or right.evidence_quality == ResourceEvidenceQuality.Unavailable:
        ResourceEvidenceQuality.Unavailable
    elif left.evidence_quality == ResourceEvidenceQuality.ExactTree and right.evidence_quality == ResourceEvidenceQuality.ExactTree:
        ResourceEvidenceQuality.ExactTree
    elif left.evidence_quality == ResourceEvidenceQuality.SampledTree or right.evidence_quality == ResourceEvidenceQuality.SampledTree:
        ResourceEvidenceQuality.SampledTree
    else:
        ResourceEvidenceQuality.ExactDirectChild
    ResourceUsage(
        wall_ms: left.wall_ms + right.wall_ms,
        user_cpu_ms: left.user_cpu_ms + right.user_cpu_ms,
        system_cpu_ms: left.system_cpu_ms + right.system_cpu_ms,
        peak_tree_charge_bytes: if left.peak_tree_charge_bytes > right.peak_tree_charge_bytes: left.peak_tree_charge_bytes else: right.peak_tree_charge_bytes,
        peak_direct_child_rss_bytes: if left.peak_direct_child_rss_bytes > right.peak_direct_child_rss_bytes: left.peak_direct_child_rss_bytes else: right.peak_direct_child_rss_bytes,
        heap_live_end_bytes: right.heap_live_end_bytes,
        heap_peak_bytes: if left.heap_peak_bytes > right.heap_peak_bytes: left.heap_peak_bytes else: right.heap_peak_bytes,
        io_read_bytes: left.io_read_bytes + right.io_read_bytes,
        io_write_bytes: left.io_write_bytes + right.io_write_bytes,
        pids_peak: if left.pids_peak > right.pids_peak: left.pids_peak else: right.pids_peak,
        evidence_quality: quality,
        termination: if left.termination != TerminationCause.Exited: left.termination else: right.termination,
        signal: if left.signal != 0: left.signal else: right.signal,
        exit_code: if left.exit_code != 0: left.exit_code else: right.exit_code)

use std.io_runtime.{getpid}
extern fn rt_file_create_excl(path: text, content: text) -> bool
extern fn rt_package_chmod(file_path: text, mode: i32) -> i32
# NOTE: composite/baremetal/QEMU lane symbols intentionally NOT imported here.
# They live behind test_executor_lanes.spl (which eagerly loads GPU/JIT lane
# executors + ~300 compiler-backend modules, ~40s seed load). Importers that
# dispatch those lanes use std.test_runner.test_executor_lanes directly.

# A limit breach that KILLED the child from outside says nothing about the code
# under test -- it is UNVERIFIED, never a failure. Only a limit the test itself
# exhausted (fds, procs) is a real defect. This matters concretely here:
# earlyoom SIGTERMs `simple` at 10% memory on a zero-swap host, so counting a
# memory/cpu/timeout kill as a failure manufactures REDs that no code change can
# fix. See .spipe/unstable_test_mode/state.md.
fn limit_is_unverified(limit_type: text) -> bool:
    limit_type == "timeout" or limit_type == "memory" or limit_type == "cpu"

fn limit_exceeded_message(result: ProcessResult, options: TestOptions) -> text:
    # Prefixed with the contract's outcome class so the summary derivation in
    # test_runner_output.spl can classify it. Without the prefix these breaches
    # reach the summary as anonymous failures -- the exact defect that had a
    # 60s timeout counting inside `3 failed`.
    match result.limit_type:
        case "memory": "TERMINATED: Memory limit exceeded ({options.max_mem_gb}GB) (unverified)"
        case "procs": "Process limit exceeded (max {options.max_procs} procs; note RLIMIT_NPROC is per-UID)"
        case "cpu": "TERMINATED: CPU time limit exceeded (unverified)"
        case "fds": "File descriptor limit exceeded"
        case "timeout": "TIMEOUT: Timed out under resource limits (unverified)"
        case "budget": "Declared resource budget exceeded"
        case _: "Resource limit exceeded ({result.limit_type})"

# =========================================================================
# Core Execution Modes
# =========================================================================
#
# PER-SPEC PROCESS ISOLATION IS UNCONDITIONAL AND IS NOT A MODE FEATURE.
# Every run_test_file_* variant below spawns the spec in its OWN child process
# (run_in_execution_resource_scope) regardless of
# `options.unstable_mode`. This file reads `unstable_mode` NOWHERE, by design:
# isolation is a PRECONDITION of the outcome contract, not a toggle. The
# classes CRASHED / TERMINATED / TIMEOUT are derived from a child's exit code
# and limit_type; without a child there is no exit code to classify, and a
# segfaulting spec would take the runner down with it. Gating isolation on the
# flag would therefore make non-unstable runs strictly less able to report the
# truth, with no compensating benefit.
# What `unstable_mode` actually controls today is exactly one thing:
# `fail_fast = false` (src/app/test_runner_new/test_runner_main.spl:205) --
# i.e. run to the END of both lists. See
# doc/05_design/infra/test_runner/unstable_mode_scope_finding_2026-08-17.md.

fn run_test_file_interpreter(file_path: text, options: TestOptions) -> TestFileResult:
    # Coverage probes are MIR-owned. The HIR tree interpreter never executes
    # them, so route coverage runs through the real LLVM native path.
    val configured_mcdc_mode = env_get("SIMPLE_MCDC_MODE") ?? ""
    if options.coverage or configured_mcdc_mode == "on" or configured_mcdc_mode == "dynamic":
        return run_test_file_native(file_path, options)
    # Fork mode: use fork() + COW instead of subprocess spawn (Linux only)
    # Fork output does not yet carry child coverage payloads back to the parent.
    if options.fork_mode and not options.coverage:
        val fork_result = run_test_file_fork(file_path, options)
        return _attach_scope_evidence(fork_result, fork_result.resource_usage,
            fork_result.budget_status, file_path, options,
            execution_ms: fork_result.execution_ms)

    # Session setup phase — not counted toward test duration
    val setup_start = time_now_unix_micros()
    val binary = find_simple_binary()
    print "[diag] resolved child binary = " + binary
    # Child `run <file>` must execute in interpreter mode to load BDD test
    # intrinsics (`describe`/`it`/`expect`). Without this, `simple test
    # --mode=interpreter` can still dispatch a child in compile mode,
    # producing parse errors + zero evidence.
    env_set("SIMPLE_EXECUTION_MODE", "interpret")
    # Legacy word-infix `expect X to_equal Y` matchers are not understood by the
    # interpreter `run` path; rewrite them to method form first (sibling temp).
    val infix_path = preprocess_infix_matchers_only(file_path)
    val (wrapped_path, cleanup_path) = build_coverage_wrapper(infix_path, options)
    # NOTE: deliberately does NOT use
    # std.test_runner.test_result_wrapper.build_interpreter_result_wrapper
    # (the `use std.spec.{print_summary, get_exit_code,
    # get_executed_test_count}` + panic-on-zero-executed harness). That
    # harness hits a Rust-intrinsic-vs-.spl-module-var disconnect:
    # `describe`/`it`/`expect` are native interpreter intrinsics tracking
    # pass/fail counts in a Rust thread-local, while `print_summary`/
    # `get_executed_test_count` are plain imported .spl functions reading
    # module-level vars those intrinsics never write to (dead code in
    # interpreter mode). Every wrapped run — including genuinely green ones —
    # fails with `variable test_passed not found` or a false "no examples
    # executed" panic. `test_runner_single.spl` (the --no-session-daemon
    # path) already avoids this wrapper for the identical reason (see its own
    # file-header note); mirror that here for the daemon-invoked interpreter
    # mode so the two paths agree. `parse_test_output` below already
    # accumulates real counts directly from each `describe` block's own
    # native "N examples, M failures" summary line (see its `bdd_summary_pos`
    # handling), so the wrapper was never actually required for correct
    # counting — only for a (broken) redundant zero-executed guard, and
    # `make_result_from_output`'s "no parseable pass/fail summary; refusing
    # synthetic pass" fallback already fails closed for genuinely
    # zero-executed specs without it. See
    # doc/08_tracking/bug/std_spec_package_shadows_file_print_summary_2026-07-17.md.
    var child_args = build_child_args(wrapped_path, options)
    var evidence_path = ""
    var previous_evidence_path = ""
    if options.assert_ran:
        val temp_root = _tp_get_temp_dir()
        val temp_sep = if temp_root.ends_with("/") or temp_root.ends_with("\\"): "" else: "/"
        evidence_path = "{temp_root}{temp_sep}simple_bdd_result_{getpid()}_{time_now_unix_micros()}.txt"
        if file_exists(evidence_path):
            file_delete(evidence_path)
        if file_exists(evidence_path):
            if cleanup_path != "" and not options.keep_artifacts and file_exists(cleanup_path):
                file_delete(cleanup_path)
            if infix_path != file_path and not options.keep_artifacts and file_exists(infix_path):
                file_delete(infix_path)
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: 0, error: "test-runner: cannot prepare structured result evidence", timed_out: false, cached: false)
        previous_evidence_path = env_get("SIMPLE_TEST_RESULT_FILE") ?? ""
        if not env_set("SIMPLE_TEST_RESULT_FILE", evidence_path):
            if cleanup_path != "" and not options.keep_artifacts:
                if file_exists(cleanup_path):
                    file_delete(cleanup_path)
            if infix_path != file_path and not options.keep_artifacts:
                if file_exists(infix_path):
                    file_delete(infix_path)
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: 0, error: "test-runner: cannot configure structured result environment", timed_out: false, cached: false)
        child_args = child_args.push("--test-result-file={evidence_path}")
    val timeout_ms = options.timeout * 1000
    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    # Test execution phase — only this counts as duration
    val start = time_now_unix_micros()
    var stdout = ""
    var stderr = ""
    var exit_code = 0
    var observed_usage: ResourceUsage? = nil
    var budget_status = "incomplete"
    val memory_bytes = if (options.max_mem_gb > 0 and not options.no_limits): options.max_mem_gb * 1024 * 1024 * 1024 else: 0
    val max_pids = if options.no_limits: 0 else: options.max_procs
    val scoped_child = _run_scoped_child(test_resource_class(file_path), binary, child_args, timeout_ms, memory_bytes, 0, 0, max_pids, not options.no_limits)
    stdout = scoped_child.result.stdout
    stderr = scoped_child.result.stderr
    exit_code = scoped_child.result.exit_code
    observed_usage = scoped_child.usage
    budget_status = scoped_child.budget_status
    if scoped_child.result.limit_exceeded:
        val result = scoped_child.result
        val end2 = time_now_unix_micros()
        val dur = (end2 - start) / 1000
        if cleanup_path != "" and not options.keep_artifacts:
            if file_exists(cleanup_path):
                file_delete(cleanup_path)
        if infix_path != file_path and not options.keep_artifacts:
            if file_exists(infix_path):
                file_delete(infix_path)
        if evidence_path != "" and not env_set("SIMPLE_TEST_RESULT_FILE", previous_evidence_path):
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: dur, setup_ms: setup_ms, error: "test-runner: cannot restore structured result environment", timed_out: false, cached: false)
        if evidence_path != "" and file_exists(evidence_path):
            file_delete(evidence_path)
        return TestFileResult(path: file_path, passed: 0, failed: if limit_is_unverified(result.limit_type): 0 else: 1, skipped: 0, pending: 0,
            duration_ms: dur, setup_ms: setup_ms, error: limit_exceeded_message(result, options), timed_out: result.limit_type.contains("timeout"), cached: false,
            execution_ms: dur, resource_usage: observed_usage,
            resource_class: if file_path.contains("/03_system/"): "system" elif file_path.contains("/02_integration/"): "integration" else: "unit",
            cohort_id: test_execution_cohort_id(file_path, options), budget_status: budget_status, anomaly_status: "incomplete")
    val end = time_now_unix_micros()
    val duration_ms = (end - start) / 1000
    var compiler_manifest_error = ""
    if options.coverage:
        val combined = stdout + "\n" + stderr
        val (compiler_manifest, compiler_manifest_valid) = extract_compiler_coverage_manifest_sdn(combined)
        if not compiler_manifest_valid or not record_compiler_decision_manifest_sdn(compiler_manifest):
            compiler_manifest_error = "test-runner: missing or malformed compiler coverage manifest"
        else:
            val sdn = extract_coverage_sdn(combined)
            record_coverage_sdn(sdn)
        stdout = strip_compiler_coverage_manifest_blocks(stdout)
        stderr = strip_compiler_coverage_manifest_blocks(stderr)
        stdout = strip_coverage_blocks(stdout)
        stderr = strip_coverage_blocks(stderr)

    if cleanup_path != "" and not options.keep_artifacts:
        if file_exists(cleanup_path):
            file_delete(cleanup_path)
    if infix_path != file_path and not options.keep_artifacts:
        if file_exists(infix_path):
            file_delete(infix_path)
    if evidence_path != "" and not env_set("SIMPLE_TEST_RESULT_FILE", previous_evidence_path):
        return TestFileResult(
            path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
            duration_ms: duration_ms, setup_ms: setup_ms,
            error: "test-runner: cannot restore structured result environment", timed_out: false, cached: false
        )

    if compiler_manifest_error != "":
        if evidence_path != "" and file_exists(evidence_path):
            file_delete(evidence_path)
        return TestFileResult(
            path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
            duration_ms: duration_ms, setup_ms: setup_ms,
            error: compiler_manifest_error, timed_out: false, cached: false
        )

    val result = make_result_from_structured_evidence(file_path, stdout, stderr, exit_code, duration_ms, options.timeout, evidence_path)
    if evidence_path != "" and file_exists(evidence_path):
        file_delete(evidence_path)
    TestFileResult(
        path: result.path, passed: result.passed, failed: result.failed,
        skipped: result.skipped, pending: result.pending,
        duration_ms: result.duration_ms, setup_ms: setup_ms,
        error: result.error, timed_out: result.timed_out, cached: result.cached,
        mcdc_evidence_v1: result.mcdc_evidence_v1,
        blocked: result.blocked, unsupported: result.unsupported,
        omission_evidence: result.omission_evidence,
        execution_ms: duration_ms,
        resource_usage: observed_usage,
        resource_class: if file_path.contains("/03_system/"): "system" elif file_path.contains("/02_integration/"): "integration" else: "unit",
        cohort_id: test_execution_cohort_id(file_path, options),
        budget_status: budget_status,
        anomaly_status: "provisional"
    )

# A completed .smf artifact (SMF header + trailer + at least some code) is
# always well over this many bytes; a bare/empty stub (the 179-byte stubs from
# doc/08_tracking/bug/smf_stub_shadowing_unresolved_describe_2026-07-24.md)
# is not. Cheap sanity floor alongside the mtime freshness check — not a real
# SMF header parse.
val _SMF_MIN_VALID_SIZE: i64 = 256

fn _smf_artifact_is_usable(smf_path: text, source_path: text) -> bool:
    # Guard against a stale or stub .smf silently shadowing the real .spl
    # source: only trust a precompiled artifact that is both non-trivially
    # sized and at least as fresh as the source file it was built from.
    if not file_exists(smf_path):
        return false
    if file_size_raw(smf_path) < _SMF_MIN_VALID_SIZE:
        return false
    file_modified_time(smf_path) >= file_modified_time(source_path)

fn run_test_file_smf(file_path: text, options: TestOptions) -> TestFileResult:
    if options.coverage:
        return run_test_file_native(file_path, options)

    val binary = find_simple_binary()
    val smf_path = file_path.replace(".spl", ".smf")
    val start = time_now_unix_micros()
    val timeout_ms = options.timeout * 1000

    # Check if pre-compiled .smf bytecode exists AND is actually usable —
    # never trust a stale or stub artifact over the real source.
    if _smf_artifact_is_usable(smf_path, file_path):
        # Run pre-compiled SMF bytecode directly (no "test" command to avoid recursion)
        var run_args: [text] = [smf_path]
        if options.gc_log:
            run_args.push("--gc-log")
        if options.gc_off:
            run_args.push("--gc=off")
        var stdout = ""
        var stderr = ""
        var exit_code = 0
        val memory_bytes = if (options.max_mem_gb > 0 and not options.no_limits): options.max_mem_gb * 1024 * 1024 * 1024 else: 0
        val scoped_child = _run_scoped_child(test_resource_class(file_path), binary, run_args, timeout_ms, memory_bytes, 0, 0, if options.no_limits: 0 else: options.max_procs, not options.no_limits)
        stdout = scoped_child.result.stdout
        stderr = scoped_child.result.stderr
        exit_code = scoped_child.result.exit_code
        if scoped_child.result.limit_exceeded:
            val end2 = time_now_unix_micros()
            val dur = (end2 - start) / 1000
            return TestFileResult(path: file_path, passed: 0, failed: if limit_is_unverified(scoped_child.result.limit_type): 0 else: 1, skipped: 0, pending: 0,
                duration_ms: dur, setup_ms: 0, error: limit_exceeded_message(scoped_child.result, options), timed_out: scoped_child.result.limit_type.contains("timeout"), cached: false,
                execution_ms: dur, resource_usage: scoped_child.usage,
                resource_class: if file_path.contains("/03_system/"): "system" elif file_path.contains("/02_integration/"): "integration" else: "unit",
                cohort_id: test_execution_cohort_id(file_path, options), budget_status: scoped_child.budget_status, anomaly_status: "incomplete")
        val end = time_now_unix_micros()
        val duration_ms = (end - start) / 1000
        if options.coverage:
            val combined = stdout + "\n" + stderr
            val sdn = extract_coverage_sdn(combined)
            record_coverage_sdn(sdn)
            stdout = strip_coverage_blocks(stdout)
            stderr = strip_coverage_blocks(stderr)
        val base_result = make_result_from_output(file_path, stdout, stderr, exit_code, duration_ms, options.timeout)
        return _attach_scope_evidence(base_result, scoped_child.usage, scoped_child.budget_status, file_path, options, 0, duration_ms)

    # No precompiled artifact exists. Compile to SMF instead of silently
    # falling back to source execution.
    run_test_file_native(file_path, options)

fn run_test_file_native_old(file_path: text, options: TestOptions) -> TestFileResult:
    val binary = find_simple_binary()
    val start = time_now_unix_micros()
    val timeout_ms = options.timeout * 1000

    # Run file directly instead of "test" command to avoid infinite recursion
    var run_args: [text] = [file_path]
    if options.gc_log:
        run_args.push("--gc-log")
    if options.gc_off:
        run_args.push("--gc=off")
    val scoped_child = _run_scoped_child(test_resource_class(file_path), binary, run_args, timeout_ms, 0, 0, 0, if options.no_limits: 0 else: options.max_procs, not options.no_limits)
    val stdout = scoped_child.result.stdout
    val stderr = scoped_child.result.stderr
    val exit_code = scoped_child.result.exit_code
    val end = time_now_unix_micros()
    val duration_ms = (end - start) / 1000

    val base_result = make_result_from_output(file_path, stdout, stderr, exit_code, duration_ms, options.timeout)
    _attach_scope_evidence(base_result, scoped_child.usage, scoped_child.budget_status, file_path, options, 0, duration_ms)

fn spipe_inline_helpers() -> text:
    "# === spipe inline helpers (compile-mode only) ===\n" +
    "extern fn rt_bdd_expect_truthy(value)\n\n" +
    "fn expect(value):\n" +
    "    rt_bdd_expect_truthy(value)\n\n" +
    "fn step(description: text):\n" +
    "    if description == \"\":\n" +
    "        return\n\n" +
    "fn pending(name: text):\n" +
    "    print \"    \{name\} ... pending\"\n\n" +
    "fn skip(name: text, reason: text):\n" +
    "    print \"    \{name\} ... skipped (\{reason\})\"\n\n" +
    "fn skip_it(name: text, block: fn()):\n" +
    "    print \"    \{name\} ... skipped (compiled-only)\"\n\n" +
    "fn check(condition: bool):\n" +
    "    expect condition\n\n" +
    "fn check_msg(condition: bool, message: text):\n" +
    "    if not condition:\n" +
    "        print \"    check failed: \{message\}\"\n" +
    "    expect condition\n\n" +
    "fn fail_assertion(message: text):\n" +
    "    print \"    assertion failed: \{message\}\"\n" +
    "    expect false\n\n" +
    "fn fail_test(message: text):\n" +
    "    fail_assertion(message)\n\n" +
    "fn fail(message: text):\n" +
    "    fail_assertion(message)\n\n" +
    "fn assert_eq(a, b):\n" +
    "    expect a == b\n\n" +
    "fn assert_ne(a, b):\n" +
    "    expect a != b\n\n" +
    "fn assert_true(value):\n" +
    "    expect value\n\n" +
    "fn assert_false(value):\n" +
    "    expect not value\n\n" +
    "fn assert_nil(value):\n" +
    "    expect value == nil\n\n" +
    "fn assert_not_nil(value):\n" +
    "    expect value != nil\n\n" +
    "fn pending_on(name: text, deps: text, block: fn()):\n" +
    "    it(name, block)\n\n" +
    "fn pending_skip(name: text, deps: text):\n" +
    "    print \"    \{name\} ... pending (waiting on: \{deps\})\"\n" +
    "# === end spipe inline helpers ===\n"

fn spipe_last_index_of(haystack: text, needle: text) -> i64:
    if needle.len() == 0 or haystack.len() < needle.len():
        return -1
    var idx = haystack.len() - needle.len()
    while idx >= 0:
        if haystack.slice(idx, idx + needle.len()) == needle:
            return idx
        idx = idx - 1
    -1

fn spipe_rewrite_infix_expect_line(line: text) -> text:
    val trimmed = line.trim()
    if not trimmed.starts_with("expect ") or trimmed.starts_with("expect("):
        return line
    val matchers: [text] = ["to_equal", "to_be", "to_contain", "to_start_with", "to_end_with", "to_be_greater_than", "to_be_less_than", "to_be_at_least", "to_be_at_most", "to_be_nil", "to_be_truthy", "to_be_falsy", "to_be_true", "to_be_false", "to_have_length", "to_be_empty"]
    var i = 0
    while i < matchers.len():
        val matcher = matchers[i]
        val needle = " " + matcher + " "
        val split_at = trimmed.index_of(needle)
        if split_at >= 0:
            val actual = trimmed.substring(7, split_at).trim()
            val expected = trimmed.substring(split_at + needle.len()).trim()
            if actual.len() == 0 or expected.len() == 0:
                return line
            val trimmed_line = line.trim_start()
            val indent_len = line.len() - trimmed_line.len()
            val indent = line.substring(0, indent_len)
            return indent + "expect(" + actual + ")." + matcher + "(" + expected + ")"
        i = i + 1
    line

fn preprocess_infix_matchers_only(file_path: text) -> text:
    """Rewrite legacy word-infix `expect X to_equal Y` lines to method form
    `expect(X).to_equal(Y)` so the interpreter `run` path actually evaluates the
    matcher. Without this the `run`/light-daemon path drops the matcher: a falsy
    call subject false-REDs ("call result to be truthy") and any other subject
    silently false-GREENs. Mirrors the Rust `preprocess_matchers_only`;
    interpreter-only, so (unlike the SMF path) it does NOT also fold method form
    into `expect a == b`. Returns a sibling temp path when anything changed, else
    the original path."""
    if not file_path.ends_with("_spec.spl"):
        return file_path
    val content = read_file_content(file_path)
    if content == "":
        return file_path
    val lines = content.split("\n")
    var joined = ""
    var first = true
    var changed = false
    for raw_line in lines:
        val rewritten = spipe_rewrite_infix_expect_line(raw_line)
        if rewritten != raw_line:
            changed = true
        if first:
            joined = rewritten
            first = false
        else:
            joined = joined + "\n" + rewritten
    if not changed:
        return file_path
    val slash = spipe_last_index_of(file_path, "/")
    val dir = if slash >= 0: file_path.substring(0, slash + 1) else: ""
    val base = if slash >= 0: file_path.substring(slash + 1) else: file_path
    val tmp = dir + ".spipe_matchers_" + base
    file_write(tmp, joined)
    tmp

fn spipe_rewrite_method_expect_line(line: text) -> text:
    val trimmed_start = line.trim_start()
    if not trimmed_start.starts_with("expect(") and not trimmed_start.starts_with("expect ("):
        return line
    val indent_len = line.len() - trimmed_start.len()
    val indent = line.substring(0, indent_len)
    val rest_after_expect = trimmed_start.substring(6)
    val after_open_paren = rest_after_expect.trim_start()
    if not after_open_paren.starts_with("("):
        return line
    val inner = after_open_paren.substring(1)
    var depth = 1
    var i = 0
    var actual_end = -1
    while i < inner.len():
        val ch = inner.slice(i, i + 1)
        if ch == "(":
            depth = depth + 1
        elif ch == ")":
            depth = depth - 1
            if depth == 0:
                actual_end = i
                break
        i = i + 1
    if actual_end < 0:
        return line
    val actual = inner.substring(0, actual_end).trim()
    val after_actual_raw = inner.substring(actual_end + 1)
    val after_actual = after_actual_raw.trim_start()
    if not after_actual.starts_with("."):
        return line
    var negated = false
    var after_neg = after_actual.substring(1)
    if after_neg.starts_with("not_()"):
        val next_raw = after_neg.substring(6)
        val next = next_raw.trim_start()
        if not next.starts_with("."):
            return line
        negated = true
        after_neg = next.substring(1)
    val matcher_end = after_neg.index_of("(")
    if matcher_end < 0:
        return line
    val matcher = after_neg.substring(0, matcher_end)
    val matcher_args = after_neg.substring(matcher_end + 1)
    val close_idx = spipe_last_index_of(matcher_args, ")")
    if close_idx < 0:
        return line
    val arg_str = matcher_args.substring(0, close_idx).trim()
    var form = ""
    if matcher == "to_equal" or matcher == "to_be":
        form = if negated: actual + " != " + arg_str else: actual + " == " + arg_str
    elif matcher == "to_be_nil":
        form = if negated: actual + " != nil" else: actual + " == nil"
    elif matcher == "to_be_truthy" or matcher == "to_be_true":
        form = if negated: "not (" + actual + ")" else: actual
    elif matcher == "to_be_falsy" or matcher == "to_be_false":
        form = if negated: actual else: "not (" + actual + ")"
    elif matcher == "to_be_greater_than":
        form = if negated: actual + " <= " + arg_str else: actual + " > " + arg_str
    elif matcher == "to_be_less_than":
        form = if negated: actual + " >= " + arg_str else: actual + " < " + arg_str
    elif matcher == "to_be_at_least":
        form = if negated: actual + " < " + arg_str else: actual + " >= " + arg_str
    elif matcher == "to_be_at_most":
        form = if negated: actual + " > " + arg_str else: actual + " <= " + arg_str
    elif matcher == "to_contain":
        form = if negated: "not ((" + actual + ").contains(" + arg_str + "))" else: "(" + actual + ").contains(" + arg_str + ")"
    elif matcher == "to_start_with":
        form = if negated: "not ((" + actual + ").starts_with(" + arg_str + "))" else: "(" + actual + ").starts_with(" + arg_str + ")"
    elif matcher == "to_end_with":
        form = if negated: "not ((" + actual + ").ends_with(" + arg_str + "))" else: "(" + actual + ").ends_with(" + arg_str + ")"
    elif matcher == "to_have_length":
        form = if negated: "(" + actual + ").len() != " + arg_str else: "(" + actual + ").len() == " + arg_str
    elif matcher == "to_be_empty":
        form = if negated: "(" + actual + ").len() != 0" else: "(" + actual + ").len() == 0"
    else:
        return line
    indent + "expect " + form

fn spipe_brace_delta(line: text) -> i64:
    var delta = 0
    var i = 0
    while i < line.len():
        val ch = line.slice(i, i + 1)
        if ch == "{":
            delta = delta + 1
        elif ch == "}":
            delta = delta - 1
        i = i + 1
    delta

fn spipe_open_bracket_delta(line: text) -> i64:
    """Net count of unclosed `[`/`(`/`{` on one line.

    String literals and `#` comments are skipped so a bracket inside spec
    prose (e.g. `it "matrix[0] is zero":`) does not shift the depth.
    Used to keep a multi-line top-level declaration such as
    `val XS: [text] = [` ... `]` whole at module scope: without it the
    closing `]` (at column 0, and not itself a declaration keyword) was
    swept into the generated `fn main()`, leaving the module-scope list
    literal unterminated -> "parse: expected RBracket, found Val".
    """
    var delta = 0
    var i = 0
    var in_str = false
    var quote = ""
    while i < line.len():
        val ch = line.slice(i, i + 1)
        if in_str:
            if ch == "\\":
                i = i + 2
                continue
            if ch == quote:
                in_str = false
        elif ch == "\"" or ch == "'":
            in_str = true
            quote = ch
        elif ch == "#":
            break
        elif ch == "[" or ch == "(" or ch == "{":
            delta = delta + 1
        elif ch == "]" or ch == ")" or ch == "}":
            delta = delta - 1
        i = i + 1
    delta

fn spipe_is_top_level_start(trimmed: text) -> bool:
    trimmed.starts_with("fn ") or
    trimmed.starts_with("async fn ") or
    trimmed.starts_with("static fn ") or
    trimmed.starts_with("extern fn ") or
    trimmed.starts_with("class ") or
    trimmed.starts_with("impl ") or
    trimmed.starts_with("enum ") or
    trimmed.starts_with("trait ") or
    trimmed.starts_with("type ") or
    trimmed.starts_with("val ") or
    trimmed.starts_with("let ") or
    trimmed.starts_with("var ") or
    trimmed.starts_with("mod ")

fn spipe_helpers_used(body: text, top_level: text) -> bool:
    val helper_names: [text] = [
        "step", "pending", "skip", "skip_it", "check", "check_msg",
        "fail_assertion", "fail_test", "fail", "assert_eq", "assert_ne",
        "assert_true", "assert_false", "assert_nil", "assert_not_nil",
        "pending_on", "pending_skip", "expect"
    ]
    var i = 0
    while i < helper_names.len():
        val needle = helper_names[i] + "("
        if body.contains(needle) or top_level.contains(needle):
            return true
        if helper_names[i] == "expect" and top_level.contains("expect "):
            return true
        i = i + 1
    false

fn preprocess_spipe_file(file_path: text) -> text:
    """Wrap SPipe file content in fn main() for native compilation.
    Returns path to temporary wrapped file, or original path if not SPipe."""
    if not file_path.ends_with("_spec.spl"):
        return file_path

    var content = read_file_content(file_path)
    if content == "":
        return file_path

    # Coverage wraps before SPipe preprocessing. Preserve its authenticated
    # source marker at byte zero instead of indenting it into generated main.
    var coverage_source_marker = ""
    val normalized_path = file_path.replace("\\", "/")
    val marker_slash = normalized_path.last_index_of("/")
    val marker_basename = if marker_slash >= 0: normalized_path[marker_slash + 1:] else: normalized_path
    if marker_basename.starts_with("simple_cov_"):
        val marker_newline = content.index_of("\n")
        if marker_newline > 0:
            val first_line = content[0:marker_newline]
            if first_line.starts_with("# simple-coverage-source: "):
                coverage_source_marker = first_line
                content = content[marker_newline + 1:]

    # Split into imports/top-level-defs and body, wrap body in fn main():
    val lines = content.split("\n")
    var import_parts: [text] = []
    var top_level_parts: [text] = []
    var body_parts: [text] = []
    # Element i pairs with lines[i]. Replaces a docstring flag that toggled on
    # ANY line starting with `"""`, so a one-line docstring switched it on and
    # nothing ever switched it off: every later import and top-level
    # declaration was pushed verbatim into the main body (1,657 spec files
    # carry a one-line docstring; measured 2026-09-06).
    val string_continuation = simple_string_continuation_lines(content)
    val code_lines = simple_code_lines(content)
    var in_top_fn = false
    var top_fn_indent = 0
    var in_import_block = false
    var import_brace_depth = 0
    var skipping_spec_import = false
    # Unclosed bracket depth of the top-level declaration currently being
    # collected (a multi-line `val XS: [text] = [` ... `]`). Non-zero keeps
    # collecting into top_level_parts regardless of indentation.
    var top_decl_depth = 0

    var line_index = 0
    while line_index < lines.len():
        val raw_line = lines[line_index]
        val fact_index = line_index
        line_index = line_index + 1
        val infix_line = spipe_rewrite_infix_expect_line(raw_line)
        val line = spipe_rewrite_method_expect_line(infix_line)
        val trimmed = line.trim()

        if skipping_spec_import:
            import_brace_depth = import_brace_depth + spipe_brace_delta(line)
            if import_brace_depth <= 0:
                skipping_spec_import = false
                import_brace_depth = 0
            continue

        if in_import_block:
            import_parts.push(line)
            import_brace_depth = import_brace_depth + spipe_brace_delta(line)
            if import_brace_depth <= 0:
                in_import_block = false
                import_brace_depth = 0
            continue

        # Track multi-line docstrings (""")
         # Docstring lines pass through verbatim: a line inside a string opened
        # earlier, or a line that is itself only a string (opener, closer, or a
        # one-liner). Fixture-string interiors pass through too, instead of
        # being classified as declarations.
        if string_continuation[fact_index] or code_lines[fact_index].trim() == "\"\"":
            if in_top_fn:
                top_level_parts.push(line)
            else:
                body_parts.push("    " + line)
            continue

        # Import/use statements go before fn main()
        if trimmed.starts_with("import ") or trimmed.starts_with("use "):
            # `std.spec` is the interpreter-only BDD harness and is replaced by
            # the inline helpers below, so its imports are dropped. The
            # `std.spec.scenario_governance` module is a plain library, and
            # `build_coverage_wrapper` injects `use std.spec.scenario_governance
            # .{scenario_governance_mcdc_exclusions_reset, ..._snapshot}` while
            # its generated MC/DC dump code calls both — dropping that line
            # left every MC/DC-lane spec at `Undefined("undefined identifier:
            # scenario_governance_mcdc_exclusions_snapshot")`.
            val is_spec_harness_import = (trimmed.starts_with("import std.spec") or
                trimmed.starts_with("use std.spec")) and
                not trimmed.starts_with("use std.spec.scenario_governance") and
                not trimmed.starts_with("import std.spec.scenario_governance")
            if is_spec_harness_import:
                val delta = spipe_brace_delta(line)
                if delta > 0:
                    skipping_spec_import = true
                    import_brace_depth = delta
                continue
            import_parts.push(trimmed)
            val delta = spipe_brace_delta(line)
            if delta > 0:
                in_import_block = true
                import_brace_depth = delta
            continue

        # Top-level declarations (at column 0 only) stay outside main.
        if not in_top_fn:
            val line_indent = line.len() - trimmed.len()
            if line_indent == 0:
                if spipe_is_top_level_start(trimmed):
                    in_top_fn = true
                    top_fn_indent = 0
                    top_decl_depth = spipe_open_bracket_delta(line)
                    if top_decl_depth < 0:
                        top_decl_depth = 0
                    top_level_parts.push(line)
                    continue

        # If we're inside a top-level function definition, keep collecting
        # lines until we see a line at the same or lesser indentation (not blank)
        if in_top_fn:
            # A declaration whose first line left brackets open continues at
            # column 0 (the closing `]`), so indentation alone cannot end it.
            if top_decl_depth > 0:
                top_decl_depth = top_decl_depth + spipe_open_bracket_delta(line)
                if top_decl_depth < 0:
                    top_decl_depth = 0
                top_level_parts.push(line)
                continue
            if trimmed.len() == 0:
                top_level_parts.push("")
                continue
            val current_indent = line.len() - trimmed.len()
            if current_indent > top_fn_indent:
                top_level_parts.push(line)
                continue
            else:
                # This line is at same/lesser indent — end of function
                in_top_fn = false
                if current_indent == 0 and spipe_is_top_level_start(trimmed):
                    in_top_fn = true
                    top_fn_indent = 0
                    top_decl_depth = spipe_open_bracket_delta(line)
                    if top_decl_depth < 0:
                        top_decl_depth = 0
                    top_level_parts.push(line)
                    continue
                # Fall through to body processing

        # Everything else goes into fn main() body
        if trimmed.len() > 0:
            body_parts.push("    " + line)
        else:
            body_parts.push("")

    val imports = import_parts.join("\n")
    val top_level = top_level_parts.join("\n")
    val body = body_parts.join("\n")
    val helpers = if spipe_helpers_used(body, top_level): spipe_inline_helpers() else: ""
    var wrapped = imports + "\n" + helpers + "\n" + top_level + "\nfn main():\n" + body
    if coverage_source_marker != "":
        wrapped = coverage_source_marker + "\n" + wrapped
    val safe_name = file_path.replace("/", "_").replace("\\", "_").replace(":", "_")
    val tmp_path = _tp_get_temp_dir() + "/spipe_wrapped_" + safe_name[0:safe_name.len() - 4] + "_native.spl"
    file_write(tmp_path, wrapped)
    tmp_path

fn cleanup_native_generated_file(path: text, original_path: text, preserved_path: text, keep_artifacts: bool):
    if not keep_artifacts and path != "" and path != original_path and path != preserved_path and file_exists(path):
        file_delete(path)

fn cleanup_native_generated_files(smf_path: text, source_path: text, wrapped_path: text, cleanup_path: text, original_path: text, keep_artifacts: bool):
    cleanup_native_generated_file(smf_path, original_path, "", keep_artifacts)
    cleanup_native_generated_file(source_path, original_path, wrapped_path, keep_artifacts)
    cleanup_native_generated_file(cleanup_path, original_path, "", keep_artifacts)

# Graceful MC/DC-on / coverage-on degradation path: run the spec directly via
# the interpreter (no coverage/MC/DC wrapper, no native SMF compile) when the
# governance-mandated always-on MC/DC mode -- or the coverage instrumentation
# wrapper (build_coverage_wrapper) -- cannot get this spec through a
# standalone compile. This covers BOTH the original "interpreter-only
# constructs" case (TryOperator, PatternMatch, CollectionLiteral, ...) and the
# separate class where the WRAPPED/relocated copy itself fails to compile
# (root-relative imports and indentation/backtick-literal reproduction can
# break when the instrumented source is written out as a fresh temp file) --
# both are structural incompatibilities of the instrumentation path, not real
# test failures, and neither may fail the spec outright. The verdict below is
# a REAL pass/fail from actually executing the ORIGINAL (unwrapped) spec --
# this never fabricates a pass and never silently swallows a real failure.
# `mcdc_skip_reason` is always populated so callers/reporters can surface that
# instrumentation was skipped for this spec, per-spec, rather than implying it
# was collected.
fn run_test_file_mcdc_interpreter_fallback(file_path: text, options: TestOptions, start: i64, fallback_tag: text, reason: text) -> TestFileResult:
    val binary = find_simple_binary()
    val timeout_ms = options.timeout * 1000
    var run_args: [text] = ["run", file_path]
    if options.gc_log:
        run_args.push("--gc-log")
    if options.gc_off:
        run_args.push("--gc=off")
    val scoped_child = _run_scoped_child(test_resource_class(file_path), binary, run_args, timeout_ms, 0, 0, 0, if options.no_limits: 0 else: options.max_procs, not options.no_limits)
    val stdout = scoped_child.result.stdout
    val stderr = scoped_child.result.stderr
    val exit_code = scoped_child.result.exit_code
    val end = time_now_unix_micros()
    val duration_ms = (end - start) / 1000
    print "[{fallback_tag}] {file_path}: {reason}"
    val base_result = make_result_from_output(file_path, stdout, stderr, exit_code, duration_ms, options.timeout)
    val evidenced = _attach_scope_evidence(base_result, scoped_child.usage, scoped_child.budget_status, file_path, options, 0, duration_ms)
    TestFileResult(
        path: evidenced.path, passed: evidenced.passed, failed: evidenced.failed,
        skipped: evidenced.skipped, pending: evidenced.pending,
        duration_ms: evidenced.duration_ms, setup_ms: evidenced.setup_ms,
        error: evidenced.error, timed_out: evidenced.timed_out, cached: evidenced.cached,
        in_development: evidenced.in_development, mcdc_evidence_v1: "",
        blocked: evidenced.blocked, unsupported: evidenced.unsupported,
        omission_evidence: evidenced.omission_evidence,
        compile_ms: 0, execution_ms: duration_ms,
        resource_usage: evidenced.resource_usage, resource_class: evidenced.resource_class,
        cohort_id: evidenced.cohort_id, budget_status: evidenced.budget_status,
        anomaly_status: evidenced.anomaly_status,
        mcdc_skip_reason: reason
    )

# --- coverage fail-closed gate (2026-08-31) -------------------------------
# A coverage run whose instrumented wrapper will not compile has NOT executed
# what the operator asked for. Reporting the unwrapped interpreter run as a
# normal pass made every green `--coverage` verdict unevidenced. Per the
# repo-wide `ERROR — nothing was checked` convention that is an ERROR, not a
# pass. Both helpers are pure so the behaviour can be pinned by a spec without
# driving a real native build.

# Only the exact opt-in value re-enables the (loud, non-evidence) degrade.
# Unset, empty, "1", "true" and every other value fail closed.
pub fn coverage_interpreter_fallback_opted_in(env_value: text) -> bool:
    env_value == "interpreter"

pub fn coverage_wrapper_abort_error(diagnostic: text) -> text:
    "ABORTED BEFORE EXECUTION — coverage instrumentation wrapper failed to compile; the spec was NEVER run under the requested coverage path, so this is NOT a test result. Compiler diagnostic: " + diagnostic + " (set SIMPLE_COVERAGE_FALLBACK=interpreter to explicitly accept an UNINSTRUMENTED interpreter run instead)"

# First NON-EMPTY line. `compile_output` is `stdout + "\n" + stderr`, so when
# the compiler wrote nothing to stdout the string starts with "\n" and a
# naive first-line take yields an empty diagnostic (observed: the printed
# "Compiler diagnostic:" was blank for every real fallback).
fn first_line(text_value: text) -> text:
    # Prefer the first line that actually names an error; the compile output is
    # dominated by seed banners and lint warnings, and taking line 1 verbatim
    # masked the real diagnostic in every fail-closed/degrade message.
    var first_non_noise = ""
    for line in text_value.split("\n"):
        val trimmed = line.trim()
        # The seed binary prints a two-line "bootstrap seed only" banner on
        # every invocation. Taking it as "the compiler diagnostic" masked the
        # real error in every fail-closed/degrade message.
        if trimmed == "" or
            trimmed.starts_with("WARNING: this Rust-built Simple binary") or
            trimmed.starts_with("Build and use the pure-Simple"):
            continue
        if trimmed.contains("error") or trimmed.contains("Error"):
            return trimmed
        if first_non_noise == "":
            first_non_noise = trimmed
    first_non_noise

fn run_test_file_native(file_path: text, options: TestOptions) -> TestFileResult:
    val binary = find_simple_binary()
    val start = time_now_unix_micros()
    val timeout_ms = options.timeout * 1000
    val configured_mcdc_mode = env_get("SIMPLE_MCDC_MODE") ?? ""
    val mcdc_enabled = configured_mcdc_mode == "on" or
        configured_mcdc_mode == "dynamic"

    # Native mode normally compiles SMF. Coverage must execute the MIR probes,
    # so it uses the LLVM AOT path and the core-C coverage owner instead.
    # Step 1: Preprocess SPipe files (wrap in fn main())
    val (wrapped_path, cleanup_path) = build_coverage_wrapper(file_path, options)
    val source_path = preprocess_spipe_file(wrapped_path)

    # Step 2: Compile to .smf via 'simple compile'. Artifact goes under the
    # temp dir, NOT beside the source: any interrupt between compile and the
    # cleanup below used to orphan a stub .smf next to the .spl, which then
    # shadowed the module and poisoned the smf cache (bug doc
    # smf_stub_shadowing_unresolved_describe_2026-07-24.md).
    val artifact_suffix = if options.coverage: ".coverage-native"
        elif mcdc_enabled: ".mcdc-native"
        else: ".smf"
    val smf_path = _tp_get_temp_dir() + "/" + file_path.replace("/", "_").replace("\\", "_").replace(":", "_").replace(".spl", artifact_suffix)
    var compile_args: [text] = []
    if options.coverage:
        compile_args = ["native-build", "--backend", "llvm", "--source", "src/lib", "--entry-closure", "--entry", source_path, "--runtime-bundle", "core-c-bootstrap", "--output", smf_path]
    else:
        compile_args = ["compile", source_path, "-o", smf_path]
    if options.verbose:
        compile_args.push("--verbose")
        print "[native] Compiling {file_path} to {smf_path}"

    val compile_started = time_now_unix_micros()
    val compile_scoped = _run_scoped_child(test_resource_class(file_path), binary, compile_args, timeout_ms, 0, 0, 0, if options.no_limits: 0 else: options.max_procs, not options.no_limits)
    val compile_ms = (time_now_unix_micros() - compile_started) / 1000
    val compile_result = compile_scoped.result
    val compile_stdout = compile_result.stdout
    val compile_stderr = compile_result.stderr
    val compile_exit = compile_result.exit_code
    val compile_output = compile_stdout + "\n" + compile_stderr

    if compile_exit != 0:
        # MC/DC-forced standalone-SMF compilation is impossible for specs
        # that use interpreter-only constructs (TryOperator, PatternMatch,
        # CollectionLiteral, ...) -- "cannot compile to standalone SMF: N
        # function(s) contain constructs that require the interpreter" is a
        # structural incompatibility, not a real test failure, and must not
        # fail the spec. Degrade to direct interpreter execution of the
        # ORIGINAL (unwrapped) source -- the wrapper's MC/DC scaffolding
        # itself depends on the same native-only path, so it cannot be
        # salvaged here -- and record truthfully that MC/DC instrumentation
        # was skipped for this spec rather than silently reporting a green
        # run with implied (but never collected) coverage evidence.
        val wrapper_active = cleanup_path != ""
        val uncompilable_construct = compile_output.contains("cannot compile to standalone SMF")
        if mcdc_enabled and not options.coverage and uncompilable_construct:
            cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)
            val reason = "MC/DC instrumentation skipped: spec cannot compile to standalone SMF (interpreter-only constructs); degraded to plain interpreter execution. Compiler diagnostic: " + first_line(compile_output)
            return run_test_file_mcdc_interpreter_fallback(file_path, options, start, "mcdc-fallback", reason)
        # FAIL CLOSED (2026-08-31): a coverage run whose instrumented wrapper
        # will not compile has NOT executed what the operator asked for. The
        # old behaviour ran the unwrapped spec on the interpreter and returned
        # its pass counts as a normal pass, so `--coverage` reported green over
        # a build that never happened. Per the repo-wide
        # `ERROR — nothing was checked` convention that is an ERROR, not a
        # pass. The degrade stays available, but only when the operator asks
        # for it explicitly via SIMPLE_COVERAGE_FALLBACK=interpreter, and even
        # then it is loudly tagged and never presented as coverage evidence.
        if options.coverage and wrapper_active and not coverage_interpreter_fallback_opted_in(env_get("SIMPLE_COVERAGE_FALLBACK") ?? ""):
            val end_abort = time_now_unix_micros()
            cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)
            return TestFileResult(
                path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: (end_abort - start) / 1000, setup_ms: 0,
                error: coverage_wrapper_abort_error(first_line(compile_output)),
                timed_out: false, cached: false,
                compile_ms: compile_ms, resource_usage: compile_scoped.usage,
                resource_class: test_resource_class(file_path),
                cohort_id: test_execution_cohort_id(file_path, options),
                budget_status: compile_scoped.budget_status,
                anomaly_status: "incomplete",
                mcdc_skip_reason: "coverage-abort: wrapper failed to compile"
            )
        if options.coverage and wrapper_active:
            # The coverage wrapper (build_coverage_wrapper) writes an
            # instrumented copy of the spec to a fresh temp file and compiles
            # THAT. Whatever the specific diagnostic (unresolved root-relative
            # import from the relocated copy, a parse break in the rewritten
            # indentation/backtick-literal reproduction, or an interpreter-only
            # construct), a failure here is a property of the instrumentation
            # copy, not evidence the spec itself is broken -- the fallback
            # below runs the REAL, unwrapped spec and reports its real
            # pass/fail, so this cannot mask a genuine defect.
            cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)
            val reason = "COVERAGE NOT COLLECTED (explicit SIMPLE_COVERAGE_FALLBACK=interpreter opt-in): wrapped spec failed to compile standalone; degraded to plain interpreter execution of the original source. Compiler diagnostic: " + first_line(compile_output)
            return run_test_file_mcdc_interpreter_fallback(file_path, options, start, "coverage-fallback", reason)
        val end = time_now_unix_micros()
        val duration_ms = (end - start) / 1000
        val error_msg = "Compilation failed: {compile_stderr}"
        cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)
        return TestFileResult(
            path: file_path,
            passed: 0,
            failed: 1,
            skipped: 0,
            pending: 0,
            duration_ms: duration_ms,
            setup_ms: 0,
            error: error_msg,
            timed_out: false,
            cached: false,
            compile_ms: compile_ms, resource_usage: compile_scoped.usage,
            resource_class: if file_path.contains("/03_system/"): "system" elif file_path.contains("/02_integration/"): "integration" else: "unit",
            cohort_id: test_execution_cohort_id(file_path, options), budget_status: compile_scoped.budget_status, anomaly_status: "incomplete"
        )

    if options.coverage:
        val (compiler_manifest, compiler_manifest_valid) = extract_compiler_coverage_manifest_sdn(compile_output)
        if not compiler_manifest_valid or not record_compiler_decision_manifest_sdn(compiler_manifest):
            val end = time_now_unix_micros()
            val duration_ms = (end - start) / 1000
            cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)
            return TestFileResult(
                path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: duration_ms, setup_ms: 0,
                error: "test-runner: missing or malformed compiler coverage manifest",
                timed_out: false, cached: false
            )

    # Both values cross the conditional extraction/persistence region and are
    # consumed when the child argv is assembled. Keep their lexical owner at
    # function scope; branch-local tuple bindings cannot be loaded afterward.
    var mcdc_manifest = ""
    var mcdc_manifest_path = ""
    if mcdc_enabled:
        val (extracted_mcdc_manifest, mcdc_manifest_valid) =
            extract_compiler_mcdc_obligation_manifest(compile_output)
        if not mcdc_manifest_valid:
            cleanup_native_generated_files(smf_path, source_path, wrapped_path,
                cleanup_path, file_path, options.keep_artifacts)
            return TestFileResult(
                path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: (time_now_unix_micros() - start) / 1000,
                setup_ms: 0,
                error: "test-runner: missing or malformed MC/DC obligation manifest",
                timed_out: false, cached: false
            )
        mcdc_manifest = extracted_mcdc_manifest
        # O_EXCL rejects pre-existing files (including symlinks). A fresh CSPRNG
        # name in the private runner temp directory prevents tested code from
        # predicting the handoff path before creation.
        var manifest_attempt = 0
        while manifest_attempt < 4 and mcdc_manifest_path == "":
            val nonce = test_runner_random_hex(16) ?? ""
            if nonce != nil:
                val candidate = _tp_get_temp_dir() + "/mcdc-" + nonce.unwrap() + ".obligations.sdn"
                if rt_file_create_excl(candidate, mcdc_manifest):
                    mcdc_manifest_path = candidate
            manifest_attempt = manifest_attempt + 1
        if mcdc_manifest_path == "" or rt_package_chmod(mcdc_manifest_path, 256) != 0:
            if mcdc_manifest_path != "" and file_exists(mcdc_manifest_path): file_delete(mcdc_manifest_path)
            cleanup_native_generated_files(smf_path, source_path, wrapped_path,
                cleanup_path, file_path, options.keep_artifacts)
            return TestFileResult(
                path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: (time_now_unix_micros() - start) / 1000,
                setup_ms: 0, error: "test-runner: cannot securely persist MC/DC obligation manifest",
                timed_out: false, cached: false
            )

    # Step 3: Run the compiled .smf
    if options.verbose:
        print "[native] Running {smf_path}"

    val run_binary = if options.coverage: smf_path else: binary
    var run_args: [text] = if options.coverage: [] else: [smf_path]
    if options.gc_log and not options.coverage:
        run_args.push("--gc-log")
    if options.gc_off and not options.coverage:
        run_args.push("--gc=off")
    for manifest_arg in mcdc_manifest_transport_args(mcdc_manifest_path, mcdc_manifest):
        run_args.push(manifest_arg)

    var stdout = ""
    var stderr = ""
    var exit_code = 0
    val memory_bytes = if (options.max_mem_gb > 0 and not options.no_limits): options.max_mem_gb * 1024 * 1024 * 1024 else: 0
    val run_started = time_now_unix_micros()
    val run_scoped = _run_scoped_child(test_resource_class(file_path), run_binary, run_args, timeout_ms, memory_bytes, 0, 0, if options.no_limits: 0 else: options.max_procs, not options.no_limits)
    val execution_ms = (time_now_unix_micros() - run_started) / 1000
    stdout = run_scoped.result.stdout
    stderr = run_scoped.result.stderr
    exit_code = run_scoped.result.exit_code
    if run_scoped.result.limit_exceeded:
        val end2 = time_now_unix_micros()
        val dur = (end2 - start) / 1000
        cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)
        return TestFileResult(path: file_path, passed: 0, failed: if limit_is_unverified(run_scoped.result.limit_type): 0 else: 1, skipped: 0, pending: 0,
            duration_ms: dur, setup_ms: 0, error: limit_exceeded_message(run_scoped.result, options), timed_out: run_scoped.result.limit_type.contains("timeout"), cached: false,
            compile_ms: compile_ms, execution_ms: execution_ms,
            resource_usage: _combine_usage(compile_scoped.usage, run_scoped.usage),
            resource_class: if file_path.contains("/03_system/"): "system" elif file_path.contains("/02_integration/"): "integration" else: "unit",
            cohort_id: test_execution_cohort_id(file_path, options), budget_status: run_scoped.budget_status, anomaly_status: "incomplete")
    val end = time_now_unix_micros()
    val duration_ms = (end - start) / 1000

    if mcdc_manifest_path != "" and not options.keep_artifacts and file_exists(mcdc_manifest_path):
        file_delete(mcdc_manifest_path)

    # Clean up .smf artifact unless keeping
    cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)

    if options.coverage:
        val combined = stdout + "\n" + stderr
        val sdn = extract_coverage_sdn(combined)
        record_coverage_sdn(sdn)
        stdout = strip_coverage_blocks(stdout)
        stderr = strip_coverage_blocks(stderr)

    val base_result = make_result_from_output(file_path, stdout, stderr, exit_code, duration_ms, options.timeout)
    _attach_scope_evidence(base_result, _combine_usage(compile_scoped.usage, run_scoped.usage), run_scoped.budget_status, file_path, options, compile_ms, execution_ms)

fn run_test_file_compile(file_path: text, options: TestOptions) -> TestFileResult:
    """Compile mode: compile test file to .smf and run it.
    Delegates to run_test_file_native which already does compile-then-run."""
    run_test_file_native(file_path, options)

fn mcdc_manifest_transport_args(path: text, manifest: text) -> [text]:
    if path == "":
        return []
    [
        "--simple-mcdc-manifest={path}",
        "--simple-mcdc-manifest-length={manifest.len()}",
        "--simple-mcdc-manifest-sha256={sha256_text(manifest)}",
    ]

# =========================================================================
# G1: Safe mode execution with resource limits
# =========================================================================

fn run_test_file_safe_mode(file_path: text, options: TestOptions) -> TestFileResult:
    val binary = find_simple_binary()
    val start = time_now_unix_micros()
    val timeout_ms = options.timeout * 1000
    val memory_bytes = 512 * 1024 * 1024
    val cpu_seconds = 30
    val max_fds = 256
    val max_procs = 64

    var run_args: [text] = [file_path]
    if options.gc_log:
        run_args.push("--gc-log")
    if options.gc_off:
        run_args.push("--gc=off")

    val scoped_child = _run_scoped_child(ExecutionResourceClass.System, binary, run_args, timeout_ms, memory_bytes, cpu_seconds * 1000, max_fds, max_procs, true)
    val result = scoped_child.result
    val end = time_now_unix_micros()
    val duration_ms = (end - start) / 1000

    if result.limit_exceeded:
        return TestFileResult(
            path: file_path,
            passed: 0,
            failed: 1,
            skipped: 0,
            pending: 0,
            duration_ms: duration_ms,
            setup_ms: 0,
            error: "Resource limit exceeded: {result.limit_type}",
            timed_out: result.limit_type.contains("timeout"),
            cached: false,
            execution_ms: duration_ms, resource_usage: scoped_child.usage,
            resource_class: "safe", cohort_id: test_execution_cohort_id(file_path, options),
            budget_status: scoped_child.budget_status, anomaly_status: "incomplete"
        )

    val base_result = make_result_from_output(file_path, result.stdout, result.stderr, result.exit_code, duration_ms, options.timeout)
    _attach_scope_evidence(base_result, scoped_child.usage, scoped_child.budget_status, file_path, options, 0, duration_ms)

