# Test Database File Locking
#
# PID-based file locking with timeout and stale lock detection.
# Uses file_lock/file_unlock SFFI for OS-level locking.

use std.nogc_sync_mut.io.file_ops.{file_lock, file_unlock}

# =========================================================================
# TestDbFileLock
# =========================================================================

struct TestDbFileLock:
    handle: i64
    path: text

impl TestDbFileLock:
    static fn acquire(path: text, timeout_secs: i64) -> TestDbFileLock?:
        # Lock a sidecar `.lock` file rather than the data file itself: on
        # Windows LockFileEx holds a mandatory lock on the target, which makes
        # concurrent/post-lock file_read/file_copy/atomic_rename inside
        # write_db_file_locked and update_db_file fail with a lock violation.
        val lock_path = "{path}.lock"
        val handle = file_lock(lock_path, timeout_secs)
        if handle < 0:
            eprint("Failed to acquire lock for {path} (timeout: {timeout_secs}s)")
            return None
        TestDbFileLock(handle: handle, path: path)

    fn release() -> bool:
        if self.handle < 0:
            return false
        file_unlock(self.handle)

    fn is_valid() -> bool:
        self.handle >= 0

