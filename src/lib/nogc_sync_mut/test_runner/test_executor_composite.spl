# Test Executor Composite Platform Support
#
# Composite platform execution: baremetal, remote, QEMU targets.
#
# Split from test_runner_execute.spl for maintainability.

use std.test_runner.test_runner_types.{TestFileResult, TestOptions, TEST_OUTPUT_CAPTURE_BYTES}
use std.test_runner.test_executor_parsing.{find_simple_binary, build_child_args, make_result_from_output, parse_test_output, apply_hosted_lane_child_error}
use std.test_runner.test_runner_metrics.{test_execution_cohort_id}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass, ExecutionScopeResult, standard_resource_budget, execution_resource_scope_with_budget, run_in_execution_resource_scope}
use std.common.perf.execution_metrics.{ResourceBudget, decision_status_name}
use std.test_runner.gpu_lane_common.{route_gpu_lane, gpu_lane_id_for, probe_gpu_symbols, probe_gpu_driver_present}

# =========================================================================
# Composite Platform Execution
# =========================================================================

fn run_composite_scoped(resource_class: ExecutionResourceClass, cmd: text, args: [text], timeout_ms: i64) -> ExecutionScopeResult:
    val defaults = standard_resource_budget(resource_class)
    val budget = ResourceBudget(
        max_wall_ms: timeout_ms, max_cpu_ms: defaults.max_cpu_ms,
        max_tree_charge_bytes: defaults.max_tree_charge_bytes,
        max_direct_child_rss_bytes: defaults.max_direct_child_rss_bytes,
        max_io_read_bytes: defaults.max_io_read_bytes,
        max_io_write_bytes: defaults.max_io_write_bytes,
        max_pids: defaults.max_pids, max_fds: defaults.max_fds)
    run_in_execution_resource_scope(
        execution_resource_scope_with_budget(resource_class, budget, TEST_OUTPUT_CAPTURE_BYTES),
        cmd, args)

fn attach_composite_scope(result: TestFileResult, scoped: ExecutionScopeResult, resource_class: text, duration_ms: i64, file_path: text, options: TestOptions) -> TestFileResult:
    result.execution_ms = duration_ms
    result.resource_usage = scoped.process.usage
    result.resource_class = resource_class
    result.cohort_id = test_execution_cohort_id(file_path, options)
    result.budget_status = decision_status_name(scoped.budget_decision.status)
    result.anomaly_status = "provisional"
    result

fn run_test_file_composite(file_path: text, options: TestOptions, spec: text) -> TestFileResult:
    """Execute test in composite platform mode."""
    val setup_start = time_now_unix_micros()
    val base = extract_base_runtime(spec)
    val platform = extract_platform_layer(spec)
    val arch = extract_arch_from_spec(spec)
    val remote_backend = extract_remote_backend(spec)
    val target = extract_target_from_spec(spec)
    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    # Dispatch to platform-specific runner.
    # Base runtime takes precedence so nested specs like
    # jit(remote(baremetal(stm32h7))) still reach the JIT lane.
    if base == "jit":
        return run_test_file_jit(file_path: file_path, options, arch: arch, target: target)
    if platform == "baremetal":
        return run_test_file_baremetal(file_path: file_path, options, base: base, arch: arch)
    if platform == "remote":
        return run_test_file_remote(
            file_path: file_path,
            options,
            base: base,
            arch: arch,
            target: target,
            remote_backend: remote_backend
        )
    if platform == "jit":
        return run_test_file_jit(file_path: file_path, options, arch: arch, target: target)

    TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
        duration_ms: 0, setup_ms: setup_ms, error: "Unknown platform: {platform}", timed_out: false, cached: false)

fn extract_base_runtime(spec: text) -> text:
    """Extract base runtime from composite spec (e.g. 'interpreter' from 'interpreter(baremetal(riscv32))')."""
    val paren = spec.index_of("(")
    if paren > 0:
        return spec[0:paren].trim()
    spec.trim()

fn extract_platform_layer(spec: text) -> text:
    """Extract platform layer from composite spec (e.g. 'baremetal' from 'interpreter(baremetal(riscv32))')."""
    val paren = spec.index_of("(")
    if paren < 0: return ""
    val after = spec[paren + 1:]
    val paren2 = after.index_of("(")
    if paren2 > 0: return after[0:paren2].trim()
    val close = after.index_of(")")
    if close > 0: return after[0:close].trim()
    ""

fn _gpu_backend_token(spec: text, backend: text) -> text:
    """Extract the token immediately inside `remote(<backend>(...))`, e.g.
    'sm80' from 'remote(cuda(sm80(resident)))' or 'spv15' from
    'remote(vulkan(spv15))'. Returns '' if the backend marker is absent."""
    val marker = "remote({backend}("
    val idx = spec.index_of(marker)
    if idx < 0:
        return ""
    val after = spec[idx + marker.len():]
    val paren_idx = after.index_of("(")
    val close_idx = after.index_of(")")
    var end = after.len()
    if paren_idx >= 0 and (close_idx < 0 or paren_idx < close_idx):
        end = paren_idx
    elif close_idx >= 0:
        end = close_idx
    after[0:end].trim()

fn extract_arch_from_spec(spec: text) -> text:
    """Extract target architecture from composite spec."""
    if spec.contains("remote(cuda(") or spec.contains("remote(cudagdb("):
        return "ptx64"
    if spec.contains("remote(vulkan("):
        return "spirv"
    if spec.contains("riscv32"): return "riscv32"
    if spec.contains("stm32h7"): return "arm32"
    if spec.contains("stm32wb"): return "arm32"
    if spec.contains("arm32"): return "arm32"
    if spec.contains("aarch64"): return "aarch64"
    if spec.contains("x86_64"): return "x86_64"
    if spec.contains("x86"): return "x86"
    "host"

fn extract_target_from_spec(spec: text) -> text:
    """Extract board/target identifier from composite spec."""
    if spec.contains("trace32") or spec.contains("t32"):
        if spec.contains("stm32h7"): return "trace32_stm32h7"
        if spec.contains("stm32wb"): return "trace32_stm32wb"
        return "trace32_stm32h7"
    if spec.contains("ch32v307"): return "ch32v307"
    if spec.contains("ghdl") or spec.contains("rtl_rv32"): return "ghdl_rv32"
    if spec.contains("remote(cuda("):
        val token = _gpu_backend_token(spec, "cuda")
        val sm = if token == "": "sm80" else: token
        return "cuda_{sm}"
    if spec.contains("remote(cudagdb("):
        val token = _gpu_backend_token(spec, "cudagdb")
        val sm = if token == "": "sm80" else: token
        return "cudagdb_{sm}"
    if spec.contains("remote(vulkan("):
        val token = _gpu_backend_token(spec, "vulkan")
        val spv = if token == "": "spv15" else: token
        return "vulkan_{spv}"
    if spec.contains("stm32h7"): return "stm32h7"
    if spec.contains("stm32wb"): return "stm32wb"
    if spec.contains("riscv32"): return "riscv32"
    if spec.contains("arm32"): return "arm32"
    if spec.contains("aarch64"): return "aarch64"
    if spec.contains("x86_64"): return "x86_64"
    if spec.contains("x86"): return "x86"
    "host"

fn extract_remote_backend(spec: text) -> text:
    """Extract explicit remote transport backend from composite spec."""
    if spec.contains("remote(t32(") or spec.contains("remote(trace32("):
        return "t32"
    if spec.contains("remote(openocd("):
        return "openocd"
    if spec.contains("remote(ghdl(") or spec.contains("baremetal(ghdl("):
        return "ghdl"
    if spec.contains("remote(cuda("):
        return "cuda"
    if spec.contains("remote(vulkan("):
        return "vulkan"
    if spec.contains("remote(cudagdb("):
        return "cudagdb"
    ""

fn extract_gpu_submode(spec: text) -> text:
    """Extract the GPU lane submode ('launch'/'resident'/'dispatch') from a
    composite spec, per design doc §2.2. Vulkan is always 'dispatch' and never
    accepts 'resident' (per-dispatch execution has no forward-progress
    guarantee); attempting it returns the rejection diagnostic text instead of
    a submode string."""
    val is_vulkan = spec.contains("remote(vulkan(")
    val is_cuda = spec.contains("remote(cuda(") or spec.contains("remote(cudagdb(")
    if is_vulkan:
        if spec.contains("(resident)"):
            return "resident submode requires forward-progress guarantees; vulkan lanes are per-dispatch (see gpu_remote_interpreter_architecture.md §6.3)"
        return "dispatch"
    if is_cuda:
        if spec.contains("(resident)"):
            return "resident"
        return "launch"
    ""

fn run_test_file_baremetal(file_path: text, options: TestOptions, base: text, arch: text) -> TestFileResult:
    """Execute test on bare-metal target.

    Strategy:
    - .spl files: always run via host interpreter (they may invoke QEMU themselves)
    - .elf files: run directly on QEMU with semihosting
    """
    # All .spl test files run via the host interpreter.
    # Tests that need QEMU invoke it themselves through bounded capture.
    # Pure-logic tests just check constants and run without QEMU.
    if file_path.ends_with(".spl"):
        return run_test_file_baremetal_via_interpreter(file_path: file_path, options, arch: arch)

    # For ELF files, run directly on QEMU
    if file_path.ends_with(".elf"):
        return run_test_file_baremetal_qemu(file_path: file_path, options, arch: arch, elf_path: file_path)

    # Fallback: interpreter
    run_test_file_baremetal_via_interpreter(file_path: file_path, options, arch: arch)

fn run_test_file_baremetal_via_interpreter(file_path: text, options: TestOptions, arch: text) -> TestFileResult:
    """Run baremetal logic test via host interpreter."""
    val setup_start = time_now_unix_micros()
    val binary = find_simple_binary()
    val child_args = build_child_args(file_path, options)
    val timeout_ms = options.timeout * 1000
    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    val test_start = time_now_unix_micros()
    val scoped = run_composite_scoped(ExecutionResourceClass.System, binary, child_args, timeout_ms)
    val test_end = time_now_unix_micros()
    val duration_ms = (test_end - test_start) / 1000
    var result = make_result_from_output(file_path, scoped.process.stdout, scoped.process.stderr, scoped.process.usage.exit_code, duration_ms, options.timeout)
    result.setup_ms = setup_ms
    attach_composite_scope(result, scoped, "system", duration_ms, file_path, options)

fn find_baremetal_elf(spec_file: text, arch: text) -> text:
    """Find prebuilt ELF for a baremetal spec file."""
    val base_dir = "examples/09_embedded/baremetal/baremetal"
    # Check for C test ELF in riscv32_test directory
    if arch == "riscv32":
        val elf = "{base_dir}/riscv32_test/test_riscv32_intensive.elf"
        if file_exists(elf):
            return elf
    # Check for SPipe-format semihost ELF
    if arch == "riscv32":
        val elf = "{base_dir}/hello_riscv32_spipe.elf"
        if file_exists(elf):
            return elf
    # Check for basic semihost ELF
    if arch == "riscv32":
        val elf = "{base_dir}/hello_riscv32_semihost.elf"
        if file_exists(elf):
            return elf
    ""

fn qemu_binary_for_arch(arch: text) -> text:
    """Get QEMU system binary for target architecture."""
    if arch == "riscv32": return "qemu-system-riscv32"
    if arch == "riscv64": return "qemu-system-riscv64"
    if arch == "arm32": return "qemu-system-arm"
    if arch == "aarch64": return "qemu-system-aarch64"
    if arch == "x86": return "qemu-system-i386"
    if arch == "x86_64": return "qemu-system-x86_64"
    ""

fn qemu_machine_for_arch(arch: text) -> text:
    """Get QEMU machine type for target architecture."""
    if arch == "riscv32": return "virt"
    if arch == "riscv64": return "virt"
    if arch == "arm32": return "virt"
    if arch == "aarch64": return "virt"
    if arch == "x86": return "pc"
    if arch == "x86_64": return "q35"
    "virt"

fn run_test_file_baremetal_ghdl(file_path: text, options: TestOptions, elf_path: text) -> TestFileResult:
    """Execute a prebuilt ELF on the RV32 GHDL semihosting runner."""
    val setup_start = time_now_unix_micros()
    val timeout_secs = if options.timeout <= 0: 30 else: options.timeout
    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    val timeout_ms = timeout_secs * 1000
    val test_start = time_now_unix_micros()
    val scoped = run_composite_scoped(
        ExecutionResourceClass.System,
        "bash",
        ["src/lib/nogc_async_mut_noalloc/baremetal/ghdl_runner.shs", elf_path, "--timeout={timeout_secs}"],
        timeout_ms
    )
    val test_end = time_now_unix_micros()
    val duration_ms = (test_end - test_start) / 1000

    var result = make_result_from_output(file_path, scoped.process.stdout, scoped.process.stderr, scoped.process.usage.exit_code, duration_ms, timeout_secs)
    result.setup_ms = setup_ms
    attach_composite_scope(result, scoped, "system", duration_ms, file_path, options)

fn run_test_file_baremetal_qemu(file_path: text, options: TestOptions, arch: text, elf_path: text) -> TestFileResult:
    """Execute a prebuilt ELF on QEMU with semihosting and parse results."""
    val setup_start = time_now_unix_micros()
    val qemu_bin = qemu_binary_for_arch(arch)
    val machine = qemu_machine_for_arch(arch)

    if qemu_bin == "":
        val setup_end = time_now_unix_micros()
        val setup_ms = (setup_end - setup_start) / 1000
        return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
            duration_ms: 0, setup_ms: setup_ms, error: "No QEMU binary for arch: {arch}", timed_out: false, cached: false)

    # Build QEMU command args
    var qemu_args: [text] = [
        "-M", machine,
        "-bios", "none",
        "-kernel", elf_path,
        "-nographic",
        "-semihosting-config", "enable=on,target=native",
    ]

    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    val timeout_ms = options.timeout * 1000
    val test_start = time_now_unix_micros()
    val scoped = run_composite_scoped(ExecutionResourceClass.Qemu, qemu_bin, qemu_args, timeout_ms)
    val test_end = time_now_unix_micros()
    val duration_ms = (test_end - test_start) / 1000

    # Parse SPipe-format output from QEMU semihosting
    var result = make_result_from_output(file_path, scoped.process.stdout, scoped.process.stderr, scoped.process.usage.exit_code, duration_ms, options.timeout)
    result.setup_ms = setup_ms
    attach_composite_scope(result, scoped, "qemu", duration_ms, file_path, options)

# =========================================================================
# Hosted lanes — GPU executors and JIT upload lanes
#
# These lanes need host capabilities (GPU drivers, debug probes, simulators)
# and hosted runtime symbols (rt_cuda_*, rt_vulkan_*, rt_ghdl_*, TRACE32
# sockets) that the core runner does not link. They live in
# test_executor_hosted_lanes.spl and run in a child interpreter via
# src/app/test_runner_new/hosted_lane_main.spl, so the capability is loaded
# only when such a spec is actually routed and a host without it reports the
# child's named error instead of the core runner failing to link.
# =========================================================================

val HOSTED_LANE_ENTRY = "src/app/test_runner_new/hosted_lane_main.spl"

fn run_hosted_lane_child(file_path: text, options: TestOptions, lane_args: [text], setup_ms: i64) -> TestFileResult:
    val binary = find_simple_binary()
    val timeout_ms = options.timeout * 1000
    var args: [text] = ["run", HOSTED_LANE_ENTRY, "--file={file_path}", "--timeout={options.timeout}", "--setup-ms={setup_ms}"]
    for arg in lane_args:
        args.push(arg)
    val test_start = time_now_unix_micros()
    val scoped = run_composite_scoped(ExecutionResourceClass.System, binary, args, timeout_ms)
    val test_end = time_now_unix_micros()
    val duration_ms = (test_end - test_start) / 1000
    var result = make_result_from_output(file_path, scoped.process.stdout, scoped.process.stderr, scoped.process.usage.exit_code, duration_ms, options.timeout)
    # The child exits 0 for a `skip:` probe failure; keep its named error so it
    # classifies as error/skip-with-reason exactly as the in-process lane did.
    result = apply_hosted_lane_child_error(result, scoped.process.stdout, scoped.process.usage.exit_code)
    result.setup_ms = setup_ms
    attach_composite_scope(result, scoped, "system", duration_ms, file_path, options)

fn run_test_file_gpu_lane_dispatch(file_path: text, options: TestOptions, remote_backend: text, base_runtime: text) -> TestFileResult:
    """Top-level routing hook for `remote_backend in {cuda, vulkan}`. Runs
    the same host-aware probes as before (symbols first, so an interpreter
    gap is never masked by a driver-absent skip) and, once driver+symbols
    are ready, dispatches through the matching concrete executor
    (cuda_jit/cuda_vm/vulkan_jit/vulkan_vm) instead of a static
    not-yet-implemented FAIL. Falls back to `route_gpu_lane`'s honest
    not-yet-implemented FAIL for lane ids with no concrete executor yet
    (cuda_vm_resident, cudagdb)."""
    val setup_start = time_now_unix_micros()
    val missing_symbol = probe_gpu_symbols(remote_backend)
    val driver_present = if missing_symbol != "": false else: probe_gpu_driver_present(remote_backend)
    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    if missing_symbol != "" or not driver_present:
        return route_gpu_lane(file_path: file_path, setup_ms: setup_ms, remote_backend: remote_backend,
            driver_present: driver_present, missing_symbol: missing_symbol)

    val lane_id = gpu_lane_id_for(base_runtime, remote_backend)
    if lane_id == "cuda_jit" or lane_id == "vulkan_jit" or lane_id == "cuda_vm" or lane_id == "vulkan_vm":
        return run_hosted_lane_child(file_path, options, ["--hosted-lane=gpu", "--gpu-lane={lane_id}"], setup_ms)

    route_gpu_lane(file_path: file_path, setup_ms: setup_ms, remote_backend: remote_backend,
        driver_present: driver_present, missing_symbol: missing_symbol)

fn run_test_file_remote(file_path: text, options: TestOptions, base: text, arch: text, target: text, remote_backend: text) -> TestFileResult:
    """Execute test on remote target via QEMU.

    For .spl files: run via host interpreter (same as baremetal mode).
    For .elf files: launch QEMU with semihosting, capture output, parse results.
    """
    val start = time_now_unix_micros()

    if remote_backend == "cuda" or remote_backend == "vulkan":
        return run_test_file_gpu_lane_dispatch(file_path, options, remote_backend, base)

    # .spl files run via host interpreter — they may invoke QEMU themselves
    if file_path.ends_with(".spl"):
        return run_test_file_baremetal_via_interpreter(file_path: file_path, options, arch: arch)

    # .elf files run directly on QEMU with semihosting
    if file_path.ends_with(".elf"):
        if target == "ghdl_rv32" or remote_backend == "ghdl":
            return run_test_file_baremetal_ghdl(file_path: file_path, options, elf_path: file_path)
        return run_test_file_baremetal_qemu(file_path: file_path, options, arch: arch, elf_path: file_path)

    # Unknown file type — try to find a prebuilt ELF for this spec
    val elf_path = find_baremetal_elf(spec_file: file_path, arch: arch)
    if elf_path != "":
        if target == "ghdl_rv32" or remote_backend == "ghdl":
            return run_test_file_baremetal_ghdl(file_path: file_path, options, elf_path: elf_path)
        return run_test_file_baremetal_qemu(file_path: file_path, options, arch: arch, elf_path: elf_path)

    # Fallback: run via host interpreter
    run_test_file_baremetal_via_interpreter(file_path: file_path, options, arch: arch)

fn run_test_file_jit(file_path: text, options: TestOptions, arch: text, target: text) -> TestFileResult:
    """Execute test via JIT upload to a remote target, in the hosted-lane child."""
    run_hosted_lane_child(file_path, options, ["--hosted-lane=jit", "--arch={arch}", "--target={target}"], 0)

# =========================================================================
# Exports
# =========================================================================
