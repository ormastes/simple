# Compatibility facade for callers of the original Unix monitor helper.
use std.nogc_sync_mut.io.env_ops.{host_os}
use std.nogc_sync_mut.sosix.host_process_launch.{sosix_launch_background_script_for_host}

pub fn launch_monitor_script_detached(script_path: text) -> text:
    val result = sosix_launch_background_script_for_host(host_os(), script_path)
    if result == "unsupported":
        ""
    else:
        result
