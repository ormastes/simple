# Pure parser helpers for composite test execution specs.
#
# Kept separate from test_executor_composite.spl so routing specs can validate
# nested runtime/platform/target parsing without loading remote/JIT backends.

fn extract_base_runtime(spec: text) -> text:
    val paren = spec.index_of("(")
    if paren > 0:
        return spec[0:paren].trim()
    spec.trim()

fn extract_platform_layer(spec: text) -> text:
    val paren = spec.index_of("(")
    if paren < 0: return ""
    val after = spec[paren + 1:]
    val paren2 = after.index_of("(")
    if paren2 > 0: return after[0:paren2].trim()
    val close = after.index_of(")")
    if close > 0: return after[0:close].trim()
    ""

fn _gpu_backend_token(spec: text, backend: text) -> text:
    """Extract the token immediately inside `remote(<backend>(...))`, e.g.
    'sm80' from 'remote(cuda(sm80(resident)))' or 'spv15' from
    'remote(vulkan(spv15))'. Returns '' if the backend marker is absent."""
    val marker = "remote({backend}("
    val idx = spec.index_of(marker)
    if idx < 0:
        return ""
    val after = spec[idx + marker.len():]
    val paren_idx = after.index_of("(")
    val close_idx = after.index_of(")")
    var end = after.len()
    if paren_idx >= 0 and (close_idx < 0 or paren_idx < close_idx):
        end = paren_idx
    elif close_idx >= 0:
        end = close_idx
    after[0:end].trim()

fn extract_arch_from_spec(spec: text) -> text:
    if spec.contains("remote(cuda(") or spec.contains("remote(cudagdb("):
        return "ptx64"
    if spec.contains("remote(vulkan("):
        return "spirv"
    if spec.contains("remote(metal("):
        return "msl"
    if spec.contains("riscv32"): return "riscv32"
    if spec.contains("stm32h7"): return "arm32"
    if spec.contains("stm32wb"): return "arm32"
    if spec.contains("arm32"): return "arm32"
    if spec.contains("aarch64"): return "aarch64"
    if spec.contains("x86_64"): return "x86_64"
    if spec.contains("x86"): return "x86"
    "host"

fn extract_target_from_spec(spec: text) -> text:
    if spec.contains("trace32") or spec.contains("t32"):
        if spec.contains("stm32h7"): return "trace32_stm32h7"
        if spec.contains("stm32wb"): return "trace32_stm32wb"
        return "trace32_stm32h7"
    if spec.contains("ch32v307"): return "ch32v307"
    if spec.contains("ghdl") or spec.contains("rtl_rv32"): return "ghdl_rv32"
    if spec.contains("remote(cuda("):
        val token = _gpu_backend_token(spec, "cuda")
        val sm = if token == "": "sm80" else: token
        return "cuda_{sm}"
    if spec.contains("remote(cudagdb("):
        val token = _gpu_backend_token(spec, "cudagdb")
        val sm = if token == "": "sm80" else: token
        return "cudagdb_{sm}"
    if spec.contains("remote(vulkan("):
        val token = _gpu_backend_token(spec, "vulkan")
        val spv = if token == "": "spv15" else: token
        return "vulkan_{spv}"
    if spec.contains("remote(metal("):
        val token = _gpu_backend_token(spec, "metal")
        val msl = if token == "": "msl2" else: token
        return "metal_{msl}"
    if spec.contains("stm32h7"): return "stm32h7"
    if spec.contains("stm32wb"): return "stm32wb"
    if spec.contains("riscv32"): return "riscv32"
    if spec.contains("arm32"): return "arm32"
    if spec.contains("aarch64"): return "aarch64"
    if spec.contains("x86_64"): return "x86_64"
    if spec.contains("x86"): return "x86"
    "host"

fn extract_remote_backend(spec: text) -> text:
    if spec.contains("remote(t32(") or spec.contains("remote(trace32("):
        return "t32"
    if spec.contains("remote(openocd("):
        return "openocd"
    if spec.contains("remote(ghdl(") or spec.contains("baremetal(ghdl("):
        return "ghdl"
    if spec.contains("remote(cuda("):
        return "cuda"
    if spec.contains("remote(vulkan("):
        return "vulkan"
    if spec.contains("remote(cudagdb("):
        return "cudagdb"
    if spec.contains("remote(metal("):
        return "metal"
    ""

fn extract_gpu_submode(spec: text) -> text:
    """Extract the GPU lane submode ('launch'/'resident'/'dispatch') from a
    composite spec, per design doc §2.2. Vulkan and Metal are always
    'dispatch' and never accept 'resident' (per-dispatch execution has no
    forward-progress guarantee); attempting it returns the rejection
    diagnostic text instead of a submode string. Metal has no CUDA-style
    persistent-kernel + doorbell-ring primitive (see
    metal_gpu_lane_and_vulkan_jit_notebook_architecture_2026-08-09.md §1)."""
    val is_vulkan = spec.contains("remote(vulkan(")
    val is_metal = spec.contains("remote(metal(")
    val is_cuda = spec.contains("remote(cuda(") or spec.contains("remote(cudagdb(")
    if is_vulkan:
        if spec.contains("(resident)"):
            return "resident submode requires forward-progress guarantees; vulkan lanes are per-dispatch (see gpu_remote_interpreter_architecture.md §6.3)"
        return "dispatch"
    if is_metal:
        if spec.contains("(resident)"):
            return "resident submode requires forward-progress guarantees; metal lanes are per-dispatch (see metal_gpu_lane_and_vulkan_jit_notebook_architecture_2026-08-09.md §1)"
        return "dispatch"
    if is_cuda:
        if spec.contains("(resident)"):
            return "resident"
        return "launch"
    ""

fn qemu_binary_for_arch(arch: text) -> text:
    if arch == "riscv32": return "qemu-system-riscv32"
    if arch == "riscv64": return "qemu-system-riscv64"
    if arch == "arm32": return "qemu-system-arm"
    if arch == "aarch64": return "qemu-system-aarch64"
    if arch == "x86": return "qemu-system-i386"
    if arch == "x86_64": return "qemu-system-x86_64"
    ""

fn qemu_machine_for_arch(arch: text) -> text:
    if arch == "riscv32": return "virt"
    if arch == "riscv64": return "virt"
    if arch == "arm32": return "virt"
    if arch == "aarch64": return "virt"
    if arch == "x86": return "pc"
    if arch == "x86_64": return "q35"
    "virt"

export extract_base_runtime, extract_platform_layer, extract_arch_from_spec
export extract_target_from_spec, extract_remote_backend, extract_gpu_submode
export qemu_binary_for_arch, qemu_machine_for_arch
