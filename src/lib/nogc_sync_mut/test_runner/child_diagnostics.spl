# Reserved child-owner protocol lines, not arbitrary source/trace substrings.
fn native_cleanup_diagnostic(stdout: text, stderr: text) -> text:
    for line in (stdout + "\n" + stderr).split("\n"):
        val diagnostic = line.trim()
        if diagnostic == "error: NATIVE-CACHE-CLEANUP-FAILED" or diagnostic.starts_with("error: NATIVE-CACHE-CLEANUP-FAILED:"):
            return diagnostic
    ""

export native_cleanup_diagnostic
