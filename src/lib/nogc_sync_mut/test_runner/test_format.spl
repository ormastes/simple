# Test Format Detection
#
# Names the format a test file is run as, mirroring the runner's routing:
# Markdown -> sdoctest (`--sdoctest`), non-spec .spl -> comment doctest
# (`--spl-doctest`), a spec using `step(...)` -> sspec, any other spec -> spec.

use std.test_runner.test_manifest_scanner.{is_spec_file}

fn test_format_of(path: text, content: text) -> text:
    if path.ends_with(".md"):
        return "md"
    if not is_spec_file(path):
        return "comment"
    if content.contains("step("):
        return "sspec"
    "spec"

export test_format_of
