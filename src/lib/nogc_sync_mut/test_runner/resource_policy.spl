# Process limits for the test runner. RLIMIT_NPROC counts the entire UID on
# macOS, including unrelated desktop processes; zero inherits the host limit.

pub fn test_default_max_procs(macos: bool) -> i64:
    if macos: 0 else: 4096

pub fn test_max_procs_value_valid(value: text) -> bool:
    if value == "":
        return false
    for ch in value:
        if ch < "0" or ch > "9":
            return false
    # Validate the signed i64 boundary before conversion: bootstrap interpreters
    # can retain a wider integer instead of rejecting an overflowing to_i64.
    var first_digit = 0
    while first_digit < value.len() and value[first_digit:first_digit + 1] == "0":
        first_digit = first_digit + 1
    # WORKAROUND(text_slice_omitted_end_native_contract_2026_10_12):
    # Bound the end explicitly until native omitted-end slicing is repaired.
    val significant = value[first_digit:value.len()]
    if significant.len() > 19:
        return false
    if significant.len() == 19 and significant > "9223372036854775807":
        return false
    true

pub fn safe_mode_caps(no_limits: bool, max_procs: i64) -> (i64, i64, i64, i64):
    if no_limits:
        return (0, 0, 0, 0)
    (512 * 1024 * 1024, 30, 256, max_procs)
