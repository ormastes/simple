# Process limits for the test runner. RLIMIT_NPROC counts the entire UID on
# macOS, including unrelated desktop processes; zero inherits the host limit.

pub fn test_default_max_procs(macos: bool) -> i64:
    if macos: 0 else: 4096

pub fn test_max_procs_value_valid(value: text) -> bool:
    if value == "":
        return false
    for ch in value:
        if ch < "0" or ch > "9":
            return false
    val parsed = value.to_i64() ?? -1
    parsed >= 0

pub fn safe_mode_caps(no_limits: bool, max_procs: i64) -> (i64, i64, i64, i64):
    if no_limits:
        return (0, 0, 0, 0)
    (512 * 1024 * 1024, 30, 256, max_procs)
