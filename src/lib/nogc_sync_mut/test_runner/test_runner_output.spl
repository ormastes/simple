# Test Runner Output Formatting
#
# Result printing and summary output functions.

use std.test_runner.test_runner_types.{TestFileResult, TestRunResult}
use std.test_runner.test_runner_types.{test_file_result_outcome_class, TestOmissionEvidence, TestOmissionStatus}
use std.test_runner.sdoctest.types.{BlockResult, BlockStatus, SdoctestFileResult, SdoctestRunResult, SdoctestModifier}
use std.nogc_sync_mut.io.sysinfo_ops.{path_basename}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.perf.execution_metrics.{resource_evidence_quality_name, termination_cause_name}
use std.common.perf.execution_metrics.{ResourceUsage}
use std.nogc_sync_mut.io.process_completion.{ProcessCompletionV1}

# =========================================================================
# Result Printing
# =========================================================================

# =========================================================================
# Outcome classification -- the SINGLE source of truth
# =========================================================================
#
# Every producer of TestFileResult.error writes it as "<CLASS>: <message>"
# (test_executor_parsing.spl, test_runner_fork.spl, test_runner_execute.spl,
# test_runner_main.spl). Only the CLASS token -- the text before the first
# colon -- is structural; everything after it is a human-readable message that
# any lane may reword at any time.
#
# The previous code matched with `err.starts_with("CRASHED")` etc., i.e. it
# matched a PREFIX OF THE WHOLE ERROR STRING, in two independent copies (the
# per-spec tag and the summary counters). That is fragile in three separate
# ways, all of which silently corrupt counts rather than failing loudly:
#   1. a reworded message that happens to start with a different word is
#      classified as an unknown error and vanishes from every counter;
#   2. the two copies can drift apart (they already disagreed with
#      test_runner_types.spl, which matches "TERMINATED:" WITH the colon);
#   3. an error whose class token is not one of the four recognised prefixes
#      was counted NOWHERE, and -- because TestRunResult.is_ok() only looks at
#      total_failed/total_timed_out -- printed "All tests passed!".
#
# The rule tokenises rather than prefix-matches, so rewording the message
# cannot change a count, and it is total: every TestFileResult maps to exactly
# one of the six classes OK / ERROR / CRASHED / TERMINATED / TIMEOUT / NOT_RUN,
# which therefore can never collapse into one another and can never be silently
# absent.
#
# Deliberately NOT done: re-deriving signal semantics (e.g. SIGKILL 137 =>
# CRASHED rather than TERMINATED) by sniffing the message text. That decision
# belongs to the producer that saw the wait status; re-deriving it from prose
# here would reintroduce exactly the coupling the rule removes.
#
# The rule itself lives ONCE, in the lower module test_runner_types.spl, as
# test_outcome_class_token() / test_file_result_outcome_class(). This is a thin
# delegator kept only because it is the name callers here and in the sibling
# specs already use; it must never grow a second copy of the rule. Two silent-
# green defects (a crash double-counted as crashed AND timed-out-unverified, an
# unrecognised token counted in no bucket at all) came from the copy that used
# to live here.
fn test_file_outcome_class(result: TestFileResult) -> text:
    test_file_result_outcome_class(result)

# R6 attribution: the per-spec line must name the OUTCOME CLASS, not just
# pass/fail. Before this, a CRASHED spec (failed: 1) and a TERMINATED or
# TIMEOUT spec (failed: 0, unverified) both printed the same "FAIL" tag, so the
# only place the six classes existed was the aggregate summary -- and per-spec
# attribution is exactly what tells host contention apart from a real defect.
fn test_file_outcome_tag(result: TestFileResult) -> text:
    match test_file_outcome_class(result):
        case "CRASHED": "CRASH"
        case "TERMINATED": "TERM"
        case "TIMEOUT": "TOUT"
        case "NOT_RUN": "NRUN"
        case "VACUOUS": "VACU"
        case "SKIP": "SKIP"
        case "OK": "PASS"
        case _: "FAIL"

fn print_result_default(result: TestFileResult):
    val tag = test_file_outcome_tag(result)
    if tag == "SKIP":
        # Feature-gated: its one per-file line is the `FEATURE SKIP` line the
        # runner printed when it decided not to run it. Never a PASS line.
        return
    if tag == "CRASH" or tag == "TERM" or tag == "NRUN":
        print "  {tag}  {result.path} ({result.duration_ms}ms)"
        if result.error != "":
            print "        Error: {result.error}"
        else:
            print "        Error: no result line and no examples -- the unit produced no verdict"
        return
    if result.timed_out:
        print "  TOUT  {result.path} ({result.duration_ms}ms)"
        print "        Error: {result.error}"
    elif result.is_ok():
        var msg = "  PASS  {result.path} ({result.passed} passed"
        if result.skipped > 0:
            msg = msg + ", {result.skipped} skipped"
        if result.pending > 0:
            msg = msg + ", {result.pending} pending"
        msg = msg + ", {result.duration_ms}ms)"
        if result.setup_ms > 0:
            msg = msg + " [setup: {result.setup_ms}ms]"
        if result.cached:
            msg = msg + " [cached]"
        print msg
    else:
        var msg = "  FAIL  {result.path} ({result.passed} passed, {result.failed} failed"
        if result.skipped > 0:
            msg = msg + ", {result.skipped} skipped"
        if result.pending > 0:
            msg = msg + ", {result.pending} pending"
        msg = msg + ", {result.duration_ms}ms)"
        if result.setup_ms > 0:
            msg = msg + " [setup: {result.setup_ms}ms]"
        print msg
        if result.error != "":
            print "        Error: {result.error}"

fn print_result_doc(result: TestFileResult):
    val name = path_basename(result.path)
    if test_file_outcome_class(result) == "SKIP":
        # Feature-gated: the `FEATURE SKIP` line is its only output. Never
        # "0 examples, 0 failures", which reads as a vacuous pass.
        return
    if result.timed_out:
        print "  {name}"
        print "    TIMEOUT ({result.duration_ms}ms)"
    elif result.is_ok():
        print "  {name}"
        print "    {result.passed} examples, 0 failures ({result.duration_ms}ms)"
    else:
        print "  {name}"
        print "    {result.passed + result.failed} examples, {result.failed} failures ({result.duration_ms}ms)"

pub fn validate_test_output_format(format: text) -> Result<(), text>:
    if format == "json":
        return Err("JSON test output is retired; use SDN or a human output format")
    if format != "text" and format != "doc" and format != "sdn":
        return Err("Unsupported test output format; expected text, doc or sdn")
    Ok(())

fn print_result(result: TestFileResult, format: text):
    match validate_test_output_format(format):
        case Err(reason):
            eprint "ERROR: {reason}"
            return
        case Ok(_): pass
    if format == "doc":
        print_result_doc(result)
    elif format == "sdn":
        # One complete document is emitted by print_summary or the authenticated
        # worker transport, never one partial document per file.
        return
    else:
        print_result_default(result)

# Feature-group key for a spec file: the path segment after "test/"
# (e.g. test/01_unit/compiler/x_spec.spl -> "01_unit"), else the first
# segment. Grouping by directory keeps this metadata-free.
fn test_file_group(path: text) -> text:
    var rest = path
    if rest.starts_with("test/"):
        rest = rest["test/".len():rest.len()]
    val idx = rest.index_of("/")
    if idx > 0:
        return rest[0:idx]
    "other"

# =========================================================================
# Versioned native SDN worker-output transport.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# Human and document printers remain separate from this machine protocol.
# =========================================================================

val TEST_RUN_SDN_OUTPUT_MAX: i64 = 1048576

fn _test_output_record(names: [text], values: [SdnValue]) -> SdnValue:
    var fields: Dict<text, SdnValue> = {}
    var i = 0
    while i < names.len():
        fields[names[i]] = values[i]
        i += 1
    SdnValue.Dict(fields)

fn _test_output_text(value: text) -> SdnValue:
    SdnValue.String(value)

fn _test_output_text_array(values: [text]) -> SdnValue:
    var items: [SdnValue] = []
    for value in values: items.push(_test_output_text(value))
    SdnValue.Array(items)

fn _test_output_omission(value: TestOmissionEvidence) -> SdnValue:
    val status = match value.status:
        case TestOmissionStatus.Blocked: "blocked"
        case TestOmissionStatus.Unsupported: "unsupported"
    _test_output_record(
        ["status", "scenario_id", "reason", "prerequisite", "owner", "tracking_id", "artifact_paths", "resume_command"],
        [_test_output_text(status), _test_output_text(value.scenario_id), _test_output_text(value.reason),
            _test_output_text(value.prerequisite), _test_output_text(value.owner), _test_output_text(value.tracking_id),
            _test_output_text_array(value.artifact_paths), _test_output_text(value.resume_command)])

fn _test_output_resource_usage(value: ResourceUsage) -> SdnValue:
    _test_output_record(
        ["wall_ms", "user_cpu_ms", "system_cpu_ms", "peak_tree_charge_bytes", "peak_direct_child_rss_bytes", "heap_live_end_bytes", "heap_peak_bytes", "io_read_bytes", "io_write_bytes", "pids_peak", "evidence_quality", "termination", "signal", "exit_code"],
        [SdnValue.Int(value.wall_ms), SdnValue.Int(value.user_cpu_ms), SdnValue.Int(value.system_cpu_ms),
            SdnValue.Int(value.peak_tree_charge_bytes), SdnValue.Int(value.peak_direct_child_rss_bytes),
            SdnValue.Int(value.heap_live_end_bytes), SdnValue.Int(value.heap_peak_bytes),
            SdnValue.Int(value.io_read_bytes), SdnValue.Int(value.io_write_bytes), SdnValue.Int(value.pids_peak),
            _test_output_text(resource_evidence_quality_name(value.evidence_quality)),
            _test_output_text(termination_cause_name(value.termination)), SdnValue.Int(value.signal), SdnValue.Int(value.exit_code)])

fn _test_output_process_completion(value: ProcessCompletionV1) -> SdnValue:
    _test_output_record(
        ["pid", "process_generation", "exit_code", "signal_number", "tree_reaped", "timed_out", "cancelled", "stdout_digest", "stderr_digest", "transport_execution_digest"],
        [SdnValue.Int(value.pid), SdnValue.Int(value.process_generation), SdnValue.Int(value.exit_code),
            SdnValue.Int(value.signal_number), SdnValue.Bool(value.tree_reaped), SdnValue.Bool(value.timed_out),
            SdnValue.Bool(value.cancelled), _test_output_text(value.stdout_digest), _test_output_text(value.stderr_digest),
            _test_output_text(value.transport_execution_digest)])

fn _test_output_file_result(value: TestFileResult) -> SdnValue:
    var omissions: [SdnValue] = []
    for omission in value.omission_evidence: omissions.push(_test_output_omission(omission))
    val resource = match value.resource_usage:
        case Some(usage): _test_output_resource_usage(usage)
        case nil: SdnValue.Null
    val completion = match value.process_completion:
        case Some(receipt): _test_output_process_completion(receipt)
        case _: SdnValue.Null
    _test_output_record(
        ["path", "passed", "failed", "skipped", "pending", "duration_ms", "setup_ms", "error", "timed_out", "cached", "in_development", "feature_gated", "mcdc_evidence_v1", "mcdc_skip_reason", "degraded_reason", "blocked", "unsupported", "omission_evidence", "compile_ms", "execution_ms", "resource_usage", "resource_class", "cohort_id", "budget_status", "anomaly_status", "process_completion", "trace_case_events_sdn"],
        [_test_output_text(value.path), SdnValue.Int(value.passed), SdnValue.Int(value.failed),
            SdnValue.Int(value.skipped), SdnValue.Int(value.pending), SdnValue.Int(value.duration_ms),
            SdnValue.Int(value.setup_ms), _test_output_text(value.error), SdnValue.Bool(value.timed_out),
            SdnValue.Bool(value.cached), SdnValue.Int(value.in_development), _test_output_text(value.feature_gated),
            _test_output_text(value.mcdc_evidence_v1), _test_output_text(value.mcdc_skip_reason),
            _test_output_text(value.degraded_reason), SdnValue.Int(value.blocked), SdnValue.Int(value.unsupported),
            SdnValue.Array(omissions), SdnValue.Int(value.compile_ms), SdnValue.Int(value.execution_ms), resource,
            _test_output_text(value.resource_class), _test_output_text(value.cohort_id), _test_output_text(value.budget_status),
            _test_output_text(value.anomaly_status), completion, _test_output_text(value.trace_case_events_sdn)])

fn _test_output_group_summaries(files: [TestFileResult]) -> SdnValue:
    var names: [text] = []
    var passed: [i64] = []
    var failed: [i64] = []
    var skipped: [i64] = []
    var pending: [i64] = []
    for file in files:
        val group = test_file_group(file.path)
        var index = -1
        var i = 0
        while i < names.len():
            if names[i] == group: index = i
            i += 1
        if index < 0:
            names.push(group)
            passed.push(0)
            failed.push(0)
            skipped.push(0)
            pending.push(0)
            index = names.len() - 1
        passed[index] += file.passed
        failed[index] += file.failed
        skipped[index] += file.skipped
        pending[index] += file.pending
    var rows: [SdnValue] = []
    var i = 0
    while i < names.len():
        val denominator = passed[i] + failed[i] + pending[i]
        rows.push(_test_output_record(
            ["name", "passed", "failed", "skipped", "pending", "done_pct"],
            [_test_output_text(names[i]), SdnValue.Int(passed[i]), SdnValue.Int(failed[i]),
                SdnValue.Int(skipped[i]), SdnValue.Int(pending[i]),
                SdnValue.Int(if denominator > 0: passed[i] * 100 / denominator else: 0)]))
        i += 1
    SdnValue.Array(rows)

fn _test_output_spec_result(value: TestRunResult) -> SdnValue:
    var files: [SdnValue] = []
    for file in value.files: files.push(_test_output_file_result(file))
    _test_output_record(
        ["success", "total_passed", "total_failed", "total_skipped", "total_pending", "total_timed_out", "total_duration_ms", "total_setup_ms", "total_cached", "groups", "files"],
        [SdnValue.Bool(value.is_ok()), SdnValue.Int(value.total_passed), SdnValue.Int(value.total_failed),
            SdnValue.Int(value.total_skipped), SdnValue.Int(value.total_pending), SdnValue.Int(value.total_timed_out),
            SdnValue.Int(value.total_duration_ms), SdnValue.Int(value.total_setup_ms), SdnValue.Int(value.total_cached),
            _test_output_group_summaries(value.files), SdnValue.Array(files)])

fn _test_output_modifier(value: SdoctestModifier) -> SdnValue:
    match value:
        case SdoctestModifier.Skip: _test_output_record(["kind"], [_test_output_text("skip")])
        case SdoctestModifier.Ignore: _test_output_record(["kind"], [_test_output_text("ignore")])
        case SdoctestModifier.ShouldFail: _test_output_record(["kind"], [_test_output_text("should_fail")])
        case SdoctestModifier.FailAsSuccess: _test_output_record(["kind"], [_test_output_text("fail_as_success")])
        case SdoctestModifier.IgnoreOutput: _test_output_record(["kind"], [_test_output_text("ignore_output")])
        case SdoctestModifier.Init(value): _test_output_record(["kind", "value"], [_test_output_text("init"), _test_output_text(value)])
        case SdoctestModifier.Env(value): _test_output_record(["kind", "value"], [_test_output_text("env"), _test_output_text(value)])
        case SdoctestModifier.Tag(value): _test_output_record(["kind", "value"], [_test_output_text("tag"), _test_output_text(value)])
        case SdoctestModifier.RunConfig(value): _test_output_record(["kind", "value"], [_test_output_text("run_config"), _test_output_text(value)])

fn _test_output_sdoc_block(value: BlockResult) -> SdnValue:
    var modifiers: [SdnValue] = []
    for modifier in value.block.modifiers: modifiers.push(_test_output_modifier(modifier))
    val status = match value.status:
        case BlockStatus.Passed: "passed"
        case BlockStatus.Failed: "failed"
        case BlockStatus.Skipped: "skipped"
        case BlockStatus.Error: "error"
    val block = _test_output_record(
        ["source_file", "line_number", "code", "language", "modifiers", "transcript"],
        [_test_output_text(value.block.source_file), SdnValue.Int(value.block.line_number), _test_output_text(value.block.code),
            _test_output_text(value.block.language), SdnValue.Array(modifiers), _test_output_text(value.block.transcript)])
    _test_output_record(
        ["block", "status", "duration_ms", "stdout", "stderr", "error"],
        [block, _test_output_text(status), SdnValue.Int(value.duration_ms), _test_output_text(value.stdout),
            _test_output_text(value.stderr), _test_output_text(value.error)])

fn _test_output_sdoc_file(value: SdoctestFileResult) -> SdnValue:
    var blocks: [SdnValue] = []
    for block in value.blocks: blocks.push(_test_output_sdoc_block(block))
    _test_output_record(
        ["source_file", "blocks", "total", "passed", "failed", "skipped", "errors", "accepted", "duration_ms"],
        [_test_output_text(value.source_file), SdnValue.Array(blocks), SdnValue.Int(value.total), SdnValue.Int(value.passed),
            SdnValue.Int(value.failed), SdnValue.Int(value.skipped), SdnValue.Int(value.errors), SdnValue.Int(value.accepted),
            SdnValue.Int(value.duration_ms)])

fn _test_output_sdoc_run(value: SdoctestRunResult) -> SdnValue:
    var files: [SdnValue] = []
    for file in value.files: files.push(_test_output_sdoc_file(file))
    _test_output_record(
        ["total", "passed", "failed", "skipped", "errors", "accepted", "duration_ms", "files"],
        [SdnValue.Int(value.total), SdnValue.Int(value.passed), SdnValue.Int(value.failed), SdnValue.Int(value.skipped),
            SdnValue.Int(value.errors), SdnValue.Int(value.accepted), SdnValue.Int(value.duration_ms), SdnValue.Array(files)])

fn _test_output_sdoc_optional(enabled: bool, value: SdoctestRunResult) -> SdnValue:
    if enabled: _test_output_sdoc_run(value) else: SdnValue.Null

fn _test_output_modifier_text(value: SdoctestModifier) -> text:
    match value:
        case SdoctestModifier.Init(item): item
        case SdoctestModifier.Env(item): item
        case SdoctestModifier.Tag(item): item
        case SdoctestModifier.RunConfig(item): item
        case _: ""

fn _test_output_consume(remaining: i64, amount: i64) -> Result<i64, text>:
    if amount < 0 or amount > remaining:
        return Err("test runner SDN output exceeds bounded preflight budget")
    Ok(remaining - amount)

fn _test_output_rows(remaining: i64, count: i64, overhead: i64) -> Result<i64, text>:
    if count > 65536 or count > remaining / overhead:
        return Err("test runner SDN output exceeds bounded collection budget")
    Ok(remaining - count * overhead)

# Native text.len() counts UTF-8 bytes without allocating a .bytes() copy.
# Canonical SDN escapes at most twice each byte, plus quotes/separators.
fn _test_output_text_budget(remaining: i64, values: [text]) -> Result<i64, text>:
    var available = remaining
    for value in values:
        if available < 4 or value.len() > (available - 4) / 2:
            return Err("test runner SDN output text exceeds bounded preflight budget")
        available -= value.len() * 2 + 4
    Ok(available)

fn _test_output_preflight(spec_enabled: bool, spec: TestRunResult, spl_enabled: bool, spl: SdoctestRunResult, doc_enabled: bool, doc: SdoctestRunResult) -> Result<(), text>:
    # Conservative wire budget includes fixed keys/scalars, derived groups,
    # optional resource/lease records and every nested collection. Reject before
    # constructing any SdnValue trees; the final encoder size is checked too.
    var available = TEST_RUN_SDN_OUTPUT_MAX - 4096
    var rows_left: i64 = 65536
    var counter_budget: i64 = 92233720368547758
    if spec_enabled:
        rows_left = _test_output_consume(rows_left, spec.files.len())?
        available = _test_output_rows(available, spec.files.len(), 2048)?
        for file in spec.files:
            # Group sums and passed*100 cannot overflow signed i64. Negative
            # counters are invalid input, not a transport success signal.
            for count in [file.passed, file.failed, file.skipped, file.pending]:
                if count < 0 or count > counter_budget:
                    return Err("test runner SDN counter aggregation would overflow or contains negative counts")
                counter_budget -= count
            available = _test_output_text_budget(available, [file.path, file.error, file.feature_gated,
                file.mcdc_evidence_v1, file.mcdc_skip_reason, file.degraded_reason, file.trace_case_events_sdn,
                file.resource_class, file.cohort_id, file.budget_status, file.anomaly_status])?
            # A derived group name can be as long as the path itself.
            available = _test_output_text_budget(available, [file.path])?
            match file.resource_usage:
                case Some(usage):
                    available = _test_output_consume(available, 512)?
                    available = _test_output_text_budget(available, [resource_evidence_quality_name(usage.evidence_quality), termination_cause_name(usage.termination)])?
                case nil: pass
            match file.process_completion:
                case Some(receipt):
                    available = _test_output_consume(available, 512)?
                    available = _test_output_text_budget(available, [receipt.stdout_digest, receipt.stderr_digest, receipt.transport_execution_digest])?
                case _: pass
            rows_left = _test_output_consume(rows_left, file.omission_evidence.len())?
            available = _test_output_rows(available, file.omission_evidence.len(), 512)?
            for omission in file.omission_evidence:
                available = _test_output_text_budget(available, [omission.scenario_id, omission.reason, omission.prerequisite,
                    omission.owner, omission.tracking_id, omission.resume_command])?
                rows_left = _test_output_consume(rows_left, omission.artifact_paths.len())?
                available = _test_output_rows(available, omission.artifact_paths.len(), 4)?
                available = _test_output_text_budget(available, omission.artifact_paths)?
    var sdoc_runs: [SdoctestRunResult] = []
    if spl_enabled: sdoc_runs.push(spl)
    if doc_enabled: sdoc_runs.push(doc)
    for result in sdoc_runs:
        rows_left = _test_output_consume(rows_left, result.files.len())?
        available = _test_output_rows(available, result.files.len(), 512)?
        for file in result.files:
            available = _test_output_text_budget(available, [file.source_file])?
            rows_left = _test_output_consume(rows_left, file.blocks.len())?
            available = _test_output_rows(available, file.blocks.len(), 1024)?
            for block in file.blocks:
                available = _test_output_text_budget(available, [block.block.source_file, block.block.code,
                    block.block.language, block.block.transcript, block.stdout, block.stderr, block.error])?
                rows_left = _test_output_consume(rows_left, block.block.modifiers.len())?
                available = _test_output_rows(available, block.block.modifiers.len(), 128)?
                for modifier in block.block.modifiers:
                    available = _test_output_text_budget(available, [_test_output_modifier_text(modifier)])?
    Ok(())

pub fn combined_test_run_sdn(
    runner_ok: bool,
    spec_enabled: bool,
    spec_result: TestRunResult,
    spl_doctest_enabled: bool,
    spl_doctest_result: SdoctestRunResult,
    sdoctest_enabled: bool,
    sdoctest_result: SdoctestRunResult
) -> Result<text, text>:
    _test_output_preflight(spec_enabled, spec_result, spl_doctest_enabled, spl_doctest_result, sdoctest_enabled, sdoctest_result)?
    val success = runner_ok and (not spec_enabled or spec_result.is_ok()) and
        (not spl_doctest_enabled or spl_doctest_result.is_ok()) and (not sdoctest_enabled or sdoctest_result.is_ok())
    val value = _test_output_record(
        ["schema", "success", "runner_ok", "spec", "spl_doctest", "sdoctest"],
        [_test_output_text("simple.test-runner.output/v1"), SdnValue.Bool(success), SdnValue.Bool(runner_ok),
            if spec_enabled: _test_output_spec_result(spec_result) else: SdnValue.Null,
            _test_output_sdoc_optional(spl_doctest_enabled, spl_doctest_result),
            _test_output_sdoc_optional(sdoctest_enabled, sdoctest_result)])
    val encoded = sdn_encode_canonical(value)
    if encoded.len() > TEST_RUN_SDN_OUTPUT_MAX:
        return Err("test runner SDN output exceeds 1 MiB")
    Ok(encoded)

# Standalone summaries use the same versioned envelope and evidence-preserving
# serializer as the worker. Disabled documentation families remain typed nulls.
pub fn test_run_result_sdn(result: TestRunResult) -> Result<text, text>:
    val disabled = SdoctestRunResult(files: [], total: 0, passed: 0, failed: 0,
        skipped: 0, errors: 0, accepted: 0, duration_ms: 0)
    combined_test_run_sdn(true, true, result, false, disabled, false, disabled)

fn aggregate_failed_count(result: TestRunResult) -> i64:
    """Failure figure for the aggregate `Results:` line -- fail-closed.

    `result.total_failed` alone is NOT it. A TIMED-OUT or TERMINATED unit
    carries `failed: 0` and contributes no examples, so a run built only from
    total_passed/total_failed printed `Results: 0 total, 0 passed, 0 failed`
    for a run whose own `SPEC FILE VERDICT:` line said `failed=1 timeout=1`
    (bug: aspect_weave_specs_timeout_vacuous_green_2026-08-18). The two
    designated evidence surfaces of the SAME run contradicted each other, and
    the vacuous one is the one CI and agents grep.

    Rule: every file that does not classify OK contributes at least 1. Adding
    the class counters directly would DOUBLE COUNT -- an ordinary failing spec
    classifies "ERROR" while already contributing to total_failed -- so the
    increment applies only to bad files that contributed NOTHING
    (`failed == 0`): exactly the TIMEOUT / TERMINATED / silent-NOT_RUN set. A
    normally-passing run has no such file and its head is byte-identical to
    before, which is what the positive control in the acceptance spec pins."""
    var uncounted_bad = 0
    for f in result.files:
        val cls = test_file_outcome_class(f)
        if cls != "OK" and cls != "SKIP" and f.failed == 0:
            uncounted_bad = uncounted_bad + 1
    # Executors that report timeouts without producing per-file results at all:
    # with no files to classify the loop above sees nothing, so fall back to the
    # struct counter rather than reporting the run as zero-of-everything.
    if result.files.len() == 0 and result.total_timed_out > uncounted_bad:
        uncounted_bad = result.total_timed_out
    result.total_failed + uncounted_bad

fn run_aborted_before_execution(result: TestRunResult) -> bool:
    """True when a run claims failures while having executed NOTHING.

    Structural, not gate-specific, so it covers every present and future
    preflight abort: no per-file result exists, nothing passed, yet a nonzero
    failure figure is being claimed. That shape can only come from a gate that
    returned `TestRunResult(files: [], total_failed: <n>)` before the executor
    ever started -- e.g. the `@cover` annotation gate, which turned 587 healthy
    un-annotated specs into `Results: 587 total, 0 passed, 587 failed` in
    ~3 minutes with `Time: 0ms` and not one `SPEC FILE VERDICT:` line.

    A genuine empty selection (0 files, 0 failures) is NOT this shape and is
    deliberately excluded -- it still prints "No tests selected."."""
    result.files.len() == 0 and result.total_passed == 0 and result.total_failed > 0

fn print_summary(result: TestRunResult, format: text):
    match validate_test_output_format(format):
        case Err(reason):
            eprint "ERROR: {reason}"
            return
        case Ok(_): pass
    if format == "sdn":
        match test_run_result_sdn(result):
            case Ok(document): print document
            case Err(reason): eprint "ERROR: cannot encode test summary SDN: {reason}"
        return
    print ""
    print "========================================="
    # ZERO-EXECUTED ABORT: refuse to emit a `Results:` line at all.
    #
    # A preflight gate that aborts before any spec runs used to return
    # `TestRunResult(files: [], total_failed: <n>)` -- and this printer turned
    # that into a fully-formed `Results: 587 total, 0 passed, 587 failed`,
    # indistinguishable to any automated reader from a real mass failure of 587
    # healthy specs. Four sweep lanes were about to classify specs from exactly
    # that line (bug: test_runner_cover_gate_aborts_read_as_mass_failure).
    #
    # `Results:` is the repo's designated evidence line, so the fix is not a
    # softer wording: a run in which ZERO units executed must produce output
    # that CANNOT be parsed as a completed run. No `Results:`, no `Time:`, no
    # pass/fail verdict -- only an ABORTED block naming the count that was
    # never run. Detection is structural, not gate-specific, so it covers every
    # present and future preflight abort: no per-file result exists, nothing
    # passed, yet a nonzero failure figure is being claimed.
    #
    # Untouched: a genuine empty selection (files == 0, failures == 0) still
    # takes the normal path and prints "No tests selected."
    if run_aborted_before_execution(result) and not result.carried_from_checkpoint:
        print "ABORTED BEFORE EXECUTION"
        print "========================================="
        print "Units executed:     0"
        print "Units not run:      {result.total_failed}"
        print ""
        print "This run was aborted by a preflight gate. NOTHING was executed,"
        print "so this is NOT a test result: the {result.total_failed} unit(s) above are"
        print "UNKNOWN, not failed. See the ERROR block above for the gate that"
        print "aborted, and re-run with its documented bypass to get a verdict."
        print "========================================="
        return
    # The six outcome classes come from test_file_outcome_class() -- the single
    # classifier above, which tokenises the "<CLASS>:" head rather than
    # prefix-matching the whole error string, so rewording a message can no
    # longer change any of these counts. CRASHED and NOT EXECUTED files are
    # already counted in total_failed; naming them separately keeps "the suite
    # reached the end" honest -- a crash must never read as a plain assertion
    # failure, and never as absent.
    #
    # TERMINATED and TIMEOUT are UNVERIFIED and are NEVER failures: they carry
    # failed: 0, so they are absent from total_failed by construction, and they
    # are named here with an explicit "(unverified)" tag so they can never be
    # silently absent either. earlyoom is SIGTERMing `simple` on this host, so
    # counting a termination as a failure reports host contention as a defect.
    #
    # ponytail: derived from the class token instead of new TestFileResult
    # fields, which every executor lane would have had to set. Promote to a real
    # field if a second consumer needs it.
    var crashed = 0
    var terminated = 0
    var timed_out = 0
    var not_run = 0
    var errored = 0
    var gated = 0
    for f in result.files:
        match test_file_outcome_class(f):
            case "SKIP": gated = gated + 1
            case "CRASHED": crashed = crashed + 1
            case "TERMINATED": terminated = terminated + 1
            case "TIMEOUT": timed_out = timed_out + 1
            case "NOT_RUN": not_run = not_run + 1
            case "ERROR": errored = errored + 1
            case _: 0
    # Fall back to the struct flag only for executors that set timed_out without
    # producing per-file results at all. Guarded on ALL four class counters: the
    # old `if timed_out == 0` fired whenever the run had crashes but no
    # timeouts, adding total_timed_out on top and reporting the same units as
    # both "crashed" and "timed out (unverified)" -- a collapse of CRASHED into
    # TIMEOUT that also moved them out of the failure verdict.
    if crashed == 0 and terminated == 0 and timed_out == 0 and not_run == 0:
        timed_out = result.total_timed_out
    # FAIL-CLOSED `Results:` head (bug:
    # aspect_weave_specs_timeout_vacuous_green_2026-08-18). A TIMED-OUT or
    # TERMINATED unit carries `failed: 0` and contributes no examples, so the
    # old head -- built purely from total_passed/total_failed -- printed
    # "Results: 0 total, 0 passed, 0 failed" for a run whose own
    # `SPEC FILE VERDICT:` line said `failed=1 timeout=1`. The two designated
    # evidence surfaces of the SAME run contradicted each other, and the
    # vacuous one is the one CI and agents grep. `Results:` is the repo's
    # designated evidence line: it must never report a unit that produced no
    # verdict as zero-of-everything.
    #
    # Rule: every file that does NOT classify OK contributes at least 1 to the
    # head's failed figure. Adding the class counters directly would DOUBLE
    # COUNT -- an ordinary failing spec classifies "ERROR" while already
    # contributing to total_failed -- so the increment is applied only to bad
    # files that contributed NOTHING (`failed == 0`), which is exactly the
    # TIMEOUT / TERMINATED / silent-NOT_RUN set. A normally-passing run has no
    # such file and its head is byte-identical to before (positive control).
    val head_failed = aggregate_failed_count(result)
    val total = result.total_passed + head_failed
    var summary = "Results: {total} total, {result.total_passed} passed, {head_failed} failed"
    if result.total_skipped > 0:
        summary = summary + ", {result.total_skipped} skipped"
    if result.total_pending > 0:
        summary = summary + ", {result.total_pending} pending"
    if crashed > 0:
        summary = summary + ", {crashed} crashed"
    if terminated > 0:
        summary = summary + ", {terminated} terminated (unverified)"
    if timed_out > 0:
        summary = summary + ", {timed_out} timed out (unverified)"
    if not_run > 0:
        summary = summary + ", {not_run} not run"
    if result.total_cached > 0:
        summary = summary + ", {result.total_cached} cached"
    print summary
    if result.total_setup_ms > 0:
        print "Time:    {result.total_duration_ms}ms (setup: {result.total_setup_ms}ms)"
    else:
        print "Time:    {result.total_duration_ms}ms"
    print "========================================="
    # A CRASHED unit is a real failure and must never read as green. TERMINATED
    # and TIMEOUT are neither passes nor failures: the run is INCONCLUSIVE for
    # those units and must say so rather than claiming either.
    # `errored` covers a file carrying a real error that TestRunResult's own
    # totals miss (error set, failed == 0). Without it such a run printed
    # "All tests passed!".
    val real_failures = result.total_failed + crashed + not_run + errored
    val unverified = terminated + timed_out
    if result.files.len() == 0 and result.is_ok() and not result.carried_from_checkpoint:
        print "No tests selected."
    elif real_failures > 0:
        print "Some tests failed."
    elif unverified > 0:
        print "INCONCLUSIVE: {unverified} unit(s) were terminated or timed out and never produced a verdict."
    elif gated > 0 and gated == result.files.len() and result.is_ok():
        # Every selected file was feature-gated: nothing ran, so nothing passed.
        print "No tests ran: {gated} file(s) feature-gated (build feature off)."
    elif result.is_ok():
        print "All tests passed!"
    else:
        print "Some tests failed."

