# Test Runner Helpers
#
# Extracted from test_runner_main.spl. Contains:
# - Individual test result parsing from output
# - Test file categorization
# - Closure/call graph warning display
# - Test database update
# - Feature status update from tests

use std.test_runner.test_runner_types.{TestFileResult, TestRunResult}
use std.test_runner.test_runner_files.{strip_ansi}
use std.test_runner.test_db_compat.{RunnerTestDb, load_test_db_compat, micros_to_rfc3339}
use std.test_runner.test_db_types.{IndividualTestResult, TestStatus}
use std.database.feature.{FeatureDatabase, FeatureStatus, Feature}
use std.common.perf.execution_metrics.{
    ApprovedBaseline, AnomalyPolicy, BaselineState, DecisionStatus,
    compare_approved_baseline, decision_status_name
}
use compiler.core.closure_analysis.{closure_warnings_get, closure_warnings_has}
use compiler.core.call_graph.{call_graph_warnings_get, call_graph_warnings_has}

# =========================================================================
# C4: Individual test result parsing from output
# =========================================================================

fn parse_individual_results(output: text, file_path: text) -> [IndividualTestResult]:
    var results: [IndividualTestResult] = []
    val lines = output.split("\n")
    var current_group = ""

    for line in lines:
        val clean = strip_ansi(line.trim())
        if clean == "":
            continue

        # Detect group headers (indented describe/context blocks)
        # Format: "GroupName" followed by indented tests
        if clean.ends_with(":") and not clean.starts_with(" ") and not clean.contains(" "):
            current_group = clean[:-1]
            continue

        # Parse individual test lines: checkmark/cross + name
        if clean.len() > 2:
            val prefix = clean[0:2]
            if prefix == "  ":
                # Indented line might be a test result
                val inner = clean.trim()
                if inner.len() > 2:
                    val marker = inner[0:3]
                    if marker.contains("✓") or marker.contains("✔") or inner.starts_with("PASS"):
                        val name = extract_test_name(inner)
                        results.push(IndividualTestResult(
                            name: name,
                            group: current_group,
                            status: TestStatus.Passed,
                            error_message: ""
                        ))
                    elif marker.contains("✗") or marker.contains("✘") or inner.starts_with("FAIL"):
                        val name = extract_test_name(inner)
                        results.push(IndividualTestResult(
                            name: name,
                            group: current_group,
                            status: TestStatus.Failed,
                            error_message: ""
                        ))
                    elif marker.contains("○") or marker.contains("◯") or inner.starts_with("SKIP"):
                        val name = extract_test_name(inner)
                        results.push(IndividualTestResult(
                            name: name,
                            group: current_group,
                            status: TestStatus.Skipped,
                            error_message: ""
                        ))
                    elif inner.starts_with("PEND") or inner.contains("... pending"):
                        val name = extract_pending_test_name(inner)
                        results.push(IndividualTestResult(
                            name: name,
                            group: current_group,
                            status: TestStatus.Pending,
                            error_message: ""
                        ))

    results

fn extract_pending_test_name(line: text) -> text:
    # Parse "it {name} ... pending (waiting on: ...)" or "PEND {name}"
    var rest = line.trim()
    if rest.starts_with("it "):
        rest = rest[3:]
    elif rest.starts_with("PEND "):
        rest = rest[5:]
    # Strip " ... pending (...)" suffix
    val pending_idx = rest.index_of(" ... pending")
    if pending_idx > 0:
        return rest[0:pending_idx]
    return rest

fn extract_test_name(line: text) -> text:
    # Strip leading marker characters and whitespace
    var i = 0
    while i < line.len():
        val ch = line[i:i + 1]
        if ch != " " and ch != "✓" and ch != "✔" and ch != "✗" and ch != "✘" and ch != "○" and ch != "◯":
            break
        i = i + 1
    # Also skip "PASS ", "FAIL ", "SKIP ", "PEND " prefixes
    val rest = line[i:].trim()
    if rest.starts_with("PASS ") or rest.starts_with("FAIL ") or rest.starts_with("SKIP ") or rest.starts_with("PEND "):
        return rest[5:].trim()
    rest

# =========================================================================
# M1: Derive test category from file path
# =========================================================================

fn categorize_test_file(file_path: text) -> text:
    if file_path.contains("test/01_unit/"):
        return "Unit"
    if file_path.contains("test/shared/"):
        return "Shared"
    if file_path.contains("test/03_system/feature/"):
        return "Feature"
    if file_path.contains("test/02_integration/"):
        return "Integration"
    if file_path.contains("test/03_system/"):
        return "System"
    if file_path.contains("test/benchmark/"):
        return "Benchmark"
    "Unknown"

# =========================================================================
# System-spec predicate (mirror of Rust driver's is_system_spec check)
# =========================================================================
#
# MIRROR: src/compiler_rust/driver/src/cli/test_runner/runner.rs:733
#
# In the Rust driver, the interpreter-mode execution path has a
# static-analysis fast path that counts `it{}` blocks without executing
# them. That's safe for unit/feature/integration specs, but system specs
# under test/03_system/** MUST actually execute their it-block bodies —
# they drive QEMU guests, capture framebuffers, and check serial markers.
# The Rust runner gates the fast-path on !is_system_spec to avoid silent
# false-positives.
#
# The pure-Simple runner in src/app/test_runner_new/ currently has NO
# static fast-path — every test file goes through the real interpreter
# path — so there is no immediate behavioral drift vs. the Rust driver.
# This predicate is the peer of the Rust check, ready to gate any future
# static/safe-mode optimization the Simple runner adds (e.g. SIMPLE_TEST_SAFE
# fast counts), so that when it lands it won't silently bypass QEMU specs.
#
# Matches the Rust semantics: `test` and `system` both appear as path
# components (either slash or OS-separator). Works for:
#   test/03_system/foo_spec.spl      -> true
#   ./test/03_system/nested/bar.spl  -> true
#   test/01_unit/foo_spec.spl        -> false
#   system_test/foo.spl           -> false  (no test/ ancestor)
fn is_system_spec(file_path: text) -> bool:
    """Return true when file_path sits under a test/03_system/** tree.

    Peer of the Rust driver's runner.rs is_system_spec path check. Used
    to gate any future static-analysis fast-path in the pure-Simple test
    runner so system specs always execute their it{} bodies.
    """
    # Plain slash form: covers POSIX paths and the canonical repo layout.
    if file_path.contains("/test/03_system/"):
        return true
    # Unprefixed leading "test/03_system/" (e.g. relative path from repo root).
    if file_path.starts_with("test/03_system/"):
        return true
    # Windows-style separators, mirror for completeness with the Rust
    # Path::components() semantics.
    if file_path.contains("\\test\\system\\"):
        return true
    if file_path.starts_with("test\\system\\"):
        return true
    false

# =========================================================================
# Closure Warnings Display
# =========================================================================

fn display_closure_warnings():
    """Display closure variable capture warnings if any were detected."""
    if not closure_warnings_has():
        return

    print ""
    print "=========================================="
    print "CLOSURE CAPTURE WARNINGS"
    print "=========================================="
    print ""

    val warnings = closure_warnings_get()
    var i = 0
    while i < warnings.len():
        print "[CLOSURE WARNING] {warnings[i]}"
        i = i + 1

    print ""
    print "For more information, see MEMORY.md"
    print "=========================================="

# =========================================================================
# Call Graph Warnings Display
# =========================================================================

fn display_call_graph_warnings():
    """Display call graph recursion warnings if any were detected."""
    if not call_graph_warnings_has():
        return

    print ""
    print "=========================================="
    print "CALL GRAPH WARNINGS"
    print "=========================================="
    print ""

    val warnings = call_graph_warnings_get()
    var i = 0
    for w in warnings:
        print "[CALL GRAPH] {w}"
        i = i + 1

    print ""
    print "Recursion is banned in @safe context"
    print "=========================================="

# =========================================================================
# Test Database Update (C5: per-test granularity, M1: categorization)
# =========================================================================

fn update_test_database(result: TestRunResult, run_start: i64, run_end: i64) -> Result<RunnerTestDb, text>:
    val db_result = load_test_db_compat()
    var db = match db_result:
        case Ok(loaded): loaded
        case Err(reason):
            print "Warning: Could not load test database: {reason}"
            return Err(reason)
    val run_id = db.start_run()

    for file_result in result.files:
        val status = if file_result.is_ok(): TestStatus.Passed else: TestStatus.Failed
        db.update_test_result(
            test_name: file_result.path,
            test_file: file_result.path,
            suite_name: "spec",
            category: "",
            status: status,
            duration_ms: file_result.duration_ms.to_f64(),
            cohort_id: file_result.cohort_id
        )
        match file_result.resource_usage:
            case Some(usage):
                db.record_resource_run(
                    run_id, file_result.path, file_result.resource_class,
                    file_result.cohort_id, file_result.compile_ms,
                    file_result.execution_ms, usage,
                    file_result.budget_status, file_result.anomaly_status
                )
            case nil: pass

    db.complete_run(run_id, result.files.len(), result.total_passed, result.total_failed, result.total_timed_out)
    db.cleanup_stale_runs(48)
    val save_result = db.save()
    match save_result:
        case Ok(_): Ok(db)
        case Err(reason):
            print "Warning: Could not save test database: {reason}"
            Err(reason)

fn _parse_baseline_samples(encoded: text) -> [f64]:
    var samples: [f64] = []
    val body = encoded.trim().replace("[", "").replace("]", "")
    if body == "":
        return samples
    for field in body.split(","):
        val clean = field.trim()
        if clean != "":
            samples.push(clean.to_float())
    samples

fn apply_historical_anomaly_policy(result: TestRunResult) -> TestRunResult:
    """Compare completed files with frozen cohort baselines before rendering.

    Recording remains a later transaction, so the candidate can never approve
    or move the baseline it is being compared against.
    """
    val loaded = load_test_db_compat()
    var db = match loaded:
        case Ok(value): value
        case Err(_): return result
    var files: [TestFileResult] = []
    var added_failures = 0
    val policy = AnomalyPolicy(
        warning_relative_percent: 10,
        warning_mad_multiplier: 3.0,
        failure_relative_percent: 15,
        failure_mad_multiplier: 4.0,
        absolute_floor: 5.0
    )
    for file_result in result.files:
        var anomaly_status = file_result.anomaly_status
        var policy_error = ""
        match db.timing_summary_for_test(file_result.path):
            case Some(summary):
                val samples = _parse_baseline_samples(summary.baseline_samples)
                val cohort_matches = summary.baseline_cohort_id != "" and summary.baseline_cohort_id == file_result.cohort_id
                if summary.has_baseline and summary.baseline_state == "approved" and cohort_matches and samples.len() > 0:
                    val baseline = ApprovedBaseline(
                        cohort_id: summary.baseline_cohort_id,
                        state: BaselineState.Approved,
                        samples: samples,
                        generation: summary.baseline_generation
                    )
                    val confirmed = db.prior_anomaly_warning(file_result.path, file_result.cohort_id)
                    val decision = compare_approved_baseline(
                        baseline, [file_result.duration_ms.to_f64()],
                        file_result.cohort_id, confirmed, policy
                    )
                    anomaly_status = decision_status_name(decision.status)
                    if decision.status == DecisionStatus.Failure:
                        policy_error = "PERFORMANCE REGRESSION: {decision.reason}; baseline={decision.baseline_median}ms candidate={decision.candidate_median}ms delta={decision.relative_percent}%"
            case nil: pass
        val policy_failed = policy_error != ""
        if policy_failed:
            added_failures = added_failures + 1
        files.push(TestFileResult(
            path: file_result.path,
            passed: file_result.passed,
            failed: file_result.failed + (if policy_failed: 1 else: 0),
            skipped: file_result.skipped,
            pending: file_result.pending,
            duration_ms: file_result.duration_ms,
            setup_ms: file_result.setup_ms,
            error: if policy_failed and file_result.error == "": policy_error else: file_result.error,
            timed_out: file_result.timed_out,
            cached: file_result.cached,
            compile_ms: file_result.compile_ms,
            execution_ms: file_result.execution_ms,
            resource_usage: file_result.resource_usage,
            resource_class: file_result.resource_class,
            cohort_id: file_result.cohort_id,
            budget_status: file_result.budget_status,
            anomaly_status: anomaly_status
        ))
    TestRunResult(
        files: files,
        total_passed: result.total_passed,
        total_failed: result.total_failed + added_failures,
        total_skipped: result.total_skipped,
        total_pending: result.total_pending,
        total_timed_out: result.total_timed_out,
        total_duration_ms: result.total_duration_ms,
        total_setup_ms: result.total_setup_ms,
        total_cached: result.total_cached
    )

# =========================================================================
# M3/H6: Update feature status from test results
# =========================================================================

fn update_features_from_tests(fdb: FeatureDatabase, result: TestRunResult):
    # Build set of failed file paths
    var failed_files: Dict<text, bool> = {}
    for file_result in result.files:
        if file_result.failed > 0 or file_result.timed_out:
            failed_files[file_result.path] = true

    # Get all features and update status based on test results
    val all_features: [Feature] = fdb.all_features()
    for feature in all_features:
        # Typed rebind so the seed's field-index resolver sees a concrete struct
        val feat: Feature = feature
        val spec = feat.spec_file
        if spec != "" and spec.ends_with(".spl"):
            if failed_files.has(spec):
                # Test failed - mark feature as failed
                fdb.update_feature_status(feat.id, FeatureStatus.Failed)
            else:
                # Check if spec was in test results and passed
                for file_result in result.files:
                    if file_result.path == spec and file_result.failed == 0 and not file_result.timed_out:
                        # Test passed - mark feature as done if not already
                        if feat.pure_status != FeatureStatus.Done:
                            fdb.update_feature_status(feat.id, FeatureStatus.Done)
