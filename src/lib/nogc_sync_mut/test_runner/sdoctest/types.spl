# SDoctest Type Definitions
#
# All data structures for the sdoctest documentation testing system.

# =========================================================================
# Modifier Enum - inline fence modifiers
# =========================================================================

enum SdoctestModifier:
    Skip
    Ignore
    ShouldFail
    FailAsSuccess
    IgnoreOutput
    Init(text)
    Env(text)
    Tag(text)
    RunConfig(text)

# =========================================================================
# Block Status
# =========================================================================

enum BlockStatus:
    Passed
    Failed
    Skipped
    Error

# =========================================================================
# Source Config - an entry in sources list
# =========================================================================

struct SdoctestSource:
    path: text
    is_dir: bool
    pattern: text
    init: text
    env: text

# =========================================================================
# Init Script Config
# =========================================================================

struct SdoctestInitScript:
    name: text
    file: text

# =========================================================================
# Environment Config
# =========================================================================

struct SdoctestEnv:
    name: text
    timeout: i64
    env_vars: Dict<text, text>
    run_config: text

# =========================================================================
# Ignore Config
# =========================================================================

struct SdoctestIgnore:
    paths: [text]
    tags: [text]

# =========================================================================
# Top-Level Config
# =========================================================================

struct SdoctestConfig:
    version: i64
    default_timeout: i64
    sources: [SdoctestSource]
    ignore: SdoctestIgnore
    init_scripts: [SdoctestInitScript]
    environments: [SdoctestEnv]

# =========================================================================
# Extracted Code Block
# =========================================================================

struct SdoctestBlock:
    source_file: text
    line_number: i64
    code: text
    language: text
    modifiers: [SdoctestModifier]
    # Original prompted transcript retains expected output for runtime comparison.
    # Raw fences and existing constructor callers remain source-only.
    transcript: text = ""

impl SdoctestBlock:
    fn has_modifier_skip() -> bool:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.Skip: return true
                case _: pass
        false

    fn has_modifier_ignore() -> bool:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.Ignore: return true
                case _: pass
        false

    fn has_modifier_should_fail() -> bool:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.ShouldFail: return true
                case _: pass
        false

    fn has_modifier_fail_as_success() -> bool:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.FailAsSuccess: return true
                case _: pass
        false

    fn has_modifier_ignore_output() -> bool:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.IgnoreOutput: return true
                case _: pass
        false

    fn get_init_name() -> text:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.Init(name): return name
                case _: pass
        ""

    fn get_env_name() -> text:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.Env(name): return name
                case _: pass
        ""

    fn get_run_config() -> text:
        for m in self.modifiers:
            match m:
                case SdoctestModifier.RunConfig(rc): return rc
                case _: pass
        ""

    fn get_tags() -> [text]:
        var tags: [text] = []
        for m in self.modifiers:
            match m:
                case SdoctestModifier.Tag(t): tags.push(t)
                case _: pass
        tags

# =========================================================================
# Block Result
# =========================================================================

struct BlockResult:
    block: SdoctestBlock
    status: BlockStatus
    duration_ms: i64
    stdout: text
    stderr: text
    error: text

# =========================================================================
# File Result (aggregates blocks from one markdown file)
# =========================================================================

struct SdoctestFileResult:
    source_file: text
    blocks: [BlockResult]
    total: i64
    passed: i64
    failed: i64
    skipped: i64
    errors: i64
    accepted: i64
    duration_ms: i64

# =========================================================================
# Run Result (aggregates all files)
# =========================================================================

struct SdoctestRunResult:
    files: [SdoctestFileResult]
    total: i64
    passed: i64
    failed: i64
    skipped: i64
    errors: i64
    accepted: i64
    duration_ms: i64

impl SdoctestRunResult:
    fn is_ok() -> bool:
        self.failed == 0 and self.errors == 0

# =========================================================================
# Exports
# =========================================================================


# =========================================================================
# should_fail classification
# =========================================================================

# A `should_fail` example passes only when the EXAMPLE itself failed: an
# assertion, a panic, or a runtime/semantic error raised by its code. A child
# that never really ran the example (missing binary, spawn failure, unknown
# extern, unresolvable module, or a death by signal with no assert/panic
# diagnostic) is infrastructure, not the expected failure, and must never
# read as a pass. Returns "" for a genuine example failure, otherwise the
# infrastructure reason. exit_code 0 is not a failure at all. Consequence by
# design: an example whose point is a bad `use` or an unbacked extern cannot
# be a should_fail example (it reads as an Error).
fn should_fail_infra_reason(exit_code: i64, stderr: text) -> text:
    if exit_code == 0:
        return ""
    # Seed and self-hosted (loader / native lane) wordings.
    if stderr.contains("unknown extern function") or stderr.contains("Unknown extern") or
            stderr.contains("unimplemented extern function") or stderr.contains("undefined symbol: "):
        return "infrastructure: unknown extern (not the example's own failure): " + _sf_first_error_line(stderr)
    if stderr.contains("Cannot resolve module") or stderr.contains("Module resolution error") or
            stderr.contains("Module not found") or stderr.contains("module not found"):
        return "infrastructure: module resolution failed (not the example's own failure): " + _sf_first_error_line(stderr)
    if exit_code == 126 or exit_code == 127:
        return "infrastructure: child binary could not be executed (exit {exit_code})"
    if exit_code == -1:
        # -1 is the runtime's sentinel for timeout, spawn failure AND signal
        # death. Only an assert/panic abort carries a diagnostic naming it.
        if stderr.contains("Assertion violation") or stderr.contains("assertion failed") or
                stderr.contains("PANIC") or stderr.contains("panicked") or stderr.contains("panic:"):
            return ""
        if stderr == "":
            return "infrastructure: child failed to start or died without a diagnostic"
        return "infrastructure: child died abnormally without an assert/panic diagnostic: " + _sf_first_error_line(stderr)
    ""

fn _sf_first_error_line(stderr: text) -> text:
    for line in stderr.split("\n"):
        if line.contains("error") or line.contains("Error"):
            return line.trim()
    stderr.trim()
