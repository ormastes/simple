# Test Runner Type Definitions
#
# Core types used throughout the test runner.

val TEST_OUTPUT_CAPTURE_BYTES: i64 = 4 * 1024 * 1024

# =========================================================================
# Execution Mode
# =========================================================================

enum TestExecutionMode:
    Interpreter
    Smf
    Native
    Compile
    Composite(spec: text)

# =========================================================================
# Test Level Filter
# =========================================================================

enum TestLevel:
    All
    Unit
    Integration
    System

# =========================================================================
# Output Format
# =========================================================================

enum OutputFormat:
    Text
    Doc
    Both  # seed-compiler duplicate-name compatibility

# =========================================================================
# Stable top-level outcome
# =========================================================================

enum TestRunOutcome:
    Pass
    AssertionOrChildFailure
    UsageError
    InternalError
    EmptySelection
    TimeoutResourceFailure
    # A spec whose child produced NO result line at all, or whose child was
    # killed by the host (SIGTERM/SIGKILL, earlyoom) / timed out. This is
    # UNVERIFIED: it says nothing about whether the code is correct, so it is
    # never a failure verdict -- but it is never a pass either. Requirement R3,
    # doc/02_requirements/infra/supervised_test_runner.md.
    Unverified

# =========================================================================
# Test Options
# =========================================================================

struct TestOptions:
    path: text
    # All positional targets supplied on the command line, in order. Defaults
    # to empty for the few constructors that build options programmatically;
    # consumers fall back to [path] when it is empty.
    paths: [text] = []
    path_explicit: bool
    level: TestLevel
    tag: text
    fail_fast: bool
    # REQ-MC-012 profile-aware execution: resolved lint/safety strictness
    # tier ("moderate"|"strict"|"robust"|"critical", already normalized from
    # CLI --profile= or a deprecated alias); "" means unresolved here (the
    # simple.sdn lints.profile fallback is applied later, in
    # propagate_env_vars -> resolve_effective_profile).
    profile: text
    mode: TestExecutionMode
    timeout: i64
    list: bool
    list_ignored: bool
    only_slow: bool
    only_skipped: bool
    show_tags: bool
    gc_log: bool
    gc_off: bool
    seed: i64
    seed_set: bool
    safe_mode: bool
    force_rebuild: bool
    keep_artifacts: bool
    run_all: bool
    # True only for the release-complete `--whole` surface. Unlike `--all`,
    # this also makes doctest discovery repository-scoped: the conventional
    # positional spec root (`simple test test --whole`) must not accidentally
    # narrow Markdown discovery to test/ or source-comment discovery away from
    # the production src/ roots.
    whole: bool = false
    # Unstable mode: run each unit in its own process and continue to the end
    # of the list, classifying outcomes. Default ON for the bootstrap path, OFF
    # for interactive runs; unstable_mode_set records an explicit --unstable /
    # --no-unstable so the path default only applies when the flag is absent.
    unstable_mode: bool
    unstable_mode_set: bool
    format: text
    list_skip_features: bool
    planned_only: bool
    no_limits: bool
    sdoctest: bool
    sdoctest_env: text
    sdoctest_force: bool
    no_db: bool
    verbose: bool
    coverage: bool
    execution_mode: text
    container_sequential: bool
    self_protect: bool
    resume: bool
    cpu_threshold: f64
    mem_threshold: f64
    parallel: bool
    sequential: bool
    max_workers: i64
    parallel_timeout: i64
    closure_warnings: bool
    ci_mode: bool
    # Advanced testing modes (fuzz, chaos, deploy, security)
    fuzz_mode: bool
    fuzz_time_secs: i64
    fuzz_corpus_dir: text
    fuzz_differential: bool
    fuzz_shrink: bool
    chaos_mode: bool
    chaos_trials: i64
    chaos_fault_rate: i64
    deploy_mode: bool
    deploy_platform: text
    deploy_upgrade: bool
    security_mode: bool
    security_scan: bool
    security_supply_chain: bool
    spl_doctest: bool
    max_mem_gb: i64
    max_procs: i64
    mem_check: bool
    fork_mode: bool
    # Resource governor options
    resource_limit_pct: i64
    # Manifest/cache options
    no_cache: bool
    refresh_manifest: bool
    manifest_status: bool
    clean: bool
    # Session sharing options
    session_share: bool
    session_daemon: bool
    session_kind: text
    max_sessions: i64
    session_debug: bool
    session_reset: text
    assert_ran: bool
    # Coverage annotation check
    no_cover_check: bool
    # Hidden parent-RSS batch transport.
    batch_size: i64
    batch_manifest: text
    batch_result: text

fn doctest_discovery_scope_path(options: TestOptions) -> text:
    """Return the explicit doctest target, or empty for repository scope.

    The positional `test` in `simple test test --whole` is the spec root. It
    is not provenance for either documentation lane: Markdown comes from the
    configured sdoctest sources and comment doctests come from production
    source roots. Keeping this decision pure makes the release-command scope
    directly regression-testable without launching the full suite."""
    if options.whole:
        return ""
    if options.path_explicit:
        return options.path
    ""

fn production_spl_doctest_roots() -> [text]:
    """Canonical source-comment provenance for a repository-wide run."""
    ["src/lib/", "src/compiler/", "src/app/"]

fn test_empty_selection_is_success(options: TestOptions) -> bool:
    not options.path_explicit or options.list or options.spl_doctest

# =========================================================================
# Test File Result
# =========================================================================

struct TestFileResult:
    path: text
    passed: i64
    failed: i64
    skipped: i64
    pending: i64
    duration_ms: i64
    setup_ms: i64
    error: text
    timed_out: bool
    cached: bool
    # Examples neutralised by `# @tag:in-development` (see
    # src/lib/nogc_sync_mut/spec/in_development.spl).
    #
    # A SEPARATE bucket from `skipped`, deliberately and by user directive.
    # `skipped` means the environment could not run it (no GPU, wrong OS,
    # `@tag:qemu`); in-development means the spec RAN and only its verdict
    # was neutralised because the code under test is unfinished. Merging
    # them misdescribes the mechanism and reads as if the work is being
    # hidden. Defaulted so none of the ~85 existing constructor sites
    # change.
    in_development: i64 = 0

impl TestFileResult:
    # Routed through the single classifier below rather than re-deriving the
    # rule: OK is the ONLY class that is a pass. The old spelling
    # (`failed == 0 and error == "" and not timed_out`) reported a run that
    # produced no examples and no error -- the silent-green shape -- as a pass.
    fn is_ok() -> bool:
        test_file_result_outcome_class(self) == "OK"

# =========================================================================
# Test Run Result
# =========================================================================

struct TestRunResult:
    files: [TestFileResult]
    total_passed: i64
    total_failed: i64
    total_skipped: i64
    total_pending: i64
    total_timed_out: i64
    total_duration_ms: i64
    total_setup_ms: i64
    total_cached: i64

impl TestRunResult:
    # The aggregate counters are NOT sufficient. A CRASHED / TERMINATED /
    # NOT_RUN unit, or a unit whose error carries an unrecognised class token,
    # can leave total_failed and total_timed_out both at 0 -- which is exactly
    # how "All tests passed!" was printed over a run that never verified
    # anything. Every file must classify OK.
    fn is_ok() -> bool:
        if self.total_failed != 0 or self.total_timed_out != 0:
            return false
        for file_result in self.files:
            if test_file_result_outcome_class(file_result) != "OK":
                return false
        true

fn classify_test_run_result(result: TestRunResult, empty_is_success: bool) -> TestRunOutcome:
    if result.total_timed_out > 0:
        return TestRunOutcome.TimeoutResourceFailure
    if result.files.len() == 0:
        if result.total_failed > 0:
            return TestRunOutcome.InternalError
        if not empty_is_success:
            return TestRunOutcome.EmptySelection
        return TestRunOutcome.Pass
    for file_result in result.files:
        # Host interference (SIGTERM/SIGKILL/timeout) and never-executed specs
        # are UNVERIFIED, not failures. Checked BEFORE the InternalError rule
        # below so a contended host cannot manufacture a phantom code defect.
        if test_file_result_is_unverified(file_result):
            return TestRunOutcome.Unverified
        if file_result.error != "" and file_result.failed == 0:
            return TestRunOutcome.InternalError
    if result.total_failed > 0:
        return TestRunOutcome.AssertionOrChildFailure
    TestRunOutcome.Pass

# =========================================================================
# Outcome classification -- canonical implementation
# =========================================================================
#
# This is the SAME rule test_runner_output.spl documents as "the single source
# of truth", implemented here instead of there because the import edge runs
# output -> types (test_runner_output.spl:5) and never the other way. Calling
# the output copy from here would make that edge a cycle, so the classifier
# lives in the LOWER module and output is expected to call down into it.
#
# Naming note: while test_runner_output.spl still carries its own copy, these
# are named test_outcome_class_token / test_file_result_outcome_class rather
# than reusing the output-side names, because src/lib/nogc_sync_mut/
# test_runner/main.spl wildcard-imports BOTH modules and two exported symbols
# with one name would collide. Once output.spl is changed to import from here
# (an edit this lane does not own) the duplicate should be deleted outright.
#
# Only the CLASS token -- the text before the first colon -- is structural.
# Tokenising (trim / upper / `_` -> space) rather than prefix-matching the
# whole error string means the "TERMINATED:" (with colon) and "TERMINATED"
# (without colon) spellings that had already drifted between these two files
# classify identically, and rewording a human-readable message cannot silently
# move a count.
fn test_outcome_class_token(err: text) -> text:
    if err == "":
        return ""
    val colon = err.find(":")
    val head = if colon > 0: err[0:colon] else: err
    head.trim().upper().replace("_", " ")

# Total: every TestFileResult maps to exactly one of
# OK / ERROR / CRASHED / TERMINATED / TIMEOUT / NOT_RUN.
fn test_file_result_outcome_class(file_result: TestFileResult) -> text:
    val token = test_outcome_class_token(file_result.error)
    if token == "CRASHED":
        return "CRASHED"
    if token == "TERMINATED":
        return "TERMINATED"
    if token == "TIMEOUT":
        return "TIMEOUT"
    if token == "NOT EXECUTED" or token == "NOT RUN":
        return "NOT_RUN"
    if token != "":
        # A non-empty error with an unrecognised class token is a REAL failure.
        # It must never fall through to OK -- that is the silent-green shape.
        return "ERROR"
    if file_result.timed_out:
        return "TIMEOUT"
    if file_result.failed > 0:
        return "ERROR"
    val examples = (file_result.passed + file_result.failed +
                    file_result.skipped + file_result.pending +
                    file_result.in_development)
    if examples == 0:
        # No error and no examples of any kind: the child produced no verdict.
        return "NOT_RUN"
    "OK"

# A file result carries no verdict when its child was killed / timed out / never
# ran, or when it reported no examples of any kind with no error to explain it.
# The latter is the silent-green shape: exit 0 with no `Results:` line.
fn test_file_result_is_unverified(file_result: TestFileResult) -> bool:
    val cls = test_file_result_outcome_class(file_result)
    # CRASHED and ERROR are real verdicts and are handled by the caller.
    cls == "TERMINATED" or cls == "TIMEOUT" or cls == "NOT_RUN"

fn test_run_outcome_exit_code(outcome: TestRunOutcome) -> i64:
    match outcome:
        case Pass: 0
        case AssertionOrChildFailure: 1
        case UsageError: 2
        case InternalError: 3
        case EmptySelection: 4
        case TimeoutResourceFailure: 124
        case Unverified: 5

fn test_run_outcome_name(outcome: TestRunOutcome) -> text:
    match outcome:
        case Pass: "pass"
        case AssertionOrChildFailure: "assertion_or_child_failure"
        case UsageError: "usage_error"
        case InternalError: "internal_error"
        case EmptySelection: "empty_selection"
        case TimeoutResourceFailure: "timeout_resource_failure"
        case Unverified: "unverified"

# =========================================================================
# Skip Feature Info
# =========================================================================

struct SkipFeatureInfo:
    file_path: text
    title: text
    feature_ids: text
    category: text
    status: text

# =========================================================================
# Platform Specification Helper Functions
# =========================================================================

fn execution_mode_from_string(mode: text) -> TestExecutionMode:
    """Parse execution mode from string, supporting nested syntax."""
    val trimmed = mode.trim()
    if trimmed.contains("("):
        return TestExecutionMode.Composite(trimmed)
    match trimmed.lower():
        case "interpreter": TestExecutionMode.Interpreter
        case "smf": TestExecutionMode.Smf
        case "native": TestExecutionMode.Native
        case "compile": TestExecutionMode.Compile
        case _: TestExecutionMode.Interpreter

fn execution_mode_base_runtime(mode: TestExecutionMode) -> text:
    """Extract base runtime layer (interpreter, smf, native)."""
    match mode:
        case Interpreter: "interpreter"
        case Smf: "smf"
        case Native: "native"
        case Compile: "compile"
        case Composite(spec):
            val first_paren = spec.find("(")
            if first_paren > 0:
                spec[0:first_paren].trim()
            else:
                "interpreter"

fn execution_mode_is_composite(mode: TestExecutionMode) -> bool:
    """Check if this is a composite platform spec."""
    match mode:
        case Composite(_): true
        case _: false

fn execution_mode_has_layer(mode: TestExecutionMode, layer: text) -> bool:
    """Check if spec contains a specific layer."""
    match mode:
        case Composite(spec): spec.contains(layer)
        case _: false

fn execution_mode_is_remote(mode: TestExecutionMode) -> bool:
    """Check if execution happens on remote target."""
    execution_mode_has_layer(mode, "remote")

fn execution_mode_is_baremetal(mode: TestExecutionMode) -> bool:
    """Check if target is bare-metal (no OS)."""
    execution_mode_has_layer(mode, "baremetal")

fn execution_mode_is_container(mode: TestExecutionMode) -> bool:
    """Check if execution happens in container."""
    execution_mode_has_layer(mode, "container")

fn execution_mode_target_arch(mode: TestExecutionMode) -> text:
    """Extract target architecture from spec."""
    match mode:
        case Composite(spec):
            val archs = ["riscv32", "arm32", "x86_64", "aarch64", "mips"]
            var i = 0
            while i < archs.len():
                if spec.contains(archs[i]):
                    return archs[i]
                i = i + 1
            "host"
        case _: "host"

fn execution_mode_to_string(mode: TestExecutionMode) -> text:
    """Convert to string representation."""
    match mode:
        case Interpreter: "interpreter"
        case Smf: "smf"
        case Native: "native"
        case Compile: "compile"
        case Composite(spec): spec

# =========================================================================
# Exports
# =========================================================================
