# Explicit, bounded coverage of native request admission. This is not automatic
# source coverage, condition coverage, or coverage of the complete test runner.
# Counters stay in this process; enabling them does not change child compiler
# settings or the ordinary test coverage collector.
use std.sffi.host.{raw_i64_to_string}

var _runner_self_coverage_active = false
var _runner_self_true: [i64] = [0, 0, 0, 0, 0, 0]
var _runner_self_false: [i64] = [0, 0, 0, 0, 0, 0]

pub fn runner_self_coverage_start():
    _runner_self_true = [0, 0, 0, 0, 0, 0]
    _runner_self_false = [0, 0, 0, 0, 0, 0]
    _runner_self_coverage_active = true

pub fn runner_self_coverage_decision(site: i64, result: bool) -> bool:
    if _runner_self_coverage_active and site >= 1 and site <= 6:
        val index = site - 1
        if result:
            _runner_self_true[index] = _runner_self_true[index] + 1
        else:
            _runner_self_false[index] = _runner_self_false[index] + 1
    result

pub fn runner_self_coverage_sdn() -> text:
    # Standard decision-condition-v1 rows include every declared site, including
    # unexecuted sites. The independent scope metadata forbids a whole-runner
    # percentage; no condition or MC/DC claim is made from decision outcomes.
    var rows = ["# Coverage Report", "version: 1.0",
        "coverage_extension: decision-condition-v1",
        "measurement: explicit-owner-decision-probes-v1",
        "scope: native_test_request_error-six-admission-decisions",
        "whole_runner_coverage: false", "automatic_source_coverage: false",
        "declared_decisions: 6", "",
        "decisions |id, file, line, column, true_count, false_count|"]
    val lines = [65, 67, 68, 70, 72, 74]
    var index = 0
    while index < 6:
        val source_line: i64 = lines[index]
        val yes: i64 = _runner_self_true[index]
        val no: i64 = _runner_self_false[index]
        rows.push(raw_i64_to_string(index + 1) + ", src/lib/nogc_sync_mut/test_runner/native_compile_contract.spl, " +
            raw_i64_to_string(source_line) + ", 4, " + raw_i64_to_string(yes) + ", " + raw_i64_to_string(no))
        index = index + 1
    rows.push("")
    rows.push("conditions |decision_id, condition_id, file, line, column, true_count, false_count|")
    rows.join("\n") + "\n"
