# Test Compiler Selection
#
# Resolves `--compiler=<selector>` to the binary the runner executes specs
# with. Fails closed: a selected compiler that cannot be pinned is an Err,
# never a silent fall back to the seed or the deployed bin/simple.
#
# "phase2" -> the phase2-built full CLI (env SIMPLE_PHASE2_FULL_CLI, pinned by
# SIMPLE_PHASE2_FULL_CLI_SHA256). "" -> the explicit binary (SIMPLE_BINARY).

use std.io_runtime.{file_hash_sha256_or_empty}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.env_ops.{env_get}

fn _is_sha256_hex(s: text) -> bool:
    if s.len() != 64:
        return false
    for c in s.lower().chars():
        if not ((c >= "0" and c <= "9") or (c >= "a" and c <= "f")):
            return false
    true

fn resolve_test_compiler(selector: text, phase2_cli: text, phase2_sha256: text, explicit_binary: text) -> Result<text, text>:
    if selector == "":
        return Ok(explicit_binary)
    if selector != "phase2":
        return Err("unknown --compiler value '" + selector + "' (expected: phase2)")
    if phase2_cli == "":
        return Err("--compiler=phase2 requires SIMPLE_PHASE2_FULL_CLI (the phase2-built full CLI)")
    if phase2_sha256 == "":
        return Err("--compiler=phase2 requires SIMPLE_PHASE2_FULL_CLI_SHA256")
    if not _is_sha256_hex(phase2_sha256):
        return Err("SIMPLE_PHASE2_FULL_CLI_SHA256 is not a 64-char hex sha256: '" + phase2_sha256 + "'")
    Ok(phase2_cli)

# Resolve `selector` from the environment AND verify the on-disk identity of
# the selected CLI. Ok("") means "no explicit compiler" (caller keeps its own
# binary); Err is a refusal to run (exit 2 at the CLI surface).
fn select_test_child_binary(selector: text) -> Result<text, text>:
    if selector == "":
        return Ok("")
    val sha = env_get("SIMPLE_PHASE2_FULL_CLI_SHA256") ?? ""
    match resolve_test_compiler(selector, env_get("SIMPLE_PHASE2_FULL_CLI") ?? "", sha, ""):
        case Err(e):
            return Err(e)
        case Ok(path):
            if not file_exists(path):
                return Err("SIMPLE_PHASE2_FULL_CLI does not exist: " + path)
            val actual = file_hash_sha256_or_empty(path)
            if actual.lower() != sha.lower():
                return Err("SIMPLE_PHASE2_FULL_CLI sha256 mismatch: declared " + sha + ", actual " + actual + " (" + path + ")")
            return Ok(path)
