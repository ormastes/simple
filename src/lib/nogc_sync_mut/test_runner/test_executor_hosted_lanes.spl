# Test Executor Hosted Lanes — host-capability composite lanes
#
# GPU (cuda/vulkan) executors and JIT-upload lanes (QEMU, STM32, CH32V,
# GHDL, TRACE32) need host capabilities that only some machines have: GPU
# drivers, debug probes, simulators, and the hosted runtime symbols behind
# them (rt_cuda_*, rt_vulkan_*, rt_ghdl_*, TRACE32 sockets, ...). They are
# NOT part of the core test runner closure. test_executor_composite.spl
# reaches them only by spawning `simple run
# src/app/test_runner_new/hosted_lane_main.spl`, so the capability is loaded
# by the child interpreter on demand and a host without it reports a named
# failure ("unknown extern function: ...") instead of the core runner failing
# to link. Do not import this module from the core runner closure.

use std.test_runner.test_runner_types.{TestFileResult, TestOptions}
use std.nogc_sync_mut.io.file_ops.{file_read}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{shell}
use std.nogc_sync_mut.jit.jit_types.{JitBinary}
use std.nogc_sync_mut.jit.jit_util.{hex_i64}
use std.nogc_sync_mut.debug.remote.exec.types.{MemoryMap, Architecture}
use std.nogc_sync_mut.debug.remote.exec.compiler_bridge.{compile_remote_binary}
use std.nogc_sync_mut.jit.jit_layout.{append_halt_trampoline_arm32, plan_binary_layout_arm32, jit_entry_pc_arm32, jit_return_pc_arm32}
use std.nogc_sync_mut.jit.jit_hal_stm32h7.{stm32h7_connect, stm32h7_disconnect, stm32h7_write_code, stm32h7_read_code, stm32h7_write_register, stm32h7_read_register, stm32h7_resume}
use std.test_runner.test_executor_composite_jit_generic.{run_test_file_jit_qemu_rv32, run_test_file_jit_qemu_arm, run_test_file_jit_stm32wb, run_test_file_jit_stm32h7_adapter, run_test_file_jit_ch32v307, run_test_file_jit_ghdl_rv32, run_test_file_jit_trace32_stm32h7, run_test_file_jit_trace32_stm32wb}
use std.gc_async_mut.gpu_lane.cuda_jit_lane_executor.{CudaJitLaneExecutor}
use std.gc_async_mut.gpu_lane.vulkan_jit_lane_executor.{VulkanJitLaneExecutor}
use std.gc_async_mut.gpu_lane.cuda_vm_executor.{CudaVmExecutor}
use std.gc_async_mut.gpu_lane.vulkan_vm_executor.{VulkanVmExecutor}
use std.common.svmg.mailbox_const.{SENTINEL_EXIT_MASK}
use std.sffi.io.{file_read_bytes}

# =========================================================================
# GPU lanes (concrete GpuLaneExecutor implementations)
# =========================================================================

fn _gpu_lane_result(file_path: text, setup_ms: i64, passed: i64, failed: i64, skipped: i64, error: text) -> TestFileResult:
    TestFileResult(path: file_path, passed: passed, failed: failed, skipped: skipped, pending: 0,
        duration_ms: 0, setup_ms: setup_ms, error: error, timed_out: false, cached: false)

fn _run_cuda_jit_lane(file_path: text, setup_ms: i64, session_id: text) -> TestFileResult:
    var executor = CudaJitLaneExecutor.create()
    val prepared = executor.prepare(session_id)
    if not prepared.is_ok():
        val err = prepared.unwrap_err()
        if err.starts_with("skip:"):
            return _gpu_lane_result(file_path, setup_ms, 0, 0, 1, err)
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "cuda_jit lane failed: {err}")
    val ran = executor.run_program([])
    if not ran.is_ok():
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "cuda_jit lane failed: {ran.unwrap_err()}")
    if not executor.teardown():
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "cuda_jit lane failed: teardown-failed")
    _gpu_lane_result(file_path, setup_ms, 1, 0, 0, "")

fn _run_vulkan_jit_lane(file_path: text, setup_ms: i64, session_id: text) -> TestFileResult:
    var executor = VulkanJitLaneExecutor.create()
    val prepared = executor.prepare(session_id)
    if not prepared.is_ok():
        val err = prepared.unwrap_err()
        if err.starts_with("skip:"):
            return _gpu_lane_result(file_path, setup_ms, 0, 0, 1, err)
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "vulkan_jit lane failed: {err}")
    val ran = executor.run_program([0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8])
    if not ran.is_ok():
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "vulkan_jit lane failed: {ran.unwrap_err()}")
    if not executor.teardown():
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "vulkan_jit lane failed: teardown-failed")
    _gpu_lane_result(file_path, setup_ms, 1, 0, 0, "")

fn _run_cuda_vm_lane(file_path: text, setup_ms: i64) -> TestFileResult:
    val kernel_bytes = file_read_bytes("src/lib/gc_async_mut/gpu_lane/svmg_cuda_kernel.ptx")
    if kernel_bytes.len() == 0:
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "cuda_vm lane failed: svmg_cuda_kernel.ptx artifact missing/empty")
    var executor = CudaVmExecutor.create()
    val init_err = executor.init(kernel_bytes)
    if init_err != "":
        if init_err.starts_with("skip:"):
            return _gpu_lane_result(file_path, setup_ms, 0, 0, 1, init_err)
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "cuda_vm lane failed: {init_err}")
    val outcome = executor.run_source("HALT 7", 1000, 0)
    executor.shutdown()
    if not outcome.ok or outcome.sentinel != (SENTINEL_EXIT_MASK | 7):
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "cuda_vm lane failed: {outcome.error}")
    _gpu_lane_result(file_path, setup_ms, 1, 0, 0, "")

fn _run_vulkan_vm_lane(file_path: text, setup_ms: i64) -> TestFileResult:
    val kernel_bytes = file_read_bytes("src/lib/gc_async_mut/gpu_lane/svmg_vulkan_kernel.spv")
    if kernel_bytes.len() == 0:
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "vulkan_vm lane failed: svmg_vulkan_kernel.spv artifact missing/empty")
    var executor = VulkanVmExecutor.create()
    val init_err = executor.init(kernel_bytes)
    if init_err != "":
        if init_err.starts_with("skip:"):
            return _gpu_lane_result(file_path, setup_ms, 0, 0, 1, init_err)
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "vulkan_vm lane failed: {init_err}")
    val outcome = executor.run_source("HALT 7", 1000, 0)
    executor.shutdown()
    if not outcome.ok or outcome.sentinel != (SENTINEL_EXIT_MASK | 7):
        return _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "vulkan_vm lane failed: {outcome.error}")
    _gpu_lane_result(file_path, setup_ms, 1, 0, 0, "")

fn run_hosted_gpu_lane(file_path: text, lane_id: text, setup_ms: i64) -> TestFileResult:
    """Run one concrete GPU lane. The caller has already passed the symbol
    and driver probes; lane ids without a concrete executor are a named
    failure, never a silent pass."""
    val session_id = "gpu_lane_dispatch_{file_path}"
    if lane_id == "cuda_jit":
        return _run_cuda_jit_lane(file_path, setup_ms, session_id)
    if lane_id == "vulkan_jit":
        return _run_vulkan_jit_lane(file_path, setup_ms, session_id)
    if lane_id == "cuda_vm":
        return _run_cuda_vm_lane(file_path, setup_ms)
    if lane_id == "vulkan_vm":
        return _run_vulkan_vm_lane(file_path, setup_ms)
    _gpu_lane_result(file_path, setup_ms, 0, 1, 0, "gpu lane has no concrete executor: {lane_id}")

# =========================================================================
# JIT upload lanes
# =========================================================================

fn run_test_file_jit(file_path: text, options: TestOptions, arch: text, target: text) -> TestFileResult:
    """Execute test via JIT upload to remote target.

    Compiles .spl source to native code, uploads to target RAM via debug protocol,
    executes, and collects results.
    """
    val start = time_now_unix_micros()

    if not file_path.ends_with(".spl"):
        val end = time_now_unix_micros()
        return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
            duration_ms: (end - start) / 1000, setup_ms: 0,
            error: "JIT mode only supports .spl files, got: {file_path}", timed_out: false, cached: false)

    val source = file_read(file_path)
    if source.trim() == "":
        val end = time_now_unix_micros()
        return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
            duration_ms: (end - start) / 1000, setup_ms: 0,
            error: "JIT source file is empty or unreadable: {file_path}", timed_out: false, cached: false)

    if target == "riscv32":
        return run_test_file_jit_qemu_rv32(file_path: file_path, source: source, options)
    if target == "stm32h7":
        return run_test_file_jit_stm32h7(file_path: file_path, source: source, options)
    if target == "stm32wb":
        return run_test_file_jit_stm32wb(file_path: file_path, source: source, options)
    if target == "ch32v307":
        return run_test_file_jit_ch32v307(file_path: file_path, source: source, options)
    if target == "ghdl_rv32":
        return run_test_file_jit_ghdl_rv32(file_path: file_path, source: source, options)
    if target == "trace32_stm32h7" or target == "t32_stm32h7":
        return run_test_file_jit_trace32_stm32h7(file_path: file_path, source: source, options)
    if target == "trace32_stm32wb" or target == "t32_stm32wb":
        return run_test_file_jit_trace32_stm32wb(file_path: file_path, source: source, options)
    if arch == "arm32":
        return run_test_file_jit_qemu_arm(file_path: file_path, source: source, options)

    val end = time_now_unix_micros()
    TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
        duration_ms: (end - start) / 1000, setup_ms: 0,
        error: "JIT mode is not wired for target: {target}", timed_out: false, cached: false)

fn run_test_file_jit_stm32h7(file_path: text, source: text, options: TestOptions) -> TestFileResult:
    val setup_start = time_now_unix_micros()
    val openocd_pid = match stm32h7_connect():
        case Ok(pid): pid
        case Err(reason):
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT target connect failed: {reason}", timed_out: false, cached: false)

    val limits = MemoryMap.stm32h7()
    val compiled_bytes = match compile_remote_binary(source, Architecture.Arm32, limits.code_start):
        case Ok(bytes): bytes
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT compile failed: {reason}", timed_out: false, cached: false)
    val bytes = append_halt_trampoline_arm32(compiled_bytes)
    val binary = JitBinary(
        name: file_path,
        bytes: bytes,
        entry_offset: 0,
        stack_bytes: 0,
        arch: Architecture.Arm32
    )
    var layout = match plan_binary_layout_arm32(binary, limits):
        case Ok(planned): planned
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT layout failed: {reason}", timed_out: false, cached: false)
    match stm32h7_write_code(layout.code_base, bytes):
        case Ok(_): pass
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT upload failed: {reason}", timed_out: false, cached: false)

    val readback_result = stm32h7_read_code(layout.code_base, bytes.len())
    match readback_result:
        Err(msg):
            # Skipped in interpreter mode or hardware unavailable — log and continue
            shell("echo 'SRAM readback skipped: {msg}' >&2")
        Ok(readback):
            var mismatch = false
            var idx = 0
            while idx < bytes.len():
                if bytes[idx] != readback[idx]:
                    mismatch = true
                idx = idx + 1
            if mismatch:
                stm32h7_disconnect(openocd_pid)
                val end = time_now_unix_micros()
                return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                    duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                    error: "SRAM readback mismatch", timed_out: false, cached: false)

    match stm32h7_write_register(13, layout.stack_top):
        case Ok(_): pass
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT set SP failed: {reason}", timed_out: false, cached: false)

    match stm32h7_write_register(14, jit_return_pc_arm32(layout)):
        case Ok(_): pass
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT set LR failed: {reason}", timed_out: false, cached: false)

    match stm32h7_write_register(15, jit_entry_pc_arm32(layout)):
        case Ok(_): pass
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: (end - setup_start) / 1000,
                error: "JIT set PC failed: {reason}", timed_out: false, cached: false)

    val setup_end = time_now_unix_micros()
    val setup_ms = (setup_end - setup_start) / 1000

    val exec_start = time_now_unix_micros()
    match stm32h7_resume():
        case Ok(_): pass
        case Err(reason):
            stm32h7_disconnect(openocd_pid)
            val end = time_now_unix_micros()
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: 0, setup_ms: setup_ms,
                error: "JIT resume failed: {reason}", timed_out: false, cached: false)

    shell("sleep 0.5")
    val r0_result = stm32h7_read_register(0)
    val pc_after_result = stm32h7_read_register(15)
    val exec_end = time_now_unix_micros()
    stm32h7_disconnect(openocd_pid)

    val r0 = match r0_result:
        case Ok(v): v
        case Err(reason):
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: (exec_end - exec_start) / 1000, setup_ms: setup_ms,
                error: "JIT read R0 failed: {reason}", timed_out: false, cached: false)

    val pc_after = match pc_after_result:
        case Ok(v): v
        case Err(reason):
            return TestFileResult(path: file_path, passed: 0, failed: 1, skipped: 0, pending: 0,
                duration_ms: (exec_end - exec_start) / 1000, setup_ms: setup_ms,
                error: "JIT read PC failed: {reason}", timed_out: false, cached: false)
    val expected_halt_pc = layout.halt_addr
    val expected_pc = layout.halt_addr + 2
    val pc_ok = pc_after == expected_halt_pc or pc_after == expected_pc
    val passed = if r0 == 0 and pc_ok: 1 else: 0
    val failed = if passed == 1: 0 else: 1
    val error = if passed == 1: "" else: "JIT execution mismatch: r0={r0} pc=0x{hex_i64(pc_after)} expected_pc=0x{hex_i64(expected_pc)} halt_pc=0x{hex_i64(expected_halt_pc)}"
    TestFileResult(path: file_path, passed: passed, failed: failed, skipped: 0, pending: 0,
        duration_ms: (exec_end - exec_start) / 1000, setup_ms: setup_ms, error: error, timed_out: false, cached: false)

