# Shared test-run resource identity and classification helpers.

use std.test_runner.test_runner_types.{TestOptions, execution_mode_to_string}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass}
use std.common.perf.execution_metrics.{ExecutionCohort, execution_cohort_key}
use std.io.{env_get}

fn metric_env(name: text) -> text:
    val value = env_get(name)
    if value == "": "unavailable" else: value

fn test_machine_environment_id() -> text:
    val declared = env_get("SIMPLE_MACHINE_CLASS")
    if declared != "":
        return "declared=" + declared
    # A missing policy label must not collapse every developer and CI host into
    # one statistical machine class. These established process-environment
    # facts provide a deterministic conservative fallback; unknown fields stay
    # visible in the identity instead of being guessed.
    val host = if env_get("HOSTNAME") != "": env_get("HOSTNAME") else: metric_env("COMPUTERNAME")
    val os_name = if env_get("RUNNER_OS") != "": env_get("RUNNER_OS") else: metric_env("OS")
    val arch = if env_get("RUNNER_ARCH") != "": env_get("RUNNER_ARCH") elif env_get("HOSTTYPE") != "": env_get("HOSTTYPE") else: metric_env("PROCESSOR_ARCHITECTURE")
    "fallback-host={host};os={os_name};arch={arch}"

fn test_resource_class(file_path: text) -> ExecutionResourceClass:
    if file_path.contains("/03_system/"):
        return if file_path.contains("/qemu/"): ExecutionResourceClass.Qemu else: ExecutionResourceClass.System
    if file_path.contains("/02_integration/"):
        return ExecutionResourceClass.Integration
    ExecutionResourceClass.Unit

fn test_resource_class_name(resource_class: ExecutionResourceClass) -> text:
    match resource_class:
        case ExecutionResourceClass.Integration: "integration"
        case ExecutionResourceClass.System: "system"
        case ExecutionResourceClass.Qemu: "qemu"
        case ExecutionResourceClass.Gpu: "gpu"
        case ExecutionResourceClass.Bootstrap: "bootstrap"
        case ExecutionResourceClass.Tiny: "tiny"
        case ExecutionResourceClass.Standard: "standard"
        case ExecutionResourceClass.Large: "large"
        case ExecutionResourceClass.Unbounded: "unbounded"
        case _: "unit"

fn test_execution_cohort_id(file_path: text, options: TestOptions) -> text:
    val mode = execution_mode_to_string(options.mode)
    val cache_state = if options.no_cache: "disabled" elif options.force_rebuild: "cold" else: "normal"
    execution_cohort_key(ExecutionCohort(
        scenario: mode,
        semantic_configuration_id: "profile={options.profile};gc_off={options.gc_off};safe={options.safe_mode}",
        machine_environment_id: test_machine_environment_id(),
        workload_id: file_path,
        ordered_aspect_plan_id: metric_env("SIMPLE_ASPECT_PLAN_DIGEST"),
        execution_mode: mode,
        target: metric_env("SIMPLE_TARGET"),
        optimization: metric_env("SIMPLE_OPT_LEVEL"),
        cache_state: cache_state,
        bootstrap_stage: metric_env("SIMPLE_BOOTSTRAP_STAGE"),
        concurrency: if options.parallel: options.max_workers else: 1,
        compiler_digest: metric_env("SIMPLE_COMPILER_DIGEST"),
        runtime_digest: metric_env("SIMPLE_RUNTIME_DIGEST"),
        schema_digest: "execution-metrics-2"))

export test_resource_class, test_resource_class_name, test_machine_environment_id, test_execution_cohort_id
