# Legacy test runner container backend.
# Process arguments remain separate values; this module never invokes a shell.

use std.nogc_sync_mut.io.process_ops.process_run
use std.nogc_sync_mut.io.file_ops.file_exists
use std.nogc_sync_mut.io_runtime.time_now_monotonic_ms

pub fn container_runtime_supported_v1(runtime: text) -> bool:
    """Only the two supported CLI adapters may be executed."""
    runtime == "docker" or runtime == "podman"

fn container_argument_valid_v1(value: text) -> bool:
    value != "" and not value.contains("\u{0}")

fn container_image_valid_v1(image: text) -> bool:
    container_argument_valid_v1(image) and not image.starts_with("-")

pub fn container_test_argv_v1(test_file: text, image: text, memory_mb: i64,
        cpu_count: f64, network: text, readonly: bool, workspace: text) -> Result<[text], text>:
    """Construct literal argv; reject option-like operands and ambiguous -v sources."""
    if not container_image_valid_v1(image):
        return Err("invalid-container-image")
    if not container_argument_valid_v1(test_file) or test_file.starts_with("-"):
        return Err("invalid-container-test-path")
    if memory_mb <= 0 or not (cpu_count > 0.0):
        return Err("invalid-container-resource-limit")
    if network != "none" and network != "bridge" and network != "host":
        return Err("unsupported-container-network")
    if not container_argument_valid_v1(workspace) or workspace.contains(":"):
        return Err("ambiguous-container-workspace")
    val mount_flag = if readonly: "ro" else: "rw"
    Ok(["run", "--rm", "--memory={memory_mb}m", "--cpus={cpu_count}",
        "--network={network}", "-v", "{workspace}:/workspace:{mount_flag}",
        "-w", "/workspace", image, "test", test_file])

pub fn container_build_argv_v1(dockerfile_path: text, image_name: text) -> Result<[text], text>:
    """Keep Dockerfile and tag in separate option values without shell expansion."""
    if not container_argument_valid_v1(dockerfile_path):
        return Err("invalid-container-dockerfile")
    if not container_image_valid_v1(image_name):
        return Err("invalid-container-image")
    Ok(["build", "--file={dockerfile_path}", "--tag={image_name}", "."])

fn container_detect_runtime() -> text:
    val docker_check = process_run("docker", ["--version"])
    if docker_check.2 == 0:
        return "docker"
    val podman_check = process_run("podman", ["--version"])
    if podman_check.2 == 0:
        return "podman"
    "none"

fn container_check_image(image: text, runtime: text) -> bool:
    if not container_runtime_supported_v1(runtime) or not container_image_valid_v1(image):
        return false
    val result = process_run(runtime, ["image", "inspect", image])
    result.2 == 0

fn container_run_test(
    test_file: text,
    runtime: text,
    image: text,
    memory_mb: i64,
    cpu_count: f64,
    network: text,
    readonly: bool,
    workspace: text
) -> (text, text, i64, i64):
    """Return stdout, stderr, exit code and elapsed ms. Clock failures are errors."""
    if not container_runtime_supported_v1(runtime):
        return ("", "Unsupported container runtime: {runtime}", 1, 0)
    val argv = container_test_argv_v1(test_file, image, memory_mb, cpu_count, network, readonly, workspace)
    if argv.is_err():
        return ("", argv.unwrap_err(), 1, 0)
    val start_time = time_now_ms()
    if start_time < 0:
        return ("", "Container monotonic clock unavailable", 1, 0)
    val result = process_run(runtime, argv.unwrap())
    val end_time = time_now_ms()
    if end_time < start_time:
        return (result.0, result.1 + "\nContainer monotonic clock failed", 1, 0)
    (result.0, result.1, result.2, end_time - start_time)

fn container_build_test_image(runtime: text, dockerfile_path: text, image_name: text) -> bool:
    if not container_runtime_supported_v1(runtime):
        return false
    val argv = container_build_argv_v1(dockerfile_path, image_name)
    if argv.is_err():
        return false
    if not file_exists(dockerfile_path):
        return false
    val result = process_run(runtime, argv.unwrap())
    result.2 == 0

fn time_now_ms() -> i64:
    """Use the time owner; never synthesize an elapsed-time sample."""
    time_now_monotonic_ms()

fn container_get_version(runtime: text) -> text:
    if not container_runtime_supported_v1(runtime):
        return ""
    val result = process_run(runtime, ["--version"])
    if result.2 != 0:
        return ""
    result.0.trim()

fn container_cleanup_volumes(runtime: text) -> bool:
    """
    Refuse deletion: this compatibility API has no exact volume identity or
    ownership receipt. False is an explicit unsupported result with no effects.
    Exact resource cleanup belongs to the typed provider ownership API.
    """
    false
