# test_runner_single.spl - Lightweight single-file test entry point
#
# Used when running a single test file: bin/simple test path/to/spec.spl
# Skips database, coverage, doc generation, sdoctest, and parallel overhead.
#
# Imports 6 modules vs test_runner_main.spl's 29+, cutting startup from ~56s to <2s.

use std.io.{env_set, env_get}
use std.sffi.cli.{cli_get_args}
use app.io.process_ops.{process_run_timeout}

use std.io_runtime.{file_exists, file_read_raw}
use std.io_runtime.{env_get}
use std.io_runtime.{env_set}
use std.io_runtime.{time_now_unix_micros}

fn mode_to_str(mode: TestExecutionMode) -> text:
    match mode:
        case TestExecutionMode.Interpreter:
            "interpreter"
        case TestExecutionMode.Smf:
            "smf"
        case TestExecutionMode.Native:
            "native"
        case TestExecutionMode.Composite(spec):
            spec

fn get_cli_args_single() -> [text]:
    val all_args = cli_get_args()
    var args: [text] = []
    var start_idx = 1
    if all_args.len() > 1 and all_args[1].ends_with("test_runner_single.spl"):
        start_idx = 2
    var i = start_idx
    while i < all_args.len():
        args = args.push(all_args[i])
        i = i + 1
    args

fn parse_child_run(args: [text]) -> ChildRun:
    var path = ""
    var timeout_secs = 120
    var list_only = false
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--timeout" and i + 1 < args.len():
            timeout_secs = to_int(args[i + 1])
            i = i + 2
            continue
        if arg.starts_with("--timeout="):
            timeout_secs = to_int(arg[10:])
            i = i + 1
            continue
        if arg == "--list":
            list_only = true
            i = i + 1
            continue
        if not arg.starts_with("-") and path == "":
            path = arg
        i = i + 1
    if path == "":
        return ChildRun(path: "", timeout_secs: timeout_secs, list_only: list_only, valid: false, error: "missing test file")
    if not path.ends_with(".spl"):
        return ChildRun(path: path, timeout_secs: timeout_secs, list_only: list_only, valid: false, error: "expected .spl test file")
    if not rt_file_exists(path):
        return ChildRun(path: path, timeout_secs: timeout_secs, list_only: list_only, valid: false, error: "test file not found")
    ChildRun(path: path, timeout_secs: timeout_secs, list_only: list_only, valid: true, error: "")

fn find_simple_binary() -> text:
    val raw = cli_get_args()
    if raw.len() > 0 and rt_file_exists(raw[0]):
        return raw[0]
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    "./bin/simple"

fn file_has_di_test_tag(file_path: text) -> bool:
    """Check if file has # @di_test tag, allowing DI modifications in system tests.

    Mirrors std.test_runner.test_runner_files.file_has_di_test_tag. Duplicated
    here (rather than imported) so this child runner stays independent of
    std.test_runner.* per the file-level design note above."""
    val content = file_read_raw(file_path)
    content.contains("# @di_test")

fn print_summary(path: text, passed: i64, failed: i64, skipped: i64, pending: i64, duration_ms: i64):
    print ""
    print "========================================="
    print "Test Summary"
    print "========================================="
    print "Files: 1"
    print "Passed: {passed}"
    print "Failed: {failed}"
    if skipped > 0:
        print "Skipped: {skipped}"
    if pending > 0:
        print "Pending: {pending}"
    print "Duration: {duration_ms}ms"
    if failed == 0:
        print ""
        print "PASS {path}"
    else:
        print ""
        print "FAIL {path}"

fn bdd_summary_counts(output: text) -> (i64, i64, i64):
    # Sum across ALL per-describe "N examples, M failures" lines. Last-wins
    # here previously let a passing final describe erase earlier failures
    # (file summary "Failed: 0" + PASS + exit 0 on a red spec).
    #
    # Uses split("\n") instead of index_of(needle, pos) scanning, and
    # intermediate vars instead of chained .replace() calls: both the 2-arg
    # index_of start offset and chained method calls are broken under the
    # interpreter `run` path this file executes on.
    var passed = -1
    var failed = -1
    val lines = output.split("\n")
    for line in lines:
        var clean = line.replace("\x1b[32m", "")
        clean = clean.replace("\x1b[31m", "")
        clean = clean.replace("\x1b[0m", "")
        clean = clean.trim()
        if clean.contains("example") and clean.contains("failure"):
            val comma = clean.index_of(",") ?? -1
            if comma > 0:
                val total_text = clean[0:comma].trim().split(" ")[0]
                val total = total_text.to_int() ?? 0
                val rest = clean[comma + 1:].trim()
                val failures_text = rest.split(" ")[0]
                val failures = failures_text.to_int() ?? 0
                if passed < 0:
                    passed = 0
                    failed = 0
                passed = passed + (total - failures)
                failed = failed + failures
    (passed, failed)

fn output_shows_timeout(stderr: text, code: i64) -> bool:
    # process_run_bounded reports a killed-on-timeout child as exit -1 plus a
    # TIMEOUT marker on stderr. Treat that as a loud failure, never as a run
    # that merely produced no summary.
    if code != -1:
        return false
    if stderr.contains("TIMEOUT"):
        return true
    stderr.contains("timed out")

fn main() -> i64:
    val run = parse_child_run(clean_args())
    if not run.valid:
        print "Simple Test Runner child"
        print "error: {run.error}: {run.path}"
        return 1
    if run.list_only:
        print run.path
        return 0
    val lines = status.split("\n")
    for line in lines:
        var clean = line.replace("\x1b[32m", "")
        clean = clean.replace("\x1b[31m", "")
        clean = clean.replace("\x1b[0m", "")
        clean = clean.trim()
        if clean.contains("example") and clean.contains("failure"):
            val comma = clean.index_of(",")
            if comma > 0:
                val total = to_int(clean[0:comma].trim().split(" ")[0])
                val rest = clean[comma + 1:].trim()
                val failures = to_int(rest.split(" ")[0])
                if passed < 0:
                    passed = 0
                    failed = 0
                passed = passed + (total - failures)
                failed = failed + failures
    (passed, failed)

    env_set("SIMPLE_RUNTIME_MODE", "interpreter")
    env_set("SIMPLE_EXECUTION_MODE", "interpret")
    val monitor_timeout = env_get("SIMPLE_TIMEOUT_SECONDS")
    # to_int("") throws and the interpreter evaluates both sides of `and`;
    # split the unset case out before any to_int call (this condition broke
    # every `simple test` run while the var was unset).
    if monitor_timeout == "":
        rt_env_set("SIMPLE_TIMEOUT_SECONDS", "{run.timeout_secs}")
    elif monitor_timeout != "0":
        if (monitor_timeout.to_int() ?? 0) < run.timeout_secs:
            rt_env_set("SIMPLE_TIMEOUT_SECONDS", "{run.timeout_secs}")
    val is_system = run.path.contains("/system/") or run.path.contains("/feature/")
    if is_system:
        rt_env_set("SIMPLE_SYSTEM_TEST", "1")
    else:
        env_set("SIMPLE_SYSTEM_TEST", "0")
    if is_system and file_has_di_test_tag(file_path):
        env_set("SIMPLE_DI_TEST", "1")
    else:
        env_set("SIMPLE_DI_TEST", "0")

    val binary = find_simple_binary()
    val timeout_ms = run.timeout_secs * 1000
    val start = rt_time_now_unix_micros()
    val (stdout, stderr, code) = process_run_bounded(binary, ["run", run.path], timeout_ms, TEST_OUTPUT_CAPTURE_BYTES)
    val duration_ms = (rt_time_now_unix_micros() - start) / 1000
    if stdout != "":
        print stdout
    if stderr != "":
        print stderr
    val (bdd_passed, bdd_failed, bdd_examples) = bdd_summary_counts(stdout + "\n" + stderr)

    if effective_options.safe_mode:
        return run_test_file_safe_mode(file_path, effective_options)
    match effective_options.mode:
        case TestExecutionMode.Interpreter:
            run_test_file_interpreter(file_path, effective_options)
        case TestExecutionMode.Smf:
            run_test_file_smf(file_path, effective_options)
        case TestExecutionMode.Native:
            run_test_file_native(file_path, effective_options)
        case TestExecutionMode.Composite(spec):
            run_test_file_composite(file_path, effective_options, spec)

    val binary = find_simple_binary()
    val timeout_ms = run.timeout_secs * 1000
    val start = time_now_unix_micros()
    val (stdout, stderr, code) = process_run_bounded(binary, ["run", run.path], timeout_ms, TEST_OUTPUT_CAPTURE_BYTES)
    val duration_ms = (time_now_unix_micros() - start) / 1000
    if stdout != "":
        print stdout
    if stderr != "":
        print stderr
    val (bdd_passed, bdd_failed, bdd_examples) = bdd_summary_counts(stdout + "\n" + stderr)

fn main() -> i64:
    env_set("SIMPLE_TEST_RUNNER_RUST", "1")

    val passed = bdd_passed
    # A non-zero child exit always fails the file, even when every describe
    # that DID run printed a green summary before the process died.
    var failed = bdd_failed
    if code != 0 and failed == 0:
        print "error: test-runner: child exited {code} after reporting 0 failures"
        failed = 1
    print_summary(run.path, passed, failed, 0, 0, duration_ms)
    if failed == 0:
        return 0

    if files.len() == 0:
        print "No test files found in {options.path}"
        return 1

    # Memory tracking support for fast single-runner path.
    # This keeps --mem-check functional even when bin/simple routes here.
    var do_mem_check = options.mem_check
    val memtrack_env = env_get("SIMPLE_MEMTRACK") ?? ""
    if memtrack_env == "1":
        do_mem_check = true

    val rss_before_tests = current_rss_kb()
    if do_mem_check:
        print "Memory tracking enabled (per-file checkpoints)"
        print "  [MEMCHK] isolation: each test file runs in a child process"
        print "  [MEMCHK] JIT/module state is reclaimed when child exits"
        print "  [MEMCHK] START test-run: rss={rss_before_tests} kB"
        print ""

    # MEMORY GROWTH: results accumulates every TestFileResult for the entire run.
    # After 1000 test files this array holds 1000 live objects (path text, error text,
    # counters). This is intentional (needed for print_summary) but is O(n) growth.
    # If RSS grows proportionally to test count here, this is the cause.
    var results: [TestFileResult] = []
    var total_passed = 0
    var total_failed = 0
    var total_skipped = 0
    var total_pending = 0
    var total_timed_out = 0
    var total_duration_ms = 0

    for file_path in files:
        val file_rss_before = current_rss_kb()
        if do_mem_check:
            print "  [MEMCHK] START {file_path}: rss={file_rss_before} kB"

        val result = run_one_test(file_path, options)
        print_result(result, options.format)

        if do_mem_check:
            val file_rss_after = current_rss_kb()
            val file_delta = file_rss_after - file_rss_before
            print "  [MEMCHK] END   {file_path}: rss={file_rss_after} kB"
            print "  [MEMDIFF] {file_path}: {file_delta} kB"

        # MEMORY GROWTH: push return value must be assigned (push returns new array).
        results = results.push(result)
        total_passed = total_passed + result.passed
        total_failed = total_failed + result.failed
        total_skipped = total_skipped + result.skipped
        total_pending = total_pending + result.pending
        if result.timed_out:
            total_timed_out = total_timed_out + 1
        total_duration_ms = total_duration_ms + result.duration_ms
        if options.fail_fast and (result.failed > 0 or result.timed_out):
            break

    if do_mem_check:
        val rss_after_tests = current_rss_kb()
        val total_delta = rss_after_tests - rss_before_tests
        print ""
        print "=== Memory Check Summary ==="
        print "  START rss: {rss_before_tests} kB"
        print "  END   rss: {rss_after_tests} kB"
        print "  DELTA rss: {total_delta} kB"
        print "============================"

    val run_result = TestRunResult(
        files: results,
        total_passed: total_passed,
        total_failed: total_failed,
        total_skipped: total_skipped,
        total_pending: total_pending,
        total_timed_out: total_timed_out,
        total_duration_ms: total_duration_ms,
        total_setup_ms: 0,
        total_cached: 0
    )

    print ""
    print_summary(run_result, options.format)

    if run_result.is_ok():
        return 0
    return 1
