# Test Level Detection
#
# Maps a spec path to its test level. Kept free of `extern` declarations and
# of any I/O so it can be imported directly by specs.
#
# BOTH test hierarchies are recognized:
#   * numbered (maintained): test/01_unit/, test/02_integration/, test/03_system/
#   * bare (legacy mirror):  test/unit/,    test/integration/,    test/system/
#
# Matching is on whole path SEGMENTS after stripping an `NN_` ordering prefix,
# never on a loose substring — so `.../opportunity/...` or `.../community/...`
# is NOT mistaken for a unit path, and `.../ecosystem/...` is not a system path.
#
# Level codes (must stay in sync with `TestManifestEntry.test_level`):
#   0 = unclassified   1 = unit   2 = integration   3 = system
#
# Directories that carry an ordering prefix but have no `TestLevel` variant
# (00_formal_verification, 04_smoke, 05_perf, 06_fuzz, 07_security,
# 08_web_platform, 09_baselines) normalize the same way as their bare
# counterparts and stay unclassified (0), exactly as before this change.

val TEST_LEVEL_NONE: i64 = 0
val TEST_LEVEL_UNIT: i64 = 1
val TEST_LEVEL_INTEGRATION: i64 = 2
val TEST_LEVEL_SYSTEM: i64 = 3

fn is_ascii_digit_char(c: text) -> bool:
    """True when `c` is a single ASCII digit character."""
    c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"

fn strip_order_prefix(segment: text) -> text:
    """Strip a leading two-digit ordering prefix: `01_unit` -> `unit`.

    Segments without the exact `NN_` shape are returned unchanged, so
    `1_unit`, `unit`, `unitary` and `_unit` all pass through untouched.
    """
    if segment.len() < 4:
        return segment
    if not is_ascii_digit_char(segment[0:1]):
        return segment
    if not is_ascii_digit_char(segment[1:2]):
        return segment
    if segment[2:3] != "_":
        return segment
    segment[3:]

fn path_level_segments(path: text) -> [text]:
    """Split `path` into normalized directory segments (order prefixes stripped)."""
    val normalized = path.replace("\\", "/")
    var out: [text] = []
    for raw in normalized.split("/"):
        if raw == "":
            continue
        out.push(strip_order_prefix(raw))
    out

fn segments_contain(segments: [text], name: text) -> bool:
    for seg in segments:
        if seg == name:
            return true
    false

fn path_has_level_segment(path: text, name: text) -> bool:
    """True when `name` appears as a whole normalized segment of `path`."""
    segments_contain(path_level_segments(path), name)

fn test_level_of_path(path: text) -> i64:
    """Classify `path` into a test level code.

    Priority order is preserved from the original substring implementation:
    unit, then integration, then system/feature, then shared.
    """
    val segs = path_level_segments(path)
    if segments_contain(segs, "unit"):
        return TEST_LEVEL_UNIT
    if segments_contain(segs, "integration"):
        return TEST_LEVEL_INTEGRATION
    if segments_contain(segs, "system") or segments_contain(segs, "feature"):
        return TEST_LEVEL_SYSTEM
    if segments_contain(segs, "shared"):
        return TEST_LEVEL_UNIT
    TEST_LEVEL_NONE

fn test_level_matches(path: text, level_code: i64) -> bool:
    """True when `path` belongs to `level_code`. Code 0 means "all levels"."""
    if level_code == TEST_LEVEL_NONE:
        return true
    test_level_of_path(path) == level_code
