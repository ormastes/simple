# Async Test Execution - True Parallel Test Running
#
# Implements parallel test execution using process_spawn_async + process_wait.
# Manages worker pool, stdout/stderr capture via temp files, and result collection.

use std.nogc_sync_mut.io.file_ops.{file_write, file_read_text_at, file_size, file_delete, file_exists}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.io.sysinfo_ops.{cpu_count}
use std.test_runner.test_runner_types.{TestFileResult, TestOptions, TEST_OUTPUT_CAPTURE_BYTES}
use std.test_runner.test_executor_parsing.{find_simple_binary, build_child_args, make_result_from_output, make_result_from_structured_evidence}
use std.test_runner.test_runner_fork.{run_test_file_fork}
use std.test_runner.child_diagnostics.{native_cleanup_diagnostic}
use std.test_runner.runner_lifecycle.{spawn_tracked_process, spawn_tracked_redirected_process, wait_tracked_process, poll_tracked_process, cleanup_all_children}
use std.test_runner.resource_governor.{ResourceGovernor, governor_create, governor_can_spawn}
use std.nogc_sync_mut.io.signal_handlers.{install_signal_handlers}
use std.nogc_sync_mut.io.signal_stubs.{signal_dispatch_pending}
use std.nogc_sync_mut.io.process_governor.{proc_slot_configure_requested_workers, proc_slot_active, proc_slot_max}
use std.nogc_sync_mut.io.process_ops.{process_is_running}
use std.nogc_sync_mut.sosix.test_process.{sosix_test_owned_capture, sosix_test_host_os, sosix_test_has_owned_completion, sosix_test_temp_dir, sosix_test_path_separator, sosix_test_spawn_plan, sosix_test_process_failure_reason, sosix_test_process_completion}
use std.common.task_runner.execution_schedule.{TaskExecutionScheduleV1,
    task_execution_schedule_v1, task_execution_ready_v1,
    task_execution_host_active_v1, task_execution_dispatch_v1,
    task_execution_reap_v1, task_execution_finish_v1,
    task_execution_spawn_denied_v1, task_execution_block_v1}

use std.io_runtime.{thread_sleep, getpid}
use std.nogc_sync_mut.test_runner.worker_memory.{sample_worker_memory, worker_memory_can_spawn, worker_memory_supported, WORKER_MEMORY_SAMPLE_INTERVAL_US}

# ============================================================================
# Async Test Execution State
# ============================================================================

struct AsyncTestRun:
    pid: i64
    file_path: text
    start_time: i64          # microseconds
    stdout_file: text
    stderr_file: text
    timeout_ms: i64
    inventory_index: i64 = -1
    evidence_file: text = ""

struct ScheduledAsyncTestResultV1:
    schedule: TaskExecutionScheduleV1
    result: TestFileResult

val _TEST_EXECUTION_HOST_V1 = "test-workers"

val _WAIT_POLL_INITIAL_MS = 10
val _WAIT_POLL_MEDIUM_MS = 50
val _WAIT_POLL_MAX_MS = 100
var _runner_signal_handlers_installed: bool = false
var _temp_file_sequence: i64 = 0

fn _cleanup_tracked_test_children():
    val _ = cleanup_all_children()

fn _ensure_runner_signal_handlers():
    if not _runner_signal_handlers_installed and not sosix_test_owned_capture():
        _runner_signal_handlers_installed = install_signal_handlers(_cleanup_tracked_test_children)

# ============================================================================
# Temp File Management
# ============================================================================

fn _get_temp_dir() -> text:
    """Get platform-appropriate temp directory"""
    sosix_test_temp_dir()

fn create_temp_files(file_path: text, initialize: bool = true) -> (text, text):
    """
    Create temp files for stdout/stderr capture.

    Returns: (stdout_file, stderr_file)
    """
    val timestamp = time_now_unix_micros()
    _temp_file_sequence = _temp_file_sequence + 1
    val sequence = _temp_file_sequence
    val parent_id = getpid()

    # Replace path separators (chained replace breaks in runtime)
    var base = file_path
    var temp_chars: [text] = []
    var i = 0
    while i < base.len():
        val ch = base[i:i + 1]
        if ch == "/" or ch == "\\":
            temp_chars.push("_")
        elif ch == ".":
            temp_chars.push("_")
        elif ch == ":":
            temp_chars.push("_")
        else:
            temp_chars.push(ch)
        i = i + 1
    base = temp_chars.join("")

    val tmp_dir = _get_temp_dir()
    val sep = sosix_test_path_separator()
    val stdout_file = "{tmp_dir}{sep}simple_test_{parent_id}_{base}_{timestamp}_{sequence}_out.txt"
    val stderr_file = "{tmp_dir}{sep}simple_test_{parent_id}_{base}_{timestamp}_{sequence}_err.txt"

    # Initialize empty files
    if initialize:
        file_write(stdout_file, "")
        file_write(stderr_file, "")

    (stdout_file, stderr_file)

fn cleanup_temp_files(stdout_file: text, stderr_file: text):
    """Delete temp files after result collection"""
    if file_exists(stdout_file):
        file_delete(stdout_file)
    if file_exists(stderr_file):
        file_delete(stderr_file)

fn read_bounded_temp_output(path: text) -> Result<text, text>:
    val size = file_size(path)
    if size < 0:
        return Err("cannot determine captured-output size: {path}")
    if size <= TEST_OUTPUT_CAPTURE_BYTES:
        return file_read_text_at(path, 0, size)
    val head_size = (TEST_OUTPUT_CAPTURE_BYTES + 1) / 2
    val tail_size = TEST_OUTPUT_CAPTURE_BYTES - head_size
    val head = file_read_text_at(path, 0, head_size)?
    val tail = file_read_text_at(path, size - tail_size, tail_size)?
    Ok(head + "\n[output truncated: {size - TEST_OUTPUT_CAPTURE_BYTES} bytes omitted]\n" + tail)

fn _wait_poll_sleep_ms(poll_iteration: i64) -> i64:
    """Adaptive backoff for process polling."""
    if poll_iteration >= 50:
        return _WAIT_POLL_MAX_MS
    if poll_iteration >= 10:
        return _WAIT_POLL_MEDIUM_MS
    _WAIT_POLL_INITIAL_MS

# ============================================================================
# Async Test Spawning
# ============================================================================

fn spawn_async_test(file_path: text, options: TestOptions, inventory_index: i64 = -1) -> AsyncTestRun:
    """
    Spawn test as async process with stdout/stderr redirect.

    Args:
        file_path: Path to test file
        options: Test options

    Returns: AsyncTestRun tracking structure
    """
    val binary = find_simple_binary()
    var child_args = build_child_args(file_path, options)
    val timeout_ms = options.timeout * 1000

    # Create temp files for stdout/stderr
    val (stdout_file, stderr_file) = create_temp_files(file_path, initialize: not sosix_test_owned_capture())

    # Each interpreter child configures its own receipt through the CLI flag.
    # Mutating the parent's SIMPLE_TEST_RESULT_FILE races concurrent children.
    # The native `test` child has a separate evidence protocol; keep it intact.
    var evidence_file = ""
    var evidence_prepared = true
    if child_args.len() > 0 and child_args[0] == "run" and (options.assert_ran or (env_get("SIMPLE_TEST_ASSERT_RAN") ?? "") == "1"):
        evidence_file = stdout_file + ".bdd"
        # Refuse a collision instead of deleting another child's evidence.
        evidence_prepared = not file_exists(evidence_file) and not file_exists(evidence_file + ".expectations") and not file_exists(evidence_file + ".trace-events.sdnstream")
        child_args.push("--test-result-file={evidence_file}")

    var pid: i64 = -1
    if not evidence_prepared:
        file_write(stderr_file, "cannot prepare unique structured child evidence")
        # This run never acquired that receipt path; collection must not clean it.
        evidence_file = ""
    else:
        val (owned_capture, program, args) = sosix_test_spawn_plan(binary, child_args, stdout_file, stderr_file)
        if owned_capture:
            pid = spawn_tracked_redirected_process(program, args, stdout_file, stderr_file, timeout_ms)
            if pid == -1:
                file_write(stderr_file, "Windows owned redirected child admission failed")
        else:
            pid = spawn_tracked_process(program, args)

    val start_time = time_now_unix_micros()

    AsyncTestRun(
        pid: pid,
        file_path: file_path,
        start_time: start_time,
        stdout_file: stdout_file,
        stderr_file: stderr_file,
        timeout_ms: timeout_ms,
        inventory_index: inventory_index,
        evidence_file: evidence_file
    )

# ============================================================================
# Result Collection
# ============================================================================

fn collect_async_result(run: AsyncTestRun, observed_exit_code: i64, deadline_expired: bool = false) -> TestFileResult:
    var result = _collect_async_result_output(run, observed_exit_code, deadline_expired)
    var child_reaped = run.pid <= 0
    if sosix_test_has_owned_completion(run.pid):
        match sosix_test_process_completion(run.pid):
            case Ok(receipt):
                result.process_completion = Some(receipt)
                child_reaped = receipt.tree_reaped
            case Err(reason): pass
    elif run.pid > 0:
        child_reaped = not process_is_running(run.pid)
    # Preserve evidence while cleanup is unresolved. The structured parser owns
    # valid trace-sidecar cleanup and retains malformed trace diagnostics.
    if child_reaped:
        cleanup_temp_files(run.stdout_file, run.stderr_file)
        if run.evidence_file != "":
            cleanup_temp_files(run.evidence_file, run.evidence_file + ".expectations")
    result

fn _collect_async_result_output(run: AsyncTestRun, observed_exit_code: i64, deadline_expired: bool = false) -> TestFileResult:
    """
    Wait for async test to complete and collect results.

    Args:
        run: AsyncTestRun tracking structure

    Returns: TestFileResult
    """
    # Wait for process to complete (with timeout)
    var exit_code = observed_exit_code
    if run.pid > 0 and observed_exit_code == -2:
        val elapsed_ms = (time_now_unix_micros() - run.start_time) / 1000
        val remaining_ms = if elapsed_ms < run.timeout_ms: run.timeout_ms - elapsed_ms else: 1
        exit_code = wait_tracked_process(run.pid, remaining_ms)

    val end_time = time_now_unix_micros()
    val duration_ms = (end_time - run.start_time) / 1000

    # Read stdout/stderr from temp files
    var stdout = ""
    var stderr = ""
    var capture_error = ""

    if file_exists(run.stdout_file):
        match read_bounded_temp_output(run.stdout_file):
            case Ok(value): stdout = value
            case Err(message): capture_error = message

    if file_exists(run.stderr_file):
        match read_bounded_temp_output(run.stderr_file):
            case Ok(value): stderr = value
            case Err(message): capture_error = message
    if sosix_test_has_owned_completion(run.pid) and (not file_exists(run.stdout_file) or not file_exists(run.stderr_file)):
        capture_error = "owned Windows capture file missing"

    # Cleanup quarantine is authoritative even if a child exits zero and
    # presents green counts. Inspect the bounded raw captures before parsing.
    val cleanup_diagnostic = native_cleanup_diagnostic(stdout, stderr)
    if cleanup_diagnostic != "":
        return _parallel_admission_failure(run.file_path,
            "NATIVE-CACHE-CLEANUP-FAILED: " + cleanup_diagnostic, duration_ms)

    # A monitor-enforced deadline is authoritative.  Handle captures first
    # without trusting -1, which also represents a child crash/start failure.
    if deadline_expired:
        return TestFileResult(
            path: run.file_path,
            passed: 0,
            failed: 1,
            skipped: 0,
            pending: 0,
            duration_ms: duration_ms,
            setup_ms: 0,
            error: "TIMEOUT after {run.timeout_ms / 1000}s",
            timed_out: true,
            cached: false
        )

    if capture_error != "":
        return _parallel_admission_failure(run.file_path,
            "bounded child capture failure: " + capture_error + "\n" + stderr, duration_ms)
    if sosix_test_owned_capture() and (run.pid == -1 or (sosix_test_has_owned_completion(run.pid) and exit_code < 0)):
        val reason = if sosix_test_has_owned_completion(run.pid): sosix_test_process_failure_reason(run.pid) else: "child admission refused"
        return _parallel_admission_failure(run.file_path,
            "owned Windows child admission or collection failed: " + reason + "\n" + stderr, duration_ms)

    # Authenticate the per-child BDD receipt before considering human output.
    if run.evidence_file != "":
        # A non-empty path means spawning admitted `--test-result-file`; keep
        # the receipt mandatory even when the parent environment flag is absent.
        return make_result_from_structured_evidence(
            run.file_path, stdout, stderr, exit_code, duration_ms,
            run.timeout_ms / 1000, run.evidence_file, require_evidence: true)
    # Native-child and non-assert-ran compatibility paths retain their parser.
    make_result_from_output(
        run.file_path,
        stdout,
        stderr,
        exit_code,
        duration_ms,
        run.timeout_ms / 1000
    )

# ============================================================================
# Fork-based Test Execution (for parallel + fork mode)
# ============================================================================

fn spawn_fork_test(file_path: text, options: TestOptions) -> TestFileResult:
    """Run a single test via fork() instead of subprocess spawn.
    Returns the result directly (fork is synchronous from parent perspective).
    Used when fork_mode is enabled to eliminate 220ms CLI startup overhead."""
    run_test_file_fork(file_path, options)

# ============================================================================
# Parallel Execution with Timeout Check
# ============================================================================

fn _collect_scheduled_async_result_v1(schedule: TaskExecutionScheduleV1,
        run: AsyncTestRun, observed_exit_code: i64,
        deadline_expired: bool = false) -> ScheduledAsyncTestResultV1:
    var result = collect_async_result(run, observed_exit_code, deadline_expired)
    var next = schedule
    # A quarantined cleanup must not release a reservation or admit siblings.
    if result.error.starts_with("NATIVE-CACHE-CLEANUP-FAILED:"):
        return ScheduledAsyncTestResultV1(schedule: next, result: result)
    if run.pid <= 0:
        # No child was acquired. This is a reservation rollback, never a reap.
        next = task_execution_spawn_denied_v1(next, run.inventory_index)
        next = task_execution_block_v1(next, run.inventory_index)
    else:
        if sosix_test_has_owned_completion(run.pid):
            match result.process_completion:
                case Some(completion):
                    if not completion.tree_reaped:
                        next.error = "owned Windows child tree is not reaped"
                case nil:
                    next.error = "owned Windows child completion evidence is unavailable"
        elif process_is_running(run.pid):
            next.error = "owned child remains running after collection"
        if next.error == "":
            next = task_execution_reap_v1(next, run.inventory_index)
            next = task_execution_finish_v1(next, run.inventory_index,
                if result.is_ok(): "SUCCEEDED" else: "FAILED")
    if next.error != "":
        result = _parallel_admission_failure(run.file_path,
            "SHARED-SCHEDULER-FAILED: " + next.error, result.duration_ms)
    ScheduledAsyncTestResultV1(schedule: next, result: result)

fn run_tests_parallel_with_monitoring(
    files: [text],
    options: TestOptions,
    max_workers: i64
) -> [TestFileResult]:
    """
    Run tests in parallel with timeout monitoring and resource governor.

    Checks each active process for timeout and kills if exceeded.
    Uses resource governor to avoid exceeding system memory/CPU limits.

    Args:
        files: List of test file paths
        options: Test options
        max_workers: Maximum parallel workers

    Returns: List of TestFileResult
    """
    _ensure_runner_signal_handlers()
    if options.worker_memory_mb > 0 and not worker_memory_supported(sosix_test_host_os()):
        var unsupported_results: [TestFileResult] = []
        for file in files:
            unsupported_results.push(_parallel_admission_failure(file,
                "worker-memory RSS sampling unsupported on this host", 0))
        return unsupported_results
    var results: [TestFileResult?] = []
    var statuses: [text] = []
    var host_ids: [text] = []
    var eligible: [bool] = []
    for file in files:
        results.push(nil)
        statuses.push("PENDING")
        host_ids.push("")
        eligible.push(true)
    var schedule = task_execution_schedule_v1(statuses, host_ids)
    var active_runs: [AsyncTestRun] = []
    var poll_iteration = 0
    var admission_started = time_now_unix_micros()
    var admission_blocked = false
    var pending_closed = false
    var admission_reason = "NATIVE-CACHE-CLEANUP-FAILED: further admission blocked"
    var admission_duration_ms: i64 = 0
    val admission_timeout_ms = if options.timeout > 0: options.timeout * 1000 else: 60000

    # Fork mode is sequential — skip it when parallel is explicitly requested.
    # Subprocess parallelism with N workers is faster than sequential fork
    # even with the per-test startup overhead.

    if options.max_workers > 0:
        proc_slot_configure_requested_workers(max_workers)
    # Windows resource probes themselves need process admission. Do not enter
    # those synchronous probes while another owner holds every slot.
    while proc_slot_active() >= proc_slot_max():
        signal_dispatch_pending()
        if (time_now_unix_micros() - admission_started) / 1000 >= admission_timeout_ms:
            var denied: [TestFileResult] = []
            for file in files:
                denied.push(_parallel_admission_failure(file, "process admission deadline exceeded", admission_timeout_ms))
            return denied
        thread_sleep(_wait_poll_sleep_ms(poll_iteration))
        poll_iteration = poll_iteration + 1

    # Create resource governor (default 75%, overridable via options)
    var gov = governor_create(options.resource_limit_pct)
    if options.max_workers > 0:
        gov.max_cpu_cores = max_workers
        proc_slot_configure_requested_workers(max_workers)
    print "  [parallel] Resource governor: max {gov.max_cpu_cores} cores, {gov.max_memory_mb}MB memory ({gov.resource_limit_pct}% limit)"

    val worker_budget_kib = options.worker_memory_mb * 1024
    var memory_charged_kib = 0
    var memory_reserve_kib = if max_workers > 0: (worker_budget_kib + max_workers - 1) / max_workers else: worker_budget_kib
    var memory_next_sample = 0
    var memory_known = true
    if worker_budget_kib > 0:
        print "  [parallel] Aggregate worker admission: {options.worker_memory_mb} MiB (CPU budget unchanged)"

    while (not admission_blocked and schedule.next_pending < files.len()) or active_runs.len() > 0:
        signal_dispatch_pending()
        if schedule.error != "":
            admission_blocked = true
            admission_reason = "SHARED-SCHEDULER-FAILED: " + schedule.error
        # Refresh only when a dispatch slot exists. Never block collection on a
        # synchronous observer when the process owner has no spare slot.
        val memory_now = time_now_unix_micros()
        if not admission_blocked and worker_budget_kib > 0 and schedule.next_pending < files.len() and task_execution_host_active_v1(schedule, _TEST_EXECUTION_HOST_V1) < max_workers and proc_slot_active() < proc_slot_max() and memory_now >= memory_next_sample:
            var worker_roots: [i64] = []
            for run in active_runs: worker_roots.push(run.pid)
            val charges = sample_worker_memory(worker_roots, memory_reserve_kib)
            memory_known = charges.len() == worker_roots.len()
            memory_charged_kib = 0
            for charge in charges:
                memory_charged_kib = memory_charged_kib + charge
                if charge > memory_reserve_kib: memory_reserve_kib = charge
            if memory_reserve_kib > worker_budget_kib: memory_reserve_kib = worker_budget_kib
            if options.verbose:
                print "  [parallel] Worker RSS sample: roots={worker_roots.len()} known={memory_known} charged_kib={memory_charged_kib} reserve_kib={memory_reserve_kib}"
            memory_next_sample = time_now_unix_micros() + WORKER_MEMORY_SAMPLE_INTERVAL_US
        # Spawn new tests (respecting both max_workers and resource governor)
        while not admission_blocked and task_execution_host_active_v1(schedule, _TEST_EXECUTION_HOST_V1) < max_workers and schedule.next_pending < files.len():
            if proc_slot_active() >= proc_slot_max(): break
            # Check resource governor before spawning
            if not governor_can_spawn(gov, active_runs.len()):
                break

            if worker_budget_kib > 0 and (not memory_known or not worker_memory_can_spawn(worker_budget_kib, memory_charged_kib, memory_reserve_kib)):
                break
            val selected = task_execution_ready_v1(schedule, eligible, 1)
            if selected.error != "":
                admission_blocked = true
                admission_reason = "SHARED-SCHEDULER-FAILED: " + selected.error
                break
            if selected.indices.len() == 0: break
            val index = selected.indices[0]
            val file_path = files[index]
            schedule = task_execution_dispatch_v1(schedule, index,
                _TEST_EXECUTION_HOST_V1, max_workers)
            if schedule.error != "":
                admission_blocked = true
                admission_reason = "SHARED-SCHEDULER-FAILED: " + schedule.error
                results[index] = Some(_parallel_admission_failure(file_path, admission_reason, 0))
                break
            val run = spawn_async_test(file_path, options, index)
            if run.pid == -3:
                cleanup_temp_files(stdout_file: run.stdout_file, stderr_file: run.stderr_file)
                schedule = task_execution_spawn_denied_v1(schedule, index)
                if schedule.error != "":
                    admission_blocked = true
                    admission_reason = "SHARED-SCHEDULER-FAILED: " + schedule.error
                    results[index] = Some(_parallel_admission_failure(file_path, admission_reason, 0))
                break
            active_runs.push(run)
            memory_charged_kib = memory_charged_kib + memory_reserve_kib

        # Check for timeouts and completions
        var new_runs: [AsyncTestRun] = []
        val current_time = time_now_unix_micros()
        var had_completion = false

        for run in active_runs:
            # Poll first: a child that completed at the deadline is complete,
            # not a timeout.  Only still-pending work can expire.
            val exit_code = poll_tracked_process(run.pid)
            if exit_code != -2:
                val completed = _collect_scheduled_async_result_v1(schedule, run, exit_code)
                schedule = completed.schedule
                val result = completed.result
                if result.error.starts_with("NATIVE-CACHE-CLEANUP-FAILED:"):
                    admission_blocked = true
                results[run.inventory_index] = Some(result)
                had_completion = true
                continue

            val elapsed_ms = (current_time - run.start_time) / 1000
            if elapsed_ms > run.timeout_ms:
                val completed = _collect_scheduled_async_result_v1(schedule, run, -2, true)
                schedule = completed.schedule
                val result = completed.result
                if result.error.starts_with("NATIVE-CACHE-CLEANUP-FAILED:"):
                    admission_blocked = true
                results[run.inventory_index] = Some(result)
                had_completion = true
            else:
                new_runs.push(run)

        active_runs = new_runs
        if schedule.error != "":
            admission_blocked = true
            admission_reason = "SHARED-SCHEDULER-FAILED: " + schedule.error
        if active_runs.len() > 0 or had_completion:
            admission_started = current_time
        elif not admission_blocked and schedule.next_pending < files.len() and (current_time - admission_started) / 1000 >= admission_timeout_ms:
            # Admission has its own finite deadline even when another owner
            # holds every process slot and this pool has nothing to poll.
            admission_blocked = true
            admission_reason = "process or worker-memory admission deadline exceeded"
            admission_duration_ms = admission_timeout_ms
        if admission_blocked and not pending_closed:
            for index in schedule.next_pending..files.len():
                if schedule.statuses[index] == "PENDING":
                    results[index] = Some(_parallel_admission_failure(files[index],
                        admission_reason, admission_duration_ms))
                    if schedule.error == "":
                        schedule = task_execution_block_v1(schedule, index)
            pending_closed = true

        # Only sleep after a full pass with no completion.
        if had_completion:
            poll_iteration = 0
        else:
            thread_sleep(_wait_poll_sleep_ms(poll_iteration))
            poll_iteration = poll_iteration + 1

    var ordered: [TestFileResult] = []
    var result_index = 0
    for result in results:
        match result:
            case Some(value): ordered.push(value)
            case nil:
                ordered.push(_parallel_admission_failure(files[result_index], "owned child completion missing", 0))
        result_index = result_index + 1
    ordered

fn _parallel_admission_failure(file: text, reason: text, duration_ms: i64) -> TestFileResult:
    # Parent admission failure has no child exit status to scrape/classify.
    TestFileResult(path: file, passed: 0, failed: 1, skipped: 0, pending: 0,
        duration_ms: duration_ms, setup_ms: 0, error: reason, timed_out: false, cached: false)

# ============================================================================
# Helper: CPU Count Detection
# ============================================================================

fn get_cpu_count() -> i64:
    """
    Detect number of CPU cores on Linux, macOS, FreeBSD, and Windows.

    Returns: CPU count, or 4 if detection fails
    """
    val count = cpu_count()
    if count > 0: count else: 4

# ============================================================================
# Exports
# ============================================================================
