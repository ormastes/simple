# Test Database I/O
#
# Atomic read/write operations with backup creation for the test database.

use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_copy}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.common.path_pure.{path_dirname}
use std.test_runner.test_db_lock.TestDbFileLock

# =========================================================================
# Constants
# =========================================================================

val DB_PATH = "doc/08_tracking/test/test_db.sdn"
val RUNS_PATH = "doc/08_tracking/test/test_db_runs.sdn"
val LOCK_TIMEOUT = 10  # seconds
val MAX_FILE_SIZE = 500 * 1024 * 1024  # 500 MB

# =========================================================================
# Safe File Reading
# =========================================================================

fn read_db_file(path: text) -> Result<text, text>:
    if not file_exists(path):
        return Ok("")
    val content = file_read(path)
    if content.len() > MAX_FILE_SIZE:
        return Err("Database file {path} exceeds 500 MB limit")
    Ok(content)

# =========================================================================
# Atomic Write with Locking
# =========================================================================

# file_lock cannot create its lock file inside a missing directory, so a cold
# start (fresh checkout, no doc/08_tracking/test yet) failed before writing.
fn ensure_db_parent_dir(path: text):
    val parent = path_dirname(path)
    if parent != "" and parent != ".":
        dir_create_all(parent)

fn write_db_file_locked(path: text, content: text) -> Result<(), text>:
    ensure_db_parent_dir(path)
    # Acquire lock. `acquire` yields `TestDbFileLock?`, never a Result, so it
    # is tested for nil; matching it against Ok/Err arms aborted every call
    # with "match expression exhausted". The binding is explicitly typed so
    # the bare `release` call below resolves to TestDbFileLock.release rather
    # than sitting on the ambiguous-method codegen path.
    val acquired = TestDbFileLock.acquire(path, LOCK_TIMEOUT)
    if acquired == nil:
        return Err("Failed to acquire lock for {path} within {LOCK_TIMEOUT}s")
    var lock: TestDbFileLock = acquired

    # Guard against overwriting non-empty with empty
    if content.trim() == "" and file_exists(path):
        val existing = file_read(path)
        if existing.trim() != "":
            lock.release()
            return Err("Refusing to overwrite non-empty {path} with empty content")

    # Create backup if file exists
    if file_exists(path):
        val backup_path = "{path}.bak"
        file_copy(path, backup_path)

    # Atomic write
    val success = file_atomic_write(path, content)
    lock.release()

    if success:
        Ok(())
    else:
        Err("Failed to write {path}")

# =========================================================================
# Locked Read-Modify-Write
# =========================================================================

fn update_db_file(path: text, updater: fn(text) -> text) -> Result<(), text>:
    ensure_db_parent_dir(path)
    # Same Option contract as write_db_file_locked above.
    val acquired = TestDbFileLock.acquire(path, LOCK_TIMEOUT)
    if acquired == nil:
        return Err("Failed to acquire lock for {path} within {LOCK_TIMEOUT}s")
    var lock: TestDbFileLock = acquired

    var content = ""
    if file_exists(path):
        content = file_read(path)

    val new_content = updater(content)

    # Backup before write
    if file_exists(path):
        file_copy(path, "{path}.bak")

    val success = file_atomic_write(path, new_content)
    lock.release()

    if success:
        Ok(())
    else:
        Err("Failed to write {path}")

export DB_PATH, RUNS_PATH, LOCK_TIMEOUT, MAX_FILE_SIZE
export read_db_file, write_db_file_locked, update_db_file
