# Doctest Runner
#
# Extracts doc comments with code blocks from Simple source files
# and Markdown files, then runs them as test cases.

use std.io.{file_read, file_exists}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write, file_remove}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.io_runtime.{dir_walk}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.test_runner.test_runner_types.{TestFileResult, TEST_OUTPUT_CAPTURE_BYTES}
# PERF (2026-08-17): import find_simple_binary from its DEFINING module
# (test_executor_parsing), not via test_runner_execute. The execute module
# pulls test_executor_composite -> gpu_lane executors -> the whole compiler
# backend (~300 modules, ~40s of seed-interpreter load) into every test-runner
# process that only needed this one path helper. Same function either way —
# test_runner_execute merely re-imports it from test_executor_parsing.
use std.test_runner.test_executor_parsing.{find_simple_binary}
use std.test_runner.test_runner_files.{strip_ansi}
use std.test_runner.sdoctest.types.{SdoctestFileResult, SdoctestRunResult, SdoctestBlock, BlockResult, BlockStatus}
use std.io.{env_get}

fn _dt_get_temp_dir() -> text:
    val tmpdir = env_get("TMPDIR")
    if tmpdir != "" and tmpdir != nil:
        return tmpdir
    val tmp = env_get("TMP")
    if tmp != "" and tmp != nil:
        return tmp
    val temp = env_get("TEMP")
    if temp != "" and temp != nil:
        return temp
    val os_env = env_get("OS")
    if os_env != "" and os_env != nil:
        if os_env.lower().contains("windows"):
            return "C:/Windows/Temp"
    "/tmp"

# =========================================================================
# Doctest Extraction
# =========================================================================

struct Doctest:
    source_file: text
    line_number: i64
    code: text
    expected_output: text
    should_fail: bool

fn extract_doctests(file_path: text) -> [Doctest]:
    if not file_exists(file_path):
        return []

    val content = file_read(file_path)
    val lines = content.split("\n")
    var doctests: [Doctest] = []
    var i = 0
    var in_code_block = false
    var in_docstring = false
    var in_sdoctest = false
    var sdoctest_indent = 0
    var doc_fence_indent = 0
    var code_lines: [text] = []
    var start_line = 0
    var should_fail = false

    while i < lines.len():
        val line = lines[i]
        val trimmed = line.trim()

        if trimmed.contains("\"\"\""):
            val quote_at = trimmed.index_of("\"\"\"")
            val quote_tail = trimmed[quote_at + 3:]
            if quote_tail.contains("\"\"\""):
                i = i + 1
                continue
            if in_sdoctest and code_lines.len() > 0:
                doctests.push(Doctest(
                    source_file: file_path,
                    line_number: start_line,
                    code: code_lines.join("\n"),
                    expected_output: "",
                    should_fail: false
                ))
            in_docstring = not in_docstring
            in_sdoctest = false
            in_code_block = false
            code_lines = []
            i = i + 1
            continue

        if in_docstring:
            val trimmed_line = line.trim_start()
            val indent = line.len() - trimmed_line.len()
            if in_code_block:
                if trimmed == "```":
                    in_code_block = false
                    if code_lines.len() > 0:
                        doctests.push(Doctest(
                            source_file: file_path,
                            line_number: start_line,
                            code: code_lines.join("\n"),
                            expected_output: "",
                            should_fail: should_fail
                        ))
                    code_lines = []
                else:
                    var code_start = doc_fence_indent
                    if code_start > line.len():
                        code_start = indent
                    code_lines.push(line[code_start:])
            elif trimmed.starts_with("```simple") or trimmed.starts_with("```spl") or trimmed.starts_with("```sdoctest"):
                in_code_block = true
                doc_fence_indent = indent
                start_line = i + 1
                should_fail = trimmed.contains("should_fail")
                code_lines = []
            elif trimmed == "sdoctest:":
                in_sdoctest = true
                sdoctest_indent = indent
                start_line = i + 2
                code_lines = []
            elif in_sdoctest and trimmed != "" and indent > sdoctest_indent:
                var code_start = sdoctest_indent + 4
                if code_start > line.len():
                    code_start = indent
                code_lines.push(line[code_start:])
            elif in_sdoctest and trimmed != "":
                if code_lines.len() > 0:
                    doctests.push(Doctest(
                        source_file: file_path,
                        line_number: start_line,
                        code: code_lines.join("\n"),
                        expected_output: "",
                        should_fail: false
                    ))
                in_sdoctest = false
                code_lines = []
            i = i + 1
            continue

        # Detect doc comments
        if trimmed.starts_with("///") or trimmed.starts_with("#"):
            val doc_marker_len = if trimmed.starts_with("///"):
                3
            elif trimmed.starts_with("##"):
                2
            else:
                1
            # Fence/marker detection wants the trimmed text, but the BODY must
            # keep its indentation: `.trim()`ing it flattened every indented
            # line inside a `#` doctest (lambda bodies, if/for/while blocks,
            # nested calls), so the harness compiled mangled code and reported
            # a parse error the documented example never had. Strip the marker
            # and at most ONE following space, matching sdoctest/extractor.spl.
            val doc_body = _dt_strip_doc_marker(trimmed, doc_marker_len)
            val doc_content = doc_body.trim()

            if doc_content.starts_with("```simple") or doc_content.starts_with("```spl") or doc_content.starts_with("```sdoctest"):
                in_code_block = true
                code_lines = []
                start_line = i + 1
                should_fail = doc_content.contains("should_fail")
            elif doc_content == "```" and in_code_block:
                in_code_block = false
                if code_lines.len() > 0:
                    doctests.push(Doctest(
                        source_file: file_path,
                        line_number: start_line,
                        code: code_lines.join("\n"),
                        expected_output: "",
                        should_fail: should_fail
                    ))
            elif in_code_block:
                code_lines.push(doc_body)

        else:
            if in_code_block:
                in_code_block = false
                code_lines = []

        i = i + 1

    doctests

# =========================================================================
# H11: Markdown Doctest Extraction
# =========================================================================

fn extract_md_doctests(file_path: text) -> [Doctest]:
    if not file_exists(file_path):
        return []

    val content = file_read(file_path)
    val lines = content.split("\n")
    var doctests: [Doctest] = []
    var i = 0
    var in_code_block = false
    var code_lines: [text] = []
    var start_line = 0
    var should_fail = false

    while i < lines.len():
        val trimmed = lines[i].trim()

        if not in_code_block:
            if trimmed.starts_with("```simple") or trimmed.starts_with("```spl"):
                in_code_block = true
                code_lines = []
                start_line = i + 1
                should_fail = trimmed.contains("should_fail")
        else:
            if trimmed == "```":
                in_code_block = false
                if code_lines.len() > 0:
                    doctests.push(Doctest(
                        source_file: file_path,
                        line_number: start_line,
                        code: code_lines.join("\n"),
                        expected_output: "",
                        should_fail: should_fail
                    ))
            else:
                code_lines.push(lines[i])

        i = i + 1

    doctests

fn discover_md_doctests(dir: text) -> [Doctest]:
    var all_doctests: [Doctest] = []
    val files = dir_walk(dir)
    for file_path in files:
        if file_path.ends_with(".md"):
            val doctests = extract_md_doctests(file_path)
            all_doctests.merge(doctests)
    all_doctests

# =========================================================================
# Run Doctests
# =========================================================================

fn run_doctests(file_path: text, timeout_ms: i64) -> TestFileResult:
    val doctests = extract_doctests(file_path)

    if doctests.len() == 0:
        return TestFileResult(
            path: file_path,
            passed: 0,
            failed: 0,
            skipped: 0,
            pending: 0,
            duration_ms: 0,
            setup_ms: 0,
            error: "",
            timed_out: false,
            cached: false
        )

    val binary = find_simple_binary()
    var passed = 0
    var failed = 0
    var total_duration = 0

    for dt in doctests:
        # Write temp file
        val temp_path = "{_dt_get_temp_dir()}/simple_doctest_{dt.line_number}.spl"
        file_atomic_write(temp_path, dt.code)

        val result = process_run_bounded(binary, [temp_path], timeout_ms, TEST_OUTPUT_CAPTURE_BYTES)
        val exit_code = result.2

        if exit_code == -1:
            failed = failed + 1
        elif dt.should_fail:
            if exit_code != 0:
                passed = passed + 1
            else:
                failed = failed + 1
        else:
            if exit_code == 0:
                passed = passed + 1
            else:
                failed = failed + 1

        file_remove(temp_path)

    TestFileResult(
        path: file_path,
        passed: passed,
        failed: failed,
        skipped: 0,
        pending: 0,
        duration_ms: total_duration,
        setup_ms: 0,
        error: "",
        timed_out: false,
            cached: false
    )

fn run_md_doctests(file_path: text, timeout_ms: i64) -> TestFileResult:
    val doctests = extract_md_doctests(file_path)

    if doctests.len() == 0:
        return TestFileResult(
            path: file_path,
            passed: 0,
            failed: 0,
            skipped: 0,
            pending: 0,
            duration_ms: 0,
            setup_ms: 0,
            error: "",
            timed_out: false,
            cached: false
        )

    val binary = find_simple_binary()
    var passed = 0
    var failed = 0

    for dt in doctests:
        val temp_path = "{_dt_get_temp_dir()}/simple_md_doctest_{dt.line_number}.spl"
        file_atomic_write(temp_path, dt.code)

        val result = process_run_bounded(binary, [temp_path], timeout_ms, TEST_OUTPUT_CAPTURE_BYTES)
        val exit_code = result.2

        if exit_code == -1:
            failed = failed + 1
        elif dt.should_fail:
            if exit_code != 0:
                passed = passed + 1
            else:
                failed = failed + 1
        else:
            if exit_code == 0:
                passed = passed + 1
            else:
                failed = failed + 1

        file_remove(temp_path)

    TestFileResult(
        path: file_path,
        passed: passed,
        failed: failed,
        skipped: 0,
        pending: 0,
        duration_ms: 0,
        setup_ms: 0,
        error: "",
        timed_out: false,
            cached: false
    )

# =========================================================================
# SPL Same-File Doctest Support
# =========================================================================

# Pick the first stderr line that actually says why a doctest block failed.
#
# The seed binary unconditionally prints a two-line "bootstrap seed only"
# banner on stderr, and the compiler emits `warning:` / `[WARN]` /
# `[gc-warning]` / `[INFO]` diagnostics ahead of any real error. Naively
# reporting stderr line 1 therefore labelled EVERY non-zero-exit block with
# the banner: in the 2026-08-24 whole-suite baseline, 216 of 226 reported
# failure reasons were that banner, so the run's 215 doctest failures had no
# usable diagnosis at all. This does not change any verdict — only the text
# shown for an already-failing block.
fn _dt_failure_reason(stderr: text) -> text:
    var fallback = ""
    for raw in stderr.split("\n"):
        # The seed colourises `warning:` with ANSI codes, so the marker is not
        # at the start of the raw line; classify on the stripped text.
        val line = strip_ansi(raw).trim()
        if line == "":
            continue
        if fallback == "":
            fallback = line
        if line.starts_with("WARNING: this Rust-built Simple binary"):
            continue
        if line.starts_with("Build and use the pure-Simple"):
            continue
        if line.starts_with("warning:") or line.starts_with("[WARN]"):
            continue
        if line.starts_with("[gc-warning]") or line.starts_with("[INFO]"):
            continue
        if line.starts_with("[use-warning]"):
            continue
        return line
    if fallback != "":
        return fallback
    "Exit code non-zero"

fn _dt_strip_doc_marker(trimmed: text, marker_len: i64) -> text:
    var r = trimmed[marker_len:]
    if r.starts_with(" "):
        r = r[1:]
    r

fn build_spl_doctest_code(source_content: text, dt: Doctest) -> text:
    source_content + "\n\n# --- doctest from line {dt.line_number} ---\nuse std.spec.*\n" + dt.code

fn run_spl_doctests_same_file(file_path: text, timeout_ms: i64) -> SdoctestFileResult:
    if not file_exists(file_path):
        return SdoctestFileResult(
            source_file: file_path,
            blocks: [],
            total: 0, passed: 0, failed: 0, skipped: 0, errors: 0, accepted: 0, duration_ms: 0
        )

    val source_content = file_read(file_path) ?? ""
    if source_content == "":
        return SdoctestFileResult(
            source_file: file_path,
            blocks: [],
            total: 0, passed: 0, failed: 0, skipped: 0, errors: 0, accepted: 0, duration_ms: 0
        )

    val doctests = extract_doctests(file_path)
    if doctests.len() == 0:
        return SdoctestFileResult(
            source_file: file_path,
            blocks: [],
            total: 0, passed: 0, failed: 0, skipped: 0, errors: 0, accepted: 0, duration_ms: 0
        )

    val binary = find_simple_binary()
    var block_results: [BlockResult] = []
    var passed = 0
    var failed = 0
    var errors = 0
    var total_duration = 0

    for dt in doctests:
        # Build composite file: source + doctest code
        val composite_code = build_spl_doctest_code(source_content, dt)
        val temp_path = "{_dt_get_temp_dir()}/spl_doctest_{dt.line_number}.spl"
        file_atomic_write(temp_path, composite_code)

        val start = time_now_unix_micros()
        val result = process_run_bounded(binary, [temp_path], timeout_ms, TEST_OUTPUT_CAPTURE_BYTES)
        val stdout = result.0
        val stderr = result.1
        val exit_code = result.2
        val end = time_now_unix_micros()
        val duration_ms = (end - start) / 1000

        val block = SdoctestBlock(
            source_file: file_path,
            line_number: dt.line_number,
            code: dt.code,
            language: "spl",
            modifiers: []
        )

        if exit_code == -1:
            errors = errors + 1
            val process_error = if stderr.contains("TIMEOUT") or stderr.contains("timed out"):
                "TIMEOUT"
            elif stderr != "":
                stderr
            else:
                "Process failed to start or returned an internal error"
            block_results.push(BlockResult(
                block: block, status: BlockStatus.Error,
                duration_ms: duration_ms, stdout: stdout, stderr: stderr,
                error: process_error
            ))
        elif dt.should_fail:
            if exit_code != 0:
                passed = passed + 1
                block_results.push(BlockResult(
                    block: block, status: BlockStatus.Passed,
                    duration_ms: duration_ms, stdout: stdout, stderr: stderr, error: ""
                ))
            else:
                failed = failed + 1
                block_results.push(BlockResult(
                    block: block, status: BlockStatus.Failed,
                    duration_ms: duration_ms, stdout: stdout, stderr: stderr,
                    error: "Expected failure but block succeeded"
                ))
        else:
            if exit_code == 0:
                passed = passed + 1
                block_results.push(BlockResult(
                    block: block, status: BlockStatus.Passed,
                    duration_ms: duration_ms, stdout: stdout, stderr: stderr, error: ""
                ))
            else:
                failed = failed + 1
                val error_msg = _dt_failure_reason(stderr)
                block_results.push(BlockResult(
                    block: block, status: BlockStatus.Failed,
                    duration_ms: duration_ms, stdout: stdout, stderr: stderr,
                    error: error_msg
                ))

        total_duration = total_duration + duration_ms
        file_remove(temp_path)

    SdoctestFileResult(
        source_file: file_path,
        blocks: block_results,
        total: doctests.len(),
        passed: passed,
        failed: failed,
        skipped: 0,
        errors: errors,
        accepted: 0,
        duration_ms: total_duration
    )

fn discover_spl_doctest_files(dirs: [text]) -> [text]:
    var result: [text] = []
    for dir in dirs:
        val files = dir_walk(dir)
        for file_path in files:
            if not file_path.ends_with(".spl"):
                continue
            # Skip spec and test files
            if file_path.ends_with("_spec.spl") or file_path.ends_with("_test.spl"):
                continue
            # Fast pre-check for supported source-comment and docstring forms.
            val content = file_read(file_path) ?? ""
            if content == "":
                continue
            if not content.contains("```simple") and not content.contains("```spl") and not content.contains("```sdoctest") and not content.contains("sdoctest:"):
                continue
            # Check for @doctest_skip marker
            if content.contains("# @doctest_skip"):
                continue
            # Verify file has actual code blocks in doc comments
            val doctests = extract_doctests(file_path)
            if doctests.len() > 0:
                result.push(file_path)
    result
