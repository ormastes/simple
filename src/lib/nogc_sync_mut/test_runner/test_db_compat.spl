# Test Database Compatibility Layer
#
# Wraps unified lib.database.test_extended with custom test_db_core API
# for backward compatibility during migration.
#
# This allows test runner to use unified library without changing all call sites.
# Once migration is complete, call sites can be updated to use unified API directly.

use std.database.test_extended.{
    TestDatabaseExtended,
    load_test_database_extended,
    load_with_migration,
    RunRecord,
    TestInfo,
    TimingSummary
}
use std.test_runner.test_db_types.{TestStatus, status_to_str}
use std.common.perf.execution_metrics.{ResourceUsage, resource_evidence_quality_name, termination_cause_name}
use std.test_runner.test_db_core.{parse_rfc3339_to_micros}
use std.nogc_sync_mut.test_runner.test_db_record.{TestDbFileRow}
use std.common.traceability.case_events.{decode_trace_case_events}
use std.common.traceability.run_plan.{TraceRunPlan}
use std.common.traceability.run_request.{TraceRunRequest, validate_trace_run_request, materialize_trace_run_plan}
use std.common.traceability.run_request_codec.{encode_trace_run_request}
use std.common.traceability.sspec_inventory.{TraceSspecPlannedRequest}
use std.common.traceability.sspec_inventory_codec.{encode_trace_sspec_planned_request}
use std.nogc_sync_mut.io.time_ops.{timestamp_year, timestamp_month, timestamp_day, timestamp_hour, timestamp_minute, timestamp_second}

# ============================================================================
# Compatibility Wrapper
# ============================================================================

class RunnerTestDb:
    db: TestDatabaseExtended
    current_run_id: text
    _trace_prepare_failed: bool = false
    _trace_prepared_run_id: text = ""

    # Save the plan and its full definition metadata in one owner generation.
    # This is still unverified intent; the caller must bind execution inputs.
    me prepare_trace_sspec_request(metadata: TraceSspecPlannedRequest) -> Result<TraceRunPlan, text>:
        if self._trace_prepare_failed or self.current_run_id != "":
            return Err("trace SSpec request requires a fresh database owner")
        encode_trace_sspec_planned_request(metadata)?
        val run_id = self.start_run()
        val plan = match materialize_trace_run_plan(metadata.request, run_id):
            case Ok(value): value
            case Err(reason):
                self._trace_prepare_failed = true
                return Err(reason)
        match self.db.record_trace_run_plan(plan):
            case Err(reason):
                self._trace_prepare_failed = true
                return Err(reason)
            case Ok(_): pass
        match self.db.record_trace_sspec_metadata(run_id, metadata):
            case Err(reason):
                self._trace_prepare_failed = true
                return Err(reason)
            case Ok(_): pass
        match self.save():
            case Err(reason):
                self._trace_prepare_failed = true
                Err("trace SSpec intent was not durably prepared: " + reason)
            case Ok(_):
                self._trace_prepared_run_id = run_id
                Ok(plan)

    # A metadata-aware child must use this entry rather than accepting a
    # legacy plan-only run. Fresh load validates the stored envelope and plan.
    static fn resume_trace_sspec_run(run_id: text) -> Result<RunnerTestDb, text>:
        var owner = RunnerTestDb.resume_trace_run(run_id)?
        match owner.db.get_trace_sspec_metadata(run_id)?:
            case Some(_): Ok(owner)
            case nil: Err("persisted trace SSpec metadata is missing")

    # The owner allocates the run identity; callers supply only frozen intent.
    # A returned plan means save succeeded, not that evidence is qualified.
    me prepare_trace_request(request: TraceRunRequest) -> Result<TraceRunPlan, text>:
        if self._trace_prepare_failed or self.current_run_id != "":
            return Err("trace request requires a fresh database owner")
        validate_trace_run_request(request)?
        # Enforce transport bounds before allocating any mutable run state.
        encode_trace_run_request(request)?
        val run_id = self.start_run()
        match materialize_trace_run_plan(request, run_id):
            case Err(reason):
                self._trace_prepare_failed = true
                Err(reason)
            case Ok(plan):
                match self.prepare_trace_run(plan):
                    case Ok(_): Ok(plan)
                    case Err(reason):
                        self._trace_prepare_failed = true
                        Err(reason)

    # Persist immutable execution intent before dispatch. A failed save poisons
    # this wrapper: callers must discard it and reload the persisted owner.
    # Preparation does not admit evidence or establish a concurrent run lease.
    me prepare_trace_run(plan: TraceRunPlan) -> Result<(), text>:
        if self._trace_prepare_failed:
            return Err("trace preparation previously failed; reload the database owner")
        if self.current_run_id == "" or plan.run_id != self.current_run_id:
            return Err("trace plan must belong to this database owner's active run")
        if self._trace_prepared_run_id != "":
            return Err("trace run intent is already prepared")
        self.db.record_trace_run_plan(plan)?
        match self.save():
            case Ok(_):
                self._trace_prepared_run_id = plan.run_id
                Ok(())
            case Err(reason):
                self._trace_prepare_failed = true
                Err("trace intent was not durably prepared: " + reason)

    fn trace_run_is_prepared(run_id: text) -> bool:
        if self._trace_prepare_failed or run_id == "" or self.current_run_id != run_id or self._trace_prepared_run_id != run_id:
            return false
        match self.db.validate_trace_run_active(run_id):
            case Ok(_): true
            case Err(_): false

    # Resume attaches only freshly loaded persisted intent. It cannot attach
    # unsaved in-memory rows and does not grant a concurrent writer lease.
    static fn resume_trace_run(run_id: text) -> Result<RunnerTestDb, text>:
        var owner = RunnerTestDb.load()?
        owner.db.validate_trace_run_active(run_id)?
        match owner.db.get_trace_run_plan(run_id)? :
            case Some(_):
                owner.current_run_id = run_id
                owner._trace_prepared_run_id = run_id
                Ok(owner)
            case nil:
                Err("persisted trace run intent is missing")

    # Load from default path with auto-migration
    static fn load() -> Result<RunnerTestDb, text>:
        val base = "doc/08_tracking/test/test_db"
        val db_opt = load_with_migration(path: base)
        match db_opt:
            Some(db):
                Ok(RunnerTestDb(
                    db: db,
                    current_run_id: ""
                ))
            nil:
                # Cold start is handled inside load_with_migration, so reaching
                # here means an existing file failed to parse or migrate.
                Err("could not open or parse {base}.sdn (existing file is unreadable or migration from {base}_stable.sdn failed)")

    # Save database
    fn save() -> Result<(), text>:
        if self._trace_prepare_failed:
            return Err("trace preparation failed; discard and reload this database owner")
        val success = self.db.save()
        if success:
            Ok(())
        else:
            Err("Failed to save database")

    # Framework observations are persisted by the same database writer as
    # summary rows. Their presence never establishes admitted provenance.
    me record_trace_case_events(run_id: text, test_file: text, events_sdn: text) -> Result<(), text>:
        if self._trace_prepare_failed:
            return Err("trace preparation failed; observations require a reloaded owner")
        if run_id == "" or run_id != self.current_run_id or test_file == "":
            return Err("trace events must belong to this database owner's active run")
        val events = decode_trace_case_events(events_sdn)?
        if events.len() == 0:
            return Err("trace events cannot be an empty execution claim")
        self.db.record_trace_case_events(run_id, test_file, events)

    # Update test result (custom API)
    me update_test_result(
        test_name: text,
        test_file: text,
        suite_name: text,
        category: text,            # Ignored in unified implementation (derived from path)
        status: TestStatus,
        duration_ms: f64,
        cohort_id: text = ""
    ):
        # Convert TestStatus enum to string
        val status_str = status_to_str(status)

        # Call unified API
        # Note: unified API uses file_path as base for hierarchy
        # custom API has separate test_name and test_file
        # For compatibility, use test_name as the actual test name
        self.db.update_test_result(
            file_path: test_file,
            suite_name: suite_name,
            test_name: test_name,
            status: status_str,
            duration_ms: duration_ms,
            run_id: self.current_run_id,
            cohort_id: cohort_id
        )

    # Start run tracking
    me start_run() -> text:
        if self._trace_prepare_failed or self._trace_prepared_run_id != "":
            return ""
        val run_id = self.db.start_run()
        self.current_run_id = run_id
        run_id

    # Complete run
    me complete_run(run_id: text, test_count: i64, passed: i64, failed: i64, timed_out: i64):
        self.db.complete_run(run_id: run_id, test_count: test_count, passed: passed, failed: failed, timed_out: timed_out)

    me record_resource_run(
        run_id: text,
        test_path: text,
        resource_class: text,
        cohort_id: text,
        compile_ms: i64,
        execution_ms: i64,
        usage: ResourceUsage,
        budget_status: text,
        anomaly_status: text
    ):
        self.db.record_resource_run(
            run_id, test_path, resource_class, cohort_id, compile_ms, execution_ms,
            usage.wall_ms, usage.user_cpu_ms, usage.system_cpu_ms,
            usage.peak_tree_charge_bytes, usage.peak_direct_child_rss_bytes,
            usage.io_read_bytes, usage.io_write_bytes, usage.pids_peak,
            resource_evidence_quality_name(usage.evidence_quality),
            termination_cause_name(usage.termination), usage.signal,
            usage.exit_code, budget_status, anomaly_status
        )

    # Same row as record_resource_run, from a flattened TestDbFileRow
    # (std.nogc_sync_mut.test_runner.test_db_record) whose enum fields are
    # already rendered to their canonical names.
    me record_resource_row(run_id: text, row: TestDbFileRow):
        self.db.record_resource_run(
            run_id, row.path, row.resource_class, row.cohort_id, row.compile_ms, row.execution_ms,
            row.wall_ms, row.user_cpu_ms, row.system_cpu_ms,
            row.peak_tree_charge_bytes, row.peak_direct_child_rss_bytes,
            row.io_read_bytes, row.io_write_bytes, row.pids_peak,
            row.evidence_quality, row.termination, row.signal,
            row.exit_code, row.budget_status, row.anomaly_status
        )

    # Cleanup stale runs
    me cleanup_stale_runs(max_age_hours: i64):
        val _deleted = self.db.cleanup_stale_runs(max_age_hours)
        # Custom API returns void, unified returns count - discard result
        ()

    # Prune old runs
    me prune_runs(keep_count: i64):
        val _deleted = self.db.prune_runs(keep_count)
        # Custom API returns void, unified returns count - discard result
        ()

    # List test runs
    fn list_runs(status_filter: text) -> [RunRecord]:
        self.db.list_runs(status_filter)

    # ========================================================================
    # Documentation Query Methods
    # ========================================================================

    # Get all test information
    fn all_test_info() -> [TestInfo]:
        self.db.all_test_info()

    fn timing_summary_for_test(test_path: text) -> TimingSummary?:
        match self.db.get_test_id(test_path, "spec", test_path):
            case Some(test_id): self.db.get_timing_summary(test_id)
            case nil: nil

    me promote_timing_baseline(test_path: text, cohort_id: text) -> bool:
        match self.db.get_test_id(test_path, "spec", test_path):
            case Some(test_id): self.db.promote_timing_baseline(test_id, cohort_id)
            case nil: false

    fn prior_anomaly_warning(test_path: text, cohort_id: text) -> bool:
        self.db.prior_anomaly_warning(test_path, cohort_id)

    me record_timing_observation(test_path: text, cohort_id: text, duration_ms: f64) -> bool:
        val test_id = match self.db.get_test_id(test_path, "spec", test_path):
            case Some(value): value
            case nil: return false
        val run_id = self.start_run()
        self.db.add_timing_run(test_id, duration_ms, run_id, cohort_id)
        self.db.update_timing(test_id, duration_ms)
        self.complete_run(run_id, 0, 0, 0, 0)
        true

    # Get tests by status
    fn tests_by_status(status: text) -> [TestInfo]:
        self.db.tests_by_status(status)

    # Get test counts (total, passed, failed, skipped)
    fn test_count_by_status() -> (i64, i64, i64, i64):
        self.db.test_count_by_status()

    # Get flaky test names
    fn flaky_test_names() -> [text]:
        self.db.flaky_test_names()

# ============================================================================
# Helper Functions
# ============================================================================

fn micros_to_rfc3339(micros: i64) -> text:
    val year = timestamp_year(micros)
    val month = timestamp_month(micros)
    val day = timestamp_day(micros)
    val hours = timestamp_hour(micros)
    val minutes = timestamp_minute(micros)
    val seconds = timestamp_second(micros)

    # Format as RFC3339 (pad with zeros)
    val year_str = pad_zero(num: year, width: 4)
    val month_str = pad_zero(num: month, width: 2)
    val day_str = pad_zero(num: day, width: 2)
    val hour_str = pad_zero(num: hours, width: 2)
    val min_str = pad_zero(num: minutes, width: 2)
    val sec_str = pad_zero(num: seconds, width: 2)

    "{year_str}-{month_str}-{day_str}T{hour_str}:{min_str}:{sec_str}Z"

fn pad_zero(num: i64, width: i64) -> text:
    # Pad number with leading zeros to specified width
    val s = "{num}"
    var result = s
    var current_len = s.len()

    # Add leading zeros
    while current_len < width:
        result = "0" + result
        current_len = current_len + 1

    result

# ============================================================================
# Exports
# ============================================================================

fn load_test_db_compat() -> Result<RunnerTestDb, text>:
    RunnerTestDb.load()

export RunnerTestDb, load_test_db_compat
export use std.test_runner.test_db_core.{parse_rfc3339_to_micros}
