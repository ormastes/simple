# Trace-requested runner transport must not pass on absent, partial or cached
# observations. This validates transport presence only, not case qualification.
use std.test_runner.test_runner_types.{TestFileResult}

pub fn validate_requested_trace_transport(results: [TestFileResult]) -> Result<(), text>:
    if results.len() == 0:
        return Err("trace event mode produced no per-file observations")
    var missing: [text] = []
    for result in results:
        # Explicitly not-run outcomes do not need runtime framework events.
        if result.feature_gated != "":
            continue
        # Cached data describes an earlier execution and cannot satisfy this run.
        if result.cached:
            missing.push("{result.path} (cached result has no current-run transport)")
            continue
        val no_execution = result.passed == 0 and result.failed == 0 and result.pending == 0 and not result.timed_out
        if no_execution and (result.skipped > 0 or result.in_development > 0):
            continue
        if result.trace_case_events_sdn == "":
            missing.push(result.path)
    if missing.len() > 0:
        return Err("trace observations are missing for: " + missing.join(", "))
    Ok(())