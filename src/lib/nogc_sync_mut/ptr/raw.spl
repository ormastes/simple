"""
# Raw Pointer Runtime Backend

No-GC sync owner for low-level raw allocation, pointer access, and scalar bit
conversion helpers used by backend SFFI adapters.  The public helpers are
allocation-free, inline ABI wrappers: callers allocate staging storage once and
may read or write every element without creating per-element objects.

`primitive_api` is allowed on the first ordinary wrapper below the raw
declarations because addresses, byte offsets, scalar bit patterns, and
C-runtime sizes are the ABI itself.  Boxing them would change the foreign
boundary and add work to per-element staging loops.
"""

pub extern fn rt_alloc(size: i64) -> i64
pub extern fn rt_free(ptr: i64, size: i64)
pub extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
pub extern fn rt_ptr_read_u8(addr: i64, offset: i64) -> i64
pub extern fn rt_ptr_read_i32(addr: i64, offset: i64) -> i32
pub extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
pub extern fn rt_write_u32s_to_raw_checksum(addr: i64, values: [u32], count: i64) -> i64
pub extern fn rt_write_fill_u32s_to_raw_checksum(addr: i64, values: [u32], count: i64, expected: i64) -> i64
pub extern fn f32_from_bits(bits: u32) -> f32
pub extern fn spl_f64_to_bits(value: f64) -> i64
pub extern fn spl_bits_to_f64(bits: i64) -> f64

@allow(primitive_api)
@inline
pub fn raw_alloc(size: i64) -> i64:
    rt_alloc(size)

@inline
pub fn raw_release(ptr: i64):
    rt_free(ptr)

@inline
# @tag(ptr=address, _size=byte_count)
pub fn raw_free(ptr: i64, _size: i64):
    raw_release(ptr)

@inline
# @tag(addr=address, offset=byte_offset)
pub fn raw_read_i64(addr: i64, offset: i64) -> i64:
    rt_ptr_read_i64(addr, offset)

@inline
# @tag(addr=address, offset=byte_offset)
pub fn raw_read_u8(addr: i64, offset: i64) -> i64:
    rt_ptr_read_u8(addr, offset) & 0xFF

@inline
# @tag(addr=address, offset=byte_offset)
pub fn raw_read_i32(addr: i64, offset: i64) -> i32:
    rt_ptr_read_i32(addr, offset)

@inline
# @tag(addr=address, offset=byte_offset, value=stored_value)
pub fn raw_write_i64(addr: i64, offset: i64, value: i64):
    rt_ptr_write_i64(addr, offset, value)

@inline
pub fn raw_f64_to_bits(value: f64) -> i64:
    spl_f64_to_bits(value)

@inline
pub fn raw_bits_to_f64(bits: i64) -> f64:
    spl_bits_to_f64(bits)

@inline
# @tag(addr=address, count=element_count)
pub fn raw_write_u32s_checksum(addr: i64, values: [u32], count: i64) -> i64:
    rt_write_u32s_to_raw_checksum(addr, values, count)

@inline
# @tag(addr=address, count=element_count, expected=expected_checksum)
pub fn raw_write_fill_u32s_checksum(addr: i64, values: [u32], count: i64, expected: u32) -> i64:
    rt_write_fill_u32s_to_raw_checksum(addr, values, count, expected.to_i64())

export rt_alloc, rt_free, rt_ptr_read_i64, rt_ptr_read_u8, rt_ptr_read_i32, rt_ptr_write_i64
export rt_write_u32s_to_raw_checksum, f32_from_bits, spl_f64_to_bits, spl_bits_to_f64
export rt_write_fill_u32s_to_raw_checksum
export raw_alloc, raw_release, raw_free, raw_read_i64, raw_read_u8, raw_read_i32, raw_write_i64
export raw_f64_to_bits, raw_bits_to_f64, raw_write_u32s_checksum
export raw_write_fill_u32s_checksum
