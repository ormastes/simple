"""
# Raw Pointer Runtime Backend

No-GC sync owner for low-level raw allocation, pointer access, and scalar bit
conversion helpers used by backend SFFI adapters.
"""

pub extern fn rt_alloc(size: i64) -> i64
pub extern fn rt_free(ptr: i64)
pub extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
pub extern fn rt_ptr_read_i32(addr: i64, offset: i64) -> i32
pub extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
pub extern fn rt_write_u32s_to_raw_checksum(addr: i64, values: [u32], count: i64) -> i64
pub extern fn rt_write_fill_u32s_to_raw_checksum(addr: i64, values: [u32], count: i64, expected: i64) -> i64
pub extern fn f32_from_bits(bits: u32) -> f32
pub extern fn spl_f64_to_bits(value: f64) -> i64
pub extern fn spl_bits_to_f64(bits: i64) -> f64

pub fn raw_alloc(size: i64) -> i64:
    rt_alloc(size)

pub fn raw_free(ptr: i64, size: i64):
    rt_free(ptr)

pub fn raw_read_i32(addr: i64, offset: i64) -> i32:
    rt_ptr_read_i32(addr, offset)

pub fn raw_write_i64(addr: i64, offset: i64, value: i64):
    rt_ptr_write_i64(addr, offset, value)

pub fn raw_write_u32s_checksum(addr: i64, values: [u32], count: i64) -> i64:
    rt_write_u32s_to_raw_checksum(addr, values, count)

pub fn raw_write_fill_u32s_checksum(addr: i64, values: [u32], count: i64, expected: u32) -> i64:
    rt_write_fill_u32s_to_raw_checksum(addr, values, count, expected.to_i64())

export rt_alloc, rt_free, rt_ptr_read_i64, rt_ptr_read_i32, rt_ptr_write_i64
export rt_write_u32s_to_raw_checksum, f32_from_bits, spl_f64_to_bits, spl_bits_to_f64
export rt_write_fill_u32s_to_raw_checksum
export raw_alloc, raw_free, raw_read_i32, raw_write_i64, raw_write_u32s_checksum
export raw_write_fill_u32s_checksum
