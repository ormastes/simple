"""
# Fulfillment Vertical — order shipments over the shared enterprise store

Lane W19-B of the Simple Enterprise Suite. Flow:

    order ref -> shipment create -> dispatch -> deliver
                                 \-> cancel (only before dispatch)

Every write runs the frozen guarded sequence over the durable store:

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

## RBAC — reuses the frozen `procurement` role (no new grant)

`foundation.role_allows` is FROZEN and must not change. Warehouse fulfillment
is operationally the same actor as goods receiving, so this vertical AUTHORIZES
against the existing `procurement` role by checking existing procurement action
strings — no row is added to the frozen table and `rbac_registry.spl` is not
touched:

- shipment_create  -> `proc.requisition.create`
- shipment_dispatch-> `proc.po.receive`
- shipment_deliver -> `proc.invoice.record`
- shipment_cancel  -> `proc.requisition.approve`

## Storage model — insert-only + derive (never UPDATE)

- `ful_shipments`: one immutable row per shipment (order ref, sku, ordered qty).
- `ful_ship_events`: append-only status stream; the CURRENT status is a pure
  fold over this stream, never a mutated column:
      "" (unknown) -> pending -> dispatched -> delivered
                    \-> cancelled            (only from pending)

Illegal transitions (dispatch of a non-pending shipment, deliver of a
non-dispatched one, cancel after dispatch) are denied `invalid-transition`
with NO effect. Over-shipment — delivering more than the ordered quantity — is
denied with the closed-set reason `insufficient-stock` (the ordered quantity is
fixed, so this check is state-independent and unconditional).

sha256 audit is taken only via the enterprise_store facade
(`records.audit_append` -> `audit_hash.audit_sha256_hex`); this module never
imports `std.common.crypto.sha256` directly (cross-OS rule, one codebase).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid, role_allows
}

# =============================================================================
# Schema
# =============================================================================

fn ful_setup(store: EnterpriseStore) -> bool:
    var ok = store_migrate(store, "ful_001_shipments",
        "CREATE TABLE IF NOT EXISTS ful_shipments (id INTEGER PRIMARY KEY, tenant_id TEXT, ship_id TEXT, order_ref TEXT, sku TEXT, qty TEXT)")
    ok = ok and store_migrate(store, "ful_002_ship_events",
        "CREATE TABLE IF NOT EXISTS ful_ship_events (id INTEGER PRIMARY KEY, tenant_id TEXT, ship_id TEXT, event TEXT, detail TEXT)")
    ok

# =============================================================================
# Derived reads (pure-Simple folds; see store docstring)
# =============================================================================

# ful_shipment_status folds the event stream to the shipment's current status:
# "" (unknown) -> pending -> dispatched -> delivered, or pending -> cancelled.
fn ful_shipment_status(store: EnterpriseStore, tenant_id: text, ship_id: text) -> text:
    var status = ""
    val rows = store_rows(store, "ful_ship_events", "id, tenant_id, ship_id, event, detail")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "ship_id") == ship_id:
            status = sqlite_row_get(row, "event")
    status

# ful_shipment_ordered returns (sku, ordered_qty); qty -1 signals unknown shipment.
fn ful_shipment_ordered(store: EnterpriseStore, tenant_id: text, ship_id: text) -> (text, i64):
    val rows = store_rows(store, "ful_shipments", "id, tenant_id, ship_id, order_ref, sku, qty")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "ship_id") == ship_id:
            return (sqlite_row_get(row, "sku"), int(sqlite_row_get(row, "qty")))
    ("", -1)

# ful_delivered_qty returns the delivered quantity recorded for a shipment
# (0 when not yet delivered) — read from the delivered event's detail.
fn ful_delivered_qty(store: EnterpriseStore, tenant_id: text, ship_id: text) -> i64:
    var qty: i64 = 0
    val rows = store_rows(store, "ful_ship_events", "id, tenant_id, ship_id, event, detail")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "ship_id") == ship_id:
            if sqlite_row_get(row, "event") == "delivered":
                qty = int(sqlite_row_get(row, "detail"))
    qty

# ful_shipments_for_order counts a tenant's shipments raised against an order ref.
fn ful_shipments_for_order(store: EnterpriseStore, tenant_id: text, order_ref: text) -> i64:
    var n: i64 = 0
    val rows = store_rows(store, "ful_shipments", "id, tenant_id, ship_id, order_ref, sku, qty")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "order_ref") == order_ref:
            n = n + 1
    n

# =============================================================================
# Guarded commands (frozen sequence: session -> rbac -> validation ->
# idempotency -> effects in one unit of work)
# =============================================================================

# shipment_create raises a new shipment for an order ref, in status pending.
fn shipment_create(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, ship_id: text, order_ref: text, sku: text, qty: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", ship_id)
    if not role_allows(who.role, "proc.requisition.create"):
        return denied("forbidden", ship_id)
    if ship_id == "" or order_ref == "" or sku == "" or qty <= 0:
        return denied("invalid-record", ship_id)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO ful_shipments (tenant_id, ship_id, order_ref, sku, qty) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, ship_id, order_ref, sku, "{qty}"])
    store_insert_row(store,
        "INSERT INTO ful_ship_events (tenant_id, ship_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, ship_id, "pending", order_ref + ":" + sku + ":{qty}"])
    outbox_append(store, tenant.tenant_id, "fulfillment.shipment.created", ship_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "fulfillment.shipment.create", ship_id)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ship_id)
    uow_commit(store)
    accepted(ship_id)

# shipment_dispatch moves pending -> dispatched. An unknown shipment is
# invalid-record (state-independent). The pending -> dispatched transition is
# state-DEPENDENT (dispatched is this command's own effect), so it is asked
# only of a command not already recorded; a replay returns the recorded result.
fn shipment_dispatch(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, ship_id: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", ship_id)
    if not role_allows(who.role, "proc.po.receive"):
        return denied("forbidden", ship_id)
    val status = ful_shipment_status(store, tenant.tenant_id, ship_id)
    if status == "":
        return denied("invalid-record", ship_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and status != "pending":
        return denied("invalid-transition", ship_id + ":" + status)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO ful_ship_events (tenant_id, ship_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, ship_id, "dispatched", ""])
    outbox_append(store, tenant.tenant_id, "fulfillment.shipment.dispatched", ship_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "fulfillment.shipment.dispatch", ship_id)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ship_id)
    uow_commit(store)
    accepted(ship_id)

# shipment_deliver moves dispatched -> delivered, recording the delivered
# quantity. Over-shipment (delivered_qty > ordered qty) is denied
# insufficient-stock: the ordered quantity is fixed, so the check is
# state-independent and unconditional. The dispatched -> delivered transition
# is state-dependent and is asked only of a command not already recorded.
fn shipment_deliver(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, ship_id: text, delivered_qty: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", ship_id)
    if not role_allows(who.role, "proc.invoice.record"):
        return denied("forbidden", ship_id)
    if delivered_qty <= 0:
        return denied("invalid-record", ship_id)
    val ordered = ful_shipment_ordered(store, tenant.tenant_id, ship_id)
    if ordered.1 < 0:
        return denied("invalid-record", ship_id)
    # Over-shipment: state-independent (ordered qty never changes) -> unconditional.
    if delivered_qty > ordered.1:
        return denied("insufficient-stock", "over-ship:" + ship_id + ":ordered={ordered.1}:got={delivered_qty}")
    val status = ful_shipment_status(store, tenant.tenant_id, ship_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and status != "dispatched":
        return denied("invalid-transition", ship_id + ":" + status)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO ful_ship_events (tenant_id, ship_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, ship_id, "delivered", "{delivered_qty}"])
    outbox_append(store, tenant.tenant_id, "fulfillment.shipment.delivered", ship_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "fulfillment.shipment.deliver", ship_id + ":{delivered_qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ship_id)
    uow_commit(store)
    accepted(ship_id)

# shipment_cancel cancels a shipment, allowed ONLY before dispatch
# (pending -> cancelled). Cancelling after dispatch/deliver is
# invalid-transition; an unknown shipment is invalid-record.
fn shipment_cancel(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, ship_id: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", ship_id)
    if not role_allows(who.role, "proc.requisition.approve"):
        return denied("forbidden", ship_id)
    val status = ful_shipment_status(store, tenant.tenant_id, ship_id)
    if status == "":
        return denied("invalid-record", ship_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and status != "pending":
        return denied("invalid-transition", ship_id + ":" + status)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO ful_ship_events (tenant_id, ship_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, ship_id, "cancelled", ""])
    outbox_append(store, tenant.tenant_id, "fulfillment.shipment.cancelled", ship_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "fulfillment.shipment.cancel", ship_id)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ship_id)
    uow_commit(store)
    accepted(ship_id)

export ful_setup
export ful_shipment_status, ful_shipment_ordered, ful_delivered_qty, ful_shipments_for_order
export shipment_create, shipment_dispatch, shipment_deliver, shipment_cancel
