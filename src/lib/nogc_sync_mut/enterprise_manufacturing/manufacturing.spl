"""
# Manufacturing / Bill-of-Materials Vertical — define BOM, release + complete work orders

Lane `.spipe/simple_enterprise_suite` (W20-A). A minimal but real manufacturing
vertical layered on the durable enterprise store: a finished SKU is described
by a bill-of-materials (component SKU + quantity lines), a work order is
released for a finished SKU × quantity (only when a BOM exists), and completing
the work order records finished-goods production.

Every write runs the frozen guarded sequence over the durable store:

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

## Storage model — insert-only rows, derive on read

Two insert-only tables, NO UPDATE anywhere:

- `mfg_bom_lines` — one row per component line of a finished SKU's BOM.
- `mfg_wo_events` — one row per work-order lifecycle event.

Derived state is a pure-Simple fold over the rows (the interpreter sqlite
emulation is non-ACID and ignores WHERE — durable claims rest on the file
backend; see the store's backend-honesty docstring):

- `bom_exists(tenant, finished_sku)` — any BOM line row exists for that SKU.
- `wo_status(tenant, wo_id)` — last event wins: "" -> released -> completed.

Work-order status is therefore never UPDATEd: `work_order_complete` reads the
folded status and appends a `completed` event; a replayed or out-of-order
transition is denied with the closed-set reason `invalid-transition`.

Every mutation writes a sha256-chained audit row through `audit_append` (the
SMF-safe facade — this module never imports std.common.crypto.sha256 directly,
per the cross-OS rule: one codebase for host and SimpleOS).

## RBAC — frozen table reused, no new grant

foundation.role_allows is FROZEN (an ADR is required to extend it). Rather than
add a manufacturing role there, this vertical reuses the existing `procurement`
grants — the procurement role already owns purchase-to-stock movement, and
manufacturing/production staff are the same operational tier:

- `bom_define` / `work_order_release` guard on `proc.po.create` — defining a
  BOM and releasing a work order are planning acts, like creating a PO.
- `work_order_complete` guards on `proc.po.receive` — booking finished goods
  into existence mirrors receiving purchased goods.

admin passes every action via the blanket admin rule. A dedicated
`manufacturing` role (or a data-driven `enterprise_sale/rbac_registry.spl`
grant) is an ADR-gated migration; this module adds nothing to the frozen
contract.
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid, role_allows
}

# =============================================================================
# Schema — two insert-only tables
# =============================================================================

fn mfg_setup(store: EnterpriseStore) -> bool:
    val a = store_migrate(store, "mfg_001_bom_lines",
        "CREATE TABLE IF NOT EXISTS mfg_bom_lines (id INTEGER PRIMARY KEY, tenant_id TEXT, finished_sku TEXT, component_sku TEXT, qty TEXT, ref_id TEXT)")
    val b = store_migrate(store, "mfg_002_wo_events",
        "CREATE TABLE IF NOT EXISTS mfg_wo_events (id INTEGER PRIMARY KEY, tenant_id TEXT, wo_id TEXT, finished_sku TEXT, qty TEXT, event TEXT, ref_id TEXT)")
    a and b

# =============================================================================
# Derived reads (pure-Simple filtering + fold; see module docstring)
# =============================================================================

# bom_exists: does a BOM (>=1 component line) exist for a finished SKU?
fn bom_exists(store: EnterpriseStore, tenant_id: text, finished_sku: text) -> bool:
    val rows = store_rows(store, "mfg_bom_lines", "id, tenant_id, finished_sku, component_sku, qty, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "finished_sku") == finished_sku:
            return true
    false

# bom_line_count: number of component lines recorded for a finished SKU.
fn bom_line_count(store: EnterpriseStore, tenant_id: text, finished_sku: text) -> i64:
    var n: i64 = 0
    val rows = store_rows(store, "mfg_bom_lines", "id, tenant_id, finished_sku, component_sku, qty, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "finished_sku") == finished_sku:
            n = n + 1
    n

# wo_status derives a work order's status from its event stream:
# "" (unknown) -> released -> completed. Last event wins (insert-only, no UPDATE).
fn wo_status(store: EnterpriseStore, tenant_id: text, wo_id: text) -> text:
    var status = ""
    val rows = store_rows(store, "mfg_wo_events", "id, tenant_id, wo_id, finished_sku, qty, event, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "wo_id") == wo_id:
            status = sqlite_row_get(row, "event")
    status

# produced_qty: total finished-goods quantity booked by completed work orders
# for a finished SKU (a pure fold over `completed` events).
fn produced_qty(store: EnterpriseStore, tenant_id: text, finished_sku: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "mfg_wo_events", "id, tenant_id, wo_id, finished_sku, qty, event, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "finished_sku") == finished_sku:
            if sqlite_row_get(row, "event") == "completed":
                total = total + int(sqlite_row_get(row, "qty"))
    total

# =============================================================================
# Guarded commands
# =============================================================================

# bom_define: record a bill-of-materials for a finished SKU as a set of
# component (SKU, qty) lines. Insert-only — a redefine appends new lines under
# a fresh idempotency key rather than mutating existing rows.
fn bom_define(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, finished_sku: text, components: [(text, i64)]) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", finished_sku)
    if not role_allows(who.role, "proc.po.create"):
        return denied("forbidden", finished_sku)
    if finished_sku == "" or components.len() == 0:
        return denied("invalid-record", finished_sku)
    for line in components:
        if line.0 == "" or line.1 <= 0:
            return denied("invalid-record", finished_sku)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    for line in components:
        store_insert_row(store,
            "INSERT INTO mfg_bom_lines (tenant_id, finished_sku, component_sku, qty, ref_id) VALUES (?, ?, ?, ?, ?)",
            [tenant.tenant_id, finished_sku, line.0, "{line.1}", finished_sku])
    outbox_append(store, tenant.tenant_id, "manufacturing.bom.defined", finished_sku + ":lines={components.len()}")
    audit_append(store, tenant.tenant_id, who.actor_id, "manufacturing.bom.define", finished_sku + ":lines={components.len()}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, finished_sku)
    uow_commit(store)
    accepted(finished_sku)

# work_order_release: release a work order for a finished SKU × quantity. A BOM
# for the finished SKU MUST exist (else invalid-record); the wo_id must be new
# (else invalid-transition — a released/completed order cannot be re-released).
fn work_order_release(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, wo_id: text, finished_sku: text, qty: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", wo_id)
    if not role_allows(who.role, "proc.po.create"):
        return denied("forbidden", wo_id)
    if wo_id == "" or finished_sku == "" or qty <= 0:
        return denied("invalid-record", wo_id)
    # A work order cannot be released for a SKU with no bill-of-materials.
    if not bom_exists(store, tenant.tenant_id, finished_sku):
        return denied("invalid-record", "no-bom:" + finished_sku)
    # The release transition is state-DEPENDENT (wo must be unknown), so it is
    # judged only for a command not already recorded, preserving the frozen
    # order (session -> rbac -> validation -> idempotency).
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and wo_status(store, tenant.tenant_id, wo_id) != "":
        return denied("invalid-transition", "already-open:" + wo_id + ":status={wo_status(store, tenant.tenant_id, wo_id)}")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO mfg_wo_events (tenant_id, wo_id, finished_sku, qty, event, ref_id) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, wo_id, finished_sku, "{qty}", "released", wo_id])
    outbox_append(store, tenant.tenant_id, "manufacturing.work_order.released", wo_id + ":" + finished_sku + ":{qty}")
    audit_append(store, tenant.tenant_id, who.actor_id, "manufacturing.work_order.release", wo_id + ":" + finished_sku + ":{qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, wo_id)
    uow_commit(store)
    accepted(wo_id)

# work_order_complete: mark a released work order done, booking finished goods
# into existence. Denied with invalid-transition when the order is not in the
# `released` state (unknown, or already completed).
fn work_order_complete(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, wo_id: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", wo_id)
    if not role_allows(who.role, "proc.po.receive"):
        return denied("forbidden", wo_id)
    if wo_id == "":
        return denied("invalid-record", wo_id)
    # Only a released order may complete. State-dependent, so gated on
    # not-replayed: a replay of the completing command must return the recorded
    # result, not be re-judged as a double-complete.
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and wo_status(store, tenant.tenant_id, wo_id) != "released":
        return denied("invalid-transition", "not-released:" + wo_id + ":status={wo_status(store, tenant.tenant_id, wo_id)}")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # Carry the finished SKU / qty from the release event so completion records
    # the produced finished goods.
    var fsku = ""
    var wqty = "0"
    val rows = store_rows(store, "mfg_wo_events", "id, tenant_id, wo_id, finished_sku, qty, event, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant.tenant_id and sqlite_row_get(row, "wo_id") == wo_id and sqlite_row_get(row, "event") == "released":
            fsku = sqlite_row_get(row, "finished_sku")
            wqty = sqlite_row_get(row, "qty")
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO mfg_wo_events (tenant_id, wo_id, finished_sku, qty, event, ref_id) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, wo_id, fsku, wqty, "completed", wo_id])
    outbox_append(store, tenant.tenant_id, "manufacturing.work_order.completed", wo_id + ":" + fsku + ":" + wqty)
    audit_append(store, tenant.tenant_id, who.actor_id, "manufacturing.work_order.complete", wo_id + ":" + fsku + ":" + wqty)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, wo_id)
    uow_commit(store)
    accepted(wo_id)

export mfg_setup
export bom_exists, bom_line_count, wo_status, produced_qty
export bom_define, work_order_release, work_order_complete
