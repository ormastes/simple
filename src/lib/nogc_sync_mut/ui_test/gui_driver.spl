# SGTTI GUI Driver (v1)
#
# Thin GUI-lane driver over SgttiTestDriver: strict resolution + geometric
# pointer actions. click() targets the node's center point when layout
# geometry is reachable from the snapshot; a no-geometry node falls back to
# the semantic action invoke with a recorded note. No compositor/pixel or
# DrawIR verification here (later waves).

use common.ui.access_types.{UiAccessNode}
use common.ui.win_text_access.{WinTextSnapshot, WinTextActionRequest, win_text_route_action}
use nogc_sync_mut.ui_test.sgtti.{SgttiTestDriver, SgttiGeometry}

pub struct GuiActionResult:
    ok: bool
    target_canonical_id: text
    used_geometry: bool
    pointer_x: i32
    pointer_y: i32
    note: text

pub class SgttiGuiDriver:
    driver: SgttiTestDriver

    static fn new(driver: SgttiTestDriver) -> SgttiGuiDriver:
        SgttiGuiDriver(driver: driver)

    static fn from_snapshot(snapshot: WinTextSnapshot) -> SgttiGuiDriver:
        SgttiGuiDriver.new(SgttiTestDriver.new(snapshot))

    fn snapshot() -> WinTextSnapshot:
        self.driver.snapshot

    fn resolve_strict(target: text) -> Result<UiAccessNode, text>:
        self.driver.resolve_strict(target)

    fn geometry(target: text) -> Result<SgttiGeometry, text>:
        self.driver.geometry(target)

    # Pointer click at the node's center when geometry is present; otherwise
    # semantic action invoke with a recorded note in the result.
    fn click(target: text) -> Result<GuiActionResult, text>:
        val node = self.driver.resolve_strict(target)?
        val geo = self.driver.geometry(node.canonical_id)?
        var x = 0
        var y = 0
        var note = "no geometry on node; fell back to semantic click invoke"
        if geo.has_geometry:
            x = geo.center_x
            y = geo.center_y
            note = "pointer click at layout center"
        val result = win_text_route_action(self.driver.snapshot, WinTextActionRequest(
            target_id: node.canonical_id,
            action: "click",
            text_value: "",
            x: x,
            y: y
        ))
        if not result.ok:
            return Err(result.message)
        Ok(GuiActionResult(
            ok: true,
            target_canonical_id: node.canonical_id,
            used_geometry: geo.has_geometry,
            pointer_x: x,
            pointer_y: y,
            note: note
        ))

    fn type_text(target: text, content: text) -> Result<GuiActionResult, text>:
        val node = self.driver.resolve_strict(target)?
        val result = win_text_route_action(self.driver.snapshot, WinTextActionRequest(
            target_id: node.canonical_id,
            action: "type_text",
            text_value: content,
            x: 0,
            y: 0
        ))
        if not result.ok:
            return Err(result.message)
        Ok(GuiActionResult(
            ok: true,
            target_canonical_id: node.canonical_id,
            used_geometry: false,
            pointer_x: 0,
            pointer_y: 0,
            note: "semantic type_text invoke"
        ))
