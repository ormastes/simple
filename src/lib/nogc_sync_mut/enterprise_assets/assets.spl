"""
# Enterprise Assets — fixed-asset register + straight-line depreciation

Fixed-assets vertical of the Simple Enterprise Suite over the durable
enterprise store, following the FROZEN foundation contracts
(`enterprise_sale/foundation.spl` and `enterprise_sale/rbac_registry.spl` are
never edited). Guarded writes acquire / capitalize / post / dispose; pure reads
derive the cost basis, the depreciation schedule and the book value with EXACT
integer minor-unit arithmetic — never floats.

## Storage model (insert-only + pure fold)

Two insert-only tables. `asset_register (tenant_id, asset_id, cost_cents,
salvage_cents, life_periods, acquired_by)` holds one acquisition row per asset.
`asset_events (tenant_id, asset_id, event, amount_cents, period)` is an
append-only journal of `capitalize` / `post` / `dispose` rows. Nothing is ever
UPDATEd or DELETEd: every derived quantity is a pure fold over the rows, and
every fold filters on the session's authoritative tenant id, so tenant B can
never read tenant A's assets.

## Cost basis and capitalization

`asset_cost_basis = acquisition cost + sum(capitalize amounts)`. A
capitalization is a subsequent improvement folded into the depreciable basis;
it does not rewrite the acquisition row.

## Straight-line schedule (documented, deterministic, float-free)

Depreciable amount is `basis - salvage`, spread over `life_periods` equal
periods:

    per_period = (basis - salvage) / life_periods        # integer division
    last       = (basis - salvage) - per_period * (life_periods - 1)

The truncation remainder is absorbed by the FINAL period, so the schedule sums
EXACTLY to `basis - salvage` with no float and no drift. Example: basis 10000,
salvage 1000, life 3 -> 9000/3 = 3000 each, sum 9000. Basis 10000, salvage 0,
life 3 -> 3333, 3333, 3334 (the last period carries the +1 remainder).

A non-positive depreciable amount or a non-positive life yields an empty
schedule (nothing to depreciate).

## Period posting and book value

`asset_post_period` appends one `post` row for a period. Accumulated
depreciation is the sum of the posted rows' amounts; the net book value is
`basis - accumulated`. Posting is capped at `life_periods` postings — an asset
can never depreciate past its salvage floor. Re-posting the SAME period is
rejected (`invalid-record`), and posting to a disposed asset is rejected too.

## Disposal with gain / loss

`asset_dispose` records the sale proceeds and computes
`gain_loss = proceeds - net_book_value`: positive is a GAIN, negative a LOSS,
zero a break-even disposal. A second disposal of the same asset is rejected
(`invalid-record`) — the register is insert-only, so the rejection comes from a
fold over the existing `dispose` rows, not from a mutable flag.

## RBAC (reuse, not a new grant)

All four commands REUSE the existing `finance` role via the LOCAL
`assets_role_allows` gate. The frozen `role_allows` table is NOT edited and
`enterprise_sale/rbac_registry.spl` is deliberately NOT touched (its equivalence
spec is byte-fenced to the frozen table). The frozen session -> rbac ->
validation -> idempotency -> effects SEQUENCE is preserved exactly in every
command. Audit hashing goes only through `records.audit_append` (the
`enterprise_store.audit_hash.audit_sha256_hex` facade) — this module never
imports `std.common.crypto.sha256`.

Lane: .spipe/simple_enterprise_suite (W23-FAN, assets).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, Money,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema — insert-only register + event journal
# =============================================================================

fn assets_setup(store: EnterpriseStore) -> bool:
    store_migrate(store, "assets_001_register",
        "CREATE TABLE IF NOT EXISTS asset_register (id INTEGER PRIMARY KEY, tenant_id TEXT, asset_id TEXT, cost_cents TEXT, salvage_cents TEXT, life_periods TEXT, acquired_by TEXT)")
    store_migrate(store, "assets_002_events",
        "CREATE TABLE IF NOT EXISTS asset_events (id INTEGER PRIMARY KEY, tenant_id TEXT, asset_id TEXT, event TEXT, amount_cents TEXT, period TEXT)")

# =============================================================================
# RBAC — reuse the finance role (see module docstring)
# =============================================================================

# assets_role_allows gates every fixed-asset command. admin passes for
# everything (matching the frozen blanket rule); the finance role is REUSED for
# asset register actions.
fn assets_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "finance":
        return action == "assets.acquire" or action == "assets.capitalize" or action == "assets.post" or action == "assets.dispose"
    false

# =============================================================================
# Pure folds over the insert-only rows
# =============================================================================

# One acquired asset, as folded out of the register.
struct AssetRecord:
    asset_id: text
    cost_cents: i64
    salvage_cents: i64
    life_periods: i64
    found: bool

# assets_find returns the acquisition row for (tenant, asset_id), or a record
# with found=false when the asset was never acquired under that tenant.
fn assets_find(store: EnterpriseStore, tenant_id: text, asset_id: text) -> AssetRecord:
    var out = AssetRecord(asset_id: asset_id, cost_cents: 0, salvage_cents: 0, life_periods: 0, found: false)
    val rows = store_rows(store, "asset_register", "id, tenant_id, asset_id, cost_cents, salvage_cents, life_periods, acquired_by")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "asset_id") == asset_id:
            out = AssetRecord(
                asset_id: asset_id,
                cost_cents: int(sqlite_row_get(row, "cost_cents")),
                salvage_cents: int(sqlite_row_get(row, "salvage_cents")),
                life_periods: int(sqlite_row_get(row, "life_periods")),
                found: true)
    out

# assets_event_total sums the amounts of every `event` row for the asset.
fn assets_event_total(store: EnterpriseStore, tenant_id: text, asset_id: text, event: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "asset_events", "id, tenant_id, asset_id, event, amount_cents, period")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "asset_id") == asset_id and sqlite_row_get(row, "event") == event:
            total = total + int(sqlite_row_get(row, "amount_cents"))
    total

# assets_event_count counts the `event` rows for the asset.
fn assets_event_count(store: EnterpriseStore, tenant_id: text, asset_id: text, event: text) -> i64:
    var n: i64 = 0
    val rows = store_rows(store, "asset_events", "id, tenant_id, asset_id, event, amount_cents, period")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "asset_id") == asset_id and sqlite_row_get(row, "event") == event:
            n = n + 1
    n

# assets_period_posted reports whether the given period was ALREADY posted for
# the asset — the seam that makes a duplicate period posting rejectable without
# any mutable state.
fn assets_period_posted(store: EnterpriseStore, tenant_id: text, asset_id: text, period: i64) -> bool:
    val rows = store_rows(store, "asset_events", "id, tenant_id, asset_id, event, amount_cents, period")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "asset_id") == asset_id and sqlite_row_get(row, "event") == "post" and int(sqlite_row_get(row, "period")) == period:
            return true
    false

# assets_disposed reports whether the asset already carries a dispose row.
fn assets_disposed(store: EnterpriseStore, tenant_id: text, asset_id: text) -> bool:
    assets_event_count(store, tenant_id, asset_id, "dispose") > 0

# assets_cost_basis = acquisition cost + every capitalized improvement.
# An unknown asset has a basis of 0.
fn assets_cost_basis(store: EnterpriseStore, tenant_id: text, asset_id: text) -> i64:
    val rec = assets_find(store, tenant_id, asset_id)
    if not rec.found:
        return 0
    rec.cost_cents + assets_event_total(store, tenant_id, asset_id, "capitalize")

# assets_schedule returns the straight-line depreciation amount for each period
# 1..life_periods, with the integer-division remainder absorbed by the FINAL
# period so the schedule sums EXACTLY to (basis - salvage). A non-positive
# depreciable amount or life yields an empty schedule.
fn assets_schedule(store: EnterpriseStore, tenant_id: text, asset_id: text) -> [i64]:
    val rec = assets_find(store, tenant_id, asset_id)
    if not rec.found or rec.life_periods <= 0:
        return []
    val depreciable = assets_cost_basis(store, tenant_id, asset_id) - rec.salvage_cents
    if depreciable <= 0:
        return []
    val per = depreciable / rec.life_periods
    var out: [i64] = []
    var i: i64 = 1
    while i < rec.life_periods:
        out.push(per)
        i = i + 1
    out.push(depreciable - per * (rec.life_periods - 1))
    out

# assets_schedule_total sums the schedule — proves it reconciles to
# (basis - salvage) exactly, with no float drift.
fn assets_schedule_total(store: EnterpriseStore, tenant_id: text, asset_id: text) -> i64:
    var total: i64 = 0
    for amount in assets_schedule(store, tenant_id, asset_id):
        total = total + amount
    total

# assets_accumulated is the sum of the amounts actually POSTED so far (not the
# whole schedule) — the accounting-recognised depreciation to date.
fn assets_accumulated(store: EnterpriseStore, tenant_id: text, asset_id: text) -> i64:
    assets_event_total(store, tenant_id, asset_id, "post")

# assets_book_value = cost basis - accumulated depreciation. This is the value a
# disposal is measured against.
fn assets_book_value(store: EnterpriseStore, tenant_id: text, asset_id: text) -> i64:
    assets_cost_basis(store, tenant_id, asset_id) - assets_accumulated(store, tenant_id, asset_id)

# assets_book_value_money is the session-gated Money view of the book value. An
# invalid session yields 0 in the requested currency (same shape as the finance
# reports), and the fold uses the session's AUTHORITATIVE tenant id.
fn assets_book_value_money(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, asset_id: text, currency: text) -> Money:
    if not session_valid(session, tenant, who):
        return Money(amount_cents: 0, currency: currency)
    Money(amount_cents: assets_book_value(store, session.tenant_id, asset_id), currency: currency)

# assets_gain_loss is the gain (positive) or loss (negative) that disposing of
# the asset for `proceeds_cents` WOULD realise: proceeds - net book value.
fn assets_gain_loss(store: EnterpriseStore, tenant_id: text, asset_id: text, proceeds_cents: i64) -> i64:
    proceeds_cents - assets_book_value(store, tenant_id, asset_id)

# =============================================================================
# Guarded commands (frozen sequence: session -> rbac -> validation ->
# idempotency -> effects, all effects in one UoW)
# =============================================================================

# assets_acquire registers a new fixed asset under the session's tenant.
# Rejects a non-positive cost, a negative salvage, a salvage above cost, a
# NON-POSITIVE LIFE (the negative-life rejection), and a duplicate asset id.
fn assets_acquire(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, asset_id: text, cost_cents: i64, salvage_cents: i64, life_periods: i64) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", asset_id)
    # 2. rbac (reuse finance/admin)
    if not assets_role_allows(who.role, "assets.acquire"):
        return denied("forbidden", asset_id)
    # 3. domain validation
    if asset_id == "" or cost_cents <= 0 or salvage_cents < 0 or salvage_cents > cost_cents or life_periods <= 0:
        return denied("invalid-record", asset_id)
    if assets_find(store, tenant.tenant_id, asset_id).found:
        return denied("invalid-record", asset_id)
    # 4. idempotency
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects
    val detail = asset_id + ":{cost_cents}/{salvage_cents}/{life_periods}"
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO asset_register (tenant_id, asset_id, cost_cents, salvage_cents, life_periods, acquired_by) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, asset_id, "{cost_cents}", "{salvage_cents}", "{life_periods}", who.actor_id]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "assets.acquire", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "assets.acquire", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

# assets_capitalize folds a subsequent improvement into the depreciable basis.
# Rejects an unknown asset, a non-positive amount, and a disposed asset.
fn assets_capitalize(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, asset_id: text, amount_cents: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", asset_id)
    if not assets_role_allows(who.role, "assets.capitalize"):
        return denied("forbidden", asset_id)
    if amount_cents <= 0 or not assets_find(store, tenant.tenant_id, asset_id).found:
        return denied("invalid-record", asset_id)
    if assets_disposed(store, tenant.tenant_id, asset_id):
        return denied("invalid-record", asset_id)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val detail = asset_id + ":cap:{amount_cents}"
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO asset_events (tenant_id, asset_id, event, amount_cents, period) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, asset_id, "capitalize", "{amount_cents}", "0"]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "assets.capitalize", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "assets.capitalize", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

# assets_post_period posts the scheduled depreciation for `period` (1-based).
# Rejects an unknown asset, a period outside 1..life_periods, a period already
# posted, and a disposed asset. The posted amount is read from the schedule, so
# the FINAL period carries the remainder and the postings reconcile exactly.
fn assets_post_period(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, asset_id: text, period: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", asset_id)
    if not assets_role_allows(who.role, "assets.post"):
        return denied("forbidden", asset_id)
    val rec = assets_find(store, tenant.tenant_id, asset_id)
    if not rec.found or period < 1 or period > rec.life_periods:
        return denied("invalid-record", asset_id)
    if assets_disposed(store, tenant.tenant_id, asset_id):
        return denied("invalid-record", asset_id)
    if assets_period_posted(store, tenant.tenant_id, asset_id, period):
        return denied("invalid-record", asset_id)
    val schedule = assets_schedule(store, tenant.tenant_id, asset_id)
    if schedule.len() == 0:
        return denied("invalid-record", asset_id)
    val amount = schedule[period - 1]
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val detail = asset_id + ":p{period}:{amount}"
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO asset_events (tenant_id, asset_id, event, amount_cents, period) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, asset_id, "post", "{amount}", "{period}"]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "assets.post", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "assets.post", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

# assets_dispose retires the asset for `proceeds_cents`, recording the realised
# gain (proceeds > book value) or loss (proceeds < book value). A SECOND
# disposal is rejected (`invalid-record`) — proven by folding the dispose rows,
# not by a mutable flag.
fn assets_dispose(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, asset_id: text, proceeds_cents: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", asset_id)
    if not assets_role_allows(who.role, "assets.dispose"):
        return denied("forbidden", asset_id)
    if proceeds_cents < 0 or not assets_find(store, tenant.tenant_id, asset_id).found:
        return denied("invalid-record", asset_id)
    # double-dispose rejection — the register is insert-only, so this is a fold.
    if assets_disposed(store, tenant.tenant_id, asset_id):
        return denied("invalid-record", asset_id)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val gain_loss = assets_gain_loss(store, tenant.tenant_id, asset_id, proceeds_cents)
    val detail = asset_id + ":disposed:{proceeds_cents}:gl{gain_loss}"
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO asset_events (tenant_id, asset_id, event, amount_cents, period) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, asset_id, "dispose", "{proceeds_cents}", "0"]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "assets.dispose", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "assets.dispose", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

export assets_setup
export assets_role_allows
export AssetRecord, assets_find
export assets_event_total, assets_event_count, assets_period_posted, assets_disposed
export assets_cost_basis, assets_schedule, assets_schedule_total
export assets_accumulated, assets_book_value, assets_book_value_money, assets_gain_loss
export assets_acquire, assets_capitalize, assets_post_period, assets_dispose
