"""
# No-GC Sync RwLock Backend

Synchronous read-write lock runtime-hook owner for no-GC library families.
Async compatibility modules should import or re-export this backend instead of
declaring duplicate lock hooks.
"""

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_with_lock_keeping}

# --- SFFI declarations ---
extern fn rt_rwlock_new(initial: Any) -> Any
extern fn rt_rwlock_read(rwlock: Any) -> Any
extern fn rt_rwlock_write(rwlock: Any) -> Any
extern fn rt_rwlock_try_read(rwlock: Any) -> Any
extern fn rt_rwlock_try_write(rwlock: Any) -> Any
extern fn rt_rwlock_set(rwlock: Any, new_value: Any) -> Any

# --- RwLock ---
# @tag:api
#
# Handle to a read-write lock protecting a value.
# Allows multiple concurrent readers OR one exclusive writer.

# NOTE on runtime semantics: the rt_rwlock_read/rt_rwlock_write hooks acquire
# the underlying lock, copy the protected value, and release BEFORE returning
# (the Rust guard is dropped inside the hook — see
# src/compiler_rust/runtime/src/value/sync_rwlock.rs). read()/write() are
# therefore atomic SNAPSHOTS; no lock is ever held at the Simple level, and
# read()-then-set() is a racy read-modify-write. Use with_write(f) for RMW.

class RwLock:
    _handle: Any        # Runtime RwLock handle (opaque)
    _write_gate: Mutex  # Serializes with_write RMW sections (writer exclusion)

    # Guard-pattern shared read: runs `f(snapshot)` and returns f's result.
    # Snapshot is taken under the runtime read lock (shared with other
    # readers); the lock is already released when `f` runs, so `f` can be
    # arbitrarily slow without blocking writers.
    #
    # Generic over `T`, NOT `Any` — an `Any`-typed closure parameter
    # silently destroys the value passed through it; see
    # doc/08_tracking/bug/any_typed_closure_param_destroys_value_2026-07-28.md.
    # @tag:api
    fn with_read<T>(f: fn(T) -> T) -> T:
        f(rt_rwlock_read(self._handle))

    # Guard-pattern exclusive write: atomic read-modify-write.
    # Serializes against other with_write callers via the writer gate,
    # reads the current value, stores `f(current)` via the runtime write
    # lock, releases the gate, and returns the new value. Readers remain
    # shared and never block on the gate. Plain read()+set() pairs bypass
    # the gate and stay racy — prefer this for any update.
    #
    # Uses mutex_with_lock_keeping (not raw lock()/unlock()) so the gate is
    # released by construction, matching with_read/with_lock. The gate's
    # own stored value is a fixed 0 placeholder (it is never read as data),
    # so the RwLock read/f/set sequence runs as the guarded body (a
    # zero-arg closure — the gate's sentinel is never meaningful) and its
    # result is returned to the caller while `keep_value: 0` is what gets
    # written back into the gate slot.
    #
    # Generic over `T`: the inner closure and `f` both carry the RwLock's
    # real protected-value type through, never `Any`.
    # @tag:api
    fn with_write<T>(f: fn(T) -> T) -> T:
        mutex_with_lock_keeping(self._write_gate, 0, \:
            val current = rt_rwlock_read(self._handle)
            val updated = f(current)
            rt_rwlock_set(self._handle, updated)
            updated
        )

    # DEPRECATED: prefer with_read(f). Returns an atomic snapshot (the
    # runtime releases the read lock before returning — nothing is held).
    # Acquires read lock and returns protected value (blocking).
    # Multiple threads can hold read lock simultaneously.
    # Blocks if writer holds lock.
    #
    # OPTIONAL on purpose: rt_rwlock_read yields nil when the handle is not a
    # live runtime rwlock. Coalescing that to a default would fabricate a
    # snapshot that was never protected by any lock.
    # @tag:api
    fn read() -> Any?:
        rt_rwlock_read(self._handle)

    # DEPRECATED: prefer with_write(f). Returns an atomic snapshot; the
    # write lock is released before returning, so this grants NO exclusivity.
    # Acquires write lock and returns protected value (blocking).
    # Only one thread can hold write lock.
    # Blocks if any readers or writer hold lock.
    # Optional for the same reason as read() above.
    # @tag:api
    fn write() -> Any?:
        rt_rwlock_write(self._handle)

    # Non-blocking read lock attempt - returns nil if write lock held.
    # Returns protected value if read lock acquired.
    # @tag:api
    fn try_read() -> Any?:
        rt_rwlock_try_read(self._handle)

    # Non-blocking write lock attempt - returns nil if any lock held.
    # Returns protected value if write lock acquired exclusively.
    # @tag:api
    fn try_write() -> Any?:
        rt_rwlock_try_write(self._handle)

    # Updates protected value (acquires write lock internally).
    # Convenience method for write-and-release in one operation.
    # Blocks until write lock available.
    # @tag:api
    fn set(new_value: Any) -> Any:
        rt_rwlock_set(self._handle, new_value)

# --- API ---

# Creates a new read-write lock protecting the given initial value.
# Lock starts unlocked - first read() or write() succeeds immediately.
# @tag:api
fn rwlock_new(initial: Any) -> RwLock:
    val handle = rt_rwlock_new(initial)
    RwLock(_handle: handle, _write_gate: mutex_new(0))

# Free-function guard forms (native-safe explicit receiver; see mutex.spl).

# Generic over `T` — see RwLock.with_read/with_write above for why `Any` is
# rejected for these callback signatures.
fn rwlock_with_read<T>(rwlock: RwLock, f: fn(T) -> T) -> T:
    f(rt_rwlock_read(rwlock._handle))

fn rwlock_with_write<T>(rwlock: RwLock, f: fn(T) -> T) -> T:
    mutex_with_lock_keeping(rwlock._write_gate, 0, \:
        val current = rt_rwlock_read(rwlock._handle)
        val updated = f(current)
        rt_rwlock_set(rwlock._handle, updated)
        updated
    )
