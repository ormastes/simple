# Hosted generic mutex extensions. Kept outside the freestanding closure until
# native generic monomorphization is implemented.
use std.nogc_sync_mut.concurrent.mutex_core.{Mutex}

extern fn rt_mutex_lock(mutex: Any) -> Any
extern fn rt_mutex_unlock(mutex: Any, new_value: Any) -> Any

impl Mutex:
    fn with_lock<T>(f: fn(T) -> T) -> T:
        val current = rt_mutex_lock(self._handle)
        val updated = f(current)
        rt_mutex_unlock(self._handle, updated)
        updated

fn mutex_with_lock<T>(mutex: Mutex, f: fn(T) -> T) -> T:
    val updated = f(rt_mutex_lock(mutex._handle))
    rt_mutex_unlock(mutex._handle, updated)
    updated

fn mutex_with_lock_keeping<T>(mutex: Mutex, keep_value: Any, f: fn() -> T) -> T:
    rt_mutex_lock(mutex._handle)
    val result = f()
    rt_mutex_unlock(mutex._handle, keep_value)
    result

export mutex_with_lock, mutex_with_lock_keeping
