"""Pure policy for server worker admission across hosted and SimpleOS runtimes.

The SimpleOS filesystem-executable runtime currently reports at most one
available execution lane and may return an invalid handle from thread spawn.
Servers must therefore run one caller-owned worker and never join its zero
handle. Hosted runtimes spawn every planned worker so `start()` can return and
the caller can use `wait()` or coordinate graceful shutdown. A failed hosted
spawn changes only that worker into a caller-owned fallback.
"""

class ServerWorkerPlan:
    worker_count: i64
    spawn_count: i64
    inline_count: i64

fn server_worker_plan(requested: i64, available_parallelism: i64) -> ServerWorkerPlan:
    var workers = requested
    if workers <= 0:
        workers = available_parallelism
    if workers <= 0:
        workers = 1

    if available_parallelism <= 1:
        return ServerWorkerPlan(worker_count: 1, spawn_count: 0,
            inline_count: 1)

    ServerWorkerPlan(worker_count: workers, spawn_count: workers,
        inline_count: 0)

fn server_thread_handle_joinable(handle: i64) -> bool:
    handle > 0

export ServerWorkerPlan, server_worker_plan, server_thread_handle_joinable
