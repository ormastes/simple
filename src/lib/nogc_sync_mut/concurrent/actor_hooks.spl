# Legacy actor-hook compatibility surface.
#
# This module intentionally contains no `rt_actor_*` declarations. Its former
# raw ABI took `Any` handlers/messages and an actor id, while the runtime ABI
# takes a function pointer plus context and receives only from the current
# actor inbox. Passing the old values across that boundary is undefined and
# could fabricate a value or corrupt an actor mailbox.
#
# Migrate to `std.actor.spawn` and its scheduler-owned `ActorRef`, which keeps
# handler, mailbox, reply, and lifecycle ownership in pure Simple. These
# compatibility entry points fail closed so a stale import cannot invoke the
# invalid foreign ABI.

fn actor_hook_spawn(handler: Any) -> i64:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use std.actor.spawn with HandlerTable")

fn actor_hook_send(actor_id: i64, message: Any) -> bool:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use scheduler-owned ActorRef.send")

fn actor_hook_stop(actor_id: i64) -> bool:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use scheduler-owned ActorRef.stop")

fn actor_hook_recv(actor_id: i64) -> Any:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use scheduler-owned ActorRef.ask_sync")
