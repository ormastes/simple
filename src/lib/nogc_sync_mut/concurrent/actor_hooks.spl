# Actor runtime hook owner for compatibility actor APIs.

extern fn rt_actor_spawn(handler: Any) -> i64
extern fn rt_actor_stop(actor_id: i64) -> i64
extern fn rt_actor_try_send(actor_id: i64, message: Any) -> i64
extern fn rt_actor_recv(actor_id: i64) -> Any

fn actor_hook_spawn(handler: Any) -> i64:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use std.actor.spawn with HandlerTable")

fn actor_hook_send(actor_id: i64, message: Any) -> bool:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use scheduler-owned ActorRef.send")

fn actor_hook_stop(actor_id: i64) -> bool:
    """Close the hosted actor inbox exactly once and retain joinability."""
    rt_actor_stop(actor_id) == 1

fn actor_hook_recv(actor_id: i64) -> Any:
    panic("E-SFFI-ACTOR-LEGACY-ABI: use scheduler-owned ActorRef.ask_sync")
