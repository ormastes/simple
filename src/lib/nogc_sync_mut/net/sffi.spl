# Network compatibility facade
#
# TCP and UDP raw declarations are owned by `std.nogc_sync_mut.io`; URL
# parsing/coding is Pure Simple; the remaining file/text utilities are owned by
# the no-GC async compatibility module. All exports here are compile-time only,
# so this module adds no lookup, allocation, copy, or dispatch.

export use std.nogc_async_mut.net.sffi.{bytes_to_string, file_write_bytes}
export use std.nogc_sync_mut.http.url.{url_encode, url_decode}
