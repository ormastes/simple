# UDP compatibility facade
#
# The canonical no-GC sync I/O owner uses one generation-checked scalar
# descriptor and typed `Result` lifting. Keeping `std.net.udp` as a compile-time
# re-export removes the providerless high-level-object ABI without adding a
# wrapper allocation, lookup, copy, or dispatch.

export use std.nogc_sync_mut.io.udp.{UdpSocket}
