"""SOSIX directory, file, hard-link and host-identity facade (container runtime).

Exactly the operations the pure-Simple container runtime needs; each name
forwards unchanged to its io owner, so semantics and sentinels are the owner's.
Host-neutral: the per-OS selection stays inside the owners.

The four directory names keep their owner names: the seed binds an `as` alias of
a co-compiled directory name (`is_dir`, `dir_create_all`, `dir_remove_all`, `dir_is_real_no_follow`) to
the wrong owner and the container system spec regresses 18 -> 6 passing.
"""
export use std.nogc_sync_mut.io.dir_ops.{is_dir, dir_create_all, dir_remove_all, dir_is_real_no_follow}
export use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded as sosix_fs_read_regular_bounded, file_hardlink as sosix_fs_hardlink}
export use std.nogc_sync_mut.io_runtime.{file_write as sosix_fs_write_file, file_delete as sosix_fs_delete_file, getpid as sosix_fs_getpid}
export use std.platform.{host_os as sosix_fs_host_os, host_arch as sosix_fs_host_arch}
