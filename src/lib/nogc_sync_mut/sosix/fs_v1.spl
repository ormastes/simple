"""SOSIX directory, file, hard-link and host-identity facade (container runtime).

Exactly the host operations the pure-Simple container runtime needs; each name
forwards unchanged to its io owner (except `dir_create_new`, a thin exclusive-claim
wrapper over `directory_create_mode`), so semantics and sentinels are the owner's.
Host-neutral: the per-OS selection stays inside the owners. Pure helpers (time
field extraction, text decoding) and the clock (`sosix/time.spl`) and pid
(`sosix/host.spl`) are NOT re-exported here.

Every name that shares a module with another co-compiled name is exported under
its OWNER name: the seed binds an `export use X.{name as alias}` of a
co-compiled name to the wrong owner (the container system spec regresses 18 -> 6
passing). The only remaining aliases are `file_hardlink as sosix_fs_hardlink`,
`file_write as sosix_fs_write_file` and `host_os`/`host_arch`, whose owner names
would collide with other imports; they are verified by the container spec.
"""
export use std.nogc_sync_mut.io.dir_ops.{is_dir, dir_create_all, dir_remove_all, dir_is_real_no_follow, dir_list, dir_walk}
export use std.nogc_sync_mut.io.file_ops.{file_hardlink as sosix_fs_hardlink, file_exists, file_publish_noreplace_raw, file_read_regular_no_follow_bounded, file_read_regular_no_follow_bounded_bytes, file_write_bytes, file_size_raw, file_modified_time, secure_temp_dir_raw}
export use std.nogc_sync_mut.io_runtime.{file_write as sosix_fs_write_file, file_delete, dir_list_optional, rename_path}
export use std.platform.{host_os as sosix_fs_host_os, host_arch as sosix_fs_host_arch}
export use std.nogc_sync_mut.sffi.fs.{file_create_excl, file_sync, dir_sync}
export use std.nogc_sync_mut.sffi.io.{file_write_text}

use std.nogc_sync_mut.io.dir_entry_ops.{directory_create_mode}
use std.nogc_sync_mut.fs.host_path.{host_path_native}

# Exclusive single-component create: "ok" (this call made it), "exists"
# (already there, left untouched; rt_mkdir -17 = EEXIST) or "failed".
# The parent must already exist; claim authority rests on the mkdir itself.
pub fn dir_create_new(path: text) -> text:
    if path == "": return "failed"
    val made = directory_create_mode(host_path_native(path), 0o700)
    if made == 0: return "ok"
    if made == -17: return "exists"
    "failed"
