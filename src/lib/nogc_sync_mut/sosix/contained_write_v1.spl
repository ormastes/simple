# Contained write and read grants: host-neutral facade (architecture 4.4). One import
# switch over the per-OS variant files; every variant exports the same two names.
@when(os="windows"):
use std.nogc_sync_mut.sosix.windows.contained_write_v1.{sosix_fs_grant_contained_write_v1 as _variant_write, sosix_fs_grant_contained_read_v1 as _variant_read}
@elif(os="linux"):
use std.nogc_sync_mut.sosix.linux.contained_write_v1.{sosix_fs_grant_contained_write_v1 as _variant_write, sosix_fs_grant_contained_read_v1 as _variant_read}
@elif(os="macos"):
use std.nogc_sync_mut.sosix.macos.contained_write_v1.{sosix_fs_grant_contained_write_v1 as _variant_write, sosix_fs_grant_contained_read_v1 as _variant_read}
@elif(os="freebsd"):
use std.nogc_sync_mut.sosix.freebsd.contained_write_v1.{sosix_fs_grant_contained_write_v1 as _variant_write, sosix_fs_grant_contained_read_v1 as _variant_read}
@else:
use std.nogc_sync_mut.sosix.simpleos.contained_write_v1.{sosix_fs_grant_contained_write_v1 as _variant_write, sosix_fs_grant_contained_read_v1 as _variant_read}
@end

# "" = granted; otherwise a typed refusal reason.
pub fn sosix_fs_grant_contained_write_v1(empty_dir: text, scope: text) -> text:
    _variant_write(empty_dir, scope)

pub fn sosix_fs_grant_contained_read_v1(tree: text) -> text:
    _variant_read(tree)
