"""Synchronous SOSIX clock and sleep aliases with unchanged units.

Realtime remains Unix microseconds; monotonic deadlines remain milliseconds.
Sleep uses the native millisecond owner, never an external shell command.
"""
export use std.nogc_sync_mut.io_runtime.{
    time_now_unix_micros as sosix_time_now_unix_micros,
    time_now_monotonic_ms as sosix_time_now_monotonic_ms
}
export use std.nogc_sync_mut.concurrent.thread.{thread_sleep as sosix_sleep_ms}
