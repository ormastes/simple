# Value types shared by the SOSIX app-sandbox facade and its per-OS variant bodies
# (architecture pure_simple_container 4.2, increment-2 lane W2). They live here, not in
# the facade, so a variant never imports the facade that imports it. Bool-backed units
# read .value.
use std.common.contracts.sosix.containment_v1.{SosixContainMillisV1, SosixContainExitCodeV1, SosixContainFlagV1}

# One synchronous run of one child inside a per-scope AppContainer: no capabilities, so
# no network, and file access only to the dirs listed here. directory must be one of them.
pub struct SosixAppSandboxRequestV1:
    scope: text
    program: text
    args: [text]
    directory: text
    readonly_dirs: [text]
    writable_dirs: [text]
    stdout_path: text
    stderr_path: text
    wall: SosixContainMillisV1

# reason "" = the child ran and every grant, handle and the profile were released.
# A non-empty reason with exit_code -1 means the child did not run to an exit.
pub struct SosixAppSandboxResultV1:
    reason: text
    exit_code: SosixContainExitCodeV1
    timed_out: SosixContainFlagV1

pub const SOSIX_APP_SANDBOX_IDENTITY_V1 = "app-sandbox"
