"""Explicit Linux process text session facade: ordinary internal UTF-8 values.

Encoding configuration is immutable and belongs to each session/stream.
External values and native handles stay inside the owning implementation.
"""
export use std.nogc_sync_mut.io.process_text_session.{
    ProcessTextError, ProcessTextPoll, ProcessTextSession,
    process_text_session as sosix_process_text_session
}
