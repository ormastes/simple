"""Exact synchronous SOSIX aliases for the existing piped-process owner.

PID/token ownership, partial writes, errors and close semantics stay with
process_ops. These aliases introduce no process registry or async promise.
"""
export use std.nogc_sync_mut.io.process_ops.{
    process_spawn_piped as sosix_process_spawn_piped,
    process_write_stdin_some as sosix_process_write_stdin_some,
    process_read_stdout as sosix_process_read_stdout,
    process_is_piped_alive as sosix_process_is_piped_alive,
    process_close_piped as sosix_process_close_piped
}
