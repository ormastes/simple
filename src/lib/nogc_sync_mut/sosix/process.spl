"""Exact synchronous SOSIX aliases for the existing piped-process owner.

PID/token ownership, partial writes, errors and close semantics stay with
process_ops. These aliases introduce no process registry or async promise.
"""
export use std.nogc_sync_mut.io.piped_byte_endpoint_v1.{
    PipedByteEndpointV1, PipedByteReadTurnV1, PipedByteCloseTurnV1,
    process_byte_endpoint_equal_v1 as sosix_process_byte_endpoint_equal_v1,
    process_validate_byte_endpoint_v1 as sosix_process_validate_byte_endpoint_v1,
    process_read_byte_endpoint_v1 as sosix_process_read_byte_endpoint_v1,
    process_byte_endpoint_state_v1 as sosix_process_byte_endpoint_state_v1,
    process_close_byte_endpoint_v1 as sosix_process_close_byte_endpoint_v1
}
export use std.nogc_sync_mut.io.process_ops.{
    PipedProcessRefV1,
    PipedProcessOwnedTransferV2,
    PipedProcessOwnedSpawnV2,
    process_piped_ref_equal_v1 as sosix_process_piped_ref_equal_v1,
    process_spawn_piped_owned_v2 as sosix_process_spawn_piped_owned_v2,
    process_cleanup_piped_owned_v2 as sosix_process_cleanup_piped_owned_v2,
    process_validate_piped_owned_transfer_v2 as sosix_process_validate_piped_owned_transfer_v2,
    process_piped_owned_transfer_equal_v2 as sosix_process_piped_owned_transfer_equal_v2,
    process_spawn_piped_ref_v1 as sosix_process_spawn_piped_ref_v1,
    process_read_stdout_ref_v1 as sosix_process_read_stdout_ref_v1,
    process_validate_piped_ref_v1 as sosix_process_validate_piped_ref_v1,
    process_write_stdin_some_ref_v1 as sosix_process_write_stdin_some_ref_v1,
    process_is_piped_alive_ref_v1 as sosix_process_is_piped_alive_ref_v1,
    process_close_piped_ref_v1 as sosix_process_close_piped_ref_v1,
    process_run_bounded as sosix_process_run_bounded,
    process_spawn_piped as sosix_process_spawn_piped,
    process_write_stdin_some as sosix_process_write_stdin_some,
    process_read_stdout as sosix_process_read_stdout,
    process_is_piped_alive as sosix_process_is_piped_alive,
    process_exists as sosix_process_exists,
    process_close_piped as sosix_process_close_piped
}
