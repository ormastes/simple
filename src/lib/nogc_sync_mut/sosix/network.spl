"""Synchronous hosted SOSIX TCP compatibility boundary.

These exact-signature exports preserve the existing runtime descriptor, error,
partial-transfer and nullable-text conventions. Calls may block. This capsule
adds no scheduler, ring operation, descriptor owner or async completion claim.
The SFFI provider remains responsible for the foreign ABI; TcpStream and
TcpListener retain ownership and their close guards.

Byte reads preserve nullable failure, and peer address and shutdown preserve
their existing result types. The SFFI owner declares each raw ABI once.
"""

export use std.nogc_sync_mut.sffi.net.{
    io_tcp_accept as sosix_tcp_accept,
    io_tcp_accept_timeout as sosix_tcp_accept_timeout,
    io_tcp_bind as sosix_tcp_bind,
    io_tcp_bind_fd as sosix_tcp_bind_fd,
    io_tcp_close as sosix_tcp_close,
    io_tcp_connect as sosix_tcp_connect,
    io_tcp_connect_timeout as sosix_tcp_connect_timeout,
    io_tcp_flush as sosix_tcp_flush,
    io_tcp_listen as sosix_tcp_listen,
    io_tcp_local_addr as sosix_tcp_local_addr,
    io_tcp_read as sosix_tcp_read,
    io_tcp_read_line as sosix_tcp_read_line,
    io_tcp_peer_addr as sosix_tcp_peer_addr,
    io_tcp_set_nodelay as sosix_tcp_set_nodelay,
    io_tcp_set_nonblocking as sosix_tcp_set_nonblocking,
    io_tcp_set_read_timeout as sosix_tcp_set_read_timeout,
    io_tcp_set_reuseaddr as sosix_tcp_set_reuseaddr,
    io_tcp_set_reuseport as sosix_tcp_set_reuseport,
    io_tcp_set_write_timeout as sosix_tcp_set_write_timeout,
    io_tcp_socket_create as sosix_tcp_socket_create,
    io_tcp_shutdown as sosix_tcp_shutdown,
    io_tcp_write as sosix_tcp_write,
    io_tcp_write_text as sosix_tcp_write_text
}
