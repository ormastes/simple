"""Exact synchronous SOSIX host helpers for application startup and fixtures.

Keep the existing CLI normalization, file predicate and PID sentinel contract.
Platform name is the owner's OS name, not a new two-valued host-family API.
File, retained-credential, owned-lock and host-helper settlement names are
re-exported unchanged so product leaves (smux) reach the host only through
`std.sosix.host`.
"""
use std.nogc_sync_mut.io_runtime.{env_set_process}
export use std.nogc_sync_mut.cli.cli_util.{get_cli_args as sosix_get_cli_args}
export use std.nogc_sync_mut.io.file_ops.{file_exists as sosix_file_exists}
export use std.nogc_sync_mut.io.file_ops.{file_read as sosix_file_read, file_write as sosix_file_write}
export use std.nogc_sync_mut.io.sysinfo_ops.{getpid as sosix_getpid}
export use std.nogc_sync_mut.io_runtime.{platform_name as sosix_platform_name}
export use std.nogc_sync_mut.io.retained_file.{RetainedPrivateCredentialV1,
    retained_private_credential_open_v1, retained_private_credential_read_v1,
    retained_private_credential_publish_v1, retained_private_credential_close_v1}
export use std.nogc_sync_mut.io.file_lock_owned_v2.{FileLockReleaseStateV2}
export use std.nogc_sync_mut.orchestration.host_helper_settlement_v1.{HostHelperSettlementAckV1}
export use std.nogc_async_mut.container.terminal_session_v1.{ContainerPrimaryAttachSessionV1}

# Synchronous twin of std.nogc_async_mut.sosix.environment.sosix_env_set:
# same C-string admission (no NUL; key nonempty without '=').
pub fn sosix_env_set(key: text, value: text) -> bool:
    if key == "" or key.contains("=") or key.contains("\0") or value.contains("\0"):
        return false
    env_set_process(key, value)
