"""Exact synchronous SOSIX host helpers for application startup and fixtures.

Keep the existing CLI normalization, file predicate and PID sentinel contract.
Platform name is the owner's OS name, not a new two-valued host-family API.
File, retained-credential, owned-lock and host-helper settlement names are
re-exported unchanged so product leaves (smux) reach the host only through
`std.sosix.host`.
"""
use std.nogc_sync_mut.io_runtime.{env_set_process}
export use std.nogc_sync_mut.cli.cli_util.{get_cli_args as sosix_get_cli_args}
export use std.nogc_sync_mut.io.file_ops.{file_exists as sosix_file_exists}
# file_read's owner is io_runtime; io.file_ops only imports it privately, so
# re-exporting it from file_ops left `sosix_file_read` unresolved natively.
export use std.nogc_sync_mut.io_runtime.{file_read as sosix_file_read}
export use std.nogc_sync_mut.io.file_ops.{file_write as sosix_file_write}
export use std.nogc_sync_mut.io.sysinfo_ops.{getpid as sosix_getpid}
export use std.nogc_sync_mut.io_runtime.{platform_name as sosix_platform_name}
export use std.nogc_sync_mut.io.retained_file.{RetainedPrivateCredentialV1,
    retained_private_credential_open_v1, retained_private_credential_read_v1,
    retained_private_credential_publish_v1, retained_private_credential_close_v1}
export use std.nogc_sync_mut.io.file_lock_owned_v2.{FileLockReleaseStateV2}
export use std.nogc_sync_mut.orchestration.host_helper_settlement_v1.{HostHelperSettlementAckV1}
export use std.nogc_async_mut.container.terminal_session_v1.{ContainerPrimaryAttachSessionV1}

# Synchronous twin of std.nogc_async_mut.sosix.environment.sosix_env_set:
# same C-string admission (no NUL; key nonempty without '=').
pub fn sosix_env_set(key: text, value: text) -> bool:
    if key == "" or key.contains("=") or key.contains("\0") or value.contains("\0"):
        return false
    env_set_process(key, value)

# Versioned retained credential owner; platform selection remains in its owner.
export use std.nogc_sync_mut.io.retained_private_credential_v2.{RetainedPrivateCredentialV2,
    RetainedPrivateCredentialOpenTurnV2, RetainedPrivateCredentialStateTurnV2,
    RetainedPrivateCredentialReadTurnV2, RetainedPrivateCredentialMutationTurnV2,
    retained_private_credential_open_v2, retained_private_credential_state_v2, retained_private_credential_read_v2,
    retained_private_credential_publish_v2, retained_private_credential_close_v2}

# Orchestrator-controller host routes (src/app/orchestrator/**). Exact owner
# functions re-exported unchanged (same name, same function, same sentinels),
# so the controller reaches the host only through SOSIX. Raw argv keeps the
# caller's own launcher stripping; it is NOT the normalized sosix_get_cli_args.
# Record: doc/08_tracking/bug/orchestrator_controller_host_access_bypassed_sosix_2026-11-22.md
export use std.nogc_sync_mut.sffi.cli_args.{cli_get_args}
export use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded, file_is_regular_no_follow,
    file_atomic_write, file_remove, file_create_exclusive, secure_temp_dir}
export use std.nogc_sync_mut.io_runtime.{dir_exists, file_read_bytes_result}
export use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_list, dir_remove, dir_remove_all, dir_is_real_no_follow}
export use std.nogc_sync_mut.io.env_ops.{env_get, home}
export use std.nogc_sync_mut.file_system.metadata.{file_mode_bits}
# POSIX chmod; provider owner is package_sffi (no other SOSIX mode-setting owner exists).
export use std.nogc_sync_mut.package_sffi.{set_permissions}
