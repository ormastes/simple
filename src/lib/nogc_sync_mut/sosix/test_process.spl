"""Hosted SOSIX boundary for test children and their capture files.

Provider ownership remains in process_ops: POSIX children use its PID owner;
Windows capture uses its tagged JobObject owner. This boundary selects and
executes the capture strategy without promising POSIX tree containment.
"""

use std.nogc_sync_mut.io.process_ops.{process_spawn_async, process_spawn_redirected, process_run_bounded, process_spawn_session, process_kill_tree_support}
use std.nogc_sync_mut.io.env_ops.{env_get, host_os, host_is_simpleos}
use std.nogc_sync_mut.io.windows_redirected_process.{WINDOWS_REDIRECTED_TOKEN_BASE}
use std.nogc_sync_mut.io.process_ops.{eprint}
use std.nogc_sync_mut.fs.host_path.{host_is_windows_host}
export use std.nogc_sync_mut.io.windows_redirected_process.{
    windows_redirected_completion as sosix_test_process_completion,
    windows_redirected_failure_reason as sosix_test_process_failure_reason
}

fn sosix_test_owned_capture() -> bool:
    # Cached runtime platform guard: this runs per child spawn, so it must not
    # fall back to host_os()'s uncached `uname -s` probe.
    host_is_windows_host()

fn sosix_test_host_os() -> text:
    host_os()

fn sosix_test_has_owned_completion(token: i64) -> bool:
    token >= WINDOWS_REDIRECTED_TOKEN_BASE

fn sosix_test_is_simpleos() -> bool:
    host_is_simpleos()

var _sosix_test_temp_dir_cache: text = ""

fn sosix_test_temp_dir_realpath(path: text) -> text:
    """Symlink-resolved directory via `pwd -P`, or "" on failure.

    rt_file_canonicalize only normalizes lexically in the native runtimes, so
    it cannot resolve macOS /tmp -> /private/tmp; the shell is the portable
    POSIX realpath here. Called once per process (cached by the caller)."""
    val (out, _err, code) = process_run_bounded("/bin/sh",
        ["-c", "cd -- \"$1\" && pwd -P", "sh", path], 10000, 4096)
    if code != 0: return ""
    out.trim()

fn sosix_test_temp_dir() -> text:
    # Hot path (every runner temp file): the cache is checked before any host
    # probe, and the Windows guard is the cached host_is_windows_host(), never
    # the uncached host_os() `uname -s` spawn.
    val raw = (env_get("TMPDIR") ?? "").trim()
    val temp = if raw != "": raw else: "/tmp"
    if _sosix_test_temp_dir_cache != "" and _sosix_test_temp_dir_cache.starts_with(temp + "\n"):
        return _sosix_test_temp_dir_cache[temp.len() + 1:]
    if host_is_windows_host():
        # Windows TEMP is NOT long-name canonicalized (8.3 names such as
        # RUNNER~1 survive); documented pending item.
        val win_temp = (env_get("TEMP") ?? "").trim()
        if win_temp != "": return win_temp
        return "C:/Windows/Temp"
    if host_is_simpleos():
        # No hosted /bin/sh to resolve with; the path is used as given.
        return temp
    val resolved = sosix_test_temp_dir_realpath(temp)
    if resolved == "":
        eprint("[sosix] temp dir '" + temp + "' could not be resolved to a canonical path; using it unresolved")
        return temp
    _sosix_test_temp_dir_cache = temp + "\n" + resolved
    resolved

fn sosix_test_path_separator() -> text:
    if sosix_test_owned_capture(): return "\\"
    "/"

fn sosix_test_spawn_plan(binary: text, args: [text], stdout_path: text,
        stderr_path: text) -> (bool, text, [text]):
    if sosix_test_owned_capture():
        return (true, binary, args)
    val script = "out=$1; err=$2; shift 2; exec \"$@\" >\"$out\" 2>\"$err\""
    var shell_args = ["-c", script, "simple-test", stdout_path, stderr_path, binary]
    for arg in args:
        shell_args.push(arg)
    (false, "/bin/sh", shell_args)

# The caller owns scheduler admission and tracking; the provider owns the token.
# Keep selection and execution together so callers cannot launch a Windows
# capture plan through the unredirected process API.
var _sosix_unowned_tree_warned: bool = false

fn sosix_test_spawn_capture(binary: text, args: [text], stdout_path: text,
        stderr_path: text, timeout_ms: i64, capture_limit: i64) -> i64:
    val (owned, program, launch_args) = sosix_test_spawn_plan(binary, args, stdout_path, stderr_path)
    if owned:
        return process_spawn_redirected(program, launch_args, stdout_path,
            stderr_path, timeout_ms, capture_limit)
    # POSIX: own the whole tree at spawn. /bin/sh execs the runner, so the
    # runner's pid is the session id and a timeout's process_kill_tree reaches
    # every descendant (runtime_process_tree.c). A host without the owner
    # (SimpleOS, any host with no arm) still launches the test, says so ONCE on
    # stderr, and process_kill_tree reports Err at the timeout. Never silent.
    #
    # Under the sampled bootstrap guard (SIMPLE_BOOTSTRAP_SESSION_ID/_EXEC) the
    # guard owns the session and kills by it; a test child detached into its
    # own session would escape that outer cleanup if this runner died first.
    # process_ops' sid wrapper refuses to detach there for the same reason, so
    # this path keeps the guard's contract and takes the unowned fallback.
    val under_bootstrap_guard = (env_get("SIMPLE_BOOTSTRAP_SESSION_ID") ?? "") != "" or (env_get("SIMPLE_BOOTSTRAP_SESSION_EXEC") ?? "") != ""
    val support: Result<(), text> = if under_bootstrap_guard: Err("the bootstrap session guard owns this session (SIMPLE_BOOTSTRAP_SESSION_*)") else: process_kill_tree_support()
    match support:
        case Ok(_):
            match process_spawn_session(program, launch_args):
                case Ok(pid):
                    return pid
                case Err(reason):
                    eprint("[sosix_test_spawn_capture] {reason}")
                    return -1
        case Err(reason):
            if not _sosix_unowned_tree_warned:
                _sosix_unowned_tree_warned = true
                eprint("[sosix_test_spawn_capture] test children are NOT tree-owned on this host: {reason}; a timed-out test's descendants may survive")
            return process_spawn_async(program, launch_args)
    -1
