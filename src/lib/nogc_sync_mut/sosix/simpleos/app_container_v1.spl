# SOSIX app sandbox: simpleos variant. Typed refusal until this host's lane defines its
# mechanism; nothing here ever reports a run (architecture 4.2).
use std.common.contracts.sosix.containment_v1.{SosixContainExitCodeV1, SosixContainFlagV1}
use std.nogc_sync_mut.sosix.app_container_types_v1.{SosixAppSandboxRequestV1, SosixAppSandboxResultV1, SOSIX_APP_SANDBOX_IDENTITY_V1}

pub fn sosix_app_sandbox_identity_v1() -> text:
    SOSIX_APP_SANDBOX_IDENTITY_V1

pub fn sosix_app_sandbox_run_v1(request: SosixAppSandboxRequestV1) -> SosixAppSandboxResultV1:
    SosixAppSandboxResultV1(reason: "app-sandbox-unimplemented-simpleos", exit_code: SosixContainExitCodeV1(-1),
        timed_out: SosixContainFlagV1(false))
