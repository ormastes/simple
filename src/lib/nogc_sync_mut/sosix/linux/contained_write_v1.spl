# Contained write and read grants: linux variant. Typed refusal until this host's lane
# defines its grant; a grant is never reported by default (architecture 4.4).

pub fn sosix_fs_grant_contained_write_v1(empty_dir: text, scope: text) -> text:
    "contained-write-unimplemented-linux"

pub fn sosix_fs_grant_contained_read_v1(tree: text) -> text:
    "contained-read-unimplemented-linux"
