# SOSIX app sandbox: host-neutral facade (architecture pure_simple_container 4.2, lane W2).
# One import switch over the per-OS variant files; every variant exports the same two names.
@when(os="windows"):
use std.nogc_sync_mut.sosix.windows.app_container_v1.{sosix_app_sandbox_identity_v1 as _variant_identity, sosix_app_sandbox_run_v1 as _variant_run}
@elif(os="linux"):
use std.nogc_sync_mut.sosix.linux.app_container_v1.{sosix_app_sandbox_identity_v1 as _variant_identity, sosix_app_sandbox_run_v1 as _variant_run}
@elif(os="macos"):
use std.nogc_sync_mut.sosix.macos.app_container_v1.{sosix_app_sandbox_identity_v1 as _variant_identity, sosix_app_sandbox_run_v1 as _variant_run}
@elif(os="freebsd"):
use std.nogc_sync_mut.sosix.freebsd.app_container_v1.{sosix_app_sandbox_identity_v1 as _variant_identity, sosix_app_sandbox_run_v1 as _variant_run}
@else:
use std.nogc_sync_mut.sosix.simpleos.app_container_v1.{sosix_app_sandbox_identity_v1 as _variant_identity, sosix_app_sandbox_run_v1 as _variant_run}
@end
use std.nogc_sync_mut.sosix.app_container_types_v1.{SosixAppSandboxRequestV1, SosixAppSandboxResultV1}

# "app-sandbox" on every host; the mechanism behind it is the variant's.
pub fn sosix_app_sandbox_identity_v1() -> text:
    _variant_identity()

pub fn sosix_app_sandbox_run_v1(request: SosixAppSandboxRequestV1) -> SosixAppSandboxResultV1:
    _variant_run(request)
