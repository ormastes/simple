"""Synchronous SOSIX aliases over the selected interactive console capability.

Preserve provider availability, exclusive console ownership, restoration,
clipboard errors and cleanup. No Win32 handle or pointer is introduced here.
"""
export use std.sys.terminal_console.{
    open as sosix_console_open,
    read as sosix_console_read,
    size as sosix_console_size,
    write as sosix_console_write,
    close as sosix_console_close,
    cleanup as sosix_console_cleanup,
    clipboard_write as sosix_console_clipboard_write
}
