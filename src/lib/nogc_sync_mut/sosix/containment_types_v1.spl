# Value types and the pinned probe digest shared by the SOSIX containment facade
# and its per-OS variant bodies (architecture pure_simple_container 4.2). They
# live here, not in the facade, so a variant never imports the facade that
# imports it; the facade re-exports every name. Bool-backed units are always
# truthy: every condition reads .value.
use std.common.contracts.sosix.containment_v1.{SosixContainBytesV1, SosixContainMillisV1, SosixContainFlagV1}

# sha256 of src/lib/nogc_sync_mut/sosix/contain_canary_probe.spl, checked by every
# qualify run and pinned by the containment spec.
pub const SOSIX_CONTAIN_CANARY_PROBE_SHA256_V1 = "0807d1358de1f373626a3d1034f86eae65d7da4a14a8a73fa3ec326ebee61da5"

pub struct SosixContainMemoryProbeV1:
    program: text
    program_digest: text
    under_args: [text]
    over_args: [text]
    cap: SosixContainBytesV1
    work_dir: text
    wall: SosixContainMillisV1

pub struct SosixContainMemoryEvidenceV1:
    enforced: SosixContainFlagV1
    evidence_digest: text
    reason: text

export SOSIX_CONTAIN_CANARY_PROBE_SHA256_V1, SosixContainMemoryProbeV1, SosixContainMemoryEvidenceV1
