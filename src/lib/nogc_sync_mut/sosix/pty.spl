"""Synchronous SOSIX aliases over the selected public PTY capability.

std.sys.pty still selects the native provider. Handles, input completion,
resize availability and pending teardown retain that provider's contract.
"""
export use std.sys.pty.{
    open as sosix_pty_open,
    spawn as sosix_pty_spawn,
    spawn_configured_v1 as sosix_pty_spawn_configured_v1,
    configured_launch_probe_v1 as sosix_pty_configured_launch_probe_v1,
    literal_bytes_supported_v1 as sosix_pty_literal_bytes_supported_v1,
    write_literal_some_v1 as sosix_pty_write_literal_some_v1,
    write as sosix_pty_write,
    write_some as sosix_pty_write_some,
    input_pending as sosix_pty_input_pending,
    read as sosix_pty_read,
    close as sosix_pty_close,
    is_running as sosix_pty_is_running,
    hangup as sosix_pty_hangup,
    can_resize as sosix_pty_can_resize,
    resize as sosix_pty_resize,
    cleanup_pending as sosix_pty_cleanup_pending,
    exit_code as sosix_pty_exit_code
}
# Shell kinds (shs | native). `sosix_pty_default_shell` is the selected kind's
# command: shs on SimpleOS, native on hosts unless SIMPLE_PTY_SHELL=shs.
export use std.sys.pty_shell.{
    pty_default_shell_v1 as sosix_pty_default_shell,
    pty_shell_command_v1 as sosix_pty_shell_command_v1,
    PTY_SHELL_SHS as SOSIX_PTY_SHELL_SHS,
    PTY_SHELL_NATIVE as SOSIX_PTY_SHELL_NATIVE
}
export use std.sys.pty_launch.{PtyLaunchV1, PtyLaunchModeV1, PtyEnvironmentChangeV1}
