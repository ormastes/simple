#![allow(primitive_api)]
# Windows restricted identity for contained children (architecture 4.3).
# Restricted copy of the caller's own primary token: DISABLE_MAX_PRIVILEGE, restricting
# SIDs {Everyone, Users, logon SID, fixed reader SID, scope SID}, low integrity, and a
# default DACL of {scope SID, user, SYSTEM}. Needs no privilege. Windows-only; no facade.
use std.common.contracts.sosix.containment_v1.SosixContainFlagV1
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.sosix.windows.security_abi_v1.{sec_is_win64_v1, sec_alloc_v1, sec_free_v1, sec_local_free_v1, sec_close_handle_v1, sec_read_ptr_v1, sec_write_ptr_v1, sec_u8_v1, sec_u16_v1, sec_u32_v1, sec_put_u8_v1, sec_put_u32_v1, sec_sid_from_text_v1, sec_sid_len_v1, sec_sid_equal_v1, sec_open_process_token_v1, sec_token_info_v1, sec_set_token_info_v1, sec_create_restricted_v1, sec_set_entries_v1, sec_access_entry_v1, SEC_LOW_INTEGRITY_RID_V1}

pub unit SosixWindowsTokenV1: i64

# One fixed prefix; the scope SID is derived from sha256(scope) under it and names no account.
const _SID_PREFIX = "S-1-5-21-1936224305"
const _TOKEN_USER = 1
const _TOKEN_GROUPS = 2
const _TOKEN_DEFAULT_DACL = 6
const _TOKEN_RESTRICTED_SIDS = 11
const _TOKEN_INTEGRITY = 25
const _GENERIC_ALL = 0x10000000
const _WRITE_BITS = 0x50000006

fn _scope_ok(scope: text) -> bool:
    if scope.byte_len() < 1 or scope.byte_len() > 64: return false
    for byte in scope.bytes():
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 122) or byte == 45): return false
    true

fn _hex_value(byte: i64) -> i64:
    if byte >= 48 and byte <= 57: return byte - 48
    if byte >= 97 and byte <= 102: return byte - 87
    -1

# Four u32 values from the first 32 hex digits of sha256(scope); empty on a malformed digest.
fn _scope_words(scope: text) -> [i64]:
    val digest = sha256_text("sosix-scope-sid-v1:{scope}")
    var words: [i64] = []
    if digest.byte_len() < 32: return words
    var acc = 0
    var count = 0
    for byte in digest.bytes():
        if words.len() >= 4: break
        val value = _hex_value(byte)
        if value < 0: return []
        acc = acc * 16 + value
        count = count + 1
        if count == 8:
            words.push(acc)
            acc = 0
            count = 0
    words

pub fn sosix_windows_scope_sid_v1(scope: text) -> Result<text, text>:
    if not _scope_ok(scope): return Err("scope-invalid")
    val words = _scope_words(scope)
    if words.len() != 4: return Err("scope-digest-unavailable")
    Ok("{_SID_PREFIX}-2-{words[0]}-{words[1]}-{words[2]}-{words[3]}")

# The one fixed SID shared by every container; it only appears in read+execute ACEs.
pub fn sosix_windows_reader_sid_v1() -> text:
    "{_SID_PREFIX}-1"

fn _sid_copy(sid: i64, destination: i64):
    val length = sec_sid_len_v1(sid)
    var index = 0
    while index < length:
        sec_put_u8_v1(destination + index, sec_u8_v1(sid + index))
        index = index + 1

# SID pointer of the first TokenGroups entry whose attributes carry SE_GROUP_LOGON_ID; 0 if none.
# The pointer lives inside `groups`.
fn _logon_sid_in(groups: i64) -> i64:
    val count = sec_u32_v1(groups)
    var index = 0
    while index < count and index < 1024:
        val entry = groups + 8 + index * 16
        if (sec_u32_v1(entry + 8) & 0xC0000000) == 0xC0000000:
            return sec_read_ptr_v1(entry)
        index = index + 1
    0

# Flag true when the DACL grants write to Everyone, Users or the caller's logon SID.
# Reads every allow ACE; deny ACEs are ignored (conservative toward refusing).
pub fn sosix_windows_dacl_grants_world_write_v1(dacl: i64) -> Result<SosixContainFlagV1, text>:
    if dacl == 0: return Ok(SosixContainFlagV1(true))
    val token = sec_open_process_token_v1()
    if token == 0: return Err("token-open-failed")
    val groups = sec_token_info_v1(token, _TOKEN_GROUPS)
    val everyone = sec_sid_from_text_v1("S-1-1-0")
    val users = sec_sid_from_text_v1("S-1-5-32-545")
    var verdict = false
    var failed = groups == 0 or everyone == 0 or users == 0
    if not failed:
        val logon = _logon_sid_in(groups)
        val count = sec_u16_v1(dacl + 4)
        var ace = dacl + 8
        var index = 0
        while index < count and index < 4096:
            val kind = sec_u8_v1(ace)
            val size = sec_u16_v1(ace + 2)
            if size < 8:
                failed = true
                break
            if kind == 0 and (sec_u32_v1(ace + 4) & _WRITE_BITS) != 0:
                val sid = ace + 8
                if sec_sid_equal_v1(sid, everyone) or sec_sid_equal_v1(sid, users) or (logon != 0 and sec_sid_equal_v1(sid, logon)):
                    verdict = true
                    break
            ace = ace + size
            index = index + 1
    sec_local_free_v1(everyone)
    sec_local_free_v1(users)
    sec_free_v1(groups)
    val _closed = sec_close_handle_v1(token)
    if failed: return Err("dacl-unreadable")
    Ok(SosixContainFlagV1(verdict))

# Applies integrity, default DACL, and reads back integrity and restricting SIDs.
fn _harden(restricted: i64, scope_sid: i64, user_sid: i64) -> text:
    val low = sec_sid_from_text_v1("S-1-16-4096")
    if low == 0: return "integrity-sid-unavailable"
    val low_len = sec_sid_len_v1(low)
    val label = sec_alloc_v1(16 + low_len)
    var reason = ""
    if label == 0:
        reason = "token-alloc-failed"
    else:
        _sid_copy(low, label + 16)
        sec_write_ptr_v1(label, label + 16)
        sec_put_u32_v1(label + 8, 0x20)
        if not sec_set_token_info_v1(restricted, _TOKEN_INTEGRITY, label, 16 + low_len):
            reason = "token-integrity-set-failed"
    sec_free_v1(label)
    sec_local_free_v1(low)
    if reason != "": return reason
    val system = sec_sid_from_text_v1("S-1-5-18")
    val entries = sec_alloc_v1(3 * 48)
    if system == 0 or entries == 0:
        sec_local_free_v1(system)
        sec_free_v1(entries)
        return "token-alloc-failed"
    sec_access_entry_v1(entries, 0, _GENERIC_ALL, 0, scope_sid)
    sec_access_entry_v1(entries, 1, _GENERIC_ALL, 0, user_sid)
    sec_access_entry_v1(entries, 2, _GENERIC_ALL, 0, system)
    val acl = sec_set_entries_v1(3, entries, 0)
    if acl == 0:
        reason = "token-default-dacl-build-failed"
    else:
        val holder = sec_alloc_v1(8)
        if holder == 0:
            reason = "token-alloc-failed"
        else:
            sec_write_ptr_v1(holder, acl)
            if not sec_set_token_info_v1(restricted, _TOKEN_DEFAULT_DACL, holder, 8):
                reason = "token-default-dacl-set-failed"
        sec_free_v1(holder)
    sec_local_free_v1(acl)
    sec_free_v1(entries)
    sec_local_free_v1(system)
    reason

# Integrity RID reads back low, and restricting SIDs hold exactly five entries including scope.
fn _verify(restricted: i64, scope_sid: i64) -> text:
    val integrity = sec_token_info_v1(restricted, _TOKEN_INTEGRITY)
    if integrity == 0: return "token-integrity-readback-failed"
    val sid = sec_read_ptr_v1(integrity)
    var rid = 0
    if sid != 0:
        val subs = sec_u8_v1(sid + 1)
        if subs >= 1: rid = sec_u32_v1(sid + 8 + (subs - 1) * 4)
    sec_free_v1(integrity)
    if rid != SEC_LOW_INTEGRITY_RID_V1: return "token-integrity-not-low"
    val groups = sec_token_info_v1(restricted, _TOKEN_RESTRICTED_SIDS)
    if groups == 0: return "token-restricted-sids-readback-failed"
    var found = false
    val count = sec_u32_v1(groups)
    var index = 0
    while index < count and index < 64:
        if sec_sid_equal_v1(sec_read_ptr_v1(groups + 8 + index * 16), scope_sid): found = true
        index = index + 1
    sec_free_v1(groups)
    if count != 5 or not found: return "token-restricted-sids-mismatch"
    ""

pub fn sosix_windows_restricted_token_open_v1(scope: text) -> Result<SosixWindowsTokenV1, text>:
    if not sec_is_win64_v1(): return Err("windows-identity-unsupported-width")
    val scope_text = sosix_windows_scope_sid_v1(scope)?
    val base = sec_open_process_token_v1()
    if base == 0: return Err("token-open-failed")
    val user = sec_token_info_v1(base, _TOKEN_USER)
    val groups = sec_token_info_v1(base, _TOKEN_GROUPS)
    val everyone = sec_sid_from_text_v1("S-1-1-0")
    val users = sec_sid_from_text_v1("S-1-5-32-545")
    val reader = sec_sid_from_text_v1(sosix_windows_reader_sid_v1())
    val scope_sid = sec_sid_from_text_v1(scope_text)
    val restrict = sec_alloc_v1(5 * 16)
    var restricted = 0
    var reason = ""
    var logon = 0
    if user != 0 and groups != 0:
        logon = _logon_sid_in(groups)
    if user == 0 or groups == 0 or everyone == 0 or users == 0 or reader == 0 or scope_sid == 0 or restrict == 0:
        reason = "token-setup-failed"
    elif logon == 0:
        reason = "token-logon-sid-missing"
    else:
        sec_write_ptr_v1(restrict, everyone)
        sec_write_ptr_v1(restrict + 16, users)
        sec_write_ptr_v1(restrict + 32, logon)
        sec_write_ptr_v1(restrict + 48, reader)
        sec_write_ptr_v1(restrict + 64, scope_sid)
        restricted = sec_create_restricted_v1(base, 5, restrict)
        if restricted == 0:
            reason = "token-restrict-failed"
        else:
            reason = _harden(restricted, scope_sid, sec_read_ptr_v1(user))
            if reason == "":
                reason = _verify(restricted, scope_sid)
            if reason != "":
                val _c = sec_close_handle_v1(restricted)
                restricted = 0
    sec_free_v1(restrict)
    sec_local_free_v1(scope_sid)
    sec_local_free_v1(reader)
    sec_local_free_v1(users)
    sec_local_free_v1(everyone)
    sec_free_v1(groups)
    sec_free_v1(user)
    val _b = sec_close_handle_v1(base)
    if reason != "": return Err(reason)
    Ok(SosixWindowsTokenV1(restricted))

# True only when a live handle was closed; a second close answers false.
pub fn sosix_windows_restricted_token_close_v1(token: SosixWindowsTokenV1) -> SosixContainFlagV1:
    SosixContainFlagV1(sec_close_handle_v1(token.value))
