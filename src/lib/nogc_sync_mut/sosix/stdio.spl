"""Synchronous hosted SOSIX standard input and text-line output boundary.

Preserve tagged text and empty text at EOF. The optional-pointer stdin ABI is
different and must not replace this owner. Output preserves language print's
text conversion and newline lowering. No raw ABI is declared here.
"""
export use std.nogc_sync_mut.sffi.host.{read_stdin_line as sosix_read_stdin_line}

# Keep the language intrinsic: its lowering owns text-to-C-string conversion.
# A raw rt_println alias would assume the selected provider's foreign ABI.
@always_inline
pub fn sosix_println(message: text):
    print(message)
