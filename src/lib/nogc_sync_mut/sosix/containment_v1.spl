# SOSIX containment facade (architecture pure_simple_container 4.2): host-neutral
# entry points over one per-OS variant, chosen by a single import switch. No
# body and no other host test lives here; every variant exports the same names.
use std.common.contracts.sosix.containment_v1.{SosixContainRequestV1, SosixContainSupportV1, SosixContainAdmissionV1, SosixContainLeaseV1, SosixContainPollV1, SosixContainFlagV1, SosixContainQualifyRequestV1, SosixContainQualifyResultV1}
use std.nogc_sync_mut.sosix.containment_types_v1.{SOSIX_CONTAIN_CANARY_PROBE_SHA256_V1, SosixContainMemoryProbeV1, SosixContainMemoryEvidenceV1}
@when(os="windows"):
use std.nogc_sync_mut.sosix.windows.containment_v1.{sosix_contain_support_v1 as _v_support, sosix_contain_start_v1 as _v_start, sosix_contain_poll_v1 as _v_poll, sosix_contain_cancel_v1 as _v_cancel, sosix_contain_collect_v1 as _v_collect, sosix_contain_qualify_v1 as _v_qualify, sosix_contain_memory_cap_evidence_v1 as _v_memory}
@elif(os="linux"):
use std.nogc_sync_mut.sosix.linux.containment_v1.{sosix_contain_support_v1 as _v_support, sosix_contain_start_v1 as _v_start, sosix_contain_poll_v1 as _v_poll, sosix_contain_cancel_v1 as _v_cancel, sosix_contain_collect_v1 as _v_collect, sosix_contain_qualify_v1 as _v_qualify, sosix_contain_memory_cap_evidence_v1 as _v_memory}
@elif(os="macos"):
use std.nogc_sync_mut.sosix.macos.containment_v1.{sosix_contain_support_v1 as _v_support, sosix_contain_start_v1 as _v_start, sosix_contain_poll_v1 as _v_poll, sosix_contain_cancel_v1 as _v_cancel, sosix_contain_collect_v1 as _v_collect, sosix_contain_qualify_v1 as _v_qualify, sosix_contain_memory_cap_evidence_v1 as _v_memory}
@elif(os="freebsd"):
use std.nogc_sync_mut.sosix.freebsd.containment_v1.{sosix_contain_support_v1 as _v_support, sosix_contain_start_v1 as _v_start, sosix_contain_poll_v1 as _v_poll, sosix_contain_cancel_v1 as _v_cancel, sosix_contain_collect_v1 as _v_collect, sosix_contain_qualify_v1 as _v_qualify, sosix_contain_memory_cap_evidence_v1 as _v_memory}
@else:
use std.nogc_sync_mut.sosix.simpleos.containment_v1.{sosix_contain_support_v1 as _v_support, sosix_contain_start_v1 as _v_start, sosix_contain_poll_v1 as _v_poll, sosix_contain_cancel_v1 as _v_cancel, sosix_contain_collect_v1 as _v_collect, sosix_contain_qualify_v1 as _v_qualify, sosix_contain_memory_cap_evidence_v1 as _v_memory}
@end

pub fn sosix_contain_support_v1() -> SosixContainSupportV1:
    _v_support()

pub fn sosix_contain_start_v1(request: SosixContainRequestV1) -> SosixContainAdmissionV1:
    _v_start(request)

pub fn sosix_contain_poll_v1(lease: SosixContainLeaseV1) -> Result<SosixContainPollV1, text>:
    _v_poll(lease)

pub fn sosix_contain_cancel_v1(lease: SosixContainLeaseV1) -> Result<SosixContainFlagV1, text>:
    _v_cancel(lease)

pub fn sosix_contain_collect_v1(lease: SosixContainLeaseV1) -> Result<SosixContainPollV1, text>:
    _v_collect(lease)

pub fn sosix_contain_qualify_v1(request: SosixContainQualifyRequestV1) -> SosixContainQualifyResultV1:
    _v_qualify(request)

pub fn sosix_contain_memory_cap_evidence_v1(probe: SosixContainMemoryProbeV1) -> SosixContainMemoryEvidenceV1:
    _v_memory(probe)

export SOSIX_CONTAIN_CANARY_PROBE_SHA256_V1, SosixContainMemoryProbeV1, SosixContainMemoryEvidenceV1
