# codex-impl

use std.tiny.common.status.{TinyStatus, TINY_ERR_CAPACITY, TINY_ERR_INVALID}
use std.tiny.common.types.{TinyHandle, TinyRect}
use std.tiny.gui.component.{tiny_component_metadata, TINY_COMPONENT_FLAG_FOCUSABLE, TINY_COMPONENT_FLAG_SCROLLABLE, TINY_COMPONENT_COLUMN, TINY_COMPONENT_LIST, TINY_COMPONENT_ROW, TINY_COMPONENT_SCROLL_PANE, TINY_COMPONENT_STACK}
use std.tiny.pane.model.{TinyResolvedPane, TINY_PANE_VISIBLE, TINY_PANE_ENABLED, TINY_PANE_FOCUSABLE, TINY_PANE_POINTER}

# Layout scan-cost oracle (A04).
#
# `resolved_panes` and `direct_child_extent_y` are the two node-scanning
# paths in Tiny layout. Every node visited while locating a parent, while
# accumulating a sibling flow offset, while clearing the per-pass flow
# scratch, or while reading the per-parent metadata counts as one step. The
# counter is module state, read and reset through the two free functions
# below; it never affects geometry.
var _tiny_layout_scan_steps = 0

fn tiny_layout_scan_steps() -> i32:
    """Number of layout node-scan steps performed since the last reset."""
    return _tiny_layout_scan_steps

fn tiny_layout_scan_reset() -> i32:
    """Reset the layout scan-step counter and return the value it had."""
    val previous = _tiny_layout_scan_steps
    _tiny_layout_scan_steps = 0
    return previous

class TinyGuiNode:
    id: TinyHandle
    parent: TinyHandle
    class_id: i32
    bounds: TinyRect
    flags: i32
    text_value: text
    value: i32

class TinyGuiState:
    nodes: [TinyGuiNode]
    max_nodes: i32
    focused_index: i32
    next_generation: i32
    # Private layout metadata (A04). Every array below is allocated once in
    # `bounded` with exactly `max_nodes` entries and is never grown, so the
    # layout pass performs no post-init allocation. `child_count`,
    # `child_extent_y` and `child_ordinal` are computed by `resolved_panes`
    # under exactly the historical child-matching condition, and are readable
    # only while `metadata_valid()` answers true — any mutation of `nodes`
    # afterwards invalidates them, and every reader falls back to a full scan.
    # They are deliberately NOT maintained by `add`: `add` can only see the
    # append-ordered subset of the historical condition, so an `add`-built
    # cache diverges from the oracle as soon as a node is edited in place.
    # `flow_x` / `flow_y` are per-pass scratch cleared at the top of the pass.
    child_count: [i32]
    child_extent_y: [i32]
    child_ordinal: [i32]
    flow_x: [i32]
    flow_y: [i32]
    metadata_nodes: i32

    static fn bounded(max_nodes: i32) -> TinyGuiState:
        val capacity = if max_nodes > 0: max_nodes else: 0
        TinyGuiState(
            nodes: [], max_nodes: max_nodes, focused_index: -1, next_generation: 1,
            child_count: [0; capacity], child_extent_y: [0; capacity], child_ordinal: [0; capacity],
            flow_x: [0; capacity], flow_y: [0; capacity], metadata_nodes: 0,
        )

    fn metadata_valid() -> bool:
        """True when the per-parent metadata still describes `nodes`.

        `add` is the only sanctioned mutation boundary. A direct push into the
        public `nodes` array leaves `metadata_nodes` behind the node count, and
        every metadata reader then falls back to the historical full scan.
        """
        if self.metadata_nodes < 0: return false
        if self.metadata_nodes != self.nodes.len(): return false
        self.nodes.len() <= self.child_count.len()

    fn child_ordinal_of(index: i32) -> i32:
        """Zero-based position of `index` among its parent's direct children.

        Answers -1 for an out-of-range index, for a node the last layout pass
        did not attach to a parent (root, dead generation, forward reference),
        and whenever `metadata_valid()` is false — callers must treat -1 as
        "this node has no cached ordinal", never as ordinal zero.
        """
        if index < 0 or index >= self.nodes.len(): return -1
        if not self.metadata_valid(): return -1
        self.child_ordinal[index]

    me add(parent: TinyHandle, class_id: i32, bounds: TinyRect, text_value: text) -> TinyStatus:
        if tiny_component_metadata(class_id) == nil:
            return TinyStatus.error(TINY_ERR_INVALID, class_id)
        if bounds.width < 0 or bounds.height < 0:
            return TinyStatus.error(TINY_ERR_INVALID, class_id)
        if self.nodes.len() >= self.max_nodes:
            return TinyStatus.error(TINY_ERR_CAPACITY, self.nodes.len())
        if parent.is_valid() and (parent.index >= self.nodes.len() or self.nodes[parent.index].id.generation != parent.generation):
            return TinyStatus.error(TINY_ERR_INVALID, parent.index)
        val id = TinyHandle(index: self.nodes.len(), generation: self.next_generation)
        self.next_generation = self.next_generation + 1
        self.nodes.push(TinyGuiNode(id: id, parent: parent, class_id: class_id, bounds: bounds, flags: 0, text_value: text_value, value: 0))
        self.metadata_nodes = -1
        TinyStatus.ok()

    fn handle_at(index: i32) -> TinyHandle:
        if index < 0 or index >= self.nodes.len(): return TinyHandle.invalid()
        self.nodes[index].id

    fn focused() -> TinyHandle:
        self.handle_at(self.focused_index)

    fn direct_child_count(parent_index: i32) -> i32:
        if parent_index < 0 or parent_index >= self.nodes.len(): return 0
        if self.metadata_valid():
            _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
            return self.child_count[parent_index]
        var count = 0
        for node in self.nodes:
            _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
            if node.parent.is_valid() and node.parent.index == parent_index and node.parent.generation == self.nodes[parent_index].id.generation:
                count = count + 1
        count

    fn direct_child_extent_y(parent_index: i32) -> i32:
        if parent_index < 0 or parent_index >= self.nodes.len(): return 0
        if self.metadata_valid():
            _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
            return self.child_extent_y[parent_index]
        var extent = 0
        for node in self.nodes:
            _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
            if node.parent.is_valid() and node.parent.index == parent_index and node.parent.generation == self.nodes[parent_index].id.generation:
                if node.bounds.height > 2147483647 - extent: return 2147483647
                extent = extent + node.bounds.height
        extent

    fn resolved_panes(viewport: TinyRect) -> [TinyResolvedPane]:
        var panes: [TinyResolvedPane] = []
        val count = self.nodes.len()
        # `add` gives every node its own array index, so a parent that exists
        # is always addressable directly. The indexed path is taken only while
        # the scratch arrays can cover the live node count; a direct push into
        # the public `nodes` array falls back to the historical scan.
        # The identity probe in the clearing loop is what makes the direct
        # lookup exact: the historical scan matched `panes[i].id.index`, so a
        # node whose handle no longer names its own slot must take the scan.
        var indexed = count <= self.flow_x.len()
        if indexed:
            var reset_index = 0
            while reset_index < count:
                _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
                self.flow_x[reset_index] = 0
                self.flow_y[reset_index] = 0
                self.child_count[reset_index] = 0
                self.child_extent_y[reset_index] = 0
                self.child_ordinal[reset_index] = -1
                if self.nodes[reset_index].id.index != reset_index:
                    indexed = false
                reset_index = reset_index + 1
        var node_index = 0
        while node_index < count:
            val node = self.nodes[node_index]
            var pane_flags = TINY_PANE_VISIBLE + TINY_PANE_ENABLED
            if val metadata = tiny_component_metadata(node.class_id):
                if metadata.flags & TINY_COMPONENT_FLAG_FOCUSABLE != 0:
                    pane_flags = pane_flags + TINY_PANE_FOCUSABLE + TINY_PANE_POINTER
                elif metadata.flags & TINY_COMPONENT_FLAG_SCROLLABLE != 0:
                    pane_flags = pane_flags + TINY_PANE_POINTER
            var resolved = TinyResolvedPane.root(
                node.id, node.bounds, viewport, node.id.index,
                pane_flags,
                node.id.index,
            )
            if node.parent.is_valid():
                var parent_index = -1
                if indexed:
                    _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
                    if node.parent.index >= 0 and node.parent.index < node_index and self.nodes[node.parent.index].id.generation == node.parent.generation:
                        parent_index = node.parent.index
                else:
                    var i = 0
                    while i < panes.len():
                        _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
                        if panes[i].id.index == node.parent.index and panes[i].id.generation == node.parent.generation:
                            parent_index = i
                        i = i + 1
                if parent_index >= 0:
                    val parent_node = self.nodes[node.parent.index]
                    var local = node.bounds
                    if parent_node.class_id == TINY_COMPONENT_STACK:
                        local = TinyRect(x: node.bounds.x, y: node.bounds.y, width: node.bounds.width, height: node.bounds.height)
                    if parent_node.class_id == TINY_COMPONENT_ROW:
                        var flow_x = 0
                        if indexed:
                            flow_x = self.flow_x[node.parent.index]
                        else:
                            var sibling_index = 0
                            while sibling_index < node_index:
                                _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
                                val sibling = self.nodes[sibling_index]
                                if sibling.parent.is_valid() and sibling.parent.index == node.parent.index and sibling.parent.generation == node.parent.generation:
                                    flow_x = flow_x + sibling.bounds.width
                                sibling_index = sibling_index + 1
                        local = TinyRect(x: flow_x, y: 0, width: node.bounds.width, height: node.bounds.height)
                    if parent_node.class_id == TINY_COMPONENT_COLUMN or parent_node.class_id == TINY_COMPONENT_LIST or parent_node.class_id == TINY_COMPONENT_SCROLL_PANE:
                        var flow_y = 0
                        if indexed:
                            flow_y = self.flow_y[node.parent.index]
                        else:
                            var sibling_index = 0
                            while sibling_index < node_index:
                                _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
                                val sibling = self.nodes[sibling_index]
                                if sibling.parent.is_valid() and sibling.parent.index == node.parent.index and sibling.parent.generation == node.parent.generation:
                                    flow_y = flow_y + sibling.bounds.height
                                sibling_index = sibling_index + 1
                        val inset_x = if parent_node.class_id == TINY_COMPONENT_LIST: 2 else: 0
                        local = TinyRect(x: inset_x, y: flow_y, width: node.bounds.width, height: node.bounds.height)
                    val scroll_y = if parent_node.class_id == TINY_COMPONENT_SCROLL_PANE: parent_node.value else: 0
                    resolved = panes[parent_index].resolve_child(
                        node.id, local, TinyRect.empty(), 0, scroll_y, node.id.index,
                        pane_flags,
                        node.id.index,
                    )
            panes.push(resolved)
            if indexed and node.parent.is_valid():
                _tiny_layout_scan_steps = _tiny_layout_scan_steps + 1
                val accumulate_slot = node.parent.index
                if accumulate_slot >= 0 and accumulate_slot < count and self.nodes[accumulate_slot].id.generation == node.parent.generation:
                    self.flow_x[accumulate_slot] = self.flow_x[accumulate_slot] + node.bounds.width
                    self.flow_y[accumulate_slot] = self.flow_y[accumulate_slot] + node.bounds.height
                    self.child_ordinal[node_index] = self.child_count[accumulate_slot]
                    self.child_count[accumulate_slot] = self.child_count[accumulate_slot] + 1
                    if self.child_extent_y[accumulate_slot] != 2147483647:
                        if node.bounds.height > 2147483647 - self.child_extent_y[accumulate_slot]:
                            self.child_extent_y[accumulate_slot] = 2147483647
                        else:
                            self.child_extent_y[accumulate_slot] = self.child_extent_y[accumulate_slot] + node.bounds.height
            node_index = node_index + 1
        if indexed:
            self.metadata_nodes = count
        else:
            self.metadata_nodes = -1
        panes

    me focus_next() -> TinyStatus:
        if self.nodes.len() == 0:
            return TinyStatus.error(TINY_ERR_INVALID, 0)
        var scanned = 0
        var index = self.focused_index
        while scanned < self.nodes.len():
            index = (index + 1) % self.nodes.len()
            val metadata = tiny_component_metadata(self.nodes[index].class_id)
            if val item = metadata:
                if item.flags & TINY_COMPONENT_FLAG_FOCUSABLE != 0:
                    self.focused_index = index
                    return TinyStatus.ok()
            scanned = scanned + 1
        TinyStatus.error(TINY_ERR_INVALID, self.nodes.len())
