# codex-impl

use std.tiny.common.event.{TinyEvent, TINY_EVENT_KEY, TINY_EVENT_POINTER_DOWN, TINY_EVENT_TEXT, TINY_EVENT_WHEEL}
use std.tiny.common.status.{TinyStatus, TINY_ERR_CAPACITY, TINY_ERR_INVALID, TINY_ERR_UNSUPPORTED}
use std.tiny.common.types.{TinyHandle, TinyPoint, TinyRect, tiny_contains}
use std.tiny.gui.component.{tiny_component_metadata, TINY_COMPONENT_BUTTON, TINY_COMPONENT_CHECKBOX, TINY_COMPONENT_FLAG_FOCUSABLE, TINY_COMPONENT_FLAG_SCROLLABLE, TINY_COMPONENT_COLUMN, TINY_COMPONENT_LIST, TINY_COMPONENT_ROW, TINY_COMPONENT_SCROLL_PANE, TINY_COMPONENT_STACK, TINY_COMPONENT_TEXT_INPUT}
use std.tiny.pane.model.{TinyResolvedPane, TINY_PANE_VISIBLE, TINY_PANE_ENABLED, TINY_PANE_FOCUSABLE, TINY_PANE_POINTER}
use std.tiny.pane.hit_test.{tiny_hit_test_counted}

const TINY_KEY_TAB: i32 = 9
const TINY_KEY_ENTER: i32 = 13
const TINY_KEY_UP: i32 = 38
const TINY_KEY_DOWN: i32 = 40

class TinyGuiDispatchReceipt:
    status: TinyStatus
    target_index: i32
    action_id: i32
    changed: bool

class TinyGuiNode:
    id: TinyHandle
    parent: TinyHandle
    class_id: i32
    bounds: TinyRect
    flags: i32
    text_value: text
    value: i32

    static fn empty() -> TinyGuiNode:
        TinyGuiNode(
            id: TinyHandle.invalid(), parent: TinyHandle.invalid(), class_id: 0,
            bounds: TinyRect.empty(), flags: 0, text_value: "", value: 0,
        )

class TinyGuiState:
    nodes: [TinyGuiNode]
    node_count: i32
    pane_slots: [TinyResolvedPane]
    pane_count: i32
    max_nodes: i32
    focused_index: i32
    next_generation: i32
    allocation_count: i32
    reuse_count: i32

    static fn bounded(max_nodes: i32) -> TinyGuiState:
        var nodes: [TinyGuiNode] = []
        var panes: [TinyResolvedPane] = []
        var index = 0
        while index < max_nodes:
            nodes.push(TinyGuiNode.empty())
            panes.push(TinyResolvedPane.empty())
            index = index + 1
        TinyGuiState(
            nodes: nodes, node_count: 0, pane_slots: panes, pane_count: 0,
            max_nodes: max_nodes, focused_index: -1, next_generation: 1,
            allocation_count: 2, reuse_count: 0,
        )

    me reset():
        self.node_count = 0
        self.pane_count = 0
        self.focused_index = -1
        self.reuse_count = self.reuse_count + 1

    me add(parent: TinyHandle, class_id: i32, bounds: TinyRect, text_value: text) -> TinyStatus:
        if tiny_component_metadata(class_id) == nil:
            return TinyStatus.error(TINY_ERR_INVALID, class_id)
        if bounds.width < 0 or bounds.height < 0:
            return TinyStatus.error(TINY_ERR_INVALID, class_id)
        if self.node_count >= self.max_nodes:
            return TinyStatus.error(TINY_ERR_CAPACITY, self.node_count)
        if parent.is_valid() and (parent.index >= self.node_count or self.nodes[parent.index].id.generation != parent.generation):
            return TinyStatus.error(TINY_ERR_INVALID, parent.index)
        val id = TinyHandle(index: self.node_count, generation: self.next_generation)
        self.next_generation = self.next_generation + 1
        self.nodes[self.node_count] = TinyGuiNode(id: id, parent: parent, class_id: class_id, bounds: bounds, flags: 0, text_value: text_value, value: 0)
        self.node_count = self.node_count + 1
        TinyStatus.ok()

    fn handle_at(index: i32) -> TinyHandle:
        if index < 0 or index >= self.node_count: return TinyHandle.invalid()
        self.nodes[index].id

    fn focused() -> TinyHandle:
        self.handle_at(self.focused_index)

    fn direct_child_count(parent_index: i32) -> i32:
        if parent_index < 0 or parent_index >= self.node_count: return 0
        var count = 0
        var node_index = 0
        while node_index < self.node_count:
            val node = self.nodes[node_index]
            if node.parent.is_valid() and node.parent.index == parent_index and node.parent.generation == self.nodes[parent_index].id.generation:
                count = count + 1
            node_index = node_index + 1
        count

    fn direct_child_extent_y(parent_index: i32) -> i32:
        if parent_index < 0 or parent_index >= self.node_count: return 0
        var extent = 0
        var node_index = 0
        while node_index < self.node_count:
            val node = self.nodes[node_index]
            if node.parent.is_valid() and node.parent.index == parent_index and node.parent.generation == self.nodes[parent_index].id.generation:
                if node.bounds.height > 2147483647 - extent: return 2147483647
                extent = extent + node.bounds.height
            node_index = node_index + 1
        extent

    me resolve_panes(viewport: TinyRect) -> TinyStatus:
        self.pane_count = 0
        self.reuse_count = self.reuse_count + 1
        var node_index = 0
        while node_index < self.node_count:
            val node = self.nodes[node_index]
            var pane_flags = TINY_PANE_VISIBLE + TINY_PANE_ENABLED
            if val metadata = tiny_component_metadata(node.class_id):
                if metadata.flags & TINY_COMPONENT_FLAG_FOCUSABLE != 0:
                    pane_flags = pane_flags + TINY_PANE_FOCUSABLE + TINY_PANE_POINTER
                elif metadata.flags & TINY_COMPONENT_FLAG_SCROLLABLE != 0:
                    pane_flags = pane_flags + TINY_PANE_POINTER
            var resolved = TinyResolvedPane.root(
                node.id, node.bounds, viewport, node.id.index,
                pane_flags,
                node.id.index,
            )
            if node.parent.is_valid():
                var parent_index = -1
                var i = 0
                while i < self.pane_count:
                    if self.pane_slots[i].id.index == node.parent.index and self.pane_slots[i].id.generation == node.parent.generation:
                        parent_index = i
                    i = i + 1
                if parent_index >= 0:
                    val parent_node = self.nodes[node.parent.index]
                    var local = node.bounds
                    if parent_node.class_id == TINY_COMPONENT_STACK:
                        local = TinyRect(x: node.bounds.x, y: node.bounds.y, width: node.bounds.width, height: node.bounds.height)
                    if parent_node.class_id == TINY_COMPONENT_ROW:
                        var flow_x = 0
                        var sibling_index = 0
                        while sibling_index < node_index:
                            val sibling = self.nodes[sibling_index]
                            if sibling.parent.is_valid() and sibling.parent.index == node.parent.index and sibling.parent.generation == node.parent.generation:
                                flow_x = flow_x + sibling.bounds.width
                            sibling_index = sibling_index + 1
                        local = TinyRect(x: flow_x, y: 0, width: node.bounds.width, height: node.bounds.height)
                    if parent_node.class_id == TINY_COMPONENT_COLUMN or parent_node.class_id == TINY_COMPONENT_LIST or parent_node.class_id == TINY_COMPONENT_SCROLL_PANE:
                        var flow_y = 0
                        var sibling_index = 0
                        while sibling_index < node_index:
                            val sibling = self.nodes[sibling_index]
                            if sibling.parent.is_valid() and sibling.parent.index == node.parent.index and sibling.parent.generation == node.parent.generation:
                                flow_y = flow_y + sibling.bounds.height
                            sibling_index = sibling_index + 1
                        val inset_x = if parent_node.class_id == TINY_COMPONENT_LIST: 2 else: 0
                        local = TinyRect(x: inset_x, y: flow_y, width: node.bounds.width, height: node.bounds.height)
                    val scroll_y = if parent_node.class_id == TINY_COMPONENT_SCROLL_PANE: parent_node.value else: 0
                    resolved = self.pane_slots[parent_index].resolve_child(
                        node.id, local, TinyRect.empty(), 0, scroll_y, node.id.index,
                        pane_flags,
                        node.id.index,
                    )
            if self.pane_count >= self.max_nodes:
                return TinyStatus.error(TINY_ERR_CAPACITY, self.pane_count)
            self.pane_slots[self.pane_count] = resolved
            self.pane_count = self.pane_count + 1
            node_index = node_index + 1
        TinyStatus.ok()

    me resolved_panes(viewport: TinyRect) -> [TinyResolvedPane]:
        self.resolve_panes(viewport)
        self.pane_slots

    me focus_next() -> TinyStatus:
        if self.node_count == 0:
            return TinyStatus.error(TINY_ERR_INVALID, 0)
        var scanned = 0
        var index = self.focused_index
        while scanned < self.node_count:
            index = (index + 1) % self.node_count
            val metadata = tiny_component_metadata(self.nodes[index].class_id)
            if val item = metadata:
                if item.flags & TINY_COMPONENT_FLAG_FOCUSABLE != 0:
                    self.focused_index = index
                    return TinyStatus.ok()
            scanned = scanned + 1
        TinyStatus.error(TINY_ERR_INVALID, self.node_count)

    fn scroll_target(target: i32) -> i32:
        var candidate = target
        while candidate >= 0 and candidate < self.node_count:
            if self.nodes[candidate].class_id == TINY_COMPONENT_SCROLL_PANE: return candidate
            val parent = self.nodes[candidate].parent
            if not parent.is_valid(): return -1
            candidate = parent.index
        -1

    me list_item_at(list_index: i32, point: TinyPoint) -> i32:
        val resolved = self.resolve_panes(TinyRect(x: -1073741824, y: -1073741824, width: 2147483647, height: 2147483647))
        if not resolved.is_ok(): return -1
        var ordinal = 0
        var index = 0
        while index < self.node_count:
            val parent = self.nodes[index].parent
            if parent.is_valid() and parent.index == list_index and parent.generation == self.nodes[list_index].id.generation:
                if tiny_contains(self.pane_slots[index].effective_clip, point): return ordinal
                ordinal = ordinal + 1
            index = index + 1
        -1

    me dispatch(event: TinyEvent) -> TinyGuiDispatchReceipt:
        if event.kind == TINY_EVENT_KEY and event.code == TINY_KEY_TAB:
            val status = self.focus_next()
            return TinyGuiDispatchReceipt(status: status, target_index: self.focused_index, action_id: 0, changed: status.is_ok())
        var target = self.focused_index
        if event.kind == TINY_EVENT_POINTER_DOWN or event.kind == TINY_EVENT_WHEEL:
            val resolved = self.resolve_panes(TinyRect(x: -1073741824, y: -1073741824, width: 2147483647, height: 2147483647))
            if not resolved.is_ok():
                return TinyGuiDispatchReceipt(status: resolved, target_index: -1, action_id: 0, changed: false)
            val hit = tiny_hit_test_counted(self.pane_slots, self.pane_count, event.point)
            target = hit.handle.index
            if target >= 0 and event.kind == TINY_EVENT_POINTER_DOWN:
                self.focused_index = target
        if event.kind == TINY_EVENT_WHEEL:
            val scroll_index = self.scroll_target(target)
            if scroll_index < 0:
                return TinyGuiDispatchReceipt(status: TinyStatus.error(TINY_ERR_INVALID, target), target_index: target, action_id: 0, changed: false)
            var node = self.nodes[scroll_index]
            var maximum = self.direct_child_extent_y(scroll_index) - node.bounds.height
            if maximum < 0: maximum = 0
            var offset = node.value + event.value
            if offset < 0: offset = 0
            if offset > maximum: offset = maximum
            val changed = offset != node.value
            node.value = offset
            self.nodes[scroll_index] = node
            return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: scroll_index, action_id: 0, changed: changed)
        if target < 0 or target >= self.node_count:
            return TinyGuiDispatchReceipt(status: TinyStatus.error(TINY_ERR_INVALID, target), target_index: target, action_id: 0, changed: false)
        val class_id = self.nodes[target].class_id
        if class_id == TINY_COMPONENT_LIST:
            val item_count = self.direct_child_count(target)
            if item_count <= 0:
                return TinyGuiDispatchReceipt(status: TinyStatus.error(TINY_ERR_INVALID, target), target_index: target, action_id: 0, changed: false)
            if event.kind == TINY_EVENT_POINTER_DOWN:
                val selected = self.list_item_at(target, event.point)
                if selected >= 0:
                    var node = self.nodes[target]
                    val changed = node.value != selected
                    node.value = selected
                    self.nodes[target] = node
                    return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: target, action_id: selected, changed: changed)
            if event.kind == TINY_EVENT_KEY and (event.code == TINY_KEY_UP or event.code == TINY_KEY_DOWN):
                var selected = self.nodes[target].value
                if event.code == TINY_KEY_UP and selected > 0: selected = selected - 1
                if event.code == TINY_KEY_DOWN and selected + 1 < item_count: selected = selected + 1
                var node = self.nodes[target]
                val changed = node.value != selected
                node.value = selected
                self.nodes[target] = node
                return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: target, action_id: selected, changed: changed)
            if event.kind == TINY_EVENT_KEY and event.code == TINY_KEY_ENTER:
                return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: target, action_id: self.nodes[target].value, changed: false)
        if (event.kind == TINY_EVENT_POINTER_DOWN or (event.kind == TINY_EVENT_KEY and event.code == TINY_KEY_ENTER)) and class_id == TINY_COMPONENT_BUTTON:
            return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: target, action_id: self.nodes[target].value, changed: true)
        if (event.kind == TINY_EVENT_POINTER_DOWN or (event.kind == TINY_EVENT_KEY and event.code == TINY_KEY_ENTER)) and class_id == TINY_COMPONENT_CHECKBOX:
            var node = self.nodes[target]
            node.value = if node.value == 0: 1 else: 0
            self.nodes[target] = node
            return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: target, action_id: node.value, changed: true)
        if event.kind == TINY_EVENT_TEXT and class_id == TINY_COMPONENT_TEXT_INPUT:
            if event.code >= 32 and event.code <= 126:
                var node = self.nodes[target]
                node.text_value = node.text_value + event.code.to_char()
                self.nodes[target] = node
                return TinyGuiDispatchReceipt(status: TinyStatus.ok(), target_index: target, action_id: 0, changed: true)
        TinyGuiDispatchReceipt(status: TinyStatus.error(TINY_ERR_UNSUPPORTED, event.kind), target_index: target, action_id: 0, changed: false)
