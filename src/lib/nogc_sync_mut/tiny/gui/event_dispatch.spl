# codex-impl

use std.tiny.common.event.{TinyEvent}
export use std.tiny.gui.state.{TinyGuiDispatchReceipt, TinyGuiState, TINY_KEY_DOWN, TINY_KEY_ENTER, TINY_KEY_TAB, TINY_KEY_UP}

# Compatibility entrypoint for callers that still pass GUI state by value.
# Product code calls TinyGuiState.dispatch directly so the retained arena and
# its preallocated pane slots are never replaced on the event path.
fn tiny_gui_dispatch(state: TinyGuiState, event: TinyEvent) -> TinyGuiDispatchReceipt:
    var next = state
    next.dispatch(event)
