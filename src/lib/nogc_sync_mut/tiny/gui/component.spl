# codex-impl

# Stable ABI IDs. These values are owned by config/tiny/tiny_component_map.sdn.
const TINY_COMPONENT_PANE: i32 = 4097
const TINY_COMPONENT_ROW: i32 = 4098
const TINY_COMPONENT_COLUMN: i32 = 4099
const TINY_COMPONENT_STACK: i32 = 4100
const TINY_COMPONENT_TEXT: i32 = 4101
const TINY_COMPONENT_SPACER: i32 = 4102
const TINY_COMPONENT_DIVIDER: i32 = 4103
const TINY_COMPONENT_BORDER: i32 = 4104
const TINY_COMPONENT_BUTTON: i32 = 4105
const TINY_COMPONENT_CHECKBOX: i32 = 4106
const TINY_COMPONENT_TEXT_INPUT: i32 = 4107
const TINY_COMPONENT_LIST: i32 = 4108
const TINY_COMPONENT_SCROLL_PANE: i32 = 4109
const TINY_COMPONENT_PROGRESS: i32 = 4110

const TINY_COMPONENT_FLAG_CONTAINER: i32 = 1
const TINY_COMPONENT_FLAG_FOCUSABLE: i32 = 2
const TINY_COMPONENT_FLAG_TEXT_VALUE: i32 = 4
const TINY_COMPONENT_FLAG_CHECKED_VALUE: i32 = 8
const TINY_COMPONENT_FLAG_HORIZONTAL: i32 = 16
const TINY_COMPONENT_FLAG_VERTICAL: i32 = 32
const TINY_COMPONENT_FLAG_OVERLAY: i32 = 64
const TINY_COMPONENT_FLAG_SCROLLABLE: i32 = 128
const TINY_COMPONENT_FLAG_SELECTABLE: i32 = 256

class TinyComponentMetadata:
    class_id: i32
    flags: i32

fn tiny_component_metadata(class_id: i32) -> TinyComponentMetadata?:
    if class_id == TINY_COMPONENT_PANE:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_CONTAINER)
    if class_id == TINY_COMPONENT_ROW:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_CONTAINER | TINY_COMPONENT_FLAG_HORIZONTAL)
    if class_id == TINY_COMPONENT_COLUMN:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_CONTAINER | TINY_COMPONENT_FLAG_VERTICAL)
    if class_id == TINY_COMPONENT_STACK:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_CONTAINER | TINY_COMPONENT_FLAG_OVERLAY)
    if class_id == TINY_COMPONENT_TEXT:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_TEXT_VALUE)
    if class_id == TINY_COMPONENT_BUTTON:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_FOCUSABLE | TINY_COMPONENT_FLAG_TEXT_VALUE)
    if class_id == TINY_COMPONENT_CHECKBOX:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_FOCUSABLE | TINY_COMPONENT_FLAG_TEXT_VALUE | TINY_COMPONENT_FLAG_CHECKED_VALUE)
    if class_id == TINY_COMPONENT_TEXT_INPUT:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_FOCUSABLE | TINY_COMPONENT_FLAG_TEXT_VALUE)
    if class_id == TINY_COMPONENT_LIST:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_CONTAINER | TINY_COMPONENT_FLAG_FOCUSABLE | TINY_COMPONENT_FLAG_VERTICAL | TINY_COMPONENT_FLAG_SELECTABLE)
    if class_id == TINY_COMPONENT_SCROLL_PANE:
        return TinyComponentMetadata(class_id: class_id, flags: TINY_COMPONENT_FLAG_CONTAINER | TINY_COMPONENT_FLAG_FOCUSABLE | TINY_COMPONENT_FLAG_VERTICAL | TINY_COMPONENT_FLAG_SCROLLABLE)
    if class_id == TINY_COMPONENT_SPACER or class_id == TINY_COMPONENT_DIVIDER or class_id == TINY_COMPONENT_BORDER or class_id == TINY_COMPONENT_PROGRESS:
        return TinyComponentMetadata(class_id: class_id, flags: 0)
    nil

fn tiny_component_supported(class_id: i32) -> bool:
    tiny_component_metadata(class_id) != nil
