# codex-impl

use std.tiny.common.status.{TinyStatus, TINY_ERR_INVALID}

class TinyScrollState:
    offset_y: i32
    viewport_height: i32
    content_height: i32

class TinyScrollReceipt:
    status: TinyStatus
    state: TinyScrollState
    changed: bool

fn tiny_scroll_to(state: TinyScrollState, requested_y: i32) -> TinyScrollReceipt:
    if state.viewport_height <= 0 or state.content_height < 0:
        return TinyScrollReceipt(status: TinyStatus.error(TINY_ERR_INVALID, state.viewport_height), state: state, changed: false)
    val maximum = if state.content_height > state.viewport_height: state.content_height - state.viewport_height else: 0
    var next_y = requested_y
    if next_y < 0: next_y = 0
    if next_y > maximum: next_y = maximum
    val next = TinyScrollState(offset_y: next_y, viewport_height: state.viewport_height, content_height: state.content_height)
    TinyScrollReceipt(status: TinyStatus.ok(), state: next, changed: next_y != state.offset_y)

fn tiny_scroll_by(state: TinyScrollState, delta_y: i32) -> TinyScrollReceipt:
    tiny_scroll_to(state, state.offset_y + delta_y)
