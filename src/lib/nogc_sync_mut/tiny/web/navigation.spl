# codex-impl

use std.tiny.common.status.{TinyStatus, TINY_ERR_INVALID, TINY_ERR_UNSUPPORTED}

const TINY_NAV_LOCAL: i32 = 1
const TINY_NAV_FRAGMENT: i32 = 2

class TinyNavigationReceipt:
    status: TinyStatus
    kind: i32
    target: text

fn tiny_navigation_request(target: text) -> TinyNavigationReceipt:
    val clean = target.trim()
    if clean.len() == 0: return TinyNavigationReceipt(status: TinyStatus.error(TINY_ERR_INVALID, 0), kind: 0, target: clean)
    if clean.starts_with("#"): return TinyNavigationReceipt(status: TinyStatus.ok(), kind: TINY_NAV_FRAGMENT, target: clean)
    if clean.starts_with("/") and not clean.contains(".."): return TinyNavigationReceipt(status: TinyStatus.ok(), kind: TINY_NAV_LOCAL, target: clean)
    TinyNavigationReceipt(status: TinyStatus.error(TINY_ERR_UNSUPPORTED, clean.len()), kind: 0, target: clean)
