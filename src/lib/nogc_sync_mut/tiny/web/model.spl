# codex-impl

use std.tiny.common.status.{TinyStatus}
use std.tiny.common.types.{TinyRect}
use std.tiny.common.types.{TinyHandle}
use std.tiny.pane.model.{TinyResolvedPane}

const TINY_WEB_DOCUMENT: i32 = 0
const TINY_WEB_BODY: i32 = 1
const TINY_WEB_DIV: i32 = 2
const TINY_WEB_P: i32 = 3
const TINY_WEB_SPAN: i32 = 4
const TINY_WEB_BUTTON: i32 = 5
const TINY_WEB_INPUT: i32 = 6
const TINY_WEB_TEXT: i32 = 7
const TINY_WEB_HTML: i32 = 8
const TINY_WEB_HEAD: i32 = 9
const TINY_WEB_TITLE: i32 = 10
const TINY_WEB_STYLE: i32 = 11
const TINY_WEB_HEADING: i32 = 12
const TINY_WEB_BR: i32 = 13
const TINY_WEB_LABEL: i32 = 14
const TINY_WEB_UL: i32 = 15
const TINY_WEB_OL: i32 = 16
const TINY_WEB_LI: i32 = 17
const TINY_WEB_A: i32 = 18

class TinyWebNode:
    kind: i32
    parent_index: i32
    depth: i32
    text_value: text
    tag_name: text
    id_value: text
    class_value: text
    type_value: text
    href_value: text
    value_attribute: text
    name_value: text
    placeholder_value: text
    max_length_value: text
    checked: bool
    disabled: bool
    bounds: TinyRect

class TinyWebReceipt:
    status: TinyStatus
    nodes: [TinyWebNode]
    unsupported_count: i32
    malformed_offset: i32
    title_text: text
    style_source: text

fn tiny_web_resolved_pane(node: TinyWebNode, index: i32, parent: TinyResolvedPane, viewport: TinyRect) -> TinyResolvedPane:
    val id = TinyHandle(index: index, generation: 1)
    if node.parent_index < 0:
        return TinyResolvedPane.root(id, node.bounds, viewport, index, 0, index)
    val local = TinyRect(
        x: node.bounds.x - parent.absolute.x,
        y: node.bounds.y - parent.absolute.y,
        width: node.bounds.width,
        height: node.bounds.height,
    )
    parent.resolve_child(id, local, TinyRect.empty(), 0, 0, index, 0, index)

fn tiny_web_kind(name: text) -> i32:
    if name == "html": return TINY_WEB_HTML
    if name == "head": return TINY_WEB_HEAD
    if name == "title": return TINY_WEB_TITLE
    if name == "style": return TINY_WEB_STYLE
    if name == "body": return TINY_WEB_BODY
    if name == "div": return TINY_WEB_DIV
    if name == "p": return TINY_WEB_P
    if name == "span": return TINY_WEB_SPAN
    if name == "button": return TINY_WEB_BUTTON
    if name == "input": return TINY_WEB_INPUT
    if name == "h1" or name == "h2" or name == "h3" or name == "h4" or name == "h5" or name == "h6": return TINY_WEB_HEADING
    if name == "br": return TINY_WEB_BR
    if name == "label": return TINY_WEB_LABEL
    if name == "ul": return TINY_WEB_UL
    if name == "ol": return TINY_WEB_OL
    if name == "li": return TINY_WEB_LI
    if name == "a": return TINY_WEB_A
    -1
