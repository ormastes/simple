# codex-impl

use std.tiny.common.status.{TinyStatus, TINY_ERR_MALFORMED, TINY_ERR_UNSUPPORTED}
use std.tiny.draw.opcode.*

fn tiny_draw_validate(stream: [i32], max_commands: i32, max_stack_depth: i32) -> TinyStatus:
    tiny_draw_validate_counted(stream, stream.len(), max_commands, max_stack_depth)

fn tiny_draw_validate_counted(stream: [i32], word_count: i32, max_commands: i32, max_stack_depth: i32) -> TinyStatus:
    if max_commands <= 0 or max_stack_depth < 0:
        return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_COMMAND_LIMIT)
    if word_count < 0 or word_count > stream.len():
        return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
    var at = 0
    var commands = 0
    var clips = 0
    var transforms = 0
    while at < word_count:
        if commands >= max_commands:
            return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_COMMAND_LIMIT)
        val opcode = stream[at]
        at = at + 1
        commands = commands + 1
        if opcode == TINY_DRAW_END:
            if clips != 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_CLIP_STACK)
            if transforms != 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRANSLATE_STACK)
            if at != word_count: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRAILING_DATA)
            return TinyStatus.ok()
        if opcode == TINY_DRAW_CLEAR:
            if word_count - at < 1: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            at = at + 1
        else if opcode == TINY_DRAW_FILL_RECT or opcode == TINY_DRAW_BORDER_RECT:
            if word_count - at < 5: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            if stream[at + 2] < 0 or stream[at + 3] < 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_DIMENSION)
            if opcode == TINY_DRAW_BORDER_RECT and (stream[at + 2] == 0 or stream[at + 3] == 0): return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_DIMENSION)
            at = at + 5
        else if opcode == TINY_DRAW_PUSH_CLIP:
            if word_count - at < 4: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            if stream[at + 2] < 0 or stream[at + 3] < 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_DIMENSION)
            clips = clips + 1
            if clips > max_stack_depth: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_CLIP_STACK)
            at = at + 4
        else if opcode == TINY_DRAW_POP_CLIP:
            clips = clips - 1
            if clips < 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_CLIP_STACK)
        else if opcode == TINY_DRAW_PUSH_TRANSLATE:
            if word_count - at < 2: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            transforms = transforms + 1
            if transforms > max_stack_depth: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRANSLATE_STACK)
            at = at + 2
        else if opcode == TINY_DRAW_POP_TRANSLATE:
            transforms = transforms - 1
            if transforms < 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRANSLATE_STACK)
        else if opcode == TINY_DRAW_GLYPH_MONO:
            val remaining = word_count - at
            if remaining < 5: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            val width = stream[at + 2]
            val height = stream[at + 3]
            if width < 0 or width > 31 or height < 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_GLYPH_WIDTH)
            if height > remaining - 5: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            at = at + 5 + height
        else if opcode == TINY_DRAW_BLIT_ARGB:
            val remaining = word_count - at
            if remaining < 4: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            val width = stream[at + 2]
            val height = stream[at + 3]
            if width < 0 or height < 0: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_DIMENSION)
            if width != 0 and height > 2147483647 / width: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_DIMENSION)
            val count = width * height
            if count > remaining - 4: return TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
            at = at + 4 + count
        else:
            return TinyStatus.error(TINY_ERR_UNSUPPORTED, TINY_DRAW_DETAIL_OPCODE)
    TinyStatus.error(TINY_ERR_MALFORMED, TINY_DRAW_DETAIL_TRUNCATED)
