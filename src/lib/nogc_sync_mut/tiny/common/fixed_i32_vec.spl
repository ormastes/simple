# codex-impl

use std.tiny.common.status.{TinyStatus, TINY_ERR_CAPACITY, TINY_ERR_INVALID}

# A concrete bounded vector for tiny profile indices and queues.  The backing
# array may be runtime-managed, but its observable capacity never grows.
class TinyFixedI32Vec:
    capacity: i32
    values: [i32]

    static fn with_capacity(capacity: i32) -> TinyFixedI32Vec:
        TinyFixedI32Vec(capacity: capacity, values: [])

    fn len() -> i32:
        self.values.len()

    fn is_full() -> bool:
        self.values.len() >= self.capacity

    me push(value: i32) -> TinyStatus:
        if self.capacity < 0:
            return TinyStatus.error(TINY_ERR_INVALID, self.capacity)
        if self.is_full():
            return TinyStatus.error(TINY_ERR_CAPACITY, self.capacity)
        self.values.push(value)
        TinyStatus.ok()

    fn get(index: i32) -> i32:
        if index < 0 or index >= self.values.len(): return -1
        self.values[index]

    me clear():
        self.values = []
