# codex-impl

class TinyPoint:
    x: i32
    y: i32

class TinyRect:
    x: i32
    y: i32
    width: i32
    height: i32

    static fn empty() -> TinyRect:
        TinyRect(x: 0, y: 0, width: 0, height: 0)

    fn right() -> i32:
        tiny_add_i32_saturating(self.x, self.width)

    fn bottom() -> i32:
        tiny_add_i32_saturating(self.y, self.height)

    fn is_empty() -> bool:
        self.width <= 0 or self.height <= 0

class TinyHandle:
    index: i32
    generation: i32

    static fn invalid() -> TinyHandle:
        TinyHandle(index: -1, generation: 0)

    fn is_valid() -> bool:
        self.index >= 0 and self.generation > 0

fn tiny_min_i32(a: i32, b: i32) -> i32:
    if a < b: return a
    b

fn tiny_max_i32(a: i32, b: i32) -> i32:
    if a > b: return a
    b

fn tiny_i64_to_i32_saturating(value: i64) -> i32:
    if value > 2147483647i64: return 2147483647
    if value < 0i64 - 2147483647i64 - 1i64: return -2147483647 - 1
    value as i32

fn tiny_add_i32_saturating(a: i32, b: i32) -> i32:
    tiny_i64_to_i32_saturating(a as i64 + b as i64)

fn tiny_sub_i32_saturating(a: i32, b: i32) -> i32:
    tiny_i64_to_i32_saturating(a as i64 - b as i64)

fn tiny_intersect(a: TinyRect, b: TinyRect) -> TinyRect:
    val left = tiny_max_i32(a.x, b.x)
    val top = tiny_max_i32(a.y, b.y)
    val right = tiny_min_i32(a.right(), b.right())
    val bottom = tiny_min_i32(a.bottom(), b.bottom())
    if right <= left or bottom <= top:
        return TinyRect.empty()
    TinyRect(x: left, y: top, width: right - left, height: bottom - top)

fn tiny_contains(rect: TinyRect, point: TinyPoint) -> bool:
    point.x >= rect.x and point.y >= rect.y and point.x < rect.right() and point.y < rect.bottom()
