# codex-impl

const TINY_OK: i32 = 0
const TINY_ERR_CAPACITY: i32 = 1
const TINY_ERR_INVALID: i32 = 2
const TINY_ERR_UNSUPPORTED: i32 = 3
const TINY_ERR_ABI: i32 = 4
const TINY_ERR_STALE_HANDLE: i32 = 5
const TINY_ERR_MALFORMED: i32 = 6
const TINY_ERR_BACKEND_UNAVAILABLE: i32 = 7

class TinyStatus:
    code: i32
    detail_id: i32

    static fn ok() -> TinyStatus:
        TinyStatus(code: TINY_OK, detail_id: 0)

    static fn error(code: i32, detail_id: i32) -> TinyStatus:
        TinyStatus(code: code, detail_id: detail_id)

    fn is_ok() -> bool:
        self.code == TINY_OK
