# codex-impl

use std.tiny.common.types.{TinyHandle, TinyRect, tiny_add_i32_saturating, tiny_sub_i32_saturating, tiny_intersect}

const TINY_PANE_VISIBLE: i32 = 1
const TINY_PANE_ENABLED: i32 = 2
const TINY_PANE_CLIP_CHILDREN: i32 = 4
const TINY_PANE_FOCUSABLE: i32 = 8
const TINY_PANE_POINTER: i32 = 16
const TINY_PANE_OPAQUE: i32 = 32
const TINY_PANE_POPUP: i32 = 64

class TinyPane:
    id: TinyHandle
    parent: TinyHandle
    local: TinyRect
    clip_local: TinyRect
    scroll_x: i32
    scroll_y: i32
    z: i32
    flags: i32
    content_id: i32

class TinyResolvedPane:
    id: TinyHandle
    absolute: TinyRect
    effective_clip: TinyRect
    z: i32
    flags: i32
    content_id: i32

    static fn root(id: TinyHandle, bounds: TinyRect, output_clip: TinyRect, z: i32, flags: i32, content_id: i32) -> TinyResolvedPane:
        TinyResolvedPane(
            id: id, absolute: bounds, effective_clip: tiny_intersect(output_clip, bounds),
            z: z, flags: flags, content_id: content_id,
        )

    fn resolve_child(child_id: TinyHandle, local: TinyRect, local_clip: TinyRect, parent_scroll_x: i32, parent_scroll_y: i32, z: i32, flags: i32, content_id: i32) -> TinyResolvedPane:
        val absolute = TinyRect(
            x: tiny_sub_i32_saturating(tiny_add_i32_saturating(self.absolute.x, local.x), parent_scroll_x),
            y: tiny_sub_i32_saturating(tiny_add_i32_saturating(self.absolute.y, local.y), parent_scroll_y),
            width: local.width,
            height: local.height,
        )
        var effective = tiny_intersect(self.effective_clip, absolute)
        if not local_clip.is_empty():
            val clip_absolute = TinyRect(
                x: tiny_add_i32_saturating(absolute.x, local_clip.x),
                y: tiny_add_i32_saturating(absolute.y, local_clip.y),
                width: local_clip.width, height: local_clip.height,
            )
            effective = tiny_intersect(effective, clip_absolute)
        TinyResolvedPane(
            id: child_id, absolute: absolute, effective_clip: effective,
            z: z, flags: flags, content_id: content_id,
        )
