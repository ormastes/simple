# Canonical runtime boundary for the freestanding SSH KEX fast path.
#
# App/session modules must import these typed wrappers instead of declaring raw
# runtime hooks. Pure-Simple parity and fallback logic remains in the SSH KEX
# layer; this owner only isolates ABI calls.

extern fn rt_tls13_x25519_public_key(scalar: [u8]) -> [u8]
extern fn rt_tls13_x25519_shared_secret(scalar: [u8], point: [u8]) -> [u8]
extern fn rt_tls13_sha256(data: [u8]) -> [u8]
extern fn rt_ssh_curve25519_exchange_hash(
    client_version: [u8],
    server_version: [u8],
    client_kexinit: [u8],
    server_kexinit: [u8],
    host_key_blob: [u8],
    client_public: [u8],
    server_public: [u8],
    shared_secret: [u8]
) -> [u8]

fn ssh_kex_runtime_x25519_public_key(scalar: [u8]) -> [u8]:
    rt_tls13_x25519_public_key(scalar)

fn ssh_kex_runtime_x25519_shared_secret(scalar: [u8], point: [u8]) -> [u8]:
    rt_tls13_x25519_shared_secret(scalar, point)

fn ssh_kex_runtime_sha256(data: [u8]) -> [u8]:
    rt_tls13_sha256(data)

fn ssh_kex_runtime_exchange_hash(
    client_version: [u8],
    server_version: [u8],
    client_kexinit: [u8],
    server_kexinit: [u8],
    host_key_blob: [u8],
    client_public: [u8],
    server_public: [u8],
    shared_secret: [u8]
) -> [u8]:
    rt_ssh_curve25519_exchange_hash(
        client_version,
        server_version,
        client_kexinit,
        server_kexinit,
        host_key_blob,
        client_public,
        server_public,
        shared_secret
    )

export ssh_kex_runtime_x25519_public_key, ssh_kex_runtime_x25519_shared_secret
export ssh_kex_runtime_sha256, ssh_kex_runtime_exchange_hash
