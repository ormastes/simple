# codex-impl
# Strict device backend runner boundary for production web/db GPU offload.

use std.web_db_offload.contract.{GpuWdbWorkKind, GpuWdbBudget}
use std.web_db_offload.queue.{
    GpuWdbQueueState,
    GpuWdbQueueSubmission,
    GpuWdbExecutionEvidence,
    gpu_wdb_submission_evidence_with_device_timing
}
use std.web_db_offload.library.{
    GpuWdbLibraryRegistry,
    gpu_wdb_library_empty,
    gpu_wdb_library_with_targets,
    gpu_wdb_submit_registered_batch_for_generation
}

struct GpuWdbDeviceBackend:
    backend: text
    generation: i64
    available_targets: [text]
    native_device_execution: bool
    device_name: text

struct GpuWdbDeviceReceipt:
    completed: bool
    backend_handle: i64
    device_identity: i64
    readback_source: text
    expected_checksum: i64
    actual_checksum: i64
    mismatch_count: i64
    cpu_fallback: bool

struct GpuWdbDeviceRunResult:
    submission: GpuWdbQueueSubmission
    evidence: GpuWdbExecutionEvidence
    backend: GpuWdbDeviceBackend
    production_device_claim: bool
    reason: text

fn gpu_wdb_device_backend_unavailable() -> GpuWdbDeviceBackend:
    GpuWdbDeviceBackend(
        backend: "none",
        generation: 0,
        available_targets: [],
        native_device_execution: false,
        device_name: "unavailable"
    )

fn gpu_wdb_device_receipt_unavailable() -> GpuWdbDeviceReceipt:
    GpuWdbDeviceReceipt(
        completed: false,
        backend_handle: 0,
        device_identity: 0,
        readback_source: "unavailable",
        expected_checksum: 0,
        actual_checksum: 0,
        mismatch_count: 0,
        cpu_fallback: false
    )

fn gpu_wdb_device_receipt(completed: bool,
                          backend_handle: i64,
                          device_identity: i64,
                          readback_source: text,
                          expected_checksum: i64,
                          actual_checksum: i64,
                          mismatch_count: i64,
                          cpu_fallback: bool) -> GpuWdbDeviceReceipt:
    GpuWdbDeviceReceipt(
        completed: completed,
        backend_handle: backend_handle,
        device_identity: device_identity,
        readback_source: readback_source,
        expected_checksum: expected_checksum,
        actual_checksum: actual_checksum,
        mismatch_count: mismatch_count,
        cpu_fallback: cpu_fallback
    )

fn gpu_wdb_device_receipt_valid(receipt: GpuWdbDeviceReceipt) -> bool:
    (receipt.completed and
        receipt.backend_handle > 0 and
        receipt.device_identity > 0 and
        receipt.readback_source == "device_readback" and
        receipt.expected_checksum > 0 and
        receipt.actual_checksum == receipt.expected_checksum and
        receipt.mismatch_count == 0 and
        not receipt.cpu_fallback)

fn gpu_wdb_device_receipt_reason(receipt: GpuWdbDeviceReceipt) -> text:
    if not receipt.completed:
        return "device-not-completed"
    if receipt.backend_handle <= 0:
        return "backend-handle-missing"
    if receipt.device_identity <= 0:
        return "device-identity-missing"
    if receipt.readback_source != "device_readback":
        return "device-readback-missing"
    if receipt.expected_checksum <= 0:
        return "expected-checksum-invalid"
    if receipt.actual_checksum != receipt.expected_checksum or receipt.mismatch_count != 0:
        return "device-readback-mismatch"
    if receipt.cpu_fallback:
        return "cpu-fallback-not-device"
    "device-receipt-valid"

fn gpu_wdb_device_backend(backend: text, generation: i64, available_targets: [text],
                          native_device_execution: bool,
                          device_name: text) -> GpuWdbDeviceBackend:
    GpuWdbDeviceBackend(
        backend: backend,
        generation: generation,
        available_targets: available_targets,
        native_device_execution: native_device_execution,
        device_name: if device_name == "": "unknown-device" else: device_name
    )

fn gpu_wdb_device_backend_registry(backend: GpuWdbDeviceBackend) -> GpuWdbLibraryRegistry:
    if not backend.native_device_execution:
        return gpu_wdb_library_with_targets(backend.backend, backend.generation, [])
    gpu_wdb_library_with_targets(backend.backend, backend.generation, backend.available_targets)

fn gpu_wdb_device_timing_source(backend: GpuWdbDeviceBackend, source: text) -> text:
    if source != "":
        return source
    "{backend.backend}:{backend.device_name}"

fn gpu_wdb_run_device_batch(state: GpuWdbQueueState,
                            backend: GpuWdbDeviceBackend,
                            kind: GpuWdbWorkKind,
                            total_batch_bytes: i64,
                            item_count: i64,
                            expected_generation: i64,
                            cpu_fallback_available: bool,
                            budget: GpuWdbBudget,
                            started_us: i64,
                            finished_us: i64,
                            measured_device_time_us: i64,
                            timing_source: text,
                            device_receipt: GpuWdbDeviceReceipt) -> GpuWdbDeviceRunResult:
    val registry = gpu_wdb_device_backend_registry(backend)
    val submission = gpu_wdb_submit_registered_batch_for_generation(
        state,
        registry,
        kind,
        total_batch_bytes,
        item_count,
        backend.native_device_execution,
        expected_generation,
        cpu_fallback_available,
        budget
    )
    val device_receipt_valid = gpu_wdb_device_receipt_valid(device_receipt)
    val timing_valid = (submission.accepted and
        backend.native_device_execution and
        measured_device_time_us > 0 and
        device_receipt_valid)
    val evidence = gpu_wdb_submission_evidence_with_device_timing(
        submission,
        item_count,
        if submission.accepted: submission.pinned_host_bytes else: 0,
        started_us,
        finished_us,
        measured_device_time_us,
        gpu_wdb_device_timing_source(backend, timing_source),
        timing_valid
    )
    GpuWdbDeviceRunResult(
        submission: submission,
        evidence: evidence,
        backend: backend,
        production_device_claim: timing_valid,
        reason:
            if timing_valid:
                "production-device-measured"
            elif submission.accepted and not device_receipt_valid:
                gpu_wdb_device_receipt_reason(device_receipt)
            else:
                submission.reason
    )
