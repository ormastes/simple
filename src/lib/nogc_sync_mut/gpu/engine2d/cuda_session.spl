"""CUDA Session — Primary Context, PTX Module Cache, Kernel Launch

@tag:stdlib
@tag:gpu

Retains the CUDA primary context for a device, caches loaded PTX modules
and kernel handles, and tracks allocation/launch statistics.

Usage:
    val session = CudaComputeSession.create(0, "managed")
    val err = session.init_context()
    val mod = session.load_ptx("fill", ptx_src)
    val kern = session.get_kernel(mod, "fill_kernel")
    val launch_err = session.launch(kern, 16, 16, 16, 16)
"""

# ============================================================================
# Extern declarations
# ============================================================================

extern fn rt_cuda_primary_ctx_retain(device_id: i64) -> i64
extern fn rt_cuda_primary_ctx_release(device_id: i64) -> i64
extern fn rt_cuda_module_load(ctx: i64, ptx_source: text) -> i64
extern fn rt_cuda_kernel_get(module: i64, name: text) -> i64
extern fn rt_cuda_kernel_launch(kernel: i64, grid_x: i64, grid_y: i64, block_x: i64, block_y: i64) -> text
extern fn rt_cuda_alloc_device(ctx: i64, size_bytes: i64) -> i64
extern fn rt_cuda_memcpy_d2h(dst_offset: i64, src_ptr: i64, size: i64) -> text
extern fn rt_cuda_stream_sync(ctx: i64) -> text
extern fn rt_cuda_device_name(device_id: i64) -> text

fn cuda_session_primary_ctx_retain(device_id: i64) -> i64:
    rt_cuda_primary_ctx_retain(device_id)

fn cuda_session_primary_ctx_release(device_id: i64) -> i64:
    rt_cuda_primary_ctx_release(device_id)

fn cuda_session_module_load(ctx: i64, ptx_source: text) -> i64:
    rt_cuda_module_load(ctx, ptx_source)

fn cuda_session_kernel_get(module: i64, name: text) -> i64:
    rt_cuda_kernel_get(module, name)

fn cuda_session_kernel_launch(kernel: i64, grid_x: i64, grid_y: i64, block_x: i64, block_y: i64) -> text:
    rt_cuda_kernel_launch(kernel, grid_x, grid_y, block_x, block_y)

fn cuda_session_alloc_device(ctx: i64, size_bytes: i64) -> i64:
    rt_cuda_alloc_device(ctx, size_bytes)

fn cuda_session_memcpy_d2h(dst_offset: i64, src_ptr: i64, size: i64) -> text:
    rt_cuda_memcpy_d2h(dst_offset, src_ptr, size)

fn cuda_session_stream_sync(ctx: i64) -> text:
    rt_cuda_stream_sync(ctx)

fn cuda_session_device_name(device_id: i64) -> text:
    rt_cuda_device_name(device_id)

# ============================================================================
# CudaModuleCache — flat fields for up to 4 cached modules
# ============================================================================

class CudaModuleCache:
    m0_name: text
    m0_handle: i64
    m1_name: text
    m1_handle: i64
    m2_name: text
    m2_handle: i64
    m3_name: text
    m3_handle: i64
    count: i64

impl CudaModuleCache:
    static fn create() -> CudaModuleCache:
        CudaModuleCache(
            m0_name: "", m0_handle: 0,
            m1_name: "", m1_handle: 0,
            m2_name: "", m2_handle: 0,
            m3_name: "", m3_handle: 0,
            count: 0
        )

    me cache_module(name: text, handle: i64) -> text:
        if self.count == 0:
            self.m0_name = name
            self.m0_handle = handle
            self.count = self.count + 1
            return "ok"
        if self.count == 1:
            self.m1_name = name
            self.m1_handle = handle
            self.count = self.count + 1
            return "ok"
        if self.count == 2:
            self.m2_name = name
            self.m2_handle = handle
            self.count = self.count + 1
            return "ok"
        if self.count == 3:
            self.m3_name = name
            self.m3_handle = handle
            self.count = self.count + 1
            return "ok"
        "cache_full"

    me find_module(name: text) -> i64:
        if self.m0_name == name:
            return self.m0_handle
        if self.m1_name == name:
            return self.m1_handle
        if self.m2_name == name:
            return self.m2_handle
        if self.m3_name == name:
            return self.m3_handle
        0

# ============================================================================
# CudaComputeSession
# ============================================================================

class CudaComputeSession:
    device_id: i64
    ctx_handle: i64
    device_name: text
    mode: text
    module_cache: CudaModuleCache
    cache_reject_count: i64
    last_cache_rejection: text

impl CudaComputeSession:
    static fn create(device_id: i64, mode: text) -> CudaComputeSession:
        CudaComputeSession(
            device_id: device_id,
            ctx_handle: 0,
            device_name: "",
            mode: mode,
            module_cache: CudaModuleCache.create(),
            cache_reject_count: 0,
            last_cache_rejection: ""
        )

    # The caller supplies an already-admitted module identity.  This method
    # performs bounded cache bookkeeping only and never invokes CUDA.
    me record_module(name: text, handle: i64) -> i64:
        val cache_result = self.module_cache.cache_module(name, handle)
        if cache_result == "cache_full":
            self.cache_reject_count = self.cache_reject_count + 1
            self.last_cache_rejection = "module:{name}"
        handle

    me cache_reject_count_get() -> i64:
        self.cache_reject_count

    me last_cache_rejection_get() -> text:
        self.last_cache_rejection
