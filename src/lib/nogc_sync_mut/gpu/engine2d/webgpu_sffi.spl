# WebGPU runtime hook owner for 2D engine backends.

@unsafe(reason: "raw WebGPU availability capability ABI", capabilities: [ffi])
extern fn rt_webgpu_is_available() -> bool
@unsafe(reason: "raw WebGPU initialization capability ABI", capabilities: [ffi])
extern fn rt_webgpu_init() -> bool
@unsafe(reason: "raw WebGPU shutdown capability ABI", capabilities: [ffi])
extern fn rt_webgpu_shutdown() -> bool
@unsafe(reason: "raw WebGPU opaque surface-handle ABI; -1 is invalid", capabilities: [ffi])
extern fn rt_webgpu_create_surface(width: i32, height: i32) -> i64
@unsafe(reason: "raw WebGPU surface-destruction status ABI", capabilities: [ffi])
extern fn rt_webgpu_destroy_surface(handle: i64) -> bool
@unsafe(reason: "raw WebGPU pixel-array ABI", capabilities: [ffi])
extern fn rt_webgpu_upload_pixels(handle: i64, pixels: [u32], w: i32, h: i32) -> bool
@unsafe(reason: "raw WebGPU presentation status ABI", capabilities: [ffi])
extern fn rt_webgpu_present(handle: i64) -> bool
@unsafe(reason: "raw WebGPU draw scalar ABI", capabilities: [ffi])
extern fn rt_webgpu_compute_draw(handle: i64, op_kind: i32, x: i32, y: i32, w: i32, h: i32, color: u32) -> bool
@unsafe(reason: "raw WebGPU adapter-count capability ABI", capabilities: [ffi])
extern fn rt_webgpu_adapter_count() -> i64
@unsafe(reason: "raw WebGPU runtime-owned adapter-name text ABI", capabilities: [ffi])
extern fn rt_webgpu_adapter_name(index: i64) -> text
@unsafe(reason: "raw WebGPU adapter classification ABI", capabilities: [ffi])
extern fn rt_webgpu_adapter_is_cpu(index: i64) -> bool

fn webgpu_sffi_is_available() -> bool:
    rt_webgpu_is_available()

fn webgpu_sffi_init() -> bool:
    rt_webgpu_init()

fn webgpu_sffi_shutdown() -> bool:
    rt_webgpu_shutdown()

# The documented invalid-surface sentinel of this boundary
# (src/runtime/hosted/webgpu.rs:52 `WEBGPU_INVALID_HANDLE`). Zero is a
# plausible-looking handle, so it must never stand in for failure.
val WEBGPU_INVALID_HANDLE: i64 = -1

# Fail closed on a non-positive extent or an unavailable provider, and
# normalise any non-positive provider result to the documented sentinel: some
# lanes (the seed interpreter stub) answer 0 for "no surface", which is
# indistinguishable from a real handle at the call site.
fn webgpu_sffi_create_surface(width: i32, height: i32) -> i64:
    if width <= 0 or height <= 0 or not webgpu_sffi_is_available():
        return WEBGPU_INVALID_HANDLE
    val handle = rt_webgpu_create_surface(width, height)
    if handle <= 0:
        return WEBGPU_INVALID_HANDLE
    handle

fn webgpu_sffi_destroy_surface(handle: i64) -> bool:
    rt_webgpu_destroy_surface(handle)

fn webgpu_sffi_upload_pixels(handle: i64, pixels: [u32], w: i32, h: i32) -> bool:
    rt_webgpu_upload_pixels(handle, pixels, w, h)

fn webgpu_sffi_present(handle: i64) -> bool:
    rt_webgpu_present(handle)

fn webgpu_sffi_compute_draw(handle: i64, op_kind: i32, x: i32, y: i32, w: i32, h: i32, color: u32) -> bool:
    rt_webgpu_compute_draw(handle, op_kind, x, y, w, h, color)

fn webgpu_sffi_adapter_count() -> i64:
    rt_webgpu_adapter_count()

fn webgpu_sffi_adapter_name(index: i64) -> text:
    rt_webgpu_adapter_name(index)

fn webgpu_sffi_adapter_is_cpu(index: i64) -> bool:
    rt_webgpu_adapter_is_cpu(index)
