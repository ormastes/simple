fn vulkan_sffi_push_constants(cmd: i64, pipe: i64, data: [u8]) -> bool:
    _vulkan_push_constants_abi(cmd, pipe, data)

fn vulkan_sffi_dispatch(cmd: i64, x: i64, y: i64, z: i64) -> bool:
