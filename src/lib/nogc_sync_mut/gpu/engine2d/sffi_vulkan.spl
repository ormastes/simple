fn vulkan_sffi_create_descriptor_set(pipe: i64) -> i64:
    rt_vulkan_create_descriptor_set(pipe)

fn vulkan_sffi_bind_buffer(descriptor_set: i64, binding: i64, buf: i64) -> bool:
    rt_vulkan_bind_buffer(descriptor_set, binding, buf)

fn vulkan_sffi_destroy_descriptor_set(descriptor_set: i64) -> bool:
