fn vulkan_sffi_init_headless_present(width: i64, height: i64, vsync: bool) -> i64:
    rt_vulkan_init_headless_present(width, height, if vsync: 1 else: 0)

@unsafe(reason: "raw Vulkan hosted presentation facade", capabilities: [ffi])
fn vulkan_sffi_init_window_present(width: i64, height: i64, vsync: bool) -> i64:
    rt_vulkan_init_window_present(width, height, if vsync: 1 else: 0)

@unsafe(reason: "raw Vulkan external-window presentation facade", capabilities: [ffi, raw_ptr])
fn vulkan_sffi_init_external_window_present(kind: i64, display: i64, window: i64, width: i64, height: i64, vsync: bool) -> i64:
    rt_vulkan_init_external_window_present(
        kind, display, window, width, height, if vsync: 1 else: 0)

@unsafe(reason: "raw Vulkan full-buffer presentation facade", capabilities: [ffi])
fn vulkan_sffi_present_buffer(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64) -> i64:
    rt_vulkan_present_buffer(swapchain, buffer, width, height, content_revision)

@unsafe(reason: "raw Vulkan region presentation facade", capabilities: [ffi])
fn vulkan_sffi_present_buffer_regions(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64, rects: [i64]) -> i64:
    if rects.len() == 0 or rects.len() % 4 != 0 or rects.len() > 4096:
        return 0
    if gpu_sffi_uses_interpreter_array_abi():
        return rt_vulkan_present_buffer(
            swapchain, buffer, width, height, content_revision)
    var i = 0
    while i < rects.len():
        if rects[i] < 0 or rects[i + 1] < 0 or rects[i + 2] < 0 or rects[i + 3] < 0:
            return 0
        i += 4
    rt_vulkan_present_buffer_regions(
        swapchain, buffer, width, height, content_revision, rects)

@unsafe(reason: "raw Vulkan presentation statistic facade", capabilities: [ffi])
fn vulkan_sffi_last_present_copy_bytes(swapchain: i64) -> i64:
    rt_vulkan_last_present_copy_bytes(swapchain)

@unsafe(reason: "raw Vulkan presentation statistic facade", capabilities: [ffi])
fn vulkan_sffi_last_present_copy_rects(swapchain: i64) -> i64:
    rt_vulkan_last_present_copy_rects(swapchain)

@unsafe(reason: "raw Vulkan swapchain release facade", capabilities: [ffi])
fn vulkan_sffi_destroy_swapchain(swapchain: i64) -> bool:
    rt_vulkan_destroy_swapchain(swapchain)

# ============================================================================
# Headless device probe (lavapipe / CpuOnly selection)
# ============================================================================
#
# vulkan_sffi_find_headless_device() searches the enumerated Vulkan device list
# for a CpuOnly (software ICD) device.  The lavapipe ICD
# (/usr/share/vulkan/icd.d/lvp_icd.json) enumerates as type "cpu".
#
# Returns the device id (>=0) on success, -1 when no CpuOnly device is found.
# The caller must call vulkan_sffi_init() and verify vulkan_sffi_is_available()
# before calling this function.

@unsafe(reason: "raw Vulkan headless-device enumeration facade", capabilities: [ffi])
fn vulkan_sffi_find_headless_device() -> i64:
    val count = rt_vulkan_device_count()
    var i: i64 = 0
    var found: i64 = -1
    while i < count:
        val dt = rt_vulkan_device_type(i)
        if dt == "cpu" or dt == "CpuOnly":
            found = i
        i = i + 1
    found

@unsafe(reason: "raw Vulkan headless-device selection facade", capabilities: [ffi])
fn vulkan_sffi_select_headless() -> bool:
    """Select the first CpuOnly (lavapipe) device.  Returns false when none found."""
    val dev = vulkan_sffi_find_headless_device()
    if dev < 0:
        false
    else:
        rt_vulkan_select_device(dev)
