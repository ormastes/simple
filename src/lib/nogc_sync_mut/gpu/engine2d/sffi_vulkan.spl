"""Vulkan SFFI Dispatch — Static/Dynamic Dual-Path

@tag:stdlib
@tag:gpu

Wraps all rt_vulkan_* extern functions behind a VulkanFfi class that
supports both static (extern fn) and dynamic (DynLib) dispatch.

Usage:
    val sffi = VulkanFfi.create(GpuFfiMode.Dynamic)
    if ffi.is_available():
        ffi.init()
"""

use std.sffi.dynamic.{DynLib}
use std.gpu.engine2d.sffi_dispatch.{
    GpuFfiMode, FfiDispatchBase, try_load_gpu_lib,
    gpu_sffi_uses_interpreter_array_abi
}

# ============================================================================
# Static extern declarations (resolved at link time against Rust runtime)
# ============================================================================

extern fn rt_vulkan_init() -> bool
extern fn rt_vulkan_init_headless_present(width: i64, height: i64, vsync: i64) -> i64
extern fn rt_vulkan_init_window_present(width: i64, height: i64, vsync: i64) -> i64
extern fn rt_vulkan_init_external_window_present(kind: i64, display: i64, window: i64, width: i64, height: i64, vsync: i64) -> i64
extern fn rt_vulkan_present_buffer(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64) -> i64
extern fn rt_vulkan_present_buffer_regions(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64, rects: [i64]) -> i64
extern fn rt_vulkan_last_present_copy_bytes(swapchain: i64) -> i64
extern fn rt_vulkan_last_present_copy_rects(swapchain: i64) -> i64
extern fn rt_vulkan_destroy_swapchain(swapchain: i64) -> bool
extern fn rt_vulkan_shutdown() -> bool
extern fn rt_vulkan_is_available() -> bool
extern fn rt_vulkan_device_count() -> i64
extern fn rt_vulkan_select_device(id: i64) -> bool
extern fn rt_vulkan_device_type(id: i64) -> text
extern fn rt_vulkan_selected_device_type() -> text
extern fn rt_vulkan_device_name(id: i64) -> text
extern fn rt_vulkan_device_driver_identity(id: i64) -> text
extern fn rt_vulkan_selected_device_driver_identity() -> text
extern fn rt_vulkan_selected_device_driver_identity_hash() -> i64
extern fn rt_vulkan_alloc_buffer(size: i64, usage: i64) -> i64
extern fn rt_vulkan_free_buffer(handle: i64) -> bool
extern fn rt_vulkan_copy_to_buffer(handle: i64, data: [u8], offset: i64) -> bool
extern fn rt_vulkan_copy_to_buffer_array(handle: i64, data: [u8], byte_count: i64, offset: i64) -> bool
extern fn rt_vulkan_copy_from_buffer(data: [u8], handle: i64, offset: i64) -> bool
extern fn rt_vulkan_copy_from_buffer_array(data: [u8], byte_count: i64, handle: i64, offset: i64) -> bool
extern fn rt_vulkan_copy_from_buffer_regions(data: [u8], handle: i64, regions: [i64]) -> bool
extern fn rt_vulkan_copy_from_buffer_strided(data: [u8], handle: i64, src_offset: i64, row_bytes: i64, row_count: i64, src_stride: i64) -> bool
extern fn rt_vulkan_read_buffer_bytes(handle: i64, byte_count: i64, offset: i64) -> [u8]
extern fn rt_byte_array_new_len(len: i64) -> [u8]
extern fn rt_vulkan_compile_spirv(spirv_bytes: [u8]) -> i64
extern fn rt_vulkan_compile_spirv_array(bytes: [u8]) -> i64
extern fn rt_vulkan_compile_glsl(glsl_source: text) -> i64
extern fn rt_vulkan_destroy_shader(module: i64) -> bool
extern fn rt_vulkan_create_compute_pipeline(shader_module: i64, entry_point: text, push_constant_size: i64) -> i64
extern fn rt_vulkan_destroy_pipeline(pipe: i64) -> bool
extern fn rt_vulkan_create_descriptor_set(pipe: i64) -> i64
extern fn rt_vulkan_bind_buffer(descriptor_set: i64, binding: i64, buf: i64) -> bool
extern fn rt_vulkan_destroy_descriptor_set(descriptor_set: i64) -> bool
extern fn rt_vulkan_begin_compute() -> i64
extern fn rt_vulkan_bind_pipeline(cmd: i64, pipe: i64) -> bool
extern fn rt_vulkan_bind_descriptors(cmd: i64, descriptor_set: i64) -> bool
extern fn rt_vulkan_push_constants(cmd: i64, pipe: i64, data: [u8]) -> bool
extern fn rt_vulkan_push_constants_array(cmd: i64, pipe: i64, data: [u8], byte_count: i64) -> bool
extern fn rt_vulkan_dispatch(cmd: i64, x: i64, y: i64, z: i64) -> bool
extern fn rt_vulkan_end_compute(cmd: i64) -> bool
extern fn rt_vulkan_discard_command(cmd: i64) -> bool
extern fn rt_vulkan_submit_and_wait(cmd: i64) -> bool
extern fn rt_vulkan_fence_submission_supported() -> i64
extern fn rt_vulkan_accepted_compute_submit_count() -> i64
