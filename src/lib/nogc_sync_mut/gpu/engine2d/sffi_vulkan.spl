fn vulkan_sffi_destroy_shader(module: i64) -> bool:
    rt_vulkan_destroy_shader(module)

fn vulkan_sffi_create_compute_pipeline(shader_module: i64, entry_point: text, push_constant_size: i64) -> i64:
    rt_vulkan_create_compute_pipeline(shader_module, entry_point, push_constant_size)

fn vulkan_sffi_destroy_pipeline(pipe: i64) -> bool:
