"""CUDA FFI Dispatch — Static/Dynamic Dual-Path

@tag:stdlib
@tag:gpu

Wraps CUDA Driver API functions behind a CudaDynFfi class supporting
both static (extern fn rt_cuda_*) and dynamic (DynLib libcuda.so) dispatch.

Usage:
    val ffi = CudaDynFfi.create(GpuFfiMode.Dynamic)
    if ffi.is_available():
        ffi.init()
"""

use std.sffi.dynamic.{DynLib}
use std.gpu.engine2d.ffi_dispatch.{GpuFfiMode, FfiDispatchBase, try_load_gpu_lib}

# ============================================================================
# Static extern declarations
# ============================================================================

extern fn rt_cuda_available() -> i64
extern fn rt_cuda_init() -> i64
extern fn rt_cuda_shutdown() -> i64
extern fn rt_cuda_device_count() -> i64
extern fn rt_cuda_device_get(id: i64) -> i64
extern fn rt_cuda_ctx_create(device: i64) -> i64
extern fn rt_cuda_ctx_destroy(ctx: i64) -> i64
extern fn rt_cuda_module_load(ptx: text) -> i64
extern fn rt_cuda_module_unload(module: i64) -> i64
extern fn rt_cuda_kernel_get(module: i64, name: text) -> i64
extern fn rt_cuda_launch_kernel(kernel: i64, gx: i64, gy: i64, gz: i64, bx: i64, by: i64, bz: i64, shared_mem: i64, args_ptr: i64) -> i64
extern fn rt_cuda_mem_alloc(size: i64) -> i64
extern fn rt_cuda_mem_free(ptr: i64) -> i64
extern fn rt_cuda_memcpy_htod(dst: i64, src: [u8], size: i64) -> i64
extern fn rt_cuda_memcpy_dtoh(dst: [u8], src: i64, size: i64) -> i64
extern fn rt_cuda_synchronize() -> i64
extern fn rt_engine2d_pack_args_4(a: i64, b: i64, c: i64, d: i64) -> i64
extern fn rt_engine2d_pack_args_8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64
extern fn rt_engine2d_upload_pixels(d_dst: i64, pixels: [u32], count: i64) -> i64
extern fn rt_engine2d_download_pixels(d_src: i64, pixels: [u32], byte_size: i64) -> i64
extern fn rt_engine2d_upload_host_buf(d_dst: i64, host_buf: [u32], byte_size: i64) -> i64

fn cuda_engine2d_pack_args_4(a: i64, b: i64, c: i64, d: i64) -> i64:
    rt_engine2d_pack_args_4(a, b, c, d)

fn cuda_engine2d_pack_args_8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64:
    rt_engine2d_pack_args_8(a, b, c, d, e, f, g, h)

fn cuda_engine2d_upload_pixels(d_dst: i64, pixels: [u32], count: i64) -> i64:
    rt_engine2d_upload_pixels(d_dst, pixels, count)

fn cuda_engine2d_download_pixels(d_src: i64, pixels: [u32], byte_size: i64) -> i64:
    rt_engine2d_download_pixels(d_src, pixels, byte_size)

fn cuda_engine2d_upload_host_buf(d_dst: i64, host_buf: [u32], byte_size: i64) -> i64:
    rt_engine2d_upload_host_buf(d_dst, host_buf, byte_size)

# ============================================================================
# CudaDynFfi
# ============================================================================

class CudaDynFfi:
    _mode: GpuFfiMode
    _dyn_lib: DynLib?

impl CudaDynFfi:
    static fn create_static() -> CudaDynFfi:
        CudaDynFfi(_mode: GpuFfiMode.Static, _dyn_lib: nil)

    static fn create_dynamic() -> CudaDynFfi?:
        val lib = try_load_gpu_lib("cuda")
        if lib == nil:
            return nil
        CudaDynFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: lib)

    static fn create_dynamic_from(path: text) -> CudaDynFfi?:
        val lib = DynLib.load(path)
        if lib == nil:
            return nil
        CudaDynFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: lib)

    static fn create(ffi_mode: GpuFfiMode) -> CudaDynFfi?:
        match ffi_mode:
            case Dynamic:
                val dyn_ffi = CudaDynFfi.create_dynamic()
                if dyn_ffi != nil:
                    return dyn_ffi
                CudaDynFfi.create_static()
            case Static:
                CudaDynFfi.create_static()

impl FfiDispatchBase for CudaDynFfi:

    fn mode() -> GpuFfiMode:
        self._mode

    fn api_name() -> text:
        "CUDA Driver API"

    fn is_available() -> bool:
        match self._mode:
            case Static: rt_cuda_available() != 0
            case Dynamic:
                if self._dyn_lib != nil:
                    # cuInit(unsigned int Flags) takes one argument. call0 leaves
                    # the flags register undefined, so the CUresult was garbage.
                    val result = self._dyn_lib.call1("cuInit", 0)
                    if result != 0:
                        return false
                    # Availability means "a device is actually present", not merely
                    # "cuInit returned CUDA_SUCCESS" — a host with the driver
                    # loaded but zero visible GPUs returns 0 from cuInit too.
                    rt_cuda_device_count() > 0
                else:
                    false

    fn init() -> bool:
        match self._mode:
            case Static: rt_cuda_init() == 0
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call1("cuInit", 0)
                    result == 0
                else:
                    false

    fn shutdown() -> bool:
        match self._mode:
            case Static: rt_cuda_shutdown() == 0
            case Dynamic: true

    fn device_count() -> i64:
        match self._mode:
            case Static: rt_cuda_device_count()
            case Dynamic:
                # cuDeviceGetCount(int* count) returns its result through an OUT
                # POINTER; the return value is a CUresult (0 == CUDA_SUCCESS).
                # DynLib has no out-parameter marshalling (call0..call4/call_n all
                # return the raw i64 return value), so reading the count from
                # call0 yielded 0 on every SUCCESSFUL call — indistinguishable
                # from "no GPUs". Route to the static extern, which marshals the
                # out param correctly.
                rt_cuda_device_count()

    fn ctx_create(device: i64) -> i64:
        match self._mode:
            case Static:
                val ctx = rt_cuda_ctx_create(device)
                if ctx < 0: 0 else: ctx
            case Dynamic:
                # cuCtxCreate(CUcontext* pctx, unsigned flags, CUdevice dev) also
                # returns through an out pointer, and takes THREE args, not two.
                # call2 returned the CUresult, so a successful create handed back
                # 0 — the same value this function uses for "failed". Same
                # out-param defect class as device_count(); use the static extern.
                val ctx = rt_cuda_ctx_create(device)
                if ctx < 0: 0 else: ctx

    fn module_load_ptx(ptx: text) -> i64:
        match self._mode:
            case Static:
                val module = rt_cuda_module_load(ptx)
                if module < 0: 0 else: module
            case Dynamic: 0

    fn kernel_get(module: i64, name: text) -> i64:
        match self._mode:
            case Static: rt_cuda_kernel_get(module, name)
            case Dynamic: 0

    fn launch_kernel(kernel: i64, gx: i64, gy: i64, gz: i64, bx: i64, by: i64, bz: i64, shared_mem: i64, args_ptr: i64) -> bool:
        match self._mode:
            case Static: rt_cuda_launch_kernel(kernel, gx, gy, gz, bx, by, bz, shared_mem, args_ptr) == 0
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call_n("cuLaunchKernel", [kernel, gx, gy, gz, bx, by, bz, shared_mem, 0, args_ptr])
                    result == 0
                else:
                    false

    fn mem_alloc(size: i64) -> i64:
        match self._mode:
            case Static:
                val ptr = rt_cuda_mem_alloc(size)
                if ptr < 0: 0 else: ptr
            case Dynamic:
                # cuMemAlloc(CUdeviceptr* dptr, size_t bytesize): out pointer
                # again. call1 returned the CUresult, so every successful
                # allocation reported device pointer 0. Same defect class as
                # device_count()/ctx_create(); use the static extern.
                val dyn_ptr = rt_cuda_mem_alloc(size)
                if dyn_ptr < 0: 0 else: dyn_ptr

    fn mem_free(ptr: i64) -> bool:
        match self._mode:
            case Static: rt_cuda_mem_free(ptr) == 0
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call1("cuMemFree", ptr)
                    result == 0
                else:
                    false

    fn synchronize() -> bool:
        match self._mode:
            case Static: rt_cuda_synchronize() == 0
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call0("cuCtxSynchronize")
                    result == 0
                else:
                    false
