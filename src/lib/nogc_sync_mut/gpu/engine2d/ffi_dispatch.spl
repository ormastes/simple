"""FFI Dispatch Layer — Static/Dynamic Dual-Path GPU Function Resolution

@tag:stdlib
@tag:gpu

Provides the dual-path FFI dispatch infrastructure for GPU backends.
Each backend gets a *Ffi class that holds either static (extern fn) or
dynamic (DynLib dlopen) function pointers. At init time, hosted OSes
try dynamic first; SimpleOS always uses static.

Usage:
    val mode = default_ffi_mode()
    val vk = VulkanFfi.create(mode)  # auto-selects path
"""

use std.sffi.dynamic.{DynLib, DynLoader, sffi_call}

# ============================================================================
# FFI Mode Enum
# ============================================================================

enum GpuFfiMode:
    Static
    Dynamic

impl GpuFfiMode:
    fn to_text() -> text:
        match self:
            case Static: "Static"
            case Dynamic: "Dynamic"

# ============================================================================
# Platform Detection
# ============================================================================

use std.io_runtime.{env_get}
use std.nogc_sync_mut.env.platform.{detect_os}

fn is_simpleos() -> bool:
    val os = env_get("SIMPLE_OS_KERNEL")
    os == "simpleos"

fn default_ffi_mode() -> GpuFfiMode:
    if is_simpleos():
        GpuFfiMode.Static
    else:
        GpuFfiMode.Dynamic

# ============================================================================
# FfiDispatchBase Trait
# ============================================================================

trait FfiDispatchBase:
    fn mode() -> GpuFfiMode
    fn is_available() -> bool

# ============================================================================
# Dynamic Library Path Resolution
# ============================================================================

fn gpu_lib_path(lib_name: text) -> text:
    # SIMPLE_OS_TYPE is never set by any runtime or CLI entry in this repo, so
    # the old env gate probed Linux sonames even on macOS. detect_os() consults
    # the in-process rt_platform_name() primitive first and needs no env.
    # See doc/08_tracking/bug/gpu_ffi_loader_probes_linux_sonames_on_macos_2026-09-19.md.
    val os = detect_os()
    if os == "windows":
        "{lib_name}.dll"
    elif os == "macos":
        "lib{lib_name}.dylib"
    else:
        "lib{lib_name}.so"

fn gpu_lib_candidates(base_name: text) -> [text]:
    val os = detect_os()
    var paths: [text] = []
    if os == "windows":
        paths.push("{base_name}.dll")
    elif os == "macos":
        paths.push("lib{base_name}.dylib")
        paths.push("lib{base_name}.1.dylib")
        # dyld does not search Homebrew's lib dir for bare sonames, so probe
        # the standard prefixes directly. Absent files are rejected by the
        # file_exists pre-probe in std.sffi.dynamic before any dlopen attempt.
        paths.push("/opt/homebrew/lib/lib{base_name}.dylib")
        paths.push("/usr/local/lib/lib{base_name}.dylib")
    else:
        paths.push("lib{base_name}.so.1")
        paths.push("lib{base_name}.so")
    paths

fn try_load_gpu_lib(base_name: text) -> DynLib?:
    val candidates = gpu_lib_candidates(base_name)
    var i = 0
    while i < candidates.len():
        val lib = DynLib.load(candidates[i])
        if lib != nil:
            return lib
        i = i + 1
    nil

# ============================================================================
# FFI Mode Resolution Helper
# ============================================================================

fn resolve_ffi_mode(backend_name: text) -> GpuFfiMode:
    val mode = default_ffi_mode()
    mode

fn try_create_dynamic_vulkan(lib_path: text) -> DynLib?:
    DynLib.load(lib_path)
