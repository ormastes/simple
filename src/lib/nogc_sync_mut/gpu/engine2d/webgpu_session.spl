"""Pure WebGPU-shader cache bookkeeping.

The former `WebGpuSession` declared eleven providerless `rt_wgpu_*` functions
with ad-hoc scalar and text contracts. Production does not import that
execution façade; retaining it would allow unresolved foreign calls to
manufacture handles or text. Active WebGPU rendering is owned by
`webgpu_sffi`, whose raw boundary remains explicitly unsafe.

This module intentionally preserves only allocation-free bounded shader-cache
bookkeeping. It contains no SFFI boundary.
"""

# ============================================================================
# WebGpuShaderCache — flat storage for up to 4 WGSL shader module handles
#
# Mirrors CudaModuleCache / MetalPipelineCache / VulkanShaderCache exactly
# (4 slots, "cache_full" sentinel, fail-closed find). Before this cache
# existed, `WebGpuSession.load_shader()` re-invoked `rt_wgpu_create_shader`
# for WGSL source it had already compiled, leaking one native
# WGPUShaderModule per call. The cache key is the WGSL source text itself,
# because that is the only identity `load_shader` is given.
# ============================================================================

class WebGpuShaderCache:
    s0_key: text
    s0_handle: i64
    s1_key: text
    s1_handle: i64
    s2_key: text
    s2_handle: i64
    s3_key: text
    s3_handle: i64
    count: i64

impl WebGpuShaderCache:
    static fn create() -> WebGpuShaderCache:
        WebGpuShaderCache(
            s0_key: "", s0_handle: 0,
            s1_key: "", s1_handle: 0,
            s2_key: "", s2_handle: 0,
            s3_key: "", s3_handle: 0,
            count: 0
        )

    me cache_shader(key: text, handle: i64) -> text:
        if self.count == 0:
            self.s0_key = key
            self.s0_handle = handle
            self.count = 1
            return "ok"
        if self.count == 1:
            self.s1_key = key
            self.s1_handle = handle
            self.count = 2
            return "ok"
        if self.count == 2:
            self.s2_key = key
            self.s2_handle = handle
            self.count = 3
            return "ok"
        if self.count == 3:
            self.s3_key = key
            self.s3_handle = handle
            self.count = 4
            return "ok"
        "cache_full"

    me find_shader(key: text) -> i64:
        if self.s0_key == key:
            return self.s0_handle
        if self.s1_key == key:
            return self.s1_handle
        if self.s2_key == key:
            return self.s2_handle
        if self.s3_key == key:
            return self.s3_handle
        0

# ============================================================================
# WebGpuSession
# ============================================================================

class WebGpuSession:
    mode: text
    shader_cache: WebGpuShaderCache
    cache_reject_count: i64
    last_cache_rejection: text

impl WebGpuSession:
    static fn create(mode: text) -> WebGpuSession:
        WebGpuSession(
            mode: mode,
            shader_cache: WebGpuShaderCache.create(),
            cache_reject_count: 0,
            last_cache_rejection: ""
        )

    # The caller supplies an already-admitted shader identity. This method
    # performs bounded cache bookkeeping only and never invokes WebGPU.
    me record_shader(key: text, handle: i64) -> i64:
        val cache_result = self.shader_cache.cache_shader(key, handle)
        if cache_result == "cache_full":
            self.cache_reject_count = self.cache_reject_count + 1
            self.last_cache_rejection = "shader:{key}"
        handle

    me cache_reject_count_get() -> i64:
        self.cache_reject_count

    me last_cache_rejection_get() -> text:
        self.last_cache_rejection
