"""ROCm/HIP FFI Dispatch — Dynamic-First Dual-Path

@tag:stdlib
@tag:gpu

Wraps HIP runtime API functions behind a RocmDynFfi class. Dynamic-first
since no Rust runtime exists for rt_rocm_*. The static path resolves
to extern fn stubs that will link-error unless the runtime is built.

Usage:
    val ffi = RocmDynFfi.create(GpuFfiMode.Dynamic)  # primary path
    if ffi != nil and ffi.is_available():
        ffi.init()
"""

use std.sffi.dynamic.{DynLib}
use std.gpu.engine2d.ffi_dispatch.{GpuFfiMode, FfiDispatchBase, try_load_gpu_lib}

# ============================================================================
# Static extern declarations (no runtime impl yet — will link-error)
# ============================================================================

@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi])
extern fn rt_rocm_init() -> bool
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi])
extern fn rt_rocm_shutdown() -> bool
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi])
extern fn rt_rocm_is_available() -> bool
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi])
extern fn rt_rocm_device_count() -> i64
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_mem_alloc(size: i64) -> i64
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_mem_free(ptr: i64) -> bool
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_module_load(source: text) -> i64
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_kernel_get(module: i64, name: text) -> i64
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_launch_kernel(kernel: i64, gx: i64, gy: i64, gz: i64, bx: i64, by: i64, bz: i64, shared_mem: i64, args_ptr: i64) -> bool
@unsafe(reason: "raw ROCm/HIP ABI; provider admission is not verified", capabilities: [ffi])
extern fn rt_rocm_synchronize() -> bool
@unsafe(reason: "raw ROCm Engine2D ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_engine2d_rocm_upload_pixels(d_dst: i64, pixels: [u32], count: i64) -> i64
@unsafe(reason: "raw ROCm Engine2D ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_engine2d_rocm_download_pixels(d_src: i64, pixels: [u32], byte_size: i64) -> i64
@unsafe(reason: "raw ROCm Engine2D ABI; provider admission is not verified", capabilities: [ffi, raw_ptr])
extern fn rt_engine2d_rocm_upload_host_buf(d_dst: i64, host_buf: [u32], byte_size: i64) -> i64

fn rocm_engine2d_upload_pixels(d_dst: i64, pixels: [u32], count: i64) -> i64:
    rt_engine2d_rocm_upload_pixels(d_dst, pixels, count)

fn rocm_engine2d_download_pixels(d_src: i64, pixels: [u32], byte_size: i64) -> i64:
    rt_engine2d_rocm_download_pixels(d_src, pixels, byte_size)

fn rocm_engine2d_upload_host_buf(d_dst: i64, host_buf: [u32], byte_size: i64) -> i64:
    rt_engine2d_rocm_upload_host_buf(d_dst, host_buf, byte_size)

# ============================================================================
# RocmDynFfi
# ============================================================================

class RocmDynFfi:
    _mode: GpuFfiMode
    _dyn_lib: DynLib?

impl FfiDispatchBase for RocmDynFfi:

    fn mode() -> GpuFfiMode:
        self._mode

    static fn create_static() -> RocmDynFfi:
        RocmDynFfi(_mode: GpuFfiMode.Static, _dyn_lib: nil)

    static fn create_dynamic() -> RocmDynFfi?:
        val lib = try_load_gpu_lib("amdhip64")
        if lib == nil:
            return nil
        RocmDynFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: lib)

    static fn create_dynamic_from(path: text) -> RocmDynFfi?:
        val lib = DynLib.load(path)
        if lib == nil:
            return nil
        RocmDynFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: lib)

    static fn create(ffi_mode: GpuFfiMode) -> RocmDynFfi?:
        match ffi_mode:
            case Dynamic:
                val dyn_ffi = RocmDynFfi.create_dynamic()
                if dyn_ffi != nil:
                    return dyn_ffi
                nil
            case Static:
                RocmDynFfi.create_static()

    fn is_available() -> bool:
        match self._mode:
            case Static: rt_rocm_is_available()
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call1("hipInit", 0)
                    result == 0
                else:
                    false

    fn init() -> bool:
        match self._mode:
            case Static: rt_rocm_init()
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call1("hipInit", 0)
                    result == 0
                else:
                    false

    fn shutdown() -> bool:
        match self._mode:
            case Static: rt_rocm_shutdown()
            case Dynamic: true

    fn device_count() -> i64:
        match self._mode:
            case Static: rt_rocm_device_count()
            case Dynamic:
                # hipGetDeviceCount(int* count) returns its result through an
                # OUT POINTER; call0 yields the hipError_t status, which is 0 on
                # every SUCCESSFUL call. Same defect class as ffi_cuda
                # device_count(): route to the static extern.
                rt_rocm_device_count()

    fn mem_alloc(size: i64) -> i64:
        match self._mode:
            case Static: rt_rocm_mem_alloc(size)
            case Dynamic:
                # hipMalloc(void** ptr, size_t) is an out-pointer API as well;
                # call1 returned the status, so success reported pointer 0.
                rt_rocm_mem_alloc(size)

    fn mem_free(ptr: i64) -> bool:
        match self._mode:
            case Static: rt_rocm_mem_free(ptr)
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call1("hipFree", ptr)
                    result == 0
                else:
                    false

    fn launch_kernel(name: text, gx: i64, gy: i64, gz: i64, bx: i64, by: i64, bz: i64, shared_mem: i64) -> bool:
        match self._mode:
            case Static:
                val module = rt_rocm_module_load("")
                val kernel = rt_rocm_kernel_get(module, name)
                rt_rocm_launch_kernel(kernel, gx, gy, gz, bx, by, bz, shared_mem, 0)
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call_n("hipLaunchKernel", [0, gx, gy, gz, bx, by, bz, shared_mem, 0, 0])
                    result == 0
                else:
                    false

    fn synchronize() -> bool:
        match self._mode:
            case Static: rt_rocm_synchronize()
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call0("hipDeviceSynchronize")
                    result == 0
                else:
                    false
