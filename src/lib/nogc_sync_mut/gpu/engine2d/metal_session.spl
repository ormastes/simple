"""Metal Session — MTLDevice + Command Queue + Pipeline Cache

@tag:stdlib
@tag:gpu

Owns a Metal device handle, command queue, and a flat pipeline cache.
macOS-only: init_device() returns an error string on non-macOS platforms.

Usage:
    val session = MetalComputeSession.create("compute")
    val err = session.init_device()
    if err != "":
        use std.io
        io.println(err)
"""

# ============================================================================
# Extern declarations (resolved at link time against Rust runtime)
# ============================================================================

@unsafe(reason: "raw Engine2D Metal availability ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_is_available() -> bool
@unsafe(reason: "raw Engine2D Metal device ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_create_device() -> i64
@unsafe(reason: "raw Engine2D Metal device-name ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_device_name(device: i64) -> text
@unsafe(reason: "raw Engine2D Metal queue ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_create_queue(device: i64) -> i64
@unsafe(reason: "raw Engine2D Metal library ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_create_library(device: i64, source: text) -> i64
@unsafe(reason: "raw Engine2D Metal pipeline ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_create_pipeline(device: i64, library: i64, fn_name: text) -> i64
@unsafe(reason: "raw Engine2D Metal command ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_begin_command(queue: i64) -> i64
@unsafe(reason: "raw Engine2D Metal commit ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_commit_command(cmd: i64) -> text
@unsafe(reason: "raw Engine2D Metal wait ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_wait_completion(cmd: i64) -> text
@unsafe(reason: "raw Engine2D Metal cleanup ABI; provider is not admitted", capabilities: [ffi])
extern fn rt_engine2d_metal_session_cleanup_device(device: i64) -> i64

fn metal_session_is_available() -> bool:
    rt_engine2d_metal_session_is_available()

fn metal_session_create_device() -> i64:
    rt_engine2d_metal_session_create_device()

fn metal_session_device_name(device: i64) -> text:
    rt_engine2d_metal_session_device_name(device)

fn metal_session_create_queue(device: i64) -> i64:
    rt_engine2d_metal_session_create_queue(device)

fn metal_session_create_library(device: i64, source: text) -> i64:
    rt_engine2d_metal_session_create_library(device, source)

fn metal_session_create_compute_pipeline(device: i64, library: i64, fn_name: text) -> i64:
    rt_engine2d_metal_session_create_pipeline(device, library, fn_name)

fn metal_session_begin_command(queue: i64) -> i64:
    rt_engine2d_metal_session_begin_command(queue)

fn metal_session_commit_command(cmd: i64) -> text:
    rt_engine2d_metal_session_commit_command(cmd)

fn metal_session_wait_completion(cmd: i64) -> text:
    rt_engine2d_metal_session_wait_completion(cmd)

fn metal_session_cleanup_device(device: i64) -> i64:
    rt_engine2d_metal_session_cleanup_device(device)

# ============================================================================
# MetalPipelineCache — flat storage for up to 4 named pipeline handles
# ============================================================================

class MetalPipelineCache:
    p0_name: text
    p0_handle: i64
    p1_name: text
    p1_handle: i64
    p2_name: text
    p2_handle: i64
    p3_name: text
    p3_handle: i64
    count: i64

    static fn create() -> MetalPipelineCache:
        MetalPipelineCache(
            p0_name: "", p0_handle: 0,
            p1_name: "", p1_handle: 0,
            p2_name: "", p2_handle: 0,
            p3_name: "", p3_handle: 0,
            count: 0)

    me cache_pipeline(name: text, handle: i64) -> text:
        if self.count == 0:
            self.p0_name = name
            self.p0_handle = handle
            self.count = 1
            return ""
        if self.count == 1:
            self.p1_name = name
            self.p1_handle = handle
            self.count = 2
            return ""
        if self.count == 2:
            self.p2_name = name
            self.p2_handle = handle
            self.count = 3
            return ""
        if self.count == 3:
            self.p3_name = name
            self.p3_handle = handle
            self.count = 4
            return ""
        "pipeline cache full (max 4)"

    me find_pipeline(name: text) -> i64:
        if self.p0_name == name:
            return self.p0_handle
        if self.p1_name == name:
            return self.p1_handle
        if self.p2_name == name:
            return self.p2_handle
        if self.p3_name == name:
            return self.p3_handle
        0

# ============================================================================
# MetalComputeSession
# ============================================================================

class MetalComputeSession:
    device_handle: i64
    queue_handle: i64
    device_name: text
    pipeline_cache: MetalPipelineCache
    library_count: i64
    command_count: i64
    mode: text
    cache_reject_count: i64
    last_cache_rejection: text

    static fn create(mode: text) -> MetalComputeSession:
        MetalComputeSession(
            device_handle: 0,
            queue_handle: 0,
            device_name: "",
            pipeline_cache: MetalPipelineCache.create(),
            library_count: 0,
            command_count: 0,
            mode: mode,
            cache_reject_count: 0,
            last_cache_rejection: "")

    # The caller supplies an already-admitted pipeline identity. This method
    # performs bounded cache bookkeeping only and never invokes Metal.
    me record_pipeline(name: text, handle: i64):
        val cache_result = self.pipeline_cache.cache_pipeline(name, handle)
        if cache_result != "":
            self.cache_reject_count = self.cache_reject_count + 1
            self.last_cache_rejection = "pipeline:{name}"

    me cache_reject_count_get() -> i64:
        self.cache_reject_count

    me last_cache_rejection_get() -> text:
        self.last_cache_rejection
