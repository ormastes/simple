"""Vulkan FFI Dispatch — Static/Dynamic Dual-Path

@tag:stdlib
@tag:gpu

Wraps all rt_vulkan_* extern functions behind a VulkanDynFfi class that
supports both static (extern fn) and dynamic (DynLib) dispatch.

Usage:
    val ffi = VulkanDynFfi.create(GpuFfiMode.Dynamic)
    if ffi.is_available():
        ffi.init()
"""

use std.sffi.dynamic.{DynLib}
use std.gpu.engine2d.ffi_dispatch.{GpuFfiMode, FfiDispatchBase, try_load_gpu_lib}

# ============================================================================
# Static extern declarations (resolved at link time against Rust runtime)
# ============================================================================

extern fn rt_vulkan_init() -> bool
extern fn rt_vulkan_shutdown() -> bool
extern fn rt_vulkan_is_available() -> bool
extern fn rt_vulkan_device_count() -> i64
extern fn rt_vulkan_select_device(id: i64) -> bool
extern fn rt_vulkan_alloc_buffer(size: i64, usage: i64) -> i64
extern fn rt_vulkan_free_buffer(handle: i64) -> bool
extern fn rt_vulkan_copy_to_buffer(handle: i64, data: [u8], offset: i64) -> bool
extern fn rt_vulkan_copy_from_buffer(data: [u8], handle: i64, offset: i64) -> bool
extern fn rt_vulkan_compile_glsl(glsl_source: text) -> i64
extern fn rt_vulkan_destroy_shader(module: i64) -> bool
extern fn rt_vulkan_create_compute_pipeline(shader_module: i64, entry_point: text, push_constant_size: i64) -> i64
extern fn rt_vulkan_destroy_pipeline(pipe: i64) -> bool
extern fn rt_vulkan_create_descriptor_set(pipe: i64) -> i64
extern fn rt_vulkan_bind_buffer(descriptor_set: i64, binding: i64, buf: i64) -> bool
extern fn rt_vulkan_destroy_descriptor_set(descriptor_set: i64) -> bool
extern fn rt_vulkan_begin_compute() -> i64
extern fn rt_vulkan_bind_pipeline(cmd: i64, pipe: i64) -> bool
extern fn rt_vulkan_bind_descriptors(cmd: i64, descriptor_set: i64) -> bool
extern fn rt_vulkan_push_constants(cmd: i64, pipe: i64, data: [u8]) -> bool
extern fn rt_vulkan_dispatch(cmd: i64, x: i64, y: i64, z: i64) -> bool
extern fn rt_vulkan_end_compute(cmd: i64) -> bool
extern fn rt_vulkan_submit_and_wait(cmd: i64) -> bool
extern fn rt_vulkan_wait_idle() -> bool

# ============================================================================
# VulkanDynFfi
# ============================================================================

class VulkanDynFfi:
    _mode: GpuFfiMode
    _dyn_lib: DynLib?
    _dyn_rejected_ops: i64 = 0
    _dyn_last_rejection: text = ""

impl FfiDispatchBase for VulkanDynFfi:

    fn mode() -> GpuFfiMode:
        self._mode

    fn rejected_op_count() -> i64:
        """Count of Dynamic-mode operations honestly rejected because
        real libvulkan.so exports no (struct-based) symbol this raw
        call0..call4(i64...) FFI mechanism can invoke. Static mode never
        increments this."""
        self._dyn_rejected_ops

    fn last_rejection() -> text:
        """Name of the most recently rejected Dynamic-mode operation, or
        empty text if none has been rejected yet."""
        self._dyn_last_rejection

    me _dyn_reject_bool(op: text) -> bool:
        """Honest-gate primitive for bool-returning Dynamic-mode ops: no
        real libvulkan symbol exists for these (they are Rust-runtime-side
        rt_vulkan_* names, not vkCreateInstance/vkAllocateMemory/... driver
        exports), so record the rejection instead of dlsym'ing a
        nonexistent export and silently no-opping."""
        self._dyn_rejected_ops = self._dyn_rejected_ops + 1
        self._dyn_last_rejection = op
        false

    me _dyn_reject_i64(op: text) -> i64:
        """Same as `_dyn_reject_bool` for i64-returning ops."""
        self._dyn_rejected_ops = self._dyn_rejected_ops + 1
        self._dyn_last_rejection = op
        0

    # --- Constructors -------------------------------------------------------

    static fn create_static() -> VulkanDynFfi:
        VulkanDynFfi(_mode: GpuFfiMode.Static, _dyn_lib: nil, _dyn_rejected_ops: 0, _dyn_last_rejection: "")

    static fn create_dynamic() -> VulkanDynFfi?:
        val lib = try_load_gpu_lib("vulkan")
        if lib == nil:
            return nil
        VulkanDynFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: lib, _dyn_rejected_ops: 0, _dyn_last_rejection: "")

    static fn create_dynamic_from(path: text) -> VulkanDynFfi?:
        val lib = DynLib.load(path)
        if lib == nil:
            return nil
        VulkanDynFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: lib, _dyn_rejected_ops: 0, _dyn_last_rejection: "")

    static fn create(ffi_mode: GpuFfiMode) -> VulkanDynFfi?:
        match ffi_mode:
            case Dynamic:
                val dyn_ffi = VulkanDynFfi.create_dynamic()
                if dyn_ffi != nil:
                    return dyn_ffi
                VulkanDynFfi.create_static()
            case Static:
                VulkanDynFfi.create_static()

    # --- Dispatch methods ---------------------------------------------------

    fn is_available() -> bool:
        """Static mode: real rt_vulkan_is_available() driver probe.
        Dynamic mode: always false. The loader can resolve the real
        `vkEnumerateInstanceVersion` export (see `loader_probe()` below
        for that raw signal), but every operation this class dispatches
        in Dynamic mode (init/alloc_buffer/dispatch/...) has no matching
        libvulkan export reachable through the raw call0..call4(i64...)
        FFI -- those are Rust-runtime-internal rt_vulkan_* names, not
        driver entry points, and driver entry points that DO exist
        (vkCreateInstance, vkAllocateMemory, ...) take struct pointers
        this FFI cannot marshal. Reporting true here would be exactly
        the fake-honesty-signal this class was audited for: a capability
        gate that does not exercise the capability. See
        `rejected_op_count()`/`last_rejection()` for the counted proof.
        """
        match self._mode:
            case Static: rt_vulkan_is_available()
            case Dynamic: false

    fn loader_probe() -> bool:
        """Raw signal only: does the dynamically-loaded library resolve
        the real `vkEnumerateInstanceVersion` export? True here means
        'a Vulkan loader is present', NOT 'this class can drive it' --
        callers must use `is_available()` for the latter.
        Static mode always reports false (no dynamic loader involved).
        """
        match self._mode:
            case Static: false
            case Dynamic:
                if self._dyn_lib != nil:
                    val result = self._dyn_lib.call0("vkEnumerateInstanceVersion")
                    result != 0
                else:
                    false

    me init() -> bool:
        match self._mode:
            case Static: rt_vulkan_init()
            case Dynamic: self._dyn_reject_bool("init")

    me shutdown() -> bool:
        match self._mode:
            case Static: rt_vulkan_shutdown()
            case Dynamic: self._dyn_reject_bool("shutdown")

    me device_count() -> i64:
        match self._mode:
            case Static: rt_vulkan_device_count()
            case Dynamic: self._dyn_reject_i64("device_count")

    me select_device(id: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_select_device(id)
            case Dynamic: self._dyn_reject_bool("select_device")

    me alloc_buffer(size: i64, usage: i64) -> i64:
        match self._mode:
            case Static: rt_vulkan_alloc_buffer(size, usage)
            case Dynamic: self._dyn_reject_i64("alloc_buffer")

    me free_buffer(handle: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_free_buffer(handle)
            case Dynamic: self._dyn_reject_bool("free_buffer")

    fn copy_to_buffer(handle: i64, data: [u8], offset: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_copy_to_buffer(handle, data, offset)
            case Dynamic: false

    fn copy_from_buffer(data: [u8], handle: i64, offset: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_copy_from_buffer(data, handle, offset)
            case Dynamic: false

    me compile_glsl(source: text) -> i64:
        match self._mode:
            case Static: rt_vulkan_compile_glsl(source)
            case Dynamic: self._dyn_reject_i64("compile_glsl")

    me create_compute_pipeline(shader: i64, entry: text, pc_size: i64) -> i64:
        if entry == "" or entry.contains("\0"):
            return 0
        match self._mode:
            case Static: rt_vulkan_create_compute_pipeline(shader, entry, pc_size)
            case Dynamic: self._dyn_reject_i64("create_compute_pipeline")

    me create_descriptor_set(pipe: i64) -> i64:
        match self._mode:
            case Static: rt_vulkan_create_descriptor_set(pipe)
            case Dynamic: self._dyn_reject_i64("create_descriptor_set")

    me bind_buffer(descriptor_set: i64, binding: i64, buf: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_bind_buffer(descriptor_set, binding, buf)
            case Dynamic: self._dyn_reject_bool("bind_buffer")

    me destroy_descriptor_set(descriptor_set: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_destroy_descriptor_set(descriptor_set)
            case Dynamic: self._dyn_reject_bool("destroy_descriptor_set")

    me begin_compute() -> i64:
        match self._mode:
            case Static: rt_vulkan_begin_compute()
            case Dynamic: self._dyn_reject_i64("begin_compute")

    me bind_pipeline(cmd: i64, pipe: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_bind_pipeline(cmd, pipe)
            case Dynamic: self._dyn_reject_bool("bind_pipeline")

    me bind_descriptors(cmd: i64, ds: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_bind_descriptors(cmd, ds)
            case Dynamic: self._dyn_reject_bool("bind_descriptors")

    fn push_constants(cmd: i64, pipe: i64, data: [u8]) -> bool:
        match self._mode:
            case Static: rt_vulkan_push_constants(cmd, pipe, data)
            case Dynamic: false

    me dispatch(cmd: i64, x: i64, y: i64, z: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_dispatch(cmd, x, y, z)
            case Dynamic: self._dyn_reject_bool("dispatch")

    me end_compute(cmd: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_end_compute(cmd)
            case Dynamic: self._dyn_reject_bool("end_compute")

    me submit_and_wait(cmd: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_submit_and_wait(cmd)
            case Dynamic: self._dyn_reject_bool("submit_and_wait")

    me wait_idle() -> bool:
        match self._mode:
            case Static: rt_vulkan_wait_idle()
            case Dynamic: self._dyn_reject_bool("wait_idle")

    me destroy_shader(module: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_destroy_shader(module)
            case Dynamic: self._dyn_reject_bool("destroy_shader")

    me destroy_pipeline(pipe: i64) -> bool:
        match self._mode:
            case Static: rt_vulkan_destroy_pipeline(pipe)
            case Dynamic: self._dyn_reject_bool("destroy_pipeline")

fn vulkan_ffi_init() -> bool:
    rt_vulkan_init()

fn vulkan_ffi_shutdown() -> bool:
    rt_vulkan_shutdown()

fn vulkan_ffi_is_available() -> bool:
    rt_vulkan_is_available()

fn vulkan_ffi_device_count() -> i64:
    rt_vulkan_device_count()

fn vulkan_ffi_select_device(id: i64) -> bool:
    rt_vulkan_select_device(id)

fn vulkan_ffi_alloc_buffer(size: i64, usage: i64) -> i64:
    rt_vulkan_alloc_buffer(size, usage)

fn vulkan_ffi_free_buffer(handle: i64) -> bool:
    rt_vulkan_free_buffer(handle)

fn vulkan_ffi_compile_glsl(glsl_source: text) -> i64:
    rt_vulkan_compile_glsl(glsl_source)

fn vulkan_ffi_destroy_shader(module: i64) -> bool:
    rt_vulkan_destroy_shader(module)

fn vulkan_ffi_create_compute_pipeline(shader_module: i64, entry_point: text, push_constant_size: i64) -> i64:
    rt_vulkan_create_compute_pipeline(shader_module, entry_point, push_constant_size)

fn vulkan_ffi_destroy_pipeline(pipe: i64) -> bool:
    rt_vulkan_destroy_pipeline(pipe)

fn vulkan_ffi_create_descriptor_set(pipe: i64) -> i64:
    rt_vulkan_create_descriptor_set(pipe)

fn vulkan_ffi_bind_buffer(descriptor_set: i64, binding: i64, buf: i64) -> bool:
    rt_vulkan_bind_buffer(descriptor_set, binding, buf)

fn vulkan_ffi_destroy_descriptor_set(descriptor_set: i64) -> bool:
    rt_vulkan_destroy_descriptor_set(descriptor_set)

fn vulkan_ffi_begin_compute() -> i64:
    rt_vulkan_begin_compute()

fn vulkan_ffi_bind_pipeline(cmd: i64, pipe: i64) -> bool:
    rt_vulkan_bind_pipeline(cmd, pipe)

fn vulkan_ffi_bind_descriptors(cmd: i64, descriptor_set: i64) -> bool:
    rt_vulkan_bind_descriptors(cmd, descriptor_set)

fn vulkan_ffi_push_constants(cmd: i64, pipe: i64, data: [u8]) -> bool:
    rt_vulkan_push_constants(cmd, pipe, data)

fn vulkan_ffi_dispatch(cmd: i64, x: i64, y: i64, z: i64) -> bool:
    rt_vulkan_dispatch(cmd, x, y, z)

fn vulkan_ffi_end_compute(cmd: i64) -> bool:
    rt_vulkan_end_compute(cmd)

fn vulkan_ffi_submit_and_wait(cmd: i64) -> bool:
    rt_vulkan_submit_and_wait(cmd)

fn vulkan_ffi_copy_from_buffer(data: [u8], handle: i64, offset: i64) -> bool:
    rt_vulkan_copy_from_buffer(data, handle, offset)

fn vulkan_ffi_copy_to_buffer(handle: i64, data: [u8], offset: i64) -> bool:
    rt_vulkan_copy_to_buffer(handle, data, offset)

fn vulkan_ffi_wait_idle() -> bool:
    rt_vulkan_wait_idle()
