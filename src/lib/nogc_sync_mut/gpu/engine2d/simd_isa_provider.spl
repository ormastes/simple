"""x86_64 SIMD ISA provider for the per-op kernel registry (lane: SIMD provider).

@tag:stdlib
@tag:gpu

Wraps the existing native row kernels (`rt_engine2d_simd_fill_row_u32`,
`rt_engine2d_simd_blend_row_u32` in src/runtime/runtime_simd_dispatch.c,
dispatched there to real AVX2/SSE2 intrinsics behind a CPUID probe — see
`rt_simd_has_avx2`/`rt_simd_has_sse`) as a `fill_const` / `src_over_const`
provider measured against `common.gpu.engine2d.scalar_oracle`.

Why extern and not pure Simple: Simple has no packed-SIMD-lane intrinsics,
inline asm, or `_mm256_*`-equivalent builtins (grepped src/lib, src/compiler,
src/runtime for `simd`/`avx`/`sse`/`__m128`/`vector<` — the only place packed
x86 lanes actually appear is `src/runtime/runtime_simd_dispatch.c`, guarded by
`__attribute__((target("avx2")))`). `src.lib.nogc_sync_mut.simd.vector` is a
structural trait/marker (C2 §1.1), not a lowering — nothing in the compiler
turns it into vector instructions. So a *hardware-access primitive* (issuing
real AVX2/SSE2 instructions) is genuinely inexpressible in pure Simple today;
this module reuses the extern channel the tree already established for that
exact reason (`simd_kernels.spl`), rather than introducing a new one.

Honesty note carried over from kernel_registry.spl's own docstring: the
native-row path this wraps was PREVIOUSLY measured slower than scalar at 8K
(1282.2 ms vs 909.5 ms, fill_const) and was filed for corrupt colours on
src_over_image. This module does its own bit-exactness and timing pass
per-op instead of assuming that verdict carries over; see
test/01_unit/lib/nogc_sync_mut/gpu/engine2d/simd_isa_provider_spec.spl for the
actual numbers this run produced.
"""

use std.nogc_sync_mut.gpu.engine2d.simd_native_rows.{
    engine2d_simd_fill_row_u32,
    engine2d_simd_blend_row_u32,
    engine2d_simd_blend_span_u32,
    engine2d_simd_blend_const_span_u32,
}
use common.gpu.engine2d.scalar_oracle.{
    oracle_modulate_alpha,
    oracle_fill_const,
    oracle_copy_span,
    oracle_src_over_const,
    oracle_src_over_image,
    oracle_mask_src_over,
}
use common.gpu.engine2d.kernel_registry.{
    CpuKernelTable,
    SpanOpBatch,
    kernel_table_lookup,
    kernel_size_bucket,
    KERNEL_PROVIDER_SCALAR,
    KERNEL_PROVIDER_SIMD_ISA,
    KERNEL_OP_FILL_CONST,
    KERNEL_OP_COPY_SPAN,
    KERNEL_OP_SRC_OVER_CONST,
    KERNEL_OP_SRC_OVER_IMAGE,
    KERNEL_OP_MASK_SRC_OVER,
}

# --- fill_const --------------------------------------------------------------

fn simd_isa_fill_const(mut dst: [u32], offset: i64, count: i64, colour: i64):
    """fill_const via the native row kernel. Same contract as
    oracle_fill_const: a verbatim store, no blending."""
    if count <= 0:
        return
    val row = engine2d_simd_fill_row_u32(count, colour as u32)
    if row.len() != count.to_i32():
        # Native kernel under-produced (allocation failure or size mismatch) —
        # fall back to a scalar store rather than write a partial/garbage row.
        var i: i64 = 0
        while i < count:
            dst[(offset + i).to_i32()] = colour as u32
            i = i + 1
        return
    var j: i64 = 0
    while j < count:
        dst[(offset + j).to_i32()] = row[j.to_i32()]
        j = j + 1

# --- src_over_const ------------------------------------------------------

fn simd_isa_src_over_const(mut dst: [u32], offset: i64, count: i64, colour: i64):
    """src_over_const via the native blend-row kernel: build a constant-colour
    src row and blend it against the gathered dst row, matching
    oracle_src_over_const (sa==0 no-op included)."""
    if count <= 0:
        return
    val sa = (colour >> 24) & 0xFF
    if sa == 0:
        return
    val n = count.to_i32()
    var dst_row: [u32] = [0; n]
    var src_row: [u32] = [0; n]
    var i: i64 = 0
    while i < count:
        dst_row[i.to_i32()] = dst[(offset + i).to_i32()]
        src_row[i.to_i32()] = colour as u32
        i = i + 1
    val blended = engine2d_simd_blend_row_u32(dst_row, src_row)
    if blended.len() != n:
        return
    var j: i64 = 0
    while j < count:
        dst[(offset + j).to_i32()] = blended[j.to_i32()]
        j = j + 1

# --- src_over_image --------------------------------------------------------

fn simd_isa_src_over_image(mut dst: [u32], dst_offset: i64, src: [u32],
                           src_offset: i64, count: i64):
    """src_over_image via the native blend-row kernel: gather real dst/src
    rows (not a constant colour) and blend, matching oracle_src_over_image
    pixel-for-pixel including the sa==0 no-op carried by oracle_src_over
    itself (the kernel leaves such pixels untouched, same as the oracle)."""
    if count <= 0:
        return
    val n = count.to_i32()
    var dst_row: [u32] = [0; n]
    var src_row: [u32] = [0; n]
    var i: i64 = 0
    while i < count:
        dst_row[i.to_i32()] = dst[(dst_offset + i).to_i32()]
        src_row[i.to_i32()] = src[(src_offset + i).to_i32()]
        i = i + 1
    val blended = engine2d_simd_blend_row_u32(dst_row, src_row)
    if blended.len() != n:
        return
    var j: i64 = 0
    while j < count:
        dst[(dst_offset + j).to_i32()] = blended[j.to_i32()]
        j = j + 1

# --- mask_src_over -----------------------------------------------------------

fn simd_isa_mask_src_over(mut dst: [u32], dst_offset: i64, colour: i64,
                          mask: [u32], mask_offset: i64, count: i64):
    """mask_src_over via the native blend-row kernel: pre-modulate the
    constant colour's alpha by each pixel's coverage (oracle_modulate_alpha,
    pure Simple — coverage scales alpha only, RGB rides through untouched)
    into a per-pixel src row, then blend. A coverage of 0 modulates alpha to
    0, and the blend kernel's sa==0 path leaves dst untouched — matching the
    oracle's explicit `if m > 0` skip without a separate branch here."""
    if count <= 0:
        return
    val n = count.to_i32()
    var dst_row: [u32] = [0; n]
    var src_row: [u32] = [0; n]
    var i: i64 = 0
    while i < count:
        val m = mask[(mask_offset + i).to_i32()] as i64
        dst_row[i.to_i32()] = dst[(dst_offset + i).to_i32()]
        src_row[i.to_i32()] = oracle_modulate_alpha(colour, m) as u32
        i = i + 1
    val blended = engine2d_simd_blend_row_u32(dst_row, src_row)
    if blended.len() != n:
        return
    var j: i64 = 0
    while j < count:
        dst[(dst_offset + j).to_i32()] = blended[j.to_i32()]
        j = j + 1

# --- blend_span / blend_const_span (in-place, no malloc) ---------------------
#
# Alternative to simd_isa_src_over_image/simd_isa_src_over_const above: those
# two gather dst/src into fresh row buffers and call the malloc-per-call
# blend-ROW kernel; these call the in-place blend-SPAN kernel directly
# (rt_engine2d_simd_blend_span_u32 / rt_engine2d_simd_blend_const_span_u32,
# src/runtime/runtime_simd_dispatch.c) with zero heap allocation and no
# gather/scatter copy loop. See
# doc/03_plan/ui/perf/engine2d_simd_blend_span_kernel_design_plan_2026-08-07.md.
# These are the real SIMD-dispatch implementations for the two blend slots.
# The caller's kernel table still admits either slot only after its timing gate
# proves exactness and a win for that bucket.  Crucially, the native ABI edits
# `dst` in place and returns that same array only as an FFI convention: copying
# the returned span back over `dst` here used to add a second full row walk.

fn simd_isa_blend_span(mut dst: [u32], dst_offset: i64, src: [u32],
                       src_offset: i64, count: i64):
    """src_over_image via the in-place blend-span kernel (no malloc, no
    gather/scatter row buffers), matching oracle_src_over_image."""
    if count <= 0:
        return
    # The C ABI validates both spans, changes dst in place, and returns dst.
    # Keep the returned value only as a fail-closed ABI-shape check; do not
    # rescan the span and copy it back into itself.
    val result = engine2d_simd_blend_span_u32(dst, dst_offset, src, src_offset, count)
    if result.len() != dst.len():
        return

fn simd_isa_blend_const_span(mut dst: [u32], offset: i64, count: i64, colour: i64):
    """src_over_const via the in-place blend-const-span kernel (no malloc, no
    row buffers), matching oracle_src_over_const (sa==0 no-op included)."""
    if count <= 0:
        return
    # As above, the returned array is the same in-place destination.
    val result = engine2d_simd_blend_const_span_u32(dst, offset, count, colour)
    if result.len() != dst.len():
        return

# --- real per-op dispatcher --------------------------------------------------
#
# kernel_registry.span_batch_execute (common tier) cannot call these SIMD
# functions without inverting the tier order, so it always executes via the
# scalar oracle and only records which slots WOULD have picked a non-scalar
# provider (`batch.non_scalar_lookups`). This function is the actual
# production dispatcher: it lives in the higher `nogc_sync_mut` tier, so it
# can import both the registry/oracle (common) and the SIMD providers
# (this module), and it genuinely branches per op on `kernel_table_lookup`.

fn simd_span_batch_execute(mut batch: SpanOpBatch, mut dst: [u32], src: [u32],
                           mask: [u32], mut table: CpuKernelTable,
                           format: i64, alignment: i64, contiguity: i64) -> i64:
    """Run every op in the batch, dispatching to the registered provider.
    Returns the number of ops executed. Falls back to the scalar oracle for
    any op whose slot is not registered to KERNEL_PROVIDER_SIMD_ISA."""
    var executed: i64 = 0
    var i: i64 = 0
    while i < batch.length:
        val idx = i.to_i32()
        val op = batch.ops[idx]
        val count = batch.counts[idx]
        if count > 0:
            val bucket = kernel_size_bucket(count)
            val provider = kernel_table_lookup(table, op, format, alignment, contiguity, bucket)
            val use_simd = provider == KERNEL_PROVIDER_SIMD_ISA
            if use_simd:
                batch.non_scalar_lookups = batch.non_scalar_lookups + 1
            val dst_off = batch.dst_offsets[idx]
            val src_off = batch.src_offsets[idx]
            if op == KERNEL_OP_FILL_CONST:
                if use_simd:
                    simd_isa_fill_const(dst, dst_off, count, batch.colours[idx])
                else:
                    oracle_fill_const(dst, dst_off, count, batch.colours[idx])
                executed = executed + 1
            elif op == KERNEL_OP_COPY_SPAN:
                oracle_copy_span(dst, dst_off, src, src_off, count)
                executed = executed + 1
            elif op == KERNEL_OP_SRC_OVER_CONST:
                if use_simd:
                    simd_isa_blend_const_span(dst, dst_off, count, batch.colours[idx])
                else:
                    oracle_src_over_const(dst, dst_off, count, batch.colours[idx])
                executed = executed + 1
            elif op == KERNEL_OP_SRC_OVER_IMAGE:
                if use_simd:
                    simd_isa_blend_span(dst, dst_off, src, src_off, count)
                else:
                    oracle_src_over_image(dst, dst_off, src, src_off, count)
                executed = executed + 1
            elif op == KERNEL_OP_MASK_SRC_OVER:
                if use_simd:
                    simd_isa_mask_src_over(dst, dst_off, batch.colours[idx], mask,
                                           batch.mask_offsets[idx], count)
                else:
                    oracle_mask_src_over(dst, dst_off, batch.colours[idx], mask,
                                         batch.mask_offsets[idx], count)
                executed = executed + 1
        i = i + 1
    executed
