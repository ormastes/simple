"""Vulkan Session — Instance, Device, Queue, Allocator, Command Pools, Caches

@tag:stdlib
@tag:gpu

Owns the full Vulkan session lifetime: instance → device → queue → allocator →
command pool(s) → pipeline cache → descriptor pool. SPIR-V only (no GLSL).

Thread policy:
  "single"  — one shared command pool for all frames
  "multi"   — per-frame command pools created on begin_frame

Usage:
    val sess = VulkanComputeSession.create("2d", "single")
    sess.init_device()
    val cmd = sess.begin_frame(1920, 1080)
    sess.submit_frame(cmd)
    sess.release()
"""

# ============================================================================
# Extern declarations
# ============================================================================

extern fn rt_vk_create_instance() -> i64
extern fn rt_vk_create_device(instance: i64) -> i64
extern fn rt_vk_get_queue(device: i64, family: i64) -> i64
extern fn rt_vk_create_allocator(device: i64) -> i64
extern fn rt_vk_create_cmd_pool(device: i64, family: i64) -> i64
extern fn rt_vk_create_pipeline_cache(device: i64) -> i64
extern fn rt_vk_create_descriptor_pool(device: i64) -> i64
extern fn rt_vk_load_spirv(device: i64, spirv_name: text) -> i64
extern fn rt_vk_destroy_device(device: i64) -> i64
extern fn rt_vk_destroy_instance(instance: i64) -> i64

# Additional session operations
extern fn rt_vk_alloc_cmd_buffer(pool: i64) -> i64
extern fn rt_vk_begin_cmd(cmd: i64) -> bool
extern fn rt_vk_end_cmd(cmd: i64) -> bool
extern fn rt_vk_queue_submit(queue: i64, cmd: i64) -> bool
extern fn rt_vk_queue_wait_idle(queue: i64) -> bool
extern fn rt_vk_present(queue: i64, cmd: i64) -> bool
extern fn rt_vk_readback(cmd: i64, x: i64, y: i64, w: i64, h: i64) -> bool
extern fn rt_vk_device_name(device: i64) -> text
extern fn rt_vk_destroy_cmd_pool(pool: i64) -> bool

fn vulkan_session_create_instance() -> i64:
    rt_vk_create_instance()

fn vulkan_session_create_device(instance: i64) -> i64:
    rt_vk_create_device(instance)

fn vulkan_session_get_queue(device: i64, family: i64) -> i64:
    rt_vk_get_queue(device, family)

fn vulkan_session_create_allocator(device: i64) -> i64:
    rt_vk_create_allocator(device)

fn vulkan_session_create_cmd_pool(device: i64, family: i64) -> i64:
    rt_vk_create_cmd_pool(device, family)

fn vulkan_session_create_pipeline_cache(device: i64) -> i64:
    rt_vk_create_pipeline_cache(device)

fn vulkan_session_create_descriptor_pool(device: i64) -> i64:
    rt_vk_create_descriptor_pool(device)

fn vulkan_session_load_spirv(device: i64, spirv_name: text) -> i64:
    rt_vk_load_spirv(device, spirv_name)

fn vulkan_session_destroy_device(device: i64) -> i64:
    rt_vk_destroy_device(device)

fn vulkan_session_destroy_instance(instance: i64) -> i64:
    rt_vk_destroy_instance(instance)

fn vulkan_session_alloc_cmd_buffer(pool: i64) -> i64:
    rt_vk_alloc_cmd_buffer(pool)

fn vulkan_session_begin_cmd(cmd: i64) -> bool:
    rt_vk_begin_cmd(cmd)

fn vulkan_session_end_cmd(cmd: i64) -> bool:
    rt_vk_end_cmd(cmd)

fn vulkan_session_queue_submit(queue: i64, cmd: i64) -> bool:
    rt_vk_queue_submit(queue, cmd)

fn vulkan_session_queue_wait_idle(queue: i64) -> bool:
    rt_vk_queue_wait_idle(queue)

fn vulkan_session_present(queue: i64, cmd: i64) -> bool:
    rt_vk_present(queue, cmd)

fn vulkan_session_readback(cmd: i64, x: i64, y: i64, w: i64, h: i64) -> bool:
    rt_vk_readback(cmd, x, y, w, h)

fn vulkan_session_device_name(device: i64) -> text:
    rt_vk_device_name(device)

fn vulkan_session_destroy_cmd_pool(pool: i64) -> bool:
    rt_vk_destroy_cmd_pool(pool)

# ============================================================================
# VulkanShaderCache — flat storage for up to 4 named SPIR-V module handles
#
# Mirrors CudaModuleCache / MetalPipelineCache exactly (same 4 slots, same
# "cache full" sentinel return, same fail-closed find). Before this cache
# existed, `VulkanComputeSession.load_shader()` re-invoked `rt_vk_load_spirv` on
# every call for an already-loaded name, leaking one native VkShaderModule
# per call -- the same leak class the CUDA/Metal caches close.
# ============================================================================

class VulkanShaderCache:
    s0_name: text
    s0_handle: i64
    s1_name: text
    s1_handle: i64
    s2_name: text
    s2_handle: i64
    s3_name: text
    s3_handle: i64
    count: i64

    static fn create() -> VulkanShaderCache:
        VulkanShaderCache(
            s0_name: "", s0_handle: 0,
            s1_name: "", s1_handle: 0,
            s2_name: "", s2_handle: 0,
            s3_name: "", s3_handle: 0,
            count: 0
        )

    me cache_shader(name: text, handle: i64) -> text:
        if self.count == 0:
            self.s0_name = name
            self.s0_handle = handle
            self.count = 1
            return "ok"
        if self.count == 1:
            self.s1_name = name
            self.s1_handle = handle
            self.count = 2
            return "ok"
        if self.count == 2:
            self.s2_name = name
            self.s2_handle = handle
            self.count = 3
            return "ok"
        if self.count == 3:
            self.s3_name = name
            self.s3_handle = handle
            self.count = 4
            return "ok"
        "cache_full"

    me find_shader(name: text) -> i64:
        if self.s0_name == name:
            return self.s0_handle
        if self.s1_name == name:
            return self.s1_handle
        if self.s2_name == name:
            return self.s2_handle
        if self.s3_name == name:
            return self.s3_handle
        0

# ============================================================================
# VulkanComputeSession
# ============================================================================

class VulkanComputeSession:
    instance_handle: i64
    device_handle: i64
    queue_handle: i64
    queue_family: i64
    allocator_handle: i64
    cmd_pool_handle: i64
    pipeline_cache_handle: i64
    descriptor_pool_handle: i64
    shader_count: i64
    mode: text
    thread_policy: text
    initialized: bool
    generation: i64
    device_name: text
    transient_cmd_pools: [i64]
    transient_cmd_pool_created_count: i64
    transient_cmd_pool_destroyed_count: i64
    shader_cache: VulkanShaderCache
    cache_reject_count: i64
    last_cache_rejection: text

    static fn create(mode: text, thread_policy: text) -> VulkanComputeSession:
        VulkanComputeSession(
            instance_handle: 0,
            device_handle: 0,
            queue_handle: 0,
            queue_family: 0,
            allocator_handle: 0,
            cmd_pool_handle: 0,
            pipeline_cache_handle: 0,
            descriptor_pool_handle: 0,
            shader_count: 0,
            mode: mode,
            thread_policy: thread_policy,
            initialized: false,
            generation: 0,
            device_name: "",
            transient_cmd_pools: [],
            transient_cmd_pool_created_count: 0,
            transient_cmd_pool_destroyed_count: 0,
            shader_cache: VulkanShaderCache.create(),
            cache_reject_count: 0,
            last_cache_rejection: ""
        )

    me init_device() -> text:
        val inst = vulkan_session_create_instance()
        if inst <= 0:
            return "error: vkCreateInstance failed"
        self.instance_handle = inst

        val dev = vulkan_session_create_device(inst)
        if dev <= 0:
            return "error: vkCreateDevice failed"
        self.device_handle = dev
        self.device_name = vulkan_session_device_name(dev)

        self.queue_family = 0
        val q = vulkan_session_get_queue(dev, self.queue_family)
        if q <= 0:
            return "error: vkGetDeviceQueue failed"
        self.queue_handle = q

        val alloc = vulkan_session_create_allocator(dev)
        if alloc <= 0:
            return "error: vmaCreateAllocator failed"
        self.allocator_handle = alloc

        self.initialized = true
        self.generation = self.generation + 1
        "ok"

    me create_command_pool() -> text:
        if self.initialized == false:
            return "error: device not initialized"
        val pool = vulkan_session_create_cmd_pool(self.device_handle, self.queue_family)
        if pool <= 0:
            return "error: vkCreateCommandPool failed"
        self.cmd_pool_handle = pool
        "ok"

    me create_pipeline_cache() -> text:
        if self.initialized == false:
            return "error: device not initialized"
        val pc = vulkan_session_create_pipeline_cache(self.device_handle)
        if pc <= 0:
            return "error: vkCreatePipelineCache failed"
        self.pipeline_cache_handle = pc

        val dp = vulkan_session_create_descriptor_pool(self.device_handle)
        if dp <= 0:
            return "error: vkCreateDescriptorPool failed"
        self.descriptor_pool_handle = dp
        "ok"

    me load_shader(name: text) -> i64:
        if self.initialized == false:
            return 0
        val cached = self.shader_cache.find_shader(name)
        if cached != 0:
            return cached
        val handle = vulkan_session_load_spirv(self.device_handle, name)
        if handle > 0:
            self.shader_count = self.shader_count + 1
            return self.record_shader(name, handle)
        handle

    # Extracted so the cache-and-count bookkeeping is directly testable
    # without a real native VkShaderModule from `rt_vk_load_spirv` (that
    # extern is registered only for the JIT/native codegen path, not the
    # tree-walk interpreter `bin/simple test` runs on). Always returns
    # `handle` unchanged -- bookkeeping, not a gate.
    me record_shader(name: text, handle: i64) -> i64:
        val cache_result = self.shader_cache.cache_shader(name, handle)
        if cache_result == "cache_full":
            self.cache_reject_count = self.cache_reject_count + 1
            self.last_cache_rejection = "shader:{name}"
        handle

    me begin_frame(width: i64, height: i64) -> i64:
        if self.initialized == false:
            return 0
        var pool = self.cmd_pool_handle
        if self.thread_policy == "multi":
            pool = vulkan_session_create_cmd_pool(self.device_handle, self.queue_family)
            if pool <= 0:
                return 0
            self.track_transient_pool(pool)
        val cmd = vulkan_session_alloc_cmd_buffer(pool)
        if cmd <= 0:
            return 0
        val ok = vulkan_session_begin_cmd(cmd)
        if ok == false:
            return 0
        cmd

    fn submit_frame(cmd: i64) -> text:
        if cmd <= 0:
            return "error: invalid cmd buffer"
        val ended = vulkan_session_end_cmd(cmd)
        if ended == false:
            return "error: vkEndCommandBuffer failed"
        val submitted = vulkan_session_queue_submit(self.queue_handle, cmd)
        if submitted == false:
            return "error: vkQueueSubmit failed"
        "ok"

    fn present(cmd: i64) -> text:
        if cmd == 0:
            return "error: invalid cmd buffer"
        val ok = vulkan_session_present(self.queue_handle, cmd)
        if ok == false:
            return "error: vkQueuePresentKHR failed"
        "ok"

    fn sync_readback(cmd: i64, x: i64, y: i64, w: i64, h: i64) -> text:
        if cmd == 0:
            return "error: invalid cmd buffer"
        val waited = vulkan_session_queue_wait_idle(self.queue_handle)
        if waited == false:
            return "error: queue wait idle failed"
        val ok = vulkan_session_readback(cmd, x, y, w, h)
        if ok == false:
            return "error: readback failed"
        "ok"

    # Extracted so the leaked-pool bookkeeping (previously nonexistent: a
    # "multi"-policy pool created in `begin_frame()` was tracked nowhere)
    # is directly testable without a real native pool handle.
    me track_transient_pool(pool: i64):
        self.transient_cmd_pools.push(pool)
        self.transient_cmd_pool_created_count = self.transient_cmd_pool_created_count + 1

    me release() -> text:
        if self.initialized == false:
            return "ok"
        var i = 0
        while i < self.transient_cmd_pools.len():
            vulkan_session_destroy_cmd_pool(self.transient_cmd_pools[i])
            self.transient_cmd_pool_destroyed_count = self.transient_cmd_pool_destroyed_count + 1
            i = i + 1
        self.transient_cmd_pools = []
        if self.cmd_pool_handle != 0:
            vulkan_session_destroy_cmd_pool(self.cmd_pool_handle)
            self.cmd_pool_handle = 0
        if self.device_handle != 0:
            vulkan_session_destroy_device(self.device_handle)
            self.device_handle = 0
        if self.instance_handle != 0:
            vulkan_session_destroy_instance(self.instance_handle)
            self.instance_handle = 0
        self.initialized = false
        "ok"

    fn transient_cmd_pool_created_count_get() -> i64:
        self.transient_cmd_pool_created_count

    fn transient_cmd_pool_destroyed_count_get() -> i64:
        self.transient_cmd_pool_destroyed_count

    fn cache_reject_count_get() -> i64:
        self.cache_reject_count

    fn last_cache_rejection_get() -> text:
        self.last_cache_rejection

    fn stats() -> text:
        "device=" + self.device_name
            + " mode=" + self.mode
            + " policy=" + self.thread_policy
            + " shaders=" + self.shader_count.to_text()
            + " gen=" + self.generation.to_text()
            + " init=" + self.initialized.to_text()
            + " transient_pools_created=" + self.transient_cmd_pool_created_count.to_text()
            + " transient_pools_destroyed=" + self.transient_cmd_pool_destroyed_count.to_text()
            + " cache_rejects=" + self.cache_reject_count.to_text()
