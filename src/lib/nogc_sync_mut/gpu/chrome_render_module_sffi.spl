"""Frozen Chrome (CEF) offscreen render dynlib ABI v1 records and admission seam.

Load discipline copied verbatim from `chromium_oracle_load`
(`src/lib/nogc_sync_mut/gpu/chromium_reference_oracle_sffi.spl:236-287`):
sha256 before -> `DynLib.load` -> resolve the EXACT declared symbol set -> sha256 after ->
`spl_wffi_call_i64` -> session ticket retirement -> `DynLib.close`. No symbol outside
the declared set is ever resolved.

This ABI is a sibling of, not a replacement for, the frozen 5-symbol
`simple_chromium_oracle_*` broker ABI: disjoint prefix, same exact-set discipline.
"""

use std.sffi.dynamic.{DynLib, spl_wffi_call_i64}
use std.nogc_sync_mut.gpu.native_session_owner_v1.{NativeSessionOwnerV1,
    native_session_owner_new_for_library_v1, native_session_owner_claim_create_v1,
    native_session_owner_end_create_v1, native_session_owner_claim_close_v1,
    native_session_owner_register_v1, native_session_owner_begin_v1,
    native_session_owner_end_v1, native_session_owner_claim_destroy_v1,
    native_session_owner_finish_destroy_v1}
use std.io_runtime.{file_hash_sha256}
use std.common.string_core.{text_to_bytes}
use std.common.browser.chrome_render_shim_twin.{chrome_render_create_status,
    chrome_render_status_text}

# Bounded byte-payload call. Using this rather than projecting a raw data pointer means
# this binding introduces NO new `rt_*` call site at all: the facade owns the buffer
# lifetime and the length, so Simple never holds C memory. The oracle binding's
# `rt_array_data_ptr_text` path was tried first and is not backed by the deployed seed
# (`unknown extern function: rt_array_data_ptr_text`), which is a second reason to prefer
# the facade here.
@unsafe(reason: "passes a bounded caller-owned byte payload to the frozen Chrome render C ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64_with_bytes(fptr: i64, prefix_args: [i64], bytes: [u8],
    offset: i64, length: i64, suffix_args: [i64]) -> i64

# Bounded OUT-byte-buffer call, the counterpart of the IN-only one above. It is what makes
# `simple_chrome_render_read_pixels_into(h, buf, cap, out_len)` callable at all: the buffer
# is allocated and owned on the Simple side, the provider only fills it, and Simple never
# holds C memory. Same reasoning as above, so this binding still adds NO new `rt_*`.
@unsafe(reason: "hands the frozen Chrome render C ABI a bounded caller-owned out buffer", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64_into_bytes(fptr: i64, prefix_args: [i64], out_bytes: &mut [u8],
    offset: i64, capacity: i64, out_len: *mut i64, suffix_args: [i64]) -> i64

@unsafe(reason: "passes a bit-exact double to a resolved mixed-ABI C function", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i32_i64_u32_u32_f64_bits(fptr: i64, arg0: i64,
    arg1: i64, arg2: i64, arg3_bits: i64) -> i64

extern fn spl_f64_to_bits(value: f64) -> i64

struct ChromeRenderAbi:
    version: i64
    module_id: text
    cef_version: text

struct ChromeRenderLoadRequest:
    library_path: text
    manifest_sha256: text
    expected_abi_version: i64
    required_symbols: [text]
    max_request_bytes: i64
    max_response_bytes: i64

struct ChromeRenderResolvedSymbols:
    abi_version: i64
    create: i64
    load_html: i64
    load_url: i64
    resize: i64
    render_frame: i64
    read_pixels_into: i64
    event: i64
    last_error_into: i64
    destroy: i64

struct ChromeRenderLibraryProbe:
    library_handle: i64
    manifest_sha256: text
    abi: ChromeRenderAbi
    symbols: ChromeRenderResolvedSymbols

struct ChromeRenderHandle:
    library_handle: i64
    library: DynLib?
    session_owner: NativeSessionOwnerV1?
    library_path: text
    abi_version: i64
    symbols: ChromeRenderResolvedSymbols
    released: bool

fn _chrome_render_handle_live(handle: ChromeRenderHandle) -> bool:
    if handle.released or handle.library == nil or handle.session_owner == nil:
        return false
    handle.library.?.is_live()

@unsafe(reason: "pins a cached Chrome render symbol through one provider call", capabilities: [ffi, raw_ptr])
fn _chrome_render_begin_call(handle: ChromeRenderHandle) -> bool:
    if handle.released or handle.library == nil:
        return false
    handle.library.?.begin_raw_call()

@unsafe(reason: "releases a pinned Chrome render provider call", capabilities: [ffi, raw_ptr])
fn _chrome_render_end_call(handle: ChromeRenderHandle):
    handle.library.?.end_raw_call()

# Public session values are never-reused tickets, never provider addresses.
# A positive begin reserves both the mapping and this session until end.
@unsafe(reason: "borrows one admitted Chrome render session and its mapping", capabilities: [ffi, raw_ptr])
fn _chrome_render_begin_session(handle: ChromeRenderHandle, ticket: i64) -> i64:
    if ticket <= 0 or handle.session_owner == nil or
       not _chrome_render_begin_call(handle):
        return 0
    val raw = native_session_owner_begin_v1(handle.session_owner.?, ticket.to_u64())
    if raw <= 0:
        _chrome_render_end_call(handle)
    raw

@unsafe(reason: "ends one admitted Chrome render session call", capabilities: [ffi, raw_ptr])
fn _chrome_render_end_session(handle: ChromeRenderHandle, ticket: i64):
    _ = native_session_owner_end_v1(handle.session_owner.?, ticket.to_u64())
    _chrome_render_end_call(handle)

struct ChromeRenderLoadResult:
    ok: bool
    status: text
    library_path: text
    abi: ChromeRenderAbi
    handle: ChromeRenderHandle?
    error: text
    missing_symbol: text

"""The frozen ABI v1 symbol names, in resolution order."""
fn chrome_render_symbol_names() -> [text]:
    ["simple_chrome_render_abi_version",
     "simple_chrome_render_create",
     "simple_chrome_render_load_html",
     "simple_chrome_render_load_url",
     "simple_chrome_render_resize",
     "simple_chrome_render_frame",
     "simple_chrome_render_read_pixels_into",
     "simple_chrome_render_event",
     "simple_chrome_render_last_error_into",
     "simple_chrome_render_destroy"]

"""True only for the exact frozen set, in order — extra or missing names are rejected."""
fn chrome_render_symbols_exact(names: [text]) -> bool:
    val expected = chrome_render_symbol_names()
    if names.len() != expected.len():
        return false
    var index: i64 = 0
    while index < expected.len():
        if names[index] != expected[index]:
            return false
        index = index + 1
    true

fn _chrome_render_empty_abi() -> ChromeRenderAbi:
    ChromeRenderAbi(version: 0, module_id: "", cef_version: "")

fn _chrome_render_symbol_slots(symbols: ChromeRenderResolvedSymbols) -> [i64]:
    [symbols.abi_version, symbols.create, symbols.load_html, symbols.load_url,
     symbols.resize, symbols.render_frame, symbols.read_pixels_into, symbols.event,
     symbols.last_error_into, symbols.destroy]

"""Name of the first symbol that failed to resolve, or "" when all 10 resolved.

The oracle binding reports only `symbol-missing`; naming the symbol is what lets the
probe's sabotage fixture prove WHICH export was removed.
"""
fn chrome_render_missing_symbol(symbols: ChromeRenderResolvedSymbols) -> text:
    val slots = _chrome_render_symbol_slots(symbols)
    val names = chrome_render_symbol_names()
    var index: i64 = 0
    while index < slots.len():
        if slots[index] <= 0:
            return names[index]
        index = index + 1
    ""

fn _chrome_render_result(request: ChromeRenderLoadRequest, ok: bool, status: text,
                         abi: ChromeRenderAbi, error: text,
                         missing_symbol: text) -> ChromeRenderLoadResult:
    ChromeRenderLoadResult(ok: ok, status: status, library_path: request.library_path,
        abi: abi, handle: nil, error: error, missing_symbol: missing_symbol)

"""Request-shape admission, independent of any filesystem or dynamic loader."""
fn chrome_render_request_valid(request: ChromeRenderLoadRequest) -> bool:
    if not request.library_path.starts_with("/") or request.manifest_sha256 == "":
        return false
    if request.expected_abi_version != 1:
        return false
    if request.max_request_bytes <= 0 or request.max_request_bytes > 1048576:
        return false
    if request.max_response_bytes <= 0 or request.max_response_bytes > 268435456:
        return false
    chrome_render_symbols_exact(request.required_symbols)

"""Fail-closed admission of a resolved library probe. Never admits a partial symbol set."""
fn chrome_render_validate_library_probe(request: ChromeRenderLoadRequest,
                                        probe: ChromeRenderLibraryProbe) -> ChromeRenderLoadResult:
    if not chrome_render_request_valid(request):
        return _chrome_render_result(request, false, "invalid-request",
            _chrome_render_empty_abi(), "request-rejected-before-load", "")
    if probe.library_handle <= 0:
        return _chrome_render_result(request, false, "library-not-found",
            _chrome_render_empty_abi(), "provider-load-failed", "")
    if probe.manifest_sha256 != request.manifest_sha256:
        return _chrome_render_result(request, false, "manifest-mismatch",
            _chrome_render_empty_abi(), "provider-artifact-digest-mismatch", "")
    val missing = chrome_render_missing_symbol(probe.symbols)
    if missing != "":
        return _chrome_render_result(request, false, "symbol-missing",
            _chrome_render_empty_abi(), "required-abi-v1-symbol-missing", missing)
    if probe.abi.version != request.expected_abi_version:
        return _chrome_render_result(request, false, "abi-mismatch", probe.abi,
            "provider-abi-version-mismatch", "")
    ChromeRenderLoadResult(ok: true, status: "ok", library_path: request.library_path,
        abi: probe.abi, handle: nil, error: "", missing_symbol: "")

"""Stage-B backend field: a real `create()` return code mapped to a receipt token.

`create()` returning a positive handle is the ONLY thing that yields `ok`; every other
outcome is a `blocked:<reason>` string carrying the shim's own status text, so the field
can never be a silent skip.
"""
fn chrome_render_backend_stage(create_result: i64) -> text:
    if create_result > 0:
        return "ok"
    "blocked:" + chrome_render_status_text(chrome_render_create_status(create_result))

@unsafe(reason: "loads and admits the pinned Chrome render provider through the host dynlib facade", capabilities: [ffi, raw_ptr])
fn chrome_render_load(request: ChromeRenderLoadRequest) -> ChromeRenderLoadResult:
    if not chrome_render_request_valid(request):
        return _chrome_render_result(request, false, "invalid-request",
            _chrome_render_empty_abi(), "request-rejected-before-load", "")
    val digest = file_hash_sha256(request.library_path)
    if digest != request.manifest_sha256:
        return _chrome_render_result(request, false, "manifest-mismatch",
            _chrome_render_empty_abi(), "provider-artifact-digest-mismatch", "")
    val loaded = DynLib.load(request.library_path)
    if loaded == nil:
        return _chrome_render_result(request, false, "library-not-found",
            _chrome_render_empty_abi(), "provider-load-failed", "")
    var lib = loaded.?
    val symbols = ChromeRenderResolvedSymbols(
        abi_version: lib.sym(request.required_symbols[0]),
        create: lib.sym(request.required_symbols[1]),
        load_html: lib.sym(request.required_symbols[2]),
        load_url: lib.sym(request.required_symbols[3]),
        resize: lib.sym(request.required_symbols[4]),
        render_frame: lib.sym(request.required_symbols[5]),
        read_pixels_into: lib.sym(request.required_symbols[6]),
        event: lib.sym(request.required_symbols[7]),
        last_error_into: lib.sym(request.required_symbols[8]),
        destroy: lib.sym(request.required_symbols[9]))
    val missing = chrome_render_missing_symbol(symbols)
    if missing != "":
        lib.close()
        return _chrome_render_result(request, false, "symbol-missing",
            _chrome_render_empty_abi(), "required-abi-v1-symbol-missing", missing)
    val digest_after_load = file_hash_sha256(request.library_path)
    if digest_after_load != digest:
        lib.close()
        return _chrome_render_result(request, false, "manifest-mismatch",
            _chrome_render_empty_abi(), "provider-artifact-changed-during-load", "")
    val abi_version = spl_wffi_call_i64(symbols.abi_version, [], 0)
    val abi = ChromeRenderAbi(version: abi_version,
        module_id: "libsimple_chrome_render", cef_version: "manifest-pinned")
    val probe = ChromeRenderLibraryProbe(library_handle: lib.handle,
        manifest_sha256: digest, abi: abi, symbols: symbols)
    val admitted = chrome_render_validate_library_probe(request, probe)
    if not admitted.ok:
        lib.close()
        return admitted
    val owner = native_session_owner_new_for_library_v1(lib.lifetime_identity)
    if owner == nil:
        lib.close()
        return _chrome_render_result(request, false, "session-owner-unavailable",
            abi, "provider-mapping-ticket-namespace-exhausted", "")
    ChromeRenderLoadResult(ok: true, status: "ok", library_path: request.library_path,
        abi: abi, handle: Some(ChromeRenderHandle(library_handle: lib.handle,
            library: Some(lib),
            session_owner: owner,
            library_path: request.library_path,
            abi_version: abi_version, symbols: symbols, released: false)),
        error: "", missing_symbol: "")

"""Stage B: call the real `create()` with a bounded config payload. No fake success path."""
@unsafe(reason: "invokes the admitted bounded Chrome render create ABI", capabilities: [ffi, raw_ptr])
fn chrome_render_create(handle: ChromeRenderHandle, config_json: text) -> i64:
    if not _chrome_render_handle_live(handle) or handle.symbols.create <= 0:
        return 0 - 2
    if config_json == "" or config_json.len() > 1048576:
        return 0 - 1
    if not native_session_owner_claim_create_v1(handle.session_owner.?):
        return 0 - 2
    val payload: [u8] = text_to_bytes(config_json)
    if not _chrome_render_begin_call(handle):
        _ = native_session_owner_end_create_v1(handle.session_owner.?)
        return 0 - 2
    val result = spl_wffi_call_i64_with_bytes(handle.symbols.create, [], payload,
        0, payload.len(), [])
    if result <= 0:
        _chrome_render_end_call(handle)
        _ = native_session_owner_end_create_v1(handle.session_owner.?)
        return result
    # Retain the mapping use through the native destructor, including when a
    # copied DynLib alias retires the mapping before this handle is released.
    val ticket = native_session_owner_register_v1(handle.session_owner.?, result)
    if ticket == 0u64:
        val cleanup = spl_wffi_call_i64(handle.symbols.destroy, [result], 1)
        if cleanup == 0:
            _chrome_render_end_call(handle)
            _ = native_session_owner_end_create_v1(handle.session_owner.?)
        # Failed cleanup quarantines both the mapping use and create claim.
        return 0 - 2
    _ = native_session_owner_end_create_v1(handle.session_owner.?)
    ticket.to_i64()

"""The frozen per-tab call sequence, in ABI order. Recorded in showcase receipts."""
fn chrome_render_sequence_steps() -> [text]:
    ["create", "load_html", "resize", "render_frame", "read_pixels_into",
     "event_pointer", "event_key", "destroy"]

"""Calls `load_html` with a bounded HTML payload."""
@unsafe(reason: "invokes the admitted bounded Chrome render load_html ABI", capabilities: [ffi, raw_ptr])
fn chrome_render_load_html(handle: ChromeRenderHandle, session_handle: i64, html: text) -> i64:
    if not _chrome_render_handle_live(handle) or handle.symbols.load_html <= 0:
        return 2
    if html == "" or html.len() > 1048576:
        return 1
    val payload: [u8] = text_to_bytes(html)
    val raw = _chrome_render_begin_session(handle, session_handle)
    if raw <= 0:
        return 2
    val result = spl_wffi_call_i64_with_bytes(handle.symbols.load_html, [raw], payload, 0,
        payload.len(), [])
    _chrome_render_end_session(handle, session_handle)
    result

"""Calls resize with the frozen `(int64_t, uint32_t, uint32_t, double)` C ABI.

The scale is encoded as f64 bits for the Simple-to-runtime boundary. The
runtime bridge restores a double before entering the provider.
"""
@unsafe(reason: "invokes the admitted mixed-ABI Chrome render resize function", capabilities: [ffi, raw_ptr])
fn chrome_render_resize(handle: ChromeRenderHandle, session_handle: i64,
                        width: i64, height: i64) -> i64:
    if not _chrome_render_handle_live(handle) or handle.symbols.resize <= 0:
        return 2
    if width <= 0 or height <= 0 or width > 8192 or height > 8192:
        return 1
    val raw = _chrome_render_begin_session(handle, session_handle)
    if raw <= 0:
        return 2
    val scale_bits = spl_f64_to_bits(1.0)
    val result = spl_wffi_call_i32_i64_u32_u32_f64_bits(
        handle.symbols.resize, raw, width, height, scale_bits)
    _chrome_render_end_session(handle, session_handle)
    result

"""Calls `render_frame` with a bounded timeout. A zero timeout is refused by the ABI."""
@unsafe(reason: "invokes the admitted Chrome render frame ABI", capabilities: [ffi, raw_ptr])
fn chrome_render_frame(handle: ChromeRenderHandle, session_handle: i64, timeout_ms: i64) -> i64:
    if not _chrome_render_handle_live(handle) or handle.symbols.render_frame <= 0:
        return 2
    if timeout_ms <= 0:
        return 1
    val raw = _chrome_render_begin_session(handle, session_handle)
    if raw <= 0:
        return 2
    val result = spl_wffi_call_i64(handle.symbols.render_frame, [raw, timeout_ms], 2)
    _chrome_render_end_session(handle, session_handle)
    result

"""One real bounded readback attempt: what the provider returned, and what it wrote.

`rc` is the provider's own return for the sizing call, `frame_bytes_needed` the length it
reported it would need, and `pixels` the bytes it actually wrote — empty when it wrote
none. `pulled` is the single question a caller should branch on: true only when a full
frame of exactly `width * height * 4` bytes came back.
"""
struct ChromeRenderReadback:
    rc: i64
    frame_bytes_needed: i64
    pixels: [u8]
    pulled: bool

"""Pulls one frame through `read_pixels_into(h, buf, cap, out_len)`.

This is a REAL readback, not a null probe: the buffer is allocated here, on the Simple
side, and the provider fills it through the bounded out-byte-buffer facade.

It is deliberately two calls, which is the `(buf, cap, out_len)` idiom's own shape rather
than a workaround. The first offers capacity 0 and asks the provider how much it needs;
only if a frame is actually available (`frame_ready`) and the reported need matches this
viewport's `width * height * 4` is the full buffer allocated and the second call made.
Allocating 4K * 4 bytes speculatively, per tab, for a provider that has already refused
would cost more than the whole showcase run and prove nothing.

`rc` is always the provider's real return value — nothing here substitutes one.
"""
@unsafe(reason: "pulls a bounded frame from the admitted Chrome render readback ABI", capabilities: [ffi, raw_ptr])
fn chrome_render_read_pixels_into(handle: ChromeRenderHandle, session_handle: i64,
                                  width: i64, height: i64,
                                  frame_ready: bool) -> ChromeRenderReadback:
    if not _chrome_render_handle_live(handle) or handle.symbols.read_pixels_into <= 0:
        return ChromeRenderReadback(rc: 2, frame_bytes_needed: 0, pixels: [], pulled: false)
    if width <= 0 or height <= 0 or width > 8192 or height > 8192 or
       width * height * 4 > 268435456:
        return ChromeRenderReadback(rc: 1, frame_bytes_needed: 0, pixels: [], pulled: false)
    # A zero-capacity window still needs a real buffer address, so the sizing call offers a
    # one-byte allocation with no room in it.
    var sizer: [u8] = [0]
    var needed: i64 = 0
    val raw = _chrome_render_begin_session(handle, session_handle)
    if raw <= 0:
        return ChromeRenderReadback(rc: 2, frame_bytes_needed: 0, pixels: [], pulled: false)
    val size_rc = unsafe(capabilities: [ffi, raw_ptr]):
        spl_wffi_call_i64_into_bytes(handle.symbols.read_pixels_into, [raw],
            &mut sizer, 0, 0, &mut needed, [])
    val want = width * height * 4
    if not frame_ready or needed <= 0 or needed != want:
        _chrome_render_end_session(handle, session_handle)
        return ChromeRenderReadback(rc: size_rc, frame_bytes_needed: needed,
            pixels: [], pulled: false)
    var frame: [u8] = []
    var index: i64 = 0
    while index < want:
        frame.push(0)
        index = index + 1
    var written: i64 = 0
    val read_rc = unsafe(capabilities: [ffi, raw_ptr]):
        spl_wffi_call_i64_into_bytes(handle.symbols.read_pixels_into, [raw],
            &mut frame, 0, want, &mut written, [])
    _chrome_render_end_session(handle, session_handle)
    if read_rc != 0 or written != want:
        return ChromeRenderReadback(rc: read_rc, frame_bytes_needed: needed,
            pixels: [], pulled: false)
    ChromeRenderReadback(rc: read_rc, frame_bytes_needed: needed, pixels: frame, pulled: true)

"""Dispatches one bounded JSON input event (`event`)."""
@unsafe(reason: "invokes the admitted bounded Chrome render event ABI", capabilities: [ffi, raw_ptr])
fn chrome_render_event(handle: ChromeRenderHandle, session_handle: i64, event_json: text) -> i64:
    if not _chrome_render_handle_live(handle) or handle.symbols.event <= 0:
        return 2
    if event_json == "" or event_json.len() > 1048576:
        return 1
    val payload: [u8] = text_to_bytes(event_json)
    val raw = _chrome_render_begin_session(handle, session_handle)
    if raw <= 0:
        return 2
    val result = spl_wffi_call_i64_with_bytes(handle.symbols.event, [raw], payload, 0,
        payload.len(), [])
    _chrome_render_end_session(handle, session_handle)
    result

"""A synthetic pointer-down event at (x, y), as the ABI's bounded JSON payload."""
fn chrome_render_pointer_event_json(x: i64, y: i64) -> text:
    "{\"kind\":\"pointer\",\"type\":\"down\",\"x\":" + x.to_text() + ",\"y\":" + y.to_text() + "}"

"""A synthetic key event for one key name."""
fn chrome_render_key_event_json(key: text) -> text:
    "{\"kind\":\"key\",\"type\":\"down\",\"key\":\"" + key + "\"}"

"""Calls the provider's `destroy` after claiming an exclusive session ticket.

Stage A of the probe calls this with 0: it proves the resolved `destroy` pointer is
actually CALLABLE, which merely resolving a symbol address does not.
"""
@unsafe(reason: "invokes the admitted Chrome render destroy ABI", capabilities: [ffi, raw_ptr])
fn chrome_render_destroy(handle: ChromeRenderHandle, session_handle: i64) -> i64:
    if handle.library == nil or handle.session_owner == nil or
       handle.symbols.destroy <= 0:
        return 2
    if session_handle == 0:
        if not _chrome_render_begin_call(handle):
            return 2
        val invalid_rc = spl_wffi_call_i64(handle.symbols.destroy, [0], 1)
        _chrome_render_end_call(handle)
        return invalid_rc
    if session_handle < 0:
        return 2
    val raw = native_session_owner_claim_destroy_v1(
        handle.session_owner.?, session_handle.to_u64())
    if raw <= 0:
        return 2
    # Create retained this mapping use, so the destructor remains callable
    # even when another DynLib alias has retired the mapping.
    val result = spl_wffi_call_i64(handle.symbols.destroy, [raw], 1)
    if result != 0:
        return result
    if not native_session_owner_finish_destroy_v1(
        handle.session_owner.?, session_handle.to_u64()):
        return 2
    _chrome_render_end_call(handle)
    result

"""Closes the provider exactly once after every session has been destroyed.

This operation has no session side effect. A false return means a create or
session remains active, or another copied handle already closed the provider.
"""
@unsafe(reason: "retires the admitted Chrome render provider after sessions drain", capabilities: [ffi, raw_ptr])
fn chrome_render_close(handle: ChromeRenderHandle) -> bool:
    if handle.library == nil or handle.session_owner == nil:
        return false
    if not native_session_owner_claim_close_v1(handle.session_owner.?):
        return false
    var library = handle.library.?
    library.close()
    true

"""Destroys one session if supplied, then attempts to close the provider.

When other sessions remain, this may destroy the supplied session and return
false. Call chrome_render_close after the last session is destroyed.
"""
@unsafe(reason: "releases the admitted Chrome render provider session and library", capabilities: [ffi, raw_ptr])
fn chrome_render_release(handle: ChromeRenderHandle, session_handle: i64) -> bool:
    if session_handle > 0 and chrome_render_destroy(handle, session_handle) != 0:
        return false
    chrome_render_close(handle)
