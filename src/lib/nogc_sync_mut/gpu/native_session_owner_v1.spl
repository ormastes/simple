"""Revocable native session tickets shared by copied foreign-provider handles.

The owner serializes admission and teardown, then releases its mutex before
foreign code runs. A busy teardown refuses so the caller may retry on its
own thread after the admitted call returns. Tickets never repeat, even when
a native provider reuses an address for a later session.
"""

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_lock, mutex_unlock}

const _NATIVE_SESSION_CAPACITY_V1: i64 = 4096
const _NATIVE_SESSION_MAX_ID_V1: u64 = 9223372036854775807u64
const _NATIVE_SESSION_MAX_NAMESPACE_V1: u64 = 2147483647u64
const _NATIVE_SESSION_NAMESPACE_WIDTH_V1: u64 = 4294967296u64
const _NATIVE_SESSION_IDLE_V1: i64 = 0
const _NATIVE_SESSION_CALLING_V1: i64 = 1
const _NATIVE_SESSION_DESTROYING_V1: i64 = 2

struct _NativeSessionEntryV1:
    ticket: u64
    raw_session: i64
    phase: i64

struct _NativeSessionStateV1:
    next_ticket: u64
    ticket_limit: u64
    entries: [_NativeSessionEntryV1]
    creating: bool
    close_claimed: bool
    result_ticket: u64
    result_raw: i64
    result_ok: bool

# The owner is a copyable slot into Simple-side state; copies of a handle
# select the same slot. The runtime mutex is an exclusion gate only (same fix
# as nvfs_device_identity_owner_v1): a struct protected value comes back nil
# through the interpreter's rt_mutex value bridge, the update closure faults
# with the real lock held, and every later owner call blocks forever.
class NativeSessionOwnerV1:
    _slot: i64

var _native_session_gate_v1: Mutex = mutex_new(0)
var _native_session_states_v1: [_NativeSessionStateV1] = []

fn _native_session_update_v1(
    owner: NativeSessionOwnerV1,
    f: fn(_NativeSessionStateV1) -> _NativeSessionStateV1
) -> _NativeSessionStateV1:
    val _ = mutex_lock(_native_session_gate_v1)
    val next = f(_native_session_states_v1[owner._slot])
    _native_session_states_v1[owner._slot] = next
    val _ = mutex_unlock(_native_session_gate_v1, 0)
    next

fn _native_session_owner_with_range_v1(start: u64, limit: u64) -> NativeSessionOwnerV1:
    val initial = _NativeSessionStateV1(
        next_ticket: start, ticket_limit: limit, entries: [], creating: false,
        close_claimed: false, result_ticket: 0u64,
        result_raw: 0, result_ok: false)
    val _ = mutex_lock(_native_session_gate_v1)
    val slot = _native_session_states_v1.len()
    _native_session_states_v1.push(initial)
    val _ = mutex_unlock(_native_session_gate_v1, 0)
    NativeSessionOwnerV1(_slot: slot)

fn native_session_owner_new_v1() -> NativeSessionOwnerV1:
    _native_session_owner_with_range_v1(1u64, _NATIVE_SESSION_MAX_ID_V1)

# A DynLib mapping identity is unique across loaded mappings. Reserve a
# disjoint signed-positive ticket range for each mapping, so a ticket from one
# Chrome render handle cannot select a session under another handle.
fn native_session_owner_new_for_library_v1(mapping_identity: u64) -> NativeSessionOwnerV1?:
    if mapping_identity == 0u64 or
       mapping_identity > _NATIVE_SESSION_MAX_NAMESPACE_V1:
        return nil
    val base = mapping_identity * _NATIVE_SESSION_NAMESPACE_WIDTH_V1
    Some(_native_session_owner_with_range_v1(base + 1u64,
        base + _NATIVE_SESSION_NAMESPACE_WIDTH_V1 - 1u64))

# A provider create runs outside the mutex. Its claim prevents library close
# until registration or failed-create cleanup has finished.
@unsafe(reason: "claims exclusive creation while a native provider may enter foreign code", capabilities: [raw_ptr])
fn native_session_owner_claim_create_v1(owner: NativeSessionOwnerV1) -> bool:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ok = false
        if not state.creating and not state.close_claimed:
            next.creating = true
            next.result_ok = true
        next)
    updated.result_ok

@unsafe(reason: "ends a native provider create only after registration or cleanup", capabilities: [raw_ptr])
fn native_session_owner_end_create_v1(owner: NativeSessionOwnerV1) -> bool:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ok = state.creating
        next.creating = false
        next)
    updated.result_ok

# Closing is a one-way claim. Live sessions, an in-flight create, or a prior
# close claim all refuse, including through retained copies of a handle.
@unsafe(reason: "claims retirement of a native provider after all sessions drain", capabilities: [raw_ptr])
fn native_session_owner_claim_close_v1(owner: NativeSessionOwnerV1) -> bool:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ok = false
        if not state.creating and not state.close_claimed and
           state.entries.len() == 0:
            next.close_claimed = true
            next.result_ok = true
        next)
    updated.result_ok

fn _native_session_index_v1(state: _NativeSessionStateV1, ticket: u64) -> i64:
    var index = 0
    while index < state.entries.len():
        if state.entries[index].ticket == ticket:
            return index
        index = index + 1
    -1

# Zero refuses invalid input, full capacity, or exhausted ticket identity.
@unsafe(reason: "registers a provider-owned raw session address under a revocable ticket", capabilities: [raw_ptr])
fn native_session_owner_register_v1(owner: NativeSessionOwnerV1, raw_session: i64) -> u64:
    if raw_session <= 0:
        return 0u64
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ticket = 0u64
        if state.next_ticket != 0u64 and not state.close_claimed and
           state.entries.len() < _NATIVE_SESSION_CAPACITY_V1:
            val ticket = state.next_ticket
            next.next_ticket = if ticket == state.ticket_limit:
                0u64
            else:
                ticket + 1u64
            next.entries.push(_NativeSessionEntryV1(
                ticket: ticket, raw_session: raw_session,
                phase: _NATIVE_SESSION_IDLE_V1))
            next.result_ticket = ticket
        next)
    updated.result_ticket

# Positive result is the admitted native address. -1 means busy; zero means
# retired or unknown. Every positive begin must have one matching end.
@unsafe(reason: "borrows a provider-owned raw session address for one foreign call", capabilities: [raw_ptr])
fn native_session_owner_begin_v1(owner: NativeSessionOwnerV1, ticket: u64) -> i64:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_raw = 0
        val index = _native_session_index_v1(state, ticket)
        if index >= 0:
            var entry = state.entries[index]
            if entry.phase == _NATIVE_SESSION_IDLE_V1:
                entry.phase = _NATIVE_SESSION_CALLING_V1
                next.entries[index] = entry
                next.result_raw = entry.raw_session
            else:
                next.result_raw = -1
        next)
    updated.result_raw

# Snapshot for status displays. A busy call remains live; Destroying and
# retired tickets do not. Call admission still requires begin_v1.
fn native_session_owner_is_live_v1(owner: NativeSessionOwnerV1, ticket: u64) -> bool:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ok = false
        val index = _native_session_index_v1(state, ticket)
        if index >= 0 and state.entries[index].phase != _NATIVE_SESSION_DESTROYING_V1:
            next.result_ok = true
        next)
    updated.result_ok

@unsafe(reason: "ends a borrow of a provider-owned raw session address", capabilities: [raw_ptr])
fn native_session_owner_end_v1(owner: NativeSessionOwnerV1, ticket: u64) -> bool:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ok = false
        val index = _native_session_index_v1(state, ticket)
        if index >= 0:
            var entry = state.entries[index]
            if entry.phase == _NATIVE_SESSION_CALLING_V1:
                entry.phase = _NATIVE_SESSION_IDLE_V1
                next.entries[index] = entry
                next.result_ok = true
        next)
    updated.result_ok

# A positive result claims the sole destructor call. A busy call returns -1
# without changing the session, so release can be retried on its owner thread.
@unsafe(reason: "claims exclusive destruction of a provider-owned raw session", capabilities: [raw_ptr])
fn native_session_owner_claim_destroy_v1(owner: NativeSessionOwnerV1,
                                         ticket: u64) -> i64:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_raw = 0
        val index = _native_session_index_v1(state, ticket)
        if index >= 0:
            var entry = state.entries[index]
            if entry.phase == _NATIVE_SESSION_IDLE_V1:
                entry.phase = _NATIVE_SESSION_DESTROYING_V1
                next.entries[index] = entry
                next.result_raw = entry.raw_session
            else:
                next.result_raw = -1
        next)
    updated.result_raw

# Call only after the provider confirms destruction. A failed destructor
# leaves Destroying quarantined and keeps the caller's mapping lease pinned.
@unsafe(reason: "retires a provider-owned raw session only after native destruction", capabilities: [raw_ptr])
fn native_session_owner_finish_destroy_v1(owner: NativeSessionOwnerV1,
                                          ticket: u64) -> bool:
    val updated = _native_session_update_v1(owner, \state:
        var next = state
        next.result_ok = false
        val index = _native_session_index_v1(state, ticket)
        if index >= 0 and state.entries[index].phase == _NATIVE_SESSION_DESTROYING_V1:
            next.entries.remove(index)
            next.result_ok = true
        next)
    updated.result_ok

export NativeSessionOwnerV1, native_session_owner_new_v1
export native_session_owner_new_for_library_v1
export native_session_owner_claim_create_v1, native_session_owner_end_create_v1
export native_session_owner_claim_close_v1
export native_session_owner_register_v1, native_session_owner_begin_v1
export native_session_owner_is_live_v1
export native_session_owner_end_v1, native_session_owner_claim_destroy_v1
export native_session_owner_finish_destroy_v1
