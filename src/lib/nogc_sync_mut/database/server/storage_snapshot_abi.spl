# Dedicated snapshot ABI. No new runtime registration; qualified native hosts only.
export use std.nogc_sync_mut.io.retained_file_abi.*
@when(os="windows"):
export use std.nogc_sync_mut.io.windows_process_owner_abi.{GetLastError}
export use std.nogc_sync_mut.io.path_identity_abi.{GetFileAttributesW, GetFinalPathNameByHandleW}
@unsafe(reason: "SQLite shared byte range on owned snapshot handle", capabilities: [ffi, raw_ptr])
extern fn LockFileEx(file: i64, flags: u32, reserved: u32, low: u32, high: u32, overlapped: i64) -> i32
@unsafe(reason: "releases exact owned SQLite byte range", capabilities: [ffi, raw_ptr])
extern fn UnlockFileEx(file: i64, reserved: u32, low: u32, high: u32, overlapped: i64) -> i32
export LockFileEx, UnlockFileEx
@else:
@when(os="linux"):
export use std.nogc_sync_mut.io.path_identity_abi.{path_errno_address}
@unsafe(reason: "Linux64 fcntl OFD lock with explicitly owned native flock", capabilities: [ffi, raw_ptr])
extern fn fcntl(fd: i32, operation: i32, lock: i64) -> i32
@unsafe(reason: "Linux64 local filesystem capability observation", capabilities: [ffi, raw_ptr])
extern fn fstatfs(fd: i32, buffer: i64) -> i32
@unsafe(reason: "Linux UTS machine capability observation", capabilities: [ffi, raw_ptr])
extern fn uname(buffer: i64) -> i32
export fcntl, fstatfs, uname
@end
@end
