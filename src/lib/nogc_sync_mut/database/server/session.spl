# Simple DB server tier — session/connection lifecycle (ECS business layer)
#
# MDSOC+ split: the MDSOC capsule (server.spl) owns the ports and the outside
# world; this module is the ECS business layer.
#
#   Entity     = SessionId (i64)
#   Components = SessionIdentity, SessionCapability, TxnState
#                (parallel Dict stores, keyed by session id)
#   Systems    = the sys_* functions in server.spl
#
# LANDMINE COMPLIANCE: every component update here is
# extract -> mutate -> write back.  A mutating method reached through two or
# more field hops (e.g. `self.registry.identities[id].close()`) silently loses
# the write on the interpreter, which is what the engine spec `it` bodies run
# on.  Nothing in this file mutates through a chain.

use std.database.server.capability.{ DbCapability, empty_capability }
use std.database.server.txn.{ TxnState, closed_txn }

# ============================================================================
# Components
# ============================================================================

struct SessionIdentity:
    session_id: i64
    principal: text
    open: bool

# ============================================================================
# SessionRegistry — the component stores
# ============================================================================

class SessionRegistry:
    identities: Dict<i64, SessionIdentity>
    capabilities: Dict<i64, DbCapability>
    txns: Dict<i64, TxnState>
    next_id: i64

    static fn new() -> SessionRegistry:
        SessionRegistry(identities: {}, capabilities: {}, txns: {}, next_id: 1)

    # -- lifecycle -----------------------------------------------------------

    me open_session(principal: text, capability: DbCapability) -> i64:
        val id = self.next_id
        # NOTE: `self.next_id += 1` is silently wrong on the JIT (loads 0).
        self.next_id = self.next_id + 1

        var identities = self.identities
        identities[id] = SessionIdentity(session_id: id, principal: principal, open: true)
        self.identities = identities

        var capabilities = self.capabilities
        capabilities[id] = capability
        self.capabilities = capabilities

        var txns = self.txns
        txns[id] = closed_txn()
        self.txns = txns

        id

    # Closing discards any open transaction — an abandoned connection must not
    # leak uncommitted state into the store.
    me close_session(id: i64) -> bool:
        if not self.identities.contains_key(id):
            return false
        val current: SessionIdentity = self.identities[id]
        if not current.open:
            return false

        var identities = self.identities
        identities[id] = SessionIdentity(
            session_id: current.session_id,
            principal: current.principal,
            open: false
        )
        self.identities = identities

        var txns = self.txns
        txns[id] = closed_txn()
        self.txns = txns
        true

    # -- queries -------------------------------------------------------------

    fn is_open(id: i64) -> bool:
        if not self.identities.contains_key(id):
            return false
        val identity: SessionIdentity = self.identities[id]
        identity.open

    fn identity(id: i64) -> SessionIdentity?:
        if self.identities.contains_key(id):
            Some(self.identities[id])
        else:
            nil

    fn capability_of(id: i64) -> DbCapability:
        if self.capabilities.contains_key(id):
            return self.capabilities[id]
        # Unknown session => no grants => every data op denied.
        empty_capability("")

    fn txn_of(id: i64) -> TxnState:
        if self.txns.contains_key(id):
            return self.txns[id]
        closed_txn()

    fn has_open_txn(id: i64) -> bool:
        val state = self.txn_of(id)
        state.open

    fn open_session_count() -> i64:
        var count = 0
        for (_id, identity) in self.identities:
            val typed: SessionIdentity = identity
            if typed.open:
                count = count + 1
        count

    # -- txn component write-back -------------------------------------------

    # The ONLY way a transaction component changes.  Callers compute a new
    # TxnState value (txn.spl returns values) and store it here.
    me set_txn(id: i64, state: TxnState):
        var txns = self.txns
        txns[id] = state
        self.txns = txns

    me clear_txn(id: i64):
        self.set_txn(id, closed_txn())

    me close_sessions(ids: [i64]):
        for id in ids:
            if self.is_open(id):
                self.close_session(id)

    me close_session_range(first_id: i64, end_id: i64):
        var id = first_id
        while id < end_id:
            if self.is_open(id):
                self.close_session(id)
            id = id + 1
