# Simple DB server tier — MDSOC outer capsule
#
# MDSOC+ : this capsule is the ONLY object that touches the outside world.  It
# owns three ports and nothing else:
#
#   store port      SdnDatabase        (std.database.core — the embedded store)
#   policy port     CapabilityTable    (deny-wins access control)
#   transport port  DbTransport        (framed message channel)
#
# All business logic is the ECS layer below it: entities = sessions, components
# = SessionRegistry's parallel Dict stores, systems = the sys_* functions here.
# The capsule never reimplements storage — every durable byte goes through the
# embedded SDN store.
#
# DURABILITY (increment 2): COMMIT persists before it acknowledges.  The
# contract, the crash-point matrix and the reason the WAL is not the commit
# point all live in `durability.spl` — read that before changing sys_commit.

use std.convert (try_parse_int)
use std.database.core.{ SdnRow, SdnTable, SdnDatabase }
use std.database.server.protocol.{
    DbRequest, DbResponse,
    parse_request, encode_response,
    ok_response, ok_with, err_response,
    ERR_MALFORMED, ERR_UNKNOWN_OP, ERR_MISSING_ARG, ERR_NO_SESSION,
    ERR_DENIED, ERR_NO_TXN, ERR_TXN_OPEN, ERR_CONFLICT, ERR_NO_TABLE,
    ERR_NOT_FOUND, ERR_DURABILITY, ERR_CRASHED, ERR_SERVE_BOUND, ERR_AUTH, ERR_LIMIT,
    MAX_RESPONSE_BYTES, CommitIdentity, BoundedQuery,
    server_query_bounds, validated_commit_identity
}

# Bounded-wait guard for serve(): a connection drain that stops making progress
# must fail loudly rather than hang its caller (a spec runner, a service loop).
# Far above any real connection length in this tier.
val SERVE_MAX_MESSAGES: i64 = 100000

# What one connection drain produced: how many messages were answered, and the
# channel as it stands AFTER the drain (replies captured, inbound consumed).
# serve() returns the channel rather than relying on the caller's binding being
# updated in place — see the note on serve().
class ServeOutcome:
    served: i64
    channel: MemoryTransport

    fn sent_count() -> i64:
        val ch = self.channel
        ch.sent_count()

    fn all_sent() -> [text]:
        val ch = self.channel
        ch.all_sent()
use std.database.server.durability.{
    DurabilityPolicy, DurableOutcome, durable_commit_for_principal, durability_on
}
use std.database.server.capability.{
    DbCapability, CapabilityTable, AuthenticatedPrincipal, capability_allows_op, op_access,
    ACCESS_READ, ACCESS_WRITE
}
use std.database.server.session.{ SessionRegistry, SessionIdentity }
use std.database.server.txn.{
    TxnState, TxnWrite,
    begin_txn, closed_txn, txn_record, txn_lookup,
    store_read, store_version,
    WRITE_PUT, WRITE_DEL
}
use std.database.server.transport.{
    DbTransport, MemoryTransport, TcpDbTransport, DbListenerControl
}
use std.io.types.{IoError, IoErrorKind}

val LISTENER_ACCEPT_TIMEOUT_MS: i64 = 250
val LISTENER_MAX_CONNECTIONS: i64 = 1024

# ============================================================================
# DbServerCapsule
# ============================================================================

class DbServerCapsule:
    store: SdnDatabase
    policy: CapabilityTable
    registry: SessionRegistry
    # Durability is ON by default: a commit that is not persisted is the defect
    # increment 1 shipped, not a configuration choice.  It degrades to
    # in-memory only when the store has no path, and that degradation is
    # reported, never silently assumed.
    durability: DurabilityPolicy
    listener_running: bool
    active_connections: i64

    static fn new(store: SdnDatabase, policy: CapabilityTable) -> DbServerCapsule:
        DbServerCapsule(
            store: store, policy: policy,
            registry: SessionRegistry.new(),
            durability: durability_on(),
            listener_running: false, active_connections: 0
        )

    static fn new_with_durability(
        store: SdnDatabase, policy: CapabilityTable, durability: DurabilityPolicy
    ) -> DbServerCapsule:
        DbServerCapsule(
            store: store, policy: policy,
            registry: SessionRegistry.new(),
            durability: durability,
            listener_running: false, active_connections: 0
        )

    # ------------------------------------------------------------------
    # Systems
    # ------------------------------------------------------------------

    me sys_open(request: DbRequest) -> DbResponse:
        val principal = request.arg("as") ?? ""
        val credential = request.arg("credential") ?? ""
        val authenticated = self.policy.authenticate_principal(principal, credential)
        if authenticated == nil:
            return err_response(ERR_AUTH, "authentication failed")
        val proof: AuthenticatedPrincipal = authenticated ?? AuthenticatedPrincipal(
            principal: "", capability: self.policy.lookup_or_empty(""))
        val capability = proof.capability
        var registry = self.registry
        val id = registry.open_session(proof.principal, capability)
        self.registry = registry
        ok_with("session", "{id}")

    me sys_close(session_id: i64) -> DbResponse:
        var registry = self.registry
        val closed = registry.close_session(session_id)
        self.registry = registry
        if not closed:
            return err_response(ERR_NO_SESSION, "session {session_id} is not open")
        ok_response()

    me sys_begin(session_id: i64) -> DbResponse:
        if self.registry.has_open_txn(session_id):
            return err_response(ERR_TXN_OPEN, "session {session_id} already has an open transaction")
        var registry = self.registry
        registry.set_txn(session_id, begin_txn())
        self.registry = registry
        ok_response()

    me sys_rollback(session_id: i64) -> DbResponse:
        if not self.registry.has_open_txn(session_id):
            return err_response(ERR_NO_TXN, "no open transaction")
        var registry = self.registry
        registry.clear_txn(session_id)
        self.registry = registry
        ok_response()

    # COMMIT is durable: the OK frame is written only AFTER the store has been
    # persisted through SdnDatabase.save().  See durability.spl for the full
    # contract — this method must never be reordered to acknowledge first.
    me sys_commit(session_id: i64, request: DbRequest) -> DbResponse:
        val commit_id = request.arg("commit_id") ?? ""
        var principal = ""
        match self.registry.identity(session_id):
            Some(identity): principal = identity.principal
            nil: pass_do_nothing("dispatch already proved the session exists")
        var identity: CommitIdentity? = nil
        var effective_commit_id = ""
        if commit_id != "":
            identity = validated_commit_identity(commit_id, principal)
            if identity == nil:
                return err_response(ERR_MALFORMED, "invalid commit_id")
            effective_commit_id = (identity ?? CommitIdentity(value: "", principal: "")).value
        if not self.registry.has_open_txn(session_id):
            # The principal-bound durable receipt is checked before txn state, so
            # a reconnect may safely retry an acknowledged-or-lost response.
            if commit_id != "":
                var retry_store = self.store
                val retry = durable_commit_for_principal(
                    retry_store, closed_txn(), self.durability,
                    effective_commit_id, principal)
                self.store = retry_store
                if retry.ok:
                    return ok_with("applied", "{retry.applied}")
                if retry.conflict_key != "":
                    return err_response(ERR_CONFLICT, retry.message)
            return err_response(ERR_NO_TXN, "no open transaction")
        val state = self.registry.txn_of(session_id)
        # Extract -> mutate -> write back: durable_commit mutates the store and
        # may roll it back, and a mutating call through 2+ field hops loses the
        # write on the interpreter.
        var store = self.store
        val outcome: DurableOutcome = durable_commit_for_principal(
            store, state, self.durability,
            effective_commit_id, principal)
        self.store = store
        var registry = self.registry
        registry.clear_txn(session_id)
        self.registry = registry
        if outcome.crashed:
            # In production the process is gone here and the client sees a
            # dropped connection.  The frame exists for the crash-point spec.
            return err_response(ERR_CRASHED, outcome.message)
        if not outcome.ok:
            if outcome.conflict_key != "":
                return err_response(ERR_CONFLICT, outcome.message)
            return err_response(ERR_DURABILITY, outcome.message)
        ok_with("applied", "{outcome.applied}")

    me sys_write(session_id: i64, request: DbRequest, kind: text) -> DbResponse:
        val table = request.arg("tbl") ?? ""
        val key = request.arg("id") ?? ""
        if table == "":
            return err_response(ERR_MISSING_ARG, "{request.op} requires tbl=<table>")
        if key == "":
            return err_response(ERR_MISSING_ARG, "{request.op} requires id=<key>")
        if not self.store.get_table(table).?:
            return err_response(ERR_NO_TABLE, "no such table: {table}")
        if not self.registry.has_open_txn(session_id):
            return err_response(ERR_NO_TXN, "{request.op} requires an open transaction")

        # Payload = every arg except the routing keys.
        var fields: Dict<text, text> = {}
        for (arg_key, arg_value) in request.args:
            if arg_key != "tbl" and arg_key != "id" and arg_key != "session":
                fields[arg_key] = arg_value

        var state: TxnState = self.registry.txn_of(session_id)
        # Base version: the version this txn first observed for the row.  If the
        # overlay already holds it, txn_record keeps the original base version.
        val base = store_version(self.store, table, key)
        val write = TxnWrite(
            table: table,
            key: key,
            kind: kind,
            fields: fields,
            base_version: base
        )
        val updated = txn_record(state, write)
        var registry = self.registry
        registry.set_txn(session_id, updated)
        self.registry = registry
        ok_response()

    fn sys_read(session_id: i64, request: DbRequest) -> DbResponse:
        val table = request.arg("tbl") ?? ""
        val key = request.arg("id") ?? ""
        if table == "":
            return err_response(ERR_MISSING_ARG, "GET requires tbl=<table>")
        if key == "":
            return err_response(ERR_MISSING_ARG, "GET requires id=<key>")
        if not self.store.get_table(table).?:
            return err_response(ERR_NO_TABLE, "no such table: {table}")
        val column = request.arg("col") ?? ""

        # Overlay first (a session reads its own uncommitted writes), then the
        # committed store.  A peer session has no overlay, so it can only ever
        # observe committed data — that is the isolation guarantee.
        val state: TxnState = self.registry.txn_of(session_id)
        if state.open:
            match txn_lookup(state, table, key):
                Some(pending):
                    val typed: TxnWrite = pending
                    if typed.kind == WRITE_DEL:
                        return err_response(ERR_NOT_FOUND, "{table}/{key} deleted in this transaction")
                    if column == "":
                        return ok_with("id", key)
                    if typed.fields.contains_key(column):
                        return ok_with("value", typed.fields[column])
                    return err_response(ERR_NOT_FOUND, "no column {column} on {table}/{key}")
                nil:
                    pass

        match store_read(self.store, table, key):
            Some(row):
                val typed_row: SdnRow = row
                if column == "":
                    return ok_with("id", key)
                match typed_row.get(column):
                    Some(value):
                        ok_with("value", value)
                    nil:
                        err_response(ERR_NOT_FOUND, "no column {column} on {table}/{key}")
            nil:
                err_response(ERR_NOT_FOUND, "{table}/{key} not found")

    me sys_batch_put(session_id: i64, request: DbRequest) -> DbResponse:
        val bounds: BoundedQuery = server_query_bounds()
        val ids_text = request.arg("ids") ?? ""
        val ids = ids_text.split(",")
        if ids_text == "" or ids.len() > bounds.max_items:
            return err_response(ERR_LIMIT, "BATCH_PUT requires 1..{bounds.max_items} ids")
        for id in ids:
            if id == "":
                return err_response(ERR_MALFORMED, "empty batch id")
        for id in ids:
            var args: Dict<text, text> = {}
            for (key, value) in request.args:
                if key != "ids":
                    args[key] = value
            args["id"] = id
            val result = self.sys_write(session_id, DbRequest(op: "PUT", args: args), WRITE_PUT)
            if not result.ok:
                return result
        ok_with("queued", "{ids.len()}")

    fn sys_batch_get(session_id: i64, request: DbRequest) -> DbResponse:
        val bounds: BoundedQuery = server_query_bounds()
        val ids_text = request.arg("ids") ?? ""
        val ids = ids_text.split(",")
        if ids_text == "" or ids.len() > bounds.max_items:
            return err_response(ERR_LIMIT, "BATCH_GET requires 1..{bounds.max_items} ids")
        var values: [text] = []
        for id in ids:
            var args: Dict<text, text> = {}
            for (key, value) in request.args:
                if key != "ids":
                    args[key] = value
            args["id"] = id
            val item = self.sys_read(session_id, DbRequest(op: "GET", args: args))
            if not item.ok:
                return item
            var value = ""
            if item.fields.contains_key("value"):
                value = item.fields["value"]
            elif item.fields.contains_key("id"):
                value = item.fields["id"]
            else:
                return err_response(ERR_MALFORMED, "batch item has no value or id")
            var prospective = values
            prospective.push(value)
            if encode_response(ok_with("values", prospective.join(","))).bytes().len() > bounds.max_response_bytes:
                return err_response(ERR_LIMIT, "batch response exceeds {bounds.max_response_bytes} bytes")
            values = prospective
        val joined = values.join(",")
        if encode_response(ok_with("values", joined)).bytes().len() > MAX_RESPONSE_BYTES:
            return err_response(ERR_LIMIT, "batch response exceeds {MAX_RESPONSE_BYTES} bytes")
        ok_with("values", joined)

    fn sys_range_get(session_id: i64, request: DbRequest) -> DbResponse:
        val bounds: BoundedQuery = server_query_bounds()
        val table_name = request.arg("tbl") ?? ""
        val start = request.arg("start") ?? ""
        val end = request.arg("end") ?? ""
        val parsed_limit = try_parse_int(request.arg("limit") ?? "64")
        val limit = parsed_limit ?? 0
        if limit <= 0 or limit > bounds.max_items:
            return err_response(ERR_LIMIT, "range limit must be 1..{bounds.max_items}")
        var candidates: Dict<text, bool> = {}
        match self.store.get_table(table_name):
            Some(table):
                val typed: SdnTable = table
                var scanned = 0
                for row in typed.rows:
                    scanned = scanned + 1
                    if scanned > bounds.max_scan_rows:
                        return err_response(ERR_LIMIT, "range scan exceeds {bounds.max_scan_rows} rows")
                    val id = row.get("id") ?? ""
                    if row.get("valid") != Some("false"):
                        candidates[id] = true
            nil:
                return err_response(ERR_NO_TABLE, "no such table: {table_name}")
        val state = self.registry.txn_of(session_id)
        if state.open:
            var overlay_scanned = 0
            for write in state.writes:
                overlay_scanned = overlay_scanned + 1
                if overlay_scanned > bounds.max_scan_rows:
                    return err_response(ERR_LIMIT, "range overlay exceeds {bounds.max_scan_rows} writes")
                val typed_write: TxnWrite = write
                if typed_write.table == table_name:
                    candidates[typed_write.key] = typed_write.kind != WRITE_DEL
        var ids: [text] = []
        for (id, visible) in candidates:
            if visible and id >= start and (end == "" or id <= end):
                ids.push(id)
        ids.sort()
        var bounded_ids: [text] = []
        var index = 0
        while index < ids.len() and index < limit:
            var prospective = bounded_ids
            prospective.push(ids[index])
            if encode_response(ok_with("ids", prospective.join(","))).bytes().len() > bounds.max_response_bytes:
                return err_response(ERR_LIMIT, "range response exceeds {bounds.max_response_bytes} bytes")
            bounded_ids = prospective
            index = index + 1
        val joined = bounded_ids.join(",")
        if encode_response(ok_with("ids", joined)).bytes().len() > MAX_RESPONSE_BYTES:
            return err_response(ERR_LIMIT, "range response exceeds {MAX_RESPONSE_BYTES} bytes")
        ok_with("ids", joined)

    # ------------------------------------------------------------------
    # Dispatch — the one place a request becomes an effect
    # ------------------------------------------------------------------

    me handle_request(request: DbRequest) -> DbResponse:
        val op = request.op

        if op == "OPEN":
            return self.sys_open(request)

        if op == "PING":
            return ok_response()

        # Every remaining op is session-scoped.
        val session_text = request.arg("session") ?? ""
        if session_text == "":
            return err_response(ERR_MISSING_ARG, "{op} requires session=<id>")
        # `text.to_int()` NEVER returns nil — "notanumber" silently became 0, so
        # this guard never fired and a malformed frame was answered with
        # `no_session` instead of `malformed`.  `try_parse_int` is the
        # fail-closed parse.
        val parsed = try_parse_int(session_text)
        if parsed == nil:
            return err_response(ERR_MALFORMED, "session id is not a number: {session_text}")
        val session_id: i64 = parsed ?? 0
        if not self.registry.is_open(session_id):
            return err_response(ERR_NO_SESSION, "session {session_id} is not open")

        # Capability gate BEFORE any data reach.  deny-wins.
        val table = request.arg("tbl") ?? ""
        if op_access(op) != "" and table == "":
            # A data op naming no table is rejected outright.  It is never
            # treated as "unrestricted" — see capability_allows.
            return err_response(ERR_MISSING_ARG, "{op} requires tbl=<table>")
        val capability = self.registry.capability_of(session_id)
        if not capability_allows_op(capability, op, table):
            return err_response(
                ERR_DENIED,
                "principal {capability.principal} lacks {op_access(op)} on {table}"
            )

        if op == "CLOSE":
            return self.sys_close(session_id)
        if op == "BEGIN":
            return self.sys_begin(session_id)
        if op == "COMMIT":
            return self.sys_commit(session_id, request)
        if op == "ROLLBACK":
            return self.sys_rollback(session_id)
        if op == "PUT":
            return self.sys_write(session_id, request, WRITE_PUT)
        if op == "DEL":
            return self.sys_write(session_id, request, WRITE_DEL)
        if op == "GET":
            return self.sys_read(session_id, request)
        if op == "BATCH_PUT":
            return self.sys_batch_put(session_id, request)
        if op == "BATCH_GET":
            return self.sys_batch_get(session_id, request)
        if op == "RANGE_GET":
            return self.sys_range_get(session_id, request)

        err_response(ERR_UNKNOWN_OP, "unhandled op: {op}")

    # Message-level entry point.  FAIL-CLOSED: a malformed line yields an ERR
    # response and leaves the store and every session untouched.
    me handle_message(line: text) -> text:
        val parsed = parse_request(line)
        match parsed:
            Ok(request):
                val encoded = encode_response(self.handle_request(request))
                if encoded.bytes().len() > MAX_RESPONSE_BYTES:
                    return encode_response(err_response(ERR_LIMIT, "response exceeds byte bound"))
                encoded
            Err(message):
                encode_response(err_response(ERR_MALFORMED, message))

    fn bounded_message_response(line: text) -> text:
        # Shared by scripted and production transports so neither can bypass
        # the encoded-byte response ceiling.
        self.handle_message(line)

    # ------------------------------------------------------------------
    # Connection lifecycle over a transport port
    # ------------------------------------------------------------------

    # Drain one connection: read until EOF, answer every message.  The loop
    # never aborts on a bad message — that is the fail-closed requirement.
    #
    # Returns a ServeOutcome carrying BOTH the served count and the drained
    # channel.  The channel must be handed back: a transport passed in as a
    # parameter is mutated on serve()'s own copy, so a caller that kept only
    # its original binding observed zero sent replies.  Callers read the
    # replies off `outcome.channel`, never off the value they passed in.
    #
    # `channel` MUST be bound ONCE, outside the loop.  Re-binding it from the
    # `transport` parameter on every iteration (as this used to do) throws away
    # read_message()'s write-back, so the queue never drains and the same first
    # message is re-served forever — an unbounded spin that hung the whole spec
    # file behind a 120 s runner timeout.  See .spipe/db_server_hang/state.md.
    #
    # SERVE_MAX_MESSAGES is a bounded-wait guard, not a policy limit: a drain
    # that fails to make progress must fail loudly instead of hanging its
    # caller.  It is far above any real connection length in this tier.
    me serve(transport: MemoryTransport) -> ServeOutcome:
        var channel = transport
        val first_session_id = self.registry.next_id
        var served = 0
        var running = true
        while running:
            if served >= SERVE_MAX_MESSAGES:
                # Loud, bounded failure: the drain is not making progress.
                channel.write_message(encode_response(
                    err_response(ERR_SERVE_BOUND, "serve exceeded message bound")))
                running = false
                continue
            val message = channel.read_message()
            match message:
                Some(line):
                    val reply = self.bounded_message_response(line)
                    if channel.write_message(reply):
                        served = served + 1
                    else:
                        running = false
                nil:
                    running = false
        var registry = self.registry
        registry.close_session_range(first_session_id, registry.next_id)
        self.registry = registry
        ServeOutcome(served: served, channel: channel)

    # Production connection drain. The capsule is the sole state owner: one
    # accepted connection is drained at a time, so readers cannot interleave
    # with durable_commit's apply/persist window. Sessions opened on this
    # connection are always closed at EOF or a bound failure.
    me serve_tcp(transport: TcpDbTransport) -> i64:
        var channel = transport
        val first_session_id = self.registry.next_id
        var served = 0
        var running = true
        while running and served < SERVE_MAX_MESSAGES:
            match channel.read_message():
                Some(line):
                    if channel.write_message(self.bounded_message_response(line)):
                        served = served + 1
                    else:
                        running = false
                nil:
                    running = false
        if served >= SERVE_MAX_MESSAGES:
            channel.write_message(encode_response(err_response(ERR_SERVE_BOUND, "serve exceeded message bound")))
        var registry = self.registry
        registry.close_session_range(first_session_id, registry.next_id)
        self.registry = registry
        channel.close()
        served

    fn connection_capacity() -> i64:
        1

    fn connection_count() -> i64:
        self.active_connections

    # Bounded production listener. A sequential owner is intentional: it is
    # the synchronization boundary for store+registry state and supplies
    # capacity-one backpressure without exposing the P3/P4 commit window.
    me listen(host: text, port: i64, max_connections: i64) -> Result<i64, IoError>:
        if max_connections <= 0:
            return Err(IoError(kind: IoErrorKind.InvalidInput, message: "max_connections must be positive", source: nil))
        val bounded = if max_connections > LISTENER_MAX_CONNECTIONS: LISTENER_MAX_CONNECTIONS else: max_connections
        val listener_result = DbListenerControl.bind("{host}:{port}")
        match listener_result:
            Err(error):
                self.listener_running = false
                Err(error)
            Ok(listener_value):
                self.serve_listener(listener_value, bounded)

    # The caller may retain `control.stop_handle()` and call request_stop()
    # from another owner. The bounded accept timeout returns control to this
    # sole listener owner, which observes stop and closes its mutex-owned fd.
    me serve_listener(control: DbListenerControl, max_connections: i64) -> Result<i64, IoError>:
        var listener = control
        self.listener_running = true
        var accepted = 0
        while not listener.is_stopped() and accepted < max_connections:
            match listener.accept_timeout(LISTENER_ACCEPT_TIMEOUT_MS):
                Err(accept_error):
                    if listener.is_stopped() or accept_error.kind == IoErrorKind.Interrupted:
                        break
                    if accept_error.kind == IoErrorKind.TimedOut:
                        continue
                    listener.close_owned()
                    self.listener_running = false
                    return Err(accept_error)
                Ok(transport):
                    # Stop may be published while the bounded accept is in
                    # flight. A connection completed after that publication
                    # is owned only for cleanup; it must never reach auth,
                    # session creation, or mutation dispatch.
                    if listener.is_stopped():
                        var rejected = transport
                        rejected.close()
                        break
                    self.active_connections = 1
                    self.serve_tcp(transport)
                    self.active_connections = 0
                    accepted = accepted + 1
        listener.close_owned()
        self.listener_running = false
        Ok(accepted)

# ============================================================================
# Convenience constructors
# ============================================================================

fn new_db_server(store: SdnDatabase, policy: CapabilityTable) -> DbServerCapsule:
    DbServerCapsule.new(store, policy)
