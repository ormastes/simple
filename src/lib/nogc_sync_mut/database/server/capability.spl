# Simple DB server tier — capability-checked access control
#
# DENY-WINS.  A grant is an explicit (table, op) pair.  Anything not explicitly
# granted is denied.  There is no wildcard-deny escape hatch and no "admin"
# bypass: an admin principal is simply one holding many grants.
#
# The check is a pure function of (capability, table, op) — no I/O, no store
# access — so it is trivially testable and cannot be raced.

use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}

val UNKNOWN_PRINCIPAL_DIGEST: text = sha256_text("db-server-unknown-principal")

# ============================================================================
# Access kinds
# ============================================================================

val ACCESS_READ: text = "read"
val ACCESS_WRITE: text = "write"

# Map a protocol op onto the access it requires.
# An op with no data reach ("" ) needs no table grant.
fn op_access(op: text) -> text:
    if op == "GET" or op == "BATCH_GET" or op == "RANGE_GET":
        return ACCESS_READ
    if op == "PUT" or op == "DEL" or op == "BATCH_PUT":
        return ACCESS_WRITE
    ""

# ============================================================================
# DbCapability — the set of grants held by one principal
# ============================================================================

struct DbCapability:
    principal: text
    # key = "<table>:<access>" -> "1".  A Dict is used rather than a list so the
    # check is O(1) and cannot be defeated by grant-list ordering.
    grants: Dict<text, text>

struct AuthenticatedPrincipal:
    principal: text
    capability: DbCapability

fn grant_key(table: text, access: text) -> text:
    table + ":" + access

fn empty_capability(principal: text) -> DbCapability:
    DbCapability(principal: principal, grants: {})

# Build a capability from explicit grants.  Read access is NOT implied by write
# — a write-only principal genuinely cannot read.
fn capability_with(principal: text, table_access_pairs: [text]) -> DbCapability:
    var grants: Dict<text, text> = {}
    for pair in table_access_pairs:
        grants[pair] = "1"
    DbCapability(principal: principal, grants: grants)

fn capability_grant(capability: DbCapability, table: text, access: text) -> DbCapability:
    # Returns a NEW capability.  Capabilities are values: never mutated in place,
    # so a session cannot widen its own grants by aliasing.
    var grants: Dict<text, text> = {}
    for (key, value) in capability.grants:
        grants[key] = value
    grants[grant_key(table, access)] = "1"
    DbCapability(principal: capability.principal, grants: grants)

# The single authoritative check.  deny-wins: returns true ONLY on an explicit
# grant match.
fn capability_allows(capability: DbCapability, table: text, access: text) -> bool:
    if access == "":
        # Session-control ops (OPEN/BEGIN/COMMIT/PING/...) reach no data.
        return true
    if table == "":
        # A data op with no table named is not "unrestricted" — it is denied.
        return false
    capability.grants.contains_key(grant_key(table, access))

# Convenience: check a whole request shape at once.
fn capability_allows_op(capability: DbCapability, op: text, table: text) -> bool:
    capability_allows(capability, table, op_access(op))

# ============================================================================
# CapabilityTable — principal -> capability, the server's policy port
# ============================================================================

class CapabilityTable:
    entries: Dict<text, DbCapability>
    credential_digests: Dict<text, text>

    static fn new() -> CapabilityTable:
        CapabilityTable(entries: {}, credential_digests: {})

    me register(capability: DbCapability):
        # Extract -> mutate -> write back: never a mutating call through two
        # field hops (interpreter drops those writes).
        var entries = self.entries
        entries[capability.principal] = capability
        self.entries = entries

    me register_authenticated(capability: DbCapability, credential: text):
        """Register a capability with the credential required by OPEN.

        Empty credentials are refused so a configured principal can never
        silently become name-only authenticated.
        """
        if credential == "":
            return
        self.register(capability)
        var digests = self.credential_digests
        digests[capability.principal] = sha256_text(credential)
        self.credential_digests = digests

    me register_authenticated_bytes(capability: DbCapability, credential: [u8]):
        """Register a capability from credential BYTES the caller still owns.

        Identical policy to `register_authenticated`, but the secret never
        becomes an immutable `text`. `sha256_text(s)` is defined as
        `sha256_u8_hex(rt_text_to_bytes(s))` (sha256.spl:209-220), so the digest
        stored here is byte-for-byte the one `authenticate_principal` computes
        from the wire credential — the two registration paths are
        interchangeable, not merely similar.

        Why this exists: a caller that must wipe its credential can only wipe a
        MUTABLE buffer. Building a `text` to pass to `register_authenticated`
        creates immutable copies with no zeroization surface, which survive for
        the process lifetime and can reach a core dump or a retained image. See
        doc/08_tracking/bug/simpleos_server_credential_zeroization_gap_2026-08-14.md.
        The caller keeps ownership and is responsible for wiping `credential`
        after this returns; nothing here retains it.
        """
        if credential.len() == 0u64:
            return
        self.register(capability)
        var digests = self.credential_digests
        digests[capability.principal] = sha256_u8_hex(credential)
        self.credential_digests = digests

    fn authenticate_principal(principal: text, candidate: text) -> AuthenticatedPrincipal?:
        """Hash then compare exactly 64 digest characters for every attempt."""
        val known = principal != "" and self.credential_digests.contains_key(principal) and self.entries.contains_key(principal)
        val expected: text = if known: self.credential_digests[principal] else: UNKNOWN_PRINCIPAL_DIGEST
        val candidate_digest = sha256_text(candidate)
        val left = expected.chars()
        val right = candidate_digest.chars()
        var different = 0
        var i = 0
        while i < 64:
            val a = left[i].to_int()
            val b = right[i].to_int()
            different = different | (a ^ b)
            i = i + 1
        if known and candidate != "" and different == 0:
            return Some(AuthenticatedPrincipal(principal: principal, capability: self.entries[principal]))
        nil

    fn authenticate(principal: text, candidate: text) -> bool:
        self.authenticate_principal(principal, candidate).?

    fn lookup(principal: text) -> DbCapability?:
        if self.entries.contains_key(principal):
            Some(self.entries[principal])
        else:
            nil

    # Unknown principal => empty capability => every data op denied.
    fn lookup_or_empty(principal: text) -> DbCapability:
        match self.lookup(principal):
            Some(capability):
                capability
            nil:
                empty_capability(principal)
