# Simple DB server tier — public surface
#
# The server tier sits ABOVE the embedded SDN store (std.database.core).  It
# owns connection lifecycle, session state, request framing, transaction
# scoping and capability-checked access.  It owns NO storage.

# Re-exported from protocol.spl
export DbRequest, DbResponse
export parse_request, encode_response, tokenize
export ok_response, ok_with, err_response, new_request
export known_ops, is_known_op, quote_value, is_decimal_digits
export ERR_MALFORMED, ERR_UNKNOWN_OP, ERR_MISSING_ARG, ERR_NO_SESSION
export ERR_DENIED, ERR_NO_TXN, ERR_TXN_OPEN, ERR_CONFLICT, ERR_NO_TABLE
export ERR_NOT_FOUND

# Re-exported from capability.spl
export DbCapability, CapabilityTable
export ACCESS_READ, ACCESS_WRITE, op_access, grant_key
export empty_capability, capability_with, capability_grant
export capability_allows, capability_allows_op

# Re-exported from session.spl
export SessionIdentity, SessionRegistry

# Re-exported from txn.spl
export TxnWrite, TxnState, CommitOutcome
export WRITE_PUT, WRITE_DEL
export closed_txn, begin_txn, txn_record, txn_lookup, txn_write_count
export txn_precheck, txn_apply, txn_commit
export store_read, store_version, overlay_key

# Re-exported from transport.spl
export DbTransport, MemoryTransport

# Re-exported from server.spl
export DbServerCapsule, new_db_server
