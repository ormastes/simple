# Simple DB server tier — transport port
#
# This is deliberately the SAME shape as the established in-repo transport
# abstraction, `std.mcp_sdk.transport.transport.Transport`
# (read_message / write_message / close, blocking reads, nil on EOF).  We do
# not invent a parallel IPC idea.
#
# It is restated here rather than imported because importing mcp_sdk from the
# database tier would invert the dependency (database -> mcp).  Any adapter
# from an MCP-style transport to this port is a five-line forwarding class; see
# next-increment plan in .spipe/db_server_tier/state.md.
#
# MemoryTransport is the BufferTransport-equivalent: no externs, no stdin, safe
# in interpreter mode, which is where the specs run.

use std.nogc_sync_mut.io.tcp.{TcpListener, TcpStream}
use std.io.types.{IoError, IoErrorKind}
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_lock, mutex_unlock}

trait DbTransport:
    """One framed message channel between a client and the DB server.

    read_message() blocks until a message arrives; returns nil on EOF/closed.
    write_message() must not return until the message has been handed off;
    false means delivery failed and the connection owner must terminate.
    """

    fn read_message() -> text?

    fn write_message(msg: text) -> bool

    fn close()

trait DbListener:
    fn accept_timeout(ms: i64) -> Result<TcpDbTransport, IoError>
    fn local_addr() -> Result<text, IoError>
    fn close() -> Result<(), IoError>

class TcpDbTransport with DbTransport:
    stream: TcpStream
    closed: bool
    timeout_ready: bool

    static fn from_stream(stream: TcpStream) -> TcpDbTransport:
        var bounded = stream
        val read_ready = bounded.set_read_timeout_status(5000)
        var write_ready = false
        match bounded.set_write_timeout(Some(5000)):
            Ok(_): write_ready = true
            Err(_): write_ready = false
        val ready = read_ready and write_ready
        if not ready:
            bounded.close()
        TcpDbTransport(stream: bounded, closed: not ready, timeout_ready: ready)

    fn is_ready() -> bool:
        self.timeout_ready and not self.closed

    me read_message() -> text?:
        if self.closed or not self.timeout_ready:
            return nil
        var stream = self.stream
        val message = stream.read_line_nullable()
        self.stream = stream
        message

    me write_message(msg: text) -> bool:
        if not self.closed and self.timeout_ready:
            var stream = self.stream
            val written = stream.write_text_status(msg + "\n")
            self.stream = stream
            return written
        false

    me close():
        if not self.closed:
            var stream = self.stream
            stream.close()
            self.stream = stream
            self.closed = true

class TcpDbListener with DbListener:
    listener: TcpListener

    static fn bind(addr: text) -> Result<TcpDbListener, IoError>:
        match TcpListener.bind(addr):
            Ok(listener): Ok(TcpDbListener(listener: listener))
            Err(error): Err(error)

    me accept_timeout(ms: i64) -> Result<TcpDbTransport, IoError>:
        match self.listener.accept_timeout(ms):
            Err(error): Err(error)
            Ok(stream):
                val transport = TcpDbTransport.from_stream(stream)
                if not transport.is_ready():
                    return Err(IoError(
                        kind: IoErrorKind.Other,
                        message: "connection timeout setup failed", source: nil))
                Ok(transport)

    fn local_addr() -> Result<text, IoError>:
        self.listener.local_addr()

    me close() -> Result<(), IoError>:
        var listener = self.listener
        val result = listener.close()
        self.listener = listener
        result

class DbStopControl:
    stop_gate: Mutex
    accept_gate: Mutex

    static fn new() -> DbStopControl:
        DbStopControl(stop_gate: mutex_new(false), accept_gate: mutex_new(0))

    fn is_stopped() -> bool:
        val stopped: bool = mutex_lock(self.stop_gate)
        mutex_unlock(self.stop_gate, stopped)
        stopped

    me request_stop():
        val _previous: bool = mutex_lock(self.stop_gate)
        mutex_unlock(self.stop_gate, true)

    fn accept_attempt_count() -> i64:
        val count: i64 = mutex_lock(self.accept_gate)
        mutex_unlock(self.accept_gate, count)
        count

    me record_attempt():
        val count: i64 = mutex_lock(self.accept_gate)
        mutex_unlock(self.accept_gate, count + 1)

class DbListenerOwnerState:
    listener: TcpDbListener
    closed: bool

class DbListenerControl with DbListener:
    listener_gate: Mutex
    stop: DbStopControl

    static fn bind(addr: text) -> Result<DbListenerControl, IoError>:
        match TcpDbListener.bind(addr):
            Ok(listener): Ok(DbListenerControl(
                listener_gate: mutex_new(DbListenerOwnerState(listener: listener, closed: false)),
                stop: DbStopControl.new()
            ))
            Err(error): Err(error)

    fn is_stopped() -> bool:
        self.stop.is_stopped()

    fn local_addr() -> Result<text, IoError>:
        if self.is_stopped():
            return Err(IoError(kind: IoErrorKind.Interrupted, message: "database listener stopped", source: nil))
        var state: DbListenerOwnerState = mutex_lock(self.listener_gate)
        if state.closed or self.is_stopped():
            mutex_unlock(self.listener_gate, state)
            return Err(IoError(kind: IoErrorKind.Interrupted, message: "database listener stopped", source: nil))
        val result = state.listener.local_addr()
        mutex_unlock(self.listener_gate, state)
        result

    fn stop_handle() -> DbStopControl:
        self.stop

    fn accept_attempt_count() -> i64:
        self.stop.accept_attempt_count()

    me request_stop() -> Result<(), IoError>:
        var stop = self.stop
        stop.request_stop()
        self.stop = stop
        Ok(())

    # Listener state is behind one shared mutex. accept_timeout holds this gate
    # across the bounded native accept, so close cannot race a numeric fd use;
    # it waits for that attempt, marks the shared state closed, then releases
    # the descriptor exactly once.
    me close_owned() -> Result<(), IoError>:
        var stop = self.stop
        stop.request_stop()
        self.stop = stop
        var state: DbListenerOwnerState = mutex_lock(self.listener_gate)
        if state.closed:
            mutex_unlock(self.listener_gate, state)
            return Ok(())
        var listener = state.listener
        val result = listener.close()
        state.listener = listener
        state.closed = true
        mutex_unlock(self.listener_gate, state)
        result

    me accept_timeout(ms: i64) -> Result<TcpDbTransport, IoError>:
        if self.is_stopped():
            return Err(IoError(kind: IoErrorKind.Interrupted, message: "database listener stopped", source: nil))
        var state: DbListenerOwnerState = mutex_lock(self.listener_gate)
        if state.closed or self.is_stopped():
            mutex_unlock(self.listener_gate, state)
            return Err(IoError(kind: IoErrorKind.Interrupted, message: "database listener stopped", source: nil))
        var stop = self.stop
        stop.record_attempt()
        self.stop = stop
        var listener = state.listener
        val result = listener.accept_timeout(ms)
        state.listener = listener
        mutex_unlock(self.listener_gate, state)
        result

    me close() -> Result<(), IoError>:
        self.close_owned()

# ============================================================================
# MemoryTransport — scripted inbound, captured outbound (specs + golden runs)
# ============================================================================

class MemoryTransport with DbTransport:
    inbound: [text]
    sent: [text]
    closed: bool
    fail_writes: bool

    static fn new() -> MemoryTransport:
        MemoryTransport(inbound: [], sent: [], closed: false, fail_writes: false)

    static fn with_messages(messages: [text]) -> MemoryTransport:
        MemoryTransport(inbound: messages, sent: [], closed: false, fail_writes: false)

    static fn with_failed_writes(messages: [text]) -> MemoryTransport:
        MemoryTransport(inbound: messages, sent: [], closed: false, fail_writes: true)

    me push_inbound(msg: text):
        var inbound = self.inbound
        inbound.push(msg)
        self.inbound = inbound

    me read_message() -> text?:
        if self.closed:
            return nil
        if self.inbound.len() == 0:
            return nil
        val first: text = self.inbound[0]
        var rest: [text] = []
        var i = 1
        while i < self.inbound.len():
            rest.push(self.inbound[i])
            i = i + 1
        self.inbound = rest
        Some(first)

    me write_message(msg: text) -> bool:
        if self.closed or self.fail_writes:
            return false
        var sent = self.sent
        sent.push(msg)
        self.sent = sent
        true

    me close():
        self.closed = true

    fn all_sent() -> [text]:
        self.sent

    fn sent_count() -> i64:
        self.sent.len()

    fn last_sent() -> text:
        if self.sent.len() == 0:
            return ""
        self.sent[self.sent.len() - 1]
