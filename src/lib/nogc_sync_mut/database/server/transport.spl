# Simple DB server tier — transport port
#
# This is deliberately the SAME shape as the established in-repo transport
# abstraction, `std.mcp_sdk.transport.transport.Transport`
# (read_message / write_message / close, blocking reads, nil on EOF).  We do
# not invent a parallel IPC idea.
#
# It is restated here rather than imported because importing mcp_sdk from the
# database tier would invert the dependency (database -> mcp).  Any adapter
# from an MCP-style transport to this port is a five-line forwarding class; see
# next-increment plan in .spipe/db_server_tier/state.md.
#
# MemoryTransport is the BufferTransport-equivalent: no externs, no stdin, safe
# in interpreter mode, which is where the specs run.

use std.nogc_sync_mut.io.tcp.{TcpStream}

trait DbTransport:
    """One framed message channel between a client and the DB server.

    read_message() blocks until a message arrives; returns nil on EOF/closed.
    write_message() must not return until the message has been handed off.
    """

    fn read_message() -> text?

    fn write_message(msg: text)

    fn close()

class TcpDbTransport with DbTransport:
    stream: TcpStream
    closed: bool

    static fn from_stream(stream: TcpStream) -> TcpDbTransport:
        TcpDbTransport(stream: stream, closed: false)

    me read_message() -> text?:
        if self.closed:
            return nil
        var stream = self.stream
        val message = stream.read_line_nullable()
        self.stream = stream
        message

    me write_message(msg: text):
        if not self.closed:
            var stream = self.stream
            stream.write_text_status(msg + "\n")
            self.stream = stream

    me close():
        if not self.closed:
            var stream = self.stream
            stream.close()
            self.stream = stream
            self.closed = true

# ============================================================================
# MemoryTransport — scripted inbound, captured outbound (specs + golden runs)
# ============================================================================

class MemoryTransport with DbTransport:
    inbound: [text]
    sent: [text]
    closed: bool

    static fn new() -> MemoryTransport:
        MemoryTransport(inbound: [], sent: [], closed: false)

    static fn with_messages(messages: [text]) -> MemoryTransport:
        MemoryTransport(inbound: messages, sent: [], closed: false)

    me push_inbound(msg: text):
        var inbound = self.inbound
        inbound.push(msg)
        self.inbound = inbound

    me read_message() -> text?:
        if self.closed:
            return nil
        if self.inbound.len() == 0:
            return nil
        val first: text = self.inbound[0]
        var rest: [text] = []
        var i = 1
        while i < self.inbound.len():
            rest.push(self.inbound[i])
            i = i + 1
        self.inbound = rest
        Some(first)

    me write_message(msg: text):
        if self.closed:
            return
        var sent = self.sent
        sent.push(msg)
        self.sent = sent

    me close():
        self.closed = true

    fn all_sent() -> [text]:
        self.sent

    fn sent_count() -> i64:
        self.sent.len()

    fn last_sent() -> text:
        if self.sent.len() == 0:
            return ""
        self.sent[self.sent.len() - 1]
