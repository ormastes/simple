# Simple DB server tier — wire protocol (request framing / response encoding)
#
# The server tier owns FRAMING ONLY.  Storage, indexes and durability stay in
# the embedded SDN store (std.database.core).  This module never touches a
# table.
#
# Request  line:  OP k=v k=v ...            e.g.  PUT tbl=users id=u1 name=ada
# Response line:  OK [k=v ...]              e.g.  OK value=ada
#                 ERR code=<code> msg=<...>
#
# Values may be double-quoted to carry spaces:  name="ada lovelace".
#
# FAIL-CLOSED CONTRACT: every malformed input returns an Err/ERR response.
# Parsing must never crash, never partially apply, and never leave the caller
# holding a half-built request.

# ============================================================================
# Error codes (stable wire vocabulary)
# ============================================================================

val ERR_MALFORMED: text = "malformed"
val ERR_UNKNOWN_OP: text = "unknown_op"
val ERR_MISSING_ARG: text = "missing_arg"
val ERR_NO_SESSION: text = "no_session"
val ERR_DENIED: text = "denied"
val ERR_NO_TXN: text = "no_txn"
val ERR_TXN_OPEN: text = "txn_open"
val ERR_CONFLICT: text = "conflict"
val ERR_NO_TABLE: text = "no_table"
val ERR_NOT_FOUND: text = "not_found"
# The overlay was consistent and applied, but the store could not be made
# durable.  The in-memory store has been rolled back to its last durable
# state, so this code means "nothing happened", not "maybe something happened".
val ERR_DURABILITY: text = "durability"
# A simulated crash point fired.  Never produced in production: a real crash
# produces a dropped connection, not a frame.  It exists so the crash-point
# spec can drive the server end-to-end instead of only the durability module.
val ERR_CRASHED: text = "crashed"
# A connection drain hit its message bound without reaching EOF.  This means
# the transport is not draining (a stuck or non-advancing channel), and the
# server chose a loud bounded failure over an unbounded block.
val ERR_SERVE_BOUND: text = "serve_bound"
val ERR_AUTH: text = "auth"

val MAX_REQUEST_BYTES: i64 = 8192
val MAX_REQUEST_ARGS: i64 = 64

# ============================================================================
# Op vocabulary — closed set.  Anything else is rejected.
# ============================================================================

fn known_ops() -> [text]:
    ["OPEN", "CLOSE", "BEGIN", "COMMIT", "ROLLBACK", "PUT", "GET", "DEL", "PING"]

fn is_known_op(op: text) -> bool:
    for candidate in known_ops():
        if candidate == op:
            return true
    false

# ============================================================================
# DbRequest
# ============================================================================

struct DbRequest:
    op: text
    args: Dict<text, text>

    fn arg(key: text) -> text?:
        if self.args.contains_key(key):
            Some(self.args[key])
        else:
            nil

    fn has(key: text) -> bool:
        self.args.contains_key(key)

fn new_request(op: text, args: Dict<text, text>) -> DbRequest:
    DbRequest(op: op, args: args)

# ============================================================================
# DbResponse
# ============================================================================

struct DbResponse:
    ok: bool
    code: text
    fields: Dict<text, text>

fn ok_response() -> DbResponse:
    DbResponse(ok: true, code: "", fields: {})

fn ok_with(key: text, value: text) -> DbResponse:
    var fields: Dict<text, text> = {}
    fields[key] = value
    DbResponse(ok: true, code: "", fields: fields)

fn err_response(code: text, msg: text) -> DbResponse:
    var fields: Dict<text, text> = {}
    fields["msg"] = msg
    DbResponse(ok: false, code: code, fields: fields)

# ============================================================================
# Tokenizer — splits on unquoted whitespace, honours double quotes
# ============================================================================

fn tokenize(line: text) -> Result<[text], text>:
    var tokens: [text] = []
    var chars: [text] = []
    var in_quotes = false
    var produced = false
    var i = 0
    val cs = line.chars()
    while i < cs.len():
        val ch = cs[i]
        if ch == '"':
            in_quotes = not in_quotes
            produced = true
        elif (ch == ' ' or ch == '\t') and not in_quotes:
            if produced:
                tokens.push(chars.join(""))
                chars = []
                produced = false
        else:
            chars.push(ch)
            produced = true
        i = i + 1

    if in_quotes:
        return Err("unterminated quote")
    if produced:
        tokens.push(chars.join(""))
    Ok(tokens)

# ============================================================================
# parse_request — the only entry point.  Total: never crashes.
# ============================================================================

fn parse_request(line: text) -> Result<DbRequest, text>:
    if line.chars().len() > MAX_REQUEST_BYTES:
        return Err("request exceeds {MAX_REQUEST_BYTES} bytes")
    val trimmed = line.trim()
    if trimmed == "":
        return Err("empty request")

    val tokens_result = tokenize(trimmed)
    var tokens: [text] = []
    match tokens_result:
        Ok(list):
            tokens = list
        Err(message):
            return Err(message)

    if tokens.len() == 0:
        return Err("empty request")

    val op = tokens[0]
    if not is_known_op(op):
        return Err("unknown op: {op}")

    var args: Dict<text, text> = {}
    var i = 1
    while i < tokens.len():
        if i > MAX_REQUEST_ARGS:
            return Err("request has too many arguments")
        val token: text = tokens[i]
        val eq = token.index_of("=")
        if eq < 1:
            return Err("bad argument: {token}")
        val key = token[0..eq]
        val value = token[(eq + 1)..token.chars().len()]
        if key == "":
            return Err("empty argument key")
        if args.contains_key(key):
            return Err("duplicate argument: {key}")
        args[key] = value
        i = i + 1

    Ok(DbRequest(op: op, args: args))

# ============================================================================
# encode_response
# ============================================================================

fn quote_value(value: text) -> text:
    if value.contains(" ") or value.contains("\t") or value == "":
        return '"' + value + '"'
    value

fn encode_response(response: DbResponse) -> text:
    var parts: [text] = []
    if response.ok:
        parts.push("OK")
    else:
        parts.push("ERR")
        parts.push("code=" + quote_value(response.code))
    # Deterministic field order: Dict iteration order is NOT stable across
    # processes (seed Dict.keys() is unordered), and an unstable wire encoding
    # would make golden transcripts flaky.  Sort the keys.
    var keys: [text] = []
    for (key, _value) in response.fields:
        keys.push(key)
    keys.sort()
    for key in keys:
        val value: text = response.fields[key]
        parts.push(key + "=" + quote_value(value))
    parts.join(" ")
