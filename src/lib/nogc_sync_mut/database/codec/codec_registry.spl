# Page codec registry: lazy PageCodecV1 registration with profile admission.
#
# Master plan §2.2 (PageCodecV1 contract) and §4.5 (codec layout). The
# registry admits a codec only when its manifest profile digest matches a
# registered, versioned profile; a wrong or unknown digest is a typed
# rejection. Codecs register by id + version; resolution is latest-wins with a
# recorded diagnostic. NO cipher code runs at registration or at registry
# load: an entry stores metadata plus a factory function, and the factory is
# invoked only on first resolve (lazy instantiation).
#
# Error mapping (documented policy, Sqlcipher4Error taxonomy):
#   * profile digest not registered        -> CipherProfileMismatch
#   * entry interface_version mismatch     -> UnsupportedCipherVersion
#   * resolve of an unregistered codec id  -> UnsupportedCipherVersion
#     ("codec '<id>' is not registered with a matching profile")
# Admission runs BEFORE the factory is touched, so a rejected registration
# never instantiates cipher code.
#
# Integration hook for sibling lanes: build a CodecRegistryEntry with
# `codec_registry_sqlcipher4_entry(factory, codec_version)` (which binds the
# locked-profile digest from sqlcipher4_manifest) and pass it to
# `CodecRegistry.register_codec`. Sibling modules (key sessions, page+HMAC)
# stay un-imported here; they wire in purely through this entry shape.

use nogc_sync_mut.database.codec.sqlcipher4.{
    Sqlcipher4Error, Sqlcipher4Profile,
    sqlcipher4_profile_digest, sqlcipher4_validate_profile
}
use nogc_sync_mut.database.codec.sqlcipher4_manifest.{
    Sqlcipher4Manifest, sqlcipher4_manifest
}

# ============================================================================
# Opaque key-session handle
# ============================================================================

struct CodecSessionV1:
    """Opaque key-session handle produced by `PageCodecV1.open_key`.

    The registry treats this as an opaque capability: `secret_material` is
    owned and interpreted exclusively by the codec implementation that opened
    the session (sibling key-session lane). Registry code never inspects,
    copies, or logs it, and user-facing error text must never include it."""
    codec_id: text
    open: bool
    secret_material: [u8]

# ============================================================================
# PageCodecV1 — page codec contract as a typed function record
# ============================================================================

struct PageCodecV1:
    """Page codec contract per master plan §2.2, expressed as a function
    record (the shape Simple traits desugar to).

    Lifecycle: `profile_fn`/`manifest_fn` are pure metadata; `open_key` turns
    a secret reference plus the on-disk file salt into an opaque session;
    `decode_page` authenticates then decrypts one page; `encode_page`
    encrypts one page with a fresh IV from `rng` (16 random bytes per call);
    `close` releases the session. The registry never calls these directly —
    the pager calls them on the instance obtained from `resolve`."""
    codec_id: text
    profile_fn: fn() -> Sqlcipher4Profile
    manifest_fn: fn() -> Sqlcipher4Manifest
    open_key_fn: fn(text, [u8]) -> Result<CodecSessionV1, Sqlcipher4Error>
    decode_page_fn: fn(i64, [u8], CodecSessionV1) -> Result<[u8], Sqlcipher4Error>
    encode_page_fn: fn(i64, [u8], CodecSessionV1, fn(i64) -> [u8]) -> Result<[u8], Sqlcipher4Error>
    close_fn: fn(CodecSessionV1) -> Result<(), Sqlcipher4Error>

# ============================================================================
# Registry records
# ============================================================================

struct CodecProfileRegistration:
    """A versioned profile the registry admits codecs against."""
    profile_name: text
    profile_digest: text
    interface_version: i64

struct CodecRegistryEntry:
    """Lazy codec record: identity + profile binding + factory.

    The factory builds the codec instance on first resolve; registration and
    registry construction never invoke it."""
    codec_id: text
    codec_version: i64
    interface_version: i64
    profile_digest: text
    factory: fn(text) -> PageCodecV1

fn codec_registry_sqlcipher4_entry(factory: fn(text) -> PageCodecV1, codec_version: i64) -> CodecRegistryEntry:
    """Build a registry entry for the pure-Simple SQLCipher 4 codec.

    This is the single integration point sibling lanes wire into: they supply
    a factory that constructs their PageCodecV1 implementation; the entry
    binds the locked-profile digest and the PageCodecV1 interface version from
    this lane's manifest."""
    val manifest = sqlcipher4_manifest()
    CodecRegistryEntry(
        codec_id: manifest.codec_id,
        codec_version: codec_version,
        interface_version: manifest.interface_version,
        profile_digest: manifest.profile_digest,
        factory: factory
    )

# ============================================================================
# Registry
# ============================================================================

class CodecRegistry:
    """Lazy page-codec registry with profile-digest admission.

    Registration policy (documented):
      * `register_profile` validates the locked profile and binds its digest
        to an interface version.
      * `register_codec` admits an entry only when its profile digest matches
        a registered profile and its interface version matches that profile's;
        admission failures are typed rejections and never invoke the factory.
      * Duplicate (codec_id, codec_version) is latest-wins: the new entry
        replaces the old and a diagnostic is recorded.
      * `resolve` picks the highest registered version for the id and lazily
        invokes its factory."""
    profiles: [CodecProfileRegistration]
    codecs: [CodecRegistryEntry]
    diagnostics: [text]

    static fn new() -> CodecRegistry:
        CodecRegistry(profiles: [], codecs: [], diagnostics: [])

    me register_profile(profile: Sqlcipher4Profile, interface_version: i64) -> Result<text, Sqlcipher4Error>:
        """Validate the locked profile and register it by digest. Returns the
        digest on success; a deviating profile is a typed rejection."""
        sqlcipher4_validate_profile(profile)?
        val digest = sqlcipher4_profile_digest(profile)?
        for existing in self.profiles:
            if existing.profile_digest == digest:
                return Ok(digest)
        self.profiles.push(CodecProfileRegistration(
            profile_name: profile.profile_name,
            profile_digest: digest,
            interface_version: interface_version
        ))
        Ok(digest)

    fn profile_registered(profile_digest: text) -> bool:
        for registration in self.profiles:
            if registration.profile_digest == profile_digest:
                return true
        false

    fn profile_registration(profile_digest: text) -> CodecProfileRegistration?:
        for registration in self.profiles:
            if registration.profile_digest == profile_digest:
                return Some(registration)
        nil

    me register_codec(entry: CodecRegistryEntry) -> Result<(), Sqlcipher4Error>:
        """Admit a codec entry. Typed rejection (before any factory call) when
        the profile digest is unregistered or the interface version differs."""
        val registration = match self.profile_registration(entry.profile_digest):
            Some(r): r
            None:
                return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "codec '{entry.codec_id}' profile digest is not a registered, versioned profile"))
        if entry.interface_version != registration.interface_version:
            return Err(Sqlcipher4Error.UnsupportedCipherVersion(detail: "codec '{entry.codec_id}' interface_version {entry.interface_version} does not match registered profile interface version {registration.interface_version}"))
        for i in 0..self.codecs.len():
            if self.codecs[i].codec_id == entry.codec_id and self.codecs[i].codec_version == entry.codec_version:
                self.diagnostics.push("codec '{entry.codec_id}' version {entry.codec_version} re-registered; previous entry replaced (latest-wins)")
                self.codecs[i] = entry
                return Ok(())
        self.codecs.push(entry)
        Ok(())

    fn find_entry(codec_id: text, codec_version: i64) -> CodecRegistryEntry?:
        for entry in self.codecs:
            if entry.codec_id == codec_id and entry.codec_version == codec_version:
                return Some(entry)
        nil

    fn latest_version(codec_id: text) -> i64?:
        var best: i64? = nil
        for entry in self.codecs:
            if entry.codec_id == codec_id:
                if val b = best:
                    if entry.codec_version > b:
                        best = Some(entry.codec_version)
                else:
                    best = Some(entry.codec_version)
        best

    fn latest_entry(codec_id: text) -> CodecRegistryEntry?:
        for entry in self.codecs:
            if entry.codec_id == codec_id:
                if val v = self.latest_version(codec_id):
                    if entry.codec_version == v:
                        return Some(entry)
        nil

    me resolve(codec_id: text) -> Result<PageCodecV1, Sqlcipher4Error>:
        """Resolve the latest registered version of a codec, lazily invoking
        its factory. Unknown ids are a typed not-found rejection."""
        match self.latest_entry(codec_id):
            Some(entry): Ok(entry.factory(codec_id))
            None: Err(Sqlcipher4Error.UnsupportedCipherVersion(detail: "codec '{codec_id}' is not registered with a matching profile"))

    fn list_codecs() -> [text]:
        """Registered codecs as '<id>@<version>' strings, admission order."""
        var out: [text] = []
        for entry in self.codecs:
            out.push("{entry.codec_id}@{entry.codec_version}")
        out

    fn list_diagnostics() -> [text]:
        self.diagnostics
