# SecretRef — opaque secret references for the SQLCipher 4 codec open path.
#
# INTEGRATION LANE (storage port -> std.database.server -> devhub adapter):
# this module owns the SecretRef indirection that replaces the cipher-c page
# lane's documented open_key passphrase shim (codec/sqlcipher4_page.spl). A
# SecretRef is a validated `secret://<name>` URI; the secret VALUE is never
# carried in configuration, CLI, SDN, or logs — only the reference crosses
# those boundaries (plan §7.2/§12.3: secret_ref is an opaque reference,
# never a key value).
#
# RESOLUTION DISCIPLINE (same as app.llm_caret's credential resolver): a ref
# maps to exactly one process-environment variable
#   secret://messenger/main -> SIMPLE_SECRET_MESSENGER_MAIN
# Names admit [A-Za-z0-9._/-] ('/' as a namespace separator, folded to '_'
# in the env var name); '..' and platform separators are rejected, so a
# config file cannot point a reader at an arbitrary file or env name
# outside the SIMPLE_SECRET_* namespace.
#
# SECRET HYGIENE (honest runtime limits, same record as the cipher lanes):
#   * The resolved value returns as a wipeable, push-built [u8] copy; the
#     caller zeroizes it after the KDF consumes it.
#   * At this base the env facade yields the value as `text`
#     (std.nogc_sync_mut.io.env_ops.env_get), so the secret transits one
#     frozen text value that Simple cannot wipe (index-assign on frozen
#     extern results fails; see
#     doc/08_tracking/bug/secure_memory_u8_zeroize_unregistered_extern_2026-10-22.md).
#     This module therefore never CONSTRUCTS secret text of its own and
#     never logs or interpolates the value; the residual frozen copy is the
#     documented runtime limit, identical to the key-session lane's record.
#   * Errors name the REF and the failure class only; the value is never
#     part of an error payload.
#
# Typed failures reuse the shared codec taxonomy (codec/sqlcipher4.spl):
#   MissingSecret         — unset/empty env value, or unparsable ref.
#   UnsupportedKeyType    — (reserved) non-env ref scheme.

use nogc_sync_mut.database.codec.sqlcipher4.{Sqlcipher4Error}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.common.text_bytes.{text_to_utf8_bytes}

val SECRET_REF_SCHEME: text = "secret://"
val SECRET_REF_ENV_PREFIX: text = "SIMPLE_SECRET_"

struct SecretRef:
    """Validated opaque secret reference (plan §12.3).

    `uri` is the canonical secret:// form; `env_key` is the single
    environment variable this ref resolves through. Neither is secret
    material."""
    uri: text
    env_key: text

# True when ch is an ASCII letter, digit, '.', '_', '-' or '/'. Slashes
# are admitted as namespace separators (secret://messenger/main); they fold
# into '_' in the env var name and cannot escape the SIMPLE_SECRET_*
# namespace.
fn _ref_name_char(ch: text) -> bool:
    val c = ch.char_code_at(0)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or
        ch == "." or ch == "_" or ch == "-" or ch == "/"

# Validate a secret:// reference and bind it to its env var. Fail-closed:
# anything that is not exactly secret://<restricted-name> is rejected, never
# coerced (a bare passphrase, a file path, or a traversal attempt are all
# MissingSecret — the ref namespace admits none of them).
fn secret_ref_parse(uri: text) -> Result<SecretRef, Sqlcipher4Error>:
    if not uri.starts_with(SECRET_REF_SCHEME):
        return Err(Sqlcipher4Error.MissingSecret(detail: "secret reference must use the '{SECRET_REF_SCHEME}' scheme"))
    val name = uri.substring(SECRET_REF_SCHEME.len(), uri.len())
    if name == "":
        return Err(Sqlcipher4Error.MissingSecret(detail: "secret reference has an empty name"))
    if name.len() > 128:
        return Err(Sqlcipher4Error.MissingSecret(detail: "secret reference name is {name.len()} chars, max 128"))
    if name.contains(".."):
        return Err(Sqlcipher4Error.MissingSecret(detail: "secret reference name must not contain '..'"))
    if name.contains("\\") or name.contains(":"):
        return Err(Sqlcipher4Error.MissingSecret(detail: "secret reference name must not contain separators"))
    var i = 0
    while i < name.len():
        if not _ref_name_char(name[i]):
            return Err(Sqlcipher4Error.MissingSecret(detail: "secret reference name contains a forbidden character"))
        i = i + 1
    Ok(SecretRef(uri: uri, env_key: _secret_ref_env_key(name)))

# secret://<name> -> SIMPLE_SECRET_<NAME> with '/', '-' and '.' folded to
# '_' (env var naming), uppercased. The folding is injective enough for the
# admitted charset: 'a-b', 'a.b', 'a/b' and 'a_b' collide on one var —
# accepted, a ref is a capability label, not a storage key.
fn _secret_ref_env_key(name: text) -> text:
    var out = SECRET_REF_ENV_PREFIX
    var i = 0
    while i < name.len():
        val ch = name[i]
        if ch == "-" or ch == "." or ch == "/":
            out = out + "_"
        else:
            out = out + ch
        i = i + 1
    out.upper()

# The env var a ref resolves through (diagnostic surface: safe, nonsecret).
fn secret_ref_env_key(ref: SecretRef) -> text:
    ref.env_key

# Resolve a validated ref to the secret bytes. Returns a fresh wipeable
# push-built copy; the caller owns zeroization. Unset and empty env values
# both fail closed with MissingSecret (an empty passphrase is a defect, not
# a profile).
fn secret_ref_resolve(ref: SecretRef) -> Result<[u8], Sqlcipher4Error>:
    val value = env_get(ref.env_key)
    if value == "":
        return Err(Sqlcipher4Error.MissingSecret(detail: "no secret value for reference (env {ref.env_key} is unset or empty)"))
    val frozen = text_to_utf8_bytes(value)
    var out: [u8] = []
    var i = 0
    while i < frozen.len():
        out.push(frozen[i])
        i = i + 1
    if out.len() == 0:
        return Err(Sqlcipher4Error.MissingSecret(detail: "resolved secret is empty"))
    Ok(out)

# Convenience one-shot: parse + resolve. The parse result is exposed for
# callers that need the env binding in diagnostics.
fn secret_ref_resolve_uri(uri: text) -> Result<[u8], Sqlcipher4Error>:
    match secret_ref_parse(uri):
        case Err(e):
            Err(e)
        case Ok(ref):
            secret_ref_resolve(ref)

export SECRET_REF_SCHEME, SECRET_REF_ENV_PREFIX
export SecretRef, secret_ref_parse, secret_ref_env_key
export secret_ref_resolve, secret_ref_resolve_uri
