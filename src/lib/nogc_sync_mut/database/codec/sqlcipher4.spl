# SQLCipher 4 locked profile, error taxonomy, and non-secret file probes.
#
# Owns the explicit, immutable `sqlcipher4_4k_sha512` profile as data
# (master plan 2026-10-21 §4.1), the shared `Sqlcipher4Error` taxonomy
# (§4.5), and the non-secret header probes (§5.1). This module deliberately
# contains NO key handling, NO page cryptography, and NO SQL/file-format
# parsing: sibling lanes own those (`sqlcipher4_keys.spl`, `sqlcipher4_page.spl`)
# and compose with this layer through `codec_registry.spl` registration at
# integration time. None of the locked values below is ever read from config,
# environment, caller input, or file content.

use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{file_read_bytes_result}

# ============================================================================
# Locked profile constants — `sqlcipher4_4k_sha512` (master plan §4.1)
# ============================================================================

val SQLCIPHER4_PROFILE_NAME: text = "sqlcipher4_4k_sha512"
val SQLCIPHER4_FORMAT: text = "sqlcipher4"
val SQLCIPHER4_PAGE_SIZE: i64 = 4096
val SQLCIPHER4_CIPHER: text = "aes_256_cbc"
val SQLCIPHER4_CIPHER_PADDING: text = "none"
val SQLCIPHER4_CIPHER_KEY_BYTES: i64 = 32
val SQLCIPHER4_KDF: text = "pbkdf2_hmac_sha512"
val SQLCIPHER4_KDF_ITER: i64 = 256000
val SQLCIPHER4_KDF_SALT_BYTES: i64 = 16
val SQLCIPHER4_IV_BYTES: i64 = 16
val SQLCIPHER4_HMAC: text = "hmac_sha512"
val SQLCIPHER4_HMAC_BYTES: i64 = 64
val SQLCIPHER4_HMAC_KDF: text = "pbkdf2_hmac_sha512"
val SQLCIPHER4_HMAC_KDF_ITER: i64 = 2
val SQLCIPHER4_HMAC_SALT_MASK: i64 = 0x3a
val SQLCIPHER4_HMAC_PAGE_NUMBER: text = "le32"
val SQLCIPHER4_PAGE_RESERVED_BYTES: i64 = 80
val SQLCIPHER4_PLAINTEXT_HEADER_BYTES: i64 = 0
val SQLCIPHER4_HMAC_ON: bool = true

# Number of profile fields the validator checks (diagnostics/tests).
val SQLCIPHER4_PROFILE_FIELD_COUNT: i64 = 19

# ============================================================================
# Error taxonomy (master plan §4.5)
# ============================================================================

enum Sqlcipher4Error:
    """Typed SQLCipher 4 codec errors. Every variant maps to a stable string
    code via `sqlcipher4_error_code`; user-facing text must never disclose
    whether a secret guess was close or which key bytes differed."""
    MissingSecret(detail: text)
    CipherProfileMismatch(detail: text)
    AuthenticationFailed(detail: text)
    InvalidPageGeometry(detail: text)
    CorruptPage(detail: text)
    UnsupportedKeyType(detail: text)
    UnsupportedPlaintextHeader(detail: text)
    UnsupportedCipherVersion(detail: text)
    IoFailure(detail: text)
    SnapshotUnavailable(detail: text)

fn sqlcipher4_error_code(err: Sqlcipher4Error) -> text:
    """Stable, log-safe string code for a typed error."""
    match err:
        MissingSecret(_): "SQLCIPHER4_MISSING_SECRET"
        CipherProfileMismatch(_): "SQLCIPHER4_CIPHER_PROFILE_MISMATCH"
        AuthenticationFailed(_): "SQLCIPHER4_AUTHENTICATION_FAILED"
        InvalidPageGeometry(_): "SQLCIPHER4_INVALID_PAGE_GEOMETRY"
        CorruptPage(_): "SQLCIPHER4_CORRUPT_PAGE"
        UnsupportedKeyType(_): "SQLCIPHER4_UNSUPPORTED_KEY_TYPE"
        UnsupportedPlaintextHeader(_): "SQLCIPHER4_UNSUPPORTED_PLAINTEXT_HEADER"
        UnsupportedCipherVersion(_): "SQLCIPHER4_UNSUPPORTED_CIPHER_VERSION"
        IoFailure(_): "SQLCIPHER4_IO_FAILURE"
        SnapshotUnavailable(_): "SQLCIPHER4_SNAPSHOT_UNAVAILABLE"

fn sqlcipher4_error_text(err: Sqlcipher4Error) -> text:
    """Structured, non-secret diagnostic text: stable code plus detail."""
    match err:
        MissingSecret(detail): "{sqlcipher4_error_code(err)}: {detail}"
        CipherProfileMismatch(detail): "{sqlcipher4_error_code(err)}: {detail}"
        AuthenticationFailed(detail): "{sqlcipher4_error_code(err)}: {detail}"
        InvalidPageGeometry(detail): "{sqlcipher4_error_code(err)}: {detail}"
        CorruptPage(detail): "{sqlcipher4_error_code(err)}: {detail}"
        UnsupportedKeyType(detail): "{sqlcipher4_error_code(err)}: {detail}"
        UnsupportedPlaintextHeader(detail): "{sqlcipher4_error_code(err)}: {detail}"
        UnsupportedCipherVersion(detail): "{sqlcipher4_error_code(err)}: {detail}"
        IoFailure(detail): "{sqlcipher4_error_code(err)}: {detail}"
        SnapshotUnavailable(detail): "{sqlcipher4_error_code(err)}: {detail}"

# ============================================================================
# Profile as data
# ============================================================================

struct Sqlcipher4Profile:
    """The explicit, immutable `sqlcipher4_4k_sha512` profile as data.

    Every field is locked by master plan §4.1. Callers receive this struct
    by value; any deviation from the locked values is rejected by
    `sqlcipher4_validate_profile` with a typed `CipherProfileMismatch` — a
    wrong KDF iteration count, page size, or HMAC parameter is never silently
    reinterpreted and never triggers a weakened fallback guess."""
    profile_name: text
    format: text
    page_size: i64
    cipher: text
    cipher_padding: text
    cipher_key_bytes: i64
    kdf: text
    kdf_iter: i64
    kdf_salt_bytes: i64
    iv_bytes: i64
    hmac: text
    hmac_bytes: i64
    hmac_key_derivation: text
    hmac_key_derivation_iter: i64
    hmac_salt_mask: i64
    hmac_page_number: text
    page_reserved_bytes: i64
    plaintext_header_bytes: i64
    hmac_on: bool

fn sqlcipher4_profile() -> Sqlcipher4Profile:
    """The locked `sqlcipher4_4k_sha512` profile (master plan §4.1)."""
    Sqlcipher4Profile(
        profile_name: SQLCIPHER4_PROFILE_NAME,
        format: SQLCIPHER4_FORMAT,
        page_size: SQLCIPHER4_PAGE_SIZE,
        cipher: SQLCIPHER4_CIPHER,
        cipher_padding: SQLCIPHER4_CIPHER_PADDING,
        cipher_key_bytes: SQLCIPHER4_CIPHER_KEY_BYTES,
        kdf: SQLCIPHER4_KDF,
        kdf_iter: SQLCIPHER4_KDF_ITER,
        kdf_salt_bytes: SQLCIPHER4_KDF_SALT_BYTES,
        iv_bytes: SQLCIPHER4_IV_BYTES,
        hmac: SQLCIPHER4_HMAC,
        hmac_bytes: SQLCIPHER4_HMAC_BYTES,
        hmac_key_derivation: SQLCIPHER4_HMAC_KDF,
        hmac_key_derivation_iter: SQLCIPHER4_HMAC_KDF_ITER,
        hmac_salt_mask: SQLCIPHER4_HMAC_SALT_MASK,
        hmac_page_number: SQLCIPHER4_HMAC_PAGE_NUMBER,
        page_reserved_bytes: SQLCIPHER4_PAGE_RESERVED_BYTES,
        plaintext_header_bytes: SQLCIPHER4_PLAINTEXT_HEADER_BYTES,
        hmac_on: SQLCIPHER4_HMAC_ON
    )

fn sqlcipher4_validate_profile(profile: Sqlcipher4Profile) -> Result<(), Sqlcipher4Error>:
    """Reject any deviation from the locked profile with a typed error.

    Returns `Ok(())` only when every field equals the locked §4.1 value."""
    if profile.profile_name != SQLCIPHER4_PROFILE_NAME:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "profile_name is '{profile.profile_name}', locked profile requires '{SQLCIPHER4_PROFILE_NAME}'"))
    if profile.format != SQLCIPHER4_FORMAT:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "format is '{profile.format}', locked profile requires '{SQLCIPHER4_FORMAT}'"))
    if profile.page_size != SQLCIPHER4_PAGE_SIZE:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "page_size is {profile.page_size}, locked profile requires {SQLCIPHER4_PAGE_SIZE}"))
    if profile.cipher != SQLCIPHER4_CIPHER:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "cipher is '{profile.cipher}', locked profile requires '{SQLCIPHER4_CIPHER}'"))
    if profile.cipher_padding != SQLCIPHER4_CIPHER_PADDING:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "cipher_padding is '{profile.cipher_padding}', locked profile requires '{SQLCIPHER4_CIPHER_PADDING}' (no PKCS#7 on page payload)"))
    if profile.cipher_key_bytes != SQLCIPHER4_CIPHER_KEY_BYTES:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "cipher_key_bytes is {profile.cipher_key_bytes}, locked profile requires {SQLCIPHER4_CIPHER_KEY_BYTES}"))
    if profile.kdf != SQLCIPHER4_KDF:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "kdf is '{profile.kdf}', locked profile requires '{SQLCIPHER4_KDF}'"))
    if profile.kdf_iter != SQLCIPHER4_KDF_ITER:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "kdf_iter is {profile.kdf_iter}, locked profile requires {SQLCIPHER4_KDF_ITER}"))
    if profile.kdf_salt_bytes != SQLCIPHER4_KDF_SALT_BYTES:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "kdf_salt_bytes is {profile.kdf_salt_bytes}, locked profile requires {SQLCIPHER4_KDF_SALT_BYTES}"))
    if profile.iv_bytes != SQLCIPHER4_IV_BYTES:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "iv_bytes is {profile.iv_bytes}, locked profile requires {SQLCIPHER4_IV_BYTES}"))
    if profile.hmac != SQLCIPHER4_HMAC:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac is '{profile.hmac}', locked profile requires '{SQLCIPHER4_HMAC}'"))
    if profile.hmac_bytes != SQLCIPHER4_HMAC_BYTES:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac_bytes is {profile.hmac_bytes}, locked profile requires {SQLCIPHER4_HMAC_BYTES}"))
    if profile.hmac_key_derivation != SQLCIPHER4_HMAC_KDF:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac_key_derivation is '{profile.hmac_key_derivation}', locked profile requires '{SQLCIPHER4_HMAC_KDF}'"))
    if profile.hmac_key_derivation_iter != SQLCIPHER4_HMAC_KDF_ITER:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac_key_derivation_iter is {profile.hmac_key_derivation_iter}, locked profile requires {SQLCIPHER4_HMAC_KDF_ITER}"))
    if profile.hmac_salt_mask != SQLCIPHER4_HMAC_SALT_MASK:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac_salt_mask is {profile.hmac_salt_mask}, locked profile requires {SQLCIPHER4_HMAC_SALT_MASK}"))
    if profile.hmac_page_number != SQLCIPHER4_HMAC_PAGE_NUMBER:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac_page_number is '{profile.hmac_page_number}', locked profile requires 32-bit little-endian ('{SQLCIPHER4_HMAC_PAGE_NUMBER}')"))
    if profile.page_reserved_bytes != SQLCIPHER4_PAGE_RESERVED_BYTES:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "page_reserved_bytes is {profile.page_reserved_bytes}, locked profile requires {SQLCIPHER4_PAGE_RESERVED_BYTES}"))
    if profile.plaintext_header_bytes != SQLCIPHER4_PLAINTEXT_HEADER_BYTES:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "plaintext_header_bytes is {profile.plaintext_header_bytes}, locked profile requires {SQLCIPHER4_PLAINTEXT_HEADER_BYTES}"))
    if not profile.hmac_on:
        return Err(Sqlcipher4Error.CipherProfileMismatch(detail: "hmac_on is false, locked profile requires true (no downgrade path)"))
    Ok(())

# ============================================================================
# Canonical profile serialization and digest
# ============================================================================

fn sqlcipher4_profile_canonical(profile: Sqlcipher4Profile) -> text:
    """Deterministic canonical serialization of the profile (line format).

    This is the exact byte input for the profile digest; do not reorder or
    reformat lines without bumping the format marker."""
    var lines: [text] = []
    lines.push("sqlcipher4-profile/1")
    lines.push("profile_name={profile.profile_name}")
    lines.push("format={profile.format}")
    lines.push("page_size={profile.page_size}")
    lines.push("cipher={profile.cipher}")
    lines.push("cipher_padding={profile.cipher_padding}")
    lines.push("cipher_key_bytes={profile.cipher_key_bytes}")
    lines.push("kdf={profile.kdf}")
    lines.push("kdf_iter={profile.kdf_iter}")
    lines.push("kdf_salt_bytes={profile.kdf_salt_bytes}")
    lines.push("iv_bytes={profile.iv_bytes}")
    lines.push("hmac={profile.hmac}")
    lines.push("hmac_bytes={profile.hmac_bytes}")
    lines.push("hmac_key_derivation={profile.hmac_key_derivation}")
    lines.push("hmac_key_derivation_iter={profile.hmac_key_derivation_iter}")
    lines.push("hmac_salt_mask={profile.hmac_salt_mask}")
    lines.push("hmac_page_number={profile.hmac_page_number}")
    lines.push("page_reserved_bytes={profile.page_reserved_bytes}")
    lines.push("plaintext_header_bytes={profile.plaintext_header_bytes}")
    lines.push("hmac_on={profile.hmac_on}")
    lines.join("\n") + "\n"

fn sqlcipher4_profile_digest(profile: Sqlcipher4Profile) -> Result<text, Sqlcipher4Error>:
    """SHA-256 (64 lowercase hex chars) of the canonical profile serialization.

    The profile is validated first: hashing a deviating profile would give a
    digest that falsely authenticates a non-locked configuration."""
    sqlcipher4_validate_profile(profile)?
    Ok(sha256_text(sqlcipher4_profile_canonical(profile)))

# ============================================================================
# Non-secret file probes (master plan §5.1)
# ============================================================================

fn sqlcipher4_read_file_salt(page1: [u8]) -> Result<[u8], Sqlcipher4Error>:
    """Read the 16-byte plaintext file salt from the start of an on-disk
    encrypted page 1 (SQLCipher stores the DB-specific salt there in
    plaintext). Returns a typed `InvalidPageGeometry` error when the buffer
    is shorter than 16 bytes."""
    if page1.len() < 16:
        return Err(Sqlcipher4Error.InvalidPageGeometry(detail: "page 1 buffer is {page1.len()} bytes, need at least 16 for the plaintext file salt"))
    var salt: [u8] = []
    var i: i64 = 0
    while i < 16:
        salt.push(page1[i])
        i = i + 1
    Ok(salt)

fn sqlcipher4_detect_plaintext_sqlite(path: text) -> bool:
    """True only when the file starts with the plaintext `SQLite format 3\\0`
    magic. Returns false for encrypted files, unreadable/missing files, and
    any buffer shorter than 16 bytes. Never infers SQLCipher from randomness
    — encrypted formats require explicit selection and a verified profile."""
    match file_read_bytes_result(path):
        case Ok(bytes): _starts_with_sqlite_magic(bytes)
        case Err(_): false

fn _starts_with_sqlite_magic(bytes: [u8]) -> bool:
    if bytes.len() < 16:
        return false
    var magic: [u8] = []
    magic.push(0x53u8)
    magic.push(0x51u8)
    magic.push(0x4cu8)
    magic.push(0x69u8)
    magic.push(0x74u8)
    magic.push(0x65u8)
    magic.push(0x20u8)
    magic.push(0x66u8)
    magic.push(0x6fu8)
    magic.push(0x72u8)
    magic.push(0x6du8)
    magic.push(0x61u8)
    magic.push(0x74u8)
    magic.push(0x20u8)
    magic.push(0x33u8)
    magic.push(0x00u8)
    var i: i64 = 0
    while i < 16:
        if bytes[i] != magic[i]:
            return false
        i = i + 1
    true
