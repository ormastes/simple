# Typed SQL Database Library - Core Types
#
# Provides typed value containers, error types, and row abstraction
# for the SQL database layer built on top of sqlite_sffi.

# ============================================================================
# DbType — SQLite column types
# ============================================================================

enum DbType:
    Integer
    Real
    Text
    Blob
    Null

# ============================================================================
# DbValue — typed value container
# ============================================================================

enum DbValue:
    Integer(value: i64)
    Real(value: f64)
    Text(value: text)
    Blob(value: [u8])
    Null
    Bool(value: bool)

impl DbValue:
    pub fn as_int() -> i64?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Integer(value): Some(value)
            DbValue.Bool(value):
                if value:
                    Some(1)
                else:
                    Some(0)
            _: nil

    pub fn as_real() -> f64?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Real(value): Some(value)
            _: nil

    pub fn as_text() -> text?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Text(value): Some(value)
            _: nil

    pub fn as_bool() -> bool?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Bool(value): Some(value)
            DbValue.Integer(value):
                if value == 0:
                    Some(false)
                elif value == 1:
                    Some(true)
                else:
                    nil
            _: nil

    pub fn is_null() -> bool:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Null: true
            _: false

    pub fn db_type() -> DbType:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Integer(_): DbType.Integer
            DbValue.Real(_): DbType.Real
            DbValue.Text(_): DbType.Text
            DbValue.Blob(_): DbType.Blob
            DbValue.Null: DbType.Null
            DbValue.Bool(_): DbType.Integer

    pub fn to_text() -> text:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbValue.Integer(value): "{value}"
            DbValue.Real(value): "{value}"
            DbValue.Text(value): value
            DbValue.Blob(value): "<blob:{value.len()} bytes>"
            DbValue.Null: "NULL"
            DbValue.Bool(value):
                if value:
                    "true"
                else:
                    "false"

# ============================================================================
# DbError — all possible database errors
# ============================================================================

enum DbError:
    ConnectionFailed(path: text, message: text)
    QueryFailed(sql: text, message: text)
    BindFailed(index: i64, message: text)
    TypeMismatch(column: text, expected: text, actual: text)
    NotFound(description: text)
    ConstraintViolation(message: text)
    MigrationFailed(id: text, reason: text)
    TransactionFailed(reason: text)
    Closed
    Other(message: text)

impl DbError:
    pub fn message() -> text:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        match self:
            DbError.ConnectionFailed(path, message): "Connection failed to '{path}': {message}"
            DbError.QueryFailed(sql, message): "Query failed '{sql}': {message}"
            DbError.BindFailed(index, message): "Bind failed at index {index}: {message}"
            DbError.TypeMismatch(column, expected, actual): "Type mismatch on column '{column}': expected {expected}, got {actual}"
            DbError.NotFound(description): "Not found: {description}"
            DbError.ConstraintViolation(message): "Constraint violation: {message}"
            DbError.MigrationFailed(id, reason): "Migration '{id}' failed: {reason}"
            DbError.TransactionFailed(reason): "Transaction failed: {reason}"
            DbError.Closed: "Database connection is closed"
            DbError.Other(message): message

# ============================================================================
# DbRow — a single typed database row
# ============================================================================

struct DbRow:
    columns: [text]
    values: [DbValue]

impl DbRow:
    static fn empty() -> DbRow:
        DbRow(columns: [], values: [])

    pub fn get(column: text) -> DbValue?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        for i in 0..self.columns.len():
            if self.columns[i] == column:
                return Some(self.values[i])
        nil

    pub fn get_text(column: text) -> text?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        val v = self.get(column)?
        v.as_text()

    pub fn get_int(column: text) -> i64?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        val v = self.get(column)?
        v.as_int()

    pub fn get_real(column: text) -> f64?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        val v = self.get(column)?
        v.as_real()

    pub fn get_bool(column: text) -> bool?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        val v = self.get(column)?
        v.as_bool()

    pub fn get_at(index: i64) -> DbValue?:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        if index < 0 or index >= self.values.len():
            return nil
        Some(self.values[index])

    pub fn column_count() -> i64:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        self.columns.len()

    pub fn column_names() -> [text]:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        self.columns

    pub fn has_column(name: text) -> bool:  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 dynload RTI walker reports E-RTI-004 on non-pub enum-impl methods referenced through interface rows (app.ui.access_cli); visibility widening is behavior-preserving
        for col in self.columns:
            if col == name:
                return true
        false
