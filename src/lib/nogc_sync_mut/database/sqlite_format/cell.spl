# SQLite b-tree cell parsing — pointer arrays, leaf/interior table cells and
# overflow chain walking.
#
# Local payload sizing follows sqlite.org/fileformat2 exactly:
#   table leaf   maxLocal = usableSize - 35
#                minLocal = ((usableSize - 12) * 32 / 255) - 23
#   index pages  maxLocal = ((usableSize - 12) * 64 / 255) - 23
#                minLocal = ((usableSize - 12) * 32 / 255) - 23
# with surplus = minLocal + (payload - minLocal) % (usableSize - 4) and
# local = surplus <= maxLocal ? surplus : minLocal for spilled payloads.
# Overflow chains are walked with a visited set plus a step bound derived from
# the page count, so a corrupt chain fails closed instead of looping.

use std.nogc_sync_mut.database.sqlite_format.types.{
    SqliteError, be_u16_at, be_u32_at,
    SQLITE_PAGE_TABLE_INTERIOR, SQLITE_PAGE_TABLE_LEAF
}
use std.nogc_sync_mut.database.sqlite_format.varint.{sqlite_varint_decode}
use std.nogc_sync_mut.database.sqlite_format.pager.{SqlitePager}

# b-tree header displacement for page 1 (the 100-byte file header).
fn cell_base_offset(page_no: i64) -> i64:
    if page_no == 1:
        100
    else:
        0

# Number of cells on a b-tree page (header bytes base+3..base+5, big-endian).
fn cell_count(page: [u8], base: i64) -> i64:
    be_u16_at(page, base + 3)

# Absolute in-page offset of cell i from the pointer array.
fn cell_ptr(page: [u8], base: i64, header_len: i64, index: i64) -> i64:
    be_u16_at(page, base + header_len + 2 * index)

# Local (in-page) payload length for a spilled or unspilled payload.
fn local_payload_len(payload_len: i64, usable: i64, is_index: bool) -> i64:
    var max_local: i64 = 0
    if is_index:
        max_local = ((usable - 12) * 64) / 255 - 23
    else:
        max_local = usable - 35
    val min_local = ((usable - 12) * 32) / 255 - 23
    if payload_len <= max_local:
        return payload_len
    val surplus = min_local + (payload_len - min_local) % (usable - 4)
    if surplus <= max_local:
        surplus
    else:
        min_local

# Read an overflow chain starting at `first_page`, appending up to `needed`
# content bytes. Cycle- and bound-checked.
fn read_overflow_chain(pager: SqlitePager, first_page: i64, needed: i64) -> Result<[u8], SqliteError>:
    var out: [u8] = []
    var visited: [i64] = []
    var page_no = first_page
    var steps: i64 = 0
    val chunk_cap = pager.usable_size() - 4
    while out.len() < needed:
        if page_no == 0:
            return Err(SqliteError.CorruptPage( message: "overflow chain ended after {out.len()} of {needed} bytes"))
        if page_no < 1 or page_no > pager.page_count:
            return Err(SqliteError.PageOutOfRange(page: page_no, page_count: pager.page_count))
        var seen = false
        for v in visited:
            if v == page_no:
                seen = true
        if seen:
            return Err(SqliteError.OverflowCycle(page: page_no))
        visited.push(page_no)
        steps = steps + 1
        if steps > pager.page_count:
            return Err(SqliteError.OverflowLimitExceeded(page: first_page, steps: steps))

        val page = pager.get_page(page_no)?
        pager.check_span(0, 4)?
        val next = be_u32_at(page, 0)
        val want = needed - out.len()
        val take = if want < chunk_cap: want else: chunk_cap
        pager.check_span(4, take)?
        var i: i64 = 0
        while i < take:
            out.push(page[4 + i])
            i = i + 1
        page_no = next
    Ok(out)

# Parse a table-leaf cell: varint payload length, varint rowid, local payload
# bytes, then the overflow chain when the payload spilled.
# Returns (rowid, full record payload).
fn parse_table_leaf_cell(pager: SqlitePager, page: [u8], ptr: i64) -> Result<(i64, [u8]), SqliteError>:
    val usable = pager.usable_size()
    val len_dec = sqlite_varint_decode(page, ptr)?
    val payload_len = len_dec.0 as i64
    val rowid_dec = sqlite_varint_decode(page, ptr + len_dec.1)?
    val rowid = rowid_dec.0 as i64
    val hdr = len_dec.1 + rowid_dec.1
    val local = local_payload_len(payload_len, usable, false)

    var payload: [u8] = []
    pager.check_span(ptr, hdr + local)?
    var i: i64 = 0
    while i < local:
        payload.push(page[ptr + hdr + i])
        i = i + 1

    if local < payload_len:
        pager.check_span(ptr + hdr + local, 4)?
        val first_overflow = be_u32_at(page, ptr + hdr + local)
        val rest = read_overflow_chain(pager, first_overflow, payload_len - local)?
        for b in rest:
            payload.push(b)
    Ok((rowid, payload))

# Parse a table-interior cell: 4-byte big-endian child page + varint rowid key.
# Returns (child_page, key).
fn parse_table_interior_cell(pager: SqlitePager, page: [u8], ptr: i64) -> Result<(i64, i64), SqliteError>:
    pager.check_span(ptr, 5)?
    val child = be_u32_at(page, ptr)
    val key = sqlite_varint_decode(page, ptr + 4)?
    Ok((child, key.0 as i64))

# Validate the b-tree page type byte; returns it as i64.
fn page_kind(page: [u8], base: i64, page_no: i64) -> Result<i64, SqliteError>:
    val kind = page[base] as i64
    if kind == SQLITE_PAGE_TABLE_INTERIOR or kind == SQLITE_PAGE_TABLE_LEAF:
        Ok(kind)
    else:
        Err(SqliteError.UnknownPageType(page: page_no, kind: kind))

