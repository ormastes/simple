# SQLite database header — 100-byte page-1 prefix validation.
#
# All multi-byte header fields are big-endian read with explicit byte
# operations (no host-layout assumptions). Validation is fail-closed: bad
# magic, non power-of-two page size outside 512..65536, short files, unknown
# file format read/write versions, wrong payload fractions, absurd schema
# format or text encoding all produce typed SqliteError values.

use std.nogc_sync_mut.database.sqlite_format.types.{
    SqliteError, SqliteFileInfo, be_u16_at, be_u32_at,
    sqlite_format_magic, SQLITE_HEADER_LEN,
    SQLITE_ENCODING_UTF8, SQLITE_ENCODING_UTF16LE, SQLITE_ENCODING_UTF16BE
}

# Parse and validate the 100-byte SQLite header at the start of file_bytes.
fn sqlite_header_parse(file_bytes: [u8]) -> Result<SqliteFileInfo, SqliteError>:
    if file_bytes.len() < SQLITE_HEADER_LEN:
        return Err(SqliteError.TruncatedFile( expected: SQLITE_HEADER_LEN, actual: file_bytes.len()))

    val magic = sqlite_format_magic()
    var i: i64 = 0
    while i < 16:
        if file_bytes[i] != magic[i]:
            return Err(SqliteError.BadMagic(found: file_bytes[0 : 16]))
        i = i + 1

    # Page size: bytes 16..18, big-endian. The value 1 means 65536.
    val raw_page_size = be_u16_at(file_bytes, 16)
    val page_size = if raw_page_size == 1: 65536 else: raw_page_size
    if page_size < 512 or page_size > 65536 or (page_size & (page_size - 1)) != 0:
        return Err(SqliteError.UnsupportedPageSize(value: raw_page_size))

    val reserved_bytes = file_bytes[20] as i64
    if page_size - reserved_bytes < 480:
        return Err(SqliteError.CorruptPage( message: "reserved bytes {reserved_bytes} leave usable page below 480 bytes"))

    val write_version = file_bytes[18] as i64
    val read_version = file_bytes[19] as i64
    if write_version < 1 or write_version > 2 or read_version < 1 or read_version > 2:
        return Err(SqliteError.UnsupportedFeature( what: "file format read/write version {read_version}/{write_version}"))

    # Payload fractions (offsets 21, 22, 23) must be exactly 64, 32, 32.
    if file_bytes[21] != 64 or file_bytes[22] != 32 or file_bytes[23] != 32:
        return Err(SqliteError.CorruptPage(message: "unexpected payload fractions"))

    val page_count = be_u32_at(file_bytes, 28)
    if page_count < 1:
        return Err(SqliteError.CorruptPage(message: "header reports zero pages"))

    val schema_format = be_u32_at(file_bytes, 44)
    if schema_format < 1 or schema_format > 4:
        return Err(SqliteError.CorruptPage(message: "schema format {schema_format} outside 1..4"))

    val text_encoding = be_u32_at(file_bytes, 56)
    if text_encoding != SQLITE_ENCODING_UTF8 and
       text_encoding != SQLITE_ENCODING_UTF16LE and
       text_encoding != SQLITE_ENCODING_UTF16BE:
        return Err(SqliteError.UnsupportedFeature(what: "text encoding {text_encoding}"))

    if file_bytes.len() < page_count * page_size:
        return Err(SqliteError.TruncatedFile( expected: page_count * page_size, actual: file_bytes.len()))

    Ok(SqliteFileInfo( page_size: page_size, page_count: page_count, reserved_bytes: reserved_bytes, text_encoding: text_encoding, schema_cookie: be_u32_at(file_bytes, 40), file_change_counter: be_u32_at(file_bytes, 24), read_version: read_version, write_version: write_version, schema_format: schema_format, file_bytes: file_bytes.len()))

