# SQLite schema layer — sqlite_schema decoding and conservative CREATE TABLE
# parsing.
#
# sqlite_schema rows are [type, name, tbl_name, rootpage, sql] records in the
# table b-tree rooted at page 1. The CREATE TABLE parser here is deliberately
# conservative: it extracts column names for typed row reads and the INTEGER
# PRIMARY KEY rowid alias for the writer. Anything it cannot prove is surfaced
# to the caller, which fails closed with UnsupportedFeature rather than
# guessing (plan section 3.3 item 5).

use std.nogc_sync_mut.database.sqlite_format.types.{SqliteError}
use std.nogc_sync_mut.database.sqlite_format.pager.{SqlitePager}
use std.nogc_sync_mut.database.sqlite_format.btree.{table_btree_scan}
use std.nogc_sync_mut.database.sqlite_format.record.{sqlite_record_decode}
use std.nogc_sync_mut.database.sql.types.{DbValue}
use std.common.encoding.utf8.{text_codepoints, char_from_codepoint}

struct SqliteSchemaEntry:
    obj_type: text
    name: text
    tbl_name: text
    rootpage: i64
    sql: text

struct SqliteTableDef:
    name: text
    columns: [text]
    rootpage: i64
    sql: text
    ipk: i64
    # Column affinities: 0 none/BLOB, 1 integer, 2 real, 3 text (SQLite rules).
    affinity: [i64]

# Read and decode every sqlite_schema row.
fn sqlite_schema_scan(pager: SqlitePager, text_encoding: i64) -> Result<[SqliteSchemaEntry], SqliteError>:
    val rows = table_btree_scan(pager, 1)?
    var entries: [SqliteSchemaEntry] = []
    for row in rows:
        val values = sqlite_record_decode(row.1, text_encoding)?
        if values.len() < 5:
            return Err(SqliteError.MalformedSchema( message: "sqlite_schema row has {values.len()} values, need 5"))
        val obj_type = _as_text(values[0], "sqlite_schema.type")?
        val name = _as_text(values[1], "sqlite_schema.name")?
        val tbl_name = _as_text(values[2], "sqlite_schema.tbl_name")?
        val rootpage = match values[3]:
            DbValue.Integer(v): v
            DbValue.Null: 0
            _: return Err(SqliteError.MalformedSchema(message: "sqlite_schema.rootpage is not an integer"))
        val sql = match values[4]:
            DbValue.Text(t): t
            DbValue.Null: ""
            _: return Err(SqliteError.MalformedSchema(message: "sqlite_schema.sql is not text"))
        entries.push(SqliteSchemaEntry( obj_type: obj_type, name: name, tbl_name: tbl_name, rootpage: rootpage, sql: sql))
    Ok(entries)

fn _as_text(v: DbValue, what: text) -> Result<text, SqliteError>:
    match v:
        DbValue.Text(t): Ok(t)
        _: Err(SqliteError.MalformedSchema(message: "{what} is not text"))

# ASCII lowercase of one character (SQLite identifier folding is ASCII-only;
# enough for the keyword checks below and avoids locale surprises).
fn _lower_char(c: text) -> text:
    val cps = text_codepoints(c)
    if cps.len() == 0:
        return c
    val code = cps[0]
    if code >= 65 and code <= 90:
        return char_from_codepoint(code + 32)
    c

fn ascii_lower(s: text) -> text:
    var out = ""
    for c in s:
        out = out + _lower_char(c)
    out

# True when the token starts a table-level constraint (not a column def).
fn _is_constraint_keyword(tok: text) -> bool:
    val t = ascii_lower(tok)
    t == "primary" or t == "foreign" or t == "unique" or t == "check" or t == "constraint"

# True for ASCII identifier characters ([A-Za-z0-9_$]).
fn _is_ident_char(c: text) -> bool:
    val cps = text_codepoints(c)
    if cps.len() == 0:
        return false
    val code = cps[0]
    (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or
    (code >= 97 and code <= 122) or c == "_" or c == "$"

fn _is_space(c: text) -> bool:
    c == " " or c == "\t" or c == "\n" or c == "\r"

# Skip whitespace and SQL comments (-- line, /* block */) starting at i.
fn _skip_noise(s: text, i: i64) -> i64:
    var p = i
    while p < s.len():
        val c = s[p]
        if _is_space(c):
            p = p + 1
        elif c == "-" and p + 1 < s.len() and s[p + 1] == "-":
            while p < s.len() and s[p] != "\n":
                p = p + 1
        elif c == "/" and p + 1 < s.len() and s[p + 1] == "*":
            var depth = 1
            p = p + 2
            while p + 1 < s.len() and depth > 0:
                if s[p] == "/" and s[p + 1] == "*":
                    depth = depth + 1
                    p = p + 2
                elif s[p] == "*" and s[p + 1] == "/":
                    depth = depth - 1
                    p = p + 2
                else:
                    p = p + 1
        else:
            break
    p

# Read one identifier at i (skipping noise): quoted ("x", [x], `x`) or a bare
# identifier run. Returns (name_without_quotes, next_index) or nil.
fn _read_ident(s: text, i: i64) -> (text, i64)?:
    val p = _skip_noise(s, i)
    if p >= s.len():
        return nil
    val c = s[p]
    if c == "\"" or c == "[" or c == "`":
        val close = if c == "[": "]" else: c
        var j = p + 1
        var out = ""
        while j < s.len():
            if s[j] == close:
                if close != "]" and j + 1 < s.len() and s[j + 1] == close:
                    out = out + close
                    j = j + 2
                    continue
                return Some((out, j + 1))
            out = out + s[j]
            j = j + 1
        return nil
    if not _is_ident_char(c):
        return nil
    var j = p
    var out = ""
    while j < s.len() and _is_ident_char(s[j]):
        out = out + s[j]
        j = j + 1
    Some((out, j))

# Read keyword kw at i (case-insensitive), skipping noise. Returns the index
# just past the keyword, or nil.
fn _expect_keyword(s: text, i: i64, kw: text) -> i64?:
    val p = _skip_noise(s, i)
    val end = p + kw.len()
    if end > s.len():
        return nil
    if ascii_lower(s.substring(p, end)) == kw:
        return Some(end)
    nil

# Closing character for a quote opener ('[' closes with ']').
fn _quote_close(open: text) -> text:
    if open == "[":
        return "]"
    open

# Split a parenthesized body into top-level comma-separated items (quote- and
# paren-aware). Used for the CREATE TABLE column list.
fn _split_top_level_items(body: text) -> [text]:
    var items: [text] = []
    var depth: i64 = 0
    var start: i64 = 0
    var i: i64 = 0
    var quote = ""
    var close = ""
    while i < body.len():
        val c = body[i]
        if quote != "":
            if c == close:
                if close != "]" and i + 1 < body.len() and body[i + 1] == close:
                    i = i + 2
                    continue
                quote = ""
            i = i + 1
            continue
        if c == "'" or c == "\"" or c == "`" or c == "[":
            quote = c
            close = _quote_close(c)
            i = i + 1
            continue
        if c == "(":
            depth = depth + 1
        elif c == ")":
            depth = depth - 1
        elif c == "," and depth == 0:
            items.push(body.substring(start, i))
            start = i + 1
        i = i + 1
    items.push(body.substring(start, body.len()))
    items

# Find the "(" starting the column list, respecting quotes. Returns its index
# or -1.
fn _find_open_paren(s: text, from: i64) -> i64:
    var i = from
    var quote = ""
    var close = ""
    while i < s.len():
        val c = s[i]
        if quote != "":
            if c == close:
                quote = ""
            i = i + 1
            continue
        if c == "'" or c == "\"" or c == "`" or c == "[":
            quote = c
            close = _quote_close(c)
        elif c == "(":
            return i
        i = i + 1
    -1

# Matching close paren index for the "(" at `open`, or -1 when unbalanced.
fn _find_close_paren(s: text, open: i64) -> i64:
    var depth = 1
    var i = open + 1
    var quote = ""
    var close = ""
    while i < s.len():
        val c = s[i]
        if quote != "":
            if c == close:
                quote = ""
            i = i + 1
            continue
        if c == "'" or c == "\"" or c == "`" or c == "[":
            quote = c
            close = _quote_close(c)
        elif c == "(":
            depth = depth + 1
        elif c == ")":
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    -1

# Extract column names from a CREATE TABLE statement. Table-level constraint
# items define no columns and are skipped. Quoting is stripped from names.
fn parse_create_table_columns(sql: text) -> Result<[text], SqliteError>:
    val kw_create = _expect_keyword(sql, 0, "create")
    if kw_create == nil:
        return Err(SqliteError.MalformedSchema(message: "not a CREATE statement"))
    var p = kw_create ?? 0
    val kw_table = _expect_keyword(sql, p, "table")
    if kw_table == nil:
        return Err(SqliteError.MalformedSchema(message: "not a CREATE TABLE statement"))
    p = kw_table ?? 0
    val kw_if = _expect_keyword(sql, p, "if")
    if kw_if != nil:
        val kw_not = _expect_keyword(sql, kw_if ?? 0, "not")
        val kw_exists = _expect_keyword(sql, kw_not ?? 0, "exists")
        if kw_not == nil or kw_exists == nil:
            return Err(SqliteError.MalformedSchema(message: "malformed IF NOT EXISTS"))
        p = kw_exists ?? 0
    val name_tok = _read_ident(sql, p)
    if name_tok == nil:
        return Err(SqliteError.MalformedSchema(message: "CREATE TABLE: missing table name"))
    val open = _find_open_paren(sql, name_tok.1)
    if open < 0:
        return Err(SqliteError.MalformedSchema(message: "CREATE TABLE: missing column list"))
    val close = _find_close_paren(sql, open)
    if close < 0:
        return Err(SqliteError.MalformedSchema(message: "CREATE TABLE: unbalanced parens"))

    val items = _split_top_level_items(sql.substring(open + 1, close))
    var columns: [text] = []
    for item in items:
        val trimmed = _skip_noise(item, 0)
        if trimmed >= item.len():
            continue
        val first = _read_ident(item, trimmed)
        if first == nil:
            return Err(SqliteError.MalformedSchema(message: "CREATE TABLE: bad column definition"))
        if _is_constraint_keyword(first.0):
            continue
        columns.push(first.0)

    # Reject WITHOUT ROWID trailing options explicitly (later gate).
    val tail = ascii_lower(sql.substring(close + 1, sql.len()))
    if tail.contains("without") and tail.contains("rowid"):
        return Err(SqliteError.UnsupportedFeature(what: "WITHOUT ROWID tables"))

    if columns.len() == 0:
        return Err(SqliteError.MalformedSchema(message: "CREATE TABLE: no columns parsed"))
    Ok(columns)

# True when a column-definition tail (after the name) is exactly an INTEGER
# type followed by a PRIMARY KEY column constraint.
fn _item_is_integer_primary_key(rest: text) -> bool:
    val p = _skip_noise(rest, 0)
    val type_tok = _read_ident(rest, p)
    if type_tok == nil:
        return false
    if ascii_lower(type_tok.0) != "integer":
        return false
    val kw1 = _read_ident(rest, type_tok.1)
    if kw1 == nil:
        return false
    if ascii_lower(kw1.0) != "primary":
        return false
    val kw2 = _read_ident(rest, kw2_skip(rest, kw1.1))
    kw2 != nil and ascii_lower(kw2.0) == "key"

fn kw2_skip(s: text, i: i64) -> i64:
    _skip_noise(s, i)

# Affinity code from a declared type token (SQLite affinity rules).
fn _affinity_of_type(type_word: text) -> i64:
    val t = ascii_lower(type_word)
    if t.contains("int"):
        return 1
    if t.contains("char") or t.contains("clob") or t.contains("text"):
        return 3
    if t.contains("real") or t.contains("floa") or t.contains("doub"):
        return 2
    0

# Per-column affinities parsed from the CREATE TABLE column list.
# Per-column affinities parsed from the CREATE TABLE column list.
# Best effort: returns [] when the statement cannot be parsed (callers treat
# that as "no affinity information").
fn parse_create_table_affinities(sql: text) -> [i64]:
    val parsed = parse_create_table_columns(sql)
    var col_count: i64 = 0
    match parsed:
        Ok(cols): col_count = cols.len()
        Err(_): return []
    val open = _find_open_paren(sql, 0)
    if open < 0:
        return []
    val close = _find_close_paren(sql, open)
    if close < 0:
        return []
    val items = _split_top_level_items(sql.substring(open + 1, close))
    var affinities: [i64] = []
    for item in items:
        val trimmed = _skip_noise(item, 0)
        if trimmed >= item.len():
            continue
        val first = _read_ident(item, trimmed)
        if first == nil:
            return []
        if _is_constraint_keyword(first.0):
            continue
        val rest = item.substring(first.1, item.len())
        val type_tok = _read_ident(rest, _skip_noise(rest, 0))
        if type_tok == nil:
            affinities.push(0)
        else:
            affinities.push(_affinity_of_type(type_tok.0))
    if affinities.len() != col_count:
        return []
    affinities

# Index of the INTEGER PRIMARY KEY rowid-alias column, or -1 when none, or -2
# when an IPK carries AUTOINCREMENT (unsupported in the writer gate).
fn parse_create_table_ipk(sql: text) -> i64:
    val parsed = parse_create_table_columns(sql)
    var col_count: i64 = -1
    match parsed:
        Ok(cols): col_count = cols.len()
        Err(_): return -1
    val open = _find_open_paren(sql, 0)
    if open < 0:
        return -1
    val close = _find_close_paren(sql, open)
    if close < 0:
        return -1
    val items = _split_top_level_items(sql.substring(open + 1, close))
    var col_idx: i64 = 0
    for item in items:
        val trimmed = _skip_noise(item, 0)
        if trimmed >= item.len():
            continue
        val first = _read_ident(item, trimmed)
        if first == nil:
            return -1
        if _is_constraint_keyword(first.0):
            continue
        if col_idx >= col_count:
            return -1
        val rest = item.substring(first.1, item.len())
        if _item_is_integer_primary_key(rest):
            if ascii_lower(rest).contains("autoincrement"):
                return -2
            return col_idx
        col_idx = col_idx + 1
    -1

# Find a table entry by name (exact, then ASCII case-insensitive) and parse
# its column list. Fails closed when the table is missing or not a table.
fn find_table_schema(entries: [SqliteSchemaEntry], table_name: text) -> Result<SqliteTableDef, SqliteError>:
    var found: SqliteSchemaEntry? = nil
    for e in entries:
        if e.obj_type == "table" and e.name == table_name:
            found = Some(e)
    if found == nil:
        val lower_wanted = ascii_lower(table_name)
        for e in entries:
            if e.obj_type == "table" and ascii_lower(e.name) == lower_wanted:
                found = Some(e)
    if found == nil:
        return Err(SqliteError.SchemaNotFound(table: table_name))
    val entry = found
    if entry.rootpage < 1:
        return Err(SqliteError.MalformedSchema( message: "table {entry.name} has invalid rootpage {entry.rootpage}"))
    val columns = parse_create_table_columns(entry.sql)?
    var ipk = parse_create_table_ipk(entry.sql)
    if ipk < 0:
        ipk = -1
    val affinities = parse_create_table_affinities(entry.sql)
    Ok(SqliteTableDef( name: entry.name, columns: columns, rootpage: entry.rootpage, sql: entry.sql, ipk: ipk, affinity: affinities))

