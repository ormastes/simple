# SQLite record codec — serial types, signed big-endian ints, IEEE-754 reals,
# BLOB/TEXT payloads with UTF-8 / UTF-16LE / UTF-16BE database text decoding.
#
# Serial types (sqlite.org/fileformat2): 0 NULL, 1..6 two's-complement ints of
# 1,2,3,4,6,8 bytes (wait: 5 is 6 bytes), 7 IEEE-754 f64, 8 integer 0, 9
# integer 1 (both zero body bytes), 10/11 reserved (fail closed), 12+ even
# BLOB of (n-12)/2 bytes, 13+ odd TEXT of (n-13)/2 bytes in the database text
# encoding.  Integers are signed big-endian; reals are big-endian IEEE-754.

use std.nogc_sync_mut.database.sqlite_format.types.{
    SqliteError, be_u16_at,
    SQLITE_ENCODING_UTF8, SQLITE_ENCODING_UTF16LE, SQLITE_ENCODING_UTF16BE
}
use std.nogc_sync_mut.database.sqlite_format.varint.{
    sqlite_varint_decode, sqlite_varint_encode, sqlite_varint_len
}
use std.nogc_sync_mut.database.sql.types.{DbValue}
use std.common.binary_io.{f64_from_bits, f64_to_bits}
use std.common.encoding.utf8.{utf8_decode_one, utf8_encode_all, text_from_codepoints, text_codepoints}

# Body byte length for a record serial type.
fn sqlite_serial_size(serial: i64) -> Result<i64, SqliteError>:
    if serial < 0:
        return Err(SqliteError.UnknownSerialType(serial: serial))
    if serial <= 4:
        Ok(serial)
    elif serial == 5:
        Ok(6)
    elif serial == 6 or serial == 7:
        Ok(8)
    elif serial == 8 or serial == 9:
        Ok(0)
    elif serial == 10 or serial == 11:
        Err(SqliteError.ReservedSerialType(serial: serial))
    elif serial % 2 == 0:
        Ok((serial - 12) / 2)
    else:
        Ok((serial - 13) / 2)

# Decode n (1..8) big-endian two's-complement bytes at bytes[off..off+n].
fn decode_signed_be(bytes: [u8], off: i64, n: i64) -> i64:
    var v: i64 = 0
    var i: i64 = 0
    while i < n:
        v = (v << 8) | (bytes[off + i] as i64)
        i = i + 1
    if n < 8:
        val sign_bit = 1i64 << (n * 8 - 1)
        if (v & sign_bit) != 0:
            v = v - (1i64 << (n * 8))
    v

# Decode one UTF-16 code unit sequence (LE or BE) into Unicode codepoints.
# Unpaired surrogates become U+FFFD.
fn utf16_codepoints(bytes: [u8], off: i64, len: i64, big_endian: bool) -> [i64]:
    var cps: [i64] = []
    var i: i64 = 0
    while i + 1 < len:
        val u = if big_endian:
            be_u16_at(bytes, off + i)
        else:
            (bytes[off + i] as i64) | ((bytes[off + i + 1] as i64) << 8)
        if u >= 0xD800 and u <= 0xDBFF:
            if i + 3 < len:
                val u2 = if big_endian:
                    be_u16_at(bytes, off + i + 2)
                else:
                    (bytes[off + i + 2] as i64) | ((bytes[off + i + 3] as i64) << 8)
                if u2 >= 0xDC00 and u2 <= 0xDFFF:
                    cps.push(0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00))
                    i = i + 4
                    continue
            cps.push(0xFFFD)
            i = i + 2
        elif u >= 0xDC00 and u <= 0xDFFF:
            cps.push(0xFFFD)
            i = i + 2
        else:
            cps.push(u)
            i = i + 2
    if i < len:
        # Odd trailing byte: replacement char.
        cps.push(0xFFFD)
    cps

# Decode a full record (header + body) into typed values.
# `payload` is exactly the record byte sequence; `encoding` is the database
# text encoding (1 UTF-8, 2 UTF-16LE, 3 UTF-16BE).
fn sqlite_record_decode(payload: [u8], encoding: i64) -> Result<[DbValue], SqliteError>:
    if payload.len() == 0:
        return Err(SqliteError.MalformedRecord(message: "empty record payload"))

    val hdr = sqlite_varint_decode(payload, 0)?
    val header_len = hdr.0 as i64
    val hdr_varint_len = hdr.1
    if header_len < hdr_varint_len or header_len > payload.len():
        return Err(SqliteError.MalformedRecord( message: "record header length {header_len} outside payload of {payload.len()} bytes"))

    var serials: [i64] = []
    var pos = hdr_varint_len
    while pos < header_len:
        val s = sqlite_varint_decode(payload, pos)?
        serials.push(s.0 as i64)
        pos = pos + s.1
    if pos != header_len:
        return Err(SqliteError.MalformedRecord(message: "record header varints overrun header length"))

    var values: [DbValue] = []
    var body = header_len
    for serial in serials:
        val size = sqlite_serial_size(serial)?
        if body + size > payload.len():
            return Err(SqliteError.MalformedRecord( message: "serial type {serial} needs {size} body bytes, only {payload.len() - body} left"))
        if serial == 0:
            values.push(DbValue.Null)
        elif serial <= 6:
            values.push(DbValue.Integer(value: decode_signed_be(payload, body, size)))
        elif serial == 7:
            var bits: u64 = 0u64
            var k: i64 = 0
            while k < 8:
                bits = (bits << 8) | (payload[body + k] as u64)
                k = k + 1
            values.push(DbValue.Real(value: f64_from_bits(bits)))
        elif serial == 8:
            values.push(DbValue.Integer(value: 0))
        elif serial == 9:
            values.push(DbValue.Integer(value: 1))
        elif serial % 2 == 0:
            var blob: [u8] = []
            var k: i64 = 0
            while k < size:
                blob.push(payload[body + k])
                k = k + 1
            values.push(DbValue.Blob(value: blob))
        else:
            if encoding == SQLITE_ENCODING_UTF8:
                var raw: [i64] = []
                var k: i64 = 0
                while k < size:
                    raw.push(payload[body + k] as i64)
                    k = k + 1
                var cps: [i64] = []
                var p: i64 = 0
                while p < raw.len():
                    val dec = utf8_decode_one(raw, p)
                    cps.push(dec[0])
                    p = p + dec[1]
                values.push(DbValue.Text(value: text_from_codepoints(cps)))
            else:
                val big_endian = encoding == SQLITE_ENCODING_UTF16BE
                values.push(DbValue.Text(value: text_from_codepoints( utf16_codepoints(payload, body, size, big_endian))))
        body = body + size

    if body != payload.len():
        return Err(SqliteError.MalformedRecord( message: "record body ends at {body}, payload has {payload.len()} bytes"))
    Ok(values)

# Encode text as UTF-8 bytes.
fn text_utf8_bytes(t: text) -> [u8]:
    val cps = text_codepoints(t)
    val enc = utf8_encode_all(cps)
    var out: [u8] = []
    for b in enc:
        out.push(b as u8)
    out

# Smallest two's-complement byte width (1,2,3,4,6,8) holding v, or 0 for the
# serial-8/9 specials handled by the caller.
fn int_width(v: i64) -> i64:
    if v >= -128 and v <= 127:
        return 1
    if v >= -32768 and v <= 32767:
        return 2
    if v >= -8388608 and v <= 8388607:
        return 3
    if v >= -2147483648 and v <= 2147483647:
        return 4
    if v >= -140737488355328 and v <= 140737488355327:
        return 5
    6

# Encode typed values as one SQLite record (header + body).
# Canonical SQLite serial choice: 0 and 1 use serials 8 and 9 (zero body bytes).
fn _empty_body() -> [u8]:
    var e: [u8] = []
    e

fn sqlite_record_encode(values: [DbValue]) -> [u8]:
    var serials: [i64] = []
    var bodies: [[u8]] = []
    for value in values:
        match value:
            DbValue.Null:
                serials.push(0)
                bodies.push(_empty_body())
            DbValue.Integer(v):
                if v == 0:
                    serials.push(8)
                    bodies.push(_empty_body())
                elif v == 1:
                    serials.push(9)
                    bodies.push(_empty_body())
                else:
                    val w = int_width(v)
                    serials.push(w)
                    # Serial 5 is 6 bytes and serial 6 is 8 bytes; w is the
                    # serial code, so convert to the byte width explicitly.
                    val n = if w == 5: 6 else: (if w == 6: 8 else: w)
                    var body: [u8] = []
                    var k: i64 = 0
                    while k < n:
                        body.push((((v >> ((n - 1 - k) * 8)) & 0xFF) as u8))
                        k = k + 1
                    bodies.push(body)
            DbValue.Real(v):
                serials.push(7)
                val bits = f64_to_bits(v)
                var body: [u8] = []
                var k: i64 = 0
                while k < 8:
                    body.push((((bits >> ((7 - k) * 8) as u64) & 0xFFu64) as u8))
                    k = k + 1
                bodies.push(body)
            DbValue.Text(t):
                val raw = text_utf8_bytes(t)
                serials.push(13 + 2 * raw.len())
                bodies.push(raw)
            DbValue.Blob(b):
                # Re-home foreign byte arrays into a push-built buffer: the
                # seed's rt_array_bytes_* externs (dynamic-SFFI array contract)
                # reject spec-side array literals crossing module boundaries.
                var fresh: [u8] = []
                for byte in b:
                    fresh.push(byte)
                serials.push(12 + 2 * fresh.len())
                bodies.push(fresh)
            DbValue.Bool(b):
                if b:
                    serials.push(9)
                else:
                    serials.push(8)
                bodies.push(_empty_body())

    var hdr_len: i64 = 1
    while true:
        var sum = sqlite_varint_len(hdr_len as u64)
        for s in serials:
            sum = sum + sqlite_varint_len(s as u64)
        if sum == hdr_len:
            break
        hdr_len = sum

    var out: [u8] = []
    for b in sqlite_varint_encode(hdr_len as u64):
        out.push(b)
    for s in serials:
        for b in sqlite_varint_encode(s as u64):
            out.push(b)
    for body in bodies:
        for b in body:
            out.push(b)
    out

