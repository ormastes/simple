# Pure-Simple SQLite on-disk format reader/writer (no C wrapper, no VFS).
#
# DB-A read gate: sqlite_format_probe / sqlite_format_read_table / verify.
# DB-B write gate: sqlite_format_create_image (whole-image, deterministic).
#
# Plan: doc reference "simple_devhub_sqlite_sqlcipher_messenger_master_plan"
# sections 3.1-3.3 and 5.1-5.2. Staged later gates (WAL overlay, freelist,
# index b-trees, balancing, SQLCipher codec) are NOT implied by this package.

export use std.nogc_sync_mut.database.sqlite_format.types.{SqliteError, SqliteFileInfo}
export use std.nogc_sync_mut.database.sqlite_format.reader.{sqlite_format_probe, sqlite_format_read_table, sqlite_format_read_table_bytes}
export use std.nogc_sync_mut.database.sqlite_format.verify.{sqlite_verify_bytes}
export use std.nogc_sync_mut.database.sqlite_format.wimage.{
    sqlite_format_create_image, SqliteTableData
}
export use std.nogc_sync_mut.database.sqlite_format.varint.{
    sqlite_varint_decode, sqlite_varint_encode, sqlite_varint_len
}
export use std.nogc_sync_mut.database.sqlite_format.record.{
    sqlite_record_decode, sqlite_record_encode, sqlite_serial_size
}
export use std.nogc_sync_mut.database.sqlite_format.schema.{
    SqliteSchemaEntry, SqliteTableDef, sqlite_schema_scan, find_table_schema,
    parse_create_table_columns
}
export use std.nogc_sync_mut.database.sqlite_format.header.{sqlite_header_parse}
export use std.nogc_sync_mut.database.sqlite_format.pager.{SqlitePager, PAGER_CACHE_CAP}

