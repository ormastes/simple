# Evidence-first query debugging for the canonical pure-Simple embedded SQL
# engine.  This adapter retains no bind values and introduces no SQLite SFFI.

use std.common.crypto.sha256.{sha256_text}
use std.common.debug.contracts_v1.{
    QueryDebugV1, DebugSessionId, DebugRootOperationV1, DebugPerturbationV1,
}
use std.common.debug.service_v1.{DebugServiceV1}
use std.nogc_sync_mut.io.time_ops.{time_now_nanos}
use std.database.sql.types.{DbValue, DbRow, DbError}
use nogc_sync_mut.database.pure_sql._PureDatabase.pure_database.{PureDatabase}
use nogc_sync_mut.db.dbfs_engine.sql_parser.{sql_parse, SqlStmtKind}

pub struct PureQueryDebugContextV1:
    database: text
    schema: text
    connection_id: text
    transaction_id: text
    savepoint_id: text
    source_anchor: text
    trace_id: text
    task_id: text
    actor_id: text

pub struct PureQueryDebugResultV1:
    debug: QueryDebugV1
    rows: [DbRow]
    session_id: DebugSessionId
    build_id: text

pub fn pure_query_debug_context_v1(database: text, connection_id: text) -> PureQueryDebugContextV1:
    PureQueryDebugContextV1(
        database: database, schema: "main", connection_id: connection_id,
        transaction_id: "", savepoint_id: "", source_anchor: "",
        trace_id: "", task_id: "", actor_id: "",
    )

fn _ascii_digit_v1(ch: text) -> bool:
    ch >= "0" and ch <= "9"

# Replace quoted and numeric literals without retaining their values. SQL
# punctuation and parameter placeholders remain visible for causality.
pub fn sanitize_pure_sql_template_v1(sql: text) -> text:
    var out = ""
    var in_quote = false
    var emitted_quote_marker = false
    var in_number = false
    for ch in sql.chars():
        if in_quote:
            if ch == "'":
                in_quote = false
                emitted_quote_marker = false
            elif not emitted_quote_marker:
                out = out + "?"
                emitted_quote_marker = true
            continue
        if ch == "'":
            in_quote = true
            emitted_quote_marker = false
            continue
        if _ascii_digit_v1(ch):
            if not in_number:
                out = out + "?"
                in_number = true
            continue
        in_number = false
        out = out + ch
    out.trim()

pub fn pure_sql_bind_shape_v1(params: [DbValue]) -> text:
    var kinds: [text] = []
    for value in params:
        val kind = match value:
            DbValue.Integer(_): "integer"
            DbValue.Real(_): "real"
            DbValue.Text(_): "text"
            DbValue.Blob(_): "blob"
            DbValue.Null: "null"
            DbValue.Bool(_): "bool"
        kinds.push(kind)
    kinds.join(",")

fn _pure_sql_plan_v1(sql: text) -> text:
    match sql_parse(sql):
        case Err(_): "unavailable:parse-error"
        case Ok(stmt):
            if stmt.kind == SqlStmtKind.Select:
                "pure-sql:table-scan:" + stmt.select.from_table
            else:
                "pure-sql:non-select"

pub fn pure_query_debug_observe_v1(db: PureDatabase, sql: text, params: [DbValue], context: PureQueryDebugContextV1) -> Result<PureQueryDebugResultV1, DbError>:
    val sanitized = sanitize_pure_sql_template_v1(sql)
    val bind_shape = pure_sql_bind_shape_v1(params)
    val plan = _pure_sql_plan_v1(sql)
    val start_ns = time_now_nanos()
    val rows = match db.query(sql, params):
        case Err(reason): return Err(reason)
        case Ok(value): value
    val engine_evidence = db.query_debug_evidence_v1()
    val end_ns = time_now_nanos()
    val elapsed = if end_ns >= start_ns: end_ns - start_ns else: -1
    Ok(PureQueryDebugResultV1(
        debug: QueryDebugV1(
            engine: "simple-pure-sql", dialect: "sqlite-compatible",
            database: context.database, schema: context.schema,
            connection_id: context.connection_id,
            transaction_id: context.transaction_id,
            savepoint_id: context.savepoint_id,
            source_anchor: context.source_anchor, trace_id: context.trace_id,
            task_id: context.task_id, actor_id: context.actor_id,
            statement_digest: "sha256:" + sha256_text(sanitized),
            sanitized_template: sanitized, bind_shape: bind_shape,
            bind_types: bind_shape, estimated_plan: plan,
            actual_plan: engine_evidence.actual_plan,
            elapsed_ns: elapsed, rows: rows.len(),
            waits: "unavailable:busy-wait-not-instrumented",
            locks: "unavailable:lock-state-not-instrumented",
            cache_stats: if engine_evidence.result_cache_hit: "result_cache=hit" else: "result_cache=miss",
            buffer_stats: if engine_evidence.rows_examined >= 0: "rows_examined=" + engine_evidence.rows_examined.to_text() else: "unavailable:rows-examined-not-instrumented",
            error: "", retries: 0,
            raw_evidence: "pure-sql-query-result;transaction_active=" + engine_evidence.transaction_active.to_text() + ";savepoint=unavailable;checkpoint=" + engine_evidence.checkpoint_state,
        ),
        rows: rows,
        session_id: DebugSessionId(value: ""),
        build_id: "",
    ))

# Execute query inspection only after the named DebugServiceV1 session has
# authorized Inspect/Passive. The build identity is derived from that exact
# session rather than accepted from the caller, and receipts retain no SQL or
# bind values.
pub fn pure_query_debug_service_inspect_v1(service: DebugServiceV1, session_id: DebugSessionId, db: PureDatabase, sql: text, params: [DbValue], context: PureQueryDebugContextV1) -> Result<PureQueryDebugResultV1, DbError>:
    val session = match service.session(session_id):
        case None: return Err(DbError.Other(message: "debug session not found"))
        case Some(value): value
    val authorization = service.authorize(
        session_id, DebugRootOperationV1.Inspect,
        DebugPerturbationV1.Passive, "pure-sql.query.inspect",
    )
    if not authorization.allowed:
        return Err(DbError.Other(message: "pure SQL query inspection denied"))
    match pure_query_debug_observe_v1(db, sql, params, context):
        case Err(reason):
            service.record_outcome_receipt(
                session_id, DebugRootOperationV1.Inspect,
                DebugPerturbationV1.Passive, "pure-sql.query.inspect.outcome",
                false, false, "pure SQL query failed",
            )
            Err(reason)
        case Ok(value):
            service.record_outcome_receipt(
                session_id, DebugRootOperationV1.Inspect,
                DebugPerturbationV1.Passive, "pure-sql.query.inspect.outcome",
                true, false, "",
            )
            var result = value
            result.session_id = session_id
            result.build_id = session.build_id
            Ok(result)

export PureQueryDebugContextV1, PureQueryDebugResultV1
