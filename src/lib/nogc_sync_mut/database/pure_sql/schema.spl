# PureDatabase schema introspection values.
#
# These values preserve only the declarations PureDatabase can authenticate:
# ordered column names/types and at most one declared inline primary key.  They
# are not evidence that value types, nullability, uniqueness, or primary-key
# constraints are enforced on writes.

enum PureColumnTypeV1:
    Integer
    Real
    Text
    Blob
    Boolean

impl PureColumnTypeV1:
    fn canonical_tag() -> text:
        match self:
            PureColumnTypeV1.Integer: "integer"
            PureColumnTypeV1.Real: "real"
            PureColumnTypeV1.Text: "text"
            PureColumnTypeV1.Blob: "blob"
            PureColumnTypeV1.Boolean: "boolean"

struct PureColumnSchemaV1:
    name: text
    declared_type: PureColumnTypeV1

struct PureTableSchemaV1:
    columns: [PureColumnSchemaV1]
    # -1 means that no inline primary key was declared.
    primary_key_index: i32

fn _pure_column_type_v1_from_tag(tag: text) -> PureColumnTypeV1?:
    if tag == "integer":
        return Some(PureColumnTypeV1.Integer)
    if tag == "real":
        return Some(PureColumnTypeV1.Real)
    if tag == "text":
        return Some(PureColumnTypeV1.Text)
    if tag == "blob":
        return Some(PureColumnTypeV1.Blob)
    if tag == "boolean":
        return Some(PureColumnTypeV1.Boolean)
    nil

fn _pure_column_type_v1_from_sql_name(name: text) -> PureColumnTypeV1?:
    val normalized = name.to_lower()
    if normalized == "integer" or normalized == "int" or normalized == "bigint" or normalized == "smallint":
        return Some(PureColumnTypeV1.Integer)
    if normalized == "real" or normalized == "float" or normalized == "double":
        return Some(PureColumnTypeV1.Real)
    if normalized == "text" or normalized == "varchar" or normalized == "char" or normalized == "string":
        return Some(PureColumnTypeV1.Text)
    if normalized == "blob" or normalized == "binary" or normalized == "bytea":
        return Some(PureColumnTypeV1.Blob)
    if normalized == "boolean" or normalized == "bool":
        return Some(PureColumnTypeV1.Boolean)
    nil
