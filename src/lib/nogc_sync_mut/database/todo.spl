# Todo Database - Read/validate wrapper and preserving append for todo_db.sdn
#
# The todo_scan app currently writes directly via file_write(),
# bypassing the shared database library. This module provides
# read-only access and validation for check-dbs/fix-dbs commands.
#
# The scanner write-path migration remains out of scope. The narrow append API
# below serializes new blocked records without regenerating legacy payloads.
#
# Usage:
#   use std.database.todo.{TodoDatabase, load_todo_database}
#   val db = load_todo_database("doc/08_tracking/todo/todo_db.sdn")

use nogc_sync_mut.database.core.{SdnDatabase, SdnTable, SdnRow}
use nogc_sync_mut.database.checker.{DbIssue, check_duplicate_ids, check_valid_column,
    check_required_fields, check_empty_required, check_file_refs, check_enum_values}

# Direct extern declarations for bootstrap runtime compatibility
extern fn rt_file_exists(path: text) -> bool
fn file_exists(path: text) -> bool:
    rt_file_exists(path)

# ============================================================================
# Structs
# ============================================================================

struct TodoEntry:
    id: text
    keyword: text       # TODO, FIXME, HACK, etc.
    file: text
    line: i64
    message: text
    status: text        # "open", "closed", "blocked"
    valid: bool

# ============================================================================
# Helper Functions
# ============================================================================

fn load_todo_database(path: text) -> TodoDatabase?:
    val db = SdnDatabase.load(path)?
    Some(TodoDatabase(db: db))

# ============================================================================
# TodoDatabase
# ============================================================================

class TodoDatabase:
    db: SdnDatabase

    # Get all valid todo entries
    fn all_todos() -> [TodoEntry]:
        val table_opt = self.db.get_table("todos")
        val table = match table_opt:
            Some(value):
                value
            nil:
                return []
        var result: [TodoEntry] = []

        for row in table.valid_rows():
            val id = row.get("id") ?? ""
            val keyword = row.get("keyword") ?? ""
            val file = row.get("file") ?? ""
            val line = row.get_i64("line") ?? 0
            val message = row.get("message") ?? ""
            val status = row.get("status") ?? "open"
            val valid_opt = row.get("valid")
            val valid = match valid_opt:
                Some(value):
                    value == "true"
                nil:
                    true

            result.push(TodoEntry(
                id: id,
                keyword: keyword,
                file: file,
                line: line,
                message: message,
                status: status,
                valid: valid
            ))

        result

    # Validate the todo database
    fn validate() -> [DbIssue]:
        var issues: [DbIssue] = []
        val db_name = "todo"

        val table_opt = self.db.get_table("todos")
        val table = match table_opt:
            Some(value):
                value
            nil:
                issues.push(DbIssue(
                    db_name: db_name,
                    severity: "error",
                    issue_type: "missing_table",
                    message: "Expected 'todos' table not found in todo database",
                    auto_fixable: false
                ))
                return issues

        # Check required columns
        val required = ["id", "keyword", "file", "line", "status", "valid"]
        val col_issues = check_required_fields(table, required, db_name)
        for issue in col_issues:
            issues.push(issue)

        # Check for duplicate IDs
        val dup_issues = check_duplicate_ids(table, "id", db_name)
        for issue in dup_issues:
            issues.push(issue)

        # Check valid column values
        val valid_issues = check_valid_column(table, db_name)
        for issue in valid_issues:
            issues.push(issue)

        # Check required fields are not empty
        val empty_kw = check_empty_required(table, "keyword", db_name)
        for issue in empty_kw:
            issues.push(issue)

        val empty_file = check_empty_required(table, "file", db_name)
        for issue in empty_file:
            issues.push(issue)

        # Check status values
        val valid_statuses = ["open", "closed", "blocked"]
        val status_issues = check_enum_values(table, "status", valid_statuses, db_name)
        for issue in status_issues:
            issues.push(issue)

        # Check referenced files exist
        val file_issues = check_file_refs(table, "file", db_name)
        for issue in file_issues:
            issues.push(issue)

        # Warn about direct file_write bypass
        issues.push(DbIssue(
            db_name: db_name,
            severity: "info",
            issue_type: "bypass_warning",
            message: "TodoDB uses direct file_write() — not managed by shared database library",
            auto_fixable: false
        ))

        issues

# ============================================================================
# Exports
# ============================================================================

use nogc_sync_mut.database.atomic.{FileLock}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.io_runtime.{read_file_text_result}
use std.nogc_sync_mut.compression.gzip.crc.{crc32_text}
use std.convert (try_parse_int)

# Serialize only the new row; never parse and regenerate existing TODO payloads.
fn append_todo_preserving_legacy(path: text, row: SdnRow) -> bool:
    var lock: FileLock = FileLock.for_file(path)
    if not lock.try_acquire(5000): return false
    val published = _todo_append_locked(path, row)
    lock.release()
    published

fn _todo_append_locked(path: text, row: SdnRow) -> bool:
    # A pending WAL is authoritative. Do not bypass or discard its records.
    if file_exists(path + ".wal"):
        val wal: text = match read_file_text_result(path + ".wal"):
            case Ok(value): value
            case Err(_): return false
        if wal.trim() != "": return false
    val original: text = match read_file_text_result(path):
        case Ok(value): value
        case Err(_): return false
    if original.len() > 33554432: return false
    var body: text = original
    if original.starts_with("#sdn-crc32:"):
        val newline = original.index_of("\n")
        if newline < 0: return false
        val expected = try_parse_int(original.substring(11, newline).trim())
        body = original.substring(newline + 1)
        if expected == nil or crc32_text(body) != (expected ?? -1): return false
    val columns: [text] = ["id", "keyword", "area", "priority", "description", "file", "line", "issue", "blocked", "status", "valid"]
    val id: text = row.get("id") ?? ""
    if id == "": return false
    for character in id.chars():
        if not "0123456789".contains(character): return false
    for column in columns:
        val field = row.get(column)
        if field == nil: return false
        val value: text = field ?? ""
        if value != value.trim() or value.contains("\n") or value.contains("\r") or value.contains("\0") or value.contains("\""): return false
    val valid: text = row.get("valid") ?? ""
    val status: text = row.get("status") ?? ""
    if valid != "true" or status != "blocked": return false
    for raw in body.split("\n"):
        val line: text = raw.trim()
        if line.starts_with(id + ",") or line.starts_with("\"" + id + "\","): return false
    var pending: SdnTable = SdnTable.new("todos", columns)
    if not pending.add_row(row): return false
    val encoded: text = pending.to_sdn()
    val separator = encoded.index_of("\n")
    if separator < 0: return false
    val header = encoded.substring(0, separator)
    var rows = encoded.substring(separator + 1)
    val anchored = "\n" + body
    val crlf = "\n" + header + "\r\n"
    val lf = "\n" + header + "\n"
    val crlf_count = anchored.split(crlf).len() - 1
    val lf_count = anchored.split(lf).len() - 1
    if crlf_count + lf_count != 1: return false
    var updated: text = ""
    if crlf_count == 1:
        rows = rows.replace("\n", "\r\n")
        updated = anchored.replace(crlf, crlf + rows).substring(1)
    else:
        updated = anchored.replace(lf, lf + rows).substring(1)
    val checksum = crc32_text(updated)
    file_atomic_write(path, "#sdn-crc32:{checksum}\n" + updated)
