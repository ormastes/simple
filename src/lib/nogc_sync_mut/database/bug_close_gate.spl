# CU-015 backend gate: a bug may be closed only with reproducer-spec and
# prevention (generalization) spec evidence. Pure; callers supply existence.

export bug_close_gate

fn _spec_path_problem(label: text, path: text) -> text:
    if path == "":
        return "missing {label} evidence; pass --{label}=<path>_spec.spl"
    if path.starts_with("/") or path.contains("..") or path.contains("//") or path.contains("\\"):
        return "{label} evidence must be a repository-relative path: {path}"
    if not path.ends_with("_spec.spl"):
        return "{label} evidence must be a _spec.spl file: {path}"
    ""

fn bug_close_gate(reproducer: text, prevention: text, reproducer_exists: bool, prevention_exists: bool) -> text:
    """Return "" when closing is allowed, else the rejection message."""
    var problem = _spec_path_problem("reproducer", reproducer)
    if problem != "": return problem
    problem = _spec_path_problem("prevention", prevention)
    if problem != "": return problem
    if reproducer == prevention:
        return "reproducer and prevention specs must be distinct files: {reproducer}"
    if not reproducer_exists:
        return "reproducer spec not found: {reproducer}"
    if not prevention_exists:
        return "prevention spec not found: {prevention}"
    ""
