# Test Database Extended - Main Module
#
# Extended TestDatabase with complete feature set:
# - 8 tables (strings, files, suites, tests, counters, timing, timing_runs, changes)
# - StringInterner integration
# - Statistical analysis
# - Flaky test detection
# - Run management
#
# This module re-exports all components from submodules.
#
# @workaround bug=test_extended_file_facade_shadows_package_init_2026-11-19
# `std.database.test_extended` resolves to a `test_extended.spl` file facade
# (the nogc_async_mut copy wins the std tier order), never to the package
# test_extended/__init__.spl. Both file copies stay identical; keep
# the type list here in lockstep with test_extended/__init__.spl.

# Import and re-export type definitions
use std.database.test_extended.types.{
    FileRecord, SuiteRecord, TestRecord, CounterRecord,
    TimingSummary, TimingRun, ChangeEvent, RunRecord, TestInfo,
    TestRunCount, TestRunAgeHours, TestRunKeepCount, TestRowId, TestStageMs, TestDurationMs,
    TestByteCount, TestProcessCount, TestSignalNumber, TestExitCode,
    TestAnomalyWarning, TestTimingOutcome, TestStatusCounts, TestTimingStats, TestCaseCounts
}

# Import and re-export main database class
use std.database.test_extended.database.{TestDatabaseExtended}

# Import and re-export factory functions
use std.database.test_extended.factory.{
    create_test_database_extended, load_test_database_extended,
    migrate_from_dual_file, load_with_migration
}

# Import extension methods (these extend TestDatabaseExtended via impl blocks)
use std.database.test_extended.core_helpers
use std.database.test_extended.tracking
use std.database.test_extended.runs
use std.database.test_extended.queries

# Re-export all public types
export use std.database.test_extended.types.{
    FileRecord, SuiteRecord, TestRecord, CounterRecord,
    TimingSummary, TimingRun, ChangeEvent, RunRecord, TestInfo,
    TestRunCount, TestRunAgeHours, TestRunKeepCount, TestRowId, TestStageMs, TestDurationMs,
    TestByteCount, TestProcessCount, TestSignalNumber, TestExitCode,
    TestAnomalyWarning, TestTimingOutcome, TestStatusCounts, TestTimingStats, TestCaseCounts
}

# Re-export main class
export use std.database.test_extended.database.{TestDatabaseExtended}

# Re-export factory functions
export use std.database.test_extended.factory.{
    create_test_database_extended, load_test_database_extended,
    migrate_from_dual_file, load_with_migration
}
