# Test Database Extended - Type Definitions
#
# All struct definitions for TestDatabaseExtended

struct FileRecord:
    file_id: i64
    path_str: i32  # String ID

struct SuiteRecord:
    suite_id: i64
    file_id: i64
    name_str: i32  # String ID

struct TestRecord:
    test_id: i64
    suite_id: i64
    name_str: i32      # String ID
    category_str: i32   # String ID
    status_str: i32     # String ID
    tags_str: i32       # String ID
    description_str: i32  # String ID
    valid: bool

struct CounterRecord:
    test_id: i64
    total_runs: i64
    passed: i64
    failed: i64
    crashed: i64
    timed_out: i64
    flaky_count: i64
    consecutive_passes: i64

struct TimingSummary:
    test_id: i64
    mean: f64
    p50: f64
    p90: f64
    p95: f64
    p99: f64
    iqr: f64
    has_baseline: bool
    baseline_p50: f64
    baseline_updated_at: text
    baseline_state: text
    baseline_generation: i64
    baseline_samples: text
    baseline_cohort_id: text
    provisional_p50: f64
    last_10_runs: text  # JSON array of recent timings

struct TimingRun:
    timing_run_id: i64
    test_id: i64
    duration_ms: f64
    run_id: text
    timestamp: text

struct ChangeEvent:
    change_id: i64
    test_id: i64
    timestamp: text
    event_type: text  # "status_change", "became_flaky", "baseline_update"
    from_status: text
    to_status: text
    description: text

struct RunRecord:
    run_id: text
    start_time: text
    end_time: text
    pid: i64
    hostname: text
    status: text
    test_count: i64
    passed: i64
    failed: i64
    crashed: i64
    timed_out: i64

struct TestInfo:
    test_name: text
    file_path: text
    suite_name: text
    category: text
    status: text
    valid: bool
    mean_duration: f64
    p50_duration: f64
    total_runs: i64
    passed: i64
    failed: i64
    is_flaky: bool

# ============================================================================
# Domain scalars for the test-DB API (replace bare i64/bool at the boundary).
# Wire format is unchanged: every `.value` is serialized exactly as the bare
# integer was.
# ============================================================================

# A count of tests or runs (test_count, passed, failed, timed_out, totals).
struct TestRunCount:
    value: i64

# Retention age for stale-run cleanup, in hours.
struct TestRunAgeHours:
    value: i64

# Number of most-recent runs that prune_runs keeps.
struct TestRunKeepCount:
    value: i64

# Row identifier of a file, suite or test row.
struct TestRowId:
    value: i64

# Whole-millisecond stage duration (compile, execute, wall, CPU).
struct TestStageMs:
    value: i64

# Fractional-millisecond duration of one timing observation.
struct TestDurationMs:
    value: f64

# Byte count of memory or I/O (peak charge, RSS, read, write).
struct TestByteCount:
    value: i64

# Peak number of processes observed in a run's tree.
struct TestProcessCount:
    value: i64

# Terminating signal number (0 = none) and process exit code.
struct TestSignalNumber:
    value: i64

struct TestExitCode:
    value: i64

# Whether a stored resource row already carries an anomaly warning.
enum TestAnomalyWarning:
    Warned
    Quiet

# Outcome of a timing write that can be refused (unknown test, no baseline).
enum TestTimingOutcome:
    Applied
    Refused

# Per-status test totals.
struct TestStatusCounts:
    total: TestRunCount
    passed: TestRunCount
    failed: TestRunCount
    skipped: TestRunCount

# Mean and median duration of one test.
struct TestTimingStats:
    mean: TestDurationMs
    p50: TestDurationMs

# Run totals of one test.
struct TestCaseCounts:
    total_runs: TestRunCount
    passed: TestRunCount
    failed: TestRunCount

# Monotonic baseline generation counter of one test (1 = first promotion).
struct TestBaselineGeneration:
    value: i64

# Epoch-style timestamp (as returned by timestamp_now) of a baseline promotion.
struct TestTimestamp:
    value: i64

# Whether a timing observation may feed the approved-baseline sample window.
enum TestBaselineEligibility:
    Eligible
    Ineligible

# Verdict of the recent-timing flakiness heuristic.
enum TestFlakiness:
    Flaky
    Stable

# Whether a database save reached durable storage.
enum TestDbSaveOutcome:
    Saved
    Failed
