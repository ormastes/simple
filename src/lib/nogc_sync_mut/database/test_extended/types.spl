# Test Database Extended - Type Definitions
#
# All struct definitions for TestDatabaseExtended

struct FileRecord:
    file_id: TestRowId
    path_str: TestStringId

struct SuiteRecord:
    suite_id: TestRowId
    file_id: TestRowId
    name_str: TestStringId

struct TestRecord:
    test_id: TestRowId
    suite_id: TestRowId
    name_str: TestStringId
    category_str: TestStringId
    status_str: TestStringId
    tags_str: TestStringId
    description_str: TestStringId
    valid: TestRecordValidity

struct CounterRecord:
    test_id: TestRowId
    total_runs: TestRunCount
    passed: TestRunCount
    failed: TestRunCount
    crashed: TestRunCount
    timed_out: TestRunCount
    flaky_count: TestRunCount
    consecutive_passes: TestRunCount

struct TimingSummary:
    test_id: TestRowId
    mean: TestDurationMs
    p50: TestDurationMs
    p90: TestDurationMs
    p95: TestDurationMs
    p99: TestDurationMs
    iqr: TestDurationMs
    has_baseline: TestBaselinePresence
    baseline_p50: TestDurationMs
    baseline_updated_at: text
    baseline_state: text
    baseline_generation: TestBaselineGeneration
    baseline_samples: text
    baseline_cohort_id: text
    provisional_p50: TestDurationMs
    last_10_runs: text  # JSON array of recent timings

struct TimingRun:
    timing_run_id: TestTimingRunId
    test_id: TestRowId
    duration_ms: TestDurationMs
    run_id: text
    timestamp: text

struct ChangeEvent:
    change_id: TestChangeEventId
    test_id: TestRowId
    timestamp: text
    event_type: text  # "status_change", "became_flaky", "baseline_update"
    from_status: text
    to_status: text
    description: text

struct RunRecord:
    run_id: text
    start_time: text
    end_time: text
    pid: TestProcessId
    hostname: text
    status: text
    test_count: TestRunCount
    passed: TestRunCount
    failed: TestRunCount
    crashed: TestRunCount
    timed_out: TestRunCount

struct TestInfo:
    test_name: text
    file_path: text
    suite_name: text
    category: text
    status: text
    valid: TestRecordValidity
    mean_duration: TestDurationMs
    p50_duration: TestDurationMs
    total_runs: TestRunCount
    passed: TestRunCount
    failed: TestRunCount
    is_flaky: TestFlakiness

# ============================================================================
# Domain scalars for the test-DB API (replace bare i64/bool at the boundary).
# Wire format is unchanged: every `.value` is serialized exactly as the bare
# integer was.
# ============================================================================

# A count of tests or runs (test_count, passed, failed, timed_out, totals).
struct TestRunCount:
    value: i64

# Retention age for stale-run cleanup, in hours.
struct TestRunAgeHours:
    value: i64

# Number of most-recent runs that prune_runs keeps.
struct TestRunKeepCount:
    value: i64

# Row identifier of a file, suite or test row.
struct TestRowId:
    value: i64

# Whole-millisecond stage duration (compile, execute, wall, CPU).
struct TestStageMs:
    value: i64

# Fractional-millisecond duration of one timing observation.
struct TestDurationMs:
    value: f64

# Byte count of memory or I/O (peak charge, RSS, read, write).
struct TestByteCount:
    value: i64

# Peak number of processes observed in a run's tree.
struct TestProcessCount:
    value: i64

# Terminating signal number (0 = none) and process exit code.
struct TestSignalNumber:
    value: i64

struct TestExitCode:
    value: i64

# Whether a stored resource row already carries an anomaly warning.
enum TestAnomalyWarning:
    Warned
    Quiet

# Outcome of a timing write that can be refused (unknown test, no baseline).
enum TestTimingOutcome:
    Applied
    Refused

# Per-status test totals.
struct TestStatusCounts:
    total: TestRunCount
    passed: TestRunCount
    failed: TestRunCount
    skipped: TestRunCount

# Mean and median duration of one test.
struct TestTimingStats:
    mean: TestDurationMs
    p50: TestDurationMs

# Run totals of one test.
struct TestCaseCounts:
    total_runs: TestRunCount
    passed: TestRunCount
    failed: TestRunCount

# Monotonic baseline generation counter of one test (1 = first promotion).
struct TestBaselineGeneration:
    value: i64

# Epoch-style timestamp (as returned by timestamp_now) of a baseline promotion.
struct TestTimestamp:
    value: i64

# Whether a timing observation may feed the approved-baseline sample window.
enum TestBaselineEligibility:
    Eligible
    Ineligible

# Verdict of the recent-timing flakiness heuristic.
enum TestFlakiness:
    Flaky
    Stable

# Whether a database save reached durable storage.
enum TestDbSaveOutcome:
    Saved
    Failed

# Interned string identifier from StringInterner.
struct TestStringId:
    value: i32

# OS process identifier recorded for a test run.
struct TestProcessId:
    value: i64

# Row identifier of a timing_runs entry.
struct TestTimingRunId:
    value: i64

# Row identifier of a changes entry.
struct TestChangeEventId:
    value: i64

# Whether a test or test-info row is marked valid.
enum TestRecordValidity:
    Valid
    Invalid

# Whether a timing summary has a promoted baseline.
enum TestBaselinePresence:
    Present
    Absent
