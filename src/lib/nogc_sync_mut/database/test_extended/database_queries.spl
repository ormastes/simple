# Test Database Extended — Standalone query helpers (module-level, no class state).
#
# These functions operate on SdnTable/SdnRow directly and are called by
# TestDatabaseExtended methods. Extracted here to reduce database.spl line count
# while respecting the bootstrap constraint (no cross-file impl blocks).

use std.database.core.{SdnDatabase, SdnTable, SdnRow, StringInterner}
use std.database.test_extended.types.{
    FileRecord, SuiteRecord, TestRecord, CounterRecord,
    TimingSummary, TimingRun, ChangeEvent, RunRecord, TestInfo
}

# Get file path by ID (module-level; takes db and interner as parameters).
fn db_get_file_path(db: SdnDatabase, interner: StringInterner, file_id: i64) -> text?:
    val files_table = match db.get_table("files"):
        case Some(table): table
        case nil: return nil
    for row in files_table.valid_rows():
        val row_file_id = row.get_i64("file_id") ?? -1
        if row_file_id == file_id:
            val path_str = row.get_i32("path_str") ?? -1
            if path_str != -1:
                return interner.get(path_str)
    nil

# Get suite info (file_path, suite_name) by suite ID.
fn db_get_suite_info(db: SdnDatabase, interner: StringInterner, suite_id: i64) -> (text, text)?:
    val suites_table = match db.get_table("suites"):
        case Some(table): table
        case nil: return nil
    for row in suites_table.valid_rows():
        val row_suite_id = row.get_i64("suite_id") ?? -1
        if row_suite_id == suite_id:
            val file_id = row.get_i64("file_id") ?? -1
            val name_str = row.get_i32("name_str") ?? -1
            if file_id == -1 or name_str == -1:
                continue
            val file_path = db_get_file_path(db, interner, file_id) ?? ""
            val suite_name = interner.get(name_str) ?? ""
            return Some((file_path, suite_name))
    nil

# Get test timing (mean, p50) by test ID.
fn db_get_test_timing(db: SdnDatabase, test_id: i64) -> (f64, f64)?:
    val timing_table = match db.get_table("timing"):
        case Some(table): table
        case nil: return nil
    for row in timing_table.valid_rows():
        val row_test_id = row.get_i64("test_id") ?? -1
        if row_test_id == test_id:
            val mean = row.get_f64("mean") ?? 0.0
            val p50 = row.get_f64("p50") ?? 0.0
            return Some((mean, p50))
    nil

# Get test counts (total_runs, passed, failed) by test ID.
fn db_get_test_counts(db: SdnDatabase, test_id: i64) -> (i64, i64, i64)?:
    val counters_table = match db.get_table("counters"):
        case Some(table): table
        case nil: return nil
    for row in counters_table.valid_rows():
        val row_test_id = row.get_i64("test_id") ?? -1
        if row_test_id == test_id:
            val total_runs = row.get_i64("total_runs") ?? 0
            val passed = row.get_i64("passed") ?? 0
            val failed = row.get_i64("failed") ?? 0
            return Some((total_runs, passed, failed))
    nil

# One-pass lookup tables for `all_test_info`.
#
# all_test_info used to call db_get_suite_info / db_get_test_timing /
# db_get_test_counts once per test, and each of those scans a whole table, so
# the report cost O(tests x rows). Interpreted (as `simple test <dir>` runs
# it) one all_test_info took ~100 s on the repo DB, and generate_test_result_md
# calls it nine times: the directory runner sat >14 min after printing its
# results. These tables hold exactly what the linear helpers return: the FIRST
# matching row wins, and a suite row with an invalid file_id/name_str is
# skipped just as db_get_suite_info's `continue` skips it.
struct TestInfoLookup:
    suite_file: Dict<i64, text>
    suite_name: Dict<i64, text>
    timing_mean: Dict<i64, f64>
    timing_p50: Dict<i64, f64>
    count_total: Dict<i64, i64>
    count_passed: Dict<i64, i64>
    count_failed: Dict<i64, i64>

fn db_test_info_lookup(db: SdnDatabase, interner: StringInterner) -> TestInfoLookup:
    var file_path: Dict<i64, text> = {}
    match db.get_table("files"):
        case Some(table):
            for row in table.valid_rows():
                val file_id = row.get_i64("file_id") ?? -1
                if file_path.has(file_id):
                    continue
                val path_str = row.get_i32("path_str") ?? -1
                if path_str != -1:
                    file_path[file_id] = interner.get(path_str) ?? ""
        case nil: pass
    var suite_file: Dict<i64, text> = {}
    var suite_name: Dict<i64, text> = {}
    match db.get_table("suites"):
        case Some(table):
            for row in table.valid_rows():
                val suite_id = row.get_i64("suite_id") ?? -1
                if suite_file.has(suite_id):
                    continue
                val file_id = row.get_i64("file_id") ?? -1
                val name_str = row.get_i32("name_str") ?? -1
                if file_id == -1 or name_str == -1:
                    continue
                suite_file[suite_id] = if file_path.has(file_id): file_path[file_id] else: ""
                suite_name[suite_id] = interner.get(name_str) ?? ""
        case nil: pass
    var timing_mean: Dict<i64, f64> = {}
    var timing_p50: Dict<i64, f64> = {}
    match db.get_table("timing"):
        case Some(table):
            for row in table.valid_rows():
                val test_id = row.get_i64("test_id") ?? -1
                if timing_mean.has(test_id):
                    continue
                timing_mean[test_id] = row.get_f64("mean") ?? 0.0
                timing_p50[test_id] = row.get_f64("p50") ?? 0.0
        case nil: pass
    var count_total: Dict<i64, i64> = {}
    var count_passed: Dict<i64, i64> = {}
    var count_failed: Dict<i64, i64> = {}
    match db.get_table("counters"):
        case Some(table):
            for row in table.valid_rows():
                val test_id = row.get_i64("test_id") ?? -1
                if count_total.has(test_id):
                    continue
                count_total[test_id] = row.get_i64("total_runs") ?? 0
                count_passed[test_id] = row.get_i64("passed") ?? 0
                count_failed[test_id] = row.get_i64("failed") ?? 0
        case nil: pass
    TestInfoLookup(
        suite_file: suite_file, suite_name: suite_name,
        timing_mean: timing_mean, timing_p50: timing_p50,
        count_total: count_total, count_passed: count_passed, count_failed: count_failed
    )

# Build a RunRecord from a database row. Returns nil if required fields missing.
fn run_record_from_row(row: SdnRow) -> RunRecord?:
    val run_id = row.get("run_id") ?? ""
    if run_id == "":
        return nil
    val start_time = row.get("start_time") ?? ""
    val end_time = row.get("end_time") ?? ""
    val pid = row.get_i64("pid") ?? 0
    val h = row.get("hostname") ?? ""
    val status = row.get("status") ?? ""
    val test_count = row.get_i64("test_count") ?? 0
    val passed = row.get_i64("passed") ?? 0
    val failed = row.get_i64("failed") ?? 0
    val crashed = row.get_i64("crashed") ?? 0
    val timed_out = row.get_i64("timed_out") ?? 0
    Some(RunRecord(
        run_id: run_id,
        start_time: start_time,
        end_time: end_time,
        pid: pid,
        hostname: h,
        status: status,
        test_count: test_count,
        passed: passed,
        failed: failed,
        crashed: crashed,
        timed_out: timed_out
    ))

# Build a CounterRecord from a database row. Returns nil if test_id missing.
fn counter_record_from_row(row: SdnRow, test_id: i64) -> CounterRecord?:
    val total_runs = row.get_i64("total_runs") ?? 0
    val passed = row.get_i64("passed") ?? 0
    val failed = row.get_i64("failed") ?? 0
    val crashed = row.get_i64("crashed") ?? 0
    val timed_out = row.get_i64("timed_out") ?? 0
    val flaky_count = row.get_i64("flaky_count") ?? 0
    val consecutive_passes = row.get_i64("consecutive_passes") ?? 0
    Some(CounterRecord(
        test_id: test_id,
        total_runs: total_runs,
        passed: passed,
        failed: failed,
        crashed: crashed,
        timed_out: timed_out,
        flaky_count: flaky_count,
        consecutive_passes: consecutive_passes
    ))

# Build a TimingSummary from a database row. Returns nil if test_id missing.
fn timing_summary_from_row(row: SdnRow, test_id: i64) -> TimingSummary?:
    val mean = row.get_f64("mean") ?? 0.0
    val p50 = row.get_f64("p50") ?? 0.0
    val p90 = row.get_f64("p90") ?? 0.0
    val p95 = row.get_f64("p95") ?? 0.0
    val p99 = row.get_f64("p99") ?? 0.0
    val iqr = row.get_f64("iqr") ?? 0.0
    val baseline_p50 = row.get_f64("baseline_p50") ?? 0.0
    val has_baseline_str = row.get("has_baseline") ?? "false"
    val baseline_updated_at = row.get("baseline_updated_at") ?? ""
    val baseline_state = row.get("baseline_state") ?? (if has_baseline_str == "true": "approved" else: "provisional")
    val baseline_generation = row.get_i64("baseline_generation") ?? (if has_baseline_str == "true": 1 else: 0)
    val baseline_samples = row.get("baseline_samples") ?? ""
    val baseline_cohort_id = row.get("baseline_cohort_id") ?? ""
    val provisional_p50 = row.get_f64("provisional_p50") ?? p50
    val last_10_runs = row.get("last_10_runs") ?? ""
    Some(TimingSummary(
        test_id: test_id,
        mean: mean,
        p50: p50,
        p90: p90,
        p95: p95,
        p99: p99,
        iqr: iqr,
        has_baseline: has_baseline_str == "true",
        baseline_p50: baseline_p50,
        baseline_updated_at: baseline_updated_at,
        baseline_state: baseline_state,
        baseline_generation: baseline_generation,
        baseline_samples: baseline_samples,
        baseline_cohort_id: baseline_cohort_id,
        provisional_p50: provisional_p50,
        last_10_runs: last_10_runs
    ))
