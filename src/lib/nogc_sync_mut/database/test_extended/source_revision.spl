# Source revision a test run executed against.
#
# Bug-closure evidence (plan 4.2/4.3) needs to know which source a run proved:
# a pre-fix failure and a post-fix pass only mean something when each run is
# tied to the commit it executed. A revision is recorded only when it is
# trustworthy -- git answered, the id is a well-formed object id, and the
# tracked tree had no local modifications. Anything else records no revision,
# so a run can never claim a source it did not actually run.

use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

# Git commit object id (40 hex for SHA-1, 64 hex for SHA-256 repositories).
struct TestSourceRevision:
    value: text

val _GIT_TIMEOUT_MS: i64 = 10000
val _GIT_MAX_OUTPUT_BYTES: i64 = 65536

fn _is_object_id(candidate: text) -> bool:
    if candidate.len() != 40 and candidate.len() != 64:
        return false
    var i = 0
    while i < candidate.len():
        if not "0123456789abcdef".contains(candidate.slice(i, i + 1)):
            return false
        i = i + 1
    true

# Pure decision over git's answers. `head` is the output of `git rev-parse
# HEAD`, `tracked_changes` the output of `git status --porcelain
# --untracked-files=no`; None means that command failed.
fn test_source_revision_of(head: text?, tracked_changes: text?) -> TestSourceRevision?:
    val changes = match tracked_changes:
        case Some(value): value
        case None: return None
    if changes.trim() != "":
        return None
    val raw = match head:
        case Some(value): value.trim()
        case None: return None
    if not _is_object_id(raw):
        return None
    Some(TestSourceRevision(value: raw))

fn _git_answer(args: [text]) -> text?:
    val (out, _err, code) = process_run_bounded("git", args, _GIT_TIMEOUT_MS, _GIT_MAX_OUTPUT_BYTES)
    if code != 0:
        return None
    Some(out)

# Revision of the current working directory's repository, or None when it
# cannot be trusted (not a repository, git unavailable, or tracked edits).
fn current_test_source_revision() -> TestSourceRevision?:
    test_source_revision_of(
        _git_answer(["rev-parse", "HEAD"]),
        _git_answer(["status", "--porcelain", "--untracked-files=no"]))
