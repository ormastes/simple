# Test Database Extended - Runtime Stubs
#
# Runtime identity helpers. These must never fabricate timestamps, process IDs,
# or host names because those values enter persisted test evidence.

use std.io_runtime.{time_now_unix_micros, getpid}
use std.nogc_sync_mut.io.sysinfo_ops.{hostname}

fn timestamp_now() -> i64:
    time_now_unix_micros()

fn process_id() -> i64:
    getpid()

fn host_name() -> text:
    hostname()
