"""Shared bounded resource limits for Linux pgwire frontends."""

use std.database.postgres_mimic.wire_encode.{PGWIRE_DEFAULT_MAX_RESPONSE}

struct PgWireLinuxLimits:
    max_sessions: i64
    read_chunk: i64
    max_frame: i64
    max_parameters: i64
    max_buffer: i64
    max_response: i64
    read_timeout_ms: i64
    write_timeout_ms: i64

fn pgwire_linux_limits() -> PgWireLinuxLimits:
    PgWireLinuxLimits(max_sessions: 128, read_chunk: 16384,
        max_frame: 1024 * 1024, max_parameters: 64,
        max_buffer: 2 * 1024 * 1024,
        max_response: PGWIRE_DEFAULT_MAX_RESPONSE,
        read_timeout_ms: 15000, write_timeout_ms: 15000)

fn pgwire_limits_valid(limits: PgWireLinuxLimits) -> bool:
    limits.max_sessions > 0 and limits.read_chunk > 0 and
        limits.max_frame >= 8 and limits.max_parameters > 0 and
        limits.max_buffer >= limits.max_frame and
        limits.max_response >= 64 and limits.read_timeout_ms > 0 and
        limits.write_timeout_ms > 0

export PgWireLinuxLimits, pgwire_linux_limits, pgwire_limits_valid
