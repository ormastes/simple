"""Thread-safe ownership gate for the pgwire dispatch lifecycle.

Socket workers may submit, cancel, and retrieve completions concurrently. The
database owner alone claims and completes jobs, so PureDatabase never crosses
the thread boundary.
"""

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_lock, mutex_unlock}
use std.database.postgres_mimic.dispatch_lifecycle.{
    PgDispatchLifecycle, PgDispatchState, PgDispatchOperation,
    PgDispatchSubmitResult, PgDispatchTakeResult, PgDispatchClaimResult,
    PgDispatchCompletion
}

class PgDispatchGate:
    # Gate values are copied into every socket frontend. Keep the mutable
    # lifecycle behind a one-element heap collection so those value copies do
    # not fork the queue metadata (notably next_job_id and draining). The mutex
    # and this cell are the only shared mutable objects crossing the worker
    # boundary.
    lifecycle_cell: [PgDispatchLifecycle]
    gate: Mutex

    static fn create(capacity: i64) -> PgDispatchGate:
        PgDispatchGate(lifecycle_cell: [PgDispatchLifecycle.create(capacity)],
            gate: mutex_new(0))

    fn retained_count() -> i64:
        val _ = mutex_lock(self.gate)
        val result = self.lifecycle_cell[0].retained_count()
        val _ = mutex_unlock(self.gate, 0)
        result

    fn active_count() -> i64:
        val _ = mutex_lock(self.gate)
        val result = self.lifecycle_cell[0].active_count()
        val _ = mutex_unlock(self.gate, 0)
        result

    fn state_of(job_id: i64) -> PgDispatchState?:
        val _ = mutex_lock(self.gate)
        val result = self.lifecycle_cell[0].state_of(job_id)
        val _ = mutex_unlock(self.gate, 0)
        result

    me submit(connection_id: i64, session_id: i64,
            operation: PgDispatchOperation, payload: text,
            now_ms: i64, timeout_ms: i64) -> PgDispatchSubmitResult:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.submit(connection_id, session_id,
            operation, payload, now_ms, timeout_ms)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me submit_startup(connection_id: i64, user: text, database: text,
            application_name: text, now_ms: i64,
            timeout_ms: i64) -> PgDispatchSubmitResult:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.submit_startup(connection_id, user,
            database, application_name, now_ms, timeout_ms)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me claim_next(now_ms: i64) -> PgDispatchClaimResult:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.claim_next(now_ms)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me complete(job_id: i64, completion: PgDispatchCompletion) -> bool:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.complete(job_id, completion)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me cancel_connection(connection_id: i64) -> i64:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.cancel_connection(connection_id)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me expire_queued(now_ms: i64) -> i64:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.expire_queued(now_ms)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me take(job_id: i64) -> PgDispatchTakeResult:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.take(job_id)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me begin_drain() -> i64:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.begin_drain()
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me cancel_queued() -> i64:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.cancel_queued()
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me cancel_queued_and_remove(limit: i64) -> [i64]:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.cancel_queued_and_remove(limit)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

    me cancel_connection_and_remove(connection_id: i64, limit: i64) -> [i64]:
        val _ = mutex_lock(self.gate)
        var lifecycle = self.lifecycle_cell[0]
        val result = lifecycle.cancel_connection_and_remove(connection_id, limit)
        self.lifecycle_cell[0] = lifecycle
        val _ = mutex_unlock(self.gate, 0)
        result

export PgDispatchGate
