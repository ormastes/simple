"""Bounded, socket-free PostgreSQL v3 frontend wire decoder.

The transport owner may retain bytes when `NeedMore` is returned, dispatch a
decoded message, or close the connection on `Rejected`.  Rejected input never
produces a partially usable startup or query value.
"""

use std.common.encoding.utf8.{utf8_decode_all, text_from_codepoints}

const PGWIRE_PROTOCOL_V3: i64 = 196608
const PGWIRE_SSL_REQUEST_CODE: i64 = 80877103
const PGWIRE_CANCEL_REQUEST_CODE: i64 = 80877102
const PGWIRE_DEFAULT_MAX_FRAME: i64 = 1024 * 1024
const PGWIRE_DEFAULT_MAX_PARAMETERS: i64 = 64

enum PgWireDecodeStatus:
    NeedMore
    Decoded
    Rejected

enum PgWireMessageKind:
    None
    SslRequest
    Startup
    SimpleQuery
    Terminate
    CancelRequest

enum PgWireErrorCode:
    None
    InvalidLimit
    InvalidLength
    FrameTooLarge
    UnsupportedProtocol
    MalformedPayload
    InvalidUtf8
    MissingUser
    MissingDatabase
    TooManyParameters
    UnsupportedMessage

struct PgWireMessage:
    kind: PgWireMessageKind
    user: text
    database: text
    application_name: text
    query: text
    process_id: i64
    secret_key: i64

struct PgWireDecodeResult:
    status: PgWireDecodeStatus
    message: PgWireMessage
    consumed: i64
    required: i64
    error: PgWireErrorCode
    detail: text

# Native callers must not carry the nested `PgWireDecodeResult.message`
# aggregate across a module boundary.  This decoder keeps that aggregate in
# this module and publishes only scalar/text projections through methods.
class PgWireDecoder:
    result: PgWireDecodeResult

    me decode_startup(bytes: [i64], max_frame: i64 = PGWIRE_DEFAULT_MAX_FRAME,
            max_parameters: i64 = PGWIRE_DEFAULT_MAX_PARAMETERS) -> PgWireDecodeStatus:
        self.result = pgwire_decode_startup(bytes, max_frame, max_parameters)
        self.result.status

    me decode_frontend(bytes: [i64], max_frame: i64 = PGWIRE_DEFAULT_MAX_FRAME) -> PgWireDecodeStatus:
        self.result = pgwire_decode_frontend(bytes, max_frame)
        self.result.status

    fn message_kind() -> PgWireMessageKind: self.result.message.kind
    fn consumed() -> i64: self.result.consumed
    fn required() -> i64: self.result.required
    fn error() -> PgWireErrorCode: self.result.error
    fn detail() -> text: self.result.detail
    fn user() -> text: self.result.message.user
    fn database() -> text: self.result.message.database
    fn application_name() -> text: self.result.message.application_name
    fn query() -> text: self.result.message.query
    fn process_id() -> i64: self.result.message.process_id
    fn secret_key() -> i64: self.result.message.secret_key

fn pgwire_empty_message() -> PgWireMessage:
    PgWireMessage(kind: PgWireMessageKind.None, user: "", database: "", application_name: "", query: "",
        process_id: 0, secret_key: 0)

fn pgwire_need_more(required: i64) -> PgWireDecodeResult:
    PgWireDecodeResult(status: PgWireDecodeStatus.NeedMore, message: pgwire_empty_message(), consumed: 0,
        required: required, error: PgWireErrorCode.None, detail: "")

fn pgwire_reject(code: PgWireErrorCode, detail: text) -> PgWireDecodeResult:
    PgWireDecodeResult(status: PgWireDecodeStatus.Rejected, message: pgwire_empty_message(), consumed: 0,
        required: 0, error: code, detail: detail)

fn pgwire_decoded(message: PgWireMessage, consumed: i64) -> PgWireDecodeResult:
    PgWireDecodeResult(status: PgWireDecodeStatus.Decoded, message: message, consumed: consumed,
        required: 0, error: PgWireErrorCode.None, detail: "")

fn pgwire_decoder() -> PgWireDecoder:
    PgWireDecoder(result: pgwire_need_more(4))

fn pgwire_u32_be(bytes: [i64], offset: i64) -> i64:
    bytes[offset] * 16777216 + bytes[offset + 1] * 65536 + bytes[offset + 2] * 256 + bytes[offset + 3]

fn pgwire_valid_octets(bytes: [i64]) -> bool:
    var i = 0
    while i < bytes.len():
        if bytes[i] < 0 or bytes[i] > 255: return false
        i = i + 1
    true

fn pgwire_valid_utf8(bytes: [i64]) -> bool:
    var i = 0
    while i < bytes.len():
        val first = bytes[i]
        if first <= 127:
            i = i + 1
        else:
            var width = 0
            var minimum_second = 128
            var maximum_second = 191
            if first >= 194 and first <= 223:
                width = 2
            elif first >= 224 and first <= 239:
                width = 3
                if first == 224: minimum_second = 160
                if first == 237: maximum_second = 159
            elif first >= 240 and first <= 244:
                width = 4
                if first == 240: minimum_second = 144
                if first == 244: maximum_second = 143
            else:
                return false
            if i + width > bytes.len(): return false
            if bytes[i + 1] < minimum_second or bytes[i + 1] > maximum_second: return false
            var j = 2
            while j < width:
                if bytes[i + j] < 128 or bytes[i + j] > 191: return false
                j = j + 1
            i = i + width
    true

fn pgwire_text(bytes: [i64], start: i64, end: i64) -> text:
    var raw: [i64] = []
    var i = start
    while i < end:
        raw.push(bytes[i])
        i = i + 1
    text_from_codepoints(utf8_decode_all(raw))

fn pgwire_find_nul(bytes: [i64], start: i64, end: i64) -> i64:
    var i = start
    while i < end:
        if bytes[i] == 0: return i
        i = i + 1
    -1

fn pgwire_decode_startup(bytes: [i64], max_frame: i64 = PGWIRE_DEFAULT_MAX_FRAME,
        max_parameters: i64 = PGWIRE_DEFAULT_MAX_PARAMETERS) -> PgWireDecodeResult:
    if max_frame < 8 or max_parameters < 1:
        return pgwire_reject(PgWireErrorCode.InvalidLimit, "startup decoder limits are invalid")
    if not pgwire_valid_octets(bytes):
        return pgwire_reject(PgWireErrorCode.MalformedPayload, "input contains a non-octet value")
    if bytes.len() < 4: return pgwire_need_more(4)
    val frame_length = pgwire_u32_be(bytes, 0)
    if frame_length < 8: return pgwire_reject(PgWireErrorCode.InvalidLength, "startup length is below 8")
    if frame_length > max_frame: return pgwire_reject(PgWireErrorCode.FrameTooLarge, "startup exceeds configured limit")
    if bytes.len() < frame_length: return pgwire_need_more(frame_length)
    val code = pgwire_u32_be(bytes, 4)
    if code == PGWIRE_SSL_REQUEST_CODE:
        if frame_length != 8: return pgwire_reject(PgWireErrorCode.InvalidLength, "SSLRequest length must be 8")
        return pgwire_decoded(PgWireMessage(kind: PgWireMessageKind.SslRequest, user: "", database: "",
            application_name: "", query: "", process_id: 0, secret_key: 0), frame_length)
    if code == PGWIRE_CANCEL_REQUEST_CODE:
        if frame_length != 16: return pgwire_reject(PgWireErrorCode.InvalidLength, "CancelRequest length must be 16")
        return pgwire_decoded(PgWireMessage(kind: PgWireMessageKind.CancelRequest, user: "", database: "",
            application_name: "", query: "", process_id: pgwire_u32_be(bytes, 8),
            secret_key: pgwire_u32_be(bytes, 12)), frame_length)
    if code != PGWIRE_PROTOCOL_V3:
        return pgwire_reject(PgWireErrorCode.UnsupportedProtocol, "only PostgreSQL protocol 3.0 is supported")
    if bytes[frame_length - 1] != 0:
        return pgwire_reject(PgWireErrorCode.MalformedPayload, "startup parameters lack final terminator")

    var user = ""
    var database = ""
    var application_name = ""
    var position = 8
    var count = 0
    while position < frame_length - 1:
        if count >= max_parameters:
            return pgwire_reject(PgWireErrorCode.TooManyParameters, "startup parameter limit exceeded")
        val key_end = pgwire_find_nul(bytes, position, frame_length)
        if key_end <= position: return pgwire_reject(PgWireErrorCode.MalformedPayload, "startup key is empty or unterminated")
        val value_start = key_end + 1
        val value_end = pgwire_find_nul(bytes, value_start, frame_length)
        if value_end < value_start: return pgwire_reject(PgWireErrorCode.MalformedPayload, "startup value is unterminated")
        var field: [i64] = []
        var field_i = position
        while field_i < value_end:
            field.push(bytes[field_i])
            field_i = field_i + 1
        if not pgwire_valid_utf8(field): return pgwire_reject(PgWireErrorCode.InvalidUtf8, "startup parameter is not valid UTF-8")
        val key = pgwire_text(bytes, position, key_end)
        val value = pgwire_text(bytes, value_start, value_end)
        if key == "user": user = value
        elif key == "database": database = value
        elif key == "application_name": application_name = value
        position = value_end + 1
        count = count + 1
    if position != frame_length - 1:
        return pgwire_reject(PgWireErrorCode.MalformedPayload, "startup parameter pairs are misaligned")
    if user == "": return pgwire_reject(PgWireErrorCode.MissingUser, "startup user is required")
    if database == "": database = user
    pgwire_decoded(PgWireMessage(kind: PgWireMessageKind.Startup, user: user, database: database,
        application_name: application_name, query: "", process_id: 0, secret_key: 0), frame_length)

fn pgwire_decode_frontend(bytes: [i64], max_frame: i64 = PGWIRE_DEFAULT_MAX_FRAME) -> PgWireDecodeResult:
    if max_frame < 5: return pgwire_reject(PgWireErrorCode.InvalidLimit, "frontend frame limit is invalid")
    if not pgwire_valid_octets(bytes):
        return pgwire_reject(PgWireErrorCode.MalformedPayload, "input contains a non-octet value")
    if bytes.len() < 5: return pgwire_need_more(5)
    val frame_length = pgwire_u32_be(bytes, 1)
    if frame_length < 4: return pgwire_reject(PgWireErrorCode.InvalidLength, "frontend length is below 4")
    val total_length = frame_length + 1
    if total_length > max_frame: return pgwire_reject(PgWireErrorCode.FrameTooLarge, "frontend frame exceeds configured limit")
    if bytes.len() < total_length: return pgwire_need_more(total_length)
    val tag = bytes[0]
    if tag == 88:
        if frame_length != 4: return pgwire_reject(PgWireErrorCode.InvalidLength, "Terminate length must be 4")
        return pgwire_decoded(PgWireMessage(kind: PgWireMessageKind.Terminate, user: "", database: "",
            application_name: "", query: "", process_id: 0, secret_key: 0), total_length)
    if tag != 81: return pgwire_reject(PgWireErrorCode.UnsupportedMessage, "frontend message type is unsupported")
    if frame_length < 5 or bytes[total_length - 1] != 0:
        return pgwire_reject(PgWireErrorCode.MalformedPayload, "simple query must be NUL terminated")
    if pgwire_find_nul(bytes, 5, total_length - 1) >= 0:
        return pgwire_reject(PgWireErrorCode.MalformedPayload, "simple query contains an embedded terminator")
    var query_bytes: [i64] = []
    var i = 5
    while i < total_length - 1:
        query_bytes.push(bytes[i])
        i = i + 1
    if not pgwire_valid_utf8(query_bytes): return pgwire_reject(PgWireErrorCode.InvalidUtf8, "simple query is not valid UTF-8")
    val query = pgwire_text(bytes, 5, total_length - 1)
    if query.trim() == "": return pgwire_reject(PgWireErrorCode.MalformedPayload, "simple query is empty")
    pgwire_decoded(PgWireMessage(kind: PgWireMessageKind.SimpleQuery, user: "", database: "",
        application_name: "", query: query, process_id: 0, secret_key: 0), total_length)

export PGWIRE_PROTOCOL_V3, PGWIRE_SSL_REQUEST_CODE, PGWIRE_CANCEL_REQUEST_CODE
export PGWIRE_DEFAULT_MAX_FRAME, PGWIRE_DEFAULT_MAX_PARAMETERS
export PgWireDecodeStatus, PgWireMessageKind, PgWireErrorCode, PgWireMessage, PgWireDecodeResult
export PgWireDecoder, pgwire_decoder, pgwire_decode_startup, pgwire_decode_frontend
