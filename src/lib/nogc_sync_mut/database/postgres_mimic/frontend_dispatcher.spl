"""Socket-neutral pgwire frontend for fixed parallel accept workers.

The frontend owns protocol state and response encoding. It never calls the
database. Commands cross `PgDispatchGate`; the database-owner thread later
publishes a completion which the worker polls by job identity.
"""

use std.database.postgres_mimic.server.{PgResponse, PgResponseKind}
use std.database.postgres_mimic.connection.{PgWireSslPolicy}
use std.database.postgres_mimic.transport.{
    PgWireTransportDriver, PgWireTransportEvent, PgWireTransportEventKind,
    pgwire_transport_driver
}
use std.database.postgres_mimic.dispatch_lifecycle.{
    PgDispatchOperation, PgDispatchSubmitResult, PgDispatchTakeResult
}
use std.database.postgres_mimic.dispatch_gate.{PgDispatchGate}
use std.database.postgres_mimic.wire_encode.{
    pgwire_encode_startup, pgwire_encode_query
}

enum PgFrontendActionKind:
    Write
    WaitOwner
    Close

struct PgFrontendAction:
    kind: PgFrontendActionKind
    bytes: [u8]
    job_id: i64

fn pg_frontend_action(kind: PgFrontendActionKind) -> PgFrontendAction:
    PgFrontendAction(kind: kind, bytes: [], job_id: 0)

fn pg_frontend_write(bytes: [u8]) -> PgFrontendAction:
    PgFrontendAction(kind: PgFrontendActionKind.Write, bytes: bytes, job_id: 0)

fn pg_frontend_error(sqlstate: text, message: text) -> [u8]:
    val response = PgResponse(kind: PgResponseKind.ErrorResponse, tag: "ERROR",
        columns: [], rows: [], sqlstate: sqlstate, message: message,
        transaction_status: "I")
    match pgwire_encode_query(response):
        Ok(bytes): bytes
        Err(_): []

class PgWireFrontendDispatcher:
    connection_id: i64
    session_id: i64
    pending_job_id: i64
    pending_operation: PgDispatchOperation
    driver: PgWireTransportDriver
    deferred: [PgWireTransportEvent]
    gate: PgDispatchGate
    closed: bool
    termination_submitted: bool

    static fn create(connection_id: i64, gate: PgDispatchGate,
            ssl_policy: PgWireSslPolicy, max_frame: i64,
            max_parameters: i64, max_buffer: i64) -> PgWireFrontendDispatcher:
        PgWireFrontendDispatcher(connection_id: connection_id, session_id: 0,
            pending_job_id: 0, pending_operation: PgDispatchOperation.Startup,
            driver: pgwire_transport_driver(ssl_policy, max_frame,
                max_parameters, max_buffer), deferred: [], gate: gate,
            closed: false, termination_submitted: false)

    me enqueue_driver_events():
        val events = self.driver.drain_events()
        for event in events:
            self.deferred.push(event)

    me reject_and_close(sqlstate: text, message: text) -> [PgFrontendAction]:
        self.closed = true
        self.driver.cancel(message)
        val _ = self.gate.cancel_connection(self.connection_id)
        [pg_frontend_write(pg_frontend_error(sqlstate, message)),
            pg_frontend_action(PgFrontendActionKind.Close)]

    me submit_event(event: PgWireTransportEvent,
            allowed_user: text, allowed_database: text,
            now_ms: i64, timeout_ms: i64) -> [PgFrontendAction]:
        if event.kind == PgWireTransportEventKind.SendSslUnsupported:
            return [pg_frontend_write([78])]
        if event.kind == PgWireTransportEventKind.SendSslSupported:
            return self.reject_and_close("08004", "TLS stream owner unavailable")
        if event.kind == PgWireTransportEventKind.Authenticate:
            if event.user != allowed_user or event.database != allowed_database:
                self.driver.authentication_failed()
                return self.reject_and_close("28P01", "authentication failed")
            val submission = self.gate.submit_startup(self.connection_id,
                event.user, event.database, event.application_name,
                now_ms, timeout_ms)
            match submission:
                PgDispatchSubmitResult.Accepted(job_id):
                    self.pending_job_id = job_id
                    self.pending_operation = PgDispatchOperation.Startup
                    return [PgFrontendAction(kind: PgFrontendActionKind.WaitOwner,
                        bytes: [], job_id: job_id)]
                PgDispatchSubmitResult.Rejected:
                    return self.reject_and_close("53300", "database queue full")
        if event.kind == PgWireTransportEventKind.ExecuteQuery:
            if self.session_id <= 0:
                return self.reject_and_close("08003", "session is not established")
            val submission = self.gate.submit(self.connection_id,
                self.session_id, PgDispatchOperation.Query, event.query,
                now_ms, timeout_ms)
            match submission:
                PgDispatchSubmitResult.Accepted(job_id):
                    self.pending_job_id = job_id
                    self.pending_operation = PgDispatchOperation.Query
                    return [PgFrontendAction(kind: PgFrontendActionKind.WaitOwner,
                        bytes: [], job_id: job_id)]
                PgDispatchSubmitResult.Rejected:
                    return [pg_frontend_write(pg_frontend_error(
                        "53300", "database queue full"))]
        if event.kind == PgWireTransportEventKind.CancelRequest:
            return self.reject_and_close("57014", "remote cancellation unsupported")
        if event.kind == PgWireTransportEventKind.Close:
            self.closed = true
            val _ = self.gate.cancel_connection(self.connection_id)
            return [pg_frontend_action(PgFrontendActionKind.Close)]
        []

    me advance(allowed_user: text, allowed_database: text,
            now_ms: i64, timeout_ms: i64) -> [PgFrontendAction]:
        var actions: [PgFrontendAction] = []
        while self.pending_job_id == 0 and self.deferred.len() > 0 and not self.closed:
            val event = self.deferred[0]
            self.deferred = self.deferred.slice(1, self.deferred.len())
            val produced = self.submit_event(event, allowed_user,
                allowed_database, now_ms, timeout_ms)
            for action in produced: actions.push(action)
        actions

    me feed(bytes: [i64], allowed_user: text, allowed_database: text,
            now_ms: i64, timeout_ms: i64) -> [PgFrontendAction]:
        if self.closed: return [pg_frontend_action(PgFrontendActionKind.Close)]
        self.driver.feed(bytes)
        self.enqueue_driver_events()
        self.advance(allowed_user, allowed_database, now_ms, timeout_ms)

    me poll_owner(allowed_user: text, allowed_database: text,
            now_ms: i64, timeout_ms: i64,
            max_response: i64) -> [PgFrontendAction]:
        if self.closed: return [pg_frontend_action(PgFrontendActionKind.Close)]
        if self.pending_job_id == 0:
            return self.advance(allowed_user, allowed_database, now_ms, timeout_ms)
        val job_id = self.pending_job_id
        match self.gate.take(job_id):
            PgDispatchTakeResult.NotReady:
                return [PgFrontendAction(kind: PgFrontendActionKind.WaitOwner,
                    bytes: [], job_id: job_id)]
            PgDispatchTakeResult.Gone:
                self.pending_job_id = 0
                return self.reject_and_close("57014", "database command cancelled or timed out")
            PgDispatchTakeResult.Ready(completion):
                self.pending_job_id = 0
                var actions: [PgFrontendAction] = []
                if self.pending_operation == PgDispatchOperation.Startup:
                    if completion.close_connection or completion.session_id <= 0:
                        if completion.responses.len() > 0:
                            match pgwire_encode_query(completion.responses[0], max_response):
                                Ok(bytes): actions.push(pg_frontend_write(bytes))
                                Err(_): ()
                        self.driver.authentication_failed()
                        self.closed = true
                        actions.push(pg_frontend_action(PgFrontendActionKind.Close))
                        return actions
                    self.session_id = completion.session_id
                    self.driver.authentication_succeeded()
                    match pgwire_encode_startup(completion.responses, max_response):
                        Ok(bytes): actions.push(pg_frontend_write(bytes))
                        Err(_): return self.reject_and_close("54000", "startup response too large")
                    self.enqueue_driver_events()
                else:
                    if completion.responses.len() != 1:
                        return self.reject_and_close("XX000", "invalid database completion")
                    match pgwire_encode_query(completion.responses[0], max_response):
                        Ok(bytes): actions.push(pg_frontend_write(bytes))
                        Err(_): return self.reject_and_close("54000", "query response too large")
                val more = self.advance(allowed_user, allowed_database,
                    now_ms, timeout_ms)
                for action in more: actions.push(action)
                actions

    me disconnect(now_ms: i64 = 0, timeout_ms: i64 = 1000):
        if not self.closed:
            self.closed = true
            val _ = self.gate.cancel_connection(self.connection_id)
        if self.session_id > 0 and not self.termination_submitted:
            self.termination_submitted = true
            val _ = self.gate.submit(self.connection_id, self.session_id,
                PgDispatchOperation.Terminate, "", now_ms, timeout_ms)

export PgFrontendActionKind, PgFrontendAction, PgWireFrontendDispatcher
