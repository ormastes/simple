"""Bounded PostgreSQL v3 backend-message encoding for the supported subset."""

use std.database.postgres_mimic.server.{PgResponse, PgResponseKind}
use std.database.sql.types.{DbValue}

const PGWIRE_DEFAULT_MAX_RESPONSE: i64 = 8 * 1024 * 1024

fn pgwire_be16(value: i64) -> [u8]:
    [(value / 256 % 256).to_u8(), (value % 256).to_u8()]

fn pgwire_be32(value: i64) -> [u8]:
    [(value / 16777216 % 256).to_u8(), (value / 65536 % 256).to_u8(),
        (value / 256 % 256).to_u8(), (value % 256).to_u8()]

fn pgwire_text_bytes(value: text) -> [u8]:
    var out: [u8] = []
    for byte in value.bytes(): out.push(byte.to_u8())
    out

fn pgwire_cstring(value: text) -> [u8]: pgwire_text_bytes(value) + [0]

fn pgwire_message(tag: i64, payload: [u8]) -> [u8]:
    [tag.to_u8()] + pgwire_be32(payload.len() + 4) + payload

fn pgwire_authentication_ok() -> [u8]: pgwire_message(82, pgwire_be32(0))

fn pgwire_parameter_status(key: text, value: text) -> [u8]:
    pgwire_message(83, pgwire_cstring(key) + pgwire_cstring(value))

fn pgwire_ready(status: text) -> [u8]:
    val byte = if status == "T": 84 elif status == "E": 69 else: 73
    pgwire_message(90, [byte.to_u8()])

fn pgwire_command_complete(tag: text) -> [u8]: pgwire_message(67, pgwire_cstring(tag))

fn pgwire_error(sqlstate: text, message: text) -> [u8]:
    val payload = [83.to_u8()] + pgwire_cstring("ERROR") + [67.to_u8()] +
        pgwire_cstring(sqlstate) + [77.to_u8()] + pgwire_cstring(message) + [0]
    pgwire_message(69, payload)

fn pgwire_row_description(columns: [text]) -> [u8]:
    var payload = pgwire_be16(columns.len())
    for column in columns:
        # Text format with unknown table/attribute and PostgreSQL TEXT OID.
        payload = payload + pgwire_cstring(column) + pgwire_be32(0) + pgwire_be16(0) +
            pgwire_be32(25) + pgwire_be16(65535) + pgwire_be32(4294967295) + pgwire_be16(0)
    pgwire_message(84, payload)

fn pgwire_data_row(values: [DbValue]) -> [u8]:
    var payload = pgwire_be16(values.len())
    for value in values:
        match value:
            DbValue.Null: payload = payload + pgwire_be32(4294967295)
            other:
                val encoded = pgwire_text_bytes(other.to_text())
                payload = payload + pgwire_be32(encoded.len()) + encoded
    pgwire_message(68, payload)

fn pgwire_encode_startup(responses: [PgResponse], max_response: i64 = PGWIRE_DEFAULT_MAX_RESPONSE) -> Result<[u8], text>:
    var encoded: [u8] = []
    for response in responses:
        val part = match response.kind:
            PgResponseKind.AuthenticationOk: pgwire_authentication_ok()
            PgResponseKind.ParameterStatus: pgwire_parameter_status(response.tag, response.message)
            PgResponseKind.ReadyForQuery: pgwire_ready(response.transaction_status)
            PgResponseKind.ErrorResponse: pgwire_error(response.sqlstate, response.message)
            _: []
        if part.len() > max_response - encoded.len(): return Err("pgwire response exceeds configured limit")
        encoded = encoded + part
    Ok(encoded)

fn pgwire_encode_query(response: PgResponse, max_response: i64 = PGWIRE_DEFAULT_MAX_RESPONSE) -> Result<[u8], text>:
    var encoded: [u8] = []
    if response.kind == PgResponseKind.RowSet:
        encoded = pgwire_row_description(response.columns)
        for row in response.rows:
            val part = pgwire_data_row(row.values)
            if part.len() > max_response - encoded.len(): return Err("pgwire response exceeds configured limit")
            encoded = encoded + part
        encoded = encoded + pgwire_command_complete(response.tag)
    elif response.kind == PgResponseKind.CommandComplete:
        encoded = pgwire_command_complete(response.tag)
    elif response.kind == PgResponseKind.ErrorResponse:
        encoded = pgwire_error(response.sqlstate, response.message)
    else:
        return Err("unsupported pgwire response kind")
    val ready = pgwire_ready(response.transaction_status)
    if ready.len() > max_response - encoded.len(): return Err("pgwire response exceeds configured limit")
    Ok(encoded + ready)

export PGWIRE_DEFAULT_MAX_RESPONSE
export pgwire_encode_startup, pgwire_encode_query
