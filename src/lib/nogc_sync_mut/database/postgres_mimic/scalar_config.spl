"""Parent-owned scalar handoff for immutable pgwire server configuration.

The parent owns the text values and the TLS policy.  A worker receives only
the positive ``i64`` returned by ``pgwire_server_config_intern`` and may use
the scalar getters below.  The handle contains an owner namespace, a slot,
and a generation; it is not a pointer and it is never reused at the same
generation.  Wrong-owner, malformed, and stale handles return zero (or
false) and cannot expose the stored text or enum.

The registry is deliberately bounded.  ``capacity`` is clamped to
``PGWIRE_CONFIG_MAX_SLOTS`` and retired slots are not wrapped when their
generation counter reaches its limit.  The parent must release a handle only
after all workers using it have joined.
"""

use std.database.postgres_mimic.connection.{PgWireSslPolicy}

const PGWIRE_CONFIG_FIELD_TLS_POLICY: i64 = 1
const PGWIRE_CONFIG_FIELD_USER_ID: i64 = 2
const PGWIRE_CONFIG_FIELD_DATABASE_ID: i64 = 3
const PGWIRE_CONFIG_INVALID: i64 = 0
const PGWIRE_CONFIG_MAX_SLOTS: i64 = 1024
const PGWIRE_CONFIG_SLOT_RADIX: i64 = 2048
const PGWIRE_CONFIG_GENERATION_RADIX: i64 = 1000000
const PGWIRE_CONFIG_NAMESPACE_STRIDE: i64 = 2048000000
const PGWIRE_CONFIG_MAX_NAMESPACE: i64 = 4000000

struct PgWireServerConfigEntry:
    generation: i64
    live: bool
    tls_policy: i64
    user_id: i64
    database_id: i64
    user: text
    database: text

class PgWireServerConfigOwner:
    owner_namespace: i64
    capacity: i64
    entries: [PgWireServerConfigEntry]
    user_ids: Dict<text, i64>
    database_ids: Dict<text, i64>
    next_user_id: i64
    next_database_id: i64

    static fn create(owner_namespace: i64, capacity: i64 = 64) -> PgWireServerConfigOwner:
        val bounded_namespace = if owner_namespace > 0 and owner_namespace <= PGWIRE_CONFIG_MAX_NAMESPACE:
            owner_namespace
        else: 1
        val bounded_capacity = if capacity > 0 and capacity <= PGWIRE_CONFIG_MAX_SLOTS:
            capacity
        elif capacity > PGWIRE_CONFIG_MAX_SLOTS: PGWIRE_CONFIG_MAX_SLOTS
        else: 1
        var entries: [PgWireServerConfigEntry] = []
        var index = 0
        while index < bounded_capacity:
            entries.push(PgWireServerConfigEntry(generation: 1, live: false,
                tls_policy: 0, user_id: 0, database_id: 0, user: "", database: ""))
            index = index + 1
        PgWireServerConfigOwner(owner_namespace: bounded_namespace,
            capacity: bounded_capacity, entries: entries, user_ids: {},
            database_ids: {}, next_user_id: 1, next_database_id: 1)

    fn encode_handle(slot: i64, generation: i64) -> i64:
        self.owner_namespace * PGWIRE_CONFIG_NAMESPACE_STRIDE +
            generation * PGWIRE_CONFIG_SLOT_RADIX + slot + 1

    fn decode_slot(handle: i64) -> i64:
        if handle <= 0: return -1
        if handle / PGWIRE_CONFIG_NAMESPACE_STRIDE != self.owner_namespace: return -1
        val remainder = handle % PGWIRE_CONFIG_NAMESPACE_STRIDE
        val generation = remainder / PGWIRE_CONFIG_SLOT_RADIX
        val local = remainder % PGWIRE_CONFIG_SLOT_RADIX
        if generation <= 0 or local <= 0 or local > self.capacity: return -1
        val slot = local - 1
        if self.entries[slot].generation != generation or not self.entries[slot].live:
            return -1
        slot

    me intern(policy: PgWireSslPolicy, user: text, database: text) -> i64:
        val tls_policy = pgwire_ssl_policy_code(policy)
        if tls_policy == 0 or user.trim() == "" or database.trim() == "":
            return PGWIRE_CONFIG_INVALID
        var slot = 0
        while slot < self.capacity:
            if not self.entries[slot].live and
                    self.entries[slot].generation < PGWIRE_CONFIG_GENERATION_RADIX:
                val user_id = self.intern_user(user)
                val database_id = self.intern_database(database)
                self.entries[slot] = PgWireServerConfigEntry(
                    generation: self.entries[slot].generation, live: true,
                    tls_policy: tls_policy, user_id: user_id,
                    database_id: database_id, user: user, database: database)
                return self.encode_handle(slot, self.entries[slot].generation)
            slot = slot + 1
        PGWIRE_CONFIG_INVALID

    me intern_user(value: text) -> i64:
        if self.user_ids.contains_key(value): return self.user_ids[value]
        val id = self.next_user_id
        self.next_user_id = id + 1
        self.user_ids[value] = id
        id

    me intern_database(value: text) -> i64:
        if self.database_ids.contains_key(value): return self.database_ids[value]
        val id = self.next_database_id
        self.next_database_id = id + 1
        self.database_ids[value] = id
        id

    fn get(handle: i64, field: i64) -> i64:
        val slot = self.decode_slot(handle)
        if slot < 0: return PGWIRE_CONFIG_INVALID
        val entry = self.entries[slot]
        if field == PGWIRE_CONFIG_FIELD_TLS_POLICY: return entry.tls_policy
        if field == PGWIRE_CONFIG_FIELD_USER_ID: return entry.user_id
        if field == PGWIRE_CONFIG_FIELD_DATABASE_ID: return entry.database_id
        PGWIRE_CONFIG_INVALID

    fn user_matches(handle: i64, candidate: text) -> bool:
        val slot = self.decode_slot(handle)
        slot >= 0 and self.entries[slot].user == candidate

    fn database_matches(handle: i64, candidate: text) -> bool:
        val slot = self.decode_slot(handle)
        slot >= 0 and self.entries[slot].database == candidate

    me release(handle: i64) -> bool:
        val slot = self.decode_slot(handle)
        if slot < 0: return false
        val next_generation = self.entries[slot].generation + 1
        self.entries[slot] = PgWireServerConfigEntry(
            generation: next_generation, live: false, tls_policy: 0,
            user_id: 0, database_id: 0, user: "", database: "")
        true

    fn valid(handle: i64) -> bool:
        self.decode_slot(handle) >= 0

fn pgwire_ssl_policy_code(policy: PgWireSslPolicy) -> i64:
    match policy:
        PgWireSslPolicy.Disabled: 1
        PgWireSslPolicy.Optional: 2
        PgWireSslPolicy.Required: 3

fn pgwire_server_config_owner(owner_namespace: i64,
        capacity: i64 = 64) -> PgWireServerConfigOwner:
    PgWireServerConfigOwner.create(owner_namespace, capacity)

fn pgwire_server_config_intern(owner: PgWireServerConfigOwner,
        policy: PgWireSslPolicy, user: text, database: text) -> i64:
    owner.intern(policy, user, database)

fn pgwire_server_config_get(owner: PgWireServerConfigOwner,
        handle: i64, field: i64) -> i64:
    owner.get(handle, field)

fn pgwire_server_config_tls_policy(owner: PgWireServerConfigOwner,
        handle: i64) -> i64:
    owner.get(handle, PGWIRE_CONFIG_FIELD_TLS_POLICY)

fn pgwire_server_config_user_id(owner: PgWireServerConfigOwner,
        handle: i64) -> i64:
    owner.get(handle, PGWIRE_CONFIG_FIELD_USER_ID)

fn pgwire_server_config_database_id(owner: PgWireServerConfigOwner,
        handle: i64) -> i64:
    owner.get(handle, PGWIRE_CONFIG_FIELD_DATABASE_ID)

fn pgwire_server_config_user_matches(owner: PgWireServerConfigOwner,
        handle: i64, candidate: text) -> bool:
    owner.user_matches(handle, candidate)

fn pgwire_server_config_database_matches(owner: PgWireServerConfigOwner,
        handle: i64, candidate: text) -> bool:
    owner.database_matches(handle, candidate)

fn pgwire_server_config_valid(owner: PgWireServerConfigOwner,
        handle: i64) -> bool:
    owner.valid(handle)

fn pgwire_server_config_release(owner: PgWireServerConfigOwner,
        handle: i64) -> bool:
    owner.release(handle)

export PgWireServerConfigOwner
export PGWIRE_CONFIG_FIELD_TLS_POLICY, PGWIRE_CONFIG_FIELD_USER_ID
export PGWIRE_CONFIG_FIELD_DATABASE_ID, PGWIRE_CONFIG_INVALID
export pgwire_ssl_policy_code, pgwire_server_config_owner
export pgwire_server_config_intern, pgwire_server_config_get
export pgwire_server_config_tls_policy, pgwire_server_config_user_id
export pgwire_server_config_database_id, pgwire_server_config_user_matches
export pgwire_server_config_database_matches, pgwire_server_config_valid
export pgwire_server_config_release
