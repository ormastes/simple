"""Bounded serialization owner for device-backed NVFS operations and close."""

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_with_lock}
use std.fs_driver.nvfs_device_identity_owner_v1.{
    NvfsDeviceIdentityBindingV1, NvfsDeviceRegionIdentityV1,
    nvfs_device_identity_validate_v1
}

pub val NVFS_OPERATION_OWNER_CAPACITY_V1: i32 = 256
val _NVFS_OPERATION_NONCE_MAX_V1: u64 = 0xffffffffffffffffu64

pub enum NvfsOperationLeaseErrorV1:
    InvalidBinding
    CapacityExhausted
    CounterExhausted
    StaleBinding
    Busy
    Closing
    Replay
    Quarantined

pub struct NvfsOperationLeaseV1:
    _slot: i32
    _generation: u32
    _operation_nonce: u64
    _outer_instance_id: i64

impl NvfsOperationLeaseV1:
    pub static fn invalid_probe() -> NvfsOperationLeaseV1:
        NvfsOperationLeaseV1(
            _slot: -1, _generation: 0u32, _operation_nonce: 0u64,
            _outer_instance_id: 0)

pub struct NvfsOperationCloseFenceV1:
    _slot: i32
    _generation: u32
    _close_nonce: u64
    _outer_instance_id: i64

enum NvfsOperationSlotStateV1:
    Free
    Active
    Draining
    Closing
    Retryable
    Quarantined

struct NvfsOperationSlotV1:
    state: NvfsOperationSlotStateV1
    generation: u32
    binding: NvfsDeviceIdentityBindingV1
    region: NvfsDeviceRegionIdentityV1
    outer_instance_id: i64
    inner_instance_id: i64
    active_operation_nonce: u64
    close_nonce: u64

struct NvfsOperationOwnerStateV1:
    slots: [NvfsOperationSlotV1]
    next_nonce: u64
    quarantined_count: i32
    active_global_slot: i32
    active_global_nonce: u64
    last_error: NvfsOperationLeaseErrorV1?
    last_lease: NvfsOperationLeaseV1
    last_fence: NvfsOperationCloseFenceV1

fn _empty_region_v1() -> NvfsDeviceRegionIdentityV1:
    NvfsDeviceRegionIdentityV1(device_owner_id: 0u64, base_block: -1, block_count: 0)

fn _empty_slot_v1(generation: u32) -> NvfsOperationSlotV1:
    NvfsOperationSlotV1(
        state: NvfsOperationSlotStateV1.Free, generation: generation,
        binding: NvfsDeviceIdentityBindingV1.invalid_probe(), region: _empty_region_v1(),
        outer_instance_id: 0, inner_instance_id: 0,
        active_operation_nonce: 0u64, close_nonce: 0u64)

fn _initial_state_v1() -> NvfsOperationOwnerStateV1:
    NvfsOperationOwnerStateV1(
        slots: [], next_nonce: 1u64, quarantined_count: 0,
        active_global_slot: -1, active_global_nonce: 0u64, last_error: nil,
        last_lease: NvfsOperationLeaseV1.invalid_probe(),
        last_fence: NvfsOperationCloseFenceV1(
            _slot: -1, _generation: 0u32, _close_nonce: 0u64,
            _outer_instance_id: 0))

var _nvfs_operation_owner_v1: Mutex = mutex_new(_initial_state_v1())

fn _binding_matches_v1(
    slot: NvfsOperationSlotV1, binding: NvfsDeviceIdentityBindingV1,
    outer_instance_id: i64, inner_instance_id: i64,
    region: NvfsDeviceRegionIdentityV1
) -> bool:
    (slot.generation == binding.generation() and
     slot.outer_instance_id == outer_instance_id and
     slot.inner_instance_id == inner_instance_id and
     binding.outer_instance_id() == outer_instance_id and
     binding.inner_instance_id() == inner_instance_id and
     slot.region.device_owner_id == region.device_owner_id and
     slot.region.base_block == region.base_block and
     slot.region.block_count == region.block_count)

pub fn nvfs_operation_owner_register_v1(
    binding: NvfsDeviceIdentityBindingV1, outer_instance_id: i64,
    inner_instance_id: i64, region: NvfsDeviceRegionIdentityV1
) -> Result<bool, NvfsOperationLeaseErrorV1>:
    if nvfs_device_identity_validate_v1(
            binding, outer_instance_id, inner_instance_id, region).is_err():
        return Err(NvfsOperationLeaseErrorV1.InvalidBinding)
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        val owner_index = binding.owner_slot_index()
        var duplicate = false
        var i: i32 = 0
        while i < state.slots.len():
            val slot = state.slots[i]
            if slot.state != NvfsOperationSlotStateV1.Free and slot.outer_instance_id == outer_instance_id:
                duplicate = true
            i = i + 1
        if duplicate:
            next.last_error = Some(NvfsOperationLeaseErrorV1.InvalidBinding)
        elif owner_index < 0 or owner_index >= NVFS_OPERATION_OWNER_CAPACITY_V1:
            next.last_error = Some(NvfsOperationLeaseErrorV1.CapacityExhausted)
        elif owner_index < state.slots.len() and state.slots[owner_index].state != NvfsOperationSlotStateV1.Free:
            next.last_error = Some(NvfsOperationLeaseErrorV1.CapacityExhausted)
        else:
            while next.slots.len() <= owner_index:
                next.slots.push(_empty_slot_v1(1u32))
            next.slots[owner_index] = NvfsOperationSlotV1(
                state: NvfsOperationSlotStateV1.Active,
                generation: binding.generation(), binding: binding, region: region,
                outer_instance_id: outer_instance_id, inner_instance_id: inner_instance_id,
                active_operation_nonce: 0u64, close_nonce: 0u64)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(true)

pub fn nvfs_operation_begin_v1(
    binding: NvfsDeviceIdentityBindingV1, outer_instance_id: i64,
    inner_instance_id: i64, region: NvfsDeviceRegionIdentityV1
) -> Result<NvfsOperationLeaseV1, NvfsOperationLeaseErrorV1>:
    if nvfs_device_identity_validate_v1(
            binding, outer_instance_id, inner_instance_id, region).is_err():
        return Err(NvfsOperationLeaseErrorV1.StaleBinding)
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        next.last_lease = NvfsOperationLeaseV1.invalid_probe()
        val slot_index = binding.owner_slot_index()
        if slot_index < 0 or slot_index >= state.slots.len():
            next.last_error = Some(NvfsOperationLeaseErrorV1.StaleBinding)
        else:
            val slot = state.slots[slot_index]
            if not _binding_matches_v1(slot, binding, outer_instance_id, inner_instance_id, region):
                next.last_error = Some(NvfsOperationLeaseErrorV1.StaleBinding)
            elif slot.state == NvfsOperationSlotStateV1.Quarantined:
                next.last_error = Some(NvfsOperationLeaseErrorV1.Quarantined)
            elif slot.state != NvfsOperationSlotStateV1.Active:
                next.last_error = Some(NvfsOperationLeaseErrorV1.Closing)
            elif slot.active_operation_nonce != 0u64 or state.active_global_nonce != 0u64:
                next.last_error = Some(NvfsOperationLeaseErrorV1.Busy)
            elif state.next_nonce == 0u64 or state.next_nonce == _NVFS_OPERATION_NONCE_MAX_V1:
                next.last_error = Some(NvfsOperationLeaseErrorV1.CounterExhausted)
            else:
                var active = slot
                active.active_operation_nonce = state.next_nonce
                next.slots[slot_index] = active
                next.next_nonce = state.next_nonce + 1u64
                next.active_global_slot = slot_index
                next.active_global_nonce = state.next_nonce
                next.last_lease = NvfsOperationLeaseV1(
                    _slot: slot_index, _generation: slot.generation,
                    _operation_nonce: state.next_nonce,
                    _outer_instance_id: outer_instance_id)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_lease)

pub fn nvfs_operation_end_v1(
    lease: NvfsOperationLeaseV1
) -> Result<bool, NvfsOperationLeaseErrorV1>:
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        if lease._slot == -2:
            if (lease._generation != 1u32 or lease._outer_instance_id != 0 or
                lease._operation_nonce == 0u64 or
                state.active_global_slot != -2 or
                state.active_global_nonce != lease._operation_nonce):
                next.last_error = Some(NvfsOperationLeaseErrorV1.Replay)
            else:
                next.active_global_slot = -1
                next.active_global_nonce = 0u64
        elif lease._slot < 0 or lease._slot >= state.slots.len():
            next.last_error = Some(NvfsOperationLeaseErrorV1.Replay)
        else:
            val slot = state.slots[lease._slot]
            if (slot.generation != lease._generation or
                slot.outer_instance_id != lease._outer_instance_id or
                slot.active_operation_nonce != lease._operation_nonce or
                lease._operation_nonce == 0u64 or
                state.active_global_slot != lease._slot or
                state.active_global_nonce != lease._operation_nonce):
                next.last_error = Some(NvfsOperationLeaseErrorV1.Replay)
            else:
                var released = slot
                released.active_operation_nonce = 0u64
                next.slots[lease._slot] = released
                next.active_global_slot = -1
                next.active_global_nonce = 0u64
        next)
    if val err = updated.last_error: return Err(err)
    Ok(true)

pub fn nvfs_global_operation_begin_v1() -> Result<NvfsOperationLeaseV1, NvfsOperationLeaseErrorV1>:
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        next.last_lease = NvfsOperationLeaseV1.invalid_probe()
        if state.active_global_nonce != 0u64:
            next.last_error = Some(NvfsOperationLeaseErrorV1.Busy)
        elif state.next_nonce == 0u64 or state.next_nonce == _NVFS_OPERATION_NONCE_MAX_V1:
            next.last_error = Some(NvfsOperationLeaseErrorV1.CounterExhausted)
        else:
            next.active_global_slot = -2
            next.active_global_nonce = state.next_nonce
            next.next_nonce = state.next_nonce + 1u64
            next.last_lease = NvfsOperationLeaseV1(
                _slot: -2, _generation: 1u32,
                _operation_nonce: state.next_nonce, _outer_instance_id: 0)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_lease)

pub fn nvfs_operation_begin_close_v1(
    binding: NvfsDeviceIdentityBindingV1, outer_instance_id: i64,
    inner_instance_id: i64, region: NvfsDeviceRegionIdentityV1
) -> Result<NvfsOperationCloseFenceV1, NvfsOperationLeaseErrorV1>:
    if nvfs_device_identity_validate_v1(
            binding, outer_instance_id, inner_instance_id, region).is_err():
        return Err(NvfsOperationLeaseErrorV1.StaleBinding)
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        val slot_index = binding.owner_slot_index()
        if slot_index < 0 or slot_index >= state.slots.len():
            next.last_error = Some(NvfsOperationLeaseErrorV1.StaleBinding)
        else:
            val slot = state.slots[slot_index]
            if not _binding_matches_v1(slot, binding, outer_instance_id, inner_instance_id, region):
                next.last_error = Some(NvfsOperationLeaseErrorV1.StaleBinding)
            elif slot.state == NvfsOperationSlotStateV1.Quarantined:
                next.last_error = Some(NvfsOperationLeaseErrorV1.Quarantined)
            elif (slot.state != NvfsOperationSlotStateV1.Active and
                  slot.state != NvfsOperationSlotStateV1.Draining and
                  slot.state != NvfsOperationSlotStateV1.Retryable):
                next.last_error = Some(NvfsOperationLeaseErrorV1.Closing)
            else:
                var draining = slot
                draining.state = NvfsOperationSlotStateV1.Draining
                next.slots[slot_index] = draining
                if slot.active_operation_nonce != 0u64 or state.active_global_nonce != 0u64:
                    next.last_error = Some(NvfsOperationLeaseErrorV1.Busy)
                elif state.next_nonce == 0u64 or state.next_nonce == _NVFS_OPERATION_NONCE_MAX_V1:
                    next.last_error = Some(NvfsOperationLeaseErrorV1.CounterExhausted)
                else:
                    draining.state = NvfsOperationSlotStateV1.Closing
                    draining.close_nonce = state.next_nonce
                    next.slots[slot_index] = draining
                    next.next_nonce = state.next_nonce + 1u64
                    next.last_fence = NvfsOperationCloseFenceV1(
                        _slot: slot_index, _generation: slot.generation,
                        _close_nonce: state.next_nonce,
                        _outer_instance_id: outer_instance_id)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_fence)

fn _close_transition_v1(
    fence: NvfsOperationCloseFenceV1, target: NvfsOperationSlotStateV1
) -> Result<bool, NvfsOperationLeaseErrorV1>:
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        if fence._slot < 0 or fence._slot >= state.slots.len():
            next.last_error = Some(NvfsOperationLeaseErrorV1.Replay)
        else:
            val slot = state.slots[fence._slot]
            if (slot.generation != fence._generation or
                slot.outer_instance_id != fence._outer_instance_id or
                slot.close_nonce != fence._close_nonce or
                fence._close_nonce == 0u64 or
                slot.state != NvfsOperationSlotStateV1.Closing):
                next.last_error = Some(NvfsOperationLeaseErrorV1.Replay)
            else:
                var changed = slot
                changed.state = target
                changed.close_nonce = 0u64
                next.slots[fence._slot] = changed
        next)
    if val err = updated.last_error: return Err(err)
    Ok(true)

pub fn nvfs_operation_close_busy_v1(fence: NvfsOperationCloseFenceV1) -> Result<bool, NvfsOperationLeaseErrorV1>:
    _close_transition_v1(fence, NvfsOperationSlotStateV1.Active)

pub fn nvfs_operation_close_retryable_v1(fence: NvfsOperationCloseFenceV1) -> Result<bool, NvfsOperationLeaseErrorV1>:
    _close_transition_v1(fence, NvfsOperationSlotStateV1.Retryable)

pub fn nvfs_operation_close_complete_v1(fence: NvfsOperationCloseFenceV1) -> Result<bool, NvfsOperationLeaseErrorV1>:
    val transitioned = _close_transition_v1(fence, NvfsOperationSlotStateV1.Free)
    transitioned

pub fn nvfs_operation_close_quarantine_v1(fence: NvfsOperationCloseFenceV1) -> Result<bool, NvfsOperationLeaseErrorV1>:
    val transitioned = _close_transition_v1(fence, NvfsOperationSlotStateV1.Quarantined)
    if transitioned.is_err(): return transitioned
    val _ = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.quarantined_count = state.quarantined_count + 1
        next)
    Ok(true)

pub fn nvfs_operation_force_quarantine_v1(
    binding: NvfsDeviceIdentityBindingV1, outer_instance_id: i64,
    inner_instance_id: i64, region: NvfsDeviceRegionIdentityV1
) -> Result<bool, NvfsOperationLeaseErrorV1>:
    val updated = mutex_with_lock(_nvfs_operation_owner_v1, \state:
        var next = state
        next.last_error = nil
        val slot_index = binding.owner_slot_index()
        if slot_index < 0 or slot_index >= state.slots.len():
            next.last_error = Some(NvfsOperationLeaseErrorV1.StaleBinding)
        else:
            val slot = state.slots[slot_index]
            if not _binding_matches_v1(slot, binding, outer_instance_id, inner_instance_id, region):
                next.last_error = Some(NvfsOperationLeaseErrorV1.StaleBinding)
            elif slot.state == NvfsOperationSlotStateV1.Free:
                next.last_error = Some(NvfsOperationLeaseErrorV1.Replay)
            elif slot.state != NvfsOperationSlotStateV1.Quarantined:
                var quarantined = slot
                quarantined.state = NvfsOperationSlotStateV1.Quarantined
                quarantined.active_operation_nonce = 0u64
                quarantined.close_nonce = 0u64
                next.slots[slot_index] = quarantined
                if state.active_global_slot == slot_index:
                    next.active_global_slot = -1
                    next.active_global_nonce = 0u64
                next.quarantined_count = state.quarantined_count + 1
        next)
    if val err = updated.last_error: return Err(err)
    Ok(true)

pub fn nvfs_operation_quarantined_count_v1() -> i32:
    val state = mutex_with_lock(_nvfs_operation_owner_v1, \state: state)
    state.quarantined_count

export NvfsOperationLeaseV1, NvfsOperationCloseFenceV1
export NvfsOperationLeaseErrorV1
export nvfs_operation_owner_register_v1, nvfs_operation_begin_v1
export nvfs_global_operation_begin_v1
export nvfs_operation_end_v1, nvfs_operation_begin_close_v1
export nvfs_operation_close_busy_v1, nvfs_operation_close_retryable_v1
export nvfs_operation_close_complete_v1, nvfs_operation_close_quarantine_v1
export nvfs_operation_force_quarantine_v1
export nvfs_operation_quarantined_count_v1
