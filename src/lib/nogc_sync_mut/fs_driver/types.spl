# Shared primitive types for the fs_driver layer.
#
# All types are newtype structs or plain structs. No inheritance.
# Opaque handles (Inode, FileHandle, DirHandle) use a single id field;
# callers must not inspect or construct them outside driver code.
#
# Source: doc/05_design/fs_driver_interface.md §2.2, §2.3.


# --- Opaque handles ---

struct Inode:
    """Opaque inode number. Treat as an opaque u64; do not compare across mounts."""
    id: u64

    static fn null() -> Inode:
        Inode(id: 0)

    me fn is_null() -> bool:
        self.id == 0

struct FileHandle:
    """Opaque open-file handle returned by open(); released by close()."""
    id: u64

    static fn null() -> FileHandle:
        FileHandle(id: 0)

    me fn is_null() -> bool:
        self.id == 0

struct DirHandle:
    """Opaque open-directory handle returned by open() on a directory."""
    id: u64

    static fn null() -> DirHandle:
        DirHandle(id: 0)

    me fn is_null() -> bool:
        self.id == 0

# --- Scalar newtypes ---

struct FileMode:
    """POSIX-style permission/mode bits (rwxrwxrwx + suid/sgid/sticky)."""
    bits: u32

    static fn default_file() -> FileMode:
        FileMode(bits: 0o644)

    static fn default_dir() -> FileMode:
        FileMode(bits: 0o755)

struct Offset:
    """Signed byte offset within a file. Negative values are invalid."""
    value: i64

    static fn zero() -> Offset:
        Offset(value: 0)

    me fn is_valid() -> bool:
        self.value >= 0

# --- Compound stat types ---

struct FsStatfs:
    """Filesystem-level statistics returned by statfs().

    total_bytes    — total capacity in bytes.
    free_bytes     — unallocated bytes.
    avail_bytes    — bytes available to unprivileged callers.
    files_total    — total inode slots.
    files_free     — free inode slots.
    block_size     — preferred I/O block size in bytes.
    """
    total_bytes: u64
    free_bytes:  u64
    avail_bytes: u64
    files_total: u64
    files_free:  u64
    block_size:  u32

struct FileStat:
    """Per-file metadata returned by stat() / fstat().

    All timestamps are nanoseconds since Unix epoch (1970-01-01T00:00:00Z).
    """
    inode:         u64
    size:          u64
    blocks:        u64
    block_size:    u32
    mode:          u32
    uid:           u32
    gid:           u32
    nlinks:        u32
    atime_ns:      u64
    mtime_ns:      u64
    ctime_ns:      u64
    birth_time_ns: u64

struct DirEntry:
    """Single entry yielded by readdir()."""
    name:  text
    inode: Inode
    is_dir: bool
    size: i64

struct StatInfo:
    """Simplified stat result with boolean type flags.

    is_dir    — true if the path is a directory.
    is_file   — true if the path is a regular file.
    size      — file size in bytes (0 for directories).
    """
    is_dir:  bool
    is_file: bool
    size:    i64

# --- Mount-time options ---

struct MountOptions:
    """Options negotiated at mount time.

    read_only     — mount as read-only.
    want_caps     — capabilities the caller would like enabled.
    require_caps  — capabilities that must be present (else mount fails).
    """
    read_only:    bool
    want_caps:    u32   # FsCapabilitySet.bits — avoid circular import
    require_caps: u32   # FsCapabilitySet.bits

    static fn default() -> MountOptions:
        MountOptions(read_only: false, want_caps: 0, require_caps: 0)

    static fn read_only() -> MountOptions:
        MountOptions(read_only: true, want_caps: 0, require_caps: 0, noexec: false, allow_untrusted_exec: false)

enum ExecuteTrust:
    Trusted
    Untrusted

struct ExecuteFileObservationV1:
    """Backend-issued facts binding executable reads to one open object."""
    contract_version: u32
    object_identity: u64
    content_generation: u64
    size: u64

enum ArtifactPublicationStateV1:
    """Truthful durability state for an atomic artifact replacement."""
    NotPublished
    Published
    Indeterminate

struct ArtifactPublicationReceiptV1:
    """Filesystem-issued identity for one durably published compiler output.

    `target` is bound evidence supplied as part of the publication request; it
    is never an authorization decision.  Consumers must apply their own target
    policy and must accept this record only when the state is `Published`.
    """
    contract_version: u32
    filesystem_instance: i64
    object_identity: u64
    content_generation: u64
    namespace_generation: i64
    size: u64
    sha256: text
    output_path: text
    target: text

impl ArtifactPublicationReceiptV1:
    fn published_filesystem_instance() -> i64: self.filesystem_instance
    fn published_object_identity() -> u64: self.object_identity
    fn published_content_generation() -> u64: self.content_generation
    fn published_namespace_generation() -> i64: self.namespace_generation
    fn published_size() -> u64: self.size
    fn published_sha256() -> text: self.sha256
    fn published_output_path() -> text: self.output_path
    fn published_target() -> text: self.target

struct ArtifactPublicationOutcomeV1:
    """A failed acknowledgement never collapses into a caller boolean."""
    state: ArtifactPublicationStateV1
    receipt: Option<ArtifactPublicationReceiptV1>
    error_code: text

impl ArtifactPublicationOutcomeV1:
    fn publication_state() -> ArtifactPublicationStateV1: self.state
    fn publication_receipt() -> Option<ArtifactPublicationReceiptV1>: self.receipt
    fn publication_error_code() -> text: self.error_code

struct ArtifactBundleObjectReceiptV1:
    """One object covered by an atomic three-object artifact publication."""
    object_identity: u64
    content_generation: u64
    size: u64
    sha256: text
    path: text

impl ArtifactBundleObjectReceiptV1:
    fn published_object_identity() -> u64: self.object_identity
    fn published_content_generation() -> u64: self.content_generation
    fn published_size() -> u64: self.size
    fn published_sha256() -> text: self.sha256
    fn published_path() -> text: self.path

struct ArtifactBundlePublicationReceiptV1:
    """Filesystem proof that payload, SCR2, and SBE2 share one root commit."""
    contract_version: u32
    filesystem_instance: i64
    namespace_generation: i64
    bundle_identity: text
    target: text
    payload: ArtifactBundleObjectReceiptV1
    scr2_receipt: ArtifactBundleObjectReceiptV1
    sbe2_policy: ArtifactBundleObjectReceiptV1

impl ArtifactBundlePublicationReceiptV1:
    fn published_filesystem_instance() -> i64: self.filesystem_instance
    fn published_namespace_generation() -> i64: self.namespace_generation
    fn published_bundle_identity() -> text: self.bundle_identity
    fn published_target() -> text: self.target
    fn published_payload() -> ArtifactBundleObjectReceiptV1: self.payload
    fn published_scr2_receipt() -> ArtifactBundleObjectReceiptV1: self.scr2_receipt
    fn published_sbe2_policy() -> ArtifactBundleObjectReceiptV1: self.sbe2_policy

struct ArtifactBundlePublicationOutcomeV1:
    state: ArtifactPublicationStateV1
    receipt: Option<ArtifactBundlePublicationReceiptV1>
    error_code: text

impl ArtifactBundlePublicationOutcomeV1:
    fn publication_state() -> ArtifactPublicationStateV1: self.state
    fn publication_receipt() -> Option<ArtifactBundlePublicationReceiptV1>: self.receipt
    fn publication_error_code() -> text: self.error_code

# --- OpenFlags bitmask ---

struct OpenFlags:
    """Flags for open(). Combine with bitwise OR via with_*() helpers."""
    bits: u32

impl OpenFlags:
    static fn read_only() -> OpenFlags:
        OpenFlags(bits: 0)

    static fn write_only() -> OpenFlags:
        OpenFlags(bits: 1)

    static fn read_write() -> OpenFlags:
        OpenFlags(bits: 2)

    me fn with_create() -> OpenFlags:
        OpenFlags(bits: self.bits | 64)

    me fn with_excl() -> OpenFlags:
        OpenFlags(bits: self.bits | 128)

    me fn with_trunc() -> OpenFlags:
        OpenFlags(bits: self.bits | 512)

    me fn with_append() -> OpenFlags:
        OpenFlags(bits: self.bits | 1024)

    static fn create_write() -> OpenFlags:
        OpenFlags(bits: 2 | 64)   # read_write | O_CREAT

    me fn is_writable() -> bool:
        (self.bits & 3) != 0

# --- Path newtype ---

struct Path:
    """UTF-8 filesystem path. Absolute paths start with '/'.

    Drivers receive Path; they do not interpret host OS path conventions.
    """
    raw: text

    static fn root() -> Path:
        Path(raw: "/")

    me fn is_absolute() -> bool:
        _text_has_prefix(self.raw, "/")

    me fn len() -> i64:
        self.raw.len()

    me fn starts_with(prefix: Path) -> bool:
        _text_has_prefix(self.raw, prefix.raw)

fn _text_has_prefix(source: text, prefix: text) -> bool:
    source.starts_with(prefix)
