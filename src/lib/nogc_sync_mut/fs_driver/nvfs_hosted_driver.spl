"""
# NVFS Hosted Driver

Neutral hosted NVFS mount-table driver facade. The current implementation is
the existing POSIX-compatible hosted adapter, but SimpleOS lower layers import
this hosted boundary instead of the POSIX-named module.
"""

export use nogc_sync_mut.fs_driver.nvfs_posix_driver.{NvfsPosixDriver as NvfsHostedDriver}
use nogc_sync_mut.fs_driver.nvfs_posix_driver.{
    nvfs_posix_read_owned, nvfs_posix_write_owned
}
use nogc_sync_mut.fs_driver.types.{FileHandle}
use nogc_sync_mut.fs_driver.error.{FsError}

fn nvfs_hosted_read_owned(driver: NvfsHostedDriver, handle: FileHandle, offset: i64, buf: [u8]) -> (NvfsHostedDriver, Result<i64, FsError>):
    nvfs_posix_read_owned(driver, handle, offset, buf)

fn nvfs_hosted_write_owned(driver: NvfsHostedDriver, handle: FileHandle, offset: i64, buf: [u8]) -> (NvfsHostedDriver, Result<i64, FsError>):
    nvfs_posix_write_owned(driver, handle, offset, buf)
