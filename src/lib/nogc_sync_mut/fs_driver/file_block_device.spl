# Host file-backed implementation of the shared BlockDevice trait.
#
# FileBlockDevice values are opaque handles into this module's bounded owner
# table.  The table, rather than any value copy passed through BlockDevice,
# owns the live FileHandle and its flush/close state. The table belongs to one
# hosted image-construction execution domain and is deliberately not a
# cross-thread transport; callers must serialize access through that owner.
# The retained FileHandle operations used here have Rust/interpreter and hosted
# native-C `rt_io_file_*` support. This adapter does not claim freestanding or
# SimpleOS-kernel provider parity.

use std.fs_driver.block_device.{BlockDevice}
use std.io.file.{FileHandle}
use std.io.types.{FileMode, SeekFrom}

val FILE_BLOCK_DEVICE_OWNER_CAPACITY: i64 = 64
val FILE_BLOCK_DEVICE_MAX_SECTOR_SIZE: u32 = 1048576u32
val FILE_BLOCK_DEVICE_CREATE_CHUNK_BYTES: u64 = 1048576u64
val FILE_BLOCK_DEVICE_MAX_BYTES: u64 = 9223372036854775807u64

var _file_bd_next_id: i64 = 1
var _file_bd_next_token: u64 = 0x9e3779b97f4a7c15u64
var _file_bd_ids: [i64] = []
var _file_bd_generations: [u64] = []
var _file_bd_tokens: [u64] = []
var _file_bd_handles: [FileHandle] = []
var _file_bd_sector_sizes: [u32] = []
var _file_bd_sector_counts: [u64] = []
var _file_bd_open: [bool] = []
var _file_bd_dirty: [bool] = []

fn _file_bd_validate_geometry(sector_count: u64, sector_size: u32) -> Result<u64, text>:
    if sector_size == 0u32:
        return Err("FileBlockDevice: sector size must be non-zero")
    if sector_size > FILE_BLOCK_DEVICE_MAX_SECTOR_SIZE:
        return Err("FileBlockDevice: sector size exceeds bounded host adapter limit")
    if sector_count == 0u64:
        return Err("FileBlockDevice: sector count must be non-zero")
    val sector_bytes = sector_size.to_u64()
    if sector_count > FILE_BLOCK_DEVICE_MAX_BYTES / sector_bytes:
        return Err("FileBlockDevice: image byte length exceeds host seek range")
    Ok(sector_count * sector_bytes)

fn _file_bd_find(inst_id: i64) -> i64:
    var i: i64 = 0
    while i < _file_bd_ids.len():
        if _file_bd_ids[i] == inst_id:
            return i
        i = i + 1
    -1

fn _file_bd_allocate_id() -> Result<i64, text>:
    if _file_bd_next_id <= 0:
        return Err("FileBlockDevice: instance identifier space exhausted")
    val inst_id = _file_bd_next_id
    if _file_bd_next_id == 9223372036854775807:
        _file_bd_next_id = -1
    else:
        _file_bd_next_id = _file_bd_next_id + 1
    Ok(inst_id)

class FileBlockDeviceRegistration:
    inst_id: i64
    generation: u64
    token: u64

class FileBlockDeviceAuthority:
    inst_id: i64
    generation: u64
    token: u64

fn _file_bd_next_owner_token(inst_id: i64) -> Result<u64, text>:
    _ = inst_id
    if _file_bd_next_token == 0xffffffffffffffffu64:
        return Err("FileBlockDevice: owner token space exhausted")
    _file_bd_next_token = _file_bd_next_token + 1u64
    val token = _file_bd_next_token
    if token == 0u64: return Err("FileBlockDevice: invalid owner token")
    Ok(token)

fn _file_bd_register(handle: FileHandle, sector_count: u64,
    sector_size: u32) -> Result<FileBlockDeviceRegistration, text>:
    var owned_handle = handle
    val inst_id = match _file_bd_allocate_id():
        case Ok(value): value
        case Err(message):
            val _ = owned_handle.close()
            return Err(message)
    val token = match _file_bd_next_owner_token(inst_id):
        case Ok(value): value
        case Err(message):
            val _ = owned_handle.close()
            return Err(message)
    var slot: i64 = -1
    var i: i64 = 0
    while i < _file_bd_open.len():
        # A closed slot at max generation is permanently retired. Continue
        # scanning so it cannot starve later reusable slots or fresh capacity.
        if not _file_bd_open[i] and
            _file_bd_generations[i] != 0xffffffffffffffffu64:
            slot = i
            break
        i = i + 1

    if slot < 0:
        if _file_bd_ids.len() >= FILE_BLOCK_DEVICE_OWNER_CAPACITY:
            val close_result = owned_handle.close()
            if close_result.is_err():
                return Err("FileBlockDevice: owner table full and retained handle close failed")
            return Err("FileBlockDevice: bounded owner table is full")
        slot = _file_bd_ids.len()
        _file_bd_ids.push(inst_id)
        _file_bd_generations.push(1u64)
        _file_bd_tokens.push(token)
        _file_bd_handles.push(owned_handle)
        _file_bd_sector_sizes.push(sector_size)
        _file_bd_sector_counts.push(sector_count)
        _file_bd_open.push(true)
        _file_bd_dirty.push(false)
    else:
        _file_bd_ids[slot] = inst_id
        _file_bd_generations[slot] = _file_bd_generations[slot] + 1u64
        _file_bd_tokens[slot] = token
        _file_bd_handles[slot] = owned_handle
        _file_bd_sector_sizes[slot] = sector_size
        _file_bd_sector_counts[slot] = sector_count
        _file_bd_open[slot] = true
        _file_bd_dirty[slot] = false
    Ok(FileBlockDeviceRegistration(
        inst_id: inst_id, generation: _file_bd_generations[slot], token: token))

fn _file_bd_live_slot(inst_id: i64, generation: u64, token: u64) -> Result<i64, text>:
    val slot = _file_bd_find(inst_id)
    if slot < 0 or not _file_bd_open[slot] or generation == 0u64 or token == 0u64 or
        _file_bd_generations[slot] != generation or _file_bd_tokens[slot] != token:
        return Err("FileBlockDevice: device is closed or unknown")
    Ok(slot)

fn _file_bd_exact_offset(slot: i64, lba: u64) -> Result<i64, text>:
    if lba >= _file_bd_sector_counts[slot]:
        return Err("FileBlockDevice: sector LBA is out of range")
    # Geometry admission proves this multiplication is <= i64::MAX.
    val offset = lba * _file_bd_sector_sizes[slot].to_u64()
    Ok(offset.to_i64())

fn _file_bd_zero_bytes(byte_count: i64) -> [u8]:
    var bytes: [u8] = []
    var i: i64 = 0
    while i < byte_count:
        bytes.push(0u8)
        i = i + 1
    bytes

fn _file_bd_close_handle(slot: i64) -> Result<bool, text>:
    var handle = _file_bd_handles[slot]
    match handle.close():
        case Err(error):
            _file_bd_handles[slot] = handle
            # FileHandle.close consumes its native close attempt even when the
            # provider reports failure. Quarantine the slot instead of issuing
            # a second close against a handle whose ownership is indeterminate.
            _file_bd_open[slot] = false
            return Err("FileBlockDevice: close failed: " + error.message)
        case Ok(_):
            _file_bd_handles[slot] = handle
            _file_bd_open[slot] = false
            Ok(true)

pub class FileBlockDevice:
    _authority: FileBlockDeviceAuthority

impl FileBlockDevice:
    static fn open(path: text, sector_size: u32) -> Result<FileBlockDevice, text>:
        if sector_size == 0u32 or sector_size > FILE_BLOCK_DEVICE_MAX_SECTOR_SIZE:
            return Err("FileBlockDevice.open: invalid or unsupported sector size")
        var handle = match FileHandle.open(path, FileMode.ReadWrite):
            case Err(error): return Err("FileBlockDevice.open: " + error.message)
            case Ok(opened): opened
        val byte_len = match handle.size():
            case Err(error):
                val _ = handle.close()
                return Err("FileBlockDevice.open: size failed: " + error.message)
            case Ok(size): size
        if byte_len <= 0 or byte_len % sector_size.to_i64() != 0:
            val _ = handle.close()
            return Err("FileBlockDevice.open: image is empty or not a whole number of sectors")
        val sector_count = (byte_len / sector_size.to_i64()).to_u64()
        _file_bd_validate_geometry(sector_count, sector_size)?
        val registered = _file_bd_register(handle, sector_count, sector_size)
        match registered:
            case Err(message):
                # Registration receives ownership of the retained handle.
                # Never close the caller-side value copy after transfer.
                Err(message)
            case Ok(registration):
                Ok(FileBlockDevice(
                    _authority: FileBlockDeviceAuthority(
                        inst_id: registration.inst_id,
                        generation: registration.generation,
                        token: registration.token)))

    static fn create(path: text, sector_count: u64, sector_size: u32) -> Result<FileBlockDevice, text>:
        val total_bytes = _file_bd_validate_geometry(sector_count, sector_size)?
        var handle = match FileHandle.create_read_write_no_follow(path):
            case Err(error): return Err("FileBlockDevice.create: " + error.message)
            case Ok(opened): opened

        # Keep allocation bounded while avoiding one host dispatch per sector.
        val sector_bytes = sector_size.to_u64()
        val sectors_per_chunk = FILE_BLOCK_DEVICE_CREATE_CHUNK_BYTES / sector_bytes
        val chunk_bytes = sectors_per_chunk * sector_bytes
        val zero_chunk = _file_bd_zero_bytes(chunk_bytes.to_i64())

        var remaining = total_bytes
        while remaining > 0u64:
            val write_bytes = if remaining < chunk_bytes: remaining else: chunk_bytes
            val zero_bytes = if write_bytes == chunk_bytes:
                zero_chunk
            else:
                _file_bd_zero_bytes(write_bytes.to_i64())
            match handle.write_all(zero_bytes):
                case Err(error):
                    val _ = handle.close()
                    return Err("FileBlockDevice.create: exact image write failed: " + error.message)
                case Ok(_): ()
            remaining = remaining - write_bytes
        match handle.flush():
            case Err(error):
                val _ = handle.close()
                return Err("FileBlockDevice.create: initial flush failed: " + error.message)
            case Ok(_): ()
        # Register the exact retained handle used to create and size the image.
        # Never close and reopen `path`: that would permit pathname substitution
        # between creation and owner-table admission.
        val registered = _file_bd_register(handle, sector_count, sector_size)
        match registered:
            case Err(message):
                # Registration receives ownership of the retained handle.
                Err(message)
            case Ok(registration):
                Ok(FileBlockDevice(_authority: FileBlockDeviceAuthority(
                    inst_id: registration.inst_id,
                    generation: registration.generation,
                    token: registration.token)))

    fn sector_count() -> u64:
        val slot = _file_bd_live_slot(
            self._authority.inst_id, self._authority.generation, self._authority.token)
        if slot.is_err(): return 0u64
        _file_bd_sector_counts[slot.unwrap()]

    fn is_open() -> bool:
        _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token).is_ok()

    fn has_unflushed_writes() -> bool:
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)
        slot.is_ok() and _file_bd_dirty[slot.unwrap()]

    me fn close() -> Result<bool, text>:
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)?
        if _file_bd_dirty[slot]:
            return Err("FileBlockDevice.close: unflushed writes require flush or flush_and_close")
        _file_bd_close_handle(slot)

    me fn flush_and_close() -> Result<bool, text>:
        self.flush()?
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)?
        _file_bd_close_handle(slot)

impl BlockDevice for FileBlockDevice:
    fn read_sector(lba: u64) -> Result<[u8], text>:
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)?
        val offset = _file_bd_exact_offset(slot, lba)?
        var handle = _file_bd_handles[slot]
        val positioned = match handle.seek(SeekFrom.Start(offset)):
            case Err(error):
                _file_bd_handles[slot] = handle
                return Err("FileBlockDevice.read_sector: seek failed: " + error.message)
            case Ok(position): position
        if positioned != offset:
            _file_bd_handles[slot] = handle
            return Err("FileBlockDevice.read_sector: seek returned a short position")
        val sector_bytes = _file_bd_sector_sizes[slot].to_i64()
        val read_result = handle.read_exact(sector_bytes)
        _file_bd_handles[slot] = handle
        match read_result:
            case Err(error): Err("FileBlockDevice.read_sector: exact read failed: " + error.message)
            case Ok(bytes):
                if bytes.len() != sector_bytes:
                    return Err("FileBlockDevice.read_sector: short sector read")
                Ok(bytes)

    me fn write_sector(lba: u64, data: [u8]) -> Result<bool, text>:
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)?
        val sector_bytes = _file_bd_sector_sizes[slot].to_i64()
        if data.len() != sector_bytes:
            return Err("FileBlockDevice.write_sector: data must contain exactly one sector")
        val offset = _file_bd_exact_offset(slot, lba)?
        var handle = _file_bd_handles[slot]
        val positioned = match handle.seek(SeekFrom.Start(offset)):
            case Err(error):
                _file_bd_handles[slot] = handle
                return Err("FileBlockDevice.write_sector: seek failed: " + error.message)
            case Ok(position): position
        if positioned != offset:
            _file_bd_handles[slot] = handle
            return Err("FileBlockDevice.write_sector: seek returned a short position")
        # A failed write_all may have changed an unknown prefix. Conservatively
        # retain dirty state from before the provider call until flush proves a
        # durability boundary; close may not silently discard that state.
        _file_bd_dirty[slot] = true
        match handle.write_all(data):
            case Err(error):
                _file_bd_handles[slot] = handle
                Err("FileBlockDevice.write_sector: exact write failed: " + error.message)
            case Ok(_):
                _file_bd_handles[slot] = handle
                Ok(true)

    fn sector_size() -> u32:
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)
        if slot.is_err(): return 0u32
        _file_bd_sector_sizes[slot.unwrap()]

    me fn flush() -> Result<bool, text>:
        val slot = _file_bd_live_slot(self._authority.inst_id,
            self._authority.generation, self._authority.token)?
        var handle = _file_bd_handles[slot]
        match handle.flush():
            case Err(error):
                _file_bd_handles[slot] = handle
                Err("FileBlockDevice.flush: " + error.message)
            case Ok(_):
                _file_bd_handles[slot] = handle
                _file_bd_dirty[slot] = false
                Ok(true)

export FileBlockDevice
