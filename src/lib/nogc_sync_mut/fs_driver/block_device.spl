# stdlib-local FAT32 block device trait.
#
# Kept under fs_driver so the FAT32 port does not depend on os.services.

pub trait BlockDevice:
    """Sector I/O plus an optional device-owned durability boundary.

    `flush` is deliberately not inferred from successful writes. A backend may
    promote DurableSync only after its concrete device owner acknowledges the
    ordering boundary.
    """
    fn read_sector(lba: u64) -> Result<[u8], text>
    fn write_sector(lba: u64, data: [u8]) -> Result<bool, text>
    fn sector_size() -> u32
    # A zero value means this device cannot safely host an NVFS mirror.
    fn sector_count() -> u64:
        0u64
    # Stable across copies and re-registration of the same device. Providers
    # must use fs_block_device_owner_new_identity() to mint monotonic IDs:
    # registration admits only IDs above the highest previously admitted ID,
    # so an older unused ID also rejects fail-closed. Zero is unavailable.
    fn mirror_identity() -> u64:
        0u64
    fn flush() -> Result<bool, text>:
        Err("block device does not support durable flush")

# Narrow owner seam for a future device adapter. This is intentionally separate
# from BlockDevice: no current stdlib backend implements it, so no backend can
# advertise Capability.DurableSync by merely counting WAL or cache operations.
pub trait BlockDeviceDurabilityPortV1:
    fn flush_ordered() -> Result<bool, text>:
        Err("durability owner unavailable: no acknowledged device flush")
    fn fua_ordered() -> Result<bool, text>:
        Err("durability owner unavailable: no acknowledged FUA boundary")
