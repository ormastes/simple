# Stdlib-owned NVFS arena fixture surface.
#
# This keeps raw arena and BlockDevice-backed tests on std filesystem backend
# contracts instead of importing the example NVFS package. It intentionally
# covers the core arena verbs used by production-facing tests; richer
# compression/dedup/example policy remains outside this std boundary.

use std.fs_driver.block_device.{BlockDevice}
use std.fs_driver.block_device_owner.{
    fs_block_device_owner_set, fs_block_device_owner_ready,
    fs_block_device_owner_sector_size, fs_block_device_owner_read,
    fs_block_device_owner_write, fs_block_device_owner_flush_acknowledged
}
use std.fs_driver.bytes_util.{alloc_zeroed_bytes}

struct NvfsArenaMeta:
    arena_id: i64
    class_tag: i32
    hint_bytes: i64
    sealed: bool
    discarded: bool
    total_bytes: i64

var _nvfs_arena_ids: [i64] = []
var _nvfs_arena_metas: [NvfsArenaMeta] = []
var _nvfs_arena_bufs: [[u8]] = []
var _nvfs_arena_backend_kind: [i32] = []
var _nvfs_arena_base_blocks: [i64] = []
var _nvfs_arena_block_counts: [i64] = []
var _nvfs_arena_commit_sequences: [u64] = []
var _nvfs_arena_next_id: i64 = 1

val NVFS_ARENA_HEADER_MAGIC: u32 = 0x4E564132u32
val NVFS_ARENA_HEADER_VERSION: u32 = 1u32
val NVFS_ARENA_HEADER_SLOT_BYTES: i64 = 32
val NVFS_ARENA_MAX_SEQUENCE: u64 = 0xFFFFFFFFFFFFFFFFu64
val NVFS_ARENA_MAX_I64: i64 = 0x7FFFFFFFFFFFFFFF

fn nvfs_arena_set_block_device(dev: BlockDevice):
    fs_block_device_owner_set(dev)

fn nvfs_arena_has_block_device() -> bool:
    fs_block_device_owner_ready()

fn _nvfs_arena_find_idx(arena_id: i64) -> i64:
    var i: i64 = 0
    while i < _nvfs_arena_ids.len() as i64:
        if _nvfs_arena_ids[i as i32] == arena_id:
            return i
        i = i + 1
    -1

fn _nvfs_arena_is_nvme(idx: i64) -> bool:
    if idx < 0 or idx >= _nvfs_arena_backend_kind.len() as i64:
        return false
    _nvfs_arena_backend_kind[idx as i32] == 1

fn _nvfs_arena_sector_size() -> i64:
    if not fs_block_device_owner_ready():
        return 512
    fs_block_device_owner_sector_size() as i64

fn _nvfs_arena_capacity(block_count: i64, sector_size: i64) -> i64:
    if block_count < 2 or sector_size <= 0:
        return -1
    val data_blocks = block_count - 1
    if data_blocks > NVFS_ARENA_MAX_I64 / sector_size:
        return -1
    data_blocks * sector_size

fn _nvfs_arena_data_lba(base_block: i64, byte_offset: i64, sector_size: i64) -> u64:
    val data_start = base_block + 1
    val sector_idx = byte_offset / sector_size
    (data_start + sector_idx) as u64

fn nvfs_raw_read_sector(lba: u64) -> [u8]:
    val r = fs_block_device_owner_read(lba)
    match r:
        Ok(bytes):
            bytes
        Err(_):
            []

fn nvfs_raw_write_sector(lba: u64, data: [u8]) -> bool:
    val r = fs_block_device_owner_write(lba, data)
    match r:
        Ok(written): written
        Err(_): false

fn _nvfs_arena_append_nvme(idx: i64, data: [u8], total_so_far: i64) -> i64:
    val base = _nvfs_arena_base_blocks[idx as i32]
    val block_count = _nvfs_arena_block_counts[idx as i32]
    val sector_size = _nvfs_arena_sector_size()
    val max_data = _nvfs_arena_capacity(block_count, sector_size)
    val n = data.len() as i64
    if max_data < 0 or total_so_far < 0 or total_so_far > max_data or n > max_data - total_so_far:
        return -1

    var src_idx: i64 = 0
    while src_idx < n:
        val sector_off = (total_so_far + src_idx) / sector_size
        val intra = (total_so_far + src_idx) - sector_off * sector_size
        val lba = _nvfs_arena_data_lba(base, sector_off * sector_size, sector_size)
        var sec_buf = match fs_block_device_owner_read(lba):
            Ok(bytes): bytes
            Err(_): return -1
        if sec_buf.len() as i64 != sector_size:
            return -1
        var pos = intra
        while pos < sector_size and src_idx < n:
            sec_buf[pos as i32] = data[src_idx as i32]
            pos = pos + 1
            src_idx = src_idx + 1
        if not nvfs_raw_write_sector(lba, sec_buf):
            return -1
    n

fn _nvfs_arena_read_nvme(idx: i64, off: i64, length: i64) -> [u8]:
    val base = _nvfs_arena_base_blocks[idx as i32]
    val sector_size = _nvfs_arena_sector_size()
    val meta = _nvfs_arena_metas[idx as i32]
    val avail = meta.total_bytes - off
    if avail <= 0:
        return []
    val to_read = if length < avail: length else: avail
    var out: [u8] = []
    var dst: i64 = 0
    while dst < to_read:
        val sector_off = (off + dst) / sector_size
        val intra = (off + dst) - sector_off * sector_size
        val lba = _nvfs_arena_data_lba(base, sector_off * sector_size, sector_size)
        val sec_buf = nvfs_raw_read_sector(lba)
        if sec_buf.len() as i64 != sector_size:
            return []
        var pos = intra
        while pos < sector_size and dst < to_read:
            out.push(sec_buf[pos as i32])
            pos = pos + 1
            dst = dst + 1
    out

fn arena_create_impl(class_tag: i32, hint_bytes: i64) -> i64:
    if _nvfs_arena_next_id <= 0 or _nvfs_arena_next_id == 0x7FFFFFFFFFFFFFFF:
        return -1
    val arena_id = _nvfs_arena_next_id
    _nvfs_arena_next_id = _nvfs_arena_next_id + 1
    _nvfs_arena_ids.push(arena_id)
    _nvfs_arena_metas.push(NvfsArenaMeta(
        arena_id: arena_id,
        class_tag: class_tag,
        hint_bytes: hint_bytes,
        sealed: false,
        discarded: false,
        total_bytes: 0
    ))
    _nvfs_arena_bufs.push([])
    _nvfs_arena_backend_kind.push(0)
    _nvfs_arena_base_blocks.push(-1)
    _nvfs_arena_block_counts.push(0)
    _nvfs_arena_commit_sequences.push(0u64)
    arena_id

fn arena_create_nvme_impl(class_tag: i32, hint_bytes: i64, base_block: i64, block_count: i64) -> i64:
    if not fs_block_device_owner_ready():
        return -1
    if base_block < 0 or block_count < 2 or block_count > NVFS_ARENA_MAX_I64 - base_block:
        return -1
    if _nvfs_arena_capacity(block_count, _nvfs_arena_sector_size()) < 0:
        return -1
    val arena_id = arena_create_impl(class_tag, hint_bytes)
    val idx = _nvfs_arena_find_idx(arena_id)
    _nvfs_arena_backend_kind[idx as i32] = 1
    _nvfs_arena_base_blocks[idx as i32] = base_block
    _nvfs_arena_block_counts[idx as i32] = block_count
    arena_id

fn arena_append_impl(arena_id: i64, data: [u8], durability_tag: i32) -> i64:
    val _durability_tag = durability_tag
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return -1
    val meta = _nvfs_arena_metas[idx as i32]
    if meta.discarded:
        return -3
    if meta.sealed:
        return -2

    var written = data.len() as i64
    if _nvfs_arena_is_nvme(idx):
        written = _nvfs_arena_append_nvme(idx, data, meta.total_bytes)
        if written < 0:
            return -1
    else:
        var buf = _nvfs_arena_bufs[idx as i32]
        for byte in data:
            buf.push(byte)
        _nvfs_arena_bufs[idx as i32] = buf

    _nvfs_arena_metas[idx as i32] = NvfsArenaMeta(
        arena_id: meta.arena_id,
        class_tag: meta.class_tag,
        hint_bytes: meta.hint_bytes,
        sealed: meta.sealed,
        discarded: meta.discarded,
        total_bytes: meta.total_bytes + written
    )
    written

fn arena_readv_impl(arena_id: i64, off: i64, buf_len: i64) -> [u8]:
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return []
    val meta = _nvfs_arena_metas[idx as i32]
    if meta.discarded or off < 0 or buf_len < 0:
        return []
    if _nvfs_arena_is_nvme(idx):
        return _nvfs_arena_read_nvme(idx, off, buf_len)
    val src = _nvfs_arena_bufs[idx as i32]
    val src_len = src.len() as i64
    if off < 0 or off >= src_len:
        return []
    var end = src_len
    if buf_len <= src_len - off:
        end = off + buf_len
    var out: [u8] = []
    var i = off
    while i < end:
        out.push(src[i as i32])
        i = i + 1
    out

fn arena_seal_impl(arena_id: i64, generation: i64) -> bool:
    val _generation = generation
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return false
    val meta = _nvfs_arena_metas[idx as i32]
    if meta.discarded:
        return false
    _nvfs_arena_metas[idx as i32] = NvfsArenaMeta(
        arena_id: meta.arena_id,
        class_tag: meta.class_tag,
        hint_bytes: meta.hint_bytes,
        sealed: true,
        discarded: meta.discarded,
        total_bytes: meta.total_bytes
    )
    true

fn arena_discard_impl(arena_id: i64) -> bool:
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return false
    val meta = _nvfs_arena_metas[idx as i32]
    _nvfs_arena_metas[idx as i32] = NvfsArenaMeta(
        arena_id: meta.arena_id,
        class_tag: meta.class_tag,
        hint_bytes: meta.hint_bytes,
        sealed: meta.sealed,
        discarded: true,
        total_bytes: meta.total_bytes
    )
    _nvfs_arena_bufs[idx as i32] = []
    true

fn arena_clone_range_impl(src: i64, src_off: i64, dst: i64, dst_off: i64, len: i64) -> i64:
    val _dst_off = dst_off
    val src_idx = _nvfs_arena_find_idx(src)
    val dst_idx = _nvfs_arena_find_idx(dst)
    if src_idx < 0 or dst_idx < 0:
        return -1
    val src_meta = _nvfs_arena_metas[src_idx as i32]
    val dst_meta = _nvfs_arena_metas[dst_idx as i32]
    if src_meta.discarded or dst_meta.discarded:
        return -3
    if dst_meta.sealed:
        return -2
    if src_off < 0 or len < 0 or src_off > src_meta.total_bytes or len > src_meta.total_bytes - src_off:
        return -4
    val data = arena_readv_impl(src, src_off, len)
    if data.len() as i64 != len:
        return -4
    arena_append_impl(dst, data, 0)

fn arena_preferred_granule_impl(arena_id: i64) -> i64:
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return -1
    _nvfs_arena_sector_size()

fn arena_total_bytes_impl(arena_id: i64) -> i64:
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return -1
    val meta = _nvfs_arena_metas[idx as i32]
    if meta.discarded:
        return -1
    meta.total_bytes

fn arena_is_sealed_impl(arena_id: i64) -> bool:
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0:
        return false
    _nvfs_arena_metas[idx as i32].sealed

# --- Durability and restart reconstruction ---------------------------------
#
# The reserved header sector contains two independently checksummed commit
# slots.  fsync first flushes data, writes the next slot while retaining the
# previous slot, then flushes metadata.  Recovery chooses the highest valid
# sequence.  A torn newest slot therefore falls back to the prior commit; an
# unacknowledged device flush never becomes a successful durability claim.

struct NvfsArenaCommitRecord:
    valid: bool
    sequence: u64
    total_bytes: i64

fn _nvfs_header_get_u32(buf: [u8], off: i64) -> u32:
    (buf[off] as u32) |
        ((buf[off + 1] as u32) << 8) |
        ((buf[off + 2] as u32) << 16) |
        ((buf[off + 3] as u32) << 24)

fn _nvfs_header_get_u64(buf: [u8], off: i64) -> u64:
    (_nvfs_header_get_u32(buf, off) as u64) |
        ((_nvfs_header_get_u32(buf, off + 4) as u64) << 32)

fn _nvfs_header_put_u32(buf: [u8], off: i64, value: u32) -> [u8]:
    var out = buf
    out[off] = (value & 0xFFu32) as u8
    out[off + 1] = ((value >> 8) & 0xFFu32) as u8
    out[off + 2] = ((value >> 16) & 0xFFu32) as u8
    out[off + 3] = ((value >> 24) & 0xFFu32) as u8
    out

fn _nvfs_header_put_u64(buf: [u8], off: i64, value: u64) -> [u8]:
    var out = _nvfs_header_put_u32(buf, off, (value & 0xFFFFFFFFu64) as u32)
    out = _nvfs_header_put_u32(out, off + 4, ((value >> 32) & 0xFFFFFFFFu64) as u32)
    out

fn _nvfs_header_checksum(sequence: u64, total_bytes: i64) -> u32:
    var hash: u32 = 2166136261u32
    var value = sequence
    var i: i32 = 0
    while i < 8:
        hash = ((((hash ^ ((value & 0xFFu64) as u32)) as u64) * 16777619u64) & 0xFFFFFFFFu64) as u32
        value = value >> 8
        i = i + 1
    value = total_bytes as u64
    i = 0
    while i < 8:
        hash = ((((hash ^ ((value & 0xFFu64) as u32)) as u64) * 16777619u64) & 0xFFFFFFFFu64) as u32
        value = value >> 8
        i = i + 1
    hash ^ NVFS_ARENA_HEADER_MAGIC ^ NVFS_ARENA_HEADER_VERSION

fn _nvfs_header_record(buf: [u8], off: i64) -> NvfsArenaCommitRecord:
    if off < 0 or off + 28 > buf.len() as i64:
        return NvfsArenaCommitRecord(valid: false, sequence: 0u64, total_bytes: -1)
    if _nvfs_header_get_u32(buf, off) != NVFS_ARENA_HEADER_MAGIC or
        _nvfs_header_get_u32(buf, off + 4) != NVFS_ARENA_HEADER_VERSION:
        return NvfsArenaCommitRecord(valid: false, sequence: 0u64, total_bytes: -1)
    val sequence = _nvfs_header_get_u64(buf, off + 8)
    val total_u64 = _nvfs_header_get_u64(buf, off + 16)
    if sequence == 0u64 or total_u64 > 0x7FFFFFFFFFFFFFFFu64:
        return NvfsArenaCommitRecord(valid: false, sequence: 0u64, total_bytes: -1)
    val total = total_u64 as i64
    val stored = _nvfs_header_get_u32(buf, off + 24)
    if stored != _nvfs_header_checksum(sequence, total):
        return NvfsArenaCommitRecord(valid: false, sequence: 0u64, total_bytes: -1)
    NvfsArenaCommitRecord(valid: true, sequence: sequence, total_bytes: total)

fn _nvfs_best_header_record(buf: [u8]) -> NvfsArenaCommitRecord:
    val a = _nvfs_header_record(buf, 0)
    val b = _nvfs_header_record(buf, NVFS_ARENA_HEADER_SLOT_BYTES)
    if a.valid and b.valid:
        if b.sequence > a.sequence:
            return b
        return a
    if a.valid:
        return a
    if b.valid:
        return b
    NvfsArenaCommitRecord(valid: false, sequence: 0u64, total_bytes: -1)

fn _nvfs_write_header_record(buf: [u8], off: i64, sequence: u64, total_bytes: i64) -> [u8]:
    var out = _nvfs_header_put_u32(buf, off, NVFS_ARENA_HEADER_MAGIC)
    out = _nvfs_header_put_u32(out, off + 4, NVFS_ARENA_HEADER_VERSION)
    out = _nvfs_header_put_u64(out, off + 8, sequence)
    out = _nvfs_header_put_u64(out, off + 16, total_bytes as u64)
    out = _nvfs_header_put_u32(out, off + 24, _nvfs_header_checksum(sequence, total_bytes))
    out = _nvfs_header_put_u32(out, off + 28, 0u32)
    out

fn arena_fsync_impl(arena_id: i64) -> bool:
    val idx = _nvfs_arena_find_idx(arena_id)
    if idx < 0 or not _nvfs_arena_is_nvme(idx):
        return false
    val meta = _nvfs_arena_metas[idx as i32]
    val base = _nvfs_arena_base_blocks[idx as i32]
    val blocks = _nvfs_arena_block_counts[idx as i32]
    val sector_size = _nvfs_arena_sector_size()
    if meta.discarded or base < 0 or blocks < 2 or sector_size < 64:
        return false
    val max_data = _nvfs_arena_capacity(blocks, sector_size)
    if max_data < 0 or meta.total_bytes < 0 or meta.total_bytes > max_data:
        return false
    val current_sequence = _nvfs_arena_commit_sequences[idx as i32]
    if current_sequence == NVFS_ARENA_MAX_SEQUENCE:
        return false

    # Establish data ordering before publishing the new valid length.
    if not fs_block_device_owner_flush_acknowledged():
        return false

    var header = match fs_block_device_owner_read(base as u64):
        Ok(bytes): bytes
        Err(_): return false
    if header.len() as i64 != sector_size:
        return false
    val next_sequence = current_sequence + 1u64
    val slot = if (next_sequence & 1u64) == 1u64: 0 else: NVFS_ARENA_HEADER_SLOT_BYTES
    header = _nvfs_write_header_record(header, slot, next_sequence, meta.total_bytes)
    if not nvfs_raw_write_sector(base as u64, header):
        return false
    if not fs_block_device_owner_flush_acknowledged():
        return false
    _nvfs_arena_commit_sequences[idx as i32] = next_sequence
    true

fn arena_durable_len_impl(base_block: i64) -> i64:
    if base_block < 0:
        return -1
    val record = _nvfs_best_header_record(nvfs_raw_read_sector(base_block as u64))
    if not record.valid:
        return -1
    record.total_bytes

fn arena_durable_sequence_impl(base_block: i64) -> u64:
    if base_block < 0:
        return 0u64
    val record = _nvfs_best_header_record(nvfs_raw_read_sector(base_block as u64))
    if not record.valid:
        return 0u64
    record.sequence

fn arena_recover_nvme_impl(class_tag: i32, hint_bytes: i64, base_block: i64, block_count: i64) -> i64:
    if base_block < 0 or block_count < 2 or block_count > NVFS_ARENA_MAX_I64 - base_block or not fs_block_device_owner_ready():
        return -1
    val sector_size = _nvfs_arena_sector_size()
    val record = _nvfs_best_header_record(nvfs_raw_read_sector(base_block as u64))
    val max_data = _nvfs_arena_capacity(block_count, sector_size)
    if max_data < 0 or not record.valid or record.total_bytes < 0 or record.total_bytes > max_data:
        return -1
    val arena_id = arena_create_nvme_impl(class_tag, hint_bytes, base_block, block_count)
    if arena_id < 0:
        return -1
    val idx = _nvfs_arena_find_idx(arena_id)
    val meta = _nvfs_arena_metas[idx as i32]
    _nvfs_arena_metas[idx as i32] = NvfsArenaMeta(
        arena_id: meta.arena_id,
        class_tag: meta.class_tag,
        hint_bytes: meta.hint_bytes,
        sealed: meta.sealed,
        discarded: meta.discarded,
        total_bytes: record.total_bytes
    )
    _nvfs_arena_commit_sequences[idx as i32] = record.sequence
    arena_id

export arena_durable_sequence_impl, arena_recover_nvme_impl
