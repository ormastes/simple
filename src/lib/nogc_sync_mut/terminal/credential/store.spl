# Credential Store - Encrypt/Decrypt Credentials for Terminal Configs
#
# Provides transparent credential encryption using AES-256-CBC (real CBC
# chaining + PKCS#7 padding, with a per-record IV from the OS CSPRNG) and keys
# derived from a master passphrase via BCrypt KDF. Encrypted credentials are
# stored as "encrypted:v2:<hex_iv><hex_ciphertext>" strings in SDN config
# files. Legacy "encrypted:<hex>" records (no version marker) are still
# readable — see credential_decrypt.
#
# Key storage: ~/.simple/credential_key (base64-encoded 32-byte AES key)
#
# Depends on:
#   - std.common.aes.modes (AES-CBC encrypt/decrypt)
#   - std.common.aes.utilities (byte/text conversions, key preparation)
#   - std.common.bcrypt.key_derivation (Eksblowfish key setup)
#   - std.common.base_encoding.base64 (base64 encode/decode)

use std.common.aes.modes.{aes_cbc_encrypt, aes_cbc_decrypt, aes_ctr_decrypt}
use std.common.aes.utilities.{text_to_bytes, bytes_to_text, prepare_key, bytes_to_hex, hex_to_bytes}
use std.common.bcrypt.key_derivation.{eksblowfish_setup, blowfish_encrypt_block}
use std.common.base_encoding.base64.{base64_encode, base64_decode}
use std.common.crypto.hkdf.{hkdf_sha256}

# ============================================================================
# SFFI Declarations - File I/O
# ============================================================================

use std.io_runtime.{read_file_text}
use std.io_runtime.{file_write}

# Atomic, mode-carrying write for secret-bearing files. The mode is applied to
# the same-directory temp BEFORE the content is written and before the rename,
# so the target never exists at a wider mode. See rt_file_atomic_write_mode in
# src/compiler_rust/compiler/src/interpreter_extern/file_io.rs
extern fn rt_file_atomic_write_mode(path: text, content: text, mode: i32) -> bool

# Read a file's permission bits (e.g. 0o600 -> 384), or -1 if it cannot be
# stat'd. Lets a spec assert what actually landed on disk instead of trusting
# chmod's own return value.
extern fn rt_file_mode(path: text) -> i64
use std.io_runtime.{file_exists}

# ============================================================================
# SFFI Declarations - OS CSPRNG
# ============================================================================

# N cryptographically-secure random bytes, lowercase-hex encoded (2*N chars).
# Backed by the OS CSPRNG (OsRng / getrandom). Returns nil if the OS refuses,
# which callers MUST treat as an encryption failure — never as "use zeros".
extern fn rt_random_hex(length: i64) -> text?

# ============================================================================
# SFFI Declarations - environment + file mode
# ============================================================================

use std.io_runtime.{env_get}

# chmod(2) wrapper. Returns 0 on success. Already registered in the runtime
# extern table (rt_package_chmod); no new primitive is introduced here.
extern fn rt_package_chmod(file_path: text, mode: i32) -> i32

# ============================================================================
# Constants
# ============================================================================

val CREDENTIAL_PREFIX: text = "encrypted:"

# Stored-format version marker, written directly after CREDENTIAL_PREFIX.
#
# v2 (current) = real AES-256-CBC + PKCS#7, random per-record IV.
# v1 (legacy, no marker) = AES-256-CTR with an IV derived deterministically
#   from the plaintext, mislabelled "AES-256-CBC". See
#   doc/08_tracking/bug/credential_store_aes_cbc_label_is_actually_ctr_with_deterministic_iv_2026-08-07.md
#
# Detecting the version is unambiguous: a v1 payload is pure lowercase hex
# ([0-9a-f]) because it is `bytes_to_hex(iv) + bytes_to_hex(ct)`, and neither
# 'v' nor ':' is a hex character. So a payload starting with "v2:" cannot be a
# v1 record, and a v1 record can never be mistaken for v2.
val CREDENTIAL_VERSION_V2: text = "v2:"
val CREDENTIAL_KEY_FILENAME: text = "credential_key"
val CREDENTIAL_KEY_DIR: text = ".simple"
val BCRYPT_COST: i64 = 10          # 2^10 = 1024 rounds
val AES_KEY_SIZE: i64 = 32         # AES-256
val AES_IV_SIZE: i64 = 16          # 128-bit IV

val KDF_SALT_SIZE: i64 = 16
val KEY_FILE_MODE: i32 = 0o600     # rw-------  (secret: owner only)
val KEY_DIR_MODE: i32 = 0o700      # rwx------

# NOTE ON THE OLD FIXED SALT
#
# Before 2026-08-08 the KDF used one hard-coded 16-byte salt ("SimpleKeySalt123")
# for every derivation, so a given passphrase produced the SAME key on every
# machine and for every user — no rainbow-table resistance and no cross-user key
# separation, which is the entire purpose of a salt. New key files now draw a
# random per-file salt from the OS CSPRNG and record it beside the key.
#
# That constant is deliberately NOT retained: the derivation changed too (see
# credential_derive_key), so it could not reproduce a legacy key even under the
# original salt. Legacy key files are read as-is instead, forever, and
# credential_key_generate refuses to overwrite one.

# ----------------------------------------------------------------------------
# Key-file format
# ----------------------------------------------------------------------------
#
# v2 (current):  "v2:<hex_salt><:><hex_key>"   = "v2:" + 32 hex + ":" + 64 hex
# v1 (legacy, no marker): bare "<hex_key>"     = 64 lowercase hex characters
#
# Detection is unambiguous by exactly the same argument the payload format
# uses: a legacy key file is pure lowercase hex, and neither 'v' nor ':' is a
# hex character, so a file starting with "v2:" cannot be a legacy file and a
# legacy file can never be read as v2.
#
# Both formats store the FINAL key bytes, so loading never re-derives from a
# passphrase and a legacy key file keeps yielding its original key forever.
# The salt is recorded so that regenerating from the same passphrase on this
# install reproduces this install's key.
val KEY_FILE_VERSION_V2: text = "v2:"

# HKDF info string binding the expanded key to this purpose (RFC 5869 §3.2).
val KDF_INFO: text = "simple-credential-store/aes-256-cbc/v2"

# Env knob for the BCrypt cost factor. Production default is BCRYPT_COST (10).
# The interpreter cannot complete cost 10 in reasonable time, so specs and
# probes set this explicitly; it is opt-in and never lowered implicitly.
val BCRYPT_COST_ENV: text = "SIMPLE_CREDENTIAL_KDF_COST"
val BCRYPT_COST_MIN: i64 = 4
val BCRYPT_COST_MAX: i64 = 16

# ============================================================================
# Key Path Resolution
# ============================================================================

fn credential_key_default_path() -> text:
    """Get the default credential key file path.

    Returns:
        Path to ~/.simple/credential_key

    Note: Uses $HOME environment variable to resolve home directory.
    """
    # Use extern to get home directory
    val home = rt_env_get_home()
    "{home}/{CREDENTIAL_KEY_DIR}/{CREDENTIAL_KEY_FILENAME}"

fn credential_key_resolve_path(key_path: text) -> text:
    """Resolve the credential key file path.

    If key_path is empty, returns the default path (~/.simple/credential_key).
    Otherwise returns key_path as-is.

    Args:
        key_path: Explicit key path or empty string for default

    Returns:
        Resolved key file path
    """
    if key_path == "":
        return credential_key_default_path()
    key_path

# ============================================================================
# Home directory helper (SFFI)
# ============================================================================

extern fn rt_env_get_home() -> text

# ============================================================================
# Key Management
# ============================================================================

fn credential_key_exists(key_path: text) -> bool:
    """Check if a credential key file exists.

    Args:
        key_path: Path to key file, or empty for default (~/.simple/credential_key)

    Returns:
        true if the key file exists
    """
    val path = credential_key_resolve_path(key_path)
    file_exists(path)

fn credential_kdf_cost() -> i64:
    """Resolve the BCrypt cost factor.

    Returns BCRYPT_COST (10) unless SIMPLE_CREDENTIAL_KDF_COST names a value in
    4..=16, which specs and probes use because the interpreter cannot complete
    cost 10 in reasonable time. Out-of-range or unparseable values fall back to
    the production default rather than to something weaker — the cost is never
    lowered implicitly.

    THE NIL GUARD IS LOAD-BEARING — do not remove it. `rt_env_get` is declared
    `-> text`, but the runtime returns NIL (not "") when the variable is unset,
    so the declared signature is a lie the interpreter does not check. The
    previous revision called `.trim()` on that result unconditionally, and with
    the env var unset the whole function ABORTED with

        semantic: method `trim` not found on type `nil` (receiver value: nil)

    rather than returning anything. That is why a `c >= 4 and c <= 16` assertion
    reported plain "false" and why three rewrites (early-return, single-exit,
    literals-only) all "failed identically": none of them ever ran to a return.
    The function was never returning an out-of-band cost — it was throwing.

    Supersedes the module-level-`val`-reads theory recorded in
    doc/08_tracking/bug/credential_store_module_level_val_reads_wrong_2026-08-08.md
    The module constants are therefore used directly again; the literals that
    stood in for them were treating a symptom that had a different cause.

    The nil-compare idiom matches std.spec.env_detect.get_env.
    """
    val raw = env_get(BCRYPT_COST_ENV)
    if raw == nil:
        return BCRYPT_COST
    val trimmed = raw.trim()
    if trimmed.length() == 0:
        return BCRYPT_COST
    val parsed = trimmed.to_i64()
    if parsed >= BCRYPT_COST_MIN and parsed <= BCRYPT_COST_MAX:
        return parsed
    BCRYPT_COST

fn credential_kdf_info_bytes() -> [i64]:
    """KDF_INFO as raw bytes, built locally under a deliberately unique name.

    This must NOT go through the shared `text_to_bytes` helper: that name has
    three co-compiled definitions across the stdlib with two different return
    types, and the JIT resolves such call sites by exact arg-type match,
    falling back to the LAST definition when ambiguous. Which definition the
    KDF got therefore depended on the set of modules the *caller* happened to
    pull in, which made the derived key caller-dependent. Building the bytes
    here removes the KDF from that dispatch hazard entirely.
    """
    var out: [i64] = []
    var i = 0
    while i < KDF_INFO.length():
        out.push(KDF_INFO.char_code_at(i))
        i = i + 1
    out

fn credential_derive_key(passphrase: text, salt: [i64], cost: i64) -> [i64]:
    """Derive a full 32-byte AES-256 key from a passphrase and salt.

    Two stages, neither of them novel:

      1. BCrypt/Eksblowfish (RFC-less but standard bcrypt) over the passphrase
         and salt, yielding the customary 24 bytes — three 64-bit blocks of the
         "OrpheanBeholderScryDoubt" magic, each encrypted 64 times.
      2. HKDF-SHA256 (RFC 5869) extract-then-expand over those 24 bytes to the
         full 32 bytes AES-256 requires, salted with the same salt and bound to
         this purpose by KDF_INFO.

    Stage 2 is the fix for the 24-of-32 shortfall: the previous revision
    zero-padded the 24 bcrypt bytes to 32, so every key ended in 8 known 0x00
    bytes and the effective keyspace was 192 bits, not 256.

    Returns a 32-byte list, or an empty list if expansion failed.
    """
    val state = eksblowfish_setup(passphrase, salt, cost)

    # Standard bcrypt output: "OrpheanBeholderScryDoubt" as three 64-bit blocks.
    val magic_words: [[i64]] = [[0x4F727068, 0x65616E42], [0x65686F6C, 0x64657253], [0x63727944, 0x6F756274]]

    var ikm: [i64] = []
    var block_idx = 0
    while block_idx < 3:
        var left = magic_words[block_idx][0]
        var right = magic_words[block_idx][1]

        var round = 0
        while round < 64:
            val encrypted = blowfish_encrypt_block(left, right, state)
            left = encrypted[0]
            right = encrypted[1]
            round = round + 1

        ikm.push((left / 16777216) % 256)
        ikm.push((left / 65536) % 256)
        ikm.push((left / 256) % 256)
        ikm.push(left % 256)
        ikm.push((right / 16777216) % 256)
        ikm.push((right / 65536) % 256)
        ikm.push((right / 256) % 256)
        ikm.push(right % 256)

        block_idx = block_idx + 1

    if ikm.length() == 0:
        return []

    # HKDF-SHA256 to the full AES-256 width. No zero padding, no invented
    # construction: 24 bytes of bcrypt output expanded to 32 per RFC 5869.
    val okm = hkdf_sha256(salt, ikm, credential_kdf_info_bytes(), AES_KEY_SIZE)
    if okm.length() != AES_KEY_SIZE:
        return []
    okm

fn credential_key_file_is_legacy(path: text) -> bool:
    """Is there an existing key file in the pre-2026-08-08 bare-hex format?"""
    if not file_exists(path):
        return false
    val raw = read_file_text(path).trim()
    if raw.length() == 0:
        return false
    not raw.starts_with(KEY_FILE_VERSION_V2)

fn credential_key_file_salt(path: text) -> [i64]:
    """Read the KDF salt recorded in an existing v2 key file.

    Returns the stored salt for a v2 key file, and an empty list otherwise
    (no file, an unreadable file, or a legacy bare-hex file — a legacy file
    records no salt, and credential_key_generate refuses to overwrite one
    anyway).
    """
    if not file_exists(path):
        return []
    val raw = read_file_text(path).trim()
    if raw.length() == 0:
        return []
    if not raw.starts_with(KEY_FILE_VERSION_V2):
        return []
    val body = raw[KEY_FILE_VERSION_V2.length()..]
    val sep = body.find(":")
    if sep < 0:
        return []
    val salt = hex_to_bytes(body[0..sep])
    if salt.length() != KDF_SALT_SIZE:
        return []
    salt

fn credential_key_generate(passphrase: text, key_path: text) -> bool:
    """Generate a credential key file from a passphrase.

    Derives a full 256-bit AES key (bcrypt -> HKDF-SHA256, see
    credential_derive_key) under a salt that is RANDOM PER KEY FILE, and stores
    it as "v2:<hex_salt>:<hex_key>" with mode 0600.

    Salt handling:
      - No key file yet: a fresh 16-byte salt from the OS CSPRNG. Fails closed
        if the CSPRNG is unavailable rather than reusing a fixed salt.
      - v2 key file already present: its recorded salt is REUSED, so
        regenerating from the same passphrase reproduces this install's
        existing key and no stored credential is invalidated.
      - LEGACY bare-hex key file present: REFUSED (returns false). The
        derivation changed with this revision (bcrypt-24 zero-padded became
        bcrypt-24 expanded through HKDF-SHA256), so writing here would produce
        a DIFFERENT key under any salt and every credential already on disk
        would become undecryptable — with the only copy of the old key
        overwritten. Legacy key files are loaded as-is forever; rotating one is
        a deliberate, separate operation that must re-encrypt the credentials
        first. Delete the file explicitly to opt into a fresh key.

    Args:
        passphrase: Master passphrase for key derivation
        key_path: Path to write key file, or empty for default

    Returns:
        true if the key was derived, written, and locked down to 0600;
        false on an empty passphrase, an unavailable CSPRNG, or an existing
        legacy key file

    Example:
        if credential_key_generate("my_strong_passphrase", ""):
            print "Key generated at ~/.simple/credential_key"
    """
    if passphrase.length() == 0:
        return false

    val path = credential_key_resolve_path(key_path)

    # Never overwrite a legacy key file: the new derivation cannot reproduce
    # the key it holds, and that key is the only thing that can read the
    # credentials already stored under it.
    if credential_key_file_is_legacy(path):
        return false

    # Reuse this install's salt when one already exists; otherwise draw a fresh
    # one. A fixed salt would give every user and every machine the same key
    # for the same passphrase.
    var salt = credential_key_file_salt(path)
    if salt.length() != KDF_SALT_SIZE:
        val salt_hex_opt = rt_random_hex(KDF_SALT_SIZE)
        if salt_hex_opt == nil:
            return false
        # THE INTERPOLATION IS LOAD-BEARING — do not simplify to `?? ""`.
        # Under the seed JIT, `.length()` on the value that comes straight out
        # of the `??` unwrap reads the character count SHIFTED RIGHT BY 3
        # (32 chars -> 4, 8 chars -> 1), so the guard below always fired and
        # credential_key_generate returned false on every fresh install: no key
        # file was ever created. Re-materialising the text through an
        # interpolation restores the correct length (measured 32). The guard
        # itself is NOT droppable — hex_to_bytes loops on the same length, so
        # skipping it would silently produce a 2-byte salt, which is worse.
        # Same defect family as
        # doc/08_tracking/bug/jit_param_passed_list_element_read_returns_tagged_2026-08-08.md
        # tracked at
        # doc/08_tracking/bug/credential_key_generate_random_hex_length_reads_shifted_2026-08-08.md
        # TWO STEPS, and the second one MUST stay on its own line: writing
        # "{salt_hex_opt ?? \"\"}" does not work either — a nested string
        # literal inside an interpolation is mis-parsed and emits the literal
        # text `{salt_hex_opt ?? `. See the parser note in
        # doc/08_tracking/bug/credential_key_generate_random_hex_length_reads_shifted_2026-08-08.md
        val salt_hex_raw = salt_hex_opt ?? ""
        val salt_hex = "{salt_hex_raw}"
        if salt_hex.length() != (KDF_SALT_SIZE * 2):
            return false
        salt = hex_to_bytes(salt_hex)
        if salt.length() != KDF_SALT_SIZE:
            return false

    val aes_key = credential_derive_key(passphrase, salt, credential_kdf_cost())
    if aes_key.length() != AES_KEY_SIZE:
        return false

    val content = "{KEY_FILE_VERSION_V2}{bytes_to_hex(salt)}:{bytes_to_hex(aes_key)}"

    # Ensure the default key directory exists and is owner-only before the
    # secret lands in it. Only when we OWN that directory — an explicit
    # key_path must not cause us to mkdir or re-mode the user's ~/.simple.
    if key_path == "":
        val home = rt_env_get_home()
        val dir_path = "{home}/{CREDENTIAL_KEY_DIR}"
        rt_ensure_dir(dir_path)
        rt_package_chmod(dir_path, KEY_DIR_MODE)

    # Adopted 2026-08-10: the deployed seed (bin/release/x86_64-unknown-linux-gnu/simple)
    # now contains rt_file_atomic_write_mode and rt_file_mode -- confirmed via
    # `strings ... | grep -c rt_file_atomic_write_mode` (2, was 0) and via
    # test/01_unit/lib/terminal/credential_upgrade_persist_spec.spl's "P4 secret
    # files land at the requested mode" group (4/4 passing against this binary).
    # This closes the group/world-readable window the old write-then-chmod
    # sequence left open (see history below) by applying the mode to a
    # same-directory temp BEFORE the key bytes are written, then renaming.
    # See doc/08_tracking/bug/credential_key_file_write_has_no_mode_argument_2026-08-08.md
    # and doc/08_tracking/bug/credential_mode_write_externs_need_seed_redeploy_2026-08-08.md
    # (both marked FIXED as of this change).
    if not rt_file_atomic_write_mode(path, content, KEY_FILE_MODE):
        file_delete(path)
        return false

    true

# Used only to retract a key file whose mode could not be applied -- see
# credential_key_generate. This is a Simple-aware registered extern (unlike the
# rt_package_* family) and is verified working on the deployed seed.
use std.io_runtime.{file_delete}

extern fn rt_ensure_dir(path: text) -> bool

# ============================================================================
# Key Loading
# ============================================================================

fn credential_load_key(key_path: text) -> [i64]:
    """Load AES key bytes from a credential key file.

    Args:
        key_path: Path to key file, or empty for default

    Reads BOTH key-file formats:

      - v2 (current): "v2:<hex_salt>:<hex_key>" — a random per-file salt is
        recorded alongside the key.
      - legacy (no marker): a bare 64-character hex key, as written before
        2026-08-08.

    Both store the FINAL key bytes, so nothing is re-derived here and a legacy
    key file keeps yielding exactly the key it always did. Every credential
    encrypted under a legacy key stays readable.

    Returns:
        32-byte key as list of integers, or empty list on failure
    """
    val path = credential_key_resolve_path(key_path)
    if not file_exists(path):
        return []

    val trimmed = read_file_text(path).trim()
    if trimmed.length() == 0:
        return []

    if not trimmed.starts_with(KEY_FILE_VERSION_V2):
        # LEGACY bare-hex key file. Kept readable forever: re-deriving under a
        # new salt would invalidate every credential already on disk.
        return hex_to_bytes(trimmed)

    val body = trimmed[KEY_FILE_VERSION_V2.length()..]
    val sep = body.find(":")
    if sep < 0:
        return []
    val key = hex_to_bytes(body[(sep + 1)..])
    if key.length() != AES_KEY_SIZE:
        return []
    key

# ============================================================================
# Encrypt / Decrypt
# ============================================================================

fn credential_encrypt(plaintext: text, key_path: text) -> text:
    """Encrypt a credential string for secure storage.

    Encrypts the plaintext with real AES-256-CBC + PKCS#7 padding under a
    fresh IV drawn from the OS CSPRNG, and returns a string in the format
    "encrypted:v2:<hex_iv><hex_ciphertext>".

    The IV is random per call, so encrypting the same plaintext twice under
    the same key yields DIFFERENT ciphertext. (Before 2026-08-08 the IV was a
    checksum of the plaintext and the mode was actually CTR, which made
    identical plaintexts produce identical ciphertext under an identical
    keystream — see the bug doc referenced at CREDENTIAL_VERSION_V2.)

    Args:
        plaintext: Credential value to encrypt (e.g., password)
        key_path: Path to credential key file, or empty for default

    Returns:
        Encrypted string with "encrypted:v2:" prefix, or empty on failure
        (including when the OS CSPRNG is unavailable — this fails closed
        rather than falling back to a predictable IV)

    Example:
        val encrypted = credential_encrypt("my_password", "")
        # Returns: "encrypted:v2:a1b2c3d4..."
    """
    if plaintext.length() == 0:
        return ""

    val key = credential_load_key(key_path)
    if key.length() == 0:
        return ""

    # Fresh, unpredictable IV from the OS CSPRNG. Fail closed if unavailable:
    # a predictable CBC IV would reintroduce the defect this replaced.
    val iv_hex_opt = rt_random_hex(AES_IV_SIZE)
    if iv_hex_opt == nil:
        return ""
    # Interpolation is load-bearing here too — see credential_key_generate.
    # `(iv_hex_opt ?? "").length()` reads 32>>3 = 4 under the seed JIT, so this
    # guard rejected every valid IV and credential_encrypt always returned "".
    val iv_hex_raw = iv_hex_opt ?? ""
    val iv_hex = "{iv_hex_raw}"
    if iv_hex.length() != (AES_IV_SIZE * 2):
        return ""
    val iv = hex_to_bytes(iv_hex)
    if iv.length() != AES_IV_SIZE:
        return ""

    val pt_bytes = text_to_bytes(plaintext)

    # Encrypt with AES-256-CBC (PKCS#7 padding applied inside aes_cbc_encrypt).
    val ciphertext = aes_cbc_encrypt(pt_bytes, key, iv)
    if ciphertext.length() == 0:
        return ""

    # Encode: version marker + IV (hex) + ciphertext (hex)
    val ct_hex = bytes_to_hex(ciphertext)

    "{CREDENTIAL_PREFIX}{CREDENTIAL_VERSION_V2}{iv_hex}{ct_hex}"

fn credential_decrypt(encrypted: text, key_path: text) -> text:
    """Decrypt an encrypted credential string.

    Handles BOTH stored formats:

      - v2 (current): "encrypted:v2:<hex_iv><hex_ciphertext>" — real
        AES-256-CBC with PKCS#7, random IV.
      - v1 (legacy, no version marker): "encrypted:<hex_iv><hex_ciphertext>" —
        records written before 2026-08-08, which despite their "AES-256-CBC"
        label were actually AES-256-CTR with a plaintext-derived IV.

    The v1 branch is READ-ONLY and deliberately calls aes_ctr_decrypt by name:
    those bytes are CTR bytes, and running them through the new real CBC
    decryptor would make every pre-existing credential unreadable. Records are
    NOT silently re-encrypted on read; re-saving a credential through
    credential_encrypt upgrades it to v2.

    Args:
        encrypted: Encrypted credential string with "encrypted:" prefix
        key_path: Path to credential key file, or empty for default

    Returns:
        Decrypted plaintext string, or empty on failure

    Example:
        val password = credential_decrypt("encrypted:v2:a1b2c3d4...", "")
    """
    if not encrypted.starts_with(CREDENTIAL_PREFIX):
        return ""

    val key = credential_load_key(key_path)
    if key.length() == 0:
        return ""

    # Strip prefix, then detect the version BEFORE any slicing that assumes a
    # layout. A v1 payload is pure hex, and 'v'/':' are not hex characters, so
    # this test can never misclassify a record in either direction.
    val payload_raw = encrypted[CREDENTIAL_PREFIX.length()..]
    val is_v2 = payload_raw.starts_with(CREDENTIAL_VERSION_V2)
    val payload = if is_v2: payload_raw[CREDENTIAL_VERSION_V2.length()..] else: payload_raw

    if payload.length() < (AES_IV_SIZE * 2 + 2):
        return ""

    # Extract IV (first 32 hex chars = 16 bytes)
    val iv_hex_len = AES_IV_SIZE * 2
    val iv_hex = payload[0..iv_hex_len]
    val ct_hex = payload[iv_hex_len..]

    val iv = hex_to_bytes(iv_hex)
    val ciphertext = hex_to_bytes(ct_hex)

    if iv.length() != AES_IV_SIZE:
        return ""
    if ciphertext.length() == 0:
        return ""

    if not is_v2:
        # LEGACY v1 COMPATIBILITY PATH — pre-2026-08-08 records.
        # These were produced by aes_ctr_encrypt (behind the old aes_cbc_encrypt
        # alias), with no padding, so decrypt them as CTR. Do not "fix" this to
        # aes_cbc_decrypt: that would break every stored credential on disk.
        return bytes_to_text(aes_ctr_decrypt(ciphertext, key, iv))

    # v2: real AES-256-CBC. Returns nil on invalid PKCS#7 padding, which is
    # what a wrong key or a corrupted record produces — fail closed.
    val plaintext_opt = aes_cbc_decrypt(ciphertext, key, iv)
    if val plaintext_bytes = plaintext_opt:
        return bytes_to_text(plaintext_bytes)
    ""

# ============================================================================
# Transparent Resolution
# ============================================================================

fn credential_resolve(value: text) -> text:
    """Resolve a credential value, decrypting if necessary.

    If the value starts with "encrypted:", it is decrypted using the
    default credential key. Otherwise the value is returned as-is.

    This allows config files to contain either plaintext or encrypted
    credentials transparently.

    Args:
        value: Credential value (plaintext or "encrypted:..." format)

    Returns:
        Resolved plaintext credential

    Example:
        # Works with both forms:
        credential_resolve("plaintext_password")       # Returns: "plaintext_password"
        credential_resolve("encrypted:a1b2c3...")       # Returns: decrypted value
    """
    if value.starts_with(CREDENTIAL_PREFIX):
        return credential_decrypt(value, "")
    value

fn credential_needs_upgrade(value: text) -> bool:
    """Is this a v1 (legacy CTR, deterministic-IV) record that should be re-encrypted?

    True only for an "encrypted:" record with no "v2:" marker. Plaintext values
    and current v2 records return false.
    """
    if not value.starts_with(CREDENTIAL_PREFIX):
        return false
    not value[CREDENTIAL_PREFIX.length()..].starts_with(CREDENTIAL_VERSION_V2)

fn credential_upgrade_record(value: text, key_path: text) -> text:
    """Re-encrypt a legacy v1 record as v2, or return "" if it must not be replaced.

    v1 records were written under AES-256-CTR with an IV derived from the
    PLAINTEXT, so two stored secrets that collided leaked their XOR. They stay
    readable, but they should not linger: this produces the v2 replacement.

    The upgrade is only offered when it is PROVABLY lossless. The new record is
    decrypted again and compared against the original plaintext, and "" is
    returned unless that round-trip matches exactly. A caller must treat "" as
    "keep what you have" — never as "write an empty credential".

    This function deliberately performs NO file I/O. credential_decrypt takes a
    record, not a location, and has no idea which config file or field a record
    came from; persisting from inside a decrypt path is how config files get
    corrupted. The record's owner persists the result, atomically (write a temp
    file, fsync, rename over the original), so an interrupted write leaves the
    original v1 record intact and still readable.

    Args:
        value: An "encrypted:" record, typically v1
        key_path: Path to credential key file, or empty for default

    Returns:
        The "encrypted:v2:..." replacement, or "" if no upgrade should be
        written (not a v1 record, unreadable, or the round-trip failed)

    Example:
        if credential_needs_upgrade(stored):
            val upgraded = credential_upgrade_record(stored, "")
            if upgraded != "":
                config_write_atomic(field, upgraded)
    """
    if not credential_needs_upgrade(value):
        return ""

    val plaintext = credential_decrypt(value, key_path)
    if plaintext.length() == 0:
        # Unreadable under the current key, or genuinely empty. Either way there
        # is nothing safe to write in its place.
        return ""

    val upgraded = credential_encrypt(plaintext, key_path)
    if upgraded.length() == 0:
        return ""

    # Verify by round-trip before offering the replacement. Without this an
    # encryption defect would silently destroy the credential.
    if credential_decrypt(upgraded, key_path) != plaintext:
        return ""

    upgraded

fn _is_record_body_char(c: text) -> bool:
    """Is this character part of a credential record token?

    A record is "encrypted:" followed by lowercase hex, optionally preceded by
    the "v2:" marker. So the body charset is hex digits plus 'v', '2' and ':'.
    Everything a config file uses to TERMINATE a value -- the closing quote,
    whitespace, newline, comma, '}' -- falls outside it, which is what lets the
    scanner find a record's exact end without parsing the config grammar.
    """
    (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or (c >= "A" and c <= "F") or c == "v" or c == ":"

fn credential_upgrade_file(path: text, key_path: text) -> i64:
    """Re-encrypt every legacy v1 credential record in a config file as v2.

    This is the WRITE OWNER that credential_upgrade_record deliberately is not.
    Without it the upgrade primitive had no caller that could persist anything
    (config_parser is entirely read-only), so v1 records -- encrypted under the
    old CTR-with-plaintext-derived-IV scheme -- lingered on disk indefinitely.

    Why this rewrites TEXT and not parsed structure
    -----------------------------------------------
    parse_terminal_config / parse_section_entries are a LOSSY parse: they yield
    typed structs and discard comments, blank lines, key order and spacing.
    Regenerating a config from them would silently reformat the user's file --
    a far bigger change than the one being asked for, and one that would be
    blamed on a credential upgrade. So this scans the RAW TEXT, splices only
    the record tokens themselves, and copies every other byte through
    untouched. A file whose records are all v2 already is byte-identical.

    Atomicity and the interrupted-write case
    ----------------------------------------
    Nothing is written unless at least one record actually upgraded, so reading
    a clean config never churns it. When there is something to write it goes
    through rt_file_atomic_write_mode: a UNIQUE temp file in the SAME directory
    (rename is only atomic within a filesystem), fsync'd, then renamed over the
    target. rename(2) is atomic, so a crash or power loss at any point leaves
    EITHER the complete new file OR the untouched original -- never a truncated
    config, and never a half-upgraded one. The original stays readable
    throughout: v1 records remain decryptable, so an interrupted upgrade costs
    nothing but the work.

    Each individual record is replaced only if credential_upgrade_record
    verified it by round-trip first, so a record that cannot be re-encrypted
    losslessly is left exactly as it was rather than dropped.

    Args:
        path: Config file to upgrade in place
        key_path: Path to credential key file, or empty for default

    Returns:
        The number of records upgraded (0 = nothing to do, file untouched), or
        -1 if the file could not be read or the atomic write failed. On -1 the
        original file is still intact.
    """
    if not file_exists(path):
        return -1

    val original = read_file_text(path)
    if original.length() == 0:
        return -1

    var out = ""
    var cursor = 0
    var upgraded_count = 0
    val total = original.length()
    val prefix_len = CREDENTIAL_PREFIX.length()

    while cursor < total:
        val rest = original[cursor..]
        val hit = rest.find(CREDENTIAL_PREFIX)
        if hit < 0:
            out = out + rest
            cursor = total
        else:
            val start = cursor + hit
            # Copy everything before the record through verbatim.
            out = out + original[cursor..start]

            # Consume the record token: prefix plus the body charset.
            var end = start + prefix_len
            while end < total and _is_record_body_char(original[end..(end + 1)]):
                end = end + 1

            val record = original[start..end]
            # MINIMUM BODY GUARD. "encrypted:" also occurs in ordinary prose --
            # a comment like "# password is encrypted: yes" contains it -- and
            # there the body walk stops immediately at the space, leaving the
            # token as the bare prefix. credential_needs_upgrade("encrypted:")
            # answers TRUE (it has the prefix and no "v2:" marker), so without
            # this guard every prose mention would be handed to
            # credential_upgrade_record and decrypted. A real record's body is
            # never short: v1 is 32 hex of IV plus at least one 32-hex block,
            # and v2 adds the "v2:" marker on top, so 32 is comfortably below
            # any genuine record and comfortably above any prose fragment.
            val body_len = end - start - prefix_len
            if body_len >= 32 and credential_needs_upgrade(record):
                val replacement = credential_upgrade_record(record, key_path)
                if replacement.length() > 0:
                    out = out + replacement
                    upgraded_count = upgraded_count + 1
                else:
                    # Round-trip did not verify. Keep what is on disk.
                    out = out + record
            else:
                out = out + record
            cursor = end

    if upgraded_count == 0:
        # Nothing changed -- do not touch the file at all.
        return 0

    # PRESERVE the config's existing mode rather than imposing one. This file
    # is not itself a secret -- it holds ciphertext, and the key lives
    # elsewhere at 0600 -- so silently narrowing a config the operator
    # deliberately made group-readable would break their setup, and widening it
    # would be a regression. rt_file_mode lets us carry the real on-disk mode
    # across the rename instead of guessing. If it cannot be read, fail closed
    # to owner-only rather than to something permissive.
    var mode = rt_file_mode(path)
    if mode < 0:
        mode = KEY_FILE_MODE

    if not rt_file_atomic_write_mode(path, out, mode):
        return -1

    upgraded_count

fn credential_is_encrypted(value: text) -> bool:
    """Check if a credential value is in encrypted format.

    Args:
        value: Credential string to check

    Returns:
        true if value starts with "encrypted:" prefix
    """
    value.starts_with(CREDENTIAL_PREFIX)
