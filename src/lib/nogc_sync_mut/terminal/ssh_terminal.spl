# SSH Terminal - Wraps ssh_sffi.spl for the unified terminal abstraction
#
# Provides SSH terminal operations (connect, execute, send, receive, upload, close)
# using the SshSession/SshChannel/SftpSession types from ssh_sffi.spl.
# Authentication dispatches by config.auth_method: "password", "pubkey", "agent".
# Encrypted credentials are transparently resolved via credential_resolve().
#
# Depends on:
#   - std.io.ssh_sffi (SSH2 protocol SFFI bindings)
#   - std.terminal.types (TerminalConfig, TerminalConnection, TerminalExecResult)
#   - std.terminal.credential.store (credential_resolve for encrypted passwords)

use std.nogc_sync_mut.io.ssh_sffi.{SshSession, SshChannel, SftpSession, SshExecResult, SftpFileInfo, ssh_connect, ssh_disconnect, ssh_auth_password, ssh_auth_pubkey, ssh_auth_agent, ssh_exec, ssh_shell, ssh_channel_read, ssh_channel_write, ssh_channel_close, sftp_init, sftp_shutdown, sftp_upload, sftp_download, sftp_mkdir, sftp_rmdir, sftp_delete, sftp_rename, sftp_list, sftp_stat, ssh_is_authenticated, ssh_get_banner, ssh_set_timeout}
use std.nogc_sync_mut.terminal.types.{TerminalConfig, TerminalConnection, TerminalExecResult, make_ssh_config, make_exec_result}
use std.nogc_sync_mut.terminal.credential.store.{credential_resolve}
use std.nogc_sync_mut.io.stderr_ops.{stderr_write}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

# ============================================================================
# SFFI - Timing
# ============================================================================

use std.io_runtime.{time_now_unix_micros}

# ============================================================================
# Dead-backing diagnostic (doc/08_tracking/bug/
# ssh_daemon_baremetal_only_and_duplication_2026-08-05.md, finding 5)
# ============================================================================
#
# ssh_sffi.spl's rt_ssh_*/rt_sftp_* externs have zero definitions in
# src/runtime/. Agent, public-key, and no-auth sessions therefore use the
# host OpenSSH `ssh`/`scp` tools through the bounded process facade. Password
# auth and interactive channels retain the old SFFI boundary and fail loudly
# rather than exposing credentials in command arguments.

fn _ssh_sffi_unbacked_warn(op: text):
    """Emit a loud, unconditional stderr diagnostic before an ssh_terminal
    operation that can never succeed because its ssh_sffi.spl backing externs
    are unregistered in src/runtime/.
    """
    stderr_write("ssh_terminal: {op} -- ssh_sffi backing (rt_ssh_*/rt_sftp_*) has zero definitions in src/runtime/; this call always fails. See doc/08_tracking/bug/ssh_daemon_baremetal_only_and_duplication_2026-08-05.md#5-a-dead-third-stack\n")

# ============================================================================
# Connection ID Counter
# ============================================================================

var ssh_conn_id_counter: i64 = 0

fn _openssh_destination(config: TerminalConfig) -> text:
    if config.username.trim() == "": return config.host
    config.username + "@" + config.host

fn _openssh_auth_args(config: TerminalConfig) -> Result<[text], text>:
    if config.host.trim() == "" or config.host.contains("\r") or config.host.contains("\n"):
        return Err("OpenSSH host is empty or contains a line break")
    if config.username.contains("\r") or config.username.contains("\n"):
        return Err("OpenSSH username contains a line break")
    if config.port <= 0 or config.port > 65535:
        return Err("OpenSSH port must be in 1..65535")
    var args: [text] = ["-o", "BatchMode=yes"]
    if config.auth_method == "pubkey":
        if config.key_path.trim() == "": return Err("SSH public-key authentication requires key_path")
        args.push("-i")
        args.push(config.key_path)
    elif config.auth_method != "agent" and config.auth_method != "none":
        return Err("OpenSSH fallback supports agent, pubkey, or none authentication")
    Ok(args)

fn openssh_execute_args(config: TerminalConfig, command: text) -> Result<[text], text>:
    val auth = _openssh_auth_args(config)?
    var args = auth
    args.push("-p")
    args.push("{config.port}")
    args.push("--")
    args.push(_openssh_destination(config))
    args.push(command)
    Ok(args)

fn _openssh_remote_path(config: TerminalConfig, path: text) -> Result<text, text>:
    if path.trim() == "" or path.contains("\r") or path.contains("\n"):
        return Err("OpenSSH remote path is empty or contains a line break")
    Ok(_openssh_destination(config) + ":" + path)

fn openssh_upload_args(config: TerminalConfig, local_path: text,
        remote_path: text) -> Result<[text], text>:
    val auth = _openssh_auth_args(config)?
    var args = auth
    args.push("-P")
    args.push("{config.port}")
    args.push("--")
    args.push(local_path)
    args.push(_openssh_remote_path(config, remote_path)?)
    Ok(args)

fn openssh_download_args(config: TerminalConfig, remote_path: text,
        local_path: text) -> Result<[text], text>:
    val auth = _openssh_auth_args(config)?
    var args = auth
    args.push("-P")
    args.push("{config.port}")
    args.push("--")
    args.push(_openssh_remote_path(config, remote_path)?)
    args.push(local_path)
    Ok(args)

# ============================================================================
# SSH Terminal Operations
# ============================================================================

fn ssh_terminal_connect(config: TerminalConfig) -> TerminalConnection:
    """Connect to an SSH server and authenticate.

    Dispatches authentication by config.auth_method:
    - "password": Uses credential_resolve(config.credential) for transparent decryption
    - "pubkey": Uses config.key_path as private key path
    - "agent": Uses SSH agent forwarding

    Args:
        config: TerminalConfig with kind == TERM_KIND_SSH

    Returns:
        TerminalConnection with connected=true on success, connected=false on failure

    Example:
        val cfg = make_ssh_config("host1", "192.168.1.100", 22, "admin", "password", "secret")
        val conn = ssh_terminal_connect(cfg)
        if conn.connected:
            print "SSH connected"
    """
    ssh_conn_id_counter = ssh_conn_id_counter + 1
    val id = ssh_conn_id_counter

    val probe_args = openssh_execute_args(config, "true")
    if probe_args.is_ok():
        val (_out, _err, code) = process_run_bounded("ssh", probe_args.unwrap(), 15000, 65536)
        return TerminalConnection(id: id, kind: TERM_KIND_SSH, config: config,
            connected: code == 0, session_handle: if code == 0: -1 else: 0,
            channel_handle: 0)

    _ssh_sffi_unbacked_warn("ssh_terminal_connect(host={config.host}, port={config.port})")

    # Establish TCP + SSH handshake
    val session = ssh_connect(config.host, config.port)
    if not session.is_valid:
        return TerminalConnection(
            id: id,
            kind: TERM_KIND_SSH,
            config: config,
            connected: false,
            session_handle: 0,
            channel_handle: 0
        )

    # Dispatch authentication
    var auth_ok = false

    if config.auth_method == "password":
        val password = credential_resolve(config.credential)
        auth_ok = ssh_auth_password(session, config.username, password)

    if config.auth_method == "pubkey":
        # Derive public key path from private key path (append .pub)
        val pub_path = "{config.key_path}.pub"
        val passphrase = credential_resolve(config.credential)
        auth_ok = ssh_auth_pubkey(session, config.username, pub_path, config.key_path, passphrase)

    if config.auth_method == "agent":
        auth_ok = ssh_auth_agent(session, config.username)

    if not auth_ok:
        ssh_disconnect(session)
        return TerminalConnection(
            id: id,
            kind: TERM_KIND_SSH,
            config: config,
            connected: false,
            session_handle: 0,
            channel_handle: 0
        )

    # Open an interactive shell channel for send/receive operations
    val channel = ssh_shell(session)
    val ch_handle = if channel.is_valid: channel.handle else: 0

    TerminalConnection(
        id: id,
        kind: TERM_KIND_SSH,
        config: config,
        connected: true,
        session_handle: session.handle,
        channel_handle: ch_handle
    )

fn ssh_terminal_execute(conn: TerminalConnection, command: text,
        timeout_ms: i64 = 300000) -> TerminalExecResult:
    """Execute a command on the remote SSH server.

    Uses ssh_exec (one-shot channel) rather than the interactive shell channel.
    Measures wall-clock execution time.

    Args:
        conn: Active SSH TerminalConnection
        command: Shell command to execute remotely

    Returns:
        TerminalExecResult with exit_code, stdout, stderr, duration_ms
    """
    if not conn.connected:
        return make_exec_result(-1, "", "not connected", 0)

    if conn.session_handle == -1:
        val args = openssh_execute_args(conn.config, command)
        if args.is_err(): return make_exec_result(-1, "", args.unwrap_err(), 0)
        val start_us = time_now_unix_micros()
        val (stdout, stderr, exit_code) = process_run_bounded("ssh", args.unwrap(), timeout_ms, 1048576)
        val duration_ms = (time_now_unix_micros() - start_us) / 1000
        return make_exec_result(exit_code, stdout, stderr, duration_ms)

    _ssh_sffi_unbacked_warn("ssh_terminal_execute")

    val session = SshSession(handle: conn.session_handle, host: conn.config.host, port: conn.config.port, is_valid: true)

    val start_us = time_now_unix_micros()
    val result = ssh_exec(session, command)
    val end_us = time_now_unix_micros()
    val duration_ms = (end_us - start_us) / 1000

    make_exec_result(result.exit_code, result.stdout, result.stderr, duration_ms)

fn ssh_terminal_send(conn: TerminalConnection, data: text) -> bool:
    """Send data to the interactive SSH shell channel.

    Args:
        conn: Active SSH TerminalConnection with an open shell channel
        data: Text data to send

    Returns:
        true if data was written successfully
    """
    if not conn.connected:
        return false
    if conn.session_handle == -1:
        stderr_write("ssh_terminal: interactive send is unavailable in the OpenSSH process fallback\n")
        return false
    _ssh_sffi_unbacked_warn("ssh_terminal_send")
    if conn.channel_handle == 0:
        return false

    val channel = SshChannel(handle: conn.channel_handle, is_valid: true)
    val bytes_written = ssh_channel_write(channel, data)
    bytes_written > 0

fn ssh_terminal_receive(conn: TerminalConnection, timeout_ms: i64) -> text:
    """Receive data from the interactive SSH shell channel.

    Args:
        conn: Active SSH TerminalConnection with an open shell channel
        timeout_ms: Read timeout in milliseconds (currently best-effort)

    Returns:
        Text data received, or empty string on timeout/error
    """
    if not conn.connected:
        return ""
    if conn.session_handle == -1:
        stderr_write("ssh_terminal: interactive receive is unavailable in the OpenSSH process fallback\n")
        return ""
    _ssh_sffi_unbacked_warn("ssh_terminal_receive")
    if conn.channel_handle == 0:
        return ""

    # Set session timeout for read operation
    val session = SshSession(handle: conn.session_handle, host: conn.config.host, port: conn.config.port, is_valid: true)
    ssh_set_timeout(session, timeout_ms)

    val channel = SshChannel(handle: conn.channel_handle, is_valid: true)
    ssh_channel_read(channel)

fn ssh_terminal_upload(conn: TerminalConnection, local_path: text, remote_path: text) -> bool:
    """Upload a file to the remote server via SFTP.

    Initializes an SFTP subsystem, uploads the file, then shuts down SFTP.

    Args:
        conn: Active SSH TerminalConnection
        local_path: Local file path to upload
        remote_path: Destination path on the remote server

    Returns:
        true if upload was successful
    """
    if not conn.connected:
        return false

    if conn.session_handle == -1:
        val args = openssh_upload_args(conn.config, local_path, remote_path)
        if args.is_err(): return false
        val (_out, _err, code) = process_run_bounded("scp", args.unwrap(), 300000, 65536)
        return code == 0

    _ssh_sffi_unbacked_warn("ssh_terminal_upload")

    val session = SshSession(handle: conn.session_handle, host: conn.config.host, port: conn.config.port, is_valid: true)
    val sftp = sftp_init(session)
    if not sftp.is_valid:
        return false

    val ok = sftp_upload(sftp, local_path, remote_path)
    sftp_shutdown(sftp)
    ok

fn ssh_terminal_download(conn: TerminalConnection, remote_path: text, local_path: text) -> bool:
    """Download a file from the remote server via SFTP.

    Args:
        conn: Active SSH TerminalConnection
        remote_path: Remote file path to download
        local_path: Local destination path

    Returns:
        true if download was successful
    """
    if not conn.connected:
        return false

    if conn.session_handle == -1:
        val args = openssh_download_args(conn.config, remote_path, local_path)
        if args.is_err(): return false
        val (_out, _err, code) = process_run_bounded("scp", args.unwrap(), 300000, 65536)
        return code == 0

    _ssh_sffi_unbacked_warn("ssh_terminal_download")

    val session = SshSession(handle: conn.session_handle, host: conn.config.host, port: conn.config.port, is_valid: true)
    val sftp = sftp_init(session)
    if not sftp.is_valid:
        return false

    val ok = sftp_download(sftp, remote_path, local_path)
    sftp_shutdown(sftp)
    ok

fn ssh_terminal_close(conn: TerminalConnection) -> bool:
    """Close an SSH terminal connection.

    Closes the interactive shell channel (if open) and disconnects the session.

    Args:
        conn: SSH TerminalConnection to close

    Returns:
        true if disconnection was successful
    """
    if not conn.connected:
        return false

    if conn.session_handle == -1: return true

    _ssh_sffi_unbacked_warn("ssh_terminal_close")

    # Close interactive shell channel if open
    if conn.channel_handle != 0:
        val channel = SshChannel(handle: conn.channel_handle, is_valid: true)
        ssh_channel_close(channel)

    val session = SshSession(handle: conn.session_handle, host: conn.config.host, port: conn.config.port, is_valid: true)
    ssh_disconnect(session)

export openssh_execute_args, openssh_upload_args, openssh_download_args
