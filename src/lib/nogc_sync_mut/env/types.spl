# Environment Variable Types
#
# Core type definitions and SFFI declarations for environment utilities.

use std.io_runtime.{rt_env_cwd}

# External SFFI declarations
@unsafe(reason: "raw nullable environment lookup ABI", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?
@unsafe(reason: "raw environment integer lookup uses the caller default as its failure sentinel", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default: i64) -> i64
@unsafe(reason: "raw process environment mutation status ABI", capabilities: [ffi])
extern fn rt_env_set(key: text, value: text) -> bool
@unsafe(reason: "raw nullable runtime-owned environment tuple-array snapshot ABI", capabilities: [ffi])
extern fn rt_env_vars() -> [(text, text)]?
@unsafe(reason: "raw process environment removal status ABI", capabilities: [ffi])
extern fn rt_env_remove(key: text) -> bool
@unsafe(reason: "raw nullable runtime-owned home-directory text ABI", capabilities: [ffi])
extern fn rt_env_home() -> text?
@unsafe(reason: "raw nullable runtime-owned hostname text ABI", capabilities: [ffi])
extern fn rt_hostname() -> text?
@unsafe(reason: "raw compiled host-platform name ABI", capabilities: [ffi])
extern fn rt_platform_name() -> text
@unsafe(reason: "raw process execution ABI; tuple status must be interpreted by the caller", capabilities: [ffi])
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

export rt_env_get, rt_env_get_i64, rt_env_home, rt_env_set, rt_env_cwd, rt_env_remove, rt_hostname, rt_platform_name, rt_process_run, rt_env_vars
