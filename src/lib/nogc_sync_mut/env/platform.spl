# Platform Detection and System Information
#
# Functions for detecting OS, architecture, and retrieving system information.

use std.env.types.{rt_env_home, rt_hostname, rt_env_cwd, rt_process_run}
use std.env.variables.{env_get}
use std.path.{join2}
use std.cache_path_policy_v1.{user_local_location_v1, cache_location_v1}

# No-shell existence probe, same as the established `is_char_device`
# precedent (io_runtime.spl) — used below to skip the `uname -s` shell-out
# entirely when `/bin/sh` is not present, instead of trapping on baremetal
# where `rt_process_run` is a TRAP_STUB. See
# doc/08_tracking/bug/simpleos_baremetal_backend_resolve_empty_override_rt_process_run_trap_2026-08-11.md
use std.io_runtime.{file_exists}

# In-process host-OS primitive (allowlisted provider wrapper, no `rt_` token at
# this call site so it does not move the check-no-direct-rt ratchet).
use std.sffi.platform.{platform_name_raw}

@always_inline
fn _platform_process_run_raw(cmd: text, args: [text]) -> (text, text, i64):
    unsafe(capabilities: [ffi]):
        rt_process_run(cmd, args)

@always_inline
fn _platform_home_raw() -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_home()

@always_inline
fn _platform_hostname_raw() -> text?:
    unsafe(capabilities: [ffi]):
        rt_hostname()

@always_inline
fn _platform_cwd_raw() -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_cwd()

# ============================================================================
# Platform Detection
# ============================================================================

fn detect_os() -> text:
    """Detect operating system.

    Returns: "linux", "macos", "windows", "freebsd", "openbsd", "netbsd", or "unknown"

    Example:
        detect_os()  # "linux"
    """
    # The runtime is authoritative; mutable OS/OSTYPE values are not host facts.
    # BSD providers report "unix", so retain the guarded uname fallback below.
    val rt_os = platform_name_raw()
    if rt_os != nil:
        if rt_os == "windows":
            return "windows"
        if rt_os == "macos":
            return "macos"
        if rt_os == "linux":
            return "linux"

    # BAREMETAL GUARD (2026-08-11): `rt_process_run` is a TRAP_STUB on
    # baremetal targets (halts the kernel), while `rt_file_exists` is a real
    # VFS-backed no-shell primitive there. When `/bin/sh` is absent (the
    # baremetal signature — no process facility at all), skip the shell-out
    # and fall through to "unknown" instead of trapping. On every hosted
    # target `/bin/sh` exists, so this is a no-op there.
    if not file_exists("/bin/sh"):
        return "unknown"

    val uname = _platform_shell_output_trim("uname -s")
    if uname == "Linux":
        return "linux"
    if uname == "Darwin":
        return "macos"
    if uname == "FreeBSD":
        return "freebsd"
    if uname == "OpenBSD":
        return "openbsd"
    if uname == "NetBSD":
        return "netbsd"

    "unknown"

fn _platform_shell_output_trim(command: text) -> text:
    val result = _platform_process_run_raw("/bin/sh", ["-c", command])
    val stdout = result[0]
    val code = result[2]
    if code == 0:
        stdout.trim()
    else:
        ""

fn detect_arch() -> text:
    """Detect CPU architecture.

    Returns: "x86_64", "aarch64", "arm", "i686", "riscv64", or "unknown"

    Example:
        detect_arch()  # "x86_64"
    """
    val os = detect_os()

    if os == "windows":
        # Windows: Use PROCESSOR_ARCHITECTURE
        val arch_env = env_get("PROCESSOR_ARCHITECTURE")
        if arch_env == "AMD64" or arch_env == "x64":
            return "x86_64"
        elif arch_env == "ARM64":
            return "aarch64"
        elif arch_env == "x86":
            return "i686"
        else:
            return arch_env.lower()
    else:
        val hosttype = env_get("HOSTTYPE").lower()
        if hosttype == "x86_64" or hosttype == "amd64":
            return "x86_64"
        elif hosttype == "aarch64" or hosttype == "arm64":
            return "aarch64"
        elif hosttype == "armv7l" or hosttype == "armv7":
            return "arm"
        elif hosttype == "i686" or hosttype == "i386":
            return "i686"
        elif hosttype == "riscv64":
            return "riscv64"

        val machtype = env_get("MACHTYPE").lower()
        if machtype.contains("x86_64") or machtype.contains("amd64"):
            return "x86_64"
        elif machtype.contains("aarch64") or machtype.contains("arm64"):
            return "aarch64"
        elif machtype.contains("armv7"):
            return "arm"
        elif machtype.contains("i686") or machtype.contains("i386"):
            return "i686"
        elif machtype.contains("riscv64"):
            return "riscv64"

    "unknown"

fn is_windows() -> bool:
    """Check if running on Windows.

    Example:
        is_windows()  # false on Linux
    """
    detect_os() == "windows"

fn is_unix() -> bool:
    """Check if running on Unix-like system.

    Example:
        is_unix()  # true on Linux/macOS
    """
    val os = detect_os()
    os == "linux" or os == "macos" or os == "freebsd" or os == "openbsd" or os == "netbsd"

fn is_linux() -> bool:
    """Check if running on Linux.

    Example:
        is_linux()  # true on Linux
    """
    detect_os() == "linux"

fn is_macos() -> bool:
    """Check if running on macOS.

    Example:
        is_macos()  # false on Linux
    """
    detect_os() == "macos"

# ============================================================================
# User Information
# ============================================================================

fn get_username() -> text:
    """Get current username.

    Example:
        get_username()  # "alice"
    """
    # Try USER first (Unix)
    var username = env_get("USER")
    if username != "":
        return username

    # Try USERNAME (Windows)
    username = env_get("USERNAME")
    if username != "":
        return username

    "unknown"

fn get_home_dir() -> text:
    """Get user home directory.

    Example:
        get_home_dir()  # "/home/alice"
    """
    val home = _platform_home_raw()
    if home != "" and home != nil:
        return home

    # Fallback to HOME environment variable
    val home_env = env_get("HOME")
    if home_env != "":
        return home_env

    # Windows fallback
    val userprofile = env_get("USERPROFILE")
    if userprofile != "":
        return userprofile

    "."

fn get_config_dir() -> text:
    """Get user configuration directory.

    Returns:
    - Linux: ~/.config
    - macOS: ~/Library/Application Support
    - Windows: %APPDATA%

    Example:
        get_config_dir()  # "/home/alice/.config"
    """
    val os = detect_os()

    if os == "windows":
        val appdata = env_get("APPDATA")
        if appdata != "":
            return appdata
        val home = get_home_dir()
        return join2(home, "AppData/Roaming")
    elif os == "macos":
        val home = get_home_dir()
        return join2(home, "Library/Application Support")
    else:
        # Linux and other Unix
        val xdg_config = env_get("XDG_CONFIG_HOME")
        if xdg_config != "":
            return xdg_config
        val home = get_home_dir()
        return join2(home, ".config")

fn get_cache_dir() -> text:
    """Get user cache directory.

    Returns:
    - Linux: ~/.cache
    - macOS: ~/Library/Caches
    - Windows: %LOCALAPPDATA%

    Example:
        get_cache_dir()  # "/home/alice/.cache"
    """
    val os = detect_os()

    if os == "windows":
        val localappdata = env_get("LOCALAPPDATA")
        if localappdata != "":
            return localappdata
        val home = get_home_dir()
        return join2(home, "AppData/Local")
    elif os == "macos":
        val home = get_home_dir()
        return join2(home, "Library/Caches")
    else:
        # Linux and other Unix
        val xdg_cache = env_get("XDG_CACHE_HOME")
        if xdg_cache != "":
            return xdg_cache
        val home = get_home_dir()
        return join2(home, ".cache")

fn get_user_local_dir() -> text:
    user_local_location_v1(
        detect_os(), env_get("LOCALAPPDATA") ?? "",
        env_get("XDG_CACHE_HOME") ?? "", get_home_dir()
    )

fn get_cache_location(app: text) -> text:
    cache_location_v1(
        app, detect_os(), env_get("SIMPLE_CACHE") ?? "",
        env_get("LOCALAPPDATA") ?? "", env_get("XDG_CACHE_HOME") ?? "",
        get_home_dir(), get_current_dir()
    )

fn get_data_dir() -> text:
    """Get user data directory.

    Returns:
    - Linux: ~/.local/share
    - macOS: ~/Library/Application Support
    - Windows: %APPDATA%

    Example:
        get_data_dir()  # "/home/alice/.local/share"
    """
    val os = detect_os()

    if os == "windows":
        val appdata = env_get("APPDATA")
        if appdata != "":
            return appdata
        val home = get_home_dir()
        return join2(home, "AppData/Roaming")
    elif os == "macos":
        val home = get_home_dir()
        return join2(home, "Library/Application Support")
    else:
        # Linux and other Unix
        val xdg_data = env_get("XDG_DATA_HOME")
        if xdg_data != "":
            return xdg_data
        val home = get_home_dir()
        return join2(home, ".local/share")

# ============================================================================
# System Information
# ============================================================================

fn get_hostname() -> text:
    """Get system hostname.

    Example:
        get_hostname()  # "my-computer"
    """
    val hostname = _platform_hostname_raw()
    if hostname != "" and hostname != nil:
        return hostname

    "localhost"

fn get_current_dir() -> text:
    """Get current working directory.

    Example:
        get_current_dir()  # "/home/alice/project"
    """
    val cwd = _platform_cwd_raw()
    if cwd != nil and cwd! != "":
        return cwd!

    "."

fn get_temp_dir() -> text:
    """Get temporary directory.

    Example:
        get_temp_dir()  # "/tmp"
    """
    # Try TMPDIR first (Unix)
    var tmp = env_get("TMPDIR")
    if tmp != "" and tmp != nil:
        return tmp

    # Try TMP (Windows)
    tmp = env_get("TMP")
    if tmp != "" and tmp != nil:
        return tmp

    # Try TEMP (Windows)
    tmp = env_get("TEMP")
    if tmp != "" and tmp != nil:
        return tmp

    # Default fallbacks
    val os = detect_os()
    if os == "windows":
        val local_app_data = env_get("LOCALAPPDATA")
        if local_app_data != "" and local_app_data != nil:
            return local_app_data + "/Temp"
        "C:/Windows/Temp"
    else:
        "/tmp"
