# Array-free deterministic UI click PCM for native/freestanding consumers.

extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
extern fn spl_f64_to_bits(value: f64) -> i64
extern fn rt_audio_play_pcm_f64_raw(
    samples_addr: i64,
    sample_count: i64,
    channels: i64,
    sample_rate: i64
) -> i64

val UI_CLICK_PCM_FRAME_COUNT: i64 = 2880
val UI_CLICK_PCM_SAMPLE_COUNT: i64 = 5760
val UI_CLICK_PCM_CHANNELS: i64 = 2
val UI_CLICK_PCM_SAMPLE_RATE: i64 = 48000

fn _ui_click_pcm_sample(frame: i64) -> f64:
    val remaining = UI_CLICK_PCM_FRAME_COUNT - frame
    val envelope = (remaining as f64) / (
        UI_CLICK_PCM_FRAME_COUNT as f64
    )
    val sign = if (frame % 54) < 27: 1.0 else: -1.0
    sign * envelope * 0.20

fn ui_click_pcm_create() -> i64:
    val addr = rt_alloc(UI_CLICK_PCM_SAMPLE_COUNT * 8)
    if addr == 0:
        return 0
    var frame: i64 = 0
    while frame < UI_CLICK_PCM_FRAME_COUNT:
        val bits = spl_f64_to_bits(_ui_click_pcm_sample(frame))
        val sample = frame * 2
        rt_ptr_write_i64(addr, sample * 8, bits)
        rt_ptr_write_i64(addr, (sample + 1) * 8, bits)
        frame = frame + 1
    addr

fn ui_click_pcm_checksum(addr: i64) -> u64:
    if addr == 0:
        return 0u64
    var checksum = 1469598103934665603u64
    var sample: i64 = 0
    while sample < UI_CLICK_PCM_SAMPLE_COUNT:
        val bits = rt_ptr_read_i64(addr, sample * 8) as u64
        checksum = (checksum ^ bits) * 1099511628211u64
        sample = sample + 1
    checksum

fn ui_click_pcm_play(addr: i64) -> i64:
    if addr == 0:
        return 0
    rt_audio_play_pcm_f64_raw(
        addr,
        UI_CLICK_PCM_SAMPLE_COUNT,
        UI_CLICK_PCM_CHANNELS,
        UI_CLICK_PCM_SAMPLE_RATE
    )

fn ui_click_pcm_release(addr: i64):
    if addr != 0:
        rt_free(addr)

export UI_CLICK_PCM_FRAME_COUNT, UI_CLICK_PCM_SAMPLE_COUNT
export UI_CLICK_PCM_CHANNELS, UI_CLICK_PCM_SAMPLE_RATE
export ui_click_pcm_create, ui_click_pcm_checksum
export ui_click_pcm_play, ui_click_pcm_release
