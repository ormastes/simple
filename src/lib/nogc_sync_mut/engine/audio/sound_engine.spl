# codex-impl
# SoundEngine facade foundation.
#
# The engine always produces deterministic 48-kHz stereo PCM. A started
# miniaudio backend consumes the same buffer; no-audio mode retains it as the
# capture/evidence lane.

use std.common.engine.audio.sound_contract.{
    SoundBackendCapability, SoundCommand, SoundCodecResult, SoundParallelEvidence,
    sound_capability, sound_no_audio_capability, sound_sdl2_capability,
    sound_backend_status_valid,
    sound_command_2d, sound_command_3d, sound_decode_design_vector,
    sound_parallel_plan
}
use std.nogc_sync_mut.io.audio_sffi.{
    AudioEngine,
    AudioPlayback,
    audio_init,
    audio_is_playing,
    audio_live_device_count,
    audio_live_playback_count,
    audio_live_source_count,
    audio_sdl2_close,
    audio_sdl2_init,
    audio_sdl2_live_device_count,
    audio_sdl2_queue_pcm_f64_raw,
    audio_shutdown,
    audio_stop,
}
use std.nogc_sync_mut.engine.audio.ui_click_pcm_raw.{
    UI_CLICK_PCM_FRAME_COUNT,
    ui_click_pcm_create,
    ui_click_pcm_checksum,
    ui_click_pcm_play,
    ui_click_pcm_release,
}

struct SoundEngineConfig:
    platform: text
    host: text
    prefer_no_audio: bool

impl SoundEngineConfig:
    static fn no_audio() -> SoundEngineConfig:
        SoundEngineConfig(platform: "ci", host: "ci", prefer_no_audio: true)

    static fn platform(platform: text, host: text) -> SoundEngineConfig:
        SoundEngineConfig(platform: platform, host: host, prefer_no_audio: false)

    static fn sdl2(host: text) -> SoundEngineConfig:
        SoundEngineConfig(platform: "sdl2", host: host, prefer_no_audio: false)

class SoundEngine:
    capability: SoundBackendCapability
    command_log: [SoundCommand]
    teardown_count: i64
    device_started: bool
    device_handle: i64
    playback_handles: [i64]
    mixed_pcm_frames: i64
    mixed_pcm_checksum: u64
    underrun_count: i64

impl SoundEngine:
    static fn create(config: SoundEngineConfig) -> SoundEngine:
        var cap = sound_capability(config.platform, config.host)
        if config.platform == "sdl2":
            cap = sound_sdl2_capability(config.host)
        if config.prefer_no_audio:
            cap = sound_no_audio_capability()
        SoundEngine(
            capability: cap,
            command_log: [],
            teardown_count: 0,
            device_started: false,
            device_handle: 0,
            playback_handles: [],
            mixed_pcm_frames: 0,
            mixed_pcm_checksum: 0u64,
            underrun_count: 0
        )

    me start_device() -> bool:
        if self.capability.status != "native":
            return false
        if self.device_started:
            return true
        val device = if self.capability.backend == "sdl2":
            audio_sdl2_init()
        else:
            audio_init()
        self.device_started = device.is_valid
        self.device_handle = device.handle
        self.device_started

    me play_ui_click() -> bool:
        val pcm_addr = ui_click_pcm_create()
        if pcm_addr == 0:
            self.underrun_count = self.underrun_count + 1
            return false
        self.mixed_pcm_frames = self.mixed_pcm_frames + UI_CLICK_PCM_FRAME_COUNT
        self.mixed_pcm_checksum = ui_click_pcm_checksum(pcm_addr)
        if not self.device_started:
            ui_click_pcm_release(pcm_addr)
            return false
        var playback_handle: i64 = 0
        if self.capability.backend == "sdl2":
            val device = AudioEngine(handle: self.device_handle, is_valid: true)
            playback_handle = audio_sdl2_queue_pcm_f64_raw(
                device, pcm_addr, UI_CLICK_PCM_FRAME_COUNT * 2
            )
        else:
            playback_handle = ui_click_pcm_play(pcm_addr)
        ui_click_pcm_release(pcm_addr)
        if playback_handle > 0:
            if self.capability.backend != "sdl2":
                self.playback_handles.push(playback_handle)
            return true
        self.underrun_count = self.underrun_count + 1
        false

    fn active_audio_handle_count() -> i64:
        if self.capability.backend == "sdl2":
            return audio_sdl2_live_device_count()
        if self.capability.backend == "miniaudio":
            return (
                audio_live_device_count() +
                audio_live_source_count() +
                audio_live_playback_count()
            )
        0

    me play_2d(entity_id: text, clip_id: text, x_milli: i64, listener_x_milli: i64) -> SoundCommand:
        val cmd = sound_command_2d(entity_id, clip_id, x_milli, listener_x_milli)
        self.command_log = self.command_log.push(cmd)
        cmd

    me play_3d(entity_id: text, clip_id: text, distance_milli: i64, doppler_milli: i64, occlusion_milli: i64) -> SoundCommand:
        val cmd = sound_command_3d(entity_id, clip_id, distance_milli, doppler_milli, occlusion_milli)
        self.command_log = self.command_log.push(cmd)
        cmd

    fn command_count() -> i64:
        self.command_log.len()

    me teardown():
        for handle in self.playback_handles:
            val playback = AudioPlayback(handle: handle, is_valid: true)
            if audio_is_playing(playback):
                audio_stop(playback)
        self.playback_handles = []
        if self.device_started:
            val device = AudioEngine(
                handle: self.device_handle,
                is_valid: true
            )
            val closed = if self.capability.backend == "sdl2":
                audio_sdl2_close(device)
            else:
                audio_shutdown(device)
            if closed:
                self.device_started = false
                self.device_handle = 0
        self.command_log = []
        self.teardown_count = self.teardown_count + 1

fn sound_engine_decode_vector(input: text) -> SoundCodecResult:
    sound_decode_design_vector(input)

fn sound_engine_parallel_plan(has_worker_pool: bool) -> SoundParallelEvidence:
    sound_parallel_plan(has_worker_pool)

fn sound_engine_status_valid(status: text) -> bool:
    sound_backend_status_valid(status)
