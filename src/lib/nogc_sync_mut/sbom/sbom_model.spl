# SBOM (Software Bill of Materials) document model — SPDX-2.3-minimal.
#
# Mission-critical / certification workflows (Ferrocene parity) need a
# reproducible record of what sources, versions, and vendored third-party
# components went into a build. This is the pure-data shape; serialization
# lives in sbom_generator.spl.
#
# Determinism is a certification requirement: nothing in this model or its
# serializer may depend on wall-clock time, random ids, or hash-map iteration
# order. `created` is always caller-supplied (never `now()` sampled inside
# this module) so that generating from the same inputs twice is byte-for-byte
# identical — see sbom_generator_spec.spl "deterministic output" example.
#
# Fields deliberately mirror real SPDX-2.3 JSON key names (SPDXID,
# versionInfo, filesAnalyzed, checksums, relationshipType, ...) so this can
# grow into full SPDX-2.3 compliance later without a field-rename churn.

struct SbomChecksum:
    algorithm: text        # e.g. "SHA256"
    checksum_value: text   # lowercase hex digest

struct SbomPackage:
    spdx_id: text            # unique element id, e.g. "SPDXRef-Package-Root"
    name: text                # package or file name
    version_info: text        # "NOASSERTION" when unknown
    download_location: text   # "NOASSERTION" when unknown
    files_analyzed: bool       # true when checksums were computed from file content
    checksums: [SbomChecksum]  # empty when files_analyzed is false

struct SbomRelationship:
    spdx_element_id: text          # source element id
    related_spdx_element_id: text  # target element id
    relationship_type: text         # SPDX relationship type, e.g. "DESCRIBES", "DEPENDS_ON", "CONTAINS"

struct SbomCreationInfo:
    creators: [text]  # e.g. ["Tool: simple-sbom-0.1"]
    created: text      # ISO-8601 timestamp — ALWAYS caller-supplied, never sampled here

struct SbomDocument:
    spdx_version: text            # "SPDX-2.3"
    data_license: text            # "CC0-1.0"
    spdx_id: text                  # "SPDXRef-DOCUMENT"
    name: text                      # document name
    document_namespace: text        # deterministic namespace URI (derived from name+package, no UUID)
    creation_info: SbomCreationInfo
    packages: [SbomPackage]
    relationships: [SbomRelationship]

export SbomChecksum, SbomPackage, SbomRelationship, SbomCreationInfo, SbomDocument
