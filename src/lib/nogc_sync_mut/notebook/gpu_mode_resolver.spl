# gpu_mode_resolver — bare `gpu` tag -> canonical composite mode spec.
#
# Design: doc/05_design/app/tools/gpu_debugger_common_interface_architecture_2026-08-09.md §7b
#         doc/05_design/app/tools/unified_debug_profile_capability_architecture_2026-08-09.md §5, §8
# Plan:   doc/03_plan/agent_tasks/unified_debug_profile_capability_parallel_plan_2026-08-09.md (P11)
#
# Requirement (user, 2026-08-09): the verbose composite tags
# (`interpreter(remote(cuda(sm80)))`) must NOT be required. A casual user
# writes no tag at all for host execution and just `gpu` to run/debug on the
# GPU; backend/submode/arch come from the `gpu:` section of the project's
# `simple.sdn` (see gpu_config.spl) or from an auto-probe. Power users keep
# writing the full spec and it is passed through VERBATIM.
#
# The verbose grammar stays the canonical internal representation: this
# resolver only EXPANDS to it. Nothing downstream changes.
#
# This module is deliberately free of any GPU backend dependency: probing is
# injected through `GpuBackendProbe`, so the whole resolution matrix is
# unit-testable with a fake probe and no device. The live probe (which really
# constructs CudaLaneSession / VulkanLaneSession / MetalLaneSession) lives in
# gpu_mode_probe_live.spl.
#
# Parse helpers are REUSED from the test runner's pure-parser twin
# (test_executor_composite_parse.spl) rather than duplicated — that file is
# kept dependency-free for exactly this kind of caller.

use std.test_runner.test_executor_composite_parse.{
    extract_base_runtime, extract_remote_backend, extract_gpu_submode
}
use std.notebook.gpu_config.{GpuConfig, default_gpu_config}

# ============================================================================
# Probe seam
#
# `probe_backend` mirrors the repo-wide lane-session probe contract exactly
# (src/lib/gc_async_mut/gpu_lane/*_lane_session.spl `me probe() -> text`):
#   ""              -> backend usable
#   "skip:<reason>" -> backend absent for a stated, host-honest reason
#   anything else   -> blocked, reported verbatim
# Nothing here ever invents a reason; the string is passed through untouched.
# ============================================================================

trait GpuBackendProbe:
    me probe_backend(backend: text) -> text

# ============================================================================
# Resolution result
#
# `spec` is the canonical composite mode spec, or "" for the host lane.
# `target` is "host" | "cuda" | "vulkan" | "metal" — the row a doctor prints.
# `error` is "" on success; otherwise a complete, honest diagnostic that
# lists every backend's own skip reason (never a generic "no GPU found").
# ============================================================================

struct GpuModeResolution:
    spec: text
    target: text
    error: text

fn host_resolution() -> GpuModeResolution:
    """No tag -> host. `spec` is "" so callers keep today's behaviour byte for
    byte (DAP `{"type":"simple","program":"x.spl"}` stays the local session)."""
    GpuModeResolution(spec: "", target: "host", error: "")

fn resolution_error(message: text) -> GpuModeResolution:
    GpuModeResolution(spec: "", target: "", error: message)

# Auto-probe order is fixed by design §7b: cuda -> vulkan -> metal.
val GPU_AUTO_PROBE_ORDER = ["cuda", "vulkan", "metal"]

fn default_arch_for_backend(backend: text) -> text:
    """`arch: auto` expands to each backend's canonical default token — the
    same tokens test_executor_composite_parse.extract_target_from_spec falls
    back to when a spec omits them (sm80 / spv15 / msl2)."""
    if backend == "cuda": return "sm80"
    if backend == "cudagdb": return "sm80"
    if backend == "vulkan": return "spv15"
    if backend == "metal": return "msl2"
    ""

fn is_known_gpu_backend(backend: text) -> bool:
    backend == "cuda" or backend == "cudagdb" or backend == "vulkan" or backend == "metal"

fn compose_gpu_mode_spec(submode: text, backend: text, arch: text) -> text:
    """Build the canonical composite spec `<submode>(remote(<backend>(<arch>)))`.

    The result is exactly what a power user would have typed by hand, so the
    existing extractors round-trip it (asserted in the resolver spec)."""
    "{submode}(remote({backend}({arch})))"

fn is_bare_gpu_tag(tag: text) -> bool:
    """The ONLY distinction a casual user ever needs: bare `gpu` vs nothing.

    Accepts the spellings the three entry points produce: the `%gpu` cell
    magic ("gpu"), the DAP launch config `"gpu": true` ("true"), and the Lab
    API `{"gpu": true}` ("true"). Case-insensitive, whitespace-tolerant."""
    val t = tag.trim().to_lower()
    t == "gpu" or t == "true"

fn is_host_tag(tag: text) -> bool:
    """No tag at all, or an explicit host/false spelling."""
    val t = tag.trim().to_lower()
    t == "" or t == "host" or t == "false"

# ============================================================================
# resolve_gpu_mode_spec — the single shared helper (design §7b)
#
# Used by notebook magics, the Lab API, the DAP launch config, and
# `gpu_debug_session_for` alike. Resolution order, verbatim from the design:
#
#   1. Explicit full mode-spec given -> use it VERBATIM (power users
#      unaffected; not rewritten, not normalised, not re-probed).
#   2. Bare `gpu` tag -> expand from config:
#      `<submode>(remote(<backend>(<arch>)))`. `backend: auto` probes
#      cuda -> vulkan -> metal and picks the first non-skip; if none is
#      available, an honest error listing EACH backend's skip reason.
#   3. No tag -> host.
# ============================================================================

pub fn resolve_gpu_mode_spec(tag: text, config: GpuConfig, probe: GpuBackendProbe) -> GpuModeResolution:
    val trimmed = tag.trim()

    # --- 3. No tag -> host --------------------------------------------------
    if is_host_tag(trimmed):
        return host_resolution()

    # --- 1. Explicit full mode-spec -> verbatim -----------------------------
    # Anything that is not the bare `gpu`/`true` tag is a spec the user wrote
    # deliberately. It is returned unchanged; the target is read back out of
    # it with the existing extractor so doctors/routers still get a row name.
    if not is_bare_gpu_tag(trimmed):
        val backend = extract_remote_backend(trimmed)
        val target = if backend == "": "host" else: backend
        return GpuModeResolution(spec: trimmed, target: target, error: "")

    # --- 2. Bare `gpu` -> expand from config --------------------------------
    val submode = if config.submode.trim() == "": "interpreter" else: config.submode.trim()
    val configured = config.backend.trim().to_lower()

    if configured != "" and configured != "auto":
        if not is_known_gpu_backend(configured):
            return resolution_error(
                "gpu.backend: unknown backend '{configured}' in simple.sdn — expected auto | cuda | vulkan | metal")
        val arch = _resolved_arch(config, configured)
        if arch == "":
            return resolution_error("gpu.arch: no default arch known for backend '{configured}'")
        return GpuModeResolution(
            spec: compose_gpu_mode_spec(submode, configured, arch),
            target: configured,
            error: "")

    # backend: auto -> probe cuda -> vulkan -> metal, first non-skip wins.
    var reasons: [text] = []
    for backend in GPU_AUTO_PROBE_ORDER:
        val result = probe.probe_backend(backend)
        if result == "":
            val arch = _resolved_arch(config, backend)
            return GpuModeResolution(
                spec: compose_gpu_mode_spec(submode, backend, arch),
                target: backend,
                error: "")
        # Reason recorded VERBATIM from the backend's own probe — a Metal
        # "skip:metal-unavailable-not-macos" on Linux is a correct answer,
        # not a failure to be papered over.
        reasons.push("  {backend}: {result}")

    resolution_error(
        "gpu: no GPU backend available (gpu.backend: auto probed cuda -> vulkan -> metal)\n" + reasons.join("\n"))

fn _resolved_arch(config: GpuConfig, backend: text) -> text:
    """`arch: auto` (or unset) -> the backend's canonical default; an explicit
    arch in config is honoured as written."""
    val configured = config.arch.trim()
    if configured == "" or configured.to_lower() == "auto":
        return default_arch_for_backend(backend)
    configured

# ============================================================================
# Convenience wrapper for callers with no config file (defaults + probe).
# ============================================================================

pub fn resolve_gpu_mode_spec_default(tag: text, probe: GpuBackendProbe) -> GpuModeResolution:
    resolve_gpu_mode_spec(tag, default_gpu_config(), probe)

export GpuBackendProbe, GpuModeResolution, resolve_gpu_mode_spec
export resolve_gpu_mode_spec_default, compose_gpu_mode_spec
export default_arch_for_backend, is_bare_gpu_tag, is_host_tag
export is_known_gpu_backend, host_resolution, GPU_AUTO_PROBE_ORDER
