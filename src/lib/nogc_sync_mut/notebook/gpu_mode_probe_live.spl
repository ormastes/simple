# gpu_mode_probe_live — the real GpuBackendProbe.
#
# Design: doc/05_design/app/tools/gpu_debugger_common_interface_architecture_2026-08-09.md §7b
#
# Kept in its own file so gpu_mode_resolver.spl stays device-free and its
# full resolution matrix is unit-testable with a fake probe. This file is the
# ONLY place the resolver path touches real GPU lane sessions.
#
# Every reason string is the lane session's OWN probe output, passed through
# untouched:
#   cuda_lane_session.spl:154    "skip:cuda-driver-unavailable" | "skip:cuda-init-failed"
#                               | "skip:cuda-no-device" | "skip:cuda-device-ordinal-unavailable"
#   vulkan_lane_session.spl:116  "skip:vulkan-loader-unavailable" | "skip:vulkan-instance-init-failed"
#                               | "skip:vulkan-no-physical-device" | ...
#   metal_lane_session.spl:149   "skip:metal-unavailable-not-macos" | "skip:metal-no-physical-device" | ...
#
# On a Linux host, Metal answering "skip:metal-unavailable-not-macos" is the
# CORRECT result — `rt_metal_is_available()` hard-returns false when the
# runtime was not built for macOS. It is never treated as a failure and never
# substituted for.

use std.gpu_lane.cuda_lane_session.{CudaLaneSession}
use std.gpu_lane.vulkan_lane_session.{VulkanLaneSession}
use std.gpu_lane.metal_lane_session.{MetalLaneSession}
use std.notebook.gpu_mode_resolver.{GpuBackendProbe}

class LiveGpuBackendProbe:
    unused: i64

impl LiveGpuBackendProbe:
    static fn create() -> LiveGpuBackendProbe:
        LiveGpuBackendProbe(unused: 0)

impl GpuBackendProbe for LiveGpuBackendProbe:
    me probe_backend(backend: text) -> text:
        if backend == "cuda" or backend == "cudagdb":
            var session = CudaLaneSession.create()
            return session.probe()
        if backend == "vulkan":
            var session = VulkanLaneSession.create()
            return session.probe()
        if backend == "metal":
            var session = MetalLaneSession.create()
            return session.probe()
        "skip:unknown-backend-{backend}"

export LiveGpuBackendProbe
