# Lane Locks — exclusive-key registry guarding shared hardware lanes
# (JTAG/board/GPU) across concurrent notebook sessions and the test runner.
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream H, H2)
#
# K4's RemoteExec (remote_exec.spl) holds one live QEMU/OpenOCD/GHDL/T32
# process per (session, mode_spec) for the whole notebook session — a second
# session picking the same physical target (e.g. the one real JTAG-attached
# board) must not silently double-connect. This registry is the generic
# "who owns key K" answer that RemoteExec's own key (backend + board id) and
# a future GPU consumer (K5/K6, GPU plan A3) can both key into: the lock key
# is just a string, so callers choose their own scheme (e.g.
# "openocd_stm32h7", "jtag:board-7", "cuda:0").
#
# Reuses the repo-wide "blocked:<reason>" wording (types.spl's LaneStatus,
# same convention as src/lib/common/test_env_gate.spl) and the ghost-lock
# pid-liveness pattern already used by daemon_sdk/lock.spl and
# service/lease_manager.spl (rt_process_exists — kill(pid, 0) semantics, not
# waitpid-scoped like rt_process_is_alive, so it works for any live PID, not
# just a child of this process).
#
# Implemented as a `class` (not a `struct` mutated through free `fn`s, as
# lease_manager.spl does): under the tree-walk interpreter — the engine
# `bin/simple test` runs on — a struct argument is copied at the call
# boundary, so in-place field mutation inside a free `fn` (e.g.
# `mgr.leases.push(...)`) does not propagate back to the caller (verified:
# it diverges from the Cranelift JIT, which does share the struct). A class
# is heap-allocated and its `me` methods mutate the same instance the caller
# holds under both engines. Same "class over struct-mutating-fn" shape as
# KernelSessionManager (session_manager.spl).

extern fn rt_process_exists(pid: i64) -> bool
use std.io_runtime.{time_now_unix_micros}

# ============================================================================
# LaneLock — one held key.
# ============================================================================

struct LaneLock:
    key: text
    session_id: text
    pid: i64
    acquired_at_us: i64

# ============================================================================
# LaneLockRegistry — in-memory registry, one per test-runner/notebook-server
# process.
# ============================================================================

class LaneLockRegistry:
    locks: [LaneLock]

    static fn create() -> LaneLockRegistry:
        LaneLockRegistry(locks: [])

    # ------------------------------------------------------------------
    # Internal helpers
    # ------------------------------------------------------------------

    fn _find_index(key: text) -> i64:
        var i = 0
        while i < self.locks.len():
            if self.locks[i].key == key:
                return i
            i = i + 1
        -1

    me _remove_at(idx: i64):
        var kept: [LaneLock] = []
        var i = 0
        while i < self.locks.len():
            if i != idx:
                kept.push(self.locks[i])
            i = i + 1
        self.locks = kept

    # ------------------------------------------------------------------
    # Acquire
    # ------------------------------------------------------------------

    me acquire(key: text, session_id: text, pid: i64) -> text:
        """Try to acquire `key` for `session_id`/`pid`. Returns "" on
        success, else "blocked: lane held by session <id>" (types.spl
        LaneStatus wording).

        Idempotent: a session re-acquiring a key it already holds succeeds
        without changing the lock's acquired_at_us. A key whose previous
        holder process has died (stale lock) is silently reclaimed — the
        same ghost-lock behavior as lease_manager.spl's _reclaim_ghosts /
        daemon_sdk/lock.spl's try_acquire_daemon_lock."""
        val idx = self._find_index(key)
        if idx >= 0:
            val held = self.locks[idx]
            if held.session_id == session_id:
                return ""
            if is_pid_alive(held.pid):
                return "blocked: lane held by session {held.session_id}"
            # Stale-lock takeover: holder process died without releasing.
            self._remove_at(idx)

        val entry = LaneLock(
            key: key,
            session_id: session_id,
            pid: pid,
            acquired_at_us: time_now_unix_micros()
        )
        self.locks.push(entry)
        ""

    # ------------------------------------------------------------------
    # Release
    # ------------------------------------------------------------------

    me release(key: text, session_id: text) -> bool:
        """Explicit shutdown release. Returns true if `session_id` held
        `key` (lock removed), false if the key was unheld or held by
        another session (no-op — releasing another session's lock is not
        permitted)."""
        val idx = self._find_index(key)
        if idx < 0:
            return false
        if self.locks[idx].session_id != session_id:
            return false
        self._remove_at(idx)
        true

    me release_all_for_session(session_id: text) -> i64:
        """Release every key `session_id` holds (session shutdown). Returns
        the count released."""
        var kept: [LaneLock] = []
        var released = 0
        var i = 0
        while i < self.locks.len():
            val entry = self.locks[i]
            if entry.session_id == session_id:
                released = released + 1
            else:
                kept.push(entry)
            i = i + 1
        self.locks = kept
        released

    # ------------------------------------------------------------------
    # Query
    # ------------------------------------------------------------------

    fn holder(key: text) -> text:
        """Session id holding `key`, or "" if unheld/stale (does not itself
        reclaim — call acquire() to reclaim a stale lock)."""
        val idx = self._find_index(key)
        if idx < 0:
            return ""
        self.locks[idx].session_id

    fn is_held(key: text) -> bool:
        val idx = self._find_index(key)
        if idx < 0:
            return false
        is_pid_alive(self.locks[idx].pid)

# ============================================================================
# pid liveness (stale-lock takeover check)
# ============================================================================

pub fn is_pid_alive(pid: i64) -> bool:
    if pid <= 0:
        return false
    rt_process_exists(pid)
