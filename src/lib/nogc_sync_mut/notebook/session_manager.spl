# KernelSessionManager — session registry (id -> default mode -> executor
# cache), per-cell override resolution, spec validation passthrough.
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §2, §3, §4.1
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K1)
#
# Both the Jupyter kernel (via the Python transport wrapper) and Simple Lab
# (in-process) drive the same manager (design §2 "Both front doors reach the
# same KernelSessionManager").

use std.notebook.types.{CellResult, SessionOpts, session_opts_default, cell_result_error}
use std.notebook.executor.{NotebookExecutor, NotebookExecutorFactory, validate_mode_spec}

# ============================================================================
# ExecutorCacheEntry — one lane executor cached per session, keyed by the
# resolved mode spec that created it (so repeated %%mode cells targeting the
# same lane reuse the live session instead of re-spawning it).
# ============================================================================

class ExecutorCacheEntry:
    mode_spec: text
    executor: NotebookExecutor

# ============================================================================
# KernelSession — one notebook session: id, default mode (mutated by %mode),
# and its executor cache.
# ============================================================================

class KernelSession:
    id: text
    default_mode: text
    cache: [ExecutorCacheEntry]

    static fn create(id: text, default_mode: text) -> KernelSession:
        KernelSession(id: id, default_mode: default_mode, cache: [])

    fn resolve_mode(cell_override: text) -> text:
        """Per-cell override resolution: a non-empty %%mode override wins;
        otherwise falls back to the session default (design §3)."""
        if cell_override.trim() == "":
            self.default_mode
        else:
            cell_override.trim()

    fn find_cache_index(mode_spec: text) -> i64:
        var i = 0
        while i < self.cache.len():
            if self.cache[i].mode_spec == mode_spec:
                return i
            i = i + 1
        -1

# ============================================================================
# KernelSessionManager
# ============================================================================

class KernelSessionManager:
    factory: NotebookExecutorFactory
    sessions: [KernelSession]

    static fn create(factory: NotebookExecutorFactory) -> KernelSessionManager:
        KernelSessionManager(factory: factory, sessions: [])

    fn find_session_index(session_id: text) -> i64:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].id == session_id:
                return i
            i = i + 1
        -1

    fn session_exists(session_id: text) -> bool:
        self.find_session_index(session_id) >= 0

    fn session_count() -> i64:
        self.sessions.len()

    fn default_mode_of(session_id: text) -> text:
        """"" when the session does not exist."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return ""
        self.sessions[idx].default_mode

    me create_session(session_id: text, default_mode: text) -> text:
        """Register a new session. Returns "" on success, otherwise a
        diagnostic: duplicate session id, or the runner's invalid-mode-spec
        diagnostic passed through verbatim."""
        if self.session_exists(session_id):
            return "Session already exists: {session_id}"
        val diag = validate_mode_spec(default_mode)
        if diag != "":
            return diag
        self.sessions.push(KernelSession.create(id: session_id, default_mode: default_mode))
        ""

    me remove_session(session_id: text) -> bool:
        """Shut down every cached executor and drop the session. Returns
        false if the session did not exist."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return false
        val session = self.sessions[idx]
        var i = 0
        while i < session.cache.len():
            session.cache[i].executor.shutdown()
            i = i + 1
        var kept: [KernelSession] = []
        var j = 0
        while j < self.sessions.len():
            if j != idx:
                kept.push(self.sessions[j])
            j = j + 1
        self.sessions = kept
        true

    me set_default_mode(session_id: text, mode_spec: text) -> text:
        """%mode: change the session default. Returns "" on success, else a
        diagnostic (unknown session, or the invalid-spec diagnostic)."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return "Unknown session: {session_id}"
        val diag = validate_mode_spec(mode_spec)
        if diag != "":
            return diag
        var session = self.sessions[idx]
        session.default_mode = mode_spec
        self.sessions[idx] = session
        ""

    fn resolve_cell_mode(session_id: text, cell_override: text) -> text:
        """Per-cell override resolution (design §3 %%mode). Returns "" when
        the session does not exist."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return ""
        self.sessions[idx].resolve_mode(cell_override)

    me get_or_create_executor(session_id: text, mode_spec: text) -> text:
        """Ensure a cached, started executor exists for (session, mode_spec).
        Returns "" on success, else a diagnostic."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return "Unknown session: {session_id}"
        var session = self.sessions[idx]
        if session.find_cache_index(mode_spec) >= 0:
            return ""
        val diag = validate_mode_spec(mode_spec)
        if diag != "":
            return diag
        val executor = self.factory.create(mode_spec)
        executor.start(session_opts_default(session_id, mode_spec))
        session.cache.push(ExecutorCacheEntry(mode_spec: mode_spec, executor: executor))
        self.sessions[idx] = session
        ""

    me execute_cell(session_id: text, code: text, cell_id: text, cell_override: text) -> CellResult:
        """Resolve the cell's lane (default or %%mode override), lazily
        start/cache its executor, and run the cell. An unknown session or an
        invalid mode spec surfaces as a CellResult error (never a panic)."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return cell_result_error("Unknown session: {session_id}", 0)
        val mode_spec = self.sessions[idx].resolve_mode(cell_override)
        val diag = self.get_or_create_executor(session_id: session_id, mode_spec: mode_spec)
        if diag != "":
            return cell_result_error(diag, 0)
        val refreshed_idx = self.find_session_index(session_id)
        val session = self.sessions[refreshed_idx]
        val cache_idx = session.find_cache_index(mode_spec)
        session.cache[cache_idx].executor.execute_cell(code, cell_id)

    me reset_session(session_id: text) -> text:
        """%reset: reset every cached lane for this session. Returns "" on
        success, else "Unknown session: <id>"."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return "Unknown session: {session_id}"
        val session = self.sessions[idx]
        var i = 0
        while i < session.cache.len():
            session.cache[i].executor.reset()
            i = i + 1
        ""

    me interrupt_session(session_id: text, mode_spec: text) -> text:
        """Interrupt the cached executor for one lane. Returns "" on success,
        else a diagnostic."""
        val idx = self.find_session_index(session_id)
        if idx < 0:
            return "Unknown session: {session_id}"
        val session = self.sessions[idx]
        val cache_idx = session.find_cache_index(mode_spec)
        if cache_idx < 0:
            return "No active executor for mode: {mode_spec}"
        session.cache[cache_idx].executor.interrupt()
        ""
