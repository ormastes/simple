# lsp_bridge.spl — session-long Simple LSP subprocess bridge for
# complete_request/inspect_request (design §5.1).
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §5.1
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream P, P1)
#
# Reuses the real, rt_process_spawn_piped-backed `StdioProcessTransport` and
# the JSON-RPC message builders/parsers already shipped in
# `std.editor.services.lsp_transport` rather than reimplementing Content-Length
# framing. `LspClient` in that same module is NOT reused — it is still built on
# the stub `StdioTransport` (its own header comment says so), so this bridge
# talks to `StdioProcessTransport` directly and keeps its own tiny
# request/response loop.

use std.io_runtime.{file_exists}
use std.io_runtime.{thread_sleep}
use std.io_runtime.{file_write}
use std.io_runtime.{file_delete}
use std.io_runtime.{getpid}

use std.editor.services.lsp_transport.*

# ============================================================================
# Binary resolution — mirrors local_exec.spl's search order verbatim (kept as
# a separate copy rather than importing a private fn from that K2 file).
# ============================================================================

fn lsp_bridge_find_simple_bin() -> text:
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

# ============================================================================
# Tiny local JSON scanners for the two result shapes this bridge needs
# (CompletionItem[]'s "label" fields, Hover's "value" field). lsp_transport.spl
# already extracts the raw `result` JSON via `lsp_parse_response_result`; these
# just pull specific string fields out of that raw JSON, mirroring the
# index-of/substring extraction style already used in
# `src/app/jupyter_kernel/protocol.spl`.
# ============================================================================

fn _lsp_bridge_extract_all_labels(json: text) -> [text]:
    var labels: [text] = []
    val needle = "\"label\":\""
    var search_from = 0
    while true:
        val idx = json.slice(search_from, json.len()).index_of(needle)
        if idx < 0:
            break
        val start = search_from + idx + needle.len()
        var end_idx = start
        while end_idx < json.len() and json.char_at(end_idx) != "\"":
            if json.char_at(end_idx) == "\\":
                end_idx = end_idx + 1
            end_idx = end_idx + 1
        labels.push(json.slice(start, end_idx))
        search_from = end_idx + 1
    labels

fn _lsp_bridge_extract_first_value(json: text) -> text:
    val needle = "\"value\":\""
    val idx = json.index_of(needle)
    if idx < 0:
        return ""
    val start = idx + needle.len()
    var end_idx = start
    while end_idx < json.len() and json.char_at(end_idx) != "\"":
        if json.char_at(end_idx) == "\\":
            end_idx = end_idx + 1
        end_idx = end_idx + 1
    json.slice(start, end_idx)

# ============================================================================
# LspBridge — one session-long LSP subprocess. Started lazily on first use;
# a single synthetic document URI stands in for "the notebook's current
# cell" since the LSP protocol is file-shaped and the notebook is not.
# ============================================================================

pub class LspBridge:
    transport: StdioProcessTransport
    next_id: i64
    initialized: bool
    doc_uri: text
    doc_path: text
    doc_version: i64
    alive: bool

impl LspBridge:

    pub static fn start() -> LspBridge:
        val bin = lsp_bridge_find_simple_bin()
        val transport = StdioProcessTransport.new(bin, ["run", "src/app/lsp/main.spl"])
        # This LSP's completion/hover handlers (lsp_handlers.spl) shell out to
        # `query_visibility.spl completions/hover <path> <line> <col>` reading
        # the REAL FILE ON DISK at the URI path — they do not track an
        # in-memory buffer from didOpen/didChange (didChange is in fact a
        # no-op there). So the "current cell" has to be a real temp file this
        # bridge keeps rewriting, not just a synthetic URI.
        #
        # The path MUST match one of the two allowlisted absolute-path
        # prefixes in `sanitize_path` (src/app/cli/query_sanitize.spl):
        # `/tmp/simple_mcp_fmt_*.spl` or `/tmp/simple_lsp_test_*.spl` — any
        # other `/tmp/...` path (including the previous
        # `/tmp/simple_notebook_lsp_*.spl`) is rejected outright, so every
        # completions/hover call silently returns "[]"/"null" no matter what
        # the file contains. Verified empirically 2026-08-07: identical
        # fixture content returned zero completions under the old prefix and
        # real results under `/tmp/simple_lsp_test_*.spl`.
        val cell_path = "/tmp/simple_lsp_test_{getpid()}.spl"
        var bridge = LspBridge(
            transport: transport,
            next_id: 1,
            initialized: false,
            doc_uri: "file://" + cell_path,
            doc_path: cell_path,
            doc_version: 0,
            alive: transport.pid > 0
        )
        if bridge.alive:
            bridge._handshake()
        bridge

    me _next_id() -> i64:
        val id = self.next_id
        self.next_id = id + 1
        id

    me _handshake():
        val id = self._next_id()
        val params = lsp_build_initialize_params("file:///notebook", "simple-notebook")
        self.transport.send("{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"initialize\",\"params\":" + params + "}")
        val result = self._await_response(id)
        if result != "":
            self.initialized = true
            self.transport.send("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")

    me _await_response(id: i64) -> text:
        """Sequential single-in-flight-request wait: this bridge never has
        two requests outstanding at once, so a non-matching frame (there
        should not be one) is simply dropped rather than queued."""
        var attempts = 0
        while attempts < 200:
            match self.transport.receive_result():
                case Ok(Some(json)):
                    if lsp_is_response(json) and lsp_parse_response_id(json) == id:
                        return lsp_parse_response_result(json)
                case Ok(nil): thread_sleep(25)
                case Err(_):
                    self.alive = false
                    return ""
                case _("fail closed if Result gains another variant"):
                    self.alive = false
                    return ""
            attempts = attempts + 1
        ""

    me _sync_doc(code: text):
        """Write the cell's current text to the bridge's real temp file, then
        tell the server via didOpen/didChange (for its diagnostics path) —
        but the file write is what completion/hover actually read."""
        file_write(self.doc_path, code)
        self.doc_version = self.doc_version + 1
        if self.doc_version == 1:
            val params = lsp_build_did_open_params(self.doc_uri, "simple", self.doc_version, code)
            self.transport.send("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":" + params + "}")
        else:
            val params = lsp_build_did_change_params(self.doc_uri, self.doc_version, code)
            self.transport.send("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":" + params + "}")

    # @tag(line=position_line, col=position_col)
    pub me complete(code: text, line: i64, col: i64) -> [text]:
        """Cell text -> completion labels at (line, col). Empty list when the
        bridge failed to start or hasn't initialized (never a panic)."""
        if not self.alive or not self.initialized:
            return []
        self._sync_doc(code)
        val id = self._next_id()
        val params = lsp_build_position_params(self.doc_uri, line, col)
        self.transport.send("{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"textDocument/completion\",\"params\":" + params + "}")
        val result = self._await_response(id)
        _lsp_bridge_extract_all_labels(result)

    # @tag(line=position_line, col=position_col)
    pub me inspect(code: text, line: i64, col: i64) -> text:
        """Cell text -> hover text at (line, col). "" when unavailable."""
        if not self.alive or not self.initialized:
            return ""
        self._sync_doc(code)
        val id = self._next_id()
        val params = lsp_build_position_params(self.doc_uri, line, col)
        self.transport.send("{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"textDocument/hover\",\"params\":" + params + "}")
        val result = self._await_response(id)
        _lsp_bridge_extract_first_value(result)

    pub me shutdown():
        if not self.alive:
            return
        val id = self._next_id()
        self.transport.send("{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"shutdown\",\"params\":null}")
        val _ = self._await_response(id)
        self.transport.send("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
        self.transport.close()
        file_delete(self.doc_path)
        self.alive = false
