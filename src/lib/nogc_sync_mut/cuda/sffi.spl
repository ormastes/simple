# CUDA SFFI Bindings (NoGC)
#
# Canonical low-level CUDA declarations for the pure Simple stack.
# These signatures match the Rust runtime exports in
# `src/compiler_rust/runtime/src/cuda_runtime.rs`.

# ============================================================================
# Runtime Availability
# ============================================================================

@unsafe(reason: "raw CUDA ABI; foreign implementation is not compiler-validated", capabilities: [ffi])
extern fn rt_cuda_available() -> i64

