# CUDA Simple API (NoGC)
#
# Thin, hand-maintained wrapper over the canonical runtime CUDA ABI.
# This replaces the previous autogenerated scaffold, which referenced
# symbols that do not exist in the runtime.

use std.nogc_sync_mut.cuda.sffi.*

val CUDA_SUCCESS = 0
val CUDA_ERROR_INVALID_VALUE = -1
val CUDA_ERROR_OUT_OF_MEMORY = -2
val CUDA_ERROR_NOT_INITIALIZED = -3
val CUDA_ERROR_NO_DEVICE = -100

fn cuda_available() -> bool:
    rt_cuda_available() != 0

fn cuda_init() -> i64:
    rt_cuda_init()

fn cuda_device_count() -> i64:
    rt_cuda_device_count()

fn cuda_device_get(device_id: i64) -> i64:
    rt_cuda_device_get(device_id)

fn cuda_device_identity(device: i64) -> i64:
    rt_cuda_device_identity(device)

fn cuda_device_name(device: i64) -> text:
    rt_cuda_device_name(device)

# Device name by ordinal (0..cuda_device_count()); cuda_device_name takes
# the handle from cuda_device_get.
fn cuda_get_device_name(device_id: i64) -> text:
    cuda_device_name(cuda_device_get(device_id))

fn cuda_device_compute_capability(device: i64) -> i64:
    rt_cuda_device_compute_capability(device)

fn cuda_ctx_create(device: i64) -> i64:
    rt_cuda_ctx_create(device)

fn cuda_ctx_set_current(ctx: i64) -> i64:
    rt_cuda_ctx_set_current(ctx)

fn cuda_ctx_destroy(ctx: i64) -> i64:
    rt_cuda_ctx_destroy(ctx)

fn cuda_ctx_synchronize() -> i64:
    rt_cuda_ctx_synchronize()

fn cuda_mem_alloc(size: i64) -> i64:
    rt_cuda_mem_alloc(size)

fn cuda_mem_free(ptr: i64) -> i64:
    rt_cuda_mem_free(ptr)

fn cuda_memcpy_htod(dst: i64, src: i64, size: i64) -> i64:
    rt_cuda_memcpy_htod(dst, src, size)

fn cuda_memcpy_dtoh(dst: i64, src: i64, size: i64) -> i64:
    rt_cuda_memcpy_dtoh(dst, src, size)

fn cuda_memcpy_dtod(dst: i64, src: i64, size: i64) -> i64:
    rt_cuda_memcpy_dtod(dst, src, size)

fn cuda_memset(ptr: i64, value: i64, size: i64) -> i64:
    rt_cuda_memset(ptr, value, size)

fn cuda_memset_d32(ptr: i64, pattern: i64, count: i64) -> i64:
    """Fill device memory with a 32-bit pattern (CUDA cuMemsetD32_v2).

    `count` is a number of 32-BIT ELEMENTS, NOT bytes, and `ptr` must be 4-byte
    aligned. Use this -- never the byte-granularity cuda_memset -- whenever the
    fill value does not fit in a single byte: cuda_memset replicates its value
    across all four bytes of every word, so `cuda_memset(p, 1, n * 4)` writes
    0x01010101 (16843009) into each i32 rather than 1.
    """
    rt_cuda_memset_d32(ptr, pattern, count)

fn cuda_module_load(path: text) -> i64:
    rt_cuda_module_load(path)

fn cuda_module_load_data(ptx: text) -> i64:
    rt_cuda_module_load_data(ptx)

fn cuda_module_unload(module: i64) -> i64:
    rt_cuda_module_unload(module)

fn cuda_module_get_function(module: i64, func_name: text) -> i64:
    rt_cuda_module_get_function(module, func_name)

fn cuda_launch_kernel(module: i64, func_name: text, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, args_ptr: i64) -> i64:
    rt_cuda_launch_kernel(module, func_name, grid_x, grid_y, grid_z, block_x, block_y, block_z, args_ptr)

fn cuda_sync() -> i64:
    rt_cuda_sync()

fn cuda_get_error_string(error_code: i64) -> text:
    rt_cuda_get_error_string(error_code)

# ============================================================================
# Streams / Events / Async copies (plan E2, 2026-08-25)
# ============================================================================
# Real driver streams: cuda_stream_create() returns a CUstream handle
# (positive) from cuStreamCreate; handle 0 is the legacy default stream and
# stays valid everywhere a stream is taken (cuda_default_stream()).
# Sentinel convention as for CudaModule: a handle < 0 is a failed create.
val CUDA_STREAM_DEFAULT = 0
val CUDA_STREAM_NON_BLOCKING = 1
val CUDA_EVENT_DEFAULT = 0

fn cuda_memcpy_htod_async(dst: i64, src: i64, size: i64, stream: i64) -> i64:
    rt_cuda_memcpy_htod_async(dst, src, size, stream)

fn cuda_memcpy_dtoh_async(dst: i64, src: i64, size: i64, stream: i64) -> i64:
    rt_cuda_memcpy_dtoh_async(dst, src, size, stream)

fn cuda_launch_kernel_ex(module: i64, func_name: text, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, shared_bytes: i64, stream: i64, args_ptr: i64) -> i64:
    rt_cuda_launch_kernel_ex(module, func_name, grid_x, grid_y, grid_z, block_x, block_y, block_z, shared_bytes, stream, args_ptr)

# Same shape as before (handle + is_valid fields) so existing callers keep
# working; the difference is that create() now asks the driver for a stream.
struct CudaStream:
    handle: i64
    is_valid: bool

fn cuda_stream_create_flags(flags: i64) -> CudaStream:
    val h = rt_cuda_stream_create(flags)
    CudaStream(handle: h, is_valid: h > 0)

fn cuda_stream_create() -> CudaStream:
    cuda_stream_create_flags(CUDA_STREAM_DEFAULT)

# The legacy default (null) stream: always valid when a driver is present.
fn cuda_default_stream() -> CudaStream:
    CudaStream(handle: 0, is_valid: cuda_available())

# Destroying the default stream or an invalid one is a no-op success.
fn cuda_stream_destroy(stream: CudaStream) -> bool:
    if stream.handle <= 0:
        return true
    rt_cuda_stream_destroy(stream.handle) == 0

fn cuda_stream_sync(stream: CudaStream) -> bool:
    if not stream.is_valid:
        return true
    rt_cuda_stream_synchronize(stream.handle) == 0

class CudaEvent:
    handle: i64

impl CudaEvent:
    fn is_valid() -> bool:
        self.handle > 0

    fn record(stream: CudaStream) -> bool:
        if not self.is_valid() or not stream.is_valid:
            return false
        rt_cuda_event_record(self.handle, stream.handle) == 0

    fn synchronize() -> bool:
        if not self.is_valid():
            return false
        rt_cuda_event_synchronize(self.handle) == 0

    # Milliseconds from `self` (recorded first) to `end`; negative on error.
    fn elapsed_ms(end: CudaEvent) -> f64:
        if not self.is_valid() or not end.is_valid():
            return -1.0
        rt_cuda_event_elapsed_ms(self.handle, end.handle)

    fn destroy() -> bool:
        if self.handle <= 0:
            return true
        val rc = rt_cuda_event_destroy(self.handle)
        self.handle = 0
        rc == 0

fn cuda_event_create() -> CudaEvent:
    CudaEvent(handle: rt_cuda_event_create(CUDA_EVENT_DEFAULT))
