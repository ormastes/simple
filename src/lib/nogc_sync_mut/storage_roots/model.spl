"""Platform resolver records for the centralized two-root storage policy."""

use std.common.storage_roots.{StorageRootInspection, StorageRoots, StorageReceipt}

pub enum StoragePlatform:
    MacOS
    Linux
    Windows
    SimpleOS

pub struct StorageRootOverrides:
    """Explicit command-line projection. Nil means no CLI override; empty is invalid."""
    user_root: text?
    worktree_root: text?

pub struct StorageRootEnvironmentSnapshot:
    """Allowlisted environment values captured by the sole ambient owner."""
    user_root: text?
    worktree_root: text?
    home: text?
    xdg_cache_home: text?
    local_app_data: text?

pub struct StorageRootResolverInput:
    """Inert fixture-friendly input. Resolution performs no ambient reads or writes."""
    platform: StoragePlatform
    cli: StorageRootOverrides
    environment: StorageRootEnvironmentSnapshot
    canonical_worktree: text
    worktree_metadata: text

pub struct StorageRootResolution:
    roots: StorageRoots
    inspection: StorageRootInspection
    receipts: [StorageReceipt]

