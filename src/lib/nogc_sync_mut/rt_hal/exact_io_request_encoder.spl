# codex-impl
# Cold parent serializer for the frozen HIO2 request and replay-effect frames.
# All destination bytes are written directly into controller-owned wire slots;
# no foreign identity receipt/generation is serialized.

use std.nogc_sync_mut.rt_hal.exact_io_schema.{
    RtHalExactIoArena,RtHalExactIoBounds,RtHalExactIoRequestRow,
    RtHalExactIoReceiptRow,RtHalExactByteSpan,rt_hal_exact_io_arena_error
}
use std.common.rt_hal.exact_type_id.{RtHalExactTypeForeignCandidate}
use std.nogc_sync_mut.rt_hal.exact_io_wire_owner.{
    RT_HAL_EXACT_WIRE_REQUEST,RtHalExactWireHandle,
    rt_hal_exact_wire_reserve,rt_hal_exact_wire_append_byte,
    rt_hal_exact_wire_freeze,rt_hal_exact_wire_release,
    rt_hal_exact_wire_bind_replay_pair
}

pub struct RtHalExactIoEncodedInput:
    request: RtHalExactWireHandle
    effect: RtHalExactWireHandle
    replay: bool
    valid: bool

fn encoder_invalid() ->RtHalExactIoEncodedInput:
    RtHalExactIoEncodedInput(request:-1,effect:-1,replay:false,valid:false)

fn encoder_u8(handle: RtHalExactWireHandle,value: i64) ->bool:
    value>=0 and value<=255 and rt_hal_exact_wire_append_byte(handle,value as u8)

fn encoder_u32(handle: RtHalExactWireHandle,value: i64) ->bool:
    if value<0 or value>4294967295:return false
    var lane=0
    while lane<4:
        if not encoder_u8(handle,(value>>(lane*8))&255):return false
        lane=lane+1
    true

fn encoder_i64(handle: RtHalExactWireHandle,value: i64) ->bool:
    val bits=value as u64;var lane=0
    while lane<8:
        if not encoder_u8(handle,((bits>>(lane*8))&255u64) as i64):return false
        lane=lane+1
    true

fn encoder_span(handle: RtHalExactWireHandle,arena: RtHalExactIoArena,
        span: RtHalExactByteSpan) ->bool:
    if span.offset<0 or span.length<0 or span.offset>arena.bytes.len() or
       span.length>arena.bytes.len()-span.offset:return false
    var lane=0
    while lane<span.length:
        if not rt_hal_exact_wire_append_byte(handle,arena.bytes[span.offset+lane]):return false
        lane=lane+1
    true

fn encoder_candidate(handle: RtHalExactWireHandle,arena: RtHalExactIoArena,
        candidate: RtHalExactTypeForeignCandidate,descriptor: RtHalExactByteSpan) ->bool:
    if not candidate.valid or candidate.descriptor_length!=descriptor.length:return false
    if (not encoder_i64(handle,candidate.schema_version) or
        not encoder_i64(handle,candidate.lane0) or
        not encoder_i64(handle,candidate.lane1) or
        not encoder_i64(handle,candidate.lane2) or
        not encoder_i64(handle,candidate.lane3) or
        not encoder_i64(handle,candidate.descriptor_length) or
        not encoder_u32(handle,1) or
        not encoder_u32(handle,descriptor.length)):
        return false
    encoder_span(handle,arena,descriptor)

fn encoder_release_pair(request: RtHalExactWireHandle,effect: RtHalExactWireHandle):
    if request>0:rt_hal_exact_wire_release(request)
    if effect>0:rt_hal_exact_wire_release(effect)

pub fn rt_hal_exact_io_encode_input(arena: RtHalExactIoArena,
        bounds: RtHalExactIoBounds,request_index: i64,receipt_index: i64,
        replay: bool) ->RtHalExactIoEncodedInput:
    if rt_hal_exact_io_arena_error(arena,bounds)!="" or request_index<0 or
       request_index>=arena.requests.len() or receipt_index<0 or
       receipt_index>=arena.receipts.len():return encoder_invalid()
    val request_row=arena.requests[request_index]
    val receipt_row=arena.receipts[receipt_index]
    if receipt_row.request_index!=request_index or
       receipt_row.case_id!=request_row.case_id or
       receipt_row.schema_id!=request_row.schema_id:return encoder_invalid()
    val request=rt_hal_exact_wire_reserve(RT_HAL_EXACT_WIRE_REQUEST,
        request_row.case_id,request_index,0)
    if request<=0:return encoder_invalid()
    var effect: RtHalExactWireHandle=-1
    if replay:
        effect=rt_hal_exact_wire_reserve(RT_HAL_EXACT_WIRE_REQUEST,
            request_row.case_id,request_index,0)
        if effect<=0:
            encoder_release_pair(request,effect);return encoder_invalid()
    # HIO2 fixed header.
    if (not encoder_u32(request,0x324f4948) or not encoder_u32(request,2) or
        not encoder_i64(request,request_row.case_id) or
        not encoder_i64(request,request_index) or
        not encoder_i64(request,request_row.schema_id)):
        encoder_release_pair(request,effect);return encoder_invalid()
    if (not encoder_candidate(request,arena,request_row.operation_type,
            request_row.operation_type_descriptor) or
        not encoder_candidate(request,arena,request_row.input_type,
            request_row.input_type_descriptor) or
        not encoder_candidate(request,arena,receipt_row.output_type,
            receipt_row.output_type_descriptor) or
        not encoder_candidate(request,arena,receipt_row.error_type,
            receipt_row.error_type_descriptor) or
        not encoder_candidate(request,arena,receipt_row.effect_type,
            receipt_row.effect_type_descriptor)):
        encoder_release_pair(request,effect);return encoder_invalid()
    # Fixed metadata precedes variable spans, matching both foreign providers.
    if (not encoder_u32(request,request_row.operation as i64) or
        not encoder_u32(request,request_row.operation_encoding as i64) or
        not encoder_u32(request,request_row.operation_domain as i64) or
        not encoder_u32(request,request_row.operation_identity.length) or
        not encoder_u32(request,request_row.operation_events.length) or
        not encoder_u32(request,request_row.input_encoding as i64) or
        not encoder_u32(request,request_row.input_domain as i64) or
        not encoder_u32(request,request_row.input.length) or
        not encoder_u32(request,request_row.input_events.length) or
        not encoder_u32(request,receipt_row.output_encoding as i64) or
        not encoder_u32(request,receipt_row.error_encoding as i64) or
        not encoder_u32(request,receipt_row.effect_encoding as i64) or
        not encoder_span(request,arena,request_row.operation_identity) or
        not encoder_span(request,arena,request_row.operation_events) or
        not encoder_span(request,arena,request_row.input) or
        not encoder_span(request,arena,request_row.input_events)):
        encoder_release_pair(request,effect);return encoder_invalid()
    if not rt_hal_exact_wire_freeze(request):
        encoder_release_pair(request,effect);return encoder_invalid()
    if replay:
        if (not encoder_u32(effect,receipt_row.effect.length) or
            not encoder_u32(effect,receipt_row.effect_events.length) or
            not encoder_span(effect,arena,receipt_row.effect) or
            not encoder_span(effect,arena,receipt_row.effect_events) or
            not rt_hal_exact_wire_freeze(effect)):
            encoder_release_pair(request,effect);return encoder_invalid()
        if not rt_hal_exact_wire_bind_replay_pair(request,effect,
                request_row.schema_id):
            encoder_release_pair(request,effect);return encoder_invalid()
    RtHalExactIoEncodedInput(request:request,effect:effect,replay:replay,valid:true)

pub fn rt_hal_exact_io_encoded_input_release(input: RtHalExactIoEncodedInput) ->bool:
    if not input.valid:return false
    val request_released=rt_hal_exact_wire_release(input.request)
    val effect_released=if input.replay:rt_hal_exact_wire_release(input.effect) else:true
    request_released and effect_released
