# codex-impl
# Safe owner-result RT/HAL arena boundary. Child boundaries carry scalar
# encoded input, opaque handles, and scalar receipts only.

use std.common.rt_hal.model.{
    RtHalComparison, RtHalOperationKind, RtHalProviderKind,
    RtHalRequest, RtHalWorkItem, rt_hal_comparison_error
}

pub enum RtHalParallelStatus:
    Value
    Mismatch
    Unsupported
    TimedOut
    CancelFailed
    Invalid

# Compatibility descriptors retained for the concurrent tag/boundary lane.
# The tagged facade may invoke the Pure callback synchronously on its owner;
# foreign callbacks remain forbidden because they cannot prove timed
# cancellation or frozen scalar transport.
pub struct RtHalPureTaskAdapter:
    provider_id: text
    query_word_fn: fn(RtHalWorkItem) -> i64
    effect_word_fn: fn(RtHalWorkItem) -> i64

pub struct RtHalComparatorTaskAdapter:
    provider_id: text
    query_word_fn: fn(RtHalWorkItem) -> i64
    replay_word_fn: fn(RtHalWorkItem) -> i64

pub struct RtHalParallelResult:
    provider_ordinal: i64
    case_index: i64
    case_id: i64
    provider_id: text
    status: RtHalParallelStatus
    receipt_word: i64
    matches_pure: bool
    used_runtime_pool: bool

pub struct RtHalParallelReport:
    results: [RtHalParallelResult]
    error: text
    submitted_tasks: i64
    completed_tasks: i64
    dispatch_rounds: i64
    max_parallel_width: i64
    actual_parallel: bool

pub struct RtHalEncodedRequest:
    case_id: i64
    operation: RtHalOperationKind
    operation_word: i64
    input_word: i64
    trace_word: i64

pub struct RtHalArenaJoin:
    completed: bool
    outcome_word: i64
    trace_word: i64
    error_word: i64

pub struct RtHalTaskArenaCapabilities:
    available: bool
    bounded_queue: bool
    bounded_timed_join: bool
    cancellation: bool
    frozen_scalar_input: bool
    isolated_scalar_result: bool

pub struct RtHalTaskArenaPort:
    capabilities: RtHalTaskArenaCapabilities
    spawn_query_fn: fn(i64, RtHalEncodedRequest) -> i64
    spawn_replay_fn: fn(i64, RtHalEncodedRequest) -> i64
    join_until_fn: fn(i64, i64) -> RtHalArenaJoin
    cancel_fn: fn(i64) -> bool
    execute_pure_effect_fn: fn(i64, RtHalEncodedRequest, i64) -> RtHalArenaJoin

pub struct RtHalDelegatedProvider:
    provider_id: text
    kind: RtHalProviderKind
    adapter_handle: i64
    query_capable: bool
    replay_capable: bool
    effect_capable: bool

pub struct RtHalProviderRegistry:
    providers: [RtHalDelegatedProvider]

pub struct RtHalSafeParallelResult:
    provider_ordinal: i64
    case_index: i64
    case_id: i64
    provider_id: text
    status: RtHalParallelStatus
    outcome_word: i64
    trace_word: i64
    error_word: i64
    matches_pure: bool

pub struct RtHalSafeParallelReport:
    results: [RtHalSafeParallelResult]
    error: text
    submitted_tasks: i64
    completed_tasks: i64
    cancelled_tasks: i64
    dispatch_rounds: i64
    max_parallel_width: i64
    actual_parallel: bool

pub fn rt_hal_provider_registry(providers: [RtHalDelegatedProvider]) -> RtHalProviderRegistry:
    RtHalProviderRegistry(providers: providers)

pub fn rt_hal_provider_registry_error(registry: RtHalProviderRegistry) -> text:
    if registry.providers.len() <= 0:
        return "RTHAL-E-PROVIDER-ID"
    var index = 0
    while index < registry.providers.len():
        val provider = registry.providers[index]
        if provider.provider_id.trim() == "" or provider.adapter_handle <= 0:
            return "RTHAL-E-PROVIDER-ID"
        if index == 0:
            if provider.kind != RtHalProviderKind.PureSimple or not provider.effect_capable:
                return "RTHAL-E-PURE-OWNER"
        elif provider.kind == RtHalProviderKind.PureSimple or provider.effect_capable:
            return "RTHAL-E-UNSAFE-REPLAY"
        var prior = 0
        while prior < index:
            if registry.providers[prior].provider_id == provider.provider_id:
                return "RTHAL-E-PROVIDER-DUPLICATE"
            prior = prior + 1
        index = index + 1
    ""

pub fn rt_hal_task_arena_error(port: RtHalTaskArenaPort) -> text:
    val cap = port.capabilities
    if not cap.available or not cap.bounded_queue:
        return "RTHAL-W-PARALLEL-UNSUPPORTED"
    if not cap.bounded_timed_join or not cap.cancellation:
        return "RTHAL-W-PARALLEL-UNSUPPORTED"
    if not cap.frozen_scalar_input or not cap.isolated_scalar_result:
        return "RTHAL-W-PARALLEL-UNSUPPORTED"
    ""

fn rt_hal_invalid_join() -> RtHalArenaJoin:
    RtHalArenaJoin(completed: false, outcome_word: -1, trace_word: -1, error_word: -1)

fn rt_hal_unavailable_spawn(adapter_handle: i64, request: RtHalEncodedRequest) -> i64:
    -1

fn rt_hal_unavailable_join(task_handle: i64, deadline_ticks: i64) -> RtHalArenaJoin:
    rt_hal_invalid_join()

fn rt_hal_unavailable_cancel(task_handle: i64) -> bool:
    false

fn rt_hal_unavailable_effect(adapter_handle: i64, request: RtHalEncodedRequest, deadline_ticks: i64) -> RtHalArenaJoin:
    rt_hal_invalid_join()

pub fn rt_hal_unavailable_task_arena() -> RtHalTaskArenaPort:
    RtHalTaskArenaPort(
        capabilities: RtHalTaskArenaCapabilities(
            available: false, bounded_queue: false,
            bounded_timed_join: false, cancellation: false,
            frozen_scalar_input: true, isolated_scalar_result: true
        ),
        spawn_query_fn: rt_hal_unavailable_spawn,
        spawn_replay_fn: rt_hal_unavailable_spawn,
        join_until_fn: rt_hal_unavailable_join,
        cancel_fn: rt_hal_unavailable_cancel,
        execute_pure_effect_fn: rt_hal_unavailable_effect
    )

pub fn rt_hal_execute_parallel(comparison: RtHalComparison, requests: [RtHalRequest], pure: RtHalPureTaskAdapter, comparators: [RtHalComparatorTaskAdapter]) -> RtHalParallelReport:
    RtHalParallelReport(
        results: [], error: "RTHAL-W-PARALLEL-UNSUPPORTED",
        submitted_tasks: 0, completed_tasks: 0, dispatch_rounds: 0,
        max_parallel_width: 0, actual_parallel: false
    )

fn rt_hal_empty_result(ordinal: i64, case_index: i64, case_id: i64, provider_id: text) -> RtHalSafeParallelResult:
    RtHalSafeParallelResult(
        provider_ordinal: ordinal, case_index: case_index, case_id: case_id,
        provider_id: provider_id, status: RtHalParallelStatus.Invalid,
        outcome_word: -1, trace_word: -1, error_word: -1,
        matches_pure: false
    )

fn rt_hal_report(results: [RtHalSafeParallelResult], error: text, submitted: i64, completed: i64, cancelled: i64, rounds: i64, width: i64, parallel: bool) -> RtHalSafeParallelReport:
    RtHalSafeParallelReport(
        results: results, error: error, submitted_tasks: submitted,
        completed_tasks: completed, cancelled_tasks: cancelled,
        dispatch_rounds: rounds, max_parallel_width: width,
        actual_parallel: parallel
    )

fn rt_hal_results_error(results: [RtHalSafeParallelResult], provider_count: i64, case_count: i64, require_all: bool) -> text:
    var case_index = 0
    while case_index < case_count:
        val pure = results[case_index * provider_count]
        if pure.status == RtHalParallelStatus.TimedOut:
            return "RTHAL-E-TIMEOUT"
        if pure.status == RtHalParallelStatus.CancelFailed:
            return "RTHAL-E-CANCEL"
        if pure.status != RtHalParallelStatus.Value:
            return "RTHAL-W-UNSUPPORTED"
        var ordinal = 1
        while ordinal < provider_count:
            val result = results[case_index * provider_count + ordinal]
            if result.status == RtHalParallelStatus.TimedOut:
                return "RTHAL-E-TIMEOUT"
            if result.status == RtHalParallelStatus.CancelFailed:
                return "RTHAL-E-CANCEL"
            if result.status == RtHalParallelStatus.Unsupported:
                if require_all:
                    return "RTHAL-W-UNSUPPORTED"
            elif result.status == RtHalParallelStatus.Mismatch:
                return "RTHAL-E-MISMATCH"
            elif result.status != RtHalParallelStatus.Value:
                return "RTHAL-E-RESULT-MISSING"
            ordinal = ordinal + 1
        case_index = case_index + 1
    ""

# Actual tasks are owned by the injected arena. This layer admits only an
# arena proving bounded timed join, cancellation, and scalar transport.
pub fn rt_hal_execute_parallel_safe(comparison: RtHalComparison, requests: [RtHalEncodedRequest], registry: RtHalProviderRegistry, arena: RtHalTaskArenaPort) -> RtHalSafeParallelReport:
    val provider_count = registry.providers.len()
    var results: [RtHalSafeParallelResult] = []
    val arena_error = rt_hal_task_arena_error(arena)
    if arena_error != "":
        return rt_hal_report(results, arena_error, 0, 0, 0, 0, 0, false)
    val registry_error = rt_hal_provider_registry_error(registry)
    if registry_error != "":
        return rt_hal_report(results, registry_error, 0, 0, 0, 0, 0, false)
    val comparison_error = rt_hal_comparison_error(comparison)
    if comparison_error != "":
        return rt_hal_report(results, comparison_error, 0, 0, 0, 0, 0, false)
    if provider_count != comparison.providers.len() or requests.len() <= 0:
        return rt_hal_report(results, "RTHAL-E-PROVIDER-ID", 0, 0, 0, 0, 0, false)
    if requests.len() > comparison.queue_capacity / provider_count:
        return rt_hal_report(results, "RTHAL-E-BOUND", 0, 0, 0, 0, 0, false)
    val slot_count = requests.len() * provider_count
    if slot_count > comparison.max_output_bytes / 96:
        return rt_hal_report(results, "RTHAL-E-MEMORY-BOUND", 0, 0, 0, 0, 0, false)
    var ordinal = 0
    while ordinal < provider_count:
        if registry.providers[ordinal].provider_id != comparison.providers[ordinal].provider_id or registry.providers[ordinal].kind != comparison.providers[ordinal].kind:
            return rt_hal_report(results, "RTHAL-E-PROVIDER-ID", 0, 0, 0, 0, 0, false)
        ordinal = ordinal + 1
    var case_index = 0
    while case_index < requests.len():
        val request = requests[case_index]
        if request.case_id < 0 or request.operation_word < 0 or request.input_word < 0:
            return rt_hal_report(results, "RTHAL-E-REQUEST", 0, 0, 0, 0, 0, false)
        if case_index > 0 and request.case_id <= requests[case_index - 1].case_id:
            val code = if request.case_id == requests[case_index - 1].case_id: "RTHAL-E-CASE-DUPLICATE" else: "RTHAL-E-CASE-ORDER"
            return rt_hal_report(results, code, 0, 0, 0, 0, 0, false)
        case_index = case_index + 1

    case_index = 0
    while case_index < requests.len():
        ordinal = 0
        while ordinal < provider_count:
            results.push(rt_hal_empty_result(
                ordinal, case_index, requests[case_index].case_id,
                registry.providers[ordinal].provider_id
            ))
            ordinal = ordinal + 1
        case_index = case_index + 1

    var submitted = 0
    var completed = 0
    var cancelled = 0
    var rounds = 0
    var max_width = 0
    case_index = 0
    while case_index < requests.len():
        val request = requests[case_index]
        val base = case_index * provider_count
        var first_ordinal = 0
        if request.operation == RtHalOperationKind.Effectful:
            val pure_join = arena.execute_pure_effect_fn(registry.providers[0].adapter_handle, request, comparison.timeout_ticks)
            if not pure_join.completed:
                return rt_hal_report(results, "RTHAL-E-TIMEOUT", submitted, completed, cancelled, rounds, max_width, false)
            if pure_join.outcome_word < 0 or pure_join.trace_word < 0 or pure_join.error_word < 0:
                return rt_hal_report(results, "RTHAL-E-UNSAFE-REPLAY", submitted, completed, cancelled, rounds, max_width, false)
            results[base] = RtHalSafeParallelResult(
                provider_ordinal: 0, case_index: case_index,
                case_id: request.case_id, provider_id: registry.providers[0].provider_id,
                status: RtHalParallelStatus.Value,
                outcome_word: pure_join.outcome_word, trace_word: pure_join.trace_word,
                error_word: pure_join.error_word, matches_pure: true
            )
            first_ordinal = 1
        var wave_start = first_ordinal
        while wave_start < provider_count:
            var handles: [i64] = []
            var ordinals: [i64] = []
            var width = 0
            while width < comparison.worker_count and wave_start + width < provider_count:
                val current = wave_start + width
                val provider = registry.providers[current]
                var encoded = request
                var handle = -1
                if current == 0 and provider.query_capable:
                    handle = arena.spawn_query_fn(provider.adapter_handle, encoded)
                elif current > 0 and request.operation == RtHalOperationKind.Effectful and provider.replay_capable:
                    encoded = RtHalEncodedRequest(
                        case_id: request.case_id, operation: request.operation,
                        operation_word: request.operation_word,
                        input_word: request.input_word,
                        trace_word: results[base].trace_word
                    )
                    handle = arena.spawn_replay_fn(provider.adapter_handle, encoded)
                elif current > 0 and request.operation == RtHalOperationKind.Query and provider.query_capable:
                    handle = arena.spawn_query_fn(provider.adapter_handle, encoded)
                if handle <= 0:
                    results[base + current] = RtHalSafeParallelResult(
                        provider_ordinal: current, case_index: case_index,
                        case_id: request.case_id, provider_id: provider.provider_id,
                        status: RtHalParallelStatus.Unsupported,
                        outcome_word: -1, trace_word: -1, error_word: -1,
                        matches_pure: false
                    )
                else:
                    handles.push(handle)
                    ordinals.push(current)
                    submitted = submitted + 1
                width = width + 1
            if handles.len() > max_width:
                max_width = handles.len()
            var handle_index = 0
            while handle_index < handles.len():
                val current = ordinals[handle_index]
                val joined = arena.join_until_fn(handles[handle_index], comparison.timeout_ticks)
                if not joined.completed:
                    val cancelled_ok = arena.cancel_fn(handles[handle_index])
                    if cancelled_ok:
                        cancelled = cancelled + 1
                    results[base + current] = RtHalSafeParallelResult(
                        provider_ordinal: current, case_index: case_index,
                        case_id: request.case_id, provider_id: registry.providers[current].provider_id,
                        status: if cancelled_ok: RtHalParallelStatus.TimedOut else: RtHalParallelStatus.CancelFailed,
                        outcome_word: -1, trace_word: -1,
                        error_word: joined.error_word, matches_pure: false
                    )
                else:
                    val pure_word = if current == 0: joined.outcome_word else: results[base].outcome_word
                    val matches = current == 0 or (joined.outcome_word == pure_word and joined.error_word == results[base].error_word)
                    results[base + current] = RtHalSafeParallelResult(
                        provider_ordinal: current, case_index: case_index,
                        case_id: request.case_id, provider_id: registry.providers[current].provider_id,
                        status: if matches: RtHalParallelStatus.Value else: RtHalParallelStatus.Mismatch,
                        outcome_word: joined.outcome_word, trace_word: joined.trace_word,
                        error_word: joined.error_word, matches_pure: matches
                    )
                    completed = completed + 1
                handle_index = handle_index + 1
            rounds = rounds + 1
            wave_start = wave_start + comparison.worker_count
        case_index = case_index + 1
    val error = rt_hal_results_error(results, provider_count, requests.len(), comparison.require_all)
    rt_hal_report(results, error, submitted, completed, cancelled, rounds, max_width, error == "" and max_width > 1)
