# codex-impl
# Runtime-side exact typed exit capture for RT/HAL V2.  This is deliberately a
# scalar-token ABI: compiler lowering never passes a host address or tagged
# RuntimeValue bits across the boundary.  Values are serialized through the
# bounded byte writer, and only pre-registered canonical descriptors can be
# named by an exit.  The controller owns installation/drain; capture is a
# serialized termination-funnel operation and has no allocation or growth.

use std.common.rt_hal.exact_type_id.{RtHalExactTypeForeignCandidate,RT_HAL_EXACT_TYPE_ID_VERSION}
use std.common.rt_hal.model.{RtHalOperationKind}
use std.common.env_access.model.{EnvAccessPlan,EnvAccessKind,env_access_plan_error}
use std.common.hash.djb2.{djb2_hash_text}
use std.nogc_sync_mut.rt_hal.exact_type_descriptor_parser.{rt_hal_exact_type_descriptor_canonical}
use std.nogc_sync_mut.rt_hal.exact_io_schema.{
    RtHalExactIoArena,RtHalExactIoBounds,
    RtHalExactIoParentBatch,
    RtHalExactIoDomain,RtHalExactEncoding,
    rt_hal_exact_io_arena_error
}
use std.nogc_sync_mut.rt_hal.exact_type_identity_owner.{
    RtHalExactTypeRegistryOwner,RtHalExactTypeRegistrySeal,
    rt_hal_exact_type_registry_create,rt_hal_exact_type_registry_admit,
    rt_hal_exact_type_registry_freeze,rt_hal_exact_type_registry_release
}
use std.nogc_sync_mut.rt_hal.process_task_arena.{
    rt_hal_process_spawn_compare_io,rt_hal_process_spawn_compare_io_v3,rt_hal_process_spawn_replay_io_v3,
    rt_hal_process_spawn_replay_io,
    rt_hal_process_join_admit_io,
    rt_hal_process_adapter_handle_for_kind,rt_hal_process_io_timeout_ticks,
    rt_hal_process_io_max_retained_bytes,rt_hal_process_controller_claim,
    rt_hal_process_join_io_until,rt_hal_process_io_deadline_after,
    rt_hal_process_cancel_io_task,rt_hal_process_register_post_quiescence_reset,
    rt_hal_process_register_post_quiescence_drain,rt_hal_process_lifecycle_mark_ready,
    rt_hal_process_lifecycle_is_ready,
    rt_hal_process_operation_effect_admission_matches
}
use std.nogc_sync_mut.rt_hal.exact_io_parent_admission.{
    RtHalExactIoParsedResult,rt_hal_exact_io_parent_readmit,
    rt_hal_exact_io_parent_reconstruct,rt_hal_exact_io_parent_commit_three
}
use std.nogc_sync_mut.rt_hal.exact_byte_codec_owner.{RtHalCodecRootDomain}
use std.nogc_sync_mut.rt_hal.exact_io_wire_owner.{
    RtHalExactWireHandle,rt_hal_exact_wire_byte_at,rt_hal_exact_wire_view,
    rt_hal_exact_wire_reserve,rt_hal_exact_wire_append_byte,
    rt_hal_exact_wire_freeze,rt_hal_exact_wire_release,
    rt_hal_exact_wire_bind_replay_pair,RT_HAL_EXACT_WIRE_REQUEST
}
use std.nogc_sync_mut.atomic.{AtomicI64,MemoryOrdering,atomic_i64_new}

pub const RT_HAL_EXACT_EXIT_MAX_TYPES: i64=64
pub const RT_HAL_EXACT_EXIT_MAX_EXITS: i64=256
pub const RT_HAL_EXACT_EXIT_MAX_BYTES: i64=1048576
pub const RT_HAL_EXACT_EXIT_MAX_SCHEMAS: i64=256
# Observable V3 environment effects use one deliberately small canonical
# instruction envelope.  It is a plan/receipt grammar, not an escaped Pure
# outcome: `RTHALENV3` + LE(version=3, opcode=record, argument length) + arg.
# A fixed header lets all admission paths validate it without allocating or
# parsing an unbounded textual command language.
pub const RT_HAL_ENV_EFFECT_V3_HEADER_BYTES: i64=21
pub const RT_HAL_ENV_EFFECT_V3_VERSION: i64=3
pub const RT_HAL_ENV_EFFECT_V3_RECORD_OPCODE: i64=1

pub enum RtHalExactExitKind:
    # The scalar compiler ABI uses 1..5 (zero is fail-closed): Ret=1,
    # Error=2, Throw=3, Resume=4, Abort=5.  Do not cast this enum across
    # the boundary; `rt_hal_exact_exit_begin` validates the scalar code.
    Return
    Error
    Throw
    Resume
    Abort

pub struct RtHalExactExitHio2Frame:
    # A controller-owned fixed wire lease.  The producer never allocates an
    # arena or copies earlier exits into this frame; the isolated host copies
    # this one frozen request synchronously before the lease is released.
    request: RtHalExactWireHandle
    # For an observable effect, the controller creates a second, paired
    # frozen lease containing only the declared canonical effect plan/receipt.
    # It is never an alias of the request and never contains Pure output or
    # error bytes.  Query frames retain -1 here.
    effect: RtHalExactWireHandle
    replay: bool
    valid: bool

var _exit_installed: bool=false
var _exit_sealed: bool=false
var _exit_max_exits: i64=0
var _exit_max_bytes: i64=0
var _exit_type_count: i64=0
var _exit_schema_count: i64=0
var _exit_descriptor_used: i64=0
var _exit_payload_used: i64=0
var _exit_count: i64=0
var _exit_next_case_id: i64=1
var _exit_writer: i64=0
var _exit_next_writer: i64=1
# The writer holds one queue epoch pin from begin through terminal completion.
# Controller close observes that pin before it reads this otherwise serialized
# capture state, so reset/finalization cannot race a raw writer transition.
var _exit_capture_epoch: i64=0
var _exit_capture_gate: AtomicI64=atomic_i64_new(0)
var _exit_writing_domain: i64=-1
var _exit_writing_remaining: i64=0
var _exit_writing_events: bool=false
# The typed-leaf ABI is intentionally stateful only for the one serialized
# termination funnel.  It never stores a value address: the pending state is
# just the terminal domain and the count of canonical leaves already emitted.
var _exit_leaf_domain: i64=-1
var _exit_leaf_count: i64=0
var _exit_type_schema: [i64]=[]
var _exit_type_lane0: [i64]=[]
var _exit_type_lane1: [i64]=[]
var _exit_type_lane2: [i64]=[]
var _exit_type_lane3: [i64]=[]
var _exit_type_length: [i64]=[]
var _exit_type_encoding: [i64]=[]
var _exit_type_descriptor_offset: [i64]=[]
var _exit_type_descriptor_length: [i64]=[]
# Cold canonical descriptor cache; hot leaf validation never rebuilds text.
var _exit_type_descriptor_text: [text]=[]
var _exit_stable_schema: [i64]=[]
var _exit_schema_output_type: [i64]=[]
var _exit_schema_error_type: [i64]=[]
var _exit_schema_effect_type: [i64]=[]
# Cold policy is deliberately separate from the executable capture metadata.
# `RtHalExitCapture` is erased before backend lowering, so retaining these
# flags here is the only way a later controller can know which registered
# providers must observe a completed typed exit.  It is schema-keyed (never a
# type-table slot) and is sealed together with descriptor registration.
var _exit_schema_compare_c: [bool]=[]
var _exit_schema_compare_rust: [bool]=[]
# Operation-keyed effect authority is distinct from the terminal schema policy.
# A schema can be shared by effectful and query-only functions; merging it at
# schema granularity would grant adapter-4 replay to the latter.
var _exit_effect_operation: [text]=[]
var _exit_effect_operation_capture: [bool]=[]
var _exit_effect_operation_compare_c: [bool]=[]
var _exit_effect_operation_compare_rust: [bool]=[]
# Controller identity is installed once after every descriptor policy has been
# bound.  It owns no payload: only the cold, canonical five-root admission
# authority consumed by HIO2 join/re-admit/reconstruction.
var _exit_controller_registry: RtHalExactTypeRegistryOwner=RtHalExactTypeRegistryOwner.invalid_probe()
var _exit_controller_seal: RtHalExactTypeRegistrySeal=RtHalExactTypeRegistrySeal.invalid_probe()
var _exit_controller_ready: bool=false
# First failure is retained as a bounded scalar/text diagnostic for the
# controller/finalizer. It never contains foreign payload bytes.
var _exit_controller_problem: text=""
var _exit_case: [i64]=[]
var _exit_epoch: [i64]=[]
var _exit_schema: [i64]=[]
var _exit_kind: [i64]=[]
var _exit_operation_id: [text]=[]
# Independent request capture is intentionally distinct from the later Pure
# terminal record.  A request slot is claimed at the tagged function entry,
# populated from its arguments, then linked to exactly one terminal capture.
# It is never synthesized from return/throw/effect bytes.
var _exit_request_next: AtomicI64=atomic_i64_new(0)
var _exit_request_pins: AtomicI64=atomic_i64_new(0)
var _exit_request_operation: [text]=[]
var _exit_request_epoch: [i64]=[]
var _exit_request_descriptor: [text]=[]
var _exit_request_events_length: [i64]=[]
var _exit_request_payload_length: [i64]=[]
# A request's optional observable-effect plan lives beside its pre-Pure input
# in the same fixed per-invocation partition.  This avoids copying a Pure
# receipt at terminal time and makes input+effects subject to one hard bound.
var _exit_request_effect_descriptor: [text]=[]
var _exit_request_effect_events_length: [i64]=[]
var _exit_request_effect_payload_length: [i64]=[]
var _exit_request_effect_state: [i64]=[]
var _exit_request_effect_remaining: [i64]=[]
var _exit_request_state: [i64]=[]
var _exit_request_remaining: [i64]=[]
var _exit_request_bytes: [u8]=[]
var _exit_request_token: [i64]=[]
var _exit_request_for_exit: [i64]=[]
var _exit_output_type: [i64]=[]
var _exit_error_type: [i64]=[]
var _exit_effect_type: [i64]=[]
var _exit_output_offset: [i64]=[]
var _exit_output_length: [i64]=[]
var _exit_error_offset: [i64]=[]
var _exit_error_length: [i64]=[]
var _exit_effect_offset: [i64]=[]
var _exit_effect_length: [i64]=[]
var _exit_output_events_offset: [i64]=[]
var _exit_output_events_length: [i64]=[]
var _exit_error_events_offset: [i64]=[]
var _exit_error_events_length: [i64]=[]
var _exit_effect_events_offset: [i64]=[]
var _exit_effect_events_length: [i64]=[]
var _exit_bytes: [u8]=[]
# A completed producer record is represented by one bounded scalar index. The
# controller owns every later copy, frame construction, process task, join,
# cancellation/reap, and commit.
var _exit_controller_queue: [i64]=[]
# Bounded MPSC publication ring.  A producer owns a slot only after it claims
# its monotonically increasing ticket.  The scalar exit index is then written
# before the slot sequence is released.  The cold controller is the sole
# consumer and returns a slot to its next generation only after its ordered
# fanout/compare transaction succeeds.  This keeps producer terminals
# allocation-free while preventing concurrent overwrites or lost captures.
var _exit_controller_queue_sequence: [AtomicI64]=[]
var _exit_controller_queue_head: AtomicI64=atomic_i64_new(0)
var _exit_controller_queue_tail: AtomicI64=atomic_i64_new(0)
var _exit_controller_queue_closed: AtomicI64=atomic_i64_new(0)
var _exit_controller_queue_producers: AtomicI64=atomic_i64_new(0)
var _exit_controller_queue_epoch: AtomicI64=atomic_i64_new(1)
# Once a producer observes bounded backpressure, the complete controller
# transaction is fail-closed even if a later drain frees a slot.  Producers do
# not touch the diagnostic text, which is controller-owned mutable state.
var _exit_controller_queue_failed: AtomicI64=atomic_i64_new(0)

fn _exit_clear():
    _exit_installed=false;_exit_sealed=false;_exit_max_exits=0;_exit_max_bytes=0
    _exit_type_count=0;_exit_schema_count=0;_exit_descriptor_used=0;_exit_payload_used=0;_exit_count=0;_exit_next_case_id=1
    _exit_writer=0;_exit_next_writer=1;_exit_capture_epoch=0;_exit_capture_gate.store(0,MemoryOrdering.Release);_exit_writing_domain=-1;_exit_writing_remaining=0;_exit_writing_events=false
    _exit_leaf_domain=-1;_exit_leaf_count=0
    _exit_type_schema=[];_exit_type_lane0=[];_exit_type_lane1=[];_exit_type_lane2=[];_exit_type_lane3=[]
    _exit_type_length=[];_exit_type_encoding=[];_exit_type_descriptor_offset=[];_exit_type_descriptor_length=[];_exit_type_descriptor_text=[]
    _exit_stable_schema=[];_exit_schema_output_type=[];_exit_schema_error_type=[];_exit_schema_effect_type=[]
    _exit_schema_compare_c=[];_exit_schema_compare_rust=[]
    _exit_effect_operation=[];_exit_effect_operation_capture=[]
    _exit_effect_operation_compare_c=[];_exit_effect_operation_compare_rust=[]
    _exit_controller_registry=RtHalExactTypeRegistryOwner.invalid_probe()
    _exit_controller_seal=RtHalExactTypeRegistrySeal.invalid_probe();_exit_controller_ready=false;_exit_controller_problem=""
    _exit_case=[];_exit_epoch=[];_exit_schema=[];_exit_kind=[];_exit_operation_id=[];_exit_output_type=[];_exit_error_type=[];_exit_effect_type=[]
    _exit_request_next.store(0,MemoryOrdering.Release);_exit_request_operation=[];_exit_request_descriptor=[]
    _exit_request_pins.store(0,MemoryOrdering.Release);_exit_request_epoch=[]
    _exit_request_events_length=[];_exit_request_payload_length=[];_exit_request_state=[];_exit_request_remaining=[]
    _exit_request_effect_descriptor=[];_exit_request_effect_events_length=[];_exit_request_effect_payload_length=[]
    _exit_request_effect_state=[];_exit_request_effect_remaining=[]
    _exit_request_bytes=[];_exit_request_token=[];_exit_request_for_exit=[]
    _exit_output_offset=[];_exit_output_length=[];_exit_error_offset=[];_exit_error_length=[]
    _exit_effect_offset=[];_exit_effect_length=[];_exit_bytes=[]
    _exit_output_events_offset=[];_exit_output_events_length=[];_exit_error_events_offset=[];_exit_error_events_length=[]
    _exit_effect_events_offset=[];_exit_effect_events_length=[]
    var queue_slot=0
    while queue_slot<_exit_controller_queue_sequence.len():
        _exit_controller_queue_sequence[queue_slot].free()
        queue_slot=queue_slot+1
    _exit_controller_queue=[];_exit_controller_queue_sequence=[]

pub fn rt_hal_exact_exit_arena_install(max_exits: i64,max_bytes: i64) ->bool:
    # A library exported boundary may be called more than once. The controller
    # may therefore re-enter cold setup, but only with the identical fixed
    # reservation; a different reservation is an ownership/configuration
    # error and must not resize a live arena.
    if _exit_installed:
        return _exit_writer==0 and _exit_max_exits==max_exits and _exit_max_bytes==max_bytes
    if max_exits<=0 or max_exits>RT_HAL_EXACT_EXIT_MAX_EXITS or
       max_bytes<=0 or max_bytes>RT_HAL_EXACT_EXIT_MAX_BYTES:return false
    _exit_installed=true;_exit_max_exits=max_exits;_exit_max_bytes=max_bytes
    _exit_type_schema=[0;RT_HAL_EXACT_EXIT_MAX_TYPES];_exit_type_lane0=[0;RT_HAL_EXACT_EXIT_MAX_TYPES]
    _exit_type_lane1=[0;RT_HAL_EXACT_EXIT_MAX_TYPES];_exit_type_lane2=[0;RT_HAL_EXACT_EXIT_MAX_TYPES]
    _exit_type_lane3=[0;RT_HAL_EXACT_EXIT_MAX_TYPES];_exit_type_length=[0;RT_HAL_EXACT_EXIT_MAX_TYPES]
    _exit_type_encoding=[0;RT_HAL_EXACT_EXIT_MAX_TYPES];_exit_type_descriptor_offset=[0;RT_HAL_EXACT_EXIT_MAX_TYPES]
    _exit_type_descriptor_length=[0;RT_HAL_EXACT_EXIT_MAX_TYPES];_exit_type_descriptor_text=["";RT_HAL_EXACT_EXIT_MAX_TYPES]
    _exit_stable_schema=[0;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_schema_output_type=[0;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_schema_error_type=[0;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_schema_effect_type=[0;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_schema_compare_c=[false;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_schema_compare_rust=[false;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_effect_operation=["";RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_effect_operation_capture=[false;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_effect_operation_compare_c=[false;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_effect_operation_compare_rust=[false;RT_HAL_EXACT_EXIT_MAX_SCHEMAS]
    _exit_case=[0;max_exits];_exit_epoch=[0;max_exits];_exit_schema=[0;max_exits];_exit_kind=[0;max_exits];_exit_operation_id=["";max_exits]
    _exit_request_operation=["";max_exits];_exit_request_descriptor=["";max_exits]
    _exit_request_epoch=[0;max_exits]
    _exit_request_events_length=[0;max_exits];_exit_request_payload_length=[0;max_exits]
    _exit_request_state=[0;max_exits];_exit_request_remaining=[0;max_exits]
    _exit_request_effect_descriptor=["";max_exits];_exit_request_effect_events_length=[0;max_exits]
    _exit_request_effect_payload_length=[0;max_exits];_exit_request_effect_state=[0;max_exits]
    _exit_request_effect_remaining=[0;max_exits]
    _exit_request_token=[0;max_exits];_exit_request_for_exit=[0;max_exits]
    # Fixed per-invocation partitions prevent a producer from overwriting a
    # concurrent argument transcript and cap total retained request memory at
    # the same configured arena reservation. No terminal performs allocation.
    _exit_request_bytes=[0u8;max_bytes]
    _exit_output_type=[0;max_exits];_exit_error_type=[0;max_exits];_exit_effect_type=[0;max_exits]
    _exit_output_offset=[0;max_exits];_exit_output_length=[0;max_exits]
    _exit_error_offset=[0;max_exits];_exit_error_length=[0;max_exits]
    _exit_effect_offset=[0;max_exits];_exit_effect_length=[0;max_exits]
    _exit_output_events_offset=[0;max_exits];_exit_output_events_length=[0;max_exits]
    _exit_error_events_offset=[0;max_exits];_exit_error_events_length=[0;max_exits]
    _exit_effect_events_offset=[0;max_exits];_exit_effect_events_length=[0;max_exits]
    _exit_bytes=[0u8;max_bytes]
    _exit_controller_queue=[-1;max_exits]
    _exit_controller_queue_sequence=[]
    var queue_slot=0
    while queue_slot<max_exits:
        # Sequence starts at its ticket number, meaning the slot is free for
        # that ticket.  It is advanced to ticket+1 on producer publication.
        _exit_controller_queue_sequence.push(atomic_i64_new(queue_slot))
        queue_slot=queue_slot+1
    _exit_controller_queue_head.store(0,MemoryOrdering.Release)
    _exit_controller_queue_tail.store(0,MemoryOrdering.Release)
    _exit_controller_queue_closed.store(0,MemoryOrdering.Release)
    _exit_controller_queue_producers.store(0,MemoryOrdering.Release)
    _exit_request_pins.store(0,MemoryOrdering.Release)
    _exit_controller_queue_failed.store(0,MemoryOrdering.Release)
    # Every installation is a fresh admission epoch. A pin retained by an old
    # capture can therefore never become valid again after reset/reinstall.
    val current_epoch=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire)
    if current_epoch<=0 or current_epoch==0x7fffffffffffffff:
        _exit_controller_queue_epoch.store(1,MemoryOrdering.Release)
    else:
        _exit_controller_queue_epoch.fetch_add(1,MemoryOrdering.AcqRel)
    if not rt_hal_process_register_post_quiescence_reset(rt_hal_exact_exit_arena_reset):
        _exit_clear();return false
    true

# The compiler injects this only into the selected cold controller entry,
# after the EnvAccessPlan has installed the isolated C/Rust provider set and
# before descriptor binding.  Keeping allocation here makes a Pure-only
# build retain neither this arena nor its policy tables.
pub fn rt_hal_exact_exit_arena_install_or_fail(max_exits: i64,max_bytes: i64):
    if not rt_hal_exact_exit_arena_install(max_exits,max_bytes):
        panic("RTHAL-E-EXIT-ARENA")

pub fn rt_hal_exact_exit_arena_reset() ->bool:
    # Reset is another terminal consumer: close first, prove no publisher is
    # in flight, and refuse to discard a captured-but-undrained ticket.  The
    # post-quiescence hook supplies the lifecycle ordering; these checks make
    # that ordering executable at the shared queue boundary.
    if _exit_installed:
        val closed=_exit_controller_queue_closed.compare_exchange(0,1,
            MemoryOrdering.AcqRel,MemoryOrdering.Acquire)
        if not closed and _exit_controller_queue_closed.load(MemoryOrdering.Acquire)!=1:return false
    if _exit_controller_queue_producers.load(MemoryOrdering.Acquire)!=0 or
       _exit_request_pins.load(MemoryOrdering.Acquire)!=0:return false
    if _exit_writer!=0 or _exit_capture_gate.load(MemoryOrdering.Acquire)!=0:return false
    if _exit_controller_queue_head.load(MemoryOrdering.Acquire)!=
       _exit_controller_queue_tail.load(MemoryOrdering.Acquire):return false
    # Keep closure asserted while advancing generation; `_exit_clear` must not
    # reopen the old epoch.  The next cold install alone reopens admission.
    val epoch=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire)
    if epoch<=0 or epoch==0x7fffffffffffffff:
        _exit_controller_queue_epoch.store(1,MemoryOrdering.Release)
    else:
        _exit_controller_queue_epoch.fetch_add(1,MemoryOrdering.AcqRel)
    _exit_clear();true

fn _exit_encoding(code: i64) ->i64:
    if code<0 or code>6:return -1
    code
fn _exit_type_valid(id: i64) ->bool: id>0 and id<=_exit_type_count
fn _exit_kind_valid(code: i64) ->bool: code>=1 and code<=5
fn _exit_domain_valid(code: i64) ->bool: code>=2 and code<=4
fn _exit_domain_type(index: i64,domain: i64) ->i64:
    if domain==2:return _exit_output_type[index]
    if domain==3:return _exit_error_type[index]
    _exit_effect_type[index]
fn _exit_domain_events(index: i64,domain: i64) ->i64:
    if domain==2:return _exit_output_events_length[index]
    if domain==3:return _exit_error_events_length[index]
    _exit_effect_events_length[index]
fn _exit_payload_length_valid(type_id: i64,event_length: i64,byte_length: i64) ->bool:
    if not _exit_type_valid(type_id) or byte_length<0:return false
    val encoding=_exit_type_encoding[type_id-1]
    if encoding==0:return byte_length==0 and event_length==0
    if encoding==3 or encoding==4:return (byte_length==1 or byte_length==2 or byte_length==4 or byte_length==8) and event_length==0
    if encoding==5:return (byte_length==4 or byte_length==8) and event_length==0
    if encoding==6:return event_length>0 and event_length%16==0
    event_length==0

# Parse a structured descriptor without constructing a node tree.  This is
# cold-to-warm validation only: it proves a supplied primitive leaf belongs to
# the declared composite root, and keeps the capture ABI scalar/text-only.
class _RtHalExitLeafPlan:
    raw: text
    leaf: text
    position: i64
    nodes: i64
    valid: bool
    found: bool

impl _RtHalExitLeafPlan:
    fn _starts(needle: text,end: i64) ->bool:
        if self.position<0 or needle.len()>end-self.position:return false
        var i=0
        while i<needle.len():
            if self.raw.char_at(self.position+i)!=needle.char_at(i):return false
            i=i+1
        true

    me _consume(needle: text,end: i64) ->bool:
        if not self._starts(needle,end):return false
        self.position=self.position+needle.len();true

    me _decimal(end: i64) ->i64:
        if self.position>=end:return -1
        val first=self.raw.char_at(self.position)
        if first<"0" or first>"9":return -1
        var value: i64=0
        if first=="0":
            self.position=self.position+1
            if self.position>=end or self.raw.char_at(self.position)!=";":return -1
            self.position=self.position+1;return 0
        while self.position<end:
            val ch=self.raw.char_at(self.position)
            if ch==";":self.position=self.position+1;return value
            val digit=self.raw.char_code_at(self.position)-48
            if ch<"0" or ch>"9" or value>(0x7fffffffffffffff-digit)/10:return -1
            value=value*10+digit;self.position=self.position+1
        -1

    me _framed(depth: i64,end: i64) ->bool:
        val length=self._decimal(end)
        if length<=0 or length>end-self.position:return false
        val child_end=self.position+length
        self._type(depth,child_end) and self.position==child_end

    me _primitive(end: i64) ->bool:
        val start=self.position;val length=end-start
        var valid_leaf=false
        if (length==4 and self._starts("unit",end)) or (length==2 and self._starts("i8",end)) or
           (length==3 and (self._starts("i16",end) or self._starts("i32",end) or self._starts("i64",end) or self._starts("u16",end) or self._starts("u32",end) or self._starts("u64",end) or self._starts("f32",end) or self._starts("f64",end))) or
           (length==2 and self._starts("u8",end)) or (length==4 and (self._starts("bool",end) or self._starts("char",end))) or
           (length==5 and self._starts("bytes",end)) or (length==9 and self._starts("text:utf8",end)):
            valid_leaf=true
        if not valid_leaf:return false
        if self.leaf.len()==length:
            var i=0;var equal=true
            while i<length:
                if self.raw.char_at(start+i)!=self.leaf.char_at(i):equal=false
                i=i+1
            if equal:self.found=true
        self.position=end;true

    me _type(depth: i64,end: i64) ->bool:
        if not self.valid or depth>64 or end>self.raw.len() or self.position>=end:return false
        self.nodes=self.nodes+1
        if self.nodes>1024 or not self._consume("v2;",end):return false
        if self._consume("array;",end):
            if self._decimal(end)<0:return false
            return self._framed(depth+1,end) and self.position==end
        if self._consume("tuple;",end):
            val count=self._decimal(end)
            if count<0:return false
            var i=0
            while i<count:
                if not self._framed(depth+1,end):return false
                i=i+1
            return self.position==end
        if self._consume("result;",end):
            return self._framed(depth+1,end) and self._framed(depth+1,end) and self.position==end
        self._primitive(end)

    me has_leaf() ->bool:
        self._type(1,self.raw.len()) and self.valid and self.position==self.raw.len() and self.found

fn _exit_leaf_encoding_width(descriptor: text) ->(i64,i64):
    if descriptor=="v2;unit":return (0,0)
    if descriptor=="v2;i8" or descriptor=="v2;u8" or descriptor=="v2;bool":return (if descriptor=="v2;i8":3 else:4,1)
    if descriptor=="v2;i16" or descriptor=="v2;u16":return (if descriptor=="v2;i16":3 else:4,2)
    if descriptor=="v2;i32" or descriptor=="v2;u32":return (if descriptor=="v2;i32":3 else:4,4)
    if descriptor=="v2;i64" or descriptor=="v2;u64":return (if descriptor=="v2;i64":3 else:4,8)
    if descriptor=="v2;f32":return (5,4)
    if descriptor=="v2;f64":return (5,8)
    if descriptor=="v2;char":return (4,4)
    if descriptor=="v2;text:utf8":return (2,-1)
    (-1,-1)

fn _exit_event_i64(offset: i64) ->i64:
    if offset<0 or offset>_exit_payload_used-8:return -1
    var result: u64=0;var lane=0
    while lane<8:
        result=result|((_exit_bytes[offset+lane] as u64)<<(lane*8));lane=lane+1
    result as i64

fn _exit_leaf_terminal_ready(token: i64,role: i64,leaf_descriptor: text,
        encoding: i64,width: i64) ->bool:
    val domain=_exit_backend_domain(token)
    if domain<0 or role!=domain or _exit_writing_domain>=0 or _exit_count<=0:return false
    val index=_exit_count-1;val root_type=_exit_domain_type(index,domain)
    if not _exit_type_valid(root_type) or _exit_type_encoding[root_type-1]!=6:return false
    val event_offset=if domain==2:_exit_output_events_offset[index] else:_exit_error_events_offset[index]
    val event_length=if domain==2:_exit_output_events_length[index] else:_exit_error_events_length[index]
    if event_length<32 or event_length%16!=0 or _exit_event_i64(event_offset)!=1 or
       _exit_event_i64(event_offset+event_length-16)!=2:return false
    val root_arg=_exit_event_i64(event_offset+8)
    # Exit writer roles are Output=2/Error=3, whereas the portable codec
    # transcript domains are Output=3/Error=4. Keep the role check above for
    # leaf ownership and validate the separately encoded root domain here.
    val codec_domain=domain+1
    if root_arg<0 or (root_arg>>32)!=codec_domain:return false
    val root=_exit_type_descriptor_text[root_type-1]
    val canonical_leaf=rt_hal_exact_type_descriptor_canonical(leaf_descriptor)
    val expected=_exit_leaf_encoding_width(canonical_leaf)
    if canonical_leaf=="" or expected.0!=encoding or expected.1!=width:return false
    var plan=_RtHalExitLeafPlan(raw:root,leaf:canonical_leaf,position:0,nodes:0,valid:true,found:false)
    plan.has_leaf()

# Cold setup ABI.  The descriptor is canonicalized before its bytes enter the
# fixed arena, so later capture only stores a small type-table index.
pub fn rt_hal_exact_exit_type_register(schema: i64,lane0: i64,lane1: i64,
        lane2: i64,lane3: i64,descriptor_length: i64,descriptor: text,
        encoding_code: i64) ->i64:
    if not _exit_installed or _exit_sealed or _exit_writer!=0 or _exit_type_count>=RT_HAL_EXACT_EXIT_MAX_TYPES:
        return -1
    val encoding=_exit_encoding(encoding_code)
    val canonical=rt_hal_exact_type_descriptor_canonical(descriptor)
    if schema!=RT_HAL_EXACT_TYPE_ID_VERSION or descriptor_length<=0 or
       descriptor_length!=canonical.len() or descriptor_length>_exit_max_bytes-_exit_descriptor_used or encoding<0:
        return -1
    var i=0
    while i<_exit_type_count:
        if _exit_type_schema[i]==schema and _exit_type_lane0[i]==lane0 and _exit_type_lane1[i]==lane1 and
           _exit_type_lane2[i]==lane2 and _exit_type_lane3[i]==lane3 and _exit_type_length[i]==descriptor_length:
            var equal=true;var b=0
            while b<descriptor_length:
                if _exit_bytes[_exit_type_descriptor_offset[i]+b] as i64!=canonical.byte_at(b):equal=false
                b=b+1
            if equal:return i+1
        i=i+1
    val slot=_exit_type_count;val offset=_exit_descriptor_used;i=0
    while i<descriptor_length:
        _exit_bytes[offset+i]=canonical.byte_at(i) as u8;i=i+1
    _exit_type_schema[slot]=schema;_exit_type_lane0[slot]=lane0;_exit_type_lane1[slot]=lane1
    _exit_type_lane2[slot]=lane2;_exit_type_lane3[slot]=lane3;_exit_type_length[slot]=descriptor_length
    _exit_type_encoding[slot]=encoding;_exit_type_descriptor_offset[slot]=offset;_exit_type_descriptor_length[slot]=descriptor_length;_exit_type_descriptor_text[slot]=canonical
    _exit_type_count=_exit_type_count+1;_exit_descriptor_used=_exit_descriptor_used+descriptor_length
    _exit_type_count

# Compiler-facing cold descriptor registration.  Identity lanes are derived
# only here from canonical descriptor text; callers cannot smuggle a hash or
# an arbitrary dense index into the capture ABI.  The parent still re-admits
# all foreign candidates before a result can commit.
fn _exit_descriptor_lane(domain: i64,canonical: text) ->i64:
    djb2_hash_text("rt-hal-exit-v2:{domain}|{canonical}")
fn _exit_descriptor_encoding(canonical: text) ->i64:
    if canonical=="v2;unit":return 0
    if canonical=="v2;i8" or canonical=="v2;i16" or canonical=="v2;i32" or canonical=="v2;i64":return 3
    if canonical=="v2;u8" or canonical=="v2;u16" or canonical=="v2;u32" or canonical=="v2;u64" or canonical=="v2;bool" or canonical=="v2;char":return 4
    if canonical=="v2;f32" or canonical=="v2;f64":return 5
    if canonical=="v2;bytes":return 1
    if canonical=="v2;text:utf8":return 2
    # Arrays, tuples and results carry the canonical shape transcript.
    6
pub fn rt_hal_exact_exit_type_register_descriptor(descriptor: text,
        encoding_code: i64) ->i64:
    if not _exit_installed or _exit_sealed or _exit_writer!=0:return -1
    val canonical=rt_hal_exact_type_descriptor_canonical(descriptor)
    val encoding=_exit_encoding(encoding_code)
    if canonical=="" or encoding<0 or encoding!=_exit_descriptor_encoding(canonical):return -1
    rt_hal_exact_exit_type_register(RT_HAL_EXACT_TYPE_ID_VERSION,
        _exit_descriptor_lane(0,canonical),_exit_descriptor_lane(1,canonical),
        _exit_descriptor_lane(2,canonical),_exit_descriptor_lane(3,canonical),
        canonical.len(),canonical,encoding)

# Atomic cold descriptor-to-schema binder.  It rolls back rows and descriptor
# bytes appended by this call when a later registration fails, preserving an
# idempotent setup plan and preventing a stale partial schema from being used.
pub fn rt_hal_exact_exit_schema_bind_descriptors(stable_schema_id: i64,
        output_descriptor: text,output_encoding: i64,error_descriptor: text,
        error_encoding: i64,effect_descriptor: text,effect_encoding: i64) ->bool:
    if not _exit_installed or _exit_writer!=0 or stable_schema_id<=0:return false
    # Sealed setup is read-only.  Replaying the same compiler-generated
    # registration is safe for a fallback library entry; a divergent schema
    # fails closed without mutating the fixed tables.
    if _exit_sealed:
        val slot=_exit_schema_slot(stable_schema_id)
        if slot<0:return false
        val output=_exit_schema_output_type[slot]
        val error=_exit_schema_error_type[slot]
        val effect=_exit_schema_effect_type[slot]
        if not _exit_type_valid(output) or not _exit_type_valid(error) or not _exit_type_valid(effect):return false
        return _exit_type_descriptor_text[output-1]==rt_hal_exact_type_descriptor_canonical(output_descriptor) and
            _exit_type_encoding[output-1]==output_encoding and
            _exit_type_descriptor_text[error-1]==rt_hal_exact_type_descriptor_canonical(error_descriptor) and
            _exit_type_encoding[error-1]==error_encoding and
            _exit_type_descriptor_text[effect-1]==rt_hal_exact_type_descriptor_canonical(effect_descriptor) and
            _exit_type_encoding[effect-1]==effect_encoding
    val type_checkpoint=_exit_type_count;val bytes_checkpoint=_exit_descriptor_used
    val schema_checkpoint=_exit_schema_count
    val output=rt_hal_exact_exit_type_register_descriptor(output_descriptor,output_encoding)
    val error=rt_hal_exact_exit_type_register_descriptor(error_descriptor,error_encoding)
    val effect=rt_hal_exact_exit_type_register_descriptor(effect_descriptor,effect_encoding)
    val bound=if output>0 and error>0 and effect>0:
        rt_hal_exact_exit_schema_register(stable_schema_id,output,error,effect)
    else: false
    if bound:return true
    _exit_type_count=type_checkpoint;_exit_descriptor_used=bytes_checkpoint
    _exit_schema_count=schema_checkpoint
    false

# Single-schema setup convenience for compiler plans that have completed their
# entire registration set.  Exit begin rejects until this seal succeeds, so no
# partially bound or stale schema can become a hot-path lookup target.
pub fn rt_hal_exact_exit_schema_bind_descriptors_and_seal(stable_schema_id: i64,
        output_descriptor: text,output_encoding: i64,error_descriptor: text,
        error_encoding: i64,effect_descriptor: text,effect_encoding: i64) ->bool:
    if not rt_hal_exact_exit_schema_bind_descriptors(stable_schema_id,
            output_descriptor,output_encoding,error_descriptor,error_encoding,
            effect_descriptor,effect_encoding):return false
    rt_hal_exact_exit_type_seal()

pub fn rt_hal_exact_exit_type_seal() ->bool:
    if not _exit_installed or _exit_writer!=0:return false
    if _exit_sealed:return true
    if _exit_type_count<=0 or _exit_schema_count<=0:return false
    _exit_sealed=true;true

# Cold controller seal.  The process parent must be able to re-admit a foreign
# HIO2 result without allowing that result to grow or alter identity state.
# We pre-admit the two self-request roots plus every fixed exit descriptor,
# then freeze once; subsequent V2 readmission can resolve exact duplicates
# only and cannot mutate the sealed registry.
pub fn rt_hal_exact_exit_controller_seal() ->bool:
    if not _exit_installed or not _exit_sealed or _exit_writer!=0 or
       _exit_controller_ready: return _exit_controller_ready
    # The controller registry owns both generic adapter request roots in
    # addition to sealed exit descriptor roots.
    val capacity=_exit_type_count+3
    val registry=rt_hal_exact_type_registry_create(capacity,_exit_max_bytes)
    if not rt_hal_exact_type_registry_admit(registry,"v2;text:utf8")._valid or
       not rt_hal_exact_type_registry_admit(registry,"v2;unit")._valid or
       not rt_hal_exact_type_registry_admit(registry,"v2;bytes")._valid:
        val abandoned=rt_hal_exact_type_registry_freeze(registry)
        if abandoned._generation>0:rt_hal_exact_type_registry_release(registry,abandoned)
        return false
    var index=0
    while index<_exit_type_count:
        if not rt_hal_exact_type_registry_admit(registry,_exit_type_descriptor_text[index])._valid:
            val abandoned=rt_hal_exact_type_registry_freeze(registry)
            if abandoned._generation>0:rt_hal_exact_type_registry_release(registry,abandoned)
            return false
        index=index+1
    val seal=rt_hal_exact_type_registry_freeze(registry)
    if seal._generation<=0:return false
    if not rt_hal_process_register_post_quiescence_drain(
            rt_hal_exact_exit_controller_drain_after_capture):return false
    _exit_controller_registry=registry;_exit_controller_seal=seal
    _exit_controller_ready=true
    # Ready is the lifecycle release point. Every consumer first acquires the
    # locked Ready-for-plan query, so publish all controller fields before it.
    if not rt_hal_process_lifecycle_mark_ready():
        _exit_controller_ready=false
        return false
    true

# Cold stable-schema registration.  A schema ID is an opaque compiler-issued
# stable identifier, never a dense table position or a type hash.  The only
# dense values retained here are prior type-table admissions, checked again on
# every lookup.  Duplicate registration is idempotent only for the same triple.
pub fn rt_hal_exact_exit_schema_register(stable_schema_id: i64,
        output_type_id: i64,error_type_id: i64,effect_type_id: i64) ->bool:
    if not _exit_installed or _exit_sealed or _exit_writer!=0 or stable_schema_id<=0 or
       not _exit_type_valid(output_type_id) or not _exit_type_valid(error_type_id) or not _exit_type_valid(effect_type_id):return false
    var i=0
    while i<_exit_schema_count:
        if _exit_stable_schema[i]==stable_schema_id:
            return _exit_schema_output_type[i]==output_type_id and _exit_schema_error_type[i]==error_type_id and _exit_schema_effect_type[i]==effect_type_id
        i=i+1
    if _exit_schema_count>=RT_HAL_EXACT_EXIT_MAX_SCHEMAS:return false
    _exit_stable_schema[_exit_schema_count]=stable_schema_id
    _exit_schema_output_type[_exit_schema_count]=output_type_id
    _exit_schema_error_type[_exit_schema_count]=error_type_id
    _exit_schema_effect_type[_exit_schema_count]=effect_type_id
    _exit_schema_count=_exit_schema_count+1;true

# Registering the policy is a cold, idempotent operation.  Multiple tagged
# functions can share one exact descriptor schema; their required providers
# are therefore unioned rather than allowing the last lowered function to
# silently weaken the comparison set.  Pure-only schemas have no policy row
# and retain no comparator work.
pub fn rt_hal_exact_exit_schema_policy_register(stable_schema_id: i64,
        compare_c: bool,compare_rust: bool) ->bool:
    if not _exit_installed or _exit_writer!=0 or
       stable_schema_id<=0:return false
    val slot=_exit_schema_slot(stable_schema_id)
    if slot<0:return false
    # The compiler emits one canonical row for every schema. Pure-only rows
    # intentionally retain no provider requirement and are a valid no-op.
    if not compare_c and not compare_rust:return true
    # A library may replay its complete frozen module plan at exported-call
    # entry. Sealed policy can only prove a subset, never gain a provider.
    if _exit_sealed:
        return (not compare_c or _exit_schema_compare_c[slot]) and
            (not compare_rust or _exit_schema_compare_rust[slot])
    _exit_schema_compare_c[slot]=_exit_schema_compare_c[slot] or compare_c
    _exit_schema_compare_rust[slot]=_exit_schema_compare_rust[slot] or compare_rust
    true

# Reconcile compiler-observed direct EnvAccess capture with the immutable
# operation plan while the arena is still cold.  This is deliberately keyed by
# canonical operation identity, not schema: shared return descriptors do not
# share physical-effect authority.  `capture_effect=false` is equally strict:
# no adapter-4 row may have been admitted for that operation/provider.
pub fn rt_hal_exact_exit_operation_effect_policy_register(operation_id: text,
        capture_effect: bool,compare_c: bool,compare_rust: bool) ->bool:
    if not _exit_installed or _exit_sealed or _exit_writer!=0 or
       operation_id=="" or operation_id.len()>4096:return false
    if not compare_c and not compare_rust:return not capture_effect
    if not rt_hal_process_operation_effect_admission_matches(operation_id,
            capture_effect,compare_c,compare_rust):return false
    var index=0
    while index<RT_HAL_EXACT_EXIT_MAX_SCHEMAS:
        if _exit_effect_operation[index]==operation_id:
            return _exit_effect_operation_capture[index]==capture_effect and
                _exit_effect_operation_compare_c[index]==compare_c and
                _exit_effect_operation_compare_rust[index]==compare_rust
        if _exit_effect_operation[index]=="":
            _exit_effect_operation[index]=operation_id
            _exit_effect_operation_capture[index]=capture_effect
            _exit_effect_operation_compare_c[index]=compare_c
            _exit_effect_operation_compare_rust[index]=compare_rust
            return true
        index=index+1
    false

fn _exit_request_effect_operation_admitted(slot: i64) ->bool:
    if slot<0 or slot>=_exit_max_exits:return false
    val operation=_exit_request_operation[slot]
    var index=0
    while index<RT_HAL_EXACT_EXIT_MAX_SCHEMAS:
        if _exit_effect_operation[index]==operation:
            return _exit_effect_operation_capture[index] and
                rt_hal_process_operation_effect_admission_matches(operation,true,
                    _exit_effect_operation_compare_c[index],
                    _exit_effect_operation_compare_rust[index])
        index=index+1
    false

# Controller-facing sealed query.  It exposes only the required provider
# flags, never capture payloads, descriptor bytes, or a mutable table index.
pub fn rt_hal_exact_exit_schema_requires_provider(stable_schema_id: i64,
        provider_code: i64) ->bool:
    if not _exit_sealed:return false
    val slot=_exit_schema_slot(stable_schema_id)
    if slot<0:return false
    if provider_code==1:return _exit_schema_compare_c[slot]
    if provider_code==2:return _exit_schema_compare_rust[slot]
    false

pub fn rt_hal_exact_exit_controller_problem() ->text: _exit_controller_problem

fn _exit_controller_fail(problem: text) ->bool:
    if _exit_controller_problem=="":_exit_controller_problem=problem
    false

fn _exit_schema_slot(stable_schema_id: i64) ->i64:
    if stable_schema_id<=0:return -1
    var i=0
    while i<_exit_schema_count:
        if _exit_stable_schema[i]==stable_schema_id:return i
        i=i+1
    -1

# Scalar lookup for compiler/runtime callers.  Role is 2=output, 3=error,
# 4=effect.  It returns only a registered dense table index, never a hash.
pub fn rt_hal_exact_exit_schema_resolve(stable_schema_id: i64,role: i64) ->i64:
    if not _exit_sealed:return -1
    val slot=_exit_schema_slot(stable_schema_id)
    if slot<0:return -1
    val result=if role==2:_exit_schema_output_type[slot] elif role==3:_exit_schema_error_type[slot] elif role==4:_exit_schema_effect_type[slot] else:-1
    if not _exit_type_valid(result):return -1
    result

# Entry-side request capture.  These functions are deliberately a second
# scalar-token ABI rather than aliases for the exit writer: argument capture
# happens before Pure execution and must never read a later outcome stream.
fn _exit_request_slot(token: i64) ->i64:
    val slot=token-1
    if slot<0 or slot>=_exit_max_exits or slot>=_exit_request_token.len() or
       _exit_request_token[slot]!=token:return -1
    slot

# Request capture precedes both the parent effect and the terminal writer, so
# it has its own lifetime pin.  Acquire before reading any reusable arena
# table/slot state; reset closes the shared epoch before waiting for this pin.
fn _exit_request_pin_open() ->i64:
    _exit_request_pins.fetch_add(1,MemoryOrdering.AcqRel)
    val epoch=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire)
    if epoch<=0 or _exit_controller_queue_closed.load(MemoryOrdering.Acquire)!=0 or
       not _exit_installed or not _exit_sealed or not _exit_controller_ready or
       not rt_hal_process_lifecycle_is_ready():
        _exit_request_pins.fetch_sub(1,MemoryOrdering.Release)
        return 0
    epoch

fn _exit_request_unpin(slot: i64):
    if slot<0 or slot>=_exit_request_epoch.len() or _exit_request_epoch[slot]<=0:return
    _exit_request_epoch[slot]=0
    _exit_request_pins.fetch_sub(1,MemoryOrdering.Release)

fn _exit_request_pinned_ready(slot: i64) ->bool:
    if slot<0 or slot>=_exit_request_epoch.len():return false
    val epoch=_exit_request_epoch[slot]
    epoch>0 and epoch==_exit_controller_queue_epoch.load(MemoryOrdering.Acquire) and
        _exit_controller_queue_closed.load(MemoryOrdering.Acquire)==0 and
        _exit_controller_ready and rt_hal_process_lifecycle_is_ready()

fn _exit_request_capacity() ->i64:
    if _exit_max_exits<=0:return 0
    _exit_max_bytes/_exit_max_exits

fn _exit_request_write_i64(slot: i64,offset: i64,value: i64) ->bool:
    val cap=_exit_request_capacity();val base=slot*cap
    if slot<0 or cap<8 or offset<0 or offset>cap-8 or base<0 or base>_exit_request_bytes.len()-cap:return false
    val bits=value as u64;var lane=0
    while lane<8:
        _exit_request_bytes[base+offset+lane]=((bits>>(lane*8))&255u64) as u8
        lane=lane+1
    true

fn _exit_request_read_i64(slot: i64,offset: i64) ->i64:
    val cap=_exit_request_capacity();val base=slot*cap
    if slot<0 or cap<8 or offset<0 or offset>cap-8 or base<0 or base>_exit_request_bytes.len()-cap:return -1
    var value=0i64;var lane=0
    while lane<8:
        value=value|((_exit_request_bytes[base+offset+lane] as i64)<<(lane*8))
        lane=lane+1
    value

fn _exit_request_read_u32(slot: i64,offset: i64) ->i64:
    val cap=_exit_request_capacity();val base=slot*cap
    if slot<0 or offset<0 or offset>cap-4 or base<0 or base>_exit_request_bytes.len()-cap:return -1
    var value=0i64;var lane=0
    while lane<4:
        value=value|((_exit_request_bytes[base+offset+lane] as i64)<<(lane*8))
        lane=lane+1
    value

fn _exit_request_effect_is_v3_record(slot: i64) ->bool:
    if slot<0 or slot>=_exit_max_exits:return false
    val cap=_exit_request_capacity();val input_events=_exit_request_events_length[slot]
    val input_payload=_exit_request_payload_length[slot]
    val event_bytes=_exit_request_effect_events_length[slot]
    val payload_length=_exit_request_effect_payload_length[slot]
    if _exit_request_effect_descriptor[slot]!="v2;bytes" or event_bytes!=64 or
       payload_length<RT_HAL_ENV_EFFECT_V3_HEADER_BYTES or input_events<0 or input_payload<0 or
       input_events>cap or input_payload>cap-input_events or event_bytes>cap-input_events-input_payload or
       payload_length>cap-input_events-input_payload-event_bytes:return false
    val events_offset=input_events+input_payload
    if _exit_request_read_i64(slot,events_offset)!=1 or _exit_request_read_i64(slot,events_offset+8)!=(5i64<<32) or
       _exit_request_read_i64(slot,events_offset+16)!=23 or _exit_request_read_i64(slot,events_offset+24)!=payload_length or
       _exit_request_read_i64(slot,events_offset+32)!=24 or _exit_request_read_i64(slot,events_offset+40)!=0 or
       _exit_request_read_i64(slot,events_offset+48)!=2 or _exit_request_read_i64(slot,events_offset+56)!=0:return false
    val payload_offset=events_offset+event_bytes;val base=slot*cap
    if _exit_request_bytes[base+payload_offset] as i64!=82 or _exit_request_bytes[base+payload_offset+1] as i64!=84 or
       _exit_request_bytes[base+payload_offset+2] as i64!=72 or _exit_request_bytes[base+payload_offset+3] as i64!=65 or
       _exit_request_bytes[base+payload_offset+4] as i64!=76 or _exit_request_bytes[base+payload_offset+5] as i64!=69 or
       _exit_request_bytes[base+payload_offset+6] as i64!=78 or _exit_request_bytes[base+payload_offset+7] as i64!=86 or
       _exit_request_bytes[base+payload_offset+8] as i64!=51:return false
    _exit_request_read_u32(slot,payload_offset+9)==RT_HAL_ENV_EFFECT_V3_VERSION and
    _exit_request_read_u32(slot,payload_offset+13)==RT_HAL_ENV_EFFECT_V3_RECORD_OPCODE and
    _exit_request_read_u32(slot,payload_offset+17)==payload_length-RT_HAL_ENV_EFFECT_V3_HEADER_BYTES

pub fn rt_hal_exact_request_begin(operation_id: text,input_descriptor: text) ->i64:
    val epoch=_exit_request_pin_open()
    if epoch<=0:return -1
    if operation_id=="" or operation_id.len()>4096:
        _exit_request_pins.fetch_sub(1,MemoryOrdering.Release);return -1
    val canonical=rt_hal_exact_type_descriptor_canonical(input_descriptor)
    # One canonical tuple is the operation ABI, including the valid empty
    # tuple. Nominal/pointer/dynamic input types never cross this boundary.
    if canonical=="" or not canonical.starts_with("v2;tuple;"):
        _exit_request_pins.fetch_sub(1,MemoryOrdering.Release);return -1
    val slot=_exit_request_next.fetch_add(1,MemoryOrdering.AcqRel)
    if slot<0 or slot>=_exit_max_exits:
        _exit_request_pins.fetch_sub(1,MemoryOrdering.Release);return -1
    val token=slot+1
    _exit_request_operation[slot]=operation_id;_exit_request_descriptor[slot]=canonical
    _exit_request_epoch[slot]=epoch
    _exit_request_events_length[slot]=0;_exit_request_payload_length[slot]=0
    _exit_request_state[slot]=0;_exit_request_remaining[slot]=0;_exit_request_token[slot]=token
    _exit_request_effect_descriptor[slot]="";_exit_request_effect_events_length[slot]=0
    _exit_request_effect_payload_length[slot]=0;_exit_request_effect_state[slot]=0
    _exit_request_effect_remaining[slot]=0
    token

pub fn rt_hal_exact_request_events_begin(token: i64,event_count: i64) ->bool:
    val slot=_exit_request_slot(token);val cap=_exit_request_capacity()
    if slot<0 or _exit_request_state[slot]!=0 or event_count<=0 or event_count>cap/16:return false
    _exit_request_events_length[slot]=event_count*16;_exit_request_remaining[slot]=event_count*16
    _exit_request_state[slot]=1;true

pub fn rt_hal_exact_request_write_event(token: i64,tag: i64,arg: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_state[slot]!=1 or _exit_request_remaining[slot]<16:return false
    val offset=_exit_request_events_length[slot]-_exit_request_remaining[slot]
    if not _exit_request_write_i64(slot,offset,tag) or not _exit_request_write_i64(slot,offset+8,arg):return false
    _exit_request_remaining[slot]=_exit_request_remaining[slot]-16;true

pub fn rt_hal_exact_request_events_end(token: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_state[slot]!=1:return false
    # Composite MIR reserves the cold maximum transcript for Result, then
    # emits only the selected typed arm.  The request arena owns the fixed
    # reservation and can shrink its retained event span before payload
    # begins; no unused byte is observable to HIO2 or a foreign provider.
    if _exit_request_remaining[slot]>0:
        val unused=_exit_request_remaining[slot]
        if unused<0 or _exit_request_events_length[slot]<unused:return false
        _exit_request_events_length[slot]=_exit_request_events_length[slot]-unused
        _exit_request_remaining[slot]=0
    _exit_request_state[slot]=2;true

pub fn rt_hal_exact_request_payload_begin(token: i64,byte_length: i64) ->bool:
    val slot=_exit_request_slot(token);val cap=_exit_request_capacity()
    if slot<0 or _exit_request_state[slot]!=2 or byte_length!=-1:return false
    # `-1` is a bounded streaming reservation used for UTF-8 and composite
    # leaves whose exact byte count is runtime-dependent. The slot capacity
    # is fixed; every write advances an explicit retained-length counter.
    _exit_request_payload_length[slot]=0
    _exit_request_remaining[slot]=cap-_exit_request_events_length[slot]
    _exit_request_state[slot]=3;true

pub fn rt_hal_exact_request_write_byte(token: i64,value: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_state[slot]!=3 or _exit_request_remaining[slot]<=0 or value<0 or value>255:return false
    val offset=_exit_request_events_length[slot]+_exit_request_payload_length[slot]
    val cap=_exit_request_capacity();val base=slot*cap
    if offset<0 or offset>=cap or base<0 or base>_exit_request_bytes.len()-cap:return false
    _exit_request_bytes[base+offset]=value as u8;_exit_request_remaining[slot]=_exit_request_remaining[slot]-1
    _exit_request_payload_length[slot]=_exit_request_payload_length[slot]+1;true

pub fn rt_hal_exact_request_payload_end(token: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_state[slot]!=3:return false
    _exit_request_state[slot]=4;true

pub fn rt_hal_exact_request_write_scalar(token: i64,value_bits: i64,width: i64) ->bool:
    if width<0 or width>8:return false
    var lane=0
    while lane<width:
        if not rt_hal_exact_request_write_byte(token,((value_bits as u64>>(lane*8))&255u64) as i64):return false
        lane=lane+1
    true

pub fn rt_hal_exact_request_write_utf8(token: i64,value: text) ->bool:
    val length=value.len()
    if length<0:return false
    var index=0
    while index<length:
        if not rt_hal_exact_request_write_byte(token,value.byte_at(index)):return false
        index=index+1
    true

pub fn rt_hal_exact_request_finish(token: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_state[slot]!=4:return false
    # The input root is a complete transcript before the Pure body may run.
    # Linking it to a terminal is a separate one-shot operation below.
    _exit_request_state[slot]=5;true

# Pre-Pure request capture has its own lifetime.  A rejected projection or
# writer must retire the reserved fixed slot without touching the unrelated
# terminal writer gate.  Slots are generation-local and never reissued, so a
# stale token cannot resurrect a later request.
pub fn rt_hal_exact_request_abort(token: i64):
    val slot=_exit_request_slot(token)
    if slot<0:return
    _exit_request_state[slot]=-1
    _exit_request_remaining[slot]=0
    _exit_request_events_length[slot]=0
    _exit_request_payload_length[slot]=0
    _exit_request_effect_state[slot]=-1
    _exit_request_effect_remaining[slot]=0
    _exit_request_effect_events_length[slot]=0
    _exit_request_effect_payload_length[slot]=0
    _exit_request_unpin(slot)

# Record one canonical observable-effect plan after the pre-Pure input has
# frozen.  The plan is a typed environment-instruction transcript, not an
# outcome seed: it has no output/error fields and can be handed to C/Rust only
# through the paired replay lease.  State 0 means no observable effect; state
# 5 means one fully sealed exactly-once plan.  Any duplicate or malformed
# attempt fails closed rather than coalescing two physical operations.
pub fn rt_hal_exact_request_effect_begin(token: i64,effect_descriptor: text,
        event_count: i64,payload_length: i64) ->bool:
    val slot=_exit_request_slot(token);val cap=_exit_request_capacity()
    if slot<0 or _exit_request_state[slot]!=5 or _exit_request_effect_state[slot]!=0 or
       event_count!=4 or payload_length<RT_HAL_ENV_EFFECT_V3_HEADER_BYTES or event_count>cap/16:return false
    val canonical=rt_hal_exact_type_descriptor_canonical(effect_descriptor)
    # V3 records only the registered, idempotent EnvAccess `record` plan.
    # Other descriptors/opcodes must not silently become unit effects.
    if canonical!="v2;bytes" or _exit_request_events_length[slot]<0 or
       _exit_request_payload_length[slot]<0 or _exit_request_events_length[slot]>cap or
       _exit_request_payload_length[slot]>cap-_exit_request_events_length[slot] or
       event_count>(cap-_exit_request_events_length[slot]-_exit_request_payload_length[slot])/16:
        return false
    val event_bytes=event_count*16
    if event_bytes<0 or event_bytes>cap-_exit_request_events_length[slot]-_exit_request_payload_length[slot] or
       payload_length>cap-_exit_request_events_length[slot]-_exit_request_payload_length[slot]-event_bytes:
        return false
    _exit_request_effect_descriptor[slot]=canonical
    _exit_request_effect_events_length[slot]=event_bytes
    _exit_request_effect_payload_length[slot]=payload_length
    _exit_request_effect_remaining[slot]=event_bytes
    _exit_request_effect_state[slot]=1
    true

pub fn rt_hal_exact_request_effect_write_event(token: i64,tag: i64,arg: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_effect_state[slot]!=1 or _exit_request_effect_remaining[slot]<16:return false
    val offset=_exit_request_events_length[slot]+_exit_request_payload_length[slot]+
        _exit_request_effect_events_length[slot]-_exit_request_effect_remaining[slot]
    if not _exit_request_write_i64(slot,offset,tag) or not _exit_request_write_i64(slot,offset+8,arg):return false
    _exit_request_effect_remaining[slot]=_exit_request_effect_remaining[slot]-16
    true

pub fn rt_hal_exact_request_effect_events_end(token: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_effect_state[slot]!=1 or _exit_request_effect_remaining[slot]!=0:return false
    _exit_request_effect_remaining[slot]=_exit_request_effect_payload_length[slot]
    _exit_request_effect_state[slot]=2
    true

pub fn rt_hal_exact_request_effect_write_byte(token: i64,value: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_effect_state[slot]!=2 or _exit_request_effect_remaining[slot]<=0 or value<0 or value>255:return false
    val offset=_exit_request_events_length[slot]+_exit_request_payload_length[slot]+
        _exit_request_effect_events_length[slot]+(_exit_request_effect_payload_length[slot]-_exit_request_effect_remaining[slot])
    val cap=_exit_request_capacity();val base=slot*cap
    if offset<0 or offset>=cap or base<0 or base>_exit_request_bytes.len()-cap:return false
    _exit_request_bytes[base+offset]=value as u8
    _exit_request_effect_remaining[slot]=_exit_request_effect_remaining[slot]-1
    true

pub fn rt_hal_exact_request_effect_finish(token: i64) ->bool:
    val slot=_exit_request_slot(token)
    if slot<0 or _exit_request_effect_state[slot]!=2 or _exit_request_effect_remaining[slot]!=0:return false
    # Seal only the one declared V3 canonical record transcript.  Validation
    # occurs before the plan becomes visible to controller fan-out, so a
    # malformed plan cannot be replayed by either independent provider.
    if not _exit_request_effect_is_v3_record(slot):return false
    _exit_request_effect_state[slot]=5
    true

# Canonical parent-owned environment-plan extraction.  The compiler places one
# call immediately before the direct `env_access_execute(plan, capability)`
# boundary in a foreign-compared @rt(hal) body.  The authored call remains the
# one and only executor; this helper only freezes the complete declared plan
# into the paired foreign replay lease.  It never has a host capability,
# process handle, or ambient environment authority.
#
# V3 intentionally has a single opaque `record` argument.  Its body is a
# bounded, length-prefixed plan image so all 24 closed EnvAccess kinds retain
# their exact kind/resource/argument/budget identity without inventing a raw
# pointer or command-string ABI.  Foreign adapter 4 records this exact image;
# it cannot execute it.  The parent executes the original typed plan exactly
# once after this function seals it.
fn _exit_env_effect_kind_code(kind: EnvAccessKind) ->i64:
    match kind:
        case EnvAccessKind.ReadEnv: 1
        case EnvAccessKind.HostIdentity: 2
        case EnvAccessKind.ReadRepoFile: 3
        case EnvAccessKind.RunAllowedTool: 4
        case EnvAccessKind.HardwareProbe: 5
        case EnvAccessKind.SocketConnect: 6
        case EnvAccessKind.SocketSend: 7
        case EnvAccessKind.SocketReceive: 8
        case EnvAccessKind.SocketClose: 9
        case EnvAccessKind.DeviceRead: 10
        case EnvAccessKind.DeviceWrite: 11
        case EnvAccessKind.MmioRead: 12
        case EnvAccessKind.MmioWrite: 13
        case EnvAccessKind.IrqEnable: 14
        case EnvAccessKind.IrqWait: 15
        case EnvAccessKind.IrqAcknowledge: 16
        case EnvAccessKind.IrqDisable: 17
        case EnvAccessKind.DmaMap: 18
        case EnvAccessKind.DmaSyncForDevice: 19
        case EnvAccessKind.DmaSyncForCpu: 20
        case EnvAccessKind.DmaSubmit: 21
        case EnvAccessKind.DmaWait: 22
        case EnvAccessKind.DmaUnmap: 23
        case EnvAccessKind.ClockRead: 24

fn _exit_env_effect_text_length(value: text) ->i64:
    var length=0
    for _ in value.bytes(): length=length+1
    length

fn _exit_env_effect_text_image_length(value: text) ->i64:
    4+_exit_env_effect_text_length(value)

fn _exit_env_effect_plan_image_length(plan: EnvAccessPlan) ->i64:
    # `env_access_plan_error` has already bounded every individual field. The
    # subtraction-form arena check in the caller below still makes this
    # fail-closed if a future model extension changes those bounds.
    var length=4+_exit_env_effect_text_image_length(plan.plan_id)+
        _exit_env_effect_text_image_length(plan.canonical_repo_root)+16+4
    for tool in plan.allowed_tools:
        length=length+_exit_env_effect_text_image_length(tool.tool_id)+
            _exit_env_effect_text_image_length(tool.canonical_path)+
            _exit_env_effect_text_image_length(tool.identity_hash)
    length=length+4
    for probe in plan.allowed_hardware_probes:
        length=length+_exit_env_effect_text_image_length(probe.probe_id)+
            _exit_env_effect_text_image_length(probe.schema_id)+32
    length=length+4
    for instruction in plan.instructions:
        length=length+4+_exit_env_effect_text_image_length(instruction.resource)+4+24
        for argument in instruction.arguments:
            length=length+_exit_env_effect_text_image_length(argument)
    length

fn _exit_env_effect_write_u32(token: i64,value: i64) ->bool:
    if value<0 or value>4294967295:return false
    var lane=0
    while lane<4:
        if not rt_hal_exact_request_effect_write_byte(token,(value>>(lane*8))&255):return false
        lane=lane+1
    true

fn _exit_env_effect_write_i64(token: i64,value: i64) ->bool:
    var lane=0
    while lane<8:
        if not rt_hal_exact_request_effect_write_byte(token,(value>>(lane*8))&255):return false
        lane=lane+1
    true

fn _exit_env_effect_write_text(token: i64,value: text) ->bool:
    val length=_exit_env_effect_text_length(value)
    if not _exit_env_effect_write_u32(token,length):return false
    for byte in value.bytes():
        if not rt_hal_exact_request_effect_write_byte(token,byte.to_i64()):return false
    true

# Returns false for an invalid/unbounded plan before it becomes visible to a
# foreign worker. The helper performs two linear, allocation-free passes over
# the caller-owned plan: one for exact bounded length, then one direct write
# to the request slot. No concatenated text/image is materialised.
pub fn rt_hal_exact_request_effect_capture_env_plan(token: i64,plan: EnvAccessPlan) ->bool:
    if env_access_plan_error(plan)!="":return false
    val image_length=_exit_env_effect_plan_image_length(plan)
    val payload_length=RT_HAL_ENV_EFFECT_V3_HEADER_BYTES+image_length
    val slot=_exit_request_slot(token);val cap=_exit_request_capacity()
    # Check the pre-sealed operation policy before any parent executor call or
    # request-slot mutation.  A late spawn-only rejection would permit an
    # unrecorded physical effect; missing/mismatched adapter-4 rows trap via
    # the compiler's checked helper path before the authored call executes.
    if slot<0 or not _exit_request_pinned_ready(slot) or
       not _exit_request_effect_operation_admitted(slot) or
       image_length<0 or payload_length<RT_HAL_ENV_EFFECT_V3_HEADER_BYTES or
       payload_length>cap:return false
    if not rt_hal_exact_request_effect_begin(token,"v2;bytes",4,payload_length):return false
    if not rt_hal_exact_request_effect_write_event(token,1,5i64<<32) or
       not rt_hal_exact_request_effect_write_event(token,23,payload_length) or
       not rt_hal_exact_request_effect_write_event(token,24,0) or
       not rt_hal_exact_request_effect_write_event(token,2,0) or
       not rt_hal_exact_request_effect_events_end(token):return false
    for byte in "RTHALENV3".bytes():
        if not rt_hal_exact_request_effect_write_byte(token,byte.to_i64()):return false
    if not _exit_env_effect_write_u32(token,RT_HAL_ENV_EFFECT_V3_VERSION) or
       not _exit_env_effect_write_u32(token,RT_HAL_ENV_EFFECT_V3_RECORD_OPCODE) or
       not _exit_env_effect_write_u32(token,image_length):return false
    # Body v1: version, plan identity/root/budgets, allowlists, instructions.
    # Every field is length-prefixed or fixed-width; therefore an unknown
    # future kind cannot be confused with a neighboring field on replay.
    if not _exit_env_effect_write_u32(token,1) or
       not _exit_env_effect_write_text(token,plan.plan_id) or
       not _exit_env_effect_write_text(token,plan.canonical_repo_root) or
       not _exit_env_effect_write_i64(token,plan.max_total_bytes) or
       not _exit_env_effect_write_i64(token,plan.max_processes) or
       not _exit_env_effect_write_u32(token,plan.allowed_tools.len()):return false
    for tool in plan.allowed_tools:
        if not _exit_env_effect_write_text(token,tool.tool_id) or
           not _exit_env_effect_write_text(token,tool.canonical_path) or
           not _exit_env_effect_write_text(token,tool.identity_hash):return false
    if not _exit_env_effect_write_u32(token,plan.allowed_hardware_probes.len()):return false
    for probe in plan.allowed_hardware_probes:
        if not _exit_env_effect_write_text(token,probe.probe_id) or
           not _exit_env_effect_write_text(token,probe.schema_id) or
           not _exit_env_effect_write_i64(token,probe.max_arguments) or
           not _exit_env_effect_write_i64(token,probe.max_timeout_ms) or
           not _exit_env_effect_write_i64(token,probe.max_stdout_bytes) or
           not _exit_env_effect_write_i64(token,probe.max_stderr_bytes):return false
    if not _exit_env_effect_write_u32(token,plan.instructions.len()):return false
    for instruction in plan.instructions:
        if not _exit_env_effect_write_u32(token,_exit_env_effect_kind_code(instruction.kind)) or
           not _exit_env_effect_write_text(token,instruction.resource) or
           not _exit_env_effect_write_u32(token,instruction.arguments.len()):return false
        for argument in instruction.arguments:
            if not _exit_env_effect_write_text(token,argument):return false
        if not _exit_env_effect_write_i64(token,instruction.timeout_ms) or
           not _exit_env_effect_write_i64(token,instruction.max_stdout_bytes) or
           not _exit_env_effect_write_i64(token,instruction.max_stderr_bytes):return false
    rt_hal_exact_request_effect_finish(token)

# Kept as a named checked boundary so compiler lowering can distinguish an
# unrepresentable/dynamic environment call from an empty query.  It never
# creates a unit effect or skip record: the generated failure CFG rolls back
# the request and traps with RTHAL-E-ENV-EFFECT-DYNAMIC-UNREPRESENTABLE.
pub fn rt_hal_exact_request_effect_reject_dynamic(token: i64) ->bool:
    false

# Pin before reading any reusable capture/table state.  Reset closes admission
# before checking pins; a successful pin therefore protects one generation
# until its matching release.  It is an i64 epoch rather than a boolean so an
# old terminal cannot become valid if the fixed arena is later reinstalled.
fn _exit_controller_queue_pin_open() ->i64:
    _exit_controller_queue_producers.fetch_add(1,MemoryOrdering.AcqRel)
    val epoch=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire)
    if epoch<=0 or _exit_controller_queue_closed.load(MemoryOrdering.Acquire)!=0:
        _exit_controller_queue_producers.fetch_sub(1,MemoryOrdering.Release)
        _exit_controller_queue_failed.store(1,MemoryOrdering.Release)
        return 0
    epoch

fn _exit_controller_queue_unpin():
    _exit_controller_queue_producers.fetch_sub(1,MemoryOrdering.Release)

# Requires the caller's queue pin and capture-admission gate.  All table and
# writer reads are deliberately below those two fences.
fn _exit_begin_pinned(epoch: i64,case_id: i64,schema_id: i64,kind_code: i64,
        output_type_id: i64,error_type_id: i64,effect_type_id: i64) ->i64:
    if epoch<=0 or epoch!=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire):return -1
    if not _exit_installed or not _exit_sealed or _exit_writer!=0 or
       _exit_controller_queue_closed.load(MemoryOrdering.Acquire)!=0 or _exit_count>=_exit_max_exits or
       case_id<0 or schema_id<=0 or not _exit_kind_valid(kind_code) or
       not _exit_type_valid(output_type_id) or not _exit_type_valid(error_type_id) or not _exit_type_valid(effect_type_id):return -1
    val index=_exit_count;_exit_count=_exit_count+1
    _exit_case[index]=case_id;_exit_epoch[index]=epoch;_exit_schema[index]=schema_id;_exit_kind[index]=kind_code
    _exit_output_type[index]=output_type_id;_exit_error_type[index]=error_type_id;_exit_effect_type[index]=effect_type_id
    _exit_output_offset[index]=_exit_payload_used;_exit_output_length[index]=0
    _exit_error_offset[index]=_exit_payload_used;_exit_error_length[index]=0
    _exit_effect_offset[index]=_exit_payload_used;_exit_effect_length[index]=0
    _exit_output_events_offset[index]=_exit_payload_used;_exit_output_events_length[index]=0
    _exit_error_events_offset[index]=_exit_payload_used;_exit_error_events_length[index]=0
    _exit_effect_events_offset[index]=_exit_payload_used;_exit_effect_events_length[index]=0
    _exit_leaf_domain=-1;_exit_leaf_count=0
    val token=_exit_next_writer;_exit_next_writer=_exit_next_writer+1
    if _exit_next_writer<=0:_exit_next_writer=1
    _exit_capture_epoch=epoch;_exit_writer=token;token

# Scalar compiler-callable entry.  All type values are fixed table indexes;
# unsupported/dynamic runtime values must serialize through the byte writer or
# fail before calling this operation.  This prevents pointer-bit transport.
pub fn rt_hal_exact_exit_begin(case_id: i64,schema_id: i64,kind_code: i64,
        output_type_id: i64,error_type_id: i64,effect_type_id: i64) ->i64:
    # Pin and claim before any reusable capture/table/writer state is read.
    val epoch=_exit_controller_queue_pin_open()
    if epoch<=0:return -1
    if not _exit_capture_gate.compare_exchange(0,1,MemoryOrdering.AcqRel,
            MemoryOrdering.Acquire):
        _exit_controller_queue_unpin();return -1
    val token=_exit_begin_pinned(epoch,case_id,schema_id,kind_code,
        output_type_id,error_type_id,effect_type_id)
    if token<=0:
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin()
    token

pub fn rt_hal_exact_exit_payload_begin(token: i64,domain_code: i64,byte_length: i64) ->bool:
    if token<=0 or token!=_exit_writer or _exit_writing_domain>=0 or not _exit_domain_valid(domain_code) or
       byte_length<0 or byte_length>_exit_max_bytes-_exit_payload_used:return false
    val index=_exit_count-1
    if not _exit_payload_length_valid(_exit_domain_type(index,domain_code),_exit_domain_events(index,domain_code),byte_length):return false
    if domain_code==2:
        _exit_output_offset[index]=_exit_payload_used;_exit_output_length[index]=byte_length
    elif domain_code==3:
        _exit_error_offset[index]=_exit_payload_used;_exit_error_length[index]=byte_length
    else:
        _exit_effect_offset[index]=_exit_payload_used;_exit_effect_length[index]=byte_length
    _exit_writing_domain=domain_code;_exit_writing_remaining=byte_length;_exit_writing_events=false;true

# Canonical codec transcript ABI. Each event is exactly 16 bytes (little
# endian i64 tag then i64 argument), matching HIO2's transcript contract.
pub fn rt_hal_exact_exit_event_begin(token: i64,domain_code: i64,event_count: i64) ->bool:
    if token<=0 or token!=_exit_writer or _exit_writing_domain>=0 or not _exit_domain_valid(domain_code) or
       event_count<=0 or event_count>_exit_max_bytes/16 or event_count*16>_exit_max_bytes-_exit_payload_used:return false
    val index=_exit_count-1
    if _exit_type_encoding[_exit_domain_type(index,domain_code)-1]!=6:return false
    val byte_length=event_count*16
    if domain_code==2:
        _exit_output_events_offset[index]=_exit_payload_used;_exit_output_events_length[index]=byte_length
    elif domain_code==3:
        _exit_error_events_offset[index]=_exit_payload_used;_exit_error_events_length[index]=byte_length
    else:
        _exit_effect_events_offset[index]=_exit_payload_used;_exit_effect_events_length[index]=byte_length
    _exit_writing_domain=domain_code;_exit_writing_remaining=byte_length;_exit_writing_events=true;true

pub fn rt_hal_exact_exit_event_append(token: i64,tag: i64,arg: i64) ->bool:
    if token<=0 or token!=_exit_writer or not _exit_writing_events or _exit_writing_remaining<16:return false
    val tag_bits=tag as u64;val arg_bits=arg as u64;var lane=0
    while lane<8:
        _exit_bytes[_exit_payload_used+lane]=((tag_bits>>(lane*8))&255u64) as u8
        _exit_bytes[_exit_payload_used+8+lane]=((arg_bits>>(lane*8))&255u64) as u8
        lane=lane+1
    _exit_payload_used=_exit_payload_used+16;_exit_writing_remaining=_exit_writing_remaining-16;true

pub fn rt_hal_exact_exit_payload_byte(token: i64,value: i64) ->bool:
    if token<=0 or token!=_exit_writer or _exit_writing_events or _exit_writing_domain<0 or _exit_writing_remaining<=0 or value<0 or value>255:return false
    _exit_bytes[_exit_payload_used]=value as u8;_exit_payload_used=_exit_payload_used+1;_exit_writing_remaining=_exit_writing_remaining-1;true

pub fn rt_hal_exact_exit_payload_end(token: i64,domain_code: i64) ->bool:
    if token<=0 or token!=_exit_writer or domain_code!=_exit_writing_domain or _exit_writing_remaining!=0:return false
    _exit_writing_domain=-1;_exit_writing_events=false;true

pub fn rt_hal_exact_exit_finish(token: i64) ->bool:
    if token<=0 or token!=_exit_writer or _exit_writing_domain>=0:return false
    # Compatibility finish retains the capture epoch pin until its required
    # public dispatch. This prevents an old finish→dispatch caller from being
    # reset or overtaken by controller close in that interval.
    _exit_writer=0;true

pub fn rt_hal_exact_exit_abort(token: i64) ->bool:
    if token<=0 or token!=_exit_writer:return false
    _exit_count=_exit_count-1
    if _exit_count<0:_exit_count=0
    # Payload space is reclaimable only for the active final record.
    val index=_exit_count
    if index>=0:_exit_payload_used=_exit_output_offset[index]
    val request_slot=if index>=0:_exit_request_slot(_exit_request_for_exit[index]) else:-1
    if request_slot>=0:_exit_request_unpin(request_slot)
    _exit_writer=0;_exit_capture_epoch=0;_exit_capture_gate.store(0,MemoryOrdering.Release);_exit_controller_queue_unpin();_exit_writing_domain=-1;_exit_writing_remaining=0;_exit_writing_events=false
    _exit_leaf_domain=-1;_exit_leaf_count=0;true

fn _exit_candidate(type_id: i64) ->RtHalExactTypeForeignCandidate:
    val i=type_id-1
    RtHalExactTypeForeignCandidate(schema_version:_exit_type_schema[i],lane0:_exit_type_lane0[i],lane1:_exit_type_lane1[i],
        lane2: _exit_type_lane2[i],lane3:_exit_type_lane3[i],descriptor_length:_exit_type_length[i],valid:true)

# The request side of a typed function exit is deliberately self-describing.
# It is a codec-parity request, rather than a pointer/stack-image surrogate:
# the input is a bounded canonical seed containing the already-captured
# Output/Error/Effect streams.  A C/Rust generic codec adapter must parse and
# re-emit that seed under the declared descriptors.  It therefore proves the
# foreign HIO2/codec path without pretending that an arbitrary tagged Simple
# function has a separately installed C/Rust semantic implementation.
#
# Crucially, producer-terminal dispatch writes it straight into a preinstalled
# wire slot. It does not construct a temporary `RtHalExactIoArena` or scan
# history: it copies only the current record's three bounded canonical streams
# plus descriptor spans and operation text. This is O(current exit bytes), not
# O(exit history), with the wire pool providing fixed bound/backpressure.
fn _exit_descriptor_candidate(descriptor: text) ->RtHalExactTypeForeignCandidate:
    RtHalExactTypeForeignCandidate(schema_version:RT_HAL_EXACT_TYPE_ID_VERSION,
        lane0: _exit_descriptor_lane(0,descriptor),lane1:_exit_descriptor_lane(1,descriptor),
        lane2: _exit_descriptor_lane(2,descriptor),lane3:_exit_descriptor_lane(3,descriptor),
        descriptor_length: descriptor.len(),valid:true)

fn _exit_wire_u8(handle: RtHalExactWireHandle,value: i64) ->bool:
    value>=0 and value<=255 and rt_hal_exact_wire_append_byte(handle,value as u8)

fn _exit_wire_u32(handle: RtHalExactWireHandle,value: i64) ->bool:
    if value<0 or value>4294967295:return false
    var lane=0
    while lane<4:
        if not _exit_wire_u8(handle,(value>>(lane*8))&255):return false
        lane=lane+1
    true

fn _exit_wire_i64(handle: RtHalExactWireHandle,value: i64) ->bool:
    val bits=value as u64;var lane=0
    while lane<8:
        if not _exit_wire_u8(handle,((bits>>(lane*8))&255u64) as i64):return false
        lane=lane+1
    true

fn _exit_wire_text(handle: RtHalExactWireHandle,value: text) ->bool:
    var index=0
    while index<value.len():
        if not _exit_wire_u8(handle,value.byte_at(index)):return false
        index=index+1
    true

fn _exit_wire_descriptor_span(handle: RtHalExactWireHandle,type_id: i64) ->bool:
    if not _exit_type_valid(type_id):return false
    val offset=_exit_type_descriptor_offset[type_id-1]
    val length=_exit_type_descriptor_length[type_id-1]
    if offset<0 or length<0 or offset>_exit_descriptor_used or length>_exit_descriptor_used-offset:return false
    var index=0
    while index<length:
        if not rt_hal_exact_wire_append_byte(handle,_exit_bytes[offset+index]):return false
        index=index+1
    true

fn _exit_wire_candidate_text(handle: RtHalExactWireHandle,
        candidate: RtHalExactTypeForeignCandidate,descriptor: text) ->bool:
    if not candidate.valid or candidate.descriptor_length!=descriptor.len():return false
    if (not _exit_wire_i64(handle,candidate.schema_version) or
        not _exit_wire_i64(handle,candidate.lane0) or not _exit_wire_i64(handle,candidate.lane1) or
        not _exit_wire_i64(handle,candidate.lane2) or not _exit_wire_i64(handle,candidate.lane3) or
        not _exit_wire_i64(handle,candidate.descriptor_length) or not _exit_wire_u32(handle,1) or
        not _exit_wire_u32(handle,descriptor.len())):return false
    _exit_wire_text(handle,descriptor)

fn _exit_wire_candidate_type(handle: RtHalExactWireHandle,type_id: i64) ->bool:
    if not _exit_type_valid(type_id):return false
    val candidate=_exit_candidate(type_id)
    val length=_exit_type_descriptor_length[type_id-1]
    if not candidate.valid or candidate.descriptor_length!=length:return false
    if (not _exit_wire_i64(handle,candidate.schema_version) or
        not _exit_wire_i64(handle,candidate.lane0) or not _exit_wire_i64(handle,candidate.lane1) or
        not _exit_wire_i64(handle,candidate.lane2) or not _exit_wire_i64(handle,candidate.lane3) or
        not _exit_wire_i64(handle,candidate.descriptor_length) or not _exit_wire_u32(handle,1) or
        not _exit_wire_u32(handle,length)):return false
    _exit_wire_descriptor_span(handle,type_id)

# A generic typed-exit seed has an eight-byte magic, outcome, and three
# {encoding,event_count,payload_length,event bytes,payload bytes} streams.
# It is a fixed-frame input value; the C/Rust adapters never receive a raw
# Simple value or an expected parent receipt.
fn _exit_seed_stream_events(exit_index: i64,domain: i64) ->i64:
    val recorded=_exit_domain_events(exit_index,domain)
    if recorded>0:return recorded
    val type_id=_exit_domain_type(exit_index,domain)
    if not _exit_type_valid(type_id):return -1
    if _exit_type_encoding[type_id-1]==2:return 64
    48

fn _exit_seed_length(exit_index: i64) ->i64:
    var total=88 # RTHEXIT2 + outcome + three 24-byte stream headers.
    var domain=2
    while domain<=4:
        val events=_exit_seed_stream_events(exit_index,domain)
        val payload=if domain==2:_exit_output_length[exit_index]
            elif domain==3:_exit_error_length[exit_index] else:_exit_effect_length[exit_index]
        if events<0 or payload<0 or total>_exit_max_bytes-events or
           total+events>_exit_max_bytes-payload:return -1
        total=total+events+payload;domain=domain+1
    total

fn _exit_wire_seed_events(handle: RtHalExactWireHandle,exit_index: i64,domain: i64) ->bool:
    val recorded=_exit_domain_events(exit_index,domain)
    if recorded>0:
        val offset=if domain==2:_exit_output_events_offset[exit_index]
            elif domain==3:_exit_error_events_offset[exit_index] else:_exit_effect_events_offset[exit_index]
        if offset<0 or recorded>_exit_payload_used-offset:return false
        var byte=0
        while byte<recorded:
            if not rt_hal_exact_wire_append_byte(handle,_exit_bytes[offset+byte]):return false
            byte=byte+1
        return true
    val type_id=_exit_domain_type(exit_index,domain)
    val payload=if domain==2:_exit_output_length[exit_index]
        elif domain==3:_exit_error_length[exit_index] else:_exit_effect_length[exit_index]
    if not _exit_type_valid(type_id) or payload<0:return false
    if not _exit_wire_i64(handle,1):return false
    # Root IDs are registry-local.  Only the portable domain lane crosses the
    # foreign boundary; parent replay resolves its own sealed dense root.
    if not _exit_wire_i64(handle,(domain+1)<<32):return false
    if _exit_type_encoding[type_id-1]==2:
        return _exit_wire_i64(handle,25) and _exit_wire_i64(handle,payload) and
            _exit_wire_i64(handle,26) and _exit_wire_i64(handle,0) and
            _exit_wire_i64(handle,2) and _exit_wire_i64(handle,0)
    val tag=_exit_scalar_event_tag(_exit_type_descriptor_text[type_id-1])
    if tag<0:return false
    _exit_wire_i64(handle,tag) and _exit_wire_i64(handle,
        _exit_scalar_event_arg(_exit_type_descriptor_text[type_id-1])) and
        _exit_wire_i64(handle,2) and _exit_wire_i64(handle,0)

fn _exit_wire_seed_payload(handle: RtHalExactWireHandle,exit_index: i64,domain: i64) ->bool:
    val offset=if domain==2:_exit_output_offset[exit_index]
        elif domain==3:_exit_error_offset[exit_index] else:_exit_effect_offset[exit_index]
    val length=if domain==2:_exit_output_length[exit_index]
        elif domain==3:_exit_error_length[exit_index] else:_exit_effect_length[exit_index]
    if offset<0 or length<0 or offset>_exit_payload_used or length>_exit_payload_used-offset:return false
    var byte=0
    while byte<length:
        if not rt_hal_exact_wire_append_byte(handle,_exit_bytes[offset+byte]):return false
        byte=byte+1
    true

fn _exit_wire_seed(handle: RtHalExactWireHandle,exit_index: i64) ->bool:
    # "RTHEXIT2" is deliberately distinct from a result magic. It names only
    # the generic foreign codec adapter input contract.
    if (not _exit_wire_u8(handle,82) or not _exit_wire_u8(handle,84) or
        not _exit_wire_u8(handle,72) or not _exit_wire_u8(handle,69) or
        not _exit_wire_u8(handle,88) or not _exit_wire_u8(handle,73) or
        not _exit_wire_u8(handle,84) or not _exit_wire_u8(handle,50)):return false
    val outcome=if _exit_kind[exit_index]==1:0 elif _exit_kind[exit_index]==4:2
        elif _exit_kind[exit_index]==5:3 else:1
    if not _exit_wire_i64(handle,outcome):return false
    var domain=2
    while domain<=4:
        val events=_exit_seed_stream_events(exit_index,domain)
        val payload=if domain==2:_exit_output_length[exit_index]
            elif domain==3:_exit_error_length[exit_index] else:_exit_effect_length[exit_index]
        if events<32 or events%16!=0 or payload<0 or
           not _exit_wire_i64(handle,6) or not _exit_wire_i64(handle,events/16) or
           not _exit_wire_i64(handle,payload) or
           not _exit_wire_seed_events(handle,exit_index,domain) or
           not _exit_wire_seed_payload(handle,exit_index,domain):return false
        domain=domain+1
    true

# The replay side channel is intentionally much smaller than an HIO2 request:
# it has only the exact effect payload and its canonical transcript.  The
# request already binds case/schema/operation/input.  This prevents an effect
# replay from becoming an oracle transport for the Pure terminal outcome.
fn _exit_effect_replay_frame(request: RtHalExactWireHandle,exit_index: i64) ->RtHalExactWireHandle:
    if request<=0 or exit_index<0 or exit_index>=_exit_count:return -1
    val request_slot=_exit_request_slot(_exit_request_for_exit[exit_index])
    if request_slot<0 or _exit_request_state[request_slot]!=5 or
       _exit_request_effect_state[request_slot]!=5:return -1
    val type_id=_exit_effect_type[exit_index]
    val payload=_exit_request_effect_payload_length[request_slot]
    val events=_exit_request_effect_events_length[request_slot]
    # No event means no observable effect plan.  A half-present stream is
    # malformed rather than silently downgraded to a query.
    if payload==0 and events==0:return -1
    if payload<0 or events<=0 or events%16!=0 or not _exit_type_valid(type_id):return -1
    val cap=_exit_request_capacity();val base=request_slot*cap
    val input_used=_exit_request_events_length[request_slot]+_exit_request_payload_length[request_slot]
    if cap<=0 or base<0 or base>_exit_request_bytes.len()-cap or input_used<0 or
       input_used>cap or events>cap-input_used or payload>cap-input_used-events:
        return -1
    val effect=rt_hal_exact_wire_reserve(RT_HAL_EXACT_WIRE_REQUEST,
        _exit_case[exit_index],0,0)
    if effect<=0:return -1
    # This is the shared HIO2 replay-frame contract: lengths followed by
    # bytes.  It is bounded by the preinstalled wire slot, is frozen before
    # handoff, and is cryptographically/structurally paired to the request by
    # the wire owner below.
    var written=_exit_wire_u32(effect,payload) and _exit_wire_u32(effect,events)
    var i=0
    while written and i<payload:
        written=rt_hal_exact_wire_append_byte(effect,_exit_request_bytes[base+input_used+events+i])
        i=i+1
    i=0
    while written and i<events:
        written=rt_hal_exact_wire_append_byte(effect,_exit_request_bytes[base+input_used+i])
        i=i+1
    if not written or not rt_hal_exact_wire_freeze(effect) or
       not rt_hal_exact_wire_bind_replay_pair(request,effect,_exit_schema[exit_index]):
        rt_hal_exact_wire_release(effect)
        return -1
    effect

fn _exit_wire_request_span(handle: RtHalExactWireHandle,slot: i64,offset: i64,length: i64) ->bool:
    val cap=_exit_request_capacity();val base=slot*cap
    if slot<0 or cap<=0 or offset<0 or length<0 or offset>cap or length>cap-offset or
       base<0 or base>_exit_request_bytes.len()-cap:return false
    var index=0
    while index<length:
        if not rt_hal_exact_wire_append_byte(handle,_exit_request_bytes[base+offset+index]):return false
        index=index+1
    true

fn _exit_hio2_current_frame(exit_index: i64) ->RtHalExactExitHio2Frame:
    val invalid=RtHalExactExitHio2Frame(request:-1,effect:-1,replay:false,valid:false)
    if _exit_writer!=0 or exit_index<0 or exit_index>=_exit_count:return invalid
    val operation_descriptor="v2;text:utf8"
    val request_slot=_exit_request_slot(_exit_request_for_exit[exit_index])
    if request_slot<0 or _exit_request_state[request_slot]!=5:return invalid
    val input_descriptor=_exit_request_descriptor[request_slot]
    val operation=_exit_request_operation[request_slot]
    val input_events=_exit_request_events_length[request_slot]
    val input_payload=_exit_request_payload_length[request_slot]
    if operation=="" or operation!=_exit_operation_id[exit_index] or operation.len()>4096 or
       input_descriptor=="" or input_events<32 or input_events%16!=0 or input_payload<0:return invalid
    val output_type=_exit_output_type[exit_index];val error_type=_exit_error_type[exit_index]
    val effect_type=_exit_effect_type[exit_index]
    if not _exit_type_valid(output_type) or not _exit_type_valid(error_type) or not _exit_type_valid(effect_type):return invalid
    val request=rt_hal_exact_wire_reserve(RT_HAL_EXACT_WIRE_REQUEST,_exit_case[exit_index],0,0)
    if request<=0:return invalid
    val written=(
        _exit_wire_u32(request,0x324f4948) and _exit_wire_u32(request,2) and
        _exit_wire_i64(request,_exit_case[exit_index]) and _exit_wire_i64(request,0) and
        _exit_wire_i64(request,_exit_schema[exit_index]) and
        _exit_wire_candidate_text(request,_exit_descriptor_candidate(operation_descriptor),operation_descriptor) and
        _exit_wire_candidate_text(request,_exit_descriptor_candidate(input_descriptor),input_descriptor) and
        _exit_wire_candidate_type(request,output_type) and _exit_wire_candidate_type(request,error_type) and
        _exit_wire_candidate_type(request,effect_type) and
        # An observable effect is replayed through the separately paired
        # effect frame below.  The HIO2 request therefore carries an effectful
        # operation kind but still contains no Pure terminal oracle.
        _exit_wire_u32(request,(if _exit_request_effect_state[request_slot]==5:
            RtHalOperationKind.Effectful as i64 else: RtHalOperationKind.Query as i64)) and
        _exit_wire_u32(request,RtHalExactEncoding.CanonicalCodecTranscript as i64) and
        _exit_wire_u32(request,RtHalExactIoDomain.Operation as i64) and
        _exit_wire_u32(request,operation.len()) and _exit_wire_u32(request,64) and
        _exit_wire_u32(request,RtHalExactEncoding.CanonicalCodecTranscript as i64) and
        _exit_wire_u32(request,RtHalExactIoDomain.Input as i64) and
        _exit_wire_u32(request,input_payload) and _exit_wire_u32(request,input_events) and
        # Foreign result streams are always canonical transcripts, including
        # scalar leaves whose capture fast path retained only payload bytes.
        _exit_wire_u32(request,RtHalExactEncoding.CanonicalCodecTranscript as i64) and
        _exit_wire_u32(request,RtHalExactEncoding.CanonicalCodecTranscript as i64) and
        _exit_wire_u32(request,RtHalExactEncoding.CanonicalCodecTranscript as i64) and
        _exit_wire_text(request,operation) and
        # Operation: RootBegin(domain 1), UTF-8 bytes, RootEnd.
        _exit_wire_i64(request,1) and _exit_wire_i64(request,1<<32) and
        _exit_wire_i64(request,25) and _exit_wire_i64(request,operation.len()) and
        _exit_wire_i64(request,26) and _exit_wire_i64(request,0) and
        _exit_wire_i64(request,2) and _exit_wire_i64(request,0) and
        # The Input span is the pre-Pure parameter transcript captured at
        # function entry.  No RTHEXIT2 seed or Pure outcome bytes are sent to
        # a provider, so echoing the request cannot satisfy exact comparison.
        _exit_wire_request_span(request,request_slot,0,input_events) and
        _exit_wire_request_span(request,request_slot,input_events,input_payload) and
        rt_hal_exact_wire_freeze(request))
    if not written:
        rt_hal_exact_wire_release(request);return invalid
    val effect=_exit_effect_replay_frame(request,exit_index)
    val replay=_exit_request_effect_state[request_slot]==5
    if replay and effect<=0:
        rt_hal_exact_wire_release(request);return invalid
    RtHalExactExitHio2Frame(request:request,effect:effect,replay:replay,valid:true)

# Compatibility surface for callers that still hand over a previously-built
# self request.  It validates that it names this terminal exit, then obtains a
# fixed wire frame directly; no source bytes or receipt history are copied.
pub fn rt_hal_exact_exit_hio2_frame(request_source: RtHalExactIoArena,
        request_index: i64,exit_index: i64,provider_ordinal: i64,
        bounds: RtHalExactIoBounds) ->RtHalExactExitHio2Frame:
    if exit_index<0 or exit_index>=_exit_count or provider_ordinal<=0 or request_index<0 or request_index>=request_source.requests.len() or
       rt_hal_exact_io_arena_error(request_source,bounds)!="":return RtHalExactExitHio2Frame(request:-1,effect:-1,replay:false,valid:false)
    val request=request_source.requests[request_index]
    if request.case_id!=_exit_case[exit_index] or request.schema_id!=_exit_schema[exit_index]:
        return RtHalExactExitHio2Frame(request:-1,effect:-1,replay:false,valid:false)
    _exit_hio2_current_frame(exit_index)

# Producer-side completion. This is intentionally only a bounded scalar
# enqueue: a terminal producer cannot claim the controller, construct HIO2
# frames, spawn a C/Rust process, wait for a join, or copy a payload. The
# controller drains this queue after producer quiescence.
fn _exit_controller_enqueue_after_capture(exit_index: i64,writer_token: i64,
        pinned_epoch: i64) ->bool:
    # The backend holds its terminal writer token through this publication.
    # That closes the otherwise-visible gap between `finish` and queue pinning:
    # the controller refuses to close/drain while `_exit_writer` is nonzero.
    # Legacy callers may dispatch an already-finished record with token zero.
    var epoch=pinned_epoch
    var owns_pin=false
    if epoch<=0:
        epoch=_exit_controller_queue_pin_open()
        owns_pin=true
    if epoch<=0:return false
    # All reusable-arena state, including the legacy raw writer token, is read
    # only after a stable epoch pin has been acquired.
    if epoch!=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire) or
       _exit_controller_queue_closed.load(MemoryOrdering.Acquire)!=0 or
       not _exit_controller_ready or _exit_writer!=writer_token or exit_index<0 or
       exit_index>=_exit_count or _exit_max_exits<=0 or
       _exit_controller_queue_sequence.len()!=_exit_max_exits:
        if owns_pin:_exit_controller_queue_unpin()
        _exit_controller_queue_failed.store(1,MemoryOrdering.Release)
        return false
    # The record carries the generation that finalized its capture.  A current
    # pin alone is insufficient: this check rejects any stale index before it
    # can claim a ticket in a newly installed fixed arena.
    if _exit_epoch.len()!=_exit_max_exits or _exit_epoch[exit_index]!=epoch:
        if owns_pin:_exit_controller_queue_unpin()
        _exit_controller_queue_failed.store(1,MemoryOrdering.Release)
        return false
    # Vyukov-style bounded MPSC claim.  Do not reserve with fetch_add: a full
    # queue must not create an unpublishable hole ahead of a later producer.
    # A failed compare-exchange only retries after another producer advanced
    # the head; all waits are bounded by competing producer progress.
    while true:
        val ticket=_exit_controller_queue_head.load(MemoryOrdering.Acquire)
        if ticket<0 or ticket==0x7fffffffffffffff:
            if owns_pin:_exit_controller_queue_unpin()
            _exit_controller_queue_failed.store(1,MemoryOrdering.Release)
            return false
        val slot=ticket%_exit_max_exits
        val sequence=_exit_controller_queue_sequence[slot].load(MemoryOrdering.Acquire)
        if sequence==ticket:
            if _exit_controller_queue_head.compare_exchange(ticket,ticket+1,
                    MemoryOrdering.AcqRel,MemoryOrdering.Acquire):
                # This normal store is ordered before the release publication
                # below; the controller acquires that sequence before reading.
                _exit_controller_queue[slot]=exit_index
                _exit_controller_queue_sequence[slot].store(ticket+1,
                    MemoryOrdering.Release)
                if owns_pin:_exit_controller_queue_unpin()
                return true
        elif sequence<ticket:
            # The slot still belongs to an unconsumed generation.  No spin,
            # overwrite, or dynamic overflow buffer is permitted.
            if owns_pin:_exit_controller_queue_unpin()
            _exit_controller_queue_failed.store(1,MemoryOrdering.Release)
            return false

pub fn rt_hal_exact_exit_controller_dispatch_after_capture(exit_index: i64) ->bool:
    # Legacy two-step finish/dispatch owns the same retained capture pin that
    # backend_finish consumes internally.  Do not create a second short pin:
    # the retained pin is what closes the finish-to-dispatch lifecycle gap.
    if _exit_capture_gate.load(MemoryOrdering.Acquire)!=1 or _exit_capture_epoch<=0:return false
    val epoch=_exit_capture_epoch
    val published=_exit_controller_enqueue_after_capture(exit_index,0,epoch)
    _exit_capture_epoch=0;_exit_capture_gate.store(0,MemoryOrdering.Release)
    _exit_controller_queue_unpin()
    published

# Controller-only fanout for one frozen capture. It starts every required
# C/Rust child before joining either one, then joins in provider ordinal order
# against one absolute deadline. That preserves deterministic parent commits
# while allowing the existing isolated task arena to execute foreign work in
# parallel. A failure cancels/reaps any already-started sibling.
fn _exit_controller_fanout_one(exit_index: i64) ->bool:
    val schema_id=_exit_schema[exit_index]
    val need_c=rt_hal_exact_exit_schema_requires_provider(schema_id,1)
    val need_rust=rt_hal_exact_exit_schema_requires_provider(schema_id,2)
    if not need_c and not need_rust:return true
    val timeout=rt_hal_process_io_timeout_ticks()
    val retained=rt_hal_process_io_max_retained_bytes()
    if timeout<=0 or retained<=0:return _exit_controller_fail("RTHAL-E-EXIT-CONFIG")
    val deadline=rt_hal_process_io_deadline_after(timeout)
    if deadline<=0:return _exit_controller_fail("RTHAL-E-EXIT-DEADLINE")
    # The controller, rather than a producer, selects the execution mode
    # once from the completed bounded receipt.  Both providers receive the
    # same operation/input request and (when present) the same paired effect
    # plan; neither receives the Pure result/error stream.
    val request_slot=_exit_request_slot(_exit_request_for_exit[exit_index])
    if request_slot<0 or _exit_request_state[request_slot]!=5:return _exit_controller_fail("RTHAL-E-EXIT-REQUEST")
    val replay=_exit_request_effect_state[request_slot]==5
    var c_task=-1
    var rust_task=-1
    if need_c:
        val adapter=rt_hal_process_adapter_handle_for_kind(1)
        if adapter<=0:return _exit_controller_fail("RTHAL-E-EXIT-C-ADAPTER")
        c_task=_exit_process_encode_submit_current(adapter,1,exit_index,replay)
        if c_task<=0:return _exit_controller_fail(if replay:
            "RTHAL-W-EFFECT-ADAPTER-UNSUPPORTED:C" else:
            "RTHAL-W-OPERATION-ADAPTER-UNSUPPORTED:C")
    if need_rust:
        val adapter=rt_hal_process_adapter_handle_for_kind(2)
        if adapter<=0:
            if c_task>0:rt_hal_process_cancel_io_task(c_task)
            return _exit_controller_fail("RTHAL-E-EXIT-RUST-ADAPTER")
        rust_task=_exit_process_encode_submit_current(adapter,2,exit_index,replay)
        if rust_task<=0:
            if c_task>0:rt_hal_process_cancel_io_task(c_task)
            return _exit_controller_fail(if replay:
                "RTHAL-W-EFFECT-ADAPTER-UNSUPPORTED:RUST" else:
                "RTHAL-W-OPERATION-ADAPTER-UNSUPPORTED:RUST")
    if c_task>0:
        var batch=RtHalExactIoParentBatch.begin(3,retained)
        if not rt_hal_exact_exit_process_join_compare_admit(c_task,deadline,
                _exit_controller_registry,_exit_controller_seal,batch,0,retained,exit_index):
            if rust_task>0:rt_hal_process_cancel_io_task(rust_task)
            return false
    if rust_task>0:
        var batch=RtHalExactIoParentBatch.begin(3,retained)
        if not rt_hal_exact_exit_process_join_compare_admit(rust_task,deadline,
                _exit_controller_registry,_exit_controller_seal,batch,0,retained,exit_index):return false
    true

# Called only from the compiler-injected controller finalizer. Queue order is
# the atomic producer-ticket linearization order, so parent commits remain
# deterministic even though each C/Rust pair was dispatched concurrently. The
# tail advances only after success; failure remains visible to the finalizer
# and prevents silent loss.
pub fn rt_hal_exact_exit_controller_drain_after_capture() ->bool:
    if not _exit_controller_ready:return false
    if rt_hal_process_controller_claim()!="":return false
    # Close admission before sampling tickets.  A successful close plus zero
    # producer pins proves every accepted slot has either published or caused
    # a fail-closed result; no producer can start after this transition.
    if not _exit_controller_queue_closed.compare_exchange(0,1,
            MemoryOrdering.AcqRel,MemoryOrdering.Acquire):
        return _exit_controller_fail("RTHAL-E-EXIT-QUEUE-CLOSED")
    if _exit_controller_queue_producers.load(MemoryOrdering.Acquire)!=0 or
       _exit_request_pins.load(MemoryOrdering.Acquire)!=0:
        return _exit_controller_fail("RTHAL-E-EXIT-QUEUE-PENDING")
    if _exit_writer!=0 or _exit_capture_gate.load(MemoryOrdering.Acquire)!=0:
        return _exit_controller_fail("RTHAL-E-EXIT-QUEUE-PENDING")
    if _exit_controller_queue_failed.load(MemoryOrdering.Acquire)!=0:
        return _exit_controller_fail("RTHAL-E-EXIT-QUEUE-BOUND")
    while true:
        val ticket=_exit_controller_queue_tail.load(MemoryOrdering.Acquire)
        val published=_exit_controller_queue_head.load(MemoryOrdering.Acquire)
        if ticket>=published:return true
        if ticket<0 or _exit_max_exits<=0:return _exit_controller_fail("RTHAL-E-EXIT-QUEUE")
        val slot=ticket%_exit_max_exits
        # Acquire pairs with the producer's release store after its normal
        # scalar slot write.  A claimed but unpublished earlier ticket is a
        # fail-closed finalization error: draining later tickets would violate
        # FIFO/capture order and silently hide a stalled producer.
        if _exit_controller_queue_sequence[slot].load(MemoryOrdering.Acquire)!=ticket+1:
            return _exit_controller_fail("RTHAL-E-EXIT-QUEUE-PENDING")
        val exit_index=_exit_controller_queue[slot]
        if exit_index<0 or exit_index>=_exit_count or
           _exit_epoch.len()!=_exit_max_exits or
           _exit_epoch[exit_index]!=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire):
            return _exit_controller_fail("RTHAL-E-EXIT-QUEUE")
        if not _exit_controller_fanout_one(exit_index):return false
        _exit_controller_queue[slot]=-1
        # Return this slot only after the controller transaction commits.  Its
        # next free generation is ticket+capacity, not merely zero.
        _exit_controller_queue_sequence[slot].store(ticket+_exit_max_exits,
            MemoryOrdering.Release)
        _exit_controller_queue_tail.store(ticket+1,MemoryOrdering.Release)

# MIR calls this unit-returning controller terminal. Keeping the trap here
# avoids a second whole-function helper-rewrite pass over already-checked cold
# schema calls, while still making drain failure a non-successful terminal.
pub fn rt_hal_exact_exit_controller_drain_after_capture_or_fail():
    if not rt_hal_exact_exit_controller_drain_after_capture():
        val problem=if _exit_controller_problem=="": "RTHAL-E-EXIT-DRAIN" else: _exit_controller_problem
        panic(problem)

# Production controller chain.  The foreign provider receives only a frozen
# wire request; its result still passes the normal process join, bounded
# descriptor re-admission, local seal reconstruction, and parent batch commit.
# `exit_index` is explicit rather than inferred so a controller may preserve
# deterministic case/provider order while draining all captured terminal kinds.
pub fn rt_hal_exact_exit_process_encode_submit(adapter_handle: i64,
        provider_ordinal: i64,request_source: RtHalExactIoArena,
        request_index: i64,exit_index: i64,bounds: RtHalExactIoBounds,
        replay: bool) ->i64:
    val frame=rt_hal_exact_exit_hio2_frame(request_source,request_index,
        exit_index,provider_ordinal,bounds)
    if not frame.valid:return -1
    # Callers may request replay only when the captured effect plan is
    # observable.  Conversely, an observable plan must never be sent through
    # the query spawn path: that would silently skip a physical side effect.
    if replay!=frame.replay:
        rt_hal_exact_wire_release(frame.request)
        if frame.effect>0:rt_hal_exact_wire_release(frame.effect)
        return -1
    # V3 owns exact operation admission. Query and explicitly registered
    # replay are distinct capabilities; neither may fall back to V2.
    val task=if frame.replay:
        rt_hal_process_spawn_replay_io_v3(adapter_handle,provider_ordinal,
            _exit_operation_id[exit_index],frame.request,frame.effect)
    else:
        rt_hal_process_spawn_compare_io_v3(adapter_handle,provider_ordinal,
            _exit_operation_id[exit_index],frame.request)
    # Successful spawn moves the producer lease into the host's acknowledged
    # consumer lease.  Release only on a rejected spawn; a second release
    # would violate the fixed-frame ownership contract.
    if task<=0:
        rt_hal_exact_wire_release(frame.request)
        if frame.effect>0:rt_hal_exact_wire_release(frame.effect)
        return -1
    task

# Controller-fanout-only fast path.  A terminal exit becomes one frozen wire
# lease; there is no temporary request arena or copy of the exit history.
fn _exit_process_encode_submit_current(adapter_handle: i64,provider_ordinal: i64,
        exit_index: i64,replay: bool) ->i64:
    val frame=_exit_hio2_current_frame(exit_index)
    if not frame.valid:return -1
    if replay!=frame.replay:
        rt_hal_exact_wire_release(frame.request)
        if frame.effect>0:rt_hal_exact_wire_release(frame.effect)
        return -1
    val task=if frame.replay:
        rt_hal_process_spawn_replay_io_v3(adapter_handle,provider_ordinal,
            _exit_operation_id[exit_index],frame.request,frame.effect)
    else:
        rt_hal_process_spawn_compare_io_v3(adapter_handle,provider_ordinal,
            _exit_operation_id[exit_index],frame.request)
    if task<=0:
        rt_hal_exact_wire_release(frame.request)
        if frame.effect>0:rt_hal_exact_wire_release(frame.effect)
        return -1
    task

pub fn rt_hal_exact_exit_process_join_admit(task_handle: i64,
        deadline_ticks: i64,registry: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal,batch: RtHalExactIoParentBatch,
        ordinal_base: i64,max_retained_bytes: i64) ->bool:
    if task_handle<=0 or deadline_ticks<=0 or ordinal_base<0 or max_retained_bytes<=0:
        batch.abort();return false
    rt_hal_process_join_admit_io(task_handle,deadline_ticks,registry,seal,batch,
        ordinal_base,max_retained_bytes)

# Read one little-endian i64 from the bounded foreign wire.  Every caller has
# already validated the parsed stream offsets; this helper retains a defensive
# subtraction-form bound so comparator diagnostics cannot become an OOB path.
fn _exit_wire_i64(wire: RtHalExactWireHandle,index: i64,length: i64) ->i64:
    if index<0 or index>length-8:return -1
    var bits: u64=0u64;var lane=0
    while lane<8:
        val byte=rt_hal_exact_wire_byte_at(wire,index+lane)
        if byte<0:return -1
        bits=bits|((byte as u64)<<(lane*8));lane=lane+1
    bits as i64

fn _exit_wire_i64_from_arena(index: i64) ->i64:
    if index<0 or index>_exit_payload_used-8:return -1
    var bits: u64=0u64;var lane=0
    while lane<8:
        bits=bits|((_exit_bytes[index+lane] as u64)<<(lane*8));lane=lane+1
    bits as i64

fn _exit_wire_i64_from_request(slot: i64,index: i64) ->i64:
    val cap=_exit_request_capacity();val base=slot*cap
    if slot<0 or cap<8 or index<0 or index>cap-8 or base<0 or
       base>_exit_request_bytes.len()-cap:return -1
    var bits: u64=0u64;var lane=0
    while lane<8:
        bits=bits|((_exit_request_bytes[base+index+lane] as u64)<<(lane*8));lane=lane+1
    bits as i64

fn _exit_scalar_event_tag(descriptor: text) ->i64:
    if descriptor=="v2;unit":return 11
    if descriptor=="v2;bool":return 12
    if descriptor=="v2;i8":return 13
    if descriptor=="v2;i16":return 14
    if descriptor=="v2;i32":return 15
    if descriptor=="v2;i64":return 16
    if descriptor=="v2;u8":return 17
    if descriptor=="v2;u16":return 18
    if descriptor=="v2;u32":return 19
    if descriptor=="v2;u64":return 20
    if descriptor=="v2;f32":return 21
    if descriptor=="v2;f64":return 22
    if descriptor=="v2;char":return 27
    -1

fn _exit_scalar_event_arg(descriptor: text) ->i64:
    if descriptor=="v2;unit":return 0
    if descriptor=="v2;bool" or descriptor=="v2;i8" or descriptor=="v2;u8":return 1
    if descriptor=="v2;i16" or descriptor=="v2;u16":return 2
    if descriptor=="v2;i32" or descriptor=="v2;u32" or descriptor=="v2;f32" or descriptor=="v2;char":return 4
    8

# Exact normalized comparison against the fixed Pure exit record.  Composite
# captures already retain the canonical transcript verbatim. Scalar and UTF-8
# captures deliberately retain direct bytes for zero-overhead producer paths;
# this sibling supplies their deterministic equivalent transcript shape while
# comparing, without allocating a second receipt or weakening byte equality.
fn _exit_stream_matches_pure(wire: RtHalExactWireHandle,events_offset: i64,
        event_count: i64,payload_offset: i64,payload_length: i64,exit_index: i64,
        domain: i64,wire_length: i64) ->bool:
    val type_id=_exit_domain_type(exit_index,domain)
    if not _exit_type_valid(type_id):return false
    val encoding=_exit_type_encoding[type_id-1]
    val descriptor=_exit_type_descriptor_text[type_id-1]
    var expected_events=_exit_domain_events(exit_index,domain)
    var expected_offset=if domain==2:_exit_output_events_offset[exit_index]
        elif domain==3:_exit_error_events_offset[exit_index] else:_exit_effect_events_offset[exit_index]
    var expected_length=if domain==2:_exit_output_length[exit_index]
        elif domain==3:_exit_error_length[exit_index] else:_exit_effect_length[exit_index]
    var expected_payload=if domain==2:_exit_output_offset[exit_index]
        elif domain==3:_exit_error_offset[exit_index] else:_exit_effect_offset[exit_index]
    var request_effect=false;var request_slot=-1
    if domain==4:
        request_slot=_exit_request_slot(_exit_request_for_exit[exit_index])
        if request_slot>=0 and _exit_request_effect_state[request_slot]==5:
            val input_used=_exit_request_events_length[request_slot]+_exit_request_payload_length[request_slot]
            val cap=_exit_request_capacity()
            if input_used<0 or cap<=0 or input_used>cap or
               _exit_request_effect_events_length[request_slot]>cap-input_used or
               _exit_request_effect_payload_length[request_slot]>cap-input_used-_exit_request_effect_events_length[request_slot]:
                return false
            expected_events=_exit_request_effect_events_length[request_slot]
            expected_length=_exit_request_effect_payload_length[request_slot]
            expected_offset=input_used
            expected_payload=input_used+expected_events
            request_effect=true
    if payload_length!=expected_length:return false
    # All canonical foreign streams have RootBegin/RootEnd. Parent replay
    # independently checks the admitted dense root; compare the portable
    # domain lane here, which is the part represented by the Pure record.
    if event_count<2 or _exit_wire_i64(wire,events_offset,wire_length)!=1 or
       _exit_wire_i64(wire,events_offset+8,wire_length)>>32!=domain+1 or
       _exit_wire_i64(wire,events_offset+(event_count-1)*16,wire_length)!=2:return false
    if expected_events>0:
        if event_count*16!=expected_events:return false
        var event=0
        while event<event_count:
            val expected_tag=if request_effect:
                _exit_wire_i64_from_request(request_slot,expected_offset+event*16)
            else: _exit_wire_i64_from_arena(expected_offset+event*16)
            val expected_arg=if request_effect:
                _exit_wire_i64_from_request(request_slot,expected_offset+event*16+8)
            else: _exit_wire_i64_from_arena(expected_offset+event*16+8)
            val actual_tag=_exit_wire_i64(wire,events_offset+event*16,wire_length)
            val actual_arg=_exit_wire_i64(wire,events_offset+event*16+8,wire_length)
            if actual_tag!=expected_tag:return false
            # RootBegin carries a registry-dense root ID in its low word.
            # The Pure capture and parent-reconstructed foreign stream use
            # different sealed tables, so compare the portable domain lane;
            # parent replay independently validates the dense root against
            # the admitted canonical descriptor.
            if event==0:
                if actual_arg>>32!=expected_arg>>32:return false
            elif actual_arg!=expected_arg:return false
            event=event+1
    elif descriptor=="v2;bytes" and expected_length==0:
        # Empty canonical bytes root: RootBegin/RootEnd only.  This is the
        # explicit no-observable-effect receipt, not a hidden unit rewrite.
        if event_count!=2:return false
    elif encoding==2:
        # RootBegin, BeginUtf8(length), EndUtf8, RootEnd.
        if event_count!=4 or _exit_wire_i64(wire,events_offset+16,wire_length)!=25 or
           _exit_wire_i64(wire,events_offset+24,wire_length)!=expected_length or
           _exit_wire_i64(wire,events_offset+32,wire_length)!=26:return false
    else:
        val tag=_exit_scalar_event_tag(descriptor)
        if tag<0 or event_count!=3 or _exit_wire_i64(wire,events_offset+16,wire_length)!=tag or
           _exit_wire_i64(wire,events_offset+24,wire_length)!=_exit_scalar_event_arg(descriptor):return false
    var byte=0
    while byte<expected_length:
        val expected=if request_effect:
            _exit_request_bytes[request_slot*_exit_request_capacity()+expected_payload+byte] as i64
        else: _exit_bytes[expected_payload+byte] as i64
        if rt_hal_exact_wire_byte_at(wire,payload_offset+byte) as i64!=expected:return false
        byte=byte+1
    true

# Pre-commit exact comparator sibling.  It consumes the joined wire exactly
# once, verifies the foreign stream against the fixed Pure capture, then runs
# the existing parent reconstruction and atomic three-snapshot commit.  A
# mismatch aborts before any batch publication and releases the wire lease.
pub fn rt_hal_exact_exit_process_join_compare_admit(task_handle: i64,
        deadline_ticks: i64,registry: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal,batch: RtHalExactIoParentBatch,
        ordinal_base: i64,max_retained_bytes: i64,exit_index: i64) ->bool:
    if task_handle<=0 or deadline_ticks<=0 or ordinal_base<0 or
       max_retained_bytes<=0 or exit_index<0 or exit_index>=_exit_count:
        batch.abort();return false
    val joined=rt_hal_process_join_io_until(task_handle,deadline_ticks)
    if not joined.completed:
        batch.abort()
        # `join_io_until` releases the arena slot when the host reports a
        # terminal reap, even when that terminal state is a failed child.
        # Never cancel that stale handle: it could only fail the generation
        # check and would obscure the original deterministic join failure.
        # Cancel/reap only an still-live task; the first failure remains JOIN
        # whether or not best-effort cleanup subsequently reports a problem.
        if not joined.reaped:
            rt_hal_process_cancel_io_task(task_handle)
        return _exit_controller_fail("RTHAL-E-EXIT-JOIN")
    # A completed result is not a host-lifecycle acknowledgement.  Consume no
    # result into the parent transaction until the controller has reaped and
    # closed the generation-bound child; otherwise the slot could remain
    # owned while a later dispatch attempts to reuse the finite arena.
    if not joined.reaped and not rt_hal_process_cancel_io_task(task_handle):
        rt_hal_exact_wire_release(joined.result)
        batch.abort()
        return _exit_controller_fail("RTHAL-E-EXIT-REAP")
    val parsed=rt_hal_exact_io_parent_readmit(registry,joined.result,max_retained_bytes)
    val length=rt_hal_exact_wire_view(joined.result).byte_length
    val outcome=if _exit_kind[exit_index]==1:0 elif _exit_kind[exit_index]==4:2 elif _exit_kind[exit_index]==5:3 else:1
    if not parsed.valid:
        rt_hal_exact_wire_release(joined.result);batch.abort();return _exit_controller_fail("RTHAL-E-EXIT-ADMISSION")
    if parsed.case_id!=_exit_case[exit_index] or parsed.schema_id!=_exit_schema[exit_index] or parsed.outcome!=outcome:
        rt_hal_exact_wire_release(joined.result);batch.abort();return _exit_controller_fail("RTHAL-E-EXIT-HEADER")
    if not _exit_stream_matches_pure(joined.result,parsed.output.events_offset,
            parsed.output.event_count,parsed.output.payload_offset,parsed.output.payload_length,
            exit_index,2,length):
        rt_hal_exact_wire_release(joined.result);batch.abort();return _exit_controller_fail("RTHAL-E-EXIT-OUTPUT")
    if not _exit_stream_matches_pure(joined.result,parsed.error.events_offset,
            parsed.error.event_count,parsed.error.payload_offset,parsed.error.payload_length,
            exit_index,3,length):
        rt_hal_exact_wire_release(joined.result);batch.abort();return _exit_controller_fail("RTHAL-E-EXIT-ERROR")
    if not _exit_stream_matches_pure(joined.result,parsed.effect.events_offset,
            parsed.effect.event_count,parsed.effect.payload_offset,parsed.effect.payload_length,
            exit_index,4,length):
        rt_hal_exact_wire_release(joined.result);batch.abort();return _exit_controller_fail("RTHAL-E-EXIT-EFFECT")
    val output=rt_hal_exact_io_parent_reconstruct(registry,seal,parsed,RtHalCodecRootDomain.Output)
    val error=rt_hal_exact_io_parent_reconstruct(registry,seal,parsed,RtHalCodecRootDomain.Error)
    val effect=rt_hal_exact_io_parent_reconstruct(registry,seal,parsed,RtHalCodecRootDomain.Effect)
    val committed=rt_hal_exact_io_parent_commit_three(registry,seal,batch,output,error,effect,ordinal_base)
    val released=rt_hal_exact_wire_release(joined.result)
    committed and released

# One complete typed-exit controller transaction.  It intentionally performs
# no fallback to an ordinary/pointer-based comparison path on any failure.
pub fn rt_hal_exact_exit_process_dispatch_one(adapter_handle: i64,
        provider_ordinal: i64,request_source: RtHalExactIoArena,
        request_index: i64,exit_index: i64,bounds: RtHalExactIoBounds,replay: bool,
        deadline_ticks: i64,registry: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal,batch: RtHalExactIoParentBatch,
        ordinal_base: i64,max_retained_bytes: i64) ->bool:
    val task=rt_hal_exact_exit_process_encode_submit(adapter_handle,
        provider_ordinal,request_source,request_index,exit_index,bounds,replay)
    if task<=0:
        batch.abort();return false
    rt_hal_exact_exit_process_join_compare_admit(task,deadline_ticks,registry,seal,batch,
        ordinal_base,max_retained_bytes,exit_index)

# Backend spellings deliberately stay scalar and forward to the owner ABI.
# They make lowering target selection explicit while preserving one behavior.
pub fn rt_hal_exact_exit_backend_begin(case_id: i64,schema_id: i64,kind_code: i64) ->i64:
    val epoch=_exit_controller_queue_pin_open()
    if epoch<=0:return -1
    if not _exit_capture_gate.compare_exchange(0,1,MemoryOrdering.AcqRel,
            MemoryOrdering.Acquire):
        _exit_controller_queue_unpin();return -1
    val output_type_id=rt_hal_exact_exit_schema_resolve(schema_id,2)
    val error_type_id=rt_hal_exact_exit_schema_resolve(schema_id,3)
    val effect_type_id=rt_hal_exact_exit_schema_resolve(schema_id,4)
    val token=_exit_begin_pinned(epoch,case_id,schema_id,kind_code,
        output_type_id,error_type_id,effect_type_id)
    if token<=0:
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin()
    token

# Compiler/runtime termination funnels normally have no stable user case ID.
# This owner-local sequence supplies one without allocating or deriving an
# index from a type hash.  IDs are never rolled back after `abort`, preventing
# replay ambiguity within one installed arena generation.
pub fn rt_hal_exact_exit_backend_begin_next_with_request(schema_id: i64,kind_code: i64,
        operation_id: text,request_token: i64) ->i64:
    # This is the compiler's terminal ingress, so pin/gate precede even schema
    # resolution and case allocation.  The gate also makes the legacy raw
    # writer fields a serialized implementation detail rather than a
    # cross-thread admission mechanism.
    val epoch=_exit_controller_queue_pin_open()
    if epoch<=0:
        rt_hal_exact_request_abort(request_token);return -1
    if not _exit_capture_gate.compare_exchange(0,1,MemoryOrdering.AcqRel,
            MemoryOrdering.Acquire):
        _exit_controller_queue_unpin();rt_hal_exact_request_abort(request_token);return -1
    if epoch!=_exit_controller_queue_epoch.load(MemoryOrdering.Acquire) or
       not _exit_installed or not _exit_sealed or _exit_writer!=0 or
       _exit_count>=_exit_max_exits or _exit_next_case_id<=0 or
       operation_id=="" or operation_id.len()>4096:
        rt_hal_exact_request_abort(request_token)
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin();return -1
    val request_slot=_exit_request_slot(request_token)
    if request_slot<0 or not _exit_request_pinned_ready(request_slot) or
       _exit_request_state[request_slot]!=5 or
       _exit_request_operation[request_slot]!=operation_id:
        if request_slot>=0:rt_hal_exact_request_abort(request_token)
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin();return -1
    val output_type_id=rt_hal_exact_exit_schema_resolve(schema_id,2)
    val error_type_id=rt_hal_exact_exit_schema_resolve(schema_id,3)
    val effect_type_id=rt_hal_exact_exit_schema_resolve(schema_id,4)
    if output_type_id<=0 or error_type_id<=0 or effect_type_id<=0:
        rt_hal_exact_request_abort(request_token)
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin();return -1
    # A declared effect plan is admitted only when its exact canonical type is
    # the schema's sealed effect root.  Empty plans require the unit root.
    # This prevents a caller from attaching a different effect transcript to
    # an otherwise matching operation/input request.
    val expected_effect=_exit_type_descriptor_text[effect_type_id-1]
    val actual_effect=if _exit_request_effect_state[request_slot]==5:
        _exit_request_effect_descriptor[request_slot] else: "v2;unit"
    # The installed bytes root is the canonical optional effect-plan carrier:
    # an empty plan is a query, while a present plan must match it exactly.
    # Unit schemas remain accepted only for legacy pure-only rows.
    if actual_effect!=expected_effect and not (_exit_request_effect_state[request_slot]!=5 and expected_effect=="v2;bytes"):
        rt_hal_exact_request_abort(request_token)
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin();return -1
    val case_id=_exit_next_case_id
    val token=_exit_begin_pinned(epoch,case_id,schema_id,kind_code,
        output_type_id,error_type_id,effect_type_id)
    if token<=0:
        rt_hal_exact_request_abort(request_token)
        _exit_capture_gate.store(0,MemoryOrdering.Release)
        _exit_controller_queue_unpin();return -1
    _exit_operation_id[_exit_count-1]=operation_id
    _exit_request_for_exit[_exit_count-1]=request_token
    if _exit_next_case_id==0x7fffffffffffffff:_exit_next_case_id=-1
    else:_exit_next_case_id=_exit_next_case_id+1
    token

# Legacy three-argument compiler output is deliberately retained as a
# fail-closed compatibility surface while staged lowering migrates to the
# pre-Pure request token ABI.  It cannot manufacture a foreign request from
# a terminal record: controller framing rejects its zero request link.
pub fn rt_hal_exact_exit_backend_begin_next(schema_id: i64,kind_code: i64,
        operation_id: text) ->i64:
    rt_hal_exact_exit_backend_begin_next_with_request(schema_id,kind_code,operation_id,0)
# Explicit dense-ID entry remains for runtime-only callers that already own a
# resolved schema table row; compiler lowering must target backend_begin above.
pub fn rt_hal_exact_exit_backend_begin_resolved(case_id: i64,schema_id: i64,kind_code: i64,
        output_type_id: i64,error_type_id: i64,effect_type_id: i64) ->i64:
    if rt_hal_exact_exit_schema_resolve(schema_id,2)!=output_type_id or
       rt_hal_exact_exit_schema_resolve(schema_id,3)!=error_type_id or
       rt_hal_exact_exit_schema_resolve(schema_id,4)!=effect_type_id:return -1
    rt_hal_exact_exit_begin(case_id,schema_id,kind_code,output_type_id,error_type_id,effect_type_id)
pub fn rt_hal_exact_exit_backend_write_event(token: i64,tag: i64,arg: i64) ->bool:
    rt_hal_exact_exit_event_append(token,tag,arg)
pub fn rt_hal_exact_exit_backend_write_byte(token: i64,value: i64) ->bool:
    rt_hal_exact_exit_payload_byte(token,value)
pub fn rt_hal_exact_exit_backend_finish(token: i64) ->bool:
    if token<=0 or token!=_exit_writer or _exit_writing_domain>=0:return false
    # Publish while retaining the serialized terminal funnel.  The queue only
    # receives a scalar index, but this ordering prevents a controller close
    # from seeing a finished record between writer release and producer pin.
    # On backpressure the token is released for the caller's hard failure; the
    # queue failure bit makes any later controller transaction fail closed.
    val epoch=_exit_capture_epoch
    val published=_exit_controller_enqueue_after_capture(_exit_count-1,token,epoch)
    val request_slot=_exit_request_slot(_exit_request_for_exit[_exit_count-1])
    if request_slot>=0:_exit_request_unpin(request_slot)
    _exit_writer=0;_exit_capture_epoch=0;_exit_capture_gate.store(0,MemoryOrdering.Release);_exit_controller_queue_unpin()
    published

# Backend writers have no domain argument.  A return owns Output; every other
# terminal form (Error/Throw/Resume/Abort) owns Error.  Effect bytes remain an
# explicit controller/instrumentation operation and are never guessed here.
fn _exit_backend_domain(token: i64) ->i64:
    if token<=0 or token!=_exit_writer or _exit_count<=0:return -1
    if _exit_kind[_exit_count-1]==1:return 2
    3
fn _exit_backend_type(token: i64) ->i64:
    val domain=_exit_backend_domain(token)
    if domain<0:return -1
    _exit_domain_type(_exit_count-1,domain)

# Writes an already-typed scalar's canonical little-endian bits.  `value_bits`
# is accepted only for scalar encodings; it is never interpreted as an address
# or tagged heap value.  A malformed width/encoding aborts the active record.
pub fn rt_hal_exact_exit_backend_write_scalar(token: i64,value_bits: i64,
        encoding_code: i64,width: i64) ->bool:
    val type_id=_exit_backend_type(token)
    if type_id<=0 or width<0 or width>8 or encoding_code<0 or encoding_code>5 or
       _exit_type_encoding[type_id-1]!=encoding_code:
        rt_hal_exact_exit_abort(token);return false
    val domain=_exit_backend_domain(token)
    if not rt_hal_exact_exit_payload_begin(token,domain,width):
        rt_hal_exact_exit_abort(token);return false
    val bits=value_bits as u64;var lane=0
    while lane<width:
        if not rt_hal_exact_exit_payload_byte(token,((bits>>(lane*8))&255u64) as i64):
            rt_hal_exact_exit_abort(token);return false
        lane=lane+1
    if not rt_hal_exact_exit_payload_end(token,domain):
        rt_hal_exact_exit_abort(token);return false
    true

# Typed text boundary: Simple text supplies valid UTF-8 bytes through its
# ordinary byte API.  No text handle/pointer is transported or retained.
pub fn rt_hal_exact_exit_backend_write_utf8(token: i64,value: text) ->bool:
    val type_id=_exit_backend_type(token)
    if type_id<=0 or _exit_type_encoding[type_id-1]!=2:
        rt_hal_exact_exit_abort(token);return false
    val domain=_exit_backend_domain(token);val length=value.len()
    if not rt_hal_exact_exit_payload_begin(token,domain,length):
        rt_hal_exact_exit_abort(token);return false
    var index=0
    while index<length:
        if not rt_hal_exact_exit_payload_byte(token,value.byte_at(index)):
            rt_hal_exact_exit_abort(token);return false
        index=index+1
    if not rt_hal_exact_exit_payload_end(token,domain):
        rt_hal_exact_exit_abort(token);return false
    true

# Canonical composite-leaf ABI.  A composite root always carries encoding 6;
# its event transcript establishes the selected tuple/array/result branch and
# closes with RootEnd before this writer accepts bytes.  The caller must name
# the primitive leaf descriptor explicitly.  We validate that descriptor
# structurally against the cold-admitted root, rather than accepting a raw ABI
# value, a substring match, or a pointer-sized surrogate.
fn _exit_codec_leaf_begin(token: i64,role: i64,leaf_descriptor: text,
        encoding: i64,width: i64) ->i64:
    if not _exit_leaf_terminal_ready(token,role,leaf_descriptor,encoding,width):return -1
    val domain=_exit_backend_domain(token)
    if _exit_leaf_domain>=0 and _exit_leaf_domain!=domain:return -1
    val index=_exit_count-1
    if _exit_leaf_domain<0:
        _exit_leaf_domain=domain
        if domain==2:_exit_output_offset[index]=_exit_payload_used
        else:_exit_error_offset[index]=_exit_payload_used
    if width<0 or width>_exit_max_bytes-_exit_payload_used:return -1
    _exit_leaf_count=_exit_leaf_count+1
    domain

fn _exit_codec_leaf_append_byte(token: i64,domain: i64,value: i64) ->bool:
    if token<=0 or token!=_exit_writer or domain!=_exit_leaf_domain or value<0 or value>255:return false
    val index=_exit_count-1
    _exit_bytes[_exit_payload_used]=value as u8;_exit_payload_used=_exit_payload_used+1
    if domain==2:_exit_output_length[index]=_exit_output_length[index]+1
    else:_exit_error_length[index]=_exit_error_length[index]+1
    true

pub fn rt_hal_exact_exit_backend_write_codec_scalar(token: i64,role: i64,
        leaf_descriptor: text,encoding: i64,width: i64,value_bits: i64) ->bool:
    val domain=_exit_codec_leaf_begin(token,role,leaf_descriptor,encoding,width)
    if domain<0:
        rt_hal_exact_exit_abort(token);return false
    val bits=value_bits as u64;var lane=0
    while lane<width:
        if not _exit_codec_leaf_append_byte(token,domain,((bits>>(lane*8))&255u64) as i64):
            rt_hal_exact_exit_abort(token);return false
        lane=lane+1
    true

pub fn rt_hal_exact_exit_backend_write_codec_utf8(token: i64,role: i64,
        leaf_descriptor: text,encoding: i64,width: i64,value: text) ->bool:
    if width!=value.len():
        rt_hal_exact_exit_abort(token);return false
    val domain=_exit_codec_leaf_begin(token,role,leaf_descriptor,encoding,width)
    if domain<0:
        rt_hal_exact_exit_abort(token);return false
    var index=0
    while index<width:
        if not _exit_codec_leaf_append_byte(token,domain,value.byte_at(index)):
            rt_hal_exact_exit_abort(token);return false
        index=index+1
    true

# Composite lowering uses canonical field projections: start a transcript,
# append its declared events, then write the canonical payload bytes through
# the existing scalar byte writer.  Dedicated tuple/array/result helpers would
# need a dynamic heap visitor and are intentionally not exposed.
pub fn rt_hal_exact_exit_backend_events_begin(token: i64,event_count: i64) ->bool:
    val domain=_exit_backend_domain(token)
    if domain<0:
        rt_hal_exact_exit_abort(token);return false
    if not rt_hal_exact_exit_event_begin(token,domain,event_count):
        rt_hal_exact_exit_abort(token);return false
    true
pub fn rt_hal_exact_exit_backend_events_end(token: i64) ->bool:
    val domain=_exit_backend_domain(token)
    # Compiler composite lowering reserves the statically bounded maximum
    # transcript, then selects one Result arm at runtime.  No payload has
    # started while this reservation is live, so unused tail cells can be
    # reclaimed in place before exposing the exact event span.  This avoids a
    # heap/vector transcript and keeps event bytes strictly before payload.
    if domain<0 or not _exit_writing_events or _exit_writing_domain!=domain:
        rt_hal_exact_exit_abort(token);return false
    if _exit_writing_remaining>0:
        val unused=_exit_writing_remaining
        val index=_exit_count-1
        if unused<0 or _exit_payload_used<unused:
            rt_hal_exact_exit_abort(token);return false
        _exit_payload_used=_exit_payload_used-unused
        if domain==2:_exit_output_events_length[index]=_exit_output_events_length[index]-unused
        elif domain==3:_exit_error_events_length[index]=_exit_error_events_length[index]-unused
        else:_exit_effect_events_length[index]=_exit_effect_events_length[index]-unused
        _exit_writing_remaining=0
    if not rt_hal_exact_exit_payload_end(token,domain):
        rt_hal_exact_exit_abort(token);return false
    true

# Ordinary typed bridge used only by MIR's transcript prepass. It transports
# a length, never a text pointer or retained host object.
pub fn rt_hal_exact_exit_typed_text_length(value: text) ->i64:
    value.len()

