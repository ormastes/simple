# codex-impl
# Canonical typed projection bridges for the RT/HAL exact-exit compiler pass.
#
# These functions deliberately express Result by its language constructors,
# rather than inspecting the runtime enum representation.  In particular the
# compiler must not substitute a tag ordinal, enum hash, payload word, or host
# address for either operation.  The generated call is only legal when its
# preceding CFG edge proves the selected arm; the defensive panic makes a
# malformed transform fail closed instead of serializing the wrong payload.

pub fn rt_hal_exact_exit_typed_result_is_ok<T, E>(value: Result<T, E>) -> bool:
    match value:
        Ok(_): true
        Err(_): false

pub fn rt_hal_exact_exit_typed_result_ok_payload<T, E>(value: Result<T, E>) -> T:
    match value:
        Ok(payload): payload
        Err(_): panic("RTHAL-E-TYPED-RESULT-OK-PAYLOAD")

pub fn rt_hal_exact_exit_typed_result_err_payload<T, E>(value: Result<T, E>) -> E:
    match value:
        Ok(_): panic("RTHAL-E-TYPED-RESULT-ERR-PAYLOAD")
        Err(payload): payload

# Array projection is likewise typed.  The compiler supplies a statically
# bounded `[T; N]`-equivalent MIR type and proves `0 <= index < N` in its CFG;
# these helpers retain normal language bounds semantics as the final guard.
# They never expose an element pointer or container header to the exit codec.
pub fn rt_hal_exact_exit_typed_array_length<T>(value: [T]) -> i64:
    value.len()

pub fn rt_hal_exact_exit_typed_array_at<T>(value: [T], index: i64) -> T:
    value[index]

export rt_hal_exact_exit_typed_result_is_ok
export rt_hal_exact_exit_typed_result_ok_payload
export rt_hal_exact_exit_typed_result_err_payload
export rt_hal_exact_exit_typed_array_length
export rt_hal_exact_exit_typed_array_at
