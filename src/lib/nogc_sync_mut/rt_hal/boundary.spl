# codex-impl
# RT-safe observed-Pure handoff. Tagged returns only write scalar fields into a
# preallocated owner ring. Hashing and comparison belong to the cold drain.
use std.common.rt_hal.model.*
use std.common.hash.djb2.{djb2_hash_text}
use std.nogc_sync_mut.rt_hal.parallel_executor.{RtHalProviderRegistry}
use std.nogc_sync_mut.rt_hal.exact_boundary.{RtHalDigest256, RtHalExactRequest, RtHalCanonicalReceipt, RtHalExactArenaPort, rt_hal_compare_observed_pure_exact}
use std.nogc_sync_mut.runtime.thread_local.{rt_thread_local_new, rt_thread_local_get, rt_thread_local_set}
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_lock, mutex_unlock}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
use std.nogc_sync_mut.concurrent.thread.{thread_yield}

extern fn rt_current_task_id() -> i64
extern fn spl_thread_current_id() -> i64
const RT_HAL_OWNER_SLOTS = 16
const RT_HAL_OWNER_RECEIPTS = 64
const RT_HAL_RECEIPTS = 1024

var initialized = false
var owner_ids: [i64] = []
var heads: [i64] = []
var tails: [i64] = []
var statuses: [i64] = []
var trace0: [i64] = []
var trace1: [i64] = []
var trace2: [i64] = []
var trace3: [i64] = []
var has_trace: [bool] = []
var operations: [text] = []
var flags: [i64] = []
var values: [i64] = []
var rtrace0: [i64] = []
var rtrace1: [i64] = []
var rtrace2: [i64] = []
var rtrace3: [i64] = []
var rhas_trace: [bool] = []
var registry: RtHalProviderRegistry? = nil
var arena: RtHalExactArenaPort? = nil
var owner_tls = rt_thread_local_new()
var owner_install_lock: Mutex = mutex_new(0)
var global_failure: AtomicI64 = atomic_i64_new(0)
var close_epoch: AtomicI64 = atomic_i64_new(0)
var active_pins: [AtomicI64] = []
var active_workers: AtomicI64 = atomic_i64_new(0)

fn current_owner() -> i64:
    val task = rt_current_task_id()
    if task > 0: return task
    val thread = spl_thread_current_id()
    if thread > 0: return thread
    1

pub fn rt_hal_boundary_current_owner_id() -> i64: current_owner()

fn owner_slot(owner_id: i64) -> i64:
    val positive = if owner_id < 0: -owner_id else: owner_id
    positive % RT_HAL_OWNER_SLOTS

# Cold controller initialization; all allocation happens here.
pub fn rt_hal_boundary_reset():
    owner_ids = []
    heads = []
    tails = []
    statuses = []
    trace0 = []
    trace1 = []
    trace2 = []
    trace3 = []
    has_trace = []
    active_pins = []
    var owner = 0
    while owner < RT_HAL_OWNER_SLOTS:
        owner_ids.push(0)
        heads.push(0)
        tails.push(0)
        statuses.push(0)
        trace0.push(0)
        trace1.push(0)
        trace2.push(0)
        trace3.push(0)
        has_trace.push(false)
        active_pins.push(atomic_i64_new(0))
        owner = owner + 1
    operations = []
    flags = []
    values = []
    rtrace0 = []
    rtrace1 = []
    rtrace2 = []
    rtrace3 = []
    rhas_trace = []
    var i = 0
    while i < RT_HAL_RECEIPTS:
        operations.push("")
        flags.push(0)
        values.push(0)
        rtrace0.push(0)
        rtrace1.push(0)
        rtrace2.push(0)
        rtrace3.push(0)
        rhas_trace.push(false)
        i = i + 1
    registry = nil
    arena = nil
    global_failure.store(0, MemoryOrdering.Release)
    close_epoch.store(0, MemoryOrdering.Release)
    active_workers.store(0, MemoryOrdering.Release)
    rt_thread_local_set(owner_tls, 0)
    initialized = true

# Cold quiescent registration. Collisions fail closed; owners never share slots.
pub fn rt_hal_boundary_register_owner(owner_id: i64) -> text:
    if not initialized: return "RTHAL-E-NOT-INITIALIZED"
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        global_failure.store(1, MemoryOrdering.Release)
        return "RTHAL-E-CLOSED"
    if owner_id <= 0: return "RTHAL-E-OWNER"
    val slot = owner_slot(owner_id)
    if owner_ids[slot] != 0 and owner_ids[slot] != owner_id: return "RTHAL-E-OWNER-CAPACITY"
    owner_ids[slot] = owner_id
    rt_thread_local_set(owner_tls, slot + 1)
    ""

# Cold compiler-generated task/thread entry hook. Registration is serialized;
# the RT return path subsequently reads only its TLS slot.
pub fn rt_hal_boundary_worker_spawn_hook() -> bool:
    if not initialized: return false
    # Pin before observing the epoch. A concurrent close either observes this
    # active worker, or this acquire-recheck observes the close; there is no
    # gap in which user execution can begin unaccounted.
    active_workers.fetch_add(1, MemoryOrdering.AcqRel)
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        active_workers.fetch_sub(1, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)
        return false
    val encoded = rt_thread_local_get(owner_tls)
    if encoded > 0: return true
    val held = mutex_lock(owner_install_lock)
    if held == nil:
        active_workers.fetch_sub(1, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)
        return false
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        mutex_unlock(owner_install_lock, 0)
        active_workers.fetch_sub(1, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)
        return false
    val problem = rt_hal_boundary_register_owner(current_owner())
    mutex_unlock(owner_install_lock, 0)
    if problem != "":
        active_workers.fetch_sub(1, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)
        return false
    true

pub fn rt_hal_boundary_worker_complete_hook():
    val prior = active_workers.fetch_sub(1, MemoryOrdering.AcqRel)
    if prior <= 0:
        active_workers.store(0, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)

pub fn rt_hal_boundary_install_exact(next_registry: RtHalProviderRegistry, next_arena: RtHalExactArenaPort) -> text:
    if not initialized: rt_hal_boundary_reset()
    val owner_error = rt_hal_boundary_register_owner(current_owner())
    if owner_error != "": return owner_error
    registry = Some(next_registry)
    arena = Some(next_arena)
    ""

pub fn rt_hal_boundary_observe_effect4(word0: i64, word1: i64, word2: i64, word3: i64) -> text:
    if not initialized: return "RTHAL-E-NOT-INITIALIZED"
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        global_failure.store(1, MemoryOrdering.Release)
        return "RTHAL-E-CLOSED"
    val encoded = rt_thread_local_get(owner_tls)
    if encoded <= 0:
        global_failure.store(1, MemoryOrdering.Release)
        return "RTHAL-E-OWNER"
    val slot = encoded - 1
    active_pins[slot].fetch_add(1, MemoryOrdering.AcqRel)
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        active_pins[slot].fetch_sub(1, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)
        return "RTHAL-E-CLOSED"
    trace0[slot] = word0
    trace1[slot] = word1
    trace2[slot] = word2
    trace3[slot] = word3
    has_trace[slot] = true
    active_pins[slot].fetch_sub(1, MemoryOrdering.Release)
    ""

pub fn rt_hal_boundary_observe_effect(effect_trace_word: i64) -> text:
    rt_hal_boundary_observe_effect4(effect_trace_word, 0, 0, 0)

# RT intrinsic ABI: O(1), bounded, allocation-free scalar/reference assignments.
pub fn rt_hal_boundary_dispatch(operation_id: text, compare_c: bool, compare_rust: bool, pure_receipt: i64) -> i64:
    if not compare_c and not compare_rust: return 0
    if not initialized: return 1
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        global_failure.store(1, MemoryOrdering.Release)
        return 1
    val encoded = rt_thread_local_get(owner_tls)
    if encoded <= 0:
        global_failure.store(1, MemoryOrdering.Release)
        return 1
    val owner = encoded - 1
    active_pins[owner].fetch_add(1, MemoryOrdering.AcqRel)
    if close_epoch.load(MemoryOrdering.Acquire) != 0:
        active_pins[owner].fetch_sub(1, MemoryOrdering.Release)
        global_failure.store(1, MemoryOrdering.Release)
        return 1
    val head = heads[owner]
    val tail = tails[owner]
    if head - tail >= RT_HAL_OWNER_RECEIPTS:
        statuses[owner] = 2
        global_failure.store(1, MemoryOrdering.Release)
        active_pins[owner].fetch_sub(1, MemoryOrdering.Release)
        return 1
    val index = owner * RT_HAL_OWNER_RECEIPTS + head % RT_HAL_OWNER_RECEIPTS
    operations[index] = operation_id
    flags[index] = (if compare_c: 1 else: 0) | (if compare_rust: 2 else: 0)
    values[index] = pure_receipt
    rtrace0[index] = trace0[owner]
    rtrace1[index] = trace1[owner]
    rtrace2[index] = trace2[owner]
    rtrace3[index] = trace3[owner]
    rhas_trace[index] = has_trace[owner]
    has_trace[owner] = false
    heads[owner] = head + 1
    active_pins[owner].fetch_sub(1, MemoryOrdering.Release)
    0

fn operation_digest(operation_id: text) -> RtHalDigest256:
    RtHalDigest256(word0: djb2_hash_text("0|" + operation_id), word1: djb2_hash_text("1|" + operation_id), word2: djb2_hash_text("2|" + operation_id), word3: djb2_hash_text("3|" + operation_id))

# Cold controller phase. Run only after the RT producers are quiescent.
pub fn rt_hal_boundary_drain_owner(owner_id: i64) -> text:
    if not initialized: return "RTHAL-E-NOT-INITIALIZED"
    val owner = owner_slot(owner_id)
    if owner_ids[owner] != owner_id: return "RTHAL-E-OWNER"
    if statuses[owner] != 0: return "RTHAL-E-QUEUE-CAPACITY"
    if registry == nil or arena == nil: return "RTHAL-W-PARALLEL-UNSUPPORTED"
    while tails[owner] < heads[owner]:
        val tail = tails[owner]
        val index = owner * RT_HAL_OWNER_RECEIPTS + tail % RT_HAL_OWNER_RECEIPTS
        val compare_c = (flags[index] & 1) != 0
        val compare_rust = (flags[index] & 2) != 0
        val traced = rhas_trace[index]
        val trace = RtHalDigest256(word0: rtrace0[index], word1: rtrace1[index], word2: rtrace2[index], word3: rtrace3[index])
        val request = RtHalExactRequest(case_id: tail, operation: if traced: RtHalOperationKind.Effectful else: RtHalOperationKind.Query, operation_digest: operation_digest(operations[index]), input_digest: RtHalDigest256(word0: 0x756e6974, word1: 0, word2: 0, word3: 0))
        val observed = RtHalCanonicalReceipt(case_id: tail, outcome_digest: RtHalDigest256(word0: values[index], word1: 0, word2: 0, word3: 0x693634), error_digest: RtHalDigest256(word0: 0, word1: 0, word2: 0, word3: 0), trace_digest: trace, observed_once: true)
        val count = 1 + (if compare_c: 1 else: 0) + (if compare_rust: 1 else: 0)
        val policy = rt_hal_default_comparison(compare_c, compare_rust, count, count, 64, 1048576, true)
        val report = rt_hal_compare_observed_pure_exact(policy, [request], [observed], registry.unwrap(), arena.unwrap())
        tails[owner] = tail + 1
        if report.error != "":
            statuses[owner] = 3
            global_failure.store(1, MemoryOrdering.Release)
            return report.error
    ""

pub fn rt_hal_boundary_status(owner_id: i64) -> i64:
    if not initialized: return 1
    val owner = owner_slot(owner_id)
    if owner_ids[owner] != owner_id: return 1
    statuses[owner]

# Cold controller snapshot, deterministically sorted without touching hot TLS.
pub fn rt_hal_boundary_registered_owner_ids() -> [i64]:
    # Release-close admission, then wait a bounded interval for every enqueue
    # that pinned before the close to publish its head and leave the slot.
    close_epoch.store(1, MemoryOrdering.Release)
    var spins = 0
    var quiescent = false
    while spins < 65536 and not quiescent:
        quiescent = true
        if active_workers.load(MemoryOrdering.Acquire) != 0: quiescent = false
        for pin in active_pins:
            if pin.load(MemoryOrdering.Acquire) != 0: quiescent = false
        if not quiescent: thread_yield()
        spins = spins + 1
    if not quiescent: global_failure.store(1, MemoryOrdering.Release)
    var result: [i64] = []
    for owner_id in owner_ids:
        if owner_id > 0: result.push(owner_id)
    var i = 1
    while i < result.len():
        val value = result[i]
        var j = i
        while j > 0 and result[j - 1] > value:
            result[j] = result[j - 1]
            j = j - 1
        result[j] = value
        i = i + 1
    result

pub fn rt_hal_boundary_global_failure_status() -> i64:
    if not initialized: return 1
    var result = global_failure.load(MemoryOrdering.Acquire)
    var slot = 0
    while slot < owner_ids.len():
        if owner_ids[slot] > 0 and statuses[slot] > result:
            result = statuses[slot]
        slot = slot + 1
    result

pub fn rt_hal_boundary_error(operation_id: text) -> text:
    if rt_hal_boundary_status(current_owner()) == 0: "" else: "RTHAL-E-RUN-FAILED"

export rt_hal_boundary_reset, rt_hal_boundary_register_owner
export rt_hal_boundary_current_owner_id
export rt_hal_boundary_worker_spawn_hook, rt_hal_boundary_registered_owner_ids
export rt_hal_boundary_worker_complete_hook
export rt_hal_boundary_global_failure_status
export rt_hal_boundary_install_exact
export rt_hal_boundary_observe_effect, rt_hal_boundary_observe_effect4
export rt_hal_boundary_dispatch, rt_hal_boundary_drain_owner
export rt_hal_boundary_status, rt_hal_boundary_error
