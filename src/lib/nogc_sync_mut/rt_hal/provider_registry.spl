# codex-impl
# Process-owned comparator registry. Pure Simple is never registered here:
# it is supplied explicitly at each boundary and remains provider ordinal zero.

use std.nogc_sync_mut.rt_hal.parallel_executor.{RtHalComparatorTaskAdapter}

var rt_hal_comparator_adapters: [RtHalComparatorTaskAdapter] = []

pub fn rt_hal_provider_registry_reset():
    rt_hal_comparator_adapters = []

pub fn rt_hal_register_comparator(adapter: RtHalComparatorTaskAdapter) -> text:
    if adapter.provider_id != "c-comparator" and adapter.provider_id != "rust-comparator":
        return "RTHAL-W-UNSUPPORTED"
    for registered in rt_hal_comparator_adapters:
        if registered.provider_id == adapter.provider_id:
            return "RTHAL-E-PROVIDER-DUPLICATE"
    rt_hal_comparator_adapters.push(adapter)
    ""

pub fn rt_hal_registered_comparators() -> [RtHalComparatorTaskAdapter]:
    rt_hal_comparator_adapters

pub fn rt_hal_comparator_registered(provider_id: text) -> bool:
    for adapter in rt_hal_comparator_adapters:
        if adapter.provider_id == provider_id:
            return true
    false

export rt_hal_provider_registry_reset, rt_hal_register_comparator
export rt_hal_registered_comparators, rt_hal_comparator_registered
