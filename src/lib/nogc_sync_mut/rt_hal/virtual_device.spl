# virtual_device.spl — VirtualDevice façade + effect log for dual-run
# device-effect modes (design doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md
# §B.5: record-compare / replay).
#
# A device-effect op (MMIO / port / CSR programming) cannot be doubly applied
# to hardware, so under dual run BOTH providers run against this façade: every
# access is recorded as an ordered EffectRecord and reads are answered from a
# per-op read script (captured from the reference run, or supplied by the
# spec). The runner compares the two logs and replays the AGREED log to real
# hardware exactly once (dual_apply_effects_mmio) — or never, in replay mode,
# where the reference already ran for real.
#
# Explicit-façade decision: the hot-path leaves in
# src/lib/nogc_async_mut_noalloc/baremetal/mmio.spl keep their "no lookup, no
# dispatch" contract. An op that wants to be dual-runnable takes a
# VirtualDevice parameter instead of calling mmio_write_* directly.
#
# Value semantics: VirtualDevice is a class (reference) so a candidate mutates
# the ONE owner in place (`self.records.push`) — never `dev = f(dev)` per write.


pub struct EffectRecord:
    order: i64
    kind: text     # "r" (read) | "w" (write)
    addr: u64
    width: i64     # 8 | 16 | 32
    value: i64

pub struct EffectCompare:
    agree: bool
    ref_len: i64
    cand_len: i64
    first_diff_index: i64
    ref_repr: text
    cand_repr: text

@unsafe(reason: "volatile raw-address write through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_write_u32(addr: u64, value: u32)
@unsafe(reason: "volatile raw-address write through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_write_u16(addr: u64, value: u16)
@unsafe(reason: "volatile raw-address write through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_write_u8(addr: u64, value: u8)

pub fn effect_record(order: i64, kind: text, addr: u64, width: i64, value: i64) -> EffectRecord:
    EffectRecord(order: order, kind: kind, addr: addr, width: width, value: value)

fn _hex(v: i64) -> text:
    if v < 0:
        return "-0x{(0 - v).to_hex()}"
    "0x{v.to_hex()}"

pub fn effect_record_repr(r: EffectRecord) -> text:
    "{r.kind}{r.width}@{_hex(r.addr as i64)}={_hex(r.value)}"

pub fn effect_log_repr(log: [EffectRecord]) -> text:
    var out = ""
    var i = 0
    while i < log.len():
        if i > 0:
            out = out + " "
        out = out + effect_record_repr(log[i])
        i = i + 1
    out

# Recorded-trace text format (one record per line, `#` comments allowed):
#   r8 0x10000005 0x20
#   w8 0x10000000 0x41
pub fn effect_log_from_trace_text(trace: text) -> [EffectRecord]:
    var out: [EffectRecord] = []
    for raw_line in trace.split("\n"):
        val line = raw_line.trim()
        if line == "" or line.starts_with("#"):
            continue
        val parts = line.split(" ")
        if parts.len() < 3:
            continue
        val head = parts[0]
        val kind = head.substring(0, 1)
        if kind != "r" and kind != "w":
            continue
        val width = _parse_num(head.substring(1, head.len()))
        val addr = _parse_num(parts[1])
        val value = _parse_num(parts[2])
        out.push(EffectRecord(order: out.len(), kind: kind, addr: addr as u64, width: width, value: value))
    out

fn _parse_num(s: text) -> i64:
    if s.starts_with("0x") or s.starts_with("0X"):
        var acc: i64 = 0
        var i = 2
        while i < s.len():
            val c = s.substring(i, i + 1)
            val d = "0123456789abcdef".index_of(c.lower())
            if d < 0:
                return acc
            acc = acc * 16 + d
            i = i + 1
        return acc
    _parse_dec(s)

fn _parse_dec(s: text) -> i64:
    var acc: i64 = 0
    var i = 0
    var neg = false
    if s.starts_with("-"):
        neg = true
        i = 1
    while i < s.len():
        val d = "0123456789".index_of(s.substring(i, i + 1))
        if d < 0:
            break
        acc = acc * 10 + d
        i = i + 1
    if neg: 0 - acc else: acc

pub fn effect_log_writes(log: [EffectRecord]) -> [EffectRecord]:
    var out: [EffectRecord] = []
    for r in log:
        if r.kind == "w":
            out.push(r)
    out

# Read script for replay mode: the values the reference observed, in order.
pub fn effect_log_read_script(log: [EffectRecord]) -> [i64]:
    var out: [i64] = []
    for r in log:
        if r.kind == "r":
            out.push(r.value)
    out

# poll_collapse (design B.5): consecutive reads of the same address collapse
# to the LAST one, so a spin-until-ready loop compares equal regardless of
# how many polls each provider needed.
pub fn effect_log_collapse_polls(log: [EffectRecord]) -> [EffectRecord]:
    var out: [EffectRecord] = []
    for r in log:
        val n = out.len()
        if n > 0 and r.kind == "r" and out[n - 1].kind == "r" and out[n - 1].addr == r.addr and out[n - 1].width == r.width:
            out[n - 1] = r
        else:
            out.push(r)
    out

fn _records_equal(a: EffectRecord, b: EffectRecord) -> bool:
    a.kind == b.kind and a.addr == b.addr and a.width == b.width and a.value == b.value

pub fn effect_logs_compare(ref_log: [EffectRecord], cand_log: [EffectRecord], poll_collapse: bool) -> EffectCompare:
    val a = if poll_collapse: effect_log_collapse_polls(ref_log) else: ref_log
    val b = if poll_collapse: effect_log_collapse_polls(cand_log) else: cand_log
    var i = 0
    var first_diff = -1
    val n = if a.len() < b.len(): a.len() else: b.len()
    while i < n and first_diff < 0:
        if not _records_equal(a[i], b[i]):
            first_diff = i
        i = i + 1
    if first_diff < 0 and a.len() != b.len():
        first_diff = n
    EffectCompare(
        agree: first_diff < 0,
        ref_len: a.len(),
        cand_len: b.len(),
        first_diff_index: first_diff,
        ref_repr: effect_log_repr(a),
        cand_repr: effect_log_repr(b),
    )

pub class VirtualDevice:
    records: [EffectRecord]
    read_script: [i64]
    read_cursor: i64
    write_count: i64
    read_count: i64
    script_exhausted: bool

impl VirtualDevice:
    static fn create(read_script: [i64]) -> VirtualDevice:
        VirtualDevice(records: [], read_script: read_script, read_cursor: 0,
                      write_count: 0, read_count: 0, script_exhausted: false)

    me _write(addr: u64, width: i64, value: i64):
        self.records.push(EffectRecord(order: self.records.len(), kind: "w", addr: addr, width: width, value: value))
        self.write_count = self.write_count + 1

    me _read(addr: u64, width: i64) -> i64:
        var value: i64 = 0
        val n = self.read_script.len()
        if n == 0:
            self.script_exhausted = true
        elif self.read_cursor < n:
            value = self.read_script[self.read_cursor]
            self.read_cursor = self.read_cursor + 1
        else:
            # A spin loop past the end of the script keeps seeing the last
            # scripted value (the "ready" state), so it terminates.
            value = self.read_script[n - 1]
            self.script_exhausted = true
        self.records.push(EffectRecord(order: self.records.len(), kind: "r", addr: addr, width: width, value: value))
        self.read_count = self.read_count + 1
        value

    me write_u8(addr: u64, value: i64):
        self._write(addr, 8, value & 0xFF)

    me write_u16(addr: u64, value: i64):
        self._write(addr, 16, value & 0xFFFF)

    me write_u32(addr: u64, value: i64):
        self._write(addr, 32, value & 0xFFFFFFFF)

    me read_u8(addr: u64) -> i64:
        self._read(addr, 8) & 0xFF

    me read_u16(addr: u64) -> i64:
        self._read(addr, 16) & 0xFFFF

    me read_u32(addr: u64) -> i64:
        self._read(addr, 32) & 0xFFFFFFFF

    fn log() -> [EffectRecord]:
        self.records

# Commit step for device-effect pairs: replay the AGREED write log to real
# hardware, once. Reads are not replayed (they were answered by the script).
# Returns the number of writes applied. Only the runner calls this, and only
# after compare passed — see dual_runner.spl.
pub fn dual_apply_effects_mmio(log: [EffectRecord]) -> i64:
    var applied = 0
    for r in log:
        if r.kind != "w":
            continue
        unsafe(capabilities: [ffi, raw_ptr]):
            if r.width == 8:
                rt_mmio_write_u8(r.addr, (r.value & 0xFF) as u8)
            elif r.width == 16:
                rt_mmio_write_u16(r.addr, (r.value & 0xFFFF) as u16)
            else:
                rt_mmio_write_u32(r.addr, (r.value & 0xFFFFFFFF) as u32)
        applied = applied + 1
    applied

export EffectRecord, EffectCompare, VirtualDevice
export effect_record, effect_record_repr, effect_log_repr, effect_log_from_trace_text
export effect_log_writes, effect_log_read_script, effect_log_collapse_polls
export effect_logs_compare, dual_apply_effects_mmio
