# dual_run_ledger.spl — soak ledger for dual-run pairs (design B.7/B.8).
#
# One SDN row per runner flush:
#   - pair: <name>
#     mode: value | shadow-buffer | shadow-state | record-compare | replay
#     run_id: <DUAL_RUN_ID or unix-micros>
#     cases: <n>
#     mismatches: <m>
#     first_mismatch_repr: "<ref=.. cand=..>"
#     binary_identity: <SIMPLE_BINARY_IDENTITY or "unknown">
#
# Default path is build/dual_run/dual_run_ledger.sdn (gitignored runtime
# state; DUAL_RUN_LEDGER overrides). The plan's stability bar is computed by
# dual_ledger_soak: >= SOAK_MIN_CASES cases across >= SOAK_MIN_RUNS
# independent run_ids on >= SOAK_MIN_IDENTITIES binary identities with zero
# mismatches. The gate (scripts/check/check-dual-run-shadow.shs) reads the
# same file and FAILs on any row with mismatches > 0 for the current run.
#
# The parser is line-based on purpose: the row shape is fixed, and the ledger
# must stay readable from a shell gate with grep/sed.

use std.io_runtime.{env_get, file_exists, read_file, file_append_text, mkdir_p, time_now_unix_micros}

pub val SOAK_MIN_CASES: i64 = 1000
pub val SOAK_MIN_RUNS: i64 = 30
pub val SOAK_MIN_IDENTITIES: i64 = 2

pub struct LedgerRow:
    pair: text
    mode: text
    run_id: text
    cases: i64
    mismatches: i64
    first_mismatch_repr: text
    binary_identity: text

pub struct SoakSummary:
    pair: text
    runs: i64
    cases: i64
    mismatches: i64
    identities: [text]
    stable: bool

pub fn dual_ledger_default_path() -> text:
    val p = env_get("DUAL_RUN_LEDGER")
    if p != "": p else: "build/dual_run/dual_run_ledger.sdn"

pub fn dual_run_binary_identity() -> text:
    val id = env_get("SIMPLE_BINARY_IDENTITY")
    if id != "": id else: "unknown"

pub fn dual_run_run_id() -> text:
    val id = env_get("DUAL_RUN_ID")
    if id != "": id else: "{time_now_unix_micros()}"

fn _quote(s: text) -> text:
    var out = ""
    var i = 0
    while i < s.len():
        val c = s.substring(i, i + 1)
        if c == "\"" or c == "\\":
            out = out + "\\"
        if c == "\n":
            out = out + " "
        else:
            out = out + c
        i = i + 1
    "\"{out}\""

fn _unquote(s: text) -> text:
    val t = s.trim()
    if t.len() >= 2 and t.starts_with("\"") and t.ends_with("\""):
        var out = ""
        var i = 1
        while i < t.len() - 1:
            val c = t.substring(i, i + 1)
            if c == "\\" and i + 1 < t.len() - 1:
                i = i + 1
                out = out + t.substring(i, i + 1)
            else:
                out = out + c
            i = i + 1
        return out
    t

fn _to_i64(s: text) -> i64:
    var acc: i64 = 0
    var i = 0
    var neg = false
    val t = s.trim()
    if t.starts_with("-"):
        neg = true
        i = 1
    while i < t.len():
        val d = "0123456789".index_of(t.substring(i, i + 1))
        if d < 0:
            break
        acc = acc * 10 + d
        i = i + 1
    if neg: 0 - acc else: acc

pub fn dual_ledger_row_text(row: LedgerRow) -> text:
    "  - pair: {row.pair}\n    mode: {row.mode}\n    run_id: {row.run_id}\n    cases: {row.cases}\n    mismatches: {row.mismatches}\n    first_mismatch_repr: {_quote(row.first_mismatch_repr)}\n    binary_identity: {row.binary_identity}\n"

fn _dir_of(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0: "" else: path.substring(0, idx)

pub fn dual_ledger_append(path: text, row: LedgerRow) -> bool:
    val dir = _dir_of(path)
    if dir != "":
        mkdir_p(dir)
    var body = ""
    if not file_exists(path):
        body = "# dual-run soak ledger — appended by std.nogc_sync_mut.rt_hal.dual_runner; read by scripts/check/check-dual-run-shadow.shs\ndual_run_ledger:\n"
    body = body + dual_ledger_row_text(row)
    file_append_text(path, body)

fn _empty_row() -> LedgerRow:
    LedgerRow(pair: "", mode: "", run_id: "", cases: 0, mismatches: 0, first_mismatch_repr: "", binary_identity: "")

pub fn dual_ledger_parse(body: text) -> [LedgerRow]:
    var rows: [LedgerRow] = []
    var cur = _empty_row()
    var open = false
    for raw in body.split("\n"):
        val line = raw.trim()
        if line == "" or line.starts_with("#"):
            continue
        if line.starts_with("- pair:"):
            if open:
                rows.push(cur)
            cur = _empty_row()
            cur.pair = line.substring(7, line.len()).trim()
            open = true
            continue
        if not open:
            continue
        val colon = line.index_of(":")
        if colon < 0:
            continue
        val key = line.substring(0, colon).trim()
        val value = line.substring(colon + 1, line.len()).trim()
        if key == "mode":
            cur.mode = value
        elif key == "run_id":
            cur.run_id = value
        elif key == "cases":
            cur.cases = _to_i64(value)
        elif key == "mismatches":
            cur.mismatches = _to_i64(value)
        elif key == "first_mismatch_repr":
            cur.first_mismatch_repr = _unquote(value)
        elif key == "binary_identity":
            cur.binary_identity = value
    if open:
        rows.push(cur)
    rows

pub fn dual_ledger_load(path: text) -> [LedgerRow]:
    if not file_exists(path):
        return []
    dual_ledger_parse(read_file(path))

fn _contains_text(xs: [text], x: text) -> bool:
    for y in xs:
        if y == x:
            return true
    false

pub fn dual_ledger_soak(rows: [LedgerRow], pair: text) -> SoakSummary:
    var runs: [text] = []
    var identities: [text] = []
    var cases: i64 = 0
    var mismatches: i64 = 0
    for r in rows:
        if r.pair != pair:
            continue
        cases = cases + r.cases
        mismatches = mismatches + r.mismatches
        if not _contains_text(runs, r.run_id):
            runs.push(r.run_id)
        if not _contains_text(identities, r.binary_identity):
            identities.push(r.binary_identity)
    val stable = mismatches == 0 and cases >= SOAK_MIN_CASES and runs.len() >= SOAK_MIN_RUNS and identities.len() >= SOAK_MIN_IDENTITIES
    SoakSummary(pair: pair, runs: runs.len(), cases: cases, mismatches: mismatches, identities: identities, stable: stable)

pub fn dual_ledger_soak_all(rows: [LedgerRow]) -> [SoakSummary]:
    var pairs: [text] = []
    for r in rows:
        if not _contains_text(pairs, r.pair):
            pairs.push(r.pair)
    var out: [SoakSummary] = []
    for p in pairs:
        out.push(dual_ledger_soak(rows, p))
    out

pub fn dual_ledger_soak_line(s: SoakSummary) -> text:
    "pair={s.pair} runs={s.runs} cases={s.cases} mismatches={s.mismatches} identities={s.identities.len()} stable={s.stable}"

export LedgerRow, SoakSummary, SOAK_MIN_CASES, SOAK_MIN_RUNS, SOAK_MIN_IDENTITIES
export dual_ledger_default_path, dual_run_binary_identity, dual_run_run_id
export dual_ledger_row_text, dual_ledger_append, dual_ledger_parse, dual_ledger_load
export dual_ledger_soak, dual_ledger_soak_all, dual_ledger_soak_line
