# codex-impl
# Process-wire scratch owned by the controller. Public values are scalar leases;
# bytes remain in one cold-preallocated module-private arena. Foreign frames
# carry descriptors and canonical codec bytes, never registry receipts.

use std.nogc_sync_mut.io.thread.{thread_native_current_id}
use std.nogc_sync_mut.rt_hal.exact_io_schema.{RtHalExactIoJoinStatus}

pub const RT_HAL_EXACT_WIRE_VERSION = 2
pub const RT_HAL_EXACT_WIRE_REQUEST = 1
pub const RT_HAL_EXACT_WIRE_RESULT = 2

pub enum RtHalExactWireStatus:
    Open
    Frozen
    Completed
    ProtocolFailure
    MemoryBound

type RtHalExactWireHandle = i64

pub struct RtHalExactWireView:
    version: i64
    kind: i64
    case_id: i64
    request_index: i64
    provider_ordinal: i64
    status: RtHalExactWireStatus
    byte_length: i64
    replay_peer: RtHalExactWireHandle
    replay_schema_id: i64

pub struct RtHalExactWireJoin:
    completed: bool
    status: RtHalExactIoJoinStatus
    child_exit_code: i64
    reaped: bool
    result: RtHalExactWireHandle

pub fn rt_hal_exact_wire_failed_join(status: RtHalExactIoJoinStatus,
                                     child_exit_code: i64,
                                     reaped: bool) -> RtHalExactWireJoin:
    RtHalExactWireJoin(completed: false, status: status,
        child_exit_code: child_exit_code, reaped: reaped,
        result: invalid_wire_handle())

var _wire_owner = 0
var _wire_capacity = 0
var _wire_bytes_per_slot = 0
var _wire_free_head = -1
var _wire_free_next: [i64] = []
var _wire_active: [bool] = []
// A request starts with exactly one producer lease.  A host may acquire at
// most one consumer lease after the frame is frozen.  Keeping these roles
// separate prevents a scalar handle from being reused while a child can still
// read the frame.
var _wire_producer_live: [bool] = []
var _wire_consumer_live: [bool] = []
var _wire_consumer_capability: [i64] = []
var _wire_generation: [i64] = []
var _wire_capability: [i64] = []
var _wire_kind: [i64] = []
var _wire_case_id: [i64] = []
var _wire_request_index: [i64] = []
var _wire_provider_ordinal: [i64] = []
var _wire_status: [RtHalExactWireStatus] = []
var _wire_length: [i64] = []
var _wire_replay_peer: [i64] = []
var _wire_replay_schema_id: [i64] = []
var _wire_bytes: [u8] = []

fn invalid_wire_handle() -> RtHalExactWireHandle:
    -1

fn wire_owner_ok() -> bool:
    _wire_owner > 0 and thread_native_current_id() == _wire_owner

fn wire_slot(handle: RtHalExactWireHandle) -> i64:
    if not wire_owner_ok(): return -1
    if handle <= 0: return -1
    val slot = (handle - 1) % 512
    val generation = (handle - 1) / 512
    if slot < 0 or slot >= _wire_capacity: return -1
    if (not _wire_active[slot] or not _wire_producer_live[slot] or
        _wire_generation[slot] != generation or
        _wire_capability[slot] != handle):
        return -1
    slot

# Consumer capabilities are deliberately in a disjoint negative namespace.
# A producer token can never be accepted by child-only reads/releases, and a
# child token can never append, freeze, complete, view, or retire producer
# state.  The scalar transport remains ABI-small without making authority
# ambiguous.
fn consumer_slot(handle: RtHalExactWireHandle) -> i64:
    if not wire_owner_ok() or handle >= -1: return -1
    val producer = -handle - 1
    val slot = (producer - 1) % 512
    val generation = (producer - 1) / 512
    if slot < 0 or slot >= _wire_capacity: return -1
    if (not _wire_active[slot] or not _wire_consumer_live[slot] or
        _wire_generation[slot] != generation or
        _wire_consumer_capability[slot] != handle):
        return -1
    slot

# Cold installation performs every allocation. Dispatch only reserves an
# existing slot and writes into its disjoint byte range.
pub fn rt_hal_exact_wire_install(capacity: i64, bytes_per_slot: i64) -> bool:
    if _wire_owner != 0 or capacity <= 0 or capacity > 256: return false
    if bytes_per_slot <= 0 or bytes_per_slot > 1048576: return false
    if capacity > 2147483647 / bytes_per_slot: return false
    val owner = thread_native_current_id()
    if owner <= 0: return false
    _wire_owner = owner
    _wire_capacity = capacity
    _wire_bytes_per_slot = bytes_per_slot
    var slot = 0
    while slot < capacity:
        _wire_active.push(false)
        _wire_producer_live.push(false)
        _wire_consumer_live.push(false)
        _wire_consumer_capability.push(0)
        _wire_free_next.push(slot + 1)
        _wire_generation.push(0)
        _wire_capability.push(0)
        _wire_kind.push(0)
        _wire_case_id.push(0)
        _wire_request_index.push(-1)
        _wire_provider_ordinal.push(-1)
        _wire_status.push(RtHalExactWireStatus.Open)
        _wire_length.push(0)
        _wire_replay_peer.push(0)
        _wire_replay_schema_id.push(0)
        slot = slot + 1
    _wire_free_next[capacity - 1] = -1
    _wire_free_head = 0
    var byte_index = 0
    while byte_index < capacity * bytes_per_slot:
        _wire_bytes.push(0)
        byte_index = byte_index + 1
    true

pub fn rt_hal_exact_wire_reserve(kind: i64, case_id: i64,
                                 request_index: i64,
                                 provider_ordinal: i64) -> RtHalExactWireHandle:
    if not wire_owner_ok(): return invalid_wire_handle()
    if kind != RT_HAL_EXACT_WIRE_REQUEST and kind != RT_HAL_EXACT_WIRE_RESULT:
        return invalid_wire_handle()
    if case_id < 0 or request_index < 0: return invalid_wire_handle()
    if kind == RT_HAL_EXACT_WIRE_REQUEST and provider_ordinal != 0:
        return invalid_wire_handle()
    if kind == RT_HAL_EXACT_WIRE_RESULT and provider_ordinal <= 0:
        return invalid_wire_handle()
    val slot = _wire_free_head
    if slot < 0 or slot >= _wire_capacity:
        return invalid_wire_handle()
    var generation = _wire_generation[slot] + 1
    if generation <= 0: generation = 1
    if generation >= 18014398509481983: return invalid_wire_handle()
    _wire_free_head = _wire_free_next[slot]
    _wire_free_next[slot] = -1
    val capability = generation * 512 + slot + 1
    _wire_active[slot] = true
    _wire_producer_live[slot] = true
    _wire_consumer_live[slot] = false
    _wire_consumer_capability[slot] = 0
    _wire_generation[slot] = generation
    _wire_capability[slot] = capability
    _wire_kind[slot] = kind
    _wire_case_id[slot] = case_id
    _wire_request_index[slot] = request_index
    _wire_provider_ordinal[slot] = provider_ordinal
    _wire_status[slot] = RtHalExactWireStatus.Open
    _wire_length[slot] = 0
    _wire_replay_peer[slot] = 0
    _wire_replay_schema_id[slot] = 0
    capability

pub fn rt_hal_exact_wire_append_byte(handle: RtHalExactWireHandle,
                                     value: u8) -> bool:
    val slot = wire_slot(handle)
    if slot < 0 or _wire_status[slot] != RtHalExactWireStatus.Open: return false
    val length = _wire_length[slot]
    if length >= _wire_bytes_per_slot:
        _wire_status[slot] = RtHalExactWireStatus.MemoryBound
        return false
    _wire_bytes[slot * _wire_bytes_per_slot + length] = value
    _wire_length[slot] = length + 1
    true

pub fn rt_hal_exact_wire_freeze(handle: RtHalExactWireHandle) -> bool:
    val slot = wire_slot(handle)
    if slot < 0 or _wire_status[slot] != RtHalExactWireStatus.Open: return false
    if _wire_length[slot] <= 0: return false
    _wire_status[slot] = RtHalExactWireStatus.Frozen
    true

pub fn rt_hal_exact_wire_complete(handle: RtHalExactWireHandle) -> bool:
    val slot = wire_slot(handle)
    if slot < 0 or _wire_status[slot] != RtHalExactWireStatus.Frozen: return false
    _wire_status[slot] = RtHalExactWireStatus.Completed
    true

# A consumer lease is an explicit acknowledgement that the host accepted the
# frozen frame.  It is intentionally bounded to one child per wire slot;
# fanout obtains independent fixed slots instead of aliasing a mutable frame.
pub fn rt_hal_exact_wire_consumer_acquire(handle: RtHalExactWireHandle) -> RtHalExactWireHandle:
    val slot = wire_slot(handle)
    if slot < 0 or _wire_status[slot] != RtHalExactWireStatus.Frozen:
        return invalid_wire_handle()
    if not _wire_producer_live[slot] or _wire_consumer_live[slot]:
        return invalid_wire_handle()
    # `-1` is the universal invalid sentinel, so encode consumer authority as
    # `-(producer + 1)` in the disjoint negative namespace.
    if handle >= 9223372036854775806: return invalid_wire_handle()
    val consumer = -(handle + 1)
    _wire_consumer_live[slot] = true
    _wire_consumer_capability[slot] = consumer
    consumer

pub fn rt_hal_exact_wire_consumer_view(handle: RtHalExactWireHandle) -> RtHalExactWireView:
    val slot = consumer_slot(handle)
    if slot < 0:
        return RtHalExactWireView(version: 0, kind: 0, case_id: -1,
            request_index: -1, provider_ordinal: -1,
            status: RtHalExactWireStatus.ProtocolFailure, byte_length: 0,
            replay_peer: 0, replay_schema_id: 0)
    RtHalExactWireView(version: RT_HAL_EXACT_WIRE_VERSION,
        kind: _wire_kind[slot], case_id: _wire_case_id[slot],
        request_index: _wire_request_index[slot],
        provider_ordinal: _wire_provider_ordinal[slot],
        status: _wire_status[slot], byte_length: _wire_length[slot],
        replay_peer: if _wire_replay_peer[slot] > 0:
            -(_wire_replay_peer[slot] + 1) else: 0,
        replay_schema_id: _wire_replay_schema_id[slot])

# Binds the short effect frame to the exact frozen HIO2 request that declares
# its schema.  This is cold controller work; child consumers can validate the
# pair without being granted either producer capability.
pub fn rt_hal_exact_wire_bind_replay_pair(request: RtHalExactWireHandle,
        effect: RtHalExactWireHandle, schema_id: i64) -> bool:
    val request_slot = wire_slot(request)
    val effect_slot = wire_slot(effect)
    if request_slot < 0 or effect_slot < 0 or request_slot == effect_slot:
        return false
    if schema_id <= 0 or _wire_status[request_slot] != RtHalExactWireStatus.Frozen or
       _wire_status[effect_slot] != RtHalExactWireStatus.Frozen or
       _wire_kind[request_slot] != RT_HAL_EXACT_WIRE_REQUEST or
       _wire_kind[effect_slot] != RT_HAL_EXACT_WIRE_REQUEST or
       _wire_case_id[request_slot] != _wire_case_id[effect_slot] or
       _wire_request_index[request_slot] != _wire_request_index[effect_slot] or
       _wire_replay_peer[request_slot] != 0 or _wire_replay_peer[effect_slot] != 0:
        return false
    _wire_replay_peer[request_slot] = effect
    _wire_replay_peer[effect_slot] = request
    _wire_replay_schema_id[request_slot] = schema_id
    _wire_replay_schema_id[effect_slot] = schema_id
    true

pub fn rt_hal_exact_wire_consumer_byte_at(handle: RtHalExactWireHandle,
        index: i64) -> i64:
    val slot = consumer_slot(handle)
    if slot < 0 or _wire_status[slot] == RtHalExactWireStatus.Open: return -1
    if index < 0 or index >= _wire_length[slot]: return -1
    _wire_bytes[slot * _wire_bytes_per_slot + index] as i64

fn wire_retire(slot: i64):
    _wire_active[slot] = false
    _wire_consumer_capability[slot] = 0
    _wire_capability[slot] = 0
    _wire_kind[slot] = 0
    _wire_length[slot] = 0
    _wire_replay_peer[slot] = 0
    _wire_replay_schema_id[slot] = 0
    _wire_status[slot] = RtHalExactWireStatus.Open
    _wire_free_next[slot] = _wire_free_head
    _wire_free_head = slot

# Producer release is the move invalidation edge.  Once a host has acquired a
# consumer lease it cannot retire the frame by releasing this source lease.
pub fn rt_hal_exact_wire_release(handle: RtHalExactWireHandle) -> bool:
    val slot = wire_slot(handle)
    if slot < 0 or not _wire_producer_live[slot]: return false
    _wire_producer_live[slot] = false
    if not _wire_consumer_live[slot]: wire_retire(slot)
    true

# Called only after child completion, cancellation, or reap.  This is the
# acknowledgement completion edge for a host-held input frame.
pub fn rt_hal_exact_wire_consumer_release(handle: RtHalExactWireHandle) -> bool:
    val slot = consumer_slot(handle)
    if slot < 0 or not _wire_consumer_live[slot]: return false
    _wire_consumer_live[slot] = false
    _wire_consumer_capability[slot] = 0
    if not _wire_producer_live[slot]: wire_retire(slot)
    true

pub fn rt_hal_exact_wire_view(handle: RtHalExactWireHandle) -> RtHalExactWireView:
    val slot = wire_slot(handle)
    if slot < 0:
        return RtHalExactWireView(version: 0, kind: 0, case_id: -1,
            request_index: -1, provider_ordinal: -1,
            status: RtHalExactWireStatus.ProtocolFailure, byte_length: 0,
            replay_peer: 0, replay_schema_id: 0)
    RtHalExactWireView(version: RT_HAL_EXACT_WIRE_VERSION,
        kind: _wire_kind[slot], case_id: _wire_case_id[slot],
        request_index: _wire_request_index[slot],
        provider_ordinal: _wire_provider_ordinal[slot],
        status: _wire_status[slot], byte_length: _wire_length[slot],
        replay_peer: _wire_replay_peer[slot],
        replay_schema_id: _wire_replay_schema_id[slot])

pub fn rt_hal_exact_wire_byte_at(handle: RtHalExactWireHandle,
                                index: i64) -> i64:
    val slot = wire_slot(handle)
    if slot < 0 or _wire_status[slot] == RtHalExactWireStatus.Open: return -1
    if index < 0 or index >= _wire_length[slot]: return -1
    _wire_bytes[slot * _wire_bytes_per_slot + index] as i64

pub fn rt_hal_exact_wire_shutdown() -> bool:
    if _wire_owner==0:return true
    if not wire_owner_ok(): return false
    for active in _wire_active:
        if active: return false
    _wire_active = []
    _wire_producer_live = []
    _wire_consumer_live = []
    _wire_consumer_capability = []
    _wire_free_next = []
    _wire_generation = []
    _wire_capability = []
    _wire_kind = []
    _wire_case_id = []
    _wire_request_index = []
    _wire_provider_ordinal = []
    _wire_status = []
    _wire_length = []
    _wire_replay_peer = []
    _wire_replay_schema_id = []
    _wire_bytes = []
    _wire_owner = 0
    _wire_capacity = 0
    _wire_bytes_per_slot = 0
    _wire_free_head = -1
    true
