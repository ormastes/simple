# codex-impl
# Bounded process-owned collision authority. Lifecycle authority is a private
# class token; workers receive only a copyable frozen observation seal. All
# retained storage is allocated once before publication.

use std.nogc_sync_mut.concurrent.mutex.{Mutex,mutex_new,mutex_lock,mutex_unlock}
use std.common.rt_hal.exact_type_id.{RtHalExactTypeForeignCandidate,RT_HAL_EXACT_TYPE_ID_VERSION,RT_HAL_EXACT_TYPE_ID_MAX_REGISTRY_ROWS}
use std.common.hash.djb2.{djb2_hash_text}
use std.nogc_sync_mut.rt_hal.exact_type_descriptor_parser.{rt_hal_exact_type_descriptor_canonical}
use std.nogc_sync_mut.rt_hal.exact_byte_codec_owner.{rt_hal_codec_identity_bind,rt_hal_codec_identity_revoke,rt_hal_codec_owner_install,rt_hal_codec_owner_release,rt_hal_codec_admit_five_roots,rt_hal_codec_clear_five_admission}
use std.nogc_sync_mut.rt_hal.exact_shape_program_owner.{rt_hal_shape_program_install_five,rt_hal_shape_program_quiesce,rt_hal_shape_program_resume,rt_hal_shape_program_release_quiesced}

const RT_HAL_EXACT_TYPE_REGISTRY_OWNER_VERSION: i64=3
const _RTID_MAX_COUNTER: i64=0x7fffffffffffffff
const _RTID_MAX_RETAINED: i64=268435456
const _RTID_HEADER_BYTES: i64=64
const _RTID_OWNER_BYTES: i64=512

pub class RtHalExactTypeRegistryOwner:
    _generation: i64
    _capability: i64
    _lifecycle: i64
    _active: bool
impl RtHalExactTypeRegistryOwner:
    pub static fn invalid_probe() ->RtHalExactTypeRegistryOwner:
        RtHalExactTypeRegistryOwner(_generation:-1,_capability:0,_lifecycle:0,_active:false)

pub struct RtHalExactTypeRegistrySeal:
    _generation: i64
    _capability: i64
impl RtHalExactTypeRegistrySeal:
    pub static fn invalid_probe() ->RtHalExactTypeRegistrySeal:
        RtHalExactTypeRegistrySeal(_generation:-1,_capability:0)

pub struct RtHalExactTypeAdmission:
    _schema: i64
    _lane0: i64
    _lane1: i64
    _lane2: i64
    _lane3: i64
    _length: i64
    _receipt: i64
    _generation: i64
    _valid: bool
impl RtHalExactTypeAdmission:
    pub static fn invalid_probe() ->RtHalExactTypeAdmission:
        RtHalExactTypeAdmission(_schema:0,_lane0:0,_lane1:0,_lane2:0,_lane3:0,
            _length:0,_receipt:-1,_generation:-1,_valid:false)

pub struct RtHalExactTypeAdmissionBatch:
    operation: RtHalExactTypeAdmission
    input: RtHalExactTypeAdmission
    output: RtHalExactTypeAdmission
    error: RtHalExactTypeAdmission
    effect: RtHalExactTypeAdmission
    valid: bool

pub class RtHalExactTypeCodecOwner:
    _identity_generation: i64
    _identity_capability: i64
    _codec_generation: i64
    _codec_slot: i64
    _active: bool
impl RtHalExactTypeCodecOwner:
    pub static fn invalid_probe() ->RtHalExactTypeCodecOwner:
        RtHalExactTypeCodecOwner(_identity_generation:-1,_identity_capability:0,
            _codec_generation:0,_codec_slot:-1,_active:false)

fn _rtid_invalid_batch() ->RtHalExactTypeAdmissionBatch:
    val invalid=RtHalExactTypeAdmission.invalid_probe()
    RtHalExactTypeAdmissionBatch(operation:invalid,input:invalid,output:invalid,
        error: invalid,effect:invalid,valid:false)

var _rtid_lock: Mutex=mutex_new(0)
var _rtid_next_generation: i64=1
var _rtid_next_capability: i64=1
var _rtid_next_lifecycle: i64=1
var _rtid_generation: i64=0
var _rtid_capability: i64=0
var _rtid_lifecycle: i64=0
var _rtid_capacity: i64=0
var _rtid_count: i64=0
var _rtid_frozen: bool=false
var _rtid_releasing: bool=false
var _rtid_validators: i64=0
var _rtid_codec_generations: [i64]=[0;64]
var _rtid_codec_bound: i64=0
var _rtid_codec_revoke_pending: bool=false
var _rtid_structural_bytes: i64=0
var _rtid_arena_capacity: i64=0
var _rtid_arena_used: i64=0
var _rtid_lane0: [i64]=[]
var _rtid_lane1: [i64]=[]
var _rtid_lane2: [i64]=[]
var _rtid_lane3: [i64]=[]
var _rtid_lengths: [i64]=[]
var _rtid_offsets: [i64]=[]
var _rtid_hashes: [i64]=[]
var _rtid_canonical: [text]=[]
var _rtid_buckets: [i64]=[]
var _rtid_arena: [u8]=[]

fn _rtid_clear():
    _rtid_generation=0;_rtid_capability=0;_rtid_lifecycle=0
    _rtid_capacity=0;_rtid_count=0;_rtid_frozen=false;_rtid_releasing=false
    _rtid_validators=0;_rtid_codec_generations=[0;64];_rtid_codec_bound=0
    _rtid_codec_revoke_pending=false
    _rtid_structural_bytes=0;_rtid_arena_capacity=0;_rtid_arena_used=0
    _rtid_lane0=[];_rtid_lane1=[];_rtid_lane2=[];_rtid_lane3=[]
    _rtid_lengths=[];_rtid_offsets=[];_rtid_hashes=[];_rtid_canonical=[]
    _rtid_buckets=[];_rtid_arena=[]

fn _rtid_owner_matches(owner: RtHalExactTypeRegistryOwner) ->bool:
    owner._active and owner._generation==_rtid_generation and owner._capability==_rtid_capability and owner._lifecycle==_rtid_lifecycle
fn _rtid_seal_matches(seal: RtHalExactTypeRegistrySeal) ->bool:
    seal._generation>0 and seal._generation==_rtid_generation and seal._capability>0 and seal._capability==_rtid_capability
fn _rtid_codec_matches(codec: RtHalExactTypeCodecOwner) ->bool:
    codec._active and codec._identity_generation==_rtid_generation and
        codec._identity_capability==_rtid_capability and codec._codec_slot>=0 and
        codec._codec_slot<_rtid_codec_generations.len() and
        _rtid_codec_generations[codec._codec_slot]==codec._codec_generation
fn _rtid_hash(value: text) ->i64: djb2_hash_text("rt-hal-v2|"+value)
fn _rtid_lane(domain: text,value: text) ->i64: djb2_hash_text(domain+"|"+value)
fn _rtid_bucket_start(hash: i64) ->i64:
    var result=hash%_rtid_buckets.len()
    if result<0:result=result+_rtid_buckets.len()
    result

fn _rtid_bytes_match(receipt: i64,bytes: [u8]) ->bool:
    if receipt<0 or receipt>=_rtid_count or bytes.len()!=_rtid_lengths[receipt]:return false
    val offset=_rtid_offsets[receipt]
    var i=0
    while i<bytes.len():
        if _rtid_arena[offset+i]!=bytes[i]:return false
        i=i+1
    true

# Returns (existing receipt, insertion bucket). Both are -1 only when full.
fn _rtid_find(hash: i64,bytes: [u8]) ->(i64,i64):
    val start=_rtid_bucket_start(hash)
    var probe=0
    while probe<_rtid_buckets.len():
        val bucket=(start+probe)%_rtid_buckets.len()
        val receipt=_rtid_buckets[bucket]
        if receipt<0:return (-1,bucket)
        if _rtid_hashes[receipt]==hash and _rtid_bytes_match(receipt,bytes):return (receipt,bucket)
        probe=probe+1
    (-1,-1)

fn _rtid_admission(receipt: i64) ->RtHalExactTypeAdmission:
    RtHalExactTypeAdmission(_schema:RT_HAL_EXACT_TYPE_ID_VERSION,
        _lane0: _rtid_lane0[receipt],_lane1:_rtid_lane1[receipt],
        _lane2: _rtid_lane2[receipt],_lane3:_rtid_lane3[receipt],
        _length: _rtid_lengths[receipt],_receipt:receipt,
        _generation: _rtid_generation,_valid:true)

fn _rtid_admit_locked(canonical: text,bytes: [u8]) ->RtHalExactTypeAdmission:
    val hash=_rtid_hash(canonical)
    val found=_rtid_find(hash,bytes)
    if found.0>=0:return _rtid_admission(found.0)
    if found.1<0 or _rtid_count>=_rtid_capacity or bytes.len()>_rtid_arena_capacity-_rtid_arena_used:
        return RtHalExactTypeAdmission.invalid_probe()
    val receipt=_rtid_count;val offset=_rtid_arena_used;var i=0
    while i<bytes.len():_rtid_arena[offset+i]=bytes[i];i=i+1
    _rtid_lane0[receipt]=_rtid_lane("0",canonical);_rtid_lane1[receipt]=_rtid_lane("1",canonical)
    _rtid_lane2[receipt]=_rtid_lane("2",canonical);_rtid_lane3[receipt]=_rtid_lane("3",canonical)
    _rtid_lengths[receipt]=bytes.len();_rtid_offsets[receipt]=offset;_rtid_hashes[receipt]=hash
    _rtid_canonical[receipt]=canonical
    _rtid_buckets[found.1]=receipt;_rtid_arena_used=offset+bytes.len();_rtid_count=receipt+1
    _rtid_admission(receipt)

fn _rtid_rebuild_buckets_after_rollback(kept_count: i64):
    var i=0
    while i<_rtid_buckets.len():_rtid_buckets[i]=-1;i=i+1
    i=0
    while i<kept_count:
        val start=_rtid_bucket_start(_rtid_hashes[i]);var probe=0;var inserted=false
        while probe<_rtid_buckets.len() and not inserted:
            val bucket=(start+probe)%_rtid_buckets.len()
            if _rtid_buckets[bucket]<0:_rtid_buckets[bucket]=i;inserted=true
            probe=probe+1
        i=i+1

pub fn rt_hal_exact_type_registry_create(capacity: i64,max_retained_bytes: i64) ->RtHalExactTypeRegistryOwner:
    if capacity<=0 or capacity>RT_HAL_EXACT_TYPE_ID_MAX_REGISTRY_ROWS or
            max_retained_bytes<=0 or max_retained_bytes>_RTID_MAX_RETAINED:
        return RtHalExactTypeRegistryOwner.invalid_probe()
    val bucket_count=capacity*2+1
    # ABI-independent conservative charge: twofold payload/capacity slack plus
    # enlarged header/owner charges. Only half of the remaining byte ceiling is
    # exposed as descriptor payload, reserving the other half for allocation
    # metadata/alignment rather than claiming an unprovable sizeof.
    val structural=_RTID_OWNER_BYTES+10*_RTID_HEADER_BYTES+capacity*8*16+bucket_count*16
    if structural>=max_retained_bytes:return RtHalExactTypeRegistryOwner.invalid_probe()
    val arena_capacity=(max_retained_bytes-structural)/2
    if arena_capacity<=0:return RtHalExactTypeRegistryOwner.invalid_probe()
    val held=mutex_lock(_rtid_lock)
    if held==nil:return RtHalExactTypeRegistryOwner.invalid_probe()
    if _rtid_generation!=0 or _rtid_next_generation<=0 or _rtid_next_generation>=_RTID_MAX_COUNTER or
            _rtid_next_capability<=0 or _rtid_next_capability>=_RTID_MAX_COUNTER or
            _rtid_next_lifecycle<=0 or _rtid_next_lifecycle>=_RTID_MAX_COUNTER:
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeRegistryOwner.invalid_probe()
    # Array-repeat creates each exact fixed-length column once. Admission only
    # overwrites existing indexes and can never grow a backing allocation.
    _rtid_lane0=[0;capacity];_rtid_lane1=[0;capacity]
    _rtid_lane2=[0;capacity];_rtid_lane3=[0;capacity]
    _rtid_lengths=[0;capacity];_rtid_offsets=[0;capacity];_rtid_hashes=[0;capacity]
    _rtid_canonical=["";capacity]
    _rtid_buckets=[-1;bucket_count];_rtid_arena=[0u8;arena_capacity]
    val generation=_rtid_next_generation;val capability=_rtid_next_capability
    val lifecycle=_rtid_next_lifecycle
    _rtid_next_generation=generation+1;_rtid_next_capability=capability+1;_rtid_next_lifecycle=lifecycle+1
    _rtid_generation=generation;_rtid_capability=capability;_rtid_lifecycle=lifecycle
    _rtid_capacity=capacity;_rtid_structural_bytes=structural;_rtid_arena_capacity=arena_capacity
    mutex_unlock(_rtid_lock,0)
    RtHalExactTypeRegistryOwner(_generation:generation,_capability:capability,_lifecycle:lifecycle,_active:true)

pub fn rt_hal_exact_type_registry_admit(owner: RtHalExactTypeRegistryOwner,raw: text) ->RtHalExactTypeAdmission:
    # Reject stale/frozen owners before parser/hash/byte-buffer allocation.
    val preheld=mutex_lock(_rtid_lock)
    if preheld==nil:return RtHalExactTypeAdmission.invalid_probe()
    # A sealed controller may re-admit only descriptors it cold-admitted
    # itself.  This is the V2 foreign-result path: the candidate lanes are
    # untrusted, while the canonical descriptor must resolve to an existing
    # immutable receipt.  Do not reject `_rtid_frozen` here; the second lock
    # below distinguishes lookup-only admission from a mutable insertion.
    if not _rtid_owner_matches(owner) or _rtid_releasing:
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeAdmission.invalid_probe()
    mutex_unlock(_rtid_lock,0)
    val canonical=rt_hal_exact_type_descriptor_canonical(raw)
    if canonical=="":return RtHalExactTypeAdmission.invalid_probe()
    val bytes=canonical.bytes()
    val held=mutex_lock(_rtid_lock)
    if held==nil:return RtHalExactTypeAdmission.invalid_probe()
    if not _rtid_owner_matches(owner) or _rtid_frozen or _rtid_releasing:
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeAdmission.invalid_probe()
    val result=_rtid_admit_locked(canonical,bytes);mutex_unlock(_rtid_lock,0);result

# The public foreign boundary is deliberately batch-only: callers cannot
# accidentally admit a prefix of a rejected five-domain I/O schema.
pub fn rt_hal_exact_type_registry_readmit_five(owner: RtHalExactTypeRegistryOwner,
        _oc: RtHalExactTypeForeignCandidate,ot: text,_ic: RtHalExactTypeForeignCandidate,it: text,
        _vc: RtHalExactTypeForeignCandidate,vt: text,_ec: RtHalExactTypeForeignCandidate,et: text,
        _fc: RtHalExactTypeForeignCandidate,ft: text) ->RtHalExactTypeAdmissionBatch:
    val preheld=mutex_lock(_rtid_lock)
    if preheld==nil:return _rtid_invalid_batch()
    if not _rtid_owner_matches(owner) or _rtid_releasing:
        mutex_unlock(_rtid_lock,0);return _rtid_invalid_batch()
    mutex_unlock(_rtid_lock,0)
    val operation_text=rt_hal_exact_type_descriptor_canonical(ot)
    val input_text=rt_hal_exact_type_descriptor_canonical(it)
    val output_text=rt_hal_exact_type_descriptor_canonical(vt)
    val error_text=rt_hal_exact_type_descriptor_canonical(et)
    val effect_text=rt_hal_exact_type_descriptor_canonical(ft)
    if operation_text=="" or input_text=="" or output_text=="" or error_text=="" or effect_text=="":
        return _rtid_invalid_batch()
    val operation_bytes=operation_text.bytes();val input_bytes=input_text.bytes()
    val output_bytes=output_text.bytes();val error_bytes=error_text.bytes();val effect_bytes=effect_text.bytes()
    val held=mutex_lock(_rtid_lock)
    if held==nil:return _rtid_invalid_batch()
    if not _rtid_owner_matches(owner) or _rtid_releasing:
        mutex_unlock(_rtid_lock,0);return _rtid_invalid_batch()
    if _rtid_frozen:
        val operation_found=_rtid_find(_rtid_hash(operation_text),operation_bytes).0
        val input_found=_rtid_find(_rtid_hash(input_text),input_bytes).0
        val output_found=_rtid_find(_rtid_hash(output_text),output_bytes).0
        val error_found=_rtid_find(_rtid_hash(error_text),error_bytes).0
        val effect_found=_rtid_find(_rtid_hash(effect_text),effect_bytes).0
        if operation_found<0 or input_found<0 or output_found<0 or
           error_found<0 or effect_found<0:
            mutex_unlock(_rtid_lock,0);return _rtid_invalid_batch()
        val frozen_result=RtHalExactTypeAdmissionBatch(
            operation: _rtid_admission(operation_found),input:_rtid_admission(input_found),
            output: _rtid_admission(output_found),error:_rtid_admission(error_found),
            effect: _rtid_admission(effect_found),valid:true)
        mutex_unlock(_rtid_lock,0);return frozen_result
    val checkpoint_count=_rtid_count;val checkpoint_arena=_rtid_arena_used
    val operation=_rtid_admit_locked(operation_text,operation_bytes)
    val input=_rtid_admit_locked(input_text,input_bytes)
    val output=_rtid_admit_locked(output_text,output_bytes)
    val error=_rtid_admit_locked(error_text,error_bytes)
    val effect=_rtid_admit_locked(effect_text,effect_bytes)
    if not operation._valid or not input._valid or not output._valid or not error._valid or not effect._valid:
        var rollback_row=checkpoint_count
        while rollback_row<_rtid_count:
            _rtid_canonical[rollback_row]="";rollback_row=rollback_row+1
        _rtid_count=checkpoint_count;_rtid_arena_used=checkpoint_arena
        _rtid_rebuild_buckets_after_rollback(checkpoint_count)
        mutex_unlock(_rtid_lock,0);return _rtid_invalid_batch()
    val result=RtHalExactTypeAdmissionBatch(operation:operation,input:input,output:output,
        error: error,effect:effect,valid:true)
    mutex_unlock(_rtid_lock,0);result

pub fn rt_hal_exact_type_registry_freeze(owner: RtHalExactTypeRegistryOwner) ->RtHalExactTypeRegistrySeal:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return RtHalExactTypeRegistrySeal.invalid_probe()
    if not _rtid_owner_matches(owner) or _rtid_frozen or _rtid_releasing:
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeRegistrySeal.invalid_probe()
    _rtid_frozen=true
    val result=RtHalExactTypeRegistrySeal(_generation:_rtid_generation,_capability:_rtid_capability)
    mutex_unlock(_rtid_lock,0);result

pub fn rt_hal_exact_type_registry_validates(seal: RtHalExactTypeRegistrySeal,value: RtHalExactTypeAdmission) ->bool:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return false
    if not _rtid_seal_matches(seal) or not _rtid_frozen or _rtid_releasing or not value._valid or
            value._schema!=RT_HAL_EXACT_TYPE_ID_VERSION or value._generation!=_rtid_generation or
            value._receipt<0 or value._receipt>=_rtid_count:
        mutex_unlock(_rtid_lock,0);return false
    # Publish a real read lease, then release the mutex while reading immutable
    # frozen columns. Release fences reclamation on the active reader count.
    _rtid_validators=_rtid_validators+1;val r=value._receipt
    mutex_unlock(_rtid_lock,0)
    val matches=_rtid_lane0[r]==value._lane0 and _rtid_lane1[r]==value._lane1 and
        _rtid_lane2[r]==value._lane2 and _rtid_lane3[r]==value._lane3 and _rtid_lengths[r]==value._length
    val retire=mutex_lock(_rtid_lock)
    if retire==nil:return false
    _rtid_validators=_rtid_validators-1
    mutex_unlock(_rtid_lock,0);matches

pub fn rt_hal_exact_type_admission_equal(seal: RtHalExactTypeRegistrySeal,
        left: RtHalExactTypeAdmission,right: RtHalExactTypeAdmission) ->bool:
    if not rt_hal_exact_type_registry_validates(seal,left) or not rt_hal_exact_type_registry_validates(seal,right):return false
    left._generation==right._generation and left._receipt==right._receipt and
        left._lane0==right._lane0 and left._lane1==right._lane1 and
        left._lane2==right._lane2 and left._lane3==right._lane3 and left._length==right._length

pub fn rt_hal_exact_type_registry_bind_codec(owner: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal) ->RtHalExactTypeCodecOwner:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return RtHalExactTypeCodecOwner.invalid_probe()
    if not _rtid_owner_matches(owner) or not _rtid_seal_matches(seal) or
            not _rtid_frozen or _rtid_releasing or _rtid_codec_revoke_pending or
            _rtid_codec_bound>=64:
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeCodecOwner.invalid_probe()
    var codec_slot: i64=0
    while codec_slot<64 and _rtid_codec_generations[codec_slot]!=0:codec_slot=codec_slot+1
    if codec_slot>=64:
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeCodecOwner.invalid_probe()
    val first=_rtid_codec_bound==0
    if first and not rt_hal_codec_identity_bind(_rtid_generation,_rtid_capability):
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeCodecOwner.invalid_probe()
    val codec_generation=rt_hal_codec_owner_install(_rtid_generation,_rtid_capability)
    if codec_generation<=0:
        if first:rt_hal_codec_identity_revoke(_rtid_generation,_rtid_capability)
        mutex_unlock(_rtid_lock,0);return RtHalExactTypeCodecOwner.invalid_probe()
    _rtid_codec_generations[codec_slot]=codec_generation;_rtid_codec_bound=_rtid_codec_bound+1
    val result=RtHalExactTypeCodecOwner(_identity_generation:_rtid_generation,
        _identity_capability: _rtid_capability,_codec_generation:codec_generation,
        _codec_slot: codec_slot,_active:true)
    mutex_unlock(_rtid_lock,0);result

pub fn rt_hal_exact_type_codec_generation(codec: RtHalExactTypeCodecOwner) ->i64:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return 0
    var result: i64=0
    if _rtid_codec_matches(codec) and not _rtid_releasing:
        result=codec._codec_generation
    mutex_unlock(_rtid_lock,0);result

pub fn rt_hal_exact_type_codec_root_id(codec: RtHalExactTypeCodecOwner,
        seal: RtHalExactTypeRegistrySeal,value: RtHalExactTypeAdmission) ->i64:
    if not rt_hal_exact_type_registry_validates(seal,value):return 0
    val held=mutex_lock(_rtid_lock)
    if held==nil:return 0
    var result: i64=0
    if _rtid_codec_matches(codec) and
            _rtid_seal_matches(seal) and _rtid_frozen and not _rtid_releasing and
            value._generation==_rtid_generation and value._receipt>=0 and value._receipt<_rtid_count:
        result=value._receipt+1
    mutex_unlock(_rtid_lock,0);result

pub fn rt_hal_exact_type_codec_admit_five(codec: RtHalExactTypeCodecOwner,
        seal: RtHalExactTypeRegistrySeal,batch: RtHalExactTypeAdmissionBatch) ->bool:
    if not batch.valid:return false
    if not rt_hal_exact_type_registry_validates(seal,batch.operation) or
            not rt_hal_exact_type_registry_validates(seal,batch.input) or
            not rt_hal_exact_type_registry_validates(seal,batch.output) or
            not rt_hal_exact_type_registry_validates(seal,batch.error) or
            not rt_hal_exact_type_registry_validates(seal,batch.effect):return false
    val held=mutex_lock(_rtid_lock)
    if held==nil:return false
    var result=false
    if _rtid_codec_matches(codec) and _rtid_seal_matches(seal) and
            _rtid_frozen and not _rtid_releasing:
        result=rt_hal_codec_admit_five_roots(codec._codec_generation,_rtid_generation,
            _rtid_capability,batch.operation._receipt+1,batch.input._receipt+1,
            batch.output._receipt+1,batch.error._receipt+1,batch.effect._receipt+1)
        if result:
            val shapes=rt_hal_shape_program_install_five(codec._codec_generation,
                _rtid_generation,_rtid_capability,_rtid_canonical[batch.operation._receipt],
                _rtid_canonical[batch.input._receipt],_rtid_canonical[batch.output._receipt],
                _rtid_canonical[batch.error._receipt],_rtid_canonical[batch.effect._receipt],
                batch.operation._receipt+1,batch.input._receipt+1,
                batch.output._receipt+1,batch.error._receipt+1,batch.effect._receipt+1)
            result=shapes.valid
            if not result:rt_hal_codec_clear_five_admission(codec._codec_generation,
                _rtid_generation,_rtid_capability)
    mutex_unlock(_rtid_lock,0);result

pub fn rt_hal_exact_type_registry_unbind_codec(owner: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal,codec: RtHalExactTypeCodecOwner) ->bool:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return false
    if not _rtid_owner_matches(owner) or not _rtid_seal_matches(seal) or not _rtid_frozen or
            _rtid_releasing or not _rtid_codec_matches(codec):
        mutex_unlock(_rtid_lock,0);return false
    if not rt_hal_shape_program_quiesce(codec._codec_generation,_rtid_generation,_rtid_capability):
        mutex_unlock(_rtid_lock,0);return false
    if not rt_hal_codec_owner_release(codec._codec_generation):
        rt_hal_shape_program_resume(codec._codec_generation,_rtid_generation,_rtid_capability)
        mutex_unlock(_rtid_lock,0);return false
    if not rt_hal_shape_program_release_quiesced(codec._codec_generation,_rtid_generation,_rtid_capability):
        mutex_unlock(_rtid_lock,0);return false
    _rtid_codec_generations[codec._codec_slot]=0;_rtid_codec_bound=_rtid_codec_bound-1
    codec._active=false
    if _rtid_codec_bound==0:
        if not rt_hal_codec_identity_revoke(_rtid_generation,_rtid_capability):
            _rtid_codec_revoke_pending=true
            mutex_unlock(_rtid_lock,0);return false
        _rtid_codec_revoke_pending=false
    mutex_unlock(_rtid_lock,0);true

pub fn rt_hal_exact_type_registry_release(owner: RtHalExactTypeRegistryOwner,seal: RtHalExactTypeRegistrySeal) ->bool:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return false
    if not _rtid_owner_matches(owner) or not _rtid_seal_matches(seal) or not _rtid_frozen or
            _rtid_codec_bound!=0:
        mutex_unlock(_rtid_lock,0);return false
    if _rtid_codec_revoke_pending:
        if not rt_hal_codec_identity_revoke(_rtid_generation,_rtid_capability):
            mutex_unlock(_rtid_lock,0);return false
        _rtid_codec_revoke_pending=false
    _rtid_releasing=true
    if _rtid_validators!=0:
        mutex_unlock(_rtid_lock,0);return false
    _rtid_lifecycle=0;_rtid_clear()
    mutex_unlock(_rtid_lock,0);true

pub fn rt_hal_exact_type_registry_retained_bytes(seal: RtHalExactTypeRegistrySeal) ->i64:
    val held=mutex_lock(_rtid_lock)
    if held==nil:return -1
    if not _rtid_seal_matches(seal) or not _rtid_frozen:
        mutex_unlock(_rtid_lock,0);return -1
    val result=_rtid_structural_bytes+2*_rtid_arena_capacity
    mutex_unlock(_rtid_lock,0);result

export RT_HAL_EXACT_TYPE_REGISTRY_OWNER_VERSION
