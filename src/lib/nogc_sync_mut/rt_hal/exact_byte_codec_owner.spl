# codex-impl
# Bounded, owner-thread exact byte transcript for RT/HAL comparison.
#
# The arena is allocated lazily on the first admitted identity and reclaimed
# after the last identity revoke once all 64 slots and readers are quiescent.
# Public calls exchange scalars only: no array, text, pointer, or COW value crosses this boundary.
# Mutable slots are single-owner. Other threads consult only the published
# atomic header and fail closed before touching the arena.

use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}

extern fn spl_thread_current_id() -> i64
extern fn rt_current_task_id() -> i64

pub const RT_HAL_CODEC_MAX_BYTES = 65536
pub const RT_HAL_CODEC_MAX_EVENTS = 8192
pub const RT_HAL_CODEC_MAX_DEPTH = 64
pub const RT_HAL_CODEC_MAX_ELEMENTS = 4096
pub const RT_HAL_CODEC_MAX_SLOTS = 64
pub const RT_HAL_CODEC_SLOT_STRIDE = 8 # 8*i64 = one 64-byte cache line
# Exact flat arena payload: bytes + two i64 event columns + four i64 shape
# columns. The remaining constants are conservative retained-capacity budgets,
# not ABI-size claims: 36 cache-line-strided scalar columns, eight compact
# columns (six parent plus two module-lifetime token counters), 457 native
# atomic cells (7*64 slot cells plus nine module cells),
# and 58 dynamic-array headers. Every opaque native atomic allocation and
# dynamic-array header is conservatively charged one complete 64-byte cache
# line, including allocator/header alignment; this is an enforced ceiling
# formula rather than an assumed ABI sizeof.
pub const RT_HAL_CODEC_ARENA_PAYLOAD_BYTES =
    RT_HAL_CODEC_MAX_SLOTS * (RT_HAL_CODEC_MAX_BYTES +
        2 * RT_HAL_CODEC_MAX_EVENTS * 8 + 4 * RT_HAL_CODEC_MAX_DEPTH * 8)
pub const RT_HAL_CODEC_PADDED_SCALAR_COLUMNS = 36
pub const RT_HAL_CODEC_COMPACT_SCALAR_COLUMNS = 8
pub const RT_HAL_CODEC_SLOT_ATOMIC_COLUMNS = 7
pub const RT_HAL_CODEC_MODULE_ATOMIC_CELLS = 9
pub const RT_HAL_CODEC_DYNAMIC_ARRAY_HEADERS = 58
pub const RT_HAL_CODEC_CONSERVATIVE_ALLOCATION_BYTES = 64
pub const RT_HAL_CODEC_SCALAR_METADATA_BUDGET =
    RT_HAL_CODEC_PADDED_SCALAR_COLUMNS * RT_HAL_CODEC_MAX_SLOTS *
        RT_HAL_CODEC_SLOT_STRIDE * 8 +
    RT_HAL_CODEC_COMPACT_SCALAR_COLUMNS * RT_HAL_CODEC_MAX_SLOTS * 8
pub const RT_HAL_CODEC_ATOMIC_HEADER_BUDGET =
    (RT_HAL_CODEC_SLOT_ATOMIC_COLUMNS * RT_HAL_CODEC_MAX_SLOTS +
        RT_HAL_CODEC_MODULE_ATOMIC_CELLS) *
        RT_HAL_CODEC_CONSERVATIVE_ALLOCATION_BYTES +
    RT_HAL_CODEC_DYNAMIC_ARRAY_HEADERS *
        RT_HAL_CODEC_CONSERVATIVE_ALLOCATION_BYTES
pub const RT_HAL_CODEC_RETAINED_BYTES = RT_HAL_CODEC_ARENA_PAYLOAD_BYTES +
    RT_HAL_CODEC_SCALAR_METADATA_BUDGET + RT_HAL_CODEC_ATOMIC_HEADER_BUDGET
# Dormant mode retains only the two module-lifetime token columns and their
# headers plus nine module lifecycle atomics. Payload, slot atomics, parent,
# transcript, shape-receipt, snapshot, decode, and hot columns are reclaimed.
pub const RT_HAL_CODEC_DORMANT_RETAINED_BYTES =
    2 * RT_HAL_CODEC_MAX_SLOTS * 8 +
    (2 + RT_HAL_CODEC_MODULE_ATOMIC_CELLS) *
        RT_HAL_CODEC_CONSERVATIVE_ALLOCATION_BYTES

pub enum RtHalCodecError:
    None
    Inactive
    WrongOwner
    StaleHandle
    IdentityNotBound
    InvalidArgument
    ByteBound
    EventBound
    DepthBound
    ElementBound
    RetainedBound
    ShapeMismatch
    TagMismatch
    InvalidUtf8
    Incomplete

pub enum RtHalCodecEvent:
    RootBegin
    RootEnd
    TupleBegin
    TupleEnd
    ArrayBegin
    ArrayEnd
    ResultOkBegin
    ResultOkEnd
    ResultErrBegin
    ResultErrEnd
    Unit
    Bool
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    F32
    F64
    BytesBegin
    BytesEnd
    Utf8Begin
    Utf8End

pub enum RtHalCodecRootDomain:
    Operation
    Input
    Output
    Error
    Effect

# Published header. Zero active is the only admission state exposed before a
# fully initialized generation. SeqCst supplies acquire/release semantics in
# the current atomic runtime. Capability stays zero until the safe scalar type
# identity owner is independently admitted.
var _codec_pool_ready: AtomicI64 = atomic_i64_new(0)
var _codec_pool_readers: AtomicI64 = atomic_i64_new(0)
var _codec_active: [AtomicI64] = []
var _codec_generation: [AtomicI64] = []
var _codec_capability: [AtomicI64] = []
var _codec_owner_thread: [AtomicI64] = []
var _codec_owner_task: [AtomicI64] = []
var _codec_lease: [AtomicI64] = []
var _codec_readers: [AtomicI64] = []
var _codec_identity_generation: AtomicI64 = atomic_i64_new(0)
var _codec_identity_capability: AtomicI64 = atomic_i64_new(0)
var _codec_identity_state: AtomicI64 = atomic_i64_new(0) # 0=unbound, 1=bound, -1=transition
var _codec_install_inflight: AtomicI64 = atomic_i64_new(0)
# Never destroyed with the payload pool. Recreated slots must not reuse a
# scalar handle that a stale caller can retain across the last unbind.
var _codec_next_generation: [i64] = [1; RT_HAL_CODEC_MAX_SLOTS]
# Capabilities also advance independently of identity secrets. A later identity
# may choose an adversarially related secret; monotonic module-lifetime tokens
# prevent that from recreating any prior hot lease capability after reclaim.
var _codec_next_capability: [i64] = [1; RT_HAL_CODEC_MAX_SLOTS]

# Fixed module-private arena. Repeated-literal initialization happens once;
# admitted hot operations only overwrite existing slots.
var _codec_bytes: [u8] = []
var _codec_event_tag: [i64] = []
var _codec_event_arg: [i64] = []
var _codec_stack_end: [i64] = []
var _codec_stack_expected: [i64] = []
var _codec_stack_observed: [i64] = []
var _codec_stack_byte_start: [i64] = []
var _codec_byte_count: [i64] = []
var _codec_event_count: [i64] = []
var _codec_depth: [i64] = []
var _codec_elements: [i64] = []
var _codec_error: [RtHalCodecError] = []
var _codec_utf8_remaining: [i64] = []
var _codec_utf8_min_second: [i64] = []
var _codec_utf8_max_second: [i64] = []
var _codec_utf8_lane: [i64] = []
var _codec_root_state: [i64] = []
var _codec_decode_state: [i64] = []
var _codec_decode_event: [i64] = []
var _codec_decode_byte: [i64] = []
var _codec_decode_arg: [i64] = []
# i64, rather than a packed bool, makes codec_lane(slot) a real 64-byte stride.
var _codec_decode_arg_pending: [i64] = []

# A snapshot is a scoped scalar lease over the module-private arena, never an
# array or raw pointer. The installing thread/task remains the sole execution
# domain. Parent integration may preflight, reserve its final arena, then copy
# each scalar exactly once before releasing this lease.
pub struct RtHalExactIoCodecSpan:
    event_offset: i64
    event_count: i64
    byte_offset: i64
    byte_length: i64

pub class RtHalExactIoCodecSnapshot:
    _slot: i64
    _codec_generation: i64
    _codec_capability: i64
    _snapshot_epoch: i64
    _snapshot_capability: i64

pub class RtHalCodecHotLease:
    _slot: i64
    _generation: i64
    _capability: i64

impl RtHalCodecHotLease:
    # Public construction yields only an inert carrier; every package mutation
    # revalidates the owner-issued slot/generation/capability tuple.
    pub static fn invalid_probe() -> RtHalCodecHotLease:
        RtHalCodecHotLease(_slot: -1, _generation: 0, _capability: 0)

fn codec_invalid_hot_lease() -> RtHalCodecHotLease:
    RtHalCodecHotLease.invalid_probe()

var _codec_hot_active: [i64] = []
var _codec_hot_generation: [i64] = []
var _codec_hot_capability: [i64] = []
var _codec_hot_cursor: [i64] = []

var _codec_snapshot_state: [i64] = []
var _codec_snapshot_epoch: [i64] = []
var _codec_snapshot_capability: [i64] = []
var _codec_next_snapshot_epoch: [i64] = []
var _codec_next_snapshot_capability: [i64] = []
var _codec_committed_ordinal: [i64] = []

# One cold parent-authoritative batch transaction. Scalar SoA columns avoid
# retaining copy-on-write snapshot objects. State/token publication is atomic;
# all child leases are reserved before any terminal state is committed.
var _codec_parent_batch_state: AtomicI64 = atomic_i64_new(0)
var _codec_parent_owner_thread: AtomicI64 = atomic_i64_new(0)
var _codec_parent_owner_task: AtomicI64 = atomic_i64_new(0)
var _codec_parent_next_epoch: i64 = 1
var _codec_parent_committed_epoch: i64 = 0
var _codec_parent_batch_token: i64 = 0
var _codec_parent_batch_expected: i64 = 0
var _codec_parent_batch_count: i64 = 0
var _codec_parent_slot: [i64] = []
var _codec_parent_generation: [i64] = []
var _codec_parent_codec_capability: [i64] = []
var _codec_parent_snapshot_epoch: [i64] = []
var _codec_parent_snapshot_capability: [i64] = []
var _codec_parent_ordinal: [i64] = []

# Exact-I/O has five admitted descriptor roles. Keep their scalar receipt IDs
# in fixed slots so root admission is bounded O(5), allocation-free, and cannot
# be forged merely by passing an arbitrary positive integer. The frozen
# identity owner calls the package hook only after validating its seal/receipt.
var _codec_admitted_root0: [i64] = []
var _codec_admitted_root1: [i64] = []
var _codec_admitted_root2: [i64] = []
var _codec_admitted_root3: [i64] = []
var _codec_admitted_root4: [i64] = []
var _codec_schema0: [i64] = []
var _codec_schema1: [i64] = []
var _codec_schema2: [i64] = []
var _codec_schema3: [i64] = []
var _codec_schema4: [i64] = []
var _codec_schema_ready: [i64] = []

fn codec_invalid_snapshot() -> RtHalExactIoCodecSnapshot:
    RtHalExactIoCodecSnapshot(_slot: -1, _codec_generation: 0, _codec_capability: 0,
        _snapshot_epoch: 0, _snapshot_capability: 0)

fn codec_invalid_span() -> RtHalExactIoCodecSpan:
    RtHalExactIoCodecSpan(event_offset: -1, event_count: -1,
        byte_offset: -1, byte_length: -1)

fn codec_event_code(event: RtHalCodecEvent) -> i64:
    match event:
        case RootBegin: 1
        case RootEnd: 2
        case TupleBegin: 3
        case TupleEnd: 4
        case ArrayBegin: 5
        case ArrayEnd: 6
        case ResultOkBegin: 7
        case ResultOkEnd: 8
        case ResultErrBegin: 9
        case ResultErrEnd: 10
        case Unit: 11
        case Bool: 12
        case I8: 13
        case I16: 14
        case I32: 15
        case I64: 16
        case U8: 17
        case U16: 18
        case U32: 19
        case U64: 20
        case F32: 21
        case F64: 22
        case BytesBegin: 23
        case BytesEnd: 24
        case Utf8Begin: 25
        case Utf8End: 26

fn codec_current_thread() -> i64:
    val id = spl_thread_current_id()
    if id > 0: return id
    0

fn codec_current_task() -> i64:
    val id = rt_current_task_id()
    if id > 0: return id
    0

fn codec_fail(slot: i64, problem: RtHalCodecError) -> bool:
    if _codec_error[codec_lane(slot)] == RtHalCodecError.None: _codec_error[codec_lane(slot)] = problem
    false

fn codec_pool_initialize() -> bool:
    val state = _codec_pool_ready.load(MemoryOrdering.SeqCst)
    if state == 1: return true
    if state != 0: return false
    if not _codec_pool_ready.compare_exchange(0, -1, MemoryOrdering.SeqCst,
                                               MemoryOrdering.SeqCst): return false
    # Cold activation performs seven large flat payload allocations plus the
    # explicitly budgeted scalar/atomic columns. Dormant/static-off execution
    # retains none of these dynamic arrays and executes none of this path.
    _codec_bytes = [0u8; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_BYTES]
    _codec_event_tag = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_EVENTS]
    _codec_event_arg = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_EVENTS]
    _codec_stack_end = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_DEPTH]
    _codec_stack_expected = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_DEPTH]
    _codec_stack_observed = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_DEPTH]
    _codec_stack_byte_start = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_MAX_DEPTH]
    _codec_byte_count = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_event_count = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_depth = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_elements = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_error = [RtHalCodecError.Inactive; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_utf8_remaining = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_utf8_min_second = [0x80; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_utf8_max_second = [0xbf; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_utf8_lane = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_root_state = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_decode_state = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_decode_event = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_decode_byte = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_decode_arg = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_decode_arg_pending = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_snapshot_state = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_snapshot_epoch = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_snapshot_capability = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_next_snapshot_epoch = [1; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_next_snapshot_capability = [1; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_committed_ordinal = [-1; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_parent_slot = [-1; RT_HAL_CODEC_MAX_SLOTS]
    _codec_parent_generation = [0; RT_HAL_CODEC_MAX_SLOTS]
    _codec_parent_codec_capability = [0; RT_HAL_CODEC_MAX_SLOTS]
    _codec_parent_snapshot_epoch = [0; RT_HAL_CODEC_MAX_SLOTS]
    _codec_parent_snapshot_capability = [0; RT_HAL_CODEC_MAX_SLOTS]
    _codec_parent_ordinal = [-1; RT_HAL_CODEC_MAX_SLOTS]
    _codec_admitted_root0 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_admitted_root1 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_admitted_root2 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_admitted_root3 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_admitted_root4 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_schema0 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_schema1 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_schema2 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_schema3 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_schema4 = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_schema_ready = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_hot_active = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_hot_generation = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_hot_capability = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    _codec_hot_cursor = [0; RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE]
    var slot = 0
    while slot < RT_HAL_CODEC_MAX_SLOTS:
        _codec_active.push(atomic_i64_new(0))
        _codec_generation.push(atomic_i64_new(0))
        _codec_capability.push(atomic_i64_new(0))
        _codec_owner_thread.push(atomic_i64_new(0))
        _codec_owner_task.push(atomic_i64_new(0))
        _codec_lease.push(atomic_i64_new(0))
        _codec_readers.push(atomic_i64_new(0))
        slot = slot + 1
    _codec_pool_ready.store(1, MemoryOrdering.SeqCst)
    true

fn codec_pool_destroy() -> bool:
    # Reclaim is all-or-nothing. A failed quiescence check republishes Ready
    # without clearing a header or arena. A successful destroy clears every
    # reclaimable column; the next install reconstructs full 64-slot capacity,
    # while module-lifetime generation/capability counters deliberately remain.
    if _codec_parent_batch_state.load(MemoryOrdering.SeqCst) != 0: return false
    if not _codec_pool_ready.compare_exchange(1, -1, MemoryOrdering.SeqCst,
            MemoryOrdering.SeqCst): return false
    if _codec_pool_readers.load(MemoryOrdering.SeqCst) != 0:
        _codec_pool_ready.store(1, MemoryOrdering.SeqCst); return false
    var slot = 0
    while slot < RT_HAL_CODEC_MAX_SLOTS:
        if _codec_active[slot].load(MemoryOrdering.SeqCst) != 0:
            _codec_pool_ready.store(1, MemoryOrdering.SeqCst); return false
        slot = slot + 1
    slot = 0
    while slot < RT_HAL_CODEC_MAX_SLOTS:
        _codec_active[slot].free(); _codec_generation[slot].free()
        _codec_capability[slot].free(); _codec_owner_thread[slot].free()
        _codec_owner_task[slot].free(); _codec_lease[slot].free()
        _codec_readers[slot].free(); slot = slot + 1
    _codec_active = []; _codec_generation = []; _codec_capability = []
    _codec_owner_thread = []; _codec_owner_task = []; _codec_lease = []; _codec_readers = []
    _codec_bytes = []; _codec_event_tag = []; _codec_event_arg = []
    _codec_stack_end = []; _codec_stack_expected = []
    _codec_stack_observed = []; _codec_stack_byte_start = []
    _codec_byte_count = []; _codec_event_count = []; _codec_depth = []; _codec_elements = []
    _codec_error = []; _codec_utf8_remaining = []; _codec_utf8_min_second = []
    _codec_utf8_max_second = []; _codec_utf8_lane = []; _codec_root_state = []
    _codec_decode_state = []; _codec_decode_event = []; _codec_decode_byte = []
    _codec_decode_arg = []; _codec_decode_arg_pending = []
    _codec_snapshot_state = []; _codec_snapshot_epoch = []; _codec_snapshot_capability = []
    _codec_next_snapshot_epoch = []; _codec_next_snapshot_capability = []
    _codec_committed_ordinal = []; _codec_parent_slot = []; _codec_parent_generation = []
    _codec_parent_codec_capability = []; _codec_parent_snapshot_epoch = []
    _codec_parent_snapshot_capability = []; _codec_parent_ordinal = []
    _codec_admitted_root0 = []; _codec_admitted_root1 = []; _codec_admitted_root2 = []
    _codec_admitted_root3 = []; _codec_admitted_root4 = []; _codec_schema0 = []
    _codec_schema1 = []; _codec_schema2 = []; _codec_schema3 = []; _codec_schema4 = []
    _codec_schema_ready = []
    _codec_hot_active = []; _codec_hot_generation = []; _codec_hot_capability = []
    _codec_hot_cursor = []
    _codec_pool_ready.store(0, MemoryOrdering.SeqCst)
    true

fn codec_handle(slot: i64, generation: i64) -> i64:
    if slot < 0 or slot >= RT_HAL_CODEC_MAX_SLOTS or generation <= 0: return 0
    if generation > (0x7fffffffffffffff - RT_HAL_CODEC_MAX_SLOTS) / RT_HAL_CODEC_MAX_SLOTS:
        return 0
    generation * RT_HAL_CODEC_MAX_SLOTS + slot + 1

fn codec_handle_slot(handle: i64) -> i64:
    if handle <= RT_HAL_CODEC_MAX_SLOTS: return -1
    (handle - 1) % RT_HAL_CODEC_MAX_SLOTS

fn codec_handle_generation(handle: i64) -> i64:
    if handle <= RT_HAL_CODEC_MAX_SLOTS: return 0
    (handle - 1) / RT_HAL_CODEC_MAX_SLOTS

fn codec_lane(slot: i64) -> i64:
    slot * RT_HAL_CODEC_SLOT_STRIDE

fn codec_mix_capability(secret: i64, generation: i64, slot: i64, epoch: i64) -> i64:
    var mixed = secret ^ generation ^ epoch ^ ((slot + 1) << 48)
    mixed = mixed ^ (mixed >> 31)
    mixed = mixed & 0x7fffffffffffffff
    if mixed == 0: return 1
    mixed

# Hot admission is O(1), allocation-free, and touches only one published slot.
fn codec_admit(handle: i64) -> i64:
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1: return -1
    _codec_pool_readers.fetch_add(1, MemoryOrdering.AcqRel)
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    val slot = codec_handle_slot(handle)
    val expected_generation = codec_handle_generation(handle)
    if slot < 0 or expected_generation <= 0:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    if _codec_active[slot].load(MemoryOrdering.SeqCst) != 1:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    if _codec_generation[slot].load(MemoryOrdering.SeqCst) != expected_generation:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    if _codec_capability[slot].load(MemoryOrdering.SeqCst) <= 0:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    val task = codec_current_task()
    if task > 0:
        if _codec_owner_task[slot].load(MemoryOrdering.SeqCst) != task:
            _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    else:
        if _codec_owner_task[slot].load(MemoryOrdering.SeqCst) != 0:
            _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
        val thread = codec_current_thread()
        if thread <= 0 or _codec_owner_thread[slot].load(MemoryOrdering.SeqCst) != thread:
            _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release)
    slot

# Rejection detail is derived exclusively from atomics, so wrong-thread and
# stale-handle diagnostics never race with mutable arena state.
pub fn rt_hal_codec_admission_error(handle: i64) -> RtHalCodecError:
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1: return RtHalCodecError.Inactive
    _codec_pool_readers.fetch_add(1, MemoryOrdering.AcqRel)
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release)
        return RtHalCodecError.Inactive
    val slot = codec_handle_slot(handle)
    val expected_generation = codec_handle_generation(handle)
    if slot < 0:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return RtHalCodecError.StaleHandle
    if _codec_active[slot].load(MemoryOrdering.SeqCst) != 1:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return RtHalCodecError.Inactive
    val generation = _codec_generation[slot].load(MemoryOrdering.SeqCst)
    if expected_generation != generation:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return RtHalCodecError.StaleHandle
    if _codec_capability[slot].load(MemoryOrdering.SeqCst) <= 0:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return RtHalCodecError.IdentityNotBound
    val thread = codec_current_thread()
    if (thread <= 0 or _codec_owner_thread[slot].load(MemoryOrdering.SeqCst) != thread or
        _codec_owner_task[slot].load(MemoryOrdering.SeqCst) != codec_current_task()):
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release)
        return RtHalCodecError.WrongOwner
    if (_codec_active[slot].load(MemoryOrdering.SeqCst) != 1 or
        _codec_generation[slot].load(MemoryOrdering.SeqCst) != generation):
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release)
        return RtHalCodecError.StaleHandle
    _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release)
    RtHalCodecError.None

fn codec_append_event(slot: i64, event: RtHalCodecEvent, argument: i64) -> bool:
    if _codec_error[codec_lane(slot)] != RtHalCodecError.None: return false
    if event != RtHalCodecEvent.RootBegin and _codec_root_state[codec_lane(slot)] != 1:
        return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    if _codec_event_count[codec_lane(slot)] >= RT_HAL_CODEC_MAX_EVENTS: return codec_fail(slot, RtHalCodecError.EventBound)
    _codec_event_tag[slot * RT_HAL_CODEC_MAX_EVENTS + _codec_event_count[codec_lane(slot)]] = codec_event_code(event)
    _codec_event_arg[slot * RT_HAL_CODEC_MAX_EVENTS + _codec_event_count[codec_lane(slot)]] = argument
    _codec_event_count[codec_lane(slot)] = _codec_event_count[codec_lane(slot)] + 1
    true

fn codec_value_completed(slot: i64) -> bool:
    if _codec_depth[codec_lane(slot)] <= 0: return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    val frame = _codec_depth[codec_lane(slot)] - 1
    if _codec_stack_observed[slot * RT_HAL_CODEC_MAX_DEPTH + frame] >= _codec_stack_expected[slot * RT_HAL_CODEC_MAX_DEPTH + frame]:
        return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    _codec_stack_observed[slot * RT_HAL_CODEC_MAX_DEPTH + frame] = _codec_stack_observed[slot * RT_HAL_CODEC_MAX_DEPTH + frame] + 1
    true

fn codec_enter(slot: i64, event: RtHalCodecEvent, argument: i64, expected_values: i64,
               end_event: RtHalCodecEvent, charge_elements: bool) -> bool:
    if argument < 0 or expected_values < 0: return codec_fail(slot, RtHalCodecError.InvalidArgument)
    if _codec_depth[codec_lane(slot)] >= RT_HAL_CODEC_MAX_DEPTH: return codec_fail(slot, RtHalCodecError.DepthBound)
    if charge_elements and expected_values > RT_HAL_CODEC_MAX_ELEMENTS - _codec_elements[codec_lane(slot)]:
        return codec_fail(slot, RtHalCodecError.ElementBound)
    if not codec_append_event(slot, event, argument): return false
    _codec_stack_end[slot * RT_HAL_CODEC_MAX_DEPTH + _codec_depth[codec_lane(slot)]] = codec_event_code(end_event)
    _codec_stack_expected[slot * RT_HAL_CODEC_MAX_DEPTH + _codec_depth[codec_lane(slot)]] = expected_values
    _codec_stack_observed[slot * RT_HAL_CODEC_MAX_DEPTH + _codec_depth[codec_lane(slot)]] = 0
    _codec_stack_byte_start[slot * RT_HAL_CODEC_MAX_DEPTH + _codec_depth[codec_lane(slot)]] = _codec_byte_count[codec_lane(slot)]
    _codec_depth[codec_lane(slot)] = _codec_depth[codec_lane(slot)] + 1
    if charge_elements: _codec_elements[codec_lane(slot)] = _codec_elements[codec_lane(slot)] + expected_values
    true

fn codec_leave(slot: i64, event: RtHalCodecEvent) -> bool:
    if _codec_depth[codec_lane(slot)] <= 0: return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    val frame = _codec_depth[codec_lane(slot)] - 1
    if _codec_stack_end[slot * RT_HAL_CODEC_MAX_DEPTH + frame] != codec_event_code(event):
        return codec_fail(slot, RtHalCodecError.TagMismatch)
    if _codec_stack_observed[slot * RT_HAL_CODEC_MAX_DEPTH + frame] != _codec_stack_expected[slot * RT_HAL_CODEC_MAX_DEPTH + frame]:
        return codec_fail(slot, RtHalCodecError.Incomplete)
    if not codec_append_event(slot, event, 0): return false
    _codec_depth[codec_lane(slot)] = _codec_depth[codec_lane(slot)] - 1
    if _codec_depth[codec_lane(slot)] > 0: return codec_value_completed(slot)
    true

fn codec_write_le(slot: i64, value: u64, width: i64) -> bool:
    if width < 0 or width > 8: return codec_fail(slot, RtHalCodecError.InvalidArgument)
    if width > RT_HAL_CODEC_MAX_BYTES - _codec_byte_count[codec_lane(slot)]: return codec_fail(slot, RtHalCodecError.ByteBound)
    var lane = 0
    while lane < width:
        _codec_bytes[slot * RT_HAL_CODEC_MAX_BYTES + _codec_byte_count[codec_lane(slot)]] = ((value >> (lane * 8)) and 0xff) as u8
        _codec_byte_count[codec_lane(slot)] = _codec_byte_count[codec_lane(slot)] + 1
        lane = lane + 1
    true

fn codec_scalar(slot: i64, event: RtHalCodecEvent, value: u64, width: i64) -> bool:
    if not codec_append_event(slot, event, width): return false
    if not codec_write_le(slot, value, width): return false
    codec_value_completed(slot)

# Cold owner install. The identity binding is deliberately dormant: no public
# API can mint these two published scalars. The future admitted identity owner
# must wire its generation and unforgeable scalar capability inside this owner
# module. Until then every install fails closed rather than trusting a caller
# supplied boolean.
pub(package) fn rt_hal_codec_identity_bind(identity_generation: i64,
                                            identity_capability: i64) -> bool:
    if identity_generation <= 0 or identity_capability <= 0: return false
    if not codec_pool_initialize(): return false
    if not _codec_identity_state.compare_exchange(0, -1, MemoryOrdering.SeqCst,
                                                   MemoryOrdering.SeqCst): return false
    _codec_identity_capability.store(identity_capability, MemoryOrdering.SeqCst)
    _codec_identity_generation.store(identity_generation, MemoryOrdering.SeqCst)
    _codec_identity_state.store(1, MemoryOrdering.SeqCst)
    true

pub(package) fn rt_hal_codec_identity_revoke(identity_generation: i64,
                                              identity_capability: i64) -> bool:
    if identity_generation <= 0 or identity_capability <= 0: return false
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1: return false
    if (_codec_identity_generation.load(MemoryOrdering.SeqCst) != identity_generation or
        _codec_identity_capability.load(MemoryOrdering.SeqCst) != identity_capability): return false
    if not _codec_identity_state.compare_exchange(1, -1, MemoryOrdering.SeqCst,
            MemoryOrdering.SeqCst): return false
    if _codec_install_inflight.load(MemoryOrdering.SeqCst) != 0:
        _codec_identity_state.store(1, MemoryOrdering.SeqCst); return false
    var slot = 0
    while slot < RT_HAL_CODEC_MAX_SLOTS:
        if _codec_active[slot].load(MemoryOrdering.SeqCst) != 0:
            _codec_identity_state.store(1, MemoryOrdering.SeqCst); return false
        slot = slot + 1
    # Keep the fixed pool initialized. Destroying it here adds unrelated
    # parent-batch/global-reader failure points after the last codec slot has
    # already been irreversibly released, and would also force cold realloc.
    _codec_identity_capability.store(0, MemoryOrdering.SeqCst)
    _codec_identity_generation.store(0, MemoryOrdering.SeqCst)
    _codec_identity_state.store(0, MemoryOrdering.SeqCst)
    true

pub(package) fn rt_hal_codec_owner_install(identity_generation: i64,
                                  identity_capability: i64) -> i64:
    if identity_generation <= 0 or identity_capability <= 0: return 0
    if _codec_identity_state.load(MemoryOrdering.SeqCst) != 1: return 0
    _codec_install_inflight.fetch_add(1, MemoryOrdering.AcqRel)
    if (_codec_identity_state.load(MemoryOrdering.SeqCst) != 1 or
        _codec_identity_generation.load(MemoryOrdering.SeqCst) != identity_generation or
        _codec_identity_capability.load(MemoryOrdering.SeqCst) != identity_capability):
        _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release); return 0
    if not codec_pool_initialize():
        _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release); return 0
    # Bounded cold admission examines at most 64 headers. The 65th concurrent
    # owner fails with handle zero. A released header may be reused, but its
    # persistent generation and capability both advance before publication.
    var slot = 0
    while (slot < RT_HAL_CODEC_MAX_SLOTS and
           not _codec_active[slot].compare_exchange(0, -1, MemoryOrdering.SeqCst,
                                                     MemoryOrdering.SeqCst)):
        slot = slot + 1
    if slot >= RT_HAL_CODEC_MAX_SLOTS:
        _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release); return 0
    if (_codec_identity_state.load(MemoryOrdering.SeqCst) != 1 or
        _codec_identity_generation.load(MemoryOrdering.SeqCst) != identity_generation or
        _codec_identity_capability.load(MemoryOrdering.SeqCst) != identity_capability):
        _codec_active[slot].store(0, MemoryOrdering.SeqCst)
        _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release); return 0
    val owner = codec_current_thread()
    if owner <= 0:
        _codec_active[slot].store(0, MemoryOrdering.SeqCst)
        _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release)
        return 0
    val task = codec_current_task()
    val generation = _codec_next_generation[slot]
    val codec_capability = _codec_next_capability[slot]
    if (generation <= 0 or
        generation >= (0x7fffffffffffffff - RT_HAL_CODEC_MAX_SLOTS) /
            RT_HAL_CODEC_MAX_SLOTS or
        codec_capability <= 0 or codec_capability >= 0x7fffffffffffffff):
        _codec_active[slot].store(0, MemoryOrdering.SeqCst)
        _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release)
        return 0
    _codec_next_generation[slot] = generation + 1
    _codec_next_capability[slot] = codec_capability + 1
    _codec_byte_count[codec_lane(slot)] = 0
    _codec_event_count[codec_lane(slot)] = 0
    _codec_depth[codec_lane(slot)] = 0
    _codec_elements[codec_lane(slot)] = 0
    _codec_utf8_remaining[codec_lane(slot)] = 0
    _codec_root_state[codec_lane(slot)] = 0
    _codec_decode_state[codec_lane(slot)] = 0
    _codec_decode_event[codec_lane(slot)] = 0
    _codec_decode_byte[codec_lane(slot)] = 0
    _codec_decode_arg[codec_lane(slot)] = 0
    _codec_decode_arg_pending[codec_lane(slot)] = 0
    _codec_snapshot_state[codec_lane(slot)] = 0
    _codec_snapshot_epoch[codec_lane(slot)] = 0
    _codec_snapshot_capability[codec_lane(slot)] = 0
    _codec_committed_ordinal[codec_lane(slot)] = -1
    _codec_admitted_root0[codec_lane(slot)] = 0
    _codec_admitted_root1[codec_lane(slot)] = 0
    _codec_admitted_root2[codec_lane(slot)] = 0
    _codec_admitted_root3[codec_lane(slot)] = 0
    _codec_admitted_root4[codec_lane(slot)] = 0
    _codec_schema0[codec_lane(slot)] = 0
    _codec_schema1[codec_lane(slot)] = 0
    _codec_schema2[codec_lane(slot)] = 0
    _codec_schema3[codec_lane(slot)] = 0
    _codec_schema4[codec_lane(slot)] = 0
    _codec_schema_ready[codec_lane(slot)] = 0
    _codec_hot_active[codec_lane(slot)] = 0
    _codec_hot_generation[codec_lane(slot)] = generation
    _codec_hot_capability[codec_lane(slot)] = 0
    _codec_hot_cursor[codec_lane(slot)] = 0
    _codec_error[codec_lane(slot)] = RtHalCodecError.None
    _codec_owner_thread[slot].store(owner, MemoryOrdering.SeqCst)
    _codec_owner_task[slot].store(task, MemoryOrdering.SeqCst)
    _codec_generation[slot].store(generation, MemoryOrdering.SeqCst)
    _codec_hot_capability[codec_lane(slot)] = codec_capability
    _codec_hot_active[codec_lane(slot)] = 1
    _codec_capability[slot].store(codec_capability, MemoryOrdering.SeqCst)
    _codec_lease[slot].store(0, MemoryOrdering.SeqCst)
    _codec_readers[slot].store(0, MemoryOrdering.SeqCst)
    _codec_active[slot].store(1, MemoryOrdering.SeqCst)
    _codec_install_inflight.fetch_sub(1, MemoryOrdering.Release)
    codec_handle(slot, generation)

# Cold release first closes atomic admission. It may only run on the owner
# thread, which is also the sole mutable-slot user; therefore no admitted
# mutation can remain in flight when this call starts.
pub(package) fn rt_hal_codec_owner_release(handle_generation: i64) -> bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    if (_codec_hot_cursor[codec_lane(slot)] != 0 or
        _codec_lease[slot].load(MemoryOrdering.SeqCst) != 0 or
        _codec_readers[slot].load(MemoryOrdering.SeqCst) != 0): return false
    if not _codec_active[slot].compare_exchange(1, -1, MemoryOrdering.SeqCst,
                                                MemoryOrdering.SeqCst): return false
    if _codec_readers[slot].load(MemoryOrdering.SeqCst) != 0:
        _codec_active[slot].store(1, MemoryOrdering.SeqCst); return false
    _codec_hot_active[codec_lane(slot)] = 0
    _codec_hot_cursor[codec_lane(slot)] = 0
    _codec_capability[slot].store(0, MemoryOrdering.SeqCst)
    _codec_owner_thread[slot].store(0, MemoryOrdering.SeqCst)
    _codec_owner_task[slot].store(0, MemoryOrdering.SeqCst)
    _codec_snapshot_state[codec_lane(slot)] = 2
    _codec_snapshot_epoch[codec_lane(slot)] = 0
    _codec_snapshot_capability[codec_lane(slot)] = 0
    _codec_active[slot].store(0, MemoryOrdering.SeqCst)
    true

pub fn rt_hal_codec_error(handle_generation: i64) -> RtHalCodecError:
    val admission_problem = rt_hal_codec_admission_error(handle_generation)
    if admission_problem != RtHalCodecError.None: return admission_problem
    val slot = codec_handle_slot(handle_generation)
    _codec_error[codec_lane(slot)]

pub(package) fn rt_hal_codec_admit_five_roots(handle_generation:i64,
        identity_generation: i64,identity_capability:i64,operation:i64,input:i64,
        output: i64,error:i64,effect:i64) ->bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    if (identity_generation != _codec_identity_generation.load(MemoryOrdering.SeqCst) or
        identity_capability != _codec_identity_capability.load(MemoryOrdering.SeqCst)): return false
    if operation<=0 or input<=0 or output<=0 or error<=0 or effect<=0:return false
    if _codec_root_state[codec_lane(slot)] != 0 or _codec_event_count[codec_lane(slot)] != 0: return false
    if (_codec_admitted_root0[codec_lane(slot)]!=0 or _codec_admitted_root1[codec_lane(slot)]!=0 or
        _codec_admitted_root2[codec_lane(slot)]!=0 or _codec_admitted_root3[codec_lane(slot)]!=0 or
        _codec_admitted_root4[codec_lane(slot)]!=0): return false
    _codec_admitted_root0[codec_lane(slot)]=operation;_codec_admitted_root1[codec_lane(slot)]=input;_codec_admitted_root2[codec_lane(slot)]=output
    _codec_admitted_root3[codec_lane(slot)]=error;_codec_admitted_root4[codec_lane(slot)]=effect
    true

# A root ID alone is not a shape proof. The frozen identity/shape owner binds
# five positive immutable program receipts in one package-private operation.
# Until that owner supplies all receipts, begin_root fails closed.
pub(package) fn rt_hal_codec_admit_five_schema_receipts(handle_generation: i64,
        identity_generation: i64, identity_capability: i64,
        operation_schema: i64, input_schema: i64, output_schema: i64,
        error_schema: i64, effect_schema: i64) -> bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    if (identity_generation != _codec_identity_generation.load(MemoryOrdering.SeqCst) or
        identity_capability != _codec_identity_capability.load(MemoryOrdering.SeqCst) or
        operation_schema <= 0 or input_schema <= 0 or output_schema <= 0 or
        error_schema <= 0 or effect_schema <= 0): return false
    if (_codec_root_state[codec_lane(slot)] != 0 or _codec_event_count[codec_lane(slot)] != 0 or
        _codec_admitted_root0[codec_lane(slot)] <= 0 or _codec_admitted_root1[codec_lane(slot)] <= 0 or
        _codec_admitted_root2[codec_lane(slot)] <= 0 or _codec_admitted_root3[codec_lane(slot)] <= 0 or
        _codec_admitted_root4[codec_lane(slot)] <= 0): return false
    _codec_schema0[codec_lane(slot)] = operation_schema
    _codec_schema1[codec_lane(slot)] = input_schema
    _codec_schema2[codec_lane(slot)] = output_schema
    _codec_schema3[codec_lane(slot)] = error_schema
    _codec_schema4[codec_lane(slot)] = effect_schema
    # This package hook is callable only by the shape-program owner after its
    # complete five-program compile. Owner-thread sequencing publishes the
    # immutable program state before control returns to any worker.
    _codec_schema_ready[codec_lane(slot)] = 1
    true

# Cold transaction rollback for identity + shape publication.  No executing
# worker can reach this path because the first root/event makes it fail closed.
pub(package) fn rt_hal_codec_clear_five_admission(handle_generation:i64,
        identity_generation: i64,identity_capability:i64) ->bool:
    val slot=codec_admit(handle_generation)
    if slot<0:return false
    if (identity_generation!=_codec_identity_generation.load(MemoryOrdering.SeqCst) or
        identity_capability!=_codec_identity_capability.load(MemoryOrdering.SeqCst) or
        _codec_root_state[codec_lane(slot)]!=0 or _codec_event_count[codec_lane(slot)]!=0):return false
    _codec_admitted_root0[codec_lane(slot)]=0;_codec_admitted_root1[codec_lane(slot)]=0;_codec_admitted_root2[codec_lane(slot)]=0
    _codec_admitted_root3[codec_lane(slot)]=0;_codec_admitted_root4[codec_lane(slot)]=0
    _codec_schema0[codec_lane(slot)]=0;_codec_schema1[codec_lane(slot)]=0;_codec_schema2[codec_lane(slot)]=0
    _codec_schema3[codec_lane(slot)]=0;_codec_schema4[codec_lane(slot)]=0
    _codec_schema_ready[codec_lane(slot)]=0
    true

fn codec_root_id_admitted(slot: i64, domain: RtHalCodecRootDomain,scalar_type_id: i64) ->bool:
    match domain:
        case Operation: _codec_admitted_root0[codec_lane(slot)]==scalar_type_id
        case Input: _codec_admitted_root1[codec_lane(slot)]==scalar_type_id
        case Output: _codec_admitted_root2[codec_lane(slot)]==scalar_type_id
        case Error: _codec_admitted_root3[codec_lane(slot)]==scalar_type_id
        case Effect: _codec_admitted_root4[codec_lane(slot)]==scalar_type_id

fn codec_root_domain_code(domain: RtHalCodecRootDomain) -> i64:
    match domain:
        case Operation: 1
        case Input: 2
        case Output: 3
        case Error: 4
        case Effect: 5

fn codec_root_schema(slot: i64, domain: RtHalCodecRootDomain) -> i64:
    match domain:
        case Operation: _codec_schema0[codec_lane(slot)]
        case Input: _codec_schema1[codec_lane(slot)]
        case Output: _codec_schema2[codec_lane(slot)]
        case Error: _codec_schema3[codec_lane(slot)]
        case Effect: _codec_schema4[codec_lane(slot)]

pub(package) fn rt_hal_codec_begin_root(handle_generation:i64,domain:RtHalCodecRootDomain,
                               scalar_type_id: i64) ->bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    if scalar_type_id <= 0 or not codec_root_id_admitted(slot, domain,scalar_type_id):
        return codec_fail(slot, RtHalCodecError.IdentityNotBound)
    if codec_root_schema(slot, domain) <= 0 or _codec_schema_ready[codec_lane(slot)] != 1:
        return codec_fail(slot, RtHalCodecError.IdentityNotBound)
    if _codec_root_state[codec_lane(slot)] != 0 or _codec_depth[codec_lane(slot)] != 0 or _codec_event_count[codec_lane(slot)] != 0:
        return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    if scalar_type_id > 0xffffffff: return codec_fail(slot, RtHalCodecError.IdentityNotBound)
    val root_argument = (codec_root_domain_code(domain) << 32) | scalar_type_id
    if not codec_enter(slot, RtHalCodecEvent.RootBegin, root_argument, 1,
                       RtHalCodecEvent.RootEnd, false): return false
    _codec_root_state[codec_lane(slot)] = 1
    true

fn codec_hot_lease_slot(lease: RtHalCodecHotLease) -> i64:
    val slot = lease._slot
    if slot < 0 or slot >= RT_HAL_CODEC_MAX_SLOTS: return -1
    # A stale package-private lease may outlive last-unbind arena retirement.
    # Reject it before indexing the reclaimed scalar mirrors.
    if _codec_hot_active.len() != RT_HAL_CODEC_MAX_SLOTS * RT_HAL_CODEC_SLOT_STRIDE:
        return -1
    val lane = codec_lane(slot)
    if (_codec_hot_active[lane] != 1 or
        _codec_hot_generation[lane] != lease._generation or
        _codec_hot_capability[lane] != lease._capability or
        _codec_hot_cursor[lane] != 1): return -1
    slot

pub(package) fn rt_hal_codec_hot_lease_begin(handle_generation: i64,
        domain: RtHalCodecRootDomain, scalar_type_id: i64) -> RtHalCodecHotLease:
    val candidate_slot=codec_handle_slot(handle_generation)
    if (candidate_slot<0 or
        _codec_hot_cursor.len()!=RT_HAL_CODEC_MAX_SLOTS*RT_HAL_CODEC_SLOT_STRIDE or
        _codec_hot_cursor[codec_lane(candidate_slot)]!=0):
        return codec_invalid_hot_lease()
    if not rt_hal_codec_begin_root(handle_generation, domain, scalar_type_id):
        return codec_invalid_hot_lease()
    val slot = codec_handle_slot(handle_generation)
    val lane = codec_lane(slot)
    _codec_hot_cursor[lane]=1
    RtHalCodecHotLease(_slot: slot, _generation: _codec_hot_generation[lane],
        _capability: _codec_hot_capability[lane])

pub(package) fn rt_hal_codec_hot_lease_valid(lease: RtHalCodecHotLease) -> bool:
    codec_hot_lease_slot(lease)>=0

# Generic validated-slot mutation for the authoritative shape cursor. The
# cursor maps its precompiled opcode to this event after schema validation.
# No atomic, allocation, pool-reader RMW, or thread/task query occurs here.
pub(package) fn rt_hal_codec_hot_apply(lease: RtHalCodecHotLease,
        event: RtHalCodecEvent, argument: i64, bits: u64) -> bool:
    val slot = codec_hot_lease_slot(lease)
    if slot < 0: return false
    match event:
        case TupleBegin:
            codec_enter(slot, event, argument, argument, RtHalCodecEvent.TupleEnd, true)
        case TupleEnd: codec_leave(slot, event)
        case ArrayBegin:
            codec_enter(slot, event, argument, argument, RtHalCodecEvent.ArrayEnd, true)
        case ArrayEnd: codec_leave(slot, event)
        case ResultOkBegin:
            codec_enter(slot, event, 1, 1, RtHalCodecEvent.ResultOkEnd, true)
        case ResultOkEnd: codec_leave(slot, event)
        case ResultErrBegin:
            codec_enter(slot, event, 1, 1, RtHalCodecEvent.ResultErrEnd, true)
        case ResultErrEnd: codec_leave(slot, event)
        case Unit:
            if not codec_append_event(slot, event, 0): false else: codec_value_completed(slot)
        case Bool:
            if bits > 1u64: codec_fail(slot, RtHalCodecError.InvalidArgument)
            else: codec_scalar(slot, event, bits, 1)
        case I8: codec_scalar(slot, event, bits, 1)
        case I16: codec_scalar(slot, event, bits, 2)
        case I32: codec_scalar(slot, event, bits, 4)
        case I64: codec_scalar(slot, event, bits, 8)
        case U8: codec_scalar(slot, event, bits, 1)
        case U16: codec_scalar(slot, event, bits, 2)
        case U32: codec_scalar(slot, event, bits, 4)
        case U64: codec_scalar(slot, event, bits, 8)
        case F32: codec_scalar(slot, event, bits, 4)
        case F64: codec_scalar(slot, event, bits, 8)
        case BytesBegin:
            if argument > RT_HAL_CODEC_MAX_BYTES - _codec_byte_count[codec_lane(slot)]:
                codec_fail(slot, RtHalCodecError.ByteBound)
            else: codec_enter(slot, event, argument, 0, RtHalCodecEvent.BytesEnd, true)
        case BytesEnd:
            val lane = codec_lane(slot)
            if _codec_depth[lane] <= 0: codec_fail(slot, RtHalCodecError.ShapeMismatch)
            else:
                val frame = _codec_depth[lane] - 1
                val declared = _codec_event_arg[slot * RT_HAL_CODEC_MAX_EVENTS + _codec_event_count[lane] - 1]
                if _codec_byte_count[lane] - _codec_stack_byte_start[slot * RT_HAL_CODEC_MAX_DEPTH + frame] != declared:
                    codec_fail(slot, RtHalCodecError.Incomplete)
                else: codec_leave(slot, event)
        case Utf8Begin:
            val lane = codec_lane(slot)
            _codec_utf8_remaining[lane] = 0; _codec_utf8_lane[lane] = 0
            if argument > RT_HAL_CODEC_MAX_BYTES - _codec_byte_count[lane]:
                codec_fail(slot, RtHalCodecError.ByteBound)
            else: codec_enter(slot, event, argument, 0, RtHalCodecEvent.Utf8End, true)
        case Utf8End:
            val lane = codec_lane(slot)
            if _codec_utf8_remaining[lane] != 0: codec_fail(slot, RtHalCodecError.InvalidUtf8)
            elif _codec_depth[lane] <= 0: codec_fail(slot, RtHalCodecError.ShapeMismatch)
            else:
                val frame = _codec_depth[lane] - 1
                val declared = _codec_event_arg[slot * RT_HAL_CODEC_MAX_EVENTS + _codec_event_count[lane] - 1]
                if _codec_byte_count[lane] - _codec_stack_byte_start[slot * RT_HAL_CODEC_MAX_DEPTH + frame] != declared:
                    codec_fail(slot, RtHalCodecError.Incomplete)
                else: codec_leave(slot, event)
        case RootBegin: codec_fail(slot, RtHalCodecError.ShapeMismatch)
        case RootEnd: codec_fail(slot, RtHalCodecError.ShapeMismatch)

pub(package) fn rt_hal_codec_hot_write_byte(lease: RtHalCodecHotLease,
        value: u8, utf8: bool) -> bool:
    val slot = codec_hot_lease_slot(lease)
    if slot < 0: return false
    val lane = codec_lane(slot)
    val expected_end = if utf8: RtHalCodecEvent.Utf8End else: RtHalCodecEvent.BytesEnd
    if (_codec_depth[lane] <= 0 or
        _codec_stack_end[slot * RT_HAL_CODEC_MAX_DEPTH + _codec_depth[lane] - 1] !=
            codec_event_code(expected_end)):
        return codec_fail(slot, RtHalCodecError.TagMismatch)
    val frame = _codec_depth[lane] - 1
    val declared = _codec_event_arg[slot * RT_HAL_CODEC_MAX_EVENTS + _codec_event_count[lane] - 1]
    if _codec_byte_count[lane] - _codec_stack_byte_start[slot * RT_HAL_CODEC_MAX_DEPTH + frame] >= declared:
        return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    if utf8:
        val byte = value as i64
        if _codec_utf8_remaining[lane] == 0:
            if byte <= 0x7f: pass_do_nothing("ASCII code unit is complete")
            elif byte >= 0xc2 and byte <= 0xdf:
                _codec_utf8_remaining[lane] = 1; _codec_utf8_min_second[lane] = 0x80
                _codec_utf8_max_second[lane] = 0xbf; _codec_utf8_lane[lane] = 0
            elif byte >= 0xe0 and byte <= 0xef:
                _codec_utf8_remaining[lane] = 2
                _codec_utf8_min_second[lane] = if byte == 0xe0: 0xa0 else: 0x80
                _codec_utf8_max_second[lane] = if byte == 0xed: 0x9f else: 0xbf
                _codec_utf8_lane[lane] = 0
            elif byte >= 0xf0 and byte <= 0xf4:
                _codec_utf8_remaining[lane] = 3
                _codec_utf8_min_second[lane] = if byte == 0xf0: 0x90 else: 0x80
                _codec_utf8_max_second[lane] = if byte == 0xf4: 0x8f else: 0xbf
                _codec_utf8_lane[lane] = 0
            else: return codec_fail(slot, RtHalCodecError.InvalidUtf8)
        else:
            val minimum = if _codec_utf8_lane[lane] == 0: _codec_utf8_min_second[lane] else: 0x80
            val maximum = if _codec_utf8_lane[lane] == 0: _codec_utf8_max_second[lane] else: 0xbf
            if byte < minimum or byte > maximum: return codec_fail(slot, RtHalCodecError.InvalidUtf8)
            _codec_utf8_remaining[lane] = _codec_utf8_remaining[lane] - 1
            _codec_utf8_lane[lane] = _codec_utf8_lane[lane] + 1
    codec_write_le(slot, value as u64, 1)

pub(package) fn rt_hal_codec_hot_lease_finish(lease: RtHalCodecHotLease) -> bool:
    val slot = codec_hot_lease_slot(lease)
    if slot < 0: return false
    val lane = codec_lane(slot)
    if _codec_root_state[lane] != 1 or _codec_depth[lane] != 1:
        return codec_fail(slot, RtHalCodecError.Incomplete)
    if not codec_leave(slot, RtHalCodecEvent.RootEnd): return false
    _codec_root_state[lane] = 2
    _codec_hot_cursor[lane]=0
    true

pub(package) fn rt_hal_codec_hot_lease_abort(lease: RtHalCodecHotLease) -> bool:
    val slot=codec_hot_lease_slot(lease)
    if slot<0:return false
    _codec_hot_cursor[codec_lane(slot)]=0;true

# Sequential scalar cursor API for complete zero-copy decode/traversal by the
# owner. The execution-domain binding is a multi-call lease: only the installing
# task/thread pair may advance it. Rewind is one-shot per generation.
pub fn rt_hal_codec_rewind(handle_generation: i64) -> bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    if _codec_root_state[codec_lane(slot)] != 2 or _codec_depth[codec_lane(slot)] != 0 or _codec_error[codec_lane(slot)] != RtHalCodecError.None: return false
    if _codec_snapshot_state[codec_lane(slot)] != 0: return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    if _codec_decode_state[codec_lane(slot)] != 0: return codec_fail(slot, RtHalCodecError.ShapeMismatch)
    _codec_decode_event[codec_lane(slot)] = 0
    _codec_decode_byte[codec_lane(slot)] = 0
    _codec_decode_arg[codec_lane(slot)] = 0
    _codec_decode_arg_pending[codec_lane(slot)] = 0
    _codec_decode_state[codec_lane(slot)] = 1
    true

pub fn rt_hal_codec_event_count(handle_generation: i64) -> i64:
    val slot = codec_admit(handle_generation)
    if slot < 0: return -1
    _codec_event_count[codec_lane(slot)]

pub fn rt_hal_codec_byte_count(handle_generation: i64) -> i64:
    val slot = codec_admit(handle_generation)
    if slot < 0: return -1
    _codec_byte_count[codec_lane(slot)]

pub fn rt_hal_codec_decode_next_event_tag(handle_generation: i64) -> i64:
    val slot = codec_admit(handle_generation)
    if slot < 0: return -1
    if _codec_decode_arg_pending[codec_lane(slot)] != 0: return -1
    if _codec_decode_state[codec_lane(slot)] != 1 or _codec_decode_event[codec_lane(slot)] >= _codec_event_count[codec_lane(slot)]:
        return -1
    val index = _codec_decode_event[codec_lane(slot)]
    _codec_decode_event[codec_lane(slot)] = _codec_decode_event[codec_lane(slot)] + 1
    _codec_decode_arg[codec_lane(slot)] = _codec_event_arg[slot * RT_HAL_CODEC_MAX_EVENTS + index]
    _codec_decode_arg_pending[codec_lane(slot)] = 1
    _codec_event_tag[slot * RT_HAL_CODEC_MAX_EVENTS + index]

pub fn rt_hal_codec_decode_take_event_arg(handle_generation: i64) -> i64:
    val slot = codec_admit(handle_generation)
    if slot < 0: return -1
    if (_codec_decode_state[codec_lane(slot)] != 1 or
        _codec_decode_arg_pending[codec_lane(slot)] != 1): return -1
    _codec_decode_arg_pending[codec_lane(slot)] = 0
    _codec_decode_arg[codec_lane(slot)]

pub fn rt_hal_codec_decode_next_byte(handle_generation: i64) -> i64:
    val slot = codec_admit(handle_generation)
    if slot < 0: return -1
    if _codec_decode_state[codec_lane(slot)] != 1 or _codec_decode_byte[codec_lane(slot)] >= _codec_byte_count[codec_lane(slot)]: return -1
    val index = _codec_decode_byte[codec_lane(slot)]
    _codec_decode_byte[codec_lane(slot)] = _codec_decode_byte[codec_lane(slot)] + 1
    _codec_bytes[slot * RT_HAL_CODEC_MAX_BYTES + index] as i64

pub fn rt_hal_codec_finish_decode(handle_generation: i64) -> bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    if _codec_decode_state[codec_lane(slot)] != 1: return false
    if (_codec_decode_arg_pending[codec_lane(slot)] != 0 or
        _codec_decode_event[codec_lane(slot)] != _codec_event_count[codec_lane(slot)] or
        _codec_decode_byte[codec_lane(slot)] != _codec_byte_count[codec_lane(slot)]):
        return codec_fail(slot, RtHalCodecError.Incomplete)
    _codec_decode_state[codec_lane(slot)] = 2
    true

pub fn rt_hal_codec_complete(handle_generation: i64) -> bool:
    val slot = codec_admit(handle_generation)
    if slot < 0: return false
    _codec_error[codec_lane(slot)] == RtHalCodecError.None and _codec_root_state[codec_lane(slot)] == 2 and _codec_depth[codec_lane(slot)] == 0 and
        _codec_event_count[codec_lane(slot)] >= 2 and _codec_event_tag[slot * RT_HAL_CODEC_MAX_EVENTS + 0] == codec_event_code(RtHalCodecEvent.RootBegin) and
        _codec_event_tag[slot * RT_HAL_CODEC_MAX_EVENTS + _codec_event_count[codec_lane(slot)] - 1] == codec_event_code(RtHalCodecEvent.RootEnd)

# Finalize exactly one scalar-reader snapshot for this codec generation. This
# freezes traversal: rewind/decode cannot begin after publication. Storage is
# not copied; counts and indexed reads remain bound to generation, capability,
# execution domain, and a monotonically issued snapshot epoch.
pub fn rt_hal_codec_snapshot_finalize(handle_generation: i64) -> RtHalExactIoCodecSnapshot:
    val slot = codec_admit(handle_generation)
    if slot < 0: return codec_invalid_snapshot()
    if not rt_hal_codec_complete(handle_generation): return codec_invalid_snapshot()
    if _codec_snapshot_state[codec_lane(slot)] != 0: return codec_invalid_snapshot()
    if _codec_decode_state[codec_lane(slot)] != 0 and _codec_decode_state[codec_lane(slot)] != 2: return codec_invalid_snapshot()
    if _codec_next_snapshot_epoch[codec_lane(slot)] <= 0 or _codec_next_snapshot_epoch[codec_lane(slot)] >= 0x7fffffffffffffff:
        return codec_invalid_snapshot()
    if _codec_next_snapshot_capability[codec_lane(slot)] <= 0 or _codec_next_snapshot_capability[codec_lane(slot)] >= 0x7fffffffffffffff:
        return codec_invalid_snapshot()
    val epoch = _codec_next_snapshot_epoch[codec_lane(slot)]
    val capability = codec_mix_capability(
        _codec_capability[slot].load(MemoryOrdering.SeqCst),
        codec_handle_generation(handle_generation), slot, epoch)
    _codec_next_snapshot_epoch[codec_lane(slot)] = epoch + 1
    _codec_next_snapshot_capability[codec_lane(slot)] = _codec_next_snapshot_capability[codec_lane(slot)] + 1
    _codec_snapshot_epoch[codec_lane(slot)] = epoch
    _codec_snapshot_capability[codec_lane(slot)] = capability
    _codec_snapshot_state[codec_lane(slot)] = 1
    _codec_lease[slot].store(capability, MemoryOrdering.SeqCst)
    RtHalExactIoCodecSnapshot(_slot: slot, _codec_generation: codec_handle_generation(handle_generation),
        _codec_capability: _codec_capability[slot].load(MemoryOrdering.SeqCst),
        _snapshot_epoch: epoch, _snapshot_capability: capability)

fn codec_snapshot_pin(snapshot: RtHalExactIoCodecSnapshot) -> i64:
    # Pin increments readers before validating the terminal lease. Commit or
    # release first changes that lease away from the snapshot capability, so
    # later pins roll back and terminal mutation waits for prior pins to drain.
    val slot = snapshot._slot
    if (slot < 0 or slot >= RT_HAL_CODEC_MAX_SLOTS or
        snapshot._codec_generation <= 0 or snapshot._codec_capability <= 0 or
        snapshot._snapshot_capability <= 0): return -1
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1: return -1
    _codec_pool_readers.fetch_add(1, MemoryOrdering.AcqRel)
    if _codec_pool_ready.load(MemoryOrdering.SeqCst) != 1:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    if _codec_active[slot].load(MemoryOrdering.SeqCst) != 1:
        _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release); return -1
    val prior = _codec_readers[slot].fetch_add(1, MemoryOrdering.AcqRel)
    _codec_pool_readers.fetch_sub(1, MemoryOrdering.Release)
    if prior < 0 or prior >= 0x7ffffffffffffffe:
        _codec_readers[slot].fetch_sub(1, MemoryOrdering.Release); return -1
    if (_codec_active[slot].load(MemoryOrdering.SeqCst) != 1 or
        _codec_generation[slot].load(MemoryOrdering.SeqCst) != snapshot._codec_generation or
        _codec_capability[slot].load(MemoryOrdering.SeqCst) != snapshot._codec_capability or
        _codec_lease[slot].load(MemoryOrdering.SeqCst) != snapshot._snapshot_capability):
        _codec_readers[slot].fetch_sub(1, MemoryOrdering.Release); return -1
    slot

fn codec_snapshot_unpin(slot: i64):
    _codec_readers[slot].fetch_sub(1, MemoryOrdering.Release)

pub fn rt_hal_codec_snapshot_span(snapshot: RtHalExactIoCodecSnapshot) -> RtHalExactIoCodecSpan:
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return codec_invalid_span()
    val result = RtHalExactIoCodecSpan(event_offset: 0, event_count: _codec_event_count[codec_lane(slot)],
        byte_offset: 0, byte_length: _codec_byte_count[codec_lane(slot)])
    codec_snapshot_unpin(slot); result

pub fn rt_hal_codec_snapshot_event_tag_at(snapshot: RtHalExactIoCodecSnapshot,
                                           index: i64) -> i64:
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return -1
    var result = -1
    if index >= 0 and index < _codec_event_count[codec_lane(slot)]:
        result = _codec_event_tag[slot * RT_HAL_CODEC_MAX_EVENTS + index]
    codec_snapshot_unpin(slot); result

pub fn rt_hal_codec_snapshot_event_arg_at(snapshot: RtHalExactIoCodecSnapshot,
                                           index: i64) -> i64:
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return -1
    var result = -1
    if index >= 0 and index < _codec_event_count[codec_lane(slot)]:
        result = _codec_event_arg[slot * RT_HAL_CODEC_MAX_EVENTS + index]
    codec_snapshot_unpin(slot); result

pub fn rt_hal_codec_snapshot_byte_at(snapshot: RtHalExactIoCodecSnapshot,
                                      index: i64) -> i64:
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return -1
    var result = -1
    if index >= 0 and index < _codec_byte_count[codec_lane(slot)]:
        result = _codec_bytes[slot * RT_HAL_CODEC_MAX_BYTES + index] as i64
    codec_snapshot_unpin(slot); result

pub fn rt_hal_codec_snapshot_error(snapshot: RtHalExactIoCodecSnapshot) -> RtHalCodecError:
    val slot = codec_snapshot_pin(snapshot)
    if slot >= 0:
        codec_snapshot_unpin(slot); return RtHalCodecError.None
    if snapshot._codec_generation <= 0 or snapshot._snapshot_epoch <= 0:
        return RtHalCodecError.Inactive
    RtHalCodecError.StaleHandle

fn codec_compare_i64(left: i64, right: i64) -> i64:
    if left < right: return -1
    if left > right: return 1
    0

# Parent-authoritative comparison pins both frozen child results in ascending
# slot order. It is O(events + bytes), allocation-free, and never mutates a
# child transcript. -2 denotes an invalid/stale lease.
pub fn rt_hal_codec_parent_snapshot_compare(left: RtHalExactIoCodecSnapshot,
                                             right: RtHalExactIoCodecSnapshot) -> i64:
    var first = left
    var second = right
    var swapped = false
    if right._slot < left._slot:
        first = right; second = left; swapped = true
    val first_slot = codec_snapshot_pin(first)
    if first_slot < 0: return -2
    var second_slot = first_slot
    val same = (first._slot == second._slot and
        first._codec_generation == second._codec_generation and
        first._snapshot_capability == second._snapshot_capability)
    if not same:
        second_slot = codec_snapshot_pin(second)
        if second_slot < 0:
            codec_snapshot_unpin(first_slot); return -2
    var result = codec_compare_i64(_codec_event_count[codec_lane(first_slot)], _codec_event_count[codec_lane(second_slot)])
    var index = 0
    while result == 0 and index < _codec_event_count[codec_lane(first_slot)]:
        result = codec_compare_i64(
            _codec_event_tag[first_slot * RT_HAL_CODEC_MAX_EVENTS + index],
            _codec_event_tag[second_slot * RT_HAL_CODEC_MAX_EVENTS + index])
        if result == 0:
            result = codec_compare_i64(
                _codec_event_arg[first_slot * RT_HAL_CODEC_MAX_EVENTS + index],
                _codec_event_arg[second_slot * RT_HAL_CODEC_MAX_EVENTS + index])
        index = index + 1
    if result == 0:
        result = codec_compare_i64(_codec_byte_count[codec_lane(first_slot)], _codec_byte_count[codec_lane(second_slot)])
    index = 0
    while result == 0 and index < _codec_byte_count[codec_lane(first_slot)]:
        result = codec_compare_i64(
            _codec_bytes[first_slot * RT_HAL_CODEC_MAX_BYTES + index] as i64,
            _codec_bytes[second_slot * RT_HAL_CODEC_MAX_BYTES + index] as i64)
        index = index + 1
    if not same: codec_snapshot_unpin(second_slot)
    codec_snapshot_unpin(first_slot)
    if swapped: -result else: result

# Deterministic parent commit consumes one frozen child result. The ordinal is
# strictly increasing per slot, preventing replay. A racing reader makes the
# commit fail closed; callers retry at their deterministic parent barrier.
pub fn rt_hal_codec_parent_snapshot_commit(snapshot: RtHalExactIoCodecSnapshot,
                                            ordinal: i64) -> bool:
    if ordinal < 0: return false
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return false
    codec_snapshot_unpin(slot)
    if not _codec_lease[slot].compare_exchange(snapshot._snapshot_capability,
            -snapshot._snapshot_capability, MemoryOrdering.SeqCst,
            MemoryOrdering.SeqCst): return false
    if _codec_readers[slot].load(MemoryOrdering.SeqCst) != 0:
        _codec_lease[slot].store(snapshot._snapshot_capability, MemoryOrdering.SeqCst)
        return false
    if ordinal <= _codec_committed_ordinal[codec_lane(slot)]:
        _codec_lease[slot].store(snapshot._snapshot_capability, MemoryOrdering.SeqCst)
        return false
    _codec_committed_ordinal[codec_lane(slot)] = ordinal
    _codec_snapshot_state[codec_lane(slot)] = 2
    _codec_snapshot_epoch[codec_lane(slot)] = 0
    _codec_snapshot_capability[codec_lane(slot)] = 0
    _codec_lease[slot].store(0, MemoryOrdering.SeqCst)
    true

fn codec_parent_snapshot_at(index: i64) -> RtHalExactIoCodecSnapshot:
    RtHalExactIoCodecSnapshot(_slot: _codec_parent_slot[index],
        _codec_generation: _codec_parent_generation[index],
        _codec_capability: _codec_parent_codec_capability[index],
        _snapshot_epoch: _codec_parent_snapshot_epoch[index],
        _snapshot_capability: _codec_parent_snapshot_capability[index])

pub(package) fn rt_hal_codec_parent_batch_begin(expected_children: i64) -> i64:
    if expected_children <= 0 or expected_children > RT_HAL_CODEC_MAX_SLOTS: return 0
    if not _codec_parent_batch_state.compare_exchange(0, -1, MemoryOrdering.SeqCst,
            MemoryOrdering.SeqCst): return 0
    val owner_thread = codec_current_thread()
    if owner_thread <= 0:
        _codec_parent_batch_state.store(0, MemoryOrdering.SeqCst); return 0
    if _codec_parent_next_epoch <= 0 or _codec_parent_next_epoch >= 0x7fffffffffffffff:
        _codec_parent_batch_state.store(0, MemoryOrdering.SeqCst); return 0
    val token = _codec_parent_next_epoch
    _codec_parent_next_epoch = token + 1
    _codec_parent_batch_token = token
    _codec_parent_batch_expected = expected_children
    _codec_parent_batch_count = 0
    _codec_parent_owner_thread.store(owner_thread, MemoryOrdering.SeqCst)
    _codec_parent_owner_task.store(codec_current_task(), MemoryOrdering.SeqCst)
    _codec_parent_batch_state.store(token, MemoryOrdering.SeqCst)
    token

pub(package) fn rt_hal_codec_parent_batch_add(token: i64, index: i64,
        snapshot: RtHalExactIoCodecSnapshot, ordinal: i64) -> bool:
    if (token <= 0 or ordinal < 0 or index < 0 or
        index >= _codec_parent_batch_expected): return false
    if (_codec_parent_batch_state.load(MemoryOrdering.SeqCst) != token or
        _codec_parent_batch_token != token or index != _codec_parent_batch_count): return false
    if (_codec_parent_owner_thread.load(MemoryOrdering.SeqCst) != codec_current_thread() or
        _codec_parent_owner_task.load(MemoryOrdering.SeqCst) != codec_current_task()): return false
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return false
    var prior = 0
    while prior < index:
        if _codec_parent_slot[prior] == slot:
            codec_snapshot_unpin(slot); return false
        prior = prior + 1
    if index > 0 and ordinal <= _codec_parent_ordinal[index - 1]:
        codec_snapshot_unpin(slot); return false
    _codec_parent_slot[index] = slot
    _codec_parent_generation[index] = snapshot._codec_generation
    _codec_parent_codec_capability[index] = snapshot._codec_capability
    _codec_parent_snapshot_epoch[index] = snapshot._snapshot_epoch
    _codec_parent_snapshot_capability[index] = snapshot._snapshot_capability
    _codec_parent_ordinal[index] = ordinal
    _codec_parent_batch_count = index + 1
    codec_snapshot_unpin(slot)
    true

pub(package) fn rt_hal_codec_parent_batch_abort(token: i64) -> bool:
    if (token <= 0 or _codec_parent_batch_state.load(MemoryOrdering.SeqCst) != token or
        _codec_parent_batch_token != token): return false
    if (_codec_parent_owner_thread.load(MemoryOrdering.SeqCst) != codec_current_thread() or
        _codec_parent_owner_task.load(MemoryOrdering.SeqCst) != codec_current_task()): return false
    # Abort consumes every snapshot already admitted to the parent batch. This
    # closes all leases on every failure path; callers release only the current
    # snapshot when add itself fails before publication.
    var release_index = 0
    while release_index < _codec_parent_batch_count:
        if not rt_hal_codec_snapshot_release(codec_parent_snapshot_at(release_index)):
            return false
        release_index = release_index + 1
    _codec_parent_batch_count = 0
    _codec_parent_batch_expected = 0
    _codec_parent_batch_token = 0
    _codec_parent_owner_thread.store(0, MemoryOrdering.SeqCst)
    _codec_parent_owner_task.store(0, MemoryOrdering.SeqCst)
    _codec_parent_batch_state.store(0, MemoryOrdering.SeqCst)
    true

pub(package) fn rt_hal_codec_parent_batch_commit(token: i64) -> bool:
    # Validate the full deterministic input order, reserve every lease, and
    # prove every reader count quiescent before changing any snapshot metadata.
    # Any failed reservation/reader/replay check restores every reserved lease;
    # therefore the batch publishes all ordered ordinals or publishes none.
    if (token <= _codec_parent_committed_epoch or
        _codec_parent_batch_state.load(MemoryOrdering.SeqCst) != token or
        _codec_parent_batch_token != token or
        _codec_parent_batch_count != _codec_parent_batch_expected): return false
    if (_codec_parent_owner_thread.load(MemoryOrdering.SeqCst) != codec_current_thread() or
        _codec_parent_owner_task.load(MemoryOrdering.SeqCst) != codec_current_task()): return false
    val count = _codec_parent_batch_count
    var validated = 0
    while validated < count:
        val snapshot = codec_parent_snapshot_at(validated)
        val admitted_slot = codec_snapshot_pin(snapshot)
        if admitted_slot != _codec_parent_slot[validated]:
            if admitted_slot >= 0: codec_snapshot_unpin(admitted_slot)
            return false
        codec_snapshot_unpin(admitted_slot)
        validated = validated + 1
    var reserved = 0
    while reserved < count:
        val slot = _codec_parent_slot[reserved]
        val capability = _codec_parent_snapshot_capability[reserved]
        if not _codec_lease[slot].compare_exchange(capability, -capability,
                MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
            var rollback = 0
            while rollback < reserved:
                val rollback_slot = _codec_parent_slot[rollback]
                _codec_lease[rollback_slot].store(
                    _codec_parent_snapshot_capability[rollback], MemoryOrdering.SeqCst)
                rollback = rollback + 1
            return false
        reserved = reserved + 1
    var quiescent = 0
    while quiescent < count:
        if _codec_readers[_codec_parent_slot[quiescent]].load(MemoryOrdering.SeqCst) != 0:
            var rollback = 0
            while rollback < count:
                val rollback_slot = _codec_parent_slot[rollback]
                _codec_lease[rollback_slot].store(
                    _codec_parent_snapshot_capability[rollback], MemoryOrdering.SeqCst)
                rollback = rollback + 1
            return false
        quiescent = quiescent + 1
    var replay_check = 0
    while replay_check < count:
        val slot = _codec_parent_slot[replay_check]
        if _codec_parent_ordinal[replay_check] <= _codec_committed_ordinal[codec_lane(slot)]:
            var rollback = 0
            while rollback < count:
                val rollback_slot = _codec_parent_slot[rollback]
                _codec_lease[rollback_slot].store(
                    _codec_parent_snapshot_capability[rollback], MemoryOrdering.SeqCst)
                rollback = rollback + 1
            return false
        replay_check = replay_check + 1
    var commit = 0
    while commit < count:
        val slot = _codec_parent_slot[commit]
        _codec_committed_ordinal[codec_lane(slot)] = _codec_parent_ordinal[commit]
        _codec_snapshot_state[codec_lane(slot)] = 2
        _codec_snapshot_epoch[codec_lane(slot)] = 0
        _codec_snapshot_capability[codec_lane(slot)] = 0
        _codec_lease[slot].store(0, MemoryOrdering.SeqCst)
        commit = commit + 1
    _codec_parent_committed_epoch = token
    _codec_parent_batch_count = 0
    _codec_parent_batch_expected = 0
    _codec_parent_batch_token = 0
    _codec_parent_owner_thread.store(0, MemoryOrdering.SeqCst)
    _codec_parent_owner_task.store(0, MemoryOrdering.SeqCst)
    _codec_parent_batch_state.store(0, MemoryOrdering.SeqCst)
    true

# Terminal drain invalidates every copied token for this epoch. The parent must
# complete its one reserved-arena copy before calling release.
pub fn rt_hal_codec_snapshot_release(snapshot: RtHalExactIoCodecSnapshot) -> bool:
    val slot = codec_snapshot_pin(snapshot)
    if slot < 0: return false
    codec_snapshot_unpin(slot)
    if not _codec_lease[slot].compare_exchange(snapshot._snapshot_capability, -1,
            MemoryOrdering.SeqCst, MemoryOrdering.SeqCst): return false
    if _codec_readers[slot].load(MemoryOrdering.SeqCst) != 0:
        _codec_lease[slot].store(snapshot._snapshot_capability, MemoryOrdering.SeqCst)
        return false
    _codec_snapshot_state[codec_lane(slot)] = 2
    _codec_snapshot_epoch[codec_lane(slot)] = 0
    _codec_snapshot_capability[codec_lane(slot)] = 0
    _codec_lease[slot].store(0, MemoryOrdering.SeqCst)
    true
