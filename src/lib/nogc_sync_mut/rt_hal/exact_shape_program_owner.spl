# codex-impl
# Frozen descriptor-to-event programs for RT/HAL exact I/O.
#
# Ownership:
# - one codec slot owns five immutable program regions (operation..effect);
# - one cursor lane is an exclusive thread/task lease over one program;
# - the codec remains the byte/event arena owner.  This module validates shape
#   before forwarding a mutation and never retains a payload or raw pointer.
#
# All arrays have fixed process-lifetime capacity.  Installation is cold and
# transactional.  After begin, a cursor touches only its lane and immutable
# program region: no allocation and no per-event atomic operation.

use std.nogc_sync_mut.atomic.{AtomicI64,MemoryOrdering,atomic_i64_new}
use std.nogc_sync_mut.rt_hal.exact_type_descriptor_parser.{rt_hal_exact_type_descriptor_canonical}
use std.nogc_sync_mut.rt_hal.exact_byte_codec_owner.{RtHalCodecRootDomain,
    RtHalCodecEvent,RtHalCodecHotLease,rt_hal_codec_admit_five_schema_receipts,
    rt_hal_codec_hot_lease_begin,rt_hal_codec_hot_lease_valid,
    rt_hal_codec_hot_apply,rt_hal_codec_hot_write_byte,
    rt_hal_codec_hot_lease_finish,rt_hal_codec_hot_lease_abort}

extern fn spl_thread_current_id() -> i64
extern fn rt_current_task_id() -> i64

pub const RT_HAL_SHAPE_MAX_SLOTS: i64=64
pub const RT_HAL_SHAPE_PROGRAMS_PER_SLOT: i64=5
pub const RT_HAL_SHAPE_MAX_OPS_PER_PROGRAM: i64=2050
pub const RT_HAL_SHAPE_MAX_CURSOR_LANES: i64=64
pub const RT_HAL_SHAPE_MAX_DEPTH: i64=64
pub const RT_HAL_SHAPE_CURSOR_STRIDE: i64=8 # 8*i64 = one 64-byte cache line
# Conservative retained-capacity accounting. The owner budget includes the
# immutable program/frame payload, every compact and cache-line-strided scalar
# column (including dormant generation/capability tokens and thread/task
# owners), compact hot-lease carriers, native atomic cells, dynamic-array
# headers, alignment, and allocator metadata.
pub const RT_HAL_SHAPE_PROGRAM_PAYLOAD_BYTES: i64=
    RT_HAL_SHAPE_MAX_SLOTS*RT_HAL_SHAPE_PROGRAMS_PER_SLOT*
        RT_HAL_SHAPE_MAX_OPS_PER_PROGRAM*4*8
pub const RT_HAL_SHAPE_FRAME_PAYLOAD_BYTES: i64=
    RT_HAL_SHAPE_MAX_CURSOR_LANES*RT_HAL_SHAPE_MAX_DEPTH*5*8
pub const RT_HAL_SHAPE_PADDED_CURSOR_COLUMNS: i64=11
pub const RT_HAL_SHAPE_COMPACT_SLOT_COLUMNS: i64=5
pub const RT_HAL_SHAPE_HOT_LEASE_SCALARS: i64=3
pub const RT_HAL_SHAPE_DYNAMIC_ARRAY_HEADERS: i64=29
pub const RT_HAL_SHAPE_NATIVE_ATOMIC_CELLS: i64=
    RT_HAL_SHAPE_MAX_SLOTS+RT_HAL_SHAPE_MAX_CURSOR_LANES+2
# Conservative parity with the codec pool: charge a full cache line for each
# native atomic cell and each dynamic-array allocation/header.
pub const RT_HAL_SHAPE_NATIVE_CELL_BUDGET: i64=64
pub const RT_HAL_SHAPE_SCALAR_METADATA_BYTES: i64=
    RT_HAL_SHAPE_PADDED_CURSOR_COLUMNS*RT_HAL_SHAPE_MAX_CURSOR_LANES*
        RT_HAL_SHAPE_CURSOR_STRIDE*8+
    RT_HAL_SHAPE_COMPACT_SLOT_COLUMNS*RT_HAL_SHAPE_MAX_SLOTS*8+
    RT_HAL_SHAPE_MAX_SLOTS*RT_HAL_SHAPE_PROGRAMS_PER_SLOT*8+
    RT_HAL_SHAPE_HOT_LEASE_SCALARS*RT_HAL_SHAPE_MAX_CURSOR_LANES*8
pub const RT_HAL_SHAPE_NATIVE_HEADER_BYTES: i64=
    (RT_HAL_SHAPE_NATIVE_ATOMIC_CELLS+RT_HAL_SHAPE_DYNAMIC_ARRAY_HEADERS)*
        RT_HAL_SHAPE_NATIVE_CELL_BUDGET
# Idle reclaim retains only the two monotonic anti-replay columns and their
# array headers: one compact slot capability column and one padded cursor
# generation column. This is the dormant cost; all other charged storage is
# activation-owned and reclaimed after the final quiescent release.
pub const RT_HAL_SHAPE_DORMANT_RETAINED_BYTES: i64=
    RT_HAL_SHAPE_MAX_SLOTS*8+
    RT_HAL_SHAPE_MAX_CURSOR_LANES*RT_HAL_SHAPE_CURSOR_STRIDE*8+
    2*RT_HAL_SHAPE_NATIVE_CELL_BUDGET
pub const RT_HAL_SHAPE_REQUIRED_RETAINED_BYTES: i64=
    RT_HAL_SHAPE_PROGRAM_PAYLOAD_BYTES+RT_HAL_SHAPE_FRAME_PAYLOAD_BYTES+
    RT_HAL_SHAPE_SCALAR_METADATA_BYTES+RT_HAL_SHAPE_NATIVE_HEADER_BYTES
pub const RT_HAL_SHAPE_OWNER_BUDGET_BYTES: i64=23068672
# Compatibility name remains the admitted owner ceiling, not an ABI-size claim.
pub const RT_HAL_SHAPE_RETAINED_BYTES: i64=RT_HAL_SHAPE_OWNER_BUDGET_BYTES

fn shape_current_thread() ->i64:
    val id=spl_thread_current_id()
    if id>0:return id
    0

# Match the codec owner: hosted/no-task execution is canonical task zero.
fn shape_current_task() ->i64:
    val id=rt_current_task_id()
    if id>0:return id
    0

fn shape_lane_offset(lane: i64) ->i64:
    lane*RT_HAL_SHAPE_CURSOR_STRIDE

# Program opcodes deliberately equal neither parser tokens nor codec event
# numbers.  They are private validation instructions.
const _SOP_ROOT_BEGIN: i64=1
const _SOP_ROOT_END: i64=2
const _SOP_TUPLE_BEGIN: i64=3
const _SOP_TUPLE_END: i64=4
const _SOP_ARRAY_BEGIN: i64=5
const _SOP_ARRAY_END: i64=6
const _SOP_RESULT_BRANCH: i64=7
const _SOP_RESULT_OK_END: i64=8
const _SOP_RESULT_ERR_END: i64=9
const _SOP_UNIT: i64=10
const _SOP_BOOL: i64=11
const _SOP_I8: i64=12
const _SOP_I16: i64=13
const _SOP_I32: i64=14
const _SOP_I64: i64=15
const _SOP_U8: i64=16
const _SOP_U16: i64=17
const _SOP_U32: i64=18
const _SOP_U64: i64=19
const _SOP_F32: i64=20
const _SOP_F64: i64=21
const _SOP_BYTES_BEGIN: i64=22
const _SOP_BYTES_END: i64=23
const _SOP_UTF8_BEGIN: i64=24
const _SOP_UTF8_END: i64=25
const _SOP_CHAR: i64=26

pub enum RtHalShapeError:
    None
    Inactive
    WrongOwner
    StaleReceipt
    DescriptorInvalid
    ProgramBound
    CursorBound
    DepthBound
    ShapeMismatch
    CodecRejected
    Incomplete

pub struct RtHalShapeProgramReceipt:
    _slot: i64
    _domain: i64
    _generation: i64
    _capability: i64
    _offset: i64
    _count: i64

impl RtHalShapeProgramReceipt:
    pub static fn invalid_probe() ->RtHalShapeProgramReceipt:
        RtHalShapeProgramReceipt(_slot:-1,_domain:0,_generation:0,
            _capability:0,_offset:-1,_count:0)

pub struct RtHalShapeProgramBatch:
    operation: RtHalShapeProgramReceipt
    input: RtHalShapeProgramReceipt
    output: RtHalShapeProgramReceipt
    error: RtHalShapeProgramReceipt
    effect: RtHalShapeProgramReceipt
    valid: bool

pub struct RtHalShapeCursor:
    _lane: i64
    _generation: i64
    _capability: i64
    _owner_thread: i64
    _owner_task: i64

impl RtHalShapeCursor:
    pub static fn invalid_probe() ->RtHalShapeCursor:
        RtHalShapeCursor(_lane:-1,_generation:0,_capability:0,
            _owner_thread:0,_owner_task:0)

fn shape_invalid_batch() ->RtHalShapeProgramBatch:
    val invalid=RtHalShapeProgramReceipt.invalid_probe()
    RtHalShapeProgramBatch(operation:invalid,input:invalid,output:invalid,
        error: invalid,effect:invalid,valid:false)

var _shape_ready: AtomicI64=atomic_i64_new(0)
var _shape_admin: AtomicI64=atomic_i64_new(0)
var _shape_quiesce_slot: i64=-1
var _shape_quiesce_codec: i64=0
var _shape_quiesce_identity_generation: i64=0
var _shape_quiesce_identity_capability: i64=0
var _shape_slot_state: [AtomicI64]=[] # 0 free, -1 transition, 1 published
var _shape_slot_identity_generation: [i64]=[]
var _shape_slot_identity_capability: [i64]=[]
var _shape_slot_codec_generation: [i64]=[]
var _shape_slot_capability: [i64]=[]
var _shape_next_capability: [i64]=[]
var _shape_program_count: [i64]=[]
var _shape_op: [i64]=[]
var _shape_arg: [i64]=[]
var _shape_jump: [i64]=[]
var _shape_aux: [i64]=[]

var _shape_cursor_state: [AtomicI64]=[] # 0 free, -1 transition, 1 leased
var _shape_cursor_active: [i64]=[]
var _shape_cursor_generation: [i64]=[]
var _shape_cursor_next_generation: [i64]=[]
var _shape_cursor_capability: [i64]=[]
var _shape_cursor_owner_thread: [i64]=[]
var _shape_cursor_owner_task: [i64]=[]
var _shape_cursor_slot: [i64]=[]
var _shape_cursor_domain: [i64]=[]
var _shape_cursor_hot: [RtHalCodecHotLease]=[]
var _shape_cursor_pc: [i64]=[]
var _shape_cursor_end: [i64]=[]
var _shape_cursor_depth: [i64]=[]
var _shape_cursor_error: [RtHalShapeError]=[]
var _shape_frame_kind: [i64]=[]
var _shape_frame_start: [i64]=[]
var _shape_frame_end: [i64]=[]
var _shape_frame_remaining: [i64]=[]
var _shape_frame_continue: [i64]=[]

fn shape_initialize() ->bool:
    if RT_HAL_SHAPE_REQUIRED_RETAINED_BYTES>RT_HAL_SHAPE_OWNER_BUDGET_BYTES:return false
    val state=_shape_ready.load(MemoryOrdering.SeqCst)
    if state==1:return true
    if state!=0:return false
    if not _shape_ready.compare_exchange(0,-1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):return false
    val program_cells=RT_HAL_SHAPE_MAX_SLOTS*RT_HAL_SHAPE_PROGRAMS_PER_SLOT*RT_HAL_SHAPE_MAX_OPS_PER_PROGRAM
    val program_rows=RT_HAL_SHAPE_MAX_SLOTS*RT_HAL_SHAPE_PROGRAMS_PER_SLOT
    val frame_rows=RT_HAL_SHAPE_MAX_CURSOR_LANES*RT_HAL_SHAPE_MAX_DEPTH
    val cursor_cells=RT_HAL_SHAPE_MAX_CURSOR_LANES*RT_HAL_SHAPE_CURSOR_STRIDE
    _shape_slot_identity_generation=[0;RT_HAL_SHAPE_MAX_SLOTS]
    _shape_slot_identity_capability=[0;RT_HAL_SHAPE_MAX_SLOTS]
    _shape_slot_codec_generation=[0;RT_HAL_SHAPE_MAX_SLOTS]
    _shape_slot_capability=[0;RT_HAL_SHAPE_MAX_SLOTS]
    if _shape_next_capability.len()==0:_shape_next_capability=[1;RT_HAL_SHAPE_MAX_SLOTS]
    _shape_program_count=[0;program_rows]
    _shape_op=[0;program_cells];_shape_arg=[0;program_cells]
    _shape_jump=[0;program_cells];_shape_aux=[0;program_cells]
    if _shape_cursor_active.len()==0:
        _shape_cursor_active=[0;cursor_cells]
        _shape_cursor_generation=[0;cursor_cells]
        if _shape_cursor_next_generation.len()==0:
            _shape_cursor_next_generation=[1;cursor_cells]
        _shape_cursor_capability=[0;cursor_cells]
        _shape_cursor_owner_thread=[0;cursor_cells]
        _shape_cursor_owner_task=[0;cursor_cells]
        _shape_cursor_slot=[-1;cursor_cells]
        _shape_cursor_domain=[0;cursor_cells]
        _shape_cursor_hot=[RtHalCodecHotLease.invalid_probe();RT_HAL_SHAPE_MAX_CURSOR_LANES]
        _shape_cursor_pc=[0;cursor_cells]
        _shape_cursor_end=[0;cursor_cells]
        _shape_cursor_depth=[0;cursor_cells]
        _shape_cursor_error=[RtHalShapeError.Inactive;cursor_cells]
    _shape_frame_kind=[0;frame_rows];_shape_frame_start=[0;frame_rows]
    _shape_frame_end=[0;frame_rows];_shape_frame_remaining=[0;frame_rows]
    _shape_frame_continue=[0;frame_rows]
    var i=0
    if _shape_slot_state.len()==0:
        while i<RT_HAL_SHAPE_MAX_SLOTS:
            _shape_slot_state.push(atomic_i64_new(0));i=i+1
    i=0
    if _shape_cursor_state.len()==0:
        while i<RT_HAL_SHAPE_MAX_CURSOR_LANES:
            _shape_cursor_state.push(atomic_i64_new(0));i=i+1
    _shape_ready.store(1,MemoryOrdering.SeqCst);true

fn shape_codec_slot(handle: i64) ->i64:
    if handle<=RT_HAL_SHAPE_MAX_SLOTS:return -1
    (handle-1)%RT_HAL_SHAPE_MAX_SLOTS

fn shape_codec_generation(handle: i64) ->i64:
    if handle<=RT_HAL_SHAPE_MAX_SLOTS:return 0
    (handle-1)/RT_HAL_SHAPE_MAX_SLOTS

fn shape_domain_code(domain: RtHalCodecRootDomain) ->i64:
    match domain:
        case Operation:1
        case Input:2
        case Output:3
        case Error:4
        case Effect:5

fn shape_program_index(slot: i64,domain: i64) ->i64:
    slot*RT_HAL_SHAPE_PROGRAMS_PER_SLOT+(domain-1)

fn shape_program_base(slot: i64,domain: i64) ->i64:
    shape_program_index(slot,domain)*RT_HAL_SHAPE_MAX_OPS_PER_PROGRAM

fn shape_mix(secret: i64,generation: i64,lane: i64,offset: i64) ->i64:
    var value=secret^(generation*0x5bd1e995)^((lane+1)*0x27d4eb2d)^(offset*0x165667b1)
    value=value^(value>>29);value=value&0x7fffffffffffffff
    if value==0:1 else:value

class _ShapeCompiler:
    raw: text
    position: i64
    end: i64
    base: i64
    count: i64
    nodes: i64
    valid: bool

impl _ShapeCompiler:
    fn starts(needle: text,limit: i64) ->bool:
        if self.position<0 or needle.len()>limit-self.position:return false
        var i=0
        while i<needle.len():
            if self.raw.char_at(self.position+i)!=needle.char_at(i):return false
            i=i+1
        true

    me consume(needle: text,limit: i64) ->bool:
        if not self.starts(needle,limit):return false
        self.position=self.position+needle.len();true

    me decimal(delimiter: text,limit: i64) ->i64:
        if self.position>=limit:return -1
        val first=self.raw.char_at(self.position)
        if first<"0" or first>"9":return -1
        if first=="0":
            self.position=self.position+1
            if self.position>=limit or self.raw.char_at(self.position)!=delimiter:return -1
            self.position=self.position+1;return 0
        var value: i64=0
        while self.position<limit:
            val ch=self.raw.char_at(self.position)
            if ch==delimiter:self.position=self.position+1;return value
            if ch<"0" or ch>"9":return -1
            val digit=self.raw.char_code_at(self.position)-48
            if value>(0x7fffffffffffffff-digit)/10:return -1
            value=value*10+digit;self.position=self.position+1
        -1

    me emit(op: i64,arg: i64,jump: i64) ->i64:
        if not self.valid or self.count>=RT_HAL_SHAPE_MAX_OPS_PER_PROGRAM:
            self.valid=false;return -1
        val at=self.base+self.count
        _shape_op[at]=op;_shape_arg[at]=arg;_shape_jump[at]=jump
        _shape_aux[at]=0
        self.count=self.count+1;at

    me framed(depth: i64,limit: i64) ->bool:
        val length=self.decimal(":",limit)
        if length<=0 or length>limit-self.position:return false
        val child_end=self.position+length
        if not self.compile_type(depth,child_end) or self.position!=child_end:return false
        true

    me primitive(limit: i64) ->bool:
        val remaining=limit-self.position
        var op=0
        if remaining==4 and self.starts("unit",limit):op=_SOP_UNIT
        elif remaining==2 and self.starts("i8",limit):op=_SOP_I8
        elif remaining==3 and self.starts("i16",limit):op=_SOP_I16
        elif remaining==3 and self.starts("i32",limit):op=_SOP_I32
        elif remaining==3 and self.starts("i64",limit):op=_SOP_I64
        elif remaining==2 and self.starts("u8",limit):op=_SOP_U8
        elif remaining==3 and self.starts("u16",limit):op=_SOP_U16
        elif remaining==3 and self.starts("u32",limit):op=_SOP_U32
        elif remaining==3 and self.starts("u64",limit):op=_SOP_U64
        elif remaining==3 and self.starts("f32",limit):op=_SOP_F32
        elif remaining==3 and self.starts("f64",limit):op=_SOP_F64
        elif remaining==4 and self.starts("bool",limit):op=_SOP_BOOL
        elif remaining==4 and self.starts("char",limit):op=_SOP_CHAR
        elif remaining==5 and self.starts("bytes",limit):
            self.emit(_SOP_BYTES_BEGIN,-1,0);self.emit(_SOP_BYTES_END,0,0)
            self.position=limit;return self.valid
        elif remaining==9 and self.starts("text:utf8",limit):
            self.emit(_SOP_UTF8_BEGIN,-1,0);self.emit(_SOP_UTF8_END,0,0)
            self.position=limit;return self.valid
        else: return false
        self.emit(op,0,0);self.position=limit;self.valid

    me compile_type(depth: i64,limit: i64) ->bool:
        if not self.valid or depth>RT_HAL_SHAPE_MAX_DEPTH or self.position>=limit:return false
        self.nodes=self.nodes+1
        if self.nodes>1024 or not self.consume("v2;",limit):return false
        if self.consume("array;",limit):
            val elements=self.decimal(";",limit)
            if elements<0:return false
            val begin=self.emit(_SOP_ARRAY_BEGIN,elements,0)
            val child_start=self.base+self.count
            if not self.framed(depth+1,limit):return false
            val finish=self.emit(_SOP_ARRAY_END,0,0)
            _shape_jump[begin]=child_start;_shape_aux[begin]=finish;_shape_jump[finish]=child_start
            return self.position==limit
        if self.consume("tuple;",limit):
            val fields=self.decimal(";",limit)
            if fields<0:return false
            self.emit(_SOP_TUPLE_BEGIN,fields,0)
            var i=0
            while i<fields:
                if not self.framed(depth+1,limit):return false
                i=i+1
            self.emit(_SOP_TUPLE_END,0,0)
            return self.position==limit
        if self.consume("result;",limit):
            val branch=self.emit(_SOP_RESULT_BRANCH,0,0)
            val ok_start=self.base+self.count
            if not self.framed(depth+1,limit):return false
            val ok_end=self.emit(_SOP_RESULT_OK_END,0,0)
            val err_start=self.base+self.count
            if not self.framed(depth+1,limit):return false
            val err_end=self.emit(_SOP_RESULT_ERR_END,0,0)
            val continuation=self.base+self.count
            _shape_arg[branch]=ok_start;_shape_jump[branch]=err_start
            _shape_aux[branch]=ok_end;_shape_aux[ok_end]=err_end
            _shape_jump[ok_end]=continuation;_shape_jump[err_end]=continuation
            return self.position==limit
        self.primitive(limit)

fn shape_compile(slot: i64,domain: i64,raw: text,root_id: i64,secret: i64) ->RtHalShapeProgramReceipt:
    val canonical=rt_hal_exact_type_descriptor_canonical(raw)
    if canonical=="" or root_id<=0:return RtHalShapeProgramReceipt.invalid_probe()
    val base=shape_program_base(slot,domain)
    var compiler=_ShapeCompiler(raw:canonical,position:0,end:canonical.len(),base:base,
        count:0,nodes:0,valid:true)
    compiler.emit(_SOP_ROOT_BEGIN,root_id,domain)
    if not compiler.compile_type(1,canonical.len()):return RtHalShapeProgramReceipt.invalid_probe()
    compiler.emit(_SOP_ROOT_END,0,0)
    if not compiler.valid or compiler.position!=canonical.len():return RtHalShapeProgramReceipt.invalid_probe()
    val generation=shape_codec_generation(_shape_slot_codec_generation[slot]*RT_HAL_SHAPE_MAX_SLOTS+slot+1)
    RtHalShapeProgramReceipt(_slot:slot,_domain:domain,_generation:generation,
        _capability: shape_mix(secret,generation,domain,base),_offset:base,_count:compiler.count)

# Cold package adapter called only by the frozen identity owner.  Programs are
# published to the codec only after all five compile successfully.
pub(package) fn rt_hal_shape_program_install_five(codec_handle:i64,
        identity_generation: i64,identity_capability:i64,
        operation_text: text,input_text:text,output_text:text,error_text:text,effect_text:text,
        operation_root: i64,input_root:i64,output_root:i64,error_root:i64,effect_root:i64) ->RtHalShapeProgramBatch:
    if identity_generation<=0 or identity_capability<=0:return shape_invalid_batch()
    if not _shape_admin.compare_exchange(0,1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):return shape_invalid_batch()
    if not shape_initialize():
        _shape_admin.store(0,MemoryOrdering.SeqCst);return shape_invalid_batch()
    val slot=shape_codec_slot(codec_handle);val generation=shape_codec_generation(codec_handle)
    if slot<0 or generation<=0:
        _shape_admin.store(0,MemoryOrdering.SeqCst);return shape_invalid_batch()
    if not _shape_slot_state[slot].compare_exchange(0,-1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):
        _shape_admin.store(0,MemoryOrdering.SeqCst);return shape_invalid_batch()
    val next=_shape_next_capability[slot]
    if next<=0 or next>=0x7fffffffffffffff:
        _shape_slot_state[slot].store(0,MemoryOrdering.SeqCst)
        _shape_admin.store(0,MemoryOrdering.SeqCst);return shape_invalid_batch()
    val secret=shape_mix(identity_capability,generation,slot,next)
    _shape_slot_identity_generation[slot]=identity_generation
    _shape_slot_identity_capability[slot]=identity_capability
    _shape_slot_codec_generation[slot]=generation
    _shape_slot_capability[slot]=secret
    val operation=shape_compile(slot,1,operation_text,operation_root,secret)
    val input=shape_compile(slot,2,input_text,input_root,secret)
    val output=shape_compile(slot,3,output_text,output_root,secret)
    val error=shape_compile(slot,4,error_text,error_root,secret)
    val effect=shape_compile(slot,5,effect_text,effect_root,secret)
    if operation._count<=0 or input._count<=0 or output._count<=0 or error._count<=0 or effect._count<=0:
        _shape_slot_identity_generation[slot]=0;_shape_slot_identity_capability[slot]=0
        _shape_slot_codec_generation[slot]=0;_shape_slot_capability[slot]=0
        _shape_slot_state[slot].store(0,MemoryOrdering.SeqCst)
        _shape_admin.store(0,MemoryOrdering.SeqCst);return shape_invalid_batch()
    _shape_program_count[shape_program_index(slot,1)]=operation._count
    _shape_program_count[shape_program_index(slot,2)]=input._count
    _shape_program_count[shape_program_index(slot,3)]=output._count
    _shape_program_count[shape_program_index(slot,4)]=error._count
    _shape_program_count[shape_program_index(slot,5)]=effect._count
    if not rt_hal_codec_admit_five_schema_receipts(codec_handle,identity_generation,
            identity_capability,operation._capability,input._capability,output._capability,
            error._capability,effect._capability):
        _shape_slot_identity_generation[slot]=0;_shape_slot_identity_capability[slot]=0
        _shape_slot_codec_generation[slot]=0;_shape_slot_capability[slot]=0
        _shape_slot_state[slot].store(0,MemoryOrdering.SeqCst)
        _shape_admin.store(0,MemoryOrdering.SeqCst);return shape_invalid_batch()
    _shape_next_capability[slot]=next+1
    _shape_slot_state[slot].store(1,MemoryOrdering.SeqCst)
    _shape_admin.store(0,MemoryOrdering.SeqCst)
    RtHalShapeProgramBatch(operation:operation,input:input,output:output,error:error,effect:effect,valid:true)

pub(package) fn rt_hal_shape_program_quiesce(codec_handle:i64,
        identity_generation: i64,identity_capability:i64) ->bool:
    # Retain the cold admin reservation across codec teardown. Resume or final
    # release is the only operation allowed to relinquish it.
    if not _shape_admin.compare_exchange(0,1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):return false
    val slot=shape_codec_slot(codec_handle);val generation=shape_codec_generation(codec_handle)
    if slot<0 or _shape_ready.load(MemoryOrdering.SeqCst)!=1:
        _shape_admin.store(0,MemoryOrdering.SeqCst);return false
    if not _shape_slot_state[slot].compare_exchange(1,-1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):
        _shape_admin.store(0,MemoryOrdering.SeqCst);return false
    if generation!=_shape_slot_codec_generation[slot] or
       identity_generation!=_shape_slot_identity_generation[slot] or
       identity_capability!=_shape_slot_identity_capability[slot]:
        _shape_slot_state[slot].store(1,MemoryOrdering.SeqCst)
        _shape_admin.store(0,MemoryOrdering.SeqCst);return false
    var lane=0
    while lane<RT_HAL_SHAPE_MAX_CURSOR_LANES:
        if (_shape_cursor_state[lane].load(MemoryOrdering.SeqCst)!=0 and
            _shape_cursor_slot[shape_lane_offset(lane)]==slot):
            _shape_slot_state[slot].store(1,MemoryOrdering.SeqCst)
            _shape_admin.store(0,MemoryOrdering.SeqCst);return false
        lane=lane+1
    _shape_quiesce_slot=slot;_shape_quiesce_codec=codec_handle
    _shape_quiesce_identity_generation=identity_generation
    _shape_quiesce_identity_capability=identity_capability
    true

pub(package) fn rt_hal_shape_program_resume(codec_handle:i64,
        identity_generation: i64,identity_capability:i64) ->bool:
    val slot=shape_codec_slot(codec_handle);val generation=shape_codec_generation(codec_handle)
    if (_shape_admin.load(MemoryOrdering.SeqCst)!=1 or slot<0 or
       _shape_quiesce_slot!=slot or _shape_quiesce_codec!=codec_handle or
       _shape_quiesce_identity_generation!=identity_generation or
       _shape_quiesce_identity_capability!=identity_capability or
       _shape_ready.load(MemoryOrdering.SeqCst)!=1 or
       _shape_slot_state[slot].load(MemoryOrdering.SeqCst)!=-1 or
       generation!=_shape_slot_codec_generation[slot] or
       identity_generation!=_shape_slot_identity_generation[slot] or
       identity_capability!=_shape_slot_identity_capability[slot]):
        _shape_quiesce_slot=-1;_shape_quiesce_codec=0
        _shape_quiesce_identity_generation=0;_shape_quiesce_identity_capability=0
        _shape_admin.store(0,MemoryOrdering.SeqCst);return false
    val resumed=_shape_slot_state[slot].compare_exchange(-1,1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst)
    _shape_quiesce_slot=-1;_shape_quiesce_codec=0
    _shape_quiesce_identity_generation=0;_shape_quiesce_identity_capability=0
    _shape_admin.store(0,MemoryOrdering.SeqCst);resumed

fn shape_retire_if_idle():
    var slot=0
    while slot<RT_HAL_SHAPE_MAX_SLOTS:
        if _shape_slot_state[slot].load(MemoryOrdering.SeqCst)!=0:return
        slot=slot+1
    var lane=0
    while lane<RT_HAL_SHAPE_MAX_CURSOR_LANES:
        if _shape_cursor_state[lane].load(MemoryOrdering.SeqCst)!=0:return
        lane=lane+1
    if not _shape_ready.compare_exchange(1,-1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):return
    # Atomic cells own native storage independently of their array headers.
    # All cells are quiescent here, so release them explicitly before dropping
    # the lazily allocated state arrays.
    slot=0
    while slot<_shape_slot_state.len():
        _shape_slot_state[slot].free();slot=slot+1
    lane=0
    while lane<_shape_cursor_state.len():
        _shape_cursor_state[lane].free();lane=lane+1
    _shape_op=[];_shape_arg=[];_shape_jump=[];_shape_aux=[];_shape_program_count=[]
    _shape_slot_identity_generation=[];_shape_slot_identity_capability=[]
    _shape_slot_codec_generation=[];_shape_slot_capability=[]
    _shape_cursor_active=[];_shape_cursor_generation=[]
    _shape_cursor_capability=[];_shape_cursor_owner_thread=[];_shape_cursor_owner_task=[]
    _shape_cursor_slot=[];_shape_cursor_domain=[]
    _shape_cursor_hot=[]
    _shape_cursor_pc=[];_shape_cursor_end=[];_shape_cursor_depth=[];_shape_cursor_error=[]
    _shape_frame_kind=[];_shape_frame_start=[];_shape_frame_end=[]
    _shape_frame_remaining=[];_shape_frame_continue=[]
    _shape_slot_state=[];_shape_cursor_state=[]
    _shape_ready.store(0,MemoryOrdering.SeqCst)

pub(package) fn rt_hal_shape_program_release_quiesced(codec_handle:i64,
        identity_generation: i64,identity_capability:i64) ->bool:
    val slot=shape_codec_slot(codec_handle);val generation=shape_codec_generation(codec_handle)
    if (_shape_admin.load(MemoryOrdering.SeqCst)!=1 or slot<0 or
       _shape_quiesce_slot!=slot or _shape_quiesce_codec!=codec_handle or
       _shape_quiesce_identity_generation!=identity_generation or
       _shape_quiesce_identity_capability!=identity_capability or
       _shape_ready.load(MemoryOrdering.SeqCst)!=1 or
       _shape_slot_state[slot].load(MemoryOrdering.SeqCst)!=-1 or
       generation!=_shape_slot_codec_generation[slot] or
       identity_generation!=_shape_slot_identity_generation[slot] or
       identity_capability!=_shape_slot_identity_capability[slot]):
        _shape_quiesce_slot=-1;_shape_quiesce_codec=0
        _shape_quiesce_identity_generation=0;_shape_quiesce_identity_capability=0
        _shape_admin.store(0,MemoryOrdering.SeqCst);return false
    _shape_slot_identity_generation[slot]=0;_shape_slot_identity_capability[slot]=0
    _shape_slot_codec_generation[slot]=0;_shape_slot_capability[slot]=0
    _shape_slot_state[slot].store(0,MemoryOrdering.SeqCst)
    _shape_quiesce_slot=-1;_shape_quiesce_codec=0
    _shape_quiesce_identity_generation=0;_shape_quiesce_identity_capability=0
    shape_retire_if_idle();_shape_admin.store(0,MemoryOrdering.SeqCst);true

fn shape_receipt_for(slot: i64,domain: i64) ->RtHalShapeProgramReceipt:
    val base=shape_program_base(slot,domain);val count=_shape_program_count[shape_program_index(slot,domain)]
    val generation=_shape_slot_codec_generation[slot];val secret=_shape_slot_capability[slot]
    RtHalShapeProgramReceipt(_slot:slot,_domain:domain,_generation:generation,
        _capability: shape_mix(secret,generation,domain,base),_offset:base,_count:count)

fn shape_cursor_lane(cursor: RtHalShapeCursor) ->i64:
    # The public cursor is copyable, so every public call re-establishes its
    # execution-domain authority before touching mutable lane state.  The
    # subsequent codec hot dispatch remains scalar-only and performs no
    # additional runtime query, atomic operation, or allocation.
    # Reject a transported copy using only immutable receipt fields and the
    # caller identity.  Do not read another domain's non-atomic lane first.
    val thread=shape_current_thread()
    if thread<=0 or thread!=cursor._owner_thread:return -1
    val task=shape_current_task()
    if task!=cursor._owner_task:return -1
    if _shape_cursor_active.len()!=RT_HAL_SHAPE_MAX_CURSOR_LANES*RT_HAL_SHAPE_CURSOR_STRIDE:return -1
    val lane=cursor._lane
    if lane<0 or lane>=RT_HAL_SHAPE_MAX_CURSOR_LANES:return -1
    val cell=shape_lane_offset(lane)
    if _shape_cursor_active[cell]!=1:return -1
    if cursor._generation!=_shape_cursor_generation[cell] or cursor._capability!=_shape_cursor_capability[cell]:return -1
    if thread!=_shape_cursor_owner_thread[cell]:return -1
    if task!=_shape_cursor_owner_task[cell]:return -1
    lane

fn shape_fail(lane: i64,error: RtHalShapeError) ->bool:
    val cell=shape_lane_offset(lane)
    if _shape_cursor_error[cell]==RtHalShapeError.None:_shape_cursor_error[cell]=error
    false

fn shape_frame(lane: i64,depth: i64) ->i64: lane*RT_HAL_SHAPE_MAX_DEPTH+depth

fn shape_push(lane: i64,kind: i64,start: i64,finish: i64,remaining: i64,continuation: i64) ->bool:
    val cell=shape_lane_offset(lane);val depth=_shape_cursor_depth[cell]
    if depth>=RT_HAL_SHAPE_MAX_DEPTH:return shape_fail(lane,RtHalShapeError.DepthBound)
    val frame=shape_frame(lane,depth)
    _shape_frame_kind[frame]=kind;_shape_frame_start[frame]=start;_shape_frame_end[frame]=finish
    _shape_frame_remaining[frame]=remaining;_shape_frame_continue[frame]=continuation
    _shape_cursor_depth[cell]=depth+1;true

fn shape_prepare(lane: i64,expected: i64,arg: i64) ->bool:
    val cell=shape_lane_offset(lane)
    if _shape_cursor_error[cell]!=RtHalShapeError.None:return false
    val pc=_shape_cursor_pc[cell]
    if pc<0 or pc>=_shape_cursor_end[cell] or _shape_op[pc]!=expected:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    val wanted=_shape_arg[pc]
    if wanted>=0 and wanted!=arg:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    true

fn shape_advance(lane: i64):
    val cell=shape_lane_offset(lane)
    _shape_cursor_pc[cell]=_shape_cursor_pc[cell]+1

# Clear the exclusive lane before the atomic free publication. The generation
# allocator is deliberately not reset: stale cursors can never regain authority.
fn shape_clear_lane_metadata(lane: i64):
    val cell=shape_lane_offset(lane)
    _shape_cursor_hot[lane]=RtHalCodecHotLease.invalid_probe()
    _shape_cursor_active[cell]=0
    _shape_cursor_generation[cell]=0;_shape_cursor_capability[cell]=0
    _shape_cursor_owner_thread[cell]=0;_shape_cursor_owner_task[cell]=0
    _shape_cursor_slot[cell]=-1;_shape_cursor_domain[cell]=0
    _shape_cursor_pc[cell]=0;_shape_cursor_end[cell]=0;_shape_cursor_depth[cell]=0
    _shape_cursor_error[cell]=RtHalShapeError.Inactive

pub fn rt_hal_shape_begin(codec_handle: i64,domain: RtHalCodecRootDomain,root_id: i64) ->RtHalShapeCursor:
    # Begin takes the cold admin gate only until its cursor reservation is
    # published. Quiesce retains the same gate through codec teardown, so no
    # begin can observe or race arena reclamation.
    if not _shape_admin.compare_exchange(0,2,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):return RtHalShapeCursor.invalid_probe()
    val owner_thread=shape_current_thread();val owner_task=shape_current_task()
    if owner_thread<=0:
        _shape_admin.store(0,MemoryOrdering.SeqCst);return RtHalShapeCursor.invalid_probe()
    if _shape_ready.load(MemoryOrdering.SeqCst)!=1:
        _shape_admin.store(0,MemoryOrdering.SeqCst);return RtHalShapeCursor.invalid_probe()
    val slot=shape_codec_slot(codec_handle);val domain_code=shape_domain_code(domain)
    if slot<0 or domain_code<=0 or _shape_slot_state[slot].load(MemoryOrdering.SeqCst)!=1 or
       shape_codec_generation(codec_handle)!=_shape_slot_codec_generation[slot]:
        _shape_admin.store(0,MemoryOrdering.SeqCst)
        return RtHalShapeCursor.invalid_probe()
    val receipt=shape_receipt_for(slot,domain_code)
    if receipt._count<=0 or _shape_op[receipt._offset]!=_SOP_ROOT_BEGIN or _shape_arg[receipt._offset]!=root_id:
        _shape_admin.store(0,MemoryOrdering.SeqCst)
        return RtHalShapeCursor.invalid_probe()
    var lane=0
    while lane<RT_HAL_SHAPE_MAX_CURSOR_LANES and not _shape_cursor_state[lane].compare_exchange(0,-1,MemoryOrdering.SeqCst,MemoryOrdering.SeqCst):
        lane=lane+1
    if lane>=RT_HAL_SHAPE_MAX_CURSOR_LANES:
        _shape_admin.store(0,MemoryOrdering.SeqCst)
        return RtHalShapeCursor.invalid_probe()
    val cell=shape_lane_offset(lane)
    val generation=_shape_cursor_next_generation[cell]
    if generation<=0 or generation>=0x7fffffffffffffff:
        _shape_cursor_state[lane].store(0,MemoryOrdering.SeqCst)
        _shape_admin.store(0,MemoryOrdering.SeqCst)
        return RtHalShapeCursor.invalid_probe()
    val capability=shape_mix(receipt._capability,generation,lane,receipt._offset)
    _shape_cursor_next_generation[cell]=generation+1;_shape_cursor_generation[cell]=generation
    _shape_cursor_capability[cell]=capability;_shape_cursor_slot[cell]=slot
    _shape_cursor_owner_thread[cell]=owner_thread;_shape_cursor_owner_task[cell]=owner_task
    _shape_cursor_domain[cell]=domain_code
    _shape_cursor_pc[cell]=receipt._offset;_shape_cursor_end[cell]=receipt._offset+receipt._count
    _shape_cursor_depth[cell]=0;_shape_cursor_error[cell]=RtHalShapeError.None
    val hot=rt_hal_codec_hot_lease_begin(codec_handle,domain,root_id)
    if not rt_hal_codec_hot_lease_valid(hot):
        shape_clear_lane_metadata(lane)
        _shape_cursor_state[lane].store(0,MemoryOrdering.SeqCst)
        _shape_admin.store(0,MemoryOrdering.SeqCst)
        return RtHalShapeCursor.invalid_probe()
    _shape_cursor_hot[lane]=hot
    shape_advance(lane);_shape_cursor_active[cell]=1
    _shape_cursor_state[lane].store(1,MemoryOrdering.Release)
    _shape_admin.store(0,MemoryOrdering.SeqCst)
    RtHalShapeCursor(_lane:lane,_generation:generation,_capability:capability,
        _owner_thread: owner_thread,_owner_task:owner_task)

pub fn rt_hal_shape_begin_tuple(cursor: RtHalShapeCursor,fields: i64) ->bool:
    if fields<0:return false
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_TUPLE_BEGIN,fields):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.TupleBegin,fields,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);true

pub fn rt_hal_shape_end_tuple(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_TUPLE_END,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.TupleEnd,0,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true

pub fn rt_hal_shape_begin_array(cursor: RtHalShapeCursor,elements: i64) ->bool:
    if elements<0:return false
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_ARRAY_BEGIN,elements):return false
    val cell=shape_lane_offset(lane);val pc=_shape_cursor_pc[cell];val child=_shape_jump[pc]
    # Zero-length arrays skip the element program entirely.
    val finish=_shape_aux[pc]
    if finish>=_shape_cursor_end[cell]:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.ArrayBegin,elements,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    if elements==0:_shape_cursor_pc[cell]=finish
    else:
        if not shape_push(lane,1,child,finish,elements,finish+1):return false
        _shape_cursor_pc[cell]=child
    true

pub fn rt_hal_shape_end_array(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    val cell=shape_lane_offset(lane)
    if not shape_prepare(lane,_SOP_ARRAY_END,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.ArrayEnd,0,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    if _shape_cursor_depth[cell]>0:
        val frame=shape_frame(lane,_shape_cursor_depth[cell]-1)
        if _shape_frame_kind[frame]==1:_shape_cursor_depth[cell]=_shape_cursor_depth[cell]-1
    shape_advance(lane);shape_after_value(lane);true

fn shape_after_value(lane: i64):
    val cell=shape_lane_offset(lane)
    if _shape_cursor_depth[cell]<=0:return
    val frame=shape_frame(lane,_shape_cursor_depth[cell]-1)
    if _shape_frame_kind[frame]==1 and _shape_cursor_pc[cell]==_shape_frame_end[frame]:
        val remaining=_shape_frame_remaining[frame]-1
        _shape_frame_remaining[frame]=remaining
        if remaining>0:_shape_cursor_pc[cell]=_shape_frame_start[frame]

pub fn rt_hal_shape_begin_result(cursor: RtHalShapeCursor,is_ok: bool) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    val cell=shape_lane_offset(lane);val pc=_shape_cursor_pc[cell]
    if pc<0 or pc>=_shape_cursor_end[cell] or _shape_op[pc]!=_SOP_RESULT_BRANCH:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    val start=if is_ok:_shape_arg[pc] else:_shape_jump[pc]
    val ok_end=_shape_aux[pc];val finish=if is_ok:ok_end else:_shape_aux[ok_end]
    if finish>=_shape_cursor_end[cell]:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    val begin_event=if is_ok:RtHalCodecEvent.ResultOkBegin else:RtHalCodecEvent.ResultErrBegin
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],begin_event,1,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    if not shape_push(lane,2,start,finish,1,_shape_jump[finish]):return false
    _shape_cursor_pc[cell]=start;true

pub fn rt_hal_shape_end_result(cursor: RtHalShapeCursor,is_ok: bool) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    val cell=shape_lane_offset(lane)
    val op=if is_ok:_SOP_RESULT_OK_END else:_SOP_RESULT_ERR_END
    if not shape_prepare(lane,op,0):return false
    if _shape_cursor_depth[cell]<=0:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    val frame=shape_frame(lane,_shape_cursor_depth[cell]-1)
    if _shape_frame_kind[frame]!=2 or _shape_frame_end[frame]!=_shape_cursor_pc[cell]:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    val end_event=if is_ok:RtHalCodecEvent.ResultOkEnd else:RtHalCodecEvent.ResultErrEnd
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],end_event,0,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    _shape_cursor_pc[cell]=_shape_frame_continue[frame];_shape_cursor_depth[cell]=_shape_cursor_depth[cell]-1
    shape_after_value(lane);true

# Scalar acceptance helpers preserve exact widths; char intentionally uses the
# canonical u32 transport event selected by the descriptor compiler.
pub fn rt_hal_shape_write_unit(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_UNIT,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.Unit,0,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_bool(cursor: RtHalShapeCursor,value: bool) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_BOOL,0):return false
    val bits=if value:1u64 else:0u64
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.Bool,0,bits):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_i8(cursor: RtHalShapeCursor,value: i8) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_I8,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.I8,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_i16(cursor: RtHalShapeCursor,value: i16) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_I16,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.I16,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_i32(cursor: RtHalShapeCursor,value: i32) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_I32,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.I32,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_i64(cursor: RtHalShapeCursor,value: i64) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_I64,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.I64,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_u8(cursor: RtHalShapeCursor,value: u8) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_U8,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.U8,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_u16(cursor: RtHalShapeCursor,value: u16) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_U16,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.U16,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_u32(cursor: RtHalShapeCursor,value: u32) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_U32,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.U32,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_char(cursor: RtHalShapeCursor,value: u32) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_CHAR,0):return false
    if value>0x10ffff or (value>=0xd800 and value<=0xdfff):return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.U32,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_u64(cursor: RtHalShapeCursor,value: u64) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_U64,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.U64,0,value):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_f32_bits(cursor: RtHalShapeCursor,value: u32) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_F32,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.F32,0,value as u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_write_f64_bits(cursor: RtHalShapeCursor,value: u64) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_F64,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.F64,0,value):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true

pub fn rt_hal_shape_begin_bytes(cursor: RtHalShapeCursor,length: i64) ->bool:
    if length<0:return false
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_BYTES_BEGIN,length):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.BytesBegin,length,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);true
pub fn rt_hal_shape_write_byte(cursor: RtHalShapeCursor,value: u8) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    val cell=shape_lane_offset(lane);val pc=_shape_cursor_pc[cell]
    if pc<0 or pc>=_shape_cursor_end[cell] or _shape_op[pc]!=_SOP_BYTES_END:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    if not rt_hal_codec_hot_write_byte(_shape_cursor_hot[lane],value,false):return shape_fail(lane,RtHalShapeError.CodecRejected)
    true
pub fn rt_hal_shape_end_bytes(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_BYTES_END,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.BytesEnd,0,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true
pub fn rt_hal_shape_begin_utf8(cursor: RtHalShapeCursor,length: i64) ->bool:
    if length<0:return false
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_UTF8_BEGIN,length):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.Utf8Begin,length,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);true
pub fn rt_hal_shape_write_utf8_byte(cursor: RtHalShapeCursor,value: u8) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    val cell=shape_lane_offset(lane);val pc=_shape_cursor_pc[cell]
    if pc<0 or pc>=_shape_cursor_end[cell] or _shape_op[pc]!=_SOP_UTF8_END:return shape_fail(lane,RtHalShapeError.ShapeMismatch)
    if not rt_hal_codec_hot_write_byte(_shape_cursor_hot[lane],value,true):return shape_fail(lane,RtHalShapeError.CodecRejected)
    true
pub fn rt_hal_shape_end_utf8(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not shape_prepare(lane,_SOP_UTF8_END,0):return false
    if not rt_hal_codec_hot_apply(_shape_cursor_hot[lane],RtHalCodecEvent.Utf8End,0,0u64):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane);shape_after_value(lane);true

pub fn rt_hal_shape_finish(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    val cell=shape_lane_offset(lane)
    if _shape_cursor_depth[cell]!=0 or not shape_prepare(lane,_SOP_ROOT_END,0):return shape_fail(lane,RtHalShapeError.Incomplete)
    # Prove exact program exhaustion before releasing the underlying lease.
    # A malformed/corrupted program therefore remains abortable and cannot
    # strand an active shape cursor after codec finalization.
    if _shape_cursor_pc[cell]+1!=_shape_cursor_end[cell]:return shape_fail(lane,RtHalShapeError.Incomplete)
    if not rt_hal_codec_hot_lease_finish(_shape_cursor_hot[lane]):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_advance(lane)
    shape_clear_lane_metadata(lane)
    _shape_cursor_state[lane].store(0,MemoryOrdering.Release);true

# Terminal cancellation, not transactional rewind. The cursor lease is
# released so cold teardown can proceed, but the codec retains its partial
# root/event state. Consequently `rt_hal_codec_complete` and snapshot finalize
# remain fail-closed; callers must tear down this codec generation and may not
# retry another root on it.
pub fn rt_hal_shape_abort(cursor: RtHalShapeCursor) ->bool:
    val lane=shape_cursor_lane(cursor);if lane<0:return false
    if not rt_hal_codec_hot_lease_abort(_shape_cursor_hot[lane]):return shape_fail(lane,RtHalShapeError.CodecRejected)
    shape_clear_lane_metadata(lane)
    _shape_cursor_state[lane].store(0,MemoryOrdering.Release);true

pub fn rt_hal_shape_error(cursor: RtHalShapeCursor) ->RtHalShapeError:
    val lane=shape_cursor_lane(cursor)
    if lane<0:return RtHalShapeError.StaleReceipt
    _shape_cursor_error[shape_lane_offset(lane)]

