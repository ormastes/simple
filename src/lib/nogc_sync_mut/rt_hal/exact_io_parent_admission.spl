# codex-impl
# Parent-only parser and reconstruction for the bounded RT/HAL v2 result frame.
#
# Wire layout (all integers little-endian signed i64):
#   "RTHIOV2\0", version, case_id, request_index, provider_ordinal, schema_id,
#   outcome, observed_once, truncated,
#   five {schema,lane0,lane1,lane2,lane3,descriptor_length,valid} candidates,
#   five descriptor byte strings (their candidate lengths are authoritative),
#   three {encoding,event_count,payload_length,event[tag,arg]...,payload...}
#   streams in output,error,effect order.
# The wire lease owns all bytes. This module retains only scalar offsets and
# owner-issued admissions; no foreign identity scalar becomes authority.

use std.common.rt_hal.exact_type_id.{RtHalExactTypeForeignCandidate,
    RT_HAL_EXACT_TYPE_ID_VERSION,RT_HAL_EXACT_TYPE_ID_MAX_DESCRIPTOR_BYTES}
use std.common.string_core.{bytes_to_text}
use std.nogc_sync_mut.rt_hal.exact_io_wire_owner.{RT_HAL_EXACT_WIRE_RESULT,
    RtHalExactWireHandle,RtHalExactWireStatus,rt_hal_exact_wire_view,
    rt_hal_exact_wire_byte_at}
use std.nogc_sync_mut.rt_hal.exact_io_schema.{RT_HAL_EXACT_IO_VERSION_V2,
    RtHalExactEncoding,RtHalExactOutcomeKind,RtHalExactIoParentBatch}
use std.nogc_sync_mut.rt_hal.exact_type_identity_owner.{
    RtHalExactTypeRegistryOwner,RtHalExactTypeRegistrySeal,
    RtHalExactTypeAdmission,RtHalExactTypeAdmissionBatch,RtHalExactTypeCodecOwner,
    rt_hal_exact_type_registry_readmit_five,rt_hal_exact_type_registry_bind_codec,
    rt_hal_exact_type_registry_unbind_codec,rt_hal_exact_type_codec_generation,
    rt_hal_exact_type_codec_root_id,rt_hal_exact_type_codec_admit_five}
use std.nogc_sync_mut.rt_hal.exact_byte_codec_owner.{RtHalCodecRootDomain,
    RtHalExactIoCodecSnapshot,rt_hal_codec_snapshot_finalize,
    rt_hal_codec_snapshot_error,rt_hal_codec_snapshot_release,RtHalCodecError}
use std.nogc_sync_mut.rt_hal.exact_shape_program_owner.{RtHalShapeCursor,
    rt_hal_shape_begin,rt_hal_shape_abort,rt_hal_shape_finish,
    rt_hal_shape_begin_tuple,rt_hal_shape_end_tuple,
    rt_hal_shape_begin_array,rt_hal_shape_end_array,
    rt_hal_shape_begin_result,rt_hal_shape_end_result,
    rt_hal_shape_write_unit,rt_hal_shape_write_bool,
    rt_hal_shape_write_i8,rt_hal_shape_write_i16,rt_hal_shape_write_i32,
    rt_hal_shape_write_i64,rt_hal_shape_write_u8,rt_hal_shape_write_u16,
    rt_hal_shape_write_u32,rt_hal_shape_write_u64,
    rt_hal_shape_write_char,
    rt_hal_shape_write_f32_bits,rt_hal_shape_write_f64_bits,
    rt_hal_shape_begin_bytes,rt_hal_shape_write_byte,rt_hal_shape_end_bytes,
    rt_hal_shape_begin_utf8,rt_hal_shape_write_utf8_byte,rt_hal_shape_end_utf8}

const _RTHAL_PARENT_HEADER_BYTES: i64=72
const _RTHAL_PARENT_CANDIDATE_BYTES: i64=56
const _RTHAL_PARENT_STREAM_HEADER_BYTES: i64=24
pub const RT_HAL_EXACT_IO_WIRE_ENCODING_TRANSCRIPT: i64=6
# Codec event 19 represents both u32 and char. The untrusted semantic wire must
# distinguish char so the frozen descriptor program can validate it; replay
# lowers this tag back to the canonical codec u32 event.
pub const RT_HAL_EXACT_IO_WIRE_EVENT_CHAR: i64=27

pub struct RtHalExactIoWireStream:
    encoding: i64
    events_offset: i64
    event_count: i64
    payload_offset: i64
    payload_length: i64

pub class RtHalExactIoParsedResult:
    wire: RtHalExactWireHandle
    case_id: i64
    request_index: i64
    provider_ordinal: i64
    schema_id: i64
    outcome: i64
    admissions: RtHalExactTypeAdmissionBatch
    output: RtHalExactIoWireStream
    error: RtHalExactIoWireStream
    effect: RtHalExactIoWireStream
    valid: bool
    problem: text

fn parent_invalid(wire: RtHalExactWireHandle,problem: text) ->RtHalExactIoParsedResult:
    val invalid=RtHalExactTypeAdmissionBatch(
        operation: RtHalExactTypeAdmission.invalid_probe(),
        input: RtHalExactTypeAdmission.invalid_probe(),
        output: RtHalExactTypeAdmission.invalid_probe(),
        error: RtHalExactTypeAdmission.invalid_probe(),
        effect: RtHalExactTypeAdmission.invalid_probe(),valid:false)
    val stream=RtHalExactIoWireStream(encoding:0,events_offset:0,event_count:0,
        payload_offset:0,payload_length:0)
    RtHalExactIoParsedResult(wire:wire,case_id:-1,request_index:-1,
        provider_ordinal:-1,schema_id:0,outcome:-1,admissions:invalid,
        output: stream,error:stream,effect:stream,valid:false,problem:problem)

fn parent_u8(wire: RtHalExactWireHandle,index: i64,length: i64) ->i64:
    if index<0 or index>=length:return -1
    rt_hal_exact_wire_byte_at(wire,index)

fn parent_i64(wire: RtHalExactWireHandle,index: i64,length: i64) ->i64:
    if index<0 or index>length-8:return -1
    var bits: u64=0u64;var lane=0
    while lane<8:
        val byte=parent_u8(wire,index+lane,length)
        if byte<0:return -1
        bits=bits|((byte as u64)<<(lane*8));lane=lane+1
    bits as i64

fn parent_magic_byte(index: i64) ->i64:
    match index:
        case 0:82
        case 1:84
        case 2:72
        case 3:73
        case 4:79
        case 5:86
        case 6:50
        case 7:0
        case _: -1

fn parent_candidate(wire: RtHalExactWireHandle,index: i64,length: i64) ->RtHalExactTypeForeignCandidate:
    val schema=parent_i64(wire,index,length);val descriptor_length=parent_i64(wire,index+40,length)
    val valid=parent_i64(wire,index+48,length)==1
    RtHalExactTypeForeignCandidate(schema_version:schema,
        lane0: parent_i64(wire,index+8,length),lane1:parent_i64(wire,index+16,length),
        lane2: parent_i64(wire,index+24,length),lane3:parent_i64(wire,index+32,length),
        descriptor_length: descriptor_length,valid:valid)

fn parent_descriptor(wire: RtHalExactWireHandle,index: i64,count: i64,length: i64) ->text:
    if count<=0 or count>RT_HAL_EXACT_TYPE_ID_MAX_DESCRIPTOR_BYTES:return ""
    if index<0 or index>length-count:return ""
    var bytes: [u8]=[0u8;count];var lane=0
    while lane<count:
        val byte=parent_u8(wire,index+lane,length)
        if byte<0:return ""
        bytes[lane]=byte as u8;lane=lane+1
    bytes_to_text(bytes)

fn parent_stream(wire: RtHalExactWireHandle,index: i64,length: i64,max_bytes: i64) ->RtHalExactIoWireStream:
    if index<0 or index>length-_RTHAL_PARENT_STREAM_HEADER_BYTES:
        return RtHalExactIoWireStream(encoding:-1,events_offset:0,event_count:-1,payload_offset:0,payload_length:-1)
    val encoding=parent_i64(wire,index,length);val events=parent_i64(wire,index+8,length)
    val payload=parent_i64(wire,index+16,length)
    if encoding!=RT_HAL_EXACT_IO_WIRE_ENCODING_TRANSCRIPT or events<2 or payload<0 or events>max_bytes/16 or payload>max_bytes-events*16:
        return RtHalExactIoWireStream(encoding:-1,events_offset:0,event_count:-1,payload_offset:0,payload_length:-1)
    val events_offset=index+_RTHAL_PARENT_STREAM_HEADER_BYTES
    val payload_offset=events_offset+events*16
    if payload_offset<events_offset or payload_offset>length or payload>length-payload_offset:
        return RtHalExactIoWireStream(encoding:-1,events_offset:0,event_count:-1,payload_offset:0,payload_length:-1)
    RtHalExactIoWireStream(encoding:encoding,events_offset:events_offset,
        event_count: events,payload_offset:payload_offset,payload_length:payload)

fn parent_stream_end(stream: RtHalExactIoWireStream) ->i64:
    if stream.event_count<0 or stream.payload_length<0:return -1
    stream.payload_offset+stream.payload_length

pub fn rt_hal_exact_io_parent_readmit(registry: RtHalExactTypeRegistryOwner,
        wire: RtHalExactWireHandle,max_retained_bytes: i64) ->RtHalExactIoParsedResult:
    val view=rt_hal_exact_wire_view(wire)
    if (view.version!=RT_HAL_EXACT_IO_VERSION_V2 or view.kind!=RT_HAL_EXACT_WIRE_RESULT or
        view.status!=RtHalExactWireStatus.Completed or view.byte_length<_RTHAL_PARENT_HEADER_BYTES or
        max_retained_bytes<=0 or view.byte_length>max_retained_bytes):
        return parent_invalid(wire,"RTHAL-E-IO-WIRE")
    var cursor=0
    while cursor<8:
        if parent_u8(wire,cursor,view.byte_length)!=parent_magic_byte(cursor):
            return parent_invalid(wire,"RTHAL-E-PROTOCOL")
        cursor=cursor+1
    val version=parent_i64(wire,8,view.byte_length)
    val case_id=parent_i64(wire,16,view.byte_length)
    val request_index=parent_i64(wire,24,view.byte_length)
    # Foreign frames carry a zero sentinel, never parent scheduling authority.
    val transported_ordinal=parent_i64(wire,32,view.byte_length)
    val provider_ordinal=view.provider_ordinal
    val schema_id=parent_i64(wire,40,view.byte_length)
    val outcome=parent_i64(wire,48,view.byte_length)
    val observed=parent_i64(wire,56,view.byte_length)
    val truncated=parent_i64(wire,64,view.byte_length)
    if (version!=RT_HAL_EXACT_IO_VERSION_V2 or case_id!=view.case_id or
        request_index!=view.request_index or transported_ordinal!=0 or
        case_id<0 or request_index<0 or provider_ordinal<=0 or schema_id<=0 or
        outcome<0 or outcome>4 or observed!=1 or truncated!=0):
        return parent_invalid(wire,"RTHAL-E-IO-RECEIPT")
    cursor=_RTHAL_PARENT_HEADER_BYTES
    if cursor>view.byte_length-5*_RTHAL_PARENT_CANDIDATE_BYTES:
        return parent_invalid(wire,"RTHAL-E-PROTOCOL")
    val operation_candidate=parent_candidate(wire,cursor,view.byte_length);cursor=cursor+56
    val input_candidate=parent_candidate(wire,cursor,view.byte_length);cursor=cursor+56
    val output_candidate=parent_candidate(wire,cursor,view.byte_length);cursor=cursor+56
    val error_candidate=parent_candidate(wire,cursor,view.byte_length);cursor=cursor+56
    val effect_candidate=parent_candidate(wire,cursor,view.byte_length);cursor=cursor+56
    if (not operation_candidate.valid or not input_candidate.valid or
        not output_candidate.valid or not error_candidate.valid or not effect_candidate.valid or
        operation_candidate.schema_version!=RT_HAL_EXACT_TYPE_ID_VERSION or
        input_candidate.schema_version!=RT_HAL_EXACT_TYPE_ID_VERSION or
        output_candidate.schema_version!=RT_HAL_EXACT_TYPE_ID_VERSION or
        error_candidate.schema_version!=RT_HAL_EXACT_TYPE_ID_VERSION or
        effect_candidate.schema_version!=RT_HAL_EXACT_TYPE_ID_VERSION):
        return parent_invalid(wire,"RTHAL-E-IO-TYPE")
    val operation_text=parent_descriptor(wire,cursor,operation_candidate.descriptor_length,view.byte_length)
    cursor=cursor+operation_candidate.descriptor_length
    val input_text=parent_descriptor(wire,cursor,input_candidate.descriptor_length,view.byte_length)
    cursor=cursor+input_candidate.descriptor_length
    val output_text=parent_descriptor(wire,cursor,output_candidate.descriptor_length,view.byte_length)
    cursor=cursor+output_candidate.descriptor_length
    val error_text=parent_descriptor(wire,cursor,error_candidate.descriptor_length,view.byte_length)
    cursor=cursor+error_candidate.descriptor_length
    val effect_text=parent_descriptor(wire,cursor,effect_candidate.descriptor_length,view.byte_length)
    cursor=cursor+effect_candidate.descriptor_length
    if operation_text=="" or input_text=="" or output_text=="" or error_text=="" or effect_text=="":
        return parent_invalid(wire,"RTHAL-E-IO-TYPE")
    val output_stream=parent_stream(wire,cursor,view.byte_length,max_retained_bytes)
    cursor=parent_stream_end(output_stream)
    val error_stream=parent_stream(wire,cursor,view.byte_length,max_retained_bytes)
    cursor=parent_stream_end(error_stream)
    val effect_stream=parent_stream(wire,cursor,view.byte_length,max_retained_bytes)
    cursor=parent_stream_end(effect_stream)
    if cursor!=view.byte_length:return parent_invalid(wire,"RTHAL-E-PROTOCOL")
    # Mutation is deliberately last: malformed framing cannot insert even a
    # valid five-type prefix into the controller registry.
    val admissions=rt_hal_exact_type_registry_readmit_five(registry,
        operation_candidate,operation_text,input_candidate,input_text,
        output_candidate,output_text,error_candidate,error_text,effect_candidate,effect_text)
    if not admissions.valid:return parent_invalid(wire,"RTHAL-E-IO-TYPE")
    RtHalExactIoParsedResult(wire:wire,case_id:case_id,request_index:request_index,
        provider_ordinal: provider_ordinal,schema_id:schema_id,outcome:outcome,
        admissions: admissions,output:output_stream,error:error_stream,
        effect: effect_stream,valid:true,problem:"")

fn parent_event_tag(wire: RtHalExactWireHandle,stream: RtHalExactIoWireStream,index: i64,length: i64) ->i64:
    parent_i64(wire,stream.events_offset+index*16,length)
fn parent_event_arg(wire: RtHalExactWireHandle,stream: RtHalExactIoWireStream,index: i64,length: i64) ->i64:
    parent_i64(wire,stream.events_offset+index*16+8,length)
fn parent_payload_u64(wire: RtHalExactWireHandle,stream: RtHalExactIoWireStream,
        offset: i64,width: i64,length: i64) ->u64:
    if width<0 or width>8 or offset<0 or offset>stream.payload_length-width:return 0u64
    var bits: u64=0u64;var lane=0
    while lane<width:
        bits=bits|((parent_u8(wire,stream.payload_offset+offset+lane,length) as u64)<<(lane*8));lane=lane+1
    bits

fn parent_apply_event(cursor: RtHalShapeCursor,wire: RtHalExactWireHandle,
        stream: RtHalExactIoWireStream,tag: i64,arg: i64,payload_cursor: i64,length: i64) ->(bool,i64):
    match tag:
        case 3:return (rt_hal_shape_begin_tuple(cursor,arg),payload_cursor)
        case 4:return (rt_hal_shape_end_tuple(cursor),payload_cursor)
        case 5:return (rt_hal_shape_begin_array(cursor,arg),payload_cursor)
        case 6:return (rt_hal_shape_end_array(cursor),payload_cursor)
        case 7:return (rt_hal_shape_begin_result(cursor,true),payload_cursor)
        case 8:return (rt_hal_shape_end_result(cursor,true),payload_cursor)
        case 9:return (rt_hal_shape_begin_result(cursor,false),payload_cursor)
        case 10:return (rt_hal_shape_end_result(cursor,false),payload_cursor)
        case 11:return (arg==0 and rt_hal_shape_write_unit(cursor),payload_cursor)
        case 12:
            val bits=parent_payload_u64(wire,stream,payload_cursor,1,length)
            return (arg==1 and bits<=1u64 and rt_hal_shape_write_bool(cursor,bits==1u64),payload_cursor+1)
        case 13:return (arg==1 and rt_hal_shape_write_i8(cursor,parent_payload_u64(wire,stream,payload_cursor,1,length) as i8),payload_cursor+1)
        case 14:return (arg==2 and rt_hal_shape_write_i16(cursor,parent_payload_u64(wire,stream,payload_cursor,2,length) as i16),payload_cursor+2)
        case 15:return (arg==4 and rt_hal_shape_write_i32(cursor,parent_payload_u64(wire,stream,payload_cursor,4,length) as i32),payload_cursor+4)
        case 16:return (arg==8 and rt_hal_shape_write_i64(cursor,parent_payload_u64(wire,stream,payload_cursor,8,length) as i64),payload_cursor+8)
        case 17:return (arg==1 and rt_hal_shape_write_u8(cursor,parent_payload_u64(wire,stream,payload_cursor,1,length) as u8),payload_cursor+1)
        case 18:return (arg==2 and rt_hal_shape_write_u16(cursor,parent_payload_u64(wire,stream,payload_cursor,2,length) as u16),payload_cursor+2)
        case 19:return (arg==4 and rt_hal_shape_write_u32(cursor,parent_payload_u64(wire,stream,payload_cursor,4,length) as u32),payload_cursor+4)
        case 20:return (arg==8 and rt_hal_shape_write_u64(cursor,parent_payload_u64(wire,stream,payload_cursor,8,length)),payload_cursor+8)
        case 21:return (arg==4 and rt_hal_shape_write_f32_bits(cursor,parent_payload_u64(wire,stream,payload_cursor,4,length) as u32),payload_cursor+4)
        case 22:return (arg==8 and rt_hal_shape_write_f64_bits(cursor,parent_payload_u64(wire,stream,payload_cursor,8,length)),payload_cursor+8)
        case 27:return (arg==4 and rt_hal_shape_write_char(cursor,parent_payload_u64(wire,stream,payload_cursor,4,length) as u32),payload_cursor+4)
        case 23:return (rt_hal_shape_begin_bytes(cursor,arg),payload_cursor)
        case 24:return (rt_hal_shape_end_bytes(cursor),payload_cursor)
        case 25:return (rt_hal_shape_begin_utf8(cursor,arg),payload_cursor)
        case 26:return (rt_hal_shape_end_utf8(cursor),payload_cursor)
    (false,payload_cursor)

fn parent_replay_stream(codec_generation: i64,domain: RtHalCodecRootDomain,root_id: i64,
        wire: RtHalExactWireHandle,stream: RtHalExactIoWireStream,length: i64) ->bool:
    if stream.event_count<2:return false
    val first_tag=parent_event_tag(wire,stream,0,length)
    val first_arg=parent_event_arg(wire,stream,0,length)
    val last_tag=parent_event_tag(wire,stream,stream.event_count-1,length)
    val domain_code=match domain:
        case Operation:1
        case Input:2
        case Output:3
        case Error:4
        case Effect:5
    # The child cannot know the parent registry receipt. Only the domain lane
    # is portable; shape_begin emits the admitted parent root ID.
    if first_tag!=1 or last_tag!=2 or (first_arg>>32)!=domain_code:return false
    val cursor=rt_hal_shape_begin(codec_generation,domain,root_id)
    var event_index=1;var payload_cursor=0
    while event_index<stream.event_count-1:
        val tag=parent_event_tag(wire,stream,event_index,length)
        val arg=parent_event_arg(wire,stream,event_index,length)
        if tag==23 or tag==25:
            val started=parent_apply_event(cursor,wire,stream,tag,arg,payload_cursor,length)
            if not started.0 or arg<0 or payload_cursor>stream.payload_length-arg:
                rt_hal_shape_abort(cursor);return false
            var byte_index=0
            while byte_index<arg:
                val byte=parent_u8(wire,stream.payload_offset+payload_cursor+byte_index,length)
                val wrote=if tag==23:rt_hal_shape_write_byte(cursor,byte as u8) else:rt_hal_shape_write_utf8_byte(cursor,byte as u8)
                if byte<0 or not wrote:rt_hal_shape_abort(cursor);return false
                byte_index=byte_index+1
            payload_cursor=payload_cursor+arg
        else:
            var width=0
            if tag==12 or tag==13 or tag==17:width=1
            elif tag==14 or tag==18:width=2
            elif tag==15 or tag==19 or tag==21 or tag==27:width=4
            elif tag==16 or tag==20 or tag==22:width=8
            if width>0 and payload_cursor>stream.payload_length-width:
                rt_hal_shape_abort(cursor);return false
            val applied=parent_apply_event(cursor,wire,stream,tag,arg,payload_cursor,length)
            if not applied.0 or applied.1>stream.payload_length:
                rt_hal_shape_abort(cursor);return false
            payload_cursor=applied.1
        event_index=event_index+1
    if payload_cursor!=stream.payload_length or not rt_hal_shape_finish(cursor):
        rt_hal_shape_abort(cursor);return false
    true

pub struct RtHalExactIoReconstructed:
    codec: RtHalExactTypeCodecOwner
    snapshot: RtHalExactIoCodecSnapshot
    valid: bool

pub fn rt_hal_exact_io_parent_reconstruct(registry: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal,parsed: RtHalExactIoParsedResult,
        domain: RtHalCodecRootDomain) ->RtHalExactIoReconstructed:
    val codec=rt_hal_exact_type_registry_bind_codec(registry,seal)
    val generation=rt_hal_exact_type_codec_generation(codec)
    var admission=parsed.admissions.output;var stream=parsed.output
    if domain==RtHalCodecRootDomain.Error:admission=parsed.admissions.error;stream=parsed.error
    elif domain==RtHalCodecRootDomain.Effect:admission=parsed.admissions.effect;stream=parsed.effect
    elif domain!=RtHalCodecRootDomain.Output:
        return RtHalExactIoReconstructed(codec:codec,snapshot:rt_hal_codec_snapshot_finalize(0),valid:false)
    val root_id=rt_hal_exact_type_codec_root_id(codec,seal,admission)
    if (not parsed.valid or generation<=0 or root_id<=0 or
        not rt_hal_exact_type_codec_admit_five(codec,seal,parsed.admissions) or
        not parent_replay_stream(generation,domain,root_id,parsed.wire,stream,
            rt_hal_exact_wire_view(parsed.wire).byte_length)):
        return RtHalExactIoReconstructed(codec:codec,snapshot:rt_hal_codec_snapshot_finalize(0),valid:false)
    val snapshot=rt_hal_codec_snapshot_finalize(generation)
    RtHalExactIoReconstructed(codec:codec,snapshot:snapshot,
        valid:rt_hal_codec_snapshot_error(snapshot)==RtHalCodecError.None)

pub fn rt_hal_exact_io_parent_commit_three(registry: RtHalExactTypeRegistryOwner,
        seal: RtHalExactTypeRegistrySeal,batch: RtHalExactIoParentBatch,
        output: RtHalExactIoReconstructed,error: RtHalExactIoReconstructed,
        effect: RtHalExactIoReconstructed,ordinal_base: i64) ->bool:
    var committed=false
    if ordinal_base<0 or not output.valid or not error.valid or not effect.valid:
        if output.valid:rt_hal_codec_snapshot_release(output.snapshot)
        if error.valid:rt_hal_codec_snapshot_release(error.snapshot)
        if effect.valid:rt_hal_codec_snapshot_release(effect.snapshot)
        batch.abort()
    elif not batch.add(output.snapshot,ordinal_base):
        rt_hal_codec_snapshot_release(error.snapshot)
        rt_hal_codec_snapshot_release(effect.snapshot)
    elif not batch.add(error.snapshot,ordinal_base+1):
        rt_hal_codec_snapshot_release(effect.snapshot)
    elif batch.add(effect.snapshot,ordinal_base+2):committed=batch.commit()
    val output_released=rt_hal_exact_type_registry_unbind_codec(registry,seal,output.codec)
    val error_released=rt_hal_exact_type_registry_unbind_codec(registry,seal,error.codec)
    val effect_released=rt_hal_exact_type_registry_unbind_codec(registry,seal,effect.codec)
    committed and output_released and error_released and effect_released
