pub enum KpfSyncStatus:
    Ok
    CapacityExceeded
    StaleHandle
    SlotVacant
    GenerationNotActive
    GenerationStillPinned
    GenerationNotRetired
    RegistrySealed
    RegistryNotSealed
    RegistryDuplicate
    RegistryMissing
    IdentityMissing

impl KpfSyncStatus:
    pub fn accepted() -> bool:
        match self:
            case Ok: true
            case _: false

    pub fn code() -> i32:
        match self:
            case Ok: 0
            case CapacityExceeded: 1
            case StaleHandle: 2
            case SlotVacant: 3
            case GenerationNotActive: 4
            case GenerationStillPinned: 5
            case GenerationNotRetired: 6
            case RegistrySealed: 7
            case RegistryNotSealed: 8
            case RegistryDuplicate: 9
            case RegistryMissing: 10
            case IdentityMissing: 11
