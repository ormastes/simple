# Platform Abstraction Layer
#
# Provides convenient platform-agnostic functions for:
# - Platform detection (Windows/Unix/macOS/Linux)
# - Path handling (separators, normalization) - delegates to std.path
# - Command resolution (executable extensions)
#
# Pure Simple implementation using shell commands (uname) for platform detection.
# Uses direct extern fn calls to avoid bootstrap runtime import issues.

use std.io_runtime.{env_get}
use std.io_runtime.{process_run}
use std.io_runtime.{file_exists}

# Re-export the canonical path functions directly. Treating a bare imported
# module (`path`) as a runtime value produced an undeclared LLVM global.
export use nogc_sync_mut.path.{normalize_path, is_absolute_path, join_path}
use nogc_sync_mut.target_ext.{target_lib_ext, target_exe_ext}
use nogc_sync_mut.fs.host_path.{host_path_native}
# SELF-RECURSION FIX (2026-09-03): importing `is_windows` into a file that also
# DEFINES `is_windows` makes the AOT lowering bind the alias to the LOCAL
# definition -- a silent infinite self-call (stack overflow), which is what
# killed the Windows MSVC stage 2 candidate. Import the underlying resolver
# `detect_os`, whose bare name collides with nothing here; `env.platform`s
# `is_windows` is literally `detect_os() == "windows"`, so semantics are
# unchanged. Compiler defect:
# doc/08_tracking/bug/aliased_import_shadowed_by_local_fn_native_codegen_2026-09-03.md
use std.nogc_sync_mut.env.platform.{detect_os as platform_detect_os}

# Re-export path operations from std.path

# ===========================================================================
# Platform Detection - Pure Simple Implementation
# ===========================================================================

fn shell_output_trim(command: text) -> text:
    """Run shell command and return trimmed stdout."""
    val result = process_run("/bin/sh", ["-c", command])
    val stdout = result[0]
    val code = result[2]
    if code == 0:
        stdout.trim()
    else:
        ""

# FAIL-OPEN FIX (2026-09-02): read ONLY `OS` and returned false when unset --
# a silent "not Windows" under a stripped environment (where a bootstrap runs).
# Delegate to the single resolver in std.nogc_sync_mut.env.platform, which
# consults the in-process rt_platform_name() primitive first.
fn is_windows_env() -> bool:
    """True when the running host is Windows."""
    platform_detect_os() == "windows"

pub fn host_os() -> text:
    """Internal helper to get host OS using Pure Simple implementation."""
    if is_windows_env():
        "windows"
    else:
        # Unix: Use uname -s
        val os = shell_output_trim("uname -s")
        if os.len() == 0:
            "linux"  # Default
        else:
            match os:
                case "Linux": "linux"
                case "Darwin": "macos"
                case "FreeBSD": "freebsd"
                case "OpenBSD": "openbsd"
                case "NetBSD": "netbsd"
                case _: os.lower()

pub fn host_arch() -> text:
    """Get host CPU architecture using Pure Simple implementation."""
    if is_windows_env():
        # Windows: Use PROCESSOR_ARCHITECTURE env var
        val arch_env = env_get("PROCESSOR_ARCHITECTURE")
        if arch_env == nil:
            "x86_64"  # Default
        else:
            match arch_env:
                case "AMD64": "x86_64"
                case "ARM64": "aarch64"
                case "x86": "i686"
                case _: arch_env.lower()
    else:
        # Unix: Use uname -m
        val arch = shell_output_trim("uname -m")
        if arch.len() == 0:
            "x86_64"  # Default
        else:
            match arch:
                case "x86_64": "x86_64"
                case "amd64": "x86_64"
                case "arm64": "aarch64"
                case "aarch64": "aarch64"
                case "riscv64": "riscv64"
                case "i686": "i686"
                case "i386": "i686"
                case _: arch

# Deprecated: use host_os instead
pub fn get_host_os() -> text:
    host_os()
# Deprecated: use host_arch instead
pub fn get_host_arch() -> text:
    host_arch()

pub fn is_windows() -> bool:
    """Returns true if running on Windows."""
    host_os() == "windows"

pub fn is_unix() -> bool:
    """Returns true if running on Unix-like system (Linux, macOS, BSD)."""
    val os = host_os()
    os == "linux" or os == "macos" or os == "freebsd" or os == "openbsd" or os == "netbsd"

pub fn is_macos() -> bool:
    """Returns true if running on macOS."""
    host_os() == "macos"

pub fn is_linux() -> bool:
    """Returns true if running on Linux."""
    host_os() == "linux"

# ===========================================================================
# Path Separators - Pure Simple Implementation
# ===========================================================================

pub fn dir_sep() -> text:
    """Returns the directory separator for the current platform."""
    if is_windows():
        "\\"
    else:
        "/"

pub fn to_native_path(path: text) -> text:
    """Convert a canonical forward-slash path to this platform's NATIVE form.

    This is THE single conversion point for Windows separator variation. Call it
    at the boundary where a native path is genuinely required -- handing a path
    to a spawned process (argv), or to a native tool's response file -- and
    nowhere else.

    Boundary evidence (measured by execution, Windows 11, 2026-09-01, one file,
    two forms):
      - Win32 file API in-process: BOTH "C:\a\b.txt" and "C:/a/b.txt" read OK.
        Filesystem I/O therefore needs NO conversion; converting there is
        redundant work, not a fix.
      - spawned `cmd.exe /c type <path>`: backslash form -> exit 0 with the file
        contents; forward-slash form -> exit 1, "The syntax of the command is
        incorrect." This is the documented "fails mute" class.

    CROSS-PLATFORM IMPACT: on every non-Windows platform this is the IDENTITY
    function -- it returns its argument unchanged, byte for byte. That is
    deliberate and is not a simplification. A backslash is a LEGAL character in
    a POSIX filename, so rewriting "\\" -> "/" off Windows would silently
    corrupt a real path. A dead helper in fs/path.spl did exactly that on its Unix
    branch; it had zero callers and has been deleted.

    Apply ONLY to a value already known to be a filesystem path. A URL, a CLI
    switch, or a regex also contains "/" and would be mangled.

    Example:
        to_native_path("C:/tmp/a.txt")   # Windows -> "C:\tmp\a.txt"
                                         # POSIX   -> "C:/tmp/a.txt" (unchanged)

    IMPLEMENTATION: this is now a thin alias for std.nogc_sync_mut.fs.host_path
    host_path_native, which is THE one boundary converter (see the collision note
    in that file). Two independent conversion points is how a boundary rots; this
    name survives because it is the documented public spelling and has specs, but
    the logic lives in exactly one place. host_path_native additionally handles
    the MinGW /d/foo -> d:\foo drive form, which this branch never did -- a
    superset, so no existing caller changes behaviour.

    It is also strictly cheaper: is_windows() -> host_os() SPAWNS `/bin/sh -c
    "uname -s"` on every non-Windows call. host_path_native caches its platform
    decision for the life of the process and returns the argument itself off
    Windows.
    """
    host_path_native(path)

pub fn path_sep() -> text:
    """Returns the PATH environment variable separator."""
    if is_windows():
        ";"
    else:
        ":"

pub fn exe_ext() -> text:
    """Returns the executable extension for the build target.

    Delegates to the target_ext seam so the variants/ platform overlay can bake
    a fixed extension for an explicit build target; default/auto = host.
    """
    target_exe_ext()

pub fn lib_ext() -> text:
    """Returns the dynamic library extension for the build target.

    Delegates to the target_ext seam so the variants/ platform overlay can bake
    a fixed extension for an explicit build target; default/auto = host.
    """
    target_lib_ext()

# ===========================================================================
# Command Resolution
# ===========================================================================

pub fn resolve_command(cmd: text) -> text:
    if not is_windows():
        return cmd  # Unix: use PATH directly

    # Windows: add .exe if missing, search in PATH
    var resolved = cmd
    if not cmd.ends_with(".exe") and not cmd.ends_with(".bat") and not cmd.ends_with(".cmd"):
        resolved = "{cmd}.exe"

    # Check if absolute path
    if is_absolute_path(resolved):
        return resolved

    # Search in PATH
    extern fn env_get(key: text) -> text
    val path_env = env_get("PATH")
    val paths = path_env.split(path_sep())

    for dir in paths:
        val candidate = join_path(dir, resolved)
        if file_exists(candidate):
            return candidate

    cmd  # Return original if not found

# Alias: is_absolute is the canonical name used by fs/path.spl
fn is_absolute(path: text) -> bool:
    is_absolute_path(path)

# home_dir — returns the user's home directory
extern fn rt_env_home() -> text
fn home_dir() -> text:
    rt_env_home()

export is_absolute, home_dir
export host_os, host_arch, get_host_os, get_host_arch
export is_windows, is_unix, is_macos, is_linux
export dir_sep, path_sep, exe_ext, lib_ext
export resolve_command
