"""
# Storefront Vertical — customer browse -> cart -> checkout -> receipt

Lane W21-B of the Simple Enterprise Suite. The customer-facing flow over the
durable enterprise store:

    cart_add / cart_remove (insert-only event log)
        -> checkout (fold to a total; emit immutable order + receipt)
        -> receipt_of (pure read)

Every write runs the frozen guarded sequence over the durable store:

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

## RBAC — reuses the frozen `sales` role via a LOCAL gate (no new grant)

`foundation.role_allows` is FROZEN and must not change. A customer-journey actor
maps naturally to the `sales` role, so this vertical AUTHORIZES through a local
`storefront_role_allows` gate (exactly like `crm_role_allows`) that grants the
existing `sales` role its storefront actions — no row is added to the frozen
table and `rbac_registry.spl` is not touched.

## Storage model — insert-only + derive (never UPDATE)

- `sf_cart_events`: append-only cart event stream. Each row is an `add` or
  `remove` line event `(cart_id, sku, qty, price)`. The CURRENT cart is a pure
  fold over this stream: for each SKU the LAST event wins — a later `add`
  re-sets qty/price, a later `remove` drops the line. Money in integer minor
  units (cents); never floats.
- `sf_orders` / `sf_receipts`: one immutable row each, emitted by checkout. The
  order total is a fold over the cart at checkout time, frozen into the receipt.

Empty-cart checkout is denied with the closed-set reason `invalid-record` (no
existing reason names "empty cart"; per the lane contract an empty cart is an
invalid record). Checking out an already-checked-out cart is denied
`invalid-transition` with no effect. A replayed idempotency key returns
`duplicate-key` and emits no second order.

sha256 audit is taken only via the enterprise_store facade
(`records.audit_append` -> `audit_hash.audit_sha256_hex`); this module never
imports `std.common.crypto.sha256` directly (cross-OS rule, one codebase).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema
# =============================================================================

fn sf_setup(store: EnterpriseStore) -> bool:
    var ok = store_migrate(store, "sf_001_cart_events",
        "CREATE TABLE IF NOT EXISTS sf_cart_events (id INTEGER PRIMARY KEY, tenant_id TEXT, cart_id TEXT, event TEXT, sku TEXT, qty TEXT, price TEXT)")
    ok = ok and store_migrate(store, "sf_002_orders",
        "CREATE TABLE IF NOT EXISTS sf_orders (id INTEGER PRIMARY KEY, tenant_id TEXT, order_id TEXT, cart_id TEXT, total TEXT)")
    ok = ok and store_migrate(store, "sf_003_receipts",
        "CREATE TABLE IF NOT EXISTS sf_receipts (id INTEGER PRIMARY KEY, tenant_id TEXT, order_id TEXT, cart_id TEXT, total TEXT, lines TEXT)")
    ok

# =============================================================================
# RBAC — reused 'sales' role via a local gate (see module docstring)
# =============================================================================

fn storefront_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "sales":
        return action == "storefront.cart.add" or action == "storefront.cart.remove" or action == "storefront.checkout"
    false

# =============================================================================
# Derived reads (pure-Simple folds; see store docstring)
# =============================================================================

# sf_cart_skus returns the DISTINCT SKUs ever touched in a tenant's cart, in
# first-seen order (both add and remove events introduce a SKU).
fn sf_cart_skus(store: EnterpriseStore, tenant_id: text, cart_id: text) -> [text]:
    var skus: [text] = []
    val rows = store_rows(store, "sf_cart_events", "id, tenant_id, cart_id, event, sku, qty, price")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "cart_id") == cart_id:
            val sku = sqlite_row_get(row, "sku")
            var seen = false
            for s in skus:
                if s == sku:
                    seen = true
            if not seen:
                skus.push(sku)
    skus

# sf_cart_line folds a single SKU's event stream to its current line as
# (event, qty, price): the LAST event for that SKU wins. event is "" when the
# SKU was never touched, "remove" when its latest event dropped it, "add"
# (with qty/price) when the line is currently present.
fn sf_cart_line(store: EnterpriseStore, tenant_id: text, cart_id: text, sku: text) -> (text, i64, i64):
    var ev = ""
    var qty: i64 = 0
    var price: i64 = 0
    val rows = store_rows(store, "sf_cart_events", "id, tenant_id, cart_id, event, sku, qty, price")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "cart_id") == cart_id and sqlite_row_get(row, "sku") == sku:
            ev = sqlite_row_get(row, "event")
            qty = int(sqlite_row_get(row, "qty"))
            price = int(sqlite_row_get(row, "price"))
    (ev, qty, price)

# sf_cart_count returns the number of currently-present lines (SKUs whose latest
# event is an add).
fn sf_cart_count(store: EnterpriseStore, tenant_id: text, cart_id: text) -> i64:
    var n: i64 = 0
    for sku in sf_cart_skus(store, tenant_id, cart_id):
        if sf_cart_line(store, tenant_id, cart_id, sku).0 == "add":
            n = n + 1
    n

# sf_cart_total folds the current cart to its total in minor units:
# sum of qty*price over present lines.
fn sf_cart_total(store: EnterpriseStore, tenant_id: text, cart_id: text) -> i64:
    var total: i64 = 0
    for sku in sf_cart_skus(store, tenant_id, cart_id):
        val line = sf_cart_line(store, tenant_id, cart_id, sku)
        if line.0 == "add":
            total = total + line.1 * line.2
    total

# sf_order_id_of returns the order id emitted for a cart (checkout mints
# "order-" + cart_id), or "" when the cart has not been checked out.
fn sf_order_id_of(store: EnterpriseStore, tenant_id: text, cart_id: text) -> text:
    var oid = ""
    val rows = store_rows(store, "sf_orders", "id, tenant_id, order_id, cart_id, total")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "cart_id") == cart_id:
            oid = sqlite_row_get(row, "order_id")
    oid

# receipt_of is a pure read: the frozen total of the receipt emitted for an
# order id, or -1 when no such receipt exists for the tenant.
fn receipt_of(store: EnterpriseStore, tenant_id: text, order_id: text) -> i64:
    var total: i64 = -1
    val rows = store_rows(store, "sf_receipts", "id, tenant_id, order_id, cart_id, total, lines")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "order_id") == order_id:
            total = int(sqlite_row_get(row, "total"))
    total

# =============================================================================
# Guarded commands (frozen sequence: session -> rbac -> validation ->
# idempotency -> effects in one unit of work)
# =============================================================================

# cart_add appends an add-line event. Re-adding a SKU re-sets its qty/price.
fn cart_add(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, cart_id: text, sku: text, qty: i64, unit_price_cents: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", cart_id)
    if not storefront_role_allows(who.role, "storefront.cart.add"):
        return denied("forbidden", cart_id)
    if cart_id == "" or sku == "" or qty <= 0 or unit_price_cents < 0:
        return denied("invalid-record", cart_id)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO sf_cart_events (tenant_id, cart_id, event, sku, qty, price) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, cart_id, "add", sku, "{qty}", "{unit_price_cents}"])
    outbox_append(store, tenant.tenant_id, "storefront.cart.line_added", cart_id + ":" + sku)
    audit_append(store, tenant.tenant_id, who.actor_id, "storefront.cart.add", cart_id + ":" + sku + ":{qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, cart_id)
    uow_commit(store)
    accepted(cart_id)

# cart_remove appends a remove-line event, dropping the SKU from the cart.
# Removing a SKU not present is invalid-record (state-independent).
fn cart_remove(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, cart_id: text, sku: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", cart_id)
    if not storefront_role_allows(who.role, "storefront.cart.remove"):
        return denied("forbidden", cart_id)
    if cart_id == "" or sku == "":
        return denied("invalid-record", cart_id)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    if sf_cart_line(store, tenant.tenant_id, cart_id, sku).0 != "add":
        return denied("invalid-record", cart_id + ":" + sku)
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO sf_cart_events (tenant_id, cart_id, event, sku, qty, price) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, cart_id, "remove", sku, "0", "0"])
    outbox_append(store, tenant.tenant_id, "storefront.cart.line_removed", cart_id + ":" + sku)
    audit_append(store, tenant.tenant_id, who.actor_id, "storefront.cart.remove", cart_id + ":" + sku)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, cart_id)
    uow_commit(store)
    accepted(cart_id)

# checkout folds the current cart to a total and emits an immutable order +
# receipt. An empty cart is invalid-record; a cart already checked out is
# invalid-transition (state-dependent, so asked only of a command not already
# recorded); a replayed key returns duplicate-key with no second order.
fn checkout(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, cart_id: text, idempotency_key: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", cart_id)
    if not storefront_role_allows(who.role, "storefront.checkout"):
        return denied("forbidden", cart_id)
    if cart_id == "":
        return denied("invalid-record", cart_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, idempotency_key)
    if not replayed and sf_cart_count(store, tenant.tenant_id, cart_id) <= 0:
        return denied("invalid-record", cart_id)
    if not replayed and sf_order_id_of(store, tenant.tenant_id, cart_id) != "":
        return denied("invalid-transition", cart_id + ":checked-out")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, idempotency_key))
    val order_id = "order-" + cart_id
    val total = sf_cart_total(store, tenant.tenant_id, cart_id)
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO sf_orders (tenant_id, order_id, cart_id, total) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, order_id, cart_id, "{total}"])
    store_insert_row(store,
        "INSERT INTO sf_receipts (tenant_id, order_id, cart_id, total, lines) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, order_id, cart_id, "{total}", "lines={sf_cart_count(store, tenant.tenant_id, cart_id)}"])
    outbox_append(store, tenant.tenant_id, "storefront.order.placed", order_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "storefront.checkout", order_id + ":{total}")
    idempotency_record(store, tenant.tenant_id, idempotency_key, order_id)
    uow_commit(store)
    accepted(order_id)

export sf_setup, storefront_role_allows
export sf_cart_skus, sf_cart_line, sf_cart_count, sf_cart_total
export sf_order_id_of, receipt_of
export cart_add, cart_remove, checkout
