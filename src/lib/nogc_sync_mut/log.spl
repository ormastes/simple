@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# Log Module - Runtime-guarded logging
#
# Lightweight, interpreter-safe log module that reads SIMPLE_LOG env var
# once at module load time. Below the error threshold (the default), a log
# call costs only a single integer comparison (~1ns).
#
# Usage:
#   use std.log.{log_debug, log_info, log_warn, log_error}
#
#   log_debug("test_runner", "Loading file {path}")  # no-op if SIMPLE_LOG < debug
#   log_info("cli", "Starting test run")
#
# Environment:
#   SIMPLE_LOG=trace   → show everything
#   SIMPLE_LOG=debug   → show debug + above
#   SIMPLE_LOG=info    → show info + above
#   SIMPLE_LOG=warn    → show warn + error only
#   SIMPLE_LOG=error   → show errors only
#   (unset)            → show error + fatal only (the DEFAULT floor; see
#                        _DEFAULT_LOG_LEVEL -- errors are never suppressed
#                        just because no env var was set)
#   SIMPLE_LOG=off     → silent (all log calls become no-ops); the only way
#                        to suppress errors, and it must be deliberate
#
# Note: Due to module import limitations, this module may not be directly
# importable via `use std.log.{...}` from all contexts. For files loaded
# via the test runner or CLI, use the inline pattern instead:
#
#   use app.io.mod (env_get)
#   fn _is_debug_enabled() -> bool:
#       val env = env_get("SIMPLE_LOG")
#       env == "debug" or env == "trace"

extern fn rt_env_get(key: text) -> text
extern fn rt_stderr_write(s: text)
extern fn rt_stderr_flush()
extern fn rt_file_append_text(path: text, content: text) -> bool

# Phase 5 back-compat shim (log-lib-drivers AC-4): _emit and the legacy
# fatal/error/warn/info/debug/trace/verbose entry points dispatch through
# the std.log facade so backends registered via log_register_backend
# observe these emissions. Public function signatures unchanged.
use lib.log.{
    log_dispatch_text, subsys_from_scope,
    SUBSYS_DRIVER_BLOCK,
    LogContextSnapshot, log_context_set, log_context_clear, log_context_active,
    log_context_snapshot, log_context_restore, log_context_set_actor,
    SyslogKv, SyslogRecord, syslog_format, syslog_parse, syslog_record_with_kv
}

# Facade's canonical Phase 3 §A level numbering (0=TRACE..5=FATAL,6=OFF),
# duplicated here as literals rather than imported as aliased `val`s from
# lib.log. Reason: lib.log (the std.log facade) now re-exports this module's
# scope-level API (`export use lib.nogc_sync_mut.log.{...}` — see
# doc/08_tracking/bug/std_facade_shadows_tier_module_family_2026-08-08.md,
# "OPEN 1"), which makes this a genuine circular module dependency. `val`
# imports across a live cycle bind to an empty pre-completion snapshot of the
# still-loading module ("variable `_F_DEBUG` not found" at runtime) whereas
# plain function/class imports (log_dispatch_text, LogContextSnapshot, etc.,
# used below) resolve fine because they're bound lazily at call time, after
# both modules have finished loading. These six values are fixed enum
# constants (lib.log's LOG_TRACE..LOG_FATAL) that are not expected to change;
# keep them in sync with lib.log's constants if that numbering ever changes.
val _F_TRACE: i64 = 0
val _F_DEBUG: i64 = 1
val _F_INFO: i64 = 2
val _F_WARN: i64 = 3
val _F_ERROR: i64 = 4
val _F_FATAL: i64 = 5

# Map legacy nogc_sync_mut numeric level (1=FATAL..6=TRACE..7=VERBOSE)
# to canonical Phase 3 §A (0=TRACE..5=FATAL,6=OFF).
fn _legacy_to_canonical(legacy: i64) -> i64:
    if legacy == 1: return _F_FATAL
    if legacy == 2: return _F_ERROR
    if legacy == 3: return _F_WARN
    if legacy == 4: return _F_INFO
    if legacy == 5: return _F_DEBUG
    if legacy == 6: return _F_TRACE
    if legacy == 7: return _F_TRACE   # VERBOSE -> TRACE
    _F_INFO

# Level constants
val LOG_OFF: i64 = 0
val LOG_FATAL: i64 = 1
val LOG_ERROR: i64 = 2
val LOG_WARN: i64 = 3
val LOG_INFO: i64 = 4
val LOG_DEBUG: i64 = 5
val LOG_TRACE: i64 = 6
val LOG_VERBOSE: i64 = 7
val LOG_ALL: i64 = 10

# Floor that SIMPLE_LOG cannot lower except by an explicit "off"/"fatal".
#
# SIMPLE_LOG selects VERBOSITY BELOW the error threshold; it does not decide
# whether errors exist at all. Before 2026-08-10 `_parse_log_level()` returned
# 0 (== LOG_OFF) whenever SIMPLE_LOG was unset, so `error()`/`fatal()` never
# produced their labelled `[ERROR] [scope] msg` line for any operator who had
# not happened to set an env var. That is the same class as the std.log defect
# fixed in src/lib/log.spl by c5fee72e5b4 (log_dispatch_text wrote only to a
# ring buffer nothing drains), and it is the shape that hides bugs: a silent
# non-zero exit. See
# doc/08_tracking/bug/std_log_error_never_reaches_stderr_silent_nonzero_exit_2026-08-10.md
#
# `SIMPLE_LOG=off` still silences everything -- opting out stays possible, it
# just has to be deliberate.
val _DEFAULT_LOG_LEVEL: i64 = 2   # == LOG_ERROR

# Read SIMPLE_LOG once at module load time
fn _parse_log_level() -> i64:
    val env = rt_env_get("SIMPLE_LOG") ?? ""
    if env == "off":
        return LOG_OFF
    if env == "all":
        return 10
    if env == "verbose":
        return 7
    if env == "trace":
        return 6
    if env == "debug":
        return 5
    if env == "info":
        return 4
    if env == "warn":
        return 3
    if env == "error":
        return 2
    if env == "fatal":
        return 1
    # Unset or unrecognised: ERROR/FATAL still reach the operator.
    _DEFAULT_LOG_LEVEL

# Global mutable state (Note: May not persist across module imports in interpreter)
# FIXED: Don't call _parse_log_level() at module init (causes SFFI hang in interpreter)
# Use lazy initialization instead
var GLOBAL_LOG_LEVEL: i64 = -1  # -1 means not initialized
var SCOPE_LEVELS = {}
var _LOG_FILE_PATH: text = ""   # Empty = no file logging; set via SIMPLE_LOG_FILE_PATH or default

# Lazy initialization helper
fn _ensure_initialized():
    if GLOBAL_LOG_LEVEL == -1:
        GLOBAL_LOG_LEVEL = _parse_log_level()
        val file_env = rt_env_get("SIMPLE_LOG_FILE_PATH") ?? ""
        if file_env.len() > 0:
            _LOG_FILE_PATH = file_env
        else:
            val log_dir = rt_env_get("SIMPLE_LOG_DIR") ?? ""
            val log_env = rt_env_get("SIMPLE_LOG") ?? ""
            if log_dir.len() > 0:
                _LOG_FILE_PATH = log_dir + "/simple_app.log"
            elif GLOBAL_LOG_LEVEL > 0 and log_env.len() > 0:
                # Requires SIMPLE_LOG to be set EXPLICITLY. The default level is
                # now LOG_ERROR rather than LOG_OFF (see _DEFAULT_LOG_LEVEL), so
                # a bare `GLOBAL_LOG_LEVEL > 0` test would make every process in
                # the repo start creating and appending to .simple/logs/ with no
                # operator having asked for it. Surfacing errors on stderr must
                # not silently turn on on-disk logging.
                _LOG_FILE_PATH = ".simple/logs/simple_app.log"

# Emit log line to stderr and optionally to file
fn _emit(line: text):
    rt_stderr_write(line + "\n")
    rt_stderr_flush()
    if _LOG_FILE_PATH.len() > 0:
        rt_file_append_text(_LOG_FILE_PATH, line + "\n")

# Compatibility: Keep LOG_LEVEL for existing code (lazy evaluated)
fn get_log_level() -> i64:
    _ensure_initialized()
    GLOBAL_LOG_LEVEL

# ============================================================================
# Level Management Functions
# ============================================================================

fn level_name(level: i64) -> text:
    if level == 0:
        return "off"
    if level == 1:
        return "fatal"
    if level == 2:
        return "error"
    if level == 3:
        return "warn"
    if level == 4:
        return "info"
    if level == 5:
        return "debug"
    if level == 6:
        return "trace"
    if level == 7:
        return "verbose"
    if level == 10:
        return "all"
    "unknown"

fn parse_level(name: text) -> i64:
    if name == "off":
        return LOG_OFF
    if name == "fatal":
        return LOG_FATAL
    if name == "error":
        return LOG_ERROR
    if name == "warn":
        return LOG_WARN
    if name == "info":
        return LOG_INFO
    if name == "debug":
        return LOG_DEBUG
    if name == "trace":
        return LOG_TRACE
    if name == "verbose":
        return LOG_VERBOSE
    if name == "all":
        return LOG_ALL
    LOG_INFO  # Default to INFO for unknown

fn set_level(level: i64):
    _ensure_initialized()
    GLOBAL_LOG_LEVEL = level

fn get_global_level() -> i64:
    _ensure_initialized()
    GLOBAL_LOG_LEVEL

fn set_scope_level(scope: text, level: i64):
    SCOPE_LEVELS[scope] = level

fn get_level(scope: text) -> i64:
    _ensure_initialized()
    if SCOPE_LEVELS.has(scope):
        SCOPE_LEVELS[scope]
    else:
        GLOBAL_LOG_LEVEL

fn clear_scopes():
    SCOPE_LEVELS = {}

fn is_enabled(level: i64, scope: text) -> bool:
    val current_level = get_level(scope: scope)
    level <= current_level

# ============================================================================
# Logging Functions (with scope parameter)
# ============================================================================

fn fatal(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_FATAL, subsys: subsys_from_scope(scope), msg: msg)
    if 1 <= GLOBAL_LOG_LEVEL:
        _emit("[FATAL] [{scope}] {msg}")

fn error(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_ERROR, subsys: subsys_from_scope(scope), msg: msg)
    if 2 <= GLOBAL_LOG_LEVEL:
        _emit("[ERROR] [{scope}] {msg}")

fn warn(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_WARN, subsys: subsys_from_scope(scope), msg: msg)
    if 3 <= GLOBAL_LOG_LEVEL:
        _emit("[WARN] [{scope}] {msg}")

fn info(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_INFO, subsys: subsys_from_scope(scope), msg: msg)
    if 4 <= GLOBAL_LOG_LEVEL:
        _emit("[INFO] [{scope}] {msg}")

fn debug(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_DEBUG, subsys: subsys_from_scope(scope), msg: msg)
    if 5 <= GLOBAL_LOG_LEVEL:
        _emit("[DEBUG] [{scope}] {msg}")

fn trace(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_TRACE, subsys: subsys_from_scope(scope), msg: msg)
    if 6 <= GLOBAL_LOG_LEVEL:
        _emit("[TRACE] [{scope}] {msg}")

fn verbose(scope: text, msg: text):
    _ensure_initialized()
    log_dispatch_text(level: _F_TRACE, subsys: subsys_from_scope(scope), msg: msg)
    if 7 <= GLOBAL_LOG_LEVEL:
        _emit("[VERBOSE] [{scope}] {msg}")

# ============================================================================
# Convenience Functions (without scope - use "default" scope)
# ============================================================================

fn log_info(msg: text):
    info(scope: "default", msg: msg)

fn log_error(msg: text):
    error(scope: "default", msg: msg)

fn log_debug(msg: text):
    debug(scope: "default", msg: msg)

fn log_verbose(msg: text):
    verbose(scope: "default", msg: msg)

# General log function with explicit level
fn log(level: i64, scope: text, msg: text):
    if level <= get_level(scope: scope):
        var prefix = level_name(level: level)
        _emit("[{prefix.upper()}] [{scope}] {msg}")

# ============================================================================
# Exports
# ============================================================================

export log
export log_dispatch_text
export fatal, error, warn, info, debug, trace, verbose
export log_info, log_error, log_debug, log_verbose
export get_log_level, set_level, get_global_level, set_scope_level, get_level, clear_scopes, is_enabled
export parse_level, level_name
export SUBSYS_DRIVER_BLOCK
export subsys_from_scope
export LOG_TRACE, LOG_DEBUG, LOG_INFO, LOG_WARN, LOG_ERROR, LOG_FATAL, LOG_OFF, LOG_VERBOSE, LOG_ALL
# Lane OBS1 — current-context correlation-id API, passed through from lib.log
export LogContextSnapshot, log_context_set, log_context_clear, log_context_active
export log_context_snapshot, log_context_restore, log_context_set_actor
export SyslogKv, SyslogRecord, syslog_format, syslog_parse, syslog_record_with_kv
