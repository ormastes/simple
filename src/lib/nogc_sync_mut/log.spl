@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# Log Module - Runtime-guarded logging
#
# Lightweight, interpreter-safe log module that reads SIMPLE_LOG env var
# once at module load time. Below the error threshold (the default), a log
# call costs only a single integer comparison (~1ns).
#
# Usage:
#   use std.log.{log_debug, log_info, log_warn, log_error}
#
#   log_debug("test_runner", "Loading file {path}")  # no-op if SIMPLE_LOG < debug
#   log_info("cli", "Starting test run")
#
# Environment:
#   SIMPLE_LOG=trace   → show everything
#   SIMPLE_LOG=debug   → show debug + above
#   SIMPLE_LOG=info    → show info + above
#   SIMPLE_LOG=warn    → show warn + error only
#   SIMPLE_LOG=error   → show errors only
#   (unset)            → show error + fatal only (the DEFAULT floor; see
#                        _DEFAULT_LOG_LEVEL -- errors are never suppressed
#                        just because no env var was set)
#   SIMPLE_LOG=off     → silent (all log calls become no-ops); the only way
#                        to suppress errors, and it must be deliberate
#
# Note: Due to module import limitations, this module may not be directly
# importable via `use std.log.{...}` from all contexts. For files loaded
# via the test runner or CLI, use the inline pattern instead:
#
#   use app.io.mod (env_get)
#   fn _is_debug_enabled() -> bool:
#       val env = env_get("SIMPLE_LOG")
#       env == "debug" or env == "trace"

@unsafe(reason: "raw nullable environment lookup; nil means unset", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?
@unsafe(reason: "raw stderr write ABI", capabilities: [ffi])
extern fn rt_stderr_write(s: text)
@unsafe(reason: "raw stderr flush ABI", capabilities: [ffi])
extern fn rt_stderr_flush()
use std.io_runtime.{file_append_text}

# One-way compatibility adapter (log-lib-drivers AC-4): _emit and the legacy
# fatal/error/warn/info/debug/trace/verbose entry points dispatch through the
# canonical std.log owner so backends registered there observe emissions.
# std.log deliberately does not re-export this module: doing so creates a
# loader cycle and splits the facade's mutable backend state.
use std.log as canonical_log

# Facade's canonical Phase 3 §A level numbering (0=TRACE..5=FATAL,6=OFF).
# These local adapter literals avoid colliding with this module's documented
# legacy LOG_* names (0=OFF..6=TRACE); the dependency is strictly one-way.
val _F_TRACE: i64 = 0
val _F_DEBUG: i64 = 1
val _F_INFO: i64 = 2
val _F_WARN: i64 = 3
val _F_ERROR: i64 = 4
val _F_FATAL: i64 = 5
val _F_SUBSYS_USER_BASE: i64 = 32

# Map legacy nogc_sync_mut numeric level (0=OFF..6=TRACE..7=VERBOSE)
# to canonical Phase 3 §A (0=TRACE..5=FATAL,6=OFF).
fn _legacy_to_canonical(legacy: i64) -> i64:
    if legacy == 0: return 6
    if legacy == 1: return _F_FATAL
    if legacy == 2: return _F_ERROR
    if legacy == 3: return _F_WARN
    if legacy == 4: return _F_INFO
    if legacy == 5: return _F_DEBUG
    if legacy == 6: return _F_TRACE
    if legacy == 7: return _F_TRACE   # VERBOSE -> TRACE
    if legacy == 10: return _F_TRACE  # ALL -> TRACE
    _F_INFO

fn _canonical_to_legacy(canonical: i64) -> i64:
    if canonical == 0: return 6
    if canonical == 1: return 5
    if canonical == 2: return 4
    if canonical == 3: return 3
    if canonical == 4: return 2
    if canonical == 5: return 1
    if canonical == 6: return 0
    _LEGACY_LOG_INFO

# Level constants
val _LEGACY_LOG_OFF: i64 = 0
val _LEGACY_LOG_FATAL: i64 = 1
val _LEGACY_LOG_ERROR: i64 = 2
val _LEGACY_LOG_WARN: i64 = 3
val _LEGACY_LOG_INFO: i64 = 4
val _LEGACY_LOG_DEBUG: i64 = 5
val _LEGACY_LOG_TRACE: i64 = 6
val _LEGACY_LOG_VERBOSE: i64 = 7
val _LEGACY_LOG_ALL: i64 = 10

# The public LOG_* names intentionally overlap std.log with the historic
# inverse scale.  Implementation code uses only unique internal names so a
# co-compiled program cannot bind an unqualified level to the other facade.
val LOG_OFF: i64 = _LEGACY_LOG_OFF
val LOG_FATAL: i64 = _LEGACY_LOG_FATAL
val LOG_ERROR: i64 = _LEGACY_LOG_ERROR
val LOG_WARN: i64 = _LEGACY_LOG_WARN
val LOG_INFO: i64 = _LEGACY_LOG_INFO
val LOG_DEBUG: i64 = _LEGACY_LOG_DEBUG
val LOG_TRACE: i64 = _LEGACY_LOG_TRACE
val LOG_VERBOSE: i64 = _LEGACY_LOG_VERBOSE
val LOG_ALL: i64 = _LEGACY_LOG_ALL

# Floor that SIMPLE_LOG cannot lower except by an explicit "off"/"fatal".
#
# SIMPLE_LOG selects VERBOSITY BELOW the error threshold; it does not decide
# whether errors exist at all. Before 2026-08-10 `_parse_log_level()` returned
# 0 (== LOG_OFF) whenever SIMPLE_LOG was unset, so `error()`/`fatal()` never
# produced their labelled `[ERROR] [scope] msg` line for any operator who had
# not happened to set an env var. That is the same class as the std.log defect
# fixed in src/lib/log.spl by c5fee72e5b4 (log_dispatch_text wrote only to a
# ring buffer nothing drains), and it is the shape that hides bugs: a silent
# non-zero exit. See
# doc/08_tracking/bug/std_log_error_never_reaches_stderr_silent_nonzero_exit_2026-08-10.md
#
# `SIMPLE_LOG=off` still silences everything -- opting out stays possible, it
# just has to be deliberate.
val _DEFAULT_LOG_LEVEL: i64 = 2   # == LOG_ERROR

# Read SIMPLE_LOG once at module load time
fn _parse_log_level() -> i64:
    val env = unsafe(capabilities: [ffi]):
        rt_env_get("SIMPLE_LOG") ?? ""
    if env == "off":
        return _LEGACY_LOG_OFF
    if env == "all":
        return 10
    if env == "verbose":
        return 7
    if env == "trace":
        return 6
    if env == "debug":
        return 5
    if env == "info":
        return 4
    if env == "warn":
        return 3
    if env == "error":
        return 2
    if env == "fatal":
        return 1
    # Unset or unrecognised: ERROR/FATAL still reach the operator.
    _DEFAULT_LOG_LEVEL

# Global mutable state (Note: May not persist across module imports in interpreter)
# FIXED: Don't call _parse_log_level() at module init (causes SFFI hang in interpreter)
# Use lazy initialization instead
var GLOBAL_LOG_LEVEL: i64 = -1  # -1 means not initialized
var SCOPE_LEVELS = {}
var _LOG_FILE_PATH: text = ""   # Empty = no file logging; set via SIMPLE_LOG_FILE_PATH or default

# Lazy initialization helper
fn _ensure_initialized():
    if GLOBAL_LOG_LEVEL == -1:
        GLOBAL_LOG_LEVEL = _parse_log_level()
        val file_env = rt_env_get("SIMPLE_LOG_FILE_PATH") ?? ""
        if file_env.len() > 0:
            _LOG_FILE_PATH = file_env
        else:
            val log_dir = unsafe(capabilities: [ffi]):
                rt_env_get("SIMPLE_LOG_DIR") ?? ""
            val log_env = unsafe(capabilities: [ffi]):
                rt_env_get("SIMPLE_LOG") ?? ""
            if log_dir.len() > 0:
                _LOG_FILE_PATH = log_dir + "/simple_app.log"
            elif GLOBAL_LOG_LEVEL > 0 and log_env.len() > 0:
                # Requires SIMPLE_LOG to be set EXPLICITLY. The default level is
                # now LOG_ERROR rather than LOG_OFF (see _DEFAULT_LOG_LEVEL), so
                # a bare `GLOBAL_LOG_LEVEL > 0` test would make every process in
                # the repo start creating and appending to .simple/logs/ with no
                # operator having asked for it. Surfacing errors on stderr must
                # not silently turn on on-disk logging.
                _LOG_FILE_PATH = ".simple/logs/simple_app.log"

# Emit log line to stderr and optionally to file
fn _emit(line: text):
    unsafe(capabilities: [ffi]):
        rt_stderr_write(line + "\n")
    unsafe(capabilities: [ffi]):
        rt_stderr_flush()
    if _LOG_FILE_PATH.len() > 0:
        rt_file_append_text(_LOG_FILE_PATH, line + "\n")

# Compatibility: Keep LOG_LEVEL for existing code (lazy evaluated)
fn legacy_compat_get_log_level() -> i64:
    _ensure_initialized()
    val exact_legacy_level = canonical_log.log_compat_get_legacy_level()
    if exact_legacy_level >= 0:
        GLOBAL_LOG_LEVEL = exact_legacy_level
    else:
        GLOBAL_LOG_LEVEL = _canonical_to_legacy(canonical_log.log_get_level())
    GLOBAL_LOG_LEVEL

# ============================================================================
# Level Management Functions
# ============================================================================

fn legacy_compat_level_name(level: i64) -> text:
    if level == 0:
        return "off"
    if level == 1:
        return "fatal"
    if level == 2:
        return "error"
    if level == 3:
        return "warn"
    if level == 4:
        return "info"
    if level == 5:
        return "debug"
    if level == 6:
        return "trace"
    if level == 7:
        return "verbose"
    if level == 10:
        return "all"
    "unknown"

fn legacy_compat_parse_level(name: text) -> i64:
    if name == "off":
        return _LEGACY_LOG_OFF
    if name == "fatal":
        return _LEGACY_LOG_FATAL
    if name == "error":
        return _LEGACY_LOG_ERROR
    if name == "warn":
        return _LEGACY_LOG_WARN
    if name == "info":
        return _LEGACY_LOG_INFO
    if name == "debug":
        return _LEGACY_LOG_DEBUG
    if name == "trace":
        return _LEGACY_LOG_TRACE
    if name == "verbose":
        return _LEGACY_LOG_VERBOSE
    if name == "all":
        return _LEGACY_LOG_ALL
    _LEGACY_LOG_INFO  # Default to INFO for unknown

fn legacy_compat_set_level(level: i64):
    _ensure_initialized()
    canonical_log.log_compat_set_legacy_level(level, _legacy_to_canonical(level))
    GLOBAL_LOG_LEVEL = level

fn legacy_compat_get_global_level() -> i64:
    legacy_compat_get_log_level()

fn legacy_compat_set_scope_level(scope: text, level: i64):
    _ensure_initialized()
    SCOPE_LEVELS[scope] = level
    canonical_log.log_compat_set_legacy_subsys_level(
        canonical_log.subsys_from_scope(scope),
        level,
        _legacy_to_canonical(level)
    )

fn legacy_compat_get_level(scope: text) -> i64:
    _ensure_initialized()
    val subsys = canonical_log.subsys_from_scope(scope)
    val exact_legacy_level = canonical_log.log_compat_get_legacy_effective_level(subsys)
    if exact_legacy_level >= 0 and SCOPE_LEVELS.has(scope):
        # The old facade keys overrides by the complete scope string.  Several
        # arbitrary names map to canonical SUBSYS_USER_BASE, so the dictionary
        # remains the exact legacy authority while the receipt distinguishes a
        # later direct canonical override (which clears it).
        return SCOPE_LEVELS[scope]
    if subsys == _F_SUBSYS_USER_BASE:
        # An unrelated arbitrary name also maps to USER_BASE, but it must not
        # inherit another name's exact legacy override.
        return legacy_compat_get_log_level()
    if exact_legacy_level >= 0:
        return exact_legacy_level
    _canonical_to_legacy(canonical_log.effective_level(subsys))

fn legacy_compat_clear_scopes():
    SCOPE_LEVELS = {}
    canonical_log.log_init_from_config("")

fn legacy_compat_is_enabled(level: i64, scope: text) -> bool:
    _ensure_initialized()
    if level == _LEGACY_LOG_OFF:
        return false
    level <= legacy_compat_get_level(scope)

# ============================================================================
# Logging Functions (with scope parameter)
# ============================================================================

fn legacy_compat_fatal(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_FATAL, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_FATAL, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[FATAL] [{scope}] {msg}")

fn legacy_compat_error(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_ERROR, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_ERROR, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[ERROR] [{scope}] {msg}")

fn legacy_compat_warn(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_WARN, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_WARN, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[WARN] [{scope}] {msg}")

fn legacy_compat_info(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_INFO, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_INFO, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[INFO] [{scope}] {msg}")

fn legacy_compat_debug(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_DEBUG, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_DEBUG, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[DEBUG] [{scope}] {msg}")

fn legacy_compat_trace(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_TRACE, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_TRACE, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[TRACE] [{scope}] {msg}")

fn legacy_compat_verbose(scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(_LEGACY_LOG_VERBOSE, scope):
        return
    canonical_log.log_compat_dispatch_text(level: _F_TRACE, subsys: canonical_log.subsys_from_scope(scope), msg: msg)
    _emit("[VERBOSE] [{scope}] {msg}")

# ============================================================================
# Convenience Functions (without scope - use "default" scope)
# ============================================================================

fn legacy_compat_log_info(msg: text):
    legacy_compat_info(scope: "default", msg: msg)

fn legacy_compat_log_error(msg: text):
    legacy_compat_error(scope: "default", msg: msg)

fn legacy_compat_log_debug(msg: text):
    legacy_compat_debug(scope: "default", msg: msg)

fn legacy_compat_log_verbose(msg: text):
    legacy_compat_verbose(scope: "default", msg: msg)

# General log function with explicit level.  Keep the implementation symbol
# unique: the interpreter co-compiles this module with std.log, whose public
# `log(i64, text, text)` has the same signature.  The public wrapper below
# delegates to this uniquely named implementation.
fn legacy_compat_log(level: i64, scope: text, msg: text):
    _ensure_initialized()
    if not legacy_compat_is_enabled(level, scope):
        return
    canonical_log.log_compat_dispatch_text(
        level: _legacy_to_canonical(level),
        subsys: canonical_log.subsys_from_scope(scope),
        msg: msg
    )
    val prefix = legacy_compat_level_name(level: level)
    _emit("[{prefix.upper()}] [{scope}] {msg}")

# ============================================================================
# Exports
# ============================================================================

# Native callers require real callable symbols for every exported name.  The
# qualified module namespace keeps these wrappers distinct from std.log while
# the uniquely named implementations remain unambiguous in co-compiled code.
fn log(level: i64, scope: text, msg: text):
    legacy_compat_log(level, scope, msg)

fn log_dispatch_text(level: i64, subsys: i64, msg: text):
    canonical_log.log_dispatch_text(level, subsys, msg)

fn fatal(scope: text, msg: text):
    legacy_compat_fatal(scope, msg)

fn error(scope: text, msg: text):
    legacy_compat_error(scope, msg)

fn warn(scope: text, msg: text):
    legacy_compat_warn(scope, msg)

fn info(scope: text, msg: text):
    legacy_compat_info(scope, msg)

fn debug(scope: text, msg: text):
    legacy_compat_debug(scope, msg)

fn trace(scope: text, msg: text):
    legacy_compat_trace(scope, msg)

fn verbose(scope: text, msg: text):
    legacy_compat_verbose(scope, msg)

fn log_info(msg: text):
    legacy_compat_log_info(msg)

fn log_error(msg: text):
    legacy_compat_log_error(msg)

fn log_debug(msg: text):
    legacy_compat_log_debug(msg)

fn log_verbose(msg: text):
    legacy_compat_log_verbose(msg)

fn get_log_level() -> i64:
    legacy_compat_get_log_level()

fn set_level(level: i64):
    legacy_compat_set_level(level)

fn get_global_level() -> i64:
    legacy_compat_get_global_level()

fn set_scope_level(scope: text, level: i64):
    legacy_compat_set_scope_level(scope, level)

fn get_level(scope: text) -> i64:
    legacy_compat_get_level(scope)

fn clear_scopes():
    legacy_compat_clear_scopes()

fn is_enabled(level: i64, scope: text) -> bool:
    legacy_compat_is_enabled(level, scope)

fn parse_level(name: text) -> i64:
    legacy_compat_parse_level(name)

fn level_name(level: i64) -> text:
    legacy_compat_level_name(level)
export log
export log_dispatch_text
export fatal, error, warn, info, debug, trace, verbose
export legacy_compat_log, legacy_compat_fatal, legacy_compat_error
export legacy_compat_warn, legacy_compat_info, legacy_compat_debug
export legacy_compat_trace, legacy_compat_verbose, legacy_compat_is_enabled
export log_info, log_error, log_debug, log_verbose
export get_log_level, set_level, get_global_level, set_scope_level, get_level, clear_scopes, is_enabled
export parse_level, level_name
export canonical_log.SUBSYS_DRIVER_BLOCK
export canonical_log.subsys_from_scope
export LOG_TRACE, LOG_DEBUG, LOG_INFO, LOG_WARN, LOG_ERROR, LOG_FATAL, LOG_OFF, LOG_VERBOSE, LOG_ALL
