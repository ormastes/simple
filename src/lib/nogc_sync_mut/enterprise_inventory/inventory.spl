"""
# Inventory / Stock-Control Vertical — receive, reserve, adjust over the store

Lane `.spipe/simple_enterprise_suite` (W18-A). A minimal but real inventory
vertical layered on the durable enterprise store, tracking physical stock
per (SKU, location):

    receive -> reserve (against available) -> adjust (audited correction)

Every write runs the frozen guarded sequence over the durable store:

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

## Storage model — insert-only signed movements, derive on read

A single insert-only table `inv_moves` holds one signed row per movement.
There is NO UPDATE anywhere: on-hand and available are pure-Simple folds
over the movement rows (the interpreter sqlite emulation is non-ACID and
ignores WHERE — durable claims rest on the file backend; see the store's
backend-honesty docstring). Reasons partition the ledger:

- `inv-receive` (+qty)  — goods arrive; raises on-hand and available.
- `inv-reserve` (+qty)  — a reservation; lowers available, NOT on-hand.
- `inv-adjust` (±delta) — an audited physical correction; changes on-hand.

Derived quantities per (tenant, sku, location):

    on_hand   = sum(delta) over reason in {inv-receive, inv-adjust}
    reserved  = sum(delta) over reason == inv-reserve
    available = on_hand - reserved

`stock_reserve` denies with the closed-set reason `insufficient-stock`
when the requested quantity exceeds available. Every mutation writes a
sha256-chained audit row through `audit_append` (the SMF-safe facade — this
module never imports std.common.crypto.sha256 directly).

## RBAC — frozen table reused, no new grant

foundation.role_allows is FROZEN (an ADR is required to extend it). Rather
than add an inventory role there, this vertical reuses existing grants:

- `stock_receive` / `stock_reserve` guard on `proc.po.receive` — the
  procurement role already owns stock-ledger movement, and warehouse/
  procurement staff perform receipts and reservations (admin passes via the
  blanket admin rule).
- `stock_adjust` guards on `inventory.stock.adjust`, an admin-only action:
  no non-admin role grants it, so audited corrections stay admin-tier, the
  same way `sale.catalog.admin` / `proc.supplier.admin` are admin-only.

Fine-grained inventory-operator grants (a dedicated `inventory` role, or a
data-driven `enterprise_sale/rbac_registry.spl`) are an ADR-gated migration
per the lane's cooperative-review plan; this module deliberately adds
nothing to the frozen contract.
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid, role_allows
}

# =============================================================================
# Schema — one insert-only signed-movement table
# =============================================================================

fn inv_setup(store: EnterpriseStore) -> bool:
    store_migrate(store, "inv_001_moves",
        "CREATE TABLE IF NOT EXISTS inv_moves (id INTEGER PRIMARY KEY, tenant_id TEXT, sku TEXT, location TEXT, delta TEXT, reason TEXT, ref_id TEXT)")

# =============================================================================
# Derived reads (pure-Simple filtering + fold; see module docstring)
# =============================================================================

# stock_on_hand: physical stock = sum of receive and adjust deltas for a
# (tenant, sku, location). Reservations do NOT reduce on-hand.
fn stock_on_hand(store: EnterpriseStore, tenant_id: text, sku: text, location: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "inv_moves", "id, tenant_id, sku, location, delta, reason, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sku") == sku and sqlite_row_get(row, "location") == location:
            val reason = sqlite_row_get(row, "reason")
            if reason == "inv-receive" or reason == "inv-adjust":
                total = total + int(sqlite_row_get(row, "delta"))
    total

# stock_reserved: outstanding reservations for a (tenant, sku, location).
fn stock_reserved(store: EnterpriseStore, tenant_id: text, sku: text, location: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "inv_moves", "id, tenant_id, sku, location, delta, reason, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sku") == sku and sqlite_row_get(row, "location") == location:
            if sqlite_row_get(row, "reason") == "inv-reserve":
                total = total + int(sqlite_row_get(row, "delta"))
    total

# stock_available: what may still be reserved = on_hand - reserved.
fn stock_available(store: EnterpriseStore, tenant_id: text, sku: text, location: text) -> i64:
    stock_on_hand(store, tenant_id, sku, location) - stock_reserved(store, tenant_id, sku, location)

# =============================================================================
# Guarded commands
# =============================================================================

# stock_receive: goods arrive at a location — raise on-hand and available.
fn stock_receive(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, sku: text, location: text, qty: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sku)
    if not role_allows(who.role, "proc.po.receive"):
        return denied("forbidden", sku)
    if sku == "" or location == "" or qty <= 0:
        return denied("invalid-record", sku)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val ref = sku + "@" + location
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO inv_moves (tenant_id, sku, location, delta, reason, ref_id) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, sku, location, "{qty}", "inv-receive", ref])
    outbox_append(store, tenant.tenant_id, "inventory.stock.received", ref + ":{qty}")
    audit_append(store, tenant.tenant_id, who.actor_id, "inventory.stock.receive", ref + ":{qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ref)
    uow_commit(store)
    accepted(ref)

# stock_reserve: reserve qty against AVAILABLE stock. Denied with the closed
# reason `insufficient-stock` when qty exceeds available.
fn stock_reserve(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, sku: text, location: text, qty: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sku)
    if not role_allows(who.role, "proc.po.receive"):
        return denied("forbidden", sku)
    if sku == "" or location == "" or qty <= 0:
        return denied("invalid-record", sku)
    val ref = sku + "@" + location
    # The over-reservation check is state-DEPENDENT: `available` shrinks by
    # exactly this command's own effect, so re-judging it on a replay would
    # deny an already-accepted command. Feasibility is asked only of a
    # command not already recorded (frozen order preserved: session -> rbac
    # -> validation -> idempotency).
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and qty > stock_available(store, tenant.tenant_id, sku, location):
        return denied("insufficient-stock", "over-reserve:" + ref + ":available={stock_available(store, tenant.tenant_id, sku, location)}:got={qty}")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO inv_moves (tenant_id, sku, location, delta, reason, ref_id) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, sku, location, "{qty}", "inv-reserve", ref])
    outbox_append(store, tenant.tenant_id, "inventory.stock.reserved", ref + ":{qty}")
    audit_append(store, tenant.tenant_id, who.actor_id, "inventory.stock.reserve", ref + ":{qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ref)
    uow_commit(store)
    accepted(ref)

# stock_adjust: an audited physical correction (positive or negative delta),
# admin-only. Never lets on-hand fall below the currently reserved amount.
fn stock_adjust(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, sku: text, location: text, delta: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sku)
    if not role_allows(who.role, "inventory.stock.adjust"):
        return denied("forbidden", sku)
    if sku == "" or location == "" or delta == 0:
        return denied("invalid-record", sku)
    val ref = sku + "@" + location
    # A negative correction may not drive on-hand below outstanding
    # reservations (available would go negative). State-dependent, so gated
    # on not-replayed like stock_reserve.
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and stock_on_hand(store, tenant.tenant_id, sku, location) + delta < stock_reserved(store, tenant.tenant_id, sku, location):
        return denied("insufficient-stock", "adjust-below-reserved:" + ref + ":delta={delta}")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO inv_moves (tenant_id, sku, location, delta, reason, ref_id) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, sku, location, "{delta}", "inv-adjust", ref])
    outbox_append(store, tenant.tenant_id, "inventory.stock.adjusted", ref + ":{delta}")
    audit_append(store, tenant.tenant_id, who.actor_id, "inventory.stock.adjust", ref + ":{delta}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ref)
    uow_commit(store)
    accepted(ref)

export inv_setup
export stock_on_hand, stock_reserved, stock_available
export stock_receive, stock_reserve, stock_adjust
