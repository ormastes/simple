use std.io_runtime.{env_get}
use std.io_runtime.{process_run}

use nogc_sync_mut.path.{normalize_path, is_absolute_path, join_path}
use nogc_sync_mut.fs.host_path.{host_path_native}
use nogc_sync_mut.platform.config.{PlatformConfig, host_config, make_config, network_config, needs_swap, same_platform}
use nogc_sync_mut.platform.convert.{send_u16, send_u32, send_u64, recv_u16, recv_u32, recv_u64, send_text, recv_text, send_bytes_u32, recv_bytes_u32}
use nogc_sync_mut.platform.linker.{SystemLinker, auto_detect_linker, get_linker_info}
use nogc_sync_mut.platform.newline.{TextMode, translate_write, translate_read}
use nogc_sync_mut.platform.text_io.{text_file_write, text_file_write_local, text_file_read, text_file_read_local}
use nogc_sync_mut.platform.wire.{WireWriter, WireReader, wire_writer_new, wire_writer_network, wire_writer_le, wire_reader_new}
# SELF-RECURSION FIX (2026-09-03): importing `is_windows` into a file that also
# DEFINES `is_windows` makes the AOT lowering bind the alias to the LOCAL
# definition -- a silent infinite self-call (stack overflow), which is what
# killed the Windows MSVC stage 2 candidate. Import the underlying resolver
# `detect_os`, whose bare name collides with nothing here; `env.platform`s
# `is_windows` is literally `detect_os() == "windows"`, so semantics are
# unchanged. Compiler defect:
# doc/08_tracking/bug/aliased_import_shadowed_by_local_fn_native_codegen_2026-09-03.md
use std.nogc_sync_mut.env.platform.{detect_os as platform_detect_os}

fn shell_output_trim(command: text) -> text:
    val result = process_run("/bin/sh", ["-c", command])
    val stdout = result[0]
    val code = result[2]
    if code == 0:
        stdout.trim()
    else:
        ""

# FAIL-OPEN FIX (2026-09-02): read ONLY `OS` and returned false when unset --
# a silent "not Windows" under a stripped environment (where a bootstrap runs).
# Delegate to the single resolver in std.nogc_sync_mut.env.platform, which
# consults the in-process rt_platform_name() primitive first.
fn is_windows_env() -> bool:
    platform_detect_os() == "windows"

fn get_host_os() -> text:
    if is_windows_env():
        "windows"
    else:
        val os = shell_output_trim("uname -s")
        if os.len() == 0:
            "linux"
        else:
            match os:
                case "Linux": "linux"
                case "Darwin": "macos"
                case "FreeBSD": "freebsd"
                case "OpenBSD": "openbsd"
                case "NetBSD": "netbsd"
                case _: os.lower()

fn get_host_arch() -> text:
    if is_windows_env():
        val arch_env = env_get("PROCESSOR_ARCHITECTURE")
        if arch_env == nil:
            "x86_64"
        else:
            match arch_env:
                case "AMD64": "x86_64"
                case "ARM64": "aarch64"
                case "x86": "i686"
                case _: arch_env.lower()
    else:
        val arch = shell_output_trim("uname -m")
        if arch.len() == 0:
            "x86_64"
        else:
            match arch:
                case "x86_64": "x86_64"
                case "amd64": "x86_64"
                case "arm64": "aarch64"
                case "aarch64": "aarch64"
                case "riscv64": "riscv64"
                case "i686": "i686"
                case "i386": "i686"
                case _: arch

fn is_windows() -> bool:
    get_host_os() == "windows"

fn is_unix() -> bool:
    val os = get_host_os()
    os == "linux" or os == "macos" or os == "freebsd" or os == "openbsd" or os == "netbsd"

fn is_macos() -> bool:
    get_host_os() == "macos"

fn is_linux() -> bool:
    get_host_os() == "linux"

fn dir_sep() -> text:
    if is_windows():
        "\\"
    else:
        "/"

# Convert a canonical forward-slash path to this platform's NATIVE form.
#
# THE single conversion point for Windows separator variation. Call it at the
# boundary where a native path is genuinely required -- handing a path to a
# spawned process (argv) or to a native tool's response file -- and nowhere
# else. Filesystem I/O does NOT need it.
#
# Boundary evidence, measured by EXECUTION on Windows 11 (2026-09-01), one file,
# two forms:
#   Win32 file API in-process : backslash form OK, forward-slash form OK
#   spawned cmd.exe /c type   : backslash form -> exit 0 + file contents;
#                               forward-slash form -> exit 1, "The syntax of the
#                               command is incorrect."  <- the fails-mute class.
#
# CROSS-PLATFORM IMPACT: off Windows this is the IDENTITY function, returning
# its argument byte-for-byte unchanged. Deliberate, not a shortcut: a backslash
# is a LEGAL character in a POSIX filename, so a "\" -> "/" rewrite off Windows
# would silently corrupt a real path. A dead helper in fs/path.spl used to do
# exactly that on its Unix branch; it had zero callers and has been deleted.
#
# Apply ONLY to a value already known to be a filesystem path -- a URL, a CLI
# switch and a regex also contain "/" and would be mangled.
#
# IMPLEMENTATION: a thin alias for std.nogc_sync_mut.fs.host_path
# host_path_native, THE single boundary converter. This copy SHADOWS the one in
# platform.spl, so both had to be folded -- two shadowing copies of a boundary
# rule is exactly how the two-mechanism collision arose. host_path_native is a
# superset (it also handles the MinGW /d/foo -> d:\foo drive form) and is
# cheaper (is_windows() -> get_host_os() spawns `/bin/sh -c "uname -s"` on every
# non-Windows call; host_path_native caches its decision and returns its
# argument off Windows).
fn to_native_path(path: text) -> text:
    host_path_native(path)

fn path_sep() -> text:
    if is_windows():
        ";"
    else:
        ":"

fn exe_ext() -> text:
    if is_windows():
        ".exe"
    else:
        ""

fn lib_ext() -> text:
    if is_macos():
        ".dylib"
    elif is_windows():
        ".dll"
    else:
        ".so"

