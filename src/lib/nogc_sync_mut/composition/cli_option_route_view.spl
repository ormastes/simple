# Admitted view of the SCI section-10 CLI option route table.
#
# Built once at decode time and shared by every token lookup. The view keeps the
# exact admitted section bytes, the opened route handle and the digest verdict,
# so consumers never re-read or re-verify the section.

use std.nogc_sync_mut.composition.sci_reader.{SciSectionHandleV1, sci_open_route_section_v1, sci_verify_section_digest_v1}

# Reference-owned (class, not struct): admitted once at decode, shared by every token lookup.
class SciCliOptionRouteViewV1:
    bytes: [u8]                   # exact admitted section-10 bytes; [] when absent
    handle: SciSectionHandleV1    # handle.ok == false when absent/unopenable
    integrity_verified: bool      # sci_verify_section_digest_v1 result at construction

fn empty_cli_option_route_view_v1() -> SciCliOptionRouteViewV1:
    val handle = SciSectionHandleV1(ok: false, error_code: "SCI_SECTION_ABSENT", error_message: "no section 10",
        schema_version: 0, generation: 0, route_count: 0, index_offset: 0,
        record_offset: 0, string_offset: 0, string_bytes: 0, section_size: 0)
    SciCliOptionRouteViewV1(bytes: [], handle: handle, integrity_verified: false)

fn cli_option_route_view_from_bytes_v1(bytes: [u8]) -> SciCliOptionRouteViewV1:
    val handle = sci_open_route_section_v1(bytes)
    val verified = sci_verify_section_digest_v1(bytes, handle)
    SciCliOptionRouteViewV1(bytes: bytes, handle: handle, integrity_verified: verified)
