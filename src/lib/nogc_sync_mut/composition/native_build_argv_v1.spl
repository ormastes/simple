"""Canonical provenance-only NBAV codec; these bytes are never executable."""

use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.nogc_sync_mut.composition.native_build_payload_types_v1.{NativeBuildArgvDecodeV1}

pub val NATIVE_BUILD_ARGV_MAX_ITEMS_V1: i64 = 1048576
pub val NATIVE_BUILD_ARGV_MAX_TEXT_BYTES_V1: i64 = 1048576
pub val NATIVE_BUILD_ARGV_MAX_BYTES_V1: i64 = 16777120

fn _argv_push_u16_v1(buffer: [u8], value: i64) -> [u8]:
    var out = buffer
    out.push((value & 255) as u8)
    out.push(((value >> 8) & 255) as u8)
    out

fn _argv_push_u32_v1(buffer: [u8], value: u32) -> [u8]:
    var out = buffer
    var shift: u32 = 0u32
    while shift < 32u32:
        out.push(((value >> shift) & 255u32) as u8)
        shift = shift + 8u32
    out

fn _argv_read_u16_v1(bytes: [u8], offset: i64) -> i64:
    (bytes[offset] as i64) | ((bytes[offset + 1] as i64) << 8)

fn _argv_read_u32_v1(bytes: [u8], offset: i64) -> u32:
    var value: u32 = 0u32
    var index: i64 = 0
    while index < 4:
        value = value | ((bytes[offset + index] as u32) << ((index * 8) as u32))
        index = index + 1
    value

fn _argv_has_zero_v1(bytes: [u8]) -> bool:
    for value in bytes:
        if value == 0u8: return true
    false

pub fn native_build_argv_encode_v1(arguments: [text]) -> [u8]:
    if arguments.len() > NATIVE_BUILD_ARGV_MAX_ITEMS_V1: return []
    var text_bytes: i64 = 0
    var total_bytes: i64 = 12
    for argument in arguments:
        val encoded = argument.bytes()
        if _argv_has_zero_v1(encoded): return []
        if encoded.len() > NATIVE_BUILD_ARGV_MAX_TEXT_BYTES_V1 - text_bytes: return []
        if encoded.len() > NATIVE_BUILD_ARGV_MAX_BYTES_V1 - total_bytes - 4: return []
        text_bytes = text_bytes + encoded.len()
        total_bytes = total_bytes + 4 + encoded.len()
    var out = "NBAV".bytes()
    out = _argv_push_u16_v1(out, 1)
    out = _argv_push_u16_v1(out, 0)
    out = _argv_push_u32_v1(out, arguments.len() as u32)
    for argument in arguments:
        val encoded = argument.bytes()
        out = _argv_push_u32_v1(out, encoded.len() as u32)
        for byte in encoded: out.push(byte)
    out

fn _argv_failure_v1(error: text, arguments_materialized: i64) -> NativeBuildArgvDecodeV1:
    NativeBuildArgvDecodeV1(ok: false, arguments: [],
        arguments_materialized: arguments_materialized, executable: false, error: error)

fn _argv_preflight_v1(bytes: [u8], max_items: i64, max_text_bytes: i64) -> text:
    val count = _argv_read_u32_v1(bytes, 8) as i64
    if count > max_items: return "nbav_item_budget"
    if count > (bytes.len() - 12) / 4: return "nbav_truncated_length"
    var position: i64 = 12
    var retained_text: i64 = 0
    var index: i64 = 0
    while index < count:
        if position > bytes.len() - 4: return "nbav_truncated_length"
        val length = _argv_read_u32_v1(bytes, position) as i64
        position = position + 4
        if length > max_text_bytes - retained_text or position > bytes.len() or
                length > bytes.len() - position:
            return "nbav_text_budget_or_range"
        val raw = bytes[position..(position + length)]
        if _argv_has_zero_v1(raw): return "nbav_nul"
        match validated_utf8_bytes_to_text_linear(raw):
            case Ok(_): ()
            case Err(_): return "nbav_utf8"
        retained_text = retained_text + length
        position = position + length
        index = index + 1
    if position != bytes.len(): return "nbav_trailing_bytes"
    ""

pub fn native_build_argv_decode_bounded_v1(bytes: [u8], max_items: i64,
        max_text_bytes: i64) -> NativeBuildArgvDecodeV1:
    if (max_items < 0 or max_items > NATIVE_BUILD_ARGV_MAX_ITEMS_V1 or
            max_text_bytes < 0 or max_text_bytes > NATIVE_BUILD_ARGV_MAX_TEXT_BYTES_V1):
        return _argv_failure_v1("nbav_invalid_budget", 0)
    if bytes.len() < 12 or bytes.len() > NATIVE_BUILD_ARGV_MAX_BYTES_V1:
        return _argv_failure_v1("nbav_size", 0)
    if bytes[0..4] != "NBAV".bytes() or _argv_read_u16_v1(bytes, 4) != 1 or
            _argv_read_u16_v1(bytes, 6) != 0:
        return _argv_failure_v1("nbav_identity", 0)
    val preflight_error = _argv_preflight_v1(bytes, max_items, max_text_bytes)
    if preflight_error != "": return _argv_failure_v1(preflight_error, 0)
    val count = _argv_read_u32_v1(bytes, 8) as i64
    var arguments: [text] = []
    var position: i64 = 12
    var index: i64 = 0
    while index < count:
        val length = _argv_read_u32_v1(bytes, position) as i64
        position = position + 4
        val raw = bytes[position..(position + length)]
        val decoded = match validated_utf8_bytes_to_text_linear(raw):
            case Ok(value): value
            case Err(_): ""
        arguments.push(decoded)
        position = position + length
        index = index + 1
    NativeBuildArgvDecodeV1(ok: true, arguments: arguments,
        arguments_materialized: arguments.len(), executable: false, error: "")

pub fn native_build_argv_decode_v1(bytes: [u8]) -> NativeBuildArgvDecodeV1:
    native_build_argv_decode_bounded_v1(bytes, NATIVE_BUILD_ARGV_MAX_ITEMS_V1,
        NATIVE_BUILD_ARGV_MAX_TEXT_BYTES_V1)

pub fn native_build_cli_provenance_digest_v1(bytes: [u8]) -> text:
    val decoded = native_build_argv_decode_v1(bytes)
    if not decoded.ok: return ""
    var framed = "simple.native-build.cli.v1".bytes()
    framed.push(0u8)
    for byte in bytes: framed.push(byte)
    sha256_u8_hex(framed)
