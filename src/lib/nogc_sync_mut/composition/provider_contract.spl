# Stable provider and CLI command boundary records for composition v1.
#
# These records contain fixed-width scalars and byte-arena offsets only. They
# intentionally contain no `text`, `any`, Simple object, collection, or
# function value that could leak a language-private layout across an ABI.

val SIMPLE_PROVIDER_QUERY_V1_ABI: u32 = 1
val SIMPLE_CLI_COMMAND_V1_INTERFACE: u64 = 5999723006133093425
val SIMPLE_CLI_COMMAND_V1_MAJOR: u32 = 1
val SIMPLE_CLI_COMMAND_V1_MINOR: u32 = 0
val SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE: u32 = 28
val SIMPLE_CLI_COMMAND_RESULT_V1_SIZE: u32 = 20

val SIMPLE_PROVIDER_OK: i32 = 0
val SIMPLE_PROVIDER_INTERFACE_UNKNOWN: i32 = 1
val SIMPLE_PROVIDER_MAJOR_UNSUPPORTED: i32 = 2
val SIMPLE_PROVIDER_DESCRIPTOR_TOO_SHORT: i32 = 3
val SIMPLE_PROVIDER_NOT_PROCESS_CALLABLE: i32 = 4
val SIMPLE_PROVIDER_CAPABILITY_DENIED: i32 = 5
val SIMPLE_PROVIDER_NOT_REGISTERED: i32 = 6
val SIMPLE_PROVIDER_MINOR_UNSUPPORTED: i32 = 7

val SIMPLE_PROVIDER_QUERY_V1_SIZE: u32 = 44
# Bytes 0..47 retain the original scalar result prefix. The full SHA-256 ABI
# identity occupies bytes 48..79 and bytes 80..83 remain reserved.
val SIMPLE_PROVIDER_DIGEST_V1_SIZE: u32 = 32
val SIMPLE_PROVIDER_QUERY_RESULT_V1_PREFIX_SIZE: u32 = 48
val SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE: u32 = 84

val SIMPLE_CLI_DESCRIBE: u32 = 1
val SIMPLE_CLI_VALIDATE_ARGS: u32 = 2
val SIMPLE_CLI_RUN: u32 = 3
val SIMPLE_CLI_COMPLETE: u32 = 4

val SIMPLE_CLI_OK: i32 = 0
val SIMPLE_CLI_INVALID_ARGS: i32 = 1
val SIMPLE_CLI_OPERATION_UNKNOWN: i32 = 2
val SIMPLE_CLI_PROVIDER_MISSING: i32 = 3

struct SimpleProviderQueryV1:
    descriptor_size: u32
    interface_id: u64
    minimum_major: u32
    minimum_minor: u32
    host_abi: u64
    target_offset: u32
    target_length: u32
    requested_capability_bits: u64

struct SimpleProviderDigestV1:
    word0: u32
    word1: u32
    word2: u32
    word3: u32
    word4: u32
    word5: u32
    word6: u32
    word7: u32

struct SimpleProviderQueryResultV1:
    status: i32
    provided_major: u32
    provided_minor: u32
    descriptor_size: u32
    interface_handle: u64
    provider_context: u64
    provider_identity_digest: u64
    implementation_digest: u64
    abi_digest: SimpleProviderDigestV1

struct SimpleCliCommandV1:
    descriptor_size: u32
    interface_major: u32
    interface_minor: u32
    describe_operation: u32
    validate_args_operation: u32
    run_operation: u32
    complete_operation: u32

struct SimpleCliCommandRequestV1:
    descriptor_size: u32
    operation: u32
    command_offset: u32
    command_length: u32
    args_offset: u32
    args_length: u32
    output_capacity: u32

struct SimpleCliCommandResultV1:
    status: i32
    output_offset: u32
    output_length: u32
    diagnostic_offset: u32
    diagnostic_length: u32

fn simple_provider_query_error_v1(status: i32) -> SimpleProviderQueryResultV1:
    SimpleProviderQueryResultV1(
        status: status,
        provided_major: 0,
        provided_minor: 0,
        descriptor_size: 0,
        interface_handle: 0,
        provider_context: 0,
        provider_identity_digest: 0,
        implementation_digest: 0,
        abi_digest: simple_provider_digest_zero_v1()
    )

fn simple_provider_digest_is_canonical_v1(digest: text) -> bool:
    if digest.len() != 64:
        return false
    var i = 0
    while i < digest.len():
        val code = digest.char_code_at(i)
        if not ((code >= 48 and code <= 57) or (code >= 97 and code <= 102)):
            return false
        i = i + 1
    true

fn simple_provider_digest_zero_v1() -> SimpleProviderDigestV1:
    SimpleProviderDigestV1(0, 0, 0, 0, 0, 0, 0, 0)

fn simple_provider_digest_is_zero_v1(digest: SimpleProviderDigestV1) -> bool:
    (digest.word0 == 0 and digest.word1 == 0 and digest.word2 == 0 and
        digest.word3 == 0 and digest.word4 == 0 and digest.word5 == 0 and
        digest.word6 == 0 and digest.word7 == 0)

fn simple_provider_digest_equal_v1(left: SimpleProviderDigestV1,
        right: SimpleProviderDigestV1) -> bool:
    (left.word0 == right.word0 and left.word1 == right.word1 and
        left.word2 == right.word2 and left.word3 == right.word3 and
        left.word4 == right.word4 and left.word5 == right.word5 and
        left.word6 == right.word6 and left.word7 == right.word7)

fn _simple_provider_hex_nibble_v1(code: i64) -> u32:
    if code >= 48 and code <= 57:
        return (code - 48) as u32
    (code - 87) as u32

fn _simple_provider_digest_word_v1(digest: text, offset: i64) -> u32:
    var value: u32 = 0
    var i = 0
    while i < 8:
        value = (value << 4) | _simple_provider_hex_nibble_v1(digest.char_code_at(offset + i))
        i = i + 1
    value

fn simple_provider_digest_from_hex_v1(digest: text) -> SimpleProviderDigestV1:
    if not simple_provider_digest_is_canonical_v1(digest):
        return simple_provider_digest_zero_v1()
    SimpleProviderDigestV1(
        _simple_provider_digest_word_v1(digest, 0),
        _simple_provider_digest_word_v1(digest, 8),
        _simple_provider_digest_word_v1(digest, 16),
        _simple_provider_digest_word_v1(digest, 24),
        _simple_provider_digest_word_v1(digest, 32),
        _simple_provider_digest_word_v1(digest, 40),
        _simple_provider_digest_word_v1(digest, 48),
        _simple_provider_digest_word_v1(digest, 56),
    )

fn _simple_provider_hex_digit_v1(value: u32) -> text:
    val digits = "0123456789abcdef"
    digits[value as i64:value as i64 + 1]

fn _simple_provider_digest_word_hex_v1(value: u32) -> text:
    var out = ""
    var shift: i64 = 28
    while shift >= 0:
        out = out + _simple_provider_hex_digit_v1((value >> shift) & 15)
        shift = shift - 4
    out

fn simple_provider_digest_to_hex_v1(digest: SimpleProviderDigestV1) -> text:
    (_simple_provider_digest_word_hex_v1(digest.word0) +
        _simple_provider_digest_word_hex_v1(digest.word1) +
        _simple_provider_digest_word_hex_v1(digest.word2) +
        _simple_provider_digest_word_hex_v1(digest.word3) +
        _simple_provider_digest_word_hex_v1(digest.word4) +
        _simple_provider_digest_word_hex_v1(digest.word5) +
        _simple_provider_digest_word_hex_v1(digest.word6) +
        _simple_provider_digest_word_hex_v1(digest.word7))
