# Stable wire-level contract for optional CPU vector kernel providers.
#
# This file defines only fixed-width values. It does not expose Simple arrays,
# text, closures, or provider addresses as part of the wire ABI.

val SIMPLE_VECTOR_KERNELS_V1_INTERFACE: u64 = 6001412934163845681
val SIMPLE_VECTOR_KERNELS_V1_MAJOR: u32 = 1
val SIMPLE_VECTOR_KERNELS_V1_MINOR: u32 = 0
val SIMPLE_VECTOR_KERNELS_V1_APPLY_SYMBOL: text = "simple_vector_apply_v1"

val SIMPLE_VECTOR_OP_BITMAP_AND_U32: u32 = 1
val SIMPLE_VECTOR_OP_BITMAP_OR_U32: u32 = 2
val SIMPLE_VECTOR_OP_HTTP_FIND_BYTE: u32 = 3
val SIMPLE_VECTOR_OP_HTTP_FIND_CRLF: u32 = 4

val SIMPLE_VECTOR_CAP_BITMAP_AND_U32: u64 = 1
val SIMPLE_VECTOR_CAP_BITMAP_OR_U32: u64 = 2
val SIMPLE_VECTOR_CAP_HTTP_FIND_BYTE: u64 = 4
val SIMPLE_VECTOR_CAP_HTTP_FIND_CRLF: u64 = 8

val SIMPLE_VECTOR_REQUEST_V1_SIZE: u32 = 64
val SIMPLE_VECTOR_RESPONSE_V1_SIZE: u32 = 24
val SIMPLE_VECTOR_MAX_SPAN_BYTES: u64 = 1073741824
val SIMPLE_VECTOR_MAX_ADDRESS: u64 = 9223372036854775807

val SIMPLE_VECTOR_STATUS_OK: u32 = 0
val SIMPLE_VECTOR_STATUS_INVALID_REQUEST: u32 = 1
val SIMPLE_VECTOR_STATUS_UNSUPPORTED_OPERATION: u32 = 2
val SIMPLE_VECTOR_STATUS_CAPABILITY_DENIED: u32 = 3
val SIMPLE_VECTOR_STATUS_RANGE_INVALID: u32 = 4
val SIMPLE_VECTOR_STATUS_FEATURE_UNAVAILABLE: u32 = 5
val SIMPLE_VECTOR_STATUS_EXECUTION_FAILED: u32 = 6

# Request wire bytes are little-endian: size@0:u32, opcode@4:u32,
# left-address@8:u64, left-bytes@16:u64, right-address@24:u64,
# right-bytes@32:u64, output-address@40:u64, output-capacity@48:u64,
# argument@56:u64. Addresses are borrowed process pointers valid only for the
# synchronous call; providers must never retain them.
struct SimpleVectorKernelRequestV1:
    opcode: u32
    left_address: u64
    left_bytes: u64
    right_address: u64
    right_bytes: u64
    output_address: u64
    output_capacity_bytes: u64
    argument: u64

# Response wire bytes are little-endian: size@0:u32, status@4:u32,
# bytes-written@8:u64, scalar-result@16:i64.
struct SimpleVectorKernelResponseV1:
    struct_size: u32
    status: u32
    bytes_written: u64
    scalar_result: i64

class SimpleVectorKernelRequestEncodingV1:
    ok: bool
    bytes: [u8]
    required_capability_bits: u64
    diagnostic: text

class SimpleVectorKernelResponseDecodeV1:
    ok: bool
    value: SimpleVectorKernelResponseV1
    diagnostic: text

export SIMPLE_VECTOR_KERNELS_V1_INTERFACE, SIMPLE_VECTOR_KERNELS_V1_MAJOR
export SIMPLE_VECTOR_KERNELS_V1_MINOR, SIMPLE_VECTOR_KERNELS_V1_APPLY_SYMBOL
export SIMPLE_VECTOR_OP_BITMAP_AND_U32, SIMPLE_VECTOR_OP_BITMAP_OR_U32
export SIMPLE_VECTOR_OP_HTTP_FIND_BYTE, SIMPLE_VECTOR_OP_HTTP_FIND_CRLF
export SIMPLE_VECTOR_CAP_BITMAP_AND_U32, SIMPLE_VECTOR_CAP_BITMAP_OR_U32
export SIMPLE_VECTOR_CAP_HTTP_FIND_BYTE, SIMPLE_VECTOR_CAP_HTTP_FIND_CRLF
export SIMPLE_VECTOR_REQUEST_V1_SIZE, SIMPLE_VECTOR_RESPONSE_V1_SIZE
export SIMPLE_VECTOR_MAX_SPAN_BYTES, SIMPLE_VECTOR_MAX_ADDRESS
export SIMPLE_VECTOR_STATUS_OK, SIMPLE_VECTOR_STATUS_INVALID_REQUEST
export SIMPLE_VECTOR_STATUS_UNSUPPORTED_OPERATION, SIMPLE_VECTOR_STATUS_CAPABILITY_DENIED
export SIMPLE_VECTOR_STATUS_RANGE_INVALID, SIMPLE_VECTOR_STATUS_FEATURE_UNAVAILABLE
export SIMPLE_VECTOR_STATUS_EXECUTION_FAILED
export SimpleVectorKernelRequestV1, SimpleVectorKernelResponseV1
export SimpleVectorKernelRequestEncodingV1, SimpleVectorKernelResponseDecodeV1
