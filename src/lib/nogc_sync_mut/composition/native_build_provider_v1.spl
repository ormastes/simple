"""Inactive outer ABI contract and route policy for the native-build facet."""

# This module freezes only Appendix A's packed outer records. It neither maps
# a provider nor interprets a driver payload. A decoded record is structural
# evidence, never session authority or permission to publish an artifact.

pub val SIMPLE_NATIVE_BUILD_V1_INTERFACE: u64 = 6002808248662896896u64
pub val SIMPLE_NATIVE_BUILD_V1_MAJOR: u32 = 1u32
pub val SIMPLE_NATIVE_BUILD_V1_MINOR: u32 = 0u32
pub val SIMPLE_NATIVE_BUILD_QUERY_ABI_V1: u32 = 1u32
pub val SIMPLE_NATIVE_BUILD_INVOKE_SYMBOL_V1: text = "simple_native_build_invoke_v1"
pub val SIMPLE_NATIVE_BUILD_INVOKE_PARAMETER_COUNT_V1: u32 = 6u32

pub val SIMPLE_NATIVE_BUILD_DESCRIPTOR_SIZE_V1: u32 = 96u32
pub val SIMPLE_NATIVE_BUILD_SESSION_SIZE_V1: u32 = 32u32
pub val SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1: u32 = 96u32
pub val SIMPLE_NATIVE_BUILD_RESULT_HEADER_SIZE_V1: u32 = 96u32
pub val SIMPLE_NATIVE_BUILD_PACKED_ALIGNMENT_V1: u32 = 1u32

pub val SIMPLE_NATIVE_BUILD_FLAG_SYNCHRONOUS_V1: u32 = 1u32
pub val SIMPLE_NATIVE_BUILD_FLAG_PROCESS_PINNED_V1: u32 = 2u32
pub val SIMPLE_NATIVE_BUILD_FLAG_BOOTSTRAP_ONLY_V1: u32 = 4u32

pub val SIMPLE_NATIVE_BUILD_OPEN_V1: u32 = 1u32
pub val SIMPLE_NATIVE_BUILD_RUN_V1: u32 = 2u32
pub val SIMPLE_NATIVE_BUILD_READ_V1: u32 = 3u32
pub val SIMPLE_NATIVE_BUILD_CLOSE_V1: u32 = 4u32

pub val SIMPLE_NATIVE_BUILD_MAX_REQUEST_BYTES_V1: u32 = 16777216u32
pub val SIMPLE_NATIVE_BUILD_MAX_PAGE_BYTES_V1: u32 = 1048576u32
pub val SIMPLE_NATIVE_BUILD_MAX_RESPONSE_BYTES_V1: u32 = 1048672u32
pub val SIMPLE_NATIVE_BUILD_MAX_RETAINED_RESULT_BYTES_V1: u64 = 268435456u64
pub val SIMPLE_NATIVE_BUILD_MAX_ITEMS_V1: u32 = 1048576u32
pub val SIMPLE_NATIVE_BUILD_MAX_TEXT_FIELD_BYTES_V1: u32 = 1048576u32
pub val SIMPLE_NATIVE_BUILD_MAX_SECTIONS_V1: u32 = 8u32
pub val SIMPLE_NATIVE_BUILD_MAX_PAYLOAD_DEPTH_V1: u32 = 32u32
pub val SIMPLE_NATIVE_BUILD_MAX_LIVE_SESSIONS_V1: u32 = 64u32
pub val SIMPLE_NATIVE_BUILD_MAX_WORK_UNITS_V1: u64 = 9223372036854775807u64
pub val SIMPLE_NATIVE_BUILD_MAX_WALL_TIME_MS_V1: u32 = 86400000u32

pub val SIMPLE_NATIVE_BUILD_OK_V1: i32 = 0
pub val SIMPLE_NATIVE_BUILD_INVALID_REQUEST_V1: i32 = 1
pub val SIMPLE_NATIVE_BUILD_INVALID_SESSION_V1: i32 = 2
pub val SIMPLE_NATIVE_BUILD_UNSUPPORTED_OPERATION_V1: i32 = 3
pub val SIMPLE_NATIVE_BUILD_UNSUPPORTED_PROFILE_V1: i32 = 4
pub val SIMPLE_NATIVE_BUILD_BUDGET_EXCEEDED_V1: i32 = 5
pub val SIMPLE_NATIVE_BUILD_BUSY_V1: i32 = 6
pub val SIMPLE_NATIVE_BUILD_ALREADY_RUN_V1: i32 = 7
pub val SIMPLE_NATIVE_BUILD_COMPILE_FAILED_V1: i32 = 8
pub val SIMPLE_NATIVE_BUILD_CANCELLED_V1: i32 = 9
pub val SIMPLE_NATIVE_BUILD_OUTPUT_TOO_SMALL_V1: i32 = 10
pub val SIMPLE_NATIVE_BUILD_ADMISSION_DENIED_V1: i32 = 11
pub val SIMPLE_NATIVE_BUILD_CLEANUP_FAILED_V1: i32 = 12
pub val SIMPLE_NATIVE_BUILD_INTERNAL_ERROR_V1: i32 = 13

pub val SIMPLE_NATIVE_BUILD_TERMINAL_NONE_V1: u32 = 0u32
pub val SIMPLE_NATIVE_BUILD_TERMINAL_READY_V1: u32 = 1u32
pub val SIMPLE_NATIVE_BUILD_TERMINAL_SUCCEEDED_V1: u32 = 2u32
pub val SIMPLE_NATIVE_BUILD_TERMINAL_FAILED_V1: u32 = 3u32
pub val SIMPLE_NATIVE_BUILD_TERMINAL_CANCELLED_V1: u32 = 4u32
pub val SIMPLE_NATIVE_BUILD_TERMINAL_CLOSED_V1: u32 = 5u32

pub val SIMPLE_NATIVE_BUILD_CLEANUP_NOT_REQUESTED_V1: u32 = 0u32
pub val SIMPLE_NATIVE_BUILD_CLEANUP_RELEASED_V1: u32 = 1u32
pub val SIMPLE_NATIVE_BUILD_CLEANUP_RETAINED_V1: u32 = 2u32
pub val SIMPLE_NATIVE_BUILD_RESULT_EOF_V1: u32 = 1u32

pub struct SimpleNativeBuildV1:
    descriptor_size: u32
    major: u32
    minor: u32
    flags: u32
    interface_id: u64
    query_abi: u32
    request_size: u32
    result_size: u32
    session_size: u32
    open_operation: u32
    run_operation: u32
    read_operation: u32
    close_operation: u32
    max_request_bytes: u32
    max_page_bytes: u32
    max_retained_result_bytes: u64
    max_items: u32
    max_text_field_bytes: u32
    max_sections: u32
    max_payload_depth: u32
    reserved: u64

pub struct SimpleNativeBuildSessionV1:
    manager_id: u64
    provider_instance: u64
    provider_generation: u64
    session_nonce: u64

pub struct SimpleNativeBuildRequestV1:
    descriptor_size: u32
    operation: u32
    session: SimpleNativeBuildSessionV1
    payload_offset: u32
    payload_length: u32
    section: u32
    output_page_capacity: u32
    section_offset: u64
    max_retained_result_bytes: u64
    max_work_units: u64
    max_items: u32
    max_text_field_bytes: u32
    max_wall_time_ms: u32
    reserved: u32

pub struct SimpleNativeBuildResultV1:
    descriptor_size: u32
    status: i32
    command_exit_status: i32
    terminal_state: u32
    session: SimpleNativeBuildSessionV1
    section: u32
    flags: u32
    section_length: u64
    page_offset: u64
    payload_offset: u32
    payload_length: u32
    required_capacity: u32
    cleanup_state: u32
    reserved: u64

pub struct NativeBuildDescriptorDecodeV1:
    ok: bool
    value: SimpleNativeBuildV1?
    error: text

pub struct NativeBuildRequestDecodeV1:
    ok: bool
    value: SimpleNativeBuildRequestV1?
    payload: [u8]
    # Outer framing does not establish owner session authority or payload ABI.
    authority_available: bool
    execution_available: bool
    error: text

pub struct NativeBuildResultDecodeV1:
    ok: bool
    value: SimpleNativeBuildResultV1?
    payload: [u8]
    authority_available: bool
    publication_available: bool
    error: text

pub enum NativeBuildCommandProfileV1:
    LocalOnly
    NormalProduct
    StagedBootstrap
    Stage4

pub enum NativeBuildProviderRouteV1:
    LocalNoProvider
    PureSimple
    BootstrapCompatibility
    Refused

pub struct NativeBuildPolicyDecisionV1:
    route: NativeBuildProviderRouteV1
    provider_selection_required: bool
    provider_mapping_authorized: bool
    reason: text

fn _push_u32_v1(buffer: [u8], value: u32) -> [u8]:
    var out = buffer
    var shift: u32 = 0u32
    while shift < 32u32:
        out.push(((value >> shift) & 255u32) as u8)
        shift = shift + 8u32
    out

fn _push_i32_v1(buffer: [u8], value: i32) -> [u8]:
    _push_u32_v1(buffer, value as u32)

fn _push_u64_v1(buffer: [u8], value: u64) -> [u8]:
    var out = buffer
    var shift: u64 = 0u64
    while shift < 64u64:
        out.push(((value >> shift) & 255u64) as u8)
        shift = shift + 8u64
    out

fn _read_u32_v1(bytes: [u8], offset: i64) -> u32:
    var value: u32 = 0u32
    var index: i64 = 0
    while index < 4:
        value = value | ((bytes[offset + index] as u32) << ((index * 8) as u32))
        index = index + 1
    value

fn _read_i32_v1(bytes: [u8], offset: i64) -> i32:
    _read_u32_v1(bytes, offset) as i32

fn _read_u64_v1(bytes: [u8], offset: i64) -> u64:
    var value: u64 = 0u64
    var index: i64 = 0
    while index < 8:
        value = value | ((bytes[offset + index] as u64) << ((index * 8) as u64))
        index = index + 1
    value

fn _append_session_v1(buffer: [u8], session: SimpleNativeBuildSessionV1) -> [u8]:
    var out = _push_u64_v1(buffer, session.manager_id)
    out = _push_u64_v1(out, session.provider_instance)
    out = _push_u64_v1(out, session.provider_generation)
    _push_u64_v1(out, session.session_nonce)

fn _read_session_v1(bytes: [u8], offset: i64) -> SimpleNativeBuildSessionV1:
    SimpleNativeBuildSessionV1(manager_id: _read_u64_v1(bytes, offset),
        provider_instance: _read_u64_v1(bytes, offset + 8),
        provider_generation: _read_u64_v1(bytes, offset + 16),
        session_nonce: _read_u64_v1(bytes, offset + 24))

pub fn simple_native_build_session_zero_v1() -> SimpleNativeBuildSessionV1:
    SimpleNativeBuildSessionV1(manager_id: 0u64, provider_instance: 0u64,
        provider_generation: 0u64, session_nonce: 0u64)

pub fn simple_native_build_session_is_zero_v1(
        session: SimpleNativeBuildSessionV1) -> bool:
    session.manager_id == 0u64 and session.provider_instance == 0u64 and
        session.provider_generation == 0u64 and session.session_nonce == 0u64

pub fn simple_native_build_session_coordinates_declared_v1(
        session: SimpleNativeBuildSessionV1) -> bool:
    session.manager_id != 0u64 and session.provider_instance != 0u64 and
        session.provider_generation != 0u64 and session.session_nonce != 0u64

pub fn simple_native_build_descriptor_v1(bootstrap_only: bool) -> SimpleNativeBuildV1:
    val flags = SIMPLE_NATIVE_BUILD_FLAG_SYNCHRONOUS_V1 |
        SIMPLE_NATIVE_BUILD_FLAG_PROCESS_PINNED_V1 |
        (if bootstrap_only: SIMPLE_NATIVE_BUILD_FLAG_BOOTSTRAP_ONLY_V1 else: 0u32)
    SimpleNativeBuildV1(descriptor_size: SIMPLE_NATIVE_BUILD_DESCRIPTOR_SIZE_V1,
        major: SIMPLE_NATIVE_BUILD_V1_MAJOR, minor: SIMPLE_NATIVE_BUILD_V1_MINOR,
        flags: flags, interface_id: SIMPLE_NATIVE_BUILD_V1_INTERFACE,
        query_abi: SIMPLE_NATIVE_BUILD_QUERY_ABI_V1,
        request_size: SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1,
        result_size: SIMPLE_NATIVE_BUILD_RESULT_HEADER_SIZE_V1,
        session_size: SIMPLE_NATIVE_BUILD_SESSION_SIZE_V1,
        open_operation: SIMPLE_NATIVE_BUILD_OPEN_V1,
        run_operation: SIMPLE_NATIVE_BUILD_RUN_V1,
        read_operation: SIMPLE_NATIVE_BUILD_READ_V1,
        close_operation: SIMPLE_NATIVE_BUILD_CLOSE_V1,
        max_request_bytes: SIMPLE_NATIVE_BUILD_MAX_REQUEST_BYTES_V1,
        max_page_bytes: SIMPLE_NATIVE_BUILD_MAX_PAGE_BYTES_V1,
        max_retained_result_bytes: SIMPLE_NATIVE_BUILD_MAX_RETAINED_RESULT_BYTES_V1,
        max_items: SIMPLE_NATIVE_BUILD_MAX_ITEMS_V1,
        max_text_field_bytes: SIMPLE_NATIVE_BUILD_MAX_TEXT_FIELD_BYTES_V1,
        max_sections: SIMPLE_NATIVE_BUILD_MAX_SECTIONS_V1,
        max_payload_depth: SIMPLE_NATIVE_BUILD_MAX_PAYLOAD_DEPTH_V1,
        reserved: 0u64)

pub fn simple_native_build_descriptor_encode_v1(value: SimpleNativeBuildV1) -> [u8]:
    var out: [u8] = []
    for field in [value.descriptor_size, value.major, value.minor, value.flags]:
        out = _push_u32_v1(out, field)
    out = _push_u64_v1(out, value.interface_id)
    for field in [value.query_abi, value.request_size, value.result_size,
            value.session_size, value.open_operation, value.run_operation,
            value.read_operation, value.close_operation, value.max_request_bytes,
            value.max_page_bytes]:
        out = _push_u32_v1(out, field)
    out = _push_u64_v1(out, value.max_retained_result_bytes)
    for field in [value.max_items, value.max_text_field_bytes,
            value.max_sections, value.max_payload_depth]:
        out = _push_u32_v1(out, field)
    _push_u64_v1(out, value.reserved)

fn _descriptor_failure_v1(error: text) -> NativeBuildDescriptorDecodeV1:
    NativeBuildDescriptorDecodeV1(ok: false, value: nil, error: error)

pub fn simple_native_build_descriptor_decode_v1(
        bytes: [u8]) -> NativeBuildDescriptorDecodeV1:
    if bytes.len() != SIMPLE_NATIVE_BUILD_DESCRIPTOR_SIZE_V1 as i64:
        return _descriptor_failure_v1("native_build_descriptor_size")
    val value = SimpleNativeBuildV1(descriptor_size: _read_u32_v1(bytes, 0),
        major: _read_u32_v1(bytes, 4), minor: _read_u32_v1(bytes, 8),
        flags: _read_u32_v1(bytes, 12), interface_id: _read_u64_v1(bytes, 16),
        query_abi: _read_u32_v1(bytes, 24), request_size: _read_u32_v1(bytes, 28),
        result_size: _read_u32_v1(bytes, 32), session_size: _read_u32_v1(bytes, 36),
        open_operation: _read_u32_v1(bytes, 40), run_operation: _read_u32_v1(bytes, 44),
        read_operation: _read_u32_v1(bytes, 48), close_operation: _read_u32_v1(bytes, 52),
        max_request_bytes: _read_u32_v1(bytes, 56), max_page_bytes: _read_u32_v1(bytes, 60),
        max_retained_result_bytes: _read_u64_v1(bytes, 64),
        max_items: _read_u32_v1(bytes, 72), max_text_field_bytes: _read_u32_v1(bytes, 76),
        max_sections: _read_u32_v1(bytes, 80), max_payload_depth: _read_u32_v1(bytes, 84),
        reserved: _read_u64_v1(bytes, 88))
    val required_flags = SIMPLE_NATIVE_BUILD_FLAG_SYNCHRONOUS_V1 |
        SIMPLE_NATIVE_BUILD_FLAG_PROCESS_PINNED_V1
    if (value.descriptor_size != SIMPLE_NATIVE_BUILD_DESCRIPTOR_SIZE_V1 or
            value.major != SIMPLE_NATIVE_BUILD_V1_MAJOR or
            value.minor != SIMPLE_NATIVE_BUILD_V1_MINOR or
            value.interface_id != SIMPLE_NATIVE_BUILD_V1_INTERFACE or
            value.query_abi != SIMPLE_NATIVE_BUILD_QUERY_ABI_V1 or
            value.request_size != SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1 or
            value.result_size != SIMPLE_NATIVE_BUILD_RESULT_HEADER_SIZE_V1 or
            value.session_size != SIMPLE_NATIVE_BUILD_SESSION_SIZE_V1):
        return _descriptor_failure_v1("native_build_descriptor_identity")
    if (value.flags & required_flags) != required_flags or value.flags > 7u32:
        return _descriptor_failure_v1("native_build_descriptor_flags")
    val expected = simple_native_build_descriptor_v1(
        (value.flags & SIMPLE_NATIVE_BUILD_FLAG_BOOTSTRAP_ONLY_V1) != 0u32)
    if simple_native_build_descriptor_encode_v1(value) !=
            simple_native_build_descriptor_encode_v1(expected):
        return _descriptor_failure_v1("native_build_descriptor_contract")
    NativeBuildDescriptorDecodeV1(ok: true, value: Some(value), error: "")

pub fn simple_native_build_request_encode_v1(value: SimpleNativeBuildRequestV1,
        payload: [u8]) -> [u8]:
    var out = _push_u32_v1([], value.descriptor_size)
    out = _push_u32_v1(out, value.operation)
    out = _append_session_v1(out, value.session)
    for field in [value.payload_offset, value.payload_length, value.section,
            value.output_page_capacity]:
        out = _push_u32_v1(out, field)
    out = _push_u64_v1(out, value.section_offset)
    out = _push_u64_v1(out, value.max_retained_result_bytes)
    out = _push_u64_v1(out, value.max_work_units)
    for field in [value.max_items, value.max_text_field_bytes,
            value.max_wall_time_ms, value.reserved]:
        out = _push_u32_v1(out, field)
    for byte in payload: out.push(byte)
    out

fn _request_failure_v1(error: text) -> NativeBuildRequestDecodeV1:
    NativeBuildRequestDecodeV1(ok: false, value: nil, payload: [],
        authority_available: false, execution_available: false, error: error)

fn _request_non_payload_fields_zero_v1(value: SimpleNativeBuildRequestV1) -> bool:
    value.payload_length == 0u32 and value.section == 0u32 and
        value.output_page_capacity == 0u32 and value.section_offset == 0u64 and
        value.max_retained_result_bytes == 0u64 and value.max_work_units == 0u64 and
        value.max_items == 0u32 and value.max_text_field_bytes == 0u32 and
        value.max_wall_time_ms == 0u32

pub fn simple_native_build_request_decode_outer_v1(
        bytes: [u8]) -> NativeBuildRequestDecodeV1:
    if bytes.len() < SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1 as i64 or
            bytes.len() > SIMPLE_NATIVE_BUILD_MAX_REQUEST_BYTES_V1 as i64:
        return _request_failure_v1("native_build_request_size")
    val value = SimpleNativeBuildRequestV1(
        descriptor_size: _read_u32_v1(bytes, 0), operation: _read_u32_v1(bytes, 4),
        session: _read_session_v1(bytes, 8), payload_offset: _read_u32_v1(bytes, 40),
        payload_length: _read_u32_v1(bytes, 44), section: _read_u32_v1(bytes, 48),
        output_page_capacity: _read_u32_v1(bytes, 52),
        section_offset: _read_u64_v1(bytes, 56),
        max_retained_result_bytes: _read_u64_v1(bytes, 64),
        max_work_units: _read_u64_v1(bytes, 72), max_items: _read_u32_v1(bytes, 80),
        max_text_field_bytes: _read_u32_v1(bytes, 84),
        max_wall_time_ms: _read_u32_v1(bytes, 88), reserved: _read_u32_v1(bytes, 92))
    if value.descriptor_size != SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1 or
            value.payload_offset != SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1 or
            value.reserved != 0u32:
        return _request_failure_v1("native_build_request_header")
    if value.payload_length as i64 > bytes.len() - value.payload_offset as i64 or
            value.payload_length as i64 != bytes.len() - value.payload_offset as i64:
        return _request_failure_v1("native_build_request_payload_range")
    if value.operation == SIMPLE_NATIVE_BUILD_OPEN_V1:
        if (not simple_native_build_session_is_zero_v1(value.session) or
                value.section != 0u32 or value.output_page_capacity != 0u32 or
                value.section_offset != 0u64 or value.payload_length == 0u32):
            return _request_failure_v1("native_build_open_shape")
        if (value.max_retained_result_bytes == 0u64 or
                value.max_retained_result_bytes > SIMPLE_NATIVE_BUILD_MAX_RETAINED_RESULT_BYTES_V1 or
                value.max_work_units == 0u64 or
                value.max_work_units > SIMPLE_NATIVE_BUILD_MAX_WORK_UNITS_V1 or
                value.max_items == 0u32 or value.max_items > SIMPLE_NATIVE_BUILD_MAX_ITEMS_V1 or
                value.max_text_field_bytes == 0u32 or
                value.max_text_field_bytes > SIMPLE_NATIVE_BUILD_MAX_TEXT_FIELD_BYTES_V1 or
                value.max_wall_time_ms == 0u32 or
                value.max_wall_time_ms > SIMPLE_NATIVE_BUILD_MAX_WALL_TIME_MS_V1):
            return _request_failure_v1("native_build_open_budget")
    else:
        if bytes.len() != SIMPLE_NATIVE_BUILD_REQUEST_HEADER_SIZE_V1 as i64 or
                not simple_native_build_session_coordinates_declared_v1(value.session):
            return _request_failure_v1("native_build_session_shape")
        if value.operation == SIMPLE_NATIVE_BUILD_RUN_V1 or
                value.operation == SIMPLE_NATIVE_BUILD_CLOSE_V1:
            if not _request_non_payload_fields_zero_v1(value):
                return _request_failure_v1("native_build_operation_shape")
        else if value.operation == SIMPLE_NATIVE_BUILD_READ_V1:
            if (value.payload_length != 0u32 or value.section < 1u32 or
                    value.section > 6u32 or value.output_page_capacity == 0u32 or
                    value.output_page_capacity > SIMPLE_NATIVE_BUILD_MAX_PAGE_BYTES_V1 or
                    value.max_retained_result_bytes != 0u64 or
                    value.max_work_units != 0u64 or value.max_items != 0u32 or
                    value.max_text_field_bytes != 0u32 or value.max_wall_time_ms != 0u32):
                return _request_failure_v1("native_build_read_shape")
        else:
            return _request_failure_v1("native_build_operation_unknown")
    val payload = bytes[(value.payload_offset as i64)..bytes.len()]
    NativeBuildRequestDecodeV1(ok: true, value: Some(value), payload: payload,
        authority_available: false, execution_available: false, error: "")

pub fn simple_native_build_result_encode_v1(value: SimpleNativeBuildResultV1,
        payload: [u8]) -> [u8]:
    var out = _push_u32_v1([], value.descriptor_size)
    out = _push_i32_v1(out, value.status)
    out = _push_i32_v1(out, value.command_exit_status)
    out = _push_u32_v1(out, value.terminal_state)
    out = _append_session_v1(out, value.session)
    out = _push_u32_v1(out, value.section)
    out = _push_u32_v1(out, value.flags)
    out = _push_u64_v1(out, value.section_length)
    out = _push_u64_v1(out, value.page_offset)
    for field in [value.payload_offset, value.payload_length,
            value.required_capacity, value.cleanup_state]:
        out = _push_u32_v1(out, field)
    out = _push_u64_v1(out, value.reserved)
    for byte in payload: out.push(byte)
    out

fn _result_failure_v1(error: text) -> NativeBuildResultDecodeV1:
    NativeBuildResultDecodeV1(ok: false, value: nil, payload: [],
        authority_available: false, publication_available: false, error: error)

pub fn simple_native_build_result_decode_outer_v1(
        bytes: [u8]) -> NativeBuildResultDecodeV1:
    if bytes.len() < SIMPLE_NATIVE_BUILD_RESULT_HEADER_SIZE_V1 as i64 or
            bytes.len() > SIMPLE_NATIVE_BUILD_MAX_RESPONSE_BYTES_V1 as i64:
        return _result_failure_v1("native_build_result_size")
    val value = SimpleNativeBuildResultV1(descriptor_size: _read_u32_v1(bytes, 0),
        status: _read_i32_v1(bytes, 4), command_exit_status: _read_i32_v1(bytes, 8),
        terminal_state: _read_u32_v1(bytes, 12), session: _read_session_v1(bytes, 16),
        section: _read_u32_v1(bytes, 48), flags: _read_u32_v1(bytes, 52),
        section_length: _read_u64_v1(bytes, 56), page_offset: _read_u64_v1(bytes, 64),
        payload_offset: _read_u32_v1(bytes, 72), payload_length: _read_u32_v1(bytes, 76),
        required_capacity: _read_u32_v1(bytes, 80), cleanup_state: _read_u32_v1(bytes, 84),
        reserved: _read_u64_v1(bytes, 88))
    if (value.descriptor_size != SIMPLE_NATIVE_BUILD_RESULT_HEADER_SIZE_V1 or
            value.status < SIMPLE_NATIVE_BUILD_OK_V1 or
            value.status > SIMPLE_NATIVE_BUILD_INTERNAL_ERROR_V1 or
            value.terminal_state > SIMPLE_NATIVE_BUILD_TERMINAL_CLOSED_V1 or
            value.flags > SIMPLE_NATIVE_BUILD_RESULT_EOF_V1 or
            value.payload_offset != SIMPLE_NATIVE_BUILD_RESULT_HEADER_SIZE_V1 or
            value.payload_length > SIMPLE_NATIVE_BUILD_MAX_PAGE_BYTES_V1 or
            value.required_capacity > SIMPLE_NATIVE_BUILD_MAX_RESPONSE_BYTES_V1 or
            value.cleanup_state > SIMPLE_NATIVE_BUILD_CLEANUP_RETAINED_V1 or
            value.reserved != 0u64):
        return _result_failure_v1("native_build_result_header")
    if value.payload_length as i64 != bytes.len() - value.payload_offset as i64:
        return _result_failure_v1("native_build_result_payload_range")
    if value.section == 0u32:
        if (value.flags != 0u32 or value.section_length != 0u64 or
                value.page_offset != 0u64 or value.payload_length != 0u32):
            return _result_failure_v1("native_build_non_read_result_shape")
    else:
        if value.section > 6u32:
            return _result_failure_v1("native_build_read_result_shape")
        val page_bytes = value.payload_length as u64
        if (value.section_length > SIMPLE_NATIVE_BUILD_MAX_RETAINED_RESULT_BYTES_V1 or
                value.page_offset > value.section_length):
            return _result_failure_v1("native_build_read_result_bounds")
        # Subtraction against the already-bounded section is the overflow-safe
        # precondition for the addition below; MAX/foreign offsets fail here.
        if page_bytes > value.section_length - value.page_offset:
            return _result_failure_v1("native_build_read_result_bounds")
        val page_end = value.page_offset + page_bytes
        if page_end > value.section_length:
            return _result_failure_v1("native_build_read_result_bounds")
        val at_eof = (value.flags & SIMPLE_NATIVE_BUILD_RESULT_EOF_V1) != 0u32
        if at_eof != (page_end == value.section_length):
            return _result_failure_v1("native_build_read_result_eof")
    val payload = bytes[(value.payload_offset as i64)..bytes.len()]
    NativeBuildResultDecodeV1(ok: true, value: Some(value), payload: payload,
        authority_available: false, publication_available: false, error: "")

pub fn native_build_route_policy_v1(profile: NativeBuildCommandProfileV1,
        pure_simple_provider_available: bool, bootstrap_provider_available: bool,
        bootstrap_artifact_admitted: bool,
        explicit_bootstrap_compatibility: bool) -> NativeBuildPolicyDecisionV1:
    match profile:
        case NativeBuildCommandProfileV1.LocalOnly:
            NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.LocalNoProvider,
                provider_selection_required: false, provider_mapping_authorized: false,
                reason: "local_command")
        case NativeBuildCommandProfileV1.NormalProduct:
            if explicit_bootstrap_compatibility:
                return NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.Refused,
                    provider_selection_required: false, provider_mapping_authorized: false,
                    reason: "bootstrap_forbidden_for_normal")
            if not pure_simple_provider_available:
                return NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.Refused,
                    provider_selection_required: true, provider_mapping_authorized: false,
                    reason: "pure_simple_provider_required")
            NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.PureSimple,
                provider_selection_required: true, provider_mapping_authorized: false,
                reason: "pure_simple_route_required")
        case NativeBuildCommandProfileV1.Stage4:
            if explicit_bootstrap_compatibility:
                return NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.Refused,
                    provider_selection_required: false, provider_mapping_authorized: false,
                    reason: "bootstrap_forbidden_for_stage4")
            if not pure_simple_provider_available:
                return NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.Refused,
                    provider_selection_required: true, provider_mapping_authorized: false,
                    reason: "pure_simple_provider_required")
            NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.PureSimple,
                provider_selection_required: true, provider_mapping_authorized: false,
                reason: "stage4_pure_simple_required")
        case NativeBuildCommandProfileV1.StagedBootstrap:
            if explicit_bootstrap_compatibility:
                if not bootstrap_provider_available or not bootstrap_artifact_admitted:
                    return NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.Refused,
                        provider_selection_required: true, provider_mapping_authorized: false,
                        reason: "bootstrap_provider_not_admitted")
                return NativeBuildPolicyDecisionV1(
                    route: NativeBuildProviderRouteV1.BootstrapCompatibility,
                    provider_selection_required: true, provider_mapping_authorized: false,
                    reason: "explicit_staged_bootstrap_route")
            if not pure_simple_provider_available:
                return NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.Refused,
                    provider_selection_required: true, provider_mapping_authorized: false,
                    reason: "pure_simple_provider_required")
            NativeBuildPolicyDecisionV1(route: NativeBuildProviderRouteV1.PureSimple,
                provider_selection_required: true, provider_mapping_authorized: false,
                reason: "staged_pure_simple_route")
