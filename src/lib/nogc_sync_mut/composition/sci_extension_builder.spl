# Build/config-only section-10 projection and mutation-visible identity.

use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.nogc_sync_mut.composition.cli_extension_config.{cli_extension_registry_from_sdn_v1}
use std.nogc_sync_mut.composition.sci_extension_router.{SCI_ROUTE_KIND_EXTENSION_NAMESPACE_V1}
use std.nogc_sync_mut.composition.sci_generator.{SciRouteSourceV1, sci_generate_route_section_v1}
use std.nogc_sync_mut.composition.types.{SimpleCompositionImageV1}
use std.nogc_sync_mut.composition.codec.{encode_composition_image_with_cli_option_route_v1}

struct SciExtensionArtifactV1:
    ok: bool
    error: text
    config_sha256: text
    artifact_sha256: text
    bytes: [u8]
    namespace_count: i64

fn _artifact_error(config_sha256: text, message: text) -> SciExtensionArtifactV1:
    SciExtensionArtifactV1(false, message, config_sha256, "", [], 0)

fn sci_compile_extension_config_v1(image: SimpleCompositionImageV1, source: text, generation: i64) -> SciExtensionArtifactV1:
    val config_sha256 = sha256_text(source)
    if generation <= 0:
        return _artifact_error(config_sha256, "SCI_GEN_GENERATION: generation must be positive")
    val table = match cli_extension_registry_from_sdn_v1(source):
        case Ok(value): value
        case Err(message): return _artifact_error(config_sha256, message)
    var routes: [SciRouteSourceV1] = []
    var i = 0
    while i < table.namespaces.len():
        val ns = table.namespaces[i]
        routes.push(SciRouteSourceV1(ns.namespace,
            SCI_ROUTE_KIND_EXTENSION_NAMESPACE_V1, ns.availability,
            ns.provider_id, ns.missing_policy, 0))
        i = i + 1
    val generated = sci_generate_route_section_v1(routes, generation)
    if not generated.ok:
        return _artifact_error(config_sha256, generated.error_code + ": " + generated.error_message)
    val encoded = match encode_composition_image_with_cli_option_route_v1(image, generated.bytes):
        case Ok(value): value
        case Err(message): return _artifact_error(config_sha256, message)
    SciExtensionArtifactV1(true, "", config_sha256, sha256_u8_hex(encoded),
        encoded, generated.route_count)

export SciExtensionArtifactV1, sci_compile_extension_config_v1
