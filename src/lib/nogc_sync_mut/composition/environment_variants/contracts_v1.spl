# codex-impl
# Environment-optimized provider boundary contracts.
#
# These records are ABI-safe values only: fixed-width scalars and references
# into caller-owned immutable arenas. They deliberately contain no Simple text,
# collection, object, closure, AST, or HIR representation.

pub const ENV_VARIANT_SCHEMA_V1: u16 = 1u16
pub const ENV_VARIANT_MAX_FEATURE_WORDS_V1: u32 = 64u32
pub const ENV_VARIANT_MAX_GPU_DEVICES_V1: u32 = 16u32
pub const ENV_VARIANT_MAX_DEPENDENCIES_V1: u32 = 64u32
pub const ENV_VARIANT_MAX_FACET_BINDINGS_V1: u32 = 256u32
pub const ENV_VARIANT_MAX_REJECTIONS_V1: u32 = 256u32
pub const ENV_VARIANT_MAX_ARENA_BYTES_V1: u32 = 1048576u32
pub const ENV_VARIANT_MAX_BATCH_REGIONS_V1: u32 = 1048576u32

pub const ENV_ARCH_UNKNOWN_V1: u16 = 0u16
pub const ENV_ARCH_X86_64_V1: u16 = 1u16
pub const ENV_ARCH_AARCH64_V1: u16 = 2u16
pub const ENV_ARCH_RISCV64_V1: u16 = 3u16
pub const ENV_ARCH_WASM32_V1: u16 = 4u16

pub const ENV_VECTOR_NONE_V1: u16 = 0u16
pub const ENV_VECTOR_FIXED_V1: u16 = 1u16
pub const ENV_VECTOR_SCALABLE_V1: u16 = 2u16

pub const ENV_PLACEMENT_STATIC_V1: u16 = 1u16
pub const ENV_PLACEMENT_NATIVE_DYNLIB_V1: u16 = 2u16
pub const ENV_PLACEMENT_SMF_V1: u16 = 3u16
pub const ENV_PLACEMENT_JIT_V1: u16 = 4u16
pub const ENV_PLACEMENT_CONTAINED_WORKER_V1: u16 = 5u16

pub const ENV_FACET_FRONTEND_V1: u16 = 1u16
pub const ENV_FRONTEND_CREATE_SESSION_V1: u16 = 1u16
pub const ENV_FRONTEND_PLAN_REGIONS_V1: u16 = 2u16
pub const ENV_FRONTEND_EXECUTE_BATCH_V1: u16 = 3u16
pub const ENV_FRONTEND_INSPECT_RECEIPT_V1: u16 = 4u16
pub const ENV_FRONTEND_RELEASE_SESSION_V1: u16 = 5u16

pub enum EnvironmentVariantContractErrorV1:
    UnsupportedSchema
    DescriptorTooShort
    InvalidIdentity
    InvalidArchitecture
    InvalidAbi
    InvalidArena
    RangeOverflow
    CapacityExceeded
    InvalidFeatureSet
    FeatureAuthorityViolation
    InvalidVectorState
    InvalidGpuDevice
    InvalidPlacement
    InvalidArtifact
    InvalidContract
    InvalidDependency
    InvalidResourceBounds
    InvalidGeneration
    InvalidFacet
    InvalidRejection
    InvalidFrontendOperation

pub struct EnvironmentDigest256V1:
    w0: u64
    w1: u64
    w2: u64
    w3: u64

pub struct EnvironmentArenaRangeV1:
    offset: u32
    count: u32

pub struct EnvironmentFeatureSetV1:
    architecture: u16
    words: EnvironmentArenaRangeV1

pub struct EnvironmentGpuDeviceV1:
    device_identity: EnvironmentDigest256V1
    api_id: u32
    api_version: u32
    enabled_feature_words: EnvironmentArenaRangeV1
    memory_domain_bits: u64
    max_buffer_bytes: u64
    max_workgroup_invocations: u32
    queue_family_count: u32

pub struct EnvironmentSnapshotV1:
    descriptor_size: u32
    schema_version: u16
    execution_architecture: u16
    os_id: u32
    abi_id: u32
    object_format_id: u32
    endian_id: u16
    pointer_width_bits: u16
    snapshot_identity: EnvironmentDigest256V1
    snapshot_generation: u64
    execution_domain_identity: EnvironmentDigest256V1
    hardware_features: EnvironmentFeatureSetV1
    os_usable_features: EnvironmentFeatureSetV1
    policy_allowed_features: EnvironmentFeatureSetV1
    vector_state_mode: u16
    vector_length_bits: u32
    loader_permission_bits: u64
    allowed_effect_bits: u64
    numerical_contract_id: u32
    resource_layout_digest: EnvironmentDigest256V1
    gpu_devices: EnvironmentArenaRangeV1

pub struct VariantDependencyV1:
    provider_identity: EnvironmentDigest256V1
    contract_identity: EnvironmentDigest256V1
    minimum_contract_major: u16
    minimum_contract_minor: u16
    artifact_digest: EnvironmentDigest256V1

pub struct VariantDescriptorV1:
    descriptor_size: u32
    schema_version: u16
    placement: u16
    provider_identity: EnvironmentDigest256V1
    variant_identity: EnvironmentDigest256V1
    contract_identity: EnvironmentDigest256V1
    contract_major: u16
    contract_minor: u16
    abi_digest: EnvironmentDigest256V1
    semantic_identity: EnvironmentDigest256V1
    grammar_identity: EnvironmentDigest256V1
    program_identity: EnvironmentDigest256V1
    artifact_digest: EnvironmentDigest256V1
    artifact_location: EnvironmentArenaRangeV1
    target_architecture: u16
    required_os_id: u32
    required_abi_id: u32
    required_object_format_id: u32
    required_endian_id: u16
    required_pointer_width_bits: u16
    required_loader_permission_bits: u64
    required_cpu_features: EnvironmentFeatureSetV1
    required_os_state_words: EnvironmentArenaRangeV1
    required_vector_state_mode: u16
    required_vector_length_bits: u32
    required_device_api: u32
    minimum_device_api_version: u32
    required_device_features: EnvironmentArenaRangeV1
    required_memory_domain_bits: u64
    minimum_device_buffer_bytes: u64
    minimum_workgroup_invocations: u32
    minimum_queue_family_count: u32
    required_effect_bits: u64
    numerical_contract_id: u32
    resource_layout_digest: EnvironmentDigest256V1
    dependencies: EnvironmentArenaRangeV1
    assurance_receipt_digest: EnvironmentDigest256V1
    startup_budget_us: u64
    max_session_bytes: u64
    max_inflight_operations: u32

pub struct VariantFacetBindingV1:
    facet_id: u16
    interface_major: u16
    interface_minor: u16
    slot_index: u32
    provider_identity: EnvironmentDigest256V1
    variant_identity: EnvironmentDigest256V1
    provider_generation: u64
    interface_handle: u64
    provider_context: u64

pub struct VariantRejectionV1:
    provider_identity: EnvironmentDigest256V1
    variant_identity: EnvironmentDigest256V1
    reason_code: u32
    phase_code: u16

pub struct BindingPlanV1:
    descriptor_size: u32
    schema_version: u16
    plan_digest: EnvironmentDigest256V1
    environment_identity: EnvironmentDigest256V1
    environment_generation: u64
    catalog_digest: EnvironmentDigest256V1
    catalog_generation: u64
    policy_digest: EnvironmentDigest256V1
    dependency_lock_digest: EnvironmentDigest256V1
    publication_generation: u64
    facet_bindings: EnvironmentArenaRangeV1
    selected_variant_identities: EnvironmentArenaRangeV1
    rejections: EnvironmentArenaRangeV1

pub struct FrontendFacetV1:
    descriptor_size: u32
    schema_version: u16
    interface_major: u16
    interface_minor: u16
    create_session_operation: u16
    plan_regions_operation: u16
    execute_batch_operation: u16
    inspect_receipt_operation: u16
    release_session_operation: u16
    provider_generation: u64
    operation_table_handle: u64

pub struct FrontendSessionHandleV1:
    provider_generation: u64
    session_id: u64

pub struct FrontendBatchRequestV1:
    descriptor_size: u32
    schema_version: u16
    operation: u16
    session: FrontendSessionHandleV1
    dialect_id: u32
    grammar_digest: EnvironmentDigest256V1
    source_snapshot_digest: EnvironmentDigest256V1
    first_region: u32
    region_count: u32
    input_bytes: EnvironmentArenaRangeV1
    output_reservation: EnvironmentArenaRangeV1
    budget_us: u64

fn _digest_declared_v1(value: EnvironmentDigest256V1) -> bool:
    value.w0 != 0u64 or value.w1 != 0u64 or value.w2 != 0u64 or value.w3 != 0u64

fn _arch_valid_v1(value: u16) -> bool:
    value == ENV_ARCH_X86_64_V1 or value == ENV_ARCH_AARCH64_V1 or
        value == ENV_ARCH_RISCV64_V1 or value == ENV_ARCH_WASM32_V1

fn _range_valid_v1(value: EnvironmentArenaRangeV1, arena_items: u32, maximum: u32) -> bool:
    if value.count > maximum or value.offset > arena_items:
        return false
    value.count <= arena_items - value.offset

fn _feature_set_validate_v1(
    value: EnvironmentFeatureSetV1, architecture: u16, feature_word_count: u32
) -> Result<(), EnvironmentVariantContractErrorV1>:
    if value.architecture != architecture:
        return Err(EnvironmentVariantContractErrorV1.InvalidFeatureSet)
    if not _range_valid_v1(value.words, feature_word_count, ENV_VARIANT_MAX_FEATURE_WORDS_V1):
        return Err(EnvironmentVariantContractErrorV1.InvalidFeatureSet)
    Ok(())

fn _features_subset_v1(subset: EnvironmentFeatureSetV1, superset: EnvironmentFeatureSetV1, words: [u64]) -> bool:
    if subset.architecture != superset.architecture or subset.words.count != superset.words.count:
        return false
    var i: u32 = 0u32
    while i < subset.words.count:
        val child = words[(subset.words.offset + i) as i64]
        val parent = words[(superset.words.offset + i) as i64]
        if child & parent != child:
            return false
        i = i + 1u32
    true

pub fn environment_snapshot_validate_v1(
    snapshot: EnvironmentSnapshotV1, feature_words: [u64], gpu_devices: [EnvironmentGpuDeviceV1]
) -> Result<(), EnvironmentVariantContractErrorV1>:
    if snapshot.schema_version != ENV_VARIANT_SCHEMA_V1:
        return Err(EnvironmentVariantContractErrorV1.UnsupportedSchema)
    if snapshot.descriptor_size < 232u32:
        return Err(EnvironmentVariantContractErrorV1.DescriptorTooShort)
    if not _arch_valid_v1(snapshot.execution_architecture):
        return Err(EnvironmentVariantContractErrorV1.InvalidArchitecture)
    if snapshot.os_id == 0u32 or snapshot.abi_id == 0u32 or snapshot.object_format_id == 0u32 or
       (snapshot.endian_id != 1u16 and snapshot.endian_id != 2u16) or
       (snapshot.pointer_width_bits != 32u16 and snapshot.pointer_width_bits != 64u16):
        return Err(EnvironmentVariantContractErrorV1.InvalidAbi)
    if not _digest_declared_v1(snapshot.snapshot_identity) or
       not _digest_declared_v1(snapshot.execution_domain_identity) or snapshot.snapshot_generation == 0u64:
        return Err(EnvironmentVariantContractErrorV1.InvalidIdentity)
    if snapshot.numerical_contract_id == 0u32 or not _digest_declared_v1(snapshot.resource_layout_digest):
        return Err(EnvironmentVariantContractErrorV1.InvalidContract)
    if feature_words.len() > ENV_VARIANT_MAX_FEATURE_WORDS_V1 as i64 * 3:
        return Err(EnvironmentVariantContractErrorV1.CapacityExceeded)
    val feature_count = feature_words.len() as u32
    val hardware_check = _feature_set_validate_v1(snapshot.hardware_features, snapshot.execution_architecture, feature_count)
    if hardware_check != Ok(()): return hardware_check
    val usable_check = _feature_set_validate_v1(snapshot.os_usable_features, snapshot.execution_architecture, feature_count)
    if usable_check != Ok(()): return usable_check
    val policy_check = _feature_set_validate_v1(snapshot.policy_allowed_features, snapshot.execution_architecture, feature_count)
    if policy_check != Ok(()): return policy_check
    if not _features_subset_v1(snapshot.os_usable_features, snapshot.hardware_features, feature_words) or
       not _features_subset_v1(snapshot.policy_allowed_features, snapshot.os_usable_features, feature_words):
        return Err(EnvironmentVariantContractErrorV1.FeatureAuthorityViolation)
    if snapshot.vector_state_mode == ENV_VECTOR_NONE_V1:
        if snapshot.vector_length_bits != 0u32:
            return Err(EnvironmentVariantContractErrorV1.InvalidVectorState)
    elif snapshot.vector_state_mode == ENV_VECTOR_FIXED_V1 or snapshot.vector_state_mode == ENV_VECTOR_SCALABLE_V1:
        if snapshot.vector_length_bits == 0u32 or snapshot.vector_length_bits % 8u32 != 0u32:
            return Err(EnvironmentVariantContractErrorV1.InvalidVectorState)
    else:
        return Err(EnvironmentVariantContractErrorV1.InvalidVectorState)
    if gpu_devices.len() > ENV_VARIANT_MAX_GPU_DEVICES_V1 as i64 or
       not _range_valid_v1(snapshot.gpu_devices, gpu_devices.len() as u32, ENV_VARIANT_MAX_GPU_DEVICES_V1):
        return Err(EnvironmentVariantContractErrorV1.CapacityExceeded)
    var i: u32 = 0u32
    while i < snapshot.gpu_devices.count:
        val device = gpu_devices[(snapshot.gpu_devices.offset + i) as i64]
        if not _digest_declared_v1(device.device_identity) or device.api_id == 0u32 or
           device.api_version == 0u32 or device.max_buffer_bytes == 0u64 or
           device.max_workgroup_invocations == 0u32 or device.queue_family_count == 0u32 or
           not _range_valid_v1(device.enabled_feature_words, feature_count, ENV_VARIANT_MAX_FEATURE_WORDS_V1):
            return Err(EnvironmentVariantContractErrorV1.InvalidGpuDevice)
        i = i + 1u32
    Ok(())

pub fn variant_descriptor_validate_v1(
    descriptor: VariantDescriptorV1, arena_byte_count: u32, feature_word_count: u32,
    dependency_count: u32, dependencies: [VariantDependencyV1]
) -> Result<(), EnvironmentVariantContractErrorV1>:
    if descriptor.schema_version != ENV_VARIANT_SCHEMA_V1:
        return Err(EnvironmentVariantContractErrorV1.UnsupportedSchema)
    if descriptor.descriptor_size < 360u32:
        return Err(EnvironmentVariantContractErrorV1.DescriptorTooShort)
    if not _digest_declared_v1(descriptor.provider_identity) or
       not _digest_declared_v1(descriptor.variant_identity) or
       not _digest_declared_v1(descriptor.artifact_digest):
        return Err(EnvironmentVariantContractErrorV1.InvalidIdentity)
    if not _digest_declared_v1(descriptor.contract_identity) or
       not _digest_declared_v1(descriptor.abi_digest) or descriptor.contract_major == 0u16:
        return Err(EnvironmentVariantContractErrorV1.InvalidContract)
    if descriptor.placement < ENV_PLACEMENT_STATIC_V1 or descriptor.placement > ENV_PLACEMENT_CONTAINED_WORKER_V1:
        return Err(EnvironmentVariantContractErrorV1.InvalidPlacement)
    if arena_byte_count > ENV_VARIANT_MAX_ARENA_BYTES_V1 or
       not _range_valid_v1(descriptor.artifact_location, arena_byte_count, ENV_VARIANT_MAX_ARENA_BYTES_V1) or
       descriptor.artifact_location.count == 0u32:
        return Err(EnvironmentVariantContractErrorV1.InvalidArtifact)
    if not _arch_valid_v1(descriptor.target_architecture) or
       descriptor.required_cpu_features.architecture != descriptor.target_architecture or
       not _range_valid_v1(descriptor.required_cpu_features.words, feature_word_count, ENV_VARIANT_MAX_FEATURE_WORDS_V1) or
       not _range_valid_v1(descriptor.required_os_state_words, feature_word_count, ENV_VARIANT_MAX_FEATURE_WORDS_V1) or
       not _range_valid_v1(descriptor.required_device_features, feature_word_count, ENV_VARIANT_MAX_FEATURE_WORDS_V1):
        return Err(EnvironmentVariantContractErrorV1.InvalidFeatureSet)
    if descriptor.required_os_id == 0u32 or descriptor.required_abi_id == 0u32 or
       descriptor.required_object_format_id == 0u32 or
       (descriptor.required_endian_id != 1u16 and descriptor.required_endian_id != 2u16) or
       (descriptor.required_pointer_width_bits != 32u16 and descriptor.required_pointer_width_bits != 64u16):
        return Err(EnvironmentVariantContractErrorV1.InvalidAbi)
    if descriptor.required_vector_state_mode == ENV_VECTOR_NONE_V1:
        if descriptor.required_vector_length_bits != 0u32:
            return Err(EnvironmentVariantContractErrorV1.InvalidVectorState)
    elif descriptor.required_vector_state_mode == ENV_VECTOR_FIXED_V1 or
         descriptor.required_vector_state_mode == ENV_VECTOR_SCALABLE_V1:
        if descriptor.required_vector_length_bits == 0u32 or
           descriptor.required_vector_length_bits % 8u32 != 0u32:
            return Err(EnvironmentVariantContractErrorV1.InvalidVectorState)
    else:
        return Err(EnvironmentVariantContractErrorV1.InvalidVectorState)
    if descriptor.required_device_api == 0u32:
        if descriptor.minimum_device_api_version != 0u32 or descriptor.required_device_features.count != 0u32 or
           descriptor.required_memory_domain_bits != 0u64 or descriptor.minimum_device_buffer_bytes != 0u64 or
           descriptor.minimum_workgroup_invocations != 0u32 or descriptor.minimum_queue_family_count != 0u32:
            return Err(EnvironmentVariantContractErrorV1.InvalidGpuDevice)
    elif descriptor.minimum_device_api_version == 0u32 or descriptor.minimum_device_buffer_bytes == 0u64 or
         descriptor.minimum_workgroup_invocations == 0u32 or descriptor.minimum_queue_family_count == 0u32:
        return Err(EnvironmentVariantContractErrorV1.InvalidGpuDevice)
    if descriptor.numerical_contract_id == 0u32 or not _digest_declared_v1(descriptor.resource_layout_digest):
        return Err(EnvironmentVariantContractErrorV1.InvalidContract)
    if dependency_count != dependencies.len() as u32 or dependency_count > ENV_VARIANT_MAX_DEPENDENCIES_V1 or
       not _range_valid_v1(descriptor.dependencies, dependency_count, ENV_VARIANT_MAX_DEPENDENCIES_V1):
        return Err(EnvironmentVariantContractErrorV1.InvalidDependency)
    var i: u32 = 0u32
    while i < descriptor.dependencies.count:
        val dependency = dependencies[(descriptor.dependencies.offset + i) as i64]
        if not _digest_declared_v1(dependency.provider_identity) or
           not _digest_declared_v1(dependency.contract_identity) or
           not _digest_declared_v1(dependency.artifact_digest) or dependency.minimum_contract_major == 0u16:
            return Err(EnvironmentVariantContractErrorV1.InvalidDependency)
        i = i + 1u32
    if descriptor.startup_budget_us == 0u64 or descriptor.max_session_bytes == 0u64 or
       descriptor.max_inflight_operations == 0u32:
        return Err(EnvironmentVariantContractErrorV1.InvalidResourceBounds)
    Ok(())

pub fn binding_plan_validate_v1(
    plan: BindingPlanV1, bindings: [VariantFacetBindingV1], selected_count: u32,
    rejections: [VariantRejectionV1]
) -> Result<(), EnvironmentVariantContractErrorV1>:
    if plan.schema_version != ENV_VARIANT_SCHEMA_V1:
        return Err(EnvironmentVariantContractErrorV1.UnsupportedSchema)
    if plan.descriptor_size < 224u32:
        return Err(EnvironmentVariantContractErrorV1.DescriptorTooShort)
    if not _digest_declared_v1(plan.plan_digest) or not _digest_declared_v1(plan.environment_identity) or
       not _digest_declared_v1(plan.catalog_digest) or not _digest_declared_v1(plan.policy_digest) or
       not _digest_declared_v1(plan.dependency_lock_digest):
        return Err(EnvironmentVariantContractErrorV1.InvalidIdentity)
    if plan.environment_generation == 0u64 or plan.catalog_generation == 0u64 or plan.publication_generation == 0u64:
        return Err(EnvironmentVariantContractErrorV1.InvalidGeneration)
    if bindings.len() > ENV_VARIANT_MAX_FACET_BINDINGS_V1 as i64 or
       not _range_valid_v1(plan.facet_bindings, bindings.len() as u32, ENV_VARIANT_MAX_FACET_BINDINGS_V1) or
       not _range_valid_v1(plan.selected_variant_identities, selected_count, ENV_VARIANT_MAX_FACET_BINDINGS_V1) or
       rejections.len() > ENV_VARIANT_MAX_REJECTIONS_V1 as i64 or
       not _range_valid_v1(plan.rejections, rejections.len() as u32, ENV_VARIANT_MAX_REJECTIONS_V1):
        return Err(EnvironmentVariantContractErrorV1.CapacityExceeded)
    var i: u32 = 0u32
    while i < plan.facet_bindings.count:
        val binding = bindings[(plan.facet_bindings.offset + i) as i64]
        if binding.facet_id == 0u16 or binding.interface_major == 0u16 or
           binding.slot_index != i or not _digest_declared_v1(binding.provider_identity) or
           not _digest_declared_v1(binding.variant_identity) or binding.provider_generation == 0u64 or
           binding.interface_handle == 0u64:
            return Err(EnvironmentVariantContractErrorV1.InvalidFacet)
        i = i + 1u32
    i = 0u32
    while i < plan.rejections.count:
        val rejection = rejections[(plan.rejections.offset + i) as i64]
        if not _digest_declared_v1(rejection.provider_identity) or
           not _digest_declared_v1(rejection.variant_identity) or rejection.reason_code == 0u32 or rejection.phase_code == 0u16:
            return Err(EnvironmentVariantContractErrorV1.InvalidRejection)
        i = i + 1u32
    Ok(())

pub fn frontend_facet_validate_v1(facet: FrontendFacetV1) -> Result<(), EnvironmentVariantContractErrorV1>:
    if facet.schema_version != ENV_VARIANT_SCHEMA_V1:
        return Err(EnvironmentVariantContractErrorV1.UnsupportedSchema)
    if facet.descriptor_size < 48u32:
        return Err(EnvironmentVariantContractErrorV1.DescriptorTooShort)
    if facet.interface_major == 0u16 or facet.provider_generation == 0u64 or facet.operation_table_handle == 0u64:
        return Err(EnvironmentVariantContractErrorV1.InvalidFacet)
    if facet.create_session_operation != ENV_FRONTEND_CREATE_SESSION_V1 or
       facet.plan_regions_operation != ENV_FRONTEND_PLAN_REGIONS_V1 or
       facet.execute_batch_operation != ENV_FRONTEND_EXECUTE_BATCH_V1 or
       facet.inspect_receipt_operation != ENV_FRONTEND_INSPECT_RECEIPT_V1 or
       facet.release_session_operation != ENV_FRONTEND_RELEASE_SESSION_V1:
        return Err(EnvironmentVariantContractErrorV1.InvalidFrontendOperation)
    Ok(())

pub fn frontend_batch_request_validate_v1(
    request: FrontendBatchRequestV1, input_arena_bytes: u32, output_arena_bytes: u32,
    expected_generation: u64
) -> Result<(), EnvironmentVariantContractErrorV1>:
    if request.schema_version != ENV_VARIANT_SCHEMA_V1:
        return Err(EnvironmentVariantContractErrorV1.UnsupportedSchema)
    if request.descriptor_size < 128u32:
        return Err(EnvironmentVariantContractErrorV1.DescriptorTooShort)
    if request.session.provider_generation == 0u64 or request.session.session_id == 0u64 or
       request.session.provider_generation != expected_generation:
        return Err(EnvironmentVariantContractErrorV1.InvalidGeneration)
    if request.operation < ENV_FRONTEND_CREATE_SESSION_V1 or request.operation > ENV_FRONTEND_RELEASE_SESSION_V1:
        return Err(EnvironmentVariantContractErrorV1.InvalidFrontendOperation)
    if request.dialect_id == 0u32 or not _digest_declared_v1(request.grammar_digest) or
       not _digest_declared_v1(request.source_snapshot_digest):
        return Err(EnvironmentVariantContractErrorV1.InvalidIdentity)
    if request.region_count == 0u32 or request.region_count > ENV_VARIANT_MAX_BATCH_REGIONS_V1 or
       request.first_region > 4294967295u32 - request.region_count:
        return Err(EnvironmentVariantContractErrorV1.InvalidResourceBounds)
    if not _range_valid_v1(request.input_bytes, input_arena_bytes, ENV_VARIANT_MAX_ARENA_BYTES_V1) or
       not _range_valid_v1(request.output_reservation, output_arena_bytes, ENV_VARIANT_MAX_ARENA_BYTES_V1) or
       request.budget_us == 0u64:
        return Err(EnvironmentVariantContractErrorV1.InvalidArena)
    Ok(())
