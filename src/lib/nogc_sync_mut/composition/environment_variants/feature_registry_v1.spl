# Environment feature registry V1.
#
# This is a declarative registry for admission metadata.  It expands stable
# preset IDs into the bounded word arena used by EnvironmentFeatureSetV1.  It
# does not probe the host, read /proc, or claim that any feature executes.
#
# IDs are opaque names, not a cross-architecture rank.  Compatibility is
# checked only after architecture equality and by subset predicates within
# that architecture.

use std.nogc_sync_mut.composition.environment_variants.contracts_v1.{
    EnvironmentArenaRangeV1, EnvironmentFeatureSetV1,
    ENV_ARCH_UNKNOWN_V1, ENV_ARCH_X86_64_V1, ENV_ARCH_AARCH64_V1,
    ENV_ARCH_RISCV64_V1
}

pub const ENV_FEATURE_REGISTRY_SCHEMA_V1: u16 = 1u16
pub const ENV_FEATURE_REGISTRY_SCHEMA_V2: u16 = 2u16
pub const ENV_FEATURE_REGISTRY_WORD_COUNT_V1: u32 = 1u32

# The numeric values are stable serialized identifiers.  They are deliberately
# grouped by architecture for inspection, but no ordering relation is defined.
pub const ENV_FEATURE_X86_64_BASELINE_V1: u32 = 0x1101u32
pub const ENV_FEATURE_X86_64_V2_V1: u32 = 0x1102u32
pub const ENV_FEATURE_X86_64_V3_V1: u32 = 0x1103u32
pub const ENV_FEATURE_X86_64_V4_V1: u32 = 0x1104u32
pub const ENV_FEATURE_X86_64_AVX512_VBMI_V1: u32 = 0x1110u32
pub const ENV_FEATURE_X86_64_AVX512_VBMI2_V1: u32 = 0x1111u32
pub const ENV_FEATURE_X86_64_V4_VBMI_VBMI2_V1: u32 = 0x1112u32

# Exact psABI feature words use distinct V2 IDs and carry an in-word schema
# tag.  The V1 IDs and masks above remain byte-for-byte stable for existing
# catalogs; an untagged V1 word can never be admitted as an exact V2 level.
pub const ENV_FEATURE_X86_64_BASELINE_V2: u32 = 0x1201u32
pub const ENV_FEATURE_X86_64_LEVEL2_V2: u32 = 0x1202u32
pub const ENV_FEATURE_X86_64_LEVEL3_V2: u32 = 0x1203u32
pub const ENV_FEATURE_X86_64_LEVEL4_V2: u32 = 0x1204u32
pub const ENV_FEATURE_X86_64_LEVEL4_VBMI_V2: u32 = 0x1210u32
pub const ENV_FEATURE_X86_64_LEVEL4_VBMI2_V2: u32 = 0x1211u32
pub const ENV_FEATURE_X86_64_LEVEL4_VBMI_VBMI2_V2: u32 = 0x1212u32

pub const ENV_FEATURE_AARCH64_NEON_V1: u32 = 0x2201u32
pub const ENV_FEATURE_AARCH64_SVE_V1: u32 = 0x2202u32
pub const ENV_FEATURE_AARCH64_SVE2_V1: u32 = 0x2203u32

pub const ENV_FEATURE_RISCV64_RVV_V1: u32 = 0x3301u32

# Explicit aliases make the x86-64 level spelling used by target descriptions
# available without introducing a second identity.
pub const ENV_FEATURE_X86_64_V2: u32 = ENV_FEATURE_X86_64_V2_V1
pub const ENV_FEATURE_X86_64_V3: u32 = ENV_FEATURE_X86_64_V3_V1
pub const ENV_FEATURE_X86_64_V4: u32 = ENV_FEATURE_X86_64_V4_V1

# Exact V2 x86 words use one named bit for every independently testable level
# requirement.  Payload bits 32..55 are disjoint from every legacy V1 payload;
# bit 57 is the V2 word tag, and bits 56 and 58..63 are reserved.  Disjointness
# makes the generic raw subset predicate reject mixed V1/V2 catalogs too.
# The baseline bit is justified by the x86-64 architecture authority.  V2,
# v3, and v4 additions follow the psABI level definitions.  OSXSAVE is the
# CPUID fact named by v3; XCR0 usability remains separate, and the host snapshot
# removes AVX-family bits from os_usable_features when state is unavailable.
pub const ENV_X86_FEATURE_WORD_TAG_V2: u64 = 0x0200000000000000u64
pub const ENV_X86_FEATURE_BASELINE_V2: u64 = 0x0000000100000000u64
pub const ENV_X86_FEATURE_CMPXCHG16B_V2: u64 = 0x0000000200000000u64
pub const ENV_X86_FEATURE_LAHF_SAHF_V2: u64 = 0x0000000400000000u64
pub const ENV_X86_FEATURE_POPCNT_V2: u64 = 0x0000000800000000u64
pub const ENV_X86_FEATURE_SSE3_V2: u64 = 0x0000001000000000u64
pub const ENV_X86_FEATURE_SSSE3_V2: u64 = 0x0000002000000000u64
pub const ENV_X86_FEATURE_SSE41_V2: u64 = 0x0000004000000000u64
pub const ENV_X86_FEATURE_SSE42_V2: u64 = 0x0000008000000000u64
pub const ENV_X86_FEATURE_AVX_V2: u64 = 0x0000010000000000u64
pub const ENV_X86_FEATURE_AVX2_V2: u64 = 0x0000020000000000u64
pub const ENV_X86_FEATURE_BMI1_V2: u64 = 0x0000040000000000u64
pub const ENV_X86_FEATURE_BMI2_V2: u64 = 0x0000080000000000u64
pub const ENV_X86_FEATURE_F16C_V2: u64 = 0x0000100000000000u64
pub const ENV_X86_FEATURE_FMA_V2: u64 = 0x0000200000000000u64
pub const ENV_X86_FEATURE_LZCNT_V2: u64 = 0x0000400000000000u64
pub const ENV_X86_FEATURE_MOVBE_V2: u64 = 0x0000800000000000u64
pub const ENV_X86_FEATURE_OSXSAVE_V2: u64 = 0x0001000000000000u64
pub const ENV_X86_FEATURE_AVX512F_V2: u64 = 0x0002000000000000u64
pub const ENV_X86_FEATURE_AVX512BW_V2: u64 = 0x0004000000000000u64
pub const ENV_X86_FEATURE_AVX512CD_V2: u64 = 0x0008000000000000u64
pub const ENV_X86_FEATURE_AVX512DQ_V2: u64 = 0x0010000000000000u64
pub const ENV_X86_FEATURE_AVX512VL_V2: u64 = 0x0020000000000000u64
pub const ENV_X86_FEATURE_AVX512VBMI_V2: u64 = 0x0040000000000000u64
pub const ENV_X86_FEATURE_AVX512VBMI2_V2: u64 = 0x0080000000000000u64

# These are the frozen legacy V1 encodings.  Do not add feature meaning to
# their occupied bits.
const _X86_BASELINE_MASK_V1: u64 = 1u64
const _X86_V2_MASK_V1: u64 = 127u64
const _X86_V3_MASK_V1: u64 = 3967u64
const _X86_V4_MASK_V1: u64 = 65535u64
const _X86_VBMI_MASK_V1: u64 = 131071u64
const _X86_VBMI2_MASK_V1: u64 = 196607u64
const _X86_VBMI_VBMI2_MASK_V1: u64 = 262143u64
const _X86_BASELINE_MASK_V2: u64 = 0x0200000100000000u64
const _X86_LEVEL2_MASK_V2: u64 = 0x020000ff00000000u64
const _X86_LEVEL3_MASK_V2: u64 = 0x0201ffff00000000u64
const _X86_LEVEL4_MASK_V2: u64 = 0x023fffff00000000u64
const _X86_LEVEL4_VBMI_MASK_V2: u64 = 0x027fffff00000000u64
const _X86_LEVEL4_VBMI2_MASK_V2: u64 = 0x02bfffff00000000u64
const _X86_LEVEL4_VBMI_VBMI2_MASK_V2: u64 = 0x02ffffff00000000u64
const _AARCH64_NEON_MASK_V1: u64 = 1u64
const _AARCH64_SVE_MASK_V1: u64 = 3u64
const _AARCH64_SVE2_MASK_V1: u64 = 7u64
const _RISCV64_RVV_MASK_V1: u64 = 1u64

pub enum EnvironmentFeatureRegistryErrorV1:
    UnknownFeatureId
    UnsupportedArchitecture
    ArchitectureMismatch
    InvalidArenaRange
    InvalidWordCount
    UnknownFeatureBits

pub struct EnvironmentFeatureRegistryEntryV1:
    feature_id: u32
    architecture: u16
    word_count: u32
    feature_mask: u64

pub struct EnvironmentFeatureRegistryExpansionV1:
    entry: EnvironmentFeatureRegistryEntryV1
    feature_set: EnvironmentFeatureSetV1
    words: [u64]

fn _entry_v1(
    feature_id: u32, architecture: u16, feature_mask: u64
) -> EnvironmentFeatureRegistryEntryV1:
    EnvironmentFeatureRegistryEntryV1(
        feature_id: feature_id,
        architecture: architecture,
        word_count: ENV_FEATURE_REGISTRY_WORD_COUNT_V1,
        feature_mask: feature_mask)

fn _lookup_v1(feature_id: u32) -> Result<EnvironmentFeatureRegistryEntryV1, EnvironmentFeatureRegistryErrorV1>:
    if feature_id == ENV_FEATURE_X86_64_BASELINE_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_BASELINE_MASK_V1))
    if feature_id == ENV_FEATURE_X86_64_V2_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_V2_MASK_V1))
    if feature_id == ENV_FEATURE_X86_64_V3_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_V3_MASK_V1))
    if feature_id == ENV_FEATURE_X86_64_V4_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_V4_MASK_V1))
    if feature_id == ENV_FEATURE_X86_64_AVX512_VBMI_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_VBMI_MASK_V1))
    if feature_id == ENV_FEATURE_X86_64_AVX512_VBMI2_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_VBMI2_MASK_V1))
    if feature_id == ENV_FEATURE_X86_64_V4_VBMI_VBMI2_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_VBMI_VBMI2_MASK_V1))
    if feature_id == ENV_FEATURE_AARCH64_NEON_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_AARCH64_V1, _AARCH64_NEON_MASK_V1))
    if feature_id == ENV_FEATURE_AARCH64_SVE_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_AARCH64_V1, _AARCH64_SVE_MASK_V1))
    if feature_id == ENV_FEATURE_AARCH64_SVE2_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_AARCH64_V1, _AARCH64_SVE2_MASK_V1))
    if feature_id == ENV_FEATURE_RISCV64_RVV_V1:
        return Ok(_entry_v1(feature_id, ENV_ARCH_RISCV64_V1, _RISCV64_RVV_MASK_V1))
    Err(EnvironmentFeatureRegistryErrorV1.UnknownFeatureId)

fn _lookup_v2(feature_id: u32) -> Result<EnvironmentFeatureRegistryEntryV1, EnvironmentFeatureRegistryErrorV1>:
    if feature_id == ENV_FEATURE_X86_64_BASELINE_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_BASELINE_MASK_V2))
    if feature_id == ENV_FEATURE_X86_64_LEVEL2_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_LEVEL2_MASK_V2))
    if feature_id == ENV_FEATURE_X86_64_LEVEL3_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_LEVEL3_MASK_V2))
    if feature_id == ENV_FEATURE_X86_64_LEVEL4_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_LEVEL4_MASK_V2))
    if feature_id == ENV_FEATURE_X86_64_LEVEL4_VBMI_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_LEVEL4_VBMI_MASK_V2))
    if feature_id == ENV_FEATURE_X86_64_LEVEL4_VBMI2_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_LEVEL4_VBMI2_MASK_V2))
    if feature_id == ENV_FEATURE_X86_64_LEVEL4_VBMI_VBMI2_V2:
        return Ok(_entry_v1(feature_id, ENV_ARCH_X86_64_V1, _X86_LEVEL4_VBMI_VBMI2_MASK_V2))
    Err(EnvironmentFeatureRegistryErrorV1.UnknownFeatureId)

fn _architecture_supported_v1(architecture: u16) -> bool:
    architecture == ENV_ARCH_X86_64_V1 or
        architecture == ENV_ARCH_AARCH64_V1 or
        architecture == ENV_ARCH_RISCV64_V1

fn _registry_range_valid_v1(value: EnvironmentArenaRangeV1, words: [u64]) -> bool:
    if value.count != ENV_FEATURE_REGISTRY_WORD_COUNT_V1:
        return false
    if value.offset > words.len() as u32:
        return false
    value.count <= words.len() as u32 - value.offset

pub fn environment_feature_registry_lookup_v1(
    feature_id: u32
) -> Result<EnvironmentFeatureRegistryEntryV1, EnvironmentFeatureRegistryErrorV1>:
    _lookup_v1(feature_id)

pub fn environment_feature_registry_lookup_v2(
    feature_id: u32
) -> Result<EnvironmentFeatureRegistryEntryV1, EnvironmentFeatureRegistryErrorV1>:
    _lookup_v2(feature_id)

pub fn environment_feature_registry_architecture_v1(feature_id: u32) -> u16:
    match _lookup_v1(feature_id):
        case Ok(entry): entry.architecture
        case Err(_): ENV_ARCH_UNKNOWN_V1

pub fn environment_feature_registry_expand_v1(
    feature_id: u32, arena_offset: u32
) -> Result<EnvironmentFeatureRegistryExpansionV1, EnvironmentFeatureRegistryErrorV1>:
    val entry_result = _lookup_v1(feature_id)
    val entry = match entry_result:
        case Ok(value): value
        case Err(reason): return Err(reason)
    val feature_set = EnvironmentFeatureSetV1(
        architecture: entry.architecture,
        words: EnvironmentArenaRangeV1(
            offset: arena_offset, count: ENV_FEATURE_REGISTRY_WORD_COUNT_V1))
    Ok(EnvironmentFeatureRegistryExpansionV1(
        entry: entry, feature_set: feature_set, words: [entry.feature_mask]))

pub fn environment_feature_registry_feature_set_v1(
    feature_id: u32, arena_offset: u32
) -> Result<EnvironmentFeatureSetV1, EnvironmentFeatureRegistryErrorV1>:
    val expansion = match environment_feature_registry_expand_v1(feature_id, arena_offset):
        case Ok(value): value
        case Err(reason): return Err(reason)
    Ok(expansion.feature_set)

pub fn environment_feature_registry_validate_v1(
    value: EnvironmentFeatureSetV1, words: [u64]
) -> Result<(), EnvironmentFeatureRegistryErrorV1>:
    if not _architecture_supported_v1(value.architecture):
        return Err(EnvironmentFeatureRegistryErrorV1.UnsupportedArchitecture)
    if not _registry_range_valid_v1(value.words, words):
        return Err(EnvironmentFeatureRegistryErrorV1.InvalidArenaRange)
    val actual = words[value.words.offset as i64]
    val allowed = if value.architecture == ENV_ARCH_X86_64_V1:
        _X86_VBMI_VBMI2_MASK_V1
    elif value.architecture == ENV_ARCH_AARCH64_V1:
        _AARCH64_SVE2_MASK_V1
    else:
        _RISCV64_RVV_MASK_V1
    if actual & allowed != actual:
        return Err(EnvironmentFeatureRegistryErrorV1.UnknownFeatureBits)
    Ok(())

pub fn environment_feature_registry_subset_v1(
    required: EnvironmentFeatureSetV1, available: EnvironmentFeatureSetV1,
    words: [u64]
) -> bool:
    if required.architecture != available.architecture:
        return false
    if environment_feature_registry_validate_v1(required, words) != Ok(()) or
       environment_feature_registry_validate_v1(available, words) != Ok(()):
        return false
    val required_bits = words[required.words.offset as i64]
    val available_bits = words[available.words.offset as i64]
    required_bits & available_bits == required_bits

pub fn environment_feature_registry_id_subset_v1(
    required_id: u32, available_id: u32
) -> bool:
    val required = match _lookup_v1(required_id):
        case Ok(value): value
        case Err(_): return false
    val available = match _lookup_v1(available_id):
        case Ok(value): value
        case Err(_): return false
    required.architecture == available.architecture and
        required.feature_mask & available.feature_mask == required.feature_mask

pub fn environment_feature_registry_x86_validate_v2(actual_mask: u64) -> bool:
    val tag_mask = 0xff00000000000000u64
    val allowed = _X86_LEVEL4_VBMI_VBMI2_MASK_V2
    (actual_mask & tag_mask) == ENV_X86_FEATURE_WORD_TAG_V2 and
        (actual_mask & ENV_X86_FEATURE_BASELINE_V2) == ENV_X86_FEATURE_BASELINE_V2 and
        (actual_mask & allowed) == actual_mask

pub fn environment_feature_registry_x86_level_complete_v2(
    feature_id: u32, actual_mask: u64
) -> bool:
    val required = match _lookup_v2(feature_id):
        case Ok(value): value
        case Err(_): return false
    environment_feature_registry_x86_validate_v2(actual_mask) and
        (actual_mask & required.feature_mask) == required.feature_mask

pub fn environment_feature_registry_x86_id_subset_v2(
    required_id: u32, available_id: u32
) -> bool:
    val required = match _lookup_v2(required_id):
        case Ok(value): value
        case Err(_): return false
    val available = match _lookup_v2(available_id):
        case Ok(value): value
        case Err(_): return false
    (required.feature_mask & available.feature_mask) == required.feature_mask
