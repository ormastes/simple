"""One owner for native variant mappings and their in-flight calls.

Callables carry a copied identity, never the native handle or function pointer.
Retirement revokes new uses under the same lock that admits invocations. An
already admitted invocation attempts close when its last use finishes; failed
close retains a revoked entry for a later cleanup retry.
"""

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_with_lock}
use std.nogc_sync_mut.sffi.dynlib_exact_admission_v1.{dynlib_admitted_close_v1}
use std.nogc_sync_mut.sffi.dynamic.{spl_wffi_call_i64}

const _NATIVE_CALLABLE_OWNER_CAPACITY_V1: i64 = 4096
const _NATIVE_CALLABLE_OWNER_MAX_ID_V1: u64 = 18446744073709551615u64

pub struct NativeCallableCloseStateV1:
    active_uses: i64
    retiring: bool
    close_in_progress: bool

pub struct NativeCallableCloseDecisionV1:
    state: NativeCallableCloseStateV1
    accepted: bool
    claim_close: bool
    remove: bool

pub fn native_callable_close_on_retire_v1(
    state: NativeCallableCloseStateV1
) -> NativeCallableCloseDecisionV1:
    """Revoke new uses and claim close only when no admitted use remains."""
    var next = state
    var accepted = false
    var claim = false
    if not next.retiring:
        next.retiring = true
        accepted = true
    if next.retiring and next.active_uses == 0 and not next.close_in_progress:
        next.close_in_progress = true
        claim = true
        accepted = true
    NativeCallableCloseDecisionV1(
        state: next, accepted: accepted, claim_close: claim, remove: false)

pub fn native_callable_close_on_end_use_v1(
    state: NativeCallableCloseStateV1
) -> NativeCallableCloseDecisionV1:
    """Finish one admitted use and claim close once the last use drains."""
    var next = state
    var claim = false
    if next.active_uses > 0:
        next.active_uses = next.active_uses - 1
        if next.retiring and next.active_uses == 0 and not next.close_in_progress:
            next.close_in_progress = true
            claim = true
    NativeCallableCloseDecisionV1(
        state: next, accepted: false, claim_close: claim, remove: false)

pub fn native_callable_close_on_result_v1(
    state: NativeCallableCloseStateV1, closed: bool
) -> NativeCallableCloseDecisionV1:
    """Remove only after successful close; otherwise retain a retryable tombstone."""
    var next = state
    var remove = false
    if next.retiring and next.close_in_progress and next.active_uses == 0:
        if closed:
            remove = true
        else:
            next.close_in_progress = false
    NativeCallableCloseDecisionV1(
        state: next, accepted: false, claim_close: false, remove: remove)

struct _NativeCallableEntryV1:
    identity: u64
    native_handle: i64
    native_fptr: i64
    close_state: NativeCallableCloseStateV1

struct _NativeCallableStateV1:
    next_identity: u64
    entries: [_NativeCallableEntryV1]
    last_identity: u64
    last_fptr: i64
    last_close_handle: i64
    last_accepted: bool

fn _native_callable_initial_state_v1() -> _NativeCallableStateV1:
    _NativeCallableStateV1(next_identity: 1u64, entries: [],
        last_identity: 0u64, last_fptr: 0, last_close_handle: 0,
        last_accepted: false)

var _native_callable_owner_v1: Mutex = mutex_new(_native_callable_initial_state_v1())

fn _native_callable_index_v1(state: _NativeCallableStateV1, identity: u64) -> i64:
    # Registration appends strictly increasing identities and remove shifts
    # the tail without changing its order. Lookups run under the owner lock,
    # so the bounded table stays sorted throughout this search.
    var first = 0
    var past_last = state.entries.len()
    while first < past_last:
        val middle = first + (past_last - first) / 2
        val candidate = state.entries[middle].identity
        if candidate == identity:
            return middle
        if candidate < identity:
            first = middle + 1
        else:
            past_last = middle
    -1

# Zero means the owner refused registration. The caller must close the handle
# in that case; this owner has not retained it.
pub(package) fn native_callable_owner_register_v1(handle: i64, fptr: i64) -> u64:
    if handle <= 0 or fptr <= 0:
        return 0u64
    val updated = mutex_with_lock(_native_callable_owner_v1, \state:
        var next = state
        next.last_identity = 0u64
        if state.next_identity != 0u64 and
           state.entries.len() < _NATIVE_CALLABLE_OWNER_CAPACITY_V1:
            val identity = state.next_identity
            next.next_identity = if identity == _NATIVE_CALLABLE_OWNER_MAX_ID_V1:
                0u64
            else:
                identity + 1u64
            next.entries.push(_NativeCallableEntryV1(
                identity: identity, native_handle: handle, native_fptr: fptr,
                close_state: NativeCallableCloseStateV1(
                    active_uses: 0, retiring: false, close_in_progress: false)))
            next.last_identity = identity
        next)
    updated.last_identity

# The admission and retirement decisions are serialized by the same owner.
fn _native_callable_acquire_v1(identity: u64) -> i64:
    val updated = mutex_with_lock(_native_callable_owner_v1, \state:
        var next = state
        next.last_fptr = 0
        val index = _native_callable_index_v1(state, identity)
        if index >= 0:
            var entry = state.entries[index]
            if not entry.close_state.retiring and
               entry.close_state.active_uses < 9223372036854775807:
                entry.close_state.active_uses = entry.close_state.active_uses + 1
                next.entries[index] = entry
                next.last_fptr = entry.native_fptr
        next)
    updated.last_fptr

fn _native_callable_complete_close_v1(identity: u64, closed: bool):
    val _ = mutex_with_lock(_native_callable_owner_v1, \state:
        var next = state
        val index = _native_callable_index_v1(state, identity)
        if index >= 0:
            var entry = state.entries[index]
            val decision = native_callable_close_on_result_v1(entry.close_state, closed)
            if decision.remove:
                next.entries.remove(index)
            else:
                entry.close_state = decision.state
                next.entries[index] = entry
        next)

fn _native_callable_end_v1(identity: u64):
    val updated = mutex_with_lock(_native_callable_owner_v1, \state:
        var next = state
        next.last_close_handle = 0
        val index = _native_callable_index_v1(state, identity)
        if index >= 0:
            var entry = state.entries[index]
            val decision = native_callable_close_on_end_use_v1(entry.close_state)
            entry.close_state = decision.state
            if decision.claim_close:
                next.last_close_handle = entry.native_handle
            next.entries[index] = entry
        next)
    if updated.last_close_handle > 0:
        val closed = unsafe(capabilities: [ffi]):
            dynlib_admitted_close_v1(updated.last_close_handle)
        _native_callable_complete_close_v1(identity, closed)

# The native call occurs outside the owner lock so provider code may re-enter
# unrelated services. The retained use keeps its mapping live until return.
pub(package) fn native_callable_owner_invoke_v1(
    identity: u64, args: [i64]
) -> Result<i64, text>:
    val fptr = _native_callable_acquire_v1(identity)
    if fptr <= 0:
        return Err("native mapping is retired or unavailable")
    val result = unsafe(capabilities: [ffi, raw_ptr]):
        spl_wffi_call_i64(fptr, args, args.len())
    _native_callable_end_v1(identity)
    Ok(result)

# A failed close retains a revoked entry so a later release can retry. A
# close-in-progress entry cannot claim a second concurrent unload.
pub(package) fn native_callable_owner_retire_v1(identity: u64) -> bool:
    val updated = mutex_with_lock(_native_callable_owner_v1, \state:
        var next = state
        next.last_accepted = false
        next.last_close_handle = 0
        val index = _native_callable_index_v1(state, identity)
        if index >= 0:
            var entry = state.entries[index]
            val decision = native_callable_close_on_retire_v1(entry.close_state)
            entry.close_state = decision.state
            next.last_accepted = decision.accepted
            if decision.claim_close:
                next.last_close_handle = entry.native_handle
            next.entries[index] = entry
        next)
    if updated.last_close_handle > 0:
        val closed = unsafe(capabilities: [ffi]):
            dynlib_admitted_close_v1(updated.last_close_handle)
        _native_callable_complete_close_v1(identity, closed)
        return closed
    updated.last_accepted
