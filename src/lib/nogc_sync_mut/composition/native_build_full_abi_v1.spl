"""Frozen native-build registry image and arithmetic full-ABI digest codec."""

use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_sync_mut.composition.provider_contract.{SimpleAbiDigest256V1}
use std.nogc_sync_mut.composition.abi_digest.{simple_abi_digest_zero_v1,
    simple_abi_digest_parse_hex_v1}

pub val SIMPLE_NATIVE_BUILD_SCHEMA_DIGEST_V1: text =
    "46f971af9f7ee93c228411964cc53e2af58bd7cf032befc73e418bbc7403f4c2"
pub val SIMPLE_NATIVE_BUILD_FIXTURE_DIAGNOSTICS_DIGEST_V1: text =
    "ed28ffd2f59dc8496e42aedc7cafdb117a14ec0c9ff2cffa7fd79abef0a7fbcc"

pub struct NativeBuildFullAbiDigestV1:
    ok: bool
    schema_digest: text
    host_digest: text
    full_digest: text
    words: SimpleAbiDigest256V1
    preimage_bytes: i64
    execution_authority: bool
    error: text

fn _abi_push_u32_v1(buffer: [u8], value: u32) -> [u8]:
    var out = buffer
    var shift: u32 = 0u32
    while shift < 32u32:
        out.push(((value >> shift) & 255u32) as u8)
        shift = shift + 8u32
    out

fn _abi_push_u64_v1(buffer: [u8], value: u64) -> [u8]:
    var out = buffer
    var shift: u64 = 0u64
    while shift < 64u64:
        out.push(((value >> shift) & 255u64) as u8)
        shift = shift + 8u64
    out

fn _abi_hex_nibble_v1(value: text) -> i64:
    val alphabet = "0123456789abcdef"
    var index: i64 = 0
    while index < 16:
        if alphabet.substring(index, index + 1) == value: return index
        index = index + 1
    -1

fn _abi_digest_raw_v1(digest: text) -> [u8]:
    var out: [u8] = []
    if digest.len() != 64: return out
    var index: i64 = 0
    while index < 64:
        val high = _abi_hex_nibble_v1(digest.substring(index, index + 1))
        val low = _abi_hex_nibble_v1(digest.substring(index + 1, index + 2))
        if high < 0 or low < 0: return []
        out.push(((high << 4) | low) as u8)
        index = index + 2
    out

fn _abi_has_zero_v1(bytes: [u8]) -> bool:
    for value in bytes:
        if value == 0u8: return true
    false

pub fn simple_native_build_registry_image_v1() -> text:
    "simple.native-build.contract.v1\n" +
    "id=6002808248662896896;major=1;minor=0;query=1\n" +
    "call=c:i32(u64,u64,u64,u32,u64,u32);symbol=simple_native_build_invoke_v1\n" +
    "wire=little-endian;alignment=1;query-bytes=44,60;descriptor=96;session=32;request=96;result=96\n" +
    "descriptor=u32:size,major,minor,flags;u64:interface;u32:query,request,result,session,open,run,read,close,max-request,max-page;u64:max-retained;u32:max-items,max-text,max-sections,max-depth;u64:reserved\n" +
    "session=u64:manager,instance,generation,nonce\n" +
    "request=u32:size,operation;session;u32:payload-offset,payload-length,section,page-capacity;u64:section-offset,max-retained,max-work;u32:max-items,max-text,max-wall-ms,reserved\n" +
    "result=u32:size;i32:status,exit;u32:terminal;session;u32:section,flags;u64:section-length,page-offset;u32:payload-offset,payload-length,required-capacity,cleanup;u64:reserved\n" +
    "operations=1:open,2:run,3:read,4:close;status=0..13;terminal=0..5;cleanup=0..2;sections=1..6\n" +
    "limits=request:16777216,page:1048576,response:1048672,retained:268435456,items:1048576,text:1048576,sections:8,depth:32,sessions:64,wall-ms:86400000,work:9223372036854775807\n" +
    "tlv=magic4,u16-major:1,u16-minor:0,u32-total,u32-count;field=u16-tag,u8-type,u8-zero,u32-length,value;sorted-required-exact\n" +
    "types=1:u32,2:u64,3:bool,4:utf8,5:text-vector,6:digest32,7:record,8:bytes,9:reference-vector,10:text-map\n" +
    "NBP1=1:6,2:1,3:1,4:4,5:5,6:7,7:7,8:8,9:9,10:10,11:6,12:6\n" +
    "NBO1=1:5,2:4,3:4,4:3,5:1,6:3,7:3,8:3,9:1,10:4,11:3,12:4,13:4,14:4,15:4,16:3,17:4,18:3,19:4,20:3,21:4,22:2,23:2,24:5,25:4,26:4\n" +
    "NBC1=1:4,2:4,3:4,4:4,5:4,6:4,7:4,8:1,9:2,10:2,11:2,12:6\n" +
    "NBAV=magic4,u16-version:1,u16-zero,u32-count,repeated(u32-length,utf8);argv-excludes-executable-includes-command\n" +
    "authority=104:session32-input-broker,session32-output-scope,u32-snapshot-schema,u32-zero,digest32-snapshot\n" +
    "references=u32-count,repeated(text-role,text-name,text-kind,u32-schema,digest32);sort-role-name;duplicate-role-name-reject\n" +
    "maps=u32-count,repeated(text-key,text-value);sort-key;duplicate-reject;vector=u32-count,repeated(text);text=u32-length,utf8\n" +
    "route=1:pure,2:bootstrap-compat,3:stage4-pure;source-profile=1:frozen,2:anchored-nonpromotable\n" +
    "control-flags=strip:1,emit-object:2,emit-archive:4,emit-smf:8,entry-closure:16,incremental:32,clean:64,no-mangle:128,log-on:256\n" +
    "explicit-fields=opt:1,target:2,entry:4,mode:8,backend:16,runtime:32,output:64,roots:128\n" +
    "semantics=1;strict-utf8-before-text;no-nul-in-text;no-native-heap;unknown-reject;owner-token-validation;no-implicit-defaults;process-pin;no-activation\n"

pub fn simple_native_build_schema_digest_v1() -> text:
    sha256_u8_hex(simple_native_build_registry_image_v1().bytes())

pub fn simple_native_build_host_digest_v1(host_tag: text) -> text:
    val bytes = host_tag.bytes()
    if bytes.len() == 0 or _abi_has_zero_v1(bytes) or bytes.len() > 1048576: return ""
    var framed = "simple.native-build.host-abi.v1".bytes()
    framed.push(0u8)
    framed = _abi_push_u32_v1(framed, bytes.len() as u32)
    for byte in bytes: framed.push(byte)
    sha256_u8_hex(framed)

fn _abi_failure_v1(error: text) -> NativeBuildFullAbiDigestV1:
    NativeBuildFullAbiDigestV1(ok: false, schema_digest: "", host_digest: "",
        full_digest: "", words: simple_abi_digest_zero_v1(), preimage_bytes: 0,
        execution_authority: false, error: error)

pub fn simple_native_build_full_abi_digest_v1(host_tag: text,
        rich_diagnostics_codec_digest: text) -> NativeBuildFullAbiDigestV1:
    val schema_digest = simple_native_build_schema_digest_v1()
    if schema_digest != SIMPLE_NATIVE_BUILD_SCHEMA_DIGEST_V1:
        return _abi_failure_v1("native_build_registry_image_mismatch")
    val host_digest = simple_native_build_host_digest_v1(host_tag)
    val schema_raw = _abi_digest_raw_v1(schema_digest)
    val host_raw = _abi_digest_raw_v1(host_digest)
    val diagnostics_raw = _abi_digest_raw_v1(rich_diagnostics_codec_digest)
    if host_raw.len() != 32 or schema_raw.len() != 32 or diagnostics_raw.len() != 32:
        return _abi_failure_v1("native_build_abi_digest_input")
    var preimage = "simple.native-build.abi.v1".bytes()
    preimage.push(0u8)
    preimage = _abi_push_u64_v1(preimage, 6002808248662896896u64)
    for value in [1u32, 0u32, 1u32, 96u32, 32u32, 96u32, 96u32]:
        preimage = _abi_push_u32_v1(preimage, value)
    for bytes in [schema_raw, host_raw, diagnostics_raw]:
        for byte in bytes: preimage.push(byte)
    if preimage.len() != 159: return _abi_failure_v1("native_build_abi_preimage_size")
    val full_digest = sha256_u8_hex(preimage)
    val parsed = simple_abi_digest_parse_hex_v1(full_digest)
    if not parsed.ok: return _abi_failure_v1("native_build_abi_word_conversion")
    NativeBuildFullAbiDigestV1(ok: true, schema_digest: schema_digest,
        host_digest: host_digest, full_digest: full_digest, words: parsed.value,
        preimage_bytes: preimage.len(), execution_authority: false, error: "")
