# Canonical SimpleCliCommandV1 request/response arenas.
#
# All offsets are relative to the beginning of their containing arena. The
# fixed headers contain no pointers. Arguments use a counted sequence of
# length-prefixed UTF-8 byte strings.

use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE,
    SIMPLE_CLI_COMMAND_RESULT_V1_SIZE,
    SIMPLE_CLI_DESCRIBE, SIMPLE_CLI_VALIDATE_ARGS, SIMPLE_CLI_RUN, SIMPLE_CLI_COMPLETE
}

extern fn rt_bytes_to_text(data: [u8]) -> text

class CliCommandRequestArenaV1:
    ok: bool
    bytes: [u8]
    diagnostic: text

class CliCommandRequestViewV1:
    ok: bool
    operation: u32
    command: text
    args: [text]
    output_capacity: u32
    diagnostic: text

class CliCommandResultArenaV1:
    ok: bool
    bytes: [u8]
    diagnostic: text

class CliCommandResultViewV1:
    ok: bool
    status: i32
    output: text
    diagnostic_text: text
    diagnostic: text

fn _push_u32(out: [u8], value: u32):
    out.push((value & 255) as u8)
    out.push(((value >> 8) & 255) as u8)
    out.push(((value >> 16) & 255) as u8)
    out.push(((value >> 24) & 255) as u8)

fn _read_u32(data: [u8], offset: i64) -> u32:
    (data[offset] as u32) |
        ((data[offset + 1] as u32) << 8) |
        ((data[offset + 2] as u32) << 16) |
        ((data[offset + 3] as u32) << 24)

fn _append(out: [u8], values: [u8]):
    var i = 0
    while i < values.len():
        out.push(values[i])
        i = i + 1

fn _text(data: [u8], offset: i64, length: i64) -> text:
    var raw: [u8] = []
    var i = 0
    while i < length:
        raw.push(data[offset + i])
        i = i + 1
    rt_bytes_to_text(raw)

fn _operation_valid(operation: u32) -> bool:
    operation == SIMPLE_CLI_DESCRIBE or operation == SIMPLE_CLI_VALIDATE_ARGS or
        operation == SIMPLE_CLI_RUN or operation == SIMPLE_CLI_COMPLETE

fn encode_cli_command_request_v1(
    operation: u32,
    command: text,
    args: [text],
    output_capacity: u32
) -> CliCommandRequestArenaV1:
    if not _operation_valid(operation):
        return CliCommandRequestArenaV1(false, [], "cli-operation-invalid")
    if command.len() == 0 or command.to_bytes().len() > 65535:
        return CliCommandRequestArenaV1(false, [], "cli-command-invalid")
    if args.len() > 4096 or output_capacity == 0:
        return CliCommandRequestArenaV1(false, [], "cli-request-limit-invalid")

    val command_bytes = command.to_bytes()
    var args_bytes: [u8] = []
    _push_u32(args_bytes, args.len() as u32)
    var i = 0
    while i < args.len():
        val value = args[i].to_bytes()
        if value.len() > 1048576:
            return CliCommandRequestArenaV1(false, [], "cli-argument-too-large")
        _push_u32(args_bytes, value.len() as u32)
        _append(args_bytes, value)
        i = i + 1

    val command_offset = SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE
    val args_offset = command_offset + command_bytes.len() as u32
    var out: [u8] = []
    _push_u32(out, SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE)
    _push_u32(out, operation)
    _push_u32(out, command_offset)
    _push_u32(out, command_bytes.len() as u32)
    _push_u32(out, args_offset)
    _push_u32(out, args_bytes.len() as u32)
    _push_u32(out, output_capacity)
    _append(out, command_bytes)
    _append(out, args_bytes)
    CliCommandRequestArenaV1(true, out, "")

fn decode_cli_command_request_v1(data: [u8]) -> CliCommandRequestViewV1:
    if data.len() < SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE as i64:
        return CliCommandRequestViewV1(false, 0, "", [], 0, "cli-request-truncated")
    if _read_u32(data, 0) != SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE:
        return CliCommandRequestViewV1(false, 0, "", [], 0, "cli-request-descriptor-invalid")
    val operation = _read_u32(data, 4)
    if not _operation_valid(operation):
        return CliCommandRequestViewV1(false, operation, "", [], 0, "cli-operation-invalid")
    val command_offset = _read_u32(data, 8) as i64
    val command_length = _read_u32(data, 12) as i64
    val args_offset = _read_u32(data, 16) as i64
    val args_length = _read_u32(data, 20) as i64
    val output_capacity = _read_u32(data, 24)
    if command_offset != SIMPLE_CLI_COMMAND_REQUEST_V1_SIZE as i64 or
            command_length <= 0 or args_offset != command_offset + command_length or
            args_length < 4 or args_offset + args_length != data.len() or output_capacity == 0:
        return CliCommandRequestViewV1(false, operation, "", [], output_capacity, "cli-request-bounds-invalid")
    val count = _read_u32(data, args_offset) as i64
    if count > 4096:
        return CliCommandRequestViewV1(false, operation, "", [], output_capacity, "cli-argument-count-invalid")
    var args: [text] = []
    var cursor = args_offset + 4
    var i = 0
    while i < count:
        if cursor + 4 > data.len():
            return CliCommandRequestViewV1(false, operation, "", [], output_capacity, "cli-argument-truncated")
        val length = _read_u32(data, cursor) as i64
        cursor = cursor + 4
        if length > data.len() - cursor:
            return CliCommandRequestViewV1(false, operation, "", [], output_capacity, "cli-argument-bounds-invalid")
        args.push(_text(data, cursor, length))
        cursor = cursor + length
        i = i + 1
    if cursor != data.len():
        return CliCommandRequestViewV1(false, operation, "", [], output_capacity, "cli-argument-trailing-bytes")
    CliCommandRequestViewV1(true, operation, _text(data, command_offset, command_length), args, output_capacity, "")

fn encode_cli_command_result_v1(status: i32, output: text, diagnostic_text: text) -> CliCommandResultArenaV1:
    val output_bytes = output.to_bytes()
    val diagnostic_bytes = diagnostic_text.to_bytes()
    val output_offset = SIMPLE_CLI_COMMAND_RESULT_V1_SIZE
    val diagnostic_offset = output_offset + output_bytes.len() as u32
    var out: [u8] = []
    _push_u32(out, status as u32)
    _push_u32(out, output_offset)
    _push_u32(out, output_bytes.len() as u32)
    _push_u32(out, diagnostic_offset)
    _push_u32(out, diagnostic_bytes.len() as u32)
    _append(out, output_bytes)
    _append(out, diagnostic_bytes)
    CliCommandResultArenaV1(true, out, "")

fn decode_cli_command_result_v1(data: [u8]) -> CliCommandResultViewV1:
    if data.len() < SIMPLE_CLI_COMMAND_RESULT_V1_SIZE as i64:
        return CliCommandResultViewV1(false, 0, "", "", "cli-result-truncated")
    val status = _read_u32(data, 0) as i32
    val output_offset = _read_u32(data, 4) as i64
    val output_length = _read_u32(data, 8) as i64
    val diagnostic_offset = _read_u32(data, 12) as i64
    val diagnostic_length = _read_u32(data, 16) as i64
    if output_offset != SIMPLE_CLI_COMMAND_RESULT_V1_SIZE as i64 or
            diagnostic_offset != output_offset + output_length or
            output_length < 0 or diagnostic_length < 0 or
            diagnostic_offset + diagnostic_length != data.len():
        return CliCommandResultViewV1(false, status, "", "", "cli-result-bounds-invalid")
    CliCommandResultViewV1(
        true,
        status,
        _text(data, output_offset, output_length),
        _text(data, diagnostic_offset, diagnostic_length),
        ""
    )

export CliCommandRequestArenaV1, CliCommandRequestViewV1
export CliCommandResultArenaV1, CliCommandResultViewV1
export encode_cli_command_request_v1, decode_cli_command_request_v1
export encode_cli_command_result_v1, decode_cli_command_result_v1
