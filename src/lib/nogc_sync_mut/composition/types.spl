# Simple Composition Image v1 shared records.
#
# The v1 image carries the application projection plus the first independently
# digested provider/binding/CLI-command section. Later optional sections extend
# the image without changing these records.

struct SimpleAppRecordV1:
    app_id: text
    display_name: text
    artifact_path: text
    icon: text
    shortcut: text
    associations: [text]
    capabilities: [text]

struct SimpleInterfaceGroupRecordV1:
    group_id: text
    major: i64
    minor: i64
    abi_digest: text

struct SimpleProviderRecordV1:
    provider_id: text
    artifact_path: text
    artifact_kind: text
    artifact_digest: text
    interface_groups: [text]
    required_capability_bits: i64

struct SimpleBindingRecordV1:
    service_id: text
    interface_group_id: text
    provider_id: text

struct SimpleCliCommandRecordV1:
    command_name: text
    aliases: [text]
    summary: text
    binding_service_id: text
    interface_group_id: text

# Stable provider-boundary launch request. Offsets address caller-owned,
# bounded request storage; no Simple text/array/object layout crosses the ABI.
struct SimpleAppLaunchV1:
    descriptor_size: u32
    app_id_offset: u32
    artifact_id_offset: u32
    action_id_offset: u32
    args_offset: u32
    args_length: u32
    capability_words_offset: u32
    capability_words_length: u32

struct SimpleCompositionImageV1:
    schema: text
    profile: text
    apps: [SimpleAppRecordV1]
    interface_groups: [SimpleInterfaceGroupRecordV1]
    providers: [SimpleProviderRecordV1]
    bindings: [SimpleBindingRecordV1]
    commands: [SimpleCliCommandRecordV1]
    bytes: [u8]
    composition_digest: text

class CompositionDiagnosticV1:
    code: text
    subject: text
    message: text

class CompositionReadResultV1:
    ok: bool
    image: SimpleCompositionImageV1
    diagnostic: CompositionDiagnosticV1

fn empty_composition_image_v1() -> SimpleCompositionImageV1:
    SimpleCompositionImageV1(
        schema: "simple.composition/1",
        profile: "",
        apps: [],
        interface_groups: [],
        providers: [],
        bindings: [],
        commands: [],
        bytes: [],
        composition_digest: ""
    )

fn composition_diagnostic_v1(code: text, subject: text, message: text) -> CompositionDiagnosticV1:
    CompositionDiagnosticV1(code: code, subject: subject, message: message)

fn composition_read_error_v1(code: text, subject: text, message: text) -> CompositionReadResultV1:
    CompositionReadResultV1(
        ok: false,
        image: empty_composition_image_v1(),
        diagnostic: composition_diagnostic_v1(code, subject, message)
    )
