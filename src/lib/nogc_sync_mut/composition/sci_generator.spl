# Build-side SCI route-section generator (WP-12s, research §5.5).
#
# Compiles source-of-truth route configuration into ONE compact binary section
# with a generated sorted key index, so that the startup-side reader
# (`sci_reader.spl`) can resolve a route by INDEXED ACCESS in O(log n) probes
# without ever parsing a record it was not asked for.
#
# Layout (all little-endian, no native structs serialized):
#
#   header (96 bytes)
#     0  magic[8]           = "SIMPSCI1"
#     8  schema_version u16 = 1
#    10  header_size    u16 = 96
#    12  flags          u32
#    16  generation     u64
#    24  route_count    u32
#    28  string_bytes   u32
#    32  index_offset   u64
#    40  record_offset  u64
#    48  string_offset  u64
#    56  section_size   u64
#    64  content_digest[32]   (body digest; verification is OPT-IN, see reader)
#
#   index entry (32 bytes each, sorted ascending by key_hash)
#     0  key_hash u64   8 key_off u32   12 key_len u32
#    16  rec_off  u64  24 rec_len u32   28 rec_crc u32
#
#   record payload (17 bytes each, addressed only via its index entry)
#     0  route_kind u8   1 command_id u32   5 component_count u16
#     7  flags u16       9 target_off u32  13 target_len u32
#
# `key_off` / `target_off` are relative to `string_offset`; `rec_off` is
# absolute within the section.

use std.common.crypto.sha256.{sha256_bytes}
use std.common.string_core.{text_to_bytes}

val SCI_ROUTE_MAGIC_V1: text = "SIMPSCI1"
val SCI_ROUTE_SCHEMA_V1: i64 = 1
val SCI_ROUTE_HEADER_SIZE_V1: i64 = 96
val SCI_ROUTE_INDEX_ENTRY_SIZE_V1: i64 = 32
val SCI_ROUTE_RECORD_SIZE_V1: i64 = 17

# Source-of-truth route definition handed to the generator.
struct SciRouteSourceV1:
    key: text
    route_kind: i64
    command_id: i64
    target: text
    component_count: i64
    flags: i64

struct SciGenerateResultV1:
    ok: bool
    error_code: text
    error_message: text
    bytes: [u8]
    route_count: i64

fn _gen_error(code: text, message: text) -> SciGenerateResultV1:
    var empty: [u8] = []
    SciGenerateResultV1(ok: false, error_code: code, error_message: message, bytes: empty, route_count: 0)

fn _push_u8(out: [u8], value: i64):
    out.push((value & 255) as u8)

fn _push_u16(out: [u8], value: i64):
    out.push((value & 255) as u8)
    out.push(((value >> 8) & 255) as u8)

fn _push_u32(out: [u8], value: i64):
    var i = 0
    while i < 4:
        out.push(((value >> (i * 8)) & 255) as u8)
        i = i + 1

fn _push_u64(out: [u8], value: i64):
    var i = 0
    while i < 8:
        out.push(((value >> (i * 8)) & 255) as u8)
        i = i + 1

fn _put_u32(out: [u8], offset: i64, value: i64):
    var i = 0
    while i < 4:
        out[offset + i] = ((value >> (i * 8)) & 255) as u8
        i = i + 1

# 32-bit FNV-1a, kept inside i64 with an explicit mask so no overflow is
# possible. Shared verbatim with the reader; both sides must agree.
fn sci_key_hash_v1(raw: [u8]) -> i64:
    var h = 2166136261
    var i = 0
    while i < raw.len():
        h = (h ^ (raw[i] as i64)) & 4294967295
        h = (h * 16777619) & 4294967295
        i = i + 1
    h

fn sci_record_checksum_v1(data: [u8], offset: i64, length: i64) -> i64:
    var h = 2166136261
    var i = 0
    while i < length:
        h = (h ^ (data[offset + i] as i64)) & 4294967295
        h = (h * 16777619) & 4294967295
        i = i + 1
    h

fn _bytes_of(value: text) -> [u8]:
    text_to_bytes(value)

fn _digest32(data: [u8], offset: i64, length: i64) -> [u8]:
    var wide: [i64] = []
    var i = 0
    while i < length:
        wide.push(data[offset + i] as i64)
        i = i + 1
    val raw = sha256_bytes(wide)
    var out: [u8] = []
    i = 0
    while i < raw.len():
        out.push(raw[i] as u8)
        i = i + 1
    out

fn _compare_bytes(a: [u8], b: [u8]) -> i64:
    var i = 0
    while i < a.len() and i < b.len():
        val x = a[i] as i64
        val y = b[i] as i64
        if x != y:
            if x < y: return -1
            return 1
        i = i + 1
    if a.len() < b.len(): return -1
    if a.len() > b.len(): return 1
    0

# Generate the SCI route section. Fails closed on an empty key, a duplicate
# key, or an out-of-range scalar field: a build that cannot produce a sound
# index must not produce a section at all.
fn sci_generate_route_section_v1(routes: [SciRouteSourceV1], generation: i64) -> SciGenerateResultV1:
    val n = routes.len()
    if n < 0 or n > 1048576:
        return _gen_error("SCI_GEN_ROUTE_COUNT", "unreasonable route count")

    # ---- validate + collect key bytes -------------------------------------
    var key_bytes: [[u8]] = []
    var target_bytes: [[u8]] = []
    var hashes: [i64] = []
    var i = 0
    while i < n:
        val r = routes[i]
        val kb = _bytes_of(r.key)
        if kb.len() == 0:
            return _gen_error("SCI_GEN_EMPTY_KEY", "route key must not be empty")
        if r.route_kind < 0 or r.route_kind > 255:
            return _gen_error("SCI_GEN_FIELD_RANGE", "route_kind out of range for key " + r.key)
        if r.command_id < 0 or r.command_id > 4294967295:
            return _gen_error("SCI_GEN_FIELD_RANGE", "command_id out of range for key " + r.key)
        if r.component_count < 0 or r.component_count > 65535:
            return _gen_error("SCI_GEN_FIELD_RANGE", "component_count out of range for key " + r.key)
        if r.flags < 0 or r.flags > 65535:
            return _gen_error("SCI_GEN_FIELD_RANGE", "flags out of range for key " + r.key)
        key_bytes.push(kb)
        target_bytes.push(_bytes_of(r.target))
        hashes.push(sci_key_hash_v1(kb))
        i = i + 1

    # duplicate keys break indexed lookup determinism -> fail closed
    i = 0
    while i < n:
        var j = i + 1
        while j < n:
            if _compare_bytes(key_bytes[i], key_bytes[j]) == 0:
                return _gen_error("SCI_GEN_DUPLICATE_KEY", "duplicate route key " + routes[i].key)
            j = j + 1
        i = i + 1

    # ---- order: ascending (key_hash, key bytes) ---------------------------
    # Selection sort: n is a build-time constant and the generator runs once
    # per build, so clarity beats asymptotics here.
    var order: [i64] = []
    i = 0
    while i < n:
        order.push(i)
        i = i + 1
    i = 0
    while i < n:
        var best = i
        var j = i + 1
        while j < n:
            val cand = order[j]
            val cur = order[best]
            var smaller = false
            if hashes[cand] < hashes[cur]:
                smaller = true
            elif hashes[cand] == hashes[cur]:
                if _compare_bytes(key_bytes[cand], key_bytes[cur]) < 0:
                    smaller = true
            if smaller:
                best = j
            j = j + 1
        val tmp = order[i]
        order[i] = order[best]
        order[best] = tmp
        i = i + 1

    # ---- string area ------------------------------------------------------
    var strings: [u8] = []
    var key_off: [i64] = []
    var target_off: [i64] = []
    i = 0
    while i < n:
        key_off.push(0)
        target_off.push(0)
        i = i + 1
    var oi = 0
    while oi < n:
        val idx = order[oi]
        key_off[idx] = strings.len()
        val kb = key_bytes[idx]
        var b = 0
        while b < kb.len():
            strings.push(kb[b])
            b = b + 1
        target_off[idx] = strings.len()
        val tb = target_bytes[idx]
        b = 0
        while b < tb.len():
            strings.push(tb[b])
            b = b + 1
        oi = oi + 1

    val index_offset = SCI_ROUTE_HEADER_SIZE_V1
    val record_offset = index_offset + n * SCI_ROUTE_INDEX_ENTRY_SIZE_V1
    val string_offset = record_offset + n * SCI_ROUTE_RECORD_SIZE_V1
    val section_size = string_offset + strings.len()

    # ---- header -----------------------------------------------------------
    var out: [u8] = []
    val magic = _bytes_of(SCI_ROUTE_MAGIC_V1)
    i = 0
    while i < 8:
        out.push(magic[i])
        i = i + 1
    _push_u16(out, SCI_ROUTE_SCHEMA_V1)
    _push_u16(out, SCI_ROUTE_HEADER_SIZE_V1)
    _push_u32(out, 0)
    _push_u64(out, generation)
    _push_u32(out, n)
    _push_u32(out, strings.len())
    _push_u64(out, index_offset)
    _push_u64(out, record_offset)
    _push_u64(out, string_offset)
    _push_u64(out, section_size)
    i = 0
    while i < 32:
        out.push(0 as u8)
        i = i + 1

    # ---- index (checksums patched after records are written) --------------
    oi = 0
    while oi < n:
        val idx = order[oi]
        _push_u64(out, hashes[idx])
        _push_u32(out, key_off[idx])
        _push_u32(out, key_bytes[idx].len())
        _push_u64(out, record_offset + oi * SCI_ROUTE_RECORD_SIZE_V1)
        _push_u32(out, SCI_ROUTE_RECORD_SIZE_V1)
        _push_u32(out, 0)
        oi = oi + 1

    # ---- records ----------------------------------------------------------
    oi = 0
    while oi < n:
        val idx = order[oi]
        val r = routes[idx]
        _push_u8(out, r.route_kind)
        _push_u32(out, r.command_id)
        _push_u16(out, r.component_count)
        _push_u16(out, r.flags)
        _push_u32(out, target_off[idx])
        _push_u32(out, target_bytes[idx].len())
        oi = oi + 1

    # ---- strings ----------------------------------------------------------
    i = 0
    while i < strings.len():
        out.push(strings[i])
        i = i + 1

    # ---- patch per-record checksums ---------------------------------------
    oi = 0
    while oi < n:
        val rec_off = record_offset + oi * SCI_ROUTE_RECORD_SIZE_V1
        val crc = sci_record_checksum_v1(out, rec_off, SCI_ROUTE_RECORD_SIZE_V1)
        _put_u32(out, index_offset + oi * SCI_ROUTE_INDEX_ENTRY_SIZE_V1 + 28, crc)
        oi = oi + 1

    # ---- body digest (opt-in verification on the read side) ---------------
    val digest = _digest32(out, SCI_ROUTE_HEADER_SIZE_V1, section_size - SCI_ROUTE_HEADER_SIZE_V1)
    i = 0
    while i < 32:
        out[64 + i] = digest[i]
        i = i + 1

    SciGenerateResultV1(ok: true, error_code: "", error_message: "", bytes: out, route_count: n)
