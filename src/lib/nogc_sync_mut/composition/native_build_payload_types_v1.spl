"""Typed values for the canonical native-build payload records."""

pub enum NativeBuildRouteV1:
    NormalPure
    BootstrapCompatibility
    Stage4Pure

pub enum NativeBuildSourceProfileV1:
    FrozenSnapshot
    AnchoredLocal

pub enum NativeBuildOutputFormatV1:
    Native
    Smf
    Both

pub enum NativeBuildLinkModeV1:
    Dynload
    OneBinary

pub struct NativeBuildReferenceV1:
    role: text
    name: text
    kind: text
    schema: u32
    digest: text

pub struct NativeBuildTextMapEntryV1:
    key: text
    value: text

pub struct NativeBuildAuthorityReferenceV1:
    input_broker_token: [u8]
    output_scope_token: [u8]
    snapshot_schema: u32
    snapshot_digest: text

pub struct NativeBuildDriverOptionsV1:
    input_files: [text]
    output_file: text
    output_format: NativeBuildOutputFormatV1
    optimize: bool
    opt_level: u32
    release: bool
    debug_info: bool
    verbose: bool
    log_level: u32
    profile: text
    no_borrow_check: bool
    backend: text
    native_target: text
    backend_plugin_path: text
    interpreter_mode: text
    gc_off: bool
    smf_output_mode: text
    low_memory: bool
    debug_trace_level: text
    coverage_enabled: bool
    mcdc_mode_text: text
    mcdc_owner_bytes: u64
    mcdc_global_bytes: u64
    allowed_families: [text]
    build_mode: text
    riscv_gen2_target: text

pub struct NativeBuildControlsV1:
    native_link_mode: NativeBuildLinkModeV1
    runtime_bundle: text
    runtime_path: text
    cpu_tuning: text
    linker_script: text
    cache_directory: text
    cache_scope: text
    worker_threads: u32
    per_file_timeout_ms: u64
    control_bits: u64
    explicit_field_bits: u64
    runtime_policy_digest: text

pub struct NativeBuildPayloadV1:
    request_identity: text
    route: NativeBuildRouteV1
    source_profile: NativeBuildSourceProfileV1
    effective_entry: text
    source_roots: [text]
    driver_options: NativeBuildDriverOptionsV1
    native_controls: NativeBuildControlsV1
    authority: NativeBuildAuthorityReferenceV1
    dependencies: [NativeBuildReferenceV1]
    declared_context: [NativeBuildTextMapEntryV1]
    cli_provenance_digest: text
    rich_diagnostics_codec_digest: text

pub struct NativeBuildPayloadDecodeV1:
    ok: bool
    value: NativeBuildPayloadV1?
    # Counts semantic collection elements created only after their full preflight.
    collection_items_materialized: i64
    authority_available: bool
    execution_available: bool
    error: text

pub struct NativeBuildDriverOptionsDecodeV1:
    ok: bool
    value: NativeBuildDriverOptionsV1?
    error: text

pub struct NativeBuildControlsDecodeV1:
    ok: bool
    value: NativeBuildControlsV1?
    error: text

pub struct NativeBuildArgvDecodeV1:
    ok: bool
    arguments: [text]
    arguments_materialized: i64
    executable: bool
    error: text
