# ----------------------------------------------------------------------------
# Bounded glyph-advance cache (2026-07-29) -- module-level, keyed by
# (loaded-face identity, font_size, codepoint), so it is valid across EVERY
# FontRenderer instance sharing the same loaded face, not just the one that
# first measured a given character. get_glyph_advance's per-instance
# self.cache already caches full CachedGlyph entries (with pixels) inserted
# by get_glyph, but only the SFFI-dylib-with-selected_outline_blob and
# legacy-ttf-handle backends have a genuine metrics-only path; the SFFI
# dylib-without-selected-blob backend (used by every browser_default_for_family
# font, i.e. every plain #text node under vector_fonts) has none and falls
# through to a full pixel rasterize (get_glyph) just to read `.advance`
# (doc/08_tracking/bug/web_style_producer_4s_per_node_interpreted_lane_
# 2026-07-29.md). This cache short-circuits that fallthrough on a repeat
# (codepoint, font_size, identity) triple without touching the rasterize
# path at all. ASCII 32-126 (the overwhelming common case for UI text) gets
# a direct array-indexed O(1) bucket; everything else (non-ASCII, or a
# second concurrently-live face/size) uses a small bounded overflow list
# (native Dict.get()/.len() are unreliable per doc/07_guide/language/
# dict_native_pitfalls.md -- plain arrays + counters only).
val _ADV_ASCII_LO: i32 = 32
val _ADV_ASCII_HI: i32 = 126
val _ADV_ASCII_SPAN: i32 = 95
var _adv_ascii_identity: text = ""
var _adv_ascii_size: i32 = -1
var _adv_ascii_vals: [i32] = [-1; 95]
var _adv_overflow_identity: [text] = []
var _adv_overflow_size: [i32] = []
var _adv_overflow_cp: [i32] = []
var _adv_overflow_val: [i32] = []
val _ADV_OVERFLOW_CAP: i32 = 1024
var _adv_overflow_cursor: i32 = 0

fn _adv_cache_lookup(identity: text, font_size: i32, codepoint: i32) -> i32:
    if codepoint >= _ADV_ASCII_LO and codepoint <= _ADV_ASCII_HI:
        if identity == _adv_ascii_identity and font_size == _adv_ascii_size:
            return _adv_ascii_vals[codepoint - _ADV_ASCII_LO]
        return -1
    var i: i32 = 0
    while i < _adv_overflow_cp.len():
        if (_adv_overflow_cp[i] == codepoint and _adv_overflow_size[i] == font_size and
            _adv_overflow_identity[i] == identity):
            return _adv_overflow_val[i]
        i = i + 1
    -1

fn _adv_cache_store(identity: text, font_size: i32, codepoint: i32, advance: i32):
    if advance <= 0:
        return
    if codepoint >= _ADV_ASCII_LO and codepoint <= _ADV_ASCII_HI:
        if identity != _adv_ascii_identity or font_size != _adv_ascii_size:
            _adv_ascii_identity = identity
            _adv_ascii_size = font_size
            _adv_ascii_vals = [-1; 95]
        _adv_ascii_vals[codepoint - _ADV_ASCII_LO] = advance
        return
    if _adv_overflow_cp.len() < _ADV_OVERFLOW_CAP:
        _adv_overflow_identity = _adv_overflow_identity.push(identity)
        _adv_overflow_size = _adv_overflow_size.push(font_size)
        _adv_overflow_cp = _adv_overflow_cp.push(codepoint)
        _adv_overflow_val = _adv_overflow_val.push(advance)
        return
    # Bounded ring-buffer overwrite once full -- same pattern as
    # _resolved_font_metric_store above, never grows unbounded.
    _adv_overflow_identity[_adv_overflow_cursor] = identity
    _adv_overflow_size[_adv_overflow_cursor] = font_size
    _adv_overflow_cp[_adv_overflow_cursor] = codepoint
    _adv_overflow_val[_adv_overflow_cursor] = advance
    _adv_overflow_cursor = (_adv_overflow_cursor + 1) % _ADV_OVERFLOW_CAP
use std.nogc_sync_mut.sffi.spl_fonts.{FontRasterizer, LayoutGlyph, SubpixelGlyphBitmap}
use std.nogc_sync_mut.text_layout.font_provider.{
    browser_font_dylib_candidates,
    browser_serif_font_candidates,
    browser_font_candidates_for_family
}
use std.nogc_sync_mut.text_layout.font_rasterizer.{
    _sffi_glyph_to_cached,
    rasterize_ttf,
    rasterize_vector_accelerated,
    rasterize_bitmap,
    blit_glyph
}
use std.nogc_sync_mut.text_layout.font_vector_data.{vf_glyph_commands}
use std.nogc_sync_mut.text_layout.font_advance_layout.{font_batch_apply_advances}
use std.nogc_sync_mut.io.font_sffi.{font_face_ascent, free_font, font_face_identity, font_face_is_live, load_font}
use std.nogc_sync_mut.sffi.io.{file_read_bytes}
# Glyph iteration is by CODEPOINT. `text.len()` is a UTF-8 BYTE count while
# `char_code_at(i)` is CODEPOINT indexed, so `while ci < content.len()` walked
# a 3-character string 6 times and read phantom zero codepoints past the end —
# inflating every non-ASCII advance array, width, and rendered run.
# See doc/08_tracking/bug/live_lane_inline_text_measure_counts_utf8_bytes_2026-08-11.md
use std.common.encoding.utf8.{text_codepoints}
use std.common.gpu.font_atlas_composite.{FONT_ATLAS_COMPOSITE_PROGRAM_VERSION}
use std.common.encoding.sfnt_glyf.{SFNT_GLYPH_SELECTOR_CODEPOINT, SFNT_GLYPH_SELECTOR_INDEX, sfnt_measure_glyph_into, sfnt_render_glyph_into}
use std.common.encoding.font_registry.{FontAssetCandidate, selected_font_asset_candidates, selected_font_asset_candidate_for_path, selected_font_asset_candidate_for_identity, selected_font_asset_for_language_category, selected_font_asset_identity, selected_font_asset_identity_for_path, selected_font_asset_local_path_for_identity, selected_font_asset_physical_path, selected_font_language_ranks, selected_font_simple_tuple_accepted, validate_selected_font_asset}
use std.common.encoding.utf8.{text_codepoints}
use std.common.ui.draw_ir.{DrawIrGlyphRunPayload, draw_ir_empty_glyph_run_payload, draw_ir_glyph_run_payload}
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new}

# Shared Font Renderer — unified text rendering for both OS and browser
#
# Provides buffer-based text rendering using three font backends:
#   1. TrueType (via stb_truetype SFFI) — full Unicode, AA, proportional
#   2. Vector font (outline commands) — 29 glyphs, 2x2 sub-pixel AA
#   3. Bitmap 8x16 (VGA fallback) — monospace, no AA
#
# The renderer auto-selects the best available backend per glyph:
#   - If TrueType font loaded → use TrueType
#   - If vector glyph available → use vector
#   - Otherwise → bitmap fallback
#
# This module has NO dependency on CompositorBackend, so it can be used
# by the OS compositor, browser engine, and game engine alike.
#
# Sub-modules:
#   font_provider.spl     — font candidate lists, CSS @font-face parsing, materialization
#   font_rasterizer.spl   — glyph rasterization backends + blit_glyph
#   font_vector_data.spl  — vector outline tables + system font constants

# ============================================================================
# Glyph Cache Entry
# ============================================================================

class CachedGlyph:
    codepoint: i32
    font_size: i32
    width: i32
    height: i32
    advance: i32
    bearing_x: i32
    bearing_y: i32
    pixels: [u8]    # grayscale alpha (0-255) per pixel, row-major

    static fn empty(cp: i32, fs: i32) -> CachedGlyph:
        CachedGlyph(codepoint: cp, font_size: fs, width: 0, height: 0, advance: 0, bearing_x: 0, bearing_y: 0, pixels: [])

# ============================================================================
# Glyph Cache
# ============================================================================

class ResolvedFontMetrics:
    valid: bool
    family: text
    identity: text
    advances: [i32]
    width: i32
    line_height: i32
    reason: text
    glyph_run: DrawIrGlyphRunPayload
    shaping_required: bool

# ponytail: process-local 128-entry ring for pinned layout metrics; replace with
# per-document caches only when concurrent multi-face ownership lands.
val RESOLVED_FONT_METRICS_CACHE_LIMIT: i64 = 128
val RESOLVED_FONT_METRICS_CACHE_FAMILY_LIMIT: i64 = 1024
val RESOLVED_FONT_METRICS_CACHE_CONTENT_LIMIT: i64 = 4096
var _resolved_font_metric_keys: [text] = []
var _resolved_font_metric_values: [ResolvedFontMetrics] = []
var _resolved_font_metric_cursor: i64 = 0
var _resolved_font_metric_lock: Mutex? = nil
# Shaped-run cache hit/miss counters (2026-08-06) -- this cache existed
# before this session but had no observability; added so proportionality
# (repeated identical shaping produces hits, not re-shaping) is provable.
# A parallel glyph-raster (pixel) cache was attempted the same day using the
# same `[text]`-array-key-scan pattern and found to have a 0% real hit rate
# under native/JIT codegen (plain `[text]` array element read-back after
# store returns corrupted/empty text) -- see doc/08_tracking/bug/
# glyph_raster_cache_text_array_index_corrupt_zero_hit_rate_2026-08-06.md.
# It was removed rather than landed. These counters and the stress test
# below (font_renderer_spec.spl) were added specifically to probe whether
# THIS cache -- same key-array shape -- shares that corruption; a spec run
# under `bin/simple test` only exercises the tree-walk interpreter, not the
# JIT/native lane the bug doc reproduced on, so a green spec run here proves
# interpreter-lane correctness only, not JIT-lane safety.
var _resolved_font_metric_hits: i64 = 0
var _resolved_font_metric_misses: i64 = 0
# Cross-instance glyph-raster (pixel) cache -- T12 (render-perf replan,
# 2026-08-07). Landed after T11 corrected the root cause named in the block
# comment above: "[text]-array element read is corrupt under native/JIT" was
# disproven (plain array push/index-read is clean on both engines; see
# text_array_index_readback_spec.spl). The actual open interpreter-lane
# defect is narrower -- a free function whose ENTIRE body is only
# `_arr.push(v)` can silently lose the write when called from an `it` block
# under `bin/simple test` -- and does not reproduce for a mutation done
# INLINE inside the function/method that owns the array (verified by a
# positive-control probe: `me` method body doing `_arr = _arr.push(v)`
# directly, called from an `it` block via a class instance, round-trips
# correctly). This cache is deliberately implemented that way: the push and
# ring-buffer overwrite live directly inside `FontRenderer.get_glyph`'s body
# below, never delegated to a separate free-function push helper, to stay on
# the proven-safe side of that boundary. Read-only accessors below are safe
# regardless (no push involved).
val GLYPH_RASTER_CACHE_LIMIT: i64 = 4096
var _glyph_raster_keys: [text] = []
var _glyph_raster_values: [CachedGlyph] = []
var _glyph_raster_cursor: i64 = 0
var _glyph_raster_hits: i64 = 0
var _glyph_raster_misses: i64 = 0

fn glyph_raster_cache_hits() -> i64:
    _glyph_raster_hits

fn glyph_raster_cache_misses() -> i64:
    _glyph_raster_misses

fn _glyph_raster_cache_reset_for_test():
    """Test-only: clear entries AND counters so a spec gets a cold cache."""
    _glyph_raster_keys = []
    _glyph_raster_values = []
    _glyph_raster_cursor = 0
    _glyph_raster_hits = 0
    _glyph_raster_misses = 0

# Referenced by the shared mutex helpers below. Keep this declaration before
# first use because SMF semantic compilation resolves module globals in order.
var _registered_selected_fonts_only: bool = false

fn _font_mutex_acquire(current: Mutex?) -> Mutex:
    # No `if val` binding here: under freestanding/entry-closure/aggressive-opt
    # kernel builds, real Mutex.lock()/unlock() calls on these facade locks
    # fault (cr2=0x0) on their very first use during boot (verified: fault RIP
    # resolves inside Mutex.lock/unlock, backtrace through this function and
    # font_renderer_use_registered_selected_bytes_only -> spl_start). This
    # facade is only used single-threaded there (kernel boot / one browser
    # process — see font_renderer_use_registered_selected_bytes_only), so once
    # that mode is active we skip the real lock/unlock syscalls entirely.
    if current == nil:
        val fresh = mutex_new(0)
        if not _registered_selected_fonts_only:
            fresh.lock()
        return fresh
    val active = current.?
    if not _registered_selected_fonts_only:
        active.lock()
    active

fn _font_mutex_release(current: Mutex?):
    if current == nil:
        return
    val active = current.?
    if not _registered_selected_fonts_only:
        active.unlock(0)

fn _resolved_font_metric_lock_acquire():
    _resolved_font_metric_lock = _font_mutex_acquire(_resolved_font_metric_lock)

fn _resolved_font_metric_lock_release():
    _font_mutex_release(_resolved_font_metric_lock)

fn _resolved_font_metric_key(family: text, content: text, font_size: i32, identity: text) -> text:
    _resolved_font_metric_language_key(family, content, font_size, identity, "und")

fn _resolved_font_metric_language_key(family: text, content: text, font_size: i32, identity: text, language: text) -> text:
    _resolved_font_metric_language_config_key(
        family, content, font_size, identity, language,
        font_render_config_identity(font_render_config_default_for_size(font_size))
    )

fn _resolved_font_metric_language_config_key(family: text, content: text, font_size: i32,
                                             identity: text, language: text,
                                             render_config_identity: text) -> text:
    family.trim().lower() + "\n" + font_size.to_string() + "\n" + language.trim().lower() + "\n" +
        identity.len().to_string() + ":" + identity + "\n" +
        render_config_identity.len().to_string() + ":" + render_config_identity + "\n" + content

fn _resolved_font_metrics_cacheable(family: text, content: text) -> bool:
    family.len() <= RESOLVED_FONT_METRICS_CACHE_FAMILY_LIMIT and content.len() <= RESOLVED_FONT_METRICS_CACHE_CONTENT_LIMIT

fn _font_shaped_glyph_destination(pen_x: i32, pen_y: i32, glyph: CachedGlyph, ascent: i32) -> (bool, i32, i32):
    val x = pen_x.to_i64() + glyph.bearing_x.to_i64()
    val y = ascent.to_i64() + pen_y.to_i64() - glyph.bearing_y.to_i64() - glyph.height.to_i64()
    if x < -2147483648 or x > 2147483647 or y < -2147483648 or y > 2147483647:
        return (false, 0, 0)
    (true, x.to_i32(), y.to_i32())

fn _resolved_font_metric_cached(key: text) -> ResolvedFontMetrics?:
    _resolved_font_metric_lock_acquire()
    var index: i64 = 0
    while index < _resolved_font_metric_keys.len():
        if _resolved_font_metric_keys[index] == key:
            val found = _resolved_font_metric_values[index]
            _resolved_font_metric_hits = _resolved_font_metric_hits + 1
            _resolved_font_metric_lock_release(active_lock)
            return found
        index = index + 1
    _resolved_font_metric_misses = _resolved_font_metric_misses + 1
    _resolved_font_metric_lock_release(active_lock)
    nil

fn resolved_font_metric_cache_hits() -> i64:
    _resolved_font_metric_hits

fn resolved_font_metric_cache_misses() -> i64:
    _resolved_font_metric_misses

fn _resolved_font_metric_cache_reset_for_test():
    """Test-only: clear entries AND counters so a spec gets a cold cache."""
    _resolved_font_metric_keys = []
    _resolved_font_metric_values = []
    _resolved_font_metric_cursor = 0
    _resolved_font_metric_hits = 0
    _resolved_font_metric_misses = 0

fn _resolved_font_metric_store(key: text, metrics: ResolvedFontMetrics):
    _resolved_font_metric_lock_acquire()
    if _resolved_font_metric_keys.len() < RESOLVED_FONT_METRICS_CACHE_LIMIT:
        _resolved_font_metric_keys.push(key)
        _resolved_font_metric_values.push(metrics)
        _resolved_font_metric_lock_release()
        return
    _resolved_font_metric_keys[_resolved_font_metric_cursor] = key
    _resolved_font_metric_values[_resolved_font_metric_cursor] = metrics
    _resolved_font_metric_cursor = (_resolved_font_metric_cursor + 1) % RESOLVED_FONT_METRICS_CACHE_LIMIT
    _resolved_font_metric_lock_release()

# Loaded-default-font cache keyed by resolved family. browser_default_for_family
# does a real dlopen + TTF parse (the universal sans face is 17MB), so without
# reuse every #text node reparses the whole font — quadratic for a real page and
# the dominant web-render cost under the interpreter.
#
# FLATTENED (2026-07-30, see doc/08_tracking/bug/
# font_renderer_cache_nested_aggregate_loss_2026-07-27.md): this cache used to
# store a whole `FontRenderer` BY VALUE in `[FontRenderer]`. `FontRenderer`
# nests `ttf_rasterizer: FontRasterizer?` -> `selected_blob: [u8]`, and that
# nested aggregate did NOT survive the module-global store/read-back on the
# cranelift native lane — measured has_ttf=0 on 74/74 observed cache hits
# (117/118 metric resolves overall). The array itself persisted and was hit;
# only the nested face payload degraded. Root cause is the compiler's
# aggregate-return/nested-array-field store/read-back defect (still latent —
# this is a call-site workaround, not a compiler fix). Do NOT re-nest a
# FontRenderer/FontRasterizer into a module-global array; cache only flat
# scalars/text (family key, resolved font path) and reconstruct a fresh
# FontRenderer from the already-in-memory registered blob on every cache hit
# via `_browser_default_font_rebuild_from_path`.
var _browser_default_font_families: [text] = []
var _browser_default_font_paths: [text] = []
var _registered_selected_font_paths: [text] = []
var _registered_selected_font_blobs: [[u8]] = []
var _registered_selected_fonts_only: bool = false
var _browser_default_font_lock: Mutex? = mutex_new(0)

fn _browser_default_font_lock_acquire():
    _browser_default_font_lock = _font_mutex_acquire(_browser_default_font_lock)

fn _browser_default_font_lock_release():
    _font_mutex_release(_browser_default_font_lock)

fn _browser_default_font_cache_key(family: text) -> text:
    if family.trim().starts_with("__simple_font_face__|"):
        return ""
    val candidates = browser_font_candidates_for_family(family)
    if candidates.len() == 0:
        return ""
    candidates[0]

fn _registered_selected_font_bytes(path: text) -> ([u8], bool):
    _browser_default_font_lock_acquire()
    var index: i64 = 0
    while index < _registered_selected_font_paths.len():
        if _registered_selected_font_paths[index] == path:
            val blob = _registered_selected_font_blobs[index]
            _browser_default_font_lock_release()
            return (blob, true)
        index = index + 1
    _browser_default_font_lock_release()
    ([], false)

fn font_renderer_registered_selected_bytes_only() -> bool:
    _browser_default_font_lock_acquire()
    val enabled = _registered_selected_fonts_only
    _browser_default_font_lock_release()
    enabled

fn font_renderer_use_registered_selected_bytes_only():
    """Keep freestanding consumers away from host-only file externs."""
    # Flip the flag BEFORE the first lock use: _font_mutex_acquire/_release
    # skip the real Mutex.lock()/unlock() once this is true (see their
    # comments) — the very first acquire below would otherwise fault before
    # the flag is observable.
    _registered_selected_fonts_only = true
    val browser_lock = _browser_default_font_lock_acquire()
    # No cached FontRenderer instances to clear_ttf() any more — the cache is
    # flat (family, path) text pairs (see the FLATTENED comment above), so
    # resetting it is just dropping the two arrays.
    _browser_default_font_families = []
    _browser_default_font_paths = []
    _browser_default_font_lock_release(browser_lock)
    val metric_lock = _resolved_font_metric_lock_acquire()
    _resolved_font_metric_keys = []
    _resolved_font_metric_values = []
    _resolved_font_metric_cursor = 0
    _resolved_font_metric_lock_release(metric_lock)

fn _font_renderer_reset_registered_selected_bytes_for_test():
    """Reset process-global registered face state between unit scenarios."""
    _registered_selected_font_paths = []
    _registered_selected_font_blobs = []
    _registered_selected_fonts_only = false
    _last_selected_registration_reason = ""

# Receipt for the LAST font_renderer_register_selected_bytes call. A module
# global scalar/text, not a returned aggregate: the baremetal lane loses
# returned aggregates (see the FLATTENED notes above), and the caller is a
# kernel entry that reads its receipts back one scalar at a time. Diagnostics
# only — nothing branches on this value.
var _last_selected_registration_reason: text = ""

fn font_renderer_last_selected_registration_reason() -> text:
    """Why the last register_selected_bytes call refused, or "" when it
    accepted. `unmanaged` (path not in the pinned catalog), `identity`
    (loaded but identity mismatch), `runtime` (validation passed, the sfnt
    runtime probe refused), or the validator's own reason: `byte-length`,
    `sha256`, `default-axes`, `format`, `tables`, `names`."""
    _last_selected_registration_reason

fn font_renderer_register_selected_bytes(path: text, blob: [u8]) -> bool:
    """Register exact pinned bytes for producer metrics and executor loading."""
    # Path-based identity instead of `candidate.?` + field access: unwrapping
    # the Option-returning candidate lookup and touching fields faults on
    # baremetal (cr2=0x0 class, 2026-07-18); "" doubles as the unmanaged gate.
    _last_selected_registration_reason = ""
    val expected_identity: text = selected_font_asset_identity_for_path(path)
    if expected_identity == "":
        _last_selected_registration_reason = "unmanaged"
        return false
    var renderer = FontRenderer.new()
    if not renderer.try_load_selected_bytes(path, blob):
        # Diagnostics only: the load path (spl_fonts `_load_selected_bytes`)
        # reduces the validation to `.valid` and drops `.reason`, so recompute
        # it HERE, on the refusal path only, to name which gate refused. When
        # validation itself says valid the refusal came from the later
        # `font_runtime_ttf_default_supported` probe instead.
        val refusal = validate_selected_font_asset(path, blob)
        _last_selected_registration_reason = if refusal.valid: "runtime" else: refusal.reason
        return false
    val identity = renderer.current_font_identity()
    renderer.clear_ttf()
    if identity != expected_identity:
        _last_selected_registration_reason = "identity"
        return false
    _browser_default_font_lock_acquire()
    for registered_path in _registered_selected_font_paths:
        if registered_path == path:
            _browser_default_font_lock_release()
            return true
    _registered_selected_font_paths.push(path)
    _registered_selected_font_blobs.push(blob)
    _browser_default_font_lock_release()
    true

fn _browser_default_for_family_cached(family: text) -> (FontRenderer, bool):
    val cache_key = _browser_default_font_cache_key(family)
    if cache_key != "":
        val active_lock = _browser_default_font_lock_acquire()
        var index: i64 = 0
        var hit_path = ""
        var found = false
        while index < _browser_default_font_families.len():
            if _browser_default_font_families[index] == cache_key:
                hit_path = _browser_default_font_paths[index]
                found = true
                index = _browser_default_font_families.len()
            else:
                index = index + 1
        _browser_default_font_lock_release(active_lock)
        if found and hit_path != "":
            val rebuilt = _browser_default_font_rebuild_from_path(hit_path)
            if rebuilt.1:
                return (rebuilt.0, true)
    val loaded = _browser_default_font_load_with_path(family)
    val renderer = loaded.0
    val resolved_path = loaded.1
    if cache_key != "" and resolved_path != "" and renderer.has_sffi_ttf():
        val store_lock = _browser_default_font_lock_acquire()
        _browser_default_font_families = _browser_default_font_families.push(cache_key)
        _browser_default_font_paths = _browser_default_font_paths.push(resolved_path)
        _browser_default_font_lock_release(store_lock)
    (renderer, false)

# GLYPH-FIX-3 (2026-07-19): gated producer-side atlas probe. Prints the
# nonzero-coverage-byte count for the first quad's atlas region right before
# the batch (containing atlas_pixels: [u32]) crosses the nogc_sync_mut ->
# gc_async_mut module/layer boundary into Engine2D. Compared against the
# mirrored consumer-side probe in engine.spl to localize whether atlas
# coverage is lost before or during that cross-layer struct transfer.
val _VEC_ATLAS_PROBE: bool = false
var _vec_atlas_probe_count: i32 = 0
var _vec_glyph_probe_count: i32 = 0

# See doc/08_tracking/bug/font_render_batch_transform_identity_default_not_applied_2026-07-19.md:
# FontRenderBatch.transform_identity's class-field default reads back empty
# on freestanding native-build, which fails material_supported() and blocks
# all glyph compositing. Every FontRenderBatch(...) construction site in this
# file sets transform_identity explicitly to this constant instead of relying
# on the (unreliable, on this target) class default; the class default itself
# is left in place in font_types.spl for hosted builds.
val FONT_RENDER_TRANSFORM_IDENTITY: text = "uniform-scale;translate-late"

val FONT_ATLAS_WIDTH: i32 = 1024
val FONT_ATLAS_HEIGHT: i32 = 1024
# The scalar stays literal-initialized for freestanding startup. Its dedicated
# facade mutex is eager on hosted builds and lazy on the single-core baremetal
# path, matching the cache locks above.
var _font_atlas_dependency_generation_counter: i64 = 0
var _font_atlas_dependency_generation_lock: Mutex? = mutex_new(0)

fn _font_render_batch_with_config(batch: FontRenderBatch, config: FontRenderConfig) -> FontRenderBatch:
    FontRenderBatch(
        program_version: batch.program_version, font_identity: batch.font_identity,
        face_generation: batch.face_generation, valid: batch.valid,
        atlas_width: batch.atlas_width, atlas_height: batch.atlas_height,
        atlas_pixels: batch.atlas_pixels, quads: batch.quads,
        atlas_generation: batch.atlas_generation, dirty_rects: batch.dirty_rects,
        render_config_identity: font_render_config_identity(config), transform_identity: FONT_RENDER_TRANSFORM_IDENTITY,
        execution_target: font_render_config_normalize(config.execution_target),
        execution_policy: config.execution_policy
    )

fn _font_render_batch_with_config(batch: FontRenderBatch, config: FontRenderConfig) -> FontRenderBatch:
    FontRenderBatch(
        program_version: batch.program_version, font_identity: batch.font_identity,
        face_generation: batch.face_generation, valid: batch.valid,
        atlas_width: batch.atlas_width, atlas_height: batch.atlas_height,
        atlas_pixels: batch.atlas_pixels, quads: batch.quads,
        atlas_generation: batch.atlas_generation, dirty_rects: batch.dirty_rects,
        render_config_identity: font_render_config_identity(config), transform_identity: FONT_RENDER_TRANSFORM_IDENTITY,
        execution_target: font_render_config_normalize(config.execution_target),
        execution_policy: config.execution_policy
    )

fn _font_render_config_default_selection(config: FontRenderConfig) -> bool:
    # Sequential explicit gates, not one parenthesized mixed `and` chain: the
    # freestanding entry-closure codegen drops left operands of mixed boolean
    # chains (fourth confirmed site 2026-08-11 — this predicate, reached only
    # through font_render_config_selection_supported's own mixed and/or chain,
    # rejected the healthy default config while font_render_config_valid on
    # the SAME config object passed in the immediately preceding statement:
    # `[e2d-batch] selection-unsupported text_len=11` with no
    # `[font-plan] config-invalid`). Semantics identical on healthy compilers.
    if font_render_config_normalize(config.family) != "auto":
        return false
    if font_render_category_name(config.category) != "auto":
        return false
    if font_render_config_normalize(config.language) != "und":
        return false
    if font_render_config_normalize(config.script) != "auto":
        return false
    true

fn _font_render_config_candidate(config: FontRenderConfig) -> FontAssetCandidate?:
    if _font_render_config_default_selection(config):
        return nil
    val normalized_language = font_render_config_normalize(config.language)
    val language_parts = normalized_language.split("-")
    if language_parts.len() == 0 or language_parts[0] == "":
        return nil
    val language = language_parts[0]
    val category = font_render_category_name(config.category)
    if language == "und" or category == "auto":
        return nil
    val selected = selected_font_asset_for_language_category(language, category)
    if selected == nil:
        return nil
    val candidate = selected.?
    val family = font_render_config_normalize(config.family)
    if family != "auto" and family != candidate.family.lower():
        return nil
    var expected_script = ""
    for rank in selected_font_language_ranks():
        if rank.language == language:
            expected_script = rank.likely_script.lower()
    val script = font_render_config_normalize(config.script)
    if expected_script == "" or (script != "auto" and script != expected_script):
        return nil
    candidate

fn font_render_config_selection_supported(config: FontRenderConfig) -> bool:
    # Sequential explicit gates with per-gate receipts, not one mixed and/or
    # chain. ROOT CAUSE (2026-08-11, rung-(d) blocker): on the freestanding
    # entry-closure lane this single expression returned false for a config
    # that `font_render_config_valid` — its own first conjunct — had just
    # accepted inside font_execution_plan_into two statements earlier
    # (plan_count>0, no `[font-plan] config-invalid` receipt). That is the
    # documented mixed-boolean-chain codegen defect, same family as the three
    # sites already decomposed in font_types.spl. Every text Draw IR command
    # was skipped as `text-font-batch` because of it (skipped=8 rendered=12).
    # Semantics are identical on a healthy compiler; the receipts stay silent
    # on healthy configs and attribute WHICH gate rejected otherwise.
    if not font_render_config_valid(config):
        print("[font-select] config-invalid size={config.size} target={config.execution_target}")
        return false
    if _font_render_config_default_selection(config):
        return true
    val candidate = _font_render_config_candidate(config)
    if candidate == nil:
        print("[font-select] no-candidate family='{config.family}' category='{config.category}' language='{config.language}' script='{config.script}'")
        return false
    true

fn _font_atlas_dependency_generation_after(current: i64) -> i64:
    if current < 0 or current >= 9223372036854775807:
        return 0
    current + 1

fn _next_font_atlas_dependency_generation() -> i64:
    _font_atlas_dependency_generation_lock = _font_mutex_acquire(_font_atlas_dependency_generation_lock)
    val next = _font_atlas_dependency_generation_after(_font_atlas_dependency_generation_counter)
    _font_atlas_dependency_generation_counter = next
    _font_mutex_release(_font_atlas_dependency_generation_lock)
    next

class GlyphCache:
    entries: [CachedGlyph]
    max_entries: i32

    static fn new(max_size: i32) -> GlyphCache:
        GlyphCache(entries: [], max_entries: max_size)

    fn lookup(codepoint: i32, font_size: i32) -> CachedGlyph?:
        for entry in self.entries:
            if entry.codepoint == codepoint and entry.font_size == font_size:
                return entry
        nil

    me insert(glyph: CachedGlyph):
        # Evict oldest if cache full
        if self.entries.len() >= self.max_entries:
            self.entries = self.entries.slice(1, self.entries.len())
        self.entries.push(glyph)

# ============================================================================
# Font Renderer
# ============================================================================

class FontRenderer:
    cache: GlyphCache
    ttf_handle: i64     # TrueType font handle (0 = not loaded)
    use_vector: bool     # enable vector font fallback
    use_bitmap: bool     # enable bitmap font fallback
    ttf_rasterizer: FontRasterizer?  # Phase 3b: SFFI spl_fonts TTF backend (nil = disabled)

    static fn new() -> FontRenderer:
        FontRenderer(
            cache: GlyphCache.new(512),
            ttf_handle: 0,
            use_vector: true,
            use_bitmap: true,
            ttf_rasterizer: nil
        )

    static fn with_ttf(handle: i64) -> FontRenderer:
        FontRenderer(
            cache: GlyphCache.new(512),
            ttf_handle: handle,
            use_vector: true,
            use_bitmap: true,
            ttf_rasterizer: nil
        )

    static fn browser_serif_default() -> FontRenderer:
        FontRenderer.browser_default_for_family("serif")

    static fn browser_default_for_family(family: text) -> FontRenderer:
        var renderer = FontRenderer.new()
        for font_path in browser_font_candidates_for_family(family):
            for dylib_path in browser_font_dylib_candidates():
                if renderer.try_enable_ttf(dylib_path, font_path):
                    return renderer
        renderer

    fn has_ttf() -> bool:
        self.ttf_handle > 0

    # -----------------------------------------------------------------------
    # Phase 3b: opt-in SFFI spl_fonts TrueType backend
    # -----------------------------------------------------------------------
    # Attempts to load `dylib_path` and initialize it with `ttf_path`. On
    # success the renderer will prefer the SFFI spl_fonts rasterizer for
    # glyphs (highest-priority backend). On any failure the renderer stays
    # in its default state and callers fall through to the vector/bitmap
    # paths unchanged. Caller opt-in only — default FontRenderer.new()
    # instances behave exactly as before.
    me try_enable_ttf(dylib_path: text, ttf_path: text) -> bool:
        val r = FontRasterizer.load(dylib_path, ttf_path)
        if r != nil:
            self.ttf_rasterizer = r
            return true
        false

    me try_enable_browser_serif_default() -> bool:
        for dylib_path in browser_font_dylib_candidates():
            for font_path in browser_serif_font_candidates():
                if self.try_enable_ttf(dylib_path, font_path):
                    return true
        false

    fn has_sffi_ttf() -> bool:
        self.ttf_rasterizer != nil

    me horizontal_kern(left_codepoint: i32, right_codepoint: i32, font_size: i32) -> i32:
        val rast = self.ttf_rasterizer
        if rast != nil:
            return rast.horizontal_kern(left_codepoint.to_i64(), right_codepoint.to_i64(), font_size.to_i64()).to_i32()
        0

    me horizontal_line_metric(font_size: i32, field: i32) -> i32:
        val rast = self.ttf_rasterizer
        if rast != nil:
            return rast.horizontal_line_metric(font_size.to_i64(), field.to_i64()).to_i32()
        0

    me layout_text(content: text, font_size: i32, max_width: i32) -> [LayoutGlyph]:
        val rast = self.ttf_rasterizer
        if rast != nil:
            return rast.layout_text(content, font_size.to_i64(), max_width.to_i64())
        []

    me rasterize_subpixel(codepoint: i32, font_size: i32) -> SubpixelGlyphBitmap?:
        val rast = self.ttf_rasterizer
        if rast != nil:
            return rast.rasterize_subpixel(codepoint.to_i64(), font_size.to_i64())
        nil

    # -----------------------------------------------------------------------
    # Get glyph (cached) — returns rasterized alpha bitmap
    # -----------------------------------------------------------------------
    me get_glyph(codepoint: i32, font_size: i32) -> CachedGlyph:
        # Check cache first
        val cached = cache.lookup(codepoint, font_size)
        # `if val Some(...)` narrowing — NOT `.unwrap()` and NOT bare field
        # access: the runtime value's Option wrapping depends on provenance
        # (fresh lookups wrap; cross-instance raster-cache values are RAW
        # CachedGlyph), so each of the other two idioms crashes on one side.
        # See doc/08_tracking/bug/
        # font_renderer_cached_glyph_unwrap_semantic_crash_2026-08-15.md.
        if val Some(cached_glyph) = cached:
            self.glyph_phase_cache_hit = true
            if cached_glyph.width > 0 and cached_glyph.height > 0:
                self.glyph_phase_cache_hit_positive = true
                self.glyph_phase_return_positive = true
            self.cache = cache
            return cached_glyph

        # Cross-instance glyph-raster cache (T12, render-perf replan
        # 2026-08-07) -- keyed by rasterizer identity + codepoint + size.
        # Independent of the per-instance `cache` above, which only survives
        # repeat calls on the SAME FontRenderer instance; this one also
        # serves fresh instances (the browser_default_for_family production
        # shape, where a new FontRenderer is built per text node). The push
        # below happens INLINE in this method body (never delegated to a
        # separate free-function push helper) -- see the comment on
        # `_glyph_raster_keys` above for why that boundary matters.
        val raster_identity = if active_rasterizer != nil: active_rasterizer.cache_identity() else: ""
        val raster_key = "{raster_identity};cp={codepoint};fs={font_size}"
        var raster_idx = 0
        var raster_hit: CachedGlyph? = nil
        while raster_idx < _glyph_raster_keys.len():
            if _glyph_raster_keys[raster_idx] == raster_key:
                raster_hit = _glyph_raster_values[raster_idx]
            raster_idx = raster_idx + 1
        # Same dual-provenance narrowing as the cache.lookup hit above —
        # values in _glyph_raster_values are stored RAW.
        if val Some(raster_glyph) = raster_hit:
            _glyph_raster_hits = _glyph_raster_hits + 1
            cache.insert(raster_glyph)
            self.cache = cache
            if raster_glyph.width > 0 and raster_glyph.height > 0:
                self.glyph_phase_return_positive = true
            return raster_glyph
        _glyph_raster_misses = _glyph_raster_misses + 1

        # Rasterize
        var glyph = CachedGlyph.empty(codepoint, font_size)

        # Phase 3b: prefer SFFI spl_fonts TrueType backend when the caller
        # has opted in via try_enable_ttf(). Any failure falls through to
        # the existing vector/bitmap path unchanged. Under the interpreter,
        # static-fn Option<T> returns are typed as T directly, so we use
        # `!= nil` rather than `if val Some(x) =` destructuring.
        var handled = false
        val rast = self.ttf_rasterizer
        if rast != nil:
            val gb = rast.rasterize(codepoint.to_i64(), font_size.to_i64())
            if gb != nil:
                glyph = _sffi_glyph_to_cached(gb, codepoint, font_size)
                handled = true

        if not handled:
            if self.has_ttf():
                glyph = rasterize_ttf(self.ttf_handle, codepoint, font_size)
            else if self.use_vector:
                val vector_cmds = vf_glyph_commands(codepoint)
                if vector_cmds.len() > 0:
                    glyph = rasterize_vector(vector_cmds, codepoint, font_size)
                else if self.use_bitmap:
                    glyph = rasterize_bitmap(codepoint, font_size)
            else if self.use_bitmap:
                glyph = rasterize_bitmap(codepoint, font_size)

        # GLYPH-FIX-4 checkpoint probe: last print before cache.insert(glyph)
        # / the (glyph, cache) tuple return / get_glyph's unpack. `glyph`
        # here is a same-module local (freshly reconstructed above for the
        # SFFI path, or freshly returned by rasterize_ttf/vector/bitmap for
        # the fallback path) so this read is not expected to hit the
        # cross-module landmine above -- if the fault still reproduces AFTER
        # this probe prints, it names cache.insert/the tuple return/
        # get_glyph's unpack as the real site instead.
        if _VEC_ATLAS_PROBE and _vec_glyph_probe_count < 8:
            _vec_glyph_probe_count = _vec_glyph_probe_count + 1
            print("[vec-glyph-probe] gwc-pre-insert cp={codepoint} w={glyph.width} h={glyph.height} adv={glyph.advance} plen={glyph.pixels.len()}")
        val expected_pixels = glyph.width.to_i64() * glyph.height.to_i64()
        if glyph.advance > 0 and expected_pixels == glyph.pixels.len().to_i64():
            cache.insert(glyph)
        if glyph.width > 0 and glyph.height > 0:
            self.glyph_phase_return_positive = true
            # Store into the cross-instance glyph-raster cache -- inline
            # push/ring-overwrite, same method body that owns the globals.
            if _glyph_raster_keys.len() < GLYPH_RASTER_CACHE_LIMIT:
                _glyph_raster_keys = _glyph_raster_keys.push(raster_key)
                _glyph_raster_values = _glyph_raster_values.push(glyph)
            else:
                _glyph_raster_keys[_glyph_raster_cursor] = raster_key
                _glyph_raster_values[_glyph_raster_cursor] = glyph
                _glyph_raster_cursor = (_glyph_raster_cursor + 1) % GLYPH_RASTER_CACHE_LIMIT
        self.cache = cache
        glyph

    # -----------------------------------------------------------------------
    # Metrics-only glyph advance — measurement needs no pixels
    # -----------------------------------------------------------------------
    # `measure_text_advances`/`measure_text_width` only ever read `.advance`,
    # but calling `get_glyph` above to get it always rasterizes a full alpha
    # bitmap first. For outline/vector glyphs that rasterization cost scales
    # with the pixel-buffer area (~font_size^2), which is why a single 100px
    # glyph could cost hundreds of milliseconds and a run of them tens of
    # seconds. This mirrors get_glyph's backend-priority order but calls only
    # the metrics half of each backend and never the pixel-render half, and
    # it never writes to `self.cache` -- caching an advance-only entry with
    # no pixels would make a later real render of the same glyph draw blank.
    #
    # The selected/registered outline blob backend (the one exercised by the
    # web renderer's pinned Bungee-style fonts) is handled directly here:
    # `sfnt_measure_glyph_into` computes width/height/advance/bearing purely
    # from the `hmtx`/`glyf` tables -- it never touches pixel coverage. Only
    # `sfnt_render_glyph_into` does the O(width*height) coverage scan, and
    # this path never calls it. Every other backend either has a genuine
    # metrics-only extern (`rt_font_glyph_advance` for the legacy rt_font_load
    # handle path) or a closed-form advance formula identical to what its
    # rasterizer would have computed (vector/bitmap fallbacks); the one
    # backend with no metrics-only entry point (the SFFI spl_fonts dylib,
    # whose `rt_fonts_glyph_metric` only reads a handle produced by a prior
    # rasterize call) falls back to the full get_glyph call unchanged.
    me get_glyph_advance(codepoint: i32, font_size: i32) -> i32:
        if codepoint < 0 or codepoint > 1114111 or font_size <= 0 or font_size > 512:
            return 0
        var cache = self.cache
        val active_rasterizer = self.ttf_rasterizer
        val _adv_identity: text = if active_rasterizer != nil: active_rasterizer.cache_identity() else: ""
        # Bounded advance-cache fast path (2026-07-29): short-circuits the
        # per-instance GlyphCache lookup AND, on the SFFI-dylib-without-
        # selected-blob backend, the full pixel rasterize that backend's
        # get_glyph_advance fallthrough otherwise pays just to read
        # `.advance` (see the module-level comment above). Valid across
        # every FontRenderer instance sharing the same loaded face.
        if _adv_identity != "":
            val _adv_fast = _adv_cache_lookup(_adv_identity, font_size, codepoint)
            if _adv_fast > 0:
                return _adv_fast
        if active_rasterizer != nil:
            cache.sync_face_identity(active_rasterizer.cache_identity_generation(), _adv_identity)
        val cached = cache.lookup(codepoint, font_size)
        self.cache = cache
        # `if val Some(...)` narrowing — NOT `.unwrap()`: the runtime value's
        # Option wrapping depends on provenance (a fresh lookup wraps; the
        # cross-instance raster cache stores RAW CachedGlyph), so `.unwrap()`
        # crashed on cache hits and bare field access crashed on wrapped
        # values. Pattern-match narrowing handles both. See doc/08_tracking/
        # bug/font_renderer_cached_glyph_unwrap_semantic_crash_2026-08-15.md.
        if val Some(cached_adv) = cached:
            _adv_cache_store(_adv_identity, font_size, codepoint, cached_adv.advance)
            return cached_adv.advance

        val rast_has_glyph = active_rasterizer != nil and active_rasterizer.has_glyph(codepoint.to_i64())
        if rast_has_glyph:
            if self.selected_outline_blob.len() > 0:
                var direct_meta: [i64] = [0; 20]
                sfnt_measure_glyph_into(self.selected_outline_blob, SFNT_GLYPH_SELECTOR_CODEPOINT, codepoint.to_i64(), font_size.to_i64(), direct_meta)
                if direct_meta[7] == 310031:
                    val direct_width = direct_meta[0] as i32
                    val direct_advance_raw = direct_meta[2] as i32
                    val _adv_direct = if direct_advance_raw > 0: direct_advance_raw else: direct_width + 1
                    _adv_cache_store(_adv_identity, font_size, codepoint, _adv_direct)
                    return _adv_direct
            # SFFI dylib backend (or a measure failure on the selected blob):
            # no metrics-only entry point exists, fall back unchanged.
            val _gfp_result = self.get_glyph(codepoint, font_size).advance
            _adv_cache_store(_adv_identity, font_size, codepoint, _gfp_result)
            return _gfp_result

        if self.has_ttf():
            val _gfp_result2 = rt_font_glyph_advance(self.ttf_handle, codepoint.to_i64(), font_size.to_f64()).to_i32()
            _adv_cache_store(_adv_identity, font_size, codepoint, _gfp_result2)
            return _gfp_result2
        if self.use_vector:
            val vector_cmds = vf_glyph_commands(codepoint)
            if vector_cmds.len() > 0:
                glyph = rasterize_vector_accelerated(vector_cmds, codepoint, font_size)
            else if self.use_bitmap:
                glyph = rasterize_bitmap_accelerated(codepoint, font_size)
        else if self.use_bitmap:
            glyph = rasterize_bitmap_accelerated(codepoint, font_size)

        self.cache.insert(glyph)
        glyph

    # -----------------------------------------------------------------------
    # Measure text width using actual glyph advances
    # -----------------------------------------------------------------------
    me measure_text_width(content: text, font_size: i32) -> i32:
        var total_w = 0
        var prev_cp = -1
        var cache = self.cache
        # indexed loop: for-in over text yields corrupted bindings (doc/08_tracking/bug/for_loop_over_text_char_code_at_zero_len_crash_2026-07-19.md)
        var ci = 0
        val content_cps = text_codepoints(content)
        val content_len = content_cps.len()
        while ci < content_len:
            val cp = content_cps[ci] as i32
            if prev_cp >= 0:
                total_w = total_w + self.horizontal_kern(prev_cp, cp, font_size)
            val glyph = self.get_glyph(cp, font_size)
            if glyph.advance > 0:
                total_w = total_w + glyph.advance
            else:
                # Fallback: approximate
                total_w = total_w + font_size * 55 / 100
            prev_cp = cp
        total_w

    me measure_text_advances(content: text, font_size: i32) -> [i32]:
        var advances: [i32] = []
        var prev_cp = -1
        var cache = self.cache
        # indexed loop: for-in over text yields corrupted bindings (doc/08_tracking/bug/for_loop_over_text_char_code_at_zero_len_crash_2026-07-19.md)
        var ci = 0
        val content_cps = text_codepoints(content)
        val content_len = content_cps.len()
        while ci < content_len:
            val cp = content_cps[ci] as i32
            if prev_cp >= 0:
                val previous = advances.len() - 1
                advances[previous] = advances[previous] + self.horizontal_kern(prev_cp, cp, font_size)
            val result = self.glyph_with_cache(cp, font_size, cache)
            cache = result.1
            val glyph_advance = result.0.advance
            val advance = if glyph_advance > 0: glyph_advance else: font_size * 55 / 100
            advances.push(advance)
            prev_cp = cp
            ci = ci + 1
        self.cache = cache
        advances

    # -----------------------------------------------------------------------
    # Render text into a pixel buffer (ARGB u32)
    # -----------------------------------------------------------------------
    me render_text(buffer: [u32], buf_w: i32, buf_h: i32,
                   x: i32, y: i32, content: text,
                   color: u32, font_size: i32) -> [u32]:
        """Render text string into an ARGB pixel buffer with anti-aliased glyphs."""
        var out = buffer
        var cx = x
        var prev_cp = -1
        var cache = self.cache
        # indexed loop: for-in over text yields corrupted bindings (doc/08_tracking/bug/for_loop_over_text_char_code_at_zero_len_crash_2026-07-19.md)
        var ci = 0
        val content_cps = text_codepoints(content)
        val content_len = content_cps.len()
        while ci < content_len:
            val cp = content_cps[ci] as i32
            if prev_cp >= 0:
                cx = cx + self.horizontal_kern(prev_cp, cp, font_size)
            val result = self.glyph_with_cache(cp, font_size, cache)
            val glyph = result.0
            cache = result.1
            if glyph.width > 0 and glyph.height > 0:
                out = blit_glyph(out, buf_w, buf_h, cx, y, glyph, color)
            cx = cx + glyph.advance
            prev_cp = cp
        out

    me render_text_payload(content: text, color: u32, font_size: i32) -> FontTextPayload:
        if font_size <= 0 or font_size > 512:
            return FontTextPayload(valid: false, width: 0, height: 0, offset_x: 0, offset_y: 0, pixels: [])
        if content == "":
            return FontTextPayload(valid: true, width: 0, height: 0, offset_x: 0, offset_y: 0, pixels: [])
        var layout = self.layout_text(content, font_size, 0)
        if layout.len() == 0 and (self.use_vector or self.use_bitmap):
            var fallback_x: i64 = 0
            var fallback_byte_offset: i64 = 0
            # indexed loop: for-in over text yields corrupted bindings (doc/08_tracking/bug/for_loop_over_text_char_code_at_zero_len_crash_2026-07-19.md)
            var ci = 0
            val content_cps = text_codepoints(content)
            val content_len = content_cps.len()
            while ci < content_len:
                val codepoint = content_cps[ci] as i32
                val glyph = self.get_glyph(codepoint, font_size)
                layout.push(LayoutGlyph(
                    codepoint: codepoint.to_i64(), x: fallback_x, y: 0,
                    width: glyph.width.to_i64(), height: glyph.height.to_i64(),
                    byte_offset: fallback_byte_offset
                ))
                fallback_x = fallback_x + glyph.advance.to_i64()
                fallback_byte_offset = fallback_byte_offset + ch.len().to_i64()
        if layout.len() == 0:
            return FontTextPayload(valid: false, width: 0, height: 0, offset_x: 0, offset_y: 0, pixels: [])
        var glyphs: [CachedGlyph] = []
        var min_x = 2147483647
        var min_y = 2147483647
        var max_x = -2147483647
        var max_y = -2147483647
        var cache = self.cache
        var i = 0
        while i < layout.len():
            val positioned = layout[i]
            val result = self.glyph_with_cache(positioned.codepoint.to_i32(), font_size, cache)
            val glyph = result.0
            cache = result.1
            glyphs.push(glyph)
            if glyph.width > 0 and glyph.height > 0:
                val gx = positioned.x.to_i32()
                val gy = positioned.y.to_i32()
                if gx < min_x:
                    min_x = gx
                if gy < min_y:
                    min_y = gy
                if gx + glyph.width > max_x:
                    max_x = gx + glyph.width
                if gy + glyph.height > max_y:
                    max_y = gy + glyph.height
            i = i + 1
        self.cache = cache
        if max_x <= min_x or max_y <= min_y:
            return FontTextPayload(valid: true, width: 0, height: 0, offset_x: 0, offset_y: 0, pixels: [])
        val width = max_x - min_x
        val height = max_y - min_y
        var pixels: [u32] = [0u32; width * height]
        val rgb = color & 0x00FFFFFFu32
        val color_alpha = ((color >> 24) & 0xFF).to_i32()
        i = 0
        while i < layout.len():
            val positioned = layout[i]
            val glyph = glyphs[i]
            val dst_x = positioned.x.to_i32() - min_x
            val dst_y = positioned.y.to_i32() - min_y
            var row = 0
            while row < glyph.height:
                var col = 0
                while col < glyph.width:
                    val src_idx = row * glyph.width + col
                    if src_idx < glyph.pixels.len():
                        val src_a = glyph.pixels[src_idx].to_i32() * color_alpha / 255
                        if src_a > 0:
                            val dst_idx = (dst_y + row) * width + dst_x + col
                            if dst_idx >= 0 and dst_idx < pixels.len():
                                val dst_a = ((pixels[dst_idx] >> 24) & 0xFF).to_i32()
