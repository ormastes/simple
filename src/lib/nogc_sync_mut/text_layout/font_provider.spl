use std.nogc_sync_mut.sffi.io.{dir_create_all, file_exists}
use std.common.encoding.sfnt.{font_face_spec_path}
use std.common.encoding.font_registry.{selected_font_asset_candidates, selected_font_asset_physical_path}

# `rt_process_run_timeout` is declared here rather than imported through
# `std.nogc_sync_mut.sffi.system.{process_run_timeout}` ON PURPOSE.
#
# This module is in the web renderer's import graph (font_provider ->
# font_renderer -> ..._foundation -> the whole browser engine). Pulling in
# Importing the broad `sffi.system` facade historically dragged a sleep extern
# with no Cranelift address into this graph. The canonical sleep surface is now
# a Simple wrapper over `std.io_runtime.thread_sleep`, but this module still
# keeps its one process extern local so unrelated system providers cannot grow
# the renderer closure. The old broad import caused a measured ~285x
# interpreter fallback for the CSS cascade.
#
# Declaring the one extern we actually use keeps that edge out of the graph.
# See doc/08_tracking/bug/web_render_budget_interpreter_gap_2026-07-25.md.
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

fn process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    rt_process_run_timeout(cmd, args, timeout_ms)

# Font Provider — browser font candidate lists, CSS @font-face URL parsing,
# font materialization (download / local resolution).
#
# Consumed by FontRenderer (font_renderer.spl). No dependency on rendering
# classes so it can also be used by build tools and test helpers.

# ============================================================================
# Font Backend Selection
# ============================================================================

enum FontBackend:
    TrueType
    Vector
    Bitmap

# ---------------------------------------------------------------------------
# Platform default faces
#
# A generic family is resolved by the HOST, not by the page: on macOS Chrome
# maps `monospace` to Menlo and `sans-serif` to Helvetica, and the whole web
# catalog declares nothing but `font: 16px/1.5 sans-serif` plus the UA's
# monospace for `<code>`. Measuring those runs against the bundled Noto faces
# is therefore comparing two DIFFERENT fonts and calling the difference a
# layout defect — Menlo's `M` is 1233/2048 em (9.633 px at 16) where Chrome
# measured exactly 9.63, and the bundled Noto Sans SC's static metrics are its
# wght=100 THIN master (the resolved identity says `axes=wght=100`), which is
# where the sans runs' −7%/−12% deficit came from.
#
# On Linux Chrome maps `sans-serif` to "Arial" (fontconfig: Liberation Sans)
# and `monospace` to "Monospace" (fontconfig: DejaVu Sans Mono); those faces
# follow the macOS ones, so a host offers only what it actually has.
#
# These are PREPENDED to the bundled lists, never replacing them: a face is
# offered only when its file is present, so a host without these files keeps
# exactly the bundled candidate order. `#N` selects a face of a TrueType collection.
fn _browser_present_platform_faces(specs: [text]) -> [text]:
    var out: [text] = []
    for spec in specs:
        if file_exists(font_face_spec_path(spec)):
            out.push(spec)
    out

# Hangul-capable host face (gap F, 2026-10-05). The bundled catalog has no
# Korean face (Noto Sans SC covers Han and kana only), so Hangul text falls
# back to this platform face when present; elsewhere it stays .notdef.
# AppleGothic, not AppleSDGothicNeo: the latter is CFF-flavoured ("OTTO")
# and the default glyf rasterizer rejects it (unsupported-sfnt-version).
fn browser_platform_hangul_faces() -> [text]:
    _browser_present_platform_faces(["/System/Library/Fonts/Supplemental/AppleGothic.ttf"])

fn browser_platform_mono_faces() -> [text]:
    _browser_present_platform_faces(["/System/Library/Fonts/Menlo.ttc#0", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"])

fn browser_platform_sans_faces() -> [text]:
    _browser_present_platform_faces(["/System/Library/Fonts/Helvetica.ttc#0", "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"])

# Weight >= 600 wants a real bold face, not a synthesised one. Helvetica.ttc
# face 1 is Helvetica Bold; its `abcdefg` run is 61.34 px at 16 against the
# regular face's 56.94, i.e. the +4 px delta Chrome shows and Simple measured
# as 0 because both weights resolved to the same face.
fn browser_platform_sans_bold_faces() -> [text]:
    _browser_present_platform_faces(["/System/Library/Fonts/Helvetica.ttc#1", "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"])

fn browser_platform_mono_bold_faces() -> [text]:
    _browser_present_platform_faces(["/System/Library/Fonts/Menlo.ttc#1", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"])

# `font-style: italic` (UA `<em>`/`<i>`) wants the real italic face of the same
# typeface, exactly like bold above. Linux paths only: Chrome's Linux defaults
# are Liberation Sans Italic and DejaVu Sans Mono Oblique. The macOS
# Helvetica.ttc / Menlo.ttc italic face indices are not verified here, so no
# macOS entry is guessed; a host without the file keeps the upright face.
fn browser_platform_sans_italic_faces() -> [text]:
    _browser_present_platform_faces(["/usr/share/fonts/truetype/liberation/LiberationSans-Italic.ttf"])

fn browser_platform_sans_bold_italic_faces() -> [text]:
    _browser_present_platform_faces(["/usr/share/fonts/truetype/liberation/LiberationSans-BoldItalic.ttf"])

fn browser_platform_mono_italic_faces() -> [text]:
    _browser_present_platform_faces(["/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Oblique.ttf"])

fn browser_platform_mono_bold_italic_faces() -> [text]:
    _browser_present_platform_faces(["/usr/share/fonts/truetype/dejavu/DejaVuSansMono-BoldOblique.ttf"])

# ---------------------------------------------------------------------------
# Family-LIST resolution (CSS Fonts 4 §5)
#
# `font-family` is an ordered, comma-separated list. The UA walks it and uses
# the FIRST name it can serve; a name it cannot serve is skipped, and when no
# name is served the UA default applies. Until 2026-11-14 every classifier in
# this file (and the two mirrors in font_renderer.spl / the layout foundation)
# instead ran substring tests over the WHOLE string, so:
#
#   `"Source Code Pro", Arial`  -> mono  (`contains("code")`); Chrome: Arial
#   `Roboto` / `"Segoe UI"`     -> mono  (the unmatched default); Chrome: the
#                                         default serif face
#   `cursive`, `ui-monospace`   -> mono;  Chrome: default serif
#
# Oracle: Chrome 159 headless shell on Linux/fontconfig, width of
# "Hamburgefonstiv 0123" (20 chars) at 16px in an inline-block span:
#   Liberation Sans 160.98 | Liberation Serif 147.69 | Liberation Mono 192.03
#   DejaVu Sans 183.91 (h19) | DejaVu Sans Mono 192.66 (h19)
# Full table: test/01_unit/browser_engine/font_family_list_resolution_spec.spl.
#
# One resolver, used by every classifier, so they cannot disagree again.
#
# SCOPE. The per-name walk is applied only on a host that has the face set the
# table above was measured on (Liberation Sans / Serif / Mono, no macOS system
# faces). Every other host — macOS, a host with no Liberation faces, SimpleOS —
# keeps the previous whole-value substring classification EXACTLY, including
# its mono default, because nothing was measured there
# (`_browser_resolve_family_legacy`).
class BrowserResolvedFamily:
    # "sans" | "mono" | "serif" | a bundled asset's category | "" (no name in
    # the list is served: `default_category` decides the stack).
    category: text
    # The category without the legacy "system" substring rule. The decorated
    # `@font-face` branch and the font_renderer category never applied that
    # rule; on the per-name path this always equals `category`.
    category_strict: text
    # A specific host face this name maps to, or "" for the category's
    # platform stack.
    face: text
    # LOGICAL path (`assets/fonts/...`) of the bundled asset the served name
    # IS, or "". Never the physical path: that depends on SIMPLE_ASSET_ROOT,
    # which a process can change (specs do), and this value is memoised.
    # `_browser_bundled_physical_path` resolves it at the point of use.
    bundled: text
    # The stack when no name is served: "serif" (Chrome's default face) on the
    # per-name path, "mono" on the legacy path and for the non-CSS sentinels.
    default_category: text

# Bounded: a page can mint unlimited distinct family strings (inline styles),
# and this table outlives the page.
val BROWSER_RESOLVED_FAMILY_MEMO_LIMIT: i32 = 512
var _browser_resolved_family_memo: Dict<text, BrowserResolvedFamily> = {}
var _browser_resolved_family_memo_count: i32 = 0
var _browser_host_is_macos_state: i32 = 0
var _browser_host_linux_face_set_state: i32 = 0

fn _browser_host_is_macos() -> bool:
    if _browser_host_is_macos_state == 0:
        _browser_host_is_macos_state = if file_exists("/System/Library/Fonts/Helvetica.ttc"): 1 else: 2
    _browser_host_is_macos_state == 1

# The host the Chrome 159 table was measured on.
pub fn browser_host_has_measured_linux_face_set() -> bool:
    if _browser_host_linux_face_set_state == 0:
        val present = (
            not _browser_host_is_macos() and
            file_exists("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf") and
            file_exists("/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf") and
            file_exists("/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf")
        )
        _browser_host_linux_face_set_state = if present: 1 else: 2
    _browser_host_linux_face_set_state == 1

fn _browser_host_face_or_empty(path: text) -> text:
    if file_exists(path): path else: ""

fn _browser_family_served(category: text, face: text, bundled: text) -> BrowserResolvedFamily:
    BrowserResolvedFamily(category: category, category_strict: category, face: face, bundled: bundled, default_category: "serif")

fn _browser_family_unserved(default_category: text) -> BrowserResolvedFamily:
    BrowserResolvedFamily(category: "", category_strict: "", face: "", bundled: "", default_category: default_category)

# The classification every host had before 2026-11-14, kept verbatim for the
# hosts the per-name walk was not measured on: substring tests over the WHOLE
# value (a decorated value's source path included), bundled lookup on the first
# name only, mono as the unmatched default.
fn _browser_resolve_family_legacy(family: text) -> BrowserResolvedFamily:
    val lower = family.to_lower()
    val families = family.split(",")
    val first = if families.len() > 0: families[0].trim() else: family.trim()
    val wanted = _strip_font_url_quotes(first).to_lower()
    val whole = family.trim().to_lower()
    var bundled = ""
    var whole_category = ""
    for asset in selected_font_asset_candidates():
        val asset_family = asset.family.to_lower()
        if bundled == "" and asset_family == wanted:
            bundled = asset.local_path
        if whole_category == "" and asset_family == whole:
            whole_category = asset.category
    val mono = lower.contains("mono") or lower.contains("courier") or lower.contains("code") or lower.contains("console")
    val sans_strict = lower.contains("sans") or lower.contains("arial") or lower.contains("helvetica")
    val serif = lower.contains("serif") or lower.contains("times") or lower.contains("georgia")
    val category = if mono: "mono" elif sans_strict or lower.contains("system"): "sans" elif serif: "serif" else: ""
    val substring_strict = if mono: "mono" elif sans_strict: "sans" elif serif: "serif" else: ""
    val strict = if whole_category != "": whole_category else: substring_strict
    BrowserResolvedFamily(category: category, category_strict: strict, face: "", bundled: bundled, default_category: "mono")

# The family list of a `font-family` value. A decorated
# `__simple_font_face__|<source>|<family>` value carries the page's list after
# its second `|`; classifying the whole value would read the SOURCE PATH as a
# family name (`.../DejaVuSansMono-Bold.ttf` contains "mono" and "sans").
fn _browser_family_list_text(family: text) -> text:
    val prefix = "__simple_font_face__|"
    if not family.starts_with(prefix):
        return family
    val rest = family.slice(prefix.byte_len(), family.byte_len())
    val pipe = rest.index_of("|")
    if pipe < 0:
        return ""
    rest.slice(pipe + 1, rest.byte_len())

# One name of the list -> what serves it, or `category == "" and bundled == ""`
# when this host cannot serve it and the walk continues.
fn _browser_resolve_family_name(raw: text) -> BrowserResolvedFamily:
    val trimmed = raw.trim()
    val name = _strip_font_url_quotes(trimmed).trim().to_lower()
    val quoted = name != trimmed.to_lower()
    if name == "":
        return _browser_family_unserved("serif")
    # A page that names a bundled face gets that face.
    for asset in selected_font_asset_candidates():
        if asset.family.to_lower() == name:
            return _browser_family_served(asset.category, "", asset.local_path)
    # Generic keywords are keywords only when UNQUOTED: `"sans-serif"` is a
    # family literally named sans-serif, which nothing serves (Chrome: 147.69).
    if not quoted:
        if name == "serif":
            return _browser_family_served("serif", "", "")
        if name == "sans-serif":
            return _browser_family_served("sans", "", "")
        if name == "monospace":
            return _browser_family_served("mono", "", "")
        if name == "system-ui":
            # Chrome asks fontconfig for the UI font: DejaVu Sans here
            # (183.91, h19), NOT the Arial alias.
            return _browser_family_served("sans", _browser_host_face_or_empty("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"), "")
        # `cursive`, `fantasy`, `math`, `fangsong`, `ui-serif`, `ui-sans-serif`,
        # `ui-monospace`, `ui-rounded`, `-apple-system`, `BlinkMacSystemFont`:
        # Chrome on Linux serves none of them (each measured 147.69, and
        # `NoSuch, cursive, Arial` measured 160.98: the walk CONTINUES).
    # Family names, quoted or not. Fontconfig aliases Arial/Helvetica to
    # Liberation Sans, Times to Liberation Serif, Courier to Liberation Mono.
    if name == "arial" or name == "helvetica" or name == "liberation sans":
        return _browser_family_served("sans", "", "")
    # Bare `sans` is NOT a CSS generic. Chrome resolves it through fontconfig
    # to DejaVu Sans (183.91), but it is also the literal the non-web UI lanes
    # pass (common/ui/panel2d.spl, widget_draw_ir.spl, window_scene_draw_ir.spl),
    # which rendered on the sans stack before this resolver. It stays there.
    if name == "sans":
        return _browser_family_served("sans", "", "")
    if name == "times new roman" or name == "times" or name == "liberation serif":
        return _browser_family_served("serif", "", "")
    if name == "courier new" or name == "courier" or name == "liberation mono":
        # Liberation Mono (192.03, h18), not the generic stack's DejaVu Sans
        # Mono (192.66, h19).
        return _browser_family_served("mono", _browser_host_face_or_empty("/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf"), "")
    # Installed-by-name host families: served only where the file exists.
    if name == "dejavu sans":
        val face = _browser_host_face_or_empty("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
        if face != "":
            return _browser_family_served("sans", face, "")
    if name == "dejavu sans mono" or name == "monospace":
        val face = _browser_host_face_or_empty("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf")
        if face != "":
            return _browser_family_served("mono", face, "")
    if name == "dejavu serif":
        val face = _browser_host_face_or_empty("/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf")
        if face != "":
            return _browser_family_served("serif", face, "")
    _browser_family_unserved("serif")

fn _browser_resolve_family_uncached(family: text) -> BrowserResolvedFamily:
    if not browser_host_has_measured_linux_face_set():
        return _browser_resolve_family_legacy(family)
    val list_text = _browser_family_list_text(family)
    # Not CSS family lists: the empty value, and the `inherit` sentinel of
    # common/ui/style.spl's FontProperties (a CSS-wide keyword never reaches
    # font matching in a browser). Both keep the stack they had before.
    val sentinel = list_text.trim().to_lower()
    if sentinel == "" or sentinel == "inherit":
        return _browser_family_unserved("mono")
    var resolved = _browser_family_unserved("serif")
    val names = list_text.split(",")
    for raw in names:
        if resolved.category == "" and resolved.bundled == "":
            resolved = _browser_resolve_family_name(raw)
    resolved

# Walk the list in order; the first served name wins.
fn browser_resolve_font_family(family: text) -> BrowserResolvedFamily:
    if _browser_resolved_family_memo.has(family):
        return _browser_resolved_family_memo[family]
    val resolved = _browser_resolve_family_uncached(family)
    if _browser_resolved_family_memo_count >= BROWSER_RESOLVED_FAMILY_MEMO_LIMIT:
        _browser_resolved_family_memo = {}
        _browser_resolved_family_memo_count = 0
    _browser_resolved_family_memo[family] = resolved
    _browser_resolved_family_memo_count = _browser_resolved_family_memo_count + 1
    resolved

# Entries currently memoised (bounded by BROWSER_RESOLVED_FAMILY_MEMO_LIMIT).
fn browser_resolved_family_memo_len() -> i32:
    _browser_resolved_family_memo_count

# "mono" | "sans" | "serif" | a bundled category | "" (no name served). This
# is the category the language/coverage matrix keys on.
fn browser_font_family_category(family: text) -> text:
    browser_resolve_font_family(family).category_strict

# Whether the list resolves to a monospace face (the layout's content-area rule).
pub fn browser_font_family_is_monospace(family: text) -> bool:
    browser_resolve_font_family(family).category == "mono"

# The bold / italic member of the SAME typeface as a specific host face, or ""
# when the host has none (the caller then keeps the regular face: recorded, not
# synthesised, and never a typeface swap).
fn _browser_host_face_variant(face: text, bold: bool, italic: bool) -> text:
    val regular_suffix = if face.ends_with("-Regular.ttf"): "-Regular.ttf" else: ".ttf"
    val stem = face.slice(0, face.byte_len() - regular_suffix.byte_len())
    val slant = if face.contains("/dejavu/DejaVuSans"): "Oblique" else: "Italic"
    val style_name = if bold and italic: "Bold" + slant elif bold: "Bold" elif italic: slant else: ""
    if style_name == "":
        return face
    val variant = stem + "-" + style_name + ".ttf"
    if file_exists(variant): variant else: ""

# Bold routing rides the existing `__simple_font_face__|<source>|<family>`
# channel, which `browser_font_candidates_for_family` already understands, so
# no call site learns a new parameter and a family with no platform bold face
# is returned unchanged (recorded as: regular, no synthesis).
#
# It routes ONLY the two GENERIC families whose platform bold face is the same
# typeface as their regular one. Round 9 built a bold list that fell back to
# `DejaVu-Bold` for an unrelated family and refused to land it, correctly: that
# swaps the TYPEFACE, not the weight, and a typeface swap is a parity
# regression wearing a parity-shaped name. So an explicit family, a bundled
# family, a serif stack, and an already-decorated `@font-face` value are all
# returned untouched — bold there stays the regular face, recorded rather than
# synthesised.
fn browser_font_family_for_weight(family: text, bold: bool) -> text:
    if not bold:
        return family
    if family.starts_with("__simple_font_face__|"):
        return family
    # The SAME per-name resolution as `browser_font_candidates_for_family`, so
    # the bold face is the bold of the typeface the regular run resolved to.
    val resolved = browser_resolve_font_family(family)
    if resolved.bundled != "":
        return family
    if resolved.face != "":
        val variant = _browser_host_face_variant(resolved.face, true, false)
        if variant == "":
            return family
        return "__simple_font_face__|" + variant + "|" + family
    val faces = if resolved.category == "mono":
        browser_platform_mono_bold_faces()
    elif resolved.category == "sans":
        browser_platform_sans_bold_faces()
    else:
        []
    if faces.len() == 0:
        return family
    "__simple_font_face__|" + faces[0] + "|" + family

# Weight AND style routing, same rules as `browser_font_family_for_weight`:
# only the generic sans/mono families, never a typeface swap. Italic picks the
# italic (bold-italic) face; when the host has no italic face the result is
# exactly the weight-only routing, so bold-italic degrades to bold, not regular.
pub fn browser_font_family_for_style(family: text, bold: bool, italic: bool) -> text:
    if not italic:
        return browser_font_family_for_weight(family, bold)
    if family.starts_with("__simple_font_face__|"):
        return family
    val resolved = browser_resolve_font_family(family)
    if resolved.bundled != "":
        return family
    if resolved.face != "":
        val variant = _browser_host_face_variant(resolved.face, bold, true)
        if variant == "":
            return browser_font_family_for_weight(family, bold)
        return "__simple_font_face__|" + variant + "|" + family
    val faces = if resolved.category == "mono":
        if bold: browser_platform_mono_bold_italic_faces() else: browser_platform_mono_italic_faces()
    elif resolved.category == "sans":
        if bold: browser_platform_sans_bold_italic_faces() else: browser_platform_sans_italic_faces()
    else:
        []
    if faces.len() == 0:
        return browser_font_family_for_weight(family, bold)
    "__simple_font_face__|" + faces[0] + "|" + family

fn _browser_resolve_bundled_candidates(paths: [text]) -> [text]:
    var resolved: [text] = []
    for path in paths:
        if path.starts_with("assets/fonts/"):
            resolved.push(selected_font_asset_physical_path(path))
        else:
            resolved.push(path)
    resolved

extern fn rt_http_download(url: text, output_path: text) -> (i64, i64, text)

fn browser_font_dylib_candidates() -> [text]:
    [
        "build/lib/libspl_fonts.so",
        "build/bootstrap/lib/libspl_fonts.so",
        "lib/libspl_fonts.so",
        "bin/lib/libspl_fonts.so"
    ]

fn browser_serif_font_candidates() -> [text]:
    # Chrome-compatible serif stack: host Liberation Serif first, then the
    # SimpleOS-bundled Noto Serif faces, then the multilingual Noto serif
    # assets and remaining host fallbacks. The bundled example paths are
    # resolved by content sniffing, so a missing file simply falls through
    # to the next candidate.
    _browser_resolve_bundled_candidates([
        "/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf",
        "examples/09_embedded/simple_os/fonts/serif/NotoSerif-Regular.ttf",
        "examples/09_embedded/simple_os/fonts/serif/NotoSerifSC-Regular.otf",
        "assets/fonts/google-fonts/ofl/notoserifsc/NotoSerifSC[wght].ttf",
        "assets/fonts/google-fonts/ofl/notoserifdevanagari/NotoSerifDevanagari[wdth,wght].ttf",
        "assets/fonts/google-fonts/ofl/notonaskharabic/NotoNaskhArabic[wght].ttf",
        "assets/fonts/google-fonts/ofl/notoserifbengali/NotoSerifBengali[wdth,wght].ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
        "/usr/share/fonts/opentype/urw-base35/NimbusRoman-Regular.otf"
    ])

fn browser_sans_font_candidates() -> [text]:
    browser_platform_sans_faces() + _browser_resolve_bundled_candidates([
        "assets/fonts/google-fonts/ofl/notosanssc/NotoSansSC[wght].ttf",
        "assets/fonts/google-fonts/ofl/notosansdevanagari/NotoSansDevanagari[wdth,wght].ttf",
        "assets/fonts/google-fonts/ofl/notosansarabic/NotoSansArabic[wdth,wght].ttf",
        "assets/fonts/google-fonts/ofl/notosansbengali/NotoSansBengali[wdth,wght].ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/opentype/urw-base35/NimbusSans-Regular.otf"
    ])

fn browser_mono_font_candidates() -> [text]:
    browser_platform_mono_faces() + _browser_resolve_bundled_candidates([
        "assets/fonts/google-fonts/ofl/notosansmono/NotoSansMono[wdth,wght].ttf",
        "/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "/usr/share/fonts/opentype/urw-base35/NimbusMonoPS-Regular.otf"
    ])

fn _browser_category_font_candidates(category: text) -> [text]:
    if category == "mono":
        return browser_mono_font_candidates()
    if category == "sans":
        return browser_sans_font_candidates()
    browser_serif_font_candidates()

fn browser_font_candidates_for_family(family: text) -> [text]:
    val face_source = browser_font_face_source_from_family_value(family)
    val resolved = browser_resolve_font_family(family)
    if face_source != "":
        # An explicit face first, then the stack of the page's own list (serif
        # when it names nothing served — on every host, as before).
        return [face_source] + _browser_category_font_candidates(resolved.category_strict)
    if resolved.bundled != "":
        return [_browser_bundled_physical_path(resolved)]
    if resolved.face != "":
        return [resolved.face] + _browser_category_font_candidates(resolved.category)
    if resolved.category == "":
        # No name served. Chrome's default face is the serif one
        # (`font-family: NoSuchFont` measures 147.69, Liberation Serif), so the
        # per-name path answers serif; the legacy path keeps its mono default.
        return _browser_category_font_candidates(resolved.default_category)
    _browser_category_font_candidates(resolved.category)

# The bundled asset serving this list, or "": the first SERVED name of the
# list is a bundled family. (`Arial, Bungee` is Arial; `NoSuch, Bungee` is
# Bungee.) A decorated `@font-face` value is never a bundled family.
fn browser_bundled_font_path_for_family(family: text) -> text:
    if family.starts_with("__simple_font_face__|"):
        return ""
    _browser_bundled_physical_path(browser_resolve_font_family(family))

# The memo is independent of SIMPLE_ASSET_ROOT; the root is applied here, on
# every call, exactly as the unmemoised lookup did.
fn _browser_bundled_physical_path(resolved: BrowserResolvedFamily) -> text:
    if resolved.bundled == "":
        return ""
    selected_font_asset_physical_path(resolved.bundled)

fn browser_font_face_family_value(family: text, source_url: text) -> text:
    val source = browser_font_face_local_source_path(source_url)
    if source == "":
        return family
    "__simple_font_face__|" + source + "|" + family

fn browser_font_face_source_from_family_value(family: text) -> text:
    val prefix = "__simple_font_face__|"
    if not family.starts_with(prefix):
        return ""
    val rest = family.slice(prefix.byte_len(), family.byte_len())
    val pipe = rest.index_of("|")
    if pipe < 0:
        return ""
    rest.slice(0, pipe)

fn browser_font_face_local_source_path(source_url: text) -> text:
    val trimmed = _strip_font_url_quotes(source_url.trim())
    val lower = trimmed.to_lower()
    if lower.starts_with("http://") or lower.starts_with("https://") or lower.starts_with("//"):
        val cached = browser_font_face_cached_source_path(trimmed)
        if file_exists(cached):
            return cached
        return ""
    if lower.starts_with("file://"):
        return trimmed.slice(7, trimmed.byte_len())
    trimmed

fn browser_font_face_cached_source_path(source_url: text) -> text:
    browser_font_cache_dir() + "/" + _browser_font_cache_file_name(source_url)

fn browser_chrome_compatible_normal_font_path() -> text:
    "/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf"

fn browser_chrome_compatible_normal_font_name() -> text:
    "Liberation Serif Regular"

fn browser_chrome_compatible_vector_font_name() -> text:
    "Simple Vector Outline"

fn browser_provided_font_paths() -> [text]:
    var paths: [text] = []
    for asset in selected_font_asset_candidates():
        paths.push(selected_font_asset_physical_path(asset.local_path))
    paths

fn browser_font_download_script_path() -> text:
    ""

fn browser_font_cache_dir() -> text:
    "build/browser-font-cache"

class BrowserFontMaterializeResult:
    ok: bool
    attempted_download: bool
    status: text
    stdout: text
    stderr: text
    exit_code: i32

fn _browser_font_materialize_result(ok: bool, attempted_download: bool, status: text, stdout: text, stderr: text, exit_code: i32) -> BrowserFontMaterializeResult:
    BrowserFontMaterializeResult(ok: ok, attempted_download: attempted_download, status: status, stdout: stdout, stderr: stderr, exit_code: exit_code)

fn browser_provided_fonts_available() -> bool:
    for path in browser_provided_font_paths():
        if not file_exists(path):
            return false
    true

fn ensure_browser_provided_fonts(auto_download: bool, timeout_ms: i64) -> BrowserFontMaterializeResult:
    if browser_provided_fonts_available():
        return _browser_font_materialize_result(true, false, "available", "", "", 0)
    if not auto_download:
        return _browser_font_materialize_result(false, false, "missing", "", "", 0)
    val script = browser_font_download_script_path()
    if not file_exists(script):
        return _browser_font_materialize_result(false, false, "missing_download_script", "", "", 0)
    val (stdout, stderr, exit_code) = process_run_timeout("sh", [script], timeout_ms)
    if exit_code != 0:
        return _browser_font_materialize_result(false, true, "download_failed", stdout, stderr, exit_code)
    if browser_provided_fonts_available():
        return _browser_font_materialize_result(true, true, "downloaded", stdout, stderr, exit_code)
    _browser_font_materialize_result(false, true, "download_incomplete", stdout, stderr, exit_code)

fn ensure_browser_font_face_sources(css: text, auto_download: bool) -> BrowserFontMaterializeResult:
    val urls = browser_font_face_source_urls(css)
    if urls.len() == 0:
        return _browser_font_materialize_result(true, false, "no_font_face_sources", "", "", 0)
    var attempted = false
    var missing_remote = false
    for url in urls:
        if _browser_font_source_is_remote(url):
            val cached = browser_font_face_cached_source_path(url)
            if file_exists(cached):
                continue
            missing_remote = true
            if not auto_download:
                continue
            attempted = true
            dir_create_all(browser_font_cache_dir())
            val result = rt_http_download(url, cached)
            if result.0 < 200 or result.0 >= 300:
                return _browser_font_materialize_result(false, true, "remote_download_failed", "", result.2, result.0.to_i32())
        else:
            val local = browser_font_face_local_source_path(url)
            if local != "" and not file_exists(local):
                return _browser_font_materialize_result(false, attempted, "local_source_missing", "", local, 0)
    if missing_remote and not auto_download:
        return _browser_font_materialize_result(false, false, "remote_sources_missing", "", "", 0)
    _browser_font_materialize_result(true, attempted, if attempted: "font_face_sources_downloaded" else: "font_face_sources_available", "", "", 0)

fn browser_font_face_source_urls(css: text) -> [text]:
    var urls: [text] = []
    val lower = css.to_lower()
    var search_start = 0
    while true:
        val at_haystack = lower.substring(search_start)
        val at_idx_rel = at_haystack.index_of("@font-face")
        if at_idx_rel < 0:
            break
        val at_idx = search_start + at_idx_rel
        val open_haystack = lower.substring(at_idx)
        val open_rel = open_haystack.index_of("{")
        if open_rel < 0:
            break
        val open_idx = at_idx + open_rel
        val close_haystack = lower.substring(open_idx + 1)
        val close_rel = close_haystack.index_of("}")
        if close_rel < 0:
            break
        val close_idx = open_idx + 1 + close_rel
        val block = css.substring(open_idx + 1, close_idx)
        urls = urls + _browser_font_face_urls_in_block(block)
        search_start = close_idx + 1
    urls

fn _browser_font_face_urls_in_block(block: text) -> [text]:
    var urls: [text] = []
    val lower = block.to_lower()
    var search_start = 0
    while true:
        val url_haystack = lower.substring(search_start)
        val url_rel = url_haystack.index_of("url(")
        if url_rel < 0:
            break
        val start = search_start + url_rel + 4
        val end_haystack = block.substring(start)
        val end_rel = end_haystack.index_of(")")
        if end_rel < 0:
            break
        val raw = block.substring(start, start + end_rel).trim()
        val cleaned = _strip_font_url_quotes(raw)
        if cleaned != "":
            urls.push(cleaned)
        search_start = start + end_rel + 1
    urls

fn _strip_font_url_quotes(raw: text) -> text:
    if raw.byte_len() >= 2:
        val first = raw.substring(0, 1)
        val last = raw.substring(raw.byte_len() - 1, raw.byte_len())
        if (first == "\"" and last == "\"") or (first == "'" and last == "'"):
            return raw.substring(1, raw.byte_len() - 1)
    raw

fn _browser_font_source_is_remote(source_url: text) -> bool:
    val lower = source_url.to_lower()
    lower.starts_with("http://") or lower.starts_with("https://") or lower.starts_with("//")

fn _browser_font_cache_file_name(source_url: text) -> text:
    var out = ""
    var idx = 0
    while idx < source_url.len():
        val ch = source_url.char_at(idx)
        if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9"):
            out = out + ch
        else:
            out = out + "_"
        idx = idx + 1
    out + _browser_font_source_extension(source_url)

fn _browser_font_source_extension(source_url: text) -> text:
    val lower = source_url.to_lower()
    if lower.contains(".woff2"):
        return ".woff2"
    if lower.contains(".woff"):
        return ".woff"
    if lower.contains(".otf"):
        return ".otf"
    if lower.contains(".ttf"):
        return ".ttf"
    ".font"

# Does this family already resolve to a face the HOST provides — either an
# explicit `@font-face` source the page named, or a present platform default?
#
# The language/category coverage matrix exists to guarantee a BUNDLED face with
# real coverage for a script, and for non-Latin content that is exactly right.
# For Latin content it replaces the requested family with the matrix's witness
# family, and `browser_bundled_font_path_for_family` then answers with that
# bundled asset ALONE — which silently discards both an explicit `@font-face`
# source (filed at doc/08_tracking/bug/
# web_inline_bold_face_advances_never_selected_2026-09-12.md) and, since round
# 11, the platform face. Measured: the catalog pages declare `lang="en"`, and
# with it every `sans-serif` run resolved back to the bundled wght=100 Thin
# master, so the face routing was live under `und` and dead on every real page.
#
# On a host with no platform faces this answers false for every generic family,
# so the matrix keeps its current behaviour there unchanged.
fn browser_family_has_host_face(family: text) -> bool:
    if browser_font_face_source_from_family_value(family) != "":
        return true
    val resolved = browser_resolve_font_family(family)
    if resolved.bundled != "":
        return false
    if resolved.face != "":
        return true
    if resolved.category == "mono":
        return browser_platform_mono_faces().len() > 0
    if resolved.category == "sans":
        return browser_platform_sans_faces().len() > 0
    false
