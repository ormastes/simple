"""
# Dev ids — make an in-development workstream addressable by name

@tag:stdlib
@tag:testing

## The syntax, and why this one

A spec that belongs to a named workstream carries a SECOND ordinary tag
next to the in-development tag:

    # @tag: in-development, dev-id-auth-rework

The id is everything after the reserved `dev-id-` prefix, folded through
`tag_normalize` (lowercase, `_` -> `-`) exactly like every other tag.

The whole point of this spelling is that **nothing had to learn a new
grammar**. Both extractors in this tree already parse it as-is:

  - `std.test_runner.test_manifest_scanner.extract_tags` already splits a
    directive on commas (`test_manifest_scanner.spl:277`), so the second
    tag on that line is already a first-class tag today.
  - `std.spec.in_development.spec_tags` scans `@tag:` followed by
    `[A-Za-z0-9_-]+` (`in_development.spl:_is_tag_char`). `-` is already a
    tag character, so `dev-id-auth-rework` is already a legal tag name.

So `bin/simple tags --tag dev-id-auth-rework` selects exactly that set on
the day this module lands, before any consumer is written. That is the
test of a design that reuses a channel rather than adding one.

## Alternatives rejected

  - **`# @dev:<id>`, a second directive.** Rejected: it is a second
    parser. `extract_directive_lines` would need a new branch, the strict
    `spec_tags` extractor would need one too, and the Rust runner's
    `--tag` (`args.rs:24`) would not see it at all — so a dev id would be
    invisible to exactly the engine that already has tag filtering.
  - **A parameterised tag, `@tag:in-development(auth-rework)`.** Rejected:
    `(` and `)` are not tag characters in either extractor, so this is a
    grammar change to the SHARED `@tag:` channel — all 1,022 existing uses
    and both engines would have to agree on it at once, to buy a nesting
    that a sibling tag already expresses.
  - **A namespaced name, `@tag:in-development/auth-rework`.** Same
    objection plus a worse one: adding `/` to the tag charset changes what
    every unrelated tag means, and `source_has_tag` is documented as an
    EXACT-name match precisely so `in-development-notes` cannot answer for
    `in-development`.
  - **Folding the id into the tag itself, `@tag:in-development-auth-rework`.**
    Needs no grammar change either, but it BREAKS the exact-name match: a
    spec spelled that way would stop being in-development at all, so every
    spec would have to carry both tags anyway — which is this design,
    minus the readable prefix.

## Default-include, and how it squares with the landed sweep semantics

The landed rule is that a tagged spec still EXECUTES and it is the VERDICT
that is neutralised. Dev ids do not change that, and the default here is
therefore `DevSelection.Default`: everything runs, in-development
included. `--in-development` narrows EXECUTION to the tagged set (a dev
session running only its own work); `--in-development=<id>` narrows it to
one workstream; `--no-in-development` drops the tagged set from execution
entirely, for a lane that wants a clean tree with no WIP cost at all.

`--no-in-development` is the only mode that stops a tagged spec running,
and it is opt-in, so nothing silently loses the unexpected-pass signal
that whole-suite execution exists to produce.

    use std.tag_query.dev_id.{
        DEV_ID_PREFIX, dev_id_tag, dev_id_from_tag, dev_id_of_tags,
        DevSelection, dev_selection_includes,
        tag_index_dev_ids, tag_index_items_with_dev_id,
        tag_index_selected
    }
"""

use std.tag_query.tag_index.{
    IN_DEVELOPMENT_TAG, TaggedItem, TagIndex, tag_normalize, tag_index_has
}

# The reserved prefix. Spelled once so producer, consumer and CLI cannot
# drift, exactly like IN_DEVELOPMENT_TAG.
val DEV_ID_PREFIX: text = "dev-id-"

fn dev_id_tag(id: text) -> text:
    """The full tag name for a dev id: `auth-rework` -> `dev-id-auth-rework`.

    Accepts an id that is ALREADY prefixed and returns it unchanged, so a
    caller that passes `--dev-id dev-id-auth-rework` (a natural mistake
    when copying a line out of `simple tags`) gets what it meant instead
    of `dev-id-dev-id-auth-rework` silently matching nothing.
    """
    val n = tag_normalize(id)
    if n == "":
        return ""
    if n.starts_with(DEV_ID_PREFIX):
        return n
    DEV_ID_PREFIX + n

fn dev_id_from_tag(tag: text) -> text:
    """The id carried by a tag, or `""` when the tag is not a dev id.

    `dev-id-auth-rework` -> `auth-rework`. The bare prefix `dev-id-` with
    nothing after it is NOT an id: an empty id would collect every
    unnamed spec into one nameless bucket, which is the opposite of
    addressable.
    """
    val n = tag_normalize(tag)
    if not n.starts_with(DEV_ID_PREFIX):
        return ""
    val id = n.slice(DEV_ID_PREFIX.len(), n.len())
    if id == "":
        return ""
    id

fn dev_id_of_tags(tags: [text]) -> text:
    """The dev id declared by a tag set, or `""` when it declares none.

    First match wins if a file somehow carries two. Reporting rather than
    rejecting is deliberate: this module is queried by tools that must
    keep working on a half-tagged tree, and a hard error here would make
    `simple tags` unusable during exactly the sweep it exists to serve.
    """
    for t in tags:
        val id = dev_id_from_tag(t)
        if id != "":
            return id
    ""

fn item_dev_id(item: TaggedItem) -> text:
    """The dev id of an indexed item, or `""`."""
    dev_id_of_tags(item.tags)

fn item_is_in_development(item: TaggedItem) -> bool:
    """True when an indexed item carries the in-development tag."""
    tag_index_has(item, IN_DEVELOPMENT_TAG)

# ================================================================
# SELECTION
# ================================================================

enum DevSelection:
    Default        # run everything; in-development included (the landed rule)
    Only           # run ONLY in-development specs
    OnlyId         # run ONLY in-development specs carrying `want_id`
    Exclude        # do not execute in-development specs at all

fn dev_selection_includes(
    mode: DevSelection,
    is_in_development: bool,
    item_id: text,
    want_id: text
) -> bool:
    """Should this spec EXECUTE under `mode`?

    The single predicate. Both the CLI listing and any runner wiring route
    through it rather than re-deriving the rule, for the same reason
    `classify_in_development` is a single classifier: two spellings of one
    rule is how two surfaces come to disagree.

    Note what this does NOT decide: whether a tagged spec's verdict counts.
    That stays `classify_in_development`'s job and is untouched here, so
    the neutralise-the-verdict semantics survive every mode that runs.
    """
    match mode:
        case DevSelection.Default:
            true
        case DevSelection.Exclude:
            not is_in_development
        case DevSelection.Only:
            is_in_development
        case DevSelection.OnlyId:
            # An untagged file is never selected by an id query even if it
            # somehow carries the dev-id tag alone: an id names a slice OF
            # the in-development set, not a parallel set beside it.
            is_in_development and item_id != "" and item_id == tag_normalize(want_id)

fn dev_selection_parse(arg: text) -> DevSelection:
    """Map one CLI argument onto a mode. Anything unrecognised is Default.

    `--in-development` -> Only, `--in-development=<id>` -> OnlyId,
    `--no-in-development` -> Exclude.
    """
    if arg == "--no-in-development":
        return DevSelection.Exclude
    if arg == "--in-development":
        return DevSelection.Only
    if arg.starts_with("--in-development="):
        return DevSelection.OnlyId
    DevSelection.Default

fn dev_selection_parse_id(arg: text) -> text:
    """The id embedded in `--in-development=<id>`, or `""`."""
    if arg.starts_with("--in-development="):
        return tag_normalize(arg[17:])
    ""

# ================================================================
# INDEX QUERIES
# ================================================================

fn tag_index_items_with_dev_id(idx: TagIndex, id: text) -> [text]:
    """Every in-development spec carrying dev id `id`, in scan order."""
    val want = tag_normalize(id)
    var out: [text] = []
    for item in idx.items:
        if item_is_in_development(item) and item_dev_id(item) == want:
            out.push(item.path)
    out

fn tag_index_selected(
    idx: TagIndex,
    mode: DevSelection,
    want_id: text
) -> [text]:
    """Every indexed item that `mode` selects for execution.

    Under `DevSelection.Default` this is every INDEXED item, which is not
    the same as every file in the tree — `TagIndex` holds only files that
    carry at least one tag. Callers wanting a run set use the narrowing
    modes; Default exists so the predicate has an honest identity case.
    """
    var out: [text] = []
    for item in idx.items:
        if dev_selection_includes(mode, item_is_in_development(item), item_dev_id(item), want_id):
            out.push(item.path)
    out

fn tag_index_dev_ids(idx: TagIndex) -> [(text, i64)]:
    """Every dev id in use with its spec count, sorted by count desc then
    name — the listing a dev session reads to find its own workstream.

    Only in-development items are counted. A `dev-id-` tag on a spec that
    is not in-development is a tagging mistake, and counting it would let
    a promoted spec keep inflating a workstream it has already left.
    """
    var names: [text] = []
    var counts: [i64] = []
    for item in idx.items:
        if not item_is_in_development(item):
            continue
        val id = item_dev_id(item)
        if id == "":
            continue
        var found = -1
        var i = 0
        while i < names.len():
            if names[i] == id:
                found = i
            i = i + 1
        if found >= 0:
            counts[found] = counts[found] + 1
        else:
            names.push(id)
            counts.push(1)
    var rows: [(text, i64)] = []
    var used: [bool] = []
    var k = 0
    while k < names.len():
        used.push(false)
        k = k + 1
    var emitted = 0
    while emitted < names.len():
        var best = -1
        var j = 0
        while j < names.len():
            if not used[j]:
                if best < 0:
                    best = j
                elif counts[j] > counts[best]:
                    best = j
                elif counts[j] == counts[best] and names[j] < names[best]:
                    best = j
            j = j + 1
        used[best] = true
        rows.push((names[best], counts[best]))
        emitted = emitted + 1
    rows

fn tag_index_unnamed_in_development(idx: TagIndex) -> [text]:
    """In-development specs carrying NO dev id.

    Reported as its own category rather than hidden: an unnamed WIP spec
    belongs to no workstream and so is reachable by no `--in-development=<id>`
    run. That is the backlog this feature exists to make countable.
    """
    var out: [text] = []
    for item in idx.items:
        if item_is_in_development(item) and item_dev_id(item) == "":
            out.push(item.path)
    out

export DEV_ID_PREFIX
export dev_id_tag, dev_id_from_tag, dev_id_of_tags
export item_dev_id, item_is_in_development
export DevSelection, dev_selection_includes
export dev_selection_parse, dev_selection_parse_id
export tag_index_items_with_dev_id, tag_index_selected
export tag_index_dev_ids, tag_index_unnamed_in_development
