"""One file descriptor and one immutable text codec selection.

Text operations use internal UTF-8 values. Encoding, byte order and BOM handling
are applied inside this owner. Byte counts and file positions remain byte-based.
Reads consume the remaining file within the configured input budget. A failed
read or transport write closes the session; consumed/partially written data is
not replayed. Encoding rejection happens before writing and leaves it open.
No normalization, charset detection, output cache or shared mutable profile.
"""
use std.io.types.{FileMode, IoError, IoErrorKind}
use std.nogc_sync_mut.io.text_session.{TextSessionCodec, utf8_text_session_codec}
use std.nogc_sync_mut.io.file_bytes.{file_read_borrowed_bytes}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_text_decode, io_text_encode, io_text_error_message}
use std.common.encoding.external_text.{Encoding, BomPolicy, ExternalFormat, external_validate_bom}
use std.common.text_bytes.{text_byte_buffer, text_bytes_concat_checked}
use std.common.string_core.{str_len}
use std.nogc_sync_mut.fs.host_path.{host_path_native}
use std.nogc_sync_mut.sffi.fs.{io_file_open, io_file_close, io_file_seek, io_file_write_all}

val FILE_TEXT_DEFAULT_LIMIT: i64 = 16777216

pub fn file_default_text_codec() -> Result<TextSessionCodec, TextIoError>:
    utf8_text_session_codec(FILE_TEXT_DEFAULT_LIMIT, FILE_TEXT_DEFAULT_LIMIT)

fn file_session_transport(message: text) -> TextIoError:
    TextIoError.Transport(IoError(kind: IoErrorKind.Other, message: message, source: nil))

# Private implementation metadata; ordinary session signatures expose only
# Encoding/TextByteOrder/BomPolicy through the validated shared configuration.
fn file_session_read_format(codec: TextSessionCodec) -> ExternalFormat:
    ExternalFormat(encoding: codec.read_encoding(), byte_order: codec.read_byte_order(), bom: codec.read_bom())

fn file_session_write_format(codec: TextSessionCodec) -> ExternalFormat:
    ExternalFormat(encoding: codec.write_encoding(), byte_order: codec.write_byte_order(), bom: codec.write_bom())

fn file_session_format_at(format: ExternalFormat, position: i64) -> Result<ExternalFormat, TextIoError>:
    if position < 0:
        return Err(file_session_transport("file text position is unavailable"))
    if format.encoding == Encoding.Utf16 and position % 2 != 0:
        return Err(TextIoError.Io("UTF-16 file position must be a code-unit boundary"))
    if position == 0:
        return Ok(format)
    # A BOM is stream metadata only at byte zero. Interior U+FEFF is content.
    Ok(ExternalFormat(encoding: format.encoding, byte_order: format.byte_order, bom: BomPolicy.Preserve))

pub fn file_session_encode(item: text, codec: TextSessionCodec, position: i64) -> Result<[u8], TextIoError>:
    val valid: () = codec.validate()?
    val format: ExternalFormat = file_session_format_at(file_session_write_format(codec), position)?
    file_session_encode_format(item, codec, format)

fn file_session_encode_format(item: text, codec: TextSessionCodec, format: ExternalFormat) -> Result<[u8], TextIoError>:
    # Every supported encoding consumes at least half the internal UTF-8
    # byte count. Refuse impossible fits before extracting/converting input.
    val input_bytes = str_len(item)
    if input_bytes < 0 or input_bytes > codec.output_byte_limit() * 2:
        return Err(TextIoError.Io("file text output exceeds the session byte limit"))
    val encoded: [u8] = io_text_encode(item, format)?
    if encoded.len() > codec.output_byte_limit():
        return Err(TextIoError.Io("file text output exceeds the session byte limit"))
    Ok(encoded)

pub fn file_session_decode(bytes: [u8], codec: TextSessionCodec, position: i64) -> Result<text, TextIoError>:
    val valid: () = codec.validate()?
    if bytes.len() > codec.input_byte_limit():
        return Err(TextIoError.Io("file text input exceeds the session byte limit"))
    val format: ExternalFormat = file_session_format_at(file_session_read_format(codec), position)?
    io_text_decode(bytes, format)

pub fn file_session_read_fd(descriptor: i64, codec: TextSessionCodec) -> Result<text, TextIoError>:
    file_session_read_bounded_fd(descriptor, codec, false)

pub fn file_session_read_line_fd(descriptor: i64) -> Result<text, TextIoError>:
    # The ordinary line facade is UTF-8. Read one byte at a time to preserve
    # the next raw read's cursor; a future buffered owner may amortize syscalls.
    val codec = file_default_text_codec()?
    file_session_read_bounded_fd(descriptor, codec, true)

fn file_session_read_bounded_fd(descriptor: i64, codec: TextSessionCodec, line: bool) -> Result<text, TextIoError>:
    val valid: () = codec.validate()?
    val native_position = io_file_seek(descriptor, 0, 1)
    # Preserve does not interpret a stream signature. Retain the historical
    # UTF-8 FileHandle behavior for borrowed non-seekable descriptors too.
    val position = if native_position < 0 and codec.read_encoding() == Encoding.Utf8 and file_session_read_format(codec).bom == BomPolicy.Preserve: 0 else: native_position
    val format: ExternalFormat = file_session_format_at(file_session_read_format(codec), position)?
    val limit = codec.input_byte_limit()
    var capacity = if limit < 8192: limit else: 8192
    if line and capacity > 256: capacity = 256
    var bytes: [u8] = match text_byte_buffer(capacity):
        case Ok(item): item
        case Err(_): return Err(TextIoError.Io("file text input allocation failed"))
    while true:
        val remaining = limit - bytes.len()
        # One-byte overflow probe distinguishes exact-budget EOF. Callers
        # must not reuse the descriptor after a failed consuming operation.
        # Requests grow with the held bytes so whole-buffer appends stay linear.
        var requested = if bytes.len() > 8192: bytes.len() else: 8192
        if remaining < requested: requested = remaining + 1
        if line: requested = 1
        val chunk: [u8] = match file_read_borrowed_bytes(descriptor, requested):
            case Ok(item): item
            case Err(error): return Err(TextIoError.Transport(error))
        if chunk.len() == 0:
            if line and bytes.len() == 0:
                return Err(TextIoError.Transport(IoError(kind: IoErrorKind.UnexpectedEof, message: "end of file", source: nil)))
            break
        if chunk.len() > remaining or chunk.len() > requested:
            return Err(TextIoError.Io("file text input exceeds the session byte limit"))
        val needed = bytes.len() + chunk.len()
        if not line:
            # One bulk append per chunk instead of a per-byte copy.
            bytes = match text_bytes_concat_checked(bytes, chunk):
                case Ok(item): item
                case Err(_): return Err(TextIoError.Io("file text input allocation failed"))
        else:
            if needed > capacity:
                var next_capacity = capacity * 2
                if next_capacity < needed: next_capacity = needed
                if next_capacity > limit: next_capacity = limit
                var grown: [u8] = match text_byte_buffer(next_capacity):
                    case Ok(item): item
                    case Err(_): return Err(TextIoError.Io("file text input allocation failed"))
                for byte in bytes: grown = grown.push(byte)
                if grown.len() != bytes.len():
                    return Err(TextIoError.Io("file text input accumulation failed"))
                bytes = grown
                capacity = next_capacity
            for byte in chunk: bytes = bytes.push(byte)
        if bytes.len() != needed:
            return Err(TextIoError.Io("file text input accumulation failed"))
        if line and chunk[chunk.len() - 1] == 10:
            break
    io_text_decode(bytes, format)

pub class FileTextSession:
    _descriptor: i64
    _codec: TextSessionCodec
    _mode: FileMode
    _open: bool

    pub static fn open(path: text, mode: FileMode, codec: TextSessionCodec) -> Result<FileTextSession, TextIoError>:
        """Open one file; the codec is fixed for this session's lifetime.

        WriteOnly creates/truncates just like FileHandle.open. Use File.write
        for the convenience contract that validates output before creation.
        Require-BOM append is refused: concurrent appenders cannot atomically
        prove first-writer ownership using the existing descriptor provider.
        """
        val valid: () = codec.validate()?
        if mode == FileMode.Append and file_session_write_format(codec).bom == BomPolicy.Require:
            return Err(TextIoError.Unsupported("required BOM append needs exclusive first-writer ownership"))
        val mode_int = match mode:
            case FileMode.ReadOnly: 0
            case FileMode.WriteOnly: 1
            case FileMode.ReadWrite: 2
            case FileMode.Append: 3
        val descriptor = io_file_open(host_path_native(path), mode_int)
        if descriptor < 0:
            return Err(TextIoError.Transport(IoError(kind: IoErrorKind.NotFound, message: "failed to open: {path}", source: nil)))
        Ok(FileTextSession(_descriptor: descriptor, _codec: codec, _mode: mode, _open: true))

    pub static fn write_file(path: text, content: text, mode: FileMode, codec: TextSessionCodec) -> Result<(), TextIoError>:
        """Validate/encode before destructive open; append policy uses actual EOF.

        Append alignment is checked for the opened descriptor. As with existing
        descriptor writes, cooperating appenders must preserve code-unit framing.
        """
        if mode == FileMode.Append:
            val valid: () = codec.validate()?
            val selected: ExternalFormat = file_session_write_format(codec)
            if selected.bom == BomPolicy.Require:
                return Err(TextIoError.Unsupported("required BOM append needs exclusive first-writer ownership"))
            # Encode once before opening. A possible leading U+FEFF is content
            # until the opened file's real EOF establishes stream position.
            val preserve = ExternalFormat(encoding: selected.encoding, byte_order: selected.byte_order, bom: BomPolicy.Preserve)
            val bytes: [u8] = file_session_encode_format(content, codec, preserve)?
            var session = FileTextSession.open(path, mode, codec)?
            val position = io_file_seek(session._descriptor, 0, 2)
            val format: ExternalFormat = match file_session_format_at(selected, position):
                case Ok(item): item
                case Err(error):
                    session.close()
                    return Err(error)
            match external_validate_bom(bytes, format):
                case Err(error):
                    session.close()
                    return Err(TextIoError.Codec(error))
                case Ok(_): ()
            val written: Result<(), TextIoError> = session._write_prepared(bytes)
            val closed: Result<(), TextIoError> = session.close()
            return match written:
                case Err(error): Err(error)
                case Ok(_): closed
        val bytes: [u8] = file_session_encode(content, codec, 0)?
        var session = FileTextSession.open(path, mode, codec)?
        val written: Result<(), TextIoError> = session._write_prepared(bytes)
        val closed: Result<(), TextIoError> = session.close()
        match written:
            case Err(error): Err(error)
            case Ok(_): closed

    pub me read() -> Result<text, TextIoError>:
        if not self._open: return Err(file_session_transport("file text session is closed"))
        match file_session_read_fd(self._descriptor, self._codec):
            case Ok(item): Ok(item)
            case Err(error):
                self.close()
                Err(error)

    pub me write(item: text) -> Result<(), TextIoError>:
        if not self._open: return Err(file_session_transport("file text session is closed"))
        val whence = if self._mode == FileMode.Append: 2 else: 1
        val native_position = io_file_seek(self._descriptor, 0, whence)
        val borrowed_utf8_position = self._mode != FileMode.Append and self._codec.write_encoding() == Encoding.Utf8 and file_session_write_format(self._codec).bom == BomPolicy.Preserve
        if native_position < 0 and not borrowed_utf8_position:
            self.close()
            return Err(file_session_transport("file text position is unavailable"))
        val position = if native_position < 0: 0 else: native_position
        # O_APPEND chooses its position at the write syscall. Require was
        # refused before open; Preserve needs no guessed file-size probe.
        val encoded: [u8] = file_session_encode(item, self._codec, position)?
        self._write_prepared(encoded)

    pub me read_at(offset: i64, size: i64) -> Result<text, TextIoError>:
        """Read a byte-framed region; callers choose complete scalar boundaries."""
        if not self._open: return Err(file_session_transport("file text session is closed"))
        if offset < 0 or size < 0 or offset > 9223372036854775807 - size:
            return Err(TextIoError.Io("invalid positional byte range"))
        if size > self._codec.input_byte_limit():
            return Err(TextIoError.Io("file text input exceeds the session byte limit"))
        val format: ExternalFormat = file_session_format_at(file_session_read_format(self._codec), offset)?
        # Chunks are appended in bulk; no size-wide buffer is reserved up front.
        var bytes: [u8] = match text_byte_buffer(0):
            case Ok(item): item
            case Err(_): return Err(TextIoError.Io("file text input allocation failed"))
        if io_file_seek(self._descriptor, offset, 0) != offset:
            self.close()
            return Err(file_session_transport("file text seek failed"))
        while bytes.len() < size:
            val remaining = size - bytes.len()
            # Requests grow with the held bytes so whole-buffer appends stay linear.
            var requested = if bytes.len() > 8192: bytes.len() else: 8192
            if requested > remaining: requested = remaining
            val chunk: [u8] = match file_read_borrowed_bytes(self._descriptor, requested):
                case Ok(item): item
                case Err(error):
                    self.close()
                    return Err(TextIoError.Transport(error))
            if chunk.len() == 0: break
            if chunk.len() > requested:
                self.close()
                return Err(file_session_transport("file text read returned an invalid extent"))
            val expected = bytes.len() + chunk.len()
            bytes = match text_bytes_concat_checked(bytes, chunk):
                case Ok(item): item
                case Err(_):
                    self.close()
                    return Err(TextIoError.Io("file text input allocation failed"))
            if bytes.len() != expected:
                self.close()
                return Err(TextIoError.Io("file text input accumulation failed"))
        match io_text_decode(bytes, format):
            case Ok(item): Ok(item)
            case Err(error):
                self.close()
                Err(error)

    pub me write_at(offset: i64, item: text) -> Result<(), TextIoError>:
        if not self._open: return Err(file_session_transport("file text session is closed"))
        if self._mode == FileMode.Append:
            return Err(TextIoError.Unsupported("positioned writes are unavailable in append mode"))
        val bytes: [u8] = file_session_encode(item, self._codec, offset)?
        if offset > 9223372036854775807 - bytes.len():
            return Err(TextIoError.Io("invalid positional byte range"))
        if io_file_seek(self._descriptor, offset, 0) != offset:
            self.close()
            return Err(file_session_transport("file text seek failed"))
        self._write_prepared(bytes)

    me _write_prepared(bytes: [u8]) -> Result<(), TextIoError>:
        # Owner-only entry used by File.write after encoding before truncate.
        if not self._open: return Err(file_session_transport("file text session is closed"))
        if bytes.len() > self._codec.output_byte_limit():
            return Err(TextIoError.Io("file text output exceeds the session byte limit"))
        if not io_file_write_all(self._descriptor, bytes):
            self.close()
            return Err(file_session_transport("file text write failed"))
        Ok(())

    pub me close() -> Result<(), TextIoError>:
        if not self._open: return Ok(())
        val descriptor = self._descriptor
        self._open = false
        self._descriptor = -1
        if not io_file_close(descriptor):
            return Err(file_session_transport("file text close failed"))
        Ok(())

    pub fn is_open() -> bool: self._open

export FileTextSession
export file_default_text_codec, file_session_encode, file_session_decode, file_session_read_fd, file_session_read_line_fd
