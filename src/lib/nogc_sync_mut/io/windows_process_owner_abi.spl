#![allow(primitive_api)]
# Windows direct platform boundary (32-bit x86 and 64-bit); no new runtime/C
# implementation. This module is intentionally outside the builder closure until
# native qualification. Pointer/HANDLE/SIZE_T/ULONG_PTR slots use target-width
# u32/i32 on arch="x86" and i64/u64 on 64-bit targets; DWORD/BOOL use u32/i32.
use std.nogc_sync_mut.io.volatile_ops.{volatile_write_u16, volatile_write_u32, volatile_write_u64, volatile_read_u32, volatile_read_u64}

@when(arch="x86"):
@abi("system")
@unsafe(reason: "Win32 kernel32 process heap owner", capabilities: [ffi])
extern fn GetProcessHeap() -> u32
@abi("system")
@unsafe(reason: "Win32 current process image copied into caller-owned UTF16 storage", capabilities: [ffi, raw_ptr])
extern fn GetModuleFileNameW(module: u32, buffer: u32, capacity: u32) -> u32
@abi("system")
@unsafe(reason: "Win32 current host memory snapshot", capabilities: [ffi, raw_ptr])
extern fn GlobalMemoryStatusEx(status: u32) -> i32
@abi("system")
@unsafe(reason: "Win32 copied system CPU counters", capabilities: [ffi, raw_ptr])
extern fn GetSystemTimes(idle: u32, kernel: u32, user: u32) -> i32
@abi("system")
@unsafe(reason: "Win32 kernel32 bounded allocation", capabilities: [ffi, raw_ptr])
extern fn HeapAlloc(heap: u32, flags: u32, size: u32) -> u32
@abi("system")
@unsafe(reason: "Win32 kernel32 owned allocation release", capabilities: [ffi, raw_ptr])
extern fn HeapFree(heap: u32, flags: u32, allocation: u32) -> i32
@else:
@abi("system")
@unsafe(reason: "Win64 kernel32 process heap owner", capabilities: [ffi])
extern fn GetProcessHeap() -> i64
@abi("system")
@unsafe(reason: "Win64 current process image copied into caller-owned UTF16 storage", capabilities: [ffi, raw_ptr])
extern fn GetModuleFileNameW(module: i64, buffer: i64, capacity: u32) -> u32
@abi("system")
@unsafe(reason: "Win64 current host memory snapshot", capabilities: [ffi, raw_ptr])
extern fn GlobalMemoryStatusEx(status: i64) -> i32
@abi("system")
@unsafe(reason: "Win64 copied system CPU counters", capabilities: [ffi, raw_ptr])
extern fn GetSystemTimes(idle: i64, kernel: i64, user: i64) -> i32
@abi("system")
@unsafe(reason: "Win64 kernel32 bounded allocation", capabilities: [ffi, raw_ptr])
extern fn HeapAlloc(heap: i64, flags: u32, size: u64) -> i64
@abi("system")
@unsafe(reason: "Win64 kernel32 owned allocation release", capabilities: [ffi, raw_ptr])
extern fn HeapFree(heap: i64, flags: u32, allocation: i64) -> i32
@end
# Runtime-C memory headroom snapshot; resolves under the bootstrap seed's
# pure interpreter where the raw kernel32 heap externs above do not. Returns
# min(ullAvailPhys, ullAvailPageFile), 0 when unavailable (callers fall back).
@unsafe(reason: "registered runtime ABI for the host memory headroom snapshot", capabilities: [ffi])
extern fn rt_host_memory_headroom_bytes_v1() -> i64
# Runtime-C commit headroom ((CommitLimit-CommitTotal)*PageSize); same
# interpreter-first rationale, 0 when unavailable (callers fall back).
@unsafe(reason: "registered runtime ABI for the host commit headroom snapshot", capabilities: [ffi])
extern fn rt_host_commit_headroom_bytes_v1() -> i64
# Runtime-C per-volume available-bytes snapshot for a path; same
# interpreter-first rationale, 0 when unavailable (callers fall back).
@unsafe(reason: "registered runtime ABI for the host disk headroom snapshot", capabilities: [ffi])
extern fn rt_host_disk_headroom_bytes_v1(path: text) -> i64
