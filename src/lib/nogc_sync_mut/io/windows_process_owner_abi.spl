@when(arch="x86"):
pub fn windows_abi_pointer_bits() -> i64:
    32

pub fn windows_abi_pointer_bytes() -> i64:
    4

pub fn windows_abi_size_t_max() -> i64:
    4294967295

@unsafe(reason: "target-width Win32 pointer slot read", capabilities: [ffi, raw_ptr])
pub fn windows_abi_read_ptr(addr: i64) -> i64:
    volatile_read_u32(addr)

@unsafe(reason: "target-width Win32 pointer slot write", capabilities: [ffi, raw_ptr])
pub fn windows_abi_write_ptr(addr: i64, value: i64):
    volatile_write_u32(addr, value)

@unsafe(reason: "target-width Win32 GetProcessHeap wrapper", capabilities: [ffi])
pub fn windows_abi_get_process_heap() -> i64:
    GetProcessHeap() as i64

@unsafe(reason: "target-width Win32 HeapAlloc wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_heap_alloc(heap: i64, size: i64) -> i64:
    if size < 0 or size > 4294967295: return 0
    HeapAlloc(heap as u32, 8u32, size as u32) as i64

@unsafe(reason: "target-width Win32 HeapFree wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_heap_free(heap: i64, allocation: i64) -> i32:
    HeapFree(heap as u32, 0u32, allocation as u32)

@unsafe(reason: "target-width Win32 GetModuleFileNameW wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_get_module_file_name_w(module: i64, buffer: i64, capacity: i64) -> i64:
    GetModuleFileNameW(module as u32, buffer as u32, capacity as u32) as i64

@unsafe(reason: "target-width Win32 UpdateProcThreadAttribute wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_update_proc_thread_attribute(attributes: i64, kind: i64, value: i64, size: i64) -> i32:
    UpdateProcThreadAttribute(attributes as u32, 0u32, kind as u32, value as u32, size as u32, 0u32, 0u32)
@else:
pub fn windows_abi_pointer_bits() -> i64:
    64

pub fn windows_abi_pointer_bytes() -> i64:
    8

pub fn windows_abi_size_t_max() -> i64:
    9223372036854775807

@unsafe(reason: "target-width Win64 pointer slot read", capabilities: [ffi, raw_ptr])
pub fn windows_abi_read_ptr(addr: i64) -> i64:
    volatile_read_u64(addr)

@unsafe(reason: "target-width Win64 pointer slot write", capabilities: [ffi, raw_ptr])
pub fn windows_abi_write_ptr(addr: i64, value: i64):
    volatile_write_u64(addr, value)

@unsafe(reason: "target-width Win64 GetProcessHeap wrapper", capabilities: [ffi])
pub fn windows_abi_get_process_heap() -> i64:
    GetProcessHeap()

@unsafe(reason: "target-width Win64 HeapAlloc wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_heap_alloc(heap: i64, size: i64) -> i64:
    if size < 0: return 0
    HeapAlloc(heap, 8u32, size as u64)

@unsafe(reason: "target-width Win64 HeapFree wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_heap_free(heap: i64, allocation: i64) -> i32:
    HeapFree(heap, 0u32, allocation)

@unsafe(reason: "target-width Win64 GetModuleFileNameW wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_get_module_file_name_w(module: i64, buffer: i64, capacity: i64) -> i64:
    GetModuleFileNameW(module, buffer, capacity as u32) as i64

@unsafe(reason: "target-width Win64 UpdateProcThreadAttribute wrapper", capabilities: [ffi, raw_ptr])
pub fn windows_abi_update_proc_thread_attribute(attributes: i64, kind: i64, value: i64, size: i64) -> i32:
    UpdateProcThreadAttribute(attributes, 0u32, kind as u64, value, size as u64, 0, 0)
@end

fn _windows_abi_pick(bits: i64, x86_value: i64, x64_value: i64) -> i64:
    if bits == 32: x86_value else: x64_value

pub fn windows_abi_pointer_bytes_for(bits: i64) -> i64:
    _windows_abi_pick(bits, 4, 8)

pub fn windows_abi_security_attributes_size_for(bits: i64) -> i64:
    _windows_abi_pick(bits, 12, 24)

pub fn windows_abi_security_attributes_descriptor_offset_for(bits: i64) -> i64:
    _windows_abi_pick(bits, 4, 8)

pub fn windows_abi_security_attributes_inherit_offset_for(bits: i64) -> i64:
    _windows_abi_pick(bits, 8, 16)

pub fn windows_abi_startupinfo_size_for(bits: i64) -> i64:
    _windows_abi_pick(bits, 68, 104)

pub fn windows_abi_startupinfo_flags_offset_for(bits: i64) -> i64:
    _windows_abi_pick(bits, 44, 60)

