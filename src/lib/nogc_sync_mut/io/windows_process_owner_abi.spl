# INVALID_HANDLE_VALUE is (HANDLE)-1. A 32-bit slot read by
# windows_abi_read_ptr zero-extends it to 0xFFFFFFFF, so compare width-correctly.
pub fn windows_abi_handle_is_invalid_for(bits: i64, handle: i64) -> bool:
    if handle == -1: return true
    bits == 32 and handle == 4294967295

pub fn windows_abi_handle_is_invalid(handle: i64) -> bool:
    windows_abi_handle_is_invalid_for(windows_abi_pointer_bits(), handle)

