# Win64 direct platform boundary; no new runtime/C implementation. This module
# is intentionally outside the builder closure until native qualification.
# Pointer-valued Win64 ABI slots use i64; DWORD/BOOL slots use u32/i32.
use std.nogc_sync_mut.io.volatile_ops.{volatile_write_u16, volatile_write_u32, volatile_read_u32, volatile_read_u64}

@unsafe(reason: "Win64 kernel32 process heap owner", capabilities: [ffi])
extern fn GetProcessHeap() -> i64
@unsafe(reason: "Win64 current host memory snapshot", capabilities: [ffi, raw_ptr])
extern fn GlobalMemoryStatusEx(status: i64) -> i32
@unsafe(reason: "Win64 copied system CPU counters", capabilities: [ffi, raw_ptr])
extern fn GetSystemTimes(idle: i64, kernel: i64, user: i64) -> i32
@unsafe(reason: "Win64 kernel32 bounded allocation", capabilities: [ffi, raw_ptr])
extern fn HeapAlloc(heap: i64, flags: u32, size: u64) -> i64
@unsafe(reason: "Win64 kernel32 owned allocation release", capabilities: [ffi, raw_ptr])
extern fn HeapFree(heap: i64, flags: u32, allocation: i64) -> i32
@unsafe(reason: "Win64 exact ten-argument process creation ABI", capabilities: [ffi, raw_ptr])
extern fn CreateProcessW(application: i64, command_line: i64, process_security: i64,
    thread_security: i64, inherit_handles: i32, flags: u32, environment: i64,
    directory: i64, startup_info: i64, process_info: i64) -> i32
@unsafe(reason: "Win64 noninherited JobObject creation", capabilities: [ffi])
extern fn CreateJobObjectW(attributes: i64, name: i64) -> i64
@unsafe(reason: "Win64 owned JobObject limit configuration", capabilities: [ffi, raw_ptr])
extern fn SetInformationJobObject(job: i64, kind: i32, information: i64, size: u32) -> i32
@unsafe(reason: "Win64 suspended child assignment before execution", capabilities: [ffi])
extern fn AssignProcessToJobObject(job: i64, process: i64) -> i32
@unsafe(reason: "Win64 resume of owned primary thread", capabilities: [ffi])
extern fn ResumeThread(thread: i64) -> u32
@unsafe(reason: "Win64 handle-authoritative process wait", capabilities: [ffi])
extern fn WaitForSingleObject(handle: i64, milliseconds: u32) -> u32
@unsafe(reason: "Win64 owned JobObject tree cancellation", capabilities: [ffi])
extern fn TerminateJobObject(job: i64, exit_code: u32) -> i32
@unsafe(reason: "Win64 suspended admission-failure process cancellation", capabilities: [ffi])
extern fn TerminateProcess(process: i64, exit_code: u32) -> i32
@unsafe(reason: "Win64 owned handle closure", capabilities: [ffi])
extern fn CloseHandle(handle: i64) -> i32
@unsafe(reason: "Win64 exact owned process exit status", capabilities: [ffi, raw_ptr])
extern fn GetExitCodeProcess(process: i64, status: i64) -> i32
@unsafe(reason: "Win64 JobObject active member observation", capabilities: [ffi, raw_ptr])
extern fn QueryInformationJobObject(job: i64, kind: i32, information: i64, size: u32, returned: i64) -> i32
@unsafe(reason: "Win64 monotonic timeout clock", capabilities: [ffi])
extern fn GetTickCount64() -> u64
@unsafe(reason: "Win64 bounded process observation delay", capabilities: [ffi])
extern fn Sleep(milliseconds: u32)
@unsafe(reason: "Win64 file identity and inherited stream handle admission", capabilities: [ffi, raw_ptr])
extern fn CreateFileW(path: i64, access: u32, sharing: u32, security: i64,
    disposition: u32, attributes: u32, template_file: i64) -> i64
@unsafe(reason: "Win64 explicit child handle-list sizing and initialization", capabilities: [ffi, raw_ptr])
extern fn InitializeProcThreadAttributeList(attributes: i64, count: u32, flags: u32, size: i64) -> i32
@unsafe(reason: "Win64 exact child handle allowlist", capabilities: [ffi, raw_ptr])
extern fn UpdateProcThreadAttribute(attributes: i64, flags: u32, kind: u64,
    value: i64, size: u64, previous: i64, returned: i64) -> i32
@unsafe(reason: "Win64 owned attribute-list cleanup", capabilities: [ffi, raw_ptr])
extern fn DeleteProcThreadAttributeList(attributes: i64)
@unsafe(reason: "Win64 immediate thread-local API error observation", capabilities: [ffi])
extern fn GetLastError() -> u32
@unsafe(reason: "Win64 metadata query on an already owned file identity", capabilities: [ffi, raw_ptr])
extern fn GetFileInformationByHandleEx(file: i64, kind: i32, information: i64, size: u32) -> i32
@unsafe(reason: "Win64 bounded read from a pinned file handle", capabilities: [ffi, raw_ptr])
extern fn ReadFile(file: i64, buffer: i64, capacity: u32, count: i64, overlapped: i64) -> i32
@unsafe(reason: "Windows CNG SHA256 provider acquisition", capabilities: [ffi, raw_ptr])
extern fn BCryptOpenAlgorithmProvider(provider: i64, algorithm: i64, implementation: i64, flags: u32) -> i32
@unsafe(reason: "Windows CNG owned streaming hash creation", capabilities: [ffi, raw_ptr])
extern fn BCryptCreateHash(provider: i64, hash_out: i64, object_buffer: i64, object_size: u32, secret: i64, secret_size: u32, flags: u32) -> i32
@unsafe(reason: "Windows CNG hash of a bounded owned byte buffer", capabilities: [ffi, raw_ptr])
extern fn BCryptHashData(hash: i64, buffer: i64, count: u32, flags: u32) -> i32
@unsafe(reason: "Windows CNG SHA256 digest finalization", capabilities: [ffi, raw_ptr])
extern fn BCryptFinishHash(hash: i64, digest: i64, digest_size: u32, flags: u32) -> i32
@unsafe(reason: "Windows CNG owned hash release", capabilities: [ffi])
extern fn BCryptDestroyHash(hash: i64) -> i32
@unsafe(reason: "Windows CNG owned provider release", capabilities: [ffi])
extern fn BCryptCloseAlgorithmProvider(provider: i64, flags: u32) -> i32

# ASCII-only proof helper. The production owner must provide full UTF16.
@unsafe(reason: "writes only inside a zeroed owned UTF16 allocation", capabilities: [ffi, raw_ptr])
fn windows_abi_ascii_v1(heap: i64, value: text) -> i64:
    val allocation = HeapAlloc(heap, 8u32, ((value.len() + 1) * 2) as u64)
    if allocation == 0: return 0
    var index = 0
    while index < value.len():
        val scalar = value.char_code_at(index)
        if scalar < 0 or scalar > 127:
            val _freed = HeapFree(heap, 0u32, allocation)
            return 0
        volatile_write_u16(allocation + index * 2, scalar)
        index = index + 1
    allocation

@unsafe(reason: "native proof owns all allocations, handles and suspended children", capabilities: [ffi, raw_ptr])
fn windows_process_abi_case_v1(command: text, cancel: bool) -> i64:
    val heap = GetProcessHeap()
    if heap == 0: return 10
    val application = windows_abi_ascii_v1(heap, "C:\\Windows\\System32\\cmd.exe")
    val command_line = windows_abi_ascii_v1(heap, command)
    val directory = windows_abi_ascii_v1(heap, "C:\\Windows")
    # Windows x64 SDK layouts: STARTUPINFOW=104, PROCESS_INFORMATION=24,
    # JOBOBJECT_EXTENDED_LIMIT_INFORMATION=144, BASIC_ACCOUNTING=48.
    val startup = HeapAlloc(heap, 8u32, 104u64)
    val process_info = HeapAlloc(heap, 8u32, 24u64)
    val limits = HeapAlloc(heap, 8u32, 144u64)
    val accounting = HeapAlloc(heap, 8u32, 48u64)
    val exit_slot = HeapAlloc(heap, 8u32, 8u64)
    var allocations: [i64] = [application, command_line, directory, startup, process_info, limits, accounting, exit_slot]
    var code: i64 = 0
    for address in allocations:
        if address == 0: code = 11
    var job: i64 = 0
    var process: i64 = 0
    var thread: i64 = 0
    if code == 0:
        volatile_write_u32(startup, 104)
        # LimitFlags offset16, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE=0x2000.
        volatile_write_u32(limits + 16, 8192)
        job = CreateJobObjectW(0, 0)
        if job == 0: code = 12
    if code == 0 and SetInformationJobObject(job, 9, limits, 144u32) == 0: code = 13
    if code == 0:
        # CREATE_SUSPENDED | CREATE_NO_WINDOW. No inherited handles.
        val created = CreateProcessW(application, command_line, 0, 0, 0,
            134217732u32, 0, directory, startup, process_info)
        if created == 0:
            code = 14
        else:
            process = volatile_read_u64(process_info)
            thread = volatile_read_u64(process_info + 8)
    if code == 0 and AssignProcessToJobObject(job, process) == 0: code = 15
    if code == 0 and ResumeThread(thread) == 4294967295u32: code = 16
    if code == 0 and cancel:
        # Require the fixture to really create a descendant before cancellation.
        val deadline = GetTickCount64() + 10000u64
        var descendants = false
        while GetTickCount64() < deadline and not descendants:
            if QueryInformationJobObject(job, 1, accounting, 48u32, 0) == 0:
                code = 17
                break
            descendants = volatile_read_u32(accounting + 40) >= 2
            if not descendants: Sleep(10u32)
        if not descendants: code = 18
        if TerminateJobObject(job, 125u32) == 0: code = 19
    if code == 0:
        if WaitForSingleObject(process, 10000u32) != 0u32: code = 20
        if GetExitCodeProcess(process, exit_slot) == 0:
            code = 21
        elif not cancel and volatile_read_u32(exit_slot) != 37:
            code = 22
        val deadline = GetTickCount64() + 10000u64
        var empty = false
        while GetTickCount64() < deadline and not empty:
            if QueryInformationJobObject(job, 1, accounting, 48u32, 0) == 0:
                code = 23
                break
            empty = volatile_read_u32(accounting + 40) == 0
            if not empty: Sleep(10u32)
        if not empty: code = 24
    if code != 0 and process != 0:
        val _job_killed = TerminateJobObject(job, 125u32)
        val _process_killed = TerminateProcess(process, 125u32)
        val _waited = WaitForSingleObject(process, 10000u32)
    if thread != 0:
        val _closed = CloseHandle(thread)
    if process != 0:
        val _closed = CloseHandle(process)
    if job != 0:
        val _closed = CloseHandle(job)
    for address in allocations:
        if address != 0:
            val _freed = HeapFree(heap, 0u32, address)
    code

fn windows_process_abi_proof_v1() -> i64:
    val normal = windows_process_abi_case_v1("cmd.exe /d /c exit 37", false)
    if normal != 0: return normal
    windows_process_abi_case_v1("cmd.exe /d /c C:\\Windows\\System32\\ping.exe -n 30 127.0.0.1", true)

export windows_process_abi_proof_v1
export GetProcessHeap, GlobalMemoryStatusEx, GetSystemTimes, HeapAlloc, HeapFree, CreateProcessW, CreateJobObjectW
export SetInformationJobObject, AssignProcessToJobObject, ResumeThread
export WaitForSingleObject, TerminateJobObject, TerminateProcess, CloseHandle
export GetExitCodeProcess, QueryInformationJobObject, GetTickCount64, Sleep
export CreateFileW, InitializeProcThreadAttributeList, UpdateProcThreadAttribute
export DeleteProcThreadAttributeList, GetLastError
export GetFileInformationByHandleEx, ReadFile, BCryptOpenAlgorithmProvider
export BCryptCreateHash, BCryptHashData, BCryptFinishHash, BCryptDestroyHash, BCryptCloseAlgorithmProvider
