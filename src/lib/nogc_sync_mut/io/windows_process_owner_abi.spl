# Windows direct platform boundary shared by x86_64, arm64 and i686 (no fork of
# the x86_64 code); no new runtime/C implementation. This module is
# intentionally outside the builder closure until native qualification.
#
# Pointer width comes from the target: WinPtr/WIN_PTR_BYTES below are the ONLY
# place the word size is chosen. Pointer-valued ABI slots (pointers, HANDLE,
# HMODULE, LPVOID, SIZE_T/ULONG_PTR returns, by-reference SIZE_T) use WinPtr;
# SIZE_T / DWORD_PTR passed by value use WinSize (u64 on 64-bit, u32 on i686);
# DWORD/BOOL/UINT/ULONG slots use u32/i32; ULONGLONG uses u64.
# Win32 externs are @abi("system") (stdcall on x86-windows, plain C elsewhere).
#
# Struct layouts (pure math in windows_process_layout.spl, p = WIN_PTR_BYTES),
# checked against the Windows SDK for both widths (x64 / x86 bytes):
#   STARTUPINFOW 104/68, STARTUPINFOEXW 112/72, PROCESS_INFORMATION 24/16,
#   SECURITY_ATTRIBUTES 24/12, JOBOBJECT_BASIC_LIMIT_INFORMATION 64/48,
#   JOBOBJECT_EXTENDED_LIMIT_INFORMATION 144/112 (JobMemoryLimit 120/100,
#   PeakJobMemoryUsed 136/108), JOBOBJECT_BASIC_ACCOUNTING_INFORMATION 48/48,
#   handle-list attribute payload 3*p. DWORD-only structs (FILE_ATTRIBUTE_TAG_
#   INFO, exit code slot, ReadFile byte count) do not depend on pointer width.
# On x86_64 (WinPtr = i64, WIN_PTR_BYTES = 8) every offset, size and extern
# type equals the previous Win64-only values.
use std.nogc_sync_mut.io.volatile_ops.{volatile_write_u16, volatile_write_u32, volatile_write_u64, volatile_read_u32, volatile_read_u64}
use std.nogc_sync_mut.io.windows_process_layout.{windows_startupinfo_size, windows_process_info_size, windows_job_extended_limit_size, windows_job_accounting_size, windows_job_accounting_active_offset, windows_process_info_thread_offset}

@when(arch="x86"):
type WinPtr = i32
type WinSize = u32
val WIN_PTR_BYTES = 4
@else:
type WinPtr = i64
type WinSize = u64
val WIN_PTR_BYTES = 8
@end

# Pointer-width memory slot access; values stay i64 in Simple code.
@unsafe(reason: "pointer-width store into caller-owned memory", capabilities: [ffi, raw_ptr])
fn win_ptr_write(address: i64, value: i64):
    if WIN_PTR_BYTES == 4:
        volatile_write_u32(address, value)
    else:
        volatile_write_u64(address, value)

@unsafe(reason: "pointer-width load from caller-owned memory", capabilities: [ffi, raw_ptr])
fn win_ptr_read(address: i64) -> i64:
    if WIN_PTR_BYTES == 4:
        return volatile_read_u32(address)
    volatile_read_u64(address)


@unsafe(reason: "Win64 kernel32 process heap owner", capabilities: [ffi])
@abi("system")
extern fn GetProcessHeap() -> WinPtr
@unsafe(reason: "Win64 current process image copied into caller-owned UTF16 storage", capabilities: [ffi, raw_ptr])
@abi("system")
extern fn GetModuleFileNameW(module: WinPtr, buffer: WinPtr, capacity: u32) -> u32
@unsafe(reason: "Win64 current host memory snapshot", capabilities: [ffi, raw_ptr])
@abi("system")
extern fn GlobalMemoryStatusEx(status: WinPtr) -> i32
@unsafe(reason: "Win64 copied system CPU counters", capabilities: [ffi, raw_ptr])
@abi("system")
extern fn GetSystemTimes(idle: WinPtr, kernel: WinPtr, user: WinPtr) -> i32
@unsafe(reason: "Win64 kernel32 bounded allocation", capabilities: [ffi, raw_ptr])
@abi("system")
extern fn HeapAlloc(heap: WinPtr, flags: u32, size: WinSize) -> WinPtr
@unsafe(reason: "Win64 kernel32 owned allocation release", capabilities: [ffi, raw_ptr])
@abi("system")
extern fn HeapFree(heap: WinPtr, flags: u32, allocation: WinPtr) -> i32
# Runtime-C memory headroom snapshot; resolves under the bootstrap seed's
# pure interpreter where the raw kernel32 heap externs above do not. Returns
# min(ullAvailPhys, ullAvailPageFile), 0 when unavailable (callers fall back).
@unsafe(reason: "registered runtime ABI for the host memory headroom snapshot", capabilities: [ffi])
extern fn rt_host_memory_headroom_bytes_v1() -> i64
# Runtime-C commit headroom ((CommitLimit-CommitTotal)*PageSize); same
# interpreter-first rationale, 0 when unavailable (callers fall back).
@unsafe(reason: "registered runtime ABI for the host commit headroom snapshot", capabilities: [ffi])
extern fn rt_host_commit_headroom_bytes_v1() -> i64
# Runtime-C per-volume available-bytes snapshot for a path; same
# interpreter-first rationale, 0 when unavailable (callers fall back).
@unsafe(reason: "registered runtime ABI for the host disk headroom snapshot", capabilities: [ffi])
extern fn rt_host_disk_headroom_bytes_v1(path: text) -> i64
