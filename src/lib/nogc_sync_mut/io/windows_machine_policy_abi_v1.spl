# Narrow direct Win64 SDK/NT ABI only. SOURCE_AUTHORED_NOT_RUN.
# No runtime/C shim. Native qualification requires exact import libraries:
# SHGetKnownFolderPath=shell32, CoTaskMemFree=ole32, NtCreateFile and
# NtQueryVolumeInformationFile=ntdll,
# OpenThreadToken=advapi32, GetCurrentThread=kernel32. Ordinary native_linking
# and msvc default lists currently omit shell32/ole32; no fallback is admitted.
# SDK references:
# https://learn.microsoft.com/windows/win32/api/shlobj_core/nf-shlobj_core-shgetknownfolderpath
# https://learn.microsoft.com/windows/win32/api/winternl/nf-winternl-ntcreatefile
# https://learn.microsoft.com/windows/win32/api/ntdef/ns-ntdef-_object_attributes
# https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/nf-ntifs-ntqueryvolumeinformationfile

@when(os="windows"):
pub use std.nogc_sync_mut.io.windows_process_owner_abi.{GetProcessHeap, HeapAlloc, HeapFree,
    CloseHandle, GetLastError, ReadFile, GetFileInformationByHandleEx}
pub use std.nogc_sync_mut.io.retained_file_abi.{GetFileType, SetFilePointerEx}
pub use std.nogc_sync_mut.io.windows_engine_pipe_abi_v1.{GetSecurityInfo,
    GetSecurityDescriptorLength, GetSecurityDescriptorControl, IsValidAcl,
    GetAclInformation, GetAce, IsValidSid, IsWellKnownSid, LocalFree}
pub use std.nogc_sync_mut.io.windows_job_stream_abi_v2.rt_windows_pty_owner_thread_guard_v1

@unsafe(reason: "fixed ProgramData GUID lookup returning an owned native UTF16 string even on failure", capabilities: [ffi, raw_ptr])
extern fn SHGetKnownFolderPath(folder_id: i64, flags: u32, token: i64, path_out: i64) -> i32
@unsafe(reason: "release only the retained shell-allocated known-folder string; void release contract", capabilities: [ffi, raw_ptr])
extern fn CoTaskMemFree(memory: i64)
@unsafe(reason: "exact Win64 eleven-argument native read-only relative open with retained OBJECT_ATTRIBUTES and IO_STATUS_BLOCK", capabilities: [ffi, raw_ptr])
extern fn NtCreateFile(file_out: i64, access: u32, attributes: i64, status: i64,
    allocation_size: i64, file_attributes: u32, share: u32, disposition: u32,
    options: u32, ea: i64, ea_size: u32) -> i32
@unsafe(reason: "query actual retained root volume device type and remote characteristic into bounded owner storage", capabilities: [ffi, raw_ptr])
extern fn NtQueryVolumeInformationFile(file: i64, status: i64, information: i64,
    size: u32, information_class: i32) -> i32
@unsafe(reason: "borrow current thread pseudo-handle only to refuse impersonated file provenance", capabilities: [ffi])
extern fn GetCurrentThread() -> i64
@unsafe(reason: "detect any current-thread token without trusting its SID; retain every output for cleanup", capabilities: [ffi, raw_ptr])
extern fn OpenThreadToken(thread: i64, access: u32, open_as_self: i32, token_out: i64) -> i32

export SHGetKnownFolderPath, CoTaskMemFree, NtCreateFile, NtQueryVolumeInformationFile, GetCurrentThread, OpenThreadToken
@end
