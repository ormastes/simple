# Process-local private file mode for the trusted single-primary bootstrap.
# No runtime export. Caller retains old mask until failure cleanup; successful
# agent replacement intentionally keeps0077. This is not thread/isolation proof.
@when(os="linux"):
@unsafe(reason: "select private creation mask in the already admitted primary process", capabilities: [ffi])
extern fn umask(mask: u32) -> u32
# allow(primitive_api): reviewed DATA predicate/bound/umask word (milestone_0012 groupC)
pub fn linux_agent_bootstrap_umask_take_v1() -> u32:
    unsafe(capabilities: [ffi]): umask(63u32)
# allow(primitive_api): reviewed DATA predicate/bound/umask word (milestone_0012 groupC)
pub fn linux_agent_bootstrap_umask_restore_v1(previous: u32):
    val ignored = unsafe(capabilities: [ffi]): umask(previous)
@end
