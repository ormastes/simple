@unsafe(reason: "retains Job, file pins, launch allocations and attempted child identity in one existing PTY slot", capabilities: [ffi, raw_ptr])
pub fn windows_managed_stream_admit_v2(request: WindowsManagedStreamRequestV2) -> WindowsManagedStreamAdmissionV2:
    val owner_thread = _windows_pty_owner_entry_result_v2()
    if owner_thread.is_err(): return WindowsManagedStreamAdmissionV2.Rejected(owner_thread.unwrap_err())
    val host = match windows_managed_stream_host_observe_v2():
        case Ok(value): value
        case Err(reason): return WindowsManagedStreamAdmissionV2.Rejected(reason)
    val reason = windows_managed_stream_request_reason_v2(request, host)
    if reason != "": return WindowsManagedStreamAdmissionV2.Rejected(reason)
    val lease = match _windows_pty_managed_reserve_v2():
        case Ok(value): value
        case Err(reason): return WindowsManagedStreamAdmissionV2.Rejected(reason)
    var state = match _windows_pty_managed_load_v2(lease):
        case Ok(value): value
        case Err(reason): return WindowsManagedStreamAdmissionV2.CleanupRequired(lease, reason)
    state.managed_host_groups = host.processor_groups
    state.managed_host_processors = host.logical_processors
    state.managed_host_quantum = host.cpu_quantum_millis
    state.managed_host_nested = host.process_in_job
    val pin = _windows_process_pin_retained_v2(state.heap, request.program, request.producer_digest,
        request.launch_expires_at_unix_ms)
    if pin.file != 0: state.managed_pins = state.managed_pins.push(pin.file)
    state.managed_hash = pin.hash
    state.managed_algorithm = pin.algorithm
    state.temporaries = state.temporaries + pin.allocations
    state.release_failed = pin.release_failed
    if not pin.digest_matches:
        return _windows_managed_failed_v2(lease, state, "Windows managed producer pin/digest or retained hash cleanup failed: " + pin.reason)
    val launch = _windows_managed_prepare_v2(state, request)
    state = launch.0
    val prepared = launch.1
    if prepared.error != "": return _windows_managed_failed_v2(lease, state, prepared.error)
    val pipes = _windows_managed_raw_pipes_v2(state, lease)
    state = pipes.0
    if pipes.1 != "": return _windows_managed_failed_v2(lease, state, pipes.1)
    state.job = CreateJobObjectW(0, 0)
    if state.job == 0: return _windows_managed_failed_v2(lease, state, "Windows managed Job creation failed")
    val policy = windows_managed_stream_job_policy_v2(state, request, host)
    if policy.is_err(): return _windows_managed_failed_v2(lease, state, policy.unwrap_err())
    val startup = state.arena + 12704
    val process_info = state.arena + 12816
    val allowed = state.arena + 12984
    val _sized = InitializeProcThreadAttributeList(0, 1u32, 0u32, state.arena + 48)
    val size = volatile_read_u64(state.arena + 48)
    if size <= 0 or size > 1048576: return _windows_managed_failed_v2(lease, state, "Windows managed attribute size invalid")
    val attributes = HeapAlloc(state.heap, 8u32, size)
    state.temporaries = state.temporaries.push(attributes)
    if attributes == 0: return _windows_managed_failed_v2(lease, state, "Windows managed attribute allocation failed")
    if InitializeProcThreadAttributeList(attributes, 1u32, 0u32, state.arena + 48) == 0:
        return _windows_managed_failed_v2(lease, state, "Windows managed attribute initialization failed")
    # Retain initialized attribute identity until checked collect, including failures.
    state.managed_attributes = attributes
    volatile_write_u64(allowed, state.input_server)
    volatile_write_u64(allowed + 8, state.output_server)
    if UpdateProcThreadAttribute(attributes, 0u32, 131074u64, allowed, 16u64, 0, 0) == 0:
        return _windows_managed_failed_v2(lease, state, "Windows managed HANDLE_LIST admission failed")
    volatile_write_u32(startup, 112)
    volatile_write_u32(startup + 60, 256)
    volatile_write_u64(startup + 80, state.input_server)
    volatile_write_u64(startup + 88, state.output_server)
    volatile_write_u64(startup + 96, state.output_server)
    volatile_write_u64(startup + 104, attributes)
    val before_create = windows_managed_stream_launch_check_v2(request, host, state.arena + 13024)
    if before_create.is_err(): return _windows_managed_failed_v2(lease, state, before_create.unwrap_err())
    state.managed_create_attempted = true
    # Suspended + UNICODE_ENVIRONMENT + EXTENDED_STARTUPINFO + NO_WINDOW.
    val created = CreateProcessW(prepared.application, prepared.command, 0, 0, 1,
        134743044u32, prepared.environment, prepared.directory, startup, process_info)
    state.process = volatile_read_u64(process_info)
    state.thread = volatile_read_u64(process_info + 8)
    state.pid = volatile_read_u32(process_info + 16)
    if created == 0: return _windows_managed_failed_v2(lease, state, "Windows managed CreateProcess attempted; cleanup authority retained")
    if state.process == 0 or state.thread == 0: return _windows_managed_failed_v2(lease, state, "Windows managed attempted child handles incomplete")
    if AssignProcessToJobObject(state.job, state.process) == 0:
        return _windows_managed_failed_v2(lease, state, "Windows managed suspended Job assignment failed")
    state.managed_assigned = true
    # Close parent copies of child-only endpoints before resume/EOF observation.
    if CloseHandle(state.input_server) == 0: return _windows_managed_failed_v2(lease, state, "Windows managed parent input endpoint release failed")
    state.input_server = 0
    if CloseHandle(state.output_server) == 0: return _windows_managed_failed_v2(lease, state, "Windows managed parent output endpoint release failed")
    state.output_server = 0
    val before_resume = windows_managed_stream_launch_check_v2(request, host, state.arena + 13024)
    if before_resume.is_err(): return _windows_managed_failed_v2(lease, state, before_resume.unwrap_err())
    if ResumeThread(state.thread) == 4294967295u32:
        return _windows_managed_failed_v2(lease, state, "Windows managed resume outcome failed or uncertain")
