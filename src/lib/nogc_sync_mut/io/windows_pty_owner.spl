fn _windows_managed_receipt_v2(state: WindowsPtyStateV1, leader: bool, empty: bool) -> WindowsManagedStreamPollV2:
    WindowsManagedStreamPollV2(leader_reaped: leader, job_empty: empty, pending_io: state.pending,
        closed: state.closed, exit_code: state.managed_exit_code,
        timed_out: state.managed_timed_out, cancelled: state.managed_cancelled)

@unsafe(reason: "retained handles prove leader exit and exact Job active-member emptiness", capabilities: [ffi, raw_ptr])
pub fn windows_managed_stream_poll_v2(lease: WindowsManagedStreamLeaseV2) -> Result<WindowsManagedStreamPollV2, text>:
    val owner_thread = _windows_pty_owner_entry_result_v2()?
    var state = _windows_pty_managed_load_v2(lease)?
    if state.closed: return Ok(_windows_managed_receipt_v2(state, state.terminal_observed, state.terminal_observed))
    if state.managed_create_attempted and state.process == 0 and not state.terminal_observed:
        return Err("Windows attempted child identity unknown; ownership retained")
    state = _windows_pty_managed_complete_v2(state)
    state = _windows_pty_managed_store_v2(lease, state)?
    if state.managed_started and not state.managed_cancelled and not state.terminal_observed:
        val expected = WindowsManagedStreamHostV2(processor_groups: state.managed_host_groups,
            logical_processors: state.managed_host_processors, process_in_job: state.managed_host_nested,
            cpu_quantum_millis: state.managed_host_quantum)
        val current = windows_managed_stream_host_at_v2(state.arena + 13024)
        var drift = _windows_managed_host_drift_v2
        match current:
            case Err(_): drift = true
            case Ok(observed):
                if not windows_managed_host_profile_matches_v2(expected, observed): drift = true
        if drift:
            _windows_managed_host_drift_v2 = true
            state.managed_profile_drift = true
            state.failed = true
            state.closing = true
            state = _windows_pty_managed_store_v2(lease, state)?
            if TerminateJobObject(state.job, 125u32) == 0:
                return Err("Windows changed CPU profile; Job cancellation failed and ownership remains charged")
            state.managed_cancelled = true
            state = _windows_pty_managed_store_v2(lease, state)?
    if (state.managed_started and not state.terminal_observed and not state.managed_cancelled and state.managed_deadline != 0u64 and
            GetTickCount64() >= state.managed_deadline):
        if TerminateJobObject(state.job, 124u32) == 0: return Err("Windows managed lifetime cancellation failed")
        state.managed_timed_out = true
        state.managed_cancelled = true
        state.closing = true
    var leader = state.terminal_observed or not state.managed_create_attempted
    if state.process != 0:
        val observed = WaitForSingleObject(state.process, 0u32)
        if observed != 0u32 and observed != 258u32: return Err("Windows managed leader observation failed")
        leader = observed == 0u32
        if leader:
            if GetExitCodeProcess(state.process, state.arena + 12960) == 0: return Err("Windows managed exit status unavailable")
            state.managed_exit_code = volatile_read_u32(state.arena + 12960)
    var empty = state.terminal_observed or (not state.managed_create_attempted and state.job == 0)
    if state.job != 0:
        if QueryInformationJobObject(state.job, 1, state.arena + 12904, 48u32, 0) == 0:
            return Err("Windows managed Job membership unavailable")
        empty = volatile_read_u32(state.arena + 12944) == 0u32
    state = _windows_pty_managed_store_v2(lease, state)?
    Ok(_windows_managed_receipt_v2(state, leader, empty))

@unsafe(reason: "reads only peeked bounded bytes without decoding or unbounded waits", capabilities: [ffi, raw_ptr])
pub fn windows_managed_stream_read_bytes_v2(lease: WindowsManagedStreamLeaseV2, max_bytes: i64) -> WindowsManagedStreamReadV2:
    val owner_thread = _windows_pty_owner_entry_result_v2()
    if owner_thread.is_err(): return WindowsManagedStreamReadV2.Failed(owner_thread.unwrap_err())
    if max_bytes <= 0 or max_bytes > 8192: return WindowsManagedStreamReadV2.Failed("Windows managed read bound invalid")
    var state = match _windows_pty_managed_load_v2(lease):
        case Ok(value): value
        case Err(reason): return WindowsManagedStreamReadV2.Failed(reason)
    if state.managed_output_end: return WindowsManagedStreamReadV2.End
    if state.closed or not state.managed_started or state.output == 0:
        return WindowsManagedStreamReadV2.Failed("Windows managed output is unavailable")
    if PeekNamedPipe(state.output, 0, 0u32, 0, state.arena + 24, 0) == 0:
        val error = GetLastError()
        if error == 109u32 or error == 233u32:
            state.managed_output_end = true
            val stored = _windows_pty_managed_store_v2(lease, state)
            if stored.is_err(): return WindowsManagedStreamReadV2.Failed(stored.unwrap_err())
            return WindowsManagedStreamReadV2.End
        return WindowsManagedStreamReadV2.Failed("Windows managed output peek failed")
    val available = volatile_read_u32(state.arena + 24) as i64
    if available == 0: return WindowsManagedStreamReadV2.Pending
    val count = if available < max_bytes: available else: max_bytes
    if ReadFile(state.output, state.arena + 4224, count as u32, state.arena + 32, 0) == 0:
        return WindowsManagedStreamReadV2.Failed("Windows managed output read failed")
    val received = volatile_read_u32(state.arena + 32) as i64
    if received <= 0 or received > count: return WindowsManagedStreamReadV2.Failed("Windows managed output count invalid")
    var bytes: [u8] = [0u8; received]
    for index in 0..received: bytes[index] = volatile_read_u8(state.arena + 4224 + index) as u8
    WindowsManagedStreamReadV2.Data(bytes)

@unsafe(reason: "submits one bounded input prefix into retained OVERLAPPED storage; zero is backpressure", capabilities: [ffi, raw_ptr])
pub fn windows_managed_stream_write_some_bytes_v2(lease: WindowsManagedStreamLeaseV2, data: [u8]) -> Result<i64, text>:
    val owner_thread = _windows_pty_owner_entry_result_v2()?
    # Refresh topology/lifetime before accepting bytes. A detected drift closes
    # admission/input and requests cancellation, never silently changes affinity.
    val observed = windows_managed_stream_poll_v2(lease)?
    var state = _windows_pty_managed_load_v2(lease)?
    if state.closed or state.closing or state.failed or not state.managed_started:
        return Err("Windows managed input is unavailable")
    state = _windows_pty_managed_complete_v2(state)
    state = _windows_pty_managed_store_v2(lease, state)?
    if state.failed: return Err("Windows managed previous input failed; do not replay")
    if state.pending or data.len() == 0: return Ok(0)
    val count = if data.len() > 4096: 4096 else: data.len()
    for index in 0..count: volatile_write_u8(state.arena + 128 + index, data[index] as i64)
    for index in 0..3: volatile_write_u64(state.arena + 64 + index * 8, 0)
    volatile_write_u32(state.arena + 40, 0)
    if ResetEvent(state.event) == 0:
        state.failed = true
        val retained = _windows_pty_managed_store_v2(lease, state)?
        return Err("Windows managed input event reset failed")
    val submitted = WriteFile(state.input, state.arena + 128, count as u32, state.arena + 40, state.arena + 64)
    if submitted != 0:
        val written = volatile_read_u32(state.arena + 40) as i64
        if written <= 0 or written > count:
            state.failed = true
            val retained = _windows_pty_managed_store_v2(lease, state)?
            return Err("Windows managed synchronous input receipt invalid; do not replay")
        return Ok(written)
    if GetLastError() != 997u32:
        state.failed = true
        val retained = _windows_pty_managed_store_v2(lease, state)?
        return Err("Windows managed input submission failed; do not replay")
    state.pending = true
    state.pending_size = count
    val stored = _windows_pty_managed_store_v2(lease, state)?
    Ok(count)

pub fn windows_managed_stream_input_pending_v2(lease: WindowsManagedStreamLeaseV2) -> Result<bool, text>:
    val owner_thread = _windows_pty_owner_entry_result_v2()?
    var state = _windows_pty_managed_load_v2(lease)?
    if state.closed: return Ok(false)
    state = _windows_pty_managed_complete_v2(state)
    val stored = _windows_pty_managed_store_v2(lease, state)?
    if state.failed: return Err("Windows managed input completion failed or ambiguous")
    Ok(state.pending)

@unsafe(reason: "requests tree and IO cancellation without confusing the request with terminal cleanup", capabilities: [ffi, raw_ptr])
pub fn windows_managed_stream_cancel_v2(lease: WindowsManagedStreamLeaseV2) -> Result<bool, text>:
    val owner_thread = _windows_pty_owner_entry_result_v2()?
    var state = _windows_pty_managed_load_v2(lease)?
    if state.closed: return Ok(true)
    state.closing = true
    state = _windows_pty_managed_store_v2(lease, state)?
    if state.job != 0 and TerminateJobObject(state.job, 125u32) == 0: return Err("Windows managed Job cancellation failed")
    if state.process != 0 and not state.managed_assigned and WaitForSingleObject(state.process, 0u32) == 258u32:
        if TerminateProcess(state.process, 125u32) == 0: return Err("Windows managed unassigned child cancellation failed")
    if state.pending:
        val requested = CancelIoEx(state.input, state.arena + 64)
        if requested == 0 and GetLastError() != 1168u32: return Err("Windows managed pending IO cancellation failed")
        state = _windows_pty_managed_complete_v2(state)
    state.managed_cancelled = true
    val stored = _windows_pty_managed_store_v2(lease, state)?
    if state.managed_create_attempted and state.process == 0 and not state.terminal_observed:
        return Err("Windows attempted child identity unknown; cancellation cannot prove cleanup")
    Ok(true)

pub fn windows_managed_stream_collect_v2(lease: WindowsManagedStreamLeaseV2) -> Result<WindowsManagedStreamPollV2, text>:
    val owner_thread = _windows_pty_owner_entry_result_v2()?
    val observed = windows_managed_stream_poll_v2(lease)?
    if not observed.leader_reaped or not observed.job_empty or observed.pending_io:
        return Err("Windows managed Job or IO remains nonterminal")
    val state = _windows_pty_managed_load_v2(lease)?
    if state.managed_started and not state.managed_output_end and not state.managed_cancelled:
        return Err("Windows managed output must be drained or explicitly cancelled before collect")
    if not state.closed:
        val released = _windows_pty_managed_release_v2(lease)?
    val final_state = _windows_pty_managed_load_v2(lease)?
    if final_state.release_failed: return Err("Windows managed owner retains historical native release failure")
    Ok(_windows_managed_receipt_v2(final_state, true, true))

pub fn windows_managed_stream_resize_v2(lease: WindowsManagedStreamLeaseV2, rows: i32, cols: i32) -> Result<bool, text>:
    val owner_thread = _windows_pty_owner_entry_result_v2()?
    Err("RAW managed streams have no terminal to resize")
