# Configured facade; both admitted backends retain actual original protected
# resources in the same canonical reader slots. No pathname-only fallback.
use std.nogc_sync_mut.io.windows_host_service_ready_reader_v1.{WindowsHostServiceReadyReaderV1,
    windows_host_service_ready_reader_open_v1, windows_host_service_ready_reader_current_v1,
    windows_host_service_ready_reader_endpoint_v1, windows_host_service_ready_reader_incarnation_v1,
    windows_host_service_ready_reader_expected_service_pid_v1, windows_host_service_ready_reader_close_v1,
    windows_host_service_ready_reader_mac_request_v1, windows_host_service_ready_reader_verify_server_v1,
    windows_host_service_ready_reader_server_tag_v1, windows_host_service_ready_reader_verify_request_v1,
    windows_host_service_ready_reader_ready_digest_v1, windows_host_service_ready_reader_host_lease_digest_v1}
use std.common.contracts.orchestration.host_service_auth_v6.HostServiceAuthContextV6

pub class HostServiceReadyReaderV1:
    retained: WindowsHostServiceReadyReaderV1

pub struct HostServiceReadyReaderOpenTurnV1:
    owner: Option<HostServiceReadyReaderV1>
    ready: bool
    error: text

pub struct HostServiceReadyReaderCloseTurnV1:
    owner: Option<HostServiceReadyReaderV1>
    completed: bool
    error: text

pub fn host_service_ready_reader_open_v1(setup_path: text, expected_setup_digest: text,
        host_deployment_root: text, expected_host_authority_digest: text, expected_publication_uid: text = "") -> HostServiceReadyReaderOpenTurnV1:
    val turn = windows_host_service_ready_reader_open_v1(setup_path, expected_setup_digest, host_deployment_root,
        expected_host_authority_digest, expected_publication_uid)
    val owner = if turn.owner.is_some(): Some(HostServiceReadyReaderV1(retained: turn.owner.unwrap())) else: nil
    HostServiceReadyReaderOpenTurnV1(owner, turn.ready, turn.error)

pub fn host_service_ready_reader_current_v1(owner: HostServiceReadyReaderV1) -> Result<(), text>:
    windows_host_service_ready_reader_current_v1(owner.retained)

pub fn host_service_ready_reader_endpoint_v1(owner: HostServiceReadyReaderV1) -> Result<text, text>:
    windows_host_service_ready_reader_endpoint_v1(owner.retained)

pub fn host_service_ready_reader_incarnation_v1(owner: HostServiceReadyReaderV1) -> Result<text, text>:
    windows_host_service_ready_reader_incarnation_v1(owner.retained)

pub fn host_service_ready_reader_expected_service_pid_v1(owner: HostServiceReadyReaderV1) -> Result<i64, text>:
    windows_host_service_ready_reader_expected_service_pid_v1(owner.retained)

# Trusted IO implementation surface only. No arbitrary app/wire RPC or bearer
# getter. Actual per-connection challenge freshness/consumption is transport-
# owner state, never conferred by these cryptographic operations.
pub(package) fn host_service_ready_reader_mac_request_v1(owner: HostServiceReadyReaderV1,
        context: HostServiceAuthContextV6, exactcanonicalrequest: text) -> Result<text, text>:
    windows_host_service_ready_reader_mac_request_v1(owner.retained, context, exactcanonicalrequest)

pub(package) fn host_service_ready_reader_verify_server_v1(owner: HostServiceReadyReaderV1,
        context: HostServiceAuthContextV6, role: text, body: text, tag: text) -> Result<bool, text>:
    windows_host_service_ready_reader_verify_server_v1(owner.retained, context, role, body, tag)

pub(package) fn host_service_ready_reader_server_tag_v1(owner: HostServiceReadyReaderV1,
        context: HostServiceAuthContextV6, role: text, body: text) -> Result<text, text>:
    windows_host_service_ready_reader_server_tag_v1(owner.retained, context, role, body)

pub(package) fn host_service_ready_reader_verify_request_v1(owner: HostServiceReadyReaderV1,
        context: HostServiceAuthContextV6, exactcanonicalrequest: text, tag: text) -> Result<bool, text>:
    windows_host_service_ready_reader_verify_request_v1(owner.retained, context, exactcanonicalrequest, tag)

pub fn host_service_ready_reader_close_v1(owner: HostServiceReadyReaderV1) -> HostServiceReadyReaderCloseTurnV1:
    val turn = windows_host_service_ready_reader_close_v1(owner.retained)
    val remaining = if turn.owner.is_some(): Some(HostServiceReadyReaderV1(retained: turn.owner.unwrap())) else: nil
    HostServiceReadyReaderCloseTurnV1(remaining, turn.completed, turn.error)

pub fn host_service_ready_reader_ready_digest_v1(owner: HostServiceReadyReaderV1) -> Result<text, text>:
    windows_host_service_ready_reader_ready_digest_v1(owner.retained)

pub fn host_service_ready_reader_host_lease_digest_v1(owner: HostServiceReadyReaderV1) -> Result<text, text>:
    windows_host_service_ready_reader_host_lease_digest_v1(owner.retained)
