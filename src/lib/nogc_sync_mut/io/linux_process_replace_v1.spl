@unsafe(reason: "positive-only private cwd/image cleanup, no caller handback or uncertain-fd retry", capabilities: [ffi, raw_ptr])
pub fn linux_process_replace_close_v1(owner: LinuxProcessReplaceOwnerV1) -> LinuxProcessReplaceTurnV1:
    val loaded = replacement_load_v1(owner)
    if loaded.is_err(): return replacement_unknown_v1(owner, loaded.unwrap_err())
