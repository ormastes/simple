pub class LinuxInstalledFreshEpochOwnerV1:
    slot: i64
    generation: i64
    pub fn current_v1() -> Result<LinuxFreshEpochObservationV1, text>: fresh_epoch_current_v1(self.slot, self.generation, false)
    pub fn consume_preparation_v1() -> LinuxFreshEpochConsumeTurnV1: fresh_epoch_consume_v1(self.slot, self.generation)
    pub fn close_v1() -> LinuxFreshEpochCloseTurnV1:
        val turn = fresh_epoch_close_v1(self.slot, self.generation, false)
        LinuxFreshEpochCloseTurnV1(if turn.0: nil else: Some(self), turn.0, turn.1)

pub class LinuxFreshEpochSuccessorCustodyV1:
    slot: i64
    generation: i64
    pub fn current_v1() -> Result<LinuxFreshEpochObservationV1, text>: fresh_epoch_current_v1(self.slot, self.generation, true)
    pub fn bind_profiled_launch_v1(template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
        fresh_epoch_bind_v1(self.slot, self.generation, template)
    pub fn validate_profiled_launch_v1(template: GroupProcessStreamLaunchV2) -> Result<(), text>:
        val actual = fresh_epoch_bind_v1(self.slot, self.generation, template)?
        if group_process_stream_template_encode_v3(actual)? != group_process_stream_template_encode_v3(template)?:
            return Err("fresh-epoch-launch-does-not-match-held-profile")
        Ok(())
    pub fn bind_workspace_launch_v3(binding: LinuxFreshWorkspaceBindingV3, command: LinuxFreshWorkspaceCommandV3,
            template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
        fresh_workspace_bind_v3(self.slot, self.generation, binding, command, template)
    pub fn validate_workspace_launch_v3(binding: LinuxFreshWorkspaceBindingV3, command: LinuxFreshWorkspaceCommandV3,
            template: GroupProcessStreamLaunchV2) -> Result<(), text>:
        val actual = fresh_workspace_bind_v3(self.slot, self.generation, binding, command, template)?
        if group_process_stream_template_encode_v3(actual)? != group_process_stream_template_encode_v3(template)?:
            return Err("fresh-workspace-launch-not-exact-held-projection")
        Ok(())
    pub fn validate_workspace_created_config_v3(binding: LinuxFreshWorkspaceBindingV3, command: LinuxFreshWorkspaceCommandV3,
            output: text) -> Result<(), text>:
        fresh_workspace_created_v3(self.slot, self.generation, binding, command, output)
    pub fn validate_workspace_containment_v3(binding: LinuxFreshWorkspaceBindingV3, owner: LinuxContainerContainmentOwnerV1,
            command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxContainerContainmentSnapshotV1, text>:
        fresh_workspace_associate_v3(self.slot, self.generation, binding, owner, command)
    pub fn observe_workspace_absence_v3(binding: LinuxFreshWorkspaceBindingV3, command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxFreshWorkloadClosureV2, text>:
        fresh_workspace_absence_v3(self.slot, self.generation, binding, command)
    # Native absence only; upper still owns OCI/helper/transport/Host/WAL gates.
    pub fn retire_workspace_native_v3(binding: LinuxFreshWorkspaceBindingV3,
            command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxFreshWorkspaceNativeRetirementV3, text>:
        fresh_workspace_retire_v3(self.slot, self.generation, binding, command)
    pub fn bind_workspace_primary_attach_v3(binding: LinuxFreshWorkspaceBindingV3, attach: LinuxFreshWorkspacePrimaryAttachCommandV3,
            template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
        fresh_workspace_attach_v3(self.slot, self.generation, binding, attach, template)
    pub fn validate_workspace_primary_attach_v3(binding: LinuxFreshWorkspaceBindingV3, attach: LinuxFreshWorkspacePrimaryAttachCommandV3,
            template: GroupProcessStreamLaunchV2) -> Result<(), text>:
        val actual = fresh_workspace_attach_v3(self.slot, self.generation, binding, attach, template)?
        if group_process_stream_template_encode_v3(actual)? != group_process_stream_template_encode_v3(template)?:
            return Err("fresh-workspace-primary-attach-not-exact-held-projection")
        Ok(())
    pub fn observe_workspace_primary_v3(binding: LinuxFreshWorkspaceBindingV3, owner: LinuxContainerContainmentOwnerV1,
            command: LinuxFreshWorkspaceCommandV3, invocation_source: text, deadline_monotonic_ns: i64) -> LinuxFreshWorkspacePrimaryObservationTurnV3:
        match fresh_workspace_primary_v3(self.slot, self.generation, binding, owner, command, invocation_source, deadline_monotonic_ns):
            case Ok(turn): turn
            case Err(reason): LinuxFreshWorkspacePrimaryObservationTurnV3(nil, false, reason)
    pub fn observe_workspace_stats_v3(binding: LinuxFreshWorkspaceBindingV3, owner: LinuxContainerContainmentOwnerV1, command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxFreshWorkloadStatsCountersV1, text>:
        fresh_workspace_stats_v3(self.slot, self.generation, binding, owner, command)
    pub fn current_host_context_v2() -> Result<LinuxFreshHostContextV2, text>: fresh_workload_context_v2(self.slot, self.generation)
    pub fn bind_workload_launch_v2(command: LinuxFreshWorkloadCommandV2, template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
        fresh_workload_bind_v2(self.slot, self.generation, command, template)
    pub fn validate_workload_launch_v2(command: LinuxFreshWorkloadCommandV2, template: GroupProcessStreamLaunchV2) -> Result<(), text>:
        val actual = fresh_workload_bind_v2(self.slot, self.generation, command, template)?
        if group_process_stream_template_encode_v3(actual)? != group_process_stream_template_encode_v3(template)?:
            return Err("fresh-workload-launch-does-not-match-held-command")
        Ok(())
    pub fn validate_workload_created_config_v2(command: LinuxFreshWorkloadCommandV2, output: text) -> Result<(), text>:
        fresh_workload_created_v2(self.slot, self.generation, command, output)
    pub fn validate_workload_containment_v2(owner: LinuxContainerContainmentOwnerV1, command: LinuxFreshWorkloadCommandV2) -> Result<LinuxContainerContainmentSnapshotV1, text>:
        fresh_workload_associate_v2(self.slot, self.generation, owner, command)
    pub fn observe_workload_absence_v2(command: LinuxFreshWorkloadCommandV2) -> Result<LinuxFreshWorkloadClosureV2, text>:
        fresh_workload_absence_v2(self.slot, self.generation, command)
    pub fn observe_probe_absence_v3(command: LinuxFreshWorkloadProbeCommandV3) -> Result<LinuxFreshWorkloadProbeAbsenceV3, text>:
        fresh_probe_absence_v3(self.slot, self.generation, command)
    # Offline read of the held fresh-epoch provider store (milestone_0019 M1):
    # only while the successor custody is ready, with the provider masked and
    # never started; any store entry refuses.
    pub fn observe_store_inventory_v1() -> Result<LinuxFreshEpochObservationV1, text>:
        fresh_epoch_store_inventory_v1(self.slot, self.generation)
    pub fn observe_workload_stats_v1(owner: LinuxContainerContainmentOwnerV1, command: LinuxFreshWorkloadCommandV2) -> Result<LinuxFreshWorkloadStatsCountersV1, text>:
        fresh_workload_stats_v1(self.slot, self.generation, owner, command)
    pub fn close_v1() -> LinuxFreshEpochSuccessorCloseTurnV1:
        val turn = fresh_epoch_close_v1(self.slot, self.generation, true)
        LinuxFreshEpochSuccessorCloseTurnV1(if turn.0: nil else: Some(self), turn.0, turn.1)

pub enum LinuxFreshEpochOpenV1:
    Rejected(reason: text)
    CleanupRequired(owner: LinuxInstalledFreshEpochOwnerV1, reason: text)
    Ready(owner: LinuxInstalledFreshEpochOwnerV1)
pub struct LinuxFreshEpochCloseTurnV1:
    owner: Option<LinuxInstalledFreshEpochOwnerV1>
    closed: bool
    error: text
pub struct LinuxFreshEpochSuccessorCloseTurnV1:
    owner: Option<LinuxFreshEpochSuccessorCustodyV1>
    closed: bool
    error: text
pub struct LinuxFreshEpochConsumeTurnV1:
    preparation: Option<LinuxInstalledFreshEpochOwnerV1>
    successor: Option<LinuxFreshEpochSuccessorCustodyV1>
    error: text

struct FreshEpochStateV1:
    generation: i64
    var profile: Option<LinuxInstalledFreshEpochProfileV1> = None
    var supervisor: Option<LinuxInstalledSupervisorProfileV1> = None
    var bus: Option<LinuxSupervisorBusV1> = None
    var native: Option<LinuxFreshEpochNativeOwnerV1> = None
    var lock: Option<FileLockOwnerV2> = None
    var manager: text = ""
    var phase: text = "opening"
    var successor: bool = false
    var error: text = ""
var fresh_epoch_slots_v1: [FreshEpochStateV1] = []

fn fresh_epoch_state_v1(slot: i64, generation: i64) -> Result<FreshEpochStateV1, text>:
    linux_machine_process_origin_check_v1()?
    if slot < 0 or slot >= fresh_epoch_slots_v1.len() or fresh_epoch_slots_v1[slot].generation != generation:
        return Err("fresh-epoch-owner-stale")
    Ok(fresh_epoch_slots_v1[slot])

fn fresh_epoch_check_v1(slot: i64, generation: i64, successor: bool) -> Result<LinuxFreshEpochObservationV1, text>:
    val state = fresh_epoch_state_v1(slot, generation)?
    if state.phase != "ready" or state.successor != successor: return Err("fresh-epoch-custody-phase")
    if (state.profile.is_none() or state.supervisor.is_none() or state.bus.is_none() or state.native.is_none() or
            state.lock.is_none() or not file_lock_owner_live_v2(state.lock.unwrap())):
        return Err("fresh-epoch-custody-incomplete")
    val profile = state.profile.unwrap().current_v1()?
    val p = profile.profile
    val manager = linux_fresh_epoch_manager_current_v1(state.bus.unwrap(), state.supervisor.unwrap(), profile)?
    if manager != state.manager: return Err("fresh-epoch-manager-replaced")
    val native = if successor: state.native.unwrap().successor_v1()? else: state.native.unwrap().preparation_v1()?
    if linux_fresh_epoch_manager_current_v1(state.bus.unwrap(), state.supervisor.unwrap(), profile)? != manager:
        return Err("fresh-epoch-manager-changed-during-observation")
    if not file_lock_owner_live_v2(state.lock.unwrap()): return Err("fresh-epoch-launch-exclusion-lost")
    Ok(LinuxFreshEpochObservationV1(owner_generation: generation, epoch_id: p.text_v1("epochId")?,
        profile_digest: profile.profile_digest, machine_policy_digest: p.text_v1("machinePolicyDigest")?,
        process_identity_digest: profile.process.identity_digest, manager_unique_name: manager,
        service_uid: p.number_v1("serviceUid")?, service_gid: p.number_v1("serviceGid")?,
        partition_identity_digest: native.partition_identity_digest, store_identity_digest: native.store_identity_digest,
        provider_policy_digest: p.text_v1("providerPolicyDigest")?, observed_cpu_millis: native.observed_cpu_millis,
        observed_memory_bytes: native.observed_memory_bytes, reserved_cpu_millis: p.number_v1("reservedCpuMillis")?,
        reserved_memory_bytes: p.number_v1("reservedMemoryBytes")?, outside_cpu_millis: p.number_v1("outsideCpuMillis")?,
        outside_memory_bytes: p.number_v1("outsideMemoryBytes")?, usable_cpu_millis: native.observed_cpu_millis - p.number_v1("reservedCpuMillis")?,
        usable_memory_bytes: native.observed_memory_bytes - p.number_v1("reservedMemoryBytes")?))

fn fresh_epoch_current_v1(slot: i64, generation: i64, successor: bool) -> Result<LinuxFreshEpochObservationV1, text>:
    val checked = fresh_epoch_check_v1(slot, generation, successor)
    if checked.is_err():
        val state = fresh_epoch_state_v1(slot, generation)
        if state.is_ok() and state.unwrap().phase == "ready" and state.unwrap().successor == successor:
            fresh_epoch_slots_v1[slot].phase = "cleanup"
    checked

fn fresh_epoch_bind_v1(slot: i64, generation: i64, template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    val before = fresh_epoch_current_v1(slot, generation, true)?
    val state = fresh_epoch_state_v1(slot, generation)?
    val projected = state.native.unwrap().bind_profiled_launch_v1(template)?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    Ok(projected)

fn fresh_workload_context_v2(slot: i64, generation: i64) -> Result<LinuxFreshHostContextV2, text>:
    val before = fresh_epoch_current_v1(slot, generation, true)?
    val state = fresh_epoch_state_v1(slot, generation)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    val context = observer.context_v2()?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    Ok(LinuxFreshHostContextV2(native_machine_id: context.native_machine_id, native_boot_id: context.native_boot_id,
        architecture: context.architecture, owner_generation: after.owner_generation))

fn fresh_workload_scope_v2(slot: i64, generation: i64, command: LinuxFreshWorkloadCommandV2) -> Result<FreshEpochStateV1, text>:
    linux_fresh_workload_command_validate_v2(command)?
    val before = fresh_epoch_current_v1(slot, generation, true)?
    val state = fresh_epoch_state_v1(slot, generation)?
    state.profile.unwrap().validate_workload_scope_v2(command.scope)?
    val context = fresh_workload_context_v2(slot, generation)?
    if (command.scope.provider_generation != before.owner_generation or command.scope.native_machine_id != context.native_machine_id or
            command.scope.boot_id != context.native_boot_id or command.scope.continuity_id != context.native_boot_id):
        return Err("fresh-workload-current-scope-mismatch")
    if (command.helper_cpu_millis > before.usable_cpu_millis or command.cpu_millis > before.usable_cpu_millis - command.helper_cpu_millis or
            command.helper_memory_bytes > before.usable_memory_bytes or command.memory_bytes > before.usable_memory_bytes - command.helper_memory_bytes):
        return Err("fresh-workload-request-helper-budget-exceeded")
    Ok(state)

fn fresh_workload_bind_v2(slot: i64, generation: i64, command: LinuxFreshWorkloadCommandV2,
        template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    val state = fresh_workload_scope_v2(slot, generation, command)?
    if template.profile_v3.is_none(): return Err("fresh-workload-helper-profile-required")
    var safe = template
    var profile = safe.profile_v3.unwrap()
    profile.helper_cpu = group_process_cpu_quota_v3(command.helper_cpu_millis)?
    safe.profile_v3 = Some(profile)
    safe.memory_limit_bytes = command.helper_memory_bytes
    var request = safe.request
    request.args = ["version"] # DATA-only base projection; this is never spawned.
    request.timeout_ms = command.timeout_ms
    safe.request = request
    val base = state.native.unwrap().bind_profiled_launch_v1(safe)?
    val installed = state.profile.unwrap().current_v1()?
    val projected = linux_fresh_workload_project_launch_v2(installed.profile, base, command)?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    Ok(projected)

fn fresh_workload_created_v2(slot: i64, generation: i64, command: LinuxFreshWorkloadCommandV2, output: text) -> Result<(), text>:
    val state = fresh_workload_scope_v2(slot, generation, command)?
    linux_fresh_workload_created_config_validate_v2(command, output)?
    val value = linux_fresh_workload_inspect_fields_v2(output)?
    val installed = state.profile.unwrap().current_v1()?
    if linux_fresh_workload_inspect_text_v2(value, "cgroup_parent")? != installed.profile.text_v1("delegatedCgroup")?:
        return Err("fresh-workload-created-parent-not-held-delegation")
    var create = command
    create.action = LinuxFreshWorkloadActionV2.Create
    create.native_id = ""
    create.observed_image_id = ""
    val expected = [installed.profile.text_v1("providerExecutable")?] + linux_fresh_workload_argv_v2(installed.profile, create)?
    if linux_fresh_workload_inspect_strings_v2(value, "create_command", 65)? != expected:
        return Err("fresh-workload-created-command-not-exact-owned-projection")
    val after = fresh_epoch_current_v1(slot, generation, true)?
    Ok(())

fn fresh_workload_associate_v2(slot: i64, generation: i64, owner: LinuxContainerContainmentOwnerV1,
        command: LinuxFreshWorkloadCommandV2) -> Result<LinuxContainerContainmentSnapshotV1, text>:
    val state = fresh_workload_scope_v2(slot, generation, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    val snapshot = observer.associate_v2(owner, command)?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    Ok(snapshot)

fn fresh_workload_stats_v1(slot: i64, generation: i64, owner: LinuxContainerContainmentOwnerV1,
        command: LinuxFreshWorkloadCommandV2) -> Result<LinuxFreshWorkloadStatsCountersV1, text>:
    val state = fresh_workload_scope_v2(slot, generation, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    val result = observer.stats_v1(owner, command)?
    val after = fresh_workload_scope_v2(slot, generation, command)?
    Ok(result)

fn fresh_workspace_stats_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        owner: LinuxContainerContainmentOwnerV1, command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxFreshWorkloadStatsCountersV1, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    val result = observer.workspace_stats_v3(binding, owner, command)?
    val after = fresh_workspace_scope_v3(slot, generation, binding, command)?
    Ok(result)

# Genuine point observation of the entire enforced cohort after the upper's
# own Wait/Remove/OCI-absence/helper-retirement gates. Logs selects identity
# only, and neither those gates nor a running Subject are invented here.
fn fresh_probe_absence_v3(slot: i64, generation: i64, command: LinuxFreshWorkloadProbeCommandV3) -> Result<LinuxFreshWorkloadProbeAbsenceV3, text>:
    linux_fresh_workload_probe_command_validate_v3(command)?
    if command.action != LinuxFreshWorkloadProbeActionV3.Logs: return Err("fresh-probe-absence-logs-identity-required")
    val started = time_sample_monotonic_nanos_or_failure()
    if started < 0: return Err("fresh-probe-absence-clock-unavailable")
    val state = fresh_workload_scope_v2(slot, generation, command.workload)?
    val before = fresh_workload_context_v2(slot, generation)?
    val actual = state.native.unwrap().observe_probe_absence_v3()?
    val final_state = fresh_workload_scope_v2(slot, generation, command.workload)?
    val after = fresh_workload_context_v2(slot, generation)?
    if before != after: return Err("fresh-probe-cohort-host-incarnation-changed")
    val installed = final_state.profile.unwrap().current_v1()?
    val finished = time_sample_monotonic_nanos_or_failure()
    if finished < started: return Err("fresh-probe-absence-clock-changed")
    Ok(LinuxFreshWorkloadProbeAbsenceV3(assurance: "enforced-probe-cohort-empty-v3",
        request_binding_digest: linux_fresh_workload_probe_binding_v3(command)?, native_id: command.workload.native_id,
        partition_identity_digest: actual.partition_identity_digest, store_identity_digest: actual.store_identity_digest,
        native_machine_id: after.native_machine_id, native_boot_id: after.native_boot_id,
        excluded_process_identity_digest: installed.process.identity_digest,
        service_uid: installed.profile.number_v1("serviceUid")?, subuid_start: installed.profile.number_v1("subuidStart")?,
        subuid_count: installed.profile.number_v1("subuidCount")?, owner_generation: after.owner_generation,
        sample_started_monotonic_ns: started, sample_finished_monotonic_ns: finished))

fn fresh_epoch_store_inventory_v1(slot: i64, generation: i64) -> Result<LinuxFreshEpochObservationV1, text>:
    val before = fresh_epoch_current_v1(slot, generation, true)?
    val state = fresh_epoch_state_v1(slot, generation)?
    # A non-empty or racy store refuses and leaves custody usable (the
    # reconcile refuses; the journal stays quarantined). A descriptor-close
    # failure puts the native slot into cleanup, failing this custody closed.
    val store = state.native.unwrap().observe_store_inventory_v1()?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    if (before != after or store.store_identity_digest != after.store_identity_digest or
            store.partition_identity_digest != after.partition_identity_digest):
        return Err("fresh-epoch-store-inventory-custody-changed")
    Ok(after)

fn fresh_workload_absence_v2(slot: i64, generation: i64, command: LinuxFreshWorkloadCommandV2) -> Result<LinuxFreshWorkloadClosureV2, text>:
    val state = fresh_workload_scope_v2(slot, generation, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    var result = observer.closure_v2(command)?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    result.partition_identity_digest = after.partition_identity_digest
    result.owner_generation = after.owner_generation
    Ok(result)

fn fresh_workspace_scope_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        value: LinuxFreshWorkspaceCommandV3) -> Result<FreshEpochStateV1, text>:
    binding.validate_command_v3(value)?
    val before = fresh_epoch_current_v1(slot, generation, true)?
    val state = fresh_epoch_state_v1(slot, generation)?
    val command = value.command
    state.profile.unwrap().validate_workload_scope_v2(command.scope)?
    val context = fresh_workload_context_v2(slot, generation)?
    val source = binding.current_v3()?
    # The approved-executable ISA check is agent-arm policy; the remote-build arm has no executable
    # profile (milestone_0030 N6-a) and is bound by its installed build profile instead.
    if binding.arm_v3()? == LinuxWorkspaceArmV3.Agent:
        val executable = binding.executable_profile_v3()?
        if executable.architecture != "linux-" + context.architecture: return Err("fresh-workspace-approved-host-isa-mismatch")
    if (command.scope.provider_generation != before.owner_generation or command.scope.native_machine_id != context.native_machine_id or
            command.scope.boot_id != context.native_boot_id or command.scope.continuity_id != context.native_boot_id or
            source.machine_policy_digest != before.machine_policy_digest or source.provider_policy_digest != before.provider_policy_digest or
            source.service_uid != before.service_uid or source.service_gid != before.service_gid):
        return Err("fresh-workspace-current-epoch-source-mismatch")
    if (command.helper_cpu_millis > before.usable_cpu_millis or command.cpu_millis > before.usable_cpu_millis - command.helper_cpu_millis or
            command.helper_memory_bytes > before.usable_memory_bytes or command.memory_bytes > before.usable_memory_bytes - command.helper_memory_bytes):
        return Err("fresh-workspace-request-plus-helper-budget-exceeded")
    Ok(state)

fn fresh_workspace_bind_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        value: LinuxFreshWorkspaceCommandV3, template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, value)?
    if template.profile_v3.is_none(): return Err("fresh-workspace-helper-profile-required")
    var safe = template
    var profile = safe.profile_v3.unwrap()
    profile.helper_cpu = group_process_cpu_quota_v3(value.command.helper_cpu_millis)?
    safe.profile_v3 = Some(profile)
    safe.memory_limit_bytes = value.command.helper_memory_bytes
    var request = safe.request
    request.args = ["version"] # Actual installed DATA projection only; never spawned.
    request.timeout_ms = value.command.timeout_ms
    safe.request = request
    val base = state.native.unwrap().bind_profiled_launch_v1(safe)?
    val installed = state.profile.unwrap().current_v1()?
    val projected = binding.project_launch_v3(installed.profile, base, value)?
    val after = fresh_workspace_scope_v3(slot, generation, binding, value)?
    Ok(projected)

fn fresh_workspace_created_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        command: LinuxFreshWorkspaceCommandV3, output: text) -> Result<(), text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val installed = state.profile.unwrap().current_v1()?
    binding.validate_created_v3(installed.profile, command, output)?
    val after = fresh_workspace_scope_v3(slot, generation, binding, command)?
    Ok(())

fn fresh_workspace_associate_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        owner: LinuxContainerContainmentOwnerV1, command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxContainerContainmentSnapshotV1, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    val result = observer.associate_workspace_v3(binding, owner, command)?
    val after = fresh_workspace_scope_v3(slot, generation, binding, command)?
    Ok(result)

fn fresh_workspace_absence_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxFreshWorkloadClosureV2, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    var result = observer.closure_workspace_v3(binding, command)?
    val after = fresh_epoch_current_v1(slot, generation, true)?
    val final_source = fresh_workspace_scope_v3(slot, generation, binding, command)?
    result.partition_identity_digest = after.partition_identity_digest
    result.owner_generation = after.owner_generation
    Ok(result)

fn fresh_workspace_attach_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        attach: LinuxFreshWorkspacePrimaryAttachCommandV3, template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, attach.workspace)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    observer.validate_workspace_primary_effect_v3(binding, attach.workspace)?
    # Obtain the actual installed/broker/resource projection without executing
    # its bounded Inspect command; replace only with the closed Attach command.
    val base = fresh_workspace_bind_v3(slot, generation, binding, attach.workspace, template)?
    val installed = state.profile.unwrap().current_v1()?
    val result = binding.project_primary_attach_v3(installed.profile, base, attach)?
    observer.validate_workspace_primary_effect_v3(binding, attach.workspace)?
    val after = fresh_workspace_scope_v3(slot, generation, binding, attach.workspace)?
    Ok(result)

fn fresh_workspace_retire_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        command: LinuxFreshWorkspaceCommandV3) -> Result<LinuxFreshWorkspaceNativeRetirementV3, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    val token = observer.retire_workspace_native_v3(binding, command)?
    val after = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val actual = token.current_v3()?
    if actual.provider_generation != generation: return Err("fresh-workspace-native-retirement-epoch-generation")
    Ok(token)

fn fresh_workspace_primary_v3(slot: i64, generation: i64, binding: LinuxFreshWorkspaceBindingV3,
        owner: LinuxContainerContainmentOwnerV1, command: LinuxFreshWorkspaceCommandV3,
        invocation_source: text, deadline_monotonic_ns: i64) -> Result<LinuxFreshWorkspacePrimaryObservationTurnV3, text>:
    val state = fresh_workspace_scope_v3(slot, generation, binding, command)?
    val observer = state.native.unwrap().borrow_workload_observer_v2()?
    var result = observer.primary_workspace_v3(binding, owner, command, invocation_source, deadline_monotonic_ns)
    val after = fresh_epoch_current_v1(slot, generation, true)?
    val final_source = fresh_workspace_scope_v3(slot, generation, binding, command)?
    if result.observation.is_some():
        var snapshot = result.observation.unwrap()
        snapshot.partition_identity_digest = after.partition_identity_digest
        snapshot.owner_generation = after.owner_generation
        result.observation = Some(snapshot)
    Ok(result)

fn fresh_epoch_consume_v1(slot: i64, generation: i64) -> LinuxFreshEpochConsumeTurnV1:
    val owner = LinuxInstalledFreshEpochOwnerV1(slot: slot, generation: generation)
    val current = fresh_epoch_current_v1(slot, generation, false)
    if current.is_err(): return LinuxFreshEpochConsumeTurnV1(Some(owner), nil, current.unwrap_err())
    # All preparation aliases are invalidated BEFORE publishing the successor.
    # No ledger, writer, descriptor or launch permission is created/transferred.
    fresh_epoch_slots_v1[slot].successor = true
    LinuxFreshEpochConsumeTurnV1(nil, Some(LinuxFreshEpochSuccessorCustodyV1(slot: slot, generation: generation)), "")

fn fresh_epoch_open_body_v1(slot: i64) -> Result<(), text>:
    val generation = slot + 1
    match linux_installed_fresh_epoch_profile_open_v1():
        case LinuxFreshEpochProfileOpenV1.Rejected(reason): return Err(reason)
        case LinuxFreshEpochProfileOpenV1.CleanupRequired(owner, reason):
            fresh_epoch_slots_v1[slot].profile = Some(owner)
            return Err(reason)
        case LinuxFreshEpochProfileOpenV1.Ready(owner): fresh_epoch_slots_v1[slot].profile = Some(owner)
    match linux_installed_supervisor_profile_open_v1():
        case LinuxInstalledSupervisorProfileOpenV1.Rejected(reason): return Err(reason)
        case LinuxInstalledSupervisorProfileOpenV1.CleanupRequired(owner, reason):
            fresh_epoch_slots_v1[slot].supervisor = Some(owner)
            return Err(reason)
        case LinuxInstalledSupervisorProfileOpenV1.Ready(owner): fresh_epoch_slots_v1[slot].supervisor = Some(owner)
    val supervisor = fresh_epoch_slots_v1[slot].supervisor.unwrap()
    match linux_supervisor_bus_open_v1(supervisor):
        case LinuxSupervisorBusOpenV1.Rejected(reason): return Err(reason)
        case LinuxSupervisorBusOpenV1.CleanupRequired(owner, reason):
            fresh_epoch_slots_v1[slot].bus = Some(owner)
            return Err(reason)
        case LinuxSupervisorBusOpenV1.Ready(owner): fresh_epoch_slots_v1[slot].bus = Some(owner)
    val profile = fresh_epoch_slots_v1[slot].profile.unwrap()
    val snapshot = profile.current_v1()?
    val bus = fresh_epoch_slots_v1[slot].bus.unwrap()
    val manager = linux_fresh_epoch_manager_current_v1(bus, supervisor, snapshot)?
    fresh_epoch_slots_v1[slot].manager = manager
    # Existing bus custody permits RefUnit only inside activation closure.
    # No LoadUnit, provider activation or wider mutating bus port is used.
    bus.ref_unit_v1(snapshot.profile.text_v1("providerSocketUnit")?)?
    match linux_fresh_epoch_native_open_v1(profile):
        case LinuxFreshEpochNativeOpenV1.Rejected(reason): return Err(reason)
        case LinuxFreshEpochNativeOpenV1.CleanupRequired(owner, reason):
            fresh_epoch_slots_v1[slot].native = Some(owner)
            return Err(reason)
        case LinuxFreshEpochNativeOpenV1.Ready(owner): fresh_epoch_slots_v1[slot].native = Some(owner)
    val native = fresh_epoch_slots_v1[slot].native.unwrap().successor_v1()?
    val key = sha256_text("FRESH-EPOCH-EXCLUSION-V1\n" + native.partition_identity_digest + "\n" + native.store_identity_digest + "\n")
    match file_lock_open_owned_v2("/var/lib/simple/container/fresh-epoch-" + key + ".lock", 0):
        case FileLockOpenV2.Rejected(reason): return Err(reason)
        case FileLockOpenV2.CleanupRequired(owner, reason):
            fresh_epoch_slots_v1[slot].lock = Some(owner)
            return Err(reason)
        case FileLockOpenV2.Ready(owner): fresh_epoch_slots_v1[slot].lock = Some(owner)
    fresh_epoch_slots_v1[slot].phase = "ready"
    val checked = fresh_epoch_current_v1(slot, generation, false)?
    Ok(())

pub fn linux_installed_fresh_epoch_open_v1() -> LinuxFreshEpochOpenV1:
    val origin = linux_machine_process_origin_check_v1()
    if origin.is_err(): return LinuxFreshEpochOpenV1.Rejected(origin.unwrap_err())
    if fresh_epoch_slots_v1.len() >= 4096: return LinuxFreshEpochOpenV1.Rejected("fresh-epoch-owner-bound")
    val slot = fresh_epoch_slots_v1.len()
    fresh_epoch_slots_v1.push(FreshEpochStateV1(generation: slot + 1))
    val owner = LinuxInstalledFreshEpochOwnerV1(slot: slot, generation: slot + 1)
    val opened = fresh_epoch_open_body_v1(slot)
    if opened.is_err():
        fresh_epoch_slots_v1[slot].phase = "cleanup"
        return LinuxFreshEpochOpenV1.CleanupRequired(owner, opened.unwrap_err())
    LinuxFreshEpochOpenV1.Ready(owner)

fn fresh_epoch_note_v1(slot: i64, error: text):
    if fresh_epoch_slots_v1[slot].error == "" and error != "": fresh_epoch_slots_v1[slot].error = error

fn fresh_epoch_close_v1(slot: i64, generation: i64, successor: bool) -> (bool, text):
    val loaded = fresh_epoch_state_v1(slot, generation)
    if loaded.is_err(): return (false, loaded.unwrap_err())
    val state = loaded.unwrap()
    if not successor and state.successor: return (true, "fresh-epoch-preparation-consumed")
    if successor != state.successor: return (false, "fresh-epoch-custody-phase")
    if state.phase == "closed": return (true, state.error)
    fresh_epoch_slots_v1[slot].phase = "closing"
    if val native = state.native:
        val turn = native.close_v1()
        fresh_epoch_note_v1(slot, turn.error)
        if not turn.closed: return (false, fresh_epoch_slots_v1[slot].error)
        fresh_epoch_slots_v1[slot].native = nil
    if val bus = state.bus:
        val closed = bus.close_v1()
        fresh_epoch_note_v1(slot, bus.close_diagnostic_v1())
        if closed != "released" and closed != "consumed-error":
            fresh_epoch_note_v1(slot, "fresh-epoch-bus-close:" + closed)
            return (false, fresh_epoch_slots_v1[slot].error)
        fresh_epoch_slots_v1[slot].bus = nil
    if val lock = state.lock:
        val turn = file_lock_release_owned_v2(lock)
        fresh_epoch_note_v1(slot, turn.error)
        if turn.state != FileLockReleaseStateV2.Released and turn.state != FileLockReleaseStateV2.ConsumedError:
            return (false, fresh_epoch_slots_v1[slot].error)
        fresh_epoch_slots_v1[slot].lock = nil
    if val supervisor = state.supervisor:
        val closed = supervisor.close_v1()
        fresh_epoch_note_v1(slot, supervisor.close_diagnostic_v1())
        if closed != "released" and closed != "consumed-error":
            fresh_epoch_note_v1(slot, "fresh-epoch-supervisor-profile-close:" + closed)
            return (false, fresh_epoch_slots_v1[slot].error)
        fresh_epoch_slots_v1[slot].supervisor = nil
    if val profile = state.profile:
        val turn = profile.close_v1()
        fresh_epoch_note_v1(slot, turn.error)
        if not turn.closed: return (false, fresh_epoch_slots_v1[slot].error)
        fresh_epoch_slots_v1[slot].profile = nil
    fresh_epoch_slots_v1[slot].phase = "closed"
    (true, fresh_epoch_slots_v1[slot].error)
