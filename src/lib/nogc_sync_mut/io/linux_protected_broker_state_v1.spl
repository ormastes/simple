#![allow(primitive_api)]
# primitive_api: reviewed protected-storage/broker ABI keeps byte bounds, phases, deadlines and flags as i64/bool (milestone_0011 broker-stack review r1).
# Bounded DATA for the original protected resource cell. No owner constructor,
# descriptor, path acquisition or effect permission is provided by this module.
use std.common.build_manager.group_process_protocol.GroupProcessPollV1

pub val BROKER_CONTROL_CELL_OFFSET_V1: i64 = 263168
pub val BROKER_CONTROL_CELL_BYTES_V1: i64 = 24576
pub val BROKER_CONTROL_IDLE_V1: i64 = 0
pub val BROKER_CONTROL_RESERVED_V1: i64 = 1
pub val BROKER_CONTROL_PREPARED_V1: i64 = 2
pub val BROKER_CONTROL_PUBLISHING_V1: i64 = 3
pub val BROKER_CONTROL_WAITING_V1: i64 = 4
pub val BROKER_CONTROL_CONSUMED_V1: i64 = 5
pub val BROKER_CONTROL_DURABLE_V1: i64 = 6
pub val BROKER_CONTROL_EXPIRED_V1: i64 = 7
pub val BROKER_CONTROL_UNCERTAIN_V1: i64 = 8
pub val BROKER_CONTROL_REAP_V1: i64 = 9

pub struct LinuxProtectedBrokerStorageTurnV1:
    facts_known: bool = false
    generation: i64 = 0
    request_digest: text = ""
    publication: text = "NotAttempted"
    pending: bool = false
    observation: Option<GroupProcessPollV1> = None
    consumed: bool = false
    durable_required: bool = false
    verified: bool = false
    error: text = ""

pub fn linux_broker_control_deadline_valid_v1(now_ms: i64, deadline_ms: i64) -> bool:
    now_ms >= 0 and deadline_ms > now_ms and deadline_ms - now_ms <= 86400000

pub fn linux_broker_control_phase_valid_v1(phase: i64) -> bool:
    phase >= BROKER_CONTROL_IDLE_V1 and phase <= BROKER_CONTROL_REAP_V1

pub fn linux_broker_control_mutable_name_v1(name: text) -> bool:
    name == "broker.control.request" or name == "broker.control.response"

pub fn linux_broker_control_replay_v1(phase: i64, original_identity: text,
        original_deadline: i64, identity: text, deadline: i64) -> text:
    if not linux_broker_control_phase_valid_v1(phase): return "broker-control-phase-invalid"
    if phase == BROKER_CONTROL_IDLE_V1: return ""
    if original_identity != identity or original_deadline != deadline: return "broker-control-replay-mismatch"
    if phase == BROKER_CONTROL_WAITING_V1: return ""
    if phase == BROKER_CONTROL_CONSUMED_V1: return "broker-control-response-consumed"
    if phase == BROKER_CONTROL_DURABLE_V1: return "broker-control-durable-proof-required"
    if phase == BROKER_CONTROL_EXPIRED_V1: return "broker-control-deadline-expired"
    if phase == BROKER_CONTROL_REAP_V1: return "broker-control-reap-consumed"
    "broker-control-publication-uncertain"
