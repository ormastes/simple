# Pure shape checks shared by the actual native producer; never authority.
use std.nogc_sync_mut.io.windows_stdin_command_contract_v1.windows_stdin_absolute_path_v1

pub fn windows_service_namespace_root_shape_v1(root: text) -> Result<text, text>:
    val prefix = "\\GLOBAL??\\"
    if not root.starts_with(prefix) or root.byte_len() > 4096:
        return Err("windows-service-namespace-store-root-shape")
    val ordinary = root.substring(prefix.byte_len(), root.byte_len())
    # The store spelling is strict native backslash form, never slash normalized.
    if ordinary.contains("/") or not windows_stdin_absolute_path_v1(ordinary):
        return Err("windows-service-namespace-store-root-shape")
    Ok(ordinary.substring(0, 1).to_upper() + ordinary.substring(1, ordinary.byte_len()))

pub fn windows_service_namespace_fixed_target_v1(target: text) -> bool:
    val prefix = "\\Device\\HarddiskVolume"
    if not target.starts_with(prefix): return false
    val digits = target.substring(prefix.byte_len(), target.byte_len())
    if digits.byte_len() < 1 or digits.byte_len() > 20: return false
    for byte in digits.bytes():
        if byte < 48 or byte > 57: return false
    true

pub fn windows_service_namespace_mutation_mask_v1(link: bool) -> u32:
    # DELETE, WRITE_DAC, WRITE_OWNER, MAXIMUM_ALLOWED, GENERIC_ALL/WRITE.
    # READ_CONTROL and directory query/traverse are expressly not mutation.
    if link: 1376583682u32 else: 1376583692u32

pub fn windows_service_namespace_service_fields_v1(kind: i64, luid_matches: bool,
        sid_matches: bool, session_matches: bool) -> bool:
    kind == 5 and luid_matches and sid_matches and session_matches
