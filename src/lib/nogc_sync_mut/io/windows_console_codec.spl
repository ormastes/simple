"""Pure value codec for Win64 KEY_EVENT_RECORD values and saved console modes."""
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}

pub struct WindowsConsoleKeyV1:
    value: text
    repeat: i64

pub struct WindowsConsoleDecoderV1:
    high: i64 = 0
    repeat: i64 = 0
    alt: bool = false

pub struct WindowsConsoleDecodedV1:
    decoder: WindowsConsoleDecoderV1
    keys: [WindowsConsoleKeyV1]

pub fn windows_console_raw_input_mode_v1(saved: i64) -> u32:
    # Clear processed/line/echo/mouse/QuickEdit/VT-input. Enable extended flags
    # so QuickEdit is actually disabled, and window events for resize polling.
    ((saved & 4294966696) | 136) as u32

pub fn windows_console_vt_output_mode_v1(saved: i64) -> u32:
    # Defer a last-column wrap until the next printable character. A full
    # viewport frame must not scroll immediately after painting bottom-right.
    (saved | 13) as u32

fn _windows_console_scalar_v1(scalar: i64) -> text:
    var bytes: [u8] = []
    if scalar < 0 or scalar > 1114111 or (scalar >= 55296 and scalar <= 57343): return "�"
    if scalar < 128:
        bytes = [scalar as u8]
    elif scalar < 2048:
        bytes = [(192 + (scalar >> 6)) as u8, (128 + (scalar & 63)) as u8]
    elif scalar < 65536:
        bytes = [(224 + (scalar >> 12)) as u8, (128 + ((scalar >> 6) & 63)) as u8, (128 + (scalar & 63)) as u8]
    else:
        bytes = [(240 + (scalar >> 18)) as u8, (128 + ((scalar >> 12) & 63)) as u8, (128 + ((scalar >> 6) & 63)) as u8, (128 + (scalar & 63)) as u8]
    match validated_utf8_bytes_to_text_linear(bytes):
        case Ok(value): value
        case Err(_reason): "�"

fn _windows_console_navigation_v1(vkey: i64, shift: bool) -> text:
    if vkey == 9 and shift: return "\x1b[Z"
    if vkey == 37: return "\x1b[D"
    if vkey == 38: return "\x1b[A"
    if vkey == 39: return "\x1b[C"
    if vkey == 40: return "\x1b[B"
    if vkey == 36: return "\x1b[H"
    if vkey == 35: return "\x1b[F"
    if vkey == 45: return "\x1b[2~"
    if vkey == 46: return "\x1b[3~"
    if vkey == 33: return "\x1b[5~"
    if vkey == 34: return "\x1b[6~"
    if vkey == 112: return "\x1bOP"
    if vkey == 113: return "\x1bOQ"
    if vkey == 114: return "\x1bOR"
    if vkey == 115: return "\x1bOS"
    if vkey == 116: return "\x1b[15~"
    if vkey == 117: return "\x1b[17~"
    if vkey == 118: return "\x1b[18~"
    if vkey == 119: return "\x1b[19~"
    if vkey == 120: return "\x1b[20~"
    if vkey == 121: return "\x1b[21~"
    if vkey == 122: return "\x1b[23~"
    if vkey == 123: return "\x1b[24~"
    ""

pub fn windows_console_decode_key_v1(decoder: WindowsConsoleDecoderV1, down: bool, repeat: i64, vkey: i64, unit: i64, controls: i64) -> WindowsConsoleDecodedV1:
    var next = decoder
    var keys: [WindowsConsoleKeyV1] = []
    if not down or repeat <= 0 or repeat > 65535:
        return WindowsConsoleDecodedV1(decoder: next, keys: keys)
    if unit == 0 and (vkey == 16 or vkey == 17 or vkey == 18 or vkey == 20 or vkey == 144 or vkey == 145):
        return WindowsConsoleDecodedV1(decoder: next, keys: keys)
    val altgr = (controls & 1) != 0 and (controls & 8) != 0
    val alt = (controls & 3) != 0 and not altgr
    val prefix = if alt: "\x1b" else: ""
    if unit >= 56320 and unit <= 57343 and next.high != 0:
        val copies = if repeat < next.repeat: repeat else: next.repeat
        val scalar = 65536 + ((next.high - 55296) << 10) + unit - 56320
        val carried_prefix = if next.alt: "\x1b" else: ""
        keys = keys.push(WindowsConsoleKeyV1(value: carried_prefix + _windows_console_scalar_v1(scalar), repeat: copies))
        next.repeat = next.repeat - copies
        if next.repeat == 0: next.high = 0
        if repeat > copies: keys = keys.push(WindowsConsoleKeyV1(value: prefix + "�", repeat: repeat - copies))
        return WindowsConsoleDecodedV1(decoder: next, keys: keys)
    if next.high != 0:
        val carried_prefix = if next.alt: "\x1b" else: ""
        keys = keys.push(WindowsConsoleKeyV1(value: carried_prefix + "�", repeat: next.repeat))
        next = WindowsConsoleDecoderV1()
    if unit >= 55296 and unit <= 56319:
        next = WindowsConsoleDecoderV1(high: unit, repeat: repeat, alt: alt)
        return WindowsConsoleDecodedV1(decoder: next, keys: keys)
    var value = _windows_console_navigation_v1(vkey, (controls & 16) != 0)
    val control = (controls & 12) != 0 and not altgr
    if value == "" and control and vkey >= 65 and vkey <= 90:
        value = _windows_console_scalar_v1(vkey - 64)
    elif value == "" and control and (vkey == 32 or vkey == 50):
        value = "\0"
    elif value == "" and control and vkey == 219:
        value = "\x1b"
    elif value == "" and control and vkey == 220:
        value = "\x1c"
    elif value == "" and control and vkey == 221:
        value = "\x1d"
    elif value == "" and control and vkey == 54:
        value = "\x1e"
    elif value == "" and control and vkey == 189:
        value = "\x1f"
    elif value == "" and vkey == 8:
        value = "\x7f"
    elif value == "" and unit > 0:
        value = _windows_console_scalar_v1(unit)
    if value != "": keys = keys.push(WindowsConsoleKeyV1(value: prefix + value, repeat: repeat))
    WindowsConsoleDecodedV1(decoder: next, keys: keys)

pub fn windows_console_utf16_units_v1(value: text) -> i64:
    var units = 0
    var ordinal = 0
    var offset = 0
    while offset < value.len():
        val scalar = value.char_code_at(ordinal)
        if scalar < 0 or scalar > 1114111 or (scalar >= 55296 and scalar <= 57343): return -1
        units = units + (if scalar < 65536: 1 else: 2)
        offset = offset + (if scalar < 128: 1 elif scalar < 2048: 2 elif scalar < 65536: 3 else: 4)
        ordinal = ordinal + 1
    units
