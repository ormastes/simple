# Portable child-protocol facade; native standard handles never leave its owner.
pub use std.common.process.windows_broker_stdio_v1.{WindowsBrokerStdioLeaseV1,
    WindowsBrokerStdioAdmissionV1, WindowsBrokerStdioReadV1, WindowsBrokerStdioPollV1}
@when(os="windows"):
pub use std.nogc_sync_mut.io.windows_broker_stdio_native_v1.{windows_broker_stdio_open_v1,
    windows_broker_stdio_read_some_v1, windows_broker_stdio_write_some_v1,
    windows_broker_stdio_poll_v1, windows_broker_stdio_cancel_v1, windows_broker_stdio_collect_v1}
@else:
pub fn windows_broker_stdio_open_v1() -> WindowsBrokerStdioAdmissionV1:
    WindowsBrokerStdioAdmissionV1.Rejected("Windows broker stdio unsupported on this platform")
pub fn windows_broker_stdio_read_some_v1(lease: WindowsBrokerStdioLeaseV1, max_bytes: i64) -> WindowsBrokerStdioReadV1:
    WindowsBrokerStdioReadV1.Failed("Windows broker stdio unsupported on this platform")
pub fn windows_broker_stdio_write_some_v1(lease: WindowsBrokerStdioLeaseV1, bytes: [u8]) -> Result<i64, text>:
    Err("Windows broker stdio unsupported on this platform")
pub fn windows_broker_stdio_poll_v1(lease: WindowsBrokerStdioLeaseV1) -> Result<WindowsBrokerStdioPollV1, text>:
    Err("Windows broker stdio unsupported on this platform")
pub fn windows_broker_stdio_cancel_v1(lease: WindowsBrokerStdioLeaseV1) -> Result<bool, text>:
    Err("Windows broker stdio unsupported on this platform")
pub fn windows_broker_stdio_collect_v1(lease: WindowsBrokerStdioLeaseV1) -> Result<bool, text>:
    Err("Windows broker stdio unsupported on this platform")
@end
