# Windows-only connected-pipe trust and byte-mode ABI; no C/Rust provider.
@unsafe(reason: "actual server PID on the connected pipe HANDLE, not execution authority", capabilities: [ffi, raw_ptr])
extern fn GetNamedPipeServerProcessId(pipe: i64, server_pid: i64) -> i32
@unsafe(reason: "select byte read mode on the retained duplex pipe", capabilities: [ffi, raw_ptr])
extern fn SetNamedPipeHandleState(pipe: i64, mode: i64, count: i64, timeout: i64) -> i32
@unsafe(reason: "read connected object owner and DACL into an owned LocalAlloc descriptor", capabilities: [ffi, raw_ptr])
extern fn GetSecurityInfo(handle: i64, kind: i32, information: u32, owner: i64,
    group: i64, dacl: i64, sacl: i64, descriptor: i64) -> u32
@unsafe(reason: "bound OS-returned security descriptor storage", capabilities: [ffi, raw_ptr])
extern fn GetSecurityDescriptorLength(descriptor: i64) -> u32
@unsafe(reason: "observe protected and present DACL flags", capabilities: [ffi, raw_ptr])
extern fn GetSecurityDescriptorControl(descriptor: i64, control: i64, revision: i64) -> i32
@unsafe(reason: "validate the returned native DACL before ACE enumeration", capabilities: [ffi, raw_ptr])
extern fn IsValidAcl(acl: i64) -> i32
@unsafe(reason: "bounded ACL_SIZE_INFORMATION query", capabilities: [ffi, raw_ptr])
extern fn GetAclInformation(acl: i64, information: i64, size: u32, kind: i32) -> i32
@unsafe(reason: "retrieve one bounded ACE pointer from the validated DACL", capabilities: [ffi, raw_ptr])
extern fn GetAce(acl: i64, index: u32, ace: i64) -> i32
@unsafe(reason: "validate a bounded SID from the actual descriptor", capabilities: [ffi, raw_ptr])
extern fn IsValidSid(sid: i64) -> i32
@unsafe(reason: "classify exact SYSTEM/admin SIDs without name or membership guessing", capabilities: [ffi, raw_ptr])
extern fn IsWellKnownSid(sid: i64, kind: i32) -> i32
@unsafe(reason: "release only the retained GetSecurityInfo LocalAlloc descriptor", capabilities: [ffi, raw_ptr])
extern fn LocalFree(allocation: i64) -> i64

export GetNamedPipeServerProcessId, SetNamedPipeHandleState, GetSecurityInfo
export GetSecurityDescriptorLength, GetSecurityDescriptorControl, IsValidAcl
export GetAclInformation, GetAce, IsValidSid, IsWellKnownSid, LocalFree
