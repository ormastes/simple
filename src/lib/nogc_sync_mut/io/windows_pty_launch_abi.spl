# Only the Windows launch owners import these kernel32 contracts. No runtime ABI.
@unsafe(reason: "returns an OS-owned UTF16 environment snapshot or NULL", capabilities: [ffi, raw_ptr])
extern fn GetEnvironmentStringsW() -> i64
@unsafe(reason: "releases exactly the OS-owned snapshot; zero retains ownership", capabilities: [ffi, raw_ptr])
extern fn FreeEnvironmentStringsW(environment: i64) -> i32
@unsafe(reason: "compares bounded UTF16 names using Windows ordinal case rules; zero is failure", capabilities: [ffi, raw_ptr])
extern fn CompareStringOrdinal(first: i64, first_units: i32, second: i64, second_units: i32, ignore_case: i32) -> i32
@unsafe(reason: "writes trusted system directory into caller-owned bounded UTF16 storage", capabilities: [ffi, raw_ptr])
extern fn GetSystemDirectoryW(buffer: i64, capacity: u32) -> u32

export GetEnvironmentStringsW, FreeEnvironmentStringsW, CompareStringOrdinal, GetSystemDirectoryW
