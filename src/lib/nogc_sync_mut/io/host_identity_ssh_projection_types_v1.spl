# Values/grammar only: no path, number or decoded record constructs authority.
use std.nogc_sync_mut.io.host_identity_store_abi_v1.host_identity_leaf_valid_v1

pub struct HostIdentitySshPathsV1:
    identity_path: text
    known_hosts_path: text

fn host_identity_ssh_projection_roles_valid_v1(key_leaf: text, hosts_leaf: text) -> bool:
    (host_identity_leaf_valid_v1(key_leaf) and key_leaf.ends_with(".key") and
        host_identity_leaf_valid_v1(hosts_leaf) and hosts_leaf.ends_with(".hosts"))

export host_identity_ssh_projection_roles_valid_v1
