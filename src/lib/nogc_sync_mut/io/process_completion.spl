# Parent-owned completion evidence. A token is never presented as an OS PID.
# Providers return no receipt until the exact child tree is collected.
struct ProcessCompletionV1:
    pid: i64
    process_generation: i64
    exit_code: i64
    signal_number: i64
    tree_reaped: bool
    timed_out: bool
    cancelled: bool
    stdout_digest: text
    stderr_digest: text
    transport_execution_digest: text

export ProcessCompletionV1
