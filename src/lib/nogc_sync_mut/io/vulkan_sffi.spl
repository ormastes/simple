# Vulkan Compute Runtime SFFI Bindings
#
# SFFI pattern for Vulkan compute.
# Note: These require Vulkan SDK to be installed.

use std.gpu.engine2d.sffi_dispatch.{gpu_sffi_uses_interpreter_array_abi}

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

