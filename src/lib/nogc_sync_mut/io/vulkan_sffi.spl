# Exports
# ============================================================================

# Engine2D raw-handle bridge. These public names are deliberately rt_-free,
# @inline, and representation-preserving: this canonical provider remains the
# sole extern owner while policy modules retain their pure-Simple dispatch.

@inline
pub fn vulkan_abi_init() -> bool:
    rt_vulkan_init()

@inline
pub fn vulkan_abi_init_headless_present(width: i64, height: i64, vsync: i64) -> i64:
    rt_vulkan_init_headless_present(width, height, vsync)

@inline
pub fn vulkan_abi_init_window_present(width: i64, height: i64, vsync: i64) -> i64:
    rt_vulkan_init_window_present(width, height, vsync)

@inline
pub fn vulkan_abi_init_external_window_present(kind: i64, display: i64, window: i64, width: i64, height: i64, vsync: i64) -> i64:
    rt_vulkan_init_external_window_present(kind, display, window, width, height, vsync)

@inline
pub fn vulkan_abi_present_buffer(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64) -> i64:
    rt_vulkan_present_buffer(swapchain, buffer, width, height, content_revision)

@inline
pub fn vulkan_abi_present_buffer_regions(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64, rects: [i64]) -> i64:
    rt_vulkan_present_buffer_regions(swapchain, buffer, width, height, content_revision, rects)

@inline
pub fn vulkan_abi_last_present_copy_bytes(swapchain: i64) -> i64:
    rt_vulkan_last_present_copy_bytes(swapchain)

@inline
pub fn vulkan_abi_last_present_copy_rects(swapchain: i64) -> i64:
    rt_vulkan_last_present_copy_rects(swapchain)

@inline
pub fn vulkan_abi_destroy_swapchain(swapchain: i64) -> bool:
