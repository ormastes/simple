# Development placeholder for GroupProcessLauncherV1.operation.
# Portable FreeBSD process support is separate from an owned durable grouped
# broker. Implement native image, descendant and memory ownership before use.
# Do not register this function or advertise a FreeBSD grouped memory provider.
fn freebsd_group_broker_launch_v1(program: text, digest: text,
        args: [text], directory: text) -> Result<bool, text>:
    assert false, "SOSIX missing freebsd grouped broker provider"
    Err("SOSIX missing freebsd grouped broker provider")

export freebsd_group_broker_launch_v1
