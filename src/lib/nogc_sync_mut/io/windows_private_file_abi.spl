# Generation-checked native IO boundary. No raw HANDLE escapes this owner.
@unsafe(reason: "allocates bounded temporary with infallible free", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_alloc_v1(size: i64) -> i64
@unsafe(reason: "frees private malloc temporary", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_free_v1(memory: i64)
@unsafe(reason: "opens pinned private ancestry", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_root_open_v1(path: i64) -> i64
@unsafe(reason: "checks current root generation and security", capabilities: [ffi])
extern fn rt_windows_private_root_ready_v1(root: i64) -> i64
@unsafe(reason: "opens private child under retained root", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_directory_v1(root: i64, name: i64, create: i64) -> i64
@unsafe(reason: "opens private file under retained root", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_file_v1(root: i64, name: i64, create: i64, maximum: i64) -> i64
@unsafe(reason: "checks current file generation and security", capabilities: [ffi])
extern fn rt_windows_private_check_v1(file: i64, maximum: i64) -> i64
@unsafe(reason: "writes bounded bytes under authoritative phase lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_file_write_v1(file: i64, buffer: i64, length: i64) -> i64
@unsafe(reason: "reads bounded range under identity lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_file_read_v1(file: i64, offset: i64, buffer: i64, length: i64) -> i64
@unsafe(reason: "observes sealed file size under identity lock", capabilities: [ffi])
extern fn rt_windows_private_file_size_v1(file: i64) -> i64
@unsafe(reason: "flushes and seals authoritative native phase", capabilities: [ffi])
extern fn rt_windows_private_file_seal_v1(file: i64) -> i64
@unsafe(reason: "publishes under exact root and file generation lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_private_publish_v1(root: i64, file: i64, name: i64) -> i64
@unsafe(reason: "closes exact root generation preserving failed cleanup", capabilities: [ffi])
extern fn rt_windows_private_root_close_v1(root: i64) -> i64
@unsafe(reason: "closes exact file generation preserving failed cleanup", capabilities: [ffi])
extern fn rt_windows_private_file_close_v1(file: i64) -> i64
export rt_windows_private_alloc_v1, rt_windows_private_free_v1
export rt_windows_private_root_open_v1, rt_windows_private_root_ready_v1, rt_windows_private_directory_v1
export rt_windows_private_file_v1, rt_windows_private_check_v1, rt_windows_private_publish_v1
export rt_windows_private_file_write_v1, rt_windows_private_file_read_v1, rt_windows_private_file_size_v1
export rt_windows_private_file_seal_v1, rt_windows_private_root_close_v1, rt_windows_private_file_close_v1

# Journal kind is distinct from private roots/files and owns every operation's
# uncertain effects until close succeeds. No root handle or path escapes.
@unsafe(reason: "creates fixed journal child from actual retained root", capabilities: [ffi])
extern fn rt_windows_journal_open_v1(root: i64) -> i64
@unsafe(reason: "checks native journal generation, ACL, identity and owned lock", capabilities: [ffi])
extern fn rt_windows_journal_live_v1(store: i64) -> i64
@unsafe(reason: "allocates same-thread raw staging through existing runtime allocator", capabilities: [ffi, raw_ptr])
extern fn rt_alloc(size: i64) -> i64
@unsafe(reason: "releases caller-owned same-thread raw staging with matched allocator", capabilities: [ffi, raw_ptr])
extern fn rt_free(memory: i64)
@unsafe(reason: "reads exact bounded UTF8 under retained journal lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_journal_read_v1(store: i64, path: i64, buffer: i64, maximum: i64) -> i64
@unsafe(reason: "publishes sealed stage without replacement under retained lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_journal_publish_v1(store: i64, path: i64, payload: i64, length: i64, consumption: i64) -> i64
@unsafe(reason: "atomically replaces only parent lease under retained lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_journal_replace_v1(store: i64, path: i64, payload: i64, length: i64) -> i64
@unsafe(reason: "compares CURRENT and renames its stage in one native locked operation", capabilities: [ffi, raw_ptr])
extern fn rt_windows_journal_compare_replace_v1(store: i64, path: i64, payload: i64, length: i64, expected: i64, expected_length: i64) -> i64
@unsafe(reason: "claims exact newly published consumption once under native store lock", capabilities: [ffi, raw_ptr])
extern fn rt_windows_journal_consumption_claim_v1(store: i64, sequence: i64, expected: i64, length: i64) -> i64
@unsafe(reason: "retains failed cleanup and exact parent lock until completion", capabilities: [ffi])
extern fn rt_windows_journal_close_v1(store: i64) -> i64
export rt_windows_journal_open_v1, rt_windows_journal_live_v1, rt_alloc, rt_free
export rt_windows_journal_read_v1, rt_windows_journal_publish_v1, rt_windows_journal_replace_v1
export rt_windows_journal_compare_replace_v1, rt_windows_journal_close_v1
export rt_windows_journal_consumption_claim_v1
