# Direct Linux libc/libsystemd boundary. AUTHORED_NOT_RUN; native callers must
# explicitly link libsystemd. No new rt export, subprocess or service installer.
@when(os="linux"):
pub use std.nogc_sync_mut.io.linux_machine_policy_abi_v1.*
@unsafe(reason: "new independently owned sd-bus connection", capabilities: [ffi, raw_ptr])
extern fn sd_bus_new(output: i64) -> i32
@unsafe(reason: "fixed system-bus address, never environment selection", capabilities: [ffi, raw_ptr])
extern fn sd_bus_set_address(bus: i64, address: i64) -> i32
@unsafe(reason: "explicit broker client mode", capabilities: [ffi])
extern fn sd_bus_set_bus_client(bus: i64, enabled: i32) -> i32
@unsafe(reason: "disable interactive authorization for fixed administrative operations", capabilities: [ffi])
extern fn sd_bus_set_allow_interactive_authorization(bus: i64, enabled: i32) -> i32
@unsafe(reason: "bounded default authentication/method timeout", capabilities: [ffi])
extern fn sd_bus_set_method_call_timeout(bus: i64, microseconds: u64) -> i32
@unsafe(reason: "authenticate fixed local system bus", capabilities: [ffi])
extern fn sd_bus_start(bus: i64) -> i32
@unsafe(reason: "actual authenticated bus-broker credentials", capabilities: [ffi, raw_ptr])
extern fn sd_bus_get_owner_creds(bus: i64, mask: u64, output: i64) -> i32
@unsafe(reason: "actual system-manager unique owner credentials", capabilities: [ffi, raw_ptr])
extern fn sd_bus_get_name_creds(bus: i64, name: i64, mask: u64, output: i64) -> i32
@unsafe(reason: "read authenticated numeric peer UID", capabilities: [ffi, raw_ptr])
extern fn sd_bus_creds_get_euid(credentials: i64, output: i64) -> i32
@unsafe(reason: "read authenticated numeric peer PID", capabilities: [ffi, raw_ptr])
extern fn sd_bus_creds_get_pid(credentials: i64, output: i64) -> i32
@unsafe(reason: "borrow credential-owned unique-name string", capabilities: [ffi, raw_ptr])
extern fn sd_bus_creds_get_unique_name(credentials: i64, output: i64) -> i32
@unsafe(reason: "drop exactly one credential reference", capabilities: [ffi])
extern fn sd_bus_creds_unref(credentials: i64) -> i64
@unsafe(reason: "allocate outbound message with explicit destination", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_new_method_call(bus: i64, output: i64, destination: i64,
    path: i64, interface: i64, member: i64) -> i32
@unsafe(reason: "nonvariadic copied basic D-Bus field", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_append_basic(message: i64, field_type: u8, value: i64) -> i32
@unsafe(reason: "bounded explicit D-Bus array builder", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_open_container(message: i64, field_type: u8, contents: i64) -> i32
@unsafe(reason: "finish explicit D-Bus array builder", capabilities: [ffi])
extern fn sd_bus_message_close_container(message: i64) -> i32
@unsafe(reason: "bounded call; NULL error output prevents allocated error ownership", capabilities: [ffi, raw_ptr])
extern fn sd_bus_call(bus: i64, message: i64, microseconds: u64, error: i64, output: i64) -> i32
@unsafe(reason: "manual StopUnit message pump retains reply and completion in either order", capabilities: [ffi, raw_ptr])
extern fn sd_bus_send(bus: i64, message: i64, cookie: i64) -> i32
@unsafe(reason: "match actual response to exact outgoing message cookie", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_get_reply_cookie(message: i64, cookie: i64) -> i32
@unsafe(reason: "distinguish actual method error from method-return object path", capabilities: [ffi])
extern fn sd_bus_message_is_method_error(message: i64, name: i64) -> i32
@unsafe(reason: "read exact nonvariadic basic response field", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_read_basic(message: i64, field_type: u8, output: i64) -> i32
@unsafe(reason: "bounded nested response decoding", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_enter_container(message: i64, field_type: u8, contents: i64) -> i32
@unsafe(reason: "finish nested response decoding", capabilities: [ffi])
extern fn sd_bus_message_exit_container(message: i64) -> i32
@unsafe(reason: "require complete exact response shape", capabilities: [ffi])
extern fn sd_bus_message_at_end(message: i64, complete: i32) -> i32
@unsafe(reason: "borrow authenticated message sender name", capabilities: [ffi])
extern fn sd_bus_message_get_sender(message: i64) -> i64
@unsafe(reason: "test exact signal interface/member", capabilities: [ffi, raw_ptr])
extern fn sd_bus_message_is_signal(message: i64, interface: i64, member: i64) -> i32
@unsafe(reason: "borrow exact signal object path", capabilities: [ffi])
extern fn sd_bus_message_get_path(message: i64) -> i64
@unsafe(reason: "drop exactly one owned message reference", capabilities: [ffi])
extern fn sd_bus_message_unref(message: i64) -> i64
@unsafe(reason: "receive unhandled subscribed signal without a foreign callback", capabilities: [ffi, raw_ptr])
extern fn sd_bus_process(bus: i64, output: i64) -> i32
@unsafe(reason: "bounded bus readiness wait", capabilities: [ffi])
extern fn sd_bus_wait(bus: i64, microseconds: u64) -> i32
@unsafe(reason: "close this owned system-bus connection only", capabilities: [ffi])
extern fn sd_bus_close(bus: i64)
@unsafe(reason: "drop exactly one owned bus reference", capabilities: [ffi])
extern fn sd_bus_unref(bus: i64) -> i64
@unsafe(reason: "transfer an independently opened proc directory fd to libc directory owner", capabilities: [ffi])
extern fn fdopendir(fd: i32) -> i64
@unsafe(reason: "borrow next Linux dirent64 record until next call", capabilities: [ffi])
extern fn readdir(directory: i64) -> i64
@unsafe(reason: "consume exactly one libc directory owner", capabilities: [ffi])
extern fn closedir(directory: i64) -> i32
@unsafe(reason: "distinguish directory end from failed enumeration", capabilities: [ffi])
extern fn __errno_location() -> i64
@unsafe(reason: "read-only kernel lifetime pin for the original observed process; never signals it", capabilities: [ffi])
extern fn pidfd_open(pid: i32, flags: u32) -> i32
@unsafe(reason: "bounded readiness observation of the owned original pidfd; no wait/reap or signal", capabilities: [ffi, raw_ptr])
extern fn poll(descriptors: i64, count: u64, timeout_ms: i32) -> i32
export sd_bus_new, sd_bus_set_address, sd_bus_set_bus_client, sd_bus_set_allow_interactive_authorization
export sd_bus_set_method_call_timeout, sd_bus_start, sd_bus_get_owner_creds, sd_bus_get_name_creds
export sd_bus_creds_get_euid, sd_bus_creds_get_pid, sd_bus_creds_get_unique_name, sd_bus_creds_unref
export sd_bus_message_new_method_call, sd_bus_message_append_basic, sd_bus_message_open_container
export sd_bus_message_close_container, sd_bus_call, sd_bus_message_read_basic
export sd_bus_send, sd_bus_message_get_reply_cookie, sd_bus_message_is_method_error
export sd_bus_message_enter_container, sd_bus_message_exit_container, sd_bus_message_at_end
export sd_bus_message_get_sender, sd_bus_message_is_signal, sd_bus_message_get_path, sd_bus_message_unref
export sd_bus_process, sd_bus_wait, sd_bus_close, sd_bus_unref, fdopendir, readdir, closedir, __errno_location
export pidfd_open, poll
@end
