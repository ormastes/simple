# Linux-only cgroup-v2 and pidfd owner. The broker is the sole lease holder;
# the C shim installs memory.max before CLONE_INTO_CGROUP and execveat.
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow, file_hash_sha256}
use std.common.build_manager.contracts.{builder_digest_valid_v1}

struct LinuxProcessInputV1:
    path: text
    digest: text

struct LinuxProcessRequestV1:
    program: text
    producer_digest: text
    args: [text]
    environment: [text]
    directory: text
    inputs: [LinuxProcessInputV1]
    stdout_path: text
    stderr_path: text
    timeout_ms: i64

struct LinuxProcessLeaseV1:
    token: i64

struct LinuxProcessPollV1:
    terminal: bool
    leader_reaped: bool
    tree_empty: bool
    active_processes: i64
    exit_code: i64
    timed_out: bool
    cancelled: bool
    memory_peak_bytes: i64
    memory_current_bytes: i64

@unsafe(reason: "Linux cgroup-v2 clone3/pidfd owner start", capabilities: [ffi])
extern fn rt_linux_group_start_v1(program: text, digest: text, args: [text],
    environment: [text], directory: text, root: text, identity: text,
    memory_limit_bytes: i64, timeout_ms: i64, stdout_path: text,
    stderr_path: text) -> [i64]
@unsafe(reason: "Linux exact pinned broker image detached exec", capabilities: [ffi])
extern fn rt_linux_group_launch_broker_v1(program: text, digest: text,
    args: [text]) -> [i64]
@unsafe(reason: "Linux pidfd and cgroup-v2 tree poll", capabilities: [ffi])
extern fn rt_linux_group_poll_v1(token: i64) -> [i64]
@unsafe(reason: "Linux cgroup.kill cancellation", capabilities: [ffi])
extern fn rt_linux_group_cancel_v1(token: i64) -> i64
@unsafe(reason: "Linux exact leader/cgroup cleanup", capabilities: [ffi])
extern fn rt_linux_group_collect_v1(token: i64) -> [i64]
@unsafe(reason: "Linux meminfo/cgroup and statvfs capacity snapshot", capabilities: [ffi])
extern fn rt_linux_group_available_capacity_v1(path: text) -> [i64]

fn linux_process_absolute_v1(path: text) -> bool:
    path.starts_with("/") and not path.contains("\0") and
        not path.contains("/../") and not path.ends_with("/..")

fn linux_process_request_valid_v1(request: LinuxProcessRequestV1,
        root: text, identity: text, memory_limit_bytes: i64) -> text:
    if not builder_digest_valid_v1(request.producer_digest) or
            not builder_digest_valid_v1(identity): return "invalid Linux process digest"
    for path in [request.program, request.directory, request.stdout_path,
            request.stderr_path, root]:
        if not linux_process_absolute_v1(path): return "Linux process path must be absolute"
    if request.args.len() > 4096 or request.environment.len() > 4096 or
            request.inputs.len() > 100000 or request.timeout_ms < 1 or
            request.timeout_ms > 86400000 or memory_limit_bytes < 1:
        return "Linux process request exceeds bound"
    for arg in request.args:
        if arg.contains("\0"): return "NUL in Linux process argument"
    for assignment in request.environment:
        if assignment.contains("\0") or not assignment.contains("="):
            return "invalid Linux process environment"
    for input in request.inputs:
        if not linux_process_absolute_v1(input.path) or
                not builder_digest_valid_v1(input.digest):
            return "invalid Linux process input"
    ""

fn linux_process_poll_decode_v1(fields: [i64]) -> Result<LinuxProcessPollV1, text>:
    if fields.len() != 10: return Err("Linux process observation layout differs")
    if fields[0] != 0: return Err("Linux process owner error: " + str(fields[0]))
    if fields[4] < 0 or fields[4] > 1000000 or fields[5] < 0 or
            fields[7] < 0 or fields[8] < 0 or fields[9] < 0 or
            fields[9] > fields[8]:
        return Err("Linux process observation outside bound")
    val observed = LinuxProcessPollV1(fields[1] == 1, fields[2] == 1,
        fields[3] == 1, fields[4], fields[5], fields[6] == 1,
        fields[7] == 1, fields[8], fields[9])
    if observed.terminal and (not observed.leader_reaped or not observed.tree_empty or
            observed.active_processes != 0):
        return Err("Linux terminal observation lacks complete tree reap")
    Ok(observed)

fn linux_process_start_with_memory_v1(request: LinuxProcessRequestV1,
        memory_limit_bytes: i64, root: text,
        identity: text) -> Result<LinuxProcessLeaseV1, text>:
    val invalid = linux_process_request_valid_v1(request, root, identity, memory_limit_bytes)
    if invalid != "": return Err(invalid)
    if not file_is_regular_no_follow(request.program) or
            file_hash_sha256(request.program) != request.producer_digest:
        return Err("Linux process executable differs from pinned digest")
    for input in request.inputs:
        if not file_is_regular_no_follow(input.path) or
                file_hash_sha256(input.path) != input.digest:
            return Err("Linux process input differs from pinned digest: " + input.path)
    val started = unsafe(capabilities: [ffi]):
        rt_linux_group_start_v1(request.program, request.producer_digest,
            request.args, request.environment, request.directory, root,
            identity, memory_limit_bytes, request.timeout_ms,
            request.stdout_path, request.stderr_path)
    if started.len() != 2 or started[0] <= 0 or started[1] != 0:
        return Err("Linux cgroup process start rejected: " +
            (if started.len() == 2: str(started[1]) else: "invalid receipt"))
    Ok(LinuxProcessLeaseV1(started[0]))

fn linux_process_poll_v1(lease: LinuxProcessLeaseV1) -> Result<LinuxProcessPollV1, text>:
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_poll_v1(lease.token)
    linux_process_poll_decode_v1(fields)

fn linux_process_cancel_v1(lease: LinuxProcessLeaseV1) -> Result<bool, text>:
    val code = unsafe(capabilities: [ffi]): rt_linux_group_cancel_v1(lease.token)
    if code != 0: return Err("Linux cgroup cancellation failed: " + str(code))
    Ok(true)

fn linux_process_peak_memory_v1(lease: LinuxProcessLeaseV1) -> Result<i64, text>:
    val observed = linux_process_poll_v1(lease)?
    Ok(observed.memory_peak_bytes)

fn linux_process_collect_v1(lease: LinuxProcessLeaseV1) -> Result<LinuxProcessPollV1, text>:
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_collect_v1(lease.token)
    linux_process_poll_decode_v1(fields)

fn linux_available_capacity_v1(path: text) -> Result<(i64, i64), text>:
    if not linux_process_absolute_v1(path): return Err("Linux capacity path must be absolute")
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_available_capacity_v1(path)
    if fields.len() != 3 or fields[0] != 0 or fields[1] <= 0 or fields[2] <= 0:
        return Err("Linux capacity measurement unavailable")
    Ok((fields[1], fields[2]))

fn linux_process_launch_broker_v1(program: text, digest: text,
        args: [text]) -> Result<bool, text>:
    if not linux_process_absolute_v1(program) or not builder_digest_valid_v1(digest) or
            args.len() != 4:
        return Err("Linux broker launch request invalid")
    if not file_is_regular_no_follow(program) or file_hash_sha256(program) != digest:
        return Err("Linux broker image differs from pinned digest")
    val fields = unsafe(capabilities: [ffi]):
        rt_linux_group_launch_broker_v1(program, digest, args)
    if fields.len() != 2 or fields[0] <= 0 or fields[1] != 0:
        return Err("Linux pinned broker launch rejected: " +
            (if fields.len() == 2: str(fields[1]) else: "invalid receipt"))
    Ok(true)

export LinuxProcessInputV1, LinuxProcessRequestV1, LinuxProcessLeaseV1, LinuxProcessPollV1
export linux_process_start_with_memory_v1, linux_process_poll_v1
export linux_process_cancel_v1, linux_process_peak_memory_v1, linux_process_collect_v1
export linux_available_capacity_v1, linux_process_request_valid_v1
export linux_process_launch_broker_v1
