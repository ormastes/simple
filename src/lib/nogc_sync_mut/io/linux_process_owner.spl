# Linux-only cgroup-v2 and pidfd owner. The broker is the sole lease holder;
# the C shim installs the selected memory.max before clone/exec (0 means max).
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow, file_hash_sha256}
use std.common.build_manager.contracts.{builder_digest_valid_v1}

struct LinuxProcessInputV1:
    path: text
    digest: text

struct LinuxProcessRequestV1:
    program: text
    producer_digest: text
    args: [text]
    environment: [text]
    directory: text
    inputs: [LinuxProcessInputV1]
    stdout_path: text
    stderr_path: text
    timeout_ms: i64

struct LinuxProcessLeaseV1:
    token: i64

struct LinuxCgroupParentV1:
    token: i64
    path: text
    device: i64
    inode: i64

enum LinuxCgroupParentAdmissionV1:
    Acquired(parent: LinuxCgroupParentV1)
    Rejected(reason: text)
    CleanupPending(parent: LinuxCgroupParentV1, reason: text)
    Unknown(reason: text)

struct LinuxProcessPollV1:
    terminal: bool
    leader_reaped: bool
    tree_empty: bool
    active_processes: i64
    exit_code: i64
    timed_out: bool
    cancelled: bool
    memory_peak_bytes: i64
    memory_current_bytes: i64

@unsafe(reason: "Linux cgroup-v2 clone3/pidfd owner start", capabilities: [ffi])
extern fn rt_linux_group_start_v1(program: text, digest: text, args: [text],
    environment: [text], directory: text, root: text, identity: text,
    memory_limit_bytes: i64, timeout_ms: i64, stdout_path: text,
    stderr_path: text) -> [i64]
@unsafe(reason: "Linux exact pinned broker image detached exec", capabilities: [ffi])
extern fn rt_linux_group_launch_broker_v1(program: text, digest: text,
    args: [text]) -> [i64]
@unsafe(reason: "Linux pidfd and cgroup-v2 tree poll", capabilities: [ffi])
extern fn rt_linux_group_poll_v1(token: i64) -> [i64]
@unsafe(reason: "Linux cgroup.kill cancellation", capabilities: [ffi])
extern fn rt_linux_group_cancel_v1(token: i64) -> i64
@unsafe(reason: "Linux exact leader/cgroup cleanup", capabilities: [ffi])
extern fn rt_linux_group_collect_v1(token: i64) -> [i64]
@unsafe(reason: "Linux meminfo/cgroup and statvfs capacity snapshot", capabilities: [ffi])
extern fn rt_linux_group_available_capacity_v1(path: text) -> [i64]
@unsafe(reason: "explicit fresh empty cgroup parent acquisition", capabilities: [ffi])
extern fn rt_linux_group_parent_acquire_v1(attempt: text, identity: text) -> [i64]
@unsafe(reason: "explicit current-delegation cgroup parent acquisition", capabilities: [ffi])
extern fn rt_linux_group_parent_acquire_at_v2(delegated_path: text, attempt: text,
    identity: text) -> [i64]
@unsafe(reason: "removes only the pinned owned empty cgroup parent", capabilities: [ffi])
extern fn rt_linux_group_parent_release_v1(token: i64) -> i64

fn linux_cgroup_parent_acquire_v1(attempt: text, identity: text) -> Result<LinuxCgroupParentV1, text>:
    match linux_cgroup_parent_admit_v1(attempt, identity):
        LinuxCgroupParentAdmissionV1.Acquired(parent): Ok(parent)
        LinuxCgroupParentAdmissionV1.Rejected(reason): Err(reason)
        LinuxCgroupParentAdmissionV1.CleanupPending(parent, reason):
            val _released = linux_cgroup_parent_release_v1(parent)?
            Err(reason)
        LinuxCgroupParentAdmissionV1.Unknown(reason): Err(reason)

fn linux_cgroup_parent_admit_v1(attempt: text, identity: text) -> LinuxCgroupParentAdmissionV1:
    if not linux_process_absolute_v1(attempt) or not builder_digest_valid_v1(identity):
        return LinuxCgroupParentAdmissionV1.Rejected("invalid Linux parent acquisition request")
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_parent_acquire_v1(attempt, identity)
    if fields.len() != 4: return LinuxCgroupParentAdmissionV1.Unknown("Linux parent acquisition receipt layout differs")
    val reason = "Linux owned parent acquisition rejected: " + str(fields[0])
    if fields[0] != 0 and fields[1] == 0:
        return LinuxCgroupParentAdmissionV1.Rejected(reason)
    if fields[1] <= 0 or fields[2] < 0 or fields[3] <= 0:
        return LinuxCgroupParentAdmissionV1.Unknown("Linux parent acquisition receipt invalid; cleanup unproven")
    val parent = LinuxCgroupParentV1(fields[1], "/sys/fs/cgroup/simple-parent-" + identity, fields[2], fields[3])
    if fields[0] != 0: return LinuxCgroupParentAdmissionV1.CleanupPending(parent, reason)
    LinuxCgroupParentAdmissionV1.Acquired(parent)

fn linux_cgroup_parent_acquire_at_v2(delegated_path: text, attempt: text,
        identity: text) -> Result<LinuxCgroupParentV1, text>:
    match linux_cgroup_parent_admit_at_v2(delegated_path, attempt, identity):
        LinuxCgroupParentAdmissionV1.Acquired(parent): Ok(parent)
        LinuxCgroupParentAdmissionV1.Rejected(reason): Err(reason)
        LinuxCgroupParentAdmissionV1.CleanupPending(parent, reason):
            val _released = linux_cgroup_parent_release_v1(parent)?
            Err(reason)
        LinuxCgroupParentAdmissionV1.Unknown(reason): Err(reason)

fn linux_cgroup_parent_admit_at_v2(delegated_path: text, attempt: text,
        identity: text) -> LinuxCgroupParentAdmissionV1:
    if not linux_process_absolute_v1(delegated_path) or
            not linux_process_absolute_v1(attempt) or not builder_digest_valid_v1(identity):
        return LinuxCgroupParentAdmissionV1.Rejected("invalid Linux delegated parent acquisition request")
    val fields = unsafe(capabilities: [ffi]):
        rt_linux_group_parent_acquire_at_v2(delegated_path, attempt, identity)
    linux_cgroup_parent_decode_at_v2(fields, delegated_path, identity)

fn linux_cgroup_parent_decode_at_v2(fields: [i64], delegated_path: text,
        identity: text) -> LinuxCgroupParentAdmissionV1:
    if fields.len() != 4: return LinuxCgroupParentAdmissionV1.Unknown("Linux delegated parent receipt layout differs")
    if fields[1] < 0:
        return LinuxCgroupParentAdmissionV1.Unknown("Linux delegated parent ownership could not be proven")
    val reason = "Linux delegated parent acquisition rejected: " + str(fields[0])
    if fields[0] != 0 and fields[1] == 0:
        return LinuxCgroupParentAdmissionV1.Rejected(reason)
    if fields[1] <= 0 or fields[2] < 0 or fields[3] <= 0:
        return LinuxCgroupParentAdmissionV1.Unknown("Linux delegated parent ownership could not be proven")
    val parent = LinuxCgroupParentV1(fields[1], delegated_path + "/simple-parent-" + identity,
        fields[2], fields[3])
    if fields[0] != 0: return LinuxCgroupParentAdmissionV1.CleanupPending(parent, reason)
    LinuxCgroupParentAdmissionV1.Acquired(parent)

fn linux_cgroup_parent_release_v1(parent: LinuxCgroupParentV1) -> Result<bool, text>:
    val code = unsafe(capabilities: [ffi]): rt_linux_group_parent_release_v1(parent.token)
    if code != 0: return Err("Linux owned parent cleanup unproven: " + str(code))
    Ok(true)

fn linux_process_absolute_v1(path: text) -> bool:
    path.starts_with("/") and not path.contains("\0") and
        not path.contains("/../") and not path.ends_with("/..")

fn linux_process_request_valid_v1(request: LinuxProcessRequestV1,
        root: text, identity: text, memory_limit_bytes: i64) -> text:
    if not builder_digest_valid_v1(request.producer_digest) or
            not builder_digest_valid_v1(identity): return "invalid Linux process digest"
    for path in [request.program, request.directory, request.stdout_path,
            request.stderr_path, root]:
        if not linux_process_absolute_v1(path): return "Linux process path must be absolute"
    if request.args.len() > 4096 or request.environment.len() > 4096 or
            request.inputs.len() > 100000 or request.timeout_ms < 0 or
            request.timeout_ms > 604800000 or memory_limit_bytes < 0 or
            memory_limit_bytes > 1125899906842624:
        return "Linux process request exceeds bound"
    for arg in request.args:
        if arg.contains("\0"): return "NUL in Linux process argument"
    for assignment in request.environment:
        if assignment.contains("\0") or not assignment.contains("="):
            return "invalid Linux process environment"
    for input in request.inputs:
        if not linux_process_absolute_v1(input.path) or
                not builder_digest_valid_v1(input.digest):
            return "invalid Linux process input"
    ""

fn linux_process_poll_decode_v1(fields: [i64]) -> Result<LinuxProcessPollV1, text>:
    if fields.len() != 10: return Err("Linux process observation layout differs")
    if fields[0] != 0: return Err("Linux process owner error: " + str(fields[0]))
    if fields[4] < 0 or fields[4] > 1000000 or fields[5] < 0 or
            fields[7] < 0 or fields[8] < 0 or fields[9] < 0 or
            fields[9] > fields[8]:
        return Err("Linux process observation outside bound")
    val observed = LinuxProcessPollV1(fields[1] == 1, fields[2] == 1,
        fields[3] == 1, fields[4], fields[5], fields[6] == 1,
        fields[7] == 1, fields[8], fields[9])
    if observed.terminal and (not observed.leader_reaped or not observed.tree_empty or
            observed.active_processes != 0):
        return Err("Linux terminal observation lacks complete tree reap")
    Ok(observed)

fn linux_process_start_with_memory_v1(request: LinuxProcessRequestV1,
        memory_limit_bytes: i64, root: text,
        identity: text) -> Result<LinuxProcessLeaseV1, text>:
    val invalid = linux_process_request_valid_v1(request, root, identity, memory_limit_bytes)
    if invalid != "": return Err(invalid)
    if not file_is_regular_no_follow(request.program) or
            not _file_sha256_matches(request.program, request.producer_digest):
        return Err("Linux process executable differs from pinned digest")
    for input in request.inputs:
        if not file_is_regular_no_follow(input.path) or
                not _file_sha256_matches(input.path, input.digest):
            return Err("Linux process input differs from pinned digest: " + input.path)
    val started = unsafe(capabilities: [ffi]):
        rt_linux_group_start_v1(request.program, request.producer_digest,
            request.args, request.environment, request.directory, root,
            identity, memory_limit_bytes, request.timeout_ms,
            request.stdout_path, request.stderr_path)
    if started.len() != 2 or started[0] <= 0 or started[1] != 0:
        return Err("Linux cgroup process start rejected: " +
            (if started.len() == 2: str(started[1]) else: "invalid receipt"))
    Ok(LinuxProcessLeaseV1(started[0]))

fn linux_process_poll_v1(lease: LinuxProcessLeaseV1) -> Result<LinuxProcessPollV1, text>:
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_poll_v1(lease.token)
    linux_process_poll_decode_v1(fields)

fn linux_process_cancel_v1(lease: LinuxProcessLeaseV1) -> Result<bool, text>:
    val code = unsafe(capabilities: [ffi]): rt_linux_group_cancel_v1(lease.token)
    if code != 0: return Err("Linux cgroup cancellation failed: " + str(code))
    Ok(true)

fn linux_process_peak_memory_v1(lease: LinuxProcessLeaseV1) -> Result<i64, text>:
    val observed = linux_process_poll_v1(lease)?
    Ok(observed.memory_peak_bytes)

fn linux_process_collect_v1(lease: LinuxProcessLeaseV1) -> Result<LinuxProcessPollV1, text>:
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_collect_v1(lease.token)
    linux_process_poll_decode_v1(fields)

fn linux_available_capacity_v1(path: text) -> Result<(i64, i64), text>:
    if not linux_process_absolute_v1(path): return Err("Linux capacity path must be absolute")
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_available_capacity_v1(path)
    if fields.len() != 3:
        return Err("Linux capacity measurement unavailable")
    if fields[0] != 0:
        return Err("Linux capacity measurement unavailable (native status {fields[0]}; requires a writable cgroup-v2 parent with memory delegated to children)")
    if fields[1] <= 0 or fields[2] <= 0:
        return Err("Linux capacity measurement unavailable")
    Ok((fields[1], fields[2]))

fn linux_process_launch_broker_v1(program: text, digest: text,
        args: [text]) -> Result<bool, text>:
    if not linux_process_absolute_v1(program) or not builder_digest_valid_v1(digest) or
            args.len() != 4:
        return Err("Linux broker launch request invalid")
    if not file_is_regular_no_follow(program) or not _file_sha256_matches(program, digest):
        return Err("Linux broker image differs from pinned digest")
    val fields = unsafe(capabilities: [ffi]):
        rt_linux_group_launch_broker_v1(program, digest, args)
    if fields.len() != 2 or fields[0] <= 0 or fields[1] != 0:
        return Err("Linux pinned broker launch rejected: " +
            (if fields.len() == 2: str(fields[1]) else: "invalid receipt"))
    Ok(true)

export LinuxProcessInputV1, LinuxProcessRequestV1, LinuxProcessLeaseV1, LinuxProcessPollV1
export linux_process_start_with_memory_v1, linux_process_poll_v1
export linux_process_cancel_v1, linux_process_peak_memory_v1, linux_process_collect_v1
export linux_available_capacity_v1, linux_process_request_valid_v1
export linux_process_launch_broker_v1
export LinuxCgroupParentV1, linux_cgroup_parent_acquire_v1, linux_cgroup_parent_release_v1
export LinuxCgroupParentAdmissionV1, linux_cgroup_parent_admit_v1
export linux_cgroup_parent_acquire_at_v2, linux_cgroup_parent_admit_at_v2
export linux_cgroup_parent_decode_at_v2

# Absent digest (missing or unreadable file) is an explicit mismatch.
fn _file_sha256_matches(path: text, expected: text) -> bool:
    if val digest = file_hash_sha256(path):
        return digest == expected
    false

# Explicit group-stream profile; V1 file-capture requests stay unchanged.
use std.common.build_manager.group_process_stream_protocol_v2.{
    GroupProcessStreamLaunchV2, group_process_stream_launch_validate_profiled_v3, group_process_stream_identity_profiled_v3
}
use std.common.build_manager.group_process_stream_profile_v3.{GroupProcessStreamProfileV3}
use std.common.string_core.{str_len}

@unsafe(reason: "real delegated cgroup/pidfd/kill capability admission before any helper fork", capabilities: [ffi])
extern fn rt_linux_group_stream_admit_v2(path: text, path_len: i64) -> i64
@unsafe(reason: "pinned detached broker gets exact ticket FD4/5 handoff; post-fork uncertainty retains ticket", capabilities: [ffi])
extern fn rt_linux_group_launch_stream_broker_v2(program: text, program_len: i64,
    digest: text, digest_len: i64, args: [text], generation: i64, root: text,
    root_len: i64, identity: text, identity_len: i64, delegated: text, delegated_len: i64,
    launch_deadline_unix_ms: i64) -> [i64]
@unsafe(reason: "same cgroup/pidfd owner, fixed inherited streams, retained token on exec failure", capabilities: [ffi])
extern fn rt_linux_group_start_stream_v2(program: text, program_len: i64, digest: text,
    digest_len: i64, args: [text], environment: [text], directory: text, directory_len: i64,
    root: text, root_len: i64, identity: text, identity_len: i64,
    memory_limit_bytes: i64, timeout_ms: i64, launch_deadline_unix_ms: i64) -> [i64]

enum LinuxProcessStreamStartV2:
    Unknown(reason: text)
    Ready(lease: LinuxProcessLeaseV1)
    CleanupRequired(lease: LinuxProcessLeaseV1, reason: text)
    NoChildCleanupRequired(lease: LinuxProcessLeaseV1, reason: text)
    Rejected(reason: text)

fn linux_process_stream_admit_v2(delegated_path: text) -> Result<(), text>:
    if not linux_process_absolute_v1(delegated_path): return Err("Linux stream requires a delegated cgroup path")
    val status = unsafe(capabilities: [ffi]):
        rt_linux_group_stream_admit_v2(delegated_path, str_len(delegated_path))
    if status != 0: return Err("Linux stream capability admission failed: {status}")
    Ok(())

fn linux_process_launch_stream_broker_v2(program: text, digest: text, args: [text],
        generation: i64, root: text, identity: text, delegated_path: text,
        launch_deadline_unix_ms: i64) -> Result<i64, text>:
    if not linux_process_absolute_v1(program) or not linux_process_absolute_v1(root) or
            not builder_digest_valid_v1(digest) or not builder_digest_valid_v1(identity) or generation <= 0:
        return Err("invalid Linux stream broker launch binding")
    val status = unsafe(capabilities: [ffi]):
        rt_linux_group_launch_stream_broker_v2(program, str_len(program), digest, str_len(digest),
            args, generation, root, str_len(root), identity, str_len(identity), delegated_path,
            str_len(delegated_path), launch_deadline_unix_ms)
    if status.len() != 2: return Err("Linux stream broker launch receipt unknown; cleanup required")
    if status[0] <= 0 or status[1] != 0:
        return Err("Linux stream broker launch not confirmed; cleanup required: {status[1]}")
    Ok(status[0])

fn linux_process_stream_start_v2(launch: GroupProcessStreamLaunchV2,
        identity: text, memory_limit_bytes: i64) -> LinuxProcessStreamStartV2:
    val invalid = group_process_stream_launch_validate_profiled_v3(launch)
    if invalid != "": return LinuxProcessStreamStartV2.Rejected(invalid)
    if launch.transport_generation <= 0 or group_process_stream_identity_profiled_v3(launch) != identity:
        return LinuxProcessStreamStartV2.Rejected("Linux stream immutable identity mismatch")
    if launch.profile_v3 != nil and memory_limit_bytes != launch.memory_limit_bytes:
        return LinuxProcessStreamStartV2.Rejected("profiled helper memory differs from admitted request")
    val request = launch.request
    for path in [request.program, request.directory, request.broker_program, launch.root, launch.delegated_cgroup_path]:
        if not linux_process_absolute_v1(path): return LinuxProcessStreamStartV2.Rejected("Linux stream path/delegation invalid")
    if not file_is_regular_no_follow(request.program) or not _file_sha256_matches(request.program, request.producer_digest):
        return LinuxProcessStreamStartV2.Rejected("Linux stream executable differs from pinned digest")
    if not _file_sha256_matches(launch.root + "/broker.request.sdn", identity):
        return LinuxProcessStreamStartV2.Rejected("Linux stream immutable request differs")
    for input in request.inputs:
        if not file_is_regular_no_follow(input.path) or not _file_sha256_matches(input.path, input.digest):
            return LinuxProcessStreamStartV2.Rejected("Linux stream input differs: " + input.path)
    val status = match launch.profile_v3:
        case None:
            unsafe(capabilities: [ffi]):
                rt_linux_group_start_stream_v2(request.program, str_len(request.program), request.producer_digest,
                    str_len(request.producer_digest), request.args, request.environment, request.directory,
                    str_len(request.directory), launch.root, str_len(launch.root), identity, str_len(identity),
                    memory_limit_bytes, request.timeout_ms, request.launch_deadline_unix_ms)
        case Some(profile):
            val broker = profile.broker
            val words = _linux_process_stream_profile_words_v3(profile)
            unsafe(capabilities: [ffi]):
                rt_linux_group_start_stream_profiled_v3(request.program, str_len(request.program), request.producer_digest,
                    str_len(request.producer_digest), request.args, request.environment, request.directory,
                    str_len(request.directory), launch.root, str_len(launch.root), identity, str_len(identity),
                    memory_limit_bytes, request.timeout_ms, request.launch_deadline_unix_ms,
                    broker.cgroup_path, str_len(broker.cgroup_path), broker.policy_digest, str_len(broker.policy_digest), words)
    if status.len() != 2:
        return LinuxProcessStreamStartV2.Unknown("Linux stream native start receipt unknown; broker must retain authority")
    if status[0] > 0:
        val lease = LinuxProcessLeaseV1(status[0])
        val kind = linux_process_stream_no_child_scope_v2(launch.root, identity)
        if kind == 1 or kind == 2:
            return LinuxProcessStreamStartV2.NoChildCleanupRequired(lease, "Linux scope cleanup retained without child launch: {status[1]}")
        if kind < 0: return LinuxProcessStreamStartV2.Unknown("native stream scope classification unknown")
        if status[1] != 0: return LinuxProcessStreamStartV2.CleanupRequired(lease, "Linux stream exec/admission failed: {status[1]}")
        return LinuxProcessStreamStartV2.Ready(lease)
    LinuxProcessStreamStartV2.Rejected("Linux stream pre-start admission rejected: {status[1]}")

export LinuxProcessStreamStartV2, linux_process_stream_admit_v2
export linux_process_launch_stream_broker_v2, linux_process_stream_start_v2

@unsafe(reason: "immutable projection of the same genuinely collected cgroup receipt; no OS access", capabilities: [ffi])
extern fn rt_linux_group_collected_stream_v2(token: i64) -> [i64]
@unsafe(reason: "release inherited stream endpoints only when this broker has no live native group lease", capabilities: [ffi])
extern fn rt_linux_group_stream_release_inherited_v2() -> i64

fn linux_process_collected_stream_v2(lease: LinuxProcessLeaseV1) -> Result<LinuxProcessPollV1, text>:
    val fields = unsafe(capabilities: [ffi]): rt_linux_group_collected_stream_v2(lease.token)
    linux_process_poll_decode_v1(fields)

fn linux_process_stream_release_inherited_v2() -> Result<(), text>:
    val status = unsafe(capabilities: [ffi]): rt_linux_group_stream_release_inherited_v2()
    if status != 0: return Err("stream inherited descriptor release failed: {status}")
    Ok(())

export linux_process_collected_stream_v2, linux_process_stream_release_inherited_v2

@unsafe(reason: "recover only the actual exact-bound native stream lease, without allocating a result or guessing a token", capabilities: [ffi])
extern fn rt_linux_group_stream_recover_lease_v2(root: text, root_len: i64,
    identity: text, identity_len: i64) -> i64

fn linux_process_stream_recover_lease_v2(root: text, identity: text) -> LinuxProcessStreamStartV2:
    val token = unsafe(capabilities: [ffi]):
        rt_linux_group_stream_recover_lease_v2(root, str_len(root), identity, str_len(identity))
    if token > 0:
        val kind = linux_process_stream_no_child_scope_v2(root, identity)
        if kind == 1 or kind == 2:
            return LinuxProcessStreamStartV2.NoChildCleanupRequired(LinuxProcessLeaseV1(token), "recovered actual no-child scope cleanup")
        if kind < 0: return LinuxProcessStreamStartV2.Unknown("native stream scope classification unknown")
        return LinuxProcessStreamStartV2.CleanupRequired(LinuxProcessLeaseV1(token), "recovered actual native stream lease after uncertain receipt")
    if token == 0: return LinuxProcessStreamStartV2.Rejected("native stream start admitted no group")
    LinuxProcessStreamStartV2.Unknown("native stream ownership recovery remains uncertain")

export linux_process_stream_recover_lease_v2

@unsafe(reason: "classify exact native retained no-child scope, never reaped-leader evidence", capabilities: [ffi])
extern fn rt_linux_group_stream_no_child_scope_v2(root: text, root_len: i64, identity: text, identity_len: i64) -> i64
@unsafe(reason: "cleanup only an actual no-child cgroup after kernel-empty proof; no leader wait/reap", capabilities: [ffi])
extern fn rt_linux_group_stream_collect_no_child_v2(root: text, root_len: i64, identity: text, identity_len: i64) -> i64

fn linux_process_stream_no_child_scope_v2(root: text, identity: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_linux_group_stream_no_child_scope_v2(root, str_len(root), identity, str_len(identity))

fn linux_process_stream_collect_no_child_v2(root: text, identity: text) -> Result<(), text>:
    val status = unsafe(capabilities: [ffi]):
        rt_linux_group_stream_collect_no_child_v2(root, str_len(root), identity, str_len(identity))
    if status != 0: return Err("native no-child scope cleanup remains unproven: {status}")
    Ok(())

export linux_process_stream_no_child_scope_v2, linux_process_stream_collect_no_child_v2

# V3 adds exact resource and executable policy to the existing Linux owner.
# These are counted-text/typed-array OS leaves; there is no second registry.
@unsafe(reason: "verify approved target broker cgroup identity/caps and sibling CPU delegation before fork", capabilities: [ffi])
extern fn rt_linux_group_stream_admit_profiled_v3(delegated: text, delegated_len: i64,
    broker_path: text, broker_path_len: i64, policy: text, policy_len: i64, words: [i64]) -> i64
@unsafe(reason: "verify current broker membership and actual approved shared CPU/memory cap", capabilities: [ffi])
extern fn rt_linux_group_stream_verify_broker_profiled_v3(delegated: text, delegated_len: i64,
    broker_path: text, broker_path_len: i64, policy: text, policy_len: i64, words: [i64]) -> i64
@unsafe(reason: "existing detached broker enters approved shared cgroup at clone with exact ticket handoff", capabilities: [ffi])
extern fn rt_linux_group_launch_stream_broker_profiled_v3(program: text, program_len: i64,
    digest: text, digest_len: i64, args: [text], generation: i64, root: text,
    root_len: i64, identity: text, identity_len: i64, delegated: text, delegated_len: i64,
    launch_deadline_unix_ms: i64, broker_path: text, broker_path_len: i64,
    policy: text, policy_len: i64, words: [i64]) -> [i64]
@unsafe(reason: "acquire only a fresh owned parent with CPU and memory delegation, preserving typed cleanup receipt", capabilities: [ffi])
extern fn rt_linux_group_parent_acquire_profiled_at_v3(delegated: text, delegated_len: i64,
    root: text, root_len: i64, identity: text, identity_len: i64) -> [i64]
@unsafe(reason: "verify/write/readback child CPU cap before clone and apply explicit child image mode", capabilities: [ffi])
extern fn rt_linux_group_start_stream_profiled_v3(program: text, program_len: i64, digest: text,
    digest_len: i64, args: [text], environment: [text], directory: text, directory_len: i64,
    root: text, root_len: i64, identity: text, identity_len: i64,
    memory_limit_bytes: i64, timeout_ms: i64, launch_deadline_unix_ms: i64,
    broker_path: text, broker_path_len: i64, policy: text, policy_len: i64, words: [i64]) -> [i64]

fn _linux_process_stream_profile_words_v3(profile: GroupProcessStreamProfileV3) -> [i64]:
    val helper = profile.helper_cpu
    val broker = profile.broker
    val mode = if profile.child_image_mode == "sealed-main-image-v1": 0 else:
        if profile.child_image_mode == "trusted-local-admin-image-fd-v1": 1 else: -1
    [helper.cpu_millis, helper.quota_us, helper.period_us, broker.device, broker.inode,
        broker.generation, broker.cpu_quota_us, broker.cpu_period_us, broker.reserved_cpu_millis,
        broker.memory_limit_bytes, broker.reserved_memory_bytes, mode]

fn linux_process_stream_admit_profiled_v3(launch: GroupProcessStreamLaunchV2) -> Result<(), text>:
    val invalid = group_process_stream_launch_validate_profiled_v3(launch)
    if invalid != "": return Err(invalid)
    match launch.profile_v3:
        case None: linux_process_stream_admit_v2(launch.delegated_cgroup_path)
        case Some(profile):
            val broker = profile.broker
            val words = _linux_process_stream_profile_words_v3(profile)
            val status = unsafe(capabilities: [ffi]):
                rt_linux_group_stream_admit_profiled_v3(launch.delegated_cgroup_path, str_len(launch.delegated_cgroup_path),
                    broker.cgroup_path, str_len(broker.cgroup_path), broker.policy_digest, str_len(broker.policy_digest), words)
            if status != 0: return Err("profiled Linux stream admission failed: {status}")
            Ok(())

fn linux_process_stream_verify_broker_profiled_v3(launch: GroupProcessStreamLaunchV2) -> Result<(), text>:
    val invalid = group_process_stream_launch_validate_profiled_v3(launch)
    if invalid != "": return Err(invalid)
    match launch.profile_v3:
        case None: Ok(())
        case Some(profile):
            val broker = profile.broker
            val words = _linux_process_stream_profile_words_v3(profile)
            val status = unsafe(capabilities: [ffi]):
                rt_linux_group_stream_verify_broker_profiled_v3(launch.delegated_cgroup_path, str_len(launch.delegated_cgroup_path),
                    broker.cgroup_path, str_len(broker.cgroup_path), broker.policy_digest, str_len(broker.policy_digest), words)
            if status != 0: return Err("current broker resource placement differs from admitted policy: {status}")
            Ok(())

fn linux_process_launch_stream_broker_profiled_v3(launch: GroupProcessStreamLaunchV2,
        identity: text) -> Result<i64, text>:
    val invalid = group_process_stream_launch_validate_profiled_v3(launch)
    if invalid != "": return Err(invalid)
    if launch.transport_generation <= 0 or group_process_stream_identity_profiled_v3(launch) != identity:
        return Err("profiled broker launch identity differs")
    val request = launch.request
    val args = ["--broker-root", launch.root, "--request-digest", identity]
    match launch.profile_v3:
        case None:
            linux_process_launch_stream_broker_v2(request.broker_program, request.broker_digest,
                args, launch.transport_generation, launch.root, identity,
                launch.delegated_cgroup_path, request.launch_deadline_unix_ms)
        case Some(profile):
            val broker = profile.broker
            val words = _linux_process_stream_profile_words_v3(profile)
            val status = unsafe(capabilities: [ffi]):
                rt_linux_group_launch_stream_broker_profiled_v3(request.broker_program, str_len(request.broker_program),
                    request.broker_digest, str_len(request.broker_digest), args, launch.transport_generation,
                    launch.root, str_len(launch.root), identity, str_len(identity),
                    launch.delegated_cgroup_path, str_len(launch.delegated_cgroup_path), request.launch_deadline_unix_ms,
                    broker.cgroup_path, str_len(broker.cgroup_path), broker.policy_digest, str_len(broker.policy_digest), words)
            if status.len() != 2: return Err("profiled broker launch receipt unknown; cleanup required")
            if status[0] <= 0 or status[1] != 0: return Err("profiled broker launch unconfirmed; cleanup required: {status[1]}")
            Ok(status[0])

fn linux_cgroup_parent_admit_profiled_v3(launch: GroupProcessStreamLaunchV2,
        identity: text) -> LinuxCgroupParentAdmissionV1:
    val invalid = group_process_stream_launch_validate_profiled_v3(launch)
    if invalid != "": return LinuxCgroupParentAdmissionV1.Rejected(invalid)
    if launch.transport_generation <= 0 or group_process_stream_identity_profiled_v3(launch) != identity:
        return LinuxCgroupParentAdmissionV1.Rejected("profiled parent immutable identity differs")
    match launch.profile_v3:
        case None: linux_cgroup_parent_admit_at_v2(launch.delegated_cgroup_path, launch.root, identity)
        case Some(_profile):
            match linux_process_stream_verify_broker_profiled_v3(launch):
                case Err(reason): return LinuxCgroupParentAdmissionV1.Rejected(reason)
                case Ok(_): pass
            val fields = unsafe(capabilities: [ffi]):
                rt_linux_group_parent_acquire_profiled_at_v3(launch.delegated_cgroup_path, str_len(launch.delegated_cgroup_path),
                    launch.root, str_len(launch.root), identity, str_len(identity))
            linux_cgroup_parent_decode_at_v2(fields, launch.delegated_cgroup_path, identity)

export linux_process_stream_admit_profiled_v3, linux_process_stream_verify_broker_profiled_v3
export linux_process_launch_stream_broker_profiled_v3, linux_cgroup_parent_admit_profiled_v3
