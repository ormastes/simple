#!/usr/bin/env simple
# HTTP Client/Server SFFI Wrapper
#
# SFFI pattern for HTTP client and server functionality.
# Provides REST API client, HTTP server, and WebSocket support.
#
# Documentation:
# - reqwest (client): https://docs.rs/reqwest/
# - hyper (server): https://docs.rs/hyper/
# - tokio-tungstenite (websocket): https://docs.rs/tokio-tungstenite/

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

# --- HTTP Client ---

@unsafe(reason: "raw URL text and runtime-owned response tuple ABI; negative status denotes transport failure", capabilities: [ffi])
extern fn rt_http_get(url: text) -> (i64, text, text)  # (status, body, error)
@unsafe(reason: "raw URL/body/content-type text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_post(url: text, body: text, content_type: text) -> (i64, text, text)
@unsafe(reason: "raw URL/body/content-type text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_put(url: text, body: text, content_type: text) -> (i64, text, text)
@unsafe(reason: "raw URL text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_delete(url: text) -> (i64, text, text)
@unsafe(reason: "raw URL/body/content-type text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_patch(url: text, body: text, content_type: text) -> (i64, text, text)
@unsafe(reason: "raw URL text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_head(url: text) -> (i64, text, text)

# Advanced request with headers
@unsafe(reason: "raw method/URL/header-array/body ABI and runtime-owned response tuple", capabilities: [ffi])
extern fn rt_http_request(
    method: text,
    url: text,
    headers: [text],  # ["Key: Value", "Key2: Value2"]
    body: text
) -> (i64, text, text)

# Lossless v2 request. Raw response headers remain one CRLF-delimited text
# block so the boundary performs one allocation rather than one allocation per
# header; safe callers parse/lift it after transport success.
@unsafe(reason: "raw method/URL/header-array/binary-body ABI; contract: status -1 exclusively denotes typed transport or validation failure", capabilities: [ffi])
extern fn rt_http_request_v2(
    method: text,
    url: text,
    headers: [text],
    body: [u8],
    timeout_ms: i64
) -> (i64, text, text, [u8], text)

# Download file
@unsafe(reason: "raw URL/path text and runtime-owned status/byte-count/error tuple ABI", capabilities: [ffi])
extern fn rt_http_download(url: text, output_path: text) -> (i64, i64, text)  # (status, bytes, error)

# Upload file
@unsafe(reason: "raw URL/path/field text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_upload(url: text, file_path: text, field_name: text) -> (i64, text, text)

# --- HTTP Client Configuration ---

@unsafe(reason: "returns a generation-encoded client handle; zero is failure", capabilities: [ffi])
extern fn rt_http_client_create() -> i64
@unsafe(reason: "raw client handle ABI with bounded timeout policy", capabilities: [ffi])
extern fn rt_http_client_set_timeout(client: i64, timeout_ms: i64) -> bool
@unsafe(reason: "raw client handle and header text ABI", capabilities: [ffi])
extern fn rt_http_client_set_header(client: i64, key: text, value: text) -> bool
@unsafe(reason: "raw client handle plus method/URL/header-array/body ABI and runtime-owned response tuple", capabilities: [ffi])
extern fn rt_http_client_request(
    client: i64,
    method: text,
    url: text,
    headers: [text],
    body: text
) -> (i64, text, text)
@unsafe(reason: "invalidates a generation-encoded client handle", capabilities: [ffi])
extern fn rt_http_client_destroy(client: i64)

# --- HTTP Server ---

@unsafe(reason: "raw port ABI; zero is an invalid server handle", capabilities: [ffi])
extern fn rt_http_server_create(port: i64) -> i64
@unsafe(reason: "raw server handle and route/handler text ABI", capabilities: [ffi])
extern fn rt_http_server_route(server: i64, method: text, path: text, handler: text) -> bool
@unsafe(reason: "raw server handle and filesystem path text ABI", capabilities: [ffi])
extern fn rt_http_server_static(server: i64, path: text, dir: text) -> bool
@unsafe(reason: "raw server handle and process-network side effect ABI", capabilities: [ffi])
extern fn rt_http_server_start(server: i64) -> bool
@unsafe(reason: "raw server handle and process-network side effect ABI", capabilities: [ffi])
extern fn rt_http_server_stop(server: i64) -> bool
@unsafe(reason: "invalidates a raw server handle", capabilities: [ffi])
extern fn rt_http_server_destroy(server: i64)

# --- Request/Response Handling ---



# --- WebSocket (Optional) ---

@unsafe(reason: "raw URL text ABI; zero is an invalid WebSocket handle", capabilities: [ffi])
extern fn rt_ws_connect(url: text) -> i64
@unsafe(reason: "raw WebSocket handle and message text ABI", capabilities: [ffi])
extern fn rt_ws_send(ws: i64, message: text) -> bool
@unsafe(reason: "raw WebSocket handle and runtime-owned text ABI; empty text is ambiguous", capabilities: [ffi])
extern fn rt_ws_receive(ws: i64) -> text
@unsafe(reason: "consumes a raw WebSocket handle with boolean status", capabilities: [ffi])
extern fn rt_ws_close(ws: i64) -> bool

# --- Utilities ---

@unsafe(reason: "raw input and runtime-owned encoded text ABI", capabilities: [ffi])
extern fn rt_http_url_encode(text: text) -> text
@unsafe(reason: "raw input and runtime-owned decoded text ABI; malformed input is ambiguous", capabilities: [ffi])
extern fn rt_http_url_decode(text: text) -> text

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

# --- Core Types ---

enum SffiHttpMethod:
    GET
    POST
    PUT
    DELETE
    PATCH
    HEAD
    OPTIONS

fn method_to_string(method: SffiHttpMethod) -> text:
    if method == SffiHttpMethod.GET: "GET"
    elif method == SffiHttpMethod.POST: "POST"
    elif method == SffiHttpMethod.PUT: "PUT"
    elif method == SffiHttpMethod.DELETE: "DELETE"
    elif method == SffiHttpMethod.PATCH: "PATCH"
    elif method == SffiHttpMethod.HEAD: "HEAD"
    elif method == SffiHttpMethod.OPTIONS: "OPTIONS"
    else: "GET"

enum SffiHttpStatus:
    OK                  # 200
    Created             # 201
    Accepted            # 202
    NoContent           # 204
    BadRequest          # 400
    Unauthorized        # 401
    Forbidden           # 403
    NotFound            # 404
    MethodNotAllowed    # 405
    InternalError       # 500
    BadGateway          # 502
    ServiceUnavailable  # 503
    Unknown

fn status_to_code(status: SffiHttpStatus) -> i64:
    if status == SffiHttpStatus.OK: 200
    elif status == SffiHttpStatus.Created: 201
    elif status == SffiHttpStatus.Accepted: 202
    elif status == SffiHttpStatus.NoContent: 204
    elif status == SffiHttpStatus.BadRequest: 400
    elif status == SffiHttpStatus.Unauthorized: 401
    elif status == SffiHttpStatus.Forbidden: 403
    elif status == SffiHttpStatus.NotFound: 404
    elif status == SffiHttpStatus.MethodNotAllowed: 405
    elif status == SffiHttpStatus.InternalError: 500
    elif status == SffiHttpStatus.BadGateway: 502
    elif status == SffiHttpStatus.ServiceUnavailable: 503
    else: 0

fn code_to_status(code: i64) -> SffiHttpStatus:
    if code == 200: SffiHttpStatus.OK
    elif code == 201: SffiHttpStatus.Created
    elif code == 202: SffiHttpStatus.Accepted
    elif code == 204: SffiHttpStatus.NoContent
    elif code == 400: SffiHttpStatus.BadRequest
    elif code == 401: SffiHttpStatus.Unauthorized
    elif code == 403: SffiHttpStatus.Forbidden
    elif code == 404: SffiHttpStatus.NotFound
    elif code == 405: SffiHttpStatus.MethodNotAllowed
    elif code == 500: SffiHttpStatus.InternalError
    elif code == 502: SffiHttpStatus.BadGateway
    elif code == 503: SffiHttpStatus.ServiceUnavailable
    else: SffiHttpStatus.Unknown

struct SffiHttpResponse:
    status_code: i64
    status: SffiHttpStatus
    body: text
    error: text
    is_ok: bool

fn make_http_response(result: (i64, text, text)) -> SffiHttpResponse:
    """
    Helper to construct SffiHttpResponse from rt_http_* result tuple.

    Common pattern: All rt_http_* functions return (status_code, body, error).
    This helper eliminates 6-line duplication across all HTTP wrapper functions.
    """
    val status_code = result.0
    val body = result.1
    val error = result.2

    SffiHttpResponse(
        status_code: status_code,
        status: code_to_status(status_code),
        body: body,
        error: error,
        is_ok: status_code >= 200 and status_code < 300
    )

fn http_request_raw(method: text, url: text, headers_text: text, body: text) -> (i64, text, text):
    """Perform an HTTP request with newline-delimited headers and return the raw runtime tuple."""
    var headers: [text] = []
    if headers_text != "":
        headers = headers_text.split("\n")
    unsafe(capabilities: [ffi]):
        rt_http_request(method, url, headers, body)

fn http_request_v2_raw(method: text, url: text, headers: [text], body: [u8],
                       timeout_ms: i64) -> (i64, text, text, [u8], text):
    """Lossless raw request tuple; callers must lift status/error and parse headers."""
    if timeout_ms < 0:
        return (-1, "", "", [], "HTTP timeout cannot be negative")
    unsafe(capabilities: [ffi]):
        rt_http_request_v2(method, url, headers, body, timeout_ms)

struct HttpClient:
    handle: i64
    is_valid: bool

struct HttpServer:
    handle: i64
    port: i64
    is_valid: bool

struct WebSocket:
    handle: i64
    is_valid: bool

# --- HTTP Client Functions ---

fn http_get(url: text) -> SffiHttpResponse:
    """
    Perform HTTP GET request.

    Example:
        val response = http_get("https://api.example.com/users")
        if response.is_ok:
            print response.body
    """
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_get(url))

# reason: positional io http_sffi API
fn http_post(url: text, body: text) -> SffiHttpResponse:
    """
    Perform HTTP POST request with JSON body.

    Example:
        val json = '{"name": "Alice", "age": 30}'
        val response = http_post("https://api.example.com/users", json)
    """
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_post(url, body, "application/json"))

# reason: positional io http_sffi API
fn http_post_form(url: text, body: text) -> SffiHttpResponse:
    """
    Perform HTTP POST request with form data.

    Example:
        val form = "name=Alice&age=30"
        val response = http_post_form("https://api.example.com/submit", form)
    """
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_post(url, body, "application/x-www-form-urlencoded"))

# reason: positional io http_sffi API
fn http_put(url: text, body: text) -> SffiHttpResponse:
    """Perform HTTP PUT request."""
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_put(url, body, "application/json"))

fn http_delete(url: text) -> SffiHttpResponse:
    """Perform HTTP DELETE request."""
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_delete(url))

# reason: positional io http_sffi API
fn http_patch(url: text, body: text) -> SffiHttpResponse:
    """Perform HTTP PATCH request."""
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_patch(url, body, "application/json"))

fn http_head(url: text) -> SffiHttpResponse:
    """Perform HTTP HEAD request (headers only)."""
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_head(url))

# reason: positional io http_sffi API
fn http_request(method: SffiHttpMethod, url: text, headers: [text], body: text) -> SffiHttpResponse:
    """
    Perform HTTP request with custom method and headers.

    Example:
        val headers = ["Authorization: Bearer token123", "Accept: application/json"]
        val response = http_request(SffiHttpMethod.POST, "https://api.example.com/data", headers, body)
    """
    val method_str = method_to_string(method)
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_request(method_str, url, headers, body))

# reason: positional io http_sffi API
fn http_download(url: text, output_path: text) -> SffiHttpResponse:
    """
    Download file from URL to local path.

    Example:
        val response = http_download("https://example.com/file.zip", "/tmp/file.zip")
        if response.is_ok:
            print "Downloaded {response.status_code} bytes"
    """
    val result = unsafe(capabilities: [ffi]):
        rt_http_download(url, output_path)
    val status_code = result.0
    val bytes = result.1
    val error = result.2

    SffiHttpResponse(
        status_code: status_code,
        status: code_to_status(status_code),
        body: "{bytes}",
        error: error,
        is_ok: status_code >= 200 and status_code < 300
    )

# reason: positional io http_sffi API
fn http_upload(url: text, file_path: text, field_name: text) -> SffiHttpResponse:
    """
    Upload file via multipart/form-data.

    Example:
        val response = http_upload("https://api.example.com/upload", "/tmp/image.jpg", "file")
    """
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_upload(url, file_path, field_name))

# --- HTTP Client with Configuration ---

fn http_client_new() -> HttpClient:
    """
    Create a new HTTP client with custom configuration.
    Allows setting timeouts, default headers, etc.
    """
    val handle = unsafe(capabilities: [ffi]):
        rt_http_client_create()
    HttpClient(handle: handle, is_valid: handle > 0)

fn http_client_set_timeout(client: HttpClient, timeout_ms: i64) -> bool:
    """Set request timeout in milliseconds."""
    if not client.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_client_set_timeout(client.handle, timeout_ms)

# reason: positional io http_sffi API
fn http_client_set_header(client: HttpClient, key: text, value: text) -> bool:
    """Set default header for all requests."""
    if not client.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_client_set_header(client.handle, key, value)

# reason: positional io http_sffi API
fn http_client_request(client: HttpClient, method: SffiHttpMethod, url: text, headers: [text], body: text) -> SffiHttpResponse:
    """Perform request using configured client."""
    if not client.is_valid:
        SffiHttpResponse(
            status_code: 0,
            status: SffiHttpStatus.Unknown,
            body: "",
            error: "Invalid HTTP client",
            is_ok: false
        )
    else:
        val method_str = method_to_string(method)
        unsafe(capabilities: [ffi]):
            make_http_response(rt_http_client_request(client.handle, method_str, url, headers, body))

fn http_client_destroy(client: HttpClient):
    """Release HTTP client resources."""
    if client.is_valid:
        unsafe(capabilities: [ffi]):
            rt_http_client_destroy(client.handle)

# --- HTTP Server Functions ---

fn http_server_new(port: i64) -> HttpServer:
    """
    Create HTTP server on specified port.

    Example:
        val server = http_server_new(8080)
        http_server_route(server, "GET", "/", "handle_index")
        http_server_start(server)
    """
    val handle = unsafe(capabilities: [ffi]):
        rt_http_server_create(port)
    HttpServer(handle: handle, port: port, is_valid: handle > 0)

# reason: positional io http_sffi API
fn http_server_route(server: HttpServer, method: text, path: text, handler: text) -> bool:
    """
    Register route handler.
    Handler is a function name that will be called with (request, response).
    """
    if not server.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_server_route(server.handle, method, path, handler)

# reason: positional io http_sffi API
fn http_server_static(server: HttpServer, path: text, dir: text) -> bool:
    """
    Serve static files from directory.

    Example:
        http_server_static(server, "/static", "./public")
    """
    if not server.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_server_static(server.handle, path, dir)

fn http_server_start(server: HttpServer) -> bool:
    """Start HTTP server (blocking)."""
    if not server.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_server_start(server.handle)

fn http_server_stop(server: HttpServer) -> bool:
    """Stop HTTP server."""
    if server.is_valid:
        unsafe(capabilities: [ffi]):
            rt_http_server_stop(server.handle)
    else:
        true

fn http_server_destroy(server: HttpServer):
    """Release server resources."""
    if server.is_valid:
        unsafe(capabilities: [ffi]):
            rt_http_server_destroy(server.handle)

# --- WebSocket Functions ---

fn ws_connect(url: text) -> WebSocket:
    """Connect to WebSocket server."""
    val handle = unsafe(capabilities: [ffi]):
        rt_ws_connect(url)
    WebSocket(handle: handle, is_valid: handle > 0)

fn ws_send(ws: WebSocket, message: text) -> bool:
    """Send message over WebSocket."""
    if not ws.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_ws_send(ws.handle, message)

fn ws_send_handle(handle: i64, message: text) -> bool:
    """Send message over an existing raw WebSocket runtime handle."""
    if handle <= 0:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_ws_send(handle, message)

fn ws_receive(ws: WebSocket) -> text:
    """Receive message from WebSocket (blocking)."""
    if not ws.is_valid:
        ""
    else:
        unsafe(capabilities: [ffi]):
            rt_ws_receive(ws.handle)

fn ws_close(ws: WebSocket) -> bool:
    """Close WebSocket connection."""
    if ws.is_valid:
        unsafe(capabilities: [ffi]):
            rt_ws_close(ws.handle)
    else:
        true

# --- Utility Functions ---

fn url_encode(text: text) -> text:
    """URL-encode string (e.g., 'hello world' -> 'hello%20world')."""
    unsafe(capabilities: [ffi]):
        rt_http_url_encode(text)

fn url_decode(text: text) -> text:
    """URL-decode string."""
    unsafe(capabilities: [ffi]):
        rt_http_url_decode(text)

# --- Higher-Level Helpers ---

fn http_get_json(url: text) -> SffiHttpResponse:
    """GET request expecting JSON response."""
    val headers = ["Accept: application/json"]
    http_request(SffiHttpMethod.GET, url, headers, "")

# reason: positional io http_sffi API
fn http_post_json(url: text, json: text) -> SffiHttpResponse:
    """POST request with JSON body."""
    val headers = ["Content-Type: application/json"]
    http_request(SffiHttpMethod.POST, url, headers, json)

fn http_is_success(response: SffiHttpResponse) -> bool:
    """Check if response is successful (2xx)."""
    response.status_code >= 200 and response.status_code < 300

fn http_is_redirect(response: SffiHttpResponse) -> bool:
    """Check if response is redirect (3xx)."""
    response.status_code >= 300 and response.status_code < 400

fn http_is_client_error(response: SffiHttpResponse) -> bool:
    """Check if response is client error (4xx)."""
    response.status_code >= 400 and response.status_code < 500

fn http_is_server_error(response: SffiHttpResponse) -> bool:
    """Check if response is server error (5xx)."""
    response.status_code >= 500 and response.status_code < 600

# ============================================================================
# Exports
# ============================================================================

export SffiHttpResponse, HttpClient, HttpServer, WebSocket
export rt_http_get, rt_http_request, rt_http_request_v2, rt_http_download
export http_request_raw, http_request_v2_raw, http_get
