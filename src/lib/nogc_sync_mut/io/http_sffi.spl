#!/usr/bin/env simple
# HTTP Client/Server SFFI Wrapper
#
# SFFI pattern for HTTP client and server functionality.
# Provides REST API client, HTTP server, and WebSocket support.
#
# Documentation:
# - reqwest (client): https://docs.rs/reqwest/
# - hyper (server): https://docs.rs/hyper/
# - tokio-tungstenite (websocket): https://docs.rs/tokio-tungstenite/

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

# --- HTTP Client ---

export use std.nogc_sync_mut.io.http_client_types.{HttpMethod, HttpStatus, HttpResponse, method_to_string, status_to_code, code_to_status, make_http_response}
export use std.nogc_sync_mut.io.http_client_core.{rt_http_request, rt_http_request_v2, rt_http_download, http_request_raw, http_request_v2_raw, http_get, http_post, http_post_form, http_put, http_delete, http_patch, http_head, http_request, http_download, http_get_json, http_post_json, http_is_success, http_is_redirect, http_is_client_error, http_is_server_error, url_encode, url_decode}


export use std.nogc_sync_mut.io.http_get_core.{rt_http_get}
@unsafe(reason: "raw URL/body/content-type text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_post(url: text, body: text, content_type: text) -> (i64, text, text)
@unsafe(reason: "raw URL/body/content-type text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_put(url: text, body: text, content_type: text) -> (i64, text, text)
@unsafe(reason: "raw URL text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_delete(url: text) -> (i64, text, text)
@unsafe(reason: "raw URL/body/content-type text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_patch(url: text, body: text, content_type: text) -> (i64, text, text)
@unsafe(reason: "raw URL text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_head(url: text) -> (i64, text, text)

# Upload file
@unsafe(reason: "raw URL/path/field text and runtime-owned response tuple ABI", capabilities: [ffi])
extern fn rt_http_upload(url: text, file_path: text, field_name: text) -> (i64, text, text)

export use std.nogc_sync_mut.io.http_client_handles.{HttpClient, rt_http_client_create, rt_http_client_set_timeout, rt_http_client_set_header, rt_http_client_request, rt_http_client_destroy, http_client_new, http_client_set_timeout, http_client_set_header, http_client_request, http_client_destroy}

# --- HTTP Server ---

@unsafe(reason: "raw port ABI; zero is an invalid server handle", capabilities: [ffi])
extern fn rt_http_server_create(port: i64) -> i64
@unsafe(reason: "raw server handle and route/handler text ABI", capabilities: [ffi])
extern fn rt_http_server_route(server: i64, method: text, path: text, handler: text) -> bool
@unsafe(reason: "raw server handle and filesystem path text ABI", capabilities: [ffi])
extern fn rt_http_server_static(server: i64, path: text, dir: text) -> bool
@unsafe(reason: "raw server handle and process-network side effect ABI", capabilities: [ffi])
extern fn rt_http_server_start(server: i64) -> bool
@unsafe(reason: "raw server handle and process-network side effect ABI", capabilities: [ffi])
extern fn rt_http_server_stop(server: i64) -> bool
@unsafe(reason: "invalidates a raw server handle", capabilities: [ffi])
extern fn rt_http_server_destroy(server: i64)

# --- Request/Response Handling ---



# --- WebSocket (Optional) ---

@unsafe(reason: "raw URL text ABI; zero is an invalid WebSocket handle", capabilities: [ffi])
extern fn rt_ws_connect(url: text) -> i64
@unsafe(reason: "raw WebSocket handle and message text ABI", capabilities: [ffi])
extern fn rt_ws_send(ws: i64, message: text) -> bool
@unsafe(reason: "raw WebSocket handle and runtime-owned text ABI; empty text is ambiguous", capabilities: [ffi])
extern fn rt_ws_receive(ws: i64) -> text
@unsafe(reason: "consumes a raw WebSocket handle with boolean status", capabilities: [ffi])
extern fn rt_ws_close(ws: i64) -> bool

# --- Utilities ---

@unsafe(reason: "raw input and runtime-owned encoded text ABI", capabilities: [ffi])
extern fn rt_http_url_encode(text: text) -> text
@unsafe(reason: "raw input and runtime-owned decoded text ABI; malformed input is ambiguous", capabilities: [ffi])
extern fn rt_http_url_decode(text: text) -> text

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

# --- Core Types ---

struct HttpServer:
    handle: i64
    port: i64
    is_valid: bool

struct WebSocket:
    handle: i64
    is_valid: bool

# --- HTTP Client Functions ---

# reason: positional io http_sffi API
# reason: positional io http_sffi API
# reason: positional io http_sffi API
# reason: positional io http_sffi API
# reason: positional io http_sffi API
# reason: positional io http_sffi API
# reason: positional io http_sffi API
fn http_upload(url: text, file_path: text, field_name: text) -> HttpResponse:
    """
    Upload file via multipart/form-data.

    Example:
        val response = http_upload("https://api.example.com/upload", "/tmp/image.jpg", "file")
    """
    unsafe(capabilities: [ffi]):
        make_http_response(rt_http_upload(url, file_path, field_name))

# --- HTTP Server Functions ---

fn http_server_new(port: i64) -> HttpServer:
    """
    Create HTTP server on specified port.

    Example:
        val server = http_server_new(8080)
        http_server_route(server, "GET", "/", "handle_index")
        http_server_start(server)
    """
    val handle = unsafe(capabilities: [ffi]):
        rt_http_server_create(port)
    HttpServer(handle: handle, port: port, is_valid: handle > 0)

# reason: positional io http_sffi API
fn http_server_route(server: HttpServer, method: text, path: text, handler: text) -> bool:
    """
    Register route handler.
    Handler is a function name that will be called with (request, response).
    """
    if not server.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_server_route(server.handle, method, path, handler)

# reason: positional io http_sffi API
fn http_server_static(server: HttpServer, path: text, dir: text) -> bool:
    """
    Serve static files from directory.

    Example:
        http_server_static(server, "/static", "./public")
    """
    if not server.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_server_static(server.handle, path, dir)

fn http_server_start(server: HttpServer) -> bool:
    """Start HTTP server (blocking)."""
    if not server.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_http_server_start(server.handle)

fn http_server_stop(server: HttpServer) -> bool:
    """Stop HTTP server."""
    if server.is_valid:
        unsafe(capabilities: [ffi]):
            rt_http_server_stop(server.handle)
    else:
        true

fn http_server_destroy(server: HttpServer):
    """Release server resources."""
    if server.is_valid:
        unsafe(capabilities: [ffi]):
            rt_http_server_destroy(server.handle)

# --- WebSocket Functions ---

fn ws_connect(url: text) -> WebSocket:
    """Connect to WebSocket server."""
    val handle = unsafe(capabilities: [ffi]):
        rt_ws_connect(url)
    WebSocket(handle: handle, is_valid: handle > 0)

fn ws_send(ws: WebSocket, message: text) -> bool:
    """Send message over WebSocket."""
    if not ws.is_valid:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_ws_send(ws.handle, message)

fn ws_send_handle(handle: i64, message: text) -> bool:
    """Send message over an existing raw WebSocket runtime handle."""
    if handle <= 0:
        false
    else:
        unsafe(capabilities: [ffi]):
            rt_ws_send(handle, message)

fn ws_receive(ws: WebSocket) -> text:
    """Receive message from WebSocket (blocking)."""
    if not ws.is_valid:
        ""
    else:
        unsafe(capabilities: [ffi]):
            rt_ws_receive(ws.handle)

fn ws_close(ws: WebSocket) -> bool:
    """Close WebSocket connection."""
    if ws.is_valid:
        unsafe(capabilities: [ffi]):
            rt_ws_close(ws.handle)
    else:
        true

# --- Utility Functions ---

# --- Higher-Level Helpers ---

# reason: positional io http_sffi API
# ============================================================================
# Exports
# ============================================================================

export HttpMethod, HttpResponse, HttpStatus, HttpClient, HttpServer, WebSocket
export rt_http_get, rt_http_request, rt_http_request_v2, rt_http_download
export http_request_raw, http_request_v2_raw, http_get
