# Versioned interactive process facade. The native owner validates every operation.

pub enum InteractiveStatusV1:
    Ok
    Pending
    Busy
    DeadlineReached
    Conflict
    RejectedBeforeStart
    Stale
    Unsupported
    NativeFailure
    NotReady
    RetainedCleanup
    ProjectionFailure
    InvalidArgument

fn _decode_InteractiveStatusV1(word: i64) -> Result<InteractiveStatusV1, text>:
    match word:
        0: Ok(InteractiveStatusV1.Ok)
        1: Ok(InteractiveStatusV1.Pending)
        2: Ok(InteractiveStatusV1.Busy)
        3: Ok(InteractiveStatusV1.DeadlineReached)
        4: Ok(InteractiveStatusV1.Conflict)
        5: Ok(InteractiveStatusV1.RejectedBeforeStart)
        6: Ok(InteractiveStatusV1.Stale)
        7: Ok(InteractiveStatusV1.Unsupported)
        8: Ok(InteractiveStatusV1.NativeFailure)
        9: Ok(InteractiveStatusV1.NotReady)
        10: Ok(InteractiveStatusV1.RetainedCleanup)
        11: Ok(InteractiveStatusV1.ProjectionFailure)
        12: Ok(InteractiveStatusV1.InvalidArgument)
        _: Err("interactive receipt contains an unknown InteractiveStatusV1")

pub enum InteractivePhaseV1:
    NoOwner
    Starting
    Running
    Stopping
    Terminal
    Collecting
    Collected
    Released
    FailedHeld

fn _decode_InteractivePhaseV1(word: i64) -> Result<InteractivePhaseV1, text>:
    match word:
        0: Ok(InteractivePhaseV1.NoOwner)
        1: Ok(InteractivePhaseV1.Starting)
        2: Ok(InteractivePhaseV1.Running)
        3: Ok(InteractivePhaseV1.Stopping)
        4: Ok(InteractivePhaseV1.Terminal)
        5: Ok(InteractivePhaseV1.Collecting)
        6: Ok(InteractivePhaseV1.Collected)
        7: Ok(InteractivePhaseV1.Released)
        8: Ok(InteractivePhaseV1.FailedHeld)
        _: Err("interactive receipt contains an unknown InteractivePhaseV1")

pub enum InteractiveStreamV1:
    PendingCreation
    Open
    Eof
    Failed
    NotCreated
    FinishRequested

fn _decode_InteractiveStreamV1(word: i64) -> Result<InteractiveStreamV1, text>:
    match word:
        0: Ok(InteractiveStreamV1.PendingCreation)
        1: Ok(InteractiveStreamV1.Open)
        2: Ok(InteractiveStreamV1.Eof)
        3: Ok(InteractiveStreamV1.Failed)
        4: Ok(InteractiveStreamV1.NotCreated)
        5: Ok(InteractiveStreamV1.FinishRequested)
        _: Err("interactive receipt contains an unknown InteractiveStreamV1")

pub enum InteractiveExitV1:
    Pending
    Exited
    Signalled
    Failed

fn _decode_InteractiveExitV1(word: i64) -> Result<InteractiveExitV1, text>:
    match word:
        0: Ok(InteractiveExitV1.Pending)
        1: Ok(InteractiveExitV1.Exited)
        2: Ok(InteractiveExitV1.Signalled)
        3: Ok(InteractiveExitV1.Failed)
        _: Err("interactive receipt contains an unknown InteractiveExitV1")

pub struct InteractiveDeadlineV1:
    clock_tag: i64
    expires_ms: i64

pub struct InteractiveReceiptV1:
    status: InteractiveStatusV1
    validity_mask: i64
    phase: InteractivePhaseV1
    stdin_state: InteractiveStreamV1
    stdout_state: InteractiveStreamV1
    stderr_state: InteractiveStreamV1
    exit_kind: InteractiveExitV1
    exit_value: i64
    error_domain: i64
    error_code: i64
    accepted_delta: i64
    accepted_total: i64
    written_total: i64
    stdin_queued: i64
    stdout_seen_total: i64
    stderr_seen_total: i64
    stdout_delivered_total: i64
    stderr_delivered_total: i64
    stdout_count: i64
    stderr_count: i64
    stdout_discarded_total: i64
    stderr_discarded_total: i64
    flags: i64
    operation_sequence: i64

impl InteractiveReceiptV1:
    pub fn owner_valid() -> bool:
        (self.validity_mask & 1) == 1

    pub fn phase_valid() -> bool:
        (self.validity_mask & 2) == 2

    pub fn input_valid() -> bool:
        (self.validity_mask & 4) == 4

    pub fn streams_valid() -> bool:
        (self.validity_mask & 8) == 8

    pub fn exit_valid() -> bool:
        (self.validity_mask & 16) == 16

    pub fn counts_valid() -> bool:
        (self.validity_mask & 64) == 64

    pub fn observed_before_wait() -> bool:
        (self.flags & 32768) == 32768

    pub fn maintenance_deferred() -> bool:
        (self.flags & 8) == 8

pub struct InteractivePollV1:
    stdout: [u8]
    stderr: [u8]
    receipt: InteractiveReceiptV1

pub struct InteractiveStartOutcomeV1:
    status: InteractiveStatusV1
    receipt: InteractiveReceiptV1
    lease: InteractiveProcessLeaseV1?

pub struct InteractiveCapabilitiesV1:
    status: InteractiveStatusV1
    capability_mask: i64
    max_leases: i64
    stdin_capacity_max: i64
    stdout_capacity_max: i64
    stderr_capacity_max: i64
    write_quantum: i64
    output_chunk_max: i64
    poll_wait_max: i64
    segment_max: i64
    clock_tag: i64
    error_domain: i64
    error_code: i64

impl InteractiveCapabilitiesV1:
    pub fn supported() -> bool:
        self.status == InteractiveStatusV1.Ok and (self.capability_mask & 4095) == 4095

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_capabilities_value() -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_deadline_value(timeout_ms: i64) -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_start_value(command: text, args: [text], clock_tag: i64, expires_ms: i64, stdin_capacity: i64, stdout_capacity: i64, stderr_capacity: i64) -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_write_some_value(handle: i64, bytes: [u8], data_offset: i64, max_bytes: i64, expected_accepted_total: i64, clock_tag: i64, expires_ms: i64) -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_poll_value(handle: i64, clock_tag: i64, expires_ms: i64, wait_ms: i64, stdout_max: i64, stderr_max: i64) -> ([u8], [u8], [i64])

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_close_stdin_value(handle: i64, clock_tag: i64, expires_ms: i64) -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_cancel_value(handle: i64, clock_tag: i64, expires_ms: i64) -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_collect_value(handle: i64, clock_tag: i64, expires_ms: i64, discard_unread: bool) -> [i64]

@unsafe(reason: "versioned same-owner process receipt; raw tickets remain inside the value bridge", capabilities: [ffi])
extern fn rt_process_owned_interactive_v1_release_value(handle: i64) -> [i64]

fn _interactive_words(words: [i64], count: i64, size: i64) -> Result<[i64], text>:
    if words.len() != count or words[0] != 1 or words[1] != size:
        return Err("interactive process ABI version or size mismatch")
    Ok(words)

fn _interactive_receipt(raw: [i64]) -> Result<InteractiveReceiptV1, text>:
    val w = _interactive_words(raw, 32, 256)?
    if w[3] < 0 or w[3] > 255 or w[27] != 0 or w[28] != 0 or w[29] != 0 or w[30] != 0 or w[31] != 0:
        return Err("interactive receipt contains invalid validity bits or leaked raw ticket")
    Ok(InteractiveReceiptV1(
        status: _decode_InteractiveStatusV1(w[2])?,
        validity_mask: w[3],
        phase: _decode_InteractivePhaseV1(w[5])?,
        stdin_state: _decode_InteractiveStreamV1(w[6])?,
        stdout_state: _decode_InteractiveStreamV1(w[7])?,
        stderr_state: _decode_InteractiveStreamV1(w[8])?,
        exit_kind: _decode_InteractiveExitV1(w[9])?,
        exit_value: w[10],
        error_domain: w[11],
        error_code: w[12],
        accepted_delta: w[13],
        accepted_total: w[14],
        written_total: w[15],
        stdin_queued: w[16],
        stdout_seen_total: w[17],
        stderr_seen_total: w[18],
        stdout_delivered_total: w[19],
        stderr_delivered_total: w[20],
        stdout_count: w[21],
        stderr_count: w[22],
        stdout_discarded_total: w[23],
        stderr_discarded_total: w[24],
        flags: w[25],
        operation_sequence: w[26]))

pub fn process_interactive_capabilities_v1() -> Result<InteractiveCapabilitiesV1, text>:
    val raw = unsafe(capabilities: [ffi]): rt_process_owned_interactive_v1_capabilities_value()
    val w = _interactive_words(raw, 16, 128)?
    if w[15] != 0:
        return Err("interactive capabilities reserved field is nonzero")
    Ok(InteractiveCapabilitiesV1(
        status: _decode_InteractiveStatusV1(w[2])?,
        capability_mask: w[3],
        max_leases: w[4],
        stdin_capacity_max: w[5],
        stdout_capacity_max: w[6],
        stderr_capacity_max: w[7],
        write_quantum: w[8],
        output_chunk_max: w[9],
        poll_wait_max: w[10],
        segment_max: w[11],
        clock_tag: w[12],
        error_domain: w[13],
        error_code: w[14]))

pub fn process_interactive_deadline_v1(timeout_ms: i64) -> Result<InteractiveDeadlineV1, text>:
    if timeout_ms < 0 or timeout_ms > 600000:
        return Err("interactive timeout is outside 0..600000 milliseconds")
    val w = unsafe(capabilities: [ffi]): rt_process_owned_interactive_v1_deadline_value(timeout_ms)
    if w.len() != 8 or w[0] != 1 or w[1] != 32 or w[4] != 0 or w[7] != 0 or w[2] <= 0 or w[3] < 0:
        return Err("interactive owner clock unavailable or malformed deadline")
    Ok(InteractiveDeadlineV1(clock_tag: w[2], expires_ms: w[3]))

pub fn process_interactive_start_v1(command: text, args: [text], deadline: InteractiveDeadlineV1, stdin_capacity: i64, stdout_capacity: i64, stderr_capacity: i64) -> Result<InteractiveStartOutcomeV1, text>:
    val capabilities = process_interactive_capabilities_v1()?
    if not capabilities.supported():
        return Err("interactive process owner capabilities are unavailable on this target")
    val raw = unsafe(capabilities: [ffi]):
        rt_process_owned_interactive_v1_start_value(command, args, deadline.clock_tag, deadline.expires_ms, stdin_capacity, stdout_capacity, stderr_capacity)
    val receipt = _interactive_receipt(raw)?
    if receipt.owner_valid():
        if raw[4] <= 0:
            return Err("interactive start validated an invalid native lease")
        val lease = InteractiveProcessLeaseV1(handle: raw[4], released: false)
        return Ok(InteractiveStartOutcomeV1(status: receipt.status, receipt: receipt, lease: Some(lease)))
    Ok(InteractiveStartOutcomeV1(status: receipt.status, receipt: receipt, lease: nil))

pub class InteractiveProcessLeaseV1:
    handle: i64
    var released: bool

    pub me fn write_some(bytes: [u8], data_offset: i64, max_bytes: i64, expected_accepted_total: i64, deadline: InteractiveDeadlineV1) -> Result<InteractiveReceiptV1, text>:
        val raw = unsafe(capabilities: [ffi]):
            rt_process_owned_interactive_v1_write_some_value(self.handle, bytes, data_offset, max_bytes, expected_accepted_total, deadline.clock_tag, deadline.expires_ms)
        _interactive_receipt(raw)

    pub me fn poll(deadline: InteractiveDeadlineV1, wait_ms: i64, stdout_max: i64, stderr_max: i64) -> Result<InteractivePollV1, text>:
        val (stdout, stderr, raw) = unsafe(capabilities: [ffi]):
            rt_process_owned_interactive_v1_poll_value(self.handle, deadline.clock_tag, deadline.expires_ms, wait_ms, stdout_max, stderr_max)
        val receipt = _interactive_receipt(raw)?
        if stdout.len() != receipt.stdout_count or stderr.len() != receipt.stderr_count:
            return Err("interactive raw byte counts do not match receipt")
        Ok(InteractivePollV1(stdout: stdout, stderr: stderr, receipt: receipt))

    pub me fn close_stdin(deadline: InteractiveDeadlineV1) -> Result<InteractiveReceiptV1, text>:
        val raw = unsafe(capabilities: [ffi]):
            rt_process_owned_interactive_v1_close_stdin_value(self.handle, deadline.clock_tag, deadline.expires_ms)
        _interactive_receipt(raw)

    pub me fn cancel(deadline: InteractiveDeadlineV1) -> Result<InteractiveReceiptV1, text>:
        val raw = unsafe(capabilities: [ffi]):
            rt_process_owned_interactive_v1_cancel_value(self.handle, deadline.clock_tag, deadline.expires_ms)
        _interactive_receipt(raw)

    pub me fn collect(deadline: InteractiveDeadlineV1, discard_unread: bool = false) -> Result<InteractiveReceiptV1, text>:
        val raw = unsafe(capabilities: [ffi]):
            rt_process_owned_interactive_v1_collect_value(self.handle, deadline.clock_tag, deadline.expires_ms, discard_unread)
        _interactive_receipt(raw)

    pub me fn release() -> Result<InteractiveReceiptV1, text>:
        # Even a local released copy must use native generation validation.
        val raw = unsafe(capabilities: [ffi]): rt_process_owned_interactive_v1_release_value(self.handle)
        val receipt = _interactive_receipt(raw)?
        if receipt.phase_valid() and receipt.phase == InteractivePhaseV1.Released:
            self.released = true
        Ok(receipt)
