use std.nogc_sync_mut.sffi.fs.{io_file_write, io_file_write_all}
use std.nogc_sync_mut.io.file_bytes.{file_read_borrowed_bytes}
use std.nogc_sync_mut.io.text_session.{TextSessionCodec}
use std.nogc_sync_mut.io.file_text_session.{FileTextSession, file_default_text_codec, file_session_read_fd, file_session_encode, file_session_read_line_fd}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_text_error_message}

"""
# Sync File I/O

Handle-based file operations implementing Read, Write, Seek, Close traits.
Plus static convenience class File for one-shot operations.

## Components

| Type | Traits | Description |
|------|--------|-------------|
| FileHandle | Read, Write, Seek, Close | fd-based file handle |
| File | (static) | One-shot convenience methods |

FileMode and FileMetadata are defined in `std.common.io.types`.

## Handle-Based Usage

```simple
val fh = FileHandle.open("/tmp/io_test_handle.txt", FileMode.WriteOnly)?
fh.write_text("hello from handle")?
fh.flush()?
fh.close()?

val fh2 = FileHandle.read_file("/tmp/io_test_handle.txt")?
val content = fh2.read_text()?
expect content == "hello from handle"
fh2.close()?
```

## Static Convenience

```simple
File.write("/tmp/io_test_static.txt", "hello from File")?
val text = File.read("/tmp/io_test_static.txt")?
expect text == "hello from File"
expect File.exists("/tmp/io_test_static.txt") == true
File.delete("/tmp/io_test_static.txt")?
```

## Seek and Rewind

```simple
val fh = FileHandle.open("/tmp/io_test_seek.txt", FileMode.ReadWrite)?
fh.write_text("abcdef")?
fh.rewind()?
val content = fh.read_text()?
expect content == "abcdef"
fh.close()?
```

## File Copy

```simple
File.write("/tmp/io_test_copy_src.txt", "copy me")?
File.copy("/tmp/io_test_copy_src.txt", "/tmp/io_test_copy_dst.txt")?
val copied = File.read("/tmp/io_test_copy_dst.txt")?
expect copied == "copy me"
```
"""

use std.io.traits.{Read, Write, Seek, Close}
use std.io.types.{IoError, IoErrorKind, SeekFrom, FileMode, FileMetadata}

# ============================================================================
# FileHandle - Trait-Based File Handle
# ============================================================================

class FileHandle with Read, Write, Seek, Close:
    """File handle implementing Read, Write, Seek, Close.

    Wraps a file descriptor for fine-grained I/O control.

    Example:
        val fh = FileHandle.open("data.bin", FileMode.ReadWrite)?
        fh.write_text("hello")?
        fh.rewind()?
        val content = fh.read_text()?
        fh.close()?
    """
    fd: i64
    mode: FileMode
    open: bool

    # --- Factory ---

    pub static fn open(path: text, mode: FileMode) -> Result<FileHandle, IoError>:
        """Open file with specified mode.

        Args:
            path: File path
            mode: Open mode

        Returns:
            Result with FileHandle or IoError
        """
        val mode_int = match mode:
            case FileMode.ReadOnly: 0
            case FileMode.WriteOnly: 1
            case FileMode.ReadWrite: 2
            case FileMode.Append: 3
        var fd: i64 = -1
        unsafe(capabilities: [ffi]):
            fd = rt_io_file_open(path, mode_int)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.NotFound, message: "failed to open: {path}", source: nil))
        Ok(FileHandle(fd: fd, mode: mode, open: true))

    pub static fn read_file(path: text) -> Result<FileHandle, IoError>:
        """Open file for reading.

        Args:
            path: File path

        Returns:
            Result with FileHandle in ReadOnly mode
        """
        FileHandle.open(path, FileMode.ReadOnly)

    pub static fn create(path: text) -> Result<FileHandle, IoError>:
        """Create file for writing (truncates if exists).

        Args:
            path: File path

        Returns:
            Result with FileHandle in WriteOnly mode
        """
        FileHandle.open(path, FileMode.WriteOnly)

    pub static fn append(path: text) -> Result<FileHandle, IoError>:
        """Open file for appending.

        Args:
            path: File path

        Returns:
            Result with FileHandle in Append mode
        """
        FileHandle.open(path, FileMode.Append)

    # --- Read trait ---

    pub fn read(size: i64) -> Result<[u8], IoError>:
        """Read up to size bytes.

        Args:
            size: Maximum bytes to read

        Returns:
            Result with bytes read
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        file_read_borrowed_bytes(self.fd, size)

    pub fn read_exact(size: i64) -> Result<[u8], IoError>:
        """Read exactly size bytes (blocks until filled or EOF).

        Args:
            size: Exact number of bytes

        Returns:
            Result with bytes, or UnexpectedEof if short
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        if size < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "read_exact size must be non-negative", source: nil))
        # One read, as before: short data advances the descriptor and reports
        # UnexpectedEof; a provider failure remains its own I/O error.
        val data = self.read(size)?
        if data.len() != size:
            return Err(IoError(kind: IoErrorKind.UnexpectedEof, message: "read_exact: got {data.len()} of {size} bytes", source: nil))
        Ok(data)

    pub fn read_all() -> Result<[u8], IoError>:
        """Read all remaining bytes.

        Returns:
            Result with all bytes
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        var data: [u8]? = nil
        unsafe(capabilities: [ffi]):
            data = rt_io_file_read_all(self.fd)
        if data == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "read_all failed", source: nil))
        Ok(data ?? [])

    pub me read_text() -> Result<text, IoError>:
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        val codec = match file_default_text_codec():
            case Ok(value): value
            case Err(error): return Err(file_text_io_error(error))
        match file_session_read_fd(self.fd, codec):
            case Ok(value): Ok(value)
            case Err(error):
                # A bounded read may have consumed a prefix and its overflow
                # probe. Keep this owning facade terminal, just like the
                # dedicated text session; raw borrowed reads stay borrowed.
                self.close()
                Err(file_text_io_error(error))

    pub me read_line() -> Result<text, IoError>:
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        match file_session_read_line_fd(self.fd):
            case Ok(value): Ok(value)
            case Err(error):
                self.close()
                Err(file_text_io_error(error))

    # --- Write trait ---

    pub fn write(data: [u8]) -> Result<i64, IoError>:
        """Write bytes, returning number written.

        Args:
            data: Bytes to write

        Returns:
            Result with bytes written count
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        val written = io_file_write(self.fd, data)
        if written < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "write failed", source: nil))
        Ok(written)

    pub fn write_all(data: [u8]) -> Result<(), IoError>:
        """Write all bytes (blocks until done).

        Args:
            data: Bytes to write

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        val ok = io_file_write_all(self.fd, data)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "write_all failed", source: nil))
        Ok(())

    pub me write_text(s: text) -> Result<(), IoError>:
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        val codec = match file_default_text_codec():
            case Ok(value): value
            case Err(error): return Err(file_text_io_error(error))
        val bytes = match file_session_encode(s, codec, 0):
            case Ok(value): value
            case Err(error): return Err(file_text_io_error(error))
        match self.write_all(bytes):
            case Ok(_): Ok(())
            case Err(error):
                self.close()
                Err(error)

    fn flush() -> Result<(), IoError>:
        """Flush write buffer to disk.

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        var ok = false
        unsafe(capabilities: [ffi]):
            ok = rt_io_file_flush(self.fd)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "flush failed", source: nil))
        Ok(())

    # --- Seek trait ---

    fn seek(pos: SeekFrom) -> Result<i64, IoError>:
        """Seek to position.

        Args:
            pos: Seek target (Start, Current, or End with offset)

        Returns:
            Result with new absolute position
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        val (offset, whence) = match pos:
            case SeekFrom.Start(o): (o, 0)
            case SeekFrom.Current(o): (o, 1)
            case SeekFrom.End(o): (o, 2)
        var new_pos: i64 = -1
        unsafe(capabilities: [ffi]):
            new_pos = rt_io_file_seek(self.fd, offset, whence)
        if new_pos < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "seek failed", source: nil))
        Ok(new_pos)

    fn position() -> Result<i64, IoError>:
        """Get current position in file.

        Returns:
            Result with current byte offset
        """
        self.seek(SeekFrom.Current(0))

    fn rewind() -> Result<(), IoError>:
        """Seek back to beginning of file.

        Returns:
            Result or error
        """
        self.seek(SeekFrom.Start(0))?
        Ok(())

    # --- Close trait ---

    pub me close() -> Result<(), IoError>:
        """Close file handle and release fd.

        Returns:
            Result or error
        """
        if not self.open:
            return Ok(())
        val descriptor = self.fd
        self.open = false
        self.fd = -1
        var ok = false
        unsafe(capabilities: [ffi]):
            ok = rt_io_file_close(descriptor)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "close failed", source: nil))
        Ok(())

    pub fn is_open() -> bool:
        """Check if file handle is still open."""
        self.open

    # --- File-specific ---

    fn metadata() -> Result<FileMetadata, IoError>:
        """Get file metadata.

        Returns:
            Result with FileMetadata
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        # Assembled here from scalars rather than marshalled whole from the
        # runtime: a Rust-side FileMetadata constructor would bake this
        # struct's field layout into the runtime ABI.
        var flags: i64 = -1
        var size: i64 = -1
        var modified: i64 = 0
        var created: i64 = 0
        unsafe(capabilities: [ffi]):
            flags = rt_io_file_meta_flags(self.fd)
            size = rt_io_file_meta_size(self.fd)
            modified = rt_io_file_meta_modified(self.fd)
            created = rt_io_file_meta_created(self.fd)
        if flags < 0 or size < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "metadata failed", source: nil))
        Ok(FileMetadata(
            size: size,
            is_file: (flags & 1) != 0,
            is_dir: (flags & 2) != 0,
            is_symlink: (flags & 4) != 0,
            readonly: (flags & 8) != 0,
            modified: modified,
            created: created))

    fn size() -> Result<i64, IoError>:
        """Get file size in bytes.

        Returns:
            Result with size
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        var current: i64 = -1
        unsafe(capabilities: [ffi]):
            current = rt_io_file_seek(self.fd, 0, 1)
        if current < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "seek failed", source: nil))
        var end: i64 = -1
        unsafe(capabilities: [ffi]):
            end = rt_io_file_seek(self.fd, 0, 2)
        if end < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "seek failed", source: nil))
        var restored: i64 = -1
        unsafe(capabilities: [ffi]):
            restored = rt_io_file_seek(self.fd, current, 0)
        if restored < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "seek restore failed", source: nil))
        Ok(end)

    fn set_permissions(readonly: bool) -> Result<(), IoError>:
        """Set file permissions.

        Args:
            readonly: true to make read-only

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "file handle is closed", source: nil))
        var ok = false
        unsafe(capabilities: [ffi]):
            ok = rt_io_file_set_permissions(self.fd, readonly)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_permissions failed", source: nil))
        Ok(())

# ============================================================================
# File - Static Convenience
# ============================================================================

class File:
    """One-shot file operations (no handle management needed).

    Example:
        val content = File.read("config.sdn")?
        File.write("output.txt", content)?
    """

    pub static fn read(path: text) -> Result<text, IoError>:
        """Read entire file as text.

        Args:
            path: File path

        Returns:
            Result with text content
        """
        val codec = match file_default_text_codec():
            case Ok(value): value
            case Err(error): return Err(file_text_io_error(error))
        var session = match FileTextSession.open(path, FileMode.ReadOnly, codec):
            case Ok(value): value
            case Err(error): return Err(file_text_io_error(error))
        val result = session.read()
        val closed = session.close()
        match result:
            case Err(error): Err(file_text_io_error(error))
            case Ok(value):
                match closed:
                    case Err(error): Err(file_text_io_error(error))
                    case Ok(_): Ok(value)

    pub static fn open_text(path: text, mode: FileMode, codec: TextSessionCodec) -> Result<FileTextSession, TextIoError>:
        FileTextSession.open(path, mode, codec)

    pub static fn read_bytes(path: text) -> Result<[u8], IoError>:
        """Read entire file as bytes.

        Args:
            path: File path

        Returns:
            Result with byte array
        """
        var fh = FileHandle.read_file(path)?
        val result = fh.read_all()
        val closed = fh.close()
        match result:
            case Err(error): Err(error)
            case Ok(data):
                match closed:
                    case Err(error): Err(error)
                    case Ok(_): Ok(data)

    pub static fn write(path: text, content: text) -> Result<(), IoError>:
        """Write text to file (creates/truncates).

        Args:
            path: File path
            content: Text to write

        Returns:
            Result or error
        """
        file_write_default_session(path, content, FileMode.WriteOnly)

    pub static fn write_bytes(path: text, data: [u8]) -> Result<(), IoError>:
        """Write bytes to file (creates/truncates).

        Args:
            path: File path
            data: Bytes to write

        Returns:
            Result or error
        """
        var fh = FileHandle.create(path)?
        val written = fh.write_all(data)
        val closed = fh.close()
        match written:
            case Err(error): Err(error)
            case Ok(_): closed

    pub static fn append(path: text, content: text) -> Result<(), IoError>:
        """Append text to file.

        Args:
            path: File path
            content: Text to append

        Returns:
            Result or error
        """
        file_write_default_session(path, content, FileMode.Append)

    static fn copy(src: text, dst: text) -> Result<(), IoError>:
        """Copy file from src to dst.

        Args:
            src: Source path
            dst: Destination path

        Returns:
            Result or error
        """
        val data = File.read_bytes(src)?
        File.write_bytes(dst, data)

    pub static fn exists(path: text) -> bool:
        """Check if file exists.

        Args:
            path: File path

        Returns:
            true if exists
        """
        unsafe(capabilities: [ffi]):
            rt_io_file_exists(path)

    static fn delete(path: text) -> Result<(), IoError>:
        """Delete a file.

        Args:
            path: File path

        Returns:
            Result or error
        """
        var ok = false
        unsafe(capabilities: [ffi]):
            ok = rt_io_file_delete(path)
        if not ok:
            return Err(IoError(kind: IoErrorKind.NotFound, message: "delete failed: {path}", source: nil))
        Ok(())

# ============================================================================
# SFFI Functions
# ============================================================================

# File handle operations
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_open(path: text, mode: i64) -> i64
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_read_all(fd: i64) -> [u8]?
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_seek(fd: i64, offset: i64, whence: i64) -> i64
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_flush(fd: i64) -> bool
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_close(fd: i64) -> bool
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_meta_size(fd: i64) -> i64
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_meta_flags(fd: i64) -> i64
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_meta_modified(fd: i64) -> i64
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_meta_created(fd: i64) -> i64
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_set_permissions(fd: i64, readonly: bool) -> bool
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_exists(path: text) -> bool
@unsafe(reason: "raw file descriptor provider boundary", capabilities: [ffi])
extern fn rt_io_file_delete(path: text) -> bool

fn file_write_default_session(path: text, content: text, mode: FileMode) -> Result<(), IoError>:
    val codec = match file_default_text_codec():
        case Ok(value): value
        case Err(error): return Err(file_text_io_error(error))
    match FileTextSession.write_file(path, content, mode, codec):
        case Ok(_): Ok(())
        case Err(error): Err(file_text_io_error(error))

fn file_text_io_error(error: TextIoError) -> IoError:
    match error:
        case TextIoError.Transport(transport): transport
        case _: IoError(kind: IoErrorKind.InvalidData, message: io_text_error_message(error), source: nil)

# ============================================================================
# Exports
# ============================================================================

export FileHandle, File, FileTextSession, file_read_borrowed_bytes
