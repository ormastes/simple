# Canonical cryptography facade.
#
# Hashing and HMAC use their in-tree Pure Simple owners. The sole hosted
# provider in this module is the OS CSPRNG hex source, isolated behind one
# minimal unsafe call and an executable length/encoding/entropy contract.

use std.common.crypto.sha256.{sha256_text as pure_sha256_text}
use std.common.crypto.sha512.{sha512_text as pure_sha512_text}
use std.common.crypto.sha3.{sha3_256_bytes}
use std.common.crypto.blake3.{blake3_text as pure_blake3_text}
use std.common.crypto.hmac.{hmac_sha256 as pure_hmac_sha256, hmac_sha512 as pure_hmac_sha512}
use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}

@unsafe(reason: "OS CSPRNG hex provider; checked for presence, exact length, encoding, and nonzero entropy", capabilities: [ffi])
extern fn rt_random_hex(length: i64) -> text?

fn hash_sha256(data: text) -> text:
    pure_sha256_text(data)

fn hash_sha512(data: text) -> text:
    pure_sha512_text(data)

fn hash_sha3_256(data: text) -> text:
    bytes_to_hex(sha3_256_bytes(crypto_text_to_bytes(data)))

fn hash_blake3(data: text) -> text:
    pure_blake3_text(data)

fn hash(data: text) -> text:
    hash_sha256(data)

# reason: positional io crypto_sffi API
fn hmac_sha256(key: text, data: text) -> text:
    pure_hmac_sha256(key, data)

# reason: positional io crypto_sffi API
fn hmac_sha512(key: text, data: text) -> text:
    pure_hmac_sha512(key, data)

# reason: positional io crypto_sffi API
fn hmac(key: text, data: text) -> text:
    hmac_sha256(key, data)

fn entropy_hex_valid_for(value: text, length: i64) -> bool:
    if length < 0:
        return false
    if value.len() != length * 2:
        return false
    if length == 0:
        return true
    var saw_nonzero = false
    for i in 0..value.len():
        val byte = value.byte_at(i)
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)):
            return false
        if byte != 48:
            saw_nonzero = true
    saw_nonzero

fn checked_entropy_hex(raw: text?, length: i64) -> text?:
    if raw == nil:
        return nil
    val value: text = raw ?? ""
    if not entropy_hex_valid_for(value, length):
        return nil
    value

fn _random_hex_raw(length: i64) -> text?:
    var raw: text? = nil
    unsafe(capabilities: [ffi]):
        raw = rt_random_hex(length)
    raw

fn random_hex(length: i64) -> text?:
    if length < 0:
        return nil
    checked_entropy_hex(_random_hex_raw(length), length)

fn secure_entropy_hex_valid(value: text) -> bool:
    entropy_hex_valid_for(value, 16)

fn random_salt() -> text?:
    random_hex(16)

# reason: positional io crypto_sffi API
fn hash_verify(data: text, expected_hash: text) -> bool:
    hash_sha256(data) == expected_hash

# reason: positional io crypto_sffi API
fn hmac_verify(key: text, data: text, expected_hmac: text) -> bool:
    hmac_sha256(key, data) == expected_hmac

export random_hex
