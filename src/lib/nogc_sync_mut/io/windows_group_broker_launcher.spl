# Windows entry composition only. Do not import this owner from portable code.
use std.nogc_sync_mut.io.windows_worker_launcher.{windows_worker_spawn_v1, windows_worker_detach_v1}

fn windows_group_broker_launch_v1(program: text, digest: text, args: [text], directory: text) -> Result<bool, text>:
    val token = windows_worker_spawn_v1(program, digest, args, directory)?
    # The broker now owns its own lifetime; parent restart attaches by challenge.
    windows_worker_detach_v1(token)

export windows_group_broker_launch_v1
