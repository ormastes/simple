# One bounded process-local owner for copied credential capabilities. Native
# Windows roots/files retain authoritative handles; this i64 mutex serializes
# the compound lifecycle. Exact stage retirement adds one versioned native port
# whose export-policy admission remains pending independent review.
use std.nogc_sync_mut.io.windows_private_file_v1.{WindowsPrivateRootV1, WindowsPrivateFileV1, windows_private_root_open_v1}
use std.nogc_sync_mut.io.windows_private_read_v2.{WindowsPrivateReadRootV2, WindowsPrivateReadFileV2,
    windows_private_read_root_open_v2, windows_private_roots_same_directory_v2, windows_private_adopt_published_read_v2}
use std.nogc_sync_mut.io.retained_private_credential_protocol_v2.*
use std.nogc_sync_mut.io.windows_private_stage_discard_v2.windows_private_stage_discard_v2
use std.common.string_core.str_last_index_of
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex

pub class WindowsRetainedPrivateCredentialV2:
    identity: i64

pub struct WindowsRetainedPrivateCredentialOpenTurnV2:
    owner: WindowsRetainedPrivateCredentialV2?
    state: text
    error: text

pub struct WindowsRetainedPrivateCredentialReadTurnV2:
    owner: WindowsRetainedPrivateCredentialV2
    state: text
    bytes: [u8]
    error: text

pub struct WindowsRetainedPrivateCredentialMutationTurnV2:
    owner: WindowsRetainedPrivateCredentialV2
    state: text
    error: text
    completed: bool
    consumed: bool
    publication_state: text

@when(os="windows"):
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new_gate, mutex_lock_gate, mutex_unlock_gate}

class _WindowsCredentialEntryV2:
    identity: i64
    phase: text
    error: text
    leaf: text
    writer: WindowsPrivateRootV1?
    reader_root: WindowsPrivateReadRootV2?
    initial: WindowsPrivateReadFileV2?
    stage: WindowsPrivateFileV1?
    ready: WindowsPrivateReadFileV2?
    stage_published: bool
    publication_state: text
    pending_writer: WindowsPrivateRootV1?
    initial_bytes: [u8]

    fn current() -> bool:
        if self.writer.is_none() or self.reader_root.is_none() or self.initial.is_none(): return false
        if not self.writer.unwrap().security_current() or not self.reader_root.unwrap().security_current(): return false
        val same = windows_private_roots_same_directory_v2(self.writer.unwrap(), self.reader_root.unwrap())
        if same.is_err() or not same.unwrap() or not self.initial.unwrap().security_current(): return false
        if self.phase == "published":
            if self.ready.is_none() or not self.ready.unwrap().security_current(): return false
        true

    me refuse(reason: text):
        self.phase = "uncertain"
        self.error = reason

    me read_initial() -> [u8]:
        if self.phase != "open" and self.phase != "published": return []
        if not self.current():
            self.refuse("private-credential-metadata-rejected")
            return []
        var source = self.initial.unwrap()
        val read = source.read_all_bounded(512)
        self.initial = Some(source)
        if read.is_err():
            self.refuse("private-credential-io-error")
            return []
        val bytes = read.unwrap()
        if not retained_credential_initial_valid_v2(bytes) or
                not retained_credential_bytes_equal_v2(bytes, self.initial_bytes):
            self.refuse("private-credential-initial-changed")
            return []
        if not self.current():
            self.refuse("private-credential-metadata-rejected")
            return []
        bytes

    me publish(initial: [u8], ready: [u8]) -> bool:
        val observed = self.read_initial()
        if self.phase != "open": return false
        self.refuse("private-credential-publication-uncertain")
        self.publication_state = "not-published"
        if not retained_credential_bytes_equal_v2(initial, observed):
            self.error = "private-credential-initial-changed"
            return false
        if not retained_credential_ready_matches_v2(observed, ready):
            self.error = "private-credential-ready-rejected"
            return false
        val entropy = sosix_random_hex(16)
        if entropy == nil:
            self.error = "private-credential-entropy-unavailable"
            return false
        val created = self.writer.unwrap().create_private_stage(".credential-" + entropy.unwrap(), 512u64)
        if created.is_err():
            val failure = created.unwrap_err()
            self.stage = failure.cleanup_file
            self.pending_writer = failure.cleanup_root
            self.error = "private-credential-stage-open"
            return false
        var stage = created.unwrap()
        self.stage = Some(stage)
        val written = stage.write(ready)
        self.stage = Some(stage)
        if written.is_err() or not written.unwrap():
            self.error = "private-credential-stage-write"
            return false
        val sealed = stage.seal()
        self.stage = Some(stage)
        if sealed.is_err() or not sealed.unwrap():
            self.error = "private-credential-stage-seal"
            return false
        # Initial and both root generations are rechecked directly before
        # rename; the same credential gate excludes all copied close/publish.
        if not self.current():
            self.error = "private-credential-metadata-rejected"
            return false
        var source = self.initial.unwrap()
        val checked = source.read_all_bounded(512)
        self.initial = Some(source)
        if checked.is_err() or not retained_credential_bytes_equal_v2(checked.unwrap(), observed):
            self.error = "private-credential-initial-changed"
            return false
        self.publication_state = "uncertain"
        val published = self.writer.unwrap().publish_no_replace(stage, self.leaf + ".ready")
        if published.is_err(): return false
        if not published.unwrap():
            self.publication_state = "collision"
            self.error = "private-credential-publication-conflict"
            return false
        self.stage_published = true
        # Native adoption binds exactly the already-published stage identity,
        # consumes its write capability, and retains either cleanup result.
        val adopted = windows_private_adopt_published_read_v2(self.writer.unwrap(), stage, self.leaf + ".ready")
        self.stage = adopted.stage
        self.ready = adopted.reader
        if adopted.error != "" or self.ready.is_none(): return false
        var final = self.ready.unwrap()
        val final_bytes = final.read_all_bounded(512)
        self.ready = Some(final)
        if final_bytes.is_err() or not retained_credential_bytes_equal_v2(final_bytes.unwrap(), ready): return false
        val initial_after = source.read_all_bounded(512)
        self.initial = Some(source)
        if initial_after.is_err() or not retained_credential_bytes_equal_v2(initial_after.unwrap(), observed): return false
        if not self.current(): return false
        self.phase = "published"
        self.publication_state = "published"
        self.error = ""
        true

    me close_owned() -> bool:
        self.refuse("private-credential-close-retained")
        # A slot is forgotten only after that exact native close succeeded.
        # A failed close retains the remaining capabilities for another turn.
        if self.stage.is_some():
            if not self.stage_published:
                # The one native origin-bound operation deletes only a stage
                # still bound to its original name; uncertain ready renames
                # remain retained rather than deleting a published target.
                val discarded = windows_private_stage_discard_v2(self.writer.unwrap(), self.stage.unwrap())
                self.stage = discarded.stage
                if not discarded.completed or not discarded.consumed:
                    self.error = "private-credential-stage-cleanup-retained"
                    return false
            else:
                var item = self.stage.unwrap()
                if not item.close(): return false
                self.stage = None
        if self.ready.is_some():
            var item = self.ready.unwrap()
            if not item.close(): return false
            self.ready = None
        if self.initial.is_some():
            var item = self.initial.unwrap()
            if not item.close(): return false
            self.initial = None
        if self.pending_writer.is_some():
            var item = self.pending_writer.unwrap()
            if not item.close(): return false
            self.pending_writer = None
        if self.reader_root.is_some():
            var item = self.reader_root.unwrap()
            if not item.close(): return false
            self.reader_root = None
        if self.writer.is_some():
            var item = self.writer.unwrap()
            if not item.close(): return false
            self.writer = None
        self.initial_bytes = []
        self.phase = "closed"
        self.error = ""
        true

var _windows_credential_gate_v2: Mutex = mutex_new_gate(0)
var _windows_credentials_v2: [_WindowsCredentialEntryV2] = []
var _windows_credential_next_v2: i64 = 1

fn _credential_empty_v2(identity: i64, leaf: text) -> _WindowsCredentialEntryV2:
    _WindowsCredentialEntryV2(identity: identity, phase: "uncertain", error: "private-credential-open-failed",
        leaf: leaf, writer: None, reader_root: None, initial: None, stage: None, ready: None,
        pending_writer: None, initial_bytes: [], stage_published: false, publication_state: "not-attempted")

fn _credential_index_v2(identity: i64) -> i64:
    if identity <= 0: return -1
    for index in 0.._windows_credentials_v2.len():
        if _windows_credentials_v2[index].identity == identity: return index
    -1

fn _credential_leaf_v2(path: text) -> Result<(text, text), text>:
    if path.byte_len() < 4 or path.byte_len() > 32760: return Err("private-credential-path-rejected")
    val normalized = path.replace("\\", "/")
    val separator = str_last_index_of(normalized, "/")
    if separator < 3 or separator + 1 >= normalized.byte_len(): return Err("private-credential-path-rejected")
    val parent = normalized.slice(0, separator)
    val leaf = normalized.slice(separator + 1, normalized.byte_len())
    if leaf.byte_len() < 1 or leaf.byte_len() > 249 or leaf == "." or leaf == ".." or
            leaf.ends_with(".") or leaf.lower().ends_with(".ready"): return Err("private-credential-path-rejected")
    for index in 0..leaf.byte_len():
        val code = leaf.char_code_at(index)
        if not ((code >= 48 and code <= 57) or (code >= 65 and code <= 90) or
                (code >= 97 and code <= 122) or code == 95 or code == 45 or code == 46):
            return Err("private-credential-path-rejected")
    Ok((parent, leaf))

fn _credential_acquire_v2(entry: _WindowsCredentialEntryV2, parent: text) -> _WindowsCredentialEntryV2:
    var acquired = entry
    val writer = windows_private_root_open_v1(parent)
    if writer.is_err():
        acquired.writer = writer.unwrap_err().cleanup_root
        return acquired
    acquired.writer = Some(writer.unwrap())
    val reader = windows_private_read_root_open_v2(parent)
    if reader.is_err():
        acquired.reader_root = reader.unwrap_err().cleanup_root
        return acquired
    acquired.reader_root = Some(reader.unwrap())
    val same = windows_private_roots_same_directory_v2(acquired.writer.unwrap(), acquired.reader_root.unwrap())
    if same.is_err() or not same.unwrap():
        acquired.error = "private-credential-root-identity"
        return acquired
    val initial = acquired.reader_root.unwrap().open_file(acquired.leaf, 512u64)
    if initial.is_err():
        val failure = initial.unwrap_err()
        acquired.initial = failure.cleanup_file
        acquired.error = "private-credential-initial-open"
        return acquired
    var source = initial.unwrap()
    acquired.initial = Some(source)
    val bytes = source.read_all_bounded(512)
    acquired.initial = Some(source)
    if bytes.is_err() or not retained_credential_initial_valid_v2(bytes.unwrap()):
        acquired.error = "private-credential-initial-rejected"
        return acquired
    acquired.initial_bytes = bytes.unwrap()
    if not acquired.current():
        acquired.error = "private-credential-metadata-rejected"
        return acquired
    acquired.phase = "open"
    acquired.error = ""
    acquired

pub fn windows_retained_private_credential_open_v2(path: text) -> WindowsRetainedPrivateCredentialOpenTurnV2:
    val spelling = _credential_leaf_v2(path)
    if spelling.is_err():
        return WindowsRetainedPrivateCredentialOpenTurnV2(owner: None, state: "unavailable", error: spelling.unwrap_err())
    if mutex_lock_gate(_windows_credential_gate_v2).is_none():
        return WindowsRetainedPrivateCredentialOpenTurnV2(owner: None, state: "unavailable", error: "private-credential-owner-lock")
    var index = -1
    for candidate in 0.._windows_credentials_v2.len():
        if _windows_credentials_v2[candidate].phase == "closed" and index < 0: index = candidate
    if index < 0 and _windows_credentials_v2.len() < 32:
        index = _windows_credentials_v2.len()
        _windows_credentials_v2.push(_credential_empty_v2(0, ""))
    if index < 0 or _windows_credential_next_v2 >= 9223372036854775807:
        val released = mutex_unlock_gate(_windows_credential_gate_v2, 0)
        return WindowsRetainedPrivateCredentialOpenTurnV2(owner: None, state: "unavailable", error: "private-credential-registry-full")
    val (parent, leaf) = spelling.unwrap()
    val identity = _windows_credential_next_v2
    _windows_credential_next_v2 = identity + 1
    var entry = _credential_acquire_v2(_credential_empty_v2(identity, leaf), parent)
    var owner: WindowsRetainedPrivateCredentialV2? = Some(WindowsRetainedPrivateCredentialV2(identity: identity))
    if entry.writer.is_none() and entry.reader_root.is_none() and entry.initial.is_none():
        entry.phase = "closed"
        owner = None
    _windows_credentials_v2[index] = entry
    val released = mutex_unlock_gate(_windows_credential_gate_v2, 0)
    if released != 1:
        return WindowsRetainedPrivateCredentialOpenTurnV2(owner: owner, state: "uncertain", error: "private-credential-owner-unlock")
    WindowsRetainedPrivateCredentialOpenTurnV2(owner: owner, state: if owner.is_none(): "unavailable" else: entry.phase, error: entry.error)

pub fn windows_retained_private_credential_read_v2(owner: WindowsRetainedPrivateCredentialV2) -> WindowsRetainedPrivateCredentialReadTurnV2:
    if mutex_lock_gate(_windows_credential_gate_v2).is_none():
        return WindowsRetainedPrivateCredentialReadTurnV2(owner: owner, state: "uncertain", bytes: [], error: "private-credential-owner-lock")
    val index = _credential_index_v2(owner.identity)
    var bytes: [u8] = []
    var phase = "unavailable"
    var error = "private-credential-stale-token"
    if index >= 0:
        var entry = _windows_credentials_v2[index]
        bytes = entry.read_initial()
        phase = entry.phase
        error = if phase == "open" or phase == "published": "" else: entry.error
        if phase == "closed": error = "private-credential-state-denied"
        _windows_credentials_v2[index] = entry
    val released = mutex_unlock_gate(_windows_credential_gate_v2, 0)
    if released != 1:
        return WindowsRetainedPrivateCredentialReadTurnV2(owner: owner, state: "uncertain", bytes: [], error: "private-credential-owner-unlock")
    WindowsRetainedPrivateCredentialReadTurnV2(owner: owner, state: phase, bytes: bytes, error: error)

pub fn windows_retained_private_credential_state_v2(owner: WindowsRetainedPrivateCredentialV2) -> WindowsRetainedPrivateCredentialReadTurnV2:
    # No secret bytes are returned by a state observation.
    val observed = windows_retained_private_credential_read_v2(owner)
    WindowsRetainedPrivateCredentialReadTurnV2(owner: owner, state: observed.state, bytes: [], error: observed.error)

fn _credential_mutate_v2(owner: WindowsRetainedPrivateCredentialV2, initial: [u8], ready: [u8], closing: bool) -> WindowsRetainedPrivateCredentialMutationTurnV2:
    if mutex_lock_gate(_windows_credential_gate_v2).is_none():
        return WindowsRetainedPrivateCredentialMutationTurnV2(owner: owner, state: "uncertain", error: "private-credential-owner-lock", completed: false, consumed: false, publication_state: "unavailable")
    val index = _credential_index_v2(owner.identity)
    var phase = "unavailable"
    var error = "private-credential-stale-token"
    var completed = false
    var consumed = false
    var publication_state = "unavailable"
    if index >= 0:
        var entry = _windows_credentials_v2[index]
        if entry.phase == "closed" or (not closing and entry.phase != "open"):
            error = "private-credential-state-denied"
        else:
            completed = if closing: entry.close_owned() else: entry.publish(initial, ready)
            # Consumption is recorded only by the actual owned-close sequence,
            # never upgraded by later metadata, state queries or stale aliases.
            consumed = closing and completed
            error = entry.error
        phase = entry.phase
        publication_state = entry.publication_state
        _windows_credentials_v2[index] = entry
    val released = mutex_unlock_gate(_windows_credential_gate_v2, 0)
    if released != 1:
        return WindowsRetainedPrivateCredentialMutationTurnV2(owner: owner, state: "uncertain", error: "private-credential-owner-unlock", completed: false, consumed: consumed, publication_state: publication_state)
    WindowsRetainedPrivateCredentialMutationTurnV2(owner: owner, state: phase, error: error, completed: completed, consumed: consumed, publication_state: publication_state)

pub fn windows_retained_private_credential_publish_v2(owner: WindowsRetainedPrivateCredentialV2, initial: [u8], ready: [u8]) -> WindowsRetainedPrivateCredentialMutationTurnV2:
    _credential_mutate_v2(owner, initial, ready, false)

pub fn windows_retained_private_credential_close_v2(owner: WindowsRetainedPrivateCredentialV2) -> WindowsRetainedPrivateCredentialMutationTurnV2:
    _credential_mutate_v2(owner, [], [], true)
@else:
pub fn windows_retained_private_credential_open_v2(path: text) -> WindowsRetainedPrivateCredentialOpenTurnV2:
    WindowsRetainedPrivateCredentialOpenTurnV2(owner: None, state: "unavailable", error: "private-credential-unsupported")
pub fn windows_retained_private_credential_read_v2(owner: WindowsRetainedPrivateCredentialV2) -> WindowsRetainedPrivateCredentialReadTurnV2:
    WindowsRetainedPrivateCredentialReadTurnV2(owner: owner, state: "unavailable", bytes: [], error: "private-credential-unsupported")
pub fn windows_retained_private_credential_state_v2(owner: WindowsRetainedPrivateCredentialV2) -> WindowsRetainedPrivateCredentialReadTurnV2:
    windows_retained_private_credential_read_v2(owner)
pub fn windows_retained_private_credential_publish_v2(owner: WindowsRetainedPrivateCredentialV2, initial: [u8], ready: [u8]) -> WindowsRetainedPrivateCredentialMutationTurnV2:
    WindowsRetainedPrivateCredentialMutationTurnV2(owner: owner, state: "unavailable", error: "private-credential-unsupported", completed: false, consumed: false, publication_state: "unavailable")
pub fn windows_retained_private_credential_close_v2(owner: WindowsRetainedPrivateCredentialV2) -> WindowsRetainedPrivateCredentialMutationTurnV2:
    WindowsRetainedPrivateCredentialMutationTurnV2(owner: owner, state: "unavailable", error: "private-credential-unsupported", completed: false, consumed: false, publication_state: "unavailable")
@end

export WindowsRetainedPrivateCredentialV2, WindowsRetainedPrivateCredentialOpenTurnV2
export WindowsRetainedPrivateCredentialReadTurnV2, WindowsRetainedPrivateCredentialMutationTurnV2
export windows_retained_private_credential_open_v2, windows_retained_private_credential_read_v2
export windows_retained_private_credential_state_v2, windows_retained_private_credential_publish_v2, windows_retained_private_credential_close_v2
