# Win64 Winsock2 ABI. SOCKET and pointers occupy 64 bits; INT/LONG are 32.
# These declarations are selected only by an admitted native Windows owner.
@unsafe(reason: "Winsock process reference acquisition into owned WSADATA", capabilities: [ffi, raw_ptr])
extern fn WSAStartup(version: u16, data: i64) -> i32
@unsafe(reason: "Winsock reference release after owned socket closure", capabilities: [ffi])
extern fn WSACleanup() -> i32
@unsafe(reason: "thread-local Winsock failure observation", capabilities: [ffi])
extern fn WSAGetLastError() -> i32
@unsafe(reason: "Winsock stream socket acquisition", capabilities: [ffi])
extern fn socket(family: i32, kind: i32, protocol: i32) -> i64
@unsafe(reason: "Winsock owned socket closure", capabilities: [ffi])
extern fn closesocket(fd: i64) -> i32
@unsafe(reason: "Winsock copied IPv4 bind address", capabilities: [ffi, raw_ptr])
extern fn bind(fd: i64, address: i64, length: i32) -> i32
@unsafe(reason: "Winsock bounded listen backlog", capabilities: [ffi])
extern fn listen(fd: i64, backlog: i32) -> i32
@unsafe(reason: "Winsock accepted stream acquisition", capabilities: [ffi, raw_ptr])
extern fn accept(fd: i64, address: i64, length: i64) -> i64
@unsafe(reason: "Winsock copied IPv4 connection address", capabilities: [ffi, raw_ptr])
extern fn connect(fd: i64, address: i64, length: i32) -> i32
@unsafe(reason: "Winsock bounded owned receive buffer", capabilities: [ffi, raw_ptr])
extern fn recv(fd: i64, buffer: i64, length: i32, flags: i32) -> i32
@unsafe(reason: "Winsock copied bounded send buffer", capabilities: [ffi, raw_ptr])
extern fn send(fd: i64, buffer: i64, length: i32, flags: i32) -> i32
@unsafe(reason: "Winsock owned nonblocking flag slot", capabilities: [ffi, raw_ptr])
extern fn ioctlsocket(fd: i64, command: i32, argument: i64) -> i32
@unsafe(reason: "Winsock copied socket option", capabilities: [ffi, raw_ptr])
extern fn setsockopt(fd: i64, level: i32, option: i32, value: i64, length: i32) -> i32
@unsafe(reason: "Winsock bounded socket option observation", capabilities: [ffi, raw_ptr])
extern fn getsockopt(fd: i64, level: i32, option: i32, value: i64, length: i64) -> i32
@unsafe(reason: "Winsock bounded local IPv4 address observation", capabilities: [ffi, raw_ptr])
extern fn getsockname(fd: i64, address: i64, length: i64) -> i32
@unsafe(reason: "Winsock bounded peer IPv4 address observation", capabilities: [ffi, raw_ptr])
extern fn getpeername(fd: i64, address: i64, length: i64) -> i32
@unsafe(reason: "Winsock owned stream half closure", capabilities: [ffi])
extern fn shutdown(fd: i64, how: i32) -> i32
@unsafe(reason: "Winsock finite single-socket poll", capabilities: [ffi, raw_ptr])
extern fn WSAPoll(descriptors: i64, count: u32, timeout: i32) -> i32
@unsafe(reason: "clear inheritance on a newly acquired Winsock handle", capabilities: [ffi])
extern fn SetHandleInformation(handle: i64, mask: u32, flags: u32) -> i32

export WSAStartup, WSACleanup, WSAGetLastError, socket, closesocket
export bind, listen, accept, connect, recv, send, ioctlsocket
export setsockopt, getsockopt, getsockname, getpeername, shutdown, WSAPoll
export SetHandleInformation
