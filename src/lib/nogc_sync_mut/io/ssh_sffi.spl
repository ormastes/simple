#!/usr/bin/env simple
# SSH Client SFFI Wrapper
#
# SFFI pattern for SSH2 protocol operations.
# Supports remote command execution, SFTP file transfer, and port forwarding.
#
# Rust crate: ssh2 (https://docs.rs/ssh2/)
# Based on: libssh2 C library

use std.nogc_sync_mut.io.sffi_common.{is_valid_handle, is_invalid_handle}

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI) -- UNBACKED, DO NOT CALL DIRECTLY
# ============================================================================
#
# TODO(ssh-sffi-unbacked): all 23 rt_ssh_*/rt_sftp_* externs below have ZERO
# definitions anywhere in src/runtime/ (verified by grep, 2026-08-06). There is
# no C symbol, no interpreter_extern registration, and no runtime_symbols.rs
# entry for any of them. Under the JIT an unregistered extern returns nil
# silently rather than erroring (doc/08_tracking/bug/
# ssh_daemon_baremetal_only_and_duplication_2026-08-05.md, finding 5, "A dead
# third stack"), so every Tier 2 wrapper below always "fails" in a way that is
# indistinguishable from a legitimate connection/auth failure. Kept declared
# (not deleted) because ssh_terminal.spl imports and calls all of them and has
# 5 real production importers (src/app/test_daemon/adapters/
# remote_pc_adapter.spl reaches it transitively). ssh_terminal.spl now emits an
# unconditional, unmistakable stderr diagnostic on every call so the "not
# implemented" root cause is loud instead of silent -- see that file. Actually
# implementing libssh2-backed `rt_ssh_*`/`rt_sftp_*` runtime primitives is the
# real fix and is out of scope here.

# --- Session Management ---

@unsafe(reason: "unbacked SSH transport ABI; host-key policy and owned session handle are unknown", capabilities: [ffi])
extern fn rt_ssh_connect(host: text, port: i64) -> i64
@unsafe(reason: "unbacked SSH session-handle release ABI", capabilities: [ffi])
extern fn rt_ssh_disconnect(session: i64) -> bool
@unsafe(reason: "unbacked SSH credential ABI; authentication and secret-lifetime contracts are unknown", capabilities: [ffi])
extern fn rt_ssh_auth_password(session: i64, username: text, password: text) -> bool
@unsafe(reason: "unbacked SSH key credential ABI; path, passphrase, and secret-lifetime contracts are unknown", capabilities: [ffi])
extern fn rt_ssh_auth_pubkey(session: i64, username: text, pubkey_path: text, privkey_path: text, passphrase: text) -> bool
@unsafe(reason: "unbacked SSH agent credential ABI; authentication contract is unknown", capabilities: [ffi])
extern fn rt_ssh_auth_agent(session: i64, username: text) -> bool

# --- Remote Command Execution ---

@unsafe(reason: "unbacked remote-command ABI; tuple ownership, output bounds, and transport failure are ambiguous", capabilities: [ffi])
extern fn rt_ssh_exec(session: i64, command: text) -> (i64, text, text)  # (exit_code, stdout, stderr)
@unsafe(reason: "unbacked SSH session-to-channel owned-handle ABI", capabilities: [ffi])
extern fn rt_ssh_shell(session: i64) -> i64  # Returns channel handle
@unsafe(reason: "unbacked channel read ABI; empty, EOF, failure, allocation, and output bounds are ambiguous", capabilities: [ffi])
extern fn rt_ssh_channel_read(channel: i64) -> text
@unsafe(reason: "unbacked channel write ABI; binary-in-text extent and partial-write contracts are unknown", capabilities: [ffi])
extern fn rt_ssh_channel_write(channel: i64, data: text) -> i64
@unsafe(reason: "unbacked SSH channel-handle release ABI", capabilities: [ffi])
extern fn rt_ssh_channel_close(channel: i64) -> bool

# --- SFTP File Transfer ---

@unsafe(reason: "unbacked SSH session-to-SFTP owned-handle ABI", capabilities: [ffi])
extern fn rt_sftp_init(session: i64) -> i64  # Returns SFTP handle
@unsafe(reason: "unbacked SFTP handle release ABI", capabilities: [ffi])
extern fn rt_sftp_shutdown(sftp: i64) -> bool
@unsafe(reason: "unbacked SFTP transfer ABI; local/remote path and partial-transfer contracts are unknown", capabilities: [ffi])
extern fn rt_sftp_upload(sftp: i64, local_path: text, remote_path: text) -> bool
@unsafe(reason: "unbacked SFTP transfer ABI; remote/local path and partial-transfer contracts are unknown", capabilities: [ffi])
extern fn rt_sftp_download(sftp: i64, remote_path: text, local_path: text) -> bool
@unsafe(reason: "unbacked SFTP directory ABI; path and mode validation are unknown", capabilities: [ffi])
extern fn rt_sftp_mkdir(sftp: i64, path: text, mode: i64) -> bool
@unsafe(reason: "unbacked SFTP destructive directory ABI; remote path validation is unknown", capabilities: [ffi])
extern fn rt_sftp_rmdir(sftp: i64, path: text) -> bool
@unsafe(reason: "unbacked SFTP destructive file ABI; remote path validation is unknown", capabilities: [ffi])
extern fn rt_sftp_unlink(sftp: i64, path: text) -> bool
@unsafe(reason: "unbacked SFTP rename ABI; source and destination path validation are unknown", capabilities: [ffi])
extern fn rt_sftp_rename(sftp: i64, src: text, dst: text) -> bool
@unsafe(reason: "unbacked SFTP listing ABI; empty/failure and runtime-owned text are ambiguous", capabilities: [ffi])
extern fn rt_sftp_readdir(sftp: i64, path: text) -> text  # Newline-separated
@unsafe(reason: "unbacked SFTP metadata tuple ABI; failure and field validity are ambiguous", capabilities: [ffi])
extern fn rt_sftp_stat(sftp: i64, path: text) -> (i64, i64, i64)  # (size, mode, mtime)

# --- Port Forwarding ---


# --- Known Hosts ---


# --- Session Info ---

@unsafe(reason: "unbacked SSH banner ABI; empty/failure and runtime-owned text are ambiguous", capabilities: [ffi])
extern fn rt_ssh_get_banner(session: i64) -> text
@unsafe(reason: "unbacked SSH timeout ABI; range and session mutation contracts are unknown", capabilities: [ffi])
extern fn rt_ssh_set_timeout(session: i64, timeout_ms: i64) -> bool
@unsafe(reason: "unbacked SSH authentication-state ABI", capabilities: [ffi])
extern fn rt_ssh_is_authenticated(session: i64) -> bool

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

# --- Core Types ---

struct SshSession:
    handle: i64
    host: text
    port: i64
    is_valid: bool

struct SshChannel:
    handle: i64
    is_valid: bool

struct SftpSession:
    handle: i64
    is_valid: bool

struct SshExecResult:
    exit_code: i64
    stdout: text
    stderr: text

struct SftpFileInfo:
    size: i64
    mode: i64
    mtime: i64

# --- Session Management ---

@unsafe(reason: "unbacked SSH provider and unverified session-handle contract", capabilities: [ffi])
fn ssh_connect(host: text, port: i64) -> SshSession:
    """Connect to SSH server

    Args:
        host: SSH server hostname/IP
        port: Port number (usually 22)

    Returns: SshSession (check is_valid)

    Example:
        session = ssh_connect("example.com", 22)
        if session.is_valid:
            ssh_auth_password(session, "user", "pass")
    """
    val handle = unsafe(capabilities: [ffi]):
        rt_ssh_connect(host, port)
    SshSession(handle: handle, host: host, port: port, is_valid: is_valid_handle(handle))

@unsafe(reason: "unbacked SSH provider and session lifecycle", capabilities: [ffi])
fn ssh_disconnect(session: SshSession) -> bool:
    """Disconnect from SSH server"""
    if is_invalid_handle(session.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_disconnect(session.handle)

@unsafe(reason: "unbacked SSH provider and credential ABI", capabilities: [ffi])
fn ssh_auth_password(session: SshSession, username: text, password: text) -> bool:
    """Authenticate with username/password

    Args:
        username: SSH username
        password: SSH password

    Returns: true if authentication successful

    Example:
        if ssh_auth_password(session, "admin", "secret"):
            print "Authenticated successfully"
    """
    if is_invalid_handle(session.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_auth_password(session.handle, username, password)

@unsafe(reason: "unbacked SSH provider and key credential ABI", capabilities: [ffi])
fn ssh_auth_pubkey(session: SshSession, username: text, pubkey_path: text, privkey_path: text, passphrase: text) -> bool:
    """Authenticate with public key

    Args:
        username: SSH username
        pubkey_path: Path to public key file (e.g., ~/.ssh/id_rsa.pub)
        privkey_path: Path to private key file (e.g., ~/.ssh/id_rsa)
        passphrase: Key passphrase (empty if no passphrase)

    Returns: true if authentication successful

    Example:
        if ssh_auth_pubkey(session, "user", "~/.ssh/id_rsa.pub", "~/.ssh/id_rsa", ""):
            print "Authenticated with key"
    """
    if is_invalid_handle(session.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_auth_pubkey(session.handle, username, pubkey_path, privkey_path, passphrase)

@unsafe(reason: "unbacked SSH provider and agent credential ABI", capabilities: [ffi])
fn ssh_auth_agent(session: SshSession, username: text) -> bool:
    """Authenticate using SSH agent

    Args:
        username: SSH username

    Returns: true if authentication successful
    """
    if is_invalid_handle(session.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_auth_agent(session.handle, username)

# --- Remote Command Execution ---

@unsafe(reason: "unbacked SSH provider with unbounded ambiguous command output", capabilities: [ffi])
fn ssh_exec(session: SshSession, command: text) -> SshExecResult:
    """Execute command on remote server

    Args:
        command: Shell command to execute

    Returns: SshExecResult with exit code, stdout, stderr

    Example:
        result = ssh_exec(session, "ls -la /home")
        print "Output: {result.stdout}"
        print "Exit code: {result.exit_code}"
    """
    if is_invalid_handle(session.handle):
        return SshExecResult(exit_code: -1, stdout: "", stderr: "Invalid session")

    val result_tuple = unsafe(capabilities: [ffi]):
        rt_ssh_exec(session.handle, command)
    SshExecResult(exit_code: result_tuple.0, stdout: result_tuple.1, stderr: result_tuple.2)

@unsafe(reason: "unbacked SSH provider and channel ownership", capabilities: [ffi])
fn ssh_shell(session: SshSession) -> SshChannel:
    """Open interactive shell channel

    Returns: SshChannel for interactive commands
    """
    if is_invalid_handle(session.handle):
        return SshChannel(handle: 0, is_valid: false)

    val handle = unsafe(capabilities: [ffi]):
        rt_ssh_shell(session.handle)
    SshChannel(handle: handle, is_valid: is_valid_handle(handle))

@unsafe(reason: "unbacked SSH provider with ambiguous read result", capabilities: [ffi])
fn ssh_channel_read(channel: SshChannel) -> text:
    """Read data from channel"""
    if is_invalid_handle(channel.handle):
        return ""

    unsafe(capabilities: [ffi]):
        rt_ssh_channel_read(channel.handle)

@unsafe(reason: "unbacked SSH provider with unknown partial-write contract", capabilities: [ffi])
fn ssh_channel_write(channel: SshChannel, data: text) -> i64:
    """Write data to channel

    Returns: Number of bytes written
    """
    if is_invalid_handle(channel.handle):
        return 0

    unsafe(capabilities: [ffi]):
        rt_ssh_channel_write(channel.handle, data)

@unsafe(reason: "unbacked SSH provider and channel lifecycle", capabilities: [ffi])
fn ssh_channel_close(channel: SshChannel) -> bool:
    """Close channel"""
    if is_invalid_handle(channel.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_channel_close(channel.handle)

# --- SFTP File Transfer ---

@unsafe(reason: "unbacked SFTP provider and session ownership", capabilities: [ffi])
fn sftp_init(session: SshSession) -> SftpSession:
    """Initialize SFTP subsystem

    Args:
        session: Authenticated SSH session

    Returns: SftpSession for file operations

    Example:
        sftp = sftp_init(session)
        if sftp.is_valid:
            sftp_upload(sftp, "local.txt", "/remote/path.txt")
    """
    if is_invalid_handle(session.handle):
        return SftpSession(handle: 0, is_valid: false)

    val handle = unsafe(capabilities: [ffi]):
        rt_sftp_init(session.handle)
    SftpSession(handle: handle, is_valid: is_valid_handle(handle))

@unsafe(reason: "unbacked SFTP provider and session lifecycle", capabilities: [ffi])
fn sftp_shutdown(sftp: SftpSession) -> bool:
    """Shutdown SFTP subsystem"""
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_shutdown(sftp.handle)

@unsafe(reason: "unbacked SFTP provider and transfer contract", capabilities: [ffi])
fn sftp_upload(sftp: SftpSession, local_path: text, remote_path: text) -> bool:
    """Upload file to remote server

    Args:
        local_path: Local file to upload
        remote_path: Destination path on server

    Returns: true if successful

    Example:
        if sftp_upload(sftp, "/tmp/data.txt", "/home/user/data.txt"):
            print "Upload successful"
    """
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_upload(sftp.handle, local_path, remote_path)

@unsafe(reason: "unbacked SFTP provider and transfer contract", capabilities: [ffi])
fn sftp_download(sftp: SftpSession, remote_path: text, local_path: text) -> bool:
    """Download file from remote server

    Args:
        remote_path: Remote file to download
        local_path: Local destination path

    Returns: true if successful
    """
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_download(sftp.handle, remote_path, local_path)

@unsafe(reason: "unbacked SFTP provider and remote path/mode ABI", capabilities: [ffi])
fn sftp_mkdir(sftp: SftpSession, path: text, mode: i64) -> bool:
    """Create directory on remote server

    Args:
        path: Directory path
        mode: Permissions (e.g., 0o755)

    Returns: true if successful
    """
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_mkdir(sftp.handle, path, mode)

@unsafe(reason: "unbacked SFTP provider and destructive remote path ABI", capabilities: [ffi])
fn sftp_rmdir(sftp: SftpSession, path: text) -> bool:
    """Remove directory on remote server"""
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_rmdir(sftp.handle, path)

@unsafe(reason: "unbacked SFTP provider and destructive remote path ABI", capabilities: [ffi])
fn sftp_delete(sftp: SftpSession, path: text) -> bool:
    """Delete file on remote server"""
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_unlink(sftp.handle, path)

@unsafe(reason: "unbacked SFTP provider and remote rename ABI", capabilities: [ffi])
fn sftp_rename(sftp: SftpSession, src: text, dst: text) -> bool:
    """Rename/move file on remote server"""
    if is_invalid_handle(sftp.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_sftp_rename(sftp.handle, src, dst)

@unsafe(reason: "unbacked SFTP provider with ambiguous empty listing", capabilities: [ffi])
fn sftp_list(sftp: SftpSession, path: text) -> [text]:
    """List files in remote directory

    Args:
        path: Remote directory path

    Returns: Array of filenames

    Example:
        files = sftp_list(sftp, "/home/user")
        for file in files:
            print file
    """
    if is_invalid_handle(sftp.handle):
        return []

    val result = unsafe(capabilities: [ffi]):
        rt_sftp_readdir(sftp.handle, path)
    if result == "":
        return []

    result.split("\n")

@unsafe(reason: "unbacked SFTP provider with ambiguous metadata tuple", capabilities: [ffi])
fn sftp_stat(sftp: SftpSession, path: text) -> SftpFileInfo:
    """Get file information

    Args:
        path: Remote file path

    Returns: SftpFileInfo with size, mode, mtime
    """
    if is_invalid_handle(sftp.handle):
        return SftpFileInfo(size: 0, mode: 0, mtime: 0)

    val stats = unsafe(capabilities: [ffi]):
        rt_sftp_stat(sftp.handle, path)
    SftpFileInfo(size: stats.0, mode: stats.1, mtime: stats.2)

# --- Utilities ---

@unsafe(reason: "unbacked SSH provider and authentication-state ABI", capabilities: [ffi])
fn ssh_is_authenticated(session: SshSession) -> bool:
    """Check if session is authenticated"""
    if is_invalid_handle(session.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_is_authenticated(session.handle)

@unsafe(reason: "unbacked SSH provider with ambiguous empty banner", capabilities: [ffi])
fn ssh_get_banner(session: SshSession) -> text:
    """Get SSH server banner"""
    if is_invalid_handle(session.handle):
        return ""

    unsafe(capabilities: [ffi]):
        rt_ssh_get_banner(session.handle)

@unsafe(reason: "unbacked SSH provider and timeout mutation ABI", capabilities: [ffi])
fn ssh_set_timeout(session: SshSession, timeout_ms: i64) -> bool:
    """Set session timeout in milliseconds"""
    if is_invalid_handle(session.handle):
        return false

    unsafe(capabilities: [ffi]):
        rt_ssh_set_timeout(session.handle, timeout_ms)

