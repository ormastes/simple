pub use std.common.contracts.container.linux_fresh_workspace_v3.LinuxFreshWorkspaceBindingSnapshotV3

pub class LinuxFreshWorkspaceBindingV3:
    reader: LinuxMachinePolicyOwnerV1
    storage: LinuxMachineStorageV1
    lease: WorkspaceStorageLeaseV1
    exclusion: LinuxMachineWorkspaceExclusionV1
    parent_directory: RetainedDirectoryOwnerV1
    root_directory: RetainedDirectoryOwnerV1
    request_source: text
    manifest_source: text
    invocation_digest: text
    expected_binding: text

    pub fn current_v3() -> Result<LinuxFreshWorkspaceBindingSnapshotV3, text>:
        val observed = workspace_binding_observe_v3(self)?
        Ok(observed.snapshot)

    # The explicit workload kind of this binding, read only from the manifest's `kind` key.
    pub fn arm_v3() -> Result<LinuxWorkspaceArmV3, text>: linux_workspace_manifest_arm_v3(self.manifest_source)

    pub fn validate_command_v3(command: LinuxFreshWorkspaceCommandV3) -> Result<(), text>:
        val observed = workspace_binding_observe_v3(self)?
        if container_execution_request_encode_v2(command.command.request)? != self.request_source:
            return Err("fresh-workspace-binding-request-differs")
        linux_fresh_workspace_command_validate_v3(command, observed.workspace, observed.primary,
            self.invocation_digest, observed.snapshot.service_uid, observed.snapshot.service_gid)

    # Reconstruct fresh observation DATA from immutable canonical bytes, not
    # caller-shared argv/maps. This does not grant an operation or retirement.
    pub fn observation_command_v3(action: LinuxFreshWorkloadActionV2, native_id: text, helper_cpu_millis: i64,
            helper_memory_bytes: i64) -> Result<LinuxFreshWorkspaceCommandV3, text>:
        if action != LinuxFreshWorkloadActionV2.Inspect and action != LinuxFreshWorkloadActionV2.Absence:
            return Err("fresh-workspace-observation-action-required")
        val observed = workspace_binding_observe_v3(self)?
        val request = container_execution_request_decode_v2(self.request_source)?
        val projected = linux_fresh_workspace_request_v3(request, observed.workspace, observed.primary,
            self.invocation_digest, observed.snapshot.service_uid, observed.snapshot.service_gid)?
        val p = request.plan
        val scope = ContainerHostScopeV2(physical_host_id: p.physical_host_id, service_scope_id: p.service_scope_id,
            boot_id: p.boot_id, provider_generation: p.provider_generation, native_machine_id: p.native_machine_id,
            continuity_mode: p.continuity_mode, continuity_id: p.continuity_id)
        val command = LinuxFreshWorkspaceCommandV3(command: LinuxFreshWorkloadCommandV2(request: request, scope: scope,
            action: action, native_id: native_id, image: projected.image, entrypoint: projected.entrypoint, args: projected.args,
            cpu_millis: projected.cpu_millis, memory_bytes: projected.memory_bytes, pid_limit: projected.pid_limit,
            timeout_ms: projected.timeout_ms, helper_cpu_millis: helper_cpu_millis, helper_memory_bytes: helper_memory_bytes))
        self.validate_command_v3(command)?
        Ok(command)

    pub fn project_launch_v3(epoch: LinuxFreshEpochProfileV1, base: GroupProcessStreamLaunchV2,
            command: LinuxFreshWorkspaceCommandV3) -> Result<GroupProcessStreamLaunchV2, text>:
        self.validate_command_v3(command)?
        val observed = workspace_binding_observe_v3(self)?
        val result = linux_fresh_workspace_project_launch_v3(epoch, observed.workspace, observed.primary, self.invocation_digest,
            observed.snapshot.service_uid, observed.snapshot.service_gid, base, command)?
        val after = workspace_binding_observe_v3(self)?
        if after.snapshot.binding_digest != observed.snapshot.binding_digest: return Err("fresh-workspace-projection-custody-changed")
        Ok(result)

    pub fn validate_created_v3(epoch: LinuxFreshEpochProfileV1, command: LinuxFreshWorkspaceCommandV3, raw: text) -> Result<(), text>:
        self.validate_command_v3(command)?
        val observed = workspace_binding_observe_v3(self)?
        linux_fresh_workspace_created_config_validate_v3(observed.workspace, observed.primary, self.invocation_digest,
            observed.snapshot.service_uid, observed.snapshot.service_gid, command, raw)?
        val fields = linux_fresh_workspace_inspect_fields_v3(raw)?
        if linux_fresh_workload_inspect_text_v2(fields, "cgroup_parent")? != epoch.text_v1("delegatedCgroup")?:
            return Err("fresh-workspace-created-parent-not-held-delegation")
        var create = command.command
        create.action = LinuxFreshWorkloadActionV2.Create
        create.native_id = ""
        create.observed_image_id = ""
        val expected = [epoch.text_v1("providerExecutable")?] + linux_fresh_workspace_argv_v3(epoch, observed.workspace, observed.primary,
            self.invocation_digest, observed.snapshot.service_uid, observed.snapshot.service_gid, LinuxFreshWorkspaceCommandV3(command: create))?
        if linux_fresh_workload_inspect_strings_v2(fields, "create_command", 65)? != expected:
            return Err("fresh-workspace-created-command-not-exact-owned-projection")
        val after = workspace_binding_observe_v3(self)?
        if after.snapshot.binding_digest != observed.snapshot.binding_digest: return Err("fresh-workspace-created-custody-changed")
        Ok(())

    pub fn executable_profile_v3() -> Result<AgentExecutableProfileV1, text>:
        val current = workspace_binding_observe_v3(self)?
        val (_, executable) = workspace_binding_agent_v3(current)?
        Ok(executable)

    pub fn validate_invocation_v3(invocation_source: text, argv: [text]) -> Result<AgentWorkspaceInvocationManifestV2, text>:
        val invocation = workspace_binding_invocation_v3(self, invocation_source)?
        if argv != invocation.base.inner_argv: return Err("fresh-workspace-primary-not-exact-approved-native-agent")
        Ok(invocation)

    pub fn project_primary_attach_v3(epoch: LinuxFreshEpochProfileV1, base: GroupProcessStreamLaunchV2,
            attach: LinuxFreshWorkspacePrimaryAttachCommandV3) -> Result<GroupProcessStreamLaunchV2, text>:
        val _ = workspace_binding_agent_v3(workspace_binding_observe_v3(self)?)?
        self.validate_command_v3(attach.workspace)?
        if attach.workspace.command.action != LinuxFreshWorkloadActionV2.Inspect:
            return Err("fresh-workspace-primary-attach-inspect-identity-required")
        val invocation = workspace_binding_invocation_v3(self, attach.invocation_source)?
        var projected = self.project_launch_v3(epoch, base, attach.workspace)?
        var request = projected.request
        request.args = linux_fresh_workspace_engine_prefix_v3(epoch)? + ["attach", "--detach-keys=", "--sig-proxy=false", "--no-stdin=false", "--", attach.workspace.command.native_id]
        request.timeout_ms = invocation.base.workload_duration_ms # Signed transport bound, not payload completion.
        request.child_argv_digest = group_process_child_argv_digest_v2(request.program, request.args)
        projected.request = request
        val after = workspace_binding_observe_v3(self)?
        Ok(projected)

    pub fn validate_primary_v3(invocation_source: text, executable_digest: text, argv: [text]) -> Result<(), text>:
        val invocation = self.validate_invocation_v3(invocation_source, argv)?
        val actual = workspace_binding_observe_v3(self)?
        # Gap m: a build binding carries its producer digest in agent_digest; only an agent binding is read as agent.
        val _ = workspace_binding_agent_v3(actual)?
        if executable_digest != actual.snapshot.agent_digest: return Err("fresh-workspace-primary-not-exact-approved-native-agent")
        Ok(())

    # Restrictive DATA comparison only. The subject privately supplies actual
    # statx bytes from its retained guest mount, never a caller PID or receipt.
    pub fn validate_guest_identity_v3(identity: [u8]) -> Result<(), text>:
        val before = workspace_binding_observe_v3(self)?
        val _ = workspace_binding_agent_v3(before)?
        val native = workspace_storage_observe_v1(self.lease)?
        linux_workspace_retained_native_match_v1(identity, native.workspace_id)?
        val after = workspace_binding_observe_v3(self)?
        if after.snapshot.binding_digest != before.snapshot.binding_digest: return Err("fresh-workspace-guest-custody-changed")
        Ok(())

# Internal immutable observation values never cross as ownership or grants.
struct WorkspaceBindingObservedV3:
    snapshot: LinuxFreshWorkspaceBindingSnapshotV3
    workspace: LinuxWorkspaceInstalledProfileV1
    primary: LinuxWorkspacePrimaryV3
    executable_profile: Option<AgentExecutableProfileV1>

# Agent-only operations (attach, invocation/primary/guest validation, executable profile)
# refuse the remote-build arm (DESIGN 14.3 item 4).
fn workspace_binding_agent_v3(observed: WorkspaceBindingObservedV3) -> Result<(LinuxAgentWorkspaceProfileV1, AgentExecutableProfileV1), text>:
    match observed.primary:
        case LinuxWorkspacePrimaryV3.Agent(agent):
            if observed.executable_profile.is_none(): return Err("fresh-workspace-agent-arm-required")
            Ok((agent, observed.executable_profile.unwrap()))
        case LinuxWorkspacePrimaryV3.RemoteBuild(_): Err("fresh-workspace-agent-arm-required")

fn workspace_binding_invocation_v3(owner: LinuxFreshWorkspaceBindingV3, invocation_source: text) -> Result<AgentWorkspaceInvocationManifestV2, text>:
    val before = workspace_binding_observe_v3(owner)?
    val (agent, executable_profile) = workspace_binding_agent_v3(before)?
    if sha256_text(invocation_source) != owner.invocation_digest: return Err("fresh-workspace-primary-invocation-binding")
    val invocation = agent_workspace_invocation_manifest_decode_v2(invocation_source)?
    if agent_workspace_invocation_manifest_encode_v2(invocation)? != invocation_source or invocation.base.workspace_manifest != owner.manifest_source:
        return Err("fresh-workspace-primary-canonical-invocation")
    if agent_executable_profile_encode_v1(invocation.executable_profile)? != agent_executable_profile_encode_v1(executable_profile)?:
        return Err("fresh-workspace-primary-executable-policy-mismatch")
    val expected_image = if agent.image_config_id.starts_with("sha256:"): agent.image_config_id.substring(7, agent.image_config_id.byte_len()) else: agent.image_config_id
    val observed_image = if invocation.base.image_config_id.starts_with("sha256:"): invocation.base.image_config_id.substring(7, invocation.base.image_config_id.byte_len()) else: invocation.base.image_config_id
    if (invocation.base.inner_argv.len() < 2 or invocation.base.inner_argv[0] != agent.agent_program or expected_image != observed_image):
        return Err("fresh-workspace-primary-not-exact-approved-native-agent")
    val after = workspace_binding_observe_v3(owner)?
    if after.snapshot.binding_digest != before.snapshot.binding_digest: return Err("fresh-workspace-primary-custody-changed")
    Ok(invocation)


fn workspace_binding_utf8_v3(bytes: [u8]) -> Result<text, text>:
    if bytes.len() < 1 or not utf8_bytes_valid(bytes): return Err("fresh-workspace-profile-utf8")
    Ok(bytes_to_text(bytes))

fn workspace_binding_observe_v3(owner: LinuxFreshWorkspaceBindingV3) -> Result<WorkspaceBindingObservedV3, text>:
    linux_machine_process_origin_check_v1()?
    val before = owner.reader.actual_process_context_v1()?
    val machine_source = workspace_binding_utf8_v3(owner.reader.read_policy_v1()?)?
    if workspace_binding_utf8_v3(owner.storage.policy_bytes_v1()?)? != machine_source:
        return Err("fresh-workspace-original-writer-policy-mismatch")
    val machine_digest = sha256_text(machine_source)
    val machine = machine_container_policy_decode_v1(machine_source)?
    val workspace_source = workspace_binding_utf8_v3(owner.reader.read_workspace_profile_v1()?)?
    val workspace = linux_workspace_installed_profile_decode_v1(workspace_source)?
    val arm = linux_workspace_manifest_arm_v3(owner.manifest_source)?
    val request = container_execution_request_decode_v2(owner.request_source)?
    if workspace.machine_policy_digest != machine_digest: return Err("fresh-workspace-installed-profile-chain")
    val bound = workspace_binding_primary_v3(owner, arm, machine_digest, workspace_source, workspace)?
    var provider_digest = ""
    for provider in machine.providers:
        if provider.backend == "linux-podman": provider_digest = sha256_text(provider.policy_bytes)
    if provider_digest == "" or provider_digest != workspace.provider_policy_digest:
        return Err("fresh-workspace-installed-provider-binding")
    val boot = owner.reader.actual_boot_id_v2()?
    val plan = request.plan
    if (plan.physical_host_id != machine.physical_host_id or plan.native_machine_id != machine.native_machine_id or
            plan.boot_id != boot or plan.continuity_id != boot or plan.continuity_mode != "native-boot-incarnation-v1"):
        return Err("fresh-workspace-installed-machine-scope")
    if before.real_uid != before.effective_uid or before.effective_uid <= 0:
        return Err("fresh-workspace-actual-service-uid")
    # GID is derived from the actual Linux context, never from lease metadata.
    val gid = workspace_binding_gid_v3()
    if gid.is_err(): return Err(gid.unwrap_err())
    val supported = linux_fresh_workspace_request_v3(request, workspace, bound.primary, owner.invocation_digest, before.effective_uid, gid.unwrap())?
    if supported.memory_bytes < bound.memory_minimum_bytes:
        return Err("fresh-workspace-request-memory-below-approved-executable-profile")
    val native = workspace_storage_observe_v1(owner.lease)?
    val expected = workspace_storage_binding_v1(linux_workspace_storage_request_v1(workspace))?
    if (workspace_storage_binding_v1(owner.lease.request)? != expected or native.binding_digest != expected or
            native.state != "retained" or bound.slot_binding_digest != expected):
        return Err("fresh-workspace-live-native-lease-binding")
    val excluded = owner.exclusion.current_v1()?
    if excluded.machine_policy_digest != machine_digest or excluded.lease_binding_digest != expected:
        return Err("fresh-workspace-original-exclusion-binding")
    owner.parent_directory.stage_child_match_v1(workspace.leaf_name, owner.root_directory)?
    val parent_identity = owner.parent_directory.stage_identity_v1()?
    val root_identity = owner.root_directory.stage_identity_v1()?
    linux_workspace_retained_native_match_v1(root_identity, native.workspace_id)?
    val directory_digest = sha256_u8_hex(parent_identity + root_identity)
    val image_id = if bound.image_config_id.starts_with("sha256:"): bound.image_config_id.substring(7, bound.image_config_id.byte_len()) else: bound.image_config_id
    if not builder_digest_valid_v1(image_id): return Err("fresh-workspace-full-image-config-id-required")
    var snapshot = LinuxFreshWorkspaceBindingSnapshotV3(binding_digest: "", machine_policy_digest: machine_digest,
        provider_policy_digest: provider_digest, workspace_profile_digest: sha256_text(workspace_source),
        agent_profile_digest: sha256_text(bound.profile_source), request_digest: plan.request_digest,
        manifest_digest: sha256_text(owner.manifest_source), invocation_digest: owner.invocation_digest,
        lease_binding_digest: expected, workspace_identity_digest: excluded.workspace_identity_digest,
        directory_binding_digest: directory_digest, source_manifest_digest: bound.source_manifest_digest,
        bootstrap_digest: bound.bootstrap_digest, git_digest: bound.git_digest, agent_digest: bound.agent_digest,
        image_config_id: bound.image_config_id, service_uid: before.effective_uid, service_gid: gid.unwrap())
    snapshot.binding_digest = linux_fresh_workspace_binding_digest_v3(arm, snapshot, owner.request_source, owner.manifest_source)
    if owner.expected_binding != "" and snapshot.binding_digest != owner.expected_binding:
        return Err("fresh-workspace-original-binding-changed")
    owner.parent_directory.stage_child_match_v1(workspace.leaf_name, owner.root_directory)?
    val after_native = workspace_storage_observe_v1(owner.lease)?
    linux_workspace_retained_native_match_v1(owner.root_directory.stage_identity_v1()?, after_native.workspace_id)?
    val after_excluded = owner.exclusion.current_v1()?
    val after = owner.reader.actual_process_context_v1()?
    if (after.identity_digest != before.identity_digest or after.generation != before.generation or
            after_native.binding_digest != native.binding_digest or after_native.workspace_id != native.workspace_id or
            after_native.state != "retained" or after_excluded != excluded or
            owner.parent_directory.stage_identity_v1()? != parent_identity or owner.root_directory.stage_identity_v1()? != root_identity):
        return Err("fresh-workspace-current-native-custody-changed")
    if (workspace_binding_utf8_v3(owner.reader.read_workspace_profile_v1()?)? != workspace_source or
            workspace_binding_profile_source_v3(owner, arm)? != bound.profile_source or
            workspace_binding_utf8_v3(owner.storage.policy_bytes_v1()?)? != machine_source):
        return Err("fresh-workspace-installed-bytes-changed")
    Ok(WorkspaceBindingObservedV3(snapshot: snapshot, workspace: workspace, primary: bound.primary, executable_profile: bound.executable_profile))

# The installed primary-profile source for the manifest-selected arm.
fn workspace_binding_profile_source_v3(owner: LinuxFreshWorkspaceBindingV3, arm: LinuxWorkspaceArmV3) -> Result<text, text>:
    if arm == LinuxWorkspaceArmV3.Agent: return owner.reader.read_agent_workspace_profile_v1()
    owner.reader.read_build_workspace_profile_v1()

# Arm-specific half of the observation. The snapshot shape is shared: the RemoteBuild arm puts
# the build profile digest where the agent arm puts the agent profile digest, the input-manifest
# digest in `source_manifest_digest`, the task digest in `bootstrap_digest`, the build profile
# digest again in `git_digest` and the producer digest in `agent_digest`. Every slot stays a real
# digest, as machine_fresh_workspace_binding_bytes_v3 requires.
struct WorkspaceBindingPrimaryV3:
    primary: LinuxWorkspacePrimaryV3
    executable_profile: Option<AgentExecutableProfileV1>
    profile_source: text
    slot_binding_digest: text
    memory_minimum_bytes: i64
    source_manifest_digest: text
    bootstrap_digest: text
    git_digest: text
    agent_digest: text
    image_config_id: text

fn workspace_binding_primary_v3(owner: LinuxFreshWorkspaceBindingV3, arm: LinuxWorkspaceArmV3, machine_digest: text,
        workspace_source: text, workspace: LinuxWorkspaceInstalledProfileV1) -> Result<WorkspaceBindingPrimaryV3, text>:
    if arm == LinuxWorkspaceArmV3.Agent:
        val agent_source = owner.reader.read_agent_workspace_profile_v1()?
        val approved = linux_agent_workspace_profile_decode_v2(agent_source)?
        val agent = approved.base
        val manifest = agent_workspace_manifest_decode_v1(owner.manifest_source)?
        if (agent.machine_policy_digest != machine_digest or
                agent.workspace_profile_digest != sha256_text(workspace_source) or manifest.profile_digest != sha256_text(agent_source)):
            return Err("fresh-workspace-installed-profile-chain")
        linux_agent_workspace_profile_match_v2(approved, manifest)?
        if linux_workspace_paths_overlap_v1(agent.assets_root, linux_workspace_source_root_v1(workspace)):
            return Err("fresh-workspace-assets-overlap")
        return Ok(WorkspaceBindingPrimaryV3(primary: LinuxWorkspacePrimaryV3.Agent(agent), executable_profile: Some(approved.executable_profile),
            profile_source: agent_source, slot_binding_digest: manifest.slot_binding_digest,
            memory_minimum_bytes: agent_executable_profile_minimum_memory_v1(approved.executable_profile)?,
            source_manifest_digest: manifest.source_manifest_digest, bootstrap_digest: manifest.bootstrap_digest,
            git_digest: manifest.git_digest, agent_digest: manifest.agent_digest, image_config_id: agent.image_config_id))
    val build_source = owner.reader.read_build_workspace_profile_v1()?
    val build = linux_build_workspace_profile_decode_v1(build_source)?
    val manifest = build_workspace_manifest_decode_v1(owner.manifest_source)?
    if (build.machine_policy_digest != machine_digest or
            build.workspace_profile_digest != sha256_text(workspace_source) or manifest.profile_digest != sha256_text(build_source)):
        return Err("fresh-workspace-installed-profile-chain")
    # Gap m (lane A review P2-4): the build arm reuses the shared snapshot layout so agent record bytes are unchanged:
    # sourceManifest = input manifest, bootstrap = task, git = profile, agent = producer digest. These are bound under
    # the build binding kind; every agent-semantic reader passes workspace_binding_agent_v3 first.
    Ok(WorkspaceBindingPrimaryV3(primary: LinuxWorkspacePrimaryV3.RemoteBuild(build), executable_profile: None,
        profile_source: build_source, slot_binding_digest: manifest.slot_binding_digest,
        memory_minimum_bytes: build.memory_minimum_bytes, source_manifest_digest: manifest.input_manifest_digest,
        bootstrap_digest: manifest.task_digest, git_digest: manifest.profile_digest, agent_digest: manifest.producer_digest,
        image_config_id: build.image_config_id))

@when(os="linux"):
use std.nogc_sync_mut.io.linux_machine_policy_abi_v1.{getgid, getegid}
@unsafe(reason: "actual real/effective service GID; no caller-supplied identity", capabilities: [ffi])
fn workspace_binding_gid_v3() -> Result<i64, text>:
    val real = getgid() as i64
    val effective = getegid() as i64
    if real <= 0 or real != effective: return Err("fresh-workspace-actual-service-gid")
    Ok(real)
@else:
fn workspace_binding_gid_v3() -> Result<i64, text>: Err("fresh-workspace-linux-required")
@end

pub fn linux_fresh_workspace_binding_open_v3(reader: LinuxMachinePolicyOwnerV1, storage: LinuxMachineStorageV1,
        lease: WorkspaceStorageLeaseV1, exclusion: LinuxMachineWorkspaceExclusionV1,
        parent_directory: RetainedDirectoryOwnerV1, root_directory: RetainedDirectoryOwnerV1,
        request: ContainerExecutionRequestV2, manifest_bytes: text, invocation_digest: text) -> Result<LinuxFreshWorkspaceBindingV3, text>:
    if not builder_digest_valid_v1(invocation_digest): return Err("fresh-workspace-invocation-digest")
    val source = container_execution_request_encode_v2(request)?
    match linux_workspace_manifest_arm_v3(manifest_bytes)?:
        case LinuxWorkspaceArmV3.Agent:
            val manifest = agent_workspace_manifest_decode_v1(manifest_bytes)?
            if agent_workspace_manifest_encode_v1(manifest)? != manifest_bytes: return Err("fresh-workspace-manifest-canonical")
        case LinuxWorkspaceArmV3.RemoteBuild:
            val manifest = build_workspace_manifest_decode_v1(manifest_bytes)?
            if build_workspace_manifest_encode_v1(manifest)? != manifest_bytes: return Err("fresh-workspace-manifest-canonical")
    val candidate = LinuxFreshWorkspaceBindingV3(reader: reader, storage: storage, lease: lease, exclusion: exclusion,
        parent_directory: parent_directory, root_directory: root_directory, request_source: source,
        manifest_source: manifest_bytes, invocation_digest: invocation_digest, expected_binding: "")
    val current = candidate.current_v3()?
    Ok(LinuxFreshWorkspaceBindingV3(reader: reader, storage: storage, lease: lease, exclusion: exclusion,
        parent_directory: parent_directory, root_directory: root_directory, request_source: source,
        manifest_source: manifest_bytes, invocation_digest: invocation_digest, expected_binding: current.binding_digest))
