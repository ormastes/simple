# Explicit AMFI image binding with a cooperative process-group lifecycle.
# expected_sha256 must come from the caller's authenticated artifact manifest.
# The native owner authenticates captured bytes, provisions an ad-hoc signature
# in memory, strips entitlements, allows only system libraries, and binds the
# resulting CDHash at launch. Thin native Mach-O only; maximum 256 MiB.
# No strict descendant containment, cumulative tree accounting or V4 admission.
# Uses private AMFI SPI; missing host prerequisites fail before source acquisition.
@unsafe(reason: "native authenticated Darwin image admission; no interpreter authority", capabilities: [ffi])
extern fn rt_sosix_darwin_bound_image_v1_start_value(expected_sha256: text, invocation: [text], environment: [text], limits: [i64]) -> [i64]

# invocation=[absolute executable,cwd,args...]; complete explicit environment.
# limits=[wall_ns,term_grace_ns,cleanup_ns,stdout_cap,stderr_cap].
# Returns [version,error,opaque_handle]. Successful handles use the existing
# darwin_snapshot_poll/cancel/output/ack lifecycle; a handle is never a PID.
pub fn darwin_bound_image_start(expected_sha256: text, invocation: [text], environment: [text], limits: [i64]) -> [i64]:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_bound_image_v1_start_value(expected_sha256, invocation, environment, limits)
