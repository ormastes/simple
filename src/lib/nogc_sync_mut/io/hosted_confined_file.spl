# Canonical hosted descriptor-relative file capability owner.
#
# Root and file descriptors are linear resources: callers must close every
# non-negative handle exactly once. Array offsets avoid slices/copies on the
# post-seal path; the native boundary validates the complete region again.

@unsafe(reason: "pins an OS directory descriptor as file capability authority", capabilities: [ffi])
extern fn rt_hosted_confined_root_open(path: text) -> i64
@unsafe(reason: "opens a regular file beneath a pinned directory without following links", capabilities: [ffi])
extern fn rt_hosted_confined_file_open(root_fd: i64, path: [u8],
    path_offset: i64, path_length: i64, access: i64) -> i64
@unsafe(reason: "writes into a checked caller-owned byte region from a pinned file descriptor", capabilities: [ffi])
extern fn rt_hosted_confined_file_read_at(fd: i64, file_offset: i64,
    out: [u8], out_offset: i64, capacity: i64) -> i64
@unsafe(reason: "reads a checked caller-owned byte region into a pinned file descriptor", capabilities: [ffi])
extern fn rt_hosted_confined_file_write_at(fd: i64, file_offset: i64,
    bytes: [u8], bytes_offset: i64, length: i64) -> i64
@unsafe(reason: "consumes an owned hosted file or capability-root descriptor", capabilities: [ffi])
extern fn rt_hosted_confined_file_close(fd: i64) -> bool

fn hosted_confined_root_open(path: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_hosted_confined_root_open(path)

fn hosted_confined_file_open(root_fd: i64, path: [u8],
        path_offset: i64, path_length: i64, writable: bool) -> i64:
    unsafe(capabilities: [ffi]):
        rt_hosted_confined_file_open(root_fd, path, path_offset,
            path_length, if writable: 1 else: 0)

fn hosted_confined_file_read_at(fd: i64, file_offset: i64,
        out: [u8], out_offset: i64, capacity: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_hosted_confined_file_read_at(
            fd, file_offset, out, out_offset, capacity)

fn hosted_confined_file_write_at(fd: i64, file_offset: i64,
        bytes: [u8], bytes_offset: i64, length: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_hosted_confined_file_write_at(
            fd, file_offset, bytes, bytes_offset, length)

fn hosted_confined_file_close(fd: i64) -> bool:
    unsafe(capabilities: [ffi]):
        rt_hosted_confined_file_close(fd)

export hosted_confined_root_open, hosted_confined_file_open
export hosted_confined_file_read_at, hosted_confined_file_write_at
export hosted_confined_file_close
