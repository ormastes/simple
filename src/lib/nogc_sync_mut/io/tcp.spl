use std.common.encoding.external_text.{utf8_format}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_external_text, io_external_from_internal, io_external_bytes, io_internal_text, io_text_error_message, io_legacy_utf8}

# Sync TCP I/O
#
# TCP listener and stream implementing Read, Write, Close traits.
# Provides reliable, connection-oriented network I/O.

use std.io.traits.{Read, Write, Close}
use std.io.types.{IoError, IoErrorKind, Shutdown}
use std.nogc_sync_mut.io.byte_append.{io_append_chunk}
use std.nogc_sync_mut.sosix.network.{
    sosix_tcp_accept,
    sosix_tcp_accept_timeout,
    sosix_tcp_bind,
    sosix_tcp_bind_fd,
    sosix_tcp_close,
    sosix_tcp_connect,
    sosix_tcp_connect_timeout,
    sosix_tcp_flush,
    sosix_tcp_listen,
    sosix_tcp_local_addr,
    sosix_tcp_read,
    sosix_tcp_peer_addr,
    sosix_tcp_set_nodelay,
    sosix_tcp_set_nonblocking,
    sosix_tcp_set_read_timeout,
    sosix_tcp_set_reuseaddr,
    sosix_tcp_set_reuseport,
    sosix_tcp_set_write_timeout,
    sosix_tcp_socket_create,
    sosix_tcp_shutdown,
    sosix_tcp_write,
    sosix_tcp_write_text
}
fn tcp_packed_window(data: [u8], start: i64, end: i64) -> Result<[u8], IoError>:
    # Plain element array: the hosted interpreter marshals generic [u8]
    # arrays across rt_io_tcp_write, while runtime-packed byte buffers
    # (rt_byte_array_new carriers) are not admitted by that boundary.
    var result: [u8] = []
    for index in start..end:
        val byte = data[index]
        val value = byte as i64
        if value < 0 or value > 255:
            return Err(IoError(kind: IoErrorKind.InvalidInput, message: "TCP byte value outside octet range", source: nil))
        result.push(byte)
    Ok(result)

# ============================================================================
# TcpListener - TCP Server Socket
# ============================================================================

class TcpListener with Close:
    """TCP server socket.

    Listens for incoming connections and produces TcpStream handles.

    Example:
        val listener = TcpListener.bind("127.0.0.1:8080")?
        while true:
            val stream = listener.accept()?
            handle_client(stream)
    """
    fd: i64
    open: bool

    pub static fn bind(addr: text) -> Result<TcpListener, IoError>:
        """Bind to address and start listening.

        Args:
            addr: Address in format "host:port"

        Returns:
            Result with TcpListener or error
        """
        val fd = unsafe(capabilities: [ffi]):
            sosix_tcp_bind(addr)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.AddrInUse, message: "bind failed: {addr}", source: nil))
        Ok(TcpListener(fd: fd, open: true))

    fn accept() -> Result<TcpStream, IoError>:
        """Accept incoming connection (blocks).

        Returns:
            Result with connected TcpStream
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "listener is closed", source: nil))
        val client_fd = unsafe(capabilities: [ffi]):
            sosix_tcp_accept(self.fd)
        if client_fd < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "accept failed", source: nil))
        Ok(TcpStream(fd: client_fd, open: true))

    pub fn accept_timeout(ms: i64) -> Result<TcpStream, IoError>:
        """Accept with timeout.

        Args:
            ms: Timeout in milliseconds

        Returns:
            Result with TcpStream or TimedOut error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "listener is closed", source: nil))
        val client_fd = unsafe(capabilities: [ffi]):
            sosix_tcp_accept_timeout(self.fd, ms)
        if client_fd < 0:
            return Err(IoError(kind: IoErrorKind.TimedOut, message: "accept timed out", source: nil))
        Ok(TcpStream(fd: client_fd, open: true))

    fn accept_fd() -> i64:
        """Accept and return the scalar native descriptor.

        Native Phase-3 consumers use this boundary when an aggregate
        ``Result<TcpStream, IoError>`` return is not ABI-safe.  Negative values
        retain the runtime accept failure convention.
        """
        if not self.open:
            return -1
        unsafe(capabilities: [ffi]):
            sosix_tcp_accept(self.fd)

    fn accept_fd_timeout(ms: i64) -> i64:
        """Accept with timeout and return only the scalar descriptor."""
        if not self.open:
            return -1
        unsafe(capabilities: [ffi]):
            sosix_tcp_accept_timeout(self.fd, ms)

    pub fn local_addr() -> Result<text, IoError>:
        """Get local bound address.

        Returns:
            Result with address string
        """
        val addr = unsafe(capabilities: [ffi]):
            sosix_tcp_local_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "local_addr failed", source: nil))
        Ok(addr)

    # --- Close trait ---

    pub me fn close() -> Result<(), IoError>:
        """Close listener."""
        if not self.open:
            return Ok(())
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_close(self.fd)
        self.open = false
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "close failed", source: nil))
        Ok(())

    pub fn is_open() -> bool:
        """Check if listener is open."""
        self.open

# ============================================================================
# TcpStream - TCP Connection
# ============================================================================

class TcpStream with Read, Write, Close:
    """Bidirectional TCP connection.

    Implements Read, Write, Close for stream-oriented I/O.

    Example:
        val stream = TcpStream.connect("example.com:80")?
        stream.write_text("GET / HTTP/1.1\\r\\nHost: example.com\\r\\n\\r\\n")?
        val response = stream.read_text()?
        stream.close()?
    """
    fd: i64
    open: bool

    static fn from_accepted_fd(fd: i64) -> TcpStream:
        TcpStream(fd: fd, open: fd >= 0)

    static fn connect_fd_timeout(addr: text, ms: i64) -> i64:
        """Connect and return only the scalar native descriptor.

        Phase-3 native leaf clients use this boundary instead of returning an
        aggregate ``Result<TcpStream, IoError>`` across the runtime call.
        """
        unsafe(capabilities: [ffi]):
            sosix_tcp_connect_timeout(addr, ms)

    static fn connect(addr: text) -> Result<TcpStream, IoError>:
        """Connect to remote address.

        Args:
            addr: Address in "host:port" format

        Returns:
            Result with connected TcpStream
        """
        val fd = unsafe(capabilities: [ffi]):
            sosix_tcp_connect(addr)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.ConnectionRefused, message: "connect failed: {addr}", source: nil))
        Ok(TcpStream(fd: fd, open: true))

    pub static fn connect_timeout(addr: text, ms: i64) -> Result<TcpStream, IoError>:
        """Connect with timeout.

        Args:
            addr: Address in "host:port" format
            ms: Timeout in milliseconds

        Returns:
            Result with TcpStream or TimedOut error
        """
        val fd = unsafe(capabilities: [ffi]):
            sosix_tcp_connect_timeout(addr, ms)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.TimedOut, message: "connect timed out: {addr}", source: nil))
        Ok(TcpStream(fd: fd, open: true))

    # --- Read trait ---

    pub fn read(size: i64) -> Result<[u8], IoError>:
        """Read up to size bytes from stream.

        Args:
            size: Maximum bytes to read

        Returns:
            Result with bytes read (may be fewer than size)
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val data = unsafe(capabilities: [ffi]):
            sosix_tcp_read(self.fd, size)
        if data == nil:
            return Err(IoError(kind: IoErrorKind.ConnectionReset, message: "read failed", source: nil))
        Ok(data!)

    pub fn read_exact(size: i64) -> Result<[u8], IoError>:
        """Read exactly size bytes.

        Args:
            size: Exact bytes to read

        Returns:
            Result with bytes, or error if stream ends early
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var buf: [u8] = []
        var remaining = size
        while remaining > 0:
            val chunk = unsafe(capabilities: [ffi]):
                sosix_tcp_read(self.fd, remaining)
            if chunk == nil:
                return Err(IoError(kind: IoErrorKind.ConnectionReset, message: "read_exact failed", source: nil))
            if chunk!.len() == 0:
                return Err(IoError(kind: IoErrorKind.UnexpectedEof, message: "read_exact: got {buf.len()} of {size} bytes", source: nil))
            val _copied = io_append_chunk(buf, chunk!)
            remaining = remaining - chunk!.len()
        Ok(buf)

    pub fn read_bytes(count: i32) -> Result<text, IoError>:
        """Read exactly `count` bytes and decode as text.

        Used by the HTTP parser for a `Content-Length` body, which is
        defined as an exact byte count (not "read until EOF" like
        `read_text`/`read_all`). Thin wrapper over `read_exact` +
        strict UTF8 admission so callers that already have a byte count from a
        header don't need to convert bytes themselves.

        Args:
            count: exact number of bytes to read

        Returns:
            Result with the bytes decoded as text, or an error if the
            stream ended before `count` bytes arrived
        """
        if count < 0:
            return Err(tcp_text_io_error(TextIoError.Io("negative external text frame length")))
        val bytes = self.read_exact(count.to_i64())?
        val external = match io_external_text(bytes, utf8_format()):
            case Ok(value): value
            case Err(error): return Err(tcp_text_io_error(error))
        match io_internal_text(external):
            case Ok(value): Ok(value)
            case Err(error): Err(tcp_text_io_error(error))

    fn read_all() -> Result<[u8], IoError>:
        """Read all available bytes until EOF.

        Returns:
            Result with all bytes
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var buf: [u8] = []
        while true:
            val chunk = unsafe(capabilities: [ffi]):
                sosix_tcp_read(self.fd, 8192)
            if chunk == nil:
                return Err(IoError(kind: IoErrorKind.ConnectionReset, message: "read_all failed", source: nil))
            if chunk!.len() == 0:
                break
            val _copied = io_append_chunk(buf, chunk!)
        Ok(buf)

    pub fn read_text() -> Result<text, IoError>:
        """Read all available content as text.

        Returns:
            Result with text
        """
        val bytes = self.read_all()?
        tcp_legacy_utf8(bytes)

    pub fn read_line() -> Result<text, IoError>:
        self.read_line_bounded(9223372036854775807)

    pub fn read_line_nullable() -> text?:
        match self.read_line():
            case Ok(value): value
            case Err(_): nil

    pub fn read_line_bounded(max_bytes: i64) -> Result<text, IoError>:
        """Read one line, but fail closed once more than max_bytes have
        arrived without a newline, instead of buffering an unbounded amount
        of attacker-controlled input.

        Args:
            max_bytes: maximum line length (including the trailing newline)
                before this read is treated as a connection-fatal error

        Returns:
            Result with the line (including newline) on success, or an
            error if the stream ended with no data or the bound was crossed
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var buf: [u8] = []
        while true:
            val chunk = unsafe(capabilities: [ffi]):
                sosix_tcp_read(self.fd, 1)
            if chunk == nil:
                return Err(IoError(kind: IoErrorKind.ConnectionReset, message: "read_line failed", source: nil))
            if chunk!.len() == 0:
                if buf.len() == 0:
                    return Err(IoError(kind: IoErrorKind.UnexpectedEof, message: "end of stream", source: nil))
                break
            val _copied = io_append_chunk(buf, chunk!)
            if buf.len() > max_bytes:
                return Err(IoError(kind: IoErrorKind.Other, message: "line exceeds max_bytes ({max_bytes})", source: nil))
            if chunk![0] == 10:
                break
        tcp_legacy_utf8(buf)

    pub fn read_line_or_empty() -> text:
        match self.read_line():
            case Ok(value): value
            case Err(_): ""

    pub fn read_bytes_or_empty(count: i32) -> text:
        match self.read_bytes(count):
            case Ok(value): value
            case Err(_): ""

    # --- Write trait ---

    pub fn write(data: [u8]) -> Result<i64, IoError>:
        """Write bytes, returning number written.

        Args:
            data: Bytes to write

        Returns:
            Result with bytes written count
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        if data.len() == 0: return Ok(0)
        # [u8] may be generic word storage. Retain an actual packed carrier
        # for this one synchronous call; preserve partial-write semantics.
        val packed = tcp_packed_window(data, 0, data.len())?
        val written = unsafe(capabilities: [ffi]):
            sosix_tcp_write(self.fd, packed)
        if written < 0 or written > data.len():
            return Err(IoError(kind: IoErrorKind.BrokenPipe, message: "write failed", source: nil))
        Ok(written)

    pub fn write_all(data: [u8]) -> Result<(), IoError>:
        """Write all bytes.

        Args:
            data: Bytes to write

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var offset = 0
        while offset < data.len():
            # Bounded packed windows: generic [u8] has word-backed storage.
            # No raw pointer/view API exists here; partial progress repacks at
            # most 8192 bytes, never the whole remaining payload.
            val remaining = data.len() - offset
            val count = if remaining > 8192: 8192 else: remaining
            val window = tcp_packed_window(data, offset, offset + count)?
            val written = unsafe(capabilities: [ffi]):
                sosix_tcp_write(self.fd, window)
            if written <= 0 or written > count:
                return Err(IoError(kind: IoErrorKind.BrokenPipe, message: "write_all failed", source: nil))
            offset = offset + written
        Ok(())

    pub fn write_text(s: text) -> Result<(), IoError>:
        # Text goes through the registered rt_io_tcp_write_text boundary; the
        # hosted interpreter does not admit packed/runtime byte arrays through
        # rt_io_tcp_write's byte marshalling.
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val written = unsafe(capabilities: [ffi]):
            sosix_tcp_write_text(self.fd, s)
        if written < 0:
            return Err(IoError(kind: IoErrorKind.BrokenPipe, message: "write_text failed", source: nil))
        Ok(())

    pub fn write_text_status(s: text) -> bool:
        match self.write_text(s):
            case Ok(_): true
            case Err(_): false

    fn flush() -> Result<(), IoError>:
        """Flush write buffer.

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_flush(self.fd)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "flush failed", source: nil))
        Ok(())

    # --- Close trait ---

    pub me fn close() -> Result<(), IoError>:
        """Close stream."""
        if not self.open:
            return Ok(())
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_close(self.fd)
        self.open = false
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "close failed", source: nil))
        Ok(())

    me close_status() -> bool:
        """Close the stream and return a scalar success flag."""
        if not self.open:
            return true
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_close(self.fd)
        self.open = false
        ok

    pub fn is_open() -> bool:
        """Check if stream is open."""
        self.open

    # --- TCP-specific ---

    fn peer_addr() -> Result<text, IoError>:
        """Get remote peer address.

        Returns:
            Result with address string
        """
        val addr = unsafe(capabilities: [ffi]):
            sosix_tcp_peer_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "peer_addr failed", source: nil))
        Ok(addr)

    pub fn local_addr() -> Result<text, IoError>:
        """Get local address.

        Returns:
            Result with address string
        """
        val addr = unsafe(capabilities: [ffi]):
            sosix_tcp_local_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "local_addr failed", source: nil))
        Ok(addr)

    fn set_nodelay(enabled: bool) -> Result<(), IoError>:
        """Set TCP_NODELAY (disable Nagle's algorithm).

        Args:
            enabled: true to disable Nagle

        Returns:
            Result or error
        """
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_set_nodelay(self.fd, enabled)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_nodelay failed", source: nil))
        Ok(())

    pub fn set_read_timeout(ms: i64?) -> Result<(), IoError>:
        """Set read timeout.

        Args:
            ms: Timeout in ms, or nil for no timeout

        Returns:
            Result or error
        """
        val raw_ms = if ms.?: ms.unwrap() else: -1
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_set_read_timeout(self.fd, raw_ms)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_read_timeout failed", source: nil))
        Ok(())

    fn set_read_timeout_status(ms: i64) -> bool:
        """Set a finite read timeout with a scalar native result."""
        if not self.open:
            return false
        unsafe(capabilities: [ffi]):
            sosix_tcp_set_read_timeout(self.fd, ms)

    pub fn set_write_timeout(ms: i64?) -> Result<(), IoError>:
        """Set write timeout.

        Args:
            ms: Timeout in ms, or nil for no timeout

        Returns:
            Result or error
        """
        val raw_ms = if ms.?: ms.unwrap() else: -1
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_set_write_timeout(self.fd, raw_ms)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_write_timeout failed", source: nil))
        Ok(())

    pub fn shutdown(how: Shutdown) -> Result<(), IoError>:
        """Shutdown one or both directions.

        Args:
            how: Read, Write, or Both

        Returns:
            Result or error
        """
        val how_int = match how:
            case Shutdown.Read: 0
            case Shutdown.Write: 1
            case Shutdown.Both: 2
        val ok = unsafe(capabilities: [ffi]):
            sosix_tcp_shutdown(self.fd, how_int)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "shutdown failed", source: nil))
        Ok(())

# ============================================================================
# Backend socket helpers
# ============================================================================

fn tcp_backend_bind(addr: text) -> i64:
    unsafe(capabilities: [ffi]):
        sosix_tcp_bind(addr)

fn tcp_backend_socket_create(family: i64) -> i64:
    """Create a raw TCP socket (not yet bound).

    Args:
        family: 0 = IPv4, 1 = IPv6

    Returns:
        Socket fd or -1 on failure
    """
    unsafe(capabilities: [ffi]):
        sosix_tcp_socket_create(family)

fn tcp_backend_bind_fd(fd: i64, addr: text) -> bool:
    """Bind a pre-created socket to an address.

    Args:
        fd: Socket fd from tcp_backend_socket_create()
        addr: Address in "host:port" format

    Returns:
        true on success
    """
    unsafe(capabilities: [ffi]):
        sosix_tcp_bind_fd(fd, addr)

fn tcp_backend_listen(fd: i64, backlog: i64) -> bool:
    """Start listening on a bound socket.

    Args:
        fd: Socket fd that has been bound
        backlog: Listen backlog size

    Returns:
        true on success
    """
    unsafe(capabilities: [ffi]):
        sosix_tcp_listen(fd, backlog)

fn tcp_backend_bind_with_reuseport(addr: text) -> i64:
    """Create socket, set SO_REUSEPORT + SO_REUSEADDR, then bind + listen.

    This is the correct sequence for multi-worker port sharing: socket
    options must be set BEFORE bind() for SO_REUSEPORT to take effect.
    Detects IPv6 addresses (containing '[') and creates the appropriate
    socket family.

    Args:
        addr: Address in "host:port" format

    Returns:
        fd or -1 on failure
    """
    var family = 0
    if addr.contains("["):
        family = 1
    val fd = unsafe(capabilities: [ffi]):
        sosix_tcp_socket_create(family)
    if fd < 0:
        return -1
    tcp_backend_set_reuseport(fd, true)
    tcp_backend_set_reuseaddr(fd, true)
    val bound = unsafe(capabilities: [ffi]):
        sosix_tcp_bind_fd(fd, addr)
    if not bound:
        unsafe(capabilities: [ffi]):
            sosix_tcp_close(fd)
        return -1
    val listening = unsafe(capabilities: [ffi]):
        sosix_tcp_listen(fd, 128)
    if not listening:
        unsafe(capabilities: [ffi]):
            sosix_tcp_close(fd)
        return -1
    fd

fn tcp_backend_close(fd: i64) -> bool:
    unsafe(capabilities: [ffi]):
        sosix_tcp_close(fd)

fn tcp_backend_set_nonblocking(fd: i64, enabled: bool) -> bool:
    unsafe(capabilities: [ffi]):
        sosix_tcp_set_nonblocking(fd, enabled)

fn tcp_backend_set_reuseport(fd: i64, enabled: bool) -> bool:
    unsafe(capabilities: [ffi]):
        sosix_tcp_set_reuseport(fd, enabled)

fn tcp_backend_set_reuseaddr(fd: i64, enabled: bool) -> bool:
    unsafe(capabilities: [ffi]):
        sosix_tcp_set_reuseaddr(fd, enabled)

fn tcp_backend_set_nodelay(fd: i64, enabled: bool) -> bool:
    unsafe(capabilities: [ffi]):
        sosix_tcp_set_nodelay(fd, enabled)

fn tcp_backend_local_addr(fd: i64) -> text?:
    unsafe(capabilities: [ffi]):
        sosix_tcp_local_addr(fd)

export use std.nogc_sync_mut.io.tcp_socket.{TcpSocket, tcp_socket_create_resource}

# Scalar descriptor helpers for Phase-3 consumers.  They deliberately avoid
# constructing/returning TcpStream class values across a native call boundary.
fn tcp_fd_set_read_timeout(fd: i64, ms: i64) -> bool:
    if fd < 0:
        return false
    unsafe(capabilities: [ffi]):
        sosix_tcp_set_read_timeout(fd, ms)

fn tcp_fd_write_text(fd: i64, data: text) -> bool:
    if fd < 0: return false
    val external = match io_external_from_internal(data, utf8_format()):
        case Ok(value): value
        case Err(_): return false
    val bytes = match io_external_bytes(external):
        case Ok(value): value
        case Err(_): return false
    var offset = 0
    while offset < bytes.len():
        val remaining = bytes.len() - offset
        val count = if remaining > 8192: 8192 else: remaining
        val window = match tcp_packed_window(bytes, offset, offset + count):
            case Ok(value): value
            case Err(_): return false
        val written = unsafe(capabilities: [ffi]):
            sosix_tcp_write(fd, window)
        if written <= 0 or written > count: return false
        offset = offset + written
    true

fn tcp_fd_read_line_or_empty(fd: i64) -> text:
    if fd < 0: return ""
    var bytes: [u8] = []
    while true:
        val chunk = unsafe(capabilities: [ffi]):
            sosix_tcp_read(fd, 1)
        if chunk == nil: return ""
        if chunk!.len() == 0: break
        if chunk!.len() != 1: return ""
        val appended = io_append_chunk(bytes, chunk!)
        if chunk![0] == 10: break
    match io_legacy_utf8(bytes):
        case Ok(value): value
        case Err(_): ""

fn tcp_fd_read_bytes_or_empty(fd: i64, count: i32) -> text:
    if fd < 0 or count <= 0: return ""
    var bytes: [u8] = []
    var remaining = count.to_i64()
    while remaining > 0:
        val chunk = unsafe(capabilities: [ffi]):
            sosix_tcp_read(fd, remaining)
        if chunk == nil or chunk!.len() == 0: return ""
        if chunk!.len() > remaining: return ""
        val appended = io_append_chunk(bytes, chunk!)
        remaining = remaining - chunk!.len()
    match io_legacy_utf8(bytes):
        case Ok(value): value
        case Err(_): ""

fn tcp_fd_read_text_or_empty(fd: i64, count: i32) -> text:
    # Content-Length is exact bytes, never whole-line overread or UTF-8 units.
    tcp_fd_read_bytes_or_empty(fd, count)

fn tcp_fd_close(fd: i64) -> bool:
    if fd < 0:
        return true
    unsafe(capabilities: [ffi]):
        sosix_tcp_close(fd)

fn tcp_listener_bind_fd(addr: text) -> i64:
    unsafe(capabilities: [ffi]):
        sosix_tcp_bind(addr)

fn tcp_listener_accept_fd(fd: i64) -> i64:
    if fd < 0: return -1
    unsafe(capabilities: [ffi]):
        sosix_tcp_accept(fd)

fn tcp_listener_accept_fd_timeout(fd: i64, ms: i64) -> i64:
    if fd < 0: return -1
    unsafe(capabilities: [ffi]):
        sosix_tcp_accept_timeout(fd, ms)

export tcp_fd_set_read_timeout, tcp_fd_write_text, tcp_fd_read_line_or_empty
export tcp_fd_read_bytes_or_empty, tcp_fd_close
export tcp_fd_read_text_or_empty
export tcp_listener_bind_fd, tcp_listener_accept_fd, tcp_listener_accept_fd_timeout

# NOTE: the raw fd-based helpers above (tcp_backend_socket_create,
# tcp_backend_close, ...) are DEPRECATED for new code: use
# tcp_socket_create_resource() + TcpSocket.close() instead. They are kept
# working for existing callers.

# ============================================================================
# Exports
# ============================================================================

fn tcp_text_io_error(error: TextIoError) -> IoError:
    match error:
        case TextIoError.Transport(transport): transport
        case _: IoError(kind: IoErrorKind.Other, message: io_text_error_message(error), source: nil)

fn tcp_legacy_utf8(bytes: [u8]) -> Result<text, IoError>:
    match io_legacy_utf8(bytes):
        case Ok(value): Ok(value)
        case Err(message): Err(IoError(kind: IoErrorKind.Other, message: message, source: nil))
