# Sync TCP I/O
#
# TCP listener and stream implementing Read, Write, Close traits.
# Provides reliable, connection-oriented network I/O.

use std.io.traits.{Read, Write, Close}
use std.io.types.{IoError, IoErrorKind, Shutdown}
use std.nogc_sync_mut.io.byte_append.{io_append_chunk}
fn tcp_sub_bytes(data: [u8], start: i64, end: i64) -> [u8]:
    var result: [u8] = []
    var i = start
    while i < end and i < data.len():
        result.push(data[i])
        i = i + 1
    return result

# ============================================================================
# TcpListener - TCP Server Socket
# ============================================================================

class TcpListener with Close:
    """TCP server socket.

    Listens for incoming connections and produces TcpStream handles.

    Example:
        val listener = TcpListener.bind("127.0.0.1:8080")?
        while true:
            val stream = listener.accept()?
            handle_client(stream)
    """
    fd: i64
    open: bool

    static fn bind(addr: text) -> Result<TcpListener, IoError>:
        """Bind to address and start listening.

        Args:
            addr: Address in format "host:port"

        Returns:
            Result with TcpListener or error
        """
        val fd = rt_io_tcp_bind(addr)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.AddrInUse, message: "bind failed: {addr}", source: nil))
        Ok(TcpListener(fd: fd, open: true))

    fn accept() -> Result<TcpStream, IoError>:
        """Accept incoming connection (blocks).

        Returns:
            Result with connected TcpStream
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "listener is closed", source: nil))
        val client_fd = rt_io_tcp_accept(self.fd)
        if client_fd < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "accept failed", source: nil))
        Ok(TcpStream(fd: client_fd, open: true))

    fn accept_timeout(ms: i64) -> Result<TcpStream, IoError>:
        """Accept with timeout.

        Args:
            ms: Timeout in milliseconds

        Returns:
            Result with TcpStream or TimedOut error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "listener is closed", source: nil))
        val client_fd = rt_io_tcp_accept_timeout(self.fd, ms)
        if client_fd < 0:
            return Err(IoError(kind: IoErrorKind.TimedOut, message: "accept timed out", source: nil))
        Ok(TcpStream(fd: client_fd, open: true))

    fn accept_fd() -> i64:
        """Accept and return the scalar native descriptor.

        Native Phase-3 consumers use this boundary when an aggregate
        ``Result<TcpStream, IoError>`` return is not ABI-safe.  Negative values
        retain the runtime accept failure convention.
        """
        if not self.open:
            return -1
        rt_io_tcp_accept(self.fd)

    fn accept_fd_timeout(ms: i64) -> i64:
        """Accept with timeout and return only the scalar descriptor."""
        if not self.open:
            return -1
        rt_io_tcp_accept_timeout(self.fd, ms)

    fn local_addr() -> Result<text, IoError>:
        """Get local bound address.

        Returns:
            Result with address string
        """
        val addr = rt_io_tcp_local_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "local_addr failed", source: nil))
        Ok(addr)

    # --- Close trait ---

    me close() -> Result<(), IoError>:
        """Close listener."""
        if not self.open:
            return Ok(())
        val ok = rt_io_tcp_close(self.fd)
        self.open = false
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "close failed", source: nil))
        Ok(())

    fn is_open() -> bool:
        """Check if listener is open."""
        self.open

# ============================================================================
# TcpStream - TCP Connection
# ============================================================================

class TcpStream with Read, Write, Close:
    """Bidirectional TCP connection.

    Implements Read, Write, Close for stream-oriented I/O.

    Example:
        val stream = TcpStream.connect("example.com:80")?
        stream.write_text("GET / HTTP/1.1\\r\\nHost: example.com\\r\\n\\r\\n")?
        val response = stream.read_text()?
        stream.close()?
    """
    fd: i64
    open: bool

    static fn from_accepted_fd(fd: i64) -> TcpStream:
        TcpStream(fd: fd, open: fd >= 0)

    static fn connect_fd_timeout(addr: text, ms: i64) -> i64:
        """Connect and return only the scalar native descriptor.

        Phase-3 native leaf clients use this boundary instead of returning an
        aggregate ``Result<TcpStream, IoError>`` across the runtime call.
        """
        rt_io_tcp_connect_timeout(addr, ms)

    static fn connect(addr: text) -> Result<TcpStream, IoError>:
        """Connect to remote address.

        Args:
            addr: Address in "host:port" format

        Returns:
            Result with connected TcpStream
        """
        val fd = rt_io_tcp_connect(addr)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.ConnectionRefused, message: "connect failed: {addr}", source: nil))
        Ok(TcpStream(fd: fd, open: true))

    static fn connect_timeout(addr: text, ms: i64) -> Result<TcpStream, IoError>:
        """Connect with timeout.

        Args:
            addr: Address in "host:port" format
            ms: Timeout in milliseconds

        Returns:
            Result with TcpStream or TimedOut error
        """
        val fd = rt_io_tcp_connect_timeout(addr, ms)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.TimedOut, message: "connect timed out: {addr}", source: nil))
        Ok(TcpStream(fd: fd, open: true))

    # --- Read trait ---

    fn read(size: i64) -> Result<[u8], IoError>:
        """Read up to size bytes from stream.

        Args:
            size: Maximum bytes to read

        Returns:
            Result with bytes read (may be fewer than size)
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val data = rt_io_tcp_read(self.fd, size)
        if data.len() < 0:
            return Err(IoError(kind: IoErrorKind.ConnectionReset, message: "read failed", source: nil))
        Ok(data)

    fn read_exact(size: i64) -> Result<[u8], IoError>:
        """Read exactly size bytes.

        Args:
            size: Exact bytes to read

        Returns:
            Result with bytes, or error if stream ends early
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var buf: [u8] = []
        var remaining = size
        while remaining > 0:
            val chunk = rt_io_tcp_read(self.fd, remaining)
            if chunk.len() == 0:
                return Err(IoError(kind: IoErrorKind.UnexpectedEof, message: "read_exact: got {buf.len()} of {size} bytes", source: nil))
            val _copied = io_append_chunk(buf, chunk)
            remaining = remaining - chunk.len()
        Ok(buf)

    fn read_bytes(count: i32) -> Result<text, IoError>:
        """Read exactly `count` bytes and decode as text.

        Used by the HTTP parser for a `Content-Length` body, which is
        defined as an exact byte count (not "read until EOF" like
        `read_text`/`read_all`). Thin wrapper over `read_exact` +
        `rt_bytes_to_text` so callers that already have a byte count from a
        header don't need to convert bytes themselves.

        Args:
            count: exact number of bytes to read

        Returns:
            Result with the bytes decoded as text, or an error if the
            stream ended before `count` bytes arrived
        """
        val bytes = self.read_exact(count.to_i64())?
        val s = bytes_to_text(bytes)
        Ok(s)

    fn read_all() -> Result<[u8], IoError>:
        """Read all available bytes until EOF.

        Returns:
            Result with all bytes
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var buf: [u8] = []
        while true:
            val chunk = rt_io_tcp_read(self.fd, 8192)
            if chunk.len() == 0:
                break
            val _copied = io_append_chunk(buf, chunk)
        Ok(buf)

    fn read_text() -> Result<text, IoError>:
        """Read all available content as text.

        Returns:
            Result with text
        """
        val bytes = self.read_all()?
        val s = bytes_to_text(bytes)
        Ok(s)

    fn read_line() -> Result<text, IoError>:
        """Read a single line from stream.

        Returns:
            Result with line including newline
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val line = rt_io_tcp_read_line(self.fd)
        if line == nil:
            return Err(IoError(kind: IoErrorKind.UnexpectedEof, message: "end of stream", source: nil))
        Ok(line)

    fn read_line_nullable() -> text?:
        """Read one line without an aggregate ``Result`` return.

        This is the Phase-3 ABI-safe server boundary. ``nil`` represents a
        closed stream or read failure.
        """
        if not self.open:
            return nil
        rt_io_tcp_read_line(self.fd)

    fn read_line_bounded(max_bytes: i64) -> Result<text, IoError>:
        """Read one line, but fail closed once more than max_bytes have
        arrived without a newline, instead of buffering an unbounded amount
        of attacker-controlled input.

        Args:
            max_bytes: maximum line length (including the trailing newline)
                before this read is treated as a connection-fatal error

        Returns:
            Result with the line (including newline) on success, or an
            error if the stream ended with no data or the bound was crossed
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var buf: [u8] = []
        while true:
            val chunk = rt_io_tcp_read(self.fd, 1)
            if chunk.len() == 0:
                if buf.len() == 0:
                    return Err(IoError(kind: IoErrorKind.UnexpectedEof, message: "end of stream", source: nil))
                break
            val _copied = io_append_chunk(buf, chunk)
            if buf.len() > max_bytes:
                return Err(IoError(kind: IoErrorKind.Other, message: "line exceeds max_bytes ({max_bytes})", source: nil))
            if chunk[0] == 10:
                break
        Ok(bytes_to_text(buf))

    fn read_line_or_empty() -> text:
        """Read one line through a non-optional Phase-3 ABI boundary."""
        if not self.open:
            return ""
        val line = rt_io_tcp_read_line(self.fd)
        if line == nil:
            return ""
        line

    fn read_bytes_or_empty(count: i32) -> text:
        """Read an exact HTTP body without returning an aggregate result."""
        if not self.open or count <= 0:
            return ""
        var buf: [u8] = []
        var remaining = count.to_i64()
        while remaining > 0:
            val chunk = rt_io_tcp_read(self.fd, remaining)
            if chunk.len() == 0:
                return ""
            val _copied = io_append_chunk(buf, chunk)
            remaining = remaining - chunk.len()
        bytes_to_text(buf)

    # --- Write trait ---

    fn write(data: [u8]) -> Result<i64, IoError>:
        """Write bytes, returning number written.

        Args:
            data: Bytes to write

        Returns:
            Result with bytes written count
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val written = rt_io_tcp_write(self.fd, data)
        if written < 0:
            return Err(IoError(kind: IoErrorKind.BrokenPipe, message: "write failed", source: nil))
        Ok(written)

    fn write_all(data: [u8]) -> Result<(), IoError>:
        """Write all bytes.

        Args:
            data: Bytes to write

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        var offset = 0
        while offset < data.len():
            val remaining = tcp_sub_bytes(data, offset, data.len())
            val written = rt_io_tcp_write(self.fd, remaining)
            if written <= 0:
                return Err(IoError(kind: IoErrorKind.BrokenPipe, message: "write_all failed", source: nil))
            offset = offset + written
        Ok(())

    fn write_text(s: text) -> Result<(), IoError>:
        """Write text string.

        Args:
            s: Text to write

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val written = rt_io_tcp_write_text(self.fd, s)
        if written <= 0:
            return Err(IoError(kind: IoErrorKind.BrokenPipe, message: "write_text failed", source: nil))
        Ok(())

    fn write_text_status(s: text) -> bool:
        """Write text and return a scalar success flag."""
        if not self.open:
            return false
        rt_io_tcp_write_text(self.fd, s) > 0

    fn flush() -> Result<(), IoError>:
        """Flush write buffer.

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "stream is closed", source: nil))
        val ok = rt_io_tcp_flush(self.fd)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "flush failed", source: nil))
        Ok(())

    # --- Close trait ---

    me close() -> Result<(), IoError>:
        """Close stream."""
        if not self.open:
            return Ok(())
        val ok = rt_io_tcp_close(self.fd)
        self.open = false
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "close failed", source: nil))
        Ok(())

    me close_status() -> bool:
        """Close the stream and return a scalar success flag."""
        if not self.open:
            return true
        val ok = rt_io_tcp_close(self.fd)
        self.open = false
        ok

    fn is_open() -> bool:
        """Check if stream is open."""
        self.open

    # --- TCP-specific ---

    fn peer_addr() -> Result<text, IoError>:
        """Get remote peer address.

        Returns:
            Result with address string
        """
        val addr = rt_io_tcp_peer_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "peer_addr failed", source: nil))
        Ok(addr)

    fn local_addr() -> Result<text, IoError>:
        """Get local address.

        Returns:
            Result with address string
        """
        val addr = rt_io_tcp_local_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "local_addr failed", source: nil))
        Ok(addr)

    fn set_nodelay(enabled: bool) -> Result<(), IoError>:
        """Set TCP_NODELAY (disable Nagle's algorithm).

        Args:
            enabled: true to disable Nagle

        Returns:
            Result or error
        """
        val ok = rt_io_tcp_set_nodelay(self.fd, enabled)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_nodelay failed", source: nil))
        Ok(())

    fn set_read_timeout(ms: i64?) -> Result<(), IoError>:
        """Set read timeout.

        Args:
            ms: Timeout in ms, or nil for no timeout

        Returns:
            Result or error
        """
        val ok = rt_io_tcp_set_read_timeout(self.fd, ms)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_read_timeout failed", source: nil))
        Ok(())

    fn set_read_timeout_status(ms: i64) -> bool:
        """Set a finite read timeout with a scalar native result."""
        if not self.open:
            return false
        rt_io_tcp_set_read_timeout(self.fd, ms)

    fn set_write_timeout(ms: i64?) -> Result<(), IoError>:
        """Set write timeout.

        Args:
            ms: Timeout in ms, or nil for no timeout

        Returns:
            Result or error
        """
        val ok = rt_io_tcp_set_write_timeout(self.fd, ms)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_write_timeout failed", source: nil))
        Ok(())

    fn shutdown(how: Shutdown) -> Result<(), IoError>:
        """Shutdown one or both directions.

        Args:
            how: Read, Write, or Both

        Returns:
            Result or error
        """
        val how_int = match how:
            case Shutdown.Read: 0
            case Shutdown.Write: 1
            case Shutdown.Both: 2
        val ok = rt_io_tcp_shutdown(self.fd, how_int)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "shutdown failed", source: nil))
        Ok(())

# ============================================================================
# Backend socket helpers
# ============================================================================

fn tcp_backend_bind(addr: text) -> i64:
    rt_io_tcp_bind(addr)

fn tcp_backend_socket_create(family: i64) -> i64:
    """Create a raw TCP socket (not yet bound).

    Args:
        family: 0 = IPv4, 1 = IPv6

    Returns:
        Socket fd or -1 on failure
    """
    rt_io_tcp_socket_create(family)

fn tcp_backend_bind_fd(fd: i64, addr: text) -> bool:
    """Bind a pre-created socket to an address.

    Args:
        fd: Socket fd from tcp_backend_socket_create()
        addr: Address in "host:port" format

    Returns:
        true on success
    """
    rt_io_tcp_bind_fd(fd, addr)

fn tcp_backend_listen(fd: i64, backlog: i64) -> bool:
    """Start listening on a bound socket.

    Args:
        fd: Socket fd that has been bound
        backlog: Listen backlog size

    Returns:
        true on success
    """
    rt_io_tcp_listen(fd, backlog)

fn tcp_backend_bind_with_reuseport(addr: text) -> i64:
    """Create socket, set SO_REUSEPORT + SO_REUSEADDR, then bind + listen.

    This is the correct sequence for multi-worker port sharing: socket
    options must be set BEFORE bind() for SO_REUSEPORT to take effect.
    Detects IPv6 addresses (containing '[') and creates the appropriate
    socket family.

    Args:
        addr: Address in "host:port" format

    Returns:
        fd or -1 on failure
    """
    var family = 0
    if addr.contains("["):
        family = 1
    val fd = rt_io_tcp_socket_create(family)
    if fd < 0:
        return -1
    tcp_backend_set_reuseport(fd, true)
    tcp_backend_set_reuseaddr(fd, true)
    if not rt_io_tcp_bind_fd(fd, addr):
        rt_io_tcp_close(fd)
        return -1
    if not rt_io_tcp_listen(fd, 128):
        rt_io_tcp_close(fd)
        return -1
    fd

fn tcp_backend_close(fd: i64) -> bool:
    rt_io_tcp_close(fd)

fn tcp_backend_set_nonblocking(fd: i64, enabled: bool) -> bool:
    rt_io_tcp_set_nonblocking(fd, enabled)

fn tcp_backend_set_reuseport(fd: i64, enabled: bool) -> bool:
    rt_io_tcp_set_reuseport(fd, enabled)

fn tcp_backend_set_reuseaddr(fd: i64, enabled: bool) -> bool:
    rt_io_tcp_set_reuseaddr(fd, enabled)

fn tcp_backend_set_nodelay(fd: i64, enabled: bool) -> bool:
    rt_io_tcp_set_nodelay(fd, enabled)

fn tcp_backend_local_addr(fd: i64) -> text?:
    rt_io_tcp_local_addr(fd)

# ============================================================================
# SFFI Functions
# ============================================================================

# TCP listener
extern fn rt_io_tcp_bind(addr: text) -> i64
extern fn rt_io_tcp_socket_create(family: i64) -> i64
extern fn rt_io_tcp_bind_fd(fd: i64, addr: text) -> bool
extern fn rt_io_tcp_listen(fd: i64, backlog: i64) -> bool
extern fn rt_io_tcp_accept(fd: i64) -> i64
extern fn rt_io_tcp_accept_timeout(fd: i64, ms: i64) -> i64

# TCP stream
extern fn rt_io_tcp_connect(addr: text) -> i64
extern fn rt_io_tcp_connect_timeout(addr: text, ms: i64) -> i64
extern fn rt_io_tcp_read(fd: i64, size: i64) -> [u8]
extern fn rt_io_tcp_read_line(fd: i64) -> text?
extern fn rt_io_tcp_write(fd: i64, data: [u8]) -> i64
extern fn rt_io_tcp_write_text(fd: i64, data: text) -> i64
extern fn rt_io_tcp_flush(fd: i64) -> bool
extern fn rt_io_tcp_close(fd: i64) -> bool

# TCP metadata / options
extern fn rt_io_tcp_local_addr(fd: i64) -> text?
extern fn rt_io_tcp_peer_addr(fd: i64) -> text?
extern fn rt_io_tcp_set_nonblocking(fd: i64, enabled: bool) -> bool
extern fn rt_io_tcp_set_nodelay(fd: i64, enabled: bool) -> bool
extern fn rt_io_tcp_set_reuseport(fd: i64, enabled: bool) -> bool
extern fn rt_io_tcp_set_reuseaddr(fd: i64, enabled: bool) -> bool
extern fn rt_io_tcp_set_read_timeout(fd: i64, ms: i64?) -> bool
extern fn rt_io_tcp_set_write_timeout(fd: i64, ms: i64?) -> bool
extern fn rt_io_tcp_shutdown(fd: i64, how: i64) -> bool

# Text/bytes conversion
use std.common.string_core.{bytes_to_text}
use std.common.string_core.{text_to_bytes}

# ============================================================================
# Resource Wrapper (Owning Handle Class) — WP-J
# ============================================================================

# Raw TCP socket resource wrapper with double-close guard.
# Sentinel is -1: rt_io_tcp_socket_create returns the socket fd on success
# and -1 on failure (see tcp_backend_socket_create docstring and the
# `if fd < 0` checks in tcp_backend_bind_with_reuseport above).
class TcpSocket:
    fd: i64

impl TcpSocket:
    fn is_valid() -> bool:
        self.fd >= 0

    fn bind(addr: text) -> bool:
        if not self.is_valid():
            return false
        rt_io_tcp_bind_fd(self.fd, addr)

    fn listen(backlog: i64) -> bool:
        if not self.is_valid():
            return false
        rt_io_tcp_listen(self.fd, backlog)

    fn set_reuseaddr(enabled: bool) -> bool:
        if not self.is_valid():
            return false
        rt_io_tcp_set_reuseaddr(self.fd, enabled)

    fn set_reuseport(enabled: bool) -> bool:
        if not self.is_valid():
            return false
        rt_io_tcp_set_reuseport(self.fd, enabled)

    fn local_addr() -> text?:
        if not self.is_valid():
            return nil
        rt_io_tcp_local_addr(self.fd)

    fn close():
        # Consuming drop: one-shot guard against double-close
        if self.fd >= 0:
            rt_io_tcp_close(self.fd)
            self.fd = -1

# Create a raw TCP socket (not yet bound). family: 0 = IPv4, 1 = IPv6.
# Returns nil on failure.
fn tcp_socket_create_resource(family: i64) -> TcpSocket?:
    val fd = rt_io_tcp_socket_create(family)
    if fd < 0:
        return nil
    TcpSocket(fd: fd)

# Scalar descriptor helpers for Phase-3 consumers.  They deliberately avoid
# constructing/returning TcpStream class values across a native call boundary.
fn tcp_fd_set_read_timeout(fd: i64, ms: i64) -> bool:
    fd >= 0 and rt_io_tcp_set_read_timeout(fd, ms)

fn tcp_fd_write_text(fd: i64, data: text) -> bool:
    fd >= 0 and rt_io_tcp_write_text(fd, data) > 0

fn tcp_fd_read_line_or_empty(fd: i64) -> text:
    if fd < 0:
        return ""
    val line = rt_io_tcp_read_line(fd)
    if line == nil:
        return ""
    line

fn tcp_fd_read_bytes_or_empty(fd: i64, count: i32) -> text:
    if fd < 0 or count <= 0:
        return ""
    var buf: [u8] = []
    var remaining = count.to_i64()
    while remaining > 0:
        val chunk = rt_io_tcp_read(fd, remaining)
        if chunk.len() == 0:
            return ""
        buf = buf + chunk
        remaining = remaining - chunk.len()
    bytes_to_text(buf)

fn tcp_fd_read_text_or_empty(fd: i64, count: i32) -> text:
    """Read a bounded HTTP text body without the Phase-3 array-return ABI.

    `rt_io_tcp_read` returns `[u8]`, which is not stable in the current
    staged native lane. `rt_io_tcp_read_line` returns runtime-owned text, so
    accumulate complete lines until Content-Length bytes are present or the
    peer closes. This supports both one-line protocol JSON and multiline HTML.
    """
    if fd < 0 or count <= 0:
        return ""
    var out = ""
    while out.len() < count:
        val chunk = tcp_fd_read_line_or_empty(fd)
        if chunk == "":
            break
        out = out + chunk
    out

fn tcp_fd_close(fd: i64) -> bool:
    fd < 0 or rt_io_tcp_close(fd)

fn tcp_listener_bind_fd(addr: text) -> i64:
    rt_io_tcp_bind(addr)

fn tcp_listener_accept_fd(fd: i64) -> i64:
    if fd < 0: return -1
    rt_io_tcp_accept(fd)

fn tcp_listener_accept_fd_timeout(fd: i64, ms: i64) -> i64:
    if fd < 0: return -1
    rt_io_tcp_accept_timeout(fd, ms)

export tcp_fd_set_read_timeout, tcp_fd_write_text, tcp_fd_read_line_or_empty
export tcp_fd_read_bytes_or_empty, tcp_fd_close
export tcp_fd_read_text_or_empty
export tcp_listener_bind_fd, tcp_listener_accept_fd, tcp_listener_accept_fd_timeout

# NOTE: the raw fd-based helpers above (tcp_backend_socket_create,
# tcp_backend_close, ...) are DEPRECATED for new code: use
# tcp_socket_create_resource() + TcpSocket.close() instead. They are kept
# working for existing callers.

