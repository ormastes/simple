# SQLite-shaped Database Wrapper
# Simple-friendly connection/statement/row API over the raw handle layer.
# Backed by Simple's embedded SQL engine — never libsqlite3 (CLAUDE.md).

use std.nogc_sync_mut.io.sffi_common.{is_empty_string}

# Tier 1 used to be 27 `rt_sqlite_*` externs whose only hosted provider wrapped
# the external libsqlite3. The raw handle API is now served by Simple's embedded
# SQL engine (sqlite_embedded.spl); no `rt_sqlite_*` symbol is referenced here.
use std.nogc_sync_mut.io.sqlite_embedded.{
    sqlite_raw_open, sqlite_raw_open_memory, sqlite_raw_close,
    sqlite_raw_execute, sqlite_raw_execute_batch,
    sqlite_raw_query, sqlite_raw_query_next, sqlite_raw_query_done,
    sqlite_raw_column_count, sqlite_raw_column_name, sqlite_raw_column_text,
    sqlite_raw_prepare, sqlite_raw_bind_text, sqlite_raw_bind_int, sqlite_raw_bind_float, sqlite_raw_bind_null,
    sqlite_raw_reset, sqlite_raw_finalize,
    sqlite_raw_begin, sqlite_raw_commit, sqlite_raw_rollback,
    sqlite_raw_last_insert_rowid, sqlite_raw_changes, sqlite_raw_error_message}

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

# --- Core Types ---

struct SqliteConnection:
    handle: i64
    path: text
    is_valid: bool

struct SqliteStatement:
    handle: i64
    sql: text
    is_valid: bool

struct SqliteRow:
    values: [text]
    column_names: [text]

enum SqliteType:
    Integer
    Float
    Text
    Blob
    Null

# Native SQLite returns tagged nil (3) for a failed pointer result. General
# positive-handle checks accept 3, so this boundary must reject it explicitly.
fn sqlite_handle_valid(handle: i64) -> bool:
    handle > 0 and handle != 3

fn sqlite_handle_invalid(handle: i64) -> bool:
    not sqlite_handle_valid(handle)

# --- Connection Management ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_open(path: text) -> SqliteConnection:
    """Open SQLite database file

    Args:
        path: Path to database file (will be created if doesn't exist)

    Returns: Database connection (check is_valid field)

    Example:
        db = sqlite_open("data.db")
        if db.is_valid:
            # Use database
            sqlite_close(db)
    """
    val handle = sqlite_raw_open(path)
    SqliteConnection(handle: handle, path: path, is_valid: sqlite_handle_valid(handle))

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_open_memory() -> SqliteConnection:
    """Open in-memory SQLite database

    Returns: Database connection

    Example:
        db = sqlite_open_memory()
        # Fast temporary database
    """
    val handle = sqlite_raw_open_memory()
    SqliteConnection(handle: handle, path: ":memory:", is_valid: sqlite_handle_valid(handle))

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_close(conn: SqliteConnection) -> bool:
    """Close database connection

    Returns: true on success
    """
    if sqlite_handle_invalid(conn.handle):
        return false

    val result = sqlite_raw_close(conn.handle)
    result == 1

# --- Basic Execution ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_execute(conn: SqliteConnection, sql: text) -> bool:
    """Execute SQL statement without returning results

    Args:
        conn: Database connection
        sql: SQL statement (CREATE, INSERT, UPDATE, DELETE)

    Returns: true on success, false on error

    Example:
        db = sqlite_open("data.db")
        sqlite_execute(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        sqlite_execute(db, "INSERT INTO users (name) VALUES ('Alice')")
    """
    if sqlite_handle_invalid(conn.handle):
        return false

    val result = sqlite_raw_execute(conn.handle, sql)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_execute_batch(conn: SqliteConnection, sql: text) -> bool:
    """Execute multiple SQL statements

    Args:
        conn: Database connection
        sql: Multiple SQL statements separated by semicolons

    Returns: true on success

    Example:
        db = sqlite_open("data.db")
        sqlite_execute_batch(db, \"\"\"
            CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);
            CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER);
        \"\"\")
    """
    if sqlite_handle_invalid(conn.handle):
        return false

    val result = sqlite_raw_execute_batch(conn.handle, sql)
    result == 1

# --- Query Execution (Simple API) ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_query_all(conn: SqliteConnection, sql: text) -> [SqliteRow]:
    """Execute query and return all rows

    Args:
        conn: Database connection
        sql: SELECT query

    Returns: Array of rows

    Example:
        db = sqlite_open("data.db")
        rows = sqlite_query_all(db, "SELECT * FROM users")
        for row in rows:
            print row.values[0]
    """
    if sqlite_handle_invalid(conn.handle):
        return []

    val stmt_handle = sqlite_raw_query(conn.handle, sql)
    if sqlite_handle_invalid(stmt_handle):
        return []

    var rows = []

    # Get column names
    val col_count = sqlite_raw_column_count(stmt_handle)
    var column_names = []
    for i in 0..col_count:
        val name = sqlite_raw_column_name(stmt_handle, i)
        column_names.push(name)

    # Fetch all rows
    var has_row = sqlite_raw_query_next(stmt_handle)
    while has_row == 1:
        var values = []
        for i in 0..col_count:
            val value = sqlite_raw_column_text(stmt_handle, i)
            values.push(value)

        val row = SqliteRow(values: values, column_names: column_names)
        rows.push(row)

        has_row = sqlite_raw_query_next(stmt_handle)

    sqlite_raw_query_done(stmt_handle)
    rows

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_query_one(conn: SqliteConnection, sql: text) -> SqliteRow:
    """Execute query and return first row

    Returns: First row, or empty row if no results

    Example:
        db = sqlite_open("data.db")
        row = sqlite_query_one(db, "SELECT * FROM users WHERE id = 1")
        if row.values.len() > 0:
            print row.values[0]
    """
    val rows = sqlite_query_all(conn, sql)
    if rows.len() > 0:
        rows[0]
    else:
        SqliteRow(values: [], column_names: [])

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_query_value(conn: SqliteConnection, sql: text) -> text:
    """Execute query and return single value

    Returns: First column of first row, empty string if no results

    Example:
        db = sqlite_open("data.db")
        count = sqlite_query_value(db, "SELECT COUNT(*) FROM users")
    """
    val row = sqlite_query_one(conn, sql)
    if row.values.len() > 0:
        row.values[0]
    else:
        ""

# --- Prepared Statements ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_prepare(conn: SqliteConnection, sql: text) -> SqliteStatement:
    """Prepare SQL statement with placeholders

    Args:
        conn: Database connection
        sql: SQL with ? placeholders

    Returns: Prepared statement (check is_valid)

    Example:
        db = sqlite_open("data.db")
        stmt = sqlite_prepare(db, "INSERT INTO users (name, age) VALUES (?, ?)")
        if stmt.is_valid:
            sqlite_bind_text(stmt, 1, "Alice")
            sqlite_bind_int(stmt, 2, 30)
    """
    if sqlite_handle_invalid(conn.handle):
        return SqliteStatement(handle: 0, sql: sql, is_valid: false)

    val handle = sqlite_raw_prepare(conn.handle, sql)
    SqliteStatement(handle: handle, sql: sql, is_valid: sqlite_handle_valid(handle))

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_bind_text(stmt: SqliteStatement, idx: i64, value: text) -> bool:
    """Bind text value to prepared statement

    Args:
        stmt: Prepared statement
        idx: Parameter index (1-based)
        value: Text value

    Returns: true on success
    """
    if sqlite_handle_invalid(stmt.handle):
        return false

    val result = sqlite_raw_bind_text(stmt.handle, idx, value)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_bind_int(stmt: SqliteStatement, idx: i64, value: i64) -> bool:
    """Bind integer value to prepared statement"""
    if sqlite_handle_invalid(stmt.handle):
        return false

    val result = sqlite_raw_bind_int(stmt.handle, idx, value)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_bind_float(stmt: SqliteStatement, idx: i64, value: f64) -> bool:
    """Bind float value to prepared statement"""
    if sqlite_handle_invalid(stmt.handle):
        return false

    val result = sqlite_raw_bind_float(stmt.handle, idx, value)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_bind_null(stmt: SqliteStatement, idx: i64) -> bool:
    """Bind NULL value to prepared statement"""
    if sqlite_handle_invalid(stmt.handle):
        return false

    val result = sqlite_raw_bind_null(stmt.handle, idx)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_reset(stmt: SqliteStatement) -> bool:
    """Reset prepared statement for reuse

    Returns: true on success
    """
    if sqlite_handle_invalid(stmt.handle):
        return false

    val result = sqlite_raw_reset(stmt.handle)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_finalize(stmt: SqliteStatement):
    """Finalize prepared statement and free resources"""
    if stmt.is_valid:
        sqlite_raw_finalize(stmt.handle)

# --- Transactions ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_begin(conn: SqliteConnection) -> bool:
    """Begin transaction

    Returns: true on success

    Example:
        db = sqlite_open("data.db")
        if sqlite_begin(db):
            sqlite_execute(db, "INSERT INTO users ...")
            sqlite_execute(db, "INSERT INTO posts ...")
            sqlite_commit(db)
    """
    if sqlite_handle_invalid(conn.handle):
        return false

    val result = sqlite_raw_begin(conn.handle)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_commit(conn: SqliteConnection) -> bool:
    """Commit transaction

    Returns: true on success
    """
    if sqlite_handle_invalid(conn.handle):
        return false

    val result = sqlite_raw_commit(conn.handle)
    result == 1

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_rollback(conn: SqliteConnection) -> bool:
    """Rollback transaction

    Returns: true on success
    """
    if sqlite_handle_invalid(conn.handle):
        return false

    val result = sqlite_raw_rollback(conn.handle)
    result == 1

# --- Metadata ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_last_insert_rowid(conn: SqliteConnection) -> i64:
    """Get last inserted row ID

    Returns: Row ID from last INSERT, or 0

    Example:
        sqlite_execute(db, "INSERT INTO users (name) VALUES ('Alice')")
        user_id = sqlite_last_insert_rowid(db)
    """
    if sqlite_handle_invalid(conn.handle):
        return 0

    sqlite_raw_last_insert_rowid(conn.handle)

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_changes(conn: SqliteConnection) -> i64:
    """Get number of rows affected by last statement

    Returns: Number of rows changed

    Example:
        sqlite_execute(db, "UPDATE users SET active = 1")
        updated_count = sqlite_changes(db)
    """
    if sqlite_handle_invalid(conn.handle):
        return 0

    sqlite_raw_changes(conn.handle)

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_error_message(conn: SqliteConnection) -> text:
    """Get last error message

    Returns: Error message, or empty string if no error
    """
    if sqlite_handle_invalid(conn.handle):
        return "Invalid connection"

    sqlite_raw_error_message(conn.handle)

# --- Helper Functions ---

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_table_exists(conn: SqliteConnection, table_name: text) -> bool:
    """Check if table exists

    Returns: true if table exists
    """
    val sql = "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='{table_name}'"
    val count = sqlite_query_value(conn, sql)
    count == "1"

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_count(conn: SqliteConnection, table: text) -> i64:
    """Count rows in table

    Returns: Number of rows
    """
    val sql = "SELECT COUNT(*) FROM {table}"
    val count_str = sqlite_query_value(conn, sql)
    if count_str == "":
        return 0

    # Convert string to int
    val count = int(count_str)
    count

@unsafe(reason: "legacy SQLite wrapper exposes unverified raw handles and ambiguous sentinel/error results", capabilities: [ffi])
fn sqlite_insert(conn: SqliteConnection, table: text, columns: [text], values: [text]) -> i64:
    """Insert row into table

    Args:
        conn: Database connection
        table: Table name
        columns: Column names
        values: Column values

    Returns: Inserted row ID, or 0 on error

    Example:
        user_id = sqlite_insert(db, "users", ["name", "email"], ["Alice", "alice@example.com"])
    """
    val cols = columns.join(", ")
    val placeholders = values.map(\_: "?").join(", ")
    val sql = "INSERT INTO {table} ({cols}) VALUES ({placeholders})"

    val stmt = sqlite_prepare(conn, sql)
    if not stmt.is_valid:
        return 0

    for i in 0..values.len():
        sqlite_bind_text(stmt, i + 1, values[i])

    val result = sqlite_raw_query_next(stmt.handle)
    sqlite_finalize(stmt)

    if result == 1:
        sqlite_last_insert_rowid(conn)
    else:
        0

# --- SqliteRow Helpers ---

fn sqlite_row_get(row: SqliteRow, column: text) -> text:
    """Get column value by name

    Returns: Column value, or empty string if not found

    Example:
        row = sqlite_query_one(db, "SELECT * FROM users WHERE id = 1")
        name = sqlite_row_get(row, "name")
    """
    for i in 0..row.column_names.len():
        if row.column_names[i] == column:
            return row.values[i]

    ""

fn sqlite_row_get_int(row: SqliteRow, column: text) -> i64:
    """Get integer column value by name

    Returns: Integer value, or 0 if not found
    """
    val value = sqlite_row_get(row, column)
    if value == "":
        return 0

    int(value)

