# Ordinary Linux/glibc ports only. NO new Simple runtime export.
# Native supported ABI is explicitly Linux LP64 little-endian x86_64/AArch64;
# exact target kernel constants/layout references live in linux_process_replace_target_v1.
@when(os="linux"):
export use std.nogc_sync_mut.io.retained_file_abi.{malloc, free, openat, pread, close}
@unsafe(reason: "LP64 libc syscall forwards six integer/pointer kernel arguments", capabilities: [ffi, raw_ptr])
extern fn syscall(number: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64
@unsafe(reason: "executes exact retained ELF descriptor with AT_EMPTY_PATH, success never returns", capabilities: [ffi, raw_ptr])
extern fn execveat(fd: i32, empty_path: i64, argv: i64, environment: i64, flags: i32) -> i32
@unsafe(reason: "queries immutable file seals or descriptor flags on privately owned fd", capabilities: [ffi])
extern fn fcntl(fd: i32, operation: i32, argument: i64) -> i32
@unsafe(reason: "queries size of exact retained sealed memfd", capabilities: [ffi])
extern fn lseek(fd: i32, offset: i64, whence: i32) -> i64
@unsafe(reason: "changes process cwd to exact retained directory descriptor", capabilities: [ffi])
extern fn fchdir(fd: i32) -> i32
@unsafe(reason: "creates privately owned sealing-capable anonymous ELF image", capabilities: [ffi, raw_ptr])
extern fn memfd_create(name: i64, flags: u32) -> i32
@unsafe(reason: "writes a bounded accepted prefix into exact private image at explicit offset", capabilities: [ffi, raw_ptr])
extern fn pwrite(fd: i32, buffer: i64, size: u64, offset: i64) -> i64
@unsafe(reason: "sets exact privately owned image mode before sealing", capabilities: [ffi])
extern fn fchmod(fd: i32, mode: u32) -> i32
export syscall, execveat, fcntl, lseek, fchdir, memfd_create, pwrite, fchmod
@end
