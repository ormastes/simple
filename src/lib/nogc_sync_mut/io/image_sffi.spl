# Image Loading SFFI — stb_image wrapper
#
# Loads image files from disk into pixel data usable by the engine.
# Uses external C library (stb_image) via SFFI. Handles are i64 (opaque pointers).

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

extern fn rt_image_load(path: text) -> i64
extern fn rt_image_free(handle: i64)
extern fn rt_image_width(handle: i64) -> i64
extern fn rt_image_height(handle: i64) -> i64
extern fn rt_image_channels(handle: i64) -> i64
extern fn rt_image_get_pixel(handle: i64, x: i64, y: i64) -> i64

# ============================================================================
# Tier 2: Resource Wrapper (Owning Handle Class)
# ============================================================================

# Image resource wrapper with double-close guard
class Image:
    handle: i64
    width: i64
    height: i64
    channels: i64

impl Image:
    fn is_valid() -> bool:
        self.handle != 0

    fn pixel_count() -> i64:
        self.width * self.height

    fn size_bytes() -> i64:
        self.width * self.height * self.channels

    fn get_pixel(x: i64, y: i64) -> i64:
        if not self.is_valid():
            return 0
        rt_image_get_pixel(self.handle, x, y)

    me fn close():
        # Consuming drop: one-shot guard against double-close.
        # `me` receiver is required: a plain (by-value) self would zero only
        # the copy, leaving the caller's live handle reachable for a second
        # rt_image_free — a real double-free crash on a genuinely-acquired
        # handle (see doc/08_tracking/bug/image_wrapper_close_needs_live_handle_fixture_2026-08-07.md).
        if self.handle != 0:
            rt_image_free(self.handle)
            self.handle = 0

# Load an image from disk. Returns an Image whose is_valid() is false on
# failure (handle sentinel 0). Deliberately NOT Optional: mutation through an
# Optional-unwrapped class binding does not persist in every supported runtime
# path (each access re-materializes a copy), which would silently defeat
# close()'s one-shot guard and make a second close() a double-free crash on a
# genuinely-acquired handle. A non-optional sentinel return keeps the owning
# handle fail-closed by construction. See
# doc/08_tracking/bug/image_wrapper_close_needs_live_handle_fixture_2026-08-07.md
fn load_image_resource(path: text) -> Image:
    val h = rt_image_load(path)
    if h <= 0:
        return Image(handle: 0, width: 0, height: 0, channels: 0)
    val w = rt_image_width(h)
    val ht = rt_image_height(h)
    val ch = rt_image_channels(h)
    Image(handle: h, width: w, height: ht, channels: ch)

# ============================================================================
# Tier 3: Deprecated Aliases (Compatibility Layer)
# ============================================================================

# Image load result — DEPRECATED: use Image + close() instead. Keep its name
# distinct from image_data.spl's canonical pixel-buffer ImageData so the std.io
# package has one unambiguous ImageData export.
class LoadedImageData:
    handle: i64
    width: i64
    height: i64
    channels: i64

impl LoadedImageData:
    fn is_valid() -> bool:
        self.handle > 0

    fn pixel_count() -> i64:
        self.width * self.height

    fn size_bytes() -> i64:
        self.width * self.height * self.channels

    fn get_pixel(x: i64, y: i64) -> i64:
        if not self.is_valid():
            return 0
        rt_image_get_pixel(self.handle, x, y)

# Load an image from disk. Returns a LoadedImageData whose is_valid() is false
# on failure (handle sentinel 0) — non-optional for the same one-shot-guard
# reason as load_image_resource (see its comment).
# DEPRECATED: use load_image_resource() instead
fn load_image(path: text) -> LoadedImageData:
    val h = rt_image_load(path)
    if h <= 0:
        return LoadedImageData(handle: 0, width: 0, height: 0, channels: 0)
    val w = rt_image_width(h)
    val ht = rt_image_height(h)
    val ch = rt_image_channels(h)
    LoadedImageData(handle: h, width: w, height: ht, channels: ch)

# Free image resources — DEPRECATED: use Image.close() instead.
# Consuming drop: returns the value with its handle zeroed so the caller's
# reassignment (`img = free_image(img)`) makes a second call a defined no-op.
# Zeroing the caller's copy in place is not reliable (by-value parameter), and
# an unzeroed handle makes a second free_image() a double-free crash.
fn free_image(img: LoadedImageData) -> LoadedImageData:
    if img.is_valid():
        rt_image_free(img.handle)
    LoadedImageData(handle: 0, width: img.width, height: img.height, channels: img.channels)

# create_image_data removed — use image_data.spl's version instead
# (both provided the same interface but with different underlying implementations)
