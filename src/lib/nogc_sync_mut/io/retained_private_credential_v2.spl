# Common configured credential entrypoint. Linux retains the unchanged V1
# implementation; Windows uses actual protected retained file capabilities.
# Selection is target-owned, never supplied by a peer request or path spelling.
use std.nogc_sync_mut.io.retained_file.{RetainedPrivateCredentialV1, retained_private_credential_open_v1,
    retained_private_credential_state_v1, retained_private_credential_read_v1,
    retained_private_credential_publish_v1, retained_private_credential_close_v1}
use std.nogc_sync_mut.io.windows_retained_private_credential_v2.*

pub enum RetainedPrivateCredentialV2:
    Legacy(owner: RetainedPrivateCredentialV1)
    Windows(owner: WindowsRetainedPrivateCredentialV2)

pub struct RetainedPrivateCredentialOpenTurnV2:
    owner: RetainedPrivateCredentialV2?
    state: text
    error: text

pub struct RetainedPrivateCredentialStateTurnV2:
    owner: RetainedPrivateCredentialV2
    state: text
    error: text

pub struct RetainedPrivateCredentialReadTurnV2:
    owner: RetainedPrivateCredentialV2
    state: text
    bytes: [u8]
    error: text

pub struct RetainedPrivateCredentialMutationTurnV2:
    owner: RetainedPrivateCredentialV2
    state: text
    error: text
    completed: bool
    consumed: bool
    publication_state: text

pub fn retained_private_credential_open_v2(path: text) -> RetainedPrivateCredentialOpenTurnV2:
    @when(os="windows"):
    val opened = windows_retained_private_credential_open_v2(path)
    val owner: RetainedPrivateCredentialV2? = if opened.owner.is_none(): nil else: Some(RetainedPrivateCredentialV2.Windows(opened.owner.unwrap()))
    RetainedPrivateCredentialOpenTurnV2(owner: owner, state: opened.state, error: opened.error)
    @else:
    val opened = retained_private_credential_open_v1(path)
    val owner: RetainedPrivateCredentialV2? = if opened.owner.is_none(): nil else: Some(RetainedPrivateCredentialV2.Legacy(opened.owner.unwrap()))
    RetainedPrivateCredentialOpenTurnV2(owner: owner, state: opened.state, error: opened.error)
    @end

pub fn retained_private_credential_state_v2(owner: RetainedPrivateCredentialV2) -> RetainedPrivateCredentialStateTurnV2:
    match owner:
        case RetainedPrivateCredentialV2.Legacy(retained):
            val observed = retained_private_credential_state_v1(retained)
            RetainedPrivateCredentialStateTurnV2(owner: owner, state: observed.state, error: observed.error)
        case RetainedPrivateCredentialV2.Windows(retained):
            val observed = windows_retained_private_credential_state_v2(retained)
            RetainedPrivateCredentialStateTurnV2(owner: owner, state: observed.state, error: observed.error)

pub fn retained_private_credential_read_v2(owner: RetainedPrivateCredentialV2) -> RetainedPrivateCredentialReadTurnV2:
    match owner:
        case RetainedPrivateCredentialV2.Legacy(retained):
            val observed = retained_private_credential_read_v1(retained)
            RetainedPrivateCredentialReadTurnV2(owner: owner, state: observed.state, bytes: observed.bytes, error: observed.error)
        case RetainedPrivateCredentialV2.Windows(retained):
            val observed = windows_retained_private_credential_read_v2(retained)
            RetainedPrivateCredentialReadTurnV2(owner: owner, state: observed.state, bytes: observed.bytes, error: observed.error)

pub fn retained_private_credential_publish_v2(owner: RetainedPrivateCredentialV2, initial: [u8], ready: [u8]) -> RetainedPrivateCredentialMutationTurnV2:
    match owner:
        case RetainedPrivateCredentialV2.Legacy(retained):
            val observed = retained_private_credential_publish_v1(retained, initial, ready)
            RetainedPrivateCredentialMutationTurnV2(owner: owner, state: observed.state, error: observed.error,
                completed: observed.completed, consumed: observed.consumed, publication_state: "legacy-unreported")
        case RetainedPrivateCredentialV2.Windows(retained):
            val observed = windows_retained_private_credential_publish_v2(retained, initial, ready)
            RetainedPrivateCredentialMutationTurnV2(owner: owner, state: observed.state, error: observed.error,
                completed: observed.completed, consumed: observed.consumed, publication_state: observed.publication_state)

pub fn retained_private_credential_close_v2(owner: RetainedPrivateCredentialV2) -> RetainedPrivateCredentialMutationTurnV2:
    match owner:
        case RetainedPrivateCredentialV2.Legacy(retained):
            val observed = retained_private_credential_close_v1(retained)
            RetainedPrivateCredentialMutationTurnV2(owner: owner, state: observed.state, error: observed.error,
                completed: observed.completed, consumed: observed.consumed, publication_state: "legacy-unreported")
        case RetainedPrivateCredentialV2.Windows(retained):
            val observed = windows_retained_private_credential_close_v2(retained)
            RetainedPrivateCredentialMutationTurnV2(owner: owner, state: observed.state, error: observed.error,
                completed: observed.completed, consumed: observed.consumed, publication_state: observed.publication_state)

export RetainedPrivateCredentialV2, RetainedPrivateCredentialOpenTurnV2, RetainedPrivateCredentialStateTurnV2
export RetainedPrivateCredentialReadTurnV2, RetainedPrivateCredentialMutationTurnV2
export retained_private_credential_open_v2, retained_private_credential_state_v2, retained_private_credential_read_v2
export retained_private_credential_publish_v2, retained_private_credential_close_v2
