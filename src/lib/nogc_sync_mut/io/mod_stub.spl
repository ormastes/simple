# Shared I/O module for CLI apps.
# Hosted operations delegate to the no-GC sync backend owners instead of
# duplicating definitions. Local duplicate fn bodies were removed 2026-08-10:
# under co-compilation every duplicate-named public fn collides in the seed's
# bare-name symbol table (Class B silent-win misdispatch — see
# doc/08_tracking/bug/duplicate_public_symbols_differing_return_types_jit_misdispatch_2026-08-09.md).
# The old "requires Rust SFFI" error stubs could silently WIN over the real
# app/io and sffi/cli implementations, which is the historical
# "bin/simple lost all subcommands" failure shape. Import cli_* from
# std.nogc_sync_mut.sffi.cli or the app handlers directly.
export use std.nogc_sync_mut.io.file_ops.{
    file_exists, file_read, file_write, file_copy, file_delete,
    file_atomic_write, file_hash_sha256, file_append, file_modified_time,
    file_remove, file_size
}
export use std.nogc_sync_mut.io.dir_ops.{
    dir_create, dir_create_all, dir_walk, dir_remove_all, is_dir
}
export use std.nogc_sync_mut.io.env_ops.{cwd, home, env_get}
export use std.nogc_sync_mut.io.process_ops.{
    process_run, process_run_timeout, process_output
}
