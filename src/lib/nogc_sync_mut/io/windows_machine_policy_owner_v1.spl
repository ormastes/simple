    for index in 0..size: bytes.push(volatile_read_u8(state.arena + 66048 + index) as u8)
    Ok(bytes)

@unsafe(reason: "same-thread canonical close clears each resource only after its exact native release succeeds", capabilities: [ffi, raw_ptr])
fn machine_close_v1(slot: i64, generation: i64) -> text:
    if machine_entry_v1().is_err(): return "retained"
    val loaded = machine_slot_v1(slot, generation)
    if loaded.is_err(): return "stale"
    var state = loaded.unwrap()
    state.ready = false
    state.closing = true
    machine_slots_v1[slot] = state
    if state.descriptor != 0:
        if LocalFree(state.descriptor) != 0: return "retained"
        state.descriptor = 0
        machine_slots_v1[slot] = state
    if state.impersonation_token != 0:
        if CloseHandle(state.impersonation_token) == 0: return "retained"
        state.impersonation_token = 0
        machine_slots_v1[slot] = state
    var index = state.handles.len() - 1
    while index >= 0:
        if state.handles[index] != 0:
            if CloseHandle(state.handles[index]) == 0: return "retained"
            state.handles[index] = 0
            machine_slots_v1[slot] = state
        index = index - 1
