@unsafe(reason: "raw SDL2 provider ABI; negative status sentinel means unavailable provider", capabilities: [ffi])
extern fn rt_sdl2_get_ticks_ms() -> i64
@unsafe(reason: "raw SDL2 provider ABI; negative status sentinel means unavailable counter and INT64_MAX is saturation", capabilities: [ffi])
