# SDL2 Windowing System SFFI Bindings
#
# SFFI pattern for SDL2 cross-platform windowing.
# Provides window creation, event handling, and input management.
# Replaces the previous Winit-based windowing system with a pure C SDL2 backend.
#
# Pixel format: each i64 is packed as R*16777216 + G*65536 + B*256 + A
# The pixel buffer is passed as [i64] (SplArray* of i64 values).

use common.io.window_event.{
    WINDOW_MOD_SHIFT,
    WINDOW_MOD_CTRL,
    WINDOW_MOD_ALT,
    WINDOW_MOD_SUPER,
}

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI to C runtime_sdl2.c)
# ============================================================================

# --- Initialization ---
@unsafe(reason: "raw SDL2 provider ABI", capabilities: [ffi])
extern fn rt_sdl2_init() -> i64
@unsafe(reason: "raw SDL2 provider ABI", capabilities: [ffi])
extern fn rt_sdl2_quit()

# --- Window Management ---
@unsafe(reason: "raw SDL2 provider ABI", capabilities: [ffi])
extern fn rt_sdl2_create_window(title: text, width: i64, height: i64) -> i64
@unsafe(reason: "raw SDL2 provider ABI", capabilities: [ffi])
extern fn rt_sdl2_destroy_window(handle: i64)
@unsafe(reason: "raw SDL2 generation-checked size ABI; negative sentinel means invalid handle", capabilities: [ffi])
extern fn rt_sdl2_get_window_width(handle: i64) -> i64
@unsafe(reason: "raw SDL2 generation-checked size ABI; negative sentinel means invalid handle", capabilities: [ffi])
extern fn rt_sdl2_get_window_height(handle: i64) -> i64
@unsafe(reason: "raw SDL2 borrowed title status ABI; false sentinel means invalid handle or title", capabilities: [ffi])
extern fn rt_sdl2_set_window_title(handle: i64, title: text) -> bool

# --- Framebuffer Present ---
# pixels is [i64] (SplArray* of packed RGBA i64 values)
@unsafe(reason: "raw SDL2 provider ABI", capabilities: [ffi])
extern fn rt_sdl2_present_rgba(window_handle: i64, pixels: [i64], width: i64, height: i64) -> bool

# --- Event Polling ---
# Returns event type: 0=none, 1=quit, 2=keydown, 3=keyup,
#   4=mousemotion, 5=mousedown, 6=mouseup, 7=mousewheel,
#   8=windowevent, 9=textinput
@unsafe(reason: "raw SDL2 provider ABI; negative status sentinel means unavailable provider and zero means no supported event", capabilities: [ffi])
extern fn rt_sdl2_poll_event() -> i64
@unsafe(reason: "raw SDL2 provider ABI; negative status sentinel means unavailable provider and zero means timeout or no supported event", capabilities: [ffi])
extern fn rt_sdl2_wait_event(timeout_ms: i64) -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be keyboard input", capabilities: [ffi])
extern fn rt_sdl2_event_key_code() -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be keyboard input", capabilities: [ffi])
extern fn rt_sdl2_event_key_sym() -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be keyboard input", capabilities: [ffi])
extern fn rt_sdl2_event_key_mod() -> i64
@unsafe(reason: "raw SDL2 provider ABI; nonnull borrowed text is valid until the next event poll", capabilities: [ffi])
extern fn rt_sdl2_event_text() -> text
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be mouse input", capabilities: [ffi])
extern fn rt_sdl2_event_mouse_x() -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be mouse input", capabilities: [ffi])
extern fn rt_sdl2_event_mouse_y() -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be a mouse button event", capabilities: [ffi])
extern fn rt_sdl2_event_mouse_button() -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be mouse wheel input", capabilities: [ffi])
extern fn rt_sdl2_event_wheel_x() -> i64
@unsafe(reason: "raw SDL2 provider ABI; zero sentinel requires the cached event to be mouse wheel input", capabilities: [ffi])
extern fn rt_sdl2_event_wheel_y() -> i64

# --- Keyboard State (polled) ---
@unsafe(reason: "raw SDL2 provider ABI; negative status sentinel means unavailable provider or invalid scancode", capabilities: [ffi])
extern fn rt_sdl2_is_key_pressed(scancode: i64) -> i64

# --- Mouse State (polled) ---
@unsafe(reason: "raw SDL2 provider ABI; INT64_MIN sentinel means unavailable provider", capabilities: [ffi])
extern fn rt_sdl2_get_mouse_x() -> i64
@unsafe(reason: "raw SDL2 provider ABI; INT64_MIN sentinel means unavailable provider", capabilities: [ffi])
