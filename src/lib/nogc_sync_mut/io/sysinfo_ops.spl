# System Information - Pure Simple I/O
# Extracted from mod.spl for modularity

# Extern fn declarations (runtime resolves at file level)
@unsafe(reason: "raw process identifier ABI; non-positive values are invalid sentinels", capabilities: [ffi])
extern fn rt_getpid() -> i64
@unsafe(reason: "raw nullable hostname ABI; nil or empty text means provider failure", capabilities: [ffi])
extern fn rt_hostname() -> text?
@unsafe(reason: "raw parallelism ABI; non-positive values are invalid sentinels", capabilities: [ffi])
extern fn rt_thread_available_parallelism() -> i64
extern fn rt_process_hwm_kib() -> i64

@always_inline
fn _getpid_raw() -> i64:
    unsafe(capabilities: [ffi]):
        rt_getpid()

@always_inline
fn _hostname_raw() -> text?:
    unsafe(capabilities: [ffi]):
        rt_hostname()

@always_inline
fn _cpu_count_raw() -> i64:
    unsafe(capabilities: [ffi]):
        rt_thread_available_parallelism()

# ============================================================================
# System Information Functions
# ============================================================================

@unsafe(reason: "legacy compatibility API exposes the raw non-positive PID sentinel", capabilities: [ffi])
fn getpid() -> i64:
    _getpid_raw()

@unsafe(reason: "legacy compatibility API collapses hostname provider failure to empty text", capabilities: [ffi])
fn hostname() -> text:
    _hostname_raw() ?? ""

@unsafe(reason: "legacy compatibility API exposes the raw non-positive CPU-count sentinel", capabilities: [ffi])
fn cpu_count() -> i64:
    _cpu_count_raw()

fn getpid_checked() -> Result<i64, text>:
    val pid = _getpid_raw()
    if pid <= 0:
        return Err("rt_getpid returned a non-positive process identifier")
    Ok(pid)

fn hostname_checked() -> Result<text, text>:
    val value = _hostname_raw()
    if value == nil or value == "":
        return Err("rt_hostname returned no hostname")
    Ok(value)

fn cpu_count_checked() -> Result<i64, text>:
    val count = _cpu_count_raw()
    if count <= 0:
        return Err("rt_thread_available_parallelism returned a non-positive count")
    Ok(count)

fn process_peak_rss_kb() -> i64:
    rt_process_hwm_kib()

fn path_basename(path: text) -> text:
    val normalized = path.replace("\\", "/")
    val parts = normalized.split("/")
    if parts.len() > 0:
        parts[parts.len() - 1]
    else:
        path
