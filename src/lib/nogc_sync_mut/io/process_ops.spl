# Platform detection - inlined to avoid bootstrap runtime limitations
fn _is_windows_platform() -> bool:
    val os_env = env_get("OS")
    if os_env == nil:
        false
    else:
        os_env.lower().contains("windows")

# ============================================================================
# Process Result struct
# ============================================================================

pub struct ProcessResult:
    stdout: text
    stderr: text
    exit_code: i64
    limit_exceeded: bool
    limit_type: text

# ============================================================================
# Process Execution
# ============================================================================

fn _resolve_process_cmd(cmd: text) -> text:
    var resolved_cmd = cmd
    if _is_windows_platform():
        if not cmd.ends_with(".exe") and not cmd.ends_with(".cmd") and not cmd.ends_with(".bat"):
            val check = rt_process_run("where", [cmd + ".exe"])
            if check.2 == 0:
                resolved_cmd = cmd + ".exe"
    else:
        if not cmd.contains("/"):
            val check = rt_process_run("which", [cmd])
            if check.2 == 0 and check.0.trim() != "":
                resolved_cmd = check.0.trim()
    resolved_cmd

fn process_run(cmd: text, args: [text]) -> (text, text, i64):
    val resolved_cmd = _resolve_process_cmd(cmd)
    proc_slot_acquire()
    val result = rt_process_run(resolved_cmd, args)
    proc_slot_release()
    result

pub fn process_run_bounded(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64):
    val resolved_cmd = _resolve_process_cmd(cmd)
    proc_slot_acquire()
    val (stdout, stderr, exit_code) = rt_process_run_bounded(resolved_cmd, args, timeout_ms, max_output_bytes)
    proc_slot_release()
    (stdout, stderr, exit_code)

# --------------------------------------------------------------------------
# Timeout-vs-kill discrimination for process_run_bounded results.
#
# rt_process_run_bounded has THREE parallel implementations (all read-only
# references, verified against a live probe 2026-08-18); their timeout markers
# differ, but every one of them appends a marker as the LAST bytes of stderr
# on a deadline expiry and returns exit_code -1:
#   - Rust runtime (env_process.rs:1275):      trailing "\nTIMEOUT\n"
#   - interpreter extern (system.rs:161-165):  trailing "Process timed out"
#     (this is the path a spec child under `bin/simple test` actually takes)
#   - C runtime (runtime_process.c:88-100):    trailing "[TIMEOUT: Process
#     killed after <N>ms]"
# Death by signal maps to 128 + signo on the Rust-runtime path
# (exit_status_to_code, env_process.rs:22-34: SIGKILL -> 137, SIGTERM -> 143),
# but the interpreter-extern BOUNDED path still collapses it to -1
# (`status.code().unwrap_or(-1)`, system.rs:~172) and the C runtime collapses
# it at runtime_process.c:1481 (`if (rt_fork_parent_signaled()) code = -1;`).
# Closing THAT residue needs a Rust/C runtime change — see
# doc/08_tracking/bug/test_runner_emits_no_result_summary_silent_exit0_2026-08-17.md.
# So: timeout is discriminable on every path; signal-vs-spawn-failure only
# where 128+signo survives. Additive helpers only — tuple shape unchanged.
# --------------------------------------------------------------------------

pub fn process_bounded_timed_out(exit_code: i64, stderr: text) -> bool:
    """True iff a process_run_bounded result means the deadline expired
    (the runtime killed the child), per the trailing-marker contracts above.
    Anchored to the END of stderr so a child that merely PRINTS the words
    cannot classify as a timeout unless it also dies with exit_code -1."""
    if exit_code != -1:
        return false
    if stderr.ends_with("\nTIMEOUT\n"):
        return true
    if stderr.ends_with("Process timed out"):
        return true
    stderr.ends_with("ms]") and stderr.contains("[TIMEOUT: Process killed after ")

pub fn process_bounded_kill_signal(exit_code: i64) -> i64:
    """Signal number when a process_run_bounded child died by signal
    (exit_code = 128 + signo), else 0. A timeout is NOT a signal death here:
    every runtime reports timeout as -1 + marker, never 128+9. Returns 0 on
    the paths that still collapse signal deaths to -1 (see block comment)."""
    if exit_code > 128 and exit_code < 192:
        return exit_code - 128
    0

pub fn process_spawn_piped(cmd: text, args: [text]) -> i64:
    rt_process_spawn_piped(cmd, args)

pub fn browser_renderer_spawn_sandboxed(cmd: text, args: [text]) -> i64:
    rt_browser_renderer_spawn_sandboxed(cmd, args)

pub fn browser_renderer_sandbox_enter() -> bool:
    rt_browser_renderer_sandbox_enter()

pub fn process_write_stdin(pid: i64, data: text) -> bool:
    rt_process_write_stdin(pid, data)

pub fn process_write_stdin_some(pid: i64, data: text, offset: i64, max_bytes: i64) -> i64:
    rt_process_write_stdin_some(pid, data, data.len(), offset, max_bytes)

pub fn process_read_stdout(pid: i64) -> text:
    rt_process_read_stdout(pid)

pub fn process_is_piped_alive(pid: i64) -> bool:
    rt_process_is_alive(pid)

pub fn process_close_piped(pid: i64) -> bool:
    rt_process_close_piped(pid)

fn process_run_timeout_unix(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    """Unix implementation using the native async process facade."""
    val effective_timeout = if timeout_ms <= 0: 120000 else: timeout_ms

    var temp_dir = env_get("TMPDIR")
    if temp_dir == nil or temp_dir == "":
        temp_dir = "/tmp"

    val pid_str = "{getpid()}"
    val time_str = "{time_now_unix_micros()}"
    val stdout_file = "{temp_dir}/simple_out_{pid_str}_{time_str}.txt"
    val stderr_file = "{temp_dir}/simple_err_{pid_str}_{time_str}.txt"

    var command_parts: [text] = []
    val cmd_escaped = cmd.replace("'", "'\\''")
    command_parts.push("'{cmd_escaped}'")
    for arg in args:
        val arg_escaped = arg.replace("'", "'\\''")
        command_parts.push("'{arg_escaped}'")
    val command_line = command_parts.join(" ")
    val redirected_cmd = "exec {command_line} > '{stdout_file}' 2> '{stderr_file}'"

    proc_slot_acquire()
    val pid = rt_process_spawn_async("/bin/sh", ["-c", redirected_cmd])
    val exit_code = if pid <= 0: -1 else: rt_process_wait(pid, effective_timeout)
    val timed_out = pid > 0 and (exit_code == -2 or (exit_code == -1 and rt_process_is_running(pid)))
    if timed_out:
        rt_process_kill(pid)
    proc_slot_release()

    var stdout = ""
    var stderr = ""
    if file_exists(stdout_file):
        stdout = rt_file_read_text(stdout_file)
        file_delete(stdout_file)
    if file_exists(stderr_file):
        stderr = rt_file_read_text(stderr_file)
        file_delete(stderr_file)

    if pid <= 0:
        (stdout, stderr + "\n[ERROR: failed to spawn process '{cmd}']", -1)
    else if timed_out:
        val timeout_secs = (effective_timeout + 999) / 1000
        (stdout, stderr + "\n[TIMEOUT: Process killed after {timeout_secs}s]", -1)
    else:
        (stdout, stderr, exit_code)

fn process_run_timeout_windows(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    """Windows implementation using async spawn + temp files"""
    val effective_timeout = if timeout_ms <= 0: 120000 else: timeout_ms

    var temp_dir = env_get("TEMP")
    if temp_dir == "":
        temp_dir = env_get("TMP")
    if temp_dir == "":
        temp_dir = "C:\\Windows\\Temp"

    val pid_str = "{getpid()}"
    val time_str = "{time_now_unix_micros()}"
    val stdout_file = "{temp_dir}\\simple_out_{pid_str}_{time_str}.txt"
    val stderr_file = "{temp_dir}\\simple_err_{pid_str}_{time_str}.txt"

    val args_str = args.join(" ")

    val full_cmd = if args_str == "":
        "{cmd} > \"{stdout_file}\" 2> \"{stderr_file}\""
    else:
        "{cmd} {args_str} > \"{stdout_file}\" 2> \"{stderr_file}\""

    proc_slot_acquire()
    val pid = rt_process_spawn_async("cmd", ["/c", full_cmd])
    val exit_code = rt_process_wait(pid, effective_timeout)
    proc_slot_release()

    var stdout = ""
    var stderr = ""

    if file_exists(stdout_file):
        stdout = rt_file_read_text(stdout_file)
        file_delete(stdout_file)

    if file_exists(stderr_file):
        stderr = rt_file_read_text(stderr_file)
        file_delete(stderr_file)

    if exit_code == -2:
        rt_process_kill(pid)
        val timeout_secs = effective_timeout / 1000
        (stdout, stderr + "\n[TIMEOUT: Process killed after {timeout_secs}s]", -1)
    else:
        (stdout, stderr, exit_code)

fn process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    """Platform-agnostic timeout wrapper"""
    if _is_windows_platform():
        process_run_timeout_windows(cmd, args, timeout_ms)
    else:
        process_run_timeout_unix(cmd, args, timeout_ms)

fn process_run_timeout_live(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    """
    Same contract and same timeout/kill semantics as process_run_timeout_unix,
    but relays the child's stdout/stderr to OUR stdout/stderr as they are
    produced instead of withholding everything until the child exits.

    A long-running child was previously indistinguishable from a hang:
    nothing appeared until the whole subprocess terminated. See
    src/app/io/process_ops.spl's process_run_timeout_live, which fixes the
    same defect for the app-layer duplicate of this helper --
    doc/08_tracking/bug/native_build_direct_seed_jit_hang_2026-07-30.md has
    the eight-investigation writeup that root-caused it.

    NOTE ON DEADLINE MECHANISM: unlike the app-layer copy (which shells out
    to `timeout --kill-after` and only polls for visibility), this file's
    process_run_timeout_unix never used `timeout` -- it enforces the
    deadline itself via rt_process_wait()'s timeout_ms budget plus an
    explicit rt_process_kill() when that budget is exhausted. This function
    preserves that exact mechanism and the exact same total budget
    (effective_timeout); it only changes the *granularity* of the wait (many
    small polls instead of one big blocking wait) so output can be relayed
    incrementally, and defeats the CHILD's own full-buffering (stdout/stderr
    are not a tty here, they're redirected to a temp file) via `stdbuf -oL
    -eL`, the same trick used by the app-layer fix.
    """
    if _is_windows_platform():
        return process_run_timeout_windows(cmd, args, timeout_ms)

    val effective_timeout = if timeout_ms <= 0: 120000 else: timeout_ms

    var temp_dir = env_get("TMPDIR")
    if temp_dir == nil or temp_dir == "":
        temp_dir = "/tmp"

    val pid_str = "{getpid()}"
    val time_str = "{time_now_unix_micros()}"
    val stdout_file = "{temp_dir}/simple_out_{pid_str}_{time_str}.txt"
    val stderr_file = "{temp_dir}/simple_err_{pid_str}_{time_str}.txt"

    var command_parts: [text] = ["stdbuf", "-oL", "-eL"]
    val cmd_escaped = cmd.replace("'", "'\\''")
    command_parts.push("'{cmd_escaped}'")
    for arg in args:
        val arg_escaped = arg.replace("'", "'\\''")
        command_parts.push("'{arg_escaped}'")
    val command_line = command_parts.join(" ")
    val redirected_cmd = "exec {command_line} > '{stdout_file}' 2> '{stderr_file}'"

    proc_slot_acquire()
    val pid = rt_process_spawn_async("/bin/sh", ["-c", redirected_cmd])
    if pid <= 0:
        proc_slot_release()
        return ("", "\n[ERROR: failed to spawn process '{cmd}']", -1)

    # Poll in small increments instead of one blocking wait, relaying newly
    # appended bytes after every poll. The total time budget across all
    # polls still equals `effective_timeout` -- exactly the same budget
    # process_run_timeout_unix's single blocking rt_process_wait() call
    # enforces -- so overall timeout behaviour is unchanged; only the
    # granularity of observation changes.
    val poll_quantum_ms: i64 = 500
    var elapsed_ms: i64 = 0
    var stdout_relayed = 0
    var stderr_relayed = 0
    var exit_code: i64 = -2
    while exit_code == -2 and elapsed_ms < effective_timeout:
        val remaining = effective_timeout - elapsed_ms
        val quantum = if remaining < poll_quantum_ms: remaining else: poll_quantum_ms
        exit_code = rt_process_wait(pid, quantum)
        elapsed_ms = elapsed_ms + quantum
        if file_exists(stdout_file):
            val current = rt_file_read_text(stdout_file)
            if current.len() > stdout_relayed:
                print current[stdout_relayed:current.len()]
                rt_stdout_flush()
                stdout_relayed = current.len()
        if file_exists(stderr_file):
            val current_err = rt_file_read_text(stderr_file)
            if current_err.len() > stderr_relayed:
                eprint(current_err[stderr_relayed:current_err.len()])
                rt_stderr_flush()
                stderr_relayed = current_err.len()

    val timed_out = exit_code == -2 or (exit_code == -1 and rt_process_is_running(pid))
    if timed_out:
        rt_process_kill(pid)
    proc_slot_release()

    var stdout = ""
    var stderr = ""
    if file_exists(stdout_file):
        stdout = rt_file_read_text(stdout_file)
        file_delete(stdout_file)
    if file_exists(stderr_file):
        stderr = rt_file_read_text(stderr_file)
        file_delete(stderr_file)

    if timed_out:
        val timeout_secs = (effective_timeout + 999) / 1000
        (stdout, stderr + "\n[TIMEOUT: Process killed after {timeout_secs}s]", -1)
    else:
        (stdout, stderr, exit_code)

fn _process_run_with_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64, max_output_bytes: i64) -> ProcessResult:
    """
    Execute a process with resource limits enforced via ulimit.

    Args:
        cmd: Command to execute
        args: Command arguments
        timeout_ms: Wall-clock timeout in milliseconds
        memory_bytes: Virtual memory limit in bytes
        cpu_seconds: CPU time limit in seconds
        max_fds: Maximum file descriptors
        max_procs: Maximum processes

    Returns:
        ProcessResult with limit violation detection
    """
    if _is_windows_platform():
        eprint("[WARNING] Resource limits not supported on Windows - using timeout only")
        val effective_timeout = if timeout_ms <= 0: 0 else: timeout_ms
        val (stdout, stderr, exit_code) = if max_output_bytes > 0:
            process_run_bounded(cmd, args, effective_timeout, max_output_bytes)
        elif effective_timeout <= 0:
            process_run(cmd, args)
        else:
            process_run_timeout(cmd, args, effective_timeout)
        val timed_out = effective_timeout > 0 and exit_code == -1 and (stderr.contains("TIMEOUT") or stderr.contains("timed out"))
        return ProcessResult(
            stdout: stdout,
            stderr: stderr,
            exit_code: exit_code,
            limit_exceeded: timed_out,
            limit_type: if timed_out: "timeout" else: ""
        )

    val memory_kb = if memory_bytes > 0: memory_bytes / 1024 else: 0

    var limit_parts: [text] = []
    if memory_kb > 0:
        limit_parts.push("ulimit -v {memory_kb} 2>/dev/null || true; ")
    if cpu_seconds > 0:
        limit_parts.push("ulimit -t {cpu_seconds} 2>/dev/null || true; ")
    if max_fds > 0:
        limit_parts.push("ulimit -n {max_fds} 2>/dev/null || true; ")
    if max_procs > 0:
        limit_parts.push("ulimit -u {max_procs} 2>/dev/null || true; ")
    val limit_cmds = limit_parts.join("")

    var arg_parts: [text] = []
    for arg in args:
        val escaped = arg.replace("'", "'\\''")
        arg_parts.push("'{escaped}'")
    val args_str = arg_parts.join(" ")

    # The command word goes through /bin/sh -c exactly like the arguments do,
    # so it needs the SAME single-quote escaping. Interpolating it raw split
    # any cmd containing a space into two shell words (a path like
    # "/tmp/dir with space/tool" became "/tmp/dir" plus stray words) and let
    # shell metacharacters in cmd execute, while process_run/
    # process_run_timeout on the same file preserve argv exactly. See
    # todo_db row 573 (area runtime, P1).
    val cmd_escaped = "'" + cmd.replace("'", "'\\''") + "'"
    val full_cmd = if args_str == "": "{cmd_escaped}" else: "{cmd_escaped} {args_str}"
    val wrapped_cmd = if timeout_ms > 0:
        val timeout_sec = 1 + (timeout_ms - 1) / 1000
        "{limit_cmds}exec timeout --kill-after=5s {timeout_sec}s {full_cmd}"
    else:
        "{limit_cmds}exec {full_cmd}"

    proc_slot_acquire()
    val (stdout, stderr, code) = if max_output_bytes > 0:
        rt_process_run_bounded("/bin/sh", ["-c", wrapped_cmd], timeout_ms, max_output_bytes)
    else:
        rt_process_run("/bin/sh", ["-c", wrapped_cmd])
    proc_slot_release()

    var limit_exceeded = false
    var limit_type = ""

    if code == -1 and (stderr.contains("TIMEOUT") or stderr.contains("timed out")):
        limit_exceeded = true
        limit_type = "timeout"
    elif code == 124:
        limit_exceeded = true
        limit_type = "timeout"
    elif code == 137:
        limit_exceeded = true
        limit_type = "timeout"
    elif code == 139:
        limit_exceeded = true
        limit_type = "memory"
    else:
        val stderr_lower = stderr.lower()
        if stderr_lower.contains("cpu time limit exceeded") or stderr_lower.contains("cpu time"):
            limit_exceeded = true
            limit_type = "cpu"
        elif stderr_lower.contains("cannot allocate memory") or stderr_lower.contains("out of memory"):
            limit_exceeded = true
            limit_type = "memory"
        elif stderr_lower.contains("too many open files"):
            limit_exceeded = true
            limit_type = "fds"
        elif stderr_lower.contains("resource temporarily unavailable"):
            limit_exceeded = true
            limit_type = "procs"

    ProcessResult(
        stdout: stdout,
        stderr: stderr,
        exit_code: code,
        limit_exceeded: limit_exceeded,
        limit_type: limit_type
    )

pub fn process_run_with_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> ProcessResult:
    _process_run_with_limits(cmd, args, timeout_ms, memory_bytes, cpu_seconds, max_fds, max_procs, 0)

pub fn process_run_with_limits_bounded(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64, max_output_bytes: i64) -> ProcessResult:
    _process_run_with_limits(cmd, args, timeout_ms, memory_bytes, cpu_seconds, max_fds, max_procs, max_output_bytes)

pub fn process_output(cmd: text, args: [text]) -> text:
    val (stdout, stderr, code) = process_run(cmd, args)
    stdout

# ============================================================================
# Shell Functions
# ============================================================================

fn _shell_command_args(command: text) -> (text, [text]):
    if _is_windows_platform():
        ("cmd.exe", ["/c", command])
    else:
        ("/bin/sh", ["-c", command])

pub fn shell(command: text) -> ProcessResult:
    val (shell_path, shell_args) = _shell_command_args(command)
    proc_slot_acquire()
    val (stdout, stderr, code) = rt_process_run(shell_path, shell_args)
    proc_slot_release()
    ProcessResult(stdout: stdout, stderr: stderr, exit_code: code, limit_exceeded: false, limit_type: "")

pub fn shell_bool(command: text) -> bool:
    val (shell_path, shell_args) = _shell_command_args(command)
    proc_slot_acquire()
    val (_stdout, _stderr, code) = rt_process_run(shell_path, shell_args)
    proc_slot_release()
    code == 0

pub fn shell_output_default(command: text, default: text) -> text:
    val (shell_path, shell_args) = _shell_command_args(command)
    proc_slot_acquire()
    val (stdout, _stderr, code) = rt_process_run(shell_path, shell_args)
    proc_slot_release()
    if code == 0:
        stdout
    else:
        default

pub fn shell_output_trimmed(command: text, default: text) -> text:
    val (shell_path, shell_args) = _shell_command_args(command)
    proc_slot_acquire()
    val (stdout, _stderr, code) = rt_process_run(shell_path, shell_args)
    proc_slot_release()
    if code == 0:
        stdout.trim()
    else:
        default

pub fn shell_lines(command: text) -> [text]:
    val (shell_path, shell_args) = _shell_command_args(command)
    proc_slot_acquire()
    val (stdout, _stderr, code) = rt_process_run(shell_path, shell_args)
    proc_slot_release()
    if code == 0 and stdout.?:
        stdout.trim().split("\n")
    else:
        []

pub fn shell_int(command: text, default: i64) -> i64:
    val (shell_path, shell_args) = _shell_command_args(command)
    proc_slot_acquire()
    val (stdout, _stderr, code) = rt_process_run(shell_path, shell_args)
    proc_slot_release()
    if code == 0:
        val trimmed = stdout.trim()
        if trimmed.len() > 0:
            int(trimmed)
        else:
            default
    else:
        default

# ============================================================================
# Async Process Management
# ============================================================================

fn process_spawn_async(cmd: text, args: [text]) -> i64:
    """
    Spawn a process asynchronously (non-blocking).

    Returns: Process ID (pid) on success, -1 on failure.

    Example:
        val pid = process_spawn_async("sleep", ["10"])
        # ... do other work ...
        val exit_code = process_wait(pid, 0)  # Wait for completion
    """
    rt_process_spawn_async(cmd, args)

fn process_wait(pid: i64, timeout_ms: i64) -> i64:
    """
    Wait for a process to complete.

    Args:
        pid: Process ID from process_spawn_async
        timeout_ms: Timeout in milliseconds (0 = wait forever)

    Returns:
        Exit code on success
        -1 on error
        -2 on timeout
    """
    if pid <= 0:
        return -1
    rt_process_wait(pid, timeout_ms)

fn process_is_running(pid: i64) -> bool:
    """
    Check if a process is still running.

    Returns: true if running, false if exited or invalid pid
    """
    rt_process_is_running(pid)

fn process_kill(pid: i64) -> bool:
    """
    Terminate a running process.

    Sends SIGTERM (Unix) or TerminateProcess (Windows).
    On Unix, escalates to SIGKILL if process doesn't exit.

    Returns: true on success, false on failure
    """
    if pid <= 1:
        return false
    rt_process_kill(pid)

# ============================================================================
# Eprint (real stderr, fd 2)
# ============================================================================

# This function SHADOWS the `eprint` builtin for every module that imports this
# one, directly or transitively (interpreter_call/mod.rs Priority-1 `has_local_def`
# escape hatch). It used to be `print "[STDERR] {msg}"`, which sent every
# diagnostic in the self-hosted compiler to fd 1 with a cosmetic text prefix --
# `prog > out.txt 2> err.log` put the errors in out.txt and left err.log empty.
# It must write the real fd 2. Do NOT reintroduce a `print` fallback here.
# See doc/08_tracking/bug/eprint_in_io_runtime_module_is_rerouted_to_stdout_2026-08-10.md
fn eprint(msg: text):
    rt_stderr_write("{msg}\n")
