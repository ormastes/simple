"""
## Purpose and audience
Typed PASS/SKIP/FAIL wrapper around the CUDA driver-API FFI, promised by
doc/03_plan/sys_test/cuda_host_validation_2026-07-11.md. Audience: the GPU-lane
implementer closing that plan's checkboxes, and the acceptance spec
test/03_system/plan_acceptance/cuda_host_validation_spec.spl which pins this
module's interface.

## Operator workflow
Import the wrapper and read the typed verdict; never read a log string to
decide PASS/SKIP/FAIL:

    use std.nogc_sync_mut.io.cuda_host_validation.{cuda_readback_validate}
    val outcome = cuda_readback_validate()   # outcome.status in PASS/SKIP/FAIL

## Compatibility and limitations
Every probe below goes through the real driver-API externs in
`cuda_sffi.spl`. On a host with no CUDA driver library the wrapper reports
SKIP with a named category -- it never fabricates a PASS and never reports a
FAIL for a merely-absent device.

TODO(gpu-lane, REQ-CUDA-VALIDATION-03): `cuda_module_load_data_ex` reports the
driver entry point the runtime actually calls, which today is
`cuModuleLoadData` (`src/compiler_rust/runtime/src/cuda_runtime.rs:379`), not
`cuModuleLoadDataEx`. The plan requires the Ex form so that JIT option buffers
(and therefore the bounded JIT log) are real driver output rather than a
wrapper-side reconstruction. Closing this needs an `rt_cuda_module_load_data_ex`
extern carrying the option/log-buffer pair.
"""

use std.nogc_sync_mut.io.cuda_sffi.{
    cuda_available, cuda_device_count, cuda_driver_init,
    cuda_alloc, cuda_free, cuda_copy_to_device, cuda_copy_from_device,
    cuda_compile, cuda_unload
}
use std.common.string_core.{bytes_to_text, text_to_bytes}
use std.io_runtime.{env_get}

# ============================================================================
# Typed verdicts
# ============================================================================

# The tri-state verdict the plan's §Contract requires. Exactly one of
# "PASS", "SKIP", "FAIL" -- a caller must never have to parse a log line.
struct CudaValidationOutcome:
    status: text
    detail: text

# One of the five negative-case categories the plan's §Required negative
# cases table enumerates. `category` is always one of the five documented
# names, never a free-form message.
struct CudaFailureDetail:
    category: text
    code: i64
    message: text

struct CudaJitLoadResult:
    api_used: text
    loaded: bool
    jit_log: text

struct CudaApiFailure:
    code: i64
    name: text
    message: text

struct SharedMemoryKernelResult:
    block_count: i64
    mismatch_count: i64
    ran: bool

struct CudaNegativeCaseResult:
    name: text
    status: text
    detail: text

struct CudaProvenanceReport:
    fields: [text]
    reviewer_tier: text
    reviewed: bool

# ============================================================================
# Device probing -- the single classifier every wrapper below routes through
# ============================================================================

# True when the operator pinned this host to require a live CUDA device.
# Same env var and same "1" spelling as gpu_live_required("cuda")
# (src/lib/nogc_sync_mut/test_runner/gpu_lane_common.spl:64); read directly
# here so a stdlib io module does not take a dependency on the test runner.
fn cuda_live_required() -> bool:
    env_get("CUDA_LIVE_REQUIRED") == "1"

# Classify host CUDA availability into one of the plan's five documented
# categories, or the empty text when a usable device is present.
fn cuda_host_blocker_category() -> text:
    if not cuda_available():
        return "missing_library"
    if not cuda_driver_init():
        return "init_failure"
    if cuda_device_count() <= 0:
        return "zero_devices"
    ""

# ============================================================================
# REQ-CUDA-VALIDATION-01 / 02: readback verdict and its failure detail
# ============================================================================

fn cuda_readback_validate() -> CudaValidationOutcome:
    val blocker = cuda_host_blocker_category()
    if blocker != "":
        # Plan §CI: on the dedicated live lane the operator pins
        # CUDA_LIVE_REQUIRED=1, and an absent device must NOT be excused as a
        # SKIP -- it is a provisioning FAIL. Everywhere else (this sandbox
        # included) the same absence stays a SKIP.
        if cuda_live_required():
            return CudaValidationOutcome(status: "FAIL", detail: blocker)
        return CudaValidationOutcome(status: "SKIP", detail: blocker)
    # A real host-to-device-to-host round trip: the readback must reproduce
    # the source bytes exactly, or the verdict is FAIL.
    val source: [u8] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8]
    val mem = cuda_alloc(8)
    if not mem.is_valid:
        return CudaValidationOutcome(status: "FAIL", detail: "device allocation failed")
    if not cuda_copy_to_device(mem, source):
        cuda_free(mem)
        return CudaValidationOutcome(status: "FAIL", detail: "host-to-device copy failed")
    val readback = cuda_copy_from_device(mem, 8)
    cuda_free(mem)
    if readback.len() != source.len():
        return CudaValidationOutcome(status: "FAIL", detail: "short readback")
    var i = 0
    while i < source.len():
        if readback[i] != source[i]:
            return CudaValidationOutcome(status: "FAIL", detail: "readback byte mismatch")
        i = i + 1
    CudaValidationOutcome(status: "PASS", detail: "8-byte round trip exact")

fn cuda_readback_error_detail() -> CudaFailureDetail:
    val blocker = cuda_host_blocker_category()
    if blocker != "":
        return CudaFailureDetail(category: blocker, code: 0, message: blocker)
    val outcome = cuda_readback_validate()
    if outcome.status == "PASS":
        return CudaFailureDetail(category: "", code: 0, message: "no failure")
    CudaFailureDetail(category: "provisioning_error", code: 0, message: outcome.detail)

# ============================================================================
# REQ-CUDA-VALIDATION-03: JIT module load with a bounded log
# ============================================================================

fn cuda_module_load_data_ex(ptx: [u8], log_bound: i64) -> CudaJitLoadResult:
    val blocker = cuda_host_blocker_category()
    if blocker != "":
        return CudaJitLoadResult(
            api_used: "cuModuleLoadData", loaded: false,
            jit_log: _cuda_bounded(blocker, log_bound))
    # The runtime's module-load extern wraps cuModuleLoadData; reporting the
    # Ex name here would be a false claim (see the module TODO above).
    val handle = _cuda_load_module_bytes(ptx)
    CudaJitLoadResult(
        api_used: "cuModuleLoadData",
        loaded: handle > 0,
        jit_log: _cuda_bounded(_cuda_load_log(handle), log_bound))

fn _cuda_load_log(handle: i64) -> text:
    if handle > 0:
        "module loaded"
    else:
        "module load failed"

fn _cuda_bounded(s: text, bound: i64) -> text:
    if bound <= 0:
        return ""
    if s.len() <= bound:
        s
    else:
        s.substring(0, bound)

# Load through the real driver-API module loader in cuda_sffi. The handle is
# released immediately: this wrapper validates loadability, it does not hand
# a live module out.
fn _cuda_load_module_bytes(ptx: [u8]) -> i64:
    if ptx.len() == 0:
        return 0
    val module = cuda_compile(bytes_to_text(ptx))
    if not module.is_valid:
        return 0
    cuda_unload(module)
    module.handle

# ============================================================================
# REQ-CUDA-VALIDATION-04: numeric code plus its documented name
# ============================================================================

fn cuda_api_failure_report(code: i64) -> CudaApiFailure:
    CudaApiFailure(code: code, name: cuda_error_name(code), message: cuda_error_message(code))

# Names are the CUDA driver-API header's own constants (cuda.h, CUresult).
fn cuda_error_name(code: i64) -> text:
    match code:
        case 0: "CUDA_SUCCESS"
        case 1: "CUDA_ERROR_INVALID_VALUE"
        case 2: "CUDA_ERROR_OUT_OF_MEMORY"
        case 3: "CUDA_ERROR_NOT_INITIALIZED"
        case 4: "CUDA_ERROR_DEINITIALIZED"
        case 100: "CUDA_ERROR_NO_DEVICE"
        case 101: "CUDA_ERROR_INVALID_DEVICE"
        case 200: "CUDA_ERROR_INVALID_IMAGE"
        case 201: "CUDA_ERROR_INVALID_CONTEXT"
        case 209: "CUDA_ERROR_NO_BINARY_FOR_GPU"
        case 218: "CUDA_ERROR_INVALID_PTX"
        case 500: "CUDA_ERROR_NOT_FOUND"
        case 700: "CUDA_ERROR_ILLEGAL_ADDRESS"
        case 701: "CUDA_ERROR_LAUNCH_OUT_OF_RESOURCES"
        case 702: "CUDA_ERROR_LAUNCH_TIMEOUT"
        case 719: "CUDA_ERROR_LAUNCH_FAILED"
        case _: "CUDA_ERROR_UNKNOWN"

fn cuda_error_message(code: i64) -> text:
    match code:
        case 0: "no error"
        case 1: "invalid argument"
        case 2: "out of memory"
        case 3: "driver not initialized"
        case 100: "no CUDA-capable device is detected"
        case 218: "a PTX JIT compilation failed"
        case 700: "an illegal memory access was encountered"
        case _: "unrecognised CUDA driver API result"

# ============================================================================
# REQ-CUDA-VALIDATION-05: shared-memory/barrier kernel against a CPU oracle
# ============================================================================

fn cuda_shared_memory_kernel_validate() -> SharedMemoryKernelResult:
    val blocker = cuda_host_blocker_category()
    if blocker != "":
        # No device: the kernel did not run. Reporting a block count or a
        # zero mismatch here would be a fabricated pass.
        return SharedMemoryKernelResult(block_count: 0, mismatch_count: 0, ran: false)
    # TODO(gpu-lane, REQ-CUDA-VALIDATION-05): generate the shared-memory /
    # barrier PTX and launch it over >= 2 blocks, comparing every element
    # against the CPU oracle with zero tolerance. The generated-PTX source
    # does not exist yet; until it does this reports "did not run" rather
    # than a synthesised result.
    SharedMemoryKernelResult(block_count: 0, mismatch_count: 0, ran: false)

# ============================================================================
# REQ-CUDA-VALIDATION-06: the five named negative cases, in checkbox order
# ============================================================================

fn cuda_negative_case_matrix() -> [CudaNegativeCaseResult]:
    val blocker = cuda_host_blocker_category()
    val names: [text] = ["malformed_ptx", "missing_symbol", "launch_limit",
                         "async_fault", "guard"]
    var rows: [CudaNegativeCaseResult] = []
    var i = 0
    while i < names.len():
        if blocker != "":
            rows.push(CudaNegativeCaseResult(
                name: names[i], status: "SKIP", detail: blocker))
        else:
            rows.push(_cuda_run_negative_case(names[i]))
        i = i + 1
    rows

fn _cuda_run_negative_case(name: text) -> CudaNegativeCaseResult:
    if name == "malformed_ptx":
        # A malformed image must be rejected by the loader, not accepted.
        val loaded = cuda_module_load_data_ex(text_to_bytes("not ptx"), 4096)
        if loaded.loaded:
            return CudaNegativeCaseResult(
                name: name, status: "FAIL", detail: "malformed PTX was accepted")
        return CudaNegativeCaseResult(
            name: name, status: "PASS", detail: "malformed PTX rejected")
    # TODO(gpu-lane, REQ-CUDA-VALIDATION-06): missing_symbol, launch_limit,
    # async_fault and guard each need a live launch to observe; the launch
    # harness is the same missing piece as REQ-CUDA-VALIDATION-05.
    CudaNegativeCaseResult(name: name, status: "SKIP", detail: "launch harness not implemented")

# ============================================================================
# REQ-CUDA-VALIDATION-09 / 10: provenance schema and its review gate
# ============================================================================

fn cuda_provenance_report() -> CudaProvenanceReport:
    CudaProvenanceReport(
        fields: ["device_uuid", "driver_version", "ptx_sha256", "jit_log_path"],
        reviewer_tier: "highest-capability",
        reviewed: false)
