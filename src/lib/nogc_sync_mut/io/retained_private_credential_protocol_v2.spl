# Exact bounded credential wire layout shared by retained platform owners.
# Validation returns only booleans; credentials never enter diagnostics.
use std.common.encoding.external_text.{bytes_to_text_checked}
use std.common.crypto.constant_time.black_box

pub fn retained_credential_bytes_equal_v2(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len(): return false
    var difference = 0
    for index in 0..left.len():
        difference = difference | ((left[index] as i64) ^ (right[index] as i64))
    black_box(difference) == 0

fn _credential_hex_v2(bytes: [u8], start: i64, count: i64) -> bool:
    if start < 0 or count != 32 or start + count > bytes.len(): return false
    for index in start..start + count:
        val value = bytes[index] as i64
        if not ((value >= 48 and value <= 57) or (value >= 97 and value <= 102)): return false
    true

pub fn retained_credential_initial_valid_v2(bytes: [u8]) -> bool:
    if bytes.len() < 34 or bytes.len() > 512: return false
    var length = bytes.len()
    if bytes[length - 1] == 10u8: length = length - 1
    if length < 34 or length > 161 or bytes[32] != 32u8: return false
    if not _credential_hex_v2(bytes, 0, 32): return false
    for index in 33..length:
        if bytes[index] < 33u8 or bytes[index] > 126u8: return false
    true

fn _credential_positive_decimal_v2(value: text, maximum: i64) -> bool:
    if value.byte_len() == 0 or value.byte_len() > 19 or value.char_code_at(0) == 48: return false
    var number = 0
    for index in 0..value.byte_len():
        val code = value.char_code_at(index)
        if code < 48 or code > 57: return false
        val digit = code - 48
        if number > (maximum - digit) / 10: return false
        number = number * 10 + digit
    number > 0 and number <= maximum

pub fn retained_credential_ready_matches_v2(initial: [u8], ready: [u8]) -> bool:
    if not retained_credential_initial_valid_v2(initial): return false
    if ready.len() < 1 or ready.len() > 512 or ready[ready.len() - 1] != 10u8: return false
    for index in 0..ready.len() - 1:
        if ready[index] < 32u8 or ready[index] > 126u8: return false
    val initial_text: text = match bytes_to_text_checked(initial):
        case Ok(v): v
        case Err(_): return false
    val ready_text: text = match bytes_to_text_checked(ready):
        case Ok(v): v
        case Err(_): return false
    val initial_fields = initial_text.trim().split(" ")
    val fields = ready_text.trim().split(" ")
    if initial_fields.len() != 2 or fields.len() != 5: return false
    for field in fields:
        if field.byte_len() == 0: return false
    # Exact separators are checked separately: trim must not admit whitespace
    # adjacent to the newline or collapse a different wire spelling.
    val canonical = fields[0] + " " + fields[1] + " " + fields[2] + " " + fields[3] + " " + fields[4] + "\n"
    if canonical != ready_text: return false
    if fields[0] != initial_fields[0] or fields[2] != initial_fields[1]: return false
    if not fields[1].starts_with("127.0.0.1:"): return false
    if not _credential_positive_decimal_v2(fields[1].slice(10, fields[1].byte_len()), 65535): return false
    if not _credential_positive_decimal_v2(fields[3], 9223372036854775807): return false
    val incarnation = fields[4]
    if incarnation.byte_len() != 32: return false
    for index in 0..32:
        val value = incarnation.char_code_at(index)
        if not ((value >= 48 and value <= 57) or (value >= 97 and value <= 102)): return false
    true

export retained_credential_bytes_equal_v2, retained_credential_initial_valid_v2, retained_credential_ready_matches_v2
