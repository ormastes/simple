#!/usr/bin/env simple
# TLS/SSL SFFI Wrapper
#
# SFFI pattern for TLS (Transport Layer Security) operations.
# Provides secure socket connections, certificate management, and HTTPS support.
#
# Rust crate: rustls (https://docs.rs/rustls/)
# Note: rustls is already used by HTTP wrapper, so this extends that functionality

use std.nogc_sync_mut.io.sffi_common.{is_valid_handle, is_invalid_handle}

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

# --- TLS Client ---

@unsafe(reason: "raw rustls connection-handle ABI; negative sentinel means validation, DNS, TCP, TLS, or trust failure", capabilities: [ffi])
extern fn rt_tls_client_connect(host: text, port: i64) -> i64
@unsafe(reason: "raw rustls SNI connection-handle ABI; negative sentinel means validation, TCP, TLS, or trust failure", capabilities: [ffi])
extern fn rt_tls_client_connect_with_sni(host: text, port: i64, server_name: text) -> i64
@unsafe(reason: "raw rustls deadline-bounded address/SNI connection ABI; negative sentinel means validation, timeout, TLS, or trust failure", capabilities: [ffi])
extern fn rt_tls_client_connect_address_with_sni_timeout(address: text, port: i64, server_name: text, timeout_ms: i64) -> i64
@unsafe(reason: "raw rustls write-count ABI; negative sentinel means contract or I/O failure", capabilities: [ffi])
extern fn rt_tls_client_write(conn: i64, data: text) -> i64
@unsafe(reason: "raw rustls deadline-bounded write-count ABI; negative sentinel means contract, timeout, or I/O failure", capabilities: [ffi])
extern fn rt_tls_client_write_timeout(conn: i64, data: text, timeout_ms: i64) -> i64
@unsafe(reason: "raw rustls read ABI; nil means contract or I/O failure, empty text means clean EOF", capabilities: [ffi])
extern fn rt_tls_client_read_checked(conn: i64, max_bytes: i64) -> text?
@unsafe(reason: "raw rustls deadline-bounded read ABI; nil means contract, timeout, or I/O failure and empty text means EOF", capabilities: [ffi])
extern fn rt_tls_client_read_timeout_checked(conn: i64, max_bytes: i64, timeout_ms: i64) -> text?
@unsafe(reason: "raw rustls close-status ABI; false means invalid, stale, or already closed handle", capabilities: [ffi])
extern fn rt_tls_client_close(conn: i64) -> bool

# --- TLS Server ---

@unsafe(reason: "raw rustls listener-handle ABI; negative sentinel means invalid certificate, key, address, or bind failure", capabilities: [ffi])
extern fn rt_tls_server_create(port: i64, cert_path: text, key_path: text) -> i64
@unsafe(reason: "raw rustls accept-handle ABI; negative sentinel means invalid listener or accept failure", capabilities: [ffi])
extern fn rt_tls_server_accept(server: i64) -> i64  # Returns client connection
@unsafe(reason: "raw rustls write-count ABI; negative sentinel means contract or I/O failure", capabilities: [ffi])
extern fn rt_tls_server_write(conn: i64, data: text) -> i64
@unsafe(reason: "raw rustls byte-write count ABI; negative sentinel means contract or I/O failure", capabilities: [ffi])
extern fn rt_tls_server_write_bytes(conn: i64, data: [u8]) -> i64
@unsafe(reason: "raw rustls server-read ABI; nil means contract or I/O failure, empty text means clean EOF", capabilities: [ffi])
extern fn rt_tls_server_read_checked(conn: i64, max_bytes: i64) -> text?
@unsafe(reason: "raw rustls close-status ABI; false means invalid, stale, or already closed handle", capabilities: [ffi])
extern fn rt_tls_server_close_connection(conn: i64) -> bool
@unsafe(reason: "raw rustls listener shutdown status ABI; false means invalid, stale, or already closed handle", capabilities: [ffi])
extern fn rt_tls_server_shutdown(server: i64) -> bool

# --- Connection Info ---

@unsafe(reason: "raw rustls optional protocol metadata ABI; nil means invalid, stale, or incomplete connection", capabilities: [ffi])
extern fn rt_tls_get_protocol_version(conn: i64) -> text?
@unsafe(reason: "raw rustls optional cipher metadata ABI; nil means invalid, stale, incomplete, or unsupported suite", capabilities: [ffi])
extern fn rt_tls_get_cipher_suite(conn: i64) -> text?
@unsafe(reason: "raw rustls optional ALPN metadata ABI; nil means invalid handle and empty text means no negotiated ALPN", capabilities: [ffi])
extern fn rt_tls_get_negotiated_alpn(conn: i64) -> text?
@unsafe(reason: "raw rustls optional boolean handshake ABI; nil means invalid or stale handle", capabilities: [ffi])
extern fn rt_tls_is_handshake_complete(conn: i64) -> bool?

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

# --- Core Types ---

struct TlsClientConnection:
    handle: i64
    host: text
    port: i64
    is_valid: bool

struct TlsServerConnection:
    handle: i64
    is_valid: bool

struct TlsServer:
    handle: i64
    port: i64
    is_valid: bool

struct TlsConnectionInfo:
    protocol_version: text
    cipher_suite: text
    alpn_protocol: text
    peer_cert_subject: text?

# --- TLS Client ---

fn tls_connect(host: text, port: i64) -> Result<TlsClientConnection, text>:
    """Connect to TLS server

    Args:
        host: Server hostname/IP
        port: Port number (443 for HTTPS)

    Returns: TlsClientConnection (check is_valid)

    Example:
        match tls_connect("example.com", 443):
            Ok(conn):
                val _ = tls_write(conn, "GET / HTTP/1.1\r\n\r\n")
            Err(_): pass
    """
    val handle = rt_tls_client_connect(host, port)
    if is_invalid_handle(handle):
        return Err("TLS connect failed: {host}:{port}")
    Ok(TlsClientConnection(handle: handle, host: host, port: port, is_valid: true))

fn tls_connect_with_sni(host: text, port: i64, server_name: text) -> Result<TlsClientConnection, text>:
    """Connect to TLS server with custom SNI (Server Name Indication)

    Args:
        host: Server IP address
        port: Port number
        server_name: SNI hostname

    Returns: TlsClientConnection

    Example:
        # Connect to CDN with specific SNI
        result = tls_connect_with_sni("192.0.2.1", 443, "cdn.example.com")
    """
    val handle = rt_tls_client_connect_with_sni(host, port, server_name)
    if is_invalid_handle(handle):
        return Err("TLS SNI connect failed: {host}:{port}")
    Ok(TlsClientConnection(handle: handle, host: host, port: port, is_valid: true))

fn tls_write(conn: TlsClientConnection, data: text) -> Result<i64, text>:
    """Write data to TLS connection

    Args:
        data: Data to send

    Returns: Number of bytes written

    Example:
        bytes_sent = tls_write(conn, "Hello, server!")
    """
    if is_invalid_handle(conn.handle):
        return Err("TLS write: invalid handle")

    val written = rt_tls_client_write(conn.handle, data)
    if written < 0:
        return Err("TLS write failed")
    Ok(written)

fn tls_read(conn: TlsClientConnection, max_bytes: i64) -> Result<text, text>:
    """Read data from TLS connection

    Args:
        max_bytes: Maximum bytes to read

    Returns: Data received

    Example:
        data = tls_read(conn, 4096)
        print "Received: {data}"
    """
    if is_invalid_handle(conn.handle):
        return Err("TLS read: invalid handle")

    val data = rt_tls_client_read_checked(conn.handle, max_bytes)
    if data == nil:
        return Err("TLS read failed")
    Ok(data!)

fn tls_read_timeout(conn: TlsClientConnection, max_bytes: i64, timeout_ms: i64) -> text:
    """Read with a per-call deadline (ms). Returns "" on timeout, EOF or
    invalid handle; callers that must tell those apart bound the wall clock
    around the call (see app.llm_caret.infra_mail)."""
    if is_invalid_handle(conn.handle):
        return ""

    val data = rt_tls_client_read_timeout_checked(conn.handle, max_bytes, timeout_ms)
    if data == nil:
        return ""
    data!

fn tls_close(conn: TlsClientConnection) -> Result<(), text>:
    """Close TLS connection"""
    if is_invalid_handle(conn.handle):
        return Err("TLS close: invalid handle")

    if not rt_tls_client_close(conn.handle):
        return Err("TLS close failed")
    Ok(())

# --- TLS Server ---

fn tls_server_create(port: i64, cert_path: text, key_path: text) -> Result<TlsServer, text>:
    """Create TLS server

    Args:
        port: Port to listen on
        cert_path: Path to certificate file (PEM format)
        key_path: Path to private key file (PEM format)

    Returns: TlsServer (check is_valid)

    Example:
        result = tls_server_create(8443, "cert.pem", "key.pem")
    """
    val handle = rt_tls_server_create(port, cert_path, key_path)
    if is_invalid_handle(handle):
        return Err("TLS server create failed on port {port}")
    Ok(TlsServer(handle: handle, port: port, is_valid: true))

fn tls_server_accept(server: TlsServer) -> Result<TlsServerConnection, text>:
    """Accept incoming TLS connection

    Returns: TlsServerConnection for client

    Example:
        conn = tls_server_accept(server)
        if conn.is_valid:
            data = tls_server_read(conn, 1024)
    """
    if is_invalid_handle(server.handle):
        return Err("TLS accept: invalid server handle")

    val handle = rt_tls_server_accept(server.handle)
    if is_invalid_handle(handle):
        return Err("TLS accept failed")
    Ok(TlsServerConnection(handle: handle, is_valid: true))

fn tls_server_write(conn: TlsServerConnection, data: text) -> Result<i64, text>:
    """Write data to client connection"""
    if is_invalid_handle(conn.handle):
        return Err("TLS server write: invalid handle")

    val written = rt_tls_server_write(conn.handle, data)
    if written < 0:
        return Err("TLS server write failed")
    Ok(written)

fn tls_server_read(conn: TlsServerConnection, max_bytes: i64) -> Result<text, text>:
    """Read data from client connection; empty text is clean EOF."""
    if is_invalid_handle(conn.handle):
        return Err("TLS server read: invalid handle")

    val data = rt_tls_server_read_checked(conn.handle, max_bytes)
    if data == nil:
        return Err("TLS server read failed")
    Ok(data!)

fn tls_server_close_connection(conn: TlsServerConnection) -> Result<(), text>:
    """Close client connection"""
    if is_invalid_handle(conn.handle):
        return Err("TLS server close: invalid handle")

    if not rt_tls_server_close_connection(conn.handle):
        return Err("TLS server close failed")
    Ok(())

fn tls_server_shutdown(server: TlsServer) -> Result<(), text>:
    """Shutdown TLS server"""
    if is_invalid_handle(server.handle):
        return Err("TLS shutdown: invalid server handle")

    if not rt_tls_server_shutdown(server.handle):
        return Err("TLS shutdown failed")
    Ok(())

# --- Connection Info ---

fn tls_get_connection_info(conn: TlsClientConnection) -> Result<TlsConnectionInfo, text>:
    """Get TLS connection information

    Returns: TlsConnectionInfo with protocol, cipher, etc.

    Example:
        info = tls_get_connection_info(conn)
        print "Protocol: {info.protocol_version}"
        print "Cipher: {info.cipher_suite}"
    """
    if is_invalid_handle(conn.handle):
        return Err("TLS connection info: invalid handle")

    val protocol = rt_tls_get_protocol_version(conn.handle)
    val cipher = rt_tls_get_cipher_suite(conn.handle)
    val alpn = rt_tls_get_negotiated_alpn(conn.handle)

    if protocol == nil or cipher == nil or alpn == nil:
        return Err("TLS connection metadata unavailable")
    Ok(TlsConnectionInfo(
        protocol_version: protocol!,
        cipher_suite: cipher!,
        alpn_protocol: alpn!,
        peer_cert_subject: nil
    ))

fn tls_is_handshake_complete(conn: TlsClientConnection) -> Result<bool, text>:
    """Check if TLS handshake is complete"""
    if is_invalid_handle(conn.handle):
        return Err("TLS handshake status: invalid handle")

    val complete = rt_tls_is_handshake_complete(conn.handle)
    if complete == nil:
        return Err("TLS handshake status unavailable")
    Ok(complete!)

# ============================================================================
# Export Functions
# ============================================================================

export TlsClientConnection, TlsServerConnection, TlsServer
export TlsConnectionInfo
export tls_connect, tls_connect_with_sni, tls_write, tls_read, tls_read_timeout, tls_close
export tls_server_create, tls_server_accept, tls_server_write, tls_server_read
export tls_server_close_connection, tls_server_shutdown
export tls_get_connection_info, tls_is_handshake_complete
export rt_tls_client_connect, rt_tls_client_connect_with_sni
export rt_tls_client_connect_address_with_sni_timeout
export rt_tls_client_write, rt_tls_client_write_timeout
export rt_tls_client_read_checked, rt_tls_client_read_timeout_checked
export rt_tls_client_close, rt_tls_get_protocol_version
export rt_tls_server_create, rt_tls_server_accept, rt_tls_server_write
export rt_tls_server_read_checked, rt_tls_server_write_bytes, rt_tls_server_close_connection
export rt_tls_server_shutdown
