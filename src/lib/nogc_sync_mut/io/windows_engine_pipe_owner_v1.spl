# Portable broker-only facade. Native HANDLE state stays inside one Windows IO
# capsule; unsupported hosts never import its Win32 security/overlapped ABI.
pub use std.common.process.windows_engine_pipe_v1.{WindowsEnginePipeLeaseV1,
    WindowsEnginePipeAdmissionV1, WindowsEnginePipeReadV1, WindowsEnginePipeObservationV1,
    WindowsEnginePipePollV1, WindowsEnginePipeWriteContextV1}

@when(os="windows"):
pub use std.nogc_sync_mut.io.windows_engine_pipe_native_v1.{windows_engine_pipe_connect_v1,
    windows_engine_pipe_observe_v1, windows_engine_pipe_poll_v1, windows_engine_pipe_read_some_v1,
    windows_engine_pipe_write_some_v1, windows_engine_pipe_write_some_admitted_v1,
    windows_engine_pipe_cancel_v1, windows_engine_pipe_collect_v1}
@else:
pub fn windows_engine_pipe_connect_v1() -> WindowsEnginePipeAdmissionV1:
    WindowsEnginePipeAdmissionV1.Rejected("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_observe_v1(lease: WindowsEnginePipeLeaseV1) -> Result<WindowsEnginePipeObservationV1, text>:
    Err("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_poll_v1(lease: WindowsEnginePipeLeaseV1) -> Result<WindowsEnginePipePollV1, text>:
    Err("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_read_some_v1(lease: WindowsEnginePipeLeaseV1, max_bytes: i64) -> WindowsEnginePipeReadV1:
    WindowsEnginePipeReadV1.Failed("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_write_some_v1(lease: WindowsEnginePipeLeaseV1, bytes: [u8]) -> Result<i64, text>:
    Err("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_write_some_admitted_v1(lease: WindowsEnginePipeLeaseV1, bytes: [u8],
        context: WindowsEnginePipeWriteContextV1) -> Result<i64, text>:
    Err("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_cancel_v1(lease: WindowsEnginePipeLeaseV1) -> Result<WindowsEnginePipePollV1, text>:
    Err("Windows Engine pipe unsupported on this platform")
pub fn windows_engine_pipe_collect_v1(lease: WindowsEnginePipeLeaseV1) -> Result<WindowsEnginePipePollV1, text>:
    Err("Windows Engine pipe unsupported on this platform")
@end
