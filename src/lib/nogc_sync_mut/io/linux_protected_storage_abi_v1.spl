# Ordinary libc only. No runtime export or application pathname authority.
@when(os="linux"):
pub use std.nogc_sync_mut.io.retained_file_abi.{malloc, free, openat, close, pread, write, fsync, geteuid}
pub use std.nogc_sync_mut.io.anchored_io_linux_v1.{AnchoredLinuxMetadataV1,
    anchored_linux_directory_flags_v1, anchored_linux_file_flags_v1,
    anchored_linux_name_v1, anchored_linux_metadata_v1}
@unsafe(reason: "capture current errno immediately after failed libc operation", capabilities: [ffi, raw_ptr])
extern fn __errno_location() -> i64
@unsafe(reason: "create private directory beneath retained parent", capabilities: [ffi, raw_ptr])
extern fn mkdirat(parent: i32, name: i64, mode: u32) -> i32
@unsafe(reason: "establish private exclusive stage mode before bytes", capabilities: [ffi])
extern fn fchmod(fd: i32, mode: u32) -> i32
@unsafe(reason: "atomic no-replace stage publication within retained directory", capabilities: [ffi, raw_ptr])
extern fn linkat(source_parent: i32, source: i64, target_parent: i32, target: i64, flags: i32) -> i32
@unsafe(reason: "replace only under the one held writer and transition oracle", capabilities: [ffi, raw_ptr])
extern fn renameat(source_parent: i32, source: i64, target_parent: i32, target: i64) -> i32
@unsafe(reason: "remove only a verified original stage name", capabilities: [ffi, raw_ptr])
extern fn unlinkat(parent: i32, name: i64, flags: i32) -> i32
@unsafe(reason: "hold actual retained journal writer lock for its lifetime", capabilities: [ffi])
extern fn flock(fd: i32, operation: i32) -> i32
export mkdirat, fchmod, linkat, renameat, unlinkat, flock, __errno_location
@end
