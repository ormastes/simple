# Windows journal authority is minted only by the actual retained root's
# open_journal_store_v1(). Definition stays beside that factory so no token
# admission function, path constructor or raw HANDLE is exported here.
use std.nogc_sync_mut.io.windows_private_file_v1.{WindowsJournalStoreV1, WindowsJournalStoreOpenV1, WindowsJournalConsumptionV1}
export WindowsJournalStoreV1, WindowsJournalStoreOpenV1, WindowsJournalConsumptionV1
