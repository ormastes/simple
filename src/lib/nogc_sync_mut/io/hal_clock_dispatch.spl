# Canonical production dispatch leaf for the rt(hal) monotonic clock contract.
#
# Provider selection is resolved statically: the hosted production binding is
# the existing runtime clock ABI.  The leaf intentionally accepts and returns
# only fixed scalars.  It performs no lookup, reflection, environment read,
# buffer construction, logging, or allocation on the hot path.

@unsafe(reason: "canonical hosted monotonic-clock provider ABI", capabilities: [ffi])
extern fn rt_time_now_nanos() -> i64

@inline
@unsafe(reason: "private direct-bound monotonic-clock HAL dispatch leaf", capabilities: [ffi])
fn hal_clock_monotonic_nanos_v1() -> i64:
    rt_time_now_nanos()

export hal_clock_monotonic_nanos_v1
