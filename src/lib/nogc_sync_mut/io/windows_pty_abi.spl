# Direct Win64 ConPTY boundary. COORD is a packed four-byte value, not a pointer.
# Only the native Windows provider may import this module.
@unsafe(reason: "Win64 synchronous ConPTY endpoint creation", capabilities: [ffi, raw_ptr])
extern fn CreatePseudoConsole(size: u32, input_handle: i64, output_handle: i64, flags: u32, console_out: i64) -> i32
@unsafe(reason: "Win64 owned ConPTY resize", capabilities: [ffi])
extern fn ResizePseudoConsole(console: i64, size: u32) -> i32
@unsafe(reason: "Win64 ConPTY release after output pipe closure", capabilities: [ffi])
extern fn ClosePseudoConsole(console: i64)
@unsafe(reason: "Win64 private synchronous ConPTY input endpoint", capabilities: [ffi, raw_ptr])
extern fn CreateNamedPipeW(name: i64, open_mode: u32, pipe_mode: u32, instances: u32,
    output_size: u32, input_size: u32, timeout: u32, security: i64) -> i64
@unsafe(reason: "Win64 connection of an already opened private pipe client", capabilities: [ffi, raw_ptr])
extern fn ConnectNamedPipe(pipe: i64, overlapped: i64) -> i32
@unsafe(reason: "Win64 noninherited output pipe creation", capabilities: [ffi, raw_ptr])
extern fn CreatePipe(read_out: i64, write_out: i64, security: i64, size: u32) -> i32
@unsafe(reason: "Win64 nonblocking pipe availability observation", capabilities: [ffi, raw_ptr])
extern fn PeekNamedPipe(pipe: i64, buffer: i64, size: u32, read_out: i64, available_out: i64, remaining_out: i64) -> i32
@unsafe(reason: "Win64 overlapped write into retained owner allocation", capabilities: [ffi, raw_ptr])
extern fn WriteFile(file: i64, buffer: i64, size: u32, written_out: i64, overlapped: i64) -> i32
@unsafe(reason: "Win64 retained asynchronous request completion observation", capabilities: [ffi, raw_ptr])
extern fn GetOverlappedResult(file: i64, overlapped: i64, transferred_out: i64, wait: i32) -> i32
@unsafe(reason: "Win64 cancellation request without freeing pending storage", capabilities: [ffi, raw_ptr])
extern fn CancelIoEx(file: i64, overlapped: i64) -> i32
@unsafe(reason: "Win64 owned manual-reset completion event", capabilities: [ffi, raw_ptr])
extern fn CreateEventW(security: i64, manual_reset: i32, initial_state: i32, name: i64) -> i64
@unsafe(reason: "Win64 completion event reuse after observed completion", capabilities: [ffi])
extern fn ResetEvent(event: i64) -> i32
@unsafe(reason: "Win64 pipe namespace process identity", capabilities: [ffi])
extern fn GetCurrentProcessId() -> u32

export CreatePseudoConsole, ResizePseudoConsole, ClosePseudoConsole
export CreateNamedPipeW, ConnectNamedPipe, CreatePipe, PeekNamedPipe
export WriteFile, GetOverlappedResult, CancelIoEx, CreateEventW, ResetEvent, GetCurrentProcessId
