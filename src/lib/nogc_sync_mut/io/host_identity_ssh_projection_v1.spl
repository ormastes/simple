# The opaque owner is constructed only alongside the store's private platform
# capability. All operations reload that existing store's canonical child state.
pub use std.nogc_sync_mut.io.host_identity_store_v1.{HostIdentitySshProjectionV1,
    HostIdentitySshProjectionTurnV1, HostIdentitySshProjectionCloseTurnV1}
pub use std.nogc_sync_mut.io.host_identity_ssh_projection_types_v1.HostIdentitySshPathsV1
use std.nogc_sync_mut.io.host_identity_store_v1.{HostIdentityStoreV1,
    host_identity_store_projection_begin_v1, host_identity_store_projection_step_v1,
    host_identity_store_projection_paths_v1, host_identity_store_projection_close_v1}

pub fn host_identity_ssh_projection_begin_v1(store: HostIdentityStoreV1, key_leaf: text, hosts_leaf: text) -> HostIdentitySshProjectionTurnV1:
    host_identity_store_projection_begin_v1(store, key_leaf, hosts_leaf)

pub fn host_identity_ssh_projection_step_v1(owner: HostIdentitySshProjectionV1, store: HostIdentityStoreV1, cancel: bool = false) -> HostIdentitySshProjectionTurnV1:
    host_identity_store_projection_step_v1(owner, store, cancel)

pub fn host_identity_ssh_projection_paths_v1(owner: HostIdentitySshProjectionV1, store: HostIdentityStoreV1) -> Result<HostIdentitySshPathsV1, text>:
    host_identity_store_projection_paths_v1(owner, store)

pub fn host_identity_ssh_projection_close_v1(owner: HostIdentitySshProjectionV1) -> HostIdentitySshProjectionCloseTurnV1:
    host_identity_store_projection_close_v1(owner)
