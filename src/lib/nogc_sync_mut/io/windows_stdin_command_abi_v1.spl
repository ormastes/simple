# Standard Win64 SDK SFFI only. No new rt_* exports or C implementation.
pub use std.nogc_sync_mut.io.windows_command_abi_v2.*
pub use std.nogc_sync_mut.io.windows_process_owner_abi.{GetFileInformationByHandleEx,
    BCryptOpenAlgorithmProvider, BCryptCreateHash, BCryptHashData, BCryptFinishHash,
    BCryptDestroyHash, BCryptCloseAlgorithmProvider}
pub use std.nogc_sync_mut.io.windows_pty_abi.{CreateNamedPipeW, ConnectNamedPipe,
    WriteFile, GetOverlappedResult, CancelIoEx, CreateEventW, ResetEvent, GetCurrentProcessId}
pub use std.nogc_sync_mut.io.windows_engine_pipe_abi_v1.LocalFree

# https://learn.microsoft.com/windows/win32/api/bcrypt/nf-bcrypt-bcryptgenrandom
@unsafe(reason: "Windows system-preferred cryptographic random bytes into an owned bounded buffer", capabilities: [ffi, raw_ptr])
extern fn BCryptGenRandom(provider: i64, buffer: i64, bytes: u32, flags: u32) -> i32
# https://learn.microsoft.com/windows/win32/api/sddl/nf-sddl-convertstringsecuritydescriptortosecuritydescriptorw
@unsafe(reason: "protected owner/SYSTEM pipe DACL into retained LocalAlloc descriptor", capabilities: [ffi, raw_ptr])
extern fn ConvertStringSecurityDescriptorToSecurityDescriptorW(source: i64, revision: u32,
    descriptor: i64, size: i64) -> i32
# https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-getnamedpipeclientprocessid
@unsafe(reason: "observe the actual private stdin pipe client before any child admission or data write", capabilities: [ffi, raw_ptr])
extern fn GetNamedPipeClientProcessId(pipe: i64, pid: i64) -> i32

# https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-getfinalpathnamebyhandlew
@unsafe(reason: "resolve the actual retained root HANDLE to its native volume path before descendant lookup", capabilities: [ffi, raw_ptr])
extern fn GetFinalPathNameByHandleW(file: i64, output: i64, capacity: u32, flags: u32) -> u32

export BCryptGenRandom, ConvertStringSecurityDescriptorToSecurityDescriptorW, GetNamedPipeClientProcessId
export GetFinalPathNameByHandleW
