"""Owning raw TCP socket resource; kept separate from encoded stream operations."""
use std.nogc_sync_mut.sosix.network.{sosix_tcp_socket_create, sosix_tcp_bind_fd,
    sosix_tcp_listen, sosix_tcp_set_reuseaddr, sosix_tcp_set_reuseport,
    sosix_tcp_local_addr, sosix_tcp_close}

# ============================================================================
# Resource Wrapper (Owning Handle Class) — WP-J
# ============================================================================

# Raw TCP socket resource wrapper with double-close guard.
# Sentinel is -1: sosix_tcp_socket_create returns the socket fd on success
# and -1 on failure (see tcp_backend_socket_create docstring and the
# `if fd < 0` checks in tcp_backend_bind_with_reuseport above).
pub class TcpSocket:
    fd: i64

impl TcpSocket:
    pub fn is_valid() -> bool:
        self.fd >= 0

    pub fn bind(addr: text) -> bool:
        if not self.is_valid():
            return false
        unsafe(capabilities: [ffi]):
            sosix_tcp_bind_fd(self.fd, addr)

    pub fn listen(backlog: i64) -> bool:
        if not self.is_valid():
            return false
        unsafe(capabilities: [ffi]):
            sosix_tcp_listen(self.fd, backlog)

    pub fn set_reuseaddr(enabled: bool) -> bool:
        if not self.is_valid():
            return false
        unsafe(capabilities: [ffi]):
            sosix_tcp_set_reuseaddr(self.fd, enabled)

    pub fn set_reuseport(enabled: bool) -> bool:
        if not self.is_valid():
            return false
        unsafe(capabilities: [ffi]):
            sosix_tcp_set_reuseport(self.fd, enabled)

    pub fn local_addr() -> text?:
        if not self.is_valid():
            return nil
        unsafe(capabilities: [ffi]):
            sosix_tcp_local_addr(self.fd)

    pub me fn close():
        # Consuming drop: one-shot guard against double-close
        if self.fd >= 0:
            unsafe(capabilities: [ffi]):
                sosix_tcp_close(self.fd)
            self.fd = -1

# Create a raw TCP socket (not yet bound). family: 0 = IPv4, 1 = IPv6.
# Returns nil on failure.
fn tcp_socket_create_resource(family: i64) -> TcpSocket?:
    val fd = unsafe(capabilities: [ffi]):
        sosix_tcp_socket_create(family)
    if fd < 0:
        return nil
    TcpSocket(fd: fd)


export TcpSocket, tcp_socket_create_resource
