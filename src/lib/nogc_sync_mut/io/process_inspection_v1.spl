"""Pinned, exact-environment process inspection with one retained stdin owner."""

use std.common.process.observation_v4.{
    ProcessObservationRequestV4, ProcessObservationReceiptV4,
    ProcessObservationFrozenReceiptV4
}
use std.common.process.inspection_v1.{ProcessInspectionInputReceiptV1}
use std.nogc_sync_mut.io.process_ops.{
    OwnedExecutablePin, OwnedCwdPinV4, ProcessInspectionLeaseV1,
    ProcessInspectionStartV1, process_inspection_owner_start_pinned_v1
}

pub fn process_inspection_start_pinned_v1(
    executable: OwnedExecutablePin,
    cwd: OwnedCwdPinV4,
    request: ProcessObservationRequestV4,
    input: [u8],
    expected_input_digest: [u8]
) -> Result<ProcessInspectionStartV1, text>:
    process_inspection_owner_start_pinned_v1(
        executable, cwd, request, input, expected_input_digest)

export OwnedExecutablePin, OwnedCwdPinV4, ProcessInspectionLeaseV1
export ProcessInspectionStartV1, ProcessInspectionInputReceiptV1
export ProcessObservationRequestV4, ProcessObservationReceiptV4
export ProcessObservationFrozenReceiptV4, process_inspection_start_pinned_v1
