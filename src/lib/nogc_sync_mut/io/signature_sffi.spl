# SSH Host Key Signature Verification + Generation SFFI
# Wraps the rt_{rsa,ed25519,ecdsa_p256}_{verify,sign} runtime externs.

# ============================================================================
# Tier 1: Extern Function Declarations (Raw SFFI)
# ============================================================================

# --- verify ---

# Verify an RSA-PKCS1-SHA256 signature (RFC 8332 rsa-sha2-256).
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "checked RSA SHA-256 verification ABI", capabilities: [ffi])
extern fn rt_rsa_sha256_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64

# Verify an RSA-PKCS1-SHA512 signature (RFC 8332 rsa-sha2-512).
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "checked RSA SHA-512 verification ABI", capabilities: [ffi])
extern fn rt_rsa_sha512_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64

# Verify an Ed25519 signature.
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "checked Ed25519 verification ABI", capabilities: [ffi])
extern fn rt_ed25519_verify_checked(message: [u8], pubkey: [u8], signature: [u8]) -> i64

# Verify an ECDSA P-256 SHA-256 fixed-width (64-byte r||s) signature
# (RFC 5656 ecdsa-sha2-nistp256 — the SSH-wire mpint form must be
# converted to fixed-width by the caller).
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "checked ECDSA P-256 verification ABI", capabilities: [ffi])
extern fn rt_ecdsa_p256_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64

# Verify an RSA-PSS-SHA256 signature (RFC 8017 §8.1, TLS 1.3 sig algo 0x0804).
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "legacy sentinel contract: RSA-PSS SHA-256 ABI collapses malformed bridge input into invalid", capabilities: [ffi])
extern fn rt_rsa_pss_sha256_verify(pubkey: [u8], message: [u8], signature: [u8]) -> i64
@unsafe(reason: "checked RSA-PSS SHA-256 verification ABI", capabilities: [ffi])
extern fn rt_rsa_pss_sha256_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64

# Verify an RSA-PSS-SHA384 signature (RFC 8017 §8.1, TLS 1.3 sig algo 0x0805).
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "legacy sentinel contract: RSA-PSS SHA-384 ABI collapses malformed bridge input into invalid", capabilities: [ffi])
extern fn rt_rsa_pss_sha384_verify(pubkey: [u8], message: [u8], signature: [u8]) -> i64
@unsafe(reason: "checked RSA-PSS SHA-384 verification ABI", capabilities: [ffi])
extern fn rt_rsa_pss_sha384_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64

# Verify an RSA-PSS-SHA512 signature (RFC 8017 §8.1, TLS 1.3 sig algo 0x0806).
# Returns 1 if valid, 0 otherwise.
@unsafe(reason: "legacy sentinel contract: RSA-PSS SHA-512 ABI collapses malformed bridge input into invalid", capabilities: [ffi])
extern fn rt_rsa_pss_sha512_verify(pubkey: [u8], message: [u8], signature: [u8]) -> i64
@unsafe(reason: "checked RSA-PSS SHA-512 verification ABI", capabilities: [ffi])
extern fn rt_rsa_pss_sha512_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64

# Big-integer modular exponentiation: base^exp mod modulus, all big-endian byte arrays.
# Returns the result as a big-endian byte array of the same length as `modulus`.
# FR-CRYPTO-0001: runtime-accelerated path for RSA-2048 modexp in interpreter mode.

# --- sign ---

# Sign `message` with RSA-PKCS1-SHA256 using a PKCS#8-v1 DER private key.
# Returns a checked status/signature descriptor; the safe wrapper validates it.
@unsafe(reason: "checked RSA SHA-256 signing ABI", capabilities: [ffi])
extern fn rt_rsa_sha256_sign_checked(pkcs8: [u8], message: [u8]) -> [Any]

# Sign `message` with RSA-PKCS1-SHA512 using a PKCS#8-v1 DER private key.
# Returns a checked status/signature descriptor; the safe wrapper validates it.
@unsafe(reason: "checked RSA SHA-512 signing ABI", capabilities: [ffi])
extern fn rt_rsa_sha512_sign_checked(pkcs8: [u8], message: [u8]) -> [Any]

# Sign `message` with Ed25519 using a PKCS#8-v1 DER private key (RFC 8032).
# Returns 64-byte Ed25519 signature, or an empty array on any error.
@unsafe(reason: "checked Ed25519 signing ABI", capabilities: [ffi])
extern fn rt_ed25519_sign_checked(pkcs8: [u8], message: [u8]) -> [Any]

# Sign from the RFC 8032 seed/public-key representation used by SimpleOS.
# The legacy provider returns an optional byte array, so the safe wrapper below
# validates both presence and the exact 64-byte signature contract.
@unsafe(reason: "Ed25519 seed signing ABI", capabilities: [ffi])
extern fn rt_ed25519_sign_seed(private_seed: [u8], public_key: [u8], message: [u8]) -> [u8]?

# Sign `message` with ECDSA P-256 SHA-256 using a PKCS#8-v1 DER private
# key. Returns 64-byte fixed-width r||s, or an empty array on error.
@unsafe(reason: "checked ECDSA P-256 signing ABI", capabilities: [ffi])
extern fn rt_ecdsa_p256_sign_checked(pkcs8: [u8], message: [u8]) -> [Any]

# P-384 and P-521 deliberately have no raw SFFI declarations here.  Their
# canonical implementations are the pure-Simple os.crypto.p384 and
# os.crypto.ecdsa_p521 engines.  Advertising unresolved foreign symbols made
# provider absence look like an invalid signature or an empty signature.

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

fn _checked_verify_result(status: i64, algorithm: text) -> Result<bool, text>:
    if status < 0:
        return Err("E-SFFI-010: malformed {algorithm} verification input")
    if status > 1:
        return Err("E-SFFI-017: unknown {algorithm} verification status {status}")
    Ok(status == 1)

@unsafe(reason: "minimal checked Ed25519 foreign call", capabilities: [ffi])
fn _ed25519_verify_raw_checked(message: [u8], pubkey: [u8], signature: [u8]) -> i64:
    rt_ed25519_verify_checked(message, pubkey, signature)

@unsafe(reason: "minimal checked RSA SHA-256 foreign call", capabilities: [ffi])
fn _rsa_sha256_verify_raw_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64:
    rt_rsa_sha256_verify_checked(pubkey, message, signature)

@unsafe(reason: "minimal checked RSA SHA-512 foreign call", capabilities: [ffi])
fn _rsa_sha512_verify_raw_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64:
    rt_rsa_sha512_verify_checked(pubkey, message, signature)

fn _ecdsa_p256_verify_raw_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ecdsa_p256_verify_checked(pubkey, message, signature)

@unsafe(reason: "minimal checked RSA-PSS SHA-256 foreign call", capabilities: [ffi])
fn _rsa_pss_sha256_verify_raw_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64:
    rt_rsa_pss_sha256_verify_checked(pubkey, message, signature)

@unsafe(reason: "minimal checked RSA-PSS SHA-384 foreign call", capabilities: [ffi])
fn _rsa_pss_sha384_verify_raw_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64:
    rt_rsa_pss_sha384_verify_checked(pubkey, message, signature)

@unsafe(reason: "minimal checked RSA-PSS SHA-512 foreign call", capabilities: [ffi])
fn _rsa_pss_sha512_verify_raw_checked(pubkey: [u8], message: [u8], signature: [u8]) -> i64:
    rt_rsa_pss_sha512_verify_checked(pubkey, message, signature)

fn rsa_sha256_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    _checked_verify_result(_rsa_sha256_verify_raw_checked(pubkey, message, signature), "RSA SHA-256")

fn rsa_sha512_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    _checked_verify_result(_rsa_sha512_verify_raw_checked(pubkey, message, signature), "RSA SHA-512")

fn ecdsa_p256_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    _checked_verify_result(_ecdsa_p256_verify_raw_checked(pubkey, message, signature), "ECDSA P-256")

fn rsa_pss_sha256_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    _checked_verify_result(_rsa_pss_sha256_verify_raw_checked(pubkey, message, signature), "RSA-PSS SHA-256")

fn rsa_pss_sha384_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    _checked_verify_result(_rsa_pss_sha384_verify_raw_checked(pubkey, message, signature), "RSA-PSS SHA-384")

fn rsa_pss_sha512_verify_checked(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    _checked_verify_result(_rsa_pss_sha512_verify_raw_checked(pubkey, message, signature), "RSA-PSS SHA-512")

fn _checked_sign_result(raw: [Any], algorithm: text) -> Result<[u8], text>:
    if raw.len() != 2:
        return Err("E-SFFI-017: corrupt {algorithm} signing result descriptor")
    val status = raw[0] as i64
    if status == 1:
        return Err("E-SFFI-010: malformed {algorithm} signing bridge input")
    if status == 2:
        return Err("E-SFFI-010: invalid {algorithm} private key")
    if status == 3:
        return Err("E-SFFI-017: {algorithm} provider signing failure")
    if status != 0:
        return Err("E-SFFI-017: unknown {algorithm} signing status {status}")
    val signature = raw[1] as [u8]
    if signature.len() == 0:
        return Err("E-SFFI-017: {algorithm} succeeded with an empty signature")
    Ok(signature)

# The *_checked signing externs return a 2-element [status, signature]
# descriptor; nil is only possible when the runtime bridge produced no array
# at all (provider missing). TOTAL with the documented default [] — which
# _checked_sign_result already rejects via its `raw.len() != 2` arm as
# "E-SFFI-017: corrupt ... signing result descriptor", so a bridge failure
# surfaces as an Err, never as a fabricated signature.
@unsafe(reason: "minimal checked RSA SHA-256 signing call", capabilities: [ffi])
fn _rsa_sha256_sign_raw_checked(pkcs8: [u8], message: [u8]) -> [Any]:
    rt_rsa_sha256_sign_checked(pkcs8, message) ?? []

@unsafe(reason: "minimal checked RSA SHA-512 signing call", capabilities: [ffi])
fn _rsa_sha512_sign_raw_checked(pkcs8: [u8], message: [u8]) -> [Any]:
    rt_rsa_sha512_sign_checked(pkcs8, message) ?? []

@unsafe(reason: "minimal checked Ed25519 signing call", capabilities: [ffi])
fn _ed25519_sign_raw_checked(pkcs8: [u8], message: [u8]) -> [Any]:
    rt_ed25519_sign_checked(pkcs8, message) ?? []

fn _ecdsa_p256_sign_raw_checked(pkcs8: [u8], message: [u8]) -> [Any]:
    val raw = unsafe(capabilities: [ffi]):
        rt_ecdsa_p256_sign_checked(pkcs8, message)
    raw ?? []

fn rsa_sha256_sign_checked(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    _checked_sign_result(_rsa_sha256_sign_raw_checked(pkcs8, message), "RSA SHA-256")

fn rsa_sha512_sign_checked(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    _checked_sign_result(_rsa_sha512_sign_raw_checked(pkcs8, message), "RSA SHA-512")

fn ed25519_sign_pkcs8_checked(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    _checked_sign_result(_ed25519_sign_raw_checked(pkcs8, message), "Ed25519")

fn ed25519_sign_seed_checked(
    private_seed: [u8], public_key: [u8], message: [u8]
) -> Result<[u8], text>:
    if private_seed.len() != 32:
        return Err("E-SFFI-010: invalid Ed25519 private seed length")
    if public_key.len() != 32:
        return Err("E-SFFI-010: invalid Ed25519 public key length")
    var raw: [u8]? = nil
    unsafe(capabilities: [ffi]):
        raw = rt_ed25519_sign_seed(private_seed, public_key, message)
    if val signature = raw:
        if signature.len() != 64:
            return Err("E-SFFI-017: Ed25519 seed provider returned a non-64-byte signature")
        return Ok(signature)
    Err("E-SFFI-017: Ed25519 seed provider did not return a signature")

fn ecdsa_p256_sign_checked(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    _checked_sign_result(_ecdsa_p256_sign_raw_checked(pkcs8, message), "ECDSA P-256")

fn rsa_sha256_verify(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    """Verify an RSA-PKCS1-SHA256 signature.

    Args:
        pubkey:    DER-encoded RSA public key (SubjectPublicKeyInfo)
        message:   Message bytes that were signed
        signature: Raw PKCS#1 v1.5 signature bytes

    Returns: Ok(true) if valid, Ok(false) for a mismatch, or Err for malformed input.
    """
    rsa_sha256_verify_checked(pubkey, message, signature)

fn rsa_sha512_verify(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    """Verify an RSA-PKCS1-SHA512 signature (RFC 8332 rsa-sha2-512)."""
    rsa_sha512_verify_checked(pubkey, message, signature)

fn ed25519_verify_native(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    """Verify an Ed25519 signature.

    Args:
        pubkey:    32-byte Ed25519 public key
        message:   Message bytes that were signed
        signature: 64-byte Ed25519 signature

    Returns: Ok(true) if valid, Ok(false) for a mismatch, or Err for malformed input.
    """
    ed25519_verify_native_checked(pubkey, message, signature)

fn ed25519_verify_native_checked(
    pubkey: [u8], message: [u8], signature: [u8]
) -> Result<bool, text>:
    val result = _ed25519_verify_raw_checked(message, pubkey, signature)
    if result < 0:
        return Err("E-SFFI-010: malformed Ed25519 verification input")
    Ok(result == 1)

fn ecdsa_p256_verify(pubkey: [u8], message: [u8], signature_fixed64: [u8]) -> Result<bool, text>:
    """Verify an ECDSA P-256 fixed-width signature.

    Args:
        pubkey:           DER-encoded ECDSA P-256 public key (SPKI)
        message:          Message bytes that were signed
        signature_fixed64: 64-byte r||s form (NOT the SSH mpint pair)

    Returns: Ok(true) if valid, Ok(false) for a mismatch, or Err for malformed input.
    """
    ecdsa_p256_verify_checked(pubkey, message, signature_fixed64)

fn rsa_sha256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    """Sign `message` with RSA-PKCS1-SHA256 (deterministic).

    Args:
        pkcs8:   PKCS#8 v1 DER-encoded RSA private key
        message: Bytes to sign

    Returns: signature bytes (modulus-size), or a typed error.

    Hosted-only: requires SystemRandom in the runtime.
    """
    rsa_sha256_sign_checked(pkcs8, message)

fn rsa_sha512_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    """Sign `message` with RSA-PKCS1-SHA512 (deterministic)."""
    rsa_sha512_sign_checked(pkcs8, message)

fn ed25519_sign_pkcs8(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    """Sign `message` with Ed25519 using a PKCS#8-encoded private key.

    This is the hosted-only, pkcs8-key variant used by TLS 1.3 and similar
    protocols that store the Ed25519 private key in PKCS#8 DER form.

    For RFC 8032 seed-based signing (baremetal-compatible), use
    `os.crypto.ed25519.ed25519_sign(private_seed, public_key, message)`.

    Args:
        pkcs8:   PKCS#8 v1 DER-encoded Ed25519 private key.
        message: Bytes to sign.

    Returns: a 64-byte Ed25519 signature, or a typed error.

    Deterministic per RFC 8032 (no random nonce).
    Hosted-only.
    """
    ed25519_sign_pkcs8_checked(pkcs8, message)

fn ecdsa_p256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    """Sign `message` with ECDSA P-256 (non-deterministic; 64-byte r||s).

    Convert to SSH `mpint r + mpint s` via os.crypto.ecdsa_p256 for the
    SSH wire format.
    """
    ecdsa_p256_sign_checked(pkcs8, message)

fn rsa_pss_sha256_verify_native(pubkey: [u8], message: [u8], signature: [u8]) -> bool:
    """Verify an RSA-PSS-SHA256 signature (RFC 8017 §8.1, TLS 1.3 sig algo 0x0804).

    Args:
        pubkey:    DER-encoded RSA SubjectPublicKeyInfo (SPKI).
        message:   Message bytes that were signed.
        signature: Raw PSS signature bytes.

    Returns: true if valid, false otherwise.
    """
    val result = rt_rsa_pss_sha256_verify(pubkey, message, signature)
    result == 1

fn rsa_pss_sha384_verify_native(pubkey: [u8], message: [u8], signature: [u8]) -> bool:
    """Verify an RSA-PSS-SHA384 signature (RFC 8017 §8.1, TLS 1.3 sig algo 0x0805).

    Args:
        pubkey:    DER-encoded RSA SubjectPublicKeyInfo (SPKI).
        message:   Message bytes that were signed.
        signature: Raw PSS signature bytes.

    Returns: true if valid, false otherwise.
    """
    val result = rt_rsa_pss_sha384_verify(pubkey, message, signature)
    result == 1

fn rsa_pss_sha512_verify_native(pubkey: [u8], message: [u8], signature: [u8]) -> bool:
    """Verify an RSA-PSS-SHA512 signature (RFC 8017 §8.1, TLS 1.3 sig algo 0x0806).

    Args:
        pubkey:    DER-encoded RSA SubjectPublicKeyInfo (SPKI).
        message:   Message bytes that were signed.
        signature: Raw PSS signature bytes.

    Returns: true if valid, false otherwise.
    """
    val result = rt_rsa_pss_sha512_verify(pubkey, message, signature)
    result == 1

# ============================================================================
# Tier 3: SSH Host Key Dispatcher
# ============================================================================

fn verify_host_key(key_type: text, pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    """Verify an SSH host key signature, dispatching on key type.

    Args:
        key_type:  SSH key type / sig-algo, one of:
                   "ssh-rsa"              — legacy SHA-1, not supported
                   "rsa-sha2-256"         — RFC 8332
                   "rsa-sha2-512"         — RFC 8332
                   "ssh-ed25519"          — RFC 8709
                   "ecdsa-sha2-nistp256"  — RFC 5656 (signature must
                                            already be fixed-width r||s)
        pubkey:    Raw public key bytes (type-specific encoding)
        message:   Signed message bytes (e.g. the SSH exchange hash)
        signature: Signature bytes

    Returns: Ok(true) for a valid signature, Ok(false) for a cryptographic
             mismatch, and Err for unsupported/unavailable providers.
    """
    if key_type == "rsa-sha2-256":
        rsa_sha256_verify_checked(pubkey, message, signature)
    elif key_type == "rsa-sha2-512":
        rsa_sha512_verify_checked(pubkey, message, signature)
    elif key_type == "ssh-ed25519":
        ed25519_verify_native_checked(pubkey, message, signature)
    elif key_type == "ecdsa-sha2-nistp256":
        ecdsa_p256_verify_checked(pubkey, message, signature)
    elif key_type == "ecdsa-sha2-nistp384" or key_type == "ecdsa-sha2-nistp521":
        Err("E-SFFI-014: use the canonical pure-Simple provider for {key_type}")
    else:
        Err("E-SFFI-014: unsupported SSH signature algorithm {key_type}")

fn verify_host_key_checked(
    key_type: text, pubkey: [u8], message: [u8], signature: [u8]
) -> Result<bool, text>:
    """Compatibility name for the fail-closed typed dispatcher."""
    verify_host_key(key_type, pubkey, message, signature)
