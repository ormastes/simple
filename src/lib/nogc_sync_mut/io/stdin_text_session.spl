"""Strict borrowed POSIX stdin session. No descriptor adoption or close syscall.

The caller serializes access to process-global stdin. Class references share
state; neither affine ownership nor exclusive access is enforced. Read limits
bound each encoded input chunk, not total stream length, blocking time or RSS.
"""
use std.nogc_sync_mut.io.text_session.{TextSessionCodec}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_sync_mut.io.file_bytes.{file_read_borrowed_bytes}
use std.nogc_sync_mut.sffi.platform.{platform_name_raw}
use std.common.encoding.external_text.{ExternalTextDecoder, ExternalFormat, external_text_decoder}

pub class StdinTextSession:
    _codec: TextSessionCodec
    _decoder: ExternalTextDecoder
    _failure: TextIoError?
    _eof: bool
    _closed: bool

    pub fn is_open() -> bool:
        not self._closed and self._failure == nil

    pub fn at_eof() -> bool:
        self._eof

    pub fn pending_byte_count() -> i64:
        self._decoder.pending_byte_count()

    pub me fn read_chunk(size: i64) -> Result<text?, TextIoError>:
        """Some(empty) follows consumed partial input; nil is validated EOF.

        A nonzero short read is data, never EOF. Consuming errors are sticky:
        subsequent calls return the same error without touching descriptor 0.
        """
        if val error = self._failure: return Err(error)
        if self._closed: return Err(TextIoError.Io("stdin text session is closed"))
        if size <= 0 or size > self._codec.input_byte_limit():
            return Err(TextIoError.Io("stdin read size must be positive and within the session input byte limit"))
        if self._eof: return Ok(nil)
        val bytes = match file_read_borrowed_bytes(0, size):
            case Ok(value): value
            case Err(error):
                val failure = TextIoError.Transport(error)
                self._failure = Some(failure)
                return Err(failure)
        if bytes.len() > size:
            val failure = TextIoError.Io("stdin provider exceeded requested read size")
            self._failure = Some(failure)
            return Err(failure)
        if bytes.len() == 0:
            match self._decoder.finish():
                case Err(error):
                    val failure = TextIoError.Codec(error)
                    self._failure = Some(failure)
                    return Err(failure)
                case Ok(value):
                    self._eof = true
                    if value == "": return Ok(nil)
                    return Ok(Some(value))
        match self._decoder.push(bytes):
            case Ok(value): Ok(Some(value))
            case Err(error):
                val failure = TextIoError.Codec(error)
                self._failure = Some(failure)
                Err(failure)

    pub me fn read_text(size: i64) -> Result<text, TextIoError>:
        """Return the next nonempty chunk, or empty only on validated EOF.

        Each repeated read consumed positive encoded bytes. This operation can
        block waiting for input; it does not poll or impose a transport timeout.
        """
        while true:
            match self.read_chunk(size):
                case Err(error): return Err(error)
                case Ok(chunk):
                    if val value = chunk:
                        if value != "": return Ok(value)
                    else:
                        return Ok("")

    pub me fn read_scalar_text() -> Result<text?, TextIoError>:
        """Return one complete Unicode scalar as internal UTF-8 text.

        One encoded byte per read prevents consuming a following scalar. This
        is not a primitive Char conversion or a claim about its physical ABI.
        """
        while true:
            match self.read_chunk(1):
                case Err(error): return Err(error)
                case Ok(chunk):
                    if val value = chunk:
                        if value != "": return Ok(Some(value))
                    else:
                        return Ok(nil)

    pub me fn close():
        """Cancel reads without closing fd0 or validating unread/pending input."""
        self._closed = true

pub fn stdin_text_session(codec: TextSessionCodec) -> Result<StdinTextSession, TextIoError>:
    """Bind the existing POSIX byte provider after metadata admission.

    The caller must own serialized access from the stream's encoding start;
    creating another session midway cannot recover consumed BOM/carry state.
    """
    codec.validate()?
    val platform = platform_name_raw()
    if platform != "linux" and platform != "macos" and platform != "unix" and platform != "freebsd" and platform != "illumos" and platform != "solaris":
        return Err(TextIoError.Unsupported("checked stdin requires the admitted POSIX byte provider; Windows console/binary mode is not qualified"))
    val format = ExternalFormat(encoding: codec.read_encoding(), byte_order: codec.read_byte_order(), bom: codec.read_bom())
    val decoder = match external_text_decoder(format):
        case Ok(value): value
        case Err(error): return Err(TextIoError.Codec(error))
    Ok(StdinTextSession(_codec: codec, _decoder: decoder, _failure: nil, _eof: false, _closed: false))

export StdinTextSession, stdin_text_session
