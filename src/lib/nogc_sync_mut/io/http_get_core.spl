# Narrow HTTP GET boundary for core native entries.
# Keep the raw transport in its own object so optional HTTP server and
# WebSocket bindings do not become link requirements of a GET-only entry.

@unsafe(reason: "raw URL text and runtime-owned response tuple ABI; negative status denotes transport failure", capabilities: [ffi])
extern fn rt_http_get(url: text) -> (i64, text, text)

fn http_get_raw(url: text) -> (i64, text, text):
    unsafe(capabilities: [ffi]):
        rt_http_get(url)

export rt_http_get, http_get_raw
