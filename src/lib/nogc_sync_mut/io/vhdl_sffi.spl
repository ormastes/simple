# VHDL Toolchain SFFI Bindings
#
# SFFI pattern for VHDL synthesis/simulation tools.
# Wraps GHDL and Yosys command-line invocations.

use std.nogc_sync_mut.io.process_ops.{process_run, process_run_bounded}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{is_dir, dir_remove_all}
use std.nogc_sync_mut.io.env_ops.{cwd}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}

# ============================================================================
# Tier 1: File Extern Declarations (Raw SFFI)
# ============================================================================

use std.io_runtime.{file_exists}
use std.nogc_sync_mut.io.file_ops.{file_read_text}
use std.io_runtime.{file_write}

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

struct VhdlToolResult:
    success: bool
    exit_code: i64
    stdout: text
    stderr: text

# reason: positional io vhdl_sffi API
fn vhdl_tool_result(code: i64, stdout: text, stderr: text) -> VhdlToolResult:
    VhdlToolResult(
        success: code == 0,
        exit_code: code,
        stdout: stdout,
        stderr: stderr
    )

fn vhdl_process_run(command: text, args: [text]) -> VhdlToolResult:
    val result = process_run(command, args)
    vhdl_tool_result(result.2, result.0, result.1)

# === GHDL Analysis & Elaboration ===
# Explicit workspaces are caller-owned and reused for analyze/elaborate/run.
# The compatibility API owns one private workspace per process, for sequential
# callers only. Call ghdl_close_default_workspace after the complete workflow.
# Concurrent workflows must use distinct explicit workspaces. A forked child
# cannot reuse or remove its parent's compatibility workspace.
var _ghdl_default_dir: text = ""
var _ghdl_default_pid: i64 = 0

fn ghdl_create_workspace(parent: text) -> Result<text, text>:
    secure_temp_dir(parent, "simple-ghdl-")

fn _ghdl_default_workspace() -> Result<text, text>:
    val pid = getpid()
    if _ghdl_default_dir != "" and _ghdl_default_pid == pid:
        return Ok(_ghdl_default_dir)
    val directory = ghdl_create_workspace("/tmp")?
    _ghdl_default_dir = directory
    _ghdl_default_pid = pid
    Ok(directory)

fn ghdl_close_default_workspace() -> bool:
    if _ghdl_default_dir == "" or _ghdl_default_pid != getpid():
        return true
    if not dir_remove_all(_ghdl_default_dir):
        return false
    _ghdl_default_dir = ""
    _ghdl_default_pid = 0
    true

fn _ghdl_absolute(path: text) -> text:
    if path.starts_with("/"): path else: cwd() + "/" + path

fn _ghdl_in(work_dir: text, args: [text]) -> VhdlToolResult:
    # GHDL's --workdir redirects its library, not LLVM/GCC backend outputs.
    # Change cwd ONLY in the child. The fixed shell program receives every
    # path/argument as positional data (including spaces/quotes/metacharacters).
    # This is the POSIX GHDL lane; no parent-global chdir or raw runtime hook.
    if work_dir == "" or not is_dir(work_dir):
        return vhdl_tool_result(-1, "", "GHDL workspace must already exist")
    var child_args = ["-c", "CDPATH= cd -- \"$1\" && shift && exec \"$@\"", "simple-ghdl", _ghdl_absolute(work_dir), "ghdl"]
    for arg in args:
        child_args.push(arg)
    val result = process_run("/bin/sh", child_args)
    vhdl_tool_result(result.2, result.0, result.1)

fn ghdl_available() -> bool:
    val result = process_run_bounded("ghdl", ["--version"], 10000, 65536)
    result.2 == 0

fn ghdl_analyze_in(work_dir: text, vhdl_file: text) -> VhdlToolResult:
    _ghdl_in(work_dir, ["-a", "--std=08", "--workdir=.", _ghdl_absolute(vhdl_file)])

fn ghdl_elaborate_in(work_dir: text, entity_name: text) -> VhdlToolResult:
    _ghdl_in(work_dir, ["-e", "--std=08", "--workdir=.", entity_name])

fn ghdl_run_in(work_dir: text, entity_name: text, stop_time: text?) -> VhdlToolResult:
    var args = ["-r", "--std=08", "--workdir=.", entity_name]
    match stop_time:
        Some(value):
            args.push("--stop-time={value}")
        nil:
            pass_do_nothing("GHDL run has no stop time")
    _ghdl_in(work_dir, args)

fn ghdl_synth_in(work_dir: text, entity_name: text) -> VhdlToolResult:
    _ghdl_in(work_dir, ["--synth", "--std=08", "--workdir=.", entity_name])

fn ghdl_analyze_and_elaborate_in(work_dir: text, vhdl_file: text, entity_name: text) -> VhdlToolResult:
    val analyze = ghdl_analyze_in(work_dir, vhdl_file)
    if not analyze.success:
        return analyze
    ghdl_elaborate_in(work_dir, entity_name)

fn ghdl_analyze(vhdl_file: text) -> VhdlToolResult:
    match _ghdl_default_workspace():
        Ok(directory): ghdl_analyze_in(directory, vhdl_file)
        Err(message): vhdl_tool_result(-1, "", message)

fn ghdl_elaborate(entity_name: text) -> VhdlToolResult:
    match _ghdl_default_workspace():
        Ok(directory): ghdl_elaborate_in(directory, entity_name)
        Err(message): vhdl_tool_result(-1, "", message)

fn ghdl_run(entity_name: text, stop_time: text?) -> VhdlToolResult:
    match _ghdl_default_workspace():
        Ok(directory): ghdl_run_in(directory, entity_name, stop_time)
        Err(message): vhdl_tool_result(-1, "", message)

fn ghdl_synth(entity_name: text) -> VhdlToolResult:
    match _ghdl_default_workspace():
        Ok(directory): ghdl_synth_in(directory, entity_name)
        Err(message): vhdl_tool_result(-1, "", message)

fn ghdl_analyze_and_elaborate(vhdl_file: text, entity_name: text) -> VhdlToolResult:
    match _ghdl_default_workspace():
        Ok(directory): ghdl_analyze_and_elaborate_in(directory, vhdl_file, entity_name)
        Err(message): vhdl_tool_result(-1, "", message)

# === Yosys Synthesis ===

fn yosys_available() -> bool:
    """Check if Yosys is installed."""
    vhdl_process_run("yosys", ["--version"]).success

# reason: positional io vhdl_sffi API
fn yosys_synth_ghdl(vhdl_file: text, entity_name: text, output_json: text) -> VhdlToolResult:
    """Synthesize VHDL using Yosys with GHDL plugin."""
    val script = "mkdir -p /tmp/ghdl_work && ghdl --std=08 --workdir=/tmp/ghdl_work -a {vhdl_file}; ghdl --std=08 --workdir=/tmp/ghdl_work {entity_name}; synth -top {entity_name}; write_json {output_json}"
    vhdl_process_run("yosys", ["-m", "ghdl", "-p", script])

# === File Operations ===

# reason: positional io vhdl_sffi API
fn vhdl_write_file(path: text, content: text) -> bool:
    """Write VHDL source to a file."""
    file_write(path, content)

fn vhdl_read_file(path: text) -> text?:
    """Read a VHDL source file."""
    if file_exists(path):
        Some(file_read_text(path))
    else:
        nil

fn vhdl_file_exists(path: text) -> bool:
    """Check if a VHDL file exists."""
    file_exists(path)

