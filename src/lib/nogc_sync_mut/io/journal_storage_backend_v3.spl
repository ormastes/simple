#![allow(primitive_api)]
# primitive_api: reviewed protected-storage/broker ABI keeps byte bounds, phases, deadlines and flags as i64/bool (milestone_0011 broker-stack review r1).
# A discriminated backend prevents mixed or absent protected capabilities.
# Legacy wrappers construct LegacyPath explicitly; protected journal opens
# can construct Linux only from the existing oracle's actual busy ticket.
use std.nogc_sync_mut.io.windows_journal_store_v1.WindowsJournalStoreV1
use std.common.task_runner.distributed_operation_owner_health_v2.OperationJournalLinuxStorageBorrowV1

pub enum JournalStorageBackendV3:
    LegacyPath
    Windows(store: WindowsJournalStoreV1)
    Linux(store: OperationJournalLinuxStorageBorrowV1)

pub fn journal_storage_backend_windows_v3(store: Option<WindowsJournalStoreV1>) -> JournalStorageBackendV3:
    match store:
        case Some(value): JournalStorageBackendV3.Windows(value)
        case None: JournalStorageBackendV3.LegacyPath

pub fn journal_storage_is_legacy_v3(backend: JournalStorageBackendV3) -> bool:
    match backend:
        case JournalStorageBackendV3.LegacyPath: true
        case _: false

pub fn journal_storage_read_v3(backend: JournalStorageBackendV3, relative: text, maximum: i64) -> Result<Option<text>, text>:
    match backend:
        case JournalStorageBackendV3.Windows(store): store.read(relative, maximum)
        case JournalStorageBackendV3.Linux(store): store.read(relative, maximum)
        case _: Err("JOURNAL_PROTECTED_STORAGE_REQUIRED")

pub fn journal_storage_publish_v3(backend: JournalStorageBackendV3, relative: text, payload: text) -> Result<bool, text>:
    match backend:
        case JournalStorageBackendV3.Windows(store): store.publish(relative, payload)
        case JournalStorageBackendV3.Linux(store): store.publish(relative, payload)
        case _: Err("JOURNAL_PROTECTED_STORAGE_REQUIRED")

pub fn journal_storage_compare_replace_v3(backend: JournalStorageBackendV3,
        relative: text, payload: text, expected: Option<text>) -> Result<bool, text>:
    match backend:
        case JournalStorageBackendV3.Windows(store): store.compare_replace(relative, payload, expected)
        case JournalStorageBackendV3.Linux(store): store.compare_replace(relative, payload, expected)
        case _: Err("JOURNAL_PROTECTED_STORAGE_REQUIRED")
