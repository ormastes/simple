# CUDA Runtime SFFI Bindings
#
# Legacy CUDA runtime ABI owner for Simple-friendly I/O wrappers.
# The GC async compatibility family imports this module instead of
# declaring these runtime hooks locally.

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

@unsafe(reason: "raw CUDA availability ABI; contract: zero means unavailable", capabilities: [ffi])
extern fn rt_cuda_available() -> i64
@unsafe(reason: "raw CUDA initialization status ABI; contract: zero means success", capabilities: [ffi])
extern fn rt_cuda_init() -> i64
@unsafe(reason: "raw CUDA device-count ABI; contract: zero means no devices or provider failure", capabilities: [ffi])
extern fn rt_cuda_device_count() -> i64
@unsafe(reason: "raw CUDA device handle ABI; contract: negative means failure", capabilities: [ffi])
extern fn rt_cuda_device_get(device_id: i64) -> i64
@unsafe(reason: "raw CUDA device-name ABI; contract: borrowed nonnull process-lifetime text", capabilities: [ffi])
extern fn rt_cuda_device_name(device: i64) -> text
@unsafe(reason: "raw CUDA capability ABI; contract: non-positive means invalid device", capabilities: [ffi])
extern fn rt_cuda_device_compute_capability(device: i64) -> i64
@unsafe(reason: "raw CUDA context handle ABI; contract: non-positive means failure", capabilities: [ffi])
extern fn rt_cuda_ctx_create(device: i64) -> i64
@unsafe(reason: "raw CUDA current-context status ABI; contract: zero means success", capabilities: [ffi])
extern fn rt_cuda_ctx_set_current(ctx: i64) -> i64
@unsafe(reason: "raw CUDA device allocation ABI; contract: non-positive means failure", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_mem_alloc(size: i64) -> i64
extern fn rt_cuda_mem_free(ptr: i64) -> i64
@unsafe(reason: "raw CUDA host-to-device extent copy status ABI; contract: zero means success", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_memcpy_htod_array(dst_device: i64, data: [u8], byte_count: i64) -> i64
@unsafe(reason: "raw CUDA device-to-host pointer extent copy status ABI; contract: zero means success", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_memcpy_dtoh(dst_host: i64, src_device: i64, size: i64) -> i64
@unsafe(reason: "raw CUDA device pointer extent copy status ABI; contract: zero means success", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_memcpy_dtod(dst: i64, src: i64, size: i64) -> i64
@unsafe(reason: "raw CUDA device pointer extent fill status ABI; contract: zero means success", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_memset(ptr: i64, value: i64, size: i64) -> i64
@unsafe(reason: "raw CUDA PTX pointer extent ABI; contract: non-positive handle means failure", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_module_load_data_bytes(ptx_ptr: i64, ptx_len: i64) -> i64
@unsafe(reason: "raw CUDA module release status ABI; contract: zero means success", capabilities: [ffi])
extern fn rt_cuda_module_unload(module: i64) -> i64
@unsafe(reason: "raw CUDA launch pointer/status ABI; contract: zero means success", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_launch_kernel(module: i64, func_name: text, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, args_ptr: i64) -> i64
@unsafe(reason: "raw CUDA synchronization status ABI; contract: zero means success", capabilities: [ffi])
extern fn rt_cuda_sync() -> i64
# Plan E2: launch with dynamic shared memory + stream slot (stream 0 = default).
@unsafe(reason: "raw CUDA extended launch pointer/status ABI; contract: zero means success", capabilities: [ffi, raw_ptr])
extern fn rt_cuda_launch_kernel_ex(module: i64, func_name: text, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, shared_bytes: i64, stream: i64, args_ptr: i64) -> i64
@unsafe(reason: "raw CUDA error text ABI; contract: provider returns borrowed nonnull static text", capabilities: [ffi])
extern fn rt_cuda_get_error_string(error_code: i64) -> text

# Host staging for kernel parameter blocks and device->host reads.
@unsafe(reason: "raw host staging allocation ABI; contract: zero means failure", capabilities: [ffi, raw_ptr])
extern fn rt_alloc(size: i64) -> i64
@unsafe(reason: "raw host staging release ABI; contract: ownership is caller-established", capabilities: [ffi, raw_ptr])
extern fn rt_free(ptr: i64)
@unsafe(reason: "raw pointer offset i64 write ABI; contract: caller establishes allocation bounds", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_i64(ptr: i64, offset: i64, value: i64)
@unsafe(reason: "raw pointer offset byte read ABI; contract: caller establishes allocation bounds", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_read_u8(ptr: i64, offset: i64) -> i64
@unsafe(reason: "raw pointer offset byte write ABI; contract: caller establishes allocation bounds", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_u8(ptr: i64, offset: i64, value: i64)

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

fn cuda_available() -> bool:
    rt_cuda_is_available()

fn cuda_device_count() -> i64:
    rt_cuda_device_count()

fn cuda_set_device(id: i64) -> bool:
    rt_cuda_set_device(id)

fn cuda_get_device() -> i64:
    rt_cuda_get_device()

struct CudaDeviceInfo:
    id: i64
    name: text
    total_memory: i64
    compute_capability: (i64, i64)

fn cuda_device_info(id: i64) -> CudaDeviceInfo:
    CudaDeviceInfo(id: id, name: rt_cuda_device_name(id), total_memory: rt_cuda_device_memory(id), compute_capability: rt_cuda_compute_capability(id))

struct CudaPtr:
    ptr: i64
    size: i64
    is_valid: bool

fn cuda_alloc(size: i64) -> CudaPtr:
    val ptr = rt_cuda_mem_alloc(size)
    CudaPtr(ptr: ptr, size: size, is_valid: ptr > 0)

fn cuda_free(mem: CudaPtr) -> bool:
    if mem.is_valid:
        rt_cuda_free(mem.ptr)
    else:
        true

fn cuda_copy_to_device(dst: CudaPtr, src: [u8]) -> bool:
    if not dst.is_valid:
        false
    else:
        rt_cuda_memcpy_h2d(dst.ptr, src, src.len())

fn cuda_copy_from_device(dst: [u8], src: CudaPtr) -> bool:
    if not src.is_valid:
        false
    else:
        rt_cuda_memcpy_d2h(dst, src.ptr, dst.len())

# reason: positional io cuda_sffi API
fn cuda_copy_device_to_device(dst: CudaPtr, src: CudaPtr, size: i64) -> bool:
    if not dst.is_valid or not src.is_valid:
        false
    else:
        rt_cuda_memcpy_d2d(dst.ptr, src.ptr, size)

fn cuda_memset(mem: CudaPtr, value: i64) -> bool:
    if not mem.is_valid:
        false
    else:
        rt_cuda_memset(mem.ptr, value, mem.size)

struct CudaModule:
    handle: i64
    is_valid: bool

fn cuda_compile(ptx_source: text) -> CudaModule:
    val handle = rt_cuda_compile_ptx(ptx_source)
    CudaModule(handle: handle, is_valid: handle > 0)

fn cuda_unload(module: CudaModule) -> bool:
    if module.is_valid:
        rt_cuda_unload_module(module.handle)
    else:
        true

struct CudaFunc:
    handle: i64
    module: CudaModule
    name: text
    is_valid: bool

fn cuda_get_kernel(module: CudaModule, name: text) -> CudaFunc:
    if not module.is_valid:
        CudaFunc(handle: 0, module: module, name: name, is_valid: false)
    else:
        val handle = rt_cuda_get_function(module.handle, name)
        CudaFunc(handle: handle, module: module, name: name, is_valid: handle > 0)

struct CudaLaunchConfig:
    gx: i64
    gy: i64
    gz: i64
    blk_x: i64
    blk_y: i64
    blk_z: i64
    shared_mem: i64

# reason: positional io cuda_sffi API
fn cuda_launch_config_3d(gx: i64, gy: i64, gz: i64, blk_x: i64, blk_y: i64, blk_z: i64) -> CudaLaunchConfig:
    CudaLaunchConfig(gx: gx, gy: gy, gz: gz, blk_x: blk_x, blk_y: blk_y, blk_z: blk_z, shared_mem: 0)

# reason: positional io cuda_sffi API
fn cuda_launch_config_1d(grid_size: i64, block_size: i64) -> CudaLaunchConfig:
    CudaLaunchConfig(gx: grid_size, gy: 1, gz: 1, blk_x: block_size, blk_y: 1, blk_z: 1, shared_mem: 0)

fn cuda_launch(kfn: CudaFunc, config: CudaLaunchConfig, args: [i64]) -> bool:
    if not kfn.is_valid:
        false
    else:
        rt_cuda_launch_kernel(kfn.handle, config.gx, config.gy, config.gz, config.blk_x, config.blk_y, config.blk_z, config.shared_mem, args)

fn cuda_sync() -> bool:
    rt_cuda_synchronize()

struct CudaStream:
    handle: i64
    is_valid: bool

fn cuda_stream_create() -> CudaStream:
    val handle = rt_cuda_stream_create()
    CudaStream(handle: handle, is_valid: handle > 0)

fn cuda_stream_destroy(stream: CudaStream) -> bool:
    if stream.is_valid:
        rt_cuda_stream_destroy(stream.handle)
    else:
        true

fn cuda_stream_sync(stream: CudaStream) -> bool:
    if stream.is_valid:
        rt_cuda_stream_synchronize(stream.handle)
    else:
        true

fn cuda_last_error() -> text:
    rt_cuda_get_last_error()

fn cuda_peek_error() -> text:
    rt_cuda_peek_last_error()

# reason: positional io cuda_sffi API
fn cuda_run_1d(kfn: CudaFunc, total_elements: i64, block_size: i64, args: [i64]) -> bool:
    val grid_size = (total_elements + block_size - 1) / block_size
    val config = cuda_launch_config_1d(grid_size, block_size)
    cuda_launch(kfn, config, args) and cuda_sync()

fn cuda_alloc_from_host(data: [u8]) -> CudaPtr:
    val mem = cuda_alloc(data.len())
    if mem.is_valid:
        cuda_copy_to_device(mem, data)
    mem
