# Linux hosted libc boundary only. No Simple runtime export is introduced.
# AUTHORED_NOT_RUN: libc/linker admission remains required on each target.
@when(os="linux"):
pub use std.nogc_sync_mut.io.retained_file_abi.{openat, pread, close, statx, geteuid, malloc, free}
@unsafe(reason: "actual real Linux process credential", capabilities: [ffi])
extern fn getuid() -> u32
@unsafe(reason: "actual real Linux process group credential", capabilities: [ffi])
extern fn getgid() -> u32
@unsafe(reason: "actual effective Linux process group credential", capabilities: [ffi])
extern fn getegid() -> u32
@unsafe(reason: "actual calling thread ID, never caller-supplied PID metadata", capabilities: [ffi])
extern fn gettid() -> i32
@unsafe(reason: "actual process ID, independently checked against genuine procfs self", capabilities: [ffi])
extern fn getpid() -> i32
@unsafe(reason: "bounded genuine procfs self symlink observation", capabilities: [ffi, raw_ptr])
extern fn readlinkat(directory: i32, name: i64, buffer: i64, maximum: u64) -> i64
@unsafe(reason: "Linux statfs writes a target-sized caller-owned buffer", capabilities: [ffi, raw_ptr])
extern fn fstatfs(fd: i32, buffer: i64) -> i32
@unsafe(reason: "Linux nsfs query; returned owner namespace descriptor is retained before validation", capabilities: [ffi])
extern fn ioctl(fd: i32, request: u64) -> i32
@unsafe(reason: "Linux libc physical hardware totals, checked before multiplication", capabilities: [ffi])
extern fn sysconf(name: i32) -> i64
export getuid, getgid, getegid, gettid, getpid, readlinkat, fstatfs, ioctl, sysconf
@end
