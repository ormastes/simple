"""Typed external-text transport errors and legacy UTF-8 compatibility bridges.

Transport owns bytes; only the shared codec may construct internal text.
No locale, operating-system, or network charset inference occurs here.
"""

use std.common.encoding.external_text.{ExternalText, ExternalFormat, CodecError,
    external_text, external_text_from_internal, external_text_decode, external_encode_internal, utf8_format}

use std.io.types.{IoError}

enum TextIoError:
    Io(text)
    Transport(IoError)
    Native(i64, text)
    Unsupported(text)
    Codec(CodecError)

fn io_external_text(bytes: [u8], format: ExternalFormat) -> Result<ExternalText, TextIoError>:
    match external_text(bytes, format):
        case Ok(value): Ok(value)
        case Err(error): Err(TextIoError.Codec(error))

fn io_external_bytes(value: ExternalText) -> Result<[u8], TextIoError>:
    match value.encoded_bytes():
        case Ok(bytes): Ok(bytes)
        case Err(error): Err(TextIoError.Codec(error))

fn io_external_from_internal(value: text, format: ExternalFormat) -> Result<ExternalText, TextIoError>:
    match external_text_from_internal(value, format):
        case Ok(encoded): Ok(encoded)
        case Err(error): Err(TextIoError.Codec(error))

fn io_internal_text(value: ExternalText) -> Result<text, TextIoError>:
    match value.to_internal_text():
        case Ok(decoded): Ok(decoded)
        case Err(error): Err(TextIoError.Codec(error))

# Single-owner transfers: decode or encode once with no intermediate owned copy.
fn io_text_decode(bytes: [u8], format: ExternalFormat) -> Result<text, TextIoError>:
    match external_text_decode(bytes, format):
        case Ok(decoded): Ok(decoded)
        case Err(error): Err(TextIoError.Codec(error))

fn io_text_encode(value: text, format: ExternalFormat) -> Result<[u8], TextIoError>:
    match external_encode_internal(value, format):
        case Ok(bytes): Ok(bytes)
        case Err(error): Err(TextIoError.Codec(error))

fn io_text_error_message(error: TextIoError) -> text:
    match error:
        case TextIoError.Io(message): message
        case TextIoError.Transport(error): error.message
        case TextIoError.Native(status, message): "{message}: native status {status}"
        case TextIoError.Unsupported(message): message
        case TextIoError.Codec(codec): "external text at byte {codec.byte_offset}: {codec.reason}"

fn io_legacy_utf8(bytes: [u8]) -> Result<text, text>:
    match io_text_decode(bytes, utf8_format()):
        case Ok(value): Ok(value)
        case Err(error): Err(io_text_error_message(error))

export TextIoError, io_external_text, io_external_from_internal, io_internal_text
export io_text_error_message, io_legacy_utf8, io_external_bytes, io_text_decode, io_text_encode
