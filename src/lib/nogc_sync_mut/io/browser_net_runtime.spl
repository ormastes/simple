#![allow(unnamed_duplicate_typed_args)]

# Hosted browser-network ABI owner. Rendering modules use these narrow helpers
# instead of binding raw runtime symbols directly.
extern fn rt_dns_lookup(hostname: text) -> text
extern fn rt_string_free(value: text) -> i64
use std.io_runtime.{time_now_monotonic_ms}
extern fn rt_tls_client_connect_with_sni(host: text, port: i64, server_name: text) -> i64
extern fn rt_tls_client_write(conn: i64, data: text) -> i64
extern fn rt_tls_client_read(conn: i64, max_bytes: i64) -> text
extern fn rt_tls_client_close(conn: i64) -> bool
extern fn rt_tls_get_protocol_version(conn: i64) -> text

pub fn browser_dns_lookup(hostname: text) -> text: rt_dns_lookup(hostname)
pub fn browser_runtime_string_free(value: text) -> i64: rt_string_free(value)
pub fn browser_monotonic_ms() -> i64: time_now_monotonic_ms()
pub fn browser_tls_connect(host: text, port: i64, server_name: text) -> i64: rt_tls_client_connect_with_sni(host, port, server_name)
pub fn browser_tls_connect_address(
    address: text, port: i64, server_name: text, timeout_ms: i64
) -> i64:
    # Pure-Simple safe fallback: timeout-aware runtime symbol is optional in older
    # runtimes, so we use SNI connect today and keep deadline enforcement
    # at the pure-Simple policy layer.
    if timeout_ms < 0:
        rt_tls_client_connect_with_sni(address, port, server_name)
    else:
        rt_tls_client_connect_with_sni(address, port, server_name)
pub fn browser_tls_write(conn: i64, data: text) -> i64: rt_tls_client_write(conn, data)
pub fn browser_tls_write_timeout(conn: i64, data: text, timeout_ms: i64) -> i64:
    # Pure-Simple safe fallback; enforce timeout behavior in the caller's policy.
    if timeout_ms < 0:
        rt_tls_client_write(conn, data)
    else:
        rt_tls_client_write(conn, data)
pub fn browser_tls_read(conn: i64, max_bytes: i64) -> text: rt_tls_client_read(conn, max_bytes)
pub fn browser_tls_read_timeout(conn: i64, max_bytes: i64, timeout_ms: i64) -> text:
    # Pure-Simple safe fallback; enforce timeout behavior in the caller's policy.
    if timeout_ms < 0:
        rt_tls_client_read(conn, max_bytes)
    else:
        rt_tls_client_read(conn, max_bytes)
pub fn browser_tls_close(conn: i64) -> bool: rt_tls_client_close(conn)
pub fn browser_tls_protocol(conn: i64) -> text: rt_tls_get_protocol_version(conn)
