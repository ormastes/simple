# Linux cgroup-v2 resource-scope observations.
#
# Scope lifecycle/attachment belongs to the process provider. This module reads
# an already-owned delegated scope and converts kernel files into typed evidence
# without relabeling cgroup charge as RSS.

use std.nogc_sync_mut.io.file_ops.{file_exists, file_read_text, file_write}
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove}
use std.nogc_sync_mut.io.process_governor.{proc_slot_acquire, proc_slot_release}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded, process_bounded_timed_out, process_bounded_kill_signal}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{getpid}
use std.convert.{try_parse_int}
use std.common.perf.execution_metrics.{ResourceUsage, ResourceEvidenceQuality, TerminationCause, TerminationEvidence, ResourceBudget, BudgetDecision, evaluate_resource_budget, classify_termination}

@unsafe(reason: "runtime-owned bounded child tree with versioned lifecycle and resource receipts", capabilities: [ffi])
extern fn rt_process_run_owned_observed_bounded_value(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, [i64])

fn _process_run_observed_raw(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, [i64]):
    unsafe(capabilities: [ffi]):
        rt_process_run_owned_observed_bounded_value(cmd, args, timeout_ms, max_output_bytes)

struct ObservedProcessResult:
    stdout: text
    stderr: text
    usage: ResourceUsage
    stdout_truncated: bool
    stderr_truncated: bool
    runtime_error: i64

pub enum ExecutionResourceClass:
    Unit
    Integration
    System
    Qemu
    Gpu
    Bootstrap
    Tiny
    Standard
    Large
    Unbounded

pub struct ExecutionResourceScope:
    resource_class: ExecutionResourceClass
    budget: ResourceBudget
    timeout_ms: i64
    max_output_bytes: i64

pub struct ExecutionScopeResult:
    process: ObservedProcessResult
    budget_decision: BudgetDecision

pub struct CurrentExecutionResourceScope:
    scope: ExecutionResourceScope
    parent_path: text
    scope_path: text
    started_micros: i64
    available: bool

pub fn standard_resource_budget(resource_class: ExecutionResourceClass) -> ResourceBudget:
    """Return explicit quantities; history is never consulted here."""
    match resource_class:
        case ExecutionResourceClass.Unit:
            ResourceBudget(max_wall_ms: 300_000, max_cpu_ms: 600_000, max_tree_charge_bytes: 2_147_483_648, max_direct_child_rss_bytes: 2_147_483_648, max_io_read_bytes: 8_589_934_592, max_io_write_bytes: 2_147_483_648, max_pids: 128, max_fds: 256)
        case ExecutionResourceClass.Integration:
            ResourceBudget(max_wall_ms: 900_000, max_cpu_ms: 3_600_000, max_tree_charge_bytes: 4_294_967_296, max_direct_child_rss_bytes: 4_294_967_296, max_io_read_bytes: 34_359_738_368, max_io_write_bytes: 8_589_934_592, max_pids: 512, max_fds: 512)
        case ExecutionResourceClass.System:
            ResourceBudget(max_wall_ms: 1_800_000, max_cpu_ms: 7_200_000, max_tree_charge_bytes: 17_179_869_184, max_direct_child_rss_bytes: 17_179_869_184, max_io_read_bytes: 68_719_476_736, max_io_write_bytes: 17_179_869_184, max_pids: 2048, max_fds: 1024)
        case ExecutionResourceClass.Qemu:
            ResourceBudget(max_wall_ms: 1_800_000, max_cpu_ms: 7_200_000, max_tree_charge_bytes: 8_589_934_592, max_direct_child_rss_bytes: 8_589_934_592, max_io_read_bytes: 68_719_476_736, max_io_write_bytes: 17_179_869_184, max_pids: 2048, max_fds: 1024)
        case ExecutionResourceClass.Gpu:
            ResourceBudget(max_wall_ms: 1_800_000, max_cpu_ms: 7_200_000, max_tree_charge_bytes: 17_179_869_184, max_direct_child_rss_bytes: 17_179_869_184, max_io_read_bytes: 68_719_476_736, max_io_write_bytes: 17_179_869_184, max_pids: 2048, max_fds: 1024)
        case ExecutionResourceClass.Bootstrap:
            ResourceBudget(max_wall_ms: 14_400_000, max_cpu_ms: 57_600_000, max_tree_charge_bytes: 68_719_476_736, max_direct_child_rss_bytes: 68_719_476_736, max_io_read_bytes: 274_877_906_944, max_io_write_bytes: 68_719_476_736, max_pids: 4096, max_fds: 4096)
        case ExecutionResourceClass.Tiny:
            ResourceBudget(max_wall_ms: 30_000, max_cpu_ms: 30_000, max_tree_charge_bytes: 268_435_456, max_direct_child_rss_bytes: 268_435_456, max_io_read_bytes: 1_073_741_824, max_io_write_bytes: 268_435_456, max_pids: 32, max_fds: 64)
        case ExecutionResourceClass.Standard:
            ResourceBudget(max_wall_ms: 300_000, max_cpu_ms: 600_000, max_tree_charge_bytes: 2_147_483_648, max_direct_child_rss_bytes: 2_147_483_648, max_io_read_bytes: 8_589_934_592, max_io_write_bytes: 2_147_483_648, max_pids: 256, max_fds: 256)
        case ExecutionResourceClass.Large:
            ResourceBudget(max_wall_ms: 1_800_000, max_cpu_ms: 7_200_000, max_tree_charge_bytes: 17_179_869_184, max_direct_child_rss_bytes: 17_179_869_184, max_io_read_bytes: 68_719_476_736, max_io_write_bytes: 17_179_869_184, max_pids: 2048, max_fds: 1024)
        case ExecutionResourceClass.Unbounded:
            ResourceBudget(max_wall_ms: 0, max_cpu_ms: 0, max_tree_charge_bytes: 0, max_direct_child_rss_bytes: 0, max_io_read_bytes: 0, max_io_write_bytes: 0, max_pids: 0)

pub fn execution_resource_scope(resource_class: ExecutionResourceClass, timeout_ms: i64 = 0, max_output_bytes: i64 = 1_048_576) -> ExecutionResourceScope:
    val standard = standard_resource_budget(resource_class)
    ExecutionResourceScope(resource_class: resource_class, budget: standard, timeout_ms: if timeout_ms > 0: timeout_ms else: standard.max_wall_ms, max_output_bytes: max_output_bytes)

pub fn execution_resource_scope_with_budget(resource_class: ExecutionResourceClass, budget: ResourceBudget, max_output_bytes: i64 = 1_048_576) -> ExecutionResourceScope:
    ExecutionResourceScope(resource_class: resource_class, budget: budget, timeout_ms: budget.max_wall_ms, max_output_bytes: max_output_bytes)

fn _shell_quote(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

fn _cgroup_v2_parent() -> text:
    if not file_exists("/sys/fs/cgroup/cgroup.controllers") or not file_exists("/proc/self/cgroup"):
        return ""
    for line in file_read_text("/proc/self/cgroup").split("\n"):
        if line.starts_with("0::"):
            val relative = line[3:].trim()
            return if relative == "/" or relative == "": "/sys/fs/cgroup" else: "/sys/fs/cgroup" + relative
    ""

fn _prepare_cgroup_v2(scope: ExecutionResourceScope) -> text:
    val parent = _cgroup_v2_parent()
    if parent == "":
        return ""
    val path = parent + "/simple-scope-{getpid()}-{time_now_unix_micros()}"
    if not dir_create(path, false):
        return ""
    if (scope.budget.max_tree_charge_bytes > 0 and
            (not file_exists(path + "/memory.max") or not file_write(path + "/memory.max", "{scope.budget.max_tree_charge_bytes}"))):
        val _ = dir_remove(path, false)
        return ""
    if (scope.budget.max_pids > 0 and
            (not file_exists(path + "/pids.max") or not file_write(path + "/pids.max", "{scope.budget.max_pids}"))):
        val _ = dir_remove(path, false)
        return ""
    path

pub fn begin_current_execution_resource_scope(scope: ExecutionResourceScope) -> CurrentExecutionResourceScope:
    val parent = _cgroup_v2_parent()
    val path = _prepare_cgroup_v2(scope)
    if parent == "" or path == "" or not file_write(path + "/cgroup.procs", "{getpid()}"):
        if path != "":
            val _ = dir_remove(path, false)
        return CurrentExecutionResourceScope(scope: scope, parent_path: parent, scope_path: "", started_micros: time_now_unix_micros(), available: false)
    CurrentExecutionResourceScope(scope: scope, parent_path: parent, scope_path: path, started_micros: time_now_unix_micros(), available: true)

pub fn end_current_execution_resource_scope(lease: CurrentExecutionResourceScope, exit_code: i64) -> ResourceUsage:
    val ended = time_now_unix_micros()
    val wall_ms = if ended >= lease.started_micros: (ended - lease.started_micros) / 1000 else: 0
    if not lease.available:
        return _unavailable_usage(wall_ms, exit_code)
    val observed = read_cgroup_v2_observation(lease.scope_path)
    val moved_back = file_write(lease.parent_path + "/cgroup.procs", "{getpid()}")
    val removed = dir_remove(lease.scope_path, false)
    if not observed.available or not moved_back or not removed:
        return _unavailable_usage(wall_ms, exit_code)
    val evidence = TerminationEvidence(
        infrastructure_failed: false, wall_watchdog_fired: false,
        no_progress_watchdog_fired: false, cpu_limit_event: false,
        memory_high_event: observed.events.high > 0,
        memory_max_event: observed.events.max > 0 or observed.events.oom > 0 or observed.events.oom_kill > 0,
        process_limit_event: observed.events.pids_max > 0,
        output_limit_event: false, externally_terminated: false,
        signal: 0, exit_code: exit_code)
    ResourceUsage(
        wall_ms: wall_ms, user_cpu_ms: observed.user_cpu_micros / 1000,
        system_cpu_ms: observed.system_cpu_micros / 1000,
        peak_tree_charge_bytes: observed.memory_peak_bytes,
        peak_direct_child_rss_bytes: 0, heap_live_end_bytes: 0, heap_peak_bytes: 0,
        io_read_bytes: observed.io_read_bytes, io_write_bytes: observed.io_write_bytes, pids_peak: observed.pids_peak,
        evidence_quality: ResourceEvidenceQuality.ExactTree,
        termination: classify_termination(evidence), signal: 0, exit_code: exit_code)

fn _run_in_cgroup_v2(scope: ExecutionResourceScope, scope_path: text, cmd: text, args: [text]) -> ObservedProcessResult:
    var prefix = ""
    if scope.budget.max_cpu_ms > 0:
        prefix = prefix + "ulimit -t {(scope.budget.max_cpu_ms + 999) / 1000} || exit 125; "
    if scope.budget.max_fds > 0:
        prefix = prefix + "ulimit -n {scope.budget.max_fds} || exit 125; "
    var command = prefix + "printf '%s' $$ > " + _shell_quote(scope_path + "/cgroup.procs") + " || exit 125; exec " + _shell_quote(cmd)
    for arg in args:
        command = command + " " + _shell_quote(arg)
    val process = process_run_observed_bounded("/bin/sh", ["-c", command], scope.timeout_ms, scope.max_output_bytes)
    val cgroup = read_cgroup_v2_observation(scope_path)
    val usage = if cgroup.available and process.usage.exit_code != 125:
        val evidence = TerminationEvidence(
            infrastructure_failed: process.runtime_error != 0,
            wall_watchdog_fired: process.usage.termination == TerminationCause.WallTimeout,
            no_progress_watchdog_fired: false,
            cpu_limit_event: scope.budget.max_cpu_ms > 0 and process.usage.signal == 24,
            memory_high_event: cgroup.events.high > 0,
            memory_max_event: cgroup.events.max > 0 or cgroup.events.oom > 0 or cgroup.events.oom_kill > 0,
            process_limit_event: cgroup.events.pids_max > 0,
            output_limit_event: false,
            externally_terminated: false,
            signal: process.usage.signal,
            exit_code: process.usage.exit_code)
        ResourceUsage(
            wall_ms: process.usage.wall_ms,
            user_cpu_ms: cgroup.user_cpu_micros / 1000,
            system_cpu_ms: cgroup.system_cpu_micros / 1000,
            peak_tree_charge_bytes: cgroup.memory_peak_bytes,
            peak_direct_child_rss_bytes: process.usage.peak_direct_child_rss_bytes,
            heap_live_end_bytes: process.usage.heap_live_end_bytes,
            heap_peak_bytes: process.usage.heap_peak_bytes,
            io_read_bytes: cgroup.io_read_bytes,
            io_write_bytes: cgroup.io_write_bytes,
            pids_peak: if cgroup.pids_peak > 0: cgroup.pids_peak else: process.usage.pids_peak,
            evidence_quality: ResourceEvidenceQuality.ExactTree,
            termination: classify_termination(evidence),
            signal: process.usage.signal,
            exit_code: process.usage.exit_code)
    else:
        process.usage
    ObservedProcessResult(stdout: process.stdout, stderr: process.stderr, usage: usage, stdout_truncated: process.stdout_truncated, stderr_truncated: process.stderr_truncated, runtime_error: if process.usage.exit_code == 125: 125 else: process.runtime_error)

# `ulimit -u` (RLIMIT_NPROC) is not POSIX: dash -- /bin/sh on Debian/Ubuntu -- rejects
# it with "Illegal option -u", so a pid cap must run under a shell that implements it.
# Returns "" when the scope needs a pid cap and no such shell exists: the caller then
# FAILS CLOSED (exit 125 receipt) instead of silently running unlimited.
fn _limit_shell(scope: ExecutionResourceScope) -> text:
    if scope.budget.max_pids <= 0:
        return "/bin/sh"
    for shell in ["/bin/bash", "/usr/bin/bash", "/usr/local/bin/bash", "/bin/ksh", "/usr/bin/ksh", "/bin/zsh", "/usr/bin/zsh"]:
        if file_exists(shell):
            return shell
    ""

# `ulimit -v` maps to RLIMIT_AS, which Darwin's kernel does not implement: EVERY
# shell on macOS answers `ulimit: virtual memory: cannot modify limit: Invalid
# argument` (verified 2026-09-05 on /bin/sh and /bin/bash alike), so pairing it
# with `|| exit 125` killed every bounded child with an infrastructure failure.
# That is what made `simple test <dir>` report 79/79 "Compilation failed" here.
# There is no substitute shell -- unlike `ulimit -u`, no shell can enforce this
# on Darwin -- so the address-space cap is dropped with a LOUD stderr note
# rather than silently. The `-t`/`-u`/`-n` caps below are unaffected and keep
# their fail-closed `|| exit 125`.
# Detected by a single stat rather than `uname -s`: this runs once per bounded
# child spawn, and shelling out for platform detection inside the spawn path
# would cost more than the check it guards.
fn _rlimit_as_enforceable() -> bool:
    not file_exists("/System/Library/CoreServices/SystemVersion.plist")

fn _run_with_unix_limits(scope: ExecutionResourceScope, cmd: text, args: [text]) -> ObservedProcessResult:
    val shell = _limit_shell(scope)
    if shell == "":
        return ObservedProcessResult(
            stdout: "",
            stderr: "resource scope: max_pids={scope.budget.max_pids} requires a shell with `ulimit -u` (bash/ksh/zsh); none found, refusing to run unlimited",
            usage: _unavailable_usage(0, 125), stdout_truncated: false, stderr_truncated: false, runtime_error: 125)
    var prefix = ""
    val memory_bytes = if scope.budget.max_tree_charge_bytes > 0: scope.budget.max_tree_charge_bytes else: scope.budget.max_direct_child_rss_bytes
    if memory_bytes > 0:
        if _rlimit_as_enforceable():
            prefix = prefix + "ulimit -v {memory_bytes / 1024} || exit 125; "
        else:
            eprint("[resource-scope] address-space cap of {memory_bytes} bytes NOT enforced: RLIMIT_AS (`ulimit -v`) is unimplemented on this platform; cpu/pid/fd caps still apply")
    if scope.budget.max_cpu_ms > 0:
        prefix = prefix + "ulimit -t {(scope.budget.max_cpu_ms + 999) / 1000} || exit 125; "
    if scope.budget.max_pids > 0:
        prefix = prefix + "ulimit -u {scope.budget.max_pids} || exit 125; "
    if scope.budget.max_fds > 0:
        prefix = prefix + "ulimit -n {scope.budget.max_fds} || exit 125; "
    var command = prefix + "exec " + _shell_quote(cmd)
    for arg in args:
        command = command + " " + _shell_quote(arg)
    val process = process_run_observed_bounded(shell, ["-c", command], scope.timeout_ms, scope.max_output_bytes)
    val termination = if process.usage.exit_code == 125:
        TerminationCause.InfrastructureFailure
    elif scope.budget.max_cpu_ms > 0 and process.usage.signal == 24:
        TerminationCause.CpuLimit
    else:
        process.usage.termination
    val usage = ResourceUsage(
        wall_ms: process.usage.wall_ms, user_cpu_ms: process.usage.user_cpu_ms,
        system_cpu_ms: process.usage.system_cpu_ms,
        peak_tree_charge_bytes: process.usage.peak_tree_charge_bytes,
        peak_direct_child_rss_bytes: process.usage.peak_direct_child_rss_bytes,
        heap_live_end_bytes: process.usage.heap_live_end_bytes,
        heap_peak_bytes: process.usage.heap_peak_bytes,
        io_read_bytes: process.usage.io_read_bytes, io_write_bytes: process.usage.io_write_bytes,
        pids_peak: process.usage.pids_peak, evidence_quality: process.usage.evidence_quality,
        termination: termination, signal: process.usage.signal, exit_code: process.usage.exit_code)
    ObservedProcessResult(stdout: process.stdout, stderr: process.stderr, usage: usage, stdout_truncated: process.stdout_truncated, stderr_truncated: process.stderr_truncated, runtime_error: if process.usage.exit_code == 125: 125 else: process.runtime_error)

struct CgroupV2Events:
    low: i64
    high: i64
    max: i64
    oom: i64
    oom_kill: i64
    pids_max: i64

struct CgroupV2Observation:
    available: bool
    memory_current_bytes: i64
    memory_peak_bytes: i64
    user_cpu_micros: i64
    system_cpu_micros: i64
    pids_current: i64
    pids_peak: i64
    io_read_bytes: i64
    io_write_bytes: i64
    events: CgroupV2Events
    unavailable_reason: text

fn _counter_value(content: text, key: text) -> i64:
    for line in content.split("\n"):
        val fields = line.trim().split(" ")
        if fields.len() >= 2 and fields[0] == key:
            return fields[1].to_int()
    0

fn _sum_assignment(content: text, key: text) -> i64:
    var total = 0
    val prefix = key + "="
    for line in content.split("\n"):
        for field in line.trim().split(" "):
            if field.starts_with(prefix):
                total = total + field[prefix.len():].to_int()
    total

fn _property_value(content: text, key: text) -> text:
    val prefix = key + "="
    for line in content.split("\n"):
        if line.starts_with(prefix):
            return line[prefix.len():].trim()
    ""

fn _line_value(content: text, prefix: text) -> text:
    for line in content.split("\n"):
        if line.starts_with(prefix):
            return line[prefix.len():].trim()
    ""

fn _without_line_prefix(content: text, prefix: text) -> text:
    var kept: [text] = []
    for line in content.split("\n"):
        if not line.starts_with(prefix):
            kept.push(line)
    kept.join("\n")

pub fn run_in_systemd_resource_scope(scope: ExecutionResourceScope, cmd: text, args: [text], cancel_after_ms: i64 = 0) -> ExecutionScopeResult:
    """Linux delegated-service provider used when direct cgroup delegation is unavailable."""
    val started = time_now_unix_micros()
    val unit = "simple-resource-{getpid()}-{started}"
    var run_args: [text] = [
        "--user", "--wait", "--pipe", "--quiet", "--unit=" + unit,
        "--property=MemoryAccounting=yes", "--property=CPUAccounting=yes",
        "--property=TasksAccounting=yes"]
    if scope.budget.max_tree_charge_bytes > 0:
        run_args.push("--property=MemoryMax={scope.budget.max_tree_charge_bytes}")
    if scope.budget.max_pids > 0:
        run_args.push("--property=TasksMax={scope.budget.max_pids}")
    if scope.timeout_ms > 0:
        run_args.push("--property=RuntimeMaxSec={(scope.timeout_ms + 999) / 1000}")
    val pids_marker = "__SIMPLE_SCOPE_{unit}_PIDS_MAX__="
    val external_marker = "__SIMPLE_SCOPE_{unit}_EXTERNAL_SIGNAL__="
    var child_command = _shell_quote(cmd)
    for arg in args:
        child_command = child_command + " " + _shell_quote(arg)
    # Keep a supervisor shell alive long enough to retain the cgroup's
    # pids.events delta. This is affirmative kernel evidence; `Cannot fork`
    # text and systemd's generic `resources` result are never classification.
    val invocation = if cancel_after_ms > 0:
        child_command + " & child=$!; sleep {(cancel_after_ms + 999) / 1000}; if kill -TERM \"$child\" 2>/dev/null; then printf '\\n" + external_marker + "15\\n' >&2; fi; wait \"$child\"; rc=$?"
    else:
        child_command + "; rc=$?"
    val wrapped = "cg=$(awk -F: '$1 == \"0\" { print $3 }' /proc/self/cgroup); pe=/sys/fs/cgroup$cg/pids.events; before=$(awk '$1 == \"max\" { print $2 }' $pe 2>/dev/null); " + invocation + "; after=$(awk '$1 == \"max\" { print $2 }' $pe 2>/dev/null); printf '\\n" + pids_marker + "%s:%s\\n' \"$before\" \"$after\" >&2; exit $rc"
    run_args.push("--")
    run_args.push("/bin/sh")
    run_args.push("-c")
    run_args.push(wrapped)
    val executed = process_run_observed_bounded("/usr/bin/systemd-run", run_args, scope.timeout_ms + 5_000, scope.max_output_bytes)
    val shown = process_run_observed_bounded("/usr/bin/systemctl", ["--user", "show", unit + ".service", "--property=Result", "--property=ExecMainCode", "--property=ExecMainStatus", "--property=MemoryPeak", "--property=CPUUsageNSec", "--no-pager"], 5_000, 16_384)
    val result_name = _property_value(shown.stdout, "Result")
    val main_code = _property_value(shown.stdout, "ExecMainCode").to_int()
    # Non-zero fallback: `.to_int()` fails open to 0, which would mask a real
    # exit code here, so parse explicitly and keep the caller's default.
    val main_status = try_parse_int(_property_value(shown.stdout, "ExecMainStatus")) ?? executed.usage.exit_code
    val memory_peak_text = _property_value(shown.stdout, "MemoryPeak")
    val memory_peak = memory_peak_text.to_int()
    val cpu_ns = _property_value(shown.stdout, "CPUUsageNSec").to_int()
    val pids_pair = _line_value(executed.stderr, pids_marker).split(":")
    val pids_limit_event = pids_pair.len() == 2 and pids_pair[1].to_int() > pids_pair[0].to_int()
    val external_signal = _line_value(executed.stderr, external_marker).to_int()
    val _cleanup = process_run_observed_bounded("/usr/bin/systemctl", ["--user", "reset-failed", unit + ".service"], 5_000, 4_096)
    val ended = time_now_unix_micros()
    val evidence = TerminationEvidence(
        infrastructure_failed: result_name == "" or shown.usage.exit_code != 0,
        wall_watchdog_fired: result_name == "timeout" or result_name == "watchdog",
        no_progress_watchdog_fired: false,
        # systemd's generic `resources` result does not identify which limit
        # fired. Preserve it as an unverified exit instead of guessing CPU/PID.
        cpu_limit_event: false,
        memory_high_event: false,
        memory_max_event: result_name == "oom-kill",
        process_limit_event: pids_limit_event,
        output_limit_event: false, externally_terminated: external_signal > 0,
        signal: if external_signal > 0: external_signal elif main_code == 2: main_status else: 0,
        exit_code: main_status)
    val usage = ResourceUsage(
        wall_ms: if ended >= started: (ended - started) / 1000 else: 0,
        user_cpu_ms: cpu_ns / 1_000_000, system_cpu_ms: 0,
        peak_tree_charge_bytes: memory_peak, peak_direct_child_rss_bytes: 0,
        heap_live_end_bytes: 0, heap_peak_bytes: 0,
        io_read_bytes: 0, io_write_bytes: 0, pids_peak: 0,
        evidence_quality: if result_name == "" or memory_peak_text == "" or memory_peak_text.starts_with("["): ResourceEvidenceQuality.Unavailable else: ResourceEvidenceQuality.ExactTree,
        termination: classify_termination(evidence), signal: evidence.signal,
        exit_code: main_status)
    val process = ObservedProcessResult(
        stdout: executed.stdout, stderr: _without_line_prefix(_without_line_prefix(executed.stderr, pids_marker), external_marker), usage: usage,
        stdout_truncated: executed.stdout_truncated,
        stderr_truncated: executed.stderr_truncated,
        runtime_error: if result_name == "": 1 else: 0)
    ExecutionScopeResult(process: process, budget_decision: evaluate_resource_budget(usage, scope.budget))

fn parse_cgroup_v2_events(memory_events: text, pids_events: text) -> CgroupV2Events:
    CgroupV2Events(
        low: _counter_value(memory_events, "low"),
        high: _counter_value(memory_events, "high"),
        max: _counter_value(memory_events, "max"),
        oom: _counter_value(memory_events, "oom"),
        oom_kill: _counter_value(memory_events, "oom_kill"),
        pids_max: _counter_value(pids_events, "max")
    )

fn cgroup_memory_high_event(before: CgroupV2Events, after: CgroupV2Events) -> bool:
    after.high > before.high

fn cgroup_memory_max_event(before: CgroupV2Events, after: CgroupV2Events) -> bool:
    after.max > before.max or after.oom > before.oom or after.oom_kill > before.oom_kill

fn cgroup_process_limit_event(before: CgroupV2Events, after: CgroupV2Events) -> bool:
    after.pids_max > before.pids_max

fn _read_i64(path: text) -> i64:
    file_read_text(path).trim().to_int()

fn read_cgroup_v2_observation(scope_path: text) -> CgroupV2Observation:
    val memory_current_path = scope_path + "/memory.current"
    val memory_peak_path = scope_path + "/memory.peak"
    val memory_events_path = scope_path + "/memory.events"
    val cpu_stat_path = scope_path + "/cpu.stat"
    val pids_current_path = scope_path + "/pids.current"
    val pids_peak_path = scope_path + "/pids.peak"
    val pids_events_path = scope_path + "/pids.events"
    val io_stat_path = scope_path + "/io.stat"

    if not file_exists(memory_current_path) or not file_exists(memory_events_path) or not file_exists(cpu_stat_path):
        return CgroupV2Observation(
            available: false,
            memory_current_bytes: 0,
            memory_peak_bytes: 0,
            user_cpu_micros: 0,
            system_cpu_micros: 0,
            pids_current: 0,
            pids_peak: 0,
            io_read_bytes: 0,
            io_write_bytes: 0,
            events: parse_cgroup_v2_events("", ""),
            unavailable_reason: "required cgroup v2 metric files are unavailable"
        )

    val cpu_stat = file_read_text(cpu_stat_path)
    val pids_events = if file_exists(pids_events_path): file_read_text(pids_events_path) else: ""
    val io_stat = if file_exists(io_stat_path): file_read_text(io_stat_path) else: ""
    CgroupV2Observation(
        available: true,
        memory_current_bytes: _read_i64(memory_current_path),
        memory_peak_bytes: if file_exists(memory_peak_path): _read_i64(memory_peak_path) else: 0,
        user_cpu_micros: _counter_value(cpu_stat, "user_usec"),
        system_cpu_micros: _counter_value(cpu_stat, "system_usec"),
        pids_current: if file_exists(pids_current_path): _read_i64(pids_current_path) else: 0,
        pids_peak: if file_exists(pids_peak_path): _read_i64(pids_peak_path) else: 0,
        io_read_bytes: _sum_assignment(io_stat, "rbytes"),
        io_write_bytes: _sum_assignment(io_stat, "wbytes"),
        events: parse_cgroup_v2_events(file_read_text(memory_events_path), pids_events),
        unavailable_reason: ""
    )

fn _unavailable_usage(wall_ms: i64, exit_code: i64) -> ResourceUsage:
    ResourceUsage(
        wall_ms: wall_ms,
        user_cpu_ms: 0,
        system_cpu_ms: 0,
        peak_tree_charge_bytes: 0,
        peak_direct_child_rss_bytes: 0,
        heap_live_end_bytes: 0,
        heap_peak_bytes: 0,
        io_read_bytes: 0,
        io_write_bytes: 0,
        pids_peak: 0,
        evidence_quality: ResourceEvidenceQuality.Unavailable,
        termination: TerminationCause.InfrastructureFailure,
        signal: 0,
        exit_code: exit_code
    )

fn process_run_observed_bounded(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> ObservedProcessResult:
    val started = time_now_unix_micros()
    proc_slot_acquire()
    val (stdout, stderr, fields) = _process_run_observed_raw(cmd, args, timeout_ms, max_output_bytes)
    proc_slot_release()
    val ended = time_now_unix_micros()
    val wall_ms = if ended >= started: (ended - started) / 1000 else: 0
    if fields.len() != 30 or fields[0] != 1 or fields[19] != 2:
        return ObservedProcessResult(
            stdout: stdout,
            stderr: stderr,
            usage: _unavailable_usage(wall_ms, -1),
            stdout_truncated: false,
            stderr_truncated: false,
            runtime_error: -1
        )

    val exit_code = fields[10]
    val timed_out = fields[11] != 0
    val lifecycle_error = fields[18]
    val termination_signal = fields[28]
    val observation_error = fields[29]
    val evidence_flags = fields[20]
    # Windows and non-pidfd Unix runtimes may not yet implement the additive
    # observed ABI. Preserve execution through the established bounded facade
    # while reporting resource evidence as unavailable.
    if lifecycle_error == 95 or lifecycle_error == 45 or lifecycle_error == 10045:
        val legacy_started = time_now_unix_micros()
        val (legacy_stdout, legacy_stderr, legacy_exit) = process_run_bounded(cmd, args, timeout_ms, max_output_bytes)
        val legacy_ended = time_now_unix_micros()
        val legacy_wall_ms = if legacy_ended >= legacy_started: (legacy_ended - legacy_started) / 1000 else: 0
        val legacy_timed_out = process_bounded_timed_out(legacy_exit, legacy_stderr)
        val legacy_signal = process_bounded_kill_signal(legacy_exit)
        val legacy_usage = ResourceUsage(
            wall_ms: legacy_wall_ms, user_cpu_ms: 0, system_cpu_ms: 0,
            peak_tree_charge_bytes: 0, peak_direct_child_rss_bytes: 0,
            heap_live_end_bytes: 0, heap_peak_bytes: 0,
            io_read_bytes: 0, io_write_bytes: 0, pids_peak: 0,
            evidence_quality: ResourceEvidenceQuality.Unavailable,
            termination: if legacy_timed_out: TerminationCause.WallTimeout elif legacy_signal > 0: TerminationCause.Signal elif legacy_exit == -1: TerminationCause.InfrastructureFailure else: TerminationCause.Exited,
            signal: legacy_signal, exit_code: legacy_exit)
        return ObservedProcessResult(
            stdout: legacy_stdout, stderr: legacy_stderr, usage: legacy_usage,
            stdout_truncated: false, stderr_truncated: false,
            runtime_error: if legacy_exit == -1 and not legacy_timed_out: lifecycle_error else: 0)
    val has_tree = (evidence_flags & 2) != 0
    val has_sampled_tree = (evidence_flags & 8) != 0
    val has_direct = (evidence_flags & 1) != 0
    val quality = if has_tree:
        ResourceEvidenceQuality.ExactTree
    elif has_sampled_tree:
        ResourceEvidenceQuality.SampledTree
    elif has_direct:
        ResourceEvidenceQuality.ExactDirectChild
    else:
        ResourceEvidenceQuality.Unavailable
    val termination = if timed_out:
        TerminationCause.WallTimeout
    elif lifecycle_error != 0:
        TerminationCause.InfrastructureFailure
    elif termination_signal > 0:
        TerminationCause.Signal
    else:
        TerminationCause.Exited

    ObservedProcessResult(
        stdout: stdout,
        stderr: stderr,
        usage: ResourceUsage(
            wall_ms: wall_ms,
            user_cpu_ms: fields[21],
            system_cpu_ms: fields[22],
            peak_tree_charge_bytes: fields[24],
            peak_direct_child_rss_bytes: fields[23],
            heap_live_end_bytes: 0,
            heap_peak_bytes: 0,
            io_read_bytes: fields[25],
            io_write_bytes: fields[26],
            pids_peak: fields[27],
            evidence_quality: quality,
            termination: termination,
            signal: termination_signal,
            exit_code: exit_code
        ),
        stdout_truncated: fields[16] != 0,
        stderr_truncated: fields[17] != 0,
        runtime_error: if lifecycle_error != 0: lifecycle_error else: observation_error
    )

pub fn run_in_execution_resource_scope(scope: ExecutionResourceScope, cmd: text, args: [text]) -> ExecutionScopeResult:
    """Run one owned process tree and evaluate its declared budget independently."""
    val cgroup_path = _prepare_cgroup_v2(scope)
    val process = if cgroup_path == "":
        if file_exists("/bin/sh"):
            _run_with_unix_limits(scope, cmd, args)
        else:
            process_run_observed_bounded(cmd, args, scope.timeout_ms, scope.max_output_bytes)
    else:
        val observed = _run_in_cgroup_v2(scope, cgroup_path, cmd, args)
        val _ = dir_remove(cgroup_path, false)
        observed
    ExecutionScopeResult(process: process, budget_decision: evaluate_resource_budget(process.usage, scope.budget))

export CgroupV2Events, CgroupV2Observation, ObservedProcessResult
export ExecutionResourceClass, ExecutionResourceScope, ExecutionScopeResult
export CurrentExecutionResourceScope, begin_current_execution_resource_scope, end_current_execution_resource_scope
export standard_resource_budget, execution_resource_scope, execution_resource_scope_with_budget, run_in_execution_resource_scope
export run_in_systemd_resource_scope
export parse_cgroup_v2_events, cgroup_memory_high_event, cgroup_memory_max_event, cgroup_process_limit_event
export read_cgroup_v2_observation
export process_run_observed_bounded
