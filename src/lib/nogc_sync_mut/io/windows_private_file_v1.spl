# Copyable values carry generation tokens only. Native IO owns the authoritative
# phase, size, cursor, quota, root binding and cleanup state behind one lock.
use std.nogc_sync_mut.io.windows_private_file_abi.*
use std.nogc_sync_mut.io.volatile_ops.{volatile_write_u16, volatile_write_u8, volatile_read_u8}
use std.common.text_bytes.{boxed_text_bytes_checked, bytes_to_text, text_to_utf8_bytes, utf8_bytes_valid}
use std.common.crypto.secure_memory.secure_zero_u8_slots

pub struct WindowsPrivateErrorV1:
    message: text
    cleanup_root: Option<WindowsPrivateRootV1>
    cleanup_file: Option<WindowsPrivateFileV1>

fn _private_error(message: text) -> WindowsPrivateErrorV1:
    WindowsPrivateErrorV1(message: message, cleanup_root: None, cleanup_file: None)

@unsafe(reason: "encodes bounded UTF16 in private malloc temporary", capabilities: [ffi, raw_ptr])
fn _private_path(path: text) -> i64:
    if path.byte_len() == 0 or path.byte_len() > 32760: return 0
    val ptr = rt_windows_private_alloc_v1((path.byte_len() + 1) * 2)
    if ptr == 0: return 0
    var consumed = 0
    var ordinal = 0
    var offset = 0
    while consumed < path.byte_len():
        val scalar = path.char_code_at(ordinal)
        if scalar <= 0 or scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
            rt_windows_private_free_v1(ptr)
            return 0
        if scalar < 65536:
            volatile_write_u16(ptr + offset * 2, scalar)
            offset = offset + 1
        else:
            val value = scalar - 65536
            volatile_write_u16(ptr + offset * 2, 55296 + (value >> 10))
            volatile_write_u16(ptr + (offset + 1) * 2, 56320 + (value & 1023))
            offset = offset + 2
        ordinal = ordinal + 1
        if scalar < 128: consumed = consumed + 1
        elif scalar < 2048: consumed = consumed + 2
        elif scalar < 65536: consumed = consumed + 3
        else: consumed = consumed + 4
    ptr

fn _private_root_admit(token: i64) -> Result<WindowsPrivateRootV1, WindowsPrivateErrorV1>:
    if token == -1: return Err(_private_error("WINDOWS_PRIVATE_ROOT_OPEN"))
    val owner = WindowsPrivateRootV1(token: token)
    if rt_windows_private_root_ready_v1(token) == 1: return Ok(owner)
    Err(WindowsPrivateErrorV1(message: "WINDOWS_PRIVATE_ROOT_CLEANUP_REQUIRED", cleanup_root: Some(owner), cleanup_file: None))

pub class WindowsPrivateRootV1:
    token: i64

    # The only public journal factory. Its fixed native child is "journal";
    # no caller-supplied path or claimed POSIX proof can mint store authority.
    pub fn open_journal_store_v1() -> WindowsJournalStoreOpenV1:
        val journal_token = rt_windows_journal_open_v1(self.token)
        if journal_token <= 0:
            return WindowsJournalStoreOpenV1.Rejected("WINDOWS_JOURNAL_OPEN")
        val store = WindowsJournalStoreV1(token: journal_token, origin_root: self.token)
        if store.live(): return WindowsJournalStoreOpenV1.Ready(store)
        WindowsJournalStoreOpenV1.CleanupRequired(store, "WINDOWS_JOURNAL_OPEN_CLEANUP_REQUIRED")

    # Revalidate native root and retained ancestor privacy, never cached state.
    pub fn security_current() -> bool:
        rt_windows_private_root_ready_v1(self.token) == 1

    pub fn child_directory(name: text, create: bool) -> Result<WindowsPrivateRootV1, WindowsPrivateErrorV1>:
        val path = _private_path(name)
        if path == 0: return Err(_private_error("WINDOWS_PRIVATE_NAME"))
        val creating = if create: 1 else: 0
        val token = rt_windows_private_directory_v1(self.token, path, creating)
        rt_windows_private_free_v1(path)
        _private_root_admit(token)

    pub fn create_private_stage(name: text, maximum: u64) -> Result<WindowsPrivateFileV1, WindowsPrivateErrorV1>:
        self.open_child(name, maximum, true)

    pub fn open_private_file(name: text, maximum: u64) -> Result<WindowsPrivateFileV1, WindowsPrivateErrorV1>:
        self.open_child(name, maximum, false)

    fn open_child(name: text, maximum: u64, create: bool) -> Result<WindowsPrivateFileV1, WindowsPrivateErrorV1>:
        if maximum > 8388608u64: return Err(_private_error("WINDOWS_PRIVATE_FILE_QUOTA"))
        val path = _private_path(name)
        if path == 0: return Err(_private_error("WINDOWS_PRIVATE_NAME"))
        val creating = if create: 1 else: 0
        val token = rt_windows_private_file_v1(self.token, path, creating, maximum as i64)
        rt_windows_private_free_v1(path)
        if token == -1: return Err(_private_error("WINDOWS_PRIVATE_FILE_OPEN"))
        val owner = WindowsPrivateFileV1(token: token)
        if not owner.security_current():
            return Err(WindowsPrivateErrorV1(message: "WINDOWS_PRIVATE_FILE_CLEANUP_REQUIRED", cleanup_root: None, cleanup_file: Some(owner)))
        Ok(owner)

    pub fn publish_no_replace(stage: WindowsPrivateFileV1, final_name: text) -> Result<bool, text>:
        val path = _private_path(final_name)
        if path == 0: return Err("WINDOWS_PRIVATE_NAME")
        val status = rt_windows_private_publish_v1(self.token, stage.token, path)
        rt_windows_private_free_v1(path)
        if status == 1: return Ok(false)
        if status != 0: return Err("WINDOWS_PRIVATE_PUBLISH")
        Ok(true)

    pub me close() -> bool:
        rt_windows_private_root_close_v1(self.token) == 1

pub class WindowsPrivateFileV1:
    token: i64

    pub fn security_current() -> bool:
        rt_windows_private_check_v1(self.token, 8388608) == 1

    @unsafe(reason: "writes bounded buffer through authoritative native file phase", capabilities: [ffi, raw_ptr])
    pub me write(bytes: [u8]) -> Result<bool, text>:
        if bytes.len() > 1048576: return Err("WINDOWS_PRIVATE_FILE_WRITE_QUOTA")
        val buffer = rt_windows_private_alloc_v1(bytes.len() + 1)
        if buffer == 0: return Err("WINDOWS_PRIVATE_FILE_MEMORY")
        for index in 0..bytes.len(): volatile_write_u8(buffer + index, bytes[index] as i64)
        var offset = 0
        while offset < bytes.len():
            val count = rt_windows_private_file_write_v1(self.token, buffer + offset, bytes.len() - offset)
            if count <= 0 or count > bytes.len() - offset:
                rt_windows_private_free_v1(buffer)
                return Err("WINDOWS_PRIVATE_FILE_WRITE")
            offset = offset + count
        if bytes.len() == 0 and rt_windows_private_file_write_v1(self.token, buffer, 0) != 0:
            rt_windows_private_free_v1(buffer)
            return Err("WINDOWS_PRIVATE_FILE_WRITE")
        rt_windows_private_free_v1(buffer)
        Ok(true)

    pub me seal() -> Result<bool, text>:
        if rt_windows_private_file_seal_v1(self.token) != 1: return Err("WINDOWS_PRIVATE_FILE_SEAL")
        Ok(true)

    @unsafe(reason: "reads bounded chunks through native generation and identity lock", capabilities: [ffi, raw_ptr])
    pub me read_all_bounded(maximum: i64) -> Result<[u8], text>:
        if maximum < 0 or maximum > 8388608: return Err("WINDOWS_PRIVATE_FILE_READ_QUOTA")
        val size = rt_windows_private_file_size_v1(self.token)
        if size < 0 or size > maximum: return Err("WINDOWS_PRIVATE_FILE_READ_STATE")
        val buffer = rt_windows_private_alloc_v1(1048576)
        if buffer == 0: return Err("WINDOWS_PRIVATE_FILE_MEMORY")
        var bytes: [u8] = []
        var offset = 0
        while offset < size:
            val remaining = size - offset
            val wanted = if remaining > 1048576: 1048576 else: remaining
            val count = rt_windows_private_file_read_v1(self.token, offset, buffer, wanted)
            if count != wanted:
                rt_windows_private_free_v1(buffer)
                return Err("WINDOWS_PRIVATE_FILE_READ")
            for index in 0..count: bytes.push(volatile_read_u8(buffer + index) as u8)
            offset = offset + count
        rt_windows_private_free_v1(buffer)
        if rt_windows_private_file_size_v1(self.token) != size: return Err("WINDOWS_PRIVATE_FILE_CHANGED")
        Ok(bytes)

    pub me close() -> bool:
        rt_windows_private_file_close_v1(self.token) == 1

pub fn windows_private_root_open_v1(path: text) -> Result<WindowsPrivateRootV1, WindowsPrivateErrorV1>:
    @when(os="windows"):
    val native = _private_path(path.replace("/", "\\"))
    if native == 0: return Err(_private_error("WINDOWS_PRIVATE_ROOT_PATH"))
    val token = rt_windows_private_root_open_v1(native)
    rt_windows_private_free_v1(native)
    _private_root_admit(token)
    @else:
    Err(_private_error("WINDOWS_PRIVATE_HOST_UNSUPPORTED"))
    @end

export WindowsPrivateRootV1, WindowsPrivateFileV1, WindowsPrivateErrorV1, windows_private_root_open_v1

# Defined in the same module as the root factory to keep native token
# admission private. The journal facade re-exports only these opaque types.
pub enum WindowsJournalStoreOpenV1:
    Ready(store: WindowsJournalStoreV1)
    Rejected(message: text)
    CleanupRequired(store: WindowsJournalStoreV1, message: text)

@unsafe(reason: "copies checked UTF8 into bounded infallibly freed native temporary", capabilities: [ffi, raw_ptr])
fn _journal_payload(payload: text) -> Result<i64, text>:
    if payload.byte_len() > 8388608: return Err("WINDOWS_JOURNAL_PAYLOAD_QUOTA")
    val bytes: [u8] = match boxed_text_bytes_checked(payload):
        case Ok(value): value
        case Err(_): return Err("WINDOWS_JOURNAL_PAYLOAD_ENCODING")
    if bytes.len() != payload.byte_len() or bytes.len() > 8388608 or not utf8_bytes_valid(bytes):
        return Err("WINDOWS_JOURNAL_PAYLOAD_ENCODING")
    val buffer = _journal_buffer(bytes.len() + 1)
    if buffer == 0: return Err("WINDOWS_JOURNAL_MEMORY")
    for index in 0..bytes.len(): volatile_write_u8(buffer + index, bytes[index] as i64)
    Ok(buffer)

fn _journal_buffer(size: i64) -> i64:
    if size <= 0 or size > 8388609: return 0
    rt_alloc(size)

# milestone_0058: the bytes methods zero a payload buffer before rt_free, so a private file's native copy is never
# handed back to the allocator as is.
@unsafe(reason: "zeroes a bounded native temporary before freeing it", capabilities: [ffi, raw_ptr])
fn _journal_free_wiped(buffer: i64, size: i64):
    for index in 0..size: volatile_write_u8(buffer + index, 0)
    rt_free(buffer)

pub class WindowsJournalStoreV1:
    token: i64
    origin_root: i64

    # Exact opaque factory provenance, not path equality. Both retained native
    # generations must still be live when the deployment verifies this store.
    pub fn belongs_to(root: WindowsPrivateRootV1) -> bool:
        self.origin_root == root.token and self.live() and root.security_current()

    # Identity only: callers must check live separately before using authority.
    pub fn same_owner(other: WindowsJournalStoreV1) -> bool:
        self.token == other.token

    pub fn live() -> bool:
        rt_windows_journal_live_v1(self.token) == 1

    @unsafe(reason: "reads exact UTF8 bytes from bounded native journal operation", capabilities: [ffi, raw_ptr])
    pub fn read(relative: text, maximum: i64) -> Result<Option<text>, text>:
        if maximum < 0 or maximum > 8388608: return Err("WINDOWS_JOURNAL_READ_QUOTA")
        if relative.byte_len() == 0 or relative.byte_len() > 512:
            return Err("WINDOWS_JOURNAL_NAME")
        val name = _private_path(relative)
        if name == 0: return Err("WINDOWS_JOURNAL_NAME")
        val buffer = _journal_buffer(maximum + 1)
        if buffer == 0:
            rt_windows_private_free_v1(name)
            return Err("WINDOWS_JOURNAL_MEMORY")
        val count = rt_windows_journal_read_v1(self.token, name, buffer, maximum)
        rt_windows_private_free_v1(name)
        if count == -2:
            rt_free(buffer)
            return Ok(None)
        if count < 0 or count > maximum:
            rt_free(buffer)
            return Err("WINDOWS_JOURNAL_READ")
        var bytes: [u8] = []
        for index in 0..count: bytes.push(volatile_read_u8(buffer + index) as u8)
        rt_free(buffer)
        if not utf8_bytes_valid(bytes): return Err("WINDOWS_JOURNAL_UTF8")
        val decoded = bytes_to_text(bytes)
        val roundtrip = text_to_utf8_bytes(decoded)
        if roundtrip.len() != bytes.len(): return Err("WINDOWS_JOURNAL_UTF8_ROUNDTRIP")
        for index in 0..bytes.len():
            if roundtrip[index] != bytes[index]: return Err("WINDOWS_JOURNAL_UTF8_ROUNDTRIP")
        Ok(Some(decoded))

    # milestone_0058: private files (the identity store's keys) never become `text` here. Same quota, name, absence
    # and UTF8 contract as read. The copy is pre-sized at the native count (no push, so no reallocation drops a
    # prefix) and is the caller's to wipe; the native buffer is zeroed before rt_free on every exit after it exists,
    # and a refused copy is wiped before the refusal.
    # @allow(primitive_api): byte bound mirrors read(); the native journal ABI takes an i64 maximum
    @unsafe(reason: "reads exact UTF8 bytes from bounded native journal operation into a wipeable copy", capabilities: [ffi, raw_ptr])
    pub fn read_bytes(relative: text, maximum: i64) -> Result<Option<[u8]>, text>:
        if maximum < 0 or maximum > 8388608: return Err("WINDOWS_JOURNAL_READ_QUOTA")
        if relative.byte_len() == 0 or relative.byte_len() > 512:
            return Err("WINDOWS_JOURNAL_NAME")
        val name = _private_path(relative)
        if name == 0: return Err("WINDOWS_JOURNAL_NAME")
        val buffer = _journal_buffer(maximum + 1)
        if buffer == 0:
            rt_windows_private_free_v1(name)
            return Err("WINDOWS_JOURNAL_MEMORY")
        val count = rt_windows_journal_read_v1(self.token, name, buffer, maximum)
        rt_windows_private_free_v1(name)
        if count == -2:
            _journal_free_wiped(buffer, maximum + 1)
            return Ok(None)
        if count < 0 or count > maximum:
            _journal_free_wiped(buffer, maximum + 1)
            return Err("WINDOWS_JOURNAL_READ")
        var bytes: [u8] = [0u8; count]
        for index in 0..count: bytes[index] = volatile_read_u8(buffer + index) as u8
        # The native read wrote at most `count` bytes; the rest of the bound never held file content.
        _journal_free_wiped(buffer, count + 1)
        if not utf8_bytes_valid(bytes):
            val _refused_wipe = secure_zero_u8_slots(bytes)
            return Err("WINDOWS_JOURNAL_UTF8")
        Ok(Some(bytes))

    pub fn publish(relative: text, payload: text) -> Result<bool, text>:
        self.write_record(relative, payload, 0, None)

    # milestone_0058: publish (no replace) from bytes the caller owns and wipes; no `text` copy of the payload. The
    # journal still revalidates UTF8 itself, and its native copy is zeroed before rt_free.
    @unsafe(reason: "copies checked UTF8 bytes into bounded native temporary zeroed before free", capabilities: [ffi, raw_ptr])
    pub fn publish_bytes(relative: text, payload: [u8]) -> Result<bool, text>:
        if relative.byte_len() == 0 or relative.byte_len() > 512:
            return Err("WINDOWS_JOURNAL_NAME")
        if payload.len() > 8388608: return Err("WINDOWS_JOURNAL_PAYLOAD_QUOTA")
        if not utf8_bytes_valid(payload): return Err("WINDOWS_JOURNAL_PAYLOAD_ENCODING")
        val name = _private_path(relative)
        if name == 0: return Err("WINDOWS_JOURNAL_NAME")
        val buffer = _journal_buffer(payload.len() + 1)
        if buffer == 0:
            rt_windows_private_free_v1(name)
            return Err("WINDOWS_JOURNAL_MEMORY")
        for index in 0..payload.len(): volatile_write_u8(buffer + index, payload[index] as i64)
        val status = rt_windows_journal_publish_v1(self.token, name, buffer, payload.len(), 0)
        rt_windows_private_free_v1(name)
        _journal_free_wiped(buffer, payload.len() + 1)
        if status == 0: return Ok(false)
        if status != 1: return Err("WINDOWS_JOURNAL_WRITE_UNCERTAIN")
        Ok(true)

    # Only a new fixed consumption record can mint this capability. Existing
    # records and ordinary reads/publishes cannot be converted into receipts.
    pub fn publish_consumption(relative: text, payload: text) -> Result<WindowsJournalConsumptionV1, text>:
        if relative.byte_len() == 0 or relative.byte_len() > 512:
            return Err("WINDOWS_JOURNAL_CONSUMPTION_NAME")
        val name = _private_path(relative)
        if name == 0: return Err("WINDOWS_JOURNAL_CONSUMPTION_NAME")
        val buffer = match _journal_payload(payload):
            case Ok(value): value
            case Err(message):
                rt_windows_private_free_v1(name)
                return Err(message)
        val sequence = rt_windows_journal_publish_v1(self.token, name, buffer, payload.byte_len(), 1)
        rt_windows_private_free_v1(name)
        rt_free(buffer)
        if sequence == 0: return Err("WINDOWS_JOURNAL_CONSUMPTION_ALREADY_EXISTS")
        if sequence < 0: return Err("WINDOWS_JOURNAL_CONSUMPTION_UNCERTAIN")
        Ok(WindowsJournalConsumptionV1(store_token: self.token, sequence: sequence, payload: payload))

    # Replacing is limited to parent.lease; immutable entries never use it.
    pub fn replace(relative: text, payload: text) -> Result<bool, text>:
        self.write_record(relative, payload, 1, None)

    # CURRENT compare/read/stage/rename holds one native lock across all steps.
    # None means exact absence, Some("") means an actual empty file.
    pub fn compare_replace(relative: text, payload: text, expected: Option<text>) -> Result<bool, text>:
        self.write_record(relative, payload, 2, expected)

    fn write_record(relative: text, payload: text, operation: i64, expected: Option<text>) -> Result<bool, text>:
        if relative.byte_len() == 0 or relative.byte_len() > 512:
            return Err("WINDOWS_JOURNAL_NAME")
        if operation == 1 and relative != "parent.lease": return Err("WINDOWS_JOURNAL_REPLACE_NAME")
        if operation == 2 and relative != "database-wal/CURRENT": return Err("WINDOWS_JOURNAL_CAS_NAME")
        val name = _private_path(relative)
        if name == 0: return Err("WINDOWS_JOURNAL_NAME")
        val buffer = match _journal_payload(payload):
            case Ok(value): value
            case Err(message):
                rt_windows_private_free_v1(name)
                return Err(message)
        var expected_buffer = 0
        var expected_length = -1
        if operation == 2:
            if val previous = expected:
                expected_buffer = match _journal_payload(previous):
                    case Ok(value): value
                    case Err(message):
                        rt_windows_private_free_v1(name)
                        rt_free(buffer)
                        return Err(message)
                expected_length = previous.byte_len()
        val status = if operation == 0:
            rt_windows_journal_publish_v1(self.token, name, buffer, payload.byte_len(), 0)
        elif operation == 1:
            rt_windows_journal_replace_v1(self.token, name, buffer, payload.byte_len())
        else:
            rt_windows_journal_compare_replace_v1(self.token, name, buffer, payload.byte_len(), expected_buffer, expected_length)
        rt_windows_private_free_v1(name)
        rt_free(buffer)
        if expected_buffer != 0: rt_free(expected_buffer)
        if status == 0: return Ok(false)
        if status != 1: return Err("WINDOWS_JOURNAL_WRITE_UNCERTAIN")
        Ok(true)

    # Failure leaves the generation, all uncertain handles and parent lock
    # owned by this value. A stale copied alias cannot operate after success.
    pub me close_state() -> text:
        val status = rt_windows_journal_close_v1(self.token)
        if status == 1: return "released"
        if status == -1: return "stale"
        "retained"

    pub me close() -> bool:
        self.close_state() == "released"

pub class WindowsJournalConsumptionV1:
    store_token: i64
    sequence: i64
    payload: text

    pub fn belongs_to(store: WindowsJournalStoreV1) -> bool:
        self.store_token == store.token and store.live()

    # Native state consumes the exact receipt before any fallible readback.
    # Copying this value never creates another claim or revives an old one.
    pub fn claim(expected_payload: text) -> Result<bool, text>:
        val buffer = match _journal_payload(expected_payload):
            case Ok(value): value
            case Err(message):
                # Even an encoding/quota/allocation error consumes this claim;
                # the native invalid-input path performs no buffer access.
                val consumed = rt_windows_journal_consumption_claim_v1(self.store_token, self.sequence, 0, -1)
                return Err(message)
        val status = rt_windows_journal_consumption_claim_v1(self.store_token, self.sequence,
            buffer, expected_payload.byte_len())
        rt_free(buffer)
        if status == 0: return Ok(false)
        if status != 1: return Err("WINDOWS_JOURNAL_CONSUMPTION_CLAIM_UNCERTAIN")
        if expected_payload != self.payload: return Err("WINDOWS_JOURNAL_CONSUMPTION_INTEGRITY")
        Ok(true)

export WindowsJournalStoreV1, WindowsJournalStoreOpenV1, WindowsJournalConsumptionV1
