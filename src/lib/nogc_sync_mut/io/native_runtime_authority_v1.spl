# Managed runtime inputs are projections of the existing sealed source/runtime
# snapshots. Provider selection stays in the compiler; this owner only binds
# the selected files. Legacy calls never enter this module's strict APIs.
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded, file_hash_sha256}
use std.nogc_sync_mut.io.native_tool_authority_v1.{NativePinnedArtifactV1,
    native_pinned_artifact_open_v1, native_pinned_artifact_revalidate_v1,
    native_tool_absolute_v1, native_tool_digest_valid_v1, native_tool_strict_resolve_v1}
use std.nogc_sync_mut.sffi.transient.{transient_promote, transient_scope_begin,
    transient_scope_pause, transient_scope_end}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.encoding.utf8.{text_byte_len}

pub struct NativeRuntimePinV1:
    relative: text
    digest: text

# Compact projection of the actual managed owner. Compiler bundle selection
# supplies the ordered inputs; this owner admits each selected file. This is
# provider provenance, not a promise that generated objects have been compiled.
pub struct NativeRuntimeProviderSelectionV1:
    root: text
    snapshot: NativePinnedArtifactV1
    pins: [NativeRuntimePinV1]

struct NativeRuntimeAuthorityV1:
    identity: text
    root: text
    snapshot: NativePinnedArtifactV1
    pins: [NativeRuntimePinV1]

struct NativeRuntimeAuthorityProjectionV1:
    authority: NativeRuntimeAuthorityV1
    authorities: [NativeRuntimeAuthorityV1]

struct NativeRuntimeFileProjectionV1:
    binding: NativePinnedArtifactV1
    files: [NativePinnedArtifactV1]

pub struct NativeRuntimeAdmissionReceiptV1:
    authority_identities: [text]
    snapshot_digests: [text]
    files: [NativePinnedArtifactV1]
    generated: [NativePinnedArtifactV1]

var _native_runtime_authorities_v1: [NativeRuntimeAuthorityV1] = []
var _native_runtime_files_v1: [NativePinnedArtifactV1] = []
var _native_runtime_failed_v1: bool = false
var _native_runtime_generated_v1: [NativePinnedArtifactV1] = []

fn native_runtime_hex_v1(encoded: text) -> Result<text, text>:
    if encoded == "" or encoded.len() > 8192 or encoded.len() % 2 != 0:
        return Err("managed runtime snapshot path encoding invalid")
    var bytes: [u8] = []
    var index = 0
    while index < encoded.len():
        var value: i64 = 0
        for offset in 0..2:
            val digit = encoded.byte_at(index + offset) as i64
            val decoded = if digit >= 48 and digit <= 57: digit - 48 elif digit >= 97 and digit <= 102: digit - 87 else: -1
            if decoded < 0: return Err("managed runtime snapshot hex invalid")
            value = value * 16 + decoded
        bytes.push(value.to_u8())
        index = index + 2
    validated_utf8_bytes_to_text_linear(bytes)

pub fn native_runtime_relative_valid_v1(path: text) -> bool:
    if path == "" or path.contains("\\") or path.contains(":") or
            path.contains("\0") or path.contains("\r") or path.contains("\n"):
        return false
    for part in path.split("/"):
        if part == "" or part == "." or part == "..": return false
    true

pub fn native_runtime_snapshot_decode_v1(payload: text, source: bool) -> Result<[NativeRuntimePinV1], text>:
    if payload == "" or payload.len() > 67108864 or not payload.ends_with("\n") or
            payload.contains("\r") or payload.contains("\0"):
        return Err("managed runtime snapshot framing invalid")
    var pins: [NativeRuntimePinV1] = []
    var seen: Dict<text, bool> = {}
    for row in payload.split("\n"):
        if row == "": continue
        val fields = row.split(":")
        if source and fields[0] != "file-hex":
            # The source authority admits links elsewhere, but runtime source
            # dependencies must be regular files, never resolved link aliases.
            if fields.len() > 1:
                val relative = native_runtime_hex_v1(fields[1])?
                if relative.starts_with("src/runtime/"):
                    return Err("managed runtime source link is unsupported")
            continue
        val expected = if source: 5 else: 4
        if fields.len() != expected or fields[0] != "file-hex":
            return Err("managed runtime snapshot row invalid")
        val path_index = if source: 2 else: 1
        val relative = native_runtime_hex_v1(fields[path_index])?
        if source and not relative.starts_with("src/runtime/"): continue
        if not native_runtime_relative_valid_v1(relative) or seen.has(relative.lower()):
            return Err("managed runtime snapshot path invalid or duplicated")
        if source and (fields[1].to_i64() ?? -1) != text_byte_len(relative):
            return Err("managed runtime source path length invalid")
        val executable = fields[path_index + 1]
        val digest = fields[path_index + 2]
        if (executable != "0" and executable != "1") or not native_tool_digest_valid_v1(digest):
            return Err("managed runtime snapshot metadata invalid")
        seen[relative.lower()] = true
        pins.push(NativeRuntimePinV1(relative, digest))
    if pins.is_empty(): return Err("managed runtime snapshot has no runtime inputs")
    Ok(pins)

fn native_runtime_authority_v1(source: bool) -> Result<NativeRuntimeAuthorityV1, text>:
    val result = native_runtime_authority_open_v1(source)
    if result.is_err(): _native_runtime_failed_v1 = true
    result

fn native_runtime_binding_validate_v1(binding: NativePinnedArtifactV1, hash_bytes: bool) -> Result<bool, text>:
    if _native_runtime_failed_v1: return Err("managed runtime authority previously invalidated")
    val result = native_pinned_artifact_revalidate_v1(binding, hash_bytes)
    if result.is_err(): _native_runtime_failed_v1 = true
    result

fn native_runtime_authority_open_v1(source: bool) -> Result<NativeRuntimeAuthorityV1, text>:
    if _native_runtime_failed_v1: return Err("managed runtime authority previously invalidated")
    # Validate strict mode and the canonical tool authority as part of admission.
    val _cc = native_tool_strict_resolve_v1("cc")?
    val root = if source: env_get("SIMPLE_MANAGED_PHASE4_SOURCE_ROOT") else: env_get("SIMPLE_MANAGED_RUNTIME_AUTHORITY_PATH")
    val path = if source: env_get("SIMPLE_MANAGED_PHASE4_SOURCE_AUTHORITY_PATH") else: env_get("SIMPLE_MANAGED_RUNTIME_SNAPSHOT_PATH")
    val digest = if source: env_get("SIMPLE_MANAGED_PHASE4_SOURCE_AUTHORITY_SHA256") else: env_get("SIMPLE_MANAGED_RUNTIME_SNAPSHOT_SHA256")
    # DIAG (2026-10-20, SIMPLE_MANAGED_AUTHORITY_DIAG=1): the phase-C
    # test_runner link failed 'managed runtime authority root invalid' inside
    # a native-build worker while the identical env links fine in-process and
    # the sibling tool-authority reads (which admission just used) succeed in
    # the same worker. Print the raw operands (lengths AND a hex prefix of
    # the first bytes, so an erased value reads as len=0 vs a corrupt one as
    # len>0) instead of interpolating the texts, which the documented
    # stage2 text-crossing defect can blank.
    if env_get("SIMPLE_MANAGED_AUTHORITY_DIAG") == "1":
        eprint("[managed-auth-diag] source={source} root_len={root.len()} abs={native_tool_absolute_v1(root)} slash={root.ends_with(\"/\")} path_len={path.len()} digest_len={digest.len()}")
    if not native_tool_absolute_v1(root) or root.ends_with("/"):
        return Err("managed runtime authority root invalid")
    val configured = if source: env_get("SIMPLE_PROJECT_ROOT") else: env_get("SIMPLE_RUNTIME_PATH")
    if configured != "" and configured != root:
        return Err("ambient runtime root differs from admitted authority")
    val identity = "{source}\n{root}\n{path}\n{digest}"
    for authority in _native_runtime_authorities_v1:
        if authority.identity.starts_with("{source}\n"):
            if authority.identity != identity:
                return Err("managed runtime authority changed within invocation")
            val _unchanged = native_runtime_binding_validate_v1(authority.snapshot, false)?
            return Ok(authority)
    if transient_array_scope_state_v1() != 0:
        return Err("managed runtime cold authority requires its own inactive owner")
    if not transient_scope_begin(): return Err("managed runtime cold authority scope unavailable")
    val captured = native_runtime_authority_capture_in_owned_scope_v1(identity, root, path, digest, source)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(captured) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended:
        panic("managed runtime cold authority ownership failed")
    if captured.is_err(): return Err(captured.unwrap_err())
    val projection = captured.unwrap()
    _native_runtime_authorities_v1 = projection.authorities
    Ok(projection.authority)

fn native_runtime_authority_capture_in_owned_scope_v1(
    identity: text, root: text, path: text, digest: text, source: bool
) -> Result<NativeRuntimeAuthorityProjectionV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("managed runtime borrowed authority capture requires active unpaused scope")
    val snapshot = native_pinned_artifact_open_v1(path, digest)?
    val payload = file_read_regular_no_follow_bounded(path, 67108864)?
    val pins = native_runtime_snapshot_decode_v1(payload, source)?
    val _unchanged = native_runtime_binding_validate_v1(snapshot, true)?
    val authority = NativeRuntimeAuthorityV1(identity, root, snapshot, pins)
    # A fresh aggregate prevents an existing persistent registry from acquiring
    # aliases into this lease before all captured roots are promoted.
    var authorities: [NativeRuntimeAuthorityV1] = []
    for previous in _native_runtime_authorities_v1: authorities.push(previous)
    authorities.push(authority)
    Ok(NativeRuntimeAuthorityProjectionV1(authority, authorities))

fn native_runtime_pin_v1(authority: NativeRuntimeAuthorityV1, relative: text) -> Result<text, text>:
    val result = native_runtime_pin_open_v1(authority, relative)
    if result.is_err(): _native_runtime_failed_v1 = true
    result

fn native_runtime_pin_open_v1(authority: NativeRuntimeAuthorityV1, relative: text) -> Result<text, text>:
    if _native_runtime_failed_v1: return Err("managed runtime authority previously invalidated")
    val path = authority.root + "/" + relative
    for binding in _native_runtime_files_v1:
        if binding.path == path:
            val _unchanged = native_runtime_binding_validate_v1(binding, false)?
            return Ok(path)
    for pin in authority.pins:
        if pin.relative == relative:
            if transient_array_scope_state_v1() != 0:
                return Err("managed runtime cold file pin requires its own inactive owner")
            if not transient_scope_begin(): return Err("managed runtime cold file pin scope unavailable")
            val captured = native_runtime_file_capture_in_owned_scope_v1(path, pin.digest)
            val paused = transient_scope_pause()
            val owned = if paused: transient_promote(captured) else: false
            val ended = transient_scope_end()
            if not paused or not owned or not ended:
                panic("managed runtime cold file pin ownership failed")
            if captured.is_err(): return Err(captured.unwrap_err())
            _native_runtime_files_v1 = captured.unwrap().files
            return Ok(path)
    Err("runtime input absent from admitted snapshot: " + relative)

fn native_runtime_file_capture_in_owned_scope_v1(
    path: text, digest: text
) -> Result<NativeRuntimeFileProjectionV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("managed runtime borrowed file capture requires active unpaused scope")
    val binding = native_pinned_artifact_open_v1(path, digest)?
    var files: [NativePinnedArtifactV1] = []
    for previous in _native_runtime_files_v1: files.push(previous)
    files.push(binding)
    Ok(NativeRuntimeFileProjectionV1(binding, files))

pub fn native_runtime_strict_source_dir_v1() -> Result<text, text>:
    val authority = native_runtime_authority_v1(true)?
    # Includes nested headers and C include fragments, bound once per process.
    for pin in authority.pins:
        val _path = native_runtime_pin_v1(authority, pin.relative)?
    val _runtime = native_runtime_pin_v1(authority, "src/runtime/runtime.c")?
    Ok(authority.root + "/src/runtime")

pub fn native_runtime_strict_root_v1() -> Result<text, text>:
    val authority = native_runtime_authority_v1(false)?
    Ok(authority.root)

pub fn native_runtime_strict_owner_ready_v1(source: bool) -> bool:
    # Observation only; selectors still require the real owner validators.
    if _native_runtime_failed_v1: return false
    for authority in _native_runtime_authorities_v1:
        if authority.identity.starts_with("{source}\n"): return true
    false

pub fn native_runtime_strict_prepare_v1(backend: text) -> Result<bool, text>:
    if backend == "llvm":
        val _source = native_runtime_strict_source_dir_v1()?
    elif backend == "cranelift":
        val authority = native_runtime_authority_v1(false)?
        # Preflight every archived provider in the sealed root. The compiler's
        # existing bundle selector still chooses the actual provider set.
        var count = 0
        for pin in authority.pins:
            if pin.relative.ends_with(".a") or pin.relative.ends_with(".lib"):
                val _path = native_runtime_pin_v1(authority, pin.relative)?
                count = count + 1
        if count == 0: return Err("managed runtime authority has no archived providers")
    else:
        return Err("managed runtime backend unsupported")
    Ok(true)

pub fn native_runtime_provider_pins_v1(root: text, runtime_dir: text,
        inputs: [text], pins: [NativeRuntimePinV1]) -> Result<[NativeRuntimePinV1], text>:
    if runtime_dir != root or not native_tool_absolute_v1(root) or inputs.is_empty():
        return Err("runtime provider is not the exact admitted provider set")
    var selected: [NativeRuntimePinV1] = []
    for path in inputs:
        val prefix = root + "/"
        if not path.starts_with(prefix): return Err("runtime provider outside admitted authority")
        val relative = path[prefix.len():]
        if not native_runtime_relative_valid_v1(relative): return Err("runtime provider path invalid")
        var found = false
        for pin in pins:
            if pin.relative == relative:
                selected.push(pin)
                found = true
        if not found: return Err("runtime provider absent from admitted snapshot: " + relative)
    Ok(selected)

pub fn native_runtime_strict_archives_v1(runtime_dir: text, inputs: [text]) -> Result<[text], text>:
    val authority = native_runtime_authority_v1(false)?
    val selected = native_runtime_provider_pins_v1(authority.root, runtime_dir, inputs, authority.pins)?
    for pin in selected:
        val _path = native_runtime_pin_v1(authority, pin.relative)?
    Ok(inputs)

pub fn native_runtime_strict_provider_selection_v1(
    runtime_dir: text, inputs: [text]
) -> Result<NativeRuntimeProviderSelectionV1, text>:
    native_runtime_provider_selection_from_owner_v1(runtime_dir, inputs, true)

fn native_runtime_provider_selection_from_owner_v1(
    runtime_dir: text, inputs: [text], hash_bytes: bool
) -> Result<NativeRuntimeProviderSelectionV1, text>:
    val authority = native_runtime_authority_v1(false)?
    val selected = native_runtime_provider_pins_v1(
        authority.root, runtime_dir, inputs, authority.pins)?
    var seen: Dict<text, bool> = {}
    for pin in selected:
        if seen.has(pin.relative):
            return Err("managed runtime selected provider duplicated")
        seen[pin.relative] = true
        val _path = native_runtime_pin_v1(authority, pin.relative)?
    val _unchanged = native_runtime_strict_revalidate_v1(hash_bytes)?
    Ok(NativeRuntimeProviderSelectionV1(authority.root, authority.snapshot, selected))

pub fn native_runtime_strict_provider_selection_revalidate_v1(
    selection: NativeRuntimeProviderSelectionV1, inputs: [text], hash_bytes: bool = false
) -> Result<bool, text>:
    # Re-project from the live owner and compiler's current ordered selection.
    # Caller-created rows cannot grant an input absent from this owner.
    val current = native_runtime_provider_selection_from_owner_v1(selection.root, inputs, hash_bytes)?
    if current.snapshot.path != selection.snapshot.path or
            current.snapshot.digest != selection.snapshot.digest or
            current.pins.len() != selection.pins.len():
        return Err("managed runtime provider selection changed")
    var index = 0
    while index < current.pins.len():
        if current.pins[index].relative != selection.pins[index].relative or
                current.pins[index].digest != selection.pins[index].digest:
            return Err("managed runtime selected provider changed")
        index = index + 1
    Ok(true)

pub fn native_runtime_strict_generated_bind_v1(paths: [text]) -> Result<bool, text>:
    if _native_runtime_failed_v1: return Err("managed runtime authority previously invalidated")
    if paths.is_empty(): return Err("managed runtime generated object set is empty")
    if transient_array_scope_state_v1() != 0:
        return Err("managed generated runtime binding requires its own inactive owner")
    if not transient_scope_begin(): return Err("managed generated runtime binding scope unavailable")
    val captured = native_runtime_generated_capture_in_owned_scope_v1(paths)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(captured) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended:
        panic("managed generated runtime binding ownership failed")
    if captured.is_err(): return Err(captured.unwrap_err())
    _native_runtime_generated_v1 = captured.unwrap()
    Ok(true)

fn native_runtime_generated_capture_in_owned_scope_v1(
    paths: [text]
) -> Result<[NativePinnedArtifactV1], text>:
    if transient_array_scope_state_v1() != 1:
        return Err("managed generated runtime borrowed capture requires active unpaused scope")
    var bindings: [NativePinnedArtifactV1] = []
    for path in paths:
        val normalized = path.replace("\\", "/")
        bindings.push(native_pinned_artifact_open_v1(normalized, file_hash_sha256(normalized))?)
    Ok(bindings)

pub fn native_runtime_strict_generated_inputs_v1(inputs: [text]) -> Result<bool, text>:
    if _native_runtime_failed_v1: return Err("managed runtime authority previously invalidated")
    if _native_runtime_generated_v1.is_empty():
        return Err("managed runtime 'none' requires this invocation's compiled runtime objects")
    for binding in _native_runtime_generated_v1:
        var found = false
        for input in inputs:
            if input.replace("\\", "/") == binding.path: found = true
        if not found:
            # The darwin link-input cache rewrites object paths into
            # build/native_cache/darwin_link_inputs/<idx>-<digest>.d/<name> (relative
            # cache spellings), so the literal path comparison above misses
            # every generated runtime object on macOS managed links. Fall back
            # to the binding's pinned digest: an input whose sha256 equals the
            # admitted generated object IS the admitted object, byte for byte,
            # so the security property is unchanged -- only the spelling is.
            for input in inputs:
                if file_hash_sha256(input) == binding.digest:
                    found = true
        if not found:
            # DIAG (SIMPLE_MANAGED_AUTHORITY_DIAG=1): print lengths and a
            # stable digest of the first bytes on both sides -- bare prints
            # survive the stage2 text-crossing defect that blanks
            # interpolations, and the lengths alone distinguish a /tmp vs
            # /private/tmp spelling divergence from an erased value.
            if env_get("SIMPLE_MANAGED_AUTHORITY_DIAG") == "1":
                val sample = if binding.path.len() > 0: binding.path.byte_at(0) else: -1
                eprint("[managed-gen-diag] bindings={_native_runtime_generated_v1.len()} inputs={inputs.len()} bind_len={binding.path.len()} bind_first_byte={sample}")
                print "managed-gen-bind-path-below"
                print binding.path
                print "managed-gen-input0-below"
                if inputs.len() > 0:
                    print inputs[0]
            return Err("managed compiled runtime object omitted")
        val _unchanged = native_runtime_binding_validate_v1(binding, false)?
    Ok(true)

pub fn native_runtime_strict_generated_release_v1(paths: [text]):
    # Cleanup remains available after a sticky validation failure, but may not
    # borrow or close a caller's lease.
    if transient_array_scope_state_v1() != 0:
        _native_runtime_failed_v1 = true
        return
    if not transient_scope_begin():
        _native_runtime_failed_v1 = true
        return
    var retained: [NativePinnedArtifactV1] = []
    for binding in _native_runtime_generated_v1:
        var released = false
        for path in paths:
            if path.replace("\\", "/") == binding.path: released = true
        if not released: retained.push(binding)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(retained) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended:
        panic("managed generated runtime release ownership failed")
    _native_runtime_generated_v1 = retained

pub fn native_runtime_strict_revalidate_v1(hash_bytes: bool) -> Result<bool, text>:
    if _native_runtime_failed_v1: return Err("managed runtime authority previously invalidated")
    for authority in _native_runtime_authorities_v1:
        val source = authority.identity.starts_with("true\n")
        match native_runtime_authority_v1(source):
            Ok(_): pass
            Err(reason):
                _native_runtime_failed_v1 = true
                return Err(reason)
        match native_pinned_artifact_revalidate_v1(authority.snapshot, hash_bytes):
            Ok(_): pass
            Err(reason):
                _native_runtime_failed_v1 = true
                return Err(reason)
    for binding in _native_runtime_files_v1:
        match native_pinned_artifact_revalidate_v1(binding, hash_bytes):
            Ok(_): pass
            Err(reason):
                _native_runtime_failed_v1 = true
                return Err(reason)
    for binding in _native_runtime_generated_v1:
        val _unchanged = native_runtime_binding_validate_v1(binding, hash_bytes)?
    Ok(true)

pub fn native_runtime_admission_receipt_v1() -> Result<NativeRuntimeAdmissionReceiptV1, text>:
    if _native_runtime_authorities_v1.len() == 0 or (_native_runtime_files_v1.len() == 0 and _native_runtime_generated_v1.len() == 0):
        return Err("runtime has no actual admitted input owner")
    native_runtime_strict_revalidate_v1(true)?
    var identities: [text] = []
    var snapshots: [text] = []
    for authority in _native_runtime_authorities_v1:
        identities.push(authority.identity)
        snapshots.push(authority.snapshot.digest)
    Ok(NativeRuntimeAdmissionReceiptV1(authority_identities: identities,
        snapshot_digests: snapshots, files: _native_runtime_files_v1,
        generated: _native_runtime_generated_v1))
