"""Typed process-observation V1 facade."""

use std.common.process.observation_v1.{
    ProcessObservationProviderV1,
    ObservedProcessStartStatusV1, ObservedProcessPollStatusV1,
    ObservedProcessResultStatusV1, ObservedProcessRequestV1,
    ObservedProcessFailureReasonV1,
    ObservedProcessStreamV1, ObservedProcessRusageV1,
    ObservedExecutablePinV1, ObservedProcessPollV1, ObservedProcessResultV1,
    observed_process_result_status_v1
}
use std.nogc_sync_mut.io.process_ops.{
    OwnedExecutablePin, ProcessObservationOwnerV1,
    ObservedProcessLeaseV1, ObservedProcessStartV1,
    process_observation_owner_provider_v1,
    process_observation_owner_start_v1,
    process_observation_owner_start_pinned_v1,
    process_observation_owner_poll_v1,
    process_observation_owner_collect_v1
}

pub fn process_observation_provider_v1() -> ProcessObservationProviderV1:
    process_observation_owner_provider_v1()

pub fn process_observation_start_v1(
    request: ObservedProcessRequestV1
) -> ObservedProcessStartV1:
    process_observation_owner_start_v1(process_observation_provider_v1(), request)

pub fn process_observation_start_with_provider_v1(
    provider: ProcessObservationProviderV1,
    request: ObservedProcessRequestV1
) -> ObservedProcessStartV1:
    process_observation_owner_start_v1(provider, request)

pub fn process_observation_start_pinned_v1(
    pin: OwnedExecutablePin,
    request: ObservedProcessRequestV1
) -> ObservedProcessStartV1:
    process_observation_owner_start_pinned_v1(pin, request)

pub fn process_observation_poll_v1(
    lease: ObservedProcessLeaseV1,
    wait_ms: i64,
    stdout_capacity: i64,
    stderr_capacity: i64
) -> ObservedProcessPollV1:
    process_observation_owner_poll_v1(
        lease, wait_ms, stdout_capacity, stderr_capacity)

pub fn process_observation_collect_v1(
    lease: ObservedProcessLeaseV1
) -> ObservedProcessResultV1:
    process_observation_owner_collect_v1(lease)

pub fn process_observation_decode_result_v1(
    words: [i64]
) -> ObservedProcessResultV1:
    if words.len() == 0:
        return observed_process_result_status_v1(
            ObservedProcessResultStatusV1.Missing)
    # No V1 provider schema is admitted yet.  Nonempty data cannot be assigned
    # observation semantics merely because it resembles a legacy word vector.
    observed_process_result_status_v1(
        ObservedProcessResultStatusV1.Malformed)

export ProcessObservationProviderV1
export ObservedProcessStartStatusV1, ObservedProcessPollStatusV1
export ObservedProcessResultStatusV1, ObservedProcessRequestV1
export ObservedProcessFailureReasonV1
export ObservedProcessStreamV1, ObservedProcessRusageV1
export ObservedExecutablePinV1, OwnedExecutablePin, ObservedProcessLeaseV1
export ProcessObservationOwnerV1
export ObservedProcessStartV1, ObservedProcessPollV1, ObservedProcessResultV1
export process_observation_provider_v1, process_observation_start_v1
export process_observation_start_with_provider_v1, process_observation_poll_v1
export process_observation_start_pinned_v1
export process_observation_collect_v1, process_observation_decode_result_v1
