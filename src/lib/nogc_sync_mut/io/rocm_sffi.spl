# ROCm HIP Runtime SFFI Bindings
#
# SFFI pattern for AMD GPU compute via HIP (mirrors CUDA API).
# Note: These require ROCm toolkit to be installed.

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

@unsafe(reason: "raw optional ROCm provider initialization", capabilities: [ffi])
extern fn rt_rocm_init() -> bool
@unsafe(reason: "raw ROCm provider availability query", capabilities: [ffi])
extern fn rt_rocm_is_available() -> bool
@unsafe(reason: "raw ROCm device count conflates unavailable and zero devices", capabilities: [ffi])
extern fn rt_rocm_device_count() -> i64
@unsafe(reason: "raw nullable ROCm device-name result", capabilities: [ffi])
extern fn rt_rocm_device_name(device: i64) -> text?
@unsafe(reason: "raw ROCm device-memory result conflates failure and zero", capabilities: [ffi])
extern fn rt_rocm_device_memory(device: i64) -> i64
@unsafe(reason: "raw ROCm identity result conflates unsupported and zero", capabilities: [ffi])
extern fn rt_rocm_device_identity(device: i64) -> i64
@unsafe(reason: "raw ROCm device-selection status", capabilities: [ffi])
extern fn rt_rocm_set_device(device: i64) -> bool
@unsafe(reason: "raw ROCm current-device result", capabilities: [ffi])
extern fn rt_rocm_get_device() -> i64
@unsafe(reason: "raw opaque ROCm device allocation", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_malloc(size: i64) -> i64
@unsafe(reason: "raw generationless ROCm allocation release", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_free(ptr: i64) -> bool
@unsafe(reason: "raw host-to-device span and pointer copy", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_memcpy_h2d(dst: i64, src_data: [u8], size: i64) -> bool
@unsafe(reason: "raw device-to-host pointer and mutable-span copy", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_memcpy_d2h(dst_data: [u8], src: i64, size: i64) -> bool
@unsafe(reason: "raw device-pointer extent copy", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_memcpy_d2d(dst: i64, src: i64, size: i64) -> bool
@unsafe(reason: "raw device-pointer extent mutation", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_memset(ptr: i64, value: i64, size: i64) -> bool
@unsafe(reason: "raw HIPRTC compilation and opaque module handle", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_compile_hsaco(source: text) -> i64
@unsafe(reason: "raw generationless module lookup and function handle", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_get_function(module: i64, name: text) -> i64
@unsafe(reason: "raw kernel handle, geometry, and argument-array ABI", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_launch_kernel(func: i64, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, shared_mem: i64, args: [i64]) -> bool
@unsafe(reason: "raw generationless ROCm module release", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_unload_module(module: i64) -> bool
@unsafe(reason: "raw ROCm global synchronization status", capabilities: [ffi])
extern fn rt_rocm_synchronize() -> bool
@unsafe(reason: "raw opaque ROCm stream handle", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_create_stream() -> i64
@unsafe(reason: "raw generationless ROCm stream release", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_destroy_stream(stream: i64) -> bool
@unsafe(reason: "raw generationless ROCm stream synchronization", capabilities: [ffi, raw_ptr])
extern fn rt_rocm_stream_synchronize(stream: i64) -> bool
@unsafe(reason: "raw nullable ROCm error-text result", capabilities: [ffi])
extern fn rt_rocm_get_last_error() -> text?

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

fn rocm_available() -> bool:
    unsafe(capabilities: [ffi]):
        rt_rocm_is_available()

fn rocm_init() -> bool:
    unsafe(capabilities: [ffi]):
        rt_rocm_init()

fn rocm_device_count() -> i64:
    unsafe(capabilities: [ffi]):
        rt_rocm_device_count()

fn rocm_set_device(id: i64) -> bool:
    unsafe(capabilities: [ffi]):
        rt_rocm_set_device(id)

fn rocm_get_device() -> i64:
    unsafe(capabilities: [ffi]):
        rt_rocm_get_device()

struct RocmDeviceInfo:
    id: i64
    name: text
    total_memory: i64

fn rocm_device_info(id: i64) -> RocmDeviceInfo:
    var name: text? = nil
    var total_memory: i64 = 0
    unsafe(capabilities: [ffi]):
        name = rt_rocm_device_name(id)
        total_memory = rt_rocm_device_memory(id)
    if not name.?:
        panic("E-SFFI-ROCM-001: ROCm device-name allocation failed")
    RocmDeviceInfo(id: id, name: name.unwrap(), total_memory: total_memory)

struct RocmPtr:
    ptr: i64
    size: i64
    is_valid: bool

fn rocm_alloc(size: i64) -> RocmPtr:
    if size <= 0:
        return RocmPtr(ptr: 0, size: 0, is_valid: false)
    val ptr = unsafe(capabilities: [ffi, raw_ptr]):
        rt_rocm_malloc(size)
    RocmPtr(ptr: ptr, size: size, is_valid: ptr > 0)

fn rocm_free(mem: RocmPtr) -> bool:
    if mem.is_valid:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_free(mem.ptr)
    else:
        false

fn rocm_copy_to_device(dst: RocmPtr, src: [u8]) -> bool:
    if not dst.is_valid or src.len() > dst.size:
        false
    else:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_memcpy_h2d(dst.ptr, src, src.len())

fn rocm_copy_from_device(dst: [u8], src: RocmPtr) -> bool:
    if not src.is_valid or dst.len() > src.size:
        false
    else:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_memcpy_d2h(dst, src.ptr, dst.len())

# reason: positional io rocm_sffi API
fn rocm_copy_device_to_device(dst: RocmPtr, src: RocmPtr, size: i64) -> bool:
    if not dst.is_valid or not src.is_valid or size < 0 or size > dst.size or size > src.size:
        false
    else:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_memcpy_d2d(dst.ptr, src.ptr, size)

fn rocm_memset(mem: RocmPtr, value: i64) -> bool:
    if not mem.is_valid:
        false
    else:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_memset(mem.ptr, value, mem.size)

struct RocmModule:
    handle: i64
    is_valid: bool

fn rocm_compile(hsaco_source: text) -> RocmModule:
    if hsaco_source == "":
        return RocmModule(handle: 0, is_valid: false)
    val handle = unsafe(capabilities: [ffi, raw_ptr]):
        rt_rocm_compile_hsaco(hsaco_source)
    RocmModule(handle: handle, is_valid: handle > 0)

fn rocm_unload(module: RocmModule) -> bool:
    if module.is_valid:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_unload_module(module.handle)
    else:
        false

struct RocmFunc:
    handle: i64
    module: RocmModule
    name: text
    is_valid: bool

fn rocm_get_kernel(module: RocmModule, name: text) -> RocmFunc:
    if not module.is_valid or name == "":
        RocmFunc(handle: 0, module: module, name: name, is_valid: false)
    else:
        val handle = unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_get_function(module.handle, name)
        RocmFunc(handle: handle, module: module, name: name, is_valid: handle > 0)

struct RocmLaunchConfig:
    gx: i64
    gy: i64
    gz: i64
    blk_x: i64
    blk_y: i64
    blk_z: i64
    shared_mem: i64

# reason: positional io rocm_sffi API
fn rocm_launch_config_1d(grid_size: i64, block_size: i64) -> RocmLaunchConfig:
    RocmLaunchConfig(gx: grid_size, gy: 1, gz: 1, blk_x: block_size, blk_y: 1, blk_z: 1, shared_mem: 0)

fn rocm_launch(kfn: RocmFunc, config: RocmLaunchConfig, args: [i64]) -> bool:
    if not kfn.is_valid or config.gx <= 0 or config.gy <= 0 or config.gz <= 0 or config.blk_x <= 0 or config.blk_y <= 0 or config.blk_z <= 0 or config.shared_mem < 0:
        false
    else:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_launch_kernel(kfn.handle, config.gx, config.gy, config.gz, config.blk_x, config.blk_y, config.blk_z, config.shared_mem, args)

fn rocm_sync() -> bool:
    unsafe(capabilities: [ffi]):
        rt_rocm_synchronize()

struct RocmStream:
    handle: i64
    is_valid: bool

fn rocm_stream_create() -> RocmStream:
    val handle = unsafe(capabilities: [ffi, raw_ptr]):
        rt_rocm_create_stream()
    RocmStream(handle: handle, is_valid: handle > 0)

fn rocm_stream_destroy(stream: RocmStream) -> bool:
    if stream.is_valid:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_destroy_stream(stream.handle)
    else:
        false

fn rocm_stream_sync(stream: RocmStream) -> bool:
    if stream.is_valid:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_rocm_stream_synchronize(stream.handle)
    else:
        false

fn rocm_last_error() -> text:
    var message: text? = nil
    unsafe(capabilities: [ffi]):
        message = rt_rocm_get_last_error()
    if not message.?:
        panic("E-SFFI-ROCM-002: ROCm error-text allocation failed")
    message.unwrap()

# reason: positional io rocm_sffi API
fn rocm_run_1d(kfn: RocmFunc, total_elements: i64, block_size: i64, args: [i64]) -> bool:
    if total_elements <= 0 or block_size <= 0:
        return false
    var grid_size = total_elements / block_size
    if total_elements % block_size != 0:
        grid_size = grid_size + 1
    val config = rocm_launch_config_1d(grid_size, block_size)
    rocm_launch(kfn, config, args) and rocm_sync()

fn rocm_alloc_from_host(data: [u8]) -> RocmPtr:
    val mem = rocm_alloc(data.len())
    if not mem.is_valid:
        return mem
    if rocm_copy_to_device(mem, data):
        return mem
    rocm_free(mem)
    RocmPtr(ptr: 0, size: 0, is_valid: false)

# ============================================================================
# Exports
# ============================================================================

export rt_rocm_is_available, rt_rocm_init, rt_rocm_device_count, rt_rocm_malloc, rt_rocm_free
export rt_rocm_device_name, rt_rocm_device_memory, rt_rocm_device_identity, rt_rocm_set_device, rt_rocm_get_device
export rt_rocm_memcpy_h2d, rt_rocm_memcpy_d2h, rt_rocm_memcpy_d2d
export rt_rocm_memset, rt_rocm_compile_hsaco, rt_rocm_get_function
export rt_rocm_launch_kernel, rt_rocm_unload_module, rt_rocm_synchronize
export rt_rocm_create_stream, rt_rocm_destroy_stream
export rocm_available, rocm_init, rocm_device_count, rocm_set_device, rocm_get_device
export RocmDeviceInfo, rocm_device_info, RocmPtr, rocm_alloc, rocm_free
export rocm_copy_to_device, rocm_copy_from_device, rocm_copy_device_to_device, rocm_memset
export RocmModule, rocm_compile, rocm_unload, RocmFunc, rocm_get_kernel
export RocmLaunchConfig, rocm_launch_config_1d, rocm_launch, rocm_sync
export RocmStream, rocm_stream_create, rocm_stream_destroy, rocm_stream_sync
export rocm_last_error, rocm_run_1d, rocm_alloc_from_host
