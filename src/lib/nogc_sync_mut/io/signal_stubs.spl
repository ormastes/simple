@unsafe(reason: "raw hosted signal installation ABI; positive status is success", capabilities: [ffi])
extern fn rt_signal_install(signal_num: i64) -> i64
@unsafe(reason: "raw hosted pending-signal latch ABI; positive status means pending", capabilities: [ffi])
extern fn rt_signal_check(signal_num: i64) -> i64
@unsafe(reason: "raw hosted process-exit latch installation ABI; positive status is success", capabilities: [ffi])
extern fn rt_atexit_install() -> i64
@unsafe(reason: "raw hosted process-exit latch query ABI; positive status means pending", capabilities: [ffi])
extern fn rt_atexit_check() -> i64

var _signal_handlers: [(i64, fn())] = []
val SIGNAL_HANDLER_CAPACITY: i64 = 33

fn _store_signal_handler(signal: i64, handler: fn()) -> bool:
    var i = 0
    while i < _signal_handlers.len():
        if _signal_handlers[i].0 == signal:
            _signal_handlers[i] = (signal, handler)
            return true
        i = i + 1
    if _signal_handlers.len() >= SIGNAL_HANDLER_CAPACITY:
        return false
    _signal_handlers.push((signal, handler))
    true

# Signals whose delivery is SYNCHRONOUS with the faulting instruction. This
# module's contract is a latch that sets a flag and RETURNS, which for a fault
# signal returns straight back to the instruction that faulted — an unbreakable
# fault loop. Worse, rt_signal_install would sigaction-replace the C runtime's
# crash handler (rt_install_crash_handler, src/runtime/runtime.c), losing the
# faulting address, the si_code classification and the backtrace. Registering a
# latch for these is never correct, so it is refused rather than accepted and
# silently made unsafe.
#
# Only the three numbers POSIX fixes identically on every host this tree builds
# for are listed: SIGILL=4, SIGFPE=8, SIGSEGV=11. SIGBUS is deliberately NOT
# listed — it is 7 on Linux but 10 on macOS/BSD, where 7 is SIGEMT and 10 is
# SIGUSR1, so a hardcoded number would refuse a legitimate SIGUSR1 latch on one
# platform. Closing that hole needs a platform-aware signal-number table, which
# this module does not have; it is recorded here rather than guessed.
fn _is_synchronous_fault_signal(signal: i64) -> bool:
    signal == 4 or signal == 8 or signal == 11

fn signal_handler_install(signal: i64, handler: fn()) -> bool:
    if _is_synchronous_fault_signal(signal):
        return false
    var installed: i64 = 0
    unsafe(capabilities: [ffi]):
        installed = rt_signal_install(signal)
    if installed <= 0:
        return false
    _store_signal_handler(signal, handler)

fn atexit_register(handler: fn()) -> bool:
    var installed: i64 = 0
    unsafe(capabilities: [ffi]):
        installed = rt_atexit_install()
    if installed <= 0:
        return false
    _store_signal_handler(-1, handler)

fn signal_dispatch_pending():
    for entry in _signal_handlers:
        val sig = entry.0
        val cb = entry.1
        if sig >= 0:
            var pending: i64 = 0
            unsafe(capabilities: [ffi]):
                pending = rt_signal_check(sig)
            if pending > 0:
                cb()
        elif sig == -1:
            var pending: i64 = 0
            unsafe(capabilities: [ffi]):
                pending = rt_atexit_check()
            if pending > 0:
                cb()
