# Private snapshot link and accidental-write guards. The native owner checks
# real ancestors, exact raw link text, target confinement and target kind.
# Content authority remains the pinned Stage2 digest and per-use readback.
@unsafe(reason: "exclusive no-follow snapshot symlink creation", capabilities: [ffi])
extern fn rt_snapshot_symlink_create_nofollow_v1(root: text, link_path: text,
    raw_target: text, kind: i32) -> i32
@unsafe(reason: "exact no-follow snapshot symlink readback", capabilities: [ffi])
extern fn rt_snapshot_symlink_match_nofollow_v1(root: text, link_path: text,
    raw_target: text, kind: i32) -> i32
@unsafe(reason: "snapshot readonly guard with no-follow readback", capabilities: [ffi])
extern fn rt_snapshot_readonly_nofollow_v1(path: text, kind: i32) -> i32

pub fn snapshot_symlink_create_nofollow_v1(root: text, link_path: text,
        raw_target: text, kind: i32) -> bool:
    if kind != 1 and kind != 2: return false
    unsafe(capabilities: [ffi]):
        rt_snapshot_symlink_create_nofollow_v1(root, link_path, raw_target, kind) == 0

pub fn snapshot_symlink_match_nofollow_v1(root: text, link_path: text,
        raw_target: text, kind: i32) -> bool:
    if kind != 1 and kind != 2: return false
    unsafe(capabilities: [ffi]):
        rt_snapshot_symlink_match_nofollow_v1(root, link_path, raw_target, kind) == 0

pub fn snapshot_readonly_nofollow_v1(path: text, kind: i32) -> bool:
    if kind != 1 and kind != 2: return false
    unsafe(capabilities: [ffi]):
        rt_snapshot_readonly_nofollow_v1(path, kind) == 0

export snapshot_symlink_create_nofollow_v1, snapshot_symlink_match_nofollow_v1
export snapshot_readonly_nofollow_v1
