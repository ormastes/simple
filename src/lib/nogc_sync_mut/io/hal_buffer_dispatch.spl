@rt(hal, operation: io.stream.write.buffer_v3, providers: pure+c+rust,
    capabilities: 6, comparator: 3, normalizer: 2, effects: replay_only,
    request_bytes: 32, result_bytes: 32, trace_operations: 1,
    trace_bytes: 32, diff_rows: 3, report_bytes: 256, log_bytes: 256,
