# Mission-critical caller-owned HAL buffer APIs.
#
# These additive leaves preserve the established text/[u8] compatibility APIs.
# A caller supplies both storage and capacity; the sealed V3 owner validates
# the captured observation and commits at most 32 bytes without allocating or
# retaining either pointer.  Every rejected call leaves output untouched.

use std.common.structural.environment_instruction.*

val RT_HAL_BUFFER_MAX_BYTES_V3: i64 = 32

enum RtHalBufferStatusV3:
    Ok
    Invalid
    State
    Io
    Protocol
    Diverged

enum RtHalBufferOverflowV3:
    None
    CapturedLength
    OutputCapacity

struct RtHalBufferPreflightV3:
    accepted: bool
    overflow: RtHalBufferOverflowV3
    status: RtHalBufferStatusV3

@unsafe(reason: "sealed V3 caller-owned HAL buffer comparison ABI", capabilities: [ffi])
extern fn rt_hal_buffer_dispatch_compare_v3(
    operation_id: i64, fixture_id: i64, captured_status: i32,
    error_domain: i32, error_code: i64, error_detail: i64,
    captured: *u8, captured_length: i64,
    output: *mut u8, output_capacity: i64,
    trace_identity_hi: i64, trace_identity_lo: i64,
    trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32

@unsafe(reason: "normal-mode caller-owned HAL buffer ABI", capabilities: [ffi])
extern fn rt_hal_buffer_dispatch_direct_v3(
    operation_id: i64, fixture_id: i64, captured_status: i32,
    error_domain: i32, error_code: i64, error_detail: i64,
    captured: *u8, captured_length: i64,
    output: *mut u8, output_capacity: i64,
    trace_identity_hi: i64, trace_identity_lo: i64,
    trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32

@unsafe(reason: "configured caller-owned HAL buffer ABI", capabilities: [ffi])
extern fn rt_hal_buffer_dispatch_configured_v3(
    operation_id: i64, fixture_id: i64, captured_status: i32,
    error_domain: i32, error_code: i64, error_detail: i64,
    captured: *u8, captured_length: i64,
    output: *mut u8, output_capacity: i64,
    trace_identity_hi: i64, trace_identity_lo: i64,
    trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32

@unsafe(reason: "fixed executed-access receipt issue transport", capabilities: [ffi])
extern fn rt_hal_buffer_access_issue_v3(
    authority_identity_hi: i64, authority_identity_lo: i64,
    operation_id: i64, invocation_id: i64, sequence: i64,
    opcode: i64, capability_id: i64, flags: i64,
    argument_offset: i64, argument_length: i64,
    argument_capacity: i64, result_offset: i64,
    result_capacity: i64, result_region_capacity: i64,
    trace_identity_hi: i64, trace_identity_lo: i64,
    trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i64

@unsafe(reason: "init-owned executed-access receipt authority", capabilities: [ffi])
extern fn rt_hal_buffer_access_owner_init_v3(
    authority_identity_hi: i64, authority_identity_lo: i64,
    capacity: i64) -> i32

@unsafe(reason: "fixed executed-access receipt publication transport", capabilities: [ffi])
extern fn rt_hal_buffer_access_publish_v3(
    operation_id: i64, invocation_id: i64,
    trace_identity_hi: i64, trace_identity_lo: i64,
    trace_cursor: i64, generation: i64,
    result_length: i64, execution_status: i64) -> i32

@unsafe(reason: "one-shot executed-access receipt consumption transport", capabilities: [ffi])
extern fn rt_hal_buffer_access_consume_v3(
    operation_id: i64, invocation_id: i64, opcode: i64,
    capability_id: i64, trace_identity_hi: i64,
    trace_identity_lo: i64, trace_cursor: i64,
    generation: i64, result_capacity: i64, result_length: i64) -> i32

fn rt_hal_buffer_status_v3(code: i32) -> RtHalBufferStatusV3:
    if code == 0: return RtHalBufferStatusV3.Ok
    if code == 2: return RtHalBufferStatusV3.State
    if code == 3: return RtHalBufferStatusV3.Io
    if code == 4: return RtHalBufferStatusV3.Protocol
    if code == 5: return RtHalBufferStatusV3.Diverged
    RtHalBufferStatusV3.Invalid

fn rt_hal_buffer_preflight_v3(captured_length: i64,
                              output_capacity: i64) -> RtHalBufferPreflightV3:
    if captured_length < 0 or captured_length > RT_HAL_BUFFER_MAX_BYTES_V3:
        return RtHalBufferPreflightV3(false,
            RtHalBufferOverflowV3.CapturedLength,
            RtHalBufferStatusV3.Invalid)
    if output_capacity <= 0
            or output_capacity > RT_HAL_BUFFER_MAX_BYTES_V3
            or captured_length > output_capacity:
        return RtHalBufferPreflightV3(false,
            RtHalBufferOverflowV3.OutputCapacity,
            RtHalBufferStatusV3.Invalid)
    RtHalBufferPreflightV3(true, RtHalBufferOverflowV3.None,
                          RtHalBufferStatusV3.Ok)

fn rt_hal_buffer_error_v3_well_formed(
        captured_status: i32, error_domain: i32,
        error_code: i64, error_detail: i64) -> bool:
    if captured_status == 0:
        return error_domain == 0 and error_code == 0 and error_detail == 0
    captured_status > 0 and error_domain > 0 and error_code != 0

@unsafe(reason: "issue fixed receipt for an instruction emitted by the actual environment executor", capabilities: [ffi])
fn _rt_hal_buffer_access_issue_instruction_v3(
        authority_identity_hi: i64, authority_identity_lo: i64,
        operation_id: i64, instruction: EnvInstructionV1,
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64,
        trace_capacity: i64) -> i64:
    val digest = env_instruction_plan_digest_v1(instruction)
    if not env_instruction_v1_well_formed(instruction)
            or instruction.sequence != trace_cursor
            or digest.0 != trace_identity_hi
            or digest.1 != trace_identity_lo:
        return 0
    rt_hal_buffer_access_issue_v3(authority_identity_hi,
        authority_identity_lo, operation_id, instruction.invocation_id,
        instruction.sequence, env_opcode_to_i64(instruction.opcode),
        instruction.capability_id, instruction.flags,
        instruction.argument_offset, instruction.argument_length,
        instruction.argument_capacity, instruction.result_offset,
        instruction.result_capacity, instruction.result_region_capacity,
        trace_identity_hi, trace_identity_lo, trace_cursor, trace_length,
        trace_capacity)

class RtHalBufferExecutedAccessOwnerV3:
    authority_identity_hi: i64
    authority_identity_lo: i64
    ready: bool

    me issue(operation_id: i64,
             extraction: RtHalAutomaticExtractionReceiptV1,
             trace_identity_hi: i64, trace_identity_lo: i64,
             trace_cursor: i64, trace_length: i64,
             trace_capacity: i64) -> i64:
        if not self.ready or not extraction.accepted
                or extraction.status != EnvInstructionStatusV1.Planned:
            return 0
        _rt_hal_buffer_access_issue_instruction_v3(
            self.authority_identity_hi, self.authority_identity_lo,
            operation_id, extraction.instruction, trace_identity_hi,
            trace_identity_lo, trace_cursor, trace_length, trace_capacity)

    me publish(operation_id: i64,
               extraction: RtHalAutomaticExtractionReceiptV1,
               execution: EnvExecutionReceiptV1,
               trace_identity_hi: i64, trace_identity_lo: i64,
               trace_cursor: i64, trace_length: i64,
               trace_capacity: i64, generation: i64) -> bool:
        val exact = extraction.accepted
            and execution.physical_effect
            and execution.allocation_count_after_seal == 0
            and env_observation_matches(extraction.instruction,
                execution.observation)
        val execution_status = if exact: 0 else:
            env_instruction_status_to_i64(execution.observation.status) + 1
        rt_hal_buffer_access_publish_execution_v3(operation_id,
            extraction, trace_identity_hi, trace_identity_lo, trace_cursor,
            trace_length, trace_capacity, generation,
            execution.observation.bytes_length, execution_status)

    # The owner, not its caller, obtains the execution receipt.  Issuing before
    # execute makes every physical failure terminal; publication either makes
    # the exact receipt consumable once or poisons the invocation.
    me execute(operation_id: i64,
               extraction: RtHalAutomaticExtractionReceiptV1,
               executor: EnvPhysicalExecutorPortV1,
               policy: EnvExecutorPolicyV1,
               argument_bytes: [u8], captured_bytes: [u8],
               trace_identity_hi: i64, trace_identity_lo: i64,
               trace_cursor: i64, trace_length: i64,
               trace_capacity: i64) -> (i64, i64):
        if extraction.instruction.argument_length > RT_HAL_BUFFER_MAX_BYTES_V3
                or extraction.instruction.result_capacity
                    > RT_HAL_BUFFER_MAX_BYTES_V3
                or argument_bytes.len() > RT_HAL_BUFFER_MAX_BYTES_V3
                or captured_bytes.len() > RT_HAL_BUFFER_MAX_BYTES_V3:
            return (0, 0)
        val generation = self.issue(operation_id, extraction,
            trace_identity_hi, trace_identity_lo, trace_cursor,
            trace_length, trace_capacity)
        if generation <= 0: return (0, 0)
        val execution = executor.execute(policy, extraction.instruction,
            argument_bytes, captured_bytes)
        if execution.observation.bytes_length < 0
                or execution.observation.bytes_length > captured_bytes.len():
            val poisoned = env_execution_rejected_v1(extraction.instruction,
                EnvInstructionStatusV1.Overflow)
            self.publish(operation_id, extraction, poisoned,
                trace_identity_hi, trace_identity_lo, trace_cursor,
                trace_length, trace_capacity, generation)
            return (0, 0)
        # Recompute the bounded canonical digest from the exact arrays that
        # will feed replay dispatch.  A forged/stale receipt is published only
        # as poison and can never authorize a copy.
        val canonical = env_execution_record_applied_v1(
            extraction.instruction, argument_bytes, captured_bytes,
            execution.observation.bytes_length, true, 0)
        val digest_exact = execution.observation.interaction_digest_hi
                == canonical.observation.interaction_digest_hi
            and execution.observation.interaction_digest_lo
                == canonical.observation.interaction_digest_lo
        val publication = if digest_exact: execution else:
            env_execution_rejected_v1(extraction.instruction,
                EnvInstructionStatusV1.Diverged)
        val published = self.publish(operation_id, extraction, publication,
            trace_identity_hi, trace_identity_lo, trace_cursor,
            trace_length, trace_capacity, generation)
        if not published or not digest_exact or not execution.applied
                or not execution.physical_effect
                or execution.allocation_count_after_seal != 0:
            return (0, 0)
        (generation, execution.observation.bytes_length)

@unsafe(reason: "create the sole init-owned executed-access receipt authority", capabilities: [ffi])
fn rt_hal_buffer_executed_access_owner_v3(
        authority_identity_hi: i64, authority_identity_lo: i64,
        capacity: i64 = 256) -> RtHalBufferExecutedAccessOwnerV3:
    val ready = authority_identity_hi != 0 and authority_identity_lo != 0
        and rt_hal_buffer_access_owner_init_v3(authority_identity_hi,
            authority_identity_lo, capacity) == 1
    RtHalBufferExecutedAccessOwnerV3(authority_identity_hi,
        authority_identity_lo, ready)

@unsafe(reason: "publish actual environment execution result into fixed receipt", capabilities: [ffi])
fn rt_hal_buffer_access_publish_execution_v3(
        operation_id: i64, extraction: RtHalAutomaticExtractionReceiptV1,
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64, trace_capacity: i64,
        generation: i64,
        result_length: i64, execution_status: i64) -> bool:
    val state = if execution_status == 0:
        RtHalExecutedAccessStateV3.Ready
    else:
        RtHalExecutedAccessStateV3.Poisoned
    val receipt = rt_hal_executed_access_receipt_v3(operation_id,
        generation, extraction.instruction, trace_identity_hi,
        trace_identity_lo, trace_cursor, trace_length,
        trace_capacity, result_length, execution_status, state)
    if not extraction.accepted
            or not rt_hal_executed_access_receipt_v3_well_formed(receipt):
        return false
    rt_hal_buffer_access_publish_v3(operation_id,
        extraction.instruction.invocation_id,
        trace_identity_hi, trace_identity_lo, trace_cursor, generation,
        result_length, execution_status) == 1

@unsafe(reason: "consume exact actual-access receipt before replay dispatch", capabilities: [ffi])
fn _rt_hal_buffer_extract_v3(
        operation_id: i64, opcode: EnvOpcodeV1, capability_id: i64,
        fixture_id: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        generation: i64, captured_length: i64,
        output_capacity: i64) -> bool:
    rt_hal_buffer_access_consume_v3(operation_id, fixture_id,
        env_opcode_to_i64(opcode), capability_id, trace_identity_hi,
        trace_identity_lo, trace_cursor, generation, output_capacity,
        captured_length) == 1

@unsafe(reason: "bounded caller-owned HAL buffer dispatch", capabilities: [ffi])
fn _rt_hal_buffer_call_v3(
        operation_id: i64, fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64,
        output: *mut u8, output_capacity: i64,
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
    rt_hal_buffer_dispatch_configured_v3(operation_id, fixture_id,
        captured_status, error_domain, error_code, error_detail,
        captured, captured_length, output, output_capacity,
        trace_identity_hi, trace_identity_lo, trace_cursor, trace_length,
        trace_capacity)

@unsafe(reason: "sealed compare-only caller-owned HAL buffer ABI", capabilities: [ffi])
fn _rt_hal_buffer_compare_call_v3(
        operation_id: i64, fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64,
        output: *mut u8, output_capacity: i64,
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
    rt_hal_buffer_dispatch_compare_v3(operation_id, fixture_id,
        captured_status, error_domain, error_code, error_detail,
        captured, captured_length, output, output_capacity,
        trace_identity_hi, trace_identity_lo, trace_cursor, trace_length,
        trace_capacity)

@unsafe(reason: "normal-mode bounded caller-owned HAL buffer copy", capabilities: [ffi])
fn _rt_hal_buffer_direct_call_v3(
        operation_id: i64, fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64,
        output: *mut u8, output_capacity: i64,
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
    rt_hal_buffer_dispatch_direct_v3(operation_id, fixture_id,
        captured_status, error_domain, error_code, error_detail,
        captured, captured_length, output, output_capacity,
        trace_identity_hi, trace_identity_lo, trace_cursor, trace_length,
        trace_capacity)

# Per-operation leaves deliberately share the exact frozen 15-argument ABI.
# Their distinct names let MIR replace a call only after complete ABI proof.
@inline
fn _hal_file_read_buffer_v3_raw(access_generation: i64,
        fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64, output: *mut u8,
        output_capacity: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        trace_length: i64, trace_capacity: i64) -> i32:
    _rt_hal_buffer_call_v3(1001, fixture_id, captured_status, error_domain,
        error_code, error_detail, captured, captured_length, output,
        output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor,
        trace_length, trace_capacity)

@inline
fn rt_hal_file_read_buffer_direct_v3(access_generation: i64,
        fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64, output: *mut u8,
        output_capacity: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        trace_length: i64, trace_capacity: i64) -> i32:
    _rt_hal_buffer_direct_call_v3(1001, fixture_id, captured_status,
        error_domain, error_code, error_detail, captured, captured_length, output,
        output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor,
        trace_length, trace_capacity)

@inline
fn rt_hal_file_read_buffer_compare_v3(access_generation: i64,
        fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64, output: *mut u8,
        output_capacity: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        trace_length: i64, trace_capacity: i64) -> i32:
    _rt_hal_buffer_compare_call_v3(1001, fixture_id, captured_status,
        error_domain, error_code, error_detail, captured, captured_length, output,
        output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor,
        trace_length, trace_capacity)

@rt(hal, operation: io.file.read.buffer_v3, providers: pure+c+rust,
    capabilities: 2, comparator: 3, normalizer: 2, effects: replay_only,
    request_bytes: 32, result_bytes: 32, trace_operations: 1,
    trace_bytes: 32, diff_rows: 3, report_bytes: 256, log_bytes: 256,
    deadline_ticks: 1000, error_schema: 2, environment_schema: 1,
    preferred: c)
fn hal_file_read_buffer_v3(access_generation: i64,
        fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64, output: *mut u8,
        output_capacity: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        trace_length: i64, trace_capacity: i64) -> i32:
    val preflight = rt_hal_buffer_preflight_v3(
        captured_length, output_capacity)
    if not preflight.accepted or not rt_hal_buffer_error_v3_well_formed(
            captured_status, error_domain, error_code, error_detail): return 1
    if not _rt_hal_buffer_extract_v3(1001, EnvOpcodeV1.FileRead, 2,
            fixture_id, trace_identity_hi, trace_identity_lo, trace_cursor,
            access_generation, captured_length, output_capacity): return 1
    _hal_file_read_buffer_v3_raw(access_generation, fixture_id,
        captured_status, error_domain,
        error_code, error_detail, captured, captured_length, output,
        output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor,
        trace_length, trace_capacity)

# Stream, environment, and randomness use the same sealed owner.  Generating
# these leaves keeps the operation constant at compile time and avoids a hot
# lookup or indirect dispatch.
@inline
fn _hal_stream_read_buffer_v3_raw(access_generation: i64,
        fixture_id: i64, captured_status: i32,
        error_domain: i32, error_code: i64, error_detail: i64,
        captured: *u8, captured_length: i64, output: *mut u8,
        output_capacity: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        trace_length: i64, trace_capacity: i64) -> i32:
    _rt_hal_buffer_call_v3(1004, fixture_id, captured_status, error_domain,
        error_code, error_detail, captured, captured_length, output,
        output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor,
        trace_length, trace_capacity)

@inline
fn rt_hal_stream_read_buffer_direct_v3(access_generation: i64, fixture_id: i64, captured_status: i32, error_domain: i32, error_code: i64, error_detail: i64, captured: *u8, captured_length: i64, output: *mut u8, output_capacity: i64, trace_identity_hi: i64, trace_identity_lo: i64, trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
    _rt_hal_buffer_direct_call_v3(1004, fixture_id, captured_status, error_domain, error_code, error_detail, captured, captured_length, output, output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor, trace_length, trace_capacity)
@inline
fn rt_hal_stream_read_buffer_compare_v3(access_generation: i64, fixture_id: i64, captured_status: i32, error_domain: i32, error_code: i64, error_detail: i64, captured: *u8, captured_length: i64, output: *mut u8, output_capacity: i64, trace_identity_hi: i64, trace_identity_lo: i64, trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
    _rt_hal_buffer_compare_call_v3(1004, fixture_id, captured_status, error_domain, error_code, error_detail, captured, captured_length, output, output_capacity, trace_identity_hi, trace_identity_lo, trace_cursor, trace_length, trace_capacity)

@rt(hal, operation: io.stream.read.buffer_v3, providers: pure+c+rust,
    capabilities: 5, comparator: 3, normalizer: 2, effects: replay_only,
    request_bytes: 32, result_bytes: 32, trace_operations: 1,
    trace_bytes: 32, diff_rows: 3, report_bytes: 256, log_bytes: 256,
    deadline_ticks: 1000, error_schema: 2, environment_schema: 1,
