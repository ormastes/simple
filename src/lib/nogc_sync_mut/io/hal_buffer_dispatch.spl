@inline
fn _hal_stream_write_buffer_v3_raw(access_generation: i64, fixture_id: i64, captured_status: i32, error_domain: i32, error_code: i64, error_detail: i64, captured: *u8, captured_length: i64, output: *mut u8, output_capacity: i64, trace_identity_hi: i64, trace_identity_lo: i64, trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
