# Untagged production entry points.  Each owns the complete transition from a
# planned instruction through physical execution and one-shot tagged replay.
# The captured pointer is derived from the same array passed to the executor,
# so callers cannot substitute bytes after presenting an execution receipt.
fn hal_file_read_buffer_executed_v3(owner: RtHalBufferExecutedAccessOwnerV3,
        extraction: RtHalAutomaticExtractionReceiptV1,
        executor: EnvPhysicalExecutorPortV1, policy: EnvExecutorPolicyV1,
        argument_bytes: [u8], captured_bytes: [u8], output_bytes: [u8],
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64, trace_capacity: i64) -> i32:
    if output_bytes.len() <= 0
            or output_bytes.len() > RT_HAL_BUFFER_MAX_BYTES_V3: return 1
    val executed = owner.execute(1001, extraction, executor, policy,
        argument_bytes, captured_bytes, trace_identity_hi, trace_identity_lo,
        trace_cursor, trace_length, trace_capacity)
    if executed.0 <= 0: return 1
    hal_file_read_buffer_v3(executed.0, extraction.instruction.invocation_id,
        0, 0, 0, 0,
        captured_bytes.ptr(), executed.1,
        output_bytes.ptr() as *mut u8, output_bytes.len(), trace_identity_hi,
        trace_identity_lo, trace_cursor, trace_length, trace_capacity)

