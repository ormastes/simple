"""Typed observation of the bytes mapped as this Linux process image.

This owner reports only the kernel image digest. It does not identify the
compiler source tree, linked providers, target triple, or a managed producer.
Other hosts and unreadable images fail closed until they have an in-process
kernel image owner.
"""

use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.io_runtime.{platform_name}
use std.nogc_sync_mut.concurrent.mutex.{
    Mutex, mutex_new_gate, mutex_lock_gate, mutex_unlock_gate
}
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}

pub struct KernelImageDigestV1:
    sha256: text

val _KERNEL_IMAGE_DIGEST_UNINITIALIZED_V1: text = "uninitialized"
val _KERNEL_IMAGE_DIGEST_UNAVAILABLE_V1: text = "unavailable"
var _kernel_image_digest_gate_v1: Mutex = mutex_new_gate(0)
var _kernel_image_digest_status_v1: text = _KERNEL_IMAGE_DIGEST_UNINITIALIZED_V1
var _kernel_image_digest_value_v1: text = ""
var _kernel_image_digest_error_v1: text = ""

fn _kernel_image_digest_capture_v1() -> (text, text, text):
    if platform_name() != "linux":
        return (_KERNEL_IMAGE_DIGEST_UNAVAILABLE_V1, "",
            "current kernel image digest is unavailable on this host")
    val observed = file_hash_sha256("/proc/self/exe")
    if observed == nil:
        return (_KERNEL_IMAGE_DIGEST_UNAVAILABLE_V1, "",
            "current kernel image digest is unreadable")
    val digest = observed.unwrap()
    if not sha256_lower_hex_valid(digest):
        return (_KERNEL_IMAGE_DIGEST_UNAVAILABLE_V1, "",
            "current kernel image digest is not canonical lowercase SHA-256")
    ("available", digest, "")

pub fn kernel_image_digest_v1() -> Result<KernelImageDigestV1, text>:
    # Keep capture and publication under one process-local gate: a concurrent
    # caller cannot observe an initialized state before the result is stored.
    val locked = mutex_lock_gate(_kernel_image_digest_gate_v1)
    if locked == nil:
        return Err("current kernel image digest owner lock is unavailable")
    if _kernel_image_digest_status_v1 == _KERNEL_IMAGE_DIGEST_UNINITIALIZED_V1:
        val (status, digest, error) = _kernel_image_digest_capture_v1()
        _kernel_image_digest_value_v1 = digest
        _kernel_image_digest_error_v1 = error
        _kernel_image_digest_status_v1 = status
    val status = _kernel_image_digest_status_v1
    val digest = _kernel_image_digest_value_v1
    val error = _kernel_image_digest_error_v1
    val unlocked = mutex_unlock_gate(_kernel_image_digest_gate_v1, 0)
    if unlocked != 1:
        return Err("current kernel image digest owner lock release failed")
    if status == "available":
        Ok(KernelImageDigestV1(sha256: digest))
    else:
        Err(error)

export KernelImageDigestV1, kernel_image_digest_v1
