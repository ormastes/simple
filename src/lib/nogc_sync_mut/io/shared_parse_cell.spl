# One bounded, same-handle, no-follow host read for immutable parser cells.
# All key/payload semantics and corrupt-entry rejection stay in pure Simple.
@unsafe(reason: "bounded no-follow shared parse cell host read", capabilities: [ffi])
extern fn rt_shared_parse_cell_read_v1(path: text, max_bytes: i64) -> text

pub fn shared_parse_cell_read_nofollow_v1(path: text, max_bytes: i64) -> text:
    if path == "" or max_bytes <= 0 or max_bytes > 33554432:
        return ""
    unsafe(capabilities: [ffi]):
        rt_shared_parse_cell_read_v1(path, max_bytes)

export shared_parse_cell_read_nofollow_v1
