# Owned Winit input records shared by the raw wrapper and native probes.
#
# This module deliberately has no rt_winit_* extern dependency. The event
# wrapper copies borrowed runtime text first, then uses this proven mut-output
# channel so records never cross a nested aggregate return boundary.

struct WinitInputEvent:
    kind: i64
    keycode: i64
    pressed: bool
    committed_text: text

pub fn winit_input_event_record_into(
    mut events_out: [WinitInputEvent], mut event_kinds_out: [i64],
    kind: i64, keycode: i64, pressed: bool, committed_text: text
) -> i64:
    val event = WinitInputEvent(
        kind: kind, keycode: keycode, pressed: pressed,
        committed_text: committed_text)
    events_out.push(event)
    # Preserve the legacy kind-only view from this exact appended record.
    event_kinds_out.push(event.kind)
    events_out.len().to_i64()
