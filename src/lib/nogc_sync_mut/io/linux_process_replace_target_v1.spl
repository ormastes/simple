# Supported LP64 little-endian kernel ports. Source references pinned Linuxv6.12:
# kernel/fork.c blob22f43721d031d48fd5be2606e86642334be9735f;
# include/uapi/asm-generic/unistd.h, arch/x86/entry/syscalls/syscall_64.tbl,
# arch/arm64/include/uapi/asm/signal.h and include/uapi/asm-generic/signal.h.
# arm64 explicitly defines SA_RESTORER: BOTH kernel sigaction layouts are32bytes,
# handler0/flags8/restorer16/mask24, kernel sigsetsize8. No native qualification.
pub(package) fn linux_replace_unshare_number_v1() -> i64:
    @when(arch="x86_64"):
    272
    @elif(arch="aarch64"):
    97
    @else:
    -1
    @end
pub(package) fn linux_replace_sigaction_number_v1() -> i64:
    @when(arch="x86_64"):
    13
    @elif(arch="aarch64"):
    134
    @else:
    -1
    @end
pub(package) fn linux_replace_sigmask_number_v1() -> i64:
    @when(arch="x86_64"):
    14
    @elif(arch="aarch64"):
    135
    @else:
    -1
    @end
pub(package) fn linux_replace_getdents_number_v1() -> i64:
    @when(arch="x86_64"):
    217
    @elif(arch="aarch64"):
    61
    @else:
    -1
    @end
pub(package) fn linux_replace_machine_v1() -> i64:
    @when(arch="x86_64"):
    62
    @elif(arch="aarch64"):
    183
    @else:
    -1
    @end

pub(package) fn linux_replace_architecture_v1() -> text:
    @when(arch="x86_64"):
    "linux-x86_64"
    @elif(arch="aarch64"):
    "linux-aarch64"
    @else:
    "unsupported"
    @end
