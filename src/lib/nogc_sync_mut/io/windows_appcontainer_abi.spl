# Win64 userenv/AppContainer profile boundary for the SOSIX app sandbox (lane W2). Pointer
# slots are i64 and the HRESULT is i32, exactly as the seed registers them
# (compiler interpreter_extern/windows_abi.rs). Kept outside sosix/windows so the platform
# variant gate does not count the extern names as per-variant public API.
@abi("system")
@unsafe(reason: "userenv create of a per-scope AppContainer profile, SID returned in an owned slot", capabilities: [ffi, raw_ptr])
extern fn CreateAppContainerProfile(name: i64, display_name: i64, description: i64, capabilities: i64, capability_count: u32, sid_out: i64) -> i32
@abi("system")
@unsafe(reason: "userenv delete of the per-scope AppContainer profile", capabilities: [ffi, raw_ptr])
extern fn DeleteAppContainerProfile(name: i64) -> i32
@abi("system")
@unsafe(reason: "release of a SID that userenv allocated", capabilities: [ffi, raw_ptr])
extern fn FreeSid(sid: i64) -> i64

export CreateAppContainerProfile, DeleteAppContainerProfile, FreeSid
