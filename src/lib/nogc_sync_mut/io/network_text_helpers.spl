# Internal network session codec helpers; transports share the same strict codec.
use std.common.encoding.external_text.{Encoding, BomPolicy, ExternalFormat, CodecError, CodecErrorKind, external_codec_error}
use std.common.encoding.host_text_boundary_v1.{HostTextByteSpanV1, host_validate_text_span_v1}
use std.common.string_core.{str_len}
use std.common.text_bytes.{boxed_text_bytes_checked, text_byte_buffer}
use std.nogc_sync_mut.io.text_session.{TextSessionCodec}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_external_from_internal, io_external_bytes}

fn network_read_format(codec: TextSessionCodec) -> ExternalFormat:
    ExternalFormat(encoding: codec.read_encoding(), byte_order: codec.read_byte_order(), bom: codec.read_bom())

fn network_write_format(codec: TextSessionCodec) -> ExternalFormat:
    ExternalFormat(encoding: codec.write_encoding(), byte_order: codec.write_byte_order(), bom: codec.write_bom())

fn network_text_limit(reason: text) -> TextIoError:
    TextIoError.Codec(CodecError(kind: CodecErrorKind.CapacityOverflow, byte_offset: -1, reason: reason))

fn network_text_encode(value: text, format: ExternalFormat, limit: i64) -> Result<[u8], TextIoError>:
    # Metadata preflight bounds extraction before allocation. UTF-16 cannot
    # encode valid UTF-8 input in fewer than half as many bytes.
    val count = str_len(value)
    if limit <= 0 or count < 0 or count > limit * 2:
        return Err(network_text_limit("network text exceeds output byte limit; split at an application message boundary"))
    val input = match boxed_text_bytes_checked(value):
        case Ok(bytes): bytes
        case Err(error): return Err(TextIoError.Codec(CodecError(kind: CodecErrorKind.AllocationFailed, byte_offset: -1, reason: "network text extraction failed")))
    val span = HostTextByteSpanV1(prefix: [], bytes: input, start: 0, end: input.len())
    match host_validate_text_span_v1(span, "utf-8"):
        case Err(error): return Err(TextIoError.Codec(external_codec_error(error, 0)))
        case Ok(_): ()
    # Size accounting only, after canonical validation; no scalar decoder.
    var encoded_size = count
    if format.encoding == Encoding.Utf16:
        encoded_size = 0
        for byte in input:
            if byte >= 0xF0: encoded_size = encoded_size + 4
            elif byte < 0x80 or byte >= 0xC0: encoded_size = encoded_size + 2
    if format.bom == BomPolicy.Require:
        encoded_size = encoded_size + (if format.encoding == Encoding.Utf8: 3 else: 2)
    if encoded_size > limit:
        return Err(network_text_limit("encoded network text exceeds output byte limit; split at an application message boundary"))
    val external = io_external_from_internal(value, format)?
    if external.encoded_byte_length() != encoded_size:
        return Err(TextIoError.Codec(CodecError(kind: CodecErrorKind.InternalInvariant, byte_offset: -1, reason: "network encoded size disagrees with validated measurement")))
    io_external_bytes(external)

fn network_text_slice(bytes: [u8], start: i64, end: i64) -> Result<[u8], TextIoError>:
    var output = match text_byte_buffer(end - start):
        case Ok(buffer): buffer
        case Err(error): return Err(TextIoError.Codec(CodecError(kind: CodecErrorKind.AllocationFailed, byte_offset: -1, reason: "network send window allocation failed")))
    for index in start..end: output.push(bytes[index])
    Ok(output)

export network_text_limit, network_text_encode, network_text_slice, network_read_format, network_write_format
