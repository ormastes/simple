"""Length-aware positional and append I/O for declared external text.

Raw bytes remain binary. Only the shared codec crosses the internal text seam.
The bounded foreign buffer is owned for exactly one pread/pwrite operation.
"""

use std.common.encoding.external_text.{ExternalText, ExternalFormat}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_external_text, io_external_from_internal, io_external_bytes}
use std.nogc_sync_mut.fs.host_path.{host_path_native}
use std.nogc_sync_mut.sffi.fs.{io_file_open, io_file_close, io_file_write_all, file_pread_fd, file_pwrite_fd}
use std.nogc_sync_mut.sffi.bounded_bytes.{FOREIGN_BYTES_LIMIT, foreign_bytes_allocate,
    foreign_bytes_copy_in, foreign_bytes_copy_out, foreign_bytes_release}

fn external_file_range_valid(offset: i64, size: i64) -> bool:
    offset >= 0 and size >= 0 and offset <= 9223372036854775807 - size

fn external_file_read_bytes_at(path: text, offset: i64, size: i64) -> Result<[u8], TextIoError>:
    if not external_file_range_valid(offset, size):
        return Err(TextIoError.Io("invalid positional byte range"))
    # Preserve the existing zero-size positional-read convention: no open.
    if size == 0:
        return Ok([])
    val descriptor = io_file_open(host_path_native(path), 0)
    if descriptor < 0:
        return Err(TextIoError.Io("positioned file open failed: {path}"))
    if descriptor > 2147483647:
        io_file_close(descriptor)
        return Err(TextIoError.Io("positioned descriptor exceeds provider range"))
    var bytes: [u8] = []
    var failure: TextIoError? = nil
    while bytes.len() < size:
        val remaining = size - bytes.len()
        val requested = if remaining > FOREIGN_BYTES_LIMIT: FOREIGN_BYTES_LIMIT else: remaining
        var address: i64 = 0
        var received: i64 = -1
        var chunk: [u8] = []
        unsafe(capabilities: [ffi, raw_ptr]):
            address = foreign_bytes_allocate(requested)
            if address != 0:
                received = file_pread_fd(descriptor.to_i32(), address, requested, offset + bytes.len())
                if received >= 0 and received <= requested:
                    chunk = foreign_bytes_copy_out(address, received)
                foreign_bytes_release(address)
        if address == 0:
            failure = TextIoError.Io("positioned read allocation failed")
            break
        if received < 0:
            failure = TextIoError.Native(received, "positioned read failed")
            break
        if received > requested or chunk.len() != received:
            failure = TextIoError.Io("positioned read returned an invalid byte extent")
            break
        val expected = bytes.len() + received
        for byte in chunk:
            bytes = bytes.push(byte)
        if bytes.len() != expected:
            failure = TextIoError.Io("positioned read accumulation failed")
            break
        if received < requested:
            break
    val closed = io_file_close(descriptor)
    if val error = failure:
        return Err(error)
    if not closed:
        return Err(TextIoError.Io("positioned read descriptor close failed"))
    Ok(bytes)

fn external_file_write_bytes_at(path: text, offset: i64, bytes: [u8]) -> Result<i64, TextIoError>:
    if not external_file_range_valid(offset, bytes.len()):
        return Err(TextIoError.Io("invalid positional byte range"))
    # Legacy zero-size writes do not create a file.
    if bytes.len() == 0:
        return Ok(0)
    val descriptor = io_file_open(host_path_native(path), 2)
    if descriptor < 0:
        return Err(TextIoError.Io("positioned file open failed: {path}"))
    if descriptor > 2147483647:
        io_file_close(descriptor)
        return Err(TextIoError.Io("positioned descriptor exceeds provider range"))
    var written: i64 = 0
    var failure: TextIoError? = nil
    while written < bytes.len():
        val remaining = bytes.len() - written
        val requested = if remaining > FOREIGN_BYTES_LIMIT: FOREIGN_BYTES_LIMIT else: remaining
        val window = bytes[written:written + requested]
        var address: i64 = 0
        var count: i64 = -1
        unsafe(capabilities: [ffi, raw_ptr]):
            address = foreign_bytes_copy_in(window)
            if address != 0:
                count = file_pwrite_fd(descriptor.to_i32(), address, requested, offset + written)
                foreign_bytes_release(address)
        if address == 0:
            failure = TextIoError.Io("positioned write allocation failed")
            break
        if count < 0:
            failure = TextIoError.Native(count, "positioned write failed")
            break
        if count == 0 or count > requested:
            failure = TextIoError.Io("positioned write returned an invalid byte extent")
            break
        written = written + count
    val closed = io_file_close(descriptor)
    if val error = failure:
        return Err(error)
    if not closed:
        return Err(TextIoError.Io("positioned write descriptor close failed"))
    Ok(written)

fn file_read_external_text_at(path: text, offset: i64, size: i64, format: ExternalFormat) -> Result<ExternalText, TextIoError>:
    val admitted = io_external_text([], format)?
    val bytes = external_file_read_bytes_at(path, offset, size)?
    io_external_text(bytes, admitted.external_format())

fn file_write_external_text_at(path: text, offset: i64, value: ExternalText) -> Result<i64, TextIoError>:
    external_file_write_bytes_at(path, offset, io_external_bytes(value)?)

fn file_write_encoded_text_at(path: text, offset: i64, value: text, format: ExternalFormat) -> Result<i64, TextIoError>:
    val external = io_external_from_internal(value, format)?
    file_write_external_text_at(path, offset, external)

fn file_append_external_text(path: text, value: ExternalText) -> Result<(), TextIoError>:
    val bytes = io_external_bytes(value)?
    # Provider mode 3 is O_APPEND | O_CREAT, not size() followed by pwrite().
    val descriptor = io_file_open(host_path_native(path), 3)
    if descriptor < 0:
        return Err(TextIoError.Io("append file open failed: {path}"))
    val written = io_file_write_all(descriptor, bytes)
    val closed = io_file_close(descriptor)
    if not written:
        return Err(TextIoError.Io("append file byte write failed: {path}"))
    if not closed:
        return Err(TextIoError.Io("append file descriptor close failed"))
    Ok(())

fn file_append_encoded_text(path: text, value: text, format: ExternalFormat) -> Result<(), TextIoError>:
    val external = io_external_from_internal(value, format)?
    file_append_external_text(path, external)

export external_file_read_bytes_at, external_file_write_bytes_at
export file_read_external_text_at, file_write_external_text_at, file_write_encoded_text_at
export file_append_external_text, file_append_encoded_text
