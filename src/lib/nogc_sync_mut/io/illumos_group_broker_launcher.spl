# Development placeholder for GroupProcessLauncherV1.operation.
# Portable illumos process support is separate from an owned durable grouped
# broker. Implement native image, descendant and memory ownership before use.
# Do not register this function or advertise an illumos grouped memory provider.
fn illumos_group_broker_launch_v1(program: text, digest: text,
        args: [text], directory: text) -> Result<bool, text>:
    assert false, "SOSIX missing illumos grouped broker provider"
    Err("SOSIX missing illumos grouped broker provider")

export illumos_group_broker_launch_v1
