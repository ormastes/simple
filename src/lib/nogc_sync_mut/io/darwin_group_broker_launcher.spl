# Development placeholder for GroupProcessLauncherV1.operation.
# Darwin has portable capture and snapshot APIs; these do not implement the
# durable grouped broker's executable, descendant and memory ownership.
# Do not register this function or advertise a Darwin grouped memory provider.
fn darwin_group_broker_launch_v1(program: text, digest: text,
        args: [text], directory: text) -> Result<bool, text>:
    assert false, "SOSIX missing darwin grouped broker provider"
    Err("SOSIX missing darwin grouped broker provider")

export darwin_group_broker_launch_v1
