# Audio SFFI — miniaudio backend
#
# SFFI bindings for the miniaudio-based C runtime (runtime_audio.c).
# Provides engine init/shutdown, sound loading, playback control, and volume.
#
# The C side uses a static global ma_engine. Sound and playback ownership stays
# behind generation-counted integer handles.

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

# --- Engine lifecycle ---
extern fn rt_audio_init() -> i64
extern fn rt_audio_shutdown(engine_handle: i64) -> i64

# --- Sound loading ---
extern fn rt_audio_load_sound(path: text) -> i64
extern fn rt_audio_unload_sound(handle: i64)

# --- Playback ---
extern fn rt_audio_play(sound_handle: i64) -> i64
extern fn rt_audio_play_looped(sound_handle: i64) -> i64
extern fn rt_audio_play_pcm_f32(
    samples: [f32], channels: i64, sample_rate: i64
) -> i64
extern fn rt_audio_play_pcm_f64_raw(
    samples_addr: i64,
    sample_count: i64,
    channels: i64,
    sample_rate: i64
) -> i64
extern fn rt_audio_stop(playback_handle: i64)
extern fn rt_audio_pause(playback_handle: i64)
extern fn rt_audio_resume(playback_handle: i64)

# --- Volume ---
extern fn rt_audio_set_volume(playback_handle: i64, volume: f64)
extern fn rt_audio_set_master_volume(volume: f64)
extern fn rt_audio_get_master_volume() -> f64

# --- Query ---
extern fn rt_audio_is_playing(playback_handle: i64) -> i64
extern fn rt_audio_live_source_count() -> i64
extern fn rt_audio_live_playback_count() -> i64
extern fn rt_audio_live_device_count() -> i64
extern fn rt_audio_backend_name() -> text
extern fn rt_audio_backend_is_real() -> i64

# --- SDL2 queued device ---
extern fn rt_audio_sdl2_init() -> i64
extern fn rt_audio_sdl2_queue_pcm_f64_raw(
    handle: i64,
    samples_addr: i64,
    sample_count: i64,
    channels: i64,
    sample_rate: i64
) -> i64
extern fn rt_audio_sdl2_submitted_frames(handle: i64) -> i64
extern fn rt_audio_sdl2_queued_bytes(handle: i64) -> i64
extern fn rt_audio_sdl2_underrun_count(handle: i64) -> i64
extern fn rt_audio_sdl2_live_device_count() -> i64
extern fn rt_audio_sdl2_close(handle: i64) -> i64

# --- Spatial audio (3D positioning) ---
extern fn rt_audio_set_sound_position(handle: i64, x: f64, y: f64, z: f64)
extern fn rt_audio_set_spatialization_enabled(handle: i64, enabled: i64)
extern fn rt_audio_set_listener_position(x: f64, y: f64, z: f64)
extern fn rt_audio_set_listener_direction(x: f64, y: f64, z: f64)
extern fn rt_audio_set_listener_world_up(x: f64, y: f64, z: f64)
extern fn rt_audio_set_sound_min_distance(handle: i64, distance: f64)
extern fn rt_audio_set_sound_max_distance(handle: i64, distance: f64)

# --- Pitch control (for doppler effect) ---
@unsafe(reason: "raw miniaudio generation-handle status ABI; zero means invalid handle or non-finite/non-positive pitch", capabilities: [ffi])
extern fn rt_audio_set_pitch(sound_handle: i64, pitch: f64) -> i64

fn audio_set_pitch(sound_handle: i64, pitch: f64) -> bool:
    if sound_handle <= 0 or pitch <= 0.0:
        return false
    var status: i64 = 0
    unsafe(capabilities: [ffi]):
        status = rt_audio_set_pitch(sound_handle, pitch)
    status == 1

# --- Capture (recording) — miniaudio capture device -> WAV file sink ---
# Fail-closed: rt_audio_capture_start returns 0 (not a handle/success code)
# when no capture device is available (e.g. headless CI); callers must check
# the return value rather than assume success.
extern fn rt_audio_capture_start(path: text, sample_rate: i64, channels: i64) -> i64
extern fn rt_audio_capture_is_active() -> i64
extern fn rt_audio_capture_frame_count() -> i64
extern fn rt_audio_capture_stop() -> i64

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

struct AudioEngine:
    handle: i64
    is_valid: bool

fn audio_init() -> AudioEngine:
    val result = rt_audio_init()
    AudioEngine(handle: result, is_valid: result > 0)

fn audio_shutdown(engine: AudioEngine) -> bool:
    engine.is_valid and rt_audio_shutdown(engine.handle) != 0

struct AudioSource:
    handle: i64
    is_valid: bool

fn audio_load_sound(path: text) -> AudioSource:
    val h = rt_audio_load_sound(path)
    AudioSource(handle: h, is_valid: h > 0)

fn audio_unload_sound(source: AudioSource):
    if source.is_valid:
        rt_audio_unload_sound(source.handle)

struct AudioPlayback:
    handle: i64
    is_valid: bool

fn audio_play(source: AudioSource) -> AudioPlayback:
    if not source.is_valid:
        return AudioPlayback(handle: 0, is_valid: false)
    val h = rt_audio_play(source.handle)
    AudioPlayback(handle: h, is_valid: h > 0)

fn audio_play_looped(source: AudioSource) -> AudioPlayback:
    if not source.is_valid:
        return AudioPlayback(handle: 0, is_valid: false)
    val h = rt_audio_play_looped(source.handle)
    AudioPlayback(handle: h, is_valid: h > 0)

fn audio_play_pcm_f32(samples: [f32]) -> AudioPlayback:
    """Play owned 48-kHz stereo PCM through the active miniaudio device."""
    val h = rt_audio_play_pcm_f32(samples, 2, 48000)
    AudioPlayback(handle: h, is_valid: h > 0)

fn audio_play_pcm_f64_raw_handle(
    samples_addr: i64, sample_count: i64
) -> i64:
    """Array-free 48-kHz stereo PCM device boundary."""
    rt_audio_play_pcm_f64_raw(
        samples_addr, sample_count, 2, 48000
    )

fn audio_stop(playback: AudioPlayback):
    if playback.is_valid:
        rt_audio_stop(playback.handle)

fn audio_pause(playback: AudioPlayback):
    if playback.is_valid:
        rt_audio_pause(playback.handle)

fn audio_resume(playback: AudioPlayback):
    if playback.is_valid:
        rt_audio_resume(playback.handle)

fn audio_set_volume(playback: AudioPlayback, volume: f64):
    if playback.is_valid:
        rt_audio_set_volume(playback.handle, volume)

fn audio_set_master_volume(volume: f64):
    rt_audio_set_master_volume(volume)

fn audio_get_master_volume() -> f64:
    rt_audio_get_master_volume()

fn audio_is_playing(playback: AudioPlayback) -> bool:
    if not playback.is_valid:
        return false
    rt_audio_is_playing(playback.handle) != 0

fn audio_live_source_count() -> i64:
    rt_audio_live_source_count()

fn audio_live_playback_count() -> i64:
    rt_audio_live_playback_count()

fn audio_live_device_count() -> i64:
    rt_audio_live_device_count()

fn audio_backend_name() -> text:
    rt_audio_backend_name()

fn audio_backend_is_real() -> bool:
    rt_audio_backend_is_real() != 0

fn audio_sdl2_init() -> AudioEngine:
    val handle = rt_audio_sdl2_init()
    AudioEngine(handle: handle, is_valid: handle > 0)

fn audio_sdl2_queue_pcm_f64_raw(
    engine: AudioEngine, samples_addr: i64, sample_count: i64
) -> i64:
    if not engine.is_valid:
        return 0
    rt_audio_sdl2_queue_pcm_f64_raw(
        engine.handle, samples_addr, sample_count, 2, 48000
    )

fn audio_sdl2_live_device_count() -> i64:
    rt_audio_sdl2_live_device_count()

fn audio_sdl2_close(engine: AudioEngine) -> bool:
    engine.is_valid and rt_audio_sdl2_close(engine.handle) != 0

# --- Spatial wrappers ---

fn audio_set_sound_position(playback: AudioPlayback, x: f64, y: f64, z: f64):
    if playback.is_valid:
        rt_audio_set_sound_position(playback.handle, x, y, z)

fn audio_set_spatialization_enabled(playback: AudioPlayback, enabled: bool):
    if playback.is_valid:
        val flag: i64 = if enabled: 1 else: 0
        rt_audio_set_spatialization_enabled(playback.handle, flag)

fn audio_set_listener_position(x: f64, y: f64, z: f64):
    rt_audio_set_listener_position(x, y, z)

fn audio_set_listener_direction(x: f64, y: f64, z: f64):
    rt_audio_set_listener_direction(x, y, z)

fn audio_set_listener_world_up(x: f64, y: f64, z: f64):
    rt_audio_set_listener_world_up(x, y, z)

fn audio_set_sound_min_distance(playback: AudioPlayback, distance: f64):
    if playback.is_valid:
        rt_audio_set_sound_min_distance(playback.handle, distance)

fn audio_set_sound_max_distance(playback: AudioPlayback, distance: f64):
    if playback.is_valid:
        rt_audio_set_sound_max_distance(playback.handle, distance)

# --- Capture wrappers ---

struct AudioCapture:
    active: bool
    path: text

fn audio_capture_start(path: text, sample_rate: i64, channels: i64) -> AudioCapture:
    """Start recording from the default capture device to a WAV file at
    `path`. Fail-closed: if there is no capture device (or one fails to
    open), `active` is false and no file is created/left open — callers
    must check `active` rather than assume the recording started."""
    val ok = rt_audio_capture_start(path, sample_rate, channels)
    AudioCapture(active: ok != 0, path: path)

fn audio_capture_is_active() -> bool:
    rt_audio_capture_is_active() != 0

fn audio_capture_frame_count() -> i64:
    """Frames captured so far in the current session (0 if not active)."""
    rt_audio_capture_frame_count()

fn audio_capture_stop() -> i64:
    """Stop the current capture session and finalize the WAV file. Returns
    the total frame count written, or 0 if no capture was active."""
    rt_audio_capture_stop()

