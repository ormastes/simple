# Execution origin is opaque owner metadata, never a wire-supplied mode flag.
use std.nogc_sync_mut.io.windows_command_owner_v2.windows_command_thread_check_v2

pub fn windows_command_origin_matches_v4(retained_scripted: bool, supplied_scripted: bool) -> bool:
    retained_scripted == supplied_scripted

# On Windows all continuations share the canonical thread, including scripted
# fixtures, because their process-local registries are shared with native work.
# Only non-Windows explicit fixtures bypass the unavailable Windows barrier.
pub fn windows_command_registry_thread_v4(scripted: bool) -> Result<bool, text>:
    @when(os="windows"):
    val checked = windows_command_thread_check_v2()?
    Ok(true)
    @else:
    if scripted: Ok(true) else: Err("windows-command-native-domain-unavailable")
    @end
