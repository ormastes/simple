# Native cooperative Darwin snapshot owner. Explicit trusted profile only.
# Preconditions: trusted same-UID processes and temp ancestors; SIGCHLD default
# and exclusive wait ownership; descendants stay in the created process group.
# Fork-inherited registries reject all authority before touching the mutex.
# No immutable executable seal or escaped-descendant containment is provided.
# A copied platform-signed executable is unqualified; use an owned Mach-O.
@unsafe(reason: "native cooperative Darwin snapshot ABI; interpreter cannot acquire authority", capabilities: [ffi])
extern fn rt_sosix_darwin_snapshot_v1_capabilities_value() -> [i64]
@unsafe(reason: "native cooperative Darwin snapshot ABI; interpreter cannot acquire authority", capabilities: [ffi])
extern fn rt_sosix_darwin_snapshot_v1_start_value(profile: i64, invocation: [text], environment: [text], limits: [i64]) -> [i64]
@unsafe(reason: "native cooperative Darwin snapshot ABI; interpreter cannot acquire authority", capabilities: [ffi])
extern fn rt_sosix_darwin_snapshot_v1_poll_value(handle: i64, wait_ns: i64) -> [i64]
@unsafe(reason: "native cooperative Darwin snapshot ABI; interpreter cannot acquire authority", capabilities: [ffi])
extern fn rt_sosix_darwin_snapshot_v1_cancel_value(handle: i64) -> [i64]
@unsafe(reason: "native cooperative Darwin snapshot ABI; interpreter cannot acquire authority", capabilities: [ffi])
extern fn rt_sosix_darwin_snapshot_v1_output_value(handle: i64, stream: i64) -> [i64]
@unsafe(reason: "native cooperative Darwin snapshot ABI; interpreter cannot acquire authority", capabilities: [ffi])
extern fn rt_sosix_darwin_snapshot_v1_ack_value(handle: i64) -> i64

# [version, available, cooperative, sealed, escaped_containment, exclusive_wait,
#  error, path_based_snapshot, group_only, platform_signed_copy_qualified]
pub fn darwin_snapshot_capabilities() -> [i64]:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_snapshot_v1_capabilities_value()

# Explicit profile 1; other profiles reject before executable acquisition.
# invocation=[absolute executable,cwd,args...], environment is complete.
# limits=[wall_ns,term_grace_ns,cleanup_ns,stdout_cap,stderr_cap].
# Returns [version,error,opaque_handle]. Never pass a PID as handle.
pub fn darwin_snapshot_start(profile: i64, invocation: [text], environment: [text], limits: [i64]) -> [i64]:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_snapshot_v1_start_value(profile, invocation, environment, limits)

# [version,error,handle,frozen,reaped,group_retired,exit_code,timed_out,
#  cancelled,term_sent,kill_sent,stdout_seen,stderr_seen,stdout_kept,stderr_kept,
#  stdout_error,stderr_error,cleanup_error]. Errors retain ownership; retry or
# cancel and poll until frozen. wait_ns is bounded to 250000000.
pub fn darwin_snapshot_poll(handle: i64, wait_ns: i64) -> [i64]:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_snapshot_v1_poll_value(handle, wait_ns)

pub fn darwin_snapshot_cancel(handle: i64) -> [i64]:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_snapshot_v1_cancel_value(handle)

# Output envelope [version,error,byte...]; stream 1=stdout, 2=stderr.
# Frozen captures only; errno distinguishes stale, busy and invalid stream.
# Success has two header words even for an empty capture; NUL is preserved.
pub fn darwin_snapshot_output(handle: i64, stream: i64) -> [i64]:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_snapshot_v1_output_value(handle, stream)

# Returns errno; succeeds only after frozen/reaped/group-retired. Invalidates
# handle even if removal of the owned image reports a cleanup error. Collection is replayable before ack.
pub fn darwin_snapshot_ack(handle: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_sosix_darwin_snapshot_v1_ack_value(handle)
