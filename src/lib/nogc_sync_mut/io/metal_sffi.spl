# Apple Metal SFFI Bindings
#
# SFFI pattern for Apple GPU compute + graphics via Metal.
# Note: These require macOS/iOS with Metal-capable hardware.

# ============================================================================
# Tier 1: Extern Declarations (Raw SFFI)
# ============================================================================

# Device
@unsafe(reason: "raw Metal runtime initialization ABI", capabilities: [ffi])
extern fn rt_metal_init() -> bool
@unsafe(reason: "raw Metal runtime availability ABI", capabilities: [ffi])
extern fn rt_metal_is_available() -> bool
@unsafe(reason: "raw Metal device-count ABI; negative return is failure", capabilities: [ffi])
extern fn rt_metal_device_count() -> i64
@unsafe(reason: "raw Metal runtime-owned device-name text ABI", capabilities: [ffi])
extern fn rt_metal_device_name(device: i64) -> text
@unsafe(reason: "raw Metal device-memory count ABI; negative return is failure", capabilities: [ffi])
extern fn rt_metal_device_memory(device: i64) -> i64
@unsafe(reason: "raw Metal device-handle ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_metal_create_device(device: i64) -> i64
@unsafe(reason: "raw Metal device-handle ABI", capabilities: [ffi])
extern fn rt_metal_destroy_device(device: i64) -> bool
@unsafe(reason: "raw Metal runtime-owned device-identity text ABI", capabilities: [ffi])
extern fn rt_metal_device_identity(device: i64) -> text
@unsafe(reason: "raw Metal device-capability ABI", capabilities: [ffi])
extern fn rt_metal_device_supports_metal3(device: i64) -> bool

