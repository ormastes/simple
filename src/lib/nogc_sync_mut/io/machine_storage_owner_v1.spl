# Platform selection inside library-owned opaque storage. No caller chooses a
# platform, native root, UID, policy, provider, budget or backend store.
use std.nogc_sync_mut.io.windows_machine_policy_owner_v1.*
use std.nogc_sync_mut.io.linux_machine_policy_owner_v1.*
use std.nogc_sync_mut.database.wal.WalEntry
use std.nogc_sync_mut.database.wal_segmented.DatabaseWalRevisionV1
use std.common.contracts.container.local_principal_v1.MachineLocalPrincipalSnapshotV1
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxInstalledFreshEpochOwnerV1
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.*
use std.common.contracts.container.machine_policy_v1.machine_container_policy_decode_v1
use std.common.crypto.sha256.sha256_text
use std.common.text_bytes.{bytes_to_text, utf8_bytes_valid}

enum MachinePolicyBackendV1:
    Linux(LinuxMachinePolicyOwnerV1)
    Windows(WindowsMachinePolicyOwnerV1)

# milestone_0021: pub only so the async provider accessor linux_workspace_root_borrow_from_storage_v3 can
# match it without a sync -> providers import; that accessor is its only outside matcher (structural pin).
pub enum MachineStorageBackendV1:
    Linux(LinuxMachineStorageV1)
    Windows(WindowsMachineStorageV1)

pub class MachinePolicyOwnerV1:
    backend: MachinePolicyBackendV1

    pub fn selected_backend_v1() -> text:
        match self.backend:
            case MachinePolicyBackendV1.Linux(_): "linux-podman"
            case MachinePolicyBackendV1.Windows(_): "windows-docker-process"

    pub fn read_policy_v1() -> Result<[u8], text>:
        match self.backend:
            case MachinePolicyBackendV1.Linux(owner): owner.read_policy_v1()
            case MachinePolicyBackendV1.Windows(owner): owner.read_policy_v1()

    # Metadata only, revalidated by the actual Linux owner. The caller must
    # compare selected installed provider expected_uid to this actual UID.
    pub fn actual_linux_process_context_v1() -> Result<LinuxMachineProcessContextV1, text>:
        match self.backend:
            case MachinePolicyBackendV1.Linux(owner): owner.actual_process_context_v1()
            case MachinePolicyBackendV1.Windows(_): Err("machine-policy-linux-process-context-unsupported")

    pub fn actual_process_principal_v1() -> Result<MachineLocalPrincipalSnapshotV1, text>:
        match self.backend:
            case MachinePolicyBackendV1.Linux(owner): owner.actual_process_principal_v1()
            case MachinePolicyBackendV1.Windows(_): Err("machine-policy-windows-principal-requires-native-token-owner")

    # Rejected leaves this reader owned by the caller. Both other outcomes
    # transfer the entire reader into the returned storage cleanup capsule.
    pub fn open_storage_v1() -> MachineStorageOpenV1:
        match self.backend:
            case MachinePolicyBackendV1.Linux(owner):
                match owner.open_storage_v1():
                    case LinuxMachineStorageOpenV1.Rejected(reason): MachineStorageOpenV1.Rejected(reason)
                    case LinuxMachineStorageOpenV1.CleanupRequired(storage, reason):
                        MachineStorageOpenV1.CleanupRequired(MachineStorageOwnerV1(backend: MachineStorageBackendV1.Linux(storage)), reason)
                    case LinuxMachineStorageOpenV1.Ready(storage):
                        MachineStorageOpenV1.Ready(MachineStorageOwnerV1(backend: MachineStorageBackendV1.Linux(storage)))
            case MachinePolicyBackendV1.Windows(owner):
                match owner.open_storage_v1():
                    case WindowsMachineStorageOpenV1.Rejected(reason): MachineStorageOpenV1.Rejected(reason)
                    case WindowsMachineStorageOpenV1.CleanupRequired(storage, reason):
                        MachineStorageOpenV1.CleanupRequired(MachineStorageOwnerV1(backend: MachineStorageBackendV1.Windows(storage)), reason)
                    case WindowsMachineStorageOpenV1.Ready(storage):
                        MachineStorageOpenV1.Ready(MachineStorageOwnerV1(backend: MachineStorageBackendV1.Windows(storage)))

    pub fn close_v1() -> text:
        match self.backend:
            case MachinePolicyBackendV1.Linux(owner): owner.close_v1()
            case MachinePolicyBackendV1.Windows(owner): owner.close_v1()

pub enum MachinePolicyOpenV1:
    Rejected(reason: text)
    CleanupRequired(owner: MachinePolicyOwnerV1, reason: text)
    Ready(owner: MachinePolicyOwnerV1)

pub class MachineStorageOwnerV1:
    backend: MachineStorageBackendV1

    pub fn policy_bytes_v1() -> Result<[u8], text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.policy_bytes_v1()
            case MachineStorageBackendV1.Windows(owner): owner.policy_bytes_v1()

    pub fn physical_capacity_v1() -> Result<(i64, i64), text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.physical_capacity_v1()
            case MachineStorageBackendV1.Windows(owner): owner.physical_capacity_v1()

    pub fn bind_policy_v1(expected_bytes: text) -> Result<text, text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.bind_policy_v1(expected_bytes)
            case MachineStorageBackendV1.Windows(owner): owner.bind_policy_v1(expected_bytes)

    pub fn wal_head_v1() -> Result<text, text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.wal_head_v1()
            case MachineStorageBackendV1.Windows(owner): owner.wal_head_v1()

    pub fn wal_revision_v1(digest: text) -> Result<DatabaseWalRevisionV1, text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.wal_revision_v1(digest)
            case MachineStorageBackendV1.Windows(owner): owner.wal_revision_v1(digest)

    pub fn wal_segment_v1(revision: DatabaseWalRevisionV1) -> Result<[WalEntry], text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.wal_segment_v1(revision)
            case MachineStorageBackendV1.Windows(owner): owner.wal_segment_v1(revision)

    pub fn wal_commit_v1(expected_parent: text, entries: [WalEntry]) -> Result<DatabaseWalRevisionV1, text>:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.wal_commit_v1(expected_parent, entries)
            case MachineStorageBackendV1.Windows(owner): owner.wal_commit_v1(expected_parent, entries)

    # Only this typed proof-bearing port can request fresh schema publication.
    # The platform mechanism returns data; neither it nor this revision mints
    # an admission/launch owner. Generic missing-CURRENT refusal is unchanged.
    pub fn fresh_epoch_head_v1(epoch: LinuxInstalledFreshEpochOwnerV1,
            record: MachineFreshEpochRecordV1) -> Result<text, text>:
        val checked = machine_storage_fresh_check_v1(self, epoch, record)?
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.fresh_epoch_head_v1(record)
            case MachineStorageBackendV1.Windows(_): Err("machine-fresh-epoch-linux-required")

    pub fn fresh_epoch_commit_v1(epoch: LinuxInstalledFreshEpochOwnerV1,
            record: MachineFreshEpochRecordV1) -> Result<DatabaseWalRevisionV1, text>:
        val checked = machine_storage_fresh_check_v1(self, epoch, record)?
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.fresh_epoch_commit_v1(record)
            case MachineStorageBackendV1.Windows(_): Err("machine-fresh-epoch-linux-required")

    # Only released/consumed-error positively confirm consumption. A generic
    # stale/unknown result is not proof of closure; the upper owner retains the
    # exact capsule. Never retry already confirmed-consumed descriptors.
    pub fn close_v1() -> text:
        match self.backend:
            case MachineStorageBackendV1.Linux(owner): owner.close_v1()
            case MachineStorageBackendV1.Windows(owner): owner.close_v1()

pub enum MachineStorageOpenV1:
    Rejected(reason: text)
    CleanupRequired(owner: MachineStorageOwnerV1, reason: text)
    Ready(owner: MachineStorageOwnerV1)

# Wraps one existing Linux storage capability after checking its actual
# installed policy. This performs no open, writer acquisition, WAL read, or
# native effect; failures return the same raw storage owner for its caller.
pub struct MachineLinuxStorageUpcastTurnV3:
    owner: Option<MachineStorageOwnerV1>
    retained: Option<LinuxMachineStorageV1>
    error: text

fn machine_linux_storage_upcast_error_v3(actual: LinuxMachineStorageV1,
        reason: text) -> MachineLinuxStorageUpcastTurnV3:
    MachineLinuxStorageUpcastTurnV3(owner: None, retained: Some(actual), error: reason)

pub fn machine_storage_from_linux_v3(actual: LinuxMachineStorageV1) -> MachineLinuxStorageUpcastTurnV3:
    val policy_bytes = match actual.policy_bytes_v1():
        case Ok(value): value
        case Err(reason): return machine_linux_storage_upcast_error_v3(actual, reason)
    if not utf8_bytes_valid(policy_bytes):
        return machine_linux_storage_upcast_error_v3(actual, "machine-storage-linux-policy-utf8")
    val source = bytes_to_text(policy_bytes)
    val policy = match machine_container_policy_decode_v1(source):
        case Ok(value): value
        case Err(reason): return machine_linux_storage_upcast_error_v3(actual, reason)
    var linux_providers = 0
    for provider in policy.providers:
        if provider.backend == "linux-podman": linux_providers = linux_providers + 1
    if linux_providers != 1:
        return machine_linux_storage_upcast_error_v3(actual, "machine-storage-linux-provider-selection")
    val capacity = match actual.physical_capacity_v1():
        case Ok(value): value
        case Err(reason): return machine_linux_storage_upcast_error_v3(actual, reason)
    if (capacity.0 <= 0 or capacity.1 <= 0 or
            policy.cpu_millis > capacity.0 or policy.memory_bytes > capacity.1):
        return machine_linux_storage_upcast_error_v3(actual, "machine-storage-linux-policy-capacity")
    MachineLinuxStorageUpcastTurnV3(
        owner: Some(MachineStorageOwnerV1(backend: MachineStorageBackendV1.Linux(actual))),
        retained: None, error: "")

fn machine_storage_fresh_check_v1(storage: MachineStorageOwnerV1, epoch: LinuxInstalledFreshEpochOwnerV1,
        record: MachineFreshEpochRecordV1) -> Result<(), text>:
    val valid = machine_fresh_epoch_record_validate_v1(record)?
    val actual = epoch.current_v1()?
    if (actual.owner_generation != record.epoch_generation or actual.epoch_id != record.epoch_id or
            actual.profile_digest != record.profile_digest or actual.machine_policy_digest != record.machine_policy_digest or
            actual.process_identity_digest != record.process_identity_digest or actual.manager_unique_name != record.manager_unique_name or
            actual.service_uid != record.service_uid or actual.service_gid != record.service_gid or
            actual.partition_identity_digest != record.partition_identity_digest or actual.store_identity_digest != record.store_identity_digest or
            actual.provider_policy_digest != record.provider_policy_digest or actual.observed_cpu_millis != record.observed_cpu_millis or
            actual.observed_memory_bytes != record.observed_memory_bytes or actual.reserved_cpu_millis != record.reserved_cpu_millis or
            actual.reserved_memory_bytes != record.reserved_memory_bytes or actual.outside_cpu_millis != record.outside_cpu_millis or
            actual.outside_memory_bytes != record.outside_memory_bytes or actual.usable_cpu_millis != record.usable_cpu_millis or
            actual.usable_memory_bytes != record.usable_memory_bytes):
        return Err("machine-fresh-epoch-actual-preparation-mismatch")
    val bytes = storage.policy_bytes_v1()?
    if not utf8_bytes_valid(bytes): return Err("machine-fresh-epoch-policy-utf8")
    val source = bytes_to_text(bytes)
    if sha256_text(source) != record.machine_policy_digest: return Err("machine-fresh-epoch-policy-binding")
    val policy = machine_container_policy_decode_v1(source)?
    if (policy.mode != "standalone" or policy.authority_id != record.authority_id or
            policy.physical_host_id != record.physical_host_id or policy.native_machine_id != record.native_machine_id or
            record.principal_id != "linux:uid:" + str(actual.service_uid) or not policy.local_principals.contains(record.principal_id)):
        return Err("machine-fresh-epoch-policy-scope")
    var providers = 0
    for provider in policy.providers:
        if provider.backend == "linux-podman":
            providers = providers + 1
            if provider.identity_digest != record.provider_identity_digest or sha256_text(provider.policy_bytes) != record.provider_policy_digest:
                return Err("machine-fresh-epoch-provider-policy-binding")
    if providers != 1: return Err("machine-fresh-epoch-provider-selection")
    val physical = storage.physical_capacity_v1()?
    val cpu = if physical.0 < policy.cpu_millis: physical.0 else: policy.cpu_millis
    val memory = if physical.1 < policy.memory_bytes: physical.1 else: policy.memory_bytes
    if record.capacity_cpu_millis != cpu or record.capacity_memory_bytes != memory:
        return Err("machine-fresh-epoch-actual-physical-capacity")
    Ok(())

pub fn machine_policy_open_v1() -> MachinePolicyOpenV1:
    @when(os="linux"):
    match linux_machine_policy_open_v1():
        case LinuxMachinePolicyOpenV1.Rejected(reason): MachinePolicyOpenV1.Rejected(reason)
        case LinuxMachinePolicyOpenV1.CleanupRequired(owner, reason):
            MachinePolicyOpenV1.CleanupRequired(MachinePolicyOwnerV1(backend: MachinePolicyBackendV1.Linux(owner)), reason)
        case LinuxMachinePolicyOpenV1.Ready(owner):
            MachinePolicyOpenV1.Ready(MachinePolicyOwnerV1(backend: MachinePolicyBackendV1.Linux(owner)))
    @elif(os="windows"):
    match windows_machine_policy_open_v1():
        case WindowsMachinePolicyOpenV1.Rejected(reason): MachinePolicyOpenV1.Rejected(reason)
        case WindowsMachinePolicyOpenV1.CleanupRequired(owner, reason):
            MachinePolicyOpenV1.CleanupRequired(MachinePolicyOwnerV1(backend: MachinePolicyBackendV1.Windows(owner)), reason)
        case WindowsMachinePolicyOpenV1.Ready(owner):
            MachinePolicyOpenV1.Ready(MachinePolicyOwnerV1(backend: MachinePolicyBackendV1.Windows(owner)))
    @else:
    MachinePolicyOpenV1.Rejected("machine-policy-host-unsupported")
    @end
