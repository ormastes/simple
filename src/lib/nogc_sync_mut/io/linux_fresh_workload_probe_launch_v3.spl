# Genuine borrowed successor supporting projection only. Upper separately
# consumes its original same-WAL once-only action/helper permit before spawn.
# No registry, native resources, journal, close, raw getter or enum widening.
use std.common.contracts.container.linux_fresh_workload_probe_v3.*
use std.common.build_manager.group_process_stream_protocol_v2.GroupProcessStreamLaunchV2
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxFreshEpochSuccessorCustodyV1

pub fn linux_fresh_workload_probe_bind_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        command: LinuxFreshWorkloadProbeCommandV3, template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    linux_fresh_workload_probe_command_validate_v3(command)?
    val before = custody.current_host_context_v2()?
    val actual = custody.bind_workload_launch_v2(command.workload, template)?
    val projected = linux_fresh_workload_probe_project_v3(actual, command)?
    val after = custody.current_host_context_v2()?
    if before != after: return Err("fresh-probe-original-custody-changed")
    Ok(projected)

pub fn linux_fresh_workload_probe_validate_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        command: LinuxFreshWorkloadProbeCommandV3, template: GroupProcessStreamLaunchV2) -> Result<(), text>:
    val actual = linux_fresh_workload_probe_bind_v3(custody, command, template)?
    if actual != template: return Err("fresh-probe-installed-launch-binding-differs")
    Ok(())
