# The ONE signed Linux service enrollment verifier. Moved from orchestration
# (signing step 5) so the protected-storage owner can require its proof without
# importing orchestration. This module must never import the protected root
# reader, native identity, the journal, or owner_health: each reaches
# owner_health, and owner_health imports this module (import-cycle table in
# .spipe/.../milestone_0015_verifier_io/DESIGN.md). Records stay DATA; neither a
# record nor a proof constructs a native provider owner or a writer.
use std.common.contracts.orchestration.host_linux_service_enrollment_v3.*
use std.nogc_sync_mut.io.host_private_metadata_v2.{HostPrivateMetadataPinsV2, HostPrivateMetadataV2, host_private_metadata_decode_v2}
use std.nogc_sync_mut.io.host_enrollment_v1.{HostEnrollmentCredentialV1, host_enrollment_credential_decode_v1, host_enrollment_credential_encode_v1}
use std.nogc_sync_mut.io.local_authority_policy_v1.{local_authority_policy_decode_v1, host_local_context_v1}
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.distributed_verify_grant_approval_from_snapshot_v2
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex
use std.common.base_encoding.utilities.base_encoding_text_to_bytes
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamLaunchV2, group_process_stream_template_decode_v3,
    group_process_stream_template_encode_v3}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub struct HostLinuxServiceRecordsV4:
    binding: HostLinuxServiceEnrollmentBindingV3
    metadata: HostPrivateMetadataV2
    credential: HostEnrollmentCredentialV1
    claim_digest: text
    authorized_at: i64
    # milestone_0021 F15 (B): the statically checked, enrollment-pinned agent helper template.
    agent_helper_template: Option<GroupProcessStreamLaunchV2> = None

# Exact installed bytes, already acquired by the caller's protected reader.
pub struct HostLinuxServiceRecordSourcesV4:
    enrollment: text
    policy: text
    configuration: text
    engine_policy: text
    broker_policy: text
    parent_policy: text
    credential: text
    claim: text
    root_record: text
    agent_helper_template: text

fn service_record_fields_v4(source: text, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if source.byte_len() == 0 or source.byte_len() > 16384: return Err("linux-host-service-record-size")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 16384, max_depth: 2,
            max_nodes: 64, max_rows: 0, max_cells: 0, max_columns: 16)):
        case Ok(value): value
        case Err(issue): return Err("linux-host-service-record-syntax:" + issue.code)
    if sdn_encode_canonical(parsed.value) + "\n" != source: return Err("linux-host-service-record-noncanonical")
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("linux-host-service-record-object-required")
    for name in names:
        if not fields.contains_key(name): return Err("linux-host-service-record-missing-field:" + name)
    for name in fields.keys():
        if not names.contains(name): return Err("linux-host-service-record-unknown-field:" + name)
    Ok(fields)

pub fn host_linux_service_root_path_v4(binding: HostLinuxServiceEnrollmentBindingV3) -> Result<text, text>:
    Ok(binding.machine_parent + "/host-root-" + host_linux_service_enrollment_digest_v3(binding)?)

pub fn host_linux_service_claim_name_v4(binding: HostLinuxServiceEnrollmentBindingV3) -> text:
    "linux-service-claim-" + sha256_text(binding.native_machine_id) + ".sdn"

# DATA encoders only. The signed installer acquires original protected parent
# resources and verifies current signatures BEFORE it publishes these bytes.
pub fn host_linux_service_claim_bytes_v4(binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, nonce: text, authorized_at: i64) -> Result<text, text>:
    if nonce.byte_len() != 64 or not builder_digest_valid_v1(nonce): return Err("linux-host-service-claim-nonce")
    if authorized_at <= 0: return Err("linux-host-service-admission-clock")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(3), "kind": SdnValue.String("linux-host-service-claim"),
        "root": SdnValue.String(host_linux_service_root_path_v4(binding)?),
        "bindingDigest": SdnValue.String(host_linux_service_enrollment_digest_v3(binding)?),
        "operationId": SdnValue.String(credential.operation.id), "nativeMachineId": SdnValue.String(binding.native_machine_id),
        "nonce": SdnValue.String(nonce), "credentialDigest": SdnValue.String(sha256_text(host_enrollment_credential_encode_v1(credential)?)),
        "authorizedAtUnixMs": SdnValue.Int(authorized_at)}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

pub fn host_linux_service_root_bytes_v4(binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, nonce: text, authorized_at: i64) -> Result<text, text>:
    val claim = host_linux_service_claim_bytes_v4(binding, credential, nonce, authorized_at)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(3), "kind": SdnValue.String("linux-host-service-root"),
        "root": SdnValue.String(host_linux_service_root_path_v4(binding)?),
        "bindingDigest": SdnValue.String(host_linux_service_enrollment_digest_v3(binding)?),
        "operationId": SdnValue.String(credential.operation.id),
        "claimPath": SdnValue.String(binding.machine_parent + "/" + host_linux_service_claim_name_v4(binding)),
        "claimDigest": SdnValue.String(sha256_text(claim)), "nonce": SdnValue.String(nonce),
        "credentialDigest": SdnValue.String(sha256_text(host_enrollment_credential_encode_v1(credential)?)),
        "authorizedAtUnixMs": SdnValue.Int(authorized_at)}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

fn host_linux_service_claim_check_v4(root: text, binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, claim_bytes: text, root_bytes: text) -> Result<(text, i64), text>:
    if root != host_linux_service_root_path_v4(binding)?: return Err("linux-host-service-root-parent-mismatch")
    val claim = service_record_fields_v4(claim_bytes, ["version", "kind", "root", "bindingDigest", "operationId", "nativeMachineId", "nonce", "credentialDigest", "authorizedAtUnixMs"])?
    val nonce = match claim["nonce"]:
        case SdnValue.String(value): value
        case _: return Err("linux-host-service-claim-nonce")
    val authorized_at = match claim["authorizedAtUnixMs"]:
        case SdnValue.Int(value): value
        case _: return Err("linux-host-service-admission-clock")
    if claim_bytes != host_linux_service_claim_bytes_v4(binding, credential, nonce, authorized_at)?: return Err("linux-host-service-claim-mismatch")
    if root_bytes != host_linux_service_root_bytes_v4(binding, credential, nonce, authorized_at)?: return Err("linux-host-service-root-record-mismatch")
    Ok((sha256_text(claim_bytes), authorized_at))

fn host_linux_service_metadata_v4(binding: HostLinuxServiceEnrollmentBindingV3, policy: text,
        configuration: text, engine_policy: text, broker_policy: text) -> Result<HostPrivateMetadataV2, text>:
    host_private_metadata_decode_v2(HostPrivateMetadataPinsV2(binding.policy_digest, binding.config_digest,
        binding.engine_policy_digest, binding.broker_policy_digest),
        base_encoding_text_to_bytes(policy), base_encoding_text_to_bytes(configuration),
        base_encoding_text_to_bytes(engine_policy), base_encoding_text_to_bytes(broker_policy))

# Byte half of the startup load: the caller's reader acquired `sources` from the
# installed root and parent. Refuses unless the stored credential still verifies
# against the installed policy with a fresh clock: an approval that expired while
# the service was down is refused at startup (owner decision 2026-11-16).
pub fn host_linux_service_records_verify_v4(root: text,
        sources: HostLinuxServiceRecordSourcesV4) -> Result<HostLinuxServiceRecordsV4, text>:
    val binding = host_linux_service_enrollment_decode_v3(sources.enrollment)?
    val metadata = host_linux_service_metadata_v4(binding, sources.policy, sources.configuration,
        sources.engine_policy, sources.broker_policy)?
    val parent_policy = local_authority_policy_decode_v1(sources.parent_policy)?
    if parent_policy.source_digest != binding.policy_digest: return Err("linux-host-service-installed-parent-policy-mismatch")
    val credential = host_enrollment_credential_decode_v1(sources.credential)?
    host_linux_service_static_check_v4(binding, credential, metadata)?
    val claim_digest = host_linux_service_claim_check_v4(root, binding, credential, sources.claim, sources.root_record)?
    if host_local_context_v1(metadata.policy).grant_clock < claim_digest.1: return Err("linux-host-service-admission-clock-regressed")
    var records = HostLinuxServiceRecordsV4(binding, metadata, credential, claim_digest.0, claim_digest.1)
    host_linux_service_enrollment_authorize_v4(records)?
    records.agent_helper_template = Some(host_linux_service_agent_helper_template_v4(binding, sources.agent_helper_template)?)
    Ok(records)

pub(package) fn host_linux_service_enrollment_authorize_v4(records: HostLinuxServiceRecordsV4) -> Result<(), text>:
    host_linux_service_static_check_v4(records.binding, records.credential, records.metadata)?
    val context = host_local_context_v1(records.metadata.policy)
    if context.grant_clock <= 0 or context.monotonic_ms < 0: return Err("linux-host-service-clock-invalid")
    val verified = distributed_verify_grant_approval_from_snapshot_v2(records.metadata.policy.snapshot,
        records.credential.signed, records.credential.approval, records.credential.operation,
        context.grant_clock, records.metadata.policy.snapshot.generation, context.policy_revision,
        context.revocation_epoch, context.session_generation)?
    Ok(())

fn host_linux_service_static_check_v4(binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, metadata: HostPrivateMetadataV2) -> Result<(), text>:
    val broker = host_linux_service_broker_template_v4(binding, metadata)?
    if sha256_text(metadata.engine_policy_bytes) != binding.engine_policy_digest: return Err("linux-host-service-engine-policy-pin")
    val config = metadata.configuration
    if (metadata.policy.source_digest != binding.policy_digest or
            metadata.policy.snapshot.policy_revision != binding.policy_revision or config.physical_host_id != binding.physical_host_id or
            config.service_scope_id != binding.service_scope_id or config.runtime_class_ref != "podman-rootless" or
            config.journal_root != "journal" or config.exclusive_device_ids.len() != 0 or
            config.cpu_ceiling_millis != binding.physical_cpu_millis or config.memory_ceiling_bytes != binding.physical_memory_bytes):
        return Err("linux-host-service-installed-binding-mismatch")
    val operation = credential.operation
    if (operation.operation != "host_enroll_v1" or operation.payload_digest != host_linux_service_enrollment_digest_v3(binding)? or
            operation.host_id != binding.physical_host_id or operation.memory_bytes != binding.physical_memory_bytes or
            operation.environment_digest != binding.provider_identity_digest or credential.signed.issuer_id != config.controller_ref):
        return Err("linux-host-service-enrollment-credential-mismatch")
    Ok(())

# Signed wrapper digest and inner planning-template digest are separate domains.
# This validates DATA; native current-template and reservation measurements are
# independently compared by the actual Root owner before activation/effects.
fn host_linux_service_broker_template_v4(binding: HostLinuxServiceEnrollmentBindingV3,
        metadata: HostPrivateMetadataV2) -> Result<text, text>:
    val source = metadata.broker_policy_bytes
    if source.byte_len() == 0 or source.byte_len() > 1048576 or sha256_text(source) != binding.broker_policy_digest:
        return Err("linux-host-service-broker-policy-pin")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 1048576, max_depth: 2,
            max_nodes: 8, max_rows: 0, max_cells: 0, max_columns: 4)):
        case Ok(value): value
        case Err(issue): return Err("linux-host-service-broker-policy-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("linux-host-service-broker-policy-object")
    if fields.len() != 3 or not fields.contains_key("template"): return Err("linux-host-service-broker-policy-fields")
    val template_bytes = match fields["template"]:
        case SdnValue.String(value): value
        case _: return Err("linux-host-service-broker-policy-template")
    val expected: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-service-broker-policy"), "template": SdnValue.String(template_bytes)}
    if sdn_encode_canonical(SdnValue.Dict(expected)) + "\n" != source: return Err("linux-host-service-broker-policy-canonical")
    val template = group_process_stream_template_decode_v3(template_bytes)?
    if group_process_stream_template_encode_v3(template)? != template_bytes or template.profile_v3.is_none(): return Err("linux-host-service-broker-template-canonical")
    val broker = template.profile_v3.unwrap().broker
    if broker.reserved_cpu_millis != binding.reserved_cpu_millis or broker.reserved_memory_bytes != binding.reserved_memory_bytes:
        return Err("linux-host-service-broker-reserved-mismatch")
    Ok(template_bytes)

# milestone_0021 F15 (B): the agent helper template, a sibling of the broker-policy loader above. Static checks
# only, on every load: pin, strict canonical three-field SDN, canonical normalized template (deadline and transport
# generation 0, enforced by the canonical encode), profile_v3 (the per-run binder refuses without it), args
# ["version"] (the data-only base projection of the workspace bind) and a pinned root whose last component is at
# most 200 bytes, so `<component>-<16 hex>-w<i>-<name>` stays under NAME_MAX. Budget and the runRoot relation are
# checked by the HELD epoch after the factory (validate_helper_template_v3), never guessed here.
pub fn host_linux_service_agent_helper_template_v4(binding: HostLinuxServiceEnrollmentBindingV3,
        source: text) -> Result<GroupProcessStreamLaunchV2, text>:
    if source.byte_len() == 0 or source.byte_len() > 1048576 or sha256_text(source) != binding.agent_helper_template_digest:
        return Err("linux-host-service-agent-helper-template-pin")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 1048576, max_depth: 2,
            max_nodes: 8, max_rows: 0, max_cells: 0, max_columns: 4)):
        case Ok(value): value
        case Err(issue): return Err("linux-host-service-agent-helper-template-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("linux-host-service-agent-helper-template-object")
    if fields.len() != 3 or not fields.contains_key("template"): return Err("linux-host-service-agent-helper-template-fields")
    val template_bytes = match fields["template"]:
        case SdnValue.String(value): value
        case _: return Err("linux-host-service-agent-helper-template-fields")
    val expected: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("linux-host-service-agent-helper-template"),
        "template": SdnValue.String(template_bytes)}
    if sdn_encode_canonical(SdnValue.Dict(expected)) + "\n" != source: return Err("linux-host-service-agent-helper-template-canonical")
    val template = group_process_stream_template_decode_v3(template_bytes)?
    if group_process_stream_template_encode_v3(template)? != template_bytes or template.profile_v3.is_none():
        return Err("linux-host-agent-helper-template-invalid")
    val root = template.root
    val slash = root.last_index_of("/")
    if (template.request.args != ["version"] or not root.starts_with("/") or slash < 0 or
            root.byte_len() - slash - 1 <= 0 or root.byte_len() - slash - 1 > 200):
        return Err("linux-host-agent-helper-template-invalid")
    Ok(template)

# Sealed proof of one verified signed enrollment association. Every field is
# private: only this module constructs it, and only in
# linux_service_enrollment_verify_v1 after the signature check against the
# caller-read policy, so it is OWNER-VERIFIED, not self-authenticating. The seal
# is not the security boundary (deployed enforcement is unverified): the owner
# calls linux_service_enrollment_installed_v1 with bytes read through its own
# writer before every effect, which re-verifies against INSTALLED policy.
pub class LinuxServiceVerifiedEnrollmentV1:
    binding: HostLinuxServiceEnrollmentBindingV3
    credential: HostEnrollmentCredentialV1
    policy_bytes: text
    configuration_bytes: text
    engine_policy_bytes: text
    broker_policy_bytes: text
    authorized_at: i64
    agent_helper_template_bytes: text = ""

    pub fn machine_parent() -> text: self.binding.machine_parent
    pub fn binding_digest() -> Result<text, text>: host_linux_service_enrollment_digest_v3(self.binding)
    pub fn claim_name() -> text: host_linux_service_claim_name_v4(self.binding)
    pub fn child() -> Result<text, text>: Ok("host-root-" + host_linux_service_enrollment_digest_v3(self.binding)?)
    # Digest of the exact signed credential this proof verified; lets the
    # owner pin the proof to the installed credential without exposing it.
    pub fn credential_digest() -> Result<text, text>:
        Ok(sha256_text(host_enrollment_credential_encode_v1(self.credential)?))
    pub fn install_token() -> Result<text, text>:
        Ok(sha256_text("LINUX-SIGNED-SERVICE-INSTALL-V3\n" + self.binding.machine_parent + "\n" +
            host_linux_service_enrollment_digest_v3(self.binding)?))

# Full check of one association: pins, static binding/credential/config, fresh
# wall clock, real Ed25519 issuer + approver signatures against `policy_bytes`.
fn linux_service_enrollment_check_v1(policy_bytes: text, binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, configuration_bytes: text, engine_policy_bytes: text,
        broker_policy_bytes: text, agent_helper_template_bytes: text) -> Result<i64, text>:
    host_linux_service_enrollment_encode_v3(binding)?
    val template = host_linux_service_agent_helper_template_v4(binding, agent_helper_template_bytes)?
    if sha256_text(policy_bytes) != binding.policy_digest: return Err("linux-service-enrollment-policy-pin")
    val metadata = host_linux_service_metadata_v4(binding, policy_bytes, configuration_bytes,
        engine_policy_bytes, broker_policy_bytes)?
    host_linux_service_static_check_v4(binding, credential, metadata)?
    val at = host_local_context_v1(metadata.policy).grant_clock
    if at <= 0: return Err("linux-service-enrollment-admission-clock")
    host_linux_service_enrollment_authorize_v4(HostLinuxServiceRecordsV4(binding, metadata, credential, "", at))?
    Ok(at)

# The only constructor of the proof. `policy_bytes` is what the caller read from
# the parent; the owner later re-verifies against its own writer-held bytes.
pub fn linux_service_enrollment_verify_v1(policy_bytes: text, binding: HostLinuxServiceEnrollmentBindingV3,
        credential: HostEnrollmentCredentialV1, configuration_bytes: text, engine_policy_bytes: text,
        broker_policy_bytes: text, agent_helper_template_bytes: text) -> Result<LinuxServiceVerifiedEnrollmentV1, text>:
    val at = linux_service_enrollment_check_v1(policy_bytes, binding, credential, configuration_bytes,
        engine_policy_bytes, broker_policy_bytes, agent_helper_template_bytes)?
    Ok(LinuxServiceVerifiedEnrollmentV1(binding: binding, credential: credential, policy_bytes: policy_bytes,
        configuration_bytes: configuration_bytes, engine_policy_bytes: engine_policy_bytes,
        broker_policy_bytes: broker_policy_bytes, authorized_at: at, agent_helper_template_bytes: agent_helper_template_bytes))

# Re-verification against INSTALLED bytes read by the storage owner through its
# own writer descriptor. Fresh clock every call: an approval that expired while
# the service was down is refused after restart (owner decision 2026-11-16).
pub fn linux_service_enrollment_installed_v1(proof: LinuxServiceVerifiedEnrollmentV1,
        held_policy: Option<text>) -> Result<(), text>:
    if held_policy.is_none() or held_policy.unwrap() != proof.policy_bytes:
        return Err("linux-service-enrollment-installed-policy-mismatch")
    val at = linux_service_enrollment_check_v1(held_policy.unwrap(), proof.binding, proof.credential,
        proof.configuration_bytes, proof.engine_policy_bytes, proof.broker_policy_bytes, proof.agent_helper_template_bytes)?
    if at < proof.authorized_at: return Err("linux-service-enrollment-clock-regressed")
    Ok(())

# Exact duplicate of THIS association only; a different binding, credential or
# parent fails byte comparison. Returns the original admission time.
pub fn linux_service_enrollment_existing_v1(proof: LinuxServiceVerifiedEnrollmentV1,
        claim_bytes: text, root_bytes: text) -> Result<i64, text>:
    val same = host_linux_service_claim_check_v4(host_linux_service_root_path_v4(proof.binding)?, proof.binding,
        proof.credential, claim_bytes, root_bytes)?
    val policy = local_authority_policy_decode_v1(proof.policy_bytes)?
    if same.1 > host_local_context_v1(policy).grant_clock: return Err("linux-service-enrollment-existing-clock")
    Ok(same.1)

pub fn linux_service_enrollment_fixed_files_v1(proof: LinuxServiceVerifiedEnrollmentV1) -> Result<[(text, text)], text>:
    val child = proof.child()?
    Ok([(child + "/linux-service-enrollment-v3.sdn", host_linux_service_enrollment_encode_v3(proof.binding)?),
        (child + "/linux-service-enrollment-credential-v3.sdn", host_enrollment_credential_encode_v1(proof.credential)?),
        (child + "/authority-policy.sdn", proof.policy_bytes), (child + "/host-config.sdn", proof.configuration_bytes),
        (child + "/engine-policy.sdn", proof.engine_policy_bytes), (child + "/broker-policy.sdn", proof.broker_policy_bytes),
        (child + "/agent-helper-template.sdn", proof.agent_helper_template_bytes)])

# Ordered fresh publication DATA: claim, seven fixed children, root manifest last.
# The nonce is drawn here; no caller chooses claim or manifest bytes.
pub fn linux_service_enrollment_publication_v1(proof: LinuxServiceVerifiedEnrollmentV1) -> Result<[(text, text)], text>:
    val entropy = sosix_random_hex(32)
    if entropy.is_none(): return Err("linux-service-enrollment-entropy")
    val nonce = entropy.unwrap()
    var items = [(proof.claim_name(), host_linux_service_claim_bytes_v4(proof.binding, proof.credential, nonce, proof.authorized_at)?)]
    for item in linux_service_enrollment_fixed_files_v1(proof)?:
        items.push(item)
    items.push((proof.child()? + "/linux-service-root-v3.sdn",
        host_linux_service_root_bytes_v4(proof.binding, proof.credential, nonce, proof.authorized_at)?))
    Ok(items)
