# Stateless Linux IO implementation mechanisms extracted from the identity store.
# SOURCE_AUTHORED_NOT_RUN. These values and raw descriptors grant no root,
# installed-policy, process-origin, ancestry or mutation authority. Domain owners
# retain all canonical state. Native pathname allocation is caller-freed and is
# not path confinement or UTF-8 validation; empty names support AT_EMPTY_PATH.
@when(os="linux"):
use std.nogc_sync_mut.io.host_identity_store_abi_v1.*
use std.common.text_bytes.text_to_utf8_bytes
use std.nogc_sync_mut.io.volatile_ops.{volatile_read_u8, volatile_read_u16,
    volatile_read_u32, volatile_read_u64, volatile_write_u8}

pub struct AnchoredLinuxMetadataV1:
    identity: [u8]
    revision: [u8]
    uid: u32
    mode: u32
    links: i64
    size: i64

pub fn anchored_linux_directory_flags_v1() -> i32:
    @when(arch="x86_64"):
    720896
    @elif(arch="aarch64"):
    573440
    @else:
    0
    @end

pub fn anchored_linux_file_flags_v1() -> i32:
    @when(arch="x86_64"):
    657408
    @elif(arch="aarch64"):
    559104
    @else:
    0
    @end

@unsafe(reason: "copy only bounded native pathname data, never secret payloads, into NUL-terminated memory", capabilities: [ffi, raw_ptr])
pub fn anchored_linux_name_v1(name: text) -> i64:
    if name.byte_len() > 4095 or name.contains("\u0000"): return 0
    val bytes: [u8] = text_to_utf8_bytes(name)
    if bytes.len() != name.byte_len(): return 0
    val memory = malloc((bytes.len() + 1) as u64)
    if memory == 0: return 0
    for index in 0..bytes.len(): volatile_write_u8(memory + index, bytes[index] as i64)
    volatile_write_u8(memory + bytes.len(), 0)
    memory

@unsafe(reason: "snapshot Linux statx stable UAPI fields for exact retained descriptor or nofollow name", capabilities: [ffi, raw_ptr])
pub fn anchored_linux_metadata_v1(fd: i64, name: text, by_handle: bool) -> Result<AnchoredLinuxMetadataV1, text>:
    val memory = malloc(256u64)
    if memory == 0: return Err("anchored-io-memory")
    val path = anchored_linux_name_v1(name)
    if path == 0:
        free(memory)
        return Err("anchored-io-memory")
    val status = statx(fd as i32, path, if by_handle: 4096 else: 256, 2047u32, memory)
    val native_error = if status != 0: volatile_read_u32(__errno_location()) else: 0
    free(path)
    # TYPE|MODE|NLINK|UID|INO|SIZE|MTIME|CTIME must all be genuinely returned.
    if status != 0 or (volatile_read_u32(memory) & 975) != 975:
        free(memory)
        return Err(if native_error == 2: "anchored-io-absent" else: "anchored-io-metadata")
    var identity: [u8] = []
    var revision: [u8] = []
    for index in 32..40: identity.push(volatile_read_u8(memory + index) as u8)
    for index in 136..144: identity.push(volatile_read_u8(memory + index) as u8)
    for index in 32..48: revision.push(volatile_read_u8(memory + index) as u8)
    for index in 96..128: revision.push(volatile_read_u8(memory + index) as u8)
    val result = AnchoredLinuxMetadataV1(identity, revision, volatile_read_u32(memory + 20) as u32,
        volatile_read_u16(memory + 28) as u32, volatile_read_u32(memory + 16), volatile_read_u64(memory + 40))
    free(memory)
    Ok(result)

@end
