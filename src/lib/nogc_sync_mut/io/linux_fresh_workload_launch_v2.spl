# Closed workload launch DATA only; actual private action admission and retained
# successor custody are required by the executor. Startup V1 remains unchanged.
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.common.contracts.container.linux_fresh_epoch_v1.LinuxFreshEpochProfileV1
use std.common.contracts.container.execution_v2.container_scope_fence_id_v2
use std.common.contracts.container.linux_fresh_workload_inspect_v2.linux_fresh_workload_inspect_format_v2
use std.common.contracts.container.configuration_inspect_query_v1.{ContainerConfigurationInspectKindV1, container_configuration_inspect_command_v1}
use std.common.contracts.container.runtime_v1.RuntimeIdentityV1
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamLaunchV2, group_process_child_argv_digest_v2}

pub fn linux_fresh_workload_project_launch_v2(profile: LinuxFreshEpochProfileV1,
        base: GroupProcessStreamLaunchV2, command: LinuxFreshWorkloadCommandV2) -> Result<GroupProcessStreamLaunchV2, text>:
    linux_fresh_workload_command_validate_v2(command)?
    if base.profile_v3.is_none(): return Err("fresh-workload-profile-required")
    val resource = base.profile_v3.unwrap()
    if resource.helper_cpu.cpu_millis != command.helper_cpu_millis or base.memory_limit_bytes != command.helper_memory_bytes:
        return Err("fresh-workload-helper-subcharge-mismatch")
    val cpu = profile.number_v1("partitionCpuMillis")? - profile.number_v1("reservedCpuMillis")?
    val memory = profile.number_v1("partitionMemoryBytes")? - profile.number_v1("reservedMemoryBytes")?
    if (command.helper_cpu_millis > cpu or command.cpu_millis > cpu - command.helper_cpu_millis or
            command.helper_memory_bytes > memory or command.memory_bytes > memory - command.helper_memory_bytes):
        return Err("fresh-workload-request-plus-helper-exceeds-usable")
    val args = linux_fresh_workload_argv_v2(profile, command)?
    var result = base
    var request = base.request
    request.args = args
    request.timeout_ms = command.timeout_ms
    request.child_argv_digest = group_process_child_argv_digest_v2(request.program, args)
    result.request = request
    Ok(result)

pub fn linux_fresh_workload_argv_v2(profile: LinuxFreshEpochProfileV1, command: LinuxFreshWorkloadCommandV2) -> Result<[text], text>:
    linux_fresh_workload_command_validate_v2(command)?
    val plan = command.request.plan
    val fence = container_scope_fence_id_v2(command.scope)?
    var args = ["--remote=false", "--log-level=error", "--cgroup-manager=cgroupfs", "--root", profile.text_v1("graphRoot")?,
        "--runroot", profile.text_v1("runRoot")?, "--storage-driver", "vfs", "--tmpdir", profile.text_v1("runRoot")? + "/tmp"]
    match command.action:
        case LinuxFreshWorkloadActionV2.PullImage: args = args + ["pull", "--quiet", "--", command.image]
        case LinuxFreshWorkloadActionV2.Create:
            args = args + ["create", "--quiet", "--pull=never", "--name", "simple-" + plan.workload_uid + "-" + str(plan.attempt),
                "--label", "io.simpleorch.pod_uid=" + plan.workload_uid,
                "--label", "io.simpleorch.attempt=" + str(plan.attempt),
                "--label", "io.simpleorch.node_boot_id=" + fence,
                "--label", "io.simpleorch.provider_generation=" + str(command.scope.provider_generation),
                "--label", "io.simpleorch.operation_id=" + plan.operation_id,
                "--cpu-period=100000", "--cpu-quota=" + str(command.cpu_millis * 100),
                "--memory=" + str(command.memory_bytes), "--memory-swap=" + str(command.memory_bytes),
                "--pids-limit=" + str(command.pid_limit), "--network=none", "--read-only", "--read-only-tmpfs=false",
                "--security-opt=no-new-privileges", "--cap-drop=ALL", "--cgroups=enabled", "--cgroupns=private", "--pid=private",
                "--privileged=false", "--http-proxy=false", "--cgroup-parent=" + profile.text_v1("delegatedCgroup")?,
                "--entrypoint", command.entrypoint[0], "--", command.image]
            for at in 1..command.entrypoint.len(): args.push(command.entrypoint[at])
            args = args + command.args
        case LinuxFreshWorkloadActionV2.Start: args = args + ["start", "--", command.native_id]
        case LinuxFreshWorkloadActionV2.Inspect:
            args = args + ["container", "inspect", "--format", linux_fresh_workload_inspect_format_v2(), "--", command.native_id]
        case LinuxFreshWorkloadActionV2.Stop:
            args = args + ["stop", "--time", str((command.timeout_ms + 999) / 1000), "--", command.native_id]
        case LinuxFreshWorkloadActionV2.Remove: args = args + ["rm", "--", command.native_id]
        case LinuxFreshWorkloadActionV2.Absence:
            args = args + ["container", "inspect", "--format", "{{{{.Id}}}}", "--", command.native_id]
        case _:
            val kind = workload_query_kind_v2(command.action)?
            val expected = RuntimeIdentityV1(engine: "podman", native_id: command.native_id, pod_uid: plan.workload_uid,
                attempt: plan.attempt, node_boot_id: fence, provider_generation: command.scope.provider_generation, operation_id: plan.operation_id)
            val query = container_configuration_inspect_command_v1(kind, expected, false, command.observed_image_id)?
            if query.program != "podman": return Err("fresh-workload-shared-query-program")
            args = args + query.args
    if args.len() > 64: return Err("fresh-workload-projected-argv-bound")
    Ok(args)

fn workload_query_kind_v2(action: LinuxFreshWorkloadActionV2) -> Result<ContainerConfigurationInspectKindV1, text>:
    match action:
        case LinuxFreshWorkloadActionV2.ConfigurationBefore: Ok(ContainerConfigurationInspectKindV1.ConfigurationBefore)
        case LinuxFreshWorkloadActionV2.ConfigurationImage: Ok(ContainerConfigurationInspectKindV1.ConfigurationImage)
        case LinuxFreshWorkloadActionV2.ConfigurationAfter: Ok(ContainerConfigurationInspectKindV1.ConfigurationAfter)
        case LinuxFreshWorkloadActionV2.InputConfigurationBefore: Ok(ContainerConfigurationInspectKindV1.InputConfigurationBefore)
        case LinuxFreshWorkloadActionV2.InputConfigurationImage: Ok(ContainerConfigurationInspectKindV1.InputConfigurationImage)
        case LinuxFreshWorkloadActionV2.InputConfigurationAfter: Ok(ContainerConfigurationInspectKindV1.InputConfigurationAfter)
        case _: Err("fresh-workload-closed-action-unsupported")
