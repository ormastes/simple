# Serial baud parsing helper
#
# Pure validation of the BAUD argument accepted by serial_proxy.spl.
# Extracted so the guard is unit-testable without spawning the relay main.

pub fn parse_baud_or_zero(value: text) -> i64:
    """Return the parsed decimal baud rate, or 0 for any malformed value."""
    val trimmed = value.trim()
    if trimmed == "":
        return 0
    for ch in trimmed:
        if ch < "0" or ch > "9":
            return 0
    return trimmed.to_int() ?? 0
