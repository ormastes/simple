# One bounded loopback exchange. The Controller retains its ready reader until
# this socket is consumed. No bearer is transmitted, no effect is retried.
use std.nogc_sync_mut.io.host_service_ready_reader_v1.*
use std.nogc_sync_mut.io.windows_command_owner_v2.windows_command_thread_check_v2
@when(os="linux"):
use std.nogc_sync_mut.io.linux_machine_process_origin_v1.linux_machine_process_origin_check_v1
@end
use std.nogc_sync_mut.io.tcp.TcpStream
use std.common.encoding.external_text.{bytes_to_text_checked}
use std.common.string_core.{text_to_bytes}
use std.common.contracts.orchestration.host_service_auth_v6.HostServiceAuthContextV6
use std.common.contracts.orchestration.host_service_auth_frame_v6.*
use std.common.contracts.orchestration.host_service_operation_v6.*
use std.common.contracts.orchestration.host_service_operation_reply_v6.*
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex
use std.nogc_sync_mut.sosix.time.sosix_time_now_monotonic_ms

pub class HostServiceAuthExchangeV6:
    identity: i64

pub class HostServiceVerifiedReplyV6:
    identity: i64

pub struct HostServiceAuthExchangeTurnV6:
    owner: Option<HostServiceAuthExchangeV6>
    reply: Option<HostServiceVerifiedReplyV6>
    completed: bool
    outcome: text
    error: text

struct AuthExchangeStateV6:
    identity: i64
    reader: Option<HostServiceReadyReaderV1>
    request: HostServiceOperationRequestV6
    context: HostServiceAuthContextV6
    stream: Option<TcpStream>
    deadline: i64
    output: [u8]
    phase: text
    offset: i64 = 0
    header: text = ""
    expected: i64 = -1
    input: [u8] = []
    outcome: text = "not-sent"
    error: text = ""
    reply: Option<HostServiceOperationReplyV6> = None
    taken: bool = false

var _auth_exchanges_v6: [AuthExchangeStateV6] = []
var _auth_exchange_next_v6: i64 = 1

# On Linux the admission is the pinned procfs origin of the original process main thread, the same guard the V6
# connection, the ready reader and the controller dispatch owner use. Process origin only.
fn exchange_enter_v6() -> Result<bool, text>:
    @when(os="windows"):
    windows_command_thread_check_v2()?
    Ok(true)
    @elif(os="linux"):
    val origin = unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()
    if origin.is_err(): return Err(origin.unwrap_err())
    Ok(true)
    @else:
    Err("host-service-auth-native-reader-unavailable")
    @end

fn exchange_index_v6(identity: i64) -> Result<int, text>:
    for index in 0.._auth_exchanges_v6.len():
        if _auth_exchanges_v6[index].identity == identity: return Ok(index)
    Err("host-service-auth-exchange-stale")

fn exchange_turn_v6(state: AuthExchangeStateV6) -> HostServiceAuthExchangeTurnV6:
    HostServiceAuthExchangeTurnV6(if state.phase == "closed": nil else: Some(HostServiceAuthExchangeV6(state.identity)),
        if state.reply.is_some() and not state.taken: Some(HostServiceVerifiedReplyV6(state.identity)) else: nil,
        state.phase == "complete" or state.phase == "closed", state.outcome, state.error)

fn exchange_error_v6(owner: Option<HostServiceAuthExchangeV6>, reason: text) -> HostServiceAuthExchangeTurnV6:
    # Invocation failures do not prove the outcome of an already-existing owner.
    HostServiceAuthExchangeTurnV6(owner, nil, false, if owner.is_some(): "unknown" else: "not-sent", reason)

fn exchange_fail_v6(original: AuthExchangeStateV6, reason: text) -> AuthExchangeStateV6:
    var state = original
    if state.error == "": state.error = reason
    state.phase = "cleanup"
    state

fn exchange_reader_current_v6(state: AuthExchangeStateV6) -> Result<bool, text>:
    if state.reader.is_none(): return Err("host-service-auth-reader-released")
    val current = host_service_ready_reader_current_v1(state.reader.unwrap())?
    if host_service_ready_reader_incarnation_v1(state.reader.unwrap())? != state.context.service_incarnation:
        return Err("host-service-auth-incarnation-changed")
    Ok(true)

pub fn host_service_auth_exchange_begin_v6(reader: HostServiceReadyReaderV1,
        request: HostServiceOperationRequestV6, timeout_ms: i64 = 2000) -> HostServiceAuthExchangeTurnV6:
    val admitted = exchange_enter_v6()
    if admitted.is_err(): return exchange_error_v6(nil, admitted.unwrap_err())
    if timeout_ms <= 0 or timeout_ms > 2000: return exchange_error_v6(nil, "host-service-auth-timeout-range")
    val encoded = host_service_operation_encode_v6(request)
    if encoded.is_err(): return exchange_error_v6(nil, encoded.unwrap_err())
    val endpoint = host_service_ready_reader_endpoint_v1(reader)
    val incarnation = host_service_ready_reader_incarnation_v1(reader)
    if endpoint.is_err(): return exchange_error_v6(nil, endpoint.unwrap_err())
    if incarnation.is_err(): return exchange_error_v6(nil, incarnation.unwrap_err())
    if incarnation.unwrap() != request.service_incarnation: return exchange_error_v6(nil, "host-service-auth-incarnation-mismatch")
    val digest = host_service_operation_command_digest_v6(request)
    if digest.is_err(): return exchange_error_v6(nil, digest.unwrap_err())
    val nonce = sosix_random_hex(32)
    if nonce.is_none(): return exchange_error_v6(nil, "host-service-auth-entropy-unavailable")
    val hello = host_service_auth_frame_line_encode_v6(HostServiceAuthFrameV6("hello", request.service_incarnation,
        nonce.unwrap(), "", digest.unwrap(), "", ""))
    if hello.is_err(): return exchange_error_v6(nil, hello.unwrap_err())
    var index = -1
    for candidate in 0.._auth_exchanges_v6.len():
        if _auth_exchanges_v6[candidate].phase == "closed" and index < 0: index = candidate
    if (index < 0 and _auth_exchanges_v6.len() >= 16) or _auth_exchange_next_v6 >= 9223372036854775807:
        return exchange_error_v6(nil, "host-service-auth-exchange-capacity")
    val now = sosix_time_now_monotonic_ms()
    if now < 0 or now > 9223372036854775807 - timeout_ms: return exchange_error_v6(nil, "host-service-auth-clock")
    val connected = TcpStream.connect_timeout(endpoint.unwrap(), timeout_ms)
    if connected.is_err(): return exchange_error_v6(nil, "host-service-auth-connect")
    val stream = connected.unwrap()
    val context = HostServiceAuthContextV6(request.service_incarnation, nonce.unwrap(), "", digest.unwrap())
    var state = AuthExchangeStateV6(_auth_exchange_next_v6, Some(reader), request, context,
        Some(stream), now + timeout_ms, text_to_bytes(hello.unwrap()), "send-hello")
    _auth_exchange_next_v6 = _auth_exchange_next_v6 + 1
    if stream.enable_nonblocking().is_err(): state = exchange_fail_v6(state, "host-service-auth-nonblocking")
    if index < 0: _auth_exchanges_v6.push(state)
    else: _auth_exchanges_v6[index] = state
    exchange_turn_v6(state)

fn exchange_accept_frame_v6(original: AuthExchangeStateV6) -> AuthExchangeStateV6:
    var state = original
    val frame_text: text = match bytes_to_text_checked(state.input):
        case Ok(v): v
        case Err(_): return exchange_fail_v6(state, "host-service-auth-frame-utf8")
    val decoded = host_service_auth_frame_decode_v6(frame_text)
    if decoded.is_err(): return exchange_fail_v6(state, decoded.unwrap_err())
    val frame = decoded.unwrap()
    if (frame.service_incarnation != state.context.service_incarnation or frame.client_nonce != state.context.client_nonce or
            frame.command_digest != state.context.command_digest): return exchange_fail_v6(state, "host-service-auth-response-context")
    if state.phase == "read-challenge":
        if frame.role != "challenge": return exchange_fail_v6(state, "host-service-auth-challenge-required")
        state.context.server_nonce = frame.server_nonce
        val checked = host_service_ready_reader_verify_server_v1(state.reader.unwrap(), state.context, "challenge", "", frame.tag)
        if checked.is_err(): return exchange_fail_v6(state, checked.unwrap_err())
        if not checked.unwrap(): return exchange_fail_v6(state, "host-service-auth-challenge-tag")
        val payload = host_service_operation_encode_v6(state.request)
        if payload.is_err(): return exchange_fail_v6(state, payload.unwrap_err())
        val tag = host_service_ready_reader_mac_request_v1(state.reader.unwrap(), state.context, payload.unwrap())
        if tag.is_err(): return exchange_fail_v6(state, tag.unwrap_err())
        val line = host_service_auth_frame_line_encode_v6(HostServiceAuthFrameV6("request", state.context.service_incarnation,
            state.context.client_nonce, state.context.server_nonce, state.context.command_digest, payload.unwrap(), tag.unwrap()))
        if line.is_err(): return exchange_fail_v6(state, line.unwrap_err())
        state.output = text_to_bytes(line.unwrap())
        state.offset = 0
        state.header = ""
        state.input = []
        state.expected = -1
        state.phase = "send-request"
        return state
    if frame.role != "reply" or frame.server_nonce != state.context.server_nonce:
        return exchange_fail_v6(state, "host-service-auth-reply-context")
    val checked = host_service_ready_reader_verify_server_v1(state.reader.unwrap(), state.context, "reply", frame.payload, frame.tag)
    if checked.is_err(): return exchange_fail_v6(state, checked.unwrap_err())
    if not checked.unwrap(): return exchange_fail_v6(state, "host-service-auth-reply-tag")
    val reply = host_service_operation_reply_decode_v6(frame.payload)
    if reply.is_err(): return exchange_fail_v6(state, reply.unwrap_err())
    val matched = host_service_operation_reply_match_v6(reply.unwrap(), state.request)
    if matched.is_err(): return exchange_fail_v6(state, matched.unwrap_err())
    state.reply = Some(reply.unwrap())
    state.outcome = "authenticated-reply"
    state.phase = "cleanup"
    state

pub fn host_service_auth_exchange_step_v6(owner: HostServiceAuthExchangeV6,
        cancel: bool = false) -> HostServiceAuthExchangeTurnV6:
    val admitted = exchange_enter_v6()
    if admitted.is_err(): return exchange_error_v6(Some(owner), admitted.unwrap_err())
    val found = exchange_index_v6(owner.identity)
    if found.is_err(): return exchange_error_v6(Some(owner), found.unwrap_err())
    val index = found.unwrap()
    var state = _auth_exchanges_v6[index]
    if state.phase == "complete" or state.phase == "closed": return exchange_turn_v6(state)
    if cancel: state = exchange_fail_v6(state, "host-service-auth-cancelled")
    if state.phase != "cleanup":
        val now = sosix_time_now_monotonic_ms()
        val current = exchange_reader_current_v6(state)
        if now < 0 or now >= state.deadline: state = exchange_fail_v6(state, "host-service-auth-deadline")
        elif current.is_err(): state = exchange_fail_v6(state, current.unwrap_err())
    if state.phase == "cleanup":
        if val retained = state.stream:
            var stream = retained
            # TcpStream.close consumes its open flag even on error. Never retry
            # the scalar descriptor; preserve the uncertainty alongside reply.
            state.stream = nil
            _auth_exchanges_v6[index] = state
            val closed = stream.close()
            if closed.is_err() and state.error == "": state.error = "host-service-auth-socket-close-unconfirmed"
        state.phase = "complete"
    elif state.phase == "send-hello" or state.phase == "send-request":
        val end = if state.offset + 65536 < state.output.len(): state.offset + 65536 else: state.output.len()
        if state.phase == "send-request":
            state.outcome = "unknown"
            _auth_exchanges_v6[index] = state
        val written = state.stream.unwrap().write(state.output[state.offset:end])
        if written.is_ok():
            val accepted = written.unwrap()
            if accepted <= 0 or accepted > end - state.offset: state = exchange_fail_v6(state, "host-service-auth-write")
            else:
                state.offset = state.offset + accepted
                if state.offset == state.output.len():
                    state.phase = if state.phase == "send-hello": "read-challenge" else: "read-reply"
                    state.output = []
    else:
        # Exact length framing, no EOF dependency and no speculative overread
        # into a later phase. Reuse the existing SMUX/1 length frame.
        val count = if state.expected < 0: 1 else: if state.expected - state.input.len() > 65536: 65536 else: state.expected - state.input.len()
        val read = state.stream.unwrap().read(count)
        if read.is_ok():
            val bytes = read.unwrap()
            if bytes.len() == 0: state = exchange_fail_v6(state, "host-service-auth-eof")
            elif state.expected < 0:
                val byte = bytes[0]
                if byte == 10:
                    val length_text = if state.header.starts_with("SMUX/1 "): state.header[7:] else: ""
                    val size = length_text.to_int() ?? -1
                    val bound = if state.phase == "read-challenge": 4096 else: 1048576
                    if size <= 0 or size > bound:
                        state = exchange_fail_v6(state, "host-service-auth-length")
                    elif size.to_text() != length_text: state = exchange_fail_v6(state, "host-service-auth-length-canonical")
                    else: state.expected = size
                elif byte < 32 or byte > 126 or state.header.byte_len() >= 31:
                    state = exchange_fail_v6(state, "host-service-auth-length")
                else:
                    match bytes_to_text_checked(bytes):
                        case Ok(v): state.header = state.header + v
                        case Err(_): state = exchange_fail_v6(state, "host-service-auth-length")
            else:
                state.input = state.input + bytes
                if state.input.len() == state.expected: state = exchange_accept_frame_v6(state)
    # Read/write WouldBlock is conflated with errors by the existing facade.
    # Retain exact buffers until the ORIGINAL deadline; never restart or resend.
    _auth_exchanges_v6[index] = state
    exchange_turn_v6(state)

pub fn host_service_auth_exchange_take_v6(owner: HostServiceAuthExchangeV6,
        proof: HostServiceVerifiedReplyV6) -> Result<HostServiceOperationReplyV6, text>:
    val admitted = exchange_enter_v6()?
    if owner.identity != proof.identity: return Err("host-service-auth-reply-owner")
    val index = exchange_index_v6(owner.identity)?
    var state = _auth_exchanges_v6[index]
    if state.phase != "complete" or state.reply.is_none() or state.taken: return Err("host-service-auth-reply-consumed")
    # Consume the one-use result before the final selector observation. A new
    # lease never permits replay, including after a confirmed service stop.
    state.taken = true
    _auth_exchanges_v6[index] = state
    val current = exchange_reader_current_v6(state)
    if current.is_err():
        state.outcome = "unknown"
        state.reply = None
        if state.error == "": state.error = current.unwrap_err()
        _auth_exchanges_v6[index] = state
        return Err(state.error)
    if state.error != "": return Err(state.error)
    Ok(state.reply.unwrap())

pub fn host_service_auth_exchange_close_v6(owner: HostServiceAuthExchangeV6) -> HostServiceAuthExchangeTurnV6:
    val turn = host_service_auth_exchange_step_v6(owner, true)
    if not turn.completed: return turn
    val admitted = exchange_enter_v6()
    if admitted.is_err(): return exchange_error_v6(Some(owner), admitted.unwrap_err())
    val found = exchange_index_v6(owner.identity)
    if found.is_err(): return exchange_error_v6(Some(owner), found.unwrap_err())
    var state = _auth_exchanges_v6[found.unwrap()]
    state.phase = "closed"
    state.reader = nil
    state.input = []
    state.output = []
    state.reply = None
    _auth_exchanges_v6[found.unwrap()] = state
    exchange_turn_v6(state)
