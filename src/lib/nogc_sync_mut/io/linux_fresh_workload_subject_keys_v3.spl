# Mechanical pure DATA key extraction; no registry, owner constructor or getter.
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.common.contracts.container.execution_v2.{container_execution_request_encode_v2, container_host_scope_bytes_v2}
use std.nogc_sync_mut.io.linux_container_containment_v1.LinuxContainerContainmentSnapshotV1
use std.common.crypto.sha256.sha256_text

pub(package) fn subject_request_key_v2(command: LinuxFreshWorkloadCommandV2) -> Result<text, text>:
    linux_fresh_workload_command_validate_v2(command)?
    if command.action != LinuxFreshWorkloadActionV2.Inspect and command.action != LinuxFreshWorkloadActionV2.Absence:
        return Err("fresh-workload-subject-inspect-or-absence-required")
    Ok(sha256_text("FRESH-WORKLOAD-SUBJECT-V2\n" + container_execution_request_encode_v2(command.request)? +
        container_host_scope_bytes_v2(command.scope)? + command.native_id + "\n" + str(command.helper_cpu_millis) + "\n" +
        str(command.helper_memory_bytes) + "\n"))

pub(package) fn subject_snapshot_key_v2(value: LinuxContainerContainmentSnapshotV1) -> text:
    sha256_text("FRESH-WORKLOAD-NATIVE-V2\n" + value.binding_digest + "\n" + str(value.capture_pid) + "\n" +
        str(value.process_start_ticks) + "\n" + value.cgroup_path + "\n" + str(value.cgroup_mount_id) + "\n" +
        str(value.cgroup_mount_device) + "\n" + str(value.cgroup_mount_inode) + "\n" + str(value.cgroup_device) + "\n" +
        str(value.cgroup_inode) + "\n" + str(value.target_pidns_device) + "\n" + str(value.target_pidns_inode) + "\n" +
        str(value.target_cgroupns_device) + "\n" + str(value.target_cgroupns_inode) + "\n" +
        str(value.observer_pidns_device) + "\n" + str(value.observer_pidns_inode) + "\n" +
        str(value.observer_cgroupns_device) + "\n" + str(value.observer_cgroupns_inode) + "\n" +
        str(value.observer_mountns_device) + "\n" + str(value.observer_mountns_inode) + "\n")

