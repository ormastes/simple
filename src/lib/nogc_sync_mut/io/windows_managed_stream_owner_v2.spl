# Portable wrapper: non-Windows closures never import kernel32/ConPTY owners.
pub use std.common.process.windows_job_stream_v2.{WindowsManagedStreamLeaseV2,
    WindowsManagedStreamRequestV2, WindowsManagedStreamAdmissionV2,
    WindowsManagedStreamPollV2, WindowsManagedStreamReadV2, WindowsManagedStreamHostV2}

@when(os="windows"):
pub use std.nogc_sync_mut.io.windows_managed_stream_native_v2.{windows_managed_stream_host_observe_v2,
    windows_managed_stream_admit_v2, windows_managed_stream_poll_v2,
    windows_managed_stream_read_bytes_v2, windows_managed_stream_write_some_bytes_v2,
    windows_managed_stream_input_pending_v2, windows_managed_stream_cancel_v2,
    windows_managed_stream_collect_v2, windows_managed_stream_resize_v2}
@else:
pub fn windows_managed_stream_host_observe_v2() -> Result<WindowsManagedStreamHostV2, text>:
    Err("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_admit_v2(request: WindowsManagedStreamRequestV2) -> WindowsManagedStreamAdmissionV2:
    WindowsManagedStreamAdmissionV2.Rejected("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_poll_v2(lease: WindowsManagedStreamLeaseV2) -> Result<WindowsManagedStreamPollV2, text>:
    Err("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_read_bytes_v2(lease: WindowsManagedStreamLeaseV2, max_bytes: i64) -> WindowsManagedStreamReadV2:
    WindowsManagedStreamReadV2.Failed("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_write_some_bytes_v2(lease: WindowsManagedStreamLeaseV2, data: [u8]) -> Result<i64, text>:
    Err("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_input_pending_v2(lease: WindowsManagedStreamLeaseV2) -> Result<bool, text>:
    Err("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_cancel_v2(lease: WindowsManagedStreamLeaseV2) -> Result<bool, text>:
    Err("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_collect_v2(lease: WindowsManagedStreamLeaseV2) -> Result<WindowsManagedStreamPollV2, text>:
    Err("Windows managed stream unsupported on this platform")
pub fn windows_managed_stream_resize_v2(lease: WindowsManagedStreamLeaseV2, rows: i32, cols: i32) -> Result<bool, text>:
    Err("RAW managed streams have no terminal to resize")
@end
