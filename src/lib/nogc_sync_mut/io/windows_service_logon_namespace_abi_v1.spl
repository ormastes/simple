# Direct documented Win64/NT imports; no runtime exports. SOURCE_AUTHORED_NOT_RUN.
# advapi32: token/SID; secur32: LSA; ntdll: object manager; object identity: rt_win_compare_object_handles (C runtime, kernelbase).
# NT BOOLEAN arguments are unsigned one-byte values, NTSTATUS signed32.
# https://learn.microsoft.com/windows/win32/api/ntsecapi/nf-ntsecapi-lsagetlogonsessiondata
# https://learn.microsoft.com/windows/win32/api/ntsecapi/ns-ntsecapi-security_logon_session_data
# https://learn.microsoft.com/windows/win32/devnotes/ntopendirectoryobject
# https://learn.microsoft.com/windows/win32/devnotes/ntquerydirectoryobject
# https://learn.microsoft.com/windows/win32/devnotes/ntopensymboliclinkobject
# https://learn.microsoft.com/windows/win32/devnotes/ntquerysymboliclinkobject
# https://learn.microsoft.com/windows/win32/api/handleapi/nf-handleapi-compareobjecthandles
@when(os="windows"):
pub use std.nogc_sync_mut.io.windows_machine_policy_abi_v1.{GetProcessHeap, HeapAlloc,
    HeapFree, CloseHandle, GetFileInformationByHandleEx, GetSecurityInfo,
    GetSecurityDescriptorLength, IsValidAcl, GetAclInformation, GetAce, IsValidSid,
    IsWellKnownSid, LocalFree, NtCreateFile, NtQueryVolumeInformationFile}
pub use std.nogc_sync_mut.io.windows_job_stream_abi_v2.{GetCurrentProcess, rt_windows_pty_owner_thread_guard_v1}
pub use std.nogc_sync_mut.io.windows_pty_abi.GetCurrentProcessId
@unsafe(reason: "actual originating native thread", capabilities: [ffi])
extern fn GetCurrentThreadId() -> u32
@unsafe(reason: "existing runtime interpretation gate, no new runtime export", capabilities: [ffi])
extern fn rt_is_interpreter_runtime() -> bool
@unsafe(reason: "existing runtime JIT gate, no new runtime export", capabilities: [ffi])
extern fn rt_is_jit_runtime() -> bool
@unsafe(reason: "actual primary process token output retained before status", capabilities: [ffi, raw_ptr])
extern fn OpenProcessToken(process: i64, access: u32, output: i64) -> i32
@unsafe(reason: "bounded native token statistics/user/session", capabilities: [ffi, raw_ptr])
extern fn GetTokenInformation(token: i64, kind: i32, buffer: i64, length: u32, returned: i64) -> i32
@unsafe(reason: "compare actual validated SID values", capabilities: [ffi, raw_ptr])
extern fn EqualSid(first: i64, second: i64) -> i32
@unsafe(reason: "native LSA-owned session data retained before NTSTATUS", capabilities: [ffi, raw_ptr])
extern fn LsaGetLogonSessionData(authentication: i64, output: i64) -> i32
@unsafe(reason: "positive NTSTATUS releases exact retained LSA allocation", capabilities: [ffi, raw_ptr])
extern fn LsaFreeReturnBuffer(buffer: i64) -> i32
@unsafe(reason: "actual current/global DOS object directory, no guessed session path", capabilities: [ffi, raw_ptr])
extern fn NtOpenDirectoryObject(output: i64, access: u32, attributes: i64) -> i32
@unsafe(reason: "bounded actual current DOS directory enumeration, no fallback lookup", capabilities: [ffi, raw_ptr])
extern fn NtQueryDirectoryObject(directory: i64, buffer: i64, length: u32,
    single_entry: u8, restart_scan: u8, context: i64, returned: i64) -> i32
@unsafe(reason: "retain actual global drive link, never caller link target", capabilities: [ffi, raw_ptr])
extern fn NtOpenSymbolicLinkObject(output: i64, access: u32, attributes: i64) -> i32
@unsafe(reason: "query retained drive target into bounded native UTF16 storage", capabilities: [ffi, raw_ptr])
extern fn NtQuerySymbolicLinkObject(link: i64, target: i64, returned: i64) -> i32
@unsafe(reason: "actual kernel object identity via C runtime (kernelbase CompareObjectHandles), not path equality", capabilities: [ffi])
extern fn rt_win_compare_object_handles(first: i64, second: i64) -> i32
@unsafe(reason: "release retained native object handle only after NTSTATUS success", capabilities: [ffi])
extern fn NtClose(handle: i64) -> i32
export GetCurrentThreadId, rt_is_interpreter_runtime, rt_is_jit_runtime,
    OpenProcessToken, GetTokenInformation, EqualSid, LsaGetLogonSessionData,
    LsaFreeReturnBuffer, NtOpenDirectoryObject, NtQueryDirectoryObject,
    NtOpenSymbolicLinkObject, NtQuerySymbolicLinkObject, rt_win_compare_object_handles, NtClose
@end
