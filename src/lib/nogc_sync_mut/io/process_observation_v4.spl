"""Exact Process Observation V4 owner facade.

The common module owns the frozen request/receipt schema. This module exposes
only the native owner types; no PID, raw core token, V3 handle, or path-spawn
fallback crosses the boundary.
"""

use std.common.process.observation_v4.{
    ProcessObservationRequestV4, ProcessObservationReceiptV4,
    ProcessObservationFrozenReceiptV4
}
use std.nogc_sync_mut.io.process_ops.{
    OwnedExecutablePin, OwnedCwdPinV4, ProcessObservationLeaseV4,
    ProcessObservationStartV4, ProcessObservationCapabilitiesV4,
    process_observation_owner_capabilities_v4,
    process_observation_owner_start_v4,
    process_observation_owner_start_pinned_v4
}

pub fn process_observation_capabilities_v4() -> Result<ProcessObservationCapabilitiesV4, text>:
    process_observation_owner_capabilities_v4()

pub fn process_observation_start_v4(
    request: ProcessObservationRequestV4
) -> Result<ProcessObservationReceiptV4, text>:
    process_observation_owner_start_v4(request)

pub fn process_observation_start_pinned_v4(
    executable: OwnedExecutablePin,
    cwd: OwnedCwdPinV4,
    request: ProcessObservationRequestV4
) -> Result<ProcessObservationStartV4, text>:
    process_observation_owner_start_pinned_v4(executable, cwd, request)

export OwnedExecutablePin, OwnedCwdPinV4, ProcessObservationLeaseV4
export ProcessObservationStartV4, ProcessObservationCapabilitiesV4
export ProcessObservationRequestV4, ProcessObservationReceiptV4
export ProcessObservationFrozenReceiptV4
export process_observation_capabilities_v4, process_observation_start_v4
export process_observation_start_pinned_v4
