# Windows-only narrow platform ABI. Native HANDLE/pointers remain in IO owners.
@unsafe(reason: "native atomic publication of one retained real owner-thread HANDLE; no rebound or raw identity escapes", capabilities: [ffi])
extern fn rt_windows_pty_owner_thread_guard_v1() -> i64
@unsafe(reason: "actual active Windows processor topology", capabilities: [ffi])
extern fn GetActiveProcessorGroupCount() -> u16
@unsafe(reason: "actual active Windows processor count for ALL groups", capabilities: [ffi])
extern fn GetActiveProcessorCount(group: u16) -> u32
@unsafe(reason: "current process pseudo-handle, never an owned closeable handle", capabilities: [ffi])
extern fn GetCurrentProcess() -> i64
@unsafe(reason: "actual current process job nesting observation", capabilities: [ffi, raw_ptr])
extern fn IsProcessInJob(process: i64, job: i64, result: i64) -> i32
@unsafe(reason: "explicit inheritance of only the child endpoints in HANDLE_LIST", capabilities: [ffi])
extern fn SetHandleInformation(handle: i64, mask: u32, flags: u32) -> i32

export GetActiveProcessorGroupCount, GetActiveProcessorCount, GetCurrentProcess, IsProcessInJob, SetHandleInformation
export rt_windows_pty_owner_thread_guard_v1
