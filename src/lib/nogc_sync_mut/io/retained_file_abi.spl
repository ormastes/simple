# Native retained regular-file boundary. ABI declarations only; ownership lives
# in retained_file. No runtime shim or subprocess fallback.
@unsafe(reason: "native owner walks bounded path and returns opaque generation token, never fd", capabilities: [ffi, raw_ptr])
extern fn rt_retained_private_credential_open_v1(path: i64, length: i64) -> i64
@unsafe(reason: "queries native authoritative credential lifecycle by generation", capabilities: [ffi])
extern fn rt_retained_private_credential_state_v1(token: i64) -> i64
@unsafe(reason: "queries retained native credential diagnostic without retrying effects", capabilities: [ffi])
extern fn rt_retained_private_credential_error_v1(token: i64) -> i64
@unsafe(reason: "copies at most512 private bytes into owned temporary buffer", capabilities: [ffi, raw_ptr])
extern fn rt_retained_private_credential_read_v1(token: i64, buffer: i64, capacity: i64) -> i64
@unsafe(reason: "publishes exactly once through retained native owner and kernel no-replace", capabilities: [ffi, raw_ptr])
extern fn rt_retained_private_credential_publish_v1(token: i64, initial: i64, initial_length: i64, ready: i64, ready_length: i64) -> i64
@unsafe(reason: "consumes native fd slots before close and never retries consumed descriptors", capabilities: [ffi])
extern fn rt_retained_private_credential_close_v1(token: i64) -> i64
export rt_retained_private_credential_open_v1, rt_retained_private_credential_state_v1, rt_retained_private_credential_error_v1
export rt_retained_private_credential_read_v1, rt_retained_private_credential_publish_v1, rt_retained_private_credential_close_v1
@when(os="windows"):
export use std.nogc_sync_mut.io.windows_process_owner_abi.{GetProcessHeap, HeapAlloc, HeapFree, CreateFileW, CloseHandle, GetFileInformationByHandleEx, ReadFile}
@unsafe(reason: "writes borrowed bounded native buffer to retained file", capabilities: [ffi, raw_ptr])
extern fn WriteFile(file: i64, buffer: i64, count: u32, written: i64, overlapped: i64) -> i32
@unsafe(reason: "flushes retained file handle", capabilities: [ffi])
extern fn FlushFileBuffers(file: i64) -> i32
@unsafe(reason: "queries exact retained native handle type", capabilities: [ffi])
extern fn GetFileType(file: i64) -> u32
@unsafe(reason: "positions exclusively owned synchronous retained file handle", capabilities: [ffi])
extern fn SetFilePointerEx(file: i64, distance: i64, position: i64, method: u32) -> i32
export WriteFile, FlushFileBuffers, GetFileType, SetFilePointerEx
@else:
export use std.nogc_sync_mut.io.path_identity_abi.{malloc, free}
@unsafe(reason: "libc open receives owned NUL terminated path and explicit flags/mode", capabilities: [ffi, raw_ptr])
extern fn open(path: i64, flags: i32, mode: u32) -> i32
@unsafe(reason: "libc retained descriptor read into owned bounded buffer", capabilities: [ffi, raw_ptr])
extern fn read(fd: i32, buffer: i64, size: u64) -> i64
@unsafe(reason: "positional retained descriptor read into owned bounded buffer without consuming cursor", capabilities: [ffi, raw_ptr])
extern fn pread(fd: i32, buffer: i64, size: u64, offset: i64) -> i64
@unsafe(reason: "libc retained descriptor write from owned bounded buffer", capabilities: [ffi, raw_ptr])
extern fn write(fd: i32, buffer: i64, size: u64) -> i64
@unsafe(reason: "closes exactly one owned descriptor", capabilities: [ffi])
extern fn close(fd: i32) -> i32
@unsafe(reason: "synchronizes retained descriptor", capabilities: [ffi])
extern fn fsync(fd: i32) -> i32
export open, read, pread, write, close, fsync
@when(os="linux"):
@unsafe(reason: "opens one nofollow child beneath an owned Linux directory descriptor", capabilities: [ffi, raw_ptr])
extern fn openat(directory_fd: i32, path: i64, flags: i32, mode: u32) -> i32
@unsafe(reason: "reads effective owner identity for a retained policy file descriptor", capabilities: [ffi])
extern fn geteuid() -> u32
@unsafe(reason: "Linux statx stable fixed layout writes 256 owned bytes for retained fd", capabilities: [ffi, raw_ptr])
extern fn statx(fd: i32, path: i64, flags: i32, mask: u32, buffer: i64) -> i32
export openat, statx, geteuid
@end
@end
