"""
# Amortized byte-chunk append

Shared append used by the stream readers in this package. Each admitted byte
is written exactly once into the retained array; the retained prefix is never
rebuilt. `buf = buf + chunk` allocated a fresh array of the whole retained
length per chunk, which is O(n^2) byte copying under one-byte fragmentation.

`io_append_chunk` returns the number of bytes it actually copied for this
append. That return is a test-observability hook, not a public API: it lets a
spec assert that cumulative copy work grows linearly in fragment count rather
than quadratically. Production callers ignore it.
"""

fn io_append_chunk(buf: [u8], chunk: [u8]) -> i64:
    """Append `chunk` into `buf` in place. Returns bytes copied by this call."""
    var copied: i64 = 0
    for b in chunk:
        buf.push(b)
        copied = copied + 1
    copied

export io_append_chunk
