# Process-local registry-lifetime tokens only. No raw descriptor or decoder.
pub struct RetainedPrivateCredentialV1:
    token: i64

pub struct RetainedPrivateCredentialOpenTurnV1:
    owner: RetainedPrivateCredentialV1?
    state: text
    error: text

pub struct RetainedPrivateCredentialStateTurnV1:
    owner: RetainedPrivateCredentialV1
    state: text
    error: text

pub struct RetainedPrivateCredentialReadTurnV1:
    owner: RetainedPrivateCredentialV1
    state: text
    bytes: [u8]
    error: text

pub struct RetainedPrivateCredentialMutationTurnV1:
    owner: RetainedPrivateCredentialV1
    state: text
    error: text
    completed: bool
    consumed: bool

pub fn retained_private_credential_phase_v1(code: i64) -> text:
    if code == 1: return "open"
    if code == 2: return "published"
    if code == 3: return "uncertain"
    if code == 4: return "closed"
    "unavailable"

pub fn retained_private_credential_error_name_v1(code: i64) -> text:
    if code == 0: return ""
    val names = ["unsupported", "invalid-argument", "registry-full", "token-exhausted", "stale-token",
        "fork-token", "path-rejected", "metadata-rejected", "io-error", "initial-changed", "publication-conflict",
        "state-denied", "publication-uncertain", "close-consumed-error", "entropy-unavailable", "noreplace-unavailable", "ready-rejected"]
    if code < -17 or code > -1: return "private-credential-native-failure"
    "private-credential-" + names[-code - 1]
