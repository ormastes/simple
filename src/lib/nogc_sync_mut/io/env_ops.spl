# Environment Operations - Pure Simple I/O
# Extracted from mod.spl for modularity

# The environment snapshot is runtime-owned and may fail allocation. Preserve
# its tuple-array representation; converting it to a Dict here would both lie
# about the ABI and allocate on every snapshot.
@unsafe(reason: "raw nullable environment snapshot returns a runtime-owned tuple array", capabilities: [ffi])
extern fn rt_env_vars() -> [(text, text)]?
use std.io_runtime.{process_run, env_set_process, env_get_opt}
use std.io_runtime.{cwd_process}

extern fn rt_file_exists(path: text) -> bool

@always_inline
fn _env_vars_raw() -> [(text, text)]?:
    unsafe(capabilities: [ffi]):
        rt_env_vars()

# Platform detection - inlined to avoid bootstrap runtime limitations
# FAIL-OPEN FIX (2026-09-02): this used to read ONLY `OS` and return false when
# it was unset -- i.e. it silently assumed Unix and handed callers "/bin/sh",
# which does not exist on Windows. `OS` is absent under a stripped environment
# (the bootstrap probe transcript captures only HOME/PATH/TMPDIR/TMP/TEMP/
# LC_ALL/LANG), so the wrong branch was taken exactly where a bootstrap runs.
#
# Signals, most specific first. COMSPEC is checked first because it NAMES the
# command processor -- it is the system variable that answers this exact
# question, and Windows always sets it. Env signals are cheap; if all of them
# are absent the decision falls through to a filesystem probe, which needs no
# environment at all and is therefore correct under `env -i`. Ambiguity (no
# signal either way, e.g. baremetal) is reported LOUDLY on stderr instead of
# being silently resolved to Unix.
fn _is_windows_platform() -> bool:
    if env_get_opt("COMSPEC") != nil:
        return true
    val os_env = env_get_opt("OS")
    if os_env != nil and os_env.lower().contains("windows"):
        return true
    if env_get_opt("SystemRoot") != nil or env_get_opt("WINDIR") != nil:
        return true

    # No environment signal. Decide from the filesystem, which cannot lie and
    # cannot be stripped. /bin/sh is present on every hosted POSIX target and
    # absent on Windows; cmd.exe is the converse.
    unsafe(capabilities: [ffi]):
        if rt_file_exists("/bin/sh"):
            return false
        if rt_file_exists("C:/Windows/System32/cmd.exe"):
            return true

    # Genuinely undecidable: no env signal, no shell of either kind on disk.
    # Say so rather than guessing quietly -- a silent wrong branch here is the
    # defect this function was rewritten to remove.
    eprint("warning: _is_windows_platform(): no platform signal (COMSPEC/OS/SystemRoot/WINDIR unset, neither /bin/sh nor cmd.exe on disk); assuming POSIX")
    false

# --- Shell helpers (local copies to avoid circular imports) ---

# NO-SHELL-HARDCODE (2026-09-02): was `process_run("/bin/sh", ["-c", command])`,
# which cannot run on a bare Windows host. Route through the platform resolver
# above so Windows gets cmd.exe and POSIX keeps /bin/sh unchanged.
fn _env_shell(command: text) -> (text, text, i64):
    if _is_windows_platform():
        process_run("cmd.exe", ["/c", command])
    else:
        process_run("/bin/sh", ["-c", command])

# reason: positional io env_ops API
fn _env_shell_output_trimmed(command: text, default: text) -> text:
    val (out, err, code) = _env_shell(command)
    if code == 0:
        out.trim()
    else:
        default

# ============================================================================
# Environment Functions
# ============================================================================

# `rt_env_get` yields nil for an UNSET variable. TOTAL with the documented
# default "": this symbol is re-exported as `std.io.env_get` across a very
# wide surface whose call sites index/concatenate the result, so it follows
# std.io_runtime.env_get's established ""-for-unset convention rather than
# widening. Callers that must tell unset from explicitly-empty use
# std.io_runtime.env_get_opt, which is nil-for-unset by construction.
fn env_get(key: text) -> text:
    env_get_opt(key) ?? ""

# reason: positional io env_ops API
fn env_set(key: text, value: text) -> bool:
    env_set_process(key, value)

fn cwd() -> text:
    cwd_process()

# TOTAL with the documented default "": HOME unset is reported as empty,
# matching std.io_runtime.env_get's documented ""-for-unset convention.
# Callers needing to distinguish unset use std.io_runtime.env_get_opt.
fn home() -> text:
    env_get_opt("HOME") ?? ""

@unsafe(reason: "environment snapshot ownership and allocation failure remain visible to the caller", capabilities: [ffi])
fn env_vars() -> [(text, text)]?:
    _env_vars_raw()

fn host_arch() -> text:
    if _is_windows_platform():
        val proc_arch = env_get("PROCESSOR_ARCHITECTURE")
        if proc_arch != "":
            match proc_arch.lower():
                case "amd64" | "x64": "x86_64"
                case "x86": "i686"
                case "arm64": "aarch64"
                case "arm": "arm"
                case _: "x86_64"
        else:
            "x86_64"
    else:
        val arch = _env_shell_output_trimmed("uname -m", "x86_64")
        match arch:
            case "x86_64" | "amd64": "x86_64"
            case "i686" | "i386" | "i586": "i686"
            case "aarch64" | "arm64": "aarch64"
            case "armv7l" | "armv7" | "arm": "armv7"
            case "riscv64": "riscv64"
            case "riscv32": "riscv32"
            case _: arch

fn host_os() -> text:
    if _is_windows_platform():
        "windows"
    else:
        val os = _env_shell_output_trimmed("uname -s", "linux")
        match os:
            case "Linux": "linux"
            case "Darwin": "macos"
            case "FreeBSD": "freebsd"
            case "OpenBSD": "openbsd"
            case "NetBSD": "netbsd"
            case _: os.lower()
