# Platform-neutral durable broker capability. The host entry installs a compiled
# launcher; live process authority remains entirely in the independent broker.
export use std.common.build_manager.group_process_protocol.{GroupProcessInputV1, GroupProcessRequestV1, GroupProcessPollV1}
use std.common.build_manager.group_process_protocol.{GroupProcessLaunchV1, group_process_launch_validate_v1, group_process_launch_encode_v1, group_process_launch_decode_v1, group_process_identity_v1, group_process_observation_decode_v1, group_process_memory_receipt_v1}
use std.common.build_manager.grouped_execution_contract.{GroupedActionLeaseV1, GroupedReapReceiptV1}
use std.common.build_manager.codec.{builder_wire_line_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write, file_create_exclusive, file_exists}
use std.nogc_sync_mut.io.time_ops.{current_time_ms, sleep_ms}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamLaunchV2, group_process_stream_launch_validate_v2, group_process_stream_launch_encode_v2, group_process_stream_launch_decode_v2, group_process_stream_identity_v2, group_process_stream_ready_encode_v2, group_process_stream_unlaunched_encode_v2}

struct GroupProcessOwnerV1:
    launch: GroupProcessLaunchV1
    identity_digest: text
    memory_provider: text = ""

# The request is retained through handoff/cleanup failure. Expiry is checked at
# launch admission, never when recovering or cleaning up this existing owner.
struct GroupProcessStreamOwnerV2:
    launch: GroupProcessStreamLaunchV2
    identity_digest: text

struct GroupProcessLauncherV1:
    operation: fn(text, text, [text], text) -> Result<bool, text>

fn _group_process_unconfigured_v1(program: text, digest: text, args: [text], directory: text) -> Result<bool, text>:
    Err("group broker platform launcher has not been configured")

var _group_process_launcher_v1 = GroupProcessLauncherV1(_group_process_unconfigured_v1)
var _group_process_configured_v1 = false
var _group_process_memory_provider_v1 = ""
var _group_process_nonce_v1: i64 = 0

fn group_process_set_launcher_v1(operation: fn(text, text, [text], text) -> Result<bool, text>, memory_provider: text = "") -> bool:
    if _group_process_configured_v1: return false
    if memory_provider != "windows" and memory_provider != "linux": return false
    _group_process_launcher_v1 = GroupProcessLauncherV1(operation)
    _group_process_memory_provider_v1 = memory_provider
    _group_process_configured_v1 = true
    true

fn _group_process_terminal_v1(owner: GroupProcessOwnerV1) -> Result<GroupProcessPollV1, text>:
    _group_process_terminal_identity_v2(owner.launch.root, owner.identity_digest)

fn _group_process_terminal_identity_v2(root: text, identity: text) -> Result<GroupProcessPollV1, text>:
    val payload = file_read_regular_no_follow_bounded(root + "/broker.tree.sdn", 4096)?
    val observed = group_process_observation_decode_v1(identity, payload)?
    if not observed.terminal or not observed.leader_reaped or not observed.tree_empty:
        return Err("group broker terminal proof is incomplete")
    # Budget admission and native process lifetime are separate facts. Windows
    # can report a peak above the configured limit even after denying a charge.
    # Preserve that value for the coordinator; it never invalidates real reap.
    Ok(observed)

fn _group_process_control_v1(owner: GroupProcessOwnerV1, command: text, budget_ms: i64) -> Result<GroupProcessPollV1, text>:
    _group_process_control_identity_v2(owner.launch.root, owner.identity_digest, command, budget_ms)

fn _group_process_control_identity_v2(root: text, identity: text, command: text, budget_ms: i64) -> Result<GroupProcessPollV1, text>:
    if file_exists(root + "/broker.tree.sdn"): return _group_process_terminal_identity_v2(root, identity)
    _group_process_nonce_v1 = _group_process_nonce_v1 + 1
    val nonce = "n" + str(getpid()) + "_" + str(current_time_ms()) + "_" + str(_group_process_nonce_v1)
    val request = identity + "\n" + nonce + "\n" + command
    if not file_atomic_write(root + "/broker.control.request", request): return Err("cannot publish group challenge")
    # Finite turns remain bounded even if the wall clock moves backwards.
    val attempts = if budget_ms <= 0: 0 else: (budget_ms + 19) / 20
    for _attempt in 0..attempts:
        if file_exists(root + "/broker.tree.sdn"): return _group_process_terminal_identity_v2(root, identity)
        match file_read_regular_no_follow_bounded(root + "/broker.control.response", 8192):
            Ok(response):
                val prefix = request + "\n"
                if response.starts_with(prefix):
                    val observed = group_process_observation_decode_v1(identity, response[prefix.len():])?
                    # Only broker.tree.sdn proves post-collect terminal cleanup.
                    if observed.terminal: return Err("terminal group observation lacks durable collected receipt")
                    return Ok(observed)
            Err(_message): pass
        sleep_ms(20)
    Err("group broker authority unknown: no fresh challenge response; retry forbidden")

fn group_process_start_v1(root: text, worker_id: text, generation: i64, snapshot_digest: text, cache_identity: text, request: GroupProcessRequestV1, memory_limit_bytes: i64, memory_policy: text = "enforce") -> Result<GroupProcessOwnerV1, text>:
    if not _group_process_configured_v1: return Err("group broker launcher unavailable on this host")
    val launch = GroupProcessLaunchV1(root, worker_id, generation, snapshot_digest, cache_identity, memory_limit_bytes, request, memory_policy)
    val invalid = group_process_launch_validate_v1(launch)
    if invalid != "": return Err(invalid)
    val payload = group_process_launch_encode_v1(launch)
    val owner = GroupProcessOwnerV1(launch, sha256_text(payload), _group_process_memory_provider_v1)
    if not file_create_exclusive(root + "/broker.claim", owner.identity_digest): return Err("group broker root already claimed; recover required")
    if not file_atomic_write(root + "/broker.request.sdn", payload): return Err("cannot persist immutable broker request")
    val launched = _group_process_launcher_v1.operation(request.broker_program, request.broker_digest,
        ["--broker-root", root, "--request-digest", owner.identity_digest], root)?
    if not launched: return Err("group broker launcher did not admit process")
    val _observed = _group_process_control_v1(owner, "probe", 30000)?
    Ok(owner)

fn group_process_recover_v1(root: text, worker_id: text, generation: i64, snapshot_digest: text, cache_identity: text, request: GroupProcessRequestV1, memory_limit_bytes: i64, memory_policy: text = "enforce") -> Result<GroupProcessOwnerV1, text>:
    val launch = GroupProcessLaunchV1(root, worker_id, generation, snapshot_digest, cache_identity, memory_limit_bytes, request, memory_policy)
    val invalid = group_process_launch_validate_v1(launch)
    if invalid != "": return Err(invalid)
    val payload = file_read_regular_no_follow_bounded(root + "/broker.request.sdn", 16777216)?
    if group_process_launch_encode_v1(launch) != payload: return Err("group restart request differs from admitted immutable request")
    val owner = GroupProcessOwnerV1(launch, sha256_text(payload), _group_process_memory_provider_v1)
    val _observed = _group_process_control_v1(owner, "probe", 30000)?
    Ok(owner)

fn group_process_poll_v1(owner: GroupProcessOwnerV1) -> Result<GroupProcessPollV1, text>:
    # Polling one unresponsive slot is bounded; the caller can inspect other
    # slots after an unknown observation. This does not revoke broker authority.
    _group_process_control_v1(owner, "probe", 100)

fn group_process_cancel_v1(owner: GroupProcessOwnerV1) -> Result<bool, text>:
    val observation = _group_process_control_v1(owner, "cancel", 30000)?
    if not observation.cancelled and not observation.terminal: return Err("group broker has not accepted cancellation")
    Ok(true)

fn group_process_peak_memory_v1(owner: GroupProcessOwnerV1) -> Result<i64, text>:
    val observation = group_process_poll_v1(owner)?
    Ok(observation.memory_peak_bytes)

fn group_process_reap_path_v1(owner: GroupProcessOwnerV1) -> text:
    owner.launch.root + "/tree-reaped.sdn"

fn group_process_collect_reap_v1(owner: GroupProcessOwnerV1, lease: GroupedActionLeaseV1) -> Result<GroupedReapReceiptV1, text>:
    if lease.worker_id != owner.launch.worker_id or lease.generation != owner.launch.generation or lease.snapshot_digest != owner.launch.snapshot_digest or lease.cache_identity != owner.launch.cache_identity:
        return Err("group reap lease differs from native broker identity")
    if lease.group_id == "" or lease.action_id == "" or lease.lease_id == "": return Err("group reap lease is incomplete")
    val observed = _group_process_terminal_v1(owner)?
    val terminal = file_read_regular_no_follow_bounded(owner.launch.root + "/broker.tree.sdn", 4096)?
    var retained = "SIMPLE-GROUP-REAP-1\n"
    for field in [lease.group_id, lease.action_id, lease.worker_id, str(lease.generation), lease.lease_id, lease.snapshot_digest, lease.cache_identity, owner.launch.request.producer_digest, owner.launch.request.broker_digest]:
        retained = retained + builder_wire_line_v1(field)
    retained = retained + terminal
    # Legacy enforced attempts retain their original reap bytes. Monitor requires
    # explicit reservation/enforcement/metric proof, bound to broker identity.
    if owner.launch.memory_policy == "monitor" or file_exists(owner.launch.root + "/broker-memory.sdn"):
        val memory = file_read_regular_no_follow_bounded(owner.launch.root + "/broker-memory.sdn", 4096)?
        val expected = group_process_memory_receipt_v1(owner.identity_digest,
            owner.launch.memory_policy, owner.launch.memory_limit_bytes,
            observed.memory_peak_bytes, owner.memory_provider)?
        if memory != expected: return Err("group memory receipt differs from admitted provider, policy or observation")
        retained = retained + builder_wire_line_v1(memory)
    val path = group_process_reap_path_v1(owner)
    if file_exists(path):
        val prior = file_read_regular_no_follow_bounded(path, 8192)?
        if prior != retained: return Err("group terminal evidence already bound to a different lease")
    elif not file_atomic_write(path, retained): return Err("cannot persist bound group terminal evidence")
    val verified = file_read_regular_no_follow_bounded(path, 8192)?
    if verified != retained: return Err("group terminal evidence persistence mismatch")
    Ok(GroupedReapReceiptV1(lease.group_id, lease.action_id, lease.worker_id, lease.generation, lease.lease_id, lease.snapshot_digest, lease.cache_identity, sha256_text(retained)))

export GroupProcessOwnerV1, group_process_set_launcher_v1
export group_process_start_v1, group_process_recover_v1, group_process_poll_v1, group_process_cancel_v1
export group_process_peak_memory_v1, group_process_collect_reap_v1, group_process_reap_path_v1

fn group_process_stream_owner_validate_v2(owner: GroupProcessStreamOwnerV2) -> text:
    val invalid = group_process_stream_launch_validate_v2(owner.launch)
    if invalid != "": return invalid
    if owner.launch.transport_generation <= 0: return "stream owner lacks a reserved transport generation"
    val identity = group_process_stream_identity_v2(owner.launch)
    if identity == "" or identity != owner.identity_digest: return "stream owner request identity differs"
    ""

fn _group_process_stream_installed_v2(owner: GroupProcessStreamOwnerV2) -> Result<bool, text>:
    val invalid = group_process_stream_owner_validate_v2(owner)
    if invalid != "": return Err(invalid)
    val claim = file_read_regular_no_follow_bounded(owner.launch.root + "/broker.claim", 128)?
    if claim != owner.identity_digest: return Err("stream broker claim differs from retained owner")
    val request = file_read_regular_no_follow_bounded(owner.launch.root + "/broker.request.sdn", 16777216)?
    if request != group_process_stream_launch_encode_v2(owner.launch):
        return Err("stream broker immutable request differs from retained owner")
    Ok(true)

# Preparation never launches. The caller already owns the reserved native ticket
# and may abandon it on this error only while native admission proves no launch.
fn group_process_stream_prepare_v2(launch: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamOwnerV2, text>:
    val owner = GroupProcessStreamOwnerV2(launch: launch, identity_digest: group_process_stream_identity_v2(launch))
    val invalid = group_process_stream_owner_validate_v2(owner)
    if invalid != "": return Err(invalid)
    if not file_create_exclusive(launch.root + "/broker.claim", owner.identity_digest):
        return Err("stream broker root already claimed; recover required")
    if not file_atomic_write(launch.root + "/broker.request.sdn", group_process_stream_launch_encode_v2(launch)):
        return Err("cannot persist immutable stream broker request")
    Ok(owner)

# Recovery restores cleanup authority only. It never launches or reconstructs
# the vanished host's descriptor/reader handle, and grant expiry cannot revoke it.
fn group_process_stream_recover_v2(root: text, identity: text) -> Result<GroupProcessStreamOwnerV2, text>:
    val payload = file_read_regular_no_follow_bounded(root + "/broker.request.sdn", 16777216)?
    val launch = group_process_stream_launch_decode_v2(payload)?
    if launch.root != root: return Err("stream broker recovery root differs")
    val owner = GroupProcessStreamOwnerV2(launch: launch, identity_digest: identity)
    val _installed = _group_process_stream_installed_v2(owner)?
    Ok(owner)

fn group_process_stream_confirm_v2(owner: GroupProcessStreamOwnerV2) -> Result<GroupProcessPollV1, text>:
    val _installed = _group_process_stream_installed_v2(owner)?
    val expected = group_process_stream_ready_encode_v2(owner.identity_digest,
        owner.launch.transport_generation, owner.launch.request.child_argv_digest)
    if expected == "": return Err("invalid stream readiness identity")
    for _attempt in 0..50:
        match file_read_regular_no_follow_bounded(owner.launch.root + "/broker.stream.ready.sdn", 4096):
            case Ok(actual):
                if actual != expected: return Err("stream readiness differs from admitted child exec")
                return _group_process_control_identity_v2(owner.launch.root, owner.identity_digest, "probe", 100)
            case Err(_reason): pass
        sleep_ms(20)
    Err("stream broker has not confirmed the admitted child exec; owner retained")

fn group_process_stream_poll_v2(owner: GroupProcessStreamOwnerV2) -> Result<GroupProcessPollV1, text>:
    val _installed = _group_process_stream_installed_v2(owner)?
    _group_process_control_identity_v2(owner.launch.root, owner.identity_digest, "probe", 100)

# Internal facade port: process_ops has already validated this exact binding in
# the native registry. A fresh identity-bound probe needs no request replay or
# full immutable-request reread on every terminal liveness turn.
fn group_process_stream_probe_bound_v2(root: text, identity: text) -> Result<GroupProcessPollV1, text>:
    _group_process_control_identity_v2(root, identity, "probe", 100)

# One bounded control turn. Accepted cancellation is not terminal proof; the
# existing independent broker continues cleanup while the service retains owner.
fn group_process_stream_cancel_v2(owner: GroupProcessStreamOwnerV2) -> Result<bool, text>:
    val _installed = _group_process_stream_installed_v2(owner)?
    val observed = _group_process_control_identity_v2(owner.launch.root, owner.identity_digest, "cancel", 100)?
    if not observed.cancelled and not observed.terminal:
        return Err("stream group cancellation remains pending")
    Ok(true)

fn group_process_stream_terminal_v2(owner: GroupProcessStreamOwnerV2) -> Result<(GroupProcessPollV1, text), text>:
    val _installed = _group_process_stream_installed_v2(owner)?
    val payload = file_read_regular_no_follow_bounded(owner.launch.root + "/broker.tree.sdn", 4096)?
    val observed = group_process_observation_decode_v1(owner.identity_digest, payload)?
    if not observed.terminal or not observed.leader_reaped or not observed.tree_empty or observed.active_processes != 0:
        return Err("stream group collected terminal proof remains incomplete")
    Ok((observed, payload))

# A failed admission with no child is a distinct fact from a reaped child tree.
# The broker may publish this receipt only after releasing any acquired parent.
fn group_process_stream_cleanup_proof_v2(owner: GroupProcessStreamOwnerV2) -> Result<text, text>:
    val _installed = _group_process_stream_installed_v2(owner)?
    val path = owner.launch.root + "/broker.stream.unlaunched.sdn"
    if file_exists(path):
        val expected = group_process_stream_unlaunched_encode_v2(owner.identity_digest,
            owner.launch.transport_generation, owner.launch.request.child_argv_digest)
        val actual = file_read_regular_no_follow_bounded(path, 4096)?
        if expected == "" or actual != expected: return Err("stream no-child admission proof differs")
        return Ok(actual)
    val (_observed, proof) = group_process_stream_terminal_v2(owner)?
    Ok(proof)

fn group_process_stream_collect_reap_v2(owner: GroupProcessStreamOwnerV2,
        lease: GroupedActionLeaseV1) -> Result<GroupedReapReceiptV1, text>:
    if lease.worker_id != owner.launch.worker_id or lease.generation != owner.launch.generation or
            lease.snapshot_digest != owner.launch.snapshot_digest or lease.cache_identity != owner.launch.cache_identity:
        return Err("stream reap lease differs from admitted broker request")
    if lease.group_id == "" or lease.action_id == "" or lease.lease_id == "":
        return Err("stream reap lease is incomplete")
    val terminal = group_process_stream_cleanup_proof_v2(owner)?
    var memory = ""
    val unlaunched = terminal.starts_with("SIMPLE-GROUP-STREAM-UNLAUNCHED-2\n")
    # The implemented stream provider is Linux cgroup/pidfd. A different broker
    # cannot acquire that capability by supplying an observation or a boolean.
    if not unlaunched:
        val observed = group_process_observation_decode_v1(owner.identity_digest, terminal)?
        memory = file_read_regular_no_follow_bounded(owner.launch.root + "/broker-memory.sdn", 4096)?
        val expected_memory = group_process_memory_receipt_v1(owner.identity_digest,
            owner.launch.memory_policy, owner.launch.memory_limit_bytes,
            observed.memory_peak_bytes, "linux")?
        if memory != expected_memory: return Err("stream memory receipt differs from admitted owner")
    var retained = "SIMPLE-GROUP-STREAM-REAP-2\n"
    for field in [lease.group_id, lease.action_id, lease.worker_id, str(lease.generation),
            lease.lease_id, lease.snapshot_digest, lease.cache_identity, owner.identity_digest,
            str(owner.launch.transport_generation), owner.launch.request.child_argv_digest,
            owner.launch.request.producer_digest, owner.launch.request.broker_digest]:
        retained = retained + builder_wire_line_v1(field)
    retained = retained + terminal + builder_wire_line_v1(memory)
    val path = owner.launch.root + "/tree-reaped.sdn"
    if file_exists(path):
        val prior = file_read_regular_no_follow_bounded(path, 16384)?
        if prior != retained: return Err("stream terminal evidence is already bound to another lease")
    elif not file_atomic_write(path, retained):
        return Err("cannot persist stream reap evidence")
    val verified = file_read_regular_no_follow_bounded(path, 16384)?
    if verified != retained: return Err("stream reap evidence persistence mismatch")
    Ok(GroupedReapReceiptV1(lease.group_id, lease.action_id, lease.worker_id,
        lease.generation, lease.lease_id, lease.snapshot_digest, lease.cache_identity, sha256_text(retained)))

export GroupProcessStreamOwnerV2, group_process_stream_owner_validate_v2
export group_process_stream_prepare_v2, group_process_stream_recover_v2, group_process_stream_confirm_v2
export group_process_stream_poll_v2, group_process_stream_cancel_v2, group_process_stream_terminal_v2
export group_process_stream_collect_reap_v2, group_process_stream_cleanup_proof_v2
export group_process_stream_probe_bound_v2
