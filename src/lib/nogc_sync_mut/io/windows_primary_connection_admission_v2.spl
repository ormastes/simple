# Opaque verified admission. A storage receipt alone never authenticates a grant.
# This lower boundary independently checks the actual enrolled deployment and
# its exact journal, current signed execution/budget and immutable plan chain.
use std.nogc_sync_mut.io.windows_journal_store_v1.WindowsJournalConsumptionV1
use std.nogc_sync_mut.io.time_ops.{time_sample_unix_micros_or_failure, time_sample_monotonic_nanos_or_failure}
use std.nogc_sync_mut.orchestration.host_windows_deployment_v2.HostWindowsDeploymentOwnerV2
use std.nogc_sync_mut.orchestration.host_service_enrollment_v2.host_service_enrollment_payload_digest_v2
use std.nogc_sync_mut.orchestration.host_helper_request_v1.{host_helper_request_load_owned_v2,
    host_helper_request_encode_v1, host_helper_execution_proof_load_owned_v2, host_helper_execution_proof_decode_v1}
use std.nogc_sync_mut.daemon_sdk.operation_dispatch_v2.daemon_operation_exact_v2
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.distributed_verify_grant_approval_from_snapshot_v2
use std.common.task_runner.distributed_operation_journal_v2.{DistributedOperationJournalV2,
    distributed_operation_journal_read_required_v3}
use std.common.contracts.container.primary_connection_consumption_v2.{ContainerPrimaryConnectionConsumptionV2,
    container_primary_connection_consumption_bytes_v2}
use std.common.contracts.container.primary_connection_v2.container_primary_connection_scope_v2
use std.common.contracts.container.execution_v2.{container_host_scope_bytes_v2, container_execution_plan_bytes_v2}
use std.common.contracts.container.exec_v3.exec_runtime_bytes_v3
use std.common.contracts.container.runtime_v1.RUNTIME_STATUS_OK
use std.nogc_sync_mut.orchestration.host_execution_envelope_v2.host_execution_decode_v2
use std.nogc_sync_mut.orchestration.host_execution_observation_v2.host_execution_observation_load_owned_v3
use std.nogc_sync_mut.orchestration.host_execution_intent_v1.host_execution_intent_load_owned_v3
use std.common.contracts.container.effect_deadline_v1.container_effect_remaining_ms_v1
use std.common.contracts.orchestration.host_helper_plan_v1.host_helper_plan_bytes_v1
use std.common.contracts.orchestration.host_reservation_codec_v1.{host_reservation_encode_intent_v1,
    host_helper_reservation_match_receipt_v1}
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.contracts.container.primary_connection_attempt_v3.{ContainerPrimaryConnectionAttemptEvidenceV3,
    container_primary_connection_attempt_encode_v3}
use std.common.crypto.sha256.sha256_text
use std.nogc_async_mut.container.providers.windows.docker_policy_codec_v1.windows_docker_policy_decode_v1

pub class WindowsPrimaryConnectionVerifiedV2:
    deployment: HostWindowsDeploymentOwnerV2
    journal: DistributedOperationJournalV2
    record: ContainerPrimaryConnectionConsumptionV2
    receipt: WindowsJournalConsumptionV1

    pub fn record_v2() -> ContainerPrimaryConnectionConsumptionV2: self.record

pub class WindowsPrimaryConnectionWindowV2:
    started_nanos: i64
    deadline_nanos: i64

    pub fn started_v3() -> i64: self.started_nanos
    pub fn deadline_v3() -> i64: self.deadline_nanos

# A positive claim under the retained cleanup owner seals every admission alias.
# This capability cannot open a pipe, even after a launch grant has expired.
pub class WindowsPrimaryConnectionAbandonmentV3:
    record: ContainerPrimaryConnectionConsumptionV2

    pub fn bytes_v3(expected: ContainerPrimaryConnectionConsumptionV2) -> Result<text, text>:
        val actual = container_primary_connection_consumption_bytes_v2(self.record)?
        if actual != container_primary_connection_consumption_bytes_v2(expected)?:
            return Err("primary-connection-abandonment-record-mismatch")
        container_primary_connection_attempt_encode_v3(ContainerPrimaryConnectionAttemptEvidenceV3(
            expected.plan.request_digest, sha256_text(actual), "not-opened", nil, nil))

pub fn windows_primary_connection_abandon_v3(deployment: HostWindowsDeploymentOwnerV2,
        journal: DistributedOperationJournalV2, record: ContainerPrimaryConnectionConsumptionV2,
        receipt: WindowsJournalConsumptionV1) -> Result<WindowsPrimaryConnectionAbandonmentV3, text>:
    val bytes = container_primary_connection_consumption_bytes_v2(record)?
    val store = match journal.windows_store:
        case Some(value): value
        case nil: return Err("primary-connection-enrolled-journal-required")
    val metadata = deployment.current_for_store_v3(store)?
    val binding = deployment.binding_v2()
    if not receipt.belongs_to(store): return Err("primary-connection-journal-origin-mismatch")
    if (record.plan.journal_lease_digest != journal.lease_digest or
            record.plan.installation_digest != host_service_enrollment_payload_digest_v2(binding)? or
            record.plan.policy_digest != binding.engine_policy_digest or
            record.plan.provider_identity_digest != binding.provider_identity_digest or
            record.authority_policy_digest != binding.policy_digest):
        return Err("primary-connection-cleanup-owner-mismatch")
    val operation = record.admission.operation
    if (daemon_operation_exact_v2(journal, operation)?).state != "executing":
        return Err("primary-connection-executing-helper-required")
    if distributed_operation_journal_read_required_v3(journal,
            "primary-connection-consumed/" + sha256_text(operation.id) + ".sdn", 8388608)? != bytes:
        return Err("primary-connection-protected-consumption-mismatch")
    val request = host_helper_request_load_owned_v2(journal, operation.id)?
    if (request.plan.helper_kind != "primary-connection" or
            distributed_encode_operation_v2(request.operation)? != distributed_encode_operation_v2(operation)? or
            host_helper_plan_bytes_v1(request.plan)? != host_helper_plan_bytes_v1(record.admission.plan)? or
            host_reservation_encode_intent_v1(request.intent)? != host_reservation_encode_intent_v1(record.admission.intent)? or
            sha256_text(host_helper_request_encode_v1(request)?) != record.packet_digest):
        return Err("primary-connection-cleanup-request-chain")
    val matched = host_helper_reservation_match_receipt_v1(record.admission.receipt, request.intent, operation)?
    val proof_bytes = host_helper_execution_proof_load_owned_v2(journal, operation.id)?
    if sha256_text(proof_bytes) != record.execution_proof_digest:
        return Err("primary-connection-execution-proof-digest")
    val proof = host_helper_execution_proof_decode_v1(request, proof_bytes)?
    # Historical signed execution was admitted before this immutable archive;
    # cleanup neither refreshes its expiry nor creates any launch permission.
    if not receipt.claim(bytes)?: return Err("primary-connection-consumption-not-claimed")
    Ok(WindowsPrimaryConnectionAbandonmentV3(record))

fn verify_v2(deployment: HostWindowsDeploymentOwnerV2, journal: DistributedOperationJournalV2,
        record: ContainerPrimaryConnectionConsumptionV2, receipt: WindowsJournalConsumptionV1) -> Result<(), text>:
    val bytes = container_primary_connection_consumption_bytes_v2(record)?
    val store = match journal.windows_store:
        case Some(value): value
        case nil: return Err("primary-connection-enrolled-journal-required")
    val metadata = deployment.current_for_store_v3(store)?
    val binding = deployment.binding_v2()
    if not receipt.belongs_to(store):
        return Err("primary-connection-journal-origin-mismatch")
    val plan = record.plan
    val scope = container_primary_connection_scope_v2(plan)
    val engine_policy = windows_docker_policy_decode_v1(metadata.engine_policy_bytes)?
    if (plan.installation_digest != host_service_enrollment_payload_digest_v2(binding)? or
            plan.journal_lease_digest != journal.lease_digest or
            plan.policy_digest != binding.engine_policy_digest or plan.policy_digest != sha256_text(metadata.engine_policy_bytes) or
            plan.provider_identity_digest != binding.provider_identity_digest or record.authority_policy_digest != binding.policy_digest or
            scope.physical_host_id != binding.physical_host_id or scope.service_scope_id != binding.service_scope_id or
            scope.native_machine_id != binding.native_machine_id or scope.provider_generation != engine_policy.provider_generation or
            scope.boot_id != "" or scope.continuity_mode != "service-incarnation-v1"):
        return Err("primary-connection-protected-policy-plan")
    val admission = record.admission
    val operation = admission.operation
    val state = daemon_operation_exact_v2(journal, operation)?
    if state.state != "executing": return Err("primary-connection-executing-helper-required")
    if distributed_operation_journal_read_required_v3(journal,
            "primary-connection-consumed/" + sha256_text(operation.id) + ".sdn", 8388608)? != bytes:
        return Err("primary-connection-protected-consumption-mismatch")
    val request = host_helper_request_load_owned_v2(journal, operation.id)?
    if (distributed_encode_operation_v2(request.operation)? != distributed_encode_operation_v2(operation)? or
            host_helper_plan_bytes_v1(request.plan)? != host_helper_plan_bytes_v1(admission.plan)? or
            host_reservation_encode_intent_v1(request.intent)? != host_reservation_encode_intent_v1(admission.intent)? or
            record.packet_digest != sha256_text(host_helper_request_encode_v1(request)?)):
        return Err("primary-connection-retained-helper-chain")
    val matched = host_helper_reservation_match_receipt_v1(admission.receipt, request.intent, operation)?
    val parent = daemon_operation_exact_v2(journal, request.parent_binding.host_operation)?
    if parent.state != "executing": return Err("primary-connection-executing-parent-required")
    # The signed helper names a requested target; independently bind it to the
    # actual retained parent execution and original native creation identity.
    val parent_id = plan.identity.parent_operation_id
    val parent_packet = distributed_operation_journal_read_required_v3(journal,
        "host-execute-packets/" + sha256_text(parent_id) + ".sdn", 2097152)?
    val parent_request = host_execution_decode_v2(parent_packet, scope)?
    if (distributed_encode_operation_v2(parent_request.operation)? != distributed_encode_operation_v2(request.parent_binding.host_operation)? or
            container_execution_plan_bytes_v2(parent_request.execution.plan)? != container_execution_plan_bytes_v2(plan.workload)?):
        return Err("primary-connection-parent-execution-plan")
    val observed = host_execution_observation_load_owned_v3(journal, parent_id)?
    val created = host_execution_intent_load_owned_v3(journal, parent_id)?
    val runtime = plan.runtime
    if (exec_runtime_bytes_v3(observed.runtime)? != exec_runtime_bytes_v3(runtime)? or
            container_host_scope_bytes_v2(observed.scope)? != container_host_scope_bytes_v2(scope)? or
            observed.operation_digest != sha256_text(distributed_encode_operation_v2(parent_request.operation)?) or
            observed.plan_digest != parent_request.intent.plan_digest or observed.request_digest != plan.workload.request_digest or
            observed.grant_id != parent_request.signed.grant.id or observed.principal != parent_request.signed.grant.principal or
            observed.issuer_id != parent_request.signed.issuer_id or observed.approver_id != parent_request.approval.approver_id or
            observed.provider_identity_digest != plan.provider_identity_digest or observed.phase != "running" or
            observed.create_status != RUNTIME_STATUS_OK or observed.start_status != RUNTIME_STATUS_OK or observed.inspect_status != RUNTIME_STATUS_OK):
        return Err("primary-connection-parent-native-observation")
    if (created.pod_uid != runtime.pod_uid or created.attempt != runtime.attempt or
            created.provider_generation != runtime.provider_generation or created.operation_id != runtime.operation_id or
            created.engine != runtime.engine or created.native_id != runtime.native_id or created.node_boot_id != runtime.node_boot_id or
            created.phase != "created"):
        return Err("primary-connection-parent-native-creation")
    if container_host_scope_bytes_v2(request.budget_proof.budget.scope)? != container_host_scope_bytes_v2(scope)?:
        return Err("primary-connection-budget-scope")
    val proof_bytes = host_helper_execution_proof_load_owned_v2(journal, operation.id)?
    if sha256_text(proof_bytes) != record.execution_proof_digest: return Err("primary-connection-execution-proof-digest")
    val proof = host_helper_execution_proof_decode_v1(request, proof_bytes)?
    val policy = metadata.policy
    if (record.policy_revision != policy.snapshot.policy_revision or record.revocation_epoch != policy.snapshot.revocation_epoch or
            record.session_generation != policy.session_generation): return Err("primary-connection-authority-context-changed")
    val now = time_sample_unix_micros_or_failure()
    if now <= 0: return Err("primary-connection-clock-unavailable")
    var execute = operation
    execute.operation = "host_helper_execute_v1"
    val grant = distributed_verify_grant_approval_from_snapshot_v2(policy.snapshot, proof.signed, proof.approval,
        execute, now / 1000, policy.snapshot.generation, record.policy_revision, record.revocation_epoch, record.session_generation)?
    val budget = request.budget_proof
    val budget_grant = distributed_verify_grant_approval_from_snapshot_v2(policy.snapshot, budget.signed, budget.approval,
        budget.operation, now / 1000, policy.snapshot.generation, record.policy_revision, record.revocation_epoch, record.session_generation)?
    var expiry = grant.expires_at
    for bound in [proof.approval.expires_at, budget_grant.expires_at, budget.approval.expires_at]:
        if bound < expiry: expiry = bound
    if (admission.deadline.expires_at_unix_ms != expiry or admission.grant_id != grant.id or
            admission.issuer_id != proof.signed.issuer_id or admission.approver_id != proof.approval.approver_id):
        return Err("primary-connection-verified-grant-mismatch")
    val after = time_sample_unix_micros_or_failure()
    if after < now: return Err("primary-connection-clock-regressed")
    val remaining = container_effect_remaining_ms_v1(admission.deadline, plan.request_digest,
        plan.identity.operation_id, "attach", after / 1000)?
    val current = deployment.current_for_store_v3(store)?
    Ok(())

# This is the only constructor. Public raw roots, policy bytes, unsigned record
# metadata and ordinary publication cannot construct the verified capability.
pub fn windows_primary_connection_authorize_v2(deployment: HostWindowsDeploymentOwnerV2,
        journal: DistributedOperationJournalV2, record: ContainerPrimaryConnectionConsumptionV2,
        receipt: WindowsJournalConsumptionV1) -> Result<WindowsPrimaryConnectionVerifiedV2, text>:
    verify_v2(deployment, journal, record, receipt)?
    Ok(WindowsPrimaryConnectionVerifiedV2(deployment, journal, record, receipt))

# Recheck independently at actual acquisition, before one-use claim or pipe IO.
# Copies share the same native receipt: successful claim can never be replayed.
pub fn windows_primary_connection_claim_v2(admission: WindowsPrimaryConnectionVerifiedV2) -> Result<WindowsPrimaryConnectionWindowV2, text>:
    verify_v2(admission.deployment, admission.journal, admission.record, admission.receipt)?
    val record = admission.record
    val bytes = container_primary_connection_consumption_bytes_v2(record)?
    val started = time_sample_monotonic_nanos_or_failure()
    val unix = time_sample_unix_micros_or_failure()
    if started < 0 or unix <= 0: return Err("primary-connection-clock-unavailable")
    val remaining = container_effect_remaining_ms_v1(record.admission.deadline, record.plan.request_digest,
        record.plan.identity.operation_id, "attach", unix / 1000)?
    val timeout = if remaining < record.plan.timeout_ms: remaining else: record.plan.timeout_ms
    if timeout <= 0 or started > 9223372036854775807 - timeout * 1000000:
        return Err("primary-connection-deadline-overflow")
    val deadline = started + timeout * 1000000
    if not admission.receipt.claim(bytes)?: return Err("primary-connection-consumption-not-claimed")
    # Return the positive claim even if the clock expires immediately afterwards.
    # The exchange checks this window before acquisition and retains typed absence.
    Ok(WindowsPrimaryConnectionWindowV2(started, deadline))
