"""Immutable encoding selection shared by concrete file/network text sessions.

Ordinary session methods accept and return internal text. Public configuration
accessors return only typed scalar metadata; transport owners build their formats.
No compiler coercion, mutable global encoding, or erased transport is introduced.
"""
use std.common.encoding.external_text.{Encoding, TextByteOrder, BomPolicy, ExternalFormat}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_external_text}

pub val TEXT_SESSION_BYTE_LIMIT: i64 = 16777216

pub class TextSessionCodec:
    _read_encoding: Encoding
    _read_byte_order: TextByteOrder
    _read_bom: BomPolicy
    _write_encoding: Encoding
    _write_byte_order: TextByteOrder
    _write_bom: BomPolicy
    _max_input_bytes: i64
    _max_output_bytes: i64

    pub fn read_encoding() -> Encoding:
        self._read_encoding

    pub fn read_byte_order() -> TextByteOrder:
        self._read_byte_order

    pub fn read_bom() -> BomPolicy:
        self._read_bom

    pub fn write_encoding() -> Encoding:
        self._write_encoding

    pub fn write_byte_order() -> TextByteOrder:
        self._write_byte_order

    pub fn write_bom() -> BomPolicy:
        self._write_bom

    pub fn input_byte_limit() -> i64:
        self._max_input_bytes

    pub fn output_byte_limit() -> i64:
        self._max_output_bytes

    pub fn validate() -> Result<(), TextIoError>:
        """Admit the profile before attaching it to a resource or doing I/O.

        Owners call this once on construction, including defensive admission of
        directly constructed values. Shared codec metadata validation stays in
        the existing owner; these empty external values never decode BOM input.
        """
        if self._max_input_bytes <= 0 or self._max_input_bytes > TEXT_SESSION_BYTE_LIMIT:
            return Err(TextIoError.Io("text session input byte limit must be 1..16777216; select a positive bounded limit"))
        if self._max_output_bytes <= 0 or self._max_output_bytes > TEXT_SESSION_BYTE_LIMIT:
            return Err(TextIoError.Io("text session output byte limit must be 1..16777216; select a positive bounded limit"))
        val input = ExternalFormat(encoding: self._read_encoding, byte_order: self._read_byte_order, bom: self._read_bom)
        val output = ExternalFormat(encoding: self._write_encoding, byte_order: self._write_byte_order, bom: self._write_bom)
        val read_admission = io_external_text([], input)?
        val write_admission = io_external_text([], output)?
        Ok(())

pub fn text_session_codec(read_encoding: Encoding, read_byte_order: TextByteOrder, read_bom: BomPolicy, write_encoding: Encoding, write_byte_order: TextByteOrder, write_bom: BomPolicy, max_input_bytes: i64, max_output_bytes: i64) -> Result<TextSessionCodec, TextIoError>:
    """Select input and output codecs once; unknown metadata is a typed error."""
    val codec = TextSessionCodec(_read_encoding: read_encoding, _read_byte_order: read_byte_order, _read_bom: read_bom, _write_encoding: write_encoding, _write_byte_order: write_byte_order, _write_bom: write_bom, _max_input_bytes: max_input_bytes, _max_output_bytes: max_output_bytes)
    codec.validate()?
    Ok(codec)

pub fn utf8_text_session_codec(max_input_bytes: i64, max_output_bytes: i64) -> Result<TextSessionCodec, TextIoError>:
    """Explicit compatibility profile: UTF-8 both ways, U+FEFF remains content."""
    text_session_codec(Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, max_input_bytes, max_output_bytes)

export TextSessionCodec, TEXT_SESSION_BYTE_LIMIT, text_session_codec, utf8_text_session_codec
