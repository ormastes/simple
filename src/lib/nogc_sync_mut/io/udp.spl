"""
# Sync UDP I/O

UDP datagram socket implementing Close trait.
Connectionless, message-oriented network I/O.

## Components

| Type | Traits | Description |
|------|--------|-------------|
| UdpSocket | Close | Datagram socket for send/recv |

## Send and Receive

```simple
val socket = UdpSocket.bind("127.0.0.1:0")?
val addr = socket.local_addr()?

# In real code with two sockets:
# socket.send_to([72, 105], "127.0.0.1:9001")?
# val (data, sender) = socket.recv_from(1024)?

socket.close()?
```

## Connected Mode

```simple
val socket = UdpSocket.bind("127.0.0.1:0")?
# socket.connect("127.0.0.1:9001")?
# socket.send([72, 105])?
# val data = socket.recv(1024)?
socket.close()?
```
"""

use std.io.traits.{Close}
use std.io.types.{IoError, IoErrorKind}

# ============================================================================
# UdpSocket - UDP Datagram Socket
# ============================================================================

class UdpSocket with Close:
    """UDP datagram socket.

    Connectionless socket for sending/receiving datagrams.
    Does not implement Read/Write since UDP is message-oriented,
    not stream-oriented.

    Example:
        val socket = UdpSocket.bind("127.0.0.1:9000")?
        socket.send_to([72, 105], "127.0.0.1:9001")?
        val (data, sender) = socket.recv_from(1024)?
        socket.close()?
    """
    fd: i64
    open: bool

    static fn bind(addr: text) -> Result<UdpSocket, IoError>:
        """Bind to address.

        Args:
            addr: Address in "host:port" format

        Returns:
            Result with UdpSocket or error
        """
        val fd = unsafe(capabilities: [ffi]):
            rt_io_udp_bind(addr)
        if fd < 0:
            return Err(IoError(kind: IoErrorKind.AddrInUse, message: "udp bind failed: {addr}", source: nil))
        Ok(UdpSocket(fd: fd, open: true))

    # --- Datagram operations ---

    fn recv_from(size: i64) -> Result<([u8], text), IoError>:
        """Receive datagram with sender address.

        Args:
            size: Maximum bytes to receive

        Returns:
            Result with (data, sender_address) tuple
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "socket is closed", source: nil))
        if size < 0 or size > 65535:
            return Err(IoError(kind: IoErrorKind.Other, message: "UDP receive size must be 0..65535", source: nil))
        val result = unsafe(capabilities: [ffi]):
            rt_io_udp_recv_from(self.fd, size)
        if result == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "recv_from failed", source: nil))
        Ok(result)

    fn send_to(data: [u8], addr: text) -> Result<i64, IoError>:
        """Send datagram to address.

        Args:
            data: Bytes to send
            addr: Destination address

        Returns:
            Result with bytes sent
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "socket is closed", source: nil))
        val sent = unsafe(capabilities: [ffi]):
            rt_io_udp_send_to(self.fd, data, addr)
        if sent < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "send_to failed", source: nil))
        Ok(sent)

    fn connect(addr: text) -> Result<(), IoError>:
        """Set default peer address.

        After connect(), use send/recv instead of send_to/recv_from.

        Args:
            addr: Remote address

        Returns:
            Result or error
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "socket is closed", source: nil))
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_connect(self.fd, addr)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "udp connect failed: {addr}", source: nil))
        Ok(())

    fn send(data: [u8]) -> Result<i64, IoError>:
        """Send to connected peer.

        Requires prior connect().

        Args:
            data: Bytes to send

        Returns:
            Result with bytes sent
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "socket is closed", source: nil))
        val sent = unsafe(capabilities: [ffi]):
            rt_io_udp_send(self.fd, data)
        if sent < 0:
            return Err(IoError(kind: IoErrorKind.Other, message: "send failed", source: nil))
        Ok(sent)

    fn recv(size: i64) -> Result<[u8], IoError>:
        """Receive from connected peer.

        Requires prior connect().

        Args:
            size: Maximum bytes to receive

        Returns:
            Result with bytes received
        """
        if not self.open:
            return Err(IoError(kind: IoErrorKind.Other, message: "socket is closed", source: nil))
        if size < 0 or size > 65535:
            return Err(IoError(kind: IoErrorKind.Other, message: "UDP receive size must be 0..65535", source: nil))
        val data = unsafe(capabilities: [ffi]):
            rt_io_udp_recv(self.fd, size)
        if data == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "recv failed", source: nil))
        Ok(data.unwrap())

    fn local_addr() -> Result<text, IoError>:
        """Get local bound address.

        Returns:
            Result with address string
        """
        val addr = unsafe(capabilities: [ffi]):
            rt_io_udp_local_addr(self.fd)
        if addr == nil:
            return Err(IoError(kind: IoErrorKind.Other, message: "local_addr failed", source: nil))
        Ok(addr)

    fn set_broadcast(enabled: bool) -> Result<(), IoError>:
        """Enable/disable broadcast.

        Args:
            enabled: true to enable broadcast

        Returns:
            Result or error
        """
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_set_broadcast(self.fd, enabled)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_broadcast failed", source: nil))
        Ok(())

    fn set_multicast_loop(enabled: bool) -> Result<(), IoError>:
        """Enable or disable multicast loopback for this socket family."""
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_set_multicast_loop(self.fd, enabled)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_multicast_loop failed", source: nil))
        Ok(())

    fn join_multicast(multicast_addr: text) -> Result<(), IoError>:
        """Join an IPv4 or IPv6 multicast group on the default interface."""
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_join_multicast(self.fd, multicast_addr)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "join_multicast failed: {multicast_addr}", source: nil))
        Ok(())

    fn leave_multicast(multicast_addr: text) -> Result<(), IoError>:
        """Leave an IPv4 or IPv6 multicast group on the default interface."""
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_leave_multicast(self.fd, multicast_addr)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "leave_multicast failed: {multicast_addr}", source: nil))
        Ok(())

    fn set_read_timeout(ms: i64?) -> Result<(), IoError>:
        """Set read timeout.

        Args:
            ms: Timeout in ms, or nil for no timeout

        Returns:
            Result or error
        """
        val raw_ms = if ms.?: ms.unwrap() else: -1
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_set_read_timeout(self.fd, raw_ms)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_read_timeout failed", source: nil))
        Ok(())

    fn set_nonblocking(enabled: bool) -> Result<(), IoError>:
        """Enable or disable non-blocking mode."""
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_set_nonblocking(self.fd, enabled)
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "set_nonblocking failed", source: nil))
        Ok(())

    # --- Close trait ---

    me close() -> Result<(), IoError>:
        """Close socket."""
        if not self.open:
            return Ok(())
        val ok = unsafe(capabilities: [ffi]):
            rt_io_udp_close(self.fd)
        self.open = false
        if not ok:
            return Err(IoError(kind: IoErrorKind.Other, message: "close failed", source: nil))
        Ok(())

    fn is_open() -> bool:
        """Check if socket is open."""
        self.open

# ============================================================================
# SFFI Functions
# ============================================================================

@unsafe(reason: "raw UDP descriptor; negative sentinel means bind failed", capabilities: [ffi])
extern fn rt_io_udp_bind(addr: text) -> i64
@unsafe(reason: "raw UDP receive writes one bounded runtime buffer; nil means provider failure or no datagram", capabilities: [ffi])
extern fn rt_io_udp_recv_from(fd: i64, size: i64) -> ([u8], text)?
@unsafe(reason: "raw UDP send borrows packed bytes for the call; negative result means provider failure", capabilities: [ffi])
extern fn rt_io_udp_send_to(fd: i64, data: [u8], addr: text) -> i64
@unsafe(reason: "raw UDP descriptor and foreign address parse; false means connect failed", capabilities: [ffi])
extern fn rt_io_udp_connect(fd: i64, addr: text) -> bool
@unsafe(reason: "raw connected UDP send borrows packed bytes for the call; negative result means provider failure", capabilities: [ffi])
extern fn rt_io_udp_send(fd: i64, data: [u8]) -> i64
@unsafe(reason: "raw connected UDP receive writes one bounded runtime buffer; nil means provider failure or no datagram", capabilities: [ffi])
extern fn rt_io_udp_recv(fd: i64, size: i64) -> [u8]?
@unsafe(reason: "raw UDP descriptor address query; nil means provider failure", capabilities: [ffi])
extern fn rt_io_udp_local_addr(fd: i64) -> text?
@unsafe(reason: "raw UDP descriptor option mutation; false means broadcast update failed", capabilities: [ffi])
extern fn rt_io_udp_set_broadcast(fd: i64, enabled: bool) -> bool
@unsafe(reason: "raw UDP descriptor multicast-loop mutation; false means update failed", capabilities: [ffi])
extern fn rt_io_udp_set_multicast_loop(fd: i64, enabled: bool) -> bool
@unsafe(reason: "raw UDP descriptor and multicast address; false means join failed", capabilities: [ffi])
extern fn rt_io_udp_join_multicast(fd: i64, multicast_addr: text) -> bool
@unsafe(reason: "raw UDP descriptor and multicast address; false means leave failed", capabilities: [ffi])
extern fn rt_io_udp_leave_multicast(fd: i64, multicast_addr: text) -> bool
@unsafe(reason: "raw UDP descriptor timeout mutation; negative ms clears timeout and false means update failed", capabilities: [ffi])
extern fn rt_io_udp_set_read_timeout(fd: i64, ms: i64) -> bool
@unsafe(reason: "raw UDP descriptor mode mutation; false means update failed", capabilities: [ffi])
extern fn rt_io_udp_set_nonblocking(fd: i64, enabled: bool) -> bool
@unsafe(reason: "raw UDP descriptor close consumes one live descriptor; false means close failed", capabilities: [ffi])
extern fn rt_io_udp_close(fd: i64) -> bool

# ============================================================================
# Exports
# ============================================================================
