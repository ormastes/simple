# Signal Handler Management - SFFI Wrapper
#
# Provides signal handling for graceful shutdown on SIGTERM/SIGINT/SIGHUP.
# Requires SFFI additions to runtime for actual signal registration.

# FIX (2026-02-22): Import exit directly from cli_ops instead of the hub module.
# The hub (app.io.mod) transitively loads cli_ops, debug_stubs, volatile_ops, etc.
# which increases RSS from ~52 MB to ~3 GB. Direct import avoids this.
# exit is provided by the CLI layer; declare extern directly to avoid lib→app dependency
extern fn rt_exit(code: i64)
fn exit(code: i64):
    rt_exit(code)

fn exit_i32(code: i32) -> void:
    """Thin i32 wrapper over exit(), for call sites typed at i32 (rt_lanes/examples 2026-08-28)."""
    rt_exit(code as i64)

# ============================================================================
# SFFI Declarations (use stubs until runtime implementation available)
# ============================================================================

# Import stub implementations (will be replaced by actual SFFI later)
use std.nogc_sync_mut.io.signal_stubs.{signal_handler_install}

# ============================================================================
# Signal Numbers (POSIX standard)
# ============================================================================

val SIGHUP = 1    # Hangup (terminal closed)
val SIGINT = 2    # Interrupt (Ctrl+C)
val SIGKILL = 9   # Kill (cannot be caught)
val SIGSEGV = 11  # Segmentation fault (synchronous fault; see on_segfault below)
val SIGUSR2 = 12  # User-defined signal 2 (e.g. live memory-dump trigger)
val SIGTERM = 15  # Termination request

# ============================================================================
# Global Cleanup Handler Reference
# ============================================================================

# NOTE: This needs to be set by the test runner before installing handlers
var _global_cleanup_handler: fn() = default_cleanup_handler
var _signal_handlers_installed: bool = false

# User-suppliable SIGUSR2 handler (e.g. mem.dump.install_mem_dump_on_usr2).
# Unlike the cleanup handler, SIGUSR2 handling never exits the process.
var _sigusr2_handler: fn() = default_cleanup_handler
var _sigusr2_handler_installed: bool = false

# The installed cleanup handler is process-global, so the factory state is too.
# Keeping it here avoids a returned nested closure, which LLVM cannot lower.
var _signal_cleanup_processes: fn() -> i64 = default_cleanup_count
var _signal_cleanup_containers: fn() -> i64 = default_cleanup_count
var _signal_cleanup_checkpoint: fn() = default_cleanup_handler

fn default_cleanup_handler():
    ()

fn default_cleanup_count() -> i64:
    0

fn run_global_cleanup_handler():
    # ponytail: local indirect call until native codegen supports calling fn globals.
    val cleanup = _global_cleanup_handler
    cleanup()

# ============================================================================
# Signal Handler Installation
# ============================================================================

fn install_signal_handlers(cleanup_handler: fn()) -> bool:
    """
    Install signal handlers for graceful shutdown.

    Args:
        cleanup_handler: Function to call on signal (should cleanup resources)

    Returns: true if handlers installed, false if SFFI not available

    Usage:
        fn my_cleanup():
            cleanup_all_children()
            exit(130)

        install_signal_handlers(my_cleanup)
    """
    # Store cleanup handler reference
    _global_cleanup_handler = cleanup_handler

    if _signal_handlers_installed:
        return true

    # Install handlers for common signals
    val int_installed = signal_handler_install(SIGINT, on_sigint)
    val term_installed = signal_handler_install(SIGTERM, on_sigterm)
    val hup_installed = signal_handler_install(SIGHUP, on_sighup)
    val installed = int_installed and term_installed and hup_installed
    _signal_handlers_installed = installed
    installed

fn install_sigusr2_handler(handler: fn()) -> bool:
    """
    Install a SIGUSR2 handler with a user-suppliable callback.

    Unlike install_signal_handlers, this does NOT terminate the process --
    SIGUSR2 is meant for live in-process triggers (e.g. dumping a memory
    snapshot to a well-known path) while the program keeps running.

    Args:
        handler: Function to call when SIGUSR2 is received

    Returns: true if the handler installed, false if SFFI not available

    Usage:
        install_sigusr2_handler(fn(): dump_snapshot())
    """
    _sigusr2_handler = handler

    if _sigusr2_handler_installed:
        return true

    val installed = signal_handler_install(SIGUSR2, on_sigusr2)
    _sigusr2_handler_installed = installed
    installed

# ============================================================================
# SIGSEGV (synchronous fault) — supervisor-side callback registration
# ============================================================================

# User-suppliable segfault handler. Unlike every other handler in this module
# it is NOT reached from a signal disposition; see on_segfault for why.
var _segfault_handler: fn() = default_cleanup_handler
var _segfault_handler_registered: bool = false

fn on_segfault(handler: fn()) -> bool:
    """
    Register a callback to run when a SIGSEGV death is observed.

    SIGSEGV is delivered SYNCHRONOUSLY with the faulting instruction, so it
    cannot be handled with the latch-and-return discipline this module uses for
    SIGINT/SIGTERM/SIGHUP/SIGUSR2: returning from the handler re-executes the
    faulting instruction, which is an unbreakable fault loop. Installing a
    disposition here would also sigaction-replace the C runtime's always-on
    crash handler (rt_install_crash_handler, src/runtime/runtime.c), losing the
    faulting address, the si_code fault classification and the backtrace.
    signal_handler_install (signal_stubs.spl) refuses signal 11 for exactly
    that reason, and this function deliberately does not try to route around it.

    The callback therefore does not run inside the faulting process -- nothing
    in that process is still running after the crash handler's _exit(139). It
    runs in the SUPERVISOR: report_child_segfault() invokes it once a child has
    been reaped with a SIGSEGV status, which is the only point at which Simple
    code can observe a segfault and still be executing.

    Args:
        handler: Function to call when a supervised child dies of SIGSEGV

    Returns: true once the callback is registered

    Usage:
        on_segfault(fn(): print "child segfaulted")
        report_child_segfault(exit_code_of_reaped_child)
    """
    _segfault_handler = handler
    _segfault_handler_registered = true
    true

fn exit_code_is_segfault(exit_code: i64) -> bool:
    """True for the shell-convention exit code of a SIGSEGV death (128 + 11)."""
    exit_code == 128 + SIGSEGV

fn report_child_segfault(child_exit_code: i64) -> bool:
    """
    Dispatch the registered on_segfault callback for a reaped child.

    Returns true only when the status really is a SIGSEGV death AND a callback
    was registered, so a caller cannot mistake "nothing to report" for "handled".
    """
    if not exit_code_is_segfault(child_exit_code):
        return false
    if not _segfault_handler_registered:
        return false
    val handler = _segfault_handler
    handler()
    true

# ============================================================================
# Signal Handler Callbacks
# ============================================================================

fn on_sigint():
    """
    Handle SIGINT (Ctrl+C).

    Exit code: 130 (128 + 2)
    """
    print ""
    print "[SIGNAL] SIGINT received (Ctrl+C)"
    print "[SIGNAL] Cleaning up resources..."

    run_global_cleanup_handler()

    # Exit with standard SIGINT code
    exit(130)

fn on_sigterm():
    """
    Handle SIGTERM (termination request).

    Exit code: 143 (128 + 15)
    """
    print ""
    print "[SIGNAL] SIGTERM received (termination request)"
    print "[SIGNAL] Cleaning up resources..."

    run_global_cleanup_handler()

    # Exit with standard SIGTERM code
    exit(143)

fn on_sighup():
    """
    Handle SIGHUP (terminal closed).

    Exit code: 129 (128 + 1)
    """
    print ""
    print "[SIGNAL] SIGHUP received (terminal closed)"
    print "[SIGNAL] Cleaning up resources..."

    run_global_cleanup_handler()

    # Exit with standard SIGHUP code
    exit(129)

fn on_sigusr2():
    """
    Handle SIGUSR2 (user-defined signal, e.g. live memory-dump trigger).

    Does NOT exit the process -- runs the registered handler and returns
    control to the interrupted program.
    """
    val handler = _sigusr2_handler
    handler()

fn on_normal_exit():
    """
    Handle normal exit (via exit() call or end of main).

    Performs cleanup without changing exit code.
    """
    # The runtime atexit bridge is flag-based and cannot dispatch after Simple
    # execution has ended. Callers needing normal cleanup invoke it explicitly.
    run_global_cleanup_handler()

# ============================================================================
# Graceful Shutdown Helpers
# ============================================================================

fn create_signal_cleanup_handler(
    cleanup_processes: fn() -> i64,
    cleanup_containers: fn() -> i64,
    save_checkpoint: fn()
) -> fn():
    """
    Create a cleanup handler that calls provided cleanup functions.

    Args:
        cleanup_processes: Function to kill all child processes
        cleanup_containers: Function to stop all containers
        save_checkpoint: Function to save checkpoint (optional)

    Returns: Cleanup handler function

    Usage:
        val handler = create_signal_cleanup_handler(
            tracker_kill_all_children,
            tracker_stop_all_containers,
            fn(): checkpoint_save([], 0, 0, 0, "signal")
        )
        install_signal_handlers(handler)
    """
    _signal_cleanup_processes = cleanup_processes
    _signal_cleanup_containers = cleanup_containers
    _signal_cleanup_checkpoint = save_checkpoint
    run_created_signal_cleanup

fn run_created_signal_cleanup():
    val checkpoint = _signal_cleanup_checkpoint
    checkpoint()
    val cleanup_processes = _signal_cleanup_processes
    val cleanup_containers = _signal_cleanup_containers
    val killed = cleanup_processes()
    val stopped = cleanup_containers()
    print "[SIGNAL] Cleanup complete: {killed} processes, {stopped} containers"

# ============================================================================
# Utility Functions
# ============================================================================

fn signal_name(signal: i64) -> text:
    """Get signal name from number"""
    if signal == SIGHUP:
        return "SIGHUP"
    elif signal == SIGINT:
        return "SIGINT"
    elif signal == SIGTERM:
        return "SIGTERM"
    elif signal == SIGKILL:
        return "SIGKILL"
    elif signal == SIGSEGV:
        return "SIGSEGV"
    elif signal == SIGUSR2:
        return "SIGUSR2"
    else:
        return "UNKNOWN"

# ============================================================================
# Exports
# ============================================================================
