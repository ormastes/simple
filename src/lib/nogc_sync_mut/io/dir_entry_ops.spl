"""
# Directory Entry Runtime Backend

No-GC sync owner for low-level directory entry and simple create/remove
runtime hooks used by async file metadata helpers.
"""

extern fn rt_readdir(path: text) -> i64
extern fn rt_readdir_count(handle: i64) -> i64
extern fn rt_readdir_entry(handle: i64, index: i64) -> text
extern fn rt_readdir_free(handle: i64)
extern fn rt_mkdir(path: text, mode: i64) -> i64
extern fn rt_remove(path: text) -> i64

fn directory_stream_open(path: text) -> i64:
    rt_readdir(path)

fn directory_stream_count(handle: i64) -> i64:
    rt_readdir_count(handle)

fn directory_stream_entry(handle: i64, index: i64) -> text:
    rt_readdir_entry(handle, index)

fn directory_stream_close(handle: i64):
    rt_readdir_free(handle)

fn directory_create_mode(path: text, mode: i64) -> i64:
    rt_mkdir(path, mode)

fn directory_remove(path: text) -> i64:
    rt_remove(path)

export directory_stream_open, directory_stream_count, directory_stream_entry
export directory_stream_close, directory_create_mode, directory_remove
