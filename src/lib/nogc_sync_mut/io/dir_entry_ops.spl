"""
# Directory Entry Runtime Backend

No-GC sync owner for low-level directory entry and simple create/remove
runtime hooks used by async file metadata helpers.
"""

extern fn rt_readdir(path: text) -> i64
extern fn rt_readdir_count(handle: i64) -> i64
extern fn rt_readdir_entry(handle: i64, index: i64) -> text
extern fn rt_readdir_free(handle: i64)
extern fn rt_mkdir(path: text, mode: i64) -> i64
extern fn rt_remove(path: text) -> i64

fn directory_stream_open(path: text) -> i64:
    rt_readdir(path)

fn directory_stream_count(handle: i64) -> i64:
    rt_readdir_count(handle)

fn directory_stream_entry(handle: i64, index: i64) -> text:
    rt_readdir_entry(handle, index)

fn directory_stream_close(handle: i64):
    rt_readdir_free(handle)

fn directory_create_mode(path: text, mode: i64) -> i64:
    rt_mkdir(path, mode)

# Creates `path` and every missing ancestor with mode 0700.
#
# `dir_create` gives 0777 & ~umask, and a common desktop umask is 0002, so a
# directory made that way is group-writable (0775). Owners that later require
# a directory free of group/other write (`retained_directory_open_trusted_v1`
# refuses the final component with SCVDB_DIR_FINAL_UNTRUSTED and an ancestor
# with SCVDB_DIR_PARENT_UNTRUSTED) must therefore create it here: a umask can
# only clear bits, so 0700 stays private under every umask. An existing
# component is left exactly as it is — its mode is the trusted open's to judge.
pub fn directory_create_private(path: text) -> bool:
    if path == "" or path.contains("\u{0}"): return false
    val absolute = path.starts_with("/")
    var prefix = ""
    var first = true
    for part in path.split("/"):
        if part == "" or part == ".": continue
        if first and not absolute: prefix = part
        else: prefix = prefix + "/" + part
        first = false
        val made = rt_mkdir(prefix, 0o700)
        # -17 = EEXIST: the component is already there.
        if made != 0 and made != -17: return false
    not first

fn directory_remove(path: text) -> i64:
    rt_remove(path)

export directory_stream_open, directory_stream_count, directory_stream_entry
export directory_stream_close, directory_create_mode, directory_remove, directory_create_private
