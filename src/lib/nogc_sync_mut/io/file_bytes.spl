"""Canonical nullable descriptor read. The descriptor remains caller-owned."""
use std.io.types.{IoError, IoErrorKind}

@unsafe(reason: "raw nullable file descriptor read; nil is failure, empty is EOF", capabilities: [ffi])
extern fn rt_io_file_read(fd: i64, size: i64) -> [u8]?

pub fn file_read_borrowed_bytes(descriptor: i64, size: i64) -> Result<[u8], IoError>:
    if descriptor < 0:
        return Err(IoError(kind: IoErrorKind.Other, message: "invalid borrowed file descriptor", source: nil))
    if size < 0:
        return Err(IoError(kind: IoErrorKind.Other, message: "read size must be non-negative", source: nil))
    var data: [u8]? = nil
    unsafe(capabilities: [ffi]):
        data = rt_io_file_read(descriptor, size)
    if data == nil:
        return Err(IoError(kind: IoErrorKind.Other, message: "read failed", source: nil))
    Ok(data ?? [])

export file_read_borrowed_bytes
