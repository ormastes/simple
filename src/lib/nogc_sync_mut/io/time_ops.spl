# Time Functions - Pure Simple I/O
# Extracted from mod.spl for modularity

use common.time_utils.{timestamp_get_year, timestamp_get_month, timestamp_get_day, timestamp_get_hour, timestamp_get_minute, timestamp_get_second}
use std.nogc_sync_mut.io.hal_clock_dispatch.{hal_clock_monotonic_nanos_v1}

# Raw clock providers reserve every negative value as a failure sentinel.
# Successful calls return non-negative scalar timestamps and transfer no
# pointer, allocation, or ownership. Safe wrappers below lift the sentinel by
# failing closed while retaining exactly one provider call.
@unsafe(reason: "raw wall-clock provider; negative sentinel is failure", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64
@unsafe(reason: "raw monotonic-clock provider; negative sentinel is failure", capabilities: [ffi])
extern fn rt_time_now_micros() -> i64

# Keep each raw provider call in a private function-level capability leaf.
# The admitted bootstrap builder does not retain lexical unsafe scopes inside
# function bodies, while this form preserves a single direct call and adds no
# allocation, buffer, collection, or dispatch.
@unsafe(reason: "private wall-clock scalar ABI boundary", capabilities: [ffi])
fn _time_now_unix_micros_raw() -> i64:
    rt_time_now_unix_micros()

@unsafe(reason: "private monotonic microsecond scalar ABI boundary", capabilities: [ffi])
fn _time_now_micros_raw() -> i64:
    rt_time_now_micros()

# ============================================================================
# Time Functions
# ============================================================================

fn time_now_unix_micros() -> i64:
    val value = _time_now_unix_micros_raw()
    if value < 0:
        panic("E-SFFI-TIME-001: wall clock provider failed")
    value

fn current_time_unix() -> i64:
    time_now_unix_micros() / 1_000_000

fn current_time_ms() -> i64:
    time_now_unix_micros() / 1_000

fn timestamp_year(micros: i64) -> i64:
    timestamp_get_year(micros)

fn timestamp_month(micros: i64) -> i64:
    timestamp_get_month(micros)

fn timestamp_day(micros: i64) -> i64:
    timestamp_get_day(micros)

fn timestamp_hour(micros: i64) -> i64:
    timestamp_get_hour(micros)

fn timestamp_minute(micros: i64) -> i64:
    timestamp_get_minute(micros)

fn timestamp_second(micros: i64) -> i64:
    timestamp_get_second(micros)

# --- High-Resolution Time (Monotonic) ---

@rt(hal, operation: io.clock.monotonic_nanos.v1,
    providers: pure+c+rust,
    capabilities: 1024,
    comparator: 1,
    normalizer: 1,
    effects: replay_only,
    request_bytes: 32,
    result_bytes: 32,
    trace_operations: 1,
    trace_bytes: 32,
    diff_rows: 3,
    report_bytes: 256,
    log_bytes: 256,
    deadline_ticks: 1000,
    error_schema: 1,
    environment_schema: 1,
    preferred: c)
fn time_now_nanos() -> i64:
    """
    Get current monotonic time in nanoseconds.

    Uses the production rt(hal) declaration and its canonical direct-bound
    clock leaf. Normal mode keeps the established C/runtime provider as the
    sole physical clock authority. Sealed alpha/beta replay remains gated until
    the provider result ABI can carry the same captured scalar observation.
    The fixed scalar envelope performs no hot-path allocation.

    Uses CLOCK_MONOTONIC_RAW on Unix, QueryPerformanceCounter on Windows.
    Fails closed on provider error. Suitable for high-precision benchmarking.
    """
    val value = hal_clock_monotonic_nanos_v1()
    if value < 0:
        panic("E-SFFI-TIME-002: monotonic nanosecond clock provider failed")
    value

fn time_now_micros() -> i64:
    """
    Get current monotonic time in microseconds.

    Uses CLOCK_MONOTONIC_RAW on Unix, QueryPerformanceCounter on Windows.
    Fails closed on provider error. Suitable for profiling and performance measurement.
    """
    val value = _time_now_micros_raw()
    if value < 0:
        panic("E-SFFI-TIME-003: monotonic microsecond clock provider failed")
    value

# --- Timestamp string helper ---

fn timestamp_now() -> i64:
    time_now_unix_micros()

# --- Sleep ---

use std.io_runtime.{thread_sleep}

fn sleep_ms(milliseconds: i64):
    if milliseconds > 0:
        thread_sleep(milliseconds)
