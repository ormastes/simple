"""Strict per-connection text session over the existing synchronous TcpStream.

Only connect/accept create sessions; raw stream adoption is not exposed.
Ordinary class references share close and codec state. Affine ownership and
concurrent access are not enforced; do not clone or reset state midstream. This API supplies no message
framing: protocol framing belongs above decoded chunks. Codec errors require
an explicitly corrected new connection; data is never replaced or guessed.
"""
use std.nogc_sync_mut.io.tcp.{TcpStream, TcpListener}
use std.nogc_sync_mut.io.text_session.{TextSessionCodec}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_sync_mut.io.network_text_helpers.{network_text_encode, network_text_slice, network_text_limit, network_read_format, network_write_format}
use std.common.encoding.external_text.{ExternalTextDecoder, ExternalFormat, BomPolicy, external_text_decoder}

pub class TcpTextSession:
    _stream: TcpStream
    _codec: TextSessionCodec
    _decoder: ExternalTextDecoder
    _read_eof: bool
    _read_failure: TextIoError?
    _write_started: bool
    _write_failure: TextIoError?
    _closed: bool

    pub static fn connect(address: text, codec: TextSessionCodec, timeout_ms: i64) -> Result<TcpTextSession, TextIoError>:
        """Create the transport inside this owner; no raw stream alias escapes."""
        codec.validate()?
        if timeout_ms <= 0: return Err(TextIoError.Io("TCP session timeout must be positive"))
        var stream = match TcpStream.connect_timeout(address, timeout_ms):
            case Ok(value): value
            case Err(error): return Err(TextIoError.Transport(error))
        # Admission stays inside the factory which created this transport.
        # No public or private method accepts a caller-owned raw stream.
        match stream.set_read_timeout(Some(timeout_ms)):
            case Err(error):
                val closed = stream.close()
                return Err(TextIoError.Transport(error))
            case Ok(_): ()
        match stream.set_write_timeout(Some(timeout_ms)):
            case Err(error):
                val closed = stream.close()
                return Err(TextIoError.Transport(error))
            case Ok(_): ()
        val decoder = match external_text_decoder(network_read_format(codec)):
            case Ok(value): value
            case Err(error):
                val closed = stream.close()
                return Err(TextIoError.Codec(error))
        Ok(TcpTextSession(_stream: stream, _codec: codec, _decoder: decoder,
            _read_eof: false, _read_failure: nil, _write_started: false,
            _write_failure: nil, _closed: false))

    pub static fn accept(listener: TcpListener, codec: TextSessionCodec, timeout_ms: i64) -> Result<TcpTextSession, TextIoError>:
        """Accept a new stream without exposing a raw alias to the caller."""
        codec.validate()?
        if timeout_ms <= 0: return Err(TextIoError.Io("TCP session timeout must be positive"))
        var stream = match listener.accept_timeout(timeout_ms):
            case Ok(value): value
            case Err(error): return Err(TextIoError.Transport(error))
        # Admission stays inside the factory which created this transport.
        # No public or private method accepts a caller-owned raw stream.
        match stream.set_read_timeout(Some(timeout_ms)):
            case Err(error):
                val closed = stream.close()
                return Err(TextIoError.Transport(error))
            case Ok(_): ()
        match stream.set_write_timeout(Some(timeout_ms)):
            case Err(error):
                val closed = stream.close()
                return Err(TextIoError.Transport(error))
            case Ok(_): ()
        val decoder = match external_text_decoder(network_read_format(codec)):
            case Ok(value): value
            case Err(error):
                val closed = stream.close()
                return Err(TextIoError.Codec(error))
        Ok(TcpTextSession(_stream: stream, _codec: codec, _decoder: decoder,
            _read_eof: false, _read_failure: nil, _write_started: false,
            _write_failure: nil, _closed: false))

    pub me fn read_chunk(size: i64) -> Result<text?, TextIoError>:
        """Some(empty) is an incomplete scalar/signature, nil is validated EOF."""
        if val error = self._read_failure: return Err(error)
        if self._closed: return Err(TextIoError.Io("TCP text session is closed"))
        if size <= 0 or size > self._codec.input_byte_limit():
            return Err(network_text_limit("TCP read size must be positive and within the session input byte limit"))
        if self._read_eof: return Ok(nil)
        val bytes = match self._stream.read(size):
            case Ok(value): value
            case Err(error):
                val failure = TextIoError.Transport(error)
                self._read_failure = Some(failure)
                return Err(failure)
        if bytes.len() > size:
            val failure = TextIoError.Io("TCP provider exceeded requested read size")
            self._read_failure = Some(failure)
            return Err(failure)
        if bytes.len() == 0:
            self._read_eof = true
            match self._decoder.finish():
                case Err(error):
                    val failure = TextIoError.Codec(error)
                    self._read_failure = Some(failure)
                    return Err(failure)
                case Ok(value):
                    if value == "": return Ok(nil)
                    return Ok(Some(value))
        match self._decoder.push(bytes):
            case Ok(value): Ok(Some(value))
            case Err(error):
                val failure = TextIoError.Codec(error)
                self._read_failure = Some(failure)
                Err(failure)

    pub me fn read_text(size: i64) -> Result<text, TextIoError>:
        """Read the next nonempty decoded chunk, or empty only on validated EOF."""
        while true:
            match self.read_chunk(size):
                case Err(error): return Err(error)
                case Ok(chunk):
                    if val value = chunk:
                        if value != "": return Ok(value)
                    else:
                        return Ok("")

    pub me fn write_text(value: text) -> Result<(), TextIoError>:
        if val error = self._write_failure: return Err(error)
        if self._closed: return Err(TextIoError.Io("TCP text session is closed"))
        var format = network_write_format(self._codec)
        if self._write_started:
            format = ExternalFormat(encoding: format.encoding, byte_order: format.byte_order, bom: BomPolicy.Preserve)
        # Validate all input and capacity before the first transport write.
        val bytes = network_text_encode(value, format, self._codec.output_byte_limit())?
        var offset = 0
        while offset < bytes.len():
            val remaining = bytes.len() - offset
            val count = if remaining > 8192: 8192 else: remaining
            val window = match network_text_slice(bytes, offset, offset + count):
                case Ok(buffer): buffer
                case Err(error):
                    if offset > 0: self._write_failure = Some(error)
                    return Err(error)
            val sent = match self._stream.write(window):
                case Ok(written): written
                case Err(error):
                    val failure = TextIoError.Io("TCP text write failed after {offset} bytes: {error.message}; close this session before retrying")
                    self._write_failure = Some(failure)
                    return Err(failure)
            if sent <= 0 or sent > count:
                val failure = TextIoError.Io("TCP text write returned invalid progress after {offset} bytes; close this session before retrying")
                self._write_failure = Some(failure)
                return Err(failure)
            offset = offset + sent
        # A no-byte write cannot consume a stream-start BOM policy.
        if bytes.len() > 0: self._write_started = true
        Ok(())

    pub me fn close() -> Result<(), TextIoError>:
        self._closed = true
        match self._stream.close():
            case Ok(_): Ok(())
            case Err(error): Err(TextIoError.Transport(error))

export TcpTextSession
