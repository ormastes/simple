# Win64 console ABI. INPUT_RECORD=20, KEY_EVENT_RECORD payload starts at4;
# CONSOLE_SCREEN_BUFFER_INFO=22, srWindow SMALL_RECT begins at10.
@unsafe(reason: "Win64 current standard console handle acquisition", capabilities: [ffi])
extern fn GetStdHandle(kind: u32) -> i64
@unsafe(reason: "Win64 current process pseudohandle for noninherited duplicates", capabilities: [ffi])
extern fn GetCurrentProcess() -> i64
@unsafe(reason: "Win64 duplicate owned console handle", capabilities: [ffi, raw_ptr])
extern fn DuplicateHandle(source_process: i64, source: i64, target_process: i64, target_out: i64, access: u32, inherit: i32, options: u32) -> i32
@unsafe(reason: "Win64 exact current console mode snapshot", capabilities: [ffi, raw_ptr])
extern fn GetConsoleMode(console: i64, mode_out: i64) -> i32
@unsafe(reason: "Win64 owned console mode transition and restoration", capabilities: [ffi])
extern fn SetConsoleMode(console: i64, mode: u32) -> i32
@unsafe(reason: "Win64 nonblocking console input record count", capabilities: [ffi, raw_ptr])
extern fn GetNumberOfConsoleInputEvents(console: i64, count_out: i64) -> i32
@unsafe(reason: "Win64 read of already counted input records by the exclusive owner", capabilities: [ffi, raw_ptr])
extern fn ReadConsoleInputW(console: i64, records: i64, capacity: u32, read_out: i64) -> i32
@unsafe(reason: "Win64 bounded Unicode console output", capabilities: [ffi, raw_ptr])
extern fn WriteConsoleW(console: i64, buffer: i64, units: u32, written_out: i64, reserved: i64) -> i32
@unsafe(reason: "Win64 actual console window dimensions snapshot", capabilities: [ffi, raw_ptr])
extern fn GetConsoleScreenBufferInfo(console: i64, info_out: i64) -> i32

export GetStdHandle, GetCurrentProcess, DuplicateHandle, GetConsoleMode, SetConsoleMode
export GetNumberOfConsoleInputEvents, ReadConsoleInputW, WriteConsoleW, GetConsoleScreenBufferInfo
