# Debug/Stub Functions - Pure Simple I/O
# Extracted from mod.spl for modularity
#
# C++ backend available: libsimple_debug.so (SFFI external library pattern)
# Native: .build/rust/sffi_debug/ (C++ bridge, 499K .so)
# SFFI: src/lib/ffi/debug.spl (extern fn declarations for compiled mode)
# Spec: examples/debug.wrapper_spec
# Interpreter mode: delegates to debug_state module (in-memory state)
# Compiled mode: links against libsimple_debug.so via Tier 2 extern fn

use lib.nogc_sync_mut.io.debug_state.{
    ds_set_active, ds_add_breakpoint, ds_remove_breakpoint,
    ds_continue_exec, ds_pause_exec, ds_set_step_mode, ds_stack_trace,
    ds_local_vars, ds_get_current_file, ds_get_current_line,
    ds_add_breakpoint_rich, ds_add_function_breakpoint,
    ds_set_breakpoint_enabled, ds_get_breakpoint_info, ds_list_breakpoints,
    ds_select_frame, ds_get_selected_frame, ds_frame_locals,
    ds_get_source_lines, ds_add_watch, ds_remove_watch, ds_list_watches,
    ds_set_variable, ds_eval_expression, ds_terminate
}

# ============================================================================
# Debug/Hook Functions — delegate to debug_state
# ============================================================================

pub fn rt_debug_set_active(active: bool):
    ds_set_active(active)

pub fn rt_hook_enable_debugging(enable: bool):
    ds_set_active(enable)

pub fn rt_debug_add_breakpoint_at(bp_file: text, bp_line: i64) -> i64:
    ds_add_breakpoint(bp_file, bp_line)

pub fn rt_debug_remove_breakpoint_at(bp_file: text, bp_line: i64):
    ds_remove_breakpoint(bp_file, bp_line)

fn rt_debug_remove_all_breakpoints():
    ds_remove_all_breakpoints()

pub fn rt_debug_continue_exec():
    ds_continue_exec()

pub fn rt_debug_pause_exec():
    ds_pause_exec()

pub fn rt_debug_set_step_mode_val(mode: i64):
    ds_set_step_mode(mode)

pub fn rt_debug_stack_trace_lines() -> [text]:
    ds_stack_trace()

pub fn rt_debug_local_vars() -> [text]:
    ds_local_vars()

pub fn rt_debug_get_current_file() -> text:
    ds_get_current_file()

pub fn rt_debug_get_current_line() -> i64:
    ds_get_current_line()

# --- Rich Breakpoints (Phase 1.5) ---
pub fn rt_debug_add_breakpoint_rich(bp_file: text, bp_line: i64, condition: text, hit_condition: text, log_message: text, is_temporary: i64) -> i64:
    ds_add_breakpoint_rich(bp_file, bp_line, condition, hit_condition, log_message, is_temporary)

pub fn rt_debug_add_function_breakpoint(func_name: text, condition: text) -> i64:
    ds_add_function_breakpoint(func_name, condition)

pub fn rt_debug_set_breakpoint_enabled(bp_id: i64, enabled: i64):
    ds_set_breakpoint_enabled(bp_id, enabled)

pub fn rt_debug_get_breakpoint_info(bp_id: i64) -> text:
    ds_get_breakpoint_info(bp_id)

pub fn rt_debug_list_breakpoints() -> text:
    ds_list_breakpoints()

# --- Frame Navigation ---
pub fn rt_debug_select_frame(index: i64) -> i64:
    ds_select_frame(index)

pub fn rt_debug_get_selected_frame() -> i64:
    ds_get_selected_frame()

pub fn rt_debug_frame_locals(frame_index: i64) -> text:
    ds_frame_locals(frame_index)

# --- Source File Reading ---
pub fn rt_debug_get_source_lines(src_file: text, start_line: i64, line_count: i64) -> text:
    ds_get_source_lines(src_file, start_line, line_count)

# --- Watch Expressions ---
pub fn rt_debug_add_watch(expr: text) -> i64:
    ds_add_watch(expr)

pub fn rt_debug_remove_watch(expr: text) -> i64:
    ds_remove_watch(expr)

pub fn rt_debug_list_watches() -> text:
    ds_list_watches()

# --- Variable Modification ---
pub fn rt_debug_set_variable(var_name: text, value_str: text, frame_index: i64) -> i64:
    ds_set_variable(var_name, value_str, frame_index)

# --- Expression Evaluation ---
pub fn rt_debug_eval_expression(expr: text, frame_index: i64) -> text:
    ds_eval_expression(expr, frame_index)

# --- Terminate ---
pub fn rt_debug_terminate():
    ds_terminate()

# ============================================================================
# Atomic Operations (stubs)
# ============================================================================

pub fn atomic_i64_new(value: i64) -> i64:
    value

pub fn atomic_bool_new(value: bool) -> bool:
    value

