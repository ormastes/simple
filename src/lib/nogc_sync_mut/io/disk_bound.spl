"""Byte bounds for flat on-disk cache directories.

Shared by every cache writer that lives outside the CAS store (HIR, warm
artifacts, runtime objects): measure a directory and sweep its oldest files
(by mtime, then path) down to a target. Files under `.by-source/` (per-source
indexes) and `*.tmp` (in-flight publishes) are never counted or removed.
"""

use std.nogc_sync_mut.io_runtime.{dir_walk, dir_exists, file_size_signed, file_delete, env_get_opt,
    file_exists, file_write, dir_create, dir_remove, dir_list_or_empty}
use std.nogc_sync_mut.io.time_ops.{time_now_seconds}
use std.nogc_sync_mut.io.file_ops.{file_modified_time}

pub val DISK_BOUND_STALE_TMP_AGE_SECS: i64 = 3600
pub val DISK_BOUND_STALE_CANDIDATE_AGE_SECS: i64 = 86400

fn _disk_bound_basename(path: text) -> text:
    val canonical = path.replace("\\", "/")
    canonical.substring(canonical.last_index_of("/") + 1)

fn _disk_bound_pad13(stamp: text) -> text:
    val zeros = "0000000000000"
    val pad_len = if stamp.byte_len() < 13: 13 - stamp.byte_len() else: 0
    zeros.substring(0, pad_len) + stamp

fn _disk_bound_used_path(dir: text, path: text) -> text:
    "{dir}/.used/" + _disk_bound_basename(path)

# Records a cache hit on `path`, an entry directly in dir (markers are keyed
# by basename, so bounded dirs must be flat), so the sweep treats it as
# recently used. The marker is an empty file whose mtime is the last use;
# it is removed together with its entry.
pub fn disk_bound_mark_used(dir: text, path: text):
    if not dir_exists(dir + "/.used"):
        val _made = dir_create(dir + "/.used", true)
    val _written = file_write(_disk_bound_used_path(dir, path), "")

# Drops the hit marker of an entry the caller deleted itself.
pub fn disk_bound_forget(dir: text, path: text):
    val _removed = file_delete(_disk_bound_used_path(dir, path))

fn _disk_bound_canonical_norm(path: text) -> text:
    var out = path.replace("\\", "/")
    if out.starts_with("//?/"):
        out = out.substring(4)
    while out.ends_with("/") and out.byte_len() > 1:
        if out.byte_len() == 3 and out.substring(1, 3) == ":/":
            break
        out = out.substring(0, out.byte_len() - 1)
    out

fn _disk_bound_rel_path(dir: text, path: text) -> text:
    val canon_dir = _disk_bound_canonical_norm(dir)
    val canon_path = _disk_bound_canonical_norm(path)
    val prefix = if canon_dir == "": "" elif canon_dir.ends_with("/"): canon_dir else: canon_dir + "/"
    if prefix != "" and canon_path.starts_with(prefix):
        return canon_path.substring(prefix.byte_len())
    _disk_bound_basename(canon_path)

fn _disk_bound_is_coordination_rel(rel: text) -> bool:
    val segs = rel.split("/")
    if segs.len() < 2:
        return false
    var i: i64 = 0
    while i < segs.len() - 1:
        val seg = segs[i]
        if (seg == ".by-source" or seg == ".used" or
                seg.starts_with("queue-") or
                seg.starts_with("mir-queue-") or
                seg.starts_with("closure-request-")):
            return true
        i = i + 1
    false

fn _disk_bound_is_entry(dir: text, path: text) -> bool:
    val rel = _disk_bound_rel_path(dir, path)
    val name = _disk_bound_basename(rel)
    # candidate-*.receipt are another build's in-flight warm publish;
    # queue-*/mir-queue-*/closure-request-* and *.peak_kib/mir-run-latest
    # belong to active shard coordination with their own retention windows.
    not _disk_bound_is_coordination_rel(rel) and
        not name.ends_with(".tmp") and
        not name.ends_with(".peak_kib") and
        name != "mir-run-latest" and
        not (name.starts_with("candidate-") and name.ends_with(".receipt"))

fn _disk_bound_cleanup_used_markers(dir: text) -> i64:
    var removed: i64 = 0
    val used_dir = dir + "/.used"
    if dir_exists(used_dir):
        for marker in dir_list_or_empty(used_dir):
            if marker == "" or marker == "." or marker == "..":
                continue
            val name = _disk_bound_basename(marker)
            if name != "" and not file_exists(dir + "/" + name):
                if file_delete(used_dir + "/" + name):
                    removed = removed + 1
    removed

fn _disk_bound_maybe_reap_orphan_file(dir: text, path: text, now_secs: i64,
        tmp_age_s: i64, candidate_age_s: i64) -> bool:
    val rel = _disk_bound_rel_path(dir, path)
    if _disk_bound_is_coordination_rel(rel) or dir_exists(path):
        return false
    val name = _disk_bound_basename(rel)
    val is_tmp = name.ends_with(".tmp")
    val is_cand = name.starts_with("candidate-") and name.ends_with(".receipt")
    if not is_tmp and not is_cand:
        return false
    val age_limit = if is_tmp: tmp_age_s else: candidate_age_s
    if age_limit <= 0:
        return false
    val mtime = file_modified_time(path)
    if mtime <= 0 or now_secs - mtime < age_limit:
        return false
    if file_delete(path):
        val _marker = file_delete(_disk_bound_used_path(dir, path))
        return true
    false

# Reap dangling `.used/*` markers and stale crashed-worker `*.tmp` / `candidate-*.receipt`
# files older than the configured grace ages. Returns the number of orphans removed.
# reason: directory path, unix-second timestamp, and age thresholds match disk_bound_keep_newest_dirs
@allow(primitive_api)
pub fn disk_bound_reap_orphans_at(dir: text, now_secs: i64,
        tmp_age_s: i64 = DISK_BOUND_STALE_TMP_AGE_SECS,
        candidate_age_s: i64 = DISK_BOUND_STALE_CANDIDATE_AGE_SECS) -> i64:
    if not dir_exists(dir):
        return 0
    var reaped = _disk_bound_cleanup_used_markers(dir)
    for path in dir_walk(dir):
        if _disk_bound_maybe_reap_orphan_file(dir, path, now_secs, tmp_age_s, candidate_age_s):
            reaped = reaped + 1
    reaped

fn _disk_bound_measure_and_reap_at(dir: text, now_secs: i64,
        tmp_age_s: i64, candidate_age_s: i64) -> i64:
    if not dir_exists(dir):
        return 0
    var total: i64 = 0
    for path in dir_walk(dir):
        if _disk_bound_is_entry(dir, path) and not dir_exists(path):
            val size = file_size_signed(path)
            if size > 0:
                total = total + size
        else:
            val _reaped = _disk_bound_maybe_reap_orphan_file(
                dir, path, now_secs, tmp_age_s, candidate_age_s)
    val _markers = _disk_bound_cleanup_used_markers(dir)
    total

# Measure cache bytes in `dir` and reap stale orphans in a single directory walk.
# reason: directory path and measured byte total match disk_bound_dir_bytes
@allow(primitive_api)
pub fn disk_bound_measure_and_reap_v1(dir: text) -> i64:
    _disk_bound_measure_and_reap_at(dir, time_now_seconds(),
        DISK_BOUND_STALE_TMP_AGE_SECS, DISK_BOUND_STALE_CANDIDATE_AGE_SECS)

pub fn disk_bound_dir_bytes(dir: text) -> i64:
    if not dir_exists(dir):
        return 0
    var total: i64 = 0
    for path in dir_walk(dir):
        if _disk_bound_is_entry(dir, path) and not dir_exists(path):
            val size = file_size_signed(path)
            if size > 0:
                total = total + size
    total

fn _disk_bound_sweep_at(dir: text, target_bytes: i64, now_secs: i64) -> i64:
    if not dir_exists(dir):
        return 0
    var rows: [text] = []
    var total: i64 = 0
    for path in dir_walk(dir):
        if _disk_bound_is_entry(dir, path) and not dir_exists(path):
            val size = file_size_signed(path)
            if size >= 0:
                # Last use = max(entry mtime, hit marker mtime); within one
                # second a used entry outranks an unused one. mtime 0 means
                # unreadable: order it last, never first.
                val used_path = _disk_bound_used_path(dir, path)
                val used = if file_exists(used_path): file_modified_time(used_path) else: 0
                val written = file_modified_time(path)
                val last = if used > written: used else: written
                val stamp = if written <= 0: "9999999999999" else: "{last * 2 + (if used > 0: 1 else: 0)}"
                rows.push(_disk_bound_pad13(stamp) + "|{size}|" + path)
                total = total + size
        else:
            val _reaped = _disk_bound_maybe_reap_orphan_file(
                dir, path, now_secs, DISK_BOUND_STALE_TMP_AGE_SECS, DISK_BOUND_STALE_CANDIDATE_AGE_SECS)
    val ordered = rows.sort()
    var removed = 0
    for row in ordered:
        if total <= target_bytes:
            break
        val parts = row.split("|")
        if parts.len() < 3:
            continue
        val size = parts[1].to_i64() ?? 0
        val victim = parts[2:].join("|")
        if file_delete(victim):
            val _marker = file_delete(_disk_bound_used_path(dir, victim))
            total = total - size
            removed = removed + 1
    # Markers whose entry was deleted outside the sweep.
    val _markers = _disk_bound_cleanup_used_markers(dir)
    removed

# Deletes oldest-mtime entries until the directory is at or under
# target_bytes. Returns the number of files removed. One sort, then delete
# in (mtime, path) order.
pub fn disk_bound_sweep(dir: text, target_bytes: i64) -> i64:
    _disk_bound_sweep_at(dir, target_bytes, time_now_seconds())

# Cap from env_name (bytes) or fallback.
pub fn disk_bound_cap_bytes(env_name: text, fallback: i64) -> i64:
    val raw = (env_get_opt(env_name) ?? "").trim()
    val parsed = if raw == "": 0 else: raw.to_i64() ?? 0
    if parsed > 0: parsed else: fallback

# After a publish: if dir is over cap, sweep it to 75% of cap. Returns files
# removed. One directory walk per call when under cap; call once per build, not per file.
pub fn disk_bound_enforce(dir: text, cap: i64) -> i64:
    if cap <= 0 or not dir_exists(dir):
        return 0
    val now_secs = time_now_seconds()
    val total = _disk_bound_measure_and_reap_at(dir, now_secs,
        DISK_BOUND_STALE_TMP_AGE_SECS, DISK_BOUND_STALE_CANDIDATE_AGE_SECS)
    if total <= cap:
        return 0
    _disk_bound_sweep_at(dir, cap * 3 / 4, now_secs)

# True when a keyed directory last used at `used` (unix seconds) is outside
# the min_age_s protection window at `now` and may be removed. min_age_s <= 0
# disables the window (pure count-based retention).
# reason: last-use time, current time, and age threshold are unix-second filesystem cache-bound scalars matching disk_bound_keep_newest_dirs
@allow(primitive_api)
pub fn disk_bound_dir_is_idle(used: i64, now: i64, min_age_s: i64) -> bool:
    min_age_s <= 0 or used <= now - min_age_s

# Refreshes the .last-use liveness marker of keyed directory `dir`, which
# disk_bound_keep_newest_dirs ranks by. A reader calls this for a directory it
# still needs but is not writing into: reads move no mtime, so without it a
# directory in use by a long build looks idle. False when dir does not exist.
# reason: a filesystem directory path and a write-succeeded status, matching disk_bound_mark_used
@allow(primitive_api)
pub fn disk_bound_mark_dir_used(dir: text) -> bool:
    if dir == "" or not dir_exists(dir):
        return false
    # Non-empty content: a rewrite always moves the marker mtime.
    file_write(dir + "/.last-use", "{time_now_seconds()}\n")

# Match a cache key with a fixed prefix and lowercase ASCII hex suffix.
# reason: cache component text and its fixed wire-name byte length
@allow(primitive_api)
pub fn disk_bound_keyed_hex_name_v1(name: text, prefix: text, name_len: i64) -> bool:
    if name.byte_len() != name_len or not name.starts_with(prefix):
        return false
    var offset = prefix.byte_len()
    while offset < name_len:
        val ch = name.byte_at(offset)
        val digit = ch >= 0x30 and ch <= 0x39
        val lower_hex = ch >= 0x61 and ch <= 0x66
        if not digit and not lower_hex:
            return false
        offset = offset + 1
    true

# Keyed-directory retention (one dir per compiler/producer identity): under
# parent, children named <prefix> + <name_len - prefix.len()> chars are
# ranked by their .last-use marker (dir mtime when absent). `current` gets a
# fresh marker and is kept; beyond `keep` total, the least recently used are
# removed, except any used within min_age_s (another lane may be using it).
# reason: filesystem names, count, and age threshold are cache retention scalars
@allow(primitive_api)
pub fn disk_bound_keep_newest_dirs(parent: text, current: text, prefix: text,
        name_len: i64, keep: i64, min_age_s: i64, hex_suffix: bool = false) -> i64:
    if keep <= 0 or not dir_exists(parent):
        return 0
    if current != "" and (not hex_suffix or disk_bound_keyed_hex_name_v1(current, prefix, name_len)):
        val _marked = disk_bound_mark_dir_used(parent + "/" + current)
    val now = time_now_seconds()
    var rows: [text] = []
    for entry in dir_list_or_empty(parent):
        if entry == "" or entry == "." or entry == "..":
            continue
        val name = _disk_bound_basename(entry)
        if name == current or not name.starts_with(prefix) or name.len() != name_len:
            continue
        if hex_suffix and not disk_bound_keyed_hex_name_v1(name, prefix, name_len):
            continue
        val child = parent + "/" + name
        if not dir_exists(child):
            continue
        # Last use = newest of the marker, the dir, and its direct children
        # (an older compiler never writes the marker; its objects land in a
        # subdirectory whose mtime moves on every publish).
        var used = file_modified_time(child)
        for sub in dir_list_or_empty(child):
            if sub == "" or sub == "." or sub == "..":
                continue
            val sub_time = file_modified_time(child + "/" + _disk_bound_basename(sub))
            if sub_time > used:
                used = sub_time
        val stamp = "{if used > 0: used else: 0}"
        rows.push(_disk_bound_pad13(stamp) + "|" + name)
    val ordered = rows.sort()
    var excess = ordered.len() + 1 - keep
    var removed = 0
    var index = 0
    while excess > 0 and index < ordered.len():
        val parts = ordered[index].split("|")
        index = index + 1
        val used = parts[0].to_i64() ?? 0
        excess = excess - 1
        if not disk_bound_dir_is_idle(used, now, min_age_s):
            continue
        if dir_remove(parent + "/" + parts[1], true):
            removed = removed + 1
    removed

# Variable-length prefix sibling of disk_bound_keep_newest_dirs (e.g.
# closure-request-<pid>-<ms>): matches <prefix><non-empty suffix> directories
# containing no '/' or '\', ranks by newest mtime of the directory or its
# direct children, keeps `keep` newest, and never evicts entries modified
# within `min_age_s` seconds (active concurrent builds).
# reason: retention count, age threshold in seconds, and evicted-directory count are filesystem cache-bound scalars matching disk_bound_keep_newest_dirs
@allow(primitive_api)
pub fn disk_bound_keep_newest_prefix_dirs(parent: text, prefix: text, keep: i64, min_age_s: i64) -> i64:
    if keep <= 0 or prefix == "" or prefix.contains("/") or prefix.contains("\\") or not dir_exists(parent):
        return 0
    val young_after = time_now_seconds() - min_age_s
    var rows: [text] = []
    for entry in dir_list_or_empty(parent):
        if entry == "" or entry == "." or entry == ".." or entry.contains("/") or entry.contains("\\"):
            continue
        if not entry.starts_with(prefix) or entry.byte_len() <= prefix.byte_len():
            continue
        val suffix = entry.substring(prefix.byte_len())
        if suffix == "" or suffix.contains("/") or suffix.contains("\\"):
            continue
        val child = parent + "/" + entry
        if not dir_exists(child):
            continue
        var used = file_modified_time(child)
        for sub in dir_list_or_empty(child):
            if sub == "" or sub == "." or sub == ".." or sub.contains("/") or sub.contains("\\"):
                continue
            val sub_time = file_modified_time(child + "/" + sub)
            if sub_time > used:
                used = sub_time
        val stamp = if used <= 0: "9999999999999" else: "{used}"
        val pad_len = if stamp.byte_len() < 13: 13 - stamp.byte_len() else: 0
        rows.push("0000000000000".substring(0, pad_len) + stamp + "|" + entry)
    val ordered = rows.sort()
    var excess = ordered.len() - keep
    var removed = 0
    var index = 0
    while excess > 0 and index < ordered.len():
        val row_text = ordered[index]
        val parts = row_text.split("|")
        index = index + 1
        excess = excess - 1
        if parts.len() < 2:
            continue
        val used = parts[0].to_i64() ?? 0
        if min_age_s > 0 and (used <= 0 or used > young_after):
            continue
        val dir_name: text = parts[1:].join("|")
        if dir_remove(parent + "/" + dir_name, true):
            removed = removed + 1
    removed
