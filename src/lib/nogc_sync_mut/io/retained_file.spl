# Bounded binary IO with a retained native regular-file handle. Callers close
# every handle, including failed reads. Parents must be trusted against rename.
# Windows denies write/delete sharing; Linux checks inode/size/mtime/ctime at
# finish. Unsupported host owners fail closed, never fall back to path reads.
use std.nogc_sync_mut.io.volatile_ops.{volatile_read_u8, volatile_read_u16, volatile_read_u32, volatile_read_u64, volatile_write_u8, volatile_write_u16}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes}
@when(os="windows"):
use std.nogc_sync_mut.io.retained_file_abi.*
@else:
use std.nogc_sync_mut.io.retained_file_abi.*
use std.nogc_sync_mut.io.retained_file_abi.{read as retained_native_read, write as retained_native_write, close as retained_native_close}
@end

pub struct RetainedFileSecurityMetadataV1:
    owner_uid: u32
    effective_uid: u32
    mode: u32

struct RetainedDirectorySecurityMetadataV1:
    owner_uid: u32
    effective_uid: u32
    mode: u32

class RetainedFile:
    var handle: i64
    var size: u64
    var identity: [u8]
    var writable: bool
    var closed: bool
    var position: u64
    maximum: u64

    # Policy readers opt into owner/mode inspection on this exact retained
    # regular-file descriptor. Ordinary file reads do not pay this extra statx.
    pub fn security_metadata_v1() -> Result<RetainedFileSecurityMetadataV1, text>:
        if self.closed or self.handle < 0 or self.writable:
            return Err("SCVDB_FILE_SECURITY_OWNER_CLOSED")
        _retained_security_metadata_v1(self.handle)

    pub me read_all_bounded_v1(maximum: i64) -> Result<[u8], text>:
        if self.closed or self.writable or maximum < 1 or maximum > 1048576 or self.size > maximum as u64:
            return Err("SCVDB_FILE_READ_QUOTA")
        val bytes = self.read_exact(self.size as i64)?
        if not retained_file_identity_unchanged(self)?:
            return Err("SCVDB_FILE_CHANGED")
        Ok(bytes)

    @unsafe(reason: "reads at most one MiB through retained native handle", capabilities: [ffi, raw_ptr])
    me read(maximum: i64) -> Result<[u8], text>:
        if self.closed or self.writable or self.position > self.maximum or maximum < 1 or maximum > 1048576: return Err("SCVDB_FILE_READ_QUOTA")
        val ptr = _retained_alloc((maximum + 8) as u64)
        if ptr == 0: return Err("SCVDB_FILE_MEMORY")
        var count = -1i64
        @when(os="windows"):
        # A failed positional-read restore never closes a copied owner. Reapply
        # the authoritative logical cursor before every sequential native read.
        if SetFilePointerEx(self.handle, self.position as i64, 0, 0u32) != 0:
            if ReadFile(self.handle, ptr, maximum as u32, ptr + maximum, 0) != 0: count = volatile_read_u32(ptr + maximum)
        @else:
        count = retained_native_read(self.handle as i32, ptr, maximum as u64)
        @end
        var bytes: [u8] = []
        if count >= 0 and count <= maximum:
            for index in 0..count: bytes.push(volatile_read_u8(ptr + index) as u8)
        _retained_free(ptr)
        if count < 0 or count > maximum: return Err("SCVDB_FILE_READ")
        self.position = self.position + (count as u64)
        if self.position > self.maximum: return Err("SCVDB_FILE_QUOTA")
        Ok(bytes)

    me read_exact(count: i64) -> Result<[u8], text>:
        """Read a bounded record; consumed position survives a later Err."""
        if self.closed or self.writable or count < 0 or count > 1048576:
            return Err("SCVDB_FILE_READ_QUOTA")
        var bytes: [u8] = []
        while bytes.len() < count:
            val next = self.read(count - bytes.len())?
            if next.len() == 0: return Err("SCVDB_FILE_TRUNCATED")
            bytes = bytes + next
        Ok(bytes)

    @unsafe(reason: "writes bounded chunk completely or fails on retained exclusive output", capabilities: [ffi, raw_ptr])
    me write(bytes: [u8]) -> Result<bool, text>:
        if self.closed or not self.writable or self.position > self.maximum or bytes.len() > 1048576 or (bytes.len() as u64) > self.maximum - self.position: return Err("SCVDB_FILE_WRITE_QUOTA")
        val ptr = _retained_alloc((bytes.len() + 8) as u64)
        if ptr == 0: return Err("SCVDB_FILE_MEMORY")
        for index in 0..bytes.len(): volatile_write_u8(ptr + index, bytes[index] as i64)
        var offset = 0
        while offset < bytes.len():
            var count = -1i64
            @when(os="windows"):
            if WriteFile(self.handle, ptr + offset, (bytes.len() - offset) as u32, ptr + bytes.len(), 0) != 0: count = volatile_read_u32(ptr + bytes.len())
            @else:
            count = retained_native_write(self.handle as i32, ptr + offset, (bytes.len() - offset) as u64)
            @end
            if count <= 0 or count > bytes.len() - offset:
                _retained_free(ptr)
                return Err("SCVDB_FILE_WRITE")
            offset = offset + count
            # Publish each completed native chunk before the next fallible call.
            self.position = self.position + (count as u64)
            if self.position > self.size: self.size = self.position
        _retained_free(ptr)
        Ok(true)

    @unsafe(reason: "invalidates owner object before closing native handle exactly once", capabilities: [ffi])
    me close() -> bool:
        if self.closed: return false
        self.closed = true
        val handle = self.handle
        self.handle = -1
        @when(os="windows"):
        CloseHandle(handle) != 0
        @else:
        retained_native_close(handle as i32) == 0
        @end

pub class RetainedDirectoryOwnerV1:
    var handle: i64
    var closed: bool

    @unsafe(reason: "opens a fixed nofollow regular file beneath the retained directory", capabilities: [ffi, raw_ptr])
    pub fn open_file(name: text, maximum: u64) -> Result<RetainedFile, text>:
        if self.closed or self.handle < 0: return Err("SCVDB_DIR_CLOSED")
        _retained_file_open_at_v1(self.handle, name, maximum)

    @unsafe(reason: "invalidates retained directory owner before closing its descriptor", capabilities: [ffi])
    pub me close() -> bool:
        if self.closed or self.handle < 0: return false
        self.closed = true
        val handle = self.handle
        self.handle = -1
        @when(os="linux"):
        retained_native_close(handle as i32) == 0
        @else:
        false
        @end


@unsafe(reason: "allocates zeroed temporary native IO storage", capabilities: [ffi, raw_ptr])
fn _retained_alloc(size: u64) -> i64:
    @when(os="windows"):
    HeapAlloc(GetProcessHeap(), 8u32, size)
    @else:
    val ptr = malloc(size)
    if ptr != 0:
        for index in 0..(size as i64): volatile_write_u8(ptr + index, 0)
    ptr
    @end

@unsafe(reason: "releases exactly one owned native allocation", capabilities: [ffi, raw_ptr])
fn _retained_free(ptr: i64):
    if ptr == 0: return
    @when(os="windows"):
    val released = HeapFree(GetProcessHeap(), 0u32, ptr)
    @else:
    free(ptr)
    @end

@unsafe(reason: "encodes bounded native path without embedded NUL", capabilities: [ffi, raw_ptr])
fn _retained_path(path: text) -> i64:
    if path.len() == 0 or path.len() > 32760: return 0
    @when(os="windows"):
    # UTF-16 units never exceed the UTF-8 byte count; reserve a terminator too.
    val ptr = _retained_alloc(((path.len() + 1) * 2) as u64)
    @else:
    val bytes = base_encoding_text_to_bytes(path)
    val ptr = _retained_alloc((bytes.len() + 1) as u64)
    @end
    if ptr == 0: return 0
    @when(os="windows"):
    var consumed = 0
    var ordinal = 0
    var offset = 0
    while consumed < path.len():
        val scalar = path.char_code_at(ordinal)
        if scalar <= 0 or scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
            _retained_free(ptr)
            return 0
        if scalar < 65536:
            volatile_write_u16(ptr + offset * 2, scalar)
            offset = offset + 1
        else:
            val value = scalar - 65536
            volatile_write_u16(ptr + offset * 2, 55296 + (value >> 10))
            volatile_write_u16(ptr + (offset + 1) * 2, 56320 + (value & 1023))
            offset = offset + 2
        ordinal = ordinal + 1
        if scalar < 128: consumed = consumed + 1
        elif scalar < 2048: consumed = consumed + 2
        elif scalar < 65536: consumed = consumed + 3
        else: consumed = consumed + 4
    @else:
    for index in 0..bytes.len():
        if bytes[index] == 0u8:
            _retained_free(ptr)
            return 0
        volatile_write_u8(ptr + index, bytes[index] as i64)
    @end
    ptr

# MIR Result<(..)> tuple slots admit only i64/bool/f64/text/tuple/record (no u64,
# no [u8]; result_try_tuple_field_type), so the pair is a record instead.
# @workaround bug=convnodes_retained_file_result_tuple_u64_2026_10_25 reason=see doc/08_tracking/bug/convnodes_retained_file_result_tuple_u64_2026-10-25.md
struct RetainedMeta:
    size: u64
    identity: [u8]

@unsafe(reason: "observes size and identity on exact retained regular-file handle", capabilities: [ffi, raw_ptr])
fn _retained_metadata(handle: i64) -> Result<RetainedMeta, text>:
    val ptr = _retained_alloc(256u64)
    if ptr == 0: return Err("SCVDB_FILE_MEMORY")
    var size = 0u64
    var identity: [u8] = []
    var valid = false
    @when(os="windows"):
    # FileAttributeTagInfo rejects directory/reparse; FileStandardInfo size;
    # FileIdInfo binds volume+128bit identifier; FileBasicInfo excludes atime.
    if GetFileType(handle) == 1u32 and GetFileInformationByHandleEx(handle, 9, ptr, 8u32) != 0 and (volatile_read_u32(ptr) & 1040) == 0:
        if GetFileInformationByHandleEx(handle, 1, ptr, 24u32) != 0:
            size = volatile_read_u64(ptr + 8) as u64
            if GetFileInformationByHandleEx(handle, 18, ptr, 24u32) != 0:
                for index in 0..24: identity.push(volatile_read_u8(ptr + index) as u8)
                if GetFileInformationByHandleEx(handle, 0, ptr, 40u32) != 0:
                    for index in 16..32: identity.push(volatile_read_u8(ptr + index) as u8)
                    valid = true
    @else:
    @when(os="linux"):
    # AT_EMPTY_PATH, STATX_BASIC_STATS; fixed UAPI layout independent of libc stat.
    val empty = _retained_alloc(1u64)
    if empty != 0:
        if statx(handle as i32, empty, 4096, 2047u32, ptr) == 0 and (volatile_read_u32(ptr) & 967) == 967 and (volatile_read_u16(ptr + 28) & 61440) == 32768:
            size = volatile_read_u64(ptr + 40) as u64
            for index in 32..48: identity.push(volatile_read_u8(ptr + index) as u8)
            for index in 96..128: identity.push(volatile_read_u8(ptr + index) as u8)
            for index in 136..144: identity.push(volatile_read_u8(ptr + index) as u8)
            valid = true
        _retained_free(empty)
    @end
    @end
    _retained_free(ptr)
    if not valid: return Err("SCVDB_FILE_METADATA_UNSUPPORTED")
    Ok(RetainedMeta(size: size, identity: identity))

@unsafe(reason: "reads Linux owner and mode from the exact retained descriptor", capabilities: [ffi, raw_ptr])
fn _retained_security_metadata_v1(handle: i64) -> Result<RetainedFileSecurityMetadataV1, text>:
    @when(os="linux"):
    if handle < 0: return Err("SCVDB_FILE_SECURITY_OWNER_CLOSED")
    val ptr = _retained_alloc(256u64)
    if ptr == 0: return Err("SCVDB_FILE_MEMORY")
    val empty = _retained_alloc(1u64)
    if empty == 0:
        _retained_free(ptr)
        return Err("SCVDB_FILE_MEMORY")
    val status = statx(handle as i32, empty, 4096, 11u32, ptr)
    val mask = if status == 0: volatile_read_u32(ptr) as u32 else: 0u32
    if status != 0 or (mask & 11u32) != 11u32:
        _retained_free(empty)
        _retained_free(ptr)
        return Err("SCVDB_FILE_SECURITY_METADATA_UNAVAILABLE")
    val raw_mode = volatile_read_u16(ptr + 28) as u32
    val owner_uid = volatile_read_u32(ptr + 20) as u32
    val effective_uid = geteuid()
    _retained_free(empty)
    _retained_free(ptr)
    if (raw_mode & 61440u32) != 32768u32:
        return Err("SCVDB_FILE_SECURITY_METADATA_UNAVAILABLE")
    Ok(RetainedFileSecurityMetadataV1(owner_uid: owner_uid,
        effective_uid: effective_uid, mode: raw_mode))
    @else:
    Err("SCVDB_FILE_SECURITY_METADATA_UNSUPPORTED")
    @end

@unsafe(reason: "reads directory owner and mode from the exact retained descriptor", capabilities: [ffi, raw_ptr])
fn _retained_directory_security_metadata_v1(handle: i64) -> Result<RetainedDirectorySecurityMetadataV1, text>:
    @when(os="linux"):
    if handle < 0: return Err("SCVDB_DIR_CLOSED")
    val ptr = _retained_alloc(256u64)
    if ptr == 0: return Err("SCVDB_DIR_MEMORY")
    val empty = _retained_alloc(1u64)
    if empty == 0:
        _retained_free(ptr)
        return Err("SCVDB_DIR_MEMORY")
    val status = statx(handle as i32, empty, 4096, 11u32, ptr)
    val mask = if status == 0: volatile_read_u32(ptr) as u32 else: 0u32
    if status != 0 or (mask & 11u32) != 11u32:
        _retained_free(empty)
        _retained_free(ptr)
        return Err("SCVDB_DIR_METADATA_UNAVAILABLE")
    val raw_mode = volatile_read_u16(ptr + 28) as u32
    val owner_uid = volatile_read_u32(ptr + 20) as u32
    val effective_uid = geteuid()
    _retained_free(empty)
    _retained_free(ptr)
    if (raw_mode & 61440u32) != 16384u32:
        return Err("SCVDB_DIR_NOT_DIRECTORY")
    Ok(RetainedDirectorySecurityMetadataV1(owner_uid: owner_uid,
        effective_uid: effective_uid, mode: raw_mode))
    @else:
    Err("SCVDB_DIR_HOST_UNSUPPORTED")
    @end

fn _retained_directory_owner_allowed_v1(metadata: RetainedDirectorySecurityMetadataV1,
    allow_root_sticky: bool) -> bool:
    if metadata.owner_uid != metadata.effective_uid and metadata.owner_uid != 0u32:
        return false
    if (metadata.mode & 18u32) == 0u32: return true
    allow_root_sticky and metadata.owner_uid == 0u32 and (metadata.mode & 512u32) != 0u32

# Linux file and directory flags are part of the target syscall ABI. Keep these
# words in one place so legacy path APIs and retained-owner APIs cannot drift.
fn _retained_linux_directory_flags_v1() -> i32:
    var flags: i32 = 0
    @when(os="linux"):
    @when(arch="aarch64"):
    flags = 573440 # O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_DIRECTORY
    @elif(arch="x86_64"):
    flags = 720896 # O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_DIRECTORY
    @else:
    flags = 0
    @end
    @end
    flags

fn _retained_linux_file_flags_v1() -> i32:
    var flags: i32 = 0
    @when(os="linux"):
    @when(arch="aarch64"):
    flags = 559104 # O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC
    @elif(arch="x86_64"):
    flags = 657408 # O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC
    @else:
    flags = 0
    @end
    @end
    flags

@unsafe(reason: "walks trusted directory components through nofollow native descriptors", capabilities: [ffi, raw_ptr])
pub fn retained_directory_open_trusted_v1(path: text) -> Result<RetainedDirectoryOwnerV1, text>:
    @when(os="linux"):
    if path == "" or path == "/" or path.len() > 32760 or not path.starts_with("/") or
            path.contains("\u0000") or path.contains("//") or path.ends_with("/") or
            path.contains("/./") or path.ends_with("/.") or path.contains("/../") or path.ends_with("/.."):
        return Err("SCVDB_DIR_PATH")
    val directory_flags = _retained_linux_directory_flags_v1()
    if directory_flags == 0: return Err("SCVDB_DIR_ARCH_UNSUPPORTED")
    val components = path.substring(1, path.len()).split("/")
    if components.len() == 0: return Err("SCVDB_DIR_PATH")
    for component in components:
        if component == "" or component == "." or component == ".." or component.contains("\u0000"):
            return Err("SCVDB_DIR_PATH")
    val root_path = _retained_path("/")
    if root_path == 0: return Err("SCVDB_DIR_MEMORY")
    var current = openat(-100, root_path, directory_flags, 0u32) as i64
    _retained_free(root_path)
    if current < 0: return Err("SCVDB_DIR_OPEN")
    var index = 0
    while index < components.len():
        val current_metadata = _retained_directory_security_metadata_v1(current)
        match current_metadata:
            case Err(_):
                val closed = retained_native_close(current as i32)
                return Err("SCVDB_DIR_METADATA_UNAVAILABLE")
            case Ok(metadata):
                if not _retained_directory_owner_allowed_v1(metadata, true):
                    val closed = retained_native_close(current as i32)
                    return Err("SCVDB_DIR_PARENT_UNTRUSTED")
        val component = components[index]
        if component.len() > 255:
            val closed = retained_native_close(current as i32)
            return Err("SCVDB_DIR_COMPONENT")
        val name = _retained_path(component)
        if name == 0:
            val closed = retained_native_close(current as i32)
            return Err("SCVDB_DIR_MEMORY")
        val next = openat(current as i32, name, directory_flags, 0u32) as i64
        _retained_free(name)
        if next < 0:
            val closed = retained_native_close(current as i32)
            return Err("SCVDB_DIR_COMPONENT_OPEN")
        val next_metadata = _retained_directory_security_metadata_v1(next)
        match next_metadata:
            case Err(_):
                val child_closed = retained_native_close(next as i32)
                val parent_closed = retained_native_close(current as i32)
                return Err("SCVDB_DIR_METADATA_UNAVAILABLE")
            case Ok(metadata):
                if metadata.owner_uid != metadata.effective_uid and metadata.owner_uid != 0u32:
                    val child_closed = retained_native_close(next as i32)
                    val parent_closed = retained_native_close(current as i32)
                    return Err("SCVDB_DIR_OWNER")
                if index + 1 == components.len() and not _retained_directory_owner_allowed_v1(metadata, false):
                    val child_closed = retained_native_close(next as i32)
                    val parent_closed = retained_native_close(current as i32)
                    return Err("SCVDB_DIR_FINAL_UNTRUSTED")
        if retained_native_close(current as i32) != 0:
            val child_closed = retained_native_close(next as i32)
            return Err("SCVDB_DIR_PARENT_CLOSE")
        current = next
        index = index + 1
    Ok(RetainedDirectoryOwnerV1(handle: current, closed: false))
    @else:
    Err("SCVDB_DIR_HOST_UNSUPPORTED")
    @end

@unsafe(reason: "opens a nofollow regular file relative to a retained directory descriptor", capabilities: [ffi, raw_ptr])
fn _retained_file_open_at_v1(directory_handle: i64, name: text, maximum: u64) -> Result<RetainedFile, text>:
    if maximum > 1099511627776u64: return Err("SCVDB_FILE_QUOTA")
    if name == "" or name == "." or name == ".." or name.len() > 255 or
            name.contains("/") or name.contains("\u0000"):
        return Err("SCVDB_FILE_PATH")
    @when(os="linux"):
    if directory_handle < 0: return Err("SCVDB_DIR_CLOSED")
    val file_flags = _retained_linux_file_flags_v1()
    if file_flags == 0: return Err("SCVDB_DIR_ARCH_UNSUPPORTED")
    val path = _retained_path(name)
    if path == 0: return Err("SCVDB_FILE_PATH")
    # O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK rejects FIFOs before metadata.
    val handle = openat(directory_handle as i32, path, file_flags, 0u32) as i64
    _retained_free(path)
    if handle < 0: return Err("SCVDB_FILE_OPEN")
    var file = RetainedFile(handle: handle, size: 0, identity: [], writable: false, closed: false, position: 0, maximum: maximum)
    match _retained_metadata(handle):
        case Err(error):
            val closed = file.close()
            Err(error)
        case Ok(meta):
            if meta.size > maximum:
                val closed = file.close()
                return Err("SCVDB_FILE_QUOTA")
            file.size = meta.size
            file.identity = meta.identity
            Ok(file)
    @else:
    Err("SCVDB_DIR_HOST_UNSUPPORTED")
    @end

@unsafe(reason: "opens nofollow regular file or exclusively creates private output", capabilities: [ffi, raw_ptr])
fn retained_file_open(path: text, maximum: u64, create: bool = false) -> Result<RetainedFile, text>:
    if maximum > 1099511627776u64: return Err("SCVDB_FILE_QUOTA")
    @when(os="windows"):
    val supported = true
    @else:
    @when(os="linux"):
    val supported = true
    @else:
    val supported = false
    @end
    @end
    if not supported: return Err("SCVDB_FILE_HOST_UNSUPPORTED")
    val ptr = _retained_path(path)
    if ptr == 0: return Err("SCVDB_FILE_PATH")
    var handle = -1i64
    @when(os="windows"):
    # GENERIC_WRITE does not include FILE_READ_ATTRIBUTES (0x80), required by
    # mandatory FileAttributeTagInfo/FileBasicInfo observations after create.
    val access = if create: 1073741952u32 else: 2147483648u32
    val disposition = if create: 1u32 else: 3u32
    handle = CreateFileW(ptr, access, 1u32, 0, disposition, 2097280u32, 0)
    @else:
    @when(os="linux"):
    # O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK prevents FIFO open from blocking before stat.
    val file_flags = _retained_linux_file_flags_v1()
    if file_flags == 0:
        _retained_free(ptr)
        return Err("SCVDB_FILE_ARCH_UNSUPPORTED")
    # Add O_WRONLY|O_CREAT|O_EXCL to the read-only base word; the base
    # already carries NONBLOCK|NOFOLLOW|CLOEXEC on every supported ABI.
    val flags = if create: file_flags + 193 else: file_flags
    handle = openat(-100, ptr, flags, 384u32) as i64
    @end
    @end
    _retained_free(ptr)
    if handle == -1: return Err("SCVDB_FILE_OPEN")
    var file = RetainedFile(handle: handle, size: 0, identity: [], writable: create, closed: false, position: 0, maximum: maximum)
    match _retained_metadata(handle):
        Err(error):
            val closed = file.close()
            return Err(error)
        Ok(meta):
            val size = meta.size
            val identity = meta.identity
            if size > maximum:
                val closed = file.close()
                return Err("SCVDB_FILE_QUOTA")
            file.size = size
            file.identity = identity
    Ok(file)

# Snapshot of the final directory entry only; ancestors must be trusted against
# replacement, just as for retained_file_open. Strip terminal separators so a
# final symlink cannot become an intermediate component through a trailing '/'.
# No new rt_* provider or subprocess fallback is introduced.
# https://man7.org/linux/man-pages/man2/open.2.html
# https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-createfilew
@unsafe(reason: "queries a no-follow native directory handle and closes it on every path", capabilities: [ffi, raw_ptr])
fn retained_directory_is_real_no_follow(path: text) -> bool:
    var directory = path
    @when(os="windows"):
    while directory.len() > 1 and (directory.ends_with("/") or directory.ends_with("\\")):
        if directory.len() == 3 and directory.byte_at(1) == 58: break
        directory = directory.substring(0, directory.len() - 1)
    @else:
    while directory.len() > 1 and directory.ends_with("/"):
        directory = directory.substring(0, directory.len() - 1)
    @end
    @when(os="windows"):
    val ptr = _retained_path(directory)
    if ptr == 0: return false
    # FILE_READ_ATTRIBUTES; share READ|WRITE|DELETE; OPEN_EXISTING;
    # FILE_FLAG_BACKUP_SEMANTICS|FILE_FLAG_OPEN_REPARSE_POINT.
    val handle = CreateFileW(ptr, 128u32, 7u32, 0, 3u32, 35651584u32, 0)
    _retained_free(ptr)
    if handle == -1: return false
    val metadata = _retained_alloc(8u64)
    var real = false
    if metadata != 0:
        # FileAttributeTagInfo: require DIRECTORY and reject REPARSE_POINT.
        if GetFileInformationByHandleEx(handle, 9, metadata, 8u32) != 0:
            real = (volatile_read_u32(metadata) & 1040) == 16
        _retained_free(metadata)
    val closed = CloseHandle(handle) != 0
    real and closed
    @else:
    @when(os="linux"):
    val ptr = _retained_path(directory)
    if ptr == 0: return false
    val directory_flags = _retained_linux_directory_flags_v1()
    if directory_flags == 0:
        _retained_free(ptr)
        return false
    val handle = openat(-100, ptr, directory_flags, 0u32)
    _retained_free(ptr)
    if handle < 0: return false
    close(handle) == 0
    @else:
    false
    @end
    @end

# under Stage 2 native codegen `[u8] != [u8]` is true for equal contents, so
# identity is compared element-wise.
# @workaround bug=native_u8_array_ne_compares_reference_2026_10_25 reason=see doc/08_tracking/bug/native_u8_array_ne_compares_reference_2026-10-25.md
fn _retained_bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len(): return false
    var index = 0
    while index < a.len():
        if a[index] != b[index]: return false
        index = index + 1
    true

fn retained_file_identity_unchanged(file: RetainedFile) -> Result<bool, text>:
    if file.closed or file.writable: return Err("SCVDB_FILE_STATE")
    val meta = _retained_metadata(file.handle)?
    val size = meta.size
    val identity = meta.identity
    if size != file.size or not _retained_bytes_equal(identity, file.identity): return Err("SCVDB_FILE_CHANGED")
    Ok(true)

fn retained_file_unchanged(file: RetainedFile) -> Result<bool, text>:
    retained_file_identity_unchanged(file)?
    if file.position != file.size: return Err("SCVDB_FILE_CHANGED")
    Ok(true)

# Single-owner, non-concurrent operation. Linux pread preserves the descriptor
# cursor. Windows synchronous seek/read/restore preserves the existing API's
# cursor. Failed restoration returns Err without secretly closing a copied
# owner; the next sequential me read reapplies its logical cursor. No reopen.
# https://man7.org/linux/man-pages/man2/pread.2.html
# https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-setfilepointerex
@unsafe(reason: "reads bounded retained file range while preserving sequential cursor", capabilities: [ffi, raw_ptr])
fn retained_file_read_at(file: RetainedFile, offset: u64, maximum: i64) -> Result<[u8], text>:
    if file.closed or file.writable or maximum < 1 or maximum > 1048576:
        return Err("SCVDB_FILE_READ_QUOTA")
    if offset > file.size or maximum as u64 > file.size - offset:
        return Err("SCVDB_FILE_READ_RANGE")
    retained_file_identity_unchanged(file)?
    val ptr = _retained_alloc((maximum + 8) as u64)
    if ptr == 0: return Err("SCVDB_FILE_MEMORY")
    var count = -1i64
    var restored = true
    @when(os="windows"):
    if SetFilePointerEx(file.handle, offset as i64, 0, 0u32) != 0:
        if ReadFile(file.handle, ptr, maximum as u32, ptr + maximum, 0) != 0:
            count = volatile_read_u32(ptr + maximum)
    restored = SetFilePointerEx(file.handle, file.position as i64, 0, 0u32) != 0
    @else:
    count = pread(file.handle as i32, ptr, maximum as u64, offset as i64)
    @end
    var bytes: [u8] = []
    if count >= 0 and count <= maximum and restored:
        for index in 0..count: bytes.push(volatile_read_u8(ptr + index) as u8)
    _retained_free(ptr)
    if not restored:
        return Err("SCVDB_FILE_CURSOR_RESTORE")
    if count < 0 or count > maximum: return Err("SCVDB_FILE_READ")
    retained_file_identity_unchanged(file)?
    Ok(bytes)

@unsafe(reason: "flushes exact owned output descriptor before close", capabilities: [ffi])
fn retained_file_sync(file: RetainedFile) -> bool:
    if file.closed or not file.writable: return false
    @when(os="windows"):
    FlushFileBuffers(file.handle) != 0
    @else:
    fsync(file.handle as i32) == 0
    @end

export RetainedFile, RetainedFileSecurityMetadataV1, retained_file_open
export RetainedDirectoryOwnerV1, retained_directory_open_trusted_v1
export retained_file_unchanged, retained_file_sync
export retained_file_read_at, retained_file_identity_unchanged
export retained_directory_is_real_no_follow
