# Decoder for the existing interpreter/native BDD count receipt wire.
# Invalid evidence is unknown, never zero passing/failing examples.
pub fn parse_test_result_evidence_v1(content: text) -> (i64, i64, i64):
    if content.len() > 64:
        return (0, 0, 0)
    val parts = content.split("\n")
    if parts.len() != 4 or parts[0] != "simple-bdd-v1" or parts[3] != "":
        return (0, 0, 0)
    val passed_text = parts[1]
    val failed_text = parts[2]
    if passed_text == "" or failed_text == "":
        return (0, 0, 0)
    val passed = passed_text.to_i64() ?? -1
    val failed = failed_text.to_i64() ?? -1
    if passed < 0 or failed < 0:
        return (0, 0, 0)
    if passed.to_text() != passed_text or failed.to_text() != failed_text:
        return (0, 0, 0)
    # Consumers add the two counts. Reject overflow before that addition.
    if passed > 9223372036854775807 - failed:
        return (0, 0, 0)
    (passed, failed, 1)

export parse_test_result_evidence_v1
