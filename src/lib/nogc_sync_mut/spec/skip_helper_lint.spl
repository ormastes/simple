"""
# Local skip-helper lint

A spec-local helper shaped `fn skip_on_interpreter(name: text, block: fn()):`
(or any `fn skip_*(name: text, block: fn()):`) whose body never mentions
`block` discards the example's assertions while the surrounding `it` still
reports PASS (doc/08_tracking/bug/local_skip_on_interpreter_shadow_discards_block_false_green_2026-08-17.md).
Use the std decorator or an `@tag:in-development` spec instead.
"""

# Names of local skip helpers whose body is an unconditional discard of `block`.
fn skip_helpers_discarding_block(source: text) -> [text]:
    var offenders: [text] = []
    val lines = source.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i].trim_end()
        if line.starts_with("fn skip_") and line.contains("(name: text, block: fn())") and line.ends_with(":"):
            var uses_block = false
            var j = i + 1
            while j < lines.len():
                val body = lines[j]
                if body.trim() != "" and not body.starts_with(" ") and not body.starts_with("\t"):
                    break
                if body.contains("block"):
                    uses_block = true
                j = j + 1
            if not uses_block:
                val head = line.split("(")[0]
                offenders.push(head.replace("fn ", ""))
            i = j
        else:
            i = i + 1
    offenders

export skip_helpers_discarding_block
