@allow(primitive_api)
# Counterpart Conformance — isolated-worker provider (Wave-1 F3).
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §3.2, §3.3
# Worker:  src/runtime/counterpart_worker_runtime.c
# Adapter ABI: tools/counterpart/sdk/c/simple_counterpart_abi.h
#
# primitive_api is allowed here for the same reason as the frozen model: the
# budgets, exit codes and signal numbers ARE the wire values the worker prints,
# and wrapping them would insert a conversion between the contract and the bytes
# that carry it.
#
# This module deliberately does NOT depend on the in-process `rt_counterpart_*`
# shim (`src/lib/nogc_sync_mut/sffi/counterpart_abi.spl`), which is not yet
# linked into the runtime — see
# doc/08_tracking/bug/counterpart_abi_shim_not_linked_into_runtime_2026-08-09.md.
# Everything here goes through ordinary process + file facilities, so an
# adapter that aborts inside the worker CANNOT touch the calling spec process.
#
# Status mapping — the whole point of the lane:
#
#   worker receipt        provider_status    comparison   artifact
#   executed              executed           not_compared complete
#   crashed               crashed            failed       partial
#   timed_out             timed_out          failed       partial
#   unavailable           unavailable        not_compared absent
#   rejected_manifest     rejected_manifest  failed       absent
#
# `crashed` is never rewritten to `unavailable`. An adapter that aborted is a
# defect; an adapter that is not installed is an environment fact. Collapsing
# them is how a real crash becomes a green run. An unrecognised status token is
# an Err, never a silent downgrade.

use std.common.spec.evidence.counterpart.model.{ProviderStatus, provider_status_name}

use std.io_runtime.{process_run}
use std.io_runtime.{file_write}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

pub val WORKER_REQUEST_MAGIC: text = "SCFQ1"
pub val WORKER_RECEIPT_MAGIC: text = "SCFR1"
pub val WORKER_RECEIPT_SCHEMA: text = "simple.counterpart.worker_receipt.v1"

pub struct WorkerBudget:
    timeout_ms: i64
    max_output_bytes: i64
    max_invocations: i64
    cpu_seconds: i64
    memory_bytes: i64

pub fn worker_budget_default() -> WorkerBudget:
    WorkerBudget(
        timeout_ms: 5000,
        max_output_bytes: 1048576,
        max_invocations: 64,
        cpu_seconds: 10,
        memory_bytes: 536870912
    )

pub struct WorkerConfig:
    worker_path: text
    adapter_path: text
    configuration: text
    request_file: text
    budget: WorkerBudget
    # Test seam honoured by the worker CHILD only, so the parent-side deadline
    # can be proven without a hanging component in the adapter under test.
    # Must be 0 in production runs.
    stall_ms: i64

pub fn worker_config(worker_path: text, adapter_path: text, request_file: text) -> WorkerConfig:
    WorkerConfig(
        worker_path: worker_path,
        adapter_path: adapter_path,
        configuration: "",
        request_file: request_file,
        budget: worker_budget_default(),
        stall_ms: 0
    )

# ---------------------------------------------------------------------------
# Outcome
# ---------------------------------------------------------------------------

pub struct WorkerOutcome:
    provider_status: ProviderStatus
    comparison_status: text
    artifact_status: text
    component_id: text
    invocation: i64
    call_status: i64
    exit_signal: i64
    exit_code: i64
    duration_ms: i64
    response: text
    trace: text
    diagnostic: text
    worker_exit_code: i64

pub fn outcome_is_pass(outcome: WorkerOutcome) -> bool:
    match outcome.provider_status:
        ProviderStatus.executed => outcome.comparison_status != "failed"
        _ => false

pub fn outcome_status_name(outcome: WorkerOutcome) -> text:
    provider_status_name(outcome.provider_status)

fn comparison_for(status: ProviderStatus) -> text:
    match status:
        ProviderStatus.executed => "not_compared"
        ProviderStatus.unavailable => "not_compared"
        ProviderStatus.crashed => "failed"
        ProviderStatus.timed_out => "failed"
        ProviderStatus.rejected_manifest => "failed"

fn artifact_for(status: ProviderStatus) -> text:
    match status:
        ProviderStatus.executed => "complete"
        ProviderStatus.unavailable => "absent"
        ProviderStatus.crashed => "partial"
        ProviderStatus.timed_out => "partial"
        ProviderStatus.rejected_manifest => "absent"

fn parse_provider_status(raw: text) -> Result<ProviderStatus, text>:
    if raw == "executed":
        return Ok(ProviderStatus.executed)
    if raw == "unavailable":
        return Ok(ProviderStatus.unavailable)
    if raw == "crashed":
        return Ok(ProviderStatus.crashed)
    if raw == "timed_out":
        return Ok(ProviderStatus.timed_out)
    if raw == "rejected_manifest":
        return Ok(ProviderStatus.rejected_manifest)
    Err("unrecognised provider_status token: '{raw}'")

# ---------------------------------------------------------------------------
# Framing
# ---------------------------------------------------------------------------

fn is_ascii(value: text) -> bool:
    var index = 0
    while index < value.len():
        if value.char_code_at(index) > 127:
            return false
        index = index + 1
    true

# One length-framed request. Lengths are ASCII decimal so the header is
# greppable and shell-generatable; payload bytes are raw and never assumed
# NUL-terminated. This helper carries ASCII payloads only, because the text
# length it measures must equal the byte length the worker reads.
pub fn frame_request(component_id: text, request: text) -> Result<text, text>:
    if not is_ascii(component_id):
        return Err("component_id must be ASCII for text framing")
    if not is_ascii(request):
        return Err("request payload must be ASCII for text framing")
    Ok("{WORKER_REQUEST_MAGIC} {component_id.len()} {request.len()}\n{component_id}{request}")

pub fn frame_requests(frames: [text]) -> text:
    frames.join("")

# ---------------------------------------------------------------------------
# Receipt parsing
# ---------------------------------------------------------------------------

fn has_field(line: text, key: text) -> bool:
    line.starts_with(key + ": ")

# Empty result means "this line is not that field": every real value the worker
# writes is either a number or a quoted literal, so it is never empty text.
fn field_after(line: text, key: text) -> text:
    val prefix = key + ": "
    if line.starts_with(prefix):
        return line.slice(prefix.len(), line.len())
    ""

fn unquote(raw: text) -> text:
    var body = raw
    if body.len() >= 2 and body.starts_with("\""):
        body = body.slice(1, body.len() - 1)
    var out = ""
    var index = 0
    while index < body.len():
        val ch = body.slice(index, index + 1)
        if ch == "\\" and index + 1 < body.len():
            val next = body.slice(index + 1, index + 2)
            if next == "x" and index + 3 < body.len():
                val code = hex_pair(body.slice(index + 2, index + 4))
                if code == 10:
                    out = out + "\n"
                else:
                    out = out + "?"
                index = index + 4
            else:
                out = out + next
                index = index + 2
        else:
            out = out + ch
            index = index + 1
    out

fn hex_digit(ch: text) -> i64:
    val digits = "0123456789abcdef"
    var index = 0
    while index < digits.len():
        if digits.slice(index, index + 1) == ch:
            return index
        index = index + 1
    -1

fn hex_pair(pair: text) -> i64:
    if pair.len() != 2:
        return -1
    val high = hex_digit(pair.slice(0, 1))
    val low = hex_digit(pair.slice(1, 2))
    if high < 0 or low < 0:
        return -1
    high * 16 + low

# Own digit parser: the receipt's numbers are plain ASCII decimals, and a
# parser that returns a sentinel keeps a missing field from reading as 0.
fn parse_decimal(raw: text) -> i64:
    val body = raw.trim()
    if body.len() == 0:
        return -1
    var value: i64 = 0
    var index = 0
    while index < body.len():
        val digit = hex_digit(body.slice(index, index + 1))
        if digit < 0 or digit > 9:
            return -1
        value = value * 10 + digit
        index = index + 1
    value

fn number_field(line: text, key: text) -> i64:
    if has_field(line, key):
        return parse_decimal(field_after(line, key))
    -1

# Parse ONE receipt out of the worker's framed stdout. The frame header is
# required: stdout that does not carry a receipt is an Err, never an assumed
# "unavailable".
pub fn parse_receipt(stdout: text) -> Result<WorkerOutcome, text>:
    if not stdout.contains(WORKER_RECEIPT_MAGIC):
        return Err("worker stdout carries no {WORKER_RECEIPT_MAGIC} receipt frame")
    if not stdout.contains(WORKER_RECEIPT_SCHEMA):
        return Err("worker receipt does not declare schema {WORKER_RECEIPT_SCHEMA}")

    var status_token = ""
    var component_id = ""
    var invocation: i64 = 0
    var call_status: i64 = 0
    var exit_signal: i64 = 0
    var exit_code: i64 = 0
    var duration_ms: i64 = 0
    var response = ""
    var trace = ""
    var diagnostic = ""

    for line in stdout.split("\n"):
        if has_field(line, "provider_status"):
            status_token = field_after(line, "provider_status").trim()
        if has_field(line, "component_id"):
            component_id = unquote(field_after(line, "component_id").trim())
        if has_field(line, "invocation"):
            invocation = number_field(line, "invocation")
        if has_field(line, "call_status"):
            call_status = number_field(line, "call_status")
        if has_field(line, "exit_signal"):
            exit_signal = number_field(line, "exit_signal")
        if has_field(line, "exit_code"):
            exit_code = number_field(line, "exit_code")
        if has_field(line, "duration_ms"):
            duration_ms = number_field(line, "duration_ms")
        if has_field(line, "response"):
            response = unquote(field_after(line, "response"))
        if has_field(line, "trace"):
            trace = unquote(field_after(line, "trace"))
        if has_field(line, "diagnostic"):
            diagnostic = unquote(field_after(line, "diagnostic"))

    if status_token == "":
        return Err("worker receipt declares no provider_status")

    match parse_provider_status(status_token):
        Ok(status):
            Ok(WorkerOutcome(
                provider_status: status,
                comparison_status: comparison_for(status),
                artifact_status: artifact_for(status),
                component_id: component_id,
                invocation: invocation,
                call_status: call_status,
                exit_signal: exit_signal,
                exit_code: exit_code,
                duration_ms: duration_ms,
                response: response,
                trace: trace,
                diagnostic: diagnostic,
                worker_exit_code: 0
            ))
        Err(message):
            Err(message)

# ---------------------------------------------------------------------------
# Invocation
# ---------------------------------------------------------------------------

fn shell_quote(value: text) -> Result<text, text>:
    if value.contains("'"):
        return Err("path or configuration contains a single quote: '{value}'")
    Ok("'" + value + "'")

fn worker_command(config: WorkerConfig) -> Result<text, text>:
    val worker = shell_quote(config.worker_path)?
    val adapter = shell_quote(config.adapter_path)?
    val configuration = shell_quote(config.configuration)?
    val request_file = shell_quote(config.request_file)?
    var prefix = ""
    if config.stall_ms > 0:
        prefix = "SCF_WORKER_TEST_STALL_MS={config.stall_ms} "
    val budget = config.budget
    Ok("{prefix}{worker} --adapter {adapter} --config {configuration}"
        + " --timeout-ms {budget.timeout_ms}"
        + " --max-output-bytes {budget.max_output_bytes}"
        + " --max-invocations {budget.max_invocations}"
        + " --cpu-seconds {budget.cpu_seconds}"
        + " --memory-bytes {budget.memory_bytes}"
        + " < {request_file}")

# Spawn the worker for exactly one framed request and map its receipt onto the
# frozen ProviderStatus vocabulary. The calling process never dlopens anything,
# so a provider abort is observed, not suffered.
pub fn invoke_isolated(config: WorkerConfig, component_id: text, request: text) -> Result<WorkerOutcome, text>:
    val frame = frame_request(component_id, request)?
    if not file_write(config.request_file, frame):
        return Err("could not write request frame to {config.request_file}")
    val command = worker_command(config)?
    val (stdout, stderr, worker_exit_code) = process_run("/bin/sh", ["-c", command])
    match parse_receipt(stdout):
        Ok(outcome):
            Ok(WorkerOutcome(
                provider_status: outcome.provider_status,
                comparison_status: outcome.comparison_status,
                artifact_status: outcome.artifact_status,
                component_id: outcome.component_id,
                invocation: outcome.invocation,
                call_status: outcome.call_status,
                exit_signal: outcome.exit_signal,
                exit_code: outcome.exit_code,
                duration_ms: outcome.duration_ms,
                response: outcome.response,
                trace: outcome.trace,
                diagnostic: outcome.diagnostic,
                worker_exit_code: worker_exit_code
            ))
        Err(message):
            Err("{message}; worker exit {worker_exit_code}; stderr: {stderr}")
