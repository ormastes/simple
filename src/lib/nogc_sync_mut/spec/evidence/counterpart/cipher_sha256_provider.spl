@allow(primitive_api)
# Counterpart Conformance — cipher/digest lane (Wave 5, K1/K2 partial; lane C3).
#
# primitive_api is allowed here deliberately: hex digests, exit codes and item
# counts are the frozen Wave-0 wire types this descriptor forwards verbatim.
#
# A descriptor, not a central-registry edit (per "Agent execution rules" #9 in
# doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md).
# It builds three SourceResults for one SHA-256 boundary:
#
#   * `simple-sha256-native`   — Simple's own implementation
#     (src/lib/common/crypto/sha256.spl), independence_group "simple-native"
#   * `openssl-sha256-cli`     — the real `/usr/bin/openssl` CLI, invoked as a
#     process_bridge via `process_run_bounded` (never a dynlib/FFI helper —
#     that belongs to a different concurrent lane), independence_group
#     "openssl-cli-process"
#   * `nist-sha256-vector`     — a hardcoded published FIPS 180-4 / NIST
#     known-answer digest, independence_group "nist-vector-fixture",
#     `OracleAuthority.normative_vector`
#
# Central semantic rule this lane exists to prove (encoded in
# matrix_normative_failures, src/lib/nogc_sync_mut/spec/evidence/counterpart/matrix_compare.spl):
# a normative_vector source OUTRANKS agreement between two implementations. If
# Simple and OpenSSL agree with each other but both differ from the NIST
# vector, the run must still be REJECTED — this is a ranking, not a vote.
#
# The comparison relation is `byte_exact` only — never a fuzzy/tolerant
# relation for a cryptographic digest.
#
# Design: doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md (Wave 2, P4)

use std.common.spec.evidence.counterpart.model.{
    LogicalArtifact,
    ExecutionMode,
    ExecutionReceipt,
    ProvenanceReceipt,
    ProviderStatus,
    OracleAuthority,
    CounterpartRelation,
    SourceResult,
    PlanSource,
    PlanComparison,
    CounterpartPlan,
    plan_source,
    plan_comparison,
    counterpart_plan,
    execution_receipt_cpu
}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.common.crypto.sha256.{sha256_text}

pub val CIPHER_SHA256_BOUNDARY: text = "cipher.digest.sha256@1"
pub val CIPHER_SHA256_SCHEMA_ID: text = "cipher.sha256.digest"
pub val CIPHER_SHA256_SCHEMA_VERSION: i64 = 1

# Pinned real-binary default. Tests override this to a bogus path to prove the
# unavailable path (never treated as an ordinary crash or false pass).
pub val OPENSSL_DEFAULT_PATH: text = "/usr/bin/openssl"

fn cipher_artifact(hex: text, message_label: text) -> LogicalArtifact:
    LogicalArtifact(
        boundary_id: CIPHER_SHA256_BOUNDARY,
        schema_id: CIPHER_SHA256_SCHEMA_ID,
        schema_version: CIPHER_SHA256_SCHEMA_VERSION,
        item_count: 1,
        canonical_hash: hex,
        artifact_ref: message_label
    )

fn cipher_provenance(run_id: text, message_label: text) -> ProvenanceReceipt:
    ProvenanceReceipt(
        package_manifest_hash: "cipher-sha256-lane/no-package-manager",
        provider_manifest_hash: "cipher-sha256-lane/descriptor-v1",
        input_hash: message_label,
        converter_route_hash: "identity",
        environment_profile: "host-cpu",
        run_id: run_id
    )

fn unavailable_source(source_id: text, provider_id: text, independence_group: text,
        message_label: text, reason: text) -> SourceResult:
    SourceResult(
        source_id: source_id,
        provider_id: provider_id,
        independence_group: independence_group,
        status: ProviderStatus.unavailable,
        artifact: cipher_artifact("", message_label),
        execution: execution_receipt_cpu(provider_id),
        provenance: cipher_provenance(source_id, message_label),
        conversions: [],
        diagnostics: [reason]
    )

# ---------------------------------------------------------------------------
# Source: Simple's own implementation
# ---------------------------------------------------------------------------

pub fn simple_sha256_source(source_id: text, message: text, message_label: text) -> SourceResult:
    val hex = sha256_text(message)
    SourceResult(
        source_id: source_id,
        provider_id: "simple-sha256-native",
        independence_group: "simple-native",
        status: ProviderStatus.executed,
        artifact: cipher_artifact(hex, message_label),
        execution: execution_receipt_cpu("simple-sha256-native"),
        provenance: cipher_provenance(source_id, message_label),
        conversions: [],
        diagnostics: []
    )

# ---------------------------------------------------------------------------
# Source: real OpenSSL CLI, process-bridge
# ---------------------------------------------------------------------------

# Single-quote a shell word so `printf '%s' <quoted>` reproduces `message`
# byte-for-byte, including the empty string.
fn shell_single_quote(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

# Existence/executability probed through the same process bridge used for the
# real invocation (never a dynlib/FFI helper, and never the ambiguous
# `std.fs` module-vs-class-static `exists` overload set).
fn binary_is_executable(path: text) -> bool:
    val (_stdout, _stderr, exit_code) = process_run_bounded(
        "/bin/sh", ["-c", "test -x " + shell_single_quote(path)], 5000, 4096)
    exit_code == 0

# `openssl dgst -sha256` on stdin prints one line: `SHA2-256(stdin)= <hex>`
# (OpenSSL 3.0.13, verified live). The hex digest is everything after the
# last "= ".
fn extract_openssl_hex(stdout: text) -> text:
    val parts = stdout.split("= ")
    if parts.len() < 2:
        return ""
    parts[parts.len() - 1].trim()

# Real process-bridge invocation. `process_run_bounded` is called directly
# (src/lib/nogc_sync_mut/io/process_ops.spl:76) — no dynlib/FFI helper.
pub fn openssl_sha256_source(
    source_id: text,
    openssl_path: text,
    message: text,
    message_label: text,
    timeout_ms: i64
) -> SourceResult:
    if openssl_path == "" or not binary_is_executable(openssl_path):
        return unavailable_source(source_id, "openssl-sha256-cli", "openssl-cli-process",
            message_label, "openssl binary not found at '" + openssl_path + "'")

    val shell_cmd = "printf '%s' " + shell_single_quote(message) + " | "
        + shell_single_quote(openssl_path) + " dgst -sha256"
    val (stdout, stderr, exit_code) = process_run_bounded(
        "/bin/sh", ["-c", shell_cmd], timeout_ms, 65536)

    if exit_code != 0:
        return SourceResult(
            source_id: source_id,
            provider_id: "openssl-sha256-cli",
            independence_group: "openssl-cli-process",
            status: ProviderStatus.crashed,
            artifact: cipher_artifact("", message_label),
            execution: execution_receipt_cpu("openssl-sha256-cli"),
            provenance: cipher_provenance(source_id, message_label),
            conversions: [],
            diagnostics: ["openssl exited " + exit_code.to_text() + ": " + stderr]
        )

    val hex = extract_openssl_hex(stdout)
    SourceResult(
        source_id: source_id,
        provider_id: "openssl-sha256-cli",
        independence_group: "openssl-cli-process",
        status: ProviderStatus.executed,
        artifact: cipher_artifact(hex, message_label),
        execution: ExecutionReceipt(
            provider_id: "openssl-sha256-cli",
            execution_mode: ExecutionMode.cpu_reference,
            device_identity: "openssl-cli@" + openssl_path,
            queue_identity: "",
            submission_count: 0,
            fence_completed: false,
            device_origin_readback: false,
            fallback_used: false,
            dropped_events: 0,
            completed: true
        ),
        provenance: cipher_provenance(source_id, message_label),
        conversions: [],
        diagnostics: [stdout.trim()]
    )

# ---------------------------------------------------------------------------
# Source: hardcoded published NIST/FIPS 180-4 known-answer vector
# ---------------------------------------------------------------------------

pub fn nist_sha256_vector_source(source_id: text, expected_hex: text, message_label: text) -> SourceResult:
    SourceResult(
        source_id: source_id,
        provider_id: "nist-fips180-4-vector",
        independence_group: "nist-vector-fixture",
        status: ProviderStatus.executed,
        artifact: cipher_artifact(expected_hex, message_label),
        execution: execution_receipt_cpu("nist-fips180-4-vector"),
        provenance: cipher_provenance(source_id, message_label),
        conversions: [],
        diagnostics: []
    )

# ---------------------------------------------------------------------------
# Plan: full triangle so a normative-vector disagreement is caught even when
# the two implementations agree with each other.
# ---------------------------------------------------------------------------

pub fn cipher_sha256_plan(plan_id: text, message_label: text) -> CounterpartPlan:
    val sources: [PlanSource] = [
        plan_source("simple", "simple-sha256-native", "sha256", OracleAuthority.differential_peer, true),
        plan_source("openssl", "openssl-sha256-cli", "sha256", OracleAuthority.independent_reference, true),
        plan_source("nist", "nist-fips180-4-vector", "sha256", OracleAuthority.normative_vector, true)
    ]
    val comparisons: [PlanComparison] = [
        plan_comparison("simple", "openssl", CounterpartRelation.byte_exact),
        plan_comparison("simple", "nist", CounterpartRelation.byte_exact),
        plan_comparison("openssl", "nist", CounterpartRelation.byte_exact)
    ]
    counterpart_plan(plan_id, CIPHER_SHA256_BOUNDARY, "host-cpu", message_label, sources, comparisons)
