@allow(primitive_api)
# Counterpart Conformance — package / build resolver (lane F2).
#
# primitive_api is allowed here for the same reason as the frozen contract
# module: the lock record is an on-disk SDN schema whose fields are counts and
# versions, and the predicates below answer questions about those bytes. A
# newtype at this layer would put a conversion between the record and the file.
#
# This module answers exactly one question, fail-closed:
#
#     given a provider descriptor and the lockfile, is there a VERIFIED local
#     artifact this run is allowed to load?
#
# Every "no" is a distinct, named reason. The three rules that matter:
#
#   1. A provider with no lock record, a hash mismatch, or no artifact on disk
#      resolves to ProviderStatus.unavailable. It NEVER resolves to a pass.
#   2. A lock record whose hashes are the literal placeholder `pending` is
#      UNVERIFIED — a state distinct from verified, so a placeholder can never
#      masquerade as a checked hash. It is also unavailable.
#   3. A descriptor the frozen contract rejects (ABI mismatch, missing SPDX,
#      malformed boundary id) resolves to rejected_manifest, before any hash is
#      even consulted.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §4, §5
# ADR:    doc/04_architecture/infra/adr/adr_counterpart_conformance_contract_freeze_2026-08-09.md

use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.io_runtime.{read_file, file_exists, file_read_bytes, dir_list}
use std.common.spec.evidence.counterpart.model.{
    COUNTERPART_ABI_VERSION,
    ComponentManifest,
    ProviderKind,
    ProviderManifest,
    ProviderStatus,
    provider_manifest_rejections,
    provider_status_name
}

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# The literal written into a lock record whose real digest is not yet known.
# Treating this as "a hash that did not match" would be wrong — it never had a
# value to match against — so it gets its own verification state.
pub val COUNTERPART_PLACEHOLDER_HASH: text = "pending"

pub val COUNTERPART_PROVIDER_DIR: text = "config/counterpart/providers"
pub val COUNTERPART_LOCK_PATH: text = "config/counterpart/counterpart.lock.sdn"
pub val COUNTERPART_CACHE_ROOT: text = "build/counterparts"

# ---------------------------------------------------------------------------
# Records
# ---------------------------------------------------------------------------

pub struct ProviderDescriptor:
    provider_id: text
    provider_kind: text
    independence_group: text
    abi_version: i64
    license_spdx: text
    upstream_kind: text
    adapter_source: text
    adapter_output: text
    components: [ComponentManifest]
    parse_errors: [text]

pub struct LockRecord:
    provider_id: text
    upstream_url: text
    upstream_revision: text
    source_archive_sha256: text
    patch_set_sha256: text
    adapter_source_sha256: text
    build_recipe_version: i64
    toolchain_identity: text
    target_triple: text
    build_options: text
    license_spdx: text
    artifact_sha256: text
    sbom_sha256: text

# Verification is a five-way answer, not a bool. `unverified_placeholder` is the
# reason this enum exists: a `pending` hash is neither verified nor mismatched.
pub enum VerificationState:
    verified
    unverified_placeholder
    hash_mismatch
    artifact_missing
    lock_missing
    descriptor_rejected

pub fn verification_state_name(state: VerificationState) -> text:
    match state:
        VerificationState.verified => "verified"
        VerificationState.unverified_placeholder => "unverified_placeholder"
        VerificationState.hash_mismatch => "hash_mismatch"
        VerificationState.artifact_missing => "artifact_missing"
        VerificationState.lock_missing => "lock_missing"
        VerificationState.descriptor_rejected => "descriptor_rejected"

pub fn verification_state_is_verified(state: VerificationState) -> bool:
    match state:
        VerificationState.verified => true
        _ => false

pub struct ResolvedProvider:
    provider_id: text
    status: ProviderStatus
    verification: VerificationState
    build_digest: text
    cache_dir: text
    artifact_path: text
    reasons: [text]

pub fn resolved_provider_is_usable(resolved: ResolvedProvider) -> bool:
    match resolved.status:
        ProviderStatus.executed => verification_state_is_verified(resolved.verification)
        _ => false

# ---------------------------------------------------------------------------
# Minimal SDN reader
# ---------------------------------------------------------------------------
#
# Deliberately small: the counterpart descriptor and lock schemas are two fixed
# shapes, so this reads those shapes rather than pretending to be a general SDN
# parser someone might reuse for something it cannot handle.

fn leading_spaces(line: text) -> i64:
    var count: i64 = 0
    while count < line.len():
        if line.substring(count, count + 1) != " ":
            return count
        count = count + 1
    count

fn strip_quotes(raw: text) -> text:
    if raw.len() >= 2 and raw.starts_with("\"") and raw.ends_with("\""):
        return raw.substring(1, raw.len() - 1)
    raw

fn parse_list_value(raw: text) -> [text]:
    var items: [text] = []
    if not (raw.starts_with("[") and raw.ends_with("]")):
        return items
    val inner = raw.substring(1, raw.len() - 1).trim()
    if inner == "":
        return items
    for piece in inner.split(","):
        val cleaned = strip_quotes(piece.trim())
        if cleaned != "":
            items.push(cleaned)
    items

fn is_skippable(trimmed: text) -> bool:
    trimmed == "" or trimmed.starts_with("#")

# Section headers are told apart from fields by the RAW text after the colon: a
# header has literally nothing there. Stripping quotes first would make
# `upstream_url: ""` — a real, deliberately-empty field — look like a header and
# silently end the block it lives in.
fn split_key(trimmed: text) -> [text]:
    val idx = trimmed.find(":")
    if idx < 0:
        return []
    val key = trimmed.substring(0, idx).trim()
    val value = trimmed.substring(idx + 1, trimmed.len()).trim()
    [key, value]

fn empty_component() -> ComponentManifest:
    ComponentManifest(
        component_id: "",
        counterpart_boundary_id: "",
        input_schema_id: "",
        output_schema_id: "",
        stateful: false,
        reset_supported: false,
        deterministic_claim: "",
        supported_relations: [],
        supported_execution_modes: [],
        capability_requirements: []
    )

fn component_with_field(component: ComponentManifest, key: text, raw_value: text) -> ComponentManifest:
    val value = strip_quotes(raw_value)
    var updated = component
    if key == "component_id":
        updated.component_id = value
    elif key == "counterpart_boundary_id":
        updated.counterpart_boundary_id = value
    elif key == "input_schema_id":
        updated.input_schema_id = value
    elif key == "output_schema_id":
        updated.output_schema_id = value
    elif key == "stateful":
        updated.stateful = value == "true"
    elif key == "reset_supported":
        updated.reset_supported = value == "true"
    elif key == "deterministic_claim":
        updated.deterministic_claim = value
    elif key == "supported_relations":
        updated.supported_relations = parse_list_value(value)
    elif key == "supported_execution_modes":
        updated.supported_execution_modes = parse_list_value(value)
    elif key == "capability_requirements":
        updated.capability_requirements = parse_list_value(value)
    updated

# ---------------------------------------------------------------------------
# Descriptor parsing
# ---------------------------------------------------------------------------

pub fn parse_provider_descriptor(source: text) -> ProviderDescriptor:
    var provider_id: text = ""
    var provider_kind: text = ""
    var independence_group: text = ""
    var abi_version: i64 = -1
    var license_spdx: text = ""
    var upstream_kind: text = ""
    var adapter_source: text = ""
    var adapter_output: text = ""
    var components: [ComponentManifest] = []
    var errors: [text] = []

    var in_components: bool = false
    var have_current: bool = false
    var current = empty_component()

    for raw_line in source.split("\n"):
        val trimmed = raw_line.trim()
        if is_skippable(trimmed):
            continue
        val indent = leading_spaces(raw_line)

        if trimmed.starts_with("- "):
            if not in_components:
                errors.push("list item outside a components block: " + trimmed)
                continue
            if have_current:
                components.push(current)
            current = empty_component()
            have_current = true
            val item_parts = split_key(trimmed.substring(2, trimmed.len()).trim())
            if item_parts.len() == 2:
                current = component_with_field(current, item_parts[0], item_parts[1])
            else:
                errors.push("malformed component entry: " + trimmed)
            continue

        val parts = split_key(trimmed)
        if parts.len() != 2:
            errors.push("malformed line: " + trimmed)
            continue
        val key = parts[0]
        val raw_value = parts[1]
        val value = strip_quotes(raw_value)

        if raw_value == "":
            # A section header. `components:` opens the list; anything else
            # closes it, so a stray field after the list is not silently
            # absorbed into the last component.
            if key == "components":
                in_components = true
            else:
                if have_current:
                    components.push(current)
                    have_current = false
                in_components = false
            continue

        if in_components and have_current and indent >= 6:
            current = component_with_field(current, key, value)
            continue

        if key == "provider_id":
            provider_id = value
        elif key == "provider_kind":
            provider_kind = value
        elif key == "independence_group":
            independence_group = value
        elif key == "abi_version":
            abi_version = value.to_i64()
        elif key == "license_spdx":
            license_spdx = value
        elif key == "kind":
            upstream_kind = value
        elif key == "source":
            adapter_source = value
        elif key == "output":
            adapter_output = value

    if have_current:
        components.push(current)

    ProviderDescriptor(
        provider_id: provider_id,
        provider_kind: provider_kind,
        independence_group: independence_group,
        abi_version: abi_version,
        license_spdx: license_spdx,
        upstream_kind: upstream_kind,
        adapter_source: adapter_source,
        adapter_output: adapter_output,
        components: components,
        parse_errors: errors
    )

pub fn load_provider_descriptor(path: text) -> ProviderDescriptor?:
    if not file_exists(path):
        return nil
    parse_provider_descriptor(read_file(path))

# Every descriptor under a providers directory. Domain lanes drop a file in
# here; nobody edits a central registry list.
pub fn load_provider_descriptors(dir_path: text) -> [ProviderDescriptor]:
    var loaded: [ProviderDescriptor] = []
    for entry in dir_list(dir_path):
        if not entry.ends_with(".sdn"):
            continue
        val full = if entry.starts_with(dir_path): entry else: dir_path + "/" + entry
        if val descriptor = load_provider_descriptor(full):
            loaded.push(descriptor)
    loaded

pub fn provider_kind_is_known(name: text) -> bool:
    (name == "native_in_process"
        or name == "native_isolated_worker"
        or name == "process_bridge"
        or name == "qemu_guest_bridge"
        or name == "remote_bridge")

pub fn provider_kind_from_name(name: text) -> ProviderKind:
    if name == "native_in_process":
        return ProviderKind.native_in_process
    if name == "native_isolated_worker":
        return ProviderKind.native_isolated_worker
    if name == "qemu_guest_bridge":
        return ProviderKind.qemu_guest_bridge
    if name == "remote_bridge":
        return ProviderKind.remote_bridge
    ProviderKind.process_bridge

# ---------------------------------------------------------------------------
# Lockfile parsing
# ---------------------------------------------------------------------------

fn empty_lock_record() -> LockRecord:
    LockRecord(
        provider_id: "",
        upstream_url: "",
        upstream_revision: "",
        source_archive_sha256: "",
        patch_set_sha256: "",
        adapter_source_sha256: "",
        build_recipe_version: -1,
        toolchain_identity: "",
        target_triple: "",
        build_options: "",
        license_spdx: "",
        artifact_sha256: "",
        sbom_sha256: ""
    )

fn lock_record_with_field(record: LockRecord, key: text, raw_value: text) -> LockRecord:
    val value = strip_quotes(raw_value)
    var updated = record
    if key == "provider_id":
        updated.provider_id = value
    elif key == "upstream_url":
        updated.upstream_url = value
    elif key == "upstream_revision":
        updated.upstream_revision = value
    elif key == "source_archive_sha256":
        updated.source_archive_sha256 = value
    elif key == "patch_set_sha256":
        updated.patch_set_sha256 = value
    elif key == "adapter_source_sha256":
        updated.adapter_source_sha256 = value
    elif key == "build_recipe_version":
        updated.build_recipe_version = value.to_i64()
    elif key == "toolchain_identity":
        updated.toolchain_identity = value
    elif key == "target_triple":
        updated.target_triple = value
    elif key == "build_options":
        updated.build_options = value
    elif key == "license_spdx":
        updated.license_spdx = value
    elif key == "artifact_sha256":
        updated.artifact_sha256 = value
    elif key == "sbom_sha256":
        updated.sbom_sha256 = value
    updated

pub fn parse_lock_file(source: text) -> [LockRecord]:
    var records: [LockRecord] = []
    var current = empty_lock_record()
    var have_current: bool = false
    var in_entries: bool = false

    for raw_line in source.split("\n"):
        val trimmed = raw_line.trim()
        if is_skippable(trimmed):
            continue

        if trimmed.starts_with("- "):
            if not in_entries:
                continue
            if have_current:
                records.push(current)
            current = empty_lock_record()
            have_current = true
            val item_parts = split_key(trimmed.substring(2, trimmed.len()).trim())
            if item_parts.len() == 2:
                current = lock_record_with_field(current, item_parts[0], item_parts[1])
            continue

        val parts = split_key(trimmed)
        if parts.len() != 2:
            continue
        val key = parts[0]
        val value = parts[1]

        if value == "":
            if key == "entries":
                in_entries = true
            else:
                if have_current:
                    records.push(current)
                    have_current = false
                in_entries = false
            continue

        if in_entries and have_current:
            current = lock_record_with_field(current, key, value)

    if have_current:
        records.push(current)
    records

pub fn load_lock_file(path: text) -> [LockRecord]:
    if not file_exists(path):
        return []
    parse_lock_file(read_file(path))

pub fn lock_record_for(records: [LockRecord], provider_id: text) -> LockRecord?:
    for record in records:
        if record.provider_id == provider_id:
            return record
    nil

# ---------------------------------------------------------------------------
# Lock record checks
# ---------------------------------------------------------------------------

pub fn hash_is_placeholder(value: text) -> bool:
    value == COUNTERPART_PLACEHOLDER_HASH

# Placeholder hashes are reported separately from missing fields so the two can
# never be conflated: an empty field is a malformed lock, a `pending` field is a
# well-formed lock that has not been built yet.
pub fn lock_record_has_placeholder(record: LockRecord) -> bool:
    (hash_is_placeholder(record.artifact_sha256)
        or hash_is_placeholder(record.adapter_source_sha256)
        or hash_is_placeholder(record.sbom_sha256)
        or hash_is_placeholder(record.source_archive_sha256)
        or hash_is_placeholder(record.patch_set_sha256))

pub fn lock_record_rejections(record: LockRecord) -> [text]:
    var failures: [text] = []
    if record.provider_id == "":
        failures.push("lock record has no provider_id")
    if record.artifact_sha256 == "":
        failures.push("lock record for " + record.provider_id + " has no artifact_sha256")
    if record.target_triple == "":
        failures.push("lock record for " + record.provider_id + " has no target_triple")
    if record.toolchain_identity == "":
        failures.push("lock record for " + record.provider_id + " has no toolchain_identity")
    if record.license_spdx == "":
        failures.push("lock record for " + record.provider_id + " has no license_spdx")
    if record.build_recipe_version < 1:
        failures.push("lock record for " + record.provider_id + " has no build_recipe_version")
    failures

# ---------------------------------------------------------------------------
# Descriptor -> frozen manifest
# ---------------------------------------------------------------------------

# The descriptor is only ever validated through the FROZEN contract predicate,
# so a rule added to `provider_manifest_rejections` applies here for free rather
# than being re-derived (and drifting) in the resolver.
pub fn descriptor_to_manifest(
    descriptor: ProviderDescriptor,
    version: text,
    artifact_hash: text
) -> ProviderManifest:
    ProviderManifest(
        provider_id: descriptor.provider_id,
        provider_kind: provider_kind_from_name(descriptor.provider_kind),
        independence_group: descriptor.independence_group,
        abi_version: descriptor.abi_version,
        version: version,
        artifact_hash: artifact_hash,
        license_spdx: descriptor.license_spdx,
        components: descriptor.components
    )

pub fn descriptor_rejections(descriptor: ProviderDescriptor, artifact_hash: text) -> [text]:
    var failures: [text] = []
    for parse_error in descriptor.parse_errors:
        failures.push("descriptor parse error: " + parse_error)
    if not provider_kind_is_known(descriptor.provider_kind):
        failures.push("unknown provider_kind '" + descriptor.provider_kind + "'")
    for rejection in provider_manifest_rejections(
        descriptor_to_manifest(descriptor, "", artifact_hash)
    ):
        failures.push(rejection)
    failures

# ---------------------------------------------------------------------------
# Cache addressing
# ---------------------------------------------------------------------------

# The digest covers everything that can change the bytes of the artifact. Two
# builds that differ in toolchain, target, options or adapter source land in
# different directories rather than overwriting one another.
pub fn build_digest(descriptor: ProviderDescriptor, record: LockRecord) -> text:
    val material = (descriptor.provider_id
        + "\n" + descriptor.abi_version.to_text()
        + "\n" + descriptor.adapter_source
        + "\n" + record.upstream_revision
        + "\n" + record.source_archive_sha256
        + "\n" + record.patch_set_sha256
        + "\n" + record.adapter_source_sha256
        + "\n" + record.build_recipe_version.to_text()
        + "\n" + record.toolchain_identity
        + "\n" + record.target_triple
        + "\n" + record.build_options)
    val digest = sha256_text(material)
    if digest.len() <= 32:
        return digest
    digest.substring(0, 32)

pub fn cache_dir_for(target_triple: text, digest: text) -> text:
    COUNTERPART_CACHE_ROOT + "/" + target_triple + "/" + digest

pub fn artifact_path_for(
    descriptor: ProviderDescriptor,
    target_triple: text,
    digest: text
) -> text:
    val fallback = "libsimple_counterpart_" + descriptor.provider_id
    val name = if descriptor.adapter_output == "": fallback else: descriptor.adapter_output
    cache_dir_for(target_triple, digest) + "/" + name + ".so"

pub fn manifest_path_for(target_triple: text, digest: text) -> text:
    cache_dir_for(target_triple, digest) + "/provider.manifest.sdn"

pub fn receipt_path_for(target_triple: text, digest: text) -> text:
    cache_dir_for(target_triple, digest) + "/build.receipt.sdn"

# Hashed as BYTES, never as text. `read_file` returns "" for a shared object,
# so a text hash would give every artifact the sha256 of the empty string —
# meaning every artifact would match every other one, and a swapped binary
# would verify clean. Measured on the mock adapter 2026-08-09.
pub fn artifact_sha256_of_file(path: text) -> text:
    if not file_exists(path):
        return ""
    val bytes = file_read_bytes(path)
    if bytes.len() == 0:
        return ""
    sha256_u8_hex(bytes)

# ---------------------------------------------------------------------------
# Resolution
# ---------------------------------------------------------------------------

fn unresolved(
    provider_id: text,
    status: ProviderStatus,
    verification: VerificationState,
    digest: text,
    cache_dir: text,
    artifact_path: text,
    reasons: [text]
) -> ResolvedProvider:
    ResolvedProvider(
        provider_id: provider_id,
        status: status,
        verification: verification,
        build_digest: digest,
        cache_dir: cache_dir,
        artifact_path: artifact_path,
        reasons: reasons
    )

# `observed_artifact_sha256` is the digest of the artifact actually present on
# disk; "" means no artifact. It is a parameter rather than a filesystem read so
# the negative paths are exercisable without staging a build tree — and so this
# function has no way to "helpfully" fall back to a hash it computed itself.
pub fn resolve_provider(
    descriptor: ProviderDescriptor,
    records: [LockRecord],
    observed_artifact_sha256: text
) -> ResolvedProvider:
    if val record = lock_record_for(records, descriptor.provider_id):
        return resolve_against_record(descriptor, record, observed_artifact_sha256)
    unresolved(
        descriptor.provider_id,
        ProviderStatus.unavailable,
        VerificationState.lock_missing,
        "",
        "",
        "",
        ["no lock record for provider '" + descriptor.provider_id
            + "': a provider absent from the lockfile is UNAVAILABLE, never PASS"]
    )

fn resolve_against_record(
    descriptor: ProviderDescriptor,
    record: LockRecord,
    observed_artifact_sha256: text
) -> ResolvedProvider:
    val digest = build_digest(descriptor, record)
    val cache_dir = cache_dir_for(record.target_triple, digest)
    val artifact_path = artifact_path_for(descriptor, record.target_triple, digest)

    # Contract rejections come first: a descriptor the frozen predicate refuses
    # is never hashed, so a matching hash can never launder a bad manifest.
    val contract_failures = descriptor_rejections(descriptor, record.artifact_sha256)
    if contract_failures.len() > 0:
        return unresolved(
            descriptor.provider_id,
            ProviderStatus.rejected_manifest,
            VerificationState.descriptor_rejected,
            digest,
            cache_dir,
            artifact_path,
            contract_failures
        )

    val lock_failures = lock_record_rejections(record)
    if lock_failures.len() > 0:
        return unresolved(
            descriptor.provider_id,
            ProviderStatus.rejected_manifest,
            VerificationState.descriptor_rejected,
            digest,
            cache_dir,
            artifact_path,
            lock_failures
        )

    if descriptor.license_spdx != record.license_spdx:
        return unresolved(
            descriptor.provider_id,
            ProviderStatus.rejected_manifest,
            VerificationState.descriptor_rejected,
            digest,
            cache_dir,
            artifact_path,
            ["license_spdx disagrees: descriptor '" + descriptor.license_spdx
                + "' vs lock '" + record.license_spdx + "'"]
        )

    if lock_record_has_placeholder(record):
        return unresolved(
            descriptor.provider_id,
            ProviderStatus.unavailable,
            VerificationState.unverified_placeholder,
            digest,
            cache_dir,
            artifact_path,
            ["lock record for '" + descriptor.provider_id + "' still carries the '"
                + COUNTERPART_PLACEHOLDER_HASH
                + "' placeholder: UNVERIFIED, which is not verified"]
        )

    if observed_artifact_sha256 == "":
        return unresolved(
            descriptor.provider_id,
            ProviderStatus.unavailable,
            VerificationState.artifact_missing,
            digest,
            cache_dir,
            artifact_path,
            ["no artifact at " + artifact_path + "; run `simple counterpart build`"]
        )

    if observed_artifact_sha256 != record.artifact_sha256:
        return unresolved(
            descriptor.provider_id,
            ProviderStatus.unavailable,
            VerificationState.hash_mismatch,
            digest,
            cache_dir,
            artifact_path,
            ["artifact_sha256 mismatch for '" + descriptor.provider_id
                + "': locked " + record.artifact_sha256
                + ", found " + observed_artifact_sha256]
        )

    unresolved(
        descriptor.provider_id,
        ProviderStatus.executed,
        VerificationState.verified,
        digest,
        cache_dir,
        artifact_path,
        []
    )

pub fn resolve_provider_from_disk(
    descriptor: ProviderDescriptor,
    records: [LockRecord]
) -> ResolvedProvider:
    if val record = lock_record_for(records, descriptor.provider_id):
        val digest = build_digest(descriptor, record)
        val path = artifact_path_for(descriptor, record.target_triple, digest)
        return resolve_provider(descriptor, records, artifact_sha256_of_file(path))
    resolve_provider(descriptor, records, "")

pub fn resolved_provider_summary(resolved: ResolvedProvider) -> text:
    (resolved.provider_id
        + " status=" + provider_status_name(resolved.status)
        + " verification=" + verification_state_name(resolved.verification)
        + " digest=" + resolved.build_digest)

# ---------------------------------------------------------------------------
# Fetch guard
# ---------------------------------------------------------------------------

# `fetch` is the only network phase in the whole framework. It refuses to run
# without an explicit pinned revision: "latest" is the exact input that would
# make a conformance run irreproducible.
pub fn fetch_rejections(record: LockRecord) -> [text]:
    var failures: [text] = []
    if record.upstream_revision == "":
        failures.push("fetch requires an explicit locked upstream_revision; none is pinned")
    if record.upstream_revision == "latest" or record.upstream_revision == "HEAD":
        failures.push("fetch refuses the floating revision '" + record.upstream_revision
            + "': pin an immutable revision in the lockfile")
    if record.upstream_url == "":
        failures.push("fetch requires an upstream_url")
    if hash_is_placeholder(record.source_archive_sha256) or record.source_archive_sha256 == "":
        failures.push("fetch requires a locked source_archive_sha256 to check the download against")
    failures

pub fn provider_needs_fetch(descriptor: ProviderDescriptor) -> bool:
    descriptor.upstream_kind != "none" and descriptor.upstream_kind != ""
