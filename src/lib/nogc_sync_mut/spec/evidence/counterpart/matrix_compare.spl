@allow(primitive_api)
# Counterpart Conformance — N-way comparison matrix engine (Wave 1, lane F6).
#
# primitive_api is allowed here deliberately: counts and gate predicates are the
# frozen Wave-0 wire types.
#
# Takes a CounterpartPlan plus the [SourceResult] its providers produced, and
# produces the full comparison matrix and a CounterpartRun. The run's
# `rejections` list is the verdict: a run is ACCEPTED only when it is empty.
#
# Enforced here, all fail-closed:
#
#   * plan rejections (counterpart_plan_rejections) are inherited verbatim
#   * a comparison naming a source with no result is a rejection, not a skip
#   * every source in `require_gpu_receipt_source_ids` must clear the GPU gate
#     (execution_receipt_gpu_gate_failures) — a GPU lane that fell back to CPU
#     fails even if its logical artifact matches perfectly
#   * providers sharing an `independence_group` are ONE reference, not two
#   * consensus never overrides a normative vector or a normative spec rule:
#     a failing comparison whose either side has authority rank >= that of
#     normative_spec_rule is an unconditional rejection, regardless of how many
#     differential peers agree with each other
#   * zero comparisons and every vacuity case in
#     counterpart_run_vacuity_failures fail
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §7, §8

use std.common.spec.evidence.counterpart.model.{
    CounterpartPlan,
    PlanComparison,
    SourceResult,
    ComparisonCell,
    CounterpartRun,
    OracleAuthority,
    ConversionLoss,
    ProviderStatus,
    oracle_authority_rank,
    oracle_authority_name,
    relation_name,
    provider_status_name,
    counterpart_plan_rejections,
    counterpart_run_vacuity_failures,
    execution_receipt_gpu_gate_failures
}
use std.nogc_sync_mut.spec.evidence.counterpart.relation_engine.{
    RelationInput,
    RelationFacts,
    evaluate_relation,
    relation_input,
    relation_input_with_tolerance,
    relation_input_with_facts,
    relation_is_counted
}

# Authority at or above this rank is normative and can never be outvoted.
pub val COUNTERPART_NORMATIVE_RANK: i64 = 4

# ---------------------------------------------------------------------------
# Source lookup
# ---------------------------------------------------------------------------

# Index lookup rather than `SourceResult?`: `if val` on an Option is a known
# miscompile surface (it reports Some even for nil under AOT), and this module
# is a gate — it must not fail open.
pub fn matrix_result_index(results: [SourceResult], source_id: text) -> i64:
    var index: i64 = 0
    while index < results.len():
        if results[index].source_id == source_id:
            return index
        index = index + 1
    0 - 1

pub fn matrix_has_result(results: [SourceResult], source_id: text) -> bool:
    for result in results:
        if result.source_id == source_id:
            return true
    false

fn source_is_executed(result: SourceResult) -> bool:
    match result.status:
        ProviderStatus.executed => true
        _ => false

pub fn matrix_authority_of(plan: CounterpartPlan, source_id: text) -> OracleAuthority:
    for source in plan.sources:
        if source.source_id == source_id:
            return source.authority
    OracleAuthority.diagnostic_only

# Independent references are counted by independence_group. Two wrappers over
# one upstream engine are one reference, however many providers they present as.
pub fn matrix_independent_group_count(results: [SourceResult]) -> i64:
    var groups: [text] = []
    for result in results:
        if source_is_executed(result) and result.independence_group != "":
            var seen = false
            for existing in groups:
                if existing == result.independence_group:
                    seen = true
            if not seen:
                groups.push(result.independence_group)
    groups.len()

# ---------------------------------------------------------------------------
# Cell construction
# ---------------------------------------------------------------------------

# Projection used when a plan comparison does not carry an explicit element
# sequence: the counted relations are exercised over the smaller item count and
# a canonical-hash disagreement is counted as a total failure of those cases.
# This is a stated projection, not a derived expected value.
fn projected_facts(left: SourceResult, right: SourceResult) -> RelationFacts:
    var executed = left.artifact.item_count
    if right.artifact.item_count < executed:
        executed = right.artifact.item_count
    if left.artifact.canonical_hash == right.artifact.canonical_hash:
        return RelationFacts(executed: executed, failed: 0)
    RelationFacts(executed: executed, failed: executed)

pub fn matrix_relation_input(
    comparison: PlanComparison,
    left: SourceResult,
    right: SourceResult,
    route_loss: ConversionLoss
) -> RelationInput:
    var base = relation_input(
        left.source_id,
        right.source_id,
        comparison.relation,
        route_loss,
        left.artifact,
        right.artifact
    )
    if comparison.tolerance != 0 or comparison.tolerance_reason != "":
        base = relation_input_with_tolerance(base, comparison.tolerance, comparison.tolerance_reason)
    if relation_is_counted(comparison.relation):
        base = relation_input_with_facts(base, projected_facts(left, right))
    base

fn unavailable_cell(comparison: PlanComparison, detail: text) -> ComparisonCell:
    ComparisonCell(
        left_source_id: comparison.left_source_id,
        right_source_id: comparison.right_source_id,
        relation: comparison.relation,
        matched: false,
        mismatch_count: 1,
        route_loss: ConversionLoss.diagnostic_only,
        detail: detail
    )

# Builds the full matrix. A comparison whose source did not execute produces a
# FAILING cell, never an absent one — a missing provider must never shrink the
# matrix into vacuous agreement.
pub fn matrix_build(plan: CounterpartPlan, results: [SourceResult]) -> [ComparisonCell]:
    var cells: [ComparisonCell] = []
    for comparison in plan.comparisons:
        val left_index = matrix_result_index(results, comparison.left_source_id)
        val right_index = matrix_result_index(results, comparison.right_source_id)
        if left_index < 0:
            cells.push(unavailable_cell(comparison,
                "no result for source " + comparison.left_source_id))
        else:
            if right_index < 0:
                cells.push(unavailable_cell(comparison,
                    "no result for source " + comparison.right_source_id))
            else:
                val left = results[left_index]
                val right = results[right_index]
                if not source_is_executed(left):
                    cells.push(unavailable_cell(comparison, "source "
                        + left.source_id + " status=" + provider_status_name(left.status)))
                else:
                    if not source_is_executed(right):
                        cells.push(unavailable_cell(comparison, "source "
                            + right.source_id + " status=" + provider_status_name(right.status)))
                    else:
                        val input = matrix_relation_input(comparison, left, right,
                            ConversionLoss.identity)
                        cells.push(evaluate_relation(input))
    cells

# ---------------------------------------------------------------------------
# Gates
# ---------------------------------------------------------------------------

# Design §8. Applied to EVERY source the plan lists in
# require_gpu_receipt_source_ids, including sources that produced no result.
pub fn matrix_gpu_gate_failures(plan: CounterpartPlan, results: [SourceResult]) -> [text]:
    var failures: [text] = []
    for source_id in plan.require_gpu_receipt_source_ids:
        val index = matrix_result_index(results, source_id)
        if index < 0:
            failures.push("GPU gate: source " + source_id + " produced no result")
        else:
            for reason in execution_receipt_gpu_gate_failures(results[index].execution):
                failures.push("GPU gate: source " + source_id + ": " + reason)
    failures

# Consensus is diagnostic. A disagreeing normative vector or spec rule is a
# rejection no matter how many peers agree with each other.
pub fn matrix_normative_failures(plan: CounterpartPlan, cells: [ComparisonCell]) -> [text]:
    var failures: [text] = []
    for cell in cells:
        if not cell.matched:
            val left_rank = oracle_authority_rank(matrix_authority_of(plan, cell.left_source_id))
            val right_rank = oracle_authority_rank(matrix_authority_of(plan, cell.right_source_id))
            var top = left_rank
            var top_id = cell.left_source_id
            if right_rank > top:
                top = right_rank
                top_id = cell.right_source_id
            if top >= COUNTERPART_NORMATIVE_RANK:
                failures.push("normative source " + top_id + " ("
                    + oracle_authority_name(matrix_authority_of(plan, top_id))
                    + ") disagrees under " + relation_name(cell.relation)
                    + ": " + cell.detail)
    failures

# Diagnostic only: how many differential-peer comparisons agreed. Exposed so a
# manual can report consensus, never so consensus can decide a verdict.
pub fn matrix_peer_consensus_matched(plan: CounterpartPlan, cells: [ComparisonCell]) -> bool:
    var peers: i64 = 0
    var agreed: i64 = 0
    for cell in cells:
        val left_rank = oracle_authority_rank(matrix_authority_of(plan, cell.left_source_id))
        val right_rank = oracle_authority_rank(matrix_authority_of(plan, cell.right_source_id))
        if left_rank < COUNTERPART_NORMATIVE_RANK and right_rank < COUNTERPART_NORMATIVE_RANK:
            peers = peers + 1
            if cell.matched:
                agreed = agreed + 1
    peers > 0 and agreed == peers

pub fn matrix_independence_failures(plan: CounterpartPlan, results: [SourceResult]) -> [text]:
    var failures: [text] = []
    val groups = matrix_independent_group_count(results)
    if groups < 2:
        failures.push("only " + groups.to_text()
            + " independent reference(s): sources sharing an independence_group"
            + " are not counted as independent")
    for result in results:
        if source_is_executed(result) and result.independence_group == "":
            failures.push("source " + result.source_id + " declares no independence_group")
    failures

pub fn matrix_comparison_failures(cells: [ComparisonCell]) -> [text]:
    var failures: [text] = []
    for cell in cells:
        if not cell.matched:
            failures.push("comparison " + cell.left_source_id + "/" + cell.right_source_id
                + " under " + relation_name(cell.relation) + " failed: " + cell.detail)
    failures

# ---------------------------------------------------------------------------
# The engine
# ---------------------------------------------------------------------------

pub fn evaluate_matrix(plan: CounterpartPlan, results: [SourceResult]) -> CounterpartRun:
    var rejections: [text] = []
    for reason in counterpart_plan_rejections(plan):
        rejections.push("plan: " + reason)

    for comparison in plan.comparisons:
        if not matrix_has_result(results, comparison.left_source_id):
            rejections.push("no result for planned source " + comparison.left_source_id)
        if not matrix_has_result(results, comparison.right_source_id):
            rejections.push("no result for planned source " + comparison.right_source_id)

    val cells = matrix_build(plan, results)
    if cells.len() == 0:
        rejections.push("zero comparisons were performed")

    var run = CounterpartRun(
        plan_id: plan.plan_id,
        boundary_id: plan.boundary_id,
        environment_profile: plan.environment_profile,
        sources: results,
        matrix: cells,
        rejections: []
    )

    for reason in counterpart_run_vacuity_failures(run):
        rejections.push("vacuity: " + reason)
    for reason in matrix_independence_failures(plan, results):
        rejections.push("independence: " + reason)
    for reason in matrix_gpu_gate_failures(plan, results):
        rejections.push(reason)
    for reason in matrix_normative_failures(plan, cells):
        rejections.push("normative: " + reason)
    for reason in matrix_comparison_failures(cells):
        rejections.push(reason)

    CounterpartRun(
        plan_id: plan.plan_id,
        boundary_id: plan.boundary_id,
        environment_profile: plan.environment_profile,
        sources: results,
        matrix: cells,
        rejections: rejections
    )

pub fn matrix_run_accepted(run: CounterpartRun) -> bool:
    run.rejections.len() == 0

pub fn matrix_run_rejection_count(run: CounterpartRun) -> i64:
    run.rejections.len()

pub fn matrix_run_has_rejection_containing(run: CounterpartRun, needle: text) -> bool:
    for reason in run.rejections:
        if reason.contains(needle):
            return true
    false
