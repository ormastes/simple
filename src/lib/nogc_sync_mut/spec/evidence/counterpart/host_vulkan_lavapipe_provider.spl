@allow(primitive_api)
# Host Vulkan / lavapipe Provider — SCCT counterpart transport for the HOST
# Vulkan renderer running against the software Vulkan ICD (Mesa lavapipe).
#
# Why this provider exists
# ------------------------
# The prior board-Vulkan effort proved SPIR-V validation via `spirv-val` but
# could never perform a real device submit + readback: no GPU, and no working
# QEMU GPU device model. The untried path was the HOST renderer against
# lavapipe (`/usr/share/vulkan/icd.d/lvp_icd.json`, `libvulkan_lvp.so`), which
# needs no GPU at all. This provider is that path, and it pins the ICD itself
# rather than inheriting whatever the ambient environment happens to select.
#
# ICD pinning is REAL and in-process
# ----------------------------------
# `env_set("VK_DRIVER_FILES", ...)` before `rt_vulkan_init()` genuinely
# reselects the driver: measured in-process on 2026-08-11, a bogus path yields
# `rt_vulkan_init() == false` / `rt_vulkan_device_count() == 0`, and the
# lavapipe path yields `true` / `1`. `rt_vulkan_shutdown()` between attempts is
# what makes the reselect take effect, because the loader reads the variable at
# instance-creation time. So the unavailable case below is a real measurement,
# not a simulated one.
#
# What is reachable today, and what is not
# ----------------------------------------
# Measured on the deployed seed binary
# (`bin/release/x86_64-unknown-linux-gnu/simple`, 59210792 bytes,
# 2026-08-11 05:18:56):
#
#   * REACHABLE: `rt_vulkan_init` -> true, `rt_vulkan_device_count` -> 1,
#     `rt_vulkan_select_device(0)` -> true, `rt_vulkan_get_device` -> a
#     positive handle, and `rt_vulkan_device_name(0)` ->
#     "llvmpipe (LLVM 20.1.2, 256 bits)". Simple's host Vulkan code really does
#     reach lavapipe.
#   * NOT REACHABLE: every graphics-resource entry point returns 0 / false with
#     an EMPTY `rt_vulkan_get_last_error()` —
#     `rt_vulkan_create_offscreen_render_pass`, `rt_vulkan_create_image`,
#     `rt_vulkan_create_framebuffer`, `rt_vulkan_begin_graphics`. The cause is
#     not a lavapipe limitation and not a missing symbol: the seed was built
#     WITHOUT the runtime `vulkan` cargo feature, so the
#     `#[cfg(not(feature = "vulkan"))]` sibling bodies in
#     `src/compiler_rust/runtime/src/vulkan_graphics_runtime_graphics.rs`
#     (e.g. `rt_vulkan_create_image` at :585) are what is linked, and they
#     return 0 while ignoring their arguments. The device-enumeration half
#     survives because it is served by the `ash`-based handlers in
#     `src/compiler_rust/compiler/src/interpreter_extern/gpu.rs`, which are not
#     gated the same way.
#
# Consequence: a pixel-level clear+readback comparison is NOT constructible on
# this binary. This provider therefore reports
# `ProviderStatus.unavailable` at the exact stage that failed, ALWAYS carrying
# the real device name it did obtain, and never a fabricated pixel or a
# placeholder digest. When a `vulkan`-feature build is deployed, the very same
# code path proceeds to the clear + readback and the comparison becomes live
# with no edit to this file.
#
# Fail-closed, always:
#   * env_set refused                       -> unavailable
#   * init false / device_count 0           -> unavailable (bogus or absent ICD)
#   * empty device name                     -> unavailable (never the text "0")
#   * any graphics handle <= 0              -> unavailable, stage named
#   * readback that returns the wrong length-> unavailable
#   * NEVER a synthesized pixel buffer, NEVER a literal device string
#
# Bug record: doc/08_tracking/bug/host_vulkan_lavapipe_graphics_entry_points_stubbed_without_vulkan_feature_2026-08-11.md
#
# TODO(hw-gated): deploy a seed built with --features vulkan so the 84 stubbed
# rt_vulkan_* graphics entry points stop returning 0 and this provider's
# render+readback path can execute for real — no hardware required, this is a
# build-config gap. See the bug record above.

use std.env.variables.{env_set}
use std.nogc_sync_mut.io.vulkan_sffi.{
    rt_vulkan_init,
    rt_vulkan_shutdown,
    rt_vulkan_device_count,
    rt_vulkan_select_device,
    rt_vulkan_get_device,
    rt_vulkan_create_offscreen_render_pass,
    rt_vulkan_destroy_render_pass,
    rt_vulkan_create_image,
    rt_vulkan_destroy_image,
    rt_vulkan_create_framebuffer,
    rt_vulkan_destroy_framebuffer,
    rt_vulkan_begin_graphics,
    rt_vulkan_end_graphics,
    rt_vulkan_begin_render_pass_gfx,
    rt_vulkan_end_render_pass_gfx,
    rt_vulkan_set_viewport,
    rt_vulkan_set_scissor,
    rt_vulkan_submit_graphics_and_wait_fence,
    rt_vulkan_wait_fence,
    rt_vulkan_destroy_fence,
    rt_vulkan_copy_from_image,
    rt_vulkan_get_last_error
}
use std.gpu.engine2d.sffi_vulkan.{vulkan_sffi_device_name}
use std.common.spec.evidence.counterpart.model.{
    ProviderStatus,
    CounterpartRelation,
    LogicalArtifact,
    ExecutionReceipt,
    ExecutionMode,
    ProvenanceReceipt
}

# Format / usage constants, taken from src/lib/common/ui/draw_ir_v3_backend_enums.spl
# (DRAW_IR_FORMAT_R8G8B8A8_UNORM = 37, DRAW_IR_FORMAT_D32_SFLOAT = 126,
#  RT_VULKAN_IMAGE_USAGE_SAMPLED = 0x01, _COLOR_ATTACHMENT = 0x04,
#  _DEPTH_STENCIL_ATTACHMENT = 0x08, _TRANSFER_SRC = 0x10).
pub val HOST_VK_FORMAT_R8G8B8A8_UNORM: i64 = 37
pub val HOST_VK_FORMAT_D32_SFLOAT: i64 = 126
pub val HOST_VK_USAGE_COLOR_TARGET: i64 = 0x04 | 0x10 | 0x01
pub val HOST_VK_USAGE_DEPTH_TARGET: i64 = 0x08

pub val LAVAPIPE_ICD_PATH: text = "/usr/share/vulkan/icd.d/lvp_icd.json"

# ============================================================================
# Outcome
# ============================================================================

pub struct HostVulkanClearOutcome:
    provider_id: text
    status: ProviderStatus
    detail: text
    # The REAL device name reported by the driver that was actually selected.
    # Empty whenever no device could be selected — never a literal.
    device_name: text
    device_handle_valid: bool
    # Requested clear color, as whole RGBA8 channel values.
    requested_rgba: (i64, i64, i64, i64)
    readback_bytes: i64
    pixels_uniform: bool
    observed_rgba: (i64, i64, i64, i64)
    matched: bool
    relation: CounterpartRelation
    artifact: LogicalArtifact
    execution: ExecutionReceipt
    provenance: ProvenanceReceipt

fn host_vk_provider_id(icd_path: text) -> text:
    "host-vulkan-clear:" + icd_path

fn empty_artifact() -> LogicalArtifact:
    LogicalArtifact(
        boundary_id: "",
        schema_id: "",
        schema_version: -1,
        item_count: 0,
        canonical_hash: "",
        artifact_ref: ""
    )

fn receipt(provider_id: text, device_name: text, submitted: i64, fenced: bool, readback: bool, completed: bool) -> ExecutionReceipt:
    ExecutionReceipt(
        provider_id: provider_id,
        execution_mode: ExecutionMode.cpu_reference,
        device_identity: device_name,
        queue_identity: "",
        submission_count: submitted,
        fence_completed: fenced,
        device_origin_readback: readback,
        fallback_used: false,
        dropped_events: 0,
        completed: completed
    )

fn provenance_for(icd_path: text, device_name: text, provider_id: text) -> ProvenanceReceipt:
    ProvenanceReceipt(
        package_manifest_hash: "",
        provider_manifest_hash: "",
        input_hash: "",
        converter_route_hash: "",
        environment_profile: icd_path + "|" + device_name,
        run_id: provider_id
    )

fn outcome_unavailable(
    icd_path: text,
    detail: text,
    device_name: text,
    requested: (i64, i64, i64, i64)
) -> HostVulkanClearOutcome:
    val provider_id = host_vk_provider_id(icd_path)
    HostVulkanClearOutcome(
        provider_id: provider_id,
        status: ProviderStatus.unavailable,
        detail: detail,
        device_name: device_name,
        device_handle_valid: false,
        requested_rgba: requested,
        readback_bytes: 0,
        pixels_uniform: false,
        observed_rgba: (-1, -1, -1, -1),
        matched: false,
        relation: CounterpartRelation.image_exact,
        artifact: empty_artifact(),
        execution: receipt(provider_id, device_name, 0, false, false, false),
        provenance: provenance_for(icd_path, device_name, provider_id)
    )

# ============================================================================
# The real attempt
# ============================================================================

# Pin `icd_path` as the Vulkan ICD, create a `width` x `height` RGBA8 offscreen
# color target, clear it to the requested whole-byte RGBA value, submit, and
# read the pixels back off the device.
#
# `r`/`g`/`b`/`a` are whole RGBA8 channel values in 0..255. They are handed to
# the driver as `channel / 255.0`, which is exactly representable as a UNORM
# quantum, so a correct pure clear must read back byte-identical — this is what
# justifies `CounterpartRelation.image_exact` rather than a tolerance: a clear
# performs no filtering, no blending, and no gamma conversion, so there is no
# lossy stage for a tolerance to absorb.
pub fn host_vulkan_clear_readback(
    icd_path: text,
    width: i64,
    height: i64,
    r: i64,
    g: i64,
    b: i64,
    a: i64
) -> HostVulkanClearOutcome:
    val requested = (r, g, b, a)
    val provider_id = host_vk_provider_id(icd_path)

    # Release any instance an earlier attempt in this process created, so the
    # loader re-reads VK_DRIVER_FILES at the next instance creation.
    rt_vulkan_shutdown()
    if not env_set("VK_DRIVER_FILES", icd_path):
        return outcome_unavailable(icd_path, "could not pin VK_DRIVER_FILES to " + icd_path, "", requested)

    if not rt_vulkan_init():
        return outcome_unavailable(icd_path, "vulkan init failed for ICD " + icd_path, "", requested)
    if rt_vulkan_device_count() <= 0:
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "no vulkan device enumerated for ICD " + icd_path, "", requested)
    if not rt_vulkan_select_device(0):
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "device 0 could not be selected", "", requested)

    val device_name = vulkan_sffi_device_name(0)
    if device_name == "" or device_name == "0":
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "driver reported no usable device name", "", requested)

    val dev = rt_vulkan_get_device()
    if dev <= 0:
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "device handle not positive", device_name, requested)

    val render_pass = rt_vulkan_create_offscreen_render_pass(dev, HOST_VK_FORMAT_R8G8B8A8_UNORM, HOST_VK_FORMAT_D32_SFLOAT)
    if render_pass <= 0:
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "graphics unavailable: offscreen render pass creation returned " + render_pass.to_text() + " (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)

    val color = rt_vulkan_create_image(dev, width, height, HOST_VK_FORMAT_R8G8B8A8_UNORM, HOST_VK_USAGE_COLOR_TARGET)
    if color <= 0:
        rt_vulkan_destroy_render_pass(render_pass)
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "graphics unavailable: color image creation returned " + color.to_text() + " (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)

    val depth = rt_vulkan_create_image(dev, width, height, HOST_VK_FORMAT_D32_SFLOAT, HOST_VK_USAGE_DEPTH_TARGET)
    val framebuffer = rt_vulkan_create_framebuffer(dev, render_pass, color, depth, width, height)
    if framebuffer <= 0:
        rt_vulkan_destroy_image(color)
        rt_vulkan_destroy_render_pass(render_pass)
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "graphics unavailable: framebuffer creation returned " + framebuffer.to_text() + " (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)

    val cmd = rt_vulkan_begin_graphics()
    if cmd <= 0:
        rt_vulkan_destroy_framebuffer(framebuffer)
        rt_vulkan_destroy_image(color)
        rt_vulkan_destroy_render_pass(render_pass)
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "graphics unavailable: begin_graphics returned " + cmd.to_text() + " (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)

    var recorded = rt_vulkan_begin_render_pass_gfx(
        cmd, render_pass, framebuffer,
        r.to_f64() / 255.0, g.to_f64() / 255.0, b.to_f64() / 255.0, a.to_f64() / 255.0
    )
    recorded = recorded and rt_vulkan_set_viewport(cmd, 0.0, 0.0, width.to_f64(), height.to_f64())
    recorded = recorded and rt_vulkan_set_scissor(cmd, 0, 0, width, height)
    recorded = recorded and rt_vulkan_end_render_pass_gfx(cmd)
    recorded = recorded and rt_vulkan_end_graphics(cmd)
    if not recorded:
        rt_vulkan_destroy_framebuffer(framebuffer)
        rt_vulkan_destroy_image(color)
        rt_vulkan_destroy_render_pass(render_pass)
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "graphics unavailable: clear command recording refused (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)

    val fence = rt_vulkan_submit_graphics_and_wait_fence(cmd)
    if fence <= 0:
        rt_vulkan_destroy_framebuffer(framebuffer)
        rt_vulkan_destroy_image(color)
        rt_vulkan_destroy_render_pass(render_pass)
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "graphics unavailable: fenced submit returned " + fence.to_text() + " (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)
    val fence_ok = rt_vulkan_wait_fence(fence, 1000000000)
    rt_vulkan_destroy_fence(fence)
    if not fence_ok:
        rt_vulkan_destroy_framebuffer(framebuffer)
        rt_vulkan_destroy_image(color)
        rt_vulkan_destroy_render_pass(render_pass)
        rt_vulkan_shutdown()
        return outcome_unavailable(icd_path, "submit did not complete within 1s", device_name, requested)

    val byte_count = width * height * 4
    var pixels: [u8] = []
    var i: i64 = 0
    while i < byte_count:
        pixels.push(0u8)
        i = i + 1
    val read_ok = rt_vulkan_copy_from_image(pixels, color)

    rt_vulkan_destroy_framebuffer(framebuffer)
    rt_vulkan_destroy_image(color)
    rt_vulkan_destroy_render_pass(render_pass)
    rt_vulkan_shutdown()

    if not read_ok:
        return outcome_unavailable(icd_path, "device readback refused (last_error=[" + rt_vulkan_get_last_error() + "])", device_name, requested)
    if pixels.len() != byte_count:
        return outcome_unavailable(icd_path, "readback produced " + pixels.len().to_text() + " bytes, expected " + byte_count.to_text(), device_name, requested)

    # Every pixel of a pure clear must equal the requested value exactly.
    var uniform = true
    var all_match = true
    var j: i64 = 0
    while j < byte_count:
        val expected = match j % 4:
            0 => r
            1 => g
            2 => b
            _ => a
        if pixels[j].to_i64() != expected:
            all_match = false
        if pixels[j].to_i64() != pixels[j % 4].to_i64():
            uniform = false
        j = j + 1

    val observed = (pixels[0].to_i64(), pixels[1].to_i64(), pixels[2].to_i64(), pixels[3].to_i64())
    val detail = if all_match:
        "every pixel equals the requested clear color"
    else:
        "pixel MISMATCH: requested (" + r.to_text() + "," + g.to_text() + "," + b.to_text() + "," + a.to_text() + ") observed (" + observed.0.to_text() + "," + observed.1.to_text() + "," + observed.2.to_text() + "," + observed.3.to_text() + ")"

    HostVulkanClearOutcome(
        provider_id: provider_id,
        status: ProviderStatus.executed,
        detail: detail,
        device_name: device_name,
        device_handle_valid: true,
        requested_rgba: requested,
        readback_bytes: pixels.len(),
        pixels_uniform: uniform,
        observed_rgba: observed,
        matched: all_match,
        relation: CounterpartRelation.image_exact,
        artifact: LogicalArtifact(
            boundary_id: "infra.counterpart.host_vulkan_clear@1",
            schema_id: "host_vulkan_clear_rgba8_v1",
            schema_version: 1,
            item_count: byte_count,
            canonical_hash: observed.0.to_text() + ":" + observed.1.to_text() + ":" + observed.2.to_text() + ":" + observed.3.to_text(),
            artifact_ref: provider_id
        ),
        execution: receipt(provider_id, device_name, 1, true, true, true),
        provenance: provenance_for(icd_path, device_name, provider_id)
    )

# Device-reachability probe that does NOT need the graphics half of the
# runtime: pins the ICD, initialises, and returns the REAL device name (empty
# when no device could be reached).
pub fn host_vulkan_probe_device_name(icd_path: text) -> text:
    rt_vulkan_shutdown()
    if not env_set("VK_DRIVER_FILES", icd_path):
        return ""
    if not rt_vulkan_init():
        return ""
    if rt_vulkan_device_count() <= 0 or not rt_vulkan_select_device(0):
        rt_vulkan_shutdown()
        return ""
    val name = vulkan_sffi_device_name(0)
    rt_vulkan_shutdown()
    name

export HostVulkanClearOutcome
export host_vulkan_clear_readback, host_vulkan_probe_device_name
export LAVAPIPE_ICD_PATH
