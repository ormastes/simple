@allow(primitive_api)
# Counterpart Conformance — compression lane (Wave 2 P2 "DEFLATE provider",
# Wave 5 Z1 partial; lane C4).
#
# primitive_api is allowed here deliberately: exit codes, byte counts and
# executed/failed tallies are the frozen Wave-0 wire types this descriptor
# forwards verbatim.
#
# A descriptor, not a central-registry edit (per "Agent execution rules" #9 in
# doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md).
#
# THE CENTRAL INSIGHT: compressed BYTES are not comparable between two correct
# DEFLATE/gzip encoders — compression level, strategy and match choices differ
# legitimately. `byte_exact` on compressed output would therefore produce false
# failures and is never used here. The two relations this descriptor proves
# are the ones that are actually true properties of a correct codec:
#
#   * `cross_decode` — one implementation compresses, the OTHER decompresses,
#     and the recovered bytes equal the original input, in BOTH directions.
#   * `round_trip`   — Simple compresses then decompresses its own output and
#     recovers the input exactly.
#
# Candidate: Simple's own pure-Simple gzip codec
# (src/lib/nogc_sync_mut/compression/gzip/compress.spl: gzip_compress /
# gzip_decompress), independence_group "simple-gzip-native".
# Counterpart: the real system `gzip` CLI (independence_group
# "gzip-cli-process"), invoked as a process bridge via `process_run_bounded`.
# Payload bytes NEVER cross the process boundary as `text` — `text` in Simple
# is UTF-8-constrained (see base64_decode's documented UTF-8-lossy fallback,
# `src/lib/common/base_encoding/base64.spl:230-282`), so an arbitrary
# compressed byte stream piped through a `text` stdout/base64 hop would
# silently corrupt. Instead only file PATHS (plain ASCII) cross the `text`
# boundary; payload bytes move exclusively through `[u8]` and disk via
# `File.read_bytes`/`File.write_bytes`.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §7
# Plan:   doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md (Wave 2 P2, Wave 5 Z1)

use std.common.spec.evidence.counterpart.model.{
    LogicalArtifact,
    logical_artifact
}
use std.nogc_sync_mut.spec.evidence.counterpart.relation_engine.{
    RelationFacts,
    relation_facts
}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.compression.gzip.compress.{gzip_compress, gzip_decompress}
# Direct runtime file primitives. Module-qualified `fs.exists(path)` calls and
# `File.write_bytes`/`File.read_bytes` static-method calls both hit the
# interpreter's cross-module NAME resolution landmines (arity clash with the
# 0-argument `Path.exists()` methods; a colliding `File` class without the
# byte methods), so the externs are declared here the same way
# artifact_store.spl does.
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_write_bytes(path: text, data: [u8]) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]?

pub val COMPRESS_GZIP_BOUNDARY: text = "compress.codec.gzip@1"
pub val COMPRESS_GZIP_SCHEMA_ID: text = "compress.gzip.bytes"
pub val COMPRESS_GZIP_SCHEMA_VERSION: i64 = 1

# Pinned real-binary default. Tests override this to a bogus path to prove the
# unavailable path (never treated as an ordinary crash or false pass).
pub val GZIP_DEFAULT_PATH: text = "/usr/bin/gzip"

pub fn gzip_binary_available(gzip_path: text) -> bool:
    gzip_path != "" and rt_file_exists(gzip_path)

pub fn compress_gzip_artifact(item_count: i64, label: text) -> LogicalArtifact:
    logical_artifact(
        COMPRESS_GZIP_BOUNDARY,
        COMPRESS_GZIP_SCHEMA_ID,
        COMPRESS_GZIP_SCHEMA_VERSION,
        item_count,
        "compress-gzip-" + label,
        label
    )

# ---------------------------------------------------------------------------
# Byte-safe file round trip helpers
# ---------------------------------------------------------------------------

pub fn write_bytes_or_fail(path: text, data: [u8]) -> bool:
    rt_file_write_bytes(path, data)

pub fn read_bytes_or_empty(path: text) -> [u8]:
    match rt_file_read_bytes(path):
        None: []
        Some(data): data

# Decode with an explicit ok flag. Comparing the optional result against nil
# across a module boundary is unreliable under the interpreter (None passes a
# `!= nil` guard and then faults inside `bytes_equal`), so the Option is
# consumed HERE by pattern match and never crosses a comparison.
pub fn gzip_decode_checked(data: [u8]) -> ([u8], bool):
    match gzip_decompress(data):
        None: ([], false)
        Some(decoded): (decoded, true)

pub fn bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

fn shell_single_quote(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

# ---------------------------------------------------------------------------
# Real process-bridge invocations of the system `gzip` CLI. Redirection is
# needed (`>`), so the shell is the subprocess, not `gzip` directly.
# ---------------------------------------------------------------------------

pub fn counterpart_gzip_compress_file(
    gzip_path: text, in_path: text, out_path: text, level: i64, timeout_ms: i64
) -> i64:
    val shell_cmd = shell_single_quote(gzip_path) + " -" + level.to_text() + " -c "
        + shell_single_quote(in_path) + " > " + shell_single_quote(out_path)
    val (_stdout, _stderr, exit_code) = process_run_bounded(
        "/bin/sh", ["-c", shell_cmd], timeout_ms, 8388608)
    exit_code

pub fn counterpart_gzip_decompress_file(
    gzip_path: text, in_path: text, out_path: text, timeout_ms: i64
) -> i64:
    val shell_cmd = shell_single_quote(gzip_path) + " -d -c "
        + shell_single_quote(in_path) + " > " + shell_single_quote(out_path)
    val (_stdout, _stderr, exit_code) = process_run_bounded(
        "/bin/sh", ["-c", shell_cmd], timeout_ms, 8388608)
    exit_code

# ---------------------------------------------------------------------------
# Counted-relation evaluation (design §7: cross_decode / round_trip stay in
# the relation engine and are projected as counted facts, never expanding the
# OracleMode enum).
# ---------------------------------------------------------------------------

# Direction A: Simple compresses, the real gzip CLI decompresses.
pub fn cross_decode_candidate_to_counterpart(
    gzip_path: text, cases: [[u8]], tmp_dir: text, timeout_ms: i64
) -> RelationFacts:
    var executed: i64 = 0
    var failed: i64 = 0
    var index: i64 = 0
    for item in cases:
        val compressed = gzip_compress(item, 6)
        val in_path = tmp_dir + "/a2c_in_" + index.to_text() + ".gz"
        val out_path = tmp_dir + "/a2c_out_" + index.to_text() + ".bin"
        val wrote = write_bytes_or_fail(in_path, compressed)
        executed = executed + 1
        if not wrote:
            failed = failed + 1
        else:
            val exit_code = counterpart_gzip_decompress_file(gzip_path, in_path, out_path, timeout_ms)
            val decoded = read_bytes_or_empty(out_path)
            if exit_code != 0 or not bytes_equal(decoded, item):
                failed = failed + 1
        index = index + 1
    relation_facts(executed, failed)

# Direction B: the real gzip CLI compresses, Simple decompresses.
pub fn cross_decode_counterpart_to_candidate(
    gzip_path: text, cases: [[u8]], tmp_dir: text, timeout_ms: i64
) -> RelationFacts:
    var executed: i64 = 0
    var failed: i64 = 0
    var index: i64 = 0
    for item in cases:
        val in_path = tmp_dir + "/c2a_in_" + index.to_text() + ".bin"
        val out_path = tmp_dir + "/c2a_out_" + index.to_text() + ".gz"
        val wrote = write_bytes_or_fail(in_path, item)
        executed = executed + 1
        if not wrote:
            failed = failed + 1
        else:
            val exit_code = counterpart_gzip_compress_file(gzip_path, in_path, out_path, 6, timeout_ms)
            val compressed = read_bytes_or_empty(out_path)
            val (decoded, decode_ok) = gzip_decode_checked(compressed)
            if exit_code != 0 or not decode_ok or not bytes_equal(decoded, item):
                failed = failed + 1
        index = index + 1
    relation_facts(executed, failed)

# Simple compresses then decompresses its own output.
pub fn round_trip_candidate(cases: [[u8]]) -> RelationFacts:
    var executed: i64 = 0
    var failed: i64 = 0
    for item in cases:
        val compressed = gzip_compress(item, 6)
        val (decoded, decode_ok) = gzip_decode_checked(compressed)
        executed = executed + 1
        if not decode_ok or not bytes_equal(decoded, item):
            failed = failed + 1
    relation_facts(executed, failed)

# ---------------------------------------------------------------------------
# Hostile test vectors
# ---------------------------------------------------------------------------

pub fn case_empty() -> [u8]:
    var data: [u8] = []
    data

pub fn case_single_byte() -> [u8]:
    var data: [u8] = []
    data.push(65.to_u8())
    data

pub fn case_repetitive(count: i64) -> [u8]:
    var data: [u8] = []
    var i: i64 = 0
    while i < count:
        data.push(65.to_u8())
        i = i + 1
    data

# Deterministic LCG so the "incompressible-ish" case is reproducible across
# runs without depending on a real RNG.
pub fn case_pseudo_random(count: i64) -> [u8]:
    var data: [u8] = []
    var state: i64 = 88172645463325252
    var i: i64 = 0
    while i < count:
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        var byte_val = state
        if byte_val < 0:
            byte_val = 0 - byte_val
        data.push((byte_val % 256).to_u8())
        i = i + 1
    data

pub fn case_mixed_text(target_len: i64) -> [u8]:
    val phrase = "The quick brown fox jumps over the lazy dog 0123456789! "
    var data: [u8] = []
    var i: i64 = 0
    while data.len() < target_len:
        val ch = phrase.char_at(i % phrase.len())
        data.push(ch.char_code_at(0).to_u8())
        i = i + 1
    data

pub fn default_test_cases() -> [[u8]]:
    [
        case_empty(),
        case_single_byte(),
        case_repetitive(4000),
        case_mixed_text(1200),
        case_pseudo_random(1500)
    ]

# Flip one byte so a corrupted stream can be fed back to a decoder; the
# decoder must REJECT it (nonzero exit / nil), never silently produce a
# truncated or wrong-but-successful result.
pub fn flip_byte(data: [u8], index: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < data.len():
        if i == index:
            out.push((data[i] ^ 255.to_u8()))
        else:
            out.push(data[i])
        i = i + 1
    out
