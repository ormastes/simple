@allow(primitive_api)
# Counterpart Conformance — provider runner (Wave 1, lane F4).
#
# primitive_api is allowed here deliberately: counts and status projections are
# the frozen Wave-0 wire types.
#
# This is the body of `CounterpartEvidenceProvider` (design §13). It renders NO
# Markdown and computes no verdict of its own: it executes every PlanSource
# through the uniform provider interface, assembles the [SourceResult] bundle
# (artifact + execution receipt + provenance receipt + conversion receipts +
# diagnostics), and hands the bundle to the N-way engine in `matrix_compare`,
# whose `rejections` list is the verdict.
#
# The one rule that shapes everything here: a source that could not run still
# produces a SourceResult, with a non-executed status and a vacuous artifact. It
# is never dropped. Dropping it would shrink the comparison matrix, and a
# smaller matrix of agreeing sources reads as a pass.
#
# Transport dispatch is by ProviderKind:
#
#   native_in_process        -> native_provider (BLOCKED on the ABI shim, see
#                               that module's header)
#   process_bridge           -> process_provider
#   native_isolated_worker   |
#   qemu_guest_bridge        |  not implemented in Wave 1: `unavailable` with a
#   remote_bridge            |  named diagnostic, never a silent pass
#
# Stub inputs: a `StubbedResponse` short-circuits the transport with a response
# envelope declared by the caller. They exist so the registry/runner/matrix path
# is verifiable before any adapter is linked. Every stubbed source records
# `stubbed: ...` in its diagnostics, so a stubbed run cannot be mistaken for a
# real provider execution, and the stub is parsed through exactly the same
# envelope reader the real transports use.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §13
# Contracts: src/lib/common/spec/evidence/counterpart/model.spl (frozen, do not edit)

use std.common.spec.evidence.counterpart.model.{
    ConversionReceipt,
    CounterpartPlan,
    CounterpartRun,
    ExecutionMode,
    ExecutionReceipt,
    PlanSource,
    ProvenanceReceipt,
    ProviderKind,
    ProviderStatus,
    SourceResult,
    provider_kind_name,
    provider_status_name
}
use std.nogc_sync_mut.spec.evidence.counterpart.provider_registry.{
    ProviderRegistry,
    ProviderSelection,
    ProviderOutcome,
    counterpart_response_artifact,
    provider_empty_artifact,
    provider_outcome_failed,
    provider_registry_select,
    provider_selection_label
}
use std.nogc_sync_mut.spec.evidence.counterpart.native_provider.{
    native_provider_execute
}
use std.nogc_sync_mut.spec.evidence.counterpart.process_provider.{
    ProcessInvocation,
    process_invocation,
    process_provider_execute
}
# Wildcard: a brace-list import of `evaluate_matrix` alone loads only that
# symbol, and the engine's own internal helpers (`matrix_build`, the gate
# functions) then fail to resolve when the runner is reached through the
# interpreter — "semantic: function `matrix_build` not found".
use std.nogc_sync_mut.spec.evidence.counterpart.matrix_compare.*

# ---------------------------------------------------------------------------
# Runner context
# ---------------------------------------------------------------------------

# A caller-declared response envelope standing in for one component. See the
# module header: this is an explicit, recorded stand-in, not a fake ABI.
pub struct StubbedResponse:
    provider_id: text
    component_id: text
    response: text
    status: ProviderStatus

pub fn stubbed_response(
    provider_id: text,
    component_id: text,
    response: text
) -> StubbedResponse:
    StubbedResponse(
        provider_id: provider_id,
        component_id: component_id,
        response: response,
        status: ProviderStatus.executed
    )

pub fn stubbed_failure(
    provider_id: text,
    component_id: text,
    status: ProviderStatus
) -> StubbedResponse:
    StubbedResponse(
        provider_id: provider_id,
        component_id: component_id,
        response: "",
        status: status
    )

pub struct RunnerContext:
    registry: ProviderRegistry
    run_id: text
    package_manifest_hash: text
    request: text
    invocation: ProcessInvocation
    stubs: [StubbedResponse]

pub fn runner_context(
    registry: ProviderRegistry,
    run_id: text,
    package_manifest_hash: text,
    request: text
) -> RunnerContext:
    RunnerContext(
        registry: registry,
        run_id: run_id,
        package_manifest_hash: package_manifest_hash,
        request: request,
        invocation: process_invocation([]),
        stubs: []
    )

pub fn runner_with_stub(context: RunnerContext, stub: StubbedResponse) -> RunnerContext:
    var stubs = context.stubs
    stubs.push(stub)
    RunnerContext(
        registry: context.registry,
        run_id: context.run_id,
        package_manifest_hash: context.package_manifest_hash,
        request: context.request,
        invocation: context.invocation,
        stubs: stubs
    )

pub fn runner_with_invocation(
    context: RunnerContext,
    invocation: ProcessInvocation
) -> RunnerContext:
    RunnerContext(
        registry: context.registry,
        run_id: context.run_id,
        package_manifest_hash: context.package_manifest_hash,
        request: context.request,
        invocation: invocation,
        stubs: context.stubs
    )

# Index lookup rather than an Option: `if val` on an Option is a known
# miscompile surface, and this is a gate.
pub fn runner_stub_index(
    context: RunnerContext,
    provider_id: text,
    component_id: text
) -> i64:
    var index: i64 = 0
    while index < context.stubs.len():
        val stub = context.stubs[index]
        if stub.provider_id == provider_id and stub.component_id == component_id:
            return index
        index = index + 1
    0 - 1

# ---------------------------------------------------------------------------
# Transport dispatch
# ---------------------------------------------------------------------------

fn stub_outcome(stub: StubbedResponse, selection: ProviderSelection) -> ProviderOutcome:
    match stub.status:
        ProviderStatus.executed =>
            ProviderOutcome(
                status: ProviderStatus.executed,
                artifact: counterpart_response_artifact(
                    stub.response, selection.counterpart_boundary_id),
                execution: ExecutionReceipt(
                    provider_id: selection.provider_id,
                    execution_mode: ExecutionMode.cpu_reference,
                    device_identity: "declared-stub",
                    queue_identity: "",
                    submission_count: 0,
                    fence_completed: false,
                    device_origin_readback: false,
                    fallback_used: false,
                    dropped_events: 0,
                    completed: true
                ),
                raw_response: stub.response,
                raw_stderr: "",
                exit_code: 0,
                diagnostics: ["stubbed: declared response, no adapter was invoked"]
            )
        _ =>
            provider_outcome_failed(selection.provider_id, stub.status,
                "stubbed: declared status " + provider_status_name(stub.status),
                "", 0 - 1)

# The uniform interface over all provider kinds.
pub fn runner_invoke(context: RunnerContext, selection: ProviderSelection) -> ProviderOutcome:
    if not selection.resolved:
        var detail = "source " + selection.source_id + ": provider '"
            + selection.provider_id + "' could not be selected"
        for reason in selection.diagnostics:
            detail = detail + "; " + reason
        return provider_outcome_failed(selection.provider_id,
            selection.unresolved_status, detail, "", 0 - 1)

    val stub_index = runner_stub_index(context, selection.provider_id, selection.component_id)
    if stub_index >= 0:
        return stub_outcome(context.stubs[stub_index], selection)

    match selection.provider_kind:
        ProviderKind.native_in_process =>
            native_provider_execute(selection, context.request)
        ProviderKind.process_bridge =>
            process_provider_execute(selection, context.invocation, context.request)
        _ =>
            provider_outcome_failed(selection.provider_id, ProviderStatus.unavailable,
                "provider kind " + provider_kind_name(selection.provider_kind)
                    + " has no Wave-1 transport: " + provider_selection_label(selection),
                "", 0 - 1)

# ---------------------------------------------------------------------------
# Source execution
# ---------------------------------------------------------------------------

fn runner_provenance(
    context: RunnerContext,
    plan: CounterpartPlan,
    selection: ProviderSelection
) -> ProvenanceReceipt:
    ProvenanceReceipt(
        package_manifest_hash: context.package_manifest_hash,
        provider_manifest_hash: selection.artifact_hash,
        input_hash: plan.input_ref,
        # Wave 1 executes no conversions, so the route is the identity route.
        # It is named rather than left empty: an empty route hash is a missing
        # receipt, and `provenance_receipt_is_complete` must be able to tell
        # "identity" from "not recorded".
        converter_route_hash: "identity",
        environment_profile: plan.environment_profile,
        run_id: context.run_id
    )

# Execute one planned source. Always returns a SourceResult — including for a
# source that could not be selected at all.
pub fn runner_execute_source(
    context: RunnerContext,
    plan: CounterpartPlan,
    source: PlanSource
) -> SourceResult:
    val selection = provider_registry_select(context.registry, source, plan.boundary_id)
    val outcome = runner_invoke(context, selection)

    var diagnostics: [text] = []
    for reason in selection.diagnostics:
        diagnostics.push(reason)
    for reason in outcome.diagnostics:
        diagnostics.push(reason)
    if source.required:
        match outcome.status:
            ProviderStatus.executed => diagnostics.push("required source executed")
            _ => diagnostics.push("REQUIRED source " + source.source_id
                + " did not execute: status=" + provider_status_name(outcome.status))

    SourceResult(
        source_id: source.source_id,
        provider_id: source.provider_id,
        independence_group: selection.independence_group,
        status: outcome.status,
        artifact: outcome.artifact,
        execution: outcome.execution,
        provenance: runner_provenance(context, plan, selection),
        # Wave 1 runs no converters; the field is present and empty rather than
        # absent so the receipt shape never changes when converters land.
        conversions: [],
        diagnostics: diagnostics
    )

pub fn runner_execute_plan(context: RunnerContext, plan: CounterpartPlan) -> [SourceResult]:
    var results: [SourceResult] = []
    for source in plan.sources:
        results.push(runner_execute_source(context, plan, source))
    results

# The full provider body: execute, then hand the bundle to the N-way engine.
# The engine owns the verdict; the runner never decides one.
pub fn runner_run(context: RunnerContext, plan: CounterpartPlan) -> CounterpartRun:
    evaluate_matrix(plan, runner_execute_plan(context, plan))

# ---------------------------------------------------------------------------
# Reporting helpers (counts only — no Markdown)
# ---------------------------------------------------------------------------

pub fn runner_requested_count(plan: CounterpartPlan) -> i64:
    plan.sources.len()

pub fn runner_executed_count(results: [SourceResult]) -> i64:
    var count: i64 = 0
    for result in results:
        match result.status:
            ProviderStatus.executed => count = count + 1
            _ => count = count
    count

pub fn runner_unavailable_count(results: [SourceResult]) -> i64:
    var count: i64 = 0
    for result in results:
        match result.status:
            ProviderStatus.executed => count = count
            _ => count = count + 1
    count

pub fn runner_result_index(results: [SourceResult], source_id: text) -> i64:
    var index: i64 = 0
    while index < results.len():
        if results[index].source_id == source_id:
            return index
        index = index + 1
    0 - 1
