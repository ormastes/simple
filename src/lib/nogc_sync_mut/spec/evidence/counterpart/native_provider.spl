@allow(primitive_api)
# Counterpart Conformance — ProviderKind.native_in_process (Wave 1, lane F4).
#
# primitive_api is allowed here deliberately: the ABI status codes and the
# artifact counts this module forwards are the frozen Wave-0 wire types.
#
# Loads a pinned adapter shared library through the stable C ABI, opens one
# instance, invokes one component and projects the SDN response envelope onto a
# LogicalArtifact plus an ExecutionReceipt.
#
# BLOCKED, KNOWN, NOT WORKED AROUND: the `rt_counterpart_*` shim is not yet
# linked into the runtime, so `CounterpartLibrary` cannot actually be called
# from Simple today —
# doc/08_tracking/bug/counterpart_abi_shim_not_linked_into_runtime_2026-08-09.md.
# This module is therefore structured against the wrapper and NOT verified end
# to end. It is deliberately not stubbed: a fake ABI here would make the lane
# look green while proving nothing. Until the shim lands, the registry, runner
# and matrix path is exercised through the runner's declared stub inputs, which
# are recorded in every SourceResult's diagnostics so a stubbed run can never be
# mistaken for a real provider execution.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §3.2
# Contracts: src/lib/common/spec/evidence/counterpart/model.spl (frozen, do not edit)

use std.common.spec.evidence.counterpart.model.{
    ExecutionMode,
    ExecutionReceipt,
    ProviderStatus
}
use std.nogc_sync_mut.spec.evidence.counterpart.provider_registry.{
    ProviderSelection,
    ProviderOutcome,
    counterpart_response_artifact,
    counterpart_response_field,
    provider_outcome_failed
}
use std.nogc_sync_mut.sffi.counterpart_abi.{
    CounterpartLibrary,
    CounterpartResponse,
    CounterpartFailure
}

# Execution mode as the adapter reported it. An adapter that reports nothing is
# `unknown`, never `cpu_reference` — claiming a mode the provider did not state
# is exactly how a GPU lane that fell back reads as a GPU lane.
pub fn native_execution_mode(trace: text) -> ExecutionMode:
    match counterpart_response_field(trace, "execution_mode"):
        "cpu_reference" => ExecutionMode.cpu_reference
        "simd" => ExecutionMode.simd
        "hybrid_vector_gpu" => ExecutionMode.hybrid_vector_gpu
        "resident_gpu" => ExecutionMode.resident_gpu
        "vulkan" => ExecutionMode.vulkan
        "cuda" => ExecutionMode.cuda
        _ => ExecutionMode.unknown

fn native_receipt(provider_id: text, trace: text) -> ExecutionReceipt:
    ExecutionReceipt(
        provider_id: provider_id,
        execution_mode: native_execution_mode(trace),
        device_identity: counterpart_response_field(trace, "device_identity"),
        queue_identity: counterpart_response_field(trace, "queue_identity"),
        submission_count: 0,
        fence_completed: false,
        device_origin_readback: false,
        fallback_used: counterpart_response_field(trace, "fallback_used") == "true",
        dropped_events: 0,
        completed: true
    )

# Invoke one component in process. Every failure path yields a NON-executed
# status: an adapter that cannot be loaded is `unavailable`, one that aborts is
# `crashed`, one whose manifest is refused is `rejected_manifest`. None of them
# is ever normalized into a pass.
pub fn native_provider_execute(
    selection: ProviderSelection,
    request: text
) -> ProviderOutcome:
    if not selection.resolved:
        return provider_outcome_failed(selection.provider_id,
            selection.unresolved_status,
            "native provider was not selected", "", 0 - 1)
    if selection.adapter_path == "":
        return provider_outcome_failed(selection.provider_id,
            ProviderStatus.unavailable,
            "native provider '" + selection.provider_id + "' has no adapter path",
            "", 0 - 1)

    match CounterpartLibrary.open(selection.adapter_path, selection.config):
        Err(failure): return provider_outcome_failed(selection.provider_id,
            failure.provider_status,
            "open " + selection.adapter_path + " failed: " + failure.status_name
                + " " + failure.detail,
            "", failure.status)
        Ok(opened):
            var library = opened
            match library.invoke(selection.component_id, request):
                Err(failure):
                    val _ = library.close()
                    return provider_outcome_failed(selection.provider_id,
                        failure.provider_status,
                        "invoke " + selection.component_id + " failed: "
                            + failure.status_name + " " + failure.detail,
                        "", failure.status)
                Ok(response):
                    val _ = library.close()
                    return ProviderOutcome(
                        status: ProviderStatus.executed,
                        artifact: counterpart_response_artifact(
                            response.response, selection.counterpart_boundary_id),
                        execution: native_receipt(selection.provider_id, response.trace),
                        raw_response: response.response,
                        raw_stderr: response.trace,
                        exit_code: 0,
                        diagnostics: []
                    )
