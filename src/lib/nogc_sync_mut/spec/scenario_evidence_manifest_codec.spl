# Typed SDN codec helpers for scenario evidence manifests.
#
# This module deliberately has no ScenarioEvidenceManifest dependency.

use std.common.sdn.value.{SdnValue}
use std.common.spec.scenario_evidence.{
    ScenarioCaptureKind, ScenarioEvidenceArtifact, ScenarioHtmlCheckTool,
    ScenarioHtmlCheckResult, scenario_capture_kind_name,
    scenario_html_check_tool_name
}
use std.common.spec.scenario_text_evidence.{ScenarioTextMatchResult}
use std.common.spec.scenario_motion_evidence.{
    ScenarioArtifactIntegrity, ScenarioMotionEvent, ScenarioMotionKeyframe,
    ScenarioMotionEvidence
}
use std.common.spec.scenario_protocol_evidence.{ScenarioProtocolFieldEvidence}

pub fn evidence_codec_string_array(values: [text]) -> SdnValue:
    var items: [SdnValue] = []
    for value in values:
        items.push(SdnValue.String(value))
    SdnValue.Array(items)

fn _codec_artifact_value(artifact: ScenarioEvidenceArtifact) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["kind"] = SdnValue.String(scenario_capture_kind_name(artifact.kind))
    value["title"] = SdnValue.String(artifact.title)
    value["mime"] = SdnValue.String(artifact.mime)
    value["path"] = SdnValue.String(artifact.path)
    value["body"] = SdnValue.String(artifact.body)
    value["scenario_id"] = SdnValue.String(artifact.scenario_id)
    value["step_id"] = SdnValue.String(artifact.step_id)
    value["redacted"] = SdnValue.Bool(artifact.redacted)
    SdnValue.Dict(value)

pub fn evidence_codec_artifacts_value(
    artifacts: [ScenarioEvidenceArtifact]
) -> SdnValue:
    var values: [SdnValue] = []
    for artifact in artifacts:
        values.push(_codec_artifact_value(artifact))
    SdnValue.Array(values)

fn _codec_integrity_value(integrity: ScenarioArtifactIntegrity) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["path"] = SdnValue.String(integrity.path)
    value["format"] = SdnValue.String(integrity.format)
    value["mime"] = SdnValue.String(integrity.mime)
    value["width"] = SdnValue.Int(integrity.width)
    value["height"] = SdnValue.Int(integrity.height)
    value["byte_size"] = SdnValue.Int(integrity.byte_size)
    value["checksum"] = SdnValue.String(integrity.checksum)
    value["producer"] = SdnValue.String(integrity.producer)
    value["producer_version"] = SdnValue.String(integrity.producer_version)
    value["source_revision"] = SdnValue.String(integrity.source_revision)
    value["host"] = SdnValue.String(integrity.host)
    value["target"] = SdnValue.String(integrity.target)
    value["capture_ready"] = SdnValue.Bool(integrity.capture_ready)
    value["baseline_identity"] = SdnValue.String(integrity.baseline_identity)
    value["comparison_result"] = SdnValue.String(integrity.comparison_result)
    value["required"] = SdnValue.Bool(integrity.required)
    SdnValue.Dict(value)

pub fn evidence_codec_integrity_value(
    entries: [ScenarioArtifactIntegrity]
) -> SdnValue:
    var values: [SdnValue] = []
    for entry in entries:
        values.push(_codec_integrity_value(entry))
    SdnValue.Array(values)

fn _codec_text_result_value(result: ScenarioTextMatchResult) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["passed"] = SdnValue.Bool(result.passed)
    value["first_expected_index"] = SdnValue.Int(result.first_expected_index)
    value["first_actual_index"] = SdnValue.Int(result.first_actual_index)
    value["diagnostic"] = SdnValue.String(result.diagnostic)
    value["raw_transcript"] = SdnValue.String(result.raw_transcript)
    value["normalized_transcript"] = SdnValue.String(result.normalized_transcript)
    SdnValue.Dict(value)

pub fn evidence_codec_text_results_value(
    entries: [ScenarioTextMatchResult]
) -> SdnValue:
    var values: [SdnValue] = []
    for entry in entries:
        values.push(_codec_text_result_value(entry))
    SdnValue.Array(values)

fn _codec_motion_event_value(event: ScenarioMotionEvent) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["sequence"] = SdnValue.Int(event.sequence)
    value["time_ms"] = SdnValue.Int(event.time_ms)
    value["kind"] = SdnValue.String(event.kind)
    value["target"] = SdnValue.String(event.target)
    value["value"] = SdnValue.String(event.value)
    value["status"] = SdnValue.String(event.status)
    SdnValue.Dict(value)

fn _codec_motion_keyframe_value(keyframe: ScenarioMotionKeyframe) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["time_ms"] = SdnValue.Int(keyframe.time_ms)
    value["artifact_path"] = SdnValue.String(keyframe.artifact_path)
    value["oracle"] = SdnValue.String(keyframe.oracle)
    value["status"] = SdnValue.String(keyframe.status)
    SdnValue.Dict(value)

fn _codec_motion_value(motion: ScenarioMotionEvidence) -> SdnValue:
    var events: [SdnValue] = []
    for event in motion.events:
        events.push(_codec_motion_event_value(event))
    var keyframes: [SdnValue] = []
    for keyframe in motion.keyframes:
        keyframes.push(_codec_motion_keyframe_value(keyframe))
    var value: Dict<text, SdnValue> = {}
    value["duration_ms"] = SdnValue.Int(motion.duration_ms)
    value["events"] = SdnValue.Array(events)
    value["keyframes"] = SdnValue.Array(keyframes)
    value["transcript_path"] = SdnValue.String(motion.transcript_path)
    value["review_media_path"] = SdnValue.String(motion.review_media_path)
    SdnValue.Dict(value)

pub fn evidence_codec_motion_value(entries: [ScenarioMotionEvidence]) -> SdnValue:
    var values: [SdnValue] = []
    for entry in entries:
        values.push(_codec_motion_value(entry))
    SdnValue.Array(values)

fn _codec_protocol_field_value(field: ScenarioProtocolFieldEvidence) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["byte_offset"] = SdnValue.Int(field.byte_offset)
    value["byte_length"] = SdnValue.Int(field.byte_length)
    value["bit_offset"] = SdnValue.Int(field.bit_offset)
    value["bit_width"] = SdnValue.Int(field.bit_width)
    value["mask"] = SdnValue.String(field.mask)
    value["endianness"] = SdnValue.String(field.endianness)
    value["name"] = SdnValue.String(field.name)
    value["actual"] = SdnValue.String(field.actual)
    value["expected"] = SdnValue.String(field.expected)
    value["status"] = SdnValue.String(field.status)
    value["importance"] = SdnValue.String(field.importance)
    value["note"] = SdnValue.String(field.note)
    SdnValue.Dict(value)

pub fn evidence_codec_protocol_value(
    entries: [ScenarioProtocolFieldEvidence]
) -> SdnValue:
    var values: [SdnValue] = []
    for entry in entries:
        values.push(_codec_protocol_field_value(entry))
    SdnValue.Array(values)

fn _codec_html_check_value(check: ScenarioHtmlCheckResult) -> SdnValue:
    var value: Dict<text, SdnValue> = {}
    value["tool"] = SdnValue.String(scenario_html_check_tool_name(check.tool))
    value["passed"] = SdnValue.Bool(check.passed)
    value["summary"] = SdnValue.String(check.summary)
    value["messages"] = SdnValue.String(check.messages)
    value["artifact"] = _codec_artifact_value(check.artifact)
    SdnValue.Dict(value)

pub fn evidence_codec_html_value(entries: [ScenarioHtmlCheckResult]) -> SdnValue:
    var values: [SdnValue] = []
    for entry in entries:
        values.push(_codec_html_check_value(entry))
    SdnValue.Array(values)

fn _codec_get_text(value: SdnValue, field: text) -> Result<text, text>:
    if val Some(item) = value.get(field):
        if val Some(result) = item.as_str():
            return Ok(result)
        return Err("field must be text: " + field)
    Err("missing required field: " + field)

fn _codec_get_i64(value: SdnValue, field: text) -> Result<i64, text>:
    if val Some(item) = value.get(field):
        if val Some(result) = item.as_i64():
            return Ok(result)
        return Err("field must be integer: " + field)
    Err("missing required field: " + field)

fn _codec_get_bool(value: SdnValue, field: text) -> Result<bool, text>:
    if val Some(item) = value.get(field):
        if val Some(result) = item.as_bool():
            return Ok(result)
        return Err("field must be bool: " + field)
    Err("missing required field: " + field)

fn _codec_capture_kind(value: text) -> Result<ScenarioCaptureKind, text>:
    match value:
        case "tui": Ok(ScenarioCaptureKind.tui)
        case "gui": Ok(ScenarioCaptureKind.gui)
        case "motion": Ok(ScenarioCaptureKind.motion)
        case "html": Ok(ScenarioCaptureKind.html)
        case "api": Ok(ScenarioCaptureKind.api)
        case "protocol": Ok(ScenarioCaptureKind.protocol)
        case "text": Ok(ScenarioCaptureKind.text)
        case "exec": Ok(ScenarioCaptureKind.exec)
        case "binary": Ok(ScenarioCaptureKind.binary)
        case "log": Ok(ScenarioCaptureKind.log)
        case "artifact": Ok(ScenarioCaptureKind.artifact)
        case _: Err("unknown artifact kind: " + value)

fn _codec_parse_artifact(value: SdnValue) -> Result<ScenarioEvidenceArtifact, text>:
    if not value.is_dict():
        return Err("artifact must be a dict")
    Ok(ScenarioEvidenceArtifact(
        kind: _codec_capture_kind(_codec_get_text(value, "kind")?)?,
        title: _codec_get_text(value, "title")?,
        mime: _codec_get_text(value, "mime")?,
        path: _codec_get_text(value, "path")?,
        body: _codec_get_text(value, "body")?,
        scenario_id: _codec_get_text(value, "scenario_id")?,
        step_id: _codec_get_text(value, "step_id")?,
        redacted: _codec_get_bool(value, "redacted")?
    ))

pub fn evidence_codec_parse_artifacts(
    value: SdnValue
) -> Result<[ScenarioEvidenceArtifact], text>:
    if val Some(item) = value.get("artifacts"):
        if val Some(items) = item.as_array():
            var result: [ScenarioEvidenceArtifact] = []
            for entry in items:
                result.push(_codec_parse_artifact(entry)?)
            return Ok(result)
        return Err("field must be array: artifacts")
    Err("missing required field: artifacts")

fn _codec_parse_integrity(value: SdnValue) -> Result<ScenarioArtifactIntegrity, text>:
    if not value.is_dict():
        return Err("artifact integrity must be a dict")
    Ok(ScenarioArtifactIntegrity(
        path: _codec_get_text(value, "path")?,
        format: _codec_get_text(value, "format")?,
        mime: _codec_get_text(value, "mime")?,
        width: _codec_get_i64(value, "width")?,
        height: _codec_get_i64(value, "height")?,
        byte_size: _codec_get_i64(value, "byte_size")?,
        checksum: _codec_get_text(value, "checksum")?,
        producer: _codec_get_text(value, "producer")?,
        producer_version: _codec_get_text(value, "producer_version")?,
        source_revision: _codec_get_text(value, "source_revision")?,
        host: _codec_get_text(value, "host")?,
        target: _codec_get_text(value, "target")?,
        capture_ready: _codec_get_bool(value, "capture_ready")?,
        baseline_identity: _codec_get_text(value, "baseline_identity")?,
        comparison_result: _codec_get_text(value, "comparison_result")?,
        required: _codec_get_bool(value, "required")?
    ))

pub fn evidence_codec_parse_integrity(
    value: SdnValue
) -> Result<[ScenarioArtifactIntegrity], text>:
    if val Some(item) = value.get("artifact_integrity"):
        if val Some(items) = item.as_array():
            var result: [ScenarioArtifactIntegrity] = []
            for entry in items:
                result.push(_codec_parse_integrity(entry)?)
            return Ok(result)
        return Err("field must be array: artifact_integrity")
    Ok([])

fn _codec_parse_text_result(value: SdnValue) -> Result<ScenarioTextMatchResult, text>:
    if not value.is_dict():
        return Err("text result must be a dict")
    Ok(ScenarioTextMatchResult(
        passed: _codec_get_bool(value, "passed")?,
        first_expected_index: _codec_get_i64(value, "first_expected_index")?,
        first_actual_index: _codec_get_i64(value, "first_actual_index")?,
        diagnostic: _codec_get_text(value, "diagnostic")?,
        raw_transcript: _codec_get_text(value, "raw_transcript")?,
        normalized_transcript: _codec_get_text(value, "normalized_transcript")?
    ))

pub fn evidence_codec_parse_text_results(
    value: SdnValue
) -> Result<[ScenarioTextMatchResult], text>:
    if val Some(item) = value.get("text_results"):
        if val Some(items) = item.as_array():
            var result: [ScenarioTextMatchResult] = []
            for entry in items:
                result.push(_codec_parse_text_result(entry)?)
            return Ok(result)
        return Err("field must be array: text_results")
    Ok([])

fn _codec_parse_motion_event(value: SdnValue) -> Result<ScenarioMotionEvent, text>:
    if not value.is_dict():
        return Err("motion event must be a dict")
    Ok(ScenarioMotionEvent(
        sequence: _codec_get_i64(value, "sequence")?,
        time_ms: _codec_get_i64(value, "time_ms")?,
        kind: _codec_get_text(value, "kind")?,
        target: _codec_get_text(value, "target")?,
        value: _codec_get_text(value, "value")?,
        status: _codec_get_text(value, "status")?
    ))

fn _codec_parse_motion_events(value: SdnValue) -> Result<[ScenarioMotionEvent], text>:
    if val Some(item) = value.get("events"):
        if val Some(items) = item.as_array():
            var result: [ScenarioMotionEvent] = []
            for entry in items:
                result.push(_codec_parse_motion_event(entry)?)
            return Ok(result)
        return Err("field must be array: events")
    Err("missing required field: events")

fn _codec_parse_motion_keyframe(
    value: SdnValue
) -> Result<ScenarioMotionKeyframe, text>:
    if not value.is_dict():
        return Err("motion keyframe must be a dict")
    Ok(ScenarioMotionKeyframe(
        time_ms: _codec_get_i64(value, "time_ms")?,
        artifact_path: _codec_get_text(value, "artifact_path")?,
        oracle: _codec_get_text(value, "oracle")?,
        status: _codec_get_text(value, "status")?
    ))

fn _codec_parse_motion_keyframes(
    value: SdnValue
) -> Result<[ScenarioMotionKeyframe], text>:
    if val Some(item) = value.get("keyframes"):
        if val Some(items) = item.as_array():
            var result: [ScenarioMotionKeyframe] = []
            for entry in items:
                result.push(_codec_parse_motion_keyframe(entry)?)
            return Ok(result)
        return Err("field must be array: keyframes")
    Err("missing required field: keyframes")

fn _codec_parse_motion(value: SdnValue) -> Result<ScenarioMotionEvidence, text>:
    if not value.is_dict():
        return Err("motion evidence must be a dict")
    Ok(ScenarioMotionEvidence(
        duration_ms: _codec_get_i64(value, "duration_ms")?,
        events: _codec_parse_motion_events(value)?,
        keyframes: _codec_parse_motion_keyframes(value)?,
        transcript_path: _codec_get_text(value, "transcript_path")?,
        review_media_path: _codec_get_text(value, "review_media_path")?
    ))

pub fn evidence_codec_parse_motion(
    value: SdnValue
) -> Result<[ScenarioMotionEvidence], text>:
    if val Some(item) = value.get("motion_evidence"):
        if val Some(items) = item.as_array():
            var result: [ScenarioMotionEvidence] = []
            for entry in items:
                result.push(_codec_parse_motion(entry)?)
            return Ok(result)
        return Err("field must be array: motion_evidence")
    Ok([])

fn _codec_parse_protocol_field(
    value: SdnValue
) -> Result<ScenarioProtocolFieldEvidence, text>:
    if not value.is_dict():
        return Err("protocol field must be a dict")
    Ok(ScenarioProtocolFieldEvidence(
        byte_offset: _codec_get_i64(value, "byte_offset")?,
        byte_length: _codec_get_i64(value, "byte_length")?,
        bit_offset: _codec_get_i64(value, "bit_offset")?,
        bit_width: _codec_get_i64(value, "bit_width")?,
        mask: _codec_get_text(value, "mask")?,
        endianness: _codec_get_text(value, "endianness")?,
        name: _codec_get_text(value, "name")?,
        actual: _codec_get_text(value, "actual")?,
        expected: _codec_get_text(value, "expected")?,
        status: _codec_get_text(value, "status")?,
        importance: _codec_get_text(value, "importance")?,
        note: _codec_get_text(value, "note")?
    ))

pub fn evidence_codec_parse_protocol(
    value: SdnValue
) -> Result<[ScenarioProtocolFieldEvidence], text>:
    if val Some(item) = value.get("protocol_fields"):
        if val Some(items) = item.as_array():
            var result: [ScenarioProtocolFieldEvidence] = []
            for entry in items:
                result.push(_codec_parse_protocol_field(entry)?)
            return Ok(result)
        return Err("field must be array: protocol_fields")
    Ok([])

fn _codec_html_tool(value: text) -> Result<ScenarioHtmlCheckTool, text>:
    match value:
        case "simple_html_heuristic": Ok(ScenarioHtmlCheckTool.simple_html_heuristic)
        case "nu_html_checker": Ok(ScenarioHtmlCheckTool.nu_html_checker)
        case "html_validate": Ok(ScenarioHtmlCheckTool.html_validate)
        case "axe_core": Ok(ScenarioHtmlCheckTool.axe_core)
        case "playwright_locator": Ok(ScenarioHtmlCheckTool.playwright_locator)
        case _: Err("unknown HTML check tool: " + value)

fn _codec_parse_html_check(value: SdnValue) -> Result<ScenarioHtmlCheckResult, text>:
    if not value.is_dict():
        return Err("HTML check must be a dict")
    if val Some(artifact) = value.get("artifact"):
        return Ok(ScenarioHtmlCheckResult(
            tool: _codec_html_tool(_codec_get_text(value, "tool")?)?,
            passed: _codec_get_bool(value, "passed")?,
            summary: _codec_get_text(value, "summary")?,
            messages: _codec_get_text(value, "messages")?,
            artifact: _codec_parse_artifact(artifact)?
        ))
    Err("missing required field: artifact")

pub fn evidence_codec_parse_html(
    value: SdnValue
) -> Result<[ScenarioHtmlCheckResult], text>:
    if val Some(item) = value.get("html_checks"):
        if val Some(items) = item.as_array():
            var result: [ScenarioHtmlCheckResult] = []
            for entry in items:
                result.push(_codec_parse_html_check(entry)?)
            return Ok(result)
        return Err("field must be array: html_checks")
    Ok([])

export evidence_codec_string_array
export evidence_codec_artifacts_value, evidence_codec_integrity_value
export evidence_codec_text_results_value, evidence_codec_motion_value
export evidence_codec_protocol_value, evidence_codec_html_value
export evidence_codec_parse_artifacts, evidence_codec_parse_integrity
export evidence_codec_parse_text_results, evidence_codec_parse_motion
export evidence_codec_parse_protocol, evidence_codec_parse_html
