# Child-local explicit transport. Parent runners must not mutate process-wide
# environment variables while other test invocations may be running.
use std.nogc_sync_mut.io.env_ops.{env_get}
var _explicit_evidence_path_v1: text = ""

pub fn set_test_evidence_path_v1(path: text):
    _explicit_evidence_path_v1 = path

pub fn test_evidence_path_v1() -> text:
    if _explicit_evidence_path_v1 != "": return _explicit_evidence_path_v1
    env_get("SIMPLE_TEST_RESULT_FILE") ?? ""

export set_test_evidence_path_v1, test_evidence_path_v1
