# Optional framework-owned machine event transport. The parent runner admits
# provenance and maps names to its frozen plan; these events cannot self-admit.
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_append}
use std.common.traceability.case_events.{TraceCaseEvent, encode_trace_case_event}

pub fn emit_trace_case_event(case_name: text, phase: text, outcome: text):
    if (env_get("SIMPLE_TRACE_CASE_EVENTS") ?? "") != "1":
        return
    val payload = encode_trace_case_event(TraceCaseEvent(case_name, phase, outcome))
    # The runner already gives each native/interpreter child its own result
    # file. Append independently parseable canonical SDN documents beside it;
    # this retains earlier events if the child crashes or stdout is truncated.
    # This .sdnstream is explicitly a diagnostic framed transport, NOT one
    # SDN document and NOT an admitted run.sdn. The receiver parses each
    # canonical record via collect_trace_event_documents/decode_trace_case_events.
    # No shared cross-process writer and no generic JSON payload is involved.
    val result_path = env_get("SIMPLE_TEST_RESULT_FILE") ?? ""
    if result_path != "":
        if not file_append(result_path + ".trace-events.sdnstream", payload + "\n"):
            print "SIMPLE_TRACE_EVENT_ERROR could not persist case event"
    print "SIMPLE_TRACE_CASE_EVENT {payload}"
