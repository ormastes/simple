"""
# Engine probe — let a spec assert against an engine it cannot itself run on

@tag:stdlib
@tag:testing

## Why this exists

A `*_spec.spl` NEVER executes under the Cranelift JIT, so an in-process
`expect(...)` can be green through a complete reintroduction of a JIT-only
defect. Three layers stack to guarantee this:

1. The test runner pins the child's engine before spawning it —
   `src/app/test_runner_new/test_runner_single.spl:330-331` and
   `src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl:86`
   both `env_set("SIMPLE_EXECUTION_MODE", "interpret")`.
2. The seed honours that pin —
   `src/compiler_rust/driver/src/exec_core.rs:37-38` maps
   `"interpret" | "interpreter"` to `ExecutionMode::Interpret`, and `:638`
   branches `if self.execution_mode.is_jit()`.
3. Even with the JIT forced ON, a spec file still de-JITs:
   `src/compiler_rust/driver/src/exec_core.rs:774-781` falls back to the
   tree-walking `evaluate_module` for any module with no `fn main`, and a
   spec file is top-level `describe`/`it` with no `main`.

Layer 3 is the inherent one. `describe` / `it` / `expect` are Rust
INTERPRETER INTRINSICS carrying thread-local state
(`src/compiler_rust/compiler/src/interpreter_call/bdd.rs:510`, using
`BDD_INDENT` / `BDD_GROUP_STACK` / `BDD_CONTEXT_DEFS`). There is no JIT
lowering for them at all — grepping `codegen/**` for `"describe"`, `"it"` or
`"expect"` returns zero hits. So the demotion cannot simply be "lifted": a
spec body physically cannot run under the JIT today.

## The mechanism this module provides

Move the assertion OUT OF PROCESS instead. The spec stays on the
interpreter, where it is allowed to live; it spawns a plain runnable
`.spl` PROGRAM (one with `fn main`) under an explicitly named engine and
asserts on that child's stdout. The spec is then pinned to a NAMED engine
rather than to whichever engine happens to be reachable.

    use std.spec.{describe, it, expect}
    use std.spec.engine_probe.{run_under_engine, engine_stdout}

    describe "my feature":
        it "behaves identically under the JIT":
            expect(engine_stdout("test/.../my_probe.spl", "jit"))
                .to_contain("PROBE VERDICT: PASS")

## Rules for the probe program it points at

- The probe MUST have `fn main` — without it, layer 3 above silently
  de-JITs the probe too and the assertion becomes vacuous.
- The probe MUST print a self-scored verdict line. Score by that LINE, not
  by the exit code: a codegen panic and a clean failure both exit non-zero,
  and some failure shapes still exit 0.
- Always assert the SAME probe under `"interpret"` as well. Two engines
  agreeing is the evidence; one engine passing is not.
- Prove the assertion can fail before trusting it. Sabotage the codegen arm
  (or run a pre-fix binary) and observe RED. An assertion never observed
  failing is not a guard.

## Engine names

`SIMPLE_EXECUTION_MODE` accepts `interpret`, `interpreter` and `jit`
(`exec_core.rs:37-38`). An UNRECOGNISED value silently selects the JIT, so
a typo like `"interp"` makes an A/B comparison look like agreement. This
module rejects unknown names up front rather than letting that happen.
"""

extern fn rt_process_run_bounded(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64)
use std.io_runtime.{env_get, env_set}
use std.io_runtime.{file_exists}
extern fn rt_path_absolute(path: text) -> text

val PROBE_TIMEOUT_MS: i64 = 120000
val PROBE_MAX_OUTPUT: i64 = 262144

pub fn is_known_engine(engine: text) -> bool:
    """An unrecognised SIMPLE_EXECUTION_MODE silently means JIT — reject it."""
    engine == "jit" or engine == "interpret" or engine == "interpreter"

pub fn simple_binary() -> text:
    """Resolve the compiler binary to spawn probes with.

    Order: SIMPLE_BINARY, then the invoking binary via /proc/self/exe (so a
    probe runs on the SAME build the spec is running on, not a stale
    bin/simple), then bin/simple.
    """
    val configured = env_get("SIMPLE_BINARY")
    if configured != nil and configured != "" and file_exists(configured):
        return configured
    val self_path = rt_path_absolute("/proc/self/exe") ?? ""
    if self_path.len() > 0 and self_path != "/proc/self/exe" and file_exists(self_path):
        return self_path
    if file_exists("bin/simple"):
        return "bin/simple"
    "./bin/simple"

pub fn run_under_engine(spl_path: text, engine: text) -> (text, text, i64):
    """Run a runnable `.spl` program under a NAMED engine, out of process.

    Returns (stdout, stderr, exit_code). Score the caller's assertion on a
    verdict line inside stdout, not on exit_code.
    """
    if not is_known_engine(engine):
        return ("", "engine_probe: unknown engine '{engine}' (use jit, interpret or interpreter)", -1)
    if not file_exists(spl_path):
        return ("", "engine_probe: probe program not found: {spl_path}", -1)

    val binary = simple_binary()
    val previous = env_get("SIMPLE_EXECUTION_MODE") ?? ""
    env_set("SIMPLE_EXECUTION_MODE", engine)
    # SIMPLE_RUNTIME_MODE is the older spelling the runner also pins; leaving
    # it on "interpreter" would fight the engine we are trying to select.
    val previous_runtime = env_get("SIMPLE_RUNTIME_MODE") ?? ""
    env_set("SIMPLE_RUNTIME_MODE", engine)

    val result = rt_process_run_bounded(binary, ["run", spl_path], PROBE_TIMEOUT_MS, PROBE_MAX_OUTPUT)

    env_set("SIMPLE_EXECUTION_MODE", previous)
    env_set("SIMPLE_RUNTIME_MODE", previous_runtime)
    result

pub fn engine_stdout(spl_path: text, engine: text) -> text:
    """stdout of `spl_path` run under `engine` — the usual `expect` target."""
    val (out, err, code) = run_under_engine(spl_path, engine)
    if out.len() == 0 and err.len() > 0:
        return "engine_probe: no stdout (exit {code}); stderr: {err}"
    out

pub fn engine_verdict_passes(spl_path: text, engine: text, verdict: text) -> bool:
    """True when the probe printed `verdict` under `engine`.

    A codegen panic produces no verdict line at all, so this is false for
    both a wrong answer and a crashed engine — which is what you want.
    """
    engine_stdout(spl_path, engine).contains(verdict)
