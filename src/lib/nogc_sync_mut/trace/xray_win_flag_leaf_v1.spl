# Windows x64 XRay flag-guard leaf (PROVISIONAL design, decision doc
# doc/08_tracking/bug/xray_llvm_windows_flag_guard_leaf_and_admission_decisions_2026-11-14.md).
#
# No code is patched. The LLVM translator emits, in the `--xray` DLL:
#   @__simple_xray_descriptor_v1 = { i64 count, [count x ptr] }   one i8 slot per site
#   @__simple_xray_names_v1      = { i64 count, [count x ptr] }   C string per site
#   @__simple_xray_hook_v1       = ptr                            void(i64 site, i32 kind)
#   @__simple_xray_ring_v2       = { i64 cap, i64 widx, i64 dropped, [cap x { i64 site, i32 kind, i32 pad, i64 seq, i64 ts }] }
#     (ring ABI v2: ts = llvm.readcyclecounter at the edge, in counter ticks)
# Each sled function loads its slot at entry (kind 0) and before every ret
# (kind 1) and calls the DLL-local edge when the slot is nonzero; the edge
# calls the hook when set, else appends to the ring (ring mode, PROVISIONAL).
# This leaf resolves the exported symbols on the loaded DLL, installs either a
# handler (hook mode) or nothing (ring mode, drained by drain()), and
# sets/clears slots. Adapter ids are 1-based; descriptor/hook sites 0-based.
#
# Concurrency: slot and hook stores are single aligned stores; the caller is the
# adapter's serialized control-plane owner (quiescent mode). The handler hot
# path is the lockless channel CAS of observer_native_channel_v1.
use std.common.trace.observer_contract_v1.{TraceBackendV1}
use std.common.text_bytes.{bytes_to_text}
use std.nogc_sync_mut.ptr.raw.{rt_ptr_read_i64, rt_ptr_write_i64, rt_ptr_read_u8, rt_ptr_write_u8}
use std.nogc_sync_mut.trace.xray_llvm_adapter_v1.{XrayLlvmLeafV1, XRAY_LLVM_STATUS_SUCCESS_V1, XRAY_LLVM_STATUS_FAILED_V1, XRAY_LLVM_STATUS_INVALID_ID_V1}
use std.nogc_sync_mut.trace.observer_native_channel_v1.{trace_native_channel_close_v1, trace_native_channel_record_words_v1}

pub const XRAY_WIN_DESCRIPTOR_SYMBOL_V1: text = "__simple_xray_descriptor_v1"
pub const XRAY_WIN_NAMES_SYMBOL_V1: text = "__simple_xray_names_v1"
pub const XRAY_WIN_HOOK_SYMBOL_V1: text = "__simple_xray_hook_v1"
pub const XRAY_WIN_RING_SYMBOL_V1: text = "__simple_xray_ring_v2"
# Present (i64 1) only in a wrap-mode module; absent = drop mode.
pub const XRAY_WIN_RING_WRAP_SYMBOL_V1: text = "__simple_xray_ring_wrap_v2"
const XRAY_WIN_MAX_SITES_V1: i64 = 4096

# The effect boundary: symbol lookup on the loaded DLL, and the C-callable
# address of the edge handler. Slot/hook/descriptor memory is read and written
# directly through std.nogc_sync_mut.ptr.raw.
pub trait XrayWinModulePortV1:
    # Exported data symbol address on the loaded DLL, 0 when absent.
    fn symbol(name: text) -> i64
    # C-callable `void(i64 site, i32 kind)` that forwards to
    # xray_win_edge_record_v1; 0 when this host cannot mint one.
    fn handler_address() -> i64

@unsafe(reason: "resolves an exported symbol on a loaded host DLL", capabilities: [ffi])
extern fn rt_host_dynlib_symbol(handle: i64, name: text) -> i64

# Host binding over the existing dynload path. handler_address is 0 (no
# C-callable entry for xray_win_edge_record_v1 from an interpreted host), so
# this port installs in ring mode only: the DLL records edges in its own ring
# and drain() reads them.
pub class XrayWinDynlibPortV1:
    handle: i64

impl XrayWinModulePortV1 for XrayWinDynlibPortV1:
    fn symbol(name: text) -> i64:
        if self.handle == 0: return 0
        unsafe(capabilities: [ffi]): rt_host_dynlib_symbol(self.handle, name)

    fn handler_address() -> i64:
        0

# Published once by install(); read by the handler.
pub struct XrayWinEdgeSinkV1:
    arena: i64
    generation: u64
    context: u64
    module_instance: u64

# The pure-Simple edge handler body: one raw-edge record per hook call.
# kind 0 = Entry (code 1), 1 = Exit (code 2). Returns the channel status.
@unsafe(reason: "writes the published resident channel arena", capabilities: [ffi])
pub fn xray_win_edge_record_v1(sink: XrayWinEdgeSinkV1, site: i64, kind: i32) -> i64:
    unsafe(capabilities: [ffi]): xray_win_edge_record_stamped_v1(sink, site, kind, 0u64)

# Same record with the edge's own timestamp (ring mode: the ring slot's ts).
@unsafe(reason: "writes the published resident channel arena", capabilities: [ffi])
pub fn xray_win_edge_record_stamped_v1(sink: XrayWinEdgeSinkV1, site: i64, kind: i32, timestamp: u64) -> i64:
    val code: u64 = if kind == 0: 1u64 else: 2u64
    val header = 1u64 | (96u64 << 16) | (code << 32)
    val id = (site + 1) as u64
    unsafe(capabilities: [ffi]):
        trace_native_channel_record_words_v1(sink.arena, header, sink.generation,
            sink.module_instance, id | (id << 32), sink.context, 0u64, timestamp, 0u64, 0u64, 0u64, 0u64)

pub class XrayWinFlagLeafV1:
    port: XrayWinModulePortV1
    descriptor: i64
    hook: i64
    ring: i64
    ring_read: i64
    ring_wrap: bool
    ring_skipped_count: i64
    ring_stall: i64
    sink: XrayWinEdgeSinkV1

impl XrayWinFlagLeafV1:
    static fn bind(port: XrayWinModulePortV1) -> XrayWinFlagLeafV1:
        XrayWinFlagLeafV1(port: port, descriptor: port.symbol(XRAY_WIN_DESCRIPTOR_SYMBOL_V1),
            hook: port.symbol(XRAY_WIN_HOOK_SYMBOL_V1), ring: port.symbol(XRAY_WIN_RING_SYMBOL_V1),
            ring_read: 0, ring_wrap: port.symbol(XRAY_WIN_RING_WRAP_SYMBOL_V1) != 0, ring_skipped_count: 0, ring_stall: -1,
            sink: XrayWinEdgeSinkV1(arena: 0, generation: 0u64, context: 0u64, module_instance: 0u64))

    # Edges the DLL dropped because the ring was full (0 without a ring).
    fn ring_dropped() -> i64:
        if self.ring == 0: return 0
        unsafe(capabilities: [ffi]): rt_ptr_read_i64(self.ring, 16)

    # Ring mode: turn every newly published ring record into one raw-edge
    # channel record. A record is published once its seq equals index + 1; the
    # first unpublished one stops the drain (retried next call). Returns the
    # number of records drained. Drop mode (no wrap symbol): once full, the DLL
    # drops and counts. Wrap mode: see drain_wrap.
    me drain() -> i64:
        if self.ring == 0 or self.sink.arena == 0: return 0
        if self.ring_wrap: return self.drain_wrap()
        var n = 0
        unsafe(capabilities: [ffi]):
            val cap = rt_ptr_read_i64(self.ring, 0)
            var end = rt_ptr_read_i64(self.ring, 8)
            if end > cap: end = cap
            while self.ring_read < end:
                val rec = 24 + self.ring_read * 32
                if rt_ptr_read_i64(self.ring, rec + 16) != self.ring_read + 1: break
                val site = rt_ptr_read_i64(self.ring, rec)
                val kind = (rt_ptr_read_i64(self.ring, rec + 8) & 4294967295) as i32
                val ts = rt_ptr_read_i64(self.ring, rec + 24) as u64
                xray_win_edge_record_stamped_v1(self.sink, site, kind, ts)
                self.ring_read = self.ring_read + 1
                n = n + 1
        n

    # Wrap mode: claims are read in order from at most `cap` behind the write
    # index (older ones were overwritten: skipped). Claim c lives in slot
    # c mod cap and is accepted only when its seq is c + 1 before and after
    # the payload read; a larger seq means a later lap overwrote it (skipped),
    # a smaller one means it is not yet published (drain stops, retried). A
    # slow writer of an older lap can publish over a newer claim, leaving a
    # smaller nonzero seq forever: when the same claim is still stuck on the
    # next drain it is skipped (ring_stall remembers the claim).
    me drain_wrap() -> i64:
        var n = 0
        unsafe(capabilities: [ffi]):
            val cap = rt_ptr_read_i64(self.ring, 0)
            val end = rt_ptr_read_i64(self.ring, 8)
            if end - self.ring_read > cap:
                self.ring_skipped_count = self.ring_skipped_count + (end - cap - self.ring_read)
                self.ring_read = end - cap
            while self.ring_read < end:
                val rec = 24 + (self.ring_read % cap) * 32
                val expect_seq = self.ring_read + 1
                val seq = rt_ptr_read_i64(self.ring, rec + 16)
                if seq < expect_seq:
                    if seq == 0 or self.ring_stall != self.ring_read:
                        self.ring_stall = self.ring_read
                        break
                    self.ring_skipped_count = self.ring_skipped_count + 1
                elif seq == expect_seq:
                    val site = rt_ptr_read_i64(self.ring, rec)
                    val kind = (rt_ptr_read_i64(self.ring, rec + 8) & 4294967295) as i32
                    val ts = rt_ptr_read_i64(self.ring, rec + 24) as u64
                    if rt_ptr_read_i64(self.ring, rec + 16) == expect_seq:
                        xray_win_edge_record_stamped_v1(self.sink, site, kind, ts)
                        n = n + 1
                    else:
                        self.ring_skipped_count = self.ring_skipped_count + 1
                else:
                    self.ring_skipped_count = self.ring_skipped_count + 1
                self.ring_read = self.ring_read + 1
        n

    # Wrap-mode claims never delivered (overwritten or torn); 0 in drop mode.
    fn ring_skipped() -> i64:
        self.ring_skipped_count

    fn slot_address(id: i64) -> i64:
        if id < 1 or id > self.max_function_id(): return 0
        unsafe(capabilities: [ffi]): rt_ptr_read_i64(self.descriptor, id * 8)

    me store_slot(id: i64, value: i64) -> i64:
        val slot = self.slot_address(id)
        if slot == 0: return XRAY_LLVM_STATUS_INVALID_ID_V1
        unsafe(capabilities: [ffi]):
            rt_ptr_write_u8(slot, 0, value)
            if rt_ptr_read_u8(slot, 0) != value: return XRAY_LLVM_STATUS_FAILED_V1
        XRAY_LLVM_STATUS_SUCCESS_V1

# Site -> Simple function name from the exported names table ("" if absent).
pub fn xray_win_site_name_v1(port: XrayWinModulePortV1, id: i64) -> text:
    val names = port.symbol(XRAY_WIN_NAMES_SYMBOL_V1)
    if names == 0: return ""
    unsafe(capabilities: [ffi]):
        val count = rt_ptr_read_i64(names, 0)
        if id < 1 or id > count: return ""
        val cstr = rt_ptr_read_i64(names, id * 8)
        var out: [u8] = []
        var i = 0
        while i < 1024:
            val b = rt_ptr_read_u8(cstr, i)
            if b == 0: break
            out = out.push(b as u8)
            i = i + 1
        bytes_to_text(out)

impl XrayLlvmLeafV1 for XrayWinFlagLeafV1:
    # Same compiler-emitted LLVM sled family as Linux; only the leaf differs.
    fn sled_kind() -> TraceBackendV1:
        TraceBackendV1.Llvm

    fn max_function_id() -> i64:
        if self.descriptor == 0 or self.hook == 0: return 0
        val count = unsafe(capabilities: [ffi]): rt_ptr_read_i64(self.descriptor, 0)
        if count < 0 or count > XRAY_WIN_MAX_SITES_V1: return 0
        count

    me install(arena: i64, generation: u64, context: u64, module_instance: u64) -> i64:
        if arena <= 0 or arena % 8 != 0 or generation == 0u64 or self.hook == 0: return 0
        val handler = self.port.handler_address()
        # Ring mode needs no handler: the hook stays null and drain() reads the ring.
        if handler == 0 and self.ring == 0: return 0
        self.sink = XrayWinEdgeSinkV1(arena: arena, generation: generation, context: context, module_instance: module_instance)
        if handler != 0:
            unsafe(capabilities: [ffi]): rt_ptr_write_i64(self.hook, 0, handler)
        1

    me patch_function(id: i64) -> i64:
        self.store_slot(id, 1)

    me unpatch_function(id: i64) -> i64:
        self.store_slot(id, 0)

    me close(arena: i64) -> i64:
        if arena <= 0 or arena != self.sink.arena: return 0
        unsafe(capabilities: [ffi]): trace_native_channel_close_v1(arena)
