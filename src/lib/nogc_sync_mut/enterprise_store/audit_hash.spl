# Both-OS audit-hash facade (W4-B, 2026-08-16).
#
# WHY THIS EXISTS: records.spl used std.common.crypto.sha256.sha256_text,
# which drags std.common.string_core (via crypto.types) plus the sized-array
# literal `[0; n]` in sha256_bytes into the compile closure. The standalone-SMF
# analyzer flags text slices `s[a:b]` (CollectionOps) and sized array literals
# (CollectionLiteral), so EVERY enterprise vertical probe failed
# `--target=x86_64-unknown-simpleos` cross-compilation. Same precedent as
# file_backend.spl declaring its externs locally.
#
# This file is a fully self-contained pure-Simple SHA-256 (FIPS 180-4) over
# text, deliberately written with ONLY standalone-SMF-safe constructs:
# while loops, `.push()`, direct indexing, plain (unsized) array literals,
# `.substring()` — no slices, no sized literals, no comprehensions, no `?`.
# DUPLICATE-OF: src/lib/common/crypto/sha256.spl (`sha256_text`). These two are
# independent SHA-256 implementations of the SAME function. If you change the
# hash behaviour of either one, you MUST change both, or the audit chain will
# compute different digests on SimpleOS than on the host while both look healthy.
#
# PARITY IS ENFORCED, not assumed:
#   test/01_unit/lib/nogc_sync_mut/enterprise_store/enterprise_store_audit_hash_parity_spec.spl
# pins both implementations to externally computed reference digests (FIPS 180-4
# plus python3 hashlib) across 13 vectors: empty, "abc", the FIPS 56-byte vector,
# the 55/56/63/64/65/119/120-byte padding edges, a 1000-byte multi-block payload,
# high-bit-set UTF-8, and a realistic audit-record JSON. Last run 2026-08-17:
# 14/14 passed, zero drift.
#
# ROOT FIX (W12-C assessment, 2026-08-17): collapse this file to a re-export of
# sha256_text once standalone-SMF codegen accepts slices and `[v; n]`. Rejection
# sites are src/compiler_rust/compiler/src/compilability.rs:529 (Slice ->
# CollectionOps) and :879 (ArrayRepeat -> CollectionLiteral). NOT yet a two-line
# deletion — see .spipe/simple_enterprise_suite/state.md § W12-C for why
# (`rt_array_repeat` is missing from the standalone symbol-emission allowlist in
# codegen/common_backend.rs, where `rt_slice` is present at four sites).

# Interpreter-registered extern (same one sha256_text uses).
use std.common.string_core.{text_to_bytes}

val AH_MASK32 = 4294967295

fn ah_rotr32(x: i64, n: i64) -> i64:
    ((x >> n) | (x << (32 - n))) & AH_MASK32

fn ah_k() -> [i64]:
    [1116352408, 1899447441, 3049323471, 3921009573,
     961987163, 1508970993, 2453635748, 2870763221,
     3624381080, 310598401, 607225278, 1426881987,
     1925078388, 2162078206, 2614888103, 3248222580,
     3835390401, 4022224774, 264347078, 604807628,
     770255983, 1249150122, 1555081692, 1996064986,
     2554220882, 2821834349, 2952996808, 3210313671,
     3336571891, 3584528711, 113926993, 338241895,
     666307205, 773529912, 1294757372, 1396182291,
     1695183700, 1986661051, 2177026350, 2456956037,
     2730485921, 2820302411, 3259730800, 3345764771,
     3516065817, 3600352804, 4094571909, 275423344,
     430227734, 506948616, 659060556, 883997877,
     958139571, 1322822218, 1537002063, 1747873779,
     1955562222, 2024104815, 2227730452, 2361852424,
     2428436474, 2756734187, 3204031479, 3329325298]

# Virtual byte j of the padded message (padding never materialized).
fn ah_padded_byte(data: [u8], data_len: i64, total_len: i64, j: i64) -> i64:
    if j < data_len:
        return data[j] as i64
    if j == data_len:
        return 128
    if j >= total_len - 8:
        val byte_from_lsb = total_len - 1 - j
        if byte_from_lsb == 0:
            return (data_len << 3) & 255
        return (data_len >> (byte_from_lsb * 8 - 3)) & 255
    0

# SHA-256 hex digest of a text payload. Digest-identical to sha256_text.
fn audit_sha256_hex(data: text) -> text:
    val raw = text_to_bytes(data)
    val data_len = raw.len()
    val block_count = (data_len + 9 + 63) / 64
    val total_len = block_count * 64
    val k = ah_k()

    var w: [i64] = []
    var zi = 0
    while zi < 64:
        w.push(0)
        zi = zi + 1

    var h0 = 1779033703
    var h1 = 3144134277
    var h2 = 1013904242
    var h3 = 2773480762
    var h4 = 1359893119
    var h5 = 2600822924
    var h6 = 528734635
    var h7 = 1541459225

    var blk = 0
    while blk < block_count:
        val base = blk * 64
        var i = 0
        while i < 16:
            val j = base + i * 4
            val b0 = ah_padded_byte(raw, data_len, total_len, j)
            val b1 = ah_padded_byte(raw, data_len, total_len, j + 1)
            val b2 = ah_padded_byte(raw, data_len, total_len, j + 2)
            val b3 = ah_padded_byte(raw, data_len, total_len, j + 3)
            w[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
            i = i + 1
        while i < 64:
            val w15 = w[i - 15]
            val w2 = w[i - 2]
            val s0 = ah_rotr32(w15, 7) ^ ah_rotr32(w15, 18) ^ (w15 >> 3)
            val s1 = ah_rotr32(w2, 17) ^ ah_rotr32(w2, 19) ^ (w2 >> 10)
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & AH_MASK32
            i = i + 1

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var hh = h7
        var t = 0
        while t < 64:
            val e1 = ah_rotr32(e, 6) ^ ah_rotr32(e, 11) ^ ah_rotr32(e, 25)
            val ch = (e & f) ^ (((e ^ AH_MASK32) & AH_MASK32) & g)
            val temp1 = (hh + e1 + ch + k[t] + w[t]) & AH_MASK32
            val e0 = ah_rotr32(a, 2) ^ ah_rotr32(a, 13) ^ ah_rotr32(a, 22)
            val maj = (a & b) ^ (a & c) ^ (b & c)
            val temp2 = (e0 + maj) & AH_MASK32
            hh = g
            g = f
            f = e
            e = (d + temp1) & AH_MASK32
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & AH_MASK32
            t = t + 1

        h0 = (h0 + a) & AH_MASK32
        h1 = (h1 + b) & AH_MASK32
        h2 = (h2 + c) & AH_MASK32
        h3 = (h3 + d) & AH_MASK32
        h4 = (h4 + e) & AH_MASK32
        h5 = (h5 + f) & AH_MASK32
        h6 = (h6 + g) & AH_MASK32
        h7 = (h7 + hh) & AH_MASK32
        blk = blk + 1

    val hex_digits = "0123456789abcdef"
    var digest: [i64] = [h0, h1, h2, h3, h4, h5, h6, h7]
    var out = ""
    var di = 0
    while di < 8:
        val v = digest[di]
        var shift = 28
        while shift >= 0:
            val nib = (v >> shift) & 15
            out = out + hex_digits.substring(nib, nib + 1)
            shift = shift - 4
        di = di + 1
    out

export audit_sha256_hex
