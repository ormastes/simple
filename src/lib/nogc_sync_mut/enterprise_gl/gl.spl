"""
# Enterprise General Ledger — balanced double-entry journal over the durable store

General-ledger vertical of the Simple Enterprise Suite over the durable
enterprise store, following the FROZEN foundation contracts
(`enterprise_sale/foundation.spl` is never edited). It complements the
`enterprise_finance/reporting.spl` trial balance by owning the WRITE side: a
guarded command posts a balanced journal entry, and pure folds prove the
account balances and the ledger-integrity invariant.

## The double-entry invariant (the core rule)

A journal entry is a set of lines, each touching one account on exactly one
side — a DEBIT or a CREDIT, never both, never neither. The entry is valid only
when `sum(debits) == sum(credits)` across all its lines. An UNBALANCED entry
(debits != credits) is a corrupt record and is DENIED with `invalid-record` —
a member of the frozen closed reason set; no new reason is added. So is an
entry with no lines, an empty entry id, a line with both sides zero, a line
with both sides nonzero, or any negative amount.

## Storage model (insert-only + pure fold)

Posted lines are insert-only rows in `gl_lines (tenant_id, entry_id, account,
debit_cents, credit_cents, posted_by)`. There is no UPDATE and no DELETE:
state is derived by PURE folds over the rows. `gl_account_balance` sums
`debit_cents - credit_cents` for one account; `gl_trial_balance` sums all
debits and all credits across every posted line. Both folds filter on the
session's authoritative tenant id — the per-tenant isolation seam, so tenant
B's ledger can never read tenant A's lines.

## Money

Integer minor units (cents) end to end — the folds are pure `i64` additions,
never floats, so the debits==credits comparison is exact.

## RBAC (reuse, not a new grant)

`gl_post` REUSES the existing `finance` role via the LOCAL `gl_role_allows`
gate for the `gl.journal.post` action. The frozen `role_allows` table is NOT
edited, and `enterprise_sale/rbac_registry.spl` is deliberately NOT touched.
The frozen session -> rbac -> validation -> idempotency -> effects SEQUENCE is
preserved exactly. Audit hashing goes only through `records.audit_append`
(the `enterprise_store.audit_hash.audit_sha256_hex` facade) — this module
never imports `std.common.crypto.sha256`.

Lane: .spipe/simple_enterprise_suite (W22-A).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema — insert-only journal lines
# =============================================================================

fn gl_setup(store: EnterpriseStore) -> bool:
    store_migrate(store, "gl_001_lines",
        "CREATE TABLE IF NOT EXISTS gl_lines (id INTEGER PRIMARY KEY, tenant_id TEXT, entry_id TEXT, account TEXT, debit_cents TEXT, credit_cents TEXT, posted_by TEXT)")

# =============================================================================
# RBAC — reuse the finance role (see module docstring)
# =============================================================================

# gl_role_allows gates journal posting. admin passes for everything (matching
# the frozen blanket rule); the finance role is REUSED for the ledger action.
fn gl_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "finance":
        return action == "gl.journal.post"
    false

# =============================================================================
# Journal line + entry validation
# =============================================================================

# One line of a journal entry: an account touched on exactly one side.
struct GlLine:
    account: text
    debit_cents: i64
    credit_cents: i64

# gl_line_well_formed: a line names an account, is non-negative on both sides,
# and has EXACTLY one nonzero side (a pure debit or a pure credit, never both,
# never neither).
fn gl_line_well_formed(line: GlLine) -> bool:
    if line.account == "":
        return false
    if line.debit_cents < 0 or line.credit_cents < 0:
        return false
    val d = line.debit_cents > 0
    val c = line.credit_cents > 0
    (d and not c) or (c and not d)

# gl_entry_balanced: every line is well formed, there is at least one line, and
# sum(debits) == sum(credits) across the entry. This is the double-entry
# invariant the guarded command enforces before any effect.
fn gl_entry_balanced(lines: [GlLine]) -> bool:
    if lines.len() == 0:
        return false
    var debits: i64 = 0
    var credits: i64 = 0
    for line in lines:
        if not gl_line_well_formed(line):
            return false
        debits = debits + line.debit_cents
        credits = credits + line.credit_cents
    debits == credits

# =============================================================================
# Pure reads — deterministic folds over the insert-only rows
# =============================================================================

# gl_account_balance_of folds every posted line for one account under one
# tenant and returns sum(debit_cents - credit_cents). A debit-normal account
# reads positive, a credit-normal account negative. Filters on tenant_id — the
# per-tenant isolation seam.
fn gl_account_balance_of(store: EnterpriseStore, tenant_id: text, account: text) -> i64:
    var bal: i64 = 0
    val rows = store_rows(store, "gl_lines", "id, tenant_id, entry_id, account, debit_cents, credit_cents, posted_by")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "account") == account:
            bal = bal + int(sqlite_row_get(row, "debit_cents")) - int(sqlite_row_get(row, "credit_cents"))
    bal

# gl_account_balance is the session-gated read (like the finance reports): an
# invalid session yields 0. Uses the session's authoritative tenant, so the
# fold can never cross tenants.
fn gl_account_balance(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, account: text) -> i64:
    if not session_valid(session, tenant, who):
        return 0
    gl_account_balance_of(store, session.tenant_id, account)

# GlTrialBalance is the folded ledger-integrity result across all posted lines
# for one tenant: total debits, total credits, and whether they are equal.
struct GlTrialBalance:
    debit_total: i64
    credit_total: i64
    balanced: bool

fn gl_trial_balance_of(store: EnterpriseStore, tenant_id: text) -> GlTrialBalance:
    var debits: i64 = 0
    var credits: i64 = 0
    val rows = store_rows(store, "gl_lines", "id, tenant_id, entry_id, account, debit_cents, credit_cents, posted_by")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id:
            debits = debits + int(sqlite_row_get(row, "debit_cents"))
            credits = credits + int(sqlite_row_get(row, "credit_cents"))
    GlTrialBalance(debit_total: debits, credit_total: credits, balanced: debits == credits)

# gl_trial_balance is the session-gated trial balance for the session's tenant.
# Because every posted entry is balanced (gl_post rejects otherwise), the total
# debits always equal the total credits — the ledger nets to zero. An invalid
# session yields an empty, trivially-balanced report.
fn gl_trial_balance(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext) -> GlTrialBalance:
    if not session_valid(session, tenant, who):
        return GlTrialBalance(debit_total: 0, credit_total: 0, balanced: true)
    gl_trial_balance_of(store, session.tenant_id)

# =============================================================================
# Guarded command (frozen sequence)
# =============================================================================

# gl_post records a balanced journal entry under the session's tenant. Runs the
# frozen sequence session -> rbac -> validation -> idempotency -> effects in one
# UoW. The CORE invariant sum(debits)==sum(credits) (and each line exactly one
# nonzero side) is validation rung 3: an unbalanced entry is denied
# `invalid-record`. All lines are inserted in a single unit of work — an
# all-or-nothing post. A replayed idempotency key returns the recorded result
# with no second effect.
fn gl_post(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, entry_id: text, lines: [GlLine]) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", entry_id)
    # 2. rbac (reuse finance/admin)
    if not gl_role_allows(who.role, "gl.journal.post"):
        return denied("forbidden", entry_id)
    # 3. domain validation — non-empty entry id AND the double-entry invariant.
    if entry_id == "":
        return denied("invalid-record", entry_id)
    if not gl_entry_balanced(lines):
        return denied("invalid-record", entry_id)
    # 4. idempotency — a replay returns the recorded outcome, no new effect.
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects — one unit of work, all lines or nothing
    val detail = entry_id + ":{lines.len()}"
    uow_begin(store)
    for line in lines:
        if not store_insert_row(store,
            "INSERT INTO gl_lines (tenant_id, entry_id, account, debit_cents, credit_cents, posted_by) VALUES (?, ?, ?, ?, ?, ?)",
            [tenant.tenant_id, entry_id, line.account, "{line.debit_cents}", "{line.credit_cents}", who.actor_id]):
            uow_rollback(store)
            return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "gl.journal.post", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "gl.journal.post", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

export gl_setup
export gl_role_allows
export GlLine, gl_line_well_formed, gl_entry_balanced
export gl_account_balance_of, gl_account_balance
export GlTrialBalance, gl_trial_balance_of, gl_trial_balance
export gl_post
