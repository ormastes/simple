# GPU memory-profile instrumentation skeleton (M7 remainder)
#
# Two pieces per the GPU section (§2) of
# doc/05_design/runtime/memory_analysis/gc_gpu_instrumentation_design.md:
#
#   1. run_under_compute_sanitizer — subprocess wrapper around the
#      `compute-sanitizer` CLI (memcheck/racecheck/initcheck), the exec
#      wrapper backing the `--mem-infra=gpu-sanitize` matrix row.
#   2. device_trace_to_memory_viz — serializes a `DeviceAllocEvent` trace
#      (the shape `DEVICE_ALLOCS` bookkeeping in gpu.rs would emit, once
#      wired) into a minimal, well-formed JSON snapshot.
#
# COMPATIBILITY NOTE: `device_trace_to_memory_viz` emits our own versioned
# schema ("simple-gpu-trace v1"), NOT a verified PyTorch `memory_viz`
# payload. The design doc does not specify memory_viz's minimal accepted
# shape, and no viewer test has been run against a real memory_viz build on
# a GPU machine. Do not treat this output as memory_viz-compatible until
# that viewer test is done — see the design doc's GPU section status line.

use std.nogc_sync_mut.io_runtime.{time_now_unix_micros}

use std.io_runtime.{process_run}

# ============================================================================
# Device live/peak byte counters — Simple-side surface over the kind-level
# DEVICE_LIVE_BYTES/DEVICE_PEAK_BYTES atomics landed at the rt_cuda_mem_alloc_fn/
# rt_cuda_mem_free_fn choke points
# (src/compiler_rust/compiler/src/interpreter_extern/gpu.rs).
#
# ALLOCATOR-AGNOSTIC BY CONSTRUCTION: the underlying externs are registered
# as `rt_gpu_mem_live_bytes`/`rt_gpu_mem_peak_bytes` (not `rt_cuda_*`), and
# the atomics they read are a single process-wide pair, not scoped to
# CUDA's driver API in name or shape. Today only the CUDA driver choke
# points (`cuMemAlloc_v2`/`cuMemFree_v2` wrappers) call the Rust-side
# `note_device_alloc`/`note_device_free`, so in practice these counters
# currently only move under a CUDA workload — but nothing about this
# Simple-side surface, or the atomics underneath it, is CUDA-specific.
#
# WHAT A HIP BACKEND WOULD STILL NEED (NOT implemented here — out of this
# module's ownership; requires src/compiler_rust changes by the owning
# lane, and this module must not be edited to make that claim for it):
#   1. HIP-side choke points (e.g. `rt_hip_mem_alloc_fn`/`rt_hip_mem_free_fn`
#      wrapping `hipMalloc`/`hipFree`) calling the SAME
#      `note_device_alloc`/`note_device_free` this module already reads
#      through `device_live_bytes()`/`device_peak_bytes()` below — once
#      that lands, no Simple-side change is needed for counters to start
#      reflecting HIP allocations too.
#   2. Per-backend attribution, if CUDA and HIP could ever run in the same
#      process: today's atomics are a single global pair with no vendor
#      tag, so a CUDA alloc and a HIP alloc would sum into the same
#      counter with no way to tell them apart. The `backend` parameter
#      threaded through `device_mem_report_tsv` and `run_under_gpu_sanitizer`
#      below anticipates this by carrying a caller-supplied tag at the
#      point of use — the atomics themselves would still need splitting
#      (or per-backend instances) to make that tag meaningful.
#   3. A HIP-side sanitizer/checker equivalent to `compute-sanitizer` — see
#      the NOTE on `run_under_gpu_sanitizer` for what is and is not known.
extern fn rt_gpu_mem_live_bytes() -> i64
extern fn rt_gpu_mem_peak_bytes() -> i64

pub fn device_live_bytes() -> i64:
    """Current live device-memory bytes, summed across whichever device
    allocator(s) call the shared `note_device_alloc`/`note_device_free`
    choke points (today: CUDA only — see the HIP-parity note above).

    Always 0 unless `SIMPLE_MEM_ATTR=1` was set for this process: the choke
    points are a documented no-op on the untracked path (same gate as the
    host-side `rt_mem_attr_enabled()` used by `src/lib/nogc_sync_mut/mem/dump.spl`),
    so calling this on a GPU-less or attribution-off host is a single
    relaxed atomic load that reads a counter nothing ever incremented."""
    rt_gpu_mem_live_bytes()

pub fn device_peak_bytes() -> i64:
    """High-water mark of `device_live_bytes()` since process start (or
    since `SIMPLE_MEM_ATTR` was enabled). Never decreases on a free — same
    peak-survives-free contract as the host-side attribution counters."""
    rt_gpu_mem_peak_bytes()

# ============================================================================
# compute-sanitizer exec wrapper
# ============================================================================

fn _which(name: text) -> text:
    """Locate a binary on PATH. Returns "" if not found or `which` fails."""
    val (stdout, _stderr, code) = process_run("which", [name])
    if code == 0:
        stdout.trim()
    else:
        ""

pub fn run_under_compute_sanitizer(tool: text, cmd: [text]) -> (text, text, i64):
    """Run `cmd` under `compute-sanitizer --tool <tool>`.

    `tool` is expected to be one of "memcheck", "racecheck", "initcheck"
    (any value the installed compute-sanitizer accepts is passed through
    verbatim, unvalidated here).

    If `compute-sanitizer` is not found on PATH, this does NOT fail hard:
    it returns a clear ("", "compute-sanitizer not found", 127) so callers
    on a GPU-less box can detect and report the condition instead of
    crashing.

    Args:
        tool: sanitizer tool name (passed to `--tool`)
        cmd: the command + args to run under the sanitizer, e.g.
             ["bin/release/x86_64-unknown-linux-gnu/simple", "run", "prog.spl"]

    Returns:
        (stdout, stderr, exit_code) of the sanitizer subprocess, or the
        127-path tuple above when compute-sanitizer is absent.
    """
    val sanitizer_path = _which("compute-sanitizer")
    if sanitizer_path == "":
        return ("", "compute-sanitizer not found", 127)
    var args: [text] = ["--tool", tool]
    for part in cmd:
        args.push(part)
    process_run(sanitizer_path, args)

pub fn run_under_gpu_sanitizer(backend: text, tool: text, cmd: [text]) -> (text, text, i64):
    """Backend-dispatching entry point over the sanitizer exec wrapper, so
    callers write one call site regardless of which GPU vendor they target.

    Only `backend == "cuda"` has a known, verified wrapper today — it
    delegates to `run_under_compute_sanitizer` above unchanged. Any other
    backend tag (including "hip") returns a clear, deterministic
    ("", "no sanitizer wrapper for backend '<backend>'", 127) rather than
    silently no-op'ing or guessing at an unverified binary name.

    NOTE on HIP: ROCm's memory-checking story is NOT the same shape as
    compute-sanitizer, so there is no drop-in `--tool memcheck`-style CLI
    wrapper to add here. Options that would need real investigation before
    a "hip" case could be wired in:
      (a) LLVM AddressSanitizer for HIP device code (`-fsanitize=address`
          at compile time, `HSA_XNACK=1` at run time on supported ROCm
          versions) — this changes how the TARGET BINARY is built, not
          just how it's launched, so it does not fit this wrapper's
          "run any external cmd unmodified" contract as-is.
      (b) `rocgdb` — interactive debugging, not a batch checker like
          compute-sanitizer.
    Neither has been verified against a real ROCm install (this development
    machine has no AMD GPU) — do not claim HIP sanitizer support anywhere
    beyond this note until one has been.
    """
    if backend == "cuda":
        return run_under_compute_sanitizer(tool, cmd)
    ("", "no sanitizer wrapper for backend '" + backend + "'", 127)

# ============================================================================
# Device alloc/free trace -> JSON snapshot
# ============================================================================

struct DeviceAllocEvent:
    """One device alloc or free event, as `DEVICE_ALLOCS` bookkeeping
    (design doc §2, gpu.rs choke points) would emit per call."""
    ts: i64
    owner: text
    ptr: i64
    bytes: i64
    kind: text  # "alloc" | "free"

fn _json_escape(s: text) -> text:
    var out = ""
    var i = 0
    while i < s.len():
        val ch = s.slice(i, i + 1)
        if ch == "\\":
            out = out + "\\\\"
        elif ch == "\"":
            out = out + "\\\""
        elif ch == "\n":
            out = out + "\\n"
        elif ch == "\r":
            out = out + "\\r"
        elif ch == "\t":
            out = out + "\\t"
        else:
            out = out + ch
        i = i + 1
    out

fn _event_to_json(ev: DeviceAllocEvent) -> text:
    "{\"ts\":" + ev.ts.to_text() +
        ",\"owner\":\"" + _json_escape(ev.owner) + "\"" +
        ",\"ptr\":" + ev.ptr.to_text() +
        ",\"bytes\":" + ev.bytes.to_text() +
        ",\"kind\":\"" + _json_escape(ev.kind) + "\"}"

pub fn device_trace_to_memory_viz(events: [DeviceAllocEvent]) -> text:
    """Serialize a device alloc/free trace to a minimal, well-formed,
    versioned JSON snapshot ("simple-gpu-trace v1").

    NOT verified against PyTorch's `memory_viz` tool — see the
    COMPATIBILITY NOTE at the top of this file.
    """
    var body = "{\"schema\":\"simple-gpu-trace\",\"version\":1,\"event_count\":" +
        events.len().to_text() + ",\"events\":["
    var i = 0
    while i < events.len():
        if i > 0:
            body = body + ","
        body = body + _event_to_json(events[i])
        i = i + 1
    body + "]}"

# ============================================================================
# Device memory snapshot -> TSV, host/device-diffable
# ============================================================================

pub fn device_mem_report_tsv(backend: text) -> text:
    """Device memory snapshot in the SAME line-tagged TSV vocabulary as
    `src/lib/nogc_sync_mut/mem/dump.spl`'s `mem_dump_tsv()` (versioned
    header line + `OWNER` rows), so a host snapshot and a device snapshot
    can be parsed, diffed, or merged by the exact same line-oriented
    tooling without a second parser.

    Emits exactly one `OWNER` row, shaped identically to a dump.spl OWNER
    row (`OWNER\\t{name}\\t{live}\\t{peak}\\t{allocs}`):
      - `name` is `"gpu:{backend}"` (e.g. "gpu:cuda", "gpu:hip") — `backend`
        is caller-supplied, not inferred (this module has no way to know
        which vendor driver produced the counters it is reading; see the
        HIP-parity note above `device_live_bytes`).
      - `live`/`peak` come straight from `device_live_bytes()`/
        `device_peak_bytes()`.
      - `allocs` is always `-1`, a sentinel meaning "not tracked at this
        choke point": the Rust-side `DEVICE_ALLOCS` map records live bytes
        per pointer but this module exposes no per-allocation *count*
        extern today (only the two byte-count atomics are wired). A
        diff/merge tool keyed on the `OWNER` tag can treat a device row
        exactly like a host attribution-owner row; only a caller that
        specifically wants an alloc *count* needs to special-case the -1.

    The header line uses its own schema tag (`simple-gpu-mem-snapshot`,
    distinct from dump.spl's `simple-mem-snapshot`) so a reader can tell
    which side produced a given file at a glance, while the row tags below
    it (`OWNER`) are byte-for-byte the same vocabulary.
    """
    val ts = time_now_unix_micros() / 1000000
    var out = "simple-gpu-mem-snapshot\tv1\t{ts}\n"
    val live = device_live_bytes()
    val peak = device_peak_bytes()
    out = out + "OWNER\tgpu:{backend}\t{live}\t{peak}\t-1\n"
    out
