# File URI spelling reaches the same shared filesystem boundary on every host.
use std.blink.url.url_parser.{percent_decode}
use std.nogc_sync_mut.io_runtime.{cwd}
use std.nogc_sync_mut.fs.host_path.{host_path_canonical}

pub fn lsp_file_uri_to_path(uri: text) -> text:
    if not uri.starts_with("file://"): return uri
    val path = percent_decode(uri.substring(7))
    # Standard drive URI /C:/... is a C:/... filesystem spelling. Preserve a
    # POSIX leading slash; this is URI grammar, not an app OS conditional.
    if path.len() >= 3 and path.starts_with("/") and path.substring(2, 3) == ":":
        val drive = path.byte_at(1)
        if (drive >= 65 and drive <= 90) or (drive >= 97 and drive <= 122):
            return path.substring(1)
    path

pub fn lsp_query_file_argument_v1(path: text) -> text:
    # Query visibility already restricts reads to its workspace-relative
    # surface. Express an exact current-workspace URI in that existing form;
    # do not weaken the query sanitizer for arbitrary absolute paths.
    val actual = host_path_canonical(path)
    val base = host_path_canonical(cwd())
    val prefix = if base.ends_with("/"): base else: base + "/"
    if actual.starts_with(prefix): return actual.substring(prefix.len())
    actual

export lsp_file_uri_to_path, lsp_query_file_argument_v1
