# Admission before the existing recursive typed JSON parser. This scanner
# only enforces resource limits; the parser remains the syntax authority.
pub fn lsp_json_payload_error_v1(payload: text, max_bytes: i64) -> text:
    if payload.byte_len() > max_bytes: return "JSON byte limit"
    var depth = 0
    var nodes = 0
    var quoted = false
    var escaped = false
    var index = 0
    while index < payload.byte_len():
        val byte = payload.byte_at(index)
        if quoted:
            if escaped:
                escaped = false
            elif byte == 92:
                escaped = true
            elif byte == 34:
                quoted = false
        elif byte == 34:
            quoted = true
            nodes = nodes + 1
        elif byte == 91 or byte == 123:
            depth = depth + 1
            nodes = nodes + 1
            if depth > 64: return "JSON nesting limit"
        elif byte == 93 or byte == 125:
            depth = depth - 1
            if depth < 0: return "JSON unbalanced collection"
        elif byte == 44:
            nodes = nodes + 1
        if nodes > 100000: return "JSON node limit"
        index = index + 1
    if quoted or escaped or depth != 0: return "JSON incomplete value"
    ""

export lsp_json_payload_error_v1
