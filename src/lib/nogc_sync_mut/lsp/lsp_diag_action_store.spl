# Per-URI fix-candidate store fed by the last publishDiagnostics batch
# (REQ-DIAG-011). The live codeAction handler answers from this store when it
# holds candidates for the editor's CURRENT document version; any other
# version is stale and is never served.
use std.common.diagnostics.diagnostic_batch.{DiagnosticActionIndex}

struct LspDiagActionEntry:
    uri: text
    version: i64
    source_hash: text
    index: DiagnosticActionIndex
    ids: [text]

var LSP_DIAG_ACTION_ENTRIES: [LspDiagActionEntry] = []

# Replace the entry for `uri` with the batch published at `version`.
pub fn lsp_diag_action_store_record(uri: text, version: i64, source_hash: text, index: DiagnosticActionIndex, ids: [text]):
    lsp_diag_action_store_clear(uri)
    LSP_DIAG_ACTION_ENTRIES.push(LspDiagActionEntry(uri: uri, version: version, source_hash: source_hash, index: index, ids: ids))

pub fn lsp_diag_action_store_clear(uri: text):
    var kept: [LspDiagActionEntry] = []
    for e in LSP_DIAG_ACTION_ENTRIES:
        if e.uri != uri:
            kept.push(e)
    LSP_DIAG_ACTION_ENTRIES = kept

# The entry for `uri` only when it was recorded at exactly `version`.
pub fn lsp_diag_action_store_lookup(uri: text, version: i64) -> LspDiagActionEntry?:
    for e in LSP_DIAG_ACTION_ENTRIES:
        if e.uri == uri and e.version == version:
            return Some(e)
    None

export LspDiagActionEntry
