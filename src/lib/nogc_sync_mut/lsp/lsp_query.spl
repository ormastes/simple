# LSP Query Runner - Lightweight query script for LSP internal use
# Only imports lightweight query helpers and visibility adapters — NO compiler imports.
# Startup: <1s vs 30s+ for full query.spl
#
# Usage: simple lsp_query.spl <subcmd> <file> [line] [col]
# Subcommands: definition, references, hover, completions, symbols,
#              type-at, signature-help, document-highlight, type-definition,
#              implementation, folding-range

use std.io_runtime.{get_args}
use std.nogc_sync_mut.lsp.lsp_query_symbol.{lsp_query_symbol_at_v1}

use app.cli.query_engine.{engine_find_definition, engine_find_references, engine_hover, engine_completions, engine_type_at, engine_signature_help}
use app.cli.query_sanitize.{sanitize_path, sanitize_symbol}
use app.cli.query_visibility.{query_visibility_symbols}
use app.cli.query_lsp_extras.{query_document_highlight, query_type_definition, query_implementation, query_folding_range}

fn lsp_query_main() -> i64:
    val all_args = get_args()
    var args: [text] = []
    var start_idx = 0
    if all_args.len() >= 2 and all_args[1].ends_with(".spl"):
        start_idx = 2
    elif all_args.len() >= 1 and all_args[0].ends_with(".spl"):
        start_idx = 1
    var i = 0
    for arg in all_args:
        if i >= start_idx:
            args.push(arg)
        i = i + 1

    if args.len() == 0:
        print "Usage: lsp_query.spl <subcmd> <file> [line] [col]"
        return 1

    val subcmd = args[0]

    # File-only subcommands
    if subcmd == "symbols" and args.len() >= 2:
        val file = sanitize_path(args[1])
        if file == "":
            return 1
        return query_visibility_symbols(file=file, requester_file=file)
    if subcmd == "folding-range" and args.len() >= 2:
        val file = sanitize_path(args[1])
        if file == "":
            return 1
        return query_folding_range(file)

    # Subcommands needing file + line + optional col
    if args.len() < 3:
        print "Error: {subcmd} requires <file> <line> [col]"
        return 1

    val file = sanitize_path(args[1])
    if file == "":
        return 1
    val line_num = args[2].to_int() ?? 0
    var col = 0
    if args.len() > 3 and not args[3].starts_with("--"):
        col = args[3].to_int() ?? 0

    val symbol = lsp_query_symbol_at_v1(file, line_num, col)
    if symbol == "":
        print "No symbol found at {file}:{line_num}"
        return 1

    val clean_sym = sanitize_symbol(symbol)
    if clean_sym == "":
        return 1

    if subcmd == "definition":
        return engine_find_definition(file=file, symbol=clean_sym)
    elif subcmd == "references":
        return engine_find_references(file=file, symbol=clean_sym)
    elif subcmd == "hover":
        return engine_hover(file=file, line_num=line_num, symbol=clean_sym)
    elif subcmd == "completions":
        return engine_completions(file=file, line_num=0, prefix=clean_sym)
    elif subcmd == "type-at":
        return engine_type_at(file=file, line_num=line_num, symbol=clean_sym)
    elif subcmd == "signature-help":
        return engine_signature_help(file=file, line_num=line_num, col=col, symbol=clean_sym)
    elif subcmd == "document-highlight":
        return query_document_highlight(file=file, line_num=line_num, col=col)
    elif subcmd == "type-definition":
        return query_type_definition(file=file, line_num=line_num, col=col)
    elif subcmd == "implementation":
        return query_implementation(file=file, line_num=line_num, col=col)
    else:
        print "Unknown subcmd: {subcmd}"
        return 1

lsp_query_main()
