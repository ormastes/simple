# REQ-LSPVIS-008: Track whether client supports structured visibility metadata.
# Set during initialize from client capabilities.experimental.simpleVisibility.
var CLIENT_SUPPORTS_VISIBILITY: bool = false
# Set by `initialize`; unsolicited publishDiagnostics (didChange) only flow in
# an initialized session, so pre-handshake notifications never spawn a check.
var LSP_SESSION_INITIALIZED: bool = false
var LSP_OVERLAY_STAGE_NONCE: i64 = 0
var LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS: [text] = []
# MDSOC+ session view (REQ-PUBVIEW-008, 010..012): one immutable value replaced on
# every request; public = per-file default (public
# inside an __init__.spl boundary, all for an open module). Private views
# auto-revert after SIMPLE_VISIBILITY_AUTO_REVERT (default 3) requests.
var LSP_VISIBILITY_SESSION_READY: bool = false
var LSP_VISIBILITY_SESSION: SourceVisibilitySessionV1 = SourceVisibilitySessionV1("public", "", "", 0, 3, "")

fn _lsp_visibility_provider_missing_v1(request: LspVisibilityQueryRequestV1, reader: LspVisibilitySourceReaderV1) -> LspVisibilityQueryResultV1:
    LspVisibilityQueryResultV1(LspVisibilityQueryStatusV1.Pending, "",
        "resident visibility provider is not installed", request.snapshot.overlay_generation, [])

var LSP_VISIBILITY_QUERY_PROVIDER_V1: LspVisibilityQueryProviderV1 =
    LspVisibilityQueryProviderV1(_lsp_visibility_provider_missing_v1)

pub fn lsp_set_visibility_query_provider_v1(provider: LspVisibilityQueryProviderV1):
    LSP_VISIBILITY_QUERY_PROVIDER_V1 = provider

fn client_supports_visibility() -> bool:
    CLIENT_SUPPORTS_VISIBILITY

fn _find_simple_binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "":
        return env_bin
    val os_env = env_get("OS") ?? ""
    if os_env.contains("Windows"):
        if file_exists("bin/simple.exe"):
            return "bin/simple.exe"
        if file_exists("bin/release/x86_64-pc-windows-msvc/simple.exe"):
            return "bin/release/x86_64-pc-windows-msvc/simple.exe"
        if file_exists("bin/release/x86_64-pc-windows-gnu/simple.exe"):
            return "bin/release/x86_64-pc-windows-gnu/simple.exe"
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

fn lsp_extract_query_json_payload(output: text) -> text:
    """Return the last complete JSON object/array emitted by a query child.

    Bootstrap binaries may write diagnostics to stdout before the query
    payload. Those diagnostics must never be embedded in an LSP result.
    """
    var payload = ""
    for line in output.split("\n"):
        val trimmed = line.trim()
        val is_object = trimmed.starts_with("{") and trimmed.ends_with("}")
        val is_array = trimmed.starts_with("[") and trimmed.ends_with("]")
        if is_object or is_array:
            payload = trimmed
    payload

fn _extract_uri(body: text) -> text:
    val td_search = Q() + "textDocument" + Q() + ":"
    val td_idx = body.index_of(td_search)
    if td_idx < 0:
        return ""
    val td_start = td_idx + td_search.len()
    val td_rest = body.substring(td_start)
    extract_field(json=td_rest, key="uri")

fn _uri_to_path(uri: text) -> text:
    lsp_file_uri_to_path(uri)

fn _extract_line(body: text) -> text:
    val pos_search = Q() + "position" + Q() + ":"
    val pos_idx = body.index_of(pos_search)
    if pos_idx < 0:
        return "0"
    val pos_start = pos_idx + pos_search.len()
    val pos_rest = body.substring(pos_start)
    val line_str = extract_field(json=pos_rest, key="line")
    if line_str == "":
        return "0"
    line_str

fn _extract_character(body: text) -> text:
    val pos_search = Q() + "position" + Q() + ":"
    val pos_idx = body.index_of(pos_search)
    if pos_idx < 0:
        return "0"
    val pos_start = pos_idx + pos_search.len()
    val pos_rest = body.substring(pos_start)
    val char_str = extract_field(json=pos_rest, key="character")
    if char_str == "":
        return "0"
    char_str

# --- Initialize ---

fn lsp_handle_initialize(id: text) -> text:
    lsp_handle_initialize_with_body(id=id, body="")

fn lsp_handle_initialize_with_body(id: text, body: text) -> text:
    LSP_SESSION_INITIALIZED = true
    val init_client_id = lsp_extract_client_id_v1(body)
    lsp_set_client_code_action_caps_for_client_v1(init_client_id, lsp_negotiate_client_code_action_caps_v1(body))
    val init_options = extract_nested(json=body, key="initializationOptions")
    if init_options != "" and init_options.contains("visibility"):
        val requested = extract_field(json=init_options, key="visibility")
        if lsp_visibility_level_known(requested):
            LSP_VISIBILITY_SESSION = source_visibility_session_set_v1(lsp_visibility_session(), requested, "", "")
    # REQ-LSPVIS-008: Read client experimental.simpleVisibility capability
    if body != "":
        val experimental_raw = extract_nested(json=body, key="experimental")
        if experimental_raw != "" and experimental_raw.contains("simpleVisibility"):
            CLIENT_SUPPORTS_VISIBILITY = true
    val completion_provider = jo1(jp("triggerCharacters", SB_L() + js(".") + "," + js(":") + "," + js("&") + SB_R()))
    var caps: [text] = []
    val sync_opts = jo3(jp("openClose", "true"), jp("change", "1"), jp("save", jo1(jp("includeText", "false"))))
    val token_types = SB_L() + js("namespace") + "," + js("type") + "," + js("class") + "," + js("enum") + "," + js("struct") + "," + js("function") + "," + js("method") + "," + js("property") + "," + js("variable") + "," + js("parameter") + "," + js("enumMember") + "," + js("keyword") + "," + js("comment") + "," + js("string") + "," + js("number") + "," + js("operator") + SB_R()
    val token_mods = SB_L() + js("declaration") + "," + js("definition") + "," + js("readonly") + "," + js("static") + "," + js("deprecated") + "," + js("abstract") + "," + js("async") + "," + js("modification") + "," + js("documentation") + "," + js("visibilityPublic") + "," + js("visibilityBoundary") + "," + js("visibilityPrivate") + SB_R()
    val semantic_provider = jo3(jp("legend", jo2(jp("tokenTypes", token_types), jp("tokenModifiers", token_mods))), jp("range", "true"), jp("full", "true"))
    caps.push(jp("textDocumentSync", sync_opts))
    caps.push(jp("completionProvider", completion_provider))
    caps.push(jp("hoverProvider", "true"))
    caps.push(jp("definitionProvider", "true"))
    caps.push(jp("referencesProvider", "true"))
    caps.push(jp("renameProvider", "true"))
    caps.push(jp("documentFormattingProvider", "true"))
    caps.push(jp("documentSymbolProvider", "true"))
    caps.push(jp("semanticTokensProvider", semantic_provider))
    caps.push(jp("implementationProvider", "true"))
    caps.push(jp("workspaceSymbolProvider", "true"))
    caps.push(jp("callHierarchyProvider", "true"))
    caps.push(jp("inlayHintProvider", "true"))
    val code_action_kinds = SB_L() + js("quickfix") + "," + js("refactor") + "," + js("refactor.rewrite") + SB_R()
    caps.push(jp("codeActionProvider", jo2(jp("codeActionKinds", code_action_kinds), jp("resolveProvider", "true"))))
    val diag_provider = jo2(jp("interFileDependencies", "false"), jp("workspaceDiagnostics", "false"))
    caps.push(jp("diagnosticProvider", diag_provider))
    caps.push(jp("executeCommandProvider", jo1(jp("commands", SB_L() + js("simple.setVisibility") + SB_R()))))
    val capabilities_obj = LB() + caps.join(",") + RB()
    val server_info = jo2(jp("name", js("simple-lsp")), jp("version", js("0.1.0")))
    val experimental = jo1(jp("simpleVisibilityProvider", "true"))
    val result = jo3(jp("capabilities", capabilities_obj), jp("serverInfo", server_info), jp("experimental", experimental))
    make_json_result(id=id, result=result)

# --- Document sync ---

# reason: handles LSP didOpen JSON-RPC notification payload
@allow(primitive_api)
pub fn lsp_handle_did_open(body: text):
    val client_id = lsp_extract_client_id_v1(body)
    if not lsp_document_sync_apply_for_client_v1(client_id, "textDocument/didOpen", body): return
    # Existing diagnostics are disk-backed, so do not label them as results
    # for an unsaved editor overlay retained by the canonical owner.
    val uri = lsp_document_sync_uri(body)
    val snapshot = lsp_document_snapshot_for_client_v1(client_id, uri)
    if not snapshot.?: return
    val file_path = _uri_to_path(uri)
    val source = lsp_read_analyzed_source(file_path)
    if source.is_err() or source.unwrap() != snapshot.unwrap().content: return
    if uri != "" and file_path != "":
        _publish_diagnostics_for_client(client_id, uri, file_path)

# reason: handles LSP didChange JSON-RPC notification payload
@allow(primitive_api)
pub fn lsp_handle_did_change(body: text):
    val client_id = lsp_extract_client_id_v1(body)
    if not lsp_document_sync_apply_for_client_v1(client_id, "textDocument/didChange", body): return
    # REQ-DIAG-006: an accepted change re-analyzes the LATEST unsaved text.
    # A rejected (stale/malformed) change publishes nothing: the owner kept
    # the previous authority and its diagnostics stay valid.
    if not LSP_SESSION_INITIALIZED: return
    val uri = lsp_document_sync_uri(body)
    val file_path = _uri_to_path(uri)
    if uri == "" or file_path == "": return
    val (batch, current) = lsp_diagnostics_for_uri_for_client_v1(client_id, uri, file_path)
    # Never publish stale, failed, timed-out, or malformed batches.
    val _ = lsp_publish_batch_for_client_v1(client_id, uri, batch, current)

# reason: handles LSP didClose JSON-RPC notification payload
@allow(primitive_api)
pub fn lsp_handle_did_close(body: text):
    val client_id = lsp_extract_client_id_v1(body)
    if not lsp_document_sync_apply_for_client_v1(client_id, "textDocument/didClose", body): return
    val uri = lsp_document_sync_uri(body)
    lsp_diag_action_store_clear_for_client_v1(client_id, uri)
    if uri != "":
        val params = jo2(jp("uri", js(uri)), jp("diagnostics", SB_L() + SB_R()))
        lsp_write_notification(method="textDocument/publishDiagnostics", params=params)

fn lsp_handle_did_save(body: text):
    val client_id = lsp_extract_client_id_v1(body)
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if uri != "" and file_path != "":
        _publish_diagnostics_for_client(client_id, uri, file_path)

# --- Diagnostics (heavy — uses full query.spl with compiler) ---

# reason: returns recorded publishDiagnostics notification payloads for observability
@allow(primitive_api)
pub fn lsp_published_diagnostic_notifications_v1() -> [text]:
    LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS

pub fn lsp_clear_published_diagnostic_notifications_v1():
    LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS = []

fn _record_published_notification(params: text):
    if LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS.len() >= 64:
        var trimmed: [text] = []
        var i = 1
        while i < LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS.len():
            trimmed.push(LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS[i])
            i = i + 1
        LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS = trimmed
    LSP_PUBLISHED_DIAGNOSTIC_NOTIFICATIONS.push(params)

fn _publish_diagnostics_for_client(client_id: text, uri: text, file_path: text):
    val (batch, current) = lsp_diagnostics_for_uri_for_client_v1(client_id, uri, file_path)
    val _ = lsp_publish_batch_for_client_v1(client_id, uri, batch, current)

fn _publish_diagnostics(uri: text, file_path: text):
    _publish_diagnostics_for_client("default", uri, file_path)

fn _build_batch_file_revisions(
    client_id: text,
    primary_file: text,
    primary_version: i64,
    primary_hash: text,
    batch: LspCheckBatchV1
) -> [LspDiagActionFileRevV1]:
    var revs: [LspDiagActionFileRevV1] = []
    if primary_file != "":
        revs.push(LspDiagActionFileRevV1(
            file: primary_file,
            version: primary_version,
            source_hash: primary_hash,
            from_overlay: primary_version >= 0
        ))
    var seen: [text] = [primary_file]
    for id in batch.ids:
        for c in batch.index.candidates_for(id):
            for sec in c.affected_files():
                if not seen.contains(sec):
                    seen.push(sec)
                    match lsp_document_snapshot_by_path_for_client_v1(client_id, sec):
                        Some(sec_snap):
                            revs.push(LspDiagActionFileRevV1(
                                file: sec,
                                version: sec_snap.version,
                                source_hash: sha256_text(sec_snap.content),
                                from_overlay: true
                            ))
                        None:
                            match lsp_read_analyzed_source(sec):
                                Ok(sec_disk):
                                    revs.push(LspDiagActionFileRevV1(
                                        file: sec,
                                        version: -1,
                                        source_hash: sha256_text(sec_disk),
                                        from_overlay: false
                                    ))
                                Err(_):
                                    pass
            for p in c.preconditions:
                if not seen.contains(p.file):
                    seen.push(p.file)
                    match lsp_document_snapshot_by_path_for_client_v1(client_id, p.file):
                        Some(sec_snap):
                            revs.push(LspDiagActionFileRevV1(
                                file: p.file,
                                version: sec_snap.version,
                                source_hash: sha256_text(sec_snap.content),
                                from_overlay: true
                            ))
                        None:
                            match lsp_read_analyzed_source(p.file):
                                Ok(sec_disk):
                                    revs.push(LspDiagActionFileRevV1(
                                        file: p.file,
                                        version: -1,
                                        source_hash: sha256_text(sec_disk),
                                        from_overlay: false
                                    ))
                                Err(_):
                                    pass
    revs

# reason: records complete diagnostic batch and SHA-256 file revisions for client_id and URI
@allow(primitive_api)
pub fn lsp_diag_record_batch_for_client_v1(client_id: text, uri: text, batch: LspCheckBatchV1):
    if not batch.valid or batch.status != "complete":
        return
    val primary_path = _uri_to_path(uri)
    val snap = lsp_document_snapshot_for_client_v1(client_id, uri)
    if not snap.?:
        if primary_path != "":
            match lsp_read_analyzed_source(primary_path):
                Ok(disk_src):
                    val disk_hash = if batch.source_hash != "": batch.source_hash else: sha256_text(disk_src)
                    val revs = _build_batch_file_revisions(client_id, primary_path, -1, disk_hash, batch)
                    lsp_diag_action_store_record_perf_for_client_v1(
                        client_id, uri, -1, disk_hash, batch.status, batch.valid,
                        batch.items, batch.index, batch.ids, revs,
                        batch.semantic_fingerprint, batch.semantic_fingerprint,
                        batch.obligations_summary, batch.resource_tradeoff, batch.candidate_meta
                    )
                Err(_):
                    lsp_diag_action_store_clear_for_client_v1(client_id, uri)
        else:
            lsp_diag_action_store_clear_for_client_v1(client_id, uri)
        return
    val s = snap.unwrap()
    val snap_hash = sha256_text(s.content)
    val revs = _build_batch_file_revisions(client_id, primary_path, s.version, snap_hash, batch)
    lsp_diag_action_store_record_perf_for_client_v1(
        client_id, uri, s.version, snap_hash, batch.status, batch.valid,
        batch.items, batch.index, batch.ids, revs,
        batch.semantic_fingerprint, batch.semantic_fingerprint,
        batch.obligations_summary, batch.resource_tradeoff, batch.candidate_meta
    )

# Each published batch replaces the URI's fix-candidate store entry, so the
# live codeAction path never serves candidates from an older batch.
# reason: records complete diagnostic batch and SHA-256 file revisions for default client and URI
@allow(primitive_api)
pub fn lsp_diag_record_batch_v1(uri: text, batch: LspCheckBatchV1):
    lsp_diag_record_batch_for_client_v1("default", uri, batch)

# reason: publishes a complete current diagnostic batch for client_id and suppresses invalid or stale batches
@allow(primitive_api)
pub fn lsp_publish_batch_for_client_v1(client_id: text, uri: text, batch: LspCheckBatchV1, current: bool) -> bool:
    if not current or not batch.valid or batch.status != "complete":
        return false
    lsp_diag_record_batch_for_client_v1(client_id, uri, batch)
    val diags_str = SB_L() + batch.items.join(",") + SB_R()
    val params = jo2(jp("uri", js(uri)), jp("diagnostics", diags_str))
    _record_published_notification(params)
    lsp_write_notification(method="textDocument/publishDiagnostics", params=params)
    true

fn _publish_items(uri: text, batch: LspCheckBatchV1):
    val _ = lsp_publish_batch_for_client_v1("default", uri, batch, true)

# --- Unsaved-overlay analysis source (REQ-DIAG-006) ---
pub struct LspDiagnosticsSourceV1:
    client_id: text = "default"
    uri: text
    path: text          # path handed to `check`
    staged: bool        # path is a temp overlay copy that must be released
    overlay: bool       # analysis reflects unsaved editor text
    version: i64        # snapshot version (-1 when no snapshot)
    generation: i64     # snapshot lifetime generation (-1 when no snapshot)
    source_hash: text = ""

fn _sanitize_client_id_for_filename(client_id: text) -> text:
    val trimmed = client_id.trim()
    if trimmed == "":
        return "default"
    var parts: [text] = []
    for ch in trimmed.chars():
        val ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "-" or ch == "_"
        parts.push(if ok: ch else: "_")
    parts.join("")

fn _next_overlay_stage_nonce() -> i64:
    LSP_OVERLAY_STAGE_NONCE = LSP_OVERLAY_STAGE_NONCE + 1
    LSP_OVERLAY_STAGE_NONCE

# reason: stages client_id unsaved overlay into collision-free temp file with client_id and monotonic nonce
@allow(primitive_api)
pub fn lsp_diagnostics_stage_source_for_client_v1(client_id: text, uri: text, file_path: text) -> LspDiagnosticsSourceV1:
    val norm_client = if client_id.trim() == "": "default" else: client_id.trim()
    val snapshot = lsp_document_snapshot_for_client_v1(norm_client, uri)
    if not snapshot.?:
        var disk_hash = ""
        match lsp_read_analyzed_source(file_path):
            Ok(disk_src): disk_hash = sha256_text(disk_src)
            Err(_): pass
        return LspDiagnosticsSourceV1(client_id: norm_client, uri: uri, path: file_path, staged: false, overlay: false, version: -1, generation: -1, source_hash: disk_hash)
    val snap = snapshot.unwrap()
    val snap_hash = sha256_text(snap.content)
    val disk = lsp_read_analyzed_source(file_path)
    if disk.is_ok() and disk.unwrap() == snap.content:
        return LspDiagnosticsSourceV1(client_id: norm_client, uri: uri, path: file_path, staged: false, overlay: false, version: snap.version, generation: snap.lifetime_generation, source_hash: snap_hash)
    val safe_client = _sanitize_client_id_for_filename(norm_client)
    val nonce = _next_overlay_stage_nonce()
    val staged_path = get_temp_dir() + "/simple_lsp_overlay_" + safe_client + "_" + str(nonce) + "_" + str(time_now_unix_micros()) + ".spl"
    if not write_file(staged_path, snap.content):
        return LspDiagnosticsSourceV1(client_id: norm_client, uri: uri, path: "", staged: false, overlay: true, version: snap.version, generation: snap.lifetime_generation, source_hash: snap_hash)
    LspDiagnosticsSourceV1(client_id: norm_client, uri: uri, path: staged_path, staged: true, overlay: true, version: snap.version, generation: snap.lifetime_generation, source_hash: snap_hash)

# reason: stages default-client unsaved overlay for diagnostics analysis
@allow(primitive_api)
pub fn lsp_diagnostics_stage_source_v1(uri: text, file_path: text) -> LspDiagnosticsSourceV1:
    lsp_diagnostics_stage_source_for_client_v1("default", uri, file_path)

pub fn lsp_diagnostics_release_source_v1(source: LspDiagnosticsSourceV1):
    if source.staged and source.path != "":
        val _ = file_delete(source.path)

# True while the editor still owns exactly the snapshot this source was staged
# from; false once a newer version (or a close/reopen) superseded it.
# reason: checks whether staged diagnostics source still matches client's current document snapshot
@allow(primitive_api)
pub fn lsp_diagnostics_source_is_current_v1(source: LspDiagnosticsSourceV1) -> bool:
    val snapshot = lsp_document_snapshot_for_client_v1(source.client_id, source.uri)
    if not snapshot.?:
        if source.version >= 0:
            return false
        if source.source_hash == "" or source.path == "":
            return true
        val disk = lsp_read_analyzed_source(source.path)
        return disk.is_ok() and sha256_text(disk.unwrap()) == source.source_hash
    if source.version < 0:
        return false
    val snap = snapshot.unwrap()
    snap.version == source.version and snap.lifetime_generation == source.generation

# reason: collects diagnostics batch and currency verdict isolated to client_id
@allow(primitive_api)
pub fn lsp_diagnostics_for_uri_for_client_v1(client_id: text, uri: text, file_path: text) -> (LspCheckBatchV1, bool):
    val source = lsp_diagnostics_stage_source_for_client_v1(client_id, uri, file_path)
    if source.path == "":
        val failed_stage = LspCheckBatchV1(
            items: [],
            index: DiagnosticActionIndex.new(),
            ids: [],
            valid: false,
            status: "failed",
            incomplete_reason: "failed to stage unsaved overlay source",
            source_hash: source.source_hash,
            scope: "document",
            target: file_path,
            policy_digest: "default"
        )
        return (failed_stage, false)
    var batch = _collect_diagnostics_with_hash(source.path, file_path, source.version, source.source_hash)
    lsp_diagnostics_release_source_v1(source)
    val current = lsp_diagnostics_source_is_current_v1(source)
    if not current:
        batch.valid = false
        batch.status = "stale"
        batch.incomplete_reason = "document snapshot changed during analysis"
    (batch, current)

# Diagnostics for a URI from the latest unsaved text (or disk when the editor
# holds none / the same bytes). The bool is false when the snapshot changed
# while the analysis ran, i.e. the items are obsolete and must not be published.
# reason: collects diagnostics batch and currency verdict for default client
@allow(primitive_api)
pub fn lsp_diagnostics_for_uri_v1(uri: text, file_path: text) -> (LspCheckBatchV1, bool):
    lsp_diagnostics_for_uri_for_client_v1("default", uri, file_path)

# One parsed diagnostics batch: LSP diagnostic JSON items, fix candidates,
# and explicit completion/validity metadata (REQ-DIAG-006, ED-T07).
pub struct LspCheckBatchV1:
    items: [text]
    index: DiagnosticActionIndex
    ids: [text]
    valid: bool = true
    status: text = "complete"
    incomplete_reason: text = ""
    source_hash: text = ""
    scope: text = "document"
    target: text = ""
    policy_digest: text = "default"
    semantic_fingerprint: text = ""
    obligations_summary: [text] = []
    resource_tradeoff: text = ""
    candidate_meta: [LspDiagActionCandidateMetaV1] = []

impl LspCheckBatchV1:
    fn len() -> i64:
        self.items.len()

    fn join(sep: text) -> text:
        self.items.join(sep)

    fn is_publishable() -> bool:
        self.valid and self.status == "complete"

fn _invalid_check_batch(status: text, reason: text, target: text, source_hash: text) -> LspCheckBatchV1:
    LspCheckBatchV1(
        items: [],
        index: DiagnosticActionIndex.new(),
        ids: [],
        valid: false,
        status: status,
        incomplete_reason: reason,
        source_hash: source_hash,
        scope: "document",
        target: target,
        policy_digest: "default"
    )

fn _normalize_batch_status_name(raw_status: text) -> (bool, text):
    if raw_status == "" or raw_status == "complete":
        return (true, "complete")
    if raw_status == "stale":
        return (false, "stale")
    if raw_status == "timed_out":
        return (false, "timed_out")
    if raw_status == "malformed":
        return (false, "malformed")
    if raw_status == "failed" or raw_status == "internal_error":
        return (false, "failed")
    if raw_status == "unavailable" or raw_status == "unsupported":
        return (false, "unavailable")
    (false, "incomplete")

fn _json_int_field(v: JsonValue, key: text) -> i64:
    match json_value_get(v, key):
        Some(x): json_value_as_i64(x) ?? 0
        None: 0

fn _fix_confidence(name: text) -> DiagnosticFixConfidence:
    if name == "safe": return DiagnosticFixConfidence.Safe
    if name == "likely": return DiagnosticFixConfidence.Likely
    DiagnosticFixConfidence.Uncertain

fn _json_span(v: JsonValue) -> Span:
    val s = json_value_field(v, "span")
    Span.new(_json_int_field(s, "start"), _json_int_field(s, "end"), _json_int_field(s, "line"), _json_int_field(s, "col"))

fn _resolve_candidate_file(raw_file: text, analyzed_file: text, fix_file: text) -> text:
    if raw_file == "":
        return fix_file
    if analyzed_file != "" and (raw_file == analyzed_file or raw_file.replace("\\", "/") == analyzed_file.replace("\\", "/")):
        return fix_file
    raw_file

fn _extract_obligations_summary(fix: JsonValue) -> ([text], [text]):
    var summaries: [text] = []
    var unmet_reasons: [text] = []
    for ob in json_value_items(json_value_field(fix, "obligations")):
        val kind = json_value_text_or(json_value_field(ob, "kind"), "obligation")
        val reason = json_value_text_or(json_value_field(ob, "reason"), "")
        var discharged = true
        match json_value_as_bool(json_value_field(ob, "discharged")):
            case Some(flag): discharged = flag
            case None: pass
        val status_word = if discharged: "verified" else: "unmet"
        val entry_str = if reason != "": kind + " (" + status_word + "): " + reason else: kind + " (" + status_word + ")"
        summaries.push(entry_str)
        if not discharged and reason != "":
            unmet_reasons.push(reason)
    (summaries, unmet_reasons)

# A `fixes[]` entry (ranked DiagnosticFix shape) as a FixCandidate preserving
# per-replacement target `"file"` and explicit `"preconditions"`.
fn _fix_candidate_from_json_staged(fix: JsonValue, analyzed_file: text, fix_file: text, version: i64) -> FixCandidate:
    val id = json_value_text_or(json_value_field(fix, "id"), "")
    val desc = json_value_text_or(json_value_field(fix, "description"), "")
    val raw_title = json_value_text_or(json_value_field(fix, "title"), "")
    val title = if raw_title != "": raw_title else: desc
    var c = FixCandidate.new(
        id,
        title,
        desc,
        _fix_confidence(json_value_text_or(json_value_field(fix, "confidence"), "")),
        version
    )
    val dis_reason = json_value_text_or(json_value_field(fix, "disabled_reason"), "")
    val applicability = json_value_text_or(json_value_field(fix, "applicability"), "")
    val (_obs_summary, unmet_obs) = _extract_obligations_summary(fix)
    if dis_reason != "":
        c = c.disabled(dis_reason)
    elif applicability == "unavailable" or applicability == "Unavailable":
        val synth_reason = if unmet_obs.len() > 0: unmet_obs.join("; ") else: "fix is currently unavailable"
        c = c.disabled(synth_reason)
    val reps = json_value_items(json_value_field(fix, "replacements"))
    var parsed_reps: [FixReplacement] = []
    var inline_pres: [FixPrecondition] = []
    for rep in reps:
        val rep_file = _resolve_candidate_file(
            json_value_text_or(json_value_field(rep, "file"), ""),
            analyzed_file,
            fix_file
        )
        val sp = _json_span(rep)
        parsed_reps.push(FixReplacement.new(rep_file, sp, json_value_text_or(json_value_field(rep, "new_text"), "")))
        match json_value_get(rep, "expected_text"):
            Some(et):
                inline_pres.push(FixPrecondition(file: rep_file, span: sp, expected_text: json_value_text_or(et, "")))
            None:
                pass
    c.replacements = parsed_reps
    val pres = json_value_items(json_value_field(fix, "preconditions"))
    if pres.len() > 0:
        var parsed_pres: [FixPrecondition] = []
        var pi = 0
        while pi < pres.len():
            val pre = pres[pi]
            val raw_pf = json_value_text_or(json_value_field(pre, "file"), "")
            var pf = ""
            if raw_pf == "":
                pf = if pi < parsed_reps.len(): parsed_reps[pi].file else: fix_file
            else:
                pf = _resolve_candidate_file(raw_pf, analyzed_file, fix_file)
            val pspan = if json_value_has(pre, "span"):
                _json_span(pre)
            elif pi < parsed_reps.len():
                parsed_reps[pi].span
            else:
                Span.new(0, 0, 1, 1)
            val expected = json_value_text_or(json_value_field(pre, "expected_text"), "")
            parsed_pres.push(FixPrecondition(file: pf, span: pspan, expected_text: expected))
            pi = pi + 1
        c.preconditions = parsed_pres
    elif inline_pres.len() > 0:
        c.preconditions = inline_pres
    c

fn _fix_candidate_from_json(fix: JsonValue, fix_file: text, version: i64) -> FixCandidate:
    _fix_candidate_from_json_staged(fix, fix_file, fix_file, version)

fn _row_has_string_message(row: JsonValue) -> bool:
    match json_value_field(row, "message"):
        case Str(_): true
        case _: false

fn _check_json_parse_internal_v1(
    output: text,
    analyzed_file: text,
    fix_file: text,
    version: i64,
    default_source_hash: text
) -> LspCheckBatchV1:
    val trimmed = output.trim()
    if trimmed == "":
        return _invalid_check_batch("malformed", "empty check JSON payload", fix_file, default_source_hash)
    val parsed = json_parse_value_strict(trimmed)
    if parsed.is_err():
        return _invalid_check_batch("malformed", "malformed check JSON payload", fix_file, default_source_hash)
    var items: [text] = []
    var index = DiagnosticActionIndex.new()
    var ids: [text] = []
    var rows: [JsonValue] = []
    var row_ids: [text] = []
    var batch_valid = true
    var batch_status = "complete"
    var incomplete_reason = ""
    var batch_hash = default_source_hash
    var scope = "document"
    var policy_digest = "default"
    var batch_sem_fp = ""
    var batch_obs_summary: [text] = []
    var batch_tradeoff = ""
    var batch_cand_meta: [LspDiagActionCandidateMetaV1] = []

    val root = parsed.unwrap()
    match root:
        case Array(entries):
            for entry in entries:
                match entry:
                    case Object(_, _):
                        if json_value_has(entry, "status"):
                            val (ok_st, norm_st) = _normalize_batch_status_name(json_value_text_or(json_value_field(entry, "status"), "complete"))
                            if not ok_st:
                                batch_valid = false
                                batch_status = norm_st
                                val er = json_value_text_or(json_value_field(entry, "incomplete_reason"), "")
                                if er != "": incomplete_reason = er
                        val eh = json_value_text_or(json_value_field(entry, "source_hash"), "")
                        if eh != "": batch_hash = eh
                        val ep = json_value_text_or(json_value_field(entry, "policy_digest"), "")
                        if ep != "": policy_digest = ep
                        val esem = json_value_text_or(json_value_field(entry, "semantic_fingerprint"), "")
                        if esem != "": batch_sem_fp = esem
                        if json_value_has(entry, "diagnostics"):
                            match json_value_field(entry, "diagnostics"):
                                case Array(ds):
                                    for d in ds:
                                        if json_value_has(d, "diagnostic"):
                                            rows.push(json_value_field(d, "diagnostic"))
                                            row_ids.push(json_value_text_or(json_value_field(d, "id"), ""))
                                        else:
                                            rows.push(d)
                                            row_ids.push(json_value_text_or(json_value_field(d, "id"), ""))
                                case _:
                                    return _invalid_check_batch("malformed", "entry diagnostics field is not an array", fix_file, batch_hash)
                        else:
                            if not _row_has_string_message(entry):
                                return _invalid_check_batch("malformed", "diagnostic array entry missing string message", fix_file, batch_hash)
                            rows.push(entry)
                            row_ids.push(json_value_text_or(json_value_field(entry, "id"), ""))
                    case _:
                        return _invalid_check_batch("malformed", "check JSON array contains non-object entry", fix_file, batch_hash)
        case Object(_, _):
            if json_value_has(root, "structuredContent"):
                match json_value_as_bool(json_value_field(root, "isError")):
                    case Some(true):
                        return _invalid_check_batch("failed", "check MCP wrapper reported isError=true", fix_file, batch_hash)
                    case _:
                        pass
                val sc = json_value_field(root, "structuredContent")
                val (ok_sc_st, norm_sc_st) = _normalize_batch_status_name(json_value_text_or(json_value_field(sc, "status"), "complete"))
                batch_valid = ok_sc_st
                batch_status = norm_sc_st
                val sc_comp = json_value_text_or(json_value_field(sc, "completeness"), "")
                if sc_comp == "timed_out" or sc_comp == "incomplete" or sc_comp == "unavailable":
                    batch_valid = false
                    if batch_status == "complete":
                        batch_status = sc_comp
                val sc_inc_reason = json_value_text_or(json_value_field(sc, "incomplete_reason"), "")
                val sc_alt_reason = json_value_text_or(json_value_field(sc, "reason"), "")
                incomplete_reason = if sc_inc_reason != "": sc_inc_reason else: sc_alt_reason
                val sc_src_hash = json_value_text_or(json_value_field(sc, "source_hash"), "")
                val sc_snap_hash = json_value_text_or(json_value_field(sc, "snapshot_hash"), "")
                if sc_src_hash != "":
                    batch_hash = sc_src_hash
                elif sc_snap_hash != "":
                    batch_hash = sc_snap_hash
                val sc_scope = json_value_text_or(json_value_field(sc, "scope"), "")
                if sc_scope != "": scope = sc_scope
                val sc_pol = json_value_text_or(json_value_field(sc, "policy_digest"), "")
                if sc_pol != "": policy_digest = sc_pol
                val sc_sem = json_value_text_or(json_value_field(sc, "semantic_fingerprint"), "")
                if sc_sem != "": batch_sem_fp = sc_sem
                match json_value_field(sc, "diagnostics"):
                    case Array(ds):
                        for d in ds:
                            if json_value_has(d, "diagnostic"):
                                rows.push(json_value_field(d, "diagnostic"))
                                row_ids.push(json_value_text_or(json_value_field(d, "id"), ""))
                            else:
                                rows.push(d)
                                row_ids.push(json_value_text_or(json_value_field(d, "id"), ""))
                    case _:
                        return _invalid_check_batch("malformed", "structuredContent.diagnostics is not an array", fix_file, batch_hash)
            elif json_value_has(root, "diagnostics"):
                val (ok_st, norm_st) = _normalize_batch_status_name(json_value_text_or(json_value_field(root, "status"), "complete"))
                batch_valid = ok_st
                batch_status = norm_st
                val root_comp = json_value_text_or(json_value_field(root, "completeness"), "")
                if root_comp == "timed_out" or root_comp == "incomplete" or root_comp == "unavailable":
                    batch_valid = false
                    if batch_status == "complete":
                        batch_status = root_comp
                incomplete_reason = json_value_text_or(json_value_field(root, "incomplete_reason"), "")
                val rh = json_value_text_or(json_value_field(root, "source_hash"), "")
                val rsnap = json_value_text_or(json_value_field(root, "snapshot_hash"), "")
                if rh != "":
                    batch_hash = rh
                elif rsnap != "":
                    batch_hash = rsnap
                val rs = json_value_text_or(json_value_field(root, "scope"), "")
                if rs != "": scope = rs
                val rp = json_value_text_or(json_value_field(root, "policy_digest"), "")
                if rp != "": policy_digest = rp
                val rsem = json_value_text_or(json_value_field(root, "semantic_fingerprint"), "")
                if rsem != "": batch_sem_fp = rsem
                match json_value_field(root, "diagnostics"):
                    case Array(ds):
                        for d in ds:
                            if json_value_has(d, "diagnostic"):
                                rows.push(json_value_field(d, "diagnostic"))
                                row_ids.push(json_value_text_or(json_value_field(d, "id"), ""))
                            else:
                                rows.push(d)
                                row_ids.push(json_value_text_or(json_value_field(d, "id"), ""))
                    case _:
                        return _invalid_check_batch("malformed", "batch diagnostics field is not an array", fix_file, batch_hash)
            else:
                return _invalid_check_batch("malformed", "unexpected JSON object without diagnostics array", fix_file, batch_hash)
        case _:
            return _invalid_check_batch("malformed", "check JSON payload must be an array or batch object", fix_file, batch_hash)

    var ri = 0
    while ri < rows.len():
        val row = rows[ri]
        if not _row_has_string_message(row):
            return _invalid_check_batch("malformed", "diagnostic row missing string message", fix_file, batch_hash)
        if json_value_has(row, "lifecycle"):
            val lc_pol = json_value_text_or(json_value_field(json_value_field(row, "lifecycle"), "policy_digest"), "")
            if lc_pol != "": policy_digest = lc_pol
        val row_sem = json_value_text_or(json_value_field(row, "semantic_fingerprint"), "")
        if row_sem != "" and batch_sem_fp == "":
            batch_sem_fp = row_sem
        val row_code = json_value_text_or(json_value_field(row, "code"), "")
        val row_line1 = _json_int_field(row, "line")
        val row_line0 = if row_line1 > 0: row_line1 - 1 else: -1
        var plain: [(text, JsonValue)] = []
        for k in json_value_keys(row):
            if k != "fixes" and k != "fix":
                plain.push((k, json_value_field(row, k)))
        val diag = _parse_json_diagnostic(json_value_serialize(json_value_object_from(plain)))
        if diag == "":
            ri = ri + 1
            continue
        items.push(diag)
        val explicit_id = row_ids[ri]
        val id = if explicit_id != "": explicit_id else: "d" + (items.len() - 1).to_text()
        val fixes = json_value_items(json_value_field(row, "fixes"))
        if fixes.len() > 0:
            if not ids.contains(id):
                ids.push(id)
            for fx in fixes:
                val cand = _fix_candidate_from_json_staged(fx, analyzed_file, fix_file, version)
                index = index.add(id, cand)
                val (obs_list, _unmet_list) = _extract_obligations_summary(fx)
                for ob_item in obs_list:
                    if not batch_obs_summary.contains(ob_item):
                        batch_obs_summary.push(ob_item)
                val fx_tradeoff_a = json_value_text_or(json_value_field(fx, "tradeoff"), "")
                val fx_tradeoff_b = json_value_text_or(json_value_field(fx, "resource_tradeoff"), "")
                val fx_tradeoff = if fx_tradeoff_a != "": fx_tradeoff_a else: fx_tradeoff_b
                if fx_tradeoff != "" and batch_tradeoff == "":
                    batch_tradeoff = fx_tradeoff
                val fx_rule = json_value_text_or(json_value_field(fx, "rule_id"), row_code)
                val fx_kind = json_value_text_or(json_value_field(fx, "kind"), "")
                val fx_app = json_value_text_or(json_value_field(fx, "applicability"), "")
                val fx_sem_a = json_value_text_or(json_value_field(fx, "semantic_fingerprint"), "")
                val fx_sem_b = json_value_text_or(json_value_field(fx, "dependency_fingerprint"), "")
                val fx_sem = if fx_sem_a != "": fx_sem_a elif fx_sem_b != "": fx_sem_b elif row_sem != "": row_sem else: batch_sem_fp
                batch_cand_meta.push(LspDiagActionCandidateMetaV1(
                    candidate_id: cand.id,
                    diagnostic_id: id,
                    rule_code: fx_rule,
                    fix_kind: fx_kind,
                    applicability: fx_app,
                    expected_semantic_fingerprint: fx_sem,
                    obligations_summary: obs_list,
                    resource_tradeoff: fx_tradeoff,
                    line_hint: row_line0
                ))
        ri = ri + 1

    if not batch_valid and incomplete_reason == "":
        incomplete_reason = "diagnostic batch status is " + batch_status
    LspCheckBatchV1(
        items: items,
        index: index,
        ids: ids,
        valid: batch_valid,
        status: batch_status,
        incomplete_reason: incomplete_reason,
        source_hash: batch_hash,
        scope: scope,
        target: fix_file,
        policy_digest: policy_digest,
        semantic_fingerprint: batch_sem_fp,
        obligations_summary: batch_obs_summary,
        resource_tradeoff: batch_tradeoff,
        candidate_meta: batch_cand_meta
    )

# Parse `check --format=json` output: a JSON array of
# {"file", "diagnostics":[...]} entries, MCP structuredContent wrapper, or DiagnosticBatchV1.
# reason: parses raw check JSON text for target fix_file and integer document version
@allow(primitive_api)
pub fn lsp_check_json_parse_v1(output: text, fix_file: text, version: i64) -> LspCheckBatchV1:
    _check_json_parse_internal_v1(output, fix_file, fix_file, version, "")

# reason: classifies check child stdout and exit code into a canonical LspCheckBatchV1
@allow(primitive_api)
pub fn lsp_evaluate_check_output_v1(
    out_json: text,
    exit_json: i64,
    analyzed_file: text,
    fix_file: text,
    version: i64,
    source_hash: text
) -> LspCheckBatchV1:
    if exit_json == 124:
        return _invalid_check_batch("timed_out", "LSP check query timed out (exit 124)", fix_file, source_hash)
    if exit_json < 0 or exit_json > 1:
        return _invalid_check_batch("failed", "LSP check query failed (exit " + str(exit_json) + ")", fix_file, source_hash)
    val payload = lsp_extract_query_json_payload(out_json)
    if payload == "":
        val trimmed = out_json.trim()
        if trimmed.starts_with(LB()) or trimmed.starts_with(SB_L()):
            return _invalid_check_batch("malformed", "truncated or malformed check JSON output", fix_file, source_hash)
        val fallback_diags = _collect_plain_text_check_diags_v1(out_json, analyzed_file, fix_file)
        if fallback_diags.len() > 0:
            return LspCheckBatchV1(
                items: fallback_diags,
                index: DiagnosticActionIndex.new(),
                ids: [],
                valid: true,
                status: "complete",
                incomplete_reason: "",
                source_hash: source_hash,
                scope: "document",
                target: fix_file,
                policy_digest: "default"
            )
        return _invalid_check_batch("failed", "check --format=json produced no JSON payload (exit " + str(exit_json) + ")", fix_file, source_hash)
    val batch = _check_json_parse_internal_v1(payload, analyzed_file, fix_file, version, source_hash)
    if not batch.valid:
        return batch
    if exit_json != 0 and batch.items.len() == 0:
        return _invalid_check_batch("incomplete", "check exited with code " + str(exit_json) + " without emitting diagnostics", fix_file, source_hash)
    batch

fn _strip_path_prefix_colon(line: text, candidate_path: text) -> text:
    if candidate_path == "":
        return ""
    val p1 = candidate_path + ":"
    if line.starts_with(p1):
        return line.substring(p1.byte_len())
    val norm_cand = candidate_path.replace("\\", "/")
    val p2 = norm_cand + ":"
    val norm_line = line.replace("\\", "/")
    if norm_line.starts_with(p2):
        return line.substring(p2.byte_len())
    ""

fn _parse_check_worker_tail(tail: text) -> text:
    val c1 = tail.index_of(":")
    if c1 < 0:
        return ""
    val line_str = tail.substring(0, c1).trim()
    val after_line = tail.substring(c1 + 1)
    var diag_line = 0
    val ln = line_str.to_int() ?? -1
    if ln < 0:
        return ""
    if ln > 0:
        diag_line = ln - 1
    var diag_col = 0
    var msg_part = after_line.trim()
    val c2 = after_line.index_of(":")
    if c2 >= 0:
        val col_candidate = after_line.substring(0, c2).trim()
        val cn = col_candidate.to_int() ?? -1
        if cn >= 0:
            if cn > 0:
                diag_col = cn - 1
            msg_part = after_line.substring(c2 + 1).trim()
    var severity = 1
    var code = ""
    if msg_part.starts_with("warning"):
        severity = 2
    val b_open = msg_part.index_of("[")
    val b_close = msg_part.index_of("]:")
    if b_open >= 0 and b_close > b_open and (msg_part.starts_with("error[") or msg_part.starts_with("warning[")):
        code = msg_part.substring(b_open + 1, b_close)
        msg_part = msg_part.substring(b_close + 2).trim()
    elif msg_part.starts_with("warning:"):
        msg_part = msg_part.substring(8).trim()
    elif msg_part.starts_with("error:"):
        msg_part = msg_part.substring(6).trim()
    if msg_part == "":
        return ""
    val range = jo2(
        jp("start", jo2(jp("line", str(diag_line)), jp("character", str(diag_col)))),
        jp("end", jo2(jp("line", str(diag_line)), jp("character", str(diag_col + 1))))
    )
    var parts: [text] = [
        jp("range", range),
        jp("severity", str(severity)),
        jp("message", js(msg_part)),
        jp("source", js("simple"))
    ]
    if code != "":
        parts.push(jp("code", js(code)))
    LB() + parts.join(",") + RB()

fn _collect_plain_text_check_diags_v1(raw_output: text, target_arg: text, file_path: text) -> [text]:
    var diags: [text] = []
    for raw_line in raw_output.split("\n"):
        val trimmed = raw_line.trim()
        if trimmed == "" or trimmed.starts_with(SB_L()):
            continue
        var tail = _strip_path_prefix_colon(trimmed, target_arg)
        if tail == "" and file_path != target_arg:
            tail = _strip_path_prefix_colon(trimmed, file_path)
        if tail != "":
            val diag = _parse_check_worker_tail(tail)
            if diag != "":
                diags.push(diag)
    diags

fn _collect_check_worker_v1(target_arg: text, file_path: text, fix_file: text, version: i64, source_hash: text) -> LspCheckBatchV1:
    val worker_cmd = LspQueryCommandV1(["run", "src/app/cli/query.spl", "check", target_arg, "--format", "json"], 60000)
    val (out_worker, exit_worker) = lsp_run_query_command_v1(_find_simple_binary(), worker_cmd)
    lsp_evaluate_check_output_v1(out_worker, exit_worker, target_arg, fix_file, version, source_hash)

fn _collect_diagnostics_with_hash(file_path: text, fix_file: text, version: i64, source_hash: text) -> LspCheckBatchV1:
    val target_arg = lsp_query_file_argument_v1(file_path)
    _collect_check_worker_v1(target_arg, file_path, fix_file, version, source_hash)

fn _collect_diagnostics(file_path: text, fix_file: text, version: i64) -> LspCheckBatchV1:
    _collect_diagnostics_with_hash(file_path, fix_file, version, "")

fn _parse_diagnostic_line(line: text, file_path: text) -> text:
    # JSON structured format: line starts with "{"
    if line.starts_with("{"):
        return _parse_json_diagnostic(line)
    # Fallback: plain text format (file:line:col: severity: message)
    _parse_text_diagnostic(line=line, file_path=file_path)

fn _parse_json_diagnostic(line: text) -> text:
    val msg = extract_field(json=line, key="message")
    val sev_str = extract_field(json=line, key="severity")
    val code = extract_field(json=line, key="code")
    val source = extract_field(json=line, key="source")
    val line_str = extract_field(json=line, key="line")
    val raw_col_str = extract_field(json=line, key="col")
    val col_str = if raw_col_str != "": raw_col_str else: extract_field(json=line, key="column")
    val tags_raw = extract_field(json=line, key="tags")
    var diag_line = 0
    var diag_col = 0
    if line_str != "":
        val ln = (line_str.to_int() ?? 0)
        if ln > 0:
            diag_line = ln - 1
    if col_str != "":
        val cn = (col_str.to_int() ?? 0)
        if cn > 0:
            diag_col = cn - 1
    var severity = 1
    if sev_str == "error" or sev_str == "1":
        severity = 1
    elif sev_str == "warning" or sev_str == "2":
        severity = 2
    elif sev_str == "information" or sev_str == "info" or sev_str == "3":
        severity = 3
    elif sev_str == "hint" or sev_str == "4":
        severity = 4
    val range = jo2(
        jp("start", jo2(jp("line", str(diag_line)), jp("character", str(diag_col)))),
        jp("end", jo2(jp("line", str(diag_line)), jp("character", str(diag_col + 1))))
    )
    var parts: [text] = []
    parts.push(jp("range", range))
    parts.push(jp("severity", str(severity)))
    parts.push(jp("message", js(msg)))
    if source != "":
        parts.push(jp("source", js(source)))
    elif source == "":
        parts.push(jp("source", js("simple")))
    if code != "":
        parts.push(jp("code", js(code)))
    # Parse tags (Unnecessary=1, Deprecated=2)
    var tag_items: [text] = []
    if tags_raw != "":
        if tags_raw.contains("Unnecessary") or tags_raw.contains("unnecessary"):
            tag_items.push("1")
        if tags_raw.contains("Deprecated") or tags_raw.contains("deprecated"):
            tag_items.push("2")
    if tag_items.len() > 0:
        parts.push(jp("tags", SB_L() + tag_items.join(",") + SB_R()))
    # Parse relatedInformation if present (legacy scalar fields or C07 provenance chain)
    val related_raw = extract_field(json=line, key="relatedFile")
    val related_msg = extract_field(json=line, key="relatedMessage")
    if line.contains("\"related_locations\""):
        match json_parse_value_strict(line):
            case Ok(diag_jv):
                var chain: [LspPerfProvenanceSpanV1] = []
                for rl in json_value_items(json_value_field(diag_jv, "related_locations")):
                    val rl_file = json_value_text_or(json_value_field(rl, "file"), "")
                    val rl_summary = json_value_text_or(json_value_field(rl, "summary_line"), json_value_text_or(json_value_field(rl, "message"), ""))
                    if rl_file != "" and rl_summary != "":
                        val rl_line = if json_value_has(rl, "line"): _json_int_field(rl, "line") else: _json_int_field(json_value_field(rl, "span"), "line")
                        val rl_col = if json_value_has(rl, "col"): _json_int_field(rl, "col") else: _json_int_field(json_value_field(rl, "span"), "col")
                        val rl_end_line = if json_value_has(rl, "end_line"): _json_int_field(rl, "end_line") else: rl_line
                        val rl_end_col = if json_value_has(rl, "end_col"): _json_int_field(rl, "end_col") else: rl_col + 1
                        chain.push(LspPerfProvenanceSpanV1(
                            node_id: json_value_text_or(json_value_field(rl, "node_id"), ""),
                            role: json_value_text_or(json_value_field(rl, "role"), ""),
                            file: rl_file,
                            line: if rl_line > 0: rl_line else: 1,
                            col: if rl_col > 0: rl_col else: 1,
                            end_line: if rl_end_line > 0: rl_end_line else: 1,
                            end_col: if rl_end_col > 0: rl_end_col else: 2,
                            summary_line: rl_summary
                        ))
                if chain.len() > 0:
                    parts.push(jp("relatedInformation", lsp_render_perf_related_information_json_v1(chain)))
            case Err(_):
                pass
    elif related_raw != "" and related_msg != "":
        val related_loc = jo2(
            jp("uri", js("file://" + related_raw)),
            jp("range", jo2(
                jp("start", jo2(jp("line", "0"), jp("character", "0"))),
                jp("end", jo2(jp("line", "0"), jp("character", "0")))
            ))
        )
        val related_info = jo2(jp("location", related_loc), jp("message", js(related_msg)))
        parts.push(jp("relatedInformation", SB_L() + related_info + SB_R()))
    LB() + parts.join(",") + RB()

fn _parse_text_diagnostic(line: text, file_path: text) -> text:
    var diag_line = 0
    var diag_col = 0
    var diag_msg = line
    var severity = 1
    val ci = line.index_of(":")
    if ci >= 0:
        val after = line.substring(ci + 1)
        val ci2 = after.index_of(":")
        if ci2 >= 0:
            val line_str = after.substring(0, ci2).trim()
            val line_num = (line_str.to_int() ?? 0)
            if line_num > 0:
                diag_line = line_num - 1
                val after2 = after.substring(ci2 + 1)
                val ci3 = after2.index_of(":")
                if ci3 >= 0:
                    val col_str = after2.substring(0, ci3).trim()
                    val col_num = (col_str.to_int() ?? 0)
                    if col_num > 0:
                        diag_col = col_num - 1
                    diag_msg = after2.substring(ci3 + 1).trim()
                else:
                    diag_msg = after2.trim()
        else:
            val _x = 0
    else:
        val _x = 0
    if diag_msg.starts_with("warning"):
        severity = 2
        diag_msg = diag_msg.replace("warning:", "").trim()
    elif diag_msg.starts_with("error"):
        severity = 1
        diag_msg = diag_msg.replace("error:", "").trim()
    val range = jo2(
        jp("start", jo2(jp("line", str(diag_line)), jp("character", str(diag_col)))),
        jp("end", jo2(jp("line", str(diag_line)), jp("character", str(diag_col + 1))))
    )
    jo3(jp("range", range), jp("severity", str(severity)), jp("message", js(diag_msg)))

# --- Definition (fast path) ---

fn lsp_handle_definition(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    val line = _extract_line(body)
    val col = _extract_character(body)
    val query_line = str((line.to_int() ?? 0) + 1)
    val query_col = str((col.to_int() ?? 0) + 1)
    var cmd = lsp_fast_query_command_v1(["definition", lsp_query_file_argument_v1(file_path), query_line, query_col])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result="null")
    val result = _parse_location(out.trim())
    make_json_result(id=id, result=result)

# The query children print `{file}:{line}: [kind] sig` with no column; the
# column is derived from the identifier named by the trailer, located in the
# real source line (see lsp_location.spl). Windows drive prefixes are kept.
fn _source_line_at(file: text, line_no: i64) -> text:
    if line_no <= 0 or not file_exists(file): return ""
    val lines = read_file(file).split("\n")
    if line_no > lines.len(): return ""
    lines[line_no - 1]

# Query children print relative paths for bounded-walk hits (`src/x.spl`);
# an LSP Location needs an absolute file URI, so anchor those at the cwd.
fn _lsp_location_uri(file: text) -> text:
    val p = file.replace("\\", "/")
    if p.starts_with("/") or (p.len() > 2 and p[1] == ":"):
        return _lsp_path_to_uri(p)
    _lsp_path_to_uri(cwd().replace("\\", "/") + "/" + p)

fn _parse_location(output: text) -> text:
    val lines = output.split("\n")
    if lines.len() == 0:
        return "null"
    val parsed = lsp_parse_query_location_v1(lines[0])
    match parsed:
        case Some(loc):
            var line_num = loc.line - 1
            if line_num < 0:
                line_num = 0
            val col_num = lsp_location_lsp_column_v1(loc, _source_line_at(loc.file, loc.line))
            val loc_uri = _lsp_location_uri(loc.file)
            val range = jo2(
                jp("start", jo2(jp("line", str(line_num)), jp("character", str(col_num)))),
                jp("end", jo2(jp("line", str(line_num)), jp("character", str(col_num))))
            )
            jo2(jp("uri", js(loc_uri)), jp("range", range))
        case nil:
            "null"

# --- References (fast path) ---

fn _reference_query_lines(body: text, include_decl: bool) -> [text]:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    val line = _extract_line(body)
    val col = _extract_character(body)
    val query_line = str((line.to_int() ?? 0) + 1)
    val query_col = str((col.to_int() ?? 0) + 1)
    var cmd = lsp_fast_query_command_v1(["references", lsp_query_file_argument_v1(file_path), query_line, query_col])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    var kept: [text] = []
    if exit_code != 0 or out.trim() == "":
        return kept
    # `context.includeDeclaration: false` drops lines whose role is the
    # declaration of the queried symbol (the role is derived from the printed
    # source text, so no second child run is needed).
    var symbol = ""
    if not include_decl:
        symbol = lsp_query_symbol_at_v1(file_path, (line.to_int() ?? 0) + 1, (col.to_int() ?? 0) + 1)
    for loc_line in out.split("\n"):
        val trimmed = loc_line.trim()
        if trimmed == "" or trimmed.starts_with("No ") or trimmed.starts_with("Error"):
            continue
        if not include_decl and symbol != "":
            match lsp_parse_query_location_v1(trimmed):
                case Some(parsed):
                    if lsp_reference_role_v1(parsed.trailer, symbol) == "declaration":
                        continue
                case nil: pass
        kept.push(trimmed)
    kept

fn lsp_handle_references(id: text, body: text) -> text:
    var locs: [text] = []
    for trimmed in _reference_query_lines(body, lsp_references_include_declaration_v1(body)):
        val loc = _parse_location(trimmed)
        if loc != "null":
            locs.push(loc)
    make_json_result(id=id, result=SB_L() + locs.join(",") + SB_R())

# --- Rename (WorkspaceEdit from the references query) ---

# Width of one rename edit: the identifier written at the reference site, i.e.
# the last segment of a qualified symbol (`A.b` -> `b`), never the whole name.
pub fn lsp_rename_edit_width_v1(symbol: text) -> i64:
    val parts = symbol.split(".")
    parts[parts.len() - 1].len()

pub fn lsp_handle_rename(id: text, body: text) -> text:
    val new_name = extract_field(json=body, key="newName")
    val file_path = _uri_to_path(_extract_uri(body))
    val symbol = lsp_query_symbol_at_v1(file_path, (_extract_line(body).to_int() ?? 0) + 1, (_extract_character(body).to_int() ?? 0) + 1)
    if new_name == "" or symbol == "":
        return make_json_result(id=id, result="null")
    var uris: [text] = []
    var edits_by_uri: [[text]] = []
    for trimmed in _reference_query_lines(body, true):
        match lsp_parse_query_location_v1(trimmed):
            case Some(loc):
                val line_num = if loc.line > 0: loc.line - 1 else: 0
                val col_num = lsp_location_lsp_column_v1(loc, _source_line_at(loc.file, loc.line))
                val range = jo2(
                    jp("start", jo2(jp("line", str(line_num)), jp("character", str(col_num)))),
                    jp("end", jo2(jp("line", str(line_num)), jp("character", str(col_num + lsp_rename_edit_width_v1(symbol)))))
                )
                val edit = jo2(jp("range", range), jp("newText", js(new_name)))
                val loc_uri = _lsp_location_uri(loc.file)
                var idx = -1
                var i = 0
                while i < uris.len():
                    if uris[i] == loc_uri:
                        idx = i
                    i = i + 1
                if idx < 0:
                    uris.push(loc_uri)
                    edits_by_uri.push([edit])
                else:
                    edits_by_uri[idx].push(edit)
            case nil: pass
    var entries: [text] = []
    var k = 0
    while k < uris.len():
        entries.push(jp(uris[k], SB_L() + edits_by_uri[k].join(",") + SB_R()))
        k = k + 1
    make_json_result(id=id, result=jo1(jp("changes", LB() + entries.join(",") + RB())))

# --- PrepareRename (identifier range at the cursor) ---

# Answers `textDocument/prepareRename` with the `{range, placeholder}` of the
# identifier at the cursor, or `null` when the position is not renameable.
# Before this handler the request fell into the unknown-method -32601 branch,
# which clients that probe prepareRename (the -32601 surface recorded in
# lsp_rename_prepare_rename_not_implemented_2026_11_07) surfaced as a hard
# rename failure even though `textDocument/rename` itself is implemented.
pub fn lsp_handle_prepare_rename(id: text, body: text) -> text:
    val file_path = _uri_to_path(_extract_uri(body))
    val line0 = _extract_line(body).to_int() ?? 0
    val char0 = _extract_character(body).to_int() ?? 0
    val (word, start, end) = lsp_query_word_span_at_v1(file_path, line0 + 1, char0 + 1)
    if word == "":
        return make_json_result(id=id, result="null")
    val range = jo2(
        jp("start", jo2(jp("line", str(line0)), jp("character", str(start)))),
        jp("end", jo2(jp("line", str(line0)), jp("character", str(end))))
    )
    make_json_result(id=id, result=jo2(jp("range", range), jp("placeholder", js(word))))

# --- Formatting (canonical formatter, run as a child like the queries) ---

pub fn lsp_handle_formatting(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    # Format the unsaved editor overlay when one exists (staged to a temp
    # copy, same as diagnostics); otherwise the on-disk file.
    val source = lsp_diagnostics_stage_source_v1(uri, file_path)
    if source.path == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    val snapshot = lsp_document_snapshot(uri)
    val original = if source.overlay and snapshot != nil: snapshot.unwrap().content else: read_file(file_path)
    val cmd = LspQueryCommandV1(["src/compiler/90.tools/formatter/main.spl", source.path], 30000)
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    lsp_diagnostics_release_source_v1(source)
    # A newer change superseded the formatted snapshot: its edit would be stale.
    if not lsp_diagnostics_source_is_current_v1(source):
        return make_json_result(id=id, result=SB_L() + SB_R())
    if exit_code != 0 or out.starts_with("Error"):
        return make_json_result(id=id, result=SB_L() + SB_R())
    # The formatter prints the document followed by print()'s own newline.
    val formatted = if out.ends_with("\n"): out[0:out.len() - 1] else: out
    if formatted == original:
        return make_json_result(id=id, result=SB_L() + SB_R())
    val end_line = original.split("\n").len()
    val range = jo2(
        jp("start", jo2(jp("line", "0"), jp("character", "0"))),
        jp("end", jo2(jp("line", str(end_line)), jp("character", "0")))
    )
    make_json_result(id=id, result=SB_L() + jo2(jp("range", range), jp("newText", js(formatted))) + SB_R())

# --- Hover (fast path) ---

fn lsp_handle_hover(id: text, body: text) -> text:
    val client_id = lsp_extract_client_id_v1(body)
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    val line = _extract_line(body)
    val col = _extract_character(body)
    val line0 = line.to_int() ?? 0
    match lsp_perf_hover_lookup_for_client_v1(client_id, uri, line0):
        case Some(perf_summary):
            return make_json_result(id=id, result=lsp_render_perf_cost_hover_json_v1(perf_summary))
        case None:
            pass
    # Line 0 is the module header: hover there is the module's hidden summary (REQ-PUBVIEW-008).
    if line == "0" and file_path != "":
        return make_json_result(id=id, result=lsp_hover_hidden_summary_result(file_path))
    val query_line = str((line.to_int() ?? 0) + 1)
    val query_col = str((col.to_int() ?? 0) + 1)
    var cmd = lsp_visibility_query_command_v1(["hover", lsp_query_file_argument_v1(file_path), query_line, query_col])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    val payload = lsp_extract_query_json_payload(out)
    if exit_code != 0 or payload == "" or payload == "null":
        return make_json_result(id=id, result=lsp_hover_hidden_summary_result(file_path))
    make_json_result(id=id, result=payload)

# --- Completion (fast path) ---

fn lsp_handle_completion(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    val line = _extract_line(body)
    val col = _extract_character(body)
    val query_line = str((line.to_int() ?? 0) + 1)
    val query_col = str((col.to_int() ?? 0) + 1)
    var cmd = lsp_visibility_query_command_v1(["completions", lsp_query_file_argument_v1(file_path), query_line, query_col])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    val payload = lsp_extract_query_json_payload(out)
    if exit_code != 0 or payload == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    make_json_result(id=id, result=payload)

# --- Document Symbol (fast path) ---

pub fn lsp_handle_document_symbol_legacy(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if file_path == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    var cmd = lsp_visibility_query_command_v1(["symbols", lsp_query_file_argument_v1(file_path), "--requester", lsp_query_file_argument_v1(file_path)] + lsp_visibility_args(body))
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    make_json_result(id=id, result=out.trim())

fn lsp_handle_document_symbol(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if uri == "" or file_path == "":
        return make_error(id, -32602, "documentSymbol requires a file URI")
    val snapshot = lsp_visibility_snapshot_v1(uri, file_path)
    var target_snapshot = LspVisibilitySnapshotV1(uri, lsp_query_file_argument_v1(file_path),
        -1, -1, lsp_document_overlay_generation_v1())
    var disk_target_content = ""
    if snapshot.?:
        target_snapshot = snapshot.unwrap()
    else:
        val source = lsp_visibility_source_read_v1(file_path)
        if source.status == LspVisibilitySourceStatusV1.OpenPending:
            return make_error(id, -32803, "documentSymbol source is not synchronized")
        if source.status == LspVisibilitySourceStatusV1.Missing:
            return make_json_result(id=id, result=SB_L() + SB_R())
        if source.status != LspVisibilitySourceStatusV1.Ready or source.source_kind != "disk":
            return make_error(id, -32603, "documentSymbol disk source is unavailable")
        disk_target_content = source.content
    val options = lsp_visibility_args(body)
    var level = ""
    var feature = ""
    var layer = ""
    var index = 0
    while index + 1 < options.len():
        if options[index] == "--visibility": level = options[index + 1]
        if options[index] == "--feature": feature = options[index + 1]
        if options[index] == "--layer": layer = options[index + 1]
        index = index + 2
    val request = LspVisibilityQueryRequestV1(target_snapshot,
        lsp_query_file_argument_v1(file_path), level, feature, layer)
    val result = LSP_VISIBILITY_QUERY_PROVIDER_V1.query(request, lsp_visibility_source_reader_v1())
    var target_dependency_seen = false
    for dependency in result.dependencies:
        if dependency.path != target_snapshot.path: continue
        if target_snapshot.lifetime_generation < 0:
            if dependency.source_kind == "disk" and dependency.uri == "": target_dependency_seen = true
        elif dependency.source_kind == "overlay" and dependency.uri == target_snapshot.uri and
                dependency.version == target_snapshot.version and
                dependency.lifetime_generation == target_snapshot.lifetime_generation:
            target_dependency_seen = true
    if result.overlay_generation != lsp_document_overlay_generation_v1() or
            not lsp_visibility_snapshot_current_v1(target_snapshot) or
            not lsp_visibility_dependencies_current_v1(result.dependencies):
        return make_error(id, -32801, "documentSymbol source changed during the request")
    if target_snapshot.lifetime_generation < 0:
        val current_source = lsp_visibility_source_read_v1(file_path)
        if current_source.status != LspVisibilitySourceStatusV1.Ready or
                current_source.source_kind != "disk" or current_source.content != disk_target_content:
            return make_error(id, -32801, "documentSymbol disk source changed during the request")
    if result.status == LspVisibilityQueryStatusV1.Ready and not target_dependency_seen:
        return make_error(id, -32603, "visibility provider did not read the requested source")
    if result.status == LspVisibilityQueryStatusV1.Pending:
        return make_error(id, -32803, result.diagnostic)
    if result.status == LspVisibilityQueryStatusV1.Unavailable:
        return make_error(id, -32603, result.diagnostic)
    make_json_result(id=id, result=result.payload)

fn _symbol_kind_number(kind_str: text) -> i64:
    if kind_str == "fn" or kind_str == "function" or kind_str == "extern_fn":
        return 12
    elif kind_str == "method" or kind_str == "static_method":
        return 6
    elif kind_str == "class":
        return 5
    elif kind_str == "struct":
        return 23
    elif kind_str == "enum":
        return 10
    elif kind_str == "trait" or kind_str == "impl":
        return 11
    elif kind_str == "var" or kind_str == "val":
        return 13
    12

# --- Implementation (fast path) ---

fn lsp_handle_implementation(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    val line = _extract_line(body)
    val col = _extract_character(body)
    val query_line = str((line.to_int() ?? 0) + 1)
    val query_col = str((col.to_int() ?? 0) + 1)
    var cmd = lsp_fast_query_command_v1(["implementation", lsp_query_file_argument_v1(file_path), query_line, query_col])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    val lines = out.split("\n")
    var locs: [text] = []
    for loc_line in lines:
        val trimmed = loc_line.trim()
        if trimmed == "":
            continue
        val loc = _parse_location(trimmed)
        if loc != "null":
            locs.push(loc)
    make_json_result(id=id, result=SB_L() + locs.join(",") + SB_R())

# --- Workspace Symbol (fast path) ---

fn lsp_handle_workspace_symbol(id: text, body: text) -> text:
    val query = extract_nested(json=body, key="query")
    var cmd = lsp_visibility_query_command_v1(["workspace-symbols", "--query", query, "--requester", "src/"] + lsp_visibility_args(body))
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    make_json_result(id=id, result=out.trim())

fn lsp_handle_folding_range(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if file_path == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    var cmd = lsp_fast_query_command_v1(["folding-range", lsp_query_file_argument_v1(file_path)])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    val lines = out.split("\n")
    var ranges: [text] = []
    for raw_line in lines:
        val line = raw_line.trim()
        if line == "" or line.starts_with("No ") or line.starts_with("Error"):
            continue
        val parts = line.split(":")
        if parts.len() < 2:
            continue
        var start_line = int(parts[0]) - 1
        var end_line = int(parts[1]) - 1
        if start_line < 0:
            start_line = 0
        if end_line < start_line:
            continue
        var range_parts: [text] = []
        range_parts.push(jp("startLine", str(start_line)))
        range_parts.push(jp("endLine", str(end_line)))
        if parts.len() >= 3 and parts[2].trim() != "":
            range_parts.push(jp("kind", js(parts[2].trim())))
        ranges.push(LB() + range_parts.join(",") + RB())
    make_json_result(id=id, result=SB_L() + ranges.join(",") + SB_R())

fn lsp_handle_semantic_tokens_full(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if file_path == "":
        return make_json_result(id=id, result="{\"data\":[]}")
    var cmd = lsp_visibility_query_command_v1(["semantic-tokens", lsp_query_file_argument_v1(file_path)])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result="{\"data\":[]}")
    make_json_result(id=id, result=out.trim())

fn lsp_handle_semantic_tokens_range(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if file_path == "":
        return make_json_result(id=id, result="{\"data\":[]}")
    val range_raw = extract_nested(json=body, key="range")
    val start_line = extract_field(json=range_raw, key="line")
    # last_index_of returns a plain i64 with -1 for not-found, not an Option;
    # the old `match Some(i)` took the nil arm on a real hit and the Some arm
    # (binding nil) on a miss. Not-found still leaves end_line == start_line.
    val end_idx = range_raw.last_index_of("\"line\"")
    var end_line = start_line
    if end_idx >= 0:
        val tail = range_raw.substring(end_idx)
        val maybe_end = extract_field(json=tail, key="line")
        if maybe_end != "":
            end_line = maybe_end
    var cmd = lsp_visibility_query_command_v1(["semantic-tokens", lsp_query_file_argument_v1(file_path), "--start-line", start_line, "--end-line", end_line])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result="{\"data\":[]}")
    make_json_result(id=id, result=out.trim())

# --- Call Hierarchy (fast path) ---

# The item is the symbol's DECLARATION (resolved through the definition
# query), so incoming/outgoing requests carry a position the call-edge engine
# can anchor on. The trailer names the identifier; its column is derived from
# the source line exactly as for textDocument/definition.
fn lsp_handle_prepare_call_hierarchy(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val line = _extract_line(body)
    val col = _extract_character(body)
    val file_path = _uri_to_path(uri)
    val query_line = str((line.to_int() ?? 0) + 1)
    val query_col = str((col.to_int() ?? 0) + 1)
    var cmd = lsp_fast_query_command_v1(["definition", lsp_query_file_argument_v1(file_path), query_line, query_col])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    if exit_code != 0 or out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    match lsp_parse_query_location_v1(out.split("\n")[0]):
        case Some(loc):
            val name = lsp_location_identifier_from_trailer_v1(loc.trailer)
            if name == "":
                return make_json_result(id=id, result=SB_L() + SB_R())
            var line0 = loc.line - 1
            if line0 < 0: line0 = 0
            val decl_line = _source_line_at(loc.file, loc.line)
            val col0 = lsp_location_lsp_column_v1(loc, decl_line)
            # L11: the stable symbol key + worktree locator ride in `data`
            # (snapshot_id/blob_id are empty until a snapshot-bound query exists).
            var data = ""
            match lsp_symbol_key_v1(loc.file, decl_line, ""):
                case Some(key):
                    data = lsp_symbol_data_json_v1(key, "", loc.file, "", loc.line, col0 + 1)
                case nil: pass
            val item = lsp_call_hierarchy_item_with_data_json_v1(name, _lsp_location_uri(loc.file), line0, col0, "", data)
            make_json_result(id=id, result=SB_L() + item + SB_R())
        case nil:
            make_json_result(id=id, result=SB_L() + SB_R())

fn _handle_call_hierarchy_direction(id: text, body: text, subcmd: text, key: text) -> text:
    match lsp_call_hierarchy_request_item_v1(body):
        case Some(item):
            val file_path = _uri_to_path(item.uri)
            val query_line = str(item.line + 1)
            val query_col = str(item.character + 1)
            var cmd = lsp_fast_query_command_v1([subcmd, lsp_query_file_argument_v1(file_path), query_line, query_col])
            var out = ""
            var exit_code: i64 = 0
            (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
            if exit_code != 0 or out.trim() == "":
                return make_json_result(id=id, result=SB_L() + SB_R())
            val edges = lsp_call_edges_parse_output_v1(out)
            var uris: [text] = []
            for e in edges:
                uris.push(_lsp_location_uri(e.file))
            # A truncated walk is reported, never silently presented as complete.
            val note = lsp_call_edges_parse_note_v1(out)
            make_json_result(id=id, result=lsp_call_hierarchy_calls_with_note_json_v1(edges, uris, key, item.uri, note))
        case nil:
            make_json_result(id=id, result=SB_L() + SB_R())

fn lsp_handle_incoming_calls(id: text, body: text) -> text:
    _handle_call_hierarchy_direction(id, body, "incoming-calls", "from")

fn lsp_handle_outgoing_calls(id: text, body: text) -> text:
    _handle_call_hierarchy_direction(id, body, "outgoing-calls", "to")

# --- Inlay Hints (heavy — calls query engine) ---

# A failed query is not an empty semantic result. Keep the canonical JSON-RPC
# internal-error envelope and distinguish the bounded-process timeout status.
fn lsp_heavy_query_failure(id: text, exit_code: i64) -> text:
    if exit_code == 124:
        return make_error(id, ERROR_INTERNAL_ERROR(), "LSP query timed out")
    make_error(id, ERROR_INTERNAL_ERROR(), "LSP query failed (exit {exit_code})")

fn lsp_handle_inlay_hint(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if file_path == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    var cmd = lsp_heavy_query_command_v1(["inlay-hints", lsp_query_file_argument_v1(file_path)])
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), cmd)
    lsp_inlay_hint_query_response(id, out, exit_code)

pub fn lsp_inlay_hint_query_response(id: text, out: text, exit_code: i64) -> text:
    if exit_code != 0:
        return lsp_heavy_query_failure(id, exit_code)
    if out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    val lines = out.split("\n")
    var hints: [text] = []
    for hint_line in lines:
        val trimmed = hint_line.trim()
        if trimmed == "":
            continue
        val hint = _parse_inlay_hint(trimmed)
        if hint != "":
            hints.push(hint)
    make_json_result(id=id, result=SB_L() + hints.join(",") + SB_R())

fn _parse_inlay_hint(line: text) -> text:
    # JSON format: {"line":N,"character":N,"label":"text","kind":1|2}
    if line.starts_with("{"):
        val hint_line = extract_field(json=line, key="line")
        val hint_char = extract_field(json=line, key="character")
        val hint_label = extract_field(json=line, key="label")
        val hint_kind = extract_field(json=line, key="kind")
        if hint_label == "":
            return ""
        var ln = 0
        var ch = 0
        if hint_line != "":
            val ln_val = (hint_line.to_int() ?? 0)
            if ln_val > 0:
                ln = ln_val - 1
        if hint_char != "":
            ch = (hint_char.to_int() ?? 0)
        var kind_num = 1
        if hint_kind == "2" or hint_kind == "parameter":
            kind_num = 2
        val pos = jo2(jp("line", str(ln)), jp("character", str(ch)))
        return jo3(jp("position", pos), jp("label", js(hint_label)), jp("kind", str(kind_num)))
    # Text format: line:col:label:kind
    val parts = line.split(":")
    if parts.len() < 3:
        return ""
    var ln = 0
    val ln_val = int(parts[0])
    if ln_val > 0:
        ln = ln_val - 1
    val ch = int(parts[1])
    val label = parts[2]
    var kind_num = 1
    if parts.len() >= 4:
        if parts[3].trim() == "2" or parts[3].trim() == "parameter":
            kind_num = 2
    val pos = jo2(jp("line", str(ln)), jp("character", str(ch)))
    jo3(jp("position", pos), jp("label", js(label)), jp("kind", str(kind_num)))

# --- Code Action (heavy — calls query engine) ---

pub fn lsp_handle_code_action(id: text, body: text) -> text:
    lsp_code_action_response(id, body, _find_simple_binary())

pub fn lsp_handle_code_action_resolve(id: text, body: text) -> text:
    lsp_code_action_resolve_dispatch(id, body)

pub fn lsp_code_action_query_response(id: text, uri: text, out: text, exit_code: i64) -> text:
    if exit_code != 0:
        return lsp_heavy_query_failure(id, exit_code)
    if out.trim() == "":
        return make_json_result(id=id, result=SB_L() + SB_R())
    make_json_result(id=id, result=lsp_code_actions_from_query_output(out, uri))

fn lsp_code_actions_from_query_output(out: text, uri: text) -> text:
    lsp_code_actions_convert_output(out, uri)

# --- Pull Diagnostics (LSP 3.17 — textDocument/diagnostic) ---

# reason: computes deterministic LSP 3.17 pull diagnostic resultId digest over snapshot and batch metadata
@allow(primitive_api)
pub fn lsp_pull_diagnostic_result_id_v1(
    snapshot_identity: text,
    scope: text,
    status: text,
    target: text,
    policy_digest: text
) -> text:
    val canonical = "v1|snapshot=" + snapshot_identity + "|scope=" + scope + "|status=" + status + "|target=" + target + "|policy=" + policy_digest
    "diag-" + sha256_text(canonical)

fn _extract_previous_result_id(body: text) -> text:
    match json_parse_value_strict(body):
        case Ok(msg):
            if json_value_has(msg, "params"):
                val p = json_value_field(msg, "params")
                val nested = json_value_text_or(json_value_field(p, "previousResultId"), "")
                if nested != "": return nested
            return json_value_text_or(json_value_field(msg, "previousResultId"), "")
        case Err(_):
            return extract_field(json=body, key="previousResultId")

# reason: formats LSP 3.17 DocumentDiagnosticReport JSON-RPC response or failure/staleness error from LspCheckBatchV1
@allow(primitive_api)
pub fn lsp_pull_diagnostic_response_from_batch_v1(
    id: text,
    previous_result_id: text,
    batch: LspCheckBatchV1,
    current: bool,
    version: i64
) -> text:
    if not current or batch.status == "stale":
        return make_error(id, -32801, "pull diagnostic source changed during analysis; retry on latest revision")
    if not batch.valid or batch.status != "complete":
        val msg = if batch.incomplete_reason != "":
            batch.incomplete_reason
        elif batch.status == "timed_out":
            "LSP check query timed out"
        else:
            "pull diagnostic analysis failed (" + batch.status + ")"
        return make_error(id, -32803, msg)
    val snap_id = if batch.source_hash != "" and version >= 0:
        batch.source_hash + "@" + str(version)
    elif batch.source_hash != "":
        batch.source_hash
    else:
        "v:" + str(version)
    val result_id = lsp_pull_diagnostic_result_id_v1(snap_id, batch.scope, batch.status, batch.target, batch.policy_digest)
    if previous_result_id != "" and previous_result_id == result_id:
        val unchanged = jo2(jp("kind", js("unchanged")), jp("resultId", js(result_id)))
        return make_json_result(id=id, result=unchanged)
    val diags_str = SB_L() + batch.items.join(",") + SB_R()
    val full_report = jo3(jp("kind", js("full")), jp("resultId", js(result_id)), jp("items", diags_str))
    make_json_result(id=id, result=full_report)

# reason: handles LSP 3.17 textDocument/diagnostic pull request isolated to client_id
@allow(primitive_api)
pub fn lsp_handle_pull_diagnostic_for_client_v1(client_id: text, id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if uri == "" or file_path == "":
        return make_error(id, -32602, "textDocument/diagnostic requires a valid file URI")
    val previous_result_id = _extract_previous_result_id(body)
    val snap_before = lsp_document_snapshot_for_client_v1(client_id, uri)
    val snap_version = if snap_before.?: snap_before.unwrap().version else: -1
    val (batch, current) = lsp_diagnostics_for_uri_for_client_v1(client_id, uri, file_path)
    if current and batch.valid and batch.status == "complete":
        lsp_diag_record_batch_for_client_v1(client_id, uri, batch)
    lsp_pull_diagnostic_response_from_batch_v1(id, previous_result_id, batch, current, snap_version)

# reason: handles LSP 3.17 textDocument/diagnostic pull request routing by embedded clientId or default client
@allow(primitive_api)
pub fn lsp_handle_pull_diagnostic(id: text, body: text) -> text:
    lsp_handle_pull_diagnostic_for_client_v1(lsp_extract_client_id_v1(body), id, body)

# --- Shared source-edit core (doc/05_design/app/lsp/closure_refactor.md §3) ---
# simple/refactor/closure {closure, scope: [glob], dryRun} -> {workspaceEdit, summary}
# simple/ast/views {uri} -> {file, views: [...]}
# Both run `simple code ...` as a child; the core validates every proposal and
# the editor owns unsaved buffers, so the server returns a WorkspaceEdit and
# only writes when the caller explicitly sets dryRun=false.

fn _lsp_path_to_uri(path: text) -> text:
    val p = path.replace("\\", "/")
    if p.starts_with("/"): return "file://" + p
    if p.len() > 2 and p[1] == ":": return "file:///" + p
    p

fn _lsp_changes_with_uris(result: JsonValue) -> JsonValue:
    val edit = json_value_field(result, "workspaceEdit")
    val changes = json_value_field(edit, "changes")
    var pairs: [(text, JsonValue)] = []
    for key in json_value_keys(changes):
        pairs.push((_lsp_path_to_uri(key), json_value_field(changes, key)))
    val rewritten = json_value_object_set(edit, "changes", json_value_object_from(pairs))
    json_value_object_set(result, "workspaceEdit", rewritten)

fn _lsp_run_code_entry(args: [text]) -> (text, i64):
    # The seed demotes a file-entry run to the hybrid engine, where list
    # comprehensions yield []; pin the child to the interpreter.
    val previous = env_get("SIMPLE_EXECUTION_MODE") ?? ""
    val _ = env_set_process("SIMPLE_EXECUTION_MODE", "interpret")
    val (out, code) = lsp_run_query_command_v1(_find_simple_binary(), lsp_code_query_command_v1(args))
    val _ = env_set_process("SIMPLE_EXECUTION_MODE", previous)
    (out, code)

fn lsp_handle_refactor_closure(id: text, body: text) -> text:
    var params = JsonValue.Null
    match json_parse_value_strict(body):
        case Ok(v): params = json_value_field(v, "params")
        case Err(_): return make_error(id, -32602, "simple/refactor/closure: invalid request JSON")
    val closure = json_value_text_or(json_value_field(params, "closure"), "")
    if closure == "":
        return make_error(id, -32602, "simple/refactor/closure: `closure` (Simple source text) is required")
    var dry_run = true
    if val d = json_value_as_bool(json_value_field(params, "dryRun")): dry_run = d
    val path = get_temp_dir() + "/simple_lsp_closure_{time_now_unix_micros()}.spl"
    if not write_file(path, closure):
        return make_error(id, -32603, "simple/refactor/closure: cannot stage the closure source")
    var args: [text] = ["code", "refactor", "--closure", path, "--json"]
    for g in json_value_items(json_value_field(params, "scope")):
        val s = json_value_text_or(g, "")
        if s != "":
            args.push("--scope")
            args.push(s)
    if not dry_run: args.push("--apply")
    val (out, code) = _lsp_run_code_entry(args)
    val _ = file_delete(path)
    val payload = lsp_extract_query_json_payload(out)
    if payload == "":
        return make_error(id, -32603, "simple/refactor/closure: no result from the refactor child (exit {code})")
    match json_parse_value_strict(payload):
        case Ok(v): return make_json_result(id=id, result=json_value_serialize(_lsp_changes_with_uris(v)))
        case Err(_): return make_error(id, -32603, "simple/refactor/closure: malformed child result")

fn lsp_handle_ast_views(id: text, body: text) -> text:
    val uri = _extract_uri(body)
    val file_path = _uri_to_path(uri)
    if file_path == "":
        return make_error(id, -32602, "simple/ast/views: textDocument.uri is required")
    val (out, code) = _lsp_run_code_entry(["code", "ast", file_path, "--json"])
    val payload = lsp_extract_query_json_payload(out)
    if payload == "":
        return make_error(id, -32603, "simple/ast/views: no result (exit {code})")
    make_json_result(id=id, result=payload)

# --- MDSOC+ public view (REQ-PUBVIEW-008, 010..012) ---

fn lsp_visibility_level_known(level: text) -> bool:
    level == "public" or level == "feature_private" or level == "layer_private" or level == "all"

fn lsp_visibility_session() -> SourceVisibilitySessionV1:
    if not LSP_VISIBILITY_SESSION_READY:
        LSP_VISIBILITY_SESSION = source_visibility_session_default_v1(
            source_visibility_auto_revert_limit_v1(env_get("SIMPLE_VISIBILITY_AUTO_REVERT") ?? ""))
        LSP_VISIBILITY_SESSION_READY = true
    LSP_VISIBILITY_SESSION

pub fn lsp_visibility_level() -> text:
    lsp_visibility_session().level

# View line of the most recent symbol request (documentSymbol/workspace symbol).
var LSP_VISIBILITY_LAST_VIEW: text = "view: public"

pub fn lsp_visibility_last_view() -> text:
    LSP_VISIBILITY_LAST_VIEW

# Serve one symbol request through the session view. A per-request
# `simpleVisibility` serves once and leaves the session unchanged; a private
# session view counts down and auto-reverts to public.
fn lsp_visibility_args(body: text) -> [text]:
    var args: [text] = []
    val requested = extract_nested(json=body, key="simpleVisibility")
    val override_level = if lsp_visibility_level_known(requested): requested else: ""
    val served = source_visibility_session_serve_v1(lsp_visibility_session(),
        override_level, extract_nested(json=body, key="feature"), extract_nested(json=body, key="layer"))
    LSP_VISIBILITY_SESSION = served.session
    LSP_VISIBILITY_LAST_VIEW = served.view
    # A public session view keeps the per-file default (open module = all).
    if override_level != "" or served.level != "public":
        args.push("--visibility")
        args.push(served.level)
    if served.feature != "":
        args.push("--feature")
        args.push(served.feature)
    if served.layer != "":
        args.push("--layer")
        args.push(served.layer)
    args

# workspace/executeCommand {command: "simple.setVisibility",
#   arguments: ["<level>", {"feature": "...", "layer": "..."}?]}
pub fn lsp_handle_execute_command(id: text, body: text) -> text:
    val command = extract_nested(json=body, key="command")
    if command != "simple.setVisibility":
        return make_error(id, -32601, "unknown command: " + command)
    val arguments = extract_nested_raw(json=body, key="arguments")
    var level = ""
    for candidate in ["feature_private", "layer_private", "public", "all"]:
        if level == "" and arguments.contains(Q() + candidate + Q()): level = candidate
    if level == "":
        return make_error(id, -32602, "simple.setVisibility needs one of public, feature_private, layer_private, all")
    val next = source_visibility_session_set_v1(lsp_visibility_session(), level,
        extract_nested(json=body, key="feature"), extract_nested(json=body, key="layer"))
    LSP_VISIBILITY_SESSION = next
    val view = if next.level == "public": "view: public (session)" else: "view: " + next.level + " (session), auto-revert after " + str(next.limit) + " requests; set visibility=public to return"
    make_json_result(id=id, result=jo2(jp("visibility", js(next.level)), jp("view", js(view))))

fn lsp_hidden_summary_payload(file_path: text) -> text:
    var args: [text] = ["hidden-summary", lsp_query_file_argument_v1(file_path)]
    val session_level = lsp_visibility_session().level
    if session_level != "public":
        args.push("--visibility")
        args.push(session_level)
    var out = ""
    var exit_code: i64 = 0
    (out, exit_code) = lsp_run_query_command_v1(_find_simple_binary(), lsp_visibility_query_command_v1(args))
    val payload = lsp_extract_query_json_payload(out)
    if exit_code != 0 or payload == "": return ""
    payload

# simple/hiddenSummary {textDocument: {uri}} -> the file's hidden summary.
pub fn lsp_handle_hidden_summary(id: text, body: text) -> text:
    val file_path = _uri_to_path(_extract_uri(body))
    if file_path == "":
        return make_json_result(id=id, result="null")
    val payload = lsp_hidden_summary_payload(file_path)
    if payload == "":
        return make_json_result(id=id, result="null")
    make_json_result(id=id, result=payload)

# Hover on the module header (line 0) or on a position with no symbol answers
# with the file's hidden summary so a reader learns what the listing hides.
fn lsp_hover_hidden_summary_result(file_path: text) -> text:
    val payload = lsp_hidden_summary_payload(file_path)
    if payload == "": return "null"
    val hint = extract_field(json=payload, key="hint")
    val default_rule = extract_field(json=payload, key="visibility_default")
    if hint == "": return "null"
    val value = hint + "\n\nvisibility_default: " + default_rule
    jo1(jp("contents", jo2(jp("kind", js("markdown")), jp("value", js(value)))))
