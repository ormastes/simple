# Resident LSP visibility provider contract.
# The protocol owns document revisions; the app owns semantic visibility.

enum LspVisibilitySourceStatusV1:
    Ready
    Missing
    OpenPending
    Unavailable

enum LspVisibilityQueryStatusV1:
    Ready
    Pending
    Unavailable

struct LspVisibilitySourceV1:
    status: LspVisibilitySourceStatusV1
    path: text
    uri: text
    source_kind: text       # "overlay" or "disk"
    content: text
    version: i64
    lifetime_generation: i64
    overlay_generation: i64

struct LspVisibilitySourceReaderV1:
    read: fn(text) -> LspVisibilitySourceV1

struct LspVisibilitySnapshotV1:
    uri: text
    path: text
    version: i64
    lifetime_generation: i64
    overlay_generation: i64

struct LspVisibilityQueryRequestV1:
    snapshot: LspVisibilitySnapshotV1
    requester_path: text
    visibility: text
    feature: text
    layer: text

struct LspVisibilityDependencyV1:
    path: text
    uri: text
    source_kind: text
    version: i64
    lifetime_generation: i64
    content_snapshot: text

struct LspVisibilityQueryResultV1:
    status: LspVisibilityQueryStatusV1
    payload: text
    diagnostic: text
    overlay_generation: i64
    dependencies: [LspVisibilityDependencyV1]

struct LspVisibilityQueryProviderV1:
    query: fn(LspVisibilityQueryRequestV1, LspVisibilitySourceReaderV1) -> LspVisibilityQueryResultV1

pub fn lsp_visibility_source_missing_v1(path: text, generation: i64) -> LspVisibilitySourceV1:
    LspVisibilitySourceV1(LspVisibilitySourceStatusV1.Missing, path, "", "", "", -1, -1, generation)

pub fn lsp_visibility_source_pending_v1(path: text, uri: text, generation: i64) -> LspVisibilitySourceV1:
    LspVisibilitySourceV1(LspVisibilitySourceStatusV1.OpenPending, path, uri, "overlay", "", -1, -1, generation)

pub fn lsp_visibility_source_unavailable_v1(path: text, generation: i64) -> LspVisibilitySourceV1:
    LspVisibilitySourceV1(LspVisibilitySourceStatusV1.Unavailable, path, "", "", "", -1, -1, generation)

export LspVisibilitySourceStatusV1, LspVisibilityQueryStatusV1
export LspVisibilitySourceV1, LspVisibilitySourceReaderV1, LspVisibilitySnapshotV1
export LspVisibilityQueryRequestV1, LspVisibilityDependencyV1, LspVisibilityQueryResultV1
export LspVisibilityQueryProviderV1
export lsp_visibility_source_missing_v1, lsp_visibility_source_pending_v1
export lsp_visibility_source_unavailable_v1
