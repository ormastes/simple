# Live protocol adapter over the existing LspServer document owner.
# Full synchronization is advertised (change=1); incremental ranges are rejected.
# Supports explicit per-client overlay isolation via `client_id` (defaulting to
# `"default"` for single-client callers).
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_field, json_value_has, json_value_text_or}
use std.nogc_sync_mut.lsp.server.{LspServer, DocumentInfo}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.io_runtime.{file_exists}
use std.nogc_sync_mut.lsp.lsp_file_uri.{lsp_file_uri_to_path, lsp_query_file_argument_v1}
use std.nogc_sync_mut.lsp.lsp_visibility_provider_v1.{
    LspVisibilitySourceStatusV1, LspVisibilitySourceV1, LspVisibilitySourceReaderV1,
    LspVisibilitySnapshotV1, LspVisibilityDependencyV1
}

var LSP_DOCUMENT_OWNER = LspServer.create()
var LSP_CLIENT_SYNC_IDS: [text] = []
var LSP_CLIENT_SYNC_OWNERS: [LspServer] = []

fn _norm_client_id(client_id: text) -> text:
    val trimmed = client_id.trim()
    if trimmed == "": "default" else: trimmed

fn _find_client_owner_index(norm_id: text) -> i64:
    var i = 0
    while i < LSP_CLIENT_SYNC_IDS.len():
        if LSP_CLIENT_SYNC_IDS[i] == norm_id:
            return i
        i = i + 1
    -1

fn _ensure_client_owner_index(norm_id: text) -> i64:
    val existing = _find_client_owner_index(norm_id)
    if existing >= 0:
        return existing
    LSP_CLIENT_SYNC_IDS.push(norm_id)
    LSP_CLIENT_SYNC_OWNERS.push(LspServer.create())
    LSP_CLIENT_SYNC_IDS.len() - 1

fn _invalidate_client_doc(norm_id: text, uri: text, version: i64):
    if norm_id == "default":
        LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
        return
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return
    var owner = LSP_CLIENT_SYNC_OWNERS[idx]
    owner.invalidate_doc(uri, version)
    LSP_CLIENT_SYNC_OWNERS[idx] = owner

fn _invalidate_client_doc_unknown_version(norm_id: text, uri: text):
    if norm_id == "default":
        LSP_DOCUMENT_OWNER.invalidate_doc_unknown_version(uri)
        return
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return
    var owner = LSP_CLIENT_SYNC_OWNERS[idx]
    owner.invalidate_doc_unknown_version(uri)
    LSP_CLIENT_SYNC_OWNERS[idx] = owner

# reason: bounded disk source read takes protocol file path text
@allow(primitive_api)
pub fn lsp_read_analyzed_source(path: text) -> Result<text, text>:
    # Admission happens on the opened regular file before allocation/decoding;
    # a disk file that grew after didOpen cannot evade the editor byte ceiling.
    file_read_regular_no_follow_bounded(path, 1048576)

# reason: extracts LSP client identifier string from JSON-RPC notification or request body
@allow(primitive_api)
pub fn lsp_extract_client_id_v1(body: text) -> text:
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return "default"
    val message = parsed.unwrap()
    val top = json_value_text_or(json_value_field(message, "clientId"), "")
    if top.trim() != "":
        return top.trim()
    if json_value_has(message, "params"):
        val params = json_value_field(message, "params")
        val nested = json_value_text_or(json_value_field(params, "clientId"), "")
        if nested.trim() != "":
            return nested.trim()
    "default"

# reason: per-client LSP didOpen overlay registration uses wire client_id, URI, version, and source text
@allow(primitive_api)
pub fn lsp_document_open_for_client_v1(client_id: text, uri: text, version: i64, content: text) -> bool:
    val norm_id = _norm_client_id(client_id)
    if norm_id == "default":
        return LSP_DOCUMENT_OWNER.open_doc(uri, version, content)
    val idx = _ensure_client_owner_index(norm_id)
    var owner = LSP_CLIENT_SYNC_OWNERS[idx]
    val ok = owner.open_doc(uri, version, content)
    LSP_CLIENT_SYNC_OWNERS[idx] = owner
    ok

# reason: per-client LSP didChange full-sync replacement uses wire client_id, URI, version, and source text
@allow(primitive_api)
pub fn lsp_document_change_for_client_v1(client_id: text, uri: text, version: i64, content: text) -> bool:
    val norm_id = _norm_client_id(client_id)
    if norm_id == "default":
        return LSP_DOCUMENT_OWNER.update_doc(uri, version, content)
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return false
    var owner = LSP_CLIENT_SYNC_OWNERS[idx]
    val ok = owner.update_doc(uri, version, content)
    LSP_CLIENT_SYNC_OWNERS[idx] = owner
    ok

# reason: per-client LSP didClose eviction uses wire client_id and URI strings
@allow(primitive_api)
pub fn lsp_document_close_for_client_v1(client_id: text, uri: text) -> bool:
    val norm_id = _norm_client_id(client_id)
    if norm_id == "default":
        if LSP_DOCUMENT_OWNER.find_doc(uri) < 0: return false
        LSP_DOCUMENT_OWNER.close_doc(uri)
        return true
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return false
    var owner = LSP_CLIENT_SYNC_OWNERS[idx]
    if owner.find_doc(uri) < 0: return false
    owner.close_doc(uri)
    LSP_CLIENT_SYNC_OWNERS[idx] = owner
    true

# reason: per-client synchronized overlay snapshot lookup by wire client_id and URI
@allow(primitive_api)
pub fn lsp_document_snapshot_for_client_v1(client_id: text, uri: text) -> DocumentInfo?:
    val norm_id = _norm_client_id(client_id)
    if norm_id == "default":
        if not LSP_DOCUMENT_OWNER.doc_is_synchronized(uri): return None
        return Some(LSP_DOCUMENT_OWNER.get_doc(uri))
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return None
    val owner = LSP_CLIENT_SYNC_OWNERS[idx]
    if not owner.doc_is_synchronized(uri): return None
    Some(owner.get_doc(uri))

# reason: per-client synchronized overlay lookup by normalized file path for multi-file fix validation
@allow(primitive_api)
pub fn lsp_document_snapshot_by_path_for_client_v1(client_id: text, path: text) -> DocumentInfo?:
    val norm_id = _norm_client_id(client_id)
    val logical = lsp_query_file_argument_v1(path)
    if norm_id == "default":
        var i = 0
        while i < LSP_DOCUMENT_OWNER.doc_uris.len():
            val u = LSP_DOCUMENT_OWNER.doc_uris[i]
            if lsp_query_file_argument_v1(lsp_file_uri_to_path(u)) == logical:
                if not LSP_DOCUMENT_OWNER.doc_is_synchronized(u): return None
                return Some(LSP_DOCUMENT_OWNER.get_doc(u))
            i = i + 1
        return None
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return None
    val owner = LSP_CLIENT_SYNC_OWNERS[idx]
    var j = 0
    while j < owner.doc_uris.len():
        val u = owner.doc_uris[j]
        if lsp_query_file_argument_v1(lsp_file_uri_to_path(u)) == logical:
            if not owner.doc_is_synchronized(u): return None
            return Some(owner.get_doc(u))
        j = j + 1
    None

# reason: checks whether client holds an open but unsynchronized buffer for path to block disk substitution
@allow(primitive_api)
pub fn lsp_document_has_unsynchronized_path_for_client_v1(client_id: text, path: text) -> bool:
    val norm_id = _norm_client_id(client_id)
    val logical = lsp_query_file_argument_v1(path)
    if norm_id == "default":
        var i = 0
        while i < LSP_DOCUMENT_OWNER.doc_uris.len():
            val u = LSP_DOCUMENT_OWNER.doc_uris[i]
            if lsp_query_file_argument_v1(lsp_file_uri_to_path(u)) == logical:
                return not LSP_DOCUMENT_OWNER.doc_is_synchronized(u)
            i = i + 1
        return false
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return false
    val owner = LSP_CLIENT_SYNC_OWNERS[idx]
    var j = 0
    while j < owner.doc_uris.len():
        val u = owner.doc_uris[j]
        if lsp_query_file_argument_v1(lsp_file_uri_to_path(u)) == logical:
            return not owner.doc_is_synchronized(u)
        j = j + 1
    false

# reason: default-client synchronized overlay snapshot lookup by URI
@allow(primitive_api)
pub fn lsp_document_snapshot(uri: text) -> DocumentInfo?:
    lsp_document_snapshot_for_client_v1("default", uri)

# reason: per-client snapshot currency predicate against active document lifetime and version
@allow(primitive_api)
pub fn lsp_document_snapshot_matches_for_client_v1(client_id: text, snapshot: DocumentInfo) -> bool:
    val current: DocumentInfo? = lsp_document_snapshot_for_client_v1(client_id, snapshot.uri)
    if not current.?: return false
    val value = current.unwrap()
    value.lifetime_generation == snapshot.lifetime_generation and value.version == snapshot.version and value.content == snapshot.content

# reason: default-client snapshot currency predicate
@allow(primitive_api)
pub fn lsp_document_snapshot_matches(snapshot: DocumentInfo) -> bool:
    lsp_document_snapshot_matches_for_client_v1("default", snapshot)

# reason: per-client LSP protocol overlay generation counter
@allow(primitive_api)
pub fn lsp_document_overlay_generation_for_client_v1(client_id: text) -> i64:
    val norm_id = _norm_client_id(client_id)
    if norm_id == "default":
        return LSP_DOCUMENT_OWNER.overlay_generation
    val idx = _find_client_owner_index(norm_id)
    if idx < 0: return 0
    LSP_CLIENT_SYNC_OWNERS[idx].overlay_generation

# reason: default-client LSP protocol overlay generation counter
@allow(primitive_api)
pub fn lsp_document_overlay_generation_v1() -> i64:
    lsp_document_overlay_generation_for_client_v1("default")

# reason: captures visibility snapshot metadata for URI and path
@allow(primitive_api)
pub fn lsp_visibility_snapshot_v1(uri: text, path: text) -> LspVisibilitySnapshotV1?:
    val snapshot = lsp_document_snapshot(uri)
    if not snapshot.?: return None
    val value = snapshot.unwrap()
    Some(LspVisibilitySnapshotV1(uri, lsp_query_file_argument_v1(path), value.version,
        value.lifetime_generation, lsp_document_overlay_generation_v1()))

# reason: revision-validation predicate for visibility snapshot
@allow(primitive_api)
pub fn lsp_visibility_snapshot_current_v1(snapshot: LspVisibilitySnapshotV1) -> bool:
    val current = lsp_document_snapshot(snapshot.uri)
    # Document versions are signed; the lifetime distinguishes disk snapshots.
    if snapshot.lifetime_generation < 0:
        return not current.?
    if not current.?: return false
    val value = current.unwrap()
    value.version == snapshot.version and value.lifetime_generation == snapshot.lifetime_generation

# reason: visibility source read by protocol path text
@allow(primitive_api)
pub fn lsp_visibility_source_read_v1(path: text) -> LspVisibilitySourceV1:
    val logical = lsp_query_file_argument_v1(path)
    var index = 0
    while index < LSP_DOCUMENT_OWNER.doc_uris.len():
        val uri = LSP_DOCUMENT_OWNER.doc_uris[index]
        val open_path = lsp_file_uri_to_path(uri)
        if lsp_query_file_argument_v1(open_path) == logical:
            val generation = lsp_document_overlay_generation_v1()
            if not LSP_DOCUMENT_OWNER.doc_is_synchronized(uri):
                return LspVisibilitySourceV1(
                    status: LspVisibilitySourceStatusV1.OpenPending, path: logical,
                    uri: uri, source_kind: "overlay", content: "", version: -1,
                    lifetime_generation: -1, overlay_generation: generation)
            val doc = LSP_DOCUMENT_OWNER.get_doc(uri)
            return LspVisibilitySourceV1(
                status: LspVisibilitySourceStatusV1.Ready, path: logical, uri: uri,
                source_kind: "overlay", content: doc.content, version: doc.version,
                lifetime_generation: doc.lifetime_generation, overlay_generation: generation)
        index = index + 1
    val generation = lsp_document_overlay_generation_v1()
    if not file_exists(logical):
        return LspVisibilitySourceV1(
            status: LspVisibilitySourceStatusV1.Missing, path: logical, uri: "",
            source_kind: "", content: "", version: -1,
            lifetime_generation: -1, overlay_generation: generation)
    match lsp_read_analyzed_source(logical):
        case Ok(content):
            LspVisibilitySourceV1(
                status: LspVisibilitySourceStatusV1.Ready, path: logical, uri: "",
                source_kind: "disk", content: content, version: -1,
                lifetime_generation: -1, overlay_generation: generation)
        case Err(_):
            LspVisibilitySourceV1(
                status: LspVisibilitySourceStatusV1.Unavailable, path: logical, uri: "",
                source_kind: "", content: "", version: -1,
                lifetime_generation: -1, overlay_generation: generation)

pub fn lsp_visibility_source_reader_v1() -> LspVisibilitySourceReaderV1:
    LspVisibilitySourceReaderV1(lsp_visibility_source_read_v1)

# reason: revision-validation predicate over dependency snapshots
@allow(primitive_api)
pub fn lsp_visibility_dependencies_current_v1(dependencies: [LspVisibilityDependencyV1]) -> bool:
    for dependency in dependencies:
        if dependency.source_kind == "overlay":
            val snapshot = lsp_document_snapshot(dependency.uri)
            if not snapshot.?: return false
            val value = snapshot.unwrap()
            if value.version != dependency.version or
                    value.lifetime_generation != dependency.lifetime_generation or
                    value.content != dependency.content_snapshot:
                return false
        elif dependency.source_kind == "disk":
            val source = lsp_visibility_source_read_v1(dependency.path)
            if source.status != LspVisibilitySourceStatusV1.Ready or
                    source.source_kind != "disk" or
                    source.content != dependency.content_snapshot:
                return false
        elif dependency.source_kind == "missing":
            if lsp_visibility_source_read_v1(dependency.path).status != LspVisibilitySourceStatusV1.Missing:
                return false
        else:
            return false
    true

# reason: extracts textDocument.uri string from LSP JSON-RPC notification payload
@allow(primitive_api)
pub fn lsp_document_sync_uri(body: text) -> text:
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return ""
    val message = parsed.unwrap()
    var params = json_value_field(message, "params")
    if not json_value_has(message, "params"): params = message
    val document = json_value_field(params, "textDocument")
    json_value_text_or(json_value_field(document, "uri"), "")

# reason: applies LSP full-sync notification JSON for a specific client_id
@allow(primitive_api)
pub fn lsp_document_sync_apply_for_client_v1(client_id: text, method: text, body: text) -> bool:
    val norm_id = _norm_client_id(client_id)
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return false
    val message = parsed.unwrap()
    var params = json_value_field(message, "params")
    if not json_value_has(message, "params"): params = message
    val document = json_value_field(params, "textDocument")
    val uri = json_value_text_or(json_value_field(document, "uri"), "")
    if uri == "": return false
    if method == "textDocument/didClose":
        return lsp_document_close_for_client_v1(norm_id, uri)
    var version: i64 = 0
    match json_value_field(document, "version"):
        case Int(value): version = value
        case _:
            if method == "textDocument/didChange" or method == "textDocument/didOpen":
                _invalidate_client_doc_unknown_version(norm_id, uri)
            return false
    if method == "textDocument/didOpen":
        match json_value_field(document, "text"):
            case Str(content): return lsp_document_open_for_client_v1(norm_id, uri, version, content)
            case _:
                _invalidate_client_doc(norm_id, uri, version)
                return false
    if method != "textDocument/didChange": return false
    # Retain accepted bytes/version, but revoke authority after a malformed
    # newer change. Only a valid full sync at/after that version restores it.
    var source = ""
    match json_value_field(params, "contentChanges"):
        case Array(changes):
            if changes.len() == 0:
                _invalidate_client_doc(norm_id, uri, version)
                return false
            for change in changes:
                if json_value_has(change, "range") or json_value_has(change, "rangeLength"):
                    _invalidate_client_doc(norm_id, uri, version)
                    return false
                match json_value_field(change, "text"):
                    case Str(content): source = content
                    case _:
                        _invalidate_client_doc(norm_id, uri, version)
                        return false
        case _:
            _invalidate_client_doc(norm_id, uri, version)
            return false
    lsp_document_change_for_client_v1(norm_id, uri, version, source)

# reason: applies LSP full-sync notification JSON routing by embedded clientId or default client
@allow(primitive_api)
pub fn lsp_document_sync_apply(method: text, body: text) -> bool:
    lsp_document_sync_apply_for_client_v1(lsp_extract_client_id_v1(body), method, body)
