# Live protocol adapter over the existing LspServer document owner.
# Full synchronization is advertised (change=1); incremental ranges are rejected.
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_field, json_value_has, json_value_text_or}
use std.nogc_sync_mut.lsp.server.{LspServer, DocumentInfo}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}

var LSP_DOCUMENT_OWNER = LspServer.create()

pub fn lsp_read_analyzed_source(path: text) -> Result<text, text>:
    # Admission happens on the opened regular file before allocation/decoding;
    # a disk file that grew after didOpen cannot evade the editor byte ceiling.
    file_read_regular_no_follow_bounded(path, 1048576)

pub fn lsp_document_snapshot(uri: text) -> DocumentInfo?:
    if not LSP_DOCUMENT_OWNER.doc_is_synchronized(uri): return nil
    Some(LSP_DOCUMENT_OWNER.get_doc(uri))

pub fn lsp_document_snapshot_matches(snapshot: DocumentInfo) -> bool:
    val current = lsp_document_snapshot(snapshot.uri)
    if current == nil: return false
    val value = current.unwrap()
    value.lifetime_generation == snapshot.lifetime_generation and value.version == snapshot.version and value.content == snapshot.content

pub fn lsp_document_sync_uri(body: text) -> text:
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return ""
    val message = parsed.unwrap()
    var params = json_value_field(message, "params")
    if not json_value_has(message, "params"): params = message
    val document = json_value_field(params, "textDocument")
    json_value_text_or(json_value_field(document, "uri"), "")

pub fn lsp_document_sync_apply(method: text, body: text) -> bool:
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return false
    val message = parsed.unwrap()
    var params = json_value_field(message, "params")
    if not json_value_has(message, "params"): params = message
    val document = json_value_field(params, "textDocument")
    val uri = json_value_text_or(json_value_field(document, "uri"), "")
    if uri == "": return false
    if method == "textDocument/didClose":
        if LSP_DOCUMENT_OWNER.find_doc(uri) < 0: return false
        LSP_DOCUMENT_OWNER.close_doc(uri)
        return true
    var version: i64 = 0
    match json_value_field(document, "version"):
        case Int(value): version = value
        case _:
            if method == "textDocument/didChange": LSP_DOCUMENT_OWNER.invalidate_doc_unknown_version(uri)
            return false
    if method == "textDocument/didOpen":
        match json_value_field(document, "text"):
            case Str(content): return LSP_DOCUMENT_OWNER.open_doc(uri, version, content)
            case _: return false
    if method != "textDocument/didChange": return false
    # Retain accepted bytes/version, but revoke authority after a malformed
    # newer change. Only a valid full sync at/after that version restores it.
    # Validate the entire notification before mutating source content. Each full
    # replacement supersedes the preceding one; the last is the new document.
    var source = ""
    match json_value_field(params, "contentChanges"):
        case Array(changes):
            if changes.len() == 0:
                LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                return false
            for change in changes:
                if json_value_has(change, "range") or json_value_has(change, "rangeLength"):
                    LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                    return false
                match json_value_field(change, "text"):
                    case Str(content): source = content
                    case _:
                        LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                        return false
        case _:
            LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
            return false
    LSP_DOCUMENT_OWNER.update_doc(uri, version, source)

# Capture the complete owner set: invalid imports must not silently fall back
# to disk. This is an immutable value copy on the single LSP dispatch owner.
use std.common.diagnostics.source_analysis_v1.*
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.lsp.lsp_file_uri.{lsp_file_uri_to_path}
use std.nogc_sync_mut.fs.host_path.{host_path_canonical}

pub fn lsp_document_generation_v1() -> i64:
    LSP_DOCUMENT_OWNER.overlay_generation

pub fn lsp_document_capture_v1(uri: text, run_id: text, workspace_root: text,
        workspace_identity: text, owner_id: text, environment: SourceAnalysisEnvironmentV1) -> Result<SourceAnalysisRequestV1, text>:
    if not LSP_DOCUMENT_OWNER.doc_is_synchronized(uri): return Err("entry overlay is not synchronized")
    var documents: [SourceAnalysisDocumentV1] = []
    var paths: [text] = []
    var index = 0
    while index < LSP_DOCUMENT_OWNER.doc_uris.len():
        if not LSP_DOCUMENT_OWNER.doc_sync_valid[index]: return Err("overlay set contains an unsynchronized document")
        val document_uri = LSP_DOCUMENT_OWNER.doc_uris[index]
        if not document_uri.starts_with("file://"): return Err("overlay set contains unsupported URI")
        val path = host_path_canonical(lsp_file_uri_to_path(document_uri))
        if paths.contains(path): return Err("multiple overlay URIs resolve to one path")
        paths.push(path)
        val source = LSP_DOCUMENT_OWNER.doc_contents[index]
        documents.push(SourceAnalysisDocumentV1(path: path, uri: document_uri,
            version: LSP_DOCUMENT_OWNER.doc_versions[index], source: source, digest: sha256_text(source)))
        index = index + 1
    Ok(SourceAnalysisRequestV1(run_id: run_id, workspace_root: workspace_root,
        workspace_identity: workspace_identity, owner_id: owner_id,
        lifetime_generation: LSP_DOCUMENT_OWNER.overlay_generation,
        entry_path: host_path_canonical(lsp_file_uri_to_path(uri)), documents: documents,
        environment: environment, bounds: SourceAnalysisBoundsV1()))

pub fn lsp_document_capture_matches_v1(request: SourceAnalysisRequestV1) -> bool:
    if request.lifetime_generation != LSP_DOCUMENT_OWNER.overlay_generation: return false
    if request.documents.len() != LSP_DOCUMENT_OWNER.doc_uris.len(): return false
    for document in request.documents:
        val current = lsp_document_snapshot(document.uri)
        if current == nil: return false
        val value = current.unwrap()
        if value.version != document.version or value.content != document.source: return false
    true

pub fn lsp_document_uris_v1() -> [text]:
    LSP_DOCUMENT_OWNER.doc_uris
