# Live protocol adapter over the existing LspServer document owner.
# Full synchronization is advertised (change=1); incremental ranges are rejected.
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_field, json_value_has, json_value_text_or}
use std.nogc_sync_mut.lsp.server.{LspServer, DocumentInfo}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.io_runtime.{file_exists}
use std.nogc_sync_mut.lsp.lsp_file_uri.{lsp_file_uri_to_path, lsp_query_file_argument_v1}
use std.nogc_sync_mut.lsp.lsp_visibility_provider_v1.{
    LspVisibilitySourceStatusV1, LspVisibilitySourceV1, LspVisibilitySourceReaderV1,
    LspVisibilitySnapshotV1, LspVisibilityDependencyV1
}

var LSP_DOCUMENT_OWNER = LspServer.create()

pub fn lsp_read_analyzed_source(path: text) -> Result<text, text>:
    # Admission happens on the opened regular file before allocation/decoding;
    # a disk file that grew after didOpen cannot evade the editor byte ceiling.
    file_read_regular_no_follow_bounded(path, 1048576)

pub fn lsp_document_snapshot(uri: text) -> DocumentInfo?:
    if not LSP_DOCUMENT_OWNER.doc_is_synchronized(uri): return nil
    Some(LSP_DOCUMENT_OWNER.get_doc(uri))

pub fn lsp_document_snapshot_matches(snapshot: DocumentInfo) -> bool:
    val current = lsp_document_snapshot(snapshot.uri)
    if current == nil: return false
    val value = current.unwrap()
    value.lifetime_generation == snapshot.lifetime_generation and value.version == snapshot.version and value.content == snapshot.content

pub fn lsp_document_overlay_generation_v1() -> i64:
    LSP_DOCUMENT_OWNER.overlay_generation

pub fn lsp_visibility_snapshot_v1(uri: text, path: text) -> LspVisibilitySnapshotV1?:
    val snapshot = lsp_document_snapshot(uri)
    if snapshot == nil: return nil
    val value = snapshot.unwrap()
    Some(LspVisibilitySnapshotV1(uri, lsp_query_file_argument_v1(path), value.version,
        value.lifetime_generation, lsp_document_overlay_generation_v1()))

pub fn lsp_visibility_snapshot_current_v1(snapshot: LspVisibilitySnapshotV1) -> bool:
    val current = lsp_document_snapshot(snapshot.uri)
    # Document versions are signed; the lifetime distinguishes disk snapshots.
    if snapshot.lifetime_generation < 0:
        return current == nil
    if current == nil: return false
    val value = current.unwrap()
    value.version == snapshot.version and value.lifetime_generation == snapshot.lifetime_generation

pub fn lsp_visibility_source_read_v1(path: text) -> LspVisibilitySourceV1:
    val logical = lsp_query_file_argument_v1(path)
    var index = 0
    while index < LSP_DOCUMENT_OWNER.doc_uris.len():
        val uri = LSP_DOCUMENT_OWNER.doc_uris[index]
        val open_path = lsp_file_uri_to_path(uri)
        if lsp_query_file_argument_v1(open_path) == logical:
            val generation = lsp_document_overlay_generation_v1()
            if not LSP_DOCUMENT_OWNER.doc_is_synchronized(uri):
                return LspVisibilitySourceV1(
                    status: LspVisibilitySourceStatusV1.OpenPending, path: logical,
                    uri: uri, source_kind: "overlay", content: "", version: -1,
                    lifetime_generation: -1, overlay_generation: generation)
            val doc = LSP_DOCUMENT_OWNER.get_doc(uri)
            return LspVisibilitySourceV1(
                status: LspVisibilitySourceStatusV1.Ready, path: logical, uri: uri,
                source_kind: "overlay", content: doc.content, version: doc.version,
                lifetime_generation: doc.lifetime_generation, overlay_generation: generation)
        index = index + 1
    val generation = lsp_document_overlay_generation_v1()
    if not file_exists(logical):
        return LspVisibilitySourceV1(
            status: LspVisibilitySourceStatusV1.Missing, path: logical, uri: "",
            source_kind: "", content: "", version: -1,
            lifetime_generation: -1, overlay_generation: generation)
    match lsp_read_analyzed_source(logical):
        case Ok(content):
            LspVisibilitySourceV1(
                status: LspVisibilitySourceStatusV1.Ready, path: logical, uri: "",
                source_kind: "disk", content: content, version: -1,
                lifetime_generation: -1, overlay_generation: generation)
        case Err(_):
            LspVisibilitySourceV1(
                status: LspVisibilitySourceStatusV1.Unavailable, path: logical, uri: "",
                source_kind: "", content: "", version: -1,
                lifetime_generation: -1, overlay_generation: generation)

pub fn lsp_visibility_source_reader_v1() -> LspVisibilitySourceReaderV1:
    LspVisibilitySourceReaderV1(lsp_visibility_source_read_v1)

pub fn lsp_visibility_dependencies_current_v1(dependencies: [LspVisibilityDependencyV1]) -> bool:
    for dependency in dependencies:
        if dependency.source_kind == "overlay":
            val snapshot = lsp_document_snapshot(dependency.uri)
            if snapshot == nil: return false
            val value = snapshot.unwrap()
            if value.version != dependency.version or
                    value.lifetime_generation != dependency.lifetime_generation or
                    value.content != dependency.content_snapshot:
                return false
        elif dependency.source_kind == "disk":
            val source = lsp_visibility_source_read_v1(dependency.path)
            if source.status != LspVisibilitySourceStatusV1.Ready or
                    source.source_kind != "disk" or
                    source.content != dependency.content_snapshot:
                return false
        elif dependency.source_kind == "missing":
            if lsp_visibility_source_read_v1(dependency.path).status != LspVisibilitySourceStatusV1.Missing:
                return false
        else:
            return false
    true

pub fn lsp_document_sync_uri(body: text) -> text:
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return ""
    val message = parsed.unwrap()
    var params = json_value_field(message, "params")
    if not json_value_has(message, "params"): params = message
    val document = json_value_field(params, "textDocument")
    json_value_text_or(json_value_field(document, "uri"), "")

pub fn lsp_document_sync_apply(method: text, body: text) -> bool:
    val parsed = json_parse_value_strict(body)
    if parsed.is_err(): return false
    val message = parsed.unwrap()
    var params = json_value_field(message, "params")
    if not json_value_has(message, "params"): params = message
    val document = json_value_field(params, "textDocument")
    val uri = json_value_text_or(json_value_field(document, "uri"), "")
    if uri == "": return false
    if method == "textDocument/didClose":
        if LSP_DOCUMENT_OWNER.find_doc(uri) < 0: return false
        LSP_DOCUMENT_OWNER.close_doc(uri)
        return true
    var version: i64 = 0
    match json_value_field(document, "version"):
        case Int(value): version = value
        case _:
            if method == "textDocument/didChange" or method == "textDocument/didOpen":
                LSP_DOCUMENT_OWNER.invalidate_doc_unknown_version(uri)
            return false
    if method == "textDocument/didOpen":
        match json_value_field(document, "text"):
            case Str(content): return LSP_DOCUMENT_OWNER.open_doc(uri, version, content)
            case _:
                LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                return false
    if method != "textDocument/didChange": return false
    # Retain accepted bytes/version, but revoke authority after a malformed
    # newer change. Only a valid full sync at/after that version restores it.
    # Validate the entire notification before mutating source content. Each full
    # replacement supersedes the preceding one; the last is the new document.
    var source = ""
    match json_value_field(params, "contentChanges"):
        case Array(changes):
            if changes.len() == 0:
                LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                return false
            for change in changes:
                if json_value_has(change, "range") or json_value_has(change, "rangeLength"):
                    LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                    return false
                match json_value_field(change, "text"):
                    case Str(content): source = content
                    case _:
                        LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
                        return false
        case _:
            LSP_DOCUMENT_OWNER.invalidate_doc(uri, version)
            return false
    LSP_DOCUMENT_OWNER.update_doc(uri, version, source)
