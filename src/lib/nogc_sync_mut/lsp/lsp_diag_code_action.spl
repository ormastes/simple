# LSP codeAction + codeAction/resolve wiring over the typed fix model
# (REQ-DIAG-011, Wave F5 §10.2, §11.2, I01, I02).
# Lists come from ranked_candidates_for(); disabled / Unavailable candidates
# (PERF-FIX-001) surface with `disabled.reason`; PERF-STYLE-001 style assists
# emit `kind: "refactor.rewrite"`; and codeAction/resolve revalidates BOTH
# per-file (version, source_hash) (I01) and server-side semantic_fingerprint (I02)
# before emitting a versioned WorkspaceEdit without mutating files.
use std.common.crypto.sha256.{sha256_text}
use std.common.string_core.{char_from_code}
use std.common.json.serializer.{json_escape_string}
use std.common.json.value.{
    JsonValue,
    json_parse_value_strict,
    json_value_field,
    json_value_has,
    json_value_as_i64,
    json_value_text_or,
    json_value_object_from,
    json_value_serialize
}
use std.common.diagnostics.diagnostic_batch.{FixCandidate, DiagnosticActionIndex}
use std.common.diagnostics.fix_ranking.{ranked_candidates_for}
use std.common.diagnostics.fix_transaction.{EditTransaction, ApplyResult, DocumentSnapshot}
use std.common.diagnostics.source_position.{LineStartTable, byte_to_position, span_to_range}
use std.nogc_sync_mut.lsp.lsp_file_uri.{lsp_file_uri_to_path}
use std.nogc_sync_mut.lsp.lsp_diag_action_store.{
    LspDiagActionEntry,
    lsp_diag_action_store_last_valid_for_client_v1,
    lsp_diag_candidate_meta_lookup_v1,
    lsp_perf_get_semantic_fingerprint_for_client_v1
}
use std.nogc_sync_mut.lsp.lsp_perf_presentation_v1.{
    LspClientCodeActionCapsV1,
    lsp_get_client_code_action_caps_for_client_v1,
    lsp_perf_code_action_kind_v1
}
use std.nogc_sync_mut.lsp.lsp_document_sync.{
    lsp_document_snapshot_for_client_v1,
    lsp_document_snapshot_by_path_for_client_v1,
    lsp_document_has_unsynchronized_path_for_client_v1,
    lsp_read_analyzed_source
}

pub struct LspLiveActionOutcomeV1:
    status: text
    actions_json: text
    refusal_reason: text

fn jstr(s: text) -> text:
    "\"" + json_escape_string(s) + "\""

fn _lbrace() -> text:
    char_from_code(123)

fn _rbrace() -> text:
    char_from_code(125)

fn _file_uri_for_path(f: text) -> text:
    if f.starts_with("file://"):
        return f
    val norm = f.replace("\\", "/")
    if norm.starts_with("/"):
        return "file://" + norm
    "file:///" + norm

# Byte offset -> (line, UTF-16 character); (-1, -1) for an offset that is out
# of range or splits a UTF-8 scalar.
# reason: converts UTF-8 byte offset in source text to LSP zero-based (line, character) pair
@allow(primitive_api)
pub fn lsp_byte_offset_position(body: text, offset: i64) -> (i64, i64):
    match byte_to_position(body, LineStartTable.build(body), offset):
        Some(p): (p.line, p.character)
        None: (-1, -1)

fn _rule_prefix_from_diag_id(diagnostic_id: text) -> text:
    val at_idx = diagnostic_id.index_of("@")
    if at_idx > 0:
        return diagnostic_id.substring(0, at_idx)
    diagnostic_id

fn _candidate_lsp_kind(entry: LspDiagActionEntry, diagnostic_id: text, c: FixCandidate) -> text:
    var rule_code = _rule_prefix_from_diag_id(diagnostic_id)
    var fix_kind = ""
    match lsp_diag_candidate_meta_lookup_v1(entry, c.id):
        case Some(meta):
            if meta.rule_code != "":
                rule_code = meta.rule_code
            fix_kind = meta.fix_kind
        case None:
            pass
    val is_style = rule_code == "PERF-STYLE-001"
    lsp_perf_code_action_kind_v1(rule_code, fix_kind, is_style)

fn _render_string_array_json(items: [text]) -> text:
    var parts: [text] = []
    for item in items:
        parts.push(jstr(item))
    "[" + parts.join(",") + "]"

fn _build_action_data_json(
    uri: text,
    diagnostic_id: text,
    candidate_id: text,
    expected_version: i64,
    expected_hash: text,
    expected_sem_fp: text,
    obligations: [text],
    tradeoff: text
) -> text:
    val lb = _lbrace()
    val rb = _rbrace()
    var pairs: [text] = [
        "\"diagnostic_id\":" + jstr(diagnostic_id),
        "\"candidate_id\":" + jstr(candidate_id)
    ]
    if uri != "":
        pairs.push("\"uri\":" + jstr(uri))
    if expected_version >= 0:
        pairs.push("\"expected_version\":" + expected_version.to_text())
    if expected_hash != "":
        pairs.push("\"expected_source_hash\":" + jstr(expected_hash))
    if expected_sem_fp != "":
        pairs.push("\"expected_semantic_fingerprint\":" + jstr(expected_sem_fp))
    if obligations.len() > 0:
        pairs.push("\"obligations\":" + _render_string_array_json(obligations))
    if tradeoff != "":
        pairs.push("\"resource_tradeoff\":" + jstr(tradeoff))
    lb + pairs.join(",") + rb

fn action_json(diagnostic_id: text, c: FixCandidate, preferred: bool) -> text:
    val lb = _lbrace()
    val rb = _rbrace()
    val kind = lsp_perf_code_action_kind_v1(_rule_prefix_from_diag_id(diagnostic_id), "", _rule_prefix_from_diag_id(diagnostic_id) == "PERF-STYLE-001")
    var out = lb + "\"title\":" + jstr(c.title) + ",\"kind\":" + jstr(kind)
    if preferred:
        out = out + ",\"isPreferred\":true"
    match c.disabled_reason:
        Some(reason):
            out = out + ",\"disabled\":" + lb + "\"reason\":" + jstr(reason) + rb
        None:
            pass
    out + ",\"data\":" + lb + "\"diagnostic_id\":" + jstr(diagnostic_id) + ",\"candidate_id\":" + jstr(c.id) + rb + rb

# reason: serializes ranked LSP codeAction JSON array for a diagnostic_id
@allow(primitive_api)
pub fn lsp_diag_code_actions_json(index: DiagnosticActionIndex, diagnostic_id: text) -> text:
    var rows: [text] = []
    var preferred_taken = false
    for c in ranked_candidates_for(index, diagnostic_id):
        val prefer = not preferred_taken and c.is_enabled()
        if prefer:
            preferred_taken = true
        rows.push(action_json(diagnostic_id, c, prefer))
    "[" + rows.join(",") + "]"

fn position_json(line: i64, character: i64) -> text:
    val lb = _lbrace()
    val rb = _rbrace()
    lb + "\"line\":" + line.to_text() + ",\"character\":" + character.to_text() + rb

# WorkspaceEdit for an Applied result; "" when any range is unmappable.
fn workspace_edit_json_with_caps(
    tx: EditTransaction,
    result: ApplyResult,
    c: FixCandidate,
    disk_files: [text],
    use_document_changes: bool
) -> text:
    val lb = _lbrace()
    val rb = _rbrace()
    var doc_changes: [text] = []
    var map_changes: [text] = []
    for f in result.changed_files:
        val before = tx.text_of(f)
        val table = LineStartTable.build(before)
        var version_str = "0"
        if disk_files.contains(f):
            version_str = "null"
        else:
            match tx.document(f):
                Some(d): version_str = d.version.to_text()
                None: pass
        var edits: [text] = []
        for r in c.replacements:
            if r.file == f:
                match span_to_range(before, table, r.span.start, r.span.end):
                    Some(rg):
                        val range = lb + "\"start\":" + position_json(rg.start.line, rg.start.character)
                            + ",\"end\":" + position_json(rg.end.line, rg.end.character) + rb
                        edits.push(lb + "\"range\":" + range + ",\"newText\":" + jstr(r.new_text) + rb)
                    None:
                        return ""
        val uri_str = _file_uri_for_path(f)
        doc_changes.push(lb + "\"textDocument\":" + lb + "\"uri\":" + jstr(uri_str) + ",\"version\":" + version_str
            + rb + ",\"edits\":[" + edits.join(",") + "]" + rb)
        map_changes.push(jstr(uri_str) + ":[" + edits.join(",") + "]")
    if use_document_changes:
        return lb + "\"documentChanges\":[" + doc_changes.join(",") + "]" + rb
    lb + "\"changes\":" + lb + map_changes.join(",") + rb + rb

fn workspace_edit_json_with_disk(tx: EditTransaction, result: ApplyResult, c: FixCandidate, disk_files: [text]) -> text:
    workspace_edit_json_with_caps(tx, result, c, disk_files, true)

fn workspace_edit_json(tx: EditTransaction, result: ApplyResult, c: FixCandidate) -> text:
    workspace_edit_json_with_disk(tx, result, c, [])

# reason: applies FixCandidate through EditTransaction and serializes LSP WorkspaceEdit or refusal JSON
@allow(primitive_api)
pub fn lsp_diag_apply_json(tx: EditTransaction, c: FixCandidate) -> text:
    val lb = _lbrace()
    val rb = _rbrace()
    val result = tx.apply(c)
    if not result.applied():
        return lb + "\"status\":" + jstr(result.status.name()) + ",\"reason\":" + jstr(result.reason) + rb
    val edit = workspace_edit_json(tx, result, c)
    if edit == "":
        return lb + "\"status\":\"unmappable_range\",\"reason\":\"edit span is not on a UTF-8 scalar boundary\"" + rb
    lb + "\"status\":\"applied\",\"edit\":" + edit + rb

fn starts_on_line(c: FixCandidate, file: text, body: text, table: LineStartTable, line: i64) -> bool:
    for r in c.replacements:
        if r.file == file:
            match byte_to_position(body, table, r.span.start):
                Some(p):
                    if p.line == line: return true
                None: pass
    for pre in c.preconditions:
        if pre.file == file:
            match byte_to_position(body, table, pre.span.start):
                Some(p):
                    if p.line == line: return true
                None: pass
    false

fn _candidate_matches_line(
    entry: LspDiagActionEntry,
    c: FixCandidate,
    file: text,
    body: text,
    table: LineStartTable,
    line: i64
) -> bool:
    if starts_on_line(c, file, body, table, line):
        return true
    match lsp_diag_candidate_meta_lookup_v1(entry, c.id):
        case Some(meta):
            if meta.line_hint >= 0 and meta.line_hint == line:
                return true
        case None:
            pass
    false

fn file_parent(file: text) -> text:
    val norm = file.replace("\\", "/")
    val slash = norm.last_index_of("/")
    if slash <= 0:
        if norm.starts_with("/"): return "/"
        return norm
    norm.substring(0, slash)

fn common_workspace_root(files: [text]) -> text:
    if files.len() == 0:
        return "/"
    var common = file_parent(files[0])
    var i = 1
    while i < files.len():
        val next_dir = file_parent(files[i])
        while common != "/" and common != "" and not (next_dir == common or next_dir.starts_with(common + "/")):
            val slash = common.last_index_of("/")
            if slash <= 0:
                common = if common.starts_with("/"): "/" else: common
                break
            common = common.substring(0, slash)
        i = i + 1
    common

fn _collect_entry_candidate_files(entry: LspDiagActionEntry, primary_file: text) -> [text]:
    var files: [text] = [primary_file]
    for rev in entry.file_revisions:
        if not files.contains(rev.file):
            files.push(rev.file)
    for id in entry.ids:
        for c in entry.index.candidates_for(id):
            for f in c.affected_files():
                if not files.contains(f):
                    files.push(f)
            for p in c.preconditions:
                if not files.contains(p.file):
                    files.push(p.file)
    files

fn _build_entry_transaction(
    client_id: text,
    entry: LspDiagActionEntry,
    file: text,
    current_version: i64,
    body: text
) -> (EditTransaction, [text]):
    val all_files = _collect_entry_candidate_files(entry, file)
    val root = common_workspace_root(all_files)
    var disk_files: [text] = []
    var tx = EditTransaction.new(root, entry.source_hash)
    if entry.file_revisions.len() > 0:
        for rev in entry.file_revisions:
            tx = tx.expect_document_revision(rev.file, rev.version, rev.source_hash)
        tx = tx.with_document(DocumentSnapshot.new(file, current_version, sha256_text(body), body))
        for sec in all_files:
            if sec != file:
                match lsp_document_snapshot_by_path_for_client_v1(client_id, sec):
                    Some(sec_snap):
                        tx = tx.with_document(DocumentSnapshot.new(sec, sec_snap.version, sha256_text(sec_snap.content), sec_snap.content))
                    None:
                        if not lsp_document_has_unsynchronized_path_for_client_v1(client_id, sec):
                            match lsp_read_analyzed_source(sec):
                                Ok(sec_disk):
                                    tx = tx.with_document(DocumentSnapshot.new(sec, -1, sha256_text(sec_disk), sec_disk))
                                    disk_files.push(sec)
                                Err(_):
                                    pass
    else:
        tx = tx.with_document(DocumentSnapshot.new(file, current_version, entry.source_hash, body))
        for sec in all_files:
            if sec != file:
                match lsp_document_snapshot_by_path_for_client_v1(client_id, sec):
                    Some(sec_snap):
                        tx = tx.with_document(DocumentSnapshot.new(sec, sec_snap.version, sha256_text(sec_snap.content), sec_snap.content))
                    None:
                        pass
    (tx, disk_files)

fn _semantic_fingerprint_stale_reason(client_id: text, entry: LspDiagActionEntry, candidate_id: text, data_expected_sem: text) -> text:
    val store_sem = lsp_perf_get_semantic_fingerprint_for_client_v1(client_id, entry.uri)
    val active_sem = if store_sem != "": store_sem else: entry.semantic_fingerprint
    if entry.expected_semantic_fingerprint != "" and active_sem != "" and active_sem != entry.expected_semantic_fingerprint:
        return "stale document or semantic dependency revision (expected " + entry.expected_semantic_fingerprint + ", active " + active_sem + ")"
    match lsp_diag_candidate_meta_lookup_v1(entry, candidate_id):
        case Some(meta):
            if meta.expected_semantic_fingerprint != "" and active_sem != "" and active_sem != meta.expected_semantic_fingerprint:
                return "stale document or semantic dependency revision (expected " + meta.expected_semantic_fingerprint + ", active " + active_sem + ")"
        case None:
            pass
    if data_expected_sem != "" and active_sem != "" and active_sem != data_expected_sem:
        return "stale document or semantic dependency revision (expected " + data_expected_sem + ", active " + active_sem + ")"
    ""

# reason: evaluates live codeAction candidates for client_id honoring negotiated resolveSupport and disabledSupport
@allow(primitive_api)
pub fn lsp_diag_live_actions_outcome_with_caps_for_client_v1(
    client_id: text,
    entry: LspDiagActionEntry,
    file: text,
    current_version: i64,
    body: text,
    line: i64,
    caps: LspClientCodeActionCapsV1
) -> LspLiveActionOutcomeV1:
    if not entry.valid or entry.status != "complete":
        return LspLiveActionOutcomeV1(
            status: "refused",
            actions_json: "",
            refusal_reason: "codeAction refuses incomplete or failed diagnostic batch (" + entry.status + ")"
        )
    val lb = _lbrace()
    val rb = _rbrace()
    val table = LineStartTable.build(body)
    val (tx, disk_files) = _build_entry_transaction(client_id, entry, file, current_version, body)
    val body_hash = sha256_text(body)
    var rows: [text] = []
    var preferred_taken = false
    var saw_enabled_line_candidate = false
    var last_refusal = ""

    for id in entry.ids:
        for c in ranked_candidates_for(entry.index, id):
            if not _candidate_matches_line(entry, c, file, body, table, line):
                continue
            val kind = _candidate_lsp_kind(entry, id, c)
            var cand_expected_sem = entry.expected_semantic_fingerprint
            var cand_obs = entry.obligations_summary
            var cand_tradeoff = entry.resource_tradeoff
            match lsp_diag_candidate_meta_lookup_v1(entry, c.id):
                case Some(meta):
                    if meta.expected_semantic_fingerprint != "":
                        cand_expected_sem = meta.expected_semantic_fingerprint
                    if meta.obligations_summary.len() > 0:
                        cand_obs = meta.obligations_summary
                    if meta.resource_tradeoff != "":
                        cand_tradeoff = meta.resource_tradeoff
                case None:
                    pass
            val data_json = _build_action_data_json(
                entry.uri, id, c.id, current_version, body_hash,
                cand_expected_sem, cand_obs, cand_tradeoff
            )

            # Surface blocked / Unavailable candidates (PERF-FIX-001) with exact disabled.reason!
            if not c.is_enabled():
                if caps.disabled_support:
                    val reason = c.disabled_reason ?? "fix candidate blocked by safety preconditions"
                    val dis_row = lb + "\"title\":" + jstr(c.title)
                        + ",\"kind\":" + jstr(kind)
                        + ",\"disabled\":" + lb + "\"reason\":" + jstr(reason) + rb
                        + ",\"data\":" + data_json + rb
                    rows.push(dis_row)
                continue

            val sem_stale = _semantic_fingerprint_stale_reason(client_id, entry, c.id, cand_expected_sem)
            if sem_stale != "":
                if caps.disabled_support:
                    val stale_row = lb + "\"title\":" + jstr(c.title)
                        + ",\"kind\":" + jstr(kind)
                        + ",\"disabled\":" + lb + "\"reason\":" + jstr(sem_stale) + rb
                        + ",\"data\":" + data_json + rb
                    rows.push(stale_row)
                continue

            saw_enabled_line_candidate = true
            val result = tx.apply(c)
            if not result.applied():
                last_refusal = result.reason
                continue
            val edit = workspace_edit_json_with_caps(tx, result, c, disk_files, caps.document_changes_support)
            if edit == "":
                last_refusal = "edit span is not on a UTF-8 scalar boundary"
                continue

            var row = lb + "\"title\":" + jstr(c.title) + ",\"kind\":" + jstr(kind)
            if not preferred_taken:
                preferred_taken = true
                row = row + ",\"isPreferred\":true"
            if caps.resolve_support:
                # Deferred mode: withhold WorkspaceEdit until codeAction/resolve revalidates I01 & I02.
                rows.push(row + ",\"data\":" + data_json + rb)
            else:
                rows.push(row + ",\"edit\":" + edit + ",\"data\":" + data_json + rb)

    if rows.len() > 0:
        return LspLiveActionOutcomeV1(status: "actions", actions_json: "[" + rows.join(",") + "]", refusal_reason: "")
    if saw_enabled_line_candidate and last_refusal != "":
        return LspLiveActionOutcomeV1(status: "refused", actions_json: "", refusal_reason: last_refusal)
    LspLiveActionOutcomeV1(status: "no_match", actions_json: "", refusal_reason: "")

# reason: evaluates live codeAction candidates for client_id with multi-file revision preconditions
@allow(primitive_api)
pub fn lsp_diag_live_actions_outcome_for_client_v1(
    client_id: text,
    entry: LspDiagActionEntry,
    file: text,
    current_version: i64,
    body: text,
    line: i64
) -> LspLiveActionOutcomeV1:
    val caps = lsp_get_client_code_action_caps_for_client_v1(client_id)
    lsp_diag_live_actions_outcome_with_caps_for_client_v1(client_id, entry, file, current_version, body, line, caps)

fn _disabled_resolved_action_json(action: JsonValue, reason: text) -> text:
    var fields: [(text, JsonValue)] = []
    for k in ["title", "kind", "diagnostics", "data"]:
        if json_value_has(action, k):
            fields.push((k, json_value_field(action, k)))
    fields.push(("isPreferred", JsonValue.Bool(false)))
    fields.push(("disabled", json_value_object_from([("reason", JsonValue.Str(reason))])))
    json_value_serialize(json_value_object_from(fields))

# reason: resolves a deferred LSP CodeAction by revalidating document (version, source_hash) (I01) and semantic_fingerprint (I02)
@allow(primitive_api)
pub fn lsp_diag_resolve_code_action_for_client_v1(client_id: text, body: text) -> Result<text, (i64, text)>:
    val parsed = json_parse_value_strict(body.trim())
    if parsed.is_err():
        return Err((-32602, "codeAction/resolve requires valid JSON"))
    val root = parsed.unwrap()
    val action = if json_value_has(root, "params"): json_value_field(root, "params") else: root
    val title = json_value_text_or(json_value_field(action, "title"), "")
    if title.trim() == "":
        return Err((-32602, "codeAction/resolve requires a CodeAction with non-empty title"))

    if json_value_has(action, "disabled"):
        val existing_reason = json_value_text_or(json_value_field(json_value_field(action, "disabled"), "reason"), "action is disabled")
        return Ok(_disabled_resolved_action_json(action, existing_reason))

    val data = json_value_field(action, "data")
    val uri = json_value_text_or(json_value_field(data, "uri"), "")
    val diag_id = json_value_text_or(json_value_field(data, "diagnostic_id"), "")
    val cand_id = json_value_text_or(json_value_field(data, "candidate_id"), "")
    if uri == "" or cand_id == "":
        if json_value_has(action, "edit"):
            return Ok(json_value_serialize(action))
        return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: missing resolution data"))

    val snap_opt = lsp_document_snapshot_for_client_v1(client_id, uri)
    val entry_opt = lsp_diag_action_store_last_valid_for_client_v1(client_id, uri)
    if not snap_opt.? or not entry_opt.?:
        return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: open document or batch unavailable"))

    val snap = snap_opt.unwrap()
    val entry = entry_opt.unwrap()
    val current_hash = sha256_text(snap.content)

    # I01: Revalidate document (version, source_hash) against both batch and data expectations!
    if snap.version != entry.version or current_hash != entry.source_hash:
        return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: source edited after action discovery"))
    if json_value_has(data, "expected_version"):
        val exp_v = json_value_as_i64(json_value_field(data, "expected_version")) ?? -1
        if exp_v >= 0 and snap.version != exp_v:
            return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: document version drifted"))
    val exp_hash = json_value_text_or(json_value_field(data, "expected_source_hash"), "")
    if exp_hash != "" and current_hash != exp_hash:
        return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: source hash drifted"))

    # I02: Revalidate server-side semantic dependency fingerprint!
    val exp_sem = json_value_text_or(json_value_field(data, "expected_semantic_fingerprint"), "")
    val sem_reason = _semantic_fingerprint_stale_reason(client_id, entry, cand_id, exp_sem)
    if sem_reason != "":
        return Ok(_disabled_resolved_action_json(action, sem_reason))

    # Locate target FixCandidate
    var found_cand: Option<FixCandidate> = None
    if diag_id != "":
        for c in entry.index.candidates_for(diag_id):
            if c.id == cand_id:
                found_cand = Some(c)
    else:
        for id in entry.ids:
            for c in entry.index.candidates_for(id):
                if c.id == cand_id:
                    found_cand = Some(c)

    if not found_cand.?:
        return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: candidate no longer present"))

    val cand = found_cand.unwrap()
    if not cand.is_enabled():
        return Ok(_disabled_resolved_action_json(action, cand.disabled_reason ?? "candidate blocked by safety preconditions"))

    val file_path = lsp_file_uri_to_path(uri)
    val (tx, disk_files) = _build_entry_transaction(client_id, entry, file_path, snap.version, snap.content)
    val result = tx.apply(cand)
    if not result.applied():
        return Ok(_disabled_resolved_action_json(action, "stale document or semantic dependency revision: " + result.reason))

    val caps = lsp_get_client_code_action_caps_for_client_v1(client_id)
    val edit_json = workspace_edit_json_with_caps(tx, result, cand, disk_files, caps.document_changes_support)
    if edit_json == "":
        return Ok(_disabled_resolved_action_json(action, "edit span is not on a UTF-8 scalar boundary"))

    val lb = _lbrace()
    val rb = _rbrace()
    val kind_str = json_value_text_or(json_value_field(action, "kind"), _candidate_lsp_kind(entry, diag_id, cand))
    var out = lb + "\"title\":" + jstr(title) + ",\"kind\":" + jstr(kind_str)
    if json_value_has(action, "isPreferred"):
        out = out + ",\"isPreferred\":" + json_value_serialize(json_value_field(action, "isPreferred"))
    out = out + ",\"edit\":" + edit_json
    if json_value_has(action, "data"):
        out = out + ",\"data\":" + json_value_serialize(data)
    out = out + rb
    Ok(out)

# Live codeAction list for one document line, built from the published
# batch's candidates and the editor snapshot.
# reason: builds live codeAction JSON list for a document line when applicable
@allow(primitive_api)
pub fn lsp_diag_live_actions_json(entry: LspDiagActionEntry, file: text, body: text, line: i64) -> text?:
    val outcome = lsp_diag_live_actions_outcome_for_client_v1(entry.client_id, entry, file, entry.version, body, line)
    if outcome.status == "actions":
        return Some(outcome.actions_json)
    None

