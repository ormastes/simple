use std.common.string_core.{str_len}
# Disk-backed and live-batch query admission. The editor owns document contents and apply.
# This adapter never writes editor buffers or files.
use std.common.json.value.{json_parse_value_strict, json_value_field}
use std.nogc_sync_mut.lsp.server.{DocumentInfo}
use std.nogc_sync_mut.lsp.lsp_json.{make_json_result, make_error}
use std.nogc_sync_mut.lsp.lsp_file_uri.{lsp_file_uri_to_path, lsp_query_file_argument_v1}
use std.nogc_sync_mut.lsp.lsp_code_action.{LspCodeActionRevision, lsp_code_action_request, lsp_code_action_query_args, lsp_code_actions_convert_with_revisions}
use std.nogc_sync_mut.lsp.lsp_document_sync.{
    lsp_extract_client_id_v1,
    lsp_document_snapshot_for_client_v1,
    lsp_document_snapshot_matches_for_client_v1,
    lsp_read_analyzed_source
}
use std.nogc_sync_mut.lsp.lsp_query_command.{lsp_heavy_query_command_v1, lsp_run_query_command_v1}
use std.nogc_sync_mut.lsp.lsp_diag_action_store.{lsp_diag_action_store_lookup_for_client_v1}
use std.nogc_sync_mut.lsp.lsp_diag_code_action.{
    lsp_diag_live_actions_outcome_for_client_v1,
    lsp_diag_resolve_code_action_for_client_v1
}

# reason: validates raw JSON output of codeAction query child and returns error description or empty text
@allow(primitive_api)
pub fn lsp_code_action_output_error(output: text) -> text:
    # Child logs/malformed rows are analyzer failure, never empty success.
    if str_len(output) > 4194304:
        return "codeAction analyzer exceeded the 4 MiB result budget"
    match json_parse_value_strict(output.trim()):
        case Ok(Array(actions)):
            if actions.len() > 128:
                return "codeAction analyzer exceeded the 128-action result budget"
            for action in actions:
                match json_value_field(action, "title"):
                    case Str(title) if title.trim() != "": pass
                    case _: return "codeAction analyzer returned a malformed action row"
        case _: return "codeAction analyzer returned an invalid action array"
    ""

# reason: serves LSP textDocument/codeAction JSON-RPC response isolated to client_id
@allow(primitive_api)
pub fn lsp_code_action_response_for_client_v1(client_id: text, id: text, body: text, binary: text) -> text:
    val request = lsp_code_action_request(body)
    if not request.?: return make_error(id, -32602, "codeAction requires a valid URI and range")
    val actual = request.unwrap()
    val path = lsp_file_uri_to_path(actual.uri)
    if not actual.uri.starts_with("file://") or path == "": return make_error(id, -32602, "codeAction requires a file URI")
    val snapshot = lsp_document_snapshot_for_client_v1(client_id, actual.uri)
    if not snapshot.?:
        return make_error(id, -32803, "codeAction requires an open editor document revision")
    val captured = snapshot.unwrap()
    # Live path: candidates recorded with the last publishDiagnostics/pull batch
    # of THIS client's document version answer directly from verified snapshots.
    match lsp_diag_action_store_lookup_for_client_v1(client_id, actual.uri, captured.version):
        Some(entry):
            val outcome = lsp_diag_live_actions_outcome_for_client_v1(client_id, entry, path, captured.version, captured.content, actual.line)
            if outcome.status == "actions":
                return make_json_result(id, outcome.actions_json)
            if outcome.status == "refused":
                return make_error(id, -32801, outcome.refusal_reason)
        None: pass
    val before = lsp_read_analyzed_source(path)
    if before.is_err(): return make_error(id, -32803, "codeAction could not read the analyzed source")
    if before.unwrap() != captured.content:
        return make_error(id, -32801, "Editor overlay differs from disk; immutable overlay query support is unavailable. No disk fix was substituted")
    val producer_path = lsp_query_file_argument_v1(path)
    val arguments = lsp_code_action_query_args(producer_path, actual.line)
    val command = lsp_heavy_query_command_v1(arguments)
    val (output, exit_code) = lsp_run_query_command_v1(binary, command, 4194304)
    if exit_code != 0 or output.trim() == "":
        return make_error(id, -32803, "codeAction analysis failed; no repair is verified")
    lsp_code_action_complete_for_client_v1(client_id, id, captured, path, producer_path, output)

# reason: serves LSP textDocument/codeAction JSON-RPC response routing by embedded clientId or default client
@allow(primitive_api)
pub fn lsp_code_action_response(id: text, body: text, binary: text) -> text:
    lsp_code_action_response_for_client_v1(lsp_extract_client_id_v1(body), id, body, binary)

# reason: serves LSP codeAction/resolve JSON-RPC response isolated to client_id (revalidates I01 & I02, never writes files)
@allow(primitive_api)
pub fn lsp_handle_code_action_resolve_for_client_v1(client_id: text, id: text, body: text) -> text:
    match lsp_diag_resolve_code_action_for_client_v1(client_id, body):
        case Ok(resolved_json):
            make_json_result(id, resolved_json)
        case Err((code, msg)):
            make_error(id, code, msg)

# reason: serves LSP codeAction/resolve JSON-RPC response routing by embedded clientId or default client
@allow(primitive_api)
pub fn lsp_handle_code_action_resolve(id: text, body: text) -> text:
    lsp_handle_code_action_resolve_for_client_v1(lsp_extract_client_id_v1(body), id, body)

# reason: completes child-backed codeAction conversion verifying snapshot currency for client_id
@allow(primitive_api)
pub fn lsp_code_action_complete_for_client_v1(client_id: text, id: text, captured: DocumentInfo,
        path: text, producer_path: text, output: text) -> text:
    val output_error = lsp_code_action_output_error(output)
    if output_error != "": return make_error(id, -32803, output_error)
    val after = lsp_read_analyzed_source(path)
    if after.is_err(): return make_error(id, -32801, "Analyzed source became unavailable")
    if after.unwrap() != captured.content or not lsp_document_snapshot_matches_for_client_v1(client_id, captured):
        return make_error(id, -32801, "Source changed during analysis; request fresh code actions")
    val revision = LspCodeActionRevision(uri: captured.uri, source_path: producer_path, version: captured.version, source: captured.content)
    val actions = lsp_code_actions_convert_with_revisions(output, captured.uri, [revision])
    make_json_result(id, actions)

# Production child-success boundary; callers must pass the captured owner
# snapshot and the exact source spelling submitted to the query child.
# reason: completes child-backed codeAction conversion verifying snapshot currency for default client
@allow(primitive_api)
pub fn lsp_code_action_complete_v1(id: text, captured: DocumentInfo,
        path: text, producer_path: text, output: text) -> text:
    lsp_code_action_complete_for_client_v1("default", id, captured, path, producer_path, output)

export lsp_code_action_output_error
export lsp_code_action_response_for_client_v1, lsp_code_action_response
export lsp_handle_code_action_resolve_for_client_v1, lsp_handle_code_action_resolve
export lsp_code_action_complete_for_client_v1, lsp_code_action_complete_v1
