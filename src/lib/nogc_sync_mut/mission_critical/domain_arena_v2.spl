# codex-impl: additive, fixed-capacity DomainArena V2.
#
# V1 remains the live evidence producer and its hash/schema are intentionally
# untouched.  V2 is a compatibility lane for owner-confined staging and
# publication.  The factory validates the profile before either fixed bank is
# constructed; an invalid or oversize request therefore cannot allocate.

use std.common.crypto.sha256.{sha256_text}
use nogc_sync_mut.mission_critical.domain_arena_v1.*

const DOMAIN_ARENA_V2_SCHEMA: u16 = 2u16
const DOMAIN_ARENA_V2_MAX_QUOTA_BYTES: u64 = 16777216u64
const DOMAIN_ARENA_V2_MAX_REFS: u32 = 1048576u32
const DOMAIN_ARENA_V2_U64_MAX: u64 = 0xFFFFFFFFFFFFFFFF

const DOMAIN_ARENA_V2_REJECT_INVALID_ARENA: u16 = 1u16
const DOMAIN_ARENA_V2_REJECT_INVALID_PROFILE: u16 = 2u16
const DOMAIN_ARENA_V2_REJECT_OVERSIZE: u16 = 3u16
const DOMAIN_ARENA_V2_REJECT_OWNER: u16 = 4u16

const DOMAIN_ARENA_V2_FAULT_NONE: u16 = 0u16
const DOMAIN_ARENA_V2_FAULT_BEFORE_PUBLICATION: u16 = 1u16

struct DomainArenaV2ConstructionError:
    reason: u16
    arena_id: u64
    quota_bytes: u64
    ref_capacity: u32

struct DomainArenaV2Rejection:
    arena_id: u64
    domain_id: u32
    generation: u64
    requested_bytes: u64
    remaining_bytes: u64
    reason: u16

enum DomainArenaV2Creation:
    Created(DomainArenaV2)
    Rejected(DomainArenaV2ConstructionError)

enum DomainArenaV2Allocation:
    Allocated(DomainArenaRefV2)
    Rejected(DomainArenaV2Rejection)

struct DomainArenaRefV2:
    arena_id: u64
    domain_id: u32
    generation: u64
    offset_bytes: u64
    size_bytes: u64
    mint: u64

struct DomainArenaCheckpointV2:
    arena_id: u64
    domain_id: u32
    generation: u64
    cursor_bytes: u64
    allocation_count: u32
    publication_epoch: u64
    owner_nonce: u64

struct DomainArenaCommittedSnapshotV2:
    generation: u64
    cursor_bytes: u64
    allocation_count: u32
    publication_epoch: u64

# This type is deliberately module-private.  No caller can construct an owner
# capability or name the publication authority; it can only receive a minted
# value from owner_capability_v2().
class DomainArenaOwnerCapabilityV2:
    arena_id: u64
    nonce: u64

class DomainArenaAuthorityV2:
    snapshot: DomainArenaCommittedSnapshotV2
    bank_index: u8
    owner_nonce: u64

class DomainArenaStorageBankV2:
    bytes: [u8]
    ref_offsets: [u64]
    ref_sizes: [u64]
    ref_mints: [u64]

fn arena_zero_bytes_v2(size: u64) -> [u8]:
    if size == 0u64 or size > DOMAIN_ARENA_V2_MAX_QUOTA_BYTES: return []
    var bytes: [u8] = [0u8]
    while (bytes.len() as u64) < size:
        bytes = bytes.concat(bytes)
    if (bytes.len() as u64) > size: return bytes[0:(size as i64)]
    bytes

fn arena_zero_u64_v2(size: u32) -> [u64]:
    if size == 0u32 or size > DOMAIN_ARENA_V2_MAX_REFS: return []
    var values: [u64] = [0u64]
    while (values.len() as u32) < size:
        values = values.concat(values)
    if (values.len() as u32) > size: return values[0:(size as i64)]
    values

fn arena_storage_bank_v2(byte_capacity: u64, ref_capacity: u32) -> DomainArenaStorageBankV2:
    DomainArenaStorageBankV2(
        bytes: arena_zero_bytes_v2(byte_capacity),
        ref_offsets: arena_zero_u64_v2(ref_capacity),
        ref_sizes: arena_zero_u64_v2(ref_capacity),
        ref_mints: arena_zero_u64_v2(ref_capacity)
    )

fn domain_arena_v2_profile_valid(profile: RelaxedAllocationProfileV1) -> bool:
    profile.sealed and profile.schema_version == 1u16 and
        profile.profile_id.len() > 0 and profile.domain_id != 0u32 and
        profile.quota_bytes > 0u64 and
        profile.quota_bytes <= DOMAIN_ARENA_V2_MAX_QUOTA_BYTES and
        profile.alignment > 0u32 and
        (profile.alignment & (profile.alignment - 1u32)) == 0u32 and
        profile.max_allocations_per_generation > 0u32 and
        profile.max_allocations_per_generation <= DOMAIN_ARENA_V2_MAX_REFS and
        profile.strict_default and profile.allowed_context_mask == ARENA_CONTEXT_NORMAL and
        (profile.forbidden_context_mask & ARENA_CONTEXT_CRITICAL_MASK) == ARENA_CONTEXT_CRITICAL_MASK and
        (profile.forbidden_context_mask & ARENA_CONTEXT_NORMAL) == 0u64

fn domain_arena_v2_create_error(arena_id: u64, profile: RelaxedAllocationProfileV1) -> DomainArenaV2ConstructionError:
    val reason = if arena_id == 0u64: DOMAIN_ARENA_V2_REJECT_INVALID_ARENA
        elif not domain_arena_v2_profile_valid(profile):
            if profile.quota_bytes > DOMAIN_ARENA_V2_MAX_QUOTA_BYTES or
               profile.max_allocations_per_generation > DOMAIN_ARENA_V2_MAX_REFS:
                DOMAIN_ARENA_V2_REJECT_OVERSIZE
            else: DOMAIN_ARENA_V2_REJECT_INVALID_PROFILE
        else: DOMAIN_ARENA_V2_REJECT_INVALID_PROFILE
    DomainArenaV2ConstructionError(
        reason: reason, arena_id: arena_id,
        quota_bytes: profile.quota_bytes,
        ref_capacity: profile.max_allocations_per_generation
    )

class DomainArenaV2:
    arena_id: u64
    profile: RelaxedAllocationProfileV1
    sealed_profile: RelaxedAllocationProfileV1
    generation: u64
    staging_generation: u64
    next_generation: u64
    cursor_bytes: u64
    high_water_bytes: u64
    overflow_count: u64
    allocation_count: u32
    transaction_open: bool
    generation_terminal: bool
    armed_fault_point: u16
    checkpoint_generation: u64
    checkpoint_cursor_bytes: u64
    checkpoint_allocation_count: u32
    checkpoint_publication_epoch: u64
    authority: DomainArenaAuthorityV2
    bank_zero: DomainArenaStorageBankV2
    bank_one: DomainArenaStorageBankV2

impl DomainArenaV2:
    # Validation is a pure scalar operation.  Bank construction is below this
    # branch, so rejected profiles cannot trigger a backing allocation.
    static fn try_create(arena_id: u64, profile: RelaxedAllocationProfileV1) -> DomainArenaV2Creation:
        if arena_id == 0u64 or not domain_arena_v2_profile_valid(profile):
            return DomainArenaV2Creation.Rejected(domain_arena_v2_create_error(arena_id, profile))
        val authority = DomainArenaAuthorityV2(
            snapshot: DomainArenaCommittedSnapshotV2(
                generation: 0u64, cursor_bytes: 0u64,
                allocation_count: 0u32, publication_epoch: 0u64),
            bank_index: 0u8, owner_nonce: arena_id ^ 0xD0A2u64)
        val bank_zero = arena_storage_bank_v2(
            profile.quota_bytes, profile.max_allocations_per_generation)
        val bank_one = arena_storage_bank_v2(
            profile.quota_bytes, profile.max_allocations_per_generation)
        DomainArenaV2Creation.Created(DomainArenaV2(
            arena_id: arena_id, profile: profile, sealed_profile: profile,
            generation: 0u64, staging_generation: 0u64, next_generation: 1u64,
            cursor_bytes: 0u64, high_water_bytes: 0u64, overflow_count: 0u64,
            allocation_count: 0u32, transaction_open: false,
            generation_terminal: false,
            armed_fault_point: DOMAIN_ARENA_V2_FAULT_NONE,
            checkpoint_generation: 0u64, checkpoint_cursor_bytes: 0u64,
            checkpoint_allocation_count: 0u32, checkpoint_publication_epoch: 0u64,
            authority: authority, bank_zero: bank_zero, bank_one: bank_one))

    # Naming aliases make the additive lane convenient without changing V1.
    static fn from_sealed_profile(arena_id: u64, profile: RelaxedAllocationProfileV1) -> DomainArenaV2Creation:
        DomainArenaV2.try_create(arena_id, profile)

    static fn try_from_sealed_profile(arena_id: u64, profile: RelaxedAllocationProfileV1) -> DomainArenaV2Creation:
        DomainArenaV2.try_create(arena_id, profile)

    static fn create(arena_id: u64, profile: RelaxedAllocationProfileV1) -> DomainArenaV2Creation:
        DomainArenaV2.try_create(arena_id, profile)

    fn _staging_bank() -> DomainArenaStorageBankV2:
        if self.authority.bank_index == 0u8: self.bank_one else: self.bank_zero

    fn _committed_bank() -> DomainArenaStorageBankV2:
        if self.authority.bank_index == 0u8: self.bank_zero else: self.bank_one

    fn _owner_capability_v2() -> DomainArenaOwnerCapabilityV2:
        DomainArenaOwnerCapabilityV2(
            arena_id: self.arena_id, nonce: self.authority.owner_nonce)

    # The owner controls this one-shot fault arm; the fault itself has no
    # string/hash work in the allocation or publication hot paths.
    me arm_fault_once(fault_point: u16) -> bool:
        if fault_point != DOMAIN_ARENA_V2_FAULT_BEFORE_PUBLICATION or
           not self.transaction_open or self.armed_fault_point != DOMAIN_ARENA_V2_FAULT_NONE:
            return false
        self.armed_fault_point = fault_point
        true

    me checkpoint() -> DomainArenaCheckpointV2:
        if not self.transaction_open and not self.generation_terminal:
            self.transaction_open = true
            self.staging_generation = self.next_generation
            self.generation = self.staging_generation
            if self.next_generation == DOMAIN_ARENA_V2_U64_MAX:
                self.generation_terminal = true
            else:
                self.next_generation = self.next_generation + 1u64
            self.cursor_bytes = 0u64
            self.allocation_count = 0u32
            val staging = self._staging_bank()
            var i = 0
            while i < staging.bytes.len():
                staging.bytes[i] = 0u8
                i = i + 1
            var j = 0
            while j < staging.ref_offsets.len():
                staging.ref_offsets[j] = 0u64
                staging.ref_sizes[j] = 0u64
                staging.ref_mints[j] = 0u64
                j = j + 1
            self.checkpoint_generation = self.staging_generation
            self.checkpoint_cursor_bytes = 0u64
            self.checkpoint_allocation_count = 0u32
            self.checkpoint_publication_epoch = self.authority.snapshot.publication_epoch
        DomainArenaCheckpointV2(
            arena_id: self.arena_id, domain_id: self.profile.domain_id,
            generation: self.checkpoint_generation,
            cursor_bytes: self.checkpoint_cursor_bytes,
            allocation_count: self.checkpoint_allocation_count,
            publication_epoch: self.checkpoint_publication_epoch,
            owner_nonce: self.authority.owner_nonce)

    fn _checkpoint_matches(checkpoint: DomainArenaCheckpointV2) -> bool:
        checkpoint.arena_id == self.arena_id and
            checkpoint.domain_id == self.profile.domain_id and
            checkpoint.generation == self.checkpoint_generation and
            checkpoint.cursor_bytes == self.checkpoint_cursor_bytes and
            checkpoint.allocation_count == self.checkpoint_allocation_count and
            checkpoint.publication_epoch == self.checkpoint_publication_epoch
            and checkpoint.owner_nonce == self.authority.owner_nonce

    fn _profile_frozen() -> bool:
        domain_arena_v2_profile_valid(self.profile) and
            self.profile.schema_version == self.sealed_profile.schema_version and
            self.profile.profile_id == self.sealed_profile.profile_id and
            self.profile.domain_id == self.sealed_profile.domain_id and
            self.profile.quota_bytes == self.sealed_profile.quota_bytes and
            self.profile.alignment == self.sealed_profile.alignment and
            self.profile.max_allocations_per_generation == self.sealed_profile.max_allocations_per_generation and
            self.profile.allowed_context_mask == self.sealed_profile.allowed_context_mask and
            self.profile.forbidden_context_mask == self.sealed_profile.forbidden_context_mask and
            self.profile.strict_default == self.sealed_profile.strict_default and
            self.profile.sealed == self.sealed_profile.sealed

    fn _reject(requested: u64, reason: u16) -> DomainArenaV2Rejection:
        val committed = self.authority.snapshot.cursor_bytes
        DomainArenaV2Rejection(
            arena_id: self.arena_id, domain_id: self.profile.domain_id,
            generation: self.staging_generation, requested_bytes: requested,
            remaining_bytes: if committed < self.profile.quota_bytes:
                self.profile.quota_bytes - committed else: 0u64,
            reason: reason)

    me try_allocate(bytes: u64, context: u64) -> DomainArenaV2Allocation:
        # This path performs only scalar checks and fixed-bank writes.  In
        # particular, it does not hash, concatenate, stringify, or copy.
        if not self._profile_frozen() or not self.transaction_open or
           context != ARENA_CONTEXT_NORMAL or bytes == 0u64:
            self.overflow_count = self.overflow_count + 1u64
            return DomainArenaV2Allocation.Rejected(self._reject(bytes, ARENA_EXHAUSTION_INVALID_REQUEST))
        if self.allocation_count >= self.profile.max_allocations_per_generation:
            self.overflow_count = self.overflow_count + 1u64
            return DomainArenaV2Allocation.Rejected(self._reject(bytes, ARENA_EXHAUSTION_ALLOCATION_COUNT))
        val alignment = self.profile.alignment as u64
        val remainder = self.cursor_bytes % alignment
        val padding = if remainder == 0u64: 0u64 else: alignment - remainder
        if padding > self.profile.quota_bytes - self.cursor_bytes or
           bytes > self.profile.quota_bytes - self.cursor_bytes - padding:
            self.overflow_count = self.overflow_count + 1u64
            return DomainArenaV2Allocation.Rejected(self._reject(bytes, ARENA_EXHAUSTION_QUOTA))
        val offset = self.cursor_bytes + padding
        val slot = self.allocation_count as i64
        val mint = (self.staging_generation << 32u64) ^ (self.allocation_count as u64 + 1u64)
        val staging = self._staging_bank()
        staging.ref_offsets[slot] = offset
        staging.ref_sizes[slot] = bytes
        staging.ref_mints[slot] = mint
        self.cursor_bytes = offset + bytes
        self.allocation_count = self.allocation_count + 1u32
        if self.cursor_bytes > self.high_water_bytes: self.high_water_bytes = self.cursor_bytes
        DomainArenaV2Allocation.Allocated(DomainArenaRefV2(
            arena_id: self.arena_id, domain_id: self.profile.domain_id,
            generation: self.staging_generation, offset_bytes: offset,
            size_bytes: bytes, mint: mint))

    fn _staging_ref_valid(reference: DomainArenaRefV2) -> bool:
        if not self.transaction_open or not self._profile_frozen() or
           reference.arena_id != self.arena_id or reference.domain_id != self.profile.domain_id or
           reference.generation != self.staging_generation or reference.size_bytes == 0u64 or
           reference.offset_bytes >= self.cursor_bytes or
           reference.size_bytes > self.cursor_bytes - reference.offset_bytes:
            return false
        val staging = self._staging_bank()
        var i = 0
        while i < self.allocation_count and i < staging.ref_offsets.len():
            if staging.ref_offsets[i] == reference.offset_bytes and
               staging.ref_sizes[i] == reference.size_bytes and
               staging.ref_mints[i] == reference.mint:
                return true
            i = i + 1
        false

    fn _committed_ref_valid(reference: DomainArenaRefV2) -> bool:
        val committed = self.authority.snapshot
        if not self._profile_frozen() or reference.arena_id != self.arena_id or
           reference.domain_id != self.profile.domain_id or
           reference.generation != committed.generation or reference.size_bytes == 0u64 or
           reference.offset_bytes >= committed.cursor_bytes or
           reference.size_bytes > committed.cursor_bytes - reference.offset_bytes:
            return false
        val bank = self._committed_bank()
        var i = 0
        while i < committed.allocation_count and i < bank.ref_offsets.len():
            if bank.ref_offsets[i] == reference.offset_bytes and
               bank.ref_sizes[i] == reference.size_bytes and bank.ref_mints[i] == reference.mint:
                return true
            i = i + 1
        false

    me write_byte(reference: DomainArenaRefV2, relative_offset: u64, value: u8) -> bool:
        if not self._staging_ref_valid(reference) or relative_offset >= reference.size_bytes:
            return false
        val staging = self._staging_bank()
        staging.bytes[(reference.offset_bytes + relative_offset) as i64] = value
        true

    fn read_byte(reference: DomainArenaRefV2, relative_offset: u64) -> u8?:
        if not self._committed_ref_valid(reference) or relative_offset >= reference.size_bytes:
            return nil
        val committed = self._committed_bank()
        Some(committed.bytes[(reference.offset_bytes + relative_offset) as i64])

    me commit(owner: DomainArenaOwnerCapabilityV2, checkpoint: DomainArenaCheckpointV2) -> bool:
        if owner.arena_id != self.arena_id or owner.nonce != self.authority.owner_nonce or
           not self.transaction_open or not self._checkpoint_matches(checkpoint) or
           not self._profile_frozen() or
           checkpoint.generation != self.staging_generation or
           checkpoint.publication_epoch != self.authority.snapshot.publication_epoch or
           self.armed_fault_point == DOMAIN_ARENA_V2_FAULT_BEFORE_PUBLICATION:
            if self.armed_fault_point == DOMAIN_ARENA_V2_FAULT_BEFORE_PUBLICATION:
                self.armed_fault_point = DOMAIN_ARENA_V2_FAULT_NONE
            return false
        val old_epoch = self.authority.snapshot.publication_epoch
        if old_epoch == DOMAIN_ARENA_V2_U64_MAX: return false
        # The authority assignment is the sole publication event.  Readers
        # resolve the bank through this same private state object.
        self.authority.snapshot = DomainArenaCommittedSnapshotV2(
            generation: self.staging_generation, cursor_bytes: self.cursor_bytes,
            allocation_count: self.allocation_count,
            publication_epoch: old_epoch + 1u64)
        self.authority.bank_index = if self.authority.bank_index == 0u8: 1u8 else: 0u8
        self.transaction_open = false
        true

    me rollback(checkpoint: DomainArenaCheckpointV2) -> bool:
        if not self.transaction_open or not self._checkpoint_matches(checkpoint) or
           not self._profile_frozen() or
           checkpoint.generation != self.staging_generation or
           checkpoint.publication_epoch != self.authority.snapshot.publication_epoch:
            return false
        val staging = self._staging_bank()
        var i = 0
        while i < staging.bytes.len():
            staging.bytes[i] = 0u8
            i = i + 1
        var j = 0
        while j < staging.ref_offsets.len():
            staging.ref_offsets[j] = 0u64
            staging.ref_sizes[j] = 0u64
            staging.ref_mints[j] = 0u64
            j = j + 1
        self.cursor_bytes = self.authority.snapshot.cursor_bytes
        self.allocation_count = self.authority.snapshot.allocation_count
        self.generation = self.authority.snapshot.generation
        self.transaction_open = false
        self.armed_fault_point = DOMAIN_ARENA_V2_FAULT_NONE
        true

fn domain_arena_v2_storage_hash(arena: DomainArenaV2) -> text:
    val committed = arena.authority.snapshot
    val bank = arena._committed_bank()
    var canonical = (
        "domain-arena-committed-bytes-v2|schema=2|arena_id=" + arena.arena_id.to_text() +
        "|domain_id=" + arena.profile.domain_id.to_text() +
        "|profile_hash=" + relaxed_allocation_profile_hash_v1(arena.profile) +
        "|generation=" + committed.generation.to_text() +
        "|cursor_bytes=" + committed.cursor_bytes.to_text() +
        "|allocation_count=" + committed.allocation_count.to_text() +
        "|publication_epoch=" + committed.publication_epoch.to_text() +
        "|capacity_bytes=" + bank.bytes.len().to_text() +
        "|byte_count=" + committed.cursor_bytes.to_text() +
        "|span_count=" + committed.allocation_count.to_text() + "|spans=")
    var span_index = 0
    while span_index < committed.allocation_count:
        canonical = canonical +
            bank.ref_offsets[span_index].to_text().len().to_text() + ":" +
            bank.ref_offsets[span_index].to_text() + "," +
            bank.ref_sizes[span_index].to_text().len().to_text() + ":" +
            bank.ref_sizes[span_index].to_text() + "," +
            bank.ref_mints[span_index].to_text().len().to_text() + ":" +
            bank.ref_mints[span_index].to_text() + ";"
        span_index = span_index + 1
    canonical = canonical + "|bytes="
    var i = 0
    while (i as u64) < committed.cursor_bytes:
        canonical = canonical + bank.bytes[i].to_text() + ","
        i = i + 1
    sha256_text(canonical)

fn domain_arena_committed_state_hash_v2(arena: DomainArenaV2) -> text:
    domain_arena_v2_storage_hash(arena)

fn domain_arena_committed_bytes_hash_v2(arena: DomainArenaV2) -> text:
    domain_arena_v2_storage_hash(arena)

fn domain_arena_evidence_snapshot_row_v2(snapshot_hash: text) -> text:
    "MCI_DOMAIN_ARENA_EVIDENCE|schema=2|kind=committed_snapshot|snapshot_hash=" + snapshot_hash

export DOMAIN_ARENA_V2_SCHEMA, DOMAIN_ARENA_V2_MAX_QUOTA_BYTES,
    DOMAIN_ARENA_V2_MAX_REFS, DOMAIN_ARENA_V2_REJECT_INVALID_ARENA,
    DOMAIN_ARENA_V2_REJECT_INVALID_PROFILE, DOMAIN_ARENA_V2_REJECT_OVERSIZE,
    DOMAIN_ARENA_V2_REJECT_OWNER, DOMAIN_ARENA_V2_FAULT_NONE,
    DOMAIN_ARENA_V2_FAULT_BEFORE_PUBLICATION,
    DomainArenaV2ConstructionError, DomainArenaV2Rejection,
    DomainArenaV2Creation, DomainArenaV2Allocation, DomainArenaRefV2,
    DomainArenaCheckpointV2, DomainArenaCommittedSnapshotV2, DomainArenaV2
export domain_arena_v2_profile_valid, domain_arena_committed_state_hash_v2,
    domain_arena_committed_bytes_hash_v2, domain_arena_evidence_snapshot_row_v2
