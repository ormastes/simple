# UI Session — GUI widget frame producer (font-dependent)
#
# `UISession` itself is backend-neutral and must stay loadable by a terminal
# UI. Lowering a widget tree to a canonical Draw IR frame is NOT: it resolves
# theme material and per-language font metrics, which pulls the OpenType/glyph
# parser under `src/lib/skia` into the module graph.
#
# So the frame producer lives here, as an extension `impl` block on UISession,
# instead of in `session.spl`. A GUI backend that needs it imports this module
# explicitly; a CLI/TUI backend imports only `session.spl` and never sees the
# font parser (REQ-UI-SLIM-004).
#
# `session.spl` must NOT re-export anything from this module — a re-export
# reintroduces the exact edge this split removes. Pinned by
# `test/01_unit/lib/ui/session_closure_spec.spl`.

use common.ui.draw_ir.{DrawIrComposition}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_with_theme}
use common.ui.theme_render_snapshot.{ThemeRenderSnapshot}
use common.ui.wm_chrome_theme.{active_wm_theme_id, active_wm_theme_snapshot_unchecked}
use nogc_sync_mut.ui.theme_package.{resolve_theme_alias, theme_package_render_snapshot}
use nogc_sync_mut.ui.session.{UISession}

fn _ui_session_selected_theme_snapshot(requested_theme: text, resolved_theme: text) -> ThemeRenderSnapshot:
    val active_theme_id = active_wm_theme_id()
    if active_theme_id != "" and active_theme_id == resolved_theme:
        val active_snapshot: ThemeRenderSnapshot = active_wm_theme_snapshot_unchecked()
        return active_snapshot
    # ResolvedThemePackage never crosses this module boundary; its owner
    # projects the canonical snapshot for native callers.
    val selected_snapshot: ThemeRenderSnapshot = theme_package_render_snapshot(requested_theme)
    selected_snapshot

impl UISession:

    me submit_widget_draw_ir(width: i32, height: i32, backend: text) -> DrawIrComposition:
        """Build the canonical widget frame and assign its submission identity."""
        val root = self.state.tree.root_node()
        val requested_theme = self.state.tree.theme_name()
        val resolved_theme = resolve_theme_alias(requested_theme)
        # A process-global WM snapshot must never override a tree that selected
        # a different theme. Reuse it only when its identity matches; otherwise
        # resolve the tree's own canonical package snapshot. The compatibility
        # widget lowerer reads global WM chrome and would repaint this session
        # with another application's material.
        val selected_snapshot: ThemeRenderSnapshot = _ui_session_selected_theme_snapshot(requested_theme, resolved_theme)
        val composition = widget_tree_to_draw_ir_with_theme(root, width, height, backend, selected_snapshot)
        self.submit_draw_ir_composition(composition)
