# Freestanding UI access store. It preserves the UISession persistence/query
# contract for the lifetime of the desktop without retaining hosted SQLite.
use common.ui.access.{UiAccessNode, UiAccessEvent, UiAccessSnapshot}

class UiAccessStoreError:
    detail: text

impl UiAccessStoreError:
    fn message() -> text:
        self.detail

class UiAccessStore:
    events: [UiAccessEvent]
    nodes: [UiAccessNode]

impl UiAccessStore:
    static fn memory() -> Result<UiAccessStore, UiAccessStoreError>:
        Ok(UiAccessStore(events: [], nodes: []))

    me insert_event(event: UiAccessEvent) -> Result<i64, UiAccessStoreError>:
        self.events = self.events.push(event)
        Ok(self.events.len())

    me persist_snapshot(snapshot: UiAccessSnapshot) -> Result<(), UiAccessStoreError>:
        self.nodes = snapshot.nodes
        Ok(())

    fn list_events(surface_id: text, limit: i64) -> Result<[UiAccessEvent], UiAccessStoreError>:
        var out: [UiAccessEvent] = []
        var index: i64 = 0
        while index < self.events.len() and out.len() < limit:
            val event = self.events[index]
            if surface_id == "" or event.surface_id == surface_id:
                out = out.push(event)
            index = index + 1
        Ok(out)

    fn query_nodes(surface_id: text, kind: text, text_query: text, limit: i64) -> Result<[UiAccessNode], UiAccessStoreError>:
        var out: [UiAccessNode] = []
        var index: i64 = 0
        while index < self.nodes.len() and out.len() < limit:
            val node = self.nodes[index]
            if (
                (surface_id == "" or node.surface_id == surface_id) and
                (kind == "" or node.kind == kind) and
                (text_query == "" or node.text_value.contains(text_query))
            ):
                out = out.push(node)
            index = index + 1
        Ok(out)

export UiAccessStore
