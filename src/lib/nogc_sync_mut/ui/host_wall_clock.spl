# Host wall-clock adapter — UNIX-epoch time for the WM/GUI/web/2D lane.
#
# WML001 (src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl)
# forbids the portable lane importing `io_runtime` directly. Some lane code
# (src/lib/nogc_sync_mut/play/wm/mod.spl) specifically needs UNIX-epoch wall
# time -- NOT W1's FrameClock port (src/lib/common/ui/ui_frame_clock.spl),
# whose epoch is deliberately unspecified and monotonic-only -- because a
# caller OUTSIDE the lane (src/app/play/wm_access_cli.spl, which is not
# under any wm_lane_scope_dirs() entry) computes an absolute `deadline_ms`
# from that same UNIX epoch and passes it in; swapping the lane's internal
# "now" read to FrameClock's monotonic clock would silently corrupt that
# deadline arithmetic (arbitrary/near-zero monotonic epoch minus a
# multi-trillion-ms UNIX timestamp never trips the timeout). See
# doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W3).
#
# This file re-exports the SAME underlying wall-clock read from outside the
# lane's scope dirs -- `nogc_sync_mut/ui/` is exempt (its `ui` sub-segment is
# a rendering sub-lane per _wml_render_sublanes()), exactly like
# host_frame_clock.spl -- so the epoch and the underlying rt call are
# byte-for-byte unchanged from the direct `io_runtime` import it replaces.

use std.nogc_sync_mut.io_runtime.{time_now_unix_micros}

pub fn host_now_unix_micros() -> i64:
    time_now_unix_micros()
