# Optional HTML GUI event session. All foreign calls require the macOS main thread.

@unsafe(reason: "main-thread optional HTML provider session", capabilities: [ffi])
extern fn rt_gui_begin_session()
@unsafe(reason: "borrowed HTML copied by optional GUI provider", capabilities: [ffi])
extern fn rt_gui_session_present_html(html: text)
@unsafe(reason: "bounded event packet copied into runtime-owned text", capabilities: [ffi])
extern fn rt_gui_poll_event() -> text
@unsafe(reason: "consume main-thread GUI session resources", capabilities: [ffi])
extern fn rt_gui_end_session()

struct HtmlGuiEvent:
    kind: text
    data: text

fn html_gui_begin_session():
    unsafe(capabilities: [ffi]):
        rt_gui_begin_session()

fn html_gui_present(html: text):
    unsafe(capabilities: [ffi]):
        rt_gui_session_present_html(html)

# Split only the first newline; pasted text may itself contain line breaks.
fn html_gui_decode_event(packet: text) -> HtmlGuiEvent:
    if packet == "":
        return HtmlGuiEvent(kind: "", data: "")
    val delimiter = packet.index_of("\n")
    if delimiter <= 0:
        return HtmlGuiEvent(kind: "close", data: "invalid provider event")
    HtmlGuiEvent(kind: packet.slice(0, delimiter), data: packet.slice(delimiter + 1, packet.len()))

fn html_gui_poll_event() -> HtmlGuiEvent:
    val packet = unsafe(capabilities: [ffi]):
        rt_gui_poll_event()
    html_gui_decode_event(packet)

fn html_gui_end_session():
    unsafe(capabilities: [ffi]):
        rt_gui_end_session()
