# UiSceneColumnArenaV2 (F3) — direct-write packed column arena, per doc plan
# §4.3 ("Simple WM/GUI/Web/2D Rendering Performance").
#
# ADDITIVE V2: the frozen DrawIR-v3 schema, `ui_scene_arena.spl` and
# `draw_ir_v3_native_writer.spl` are NOT modified. V1's writers own
# reservation-sized LOCAL columns and a commit step COPIES them row-by-row
# into the arena (`draw_ir_v3_native_writer.spl:373-379`) — a deliberate
# workaround for the interpreter's class-field value-copy divergence
# (documented at the top of `ui_scene_arena.spl`). V2 removes the copy:
# producers write THROUGH the arena itself into stable leased partitions,
# so there are no writer-owned temporaries and no commit copy at all.
#
# Interpreter-divergence design constraint (same as v1, different answer):
# every column is a TOP-LEVEL field of this class (no nested buffer class),
# and all mutation happens through methods on the one holder instance or
# through free functions that receive the arena as a plain parameter —
# both propagation patterns are verified to work under the tree-walk
# interpreter. `commit_copy_bytes` exists so any regression back toward a
# copying commit is observable in-band: it must stay 0 forever on this path.
#
# Layout: ONE flat `[u32]` word store per generation (front/back). Each
# table is a contiguous slice: `table_base[t] .. table_base[t] +
# table_stride[t]*table_rows_cap[t]`. A producer leases a PARTITION — a
# stable contiguous row range inside one table — and writes rows by direct
# indexed stores. Exceeding the lease is a typed refusal, never a grow.

# Verdict codes (integers, not enums — engine-portable; see the enum-match
# divergence bugs filed 2026-08-06).
val UI_SCENE_V2_OK: i64 = 0
val UI_SCENE_V2_PARTITION_OVERFLOW: i64 = 1
val UI_SCENE_V2_BAD_TABLE: i64 = 2
val UI_SCENE_V2_BAD_PARTITION: i64 = 3
val UI_SCENE_V2_BAD_ROW: i64 = 4
val UI_SCENE_V2_BAD_COLUMN: i64 = 5
val UI_SCENE_V2_SWAP_BLOCKED: i64 = 6

class UiSceneColumnArenaV2:
    # generation word stores — preallocated once, never grown mid-frame
    words_front: [u32]
    words_back: [u32]
    # per-table layout
    table_base: [u32]
    table_stride: [u32]
    table_rows_cap: [u32]
    table_count: i64
    # partitions (parallel arrays): stable producer leases
    part_table: [u32]
    part_start_row: [u32]
    part_cap_rows: [u32]
    part_cursor_rows: [u32]
    part_producer: [u32]
    part_count: i64
    # per-table next free row for leasing
    table_next_row: [u32]
    # dirty row ranges recorded against the BACK generation
    dirty_table: [u32]
    dirty_start: [u32]
    dirty_count: [u32]
    dirty_len: i64
    # generations + in-band regression counters
    front_generation: u32
    back_generation: u32
    back_sealed: bool
    alloc_count: u32
    commit_copy_bytes: u32

    # Allocate ONCE. `strides[t]` = words per row, `rows_caps[t]` = row
    # capacity for table t. Growth only via a fresh create at a frame
    # boundary (capacity rebase), never mid-frame.
    static fn create(strides: [u32], rows_caps: [u32]) -> UiSceneColumnArenaV2:
        val n = strides.len()
        var bases: [u32] = []
        var next_rows: [u32] = []
        var total: i64 = 0
        var t = 0
        while t < n:
            bases.push(total as u32)
            next_rows.push(0)
            total = total + (strides[t] as i64) * (rows_caps[t] as i64)
            t = t + 1
        var front: [u32] = []
        var back: [u32] = []
        var i: i64 = 0
        while i < total:
            front.push(0)
            back.push(0)
            i = i + 1
        UiSceneColumnArenaV2(
            words_front: front, words_back: back,
            table_base: bases, table_stride: strides, table_rows_cap: rows_caps,
            table_count: n,
            part_table: [], part_start_row: [], part_cap_rows: [],
            part_cursor_rows: [], part_producer: [], part_count: 0,
            table_next_row: next_rows,
            dirty_table: [], dirty_start: [], dirty_count: [], dirty_len: 0,
            front_generation: 0, back_generation: 1, back_sealed: false,
            alloc_count: 1, commit_copy_bytes: 0)

    # Lease a stable partition of `rows` rows in `table_id` for `producer`.
    # Returns the partition index, or -1 (typed refusal) when the table has
    # no remaining capacity — the arena NEVER grows to satisfy a lease.
    me lease_partition(producer: u32, table_id: i64, rows: u32) -> i64:
        if table_id < 0 or table_id >= self.table_count:
            return -1
        val start = self.table_next_row[table_id]
        if (start as i64) + (rows as i64) > (self.table_rows_cap[table_id] as i64):
            return -1
        self.table_next_row[table_id] = start + rows
        self.part_table.push(table_id as u32)
        self.part_start_row.push(start)
        self.part_cap_rows.push(rows)
        self.part_cursor_rows.push(0)
        self.part_producer.push(producer)
        val idx = self.part_count
        self.part_count = self.part_count + 1
        idx

    # Direct indexed write of one word: partition-relative row, column
    # within the row. No temporaries, no gather, no commit step.
    me write_word(part_idx: i64, row: u32, col: u32) -> i64:
        # bounds gate shared by write_word_value below; split so callers can
        # pre-validate a batch once then stream values.
        if part_idx < 0 or part_idx >= self.part_count:
            return UI_SCENE_V2_BAD_PARTITION
        val t = self.part_table[part_idx] as i64
        if row >= self.part_cap_rows[part_idx]:
            return UI_SCENE_V2_PARTITION_OVERFLOW
        if col >= self.table_stride[t]:
            return UI_SCENE_V2_BAD_COLUMN
        UI_SCENE_V2_OK

    me write_word_value(part_idx: i64, row: u32, col: u32, value: u32) -> i64:
        val verdict = self.write_word(part_idx, row, col)
        if verdict != UI_SCENE_V2_OK:
            return verdict
        val t = self.part_table[part_idx] as i64
        val abs_row = self.part_start_row[part_idx] + row
        val off = (self.table_base[t] as i64) + (abs_row as i64) * (self.table_stride[t] as i64) + (col as i64)
        self.words_back[off] = value
        if row >= self.part_cursor_rows[part_idx]:
            self.part_cursor_rows[part_idx] = row + 1
        self._mark_dirty(t as u32, abs_row)
        UI_SCENE_V2_OK

    me _mark_dirty(table_id: u32, abs_row: u32):
        # coalesce with the last range when contiguous or overlapping
        if self.dirty_len > 0:
            val last = self.dirty_len - 1
            if self.dirty_table[last] == table_id:
                val s = self.dirty_start[last]
                val e = s + self.dirty_count[last]
                if abs_row >= s and abs_row <= e:
                    if abs_row == e:
                        self.dirty_count[last] = self.dirty_count[last] + 1
                    return
        self.dirty_table.push(table_id)
        self.dirty_start.push(abs_row)
        self.dirty_count.push(1)
        self.dirty_len = self.dirty_len + 1

    # Read back a word from the FRONT (presented) generation.
    me front_word(table_id: i64, abs_row: u32, col: u32) -> u32:
        val off = (self.table_base[table_id] as i64) + (abs_row as i64) * (self.table_stride[table_id] as i64) + (col as i64)
        self.words_front[off]

    me back_word(table_id: i64, abs_row: u32, col: u32) -> u32:
        val off = (self.table_base[table_id] as i64) + (abs_row as i64) * (self.table_stride[table_id] as i64) + (col as i64)
        self.words_back[off]

    me seal_back():
        self.back_sealed = true

    # Swap front/back generation VALUES (v1 pattern — no reallocation, and
    # `alloc_count` proves it). Blocked until the back generation is sealed.
    # NOTE: this is the ONLY place a whole-store copy could sneak back in;
    # it must remain a field-value exchange, never an element loop.
    me try_swap() -> i64:
        if not self.back_sealed:
            return UI_SCENE_V2_SWAP_BLOCKED
        val tmp = self.words_front
        self.words_front = self.words_back
        self.words_back = tmp
        val g = self.front_generation
        self.front_generation = self.back_generation
        self.back_generation = g + 2
        self.back_sealed = false
        self.dirty_table = []
        self.dirty_start = []
        self.dirty_count = []
        self.dirty_len = 0
        UI_SCENE_V2_OK

export UiSceneColumnArenaV2
export UI_SCENE_V2_OK, UI_SCENE_V2_PARTITION_OVERFLOW, UI_SCENE_V2_BAD_TABLE
export UI_SCENE_V2_BAD_PARTITION, UI_SCENE_V2_BAD_ROW, UI_SCENE_V2_BAD_COLUMN
export UI_SCENE_V2_SWAP_BLOCKED
