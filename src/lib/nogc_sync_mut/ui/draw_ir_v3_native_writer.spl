# Unified Packed UI Scene — bounds-checked native cursor writers, the
# arena commit step, the `PackedDrawPortV2` reference port and a v1
# `PackedDrawPort` compatibility adapter (design §2.3, §2.6).
#
# Design authority: `doc/05_design/ui/unified_packed_ui_scene.md` §2.3, §2.6, §3.
# Lane: L5 (`doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md`).
#
# Every `put_*` here is bounds-checked against the RESERVED sub-range for
# this write pass: a write at or past `range.count` is refused (`false`)
# and invalidates the generation (design §2.3 "under-emission is as fatal
# as overflow") rather than writing into the next producer's reserved
# slice or silently growing.
#
# ARCHITECTURE NOTE (verified interpreter limitation, see
# `ui_scene_arena.spl`'s module doc for the full probe writeup): a class
# instance stored as a field of another class is captured BY VALUE at
# assignment time under `bin/simple test`'s tree-walk interpreter, so a
# writer holding an `arena: UiSceneArena` field would silently mutate a
# private copy the caller's own `arena` variable never sees. Each writer
# below is therefore SELF-CONTAINED (it owns its own local, reservation-
# sized columns, not a reference into the arena) and a caller commits a
# finished writer's output into the arena via the free functions at the
# bottom of this file, which take BOTH the arena and the writer as fresh
# parameters in the same call -- the one pattern confirmed to propagate
# mutation back to the caller's own variable.

use common.ui.draw_ir_v3.{
    DrawIrV3Command,
    DrawIrV3Geometry,
    DrawIrV3Paint,
    DrawIrV3TextRun,
    DrawIrV3Glyph,
    DrawIrV3Resource,
    DrawIrV3PathSpan,
    DrawIrV3PathPoint,
    DrawIrV3Clip,
    DrawIrV3Transform,
    DrawIrV3HitShape,
    DrawIrV3Provenance,
    DrawIrV3Scene
}
use common.ui.ui_scene_counts.{
    UiSceneRange,
    UiSceneRanges,
    UI_SCENE_TABLE_COMMANDS,
    UI_SCENE_TABLE_GEOMETRY,
    UI_SCENE_TABLE_PAINT,
    UI_SCENE_TABLE_TEXT_RUNS,
    UI_SCENE_TABLE_GLYPHS,
    UI_SCENE_TABLE_RESOURCES,
    UI_SCENE_TABLE_PATH_SPANS,
    UI_SCENE_TABLE_PATH_POINTS,
    UI_SCENE_TABLE_CLIPS,
    UI_SCENE_TABLE_TRANSFORMS,
    UI_SCENE_TABLE_HIT_SHAPES,
    UI_SCENE_TABLE_PROVENANCE_EDGES,
    UI_SCENE_TABLE_OWNER_RECORDS,
    UI_SCENE_TABLE_ACTION_BINDINGS,
    ui_scene_ranges_zero,
    ui_scene_ranges_set
}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, MenuActionBinding}
use common.ui.ui_scene_slice.{UiSceneWriteVerdict, DrawIrV3Writer, UiOwnerWriter, UiActionWriter}
use common.ui.draw_ir_v3_ports.{
    PackedDrawPort,
    DrawIrV3SubmitReceipt,
    DRAW_IR_V3_CAP_COMPUTE_PASSES
}
use nogc_sync_mut.ui.ui_scene_arena.{UiSceneArena}

fn _deficit_or_surplus(table_id: u16, cursor: u32, count: u32) -> UiSceneWriteVerdict:
    if cursor < count:
        return UiSceneWriteVerdict.Deficit(table_id: table_id, n: count - cursor)
    UiSceneWriteVerdict.Surplus(table_id: table_id, n: cursor - count)

# =========================================================================
# DrawIrV3Writer — bounds-checked cursor writer over tables 0-11. Owns its
# own reservation-sized local columns (see module doc); a caller commits
# them into an arena's back generation via `ui_scene_commit_draw_write`.
# =========================================================================

class UiSceneNativeWriter:
    ranges: UiSceneRanges
    valid: bool
    commands: [DrawIrV3Command]
    geometry: [DrawIrV3Geometry]
    paint: [DrawIrV3Paint]
    text_runs: [DrawIrV3TextRun]
    glyphs: [DrawIrV3Glyph]
    resources: [DrawIrV3Resource]
    path_spans: [DrawIrV3PathSpan]
    path_points: [DrawIrV3PathPoint]
    clips: [DrawIrV3Clip]
    transforms: [DrawIrV3Transform]
    hit_shapes: [DrawIrV3HitShape]
    provenance: [DrawIrV3Provenance]
    commands_cursor: u32
    geometry_cursor: u32
    paint_cursor: u32
    text_runs_cursor: u32
    glyphs_cursor: u32
    resources_cursor: u32
    path_spans_cursor: u32
    path_points_cursor: u32
    clips_cursor: u32
    transforms_cursor: u32
    hit_shapes_cursor: u32
    provenance_cursor: u32

impl UiSceneNativeWriter:
    static fn new(ranges: UiSceneRanges) -> UiSceneNativeWriter:
        UiSceneNativeWriter(
            ranges: ranges, valid: true,
            commands: [], geometry: [], paint: [], text_runs: [], glyphs: [],
            resources: [], path_spans: [], path_points: [], clips: [],
            transforms: [], hit_shapes: [], provenance: [],
            commands_cursor: 0u32, geometry_cursor: 0u32, paint_cursor: 0u32,
            text_runs_cursor: 0u32, glyphs_cursor: 0u32, resources_cursor: 0u32,
            path_spans_cursor: 0u32, path_points_cursor: 0u32, clips_cursor: 0u32,
            transforms_cursor: 0u32, hit_shapes_cursor: 0u32, provenance_cursor: 0u32
        )

    me is_valid() -> bool:
        self.valid

    me commands_snapshot() -> [DrawIrV3Command]:
        self.commands
    me geometry_snapshot() -> [DrawIrV3Geometry]:
        self.geometry
    me paint_snapshot() -> [DrawIrV3Paint]:
        self.paint
    me text_runs_snapshot() -> [DrawIrV3TextRun]:
        self.text_runs
    me glyphs_snapshot() -> [DrawIrV3Glyph]:
        self.glyphs
    me resources_snapshot() -> [DrawIrV3Resource]:
        self.resources
    me path_spans_snapshot() -> [DrawIrV3PathSpan]:
        self.path_spans
    me path_points_snapshot() -> [DrawIrV3PathPoint]:
        self.path_points
    me clips_snapshot() -> [DrawIrV3Clip]:
        self.clips
    me transforms_snapshot() -> [DrawIrV3Transform]:
        self.transforms
    me hit_shapes_snapshot() -> [DrawIrV3HitShape]:
        self.hit_shapes
    me provenance_snapshot() -> [DrawIrV3Provenance]:
        self.provenance

impl DrawIrV3Writer for UiSceneNativeWriter:
    me put_command(row: DrawIrV3Command) -> bool:
        if self.commands_cursor >= self.ranges.commands.count:
            self.valid = false
            return false
        self.commands.push(row)
        self.commands_cursor = self.commands_cursor + 1u32
        true

    me put_geometry(row: DrawIrV3Geometry) -> bool:
        if self.geometry_cursor >= self.ranges.geometry.count:
            self.valid = false
            return false
        self.geometry.push(row)
        self.geometry_cursor = self.geometry_cursor + 1u32
        true

    me put_paint(row: DrawIrV3Paint) -> bool:
        if self.paint_cursor >= self.ranges.paint.count:
            self.valid = false
            return false
        self.paint.push(row)
        self.paint_cursor = self.paint_cursor + 1u32
        true

    me put_text_run(row: DrawIrV3TextRun) -> bool:
        if self.text_runs_cursor >= self.ranges.text_runs.count:
            self.valid = false
            return false
        self.text_runs.push(row)
        self.text_runs_cursor = self.text_runs_cursor + 1u32
        true

    me put_glyph(row: DrawIrV3Glyph) -> bool:
        if self.glyphs_cursor >= self.ranges.glyphs.count:
            self.valid = false
            return false
        self.glyphs.push(row)
        self.glyphs_cursor = self.glyphs_cursor + 1u32
        true

    me put_resource(row: DrawIrV3Resource) -> bool:
        if self.resources_cursor >= self.ranges.resources.count:
            self.valid = false
            return false
        self.resources.push(row)
        self.resources_cursor = self.resources_cursor + 1u32
        true

    me put_path_span(row: DrawIrV3PathSpan) -> bool:
        if self.path_spans_cursor >= self.ranges.path_spans.count:
            self.valid = false
            return false
        self.path_spans.push(row)
        self.path_spans_cursor = self.path_spans_cursor + 1u32
        true

    me put_path_point(row: DrawIrV3PathPoint) -> bool:
        if self.path_points_cursor >= self.ranges.path_points.count:
            self.valid = false
            return false
        self.path_points.push(row)
        self.path_points_cursor = self.path_points_cursor + 1u32
        true

    me put_clip(row: DrawIrV3Clip) -> bool:
        if self.clips_cursor >= self.ranges.clips.count:
            self.valid = false
            return false
        self.clips.push(row)
        self.clips_cursor = self.clips_cursor + 1u32
        true

    me put_transform(row: DrawIrV3Transform) -> bool:
        if self.transforms_cursor >= self.ranges.transforms.count:
            self.valid = false
            return false
        self.transforms.push(row)
        self.transforms_cursor = self.transforms_cursor + 1u32
        true

    me put_hit_shape(row: DrawIrV3HitShape) -> bool:
        if self.hit_shapes_cursor >= self.ranges.hit_shapes.count:
            self.valid = false
            return false
        self.hit_shapes.push(row)
        self.hit_shapes_cursor = self.hit_shapes_cursor + 1u32
        true

    me put_provenance(row: DrawIrV3Provenance) -> bool:
        if self.provenance_cursor >= self.ranges.provenance_edges.count:
            self.valid = false
            return false
        self.provenance.push(row)
        self.provenance_cursor = self.provenance_cursor + 1u32
        true

    me cursor(table_id: u16) -> u32:
        if table_id == UI_SCENE_TABLE_COMMANDS:
            return self.commands_cursor
        if table_id == UI_SCENE_TABLE_GEOMETRY:
            return self.geometry_cursor
        if table_id == UI_SCENE_TABLE_PAINT:
            return self.paint_cursor
        if table_id == UI_SCENE_TABLE_TEXT_RUNS:
            return self.text_runs_cursor
        if table_id == UI_SCENE_TABLE_GLYPHS:
            return self.glyphs_cursor
        if table_id == UI_SCENE_TABLE_RESOURCES:
            return self.resources_cursor
        if table_id == UI_SCENE_TABLE_PATH_SPANS:
            return self.path_spans_cursor
        if table_id == UI_SCENE_TABLE_PATH_POINTS:
            return self.path_points_cursor
        if table_id == UI_SCENE_TABLE_CLIPS:
            return self.clips_cursor
        if table_id == UI_SCENE_TABLE_TRANSFORMS:
            return self.transforms_cursor
        if table_id == UI_SCENE_TABLE_HIT_SHAPES:
            return self.hit_shapes_cursor
        if table_id == UI_SCENE_TABLE_PROVENANCE_EDGES:
            return self.provenance_cursor
        0u32

    me finish() -> UiSceneWriteVerdict:
        if self.commands_cursor != self.ranges.commands.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_COMMANDS, self.commands_cursor, self.ranges.commands.count)
        if self.geometry_cursor != self.ranges.geometry.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_GEOMETRY, self.geometry_cursor, self.ranges.geometry.count)
        if self.paint_cursor != self.ranges.paint.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_PAINT, self.paint_cursor, self.ranges.paint.count)
        if self.text_runs_cursor != self.ranges.text_runs.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_TEXT_RUNS, self.text_runs_cursor, self.ranges.text_runs.count)
        if self.glyphs_cursor != self.ranges.glyphs.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_GLYPHS, self.glyphs_cursor, self.ranges.glyphs.count)
        if self.resources_cursor != self.ranges.resources.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_RESOURCES, self.resources_cursor, self.ranges.resources.count)
        if self.path_spans_cursor != self.ranges.path_spans.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_PATH_SPANS, self.path_spans_cursor, self.ranges.path_spans.count)
        if self.path_points_cursor != self.ranges.path_points.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_PATH_POINTS, self.path_points_cursor, self.ranges.path_points.count)
        if self.clips_cursor != self.ranges.clips.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_CLIPS, self.clips_cursor, self.ranges.clips.count)
        if self.transforms_cursor != self.ranges.transforms.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_TRANSFORMS, self.transforms_cursor, self.ranges.transforms.count)
        if self.hit_shapes_cursor != self.ranges.hit_shapes.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_HIT_SHAPES, self.hit_shapes_cursor, self.ranges.hit_shapes.count)
        if self.provenance_cursor != self.ranges.provenance_edges.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_PROVENANCE_EDGES, self.provenance_cursor, self.ranges.provenance_edges.count)
        UiSceneWriteVerdict.Exact

# =========================================================================
# UiOwnerWriter / UiActionWriter — same shape, over tables 12/13.
# =========================================================================

class UiSceneNativeOwnerWriter:
    range: UiSceneRange
    valid: bool
    records: [UiOwnerRecord]
    write_cursor: u32

impl UiSceneNativeOwnerWriter:
    static fn new(range: UiSceneRange) -> UiSceneNativeOwnerWriter:
        UiSceneNativeOwnerWriter(range: range, valid: true, records: [], write_cursor: 0u32)

    me is_valid() -> bool:
        self.valid

    me records_snapshot() -> [UiOwnerRecord]:
        self.records

impl UiOwnerWriter for UiSceneNativeOwnerWriter:
    me put_owner_record(row: UiOwnerRecord) -> bool:
        if self.write_cursor >= self.range.count:
            self.valid = false
            return false
        self.records.push(row)
        self.write_cursor = self.write_cursor + 1u32
        true

    me cursor() -> u32:
        self.write_cursor

    me finish() -> UiSceneWriteVerdict:
        if self.write_cursor != self.range.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_OWNER_RECORDS, self.write_cursor, self.range.count)
        UiSceneWriteVerdict.Exact

class UiSceneNativeActionWriter:
    range: UiSceneRange
    valid: bool
    bindings: [MenuActionBinding]
    write_cursor: u32

impl UiSceneNativeActionWriter:
    static fn new(range: UiSceneRange) -> UiSceneNativeActionWriter:
        UiSceneNativeActionWriter(range: range, valid: true, bindings: [], write_cursor: 0u32)

    me is_valid() -> bool:
        self.valid

    me bindings_snapshot() -> [MenuActionBinding]:
        self.bindings

impl UiActionWriter for UiSceneNativeActionWriter:
    me put_action_binding(row: MenuActionBinding) -> bool:
        if self.write_cursor >= self.range.count:
            self.valid = false
            return false
        self.bindings.push(row)
        self.write_cursor = self.write_cursor + 1u32
        true

    me cursor() -> u32:
        self.write_cursor

    me finish() -> UiSceneWriteVerdict:
        if self.write_cursor != self.range.count:
            return _deficit_or_surplus(UI_SCENE_TABLE_ACTION_BINDINGS, self.write_cursor, self.range.count)
        UiSceneWriteVerdict.Exact

# =========================================================================
# Commit — copies a finished writer's local columns into an arena's back
# generation. Free functions taking BOTH the arena and the writer as fresh
# parameters (see module doc): this is the pattern confirmed to propagate
# mutation back to the caller's own `arena` variable.
# =========================================================================

fn ui_scene_commit_draw_write(arena: UiSceneArena, w: UiSceneNativeWriter, ranges: UiSceneRanges) -> bool:
    if not w.is_valid():
        arena.mark_back_invalid()
        return false

    val commands = w.commands_snapshot()
    var i = 0u32
    while i < commands.len().to_u32():
        if not arena.set_back_command(ranges.commands.start + i, commands[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32
    arena.set_back_commands_used(ranges.commands.start + commands.len().to_u32())

    val geometry = w.geometry_snapshot()
    i = 0u32
    while i < geometry.len().to_u32():
        if not arena.set_back_geometry(ranges.geometry.start + i, geometry[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val paint = w.paint_snapshot()
    i = 0u32
    while i < paint.len().to_u32():
        if not arena.set_back_paint(ranges.paint.start + i, paint[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val text_runs = w.text_runs_snapshot()
    i = 0u32
    while i < text_runs.len().to_u32():
        if not arena.set_back_text_run(ranges.text_runs.start + i, text_runs[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val glyphs = w.glyphs_snapshot()
    i = 0u32
    while i < glyphs.len().to_u32():
        if not arena.set_back_glyph(ranges.glyphs.start + i, glyphs[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val resources = w.resources_snapshot()
    i = 0u32
    while i < resources.len().to_u32():
        if not arena.set_back_resource(ranges.resources.start + i, resources[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val path_spans = w.path_spans_snapshot()
    i = 0u32
    while i < path_spans.len().to_u32():
        if not arena.set_back_path_span(ranges.path_spans.start + i, path_spans[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val path_points = w.path_points_snapshot()
    i = 0u32
    while i < path_points.len().to_u32():
        if not arena.set_back_path_point(ranges.path_points.start + i, path_points[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val clips = w.clips_snapshot()
    i = 0u32
    while i < clips.len().to_u32():
        if not arena.set_back_clip(ranges.clips.start + i, clips[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val transforms = w.transforms_snapshot()
    i = 0u32
    while i < transforms.len().to_u32():
        if not arena.set_back_transform(ranges.transforms.start + i, transforms[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val hit_shapes = w.hit_shapes_snapshot()
    i = 0u32
    while i < hit_shapes.len().to_u32():
        if not arena.set_back_hit_shape(ranges.hit_shapes.start + i, hit_shapes[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    val provenance = w.provenance_snapshot()
    i = 0u32
    while i < provenance.len().to_u32():
        if not arena.set_back_provenance(ranges.provenance_edges.start + i, provenance[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32

    true

fn ui_scene_commit_owner_write(arena: UiSceneArena, w: UiSceneNativeOwnerWriter, range: UiSceneRange) -> bool:
    if not w.is_valid():
        arena.mark_back_invalid()
        return false
    val records = w.records_snapshot()
    var i = 0u32
    while i < records.len().to_u32():
        if not arena.set_back_owner(range.start + i, records[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32
    arena.set_back_owners_used(range.start + records.len().to_u32())
    true

fn ui_scene_commit_action_write(arena: UiSceneArena, w: UiSceneNativeActionWriter, range: UiSceneRange) -> bool:
    if not w.is_valid():
        arena.mark_back_invalid()
        return false
    val bindings = w.bindings_snapshot()
    var i = 0u32
    while i < bindings.len().to_u32():
        if not arena.set_back_action(range.start + i, bindings[i.to_i64()]):
            arena.mark_back_invalid()
            return false
        i = i + 1u32
    true

# =========================================================================
# v1 compatibility adapter (design §2.6 "v1 stays frozen"; L5 owns this
# adapter, not `draw_ir_v3_ports.spl` itself). Routes an existing by-value
# `PackedDrawPort.submit_scene` call through the arena/native-writer path so
# tests still written against the v1 port shape keep working. Only the
# COMMANDS table is round-tripped -- the fixtures this adapter targets are
# command-only (no geometry/paint/... references); a producer that needs
# the other tables uses the arena/writer path directly, not this adapter.
#
# `committed_command_at`/`committed_command_count` read back through THIS
# port's own held `arena` field rather than through a separately-held
# `UiSceneArena` variable a caller might have constructed it from: per the
# interpreter behavior documented at the top of this file, a caller's own
# `arena` variable and this port's `self.arena` are independent after
# construction, but reads/writes performed consistently through the SAME
# holder (this port) do see each other's effects.
# =========================================================================

class UiSceneV1CompatPort:
    arena: UiSceneArena

impl UiSceneV1CompatPort:
    static fn new(arena: UiSceneArena) -> UiSceneV1CompatPort:
        UiSceneV1CompatPort(arena: arena)

    me committed_command_count() -> u32:
        self.arena.front_command_count()

    me committed_command_at(idx: u32) -> DrawIrV3Command:
        self.arena.front_command_at(idx)

    me committed_generation() -> u32:
        self.arena.front_generation_id()

fn _v1_refused_receipt(scene_generation: u64) -> DrawIrV3SubmitReceipt:
    DrawIrV3SubmitReceipt(
        scene_generation: scene_generation, accepted: false, route: 0u16,
        fallback_level: 0u16, elapsed_us: 0u64,
        deterministic_hash_lo: 0u64, deterministic_hash_hi: 0u64
    )

impl PackedDrawPort for UiSceneV1CompatPort:
    me capabilities() -> u32:
        DRAW_IR_V3_CAP_COMPUTE_PASSES

    me submit_scene(scene: DrawIrV3Scene) -> DrawIrV3SubmitReceipt:
        val n = scene.commands.len().to_u32()
        if n > self.arena.capacity_max_rows(UI_SCENE_TABLE_COMMANDS):
            return _v1_refused_receipt(scene.generation.to_u64())

        self.arena.begin_generation()
        val ranges = ui_scene_ranges_set(
            ui_scene_ranges_zero(), UI_SCENE_TABLE_COMMANDS,
            UiSceneRange(start: 0u32, count: n)
        )
        val writer = UiSceneNativeWriter.new(ranges)

        var i = 0
        var all_ok = true
        while i < scene.commands.len():
            if not writer.put_command(scene.commands[i]):
                all_ok = false
            i = i + 1

        val verdict = writer.finish()
        val exact = match verdict:
            UiSceneWriteVerdict.Exact: true
            UiSceneWriteVerdict.Deficit(table_id, deficit_n): false
            UiSceneWriteVerdict.Surplus(table_id, surplus_n): false

        if not all_ok or not exact:
            self.arena.mark_back_invalid()
            return _v1_refused_receipt(scene.generation.to_u64())

        if not ui_scene_commit_draw_write(self.arena, writer, ranges):
            return _v1_refused_receipt(scene.generation.to_u64())

        self.arena.signal_front_complete()
        val swapped = self.arena.try_swap()
        DrawIrV3SubmitReceipt(
            scene_generation: scene.generation.to_u64(), accepted: swapped,
            route: 0u16, fallback_level: 0u16, elapsed_us: 0u64,
            deterministic_hash_lo: 0u64, deterministic_hash_hi: 0u64
        )

    me submit_patch(scene_generation: u64, patch_op_count: i64) -> DrawIrV3SubmitReceipt:
        # Not implemented by this adapter (no fixture needs it) -- an honest
        # fail-closed refusal, never a fabricated accept.
        _v1_refused_receipt(scene_generation)

    me present(scene_generation: u64) -> bool:
        scene_generation == self.arena.front_generation_id().to_u64()

export UiSceneNativeWriter, UiSceneNativeOwnerWriter, UiSceneNativeActionWriter,
    UiSceneV1CompatPort,
    ui_scene_commit_draw_write, ui_scene_commit_owner_write, ui_scene_commit_action_write
