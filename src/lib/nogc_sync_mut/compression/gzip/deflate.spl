# DEFLATE Compression Algorithm
#
# Purpose: DEFLATE compression (LZ77 + Huffman coding)
#
# Contains:
# - DEFLATE block creation (stored, fixed Huffman)
# - Length/distance code mapping
# - Block encoding with Huffman codes
# - Token-to-block conversion

use std.nogc_sync_mut.compression.gzip.types.{
    BLOCK_STORED, BLOCK_FIXED, BLOCK_DYNAMIC
}
use std.nogc_sync_mut.compression.gzip.huffman.{
    deflate_fixed_huffman, deflate_fixed_distances, huffman_lookup,
    deflate_length_extra, deflate_distance_extra
}

# =============================================================================
# DEFLATE BLOCKS
# =============================================================================

# Create DEFLATE stored block (uncompressed)
fn deflate_block_stored(data, is_final) -> [u8]:
    if data == nil:
        return []

    # LEN is a 16-bit field (RFC 1951 3.2.4): longer input becomes a run of
    # stored blocks, and only the last one may carry BFINAL.
    var block: [u8] = []
    val total = data.len()
    var start = 0
    loop:
        val len = if total - start > 65535: 65535 else: total - start
        val last = start + len >= total
        var header = BLOCK_STORED << 1
        if is_final and last:
            header = header | 1
        block.push(header.to_u8())
        block.push((len & 0xff).to_u8())
        block.push(((len >> 8) & 0xff).to_u8())
        val nlen = (~len) & 0xffff
        block.push((nlen & 0xff).to_u8())
        block.push(((nlen >> 8) & 0xff).to_u8())
        var i = start
        while i < start + len:
            block.push(data[i])
            i = i + 1
        start = start + len
        if last:
            break

    return block

# Reverse the low `n` bits of `code` (Huffman codes are sent MSB-first, RFC 1951 3.1.1).
fn _reverse_bits(code: i64, n: i64) -> i64:
    var r = 0
    var i = 0
    while i < n:
        r = (r << 1) | ((code >> i) & 1)
        i = i + 1
    r

# Pack (value, bit-count) pairs LSB-first into bytes, zero-padding the last byte
# (RFC 1951 3.1.1). One pass with a single owned output array: the previous
# bit-writer returned its whole byte array from every call, which copied it per
# symbol (O(n^2); 7.7 GB RSS under JIT for a 30 KB input).
fn deflate_pack_bits(vals: [i64], counts: [i64]) -> [u8]:
    var out: [u8] = []
    var buf = 0
    var cnt = 0
    var i = 0
    while i < vals.len():
        buf = buf | (vals[i] << cnt)
        cnt = cnt + counts[i]
        while cnt >= 8:
            out.push((buf & 255).to_u8())
            buf = buf >> 8
            cnt = cnt - 8
        i = i + 1
    if cnt > 0:
        out.push((buf & 255).to_u8())
    out

# Core fixed-Huffman block writer (RFC 1951 3.2.6).
#
# `sync_flush` appends an empty stored block (RFC 1951 3.2.4) so the stream
# ends in 00 00 FF FF -- required by RFC 7692 permessage-deflate. The stored
# block's 3 header bits are packed INTO the bitstream *before* padding, so they
# share the end-of-block symbol's trailing byte whenever there is room; that is
# what makes the output byte-exact with zlib Z_SYNC_FLUSH.
fn _deflate_block_fixed_ex(tokens, is_final, sync_flush) -> [u8]:
    if tokens == nil:
        return []

    # Fixed codes pre-reversed to send order (codes go out MSB-first, 3.1.1) once per
    # block, indexed by symbol: the per-token path is then two array reads.
    # Values read out of untyped `[Any]` rows are bound to typed locals before any
    # arithmetic: the seed JIT otherwise passes them on still tagged
    # (build/probe/gzip_jit3.spl).
    var lit_vals: [i64] = []
    var lit_bits: [i64] = []
    for row in deflate_fixed_huffman():
        val code: i64 = row[1]
        val nbits: i64 = row[2]
        lit_vals.push(_reverse_bits(code, nbits))
        lit_bits.push(nbits)
    var dist_vals: [i64] = []
    for row in deflate_fixed_distances():
        val code: i64 = row[1]
        dist_vals.push(_reverse_bits(code, 5))

    # Bit fields in send order: BFINAL (1 bit) then BTYPE (2 bits), LSB-first.
    var vals: [i64] = []
    var counts: [i64] = []
    vals.push(if is_final: 1 else: 0)
    counts.push(1)
    vals.push(BLOCK_FIXED)
    counts.push(2)

    var i = 0
    while i < tokens.len():
        val token = tokens[i]
        val token_type: i64 = token[0]
        val value: i64 = token[1]

        if token_type == 0:
            vals.push(lit_vals[value])
            counts.push(lit_bits[value])
        else:
            # Match: token = [1, distance, length]
            val length: i64 = token[2]
            val len_code = deflate_length_code(length)
            vals.push(lit_vals[len_code])
            counts.push(lit_bits[len_code])

            val len_extra = deflate_length_extra(length)
            val len_ex_val: i64 = len_extra[0]
            val len_ex_cnt: i64 = len_extra[1]
            if len_ex_cnt > 0:
                vals.push(len_ex_val)
                counts.push(len_ex_cnt)

            vals.push(dist_vals[deflate_distance_code(value)])
            counts.push(5)

            val dist_extra = deflate_distance_extra(value)
            val dist_ex_val: i64 = dist_extra[0]
            val dist_ex_cnt: i64 = dist_extra[1]
            if dist_ex_cnt > 0:
                vals.push(dist_ex_val)
                counts.push(dist_ex_cnt)

        i = i + 1

    # End-of-block symbol (256)
    vals.push(lit_vals[256])
    counts.push(lit_bits[256])

    if not sync_flush:
        return deflate_pack_bits(vals, counts)

    # Empty stored block header: BFINAL=0 (1 bit) + BTYPE=00 stored (2 bits).
    vals.push(0)
    counts.push(3)
    var out = deflate_pack_bits(vals, counts)
    # LEN = 0x0000, NLEN = 0xFFFF -- byte-aligned after the padding above.
    out.push(0x00u8)
    out.push(0x00u8)
    out.push(0xFFu8)
    out.push(0xFFu8)
    return out

fn deflate_block_fixed(tokens, is_final) -> [u8]:
    _deflate_block_fixed_ex(tokens, is_final, false)

# Fixed-Huffman block in sync-flush mode: BFINAL=0 plus the empty stored block
# tail (00 00 FF FF).  Used by RFC 7692 permessage-deflate.
fn deflate_block_fixed_sync_flush(tokens) -> [u8]:
    _deflate_block_fixed_ex(tokens, false, true)

# Get length code for match length
fn deflate_length_code(length) -> i64:
    if length <= 10:
        return 257 + (length - 3)
    if length <= 18:
        return 265 + ((length - 11) / 2)
    if length <= 34:
        return 269 + ((length - 19) / 4)
    if length <= 66:
        return 273 + ((length - 35) / 8)
    if length <= 130:
        return 277 + ((length - 67) / 16)
    if length <= 257:
        return 281 + ((length - 131) / 32)
    return 285

# Get distance code for match distance
fn deflate_distance_code(distance) -> i64:
    if distance <= 4:
        return distance - 1
    if distance <= 8:
        return 4 + ((distance - 5) / 2)
    if distance <= 16:
        return 6 + ((distance - 9) / 4)
    if distance <= 32:
        return 8 + ((distance - 17) / 8)
    if distance <= 64:
        return 10 + ((distance - 33) / 16)
    if distance <= 128:
        return 12 + ((distance - 65) / 32)
    if distance <= 256:
        return 14 + ((distance - 129) / 64)
    if distance <= 512:
        return 16 + ((distance - 257) / 128)
    if distance <= 1024:
        return 18 + ((distance - 513) / 256)
    if distance <= 2048:
        return 20 + ((distance - 1025) / 512)
    if distance <= 4096:
        return 22 + ((distance - 2049) / 1024)
    if distance <= 8192:
        return 24 + ((distance - 4097) / 2048)
    if distance <= 16384:
        return 26 + ((distance - 8193) / 4096)
    if distance <= 24576:
        return 28
    return 29
