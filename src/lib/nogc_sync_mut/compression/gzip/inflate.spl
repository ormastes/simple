# DEFLATE Decompression Algorithm (RFC 1951)
#
# Purpose: DEFLATE decompression (inflate) operations
#
# Contains:
# - Canonical Huffman table construction and symbol decoding (RFC 1951 3.2.2)
# - Stored, fixed-Huffman (3.2.6) and dynamic-Huffman (3.2.7) blocks
# - Multi-block stream handling with a bounded output budget
#
# PERF: the stream position is a single integer bit offset (`bp`) over the input
# array. The previous reader returned a fresh `[data, byte, bit, failed]` tuple per
# bit, which copied the input array for every bit decoded (O(n^2) in the
# interpreter). Nothing here allocates per bit.

use std.nogc_sync_mut.compression.gzip.types.{
    BLOCK_STORED, BLOCK_FIXED, BLOCK_DYNAMIC
}
use std.nogc_sync_mut.compression.gzip.huffman.{
    deflate_length_decode_info, deflate_distance_decode_info
}

# =============================================================================
# BIT ACCESS (RFC 1951 3.1.1: data elements are packed LSB-first)
# =============================================================================

# Read `n` bits starting at bit offset `bp`. The caller has checked bp + n <= total.
fn _bits(data: [u8], bp: i64, n: i64) -> i64:
    var v = 0
    var i = 0
    while i < n:
        val p = bp + i
        v = v | (((data[p >> 3].to_i64() >> (p & 7)) & 1) << i)
        i = i + 1
    v

# Peek `n` (<= 9) bits at bit offset `bp` without consuming them; bytes past the
# end of input read as zero (the caller checks the consumed length against `total`).
fn _peek(data: [u8], bp: i64, n: i64) -> i64:
    val bi = bp >> 3
    var w = data[bi].to_i64()
    if bi + 1 < data.len():
        w = w | (data[bi + 1].to_i64() << 8)
    if bi + 2 < data.len():
        w = w | (data[bi + 2].to_i64() << 16)
    (w >> (bp & 7)) & ((1 << n) - 1)

# =============================================================================
# CANONICAL HUFFMAN TABLES
# =============================================================================

# Width of the direct lookup table. Codes up to this many bits decode in one step;
# longer codes fall back to the bit-by-bit canonical decoder.
val FAST_BITS = 9

# Build a canonical Huffman decoder from per-symbol code lengths.
# Returns [counts, symbols, fast]: counts[len] = number of codes of that length,
# symbols = symbol values sorted by (length, symbol) -- the puff layout; fast is a
# 2^FAST_BITS table indexed by the next FAST_BITS input bits (LSB-first) holding
# (symbol << 4) | code_length, or 0 when the code is longer than FAST_BITS.
fn huffman_build(lengths: [i64]) -> [Any]:
    var counts: [i64] = []
    var offs: [i64] = []
    var i = 0
    while i <= 15:
        counts.push(0)
        offs.push(0)
        i = i + 1
    for l in lengths:
        if l > 0:
            counts[l] = counts[l] + 1
    var len_i = 1
    while len_i < 15:
        offs[len_i + 1] = offs[len_i] + counts[len_i]
        len_i = len_i + 1
    var symbols: [i64] = []
    for _l in lengths:
        symbols.push(0)
    i = 0
    while i < lengths.len():
        val l = lengths[i]
        if l > 0:
            symbols[offs[l]] = i
            offs[l] = offs[l] + 1
        i = i + 1
    var fast: [i64] = []
    i = 0
    while i < (1 << FAST_BITS):
        fast.push(0)
        i = i + 1
    var code = 0
    var index = 0
    var l = 1
    while l <= FAST_BITS:
        var n = 0
        while n < counts[l]:
            # Codes are sent MSB-first, so the table is indexed by the bit-reversed code.
            var rev = 0
            var b = 0
            while b < l:
                rev = (rev << 1) | ((code >> b) & 1)
                b = b + 1
            var f = rev
            while f < (1 << FAST_BITS):
                fast[f] = (symbols[index] << 4) | l
                f = f + (1 << l)
            index = index + 1
            code = code + 1
            n = n + 1
        code = code << 1
        l = l + 1
    return [counts, symbols, fast]

# RFC 1951 3.2.2: a code must not be over-subscribed. An incomplete code is
# only tolerated as the single one-bit code that zlib also accepts
# (`allow_single`); an empty code only where `allow_empty` (no distances).
fn _huffman_lengths_valid(lengths: [i64], allow_empty: bool, allow_single: bool) -> bool:
    var counts: [i64] = []
    var i: i64 = 0
    while i <= 15:
        counts.push(0)
        i = i + 1
    var used: i64 = 0
    for length in lengths:
        if length > 0:
            counts[length] = counts[length] + 1
            used = used + 1
    if used == 0:
        return allow_empty
    var remaining: i64 = 1
    i = 1
    while i <= 15:
        remaining = (remaining << 1) - counts[i]
        if remaining < 0:
            return false
        i = i + 1
    if remaining > 0:
        return allow_single and used == 1 and counts[1] == 1
    true

# Decode one symbol with a canonical decoder starting at bit offset `bp`.
# Returns [symbol, new_bp]; symbol is -1 when no code matches within 15 bits or
# the input ends first.
fn huffman_decode_symbol(data: [u8], bp: i64, total: i64, counts: [i64], symbols: [i64], fast: [i64]) -> [i64]:
    if bp < total:
        val e = fast[_peek(data, bp, FAST_BITS)]
        if e != 0:
            if bp + (e & 15) > total:
                return [-1, total]
            return [e >> 4, bp + (e & 15)]
    var pos = bp
    var code = 0
    var first = 0
    var index = 0
    var len_i = 1
    while len_i <= 15:
        if pos >= total:
            return [-1, pos]
        code = code | ((data[pos >> 3].to_i64() >> (pos & 7)) & 1)
        pos = pos + 1
        val count = counts[len_i]
        if code - first < count:
            return [symbols[index + code - first], pos]
        index = index + count
        first = (first + count) << 1
        code = code << 1
        len_i = len_i + 1
    return [-1, pos]

# Fixed literal/length code lengths (RFC 1951 3.2.6): 288 symbols.
fn _fixed_litlen_lengths() -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 288:
        out.push(if i < 144: 8 elif i < 256: 9 elif i < 280: 7 else: 8)
        i = i + 1
    out

# =============================================================================
# BLOCK BODIES
# =============================================================================

# Decode literal/length + distance symbols until end-of-block. `history` is the
# output of the earlier blocks: it is only READ (RFC 1951 back-references may reach
# into earlier blocks, section 3.2) and never copied, so a block costs O(its own
# output) however much was produced before. `max_output` bounds the TOTAL length
# (history + block; negative = unbounded).
# Returns [block_output, new_bp] -- the NEW bytes only -- or nil on malformed or
# truncated input.
fn _inflate_codes(data: [u8], bp0: i64, total: i64, history: [u8], max_output: i64, lit: [Any], dist: [Any]) -> [Any]?:
    val lc: [i64] = lit[0]
    val ls: [i64] = lit[1]
    val lf: [i64] = lit[2]
    val dc: [i64] = dist[0]
    val ds: [i64] = dist[1]
    val df: [i64] = dist[2]
    var bp = bp0
    val hlen = history.len()
    var out: [u8] = []
    loop:
        val sr = huffman_decode_symbol(data, bp, total, lc, ls, lf)
        val symbol: i64 = sr[0]
        bp = sr[1]
        if symbol < 0:
            return nil
        if symbol == 256:
            break
        if symbol < 256:
            if max_output >= 0 and hlen + out.len() >= max_output:
                return nil
            out.push(symbol.to_u8())
        else:
            if symbol > 285:
                return nil
            val len_info = deflate_length_decode_info(symbol)
            val base_len: i64 = len_info[0]
            val ex_cnt: i64 = len_info[1]
            var length = base_len
            if ex_cnt > 0:
                if bp + ex_cnt > total:
                    return nil
                length = base_len + _bits(data, bp, ex_cnt)
                bp = bp + ex_cnt
            val dr = huffman_decode_symbol(data, bp, total, dc, ds, df)
            val dist_code: i64 = dr[0]
            bp = dr[1]
            if dist_code < 0 or dist_code > 29:
                return nil
            val di_info = deflate_distance_decode_info(dist_code)
            val base_dist: i64 = di_info[0]
            val dex_cnt: i64 = di_info[1]
            var distance = base_dist
            if dex_cnt > 0:
                if bp + dex_cnt > total:
                    return nil
                distance = base_dist + _bits(data, bp, dex_cnt)
                bp = bp + dex_cnt
            if distance > hlen + out.len():
                return nil
            if max_output >= 0 and hlen + out.len() + length > max_output:
                return nil
            var src = hlen + out.len() - distance
            var j = 0
            if src >= hlen:
                # Source lies wholly in this block (the common case).
                src = src - hlen
                while j < length:
                    out.push(out[src + j])
                    j = j + 1
            else:
                while j < length:
                    out.push(if src < hlen: history[src] else: out[src - hlen])
                    src = src + 1
                    j = j + 1
    return [out, bp]

# Fixed-Huffman tables (RFC 1951 3.2.6) as [literal/length, distance]; built once per stream.
fn _fixed_tables() -> [Any]:
    var dist_lengths: [i64] = []
    var i = 0
    while i < 32:
        dist_lengths.push(5)
        i = i + 1
    return [huffman_build(_fixed_litlen_lengths()), huffman_build(dist_lengths)]

# Dynamic-Huffman block (RFC 1951 3.2.7): read the code-length tables, then the body.
fn _inflate_dynamic(data: [u8], bp0: i64, total: i64, history: [u8], max_output: i64) -> [Any]?:
    var bp = bp0
    if bp + 14 > total:
        return nil
    val hlit = _bits(data, bp, 5) + 257
    val hdist = _bits(data, bp + 5, 5) + 1
    val hclen = _bits(data, bp + 10, 4) + 4
    bp = bp + 14
    if hlit > 286 or hdist > 30:
        return nil

    # Code-length alphabet lengths, in the RFC's permuted order
    val order = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
    var clen_lengths: [i64] = []
    var i = 0
    while i < 19:
        clen_lengths.push(0)
        i = i + 1
    if bp + hclen * 3 > total:
        return nil
    i = 0
    while i < hclen:
        clen_lengths[order[i]] = _bits(data, bp, 3)
        bp = bp + 3
        i = i + 1
    if not _huffman_lengths_valid(clen_lengths, false, false):
        return nil
    val clen_huff = huffman_build(clen_lengths)
    val clen_counts: [i64] = clen_huff[0]
    val clen_symbols: [i64] = clen_huff[1]
    val clen_fast: [i64] = clen_huff[2]

    # Decode the hlit+hdist literal/length + distance code lengths
    val want = hlit + hdist
    var lengths: [i64] = []
    while lengths.len() < want:
        val sr = huffman_decode_symbol(data, bp, total, clen_counts, clen_symbols, clen_fast)
        val sym: i64 = sr[0]
        bp = sr[1]
        if sym < 0:
            return nil
        if sym < 16:
            lengths.push(sym)
        else:
            # 16: repeat previous 3-6x (2 bits); 17: zeros 3-10x (3 bits); 18: zeros 11-138x (7 bits)
            val bits_n = if sym == 16: 2 elif sym == 17: 3 else: 7
            if bp + bits_n > total:
                return nil
            val rep_base = if sym == 18: 11 else: 3
            val rep = rep_base + _bits(data, bp, bits_n)
            bp = bp + bits_n
            if sym == 16 and lengths.len() == 0:
                return nil
            if lengths.len() + rep > want:
                return nil
            val fill = if sym == 16: lengths[lengths.len() - 1] else: 0
            var r = 0
            while r < rep:
                lengths.push(fill)
                r = r + 1

    var litlen_lengths: [i64] = []
    i = 0
    while i < hlit:
        litlen_lengths.push(lengths[i])
        i = i + 1
    var dist_lengths: [i64] = []
    while i < want:
        dist_lengths.push(lengths[i])
        i = i + 1
    # hlit >= 257, so symbol 256 (end-of-block) is always inside the table; it must be coded.
    if (not _huffman_lengths_valid(litlen_lengths, false, true) or
        litlen_lengths[256] == 0 or
        not _huffman_lengths_valid(dist_lengths, true, true)):
        return nil
    val lit = huffman_build(litlen_lengths)
    val dist = huffman_build(dist_lengths)
    return _inflate_codes(data, bp, total, history, max_output, lit, dist)

# =============================================================================
# STREAM
# =============================================================================

# Shared DEFLATE loop over `input` from byte offset `start`. `max_output` < 0 means
# unbounded. In `member` mode (a gzip member) the stream must end with a BFINAL
# block and trailing bytes are left alone; otherwise a stream whose input ends right
# after a non-final block is accepted (RFC 7692 sync flush) and a BFINAL block must
# end exactly at the end of `input`. Returns [output, end_byte] or nil, where
# end_byte is the offset just past the last byte consumed.
fn _inflate_core(input: [u8], start: i64, max_output: i64, member: bool) -> [Any]?:
    if input.len() == 0 or max_output == 0:
        var empty: [u8] = []
        return [empty, 0]

    val total = input.len() * 8
    var bp = start * 8
    var out: [u8] = []
    var fixed_tables: [Any] = []

    loop:
        # BFINAL (1 bit) and BTYPE (2 bits), LSB-first
        if bp + 3 > total:
            return nil
        val bfinal = _bits(input, bp, 1)
        val btype = _bits(input, bp + 1, 2)
        bp = bp + 3
        if btype < BLOCK_STORED or btype > BLOCK_DYNAMIC:
            return nil

        if btype == BLOCK_STORED:
            # Skip to the byte boundary, then LEN and NLEN (RFC 1951 3.2.4)
            var byte_pos = (bp + 7) >> 3
            if byte_pos + 4 > input.len():
                return nil
            val blen = input[byte_pos].to_i64() | (input[byte_pos + 1].to_i64() << 8)
            val bnlen = input[byte_pos + 2].to_i64() | (input[byte_pos + 3].to_i64() << 8)
            byte_pos = byte_pos + 4
            if bnlen != ((~blen) & 0xffff):
                return nil
            if byte_pos + blen > input.len():
                return nil
            if max_output >= 0 and out.len() + blen > max_output:
                return nil
            var k = 0
            while k < blen:
                out.push(input[byte_pos + k])
                k = k + 1
            bp = (byte_pos + blen) * 8
        else:
            if btype == BLOCK_FIXED and fixed_tables.len() == 0:
                fixed_tables = _fixed_tables()
            val br = if btype == BLOCK_FIXED: _inflate_codes(input, bp, total, out, max_output, fixed_tables[0], fixed_tables[1]) else: _inflate_dynamic(input, bp, total, out, max_output)
            if br == nil:
                return nil
            val block_out: [u8] = br[0]
            if out.len() == 0:
                out = block_out
            else:
                for b in block_out:
                    out.push(b)
            bp = br[1]

        val consumed_bytes = (bp + 7) >> 3

        if bfinal == 1:
            if not member and consumed_bytes != input.len():
                return nil
            return [out, consumed_bytes]

        # Non-final block with the input fully consumed: this is a sync-flush
        # stream (RFC 7692 permessage-deflate), which legitimately carries no
        # BFINAL=1 block. Stop cleanly rather than reading past the end.
        if consumed_bytes >= input.len():
            if member:
                return nil
            return [out, consumed_bytes]

# Decompress a complete DEFLATE stream without allowing output beyond max_output.
# A negative max_output preserves the legacy unbounded API.
fn inflate_bounded(input: [u8], max_output: i64) -> [u8]?:
    val r = _inflate_core(input, 0, max_output, false)
    if r == nil:
        return nil
    val out: [u8] = r[0]
    return out

# Decompress ONE DEFLATE stream that starts at byte offset `start` of `input` and
# must end with a BFINAL block; bytes after it are left alone (a gzip member
# trailer follows). Returns [output, end_byte] or nil.
fn inflate_member(input: [u8], start: i64) -> [Any]?:
    _inflate_core(input, start, -1, true)

# Decompress a complete DEFLATE stream (one or more blocks).
# Returns decompressed [u8] or nil on error.
fn inflate(input: [u8]) -> [u8]?:
    inflate_bounded(input, -1)

# =============================================================================
# LEGACY INTERFACE - stored-block parser and Huffman block markers
# =============================================================================

pub struct DeflateBlockResult:
    block_type: i64
    is_final: bool
    data: [u8]
    next_offset: i64

# Parse a single DEFLATE block from a raw byte array at byte offset `offset`.
# Returns the typed block description, or nil on error.
# NOTE: For fixed-Huffman blocks the caller should use inflate() directly.
# This shim is kept for backward compatibility with stored blocks.
fn deflate_block_parse(data: [u8]?, offset: i64) -> DeflateBlockResult?:
    val input: [u8] = match data:
        case Some(bytes): bytes
        case nil: return nil

    if offset < 0:
        return nil

    if offset >= input.len():
        return nil

    # Peek at first byte to get BFINAL + BTYPE
    val header_byte = input[offset].to_i64()
    val is_final = (header_byte & 1) != 0
    val block_type = (header_byte >> 1) & 3

    if block_type == BLOCK_STORED:
        var next_offset = offset + 1
        if next_offset + 4 > input.len():
            return nil

        val blen  = input[next_offset].to_i64() | (input[next_offset + 1].to_i64() << 8)
        next_offset = next_offset + 4

        if next_offset + blen > input.len():
            return nil

        var block_data: [u8] = []
        var i = 0
        loop:
            if i >= blen:
                break
            block_data.push(input[next_offset + i])
            i = i + 1

        next_offset = next_offset + blen
        return DeflateBlockResult(block_type: block_type, is_final: is_final, data: block_data, next_offset: next_offset)

    # For fixed/dynamic blocks, inflate_block_parse is not byte-aligned; return marker.
    return DeflateBlockResult(block_type: block_type, is_final: is_final, data: [], next_offset: offset)
