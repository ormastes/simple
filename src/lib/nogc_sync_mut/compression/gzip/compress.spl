# GZIP Compression and Decompression
#
# Purpose: Main GZIP compression/decompression operations and analysis
#
# Contains:
# - GZIP compress/decompress (all levels)
# - Data validation and metadata extraction
# - Compression statistics and analysis
# - Efficiency metrics

use std.nogc_sync_mut.compression.gzip.types.{
    GZIP_MAGIC1, OS_UNIX, LEVEL_NONE, LEVEL_FAST, LEVEL_DEFAULT, LEVEL_BEST
}
use std.nogc_sync_mut.compression.gzip.crc.{
    crc32_calculate, crc32_verify, crc32_update, crc32_finalize, crc32_chunked
}
use std.nogc_sync_mut.compression.gzip.header.{
    gzip_header_create, gzip_header_parse, gzip_header_parse_at, gzip_header_size,
    gzip_footer_create, gzip_footer_parse, gzip_footer_validate
}
use std.nogc_sync_mut.compression.gzip.lz77.{lz77_compress}
use std.nogc_sync_mut.compression.gzip.deflate.{deflate_block_stored, deflate_block_fixed}
use std.nogc_sync_mut.compression.gzip.inflate.{inflate_member}

# =============================================================================
# GZIP COMPRESSION
# =============================================================================

# Compress data to GZIP format
# level: 0 = stored (uncompressed), 1-9 = fixed-Huffman DEFLATE
fn gzip_compress(data: [u8], level: i64) -> [u8]:
    if data.len() == 0:
        val crc_empty = crc32_calculate(data)
        val header_empty = gzip_header_create(nil, 0, 0, OS_UNIX)
        var deflate_empty: [u8] = []
        if level == 0:
            deflate_empty = deflate_block_stored(data, true)
        else:
            val tokens_empty = lz77_compress(data, level)
            deflate_empty = deflate_block_fixed(tokens_empty, true)
        val footer_empty = gzip_footer_create(crc_empty, 0)
        var result_empty = header_empty
        var ei = 0
        loop:
            if ei >= deflate_empty.len():
                break
            result_empty.push(deflate_empty[ei])
            ei = ei + 1
        ei = 0
        loop:
            if ei >= footer_empty.len():
                break
            result_empty.push(footer_empty[ei])
            ei = ei + 1
        return result_empty

    # Calculate CRC32 of original data
    val crc = crc32_calculate(data)
    val size = data.len()

    # Create header
    val timestamp = 0  # Current time (simplified)
    var extra_flags = 0
    if level == LEVEL_BEST:
        extra_flags = 2
    if level == LEVEL_FAST:
        extra_flags = 4

    val header = gzip_header_create(nil, timestamp, extra_flags, OS_UNIX)

    # Level 0 → stored blocks; levels 1-9 → fixed-Huffman DEFLATE
    var compressed: [u8] = []
    if level == 0:
        compressed = deflate_block_stored(data, true)
    else:
        val tokens = lz77_compress(data, level)
        compressed = deflate_block_fixed(tokens, true)

    # Create footer
    val footer = gzip_footer_create(crc, size)

    # Combine header + compressed data + footer
    var result = header
    var i = 0
    loop:
        if i >= compressed.len():
            break
        result.push(compressed[i])
        i = i + 1

    i = 0
    loop:
        if i >= footer.len():
            break
        result.push(footer[i])
        i = i + 1

    return result

# Decompress a GZIP file: a series of one or more members (RFC 1952 2.2), each
# with its own header, DEFLATE stream and CRC-32 + ISIZE trailer. The output is the
# concatenation of the members' data. Any malformed member, and any bytes after the
# last member that do not form another member, fail the whole file (nil).
fn gzip_decompress(data: [u8]) -> [u8]?:
    if data.len() < 18:
        return nil
    var result: [u8] = []
    var pos = 0
    while pos < data.len():
        val header_info = gzip_header_parse_at(data, pos)
        if header_info == nil:
            return nil
        val body = inflate_member(data, gzip_header_size(header_info))
        if body == nil:
            return nil
        val member: [u8] = body[0]
        # gzip_footer_validate also rejects a missing (truncated) trailer.
        val footer_info = gzip_footer_parse(data, body[1])
        if not gzip_footer_validate(footer_info, member, member.len()):
            return nil
        for b in member:
            result.push(b)
        pos = body[1] + 8
    return result

# Compress with default level
fn gzip_compress_default(data):
    return gzip_compress(data, LEVEL_DEFAULT)

# Compress with maximum compression
fn gzip_compress_best(data):
    return gzip_compress(data, LEVEL_BEST)

# Compress with fast compression
fn gzip_compress_fast(data):
    return gzip_compress(data, LEVEL_FAST)

# Compress without compression (stored only)
fn gzip_compress_none(data):
    return gzip_compress(data, LEVEL_NONE)

# =============================================================================
# VALIDATION AND METADATA
# =============================================================================

# Validate GZIP data integrity: every member must inflate and match its CRC-32 and
# ISIZE trailer (fail closed), exactly as gzip_decompress requires.
fn gzip_validate(data):
    if data == nil:
        return false
    return gzip_decompress(data) != nil

# Get metadata of the FIRST member: [timestamp, os, extra_flags, crc32, isize] (nil if malformed)
fn gzip_get_metadata(data):
    if data == nil:
        return nil
    val header_info = gzip_header_parse(data)
    if header_info == nil:
        return nil
    val body = inflate_member(data, gzip_header_size(header_info))
    if body == nil:
        return nil
    val footer_info = gzip_footer_parse(data, body[1])
    if footer_info == nil:
        return nil
    return [header_info[1], header_info[3], header_info[2], footer_info[0], footer_info[1]]

# Check if data is already GZIP compressed
fn gzip_is_compressed(data):
    if data == nil:
        return false

    if data.len() < 2:
        return false

    return data[0] == GZIP_MAGIC1

# Extract the DEFLATE payload of the FIRST member (between its header and trailer)
fn gzip_extract_payload(data):
    if data == nil:
        return nil
    val header_info = gzip_header_parse(data)
    if header_info == nil:
        return nil
    val header_size = gzip_header_size(header_info)
    val body = inflate_member(data, header_size)
    if body == nil:
        return nil
    var payload: [u8] = []
    var i = header_size
    while i < body[1]:
        payload.push(data[i])
        i = i + 1
    return payload

# =============================================================================
# STATISTICS AND METRICS
# =============================================================================

# Get GZIP compression ratio
fn gzip_compression_ratio(original_size, compressed_size) -> f64:
    if original_size == 0:
        return 0.0

    val ratio = compressed_size.to_float() / original_size.to_float()
    return ratio

# Get GZIP space savings percentage
fn gzip_space_savings(original_size, compressed_size) -> f64:
    if original_size == 0:
        return 0.0

    val saved = original_size - compressed_size
    val savings = (saved.to_float() / original_size.to_float()) * 100.0

    return savings

# Calculate compression efficiency
fn gzip_efficiency(original_data, compressed_data) -> f64:
    if original_data == nil:
        return 0.0
    if compressed_data == nil:
        return 0.0

    val orig_size = original_data.len()
    val comp_size = compressed_data.len()

    if orig_size == 0:
        return 0.0

    val saved = orig_size - comp_size
    val efficiency = (saved.to_float() / orig_size.to_float()) * 100.0

    return efficiency

# Calculate header overhead
fn gzip_header_overhead():
    return 10  # Minimum GZIP header size

# Calculate footer overhead
fn gzip_footer_overhead():
    return 8  # GZIP footer size (CRC32 + size)

# Calculate total overhead
fn gzip_total_overhead(has_filename):
    var overhead = gzip_header_overhead() + gzip_footer_overhead()

    if has_filename:
        overhead = overhead + 10  # Estimate

    return overhead

# =============================================================================
# DATA ANALYSIS
# =============================================================================

# Analyze data compressibility
fn gzip_analyze_data(data):
    if data == nil:
        return nil

    val size = data.len()

    # Calculate byte frequency distribution
    var freqs = []
    var i = 0

    loop:
        if i >= 256:
            break
        freqs.push(0)
        i = i + 1

    i = 0
    loop:
        if i >= size:
            break

        val byte = data[i]
        freqs[byte] = freqs[byte] + 1

        i = i + 1

    # Count unique bytes
    var unique = 0
    i = 0
    loop:
        if i >= 256:
            break

        if freqs[i] > 0:
            unique = unique + 1

        i = i + 1

    # Calculate entropy estimate
    var entropy = 0.0
    i = 0
    loop:
        if i >= 256:
            break

        if freqs[i] > 0:
            val prob = freqs[i].to_float() / size.to_float()
            val log_p = log2_approx(prob)
            entropy = entropy - (prob * log_p)

        i = i + 1

    return [size, unique, entropy, freqs]

# Approximate log2 for 0 < x <= 1 (a byte probability): minus the number of doublings
# needed to reach [1, 2), i.e. floor(log2(x)).
fn log2_approx(x) -> f64:
    var result = 0.0
    var value = x
    loop:
        if value >= 1.0:
            break
        value = value * 2.0
        result = result - 1.0
    return result

# Calculate optimal compression level for data
fn gzip_suggest_level(data):
    if data == nil:
        return LEVEL_DEFAULT

    val size = data.len()

    # Small data: use best compression
    if size < 1024:
        return LEVEL_BEST

    # Medium data: use default
    if size < 1048576:
        return LEVEL_DEFAULT

    # Large data: use fast compression
    return LEVEL_FAST

# Estimate compressed size
fn gzip_estimate_size(data, level):
    if data == nil:
        return 0

    val original_size = data.len()

    # Rough estimates based on compression level
    var ratio = 0.5
    if level == LEVEL_NONE:
        ratio = 1.0
    if level == LEVEL_FAST:
        ratio = 0.7
    if level == LEVEL_DEFAULT:
        ratio = 0.5
    if level == LEVEL_BEST:
        ratio = 0.4

    val estimated = original_size.to_float() * ratio
    return estimated.to_int()
