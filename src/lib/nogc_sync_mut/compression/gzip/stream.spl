# GZIP Stream Operations
#
# Purpose: Text <-> byte conversion helpers for gzip payloads
#
# Contains:
# - UTF-8 text to bytes
# - Bytes to text, rejecting anything that would not round-trip

use std.common.text_bytes.{text_to_bytes, bytes_to_text}

# Convert text to its UTF-8 bytes
fn gzip_stream_text_to_bytes(text: text) -> [u8]:
    return text_to_bytes(text)

# Convert bytes to text. Returns nil unless the bytes are valid UTF-8, i.e. unless
# converting the text back yields exactly the same bytes: high bytes are never
# replaced by a placeholder.
fn gzip_stream_bytes_to_text(bytes: [u8]):
    val converted = bytes_to_text(bytes)
    if text_to_bytes(converted) == bytes:
        return converted
    return nil
