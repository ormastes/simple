# GZIP Stream Operations
#
# Purpose: Text <-> byte conversion helpers for gzip payloads
#
# Contains:
# - UTF-8 text to bytes
# - Bytes to text, rejecting anything that would not round-trip

use std.common.text_bytes.{text_to_bytes}
use std.common.encoding.external_text.{bytes_to_text_checked, CodecError}

# Convert text to its UTF-8 bytes
fn gzip_stream_text_to_bytes(text: text) -> [u8]:
    return text_to_bytes(text)

# Convert bytes to text. Strict UTF-8: invalid or truncated input is an Err,
# never a placeholder-replaced or raw-byte text.
fn gzip_stream_bytes_to_text(bytes: [u8]) -> Result<text, CodecError>:
    bytes_to_text_checked(bytes)
