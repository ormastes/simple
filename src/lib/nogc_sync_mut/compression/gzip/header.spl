# GZIP Header and Footer Operations
#
# Purpose: GZIP header/footer parsing and creation (RFC 1952)
#
# Contains:
# - Header creation with filename and metadata
# - Header parsing and validation
# - Footer creation with CRC32 and size
# - Footer parsing
# - Footer validation

use std.nogc_sync_mut.compression.gzip.types.{
    GZIP_MAGIC1, GZIP_MAGIC2, CM_DEFLATE, OS_UNIX,
    FLAG_TEXT, FLAG_HCRC, FLAG_EXTRA, FLAG_NAME, FLAG_COMMENT
}
use std.nogc_sync_mut.compression.gzip.crc.{crc32_calculate}

# =============================================================================
# GZIP HEADER
# =============================================================================

# Create GZIP header
# Returns: array of header bytes
fn gzip_header_create(filename: text?, timestamp: i64, extra_flags: i64, os_type: i64) -> [u8]:
    var header: [u8] = []

    # Magic bytes
    header.push((GZIP_MAGIC1).to_u8())
    header.push((GZIP_MAGIC2).to_u8())

    # Compression method (8 = DEFLATE)
    header.push((CM_DEFLATE).to_u8())

    # Flags
    var flags = 0
    if filename != nil:
        flags = flags | FLAG_NAME
    header.push((flags).to_u8())

    # Timestamp (4 bytes, little-endian)
    val ts = timestamp
    header.push((ts & 0xff).to_u8())
    header.push(((ts >> 8) & 0xff).to_u8())
    header.push(((ts >> 16) & 0xff).to_u8())
    header.push(((ts >> 24) & 0xff).to_u8())

    # Extra flags
    header.push((extra_flags).to_u8())

    # OS type
    header.push((os_type).to_u8())

    # Optional filename: raw bytes, zero-terminated (RFC 1952 2.3.1 FNAME)
    if val name = filename:
        for b in name.bytes():
            header.push(b)
        header.push(0u8)

    return header

# Parse GZIP header at the start of `data`
# Returns: (flags, timestamp, extra_flags, os, header_size) or nil
fn gzip_header_parse(data) -> [i64]?:
    gzip_header_parse_at(data, 0)

# Parse the GZIP member header that starts at byte offset `base` (RFC 1952 2.2: a
# file is a series of members). The last element is the ABSOLUTE offset of the
# first byte after the header.
fn gzip_header_parse_at(data, base: i64) -> [i64]?:
    if data == nil:
        return nil

    if base < 0 or data.len() < base + 10:
        return nil

    # Check magic bytes
    if data[base].to_i64() != GZIP_MAGIC1:
        return nil
    if data[base + 1].to_i64() != GZIP_MAGIC2:
        return nil

    # Check compression method
    if data[base + 2].to_i64() != CM_DEFLATE:
        return nil

    val flags = data[base + 3].to_i64()
    if (flags & 0xE0) != 0:
        return nil
    val timestamp = data[base + 4].to_i64() | (data[base + 5].to_i64() << 8) | (data[base + 6].to_i64() << 16) | (data[base + 7].to_i64() << 24)
    val extra_flags = data[base + 8].to_i64()
    val os = data[base + 9].to_i64()

    var offset = base + 10

    # Skip extra field
    if (flags & FLAG_EXTRA) != 0:
        if offset + 2 > data.len():
            return nil
        val xlen = data[offset].to_i64() | (data[offset + 1].to_i64() << 8)
        offset = offset + 2 + xlen
        if offset > data.len():
            return nil

    # Skip filename
    if (flags & FLAG_NAME) != 0:
        loop:
            if offset >= data.len():
                return nil
            if data[offset].to_i64() == 0:
                offset = offset + 1
                break
            offset = offset + 1

    # Skip comment
    if (flags & FLAG_COMMENT) != 0:
        loop:
            if offset >= data.len():
                return nil
            if data[offset].to_i64() == 0:
                offset = offset + 1
                break
            offset = offset + 1

    # Header CRC16: the low 16 bits of the CRC-32 of every header byte before it
    if (flags & FLAG_HCRC) != 0:
        if offset + 2 > data.len():
            return nil
        var header_bytes: [u8] = []
        var i = base
        while i < offset:
            header_bytes.push(data[i])
            i = i + 1
        val calculated_hcrc = crc32_calculate(header_bytes) & 0xFFFF
        val stored_hcrc = data[offset].to_i64() | (data[offset + 1].to_i64() << 8)
        if calculated_hcrc != stored_hcrc:
            return nil
        offset = offset + 2

    return [flags, timestamp, extra_flags, os, offset]

# Get header size from parsed header info
fn gzip_header_size(header_info) -> i64:
    if header_info == nil:
        return 0
    if header_info.len() < 5:
        return 0
    return header_info[4].to_i64()

# =============================================================================
# GZIP FOOTER
# =============================================================================

# Create GZIP footer (CRC32 + uncompressed size)
fn gzip_footer_create(crc32: i64, size: i64) -> [u8]:
    var footer: [u8] = []

    # CRC32 (4 bytes, little-endian)
    footer.push((crc32 & 0xff).to_u8())
    footer.push(((crc32 >> 8) & 0xff).to_u8())
    footer.push(((crc32 >> 16) & 0xff).to_u8())
    footer.push(((crc32 >> 24) & 0xff).to_u8())

    # Uncompressed size modulo 2^32 (4 bytes, little-endian)
    val size_mod = size & 0xffffffff
    footer.push((size_mod & 0xff).to_u8())
    footer.push(((size_mod >> 8) & 0xff).to_u8())
    footer.push(((size_mod >> 16) & 0xff).to_u8())
    footer.push(((size_mod >> 24) & 0xff).to_u8())

    return footer

# Parse GZIP footer
# Returns: (crc32, size) or nil
fn gzip_footer_parse(data, offset) -> [i64]?:
    if data == nil:
        return nil

    if offset < 0:
        return nil

    if offset + 8 > data.len():
        return nil

    val crc = data[offset].to_i64() | (data[offset + 1].to_i64() << 8) | (data[offset + 2].to_i64() << 16) | (data[offset + 3].to_i64() << 24)
    val size = data[offset + 4].to_i64() | (data[offset + 5].to_i64() << 8) | (data[offset + 6].to_i64() << 16) | (data[offset + 7].to_i64() << 24)

    return [crc, size]

# Validate GZIP footer
fn gzip_footer_validate(footer_info, data, expected_size) -> bool:
    if footer_info == nil:
        return false
    if footer_info.len() < 2:
        return false
    if data == nil:
        return false

    val crc = footer_info[0]
    val size = footer_info[1]

    # Verify CRC32
    val calculated_crc = crc32_calculate(data)
    if calculated_crc != crc:
        return false

    # Verify size (modulo 2^32)
    val size_mod = expected_size & 0xffffffff
    if size != size_mod:
        return false

    return true
