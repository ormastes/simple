# CRC32 Checksum Operations
#
# Purpose: CRC32 checksum calculation for data integrity verification
#
# Contains:
# - CRC32 lookup table generation
# - CRC32 calculation (full data)
# - CRC32 streaming updates (chunked data)
# - CRC32 finalization
# - CRC32 verification

# =============================================================================
# CRC32 CHECKSUM
# =============================================================================

# CRC32 lookup table (256 entries, reflected polynomial 0xEDB88320, RFC 1952)
fn crc32_table():
    var table: [i64] = []
    var i = 0
    loop:
        if i >= 256:
            break
        var crc = i
        var j = 0
        loop:
            if j >= 8:
                break
            if (crc & 1) != 0:
                crc = (crc >> 1) ^ 0xEDB88320
            else:
                crc = crc >> 1
            j = j + 1
        table.push(crc)
        i = i + 1
    return table

# Cached at module init — rebuilding the 256-entry table per call was the
# dominant per-checksum cost (PERF bug recorded in C-MIG-0001, fixed 2026-08-18).
val _CRC32_TABLE = crc32_table()

# Calculate CRC32 checksum
fn crc32_calculate(data: [u8]) -> i64:
    if data == nil:
        return 0

    var crc = 0xffffffff
    var i = 0
    val table = _CRC32_TABLE

    loop:
        if i >= data.len():
            break

        val byte_val = data[i]
        val index = (crc ^ byte_val) & 0xff
        crc = (crc >> 8) ^ table[index]

        i = i + 1

    return crc ^ 0xffffffff

# Update running CRC32 with new data
fn crc32_update(crc, data: [u8]) -> i64:
    if data == nil:
        return crc

    var current = crc
    var i = 0
    val table = _CRC32_TABLE

    loop:
        if i >= data.len():
            break

        val byte_val = data[i]
        val index = (current ^ byte_val) & 0xff
        current = (current >> 8) ^ table[index]

        i = i + 1

    return current

# Finalize CRC32 (XOR with 0xffffffff)
fn crc32_finalize(crc):
    return crc ^ 0xffffffff

# Calculate CRC32 in chunks
fn crc32_chunked(chunks):
    if chunks == nil:
        return 0

    var crc = 0xffffffff
    var i = 0

    loop:
        if i >= chunks.len():
            break

        val chunk = chunks[i]
        crc = crc32_update(crc, chunk)

        i = i + 1

    return crc32_finalize(crc)

# Verify CRC32 checksum
fn crc32_verify(data, expected):
    val calculated = crc32_calculate(data)
    return calculated == expected


# Pure-Simple text CRC32 (CRC-32/ISO-HDLC, reflected poly 0xEDB88320).
#
# Replacement for the C runtime's `rt_crc32_text`
# (src/runtime/runtime_legacy_core.c:445) — same contract: empty input
# returns 0 (falls out naturally: 0xffffffff ^ 0xffffffff). Callers migrated
# off the extern: database/core.spl, database/wal.spl. Differential KAT +
# C-oracle spec: test/01_unit/lib/nogc_sync_mut/compression/crc32_text_crosslang_spec.spl
# (binary_runtime_hardening C-MIG tranche 1).
fn crc32_text(s: text) -> i64:
    # Streams over s.bytes() directly — the earlier [u8] rebuild was
    # `data = data.push(b)` per byte, an O(n^2) copy that measured ~1185x
    # slower than the C oracle on a 2KB body (perf spec
    # test/05_perf/lib/crc32_text_c_vs_simple_perf_spec.spl).
    val raw = s.bytes()
    val table = _CRC32_TABLE
    var crc = 0xffffffff
    var i = 0
    val n = raw.len()
    while i < n:
        val index = (crc ^ (raw[i] & 0xff)) & 0xff
        crc = (crc >> 8) ^ table[index]
        i = i + 1
    crc ^ 0xffffffff
