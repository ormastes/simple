# CRC32 Checksum Operations
#
# Purpose: gzip-facing CRC32 API (i64 values, chunked/streaming helpers).
# The algorithm itself has one shared implementation: std.common.crypto.crc32
# (CRC-32/ISO-HDLC, reflected poly 0xEDB88320, RFC 1952).

use std.common.crypto.crc32.{crc32, crc32_update as _shared_crc32_update}

# Calculate CRC32 checksum
fn crc32_calculate(data: [u8]) -> i64:
    if data == nil:
        return 0
    crc32(data).to_i64()

# Update running CRC32 with new data (crc is the pre-final-XOR register)
fn crc32_update(crc: i64, data: [u8]) -> i64:
    if data == nil:
        return crc
    _shared_crc32_update(crc.to_u32(), data).to_i64()

# Finalize CRC32 (XOR with 0xffffffff)
# @workaround bug=p4p2_cranelift_verifier_types_2026-10-20 reason=untyped-param fns kept a Unit signature (cranelift return mismatch)
fn crc32_finalize(crc: i64) -> i64:
    return crc ^ 0xffffffff

# Calculate CRC32 in chunks
# @workaround bug=p4p2_cranelift_verifier_types_2026-10-20 reason=untyped-param fns kept a Unit signature (cranelift return mismatch)
fn crc32_chunked(chunks: [[u8]]) -> i64:
    if chunks == nil:
        return 0

    var crc: i64 = 0xffffffff
    var i = 0

    loop:
        if i >= chunks.len():
            break

        val chunk = chunks[i]
        crc = crc32_update(crc, chunk)

        i = i + 1

    return crc32_finalize(crc)

# Verify CRC32 checksum
# @workaround bug=p4p2_cranelift_verifier_types_2026-10-20 reason=untyped-param fns kept a Unit signature (cranelift return mismatch)
fn crc32_verify(data: [u8], expected: i64) -> bool:
    val calculated = crc32_calculate(data)
    return calculated == expected


# Pure-Simple text CRC32 over the UTF-8 bytes of `s`.
#
# Replacement for the C runtime's `rt_crc32_text`
# (src/runtime/runtime_legacy_core.c:445) — same contract: empty input
# returns 0. Callers migrated off the extern: database/core.spl,
# database/wal.spl. Differential KAT + C-oracle spec:
# test/01_unit/lib/nogc_sync_mut/compression/crc32_text_crosslang_spec.spl
# (binary_runtime_hardening C-MIG tranche 1).
fn crc32_text(s: text) -> i64:
    crc32(s.bytes()).to_i64()
