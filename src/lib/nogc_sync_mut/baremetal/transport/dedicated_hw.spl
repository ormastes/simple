# Baremetal Host Communication - Dedicated HW Transport
#
# UART via hardware adapter (FTDI/CP2102/CH340).
# Uses serial FFI for direct UART access through USB-UART adapter.

use std.nogc_sync_mut.debug.remote.protocol.process_command.{debug_process_output}
use std.nogc_sync_mut.io.serial_sffi.{SerialPort, serial_close, serial_flush, serial_open, serial_read, serial_set_timeout, serial_write}

# Dedicated UART hardware adapter transport (FTDI, CP2102, CH340)
class DedicatedHwTransport:
    device: text
    baud_rate: i32
    fd: i64
    connected: bool

impl DedicatedHwTransport:
    static fn create(device: text, baud_rate: i32) -> DedicatedHwTransport:
        DedicatedHwTransport(
            device: device,
            baud_rate: baud_rate,
            fd: -1,
            connected: false
        )

    fn name() -> text:
        "dedicated_hw"

    fn is_connected() -> bool:
        self.connected

    me connect() -> Result<text, text>:
        # Detect adapter type
        val adapter_type = detect_adapter(self.device)
        if adapter_type == "unknown":
            return Err("unrecognized UART adapter at {self.device}")

        val port = serial_open(self.device, int(self.baud_rate))
        if not port.is_valid:
            return Err("failed to open UART adapter: {self.device}")

        self.fd = port.handle
        self.connected = true
        Ok("dedicated_hw connected ({adapter_type}) at {self.device} {self.baud_rate} baud")

    me disconnect() -> Result<text, text>:
        if self.fd >= 0:
            serial_close(self.serial_port())
            self.fd = -1
        self.connected = false
        Ok("dedicated_hw disconnected")

    fn send(data: text) -> Result<i32, text>:
        if not self.connected:
            return Err("not connected")
        val written = serial_write(self.serial_port(), data)
        if written < 0:
            return Err("UART write failed")
        Ok(int(written))

    fn receive() -> Result<text, text>:
        if not self.connected:
            return Err("not connected")
        val data = serial_read(self.serial_port(), 4096)
        Ok(data)

    fn receive_timeout(timeout_ms: i64) -> Result<text, text>:
        if not self.connected:
            return Err("not connected")
        serial_set_timeout(self.serial_port(), timeout_ms)
        val data = serial_read(self.serial_port(), 4096)
        Ok(data)

    me send_command(cmd: text) -> Result<text, text>:
        self.send(cmd)?
        self.receive()

    fn flush() -> Result<text, text>:
        if not self.connected:
            return Err("not connected")
        serial_flush(self.serial_port())
        Ok("flushed")

    fn available() -> Result<i32, text>:
        if not self.connected:
            return Err("not connected")
        Err("serial availability is not part of the admitted serial SFFI contract")

    me serial_port() -> SerialPort:
        SerialPort(
            handle: self.fd,
            device: self.device,
            baud: int(self.baud_rate),
            is_valid: self.connected,
            closed: false
        )

# Detect adapter type from device path
fn detect_adapter(device: text) -> text:
    # Check USB device info
    val info_result = debug_process_output(
        "udevadm",
        ["info", "--query=all", "--name={device}"]
    )
    val info = match info_result:
        Ok(value): value
        Err(_): ""
    if info.contains("FTDI"):
        return "FTDI"
    if info.contains("CP210"):
        return "CP2102"
    if info.contains("CH340") or info.contains("CH341"):
        return "CH340"
    if info.contains("PL2303"):
        return "PL2303"
    # If device exists but type unknown, still allow connection
    val check_result = debug_process_output("test", ["-c", device])
    match check_result:
        Ok(_): return "generic"
        Err(_): pass
    "unknown"
