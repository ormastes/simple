# Baremetal Host Communication - Config File Parsing
#
# Parses a `key = value` config file into a `HostCommConfig`.
# Blank lines and lines whose first non-space character is `#` are ignored.
# Unknown keys are an error, so a typo cannot silently leave a default in place.
#
# Example:
#   transport   = serial
#   serial_port = /dev/ttyUSB0
#   baud_rate   = 115200
#   timeout_ms  = 5000

use std.nogc_sync_mut.baremetal.types.{
    HostCommConfig, default_hostcomm_config, transport_kind_from_text
}

use std.io_runtime.{file_exists}
extern fn rt_file_read_text(path: text) -> text

fn _parse_bool(key: text, value: text) -> Result<bool, text>:
    match value:
        "true": Ok(true)
        "false": Ok(false)
        "1": Ok(true)
        "0": Ok(false)
        _: Err("{key}: expected true or false, got `{value}`")

fn _parse_i64(key: text, value: text) -> Result<i64, text>:
    val n = value.to_i64()
    if n == nil:
        return Err("{key}: expected an integer, got `{value}`")
    Ok(n ?? 0)

fn _parse_i32(key: text, value: text) -> Result<i32, text>:
    match _parse_i64(key, value):
        Ok(n): Ok(n.to_i32())
        Err(e): Err(e)

# Apply one `key = value` pair to `config`. Returns an error message for an
# unknown key or an unparsable value.
fn apply_hostcomm_setting(config: HostCommConfig, key: text, value: text) -> Result<HostCommConfig, text>:
    var cfg = config
    match key:
        "transport":
            match transport_kind_from_text(value):
                Ok(kind):
                    cfg.transport = kind
                Err(e):
                    return Err(e)
        "timeout_ms":
            match _parse_i64(key, value):
                Ok(n): cfg.timeout_ms = n
                Err(e): return Err(e)
        "ssh_host": cfg.ssh_host = value
        "ssh_port":
            match _parse_i32(key, value):
                Ok(n): cfg.ssh_port = n
                Err(e): return Err(e)
        "ssh_user": cfg.ssh_user = value
        "ssh_key_path": cfg.ssh_key_path = value
        "serial_port": cfg.serial_port = value
        "baud_rate":
            match _parse_i32(key, value):
                Ok(n): cfg.baud_rate = n
                Err(e): return Err(e)
        "data_bits":
            match _parse_i32(key, value):
                Ok(n): cfg.data_bits = n
                Err(e): return Err(e)
        "stop_bits":
            match _parse_i32(key, value):
                Ok(n): cfg.stop_bits = n
                Err(e): return Err(e)
        "parity": cfg.parity = value
        "t32_host": cfg.t32_host = value
        "t32_port":
            match _parse_i32(key, value):
                Ok(n): cfg.t32_port = n
                Err(e): return Err(e)
        "t32rem_path": cfg.t32rem_path = value
        "openocd_host": cfg.openocd_host = value
        "openocd_telnet_port":
            match _parse_i32(key, value):
                Ok(n): cfg.openocd_telnet_port = n
                Err(e): return Err(e)
        "openocd_cfg": cfg.openocd_cfg = value
        "stlink_serial": cfg.stlink_serial = value
        "swo_freq":
            match _parse_i64(key, value):
                Ok(n): cfg.swo_freq = n
                Err(e): return Err(e)
        "hw_device": cfg.hw_device = value
        "hw_baud_rate":
            match _parse_i32(key, value):
                Ok(n): cfg.hw_baud_rate = n
                Err(e): return Err(e)
        "log_enabled":
            match _parse_bool(key, value):
                Ok(b): cfg.log_enabled = b
                Err(e): return Err(e)
        "echo_commands":
            match _parse_bool(key, value):
                Ok(b): cfg.echo_commands = b
                Err(e): return Err(e)
        "line_ending": cfg.line_ending = value
        _:
            return Err("unknown config key: `{key}`")
    Ok(cfg)

# Parse the whole config text. Field values not mentioned keep the defaults from
# `default_hostcomm_config()`.
fn parse_hostcomm_config_text(source: text) -> Result<HostCommConfig, text>:
    var cfg = default_hostcomm_config()
    val lines = source.split("\n")
    var lineno = 0
    for raw in lines:
        lineno = lineno + 1
        val line = raw.trim()
        if line.len() == 0:
            continue
        if line.starts_with("#"):
            continue
        val eq = line.index_of("=")
        if eq < 0:
            return Err("line {lineno}: expected `key = value`, got `{line}`")
        val key = line.substring(0, eq).trim()
        val value = line.substring(eq + 1, line.len()).trim()
        if key.len() == 0:
            return Err("line {lineno}: empty key")
        match apply_hostcomm_setting(cfg, key, value):
            Ok(next): cfg = next
            Err(e): return Err("line {lineno}: {e}")
    Ok(cfg)

# Read and parse a host-communication config file.
fn parse_hostcomm_config(path: text) -> Result<HostCommConfig, text>:
    if path.len() == 0:
        return Ok(default_hostcomm_config())
    if not file_exists(path):
        return Err("config file not found: {path}")
    parse_hostcomm_config_text(rt_file_read_text(path))
