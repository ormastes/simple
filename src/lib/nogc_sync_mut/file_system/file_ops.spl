# File Operations
#
# Basic file operations: create, read, write, append, delete, rename, copy, move.
#
# Every function here is either a re-export of the one real host owner or a
# thin real wrapper over one. NO mocks: the seed binds unqualified calls by
# NAME ALONE across the co-compiled closure
# ([compiler_cross_module_private_symbol_collision] fires only for DIFFERING
# signatures; identical ones are silent), so a mock defined here took over
# real callers anywhere in the import closure, and a real owner could take
# over callers of a mock. See
# doc/08_tracking/bug/std_file_system_write_mocks_return_true_without_writing_2026-09-06.md
# and doc/08_tracking/bug/file_ops_mock_answers_for_nonexistent_paths_2026-09-06.md.

# Real owners. `file_read_text` returns `text` ("" when unreadable); callers
# that must tell a missing file from an empty one use
# `std.nogc_sync_mut.io_runtime.file_read_nullable`. `file_modified_time` and
# `file_read_lines` are re-exported from here by metadata.spl / utilities.
export use std.nogc_sync_mut.io.file_ops.{file_exists, file_read_text, file_read_lines}
export use std.nogc_sync_mut.sffi.io.{file_write_text, file_move}
export use std.nogc_sync_mut.io_runtime.{file_write_bytes}
export use std.nogc_sync_mut.io_runtime.{file_append_text, file_delete, file_rename, file_copy}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}

fn file_create(path: text) -> bool:
    """Create a new empty file. Fails if the path already exists.

    Args:
        path: File path

    Returns:
        true on success, false on error (including an existing path)
    """
    if path == "":
        return false
    file_create_exclusive(path, "")

fn file_write_lines(path: text, lines: [text]) -> bool:
    """Write lines to file with newlines (overwrite).

    Args:
        path: File path
        lines: Array of lines

    Returns:
        true on success, false on error
    """
    if path == "":
        return false
    file_write_text(path, lines.join("\n"))

fn file_append_lines(path: text, lines: [text]) -> bool:
    """Append lines to file.

    Args:
        path: File path
        lines: Lines to append

    Returns:
        true on success, false on error
    """
    file_append_text(path, lines.join("\n") + "\n")
