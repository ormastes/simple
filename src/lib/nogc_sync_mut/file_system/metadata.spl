# File Metadata and Information
#
# File metadata operations: size, timestamps, file info, type checks.
# Uses Option/nil pattern for operations that may fail.
# Mock implementations return simulated values.

use file_system.types.{FileInfo as FsFileInfo}
use file_system.file_ops.{file_exists as fs_file_exists}
use file_system.dir_ops.{dir_exists as fs_dir_exists}
use file_system.path_ops.{path_extension as fs_path_extension, path_basename as fs_path_basename}

# Private direct-forward leaves retain bootstrap compatibility without making
# any exported metadata API unsafe or adding intermediate allocation.
@unsafe(reason: "private bootstrap-compatible imported file predicate boundary", capabilities: [ffi])
fn _metadata_file_exists(path: text) -> bool:
    fs_file_exists(path)

@unsafe(reason: "private bootstrap-compatible imported directory predicate boundary", capabilities: [ffi])
fn _metadata_dir_exists(path: text) -> bool:
    fs_dir_exists(path)

@unsafe(reason: "private bootstrap-compatible imported extension boundary", capabilities: [ffi])
fn _metadata_path_extension(path: text) -> text:
    fs_path_extension(path)

@unsafe(reason: "private bootstrap-compatible imported basename boundary", capabilities: [ffi])
fn _metadata_path_basename(path: text) -> text:
    fs_path_basename(path)

@unsafe(reason: "private bootstrap-compatible imported metadata construction boundary", capabilities: [ffi])
fn _metadata_file_info(path: text, size: i64, modified_time: i64, is_file: bool, is_directory: bool, is_symlink: bool, permissions: i64) -> FsFileInfo:
    FsFileInfo(path: path, size: size, modified_time: modified_time, is_file: is_file, is_directory: is_directory, is_symlink: is_symlink, permissions: permissions)

fn file_size(path: text) -> i64?:
    """Get file size in bytes.

    Args:
        path: File path

    Returns:
        Some(size) or nil on error
    """
    if not _metadata_file_exists(path):
        return nil
    # Mock: return simulated size
    Some(1024)

fn file_modified_time(path: text) -> i64?:
    """Get last modified time as Unix timestamp.

    Args:
        path: File path

    Returns:
        Some(timestamp) or nil on error
    """
    if not _metadata_file_exists(path):
        return nil
    Some(1700000000)

fn file_created_time(path: text) -> i64?:
    """Get creation time as Unix timestamp.

    Args:
        path: File path

    Returns:
        Some(timestamp) or nil on error
    """
    if not _metadata_file_exists(path):
        return nil
    Some(1700000000)

fn file_accessed_time(path: text) -> i64?:
    """Get last access time as Unix timestamp.

    Args:
        path: File path

    Returns:
        Some(timestamp) or nil on error
    """
    if not _metadata_file_exists(path):
        return nil
    Some(1700000000)

fn file_info(path: text) -> FsFileInfo?:
    """Get comprehensive file information.

    Args:
        path: File path

    Returns:
        Some(FileInfo) or nil on error
    """
    if not _metadata_file_exists(path):
        return nil

    val info = _metadata_file_info(path, 1024, 1700000000, file_is_file(path), file_is_directory(path), file_is_symlink(path), 755)
    Some(info)

fn file_is_file(path: text) -> bool:
    """Check if path is a regular file.

    Args:
        path: Path

    Returns:
        true if regular file
    """
    if not _metadata_file_exists(path):
        return false
    # Mock: check if has extension
    _metadata_path_extension(path) != ""

fn file_is_directory(path: text) -> bool:
    """Check if path is a directory.

    Args:
        path: Path

    Returns:
        true if directory
    """
    _metadata_dir_exists(path)

fn file_is_symlink(path: text) -> bool:
    """Check if path is a symbolic link.

    Args:
        path: Path

    Returns:
        true if symlink
    """
    # Mock: return false
    false

fn file_is_readable(path: text) -> bool:
    """Check if file is readable.

    Args:
        path: File path

    Returns:
        true if readable
    """
    _metadata_file_exists(path)

fn file_is_writable(path: text) -> bool:
    """Check if file is writable.

    Args:
        path: File path

    Returns:
        true if writable
    """
    _metadata_file_exists(path)

fn file_is_executable(path: text) -> bool:
    """Check if file is executable.

    Args:
        path: File path

    Returns:
        true if executable
    """
    if not _metadata_file_exists(path):
        return false
    # Mock: check for common executable extensions
    val ext = _metadata_path_extension(path)
    ext == "sh" or ext == "exe" or ext == "bin"

fn file_is_hidden(path: text) -> bool:
    """Check if file is hidden (starts with dot).

    Args:
        path: File path

    Returns:
        true if hidden
    """
    val name = _metadata_path_basename(path)
    name.starts_with(".")

# ============================================================================
# Exports
# ============================================================================
