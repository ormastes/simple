"""
# Service Lease Manager — TTL-based lease allocation with ghost-lock detection
#
# Provides exclusive and shared lease semantics for serializing mutations.
# Ghost-lock reclaim: a lease whose holder PID is dead OR whose TTL has
# elapsed is reclaimed automatically.
#
# ## Why `LeaseManager` is a `class`, not a `struct`
#
# It used to be a `struct` mutated through free `fn`s (`mgr.leases.push(...)`,
# `mgr.next_id = mgr.next_id + 1`). A `struct` is a value type: it is COPIED at
# the call boundary, so those writes landed on a copy that was thrown away.
# Measured consequences before this change (bug:
# doc/08_tracking/bug/struct_dict_field_mutation_engine_divergence_2026-08-10.md):
#
#   * `next_id` never advanced — EVERY lease got the id `lease-1`, in every
#     engine (a scalar field mutation through a by-value receiver is a no-op
#     under the interpreter, the JIT and native/AOT alike).
#   * `leases` never grew under the interpreter, so `try_acquire_*` always
#     said `ok: true` and the sj daemon's BUSY / `exit_code: 75` branch was
#     UNREACHABLE — it offered no mutual exclusion while appearing to.
#
# A `class` is a reference type: it is heap-allocated and `me` methods mutate
# the same instance the caller holds, under all three engines. This is the same
# "class over struct-mutating-fn" shape already used by
# `notebook/lane_locks.spl` (`LaneLockRegistry`), whose header comment names
# this very module as the anti-pattern it deliberately avoided.
#
# This says nothing about whether a struct COPY deep-copies an embedded
# collection field — that language-design question is still open and is
# deliberately NOT settled here. A class simply removes the question from this
# module: exclusion state must be shared, so it lives behind a reference.
#
# The free-function API (`try_acquire_exclusive(mgr, ...)` etc.) is preserved
# as thin forwarders so existing call sites are unchanged.
"""

use std.io_runtime

use std.io_runtime.{time_now_unix_micros}
extern fn rt_process_exists(pid: i64) -> bool

# --- Lease Kind Constants ---

val LEASE_EXCLUSIVE: i64 = 0i64
val LEASE_SHARED: i64 = 1i64

# --- Lease Entry ---

struct LeaseEntry:
    lease_id: text
    holder_pid: i64
    kind: i64
    ttl_ms: i64
    granted_at_us: i64
    expires_at_us: i64

# --- Lease Result ---

struct LeaseResult:
    ok: bool
    lease_id: text
    busy_message: text

# --- Internal: check if lease is expired ---

fn _is_expired(entry: LeaseEntry, now_us: i64) -> bool:
    now_us >= entry.expires_at_us

# --- Internal: check if holder PID is dead ---

fn _is_holder_dead(entry: LeaseEntry) -> bool:
    not rt_process_exists(entry.holder_pid)

# --- Lease Manager ---

class LeaseManager:
    leases: [LeaseEntry]
    next_id: i64

    static fn create() -> LeaseManager:
        LeaseManager(leases: [], next_id: 1i64)

    # Allocate the next lease id. Mutating state, hence `me`: as a free `fn`
    # over a by-value struct this was a no-op and every id came back
    # `lease-1`.
    me next_lease_id() -> text:
        val id = self.next_id
        self.next_id = self.next_id + 1i64
        "lease-{id}"

    # Drop expired leases and leases whose holder process is gone.
    me reclaim_ghosts() -> [text]:
        val now_us = time_now_unix_micros()
        var reclaimed: [text] = []
        var kept: [LeaseEntry] = []
        var i = 0i64
        while i < self.leases.len():
            val entry = self.leases[i]
            if _is_expired(entry, now_us) or _is_holder_dead(entry):
                reclaimed.push(entry.lease_id)
            else:
                kept.push(entry)
            i = i + 1i64
        self.leases = kept
        reclaimed

    fn has_exclusive() -> bool:
        var i = 0i64
        while i < self.leases.len():
            if self.leases[i].kind == LEASE_EXCLUSIVE:
                return true
            i = i + 1i64
        false

    fn first_exclusive() -> LeaseEntry:
        var i = 0i64
        while i < self.leases.len():
            val entry = self.leases[i]
            if entry.kind == LEASE_EXCLUSIVE:
                return entry
            i = i + 1i64
        # Should not reach here -- caller checks has_exclusive first
        self.leases[0i64]

    me acquire_exclusive(pid: i64, ttl_ms: i64) -> LeaseResult:
        val _reclaimed = self.reclaim_ghosts()
        if self.leases.len() > 0i64:
            val blocker = self.leases[0i64]
            val b_id = blocker.lease_id
            val b_pid = blocker.holder_pid
            val b_ttl = blocker.ttl_ms
            return LeaseResult(
                ok: false,
                lease_id: "",
                busy_message: "BUSY: lease {b_id} held by pid {b_pid}, expires in {b_ttl}ms"
            )
        val now_us = time_now_unix_micros()
        val lease_id = self.next_lease_id()
        self.leases.push(LeaseEntry(
            lease_id: lease_id,
            holder_pid: pid,
            kind: LEASE_EXCLUSIVE,
            ttl_ms: ttl_ms,
            granted_at_us: now_us,
            expires_at_us: now_us + (ttl_ms * 1000i64)
        ))
        LeaseResult(ok: true, lease_id: lease_id, busy_message: "")

    me acquire_shared(pid: i64, ttl_ms: i64) -> LeaseResult:
        val _reclaimed = self.reclaim_ghosts()
        if self.has_exclusive():
            val blocker = self.first_exclusive()
            val b_id = blocker.lease_id
            val b_pid = blocker.holder_pid
            return LeaseResult(
                ok: false,
                lease_id: "",
                busy_message: "BUSY: exclusive lease {b_id} held by pid {b_pid}"
            )
        val now_us = time_now_unix_micros()
        val lease_id = self.next_lease_id()
        self.leases.push(LeaseEntry(
            lease_id: lease_id,
            holder_pid: pid,
            kind: LEASE_SHARED,
            ttl_ms: ttl_ms,
            granted_at_us: now_us,
            expires_at_us: now_us + (ttl_ms * 1000i64)
        ))
        LeaseResult(ok: true, lease_id: lease_id, busy_message: "")

    me release(lease_id: text) -> bool:
        var kept: [LeaseEntry] = []
        var found = false
        var i = 0i64
        while i < self.leases.len():
            val entry = self.leases[i]
            if entry.lease_id == lease_id:
                found = true
            else:
                kept.push(entry)
            i = i + 1i64
        self.leases = kept
        found

    me count_active() -> i64:
        val _reclaimed = self.reclaim_ghosts()
        self.leases.len()

    me exclusive_active() -> bool:
        val _reclaimed = self.reclaim_ghosts()
        self.has_exclusive()

# --- Free-function API (unchanged call shape for existing callers) ---

fn lease_manager_new() -> LeaseManager:
    LeaseManager.create()

fn try_acquire_exclusive(mgr: LeaseManager, pid: i64, ttl_ms: i64) -> LeaseResult:
    mgr.acquire_exclusive(pid, ttl_ms)

fn try_acquire_shared(mgr: LeaseManager, pid: i64, ttl_ms: i64) -> LeaseResult:
    mgr.acquire_shared(pid, ttl_ms)

fn release_lease(mgr: LeaseManager, lease_id: text) -> bool:
    mgr.release(lease_id)

fn active_lease_count(mgr: LeaseManager) -> i64:
    mgr.count_active()

fn has_active_exclusive(mgr: LeaseManager) -> bool:
    mgr.exclusive_active()
