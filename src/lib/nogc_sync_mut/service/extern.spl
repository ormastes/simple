"""
# Service Externs — UDS (Unix Domain Socket) SFFI declarations
#
# Declares the runtime externs for UDS server/client operations.
# Client-side rt_unix_socket_connect already exists in qmp_client.
# Server-side externs are new.
"""

use std.io_runtime

# --- UDS externs ---
# Client-side (already in runtime via qmp_client)
@unsafe(reason: "raw Unix-socket connect status ABI", capabilities: [ffi])
extern fn rt_unix_socket_connect(path: text) -> i64

# Server-side (new — require runtime implementation)
@unsafe(reason: "raw Unix-socket listen status ABI", capabilities: [ffi])
extern fn rt_unix_socket_listen(path: text, backlog: i32) -> i64
@unsafe(reason: "raw Unix-socket accept status ABI", capabilities: [ffi])
extern fn rt_unix_socket_accept(fd: i64) -> i64
@unsafe(reason: "raw Unix-socket send status ABI", capabilities: [ffi])
extern fn rt_unix_socket_send(fd: i64, data: text) -> i64
@unsafe(reason: "raw Unix-socket receive buffer ABI; native lane uses pointer/out-length", capabilities: [ffi])
extern fn rt_unix_socket_recv(fd: i64, max_bytes: i64) -> text
@unsafe(reason: "raw Unix-socket close errno ABI", capabilities: [ffi])
extern fn rt_unix_socket_close(fd: i64) -> i32
