"""
# Service Daemon Base — Composable daemon with PID file and UDS
#
# DaemonBase composes lifecycle (PID), lease manager,
# and audit log into a single service entry point. VCS-specific daemons
# build on top of this.
"""

use std.io_runtime
use std.service.lifecycle
use std.service.lease_manager
use std.service.audit_log

use std.io_runtime.{getpid}
use std.io_runtime.{mkdir_p}
# --- Daemon Configuration ---

struct DaemonConfig:
    pid_path: text
    socket_path: text
    max_hold_ms: i64

fn daemon_config_new(pid_path: text, socket_path: text, max_hold_ms: i64) -> DaemonConfig:
    DaemonConfig(pid_path: pid_path, socket_path: socket_path, max_hold_ms: max_hold_ms)

# --- Daemon Base ---

struct DaemonBase:
    config: DaemonConfig
    pid_state: PidFileState
    lease_mgr: LeaseManager
    audit: AuditLog
    running: bool

fn daemon_base_new(config: DaemonConfig) -> DaemonBase:
    val audit_path = _parent_dir(config.pid_path) + "/audit.log"
    DaemonBase(
        config: config,
        pid_state: PidFileState(path: config.pid_path, pid: -1i64, acquired: false),
        lease_mgr: lease_manager_new(),
        audit: audit_log_new(audit_path),
        running: false
    )

fn _parent_dir(path: text) -> text:
    val parts = path.split("/")
    if parts.len() <= 1i64:
        return "."
    var out: [text] = []
    var i = 0i64
    while i < parts.len() - 1i64:
        out.push(parts[i])
        i = i + 1i64
    out.join("/")

# --- Start / Stop ---

struct DaemonBaseStartV1:
    base: DaemonBase
    started: bool

# Struct state is returned explicitly; callers must assign result.base.
fn daemon_base_start_owned(base: DaemonBase) -> DaemonBaseStartV1:
    val sj_dir = _parent_dir(base.config.pid_path)
    mkdir_p(sj_dir)

    val pid_state = acquire_pid_file(base.config.pid_path)
    if not pid_state.acquired:
        return DaemonBaseStartV1(base, false)
    var owned = base
    owned.pid_state = pid_state
    owned.running = true
    audit_daemon_start(owned.audit, pid_state.pid)
    DaemonBaseStartV1(owned, true)

fn daemon_base_stop_owned(base: DaemonBase) -> DaemonBase:
    var owned = base
    if owned.pid_state.acquired:
        # The legacy release primitive does not compare PID ownership. Never
        # delete a replacement owner's file based solely on our old receipt.
        if read_pid_file(owned.pid_state.path) == owned.pid_state.pid:
            release_pid_file(owned.pid_state)
            # Keep the receipt on failed removal so the caller can retry.
            if file_exists(owned.pid_state.path) and
                    read_pid_file(owned.pid_state.path) == owned.pid_state.pid:
                return owned
    if owned.running:
        audit_daemon_stop(owned.audit, owned.pid_state.pid)
    owned.running = false
    owned.pid_state = PidFileState(owned.config.pid_path, -1i64, false)
    owned

# Compatibility signatures retain their historical by-value semantics.
# New stateful owners must use the owned variants and write back the result.
fn daemon_base_start(base: DaemonBase) -> bool:
    daemon_base_start_owned(base).started

fn daemon_base_stop(base: DaemonBase):
    val stopped = daemon_base_stop_owned(base)

fn daemon_base_is_running(base: DaemonBase) -> bool:
    base.running
