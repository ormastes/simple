"""
# Service Audit Log — Append-only structured log
#
# Records lease grants, releases, reclaims, and command executions
# to a per-repo audit log file.
"""

use std.io_runtime

use std.io_runtime.{time_now_unix_micros}
use std.io_runtime.{read_file_text}
use std.io_runtime.{file_write}
extern fn rt_mkdir_p(path: text) -> bool
# Real stderr, direct. The `eprint` reroute that originally forced this
# (eprint rebound to `print "[STDERR] ..."` for importers of std.io_runtime) is
# FIXED -- see process_ops.spl and
# doc/08_tracking/bug/eprint_in_io_runtime_module_is_rerouted_to_stdout_2026-08-10.md.
# This call is kept deliberately, not as leftover workaround: an audit-trail
# failure is the one diagnostic that must not depend on cross-module name
# shadowing resolving the way we expect. Direct fd 2, no indirection.
extern fn rt_stderr_write(msg: text)

struct AuditLog:
    path: text

fn audit_log_new(path: text) -> AuditLog:
    AuditLog(path: path)

fn _parent_dir(path: text) -> text:
    val parts = path.split("/")
    if parts.len() <= 1i64:
        return "."
    var out: [text] = []
    var i = 0i64
    while i < parts.len() - 1i64:
        out.push(parts[i])
        i = i + 1i64
    out.join("/")

# Append one record. Returns whether the record actually reached the log.
#
# Both halves of this used to fail silently: rt_file_write_text's -> bool result
# was discarded, and there was no stderr path at all, so an audit write that
# failed -- an unwritable directory, a full disk, a permissions change -- left no
# trace anywhere. An audit trail that loses records without saying so is worse
# than no audit trail, because it still looks authoritative.
#
# A failed write is reported on stderr and to the caller. `-> bool` is additive:
# callers that ignore it are unaffected, but they can no longer do so
# *unknowingly*.
#
# doc/08_tracking/bug/logging_surfaces_that_suppress_errors_by_default_family_2026-08-10.md (OPEN 3)
fn audit_append(log: AuditLog, event: text, detail: text) -> bool:
    val parent = _parent_dir(log.path)
    if not rt_mkdir_p(parent):
        rt_stderr_write("[ERROR] [audit_log] cannot create audit directory '{parent}' for '{log.path}' -- audit record {event} was NOT written\n")
        return false
    val ts = time_now_unix_micros()
    val line = "{ts}\t{event}\t{detail}\n"
    val existing = read_file_text(log.path)
    var ok = false
    if existing.len() > 0i64:
        ok = file_write(log.path, existing + line)
    else:
        ok = file_write(log.path, line)
    if not ok:
        rt_stderr_write("[ERROR] [audit_log] failed to write audit record {event} to '{log.path}' -- the audit trail is INCOMPLETE\n")
    ok

fn audit_lease_granted(log: AuditLog, lease_id: text, pid: i64, kind: text) -> bool:
    audit_append(log, "LEASE_GRANTED", "id={lease_id} pid={pid} kind={kind}")

fn audit_lease_released(log: AuditLog, lease_id: text) -> bool:
    audit_append(log, "LEASE_RELEASED", "id={lease_id}")

fn audit_lease_reclaimed(log: AuditLog, lease_id: text, reason: text) -> bool:
    audit_append(log, "LEASE_RECLAIMED", "id={lease_id} reason={reason}")

fn audit_command(log: AuditLog, lease_id: text, command: text, exit_code: i64) -> bool:
    audit_append(log, "COMMAND", "lease={lease_id} cmd={command} exit={exit_code}")

fn audit_daemon_start(log: AuditLog, pid: i64) -> bool:
    audit_append(log, "DAEMON_START", "pid={pid}")

fn audit_daemon_stop(log: AuditLog, pid: i64) -> bool:
    audit_append(log, "DAEMON_STOP", "pid={pid}")
