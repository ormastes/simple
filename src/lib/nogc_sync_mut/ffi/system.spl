"""
# Legacy FFI system compatibility facade

The canonical environment, process, and time foreign boundary is
`std.nogc_sync_mut.sffi.system`. Re-export its checked wrappers so this legacy
module adds no duplicate extern declarations, runtime dispatch, or allocation.
"""

export use std.nogc_sync_mut.sffi.system.{
    env_cwd, cwd, env_home, home, env_get, env_set, env_remove, env_vars,
    args_get, args,
    process_run, process_run_timeout, process_run_with_limits,
    process_run_with_all_limits, execute_native, process_output, process_spawn,
    process_wait, process_kill,
    getpid, hostname, cpu_count, get_host_target_code, uuid_v4,
    shell, shell_output, exec,
    time_now, time_now_unix_micros, time_now_unix_millis, time_now_iso,
    time_millis, time_year, time_month, time_day, time_hour, time_minute,
    time_second, timestamp_to_string, timestamp_to_iso, timestamp_from_iso,
    timestamp_parse, timestamp_diff_seconds, sleep_ms, sleep_secs
}
