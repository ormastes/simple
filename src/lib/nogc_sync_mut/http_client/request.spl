# HTTP Request Building Functions

use types.{METHOD_GET, METHOD_POST, METHOD_PUT, METHOD_DELETE}
use std.nogc_sync_mut.io.http_sffi.{http_request_raw}

fn create_headers() -> list:
    []

fn add_header(headers: list, name: text, value: text) -> list:
    var new_headers = []
    var i = 0
    while i < headers.length():
        new_headers.append(headers[i])
        i = i + 1
    new_headers.append((name, value))
    new_headers

fn get_header(headers: list, name: text) -> text?:
    var name_lower = name.lower()
    var i = 0
    while i < headers.length():
        var header = headers[i]
        var header_name = header.0
        if header_name.lower() == name_lower:
            return header.1
        i = i + 1
    nil

fn has_header(headers: list, name: text) -> bool:
    var value = get_header(headers, name)
    value != nil

fn remove_header(headers: list, name: text) -> list:
    var name_lower = name.lower()
    var new_headers = []
    var i = 0
    while i < headers.length():
        var header = headers[i]
        var header_name = header.0
        if header_name.lower() != name_lower:
            new_headers.append(header)
        i = i + 1
    new_headers

fn set_header(headers: list, name: text, value: text) -> list:
    var removed = remove_header(headers, name)
    add_header(removed, name, value)

fn create_request(method: text, url: text) -> (text, text, list, text):
    var headers = create_headers()
    var body = ""
    (method, url, headers, body)

fn request_add_header(request: (text, text, list, text), name: text, value: text) -> (text, text, list, text):
    var method = request.0
    var url = request.1
    var headers = request.2
    var body = request.3
    var new_headers = add_header(headers, name, value)
    (method, url, new_headers, body)

fn request_set_body(request: (text, text, list, text), body: text) -> (text, text, list, text):
    var method = request.0
    var url = request.1
    var headers = request.2
    (method, url, headers, body)

fn http_get(url: text) -> (text, text, list, text):
    create_request(method: METHOD_GET, url: url)

fn http_post(url: text, body: text) -> (text, text, list, text):
    var req = create_request(method: METHOD_POST, url: url)
    request_set_body(request: req, body: body)

fn http_put(url: text, body: text) -> (text, text, list, text):
    var req = create_request(method: METHOD_PUT, url: url)
    request_set_body(request: req, body: body)

fn http_delete(url: text) -> (text, text, list, text):
    create_request(method: METHOD_DELETE, url: url)

fn send_request(request: (text, text, list, text)) -> (i64, text, list, text):
    """Send a built request over the runtime transport.
    Returns (status, status_text, headers, body). A transport failure is
    status -1 with the runtime error in status_text — never a fake success
    (e.g. the Windows core runtime has no native HTTP and reports that)."""
    var header_lines = ""
    val headers = request.2
    var i = 0
    while i < headers.length():
        val header = headers[i]
        if i > 0:
            header_lines = header_lines + "\n"
        header_lines = header_lines + "{header.0}: {header.1}"
        i = i + 1
    val raw = http_request_raw(request.0, request.1, header_lines, request.3)
    if raw.0 < 0:
        return (-1, raw.2, [], "")
    (raw.0, raw.2, [], raw.1)
