# HTTP Response Handling Functions

import types
use std.nogc_sync_mut.http_client.request.{get_header}

# reason: pre-existing HTTP status code/predicate helper on flat HTTP response tuple API
# @allow(primitive_api)
pub fn create_response(status_code: i64, status_text: text, headers: list, body: text) -> (i64, text, list, text):
    (status_code, status_text, headers, body)

# reason: pre-existing HTTP status code accessor on flat HTTP response tuple API
# @allow(primitive_api)
pub fn response_get_status_code(response: (i64, text, list, text)) -> i64:
    response.0

pub fn response_get_status_text(response: (i64, text, list, text)) -> text:
    response.1

pub fn response_get_headers(response: (i64, text, list, text)) -> list:
    response.2

pub fn response_get_body(response: (i64, text, list, text)) -> text:
    response.3

pub fn response_get_header(response: (i64, text, list, text), name: text) -> text?:
    var headers = response_get_headers(response)
    get_header(headers, name)

# reason: pre-existing HTTP status code/predicate helper on flat HTTP response tuple API
# @allow(primitive_api)
pub fn response_is_success(response: (i64, text, list, text)) -> bool:
    var code = response_get_status_code(response)
    code >= 200 and code < 300

# reason: pre-existing HTTP status code/predicate helper on flat HTTP response tuple API
# @allow(primitive_api)
pub fn response_is_redirect(response: (i64, text, list, text)) -> bool:
    var code = response_get_status_code(response)
    code >= 300 and code < 400

# reason: pre-existing HTTP status code/predicate helper on flat HTTP response tuple API
# @allow(primitive_api)
pub fn response_is_client_error(response: (i64, text, list, text)) -> bool:
    var code = response_get_status_code(response)
    code >= 400 and code < 500

# reason: pre-existing HTTP status code/predicate helper on flat HTTP response tuple API
# @allow(primitive_api)
pub fn response_is_server_error(response: (i64, text, list, text)) -> bool:
    var code = response_get_status_code(response)
    code >= 500 and code < 600

# reason: pre-existing HTTP status code/predicate helper on flat HTTP response tuple API
# @allow(primitive_api)
pub fn status_code_to_text(code: i64) -> text:
    if code == 200:
        return "OK"
    if code == 201:
        return "Created"
    if code == 400:
        return "Bad Request"
    if code == 404:
        return "Not Found"
    if code == 500:
        return "Internal Server Error"
    "Unknown"
