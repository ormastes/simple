# IMAP Response Parser
# RFC 3501 — line-based framing, no cursor-by-value (known bug avoidance)

use std.nogc_sync_mut.imap.types.{
    ImapTaggedResponse, ImapUntaggedResponse,
    IMAP_STATUS_OK, IMAP_STATUS_NO, IMAP_STATUS_BAD,
    imap_tagged_response, imap_untagged_response
}

# =============================================================================
# Helpers
# =============================================================================

# Split a line at first space; returns [prefix, rest] or [line] if no space.
# Uses offset loop to avoid cursor-by-value bug.
fn imap_split_at_first_space(line: text) -> [text]:
    val len = line.length()
    var i = 0
    var found = false
    var pos = 0
    while i < len and not found:
        val ch = line.substring(i, i + 1)
        if ch == " ":
            found = true
            pos = i
        i = i + 1
    if not found:
        return [line]
    val left = line.substring(0, pos)
    val right = line.substring(pos + 1, len)
    return [left, right]

fn imap_parse_status_word(word: text) -> i64:
    if word == "OK":
        return IMAP_STATUS_OK
    if word == "NO":
        return IMAP_STATUS_NO
    if word == "BAD":
        return IMAP_STATUS_BAD
    return IMAP_STATUS_BAD

# =============================================================================
# Parse a single IMAP response line.
#
# Tagged:   "A1 OK Logged in\r\n"  -> ImapTaggedResponse
# Untagged: "* 3 EXISTS\r\n"       -> ImapUntaggedResponse
#
# Returns the tagged response; use imap_line_is_tagged to distinguish.
# =============================================================================

fn imap_line_is_tagged(line: text) -> bool:
    val len = line.length()
    if len == 0:
        return false
    val first = line.char_at(0)
    # Untagged lines start with '*' or '+' (continuation)
    if first == "*":
        return false
    if first == "+":
        return false
    return true

fn imap_line_is_continuation(line: text) -> bool:
    val len = line.length()
    if len == 0:
        return false
    return line.char_at(0) == "+"

# Strip trailing CRLF from a line
fn imap_strip_crlf(line: text) -> text:
    val len = line.length()
    if len >= 2:
        val last1 = line.substring(len - 1, len)
        val last2 = line.substring(len - 2, len - 1)
        if last2 == "\r" and last1 == "\n":
            return line.substring(0, len - 2)
    if len >= 1 and line.substring(len - 1, len) == "\n":
        return line.substring(0, len - 1)
    return line

fn imap_parse_tagged_response(line: text) -> ImapTaggedResponse:
    val stripped = imap_strip_crlf(line)
    # Format: "<tag> <STATUS> <message...>"
    val parts1 = imap_split_at_first_space(stripped)
    if parts1.len() < 2:
        return imap_tagged_response(stripped, IMAP_STATUS_BAD, "")
    val tag = parts1[0]
    val rest = parts1[1]
    val parts2 = imap_split_at_first_space(rest)
    if parts2.len() < 2:
        val status = imap_parse_status_word(rest)
        return imap_tagged_response(tag, status, "")
    val status_word = parts2[0]
    val message = parts2[1]
    val status = imap_parse_status_word(status_word)
    return imap_tagged_response(tag, status, message)

fn imap_parse_untagged_response(line: text) -> ImapUntaggedResponse:
    val stripped = imap_strip_crlf(line)
    # Strip leading "* "
    val len = stripped.length()
    if len >= 2 and stripped.char_at(0) == "*" and stripped.char_at(1) == " ":
        val data = stripped.substring(2, len)
        return imap_untagged_response(data)
    return imap_untagged_response(stripped)

# Parse a CAPABILITY response data line (untagged data portion)
# e.g. "CAPABILITY IMAP4rev1 STARTTLS AUTH=PLAIN"
# Returns list of capability tokens
fn imap_parse_capability_tokens(data: text) -> [text]:
    val len = data.length()
    var tokens: [text] = []
    var start = 0
    var i = 0
    while i <= len:
        var is_sep = false
        if i == len:
            is_sep = true
        else:
            val ch = data.substring(i, i + 1)
            if ch == " ":
                is_sep = true
        if is_sep and i > start:
            val tok = data.substring(start, i)
            tokens.push(tok)
            start = i + 1
        i = i + 1
    return tokens

# =============================================================================
# RFC 3501 FETCH response parsing (literal-aware, byte-indexed)
#
# All scanning below uses `.length()` / `.substring()` / `.index_of()`, which
# are BYTE-indexed, so a `{N}` literal count consumes exactly N bytes even
# when the body carries multibyte UTF-8 (see parse_multibyte_spec.spl for why
# `.char_at` must not be mixed in).
# =============================================================================

struct ImapFetchItem:
    name: text      # "UID", "FLAGS", "RFC822.SIZE", "BODY[HEADER.FIELDS (SUBJECT FROM DATE)]", "BODY[]"
    value: text     # atom text, "(...)" group text verbatim, quoted-string content, or literal bytes

struct ImapFetchMessage:
    seq: i64
    items: [ImapFetchItem]

struct ImapFetchResult:
    messages: [ImapFetchMessage]
    others: [text]        # untagged non-FETCH data lines (after "* "), plus "+ " continuations
    tag_seen: bool
    tag_status: i64
    tag_message: text
    error: text           # "" when the response parsed cleanly

fn _imap_line_end(buf: text, pos: i64) -> i64:
    # byte index of the first "\n" at or after pos, or -1
    val rel = buf.substring(pos, buf.length()).index_of("\n")
    if rel < 0:
        return -1
    pos + rel

fn _imap_strip_cr(line: text) -> text:
    val n = line.length()
    if n >= 1 and line.substring(n - 1, n) == "\r":
        return line.substring(0, n - 1)
    line

# If `line` ends with "{N}" returns N, else -1.
fn imap_literal_size(line: text) -> i64:
    val n = line.length()
    if n < 3 or line.substring(n - 1, n) != "}":
        return -1
    var i = n - 2
    var digits = ""
    while i >= 0:
        val ch = line.substring(i, i + 1)
        if ch == "{":
            if digits == "":
                return -1
            return digits.to_i64() ?? -1
        if ch < "0" or ch > "9":
            return -1
        digits = ch + digits
        i = i - 1
    -1

# Framer shared by every transport: returns the number of bytes of `buf`
# that make up one complete response ending with the `tag` line (CRLF
# included), or -1 while more bytes are needed. A `{N}` literal is skipped by
# byte count, so a tag-looking line INSIDE a message body can never terminate
# the response early. `tag` "*" accepts any untagged line as final (greeting).
fn imap_response_complete(buf: text, tag: text) -> i64:
    var pos = 0
    var logical_start = true
    val total = buf.length()
    while pos < total:
        val nl = _imap_line_end(buf, pos)
        if nl < 0:
            return -1
        val line = _imap_strip_cr(buf.substring(pos, nl))
        val lit = imap_literal_size(line)
        if lit >= 0:
            if nl + 1 + lit > total:
                return -1
            pos = nl + 1 + lit
            logical_start = false
            continue
        if logical_start:
            if tag == "*":
                if line.starts_with("* "):
                    return nl + 1
            elif line.starts_with(tag + " "):
                return nl + 1
        pos = nl + 1
        logical_start = true
    -1

fn _imap_is_ws(ch: text) -> bool:
    ch == " " or ch == "\r" or ch == "\n"

# Reads one FETCH item name starting at pos: an atom that may carry a
# bracketed section with spaces inside ("BODY[HEADER.FIELDS (A B)]<0.10>").
fn _imap_read_item_name(buf: text, start: i64) -> (text, i64):
    var pos = start
    var depth = 0
    val total = buf.length()
    while pos < total:
        val ch = buf.substring(pos, pos + 1)
        if ch == "[":
            depth = depth + 1
        elif ch == "]":
            depth = depth - 1
        elif depth == 0 and (ch == " " or ch == ")" or ch == "\r" or ch == "\n"):
            break
        pos = pos + 1
    (buf.substring(start, pos), pos)

# Reads one FETCH item value at pos. Returns (value, next_pos, error).
fn _imap_read_item_value(buf: text, start: i64) -> (text, i64, text):
    val total = buf.length()
    if start >= total:
        return ("", start, "unexpected end of FETCH data")
    val first = buf.substring(start, start + 1)
    if first == "{":
        val close = _imap_line_end(buf, start)
        if close < 0:
            return ("", start, "unterminated literal header")
        val header = _imap_strip_cr(buf.substring(start, close))
        val n = imap_literal_size(header)
        if n < 0:
            return ("", start, "malformed literal header '" + header + "'")
        val body_start = close + 1
        if body_start + n > total:
            return ("", start, "literal truncated: need " + n.to_text() + " bytes")
        return (buf.substring(body_start, body_start + n), body_start + n, "")
    if first == "\"":
        var pos = start + 1
        var out = ""
        while pos < total:
            val ch = buf.substring(pos, pos + 1)
            if ch == "\\" and pos + 1 < total:
                out = out + buf.substring(pos + 1, pos + 2)
                pos = pos + 2
                continue
            if ch == "\"":
                return (out, pos + 1, "")
            out = out + ch
            pos = pos + 1
        return ("", start, "unterminated quoted string")
    if first == "(":
        var pos = start
        var depth = 0
        while pos < total:
            val ch = buf.substring(pos, pos + 1)
            if ch == "(":
                depth = depth + 1
            elif ch == ")":
                depth = depth - 1
                if depth == 0:
                    return (buf.substring(start, pos + 1), pos + 1, "")
            pos = pos + 1
        return ("", start, "unbalanced parenthesized list")
    var pos = start
    while pos < total:
        val ch = buf.substring(pos, pos + 1)
        if _imap_is_ws(ch) or ch == ")":
            break
        pos = pos + 1
    (buf.substring(start, pos), pos, "")

# Parses "(ITEM value ITEM value ...)" starting at the "(" at pos.
# Returns (items, next_pos, error); next_pos is just past the closing ")".
fn _imap_parse_fetch_items(buf: text, start: i64) -> ([ImapFetchItem], i64, text):
    var items: [ImapFetchItem] = []
    val total = buf.length()
    if start >= total or buf.substring(start, start + 1) != "(":
        return (items, start, "FETCH data does not start with '('")
    var pos = start + 1
    while pos < total:
        while pos < total and _imap_is_ws(buf.substring(pos, pos + 1)):
            pos = pos + 1
        if pos >= total:
            return (items, pos, "unterminated FETCH item list")
        if buf.substring(pos, pos + 1) == ")":
            return (items, pos + 1, "")
        val (name, after_name) = _imap_read_item_name(buf, pos)
        if name == "":
            return (items, pos, "empty FETCH item name")
        pos = after_name
        while pos < total and buf.substring(pos, pos + 1) == " ":
            pos = pos + 1
        val (value, after_value, err) = _imap_read_item_value(buf, pos)
        if err != "":
            return (items, pos, err)
        items.push(ImapFetchItem(name: name, value: value))
        pos = after_value
    (items, pos, "unterminated FETCH item list")

fn _imap_fetch_seq(line: text) -> i64:
    # "* 12 FETCH (" -> 12, else -1
    if not line.starts_with("* "):
        return -1
    val parts = imap_split_at_first_space(line.substring(2, line.length()))
    if parts.len() < 2:
        return -1
    if not parts[1].starts_with("FETCH "):
        return -1
    parts[0].to_i64() ?? -1

# Parses one complete IMAP response (as framed by imap_response_complete)
# into FETCH messages, other untagged lines and the tagged terminator.
fn imap_parse_fetch_response(raw: text, tag: text) -> ImapFetchResult:
    var messages: [ImapFetchMessage] = []
    var others: [text] = []
    var pos = 0
    val total = raw.length()
    while pos < total:
        val nl = _imap_line_end(raw, pos)
        var line_end = nl
        if nl < 0:
            line_end = total
        val line = _imap_strip_cr(raw.substring(pos, line_end))
        val seq = _imap_fetch_seq(line)
        if seq >= 0:
            val paren = pos + line.index_of("(")
            val (items, after, err) = _imap_parse_fetch_items(raw, paren)
            if err != "":
                return ImapFetchResult(messages: messages, others: others, tag_seen: false, tag_status: IMAP_STATUS_BAD, tag_message: "", error: "FETCH " + seq.to_text() + ": " + err)
            messages.push(ImapFetchMessage(seq: seq, items: items))
            # skip the CRLF that closes the FETCH line
            val tail = _imap_line_end(raw, after)
            if tail < 0:
                pos = total
            else:
                pos = tail + 1
            continue
        if line.starts_with("* ") or line.starts_with("+"):
            var data = line
            if line.starts_with("* "):
                data = line.substring(2, line.length())
            var next = line_end + 1
            val lit = imap_literal_size(line)
            if lit >= 0 and next + lit <= total:
                data = data + "\r\n" + raw.substring(next, next + lit)
                val tail = _imap_line_end(raw, next + lit)
                if tail < 0:
                    next = total
                else:
                    next = tail + 1
            others.push(data)
            pos = next
            continue
        if line == "":
            pos = line_end + 1
            continue
        val tagged = imap_parse_tagged_response(line)
        if tagged.tag != tag:
            return ImapFetchResult(messages: messages, others: others, tag_seen: false, tag_status: IMAP_STATUS_BAD, tag_message: tagged.message, error: "unexpected tag '" + tagged.tag + "' (waiting for '" + tag + "')")
        return ImapFetchResult(messages: messages, others: others, tag_seen: true, tag_status: tagged.status, tag_message: tagged.message, error: "")
    ImapFetchResult(messages: messages, others: others, tag_seen: false, tag_status: IMAP_STATUS_BAD, tag_message: "", error: "response ended before tag '" + tag + "'")

# Case-insensitive item lookup ("" when absent).
fn imap_fetch_item(msg: ImapFetchMessage, name: text) -> text:
    val want = name.to_upper()
    for it in msg.items:
        if it.name.to_upper() == want:
            return it.value
    ""

# First item whose name starts with `prefix` (e.g. "BODY[HEADER"), "" when absent.
fn imap_fetch_item_prefixed(msg: ImapFetchMessage, prefix: text) -> text:
    val want = prefix.to_upper()
    for it in msg.items:
        if it.name.to_upper().starts_with(want):
            return it.value
    ""

fn imap_fetch_uid(msg: ImapFetchMessage) -> text:
    imap_fetch_item(msg, "UID")

fn imap_fetch_size(msg: ImapFetchMessage) -> i64:
    imap_fetch_item(msg, "RFC822.SIZE").to_i64() ?? -1

fn imap_fetch_flags(msg: ImapFetchMessage) -> [text]:
    val raw = imap_fetch_item(msg, "FLAGS")
    val n = raw.length()
    if n < 2:
        return []
    imap_parse_capability_tokens(raw.substring(1, n - 1))

# RFC 5322 header block -> (name, value) pairs with folded continuation lines
# joined by a single space. Stops at the first empty line.
fn imap_parse_header_fields(block: text) -> [ImapFetchItem]:
    var out: [ImapFetchItem] = []
    var name = ""
    var value = ""
    for raw_line in block.split("\n"):
        val line = _imap_strip_cr(raw_line)
        if line == "":
            if name != "":
                out.push(ImapFetchItem(name: name, value: value))
                name = ""
            break
        val c0 = line.substring(0, 1)
        if (c0 == " " or c0 == "\t") and name != "":
            value = value + " " + line.trim()
            continue
        if name != "":
            out.push(ImapFetchItem(name: name, value: value))
            name = ""
            value = ""
        val colon = line.index_of(":")
        if colon <= 0:
            continue
        name = line.substring(0, colon)
        value = line.substring(colon + 1, line.length()).trim()
    if name != "":
        out.push(ImapFetchItem(name: name, value: value))
    out

fn imap_header_value(fields: [ImapFetchItem], name: text) -> text:
    val want = name.to_upper()
    for f in fields:
        if f.name.to_upper() == want:
            return f.value
    ""

export ImapFetchItem, ImapFetchMessage, ImapFetchResult
export imap_literal_size, imap_response_complete, imap_parse_fetch_response
export imap_fetch_item, imap_fetch_item_prefixed, imap_fetch_uid, imap_fetch_size, imap_fetch_flags
export imap_parse_header_fields, imap_header_value
