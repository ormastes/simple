# std.game2d.backend.web_canvas — game2d frames through the web draw path.
#
# Routes a game2d pixel-buffer frame into the browser_engine/Engine2D Draw IR
# lane: each presented frame becomes ONE Draw IR `image` command whose pixels
# are supplied through the resolved-image resource path
# (`Engine2dResolvedDrawIrImage`) — the same embedded-surface/image mechanism
# the web renderer uses — and is executed by
# `engine2d_draw_ir_adv_composition_with_images` on the software Engine2D
# backend, returning a framebuffer readback as presentation evidence.
#
# Command-buffer rendering (`gb_execute_commands`) composes a
# `HeadlessBackend` rasterizer; `gb_end_frame` presents the rasterized
# framebuffer through the web draw path. Frame-hash evidence mirrors the
# headless backend: `frame_hash()` is FNV-1a over the PRESENTED (read-back)
# pixel words, `submitted_hash()` over the submitted buffer, so byte parity
# through the pipeline is directly checkable.

use std.common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config,
    draw_ir_image_command
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_with_images
}
use std.nogc_sync_mut.engine.render.command.{RenderCommandBuffer}
use std.nogc_sync_mut.game2d.backend.trait.{GameBackend, WindowConfig, Window, Event}
use std.nogc_sync_mut.game2d.backend.headless.{HeadlessBackend}
use std.nogc_sync_mut.game2d.backend.frame_hash.{frame_hash}
use std.nogc_sync_mut.game2d.render.canvas.{Canvas}
use std.nogc_sync_mut.game2d.render.image.{Image, RenderError}
use std.nogc_sync_mut.game2d.audio.{Sound, AudioError}
use std.nogc_sync_mut.game2d.input.snapshot.{InputSnapshot}


class WebCanvasBackend:
    raster: HeadlessBackend
    engine: Engine2D
    width: i64
    height: i64
    presented: [i64]
    frames_presented: i64
    last_render_ok: bool

    static fn create(width: i64, height: i64) -> WebCanvasBackend:
        val n = width * height
        val presented: [i64] = [0; n]
        WebCanvasBackend(
            raster: HeadlessBackend.create(width, height),
            engine: Engine2D.create_with_backend(width as i32, height as i32, "software"),
            width: width,
            height: height,
            presented: presented,
            frames_presented: 0,
            last_render_ok: false
        )

    me present_frame(self, fb: [i64]) -> bool:
        """Present one pixel-buffer frame through the web Draw IR path.

        The frame is registered as a resolved Draw IR image resource and drawn
        by a single full-frame `image` command; the returned readback becomes
        the presented buffer. Returns true only when the Draw IR walker
        rendered the command (nothing skipped) and the readback is full-size.
        """
        if (fb.len() as i64) != self.width * self.height:
            self.last_render_ok = false
            return false
        val n = fb.len()
        val px: [u32] = [0; n]
        var i: i64 = 0
        while i < n:
            px[i] = fb[i] as u32
            i = i + 1
        val img = Engine2dResolvedDrawIrImage(
            image_uri: "game2d://frame",
            width: self.width as i32,
            height: self.height as i32,
            pixels: px,
            opaque: true
        )
        val cmd = draw_ir_image_command(
            "game2d-frame", 0, 0, self.width as i32, self.height as i32,
            "game2d://frame", [])
        val embedding = draw_ir_embedding_config(
            "game2d-surface", "game2d-frame", 0, 0,
            self.width as i32, self.height as i32, 0, 1000, false)
        val batch = draw_ir_batch("game2d-web", DRAW_IR_BACKEND_CPU, embedding, [cmd])
        val comp = draw_ir_composition(
            "game2d-web-canvas", "game2d-frame-{self.frames_presented}",
            DRAW_IR_BACKEND_CPU, [batch])
        val result = engine2d_draw_ir_adv_composition_with_images(
            self.engine, comp, false, [img])
        self.frames_presented = self.frames_presented + 1
        val out = result.pixels
        if (out.len() as i64) != self.width * self.height:
            self.last_render_ok = false
            return false
        var j: i64 = 0
        val m = out.len()
        while j < m:
            self.presented[j] = out[j] as i64
            j = j + 1
        self.last_render_ok =
            result.rendered_command_count > 0 and result.skipped_command_count == 0
        self.last_render_ok

    fn frame_hash(self) -> i64:
        """FNV-1a hash over the PRESENTED (read-back) pixel words."""
        frame_hash(self.presented)

    fn presented_pixels(self) -> [i64]:
        self.presented


# GameBackend surface implementation — composition only.
impl WebCanvasBackend:
    me gb_create_window(self, cfg: WindowConfig) -> Window:
        Window(raw: 0, width: cfg.width, height: cfg.height)

    fn poll_native_events(self, events_out: [Event]) -> i64:
        val _ = events_out
        0  # web canvas lane produces no native events here

    fn gb_begin_frame(self) -> Canvas:
        Canvas.create(self.width, self.height)

    fn gb_end_frame(self):
        self.present_frame(self.raster.fb)

    me gb_execute_commands(self, cmds: RenderCommandBuffer):
        self.raster.gb_execute_commands(cmds)

    fn gb_load_image(self, path: text) -> Result<Image, RenderError>:
        Image.new(path)

    fn gb_load_sound(self, path: text) -> Result<Sound, AudioError>:
        Sound.new(path)

    me gb_shutdown(self):
        pass_do_nothing

    fn gb_current_input(self) -> InputSnapshot:
        self.raster.last_input
