# Hosted, pure-Simple owner for live measurement observations.
#
# The runtime provides only narrow physical facts. This module validates the
# exact clock identity, mints a per-run CSPRNG nonce, and constructs the neutral
# observation contract consumed by qualification and performance attestation.

use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.nogc_sync_mut.crypto.entropy_platform.{entropy_platform_bytes}
use std.nogc_sync_mut.io.env_ops.{host_arch, host_os}
use std.nogc_sync_mut.io.time_ops.{monotonic_clock_identity}
use std.nogc_sync_mut.io.sysinfo_ops.{
    current_executable_path, process_peak_rss_kb}
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}
use lib.common.platform_measurement_observation.{
    PLATFORM_MEASUREMENT_OBSERVATION_SCHEMA,
    PlatformMeasurementObservation,
    PlatformPeakMemoryMetric,
    platform_measurement_observation_reason,
    platform_measurement_observation_sha256}

val PLATFORM_MEASUREMENT_CLOCK_IDENTITY_SCHEMA: text =
    "monotonic-clock-v1"

fn _observer_identity_value(part: text, prefix: text) -> text:
    if not part.starts_with(prefix): return ""
    val value = part.substring(prefix.len())
    if value == "" or value != value.trim(): return ""
    value

fn platform_measurement_clock_identity_parts(
        identity: text) -> Result<(text, text, text), text>:
    val parts = identity.split("|")
    if parts.len() != 4 or
            parts[0] != PLATFORM_MEASUREMENT_CLOCK_IDENTITY_SCHEMA:
        return Err("monotonic clock identity schema is invalid")
    val source = _observer_identity_value(parts[1], "source=")
    val epoch = _observer_identity_value(parts[2], "epoch=")
    val lane = _observer_identity_value(parts[3], "lane=")
    if source == "" or epoch == "" or lane == "":
        return Err("monotonic clock identity fields are invalid")
    Ok((source, epoch, lane))

fn _observer_wipe(bytes: [u8]):
    var index: u64 = 0u64
    while index < bytes.len():
        bytes[index] = 0u8
        index = index + 1u64

fn platform_measurement_observe_process_rss(
        ) -> Result<PlatformMeasurementObservation, text>:
    val executable_path = current_executable_path()
    if executable_path == "":
        return Err("current executable path is unavailable")
    val observer_artifact_sha256 = file_hash_sha256(executable_path)
    if not sha256_lower_hex_valid(observer_artifact_sha256):
        return Err("current executable SHA-256 is unavailable")

    val clock = monotonic_clock_identity()
    val clock_parts = platform_measurement_clock_identity_parts(clock)
    if clock_parts.is_err(): return Err(clock_parts.unwrap_err())
    val (clock_source, clock_epoch, runtime_lane) = clock_parts.unwrap()

    val peak_memory_kib = process_peak_rss_kb()
    if peak_memory_kib <= 0:
        return Err("process peak resident set size is unavailable")

    val entropy = entropy_platform_bytes(32u64)
    if entropy.is_err(): return Err(entropy.unwrap_err())
    val nonce = entropy.unwrap()
    val session_nonce_sha256 = sha256_u8_hex(nonce)
    _observer_wipe(nonce)
    if not sha256_lower_hex_valid(session_nonce_sha256):
        return Err("session nonce digest is invalid")

    var observation = PlatformMeasurementObservation(
        schema: PLATFORM_MEASUREMENT_OBSERVATION_SCHEMA,
        observation_sha256: "",
        host_os: host_os(),
        host_arch: host_arch(),
        runtime_lane: runtime_lane,
        clock_source: clock_source,
        clock_epoch_semantics: clock_epoch,
        session_nonce_sha256: session_nonce_sha256,
        observer_artifact_sha256: observer_artifact_sha256,
        peak_memory_metric: PlatformPeakMemoryMetric.PeakResidentSetKiB,
        peak_memory_kib: peak_memory_kib)
    observation.observation_sha256 =
        platform_measurement_observation_sha256(observation)
    val reason = platform_measurement_observation_reason(observation)
    if reason != "ready":
        return Err("platform measurement observation is invalid: " + reason)
    Ok(observation)

fn platform_measurement_refresh_process_rss(
        previous: PlatformMeasurementObservation
        ) -> Result<PlatformMeasurementObservation, text>:
    val previous_reason = platform_measurement_observation_reason(previous)
    if previous_reason != "ready":
        return Err("previous platform observation is invalid: " +
            previous_reason)
    var current = platform_measurement_observe_process_rss()?
    if current.host_os != previous.host_os or
            current.host_arch != previous.host_arch or
            current.clock_source != previous.clock_source or
            current.clock_epoch_semantics !=
                previous.clock_epoch_semantics or
            current.runtime_lane != previous.runtime_lane or
            current.observer_artifact_sha256 !=
                previous.observer_artifact_sha256:
        return Err("live platform identity changed during measurement")
    if current.peak_memory_kib < previous.peak_memory_kib:
        return Err("process peak resident set size regressed")
    # Refresh belongs to the same measurement session as the timestamps and
    # counters already retained by the caller.  A newly minted nonce would
    # relabel those observations with a post-measurement identity.
    current.session_nonce_sha256 = previous.session_nonce_sha256
    current.observation_sha256 =
        platform_measurement_observation_sha256(current)
    val current_reason = platform_measurement_observation_reason(current)
    if current_reason != "ready":
        return Err("refreshed platform observation is invalid: " +
            current_reason)
    Ok(current)

export PLATFORM_MEASUREMENT_CLOCK_IDENTITY_SCHEMA
export platform_measurement_clock_identity_parts
export platform_measurement_observe_process_rss
export platform_measurement_refresh_process_rss

