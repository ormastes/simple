# TLS Types and Constants Module
#
# Defines all TLS protocol constants, version codes, content types,
# handshake message types, cipher suite IDs, extension types, and alert codes.

# =============================================================================
# CONSTANTS - TLS Protocol Values
# =============================================================================

# Content Types (1 byte)
pub val CONTENT_TYPE_CHANGE_CIPHER_SPEC = 20
pub val CONTENT_TYPE_ALERT = 21
pub val CONTENT_TYPE_HANDSHAKE = 22
pub val CONTENT_TYPE_APPLICATION_DATA = 23

# Protocol Versions (2 bytes)
pub val TLS_VERSION_1_0 = 0x0301
pub val TLS_VERSION_1_1 = 0x0302
pub val TLS_VERSION_1_2 = 0x0303
pub val TLS_VERSION_1_3 = 0x0304

# Handshake Message Types (1 byte)
pub val HANDSHAKE_TYPE_HELLO_REQUEST = 0
pub val HANDSHAKE_TYPE_CLIENT_HELLO = 1
pub val HANDSHAKE_TYPE_SERVER_HELLO = 2
pub val HANDSHAKE_TYPE_CERTIFICATE = 11
pub val HANDSHAKE_TYPE_SERVER_KEY_EXCHANGE = 12
pub val HANDSHAKE_TYPE_CERTIFICATE_REQUEST = 13
pub val HANDSHAKE_TYPE_SERVER_HELLO_DONE = 14
pub val HANDSHAKE_TYPE_CERTIFICATE_VERIFY = 15
pub val HANDSHAKE_TYPE_CLIENT_KEY_EXCHANGE = 16
pub val HANDSHAKE_TYPE_FINISHED = 20

# Cipher Suite IDs (2 bytes) - Modern secure suites
pub val CIPHER_TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 = 0xC02F
pub val CIPHER_TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 = 0xC030
pub val CIPHER_TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 = 0xCCA8
pub val CIPHER_TLS_RSA_WITH_AES_128_GCM_SHA256 = 0x009C
pub val CIPHER_TLS_RSA_WITH_AES_256_GCM_SHA384 = 0x009D
pub val CIPHER_TLS_RSA_WITH_AES_128_CBC_SHA256 = 0x003C
pub val CIPHER_TLS_RSA_WITH_AES_256_CBC_SHA256 = 0x003D

# Extension Types (2 bytes)
pub val EXTENSION_TYPE_SERVER_NAME = 0
pub val EXTENSION_TYPE_MAX_FRAGMENT_LENGTH = 1
pub val EXTENSION_TYPE_STATUS_REQUEST = 5
pub val EXTENSION_TYPE_SUPPORTED_GROUPS = 10
pub val EXTENSION_TYPE_EC_POINT_FORMATS = 11
pub val EXTENSION_TYPE_SIGNATURE_ALGORITHMS = 13
pub val EXTENSION_TYPE_ALPN = 16
pub val EXTENSION_TYPE_SUPPORTED_VERSIONS = 43
pub val EXTENSION_TYPE_ENCRYPTED_CLIENT_HELLO = 0xFE0D
pub val EXTENSION_TYPE_ECH_OUTER_EXTENSIONS = 0xFD00

# Alert Levels (1 byte)
pub val ALERT_LEVEL_WARNING = 1
pub val ALERT_LEVEL_FATAL = 2

# Alert Descriptions (1 byte)
pub val ALERT_DESC_CLOSE_NOTIFY = 0
pub val ALERT_DESC_UNEXPECTED_MESSAGE = 10
pub val ALERT_DESC_BAD_RECORD_MAC = 20
pub val ALERT_DESC_HANDSHAKE_FAILURE = 40
pub val ALERT_DESC_BAD_CERTIFICATE = 42
pub val ALERT_DESC_UNSUPPORTED_CERTIFICATE = 43
pub val ALERT_DESC_CERTIFICATE_REVOKED = 44
pub val ALERT_DESC_CERTIFICATE_EXPIRED = 45
pub val ALERT_DESC_CERTIFICATE_UNKNOWN = 46
pub val ALERT_DESC_ILLEGAL_PARAMETER = 47
pub val ALERT_DESC_UNKNOWN_CA = 48
pub val ALERT_DESC_DECODE_ERROR = 50
pub val ALERT_DESC_PROTOCOL_VERSION = 70
pub val ALERT_DESC_INTERNAL_ERROR = 80

# TLS Record Protocol
pub val TLS_RECORD_HEADER_SIZE = 5
pub val TLS_MAX_FRAGMENT_LENGTH = 16384  # 2^14 bytes
