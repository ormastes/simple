"""
# CRM / Sales-Pipeline Vertical — leads, qualification, opportunities

An enterprise vertical of the Simple Enterprise Suite (lane
`.spipe/simple_enterprise_suite`, W19-A) over the durable enterprise store:

    lead -> qualify -> opportunity (Money amount) -> advance (won|lost)

Every write runs the FROZEN guarded sequence (foundation.spl):

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

Effects committed together in the unit of work: the insert-only stage-change
row, the outbox event, the sha256-chained audit record, and the idempotency
key — so a replayed command produces exactly one effect and a rollback carries
none (atomicity on ACID backends; see the store's backend-honesty docstring).

Storage model is insert-only + derive (immutable-ledger rule): a lead's or
opportunity's CURRENT stage is a pure fold over its stage-change stream
(`crm_lead_stage` / `crm_opp_stage`), never an UPDATE. Stage transitions are
gated by a validated allowed-transitions set; an illegal move is denied with
the closed-set reason `invalid-transition` (foundation.reason_set).

## RBAC — reused 'sales' role, local gate (no frozen-table edit)

`foundation.role_allows` is FROZEN and grants the `sales` role only the
`sale.order.*` actions; it says nothing about `crm.*`. Rather than mutate the
frozen table or the equivalence-fenced `enterprise_sale.rbac_registry` (which
would turn its byte-identical equivalence spec red), this module REUSES the
existing `sales` role through a local `crm_role_allows` gate for its four
`crm.*` actions. The frozen session->rbac->validation->idempotency SEQUENCE is
preserved exactly; only the role→action policy for CRM lives here.

Tenant isolation: the SESSION tenant is authority; every reader filters by
tenant in pure Simple and a payload tenant is never trusted.
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, Money,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema
# =============================================================================

fn crm_setup(store: EnterpriseStore) -> bool:
    var ok = store_migrate(store, "crm_001_leads",
        "CREATE TABLE IF NOT EXISTS crm_leads (id INTEGER PRIMARY KEY, tenant_id TEXT, lead_id TEXT, name TEXT)")
    ok = ok and store_migrate(store, "crm_002_lead_stages",
        "CREATE TABLE IF NOT EXISTS crm_lead_stages (id INTEGER PRIMARY KEY, tenant_id TEXT, lead_id TEXT, stage TEXT, detail TEXT)")
    ok = ok and store_migrate(store, "crm_003_opportunities",
        "CREATE TABLE IF NOT EXISTS crm_opportunities (id INTEGER PRIMARY KEY, tenant_id TEXT, opp_id TEXT, lead_id TEXT, amount_cents TEXT, currency TEXT)")
    ok = ok and store_migrate(store, "crm_004_opp_stages",
        "CREATE TABLE IF NOT EXISTS crm_opp_stages (id INTEGER PRIMARY KEY, tenant_id TEXT, opp_id TEXT, stage TEXT, detail TEXT)")
    ok

# =============================================================================
# RBAC — reused 'sales' role via a local gate (see module docstring)
# =============================================================================

fn crm_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "sales":
        return action == "crm.lead.create" or action == "crm.lead.qualify" or action == "crm.opportunity.open" or action == "crm.opportunity.advance"
    false

# =============================================================================
# Validated allowed-transition sets
# =============================================================================

# lead_transition_allowed: a NEW lead may be qualified or disqualified; any
# other move (e.g. re-qualifying an already-qualified lead) is illegal.
fn lead_transition_allowed(cur: text, nxt: text) -> bool:
    (cur == "new" and nxt == "qualified") or (cur == "new" and nxt == "disqualified")

# opp_transition_allowed: an OPEN opportunity may be won or lost; nothing else.
fn opp_transition_allowed(cur: text, nxt: text) -> bool:
    (cur == "open" and nxt == "won") or (cur == "open" and nxt == "lost")

# =============================================================================
# Derived reads — current stage is a pure fold over insert-only history
# =============================================================================

# crm_lead_stage folds the lead's stage stream to its current stage
# ("" when the lead does not exist for this tenant).
fn crm_lead_stage(store: EnterpriseStore, tenant_id: text, lead_id: text) -> text:
    var stage = ""
    val rows = store_rows(store, "crm_lead_stages", "id, tenant_id, lead_id, stage, detail")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "lead_id") == lead_id:
            stage = sqlite_row_get(row, "stage")
    stage

# crm_opp_stage folds the opportunity's stage stream to its current stage.
fn crm_opp_stage(store: EnterpriseStore, tenant_id: text, opp_id: text) -> text:
    var stage = ""
    val rows = store_rows(store, "crm_opp_stages", "id, tenant_id, opp_id, stage, detail")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "opp_id") == opp_id:
            stage = sqlite_row_get(row, "stage")
    stage

# crm_opp_amount reads the opportunity's Money amount in minor units
# (-1 when the opportunity does not exist for this tenant).
fn crm_opp_amount(store: EnterpriseStore, tenant_id: text, opp_id: text) -> i64:
    val rows = store_rows(store, "crm_opportunities", "id, tenant_id, opp_id, lead_id, amount_cents, currency")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "opp_id") == opp_id:
            return int(sqlite_row_get(row, "amount_cents"))
    -1

# =============================================================================
# Pure pipeline read — counts + total Money per stage
# =============================================================================

struct StageSummary:
    stage: text
    count: i64
    total_cents: i64

struct PipelineSummary:
    open: StageSummary
    won: StageSummary
    lost: StageSummary
    currency: text

# crm_pipeline_summary folds every opportunity of a tenant into per-stage
# counts and total Money (minor units). Pure read: no writes, tenant-scoped.
fn crm_pipeline_summary(store: EnterpriseStore, tenant_id: text) -> PipelineSummary:
    var open_c: i64 = 0
    var open_t: i64 = 0
    var won_c: i64 = 0
    var won_t: i64 = 0
    var lost_c: i64 = 0
    var lost_t: i64 = 0
    var currency = ""
    val rows = store_rows(store, "crm_opportunities", "id, tenant_id, opp_id, lead_id, amount_cents, currency")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") != tenant_id:
            continue
        val opp_id = sqlite_row_get(row, "opp_id")
        val amount = int(sqlite_row_get(row, "amount_cents"))
        if currency == "":
            currency = sqlite_row_get(row, "currency")
        val stage = crm_opp_stage(store, tenant_id, opp_id)
        if stage == "open":
            open_c = open_c + 1
            open_t = open_t + amount
        if stage == "won":
            won_c = won_c + 1
            won_t = won_t + amount
        if stage == "lost":
            lost_c = lost_c + 1
            lost_t = lost_t + amount
    PipelineSummary(
        open: StageSummary(stage: "open", count: open_c, total_cents: open_t),
        won: StageSummary(stage: "won", count: won_c, total_cents: won_t),
        lost: StageSummary(stage: "lost", count: lost_c, total_cents: lost_t),
        currency: currency)

# =============================================================================
# Guarded commands — frozen sequence over the durable store
# =============================================================================

# crm_lead_create records a new lead at stage "new". Replaying the same
# idempotency key returns the recorded result WITHOUT a second effect.
fn crm_lead_create(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, lead_id: text, name: text) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", lead_id)
    # 2. rbac
    if not crm_role_allows(who.role, "crm.lead.create"):
        return denied("forbidden", lead_id)
    # 3. domain validation (state-independent identity/shape checks)
    if lead_id == "" or name == "":
        return denied("invalid-record", lead_id)
    # 4. idempotency — a replay returns the recorded outcome, no new effect.
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and crm_lead_stage(store, tenant.tenant_id, lead_id) != "":
        return denied("invalid-record", lead_id)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects — one unit of work
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO crm_leads (tenant_id, lead_id, name) VALUES (?, ?, ?)",
        [tenant.tenant_id, lead_id, name])
    store_insert_row(store,
        "INSERT INTO crm_lead_stages (tenant_id, lead_id, stage, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, lead_id, "new", name])
    outbox_append(store, tenant.tenant_id, "crm.lead.created", lead_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "lead.create", lead_id)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, lead_id)
    uow_commit(store)
    accepted(lead_id)

# crm_lead_qualify transitions a NEW lead to "qualified" (an insert-only
# stage row). An unknown lead is denied invalid-record; an illegal stage move
# is denied invalid-transition from the closed reason set.
fn crm_lead_qualify(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, lead_id: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", lead_id)
    if not crm_role_allows(who.role, "crm.lead.qualify"):
        return denied("forbidden", lead_id)
    val cur = crm_lead_stage(store, tenant.tenant_id, lead_id)
    # Unknown lead is state-INDEPENDENT (this command never creates one).
    if cur == "":
        return denied("invalid-record", lead_id)
    # The transition is state-DEPENDENT on this command's own effect, so it is
    # asked only of a command not already recorded (else a replay of a valid
    # qualify would be denied invalid-transition instead of duplicate-key).
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and not lead_transition_allowed(cur, "qualified"):
        return denied("invalid-transition", lead_id)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO crm_lead_stages (tenant_id, lead_id, stage, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, lead_id, "qualified", ""])
    outbox_append(store, tenant.tenant_id, "crm.lead.qualified", lead_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "lead.qualify", lead_id)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, lead_id)
    uow_commit(store)
    accepted(lead_id)

# crm_opportunity_open opens an opportunity from a QUALIFIED lead with a Money
# amount. A lead that is not qualified is denied invalid-transition.
fn crm_opportunity_open(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, opp_id: text, lead_id: text, amount: Money) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", opp_id)
    if not crm_role_allows(who.role, "crm.opportunity.open"):
        return denied("forbidden", opp_id)
    if opp_id == "" or amount.amount_cents <= 0 or amount.currency == "":
        return denied("invalid-record", opp_id)
    val lead_stage = crm_lead_stage(store, tenant.tenant_id, lead_id)
    # Unknown lead is state-independent.
    if lead_stage == "":
        return denied("not-found", lead_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    # Opening requires a qualified lead — state-dependent, replay-exempt.
    if not replayed and lead_stage != "qualified":
        return denied("invalid-transition", lead_id)
    if not replayed and crm_opp_stage(store, tenant.tenant_id, opp_id) != "":
        return denied("invalid-record", opp_id)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO crm_opportunities (tenant_id, opp_id, lead_id, amount_cents, currency) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, opp_id, lead_id, "{amount.amount_cents}", amount.currency])
    store_insert_row(store,
        "INSERT INTO crm_opp_stages (tenant_id, opp_id, stage, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, opp_id, "open", lead_id])
    outbox_append(store, tenant.tenant_id, "crm.opportunity.opened", opp_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "opportunity.open", opp_id + ":{amount.amount_cents}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, opp_id)
    uow_commit(store)
    accepted(opp_id)

# crm_opportunity_advance moves an OPEN opportunity to "won" or "lost"
# (an insert-only stage row, audited). Any other target — or advancing an
# opportunity that is no longer open — is denied invalid-transition.
fn crm_opportunity_advance(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, opp_id: text, target: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", opp_id)
    if not crm_role_allows(who.role, "crm.opportunity.advance"):
        return denied("forbidden", opp_id)
    val cur = crm_opp_stage(store, tenant.tenant_id, opp_id)
    # Unknown opportunity is state-independent.
    if cur == "":
        return denied("invalid-record", opp_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and not opp_transition_allowed(cur, target):
        return denied("invalid-transition", opp_id)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO crm_opp_stages (tenant_id, opp_id, stage, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, opp_id, target, ""])
    outbox_append(store, tenant.tenant_id, "crm.opportunity." + target, opp_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "opportunity.advance", opp_id + ":" + target)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, opp_id)
    uow_commit(store)
    accepted(opp_id)

export crm_setup, crm_role_allows
export lead_transition_allowed, opp_transition_allowed
export crm_lead_stage, crm_opp_stage, crm_opp_amount
export StageSummary, PipelineSummary, crm_pipeline_summary
export crm_lead_create, crm_lead_qualify, crm_opportunity_open, crm_opportunity_advance
