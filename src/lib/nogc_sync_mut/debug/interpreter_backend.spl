# Interpreter Debug Backend
# Implements DebugBackend trait for the tree-walking interpreter.
# Delegates to the interpreter-mode debug facade (in-memory debug_state
# owner) for breakpoint/step state, and to the interpreter for execution.

use compiler.core.{String, Result, Bool}
use std.nogc_sync_mut.debug.coordinator.{DebugBackend, FrameInfo, VarInfo, LocationInfo}
use std.nogc_sync_mut.io.debug_stubs.{
    rt_debug_set_active, rt_debug_add_breakpoint_at, rt_debug_remove_breakpoint_at,
    rt_debug_remove_all_breakpoints, rt_debug_set_step_mode_val,
    rt_debug_continue_exec, rt_debug_pause_exec, rt_debug_stack_trace_lines,
    rt_debug_local_vars, rt_debug_get_current_file, rt_debug_get_current_line
}

@unsafe(reason: "raw CLI path/argument-array execution status ABI", capabilities: [ffi])
extern fn rt_cli_run_file(path: String, args: [String], debug: Bool, verbose: Bool) -> i64

# Interpreter debug backend
class InterpreterBackend:
    program_path: String
    args: [String]
    attached: Bool

    static fn create() -> InterpreterBackend:
        InterpreterBackend(
            program_path: "",
            args: [],
            attached: false
        )

impl DebugBackend for InterpreterBackend:
    fn name() -> String:
        "interpreter"

    me attach(program_path: String, args: [String]) -> Result<(), String>:
        self.program_path = program_path
        self.args = args
        self.attached = true
        rt_debug_set_active(true)
        Ok(())

    me detach() -> Result<(), String>:
        rt_debug_set_active(false)
        rt_debug_remove_all_breakpoints()
        self.attached = false
        Ok(())

    fn run() -> Result<(), String>:
        if not self.attached:
            return Err("Not attached to a program")
        rt_debug_set_active(true)
        # The interpreter will check debug hooks via should_stop()
        # on each statement execution.
        val status = unsafe(capabilities: [ffi]):
            rt_cli_run_file(self.program_path, self.args, true, false)
        if status != 0:
            return Err("interpreter debug run failed")
        Ok(())

    fn pause() -> Result<(), String>:
        rt_debug_pause_exec()
        Ok(())

    fn resume() -> Result<(), String>:
        rt_debug_continue_exec()
        Ok(())

    fn step_over() -> Result<(), String>:
        rt_debug_set_step_mode_val(1)  # StepOver
        Ok(())

    fn step_in() -> Result<(), String>:
        rt_debug_set_step_mode_val(2)  # StepIn
        Ok(())

    fn step_out() -> Result<(), String>:
        rt_debug_set_step_mode_val(3)  # StepOut
        Ok(())

    me add_breakpoint(file: String, line: Int) -> Result<Int, String>:
        val bp_id = rt_debug_add_breakpoint_at(file, line)
        if bp_id <= 0:
            return Err("debug breakpoint rejected")
        Ok(bp_id)

    me remove_breakpoint(file: String, line: Int) -> Result<(), String>:
        rt_debug_remove_breakpoint_at(file, line)
        Ok(())

    fn stack_trace() -> Result<[FrameInfo], String>:
        val raw_frames = rt_debug_stack_trace_lines()
        var frames: [FrameInfo] = []
        var idx = 0
        for raw in raw_frames:
            # Format: "#0 func_name at file:line"
            frames.push(FrameInfo.of(idx, raw, "", 0))
            idx = idx + 1
        Ok(frames)

    fn locals() -> Result<[VarInfo], String>:
        val raw_locals = rt_debug_local_vars()
        var vars: [VarInfo] = []
        for raw in raw_locals:
            # Format: "name = value : type"
            val parts = raw.split(" = ")
            if parts.len() >= 2:
                val name = parts[0]
                val rest = parts[1]
                val type_parts = rest.split(" : ")
                val value = type_parts[0]
                val type_name = if type_parts.len() >= 2 then type_parts[1] else "unknown"
                vars.push(VarInfo.of(name, value, type_name))
            else:
                vars.push(VarInfo.of(raw, "", "unknown"))
        Ok(vars)

    fn evaluate(expr: String) -> Result<String, String>:
        if not self.attached:
            return Err("not attached — cannot evaluate expressions")
        val locals = rt_debug_local_vars()
        for local in locals:
            val parts = local.split(" = ")
            if parts.len() >= 2 and parts[0] == expr:
                return Ok(parts[1])
        Err("expression eval requires compiled mode or GDB backend")

    fn current_location() -> Result<LocationInfo, String>:
        val file = rt_debug_get_current_file()
        val line = rt_debug_get_current_line()
        Ok(LocationInfo.at(file, line, ""))
