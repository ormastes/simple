# DWARF Debug Information Reader
# Reads DWARF debug info from ELF binaries for source-level debugging.
# SFFI: extern fn rt_dwarf_* -> DwarfInfo class wrappers (DEPRECATED — prefer DwarfParser)
# Uses Option pattern for error handling.

# Import the TYPED dwarf aliases, not the raw `rt_dwarf_*` externs: those are
# file-private `extern fn` declarations of the sync backend that
# `std.sffi.debug` does not provide here, so the previous import resolved to
# nothing and every call below died with `unknown extern function:
# rt_dwarf_*` instead of returning the documented empty/zero failure value.
use std.sffi.debug.{
    dwarf_load as sffi_dwarf_load,
    dwarf_free as sffi_dwarf_free,
    dwarf_addr_to_line as sffi_dwarf_addr_to_line,
    dwarf_line_to_addr as sffi_dwarf_line_to_addr,
    dwarf_function_at as sffi_dwarf_function_at,
}
use std.debug.formats.debug_types.{SourceLocation}
use std.debug.debug_info_bridge.{DebugInfoBridge}

# DWARF debug information handle for an ELF binary
class DwarfInfo:
    handle: i64
    binary_path: text
    loaded: bool
    bridge: DebugInfoBridge?

impl DwarfInfo:
    # DEPRECATED: Use DwarfParser.from_elf() + DebugInfoBridge instead.
    static fn load(path: text) -> DwarfInfo:
        val h = sffi_dwarf_load(path)
        if h == 0:
            return nil
        DwarfInfo(
            handle: h,
            binary_path: path,
            loaded: true,
            bridge: nil
        )

    # Create from a pure-Simple DebugInfoProvider via DebugInfoBridge.
    static fn from_bridge(bridge: DebugInfoBridge, path: text) -> DwarfInfo:
        DwarfInfo(
            handle: 0,
            binary_path: path,
            loaded: true,
            bridge: Some(bridge)
        )

    fn addr_to_source(addr: i64) -> SourceLocation?:
        if not self.loaded:
            return nil
        if self.bridge != nil:
            return self.bridge!.addr_to_source(addr)

        val result = sffi_dwarf_addr_to_line(self.handle, addr)
        if result.len() == 0:
            return nil

        val parts = result.split(":")
        if parts.len() < 2:
            return nil

        val file = parts[0]
        val line = parts[1].parse_int() ?? 0
        if line == 0:
            return nil

        var column = 0
        if parts.len() >= 3:
            column = parts[2].parse_int() ?? 0

        SourceLocation(file: file, line: line, column: column)

    fn source_to_addr(file: text, line: i64) -> i64:
        if not self.loaded:
            return 0
        if self.bridge != nil:
            val addr = self.bridge!.source_to_addr(file, line)
            if addr != nil:
                return addr!
            return 0

        val addr = sffi_dwarf_line_to_addr(self.handle, file, line)
        addr

    fn function_name_at(addr: i64) -> text:
        if not self.loaded:
            return ""
        if self.bridge != nil:
            return self.bridge!.function_name_at(addr)

        val name = sffi_dwarf_function_at(self.handle, addr)
        name

    # Get a fully detailed source location including function name.
    # Returns nil if the address cannot be resolved.
    fn detailed_location(addr: i64) -> SourceLocation?:
        val loc = self.addr_to_source(addr)
        if loc == nil:
            return nil
        loc

    # Check if the DWARF info is loaded and valid
    fn is_loaded() -> bool:
        self.loaded and self.handle != 0

    # Get the binary path this DWARF info was loaded from
    fn get_binary_path() -> text:
        self.binary_path

    # Close and free the DWARF handle.
    # After calling this, no further operations should be performed.
    me close():
        if self.loaded:
            if self.handle != 0:
                sffi_dwarf_free(self.handle)
            self.loaded = false
            self.handle = 0
            self.bridge = nil

# --- Standalone convenience functions ---

# There is deliberately no standalone `dwarf_load` here (W-MC-RES-001 /
# REQ-MC-023): acquiring a DWARF handle must go through the managed
# `DwarfInfo` wrapper (`DwarfInfo.load` + `me close()`), which owns the
# handle and guarantees release. A bare forwarder returning the raw
# `rt_dwarf_load` handle would let it escape unmanaged.

# Free a DWARF info handle.
fn dwarf_free(handle: i64):
    sffi_dwarf_free(handle)

# Resolve address to "file:line" string. Returns empty string on failure.
# Invalid-handle/address rejection lives in the canonical `std.sffi.debug`
# alias.
fn dwarf_addr_to_line(handle: i64, addr: i64) -> text:
    sffi_dwarf_addr_to_line(handle, addr)

# Resolve file:line to code address. Returns 0 on failure.
fn dwarf_line_to_addr(handle: i64, file: text, line: i64) -> i64:
    sffi_dwarf_line_to_addr(handle, file, line)

# Get function name at address. Returns empty string on failure.
fn dwarf_function_at(handle: i64, addr: i64) -> text:
    sffi_dwarf_function_at(handle, addr)

# --- Exports ---

