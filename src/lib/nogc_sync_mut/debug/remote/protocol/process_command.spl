# Bounded shell-command owner for hosted debug adapters.
#
# The adapters in this package consume command-line tools whose invocation is
# already expressed as one shell command. Keep that compatibility shape, but
# route it through the canonical process facade so exit status and stderr
# cannot be confused with an empty successful stdout value.

use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

val DEBUG_COMMAND_TIMEOUT_MS: i64 = 120000
val DEBUG_COMMAND_MAX_OUTPUT_BYTES: i64 = 1048576

pub fn debug_process_output(command: text, args: [text]) -> Result<text, text>:
    val (stdout, stderr, code) = process_run_bounded(
        command,
        args,
        DEBUG_COMMAND_TIMEOUT_MS,
        DEBUG_COMMAND_MAX_OUTPUT_BYTES
    )
    if code != 0:
        val detail = stderr.trim()
        if detail.len() > 0:
            return Err("command failed with exit code {code}: {detail}")
        return Err("command failed with exit code {code}")
    Ok(stdout)

# Use only for command composition that genuinely requires a shell pipeline.
# Values cross as positional parameters, never interpolated shell syntax.
pub fn debug_shell_output(script: text, args: [text]) -> Result<text, text>:
    var shell_args = ["-c", script, "debug-command"]
    shell_args.extend(args)
    debug_process_output("/bin/sh", shell_args)
