# DebugServiceV1 bridge for the existing TRACE32 registry and operations.
#
# This module deliberately owns no TRACE32 transport or device session.  It
# binds an existing t32_session_registry entry to the centrally-owned debug
# session and gates calls into the existing window/PRACTICE/reset/flash owners.

use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugReceiptV1, DebugCapabilityV1,
    DebugVerificationV1, DebugPerturbationV1, DebugRootOperationV1,
    DebugTargetNodeV1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_authorize, central_debug_service_v1_record,
    central_debug_service_v1_close,
}
use std.nogc_sync_mut.debug.remote.protocol.t32_session_registry.{
    T32SessionEntry, t32_get_session,
}
use std.nogc_sync_mut.debug.remote.protocol.t32_window_capture.{
    t32_capture_window_text,
}
use std.nogc_sync_mut.debug.remote.protocol.t32_practice_runner.{
    t32_run_cmm,
}

struct T32DebugBindingV1:
    t32_session_id: text
    resource_uri: text
    debug_session_id: DebugSessionId

pub struct T32DebugActionClassV1:
    operation: DebugRootOperationV1
    perturbation: DebugPerturbationV1
    execution_changed_on_success: bool

var T32_DEBUG_BINDINGS_V1: [T32DebugBindingV1] = []

fn t32_debug_bind_session_v1(t32_session_id: text, resource_uri: text, build_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
    if resource_uri.trim() == "":
        return Err("TRACE32 debug binding requires a resource URI")
    if t32_debug_binding_v1(t32_session_id, resource_uri) != nil:
        return Err("TRACE32 resource is already bound to DebugServiceV1")
    val existing = t32_get_session(t32_session_id)
    match existing:
        case None: return Err("TRACE32 session not found: {t32_session_id}")
        case Some(session):
            if not session.client.connected:
                return Err("TRACE32 session is not connected: {t32_session_id}")

    val debug_session_id = central_debug_service_v1_open(build_id, policy)?
    val target = DebugTargetNodeV1(
        target_id: resource_uri,
        parent_target_id: "",
        kind: "embedded.trace32",
        label: "TRACE32 {t32_session_id}",
    )
    val capability = DebugCapabilityV1(
        target_id: resource_uri,
        support: CapLevel.Native,
        verification: DebugVerificationV1.LiveVerified,
        perturbation: DebugPerturbationV1.Mutating,
        reason: "bound to connected TRACE32 session registry entry",
    )
    match central_debug_service_v1_add_target(debug_session_id, target, capability):
        case Err(reason):
            central_debug_service_v1_close(debug_session_id)
            return Err(reason)
        case Ok(_): ()
    T32_DEBUG_BINDINGS_V1.push(T32DebugBindingV1(
        t32_session_id: t32_session_id,
        resource_uri: resource_uri,
        debug_session_id: debug_session_id,
    ))
    Ok(debug_session_id)

fn t32_debug_binding_v1(t32_session_id: text, resource_uri: text) -> Option<T32DebugBindingV1>:
    for binding in T32_DEBUG_BINDINGS_V1:
        if binding.t32_session_id == t32_session_id and binding.resource_uri == resource_uri:
            return Some(binding)
    None

fn t32_debug_unbind_session_v1(t32_session_id: text, resource_uri: text) -> Result<Nil, text>:
    val binding = t32_debug_binding_v1(t32_session_id, resource_uri)
    match binding:
        case None: return Err("TRACE32 debug binding not found")
        case Some(value): central_debug_service_v1_close(value.debug_session_id)?
    T32_DEBUG_BINDINGS_V1 = T32_DEBUG_BINDINGS_V1.filter(\item:
        item.t32_session_id != t32_session_id or item.resource_uri != resource_uri
    )
    Ok(nil)

fn t32_debug_authorize_window_capture_v1(debug_session_id: DebugSessionId) -> DebugReceiptV1:
    central_debug_service_v1_authorize(
        debug_session_id,
        DebugRootOperationV1.Inspect,
        DebugPerturbationV1.Passive,
        "t32.window.capture",
    )

fn t32_debug_action_perturbation_v1(action: text) -> DebugPerturbationV1:
    val normalized = action.trim().upper()
    if (normalized.starts_with("DO ") or normalized == "DO" or
        normalized.starts_with("PRACTICE") or
        normalized.starts_with("RESET") or normalized.starts_with("SYStem.RESet".upper()) or
        normalized.starts_with("FLASH")):
        return DebugPerturbationV1.Mutating
    DebugPerturbationV1.Cooperative

fn t32_debug_authorize_action_v1(debug_session_id: DebugSessionId, action: text) -> DebugReceiptV1:
    central_debug_service_v1_authorize(
        debug_session_id,
        DebugRootOperationV1.Control,
        t32_debug_action_perturbation_v1(action),
        "t32.action.{action.trim()}",
    )

# Classify the ordinary DAP surface before any TRACE32 transport call.  Keep
# these stable semantic names independent of the client's t32rem commands.
pub fn t32_debug_classify_dap_action_v1(action: text) -> T32DebugActionClassV1:
    val normalized = action.trim().lower()
    if (normalized == "halt" or normalized == "single_step" or
        normalized == "step_over" or normalized == "step_out"):
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Control,
            perturbation: DebugPerturbationV1.Stopping,
            execution_changed_on_success: true,
        )
    if normalized == "resume" or normalized == "attach":
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Control,
            perturbation: DebugPerturbationV1.Cooperative,
            execution_changed_on_success: true,
        )
    if (normalized == "memory.write" or normalized == "register.write"):
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Control,
            perturbation: DebugPerturbationV1.Mutating,
            execution_changed_on_success: true,
        )
    if normalized.starts_with("breakpoint.") or normalized == "watchpoint.set":
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Probe,
            perturbation: DebugPerturbationV1.Stopping,
            execution_changed_on_success: true,
        )
    if normalized == "trace.capture":
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Profile,
            perturbation: DebugPerturbationV1.Cooperative,
            execution_changed_on_success: false,
        )
    if normalized == "coverage.collect":
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Profile,
            perturbation: DebugPerturbationV1.Passive,
            execution_changed_on_success: false,
        )
    if normalized == "frame.select" or normalized == "evaluate":
        return T32DebugActionClassV1(
            operation: DebugRootOperationV1.Inspect,
            perturbation: DebugPerturbationV1.Cooperative,
            execution_changed_on_success: false,
        )
    T32DebugActionClassV1(
        operation: DebugRootOperationV1.Inspect,
        perturbation: DebugPerturbationV1.Passive,
        execution_changed_on_success: false,
    )

pub fn t32_debug_authorize_dap_action_v1(debug_session_id: DebugSessionId, action: text) -> DebugReceiptV1:
    val class = t32_debug_classify_dap_action_v1(action)
    central_debug_service_v1_authorize(
        debug_session_id,
        class.operation,
        class.perturbation,
        "t32.dap.{action.trim()}",
    )

pub fn t32_debug_record_dap_outcome_v1(debug_session_id: DebugSessionId, action: text, succeeded: bool, reason: text) -> DebugReceiptV1:
    val class = t32_debug_classify_dap_action_v1(action)
    central_debug_service_v1_record(
        debug_session_id,
        class.operation,
        class.perturbation,
        "t32.dap.{action.trim()}.outcome",
        succeeded,
        succeeded and class.execution_changed_on_success,
        reason,
    )

fn t32_debug_capture_window_v1(t32_session_id: text, resource_uri: text, window_name: text) -> Result<text, text>:
    val pair = t32_debug_bound_pair_v1(t32_session_id, resource_uri)?
    val receipt = t32_debug_authorize_window_capture_v1(pair.1)
    if not receipt.allowed:
        return Err(receipt.reason)
    val result = t32_capture_window_text(pair.0.client, window_name)
    match result:
        case Ok(content):
            central_debug_service_v1_record(pair.1, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "t32.window.capture.outcome", true, false, "")
            Ok(content)
        case Err(reason):
            central_debug_service_v1_record(pair.1, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "t32.window.capture.outcome", false, false, reason)
            Err(reason)

fn t32_debug_run_practice_v1(t32_session_id: text, resource_uri: text, script_path: text) -> Result<text, text>:
    val pair = t32_debug_bound_pair_v1(t32_session_id, resource_uri)?
    val receipt = t32_debug_authorize_action_v1(pair.1, "PRACTICE DO")
    if not receipt.allowed:
        return Err(receipt.reason)
    val result = t32_run_cmm(pair.0.client, script_path)
    t32_debug_record_mutating_result_v1(pair.1, "t32.practice.outcome", result)

fn t32_debug_reset_v1(t32_session_id: text, resource_uri: text) -> Result<text, text>:
    val pair = t32_debug_bound_pair_v1(t32_session_id, resource_uri)?
    val receipt = t32_debug_authorize_action_v1(pair.1, "RESET")
    if not receipt.allowed:
        return Err(receipt.reason)
    val result = pair.0.client.system_reset()
    t32_debug_record_mutating_result_v1(pair.1, "t32.reset.outcome", result)

fn t32_debug_flash_v1(t32_session_id: text, resource_uri: text, image_path: text) -> Result<text, text>:
    val pair = t32_debug_bound_pair_v1(t32_session_id, resource_uri)?
    val receipt = t32_debug_authorize_action_v1(pair.1, "FLASH.Program")
    if not receipt.allowed:
        return Err(receipt.reason)
    val result = pair.0.client.flash_program(image_path)
    t32_debug_record_mutating_result_v1(pair.1, "t32.flash.outcome", result)

fn t32_debug_bound_pair_v1(t32_session_id: text, resource_uri: text) -> Result<(T32SessionEntry, DebugSessionId), text>:
    val session = t32_get_session(t32_session_id)
    val binding = t32_debug_binding_v1(t32_session_id, resource_uri)
    match session:
        case None: return Err("TRACE32 session not found: {t32_session_id}")
        case Some(value):
            match binding:
                case None: return Err("TRACE32 resource is not bound to DebugServiceV1")
                case Some(bound): Ok((value, bound.debug_session_id))

fn t32_debug_record_mutating_result_v1(debug_session_id: DebugSessionId, action: text, result: Result<text, text>) -> Result<text, text>:
    match result:
        case Ok(output):
            central_debug_service_v1_record(debug_session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, action, true, true, "")
            Ok(output)
        case Err(reason):
            central_debug_service_v1_record(debug_session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, action, false, false, reason)
            Err(reason)

export T32DebugBindingV1
export t32_debug_bind_session_v1, t32_debug_binding_v1, t32_debug_unbind_session_v1
export t32_debug_authorize_window_capture_v1, t32_debug_action_perturbation_v1
export t32_debug_authorize_action_v1, t32_debug_capture_window_v1
export t32_debug_run_practice_v1, t32_debug_reset_v1, t32_debug_flash_v1
export T32DebugActionClassV1, t32_debug_classify_dap_action_v1
export t32_debug_authorize_dap_action_v1, t32_debug_record_dap_outcome_v1
