# DebugServiceV1 bridge for the existing Windows DbgEng client and DAP adapter.
#
# This module owns no debugger transport and parses no dump bytes. Live and dump
# acquisition remain in DbgEngClient/DbgEngAdapter; this bridge only binds their
# resource identity to the central service, applies policy, and indexes native
# minidump evidence.

use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugReceiptV1, DebugCapabilityV1,
    DebugVerificationV1, DebugPerturbationV1, DebugRootOperationV1,
    DebugTargetNodeV1, DebugEvidenceArtifactV1, DebugEvidenceManifestV1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_authorize, central_debug_service_v1_record,
    central_debug_service_v1_export_evidence, central_debug_service_v1_close,
}
use std.nogc_sync_mut.dap.adapter.dbgeng.DbgEngAdapter

pub struct DbgEngDebugBindingV1:
    resource_uri: text
    debug_session_id: DebugSessionId
    dump_path: text

var DBGENG_DEBUG_BINDINGS_V1: [DbgEngDebugBindingV1] = []

pub fn dbgeng_debug_bind_existing_v1(adapter: DbgEngAdapter, resource_uri: text, build_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
    if resource_uri.trim() == "":
        return Err("DbgEng debug binding requires a resource URI")
    if not adapter.is_attached():
        return Err("DbgEng adapter is not attached")
    if dbgeng_debug_binding_v1(resource_uri) != nil:
        return Err("DbgEng resource is already bound to DebugServiceV1")
    dbgeng_debug_register_v1(resource_uri, build_id, policy, "", DebugVerificationV1.Unverified)

pub fn dbgeng_debug_open_dump_v1(dump_path: text, resource_uri: text, build_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
    if dump_path.trim() == "":
        return Err("DbgEng dump path is required")
    # Reuse the existing DAP adapter, which delegates to DbgEngClient.load_dump.
    val adapter = DbgEngAdapter.from_dump(dump_path)?
    if not adapter.is_attached():
        return Err("DbgEng dump adapter is not attached")
    dbgeng_debug_register_v1(resource_uri, build_id, policy, dump_path, DebugVerificationV1.FixtureVerified)

fn dbgeng_debug_register_v1(resource_uri: text, build_id: text, policy: DebugPolicyV1, dump_path: text, verification: DebugVerificationV1) -> Result<DebugSessionId, text>:
    if resource_uri.trim() == "":
        return Err("DbgEng debug binding requires a resource URI")
    val debug_session_id = central_debug_service_v1_open(build_id, policy)?
    val target = DebugTargetNodeV1(
        target_id: resource_uri,
        parent_target_id: "",
        kind: if dump_path == "": "windows.dbgeng" else: "windows.minidump",
        label: if dump_path == "": "Windows DbgEng" else: "Windows minidump",
    )
    val capability = DebugCapabilityV1(
        target_id: resource_uri,
        support: CapLevel.Native,
        verification: verification,
        perturbation: if dump_path == "": DebugPerturbationV1.Mutating else: DebugPerturbationV1.Passive,
        reason: if dump_path == "": "bound to existing DbgEng adapter; reachability not independently probed" else: "loaded by existing DbgEng minidump path",
    )
    match central_debug_service_v1_add_target(debug_session_id, target, capability):
        case Err(reason):
            central_debug_service_v1_close(debug_session_id)
            return Err(reason)
        case Ok(_): ()

    # ETW is a separate evidence mechanism. DbgEng availability does not prove it.
    val etw_id = "{resource_uri}/etw"
    val etw_target = DebugTargetNodeV1(target_id: etw_id, parent_target_id: resource_uri, kind: "windows.etw", label: "Windows ETW")
    val etw_capability = DebugCapabilityV1(
        target_id: etw_id,
        support: CapLevel.Unavailable,
        verification: DebugVerificationV1.Unverified,
        perturbation: DebugPerturbationV1.Passive,
        reason: "ETW adapter is not connected by the DbgEng bridge",
    )
    match central_debug_service_v1_add_target(debug_session_id, etw_target, etw_capability):
        case Err(reason):
            central_debug_service_v1_close(debug_session_id)
            return Err(reason)
        case Ok(_): ()
    DBGENG_DEBUG_BINDINGS_V1.push(DbgEngDebugBindingV1(resource_uri: resource_uri, debug_session_id: debug_session_id, dump_path: dump_path))
    Ok(debug_session_id)

pub fn dbgeng_debug_binding_v1(resource_uri: text) -> Option<DbgEngDebugBindingV1>:
    for binding in DBGENG_DEBUG_BINDINGS_V1:
        if binding.resource_uri == resource_uri:
            return Some(binding)
    None

pub fn dbgeng_debug_unbind_v1(resource_uri: text) -> Result<Nil, text>:
    match dbgeng_debug_binding_v1(resource_uri):
        case None: return Err("DbgEng debug binding not found")
        case Some(binding): central_debug_service_v1_close(binding.debug_session_id)?
    DBGENG_DEBUG_BINDINGS_V1 = DBGENG_DEBUG_BINDINGS_V1.filter(_.resource_uri != resource_uri)
    Ok(nil)

pub fn dbgeng_debug_action_perturbation_v1(action: text) -> DebugPerturbationV1:
    val normalized = action.trim().lower()
    if (normalized == "write_memory" or normalized == "write_register" or
        normalized == "evaluate" or normalized == "execute_command"):
        return DebugPerturbationV1.Mutating
    if (normalized == "resume" or normalized == "halt" or normalized.starts_with("step") or
        normalized.starts_with("breakpoint") or normalized.starts_with("watchpoint")):
        return DebugPerturbationV1.Stopping
    DebugPerturbationV1.Passive

pub fn dbgeng_debug_authorize_v1(debug_session_id: DebugSessionId, action: text) -> DebugReceiptV1:
    val perturbation = dbgeng_debug_action_perturbation_v1(action)
    val operation = if perturbation == DebugPerturbationV1.Passive: DebugRootOperationV1.Inspect else: DebugRootOperationV1.Control
    central_debug_service_v1_authorize(debug_session_id, operation, perturbation, "dbgeng.{action.trim()}")

pub fn dbgeng_debug_record_outcome_v1(debug_session_id: DebugSessionId, action: text, succeeded: bool, reason: text) -> DebugReceiptV1:
    val perturbation = dbgeng_debug_action_perturbation_v1(action)
    val operation = if perturbation == DebugPerturbationV1.Passive: DebugRootOperationV1.Inspect else: DebugRootOperationV1.Control
    central_debug_service_v1_record(debug_session_id, operation, perturbation, "dbgeng.{action.trim()}.outcome", succeeded, succeeded and perturbation != DebugPerturbationV1.Passive, reason)

pub fn dbgeng_debug_retain_minidump_v1(debug_session_id: DebugSessionId, dump_path: text, digest: text, privacy_label: text, captured_at_ns: i64) -> Result<DebugEvidenceManifestV1, text>:
    if dump_path.trim() == "":
        return Err("DbgEng minidump path is required")
    central_debug_service_v1_export_evidence(debug_session_id, captured_at_ns, [DebugEvidenceArtifactV1(
        path: dump_path,
        media_type: "application/vnd.microsoft.portable-executable.minidump",
        digest: digest,
        native: true,
        privacy_label: privacy_label,
    )])
