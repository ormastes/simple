# Simple-to-Bytes Compiler Bridge
#
# Fail-closed boundary for remote JIT compilation. A real target compiler must
# supply source-derived bytes before this API may return Ok.

use std.nogc_sync_mut.debug.remote.exec.types.{Architecture}

pub class CompilerBridge:
    static fn compile(source: text, arch: Architecture, base_addr: i64) -> Result<[i32], text>:
        compile_remote_binary(source, arch, base_addr)

    static fn compile_in_dir(source: text, arch: Architecture, base_addr: i64, tmpdir: text) -> Result<[i32], text>:
        compile_remote_binary_in_dir(source, arch, base_addr, tmpdir)

pub fn compile_remote_binary(source: text, arch: Architecture, base_addr: i64) -> Result<[i32], text>:
    compile_remote_binary_in_dir(source, arch, base_addr, "")

pub fn compile_remote_binary_arm32(source: text, base_addr: i64) -> Result<[i32], text>:
    compile_remote_binary_in_dir(source, Architecture.Arm32, base_addr, "")

# @tag(source=source_path, tmpdir=tmpdir)
pub fn compile_remote_binary_in_dir(source: text, arch: Architecture, base_addr: i64, tmpdir: text) -> Result<[i32], text>:
    match arch:
        Architecture.Arm32: Err("remote compiler unavailable for arm32: source-derived target bytes are required")
        Architecture.RiscV32: Err("remote compiler unavailable for riscv32: source-derived target bytes are required")
        _: Err("unsupported remote JIT arch")
