# Shared source-edit core — snapshot and validation schemas (rev-3 §8-§13).
# A SourceSnapshot is the analysed revision every proposal is bound to; a
# ValidationReport is the staged, fail-closed verdict the core gives on a set
# of proposals before anything is previewed or written.
use std.common.crypto.sha256.{sha256_text}

pub struct SourceSnapshot:
    file: text
    version: text
    source: text

pub fn snapshot_version(source: text) -> text:
    sha256_text(source)

pub fn source_snapshot(file: text, source: text) -> SourceSnapshot:
    SourceSnapshot(file: file, version: snapshot_version(source), source: source)

# stage: "version" | "edits" | "reparse" | "ok"
pub struct ValidationReport:
    ok: bool
    stage: text
    errors: [text]

pub fn validation_ok() -> ValidationReport:
    ValidationReport(ok: true, stage: "ok", errors: [])

pub fn validation_failed(stage: text, error: text) -> ValidationReport:
    ValidationReport(ok: false, stage: stage, errors: [error])

pub fn validation_report_text(report: ValidationReport) -> text:
    if report.ok:
        return "validation: ok"
    "validation failed at stage {report.stage}: " + report.errors.join("; ")

