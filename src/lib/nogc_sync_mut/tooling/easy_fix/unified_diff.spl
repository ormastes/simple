# Shared source-edit core — review diff for a validated proposal set.
# Line-based unified diff with one hunk per changed region (common prefix /
# suffix trimmed, 3 lines of context). Exact enough for review; a full LCS is
# deliberately not implemented (YAGNI).

fn _split_lines(s: text) -> [text]:
    if s == "": return []
    var lines = s.split("\n")
    if s.ends_with("\n"):
        lines.pop()
    lines

pub fn unified_diff(path: text, old_text: text, new_text: text) -> text:
    if old_text == new_text: return ""
    val a = _split_lines(old_text)
    val b = _split_lines(new_text)
    var prefix = 0
    while prefix < a.len() and prefix < b.len() and a[prefix] == b[prefix]:
        prefix = prefix + 1
    var suffix = 0
    while suffix < a.len() - prefix and suffix < b.len() - prefix and a[a.len() - 1 - suffix] == b[b.len() - 1 - suffix]:
        suffix = suffix + 1
    val ctx_before = if prefix >= 3: 3 else: prefix
    val ctx_after = if suffix >= 3: 3 else: suffix
    val a_from = prefix - ctx_before
    val a_to = a.len() - suffix + ctx_after
    val b_to = b.len() - suffix + ctx_after
    var out = "--- a/{path}\n+++ b/{path}\n"
    out = out + "@@ -{a_from + 1},{a_to - a_from} +{a_from + 1},{b_to - a_from} @@\n"
    var i = a_from
    while i < prefix:
        out = out + " " + a[i] + "\n"
        i = i + 1
    i = prefix
    while i < a.len() - suffix:
        out = out + "-" + a[i] + "\n"
        i = i + 1
    i = prefix
    while i < b.len() - suffix:
        out = out + "+" + b[i] + "\n"
        i = i + 1
    i = a.len() - suffix
    while i < a_to:
        out = out + " " + a[i] + "\n"
        i = i + 1
    out

