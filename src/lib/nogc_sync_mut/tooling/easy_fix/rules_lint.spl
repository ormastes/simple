@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# EasyFix Lint Rules (L: prefix)
# Rules 1, 3, 4, 5, 6: print_in_test_spec, resource_leak,
# spipe_missing_docstrings, spipe_manual_assertions, non_exhaustive_match

use std.tooling.easy_fix.types.{EasyFix, FixConfidence, Replacement}
use std.tooling.easy_fix.rules_helpers.{LineContext, line_contexts}

# ============================================================================
# Rule 1: print_in_test_spec
# Detects print(...) calls in _spec.spl files and suggests expect().
# Confidence: Likely
# ============================================================================

pub fn check_print_in_test_spec(source: String, file: String) -> [EasyFix]:
    if not file.ends_with("_spec.spl"):
        return []
    check_print_in_test_spec_with_contexts(file, line_contexts(source))

pub fn check_print_in_test_spec_with_contexts(file: String, contexts: [LineContext]) -> [EasyFix]:
    # Only applies to spec files
    if not file.ends_with("_spec.spl"):
        return []

    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        # Detect bare print(...) inside test context
        if ctx.trimmed.starts_with("print(") or ctx.trimmed.starts_with("print "):
            val start = ctx.byte_offset + ctx.indent
            val end = ctx.byte_offset + ctx.line.len()

            # Extract the argument
            var arg = ""
            if ctx.trimmed.starts_with("print("):
                # Find matching closing paren
                val inner = ctx.trimmed.slice(6)
                if inner.ends_with(")"):
                    arg = inner.slice(0, inner.byte_len() - 1)
                else:
                    arg = inner

            if arg.len() > 0:
                var fix = EasyFix.create(
                    id: "L:print_in_test_spec:{ctx.line_num}",
                    description: "replace print() with expect() in test spec",
                    confidence: FixConfidence.Likely
                )
                val spaces = " ".repeat(ctx.indent)
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: start,
                    end: end,
                    line: ctx.line_num,
                    column: ctx.indent + 1,
                    new_text: "{spaces}expect({arg})"
                ))
                fixes.push(fix)

    fixes

# ============================================================================
# Rule 3: resource_leak
# Detects open()/connect() calls not wrapped in `with` blocks.
# Confidence: Uncertain
# ============================================================================

pub fn check_resource_leak(source: String, file: String) -> [EasyFix]:
    check_resource_leak_with_contexts(file, line_contexts(source))

pub fn check_resource_leak_with_contexts(file: String, contexts: [LineContext]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        # Detect val x = open(...) or val x = connect(...) not inside with
        val is_resource_open = ctx.trimmed.contains("= open(") or ctx.trimmed.contains("= connect(") or ctx.trimmed.contains("= File.open(")
        if is_resource_open and ctx.trimmed.starts_with("val ") and not ctx.trimmed.starts_with("with"):
            # Check previous lines for `with` block context (simple heuristic)

            # Extract variable name and expression
            val eq_pos = ctx.trimmed.find("=")
            if eq_pos > 4:
                val var_name = ctx.trimmed.slice(4, eq_pos).trim()
                val expr = ctx.trimmed.slice(eq_pos + 1).trim()

                val start = ctx.byte_offset + ctx.indent
                val end = ctx.byte_offset + ctx.line.len()

                val spaces = " ".repeat(ctx.indent)
                val inner_spaces = " ".repeat(ctx.indent + 4)
                val new_text = "{spaces}with {var_name} = {expr}:\n{inner_spaces}# TODO: use {var_name} here"

                var fix = EasyFix.create(
                    id: "L:resource_leak:{ctx.line_num}",
                    description: "wrap resource in `with` block to ensure cleanup",
                    confidence: FixConfidence.Uncertain
                )
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: start,
                    end: end,
                    line: ctx.line_num,
                    column: ctx.indent + 1,
                    new_text: new_text
                ))
                fixes.push(fix)

    fixes

# ============================================================================
# Rule 4: spipe_missing_docstrings
# Detects describe/context blocks without docstrings.
# Confidence: Safe
# ============================================================================

pub fn check_spipe_missing_docstrings(source: String, file: String) -> [EasyFix]:
    if not file.ends_with("_spec.spl"):
        return []
    check_spipe_missing_docstrings_with_lines(file, source.split("\n"))

pub fn check_spipe_missing_docstrings_with_lines(file: String, lines: [String]) -> [EasyFix]:
    var fixes: [EasyFix] = []

    if not file.ends_with("_spec.spl"):
        return fixes

    var line_num = 0
    var byte_offset = 0

    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()

        val is_describe = trimmed.starts_with("describe ")
        val is_context = trimmed.starts_with("context ")

        if is_describe or is_context:
            val keyword = if is_describe then "describe" else "context"

            # Extract the name string
            val after_kw = trimmed.slice(keyword.len()).trim()
            var block_name = after_kw
            if after_kw.starts_with("\""):
                val close_quote = after_kw.slice(1).find("\"")
                if close_quote >= 0:
                    block_name = after_kw.slice(1, close_quote + 1)

            # Check if next non-empty line is a docstring (""")
            var next_idx = line_num  # 0-indexed for next line
            var has_docstring = false
            var check_offset = byte_offset + line.len() + 1

            if next_idx < lines.len():
                val next_line = lines[next_idx]
                val next_trimmed = next_line.trim()
                if next_trimmed.starts_with("\"\"\""):
                    has_docstring = true

            if not has_docstring:
                val indent = line.len() - trimmed.len()
                val insert_pos = byte_offset + line.len() + 1  # After newline
                val spaces = " ".repeat(indent + 4)
                val header = if is_describe then "##" else "###"
                val scenario = if is_describe then "" else "Scenario: "
                val docstring = "{spaces}\"\"\"\n{spaces}{header} {scenario}{block_name}\n{spaces}\n{spaces}Description of this {keyword} block.\n{spaces}\"\"\"\n"

                var fix = EasyFix.create(
                    id: "L:spipe_missing_docstrings:{line_num}",
                    description: "add template docstring to {keyword} block",
                    confidence: FixConfidence.Safe
                )
                fix.add_replacement(Replacement.create(
                    file: file,
                    start: insert_pos,
                    end: insert_pos,
                    line: line_num + 1,
                    column: 1,
                    new_text: docstring
                ))
                fixes.push(fix)

        byte_offset = byte_offset + line.len() + 1

    fixes

# ============================================================================
# Rule 5: spipe_manual_assertions
# Detects `if condition: fail(...)` and suggests `expect(condition)`.
# Confidence: Likely
# ============================================================================

pub fn check_spipe_manual_assertions(source: String, file: String) -> [EasyFix]:
    if not file.ends_with("_spec.spl"):
        return []
    check_spipe_manual_assertions_with_contexts(file, line_contexts(source))

pub fn check_spipe_manual_assertions_with_contexts(file: String, contexts: [LineContext]) -> [EasyFix]:
    if not file.ends_with("_spec.spl"):
        return []

    var fixes: [EasyFix] = []
    for raw_ctx in contexts:
        val ctx: LineContext = raw_ctx

        # Pattern: if <cond>: fail(...) or if not <cond>: fail(...)
        if ctx.trimmed.starts_with("if ") and ctx.trimmed.contains("fail("):
            # Extract condition: between "if " and ":"
            val colon_pos = ctx.trimmed.find(":")
            if colon_pos > 3:
                val condition = ctx.trimmed.slice(3, colon_pos).trim()
                val after_colon = ctx.trimmed.slice(colon_pos + 1).trim()

                if after_colon.starts_with("fail("):
                    val start = ctx.byte_offset + ctx.indent
                    val end = ctx.byte_offset + ctx.line.len()
                    val spaces = " ".repeat(ctx.indent)

                    # If condition is negated, expect the positive
                    val expect_expr = if condition.starts_with("not ") then "expect({condition.slice(4).trim()}).to_be_truthy()" else "expect({condition}).to_be_falsy()"

                    var fix = EasyFix.create(
                        id: "L:spipe_manual_assertions:{ctx.line_num}",
                        description: "replace manual if/fail with expect()",
                        confidence: FixConfidence.Likely
                    )
                    fix.add_replacement(Replacement.create(
                        file: file,
                        start: start,
                        end: end,
                        line: ctx.line_num,
                        column: ctx.indent + 1,
                        new_text: "{spaces}{expect_expr}"
                    ))
                    fixes.push(fix)

    fixes

# ============================================================================
# Rule 6: non_exhaustive_match
# Detects match blocks without a catch-all `case _:` arm.
# Confidence: Likely (the inserted arm is a placeholder to replace)
# ============================================================================

pub fn check_non_exhaustive_match(source: String, file: String) -> [EasyFix]:
    check_non_exhaustive_match_with_lines(file, source.split("\n"))

# Arms are `case P:` or bare `P:`; either form may be the catch-all (`case _:` / `_:`).
# Matches nest, so open matches live on a stack and a dedent closes them.
pub fn check_non_exhaustive_match_with_lines(file: String, lines: [String]) -> [EasyFix]:
    var fixes: [EasyFix] = []
    var indents: [i64] = []
    var arm_indents: [i64] = []
    var catch_alls: [bool] = []
    var case_styles: [bool] = []
    var end_lines: [i64] = []
    var end_offsets: [i64] = []
    var end_columns: [i64] = []
    var line_num = 0
    var byte_offset = 0

    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()
        val indent = line.len() - trimmed.len()
        val line_end = byte_offset + line.len()
        byte_offset = byte_offset + line.len() + 1
        if trimmed == "":
            continue
        # Dedent (or a sibling `match`) closes every open match at this indent or deeper.
        while indents.len() > 0 and indents[indents.len() - 1] >= indent:
            val top = indents.len() - 1
            if not catch_alls[top]:
                _emit_non_exhaustive_fix(fixes, file, end_lines[top], end_offsets[top], end_columns[top], arm_indents[top], not case_styles[top])
            indents.pop()
            arm_indents.pop()
            catch_alls.pop()
            case_styles.pop()
            end_lines.pop()
            end_offsets.pop()
            end_columns.pop()
        if indents.len() > 0:
            val top = indents.len() - 1
            if arm_indents[top] < 0:
                arm_indents[top] = indent
            if indent == arm_indents[top]:
                if trimmed.starts_with("case "):
                    case_styles[top] = true
                if trimmed.starts_with("case _:") or trimmed.starts_with("case _ ") or trimmed.starts_with("case _(") or trimmed.starts_with("_:") or trimmed.starts_with("_("):
                    catch_alls[top] = true
            end_lines[top] = line_num
            end_offsets[top] = line_end
            end_columns[top] = line.len() + 1
        if trimmed.starts_with("match ") and trimmed.ends_with(":"):
            indents.push(indent)
            arm_indents.push(-1)
            catch_alls.push(false)
            case_styles.push(false)
            end_lines.push(line_num)
            end_offsets.push(line_end)
            end_columns.push(line.len() + 1)

    # Matches still open at end of file
    while indents.len() > 0:
        val top = indents.len() - 1
        if not catch_alls[top]:
            _emit_non_exhaustive_fix(fixes, file, end_lines[top], end_offsets[top], end_columns[top], arm_indents[top], not case_styles[top])
        indents.pop()
        arm_indents.pop()
        catch_alls.pop()
        case_styles.pop()
        end_lines.pop()
        end_offsets.pop()
        end_columns.pop()

    fixes

fn _emit_non_exhaustive_fix(fixes: [EasyFix], file: String, after_line: Int, after_offset: Int, after_column: Int, case_indent: Int, bare: bool):
    val spaces = " ".repeat(case_indent)
    val inner_spaces = " ".repeat(case_indent + 4)
    val arm_head = if bare: "_" else: "case _"
    val new_arm = "\n{spaces}{arm_head}(\"remaining cases are not handled yet\"):\n{inner_spaces}todo(\"handle remaining cases\", \"replace this catch-all with explicit arms\")"
    var fix = EasyFix.create(
        id: "L:non_exhaustive_match:{after_line}",
        description: "add missing catch-all arm with todo()",
        confidence: FixConfidence.Likely
    )
    fix.add_replacement(Replacement.create(
        file: file,
        start: after_offset,
        end: after_offset,
        line: after_line,
        column: after_column,
        new_text: new_arm
    ))
    fixes.push(fix)
