# EasyFix Data Structures for Machine-Applicable Fixes
# Part of Simple Language Standard Library - Tooling Module

# ============================================================================
# EasyFixLint Levels and Categories
# ============================================================================

pub enum LintLevel:
    Allow
    Warn
    Deny

pub enum LintCategory:
    Safety      # Memory safety, null checks
    Correctness # Logic errors, type mismatches
    Warning     # Potential issues
    Style       # Code style recommendations
    Concurrency # Concurrency-related issues

# ============================================================================
# Fix Confidence Levels
# ============================================================================

pub enum FixConfidence:
    Certain    # Deterministic syntactic fix
    Safe       # Auto-apply without review
    Likely     # Probably correct, review recommended
    Uncertain  # May change semantics, needs human review

# ============================================================================
# Replacement: a single text substitution
# ============================================================================

pub class Replacement:
    file: String
    start: Int
    end: Int
    line: Int
    column: Int
    new_text: String

    static fn create(file: String, start: Int, end: Int, line: Int, column: Int, new_text: String) -> Replacement:
        Replacement(file: file, start: start, end: end, line: line, column: column, new_text: new_text)

    fn format() -> String:
        "{self.file}:{self.line}:{self.column} [{self.start}..{self.end}] -> \"{self.new_text}\""

# ============================================================================
# EasyFix: a machine-applicable fix for a diagnostic
# ============================================================================

pub class EasyFix:
    id: String
    description: String
    replacements: [Replacement]
    confidence: FixConfidence

    static fn create(id: String, description: String, confidence: FixConfidence) -> EasyFix:
        EasyFix(id: id, description: description, replacements: [], confidence: confidence)

    me add_replacement(replacement: Replacement):
        self.replacements.push(replacement)

    fn is_safe() -> Bool:
        match self.confidence:
            case Certain: true
            case Safe: true
            case _: false

    fn is_likely() -> Bool:
        match self.confidence:
            case Certain: true
            case Safe: true
            case Likely: true
            case _: false

    fn format() -> String:
        val header = "[{self.id}] {self.description} (confidence: {self.confidence_str()})"
        var parts = [header]
        for rep in self.replacements:
            parts.push("  " + rep.format())
        parts.join("\n")

    fn confidence_str() -> String:
        match self.confidence:
            case Certain: "certain"
            case Safe: "safe"
            case Likely: "likely"
            case Uncertain: "uncertain"

pub fn easyfix_id(fix: EasyFix) -> String:
    return fix.id

pub fn easyfix_description(fix: EasyFix) -> String:
    return fix.description

pub fn easyfix_replacements(fix: EasyFix) -> [Replacement]:
    return fix.replacements

# ============================================================================
# FixReport: result of applying fixes
# ============================================================================

pub class FixReport:
    applied: Int
    skipped: Int
    modified_files: [String]
    details: [String]

    static fn empty() -> FixReport:
        FixReport(applied: 0, skipped: 0, modified_files: [], details: [])

    fn format(dry_run: Bool) -> String:
        val prefix = if dry_run: "Would apply" else: "Applied"
        var parts = ["{prefix} {self.applied} fix(es):"]
        for detail in self.details:
            parts.push("  " + detail)
        if not self.modified_files.is_empty():
            val verb = if dry_run: "Would modify" else: "Modified"
            parts.push("{verb} {self.modified_files.len()} file(s):")
            for file in self.modified_files:
                parts.push("  " + file)
        parts.join("\n")

pub fn fixreport_applied(report: FixReport) -> Int:
    return report.applied

pub fn fixreport_details(report: FixReport) -> [String]:
    return report.details

# ============================================================================
# FixApplicator: applies fixes to source code (in-memory)
# ============================================================================

pub fn easyfix_sort_replacements_descending(replacements: [Replacement]) -> [Replacement]:
    if replacements.len() <= 1:
        return replacements
    var current = replacements
    var width = 1
    while width < current.len():
        var merged: [Replacement] = []
        var run_start = 0
        while run_start < current.len():
            var left_i = run_start
            val left_limit = run_start + width
            val left_end = if left_limit < current.len(): left_limit else: current.len()
            var right_i = left_end
            val right_limit = left_end + width
            val right_end = if right_limit < current.len(): right_limit else: current.len()
            while left_i < left_end and right_i < right_end:
                # Left-first equality is the stable same-offset contract.
                if current[left_i].start >= current[right_i].start:
                    merged.push(current[left_i])
                    left_i = left_i + 1
                else:
                    merged.push(current[right_i])
                    right_i = right_i + 1
            while left_i < left_end:
                merged.push(current[left_i])
                left_i = left_i + 1
            while right_i < right_end:
                merged.push(current[right_i])
                right_i = right_i + 1
            run_start = run_start + width + width
        current = merged
        width = width + width
    current

fn easyfix_replacement_ranges_fit_source(
    replacements: [Replacement], source_len: i64
) -> bool:
    for rep in replacements:
        if rep.start < 0 or rep.end < rep.start:
            return false
        if rep.start > source_len or rep.end > source_len:
            return false
    true

pub fn easyfix_apply_sorted_replacements(
    source: text, replacements: [Replacement]
) -> text:
    if not easyfix_replacement_ranges_fit_source(replacements, source.len()):
        var legacy_source = source
        for rep in replacements:
            if rep.start <= legacy_source.len() and rep.end <= legacy_source.len():
                legacy_source = (
                    legacy_source.slice(0, rep.start) + rep.new_text +
                    legacy_source.slice(rep.end))
        return legacy_source

    var parts: [text] = []
    var cursor = 0
    var index = replacements.len()
    while index > 0:
        index = index - 1
        val rep = replacements[index]
        parts.push(source.slice(cursor, rep.start))
        parts.push(rep.new_text)
        cursor = rep.end
    parts.push(source.slice(cursor))
    parts.join("")

pub class FixApplicator:
    static fn apply(fixes: [EasyFix], sources: Dict<String, String>) -> Result<Dict<String, String>, String>:
        # Group replacements by file
        var file_bucket_index: Dict<String, i64> = {}
        var replacement_buckets: [[Replacement]] = []

        for fix in fixes:
            val replacements_for_fix: [Replacement] = easyfix_replacements(fix)
            for rep in replacements_for_fix:
                if not file_bucket_index.has(rep.file):
                    file_bucket_index[rep.file] = replacement_buckets.len()
                    replacement_buckets.push([])
                val bucket = file_bucket_index[rep.file]
                replacement_buckets[bucket].push(rep)

        var results: Dict<String, String> = {}

        for file in file_bucket_index.keys():
            if not sources.has(file):
                return Err("File not found in sources: {file}")

            val source = sources[file]
            val replacements = easyfix_sort_replacements_descending(
                replacement_buckets[file_bucket_index[file]])

            # Check for overlapping spans
            var i = 0
            while i < replacements.len() - 1:
                val curr: Replacement = replacements[i]
                val next: Replacement = replacements[i + 1]
                # curr.start >= next.start (sorted descending)
                if next.end > curr.start:
                    return Err("Conflicting replacements in {file}: spans [{next.start}..{next.end}] and [{curr.start}..{curr.end}] overlap")
                i = i + 1

            results[file] = easyfix_apply_sorted_replacements(source, replacements)

        Ok(results)

    static fn filter_by_confidence(fixes: [EasyFix], min_confidence: FixConfidence) -> [EasyFix]:
        match min_confidence:
            case Certain:
                var out: [EasyFix] = []
                var i = 0
                while i < fixes.len():
                    val fix: EasyFix = fixes[i]
                    if fix.is_safe():
                        out = out.push(fix)
                    i = i + 1
                out
            case Safe:
                var out: [EasyFix] = []
                var i = 0
                while i < fixes.len():
                    val fix: EasyFix = fixes[i]
                    if fix.is_safe():
                        out = out.push(fix)
                    i = i + 1
                out
            case Likely:
                var out: [EasyFix] = []
                var i = 0
                while i < fixes.len():
                    val fix: EasyFix = fixes[i]
                    if fix.is_likely():
                        out = out.push(fix)
                    i = i + 1
                out
            case Uncertain:
                fixes

    static fn filter_by_id(fixes: [EasyFix], id_prefix: String) -> [EasyFix]:
        var out: [EasyFix] = []
        var i = 0
        while i < fixes.len():
            val fix: EasyFix = fixes[i]
            if easyfix_id(fix).starts_with(id_prefix):
                out = out.push(fix)
            i = i + 1
        out

# ============================================================================
# EasyFixLint: diagnostic with optional EasyFix
# ============================================================================

pub class EasyFixLint:
    code: String
    level: LintLevel
    category: LintCategory
    message: String
    fix_hint: Option<String>
    easy_fix: Option<EasyFix>

    fn with_fix(hint: String) -> EasyFixLint:
        EasyFixLint(
            code: self.code,
            level: self.level,
            category: self.category,
            message: self.message,
            fix_hint: Some(hint),
            easy_fix: self.easy_fix
        )

    fn with_easy_fix(fix: EasyFix) -> EasyFixLint:
        EasyFixLint(
            code: self.code,
            level: self.level,
            category: self.category,
            message: self.message,
            fix_hint: self.fix_hint,
            easy_fix: Some(fix)
        )

    fn has_easy_fix() -> Bool:
        match self.easy_fix:
            case Some(_): true
            case nil: false

# ============================================================================
# EasyFixLintResult: diagnostic result with location
# ============================================================================

pub class EasyFixLintResult:
    file_path: String
    line: Int
    column: Int
    lint: EasyFixLint

    fn format() -> String:
        var level_str = "unknown"
        match self.lint.level:
            case Allow:
                level_str = "allow"
            case Warn:
                level_str = "warning"
            case Deny:
                level_str = "error"

        var output = self.file_path + ":" + self.line.to_string() + ":" + self.column.to_string() + ": " + level_str + "[" + self.lint.code + "]: " + self.lint.message

        match self.lint.fix_hint:
            case Some(hint):
                output = output + "\n  hint: " + hint
            case nil:
                val _ = 0

        match self.lint.easy_fix:
            case Some(fix):
                output = output + "\n  fix: available [{fix.id}] ({fix.confidence_str()})"
            case nil:
                val _ = 0

        output

    fn has_easy_fix() -> Bool:
        self.lint.easy_fix.? == true

# Export all types
