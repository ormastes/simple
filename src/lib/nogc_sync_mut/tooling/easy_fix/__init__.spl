# EasyFix Module - Machine-applicable fixes for Simple diagnostics
# Re-exports types and rule check functions

# Flat-AST-compatible re-exports. `export X from module` loses `module` in
# the current bridge, so use explicit import-form re-exports.
export use .types.{LintLevel, LintCategory, FixConfidence, Replacement, EasyFix, FixReport, FixApplicator, EasyFixLint, EasyFixLintResult, easyfix_sort_replacements_descending, easyfix_apply_sorted_replacements}
