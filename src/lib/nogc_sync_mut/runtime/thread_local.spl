"""
# Thread-Local Runtime Backend

No-GC sync owner for low-level thread-local storage runtime hooks shared by
family-specific allocator adapters.
"""

extern fn rt_thread_local_new() -> i64
@unsafe(reason: "raw i64 TLS ABI is distinct from tagged RuntimeValue TLS", capabilities: [ffi])
extern fn rt_thread_local_get_i64(tls: i64) -> i64
@unsafe(reason: "raw i64 TLS ABI is distinct from tagged RuntimeValue TLS", capabilities: [ffi])
extern fn rt_thread_local_set_i64(tls: i64, value: i64)
extern fn rt_thread_local_free(tls: i64)

# Compatibility names for scalar clients. They must never call the tagged
# RuntimeValue ABI exported under the same names by generic ThreadLocal<T>.
fn rt_thread_local_get(tls: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_thread_local_get_i64(tls)

fn rt_thread_local_set(tls: i64, value: i64):
    unsafe(capabilities: [ffi]):
        rt_thread_local_set_i64(tls, value)

export rt_thread_local_new, rt_thread_local_get, rt_thread_local_set, rt_thread_local_free
export rt_thread_local_get_i64, rt_thread_local_set_i64
