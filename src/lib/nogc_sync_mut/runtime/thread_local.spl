"""
# Thread-Local Runtime Backend

No-GC sync owner for low-level thread-local storage runtime hooks shared by
family-specific allocator adapters.

Native C ABI: raw i64 values, zero for unset/invalid/freed handles. Setting
zero clears a value. The bounded provider supports 128 simultaneous handles
and returns zero on exhaustion; callers must check new handles. Free invalidates
all threads without destroying caller-owned payloads. Handles include a
generation so recycling a slot cannot reveal stale values. This differs from
the Rust interpreter's tagged RuntimeValue interface (whose NIL is tagged).
"""

extern fn rt_thread_local_new() -> i64
extern fn rt_thread_local_get(tls: i64) -> i64
extern fn rt_thread_local_set(tls: i64, value: i64)
extern fn rt_thread_local_free(tls: i64)

export rt_thread_local_new, rt_thread_local_get, rt_thread_local_set, rt_thread_local_free
