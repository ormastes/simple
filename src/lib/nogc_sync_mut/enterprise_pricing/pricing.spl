"""
# Enterprise Pricing / Discounts — deterministic, float-free discount engine

Pricing vertical of the Simple Enterprise Suite over the durable enterprise
store, following the FROZEN foundation contracts (`enterprise_sale/foundation.spl`
is never edited). One guarded write configures a named discount rule; pure reads
apply the LATEST rule with EXACT integer minor-unit arithmetic — never floats.

## Storage model (insert-only + pure fold)

Discount rules are insert-only rows in `pricing_discounts (tenant_id, code,
kind, value, set_by)`. There is no UPDATE: a redefine appends a new row, and the
EFFECTIVE rule for a (tenant, code) is the LATEST row by insert order, derived by
a pure fold (`discount_effective`). Rules are per-tenant: the fold filters on the
session's authoritative tenant id, so tenant B's price compute can never read
tenant A's rules.

## Discount kinds

- `percent_bp` — a percentage discount in integer BASIS POINTS (bp): 1 bp =
  0.01% = 1/10000. A 15% discount is 1500 bp.
- `fixed_cents` — a flat amount, subtracted from the base price in integer minor
  units (cents).

## Rounding rule (documented, deterministic)

For a `percent_bp` rule the discount amount is
`round_half_up(base_cents * value_bp / 10000)`, computed on integers as

    (base_cents * value_bp + 5000) / 10000        # 5000 == 10000/2

For non-negative `base_cents` and `value_bp` this is exact round-HALF-UP on the
minor unit: a fractional part of exactly 0.5 rounds AWAY from zero (up). Example:
1000 cents at 875 bp = 87.5 cents exactly, which rounds to 88 (the boundary case
the spec asserts); 1000 cents at 874 bp = 87.4 truncates down to 87. A
`fixed_cents` rule subtracts its integer value directly (no rounding needed).

## Floor-at-zero clamp (documented)

A discount never makes a price negative. `price_after_discount` computes
`base_cents - discount` and CLAMPS the result at 0: a percent or fixed discount
that exceeds the base yields a final price of exactly 0, never a negative value.
An unknown code (no rule ever defined) leaves the base price unchanged.

## RBAC (reuse, not a new grant)

`discount_define` REUSES the existing `sales` role (and blanket `admin`) via the
LOCAL `pricing_role_allows` gate for the `pricing.discount.define` action. The
frozen `role_allows` table is NOT edited, and `enterprise_sale/rbac_registry.spl`
is deliberately NOT touched. The frozen session -> rbac -> validation ->
idempotency -> effects SEQUENCE is preserved exactly. Audit hashing goes only
through `records.audit_append` (the `enterprise_store.audit_hash.audit_sha256_hex`
facade) — this module never imports `std.common.crypto.sha256`.

Lane: .spipe/simple_enterprise_suite (W21-D).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, Money,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema — insert-only discount rows
# =============================================================================

fn pricing_setup(store: EnterpriseStore) -> bool:
    store_migrate(store, "pricing_001_discounts",
        "CREATE TABLE IF NOT EXISTS pricing_discounts (id INTEGER PRIMARY KEY, tenant_id TEXT, code TEXT, kind TEXT, value TEXT, set_by TEXT)")

# =============================================================================
# RBAC — reuse the sales role (see module docstring)
# =============================================================================

# pricing_role_allows gates discount configuration. admin passes for everything
# (matching the frozen blanket rule); the sales role is REUSED for price-list
# management actions.
fn pricing_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "sales":
        return action == "pricing.discount.define"
    false

# =============================================================================
# Effective rule — pure fold over insert-only rows
# =============================================================================

# A folded discount rule for a (tenant, code). `found` is false when no rule has
# ever been defined for the code (unknown code -> base price unchanged).
struct DiscountRule:
    found: bool
    kind: text
    value: i64

# discount_effective folds the insert-only rows and returns the LATEST rule (by
# insert order) for (tenant, code), or a not-found rule when none exists. Filters
# on tenant_id — the per-tenant isolation seam.
fn discount_effective(store: EnterpriseStore, tenant_id: text, code: text) -> DiscountRule:
    var rule = DiscountRule(found: false, kind: "", value: 0)
    val rows = store_rows(store, "pricing_discounts", "id, tenant_id, code, kind, value, set_by")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "code") == code:
            rule = DiscountRule(found: true, kind: sqlite_row_get(row, "kind"), value: int(sqlite_row_get(row, "value")))
    rule

# =============================================================================
# Pure compute — deterministic, float-free (see rounding + clamp rules)
# =============================================================================

# pricing_percent_discount applies value_bp basis points to base_cents with
# round-half-up on the minor unit. Non-positive base or rate yields 0.
fn pricing_percent_discount(base_cents: i64, value_bp: i64) -> i64:
    if base_cents <= 0 or value_bp <= 0:
        return 0
    (base_cents * value_bp + 5000) / 10000

# pricing_apply_rule computes the final price for a base amount under a rule,
# clamping the result at 0 (a discount never makes a price negative). An
# unknown/not-found rule leaves the base unchanged.
fn pricing_apply_rule(base_cents: i64, rule: DiscountRule) -> i64:
    if not rule.found:
        return base_cents
    var discount: i64 = 0
    if rule.kind == "percent_bp":
        discount = pricing_percent_discount(base_cents, rule.value)
    elif rule.kind == "fixed_cents":
        discount = rule.value
    if discount < 0:
        discount = 0
    val final = base_cents - discount
    if final < 0:
        return 0
    final

# price_after_discount is a pure read gated by session validity: it applies the
# session-tenant's LATEST rule for `code` to `base` with the documented rounding
# and floor-at-zero clamp. An invalid session, or an unknown code, yields the
# base price unchanged in the amount's currency.
fn price_after_discount(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, base: Money, code: text) -> Money:
    if not session_valid(session, tenant, who):
        return base
    val rule = discount_effective(store, session.tenant_id, code)
    Money(amount_cents: pricing_apply_rule(base.amount_cents, rule), currency: base.currency)

# =============================================================================
# Guarded command (frozen sequence)
# =============================================================================

# discount_define records a new discount rule for `code` under the session's
# tenant. Runs the frozen sequence session -> rbac -> validation -> idempotency
# -> effects in one UoW. Insert-only: a redefine appends a new row and the latest
# wins. A replayed idempotency key returns the recorded result with no second
# effect. `kind` must be percent_bp or fixed_cents; value must be non-negative.
fn discount_define(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, code: text, kind: text, value: i64) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", code)
    # 2. rbac (reuse sales/admin)
    if not pricing_role_allows(who.role, "pricing.discount.define"):
        return denied("forbidden", code)
    # 3. domain validation — non-empty code, known kind, non-negative value.
    if code == "" or (kind != "percent_bp" and kind != "fixed_cents") or value < 0:
        return denied("invalid-record", code)
    # 4. idempotency — a replay returns the recorded outcome, no new effect.
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects — one unit of work
    val detail = code + "/" + kind + ":{value}"
    uow_begin(store)
    if not store_insert_row(store,
        "INSERT INTO pricing_discounts (tenant_id, code, kind, value, set_by) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, code, kind, "{value}", who.actor_id]):
        uow_rollback(store)
        return denied("store-error", detail)
    outbox_append(store, tenant.tenant_id, "pricing.discount.define", detail)
    audit_append(store, tenant.tenant_id, who.actor_id, "pricing.discount.define", detail)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, detail)
    uow_commit(store)
    accepted(detail)

export pricing_setup
export pricing_role_allows
export DiscountRule, discount_effective
export pricing_percent_discount, pricing_apply_rule, price_after_discount
export discount_define
