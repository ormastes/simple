# Read-only capability dispatch. These methods return launch DATA or observed
# native evidence; they cannot publish a grant, spawn, or expose a writer.
use std.nogc_sync_mut.container.machine_fresh_workload_dispatch_v3.*
use std.nogc_sync_mut.container.machine_fresh_workspace_record_v3.machine_fresh_workspace_binding_bytes_v3
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxFreshEpochSuccessorCustodyV1
use std.nogc_sync_mut.io.linux_fresh_workspace_binding_v3.LinuxFreshWorkspaceBindingV3
use std.common.contracts.container.linux_fresh_workload_v2.{LinuxFreshWorkloadCommandV2, LinuxFreshWorkloadClosureV2}
use std.common.contracts.container.linux_fresh_workspace_v3.LinuxFreshWorkspaceCommandV3
use std.common.build_manager.group_process_stream_protocol_v2.GroupProcessStreamLaunchV2

pub fn machine_fresh_workspace_native_binding_v3(record: MachineFreshWorkloadRecordDispatchV3,
        binding: Option<LinuxFreshWorkspaceBindingV3>) -> Result<LinuxFreshWorkspaceBindingV3, text>:
    val workspace = machine_fresh_record_workspace_v3(record)?
    if binding.is_none(): return Err("machine-fresh-workspace-native-binding-missing")
    val owner = binding.unwrap()
    val actual = owner.current_v3()?
    if machine_fresh_workspace_binding_bytes_v3(actual)? != machine_fresh_workspace_binding_bytes_v3(workspace.binding)?:
        return Err("machine-fresh-workspace-native-binding-changed")
    Ok(owner)

pub fn machine_fresh_launch_bind_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        record: MachineFreshWorkloadRecordDispatchV3, binding: Option<LinuxFreshWorkspaceBindingV3>,
        command: LinuxFreshWorkloadCommandV2, template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    match record:
        case MachineFreshWorkloadRecordDispatchV3.CpuV2(_):
            if binding.is_some(): return Err("machine-fresh-workload-cpu-binding-mismatch")
            custody.bind_workload_launch_v2(command, template)
        case MachineFreshWorkloadRecordDispatchV3.WorkspaceV3(_):
            custody.bind_workspace_launch_v3(machine_fresh_workspace_native_binding_v3(record, binding)?,
                LinuxFreshWorkspaceCommandV3(command: command), template)

pub fn machine_fresh_launch_validate_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        record: MachineFreshWorkloadRecordDispatchV3, binding: Option<LinuxFreshWorkspaceBindingV3>,
        command: LinuxFreshWorkloadCommandV2, template: GroupProcessStreamLaunchV2) -> Result<(), text>:
    match record:
        case MachineFreshWorkloadRecordDispatchV3.CpuV2(_):
            if binding.is_some(): return Err("machine-fresh-workload-cpu-binding-mismatch")
            custody.validate_workload_launch_v2(command, template)
        case MachineFreshWorkloadRecordDispatchV3.WorkspaceV3(_):
            custody.validate_workspace_launch_v3(machine_fresh_workspace_native_binding_v3(record, binding)?,
                LinuxFreshWorkspaceCommandV3(command: command), template)

pub fn machine_fresh_created_validate_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        record: MachineFreshWorkloadRecordDispatchV3, binding: Option<LinuxFreshWorkspaceBindingV3>,
        command: LinuxFreshWorkloadCommandV2, output: text) -> Result<(), text>:
    match record:
        case MachineFreshWorkloadRecordDispatchV3.CpuV2(_):
            if binding.is_some(): return Err("machine-fresh-workload-cpu-binding-mismatch")
            custody.validate_workload_created_config_v2(command, output)
        case MachineFreshWorkloadRecordDispatchV3.WorkspaceV3(_):
            custody.validate_workspace_created_config_v3(machine_fresh_workspace_native_binding_v3(record, binding)?,
                LinuxFreshWorkspaceCommandV3(command: command), output)

pub fn machine_fresh_absence_observe_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        record: MachineFreshWorkloadRecordDispatchV3, binding: Option<LinuxFreshWorkspaceBindingV3>,
        command: LinuxFreshWorkloadCommandV2) -> Result<LinuxFreshWorkloadClosureV2, text>:
    match record:
        case MachineFreshWorkloadRecordDispatchV3.CpuV2(_):
            if binding.is_some(): return Err("machine-fresh-workload-cpu-binding-mismatch")
            custody.observe_workload_absence_v2(command)
        case MachineFreshWorkloadRecordDispatchV3.WorkspaceV3(_):
            custody.observe_workspace_absence_v3(machine_fresh_workspace_native_binding_v3(record, binding)?,
                LinuxFreshWorkspaceCommandV3(command: command))
