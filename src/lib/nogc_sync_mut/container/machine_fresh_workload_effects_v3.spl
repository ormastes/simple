# INTERNAL implementation of the original sealed transfer. No context factory,
# writer getter or standalone admission is exposed. Only that owner passes its
# original opaque storage/custody/lifecycle after current/generation checks.
# All rows derive from the retained canonical request; publication and permit
# consumption precede the existing native spawn. This is the SAME writer.
use std.nogc_sync_mut.io.machine_storage_owner_v1.MachineStorageOwnerV1
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxFreshEpochSuccessorCustodyV1
use std.nogc_sync_mut.container.machine_fresh_workload_lifecycle_v2.*
use std.nogc_sync_mut.container.machine_fresh_workload_history_v2.*
use std.nogc_sync_mut.container.machine_fresh_workload_record_v2.*
use std.nogc_sync_mut.container.machine_fresh_workspace_record_v3.*
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.MachineFreshEpochRecordV1
use std.nogc_sync_mut.io.linux_fresh_workspace_binding_v3.LinuxFreshWorkspaceBindingV3
use std.common.contracts.container.execution_v2.{ContainerExecutionRequestV2, ContainerHostScopeV2}
use std.common.contracts.container.local_principal_v1.MachineLocalPrincipalSnapshotV1
use std.common.build_manager.group_process_stream_protocol_v2.GroupProcessStreamLaunchV2
use std.nogc_sync_mut.container.machine_fresh_workload_dispatch_v3.*
use std.nogc_sync_mut.container.machine_fresh_workload_native_dispatch_v3.*
use std.nogc_sync_mut.container.machine_fresh_workload_inspect_v2.*
use std.nogc_sync_mut.container.machine_fresh_workload_exited_settlement_v3.machine_fresh_workload_exited_cohort_command_v3
use std.nogc_sync_mut.container.machine_fresh_workload_exit_edges_v3.{MachineFreshWorkloadCohortRetryV3,
    machine_fresh_workload_exited_cohort_retry_v3, machine_fresh_workload_association_exit_v3}
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.common.contracts.container.effect_deadline_v1.*
use std.common.contracts.container.workspace_preparation_window_v3.container_workspace_launch_expiry_v3
use std.common.contracts.distributed_operation_state_v2.*
use std.common.build_manager.group_process_stream_protocol_v2.group_process_stream_template_encode_v3
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.io.time_ops.{time_sample_unix_micros_or_failure, time_sample_monotonic_nanos_or_failure, sleep_ms}
use std.nogc_sync_mut.io.process_ops.{process_spawn_piped_owned_v2, PipedProcessOwnedSpawnV2}
use std.nogc_sync_mut.io.group_process_owner.{group_process_stream_poll_v2, group_process_stream_terminal_v2}
use std.nogc_sync_mut.database.wal.WalEntry
use std.nogc_sync_mut.io.dir_entry_ops.dir_create_private_exclusive_v1
use std.common.contracts.container.linux_fresh_workload_probe_v3.{linux_fresh_workload_read_action_v3, linux_fresh_workload_read_command_v3, linux_fresh_workload_wait_exit_code_v3}
use std.nogc_sync_mut.io.linux_fresh_workload_probe_launch_v3.{linux_fresh_workload_probe_bind_v3, linux_fresh_workload_probe_validate_v3}

pub(package) fn workload_publish_v3(storage: MachineStorageOwnerV1, state: MachineFreshWorkloadLifecycleV2,
        entries: [WalEntry]) -> Result<(), text>:
    val live = state.live_v2()?
    val before = machine_fresh_workload_history_verify_v2(storage, state.history_v2()?)?
    val pending = state.publication_pending_v2()?
    val committed = storage.wal_commit_v1(machine_fresh_workload_head_v2(state.history_v2()?), entries)?
    val retained = state.committed_v2(committed, entries)?
    val replayed = machine_fresh_workload_history_verify_v2(storage, state.history_v2()?)?
    state.publication_verified_v2()

# One begin path; only the launch binding differs. A `wait`/`logs` read is the
# CPU record's own retained Inspect identity re-projected by the existing closed
# probe projector (fixed `<verb> -- <native id>` tail). A workspace record, a
# workspace binding or any non-Inspect action is refused before any row.
fn workload_launch_bind_v3(custody: LinuxFreshEpochSuccessorCustodyV1, record: MachineFreshWorkloadRecordDispatchV3,
        binding: Option<LinuxFreshWorkspaceBindingV3>, command: LinuxFreshWorkloadCommandV2, name: text,
        template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
    if linux_fresh_workload_read_action_v3(name).is_err():
        return machine_fresh_launch_bind_v3(custody, record, binding, command, template)
    val cpu_only = machine_fresh_record_cpu_v3(record)?
    if binding.is_some(): return Err("machine-fresh-workload-cpu-binding-mismatch")
    linux_fresh_workload_probe_bind_v3(custody, linux_fresh_workload_read_command_v3(command, name)?, template)

fn workload_launch_validate_v3(custody: LinuxFreshEpochSuccessorCustodyV1, record: MachineFreshWorkloadRecordDispatchV3,
        binding: Option<LinuxFreshWorkspaceBindingV3>, command: LinuxFreshWorkloadCommandV2, name: text,
        launch: GroupProcessStreamLaunchV2) -> Result<(), text>:
    if linux_fresh_workload_read_action_v3(name).is_err():
        return machine_fresh_launch_validate_v3(custody, record, binding, command, launch)
    val cpu_only = machine_fresh_record_cpu_v3(record)?
    if binding.is_some(): return Err("machine-fresh-workload-cpu-binding-mismatch")
    linux_fresh_workload_probe_validate_v3(custody, linux_fresh_workload_read_command_v3(command, name)?, launch)

pub(package) fn machine_fresh_workload_begin_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2,
        custody_generation: i64, action: LinuxFreshWorkloadActionV2, name: text,
        deadline: Option<ContainerEffectDeadlineV1>) -> Result<(), text>:
    val record = state.record_v3()?
    val view = machine_fresh_record_view_v3(record)
    if (action == LinuxFreshWorkloadActionV2.PullImage or action == LinuxFreshWorkloadActionV2.Create or action == LinuxFreshWorkloadActionV2.Start) and machine_fresh_record_workspace_v3(record).is_ok():
        val context = (state.source_custody_v3()?).context_v3()?
        val monotonic = time_sample_monotonic_nanos_or_failure()
        if monotonic <= 0 or monotonic >= context.1: return Err("linux-workspace-original-preparation-expired")
    val now = time_sample_unix_micros_or_failure() / 1000
    if now <= 0 or now > 9223372036854770807: return Err("machine-fresh-workload-clock")
    var expiry = now + 5000
    if action == LinuxFreshWorkloadActionV2.Create or action == LinuxFreshWorkloadActionV2.Start or action == LinuxFreshWorkloadActionV2.PullImage:
        if deadline.is_none(): return Err("machine-fresh-workload-launch-window-required")
        val remaining = container_effect_remaining_ms_v1(deadline.unwrap(), view.request.plan.request_digest,
            view.request.plan.operation_id, if action == LinuxFreshWorkloadActionV2.PullImage: "create" else: name, now)?
        if remaining < 5000: expiry = deadline.unwrap().expires_at_unix_ms
    val command = state.command_v2(action, name)?
    var template = state.template_v2()?
    template.root = template.root + "-" + name
    # milestone_0021 3.4 step 4 (r7 X-01): the begin itself creates (or adopts an empty private) action directory
    # BEFORE the bind, action_begin_v2 and the publish, so a refusal is a pre-row Err (nothing published, not Unknown).
    dir_create_private_exclusive_v1(template.root)?
    state.record_helper_dir_v3(template.root)?
    val binding = state.workspace_binding_option_v3()?
    var launch = workload_launch_bind_v3(custody, record, binding, command, name, template)?
    val valid = workload_launch_validate_v3(custody, record, binding, command, name, launch)?
    val wire = group_process_stream_template_encode_v3(launch)?
    val states = state.action_begin_v2(name, custody_generation)?
    val continuation = state.helper_continuation_begin_v3(action, command.timeout_ms)?
    val rows = machine_fresh_record_action_batch_entries_v3(record, states, state.native_id_v2()?, wire, now)?
    val committed = workload_publish_v3(storage, state, rows)?
    val revalidated = workload_launch_validate_v3(custody, record, binding, command, name, launch)?
    # This gate is AFTER potentially delayed binding/publication/readback and
    # immediately BEFORE irreversible consumption and the existing native call.
    # Native launch repeats its checked, conservatively capped wall deadline.
    if (action == LinuxFreshWorkloadActionV2.PullImage or action == LinuxFreshWorkloadActionV2.Create or action == LinuxFreshWorkloadActionV2.Start) and machine_fresh_record_workspace_v3(record).is_ok():
        val original = (state.source_custody_v3()?).launch_window_v3()?
        val before = time_sample_monotonic_nanos_or_failure()
        val wall = time_sample_unix_micros_or_failure() / 1000
        val after = time_sample_monotonic_nanos_or_failure()
        expiry = container_workspace_launch_expiry_v3(expiry, original.0, original.1, before, wall, after)?
    val consumed = state.consume_action_v2()?
    launch.request.launch_deadline_unix_ms = expiry
    # Every actual native output is captured before any fallible inspection.
    match process_spawn_piped_owned_v2(launch):
        case PipedProcessOwnedSpawnV2.Ready(owner, reference): state.capture_v2(owner, Some(reference))
        case PipedProcessOwnedSpawnV2.CleanupRequired(owner, reference, reason):
            state.capture_v2(owner, reference)
            # A fast completed CLI remains a real owned stream. The literal
            # selects this branch only; actual native binding, terminal state,
            # full EOF and positive retirement are still required below.
            var observed_terminal = false
            if reason == "process_stream_already_terminal" and reference.is_some():
                val polled = group_process_stream_poll_v2(owner)
                if polled.is_ok() and polled.unwrap().terminal:
                    val terminal = group_process_stream_terminal_v2(owner)
                    if terminal.is_ok() and not terminal.unwrap().0.cancelled and not terminal.unwrap().0.timed_out:
                        observed_terminal = true
            if not observed_terminal:
                val retained = state.unknown_v2(reason)?
                return Err(reason)
        case PipedProcessOwnedSpawnV2.Rejected(reason):
            val retained = state.rejected_v2(reason)?
            return Err(reason)
    val observed = state.validate_process_v2(wire)
    if observed.is_err():
        val retained = state.unknown_v2(observed.unwrap_err())?
        return Err(observed.unwrap_err())
    Ok(())

pub(package) fn machine_fresh_workload_complete_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2,
        result: MachineFreshWorkloadActionResultV2) -> Result<MachineFreshWorkloadActionResultV2, text>:
    val pending = state.helper_continuation_v3()?
    val name = pending.1
    val record = state.record_v3()?
    val binding = state.workspace_binding_option_v3()?
    val command = state.command_v2(pending.0, name)?
    if name == "inspect-created":
        val created = machine_fresh_created_validate_v3(custody, record, binding, command, result.output)?
    var native_id = state.native_id_v2()?
    if name == "pull-image":
        val image_id = machine_fresh_workload_image_id_v2(result.output)?
        if result.exit_code != 0: return Err("machine-fresh-workload-image-pull-unconfirmed")
    elif name == "create":
        native_id = result.output.trim()
        if (result.exit_code != 0 or not builder_digest_valid_v1(native_id) or
                (result.output != native_id and result.output != native_id + "\n" and result.output != native_id + "\r\n")):
            val retained = state.unknown_v2("machine-fresh-workload-create-unconfirmed")?
            return Err("machine-fresh-workload-create-unconfirmed")
    # N7: a non-zero engine exit on the exit READ is retained as typed Unknown by the workflow, not latched.
    elif (name == "absence" and not machine_fresh_workload_absence_v2(result.exit_code, result.output)) or (name != "absence" and name != "inspect-exit" and result.exit_code != 0):
        val retained = state.unknown_v2("machine-fresh-workload-command-failed")?
        return Err("machine-fresh-workload-command-failed")
    # A `wait` helper that exited 0 must have printed one canonical payload exit status.
    if name == "wait":
        val payload = linux_fresh_workload_wait_exit_code_v3(result.output)
        if payload.is_err():
            val retained = state.unknown_v2(payload.unwrap_err())?
            return Err(payload.unwrap_err())
    val retired = state.retire_helper_v2()?
    val prior = state.action_state_v2(name)?
    val completed = distributed_operation_transition_v2(prior, "completed", sha256_text(str(result.exit_code) + "\n" + result.output))?
    val at = time_sample_unix_micros_or_failure() / 1000
    val published = workload_publish_v3(storage, state, machine_fresh_record_action_entries_v3(record, completed, native_id, result.output, at)?)?
    val tracked = state.complete_v2(completed, native_id)?
    Ok(result)

pub(package) fn machine_fresh_workload_run_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2,
        custody_generation: i64, action: LinuxFreshWorkloadActionV2, name: text,
        deadline: Option<ContainerEffectDeadlineV1>) -> Result<MachineFreshWorkloadActionResultV2, text>:
    val begun = machine_fresh_workload_begin_v3(storage, custody, state, custody_generation, action, name, deadline)?
    val command = state.command_v2(action, name)?
    val result = state.collect_v2(command.timeout_ms)?
    machine_fresh_workload_complete_v3(storage, custody, state, result)

# One bounded read/poll per continuation. The original monotonic deadline is
# installed before the original spawn and cannot be extended by repeated step.
pub(package) fn machine_fresh_workload_progress_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2) -> Result<Option<MachineFreshWorkloadActionResultV2>, text>:
    val pending = state.helper_continuation_v3()?
    val now = time_sample_monotonic_nanos_or_failure()
    if now <= 0 or now >= pending.2:
        val retained = state.unknown_v2("machine-fresh-workload-command-outcome-unknown")?
        return Err(state.diagnostic_v2()?)
    val observed = state.after_action_v2(state.drain_v2())?
    if not observed.complete: return Ok(nil)
    val completed = state.after_action_v2(machine_fresh_workload_complete_v3(storage, custody, state, observed))?
    Ok(Some(completed))

# The workload exited during association (CPU V2 records only; a workspace sample is never `Exited`).
# `capture_error` is "" when the subject was captured and the confirmation is already retained; otherwise
# the pid was gone before capture and the once-only confirmation is run here. The reducer decides from the
# owner's own two retained samples and its own retained descriptor. On its Ok every descriptor is released
# and the start is an exited start (exited_start_v3); it is never associated. Every Err, including a
# descriptor that does not close, returns through after_association_v2 and latches as before.
fn workload_association_exit_v3(storage: MachineStorageOwnerV1, custody: LinuxFreshEpochSuccessorCustodyV1,
        state: MachineFreshWorkloadLifecycleV2, custody_generation: i64, capture_error: text) -> Result<(), text>:
    val record = state.record_v3()?
    val id = state.native_id_v2()?
    if capture_error != "":
        if machine_fresh_record_cpu_v3(record).is_err(): return Err(capture_error)
        val again = machine_fresh_workload_run_v3(storage, custody, state, custody_generation, LinuxFreshWorkloadActionV2.Inspect, "inspect-confirm", None)?
    val first = machine_fresh_record_start_evidence_v3(record, id, state.output_v2("inspect")?)?
    val confirmed = machine_fresh_record_start_evidence_v3(record, id, state.output_v2("inspect-confirm")?)?
    val proven = machine_fresh_workload_association_exit_v3(first, confirmed, capture_error, state.held_subject_v3()?)?
    state.release_exited_containment_v3()

pub(package) fn machine_fresh_workload_associate_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2,
        custody_generation: i64) -> Result<(), text>:
    val record = state.record_v3()?
    val id = state.native_id_v2()?
    # A workload that already exited has no process to capture, so it is never associated. Its start is
    # proven only by this sample and one confirmation agreeing; the caller derives that from the retained
    # outputs (exited_start_v3). A disagreeing confirmation latches like every other association failure.
    val evidence_before = machine_fresh_record_start_evidence_v3(record, id, state.output_v2("inspect")?)?
    if evidence_before == MachineFreshWorkloadStartEvidenceV3.NeverStarted: return Err("machine-fresh-workload-running-unproven")
    if evidence_before == MachineFreshWorkloadStartEvidenceV3.Exited:
        val again = machine_fresh_workload_run_v3(storage, custody, state, custody_generation, LinuxFreshWorkloadActionV2.Inspect, "inspect-confirm", None)?
        val evidence_after = machine_fresh_record_start_evidence_v3(record, id, again.output)?
        if not machine_fresh_workload_exited_start_confirmed_v3(evidence_before, evidence_after):
            return Err("machine-fresh-workload-start-evidence-changed")
        return Ok(())
    val before = machine_fresh_record_inspect_v3(record, id, state.output_v2("inspect")?)?
    val binding = sha256_text(machine_fresh_record_id_v3(record)? + "\n" + id + "\n" + state.output_v2("inspect")?)
    val captured = state.capture_subject_v2(before, binding)
    if captured.is_err(): return workload_association_exit_v3(storage, custody, state, custody_generation, captured.unwrap_err())
    val confirmed = machine_fresh_workload_run_v3(storage, custody, state, custody_generation, LinuxFreshWorkloadActionV2.Inspect, "inspect-confirm", nil)?
    val exit_evidence = machine_fresh_record_start_evidence_v3(record, id, confirmed.output)
    if exit_evidence.is_ok() and exit_evidence.unwrap() == MachineFreshWorkloadStartEvidenceV3.Exited:
        return workload_association_exit_v3(storage, custody, state, custody_generation, "")
    val after = machine_fresh_record_inspect_v3(record, id, confirmed.output)?
    val command = machine_fresh_record_command_v3(record, LinuxFreshWorkloadActionV2.Inspect, id)?
    val evidence = state.validate_subject_v2(custody, command, before, after)?
    val committed = workload_publish_v3(storage, state, machine_fresh_record_association_entries_v3(record, id, evidence, time_sample_unix_micros_or_failure() / 1000)?)?
    state.associated_v2()


pub(package) fn machine_fresh_workload_settle_cpu_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2) -> Result<(), text>:
    if state.settled_v2()?: return Ok(())
    val record = state.record_v3()?
    val cpu_only = machine_fresh_record_cpu_v3(record)?
    val absence = state.action_state_v2("absence")?
    if absence.state != "completed": return Err("machine-fresh-workload-absence-unproven")
    val command = machine_fresh_record_command_v3(record, LinuxFreshWorkloadActionV2.Absence, state.native_id_v2()?)?
    val native = machine_fresh_absence_observe_v3(custody, record, state.workspace_binding_option_v3()?, command)?
    val bound = state.validate_closure_v2(native)?
    val committed = workload_publish_v3(storage, state, state.prepare_settlement_v2(record, absence, time_sample_unix_micros_or_failure() / 1000)?)?
    state.mark_settled_v2()


# Exited-start sibling of machine_fresh_workload_settle_cpu_v3 (which stays byte-unchanged and still refuses a
# start with no captured subject). No native subject exists to close against, so the release rests on the
# owner's own retained exited samples, its own completed Stop/Remove/Absence, and custody's kernel-side
# whole-cohort-empty sample taken here, after them. A non-empty cohort or an unbound sample is a plain refusal:
# nothing is latched, the charge stays retained and destroy may retry. Engine text never releases the charge.
pub(package) fn machine_fresh_workload_settle_exited_start_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2) -> Result<(), text>:
    if state.settled_v2()?: return Ok(())
    val record = machine_fresh_record_cpu_v3(state.record_v3()?)?
    if not state.exited_start_v3()?: return Err("machine-fresh-workload-exited-start-unproven")
    val absence = state.action_state_v2("absence")?
    if absence.state != "completed": return Err("machine-fresh-workload-absence-unproven")
    val closure = custody.observe_probe_absence_v3(machine_fresh_workload_exited_cohort_command_v3(record, state.native_id_v2()?)?)?
    val rows = state.prepare_exited_settlement_v3(absence, closure, time_sample_unix_micros_or_failure() / 1000)?
    val committed = workload_publish_v3(storage, state, rows)?
    state.mark_settled_v2()

# Bounded sibling of machine_fresh_workload_settle_exited_start_v3 (which stays unchanged). The engine's own
# helpers for a container that just exited are still leaving the cohort for a moment after Remove, and the
# census refuses while they do. Each attempt is the whole settle above with a new full census; only the
# census refusals the reducer names are repeated, and only inside its attempt and time bound. Nothing is
# latched: at the bound the caller gets the named retryable refusal and may call destroy or cleanup again.
pub(package) fn machine_fresh_workload_settle_exited_start_bounded_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2) -> Result<(), text>:
    val started = time_sample_monotonic_nanos_or_failure()
    for attempt in 1..9:
        val settled = machine_fresh_workload_settle_exited_start_v3(storage, custody, state)
        if settled.is_ok(): return settled
        match machine_fresh_workload_exited_cohort_retry_v3(settled.unwrap_err(), attempt, started, time_sample_monotonic_nanos_or_failure()):
            case MachineFreshWorkloadCohortRetryV3.Resample(delay_ms): sleep_ms(delay_ms)
            case MachineFreshWorkloadCohortRetryV3.Exhausted(reason): return Err(reason)
            case MachineFreshWorkloadCohortRetryV3.Refuse(reason): return Err(reason)
    Err("machine-fresh-workload-exited-settlement-cohort-retry-bound")


# T-01 sibling of machine_fresh_workload_settle_cpu_v3 (which stays byte-unchanged): the same body with the CpuV2
# requirement replaced by a WorkspaceV3 one. prepare_settlement_v2 dispatches WorkspaceV3 to the workspace settle
# entries; the gates (absence completed and re-observed, associated, helper retired, native retained, not
# uncertain, permit idle) are all in this body or the dispatch.
pub(package) fn machine_fresh_workload_settle_workspace_v3(storage: MachineStorageOwnerV1,
        custody: LinuxFreshEpochSuccessorCustodyV1, state: MachineFreshWorkloadLifecycleV2) -> Result<(), text>:
    if state.settled_v2()?: return Ok(())
    val record = state.record_v3()?
    if machine_fresh_record_workspace_v3(record).is_err(): return Err("machine-fresh-workspace-settle-not-workspace")
    val absence = state.action_state_v2("absence")?
    if absence.state != "completed": return Err("machine-fresh-workload-absence-unproven")
    val command = machine_fresh_record_command_v3(record, LinuxFreshWorkloadActionV2.Absence, state.native_id_v2()?)?
    val native = machine_fresh_absence_observe_v3(custody, record, state.workspace_binding_option_v3()?, command)?
    val bound = state.validate_closure_v2(native)?
    val committed = workload_publish_v3(storage, state, state.prepare_settlement_v2(record, absence, time_sample_unix_micros_or_failure() / 1000)?)?
    state.mark_settled_v2()


# Original owner already authenticated this native principal and current epoch.
# This internal implementation receives its real storage/state capabilities,
# not a record-only grant or a new mutable authority context.
pub(package) fn machine_fresh_workspace_reserve_v3(storage: MachineStorageOwnerV1,
        state: MachineFreshWorkloadLifecycleV2, epoch: MachineFreshEpochRecordV1,
        initial_commit: text, scope: ContainerHostScopeV2, actual: MachineLocalPrincipalSnapshotV1,
        request: ContainerExecutionRequestV2, template: GroupProcessStreamLaunchV2,
        binding: LinuxFreshWorkspaceBindingV3) -> Result<MachineFreshWorkspaceRecordV3, text>:
    if template.profile_v3.is_none(): return Err("machine-fresh-workload-profile-required")
    val record = machine_fresh_workspace_record_v3(epoch, initial_commit, scope, request,
        actual.principal_id, actual.identity_digest, template.profile_v3.unwrap().helper_cpu.cpu_millis,
        template.memory_limit_bytes, binding.current_v3()?)?
    val existing = state.installed_record_v3()
    if existing.is_ok():
        if existing.unwrap() != MachineFreshWorkloadRecordDispatchV3.WorkspaceV3(record): return Err("machine-fresh-workload-request-changed")
        return machine_fresh_record_workspace_v3(state.record_v3()?)
    val staged = state.reserve_workspace_v3(record, template, binding)?
    val committed = workload_publish_v3(storage, state, machine_fresh_workspace_reserve_entries_v3(record, time_sample_unix_micros_or_failure() / 1000)?)?
    val admitted = state.reservation_published_v2()?
    Ok(record)

# Mechanical V2 reserve implementation extraction. Original principal is
# authenticated by the sealed owner before passing this private-capability seam.
pub(package) fn machine_fresh_cpu_reserve_v3(storage: MachineStorageOwnerV1,
        state: MachineFreshWorkloadLifecycleV2, epoch: MachineFreshEpochRecordV1,
        initial_commit: text, scope: ContainerHostScopeV2, actual: MachineLocalPrincipalSnapshotV1,
        request: ContainerExecutionRequestV2, template: GroupProcessStreamLaunchV2,
        admission: LinuxFreshWorkloadAdmissionV2) -> Result<MachineFreshWorkloadRecordV2, text>:
    if template.profile_v3.is_none(): return Err("machine-fresh-workload-profile-required")
    val record = machine_fresh_workload_record_admitted_v2(epoch, initial_commit, scope, request,
        actual.principal_id, actual.identity_digest, template.profile_v3.unwrap().helper_cpu.cpu_millis, template.memory_limit_bytes,
        admission)?
    val existing = state.installed_record_v2()
    if existing.is_ok(): return if existing.unwrap() == record: state.record_v2() else: Err("machine-fresh-workload-request-changed")
    val now = time_sample_unix_micros_or_failure() / 1000
    val reserved = state.reserve_v2(record, template)?
    val committed = workload_publish_v3(storage, state, machine_fresh_workload_reserve_entries_v2(record, now)?)?
    val admitted = state.reservation_published_v2()?
    Ok(record)