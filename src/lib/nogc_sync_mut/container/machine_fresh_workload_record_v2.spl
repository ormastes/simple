# Closed V2 descendants of an existing V1 epoch. DATA only: the actual original
# writer, authenticated principal and live successor are required by the owner.
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.*
use std.common.contracts.container.execution_v2.*
use std.common.contracts.container.runtime_v1.RuntimeIdentityV1
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.nogc_async_mut.container.providers.linux.request_v1.*
use std.nogc_async_mut.container.providers.linux.request_codec_v1.*
use std.common.contracts.distributed_operation_state_v2.*
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.nogc_sync_mut.database.wal.{WalEntry, WalEntryType}

pub struct MachineFreshWorkloadRecordV2:
    epoch_digest: text
    initial_commit: text
    scope: ContainerHostScopeV2
    request: ContainerExecutionRequestV2
    principal_digest: text
    principal_id: text
    cpu_millis: i64
    memory_bytes: i64
    helper_cpu_millis: i64
    helper_memory_bytes: i64
    remaining_cpu_millis: i64
    remaining_memory_bytes: i64

pub fn machine_fresh_workload_request_v2(scope: ContainerHostScopeV2,
        request: ContainerExecutionRequestV2) -> Result<LinuxOciRequestV1, text>:
    if request.request_bytes.byte_len() > 65536: return Err("machine-fresh-workload-request-bound")
    val plan = request.plan
    val encoded = container_execution_request_encode_v2(request)?
    val supplied = ContainerHostScopeV2(physical_host_id: plan.physical_host_id, service_scope_id: plan.service_scope_id,
        boot_id: plan.boot_id, provider_generation: plan.provider_generation, native_machine_id: plan.native_machine_id,
        continuity_mode: plan.continuity_mode, continuity_id: plan.continuity_id)
    if plan.backend != "linux-podman" or container_host_scope_bytes_v2(supplied)? != container_host_scope_bytes_v2(scope)?:
        return Err("machine-fresh-workload-scope")
    val decoded = linux_oci_retained_request_decode_v1(request.request_bytes)?
    if (linux_oci_retained_request_encode_v1(decoded)? != request.request_bytes or
            linux_oci_request_digest_v1(decoded)? != plan.request_digest or decoded.pod_uid != plan.workload_uid or
            decoded.attempt != plan.attempt or decoded.operation_id != plan.operation_id):
        return Err("machine-fresh-workload-request-binding")
    # Finite first profile: explicit command, no host objects, selected users,
    # terminal or environment. These are deliberate unsupported requests.
    if (decoded.mounts.len() != 0 or decoded.bundle_path != "" or decoded.build_input_root != "" or
            decoded.build_output_root != "" or decoded.environment.len() != 0 or decoded.working_directory != "" or
            decoded.terminal_mode != "none" or linux_oci_user_selection_v3(decoded) or
            not decoded.replace_entrypoint or decoded.command.len() < 1 or decoded.command.len() > 32 or
            decoded.args.len() > 32 or decoded.network_policy != "none" or decoded.filesystem_policy != "read-only"):
        return Err("machine-fresh-workload-profile-unsupported")
    if (decoded.cpu_limit_millis < 1 or decoded.cpu_limit_millis > 64000 or decoded.memory_limit_bytes < 1 or
            decoded.memory_limit_bytes > 1125899906842624 or decoded.pid_limit < 1 or decoded.pid_limit > 4096 or
            decoded.timeout_ms < 1 or decoded.timeout_ms > 30000):
        return Err("machine-fresh-workload-bounds")
    val registry = linux_fresh_workload_registry_image_v2(decoded.image)?
    val image = decoded.image.split("@sha256:")
    if image.len() != 2 or image[0] == "" or not builder_digest_valid_v1(image[1]):
        return Err("machine-fresh-workload-image-digest")
    for value in [decoded.image] + decoded.command + decoded.args:
        if value.byte_len() > 4096 or value.contains("\0"): return Err("machine-fresh-workload-argument")
    Ok(decoded)

pub fn machine_fresh_workload_record_v2(epoch: MachineFreshEpochRecordV1, initial: text,
        scope: ContainerHostScopeV2, request: ContainerExecutionRequestV2, principal_id: text,
        principal_digest: text, helper_cpu: i64, helper_memory: i64) -> Result<MachineFreshWorkloadRecordV2, text>:
    val checked = machine_fresh_epoch_record_validate_v1(epoch)?
    val decoded = machine_fresh_workload_request_v2(scope, request)?
    if (not builder_digest_valid_v1(initial) or not builder_digest_valid_v1(principal_digest) or
            principal_id != epoch.principal_id or scope.physical_host_id != epoch.physical_host_id or
            scope.native_machine_id != epoch.native_machine_id or scope.provider_generation <= 0 or
            helper_cpu <= 0 or helper_memory <= 0 or helper_cpu > epoch.usable_cpu_millis or
            helper_memory > epoch.usable_memory_bytes): return Err("machine-fresh-workload-principal-budget")
    # Helpers and the container may coexist. Charge both under usable; the
    # installed shared-broker/Host reservation is never counted a second time.
    if (decoded.cpu_limit_millis > epoch.usable_cpu_millis - helper_cpu or
            decoded.memory_limit_bytes > epoch.usable_memory_bytes - helper_memory):
        return Err("machine-fresh-workload-capacity")
    Ok(MachineFreshWorkloadRecordV2(epoch_digest: sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?),
        initial_commit: initial, scope: scope, request: request, principal_digest: principal_digest, principal_id: principal_id,
        cpu_millis: decoded.cpu_limit_millis, memory_bytes: decoded.memory_limit_bytes,
        helper_cpu_millis: helper_cpu, helper_memory_bytes: helper_memory,
        remaining_cpu_millis: epoch.usable_cpu_millis - helper_cpu - decoded.cpu_limit_millis,
        remaining_memory_bytes: epoch.usable_memory_bytes - helper_memory - decoded.memory_limit_bytes))

pub fn machine_fresh_workload_record_validate_v2(record: MachineFreshWorkloadRecordV2) -> Result<(), text>:
    if (not builder_digest_valid_v1(record.epoch_digest) or not builder_digest_valid_v1(record.initial_commit) or
            not builder_digest_valid_v1(record.principal_digest) or record.principal_id == "" or record.principal_id.byte_len() > 256 or
            record.cpu_millis < 1 or record.cpu_millis > 64000 or record.helper_cpu_millis < 1 or record.helper_cpu_millis > 64000 or
            record.remaining_cpu_millis < 0 or record.remaining_cpu_millis > 64000 or
            record.memory_bytes < 1 or record.memory_bytes > 1125899906842624 or record.helper_memory_bytes < 1 or
            record.helper_memory_bytes > 1125899906842624 or record.remaining_memory_bytes < 0 or record.remaining_memory_bytes > 1125899906842624):
        return Err("machine-fresh-workload-record-fields")
    if (record.cpu_millis + record.helper_cpu_millis > 64000 - record.remaining_cpu_millis or
            record.memory_bytes + record.helper_memory_bytes > 1125899906842624 - record.remaining_memory_bytes):
        return Err("machine-fresh-workload-record-overflow")
    val request = machine_fresh_workload_request_v2(record.scope, record.request)?
    if request.cpu_limit_millis != record.cpu_millis or request.memory_limit_bytes != record.memory_bytes:
        return Err("machine-fresh-workload-record-request-budget")
    Ok(())

pub fn machine_fresh_workload_bytes_v2(record: MachineFreshWorkloadRecordV2) -> Result<text, text>:
    val checked = machine_fresh_workload_record_validate_v2(record)?
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("machine-fresh-workload"), "version": SdnValue.Int(2),
        "epochDigest": SdnValue.String(record.epoch_digest), "initialCommit": SdnValue.String(record.initial_commit),
        "scope": SdnValue.String(container_host_scope_bytes_v2(record.scope)?),
        "request": SdnValue.String(container_execution_request_encode_v2(record.request)?),
        "principalDigest": SdnValue.String(record.principal_digest), "principalId": SdnValue.String(record.principal_id),
        "cpuMillis": SdnValue.Int(record.cpu_millis), "memoryBytes": SdnValue.Int(record.memory_bytes),
        "helperCpuMillis": SdnValue.Int(record.helper_cpu_millis), "helperMemoryBytes": SdnValue.Int(record.helper_memory_bytes),
        "remainingCpuMillis": SdnValue.Int(record.remaining_cpu_millis), "remainingMemoryBytes": SdnValue.Int(record.remaining_memory_bytes)}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)))

pub fn machine_fresh_workload_id_v2(record: MachineFreshWorkloadRecordV2) -> Result<text, text>:
    Ok(sha256_text(machine_fresh_workload_bytes_v2(record)?))

fn fresh_workload_charge_v2(record: MachineFreshWorkloadRecordV2, kind: text, state: text,
        cpu: i64, memory: i64) -> Result<text, text>:
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String(kind), "version": SdnValue.Int(2),
        "workloadDigest": SdnValue.String(machine_fresh_workload_id_v2(record)?), "state": SdnValue.String(state),
        "cpuMillis": SdnValue.Int(cpu), "memoryBytes": SdnValue.Int(memory), "exclusiveDevices": SdnValue.Array([])}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)))

pub fn machine_fresh_workload_reserve_entries_v2(record: MachineFreshWorkloadRecordV2, at: i64) -> Result<[WalEntry], text>:
    if at <= 0: return Err("machine-fresh-workload-clock")
    val id = machine_fresh_workload_id_v2(record)?
    Ok([WalEntry(0, WalEntryType.Insert, "machine-fresh-workloads-v2", id, machine_fresh_workload_bytes_v2(record)?, at),
        WalEntry(0, WalEntryType.Update, "machine-container-reservations-v1", "partition-" + record.epoch_digest,
            fresh_workload_charge_v2(record, "machine-fresh-partition-remainder", "uncertain",
                record.remaining_cpu_millis, record.remaining_memory_bytes)?, at),
        WalEntry(0, WalEntryType.Insert, "machine-container-reservations-v1", "workload-" + id,
            fresh_workload_charge_v2(record, "machine-fresh-workload-charge", "uncertain",
                record.cpu_millis + record.helper_cpu_millis, record.memory_bytes + record.helper_memory_bytes)?, at)])

pub fn machine_fresh_workload_action_initial_v2(record: MachineFreshWorkloadRecordV2,
        action: text, generation: i64) -> Result<DistributedOperationStateV2, text>:
    if not ["pull-image", "create", "inspect-created", "start", "inspect", "inspect-confirm", "stop", "remove", "absence"].contains(action):
        val read = machine_fresh_workload_read_prior_v2(action)?
    val id = machine_fresh_workload_id_v2(record)?
    # V2 here is a transition oracle, not a remote grant or policy revision
    # authority. Immutable policy/profile/request binding lives in payload/id.
    val envelope = OperationEnvelopeV2(version: 2, id: "work-" + id + "-" + action,
        payload_digest: id, principal: "local-" + record.principal_digest, project: "fresh-epoch",
        host_id: record.scope.physical_host_id, operation: action, environment_digest: record.epoch_digest,
        policy_revision: 2, revocation_epoch: 0, session_generation: generation,
        memory_bytes: record.memory_bytes + record.helper_memory_bytes, duration_ms: 30000)
    distributed_operation_initial_v2(distributed_encode_operation_v2(envelope)?)

pub fn machine_fresh_workload_action_entries_v2(record: MachineFreshWorkloadRecordV2,
        state: DistributedOperationStateV2, native_id: text, evidence: text, at: i64) -> Result<[WalEntry], text>:
    val id = machine_fresh_workload_id_v2(record)?
    if at <= 0 or (native_id != "" and not builder_digest_valid_v1(native_id)) or evidence.byte_len() > 65536:
        return Err("machine-fresh-workload-action-result")
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("machine-fresh-workload-action"), "version": SdnValue.Int(2),
        "workloadDigest": SdnValue.String(id), "envelope": SdnValue.String(state.envelope),
        "state": SdnValue.String(state.state), "outcomeDigest": SdnValue.String(state.outcome_digest),
        "nativeId": SdnValue.String(native_id), "evidence": SdnValue.String(evidence)}
    Ok([WalEntry(0, if state.state == "admitted": WalEntryType.Insert else: WalEntryType.Update, "machine-fresh-workload-actions-v2", state.operation_id,
        sdn_encode_canonical(SdnValue.Dict(fields)), at)])

pub fn machine_fresh_workload_settle_entries_v2(record: MachineFreshWorkloadRecordV2,
        terminal: DistributedOperationStateV2, at: i64) -> Result<[WalEntry], text>:
    if terminal.state != "completed": return Err("machine-fresh-workload-not-settled")
    val id = machine_fresh_workload_id_v2(record)?
    val restored_cpu = record.remaining_cpu_millis + record.cpu_millis + record.helper_cpu_millis
    val restored_memory = record.remaining_memory_bytes + record.memory_bytes + record.helper_memory_bytes
    val rows = machine_fresh_workload_action_entries_v2(record, terminal, "", terminal.outcome_digest, at)?
    Ok(rows + [WalEntry(0, WalEntryType.Update, "machine-container-reservations-v1", "workload-" + id,
        fresh_workload_charge_v2(record, "machine-fresh-workload-charge", "released", 0, 0)?, at),
        WalEntry(0, WalEntryType.Update, "machine-container-reservations-v1", "partition-" + record.epoch_digest,
            fresh_workload_charge_v2(record, "machine-fresh-partition-remainder", "uncertain", restored_cpu, restored_memory)?, at)])

pub fn machine_fresh_workload_rows_equal_v2(actual: [WalEntry], expected: [WalEntry]) -> bool:
    if actual.len() != expected.len(): return false
    for index in 0..actual.len():
        val a = actual[index]
        val e = expected[index]
        if (a.entry_type != e.entry_type or a.table_name != e.table_name or a.row_key != e.row_key or
                a.data != e.data or a.timestamp != e.timestamp): return false
    true

pub fn machine_fresh_workload_command_v2(record: MachineFreshWorkloadRecordV2,
        action: LinuxFreshWorkloadActionV2, native_id: text, observed_image_id: text = "") -> Result<LinuxFreshWorkloadCommandV2, text>:
    val decoded = machine_fresh_workload_request_v2(record.scope, record.request)?
    val command = LinuxFreshWorkloadCommandV2(request: record.request, scope: record.scope, action: action, native_id: native_id,
        image: decoded.image, entrypoint: decoded.command, args: decoded.args, cpu_millis: record.cpu_millis,
        memory_bytes: record.memory_bytes, pid_limit: decoded.pid_limit, timeout_ms: decoded.timeout_ms,
        helper_cpu_millis: record.helper_cpu_millis, helper_memory_bytes: record.helper_memory_bytes, observed_image_id: observed_image_id)
    val valid = linux_fresh_workload_command_validate_v2(command)?
    Ok(command)

pub fn machine_fresh_workload_association_entries_v2(record: MachineFreshWorkloadRecordV2,
        native_id: text, evidence_digest: text, at: i64) -> Result<[WalEntry], text>:
    if not builder_digest_valid_v1(native_id) or not builder_digest_valid_v1(evidence_digest) or at <= 0:
        return Err("machine-fresh-workload-association-fields")
    val id = machine_fresh_workload_id_v2(record)?
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("machine-fresh-workload-native-association"), "version": SdnValue.Int(2),
        "workloadDigest": SdnValue.String(id), "nativeId": SdnValue.String(native_id), "evidenceDigest": SdnValue.String(evidence_digest)}
    Ok([WalEntry(0, WalEntryType.Insert, "machine-fresh-workload-evidence-v2", id, sdn_encode_canonical(SdnValue.Dict(fields)), at)])

# Only fixed read stages and bounded private ordinals are accepted as operation
# names. The public creator still accepts a closed enum, never this text.
pub fn machine_fresh_workload_read_prior_v2(name: text) -> Result<text, text>:
    val stages = [("configuration-before", "create"), ("configuration-image", "configuration-before"),
        ("configuration-after", "configuration-image"), ("input-configuration-before", "create"),
        ("input-configuration-image", "input-configuration-before"), ("input-configuration-after", "input-configuration-image")]
    for stage in stages:
        val prefix = stage.0 + "-"
        if name.starts_with(prefix):
            val ordinal = name.substring(prefix.byte_len(), name.byte_len())
            if ordinal.byte_len() != 1 or not "12345678".contains(ordinal): return Err("machine-fresh-workload-read-bound")
            return Ok(if stage.1 == "create": "create" else: stage.1 + "-" + ordinal)
    Err("machine-fresh-workload-action")

pub fn machine_fresh_workload_runtime_v2(record: MachineFreshWorkloadRecordV2, native_id: text) -> Result<RuntimeIdentityV1, text>:
    Ok(RuntimeIdentityV1(pod_uid: record.request.plan.workload_uid, attempt: record.request.plan.attempt,
        provider_generation: record.scope.provider_generation, operation_id: record.request.plan.operation_id, engine: "podman",
        native_id: native_id, node_boot_id: container_scope_fence_id_v2(record.scope)?))

pub fn machine_fresh_workload_action_batch_entries_v2(record: MachineFreshWorkloadRecordV2,
        states: [DistributedOperationStateV2], native_id: text, evidence: text, at: i64) -> Result<[WalEntry], text>:
    if states.len() < 2 or states.len() > 3: return Err("machine-fresh-workload-action-batch")
    var rows: [WalEntry] = []
    for state in states:
        rows = rows + machine_fresh_workload_action_entries_v2(record, state, native_id, evidence, at)?
    Ok(rows)

# Podman pull stdout is its LOCAL IMAGE/CONFIG ID, not the registry manifest
# digest in request.image. Keep the two identities distinct and correlate them
# through actual container/image/RepoDigest inspection before allowing Start.
pub fn machine_fresh_workload_image_id_v2(output: text) -> Result<text, text>:
    val value = output.trim()
    if output != value and output != value + "\n" and output != value + "\r\n":
        return Err("machine-fresh-workload-image-id-output")
    val id = if value.starts_with("sha256:"): value.substring(7, value.byte_len()) else: value
    if not builder_digest_valid_v1(id): return Err("machine-fresh-workload-image-id-output")
    Ok(id)

# Production-used canonical progress guard. This public DATA cannot supply the
# original writer or confirm a commit; only the sealed owner updates its slot
# after actual same-WAL CAS and exact history readback.
pub struct MachineFreshWorkloadReservationProgressV2:
    phase: text = "empty"
    record_digest: text = ""

pub fn machine_fresh_workload_reservation_stage_v2(progress: MachineFreshWorkloadReservationProgressV2,
        record: MachineFreshWorkloadRecordV2) -> Result<MachineFreshWorkloadReservationProgressV2, text>:
    if progress.phase != "empty" or progress.record_digest != "": return Err("machine-fresh-workload-reservation-already-staged")
    Ok(MachineFreshWorkloadReservationProgressV2("staged", machine_fresh_workload_id_v2(record)?))

pub fn machine_fresh_workload_reservation_pending_v2(progress: MachineFreshWorkloadReservationProgressV2) -> Result<MachineFreshWorkloadReservationProgressV2, text>:
    if progress.phase != "staged": return Err("machine-fresh-workload-reservation-phase")
    Ok(MachineFreshWorkloadReservationProgressV2("publication-unknown", progress.record_digest))

pub fn machine_fresh_workload_reservation_confirm_v2(progress: MachineFreshWorkloadReservationProgressV2,
        record: MachineFreshWorkloadRecordV2) -> Result<MachineFreshWorkloadReservationProgressV2, text>:
    if progress.phase != "publication-unknown" or progress.record_digest != machine_fresh_workload_id_v2(record)?:
        return Err("machine-fresh-workload-reservation-publication-unproven")
    Ok(MachineFreshWorkloadReservationProgressV2("admitted", progress.record_digest))

pub fn machine_fresh_workload_reservation_require_v2(progress: MachineFreshWorkloadReservationProgressV2,
        record: MachineFreshWorkloadRecordV2) -> Result<(), text>:
    if progress.phase != "admitted" or progress.record_digest != machine_fresh_workload_id_v2(record)?:
        return Err("machine-fresh-workload-reservation-publication-unproven")
    Ok(())
