# Scope metadata projection only; the sealed owner supplies genuine current
# host observations. DATA cannot construct custody, a writer or an action grant.
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.*
use std.common.contracts.container.execution_v2.*
use std.common.contracts.container.linux_fresh_workload_v2.LinuxFreshHostContextV2
use std.common.crypto.sha256.sha256_text

pub fn machine_fresh_workload_scope_v2(epoch: MachineFreshEpochRecordV1,
        host: LinuxFreshHostContextV2) -> Result<ContainerHostScopeV2, text>:
    if host.native_machine_id != epoch.native_machine_id: return Err("machine-fresh-workload-host-context")
    Ok(ContainerHostScopeV2(physical_host_id: epoch.physical_host_id,
        service_scope_id: "epoch-" + sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?),
        boot_id: host.native_boot_id, provider_generation: host.owner_generation, native_machine_id: host.native_machine_id,
        continuity_mode: "native-boot-incarnation-v1", continuity_id: host.native_boot_id))
