# Canonical native-output custody and V2 operation progress. This module cannot
# acquire a writer or spawn a process; its metadata is never an admission grant.
use std.nogc_sync_mut.container.machine_fresh_workload_record_v2.*
use std.nogc_sync_mut.container.machine_fresh_workload_inspect_v2.*
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxFreshEpochSuccessorCustodyV1
use std.common.contracts.container.linux_fresh_workload_v2.{LinuxFreshWorkloadCommandV2, LinuxFreshWorkloadActionV2, LinuxFreshWorkloadClosureV2}
use std.nogc_async_mut.container.shared.input_configuration_query_v1.{configuration_selected_parse_v2, configuration_selected_observation_v2}
use std.nogc_async_mut.container.providers.linux.containment_v1.linux_oci_containment_same_subject_v1
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.container.machine_fresh_workload_history_v2.*
use std.nogc_sync_mut.container.machine_fresh_workload_settlement_v2.*
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.{MachineFreshEpochRecordV1, machine_fresh_epoch_record_bytes_v1}
use std.nogc_sync_mut.io.linux_machine_process_origin_v1.linux_machine_process_origin_check_v1
use std.nogc_sync_mut.io.thread.thread_native_current_id
use std.nogc_sync_mut.io.time_ops.{time_sample_monotonic_nanos_or_failure, sleep_ms}
use std.nogc_sync_mut.io.group_process_owner.*
use std.nogc_sync_mut.io.process_ops.{PipedProcessRefV1, PipedProcessOwnedTransferV2, process_validate_piped_owned_transfer_v2, process_read_stdout_ref_v1, process_cleanup_piped_owned_v2}
use std.nogc_sync_mut.io.linux_container_containment_v1.*
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamLaunchV2, group_process_stream_template_encode_v3}
use std.common.contracts.distributed_operation_state_v2.*
use std.nogc_sync_mut.database.wal.WalEntry
use std.nogc_sync_mut.database.wal_segmented.DatabaseWalRevisionV1

struct FreshWorkloadStateV2:
    epoch: MachineFreshEpochRecordV1
    history: MachineFreshWorkloadHistoryV2
    record: Option<MachineFreshWorkloadRecordV2> = nil
    reservation: MachineFreshWorkloadReservationProgressV2 = MachineFreshWorkloadReservationProgressV2()
    template: Option<GroupProcessStreamLaunchV2> = nil
    operations: Dict<text, DistributedOperationStateV2> = {}
    outputs: Dict<text, text> = {}
    action: text = ""
    permit: text = "idle"
    process: Option<GroupProcessStreamOwnerV2> = nil
    reference: Option<PipedProcessRefV1> = nil
    output: text = ""
    eof: bool = false
    exit_code: i64 = -1
    terminal: bool = false
    actual_program: text = ""
    actual_arguments: [text] = []
    native_id: text = ""
    containment: Option<LinuxContainerContainmentOwnerV1> = nil
    captured_subject: Option<LinuxContainerContainmentSnapshotV1> = nil
    extra_containment: [LinuxContainerContainmentOwnerV1] = []
    image_config_verified: bool = false
    associated: bool = false
    settlement: Option<MachineFreshWorkloadSettlementProgressV2> = nil
    settled: bool = false
    uncertain: bool = false
    outcome_unknown: bool = false
    error: text = ""
    configuration_batch: i64 = 0
    input_configuration_batch: i64 = 0
    closed: bool = false

var fresh_workload_states_v2: [FreshWorkloadStateV2] = []
var fresh_workload_thread_v2: i64 = 0

fn fresh_workload_entry_v2() -> Result<(), text>:
    val actual_origin = linux_machine_process_origin_check_v1()?
    val thread = thread_native_current_id()
    if thread <= 0: return Err("machine-fresh-workload-thread")
    if fresh_workload_thread_v2 == 0: fresh_workload_thread_v2 = thread
    if fresh_workload_thread_v2 != thread: return Err("machine-fresh-workload-foreign-thread")
    Ok(())

pub struct MachineFreshWorkloadActionResultV2:
    complete: bool
    output: text
    exit_code: i64
    error: text
    program: text = ""
    arguments: [text] = []

pub class MachineFreshWorkloadLifecycleV2:
    slot: i64
    generation: i64

    fn state_v2() -> Result<FreshWorkloadStateV2, text>:
        val context = fresh_workload_entry_v2()?
        if self.slot < 0 or self.slot >= fresh_workload_states_v2.len() or self.generation != self.slot + 1:
            return Err("machine-fresh-workload-stale")
        Ok(fresh_workload_states_v2[self.slot])

    pub fn live_v2() -> Result<(), text>:
        val state = self.state_v2()?
        if state.closed or state.uncertain: return Err("machine-fresh-workload-unknown-or-closed")
        Ok(())

    pub fn output_v2(action: text) -> Result<text, text>:
        val state = self.state_v2()?
        if not state.outputs.contains_key(action): return Err("machine-fresh-workload-output-missing")
        Ok(state.outputs[action])

    pub fn history_v2() -> Result<MachineFreshWorkloadHistoryV2, text>:
        val state = self.state_v2()?
        if state.closed: return Err("machine-fresh-workload-closed")
        Ok(state.history)

    pub fn installed_record_v2() -> Result<MachineFreshWorkloadRecordV2, text>:
        val state = self.state_v2()?
        if state.record.is_none(): return Err("machine-fresh-workload-not-reserved")
        Ok(state.record.unwrap())

    pub fn record_v2() -> Result<MachineFreshWorkloadRecordV2, text>:
        val state = self.state_v2()?
        val record = self.installed_record_v2()?
        val published = machine_fresh_workload_reservation_require_v2(state.reservation, record)?
        Ok(record)

    pub fn template_v2() -> Result<GroupProcessStreamLaunchV2, text>:
        val state = self.state_v2()?
        if state.template.is_none(): return Err("machine-fresh-workload-template-missing")
        Ok(state.template.unwrap())

    pub fn reserve_v2(record: MachineFreshWorkloadRecordV2, template: GroupProcessStreamLaunchV2) -> Result<(), text>:
        val state = self.state_v2()?
        if state.closed or state.record.is_some(): return Err("machine-fresh-workload-already-reserved")
        val staged = machine_fresh_workload_reservation_stage_v2(state.reservation, record)?
        fresh_workload_states_v2[self.slot].reservation = staged
        fresh_workload_states_v2[self.slot].record = Some(record)
        fresh_workload_states_v2[self.slot].template = Some(template)
        Ok(())

    pub fn publication_pending_v2() -> Result<(), text>:
        val state = self.state_v2()?
        if state.closed or state.uncertain: return Err("machine-fresh-workload-unknown")
        val room = machine_fresh_workload_history_budget_v2(state.history.segments.len(), 1, true)?
        if state.reservation.phase == "staged":
            fresh_workload_states_v2[self.slot].reservation = machine_fresh_workload_reservation_pending_v2(state.reservation)?
        fresh_workload_states_v2[self.slot].uncertain = true
        Ok(())

    pub fn committed_v2(revision: DatabaseWalRevisionV1, entries: [WalEntry]) -> Result<(), text>:
        val state = self.state_v2()?
        if state.closed or not state.uncertain: return Err("machine-fresh-workload-publication-phase")
        fresh_workload_states_v2[self.slot].history.segments.push(MachineFreshWorkloadSegmentV2(revision, entries))
        Ok(())

    pub fn publication_verified_v2() -> Result<(), text>:
        val state = self.state_v2()?
        if state.closed or not state.uncertain: return Err("machine-fresh-workload-publication-phase")
        fresh_workload_states_v2[self.slot].uncertain = false
        Ok(())

    pub fn reservation_published_v2() -> Result<(), text>:
        val state = self.state_v2()?
        # The sealed owner calls this only after its reserve CAS and exact
        # same-writer history readback. Staging/failed CAS cannot reach success.
        if state.closed or state.uncertain or state.history.segments.len() != 1 or state.record.is_none():
            return Err("machine-fresh-workload-reservation-publication-unproven")
        fresh_workload_states_v2[self.slot].reservation = machine_fresh_workload_reservation_confirm_v2(state.reservation, state.record.unwrap())?
        Ok(())

    pub fn name_v2(base: text) -> Result<text, text>:
        val state = self.state_v2()?
        val normal = ["configuration-before", "configuration-image", "configuration-after"].contains(base)
        val input = ["input-configuration-before", "input-configuration-image", "input-configuration-after"].contains(base)
        if not normal and not input: return Ok(base)
        var ordinal = if input: state.input_configuration_batch else: state.configuration_batch
        if base.ends_with("-before"):
            fresh_workload_states_v2[self.slot].image_config_verified = false
            ordinal = ordinal + 1
            if input: fresh_workload_states_v2[self.slot].input_configuration_batch = ordinal
            else: fresh_workload_states_v2[self.slot].configuration_batch = ordinal
        if ordinal < 1 or ordinal > 8: return Err("machine-fresh-workload-read-bound")
        Ok(base + "-" + str(ordinal))

    pub fn command_v2(action: LinuxFreshWorkloadActionV2, name: text) -> Result<LinuxFreshWorkloadCommandV2, text>:
        val record = self.record_v2()?
        val id = self.native_id_v2()?
        var image_id = ""
        if action == LinuxFreshWorkloadActionV2.ConfigurationImage or action == LinuxFreshWorkloadActionV2.InputConfigurationImage:
            val input = action == LinuxFreshWorkloadActionV2.InputConfigurationImage
            val parts = name.split("-")
            val before_name = (if input: "input-configuration-before-" else: "configuration-before-") + parts[parts.len() - 1]
            val actual = configuration_selected_parse_v2(self.output_v2(before_name)?, machine_fresh_workload_runtime_v2(record, id)?, record.scope, false, input)?
            image_id = actual.configuration.image_id
            val pulled = machine_fresh_workload_image_id_v2(self.output_v2("pull-image")?)?
            if pulled != machine_fresh_workload_image_id_v2(image_id)?: return Err("machine-fresh-workload-pulled-config-mismatch")
        machine_fresh_workload_command_v2(record, action, id, image_id)

    pub fn configuration_v2(kind: LinuxFreshWorkloadActionV2, epoch: MachineFreshEpochRecordV1) -> Result<text, text>:
        val state = self.state_v2()?
        val input = kind == LinuxFreshWorkloadActionV2.InputConfigurationAfter
        if not input and kind != LinuxFreshWorkloadActionV2.ConfigurationAfter: return Err("machine-fresh-workload-configuration-kind")
        fresh_workload_states_v2[self.slot].image_config_verified = false
        val record = self.record_v2()?
        if record.epoch_digest != sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?): return Err("machine-fresh-workload-configuration-epoch")
        val ordinal = if input: state.input_configuration_batch else: state.configuration_batch
        if ordinal < 1 or ordinal > 8: return Err("machine-fresh-workload-read-bound")
        val prefix = if input: "input-configuration-" else: "configuration-"
        for stage in ["before", "image", "after"]:
            val operation = self.action_state_v2(prefix + stage + "-" + str(ordinal))?
            if operation.state != "completed": return Err("machine-fresh-workload-configuration-incomplete")
        val before = self.output_v2(prefix + "before-" + str(ordinal))?
        val image = self.output_v2(prefix + "image-" + str(ordinal))?
        val after = self.output_v2(prefix + "after-" + str(ordinal))?
        val expected = machine_fresh_workload_runtime_v2(record, state.native_id)?
        val first = configuration_selected_parse_v2(before, expected, record.scope, false, input)?
        if machine_fresh_workload_image_id_v2(first.configuration.image_id)? != machine_fresh_workload_image_id_v2(self.output_v2("pull-image")?)?:
            return Err("machine-fresh-workload-pulled-config-mismatch")
        val request = machine_fresh_workload_request_v2(record.scope, record.request)?
        val observation = configuration_selected_observation_v2(before, image, after, record.scope, expected,
            record.request.plan.request_digest, request.image, input)?
        fresh_workload_states_v2[self.slot].image_config_verified = true
        Ok(observation)

    pub fn validate_closure_v2(closure: LinuxFreshWorkloadClosureV2) -> Result<(), text>:
        val state = self.state_v2()?
        val record = self.record_v2()?
        if state.captured_subject.is_none(): return Err("machine-fresh-workload-closure-subject-missing")
        val captured = state.captured_subject.unwrap()
        if (closure.native_id != state.native_id or closure.native_binding_digest != captured.binding_digest or
                closure.process_id != captured.capture_pid or closure.process_start_ticks != captured.process_start_ticks or
                closure.owner_generation != record.scope.provider_generation or
                closure.partition_identity_digest != state.epoch.partition_identity_digest or
                closure.cgroup_inode <= 0 or closure.cgroup_mount_id <= 0):
            return Err("machine-fresh-workload-closure-binding")
        Ok(())

    pub fn action_state_v2(action: text) -> Result<DistributedOperationStateV2, text>:
        val state = self.state_v2()?
        if not state.operations.contains_key(action): return Err("machine-fresh-workload-action-missing")
        Ok(state.operations[action])

    pub fn action_begin_v2(action: text, generation: i64) -> Result<[DistributedOperationStateV2], text>:
        var state = self.state_v2()?
        val admitted = self.record_v2()?
        val cleanup = ["stop", "remove", "absence"].contains(action)
        if state.closed or state.uncertain or state.operations.contains_key(action):
            return Err("machine-fresh-workload-action-already-attempted")
        if state.outcome_unknown and not cleanup: return Err("machine-fresh-workload-outcome-unknown")
        val projected = if action.contains("-before-"): 6 else: 2
        val room = machine_fresh_workload_history_budget_v2(state.history.segments.len(), projected, cleanup)?
        var transitions: [DistributedOperationStateV2] = []
        if cleanup and state.outcome_unknown:
            if state.native_id == "": return Err("machine-fresh-workload-native-id-missing")
            val retired = self.retire_helper_v2()?
            state = self.state_v2()?
            if state.operations.contains_key(state.action) and state.operations[state.action].state == "executing":
                val unknown = distributed_operation_transition_v2(state.operations[state.action], "outcome-unknown", "")?
                transitions.push(unknown)
                fresh_workload_states_v2[self.slot].operations[state.action] = unknown
            fresh_workload_states_v2[self.slot].permit = "idle"
            state = self.state_v2()?
        if state.permit != "idle": return Err("machine-fresh-workload-action-already-attempted")
        val prior = match action:
            case "pull-image": ""
            case "create": "pull-image"
            case "inspect-created": "create"
            case "start": "inspect-created"
            case "inspect": "start"
            case "inspect-confirm": "inspect"
            case "stop": if state.outcome_unknown: "create" else: "inspect-confirm"
            case "remove": "stop"
            case "absence": "remove"
            case _: machine_fresh_workload_read_prior_v2(action)?
        if prior != "" and (not state.operations.contains_key(prior) or state.operations[prior].state != "completed"):
            return Err("machine-fresh-workload-action-order")
        if action != "create" and action != "pull-image" and state.native_id == "": return Err("machine-fresh-workload-native-id-missing")
        if action == "start" and not state.image_config_verified: return Err("machine-fresh-workload-image-correspondence-unverified")
        val record = self.record_v2()?
        val initial = machine_fresh_workload_action_initial_v2(record, action, generation)?
        val executing = distributed_operation_transition_v2(initial, "executing", "")?
        fresh_workload_states_v2[self.slot].operations[action] = executing
        fresh_workload_states_v2[self.slot].action = action
        fresh_workload_states_v2[self.slot].permit = "intent-pending"
        fresh_workload_states_v2[self.slot].output = ""
        fresh_workload_states_v2[self.slot].eof = false
        fresh_workload_states_v2[self.slot].terminal = false
        fresh_workload_states_v2[self.slot].exit_code = -1
        Ok(transitions + [initial, executing])

    pub fn consume_action_v2() -> Result<(), text>:
        val state = self.state_v2()?
        if state.closed or state.uncertain or state.permit != "intent-pending":
            return Err("machine-fresh-workload-permit-consumed")
        # Irreversible BEFORE native spawn; aliases see the same obligation.
        fresh_workload_states_v2[self.slot].permit = "spawn-unresolved"
        Ok(())

    pub fn capture_v2(process: GroupProcessStreamOwnerV2, reference: Option<PipedProcessRefV1>):
        # Called immediately with the actual native return, before any fallible
        # binding check. Slot/context were validated before the native call.
        fresh_workload_states_v2[self.slot].process = Some(process)
        fresh_workload_states_v2[self.slot].reference = reference
        fresh_workload_states_v2[self.slot].permit = "captured"
        fresh_workload_states_v2[self.slot].actual_program = process.launch.request.program
        fresh_workload_states_v2[self.slot].actual_arguments = process.launch.request.args

    pub fn validate_process_v2(expected: text) -> Result<(), text>:
        val state = self.state_v2()?
        if state.process.is_none() or state.reference.is_none(): return Err("machine-fresh-workload-owned-transfer-missing")
        val actual = group_process_stream_template_encode_v3(state.process.unwrap().launch)?
        if actual != expected: return Err("machine-fresh-workload-owned-image-binding")
        process_validate_piped_owned_transfer_v2(PipedProcessOwnedTransferV2(state.process.unwrap(), state.reference.unwrap()))

    pub fn rejected_v2(reason: text) -> Result<(), text>:
        val state = self.state_v2()?
        if state.permit != "spawn-unresolved": return Err("machine-fresh-workload-native-rejection-phase")
        fresh_workload_states_v2[self.slot].permit = "rejected"
        self.unknown_v2(reason)

    pub fn unknown_v2(reason: text) -> Result<(), text>:
        val state = self.state_v2()?
        fresh_workload_states_v2[self.slot].outcome_unknown = true
        fresh_workload_states_v2[self.slot].error = machine_fresh_workload_first_diagnostic_v2(state.error, reason)
        Ok(())

    fn failed_v2(reason: text) -> Result<MachineFreshWorkloadActionResultV2, text>:
        val retained = self.unknown_v2(reason)?
        Err(self.diagnostic_v2()?)

    pub fn after_action_v2(result: Result<MachineFreshWorkloadActionResultV2, text>) -> Result<MachineFreshWorkloadActionResultV2, text>:
        if result.is_ok(): return result
        val state = self.state_v2()?
        if state.permit != "idle" or state.outcome_unknown: return self.failed_v2(result.unwrap_err())
        result

    pub fn after_association_v2(result: Result<(), text>) -> Result<(), text>:
        if result.is_ok(): return result
        val retained = self.unknown_v2(result.unwrap_err())?
        Err(self.diagnostic_v2()?)

    pub fn result_v2() -> Result<MachineFreshWorkloadActionResultV2, text>:
        val state = self.state_v2()?
        Ok(MachineFreshWorkloadActionResultV2(state.eof and state.terminal, state.output, state.exit_code, state.error, state.actual_program, state.actual_arguments))

    pub fn drain_v2() -> Result<MachineFreshWorkloadActionResultV2, text>:
        val state = self.state_v2()?
        if state.process.is_none() or state.reference.is_none(): return Err("machine-fresh-workload-native-output-missing")
        if not state.eof:
            val read = process_read_stdout_ref_v1(state.reference.unwrap())
            match read:
                case Ok(Some(chunk)):
                    if chunk.byte_len() > 65536 - state.output.byte_len():
                        return self.failed_v2("machine-fresh-workload-output-limit")
                    fresh_workload_states_v2[self.slot].output = state.output + chunk
                case Ok(None): pass
                case Err(reason):
                    if reason == "process_stdout_eof": fresh_workload_states_v2[self.slot].eof = true
                    else:
                        return self.failed_v2(reason)
        val poll_turn = group_process_stream_poll_v2(state.process.unwrap())
        if poll_turn.is_err(): return self.failed_v2(poll_turn.unwrap_err())
        val polled = poll_turn.unwrap()
        if polled.terminal:
            val terminal = group_process_stream_terminal_v2(state.process.unwrap())
            if terminal.is_err(): return self.failed_v2(terminal.unwrap_err())
            val actual = terminal.unwrap().0
            if actual.timed_out or actual.cancelled: return self.failed_v2("machine-fresh-workload-helper-limited")
            fresh_workload_states_v2[self.slot].terminal = true
            fresh_workload_states_v2[self.slot].exit_code = actual.exit_code
        self.result_v2()

    pub fn collect_v2(timeout_ms: i64) -> Result<MachineFreshWorkloadActionResultV2, text>:
        val started = time_sample_monotonic_nanos_or_failure()
        if started <= 0 or timeout_ms < 1 or timeout_ms > 30000: return self.failed_v2("machine-fresh-workload-clock")
        while true:
            val observed = self.drain_v2()?
            if observed.complete: return Ok(observed)
            val now = time_sample_monotonic_nanos_or_failure()
            if now < started or now - started >= timeout_ms * 1000000:
                return self.failed_v2("machine-fresh-workload-command-outcome-unknown")
            sleep_ms(1)

    pub fn retire_helper_v2() -> Result<(), text>:
        val state = self.state_v2()?
        if val process = state.process:
            val retired = process_cleanup_piped_owned_v2(process, state.reference)
            if retired.is_err():
                val retained = self.unknown_v2(retired.unwrap_err())?
                return retired
            fresh_workload_states_v2[self.slot].process = nil
            fresh_workload_states_v2[self.slot].reference = nil
        elif state.permit == "spawn-unresolved": return Err("machine-fresh-workload-native-outcome-unresolved")
        Ok(())

    pub fn complete_v2(state: DistributedOperationStateV2, native_id: text) -> Result<(), text>:
        val current = self.state_v2()?
        if state.state != "completed" or current.uncertain or current.process.is_some():
            return Err("machine-fresh-workload-completion-unverified")
        val expected = distributed_operation_transition_v2(current.operations[current.action], "completed", state.outcome_digest)?
        if expected != state: return Err("machine-fresh-workload-operation-binding")
        fresh_workload_states_v2[self.slot].operations[current.action] = state
        fresh_workload_states_v2[self.slot].outputs[current.action] = current.output
        if current.action == "create": fresh_workload_states_v2[self.slot].native_id = native_id
        fresh_workload_states_v2[self.slot].permit = "idle"
        Ok(())

    pub fn native_id_v2() -> Result<text, text>:
        val state = self.state_v2()?
        Ok(state.native_id)

    pub fn capture_subject_v2(subject: MachineFreshWorkloadInspectV2, binding: text) -> Result<(), text>:
        val state = self.state_v2()?
        if state.containment.is_some(): return Err("machine-fresh-workload-containment-already-retained")
        val captured = linux_container_containment_capture_v1(subject.pid, subject.cgroup_path, binding)
        if val owner = captured.owner:
            # Capture every actual output before checking receipt/snapshot.
            if fresh_workload_states_v2[self.slot].containment.is_none(): fresh_workload_states_v2[self.slot].containment = Some(owner)
            else: fresh_workload_states_v2[self.slot].extra_containment.push(owner)
        if captured.error != "" or captured.owner.is_none() or captured.snapshot.is_none():
            return Err("machine-fresh-workload-native-capture:" + captured.error)
        val snapshot = captured.snapshot.unwrap()
        if snapshot.capture_pid != subject.pid or snapshot.cgroup_path != subject.cgroup_path or snapshot.binding_digest != binding:
            return Err("machine-fresh-workload-native-capture-binding")
        fresh_workload_states_v2[self.slot].captured_subject = Some(snapshot)
        Ok(())

    pub fn validate_subject_v2(custody: LinuxFreshEpochSuccessorCustodyV1, command: LinuxFreshWorkloadCommandV2,
            before: MachineFreshWorkloadInspectV2, after: MachineFreshWorkloadInspectV2) -> Result<text, text>:
        val state = self.state_v2()?
        if before != after or state.captured_subject.is_none(): return Err("machine-fresh-workload-inspect-incarnation-changed")
        val actual = custody.validate_workload_containment_v2(self.containment_v2()?, command)?
        if not linux_oci_containment_same_subject_v1(state.captured_subject.unwrap(), actual):
            return Err("machine-fresh-workload-native-incarnation-changed")
        if actual.state != LinuxContainerContainmentPopulationV1.Populated: return Err("machine-fresh-workload-not-populated")
        # Exact native evidence remains backed by the private retained owner.
        Ok(sha256_text(actual.binding_digest + "\n" + str(actual.capture_pid) + "\n" + str(actual.process_start_ticks) +
            "\n" + actual.cgroup_path + "\n" + str(actual.cgroup_mount_id) + "\n" + str(actual.cgroup_device) + "\n" +
            str(actual.cgroup_inode) + "\n" + str(actual.target_pidns_device) + "\n" + str(actual.target_pidns_inode) + "\n" +
            str(actual.target_cgroupns_device) + "\n" + str(actual.target_cgroupns_inode)))

    pub fn containment_v2() -> Result<LinuxContainerContainmentOwnerV1, text>:
        val state = self.state_v2()?
        if state.containment.is_none(): return Err("machine-fresh-workload-native-containment-missing")
        Ok(state.containment.unwrap())

    pub fn associated_v2() -> Result<(), text>:
        val state = self.state_v2()?
        fresh_workload_states_v2[self.slot].associated = true
        Ok(())

    pub fn settled_v2() -> Result<bool, text>:
        val state = self.state_v2()?
        Ok(state.settled)

    pub fn running_v2(custody: LinuxFreshEpochSuccessorCustodyV1, command: LinuxFreshWorkloadCommandV2) -> Result<LinuxContainerContainmentSnapshotV1, text>:
        val state = self.state_v2()?
        if not state.associated or state.settled or state.uncertain or state.outcome_unknown: return Err("machine-fresh-workload-running-unproven")
        val actual = custody.validate_workload_containment_v2(self.containment_v2()?, command)?
        Ok(actual)

    pub fn prepare_settlement_v2(record: MachineFreshWorkloadRecordV2,
            terminal: DistributedOperationStateV2, at: i64) -> Result<[WalEntry], text>:
        val state = self.state_v2()?
        val absence = state.operations.contains_key("absence") and state.operations["absence"].state == "completed"
        val progress = MachineFreshWorkloadSettlementProgressV2(state.associated,
            state.process.is_none() and state.reference.is_none() and state.extra_containment.len() == 0,
            state.containment.is_some() and state.captured_subject.is_some(), absence,
            state.uncertain or state.outcome_unknown, state.settled, state.permit)
        val ready = machine_fresh_workload_prepare_settlement_v2(progress, record, terminal, at)?
        fresh_workload_states_v2[self.slot].permit = ready.0.phase
        fresh_workload_states_v2[self.slot].settlement = Some(ready.0)
        Ok(ready.1)

    pub fn mark_settled_v2() -> Result<(), text>:
        val state = self.state_v2()?
        # All eligibility was checked and locked before release row creation.
        # Only finalize this exact canonical slot/generation after CAS/readback.
        if state.permit != "settlement-reserved" or state.settlement.is_none(): return Err("machine-fresh-workload-settlement-stale")
        val completed = machine_fresh_workload_finalize_settlement_v2(state.settlement.unwrap())?
        fresh_workload_states_v2[self.slot].settled = completed.settled
        fresh_workload_states_v2[self.slot].permit = completed.phase
        fresh_workload_states_v2[self.slot].settlement = Some(completed)
        Ok(())

    pub fn close_native_v2() -> Result<(), text>:
        val retired = self.retire_helper_v2()?
        val state = self.state_v2()?
        if state.record.is_some() and not state.settled: return Err("machine-fresh-workload-charge-retained")
        while fresh_workload_states_v2[self.slot].extra_containment.len() > 0:
            val owners = fresh_workload_states_v2[self.slot].extra_containment
            val extra = linux_container_containment_close_v1(owners[owners.len() - 1])
            if extra.error != "" and fresh_workload_states_v2[self.slot].error == "": fresh_workload_states_v2[self.slot].error = extra.error
            if not extra.closed or extra.owner.is_some(): return Err("machine-fresh-workload-extra-native-cleanup-retained")
            fresh_workload_states_v2[self.slot].extra_containment = owners[0:owners.len() - 1]
        if val native = state.containment:
            val closed = linux_container_containment_close_v1(native)
            fresh_workload_states_v2[self.slot].containment = closed.owner
            if not closed.closed and closed.owner.is_none(): fresh_workload_states_v2[self.slot].containment = Some(native)
            if closed.error != "" and fresh_workload_states_v2[self.slot].error == "": fresh_workload_states_v2[self.slot].error = closed.error
            if not closed.closed or closed.owner.is_some(): return Err("machine-fresh-workload-containment-cleanup-retained")
        Ok(())

    pub fn diagnostic_v2() -> Result<text, text>:
        val state = self.state_v2()?
        Ok(state.error)

    pub fn closed_v2() -> Result<(), text>:
        val state = self.state_v2()?
        if state.process.is_some() or state.containment.is_some() or (state.record.is_some() and not state.settled):
            return Err("machine-fresh-workload-obligations-retained")
        fresh_workload_states_v2[self.slot].closed = true
        Ok(())

pub fn machine_fresh_workload_lifecycle_open_v2(epoch: MachineFreshEpochRecordV1,
        initial: text) -> Result<MachineFreshWorkloadLifecycleV2, text>:
    val context = fresh_workload_entry_v2()?
    if fresh_workload_states_v2.len() >= 256: return Err("machine-fresh-workload-owner-bound")
    val slot = fresh_workload_states_v2.len()
    fresh_workload_states_v2.push(FreshWorkloadStateV2(epoch: epoch,
        history: MachineFreshWorkloadHistoryV2(epoch, initial, [])))
    Ok(MachineFreshWorkloadLifecycleV2(slot: slot, generation: slot + 1))
