# Installed machine-policy + actual global-state writer composition.
# This factory accepts no caller root, policy, budget, principal or observation.
# SOURCE_ONLY: native journal export admission and Windows execution pending.
use std.common.contracts.container.machine_policy_v1.*
use std.common.contracts.container.execution_v2.ContainerHostObservationV2
use std.common.crypto.sha256.sha256_text
use std.common.text_bytes.{bytes_to_text, utf8_bytes_valid}
use std.nogc_sync_mut.io.machine_storage_owner_v1.*
use std.nogc_sync_mut.io.machine_local_process_principal_v1.*
use std.common.contracts.container.local_principal_v1.MachineLocalPrincipalSnapshotV1
use std.common.contracts.container.cleanup_progress_v1.*
use std.io_runtime.getpid
use std.nogc_sync_mut.io.thread.thread_native_current_id
@when(os="linux"):
use std.nogc_sync_mut.io.linux_machine_process_origin_v1.linux_machine_process_origin_check_v1
@elif(os="windows"):
use std.nogc_sync_mut.io.windows_job_stream_abi_v2.rt_windows_pty_owner_thread_guard_v1
@end
use std.nogc_async_mut.container.providers.linux.engine_policy_v1.linux_oci_engine_policy_decode_v1
use std.nogc_async_mut.container.observation_v2.simple_container_observe_v2
use std.common.contracts.orchestration.host_capacity_v1.HostCapacityV1
use std.nogc_sync_mut.container.machine_claim_record_v1.*
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.*
use std.nogc_sync_mut.container.machine_fresh_epoch_projection_v1.machine_fresh_epoch_project_v1
use std.nogc_sync_mut.container.machine_fresh_epoch_history_v1.*
use std.nogc_sync_mut.container.machine_fresh_epoch_lifecycle_v1.*
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.*
use std.nogc_sync_mut.io.group_process_owner.GroupProcessStreamOwnerV2
use std.nogc_sync_mut.io.process_ops.{PipedProcessRefV1, PipedProcessOwnedSpawnV2, process_spawn_piped_owned_v2}
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamLaunchV2, group_process_stream_template_encode_v3}
use std.nogc_sync_mut.io.time_ops.time_sample_unix_micros_or_failure
# Narrow typed-capability dependency approved for this composition: the leaf
# verifies held native enrollment evidence and imports no Container owner.
# Host policy, deployment and service rules remain outside this module.
use std.nogc_sync_mut.orchestration.host_service_enrollment_proof_v3.{VerifiedHostServiceEnrollmentV3,
    VerifiedHostServiceEnrollmentSnapshotV3}

# Diagnostic projection only. Construction cannot mint the private claim owner.
pub struct MachineManagedClaimSnapshotV1:
    policy_digest: text
    commit_digest: text
    issuer_id: text
    authority_policy_digest: text
    enrollment_digest: text
    credential_digest: text
    physical_host_id: text
    native_machine_id: text
    service_scope_id: text
    backend: text
    provider_identity_digest: text
    provider_generation: i64
    cpu_millis: i64
    memory_bytes: i64

pub class MachineManagedClaimV1:
    authority: MachineContainerAuthorityV1
    record: MachineManagedScopeRecordV1
    commit_digest: text

    pub fn current_v1(proof: VerifiedHostServiceEnrollmentV3) -> Result<MachineManagedClaimSnapshotV1, text>:
        val checked = machine_managed_record_from_proof_v1(self.authority, proof)?
        if machine_managed_scope_record_bytes_v1(checked.0)? != machine_managed_scope_record_bytes_v1(self.record)?:
            return Err("machine-managed-claim-proof-changed")
        val retained = machine_managed_commit_current_v1(self.authority, self.record, self.commit_digest)?
        Ok(machine_managed_claim_snapshot_v1(self.record, self.commit_digest))

    # Stop claim/proof use; close Host journal first, this writer next, borrowed
    # proof files/roots last. Retained writer close keeps those backing owners.
    # This releases only the machine writer, never the durable charge.
    pub fn close_v1() -> text:
        self.authority.close_v1()

    pub fn close_diagnostic_v1() -> text:
        self.authority.close_diagnostic_v1()

# Canonical pair progress is shared by value-copy aliases. It owns no second
# journal or native resource; only the original typed caps may be closed.
struct MachineAuthorityPairStateV1:
    generation: i64
    process_id: i64
    thread_id: i64
    progress: MachineCleanupProgressV1

class MachineAuthorityPairedCleanupV1:
    slot: i64
    generation: i64

class MachineAuthorityLocalProcessV1:
    principal: MachineLocalProcessPrincipalV1
    cleanup: MachineAuthorityPairedCleanupV1

enum MachineAuthorityClosingOwnerV1:
    Reader(MachinePolicyOwnerV1)
    Storage(MachineStorageOwnerV1)

var machine_authority_pairs_v1: [MachineAuthorityPairStateV1] = []
var machine_authority_pair_origin_v1: i64 = 0

pub enum MachineContainerAuthorityCleanupV1:
    Reader(MachinePolicyOwnerV1)
    Storage(MachineStorageOwnerV1)
    ReaderPrincipal(reader: MachinePolicyOwnerV1, local: MachineAuthorityLocalProcessV1)
    StoragePrincipal(storage: MachineStorageOwnerV1, local: MachineAuthorityLocalProcessV1)

pub enum MachineContainerAuthorityOpenV1:
    Rejected(reason: text)
    CleanupRequired(owner: MachineContainerAuthorityCleanupV1, reason: text)
    Ready(owner: MachineContainerAuthorityV1)

pub class MachineContainerAuthorityV1:
    storage: MachineStorageOwnerV1
    policy_digest: text
    selected_backend: text
    selected_provider_digest: text
    selected_linux_uid: i64
    local_principal: Option<MachineAuthorityLocalProcessV1>

    # Metadata only. Every call re-reads the actual held policy and checks its
    # immutable binding; the returned struct cannot construct another owner.
    pub fn current_policy_v1() -> Result<MachineContainerPolicyV1, text>:
        val bytes = self.storage.policy_bytes_v1()?
        val source = machine_authority_policy_text_v1(bytes)?
        if sha256_text(source) != self.policy_digest:
            return Err("machine-container-authority-policy-changed")
        val policy = machine_container_policy_decode_v1(source)?
        val capacity = self.storage.physical_capacity_v1()?
        if policy.cpu_millis > capacity.0 or policy.memory_bytes > capacity.1:
            return Err("machine-container-authority-physical-capacity-exceeded")
        if self.selected_backend == "linux-podman":
            val selected = machine_policy_provider_v1(policy, self.selected_backend)?
            val engine = linux_oci_engine_policy_decode_v1(selected.policy_bytes)?
            if self.selected_linux_uid <= 0 or engine.expected_uid != self.selected_linux_uid:
                return Err("machine-container-authority-linux-service-uid-mismatch")
        if policy.mode == "standalone":
            if self.local_principal == None: return Err("machine-container-authority-local-principal-required")
            val local = self.local_principal.unwrap()
            val current = machine_policy_local_principal_v1(policy, self.selected_backend, local.principal)?
        Ok(policy)

    # The policy codec fixes wire schema V2; exact policy bytes bind by
    # digest. WAL commit revisions are separate from this immutable binding.
    pub fn policy_binding_v1() -> Result<text, text>:
        val policy = self.current_policy_v1()?
        Ok(self.policy_digest)

    pub fn observe_provider_v1() -> Result<ContainerHostObservationV2, text>:
        val policy = self.current_policy_v1()?
        val selected = machine_policy_provider_v1(policy, self.selected_backend)?
        if selected.identity_digest != self.selected_provider_digest:
            return Err("machine-container-authority-provider-changed")
        machine_policy_observe_v1(policy, selected)

    # A commit identifier is an observation, not an execution/delegation grant.
    # The real store stays private inside its native-thread storage capsule.
    pub fn journal_head_v1() -> Result<text, text>:
        val current = self.current_policy_v1()?
        self.storage.wal_head_v1()

    # Direct in-process authorization only. A daemon must pass a separate real
    # peer capability; its self principal cannot authenticate a remote client.
    pub fn validate_local_process_v1(principal: MachineLocalProcessPrincipalV1) -> Result<MachineLocalPrincipalSnapshotV1, text>:
        val policy = self.current_policy_v1()?
        if policy.mode != "standalone": return Err("local-container-managed-authority-required")
        if self.local_principal == None: return Err("machine-container-authority-local-principal-required")
        val local = self.local_principal.unwrap()
        val retained = machine_policy_local_principal_v1(policy, self.selected_backend, local.principal)?
        val actual = machine_policy_local_principal_v1(policy, self.selected_backend, principal)?
        # Distinct genuine owner generations/digests may represent the same
        # process. Compare actual logical identity fields, never a data tag.
        if (actual.platform != retained.platform or actual.principal_id != retained.principal_id or
                actual.process_id != retained.process_id or actual.thread_id != retained.thread_id or
                actual.authority_namespace_id != retained.authority_namespace_id):
            return Err("machine-container-authority-local-process-mismatch")
        Ok(actual)

    # Caller retains this original authority in cleanup BEFORE invoking this
    # method. Every Err preserves that cleanup obligation, including ambiguous
    # publication; the canonical storage owner quarantines failed mutations.
    pub fn managed_claim_v1(proof: VerifiedHostServiceEnrollmentV3) -> Result<MachineManagedClaimV1, text>:
        val checked = machine_managed_record_from_proof_v1(self, proof)?
        val record = checked.0
        val verified = checked.1
        val head = self.storage.wal_head_v1()?
        if head == "":
            if verified.recover_only: return Err("machine-managed-claim-recovery-without-charge")
            # A new machine WAL cannot establish absence of legacy per-Host
            # journals or live workloads. No existing whole-provider writer
            # fence/adoption proof is available; missing state never grants
            # fresh capacity. Caller retains this actual writer for cleanup.
            return Err("machine-managed-claim-migration-fence-unavailable")
        # Only one immutable whole-scope transaction is supported. A different
        # binding or unknown history never resets the scope or frees capacity.
        val retained = machine_managed_commit_current_v1(self, record, head)?
        val claim = MachineManagedClaimV1(authority: self, record: record, commit_digest: head)
        val current = claim.current_v1(proof)?
        Ok(claim)

    pub fn close_v1() -> text:
        machine_authority_close_principal_v1(MachineAuthorityClosingOwnerV1.Storage(self.storage), self.local_principal)

    pub fn close_diagnostic_v1() -> text:
        machine_authority_pair_diagnostic_v1(self.local_principal)

    pub fn admit_fresh_provider_epoch_v1(epoch: LinuxInstalledFreshEpochOwnerV1) -> MachineFreshEpochAdmissionTurnV1:
        var retained = MachineFreshEpochAdmissionTurnV1(authority: Some(self), preparation: Some(epoch))
        val projected = machine_authority_fresh_record_v1(self, epoch.current_v1())
        if projected.is_err():
            retained.error = projected.unwrap_err()
            return retained
        val candidate = projected.unwrap()
        val head = self.storage.fresh_epoch_head_v1(epoch, candidate)
        if head.is_err():
            retained.error = head.unwrap_err()
            return retained
        var commit = head.unwrap()
        if commit == "":
            val written = self.storage.fresh_epoch_commit_v1(epoch, candidate)
            if written.is_err():
                retained.error = "machine-fresh-epoch-publication-uncertain:" + written.unwrap_err()
                return retained
            commit = written.unwrap().digest
        retained.commit_digest = commit
        val original = machine_fresh_epoch_read_initial_v1(self.storage, commit)
        if original.is_err():
            retained.error = original.unwrap_err()
            return retained
        val record = original.unwrap()
        val existing_binding = machine_fresh_epoch_stable_v1(record)
        val candidate_binding = machine_fresh_epoch_stable_v1(candidate)
        if existing_binding.is_err() or candidate_binding.is_err():
            retained.error = "machine-fresh-epoch-existing-binding-invalid"
            return retained
        if existing_binding.unwrap() != candidate_binding.unwrap():
            retained.error = "machine-fresh-epoch-existing-binding-differs"
            return retained
        # The original writer remains held across the canonical lower handoff.
        # Capture both actual outputs before interpreting its status/error.
        val transferred = epoch.consume_preparation_v1()
        retained.preparation = transferred.preparation
        retained.successor = transferred.successor
        if transferred.error != "" or transferred.successor.is_none():
            retained.error = if transferred.error != "": transferred.error else: "machine-fresh-epoch-custody-missing"
            return retained
        val custody = transferred.successor.unwrap()
        val actual = custody.current_v1()
        if actual.is_err():
            retained.error = actual.unwrap_err()
            return retained
        val lifecycle = machine_fresh_epoch_lifecycle_open_v1()
        if lifecycle.is_err():
            retained.error = lifecycle.unwrap_err()
            return retained
        val owner = MachineFreshEpochAdmissionOwnerV1(authority: Some(self), custody: Some(custody), record: record,
            initial_commit: commit, custody_generation: actual.unwrap().owner_generation, lifecycle: lifecycle.unwrap(), error: "")
        val current = owner.current_v1()
        if current.is_err():
            retained.error = current.unwrap_err()
            return retained
        retained.owner = Some(owner)
        retained.authority = nil
        retained.successor = nil
        retained

pub struct MachineFreshEpochAdmissionTurnV1:
    owner: Option<MachineFreshEpochAdmissionOwnerV1> = nil
    authority: Option<MachineContainerAuthorityV1> = nil
    preparation: Option<LinuxInstalledFreshEpochOwnerV1> = nil
    successor: Option<LinuxFreshEpochSuccessorCustodyV1> = nil
    cleanup: Option<MachineContainerAuthorityCleanupV1> = nil
    commit_digest: text = ""
    error: text = ""

pub struct MachineFreshEpochCloseTurnV1:
    owner: Option<MachineFreshEpochAdmissionOwnerV1>
    closed: bool
    error: text

pub struct MachineFreshEpochProviderStartTurnV1:
    owner: MachineFreshEpochAdmissionOwnerV1
    process: Option<GroupProcessStreamOwnerV2> = nil
    reference: Option<PipedProcessRefV1> = nil
    fallback: Option<MachineFreshEpochProcessCleanupV1> = nil
    started: bool = false
    error: text = ""

# Private construction requires the actual original writer, exact durable
# charge, genuine transferred custody and a private canonical creator slot.
pub class MachineFreshEpochAdmissionOwnerV1:
    authority: Option<MachineContainerAuthorityV1>
    custody: Option<LinuxFreshEpochSuccessorCustodyV1>
    record: MachineFreshEpochRecordV1
    initial_commit: text
    custody_generation: i64
    lifecycle: MachineFreshEpochLifecycleV1
    error: text

    pub fn current_v1() -> Result<MachineFreshEpochRecordV1, text>:
        val phase = self.lifecycle.phase_v1()?
        if not ["admitted", "intent-committed", "launch-attempted"].contains(phase):
            return Err("machine-fresh-epoch-admission-not-current:" + phase)
        if self.authority.is_none() or self.custody.is_none(): return Err("machine-fresh-epoch-owner-consumed")
        val authority = self.authority.unwrap()
        val custody = self.custody.unwrap()
        val actual = custody.current_v1()?
        if actual.owner_generation != self.custody_generation: return Err("machine-fresh-epoch-successor-generation")
        val projected = machine_authority_fresh_record_v1(authority, Ok(actual))?
        if machine_fresh_epoch_stable_v1(projected)? != machine_fresh_epoch_stable_v1(self.record)?:
            return Err("machine-fresh-epoch-successor-binding")
        val current = machine_fresh_epoch_verify_history_v1(authority.storage, self.record, self.initial_commit,
            self.lifecycle.intent_commit_v1()?, self.lifecycle.template_v1()?, self.lifecycle.deadline_v1()?, self.lifecycle.intent_at_v1()?)?
        Ok(self.record)

    fn prepare_provider_v1(template: GroupProcessStreamLaunchV2) -> Result<GroupProcessStreamLaunchV2, text>:
        val checked = self.current_v1()?
        if self.lifecycle.phase_v1()? != "admitted": return Err("machine-fresh-epoch-creator-already-attempted")
        val custody = self.custody.unwrap()
        val bound = custody.bind_profiled_launch_v1(template)?
        val valid = custody.validate_profiled_launch_v1(bound)?
        val wire = group_process_stream_template_encode_v3(bound)?
        val micros = time_sample_unix_micros_or_failure()
        if micros <= 0: return Err("machine-fresh-epoch-launch-clock")
        val at = micros / 1000
        if at > 9223372036854770807: return Err("machine-fresh-epoch-launch-clock")
        val deadline = at + 5000
        val entries = machine_fresh_epoch_creator_entries_v1(self.record, wire, deadline, at)?
        val attempted = self.lifecycle.begin_intent_v1(sha256_text(wire), wire, deadline, at)?
        val authority = self.authority.unwrap()
        val committed = authority.storage.wal_commit_v1(self.initial_commit, entries)?
        val tracked = self.lifecycle.commit_intent_v1(committed.digest)?
        val current = self.current_v1()?
        val revalidated = custody.validate_profiled_launch_v1(bound)?
        # Irreversible once-only consumption occurs BEFORE the native call.
        val consumed = self.lifecycle.consume_launch_v1()?
        var launch = bound
        launch.request.launch_deadline_unix_ms = deadline
        Ok(launch)

    pub fn start_provider_v1(template: GroupProcessStreamLaunchV2) -> MachineFreshEpochProviderStartTurnV1:
        var retained = MachineFreshEpochProviderStartTurnV1(owner: self)
        val initial_phase = self.lifecycle.phase_v1()
        if initial_phase.is_err():
            retained.error = initial_phase.unwrap_err()
            return retained
        val planned = self.prepare_provider_v1(template)
        if planned.is_err():
            retained.error = planned.unwrap_err()
            val phase = self.lifecycle.phase_v1()
            if initial_phase.unwrap() == "admitted" and phase.is_ok() and phase.unwrap() != "admitted":
                val quarantined = self.lifecycle.unknown_v1(retained.error)
            return retained
        val fallback = self.lifecycle.reserve_process_cleanup_v1()
        if fallback.is_err():
            retained.error = fallback.unwrap_err()
            return retained
        retained.fallback = Some(fallback.unwrap())
        match process_spawn_piped_owned_v2(planned.unwrap()):
            case PipedProcessOwnedSpawnV2.Rejected(reason):
                retained.error = if reason != "": reason else: "machine-fresh-epoch-native-rejected"
                val rejected = self.lifecycle.native_rejected_v1(retained.error)
            case PipedProcessOwnedSpawnV2.Ready(process, reference):
                retained.process = Some(process)
                retained.reference = Some(reference)
            case PipedProcessOwnedSpawnV2.CleanupRequired(process, reference, reason):
                retained.process = Some(process)
                retained.reference = reference
                retained.error = if reason != "": reason else: "machine-fresh-epoch-native-cleanup-required"
        # Retain actual native outputs before any fallible registry/postcheck.
        if val process = retained.process:
            val attached = self.lifecycle.attach_process_v1(process, retained.reference)
            if attached.is_err():
                if retained.error == "": retained.error = attached.unwrap_err()
                return retained
            retained.process = nil
            retained.reference = nil
            retained.fallback = nil
        if retained.error == "":
            val process = self.lifecycle.process_current_v1()
            val current = self.current_v1()
            if process.is_err(): retained.error = process.unwrap_err()
            elif current.is_err(): retained.error = current.unwrap_err()
        if retained.error != "":
            val quarantined = self.lifecycle.unknown_v1(retained.error)
            return retained
        retained.started = true
        retained

    pub fn provider_process_current_v1() -> Result<MachineFreshEpochRecordV1, text>:
        val current = self.current_v1()?
        val process = self.lifecycle.process_current_v1()?
        Ok(current)

    pub fn initial_commit_v1() -> Result<text, text>:
        val current = self.current_v1()?
        Ok(self.initial_commit)

    fn pending_close_v1(error: text, fallback: text = "") -> MachineFreshEpochCloseTurnV1:
        var retained = self
        val recorded = retained.lifecycle.retain_diagnostic_v1(error)
        if recorded.is_ok(): retained.error = recorded.unwrap()
        elif retained.error == "": retained.error = if error != "": error else: fallback
        MachineFreshEpochCloseTurnV1(Some(retained), false,
            if retained.error != "": retained.error else: fallback)

    pub fn close_v1() -> MachineFreshEpochCloseTurnV1:
        var retained = self
        val phase = retained.lifecycle.phase_v1()
        if phase.is_err(): return MachineFreshEpochCloseTurnV1(Some(retained), false, phase.unwrap_err())
        if phase.unwrap() == "closed":
            val diagnostic = retained.lifecycle.diagnostic_v1()
            if diagnostic.is_err(): return MachineFreshEpochCloseTurnV1(Some(retained), false, diagnostic.unwrap_err())
            return MachineFreshEpochCloseTurnV1(nil, true, diagnostic.unwrap())
        val diagnostic = retained.lifecycle.diagnostic_v1()
        if retained.error == "" and diagnostic.is_ok(): retained.error = diagnostic.unwrap()
        val closing = retained.lifecycle.closing_v1()
        if closing.is_err(): return MachineFreshEpochCloseTurnV1(Some(retained), false, closing.unwrap_err())
        val process = retained.lifecycle.close_process_v1()
        if process.is_err(): return retained.pending_close_v1(process.unwrap_err())
        if val authority = retained.authority:
            val state = authority.close_v1()
            val diagnostic = authority.close_diagnostic_v1()
            if ["released", "consumed-error"].contains(state): retained.authority = nil
            var actual_error = diagnostic
            if actual_error == "" and state == "consumed-error": actual_error = "machine-fresh-epoch-writer-consumed-error"
            val recorded = retained.lifecycle.retain_diagnostic_v1(actual_error)
            if recorded.is_err(): return retained.pending_close_v1(actual_error, recorded.unwrap_err())
            retained.error = recorded.unwrap()
            if not ["released", "consumed-error"].contains(state):
                if state != "retained": return retained.pending_close_v1("machine-fresh-epoch-writer-close:" + state)
                return retained.pending_close_v1("", "machine-fresh-epoch-writer-close:" + state)
        if val custody = retained.custody:
            val closed = custody.close_v1()
            retained.custody = closed.owner
            if not closed.closed and retained.custody.is_none(): retained.custody = Some(custody)
            val recorded = retained.lifecycle.retain_diagnostic_v1(closed.error)
            if recorded.is_err(): return retained.pending_close_v1(closed.error, recorded.unwrap_err())
            retained.error = recorded.unwrap()
            if not closed.closed or retained.custody.is_some():
                return retained.pending_close_v1("", closed.error)
        val closed = retained.lifecycle.closed_v1(retained.error)
        if closed.is_err(): return MachineFreshEpochCloseTurnV1(Some(retained), false, closed.unwrap_err())
        val final_error = retained.lifecycle.diagnostic_v1()
        if final_error.is_err(): return retained.pending_close_v1("", final_error.unwrap_err())
        MachineFreshEpochCloseTurnV1(nil, true, final_error.unwrap())

fn machine_authority_fresh_record_v1(authority: MachineContainerAuthorityV1,
        observed: Result<LinuxFreshEpochObservationV1, text>) -> Result<MachineFreshEpochRecordV1, text>:
    val actual = observed?
    val policy = authority.current_policy_v1()?
    if authority.selected_backend != "linux-podman" or actual.machine_policy_digest != authority.policy_digest:
        return Err("machine-fresh-epoch-machine-policy-binding")
    if authority.local_principal.is_none(): return Err("machine-fresh-epoch-local-principal-required")
    val local = authority.local_principal.unwrap()
    val principal = authority.validate_local_process_v1(local.principal)?
    machine_fresh_epoch_project_v1(actual, policy, principal, authority.storage.physical_capacity_v1()?)

fn machine_authority_policy_text_v1(bytes: [u8]) -> Result<text, text>:
    if bytes.len() == 0 or bytes.len() > 1048576 or not utf8_bytes_valid(bytes):
        return Err("machine-container-authority-policy-utf8")
    Ok(bytes_to_text(bytes))

fn machine_policy_provider_v1(policy: MachineContainerPolicyV1,
        backend: text) -> Result<MachineContainerProviderPolicyV1, text>:
    var selected: Option<MachineContainerProviderPolicyV1> = None
    for provider in policy.providers:
        if provider.backend == backend:
            if selected != None: return Err("machine-container-authority-provider-ambiguous")
            selected = Some(provider)
    if selected == None: return Err("machine-container-authority-provider-unconfigured")
    Ok(selected.unwrap())

fn machine_policy_local_principal_v1(policy: MachineContainerPolicyV1, backend: text,
        principal: MachineLocalProcessPrincipalV1) -> Result<MachineLocalPrincipalSnapshotV1, text>:
    if policy.mode != "standalone": return Err("local-container-managed-authority-required")
    val actual = principal.current_v1()?
    val expected = if backend == "linux-podman": "linux" else: "windows"
    if actual.platform != expected: return Err("machine-container-authority-local-principal-platform")
    if not policy.local_principals.contains(actual.principal_id):
        return Err("machine-container-authority-local-principal-unconfigured")
    Ok(actual)

fn machine_policy_observe_v1(policy: MachineContainerPolicyV1,
        provider: MachineContainerProviderPolicyV1) -> Result<ContainerHostObservationV2, text>:
    # Execute the actual common provider observer; no decoded observation is
    # accepted from an app, remote request, policy document or this caller.
    val observed = simple_container_observe_v2(provider.backend, provider.policy_bytes)?
    if (observed.native_machine_id != policy.native_machine_id or
            observed.provider_identity_digest != provider.identity_digest):
        return Err("machine-container-authority-native-provider-mismatch")
    Ok(observed)

fn machine_managed_record_from_proof_v1(authority: MachineContainerAuthorityV1,
        proof: VerifiedHostServiceEnrollmentV3) -> Result<(MachineManagedScopeRecordV1, VerifiedHostServiceEnrollmentSnapshotV3), text>:
    val policy = authority.current_policy_v1()?
    if policy.mode != "managed": return Err("machine-managed-claim-policy-mode")
    val verified = proof.current_v3()?
    val binding = verified.binding
    # The protected machine policy supplies the trust pin. A valid signature
    # under caller-selected keys or the same issuer spelling is insufficient.
    if verified.issuer_id != policy.managed_authority_id:
        return Err("machine-managed-claim-controller-mismatch")
    if verified.authority_policy_digest != policy.managed_authority_policy_digest:
        return Err("machine-managed-claim-authority-policy-mismatch")
    if (binding.physical_host_id != policy.physical_host_id or binding.native_machine_id != policy.native_machine_id or
            binding.backend != authority.selected_backend or binding.provider_identity_digest != authority.selected_provider_digest):
        return Err("machine-managed-claim-machine-provider-mismatch")
    val selected = machine_policy_provider_v1(policy, authority.selected_backend)?
    if sha256_text(selected.policy_bytes) != binding.engine_policy_digest:
        return Err("machine-managed-claim-engine-policy-mismatch")
    val observed = authority.observe_provider_v1()?
    val record = MachineManagedScopeRecordV1(policy_digest: authority.policy_digest,
        authority_policy_digest: verified.authority_policy_digest, issuer_id: verified.issuer_id,
        enrollment_digest: verified.enrollment_digest, credential_digest: verified.credential_digest,
        physical_host_id: binding.physical_host_id, native_machine_id: binding.native_machine_id,
        service_scope_id: binding.service_scope_id, backend: binding.backend,
        provider_identity_digest: binding.provider_identity_digest, provider_generation: verified.provider_generation,
        cpu_millis: binding.physical_cpu_millis, memory_bytes: binding.physical_memory_bytes, expires_at: verified.expires_at)
    # The complete signed ceiling includes the broker partition. Only nested
    # Host accounting may subdivide it; another provider gets no parallel pool.
    # This fence hashes actual observation; it asserts no native continuity.
    val observed_fence = sha256_text(machine_observation_fence_v1(observed))
    val available = machine_managed_scope_capacity_v1(HostCapacityV1(physical_host_id: policy.physical_host_id,
        authority_id: policy.authority_id, boot_id: observed_fence, provider_generation: verified.provider_generation,
        cpu_millis: policy.cpu_millis, memory_bytes: policy.memory_bytes, exclusive_devices: []), record)?
    Ok((record, verified))

fn machine_observation_fence_v1(observed: ContainerHostObservationV2) -> text:
    # Length-prefix each actual observed component to avoid delimiter aliases.
    var parts: [text] = []
    for value in [observed.native_machine_id, observed.native_boot_id,
            observed.boot_observation, observed.continuity_assurance]:
        parts.push("{value.byte_len()}:{value}")
    parts.join("")

fn machine_managed_commit_current_v1(authority: MachineContainerAuthorityV1,
        record: MachineManagedScopeRecordV1, commit: text) -> Result<bool, text>:
    val head = authority.storage.wal_head_v1()?
    if commit == "" or head != commit: return Err("machine-managed-claim-commit-changed")
    val revision = authority.storage.wal_revision_v1(commit)?
    if revision.digest != commit or revision.parent != "" or revision.first_sequence != 1 or revision.last_sequence != 2:
        return Err("machine-managed-claim-unknown-history")
    val entries = authority.storage.wal_segment_v1(revision)?
    machine_managed_scope_replay_v1(entries, record)

fn machine_managed_claim_snapshot_v1(record: MachineManagedScopeRecordV1, commit: text) -> MachineManagedClaimSnapshotV1:
    MachineManagedClaimSnapshotV1(policy_digest: record.policy_digest, commit_digest: commit,
        issuer_id: record.issuer_id, authority_policy_digest: record.authority_policy_digest,
        enrollment_digest: record.enrollment_digest, credential_digest: record.credential_digest,
        physical_host_id: record.physical_host_id, native_machine_id: record.native_machine_id,
        service_scope_id: record.service_scope_id, backend: record.backend,
        provider_identity_digest: record.provider_identity_digest, provider_generation: record.provider_generation,
        cpu_millis: record.cpu_millis, memory_bytes: record.memory_bytes)

fn machine_reader_failure_v1(reader: MachinePolicyOwnerV1,
        reason: text, principal: Option<MachineAuthorityLocalProcessV1> = None) -> MachineContainerAuthorityOpenV1:
    if val owner = principal:
        return MachineContainerAuthorityOpenV1.CleanupRequired(MachineContainerAuthorityCleanupV1.ReaderPrincipal(reader, owner), reason)
    MachineContainerAuthorityOpenV1.CleanupRequired(MachineContainerAuthorityCleanupV1.Reader(reader), reason)

fn machine_storage_failure_v1(storage: MachineStorageOwnerV1,
        reason: text, principal: Option<MachineAuthorityLocalProcessV1> = None) -> MachineContainerAuthorityOpenV1:
    if val owner = principal:
        return MachineContainerAuthorityOpenV1.CleanupRequired(MachineContainerAuthorityCleanupV1.StoragePrincipal(storage, owner), reason)
    MachineContainerAuthorityOpenV1.CleanupRequired(MachineContainerAuthorityCleanupV1.Storage(storage), reason)

fn machine_authority_pair_entry_v1() -> Result<(), text>:
    # Enter the genuine native origin guard before touching inherited registry
    # state. Numeric PID/TID can collide in a forked PID namespace.
    @when(os="linux"):
    linux_machine_process_origin_check_v1()
    @elif(os="windows"):
    val status = unsafe(capabilities: [ffi]): rt_windows_pty_owner_thread_guard_v1()
    if status != 1: return Err("machine-authority-cleanup-native-context-required")
    Ok(())
    @else:
    Err("machine-authority-cleanup-host-unsupported")
    @end

fn machine_authority_pair_open_v1() -> Result<MachineAuthorityPairedCleanupV1, text>:
    val entered = machine_authority_pair_entry_v1()?
    val pid = getpid()
    val tid = thread_native_current_id()
    if pid <= 0 or tid <= 0: return Err("machine-authority-cleanup-context-unavailable")
    if machine_authority_pair_origin_v1 != 0 and machine_authority_pair_origin_v1 != pid:
        return Err("machine-authority-cleanup-foreign-process")
    if machine_authority_pairs_v1.len() >= 100000: return Err("machine-authority-cleanup-owner-bound")
    machine_authority_pair_origin_v1 = pid
    val slot = machine_authority_pairs_v1.len()
    machine_authority_pairs_v1.push(MachineAuthorityPairStateV1(generation: slot + 1,
        process_id: pid, thread_id: tid, progress: machine_cleanup_progress_initial_v1()))
    Ok(MachineAuthorityPairedCleanupV1(slot: slot, generation: slot + 1))

fn machine_authority_pair_current_v1(owner: MachineAuthorityPairedCleanupV1) -> Result<MachineAuthorityPairStateV1, text>:
    val entered = machine_authority_pair_entry_v1()?
    val pid = getpid()
    val tid = thread_native_current_id()
    if pid != machine_authority_pair_origin_v1: return Err("machine-authority-cleanup-foreign-process")
    if owner.slot < 0 or owner.slot >= machine_authority_pairs_v1.len(): return Err("machine-authority-cleanup-stale")
    val state = machine_authority_pairs_v1[owner.slot]
    if state.generation != owner.generation: return Err("machine-authority-cleanup-stale")
    if state.process_id != pid or state.thread_id != tid: return Err("machine-authority-cleanup-foreign-thread")
    Ok(state)

fn machine_authority_close_native_v1(owner: MachineAuthorityClosingOwnerV1) -> text:
    match owner:
        case MachineAuthorityClosingOwnerV1.Reader(reader): reader.close_v1()
        case MachineAuthorityClosingOwnerV1.Storage(storage): storage.close_v1()

fn machine_authority_close_principal_v1(owner: MachineAuthorityClosingOwnerV1,
        principal: Option<MachineAuthorityLocalProcessV1>) -> text:
    if principal == None: return machine_authority_close_native_v1(owner)
    val local = principal.unwrap()
    val current = machine_authority_pair_current_v1(local.cleanup)
    if current.is_err(): return "retained"
    var state = current.unwrap()
    if not state.progress.machine_consumed:
        # Only positive consumption clears this originally held component.
        # Unknown/stale stays live; prior canonical closed state skips this call.
        val closed = machine_authority_close_native_v1(owner)
        state.progress = machine_cleanup_progress_record_v1(state.progress, MachineCleanupComponentV1.Machine, closed)
        machine_authority_pairs_v1[local.cleanup.slot] = state
    if not state.progress.machine_consumed: return "retained"
    if not state.progress.principal_consumed:
        val closed = local.principal.close_v1()
        state.progress = machine_cleanup_progress_record_v1(state.progress, MachineCleanupComponentV1.Principal, closed)
        machine_authority_pairs_v1[local.cleanup.slot] = state
    machine_cleanup_progress_status_v1(state.progress)

fn machine_authority_pair_diagnostic_v1(principal: Option<MachineAuthorityLocalProcessV1>) -> text:
    if principal == None: return ""
    val local = principal.unwrap()
    val state = machine_authority_pair_current_v1(local.cleanup)
    if state.is_err(): return ""
    val current = state.unwrap()
    current.progress.first_diagnostic

pub fn machine_container_authority_cleanup_v1(owner: MachineContainerAuthorityCleanupV1) -> text:
    match owner:
        case MachineContainerAuthorityCleanupV1.Reader(reader): reader.close_v1()
        case MachineContainerAuthorityCleanupV1.Storage(storage): storage.close_v1()
        case MachineContainerAuthorityCleanupV1.ReaderPrincipal(reader, principal):
            machine_authority_close_principal_v1(MachineAuthorityClosingOwnerV1.Reader(reader), Some(principal))
        case MachineContainerAuthorityCleanupV1.StoragePrincipal(storage, principal):
            machine_authority_close_principal_v1(MachineAuthorityClosingOwnerV1.Storage(storage), Some(principal))

pub fn machine_container_authority_cleanup_diagnostic_v1(owner: MachineContainerAuthorityCleanupV1) -> text:
    match owner:
        case MachineContainerAuthorityCleanupV1.Reader(_): ""
        case MachineContainerAuthorityCleanupV1.Storage(_): ""
        case MachineContainerAuthorityCleanupV1.ReaderPrincipal(_, local): machine_authority_pair_diagnostic_v1(Some(local))
        case MachineContainerAuthorityCleanupV1.StoragePrincipal(_, local): machine_authority_pair_diagnostic_v1(Some(local))

pub fn machine_container_authority_open_v1() -> MachineContainerAuthorityOpenV1:
    machine_authority_open_internal_v1(false)

pub fn machine_container_authority_open_local_v1() -> MachineContainerAuthorityOpenV1:
    machine_authority_open_internal_v1(true)

# A genuine preparation capability is retained before opening the original
# writer. Generic opening and generic missing-CURRENT behavior are unchanged.
pub fn machine_container_authority_open_fresh_epoch_v1() -> MachineFreshEpochAdmissionTurnV1:
    var retained = MachineFreshEpochAdmissionTurnV1()
    val epoch = match linux_installed_fresh_epoch_open_v1():
        case LinuxFreshEpochOpenV1.Rejected(reason):
            retained.error = reason
            return retained
        case LinuxFreshEpochOpenV1.CleanupRequired(owner, reason):
            retained.preparation = Some(owner)
            retained.error = reason
            return retained
        case LinuxFreshEpochOpenV1.Ready(owner): owner
    retained.preparation = Some(epoch)
    match machine_authority_open_internal_v1(true, Some(epoch)):
        case MachineContainerAuthorityOpenV1.Rejected(reason): retained.error = reason
        case MachineContainerAuthorityOpenV1.CleanupRequired(owner, reason):
            retained.cleanup = Some(owner)
            retained.error = reason
        case MachineContainerAuthorityOpenV1.Ready(owner): return owner.admit_fresh_provider_epoch_v1(epoch)
    retained

# This private selector can only restrict mode. It never supplies authority,
# principal identity, namespace provenance or a capacity grant.
fn machine_authority_open_internal_v1(standalone_only: bool,
        fresh: Option<LinuxInstalledFreshEpochOwnerV1> = nil) -> MachineContainerAuthorityOpenV1:
    # The library selects the actual installed OS owner. No app/request picks
    # the backend, policy path, service UID or machine-state root.
    val reader = match machine_policy_open_v1():
        case MachinePolicyOpenV1.Rejected(reason):
            return MachineContainerAuthorityOpenV1.Rejected(reason)
        case MachinePolicyOpenV1.CleanupRequired(owner, reason):
            return machine_reader_failure_v1(owner, reason)
        case MachinePolicyOpenV1.Ready(owner): owner
    val bytes = reader.read_policy_v1()
    if bytes.is_err(): return machine_reader_failure_v1(reader, bytes.unwrap_err())
    val text_result = machine_authority_policy_text_v1(bytes.unwrap())
    if text_result.is_err(): return machine_reader_failure_v1(reader, text_result.unwrap_err())
    val source = text_result.unwrap()
    val decoded = machine_container_policy_decode_v1(source)
    if decoded.is_err(): return machine_reader_failure_v1(reader, decoded.unwrap_err())
    val policy = decoded.unwrap()
    if standalone_only and policy.mode != "standalone":
        return machine_reader_failure_v1(reader, "local-container-managed-authority-required")
    # Platform selection belongs here in the library, never in the app request.
    val backend = reader.selected_backend_v1()
    val selected = machine_policy_provider_v1(policy, backend)
    if selected.is_err(): return machine_reader_failure_v1(reader, selected.unwrap_err())
    val provider = selected.unwrap()
    var selected_linux_uid: i64 = -1
    if backend == "linux-podman":
        val context = reader.actual_linux_process_context_v1()
        if context.is_err(): return machine_reader_failure_v1(reader, context.unwrap_err())
        val engine = linux_oci_engine_policy_decode_v1(provider.policy_bytes)
        if engine.is_err(): return machine_reader_failure_v1(reader, engine.unwrap_err())
        val actual = context.unwrap()
        val configured = engine.unwrap()
        if actual.real_uid != actual.effective_uid or actual.effective_uid <= 0 or configured.expected_uid != actual.effective_uid:
            return machine_reader_failure_v1(reader, "machine-container-authority-linux-service-uid-mismatch")
        selected_linux_uid = actual.effective_uid
    var principal: Option<MachineAuthorityLocalProcessV1> = None
    if policy.mode == "standalone":
        val paired = machine_authority_pair_open_v1()
        if paired.is_err(): return machine_reader_failure_v1(reader, paired.unwrap_err())
        val cleanup = paired.unwrap()
        match machine_local_process_principal_open_v1():
            case MachineLocalProcessPrincipalOpenV1.Rejected(reason): return machine_reader_failure_v1(reader, reason)
            case MachineLocalProcessPrincipalOpenV1.CleanupRequired(owner, reason):
                return machine_reader_failure_v1(reader, reason, Some(MachineAuthorityLocalProcessV1(principal: owner, cleanup: cleanup)))
            case MachineLocalProcessPrincipalOpenV1.Ready(owner):
                principal = Some(MachineAuthorityLocalProcessV1(principal: owner, cleanup: cleanup))
        # Native membership is established before any provider observer runs.
        val local = principal.unwrap()
        val member = machine_policy_local_principal_v1(policy, backend, local.principal)
        if member.is_err(): return machine_reader_failure_v1(reader, member.unwrap_err(), principal)
    # The generic path retains its engine observation. Fresh opening must not
    # initialize the new provider store before its actual durable admission.
    if fresh.is_none():
        val observed = machine_policy_observe_v1(policy, provider)
        if observed.is_err(): return machine_reader_failure_v1(reader, observed.unwrap_err(), principal)
    else:
        val epoch = fresh.unwrap()
        val observed = epoch.current_v1()
        if observed.is_err(): return machine_reader_failure_v1(reader, observed.unwrap_err(), principal)
        if backend != "linux-podman": return machine_reader_failure_v1(reader, "machine-fresh-epoch-linux-required", principal)
    val storage = match reader.open_storage_v1():
        case MachineStorageOpenV1.Rejected(reason):
            return machine_reader_failure_v1(reader, reason, principal)
        case MachineStorageOpenV1.CleanupRequired(owner, reason):
            return machine_storage_failure_v1(owner, reason, principal)
        case MachineStorageOpenV1.Ready(owner): owner
    if val owner = principal:
        val member = machine_policy_local_principal_v1(policy, backend, owner.principal)
        if member.is_err(): return machine_storage_failure_v1(storage, member.unwrap_err(), principal)
    # Observe again after acquiring the shared writer. A pre-lock observation
    # never authorizes state publication or a later provider effect by itself.
    if fresh.is_none():
        val current = machine_policy_observe_v1(policy, provider)
        if current.is_err(): return machine_storage_failure_v1(storage, current.unwrap_err(), principal)
    val capacity = storage.physical_capacity_v1()
    if capacity.is_err(): return machine_storage_failure_v1(storage, capacity.unwrap_err(), principal)
    if policy.cpu_millis > capacity.unwrap().0 or policy.memory_bytes > capacity.unwrap().1:
        return machine_storage_failure_v1(storage, "machine-container-authority-physical-capacity-exceeded", principal)
    # Bind exact actual protected policy under the actual exclusive writer.
    # Existing different mode/policy wins; no automatic reset discards charges.
    val bound = storage.bind_policy_v1(source)
    if bound.is_err(): return machine_storage_failure_v1(storage, bound.unwrap_err(), principal)
    if bound.unwrap() != sha256_text(source):
        return machine_storage_failure_v1(storage, "machine-container-authority-policy-binding-mismatch", principal)
    val authority = MachineContainerAuthorityV1(storage: storage, policy_digest: bound.unwrap(), selected_backend: provider.backend,
        selected_provider_digest: provider.identity_digest, selected_linux_uid: selected_linux_uid, local_principal: principal)
    if val epoch = fresh:
        val candidate = machine_authority_fresh_record_v1(authority, epoch.current_v1())
        if candidate.is_err(): return machine_storage_failure_v1(storage, candidate.unwrap_err(), principal)
        val head = storage.fresh_epoch_head_v1(epoch, candidate.unwrap())
        if head.is_err(): return machine_storage_failure_v1(storage, head.unwrap_err(), principal)
        return MachineContainerAuthorityOpenV1.Ready(authority)
    val head = storage.wal_head_v1()
    if head.is_err(): return machine_storage_failure_v1(storage, head.unwrap_err(), principal)
    MachineContainerAuthorityOpenV1.Ready(authority)
