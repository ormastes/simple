# Read-only implementation factoring of the ORIGINAL canonical lifecycle.
# Real native/source caps are passed directly by that owner; no registry,
# constructor, writer, mutation grant or snapshot-to-owner promotion exists.
use std.nogc_sync_mut.container.machine_fresh_workload_dispatch_v3.*
use std.nogc_sync_mut.container.machine_fresh_workload_inspect_v2.*
use std.nogc_sync_mut.container.machine_fresh_workspace_record_v3.machine_fresh_workspace_binding_bytes_v3
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.{MachineFreshEpochRecordV1, machine_fresh_epoch_record_bytes_v1}
use std.nogc_sync_mut.container.machine_fresh_workload_record_v2.machine_fresh_workload_image_id_v2
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxFreshEpochSuccessorCustodyV1
use std.nogc_sync_mut.io.linux_fresh_workspace_binding_v3.LinuxFreshWorkspaceBindingV3
use std.nogc_sync_mut.io.linux_container_containment_v1.*
use std.nogc_async_mut.container.shared.input_configuration_query_v1.{configuration_selected_parse_v2, configuration_selected_observation_v2}
use std.nogc_async_mut.container.providers.linux.containment_v1.linux_oci_containment_same_subject_v1
use std.common.contracts.container.linux_fresh_workspace_v3.{LinuxFreshWorkspaceCommandV3, LinuxFreshWorkspacePrimaryObservationTurnV3}
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.common.contracts.distributed_operation_state_v2.DistributedOperationStateV2
use std.common.crypto.sha256.sha256_text

fn observation_output_v3(outputs: Dict<text, text>, name: text) -> Result<text, text>:
    if not outputs.contains_key(name): return Err("machine-fresh-workload-output-missing")
    Ok(outputs[name])

pub(package) fn machine_fresh_configuration_observe_v3(record: MachineFreshWorkloadRecordDispatchV3,
        epoch: MachineFreshEpochRecordV1, kind: LinuxFreshWorkloadActionV2, ordinal: i64,
        operations: Dict<text, DistributedOperationStateV2>, outputs: Dict<text, text>, native_id: text,
        binding: Option<LinuxFreshWorkspaceBindingV3>) -> Result<text, text>:
    val input = kind == LinuxFreshWorkloadActionV2.InputConfigurationAfter
    if not input and kind != LinuxFreshWorkloadActionV2.ConfigurationAfter: return Err("machine-fresh-workload-configuration-kind")
    val view = machine_fresh_record_view_v3(record)
    if view.epoch_digest != sha256_text(machine_fresh_epoch_record_bytes_v1(epoch)?): return Err("machine-fresh-workload-configuration-epoch")
    if ordinal < 1 or ordinal > 8: return Err("machine-fresh-workload-read-bound")
    val prefix = if input: "input-configuration-" else: "configuration-"
    for stage in ["before", "image", "after"]:
        val name = prefix + stage + "-" + str(ordinal)
        if not operations.contains_key(name): return Err("machine-fresh-workload-action-missing")
        if operations[name].state != "completed": return Err("machine-fresh-workload-configuration-incomplete")
    val before = observation_output_v3(outputs, prefix + "before-" + str(ordinal))?
    val image = observation_output_v3(outputs, prefix + "image-" + str(ordinal))?
    val after = observation_output_v3(outputs, prefix + "after-" + str(ordinal))?
    val expected = machine_fresh_record_runtime_v3(record, native_id)?
    val first = configuration_selected_parse_v2(before, expected, view.scope, false, input)?
    if machine_fresh_workload_image_id_v2(first.configuration.image_id)? != machine_fresh_workload_image_id_v2(observation_output_v3(outputs, "pull-image")?)?:
        return Err("machine-fresh-workload-pulled-config-mismatch")
    val request = machine_fresh_record_request_v3(record)?
    if binding.is_some():
        val retained = machine_fresh_record_workspace_v3(record)?
        val installed = binding.unwrap().current_v3()?
        if machine_fresh_workspace_binding_bytes_v3(installed)? != machine_fresh_workspace_binding_bytes_v3(retained.binding)?:
            return Err("machine-fresh-workspace-source-binding-changed")
        if machine_fresh_workload_image_id_v2(first.configuration.image_id)? != machine_fresh_workload_image_id_v2(installed.image_config_id)?:
            return Err("machine-fresh-workspace-installed-image-config-mismatch")
    configuration_selected_observation_v2(before, image, after, view.scope, expected,
        view.request.plan.request_digest, request.image, input)

pub(package) fn machine_fresh_subject_validate_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        binding: Option<LinuxFreshWorkspaceBindingV3>, owner: LinuxContainerContainmentOwnerV1,
        command: LinuxFreshWorkloadCommandV2, captured: LinuxContainerContainmentSnapshotV1) -> Result<text, text>:
    val actual = if binding.is_some():
        custody.validate_workspace_containment_v3(binding.unwrap(), owner, LinuxFreshWorkspaceCommandV3(command: command))?
    else: custody.validate_workload_containment_v2(owner, command)?
    if not linux_oci_containment_same_subject_v1(captured, actual):
        return Err("machine-fresh-workload-native-incarnation-changed")
    if actual.state != LinuxContainerContainmentPopulationV1.Populated: return Err("machine-fresh-workload-not-populated")
    Ok(sha256_text(actual.binding_digest + "\n" + str(actual.capture_pid) + "\n" + str(actual.process_start_ticks) +
        "\n" + actual.cgroup_path + "\n" + str(actual.cgroup_mount_id) + "\n" + str(actual.cgroup_device) + "\n" +
        str(actual.cgroup_inode) + "\n" + str(actual.target_pidns_device) + "\n" + str(actual.target_pidns_inode) + "\n" +
        str(actual.target_cgroupns_device) + "\n" + str(actual.target_cgroupns_inode)))

pub(package) fn machine_fresh_closure_validate_v3(record: MachineFreshWorkloadRecordDispatchV3,
        epoch: MachineFreshEpochRecordV1, native_id: text, captured: LinuxContainerContainmentSnapshotV1,
        closure: LinuxFreshWorkloadClosureV2) -> Result<(), text>:
    val view = machine_fresh_record_view_v3(record)
    if (closure.native_id != native_id or closure.native_binding_digest != captured.binding_digest or
            closure.process_id != captured.capture_pid or closure.process_start_ticks != captured.process_start_ticks or
            closure.owner_generation != view.scope.provider_generation or
            closure.partition_identity_digest != epoch.partition_identity_digest or
            closure.cgroup_inode <= 0 or closure.cgroup_mount_id <= 0):
        return Err("machine-fresh-workload-closure-binding")
    Ok(())

pub(package) fn machine_fresh_primary_observe_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        record: MachineFreshWorkloadRecordDispatchV3, binding: LinuxFreshWorkspaceBindingV3,
        owner: LinuxContainerContainmentOwnerV1, native_id: text, context: (text, i64)) -> Result<LinuxFreshWorkspacePrimaryObservationTurnV3, text>:
    val command = LinuxFreshWorkspaceCommandV3(machine_fresh_record_command_v3(record, LinuxFreshWorkloadActionV2.Inspect, native_id)?)
    Ok(custody.observe_workspace_primary_v3(binding, owner, command, context.0, context.1))

pub(package) fn machine_fresh_command_observe_v3(record: MachineFreshWorkloadRecordDispatchV3,
        action: LinuxFreshWorkloadActionV2, name: text, id: text, outputs: Dict<text, text>) -> Result<LinuxFreshWorkloadCommandV2, text>:
    val view = machine_fresh_record_view_v3(record)
    var image_id = ""
    if action == LinuxFreshWorkloadActionV2.ConfigurationImage or action == LinuxFreshWorkloadActionV2.InputConfigurationImage:
        val input = action == LinuxFreshWorkloadActionV2.InputConfigurationImage
        val parts = name.split("-")
        val before_name = (if input: "input-configuration-before-" else: "configuration-before-") + parts[parts.len() - 1]
        val actual = configuration_selected_parse_v2(observation_output_v3(outputs, before_name)?, machine_fresh_record_runtime_v3(record, id)?, view.scope, false, input)?
        image_id = actual.configuration.image_id
        val pulled = machine_fresh_workload_image_id_v2(observation_output_v3(outputs, "pull-image")?)?
        if pulled != machine_fresh_workload_image_id_v2(image_id)?: return Err("machine-fresh-workload-pulled-config-mismatch")
    machine_fresh_record_command_v3(record, action, id, image_id)

pub(package) fn machine_fresh_running_current_v3(custody: LinuxFreshEpochSuccessorCustodyV1,
        binding: Option<LinuxFreshWorkspaceBindingV3>, owner: LinuxContainerContainmentOwnerV1,
        command: LinuxFreshWorkloadCommandV2) -> Result<LinuxContainerContainmentSnapshotV1, text>:
    if binding.is_some():
        return custody.validate_workspace_containment_v3(binding.unwrap(), owner, LinuxFreshWorkspaceCommandV3(command: command))
    custody.validate_workload_containment_v2(owner, command)
