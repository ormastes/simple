# Shared module for multi-variable array import tests.
# Consumed by test/system/module_import/fixtures/array_init_multi.spl.
# Mirrors src/compiler_rust/lib/std/src/cli_output/_test_multi.spl.

fn test_buffer_len() -> i64:
    val buffer = ["alpha", "beta", "gamma"]
    buffer.len()

fn test_starts_len() -> i64:
    val starts = [0, 5, 10]
    starts.len()

fn test_names_len() -> i64:
    val names = ["first", "second"]
    names.len()

fn test_ids_len() -> i64:
    val ids = [101, 102, 103, 104]
    ids.len()
