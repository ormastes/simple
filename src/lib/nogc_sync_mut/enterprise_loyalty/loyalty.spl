"""
# Loyalty / Rewards-Points Vertical — earn, redeem over an insert-only ledger

An enterprise vertical of the Simple Enterprise Suite (lane
`.spipe/simple_enterprise_suite`, W22-B) over the durable enterprise store:

    earn (+points) -> redeem (-points, gated on balance)

Every write runs the FROZEN guarded sequence (foundation.spl):

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

Effects committed together in the unit of work: the insert-only points row,
the outbox event, the sha256-chained audit record, and the idempotency key —
so a replayed command produces exactly one effect and a rollback carries none
(atomicity on ACID backends; see the store's backend-honesty docstring).

## Storage model — insert-only signed points ledger, derive on read

A single insert-only table `loyalty_events` holds one signed row per event.
There is NO UPDATE anywhere: a member's current balance is a pure-Simple fold
over the event rows (the interpreter sqlite emulation is non-ACID and ignores
WHERE — durable claims rest on the file backend; see the store's
backend-honesty docstring). Reasons partition the ledger:

- `loy-earn`   (+points) — points awarded; raises balance.
- `loy-redeem` (-points) — points spent; lowers balance.

Derived quantity per (tenant, member):

    balance = sum(delta) over all events   (earn stored +, redeem stored -)

## Reason choice — over-redeem denies `insufficient-stock`

`loyalty_redeem` denies with the closed-set reason `insufficient-stock` when
the requested points exceed the member's current balance. The closed 16-reason
set (foundation.reason_set) has no "insufficient-balance" member;
`insufficient-stock` is the closest existing reason for "not enough of a
consumable resource to satisfy this request" and is REUSED here deliberately —
points are the consumable, exactly as physical stock is in the inventory
vertical. No new reason is added.

## RBAC — reused 'sales' role, local gate (no frozen-table edit)

`foundation.role_allows` is FROZEN and says nothing about `loyalty.*`. Rather
than mutate the frozen table or the equivalence-fenced
`enterprise_sale.rbac_registry`, this module REUSES the existing `sales` role
through a local `loyalty_role_allows` gate for its two `loyalty.*` actions
(admin passes via the blanket admin rule). The frozen
session->rbac->validation->idempotency SEQUENCE is preserved exactly.

Tenant isolation: the SESSION tenant is authority; every reader filters by
tenant in pure Simple and a payload tenant is never trusted. Cross-OS: this
module hashes ONLY via the `records.audit_append` facade — it never imports
`std.common.crypto.sha256`.
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema — one insert-only signed points table
# =============================================================================

fn loyalty_setup(store: EnterpriseStore) -> bool:
    store_migrate(store, "loy_001_events",
        "CREATE TABLE IF NOT EXISTS loyalty_events (id INTEGER PRIMARY KEY, tenant_id TEXT, member_id TEXT, delta TEXT, reason TEXT, ref_id TEXT)")

# =============================================================================
# RBAC — reused 'sales' role via a local gate (see module docstring)
# =============================================================================

fn loyalty_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "sales":
        return action == "loyalty.points.earn" or action == "loyalty.points.redeem"
    false

# =============================================================================
# Derived read — balance is a pure fold over insert-only history
# =============================================================================

# loyalty_balance folds the member's signed event stream to a current balance
# (0 when the member has no events for this tenant). Pure read, tenant-scoped.
fn loyalty_balance(store: EnterpriseStore, tenant_id: text, member_id: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "loyalty_events", "id, tenant_id, member_id, delta, reason, ref_id")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "member_id") == member_id:
            total = total + int(sqlite_row_get(row, "delta"))
    total

# =============================================================================
# Guarded commands — frozen sequence over the durable store
# =============================================================================

# loyalty_earn awards `points` to a member (a +delta row). Replaying the same
# idempotency key returns the recorded result WITHOUT a second earn.
fn loyalty_earn(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, member_id: text, points: i64) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", member_id)
    # 2. rbac
    if not loyalty_role_allows(who.role, "loyalty.points.earn"):
        return denied("forbidden", member_id)
    # 3. domain validation (state-independent identity/shape checks)
    if member_id == "" or points <= 0:
        return denied("invalid-record", member_id)
    # 4. idempotency — a replay returns the recorded outcome, no new effect.
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects — one unit of work
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO loyalty_events (tenant_id, member_id, delta, reason, ref_id) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, member_id, "{points}", "loy-earn", member_id])
    outbox_append(store, tenant.tenant_id, "loyalty.points.earned", member_id + ":{points}")
    audit_append(store, tenant.tenant_id, who.actor_id, "loyalty.points.earn", member_id + ":{points}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, member_id)
    uow_commit(store)
    accepted(member_id)

# loyalty_redeem spends `points` from a member's balance (a -delta row).
# Denied with the closed-set reason `insufficient-stock` when points exceed
# the current balance (see module docstring for the reason choice).
fn loyalty_redeem(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, member_id: text, points: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", member_id)
    if not loyalty_role_allows(who.role, "loyalty.points.redeem"):
        return denied("forbidden", member_id)
    if member_id == "" or points <= 0:
        return denied("invalid-record", member_id)
    # The over-redeem check is state-DEPENDENT: `balance` shrinks by exactly
    # this command's own effect, so re-judging it on a replay would deny an
    # already-accepted command. Feasibility is asked only of a command not
    # already recorded (frozen order preserved: session -> rbac -> validation
    # -> idempotency).
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and points > loyalty_balance(store, tenant.tenant_id, member_id):
        return denied("insufficient-stock", "over-redeem:" + member_id + ":balance={loyalty_balance(store, tenant.tenant_id, member_id)}:got={points}")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val neg: i64 = 0 - points
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO loyalty_events (tenant_id, member_id, delta, reason, ref_id) VALUES (?, ?, ?, ?, ?)",
        [tenant.tenant_id, member_id, "{neg}", "loy-redeem", member_id])
    outbox_append(store, tenant.tenant_id, "loyalty.points.redeemed", member_id + ":{points}")
    audit_append(store, tenant.tenant_id, who.actor_id, "loyalty.points.redeem", member_id + ":{points}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, member_id)
    uow_commit(store)
    accepted(member_id)

export loyalty_setup, loyalty_role_allows
export loyalty_balance
export loyalty_earn, loyalty_redeem
