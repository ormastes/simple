# Generic AVL map for keys with a total order consistent with equality.
# Uses parallel SoA arrays (`node_keys`, `node_values`, and bit-packed `node_meta`
# encoding `(height << 56) | ((right + 1) << 28) | (left + 1)`), eliminating
# heap-boxed `OrderedMapNode` structs per entry.
# The free list reuses removed slots so allocated slots are bounded by peak size.

use std.nogc_sync_mut.sffi.ordered_key_cmp.{ordered_key_native_cmp, ordered_key_native_usable}

struct OrderedMapEntry<K, V>:
    key: K
    value: V

val ORD_CHILD_MASK: i64 = 0xFFFFFFF
val ORD_HEIGHT_MASK: i64 = 0x7F

fn ord_pack_meta(left: i64, right: i64, height: i64) -> i64:
    val l_enc = (left + 1) & ORD_CHILD_MASK
    val r_enc = (right + 1) & ORD_CHILD_MASK
    val h_enc = height & ORD_HEIGHT_MASK
    (h_enc << 56) | (r_enc << 28) | l_enc

fn ord_meta_left(meta: i64) -> i64:
    (meta & ORD_CHILD_MASK) - 1

fn ord_meta_right(meta: i64) -> i64:
    ((meta >> 28) & ORD_CHILD_MASK) - 1

fn ord_meta_height(meta: i64) -> i64:
    (meta >> 56) & ORD_HEIGHT_MASK

fn ordered_map_checked_relation(equal: bool, order: i64) -> i64:
    if (equal and order != 0) or (not equal and order == 0):
        panic("OrderedMap key Eq and Ord disagree")
    if equal:
        return 0
    if order < 0:
        return -1
    1

struct OrderedMap<K, V> where K: Ord + Eq:
    node_keys: [K]
    node_values: [V]
    node_meta: [i64]
    free_nodes: [i64]
    root: i64
    count: i64
    last_update_comparisons: i64

    static fn new() -> OrderedMap<K, V>:
        OrderedMap(
            node_keys: [],
            node_values: [],
            node_meta: [],
            free_nodes: [],
            root: -1,
            count: 0,
            last_update_comparisons: 0
        )

    fn len() -> i64:
        self.count

    fn is_empty() -> bool:
        self.count == 0

    fn tree_height() -> i64:
        self.height_at(self.root)

    fn allocated_slots() -> i64:
        self.node_meta.len()

    fn update_comparisons() -> i64:
        """Eq and native-order key comparisons made by the last put/remove."""
        self.last_update_comparisons

    fn height_at(idx: i64) -> i64:
        if idx < 0:
            return 0
        ord_meta_height(self.node_meta[idx])

    me update_height(idx: i64):
        val meta = self.node_meta[idx]
        val l = ord_meta_left(meta)
        val r = ord_meta_right(meta)
        val left_height = self.height_at(l)
        val right_height = self.height_at(r)
        val h = if left_height > right_height: left_height + 1 else: right_height + 1
        self.node_meta[idx] = ord_pack_meta(l, r, h)

    me rotate_left(idx: i64) -> i64:
        val node_m = self.node_meta[idx]
        val pivot = ord_meta_right(node_m)
        val pivot_m = self.node_meta[pivot]
        val node_left = ord_meta_left(node_m)
        val pivot_left = ord_meta_left(pivot_m)
        val pivot_right = ord_meta_right(pivot_m)
        self.node_meta[idx] = ord_pack_meta(node_left, pivot_left, 1)
        self.node_meta[pivot] = ord_pack_meta(idx, pivot_right, 1)
        self.update_height(idx)
        self.update_height(pivot)
        pivot

    me rotate_right(idx: i64) -> i64:
        val node_m = self.node_meta[idx]
        val pivot = ord_meta_left(node_m)
        val pivot_m = self.node_meta[pivot]
        val node_right = ord_meta_right(node_m)
        val pivot_left = ord_meta_left(pivot_m)
        val pivot_right = ord_meta_right(pivot_m)
        self.node_meta[idx] = ord_pack_meta(pivot_right, node_right, 1)
        self.node_meta[pivot] = ord_pack_meta(pivot_left, idx, 1)
        self.update_height(idx)
        self.update_height(pivot)
        pivot

    me rebalance(idx: i64) -> i64:
        self.update_height(idx)
        val meta = self.node_meta[idx]
        val l = ord_meta_left(meta)
        val r = ord_meta_right(meta)
        val balance = self.height_at(l) - self.height_at(r)
        if balance > 1:
            val lm = self.node_meta[l]
            if self.height_at(ord_meta_left(lm)) < self.height_at(ord_meta_right(lm)):
                val new_l = self.rotate_left(l)
                val cur = self.node_meta[idx]
                self.node_meta[idx] = ord_pack_meta(new_l, ord_meta_right(cur), ord_meta_height(cur))
            return self.rotate_right(idx)
        if balance < -1:
            val rm = self.node_meta[r]
            if self.height_at(ord_meta_right(rm)) < self.height_at(ord_meta_left(rm)):
                val new_r = self.rotate_right(r)
                val cur = self.node_meta[idx]
                self.node_meta[idx] = ord_pack_meta(ord_meta_left(cur), new_r, ord_meta_height(cur))
            return self.rotate_left(idx)
        idx

    me allocate_node(key: K, value: V) -> i64:
        val packed = ord_pack_meta(-1, -1, 1)
        if self.free_nodes.len() > 0:
            val idx = self.free_nodes[self.free_nodes.len() - 1]
            self.free_nodes.pop()
            self.node_keys[idx] = key
            self.node_values[idx] = value
            self.node_meta[idx] = packed
            return idx
        val idx = self.node_meta.len()
        self.node_keys.push(key)
        self.node_values.push(value)
        self.node_meta.push(packed)
        idx

    me insert_at(idx: i64, key: K, value: V) -> (i64, bool):
        if idx < 0:
            return (self.allocate_node(key, value), true)
        val cur_key = self.node_keys[idx]
        self.last_update_comparisons = self.last_update_comparisons + 2
        val order = ordered_map_checked_relation(key == cur_key, ordered_key_native_cmp(key, cur_key))
        if order < 0:
            val cur_left = ord_meta_left(self.node_meta[idx])
            val (left, inserted) = self.insert_at(cur_left, key, value)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = ord_pack_meta(left, ord_meta_right(cur_m), ord_meta_height(cur_m))
            if inserted:
                return (self.rebalance(idx), true)
            return (idx, false)
        elif order > 0:
            val cur_right = ord_meta_right(self.node_meta[idx])
            val (right, inserted) = self.insert_at(cur_right, key, value)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = ord_pack_meta(ord_meta_left(cur_m), right, ord_meta_height(cur_m))
            if inserted:
                return (self.rebalance(idx), true)
            return (idx, false)
        else:
            self.node_keys[idx] = key
            self.node_values[idx] = value
            return (idx, false)

    fn search_node(key: K) -> (i64, i64):
        if not ordered_key_native_usable(key):
            panic("OrderedMap key type has no supported native order")
        var idx = self.root
        var comparisons: i64 = 2
        while idx >= 0:
            val cur_key = self.node_keys[idx]
            val meta = self.node_meta[idx]
            comparisons = comparisons + 2
            val order = ordered_map_checked_relation(key == cur_key, ordered_key_native_cmp(key, cur_key))
            if order == 0:
                return (idx, comparisons)
            idx = if order < 0: ord_meta_left(meta) else: ord_meta_right(meta)
        (-1, comparisons)

    fn lookup_comparisons(key: K) -> i64:
        """Count Eq and native-order comparisons on the get/contains path."""
        val search = self.search_node(key)
        search[1]

    fn contains_key(key: K) -> bool:
        val search = self.search_node(key)
        search[0] >= 0

    me put(key: K, value: V) -> bool:
        """Insert or replace; return true only when the key was new."""
        if not ordered_key_native_usable(key):
            panic("OrderedMap key type has no supported native order")
        self.last_update_comparisons = 2
        val (root, inserted) = self.insert_at(self.root, key, value)
        self.root = root
        if inserted:
            self.count = self.count + 1
        inserted

    me insert(key: K, value: V) -> bool:
        """Alias for put."""
        self.put(key, value)

    fn get(key: K) -> V?:
        val search = self.search_node(key)
        if search[0] < 0:
            return None
        Some(self.node_values[search[0]])

    fn min_index_at(idx: i64) -> i64:
        var current = idx
        while true:
            val next_left = ord_meta_left(self.node_meta[current])
            if next_left < 0:
                return current
            current = next_left

    me remove_at(idx: i64, key: K) -> i64:
        if idx < 0:
            panic("OrderedMap key disappeared during removal")
        val cur_key = self.node_keys[idx]
        val meta = self.node_meta[idx]
        val l = ord_meta_left(meta)
        val r = ord_meta_right(meta)
        self.last_update_comparisons = self.last_update_comparisons + 2
        val order = ordered_map_checked_relation(key == cur_key, ordered_key_native_cmp(key, cur_key))
        if order < 0:
            val new_l = self.remove_at(l, key)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = ord_pack_meta(new_l, ord_meta_right(cur_m), ord_meta_height(cur_m))
            return self.rebalance(idx)
        if order > 0:
            val new_r = self.remove_at(r, key)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = ord_pack_meta(ord_meta_left(cur_m), new_r, ord_meta_height(cur_m))
            return self.rebalance(idx)
        if l < 0 or r < 0:
            val child = if l >= 0: l else: r
            self.free_nodes.push(idx)
            return child
        val succ_idx = self.min_index_at(r)
        val succ_key = self.node_keys[succ_idx]
        val succ_val = self.node_values[succ_idx]
        val new_r = self.remove_at(r, succ_key)
        self.node_keys[idx] = succ_key
        self.node_values[idx] = succ_val
        val cur_m = self.node_meta[idx]
        self.node_meta[idx] = ord_pack_meta(ord_meta_left(cur_m), new_r, ord_meta_height(cur_m))
        self.rebalance(idx)

    me remove(key: K) -> V?:
        if not ordered_key_native_usable(key):
            panic("OrderedMap key type has no supported native order")
        self.last_update_comparisons = 2
        var idx = self.root
        while idx >= 0:
            val cur_key = self.node_keys[idx]
            val meta = self.node_meta[idx]
            self.last_update_comparisons = self.last_update_comparisons + 2
            val order = ordered_map_checked_relation(key == cur_key, ordered_key_native_cmp(key, cur_key))
            if order == 0:
                val previous_value = self.node_values[idx]
                self.root = self.remove_at(self.root, key)
                self.count = self.count - 1
                return Some(previous_value)
            idx = if order < 0: ord_meta_left(meta) else: ord_meta_right(meta)
        None

    me clear():
        self.node_keys = []
        self.node_values = []
        self.node_meta = []
        self.free_nodes = []
        self.root = -1
        self.count = 0
        self.last_update_comparisons = 0

    fn keys() -> [K]:
        var result: [K] = []
        var stack: [i64] = []
        var idx = self.root
        while idx >= 0 or stack.len() > 0:
            while idx >= 0:
                stack.push(idx)
                idx = ord_meta_left(self.node_meta[idx])
            val next = stack[stack.len() - 1]
            stack.pop()
            result.push(self.node_keys[next])
            idx = ord_meta_right(self.node_meta[next])
        result

    fn values() -> [V]:
        var result: [V] = []
        var stack: [i64] = []
        var idx = self.root
        while idx >= 0 or stack.len() > 0:
            while idx >= 0:
                stack.push(idx)
                idx = ord_meta_left(self.node_meta[idx])
            val next = stack[stack.len() - 1]
            stack.pop()
            result.push(self.node_values[next])
            idx = ord_meta_right(self.node_meta[next])
        result

    fn entries() -> [OrderedMapEntry<K, V>]:
        var result: [OrderedMapEntry<K, V>] = []
        var stack: [i64] = []
        var idx = self.root
        while idx >= 0 or stack.len() > 0:
            while idx >= 0:
                stack.push(idx)
                idx = ord_meta_left(self.node_meta[idx])
            val next = stack[stack.len() - 1]
            stack.pop()
            result.push(OrderedMapEntry(key: self.node_keys[next], value: self.node_values[next]))
            idx = ord_meta_right(self.node_meta[next])
        result

export OrderedMap
export OrderedMapEntry
