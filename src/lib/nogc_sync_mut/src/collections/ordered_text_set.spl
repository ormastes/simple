# codex-impl
# AVL storage for the ordered branch of AdaptiveTextSet and AdaptiveTextMap.
# Uses parallel SoA arrays (`node_keys`, `node_values`, and bit-packed `node_meta`
# encoding `(height << 56) | ((right + 1) << 28) | (left + 1)`), eliminating
# heap-boxed `OrderedTextNode` allocations per entry.

struct OrderedTextEntry:
    key: text
    value: text

val OTS_CHILD_MASK: i64 = 0xFFFFFFF
val OTS_HEIGHT_MASK: i64 = 0x7F

fn _ots_pack_meta(left: i64, right: i64, height: i64) -> i64:
    val l_enc = (left + 1) & OTS_CHILD_MASK
    val r_enc = (right + 1) & OTS_CHILD_MASK
    val h_enc = height & OTS_HEIGHT_MASK
    (h_enc << 56) | (r_enc << 28) | l_enc

fn _ots_meta_left(meta: i64) -> i64:
    (meta & OTS_CHILD_MASK) - 1

fn _ots_meta_right(meta: i64) -> i64:
    ((meta >> 28) & OTS_CHILD_MASK) - 1

fn _ots_meta_height(meta: i64) -> i64:
    (meta >> 56) & OTS_HEIGHT_MASK

class OrderedTextSet:
    """Ordered text keys with logarithmic comparison paths for updates and lookup."""
    node_keys: [text]
    node_values: [text]
    node_meta: [i64]
    free_nodes: [i64]
    root: i64
    count: i64

    static fn new() -> OrderedTextSet:
        OrderedTextSet(
            node_keys: [],
            node_values: [],
            node_meta: [],
            free_nodes: [],
            root: -1,
            count: 0
        )

    fn len() -> i64:
        self.count

    fn tree_height() -> i64:
        self.height_at(self.root)

    fn allocated_slots() -> i64:
        self.node_meta.len()

    fn height_at(idx: i64) -> i64:
        if idx < 0:
            return 0
        _ots_meta_height(self.node_meta[idx])

    me update_height(idx: i64):
        val meta = self.node_meta[idx]
        val l = _ots_meta_left(meta)
        val r = _ots_meta_right(meta)
        val left_height = self.height_at(l)
        val right_height = self.height_at(r)
        val h = if left_height > right_height: left_height + 1 else: right_height + 1
        self.node_meta[idx] = _ots_pack_meta(l, r, h)

    me rotate_left(idx: i64) -> i64:
        val node_m = self.node_meta[idx]
        val pivot = _ots_meta_right(node_m)
        val pivot_m = self.node_meta[pivot]
        val node_left = _ots_meta_left(node_m)
        val pivot_left = _ots_meta_left(pivot_m)
        val pivot_right = _ots_meta_right(pivot_m)
        self.node_meta[idx] = _ots_pack_meta(node_left, pivot_left, 1)
        self.node_meta[pivot] = _ots_pack_meta(idx, pivot_right, 1)
        self.update_height(idx)
        self.update_height(pivot)
        pivot

    me rotate_right(idx: i64) -> i64:
        val node_m = self.node_meta[idx]
        val pivot = _ots_meta_left(node_m)
        val pivot_m = self.node_meta[pivot]
        val node_right = _ots_meta_right(node_m)
        val pivot_left = _ots_meta_left(pivot_m)
        val pivot_right = _ots_meta_right(pivot_m)
        self.node_meta[idx] = _ots_pack_meta(pivot_right, node_right, 1)
        self.node_meta[pivot] = _ots_pack_meta(pivot_left, idx, 1)
        self.update_height(idx)
        self.update_height(pivot)
        pivot

    me rebalance(idx: i64) -> i64:
        self.update_height(idx)
        val meta = self.node_meta[idx]
        val l = _ots_meta_left(meta)
        val r = _ots_meta_right(meta)
        val balance = self.height_at(l) - self.height_at(r)
        if balance > 1:
            val lm = self.node_meta[l]
            if self.height_at(_ots_meta_left(lm)) < self.height_at(_ots_meta_right(lm)):
                val new_l = self.rotate_left(l)
                val cur = self.node_meta[idx]
                self.node_meta[idx] = _ots_pack_meta(new_l, _ots_meta_right(cur), _ots_meta_height(cur))
            return self.rotate_right(idx)
        if balance < -1:
            val rm = self.node_meta[r]
            if self.height_at(_ots_meta_right(rm)) < self.height_at(_ots_meta_left(rm)):
                val new_r = self.rotate_right(r)
                val cur = self.node_meta[idx]
                self.node_meta[idx] = _ots_pack_meta(_ots_meta_left(cur), new_r, _ots_meta_height(cur))
            return self.rotate_left(idx)
        idx

    me allocate_node(key: text, value: text) -> i64:
        val packed = _ots_pack_meta(-1, -1, 1)
        if self.free_nodes.len() > 0:
            val idx = self.free_nodes[self.free_nodes.len() - 1]
            self.free_nodes.pop()
            self.node_keys[idx] = key
            self.node_values[idx] = value
            self.node_meta[idx] = packed
            return idx
        val idx = self.node_meta.len()
        if idx >= OTS_CHILD_MASK:
            panic("OrderedTextSet exceeded maximum 28-bit node capacity")
        self.node_keys.push(key)
        self.node_values.push(value)
        self.node_meta.push(packed)
        idx

    me insert_at(idx: i64, key: text, value: text) -> i64:
        if idx < 0:
            return self.allocate_node(key, value)
        val cur_key = self.node_keys[idx]
        if key < cur_key:
            val cur_left = _ots_meta_left(self.node_meta[idx])
            val new_left = self.insert_at(cur_left, key, value)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = _ots_pack_meta(new_left, _ots_meta_right(cur_m), _ots_meta_height(cur_m))
        else:
            val cur_right = _ots_meta_right(self.node_meta[idx])
            val new_right = self.insert_at(cur_right, key, value)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = _ots_pack_meta(_ots_meta_left(cur_m), new_right, _ots_meta_height(cur_m))
        self.rebalance(idx)

    fn contains_key(key: text) -> bool:
        var idx = self.root
        while idx >= 0:
            val cur_key = self.node_keys[idx]
            if key == cur_key:
                return true
            val meta = self.node_meta[idx]
            if key < cur_key:
                idx = _ots_meta_left(meta)
            else:
                idx = _ots_meta_right(meta)
        false

    me insert(key: text) -> bool:
        """Return false for an existing key; preserve sorted set semantics."""
        self.insert_with_value(key, "")

    me insert_with_value(key: text, value: text) -> bool:
        """Insert one key with a payload; preserve the old value if it exists."""
        if self.contains_key(key):
            return false
        self.root = self.insert_at(self.root, key, value)
        self.count = self.count + 1
        true

    me put_value(key: text, value: text) -> bool:
        """Insert or replace a payload; report whether the key was new."""
        var idx = self.root
        while idx >= 0:
            val cur_key = self.node_keys[idx]
            if key == cur_key:
                self.node_keys[idx] = key
                self.node_values[idx] = value
                return false
            val meta = self.node_meta[idx]
            if key < cur_key:
                idx = _ots_meta_left(meta)
            else:
                idx = _ots_meta_right(meta)
        self.root = self.insert_at(self.root, key, value)
        self.count = self.count + 1
        true

    fn get_value(key: text) -> text?:
        var idx = self.root
        while idx >= 0:
            val cur_key = self.node_keys[idx]
            if key == cur_key:
                return Some(self.node_values[idx])
            val meta = self.node_meta[idx]
            if key < cur_key:
                idx = _ots_meta_left(meta)
            else:
                idx = _ots_meta_right(meta)
        None

    fn min_index_at(idx: i64) -> i64:
        var current = idx
        while true:
            val next_left = _ots_meta_left(self.node_meta[current])
            if next_left < 0:
                return current
            current = next_left

    me remove_at(idx: i64, key: text) -> i64:
        val cur_key = self.node_keys[idx]
        val meta = self.node_meta[idx]
        val l = _ots_meta_left(meta)
        val r = _ots_meta_right(meta)
        if key < cur_key:
            val new_l = self.remove_at(l, key)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = _ots_pack_meta(new_l, _ots_meta_right(cur_m), _ots_meta_height(cur_m))
            return self.rebalance(idx)
        if key > cur_key:
            val new_r = self.remove_at(r, key)
            val cur_m = self.node_meta[idx]
            self.node_meta[idx] = _ots_pack_meta(_ots_meta_left(cur_m), new_r, _ots_meta_height(cur_m))
            return self.rebalance(idx)
        if l < 0 or r < 0:
            val child = if l >= 0: l else: r
            self.node_keys[idx] = ""
            self.node_values[idx] = ""
            self.node_meta[idx] = _ots_pack_meta(-1, -1, 0)
            self.free_nodes.push(idx)
            return child
        val succ_idx = self.min_index_at(r)
        val succ_key = self.node_keys[succ_idx]
        val succ_val = self.node_values[succ_idx]
        val new_r = self.remove_at(r, succ_key)
        self.node_keys[idx] = succ_key
        self.node_values[idx] = succ_val
        val cur_m = self.node_meta[idx]
        self.node_meta[idx] = _ots_pack_meta(_ots_meta_left(cur_m), new_r, _ots_meta_height(cur_m))
        self.rebalance(idx)

    me remove(key: text) -> bool:
        if not self.contains_key(key):
            return false
        self.root = self.remove_at(self.root, key)
        self.count = self.count - 1
        true

    fn keys() -> [text]:
        """Return an in-order snapshot independent of tree shape."""
        var values: [text] = []
        var stack: [i64] = []
        var idx = self.root
        while idx >= 0 or stack.len() > 0:
            while idx >= 0:
                stack.push(idx)
                idx = _ots_meta_left(self.node_meta[idx])
            val next = stack[stack.len() - 1]
            stack.pop()
            values.push(self.node_keys[next])
            idx = _ots_meta_right(self.node_meta[next])
        values

    fn entries() -> [OrderedTextEntry]:
        """Return an in-order snapshot of key/value pairs."""
        var values: [OrderedTextEntry] = []
        var stack: [i64] = []
        var idx = self.root
        while idx >= 0 or stack.len() > 0:
            while idx >= 0:
                stack.push(idx)
                idx = _ots_meta_left(self.node_meta[idx])
            val next = stack[stack.len() - 1]
            stack.pop()
            values.push(OrderedTextEntry(key: self.node_keys[next], value: self.node_values[next]))
            idx = _ots_meta_right(self.node_meta[next])
        values

export OrderedTextSet
export OrderedTextEntry
