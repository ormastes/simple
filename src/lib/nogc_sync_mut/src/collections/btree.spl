# BTreeMap - Pure Simple Parallel SoA Implementation
#
# No SFFI, no Rust - 100% Pure Simple
# Sorted parallel `entry_keys` / `entry_values` arrays with zero per-entry struct boxing.

struct Entry:
    """Key-value pair in BTreeMap (preserved for compatibility)."""
    key: text
    value: text

class BTreeMap:
    """Pure Simple BTreeMap using parallel sorted key and value arrays.

    Maintains entries in sorted key order without per-entry struct allocations.

    Example:
        var tree = BTreeMap.new()
        tree.insert("apple", "red")
        tree.insert("banana", "yellow")
        val first = tree.first_key()  # Some("apple")
    """
    entry_keys: [text]
    entry_values: [text]

    static fn new() -> BTreeMap:
        """Create new empty BTreeMap."""
        BTreeMap(entry_keys: [], entry_values: [])

    me insert(key: text, value: text):
        """Insert or update key-value pair (maintains sorted order)."""
        val n = self.entry_keys.len()
        var left = 0
        var right = n

        while left < right:
            val mid = (left + right) / 2
            if self.entry_keys[mid] < key:
                left = mid + 1
            else:
                right = mid

        if left < n and self.entry_keys[left] == key:
            self.entry_values[left] = value
        else:
            self.entry_keys.push("")
            self.entry_values.push("")
            var i = n
            while i > left:
                self.entry_keys[i] = self.entry_keys[i - 1]
                self.entry_values[i] = self.entry_values[i - 1]
                i = i - 1
            self.entry_keys[left] = key
            self.entry_values[left] = value

    fn get(key: text) -> text?:
        """Get value for key (binary search)."""
        var left = 0
        var right = self.entry_keys.len()

        while left < right:
            val mid = (left + right) / 2
            val cur = self.entry_keys[mid]
            if cur == key:
                return Some(self.entry_values[mid])
            elif cur < key:
                left = mid + 1
            else:
                right = mid

        None

    fn contains_key(key: text) -> bool:
        """Check if key exists."""
        var left = 0
        var right = self.entry_keys.len()

        while left < right:
            val mid = (left + right) / 2
            val cur = self.entry_keys[mid]
            if cur == key:
                return true
            elif cur < key:
                left = mid + 1
            else:
                right = mid

        false

    fn has(key: text) -> bool:
        """Alias for contains_key."""
        self.contains_key(key)

    me remove(key: text) -> text?:
        """Remove key and return value."""
        val n = self.entry_keys.len()
        var left = 0
        var right = n

        while left < right:
            val mid = (left + right) / 2
            val cur = self.entry_keys[mid]
            if cur == key:
                val value = self.entry_values[mid]
                var i = mid
                val last = n - 1
                while i < last:
                    self.entry_keys[i] = self.entry_keys[i + 1]
                    self.entry_values[i] = self.entry_values[i + 1]
                    i = i + 1
                self.entry_keys.pop()
                self.entry_values.pop()
                return Some(value)
            elif cur < key:
                left = mid + 1
            else:
                right = mid

        None

    fn keys() -> [text]:
        """Get all keys in sorted order."""
        var result: [text] = []
        val n = self.entry_keys.len()
        var i = 0
        while i < n:
            result.push(self.entry_keys[i])
            i = i + 1
        result

    fn values() -> [text]:
        """Get all values in key-sorted order."""
        var result: [text] = []
        val n = self.entry_values.len()
        var i = 0
        while i < n:
            result.push(self.entry_values[i])
            i = i + 1
        result

    me clear():
        """Remove all entries."""
        self.entry_keys = []
        self.entry_values = []

    fn len() -> i64:
        """Get number of entries."""
        self.entry_keys.len()

    fn is_empty() -> bool:
        """Check if empty."""
        self.entry_keys.len() == 0

    fn first_key() -> text?:
        """Get smallest key."""
        if self.entry_keys.len() > 0:
            Some(self.entry_keys[0])
        else:
            None

    fn last_key() -> text?:
        """Get largest key."""
        val n = self.entry_keys.len()
        if n > 0:
            Some(self.entry_keys[n - 1])
        else:
            None
