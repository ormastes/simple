# Generic set facade over AdaptiveMap<K, bool>. A key has one physical copy
# in the selected representation, and the stored bool is always true.

use std.hash.Hash
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap
use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveSetAlgorithm, AdaptiveSetAttribute, AdaptiveSetProfile,
    AdaptiveSetObservation, AdaptiveSetWorkloadProfile,
    adaptive_set_default_profile
}

struct AdaptiveSet<K> where K: Hash + Eq + Ord:
    inner: AdaptiveMap<K, bool>

    static fn new() -> AdaptiveSet<K>:
        AdaptiveSet.with_profile(adaptive_set_default_profile())

    static fn with_profile(profile: AdaptiveSetProfile) -> AdaptiveSet<K>:
        AdaptiveSet(inner: AdaptiveMap.with_profile(profile))

    static fn with_site_and_target(
        profile: AdaptiveSetProfile, site_id: text, target_profile_id: text
    ) -> AdaptiveSet<K>:
        AdaptiveSet(inner: AdaptiveMap.with_site_and_target(profile, site_id, target_profile_id))

    static fn attributed(source: AdaptiveSet<K>, algorithm_name: text) -> AdaptiveSet<K>:
        var set = source
        set.inner = AdaptiveMap.attributed(set.inner, algorithm_name)
        set

    static fn attributed_at_site(
        source: AdaptiveSet<K>, algorithm_name: text, site_id: text
    ) -> AdaptiveSet<K>:
        var set = source
        set.inner = AdaptiveMap.attributed_at_site(set.inner, algorithm_name, site_id)
        set

    static fn attributed_with_prior_at_site(
        source: AdaptiveSet<K>, algorithm_name: text, site_id: text,
        target_profile_id: text, sample_count: i64, size_p95: i64,
        lookup_count_p95: i64, hit_count_p95: i64, miss_count_p95: i64,
        hash_probe_count_p95: i64, hash_collision_count_p95: i64
    ) -> AdaptiveSet<K>:
        var set = source
        set.inner = AdaptiveMap.attributed_with_prior_at_site(
            set.inner, algorithm_name, site_id, target_profile_id,
            sample_count, size_p95, lookup_count_p95, hit_count_p95,
            miss_count_p95, hash_probe_count_p95, hash_collision_count_p95
        )
        set

    fn len() -> i64:
        self.inner.len()

    fn selected_algorithm() -> AdaptiveSetAlgorithm:
        self.inner.selected_algorithm()

    fn algorithm_attribute() -> AdaptiveSetAttribute:
        self.inner.algorithm_attribute()

    fn linear_lookup_comparisons() -> i64:
        self.inner.linear_lookup_comparisons()

    fn observation() -> AdaptiveSetObservation:
        self.inner.observation()

    fn workload_profile_sample() -> AdaptiveSetWorkloadProfile:
        self.inner.workload_profile_sample()

    fn snapshot_values() -> [K]:
        self.inner.keys()

    me contains(key: K) -> bool:
        var inner = self.inner
        val found = inner.contains_key(key)
        self.inner = inner
        found

    me insert(key: K) -> bool:
        var inner = self.inner
        val inserted = inner.put(key, true)
        self.inner = inner
        inserted

    me remove(key: K) -> bool:
        var inner = self.inner
        val removed = inner.remove(key) != nil
        self.inner = inner
        removed

    me clear():
        var inner = self.inner
        inner.clear()
        self.inner = inner

    me set_attribute(attribute: AdaptiveSetAttribute):
        var inner = self.inner
        inner.set_attribute(attribute)
        self.inner = inner

    me set_profile(profile: AdaptiveSetProfile):
        var inner = self.inner
        inner.set_profile(profile)
        self.inner = inner

    me apply_workload_profile(prior: AdaptiveSetWorkloadProfile) -> bool:
        var inner = self.inner
        val applied = inner.apply_workload_profile(prior)
        self.inner = inner
        applied

export AdaptiveSet
