# Completed filter counts are sent to the shared process capture owner only
# after successful evaluation and result materialization. This module does not
# serialize or write .sprof data.
use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveTextSet, AdaptiveSetAttribute}
use std.nogc_sync_mut.sffi.collection_capture.{collection_capture_note_filter}

struct AdaptiveSetFilterObservation:
    site_id: text
    target_profile_id: text
    evaluated: i64
    accepted: i64

struct AdaptiveSetFilterResult:
    result: AdaptiveTextSet
    observation: AdaptiveSetFilterObservation?

fn adaptive_set_filter_observed(
    source: AdaptiveTextSet, predicate: fn(text) -> Result<bool, text>
) -> Result<AdaptiveSetFilterResult, text>:
    """Filter unique keys in snapshot order and return completed measured counts.

    The predicate executes once per examined key. Err discards the partial
    result and provides no completion event; predicate side effects are not
    rolled back. Empty input has no defined selectivity and returns nil data.
    Identity is copied from the source, not synthesized or newly admitted here.
    The result has no AST site until a compiler/caller supplies its own identity.
    Keep raw counts for process-owner aggregation; averaging per-call ratios
    loses weighting.
    """
    if source.site_id == "" or source.target_profile_id == "":
        return Err("observed filter requires source site and target identities")
    val snapshot = source.snapshot_values()
    if source.size < 0 or snapshot.len() != source.size:
        return Err("observed filter source snapshot is incomplete")
    # Every representation promises a sorted, unique snapshot. Cardinality
    # alone must not admit duplicated or malformed backing storage.
    var index = 1
    while index < snapshot.len():
        if snapshot[index - 1] >= snapshot[index]:
            return Err("observed filter source snapshot is not a sorted set")
        index = index + 1
    # insert's boolean denotes novelty, not allocation success. Keep this
    # result linear so each backing-array append is directly verifiable and
    # unchecked adaptive promotion cannot discard accepted keys.
    var result = AdaptiveTextSet.with_attribute(source.profile, "", "", AdaptiveSetAttribute.Linear)
    var evaluated: i64 = 0
    var accepted: i64 = 0
    for key in snapshot:
        val keep = match predicate(key):
            case Ok(value): value
            case Err(reason): return Err(reason)
        if evaluated == 9223372036854775807:
            return Err("observed filter count overflow")
        evaluated = evaluated + 1
        if keep:
            if not result.insert(key):
                return Err("observed filter could not materialize an accepted key")
            if result.linear_values.len() != accepted + 1:
                return Err("observed filter could not materialize an accepted key")
            accepted = accepted + 1
    var observation: AdaptiveSetFilterObservation? = nil
    if evaluated > 0:
        # Capture failure poisons the shared session, whose finish reports the
        # error. Optional profiling must not change this completed operation.
        collection_capture_note_filter(
            source.site_id, source.target_profile_id, evaluated, accepted)
        observation = Some(AdaptiveSetFilterObservation(
            site_id: source.site_id,
            target_profile_id: source.target_profile_id,
            evaluated: evaluated,
            accepted: accepted
        ))
    Ok(AdaptiveSetFilterResult(result: result, observation: observation))

export AdaptiveSetFilterObservation, AdaptiveSetFilterResult, adaptive_set_filter_observed
