# Tmux API Module
#
# Read/write interface for tmux terminal multiplexer.
# Uses shell commands to interact with tmux sessions, windows, and panes.

use std.io_runtime.{shell, shell_output_trimmed, shell_bool}
use std.convert.{try_parse_int}
use std.nogc_sync_mut.sosix.process.{sosix_process_run_bounded}
use std.common.text_bytes.{text_to_bytes, bytes_to_text}

# Parse `s` as an integer, returning `default` when it is not one.
# `std.text` has no `to_int_or`; `try_parse_int` is the fail-closed parser.
fn to_int_or(s: text, default: i64) -> i64:
    try_parse_int(s) ?? default

# =========================================================================
# Data Types
# =========================================================================

struct TmuxSession:
    name: text
    windows: i64
    attached: bool
    created: text

struct TmuxWindow:
    session: text
    index: i64
    name: text
    active: bool
    panes: i64

struct TmuxPane:
    session: text
    window_index: i64
    pane_index: i64
    active: bool
    width: i64
    height: i64
    current_command: text
    pid: i64

struct TmuxCaptureResult:
    content: text
    pane_id: text
    rows: i64

# =========================================================================
# Availability Check
# =========================================================================

fn tmux_available() -> bool:
    shell_bool("command -v tmux >/dev/null 2>&1")

fn tmux_server_running() -> bool:
    shell_bool("tmux list-sessions >/dev/null 2>&1")

# =========================================================================
# Session Operations
# =========================================================================

fn tmux_list_sessions() -> [TmuxSession]:
    var sessions: [TmuxSession] = []
    if not tmux_server_running():
        return sessions

    val session_fmt = "#" + "{" + "session_name}|#" + "{" + "session_windows}|#" + "{" + "session_attached}|#" + "{" + "session_created}"
    val output = shell_output_trimmed(
        "tmux list-sessions -F '" + session_fmt + "'",
        ""
    )
    if output == "":
        return sessions

    val lines = output.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() >= 4:
            sessions.push(TmuxSession(
                name: parts[0],
                windows: to_int_or(parts[1], 0),
                attached: parts[2] == "1",
                created: parts[3]
            ))
    return sessions

fn tmux_has_session(name: text) -> bool:
    shell_bool("tmux has-session -t '{name}' 2>/dev/null")

fn tmux_new_session(name: text) -> Result<text, text>:
    if tmux_has_session(name):
        return Err("Session '{name}' already exists")
    val result = shell("tmux new-session -d -s '{name}'")
    if result.exit_code == 0:
        Ok(name)
    else:
        Err("Failed to create session: {result.stderr}")

fn _session_has_llm_process(name: text) -> bool:
    val pane_cmd_fmt = "#" + "{" + "pane_current_command}"
    val output = shell_output_trimmed(
        "tmux list-panes -t '{name}' -F '" + pane_cmd_fmt + "' 2>/dev/null", "")
    if output == "":
        return false
    for line in output.split("\n"):
        val cmd = line.trim().lower()
        if (cmd.contains("claude") or cmd.contains("codex") or
            cmd.contains("simple_mcp") or cmd.contains("simple_lsp")):
            return true
    false

fn tmux_kill_session(name: text) -> Result<text, text>:
    if _session_has_llm_process(name):
        return Err("Refused: session '{name}' has active LLM/MCP process")
    val result = shell("tmux kill-session -t '{name}'")
    if result.exit_code == 0:
        Ok("Session '{name}' killed")
    else:
        Err("Failed to kill session: {result.stderr}")

# =========================================================================
# Window Operations
# =========================================================================

fn tmux_list_windows(session: text) -> [TmuxWindow]:
    var windows: [TmuxWindow] = []
    val window_fmt = "#" + "{" + "window_index}|#" + "{" + "window_name}|#" + "{" + "window_active}|#" + "{" + "window_panes}"
    val output = shell_output_trimmed(
        "tmux list-windows -t '{session}' -F '" + window_fmt + "' 2>/dev/null",
        ""
    )
    if output == "":
        return windows

    val lines = output.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() >= 4:
            windows.push(TmuxWindow(
                session: session,
                index: to_int_or(parts[0], 0),
                name: parts[1],
                active: parts[2] == "1",
                panes: to_int_or(parts[3], 1)
            ))
    return windows

fn tmux_new_window(session: text, name: text) -> Result<i64, text>:
    val result = shell("tmux new-window -t '{session}' -n '{name}'")
    if result.exit_code == 0:
        val window_index_fmt = "#" + "{" + "window_index}"
        val idx = shell_output_trimmed(
            "tmux display-message -t '{session}' -p '" + window_index_fmt + "'", "0"
        )
        Ok(to_int_or(idx, 0))
    else:
        Err("Failed to create window: {result.stderr}")

# =========================================================================
# Pane Operations
# =========================================================================

fn tmux_list_panes(session: text, window_index: i64) -> [TmuxPane]:
    var panes: [TmuxPane] = []
    val target = "{session}:{window_index}"
    val pane_fmt = "#" + "{" + "pane_index}|#" + "{" + "pane_active}|#" + "{" + "pane_width}|#" + "{" + "pane_height}|#" + "{" + "pane_current_command}|#" + "{" + "pane_pid}"
    val output = shell_output_trimmed(
        "tmux list-panes -t '{target}' -F '" + pane_fmt + "' 2>/dev/null",
        ""
    )
    if output == "":
        return panes

    val lines = output.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() >= 6:
            panes.push(TmuxPane(
                session: session,
                window_index: window_index,
                pane_index: to_int_or(parts[0], 0),
                active: parts[1] == "1",
                width: to_int_or(parts[2], 80),
                height: to_int_or(parts[3], 24),
                current_command: parts[4],
                pid: to_int_or(parts[5], 0)
            ))
    return panes

fn tmux_split_pane(session: text, window_index: i64, horizontal: bool) -> Result<i64, text>:
    val target = "{session}:{window_index}"
    val flag = if horizontal: "-h" else: "-v"
    val result = shell("tmux split-window {flag} -t '{target}'")
    if result.exit_code == 0:
        val pane_index_fmt = "#" + "{" + "pane_index}"
        val idx = shell_output_trimmed(
            "tmux display-message -t '{target}' -p '" + pane_index_fmt + "'", "0"
        )
        Ok(to_int_or(idx, 0))
    else:
        Err("Failed to split pane: {result.stderr}")

# =========================================================================
# Capture & Send (Core Read/Write API)
# =========================================================================

fn tmux_capture_pane(session: text, window_index: i64, pane_index: i64) -> TmuxCaptureResult:
    val target = "{session}:{window_index}.{pane_index}"
    val content = shell_output_trimmed(
        "tmux capture-pane -t '{target}' -p -e 2>/dev/null",
        ""
    )
    val pane_height_fmt = "#" + "{" + "pane_height}"
    val rows_str = shell_output_trimmed(
        "tmux display-message -t '{target}' -p '" + pane_height_fmt + "' 2>/dev/null",
        "24"
    )
    TmuxCaptureResult(
        content: content,
        pane_id: target,
        rows: to_int_or(rows_str, 24)
    )

fn tmux_capture_pane_with_history(session: text, window_index: i64, pane_index: i64, history_lines: i64) -> TmuxCaptureResult:
    val target = "{session}:{window_index}.{pane_index}"
    val start = 0 - history_lines
    val content = shell_output_trimmed(
        "tmux capture-pane -t '{target}' -p -e -S {start} 2>/dev/null",
        ""
    )
    TmuxCaptureResult(
        content: content,
        pane_id: target,
        rows: history_lines
    )

fn tmux_send_keys(session: text, window_index: i64, pane_index: i64, keys: text) -> Result<text, text>:
    val target = "{session}:{window_index}.{pane_index}"
    val escaped = keys.replace("'", "'\\''")
    val result = shell("tmux send-keys -t '{target}' '{escaped}'")
    if result.exit_code == 0:
        Ok("Keys sent to {target}")
    else:
        Err("Failed to send keys: {result.stderr}")

fn tmux_send_text(session: text, window_index: i64, pane_index: i64, text_input: text) -> Result<text, text>:
    val target = "{session}:{window_index}.{pane_index}"
    val escaped = text_input.replace("'", "'\\''")
    val result = shell("tmux send-keys -t '{target}' -l '{escaped}'")
    if result.exit_code == 0:
        Ok("Text sent to {target}")
    else:
        Err("Failed to send text: {result.stderr}")

fn tmux_send_enter(session: text, window_index: i64, pane_index: i64) -> Result<text, text>:
    tmux_send_keys(session, window_index, pane_index, "Enter")

fn tmux_send_command(session: text, window_index: i64, pane_index: i64, command: text) -> Result<text, text>:
    val r1 = tmux_send_text(session, window_index, pane_index, command)
    match r1:
        Err(e):
            return Err(e)
        Ok(_):
            pass_dn
    tmux_send_enter(session, window_index, pane_index)

# =========================================================================
# Resize
# =========================================================================

fn tmux_resize_pane(session: text, window_index: i64, pane_index: i64, width: i64, height: i64) -> Result<text, text>:
    val target = "{session}:{window_index}.{pane_index}"
    val result = shell("tmux resize-pane -t '{target}' -x {width} -y {height}")
    if result.exit_code == 0:
        Ok("Pane resized to {width}x{height}")
    else:
        Err("Failed to resize: {result.stderr}")

# =========================================================================
# Convenience
# =========================================================================

fn tmux_active_pane_target() -> text:
    val active_target_fmt = "#" + "{" + "session_name}:#" + "{" + "window_index}.#" + "{" + "pane_index}"
    shell_output_trimmed(
        "tmux display-message -p '" + active_target_fmt + "' 2>/dev/null",
        ""
    )

fn tmux_run_in_new_pane(session: text, window_index: i64, command: text) -> Result<i64, text>:
    val target = "{session}:{window_index}"
    val escaped = command.replace("'", "'\\''")
    val result = shell("tmux split-window -t '{target}' '{escaped}'")
    if result.exit_code == 0:
        val pane_index_fmt = "#" + "{" + "pane_index}"
        val idx = shell_output_trimmed(
            "tmux display-message -t '{target}' -p '" + pane_index_fmt + "'", "0"
        )
        Ok(to_int_or(idx, 0))
    else:
        Err("Failed to run command in new pane: {result.stderr}")

# Checked HTTP-facing owner. Legacy list/capture signatures above cannot
# distinguish command failure from empty output and remain compatibility-only.
# New callers must use these Result APIs. No shell interprets any argument.
pub fn tmux_encode_argument_v1(value: text) -> text:
    # tmux cmd_parse_from_arguments interprets a terminal ';' even when argv
    # was passed directly. It removes exactly the immediately preceding '\\'.
    # Insert one extra backslash, preserving every original byte (including
    # any existing run of backslashes). Other arguments must stay unchanged.
    # Owner contract: one invocation is one command, never a command list.
    if not value.ends_with(";"): return value
    val bytes = text_to_bytes(value)
    var encoded: [u8] = []
    for index in 0..(bytes.len() - 1):
        encoded.push(bytes[index])
    encoded.push(92)
    encoded.push(59)
    bytes_to_text(encoded)

pub fn tmux_run_checked(args: [text]) -> Result<text, text>:
    var encoded: [text] = []
    for arg in args:
        encoded.push(tmux_encode_argument_v1(arg))
    val result = sosix_process_run_bounded("tmux", encoded, 10000, 1048576)
    # The existing text capture ABI has no separate truncation bit. Reject at
    # its byte ceiling (including exact ceiling) and its diagnostic marker;
    # never parse a prefix/tail capture as a complete successful snapshot.
    if text_to_bytes(result.0).len() >= 1048576 or text_to_bytes(result.1).len() >= 1048576 or result.0.contains("[output truncated:") or result.1.contains("[output truncated:"):
        return Err("tmux output limit reached; completion may be unknown")
    if result.2 != 0:
        return Err("tmux exit {result.2}: " + result.1)
    Ok(result.0)

pub fn tmux_probe_checked() -> Result<text, text>:
    tmux_run_checked(["-V"])

pub fn tmux_list_sessions_checked() -> Result<[TmuxSession], text>:
    val format = "#" + "{session_name}\t#" + "{session_windows}\t#" + "{session_attached}\t#" + "{session_created}"
    val output = tmux_run_checked(["list-sessions", "-F", format])?
    tmux_parse_sessions_checked(output)

# Pure wire parser used by the checked owner, not a substitute provider.
pub fn tmux_parse_sessions_checked(output: text) -> Result<[TmuxSession], text>:
    var result: [TmuxSession] = []
    for line in output.split("\n"):
        if line == "": continue
        val fields = line.split("\t")
        if fields.len() != 4: return Err("malformed tmux session row")
        val windows = try_parse_int(fields[1])
        val attached_clients = try_parse_int(fields[2])
        if windows == nil or attached_clients == nil or fields[0] == "":
            return Err("malformed tmux session fields")
        if windows.unwrap() < 0 or attached_clients.unwrap() < 0: return Err("negative tmux session count")
        result.push(TmuxSession(name: fields[0], windows: windows.unwrap(), attached: attached_clients.unwrap() > 0, created: fields[3]))
    Ok(result)

pub fn tmux_list_windows_checked(session: text) -> Result<[TmuxWindow], text>:
    val format = "#" + "{window_index}\t#" + "{window_name}\t#" + "{window_active}\t#" + "{window_panes}"
    val output = tmux_run_checked(["list-windows", "-t", "=" + session, "-F", format])?
    var result: [TmuxWindow] = []
    for line in output.split("\n"):
        if line == "": continue
        val fields = line.split("\t")
        if fields.len() != 4: return Err("malformed tmux window row")
        val index = try_parse_int(fields[0])
        val panes = try_parse_int(fields[3])
        if index == nil or panes == nil or (fields[2] != "0" and fields[2] != "1"):
            return Err("malformed tmux window fields")
        if index.unwrap() < 0 or panes.unwrap() < 1: return Err("invalid tmux window counts")
        result.push(TmuxWindow(session: session, index: index.unwrap(), name: fields[1], active: fields[2] == "1", panes: panes.unwrap()))
    Ok(result)

pub fn tmux_list_panes_checked(session: text, window_index: i64) -> Result<[TmuxPane], text>:
    val format = "#" + "{pane_index}\t#" + "{pane_active}\t#" + "{pane_width}\t#" + "{pane_height}\t#" + "{pane_current_command}\t#" + "{pane_pid}"
    val output = tmux_run_checked(["list-panes", "-t", "={session}:{window_index}", "-F", format])?
    var result: [TmuxPane] = []
    for line in output.split("\n"):
        if line == "": continue
        val fields = line.split("\t")
        if fields.len() != 6: return Err("malformed tmux pane row")
        val index = try_parse_int(fields[0])
        val width = try_parse_int(fields[2])
        val height = try_parse_int(fields[3])
        val pid = try_parse_int(fields[5])
        if index == nil or width == nil or height == nil or pid == nil or (fields[1] != "0" and fields[1] != "1"):
            return Err("malformed tmux pane fields")
        if index.unwrap() < 0 or width.unwrap() < 1 or height.unwrap() < 1 or pid.unwrap() < 1:
            return Err("invalid tmux pane dimensions or PID")
        result.push(TmuxPane(session: session, window_index: window_index, pane_index: index.unwrap(), active: fields[1] == "1", width: width.unwrap(), height: height.unwrap(), current_command: fields[4], pid: pid.unwrap()))
    Ok(result)

pub fn tmux_capture_checked(session: text, window_index: i64, pane_index: i64, history: i64?) -> Result<TmuxCaptureResult, text>:
    val target = "={session}:{window_index}.{pane_index}"
    var args = ["capture-pane", "-t", target, "-p", "-e"]
    if val lines = history:
        args.push("-S")
        args.push(str(0 - lines))
    val content = tmux_run_checked(args)?
    val rows_text = tmux_run_checked(["display-message", "-t", target, "-p", "#" + "{pane_height}"])?
    val rows = try_parse_int(rows_text.trim())
    if rows == nil: return Err("malformed tmux pane height")
    if rows.unwrap() < 1: return Err("invalid tmux pane height")
    Ok(TmuxCaptureResult(content: content, pane_id: "{session}:{window_index}.{pane_index}", rows: rows.unwrap()))

pub fn tmux_new_session_checked(name: text) -> Result<text, text>:
    tmux_run_checked(["new-session", "-d", "-s", name])?
    Ok(name)

pub fn tmux_kill_session_checked(name: text) -> Result<text, text>:
    # Preserve the existing LLM/MCP protection, but fail closed if inspection
    # fails. A failed query must not become permission to terminate a session.
    val commands = tmux_run_checked(["list-panes", "-s", "-t", "=" + name, "-F", "#" + "{pane_current_command}"])?
    for line in commands.split("\n"):
        val command = line.lower()
        if command.contains("claude") or command.contains("codex") or command.contains("simple_mcp") or command.contains("simple_lsp"):
            return Err("Refused: session has active LLM/MCP process")
    tmux_run_checked(["kill-session", "-t", "=" + name])?
    Ok("Session killed")

pub fn tmux_send_checked(session: text, window_index: i64, pane_index: i64, value: text, literal: bool) -> Result<text, text>:
    var args = ["send-keys", "-t", "={session}:{window_index}.{pane_index}"]
    if literal: args.push("-l")
    args.push("--")
    args.push(value)
    tmux_run_checked(args)?
    Ok("Input sent")

pub fn tmux_send_command_checked(session: text, window_index: i64, pane_index: i64, command: text) -> Result<text, text>:
    tmux_send_checked(session, window_index, pane_index, command, true)?
    val enter = tmux_send_checked(session, window_index, pane_index, "Enter", false)
    if enter.is_err(): return Err("partial input: literal text sent; Enter failed: " + enter.unwrap_err())
    Ok("Command sent")

pub fn tmux_resize_checked(session: text, window_index: i64, pane_index: i64, width: i64, height: i64) -> Result<text, text>:
    tmux_run_checked(["resize-pane", "-t", "={session}:{window_index}.{pane_index}", "-x", str(width), "-y", str(height)])?
    Ok("Pane resized")
