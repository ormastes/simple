# Canonical logical path to host-native boundary conversion.
#
# CROSS-PLATFORM IMPACT (read before editing): off Windows every function here
# is the IDENTITY -- it returns its argument byte for byte. That is deliberate
# and load-bearing. A backslash is a LEGAL character in a POSIX filename, so a
# "\\" -> "/" rewrite off Windows silently addresses a DIFFERENT file. This file
# used to run that rewrite unconditionally, before the platform check, so on
# Linux/macOS `/home/a\b.txt` (13 bytes) became `/home/a/b.txt` (13 bytes) --
# the SAME LENGTH, which is why a length-only assertion cannot see it -- on
# every `file_ops` call, every process spawn, rename, move and dir_remove_all.
#
# The platform decision is therefore the FIRST statement of every entry point,
# and the non-Windows branch returns `path` itself with no conversion run.
#
# Apply ONLY to a value already known to be a filesystem path. A URL, a CLI
# switch or a regex also contains "/" and would be mangled.
#
# Record: doc/08_tracking/bug/pr255_host_path_native_corrupts_posix_paths_and_costs_unix_2026-09-02.md

@unsafe(reason: "raw compiled host-platform name ABI", capabilities: [ffi])
extern fn rt_platform_name() -> text

fn _host_is_windows(platform: text) -> bool:
    val name = platform.lower()
    name.contains("windows") or name.contains("mingw") or name.contains("msys") or name.contains("cygwin")

fn _ascii_drive(value: text) -> bool:
    value.len() == 1 and "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".contains(value)

pub fn host_path_canonical_for(path: text, platform: text) -> text:
    """Native-form path -> canonical forward-slash form, for an EXPLICIT platform.

    Windows only. Off Windows this is the identity: `\\` is a legal POSIX
    filename character, so rewriting it corrupts real paths.
    """
    if not _host_is_windows(platform): return path
    path.replace("\\", "/")

fn _mingw_drive_to_windows(path: text) -> text:
    # Documented MinGW/MSYS grammar: /c/rest. Also admit the compact c/rest
    # spelling requested by the language path surface.
    if path.len() >= 3 and path.starts_with("/") and _ascii_drive(path.slice(1, 2)) and path.slice(2, 3) == "/":
        return path.slice(1, 2).upper() + ":/" + path.slice(3, path.len())
    if path.len() >= 2 and _ascii_drive(path.slice(0, 1)) and path.slice(1, 2) == "/":
        return path.slice(0, 1).upper() + ":/" + path.slice(2, path.len())
    if path.len() >= 3 and _ascii_drive(path.slice(0, 1)) and path.slice(1, 3) == ":/":
        return path.slice(0, 1).upper() + path.slice(1, path.len())
    path

pub fn host_path_native_for(path: text, platform: text) -> text:
    """Canonical path -> native path for an EXPLICIT platform name.

    The test seam: pass `"linux"` to assert the identity contract from a Windows
    host. The platform guard is the first statement, so no conversion whatsoever
    runs before it.
    """
    if not _host_is_windows(platform): return path
    _mingw_drive_to_windows(path.replace("\\", "/")).replace("/", "\\")

fn _host_platform_name() -> text:
    unsafe(capabilities: [ffi]):
        rt_platform_name()

pub fn host_path_canonical(path: text) -> text:
    """Native-form path -> canonical form on the running host. Identity off Windows."""
    host_path_canonical_for(path, _host_platform_name())

pub fn host_path_native(path: text) -> text:
    host_path_native_for(path, _host_platform_name())
