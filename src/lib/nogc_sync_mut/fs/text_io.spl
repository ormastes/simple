# Single home of the `std.fs` text helpers.
#
# `<family>/fs.spl` and `<family>/fs/__init__.spl` both exist, and the two
# resolvers disagree on which `std.fs` names: the pure-Simple resolver
# (driver_source_loading.spl family loop) picks the FILE, the seed's variant
# fast path (path_resolution.rs try_variant_stdlib_root) picks the PACKAGE.
# Both re-export from this unambiguous submodule so either winner exposes the
# same one body.
use std.nogc_sync_mut.io_runtime.{read_file, write_file, list_dir}

fn file_read_text(path: text) -> text:
    read_file(path)

fn file_write_text(path: text, content: text) -> bool:
    write_file(path, content)

fn dir_children(path: text) -> [text]:
    list_dir(path)

export file_read_text, file_write_text, dir_children
