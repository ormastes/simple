# Canonical hosted socket nonblocking policy. Foreign code owns only native
# syscalls, O_NONBLOCK, and the Windows u_long pointer layout.
extern fn rt_socket_nonblock_prepare(fd: i64, mode: i64) -> i64
extern fn rt_socket_nonblock_commit(fd: i64, flags: i64) -> i64
extern fn rt_socket_nonblock_mask() -> i64

val SOCKET_NONBLOCK_FAILED: i64 = -1
val SOCKET_NONBLOCK_WINDOWS_COMPLETE: i64 = -2

fn socket_nonblock_target_flags(flags: i64, enabled: bool, mask: i64) -> i64:
    if enabled: flags | mask
    else: flags & ~mask

fn socket_nonblock_windows_mode(enabled: bool) -> i64:
    if enabled: 1
    else: 0

fn socket_nonblock_prepare_failed(prepare_status: i64) -> bool:
    prepare_status == SOCKET_NONBLOCK_FAILED

fn socket_nonblock_windows_completed(prepare_status: i64) -> bool:
    prepare_status == SOCKET_NONBLOCK_WINDOWS_COMPLETE

fn socket_nonblock_commit_succeeded(commit_status: i64) -> bool:
    commit_status == 0

@export("C", name: "rt_socket_set_nonblocking")
fn rt_socket_set_nonblocking(fd: i64, enabled: bool) -> bool:
    val prepare_status = unsafe(capabilities: [ffi]):
        rt_socket_nonblock_prepare(fd, socket_nonblock_windows_mode(enabled))
    if socket_nonblock_prepare_failed(prepare_status): return false
    if socket_nonblock_windows_completed(prepare_status): return true
    val mask = unsafe(capabilities: [ffi]):
        rt_socket_nonblock_mask()
    val target_flags = socket_nonblock_target_flags(prepare_status, enabled, mask)
    val commit_status = unsafe(capabilities: [ffi]):
        rt_socket_nonblock_commit(fd, target_flags)
    socket_nonblock_commit_succeeded(commit_status)

export rt_socket_set_nonblocking, socket_nonblock_target_flags, socket_nonblock_windows_mode
export socket_nonblock_prepare_failed, socket_nonblock_windows_completed, socket_nonblock_commit_succeeded
export SOCKET_NONBLOCK_FAILED, SOCKET_NONBLOCK_WINDOWS_COMPLETE
