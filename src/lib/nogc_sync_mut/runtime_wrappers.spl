# Runtime Extensions - Missing Runtime Methods
#
# Provides method-like wrappers for missing runtime functionality.
# These work around limitations where built-in types lack certain methods.

use std.text (text_hash)
use std.convert (i64_to_usize, usize_to_i64)
use std.common.validation.{clamp}

# ============================================================================
# String Hash Extension
# ============================================================================

fn hash(s: text) -> i64:
    """Compute hash of string. Wrapper for text_hash()."""
    text_hash(s)

# ============================================================================
# Type Conversions
# ============================================================================

fn to_usize(value: i64) -> i64:
    """Convert i64 to usize."""
    i64_to_usize(value)

fn from_usize(value: i64) -> i64:
    """Convert usize to i64."""
    usize_to_i64(value)

# ============================================================================
# Array Utilities
# ============================================================================

fn array_hash(arr: [text]) -> i64:
    """Compute hash of text array by combining element hashes."""
    var result = 0
    for item in arr:
        result = result xor text_hash(item)
    result

# ============================================================================
# Missing Common Functions
# ============================================================================

# `min`, `max` and `abs` used to be defined here as i64-only reimplementations.
# They were ACCIDENTAL SHADOWS of the compiler builtins of the same names, not
# deliberate wrappers: any module reaching this one through its transitive
# import closure silently rebound the builtin to these three, and their
# signatures accept only i64 -- so float callers were narrowed away.
#
# Deleting a reimplementation REROUTES rather than dedupes, so for the record:
# callers of bare `min`/`max`/`abs` now bind to the compiler builtins, which
# lower to a compare + a typed select in mir/lower/lowering_expr_builtin.rs and
# are correct for BOTH i64 and f64 (the f64 result type was fixed in
# doc/08_tracking/bug/numeric_builtins_hardcode_i64_result_type_2026-08-10.md).
# The i64 behaviour is identical to the bodies removed here -- the builtin
# lowering matches the same `if a < b: a else: b` semantics these hand-wrote --
# so this is a strict widening, never a narrowing.

