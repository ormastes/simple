@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# std.glob - Glob pattern matching utilities
# Pure Simple implementation
# Supports: *, ?, [abc], [a-z], [!abc]

use std.common.encoding.utf8.{utf8_seq_len}

fn glob_match(path: text, pattern: text) -> bool:
    _glob_at(s: path, si: 0, p: pattern, pi: 0)

# Byte length of the codepoint starting at byte offset `si` in `s` (>= 1;
# an invalid lead byte, or `si` out of range, falls back to 1 so callers can
# never loop forever). `si` itself is always byte-consistent here (advanced
# only by prior calls to this same helper or literal-match single-byte
# steps that are only ever taken on identical byte sequences -- see the
# "Literal match" branch below), so this never mis-reads a continuation
# byte as a lead byte. Returns a plain i64, not a tuple/aggregate -- see
# the note in js/builtins/string.spl's string_charAt for why aggregate
# returns across a call boundary are avoided on this seed.
fn _glob_codepoint_len_at(s: text, si: i64) -> i64:
    val slen = s.byte_len()
    if si < 0 or si >= slen:
        return 1
    val lead = s.byte_at(si)
    val seqlen = utf8_seq_len(lead)
    if seqlen <= 0:
        return 1
    seqlen

fn _glob_at(s: text, si: i64, p: text, pi: i64) -> bool:
    val plen = p.byte_len()
    val slen = s.byte_len()
    if pi >= plen:
        return si >= slen

    val pstep = _glob_codepoint_len_at(p, pi)
    var pend = pi + pstep
    if pend > plen:
        pend = plen
    val pc = p.substring(pi, pend)

    if pc == "*":
        # Star: try matching 0..N characters from current position, stepping by
        # whole UTF-8 codepoints in byte units.
        var i = si
        while i <= slen:
            if _glob_at(s: s, si: i, p: p, pi: pend):
                return true
            if i >= slen:
                break
            val step = _glob_codepoint_len_at(s, i)
            i = i + step
            if i > slen:
                i = slen
        return false

    if si >= slen:
        return false

    if pc == "?":
        # '?' matches exactly one character (full UTF-8 byte sequence at `si`).
        val step = _glob_codepoint_len_at(s, si)
        var next_si = si + step
        if next_si > slen:
            next_si = slen
        return _glob_at(s: s, si: next_si, p: p, pi: pend)

    if pc == "[":
        # Character class: find first closing ] in byte units
        var close = -1
        var ci = pend
        while ci < plen:
            val cstep = _glob_codepoint_len_at(p, ci)
            var cend = ci + cstep
            if cend > plen:
                cend = plen
            if close == -1 and p.substring(ci, cend) == "]":
                close = ci
            ci = cend
        if close > pend:
            val class_str = p.substring(pend, close)
            val seqlen = _glob_codepoint_len_at(s, si)
            var end = si + seqlen
            if end > slen:
                end = slen
            if _char_in_class(ch: s.substring(si, end), class_str: class_str):
                return _glob_at(s: s, si: end, p: p, pi: close + 1)
        return false

    # Literal match (whole codepoint at `si` vs whole codepoint `pc`)
    val sstep = _glob_codepoint_len_at(s, si)
    var send = si + sstep
    if send > slen:
        send = slen
    if s.substring(si, send) == pc:
        return _glob_at(s: s, si: send, p: p, pi: pend)

    false

fn _char_in_class(ch: text, class_str: text) -> bool:
    # Match character against class: abc, a-z, !abc
    val clen = class_str.byte_len()
    var negate = false
    var i = 0
    if clen > 0 and class_str.substring(0, 1) == "!":
        negate = true
        i = 1

    var found = false
    while i < clen:
        val step1 = _glob_codepoint_len_at(class_str, i)
        var end1 = i + step1
        if end1 > clen:
            end1 = clen
        val c = class_str.substring(i, end1)
        val has_dash = end1 + 1 <= clen and class_str.substring(end1, end1 + 1) == "-"
        val has_end = end1 + 1 < clen
        if has_dash and has_end:
            val rstart = end1 + 1
            val step2 = _glob_codepoint_len_at(class_str, rstart)
            var end2 = rstart + step2
            if end2 > clen:
                end2 = clen
            val range_end = class_str.substring(rstart, end2)
            if ch >= c and ch <= range_end:
                found = true
            i = end2
        else:
            if c == ch:
                found = true
            i = end1

    if negate: not found else: found
