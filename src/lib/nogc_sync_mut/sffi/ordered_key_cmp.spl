# Native representation-aware order for erased generic scalar/text keys.
# This stable spl_ ABI has core-C and Rust bootstrap runtime owners.
# The runtime compares registered text by content and scalar words by value.
# User-defined aggregate Ord dispatch still requires typed specialization.

@unsafe(reason: "erased generic key ordering ABI", capabilities: [ffi])
extern fn spl_ordered_key_cmp<K>(left: K, right: K) -> i64

# @workaround bug=eq_ord_where_bound_unresolved_hir_2026_10_19 recover=b73c24d606e reason=HIR lowers builtin-trait where bounds Eq/Ord as types and fails unresolved type; bounds dropped (erased before 5b649fb61fe)
fn ordered_key_native_usable<K>(key: K) -> bool:
    """Check this key before an automatic ordered transition or first insert."""
    if key != key:
        return false
    unsafe(capabilities: [ffi]):
        spl_ordered_key_cmp(key, key) == 0

# @workaround bug=eq_ord_where_bound_unresolved_hir_2026_10_19 recover=b73c24d606e reason=HIR lowers builtin-trait where bounds Eq/Ord as types and fails unresolved type; bounds dropped (erased before 5b649fb61fe)
fn ordered_key_native_cmp<K>(left: K, right: K) -> i64:
    unsafe(capabilities: [ffi]):
        val relation = spl_ordered_key_cmp(left, right)
        if relation == 2:
            panic("OrderedMap key type has no supported native order")
        relation

export ordered_key_native_cmp
export ordered_key_native_usable
