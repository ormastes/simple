# Trusted serializer boundary for the selected runtime's immutable enum ABI.
# The prototype is constructed by the ordinary typed language constructor.
# Never manufacture IDs, mutate its tuple, or reinterpret an integer as T.

@unsafe(reason: "selected runtime enum identity; caller supplies a typed enum prototype", capabilities: [ffi])
extern fn rt_enum_id<T>(value: T) -> i64
@unsafe(reason: "selected runtime enum discriminant; invalid handle returns minus one", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64
@unsafe(reason: "selected runtime enum payload word; identity must be validated first", capabilities: [ffi])
extern fn rt_enum_payload<T>(value: T) -> i64
@unsafe(reason: "reconstruct only the validated prototype type with its exact identity and owned payload", capabilities: [ffi])
extern fn rt_enum_new<T>(enum_id: i32, discriminant: i32, payload: i64) -> T
@unsafe(reason: "selected runtime nil word, not an assumed numeric sentinel", capabilities: [ffi])
extern fn rt_value_nil() -> i64
@unsafe(reason: "private runtime tuple allocation; invalid result is checked by length", capabilities: [ffi])
extern fn rt_tuple_new(length: i64) -> i64
@unsafe(reason: "runtime tuple length; invalid handle returns minus one", capabilities: [ffi])
extern fn rt_tuple_len(tuple: i64) -> i64
@unsafe(reason: "selected runtime validates array ownership and kind; invalid lengths cannot satisfy a declared multi-field arity", capabilities: [ffi])
extern fn rt_array_len(array: i64) -> i64
@unsafe(reason: "read an in-range field of a runtime-validated tuple or enum payload array", capabilities: [ffi])
extern fn rt_tuple_get(tuple: i64, index: i64) -> i64
@unsafe(reason: "write only the private newly allocated tuple; check success", capabilities: [ffi])
extern fn rt_tuple_set(tuple: i64, index: i64, value: i64) -> i8

@unsafe(reason: "caller checks exact declared arity greater than one; seed enum payloads are Arrays while native tuples are Tuples", capabilities: [ffi])
fn enum_wire_multi_payload_len(payload: i64) -> i64:
    val tuple_length = rt_tuple_len(payload)
    if tuple_length >= 0:
        return tuple_length
    # Both runtime owners validate array ownership/kind. Their invalid-array
    # results (-1 or 0) cannot match a declared multi-field arity >= 2.
    rt_array_len(payload)

@unsafe(reason: "serializer proves T is an enum and arity/index match its actual variant schema; runtime words cannot prove single tuple versus multiple fields", capabilities: [ffi])
fn enum_wire_nil_slot<T>(value: T, arity: i64, index: i64) -> Result<bool, text>:
    if arity < 1 or index < 0 or index >= arity:
        return Err("enum wire slot out of range")
    unsafe(capabilities: [ffi]):
        val owner = rt_enum_id(value)
        if owner < 0:
            return Err("enum wire invalid enum")
        val variant = rt_enum_discriminant(value)
        if variant < 0:
            return Err("enum wire invalid enum")
        val payload = rt_enum_payload(value)
        if arity == 1:
            return Ok(payload == rt_value_nil())
        val actual_arity = enum_wire_multi_payload_len(payload)
        if actual_arity != arity:
            return Err("enum wire tuple arity mismatch owner={owner} variant={variant} expected_arity={arity} index={index} actual_arity={actual_arity}")
        Ok(rt_tuple_get(payload, index) == rt_value_nil())

@unsafe(reason: "trusted serializer proves actual variant schema and that every replacement slot admits wire nil; prototype and payloads belong to the active runtime scope", capabilities: [ffi])
fn enum_wire_restore_nil<T>(prototype: T, arity: i64, nil_slots: [i64]) -> Result<T, text>:
    if arity < 0:
        return Err("enum wire negative arity")
    for slot in nil_slots:
        if slot < 0 or slot >= arity:
            return Err("enum wire slot out of range")
    unsafe(capabilities: [ffi]):
        val owner = rt_enum_id(prototype)
        val variant = rt_enum_discriminant(prototype)
        # Runtime identity fields are uint32, including values above INT32_MAX.
        if owner < 0 or owner > 4294967295 or variant < 0 or variant > 4294967295:
            return Err("enum wire invalid enum identity")
        val original = rt_enum_payload(prototype)
        if arity > 1 and enum_wire_multi_payload_len(original) != arity:
            return Err("enum wire tuple arity mismatch")
        if nil_slots.len() == 0:
            return Ok(prototype)
        var payload = rt_value_nil()
        if arity > 1:
            payload = rt_tuple_new(arity)
            if rt_tuple_len(payload) != arity:
                return Err("enum wire tuple allocation failed")
            var index = 0
            while index < arity:
                val word = rt_tuple_get(original, index)
                if rt_tuple_set(payload, index, word) == 0:
                    return Err("enum wire tuple write failed")
                index = index + 1
            for slot in nil_slots:
                if rt_tuple_set(payload, slot, rt_value_nil()) == 0:
                    return Err("enum wire tuple write failed")
        # The casts preserve the validated uint32 bit patterns required by C.
        val restored: T = rt_enum_new<T>(owner as i32, variant as i32, payload)
        if rt_enum_id(restored) != owner or rt_enum_discriminant(restored) != variant:
            return Err("enum wire enum allocation failed")
        Ok(restored)

export enum_wire_nil_slot, enum_wire_restore_nil

# Raw, non-authorizing observation of two internally constructed typed values.
# No externally supplied handle reaches a runtime getter through this API.
struct ResultI64RawProjectionV1:
    enum_runtime_id: i64
    discriminant: i64
    payload_bits: i64

struct ResultI64RawPairV1:
    normal: ResultI64RawProjectionV1
    error: ResultI64RawProjectionV1

fn enum_wire_result_i64_capture_v1(
    expected_enum_id: i64, expected_ok_tag: i64, expected_err_tag: i64,
    normal_bits: i64, error_bits: i64
) -> Result<ResultI64RawPairV1, text>:
    # These are expectations, not authentication. The compiler adapter obtains
    # them from canonical registration independently of the observed values.
    if expected_enum_id < 0 or expected_enum_id > 4294967295 or
            expected_ok_tag != 0 or expected_err_tag != 1:
        return Err("FV2-E-RESULT-RAW-SCHEMA: canonical Ok/Err metadata required")
    val normal: Result<i64, i64> = Ok(normal_bits)
    val error: Result<i64, i64> = Err(error_bits)
    unsafe(capabilities: [ffi]):
        val normal_owner = rt_enum_id(normal)
        val error_owner = rt_enum_id(error)
        if normal_owner != expected_enum_id or error_owner != expected_enum_id:
            return Err("FV2-E-RESULT-RAW-OWNER: typed Result owner mismatch")
        val normal_tag = rt_enum_discriminant(normal)
        val error_tag = rt_enum_discriminant(error)
        if normal_tag != expected_ok_tag or error_tag != expected_err_tag:
            return Err("FV2-E-RESULT-RAW-TAG: typed Result variant mismatch")
        # Both owners and tags are checked before either payload is read.
        # Typed values remain live in this scope; no pointer escapes or is freed.
        val normal_payload = rt_enum_payload(normal)
        val error_payload = rt_enum_payload(error)
        Ok(ResultI64RawPairV1(
            normal: ResultI64RawProjectionV1(enum_runtime_id: normal_owner,
                discriminant: normal_tag, payload_bits: normal_payload),
            error: ResultI64RawProjectionV1(enum_runtime_id: error_owner,
                discriminant: error_tag, payload_bits: error_payload)))

export ResultI64RawProjectionV1, ResultI64RawPairV1, enum_wire_result_i64_capture_v1
