# Narrow hosted heap-counter ABI. Both symbols are defined by the core-C
# runtime, so the compiler closure can import them without linking the
# `sffi.host` hub and its hosted-only externs.
@unsafe(reason: "raw runtime ABI for rt_heap_alloc_count", capabilities: [ffi])
extern fn rt_heap_alloc_count() -> i64

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in heap_alloc_count", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
@always_inline
fn heap_alloc_count() -> i64:
    unsafe(capabilities: [ffi]):
        rt_heap_alloc_count()

@unsafe(reason: "raw runtime ABI for rt_heap_array_capacity_bytes", capabilities: [ffi])
extern fn rt_heap_array_capacity_bytes() -> i64

@representation_boundary(kind: "ffi", reason: "Explicit unsafe ffi boundary in heap_array_capacity_bytes", reviewers: ["ormastes", "opus-review"], capabilities: ["ffi"])
@always_inline
fn heap_array_capacity_bytes() -> i64:
    unsafe(capabilities: [ffi]):
        rt_heap_array_capacity_bytes()

export heap_alloc_count, heap_array_capacity_bytes, rt_heap_alloc_count, rt_heap_array_capacity_bytes
