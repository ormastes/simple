# Dynamic Library Loader (SFFI)
#
# Provides convention-based dynamic loading of .so/.dll for SFFI.
# Convention: rt_{prefix}_{fn} -> $SIMPLE_SFFI_PATH/libspl_{prefix}.so
#
# Works in C-compiled mode where spl_dlopen/spl_dlsym are available.
# In interpreter mode, spl_dlopen is not whitelisted — use compiled binary.
#
# Usage:
#   val lib = DynLib.load("build/libspl_torch.so")
#   match lib:
#     case Some(h):
#       val result = h.call1("rt_torch_available", 0)
#     case None:
#       pass
#
#   # Or via DynLoader singleton:
#   DynLoader.instance().ensure_loaded("build/libspl_torch.so")
#   val result = DynLoader.instance().call0("build/libspl_torch.so", "rt_torch_available")
#
#   # Or via convention:
#   val result = sffi_call("rt_torch_available", [])

# ============================================================================
# Raw SFFI Declarations
# ============================================================================

@unsafe(reason: "raw dynamic library admission ABI", capabilities: [ffi])
extern fn spl_dlopen(path: text) -> i64
@unsafe(reason: "status/out dynamic library admission ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlopen_checked(path: text, out_handle: *mut i64) -> i64
@unsafe(reason: "raw dynamic symbol resolution ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlsym(handle: i64, name: text) -> i64
@unsafe(reason: "status/out dynamic symbol resolution ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlsym_checked(handle: i64, name: text, out_symbol: *mut i64) -> i64
@unsafe(reason: "status/out current-process symbol resolution ABI", capabilities: [ffi, raw_ptr])
extern fn spl_dlsym_process_checked(name: text, out_symbol: *mut i64) -> i64
@unsafe(reason: "raw dynamic library release ABI", capabilities: [ffi])
extern fn spl_dlclose(handle: i64) -> i64
@unsafe(reason: "copies the provider into a sealed Linux admission snapshot", capabilities: [ffi])
extern fn spl_dynlib_snapshot_linux(path: text) -> i64
@unsafe(reason: "closes the provider artifact admission descriptor", capabilities: [ffi])
extern fn rt_file_close(fd: i32) -> bool
@unsafe(reason: "hashes the exact open provider artifact through its descriptor path", capabilities: [ffi])
extern fn rt_file_hash_sha256(path: text) -> text
@unsafe(reason: "untyped integer-only foreign call ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64(fptr: i64, args: [i64], nargs: i64) -> i64
@unsafe(reason: "checked integer-only foreign call ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_call_i64_checked(fptr: i64, args: [i64], nargs: i64) -> [i64]
@unsafe(reason: "allocation-free checked integer status/out ABI", capabilities: [ffi, raw_ptr])
extern fn spl_wffi_try_call_i64_out(fptr: i64, args: [i64], nargs: i64, out_value: *mut i64) -> i64

@unsafe(reason: "minimal raw dynamic FFI scope; caller validates status and result shape", capabilities: [ffi])
fn _sffi_call_i64_raw_checked(fptr: i64, args: [i64]) -> [i64]:
    spl_wffi_call_i64_checked(fptr, args, args.len())

# Does this lane actually deliver the `*mut i64` writeback?
#
# A null function pointer with a valid out slot is answered
# SPL_WFFI_NULL_FUNCTION (2) by every provider that honours the contract: both
# the C provider and the Rust provider zero the out slot and only then reject
# the pointer, and neither enters foreign code, so the probe has no side
# effects and costs no allocation. A lane that cannot carry the out parameter
# rejects the argument shape first and answers SPL_WFFI_INVALID_ARGUMENT (1) —
# which is exactly what the seed interpreter lane does today, the same
# writeback loss `_sffi_dlopen_checked` already works around. Measured
# 2026-09-06 on the aarch64 seed: `spl_dlsym_checked` reports status 1 with the
# out slot untouched, and so does `spl_wffi_try_call_i64_out`.
@unsafe(reason: "probes the raw status/out ABI without entering foreign code", capabilities: [ffi, raw_ptr])
fn _sffi_i64_out_transport_honoured() -> bool:
    var probe: i64 = 0
    val status = unsafe(capabilities: [ffi, raw_ptr]):
        spl_wffi_try_call_i64_out(0, [], 0, &mut probe)
    status == 2

# Canonical checked integer dispatch. The scalar status/out transport allocates
# nothing, so the cached hot path performs no allocation and needs no release.
# Only when the out transport is not honoured by this lane does the call fall
# back to the allocating `[status, value]` transport, which stays the public
# API. A valid foreign zero remains distinct from a bridge failure either way.
@unsafe(reason: "checked transport cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
fn _sffi_call_i64_checked(fptr: i64, args: [i64], symbol: text) -> Result<i64, text>:
    var value: i64 = 0
    val status = unsafe(capabilities: [ffi, raw_ptr]):
        spl_wffi_try_call_i64_out(fptr, args, args.len(), &mut value)
    if status == 0:
        return Ok(value)
    if _sffi_i64_out_transport_honoured():
        return Err("E-SFFI-014: foreign bridge rejected {symbol} with status {status}")
    val result = _sffi_call_i64_raw_checked(fptr, args)
    if result.len() != 2:
        return Err("E-SFFI-017: corrupt checked transport result: {symbol}")
    val fallback_status = result[0]
    if fallback_status == 0:
        return Ok(result[1])
    Err("E-SFFI-014: foreign bridge rejected {symbol} with status {fallback_status}")

@unsafe(reason: "checked loader returns an unverified raw provider handle", capabilities: [ffi, raw_ptr])
fn _sffi_dlopen_checked(path: text) -> Result<i64, text>:
    # An absent provider artifact can never load. Reject it before entering the
    # raw loader: the interpreter lane's `spl_dlopen` raises
    # `spl_dlopen failed for '<path>'` and aborts instead of returning a
    # non-positive handle, so without this the documented Err path is
    # unobservable there and every checked caller dies rather than failing
    # closed. Existence is probed through the typed `file_exists` alias of
    # std.io_runtime (already imported here), not a new raw `rt_*` call site.
    if path == "":
        return Err("E-SFFI-001: failed to load provider: empty provider path")
    # Only a path (one containing a separator) names a filesystem artifact. A
    # bare soname such as `libsimple_audio_cuda.so` is resolved by the dynamic
    # loader's own search path and must still be handed to it.
    if path.contains("/") and not file_exists(path):
        return Err("E-SFFI-001: failed to load provider: {path} (artifact not present)")
    var handle: i64 = 0
    val status = unsafe(capabilities: [ffi, raw_ptr]):
        spl_dlopen_checked(path, &mut handle)
    if status == 0 and handle > 0:
        return Ok(handle)
    # status==0 with handle==0 is the &mut-out-param writeback-loss signature
    # of the seed interpreter lane (spl_dlopen_checked sets the out slot through
    # a BorrowMut the caller never observes). Fall back to the direct-return
    # ABI, which works identically in compiled and interpreted modes; a genuine
    # load failure still surfaces as handle<=0 here.
    val direct = unsafe(capabilities: [ffi]):
        spl_dlopen(path)
    if direct <= 0:
        return Err("E-SFFI-001: failed to load provider: {path} (status {status})")
    Ok(direct)

@unsafe(reason: "checked resolver returns an unverified raw function pointer", capabilities: [ffi, raw_ptr])
fn _sffi_dlsym_checked(handle: i64, name: text) -> Result<i64, text>:
    if handle <= 0:
        return Err("E-SFFI-001: cannot resolve {name} from a null provider handle")
    var symbol: i64 = 0
    val status = unsafe(capabilities: [ffi, raw_ptr]):
        spl_dlsym_checked(handle, name, &mut symbol)
    if status == 0 and symbol > 0:
        return Ok(symbol)
    # Same writeback-loss fallback as _sffi_dlopen_checked above.
    val direct = unsafe(capabilities: [ffi]):
        spl_dlsym(handle, name)
    if direct <= 0:
        return Err("E-SFFI-001: unresolved foreign symbol: {name} (status {status})")
    Ok(direct)

# Resolved, immutable integer-only call slot. Resolution happens once; calls do
# not perform dlsym, path lookup, hashing, or signature verification. This is a
# migration type, not a generally safe FFI type: it can represent only the
# explicit C family `i64(i64...)`, with 0..8 arguments.
class DynI64FnSlot:
    fptr: i64
    symbol: text
    provider_path: text
    arity: i64

impl DynI64FnSlot:
    @unsafe(reason: "resolved integer slot cannot prove the provider artifact or declared C ABI", capabilities: [ffi, raw_ptr])
    fn call_checked(args: [i64]) -> Result<i64, text>:
        if args.len() != self.arity:
            return Err("E-SFFI-003: {self.symbol} expects {self.arity} i64 arguments, got {args.len()}")
        _sffi_call_i64_checked(self.fptr, args, self.symbol)

use std.common.structural.digest.hash256.{hash256_hex_valid}
use std.io_runtime.{env_get, file_exists}
use std.sffi.admission.{
    SffiAdmissionTrustRootV1, SignatureVerifiedSffiAdmissionV1,
    verify_sffi_evidence_v2,
}

# ============================================================================
# DynLib — single loaded shared library handle
# ============================================================================

class DynLib:
    handle: i64
    path: text

# Linux sealed-snapshot admission result. File-private fields confine aggregate
# construction to this canonical loader owner while public methods expose only
# read-only identity and unsafe resolution. The type remains ffi-unsafe until
# the loader verifies signed trust policy rather than a caller-supplied digest.
pub class ExactArtifactDynLib:
    lib: DynLib
    artifact_sha256: text

# Exact sealed artifact paired with a cryptographically verified admission
# receipt. Signature verification and hashing occur only during construction.
pub class SignatureVerifiedExactArtifactDynLib:
    sealed: ExactArtifactDynLib
    admission: SignatureVerifiedSffiAdmissionV1

impl SignatureVerifiedExactArtifactDynLib:
    pub fn artifact_digest() -> text:
        self.sealed.artifact_digest()

    pub fn provider_identity() -> text:
        self.admission.provider_identity()

    pub fn target_identity() -> text:
        self.admission.target_identity()

    pub(package) fn verified_admission() -> SignatureVerifiedSffiAdmissionV1:
        self.admission

    @unsafe(
        reason: "signature authenticates a caller-authorized provider but cannot prove arbitrary native code memory-safe",
        capabilities: [ffi],
    )
    static fn load_signed_linux(
        path: text,
        admission_content: text,
        signature: [u8],
        trust_roots: [SffiAdmissionTrustRootV1],
    ) -> Result<SignatureVerifiedExactArtifactDynLib, text>:
        val admission = match verify_sffi_evidence_v2(
            admission_content, signature, trust_roots):
            case Ok(value): value
            case Err(error): return Err(error)
        val sealed = match ExactArtifactDynLib.load_exact_linux(
            path, admission.artifact_digest()):
            case Ok(value): value
            case Err(error): return Err(error)
        Ok(SignatureVerifiedExactArtifactDynLib(
            sealed: sealed,
            admission: admission,
        ))

    @unsafe(reason: "returns a cached integer-only slot after signed exact-artifact admission", capabilities: [ffi, raw_ptr])
    pub fn resolve_i64_checked(name: text, arg_count: i64) -> Result<DynI64FnSlot, text>:
        self.sealed.resolve_i64_checked(name, arg_count)

impl ExactArtifactDynLib:
    pub fn artifact_digest() -> text:
        self.artifact_sha256

    @unsafe(reason: "resolves a symbol only from the sealed exact-artifact handle", capabilities: [ffi, raw_ptr])
    pub fn resolve_i64_checked(name: text, arg_count: i64) -> Result<DynI64FnSlot, text>:
        self.lib.resolve_i64_checked(name, arg_count)

    @unsafe(
        reason: "sealed Linux snapshot is hashed and loaded against a caller-supplied digest, not loader-verified trust policy",
        capabilities: [ffi],
    )
    static fn load_exact_linux(path: text, expected_sha256: text) -> Result<ExactArtifactDynLib, text>:
        if platform_name() != "linux":
            return Err("E-SFFI-020: exact artifact loading is currently supported only on Linux")
        if not hash256_hex_valid(expected_sha256):
            return Err("E-SFFI-004: expected provider artifact SHA-256 must be 64 lowercase hex characters")

        val fd = spl_dynlib_snapshot_linux(path)
        if fd < 0:
            return Err("E-SFFI-001: failed to open provider artifact: {path}")
        val fd_i32 = fd.to_i32()
        val descriptor_path = "/proc/self/fd/{fd}"
        val actual_sha256 = rt_file_hash_sha256(descriptor_path)
        if actual_sha256 != expected_sha256:
            rt_file_close(fd_i32)
            return Err("E-SFFI-004: provider artifact SHA-256 mismatch: {path}")
        match _sffi_dlopen_checked(descriptor_path):
            case Ok(handle):
                if not rt_file_close(fd_i32):
                    spl_dlclose(handle)
                    return Err("E-SFFI-018: failed to close provider admission descriptor: {path}")
                Ok(ExactArtifactDynLib(
                    lib: DynLib(handle: handle, path: path),
                    artifact_sha256: actual_sha256,
                ))
            case Err(error):
                if not rt_file_close(fd_i32):
                    return Err("E-SFFI-018: failed to close provider admission descriptor: {path}")
                Err(error)

impl DynLib:
    @unsafe(reason: "loads an unverified dynamic provider", capabilities: [ffi])
    static fn load_checked(path: text) -> Result<DynLib, text>:
        match _sffi_dlopen_checked(path):
            case Ok(handle): Ok(DynLib(handle: handle, path: path))
            case Err(error): Err(error)

    # Load a shared library from the given path.
    # Returns nil if dlopen fails.
    @unsafe(reason: "loads an unverified dynamic provider", capabilities: [ffi])
    static fn load(path: text) -> DynLib?:
        match _sffi_dlopen_checked(path):
            case Ok(handle): Some(DynLib(handle: handle, path: path))
            case Err(_): nil

    @unsafe(reason: "loads an unverified dynamic provider", capabilities: [ffi])
    static fn open(path: text) -> DynLib:
        match _sffi_dlopen_checked(path):
            case Ok(handle): DynLib(handle: handle, path: path)
            case Err(error): panic(error)

    # Look up a symbol by name. Returns 0 if not found.
    @unsafe(reason: "resolves an unverified raw function pointer", capabilities: [ffi, raw_ptr])
    fn sym(name: text) -> i64:
        if self.handle <= 0:
            return 0
        spl_dlsym(self.handle, name)

    @unsafe(reason: "resolves an unverified raw function pointer into a typed error channel", capabilities: [ffi, raw_ptr])
    fn sym_checked(name: text) -> Result<i64, text>:
        _sffi_dlsym_checked(self.handle, name)

    # Call a function with 0 arguments.
    @unsafe(reason: "invokes an untyped foreign function pointer", capabilities: [ffi, raw_ptr])
    fn call0(name: text) -> i64:
        if self.handle <= 0:
            panic("E-SFFI-001: provider is not loaded: {self.path}")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): panic(error)
        var args: [i64] = []
        spl_wffi_call_i64(fptr, args, 0)

    # Call a function with 1 argument.
    @unsafe(reason: "invokes an untyped foreign function pointer", capabilities: [ffi, raw_ptr])
    fn call1(name: text, a0: i64) -> i64:
        if self.handle <= 0:
            panic("E-SFFI-001: provider is not loaded: {self.path}")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): panic(error)
        var args: [i64] = []
        args.push(a0)
        spl_wffi_call_i64(fptr, args, 1)

    # Call a function with 2 arguments.
    @unsafe(reason: "invokes an untyped foreign function pointer", capabilities: [ffi, raw_ptr])
    fn call2(name: text, a0: i64, a1: i64) -> i64:
        if self.handle <= 0:
            panic("E-SFFI-001: provider is not loaded: {self.path}")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): panic(error)
        var args: [i64] = []
        args.push(a0)
        args.push(a1)
        spl_wffi_call_i64(fptr, args, 2)

    # Call a function with 3 arguments.
    @unsafe(reason: "invokes an untyped foreign function pointer", capabilities: [ffi, raw_ptr])
    fn call3(name: text, a0: i64, a1: i64, a2: i64) -> i64:
        if self.handle <= 0:
            panic("E-SFFI-001: provider is not loaded: {self.path}")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): panic(error)
        var args: [i64] = []
        args.push(a0)
        args.push(a1)
        args.push(a2)
        spl_wffi_call_i64(fptr, args, 3)

    # Call a function with 4 arguments.
    @unsafe(reason: "invokes an untyped foreign function pointer", capabilities: [ffi, raw_ptr])
    fn call4(name: text, a0: i64, a1: i64, a2: i64, a3: i64) -> i64:
        if self.handle <= 0:
            panic("E-SFFI-001: provider is not loaded: {self.path}")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): panic(error)
        var args: [i64] = []
        args.push(a0)
        args.push(a1)
        args.push(a2)
        args.push(a3)
        spl_wffi_call_i64(fptr, args, 4)

    # Call a function with a pre-built args array (general case).
    @unsafe(reason: "invokes an untyped foreign function pointer", capabilities: [ffi, raw_ptr])
    fn call_n(name: text, args: [i64]) -> i64:
        if self.handle <= 0:
            panic("E-SFFI-001: provider is not loaded: {self.path}")
        if args.len() > 8:
            panic("E-SFFI-014: integer bridge supports at most 8 arguments")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): panic(error)
        val nargs = args.len()
        spl_wffi_call_i64(fptr, args, nargs)

    # Canonical checked dispatch, delegated to the allocation-free scalar
    # status/out transport. A valid foreign zero stays distinct from a bridge
    # failure.
    @unsafe(reason: "checked transport cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
    fn call_checked(name: text, args: [i64]) -> Result<i64, text>:
        if self.handle <= 0:
            return Err("E-SFFI-001: provider is not loaded: {self.path}")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): return Err(error)
        _sffi_call_i64_checked(fptr, args, name)

    # Resolve one exact integer-only ABI slot. Callers cache the returned slot
    # and avoid dlsym/string lookup on every invocation.
    @unsafe(reason: "resolves an unverified integer-only foreign ABI slot", capabilities: [ffi, raw_ptr])
    fn resolve_i64_checked(name: text, arity: i64) -> Result<DynI64FnSlot, text>:
        if self.handle <= 0:
            return Err("E-SFFI-001: provider is not loaded: {self.path}")
        if arity < 0 or arity > 8:
            return Err("E-SFFI-003: unsupported i64 ABI arity {arity} for {name}; expected 0..8")
        val fptr = match _sffi_dlsym_checked(self.handle, name):
            case Ok(symbol): symbol
            case Err(error): return Err(error)
        Ok(DynI64FnSlot(
            fptr: fptr,
            symbol: name,
            provider_path: self.path,
            arity: arity
        ))

    # Close the library and zero the handle.
    @unsafe(reason: "releases an unverified dynamic provider", capabilities: [ffi])
    me close():
        if self.handle <= 0:
            self.handle = 0
            return
        spl_dlclose(self.handle)
        self.handle = 0

# ============================================================================
# Module-level singleton state for DynLoader
# ============================================================================

var _dyn_loader_libs: {text: DynLib} = {}

# ============================================================================
# DynLoader — convention-based singleton loader
# ============================================================================

class DynLoader:
    libs: {text: DynLib}

impl DynLoader:
    # Return a DynLoader wrapping the module-level shared state.
    static fn instance() -> DynLoader:
        DynLoader(libs: _dyn_loader_libs)

    # Ensure the library at path is loaded. Returns true if available.
    @unsafe(reason: "legacy boolean load result omits provider admission evidence", capabilities: [ffi])
    me ensure_loaded(path: text) -> bool:
        if self.libs.contains(path):
            true
        else:
            match DynLib.load(path):
                case Some(lib):
                    self.libs[path] = lib
                    _dyn_loader_libs[path] = lib
                    true
                case nil:
                    false

    # Fail-closed load path for callers migrating away from boolean/sentinel
    # results. This caches exactly the same DynLib value as ensure_loaded and
    # performs no hashing, signature verification, or symbol lookup per call.
    # It remains unsafe because this legacy loader has not admitted the
    # provider artifact or verified its ABI registry.
    @unsafe(reason: "checked load result cannot admit or verify the dynamic provider", capabilities: [ffi])
    me ensure_loaded_checked(path: text) -> Result<DynLib, text>:
        if self.libs.contains(path):
            return Ok(self.libs[path])
        match DynLib.load_checked(path):
            case Ok(lib):
                self.libs[path] = lib
                _dyn_loader_libs[path] = lib
                Ok(lib)
            case Err(error):
                Err(error)

    # Return the loaded DynLib for path, or nil.
    @unsafe(reason: "exposes an unverified dynamic provider handle", capabilities: [ffi, raw_ptr])
    fn get_lib(path: text) -> DynLib?:
        if self.libs.contains(path):
            self.libs[path]
        else:
            nil

    # Call with 0 arguments, loading the library if needed.
    @unsafe(reason: "legacy untyped dispatch is fail-closed but cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
    me call0(path: text, func: text) -> i64:
        if not self.ensure_loaded(path):
            panic("E-SFFI-001: failed to load provider: {path}")
        val lib = self.libs[path]
        lib.call0(func)

    # Call with 1 argument.
    @unsafe(reason: "legacy untyped dispatch is fail-closed but cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
    me call1(path: text, func: text, a0: i64) -> i64:
        if not self.ensure_loaded(path):
            panic("E-SFFI-001: failed to load provider: {path}")
        val lib = self.libs[path]
        lib.call1(func, a0)

    # Call with 2 arguments.
    @unsafe(reason: "legacy untyped dispatch is fail-closed but cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
    me call2(path: text, func: text, a0: i64, a1: i64) -> i64:
        if not self.ensure_loaded(path):
            panic("E-SFFI-001: failed to load provider: {path}")
        val lib = self.libs[path]
        lib.call2(func, a0, a1)

    # Call with 3 arguments.
    @unsafe(reason: "legacy untyped dispatch is fail-closed but cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
    me call3(path: text, func: text, a0: i64, a1: i64, a2: i64) -> i64:
        if not self.ensure_loaded(path):
            panic("E-SFFI-001: failed to load provider: {path}")
        val lib = self.libs[path]
        lib.call3(func, a0, a1, a2)

    # General dispatch with pre-built args array.
    @unsafe(reason: "legacy untyped dispatch is fail-closed but cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
    me call(path: text, func: text, args: [i64]) -> i64:
        if not self.ensure_loaded(path):
            panic("E-SFFI-001: failed to load provider: {path}")
        val lib = self.libs[path]
        lib.call_n(func, args)

    # Canonical fail-closed singleton dispatch. The provider cache lookup and
    # dlsym cost match the legacy general path; only the checked bridge result
    # allocation is added. ABI typing and provider admission remain unresolved,
    # so this surface is intentionally unsafe.
    @unsafe(reason: "checked transport cannot verify the provider artifact or all-i64 ABI", capabilities: [ffi, raw_ptr])
    me call_checked(path: text, func: text, args: [i64]) -> Result<i64, text>:
        match self.ensure_loaded_checked(path):
            case Ok(lib):
                lib.call_checked(func, args)
            case Err(error):
                Err(error)

# ============================================================================
# Platform helpers
# ============================================================================

# Return the current platform name: "linux", "macos", "windows", or "freebsd".
fn platform_name() -> text:
    val os = env_get("OS") ?? ""
    if os == "Windows_NT":
        return "windows"
    val ostype = env_get("OSTYPE") ?? ""
    if ostype.starts_with("darwin"):
        return "macos"
    if ostype.starts_with("freebsd"):
        return "freebsd"
    "linux"

# Return the shared library extension for the current platform: ".so", ".dylib", or ".dll".
fn platform_lib_extension() -> text:
    val plat = platform_name()
    if plat == "windows":
        return ".dll"
    if plat == "macos":
        return ".dylib"
    ".so"

# ============================================================================
# Convention helpers
# ============================================================================

# Build the library path for a given SFFI prefix.
# Reads SIMPLE_SFFI_PATH env var; defaults to "build" if empty.
# On Windows (OS == "Windows_NT") uses .dll extension, otherwise .so.
fn sffi_lib_path(prefix: text) -> text:
    var base = env_get("SIMPLE_SFFI_PATH") ?? ""
    if base == "":
        base = "build"
    val os = env_get("OS")
    if os == "Windows_NT":
        "{base}/libspl_{prefix}.dll"
    else:
        "{base}/libspl_{prefix}.so"

# Call an SFFI function by its full rt_{prefix}_{rest} name.
# Parses the prefix from the function name, resolves the library path
# via sffi_lib_path, and dispatches through the DynLoader singleton.
#
# Example:
#   sffi_call("rt_torch_available", [])
@unsafe(reason: "legacy convention dispatch is fail-closed but cannot verify the foreign ABI", capabilities: [ffi, raw_ptr])
fn sffi_call(func_name: text, args: [i64]) -> i64:
    val parts = func_name.split("_")
    if parts.len() < 2:
        panic("E-SFFI-003: malformed foreign symbol name: {func_name}")
    val prefix = parts[1]
    if prefix == "":
        panic("E-SFFI-003: malformed foreign symbol name: {func_name}")
    val lib_path = sffi_lib_path(prefix)
    var loader = DynLoader.instance()
    loader.call(lib_path, func_name, args)

# Fail-closed convention dispatch for migration callers. This distinguishes a
# valid foreign zero from malformed naming, provider load failure, missing
# symbol, corrupt bridge transport, and bridge rejection. It is not a safe ABI:
# all arguments/results are still untyped i64 values and the provider is not
# cryptographically admitted by this module.
@unsafe(reason: "checked convention transport cannot verify the provider artifact or all-i64 ABI", capabilities: [ffi, raw_ptr])
fn sffi_call_checked(func_name: text, args: [i64]) -> Result<i64, text>:
    val parts = func_name.split("_")
    if parts.len() < 2:
        return Err("E-SFFI-014: malformed convention symbol: {func_name}")
    val prefix = parts[1]
    if prefix == "":
        return Err("E-SFFI-014: empty convention provider prefix: {func_name}")
    val lib_path = sffi_lib_path(prefix)
    var loader = DynLoader.instance()
    loader.call_checked(lib_path, func_name, args)

export spl_dlopen, spl_dlopen_checked, spl_dlsym, spl_dlsym_checked, spl_dlsym_process_checked, spl_dlclose
export spl_wffi_call_i64, spl_wffi_call_i64_checked, spl_wffi_try_call_i64_out
export DynI64FnSlot, DynLib, DynLoader
