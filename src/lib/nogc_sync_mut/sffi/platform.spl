# platform runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

@unsafe(reason: "raw runtime ABI for rt_host_gpu_queue_complete", capabilities: [ffi])
extern fn rt_host_gpu_queue_complete(max_packets: i64) -> i64

@always_inline
fn host_gpu_queue_complete(max_packets: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_host_gpu_queue_complete(max_packets)

@unsafe(reason: "raw runtime ABI for rt_host_gpu_queue_completed_count", capabilities: [ffi])
