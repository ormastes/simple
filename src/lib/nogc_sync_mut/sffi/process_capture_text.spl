# Monomorphic command-text side of the native capture boundary. Returned
# runtime handles use the distinct i64 declarations in process_capture.spl.
@unsafe(reason: "borrow the retained command text's byte buffer through its single-word runtime ABI", capabilities: [ffi, raw_ptr])
extern fn rt_string_data(value: text) -> i64

fn process_capture_text_data_v1(value: text) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_string_data(value)
