# System commit headroom over registered probes only, so it answers in the
# seed interpreter and in native code alike (no kernel32 binding needed).
# Shard coordinators admit workers by it instead of a fixed estimate.
#
# Every host's raw answer is decoded by a pure function below that every
# platform compiles, so one host's spec covers every branch's decisions; the
# @when arms only gather the raw text or number. -1 always means unknown (the
# pool keeps its static admission cap), never "0 KiB free".

# Decimal digits only, at most 18 of them (no i64 overflow); -1 otherwise.
fn _process_memory_digits_v1(field: text) -> i64:
    val digits = field.trim()
    if digits == "" or digits.byte_len() > 18: return -1
    var i = 0
    while i < digits.byte_len():
        val b = digits.byte_at(i)
        if b < 48 or b > 57: return -1
        i = i + 1
    digits.to_i64() ?? -1

# Byte offset just past `key` in the first row of `table` that starts with it;
# -1 when no row does.
fn _proc_status_row_after_key_v1(table: text, key: text) -> i64:
    val n = table.byte_len()
    val k = key.byte_len()
    var row = 0
    while row <= n:
        var j = 0
        while j < k and row + j < n and table.byte_at(row + j) == key.byte_at(j):
            j = j + 1
        if j == k: return row + k
        var end = row
        while end < n and table.byte_at(end) != 10:
            end = end + 1
        row = end + 1
    -1

# Value of a "<key> <n> kB" row of a /proc table; -1 when absent or junk.
# Decodes the bytes in place and allocates nothing: the slot-pool coordinator
# calls this twice a second for the whole build, and splitting /proc/meminfo
# into rows on each call was most of the ~13 KB per probe that PR #11002
# measured as never reclaimed there.
pub fn proc_status_kib(table: text, key: text) -> i64:
    val n = table.byte_len()
    var i = _proc_status_row_after_key_v1(table, key)
    if i < 0: return -1
    # Blanks before the value: space, tab, CR.
    while i < n and (table.byte_at(i) == 32 or table.byte_at(i) == 9 or table.byte_at(i) == 13):
        i = i + 1
    var value: i64 = 0
    var count = 0
    var closed = false
    while i < n:
        val b = table.byte_at(i)
        # The value is the first space-separated field of the row.
        if b == 10 or b == 32: break
        if b == 9 or b == 13:
            closed = true
        elif closed or b < 48 or b > 57:
            return -1
        else:
            count = count + 1
            # At most 18 digits (no i64 overflow), as _process_memory_digits_v1.
            if count > 18: return -1
            value = value * 10 + (b - 48)
        i = i + 1
    if count == 0: return -1
    value

# Linux (and SimpleOS's synthetic procfs): MemAvailable + SwapFree KiB.
pub fn host_commit_avail_kib_from_meminfo(table: text) -> i64:
    val avail = proc_status_kib(table, "MemAvailable:")
    if avail < 0: return -1
    val swap = proc_status_kib(table, "SwapFree:")
    avail + (if swap > 0: swap else: 0)

# Windows: CommitLimit - CommitTotal in bytes from the runtime probe.
pub fn host_commit_avail_kib_from_bytes(bytes: i64) -> i64:
    if bytes > 0: bytes / 1024 else: -1

# FreeBSD: `sysctl hw.pagesize vm.stats.vm.v_free_count
# vm.stats.vm.v_inactive_count` ("name: value" rows, any order). Headroom is
# free + inactive pages (inactive is the reclaimable pool, same rule as the
# macOS vm_stat probe); laundry/active/wired are not headroom. Swap is not
# added: it has no "name: value" sysctl, so this answer is conservative.
pub fn freebsd_vm_available_kib_from_sysctl(output: text) -> i64:
    var page_size: i64 = -1
    var free_pages: i64 = -1
    var inactive_pages: i64 = -1
    for raw in output.split("\n"):
        val colon = raw.index_of(":")
        if colon <= 0: continue
        val name = raw.substring(0, colon).trim()
        val value = _process_memory_digits_v1(raw.substring(colon + 1))
        if name == "hw.pagesize": page_size = value
        elif name == "vm.stats.vm.v_free_count": free_pages = value
        elif name == "vm.stats.vm.v_inactive_count": inactive_pages = value
    if page_size <= 0 or free_pages < 0 or inactive_pages < 0: return -1
    val pages = free_pages + inactive_pages
    if pages <= 0 or pages > 9223372036854775807 / page_size: return -1
    (pages * page_size) / 1024

pub struct HostMemoryProbeV1:
    kib: i64
    valid: bool

# Installed physical RAM in KiB from a byte-valued sysctl/WMI output; 0 when unknown.
fn _physmem_total_kib_from_bytes_field_v1(field: text) -> i64:
    val bytes = _process_memory_digits_v1(field)
    if bytes <= 0: 0 else: bytes / 1024

pub fn physmem_total_from_bytes_field_v1(field: text) -> HostMemoryProbeV1:
    val kib = _physmem_total_kib_from_bytes_field_v1(field)
    HostMemoryProbeV1(kib: kib, valid: kib > 0)

# macOS: `vm_stat` page counts ("page size of <n> bytes", "Pages free: <n>.",
# "Pages inactive: <n>."). Free + inactive pages are reclaimable headroom;
# -1 when missing or malformed so callers keep their static admission cap.
fn _macos_vm_available_kib_from_vm_stat_v1(output: text) -> i64:
    var page_size: i64 = -1
    var free_pages: i64 = -1
    var inactive_pages: i64 = -1
    for raw in output.split("\n"):
        val line = raw.trim()
        if line == "": continue
        if line.contains("page size of"):
            val start = line.index_of("page size of ")
            val end = line.index_of(" bytes")
            if start >= 0 and end > start + 13:
                page_size = _process_memory_digits_v1(line.substring(start + 13, end))
        elif line.starts_with("Pages free:"):
            var field = line.substring(11).trim()
            if field.ends_with("."): field = field.substring(0, field.byte_len() - 1)
            free_pages = _process_memory_digits_v1(field)
        elif line.starts_with("Pages inactive:"):
            var field = line.substring(15).trim()
            if field.ends_with("."): field = field.substring(0, field.byte_len() - 1)
            inactive_pages = _process_memory_digits_v1(field)
    if page_size <= 0 or free_pages < 0 or inactive_pages < 0: return -1
    val pages = free_pages + inactive_pages
    if pages <= 0 or pages > 9223372036854775807 / page_size: return -1
    (pages * page_size) / 1024

pub fn macos_vm_available_from_vm_stat_v1(output: text) -> HostMemoryProbeV1:
    val kib = _macos_vm_available_kib_from_vm_stat_v1(output)
    HostMemoryProbeV1(kib: kib, valid: kib >= 0)

var _cached_process_physmem_kib_v1: i64 = 0

@when(os="windows"):
use std.nogc_sync_mut.io.windows_process_owner_abi.{rt_host_commit_headroom_bytes_v1}
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}

# CommitLimit - CommitTotal, KiB; -1 when unknown.
pub fn host_commit_avail_kib() -> i64:
    var bytes: i64 = 0
    unsafe(capabilities: [ffi]):
        bytes = rt_host_commit_headroom_bytes_v1()
    host_commit_avail_kib_from_bytes(bytes)

# @allow(primitive_api)  # low-level SFFI host memory probe matching host_commit_avail_kib
pub fn host_physmem_total_kib() -> i64:
    if _cached_process_physmem_kib_v1 > 0: return _cached_process_physmem_kib_v1
    val (out, _err, code) = process_run_timeout("powershell.exe",
        ["-NoProfile", "-NonInteractive", "-Command",
            "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory"], 20000)
    if code != 0: return 0
    val kib = _physmem_total_kib_from_bytes_field_v1(out)
    if kib > 0: _cached_process_physmem_kib_v1 = kib
    kib
@else:
@when(os="freebsd"):
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}

# No /proc/meminfo without linprocfs: read the VM page counters instead.
pub fn host_commit_avail_kib() -> i64:
    val (out, _err, code) = process_run_timeout("sysctl",
        ["hw.pagesize", "vm.stats.vm.v_free_count", "vm.stats.vm.v_inactive_count"], 2000)
    if code != 0: return -1
    freebsd_vm_available_kib_from_sysctl(out)

# @allow(primitive_api)  # low-level SFFI host memory probe matching host_commit_avail_kib
pub fn host_physmem_total_kib() -> i64:
    if _cached_process_physmem_kib_v1 > 0: return _cached_process_physmem_kib_v1
    val (out, _err, code) = process_run_timeout("sysctl", ["-n", "hw.physmem"], 2000)
    if code != 0: return 0
    val kib = _physmem_total_kib_from_bytes_field_v1(out)
    if kib > 0: _cached_process_physmem_kib_v1 = kib
    kib
@else:
@when(os="macos"):
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}

# Darwin has no /proc/meminfo; read vm_stat free + inactive reclaimable pages.
# @allow(primitive_api)  # low-level SFFI host memory probe matching Linux/BSD host_commit_avail_kib
pub fn host_commit_avail_kib() -> i64:
    val (out, _err, code) = process_run_timeout("vm_stat", [], 2000)
    if code != 0: return -1
    _macos_vm_available_kib_from_vm_stat_v1(out)

# @allow(primitive_api)  # low-level SFFI host memory probe matching host_commit_avail_kib
pub fn host_physmem_total_kib() -> i64:
    if _cached_process_physmem_kib_v1 > 0: return _cached_process_physmem_kib_v1
    val (out, _err, code) = process_run_timeout("sysctl", ["-n", "hw.memsize"], 2000)
    if code != 0: return 0
    val kib = _physmem_total_kib_from_bytes_field_v1(out)
    if kib > 0: _cached_process_physmem_kib_v1 = kib
    kib
@else:
use std.nogc_sync_mut.io_runtime.{file_read_nullable}

# MemAvailable + SwapFree KiB; -1 when unknown.
pub fn host_commit_avail_kib() -> i64:
    host_commit_avail_kib_from_meminfo(file_read_nullable("/proc/meminfo") ?? "")

# @allow(primitive_api)  # low-level SFFI host memory probe matching host_commit_avail_kib
pub fn host_physmem_total_kib() -> i64:
    if _cached_process_physmem_kib_v1 > 0: return _cached_process_physmem_kib_v1
    val kib = proc_status_kib(file_read_nullable("/proc/meminfo") ?? "", "MemTotal:")
    if kib > 0:
        _cached_process_physmem_kib_v1 = kib
        return kib
    0
@end
@end
@end
