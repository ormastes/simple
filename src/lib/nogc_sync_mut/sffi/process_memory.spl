# SFFI - measured process / host commit memory (runtime_memory_headroom.c).
# Shard coordinators admit workers by these instead of a fixed estimate.

@unsafe(reason: "host process memory counter ABI", capabilities: [ffi])
extern fn rt_process_private_kib_v1(pid: i64) -> i64

@unsafe(reason: "host commit headroom ABI", capabilities: [ffi])
extern fn rt_host_commit_avail_kib_v1() -> i64

# Committed private KiB of a live process (Windows PrivateUsage, Linux
# VmRSS+VmSwap); -1 when unknown.
pub fn process_private_kib(pid: i64) -> i64:
    var kib: i64 = -1
    unsafe(capabilities: [ffi]):
        kib = rt_process_private_kib_v1(pid)
    kib

# System commit headroom KiB (Windows ullAvailPageFile, Linux
# MemAvailable+SwapFree); -1 when unknown.
pub fn host_commit_avail_kib() -> i64:
    var kib: i64 = -1
    unsafe(capabilities: [ffi]):
        kib = rt_host_commit_avail_kib_v1()
    kib
