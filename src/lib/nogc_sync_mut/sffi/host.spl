fn tls13_aes128_gcm_decrypt_decode(raw: [u8]) -> Result<[u8], text>:
    """Decode the status-prefixed rt_tls13_aes128_gcm_decrypt result.

    The Rust backings (interpreter simd.rs, runtime value/aes.rs) return
    [0x01, ...pt] on success (pt may be empty), [0x00] on tag mismatch and []
    on invalid input. Anything else fails closed; it is never plaintext.
    """
    if raw.len() == 0:
        return Err("tls13 aes128-gcm provider rejected its inputs")
    if raw.len() == 1 and raw[0] == 0x00u8:
        return Err("authentication tag mismatch")
    if raw[0] != 0x01u8:
        return Err("tls13 aes128-gcm provider returned an invalid result")
    var plaintext: [u8] = []
    var i: u64 = 1
    while i < raw.len():
        plaintext.push(raw[i])
        i = i + 1
    Ok(plaintext)

fn tls13_aes128_gcm_decrypt(key: [u8], nonce: [u8], ciphertext: [u8], aad: [u8], tag: [u8]) -> Result<[u8], text>:
    """AES-128-GCM decrypt through the runtime fast path, decoded.

    Not a signature-identical alias (rt_alias_map class: adapted): the raw
    result is status-prefixed, so handing it back as [u8] let callers read a
    forged tag's [0x00] as plaintext. Key 16, nonce 12 and tag 16 bytes are
    checked before the provider is called (NIST SP 800-38D 7.2 step 1); the
    interpreter backing raises instead of returning [] on bad input. The
    baremetal C stub still returns raw plaintext, which this decoder rejects
    or mis-strips, so baremetal callers must not use this alias yet.
    """
    if key.len() != 16:
        return Err("AES-128 key must be 16 bytes")
    if nonce.len() != 12:
        return Err("GCM nonce must be 12 bytes")
    if tag.len() != 16:
        return Err("GCM tag must be 16 bytes")
    var raw: [u8] = []
    unsafe(capabilities: [ffi]):
        raw = rt_tls13_aes128_gcm_decrypt(key, nonce, ciphertext, aad, tag)
    tls13_aes128_gcm_decrypt_decode(raw)

