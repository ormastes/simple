# Object-graph refcount (Build Session Memory Model v1 section 4, P4). An
# object is owned by exactly one of {transient scope, session, rc root,
# process}; a sub-object shared by two rc roots must itself be an rc root
# retained by each parent.
export use std.nogc_sync_mut.sffi.rc_graph.{rt_rc_share, rt_rc_retain, rt_rc_release, rt_rc_count, rt_heap_graph_bytes}

