@unsafe(reason: "raw runtime ABI for rt_get_args", capabilities: [ffi])
extern fn rt_get_args() -> [text]?

@always_inline
fn get_args() -> [text]:
    val args = unsafe(capabilities: [ffi]):
        rt_get_args()
    if args == nil:
        panic("E-SFFI-HOST-001: rt_get_args returned no argument vector")
    args.unwrap()

