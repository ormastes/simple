# Process arguments are independent of optional CLI command dispatch providers.
# Preserve the existing sys_get_args ownership and indexing contract.
@unsafe(reason: "raw process argument-array ownership ABI", capabilities: [ffi])
extern fn sys_get_args() -> [text]

fn cli_arg_count() -> i64:
    unsafe(capabilities: [ffi]):
        sys_get_args().len()

fn cli_arg_at(index: i64) -> text:
    val args = unsafe(capabilities: [ffi]):
        sys_get_args()
    if index >= 0 and index < args.len():
        return args[index]
    ""

fn cli_get_args() -> [text]:
    unsafe(capabilities: [ffi]):
        sys_get_args()
