# Leaf SHA-2 digest boundary: importing hashing must not pull in host services.
@unsafe(reason: "raw runtime ABI for rt_sha512_digest", capabilities: [ffi])
extern fn rt_sha512_digest(data: [u8]) -> [u8]

fn sha512_digest(data: [u8]) -> [u8]:
    unsafe(capabilities: [ffi]):
        rt_sha512_digest(data)

@unsafe(reason: "raw runtime ABI for rt_sha384_digest", capabilities: [ffi])
extern fn rt_sha384_digest(data: [u8]) -> [u8]

fn sha384_digest(data: [u8]) -> [u8]:
    unsafe(capabilities: [ffi]):
        rt_sha384_digest(data)

# PBKDF2-HMAC-SHA512 (RFC 8018). Backed in every lane: seed interpreter
# (interpreter_extern/pbkdf2.rs), Rust runtime (value/sffi/hash/sha256.rs) and
# the C runtime (runtime_native.c, commit 5ebdda2d8b4). Returns [] on invalid
# input (the runtime yields nil there).
@unsafe(reason: "raw runtime ABI for rt_pbkdf2_hmac_sha512", capabilities: [ffi])
extern fn rt_pbkdf2_hmac_sha512(password: [u8], salt: [u8], iterations: i64, dk_len: i64) -> [u8]?

pub fn pbkdf2_hmac_sha512_digest(password: [u8], salt: [u8], iterations: i64, dk_len: i64) -> [u8]:
    unsafe(capabilities: [ffi]):
        rt_pbkdf2_hmac_sha512(password, salt, iterations, dk_len) ?? []
