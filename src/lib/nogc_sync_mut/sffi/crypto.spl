# crypto runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

use std.common.crypto.xxh3.{xxh3_128_hex}
use std.common.text_bytes.{text_to_utf8_bytes}

@unsafe(reason: "raw runtime ABI for rt_base64url_encode", capabilities: [ffi])
extern fn rt_base64url_encode(input: text, len: i64) -> text

@always_inline
fn base64url_encode(input: text, len: i64) -> text:
    unsafe(capabilities: [ffi]):
        rt_base64url_encode(input, len)

@unsafe(reason: "raw runtime ABI for rt_crc32_text", capabilities: [ffi])
extern fn rt_crc32_text(content: text) -> i64

@always_inline
fn crc32_text(content: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_crc32_text(content)

@unsafe(reason: "raw runtime ABI for rt_ed25519_verify", capabilities: [ffi])
extern fn rt_ed25519_verify(message: [u8], pubkey: [u8], signature: [u8]) -> i64

@always_inline
fn ed25519_verify_rt(message: [u8], pubkey: [u8], signature: [u8]) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ed25519_verify(message, pubkey, signature)


@unsafe(reason: "raw runtime ABI for rt_xxh3_128_text; empty text is the unsupported/provider-failure sentinel", capabilities: [ffi])
extern fn rt_xxh3_128_text(data: text) -> text

# Set when the runtime digest was unavailable and the pure-Simple fallback ran.
var _xxh3_128_text_fallback_used: bool = false

fn xxh3_128_text_fallback_used() -> bool:
    _xxh3_128_text_fallback_used

# XXH3-128 of the text's UTF-8 bytes as 32 lowercase hex (canonical: high64
# then low64), through the C/Rust runtime accelerator. Anything but a full
# 32-hex answer falls back to the pure-Simple std.common.crypto.xxh3, which is
# the oracle. NOT collision-resistant: local cache indexing only.
fn xxh3_128_text(data: text) -> text:
    val hex = unsafe(capabilities: [ffi]):
        rt_xxh3_128_text(data)
    if hex.len() == 32:
        return hex
    _xxh3_128_text_fallback_used = true
    xxh3_128_hex(text_to_utf8_bytes(data))
