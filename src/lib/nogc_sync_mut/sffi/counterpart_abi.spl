@allow(primitive_api)
# Counterpart Conformance — safe Simple wrapper over the native ABI shim.
#
# The counterpart ABI is a C contract (scf_api_v1). Everything unsafe about it
# — dlopen, dlsym, the scf_writer_v1 growable buffer, instance pointers, the
# function table — lives in src/runtime/counterpart_abi_runtime.c. This module
# is the only Simple code that talks to that shim, and no raw pointer escapes
# it: a library is an opaque i64 handle held inside `CounterpartLibrary`, and
# every payload comes back as `text`.
#
# Primitive types on this surface are the wire types of the C ABI itself
# (an opaque i64 handle, an i64 status code, an i64 ABI version), so
# the module-level allow above is applied rather than inventing newtypes that
# would only be unwrapped again at the extern boundary.
#
# Header:  tools/counterpart/sdk/c/simple_counterpart_abi.h
# Design:  doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §3
# Model:   src/lib/common/spec/evidence/counterpart/model.spl (frozen Wave-0 contracts)

use std.common.spec.evidence.counterpart.model.{ProviderStatus}

# ============================================================================
# Raw shim declarations — the only externs in the counterpart lane
# ============================================================================

extern fn rt_counterpart_open(path: text, config: text) -> i64
extern fn rt_counterpart_probe_abi(path: text, requested_abi: i64) -> i64
extern fn rt_counterpart_manifest_text(handle: i64) -> text
extern fn rt_counterpart_invoke(handle: i64, component: text, request: text) -> i64
extern fn rt_counterpart_response_text(handle: i64) -> text
extern fn rt_counterpart_trace_text(handle: i64) -> text
extern fn rt_counterpart_last_error_text() -> text
extern fn rt_counterpart_reset(handle: i64) -> i64
extern fn rt_counterpart_close(handle: i64) -> i64

# ============================================================================
# Status codes — mirror of the C shim, kept as data on the Simple side
# ============================================================================
#
# Zero and positive values come from the adapter (scf_status_v1). Negative
# values are the shim's own load/handle failures. The split matters: a library
# that never loaded must never be reported with an adapter-level code.

pub val COUNTERPART_OK: i64 = 0
pub val COUNTERPART_INVALID_ARG: i64 = 1
pub val COUNTERPART_UNKNOWN_COMPONENT: i64 = 2
pub val COUNTERPART_SCHEMA_MISMATCH: i64 = 3
pub val COUNTERPART_INTERNAL: i64 = 4

pub val COUNTERPART_ERR_BAD_ARG: i64 = -1
pub val COUNTERPART_ERR_DLOPEN: i64 = -2
pub val COUNTERPART_ERR_NO_SYMBOL: i64 = -3
pub val COUNTERPART_ERR_NULL_API: i64 = -4
pub val COUNTERPART_ERR_ABI_VERSION: i64 = -5
pub val COUNTERPART_ERR_STRUCT_SIZE: i64 = -6
pub val COUNTERPART_ERR_INCOMPLETE_API: i64 = -7
pub val COUNTERPART_ERR_OPEN_FAILED: i64 = -8
pub val COUNTERPART_ERR_BAD_HANDLE: i64 = -9
pub val COUNTERPART_ERR_OOM: i64 = -10
pub val COUNTERPART_ERR_WRITER: i64 = -11

# Human-readable name for a shim/adapter status code.
pub fn counterpart_status_text(code: i64) -> text:
    if code == COUNTERPART_OK:
        return "ok"
    if code == COUNTERPART_INVALID_ARG:
        return "invalid_arg"
    if code == COUNTERPART_UNKNOWN_COMPONENT:
        return "unknown_component"
    if code == COUNTERPART_SCHEMA_MISMATCH:
        return "schema_mismatch"
    if code == COUNTERPART_INTERNAL:
        return "internal"
    if code == COUNTERPART_ERR_BAD_ARG:
        return "bad_argument"
    if code == COUNTERPART_ERR_DLOPEN:
        return "library_not_loadable"
    if code == COUNTERPART_ERR_NO_SYMBOL:
        return "no_scf_get_api_symbol"
    if code == COUNTERPART_ERR_NULL_API:
        return "adapter_refused_abi"
    if code == COUNTERPART_ERR_ABI_VERSION:
        return "abi_version_mismatch"
    if code == COUNTERPART_ERR_STRUCT_SIZE:
        return "struct_size_mismatch"
    if code == COUNTERPART_ERR_INCOMPLETE_API:
        return "incomplete_function_table"
    if code == COUNTERPART_ERR_OPEN_FAILED:
        return "adapter_open_failed"
    if code == COUNTERPART_ERR_BAD_HANDLE:
        return "bad_handle"
    if code == COUNTERPART_ERR_OOM:
        return "out_of_memory"
    if code == COUNTERPART_ERR_WRITER:
        return "output_buffer_failure"
    "unrecognized_status_" + code.to_text()

# Map a shim status onto the frozen ProviderStatus.
#
# A load or negotiation failure is `unavailable` or `rejected_manifest`, never
# `executed`. A component that ran and returned a structured error envelope IS
# `executed` — the failure is in the evidence, not in the provider — which is
# what keeps a real defect from being laundered into "provider not present".
pub fn counterpart_provider_status(code: i64) -> ProviderStatus:
    if code == COUNTERPART_OK:
        return ProviderStatus.executed
    if code == COUNTERPART_ERR_ABI_VERSION:
        return ProviderStatus.rejected_manifest
    if code == COUNTERPART_ERR_STRUCT_SIZE:
        return ProviderStatus.rejected_manifest
    if code == COUNTERPART_ERR_NULL_API:
        return ProviderStatus.rejected_manifest
    if code == COUNTERPART_ERR_INCOMPLETE_API:
        return ProviderStatus.rejected_manifest
    if code == COUNTERPART_ERR_NO_SYMBOL:
        return ProviderStatus.rejected_manifest
    if code == COUNTERPART_ERR_DLOPEN:
        return ProviderStatus.unavailable
    if code == COUNTERPART_ERR_OPEN_FAILED:
        return ProviderStatus.unavailable
    if code == COUNTERPART_ERR_BAD_HANDLE:
        return ProviderStatus.unavailable
    # Everything else is an adapter-reported call failure on a provider that
    # did load. It executed; the call did not succeed.
    ProviderStatus.executed

# ============================================================================
# Invocation outcome
# ============================================================================

# The response and trace envelopes of one successful invoke. Both are SDN text
# produced through the caller-owned writer inside the shim.
pub struct CounterpartResponse:
    component_id: text
    response: text
    trace: text

# A structured failure. `status` is the raw code, `provider_status` is its
# projection onto the frozen model so callers never have to re-derive it.
pub struct CounterpartFailure:
    status: i64
    status_name: text
    provider_status: ProviderStatus
    detail: text

pub fn counterpart_failure(code: i64, detail: text) -> CounterpartFailure:
    CounterpartFailure(
        status: code,
        status_name: counterpart_status_text(code),
        provider_status: counterpart_provider_status(code),
        detail: detail
    )

# ============================================================================
# CounterpartLibrary
# ============================================================================

# A loaded provider adapter. `handle` is an opaque slot index owned by the
# native shim — it is not a pointer and it is not valid outside this module.
pub class CounterpartLibrary:
    path: text
    handle: i64

impl CounterpartLibrary:
    # Load the adapter at `path` and open one instance with the given SDN
    # configuration. Fails closed: an adapter that refuses ABI v1, exports no
    # bootstrap symbol, or presents a truncated function table is rejected by
    # the shim before any instance exists.
    static fn open(path: text, config: text) -> Result<CounterpartLibrary, CounterpartFailure>:
        if path == "":
            return Err(counterpart_failure(COUNTERPART_ERR_BAD_ARG, "empty adapter path"))
        val handle = rt_counterpart_open(path, config)
        if handle <= 0:
            return Err(counterpart_failure(handle, rt_counterpart_last_error_text() ?? ""))
        Ok(CounterpartLibrary(path: path, handle: handle))

    # Ask the adapter at `path` whether it serves `requested_abi`, without
    # opening an instance. Returns Ok(true) when served, Ok(false) when the
    # adapter refuses that version, Err when the library cannot be loaded.
    static fn serves_abi(path: text, requested_abi: i64) -> Result<bool, CounterpartFailure>:
        val probed = rt_counterpart_probe_abi(path, requested_abi)
        if probed < 0:
            return Err(counterpart_failure(probed, "probe of " + path + " failed"))
        Ok(probed == 1)

    # True while this wrapper owns a live instance.
    fn is_open() -> bool:
        self.handle > 0

    # The provider manifest as SDN text. Empty text means the adapter failed to
    # produce one, which is a rejected manifest, never an empty pass.
    fn manifest() -> Result<text, CounterpartFailure>:
        if self.handle <= 0:
            return Err(counterpart_failure(COUNTERPART_ERR_BAD_HANDLE, "library is closed"))
        val text_value = rt_counterpart_manifest_text(self.handle) ?? ""
        if text_value == "":
            return Err(counterpart_failure(COUNTERPART_ERR_WRITER, "adapter produced an empty manifest"))
        Ok(text_value)

    # Run one component. On success both envelopes are returned; a component
    # that reports a domain error does so inside `response`, with status ok.
    fn invoke(component_id: text, request: text) -> Result<CounterpartResponse, CounterpartFailure>:
        if self.handle <= 0:
            return Err(counterpart_failure(COUNTERPART_ERR_BAD_HANDLE, "library is closed"))
        if component_id == "":
            return Err(counterpart_failure(COUNTERPART_ERR_BAD_ARG, "empty component_id"))
        val status = rt_counterpart_invoke(self.handle, component_id, request)
        if status != COUNTERPART_OK:
            return Err(counterpart_failure(status, "invoke " + component_id + " failed"))
        Ok(CounterpartResponse(
            component_id: component_id,
            response: rt_counterpart_response_text(self.handle) ?? "",
            trace: rt_counterpart_trace_text(self.handle) ?? ""
        ))

    # Return the instance to its post-open state between corpus cases.
    fn reset() -> Result<bool, CounterpartFailure>:
        if self.handle <= 0:
            return Err(counterpart_failure(COUNTERPART_ERR_BAD_HANDLE, "library is closed"))
        val status = rt_counterpart_reset(self.handle)
        if status != COUNTERPART_OK:
            return Err(counterpart_failure(status, "reset failed"))
        Ok(true)

    # Destroy the instance and unload the library. Idempotent.
    me close() -> Result<bool, CounterpartFailure>:
        if self.handle <= 0:
            self.handle = 0
            return Ok(false)
        val status = rt_counterpart_close(self.handle)
        self.handle = 0
        if status != COUNTERPART_OK:
            return Err(counterpart_failure(status, "close failed"))
        Ok(true)

# ============================================================================
# Manifest field access
# ============================================================================

# Read a top-level `key: value` field out of an SDN manifest. Returns empty
# text when the key is absent; callers must treat that as a rejection rather
# than as a default.
pub fn counterpart_manifest_field(manifest: text, key: text) -> text:
    val prefix = key + ": "
    for line in manifest.split("\n"):
        if line.starts_with(prefix):
            return line.slice(prefix.len(), line.len()).trim()
    ""

# Component ids declared by an SDN manifest, in declaration order.
pub fn counterpart_manifest_component_ids(manifest: text) -> [text]:
    var ids: [text] = []
    for line in manifest.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with("- component_id: "):
            ids.push(trimmed.slice(16, trimmed.len()).trim())
    ids

export CounterpartLibrary, CounterpartResponse, CounterpartFailure
export counterpart_failure, counterpart_status_text, counterpart_provider_status
export counterpart_manifest_field, counterpart_manifest_component_ids
