# Narrow hosted text ABI; stdin returns tagged text, including empty EOF.
@unsafe(reason: "raw runtime ABI for rt_read_stdin_line", capabilities: [ffi])
extern fn rt_read_stdin_line() -> text

@always_inline
fn read_stdin_line() -> text:
    unsafe(capabilities: [ffi]):
        rt_read_stdin_line()

@unsafe(reason: "raw runtime ABI for rt_raw_i64_to_string", capabilities: [ffi])
extern fn rt_raw_i64_to_string(n: i64) -> text

@always_inline
fn raw_i64_to_string(n: i64) -> text:
    unsafe(capabilities: [ffi]):
        rt_raw_i64_to_string(n)

export read_stdin_line, raw_i64_to_string, rt_read_stdin_line, rt_raw_i64_to_string
