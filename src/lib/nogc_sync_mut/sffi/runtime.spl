# ============================================================================
# Value Operations
# ============================================================================

# --- Comparison Operations ---

@unsafe(reason: "raw runtime-value comparison ABI", capabilities: [ffi])
extern fn rt_value_eq(left: RuntimeValuePtr, right: RuntimeValuePtr) -> bool

@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn value_eq(left: RuntimeValuePtr, right: RuntimeValuePtr) -> bool:
    rt_value_eq(left, right)

# ============================================================================
# I/O Operations
# ============================================================================

@unsafe(reason: "raw runtime-value output ABI", capabilities: [ffi])
extern fn rt_print_value(value: RuntimeValuePtr)

@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn value_print(value: RuntimeValuePtr):
    rt_print_value(value)

@unsafe(reason: "raw runtime-value line-output ABI", capabilities: [ffi])
