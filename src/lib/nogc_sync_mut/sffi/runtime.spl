# SFFI - Runtime Operations
# Centralized RuntimeValue and GC SFFI wrappers

# ============================================================================
# Value Creation
# ============================================================================

# Same tagged-value ABI in the selected C, Rust or Simple runtime owner.
# This alias never interprets or reconstructs a handle from another owner.
@unsafe(reason: "selected runtime tagged arithmetic ABI; operands must belong to that runtime owner", capabilities: [ffi])
extern fn rt_tagged_add(left: RuntimeValuePtr, right: RuntimeValuePtr) -> RuntimeValuePtr

@unsafe(reason: "owned tagged runtime-value operands; preserves selected runtime representation", capabilities: [ffi])
@always_inline
fn tagged_add(left: RuntimeValuePtr, right: RuntimeValuePtr) -> RuntimeValuePtr:
    rt_tagged_add(left, right)

# Observation of the selected runtime's current scope:0 inactive,1 running,
# 2 paused. This does not begin/claim a scope or confer borrowed ownership.
@unsafe(reason: "side-effect-free query of actual selected runtime scope context", capabilities: [ffi])
extern fn rt_transient_array_scope_state_v1() -> i64

fn transient_array_scope_state_v1() -> i64:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_state_v1()

@unsafe(reason: "raw owned runtime-value allocation ABI; zero means failure", capabilities: [ffi])
extern fn rt_value_nil() -> RuntimeValuePtr

@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn value_nil() -> RuntimeValuePtr:
    rt_value_nil()

@unsafe(reason: "raw owned runtime-value allocation ABI; zero means failure", capabilities: [ffi])
extern fn rt_value_bool(value: bool) -> RuntimeValuePtr

@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn value_bool(value: bool) -> RuntimeValuePtr:
    rt_value_bool(value)

@unsafe(reason: "raw owned runtime-value allocation ABI; zero means failure", capabilities: [ffi])
extern fn rt_value_int(value: i64) -> RuntimeValuePtr

@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn value_int(value: i64) -> RuntimeValuePtr:
    rt_value_int(value)

@unsafe(reason: "raw owned runtime-value allocation ABI; zero means failure", capabilities: [ffi])
extern fn rt_value_float(value: f64) -> RuntimeValuePtr

@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn value_float(value: f64) -> RuntimeValuePtr:
    rt_value_float(value)

