# diag runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

@unsafe(reason: "raw runtime ABI for rt_coverage_enabled", capabilities: [ffi])
extern fn rt_coverage_enabled() -> bool

@always_inline
fn coverage_enabled_raw() -> bool:
    unsafe(capabilities: [ffi]):
        rt_coverage_enabled()

@unsafe(reason: "raw runtime ABI for rt_debug_exit_success", capabilities: [ffi])
extern fn rt_debug_exit_success()

@always_inline
fn debug_exit_success():
    unsafe(capabilities: [ffi]):
        rt_debug_exit_success()

@unsafe(reason: "raw runtime ABI for rt_eprintln", capabilities: [ffi])
extern fn rt_eprintln(s: text)

@always_inline
fn eprintln(s: text):
    unsafe(capabilities: [ffi]):
        rt_eprintln(s)

