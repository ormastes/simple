# env runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

@unsafe(reason: "raw runtime ABI for rt_env_cwd", capabilities: [ffi])
extern fn rt_env_cwd() -> text

@always_inline
fn env_cwd_raw() -> text:
    unsafe(capabilities: [ffi]):
        rt_env_cwd()

@unsafe(reason: "raw runtime ABI for rt_env_get", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text

@always_inline
fn env_get_unchecked(key: text) -> text:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)

@unsafe(reason: "raw runtime ABI for rt_env_get_i64", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default_value: i64) -> i64

@always_inline
fn env_get_i64_raw(key: text, default_value: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_env_get_i64(key, default_value)

@unsafe(reason: "raw runtime ABI for rt_env_home", capabilities: [ffi])
extern fn rt_env_home() -> text

@always_inline
fn env_home_raw() -> text:
    unsafe(capabilities: [ffi]):
        rt_env_home()

@unsafe(reason: "raw runtime ABI for rt_env_temp", capabilities: [ffi])
extern fn rt_env_temp() -> text

@always_inline
fn env_temp() -> text:
    unsafe(capabilities: [ffi]):
        rt_env_temp()


