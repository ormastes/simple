# SFFI - CLI Commands
# Centralized CLI command delegation SFFI wrappers
# These functions delegate to Rust-backed CLI command implementations

# ============================================================================
# Core CLI Functions
# ============================================================================

# rt_cli_arg_count/rt_cli_arg_at are unregistered on the currently deployed
# seed binary (registered later than the last redeploy, #159); route through
# sys_get_args(), which the deployed binary already registers, instead.
@unsafe(reason: "raw process argument-array ownership ABI", capabilities: [ffi])
extern fn sys_get_args() -> [text]

fn cli_arg_count() -> i64:
    unsafe(capabilities: [ffi]):
        sys_get_args().len()

fn cli_arg_at(index: i64) -> text:
    val args = unsafe(capabilities: [ffi]):
        sys_get_args()
    if index >= 0 and index < args.len():
        return args[index]
    ""

fn cli_get_args() -> [text]:
    unsafe(capabilities: [ffi]):
        sys_get_args()

@unsafe(reason: "raw process termination ABI", capabilities: [ffi])
extern fn rt_cli_exit(code: i64)

fn cli_exit(code: i64):
    unsafe(capabilities: [ffi]):
        rt_cli_exit(code)

@unsafe(reason: "raw CLI command text/array dispatch ABI", capabilities: [ffi])
extern fn rt_cli_dispatch_rust(cmd: text, args: [text], gc_log: bool, gc_off: bool) -> i64

fn cli_dispatch_rust(cmd: text, args: [text], gc_log: bool, gc_off: bool) -> i64:
    unsafe(capabilities: [ffi]):
        rt_cli_dispatch_rust(cmd, args, gc_log, gc_off)

