# SFFI - Debug Operations
# Centralized debugging, ptrace, and DWARF SFFI wrappers for DAP integration

# ============================================================================
# Debug Operations
# ============================================================================

# --- Basic State ---

@unsafe(reason: "raw debugger global-state ABI", capabilities: [ffi])
extern fn rt_debug_is_active() -> i64
@unsafe(reason: "raw debugger global-state mutation ABI", capabilities: [ffi])
extern fn rt_debug_set_active(active: i64)
@unsafe(reason: "raw debugger step-mode mutation ABI", capabilities: [ffi])
extern fn rt_debug_set_step_mode(mode: i64)
@unsafe(reason: "raw debugger step-mode ABI", capabilities: [ffi])
extern fn rt_debug_get_step_mode() -> i64
@unsafe(reason: "raw debugger step-depth mutation ABI", capabilities: [ffi])
extern fn rt_debug_set_step_start_depth(depth: i64)
@unsafe(reason: "raw debugger step-depth ABI", capabilities: [ffi])
extern fn rt_debug_get_step_start_depth() -> i64

@inline
fn _debug_bool_contract(raw: i64) -> bool:
    match raw:
        case 0: false
        case 1: true
        case _: panic("invalid debugger boolean discriminant")

fn debug_is_active() -> bool:
    unsafe(capabilities: [ffi]):
        _debug_bool_contract(rt_debug_is_active())

fn debug_set_active(active: bool):
    unsafe(capabilities: [ffi]):
        rt_debug_set_active(if active: 1 else: 0)

fn debug_set_step_mode(mode: i64):
    unsafe(capabilities: [ffi]):
        rt_debug_set_step_mode(mode)

fn debug_get_step_mode() -> i64:
    unsafe(capabilities: [ffi]):
        rt_debug_get_step_mode()

fn debug_set_step_start_depth(depth: i64):
    unsafe(capabilities: [ffi]):
        rt_debug_set_step_start_depth(depth)

fn debug_get_step_start_depth() -> i64:
    unsafe(capabilities: [ffi]):
        rt_debug_get_step_start_depth()

# --- Pause/Continue ---

@unsafe(reason: "raw debugger pause-state mutation ABI", capabilities: [ffi])
extern fn rt_debug_pause()
@unsafe(reason: "raw debugger pause-state mutation ABI", capabilities: [ffi])
extern fn rt_debug_continue()
@unsafe(reason: "raw debugger pause-state ABI", capabilities: [ffi])
extern fn rt_debug_is_paused() -> i64
@unsafe(reason: "raw blocking debugger synchronization ABI", capabilities: [ffi])
extern fn rt_debug_wait_for_continue()

fn debug_pause():
    unsafe(capabilities: [ffi]):
        rt_debug_pause()

fn debug_continue():
    unsafe(capabilities: [ffi]):
        rt_debug_continue()

fn debug_is_paused() -> bool:
    unsafe(capabilities: [ffi]):
        _debug_bool_contract(rt_debug_is_paused())

fn debug_wait_for_continue():
    unsafe(capabilities: [ffi]):
        rt_debug_wait_for_continue()

# --- Location Tracking ---

@unsafe(reason: "raw debugger borrowed file-pointer and location ABI", capabilities: [ffi])
extern fn rt_debug_set_current_location(file_ptr: i64, file_len: i64, line: i64, column: i64)
@unsafe(reason: "raw debugger runtime-owned file text ABI", capabilities: [ffi])
extern fn rt_debug_current_file() -> text
@unsafe(reason: "raw debugger source-line ABI", capabilities: [ffi])
extern fn rt_debug_current_line() -> i64
@unsafe(reason: "raw debugger source-column ABI", capabilities: [ffi])
extern fn rt_debug_current_column() -> i64

fn debug_set_current_location(file: text, line: i64, column: i64):
    unsafe(capabilities: [ffi]):
        rt_debug_set_current_location(file.ptr(), file.len(), line, column)

fn debug_current_file() -> text:
    unsafe(capabilities: [ffi]):
        rt_debug_current_file()

fn debug_current_line() -> i64:
    unsafe(capabilities: [ffi]):
        rt_debug_current_line()

fn debug_current_column() -> i64:
    unsafe(capabilities: [ffi]):
        rt_debug_current_column()

# --- Breakpoints ---

@unsafe(reason: "raw debugger borrowed file-pointer breakpoint mutation ABI", capabilities: [ffi])
extern fn rt_debug_add_breakpoint(file_ptr: i64, file_len: i64, line: i64) -> i64
@unsafe(reason: "raw debugger borrowed file-pointer breakpoint mutation ABI", capabilities: [ffi])
extern fn rt_debug_remove_breakpoint(file_ptr: i64, file_len: i64, line: i64) -> i64
@unsafe(reason: "raw debugger breakpoint-state mutation ABI", capabilities: [ffi])
extern fn rt_debug_remove_all_breakpoints()
@unsafe(reason: "raw debugger borrowed file-pointer breakpoint query ABI", capabilities: [ffi])
extern fn rt_debug_has_breakpoint(file_ptr: i64, file_len: i64, line: i64) -> i64

fn debug_add_breakpoint(file: text, line: i64, id: i64):
    # The canonical provider allocates the breakpoint ID. Keep this legacy
    # wrapper shape, but do not pass an ABI-invented fourth argument.
    unsafe(capabilities: [ffi]):
        rt_debug_add_breakpoint(file.ptr(), file.len(), line)

fn debug_remove_breakpoint(file: text, line: i64):
    unsafe(capabilities: [ffi]):
        rt_debug_remove_breakpoint(file.ptr(), file.len(), line)

fn debug_clear_breakpoints():
    unsafe(capabilities: [ffi]):
        rt_debug_remove_all_breakpoints()

fn debug_has_breakpoint(file: text, line: i64) -> bool:
    unsafe(capabilities: [ffi]):
        _debug_bool_contract(rt_debug_has_breakpoint(file.ptr(), file.len(), line))

# --- Break Logic ---

@unsafe(reason: "raw debugger break-decision ABI", capabilities: [ffi])
extern fn rt_debug_should_break() -> i64

fn debug_should_break() -> bool:
    unsafe(capabilities: [ffi]):
        _debug_bool_contract(rt_debug_should_break())

# --- Stack Frames ---

@unsafe(reason: "raw debugger borrowed function/file pointers and stack mutation ABI", capabilities: [ffi])
extern fn rt_debug_push_frame(func_name_ptr: i64, func_name_len: i64, file_ptr: i64, file_len: i64, line: i64, column: i64)
@unsafe(reason: "raw debugger stack mutation ABI", capabilities: [ffi])
extern fn rt_debug_pop_frame()
@unsafe(reason: "raw debugger stack-depth ABI", capabilities: [ffi])
extern fn rt_debug_stack_depth() -> i64
@unsafe(reason: "raw debugger runtime-owned stack-trace array ABI", capabilities: [ffi])
extern fn rt_debug_stack_trace() -> [text]

fn debug_push_frame(func_name: text, file: text, line: i64, column: i64):
    unsafe(capabilities: [ffi]):
        rt_debug_push_frame(func_name.ptr(), func_name.len(), file.ptr(), file.len(), line, column)

fn debug_pop_frame():
    unsafe(capabilities: [ffi]):
        rt_debug_pop_frame()

fn debug_stack_depth() -> i64:
    unsafe(capabilities: [ffi]):
        rt_debug_stack_depth()

fn debug_stack_trace() -> [text]:
    unsafe(capabilities: [ffi]):
        rt_debug_stack_trace()

# --- Variables ---

@unsafe(reason: "raw debugger borrowed local-name/value pointers ABI", capabilities: [ffi])
extern fn rt_debug_set_local(name_ptr: i64, name_len: i64, value_ptr: i64, value_len: i64)
@unsafe(reason: "raw debugger borrowed global-name/value pointers ABI", capabilities: [ffi])
extern fn rt_debug_set_global(name_ptr: i64, name_len: i64, value_ptr: i64, value_len: i64)
@unsafe(reason: "raw debugger runtime-owned locals array ABI", capabilities: [ffi])
extern fn rt_debug_locals() -> [text]
@unsafe(reason: "raw debugger runtime-owned globals text ABI", capabilities: [ffi])
extern fn rt_debug_globals() -> text
@unsafe(reason: "raw debugger local-state mutation ABI", capabilities: [ffi])
extern fn rt_debug_clear_locals()
@unsafe(reason: "raw debugger global-state mutation ABI", capabilities: [ffi])
extern fn rt_debug_clear_globals()

fn debug_set_local(name: text, value: text):
    unsafe(capabilities: [ffi]):
        rt_debug_set_local(name.ptr(), name.len(), value.ptr(), value.len())

fn debug_set_global(name: text, value: text):
    unsafe(capabilities: [ffi]):
        rt_debug_set_global(name.ptr(), name.len(), value.ptr(), value.len())

fn debug_locals() -> [text]:
    unsafe(capabilities: [ffi]):
        rt_debug_locals()

fn debug_globals() -> text:
    unsafe(capabilities: [ffi]):
        rt_debug_globals()

fn debug_clear_locals():
    unsafe(capabilities: [ffi]):
        rt_debug_clear_locals()

fn debug_clear_globals():
    unsafe(capabilities: [ffi]):
        rt_debug_clear_globals()

# ============================================================================
# Ptrace Operations (Linux Process Tracing)
# ============================================================================

@unsafe(reason: "raw OS ptrace process-control status ABI", capabilities: [ffi])
extern fn rt_ptrace_attach(pid: i64) -> i64

# A pid that is not a positive process id can never name an attachable
# process. Reject it here with the documented negative status instead of
# entering the raw boundary: `rt_ptrace_attach` has no provider in every
# execution lane (the interpreter lane aborts with `unknown extern function:
# rt_ptrace_attach`), which makes the negative-status contract unobservable
# there. This is the canonical alias, so the guard belongs here rather than in
# each caller.
fn ptrace_attach(pid: i64) -> i64:
    if pid <= 0:
        return -1
    unsafe(capabilities: [ffi]):
        rt_ptrace_attach(pid)

@unsafe(reason: "raw OS ptrace process-control status ABI", capabilities: [ffi])
extern fn rt_ptrace_detach(pid: i64) -> i64

fn ptrace_detach(pid: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ptrace_detach(pid)

@unsafe(reason: "raw OS ptrace process-control status ABI", capabilities: [ffi])
extern fn rt_ptrace_continue(pid: i64) -> i64

fn ptrace_continue(pid: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ptrace_continue(pid)

@unsafe(reason: "raw OS ptrace process-control status ABI", capabilities: [ffi])
extern fn rt_ptrace_single_step(pid: i64) -> i64

fn ptrace_single_step(pid: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ptrace_single_step(pid)

@unsafe(reason: "raw blocking OS ptrace wait-status ABI", capabilities: [ffi])
extern fn rt_ptrace_wait_stop(pid: i64) -> i64

fn ptrace_wait_stop(pid: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ptrace_wait_stop(pid)

@unsafe(reason: "raw OS ptrace register-map ownership ABI", capabilities: [ffi])
extern fn rt_ptrace_get_registers(pid: i64) -> Dict<String, i64>

fn ptrace_get_registers(pid: i64) -> Dict<String, i64>:
    unsafe(capabilities: [ffi]):
        rt_ptrace_get_registers(pid)

@unsafe(reason: "raw OS ptrace process-memory read and array ownership ABI", capabilities: [ffi])
extern fn rt_ptrace_read_memory(pid: i64, addr: i64, size: i64) -> [i64]

# A non-positive pid (including the negative status a failed `ptrace_attach`
# hands back), a negative address, or a non-positive extent can never describe
# a readable region: return the documented empty array and never fabricate
# bytes.
fn ptrace_read_memory(pid: i64, addr: i64, size: i64) -> [i64]:
    if pid <= 0 or addr < 0 or size <= 0:
        return []
    unsafe(capabilities: [ffi]):
        rt_ptrace_read_memory(pid, addr, size)

@unsafe(reason: "raw OS ptrace process-memory write status ABI", capabilities: [ffi])
extern fn rt_ptrace_write_memory(pid: i64, addr: i64, data: i64) -> i64

fn ptrace_write_memory(pid: i64, addr: i64, data: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_ptrace_write_memory(pid, addr, data)

# ============================================================================
# DWARF Operations (Debug Info Format)
# ============================================================================

@unsafe(reason: "raw DWARF binary-path and owned-handle ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_dwarf_load(binary_path: String) -> i64

@unsafe(reason: "SFFI boundary: thin wrapper whose sole purpose is returning the raw DWARF handle to the caller (debug/remote tier), which owns lifetime and releases it via dwarf_free", capabilities: [ffi])
fn dwarf_load(binary_path: String) -> i64:
    unsafe(capabilities: [ffi]):
        rt_dwarf_load(binary_path)

@unsafe(reason: "raw owned DWARF handle release ABI", capabilities: [ffi])
extern fn rt_dwarf_free(handle: i64)

fn dwarf_free(handle: i64):
    unsafe(capabilities: [ffi]):
        rt_dwarf_free(handle)

@unsafe(reason: "raw DWARF handle and runtime-owned location text ABI", capabilities: [ffi])
extern fn rt_dwarf_addr_to_line(handle: i64, addr: i64) -> String

# A non-positive handle is never a live DWARF context (`dwarf_load` reports
# failure as 0) and a negative address is never resolvable: return the
# documented empty text rather than entering the raw boundary, so no source
# location is ever fabricated for an invalid handle.
fn dwarf_addr_to_line(handle: i64, addr: i64) -> String:
    if handle <= 0 or addr < 0:
        return ""
    unsafe(capabilities: [ffi]):
        rt_dwarf_addr_to_line(handle, addr)

@unsafe(reason: "raw DWARF handle/file text address ABI; nonpositive return may mean not found", capabilities: [ffi])
extern fn rt_dwarf_line_to_addr(handle: i64, file: String, line: i64) -> i64

fn dwarf_line_to_addr(handle: i64, file: String, line: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_dwarf_line_to_addr(handle, file, line)

@unsafe(reason: "raw DWARF handle and runtime-owned function text ABI", capabilities: [ffi])
extern fn rt_dwarf_function_at(handle: i64, addr: i64) -> String

fn dwarf_function_at(handle: i64, addr: i64) -> String:
    unsafe(capabilities: [ffi]):
        rt_dwarf_function_at(handle, addr)

@unsafe(reason: "raw DWARF handle and owned string-array ABI", capabilities: [ffi])
extern fn rt_dwarf_locals_at(handle: i64, addr: i64, frame_base: i64) -> [String]

fn dwarf_locals_at(handle: i64, addr: i64, frame_base: i64) -> [String]:
    unsafe(capabilities: [ffi]):
        rt_dwarf_locals_at(handle, addr, frame_base)

# ============================================================================
# Exports
# ============================================================================

export rt_ptrace_attach, rt_ptrace_detach, rt_ptrace_continue, rt_ptrace_single_step
export rt_ptrace_get_registers, rt_ptrace_read_memory, rt_ptrace_write_memory
export rt_ptrace_wait_stop
export rt_dwarf_load, rt_dwarf_free, rt_dwarf_addr_to_line, rt_dwarf_line_to_addr
export rt_dwarf_function_at, rt_dwarf_locals_at
