# Hosted SFFI operations absent from the standalone core C runtime.
# Source compatibility is provided by system.spl's re-exports.
# The limited-process ABI takes eight machine words after text expansion:
# (cmd_ptr, cmd_len, args, timeout_ms, memory_bytes, cpu_seconds, max_fds,
# max_procs). memory_bytes is in bytes, and all three limits are forwarded.

@unsafe(reason: "raw limited process capture; exit code -1 is the execution-failure sentinel", capabilities: [ffi])
extern fn rt_process_run_with_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> (text, text, i32)

@always_inline
fn _sffi_system_process_run_with_limits_raw(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> (text, text, i32):
    unsafe(capabilities: [ffi]):
        rt_process_run_with_limits(cmd, args, timeout_ms, memory_bytes, cpu_seconds, max_fds, max_procs)

fn process_run_with_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64) -> (text, text, i32):
    _sffi_system_process_run_with_limits_raw(cmd, args, timeout_ms, memory_bytes, 0, 0, 0)

fn process_run_with_all_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> (text, text, i32):
    _sffi_system_process_run_with_limits_raw(cmd, args, timeout_ms, memory_bytes, cpu_seconds, max_fds, max_procs)

@unsafe(reason: "raw native execution; exit code -1 is the execution-failure sentinel", capabilities: [ffi])
extern fn rt_execute_native(binary_path: text, args: [text], timeout_ms: i64) -> (text, text, i32)

fn execute_native(binary_path: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    unsafe(capabilities: [ffi]):
        rt_execute_native(binary_path, args, timeout_ms)

@unsafe(reason: "raw host-target discriminant ABI; failure sentinel is untyped", capabilities: [ffi])
extern fn rt_get_host_target_code() -> i64

@unsafe(reason: "host-target failure sentinel is not represented by the facade type", capabilities: [ffi])
@always_inline
fn get_host_target_code() -> i64:
    rt_get_host_target_code()

@unsafe(reason: "raw command text execution-status ABI", capabilities: [ffi])
extern fn rt_exec(cmd: text) -> i32

@always_inline
fn exec(cmd: text) -> i32:
    unsafe(capabilities: [ffi]):
        rt_exec(cmd)

export process_run_with_limits, process_run_with_all_limits, execute_native, get_host_target_code, exec
