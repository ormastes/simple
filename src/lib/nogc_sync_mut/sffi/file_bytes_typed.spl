# Inspect typed byte storage before any conversion can reconstruct its slots.
# This alternate erased-return view uses the existing raw_bytes provider;
# retaining Any here avoids a typed-return conversion recreating slot storage.
@unsafe(reason: "checks packed backing without erasing the typed array", capabilities: [ffi])
extern fn rt_array_bytes_basis_len(data: [u8]) -> i64
@unsafe(reason: "borrows packed storage for a synchronous checked copy", capabilities: [ffi, raw_ptr])
extern fn rt_array_bytes_basis_ptr(data: [u8]) -> i64
@unsafe(reason: "copies a validated borrowed span into an owned packed handle without typed reconstruction", capabilities: [ffi, raw_ptr])
extern fn rt_bytes_from_raw(ptr: i64, len: i64) -> Any

pub fn typed_byte_basis(data: [u8]) -> i64:
    unsafe(capabilities: [ffi]):
        rt_array_bytes_basis_len(data)

pub fn copy_typed_packed_bytes(data: [u8], count: i64) -> Any:
    if count < 0 or data.len() != count: return nil
    if typed_byte_basis(data) != count: return nil
    val address = unsafe(capabilities: [ffi, raw_ptr]):
        rt_array_bytes_basis_ptr(data)
    if count > 0 and address == 0: return nil
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_bytes_from_raw(address, count)
