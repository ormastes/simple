# Canonical typed facade for the native byte-array file-write provider.
# The native writer indexes packed u8 storage; normalize generic slot-backed
# arrays into an owned packed buffer before crossing that provider boundary.
use std.nogc_sync_mut.sffi.file_bytes_typed.{typed_byte_basis, copy_typed_packed_bytes}
@unsafe(reason: "validates the runtime byte-array representation and extent", capabilities: [ffi])
extern fn rt_array_bytes_validate(data: Any) -> i64
@unsafe(reason: "allocates an owned packed array handle; preserve this erased handle without reconstruction", capabilities: [ffi])
extern fn rt_byte_array_new_len(count: i64) -> Any
@unsafe(reason: "releases the owned shallow packed-byte scratch array after synchronous use", capabilities: [ffi])
extern fn rt_array_free(data: Any)
@unsafe(reason: "returns the logical byte count for packed backing or -1 otherwise", capabilities: [ffi])
extern fn rt_array_bytes_basis_len(data: Any) -> i64
@unsafe(reason: "returns the raw data address for packed backing or zero otherwise", capabilities: [ffi, raw_ptr])
extern fn rt_array_bytes_basis_ptr(data: Any) -> i64
@unsafe(reason: "copies validated bytes into caller-owned packed storage", capabilities: [ffi, raw_ptr])
extern fn rt_array_bytes_copy_checked(source: Any, output_ptr: i64, capacity: i64) -> i64
@unsafe(reason: "native file writer borrows the path and packed byte-array values synchronously", capabilities: [ffi])
extern fn rt_file_write_bytes_array(path: Any, data: Any) -> bool

pub fn file_write_bytes_tagged_native(path: text, data: [u8]) -> bool:
    val basis = typed_byte_basis(data)
    if basis >= 0:
        if basis != data.len(): return false
        val packed: Any = copy_typed_packed_bytes(data, basis)
        if packed == nil: return false
        val written = file_write_bytes_runtime_native(path, packed)
        unsafe(capabilities: [ffi]):
            rt_array_free(packed)
        return written
    val source: Any = data
    file_write_bytes_runtime_native(path, source)

pub fn file_write_bytes_runtime_native(path: text, source: Any) -> bool:
    val native_path: Any = path
    val count = unsafe(capabilities: [ffi]):
        rt_array_bytes_validate(source)
    if count < 0: return false

    # Only the runtime basis helper proves this exact erased handle is packed.
    # A generic slot array contains tagged integer words and must be normalized.
    val source_basis = unsafe(capabilities: [ffi]):
        rt_array_bytes_basis_len(source)
    if source_basis == count:
        val source_ptr = unsafe(capabilities: [ffi, raw_ptr]):
            rt_array_bytes_basis_ptr(source)
        if count > 0 and source_ptr == 0: return false
        return unsafe(capabilities: [ffi]):
            rt_file_write_bytes_array(native_path, source)
    if source_basis >= 0: return false

    # Keep the allocator's Any handle unchanged: typed-[u8] to Any lowering can
    # reconstruct a slot array and discard the packed-backing proof.
    val packed: Any = unsafe(capabilities: [ffi]):
        rt_byte_array_new_len(count)
    if packed == nil: return false
    val packed_basis = unsafe(capabilities: [ffi]):
        rt_array_bytes_basis_len(packed)
    if packed_basis != count:
        unsafe(capabilities: [ffi]):
            rt_array_free(packed)
        return false
    val output_ptr = unsafe(capabilities: [ffi, raw_ptr]):
        rt_array_bytes_basis_ptr(packed)
    if count > 0 and output_ptr == 0:
        unsafe(capabilities: [ffi]):
            rt_array_free(packed)
        return false
    val copied = unsafe(capabilities: [ffi, raw_ptr]):
        rt_array_bytes_copy_checked(source, output_ptr, count)
    if copied != count:
        unsafe(capabilities: [ffi]):
            rt_array_free(packed)
        return false

    # Free only the freshly allocated shallow byte buffer after synchronous use.
    val wrote = unsafe(capabilities: [ffi]):
        rt_file_write_bytes_array(native_path, packed)
    unsafe(capabilities: [ffi]):
        rt_array_free(packed)
    wrote
