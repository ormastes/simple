# Canonical typed facade for the native byte-array file-write provider.
# Both native writer twins consume either storage shape directly — the Rust
# twin normalizes packed and slot-backed arrays itself and the C twin reads
# element-wise — so this facade only proves the runtime byte extent, then
# writes. An earlier revision normalized slot arrays through a raw packed
# scratch buffer first; that path depended on rt_array_bytes_basis_ptr, which
# the bootstrap seed's interpreter bridge reports as unavailable (address 0),
# so under the seed every boxed write failed with the target file left empty
# (rendered upstream as SCV-E-ADMISSION: snapshot-chunk-publish-failed).
@unsafe(reason: "validates the runtime byte-array representation and extent", capabilities: [ffi])
extern fn rt_array_bytes_validate<D>(data: D) -> i64
@unsafe(reason: "native file writer borrows the path and byte-array values synchronously", capabilities: [ffi])
extern fn rt_file_write_bytes_array<P, D>(path: P, data: D) -> bool

pub fn file_write_bytes_tagged_native(path: text, data: [u8]) -> bool:
    val count = unsafe(capabilities: [ffi]):
        rt_array_bytes_validate(data)
    if count < 0 or count != data.len(): return false
    unsafe(capabilities: [ffi]):
        rt_file_write_bytes_array(path, data)

# Erased-input entry: its contract is to REJECT non-byte-array values (see
# test/fixtures/compiler/nogc_file_bytes_abi_probe.spl), so `source` is generic
# and the runtime validator decides. Callers pass any value; non-byte-arrays fail.
pub fn file_write_bytes_runtime_native<S>(path: text, source: S) -> bool:
    val count = unsafe(capabilities: [ffi]):
        rt_array_bytes_validate(source)
    if count < 0: return false
    unsafe(capabilities: [ffi]):
        rt_file_write_bytes_array(path, source)
