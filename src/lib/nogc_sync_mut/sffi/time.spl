# time runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

@unsafe(reason: "raw runtime ABI for rt_sleep_ms", capabilities: [ffi])
extern fn rt_sleep_ms(ms: i64)

@always_inline
fn sleep_ms_raw(ms: i64):
    unsafe(capabilities: [ffi]):
        rt_sleep_ms(ms)

@unsafe(reason: "raw runtime ABI for rt_time_monotonic_ns", capabilities: [ffi])
extern fn rt_time_monotonic_ns() -> i64

@always_inline
fn time_monotonic_ns() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_monotonic_ns()

@unsafe(reason: "raw runtime ABI for rt_time_ms", capabilities: [ffi])
extern fn rt_time_ms() -> i64

@always_inline
fn time_ms() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_ms()

