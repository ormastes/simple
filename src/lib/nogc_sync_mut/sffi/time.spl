# time runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).
# Historical interpreter-only clock spellings use the canonical native
# wall-clock provider below, preserving their public units and failure sentinel.
use std.common.time_utils.{rt_time_now_unix_micros}

@unsafe(reason: "raw runtime ABI for rt_sleep_ms", capabilities: [ffi])
extern fn rt_sleep_ms(ms: i64)

@always_inline
fn sleep_ms_raw(ms: i64):
    unsafe(capabilities: [ffi]):
        rt_sleep_ms(ms)

@unsafe(reason: "raw runtime ABI for rt_time_monotonic_ns", capabilities: [ffi])
extern fn rt_time_monotonic_ns() -> i64

@always_inline
fn time_monotonic_ns() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_monotonic_ns()

@unsafe(reason: "raw runtime ABI for rt_time_ms", capabilities: [ffi])
extern fn rt_time_ms() -> i64

@always_inline
fn time_ms() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_ms()

@unsafe(reason: "raw runtime ABI for rt_time_now_micros", capabilities: [ffi])
extern fn rt_time_now_micros() -> i64

@always_inline
fn time_now_micros() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_now_micros()

# Wall-clock Unix ms from rt_time_now_unix_micros: rt_time_now_ms had no
# native runtime definition, so native links of this module failed
# (undefined symbol). rt_time_now_micros is monotonic, not wall-clock.
@always_inline
fn time_now_ms() -> i64:
    var micros: i64 = -1
    unsafe(capabilities: [ffi]):
        micros = rt_time_now_unix_micros()
    if micros < 0:
        return -1
    micros / 1000

@unsafe(reason: "raw runtime ABI for rt_time_now_nanos", capabilities: [ffi])
extern fn rt_time_now_nanos() -> i64

@always_inline
fn time_now_nanos() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_now_nanos()

@unsafe(reason: "raw runtime ABI for rt_time_now_seconds", capabilities: [ffi])
extern fn rt_time_now_seconds() -> i64

@always_inline
fn time_now_seconds() -> i64:
    unsafe(capabilities: [ffi]):
        rt_time_now_seconds()

@unsafe(reason: "raw runtime ABI for rt_time_now_seconds_f64", capabilities: [ffi])
extern fn rt_time_now_seconds_f64() -> f64

@always_inline
fn time_now_seconds_f64() -> f64:
    unsafe(capabilities: [ffi]):
        rt_time_now_seconds_f64()

# timestamp_* calendar functions are owned by std.common.time_utils (i64 ABI);
# re-exported here so existing `std.nogc_sync_mut.sffi.time` importers keep working.
pub use std.common.time_utils.{timestamp_add_days, timestamp_diff_days, timestamp_from_components, timestamp_get_day, timestamp_get_hour, timestamp_get_microsecond, timestamp_get_minute, timestamp_get_month, timestamp_get_second, timestamp_get_year, timestamp_now}
