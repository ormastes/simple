# SFFI - AST Operations
# Centralized AST manipulation and registry SFFI wrappers

# ============================================================================
# AST Expression Operations
# ============================================================================

@unsafe(reason: "raw opaque AST expression handle and runtime-owned tag text ABI", capabilities: [ffi])
extern fn rt_ast_expr_tag(handle: i64) -> text

@unsafe(reason: "raw opaque AST handle lifetime, tag, or index contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn ast_expr_tag(handle: i64) -> text:
    rt_ast_expr_tag(handle)

@unsafe(reason: "releases a raw opaque AST expression handle", capabilities: [ffi])
extern fn rt_ast_expr_free(handle: i64)

@unsafe(reason: "raw opaque AST handle lifetime, tag, or index contract remains caller-owned", capabilities: [ffi, raw_ptr])
@always_inline
fn ast_expr_free(handle: i64):
    rt_ast_expr_free(handle)

