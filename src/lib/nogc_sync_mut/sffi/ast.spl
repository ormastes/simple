# ============================================================================
# AST Registry
# ============================================================================

@unsafe(reason: "raw process-global AST registry ABI", capabilities: [ffi])
extern fn rt_ast_registry_count() -> i64

@always_inline
fn ast_registry_count() -> i64:
    unsafe(capabilities: [ffi]):
        rt_ast_registry_count()

@unsafe(reason: "mutates and invalidates the raw process-global AST registry", capabilities: [ffi])
extern fn rt_ast_registry_clear()

@always_inline
fn ast_registry_clear():
    unsafe(capabilities: [ffi]):
        rt_ast_registry_clear()
