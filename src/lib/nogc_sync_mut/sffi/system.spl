# --- Sleep/Delay ---

use std.io_runtime.{thread_sleep}

fn sleep_ms(milliseconds: i64):
    thread_sleep(milliseconds)

@unsafe(reason: "raw blocking thread sleep ABI", capabilities: [ffi])
extern fn rt_sleep_secs(seconds: i64)

@always_inline
fn sleep_secs(seconds: i64):
    unsafe(capabilities: [ffi]):
        rt_sleep_secs(seconds)

