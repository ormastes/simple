# SFFI - System Operations
# Centralized environment, process, and time SFFI wrappers

# ============================================================================
# Environment Operations
# ============================================================================

use std.io_runtime.{cwd as io_runtime_cwd}

# The canonical wrapper maps getcwd failure to ".". Every caller here wants a
# total path to join against, so both compatibility spellings preserve that
# contract without exposing the raw nullable value.
fn env_cwd() -> text:
    io_runtime_cwd()

fn cwd() -> text:
    io_runtime_cwd()

@unsafe(reason: "raw nullable runtime-owned home-directory text ABI", capabilities: [ffi])
extern fn rt_env_home() -> text?

@always_inline
fn _env_home_raw() -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_home()

@unsafe(reason: "empty runtime-owned home text does not distinguish failure", capabilities: [ffi])
@always_inline
fn env_home() -> text:
    _env_home_raw() ?? ""

@unsafe(reason: "empty runtime-owned home text does not distinguish failure", capabilities: [ffi])
@always_inline
fn home() -> text:
    _env_home_raw() ?? ""

fn env_home_checked() -> Result<text, text>:
    val value = _env_home_raw()
    if value == nil or value == "":
        return Err("rt_env_home returned no home directory")
    Ok(value)

# Same defect class as `flat_bridge_env_get` in
# src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl: `rt_env_get`
# yields nil for an UNSET variable, so both it and this wrapper must be
# declared optional or the SFFI return-contract validator rejects the nil.
# Unlike that wrapper this one must stay OPTIONAL rather than collapse to "" —
# callers such as `env_get("SIMPLE_TRACE_FONT_STYLE") != nil` distinguish
# unset from empty, and returning "" would silently turn those flags on.
@unsafe(reason: "raw environment text lookup ABI; nil means absent", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?

@always_inline
fn env_get(key: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)

@unsafe(reason: "raw environment integer lookup uses the caller default as its failure sentinel", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default: i64) -> i64

@always_inline
fn env_get_i64(key: text, default: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_env_get_i64(key, default)

@unsafe(reason: "raw PRNG ABI; not cryptographically secure", capabilities: [ffi])
extern fn rt_random_i64() -> i64

@always_inline
fn random_i64() -> i64:
    unsafe(capabilities: [ffi]):
        rt_random_i64()

@unsafe(reason: "raw stderr write ABI", capabilities: [ffi])
extern fn rt_stderr_write(msg: text)

@always_inline
fn stderr_write(msg: text):
    unsafe(capabilities: [ffi]):
        rt_stderr_write(msg)

@unsafe(reason: "raw process-liveness-check ABI", capabilities: [ffi])
extern fn rt_process_exists(pid: i64) -> bool

@always_inline
fn process_exists(pid: i64) -> bool:
    unsafe(capabilities: [ffi]):
        rt_process_exists(pid)

@unsafe(reason: "raw environment key/value mutation-status ABI", capabilities: [ffi])
extern fn rt_env_set(key: text, value: text) -> bool

@always_inline
fn env_set(key: text, value: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_env_set(key, value)

@unsafe(reason: "raw environment key removal-status ABI", capabilities: [ffi])
extern fn rt_env_remove(key: text) -> bool

@always_inline
fn env_remove(key: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_env_remove(key)

@unsafe(reason: "raw nullable environment snapshot and owned tuple-array ABI", capabilities: [ffi])
extern fn rt_env_vars() -> [(text, text)]?

@always_inline
fn _env_vars_raw() -> [(text, text)]?:
    unsafe(capabilities: [ffi]):
        rt_env_vars()

@always_inline
fn env_vars_nilable() -> [(text, text)]?:
    _env_vars_raw()

@unsafe(reason: "environment snapshot ownership is not represented by the facade type", capabilities: [ffi])
@always_inline
fn env_vars() -> [(text, text)]:
    _env_vars_raw() ?? []

fn env_vars_checked() -> Result<[(text, text)], text>:
    val values = _env_vars_raw()
    if values == nil:
        return Err("rt_env_vars failed to allocate an environment snapshot")
    Ok(values)

# --- Program Arguments ---

@unsafe(reason: "raw process argument-array ownership ABI", capabilities: [ffi])
extern fn rt_get_args() -> [text]

# `rt_get_args` yields nil only if the runtime argv array is unset; "no
# arguments" is already an EMPTY array, not nil, so nil and [] carry the
# same meaning to every caller. TOTAL with the documented default [].
@always_inline
fn args_get() -> [text]:
    unsafe(capabilities: [ffi]):
        rt_get_args() ?? []

@always_inline
fn args() -> [text]:
    unsafe(capabilities: [ffi]):
        rt_get_args() ?? []

# ============================================================================
# Process Operations
# ============================================================================

# --- Process Execution ---

@unsafe(reason: "raw process capture; exit code -1 is the execution-failure sentinel", capabilities: [ffi])
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

@always_inline
fn _sffi_system_process_run_raw(cmd: text, args: [text]) -> (text, text, i64):
    unsafe(capabilities: [ffi]):
        rt_process_run(cmd, args)

fn process_run(cmd: text, args: [text]) -> (text, text, i64):
    _sffi_system_process_run_raw(cmd, args)

@unsafe(reason: "raw timed process capture; exit code -1 is failure or timeout", capabilities: [ffi])
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

@always_inline
fn _sffi_system_process_run_timeout_raw(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    unsafe(capabilities: [ffi]):
        rt_process_run_timeout(cmd, args, timeout_ms)

fn process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    _sffi_system_process_run_timeout_raw(cmd, args, timeout_ms)

# ABI: env_process.rs:1269 takes EIGHT words --
# (cmd_ptr, cmd_len, args, timeout_ms, memory_bytes, cpu_seconds, max_fds,
# max_procs). Declaring only four Simple params left cpu_seconds/max_fds/
# max_procs reading uninitialised registers, and those three go straight into
# setrlimit(2) for the child. Note the unit is BYTES, not MB, despite the old
# parameter name.
@unsafe(reason: "raw limited process capture; exit code -1 is the execution-failure sentinel", capabilities: [ffi])
extern fn rt_process_run_with_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> (text, text, i32)

@always_inline
fn _sffi_system_process_run_with_limits_raw(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> (text, text, i32):
    unsafe(capabilities: [ffi]):
        rt_process_run_with_limits(cmd, args, timeout_ms, memory_bytes, cpu_seconds, max_fds, max_procs)

fn process_run_with_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64) -> (text, text, i32):
    _sffi_system_process_run_with_limits_raw(cmd, args, timeout_ms, memory_bytes, 0, 0, 0)

fn process_run_with_all_limits(cmd: text, args: [text], timeout_ms: i64, memory_bytes: i64, cpu_seconds: i64, max_fds: i64, max_procs: i64) -> (text, text, i32):
    _sffi_system_process_run_with_limits_raw(cmd, args, timeout_ms, memory_bytes, cpu_seconds, max_fds, max_procs)

@unsafe(reason: "raw native execution; exit code -1 is the execution-failure sentinel", capabilities: [ffi])
extern fn rt_execute_native(binary_path: text, args: [text], timeout_ms: i64) -> (text, text, i32)

@always_inline
fn _sffi_system_execute_native_raw(binary_path: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    unsafe(capabilities: [ffi]):
        rt_execute_native(binary_path, args, timeout_ms)

fn execute_native(binary_path: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    _sffi_system_execute_native_raw(binary_path, args, timeout_ms)

@unsafe(reason: "raw process output; empty text conflates empty output with execution failure", capabilities: [ffi])
extern fn rt_process_output(cmd: text, args: [text]) -> text

@always_inline
fn _sffi_system_process_output_raw(cmd: text, args: [text]) -> text:
    unsafe(capabilities: [ffi]):
        rt_process_output(cmd, args)

@unsafe(reason: "empty process output does not distinguish success from execution failure", capabilities: [ffi])
@always_inline
fn process_output(cmd: text, args: [text]) -> text:
    _sffi_system_process_output_raw(cmd, args)

@unsafe(reason: "raw owned-child spawn; positive PID is success and -1 is failure", capabilities: [ffi])
extern fn rt_process_spawn(cmd: text, args: [text]) -> i64

@always_inline
fn _sffi_system_process_spawn_raw(cmd: text, args: [text]) -> i64:
    unsafe(capabilities: [ffi]):
        rt_process_spawn(cmd, args)

fn process_spawn(cmd: text, args: [text]) -> i64:
    _sffi_system_process_spawn_raw(cmd, args)

@unsafe(reason: "raw owned-child wait; -1 is the invalid or wait-failure sentinel", capabilities: [ffi])
extern fn rt_process_wait(pid: i64) -> i64

@always_inline
fn _sffi_system_process_wait_raw(pid: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_process_wait(pid)

fn process_wait(pid: i64) -> i64:
    if pid <= 0:
        return -1
    _sffi_system_process_wait_raw(pid)

@unsafe(reason: "raw owned-child termination status; false is invalid, absent, or failure", capabilities: [ffi])
extern fn rt_process_kill(pid: i64) -> bool

@always_inline
fn _sffi_system_process_kill_raw(pid: i64) -> bool:
    unsafe(capabilities: [ffi]):
        rt_process_kill(pid)

fn process_kill(pid: i64) -> bool:
    if pid <= 1:
        return false
    _sffi_system_process_kill_raw(pid)

# --- Process Information ---

@unsafe(reason: "raw process-id ABI", capabilities: [ffi])
extern fn rt_getpid() -> i64

@always_inline
fn _getpid_raw() -> i64:
    unsafe(capabilities: [ffi]):
        rt_getpid()

@unsafe(reason: "legacy process-id API exposes the raw non-positive failure sentinel", capabilities: [ffi])
@always_inline
fn getpid() -> i64:
    _getpid_raw()

fn getpid_checked() -> Result<i64, text>:
    val pid = _getpid_raw()
    if pid <= 0:
        return Err("rt_getpid returned a non-positive process identifier")
    Ok(pid)

@unsafe(reason: "raw nullable runtime-owned hostname text ABI", capabilities: [ffi])
extern fn rt_hostname() -> text?

@always_inline
fn _hostname_raw() -> text?:
    unsafe(capabilities: [ffi]):
        rt_hostname()

@unsafe(reason: "empty runtime-owned hostname text does not distinguish failure", capabilities: [ffi])
@always_inline
fn hostname() -> text:
    _hostname_raw() ?? ""

fn hostname_checked() -> Result<text, text>:
    val value = _hostname_raw()
    if value == nil or value == "":
        return Err("rt_hostname returned no hostname")
    Ok(value)

@unsafe(reason: "raw host CPU-count ABI; nonpositive return is failure", capabilities: [ffi])
extern fn rt_cpu_count() -> i64

@always_inline
fn _cpu_count_raw() -> i64:
    unsafe(capabilities: [ffi]):
        rt_cpu_count()

@unsafe(reason: "legacy CPU-count API exposes the raw non-positive failure sentinel", capabilities: [ffi])
@always_inline
fn cpu_count() -> i64:
    _cpu_count_raw()

fn cpu_count_checked() -> Result<i64, text>:
    val count = _cpu_count_raw()
    if count <= 0:
        return Err("rt_cpu_count returned a non-positive count")
    Ok(count)

@unsafe(reason: "raw host-target discriminant ABI; failure sentinel is untyped", capabilities: [ffi])
extern fn rt_get_host_target_code() -> i64

@unsafe(reason: "host-target failure sentinel is not represented by the facade type", capabilities: [ffi])
@always_inline
