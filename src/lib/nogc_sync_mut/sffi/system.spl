extern fn rt_time_now_unix_millis() -> i64

fn time_now_unix_millis() -> i64:
    rt_time_now_unix_millis()

extern fn rt_time_now_iso() -> text

fn time_now_iso() -> text:
    rt_time_now_iso()

extern fn rt_time_millis() -> i64

fn time_millis() -> i64:
