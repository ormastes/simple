@unsafe(reason: "raw runtime-owned UUID text ABI; empty text is failure", capabilities: [ffi])
extern fn rt_uuid_v4() -> text

@unsafe(reason: "empty runtime-owned UUID text does not distinguish failure", capabilities: [ffi])
@always_inline
fn uuid_v4() -> text:
