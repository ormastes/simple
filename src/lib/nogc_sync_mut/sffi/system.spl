# --- Time Components ---

extern fn rt_time_year() -> i64

fn time_year() -> i64:
    rt_time_year()

extern fn rt_time_month() -> i64

fn time_month() -> i64:
    rt_time_month()

extern fn rt_time_day() -> i64

fn time_day() -> i64:
    rt_time_day()

extern fn rt_time_hour() -> i64

