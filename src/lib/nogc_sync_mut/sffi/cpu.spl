# Narrow hosted CPU query owner. Importing CPUID must not pull in privileged
# hardware, debugger, or platform-specific wrappers from the broad host facade.
@unsafe(reason: "raw runtime ABI for rt_cpu_is_x86_64", capabilities: [ffi])
extern fn rt_cpu_is_x86_64() -> i32

@always_inline
fn cpu_is_x86_64() -> i32:
    unsafe(capabilities: [ffi]):
        rt_cpu_is_x86_64()

@unsafe(reason: "raw runtime ABI for rt_x86_avx512_os_state_usable", capabilities: [ffi])
extern fn rt_x86_avx512_os_state_usable() -> bool

@always_inline
fn x86_avx512_os_state_usable() -> bool:
    unsafe(capabilities: [ffi]):
        rt_x86_avx512_os_state_usable()

@unsafe(reason: "raw runtime ABI for rt_xgetbv", capabilities: [ffi])
extern fn rt_xgetbv(index: i32) -> i64

@always_inline
fn xgetbv(index: i32) -> i64:
    unsafe(capabilities: [ffi]):
        rt_xgetbv(index)

@unsafe(reason: "runtime-owned CPUID tuple handle ABI", capabilities: [ffi])
extern fn rt_cpuid_tuple(leaf: i32, subleaf: i32) -> (i32, i32, i32, i32)

@always_inline
fn cpuid(leaf: i32, subleaf: i32) -> (i32, i32, i32, i32):
    unsafe(capabilities: [ffi]):
        rt_cpuid_tuple(leaf, subleaf)
