# Core environment SFFI boundary. Kept separate from optional process limits
# so env-only compiler entries do not require that hosted runtime export.

# Nil means absent; empty text remains distinct for callers that inspect it.
@unsafe(reason: "raw environment text lookup ABI; nil means absent", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?

@always_inline
fn env_get_nilable(key: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)

@unsafe(reason: "raw environment integer lookup uses the caller default as its failure sentinel", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default: i64) -> i64

@always_inline
fn env_get_i64(key: text, default: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_env_get_i64(key, default)

@unsafe(reason: "raw environment key removal-status ABI", capabilities: [ffi])
extern fn rt_env_remove(key: text) -> bool

@always_inline
fn env_remove(key: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_env_remove(key)

@unsafe(reason: "raw nullable environment snapshot and owned tuple-array ABI", capabilities: [ffi])
extern fn rt_env_vars() -> [(text, text)]?

# A runtime tuple is an array-headed heap object, not the inline two-word
# layout native code uses for a typed `(text, text)`. Two producers exist:
#   - a compiler with e9b6b0e24d6 rebuilds the extern result into native
#     tuples at the call, and the interpreter has real tuples: `pair` is
#     already usable and must be kept as-is;
#   - a compiler without it (the frozen Phase 2 pin) hands over the runtime
#     pair, whose `.0`/`.1` read header words (every owned Windows test child
#     then got the assignment "=" and admission was refused).
# These getters are private to the runtime-produced snapshot.
@unsafe(reason: "validate the runtime-owned environment pair before slot access", capabilities: [ffi])
extern fn rt_tuple_len(pair: (text, text)) -> i64
@unsafe(reason: "read a validated environment pair slot; runtime owns both text values", capabilities: [ffi])
extern fn rt_tuple_get(pair: (text, text), index: i64) -> text?

# An environment name is never empty, so a pair whose key reads as text is a
# language tuple. A header word contributes no characters to a concatenation.
fn _env_pair_is_language_tuple(pair: (text, text)) -> bool:
    (pair.0 + "=").len() > 1

# None means the snapshot is unavailable. A pair is never dropped: one that is
# not a readable runtime pair is kept as the language tuple it already is.
# Empty values stay present and unchanged.
fn env_vars_nilable() -> [(text, text)]?:
    val snapshot = unsafe(capabilities: [ffi]): rt_env_vars()
    var result: [(text, text)] = []
    if val pairs = snapshot:
        for pair in pairs:
            var rebuilt = false
            if not _env_pair_is_language_tuple(pair):
                val arity = unsafe(capabilities: [ffi]): rt_tuple_len(pair)
                if arity == 2:
                    val key = unsafe(capabilities: [ffi]): rt_tuple_get(pair, 0)
                    val value = unsafe(capabilities: [ffi]): rt_tuple_get(pair, 1)
                    if val key_text = key:
                        if val value_text = value:
                            # Construct a language tuple instead of exposing
                            # the runtime header.
                            result = result.push((key_text, value_text))
                            rebuilt = true
            if not rebuilt: result = result.push(pair)
        return result
    None

export env_get_nilable, env_get_i64, env_remove, env_vars_nilable
