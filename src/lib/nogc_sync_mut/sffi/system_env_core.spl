# Core environment SFFI boundary. Kept separate from optional process limits
# so env-only compiler entries do not require that hosted runtime export.

# Nil means absent; empty text remains distinct for callers that inspect it.
@unsafe(reason: "raw environment text lookup ABI; nil means absent", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?

@always_inline
fn env_get(key: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)

@unsafe(reason: "raw environment integer lookup uses the caller default as its failure sentinel", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default: i64) -> i64

@always_inline
fn env_get_i64(key: text, default: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_env_get_i64(key, default)

@unsafe(reason: "raw environment key removal-status ABI", capabilities: [ffi])
extern fn rt_env_remove(key: text) -> bool

@always_inline
fn env_remove(key: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_env_remove(key)

@unsafe(reason: "raw nullable environment snapshot and owned tuple-array ABI", capabilities: [ffi])
extern fn rt_env_vars() -> [(text, text)]?

# These getters are private to the runtime-produced snapshot. A runtime tuple
# is not the inline native tuple layout used by ordinary Simple expressions.
# Both hosted and native runtime providers validate the tuple before reading.
@unsafe(reason: "validate the runtime-owned environment pair before slot access", capabilities: [ffi])
extern fn rt_tuple_len(pair: (text, text)) -> i64
@unsafe(reason: "read a validated environment pair slot; runtime owns both text values", capabilities: [ffi])
extern fn rt_tuple_get(pair: (text, text), index: i64) -> text?

fn env_vars_nilable() -> [(text, text)]?:
    val snapshot = unsafe(capabilities: [ffi]): rt_env_vars()
    if snapshot == nil: return nil
    var result: [(text, text)] = []
    for pair in snapshot ?? []:
        val arity = unsafe(capabilities: [ffi]): rt_tuple_len(pair)
        if arity != 2: return nil
        val key = unsafe(capabilities: [ffi]): rt_tuple_get(pair, 0)
        val value = unsafe(capabilities: [ffi]): rt_tuple_get(pair, 1)
        if key == nil or value == nil: return nil
        # Construct a language tuple rather than exposing a runtime header to
        # native .0/.1 projection. Empty values remain present and unchanged.
        result = result.push((key ?? "", value ?? ""))
    result

export env_get, env_get_i64, env_remove, env_vars_nilable
