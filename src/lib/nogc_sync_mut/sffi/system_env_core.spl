# Core environment SFFI boundary. Kept separate from optional process limits
# so env-only compiler entries do not require that hosted runtime export.

# Nil means absent; empty text remains distinct for callers that inspect it.
@unsafe(reason: "raw environment text lookup ABI; nil means absent", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?

@always_inline
fn env_get(key: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)

@unsafe(reason: "raw environment integer lookup uses the caller default as its failure sentinel", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default: i64) -> i64

@always_inline
fn env_get_i64(key: text, default: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_env_get_i64(key, default)

@unsafe(reason: "raw environment key removal-status ABI", capabilities: [ffi])
extern fn rt_env_remove(key: text) -> bool

@always_inline
fn env_remove(key: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_env_remove(key)

@unsafe(reason: "raw nullable environment snapshot and owned tuple-array ABI", capabilities: [ffi])
extern fn rt_env_vars() -> [(text, text)]?

@always_inline
fn env_vars_nilable() -> [(text, text)]?:
    unsafe(capabilities: [ffi]):
        rt_env_vars()

export env_get, env_get_i64, env_remove, env_vars_nilable
