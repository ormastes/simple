# Canonical SFFI admission receipt parsing.
#
# The cryptographic verifier emits this bounded text record once during
# provider admission. Parsing does not perform cryptography and therefore does
# not make arbitrary caller-provided text trusted; raw slot publication must
# remain ffi-unsafe until the loader supplies a verifier-minted receipt.

use std.common.structural.digest.hash256.{hash256_hex_valid}
use std.common.crypto.ed25519.{pure_ed25519_verify}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{text_to_bytes}

val SFFI_ADMISSION_MAX_TEXT: i64 = 2097152
val SFFI_ADMISSION_MAX_SYMBOLS: i64 = 8192
val SFFI_ADMISSION_MAX_TRUST_ROOTS: i64 = 64

pub struct SffiAdmissionTrustRootV1:
    key_id: text
    public_key: [u8]

impl SffiAdmissionTrustRootV1:
    static fn create(key_id: text, public_key: [u8]) -> Result<SffiAdmissionTrustRootV1, text>:
        if key_id == "" or key_id.contains("\t") or key_id.contains("\n") or key_id.contains("\r"):
            return Err("E-SFFI-005: invalid SFFI trust-root key id")
        if public_key.len() != 32:
            return Err("E-SFFI-005: Ed25519 SFFI trust root must contain 32 bytes")
        Ok(SffiAdmissionTrustRootV1(key_id: key_id, public_key: public_key))

pub struct SffiAdmissionReceiptV1:
    provider_id: text
    target: text
    signer_key_id: text
    artifact_sha256: text
    abi_registry_sha256: text
    signed_manifest_sha256: text
    verification_report_sha256: text
    source_signatures: {text: text}

# Signature-verified receipt token. Construction is confined to the verifier
# below; parsing alone cannot produce this authority.
pub class SignatureVerifiedSffiAdmissionV1:
    receipt: SffiAdmissionReceiptV1

impl SignatureVerifiedSffiAdmissionV1:
    pub fn provider_identity() -> text:
        self.receipt.provider_identity()

    pub fn target_identity() -> text:
        self.receipt.target_identity()

    pub fn artifact_digest() -> text:
        self.receipt.artifact_digest()

    pub fn abi_registry_digest() -> text:
        self.receipt.abi_registry_digest()

    pub(package) fn verified_receipt() -> SffiAdmissionReceiptV1:
        self.receipt

impl SffiAdmissionReceiptV1:
    pub fn provider_identity() -> text:
        self.provider_id

    pub fn target_identity() -> text:
        self.target

    pub fn artifact_digest() -> text:
        self.artifact_sha256

    pub fn abi_registry_digest() -> text:
        self.abi_registry_sha256

    pub fn source_signature_count() -> i64:
        self.source_signatures.len()

    pub fn source_signature(symbol: text) -> text?:
        if self.source_signatures.contains(symbol):
            return Some(self.source_signatures[symbol])
        nil

fn _admission_pair(line: text, expected_key: text) -> Result<text, text>:
    val fields = line.split("\t")
    if fields.len() != 2 or fields[0] != expected_key or fields[1] == "":
        return Err("E-SFFI-005: malformed admission field {expected_key}")
    Ok(fields[1])

fn _admission_digest(line: text, expected_key: text) -> Result<text, text>:
    match _admission_pair(line, expected_key):
        case Ok(value):
            if not hash256_hex_valid(value):
                return Err("E-SFFI-005: invalid admission digest {expected_key}")
            Ok(value)
        case Err(error):
            Err(error)

fn parse_sffi_admission_v1(content: text) -> Result<SffiAdmissionReceiptV1, text>:
    if content.len() > SFFI_ADMISSION_MAX_TEXT:
        return Err("E-SFFI-005: admission receipt exceeds 2 MiB limit")
    if content == "" or not content.ends_with("\n") or content.contains("\r"):
        return Err("E-SFFI-005: admission receipt must be canonical LF text")

    val lines = content.split("\n")
    if lines.len() < 11 or lines[lines.len() - 1] != "":
        return Err("E-SFFI-005: truncated admission receipt")
    if lines[0] != "schema\tsimple.sffi-admission.v1":
        return Err("E-SFFI-005: unsupported admission schema")

    val provider_result = _admission_pair(lines[1], "provider_id")
    val target_result = _admission_pair(lines[2], "target")
    val signer_result = _admission_pair(lines[3], "signer_key_id")
    val artifact_result = _admission_digest(lines[4], "artifact_sha256")
    val abi_result = _admission_digest(lines[5], "abi_registry_sha256")
    val manifest_result = _admission_digest(lines[6], "signed_manifest_sha256")
    val report_result = _admission_digest(lines[7], "verification_report_sha256")
    val count_result = _admission_pair(lines[8], "symbol_count")

    match provider_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match target_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match signer_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match artifact_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match abi_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match manifest_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match report_result:
        case Err(error): return Err(error)
        case Ok(_): pass
    match count_result:
        case Err(error): return Err(error)
        case Ok(_): pass

    val parsed_count = count_result!.parse_int()
    if parsed_count == nil or parsed_count! <= 0 or parsed_count! > SFFI_ADMISSION_MAX_SYMBOLS:
        return Err("E-SFFI-005: invalid admission symbol_count")
    val symbol_count = parsed_count!
    if lines.len() != symbol_count + 10:
        return Err("E-SFFI-005: admission symbol_count does not match rows")

    var signatures: {text: text} = {}
    var index = 0
    while index < symbol_count:
        val fields = lines[index + 9].split("\t")
        if fields.len() != 5 or fields[0] != "symbol" or
           not fields[1].starts_with("rt_") or
           not hash256_hex_valid(fields[2]) or
           fields[3] != "true" or fields[4] != "true":
            return Err("E-SFFI-005: malformed admitted symbol row")
        if signatures.contains(fields[1]):
            return Err("E-SFFI-019: duplicate admitted symbol {fields[1]}")
        signatures[fields[1]] = fields[2]
        index = index + 1

    Ok(SffiAdmissionReceiptV1(
        provider_id: provider_result!,
        target: target_result!,
        signer_key_id: signer_result!,
        artifact_sha256: artifact_result!,
        abi_registry_sha256: abi_result!,
        signed_manifest_sha256: manifest_result!,
        verification_report_sha256: report_result!,
        source_signatures: signatures,
    ))

fn parse_sffi_evidence_v2(content: text) -> Result<SffiAdmissionReceiptV1, text>:
    if content.len() > SFFI_ADMISSION_MAX_TEXT:
        return Err("E-SFFI-005: evidence manifest exceeds 2 MiB limit")
    if content == "" or not content.ends_with("\n") or content.contains("\r"):
        return Err("E-SFFI-005: evidence manifest must be canonical LF text")
    val lines = content.split("\n")
    if lines.len() < 13 or lines[lines.len() - 1] != "" or
       lines[0] != "schema\tsimple.sffi-evidence.v2":
        return Err("E-SFFI-005: unsupported or truncated SFFI evidence manifest")

    val provider_result = _admission_pair(lines[1], "provider_id")
    val target_result = _admission_pair(lines[2], "target")
    val signer_result = _admission_pair(lines[3], "signer_key_id")
    val artifact_result = _admission_digest(lines[4], "artifact_sha256")
    val source_result = _admission_digest(lines[5], "canonical_source_tree_sha256")
    val build_result = _admission_digest(lines[6], "exact_build_input_sha256")
    val compiler_result = _admission_digest(lines[7], "compiler_artifact_sha256")
    val abi_result = _admission_digest(lines[8], "abi_registry_sha256")
    val report_result = _admission_digest(lines[9], "verification_report_sha256")
    val count_result = _admission_pair(lines[10], "symbol_count")
    for result in [provider_result, target_result, signer_result, artifact_result,
                   source_result, build_result, compiler_result, abi_result,
                   report_result, count_result]:
        match result:
            case Err(error): return Err(error)
            case Ok(_): pass

    val parsed_count = count_result!.parse_int()
    if parsed_count == nil or parsed_count! <= 0 or parsed_count! > SFFI_ADMISSION_MAX_SYMBOLS:
        return Err("E-SFFI-005: invalid evidence symbol_count")
    val symbol_count = parsed_count!
    if lines.len() != symbol_count + 12:
        return Err("E-SFFI-005: evidence symbol_count does not match rows")

    var signatures: {text: text} = {}
    var previous = ""
    var index = 0
    while index < symbol_count:
        val fields = lines[index + 11].split("\t")
        if fields.len() != 3 or fields[0] != "symbol" or
           not fields[1].starts_with("rt_") or
           not hash256_hex_valid(fields[2]):
            return Err("E-SFFI-005: malformed evidence symbol row")
        val canonical_row = fields[1] + "\t" + fields[2]
        if signatures.contains(fields[1]) or (previous != "" and canonical_row <= previous):
            return Err("E-SFFI-019: evidence symbols must be sorted and unique")
        signatures[fields[1]] = fields[2]
        previous = canonical_row
        index = index + 1

    Ok(SffiAdmissionReceiptV1(
        provider_id: provider_result!,
        target: target_result!,
        signer_key_id: signer_result!,
        artifact_sha256: artifact_result!,
        abi_registry_sha256: abi_result!,
        signed_manifest_sha256: sha256_u8_hex(text_to_bytes(content)),
        verification_report_sha256: report_result!,
        source_signatures: signatures,
    ))

# Verify the exact canonical evidence-v2 bytes against one caller-authorized
# trust root. This is admission-time work only; the returned token is retained
# beside cached slots and never re-verifies on a foreign call.
fn verify_sffi_evidence_v2(
    content: text,
    signature: [u8],
    trust_roots: [SffiAdmissionTrustRootV1],
) -> Result<SignatureVerifiedSffiAdmissionV1, text>:
    if signature.len() != 64:
        return Err("E-SFFI-005: Ed25519 SFFI signature must contain 64 bytes")
    if trust_roots.len() == 0 or trust_roots.len() > SFFI_ADMISSION_MAX_TRUST_ROOTS:
        return Err("E-SFFI-005: SFFI trust-root set must contain 1..64 keys")
    val receipt = match parse_sffi_evidence_v2(content):
        case Ok(value): value
        case Err(error): return Err(error)

    var trusted_key: [u8] = []
    var found = false
    var seen_key_ids: {text: bool} = {}
    var index = 0
    while index < trust_roots.len():
        val root = trust_roots[index]
        if root.key_id == "" or root.public_key.len() != 32:
            return Err("E-SFFI-005: malformed SFFI trust root")
        if seen_key_ids.contains(root.key_id):
            return Err("E-SFFI-005: duplicate SFFI trust-root key id")
        seen_key_ids[root.key_id] = true
        if root.key_id == receipt.signer_key_id:
            trusted_key = root.public_key
            found = true
        index = index + 1
    if not found:
        return Err("E-SFFI-005: SFFI signer key is not trusted")
    if not pure_ed25519_verify(trusted_key, text_to_bytes(content), signature):
        return Err("E-SFFI-005: SFFI admission signature verification failed")
    Ok(SignatureVerifiedSffiAdmissionV1(receipt: receipt))
