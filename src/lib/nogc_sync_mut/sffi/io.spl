# --- File Locking ---

@unsafe(reason: "acquires an OS-owned file descriptor that must be released exactly once", capabilities: [ffi])
extern fn rt_file_lock(path: text, timeout_secs: i64) -> i64

@unsafe(reason: "consumes a raw OS file-lock descriptor", capabilities: [ffi])
extern fn rt_file_unlock(fd: i64) -> bool

@unsafe(reason: "raw OS file-lock descriptor requires exactly-once release", capabilities: [ffi])
@always_inline
fn file_lock_raw(path: text, timeout_secs: i64) -> i64:
    var handle: i64 = -1
    unsafe(capabilities: [ffi]):
        handle = rt_file_lock(path, timeout_secs)
    handle

@unsafe(reason: "raw OS file-lock descriptor ownership is caller-provided", capabilities: [ffi])
@always_inline
fn file_unlock_raw(handle: i64) -> bool:
    var released = false
    unsafe(capabilities: [ffi]):
        released = rt_file_unlock(handle)
    released

# File lock resource wrapper with double-close guard
class SffiFileLock:
    handle: i64

impl SffiFileLock:
    fn is_valid() -> bool:
        self.handle != -1

    fn close():
        # Consuming drop: one-shot guard against double-close
        if self.handle != -1:
            unsafe(capabilities: [ffi]):
                file_unlock_raw(self.handle)
            self.handle = -1

# Acquire a file lock. Returns nil on timeout or error.
fn file_lock_acquire(path: text, timeout_secs: i64) -> SffiFileLock?:
    val h = unsafe(capabilities: [ffi]):
        file_lock_raw(path, timeout_secs)
    if h == -1:
        nil
    else:
        SffiFileLock(handle: h)

# Deprecated: use file_lock_acquire() + .close() instead
@unsafe(reason: "returns a raw OS file-lock descriptor with caller-owned release", capabilities: [ffi])
fn file_lock(path: text, timeout_secs: i64) -> i64:
    file_lock_raw(path, timeout_secs)

# Deprecated: use SffiFileLock.close() instead
@unsafe(reason: "consumes a caller-owned raw OS file-lock descriptor", capabilities: [ffi])
fn file_unlock(fd: i64) -> bool:
    file_unlock_raw(fd)

# --- Memory-Mapped Files ---

@unsafe(reason: "raw filesystem mmap-backed read and runtime-owned text ABI; empty text is ambiguous", capabilities: [ffi])
extern fn rt_file_mmap_read_text(path: text) -> text

@unsafe(reason: "raw runtime-owned text or array result has no represented failure/ownership state", capabilities: [ffi])
@always_inline
fn file_mmap_read_text(path: text) -> text:
    rt_file_mmap_read_text(path)

@unsafe(reason: "raw nullable mmap byte-array ABI; nil means mapping or read failure", capabilities: [ffi])
extern fn rt_file_mmap_read_bytes(path: text) -> [i64]?

# `rt_file_mmap_read_bytes` delegates to rt_file_read_bytes, which yields nil
# on any fs::read error. Preserve that state as Result.Err; a valid empty
# mapping remains Ok([]), without an extra existence probe or second read.
@always_inline
fn file_mmap_read_bytes(path: text) -> Result<[i64], text>:
    var bytes: [i64]? = nil
    unsafe(capabilities: [ffi]):
        bytes = rt_file_mmap_read_bytes(path)
    if bytes == nil:
        Err("file mmap read failed: {path}")
    else:
        Ok(bytes ?? [])

