# SFFI - I/O Operations
# Centralized file, directory, and path SFFI wrappers

# ============================================================================
# File Operations
# ============================================================================

# --- File Existence and Metadata ---

@unsafe(reason: "raw filesystem path existence ABI", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool

@always_inline
fn file_exists(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_file_exists(path)

@unsafe(reason: "raw filesystem path size ABI; negative return is failure", capabilities: [ffi])
extern fn rt_file_size(path: text) -> i64

@always_inline
fn file_size(path: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_file_size(path)

@unsafe(reason: "raw filesystem path modified-state ABI", capabilities: [ffi])
extern fn rt_file_modified(path: text) -> i64

@always_inline
fn file_modified(path: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_file_modified(path)

@unsafe(reason: "raw filesystem path modification-time ABI; negative return is failure", capabilities: [ffi])
extern fn rt_file_modified_time(path: text) -> i64

@always_inline
fn file_modified_time(path: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_file_modified_time(path)

# --- File Reading ---

@unsafe(reason: "raw filesystem path and runtime-owned text ABI; empty text is ambiguous", capabilities: [ffi])
extern fn rt_file_read_text_rv(path: text) -> text

@unsafe(reason: "raw nullable text-read ABI; nil means read failure, distinct from an empty file", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text

@always_inline
fn file_read_text_nilable(path: text) -> text:
    unsafe(capabilities: [ffi]):
        rt_file_read_text(path)

@unsafe(reason: "raw runtime-owned text or array result has no represented failure/ownership state", capabilities: [ffi])
@always_inline
fn file_read_text(path: text) -> text:
    unsafe(capabilities: [ffi]):
        rt_file_read_text_rv(path)

@unsafe(reason: "raw runtime-owned text or array result has no represented failure/ownership state", capabilities: [ffi])
@always_inline
fn file_read(path: text) -> text:
    unsafe(capabilities: [ffi]):
        rt_file_read_text_rv(path)

# file_read_bytes is defined once in std.io_runtime; re-exported here so the
# four historical copies cannot drift apart again.
use std.io_runtime.{file_read_bytes}
export file_read_bytes

@unsafe(reason: "raw nullable line-array ABI; nil means the provider could not read the file", capabilities: [ffi])
extern fn rt_file_read_lines(path: text) -> [text]?

@always_inline
fn file_read_lines(path: text) -> Result<[text], text>:
    var lines: [text]? = nil
    unsafe(capabilities: [ffi]):
        lines = rt_file_read_lines(path)
    if lines == nil:
        Err("file line read failed: {path}")
    else:
        Ok(lines ?? [])

