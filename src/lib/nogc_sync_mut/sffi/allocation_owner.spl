# Observation of the selected allocator's existing ownership decision.
# A missing provider remains an extern error; zero is never a backfill.
pub enum AllocationOwnerDomainV1:
    Process
    Session
    Transient

pub struct AllocationOwnerIdentityV1:
    domain: AllocationOwnerDomainV1
    incarnation: i64

@unsafe(reason: "ownership: observational allocation domain and incarnation; zero sentinel is process ownership, no lease granted", capabilities: [ffi])
extern fn rt_allocation_owner_identity_v1() -> i64

fn allocation_owner_encoded_v1() -> i64:
    unsafe(capabilities: [ffi]):
        rt_allocation_owner_identity_v1()

pub fn allocation_owner_identity_v1() -> Result<AllocationOwnerIdentityV1, text>:
    val encoded = allocation_owner_encoded_v1()
    if encoded > 4294967295 or encoded < -4294967295:
        return Err("selected allocator returned an invalid ownership identity")
    if encoded == 0:
        return Ok(AllocationOwnerIdentityV1(domain: AllocationOwnerDomainV1.Process, incarnation: 0))
    if encoded < 0:
        return Ok(AllocationOwnerIdentityV1(domain: AllocationOwnerDomainV1.Session, incarnation: -encoded))
    Ok(AllocationOwnerIdentityV1(domain: AllocationOwnerDomainV1.Transient, incarnation: encoded))
