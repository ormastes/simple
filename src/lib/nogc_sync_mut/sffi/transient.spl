# Scoped scratch allocation boundary. Pause before promoting the small result;
# end releases every unpromoted allocation made in this scope.
@unsafe(reason: "begin bounded native scratch allocation scope", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool
@unsafe(reason: "pause scratch allocation before result promotion", capabilities: [ffi])
extern fn rt_transient_array_scope_pause() -> bool
@unsafe(reason: "release unpromoted scratch allocations", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool
@unsafe(reason: "retain a managed result across scratch scope release", capabilities: [ffi])
extern fn rt_transient_heap_promote<T>(value: T) -> bool
# Build session heap (BSM T1, doc/05_design/compiler/memory/
# build_session_memory_model_v1.md §4): one live session per thread; module
# scopes nest inside it; adopt-then-publish under the session allocator.
@unsafe(reason: "begin the build session heap", capabilities: [ffi])
extern fn rt_session_heap_begin() -> u32
@unsafe(reason: "release every session-owned allocation in one sweep", capabilities: [ffi])
extern fn rt_session_heap_end(session: u32) -> bool
@unsafe(reason: "allocate session-owned containers inside a module scope", capabilities: [ffi])
extern fn rt_session_alloc_begin() -> bool
@unsafe(reason: "end session-owned allocation", capabilities: [ffi])
extern fn rt_session_alloc_end() -> bool
@unsafe(reason: "move a module-scope graph into the build session", capabilities: [ffi])
extern fn rt_transient_heap_adopt<T>(value: T) -> bool
@unsafe(reason: "observe the live build session id", capabilities: [ffi])
extern fn rt_session_heap_id() -> u32

fn transient_scope_begin() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_begin()

fn transient_scope_pause() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_pause()

fn transient_scope_end() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_end()

fn transient_promote<T>(value: T) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)
