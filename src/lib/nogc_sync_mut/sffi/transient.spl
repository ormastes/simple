# Scoped scratch allocation boundary. Pause before promoting the small result;
# end releases every unpromoted allocation made in this scope.
@unsafe(reason: "begin bounded native scratch allocation scope", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool
@unsafe(reason: "pause scratch allocation before result promotion", capabilities: [ffi])
extern fn rt_transient_array_scope_pause() -> bool
@unsafe(reason: "release unpromoted scratch allocations", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool
@unsafe(reason: "retain a managed result across scratch scope release", capabilities: [ffi])
extern fn rt_transient_heap_promote<T>(value: T) -> bool

fn transient_scope_begin() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_begin()

fn transient_scope_pause() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_pause()

fn transient_scope_end() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_end()

# `mut`: promotion retags the caller's root in place; a plain value-struct
# parameter would be copied first and only the copy promoted. See
# doc/08_tracking/bug/transient_promote_struct_param_copy_dangles_2026-10-25.md
fn transient_promote<T>(mut value: T) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)
