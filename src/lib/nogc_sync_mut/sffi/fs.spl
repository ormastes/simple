@unsafe(reason: "raw memory-map ABI; the returned address is an unvalidated provider handle, 0 on failure", capabilities: [ffi, raw_ptr])
extern fn rt_mmap(path: text, size: i64, offset: i64, readonly: i64) -> i64

@always_inline
fn file_mmap_raw(path: text, size: i64, offset: i64, readonly: i64) -> i64:
    """Map `size` bytes of `path` at `offset`; runtime-owned bounds contract, 0 on any failure."""
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmap(path, size, offset, readonly)

