@unsafe(reason: "raw runtime ABI for rt_fd_pread", capabilities: [ffi])
extern fn rt_fd_pread(fd: i32, buffer: i64, len: i64, offset: i64) -> i64

@always_inline
fn file_pread_fd(fd: i32, buffer: i64, len: i64, offset: i64) -> i64:
    """Exact pread(2) into a caller-owned buffer address: bytes read, or -errno."""
    unsafe(capabilities: [ffi]):
        rt_fd_pread(fd, buffer, len, offset)

