# Process-scoped, opt-in collection observation channel. The runtime owns only
# bounded in-memory events; app.optimize owns .sprof validation and file I/O.
# These C-only SFFI endpoints use spl_; rt_ names require both runtime lanes.

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_begin(target: text) -> i64

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_note_size(site: text, target: text, size: i64) -> i64

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_note_lookup(site: text, target: text, found: i64) -> i64

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_note_materialization(site: text, target: text) -> i64

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_note_hash_probe(site: text, target: text, probes: i64, collisions: i64) -> i64

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_finish() -> text?

@unsafe(reason: "process-scoped collection capture ABI", capabilities: [ffi])
extern fn spl_collection_capture_abort() -> i64

fn collection_capture_begin(target: text) -> bool:
    unsafe(capabilities: [ffi]):
        spl_collection_capture_begin(target) == 1

fn collection_capture_note_size(site: text, target: text, size: i64) -> bool:
    unsafe(capabilities: [ffi]):
        spl_collection_capture_note_size(site, target, size) == 1

fn collection_capture_note_lookup(site: text, target: text, found: bool) -> bool:
    val hit = if found: 1 else: 0
    unsafe(capabilities: [ffi]):
        spl_collection_capture_note_lookup(site, target, hit) == 1

fn collection_capture_note_materialization(site: text, target: text) -> bool:
    unsafe(capabilities: [ffi]):
        spl_collection_capture_note_materialization(site, target) == 1

fn collection_capture_note_hash_probe(site: text, target: text, probes: i64, collisions: i64) -> bool:
    unsafe(capabilities: [ffi]):
        spl_collection_capture_note_hash_probe(site, target, probes, collisions) == 1

fn collection_capture_finish() -> text?:
    unsafe(capabilities: [ffi]):
        spl_collection_capture_finish()

fn collection_capture_abort():
    unsafe(capabilities: [ffi]):
        spl_collection_capture_abort()

export collection_capture_begin, collection_capture_note_size
export collection_capture_note_lookup, collection_capture_finish, collection_capture_abort
export collection_capture_note_materialization
export collection_capture_note_hash_probe
