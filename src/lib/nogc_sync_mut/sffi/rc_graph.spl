# Narrow object-graph ownership ABI. Keep compiler/session users independent
# of unrelated privileged, rendering and TLS primitives in the host facade.
@unsafe(reason: "raw runtime ABI for rt_rc_share", capabilities: [ffi])
extern fn rt_rc_share<T>(value: T) -> bool
@unsafe(reason: "raw runtime ABI for rt_rc_retain", capabilities: [ffi])
extern fn rt_rc_retain<T>(value: T) -> bool
@unsafe(reason: "raw runtime ABI for rt_rc_release", capabilities: [ffi])
extern fn rt_rc_release<T>(value: T) -> bool
@unsafe(reason: "raw runtime ABI for rt_rc_count", capabilities: [ffi])
extern fn rt_rc_count<T>(value: T) -> i64
@unsafe(reason: "raw runtime ABI for rt_heap_graph_bytes", capabilities: [ffi])
extern fn rt_heap_graph_bytes<T>(value: T) -> i64
