"""
# SDL2 window native ABI owner

This is the only Simple module that declares the runtime SDL2 window ABI.
Product modules import the allocation-free `sdl2_native_*` thunks below and
own all event, status, handle, and compatibility mapping in pure Simple.
"""

extern fn rt_sdl2_init() -> i64
extern fn rt_sdl2_quit()
extern fn rt_sdl2_create_window(title: text, width: i64, height: i64) -> i64
extern fn rt_sdl2_destroy_window(handle: i64)
extern fn rt_sdl2_get_window_width(handle: i64) -> i64
extern fn rt_sdl2_get_window_height(handle: i64) -> i64
extern fn rt_sdl2_set_window_title(handle: i64, title: text)
extern fn rt_sdl2_present_rgba(window_handle: i64, pixels: [i64], width: i64, height: i64) -> bool
extern fn rt_sdl2_poll_event() -> i64
extern fn rt_sdl2_wait_event(timeout_ms: i64) -> i64
extern fn rt_sdl2_event_key_code() -> i64
extern fn rt_sdl2_event_key_sym() -> i64
extern fn rt_sdl2_event_key_mod() -> i64
extern fn rt_sdl2_event_text() -> text
extern fn rt_sdl2_event_mouse_x() -> i64
extern fn rt_sdl2_event_mouse_y() -> i64
extern fn rt_sdl2_event_mouse_button() -> i64
extern fn rt_sdl2_event_wheel_x() -> i64
extern fn rt_sdl2_event_wheel_y() -> i64
extern fn rt_sdl2_is_key_pressed(scancode: i64) -> i64
extern fn rt_sdl2_get_mouse_x() -> i64
extern fn rt_sdl2_get_mouse_y() -> i64
extern fn rt_sdl2_is_mouse_button_pressed(button: i64) -> i64
extern fn rt_sdl2_get_ticks_ms() -> i64
extern fn rt_sdl2_get_ticks_ns() -> i64
extern fn rt_sdl2_window_should_close() -> i64
extern fn rt_sdl2_clear_quit()
extern fn rt_sdl2_event_window_event_id() -> i64
extern fn rt_sdl2_event_window_data1() -> i64
extern fn rt_sdl2_event_window_data2() -> i64
extern fn rt_sdl2_set_window_resizable(handle: i64, resizable: i64)
extern fn rt_sdl2_set_window_fullscreen(handle: i64, fullscreen: i64)
extern fn rt_sdl2_set_window_fullscreen_checked(handle: i64, fullscreen: i64) -> i64
extern fn rt_sdl2_set_window_size(handle: i64, width: i64, height: i64)
extern fn rt_sdl2_set_window_position(handle: i64, x: i64, y: i64)
extern fn rt_sdl2_get_window_position_x(handle: i64) -> i64
extern fn rt_sdl2_get_window_position_y(handle: i64) -> i64
extern fn rt_sdl2_show_window(handle: i64)
extern fn rt_sdl2_hide_window(handle: i64)
extern fn rt_sdl2_set_window_minimum_size(handle: i64, width: i64, height: i64) -> i64
extern fn rt_sdl2_set_window_maximum_size(handle: i64, width: i64, height: i64) -> i64
extern fn rt_sdl2_minimize_window(handle: i64) -> i64
extern fn rt_sdl2_maximize_window(handle: i64) -> i64
extern fn rt_sdl2_restore_window(handle: i64) -> i64
extern fn rt_sdl2_set_window_bordered(handle: i64, bordered: i64) -> i64
extern fn rt_sdl2_set_window_always_on_top(handle: i64, on_top: i64) -> i64
extern fn rt_sdl2_focus_window(handle: i64) -> i64
extern fn rt_sdl2_window_flags(handle: i64) -> i64
extern fn rt_sdl2_last_error() -> text
extern fn rt_sdl2_set_cursor_visible(visible: i64)
extern fn rt_sdl2_set_cursor_grab(handle: i64, grab: i64)
extern fn rt_sdl2_warp_mouse(handle: i64, x: i64, y: i64)
extern fn rt_sdl2_get_num_displays() -> i64
extern fn rt_sdl2_get_display_name(index: i64) -> text
extern fn rt_sdl2_get_display_bounds_x(index: i64) -> i64
extern fn rt_sdl2_get_display_bounds_y(index: i64) -> i64
extern fn rt_sdl2_get_display_bounds_w(index: i64) -> i64
extern fn rt_sdl2_get_display_bounds_h(index: i64) -> i64
extern fn rt_sdl2_get_display_dpi(index: i64) -> f64
extern fn rt_sdl2_get_display_usable_x(index: i64) -> i64
extern fn rt_sdl2_get_display_usable_y(index: i64) -> i64
extern fn rt_sdl2_get_display_usable_w(index: i64) -> i64
extern fn rt_sdl2_get_display_usable_h(index: i64) -> i64
extern fn rt_sdl2_clipboard_get() -> text
extern fn rt_sdl2_clipboard_set(content: text) -> bool
extern fn rt_sdl2_clipboard_has_text() -> bool

# Allocation-free native thunks keep runtime names inside this provider while
# retaining the exact argument, return, status, and handle representation.
fn sdl2_native_init() -> i64: rt_sdl2_init()
fn sdl2_native_quit(): rt_sdl2_quit()
fn sdl2_native_create_window(title: text, width: i64, height: i64) -> i64: rt_sdl2_create_window(title, width, height)
fn sdl2_native_destroy_window(handle: i64): rt_sdl2_destroy_window(handle)
fn sdl2_native_get_window_width(handle: i64) -> i64: rt_sdl2_get_window_width(handle)
fn sdl2_native_get_window_height(handle: i64) -> i64: rt_sdl2_get_window_height(handle)
fn sdl2_native_set_window_title(handle: i64, title: text): rt_sdl2_set_window_title(handle, title)
fn sdl2_native_present_rgba(window_handle: i64, pixels: [i64], width: i64, height: i64) -> bool: rt_sdl2_present_rgba(window_handle, pixels, width, height)
fn sdl2_native_poll_event() -> i64: rt_sdl2_poll_event()
fn sdl2_native_wait_event(timeout_ms: i64) -> i64: rt_sdl2_wait_event(timeout_ms)
fn sdl2_native_event_key_code() -> i64: rt_sdl2_event_key_code()
fn sdl2_native_event_key_sym() -> i64: rt_sdl2_event_key_sym()
fn sdl2_native_event_key_mod() -> i64: rt_sdl2_event_key_mod()
fn sdl2_native_event_text() -> text: rt_sdl2_event_text()
fn sdl2_native_event_mouse_x() -> i64: rt_sdl2_event_mouse_x()
fn sdl2_native_event_mouse_y() -> i64: rt_sdl2_event_mouse_y()
fn sdl2_native_event_mouse_button() -> i64: rt_sdl2_event_mouse_button()
fn sdl2_native_event_wheel_x() -> i64: rt_sdl2_event_wheel_x()
fn sdl2_native_event_wheel_y() -> i64: rt_sdl2_event_wheel_y()
fn sdl2_native_is_key_pressed(scancode: i64) -> i64: rt_sdl2_is_key_pressed(scancode)
fn sdl2_native_get_mouse_x() -> i64: rt_sdl2_get_mouse_x()
fn sdl2_native_get_mouse_y() -> i64: rt_sdl2_get_mouse_y()
fn sdl2_native_is_mouse_button_pressed(button: i64) -> i64: rt_sdl2_is_mouse_button_pressed(button)
fn sdl2_native_get_ticks_ms() -> i64: rt_sdl2_get_ticks_ms()
fn sdl2_native_get_ticks_ns() -> i64: rt_sdl2_get_ticks_ns()
fn sdl2_native_window_should_close() -> i64: rt_sdl2_window_should_close()
fn sdl2_native_clear_quit(): rt_sdl2_clear_quit()
fn sdl2_native_event_window_event_id() -> i64: rt_sdl2_event_window_event_id()
fn sdl2_native_event_window_data1() -> i64: rt_sdl2_event_window_data1()
fn sdl2_native_event_window_data2() -> i64: rt_sdl2_event_window_data2()
fn sdl2_native_set_window_resizable(handle: i64, resizable: i64): rt_sdl2_set_window_resizable(handle, resizable)
fn sdl2_native_set_window_fullscreen(handle: i64, fullscreen: i64): rt_sdl2_set_window_fullscreen(handle, fullscreen)
fn sdl2_native_set_window_fullscreen_checked(handle: i64, fullscreen: i64) -> i64: rt_sdl2_set_window_fullscreen_checked(handle, fullscreen)
fn sdl2_native_set_window_size(handle: i64, width: i64, height: i64): rt_sdl2_set_window_size(handle, width, height)
fn sdl2_native_set_window_position(handle: i64, x: i64, y: i64): rt_sdl2_set_window_position(handle, x, y)
fn sdl2_native_get_window_position_x(handle: i64) -> i64: rt_sdl2_get_window_position_x(handle)
fn sdl2_native_get_window_position_y(handle: i64) -> i64: rt_sdl2_get_window_position_y(handle)
fn sdl2_native_show_window(handle: i64): rt_sdl2_show_window(handle)
fn sdl2_native_hide_window(handle: i64): rt_sdl2_hide_window(handle)
fn sdl2_native_set_window_minimum_size(handle: i64, width: i64, height: i64) -> i64: rt_sdl2_set_window_minimum_size(handle, width, height)
fn sdl2_native_set_window_maximum_size(handle: i64, width: i64, height: i64) -> i64: rt_sdl2_set_window_maximum_size(handle, width, height)
fn sdl2_native_minimize_window(handle: i64) -> i64: rt_sdl2_minimize_window(handle)
fn sdl2_native_maximize_window(handle: i64) -> i64: rt_sdl2_maximize_window(handle)
fn sdl2_native_restore_window(handle: i64) -> i64: rt_sdl2_restore_window(handle)
fn sdl2_native_set_window_bordered(handle: i64, bordered: i64) -> i64: rt_sdl2_set_window_bordered(handle, bordered)
fn sdl2_native_set_window_always_on_top(handle: i64, on_top: i64) -> i64: rt_sdl2_set_window_always_on_top(handle, on_top)
fn sdl2_native_focus_window(handle: i64) -> i64: rt_sdl2_focus_window(handle)
fn sdl2_native_window_flags(handle: i64) -> i64: rt_sdl2_window_flags(handle)
fn sdl2_native_last_error() -> text: rt_sdl2_last_error()
fn sdl2_native_set_cursor_visible(visible: i64): rt_sdl2_set_cursor_visible(visible)
fn sdl2_native_set_cursor_grab(handle: i64, grab: i64): rt_sdl2_set_cursor_grab(handle, grab)
fn sdl2_native_warp_mouse(handle: i64, x: i64, y: i64): rt_sdl2_warp_mouse(handle, x, y)
fn sdl2_native_get_num_displays() -> i64: rt_sdl2_get_num_displays()
fn sdl2_native_get_display_name(index: i64) -> text: rt_sdl2_get_display_name(index)
fn sdl2_native_get_display_bounds_x(index: i64) -> i64: rt_sdl2_get_display_bounds_x(index)
fn sdl2_native_get_display_bounds_y(index: i64) -> i64: rt_sdl2_get_display_bounds_y(index)
fn sdl2_native_get_display_bounds_w(index: i64) -> i64: rt_sdl2_get_display_bounds_w(index)
fn sdl2_native_get_display_bounds_h(index: i64) -> i64: rt_sdl2_get_display_bounds_h(index)
fn sdl2_native_get_display_dpi(index: i64) -> f64: rt_sdl2_get_display_dpi(index)
fn sdl2_native_get_display_usable_x(index: i64) -> i64: rt_sdl2_get_display_usable_x(index)
fn sdl2_native_get_display_usable_y(index: i64) -> i64: rt_sdl2_get_display_usable_y(index)
fn sdl2_native_get_display_usable_w(index: i64) -> i64: rt_sdl2_get_display_usable_w(index)
fn sdl2_native_get_display_usable_h(index: i64) -> i64: rt_sdl2_get_display_usable_h(index)
fn sdl2_native_clipboard_get() -> text: rt_sdl2_clipboard_get()
fn sdl2_native_clipboard_set(content: text) -> bool: rt_sdl2_clipboard_set(content)
fn sdl2_native_clipboard_has_text() -> bool: rt_sdl2_clipboard_has_text()

