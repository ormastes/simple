# Native-only bounded capture ABI. The tuple provider already exists in both
# C and Rust runtimes and returns the native three-word result block.
# This is deliberately separate from the boxed interpreter process API.
use std.nogc_sync_mut.sffi.process_capture_text.{process_capture_text_data_v1}
@unsafe(reason: "borrowed command byte address retained for synchronous capture", capabilities: [ffi, raw_ptr])
extern fn rt_string_data(value: i64) -> i64
@unsafe(reason: "UTF8 byte extent for the retained command", capabilities: [ffi])
extern fn rt_string_len(value: i64) -> i64
@unsafe(reason: "copy the provider-owned UTF8 output into a Simple string", capabilities: [ffi, raw_ptr])
extern fn rt_string_new(bytes: i64, len: i64) -> text
@unsafe(reason: "read fields of the provider's three-word result block", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_read_i64(address: i64, offset: i64) -> i64
@unsafe(reason: "existing native bounded tuple provider takes explicit command pointer and length", capabilities: [ffi, raw_ptr])
extern fn rt_process_run_bounded_tuple(command_ptr: i64, command_len: i64, args: [text], timeout_ms: i64, max_output_bytes: i64) -> i64
@unsafe(reason: "existing native unbounded tuple provider takes explicit command pointer and length", capabilities: [ffi, raw_ptr])
extern fn rt_process_run_tuple(command_ptr: i64, command_len: i64, args: [text]) -> i64

fn process_capture_result(block: i64) -> (text, text, i64):
    if block == 0:
        return ("", "native process capture returned no result", -1)
    val stdout_handle = unsafe(capabilities: [ffi, raw_ptr]): rt_ptr_read_i64(block, 0)
    val stderr_handle = unsafe(capabilities: [ffi, raw_ptr]): rt_ptr_read_i64(block, 8)
    # The provider's third word is already an untagged signed status.
    val status = unsafe(capabilities: [ffi, raw_ptr]): rt_ptr_read_i64(block, 16)
    val stdout_data = unsafe(capabilities: [ffi, raw_ptr]): rt_string_data(stdout_handle)
    val stdout_len = unsafe(capabilities: [ffi]): rt_string_len(stdout_handle)
    val stderr_data = unsafe(capabilities: [ffi, raw_ptr]): rt_string_data(stderr_handle)
    val stderr_len = unsafe(capabilities: [ffi]): rt_string_len(stderr_handle)
    # Native process providers represent an empty output stream as nil.
    if (stdout_handle != 3 and stdout_len < 0) or (stderr_handle != 3 and stderr_len < 0) or (stdout_data == 0 and stdout_len > 0) or (stderr_data == 0 and stderr_len > 0):
        return ("", "native process capture returned invalid text", -1)
    var stdout_text = ""
    if stdout_len > 0:
        stdout_text = unsafe(capabilities: [ffi, raw_ptr]): rt_string_new(stdout_data, stdout_len)
    var stderr_text = ""
    if stderr_len > 0:
        stderr_text = unsafe(capabilities: [ffi, raw_ptr]): rt_string_new(stderr_data, stderr_len)
    (stdout_text, stderr_text, status)

# @workaround bug=phase2_bounded_process_text_abi_2026_10_27 reason=Preserve the existing unbounded native provider with explicit command pointer and UTF8 length instead of changing its capture or timeout policy
fn process_capture_unbounded_native(command: text, args: [text]) -> (text, text, i64):
    val retained_command = command + ""
    # Seed-produced bootstrap code currently leaves text.ptr() as unresolved
    # str.ptr (process_capture_text_ptr_dispatch_2026-10-29.md). Keep the
    # monomorphic text accessor separate from the returned i64 handle ABI.
    val pointer = process_capture_text_data_v1(retained_command)
    val length = retained_command.len()
    if pointer == 0 or length <= 0:
        return ("", "native unbounded capture command pointer or length is unavailable", -1)
    val block = unsafe(capabilities: [ffi, raw_ptr]):
        rt_process_run_tuple(pointer, length, args)
    process_capture_result(block)

# @workaround bug=phase2_bounded_process_text_abi_2026_10_27 reason=Split command data and UTF8 length explicitly through the existing bounded tuple provider until the deployed P2 text ABI is qualified
fn process_capture_bounded_native(command: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64):
    val retained_command = command + ""
    val pointer = process_capture_text_data_v1(retained_command)
    val length = retained_command.len()
    if pointer == 0 or length <= 0:
        return ("", "native bounded capture command pointer or length is unavailable", -1)
    val block = unsafe(capabilities: [ffi, raw_ptr]):
        rt_process_run_bounded_tuple(pointer, length, args, timeout_ms, max_output_bytes)
    process_capture_result(block)
