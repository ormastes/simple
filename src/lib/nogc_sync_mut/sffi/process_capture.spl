# Native-only bounded capture ABI. The tuple provider already exists in both
# C and Rust runtimes and returns the native three-word result block.
# This is deliberately separate from the boxed interpreter process API.
@unsafe(reason: "borrowed command byte address retained for synchronous capture", capabilities: [ffi, raw_ptr])
extern fn rt_string_data<T>(value: T) -> i64
@unsafe(reason: "UTF8 byte extent for the retained command", capabilities: [ffi])
extern fn rt_string_len<T>(value: T) -> i64
@unsafe(reason: "existing native bounded tuple provider takes explicit command pointer and length", capabilities: [ffi, raw_ptr])
extern fn rt_process_run_bounded_tuple(command_ptr: i64, command_len: i64, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64)

# @workaround bug=phase2_bounded_process_text_abi_2026_10_27 reason=Split command data and UTF8 length explicitly through the existing bounded tuple provider until the deployed P2 text ABI is qualified
fn process_capture_bounded_native(command: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64):
    val retained_command = command + ""
    val pointer = unsafe(capabilities: [ffi, raw_ptr]):
        rt_string_data(retained_command)
    val length = unsafe(capabilities: [ffi]):
        rt_string_len(retained_command)
    if pointer == 0 or length <= 0:
        return ("", "native bounded capture command pointer or length is unavailable", -1)
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_process_run_bounded_tuple(pointer, length, args, timeout_ms, max_output_bytes)
