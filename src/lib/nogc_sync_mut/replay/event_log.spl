# SReplay — Host-Side Event Log Reader/Writer
#
# Reads and writes trace files with SDN metadata header + binary events.
# Trace file layout:
#   manifest.sdn   — arch, pointer_width, endianness, event_count
#   events.bin     — concatenated 80-byte ReplayEntry records

use std.nogc_async_mut.sosix.host_facade.{
    sosix_dir_create_all, sosix_file_atomic_write,
    sosix_file_read_text_result, sosix_file_read_bytes_result, sosix_file_write_bytes
}
use std.nogc_sync_mut.replay.types.{Arch, Endian, TargetDesc}
use std.nogc_sync_mut.replay.codec.{encode_entries, decode_entries}
use std.nogc_sync_mut.replay.event_kinds.{ReplayEntry}

# ============================================================================
# Trace Header
# ============================================================================

struct TraceHeader:
    magic: text              # "SRPL"
    version: i32
    target: TargetDesc
    event_count: i64
    compiler_version: text
    git_commit: text

impl TraceHeader:
    static fn create(target: TargetDesc) -> TraceHeader:
        TraceHeader(
            magic: "SRPL",
            version: 1,
            target: target,
            event_count: 0,
            compiler_version: "",
            git_commit: ""
        )

    fn to_sdn() -> text:
        var lines: [text] = []
        lines.push("trace:")
        lines.push("  format: \"simple-replay-trace\"")
        lines.push("  version: {self.version}")
        lines.push("  magic: \"{self.magic}\"")
        lines.push("")
        lines.push("target:")
        lines.push("  arch: \"{self.target.arch.to_text()}\"")
        lines.push("  pointer_bits: {self.target.arch.pointer_bits()}")
        lines.push("  endian: \"{self.target.endian.to_text()}\"")
        lines.push("  page_size: {self.target.page_size}")
        lines.push("  register_schema: \"{self.target.register_schema_id}\"")
        lines.push("")
        lines.push("stats:")
        lines.push("  event_count: {self.event_count}")
        if self.compiler_version.len() > 0:
            lines.push("")
            lines.push("build:")
            lines.push("  compiler: \"{self.compiler_version}\"")
            lines.push("  git_commit: \"{self.git_commit}\"")
        lines.join("\n")

# ============================================================================
# Event Log
# ============================================================================

struct EventLog:
    header: TraceHeader
    entries: [ReplayEntry]

impl EventLog:
    static fn create(arch: Arch) -> EventLog:
        val target = TargetDesc.for_arch(arch)
        EventLog(
            header: TraceHeader.create(target),
            entries: []
        )

    me fn add_event(entry: ReplayEntry):
        self.entries.push(entry)
        self.header.event_count = self.entries.len()

    me fn add_events(entries: [ReplayEntry]):
        for entry in entries:
            self.entries.push(entry)
        self.header.event_count = self.entries.len()

# ============================================================================
# File I/O
# ============================================================================

fn write_event_log(dir_path: text, log: EventLog) -> Result<Nil, text>:
    if not sosix_dir_create_all(dir_path):
        return Err("failed to create trace directory: {dir_path}")

    # Write manifest.sdn
    val manifest_path = "{dir_path}/manifest.sdn"
    val sdn_content = log.header.to_sdn()
    if not sosix_file_atomic_write(manifest_path, sdn_content):
        return Err("failed to write manifest: {manifest_path}")

    # Write every buffer, including empty, so replacement always truncates.
    val events_path = "{dir_path}/events.bin"
    var bytes: [u8] = []
    for byte in encode_entries(log.entries):
        bytes.push(byte as u8)
    if not sosix_file_write_bytes(events_path, bytes):
        return Err("failed to write events: {events_path}")

    print "[sreplay] Wrote {log.header.event_count} events to {dir_path}/"
    Ok(nil)

fn read_event_log(dir_path: text) -> Result<EventLog, text>:
    val manifest_path = "{dir_path}/manifest.sdn"
    val events_path = "{dir_path}/events.bin"

    val manifest_content = sosix_file_read_text_result(manifest_path)?

    # Parse arch from manifest
    var arch = Arch.X86_64
    for line in manifest_content.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with("arch:"):
            val arch_str = trimmed.replace("arch:", "").trim().replace("\"", "")
            arch = Arch.from_text(arch_str)

    var log = EventLog.create(arch)

    # Strict reads distinguish an existing empty file from a failed read.
    val event_bytes = sosix_file_read_bytes_result(events_path)?
    var bytes: [i32] = []
    for byte in event_bytes:
        bytes.push(byte as i32)

    log.entries = decode_entries(bytes)
    log.header.event_count = log.entries.len()
    Ok(log)
