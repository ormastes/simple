"""
# Subscriptions / Recurring-Billing Vertical — lifecycle + recurring invoices

Lane W22-D of the Simple Enterprise Suite over the durable enterprise store:

    sub create (active) -> bill period 1 -> bill period 2 -> ...
                        \-> cancel

Every write runs the FROZEN guarded sequence (foundation.spl):

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

Effects committed together in the unit of work: the insert-only lifecycle /
invoice row, the outbox event, the sha256-chained audit record, and the
idempotency key — so a replayed command produces exactly one effect and a
rollback carries none (atomicity on ACID backends; see the store's
backend-honesty docstring).

## Storage model — insert-only + derive (immutable-ledger rule)

A subscription is an EVENT LOG, never an UPDATE:

- `sub_subscriptions`: one immutable row per subscription (plan, Money amount).
- `sub_events`: append-only lifecycle stream; the CURRENT status is a pure fold
  over this stream:  "" (unknown) -> active -> cancelled.
- `sub_invoices`: append-only immutable invoice per billed period; the invoiced
  total is a pure SUM fold over this stream. Each row is keyed by an explicit
  integer `period` (period 1, 2, 3 …) the CALLER passes — billing NEVER reads
  wall-clock time, so the ledger is fully deterministic.

Illegal lifecycle moves — billing or cancelling a subscription that is not
active, cancelling one already cancelled — are denied `invalid-transition` from
the closed reason set with NO effect. Re-billing an already-billed period is
denied `duplicate-key` (the period is the invoice's natural key). An unknown
subscription is denied `not-found`. No new reason is introduced.

## RBAC — reused `sales` role via a LOCAL gate (no frozen-table edit)

`foundation.role_allows` is FROZEN and says nothing about `sub.*`. Rather than
mutate the frozen table or the equivalence-fenced `enterprise_sale.rbac_registry`,
this module REUSES the existing `sales` role through a local `sub_role_allows`
gate for its three `sub.*` actions. The frozen SEQUENCE is preserved exactly;
only the role→action policy for subscriptions lives here.

sha256 audit is taken only via the enterprise_store facade
(`records.audit_append` -> `audit_hash.audit_sha256_hex`); this module never
imports `std.common.crypto.sha256` directly (cross-OS rule, one codebase).

Tenant isolation: the SESSION tenant is authority; every reader filters by
tenant in pure Simple and a payload tenant is never trusted.
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, Money,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema
# =============================================================================

fn sub_setup(store: EnterpriseStore) -> bool:
    var ok = store_migrate(store, "sub_001_subscriptions",
        "CREATE TABLE IF NOT EXISTS sub_subscriptions (id INTEGER PRIMARY KEY, tenant_id TEXT, sub_id TEXT, plan TEXT, amount_cents TEXT)")
    ok = ok and store_migrate(store, "sub_002_events",
        "CREATE TABLE IF NOT EXISTS sub_events (id INTEGER PRIMARY KEY, tenant_id TEXT, sub_id TEXT, event TEXT, detail TEXT)")
    ok = ok and store_migrate(store, "sub_003_invoices",
        "CREATE TABLE IF NOT EXISTS sub_invoices (id INTEGER PRIMARY KEY, tenant_id TEXT, sub_id TEXT, period TEXT, amount_cents TEXT)")
    ok

# =============================================================================
# RBAC — reused 'sales' role via a local gate (see module docstring)
# =============================================================================

fn sub_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "sales":
        return action == "sub.create" or action == "sub.bill" or action == "sub.cancel"
    false

# =============================================================================
# Derived reads — current state is a pure fold over insert-only history
# =============================================================================

# sub_status folds the lifecycle stream to the subscription's current status:
# "" (unknown) -> active -> cancelled.
fn sub_status(store: EnterpriseStore, tenant_id: text, sub_id: text) -> text:
    var status = ""
    val rows = store_rows(store, "sub_events", "id, tenant_id, sub_id, event, detail")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sub_id") == sub_id:
            status = sqlite_row_get(row, "event")
    status

# sub_plan_amount reads the subscription's Money amount in minor units
# (-1 when the subscription does not exist for this tenant).
fn sub_plan_amount(store: EnterpriseStore, tenant_id: text, sub_id: text) -> i64:
    val rows = store_rows(store, "sub_subscriptions", "id, tenant_id, sub_id, plan, amount_cents")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sub_id") == sub_id:
            return int(sqlite_row_get(row, "amount_cents"))
    -1

# sub_period_billed reports whether an invoice already exists for a period.
fn sub_period_billed(store: EnterpriseStore, tenant_id: text, sub_id: text, period: i64) -> bool:
    val rows = store_rows(store, "sub_invoices", "id, tenant_id, sub_id, period, amount_cents")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sub_id") == sub_id:
            if int(sqlite_row_get(row, "period")) == period:
                return true
    false

# sub_invoiced_total sums every invoice raised for a subscription (0 when none)
# — a pure SUM fold over the insert-only invoice stream, tenant-scoped.
fn sub_invoiced_total(store: EnterpriseStore, tenant_id: text, sub_id: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "sub_invoices", "id, tenant_id, sub_id, period, amount_cents")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sub_id") == sub_id:
            total = total + int(sqlite_row_get(row, "amount_cents"))
    total

# =============================================================================
# Guarded commands — frozen sequence over the durable store
# =============================================================================

# sub_create records a new subscription at status "active". Replaying the same
# idempotency key returns the recorded result WITHOUT a second effect.
fn sub_create(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, sub_id: text, plan: text, amount: Money) -> CommandResult:
    # 1. session
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sub_id)
    # 2. rbac
    if not sub_role_allows(who.role, "sub.create"):
        return denied("forbidden", sub_id)
    # 3. domain validation (state-independent identity/shape checks)
    if sub_id == "" or plan == "" or amount.amount_cents <= 0 or amount.currency == "":
        return denied("invalid-record", sub_id)
    # 4. idempotency — a replay returns the recorded outcome, no new effect.
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and sub_status(store, tenant.tenant_id, sub_id) != "":
        return denied("invalid-record", sub_id)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # 5. effects — one unit of work
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO sub_subscriptions (tenant_id, sub_id, plan, amount_cents) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, sub_id, plan, "{amount.amount_cents}"])
    store_insert_row(store,
        "INSERT INTO sub_events (tenant_id, sub_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, sub_id, "active", plan + ":{amount.amount_cents}"])
    outbox_append(store, tenant.tenant_id, "subscription.created", sub_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "subscription.create", sub_id + ":{amount.amount_cents}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, sub_id)
    uow_commit(store)
    accepted(sub_id)

# sub_bill emits an immutable invoice for `period` at the subscription's plan
# amount. An unknown subscription is denied not-found (state-independent). A
# subscription that is not active is denied invalid-transition. A period that
# was already billed is denied duplicate-key (the period is the invoice's
# natural key). The active check is state-DEPENDENT only on lifecycle, but the
# per-period key is exact, so a replay of the SAME command returns the recorded
# result while a fresh command against a billed period is denied duplicate-key.
fn sub_bill(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, sub_id: text, period: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sub_id)
    if not sub_role_allows(who.role, "sub.bill"):
        return denied("forbidden", sub_id)
    val cur = sub_status(store, tenant.tenant_id, sub_id)
    # Unknown subscription is state-independent.
    if cur == "":
        return denied("not-found", sub_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    # Billing requires an active subscription — illegal lifecycle move.
    if cur != "active":
        return denied("invalid-transition", sub_id + ":" + cur)
    # The period is the invoice's natural key — re-billing it is a duplicate.
    if sub_period_billed(store, tenant.tenant_id, sub_id, period):
        return denied("duplicate-key", sub_id + ":period={period}")
    val amount = sub_plan_amount(store, tenant.tenant_id, sub_id)
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO sub_invoices (tenant_id, sub_id, period, amount_cents) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, sub_id, "{period}", "{amount}"])
    store_insert_row(store,
        "INSERT INTO sub_events (tenant_id, sub_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, sub_id, "active", "billed:period={period}:{amount}"])
    outbox_append(store, tenant.tenant_id, "subscription.billed", sub_id + ":{period}")
    audit_append(store, tenant.tenant_id, who.actor_id, "subscription.bill", sub_id + ":period={period}:{amount}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, sub_id + ":{period}")
    uow_commit(store)
    accepted(sub_id + ":{period}")

# sub_cancel cancels an ACTIVE subscription (active -> cancelled). An unknown
# subscription is denied not-found; cancelling one already cancelled is denied
# invalid-transition. The transition is state-DEPENDENT on this command's own
# effect, so it is asked only of a command not already recorded.
fn sub_cancel(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, sub_id: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sub_id)
    if not sub_role_allows(who.role, "sub.cancel"):
        return denied("forbidden", sub_id)
    val cur = sub_status(store, tenant.tenant_id, sub_id)
    # Unknown subscription is state-independent.
    if cur == "":
        return denied("not-found", sub_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and cur != "active":
        return denied("invalid-transition", sub_id + ":" + cur)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO sub_events (tenant_id, sub_id, event, detail) VALUES (?, ?, ?, ?)",
        [tenant.tenant_id, sub_id, "cancelled", ""])
    outbox_append(store, tenant.tenant_id, "subscription.cancelled", sub_id)
    audit_append(store, tenant.tenant_id, who.actor_id, "subscription.cancel", sub_id)
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, sub_id)
    uow_commit(store)
    accepted(sub_id)

export sub_setup, sub_role_allows
export sub_status, sub_plan_amount, sub_period_billed, sub_invoiced_total
export sub_create, sub_bill, sub_cancel
