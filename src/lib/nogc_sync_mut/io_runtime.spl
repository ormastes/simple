# I/O Runtime Module - Direct extern fn wrappers for common I/O operations
#
# This module provides reusable I/O functions using direct `extern fn rt_*`
# calls. It works around the broken `use app.io.{...}` module import issue
# by declaring the extern functions directly.
#
# Usage:
#   use std.io_runtime.{shell, file_write, file_read, file_exists, ...}
#
# This replaces the pattern of duplicating extern fn declarations in every
# test file and compiler module that needs I/O.


# ============================================================================
# Extern Function Declarations (runtime built-ins)
# ============================================================================

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
@unsafe(reason: "raw owned-child spawn; positive PID is success and -1 is the failure sentinel", capabilities: [ffi])
extern fn rt_process_spawn_async(cmd: text, args: [text]) -> i64
@unsafe(reason: "raw owned-child liveness status; false is the stopped, absent, or failure sentinel", capabilities: [ffi])
extern fn rt_process_is_running(pid: i64) -> bool
@unsafe(reason: "raw owned-child termination status; false is the invalid, absent, or failure sentinel", capabilities: [ffi])
extern fn rt_process_kill(pid: i64) -> bool
@unsafe(reason: "raw timed process capture; exit code -1 is the failure-or-timeout sentinel", capabilities: [ffi])
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

@unsafe(reason: "contains the raw process-capture ABI behind a validated result facade", capabilities: [ffi])
fn _io_runtime_process_run_raw(cmd: text, args: [text]) -> (text, text, i64):
    rt_process_run(cmd, args)

@unsafe(reason: "contains the raw owned-child spawn ABI behind a PID facade", capabilities: [ffi])
fn _io_runtime_process_spawn_async_raw(cmd: text, args: [text]) -> i64:
    rt_process_spawn_async(cmd, args)

@unsafe(reason: "contains the raw owned-child liveness ABI behind a boolean facade", capabilities: [ffi])
fn _io_runtime_process_is_running_raw(pid: i64) -> bool:
    rt_process_is_running(pid)

@unsafe(reason: "contains the raw owned-child termination ABI behind PID validation", capabilities: [ffi])
fn _io_runtime_process_kill_raw(pid: i64) -> bool:
    rt_process_kill(pid)

@unsafe(reason: "contains the raw timed process-capture ABI behind a result facade", capabilities: [ffi])
fn _io_runtime_process_run_timeout_raw(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    rt_process_run_timeout(cmd, args, timeout_ms)

@unsafe(reason: "raw nullable file read; nil is the invalid, unreadable, or runtime-failure sentinel", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text?
@unsafe(reason: "raw file-write status; false sentinel means the provider did not complete the write", capabilities: [ffi])
extern fn rt_file_write_text(path: text, content: text) -> bool
@unsafe(reason: "raw file-existence predicate; false sentinel includes missing, inaccessible, or provider failure", capabilities: [ffi])
extern fn rt_file_exists(path: text) -> bool
@unsafe(reason: "raw file-delete status; false sentinel includes absence or provider failure", capabilities: [ffi])
extern fn rt_file_delete(path: text) -> bool
@unsafe(reason: "raw file-copy status; false conflates input, permission, I/O, and runtime failure", capabilities: [ffi])
extern fn rt_file_copy(src: text, dst: text) -> bool
@unsafe(reason: "raw nullable byte-array read; nil is invalid path, unreadable input, allocation, or runtime failure", capabilities: [ffi])
extern fn rt_file_read_bytes(path: text) -> [u8]?
@unsafe(reason: "raw append status; false conflates input, permission, I/O, and runtime failure", capabilities: [ffi])
extern fn rt_file_append_text(path: text, content: text) -> bool
@unsafe(reason: "raw file digest; non-64-byte text is the unreadable or provider-failure sentinel", capabilities: [ffi])
extern fn rt_file_hash_sha256(path: text) -> text
@unsafe(reason: "raw nullable environment lookup; wrapper normalizes absence", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?
@unsafe(reason: "raw nullable current-directory lookup; nil means getcwd failed", capabilities: [ffi])
extern fn rt_env_cwd() -> text?
@unsafe(reason: "raw environment mutation status; wrapper preserves exact boolean result", capabilities: [ffi])
extern fn rt_env_set(key: text, value_str: text) -> bool
@unsafe(reason: "raw process identifier provider; nonpositive result is invalid", capabilities: [ffi])
extern fn rt_getpid() -> i64
@unsafe(reason: "raw wall-clock provider; negative sentinel is failure", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64
@unsafe(reason: "raw directory-create status; false conflates invalid path, existence, permission, and runtime failure", capabilities: [ffi])
extern fn rt_dir_create(path: text, recursive: bool) -> bool
@unsafe(reason: "raw recursive-directory-create status; false sentinel means creation did not complete", capabilities: [ffi])
extern fn rt_dir_create_all(path: text) -> bool
@unsafe(reason: "raw file-size result; -1 conflates invalid path, absence, permission, and runtime failure", capabilities: [ffi])
extern fn rt_file_size(path: text) -> i64
# NOT rt_cli_arg_count/rt_cli_arg_at: those externs are unregistered on the
# deployed self-hosted binary (#159) and an unknown extern DECLARATION fails
# this whole module's load under the interpreter (any importer of
# std.io_runtime died with "unknown extern function"). sys_get_args() is
# registered on every lane (the CLI itself runs on it — see app.io.cli_ops).
@unsafe(reason: "raw runtime-owned argument array ABI; provider identity and array ownership are not admitted", capabilities: [ffi])
extern fn sys_get_args() -> [text]
@unsafe(reason: "raw non-returning process exit ABI; code width differs across native providers", capabilities: [ffi])
extern fn rt_exit(code: i64)
@unsafe(reason: "raw nullable directory listing; nil conflates invalid path, absence, permission, allocation, and runtime failure", capabilities: [ffi])
extern fn rt_dir_list(path: text) -> [text]?
@unsafe(reason: "raw recursive directory walk; empty conflates empty tree, invalid path, permission, and runtime failure", capabilities: [ffi])
extern fn rt_dir_walk(path: text) -> [text]
@unsafe(reason: "raw destructive directory removal; false conflates safety refusal, path, permission, I/O, and runtime failure", capabilities: [ffi])
extern fn rt_dir_remove(path: text, recursive: bool) -> bool
@unsafe(reason: "raw destructive recursive removal; provider-specific protected-path policy and false status are ambiguous", capabilities: [ffi])
extern fn rt_dir_remove_all(path: text) -> bool
@unsafe(reason: "raw byte-array file write; array extent/lifetime and false status require the provider contract", capabilities: [ffi])
extern fn rt_file_write_bytes(path: text, bytes: [u8]) -> bool
@unsafe(reason: "raw directory-existence predicate; false conflates absence, permission, invalid path, and runtime failure", capabilities: [ffi])
extern fn rt_dir_exists(path: text) -> bool
@unsafe(reason: "raw character-device predicate; false conflates other type, absence, permission, and runtime failure", capabilities: [ffi])
extern fn rt_file_is_char_device(path: text) -> bool
@unsafe(reason: "raw nullable runtime-owned platform text; provider identity is not admitted", capabilities: [ffi])
extern fn rt_platform_name() -> text?
@unsafe(reason: "raw blocking thread sleep; unit return has no fabricated value", capabilities: [ffi])
extern fn rt_thread_sleep(millis: i64)
extern fn rt_hash_text(s: text) -> i64
extern fn rt_time_now_monotonic_ms() -> i64
extern fn rt_shell_exec(cmd: text) -> text
extern fn rt_file_rename(old_path: text, new_path: text) -> bool
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

# ============================================================================
# Shell Result
# ============================================================================

struct ShellResult:
    stdout: text
    stderr: text
    exit_code: i64

# ============================================================================
# Shell Execution
# ============================================================================

pub fn shell(command: text) -> ProcessResult:
    val (stdout, stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    ProcessResult(stdout: stdout, stderr: stderr, exit_code: code, limit_exceeded: false, limit_type: "")

pub fn shell_output(command: text) -> text:
    val (stdout, _stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    if code == 0:
        stdout.trim()
    else:
        ""

pub fn shell_output_trimmed(command: text, default: text) -> text:
    val (stdout, _stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    if code == 0:
        val trimmed = stdout.trim()
        if trimmed == "":
            return default
        return trimmed
    default

pub fn shell_bool(command: text) -> bool:
    val (_stdout, _stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    code == 0

# ============================================================================
# File Operations
# ============================================================================

pub fn file_read(path: text) -> text:
    val content = file_read_raw(path)
    content ?? ""

fn file_write(path: text, content: text) -> bool:
    val (out, err, code) = rt_process_run("/bin/sh", ["-c", "cat > '{path}' << 'SIMPLE_WRITE_EOF'\n{content}\nSIMPLE_WRITE_EOF"])
    code == 0

pub fn read_file(path: text) -> text:
    file_read(path)

pub fn read_file_text(path: text) -> text:
    file_read(path)

pub fn file_write(path: text, content: text) -> bool:
    if file_write_raw(path, content):
        return true
    # Writing into a nonexistent directory otherwise no-ops silently
    # (bug interp_examples_dir_f64_zero_and_write_noop_2026-07-03):
    # create the missing parent directory and retry once.
    val sep_idx = path.rfind("/") ?? 0
    if sep_idx <= 0:
        return false
    val parent = path.substring(0, sep_idx)
    var parent_exists = false
    unsafe(capabilities: [ffi]):
        parent_exists = rt_file_exists(parent)
    if parent_exists:
        return false
    rt_dir_create_all(parent)
    file_write_raw(path, content)

pub fn file_write_raw(path: text, content: text) -> bool:
    rt_file_write_text(path, content)

pub fn write_file(path: text, content: text) -> bool:
    file_write(path, content)

pub fn file_exists(path: text) -> bool:
    rt_file_exists(path)

pub fn file_delete(path: text) -> bool:
    rt_file_delete(path)

pub fn remove_file_if_exists(path: text) -> bool:
    # Idempotent delete: true when the file was removed or did not exist.
    if not rt_file_exists(path):
        return true
    rt_file_delete(path)

pub fn file_copy(src: text, dst: text) -> bool:
    rt_file_copy(src, dst)

pub fn file_read_bytes(path: text) -> [u8]:
    rt_file_read_bytes(path) ?? []

pub fn file_write_bytes(path: text, bytes: [u8]) -> bool:
    rt_file_write_bytes(path, bytes)

pub fn file_hash_sha256(path: text) -> text:
    val hash = rt_file_hash_sha256(path)
    if hash.len() == 64:
        return hash
    shell_output("sha256sum '" + path + "' 2>/dev/null | awk '{print $1}'")

pub fn file_size(path: text) -> i64:
    val size = rt_file_size(path)
    if size < 0:
        return 0
    var trimmed = out.trim()
    if trimmed.len() == 0:
        return 0
    int(trimmed)

pub fn file_size_raw(path: text) -> i64:
    file_size(path)

# ============================================================================
# Process Execution
# ============================================================================

pub fn process_run(cmd: text, args: [text]) -> (text, text, i64):
    rt_process_run(cmd, args)

# ============================================================================
# Environment
# ============================================================================

pub fn env_get(key: text) -> text:
    val value = rt_env_get(key)
    if value == nil:
        ""
    else:
        value

pub fn env_set(key: text, value: text) -> bool:
    rt_env_set(key, value)

pub fn cwd() -> text:
    shell_output("pwd")

pub fn home() -> text:
    rt_env_get("HOME")

# ============================================================================
# System
# ============================================================================

pub fn getpid() -> i64:
    rt_getpid()

pub fn time_now_unix_micros() -> i64:
    rt_time_now_unix_micros()

pub fn get_args() -> [text]:
    sys_get_args() ?? []

pub fn cli_arg_count() -> i64:
    (sys_get_args() ?? []).len()

pub fn cli_arg_at(index: i64) -> text:
    val args = sys_get_args() ?? []
    if index >= 0 and index < args.len():
        return args[index]
    ""

pub fn exit(code: i64):
    rt_exit(code)

pub fn thread_sleep(ms: i64):
    unsafe(capabilities: [ffi]):
        rt_thread_sleep(ms)

# ============================================================================
# Directory Operations
# ============================================================================

pub fn dir_create(path: text, recursive: bool) -> bool:
    if recursive:
        unsafe(capabilities: [ffi]):
            rt_dir_create_all(path)
    else:
        rt_dir_create(path, false)

pub fn dir_create_all(path: text) -> bool:
    rt_dir_create_all(path)

pub fn mkdir_p(path: text) -> bool:
    unsafe(capabilities: [ffi]):
        rt_dir_create_all(path)

pub fn is_dir(path: text) -> bool:
    shell_bool("test -d '{path}'")

fn is_file(path: text) -> bool:
    shell_bool("test -f '{path}'")

## No-shell stat(2) probe for whether `path` is a character device (e.g. a
## DRM render node). Unlike `is_dir`/`is_file` above, this does NOT shell
## out — it calls `rt_file_is_char_device`, added specifically so callers
## like `os.compositor.vulkan_compositor_backend.detect_virtio_gpu_device()`
## don't need `/bin/sh` to be present (baremetal has none). See
## doc/08_tracking/bug/vulkan_detect_virtio_gpu_device_is_existence_check_not_device_probe_2026-08-07.md.
pub fn is_char_device(path: text) -> bool:
    unsafe:
        rt_file_is_char_device(path)

pub fn list_dir(path: text) -> [text]:
    val (stdout, _stderr, code) = rt_process_run("/bin/sh", ["-c", "ls '{path}'"])
    if code != 0:
        return []
    val trimmed = stdout.trim()
    if trimmed == "":
        return []
    trimmed.split("\n")

pub fn dir_list(path: text) -> [text]:
    unsafe(capabilities: [ffi]):
        rt_dir_list(path) ?? []

# Exact nullable result for recursive validators that must distinguish an
# empty directory from provider/read/allocation failure.
@always_inline
pub fn dir_list_optional(path: text) -> [text]?:
    unsafe:
        rt_dir_list(path)

pub fn dir_walk(path: text) -> [text]:
    rt_dir_walk(path)

pub fn dir_remove(path: text, recursive: bool) -> bool:
    if recursive:
        rt_dir_remove_all(path)
    else:
        rt_dir_remove(path, false)

pub fn dir_remove_all(path: text) -> bool:
    rt_dir_remove_all(path)

pub fn file_append_text(path: text, content: text) -> bool:
    rt_file_append_text(path, content)

pub fn dir_exists(path: text) -> bool:
    rt_dir_exists(path)

pub fn process_spawn_async(cmd: text, args: [text]) -> i64:
    rt_process_spawn_async(cmd, args)

pub fn process_is_running(pid: i64) -> bool:
    rt_process_is_running(pid)

pub fn process_kill(pid: i64) -> bool:
    if pid <= 1:
        return false
    rt_process_kill(pid)

# ============================================================================
# Platform Detection
# ============================================================================

pub fn host_os() -> text:
    val os = shell_output("uname -s")
    if os == "Linux":
        return "linux"
    if os == "Darwin":
        return "macos"
    if os == "FreeBSD":
        return "freebsd"
    os.lower()

pub fn platform_name() -> text:
    unsafe(capabilities: [ffi]):
        rt_platform_name() ?? "unknown"

pub fn time_now_monotonic_ms() -> i64:
    unsafe:
        rt_time_now_monotonic_ms()

pub fn shell_exec(cmd: text) -> text:
    unsafe:
        rt_shell_exec(cmd)

pub fn file_rename(old_path: text, new_path: text) -> bool:
    _io_runtime_file_rename_raw(old_path, new_path)

# Preserve the runtime move contract used by compiler caches: rename first,
# then copy+delete across filesystems. The unique semantic name also avoids the
# flattened-unit `file_rename` collision without adding dispatch or lookup.
pub fn file_move_cross_device(old_path: text, new_path: text) -> bool:
    unsafe:
        rt_file_move(old_path, new_path)

@always_inline
pub fn process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    _io_runtime_process_run_timeout_raw(cmd, args, timeout_ms)

@always_inline
pub fn hash_text(s: text) -> i64:
    unsafe:
        rt_hash_text(s)

pub fn host_arch() -> text:
    val arch = shell_output("uname -m")
    if arch == "x86_64" or arch == "amd64":
        return "x86_64"
    if arch == "aarch64" or arch == "arm64":
        return "aarch64"
    arch

# ============================================================================
# Exports
# ============================================================================

export shell, shell_output, shell_bool, shell_output_trimmed, ShellResult
export file_read, file_read_raw, read_file, read_file_text, file_write, file_write_raw, write_file, file_exists
export file_delete, file_copy, file_size, file_size_raw, file_hash_sha256
export file_read_bytes, file_write_bytes, file_append_text, remove_file_if_exists
export dir_create, dir_create_all, is_dir, is_file, is_char_device, list_dir, mkdir_p
export dir_list, dir_walk, dir_remove, dir_remove_all, dir_exists
export env_get, env_set, cwd, home, host_os, host_arch, platform_name, hash_text
export getpid, process_kill, process_run, process_run_bounded, process_spawn_async, process_is_running
export time_now_unix_micros, get_args, cli_arg_count, cli_arg_at, exit, thread_sleep
export time_now_monotonic_ms, shell_exec, file_rename, process_run_timeout
