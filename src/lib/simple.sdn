# Simple Standard Library Configuration
# Merged: former src/std/ and src/lib/ into unified src/lib/

project:
  name: simple-std
  version: 1.0.1-beta.1
  type: library
  language: Simple

  root: .
  source_dir: src
  test_dir: test

  dependencies:
    - project: ../../compiler_rust

# Allocatable mission-critical migration, STEP 1 (2026-08-28).
# In scope: common, nogc_sync_mut, nogc_async_mut, nogc_async_mut_noalloc,
# gc_async_mut. Everything else under src/lib is listed as an exception with a
# reason and is linted at `strict` until the user decides. Format:
# doc/07_guide/language/mission_critical_warning_phase_exceptions.md
lints:
  profile: critical
  warning_phase: true
  mc_exceptions: "src/lib/gc_sync_mut=outside step-1 family scope, src/lib/gc_sync_immut=outside step-1 family scope, src/lib/gc_async_immut=outside step-1 family scope, src/lib/nogc_sync_immut=outside step-1 family scope, src/lib/nogc_async_immut=outside step-1 family scope, src/lib/skia=vendored Skia binding surface, src/lib/js=JS interop glue, src/lib/web=web glue, src/lib/gui=GUI toolkit glue (WM lane), src/lib/scipy=numeric port, src/lib/viz=visualisation glue, src/lib/editor=editor app code, src/lib/blink=browser engine port, src/lib/hardware=hardware ISA databases, src/lib/gc_async_mut/gpu=GPU engine (device-memory allocation model differs), src/lib/gc_async_mut/cuda=CUDA binding surface, src/lib/gc_async_mut/torch=torch binding surface, src/lib/nogc_sync_mut/lsp=LSP server app code, src/lib/nogc_async_mut/lsp=LSP server app code, src/lib/gc_async_mut/lsp=LSP server app code, src/lib/gc_async_mut/gpu_lane=CUDA/Metal GPU lane session SFFI boundary (event/context/kernel-launch externs; bare i64 params in detail formatting) -- rt_time_now_nanos in cuda_native_profile.spl fixed to std.nogc_sync_mut.src.time.now_nanos (L6 rework), src/lib/gc_async_mut/engine/audio=CUDA audio driver SFFI extern (rt_string_data) plus Q15 fixed-point packed-buffer codec API (bare i64 pointer/count params) -- audited per-file; zero wildcard/unsafe hits, src/lib/nogc_async_mut/gpu/vulkan_dispatch.spl=Vulkan ICD dispatch SFFI boundary (opaque handle/format primitive_api params), src/lib/nogc_async_mut/gpu/vulkan_icd_sffi.spl=Vulkan ICD SFFI boundary (opaque handle/format primitive_api params), src/lib/nogc_async_mut/gpu/vulkan_icd_virtio.spl=Vulkan virtio-gpu ICD SFFI boundary (opaque handle/format primitive_api params), src/lib/nogc_async_mut/gpu/vulkan_loader.spl=Vulkan loader SFFI boundary (opaque handle primitive_api params), src/lib/nogc_async_mut/gpu/dxvk_d3d9.spl=D3D9-over-Vulkan translation layer SFFI (COM handle/enum bare-primitive params), src/lib/nogc_async_mut/gpu/dxvk_d3d10.spl=D3D10-over-Vulkan translation layer SFFI (COM handle/enum bare-primitive params), src/lib/nogc_async_mut/gpu/dxvk_d3d11.spl=D3D11-over-Vulkan translation layer SFFI (COM handle/enum bare-primitive params), src/lib/nogc_async_mut/io/platform_event.spl=platform event polling/marshalling raw_rt_access+raw_sffi (68 hits) -- no std.* semantic facade exists yet for the underlying poll/kqueue/epoll primitives, src/lib/nogc_async_mut/thread_pool.spl=OS thread pool scheduler SFFI plus i64-tag scheduling-event wildcard dispatch, src/lib/nogc_async_mut/thread_pool_state.spl=OS thread pool scheduler SFFI (worker/task state runtime calls), src/lib/nogc_async_mut/fs.spl=async filesystem driver SFFI (raw_rt_access+raw_sffi_declaration) -- no std.* semantic facade exists yet, src/lib/nogc_async_mut/fs_driver=mount/fat32/ramfs i64-tag driver dispatch tables -- matches L3's i64-tag driver-dispatch precedent, src/lib/nogc_async_mut/concurrent=green-thread worker-pool scheduler SFFI (rt_pool_submit/join/parallelism externs) and channel primitive_api (bare i64 capacity/counts) -- corrected reason: zero unsafe_pattern hits here; prior lock/semaphore justification was wrong (L6 rework), src/lib/nogc_async_mut/engine/physics/backend_gpu=CUDA physics solver SFFI (mem alloc/copy/kernel-launch externs) -- same class as gc_async_mut/cuda, src/lib/nogc_async_mut/quic=QUIC/H3 connection API bare i64 bind-port/config params (primitive_api only; zero wildcard/unsafe hits), src/lib/nogc_async_mut/http/h2=remaining primitive_api (h2_connection.spl/hpack_*.spl bare i64 stream-id/window params) and h2_parser.spl's H2BoundedParseResult match _ arm -- h2_stream.spl's 8 H2StreamState wildcards were FIXED with explicit arms in L6 rework; not excepted"

# GPU execution/debug defaults, read by
# src/lib/nogc_sync_mut/notebook/gpu_config.spl (load_project_gpu_config).
#
# These are what a BARE `gpu` tag expands to. A user writes no tag at all for
# host execution and just `gpu` (the `%gpu` cell magic, DAP `"gpu": true`,
# Lab API `{"gpu": true}`) to run or debug on the GPU — the verbose composite
# spec `interpreter(remote(cuda(sm80)))` is never required, only honoured
# verbatim when a power user writes one.
#
# Design: doc/05_design/app/tools/gpu_debugger_common_interface_architecture_2026-08-09.md §7b
gpu:
  backend: auto        # auto | cuda | vulkan | metal
  submode: interpreter # interpreter | jit
  arch: auto           # auto -> sm80 / spv15 / msl2 per backend default
