# Simple Standard Library Configuration
# Merged: former src/std/ and src/lib/ into unified src/lib/

project:
  name: simple-std
  version: 1.0.0-rc.1
  type: library
  language: Simple

  root: .
  source_dir: src
  test_dir: test

  dependencies:
    - project: ../../compiler_rust

# Allocatable mission-critical migration, STEP 1 (2026-08-28).
# In scope: common, nogc_sync_mut, nogc_async_mut, nogc_async_mut_noalloc,
# gc_async_mut. Everything else under src/lib is listed as an exception with a
# reason and is linted at `strict` until the user decides. Format:
# doc/07_guide/language/mission_critical_warning_phase_exceptions.md
lints:
  profile: critical
  warning_phase: true
  mc_exceptions: "src/lib/gc_sync_mut=outside step-1 family scope, src/lib/gc_sync_immut=outside step-1 family scope, src/lib/gc_async_immut=outside step-1 family scope, src/lib/nogc_sync_immut=outside step-1 family scope, src/lib/nogc_async_immut=outside step-1 family scope, src/lib/skia=vendored Skia binding surface, src/lib/js=JS interop glue, src/lib/web=web glue, src/lib/gui=GUI toolkit glue (WM lane), src/lib/scipy=numeric port, src/lib/viz=visualisation glue, src/lib/editor=editor app code, src/lib/blink=browser engine port, src/lib/hardware=hardware ISA databases, src/lib/gc_async_mut/gpu=GPU engine (device-memory allocation model differs), src/lib/gc_async_mut/cuda=CUDA binding surface, src/lib/gc_async_mut/torch=torch binding surface, src/lib/nogc_sync_mut/lsp=LSP server app code, src/lib/nogc_async_mut/lsp=LSP server app code, src/lib/gc_async_mut/lsp=LSP server app code"

# GPU execution/debug defaults, read by
# src/lib/nogc_sync_mut/notebook/gpu_config.spl (load_project_gpu_config).
#
# These are what a BARE `gpu` tag expands to. A user writes no tag at all for
# host execution and just `gpu` (the `%gpu` cell magic, DAP `"gpu": true`,
# Lab API `{"gpu": true}`) to run or debug on the GPU — the verbose composite
# spec `interpreter(remote(cuda(sm80)))` is never required, only honoured
# verbatim when a power user writes one.
#
# Design: doc/05_design/app/tools/gpu_debugger_common_interface_architecture_2026-08-09.md §7b
gpu:
  backend: auto        # auto | cuda | vulkan | metal
  submode: interpreter # interpreter | jit
  arch: auto           # auto -> sm80 / spv15 / msl2 per backend default
