# JS JSON Builtins
# JSON.parse and JSON.stringify for the Simple Browser JS engine.

use std.js.types.js_types.{JsValue, JsObject, JsProperty}

fn _json_skip_ws(source: text, pos: i64) -> i64:
    var i = pos
    while i < source.len():
        val ch = source.slice(i, i + 1)
        if ch == " " or ch == "\n" or ch == "\r" or ch == "\t":
            i = i + 1
        else:
            return i
    i

fn _json_string_end(source: text, pos: i64) -> i64:
    if pos >= source.len() or source.slice(pos, pos + 1) != "\"":
        return -1
    var i = pos + 1
    var escaped = false
    while i < source.len():
        val ch = source.slice(i, i + 1)
        if escaped:
            escaped = false
        else if ch == "\\":
            escaped = true
        else if ch == "\"":
            return i + 1
        i = i + 1
    -1

fn _json_number_end(source: text, pos: i64) -> i64:
    var i = pos
    while i < source.len():
        val ch = source.slice(i, i + 1)
        if (ch >= "0" and ch <= "9") or ch == "-" or ch == "+" or ch == "." or ch == "e" or ch == "E":
            i = i + 1
        else:
            break
    if i == pos:
        return -1
    val candidate = source.slice(pos, i)
    if candidate.parse_f64() == nil:
        return -1
    i

fn _json_value_end(source: text, pos_in: i64) -> i64:
    val pos = _json_skip_ws(source, pos_in)
    if pos >= source.len():
        return -1
    val ch = source.slice(pos, pos + 1)
    if ch == "\"":
        return _json_string_end(source, pos)
    if source.slice(pos, source.len()).starts_with("true"):
        return pos + 4
    if source.slice(pos, source.len()).starts_with("false"):
        return pos + 5
    if source.slice(pos, source.len()).starts_with("null"):
        return pos + 4
    if ch == "[":
        return _json_array_end(source, pos)
    if ch == "{":
        return _json_object_end(source, pos)
    _json_number_end(source, pos)

fn _json_array_end(source: text, pos: i64) -> i64:
    var i = _json_skip_ws(source, pos + 1)
    if i < source.len() and source.slice(i, i + 1) == "]":
        return i + 1
    while i < source.len():
        val value_end = _json_value_end(source, i)
        if value_end < 0:
            return -1
        i = _json_skip_ws(source, value_end)
        if i < source.len() and source.slice(i, i + 1) == "]":
            return i + 1
        if i >= source.len() or source.slice(i, i + 1) != ",":
            return -1
        i = _json_skip_ws(source, i + 1)
    -1

fn _json_object_end(source: text, pos: i64) -> i64:
    var i = _json_skip_ws(source, pos + 1)
    if i < source.len() and source.slice(i, i + 1) == "}":
        return i + 1
    while i < source.len():
        val key_end = _json_string_end(source, i)
        if key_end < 0:
            return -1
        i = _json_skip_ws(source, key_end)
        if i >= source.len() or source.slice(i, i + 1) != ":":
            return -1
        i = _json_skip_ws(source, i + 1)
        val value_end = _json_value_end(source, i)
        if value_end < 0:
            return -1
        i = _json_skip_ws(source, value_end)
        if i < source.len() and source.slice(i, i + 1) == "}":
            return i + 1
        if i >= source.len() or source.slice(i, i + 1) != ",":
            return -1
        i = _json_skip_ws(source, i + 1)
    -1

fn _json_hex_digit(c: text) -> i64:
    """Value of one hex digit character, or -1 if not a hex digit."""
    if c >= "0" and c <= "9":
        return c.char_code_at(0) - 48
    if c >= "a" and c <= "f":
        return c.char_code_at(0) - 87
    if c >= "A" and c <= "F":
        return c.char_code_at(0) - 55
    -1

fn _json_hex4(s: text, pos: i64) -> i64:
    """Parse exactly 4 hex digits at pos; -1 if short or invalid.

    No length guard needed: an out-of-range 1-unit slice is empty text,
    which is not a hex digit and yields -1 naturally.
    """
    var value = 0
    var k = 0
    while k < 4:
        val d = _json_hex_digit(s[pos + k:pos + k + 1])
        if d < 0:
            return -1
        value = value * 16 + d
        k = k + 1
    value

fn _json_decode_string(s: text) -> text:
    """Decode a JSON string literal (starting at an opening quote) to its
    value, RFC 8259 semantics — parity with std.common.json and the
    common/js engine copy:

    - Standard escapes: \\" \\\\ \\/ \\b \\f \\n \\r \\t.
    - \\uXXXX appends the codepoint's UTF-8 bytes; a high surrogate
      (\\uD800-\\uDBFF) followed by \\uDC00-\\uDFFF combines to the
      supplementary-plane codepoint. Lone/invalid surrogates (and
      malformed hex) decode to U+FFFD REPLACEMENT CHARACTER — RFC 8259
      leaves those undefined; replacement is chosen over dropping data.
    - Raw non-ASCII content passes through untouched.

    Engine-agnostic walk: 1-unit BRACKET slices (s[i:i+1]) with the
    empty-slice EOF sentinel and no len() arithmetic, so the same code
    is correct whether slicing is character-indexed (interpreter) or
    byte-indexed (compiled) — see the index-space note in
    std.common.json's json_tokenize and
    doc/08_tracking/bug/json_tokenizer_rejects_raw_non_ascii_strings_2026-07-29.md

    Bracket slicing specifically, NOT the .slice(a, b) method: under the
    spec-lane interpreter .slice() is byte-indexed but normalizes each
    mid-codepoint byte to U+FFFD (measured: e-acute read as two 1-unit
    .slice() reads reassembled to 6 bytes of replacement chars, not the
    2-byte character), so a 1-unit .slice() walk corrupts every
    multi-byte character. Bracket slices return whole characters there.
    """
    var out = ""
    var i = 1
    while true:
        val ch = s[i:i + 1]
        if ch == "" or ch == "\"":
            return out
        if ch != "\\":
            out = out + ch
            i = i + 1
        else:
            val esc = s[i + 1:i + 2]
            if esc == "\"":
                out = out + "\""
                i = i + 2
            else if esc == "\\":
                out = out + "\\"
                i = i + 2
            else if esc == "/":
                out = out + "/"
                i = i + 2
            else if esc == "b":
                out = out + "\b"
                i = i + 2
            else if esc == "f":
                out = out + "\f"
                i = i + 2
            else if esc == "n":
                out = out + "\n"
                i = i + 2
            else if esc == "r":
                out = out + "\r"
                i = i + 2
            else if esc == "t":
                out = out + "\t"
                i = i + 2
            else if esc == "u":
                val hi = _json_hex4(s, i + 2)
                if hi < 0:
                    out = out + 65533.chr()
                    i = i + 6
                else if hi >= 0xD800 and hi <= 0xDBFF:
                    var lo = -1
                    if s[i + 6:i + 7] == "\\" and s[i + 7:i + 8] == "u":
                        lo = _json_hex4(s, i + 8)
                    if lo >= 0xDC00 and lo <= 0xDFFF:
                        val combined = 0x10000 + ((hi - 0xD800) * 1024) + (lo - 0xDC00)
                        out = out + combined.chr()
                        i = i + 12
                    else:
                        out = out + 65533.chr()
                        i = i + 6
                else if hi >= 0xDC00 and hi <= 0xDFFF:
                    out = out + 65533.chr()
                    i = i + 6
                else:
                    out = out + hi.chr()
                    i = i + 6
            else if esc == "":
                # Trailing lone backslash at end of input.
                return out
            else:
                # Unknown escape: keep the escaped character (JS-engine
                # leniency; strict JSON would reject earlier).
                out = out + esc
                i = i + 2

fn json_is_valid(text: text) -> bool:
    val s = text.trim()
    if s == "":
        return false
    val end = _json_value_end(s, 0)
    end == s.len()

fn json_parse(text: text) -> JsValue:
    val s = text.trim()
    if s == "null":
        return JsValue.Null
    if s == "true":
        return JsValue.Boolean(true)
    if s == "false":
        return JsValue.Boolean(false)
    if s == "undefined":
        return JsValue.Undefined
    # Number
    val maybe_num = s.parse_f64()
    if maybe_num != nil:
        return JsValue.Number(maybe_num!)
    # String — decode escapes per RFC 8259 (was: raw quote-strip via
    # slice(1, len-1), which decoded nothing and, because len() is bytes
    # while interpreter slicing is character-indexed, also corrupted raw
    # non-ASCII values). Note: accepting a bare `undefined` above is a
    # deliberate JS-engine deviation from strict JSON, kept as-is.
    if s.starts_with("\"") and s.ends_with("\""):
        return JsValue.String(_json_decode_string(s))
    if json_is_valid(s):
        if s.starts_with("["):
            return JsValue.Array(id: -1)
        if s.starts_with("{"):
            return JsValue.Object(id: -1)
    JsValue.Undefined

fn _json_escape_string(s: text) -> text:
    """Escape special characters so s is valid inside a JSON string
    literal (parity with std.common.json's serializer). Non-ASCII stays
    raw UTF-8, which RFC 8259 permits."""
    var out = s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\t", "\\t")
    out = out.replace("\r", "\\r")
    out

fn json_stringify(v: JsValue) -> text:
    match v:
        JsValue.Null: "null"
        JsValue.Undefined: "undefined"
        JsValue.Boolean(b): if b: "true" else: "false"
        JsValue.Number(n): "{n}"
        JsValue.String(s): "\"" + _json_escape_string(s) + "\""
        JsValue.Object(_): "{}"
        JsValue.Array(_): "[]"
        JsValue.Function(_): "null"
