# Blocking compatibility facade for the configured HTTP client surface.
# The native transport ABI has one provider owner. This facade preserves the
# selected module identity; it does not claim nonblocking execution.
export use std.nogc_sync_mut.io.http_client_core.{
    rt_http_get, rt_http_request, rt_http_request_v2, rt_http_download,
    HttpMethod, HttpStatus, HttpResponse,
    method_to_string, status_to_code, code_to_status, make_http_response,
    url_encode, url_decode,
    http_request_raw, http_request_v2_raw,
    http_get, http_post, http_post_form, http_put, http_delete,
    http_patch, http_head, http_request, http_download,
    http_get_json, http_post_json, http_is_success, http_is_redirect,
    http_is_client_error, http_is_server_error
}
