# Observed-Maximum-Execution-Time Harness (WP-18)
#
# doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md, WP-18.
#
# NAMING IS LOAD-BEARING: everything in this file measures an
# `observed_max_ticks` value, never a "wcet". Real static WCET (Worst-Case
# Execution Time) analysis proves an upper bound over ALL possible executions
# — every input, every branch, every cache/pipeline state — typically via
# control-flow-graph path enumeration plus a microarchitectural cost model.
# That is genuine open engineering/research scope and is explicitly OUT OF
# SCOPE here. What this file provides instead is honest and much weaker: it
# runs a piece of work some number of times and records the largest elapsed
# tick count actually OBSERVED across those runs.
#
# An observed maximum is NOT a proven bound. A run this harness never
# executed (a different input, a cold cache, an interrupt landing at the
# worst moment) can take longer than anything recorded here. Any consumer of
# `observed_max_ticks` (see response_time_report.spl) MUST keep that caveat
# attached — this value is evidence, not proof, and is not on its own
# sufficient for a certification claim.
#
# Timing source: async/timer.spl's timer_now()/timer_elapsed(). In compiled
# mode that is a real hardware tick counter (SysTick/mcycle/RDTSC); in
# interpreter mode (which is what `bin/simple test` runs — see
# .claude/rules/testing.md) timer_now() is a monotonic counter that
# increments by exactly 1 per call, with no wall-clock component at all. That
# makes it a deterministic, fully controllable proxy for "how long did the
# work take" under test: a probe closure that calls timer_now() N times
# reads back as exactly N elapsed ticks, with no timing flakiness. This
# module does not attempt to fabricate a wall-clock reading where none is
# available — it reports ticks in whatever domain timer_now() itself uses,
# honestly.

use std.nogc_async_mut_noalloc.async.timer.{timer_now, timer_elapsed}

class ObservedMaxTracker:
    """Records elapsed-tick samples across repeated runs of some work and
    reports the observed maximum. See file header: this is a MEASURED
    observation, not a proven bound."""
    samples: [i64]

    static fn new() -> ObservedMaxTracker:
        """Create an empty tracker."""
        ObservedMaxTracker(samples: [])

    me record_run(work_fn: fn() -> void) -> i64:
        """Run `work_fn` once, measure its elapsed ticks via
        timer_now()/timer_elapsed(), record the sample, and return it."""
        val start = timer_now()
        work_fn()
        val elapsed = timer_elapsed(start)
        self.samples.push(elapsed)
        elapsed

    me record_sample(ticks: i64):
        """Record a pre-measured elapsed-tick sample directly, for callers
        that already measured a run themselves (e.g. wrapping a TaskSlot
        poll rather than a bare closure)."""
        self.samples.push(ticks)

    fn sample_count() -> i32:
        """Number of runs recorded so far."""
        self.samples.len()

    fn observed_max_ticks() -> i64:
        """The largest elapsed-tick count observed across all recorded runs.

        NOT a proven WCET bound -- see file header. Returns 0 if no samples
        have been recorded yet (this is a 'no data' value, not a claim that
        execution takes zero ticks)."""
        if self.samples.len() == 0:
            return 0
        var max_val = self.samples[0]
        var i = 1
        while i < self.samples.len():
            if self.samples[i] > max_val:
                max_val = self.samples[i]
            i = i + 1
        max_val

    fn observed_min_ticks() -> i64:
        """The smallest elapsed-tick count observed. Report-only context
        alongside observed_max_ticks; not used for any bound claim."""
        if self.samples.len() == 0:
            return 0
        var min_val = self.samples[0]
        var i = 1
        while i < self.samples.len():
            if self.samples[i] < min_val:
                min_val = self.samples[i]
            i = i + 1
        min_val
