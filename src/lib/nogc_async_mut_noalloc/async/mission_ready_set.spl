# codex-impl
# Bounded exact-wakeup bookkeeping for mission_pool task slots.
#
# This type deliberately uses only scalar fields: no dynamic array, text, map,
# closure, or growable collection is retained. Runtime operations perform no
# explicit allocation and address one slot directly in O(1). Simple does not
# yet preserve `[T; N]` as inline storage or emit a compiler/linker placement
# receipt, so this module does NOT claim that the enclosing value itself is
# statically placed or allocation-free in every backend.

pub enum MissionReadySetPhase:
    Configuring
    Ready
    Quiesced

pub enum MissionReadySetError:
    InvalidOwner
    WrongOwner
    InvalidCapacity
    InvalidSlot
    NotReady
    AlreadyReady
    AlreadyQuiesced
    SlotOccupied
    SlotVacant
    NotPosted
    StaleGeneration
    GenerationExhausted

pub struct MissionSlotToken:
    slot: u64
    generation: u64

pub struct MissionReadySetReceipt:
    owner_id: u64
    capacity: u64
    generation: u64
    inline_scalar_shape: bool
    source_has_no_explicit_allocation: bool
    compiler_placement_proven: bool
    link_time_static_proven: bool
    backend_allocation_free_proven: bool

class MissionReadySet64:
    owner_id_value: u64
    capacity_value: u64
    generation_value: u64
    occupied_mask: u64
    ready_mask: u64
    phase_value: MissionReadySetPhase

impl MissionReadySet64:
    static fn create(
        owner_id: u64, capacity: u64
    ) -> Result<MissionReadySet64, MissionReadySetError>:
        if owner_id == 0u64:
            return Err(MissionReadySetError.InvalidOwner)
        if capacity == 0u64 or capacity > 64u64:
            return Err(MissionReadySetError.InvalidCapacity)
        Ok(MissionReadySet64(
            owner_id_value: owner_id,
            capacity_value: capacity,
            generation_value: 1u64,
            occupied_mask: 0u64,
            ready_mask: 0u64,
            phase_value: MissionReadySetPhase.Configuring
        ))

    me seal(owner_id: u64) -> Result<MissionReadySetReceipt, MissionReadySetError>:
        val owner_error = self._owner_error(owner_id)
        if val error = owner_error:
            return Err(error)
        if self.phase_value == MissionReadySetPhase.Ready:
            return Err(MissionReadySetError.AlreadyReady)
        if self.phase_value == MissionReadySetPhase.Quiesced:
            return Err(MissionReadySetError.AlreadyQuiesced)
        self.phase_value = MissionReadySetPhase.Ready
        Ok(self._receipt())

    me admit(
        owner_id: u64, slot: u64
    ) -> Result<MissionSlotToken, MissionReadySetError>:
        val access_error = self._ready_error(owner_id, slot)
        if val error = access_error:
            return Err(error)
        val bit = 1u64 << slot
        if (self.occupied_mask & bit) != 0u64:
            return Err(MissionReadySetError.SlotOccupied)
        self.occupied_mask = self.occupied_mask | bit
        Ok(MissionSlotToken(slot: slot, generation: self.generation_value))

    me post_ready(
        owner_id: u64, token: MissionSlotToken
    ) -> Result<(), MissionReadySetError>:
        val token_error = self._token_error(owner_id, token)
        if val error = token_error:
            return Err(error)
        val bit = 1u64 << token.slot
        self.ready_mask = self.ready_mask | bit
        Ok(())

    me claim_ready(
        owner_id: u64, token: MissionSlotToken
    ) -> Result<(), MissionReadySetError>:
        val token_error = self._token_error(owner_id, token)
        if val error = token_error:
            return Err(error)
        val bit = 1u64 << token.slot
        if (self.ready_mask & bit) == 0u64:
            return Err(MissionReadySetError.NotPosted)
        self.ready_mask = self.ready_mask & ~bit
        Ok(())

    me release(
        owner_id: u64, token: MissionSlotToken
    ) -> Result<(), MissionReadySetError>:
        val token_error = self._token_error(owner_id, token)
        if val error = token_error:
            return Err(error)
        val bit = 1u64 << token.slot
        self.ready_mask = self.ready_mask & ~bit
        self.occupied_mask = self.occupied_mask & ~bit
        Ok(())

    me reset(owner_id: u64) -> Result<MissionReadySetReceipt, MissionReadySetError>:
        val owner_error = self._owner_error(owner_id)
        if val error = owner_error:
            return Err(error)
        if self.phase_value != MissionReadySetPhase.Ready:
            return Err(MissionReadySetError.NotReady)
        if self.generation_value == 18446744073709551615u64:
            return Err(MissionReadySetError.GenerationExhausted)
        self.occupied_mask = 0u64
        self.ready_mask = 0u64
        self.generation_value = self.generation_value + 1u64
        Ok(self._receipt())

    me quiesce(owner_id: u64) -> Result<(), MissionReadySetError>:
        val owner_error = self._owner_error(owner_id)
        if val error = owner_error:
            return Err(error)
        if self.phase_value == MissionReadySetPhase.Quiesced:
            return Err(MissionReadySetError.AlreadyQuiesced)
        if self.phase_value != MissionReadySetPhase.Ready:
            return Err(MissionReadySetError.NotReady)
        self.occupied_mask = 0u64
        self.ready_mask = 0u64
        self.phase_value = MissionReadySetPhase.Quiesced
        Ok(())

    fn is_occupied(slot: u64) -> bool:
        if slot >= self.capacity_value:
            return false
        (self.occupied_mask & (1u64 << slot)) != 0u64

    fn is_ready(slot: u64) -> bool:
        if slot >= self.capacity_value:
            return false
        (self.ready_mask & (1u64 << slot)) != 0u64

    fn capacity() -> u64: self.capacity_value
    fn generation() -> u64: self.generation_value
    fn phase() -> MissionReadySetPhase: self.phase_value

    fn _receipt() -> MissionReadySetReceipt:
        MissionReadySetReceipt(
            owner_id: self.owner_id_value,
            capacity: self.capacity_value,
            generation: self.generation_value,
            inline_scalar_shape: true,
            source_has_no_explicit_allocation: true,
            compiler_placement_proven: false,
            link_time_static_proven: false,
            backend_allocation_free_proven: false
        )

    fn _owner_error(owner_id: u64) -> MissionReadySetError?:
        if owner_id != self.owner_id_value:
            return MissionReadySetError.WrongOwner
        nil

    fn _ready_error(owner_id: u64, slot: u64) -> MissionReadySetError?:
        val owner_error = self._owner_error(owner_id)
        if val error = owner_error:
            return error
        if self.phase_value != MissionReadySetPhase.Ready:
            return MissionReadySetError.NotReady
        if slot >= self.capacity_value:
            return MissionReadySetError.InvalidSlot
        nil

    fn _token_error(
        owner_id: u64, token: MissionSlotToken
    ) -> MissionReadySetError?:
        val ready_error = self._ready_error(owner_id, token.slot)
        if val error = ready_error:
            return error
        if token.generation != self.generation_value:
            return MissionReadySetError.StaleGeneration
        val bit = 1u64 << token.slot
        if (self.occupied_mask & bit) == 0u64:
            return MissionReadySetError.SlotVacant
        nil

export MissionReadySetPhase, MissionReadySetError, MissionSlotToken
export MissionReadySetReceipt, MissionReadySet64
