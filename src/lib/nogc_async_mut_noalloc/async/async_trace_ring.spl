# codex-impl
# Bounded single-owner trace capture for async/mission execution.
#
# The backing array is allocated and filled during create(), before Ready.  V1
# therefore proves hosted preallocation and bounded post-seal behavior; it does
# not claim compiler/link-time static storage or that create() itself allocates
# nothing.

use std.common.contracts.execution.simple_ring_async_v1.{
    AsyncTraceEvent, RingContractError, async_trace_event_validate
}

pub enum AsyncTraceRingPhase:
    Configuring
    Ready

pub enum AsyncTraceFullPolicy:
    RejectNewest
    DropOldest

pub enum AsyncTraceAppendOutcome:
    Appended
    ReplacedOldest

pub enum AsyncTraceRingError:
    InvalidOwner
    WrongOwner
    InvalidCapacity
    NotReady
    AlreadyReady
    Full
    InvalidEvent(RingContractError)

pub struct AsyncTraceReadyReceipt:
    owner_id: u64
    capacity: u64
    hosted_preallocated: bool
    link_time_static_proven: bool

pub struct AsyncTraceRingTelemetry:
    occupancy: u64
    high_water: u64
    appended: u64
    taken: u64
    full_events: u64
    dropped_events: u64

class AsyncTraceRing:
    owner_id_value: u64
    capacity_value: i64
    policy_value: AsyncTraceFullPolicy
    phase_value: AsyncTraceRingPhase
    slots: [AsyncTraceEvent?]
    head: i64
    tail: i64
    count: i64
    telemetry_value: AsyncTraceRingTelemetry

impl AsyncTraceRing:
    static fn create(
        owner_id: u64, capacity: i64, policy: AsyncTraceFullPolicy
    ) -> Result<AsyncTraceRing, AsyncTraceRingError>:
        if owner_id == 0u64:
            return Err(AsyncTraceRingError.InvalidOwner)
        if capacity <= 0:
            return Err(AsyncTraceRingError.InvalidCapacity)
        var slots: [AsyncTraceEvent?] = []
        var index = 0
        while index < capacity:
            slots.push(nil)
            index = index + 1
        Ok(AsyncTraceRing(
            owner_id_value: owner_id,
            capacity_value: capacity,
            policy_value: policy,
            phase_value: AsyncTraceRingPhase.Configuring,
            slots: slots,
            head: 0,
            tail: 0,
            count: 0,
            telemetry_value: AsyncTraceRingTelemetry(
                occupancy: 0u64,
                high_water: 0u64,
                appended: 0u64,
                taken: 0u64,
                full_events: 0u64,
                dropped_events: 0u64
            )
        ))

    me seal(owner_id: u64) -> Result<AsyncTraceReadyReceipt, AsyncTraceRingError>:
        if owner_id != self.owner_id_value:
            return Err(AsyncTraceRingError.WrongOwner)
        if self.phase_value == AsyncTraceRingPhase.Ready:
            return Err(AsyncTraceRingError.AlreadyReady)
        self.phase_value = AsyncTraceRingPhase.Ready
        Ok(AsyncTraceReadyReceipt(
            owner_id: self.owner_id_value,
            capacity: self.capacity_value.to_u64(),
            hosted_preallocated: true,
            link_time_static_proven: false
        ))

    me append(
        owner_id: u64, event: AsyncTraceEvent
    ) -> Result<AsyncTraceAppendOutcome, AsyncTraceRingError>:
        val access_error = self._ready_owner_error(owner_id)
        if val error = access_error:
            return Err(error)
        val event_check = async_trace_event_validate(event)
        if not event_check.ok:
            return Err(AsyncTraceRingError.InvalidEvent(event_check.error))
        if self.count == self.capacity_value:
            self.telemetry_value.full_events = _trace_counter_next(
                self.telemetry_value.full_events)
            self.telemetry_value.dropped_events = _trace_counter_next(
                self.telemetry_value.dropped_events)
            if self.policy_value == AsyncTraceFullPolicy.RejectNewest:
                return Err(AsyncTraceRingError.Full)
            # DropOldest: release exactly the current head and reuse the normal
            # tail insertion path.  No scan or storage growth is involved.
            self.slots[self.head] = nil
            self.head = self._next_index(self.head)
            self.count = self.count - 1
            self._append_at_tail(event)
            return Ok(AsyncTraceAppendOutcome.ReplacedOldest)
        self._append_at_tail(event)
        Ok(AsyncTraceAppendOutcome.Appended)

    me take(owner_id: u64) -> Result<AsyncTraceEvent?, AsyncTraceRingError>:
        val access_error = self._ready_owner_error(owner_id)
        if val error = access_error:
            return Err(error)
        if self.count == 0:
            return Ok(nil)
        val event = self.slots[self.head]
        self.slots[self.head] = nil
        self.head = self._next_index(self.head)
        self.count = self.count - 1
        self.telemetry_value.occupancy = self.count.to_u64()
        self.telemetry_value.taken = _trace_counter_next(self.telemetry_value.taken)
        Ok(event)

    fn owner_id() -> u64: self.owner_id_value
    fn capacity() -> i64: self.capacity_value
    fn phase() -> AsyncTraceRingPhase: self.phase_value
    fn policy() -> AsyncTraceFullPolicy: self.policy_value
    fn occupancy() -> u64: self.count.to_u64()
    fn telemetry() -> AsyncTraceRingTelemetry: self.telemetry_value

    me _append_at_tail(event: AsyncTraceEvent):
        self.slots[self.tail] = event
        self.tail = self._next_index(self.tail)
        self.count = self.count + 1
        self.telemetry_value.occupancy = self.count.to_u64()
        self.telemetry_value.appended = _trace_counter_next(
            self.telemetry_value.appended)
        if self.telemetry_value.occupancy > self.telemetry_value.high_water:
            self.telemetry_value.high_water = self.telemetry_value.occupancy

    fn _next_index(index: i64) -> i64:
        val next = index + 1
        if next == self.capacity_value:
            0
        else:
            next

    fn _ready_owner_error(owner_id: u64) -> AsyncTraceRingError?:
        if owner_id != self.owner_id_value:
            return AsyncTraceRingError.WrongOwner
        if self.phase_value != AsyncTraceRingPhase.Ready:
            return AsyncTraceRingError.NotReady
        nil

fn _trace_counter_next(value: u64) -> u64:
    if value == 18446744073709551615u64:
        value
    else:
        value + 1u64

export AsyncTraceRingPhase, AsyncTraceFullPolicy, AsyncTraceAppendOutcome
export AsyncTraceRingError, AsyncTraceReadyReceipt, AsyncTraceRingTelemetry
export AsyncTraceRing
