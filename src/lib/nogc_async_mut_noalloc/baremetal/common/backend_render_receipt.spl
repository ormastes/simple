# codex-impl
# Fixed-field guest receipt records. No text, arrays, allocation, IO, or runtime
# calls: architecture entries can write these numeric fields to serial/MMIO.

val BACKEND_RENDER_RECEIPT_VERSION: u32 = 1
val BACKEND_RENDER_OPERATION_PRESENT: u32 = 1u32
val BACKEND_RENDER_OPERATION_SIMD_FILL: u32 = 2u32
val BACKEND_RENDER_OPERATION_SIMD_COPY: u32 = 3u32
val BACKEND_RENDER_OPERATION_SIMD_ALPHA: u32 = 4u32
val BACKEND_RENDER_OPERATION_SIMD_SCROLL: u32 = 5u32

val BACKEND_RENDER_SIMD_ISA_SSE2: u32 = 1u32
val BACKEND_RENDER_SIMD_ISA_AVX2: u32 = 2u32
val BACKEND_RENDER_SIMD_ISA_NEON: u32 = 3u32
val BACKEND_RENDER_SIMD_ISA_RVV: u32 = 4u32

val BACKEND_RENDER_SIMD_SOURCE_CPUID: u32 = 1u32
val BACKEND_RENDER_SIMD_SOURCE_ARM_ID_REGISTER: u32 = 2u32
val BACKEND_RENDER_SIMD_SOURCE_RISCV_V_STATE: u32 = 3u32

struct BackendRenderReceiptHeader:
    version: u32
    arch_code: u32
    runtime_code: u32
    backend_code: u32
    firmware_hash_word0: u64
    firmware_hash_word1: u64
    firmware_hash_word2: u64
    firmware_hash_word3: u64
    boot_id: u64
    frame_id: u64
    surface_handle: u64
    width: u32
    height: u32
    stride: u32
    format_code: u32

struct BackendRenderReceiptEvent:
    sequence: u32
    operation_code: u32
    resource_id: u64
    state_before: u32
    state_after: u32
    value_hash: u64

struct BackendRenderReceiptTrailer:
    event_count: u32
    frame_complete: bool
    pixel_hash_word0: u64
    pixel_hash_word1: u64
    pixel_hash_word2: u64
    pixel_hash_word3: u64
    nonblank_pixel_count: u64
    reason_code: u32

fn backend_render_receipt_header_valid(header: BackendRenderReceiptHeader) -> bool:
    header.version == BACKEND_RENDER_RECEIPT_VERSION and
        header.arch_code > 0 and header.runtime_code > 0 and
        header.backend_code > 0 and header.boot_id > 0 and
        (header.firmware_hash_word0 > 0 or header.firmware_hash_word1 > 0 or
            header.firmware_hash_word2 > 0 or header.firmware_hash_word3 > 0) and
        header.frame_id > 0 and header.surface_handle > 0 and
        header.width > 0 and header.height > 0 and
        header.stride >= header.width * 4 and header.format_code > 0

fn backend_render_receipt_event_valid(event: BackendRenderReceiptEvent, expected_sequence: u32) -> bool:
    event.sequence == expected_sequence and event.operation_code > 0 and event.resource_id > 0

fn backend_render_receipt_trailer_valid(trailer: BackendRenderReceiptTrailer, observed_events: u32) -> bool:
        trailer.event_count == observed_events and observed_events > 0 and
        trailer.frame_complete and
        (trailer.pixel_hash_word0 > 0 or trailer.pixel_hash_word1 > 0 or
            trailer.pixel_hash_word2 > 0 or trailer.pixel_hash_word3 > 0) and
        trailer.nonblank_pixel_count > 0 and
        trailer.reason_code == 0

# Fixed-width uppercase-free hexadecimal serial wire. Architecture entries
# stream these bytes directly through their UART owner without allocating text.
fn _backend_receipt_wire_prefix_byte(kind: u8, index: i64) -> u8:
    if index == 0: return 66u8  # B
    if index == 1 or index == 2: return 82u8  # R
    if index == 3: return 49u8  # 1
    if index == 4 or index == 6: return 32u8
    if index == 5:
        if kind == 1u8: return 72u8  # H
        if kind == 2u8: return 69u8  # E
        return 84u8  # T
    0u8

fn _backend_receipt_wire_hex_byte(value: u64, digit_index: i64) -> u8:
    val shift = (15 - digit_index) * 4
    val nibble = ((value >> shift) & 15u64).to_u8()
    if nibble < 10u8: 48u8 + nibble else: 87u8 + nibble

fn _backend_receipt_header_value(header: BackendRenderReceiptHeader, field: i64) -> u64:
    if field == 0: return header.version.to_u64()
    if field == 1: return header.arch_code.to_u64()
    if field == 2: return header.runtime_code.to_u64()
    if field == 3: return header.backend_code.to_u64()
    if field == 4: return header.firmware_hash_word0
    if field == 5: return header.firmware_hash_word1
    if field == 6: return header.firmware_hash_word2
    if field == 7: return header.firmware_hash_word3
    if field == 8: return header.boot_id
    if field == 9: return header.frame_id
    if field == 10: return header.surface_handle
    if field == 11: return header.width.to_u64()
    if field == 12: return header.height.to_u64()
    if field == 13: return header.stride.to_u64()
    header.format_code.to_u64()

fn _backend_receipt_event_value(event: BackendRenderReceiptEvent, field: i64) -> u64:
    if field == 0: return event.sequence.to_u64()
    if field == 1: return event.operation_code.to_u64()
    if field == 2: return event.resource_id
    if field == 3: return event.state_before.to_u64()
    if field == 4: return event.state_after.to_u64()
    event.value_hash

fn _backend_receipt_trailer_value(trailer: BackendRenderReceiptTrailer, field: i64) -> u64:
    if field == 0: return trailer.event_count.to_u64()
    if field == 1: return if trailer.frame_complete: 1u64 else: 0u64
    if field == 2: return trailer.pixel_hash_word0
    if field == 3: return trailer.pixel_hash_word1
    if field == 4: return trailer.pixel_hash_word2
    if field == 5: return trailer.pixel_hash_word3
    if field == 6: return trailer.nonblank_pixel_count
    trailer.reason_code.to_u64()

fn _backend_receipt_wire_record_byte(kind: u8, field_count: i64, value: u64, index: i64) -> u8:
    if index < 7:
        return _backend_receipt_wire_prefix_byte(kind, index)
    val body_index = index - 7
    val field = body_index / 17
    val slot = body_index % 17
    if field < 0 or field >= field_count:
        return 0u8
    if slot < 16:
        return _backend_receipt_wire_hex_byte(value, slot)
    if field == field_count - 1: 10u8 else: 32u8

fn backend_render_receipt_header_wire_byte_count() -> i64: 262
fn backend_render_receipt_event_wire_byte_count() -> i64: 109
fn backend_render_receipt_trailer_wire_byte_count() -> i64: 143

fn backend_render_receipt_header_wire_byte_at(header: BackendRenderReceiptHeader, index: i64) -> u8:
    if index < 0 or index >= backend_render_receipt_header_wire_byte_count():
        return 0u8
    val field = if index < 7: 0 else: (index - 7) / 17
    _backend_receipt_wire_record_byte(
        1u8, 15, _backend_receipt_header_value(header, field), index)

fn backend_render_receipt_event_wire_byte_at(event: BackendRenderReceiptEvent, index: i64) -> u8:
    if index < 0 or index >= backend_render_receipt_event_wire_byte_count():
        return 0u8
    val field = if index < 7: 0 else: (index - 7) / 17
    _backend_receipt_wire_record_byte(
        2u8, 6, _backend_receipt_event_value(event, field), index)

fn backend_render_receipt_trailer_wire_byte_at(trailer: BackendRenderReceiptTrailer, index: i64) -> u8:
    if index < 0 or index >= backend_render_receipt_trailer_wire_byte_count():
        return 0u8
    val field = if index < 7: 0 else: (index - 7) / 17
    _backend_receipt_wire_record_byte(
        3u8, 8, _backend_receipt_trailer_value(trailer, field), index)
