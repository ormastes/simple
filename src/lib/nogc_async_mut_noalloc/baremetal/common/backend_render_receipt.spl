# codex-impl
# Fixed-field guest receipt records. No text, arrays, allocation, IO, or runtime
# calls: architecture entries can write these numeric fields to serial/MMIO.

val BACKEND_RENDER_RECEIPT_VERSION: u32 = 1
val BACKEND_RENDER_RECEIPT_V2_SCHEMA: u32 = 0x42525232u32
val BACKEND_RENDER_RECEIPT_V2_VERSION: u32 = 2u32
val BACKEND_RENDER_RECEIPT_ENDIAN_BIG: u32 = 1u32
val BACKEND_RENDER_FIRMWARE_HASHED: u32 = 1u32
val BACKEND_RENDER_FIRMWARE_NOT_APPLICABLE_DIRECT_KERNEL: u32 = 2u32
val BACKEND_RENDER_OPERATION_PRESENT: u32 = 1u32
val BACKEND_RENDER_OPERATION_SIMD_FILL: u32 = 2u32
val BACKEND_RENDER_OPERATION_SIMD_COPY: u32 = 3u32
val BACKEND_RENDER_OPERATION_SIMD_ALPHA: u32 = 4u32
val BACKEND_RENDER_OPERATION_SIMD_SCROLL: u32 = 5u32
val BACKEND_RENDER_OPERATION_INPUT_IRQ: u32 = 6u32
val BACKEND_RENDER_OPERATION_WM_APPLY: u32 = 7u32
val BACKEND_RENDER_OPERATION_DAMAGE_COMMIT: u32 = 8u32

val BACKEND_RENDER_SIMD_ISA_SSE2: u32 = 1u32
val BACKEND_RENDER_SIMD_ISA_AVX2: u32 = 2u32
val BACKEND_RENDER_SIMD_ISA_NEON: u32 = 3u32
val BACKEND_RENDER_SIMD_ISA_RVV: u32 = 4u32

val BACKEND_RENDER_SIMD_SOURCE_CPUID: u32 = 1u32
val BACKEND_RENDER_SIMD_SOURCE_ARM_ID_REGISTER: u32 = 2u32
val BACKEND_RENDER_SIMD_SOURCE_RISCV_V_STATE: u32 = 3u32

struct BackendRenderReceiptHeader:
    version: u32
    arch_code: u32
    runtime_code: u32
    backend_code: u32
    firmware_hash_word0: u64
    firmware_hash_word1: u64
    firmware_hash_word2: u64
    firmware_hash_word3: u64
    boot_id: u64
    frame_id: u64
    surface_handle: u64
    width: u32
    height: u32
    stride: u32
    format_code: u32

struct BackendRenderReceiptEvent:
    sequence: u32
    operation_code: u32
    resource_id: u64
    state_before: u32
    state_after: u32
    value_hash: u64

struct BackendRenderReceiptTrailer:
    event_count: u32
    frame_complete: bool
    pixel_hash_word0: u64
    pixel_hash_word1: u64
    pixel_hash_word2: u64
    pixel_hash_word3: u64
    nonblank_pixel_count: u64
    reason_code: u32

# BRR2 keeps BRR1 records unchanged and adds source/firmware identity plus
# event-to-frame correlation. Source revisions are either 10 or 40 hexadecimal
# nibbles, stored most-significant word first with zero unused words.
struct BackendRenderReceiptHeaderV2:
    schema_code: u32
    version: u32
    endian_code: u32
    arch_code: u32
    runtime_code: u32
    backend_code: u32
    firmware_status_code: u32
    firmware_hash_word0: u64
    firmware_hash_word1: u64
    firmware_hash_word2: u64
    firmware_hash_word3: u64
    source_identity_hash_word0: u64
    source_identity_hash_word1: u64
    source_identity_hash_word2: u64
    source_identity_hash_word3: u64
    source_revision_word0: u64
    source_revision_word1: u64
    source_revision_word2: u64
    source_revision_nibbles: u32
    boot_id: u64
    surface_handle: u64
    width: u32
    height: u32
    stride: u32
    format_code: u32

struct BackendRenderReceiptEventV2:
    boot_id: u64
    source_identity_hash_word0: u64
    source_identity_hash_word1: u64
    source_identity_hash_word2: u64
    source_identity_hash_word3: u64
    input_sequence: u64
    operation_code: u32
    frame_id: u64
    rendered_revision: u64
    monotonic_event_us: u64
    resource_id: u64
    state_before: u32
    state_after: u32
    value_hash: u64

struct BackendRenderReceiptTrailerV2:
    boot_id: u64
    source_identity_hash_word0: u64
    source_identity_hash_word1: u64
    source_identity_hash_word2: u64
    source_identity_hash_word3: u64
    event_count: u32
    frame_complete: bool
    pixel_hash_word0: u64
    pixel_hash_word1: u64
    pixel_hash_word2: u64
    pixel_hash_word3: u64
    nonblank_pixel_count: u64
    reason_code: u32

fn _backend_render_geometry_valid(
    width: u32,
    height: u32,
    stride: u32
) -> bool:
    if width == 0u32 or height == 0u32 or stride == 0u32:
        return false
    if width > 1073741823u32:
        return false
    val minimum_stride = width.to_u64() * 4u64
    if stride.to_u64() < minimum_stride:
        return false
    val max_u64 = 0xffffffffffffffffu64
    if height.to_u64() > max_u64 / stride.to_u64():
        return false
    height.to_u64() * stride.to_u64() > 0u64

fn backend_render_receipt_header_valid(header: BackendRenderReceiptHeader) -> bool:
    header.version == BACKEND_RENDER_RECEIPT_VERSION and
        header.arch_code > 0 and header.runtime_code > 0 and
        header.backend_code > 0 and header.boot_id > 0 and
        (header.firmware_hash_word0 > 0 or header.firmware_hash_word1 > 0 or
            header.firmware_hash_word2 > 0 or header.firmware_hash_word3 > 0) and
        header.frame_id > 0 and header.surface_handle > 0 and
        _backend_render_geometry_valid(
            header.width, header.height, header.stride) and
        header.format_code > 0

fn backend_render_receipt_event_valid(event: BackendRenderReceiptEvent, expected_sequence: u32) -> bool:
    event.sequence == expected_sequence and
        event.operation_code >= BACKEND_RENDER_OPERATION_PRESENT and
        event.operation_code <= BACKEND_RENDER_OPERATION_SIMD_SCROLL and
        event.resource_id > 0

fn backend_render_receipt_trailer_valid(trailer: BackendRenderReceiptTrailer, observed_events: u32) -> bool:
        trailer.event_count == observed_events and observed_events > 0 and
        trailer.frame_complete and
        (trailer.pixel_hash_word0 > 0 or trailer.pixel_hash_word1 > 0 or
            trailer.pixel_hash_word2 > 0 or trailer.pixel_hash_word3 > 0) and
        trailer.nonblank_pixel_count > 0 and
        trailer.reason_code == 0

fn _backend_render_hash_present(word0: u64, word1: u64, word2: u64, word3: u64) -> bool:
    word0 > 0 or word1 > 0 or word2 > 0 or word3 > 0

fn _backend_render_hash_zero(word0: u64, word1: u64, word2: u64, word3: u64) -> bool:
    word0 == 0u64 and word1 == 0u64 and word2 == 0u64 and word3 == 0u64

fn backend_render_receipt_v2_header_valid(header: BackendRenderReceiptHeaderV2) -> bool:
    if (header.schema_code != BACKEND_RENDER_RECEIPT_V2_SCHEMA or
        header.version != BACKEND_RENDER_RECEIPT_V2_VERSION or
        header.endian_code != BACKEND_RENDER_RECEIPT_ENDIAN_BIG):
        return false
    if (header.arch_code == 0u32 or header.runtime_code == 0u32 or
        header.backend_code == 0u32):
        return false
    val firmware_hashed = (
        header.firmware_status_code == BACKEND_RENDER_FIRMWARE_HASHED and
        _backend_render_hash_present(
            header.firmware_hash_word0, header.firmware_hash_word1,
            header.firmware_hash_word2, header.firmware_hash_word3))
    val firmware_direct_kernel = (
        header.firmware_status_code ==
            BACKEND_RENDER_FIRMWARE_NOT_APPLICABLE_DIRECT_KERNEL and
        _backend_render_hash_zero(
            header.firmware_hash_word0, header.firmware_hash_word1,
            header.firmware_hash_word2, header.firmware_hash_word3))
    if not firmware_hashed and not firmware_direct_kernel:
        return false
    if not _backend_render_hash_present(
        header.source_identity_hash_word0, header.source_identity_hash_word1,
        header.source_identity_hash_word2, header.source_identity_hash_word3):
        return false
    val revision_present = header.source_revision_word0 > 0u64 or
        header.source_revision_word1 > 0u64 or header.source_revision_word2 > 0u64
    if not revision_present:
        return false
    if header.source_revision_nibbles == 10u32:
        if (header.source_revision_word0 > 0xffffffffffu64 or
            header.source_revision_word1 != 0u64 or
            header.source_revision_word2 != 0u64):
            return false
    elif header.source_revision_nibbles == 40u32:
        if header.source_revision_word2 > 0xffffffffu64:
            return false
    else:
        return false
    header.boot_id > 0u64 and header.surface_handle > 0u64 and
        _backend_render_geometry_valid(
            header.width, header.height, header.stride) and
        header.format_code > 0u32

fn backend_render_receipt_v2_event_valid(
    event: BackendRenderReceiptEventV2,
    expected_input_sequence: u64,
    expected_operation_code: u32
) -> bool:
    (expected_input_sequence == 0u64 or
        event.input_sequence == expected_input_sequence) and
        event.boot_id > 0u64 and
        _backend_render_hash_present(
            event.source_identity_hash_word0,
            event.source_identity_hash_word1,
            event.source_identity_hash_word2,
            event.source_identity_hash_word3) and
        event.input_sequence > 0u64 and
        event.operation_code == expected_operation_code and
        (event.operation_code == BACKEND_RENDER_OPERATION_INPUT_IRQ or
         event.operation_code == BACKEND_RENDER_OPERATION_WM_APPLY or
         event.operation_code == BACKEND_RENDER_OPERATION_DAMAGE_COMMIT or
         event.operation_code == BACKEND_RENDER_OPERATION_PRESENT) and
        event.frame_id > 0u64 and event.rendered_revision > 0u64 and
        event.monotonic_event_us > 0u64 and event.resource_id > 0u64

fn backend_render_receipt_v2_trailer_valid(
    trailer: BackendRenderReceiptTrailerV2,
    observed_events: u32
) -> bool:
    observed_events == 4u32 and trailer.boot_id > 0u64 and
        _backend_render_hash_present(
            trailer.source_identity_hash_word0,
            trailer.source_identity_hash_word1,
            trailer.source_identity_hash_word2,
            trailer.source_identity_hash_word3) and
        trailer.event_count == observed_events and
        trailer.frame_complete and
        _backend_render_hash_present(
            trailer.pixel_hash_word0, trailer.pixel_hash_word1,
            trailer.pixel_hash_word2, trailer.pixel_hash_word3) and
        trailer.nonblank_pixel_count > 0u64 and trailer.reason_code == 0u32

# Fixed-width uppercase-free hexadecimal serial wire. Architecture entries
# stream these bytes directly through their UART owner without allocating text.
fn _backend_receipt_wire_prefix_byte(kind: u8, index: i64) -> u8:
    if index == 0: return 66u8  # B
    if index == 1 or index == 2: return 82u8  # R
    if index == 3: return 49u8  # 1
    if index == 4 or index == 6: return 32u8
    if index == 5:
        if kind == 1u8: return 72u8  # H
        if kind == 2u8: return 69u8  # E
        return 84u8  # T
    0u8

fn _backend_receipt_v2_wire_prefix_byte(kind: u8, index: i64) -> u8:
    if index == 0: return 66u8  # B
    if index == 1 or index == 2: return 82u8  # R
    if index == 3: return 50u8  # 2
    if index == 4 or index == 6: return 32u8
    if index == 5:
        if kind == 1u8: return 72u8  # H
        if kind == 2u8: return 69u8  # E
        return 84u8  # T
    0u8

fn _backend_receipt_wire_hex_byte(value: u64, digit_index: i64) -> u8:
    val shift = (15 - digit_index) * 4
    val nibble = ((value >> shift) & 15u64).to_u8()
    if nibble < 10u8: 48u8 + nibble else: 87u8 + nibble

fn _backend_receipt_header_value(header: BackendRenderReceiptHeader, field: i64) -> u64:
    if field == 0: return header.version.to_u64()
    if field == 1: return header.arch_code.to_u64()
    if field == 2: return header.runtime_code.to_u64()
    if field == 3: return header.backend_code.to_u64()
    if field == 4: return header.firmware_hash_word0
    if field == 5: return header.firmware_hash_word1
    if field == 6: return header.firmware_hash_word2
    if field == 7: return header.firmware_hash_word3
    if field == 8: return header.boot_id
    if field == 9: return header.frame_id
    if field == 10: return header.surface_handle
    if field == 11: return header.width.to_u64()
    if field == 12: return header.height.to_u64()
    if field == 13: return header.stride.to_u64()
    header.format_code.to_u64()

fn _backend_receipt_event_value(event: BackendRenderReceiptEvent, field: i64) -> u64:
    if field == 0: return event.sequence.to_u64()
    if field == 1: return event.operation_code.to_u64()
    if field == 2: return event.resource_id
    if field == 3: return event.state_before.to_u64()
    if field == 4: return event.state_after.to_u64()
    event.value_hash

fn _backend_receipt_trailer_value(trailer: BackendRenderReceiptTrailer, field: i64) -> u64:
    if field == 0: return trailer.event_count.to_u64()
    if field == 1: return if trailer.frame_complete: 1u64 else: 0u64
    if field == 2: return trailer.pixel_hash_word0
    if field == 3: return trailer.pixel_hash_word1
    if field == 4: return trailer.pixel_hash_word2
    if field == 5: return trailer.pixel_hash_word3
    if field == 6: return trailer.nonblank_pixel_count
    trailer.reason_code.to_u64()

fn _backend_receipt_v2_header_value(header: BackendRenderReceiptHeaderV2, field: i64) -> u64:
    if field == 0: return header.schema_code.to_u64()
    if field == 1: return header.version.to_u64()
    if field == 2: return header.endian_code.to_u64()
    if field == 3: return header.arch_code.to_u64()
    if field == 4: return header.runtime_code.to_u64()
    if field == 5: return header.backend_code.to_u64()
    if field == 6: return header.firmware_status_code.to_u64()
    if field == 7: return header.firmware_hash_word0
    if field == 8: return header.firmware_hash_word1
    if field == 9: return header.firmware_hash_word2
    if field == 10: return header.firmware_hash_word3
    if field == 11: return header.source_identity_hash_word0
    if field == 12: return header.source_identity_hash_word1
    if field == 13: return header.source_identity_hash_word2
    if field == 14: return header.source_identity_hash_word3
    if field == 15: return header.source_revision_word0
    if field == 16: return header.source_revision_word1
    if field == 17: return header.source_revision_word2
    if field == 18: return header.source_revision_nibbles.to_u64()
    if field == 19: return header.boot_id
    if field == 20: return header.surface_handle
    if field == 21: return header.width.to_u64()
    if field == 22: return header.height.to_u64()
    if field == 23: return header.stride.to_u64()
    header.format_code.to_u64()

fn _backend_receipt_v2_event_value(event: BackendRenderReceiptEventV2, field: i64) -> u64:
    if field == 0: return event.boot_id
    if field == 1: return event.source_identity_hash_word0
    if field == 2: return event.source_identity_hash_word1
    if field == 3: return event.source_identity_hash_word2
    if field == 4: return event.source_identity_hash_word3
    if field == 5: return event.input_sequence
    if field == 6: return event.operation_code.to_u64()
    if field == 7: return event.frame_id
    if field == 8: return event.rendered_revision
    if field == 9: return event.monotonic_event_us
    if field == 10: return event.resource_id
    if field == 11: return event.state_before.to_u64()
    if field == 12: return event.state_after.to_u64()
    event.value_hash

fn _backend_receipt_v2_trailer_value(
    trailer: BackendRenderReceiptTrailerV2,
    field: i64
) -> u64:
    if field == 0: return trailer.boot_id
    if field == 1: return trailer.source_identity_hash_word0
    if field == 2: return trailer.source_identity_hash_word1
    if field == 3: return trailer.source_identity_hash_word2
    if field == 4: return trailer.source_identity_hash_word3
    if field == 5: return trailer.event_count.to_u64()
    if field == 6: return if trailer.frame_complete: 1u64 else: 0u64
    if field == 7: return trailer.pixel_hash_word0
    if field == 8: return trailer.pixel_hash_word1
    if field == 9: return trailer.pixel_hash_word2
    if field == 10: return trailer.pixel_hash_word3
    if field == 11: return trailer.nonblank_pixel_count
    trailer.reason_code.to_u64()

fn _backend_receipt_v2_checksum_u64(checksum: u64, value: u64) -> u64:
    var out = checksum
    var index: i64 = 0
    while index < 8:
        val shift = (7 - index) * 8
        val byte = (value >> shift) & 255u64
        out = (out ^ byte) * 1099511628211u64
        index = index + 1
    out

fn backend_render_receipt_v2_header_checksum(header: BackendRenderReceiptHeaderV2) -> u64:
    var checksum = 14695981039346656037u64
    var field: i64 = 0
    while field < 25:
        checksum = _backend_receipt_v2_checksum_u64(
            checksum, _backend_receipt_v2_header_value(header, field))
        field = field + 1
    checksum

fn backend_render_receipt_v2_event_checksum(event: BackendRenderReceiptEventV2) -> u64:
    var checksum = 14695981039346656037u64
    var field: i64 = 0
    while field < 14:
        checksum = _backend_receipt_v2_checksum_u64(
            checksum, _backend_receipt_v2_event_value(event, field))
        field = field + 1
    checksum

fn backend_render_receipt_v2_trailer_checksum(
    trailer: BackendRenderReceiptTrailerV2
) -> u64:
    var checksum = 14695981039346656037u64
    var field: i64 = 0
    while field < 13:
        checksum = _backend_receipt_v2_checksum_u64(
            checksum, _backend_receipt_v2_trailer_value(trailer, field))
        field = field + 1
    checksum

fn _backend_receipt_wire_record_byte(kind: u8, field_count: i64, value: u64, index: i64) -> u8:
    if index < 7:
        return _backend_receipt_wire_prefix_byte(kind, index)
    val body_index = index - 7
    val field = body_index / 17
    val slot = body_index % 17
    if field < 0 or field >= field_count:
        return 0u8
    if slot < 16:
        return _backend_receipt_wire_hex_byte(value, slot)
    if field == field_count - 1: 10u8 else: 32u8

fn _backend_receipt_v2_wire_record_byte(
    kind: u8,
    payload_field_count: i64,
    payload_byte_count: u64,
    payload_value: u64,
    checksum: u64,
    index: i64
) -> u8:
    if index < 7:
        return _backend_receipt_v2_wire_prefix_byte(kind, index)
    val body_index = index - 7
    val field = body_index / 17
    val slot = body_index % 17
    val field_count = payload_field_count + 2
    if field < 0 or field >= field_count:
        return 0u8
    val value = if field == 0:
        payload_byte_count
    elif field == field_count - 1:
        checksum
    else:
        payload_value
    if slot < 16:
        return _backend_receipt_wire_hex_byte(value, slot)
    if field == field_count - 1: 10u8 else: 32u8

fn backend_render_receipt_header_wire_byte_count() -> i64: 262
fn backend_render_receipt_event_wire_byte_count() -> i64: 109
fn backend_render_receipt_trailer_wire_byte_count() -> i64: 143
fn backend_render_receipt_v2_header_wire_byte_count() -> i64: 466
fn backend_render_receipt_v2_event_wire_byte_count() -> i64: 279
fn backend_render_receipt_v2_trailer_wire_byte_count() -> i64: 262

fn backend_render_receipt_header_wire_byte_at(header: BackendRenderReceiptHeader, index: i64) -> u8:
    if index < 0 or index >= backend_render_receipt_header_wire_byte_count():
        return 0u8
    val field = if index < 7: 0 else: (index - 7) / 17
    _backend_receipt_wire_record_byte(
        1u8, 15, _backend_receipt_header_value(header, field), index)

fn backend_render_receipt_event_wire_byte_at(event: BackendRenderReceiptEvent, index: i64) -> u8:
    if index < 0 or index >= backend_render_receipt_event_wire_byte_count():
        return 0u8
    val field = if index < 7: 0 else: (index - 7) / 17
    _backend_receipt_wire_record_byte(
        2u8, 6, _backend_receipt_event_value(event, field), index)

fn backend_render_receipt_trailer_wire_byte_at(trailer: BackendRenderReceiptTrailer, index: i64) -> u8:
    if index < 0 or index >= backend_render_receipt_trailer_wire_byte_count():
        return 0u8
    val field = if index < 7: 0 else: (index - 7) / 17
    _backend_receipt_wire_record_byte(
        3u8, 8, _backend_receipt_trailer_value(trailer, field), index)

fn backend_render_receipt_v2_header_wire_byte_at(
    header: BackendRenderReceiptHeaderV2,
    index: i64
) -> u8:
    if index < 0 or index >= backend_render_receipt_v2_header_wire_byte_count():
        return 0u8
    val encoded_field = if index < 7: 0 else: (index - 7) / 17
    val payload_field = encoded_field - 1
    val payload_value = if payload_field >= 0 and payload_field < 25:
        _backend_receipt_v2_header_value(header, payload_field)
    else:
        0u64
    _backend_receipt_v2_wire_record_byte(
        1u8, 25, 200u64, payload_value,
        backend_render_receipt_v2_header_checksum(header), index)

fn backend_render_receipt_v2_event_wire_byte_at(
    event: BackendRenderReceiptEventV2,
    index: i64
) -> u8:
    if index < 0 or index >= backend_render_receipt_v2_event_wire_byte_count():
        return 0u8
    val encoded_field = if index < 7: 0 else: (index - 7) / 17
    val payload_field = encoded_field - 1
    val payload_value = if payload_field >= 0 and payload_field < 14:
        _backend_receipt_v2_event_value(event, payload_field)
    else:
        0u64
    _backend_receipt_v2_wire_record_byte(
        2u8, 14, 112u64, payload_value,
        backend_render_receipt_v2_event_checksum(event), index)

fn backend_render_receipt_v2_trailer_wire_byte_at(
    trailer: BackendRenderReceiptTrailerV2,
    index: i64
) -> u8:
    if index < 0 or index >= backend_render_receipt_v2_trailer_wire_byte_count():
        return 0u8
    val encoded_field = if index < 7: 0 else: (index - 7) / 17
    val payload_field = encoded_field - 1
    val payload_value = if payload_field >= 0 and payload_field < 13:
        _backend_receipt_v2_trailer_value(trailer, payload_field)
    else:
        0u64
    _backend_receipt_v2_wire_record_byte(
        3u8, 13, 104u64, payload_value,
        backend_render_receipt_v2_trailer_checksum(trailer), index)
