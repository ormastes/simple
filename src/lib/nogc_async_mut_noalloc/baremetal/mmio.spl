"""Canonical no-allocation volatile MMIO instruction boundary.

Callers own address-range, alignment, device, ordering, and lifetime policy.
These inline leaves add no allocation, lookup, lock, or dynamic dispatch.
"""

@unsafe(reason: "volatile raw-address read through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_read_u32(addr: u64) -> u32
@unsafe(reason: "volatile raw-address write through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_write_u32(addr: u64, value: u32)
@unsafe(reason: "volatile raw-address read through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_read_u16(addr: u64) -> u16
@unsafe(reason: "volatile raw-address write through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_write_u16(addr: u64, value: u16)
@unsafe(reason: "volatile raw-address read through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_read_u8(addr: u64) -> u8
@unsafe(reason: "volatile raw-address write through unsigned native/interpreter providers", capabilities: [ffi, raw_ptr])
extern fn rt_mmio_write_u8(addr: u64, value: u8)

@inline
fn mmio_read_u32(addr: u64) -> u32:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmio_read_u32(addr)

@inline
fn mmio_write_u32(addr: u64, value: u32):
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmio_write_u32(addr, value)

@inline
fn mmio_read_u16(addr: u64) -> u16:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmio_read_u16(addr)

@inline
fn mmio_write_u16(addr: u64, value: u16):
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmio_write_u16(addr, value)

@inline
fn mmio_read_u8(addr: u64) -> u8:
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmio_read_u8(addr)

@inline
fn mmio_write_u8(addr: u64, value: u8):
    unsafe(capabilities: [ffi, raw_ptr]):
        rt_mmio_write_u8(addr, value)
