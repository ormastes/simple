# AArch64 barrier / cache-op / wait intrinsics (design A.7 F2)
#
# One instruction per call through the MIR InlineAsm node (`asm volatile`
# with an implicit `memory` clobber, so each is also a compiler barrier).
# No runtime call, no allocation. Skipped (no-op) on the host interpreter.
# Range cache-maintenance loops belong in the caller; `dc_*`/`ic_*` here are
# the single-line primitives such loops call.

fn dmb_ish():
    """Data memory barrier, inner shareable."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("dmb ish")

fn dmb_sy():
    unsafe(capabilities: [inline_asm]):
        asm volatile("dmb sy")

fn dsb_ish():
    """Data synchronization barrier, inner shareable."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("dsb ish")

fn dsb_sy():
    unsafe(capabilities: [inline_asm]):
        asm volatile("dsb sy")

fn isb():
    """Instruction synchronization barrier."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("isb")

fn fence_full():
    """Arch-neutral full fence name (shared with riscv/x86_64): `dmb ish`."""
    dmb_ish()

fn dc_civac(addr: u64):
    """Clean + invalidate one data-cache line by VA to PoC."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("dc civac, {a}", a = in(reg) addr)

fn dc_cvac(addr: u64):
    """Clean one data-cache line by VA to PoC."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("dc cvac, {a}", a = in(reg) addr)

fn dc_ivac(addr: u64):
    """Invalidate one data-cache line by VA to PoC."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("dc ivac, {a}", a = in(reg) addr)

fn ic_ivau(addr: u64):
    """Invalidate one instruction-cache line by VA to PoU."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("ic ivau, {a}", a = in(reg) addr)

fn ic_ialluis():
    """Invalidate all instruction caches, inner shareable."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("ic ialluis")

fn tlbi_vmalle1():
    """Invalidate all EL1 TLB entries."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("tlbi vmalle1")

fn wfi():
    unsafe(capabilities: [inline_asm]):
        asm volatile("wfi")

fn wfe():
    unsafe(capabilities: [inline_asm]):
        asm volatile("wfe")

fn sev():
    unsafe(capabilities: [inline_asm]):
        asm volatile("sev")

fn cpu_relax():
    """Spin-loop hint: `yield`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("yield")

fn nop():
    unsafe(capabilities: [inline_asm]):
        asm volatile("nop")

export dmb_ish, dmb_sy, dsb_ish, dsb_sy, isb, fence_full
export dc_civac, dc_cvac, dc_ivac, ic_ivau, ic_ialluis, tlbi_vmalle1
export wfi, wfe, sev, cpu_relax, nop
