# AArch64 system-register intrinsics (design A.7 F1: `sysreg_read/write`)
#
# One `mrs` / `msr` per call through the MIR InlineAsm node — no runtime
# call, no allocation. The register name is part of the instruction encoding,
# so selection is a `match` over the SYSREG_* constants (one asm site per
# register, all here instead of in every kernel arch file).
#
# Host / interpreter: the asm statement is skipped; specs install
# `sysreg_test_shim(regs, values)`; without a shim a read raises
# E-INTRINSIC-HOST instead of silently returning 0.

@unsafe(reason: "runtime-engine identity probe for the E-INTRINSIC-HOST check", capabilities: [ffi])
extern fn rt_is_interpreter_runtime() -> bool

val SYSREG_CURRENTEL: u64 = 1
val SYSREG_VBAR_EL1: u64 = 2
val SYSREG_TTBR0_EL1: u64 = 3
val SYSREG_TTBR1_EL1: u64 = 4
val SYSREG_TCR_EL1: u64 = 5
val SYSREG_MAIR_EL1: u64 = 6
val SYSREG_SCTLR_EL1: u64 = 7
val SYSREG_ESR_EL1: u64 = 8
val SYSREG_ELR_EL1: u64 = 9
val SYSREG_FAR_EL1: u64 = 10
val SYSREG_SPSR_EL1: u64 = 11
val SYSREG_DAIF: u64 = 12
val SYSREG_MPIDR_EL1: u64 = 13
val SYSREG_MIDR_EL1: u64 = 14
val SYSREG_CNTFRQ_EL0: u64 = 15
val SYSREG_CNTPCT_EL0: u64 = 16
val SYSREG_CNTP_CTL_EL0: u64 = 17
val SYSREG_CNTP_TVAL_EL0: u64 = 18
val SYSREG_CNTP_CVAL_EL0: u64 = 19
val SYSREG_CNTV_CTL_EL0: u64 = 20
val SYSREG_CNTV_TVAL_EL0: u64 = 21
val SYSREG_CNTVCT_EL0: u64 = 22
val SYSREG_SP_EL0: u64 = 23
val SYSREG_TPIDR_EL1: u64 = 24
val SYSREG_ID_AA64MMFR0_EL1: u64 = 25

val SYSREG_HOST_SENTINEL: u64 = 0x51AC5EED0BADC0DE

var sysreg_shim_active: bool = false
var sysreg_shim_regs: [u64] = []
var sysreg_shim_values: [u64] = []

fn sysreg_test_shim(regs: [u64], values: [u64]):
    """Install scripted system-register values for host/interpreter specs."""
    sysreg_shim_regs = regs
    sysreg_shim_values = values
    sysreg_shim_active = true

fn sysreg_test_shim_clear():
    sysreg_shim_active = false
    sysreg_shim_regs = []
    sysreg_shim_values = []

fn sysreg_shim_index(reg: u64) -> i64:
    var i = 0
    while i < sysreg_shim_regs.len():
        if sysreg_shim_regs[i] == reg:
            return i
        i = i + 1
    -1

fn sysreg_shim_read(reg: u64) -> u64:
    val i = sysreg_shim_index(reg)
    if i < 0:
        panic("E-INTRINSIC-HOST: sysreg_read({reg}) has no scripted value in sysreg_test_shim")
    sysreg_shim_values[i]

fn sysreg_shim_write(reg: u64, value: u64):
    val i = sysreg_shim_index(reg)
    if i < 0:
        sysreg_shim_regs.push(reg)
        sysreg_shim_values.push(value)
    else:
        sysreg_shim_values[i] = value

fn sysreg_host_guard(value: u64) -> u64:
    if value == SYSREG_HOST_SENTINEL:
        unsafe(capabilities: [ffi]):
            if rt_is_interpreter_runtime():
                panic("E-INTRINSIC-HOST: sysreg intrinsic executed on the host without sysreg_test_shim")
    value

fn sysreg_read(reg: u64) -> u64:
    """`mrs` of one system register; `reg` is a SYSREG_* constant."""
    if sysreg_shim_active:
        return sysreg_shim_read(reg)
    var value: u64 = SYSREG_HOST_SENTINEL
    unsafe(capabilities: [inline_asm]):
        match reg:
            case 1:
                asm volatile("mrs {v}, currentel", v = out(reg) value)
            case 2:
                asm volatile("mrs {v}, vbar_el1", v = out(reg) value)
            case 3:
                asm volatile("mrs {v}, ttbr0_el1", v = out(reg) value)
            case 4:
                asm volatile("mrs {v}, ttbr1_el1", v = out(reg) value)
            case 5:
                asm volatile("mrs {v}, tcr_el1", v = out(reg) value)
            case 6:
                asm volatile("mrs {v}, mair_el1", v = out(reg) value)
            case 7:
                asm volatile("mrs {v}, sctlr_el1", v = out(reg) value)
            case 8:
                asm volatile("mrs {v}, esr_el1", v = out(reg) value)
            case 9:
                asm volatile("mrs {v}, elr_el1", v = out(reg) value)
            case 10:
                asm volatile("mrs {v}, far_el1", v = out(reg) value)
            case 11:
                asm volatile("mrs {v}, spsr_el1", v = out(reg) value)
            case 12:
                asm volatile("mrs {v}, daif", v = out(reg) value)
            case 13:
                asm volatile("mrs {v}, mpidr_el1", v = out(reg) value)
            case 14:
                asm volatile("mrs {v}, midr_el1", v = out(reg) value)
            case 15:
                asm volatile("mrs {v}, cntfrq_el0", v = out(reg) value)
            case 16:
                asm volatile("mrs {v}, cntpct_el0", v = out(reg) value)
            case 17:
                asm volatile("mrs {v}, cntp_ctl_el0", v = out(reg) value)
            case 18:
                asm volatile("mrs {v}, cntp_tval_el0", v = out(reg) value)
            case 19:
                asm volatile("mrs {v}, cntp_cval_el0", v = out(reg) value)
            case 20:
                asm volatile("mrs {v}, cntv_ctl_el0", v = out(reg) value)
            case 21:
                asm volatile("mrs {v}, cntv_tval_el0", v = out(reg) value)
            case 22:
                asm volatile("mrs {v}, cntvct_el0", v = out(reg) value)
            case 23:
                asm volatile("mrs {v}, sp_el0", v = out(reg) value)
            case 24:
                asm volatile("mrs {v}, tpidr_el1", v = out(reg) value)
            case 25:
                asm volatile("mrs {v}, id_aa64mmfr0_el1", v = out(reg) value)
            case _:
                panic("E-SYSREG-UNKNOWN: sysreg_read({reg}) has no intrinsic arm")
    sysreg_host_guard(value)

fn sysreg_write(reg: u64, value: u64):
    """`msr` of one writable system register; `reg` is a SYSREG_* constant."""
    if sysreg_shim_active:
        sysreg_shim_write(reg, value)
        return
    unsafe(capabilities: [inline_asm]):
        match reg:
            case 2:
                asm volatile("msr vbar_el1, {v}", v = in(reg) value)
            case 3:
                asm volatile("msr ttbr0_el1, {v}", v = in(reg) value)
            case 4:
                asm volatile("msr ttbr1_el1, {v}", v = in(reg) value)
            case 5:
                asm volatile("msr tcr_el1, {v}", v = in(reg) value)
            case 6:
                asm volatile("msr mair_el1, {v}", v = in(reg) value)
            case 7:
                asm volatile("msr sctlr_el1, {v}", v = in(reg) value)
            case 9:
                asm volatile("msr elr_el1, {v}", v = in(reg) value)
            case 11:
                asm volatile("msr spsr_el1, {v}", v = in(reg) value)
            case 12:
                asm volatile("msr daif, {v}", v = in(reg) value)
            case 15:
                asm volatile("msr cntfrq_el0, {v}", v = in(reg) value)
            case 17:
                asm volatile("msr cntp_ctl_el0, {v}", v = in(reg) value)
            case 18:
                asm volatile("msr cntp_tval_el0, {v}", v = in(reg) value)
            case 19:
                asm volatile("msr cntp_cval_el0, {v}", v = in(reg) value)
            case 20:
                asm volatile("msr cntv_ctl_el0, {v}", v = in(reg) value)
            case 21:
                asm volatile("msr cntv_tval_el0, {v}", v = in(reg) value)
            case 23:
                asm volatile("msr sp_el0, {v}", v = in(reg) value)
            case 24:
                asm volatile("msr tpidr_el1, {v}", v = in(reg) value)
            case _:
                panic("E-SYSREG-UNKNOWN: sysreg {reg} is read-only or unsupported")

fn daif_mask_all():
    """Mask D, A, I, F: `msr daifset, #0xf` (immediate form)."""
    if sysreg_shim_active:
        sysreg_shim_write(SYSREG_DAIF, 0x3C0)
        return
    unsafe(capabilities: [inline_asm]):
        asm volatile("msr daifset, #0xf")

fn daif_unmask_all():
    """Unmask D, A, I, F: `msr daifclr, #0xf`."""
    if sysreg_shim_active:
        sysreg_shim_write(SYSREG_DAIF, 0)
        return
    unsafe(capabilities: [inline_asm]):
        asm volatile("msr daifclr, #0xf")

fn daif_mask_irq():
    """Mask IRQ only: `msr daifset, #0x2`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("msr daifset, #0x2")

fn daif_unmask_irq():
    """Unmask IRQ only: `msr daifclr, #0x2`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("msr daifclr, #0x2")

fn current_el() -> u64:
    """Exception level 0..3 decoded from CurrentEL[3:2]."""
    (sysreg_read(SYSREG_CURRENTEL) >> 2) & 0x3

export SYSREG_CURRENTEL, SYSREG_VBAR_EL1, SYSREG_TTBR0_EL1, SYSREG_TTBR1_EL1
export SYSREG_TCR_EL1, SYSREG_MAIR_EL1, SYSREG_SCTLR_EL1, SYSREG_ESR_EL1
export SYSREG_ELR_EL1, SYSREG_FAR_EL1, SYSREG_SPSR_EL1, SYSREG_DAIF
export SYSREG_MPIDR_EL1, SYSREG_MIDR_EL1, SYSREG_CNTFRQ_EL0, SYSREG_CNTPCT_EL0
export SYSREG_CNTP_CTL_EL0, SYSREG_CNTP_TVAL_EL0, SYSREG_CNTP_CVAL_EL0
export SYSREG_CNTV_CTL_EL0, SYSREG_CNTV_TVAL_EL0, SYSREG_CNTVCT_EL0
export SYSREG_SP_EL0, SYSREG_TPIDR_EL1, SYSREG_ID_AA64MMFR0_EL1
export sysreg_read, sysreg_write, sysreg_test_shim, sysreg_test_shim_clear
export daif_mask_all, daif_unmask_all, daif_mask_irq, daif_unmask_irq, current_el
