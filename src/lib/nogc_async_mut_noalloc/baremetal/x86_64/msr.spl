# x86_64 model-specific-register intrinsics (design A.7 F1: `msr_read/write`)
#
# `rdmsr` / `wrmsr` take the MSR number in ECX and the value in EDX:EAX, so
# unlike riscv/aarch64 the register number is a runtime operand and a single
# asm site covers every MSR. One instruction per call through the MIR
# InlineAsm node; no runtime call, no allocation.
#
# Host / interpreter: the asm statement is skipped; specs install
# `msr_test_shim(msrs, values)`; without a shim a read raises E-INTRINSIC-HOST.

@unsafe(reason: "runtime-engine identity probe for the E-INTRINSIC-HOST check", capabilities: [ffi])
extern fn rt_is_interpreter_runtime() -> bool

val MSR_EFER: u32 = 0xC0000080
val MSR_STAR: u32 = 0xC0000081
val MSR_LSTAR: u32 = 0xC0000082
val MSR_FMASK: u32 = 0xC0000084
val MSR_FS_BASE: u32 = 0xC0000100
val MSR_GS_BASE: u32 = 0xC0000101
val MSR_KERNEL_GS_BASE: u32 = 0xC0000102
val MSR_APIC_BASE: u32 = 0x1B
val MSR_TSC: u32 = 0x10

val MSR_HOST_SENTINEL: u32 = 0x5EEDC0DE

var msr_shim_active: bool = false
var msr_shim_msrs: [u32] = []
var msr_shim_values: [u64] = []

fn msr_test_shim(msrs: [u32], values: [u64]):
    """Install scripted MSR values for host/interpreter specs."""
    msr_shim_msrs = msrs
    msr_shim_values = values
    msr_shim_active = true

fn msr_test_shim_clear():
    msr_shim_active = false
    msr_shim_msrs = []
    msr_shim_values = []

fn msr_shim_index(msr: u32) -> i64:
    var i = 0
    while i < msr_shim_msrs.len():
        if msr_shim_msrs[i] == msr:
            return i
        i = i + 1
    -1

fn msr_read(msr: u32) -> u64:
    """`rdmsr`: read one MSR as a 64-bit value."""
    if msr_shim_active:
        val i = msr_shim_index(msr)
        if i < 0:
            panic("E-INTRINSIC-HOST: msr_read({msr}) has no scripted value in msr_test_shim")
        return msr_shim_values[i]
    var lo: u32 = MSR_HOST_SENTINEL
    var hi: u32 = MSR_HOST_SENTINEL
    unsafe(capabilities: [inline_asm]):
        asm volatile("rdmsr", out(eax) lo, out(edx) hi, in(ecx) msr)
    if lo == MSR_HOST_SENTINEL and hi == MSR_HOST_SENTINEL:
        unsafe(capabilities: [ffi]):
            if rt_is_interpreter_runtime():
                panic("E-INTRINSIC-HOST: msr_read executed on the host without msr_test_shim")
    ((hi as u64) << 32) | (lo as u64)

fn msr_write(msr: u32, value: u64):
    """`wrmsr`: write one MSR from a 64-bit value."""
    if msr_shim_active:
        val i = msr_shim_index(msr)
        if i < 0:
            msr_shim_msrs.push(msr)
            msr_shim_values.push(value)
        else:
            msr_shim_values[i] = value
        return
    val lo: u32 = (value & 0xFFFFFFFF) as u32
    val hi: u32 = (value >> 32) as u32
    unsafe(capabilities: [inline_asm]):
        asm volatile("wrmsr", in(ecx) msr, in(eax) lo, in(edx) hi)

fn rdtsc() -> u64:
    """Time-stamp counter (`rdtsc`), EDX:EAX combined."""
    var lo: u32 = 0
    var hi: u32 = 0
    unsafe(capabilities: [inline_asm]):
        asm volatile("rdtsc", out(eax) lo, out(edx) hi)
    ((hi as u64) << 32) | (lo as u64)

export MSR_EFER, MSR_STAR, MSR_LSTAR, MSR_FMASK, MSR_FS_BASE, MSR_GS_BASE
export MSR_KERNEL_GS_BASE, MSR_APIC_BASE, MSR_TSC
export msr_read, msr_write, rdtsc, msr_test_shim, msr_test_shim_clear
