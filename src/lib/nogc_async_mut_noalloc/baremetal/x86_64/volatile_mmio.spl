# x86_64 volatile MMIO load/store primitives (design A.7 F4 substrate)
#
# Each access is ONE mov through the MIR InlineAsm node. An asm block is
# opaque to every optimiser level, so the access can never be elided, merged,
# widened, or reordered against another asm access — the @volatile row of
# design A.2 by construction. The typed bitfield register views in
# mmio_reg.spl sit on top of these.
#
# 32-bit accesses pin EAX (explicit-register constraint) so the template can
# name the sub-register width without operand modifiers.
#
# Host / interpreter: the asm is skipped; these raw fns are native-only —
# the typed view layer supplies the host shim.

fn mmio_load32(addr: u64) -> u32:
    var v: u32 = 0
    unsafe(capabilities: [inline_asm]):
        asm volatile("movl ({a}), %eax", a = in(reg) addr, out(eax) v)
    v

fn mmio_store32(addr: u64, value: u32):
    unsafe(capabilities: [inline_asm]):
        asm volatile("movl %eax, ({a})", a = in(reg) addr, in(eax) value)

fn mmio_load64(addr: u64) -> u64:
    var v: u64 = 0
    unsafe(capabilities: [inline_asm]):
        asm volatile("movq ({a}), {v}", a = in(reg) addr, v = out(reg) v)
    v

fn mmio_store64(addr: u64, value: u64):
    unsafe(capabilities: [inline_asm]):
        asm volatile("movq {v}, ({a})", a = in(reg) addr, v = in(reg) value)

export mmio_load32, mmio_store32, mmio_load64, mmio_store64
