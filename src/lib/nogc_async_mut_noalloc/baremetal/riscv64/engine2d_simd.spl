# codex-impl
# RV64 RVV SimpleOS owner. RVV is active when V-state detection succeeds; it is
# never represented by a disabled scalar placeholder.

use std.nogc_async_mut_noalloc.baremetal.common.engine2d_simd_evidence.*

extern fn rt_simpleos_rvv_engine2d_simd_owner_linked() -> u64
extern fn rt_simpleos_rvv_engine2d_simd_feature() -> u64
extern fn rt_simpleos_rvv_engine2d_simd_vector_width() -> u64
extern fn rt_simpleos_rvv_engine2d_simd_fill(dst: u64, scalar: u64, count: u64, color: u32) -> u64
extern fn rt_simpleos_rvv_engine2d_simd_copy(dst: u64, scalar: u64, src: u64, count: u64) -> u64
extern fn rt_simpleos_rvv_engine2d_simd_alpha(dst: u64, scalar: u64, src: u64, count: u64) -> u64
extern fn rt_simpleos_rvv_engine2d_simd_alpha_edge(dst: u64, scalar: u64, src: u64, count: u64) -> u64
extern fn rt_simpleos_rvv_engine2d_simd_scroll(dst: u64, scalar: u64, src: u64, count: u64) -> u64
extern fn rt_simpleos_rvv_engine2d_simd_diagram(dst: u64, scalar: u64, src: u64, count: u64) -> u64
extern fn rt_simpleos_rvv_engine2d_simd_metric(operation: u32, metric: u32) -> u64

fn _rvv_simd_operation(operation: u32) -> Engine2dSimdOperationEvidence:
    engine2d_simd_operation_evidence(
        operation,
        rt_simpleos_rvv_engine2d_simd_metric(operation, 1u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 2u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 3u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 4u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 5u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 6u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 7u32),
        rt_simpleos_rvv_engine2d_simd_metric(operation, 8u32))

fn riscv64_engine2d_simd_produce(
    dst: u64, scalar: u64, scratch: u64, count: u64, color: u32
) -> Engine2dSimdProducerEvidence:
    if rt_simpleos_rvv_engine2d_simd_owner_linked() != 1u64:
        return engine2d_simd_blocked_producer(
            ENGINE2D_SIMD_ARCH_RISCV64, ENGINE2D_SIMD_FEATURE_RVV,
            ENGINE2D_SIMD_BLOCK_INTRINSIC_OWNER_UNLINKED)
    if rt_simpleos_rvv_engine2d_simd_feature().to_u32() != ENGINE2D_SIMD_FEATURE_RVV:
        return engine2d_simd_blocked_producer(
            ENGINE2D_SIMD_ARCH_RISCV64, ENGINE2D_SIMD_FEATURE_RVV,
            ENGINE2D_SIMD_BLOCK_UNSUPPORTED_FEATURE)
    rt_simpleos_rvv_engine2d_simd_fill(dst, scalar, count, color)
    rt_simpleos_rvv_engine2d_simd_copy(dst, scalar, scratch, count)
    rt_simpleos_rvv_engine2d_simd_alpha(dst, scalar, scratch, count)
    rt_simpleos_rvv_engine2d_simd_alpha_edge(dst, scalar, scratch, count)
    rt_simpleos_rvv_engine2d_simd_scroll(dst, scalar, scratch, count)
    rt_simpleos_rvv_engine2d_simd_diagram(dst, scalar, scratch, count)
    Engine2dSimdProducerEvidence(
        arch_code: ENGINE2D_SIMD_ARCH_RISCV64,
        detected_feature_code: ENGINE2D_SIMD_FEATURE_RVV,
        required_feature_code: ENGINE2D_SIMD_FEATURE_RVV,
        vector_width_bits: rt_simpleos_rvv_engine2d_simd_vector_width().to_u32(),
        intrinsic_owner_linked: true, blocked_reason_code: ENGINE2D_SIMD_BLOCK_NONE,
        fill: _rvv_simd_operation(ENGINE2D_SIMD_OP_FILL),
        copy: _rvv_simd_operation(ENGINE2D_SIMD_OP_COPY),
        alpha: _rvv_simd_operation(ENGINE2D_SIMD_OP_ALPHA),
        alpha_edge: _rvv_simd_operation(ENGINE2D_SIMD_OP_ALPHA_EDGE),
        scroll: _rvv_simd_operation(ENGINE2D_SIMD_OP_SCROLL),
        diagram: _rvv_simd_operation(ENGINE2D_SIMD_OP_DIAGRAM),
        frame_checksum: rt_simpleos_rvv_engine2d_simd_metric(ENGINE2D_SIMD_OP_DIAGRAM, 7u32))
