# ============================================================================
# Spec: RISC-V Common (baremetal) — XlenConfig.mask width integrity
# ============================================================================
#
# Mirror of src/lib/hardware/riscv_common/test/riscv_common_xlen_mask_spec.spl
# for the duplicate XlenConfig in this module, which carried the same latent
# 63-bit-mask defect (`mask: 0x7FFFFFFFFFFFFFFF` on an RV64 config documented as
# full-width). See that file's header for why the two copies cannot be asserted
# from a single spec: both declare the struct name `XlenConfig` and collide in
# the global struct registry, so a combined spec silently tests only one of them.
# ============================================================================

use std.nogc_sync_mut.spec.{describe, it, expect_not, assert_true}
use std.nogc_async_mut_noalloc.baremetal.riscv_common.xlen.{XlenConfig}

describe "baremetal XlenConfig.mask width integrity":
    """The XLEN value mask must match the width it claims to describe, so that
    bit 63 of an RV64 word is never silently dropped."""

    it "RV64 mask is a full-width identity mask":
        """An RV64 value masked through .mask comes back unchanged, including
        values whose bit 63 is set."""
        # Toolchain guard: if full-width hex literals do not round-trip
        # exactly, a broken 63-bit mask would compare equal to a correct one
        # and every assertion below would be a false green.
        expect_not(0x7FFFFFFFFFFFFFFF == 0xFFFFFFFFFFFFFFFF)

        val cfg = XlenConfig.rv64()

        # The mask must not be the 63-bit value that caused the defect.
        expect_not(cfg.mask == 0x7FFFFFFFFFFFFFFF)

        # Bit 63 set via sign-extended -1 (all ones).
        val all_ones: i64 = -1
        assert_true((all_ones & cfg.mask) == all_ones)

        # Bit 63 set via mcause's interrupt bit.
        assert_true((cfg.cause_interrupt_bit & cfg.mask) == cfg.cause_interrupt_bit)

        # A representative negative XLEN value must not turn positive.
        val neg: i64 = -2026
        assert_true((neg & cfg.mask) == neg)

        # A wide positive value is unaffected either way.
        val big: i64 = 0x123456789ABCDEF0
        assert_true((big & cfg.mask) == big)

    it "RV32 mask still clamps to 32 bits":
        """RV32 keeps its narrow mask — widening RV64 must not widen RV32."""
        val cfg = XlenConfig.rv32()
        val rv64 = XlenConfig.rv64()

        expect_not(cfg.mask == rv64.mask)

        val all_ones: i64 = -1
        assert_true((all_ones & cfg.mask) == 0xFFFFFFFF)
        assert_true((0x1FFFFFFFF & cfg.mask) == 0xFFFFFFFF)

    it "mask agrees with truncate for both widths":
        """.mask and truncate() are two spellings of one width rule; their
        disagreement is exactly what let the defect stay hidden."""
        val rv64 = XlenConfig.rv64()
        val neg: i64 = -1

        expect_not((neg & rv64.mask) != rv64.truncate(neg))
        assert_true((0x123456789ABCDEF0 & rv64.mask) == rv64.truncate(0x123456789ABCDEF0))

        val rv32 = XlenConfig.rv32()
        assert_true((neg & rv32.mask) == rv32.truncate(neg))
        assert_true((0x1FFFFFFFF & rv32.mask) == rv32.truncate(0x1FFFFFFFF))
