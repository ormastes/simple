# RISC-V barrier / cache-op / wait intrinsics (design A.7 F2)
#
# Every function is exactly one instruction lowered through the MIR
# InlineAsm node (`asm volatile` + implicit `memory` clobber, so the block is
# also a compiler barrier). No runtime call, no allocation. On the host
# interpreter the asm statement is skipped, so each is a no-op there.
#
# Cache-maintenance loops over a range live in `cmo.spl`; the single-line
# primitives here are what such loops call.

fn fence_rw():
    """Full memory fence: `fence rw,rw`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence rw,rw")

fn fence_full():
    """Alias of `fence_rw` (arch-neutral name shared with the other arches)."""
    fence_rw()

fn fence_r():
    """Acquire-style fence: `fence r,rw`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence r,rw")

fn fence_w():
    """Release-style fence: `fence rw,w`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence rw,w")

fn fence_io():
    """Device-memory fence covering I/O and memory: `fence iorw,iorw`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence iorw,iorw")

fn fence_i():
    """Instruction-stream fence: `fence.i` (after writing code)."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence.i")

fn sfence_vma_all():
    """Flush all TLB entries: `sfence.vma`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("sfence.vma")

fn sfence_vma_addr(vaddr: u64):
    """Flush the TLB entry for one virtual address: `sfence.vma {vaddr}`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("sfence.vma {a}", a = in(reg) vaddr)

fn wfi():
    """Wait for interrupt."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("wfi")

fn cpu_relax():
    """Spin-loop hint. `pause` (Zihintpause) IS the encoding `fence w,0`;
    spelled that way so it assembles without the extension enabled and
    is a NOP on cores that lack it."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence w,0")

fn nop():
    unsafe(capabilities: [inline_asm]):
        asm volatile("nop")

fn ebreak():
    """Breakpoint trap."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("ebreak")

export fence_rw, fence_full, fence_r, fence_w, fence_io, fence_i
export sfence_vma_all, sfence_vma_addr, wfi, cpu_relax, nop, ebreak
