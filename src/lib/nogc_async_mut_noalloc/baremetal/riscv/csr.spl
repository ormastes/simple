# RISC-V Control and Status Registers (CSR)
#
# Central CSR registry for M-mode, S-mode, and U-mode registers.
# Provides typed CSR addresses, read/write wrappers via inline asm,
# and bitfield helpers using int.bits[lo..hi] sugar.
#
# This module is the canonical source of CSR addresses — other modules
# (plic, startup, etc.) should import from here rather than re-defining.
#
# Reference: RISC-V Privileged ISA Specification v1.12
#
# ============================================================================
# Machine-mode CSRs (0x300..0x3FF, 0xF00..0xFFF)
# ============================================================================

# Machine Information Registers (read-only)
val CSR_MVENDORID: u64 = 0xF11
val CSR_MARCHID: u64 = 0xF12
val CSR_MIMPID: u64 = 0xF13
val CSR_MHARTID: u64 = 0xF14

# Machine Trap Setup
val CSR_MSTATUS: u64 = 0x300
val CSR_MISA: u64 = 0x301
val CSR_MEDELEG: u64 = 0x302
val CSR_MIDELEG: u64 = 0x303
val CSR_MIE: u64 = 0x304
val CSR_MTVEC: u64 = 0x305
val CSR_MCOUNTEREN: u64 = 0x306

# Machine Trap Handling
val CSR_MSCRATCH: u64 = 0x340
val CSR_MEPC: u64 = 0x341
val CSR_MCAUSE: u64 = 0x342
val CSR_MTVAL: u64 = 0x343
val CSR_MIP: u64 = 0x344

# Machine Memory Protection
val CSR_PMPCFG0: u64 = 0x3A0
val CSR_PMPCFG1: u64 = 0x3A1
val CSR_PMPCFG2: u64 = 0x3A2
val CSR_PMPCFG3: u64 = 0x3A3
val CSR_PMPADDR0: u64 = 0x3B0
val CSR_PMPADDR1: u64 = 0x3B1
val CSR_PMPADDR2: u64 = 0x3B2
val CSR_PMPADDR3: u64 = 0x3B3

# Machine Counter/Timers (read-only)
val CSR_MCYCLE: u64 = 0xB00
val CSR_MINSTRET: u64 = 0xB02

# ============================================================================
# Supervisor-mode CSRs (0x100..0x1FF)
# ============================================================================

# Supervisor Trap Setup
val CSR_SSTATUS: u64 = 0x100
val CSR_SIE: u64 = 0x104
val CSR_STVEC: u64 = 0x105
val CSR_SCOUNTEREN: u64 = 0x106

# Supervisor Trap Handling
val CSR_SSCRATCH: u64 = 0x140
val CSR_SEPC: u64 = 0x141
val CSR_SCAUSE: u64 = 0x142
val CSR_STVAL: u64 = 0x143
val CSR_SIP: u64 = 0x144

# Supervisor Address Translation and Protection
val CSR_SATP: u64 = 0x180

# ============================================================================
# User-mode CSRs (0x000..0x0FF)
# ============================================================================

val CSR_CYCLE: u64 = 0xC00
val CSR_TIME: u64 = 0xC01
val CSR_INSTRET: u64 = 0xC02

# ============================================================================
# MSTATUS Bit Fields (RV64)
# ============================================================================

val MSTATUS_SIE: u64 = 1 << 1      # Supervisor Interrupt Enable
val MSTATUS_MIE: u64 = 1 << 3      # Machine Interrupt Enable
val MSTATUS_SPIE: u64 = 1 << 5     # Supervisor Previous IE
val MSTATUS_MPIE: u64 = 1 << 7     # Machine Previous IE
val MSTATUS_SPP: u64 = 1 << 8      # Supervisor Previous Privilege
val MSTATUS_MPP_MASK: u64 = 3 << 11  # Machine Previous Privilege mask
val MSTATUS_MPP_U: u64 = 0 << 11   # MPP = User mode
val MSTATUS_MPP_S: u64 = 1 << 11   # MPP = Supervisor mode
val MSTATUS_MPP_M: u64 = 3 << 11   # MPP = Machine mode
val MSTATUS_FS_MASK: u64 = 3 << 13 # Floating-point Status mask
val MSTATUS_XS_MASK: u64 = 3 << 15 # Extension Status mask
val MSTATUS_MPRV: u64 = 1 << 17    # Modify PRiVilege
val MSTATUS_SUM: u64 = 1 << 18     # Supervisor User Memory access
val MSTATUS_MXR: u64 = 1 << 19     # Make eXecutable Readable
val MSTATUS_TVM: u64 = 1 << 20     # Trap Virtual Memory
val MSTATUS_TW: u64 = 1 << 21      # Timeout Wait
val MSTATUS_TSR: u64 = 1 << 22     # Trap SRET

# ============================================================================
# MIE / MIP Bit Fields
# ============================================================================

val MIE_SSIE: u64 = 1 << 1   # Supervisor Software Interrupt Enable
val MIE_MSIE: u64 = 1 << 3   # Machine Software Interrupt Enable
val MIE_STIE: u64 = 1 << 5   # Supervisor Timer Interrupt Enable
val MIE_MTIE: u64 = 1 << 7   # Machine Timer Interrupt Enable
val MIE_SEIE: u64 = 1 << 9   # Supervisor External Interrupt Enable
val MIE_MEIE: u64 = 1 << 11  # Machine External Interrupt Enable

# ============================================================================
# MTVEC Mode Fields
# ============================================================================

val MTVEC_MODE_DIRECT: u64 = 0    # All traps to base address
val MTVEC_MODE_VECTORED: u64 = 1  # Interrupts to base + 4*cause

# ============================================================================
# Exception/Interrupt Cause Codes
# ============================================================================

val CAUSE_INTERRUPT_BIT: u64 = 0x8000000000000000

# Interrupt causes (bit 63 set)
val CAUSE_S_SOFTWARE_INTERRUPT: u64 = CAUSE_INTERRUPT_BIT | 1
val CAUSE_M_SOFTWARE_INTERRUPT: u64 = CAUSE_INTERRUPT_BIT | 3
val CAUSE_S_TIMER_INTERRUPT: u64 = CAUSE_INTERRUPT_BIT | 5
val CAUSE_M_TIMER_INTERRUPT: u64 = CAUSE_INTERRUPT_BIT | 7
val CAUSE_S_EXTERNAL_INTERRUPT: u64 = CAUSE_INTERRUPT_BIT | 9
val CAUSE_M_EXTERNAL_INTERRUPT: u64 = CAUSE_INTERRUPT_BIT | 11

# Synchronous exception causes (bit 63 clear)
val CAUSE_INSN_MISALIGNED: u64 = 0
val CAUSE_INSN_ACCESS_FAULT: u64 = 1
val CAUSE_ILLEGAL_INSN: u64 = 2
val CAUSE_BREAKPOINT: u64 = 3
val CAUSE_LOAD_MISALIGNED: u64 = 4
val CAUSE_LOAD_ACCESS_FAULT: u64 = 5
val CAUSE_STORE_MISALIGNED: u64 = 6
val CAUSE_STORE_ACCESS_FAULT: u64 = 7
val CAUSE_ECALL_U: u64 = 8
val CAUSE_ECALL_S: u64 = 9
val CAUSE_ECALL_M: u64 = 11
val CAUSE_INSN_PAGE_FAULT: u64 = 12
val CAUSE_LOAD_PAGE_FAULT: u64 = 13
val CAUSE_STORE_PAGE_FAULT: u64 = 15

# ============================================================================
# CSR Read / Write Intrinsics (design A.7 F1)
# ============================================================================
#
# Each intrinsic lowers to ONE csr instruction through the MIR InlineAsm node
# (no runtime call, no allocation). The CSR number is an instruction
# immediate, so selection is a `match` over the CSR_* constants — one asm site
# per CSR, all of them here rather than in every kernel arch file.
#
# Host / interpreter: the asm statement is not executed. A spec installs
# `csr_test_shim(addrs, values)` to script the values it wants; without a
# shim a read raises E-INTRINSIC-HOST instead of silently returning 0.

@unsafe(reason: "runtime-engine identity probe for the E-INTRINSIC-HOST check", capabilities: [ffi])
extern fn rt_is_interpreter_runtime() -> bool

# Sentinel a real CSR read overwrites; if it survives the asm block on the
# interpreter, the block was skipped (host) rather than executed.
val CSR_HOST_SENTINEL: u64 = 0x51AC5EED0BADC0DE

var csr_shim_active: bool = false
var csr_shim_addrs: [u64] = []
var csr_shim_values: [u64] = []

fn csr_test_shim(addrs: [u64], values: [u64]):
    """Install scripted CSR values for host/interpreter specs (design A.7 F1)."""
    csr_shim_addrs = addrs
    csr_shim_values = values
    csr_shim_active = true

fn csr_test_shim_clear():
    csr_shim_active = false
    csr_shim_addrs = []
    csr_shim_values = []

fn csr_shim_index(addr: u64) -> i64:
    var i = 0
    while i < csr_shim_addrs.len():
        if csr_shim_addrs[i] == addr:
            return i
        i = i + 1
    -1

fn csr_shim_read(addr: u64) -> u64:
    val i = csr_shim_index(addr)
    if i < 0:
        panic("E-INTRINSIC-HOST: csr_read({addr}) has no scripted value in csr_test_shim")
    csr_shim_values[i]

fn csr_shim_write(addr: u64, value: u64):
    val i = csr_shim_index(addr)
    if i < 0:
        csr_shim_addrs.push(addr)
        csr_shim_values.push(value)
    else:
        csr_shim_values[i] = value

fn csr_host_guard(value: u64) -> u64:
    if value == CSR_HOST_SENTINEL:
        unsafe(capabilities: [ffi]):
            if rt_is_interpreter_runtime():
                panic("E-INTRINSIC-HOST: CSR intrinsic executed on the host without csr_test_shim")
    value

# Table form (not a `match`): the seed interpreter mis-evaluates a wide
# literal-arm match on u64 in this module (probe 2026-08-28, filed in
# impl_B_REPORT.md); the native LLVM path is unaffected (objdump shows every arm).
val CSR_SUPPORTED: [u64] = [
    0xF14,  # mhartid
    0x300,  # mstatus
    0x301,  # misa
    0x302,  # medeleg
    0x303,  # mideleg
    0x304,  # mie
    0x305,  # mtvec
    0x306,  # mcounteren
    0x340,  # mscratch
    0x341,  # mepc
    0x342,  # mcause
    0x343,  # mtval
    0x344,  # mip
    0x3A0,  # pmpcfg0
    0x3B0,  # pmpaddr0
    0xB00,  # mcycle
    0x100,  # sstatus
    0x104,  # sie
    0x105,  # stvec
    0x106,  # scounteren
    0x140,  # sscratch
    0x141,  # sepc
    0x142,  # scause
    0x143,  # stval
    0x144,  # sip
    0x180,  # satp
    0xC00,  # cycle
    0xC01,  # time
    0xC02,  # instret
]

fn csr_is_supported(addr: u64) -> bool:
    """True when `addr` has an intrinsic arm (anything else is E-CSR-UNKNOWN)."""
    var i = 0
    while i < CSR_SUPPORTED.len():
        if CSR_SUPPORTED[i] == addr:
            return true
        i = i + 1
    false

fn csr_read(addr: u64) -> u64:
    """Read a CSR (csrr). `addr` must be one of the CSR_* constants."""
    if csr_shim_active:
        return csr_shim_read(addr)
    var value: u64 = CSR_HOST_SENTINEL
    unsafe(capabilities: [inline_asm]):
        match addr:
            case 0xF14:
                asm volatile("csrr {v}, mhartid", v = out(reg) value)
            case 0x300:
                asm volatile("csrr {v}, mstatus", v = out(reg) value)
            case 0x301:
                asm volatile("csrr {v}, misa", v = out(reg) value)
            case 0x302:
                asm volatile("csrr {v}, medeleg", v = out(reg) value)
            case 0x303:
                asm volatile("csrr {v}, mideleg", v = out(reg) value)
            case 0x304:
                asm volatile("csrr {v}, mie", v = out(reg) value)
            case 0x305:
                asm volatile("csrr {v}, mtvec", v = out(reg) value)
            case 0x306:
                asm volatile("csrr {v}, mcounteren", v = out(reg) value)
            case 0x340:
                asm volatile("csrr {v}, mscratch", v = out(reg) value)
            case 0x341:
                asm volatile("csrr {v}, mepc", v = out(reg) value)
            case 0x342:
                asm volatile("csrr {v}, mcause", v = out(reg) value)
            case 0x343:
                asm volatile("csrr {v}, mtval", v = out(reg) value)
            case 0x344:
                asm volatile("csrr {v}, mip", v = out(reg) value)
            case 0x3A0:
                asm volatile("csrr {v}, pmpcfg0", v = out(reg) value)
            case 0x3B0:
                asm volatile("csrr {v}, pmpaddr0", v = out(reg) value)
            case 0xB00:
                asm volatile("csrr {v}, mcycle", v = out(reg) value)
            case 0x100:
                asm volatile("csrr {v}, sstatus", v = out(reg) value)
            case 0x104:
                asm volatile("csrr {v}, sie", v = out(reg) value)
            case 0x105:
                asm volatile("csrr {v}, stvec", v = out(reg) value)
            case 0x106:
                asm volatile("csrr {v}, scounteren", v = out(reg) value)
            case 0x140:
                asm volatile("csrr {v}, sscratch", v = out(reg) value)
            case 0x141:
                asm volatile("csrr {v}, sepc", v = out(reg) value)
            case 0x142:
                asm volatile("csrr {v}, scause", v = out(reg) value)
            case 0x143:
                asm volatile("csrr {v}, stval", v = out(reg) value)
            case 0x144:
                asm volatile("csrr {v}, sip", v = out(reg) value)
            case 0x180:
                asm volatile("csrr {v}, satp", v = out(reg) value)
            case 0xC00:
                asm volatile("csrr {v}, cycle", v = out(reg) value)
            case 0xC01:
                asm volatile("csrr {v}, time", v = out(reg) value)
            case 0xC02:
                asm volatile("csrr {v}, instret", v = out(reg) value)
            case _:
                panic("E-CSR-UNKNOWN: csr_read({addr}) has no intrinsic arm")
    csr_host_guard(value)

fn csr_write(addr: u64, value: u64):
    """Write a CSR (csrw)."""
    if csr_shim_active:
        csr_shim_write(addr, value)
        return
    unsafe(capabilities: [inline_asm]):
        match addr:
            case 0xF14:
                asm volatile("csrw mhartid, {v}", v = in(reg) value)
            case 0x300:
                asm volatile("csrw mstatus, {v}", v = in(reg) value)
            case 0x301:
                asm volatile("csrw misa, {v}", v = in(reg) value)
            case 0x302:
                asm volatile("csrw medeleg, {v}", v = in(reg) value)
            case 0x303:
                asm volatile("csrw mideleg, {v}", v = in(reg) value)
            case 0x304:
                asm volatile("csrw mie, {v}", v = in(reg) value)
            case 0x305:
                asm volatile("csrw mtvec, {v}", v = in(reg) value)
            case 0x306:
                asm volatile("csrw mcounteren, {v}", v = in(reg) value)
            case 0x340:
                asm volatile("csrw mscratch, {v}", v = in(reg) value)
            case 0x341:
                asm volatile("csrw mepc, {v}", v = in(reg) value)
            case 0x342:
                asm volatile("csrw mcause, {v}", v = in(reg) value)
            case 0x343:
                asm volatile("csrw mtval, {v}", v = in(reg) value)
            case 0x344:
                asm volatile("csrw mip, {v}", v = in(reg) value)
            case 0x3A0:
                asm volatile("csrw pmpcfg0, {v}", v = in(reg) value)
            case 0x3B0:
                asm volatile("csrw pmpaddr0, {v}", v = in(reg) value)
            case 0xB00:
                asm volatile("csrw mcycle, {v}", v = in(reg) value)
            case 0x100:
                asm volatile("csrw sstatus, {v}", v = in(reg) value)
            case 0x104:
                asm volatile("csrw sie, {v}", v = in(reg) value)
            case 0x105:
                asm volatile("csrw stvec, {v}", v = in(reg) value)
            case 0x106:
                asm volatile("csrw scounteren, {v}", v = in(reg) value)
            case 0x140:
                asm volatile("csrw sscratch, {v}", v = in(reg) value)
            case 0x141:
                asm volatile("csrw sepc, {v}", v = in(reg) value)
            case 0x142:
                asm volatile("csrw scause, {v}", v = in(reg) value)
            case 0x143:
                asm volatile("csrw stval, {v}", v = in(reg) value)
            case 0x144:
                asm volatile("csrw sip, {v}", v = in(reg) value)
            case 0x180:
                asm volatile("csrw satp, {v}", v = in(reg) value)
            case 0xC00:
                asm volatile("csrw cycle, {v}", v = in(reg) value)
            case 0xC01:
                asm volatile("csrw time, {v}", v = in(reg) value)
            case 0xC02:
                asm volatile("csrw instret, {v}", v = in(reg) value)
            case _:
                panic("E-CSR-UNKNOWN: CSR {addr} has no intrinsic arm")

fn csr_set_bits(addr: u64, mask: u64):
    """Set bits in a CSR (csrs) without touching the others."""
    if csr_shim_active:
        csr_shim_write(addr, csr_shim_read(addr) | mask)
        return
    unsafe(capabilities: [inline_asm]):
        match addr:
            case 0xF14:
                asm volatile("csrs mhartid, {m}", m = in(reg) mask)
            case 0x300:
                asm volatile("csrs mstatus, {m}", m = in(reg) mask)
            case 0x301:
                asm volatile("csrs misa, {m}", m = in(reg) mask)
            case 0x302:
                asm volatile("csrs medeleg, {m}", m = in(reg) mask)
            case 0x303:
                asm volatile("csrs mideleg, {m}", m = in(reg) mask)
            case 0x304:
                asm volatile("csrs mie, {m}", m = in(reg) mask)
            case 0x305:
                asm volatile("csrs mtvec, {m}", m = in(reg) mask)
            case 0x306:
                asm volatile("csrs mcounteren, {m}", m = in(reg) mask)
            case 0x340:
                asm volatile("csrs mscratch, {m}", m = in(reg) mask)
            case 0x341:
                asm volatile("csrs mepc, {m}", m = in(reg) mask)
            case 0x342:
                asm volatile("csrs mcause, {m}", m = in(reg) mask)
            case 0x343:
                asm volatile("csrs mtval, {m}", m = in(reg) mask)
            case 0x344:
                asm volatile("csrs mip, {m}", m = in(reg) mask)
            case 0x3A0:
                asm volatile("csrs pmpcfg0, {m}", m = in(reg) mask)
            case 0x3B0:
                asm volatile("csrs pmpaddr0, {m}", m = in(reg) mask)
            case 0xB00:
                asm volatile("csrs mcycle, {m}", m = in(reg) mask)
            case 0x100:
                asm volatile("csrs sstatus, {m}", m = in(reg) mask)
            case 0x104:
                asm volatile("csrs sie, {m}", m = in(reg) mask)
            case 0x105:
                asm volatile("csrs stvec, {m}", m = in(reg) mask)
            case 0x106:
                asm volatile("csrs scounteren, {m}", m = in(reg) mask)
            case 0x140:
                asm volatile("csrs sscratch, {m}", m = in(reg) mask)
            case 0x141:
                asm volatile("csrs sepc, {m}", m = in(reg) mask)
            case 0x142:
                asm volatile("csrs scause, {m}", m = in(reg) mask)
            case 0x143:
                asm volatile("csrs stval, {m}", m = in(reg) mask)
            case 0x144:
                asm volatile("csrs sip, {m}", m = in(reg) mask)
            case 0x180:
                asm volatile("csrs satp, {m}", m = in(reg) mask)
            case 0xC00:
                asm volatile("csrs cycle, {m}", m = in(reg) mask)
            case 0xC01:
                asm volatile("csrs time, {m}", m = in(reg) mask)
            case 0xC02:
                asm volatile("csrs instret, {m}", m = in(reg) mask)
            case _:
                panic("E-CSR-UNKNOWN: CSR {addr} has no intrinsic arm")

fn csr_clear_bits(addr: u64, mask: u64):
    """Clear bits in a CSR (csrc) without touching the others."""
    if csr_shim_active:
        val cur = csr_shim_read(addr)
        csr_shim_write(addr, cur - (cur & mask))
        return
    unsafe(capabilities: [inline_asm]):
        match addr:
            case 0xF14:
                asm volatile("csrc mhartid, {m}", m = in(reg) mask)
            case 0x300:
                asm volatile("csrc mstatus, {m}", m = in(reg) mask)
            case 0x301:
                asm volatile("csrc misa, {m}", m = in(reg) mask)
            case 0x302:
                asm volatile("csrc medeleg, {m}", m = in(reg) mask)
            case 0x303:
                asm volatile("csrc mideleg, {m}", m = in(reg) mask)
            case 0x304:
                asm volatile("csrc mie, {m}", m = in(reg) mask)
            case 0x305:
                asm volatile("csrc mtvec, {m}", m = in(reg) mask)
            case 0x306:
                asm volatile("csrc mcounteren, {m}", m = in(reg) mask)
            case 0x340:
                asm volatile("csrc mscratch, {m}", m = in(reg) mask)
            case 0x341:
                asm volatile("csrc mepc, {m}", m = in(reg) mask)
            case 0x342:
                asm volatile("csrc mcause, {m}", m = in(reg) mask)
            case 0x343:
                asm volatile("csrc mtval, {m}", m = in(reg) mask)
            case 0x344:
                asm volatile("csrc mip, {m}", m = in(reg) mask)
            case 0x3A0:
                asm volatile("csrc pmpcfg0, {m}", m = in(reg) mask)
            case 0x3B0:
                asm volatile("csrc pmpaddr0, {m}", m = in(reg) mask)
            case 0xB00:
                asm volatile("csrc mcycle, {m}", m = in(reg) mask)
            case 0x100:
                asm volatile("csrc sstatus, {m}", m = in(reg) mask)
            case 0x104:
                asm volatile("csrc sie, {m}", m = in(reg) mask)
            case 0x105:
                asm volatile("csrc stvec, {m}", m = in(reg) mask)
            case 0x106:
                asm volatile("csrc scounteren, {m}", m = in(reg) mask)
            case 0x140:
                asm volatile("csrc sscratch, {m}", m = in(reg) mask)
            case 0x141:
                asm volatile("csrc sepc, {m}", m = in(reg) mask)
            case 0x142:
                asm volatile("csrc scause, {m}", m = in(reg) mask)
            case 0x143:
                asm volatile("csrc stval, {m}", m = in(reg) mask)
            case 0x144:
                asm volatile("csrc sip, {m}", m = in(reg) mask)
            case 0x180:
                asm volatile("csrc satp, {m}", m = in(reg) mask)
            case 0xC00:
                asm volatile("csrc cycle, {m}", m = in(reg) mask)
            case 0xC01:
                asm volatile("csrc time, {m}", m = in(reg) mask)
            case 0xC02:
                asm volatile("csrc instret, {m}", m = in(reg) mask)
            case _:
                panic("E-CSR-UNKNOWN: CSR {addr} has no intrinsic arm")

fn csr_read_write(addr: u64, value: u64) -> u64:
    """Atomically swap a CSR (csrrw), returning the old value."""
    if csr_shim_active:
        val old = csr_shim_read(addr)
        csr_shim_write(addr, value)
        return old
    var old: u64 = CSR_HOST_SENTINEL
    unsafe(capabilities: [inline_asm]):
        match addr:
            case 0xF14:
                asm volatile("csrrw {o}, mhartid, {v}", o = out(reg) old, v = in(reg) value)
            case 0x300:
                asm volatile("csrrw {o}, mstatus, {v}", o = out(reg) old, v = in(reg) value)
            case 0x301:
                asm volatile("csrrw {o}, misa, {v}", o = out(reg) old, v = in(reg) value)
            case 0x302:
                asm volatile("csrrw {o}, medeleg, {v}", o = out(reg) old, v = in(reg) value)
            case 0x303:
                asm volatile("csrrw {o}, mideleg, {v}", o = out(reg) old, v = in(reg) value)
            case 0x304:
                asm volatile("csrrw {o}, mie, {v}", o = out(reg) old, v = in(reg) value)
            case 0x305:
                asm volatile("csrrw {o}, mtvec, {v}", o = out(reg) old, v = in(reg) value)
            case 0x306:
                asm volatile("csrrw {o}, mcounteren, {v}", o = out(reg) old, v = in(reg) value)
            case 0x340:
                asm volatile("csrrw {o}, mscratch, {v}", o = out(reg) old, v = in(reg) value)
            case 0x341:
                asm volatile("csrrw {o}, mepc, {v}", o = out(reg) old, v = in(reg) value)
            case 0x342:
                asm volatile("csrrw {o}, mcause, {v}", o = out(reg) old, v = in(reg) value)
            case 0x343:
                asm volatile("csrrw {o}, mtval, {v}", o = out(reg) old, v = in(reg) value)
            case 0x344:
                asm volatile("csrrw {o}, mip, {v}", o = out(reg) old, v = in(reg) value)
            case 0x3A0:
                asm volatile("csrrw {o}, pmpcfg0, {v}", o = out(reg) old, v = in(reg) value)
            case 0x3B0:
                asm volatile("csrrw {o}, pmpaddr0, {v}", o = out(reg) old, v = in(reg) value)
            case 0xB00:
                asm volatile("csrrw {o}, mcycle, {v}", o = out(reg) old, v = in(reg) value)
            case 0x100:
                asm volatile("csrrw {o}, sstatus, {v}", o = out(reg) old, v = in(reg) value)
            case 0x104:
                asm volatile("csrrw {o}, sie, {v}", o = out(reg) old, v = in(reg) value)
            case 0x105:
                asm volatile("csrrw {o}, stvec, {v}", o = out(reg) old, v = in(reg) value)
            case 0x106:
                asm volatile("csrrw {o}, scounteren, {v}", o = out(reg) old, v = in(reg) value)
            case 0x140:
                asm volatile("csrrw {o}, sscratch, {v}", o = out(reg) old, v = in(reg) value)
            case 0x141:
                asm volatile("csrrw {o}, sepc, {v}", o = out(reg) old, v = in(reg) value)
            case 0x142:
                asm volatile("csrrw {o}, scause, {v}", o = out(reg) old, v = in(reg) value)
            case 0x143:
                asm volatile("csrrw {o}, stval, {v}", o = out(reg) old, v = in(reg) value)
            case 0x144:
                asm volatile("csrrw {o}, sip, {v}", o = out(reg) old, v = in(reg) value)
            case 0x180:
                asm volatile("csrrw {o}, satp, {v}", o = out(reg) old, v = in(reg) value)
            case 0xC00:
                asm volatile("csrrw {o}, cycle, {v}", o = out(reg) old, v = in(reg) value)
            case 0xC01:
                asm volatile("csrrw {o}, time, {v}", o = out(reg) old, v = in(reg) value)
            case 0xC02:
                asm volatile("csrrw {o}, instret, {v}", o = out(reg) old, v = in(reg) value)
            case _:
                panic("E-CSR-UNKNOWN: csr_read_write({addr}) has no intrinsic arm")
    csr_host_guard(old)

# ============================================================================
# MSTATUS Bitfield Helpers (using int.bits[lo..hi] sugar)
# ============================================================================

fn mstatus_get_mpp(status: u64) -> u64:
    """Extract Machine Previous Privilege from mstatus (bits 12:11)."""
    status.bits[11..13]

fn mstatus_set_mpp(status: u64, mode: u64) -> u64:
    """Set Machine Previous Privilege in mstatus."""
    var s = status
    s.bits[11..13] = mode & 0x03
    s

fn mstatus_get_spp(status: u64) -> u64:
    """Extract Supervisor Previous Privilege from mstatus (bit 8)."""
    status.bits[8..9]

fn mstatus_set_spp(status: u64, mode: u64) -> u64:
    """Set Supervisor Previous Privilege in mstatus."""
    var s = status
    s.bits[8..9] = mode & 0x01
    s

fn mstatus_get_fs(status: u64) -> u64:
    """Extract floating-point status (bits 14:13)."""
    status.bits[13..15]

fn mstatus_set_fs(status: u64, fs: u64) -> u64:
    """Set floating-point status field."""
    var s = status
    s.bits[13..15] = fs & 0x03
    s

# ============================================================================
# MTVEC Helpers
# ============================================================================

fn mtvec_encode(base: u64, mode: u64) -> u64:
    """Encode a mtvec value from base address and mode.

    base must be 4-byte aligned (bits 1:0 used for mode).
    mode: 0 = Direct, 1 = Vectored
    """
    (base & ~3) | (mode & 0x03)

fn mtvec_base(mtvec: u64) -> u64:
    """Extract base address from mtvec (clear mode bits)."""
    mtvec & ~3

fn mtvec_mode(mtvec: u64) -> u64:
    """Extract mode from mtvec (bits 1:0)."""
    mtvec & 0x03

# ============================================================================
# MCAUSE Helpers
# ============================================================================

fn mcause_is_interrupt(mcause: u64) -> bool:
    """Check if mcause indicates an interrupt (MSB set)."""
    (mcause & CAUSE_INTERRUPT_BIT) != 0

fn mcause_code(mcause: u64) -> u64:
    """Extract exception/interrupt code from mcause (clear MSB)."""
    mcause & 0x7FFFFFFFFFFFFFFF

# ============================================================================
# CSR Address Classification
# ============================================================================

fn csr_is_readonly(addr: u64) -> bool:
    """Check if a CSR address is read-only (bits 11:10 == 0b11)."""
    ((addr >> 10) & 0x03) == 3

fn csr_privilege_level(addr: u64) -> u64:
    """Extract the minimum privilege level from a CSR address (bits 9:8).

    0 = User, 1 = Supervisor, 3 = Machine
    """
    (addr >> 8) & 0x03

export CAUSE_BREAKPOINT, CAUSE_ECALL_M, CAUSE_ECALL_S, CAUSE_ECALL_U, CAUSE_ILLEGAL_INSN, CAUSE_INSN_ACCESS_FAULT, CAUSE_INSN_MISALIGNED, CAUSE_INSN_PAGE_FAULT, CAUSE_INTERRUPT_BIT, CAUSE_LOAD_ACCESS_FAULT, CAUSE_LOAD_MISALIGNED, CAUSE_LOAD_PAGE_FAULT, CAUSE_M_EXTERNAL_INTERRUPT, CAUSE_M_SOFTWARE_INTERRUPT, CAUSE_M_TIMER_INTERRUPT, CAUSE_S_EXTERNAL_INTERRUPT, CAUSE_S_SOFTWARE_INTERRUPT, CAUSE_S_TIMER_INTERRUPT, CAUSE_STORE_ACCESS_FAULT, CAUSE_STORE_MISALIGNED, CAUSE_STORE_PAGE_FAULT, CSR_CYCLE, CSR_INSTRET, CSR_MARCHID, CSR_MCAUSE, CSR_MCOUNTEREN, CSR_MCYCLE, CSR_MEDELEG, CSR_MEPC, CSR_MHARTID, CSR_MIDELEG, CSR_MIE, CSR_MIMPID, CSR_MINSTRET, CSR_MIP, CSR_MISA, CSR_MSCRATCH, CSR_MSTATUS, CSR_MTVAL, CSR_MTVEC, CSR_MVENDORID, CSR_PMPADDR0, CSR_PMPADDR1, CSR_PMPADDR2, CSR_PMPADDR3, CSR_PMPCFG0, CSR_PMPCFG1, CSR_PMPCFG2, CSR_PMPCFG3, CSR_SATP, CSR_SCAUSE, CSR_SCOUNTEREN, CSR_SEPC, CSR_SIE, CSR_SIP, CSR_SSCRATCH, CSR_SSTATUS, CSR_STVAL, CSR_STVEC, CSR_TIME, MIE_MEIE, MIE_MSIE, MIE_MTIE, MIE_SEIE, MIE_SSIE, MIE_STIE, MSTATUS_FS_MASK, MSTATUS_MIE, MSTATUS_MPIE, MSTATUS_MPP_M, MSTATUS_MPP_MASK, MSTATUS_MPP_S, MSTATUS_MPP_U, MSTATUS_MPRV, MSTATUS_MXR, MSTATUS_SIE, MSTATUS_SPIE, MSTATUS_SPP, MSTATUS_SUM, MSTATUS_TSR, MSTATUS_TVM, MSTATUS_TW, MSTATUS_XS_MASK, MTVEC_MODE_DIRECT, MTVEC_MODE_VECTORED
