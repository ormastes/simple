# x86 Port I/O
#
# Low-level port I/O instructions for x86 bare-metal programming.
# These are used to communicate with hardware devices via I/O ports.
#
# Uses inline assembly for direct hardware access.
# These functions are only meaningful on bare-metal x86 targets.

# Write a byte to an I/O port
# reason: positional baremetal x86 io API
fn outb(port: i32, value: i32):
    # @workaround bug=llvm_inline_asm_dialect_false_green_2026_10_12 recover=b8b0962d41b54d951cf625b0dc64a6c05fdc22c6 reason=LLVM-seed-drops-invalid-Intel-asm
    asm volatile(".intel_syntax noprefix\nout dx, al\n.att_syntax prefix", in(dx) port, in(al) value)

# Read a byte from an I/O port
fn inb(port: i32) -> i32:
    var result = 0
    # @workaround bug=llvm_inline_asm_dialect_false_green_2026_10_12 recover=b8b0962d41b54d951cf625b0dc64a6c05fdc22c6 reason=LLVM-seed-drops-invalid-Intel-asm
    asm volatile(".intel_syntax noprefix\nin al, dx\n.att_syntax prefix", out(al) result, in(dx) port)
    result

# Write a word (16-bit) to an I/O port
# reason: positional baremetal x86 io API
fn outw(port: i32, value: i32):
    # @workaround bug=llvm_inline_asm_dialect_false_green_2026_10_12 recover=b8b0962d41b54d951cf625b0dc64a6c05fdc22c6 reason=LLVM-seed-drops-invalid-Intel-asm
    asm volatile(".intel_syntax noprefix\nout dx, ax\n.att_syntax prefix", in(dx) port, in(ax) value)

# Read a word (16-bit) from an I/O port
fn inw(port: i32) -> i32:
    var result = 0
    # @workaround bug=llvm_inline_asm_dialect_false_green_2026_10_12 recover=b8b0962d41b54d951cf625b0dc64a6c05fdc22c6 reason=LLVM-seed-drops-invalid-Intel-asm
    asm volatile(".intel_syntax noprefix\nin ax, dx\n.att_syntax prefix", out(ax) result, in(dx) port)
    result

# Write a double word (32-bit) to an I/O port
# reason: positional baremetal x86 io API
fn outl(port: i32, value: i32):
    # @workaround bug=llvm_inline_asm_dialect_false_green_2026_10_12 recover=b8b0962d41b54d951cf625b0dc64a6c05fdc22c6 reason=LLVM-seed-drops-invalid-Intel-asm
    asm volatile(".intel_syntax noprefix\nout dx, eax\n.att_syntax prefix", in(dx) port, in(eax) value)

# Read a double word (32-bit) from an I/O port
fn inl(port: i32) -> i32:
    var result = 0
    # @workaround bug=llvm_inline_asm_dialect_false_green_2026_10_12 recover=b8b0962d41b54d951cf625b0dc64a6c05fdc22c6 reason=LLVM-seed-drops-invalid-Intel-asm
    asm volatile(".intel_syntax noprefix\nin eax, dx\n.att_syntax prefix", out(eax) result, in(dx) port)
    result

# I/O wait (short delay) by writing to unused port
# Port 0x80 is traditionally used for POST codes and causes a small delay
fn io_wait():
    outb(0x80, 0)
