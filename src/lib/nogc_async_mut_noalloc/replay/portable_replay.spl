# @platform: baremetal
#
# Portable semantic replay core (DHR P6) — layer-neutral record/replay
# sessions that kernel, realtime and bare-metal code can all share instead of
# each carrying its own event encoding and replay logic.
#
# An event is (kind, scope, value): kind says WHAT was observed (timer read,
# random read, schedule decision, io read, or any layer-defined kind), scope
# says WHERE (the explicitly opened replay scope it was issued in), value is
# the observed result.
#
#   Record  — an in-scope event is appended; the live value is returned.
#   Replay  — an in-scope event returns the LOGGED value for the matching
#             (kind, scope). It never returns the live value: a kind
#             mismatch, scope mismatch or exhausted log is a divergence and
#             returns PR_FAIL_CLOSED_VALUE.
#   Scope   — replay applies only while a scope is explicitly open and the
#             event names that scope. Anything else is live and unlogged.
#
# Sessions: the core holds PR_SESSION_SLOTS independent sessions. A scope id
# owns the session slot `scope mod PR_SESSION_SLOTS`; each session has its
# own mode, open scope, log partition, replay cursor, divergence count and
# completeness, so scopes on different slots (kernel and realtime) record and
# replay concurrently without seeing each other. Two scope ids on the same
# slot share it: only one may be open at a time (open fails closed), and
# replaying the log of one under the other is a scope mismatch.
#
# Storage is one fixed ring of PR_SESSION_SLOTS partitions of PR_CAP events,
# allocated once by portable_replay_reset(); the record and replay paths only
# index into it (no allocation). A record that finds its partition full
# drops the event and counts it on that session only, so that session's log
# is disclosed incomplete and its replay fails closed where the gap starts.

pub val PR_MODE_OFF: i64 = 0
pub val PR_MODE_RECORD: i64 = 1
pub val PR_MODE_REPLAY: i64 = 2

pub val PR_KIND_TIMER_READ: i64 = 1
pub val PR_KIND_RANDOM_READ: i64 = 2
pub val PR_KIND_SCHEDULE: i64 = 3
pub val PR_KIND_IO_READ: i64 = 4

pub val PR_DIV_NONE: i64 = 0
pub val PR_DIV_KIND_MISMATCH: i64 = 1
pub val PR_DIV_SCOPE_MISMATCH: i64 = 2
pub val PR_DIV_LOG_EXHAUSTED: i64 = 3

pub val PR_FAIL_CLOSED_VALUE: i64 = 0

pub val PR_SESSION_SLOTS: i64 = 4
# Scope ids of the in-tree layers; each lands on its own session slot.
pub val PR_SCOPE_REALTIME: i64 = 1
pub val PR_SCOPE_KERNEL: i64 = 2

val PR_CAP: i64 = 4096

var pr_kinds: [i64] = []
var pr_scopes: [i64] = []
var pr_values: [i64] = []
var pr_head: [i64] = []
var pr_count: [i64] = []
var pr_dropped: [i64] = []
var pr_mode: [i64] = []
var pr_scope_open: [bool] = []
var pr_scope_id: [i64] = []
var pr_divergences: [i64] = []
var pr_last_divergence: [i64] = []

pub fn portable_replay_reset():
    """Allocate the ring and session table once and clear every session."""
    portable_replay_alloc()

@allow(primitive_api)  # layer-neutral replay ABI: scope ids are raw i64 codes chosen by each layer
pub fn portable_replay_reset_scope(scope: i64):
    """Clear the session of `scope` (mode, open scope, log, divergences),
    leaving the other sessions untouched. Allocates only on first use."""
    portable_replay_ensure()
    portable_replay_clear_slot(portable_replay_slot(scope))

@allow(primitive_api)  # layer-neutral replay ABI: scope ids and modes are raw i64 codes shared by kernel/realtime/bare-metal
pub fn portable_replay_set_mode(scope: i64, mode: i64):
    """Switch the session of `scope` Off/Record/Replay. Its log and replay
    cursor are kept."""
    portable_replay_ensure()
    pr_mode[portable_replay_slot(scope)] = mode

@allow(primitive_api)  # layer-neutral replay ABI: scope ids and modes are raw i64 codes shared by kernel/realtime/bare-metal
pub fn portable_replay_mode(scope: i64) -> i64:
    if not portable_replay_ready():
        return PR_MODE_OFF
    pr_mode[portable_replay_slot(scope)]

@allow(primitive_api)  # layer-neutral replay ABI: scope ids are raw i64 codes chosen by each layer
pub fn portable_replay_open_scope(scope: i64) -> bool:
    """Open `scope` on its session. Fails closed (false) if that session
    already has a scope open (this one or another on the same slot)."""
    portable_replay_ensure()
    val s = portable_replay_slot(scope)
    if pr_scope_open[s]:
        return false
    pr_scope_open[s] = true
    pr_scope_id[s] = scope
    true

@allow(primitive_api)  # layer-neutral replay ABI: scope ids are raw i64 codes chosen by each layer
pub fn portable_replay_close_scope(scope: i64):
    """Close `scope` if it is the open scope of its session."""
    if not portable_replay_ready():
        return
    val s = portable_replay_slot(scope)
    if pr_scope_open[s] and pr_scope_id[s] == scope:
        pr_scope_open[s] = false
        pr_scope_id[s] = 0

@allow(primitive_api)  # layer-neutral replay ABI: predicate over the raw session state
pub fn portable_replay_scope_is_open(scope: i64) -> bool:
    if not portable_replay_ready():
        return false
    val s = portable_replay_slot(scope)
    pr_scope_open[s] and pr_scope_id[s] == scope

@allow(primitive_api)  # layer-neutral replay ABI: (kind, scope, value) are raw i64 codes from any layer
pub fn portable_replay_event(kind: i64, scope: i64, live: i64) -> i64:
    """Record or replay one semantic event on the session of `scope`; see the
    module header. An event for a scope whose slot holds another open scope
    is live and leaves that session untouched."""
    if not portable_replay_ready():
        return live
    val s = portable_replay_slot(scope)
    if pr_scope_open[s] and pr_scope_id[s] != scope:
        return live
    pr_last_divergence[s] = PR_DIV_NONE
    if pr_mode[s] == PR_MODE_OFF or not pr_scope_open[s]:
        return live
    val base = s * PR_CAP
    if pr_mode[s] == PR_MODE_RECORD:
        if pr_count[s] >= PR_CAP:
            pr_dropped[s] = pr_dropped[s] + 1
            return live
        val tail = base + (pr_head[s] + pr_count[s]) % PR_CAP
        pr_kinds[tail] = kind
        pr_scopes[tail] = scope
        pr_values[tail] = live
        pr_count[s] = pr_count[s] + 1
        return live
    if pr_mode[s] == PR_MODE_REPLAY:
        if pr_count[s] == 0:
            return portable_replay_diverge(s, PR_DIV_LOG_EXHAUSTED)
        val at = base + pr_head[s]
        pr_head[s] = (pr_head[s] + 1) % PR_CAP
        pr_count[s] = pr_count[s] - 1
        if pr_kinds[at] != kind:
            return portable_replay_diverge(s, PR_DIV_KIND_MISMATCH)
        if pr_scopes[at] != scope:
            return portable_replay_diverge(s, PR_DIV_SCOPE_MISMATCH)
        return pr_values[at]
    live

@allow(primitive_api)  # internal: scope id to session slot index
fn portable_replay_slot(scope: i64) -> i64:
    val m = scope % PR_SESSION_SLOTS
    if m < 0:
        return m + PR_SESSION_SLOTS
    m

@allow(primitive_api)  # internal: predicate over the raw session table
fn portable_replay_ready() -> bool:
    pr_mode.len() == PR_SESSION_SLOTS

fn portable_replay_ensure():
    if not portable_replay_ready():
        portable_replay_alloc()

fn portable_replay_alloc():
    pr_kinds = []
    pr_scopes = []
    pr_values = []
    var i: i64 = 0
    while i < PR_SESSION_SLOTS * PR_CAP:
        pr_kinds.push(0)
        pr_scopes.push(0)
        pr_values.push(0)
        i = i + 1
    pr_head = []
    pr_count = []
    pr_dropped = []
    pr_mode = []
    pr_scope_open = []
    pr_scope_id = []
    pr_divergences = []
    pr_last_divergence = []
    var s: i64 = 0
    while s < PR_SESSION_SLOTS:
        pr_head.push(0)
        pr_count.push(0)
        pr_dropped.push(0)
        pr_mode.push(PR_MODE_OFF)
        pr_scope_open.push(false)
        pr_scope_id.push(0)
        pr_divergences.push(0)
        pr_last_divergence.push(PR_DIV_NONE)
        s = s + 1

@allow(primitive_api)  # internal: session slot index
fn portable_replay_clear_slot(s: i64):
    pr_head[s] = 0
    pr_count[s] = 0
    pr_dropped[s] = 0
    pr_mode[s] = PR_MODE_OFF
    pr_scope_open[s] = false
    pr_scope_id[s] = 0
    pr_divergences[s] = 0
    pr_last_divergence[s] = PR_DIV_NONE

@allow(primitive_api)  # internal: records a raw divergence code on a slot and returns the fail-closed value
fn portable_replay_diverge(s: i64, reason: i64) -> i64:
    pr_divergences[s] = pr_divergences[s] + 1
    pr_last_divergence[s] = reason
    PR_FAIL_CLOSED_VALUE

@allow(primitive_api)  # layer-neutral replay ABI: divergence reason is a raw i64 code
pub fn portable_replay_last_divergence(scope: i64) -> i64:
    """Divergence reason of the most recent event of the session of `scope`
    (PR_DIV_NONE if it matched)."""
    if not portable_replay_ready():
        return PR_DIV_NONE
    pr_last_divergence[portable_replay_slot(scope)]

@allow(primitive_api)  # layer-neutral replay ABI: raw counter
pub fn portable_replay_divergence_count(scope: i64) -> i64:
    if not portable_replay_ready():
        return 0
    pr_divergences[portable_replay_slot(scope)]

@allow(primitive_api)  # layer-neutral replay ABI: raw counter
pub fn portable_replay_pending(scope: i64) -> i64:
    """Logged events of the session of `scope` not yet consumed by replay."""
    if not portable_replay_ready():
        return 0
    pr_count[portable_replay_slot(scope)]

@allow(primitive_api)  # layer-neutral replay ABI: raw counter
pub fn portable_replay_dropped(scope: i64) -> i64:
    if not portable_replay_ready():
        return 0
    pr_dropped[portable_replay_slot(scope)]

@allow(primitive_api)  # layer-neutral replay ABI: predicate over the raw session state
pub fn portable_replay_complete(scope: i64) -> bool:
    """False once a record on the session of `scope` dropped an event: that
    log is no longer whole. Other sessions are unaffected."""
    portable_replay_dropped(scope) == 0
