# Fixed Map - Linear-Probe Hash Map with Fixed Capacity
#
# Open-addressing hash map using linear probing.
# Backed by parallel primitive arrays (keys: [i64], values: [i64],
# occupied: [bool]) — avoids array-of-struct so put()/remove() never
# construct a new entry object per operation (native codegen also emits no
# stubs for this shape; same reasoning FixedSet already documents).
# Fixed capacity, reserved once at construction; no heap growth or
# per-operation allocation after that. NOT genuinely inline/stack storage —
# see fixed_array.spl's header for the language-feature gap (`[T; N]` is
# parsed but discarded).
#
# Usage:
#   val map = FixedMap.new(32)
#   map.put(42, 100)
#   val v = map.get(42)


# ============================================================================
# FixedMap - Open-Addressing Hash Map
# ============================================================================

class FixedMap:
    """Fixed-capacity hash map with linear probing.

    Keys and values are i64. Uses a simple hash function
    suitable for integer keys. Load factor should stay below 75%
    for good performance.

    Backed by parallel primitive arrays reserved once at construction.
    put()/remove() write by plain index assignment — no entry object is
    ever constructed after new().
    """
    keys: [i64]
    values: [i64]
    occupied: [bool]
    count: i32
    capacity: i32

    static fn new(capacity: i32) -> FixedMap:
        """Create a new hash map with the given capacity.

        Backing storage is reserved to full capacity here, once.
        """
        var ks: [i64] = []
        var vs: [i64] = []
        var occ: [bool] = []
        var i = 0
        while i < capacity:
            ks.push(0)
            vs.push(0)
            occ.push(false)
            i = i + 1
        FixedMap(keys: ks, values: vs, occupied: occ, count: 0, capacity: capacity)

    fn hash_index(key: i64) -> i32:
        """Compute hash index for key. Simple multiplicative hash."""
        # Knuth multiplicative hash (golden ratio constant)
        var h = key * 2654435761
        if h < 0:
            h = 0 - h
        h % self.capacity

    me put(key: i64, value: i64) -> bool:
        """Insert or update key-value pair. Returns false if map is full."""
        var idx = self.hash_index(key)
        var probes = 0
        while probes < self.capacity:
            if not self.occupied[idx]:
                # Empty slot — insert
                self.keys[idx] = key
                self.values[idx] = value
                self.occupied[idx] = true
                self.count = self.count + 1
                return true
            if self.keys[idx] == key:
                # Key exists — update
                self.values[idx] = value
                return true
            # Linear probe
            idx = (idx + 1) % self.capacity
            probes = probes + 1
        false

    fn get(key: i64) -> i64:
        """Get value for key. Returns 0 if not found."""
        var idx = self.hash_index(key)
        var probes = 0
        while probes < self.capacity:
            if not self.occupied[idx]:
                return 0
            if self.keys[idx] == key:
                return self.values[idx]
            idx = (idx + 1) % self.capacity
            probes = probes + 1
        0

    fn contains(key: i64) -> bool:
        """Check if key exists in map."""
        var idx = self.hash_index(key)
        var probes = 0
        while probes < self.capacity:
            if not self.occupied[idx]:
                return false
            if self.keys[idx] == key:
                return true
            idx = (idx + 1) % self.capacity
            probes = probes + 1
        false

    me remove(key: i64) -> bool:
        """Remove key from map. Returns false if not found.

        Uses backward-shift deletion to maintain probe chains.
        """
        var idx = self.hash_index(key)
        var probes = 0
        while probes < self.capacity:
            if not self.occupied[idx]:
                return false
            if self.keys[idx] == key:
                # Found — remove and fix probe chain
                self.keys[idx] = 0
                self.values[idx] = 0
                self.occupied[idx] = false
                self.count = self.count - 1
                # Backward-shift: rehash subsequent entries
                var next_idx = (idx + 1) % self.capacity
                while self.occupied[next_idx]:
                    val next_key = self.keys[next_idx]
                    val next_value = self.values[next_idx]
                    val ideal = self.hash_index(next_key)
                    # Check if next_idx is displaced from its ideal position
                    # past the gap we just created
                    if (next_idx > idx and (ideal <= idx or ideal > next_idx)) or (next_idx < idx and ideal <= idx and ideal > next_idx):
                        self.keys[idx] = next_key
                        self.values[idx] = next_value
                        self.occupied[idx] = true
                        self.occupied[next_idx] = false
                        idx = next_idx
                    next_idx = (next_idx + 1) % self.capacity
                return true
            idx = (idx + 1) % self.capacity
            probes = probes + 1
        false

    fn is_empty() -> bool:
        """Check if map has no entries."""
        self.count == 0

    fn is_full() -> bool:
        """Check if map is at capacity."""
        self.count >= self.capacity

    fn size() -> i32:
        """Return number of entries."""
        self.count
