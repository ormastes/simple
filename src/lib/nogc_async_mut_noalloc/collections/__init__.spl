# Collections Module - Fixed-Capacity Data Structures
#
# All collections enforce a bounded capacity, checked before every insert.
# Backing storage is a heap array reserved once at construction and never
# grown or shrunk again during steady-state use (post-construction) — this
# is NOT "no dynamic allocation": construction itself allocates, and Simple
# has no language feature for genuinely inline/stack-embedded fixed-size
# array storage today (`[T; N]` is parsed but its size is discarded; see
# fixed_array.spl's header and
# doc/08_tracking/bug/noalloc_collections_backed_by_growable_heap_array_2026-08-07.md).
# Suitable for bare-metal and embedded environments where per-operation
# heap churn (not one-time construction cost) is the concern.
#
# Public API:
#   - use std.collections.{FixedArray, fixed_array_8, fixed_array_16, ...}
#   - use std.collections.{PoolLinkedList}
#   - use std.collections.{RingBuffer, ring_buffer_16, ring_buffer_32, ...}
#   - use std.collections.{FixedStack}
#   - use std.collections.{FixedMap}

# All submodules are automatically available.

# Re-exported from fixed_array.spl
export FixedArray
export fixed_array_8, fixed_array_16, fixed_array_32, fixed_array_64
export fixed_array_128, fixed_array_256

# Re-exported from fixed_map.spl
export FixedMap

# Re-exported from fixed_set.spl
export FixedSet

# Re-exported from fixed_stack.spl
export FixedStack

# Re-exported from linked_list.spl
export PoolLinkedList

# Re-exported from ring_buffer.spl
export RingBuffer
export ring_buffer_16, ring_buffer_32, ring_buffer_64, ring_buffer_128
