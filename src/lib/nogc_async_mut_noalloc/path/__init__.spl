# Path Module - Bare-Metal Path Handling
#
# Minimal path operations for semihosting file I/O.
# Always uses forward slashes. Host debugger handles OS path resolution.
#
# Public API:
#   - use std.path.{bm_path_normalize, bm_path_join, bm_path_basename, ...}
#   - use std.path.{bm_file_open, bm_file_write, bm_file_close}

# All submodules are automatically available.

# Re-exported from baremetal_path.spl
use nogc_async_mut_noalloc.path.baremetal_path.{
    PATH_SEP, MAX_PATH_LEN,
    bm_path_normalize, bm_path_join, bm_path_basename,
    bm_path_dirname, bm_path_extension,
    bm_file_open, bm_file_write, bm_file_close
}
export PATH_SEP, MAX_PATH_LEN from nogc_async_mut_noalloc.path.baremetal_path
export bm_path_normalize, bm_path_join, bm_path_basename from nogc_async_mut_noalloc.path.baremetal_path
export bm_path_dirname, bm_path_extension from nogc_async_mut_noalloc.path.baremetal_path
export bm_file_open, bm_file_write, bm_file_close from nogc_async_mut_noalloc.path.baremetal_path
