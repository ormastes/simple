@unsafe(reason: "reads the runtime's monotonic heap-allocation registry counter", capabilities: [ffi])
extern fn rt_heap_registry_count() -> i64

pub enum KpfRuntimeAllocationStatus:
    NotActivated
    Clean
    AllocationDetected
    CounterRegression

pub class KpfAllocationProbe:
    activated: bool
    baseline_count: i64

    pub static fn create() -> KpfAllocationProbe:
        KpfAllocationProbe(activated: false, baseline_count: 0)

    pub me activate():
        self.baseline_count = rt_heap_registry_count()
        self.activated = true

    pub fn status() -> KpfRuntimeAllocationStatus:
        if not self.activated:
            return KpfRuntimeAllocationStatus.NotActivated
        val current_count = rt_heap_registry_count()
        if current_count < self.baseline_count:
            return KpfRuntimeAllocationStatus.CounterRegression
        if current_count != self.baseline_count:
            return KpfRuntimeAllocationStatus.AllocationDetected
        KpfRuntimeAllocationStatus.Clean

    pub fn allocation_count() -> u64:
        if not self.activated:
            return 0u64
        val current_count = rt_heap_registry_count()
        if current_count <= self.baseline_count:
            return 0u64
        (current_count - self.baseline_count) as u64
