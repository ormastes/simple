pub enum KpfFixedArenaStatus:
    Ok
    CapacityExceeded
    InvalidAmount
    NotConfiguring

pub class KpfFixedArena:
    capacity_bytes: u64
    used_bytes: u64
    high_water_bytes: u64
    configuring: bool

    pub static fn create(capacity_bytes: u64) -> KpfFixedArena:
        KpfFixedArena(
            capacity_bytes: capacity_bytes,
            used_bytes: 0u64,
            high_water_bytes: 0u64,
            configuring: true,
        )

    pub me reserve_configuration(amount: u64) -> KpfFixedArenaStatus:
        if not self.configuring:
            return KpfFixedArenaStatus.NotConfiguring
        self.reserve_bounded(amount)

    pub me activate():
        self.configuring = false

    pub me reserve_active(amount: u64) -> KpfFixedArenaStatus:
        if self.configuring:
            return KpfFixedArenaStatus.NotConfiguring
        self.reserve_bounded(amount)

    pub me release(amount: u64) -> KpfFixedArenaStatus:
        if amount > self.used_bytes:
            return KpfFixedArenaStatus.InvalidAmount
        self.used_bytes = self.used_bytes - amount
        KpfFixedArenaStatus.Ok
    pub fn capacity() -> u64:
        self.capacity_bytes

    pub fn used() -> u64:
        self.used_bytes

    pub fn available() -> u64:
        self.capacity_bytes - self.used_bytes

    pub fn high_water() -> u64:
        self.high_water_bytes

    me reserve_bounded(amount: u64) -> KpfFixedArenaStatus:
        if amount == 0u64:
            return KpfFixedArenaStatus.InvalidAmount
        if amount > self.capacity_bytes - self.used_bytes:
            return KpfFixedArenaStatus.CapacityExceeded
        self.used_bytes = self.used_bytes + amount
        if self.used_bytes > self.high_water_bytes:
            self.high_water_bytes = self.used_bytes
        KpfFixedArenaStatus.Ok
