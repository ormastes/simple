pub enum KpfAllocationProofStatus:
    Configuring
    Clean
    Violated
    InvalidObservation

pub struct KpfAllocationProofReceipt:
    status: KpfAllocationProofStatus
    activation_total: u64
    observed_total: u64
    post_activation_allocations: u64

pub class KpfAllocationProof:
    activated: bool
    activation_total_value: u64
    observed_total_value: u64

    pub static fn create() -> KpfAllocationProof:
        KpfAllocationProof(
            activated: false,
            activation_total_value: 0u64,
            observed_total_value: 0u64,
        )

    pub me activate(allocator_total: u64) -> KpfAllocationProofStatus:
        if self.activated:
            return KpfAllocationProofStatus.InvalidObservation
        self.activated = true
        self.activation_total_value = allocator_total
        self.observed_total_value = allocator_total
        KpfAllocationProofStatus.Clean

    pub me observe(allocator_total: u64) -> KpfAllocationProofStatus:
        if not self.activated or allocator_total < self.observed_total_value:
            return KpfAllocationProofStatus.InvalidObservation
        self.observed_total_value = allocator_total
        if allocator_total == self.activation_total_value:
            return KpfAllocationProofStatus.Clean
        KpfAllocationProofStatus.Violated

    pub fn receipt() -> KpfAllocationProofReceipt:
        if not self.activated:
            return KpfAllocationProofReceipt(
                status: KpfAllocationProofStatus.Configuring,
                activation_total: 0u64,
                observed_total: 0u64,
                post_activation_allocations: 0u64,
            )
        var status = KpfAllocationProofStatus.Clean
        if self.observed_total_value != self.activation_total_value:
            status = KpfAllocationProofStatus.Violated
        KpfAllocationProofReceipt(
            status: status,
            activation_total: self.activation_total_value,
            observed_total: self.observed_total_value,
            post_activation_allocations: self.observed_total_value - self.activation_total_value,
        )
