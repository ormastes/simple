# ============================================================================
# Skia → Engine2D bridge
#
# Additive bridge that replays a recorded skia SkPicture onto the shared
# Engine2D RenderBackend. This lets the skia 2D API (SkCanvas / SkPicture)
# render through the SAME SIMD-CPU / GPU backend lanes as the rest of the 2D
# stack — selectable via SIMPLE_2D_BACKEND or the explicit `backend_name`
# argument.
#
# This module does NOT modify skia's SkCanvas / SkPicture API. It only WALKS
# the already-recorded op list and issues equivalent Engine2D draw calls.
#
# Mapping:
#   DrawRect  + Fill paint     -> Engine2D.draw_rect_filled  (mapped_rects)
#   DrawRect  + Stroke paint   -> Engine2D.draw_rect          (mapped_rects)
#   DrawPaint                  -> whole-canvas draw_rect_filled (mapped_rects)
#   DrawRRect                  -> Engine2D.draw_rounded_rect  (mapped_rects)
#   DrawOval                   -> Engine2D.draw_ellipse[_filled] (mapped_ovals)
#   DrawImage                  -> Engine2D.draw_image         (mapped_images)
#   DrawPath / DrawText / DrawTextBlob / DrawPoints
#                              -> counted as skipped in preview, rejected by
#                                 strict preflight
#
# Color model: SkColor is a packed i64 ARGB (0xAARRGGBB); Engine2D pixels are
# u32 ARGB in the same layout, so the conversion is a direct .to_u32() cast.
#
# IMPLEMENTATION NOTE: The entire op loop is kept INSIDE a single function
# body. The Engine2D handle is a local `val` that is created, drawn onto,
# presented, and read back without ever crossing a function-call boundary
# inside this module — passing the engine into a helper fn here loses the
# mutations (interpreter copies class params across a library-module call).
# ============================================================================

use std.skia.entity.picture.{SkPicture, SkPictureOp, SkPictureOpKind}
use std.skia.entity.enums.{SkPaintStyle, SkBlendMode, SkColorType, SkAlphaType}
use std.skia.entity.image.{SkImage}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.helpers_availability.{backend_canonical_name}

# ----------------------------------------------------------------------------
# Report describing how many ops were mapped vs skipped.
# ----------------------------------------------------------------------------
class BridgeReport:
    mapped_rects: i32
    mapped_images: i32
    mapped_ovals: i32
    skipped: i32
    lossy: i32
    complete: bool
    reason: text
    readback_source: text

# ----------------------------------------------------------------------------
# Result of a reported render: the framebuffer pixels plus the coverage report.
# ----------------------------------------------------------------------------
class BridgeRenderResult:
    pixels: [u32]
    report: BridgeReport

# ----------------------------------------------------------------------------
# Color: SkColor (packed i64 ARGB) -> Engine2D u32 ARGB. Direct cast.
# ----------------------------------------------------------------------------
fn sk_color_to_u32(c: i64) -> u32:
    (c & 0xFFFFFFFF).to_u32()

fn _bridge_exact_i32(value: f64) -> bool:
    value >= -2147483648.0 and value <= 2147483647.0 and value == value.to_i64().to_f64()

fn _bridge_image_shape_valid(image: SkImage) -> bool:
    val width = image.info.width
    val height = image.info.height
    if width <= 0 or height <= 0 or width > 2147483647 or height > 2147483647:
        return false
    val channels = image.pixels.len().to_i64()
    if channels % 4 != 0:
        return false
    val pixel_count = channels / 4
    pixel_count / width == height and pixel_count % width == 0

fn _bridge_readback_source_valid(backend_name: text, source: text) -> bool:
    val backend = backend_canonical_name(backend_name)
    if backend == "cpu" or backend == "cpu_simd" or backend == "software":
        return source == "cpu_mirror" or source == "software"
    source == "device_readback"

# ----------------------------------------------------------------------------
# SkImage.pixels stores 4 i64 entries per pixel (one channel-byte each, in
# A,R,G,B order). Pack them into a flat [u32] ARGB array for Engine2D.draw_image.
# Pure function (no Engine2D), safe to call across a module boundary.
# ----------------------------------------------------------------------------
fn sk_image_to_u32_pixels(image: SkImage) -> [u32]:
    val w = image.info.width
    val h = image.info.height
    val count = w * h
    var out: [u32] = [0u32 for _ in 0..count]
    val raw = image.pixels
    var i = 0
    while i < count:
        val base = i * 4
        var a = 0i64
        var r = 0i64
        var g = 0i64
        var b = 0i64
        if base + 3 < raw.len():
            a = raw[base] & 0xFF
            r = raw[base + 1] & 0xFF
            g = raw[base + 2] & 0xFF
            b = raw[base + 3] & 0xFF
        val packed = (a << 24) | (r << 16) | (g << 8) | b
        out[i] = packed.to_u32()
        i = i + 1
    out

# Preflight is pure and scans the whole picture before the strict path creates
# an Engine2D. The preview path may still draw approximations, but its receipt
# must name the first unsupported or lossy operation.
fn skia_picture_engine2d_preflight(picture: SkPicture) -> BridgeReport:
    var mapped_rects = 0
    var mapped_images = 0
    var mapped_ovals = 0
    var skipped = 0
    var lossy = 0
    var reason = ""
    var index = 0
    for op in picture.ops:
        var issue = ""
        if op.kind == SkPictureOpKind.DrawRect or op.kind == SkPictureOpKind.DrawPaint or op.kind == SkPictureOpKind.DrawRRect:
            mapped_rects = mapped_rects + 1
        elif op.kind == SkPictureOpKind.DrawOval:
            mapped_ovals = mapped_ovals + 1
        elif op.kind == SkPictureOpKind.DrawImage:
            if val img = op.image:
                mapped_images = mapped_images + 1
                if not _bridge_image_shape_valid(img):
                    issue = "image-pixels"
                elif img.info.color_type != SkColorType.Rgba8888:
                    issue = "image-color-type"
                elif img.info.alpha_type == SkAlphaType.Unknown:
                    issue = "image-alpha-type"
                else:
                    # Opaque pixels have identical premultiplied and straight
                    # channel values. Other alpha needs a defined conversion.
                    var channel_index = 0
                    for channel in img.pixels:
                        if issue == "" and (channel < 0 or channel > 255):
                            issue = "image-channel-range"
                        elif issue == "" and channel_index % 4 == 0 and channel != 255:
                            issue = "image-alpha"
                        channel_index = channel_index + 1
            else:
                skipped = skipped + 1
                issue = "image-missing"
        else:
            skipped = skipped + 1
            issue = "unsupported-op"

        if issue == "" and (op.kind == SkPictureOpKind.DrawRect or op.kind == SkPictureOpKind.DrawPaint or op.kind == SkPictureOpKind.DrawRRect or op.kind == SkPictureOpKind.DrawOval or op.kind == SkPictureOpKind.DrawImage):
            if op.paint.blend_mode != SkBlendMode.SrcOver:
                issue = "paint-blend-mode"
            elif op.kind != SkPictureOpKind.DrawImage and ((op.paint.color >> 24) & 0xFF) != 255:
                issue = "paint-alpha"
            elif op.kind == SkPictureOpKind.DrawImage and ((op.paint.color >> 24) & 0xFF) != 255:
                issue = "image-paint-alpha"
            elif op.kind != SkPictureOpKind.DrawPaint and op.paint.anti_alias:
                issue = "paint-anti-alias"
            elif (op.kind == SkPictureOpKind.DrawRect or op.kind == SkPictureOpKind.DrawRRect or op.kind == SkPictureOpKind.DrawOval) and op.paint.style != SkPaintStyle.Fill:
                issue = "paint-stroke"
            elif op.kind == SkPictureOpKind.DrawRect or op.kind == SkPictureOpKind.DrawRRect or op.kind == SkPictureOpKind.DrawOval:
                val rect = op.rect
                if not _bridge_exact_i32(rect.left) or not _bridge_exact_i32(rect.top) or not _bridge_exact_i32(rect.right) or not _bridge_exact_i32(rect.bottom) or not _bridge_exact_i32(rect.right - rect.left) or not _bridge_exact_i32(rect.bottom - rect.top) or rect.right <= rect.left or rect.bottom <= rect.top:
                    issue = "geometry-truncated"
                elif op.kind == SkPictureOpKind.DrawRRect and (op.rx != op.ry or not _bridge_exact_i32(op.rx) or op.rx < 0.0):
                    issue = "rrect-radius"
                elif op.kind == SkPictureOpKind.DrawRRect and op.rx > 0.0:
                    # Engine2D's rounded-corner emulation emits fractional
                    # coverage even when SkPaint requests hard edges.
                    issue = "rrect-coverage-anti-alias"
                elif op.kind == SkPictureOpKind.DrawOval and (not _bridge_exact_i32((rect.left + rect.right) / 2.0) or not _bridge_exact_i32((rect.top + rect.bottom) / 2.0) or not _bridge_exact_i32((rect.right - rect.left) / 2.0) or not _bridge_exact_i32((rect.bottom - rect.top) / 2.0)):
                    issue = "oval-center-truncated"
            elif op.kind == SkPictureOpKind.DrawImage and (not _bridge_exact_i32(op.x) or not _bridge_exact_i32(op.y)):
                issue = "image-position-truncated"

        if issue != "":
            if issue != "unsupported-op" and issue != "image-missing":
                lossy = lossy + 1
            if reason == "":
                reason = "op {index}: {issue}"
        index = index + 1
    BridgeReport(mapped_rects: mapped_rects, mapped_images: mapped_images, mapped_ovals: mapped_ovals, skipped: skipped, lossy: lossy, complete: skipped == 0 and lossy == 0, reason: reason, readback_source: "not_requested")

# ----------------------------------------------------------------------------
# Primary reported entrypoint: render a recorded SkPicture through a shared
# Engine2D backend lane (SIMD CPU / GPU, selected by `backend_name`) and read
# back the resulting framebuffer plus the op-coverage report.
#
# The whole op loop is inlined here so the engine never crosses a function
# boundary inside this module.
# ----------------------------------------------------------------------------
fn skia_render_picture_on_engine2d_reported(picture: SkPicture, width: i32, height: i32, backend_name: text) -> BridgeRenderResult:
    var coverage = skia_picture_engine2d_preflight(picture)
    val eng = Engine2D.create_with_backend(width, height, backend_name)

    for op in picture.ops:
        if op.kind == SkPictureOpKind.DrawRect:
            val rect = op.rect
            val x = rect.left.to_i64() as i32
            val y = rect.top.to_i64() as i32
            val w = (rect.right - rect.left).to_i64() as i32
            val h = (rect.bottom - rect.top).to_i64() as i32
            val color = sk_color_to_u32(op.paint.color)
            if op.paint.style == SkPaintStyle.Fill:
                eng.draw_rect_filled(x, y, w, h, color)
            else:
                # Stroke (and draw_line, which records as a Stroke DrawRect)
                # maps to the outline primitive, not a filled block.
                eng.draw_rect(x, y, w, h, color)
        elif op.kind == SkPictureOpKind.DrawPaint:
            # DrawPaint fills the entire canvas with the paint colour.
            eng.draw_rect_filled(0, 0, width, height, sk_color_to_u32(op.paint.color))
        elif op.kind == SkPictureOpKind.DrawRRect:
            val rect = op.rect
            val x = rect.left.to_i64() as i32
            val y = rect.top.to_i64() as i32
            val w = (rect.right - rect.left).to_i64() as i32
            val h = (rect.bottom - rect.top).to_i64() as i32
            # Engine2D takes a single corner radius; skia carries rx/ry, so the
            # larger of the two is used.
            var radius = op.rx
            if op.ry > radius:
                radius = op.ry
            eng.draw_rounded_rect(x, y, w, h, radius.to_i64() as i32, sk_color_to_u32(op.paint.color))
        elif op.kind == SkPictureOpKind.DrawOval:
            val rect = op.rect
            val cx = ((rect.left + rect.right) / 2.0).to_i64() as i32
            val cy = ((rect.top + rect.bottom) / 2.0).to_i64() as i32
            val rx = ((rect.right - rect.left) / 2.0).to_i64() as i32
            val ry = ((rect.bottom - rect.top) / 2.0).to_i64() as i32
            val color = sk_color_to_u32(op.paint.color)
            if op.paint.style == SkPaintStyle.Fill:
                eng.draw_ellipse_filled(cx, cy, rx, ry, color)
            else:
                eng.draw_ellipse(cx, cy, rx, ry, color)
        elif op.kind == SkPictureOpKind.DrawImage:
            if val img = op.image:
                if _bridge_image_shape_valid(img):
                    val pixels = sk_image_to_u32_pixels(img)
                    val x = op.x.to_i64() as i32
                    val y = op.y.to_i64() as i32
                    val w = img.info.width as i32
                    val h = img.info.height as i32
                    eng.draw_image(x, y, w, h, pixels)
        # Preflight records missing images and unsupported ops in the receipt.

    eng.present()
    val readback = eng.read_pixels_with_source()
    coverage.readback_source = readback.source
    val expected_pixels = width.to_i64() * height.to_i64()
    if readback.pixel_count != expected_pixels or readback.pixels.len().to_i64() != expected_pixels:
        coverage.complete = false
        if coverage.reason == "":
            coverage.reason = "readback-size"
    elif backend_canonical_name(eng.backend_name()) != backend_canonical_name(backend_name):
        coverage.complete = false
        if coverage.reason == "":
            coverage.reason = "backend-fallback"
    elif not _bridge_readback_source_valid(backend_name, readback.source):
        coverage.complete = false
        if coverage.reason == "":
            coverage.reason = "readback-source: {readback.source}"
    BridgeRenderResult(pixels: readback.pixels, report: coverage)

# Strict callers receive no pixels if any operation cannot be replayed exactly
# by this bridge. Preflight covers the complete picture before engine creation.
fn skia_render_picture_on_engine2d_strict(picture: SkPicture, width: i32, height: i32, backend_name: text) -> Result<BridgeRenderResult, text>:
    if width <= 0 or height <= 0:
        return Err("invalid-canvas-size")
    val coverage = skia_picture_engine2d_preflight(picture)
    if not coverage.complete:
        return Err(coverage.reason)
    val result = skia_render_picture_on_engine2d_reported(picture, width, height, backend_name)
    if not result.report.complete:
        return Err(result.report.reason)
    Ok(result)

# ----------------------------------------------------------------------------
# Convenience entrypoint: strict rendering with a flat ARGB framebuffer on
# success. Call the reported entrypoint for an explicitly incomplete preview.
# ----------------------------------------------------------------------------
fn skia_render_picture_on_engine2d(picture: SkPicture, width: i32, height: i32, backend_name: text) -> Result<[u32], text>:
    match skia_render_picture_on_engine2d_strict(picture, width, height, backend_name):
        Ok(result): Ok(result.pixels)
        Err(reason): Err(reason)
