# Candidate adapter for a completed native Ganesh corpus case 02 frame.

use std.gc_async_mut.gpu.browser_engine.web_opaque_box_qualification.{
    WebOpaqueBoxGpuScene}
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow,
    file_hash_sha256}
use std.common.crypto.sha256.{sha256_text}
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU, DRAW_IR_BACKEND_GPU,
    DRAW_IR_SCHEMA_VERSION_V4}
use common.ui.draw_ir_sdn.{draw_ir_to_sdn}
use common.renderdoc.corpus_case02_polygon_oracle.{
    CORPUS_CASE02_FIXTURE_ID, CORPUS_CASE02_SOURCE_PATH,
    CORPUS_CASE02_SOURCE_SHA256, CORPUS_CASE02_WIDTH,
    CORPUS_CASE02_HEIGHT, case02_capture_matches_oracle}
use common.renderdoc.physical_vulkan_2d_qualification.{
    PreparedRenderScene, VulkanBackendCaptureArtifact}
use std.skia.backend.upstream_ganesh_vulkan.provider.{
    UpstreamSkiaGaneshFrame, upstream_skia_ganesh_vulkan_final_capture,
    UPSTREAM_SKIA_GANESH_VULKAN_PROVIDER_IDENTITY}

fn _native_uuid_valid(value: text) -> bool:
    if value.len() != 32 or value == "00000000000000000000000000000000":
        return false
    var index = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if not ((code >= 48 and code <= 57) or
            (code >= 97 and code <= 102)):
            return false
        index = index + 1
    true

fn _physical_device_type(value: i64) -> text:
    if value == 1: "integrated"
    elif value == 2: "discrete"
    else: ""

fn _upstream_skia_case02_web_projection_valid(
    web: WebOpaqueBoxGpuScene
) -> bool:
    if web.source_draw_ir_sha256.len() != 64 or
        web.gpu_draw_ir_sha256.len() != 64 or
        web.source_draw_ir_sha256 != sha256_text(draw_ir_to_sdn(web.source_draw_ir)) or
        web.gpu_draw_ir_sha256 != sha256_text(draw_ir_to_sdn(web.gpu_draw_ir)) or
        web.source_command_count != 6 or web.gpu_command_count != 6 or
        web.source_command_indexes.len() != 6 or
        web.source_draw_ir.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        web.gpu_draw_ir.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        web.source_draw_ir.backend_target != DRAW_IR_BACKEND_CPU or
        web.gpu_draw_ir.backend_target != DRAW_IR_BACKEND_GPU or
        web.source_draw_ir.batches.len() != 1 or
        web.gpu_draw_ir.batches.len() != 1:
        return false
    val source = web.source_draw_ir.batches[0]
    val gpu = web.gpu_draw_ir.batches[0]
    if source.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        gpu.schema != DRAW_IR_SCHEMA_VERSION_V4 or
        source.commands.len() != 6 or gpu.commands.len() != 6 or
        source.embedding.width != CORPUS_CASE02_WIDTH or
        source.embedding.height != CORPUS_CASE02_HEIGHT or
        gpu.embedding.width != CORPUS_CASE02_WIDTH or
        gpu.embedding.height != CORPUS_CASE02_HEIGHT:
        return false
    var index = 0
    while index < 6:  # cpu-lane-loop-ok: fixed six-command case 02 mapping check
        if web.source_command_indexes[index] != index.to_i64() or
            gpu.commands[index].component_id != source.commands[index].component_id or
            gpu.commands[index].color != source.commands[index].color:
            return false
        index = index + 1
    true

pub fn upstream_skia_corpus_case02_artifact(
    frame: UpstreamSkiaGaneshFrame,
    scene: PreparedRenderScene,
    web: WebOpaqueBoxGpuScene
) -> Result<VulkanBackendCaptureArtifact, text>:
    if scene.fixture_id != CORPUS_CASE02_FIXTURE_ID or
        scene.source_path != CORPUS_CASE02_SOURCE_PATH or
        scene.source_sha256 != CORPUS_CASE02_SOURCE_SHA256 or
        scene.scene_scope != "corpus-case02-fractional-edges-only" or
        scene.render_degraded or scene.degrade_reason != "" or
        web.html_sha256 != scene.source_sha256 or
        not _upstream_skia_case02_web_projection_valid(web) or
        not file_is_regular_no_follow(CORPUS_CASE02_SOURCE_PATH) or
        file_hash_sha256(CORPUS_CASE02_SOURCE_PATH) !=
            CORPUS_CASE02_SOURCE_SHA256:
        return Err("upstream Skia corpus case 02 source admission invalid")
    if frame.provider_identity != UPSTREAM_SKIA_GANESH_VULKAN_PROVIDER_IDENTITY or
        frame.backend_handle <= 0 or frame.device_identity < 0 or
        frame.device_submit_count != 1 or frame.device_wait_count != 1 or
        frame.device_readback_count != 1 or frame.resource_id <= 0 or
        frame.submission_token <= 0 or
        frame.completion_token != frame.submission_token:
        return Err("upstream Skia corpus case 02 completion missing")
    if frame.width != CORPUS_CASE02_WIDTH or
        frame.height != CORPUS_CASE02_HEIGHT:
        return Err("upstream Skia corpus case 02 extent invalid")
    val device_type = _physical_device_type(frame.device_type)
    if device_type == "":
        return Err("upstream Skia physical Vulkan device required")
    if not _native_uuid_valid(frame.physical_device_uuid) or
        not _native_uuid_valid(frame.driver_uuid) or
        frame.vendor_id < 0 or frame.device_id < 0 or
        frame.api_version <= 0 or frame.driver_version < 0:
        return Err("upstream Skia native device provenance missing")
    val frame_id = "{scene.fixture_id}-{frame.submission_token}"
    match upstream_skia_ganesh_vulkan_final_capture(
        frame, scene.fixture_id, scene.source_sha256, frame_id):
        case Err(reason): Err(reason)
        case Ok(capture):
            val oracle_verdict = case02_capture_matches_oracle(capture)?
            if not oracle_verdict.passed:
                return Err("upstream Skia corpus case 02 edge oracle mismatch")
            Ok(VulkanBackendCaptureArtifact(
                backend_id: "upstream-skia-ganesh-vulkan",
                fixture_id: scene.fixture_id,
                fixture_sha256: scene.source_sha256,
                producer_authenticated: true,
                provider_identity: frame.provider_identity,
                device_name: "vulkan-vendor-{frame.vendor_id}-device-{frame.device_id}",
                device_type: device_type,
                driver_identity: "vulkan-api-{frame.api_version}-driver-{frame.driver_version}",
                physical_device_uuid: frame.physical_device_uuid,
                driver_uuid: frame.driver_uuid,
                device_identity: frame.device_identity,
                backend_handle: frame.backend_handle,
                submit_count: frame.device_submit_count,
                fence_count: frame.device_wait_count,
                readback_source: "device_readback",
                fallback_required: false,
                capture: Some(capture)))
