# CPU rasterization primitives — grayscale-coverage scanline rasterizer

use std.skia.entity.geometry.{SkRect, SkIRect, SkPoint}
use std.skia.entity.path.{SkPath, SkPathVerb, SkPathSegment}
use std.skia.entity.paint.{SkPaint}
use std.skia.entity.color.{SkColor4f}
use std.skia.entity.enums.{SkPaintStyle, SkPathFillType}

# ============================================================================
# Internal math helpers
# ============================================================================

fn _min_f64(a: f64, b: f64) -> f64:
    if a < b: a else: b

fn _max_f64(a: f64, b: f64) -> f64:
    if a > b: a else: b

fn _min_i64(a: i64, b: i64) -> i64:
    if a < b: a else: b

fn _max_i64(a: i64, b: i64) -> i64:
    if a > b: a else: b

fn _clamp_f64(v: f64, lo: f64, hi: f64) -> f64:
    if v < lo: lo else: if v > hi: hi else: v

fn _abs_f64(v: f64) -> f64:
    if v < 0.0: 0.0 - v else: v

fn _floor_i64(v: f64) -> i64:
    val iv = v as i64
    if (iv as f64) > v: iv - 1 else: iv

fn _ceil_i64(v: f64) -> i64:
    val iv = v as i64
    if (iv as f64) < v: iv + 1 else: iv

fn _sqrt_f64(v: f64) -> f64:
    if v <= 0.0:
        0.0
    else:
        var x = v
        var i = 0
        while i < 20:
            x = (x + v / x) * 0.5
            i = i + 1
        x

fn _clamp_u8(v: f64) -> u8:
    val clamped = _clamp_f64(v, 0.0, 255.0)
    clamped as u8

# ============================================================================
# Bitmap — RGBA premultiplied, row-major, 4 bytes per pixel
# ============================================================================

class Bitmap:
    width: i64
    height: i64
    pixels: [u8]

    static fn zeros(w: i64, h: i64) -> Bitmap:
        # Preallocate 4*w*h in one shot; the i64 product keeps the absurd-size
        # case from wrapping the way an i32 multiply would.
        val total = w * h * 4
        Bitmap(width: w, height: h, pixels: [0u8; total])

    me set_pixel(x: i64, y: i64, color: SkColor4f):
        if x >= 0 and x < me.width and y >= 0 and y < me.height:
            val idx = (y * me.width + x) * 4
            me.pixels[idx]     = _clamp_u8(color.r * 255.0)
            me.pixels[idx + 1] = _clamp_u8(color.g * 255.0)
            me.pixels[idx + 2] = _clamp_u8(color.b * 255.0)
            me.pixels[idx + 3] = _clamp_u8(color.a * 255.0)

    me blend_pixel(x: i64, y: i64, color: SkColor4f, coverage: f64):
        if coverage <= 0.0:
            pass_do_nothing
        else:
            if x >= 0 and x < me.width and y >= 0 and y < me.height:
                val idx = (y * me.width + x) * 4
                val dr = (me.pixels[idx] as f64) / 255.0
                val dg = (me.pixels[idx + 1] as f64) / 255.0
                val db = (me.pixels[idx + 2] as f64) / 255.0
                val da = (me.pixels[idx + 3] as f64) / 255.0
                val eff_a = color.a * coverage
                val ia = 1.0 - eff_a
                val nr = color.r * eff_a + dr * ia
                val ng = color.g * eff_a + dg * ia
                val nb = color.b * eff_a + db * ia
                val na = eff_a + da * ia
                me.pixels[idx]     = _clamp_u8(nr * 255.0)
                me.pixels[idx + 1] = _clamp_u8(ng * 255.0)
                me.pixels[idx + 2] = _clamp_u8(nb * 255.0)
                me.pixels[idx + 3] = _clamp_u8(na * 255.0)

# ============================================================================
# fill_rect — axis-aligned rectangle with analytic edge AA
# ============================================================================

fn fill_rect(bitmap: Bitmap, rect: SkRect, color: SkColor4f):
    if rect.left >= rect.right or rect.top >= rect.bottom:
        pass_do_nothing
    else:
        val x0 = _max_i64(_floor_i64(rect.left), 0)
        val y0 = _max_i64(_floor_i64(rect.top), 0)
        val x1 = _min_i64(_ceil_i64(rect.right), bitmap.width)
        val y1 = _min_i64(_ceil_i64(rect.bottom), bitmap.height)
        var py = y0
        while py < y1:
            var px = x0
            while px < x1:
                val pxf = px as f64
                val pyf = py as f64
                val cx_lo = _max_f64(pxf, rect.left)
                val cx_hi = _min_f64(pxf + 1.0, rect.right)
                val cy_lo = _max_f64(pyf, rect.top)
                val cy_hi = _min_f64(pyf + 1.0, rect.bottom)
                val cov_x = _max_f64(cx_hi - cx_lo, 0.0)
                val cov_y = _max_f64(cy_hi - cy_lo, 0.0)
                val cov = cov_x * cov_y
                # Always composite (source-over, premultiplied canvas): a
                # full-coverage set_pixel overwrote what was underneath and
                # stored a translucent colour un-premultiplied.
                if cov > 0.0:
                    bitmap.blend_pixel(px, py, color, _min_f64(cov, 1.0))
                px = px + 1
            py = py + 1

# ============================================================================
# fill_rrect — rounded rectangle (uniform radii) with per-corner ellipse AA
# ============================================================================

fn _corner_coverage(pxf: f64, pyf: f64, ccx: f64, ccy: f64, rx: f64, ry: f64) -> f64:
    # 4x4 supersampling of quarter-ellipse at pixel (pxf, pyf) with corner center (ccx, ccy)
    var hits = 0
    var sy = 0
    while sy < 4:
        var sx = 0
        while sx < 4:
            val fx = pxf + (sx as f64 + 0.5) / 4.0
            val fy = pyf + (sy as f64 + 0.5) / 4.0
            val ex = (fx - ccx) / rx
            val ey = (fy - ccy) / ry
            if ex * ex + ey * ey <= 1.0:
                hits = hits + 1
            sx = sx + 1
        sy = sy + 1
    (hits as f64) / 16.0

fn fill_rrect(bitmap: Bitmap, rect: SkRect, rx: f64, ry: f64, color: SkColor4f):
    if rx <= 0.0 or ry <= 0.0:
        fill_rect(bitmap, rect, color)
    else:
        val clamp_rx = _min_f64(rx, (rect.right - rect.left) / 2.0)
        val clamp_ry = _min_f64(ry, (rect.bottom - rect.top) / 2.0)
        val ccx_left  = rect.left  + clamp_rx
        val ccx_right = rect.right - clamp_rx
        val ccy_top   = rect.top   + clamp_ry
        val ccy_bot   = rect.bottom - clamp_ry
        val x0 = _max_i64(_floor_i64(rect.left), 0)
        val y0 = _max_i64(_floor_i64(rect.top), 0)
        val x1 = _min_i64(_ceil_i64(rect.right), bitmap.width)
        val y1 = _min_i64(_ceil_i64(rect.bottom), bitmap.height)
        var py = y0
        while py < y1:
            var px = x0
            while px < x1:
                val pxf = px as f64
                val pyf = py as f64
                val pcx = pxf + 0.5
                val pcy = pyf + 0.5
                val in_left_band  = pcx < ccx_left
                val in_right_band = pcx > ccx_right
                val in_top_band   = pcy < ccy_top
                val in_bot_band   = pcy > ccy_bot
                val in_corner = (in_left_band or in_right_band) and (in_top_band or in_bot_band)
                if in_corner:
                    val ccx = if in_left_band: ccx_left else: ccx_right
                    val ccy = if in_top_band: ccy_top else: ccy_bot
                    val cov = _corner_coverage(pxf, pyf, ccx, ccy, clamp_rx, clamp_ry)
                    if cov > 0.0:
                        bitmap.blend_pixel(px, py, color, _min_f64(cov, 1.0))
                else:
                    # standard rect edge coverage
                    val cx_lo = _max_f64(pxf, rect.left)
                    val cx_hi = _min_f64(pxf + 1.0, rect.right)
                    val cy_lo = _max_f64(pyf, rect.top)
                    val cy_hi = _min_f64(pyf + 1.0, rect.bottom)
                    val cov_x = _max_f64(cx_hi - cx_lo, 0.0)
                    val cov_y = _max_f64(cy_hi - cy_lo, 0.0)
                    val cov = cov_x * cov_y
                    if cov > 0.0:
                        bitmap.blend_pixel(px, py, color, _min_f64(cov, 1.0))
                px = px + 1
            py = py + 1

# ============================================================================
# Edge record for scanline fill
# ============================================================================

class _Edge:
    """One non-horizontal line segment, stored top-down with its winding
    direction; y extents are kept fractional so coverage can be sampled at
    sub-scanline positions."""
    x_top: f64
    y_top: f64
    y_bot: f64
    dx_per_y: f64
    dir: i64

fn _make_edge(x0: f64, y0: f64, x1: f64, y1: f64) -> Option<_Edge>:
    if _abs_f64(y1 - y0) < 0.0001:
        None
    else:
        if y0 < y1:
            Some(_Edge(x_top: x0, y_top: y0, y_bot: y1, dx_per_y: (x1 - x0) / (y1 - y0), dir: 1))
        else:
            Some(_Edge(x_top: x1, y_top: y1, y_bot: y0, dx_per_y: (x0 - x1) / (y0 - y1), dir: -1))

# ============================================================================
# Path edge collection — flatten all verbs to line segments
# ============================================================================

fn _collect_edges(path: SkPath) -> [_Edge]:
    var edges: [_Edge] = []
    var cur_x = 0.0
    var cur_y = 0.0
    var start_x = 0.0
    var start_y = 0.0
    var i = 0
    while i < path.segments.len():
        val seg = path.segments[i]
        if seg.verb == SkPathVerb.Move:
            # A fill closes every contour: an open one gets its closing edge.
            val close_opt = _make_edge(cur_x, cur_y, start_x, start_y)
            if val ce = close_opt:
                edges.push(ce)
            cur_x = seg.pts[0].x
            cur_y = seg.pts[0].y
            start_x = cur_x
            start_y = cur_y
        else:
            if seg.verb == SkPathVerb.Line:
                val tx = seg.pts[0].x
                val ty = seg.pts[0].y
                val me_opt = _make_edge(cur_x, cur_y, tx, ty)
                if val e = me_opt:
                    edges.push(e)
                cur_x = tx
                cur_y = ty
            else:
                if seg.verb == SkPathVerb.Close:
                    val me_opt = _make_edge(cur_x, cur_y, start_x, start_y)
                    if val e = me_opt:
                        edges.push(e)
                    cur_x = start_x
                    cur_y = start_y
                else:
                    if seg.verb == SkPathVerb.Quad:
                        val p1x = seg.pts[0].x
                        val p1y = seg.pts[0].y
                        val p2x = seg.pts[1].x
                        val p2y = seg.pts[1].y
                        var step = 0
                        var prev_x = cur_x
                        var prev_y = cur_y
                        while step < 8:
                            step = step + 1
                            val t = (step as f64) / 8.0
                            val mt = 1.0 - t
                            val nx = mt * mt * cur_x + 2.0 * mt * t * p1x + t * t * p2x
                            val ny = mt * mt * cur_y + 2.0 * mt * t * p1y + t * t * p2y
                            val me_opt = _make_edge(prev_x, prev_y, nx, ny)
                            if val e = me_opt:
                                edges.push(e)
                            prev_x = nx
                            prev_y = ny
                        cur_x = p2x
                        cur_y = p2y
                    else:
                        if seg.verb == SkPathVerb.Conic:
                            val p1x = seg.pts[0].x
                            val p1y = seg.pts[0].y
                            val p2x = seg.pts[1].x
                            val p2y = seg.pts[1].y
                            var step = 0
                            var prev_x = cur_x
                            var prev_y = cur_y
                            while step < 8:
                                step = step + 1
                                val t = (step as f64) / 8.0
                                val mt = 1.0 - t
                                val nx = mt * mt * cur_x + 2.0 * mt * t * p1x + t * t * p2x
                                val ny = mt * mt * cur_y + 2.0 * mt * t * p1y + t * t * p2y
                                val me_opt = _make_edge(prev_x, prev_y, nx, ny)
                                if val e = me_opt:
                                    edges.push(e)
                                prev_x = nx
                                prev_y = ny
                            cur_x = p2x
                            cur_y = p2y
                        else:
                            if seg.verb == SkPathVerb.Cubic:
                                val p1x = seg.pts[0].x
                                val p1y = seg.pts[0].y
                                val p2x = seg.pts[1].x
                                val p2y = seg.pts[1].y
                                val p3x = seg.pts[2].x
                                val p3y = seg.pts[2].y
                                var step = 0
                                var prev_x = cur_x
                                var prev_y = cur_y
                                while step < 16:
                                    step = step + 1
                                    val t = (step as f64) / 16.0
                                    val mt = 1.0 - t
                                    val nx = mt*mt*mt*cur_x + 3.0*mt*mt*t*p1x + 3.0*mt*t*t*p2x + t*t*t*p3x
                                    val ny = mt*mt*mt*cur_y + 3.0*mt*mt*t*p1y + 3.0*mt*t*t*p2y + t*t*t*p3y
                                    val me_opt = _make_edge(prev_x, prev_y, nx, ny)
                                    if val e = me_opt:
                                        edges.push(e)
                                    prev_x = nx
                                    prev_y = ny
                                cur_x = p3x
                                cur_y = p3y
                            else:
                                pass_do_nothing
        i = i + 1
    val last_close = _make_edge(cur_x, cur_y, start_x, start_y)
    if val ce = last_close:
        edges.push(ce)
    edges

# ============================================================================
# fill_path_aa — coverage-accumulating scanline fill
# ============================================================================

# Sub-scanlines per pixel row; each samples the path at y = row + (k + 0.5) / N.
val _AA_SUBROWS: i64 = 4

fn fill_path_aa(bitmap: Bitmap, path: SkPath, color: SkColor4f):
    """Anti-aliased path fill. Each pixel row is sampled on _AA_SUBROWS
    sub-scanlines at fractional y; on each, the crossings are sorted, the
    winding (nonzero) or parity (even-odd) rule selects the inside spans,
    and their exact horizontal overlap with every pixel column accumulates
    into a coverage row. Each touched pixel is blended ONCE with its
    coverage clamped to 1."""
    if path.segments.len() == 0:
        return
    val edges = _collect_edges(path)
    if edges.len() == 0:
        return
    var y_lo = edges[0].y_top
    var y_hi = edges[0].y_bot
    var ei = 1
    while ei < edges.len():
        if edges[ei].y_top < y_lo:
            y_lo = edges[ei].y_top
        if edges[ei].y_bot > y_hi:
            y_hi = edges[ei].y_bot
        ei = ei + 1
    val row0 = _max_i64(_floor_i64(y_lo), 0)
    val row1 = _min_i64(_ceil_i64(y_hi), bitmap.height)
    val even_odd = path.fill_type == SkPathFillType.EvenOdd or path.fill_type == SkPathFillType.InverseEvenOdd
    val w = bitmap.width
    val weight = 1.0 / (_AA_SUBROWS as f64)
    var cov: [f64] = [0.0; w + 1]
    var py = row0
    while py < row1:
        val top = py as f64
        var active: [i64] = []
        var k = 0
        while k < edges.len():
            if edges[k].y_top < top + 1.0 and edges[k].y_bot > top:
                active.push(k)
            k = k + 1
        if active.len() > 0:
            var sub = 0
            while sub < _AA_SUBROWS:
                val y = top + ((sub as f64) + 0.5) * weight
                var xs: [f64] = []
                var dirs: [i64] = []
                for ai in active:
                    val e = edges[ai]
                    if e.y_top <= y and y < e.y_bot:
                        val x = e.x_top + e.dx_per_y * (y - e.y_top)
                        # insertion keeps the crossings sorted by x
                        var pos = xs.len()
                        xs.push(x)
                        dirs.push(e.dir)
                        while pos > 0 and xs[pos - 1] > x:
                            xs[pos] = xs[pos - 1]
                            dirs[pos] = dirs[pos - 1]
                            pos = pos - 1
                        xs[pos] = x
                        dirs[pos] = e.dir
                var winding = 0 as i64
                var xi = 0
                while xi + 1 < xs.len():
                    winding = winding + dirs[xi]
                    val inside = if even_odd: (winding % 2) != 0 else: winding != 0
                    if inside:
                        # exact horizontal overlap of [xa, xb) with each column
                        var xa = xs[xi]
                        var xb = xs[xi + 1]
                        if xa < 0.0:
                            xa = 0.0
                        if xb > (w as f64):
                            xb = w as f64
                        if xa < xb:
                            val pa = _floor_i64(xa)
                            val pb = _floor_i64(xb)
                            if pa == pb:
                                cov[pa] = cov[pa] + (xb - xa) * weight
                            else:
                                cov[pa] = cov[pa] + ((pa as f64) + 1.0 - xa) * weight
                                var p = pa + 1
                                while p < pb:
                                    cov[p] = cov[p] + weight
                                    p = p + 1
                                cov[pb] = cov[pb] + (xb - (pb as f64)) * weight
                    xi = xi + 1
                sub = sub + 1
            var px = 0
            while px < w:
                val c = cov[px]
                if c > 0.0:
                    bitmap.blend_pixel(px, py, color, if c > 1.0: 1.0 else: c)
                    cov[px] = 0.0
                px = px + 1
        py = py + 1

# ============================================================================
# stroke_path — widen each edge to a filled quad
# ============================================================================

fn _draw_thick_segment(bitmap: Bitmap, x0: f64, y0: f64, x1: f64, y1: f64, half_w: f64, color: SkColor4f):
    val dx = x1 - x0
    val dy = y1 - y0
    val len = _sqrt_f64(dx * dx + dy * dy)
    if len >= 0.0001:
        val nx = (0.0 - dy) / len * half_w
        val ny = dx / len * half_w
        val ax = x0 + nx
        val ay = y0 + ny
        val bx = x1 + nx
        val by = y1 + ny
        val cx = x1 - nx
        val cy = y1 - ny
        val dx2 = x0 - nx
        val dy2 = y0 - ny
        val seg_move  = SkPathSegment(verb: SkPathVerb.Move, pts: [SkPoint(x: ax, y: ay)], weight: 0.0)
        val seg_line1 = SkPathSegment(verb: SkPathVerb.Line, pts: [SkPoint(x: bx, y: by)], weight: 0.0)
        val seg_line2 = SkPathSegment(verb: SkPathVerb.Line, pts: [SkPoint(x: cx, y: cy)], weight: 0.0)
        val seg_line3 = SkPathSegment(verb: SkPathVerb.Line, pts: [SkPoint(x: dx2, y: dy2)], weight: 0.0)
        val seg_close = SkPathSegment(verb: SkPathVerb.Close, pts: [], weight: 0.0)
        val segs = [seg_move, seg_line1, seg_line2, seg_line3, seg_close]
        val quad_path = SkPath(fill_type: SkPathFillType.Winding, segments: segs)
        fill_path_aa(bitmap, quad_path, color)

fn stroke_path(bitmap: Bitmap, path: SkPath, color: SkColor4f, width: f64):
    val half_w = width / 2.0
    var cur_x = 0.0
    var cur_y = 0.0
    var start_x = 0.0
    var start_y = 0.0
    var i = 0
    while i < path.segments.len():
        val seg = path.segments[i]
        if seg.verb == SkPathVerb.Move:
            cur_x = seg.pts[0].x
            cur_y = seg.pts[0].y
            start_x = cur_x
            start_y = cur_y
        else:
            if seg.verb == SkPathVerb.Line:
                val tx = seg.pts[0].x
                val ty = seg.pts[0].y
                _draw_thick_segment(bitmap, cur_x, cur_y, tx, ty, half_w, color)
                cur_x = tx
                cur_y = ty
            else:
                if seg.verb == SkPathVerb.Close:
                    _draw_thick_segment(bitmap, cur_x, cur_y, start_x, start_y, half_w, color)
                    cur_x = start_x
                    cur_y = start_y
                else:
                    if seg.verb == SkPathVerb.Quad:
                        val p1x = seg.pts[0].x
                        val p1y = seg.pts[0].y
                        val p2x = seg.pts[1].x
                        val p2y = seg.pts[1].y
                        var step = 0
                        var prev_x = cur_x
                        var prev_y = cur_y
                        while step < 8:
                            step = step + 1
                            val t = (step as f64) / 8.0
                            val mt = 1.0 - t
                            val nx = mt * mt * cur_x + 2.0 * mt * t * p1x + t * t * p2x
                            val ny = mt * mt * cur_y + 2.0 * mt * t * p1y + t * t * p2y
                            _draw_thick_segment(bitmap, prev_x, prev_y, nx, ny, half_w, color)
                            prev_x = nx
                            prev_y = ny
                        cur_x = p2x
                        cur_y = p2y
                    else:
                        if seg.verb == SkPathVerb.Conic:
                            val p1x = seg.pts[0].x
                            val p1y = seg.pts[0].y
                            val p2x = seg.pts[1].x
                            val p2y = seg.pts[1].y
                            var step = 0
                            var prev_x = cur_x
                            var prev_y = cur_y
                            while step < 8:
                                step = step + 1
                                val t = (step as f64) / 8.0
                                val mt = 1.0 - t
                                val nx = mt * mt * cur_x + 2.0 * mt * t * p1x + t * t * p2x
                                val ny = mt * mt * cur_y + 2.0 * mt * t * p1y + t * t * p2y
                                _draw_thick_segment(bitmap, prev_x, prev_y, nx, ny, half_w, color)
                                prev_x = nx
                                prev_y = ny
                            cur_x = p2x
                            cur_y = p2y
                        else:
                            if seg.verb == SkPathVerb.Cubic:
                                val p1x = seg.pts[0].x
                                val p1y = seg.pts[0].y
                                val p2x = seg.pts[1].x
                                val p2y = seg.pts[1].y
                                val p3x = seg.pts[2].x
                                val p3y = seg.pts[2].y
                                var step = 0
                                var prev_x = cur_x
                                var prev_y = cur_y
                                while step < 16:
                                    step = step + 1
                                    val t = (step as f64) / 16.0
                                    val mt = 1.0 - t
                                    val nx = mt*mt*mt*cur_x + 3.0*mt*mt*t*p1x + 3.0*mt*t*t*p2x + t*t*t*p3x
                                    val ny = mt*mt*mt*cur_y + 3.0*mt*mt*t*p1y + 3.0*mt*t*t*p2y + t*t*t*p3y
                                    _draw_thick_segment(bitmap, prev_x, prev_y, nx, ny, half_w, color)
                                    prev_x = nx
                                    prev_y = ny
                                cur_x = p3x
                                cur_y = p3y
                            else:
                                pass_do_nothing
        i = i + 1
