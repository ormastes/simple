use std.skia.feature.glyph.ot_parser.{OtFont, read_u16_be, read_u32_be}
use std.skia.feature.glyph.ot_parser_layout.{GposLookup, LayoutLookupActivation}
use std.skia.feature.shaper.ot_layout_context.{LayoutGlyphRecord, LayoutApplyResult,
    layout_context_lookup_flag_valid}
use std.skia.feature.shaper.ot_layout_gpos_data.{GposDataBudget, gpos_data_budget,
    gpos_data_take, gpos_data_coverage, gpos_data_class, gpos_data_class_valid}
use std.skia.feature.shaper.ot_layout_gpos_basic.{GposBasicStep, GposBasicState,
    gpos_basic_next, gpos_basic_previous, gpos_basic_match, gpos_basic_apply,
    gpos_basic_validate}
class _Extension:
    kind: u32
    subtable: i64
    valid: bool
class _RuleState:
    positions: [i64]
    records: i64
    record_count: i64
    next: i64
    valid: bool
    matched: bool
fn _copy(records: [LayoutGlyphRecord]) -> [LayoutGlyphRecord]:
    var copied: [LayoutGlyphRecord] = []
    for record in records:
        copied.push(LayoutGlyphRecord(glyph_id: record.glyph_id, source_index: record.source_index,
            cluster: record.cluster, feature_mask: record.feature_mask, x_advance_units: record.x_advance_units,
            y_advance_units: record.y_advance_units, x_offset_units: record.x_offset_units,
            y_offset_units: record.y_offset_units, component_clusters: record.component_clusters))
    copied
fn _end(lookup: GposLookup, subtable: i64) -> i64:
    if subtable < 0 or subtable >= lookup.subtable_ends.len(): return -1
    lookup.subtable_ends[subtable] as i64
fn _extension(blob: [u8], subtable: i64, limit: i64) -> _Extension:
    if subtable < 0 or subtable + 8 > limit or read_u16_be(blob, subtable) != 1u32:
        return _Extension(kind: 0u32, subtable: 0, valid: false)
    val kind = read_u16_be(blob, subtable + 2)
    val offset = read_u32_be(blob, subtable + 4) as i64
    val target = subtable + offset
    if (kind == 9u32 or kind < 1u32 or kind > 8u32 or offset < 8 or
        target < subtable or target + 2 > limit):
        return _Extension(kind: 0u32, subtable: 0, valid: false)
    _Extension(kind: kind, subtable: target, valid: true)
fn _apply_records(font: OtFont, lookups: [GposLookup], records: [LayoutGlyphRecord],
                  positions: [i64], at: i64, count: i64, limit: i64, depth: i64,
                  budget: GposDataBudget, activation_mask: u64) -> bool:
    if at < 0 or count < 0 or at + count * 4 > limit: return false
    var record: i64 = 0
    while record < count:
        if not gpos_data_take(budget): return false
        val sequence = read_u16_be(font.blob, at + record * 4) as i64
        val nested_index = read_u16_be(font.blob, at + record * 4 + 2) as i64
        if sequence < 0 or sequence >= positions.len(): return false
        val target = match _catalog_lookup(lookups, nested_index):
            Some(value): value
            None: return false
        val nested_advance = GposBasicStep(next: positions[sequence] + 1, valid: true)
        if not _lookup_at(font, lookups, target, records, positions[sequence], depth + 1,
                          budget, nested_advance, activation_mask): return false
        record = record + 1
    true
fn _context(font: OtFont, lookups: [GposLookup], lookup: GposLookup, sub: i64, limit: i64,
            records: [LayoutGlyphRecord], index: i64, depth: i64, budget: GposDataBudget,
            advance: GposBasicStep, activation_mask: u64) -> GposBasicState:
    if depth > 16 or sub + 6 > limit:
        return GposBasicState(valid: false, matched: false, applied: false)
    val format = read_u16_be(font.blob, sub)
    if format == 3u32:
        val glyph_count = read_u16_be(font.blob, sub + 2) as i64
        val record_count = read_u16_be(font.blob, sub + 4) as i64
        val records_offset = sub + 6 + glyph_count * 2
        if glyph_count < 1 or records_offset + record_count * 4 > limit:
            return GposBasicState(valid: false, matched: false, applied: false)
        var positions: [i64] = []
        var probe = index
        var input: i64 = 0
        while input < glyph_count:
            if not gpos_data_take(budget): return GposBasicState(valid: false, matched: false, applied: false)
            val next = if input == 0:
                GposBasicStep(next: index, valid: true)
            else:
                gpos_basic_next(font, lookup, records, probe + 1, budget)
            if not next.valid: return GposBasicState(valid: false, matched: false, applied: false)
            if next.next < 0: return GposBasicState(valid: true, matched: false, applied: false)
            val coverage_offset = read_u16_be(font.blob, sub + 6 + input * 2) as i64
            val covered = gpos_data_coverage(font.blob, sub + coverage_offset, limit,
                records[next.next].glyph_id, budget)
            if coverage_offset == 0 or not covered.valid:
                return GposBasicState(valid: false, matched: false, applied: false)
            if not covered.found: return GposBasicState(valid: true, matched: false, applied: false)
            positions.push(next.next)
            probe = next.next
            input = input + 1
        if not _apply_records(font, lookups, records, positions, records_offset, record_count,
                              limit, depth, budget, activation_mask):
            return GposBasicState(valid: false, matched: true, applied: false)
        advance.next = probe + 1
        return GposBasicState(valid: true, matched: true, applied: true)
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit,
        records[index].glyph_id, budget)
    if coverage_offset == 0 or not coverage.valid:
        return GposBasicState(valid: false, matched: false, applied: false)
    if not coverage.found: return GposBasicState(valid: true, matched: false, applied: false)
    var set: i64 = 0
    var class_def: i64 = 0
    var class_rules = false
    if format == 1u32:
        val set_count = read_u16_be(font.blob, sub + 4) as i64
        if coverage.count != set_count or coverage.index >= set_count or sub + 6 + set_count * 2 > limit:
            return GposBasicState(valid: false, matched: false, applied: false)
        val set_offset = read_u16_be(font.blob, sub + 6 + coverage.index * 2) as i64
        if set_offset == 0: return GposBasicState(valid: true, matched: false, applied: false)
        set = sub + set_offset
    else if format == 2u32:
        if sub + 8 > limit: return GposBasicState(valid: false, matched: false, applied: false)
        class_def = sub + read_u16_be(font.blob, sub + 4) as i64
        val set_count = read_u16_be(font.blob, sub + 6) as i64
        val first_class = gpos_data_class(font.blob, class_def, limit, records[index].glyph_id, budget)
        if not first_class.valid or first_class.index >= set_count or sub + 8 + set_count * 2 > limit:
            return GposBasicState(valid: false, matched: false, applied: false)
        val set_offset = read_u16_be(font.blob, sub + 8 + first_class.index * 2) as i64
        if set_offset == 0: return GposBasicState(valid: true, matched: false, applied: false)
        set = sub + set_offset
        class_rules = true
    else:
        return GposBasicState(valid: false, matched: false, applied: false)
    if set + 2 > limit: return GposBasicState(valid: false, matched: false, applied: false)
    val rule_count = read_u16_be(font.blob, set) as i64
    if set + 2 + rule_count * 2 > limit:
        return GposBasicState(valid: false, matched: false, applied: false)
    var rule_index: i64 = 0
    while rule_index < rule_count:
        if not gpos_data_take(budget): return GposBasicState(valid: false, matched: false, applied: false)
        val rule_offset = read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
        val rule = set + rule_offset
        if rule_offset == 0 or rule + 4 > limit:
            return GposBasicState(valid: false, matched: false, applied: false)
        val glyph_count = read_u16_be(font.blob, rule) as i64
        val record_count = read_u16_be(font.blob, rule + 2) as i64
        val records_offset = rule + 4 + (glyph_count - 1) * 2
        if glyph_count < 1 or records_offset < rule + 4 or records_offset + record_count * 4 > limit:
            return GposBasicState(valid: false, matched: false, applied: false)
        var positions: [i64] = [index]
        var probe = index
        var input: i64 = 1
        var matched = true
        while input < glyph_count:
            val next = gpos_basic_next(font, lookup, records, probe + 1, budget)
            if not next.valid: return GposBasicState(valid: false, matched: false, applied: false)
            if next.next < 0:
                matched = false
            else:
                val expected = read_u16_be(font.blob, rule + 4 + (input - 1) * 2) as i64
                if class_rules:
                    val actual = gpos_data_class(font.blob, class_def, limit,
                        records[next.next].glyph_id, budget)
                    if not actual.valid: return GposBasicState(valid: false, matched: false, applied: false)
                    if actual.index != expected: matched = false
                else if records[next.next].glyph_id as i64 != expected:
                    matched = false
                positions.push(next.next)
                probe = next.next
            input = input + 1
        if matched and positions.len() == glyph_count:
            if not _apply_records(font, lookups, records, positions, records_offset, record_count,
                                  limit, depth, budget, activation_mask):
                return GposBasicState(valid: false, matched: true, applied: false)
            advance.next = probe + 1
            return GposBasicState(valid: true, matched: true, applied: true)
        rule_index = rule_index + 1
    GposBasicState(valid: true, matched: false, applied: false)
fn _lookup_at(font: OtFont, lookups: [GposLookup], lookup: GposLookup, records: [LayoutGlyphRecord],
              index: i64, depth: i64, budget: GposDataBudget, advance: GposBasicStep,
              activation_mask: u64) -> bool:
    if depth > 16 or index < 0 or index >= records.len() or not gpos_data_take(budget): return false
    if (records[index].feature_mask & activation_mask) == 0u64: return true
    var sub_index: i64 = 0
    while sub_index < lookup.subtable_offsets.len():
        val sub = lookup.subtable_offsets[sub_index] as i64
        val limit = _end(lookup, sub_index)
        if sub < lookup.lookup_offset as i64 or sub + 2 > limit or limit > font.blob.len(): return false
        val wrapped = if lookup.lookup_type == 9u32:
            _extension(font.blob, sub, limit)
        else:
            _Extension(kind: lookup.lookup_type, subtable: sub, valid: true)
        if not wrapped.valid: return false
        val kind = wrapped.kind
        val actual = wrapped.subtable
        val state = if kind >= 1u32 and kind <= 6u32:
            gpos_basic_match(font, lookup, kind, actual, limit, records, index, budget)
        else if kind == 7u32:
            _context(font, lookups, lookup, actual, limit, records, index, depth + 1,
                budget, advance, activation_mask)
        else if kind == 8u32:
            _chain_match(font, lookup, actual, limit, records, index, budget)
        else:
            GposBasicState(valid: false, matched: false, applied: false)
        if not state.valid: return false
        if kind == 7u32 and state.matched: return state.applied
        if not state.matched:
            sub_index = sub_index + 1
            continue
        val okay = if kind >= 1u32 and kind <= 6u32:
            gpos_basic_apply(font, lookup, kind, actual, limit, records, index, budget)
        else if kind == 8u32:
            _chain(font, lookups, lookup, actual, limit, records, index, depth + 1,
                budget, advance, activation_mask)
        else:
            false
        val applied = GposBasicState(valid: okay, matched: true, applied: okay)
        if okay and kind == 2u32:
            val vf2 = read_u16_be(font.blob, actual + 6)
            val second = gpos_basic_next(font, lookup, records, index + 1, budget)
            if not second.valid: return false
            if vf2 != 0u32 and second.next >= 0: advance.next = second.next + 1
        return applied.valid and applied.matched and applied.applied
    true
fn _chain_rule(font: OtFont, lookup: GposLookup, sub: i64, limit: i64,
               records: [LayoutGlyphRecord], index: i64,
               budget: GposDataBudget) -> _RuleState:
    if sub + 4 > limit:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
    val format = read_u16_be(font.blob, sub)
    if format == 3u32:
        var cursor = sub + 2
        val back_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + back_count * 2 + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        var probe = index - 1
        var i: i64 = 0
        while i < back_count:
            val previous = gpos_basic_previous(font, lookup, records, probe, budget)
            if not previous.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if previous.next < 0:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
            val offset = read_u16_be(font.blob, cursor + i * 2) as i64
            val hit = gpos_data_coverage(font.blob, sub + offset, limit,
                records[previous.next].glyph_id, budget)
            if offset == 0 or not hit.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if not hit.found:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
            probe = previous.next - 1
            i = i + 1
        cursor = cursor + back_count * 2
        val input_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if input_count < 1 or cursor + input_count * 2 + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        var positions: [i64] = []
        probe = index
        i = 0
        while i < input_count:
            val next = if i == 0:
                GposBasicStep(next: index, valid: true)
            else:
                gpos_basic_next(font, lookup, records, probe + 1, budget)
            if not next.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if next.next < 0:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
            val offset = read_u16_be(font.blob, cursor + i * 2) as i64
            val hit = gpos_data_coverage(font.blob, sub + offset, limit,
                records[next.next].glyph_id, budget)
            if offset == 0 or not hit.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if not hit.found:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
            positions.push(next.next)
            probe = next.next
            i = i + 1
        val next_index = probe + 1
        cursor = cursor + input_count * 2
        val ahead_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + ahead_count * 2 + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        i = 0
        while i < ahead_count:
            val next = gpos_basic_next(font, lookup, records, probe + 1, budget)
            if not next.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if next.next < 0:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
            val offset = read_u16_be(font.blob, cursor + i * 2) as i64
            val hit = gpos_data_coverage(font.blob, sub + offset, limit,
                records[next.next].glyph_id, budget)
            if offset == 0 or not hit.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if not hit.found:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
            probe = next.next
            i = i + 1
        cursor = cursor + ahead_count * 2
        if cursor + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        val count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + count * 4 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        return _RuleState(positions: positions, records: cursor, record_count: count,
            next: next_index, valid: true, matched: true)
    if format != 1u32 and format != 2u32:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit,
        records[index].glyph_id, budget)
    if coverage_offset == 0 or not coverage.valid:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
    if not coverage.found:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
    var back_class: i64 = 0
    var input_class: i64 = 0
    var ahead_class: i64 = 0
    var set_count: i64 = 0
    var set_offset_at: i64 = 0
    var set_index = coverage.index
    val class_rules = format == 2u32
    if class_rules:
        if sub + 12 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        back_class = sub + read_u16_be(font.blob, sub + 4) as i64
        input_class = sub + read_u16_be(font.blob, sub + 6) as i64
        ahead_class = sub + read_u16_be(font.blob, sub + 8) as i64
        set_count = read_u16_be(font.blob, sub + 10) as i64
        val first_class = gpos_data_class(font.blob, input_class, limit,
            records[index].glyph_id, budget)
        if not first_class.valid:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        set_index = first_class.index
        set_offset_at = sub + 12
    else:
        if sub + 6 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        set_count = read_u16_be(font.blob, sub + 4) as i64
        if coverage.count != set_count:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        set_offset_at = sub + 6
    if set_index < 0 or set_index >= set_count or set_offset_at + set_count * 2 > limit:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
    val offset = read_u16_be(font.blob, set_offset_at + set_index * 2) as i64
    if offset == 0:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: true, matched: false)
    val set = sub + offset
    if set + 2 > limit:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
    val rule_count = read_u16_be(font.blob, set) as i64
    if set + 2 + rule_count * 2 > limit:
        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
    var rule_index: i64 = 0
    while rule_index < rule_count:
        if not gpos_data_take(budget):
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        val rule_offset = read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
        var cursor = set + rule_offset
        if rule_offset == 0 or cursor + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        var matched = true
        val back_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + back_count * 2 + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        var probe = index - 1
        var i: i64 = 0
        while i < back_count:
            val previous = gpos_basic_previous(font, lookup, records, probe, budget)
            if not previous.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if previous.next < 0:
                matched = false
            else:
                val expected = read_u16_be(font.blob, cursor + i * 2) as i64
                if class_rules:
                    val actual = gpos_data_class(font.blob, back_class, limit,
                        records[previous.next].glyph_id, budget)
                    if not actual.valid:
                        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
                    if actual.index != expected: matched = false
                else if records[previous.next].glyph_id as i64 != expected:
                    matched = false
                probe = previous.next - 1
            i = i + 1
        cursor = cursor + back_count * 2
        val input_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if input_count < 1 or cursor + (input_count - 1) * 2 + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        var positions: [i64] = [index]
        probe = index
        i = 1
        while i < input_count:
            val next = gpos_basic_next(font, lookup, records, probe + 1, budget)
            if not next.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if next.next < 0:
                matched = false
            else:
                val expected = read_u16_be(font.blob, cursor + (i - 1) * 2) as i64
                if class_rules:
                    val actual = gpos_data_class(font.blob, input_class, limit,
                        records[next.next].glyph_id, budget)
                    if not actual.valid:
                        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
                    if actual.index != expected: matched = false
                else if records[next.next].glyph_id as i64 != expected:
                    matched = false
                positions.push(next.next)
                probe = next.next
            i = i + 1
        val next_index = probe + 1
        cursor = cursor + (input_count - 1) * 2
        val ahead_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + ahead_count * 2 + 2 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        i = 0
        while i < ahead_count:
            val next = gpos_basic_next(font, lookup, records, probe + 1, budget)
            if not next.valid:
                return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
            if next.next < 0:
                matched = false
            else:
                val expected = read_u16_be(font.blob, cursor + i * 2) as i64
                if class_rules:
                    val actual = gpos_data_class(font.blob, ahead_class, limit,
                        records[next.next].glyph_id, budget)
                    if not actual.valid:
                        return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
                    if actual.index != expected: matched = false
                else if records[next.next].glyph_id as i64 != expected:
                    matched = false
                probe = next.next
            i = i + 1
        cursor = cursor + ahead_count * 2
        val count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + count * 4 > limit:
            return _RuleState(positions: [], records: 0, record_count: 0, next: index + 1, valid: false, matched: false)
        if matched and positions.len() == input_count:
            return _RuleState(positions: positions, records: cursor, record_count: count,
                next: next_index, valid: true, matched: true)
        rule_index = rule_index + 1
    _RuleState(positions: [], records: 0, record_count: 0, next: index + 1,
        valid: true, matched: false)
fn _chain_match(font: OtFont, lookup: GposLookup, sub: i64, limit: i64,
                records: [LayoutGlyphRecord], index: i64,
                budget: GposDataBudget) -> GposBasicState:
    val state = _chain_rule(font, lookup, sub, limit, records, index, budget)
    GposBasicState(valid: state.valid, matched: state.matched, applied: false)
fn _chain(font: OtFont, lookups: [GposLookup], lookup: GposLookup, sub: i64, limit: i64,
          records: [LayoutGlyphRecord], index: i64, depth: i64, budget: GposDataBudget,
          advance: GposBasicStep, activation_mask: u64) -> bool:
    if depth > 16: return false
    val state = _chain_rule(font, lookup, sub, limit, records, index, budget)
    if not state.valid: return false
    if not state.matched: return true
    if not _apply_records(font, lookups, records, state.positions, state.records,
                          state.record_count, limit, depth, budget, activation_mask): return false
    advance.next = state.next
    true
fn _validate_records(font: OtFont, catalog: [GposLookup], at: i64, count: i64,
                     glyph_count: i64, limit: i64, depth: i64,
                     budget: GposDataBudget) -> bool:
    if count < 0 or glyph_count <= 0 or at < 0 or at + count * 4 > limit: return false
    var record: i64 = 0
    while record < count:
        if not gpos_data_take(budget): return false
        val sequence = read_u16_be(font.blob, at + record * 4) as i64
        val nested_index = read_u16_be(font.blob, at + record * 4 + 2) as i64
        if sequence < 0 or sequence >= glyph_count: return false
        match _catalog_lookup(catalog, nested_index):
            case Some(value):
                if not _validate_lookup(font, catalog, value, depth + 1, budget): return false
            case None: return false
        record = record + 1
    true
fn _validate_context(font: OtFont, catalog: [GposLookup], sub: i64, limit: i64,
                     depth: i64, budget: GposDataBudget) -> bool:
    if depth > 16 or sub + 6 > limit: return false
    val format = read_u16_be(font.blob, sub)
    if format == 3u32:
        val glyph_count = read_u16_be(font.blob, sub + 2) as i64
        val record_count = read_u16_be(font.blob, sub + 4) as i64
        val records_offset = sub + 6 + glyph_count * 2
        val data_end = records_offset + record_count * 4
        if glyph_count <= 0 or data_end > limit: return false
        var i: i64 = 0
        while i < glyph_count:
            if not gpos_data_take(budget): return false
            val offset = read_u16_be(font.blob, sub + 6 + i * 2) as i64
            if offset == 0 or sub + offset < data_end or
                not gpos_data_coverage(font.blob, sub + offset, limit, 0u32, budget).valid:
                return false
            i = i + 1
        return _validate_records(font, catalog, records_offset, record_count, glyph_count,
            limit, depth, budget)
    if format != 1u32 and format != 2u32: return false
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit, 0u32, budget)
    if coverage_offset == 0 or not coverage.valid: return false
    var set_count: i64 = 0
    var offsets_at: i64 = 0
    var header_end: i64 = 0
    val class_rules = format == 2u32
    if class_rules:
        if sub + 8 > limit: return false
        val class_offset = read_u16_be(font.blob, sub + 4) as i64
        set_count = read_u16_be(font.blob, sub + 6) as i64
        offsets_at = sub + 8
        header_end = offsets_at + set_count * 2
        if class_offset == 0 or sub + class_offset < header_end or set_count <= 0 or header_end > limit or
            not gpos_data_class_valid(font.blob, sub + class_offset, limit, set_count, budget):
            return false
    else:
        set_count = read_u16_be(font.blob, sub + 4) as i64
        offsets_at = sub + 6
        header_end = offsets_at + set_count * 2
        if set_count <= 0 or coverage.count != set_count or header_end > limit: return false
    if sub + coverage_offset < header_end: return false
    var seen_sets: [i64] = []
    var set_index: i64 = 0
    while set_index < set_count:
        if not gpos_data_take(budget): return false
        val set_offset = read_u16_be(font.blob, offsets_at + set_index * 2) as i64
        if set_offset != 0:
            val set = sub + set_offset
            if set < header_end or set + 2 > limit or seen_sets.contains(set): return false
            seen_sets.push(set)
            val rule_count = read_u16_be(font.blob, set) as i64
            if set + 2 + rule_count * 2 > limit: return false
            var seen_rules: [i64] = []
            var rule_index: i64 = 0
            while rule_index < rule_count:
                if not gpos_data_take(budget): return false
                val rule_offset = read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
                val rule = set + rule_offset
                if rule_offset == 0 or rule + 4 > limit or seen_rules.contains(rule): return false
                seen_rules.push(rule)
                val glyph_count = read_u16_be(font.blob, rule) as i64
                val record_count = read_u16_be(font.blob, rule + 2) as i64
                val records_offset = rule + 4 + (glyph_count - 1) * 2
                if glyph_count < 1 or records_offset < rule + 4 or
                    records_offset + record_count * 4 > limit: return false
                if class_rules:
                    var input: i64 = 1
                    while input < glyph_count:
                        if read_u16_be(font.blob, rule + 4 + (input - 1) * 2) as i64 >= set_count:
                            return false
                        input = input + 1
                if not _validate_records(font, catalog, records_offset, record_count, glyph_count,
                                         limit, depth, budget): return false
                rule_index = rule_index + 1
        set_index = set_index + 1
    true
fn _validate_chain_rule(font: OtFont, catalog: [GposLookup], rule: i64, limit: i64,
                        class_rules: bool, input_class_count: i64, depth: i64,
                        budget: GposDataBudget) -> bool:
    if rule + 2 > limit: return false
    var cursor = rule
    val back_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + back_count * 2 + 2 > limit: return false
    cursor = cursor + back_count * 2
    val input_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if input_count < 1 or cursor + (input_count - 1) * 2 + 2 > limit: return false
    if class_rules:
        var input: i64 = 1
        while input < input_count:
            if read_u16_be(font.blob, cursor + (input - 1) * 2) as i64 >= input_class_count:
                return false
            input = input + 1
    cursor = cursor + (input_count - 1) * 2
    val ahead_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + ahead_count * 2 + 2 > limit: return false
    cursor = cursor + ahead_count * 2
    val record_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    _validate_records(font, catalog, cursor, record_count, input_count, limit, depth, budget)
fn _validate_chain(font: OtFont, catalog: [GposLookup], sub: i64, limit: i64,
                   depth: i64, budget: GposDataBudget) -> bool:
    if depth > 16 or sub + 4 > limit: return false
    val format = read_u16_be(font.blob, sub)
    if format == 3u32:
        var cursor = sub + 2
        val back_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + back_count * 2 + 2 > limit: return false
        var i: i64 = 0
        while i < back_count:
            val offset = read_u16_be(font.blob, cursor + i * 2) as i64
            if offset == 0 or
                not gpos_data_coverage(font.blob, sub + offset, limit, 0u32, budget).valid:
                return false
            i = i + 1
        cursor = cursor + back_count * 2
        val input_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if input_count < 1 or cursor + input_count * 2 + 2 > limit: return false
        i = 0
        while i < input_count:
            val offset = read_u16_be(font.blob, cursor + i * 2) as i64
            if offset == 0 or
                not gpos_data_coverage(font.blob, sub + offset, limit, 0u32, budget).valid:
                return false
            i = i + 1
        cursor = cursor + input_count * 2
        val ahead_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        if cursor + ahead_count * 2 + 2 > limit: return false
        i = 0
        while i < ahead_count:
            val offset = read_u16_be(font.blob, cursor + i * 2) as i64
            if offset == 0 or
                not gpos_data_coverage(font.blob, sub + offset, limit, 0u32, budget).valid:
                return false
            i = i + 1
        cursor = cursor + ahead_count * 2
        if cursor + 2 > limit: return false
        val record_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        val records_end = cursor + record_count * 4
        if records_end > limit: return false
        # Coverage tables cannot alias the structural arrays or nested records.
        var at = sub + 2
        val first_count = read_u16_be(font.blob, at) as i64
        at = at + 2
        var coverage_index: i64 = 0
        while coverage_index < first_count:
            if not gpos_data_take(budget): return false
            if sub + read_u16_be(font.blob, at + coverage_index * 2) as i64 < records_end: return false
            coverage_index = coverage_index + 1
        at = at + first_count * 2
        val second_count = read_u16_be(font.blob, at) as i64
        at = at + 2
        coverage_index = 0
        while coverage_index < second_count:
            if not gpos_data_take(budget): return false
            if sub + read_u16_be(font.blob, at + coverage_index * 2) as i64 < records_end: return false
            coverage_index = coverage_index + 1
        at = at + second_count * 2
        val third_count = read_u16_be(font.blob, at) as i64
        at = at + 2
        coverage_index = 0
        while coverage_index < third_count:
            if not gpos_data_take(budget): return false
            if sub + read_u16_be(font.blob, at + coverage_index * 2) as i64 < records_end: return false
            coverage_index = coverage_index + 1
        return _validate_records(font, catalog, cursor, record_count, input_count,
                                 limit, depth, budget)
    if format != 1u32 and format != 2u32: return false
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit, 0u32, budget)
    if coverage_offset == 0 or not coverage.valid: return false
    val class_rules = format == 2u32
    var set_count: i64 = 0
    var offsets_at: i64 = 0
    var header_end: i64 = 0
    if class_rules:
        if sub + 12 > limit: return false
        val back_class = read_u16_be(font.blob, sub + 4) as i64
        val input_class = read_u16_be(font.blob, sub + 6) as i64
        val ahead_class = read_u16_be(font.blob, sub + 8) as i64
        set_count = read_u16_be(font.blob, sub + 10) as i64
        offsets_at = sub + 12
        header_end = offsets_at + set_count * 2
        if (back_class == 0 or input_class == 0 or ahead_class == 0 or set_count <= 0 or
            header_end > limit or
            sub + back_class < header_end or sub + input_class < header_end or
            sub + ahead_class < header_end or
            not gpos_data_class_valid(font.blob, sub + back_class, limit, 65536, budget) or
            not gpos_data_class_valid(font.blob, sub + input_class, limit, set_count, budget) or
            not gpos_data_class_valid(font.blob, sub + ahead_class, limit, 65536, budget)):
            return false
    else:
        set_count = read_u16_be(font.blob, sub + 4) as i64
        offsets_at = sub + 6
        header_end = offsets_at + set_count * 2
        if set_count <= 0 or coverage.count != set_count or header_end > limit: return false
    if sub + coverage_offset < header_end: return false
    var seen_sets: [i64] = []
    var set_index: i64 = 0
    while set_index < set_count:
        if not gpos_data_take(budget): return false
        val set_offset = read_u16_be(font.blob, offsets_at + set_index * 2) as i64
        if set_offset != 0:
            val set = sub + set_offset
            if set < header_end or set + 2 > limit or seen_sets.contains(set): return false
            seen_sets.push(set)
            val rule_count = read_u16_be(font.blob, set) as i64
            if set + 2 + rule_count * 2 > limit: return false
            var seen_rules: [i64] = []
            var rule_index: i64 = 0
            while rule_index < rule_count:
                if not gpos_data_take(budget): return false
                val rule_offset = read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
                val rule = set + rule_offset
                if rule_offset == 0 or seen_rules.contains(rule) or
                    not _validate_chain_rule(font, catalog, rule, limit, class_rules,
                                             set_count, depth, budget): return false
                seen_rules.push(rule)
                rule_index = rule_index + 1
        set_index = set_index + 1
    true
fn _validate_lookup(font: OtFont, catalog: [GposLookup], lookup: GposLookup,
                    depth: i64, budget: GposDataBudget) -> bool:
    if (depth > 16 or lookup.lookup_type < 1u32 or lookup.lookup_type > 9u32 or
        not layout_context_lookup_flag_valid(font, lookup.flag, lookup.mark_filtering_set) or
        lookup.subtable_offsets.len() == 0 or
        lookup.subtable_offsets.len() != lookup.subtable_ends.len()): return false
    var i: i64 = 0
    while i < lookup.subtable_offsets.len():
        if not gpos_data_take(budget): return false
        val sub = lookup.subtable_offsets[i] as i64
        val limit = _end(lookup, i)
        if sub < lookup.lookup_offset as i64 or sub + 2 > limit or limit > font.blob.len(): return false
        val wrapped = if lookup.lookup_type == 9u32:
            _extension(font.blob, sub, limit)
        else:
            _Extension(kind: lookup.lookup_type, subtable: sub, valid: true)
        if not wrapped.valid: return false
        val kind = wrapped.kind
        val actual = wrapped.subtable
        if kind >= 1u32 and kind <= 6u32:
            if not gpos_basic_validate(font, kind, actual, limit, budget): return false
        else if kind == 7u32:
            if not _validate_context(font, catalog, actual, limit, depth + 1, budget): return false
        else if kind == 8u32:
            if not _validate_chain(font, catalog, actual, limit, depth + 1, budget): return false
        else: return false
        i = i + 1
    true
fn _lookup(font: OtFont, lookups: [GposLookup], lookup: GposLookup, records: [LayoutGlyphRecord], depth: i64, budget: GposDataBudget, activation_mask: u64) -> bool:
    if depth > 16 or lookup.subtable_offsets.len() == 0 or lookup.subtable_offsets.len() != lookup.subtable_ends.len(): return false
    if lookup.lookup_type < 1u32 or lookup.lookup_type > 9u32: return false
    var checked: i64 = 0
    while checked < lookup.subtable_offsets.len():
        val sub = lookup.subtable_offsets[checked] as i64
        val limit = _end(lookup, checked)
        if sub < lookup.lookup_offset as i64 or sub + 2 > limit or limit > font.blob.len(): return false
        checked = checked + 1
    var index: i64 = 0
    while index < records.len():
        if not gpos_data_take(budget): return false
        val advance = GposBasicStep(next: index + 1, valid: true)
        if not _lookup_at(font, lookups, lookup, records, index, depth, budget, advance, activation_mask): return false
        if advance.next <= index: return false
        index = advance.next
    true
fn _catalog_lookup(catalog: [GposLookup], lookup_index: i64) -> Option<GposLookup>:
    var found: Option<GposLookup> = None
    for candidate in catalog:
        if candidate.lookup_index == lookup_index:
            if found.?: return None
            found = Some(candidate)
    found
fn gpos_validate(font: OtFont, active: [LayoutLookupActivation], catalog: [GposLookup], records: [LayoutGlyphRecord]) -> bool:
    for candidate in catalog:
        if not _catalog_lookup(catalog, candidate.lookup_index).?: return false
    val scratch = _copy(records)
    val budget = gpos_data_budget(records, catalog)
    for activation in active:
        if activation.feature_mask == 0u64: return false
        val lookup = match _catalog_lookup(catalog, activation.lookup_index):
            Some(value): value
            None: return false
        if (not _validate_lookup(font, catalog, lookup, 0, budget) or
            not _lookup(font, catalog, lookup, scratch, 0, budget, activation.feature_mask)):
            return false
    true
fn gpos_apply(font: OtFont, active: [LayoutLookupActivation], catalog: [GposLookup], records: [LayoutGlyphRecord]) -> LayoutApplyResult:
    if not gpos_validate(font, active, catalog, records): return LayoutApplyResult(glyphs: _copy(records), complete: false)
    val result = _copy(records)
    val budget = gpos_data_budget(records, catalog)
    for activation in active:
        val lookup = match _catalog_lookup(catalog, activation.lookup_index):
            Some(value): value
            None: return LayoutApplyResult(glyphs: _copy(records), complete: false)
        if not _lookup(font, catalog, lookup, result, 0, budget, activation.feature_mask):
            return LayoutApplyResult(glyphs: _copy(records), complete: false)
    LayoutApplyResult(glyphs: result, complete: true)
export gpos_validate, gpos_apply
