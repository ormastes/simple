use std.skia.feature.glyph.ot_parser.{OtFont, read_u16_be, read_u32_be}
use std.skia.feature.glyph.ot_parser_layout.{GposLookup, LayoutLookupActivation}
use std.skia.feature.shaper.ot_layout_context.{LayoutGlyphRecord, LayoutApplyResult}
use std.skia.feature.shaper.ot_layout_gpos_data.{GposDataValue, GposDataBudget,
    gpos_data_budget, gpos_data_take, gpos_data_coverage, gpos_data_class,
    gpos_data_class_valid, gpos_data_coverage_end, gpos_data_class_end,
    gpos_data_overlap, gpos_data_value, gpos_data_anchor, gpos_data_glyph_class,
    gpos_data_in_mark_set, gpos_data_eligible}
class _Step:
    next: i64
    valid: bool
class _ApplyState:
    valid: bool
    matched: bool
    applied: bool
class _Extension:
    kind: u32
    subtable: i64
    valid: bool
fn _copy(records: [LayoutGlyphRecord]) -> [LayoutGlyphRecord]:
    var copied: [LayoutGlyphRecord] = []
    for record in records:
        copied.push(LayoutGlyphRecord(glyph_id: record.glyph_id, source_index: record.source_index,
            cluster: record.cluster, feature_mask: record.feature_mask, x_advance_units: record.x_advance_units,
            y_advance_units: record.y_advance_units, x_offset_units: record.x_offset_units,
            y_offset_units: record.y_offset_units, component_clusters: record.component_clusters))
    copied
fn _end(lookup: GposLookup, subtable: i64) -> i64:
    if subtable < 0 or subtable >= lookup.subtable_ends.len(): return -1
    lookup.subtable_ends[subtable] as i64
fn _extension(blob: [u8], subtable: i64, limit: i64) -> _Extension:
    if subtable < 0 or subtable + 8 > limit or read_u16_be(blob, subtable) != 1u32:
        return _Extension(kind: 0u32, subtable: 0, valid: false)
    val kind = read_u16_be(blob, subtable + 2)
    val offset = read_u32_be(blob, subtable + 4) as i64
    val target = subtable + offset
    if (kind == 9u32 or kind < 2u32 or kind > 8u32 or offset < 8 or
        target < subtable or target + 2 > limit):
        return _Extension(kind: 0u32, subtable: 0, valid: false)
    _Extension(kind: kind, subtable: target, valid: true)
fn _add(record: LayoutGlyphRecord, value: GposDataValue):
    record.x_offset_units = record.x_offset_units + value.x_place
    record.y_offset_units = record.y_offset_units + value.y_place
    record.x_advance_units = record.x_advance_units + value.x_advance
    record.y_advance_units = record.y_advance_units + value.y_advance
fn _next(font: OtFont, lookup: GposLookup, records: [LayoutGlyphRecord], start: i64, budget: GposDataBudget) -> _Step:
    var index = start
    while index < records.len():
        if not gpos_data_take(budget): return _Step(next: 0, valid: false)
        val eligible = gpos_data_eligible(font, lookup, records[index].glyph_id, budget)
        if not eligible.valid: return _Step(next: 0, valid: false)
        if eligible.found: return _Step(next: index, valid: true)
        index = index + 1
    _Step(next: -1, valid: true)
fn _pair(font: OtFont, lookup: GposLookup, sub: i64, limit: i64, records: [LayoutGlyphRecord], index: i64, budget: GposDataBudget) -> bool:
    if sub + 10 > limit: return false
    val format = read_u16_be(font.blob, sub)
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val vf1 = read_u16_be(font.blob, sub + 4)
    val vf2 = read_u16_be(font.blob, sub + 6)
    val first = gpos_data_coverage(font.blob, sub + coverage_offset, limit, records[index].glyph_id, budget)
    if coverage_offset == 0 or not first.valid: return false
    if not first.found: return true
    val second = _next(font, lookup, records, index + 1, budget)
    if not second.valid: return false
    if second.next < 0: return true
    if format == 1u32:
        val count = read_u16_be(font.blob, sub + 8) as i64
        if first.count != count or first.index < 0 or first.index >= count or sub + 10 + count * 2 > limit: return false
        val set_offset = read_u16_be(font.blob, sub + 10 + first.index * 2) as i64
        val set = sub + set_offset
        if set_offset == 0 or set + 2 > limit: return false
        val pairs = read_u16_be(font.blob, set) as i64
        var cursor = set + 2
        var previous: i64 = -1
        var i: i64 = 0
        while i < pairs:
            if not gpos_data_take(budget): return false
            if cursor + 2 > limit: return false
            val glyph = read_u16_be(font.blob, cursor)
            if glyph as i64 <= previous: return false
            previous = glyph as i64
            val one = gpos_data_value(font.blob, cursor + 2, limit, vf1)
            val two = gpos_data_value(font.blob, cursor + 2 + one.size, limit, vf2)
            if not one.valid or not two.valid: return false
            if glyph == records[second.next].glyph_id:
                _add(records[index], one); _add(records[second.next], two); return true
            cursor = cursor + 2 + one.size + two.size
            i = i + 1
        cursor <= limit
    else if format == 2u32:
        if sub + 16 > limit: return false
        val class1_offset = read_u16_be(font.blob, sub + 8) as i64
        val class2_offset = read_u16_be(font.blob, sub + 10) as i64
        val class1 = sub + class1_offset
        val class2 = sub + class2_offset
        val c1count = read_u16_be(font.blob, sub + 12) as i64
        val c2count = read_u16_be(font.blob, sub + 14) as i64
        val one = gpos_data_value(font.blob, sub + 16, limit, vf1)
        val two = gpos_data_value(font.blob, sub + 16 + one.size, limit, vf2)
        if (class1_offset == 0 or class2_offset == 0 or c1count <= 0 or c2count <= 0 or
            not one.valid or not two.valid or sub + 16 + (one.size + two.size) * c1count * c2count > limit or
            not gpos_data_class_valid(font.blob, class1, limit, c1count, budget) or
            not gpos_data_class_valid(font.blob, class2, limit, c2count, budget)): return false
        val first_class = gpos_data_class(font.blob, class1, limit, records[index].glyph_id, budget)
        val second_class = gpos_data_class(font.blob, class2, limit, records[second.next].glyph_id, budget)
        if not first_class.valid or not second_class.valid or first_class.index >= c1count or second_class.index >= c2count: return false
        val at = sub + 16 + (first_class.index * c2count + second_class.index) * (one.size + two.size)
        val value1 = gpos_data_value(font.blob, at, limit, vf1)
        val value2 = gpos_data_value(font.blob, at + value1.size, limit, vf2)
        if not value1.valid or not value2.valid: return false
        _add(records[index], value1); _add(records[second.next], value2); true
    else: false
fn _mark(font: OtFont, lookup: GposLookup, kind: u32, sub: i64, limit: i64, records: [LayoutGlyphRecord], index: i64, budget: GposDataBudget) -> bool:
    if sub + 12 > limit or read_u16_be(font.blob, sub) != 1u32: return false
    val mark_cov = read_u16_be(font.blob, sub + 2) as i64
    val target_cov = read_u16_be(font.blob, sub + 4) as i64
    val classes = read_u16_be(font.blob, sub + 6) as i64
    val mark_array = sub + read_u16_be(font.blob, sub + 8) as i64
    val target_array = sub + read_u16_be(font.blob, sub + 10) as i64
    val mark = gpos_data_coverage(font.blob, sub + mark_cov, limit, records[index].glyph_id, budget)
    if mark_cov == 0 or target_cov == 0 or not mark.valid or not mark.found or mark_array + 2 > limit: return mark.valid
    val mark_count = read_u16_be(font.blob, mark_array) as i64
    if mark.count != mark_count or mark.index < 0 or mark.index >= mark_count or mark_array + 2 + mark_count * 4 > limit: return false
    val class = read_u16_be(font.blob, mark_array + 2 + mark.index * 4) as i64
    val mark_anchor = gpos_data_anchor(font.blob,
        mark_array + read_u16_be(font.blob, mark_array + 4 + mark.index * 4) as i64, limit, budget)
    if class < 0 or class >= classes or not mark_anchor.valid: return false
    var candidate = index - 1
    while candidate >= 0:
        if not gpos_data_take(budget): return false
        val eligible = gpos_data_eligible(font, lookup, records[candidate].glyph_id, budget)
        if not eligible.valid: return false
        if eligible.found:
            val target = gpos_data_coverage(font.blob, sub + target_cov, limit, records[candidate].glyph_id, budget)
            if not target.valid: return false
            if target.found:
                var anchor_offset: i64 = 0
                if kind == 4u32:
                    if target_array + 2 > limit: return false
                    val count = read_u16_be(font.blob, target_array) as i64
                    if target.index >= count or target_array + 2 + count * classes * 2 > limit: return false
                    anchor_offset = read_u16_be(font.blob, target_array + 2 + (target.index * classes + class) * 2) as i64
                else if kind == 5u32:
                    if target_array + 2 + target.index * 2 + 2 > limit: return false
                    val ligature = target_array + read_u16_be(font.blob, target_array + 2 + target.index * 2) as i64
                    if ligature + 2 > limit: return false
                    val components = read_u16_be(font.blob, ligature) as i64
                    if components < 1 or ligature + 2 + components * classes * 2 > limit: return false
                    if records[candidate].component_clusters.len() != components: return false
                    var component: i64 = -1
                    var component_cluster: i64 = -1
                    var component_index: i64 = 0
                    while component_index < components:
                        if not gpos_data_take(budget): return false
                        val cluster = records[candidate].component_clusters[component_index]
                        if cluster <= records[index].cluster and cluster >= component_cluster:
                            component = component_index
                            component_cluster = cluster
                        component_index = component_index + 1
                    if component < 0: return false
                    anchor_offset = read_u16_be(font.blob, ligature + 2 + component * classes * 2 + class * 2) as i64
                else:
                    if target_array + 2 > limit: return false
                    val count = read_u16_be(font.blob, target_array) as i64
                    if target.index >= count or target_array + 2 + count * classes * 2 > limit: return false
                    anchor_offset = read_u16_be(font.blob, target_array + 2 + (target.index * classes + class) * 2) as i64
                if anchor_offset == 0: return true
                val target_anchor = gpos_data_anchor(font.blob,
                    (if kind == 5u32: target_array + (read_u16_be(font.blob, target_array + 2 + target.index * 2) as i64)
                     else: target_array) + anchor_offset, limit, budget)
                if not target_anchor.valid: return false
                var pen_x: i64 = 0
                var pen_y: i64 = 0
                var between = candidate
                while between < index:
                    if not gpos_data_take(budget): return false
                    pen_x = pen_x + records[between].x_advance_units
                    pen_y = pen_y + records[between].y_advance_units
                    between = between + 1
                records[index].x_offset_units = records[candidate].x_offset_units + target_anchor.x - mark_anchor.x - pen_x
                records[index].y_offset_units = records[candidate].y_offset_units + target_anchor.y - mark_anchor.y - pen_y
                return true
            return true
        candidate = candidate - 1
    true
fn _context(font: OtFont, lookups: [GposLookup], lookup: GposLookup, sub: i64, limit: i64,
            records: [LayoutGlyphRecord], index: i64, depth: i64, budget: GposDataBudget,
            advance: _Step, activation_mask: u64) -> _ApplyState:
    if depth > 16 or sub + 6 > limit or read_u16_be(font.blob, sub) != 1u32:
        return _ApplyState(valid: false, matched: false, applied: false)
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val set_count = read_u16_be(font.blob, sub + 4) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit, records[index].glyph_id, budget)
    if (coverage_offset == 0 or not coverage.valid or coverage.count != set_count or
        sub + 6 + set_count * 2 > limit):
        return _ApplyState(valid: false, matched: false, applied: false)
    if not coverage.found: return _ApplyState(valid: true, matched: false, applied: false)
    val set_offset = read_u16_be(font.blob, sub + 6 + coverage.index * 2) as i64
    if set_offset == 0: return _ApplyState(valid: true, matched: false, applied: false)
    val set = sub + set_offset
    if set < sub + 6 + set_count * 2 or set + 2 > limit:
        return _ApplyState(valid: false, matched: false, applied: false)
    val rule_count = read_u16_be(font.blob, set) as i64
    if set + 2 + rule_count * 2 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    var rule_index: i64 = 0
    while rule_index < rule_count:
        if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
        val rule_offset = read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
        val rule = set + rule_offset
        if rule_offset == 0 or rule + 4 > limit:
            return _ApplyState(valid: false, matched: false, applied: false)
        val glyph_count = read_u16_be(font.blob, rule) as i64
        val record_count = read_u16_be(font.blob, rule + 2) as i64
        val records_offset = rule + 4 + (glyph_count - 1) * 2
        if glyph_count < 1 or records_offset < rule + 4 or records_offset + record_count * 4 > limit:
            return _ApplyState(valid: false, matched: false, applied: false)
        var positions: [i64] = [index]
        var probe = index
        var input: i64 = 1
        var matched = true
        while input < glyph_count:
            if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
            val next = _next(font, lookup, records, probe + 1, budget)
            if not next.valid: return _ApplyState(valid: false, matched: false, applied: false)
            if next.next < 0:
                matched = false
            else:
                if read_u16_be(font.blob, rule + 4 + (input - 1) * 2) != records[next.next].glyph_id:
                    matched = false
                positions.push(next.next)
                probe = next.next
            input = input + 1
        if matched and positions.len() == glyph_count:
            var record: i64 = 0
            while record < record_count:
                if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
                val sequence = read_u16_be(font.blob, records_offset + record * 4) as i64
                val nested_index = read_u16_be(font.blob, records_offset + record * 4 + 2) as i64
                if sequence < 0 or sequence >= positions.len():
                    return _ApplyState(valid: false, matched: false, applied: false)
                var nested: Option<GposLookup> = None
                for candidate in lookups:
                    if candidate.lookup_index == nested_index: nested = Some(candidate)
                val target = match nested:
                    Some(value): value
                    None: return _ApplyState(valid: false, matched: false, applied: false)
                val nested_advance = _Step(next: positions[sequence] + 1, valid: true)
                if not _lookup_at(font, lookups, target, records, positions[sequence], depth + 1,
                                  budget, nested_advance, activation_mask):
                    return _ApplyState(valid: false, matched: false, applied: false)
                record = record + 1
            advance.next = probe + 1
            return _ApplyState(valid: true, matched: true, applied: true)
        rule_index = rule_index + 1
    _ApplyState(valid: true, matched: false, applied: false)
fn _lookup_at(font: OtFont, lookups: [GposLookup], lookup: GposLookup, records: [LayoutGlyphRecord],
              index: i64, depth: i64, budget: GposDataBudget, advance: _Step,
              activation_mask: u64) -> bool:
    if depth > 16 or index < 0 or index >= records.len() or not gpos_data_take(budget): return false
    if (records[index].feature_mask & activation_mask) == 0u64: return true
    var sub_index: i64 = 0
    while sub_index < lookup.subtable_offsets.len():
        val sub = lookup.subtable_offsets[sub_index] as i64
        val limit = _end(lookup, sub_index)
        if sub < lookup.lookup_offset as i64 or sub + 2 > limit or limit > font.blob.len(): return false
        val wrapped = if lookup.lookup_type == 9u32: _extension(font.blob, sub, limit)
            else: _Extension(kind: lookup.lookup_type, subtable: sub, valid: true)
        if not wrapped.valid: return false
        val kind = wrapped.kind
        val actual = wrapped.subtable
        val state = if kind == 2u32:
            _pair_match(font, lookup, actual, limit, records, index, budget)
        else if kind == 4u32 or kind == 5u32 or kind == 6u32:
            _mark_match(font, lookup, actual, limit, records, index, budget)
        else if kind == 7u32:
            _context(font, lookups, lookup, actual, limit, records, index, depth + 1,
                budget, advance, activation_mask)
        else if kind == 8u32:
            _chain_match(font, lookup, actual, limit, records, index, budget)
        else:
            _ApplyState(valid: false, matched: false, applied: false)
        if not state.valid: return false
        if kind == 7u32 and state.matched: return state.applied
        if not state.matched:
            sub_index = sub_index + 1
            continue
        val okay = if kind == 2u32: _pair(font, lookup, actual, limit, records, index, budget)
            else if kind == 4u32 or kind == 5u32 or kind == 6u32:
                _mark(font, lookup, kind, actual, limit, records, index, budget)
            else if kind == 8u32:
                _chain(font, lookups, lookup, actual, limit, records, index, depth + 1,
                    budget, advance, activation_mask)
            else false
        val applied = _ApplyState(valid: okay, matched: true, applied: okay)
        if okay and kind == 2u32:
            val vf2 = read_u16_be(font.blob, actual + 6)
            val second = _next(font, lookup, records, index + 1, budget)
            if not second.valid: return false
            if vf2 != 0u32 and second.next >= 0: advance.next = second.next + 1
        return applied.valid and applied.matched and applied.applied
    true
fn _previous(font: OtFont, lookup: GposLookup, records: [LayoutGlyphRecord], start: i64,
             budget: GposDataBudget) -> _Step:
    var index = start
    while index >= 0:
        if not gpos_data_take(budget): return _Step(next: 0, valid: false)
        val eligible = gpos_data_eligible(font, lookup, records[index].glyph_id, budget)
        if not eligible.valid: return _Step(next: 0, valid: false)
        if eligible.found: return _Step(next: index, valid: true)
        index = index - 1
    _Step(next: -1, valid: true)
fn _pair_match(font: OtFont, lookup: GposLookup, sub: i64, limit: i64, records: [LayoutGlyphRecord], index: i64, budget: GposDataBudget) -> _ApplyState:
    if sub + 10 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit, records[index].glyph_id, budget)
    if coverage_offset == 0 or not coverage.valid: return _ApplyState(valid: false, matched: false, applied: false)
    if not coverage.found: return _ApplyState(valid: true, matched: false, applied: false)
    val vf1 = read_u16_be(font.blob, sub + 4)
    val vf2 = read_u16_be(font.blob, sub + 6)
    val second = _next(font, lookup, records, index + 1, budget)
    if not second.valid: return _ApplyState(valid: false, matched: false, applied: false)
    if second.next < 0: return _ApplyState(valid: true, matched: false, applied: false)
    val format = read_u16_be(font.blob, sub)
    if format == 2u32: return _ApplyState(valid: true, matched: true, applied: false)
    if format != 1u32 or sub + 10 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    val count = read_u16_be(font.blob, sub + 8) as i64
    if coverage.index < 0 or coverage.index >= count or sub + 10 + count * 2 > limit:
        return _ApplyState(valid: false, matched: false, applied: false)
    val set_offset = read_u16_be(font.blob, sub + 10 + coverage.index * 2) as i64
    val set = sub + set_offset
    if set_offset == 0 or set + 2 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    val pairs = read_u16_be(font.blob, set) as i64
    var cursor = set + 2
    var i: i64 = 0
    while i < pairs:
        if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
        if cursor + 2 > limit: return _ApplyState(valid: false, matched: false, applied: false)
        val glyph = read_u16_be(font.blob, cursor)
        val one = gpos_data_value(font.blob, cursor + 2, limit, vf1)
        val two = gpos_data_value(font.blob, cursor + 2 + one.size, limit, vf2)
        if not one.valid or not two.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if glyph == records[second.next].glyph_id: return _ApplyState(valid: true, matched: true, applied: false)
        cursor = cursor + 2 + one.size + two.size
        i = i + 1
    _ApplyState(valid: true, matched: false, applied: false)
fn _mark_match(font: OtFont, lookup: GposLookup, sub: i64, limit: i64, records: [LayoutGlyphRecord], index: i64, budget: GposDataBudget) -> _ApplyState:
    if sub + 12 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    val mark_offset = read_u16_be(font.blob, sub + 2) as i64
    val target_offset = read_u16_be(font.blob, sub + 4) as i64
    val mark = gpos_data_coverage(font.blob, sub + mark_offset, limit, records[index].glyph_id, budget)
    if mark_offset == 0 or target_offset == 0 or not mark.valid:
        return _ApplyState(valid: false, matched: false, applied: false)
    if not mark.found: return _ApplyState(valid: true, matched: false, applied: false)
    var candidate = index - 1
    while candidate >= 0:
        if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
        val eligible = gpos_data_eligible(font, lookup, records[candidate].glyph_id, budget)
        if not eligible.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if eligible.found:
            val target = gpos_data_coverage(font.blob, sub + target_offset, limit, records[candidate].glyph_id, budget)
            if not target.valid: return _ApplyState(valid: false, matched: false, applied: false)
            return _ApplyState(valid: true, matched: target.found, applied: false)
        candidate = candidate - 1
    _ApplyState(valid: true, matched: false, applied: false)
fn _chain_match(font: OtFont, lookup: GposLookup, sub: i64, limit: i64, records: [LayoutGlyphRecord], index: i64, budget: GposDataBudget) -> _ApplyState:
    if sub + 4 > limit or read_u16_be(font.blob, sub) != 3u32:
        return _ApplyState(valid: false, matched: false, applied: false)
    var cursor = sub + 2
    val back = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + back * 2 + 2 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    var probe = index - 1
    var i: i64 = 0
    while i < back:
        if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
        val previous = _previous(font, lookup, records, probe, budget)
        if not previous.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if previous.next < 0: return _ApplyState(valid: true, matched: false, applied: false)
        val hit = gpos_data_coverage(font.blob, sub + read_u16_be(font.blob, cursor + i * 2) as i64,
            limit, records[previous.next].glyph_id, budget)
        if not hit.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if not hit.found: return _ApplyState(valid: true, matched: false, applied: false)
        probe = previous.next - 1
        i = i + 1
    cursor = cursor + back * 2
    val inputs = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if inputs < 1 or cursor + inputs * 2 + 2 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    probe = index
    i = 0
    while i < inputs:
        if not _take(budget): return _ApplyState(valid: false, matched: false, applied: false)
        val next = if i == 0: _Step(next: index, valid: true)
            else: _next(font, lookup, records, probe + 1, budget)
        if not next.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if next.next < 0: return _ApplyState(valid: true, matched: false, applied: false)
        val hit = gpos_data_coverage(font.blob, sub + read_u16_be(font.blob, cursor + i * 2) as i64,
            limit, records[next.next].glyph_id, budget)
        if not hit.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if not hit.found: return _ApplyState(valid: true, matched: false, applied: false)
        probe = next.next
        i = i + 1
    cursor = cursor + inputs * 2
    val ahead = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + ahead * 2 + 2 > limit: return _ApplyState(valid: false, matched: false, applied: false)
    i = 0
    while i < ahead:
        if not gpos_data_take(budget): return _ApplyState(valid: false, matched: false, applied: false)
        val next = _next(font, lookup, records, probe + 1, budget)
        if not next.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if next.next < 0: return _ApplyState(valid: true, matched: false, applied: false)
        val hit = gpos_data_coverage(font.blob, sub + read_u16_be(font.blob, cursor + i * 2) as i64,
            limit, records[next.next].glyph_id, budget)
        if not hit.valid: return _ApplyState(valid: false, matched: false, applied: false)
        if not hit.found: return _ApplyState(valid: true, matched: false, applied: false)
        probe = next.next
        i = i + 1
    _ApplyState(valid: true, matched: true, applied: false)
fn _chain(font: OtFont, lookups: [GposLookup], lookup: GposLookup, sub: i64, limit: i64,
          records: [LayoutGlyphRecord], index: i64, depth: i64, budget: GposDataBudget,
          advance: _Step, activation_mask: u64) -> bool:
    if depth > 16 or sub + 4 > limit or read_u16_be(font.blob, sub) != 3u32: return false
    var cursor = sub + 2
    val back_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + back_count * 2 + 2 > limit: return false
    var probe = index - 1
    var i: i64 = 0
    while i < back_count:
        if not gpos_data_take(budget): return false
        val previous = _previous(font, lookup, records, probe, budget)
        if not previous.valid: return false
        if previous.next < 0: return true
        val covered = gpos_data_coverage(font.blob, sub + read_u16_be(font.blob, cursor + i * 2) as i64,
            limit, records[previous.next].glyph_id, budget)
        if not covered.valid: return false
        if not covered.found: return true
        probe = previous.next - 1
        i = i + 1
    cursor = cursor + back_count * 2
    val input_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if input_count < 1 or cursor + input_count * 2 + 2 > limit: return false
    var inputs: [i64] = []
    probe = index
    i = 0
    while i < input_count:
        if not _take(budget): return false
        val next = if i == 0: _Step(next: index, valid: true)
            else: _next(font, lookup, records, probe + 1, budget)
        if not next.valid: return false
        if next.next < 0: return true
        val covered = gpos_data_coverage(font.blob, sub + read_u16_be(font.blob, cursor + i * 2) as i64,
            limit, records[next.next].glyph_id, budget)
        if not covered.valid: return false
        if not covered.found: return true
        inputs.push(next.next)
        probe = next.next
        i = i + 1
    advance.next = probe + 1
    cursor = cursor + input_count * 2
    val ahead_count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + ahead_count * 2 + 2 > limit: return false
    i = 0
    while i < ahead_count:
        if not gpos_data_take(budget): return false
        val next = _next(font, lookup, records, probe + 1, budget)
        if not next.valid: return false
        if next.next < 0: return true
        val covered = gpos_data_coverage(font.blob, sub + read_u16_be(font.blob, cursor + i * 2) as i64,
            limit, records[next.next].glyph_id, budget)
        if not covered.valid: return false
        if not covered.found: return true
        probe = next.next
        i = i + 1
    cursor = cursor + ahead_count * 2
    val count = read_u16_be(font.blob, cursor) as i64
    cursor = cursor + 2
    if cursor + count * 4 > limit: return false
    i = 0
    while i < count:
        if not gpos_data_take(budget): return false
        val sequence = read_u16_be(font.blob, cursor + i * 4) as i64
        val nested_index = read_u16_be(font.blob, cursor + i * 4 + 2) as i64
        if sequence < 0 or sequence >= inputs.len(): return false
        var nested: Option<GposLookup> = None
        for candidate in lookups:
            if candidate.lookup_index == nested_index: nested = Some(candidate)
        val target = match nested:
            Some(value): value
            None: return false
        val nested_advance = _Step(next: inputs[sequence] + 1, valid: true)
        if not _lookup_at(font, lookups, target, records, inputs[sequence], depth + 1,
                          budget, nested_advance, activation_mask): return false
        i = i + 1
    true
fn _validate_pair(font: OtFont, sub: i64, limit: i64, budget: GposDataBudget) -> bool:
    if sub + 10 > limit: return false
    val format = read_u16_be(font.blob, sub)
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val vf1 = read_u16_be(font.blob, sub + 4)
    val vf2 = read_u16_be(font.blob, sub + 6)
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit, 0u32, budget)
    if coverage_offset == 0 or not coverage.valid: return false
    if format == 1u32:
        val count = read_u16_be(font.blob, sub + 8) as i64
        val header_end = sub + 10 + count * 2
        val coverage_start = sub + coverage_offset
        val coverage_end = gpos_data_coverage_end(font.blob, coverage_start, limit)
        if count != coverage.count or header_end > limit or coverage_start < header_end or coverage_end < 0: return false
        var starts: [i64] = []
        var ends: [i64] = []
        var i: i64 = 0
        while i < count:
            if not gpos_data_take(budget): return false
            val offset = read_u16_be(font.blob, sub + 10 + i * 2) as i64
            val set = sub + offset
            if offset == 0 or set < header_end or set + 2 > limit or set == coverage_start or starts.contains(set): return false
            val pairs = read_u16_be(font.blob, set) as i64
            var cursor = set + 2
            var previous: i64 = -1
            var p: i64 = 0
            while p < pairs:
                if not gpos_data_take(budget) or cursor + 2 > limit: return false
                val second = read_u16_be(font.blob, cursor) as i64
                val one = gpos_data_value(font.blob, cursor + 2, limit, vf1)
                val two = gpos_data_value(font.blob, cursor + 2 + one.size, limit, vf2)
                if second <= previous or not one.valid or not two.valid: return false
                previous = second
                cursor = cursor + 2 + one.size + two.size
                p = p + 1
            if gpos_data_overlap(set, cursor, coverage_start, coverage_end): return false
            var prior: i64 = 0
            while prior < starts.len():
                if gpos_data_overlap(set, cursor, starts[prior], ends[prior]): return false
                prior = prior + 1
            starts.push(set)
            ends.push(cursor)
            i = i + 1
        return true
    if format != 2u32 or sub + 16 > limit: return false
    val class1_offset = read_u16_be(font.blob, sub + 8) as i64
    val class2_offset = read_u16_be(font.blob, sub + 10) as i64
    val c1 = read_u16_be(font.blob, sub + 12) as i64
    val c2 = read_u16_be(font.blob, sub + 14) as i64
    val matrix_end = sub + 16 + (gpos_data_value(font.blob, sub + 16, limit, vf1).size + gpos_data_value(font.blob, sub + 16 + gpos_data_value(font.blob, sub + 16, limit, vf1).size, limit, vf2).size) * c1 * c2
    val coverage_start = sub + coverage_offset
    val class1_start = sub + class1_offset
    val class2_start = sub + class2_offset
    val coverage_end = gpos_data_coverage_end(font.blob, coverage_start, limit)
    val class1_end = gpos_data_class_end(font.blob, class1_start, limit)
    val class2_end = gpos_data_class_end(font.blob, class2_start, limit)
    if (class1_offset == 0 or class2_offset == 0 or
        coverage_start < matrix_end or class1_start < matrix_end or class2_start < matrix_end or
        coverage_end < 0 or class1_end < 0 or class2_end < 0 or
        gpos_data_overlap(coverage_start, coverage_end, class1_start, class1_end) or
        gpos_data_overlap(coverage_start, coverage_end, class2_start, class2_end) or
        (class1_start != class2_start and gpos_data_overlap(class1_start, class1_end, class2_start, class2_end)) or
        not gpos_data_class_valid(font.blob, sub + class1_offset, limit, c1, budget) or
        not gpos_data_class_valid(font.blob, sub + class2_offset, limit, c2, budget)): return false
    var cursor = sub + 16
    var i: i64 = 0
    while i < c1 * c2:
        if not gpos_data_take(budget): return false
        val one = gpos_data_value(font.blob, cursor, limit, vf1)
        val two = gpos_data_value(font.blob, cursor + one.size, limit, vf2)
        if not one.valid or not two.valid: return false
        cursor = cursor + one.size + two.size
        i = i + 1
    true
fn _validate_mark(font: OtFont, kind: u32, sub: i64, limit: i64, budget: GposDataBudget) -> bool:
    if sub + 12 > limit or read_u16_be(font.blob, sub) != 1u32: return false
    val mark_cov_offset = read_u16_be(font.blob, sub + 2) as i64
    val target_cov_offset = read_u16_be(font.blob, sub + 4) as i64
    val mark_cov = gpos_data_coverage(font.blob, sub + mark_cov_offset, limit, 0u32, budget)
    val target_cov = gpos_data_coverage(font.blob, sub + target_cov_offset, limit, 0u32, budget)
    val classes = read_u16_be(font.blob, sub + 6) as i64
    val marks_offset = read_u16_be(font.blob, sub + 8) as i64
    val targets_offset = read_u16_be(font.blob, sub + 10) as i64
    val marks = sub + marks_offset
    val targets = sub + targets_offset
    if (mark_cov_offset == 0 or target_cov_offset == 0 or classes <= 0 or not mark_cov.valid or
        not target_cov.valid or marks_offset < 12 or targets_offset < 12 or
        mark_cov_offset < 12 or target_cov_offset < 12 or
        marks_offset == targets_offset or marks_offset == mark_cov_offset or marks_offset == target_cov_offset or
        targets_offset == mark_cov_offset or targets_offset == target_cov_offset or
        mark_cov_offset == target_cov_offset or marks + 2 > limit or targets + 2 > limit): return false
    val mark_count = read_u16_be(font.blob, marks) as i64
    if mark_count != mark_cov.count or marks + 2 + mark_count * 4 > limit: return false
    var i: i64 = 0
    while i < mark_count:
        if not _take(budget): return false
        val class = read_u16_be(font.blob, marks + 2 + i * 4) as i64
        val anchor = read_u16_be(font.blob, marks + 4 + i * 4) as i64
        if class >= classes or anchor == 0 or not gpos_data_anchor(font.blob, marks + anchor, limit, budget).valid: return false
        i = i + 1
    val target_count = read_u16_be(font.blob, targets) as i64
    if target_count != target_cov.count: return false
    if kind == 5u32:
        if targets + 2 + target_count * 2 > limit: return false
        i = 0
        while i < target_count:
            val offset = read_u16_be(font.blob, targets + 2 + i * 2) as i64
            val lig = targets + offset
            if offset == 0 or lig + 2 > limit: return false
            val components = read_u16_be(font.blob, lig) as i64
            if components <= 0 or lig + 2 + components * classes * 2 > limit: return false
            var a: i64 = 0
            while a < components * classes:
                val anchor = read_u16_be(font.blob, lig + 2 + a * 2) as i64
                if not gpos_data_take(budget): return false
                if anchor != 0 and not gpos_data_anchor(font.blob, lig + anchor, limit, budget).valid: return false
                a = a + 1
            i = i + 1
        return true
    if targets + 2 + target_count * classes * 2 > limit: return false
    i = 0
    while i < target_count * classes:
        val anchor = read_u16_be(font.blob, targets + 2 + i * 2) as i64
        if not gpos_data_take(budget): return false
        if anchor != 0 and not gpos_data_anchor(font.blob, targets + anchor, limit, budget).valid: return false
        i = i + 1
    true
fn _gpos_validate_context(font: OtFont, catalog: [GposLookup], sub: i64, limit: i64,
                     depth: i64, budget: GposDataBudget) -> bool:
    if depth > 16 or sub + 6 > limit or read_u16_be(font.blob, sub) != 1u32: return false
    val coverage_offset = read_u16_be(font.blob, sub + 2) as i64
    val set_count = read_u16_be(font.blob, sub + 4) as i64
    val coverage = gpos_data_coverage(font.blob, sub + coverage_offset, limit, 0u32, budget)
    val header_end = sub + 6 + set_count * 2
    if coverage_offset == 0 or not coverage.valid or coverage.count != set_count or header_end > limit:
        return false
    var seen_sets: [i64] = []
    var set_index: i64 = 0
    while set_index < set_count:
        if not gpos_data_take(budget): return false
        val set_offset = read_u16_be(font.blob, sub + 6 + set_index * 2) as i64
        if set_offset != 0:
            val set = sub + set_offset
            if set < header_end or set + 2 > limit or seen_sets.contains(set): return false
            seen_sets.push(set)
            val rule_count = read_u16_be(font.blob, set) as i64
            if set + 2 + rule_count * 2 > limit: return false
            var seen_rules: [i64] = []
            var rule_index: i64 = 0
            while rule_index < rule_count:
                if not gpos_data_take(budget): return false
                val rule_offset = read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
                val rule = set + rule_offset
                if rule_offset == 0 or rule + 4 > limit or seen_rules.contains(rule): return false
                seen_rules.push(rule)
                val glyph_count = read_u16_be(font.blob, rule) as i64
                val record_count = read_u16_be(font.blob, rule + 2) as i64
                val records_offset = rule + 4 + (glyph_count - 1) * 2
                if glyph_count < 1 or records_offset < rule + 4 or records_offset + record_count * 4 > limit:
                    return false
                var record: i64 = 0
                while record < record_count:
                    if not gpos_data_take(budget): return false
                    val sequence = read_u16_be(font.blob, records_offset + record * 4) as i64
                    val nested_index = read_u16_be(font.blob, records_offset + record * 4 + 2) as i64
                    if sequence < 0 or sequence >= glyph_count: return false
                    var nested: Option<GposLookup> = None
                    for candidate in catalog:
                        if candidate.lookup_index == nested_index: nested = Some(candidate)
                    match nested:
                        case Some(value):
                            if not _validate_lookup(font, catalog, value, depth + 1, budget): return false
                        case None: return false
                    record = record + 1
                rule_index = rule_index + 1
        set_index = set_index + 1
    true
fn _validate_lookup(font: OtFont, catalog: [GposLookup], lookup: GposLookup,
                    depth: i64, budget: GposDataBudget) -> bool:
    if depth > 16 or lookup.subtable_offsets.len() == 0 or lookup.subtable_offsets.len() != lookup.subtable_ends.len(): return false
    var i: i64 = 0
    while i < lookup.subtable_offsets.len():
        if not gpos_data_take(budget): return false
        val sub = lookup.subtable_offsets[i] as i64
        val limit = _end(lookup, i)
        if sub < lookup.lookup_offset as i64 or sub + 2 > limit or limit > font.blob.len(): return false
        val wrapped = if lookup.lookup_type == 9u32: _extension(font.blob, sub, limit)
            else: _Extension(kind: lookup.lookup_type, subtable: sub, valid: true)
        if not wrapped.valid: return false
        val kind = wrapped.kind
        val actual = wrapped.subtable
        if kind == 2u32:
            if not _validate_pair(font, actual, limit, budget): return false
        else if kind == 4u32 or kind == 5u32 or kind == 6u32:
            if not _validate_mark(font, kind, actual, limit, budget): return false
        else if kind == 7u32:
            if not _gpos_validate_context(font, catalog, actual, limit, depth + 1, budget): return false
        else if kind == 8u32:
            if read_u16_be(font.blob, actual) != 3u32: return false
            var cursor = actual + 2
            val back = read_u16_be(font.blob, cursor) as i64
            cursor = cursor + 2
            if cursor + back * 2 + 2 > limit: return false
            var coverage_index: i64 = 0
            while coverage_index < back:
                val offset = read_u16_be(font.blob, cursor + coverage_index * 2) as i64
                if offset == 0 or not gpos_data_coverage(font.blob, actual + offset, limit, 0u32, budget).valid: return false
                coverage_index = coverage_index + 1
            cursor = cursor + back * 2
            if cursor + 2 > limit: return false
            val inputs = read_u16_be(font.blob, cursor) as i64
            cursor = cursor + 2
            if inputs <= 0 or cursor + inputs * 2 + 2 > limit: return false
            coverage_index = 0
            while coverage_index < inputs:
                val offset = read_u16_be(font.blob, cursor + coverage_index * 2) as i64
                if offset == 0 or not gpos_data_coverage(font.blob, actual + offset, limit, 0u32, budget).valid: return false
                coverage_index = coverage_index + 1
            cursor = cursor + inputs * 2
            if inputs <= 0 or cursor + 2 > limit: return false
            val ahead = read_u16_be(font.blob, cursor) as i64
            cursor = cursor + 2
            if cursor + ahead * 2 + 2 > limit: return false
            coverage_index = 0
            while coverage_index < ahead:
                val offset = read_u16_be(font.blob, cursor + coverage_index * 2) as i64
                if offset == 0 or not gpos_data_coverage(font.blob, actual + offset, limit, 0u32, budget).valid: return false
                coverage_index = coverage_index + 1
            cursor = cursor + ahead * 2
            if cursor + 2 > limit: return false
            val records = read_u16_be(font.blob, cursor) as i64
            cursor = cursor + 2
            if cursor + records * 4 > limit: return false
            var record: i64 = 0
            while record < records:
                val sequence = read_u16_be(font.blob, cursor + record * 4) as i64
                val nested_index = read_u16_be(font.blob, cursor + record * 4 + 2) as i64
                if sequence >= inputs: return false
                var found: Option<GposLookup> = None
                for candidate in catalog:
                    if candidate.lookup_index == nested_index: found = Some(candidate)
                match found:
                    case Some(nested):
                        if not _validate_lookup(font, catalog, nested, depth + 1, budget): return false
                    case None: return false
                record = record + 1
        else: return false
        i = i + 1
    true
fn _lookup(font: OtFont, lookups: [GposLookup], lookup: GposLookup, records: [LayoutGlyphRecord],
           depth: i64, budget: GposDataBudget, activation_mask: u64) -> bool:
    if depth > 16 or lookup.subtable_offsets.len() == 0 or lookup.subtable_offsets.len() != lookup.subtable_ends.len(): return false
    if (lookup.lookup_type != 2u32 and lookup.lookup_type != 4u32 and lookup.lookup_type != 5u32 and
        lookup.lookup_type != 6u32 and lookup.lookup_type != 7u32 and lookup.lookup_type != 8u32 and
        lookup.lookup_type != 9u32): return false
    if lookup.flag != 0u32 and lookup.flag != 8u32 and lookup.flag != 16u32 and lookup.flag != 24u32: return false
    if (lookup.flag & 8u32) != 0u32 and not gpos_data_glyph_class(font, 0u32, budget).valid: return false
    if (lookup.flag & 16u32) != 0u32 and not gpos_data_in_mark_set(font, lookup.mark_filtering_set, 0u32, budget).valid: return false
    var checked: i64 = 0
    while checked < lookup.subtable_offsets.len():
        val sub = lookup.subtable_offsets[checked] as i64
        val limit = _end(lookup, checked)
        if sub < lookup.lookup_offset as i64 or sub + 2 > limit or limit > font.blob.len(): return false
        checked = checked + 1
    var index: i64 = 0
    while index < records.len():
        if not gpos_data_take(budget): return false
        val advance = _Step(next: index + 1, valid: true)
        if not _lookup_at(font, lookups, lookup, records, index, depth, budget, advance,
                          activation_mask): return false
        if advance.next <= index: return false
        index = advance.next
    true
fn _catalog_lookup(catalog: [GposLookup], lookup_index: i64) -> Option<GposLookup>:
    for candidate in catalog:
        if candidate.lookup_index == lookup_index: return Some(candidate)
    None
fn gpos_validate(font: OtFont, active: [LayoutLookupActivation], catalog: [GposLookup],
                 records: [LayoutGlyphRecord]) -> bool:
    val scratch = _copy(records)
    val budget = gpos_data_budget(records, catalog)
    for activation in active:
        if activation.feature_mask == 0u64: return false
        val lookup = match _catalog_lookup(catalog, activation.lookup_index):
            Some(value): value
            None: return false
        if (not _validate_lookup(font, catalog, lookup, 0, budget) or
            not _lookup(font, catalog, lookup, scratch, 0, budget, activation.feature_mask)):
            return false
    true
fn gpos_apply(font: OtFont, active: [LayoutLookupActivation], catalog: [GposLookup],
              records: [LayoutGlyphRecord]) -> LayoutApplyResult:
    if not gpos_validate(font, active, catalog, records): return LayoutApplyResult(glyphs: _copy(records), complete: false)
    val result = _copy(records)
    val budget = gpos_data_budget(records, catalog)
    for activation in active:
        val lookup = match _catalog_lookup(catalog, activation.lookup_index):
            Some(value): value
            None: return LayoutApplyResult(glyphs: _copy(records), complete: false)
        if not _lookup(font, catalog, lookup, result, 0, budget, activation.feature_mask):
            return LayoutApplyResult(glyphs: _copy(records), complete: false)
    LayoutApplyResult(glyphs: result, complete: true)
export gpos_validate, gpos_apply
