# Bounded OpenType context matching. Mutation and nested dispatch stay in
# ot_layout_apply so failed shaping remains one atomic transaction.

use std.skia.feature.glyph.ot_parser.{OtFont, find_table, read_u16_be, read_u32_be}
use std.skia.feature.glyph.ot_parser_layout.GsubLookup

class LayoutGlyphRecord:
    glyph_id: u32
    source_index: i64
    cluster: i64
    component_clusters: [i64]
    feature_mask: u64
    x_advance_units: i64
    y_advance_units: i64
    x_offset_units: i64
    y_offset_units: i64
    x_advance_device_pixels: i64 = 0
    y_advance_device_pixels: i64 = 0
    x_offset_device_pixels: i64 = 0
    y_offset_device_pixels: i64 = 0

class LayoutApplyResult:
    glyphs: [LayoutGlyphRecord]
    complete: bool

class LayoutContextCoverage:
    index: i64
    count: i64
    found: bool
    valid: bool

class LayoutContextMatch:
    matched: bool
    positions: [i64]
    records_offset: i64
    record_count: i64
    work: i64

fn layout_context_coverage(blob: [u8], offset: i64, limit: i64, glyph: u32) -> LayoutContextCoverage:
    if offset < 0 or offset + 4 > limit: return LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)
    val format = read_u16_be(blob, offset)
    val count = read_u16_be(blob, offset + 2) as i64
    if format == 1u32:
        if offset + 4 + count * 2 > limit: return LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)
        var previous: i64 = -1
        var found: i64 = -1
        var index: i64 = 0
        while index < count:
            val current = read_u16_be(blob, offset + 4 + index * 2) as i64
            if current <= previous: return LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)
            if current == glyph as i64: found = index
            previous = current
            index = index + 1
        return LayoutContextCoverage(index: found, count: count, found: found >= 0, valid: true)
    if format == 2u32:
        if offset + 4 + count * 6 > limit: return LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)
        var previous_end: i64 = -1
        var expected: i64 = 0
        var found: i64 = -1
        var index: i64 = 0
        while index < count:
            val record = offset + 4 + index * 6
            val first = read_u16_be(blob, record) as i64
            val last = read_u16_be(blob, record + 2) as i64
            val first_index = read_u16_be(blob, record + 4) as i64
            if first > last or first <= previous_end or first_index != expected:
                return LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)
            expected = first_index + last - first + 1
            if expected > 65536: return LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)
            if glyph as i64 >= first and glyph as i64 <= last: found = first_index + glyph as i64 - first
            previous_end = last
            index = index + 1
        return LayoutContextCoverage(index: found, count: expected, found: found >= 0, valid: true)
    LayoutContextCoverage(index: 0, count: 0, found: false, valid: false)

fn layout_context_gdef_limit(font: OtFont) -> Option<(i64, i64)>:
    val table = match find_table(font, 1195656518u32):
        Some(value): value
        None: return None
    val start = table.offset as i64
    val limit = start + table.length as i64
    if start < 0 or limit < start or limit > font.blob.len() or start + 12 > limit: return None
    val version = read_u32_be(font.blob, start)
    val header_size = if version == 65536u32:
        12
    else if version == 65538u32:
        14
    else if version == 65539u32:
        18
    else:
        return None
    if start + header_size > limit: return None
    Some((start, limit))

fn _layout_context_gdef_header_size(font: OtFont, start: i64) -> i64:
    val version = read_u32_be(font.blob, start)
    if version == 65536u32: return 12
    if version == 65538u32: return 14
    if version == 65539u32: return 18
    -1

fn _layout_context_gdef_child(font: OtFont, bounds: (i64, i64), field: i64) -> Option<i64>:
    val header_size = _layout_context_gdef_header_size(font, bounds.0)
    if header_size < 0 or bounds.0 + field + 2 > bounds.0 + header_size: return None
    val relative = read_u16_be(font.blob, bounds.0 + field) as i64
    if relative < header_size or bounds.0 + relative + 4 > bounds.1: return None
    Some(bounds.0 + relative)

fn _layout_context_class_def_valid(font: OtFont, offset: i64, limit: i64, maximum_class: i64) -> bool:
    if offset <= 0 or offset + 4 > limit: return false
    val format = read_u16_be(font.blob, offset)
    val count = if format == 1u32:
        if offset + 6 > limit: return false
        read_u16_be(font.blob, offset + 4) as i64
    else if format == 2u32:
        read_u16_be(font.blob, offset + 2) as i64
    else:
        return false
    val stride = if format == 1u32: 2 else: 6
    val values = if format == 1u32: offset + 6 else: offset + 4
    if count <= 0 or values + count * stride > limit: return false
    if format == 1u32 and (read_u16_be(font.blob, offset + 2) as i64) + count > 65536: return false
    var previous: i64 = -1
    var index: i64 = 0
    while index < count:
        val item = values + index * stride
        if format == 2u32:
            val first = read_u16_be(font.blob, item) as i64
            val last = read_u16_be(font.blob, item + 2) as i64
            if first > last or first <= previous: return false
            previous = last
        val class_offset = if format == 1u32: item else: item + 4
        if read_u16_be(font.blob, class_offset) as i64 > maximum_class: return false
        index = index + 1
    true

fn _layout_context_gdef_class_valid(font: OtFont, field: i64, maximum_class: i64) -> bool:
    val bounds = match layout_context_gdef_limit(font):
        Some(value): value
        None: return false
    val class_def = match _layout_context_gdef_child(font, bounds, field):
        Some(value): value
        None: return false
    _layout_context_class_def_valid(font, class_def, bounds.1, maximum_class)

fn layout_context_class_def(font: OtFont, offset: i64, limit: i64, glyph: u32) -> Option<i64>:
    if offset <= 0 or offset + 4 > limit: return None
    val format = read_u16_be(font.blob, offset)
    if format == 1u32:
        if offset + 6 > limit: return None
        val first = read_u16_be(font.blob, offset + 2) as i64
        val count = read_u16_be(font.blob, offset + 4) as i64
        if offset + 6 + count * 2 > limit: return None
        val index = glyph as i64 - first
        if index < 0 or index >= count: return Some(0)
        return Some(read_u16_be(font.blob, offset + 6 + index * 2) as i64)
    if format == 2u32:
        val count = read_u16_be(font.blob, offset + 2) as i64
        if offset + 4 + count * 6 > limit: return None
        var previous: i64 = -1
        var index: i64 = 0
        while index < count:
            val item = offset + 4 + index * 6
            val first = read_u16_be(font.blob, item) as i64
            val last = read_u16_be(font.blob, item + 2) as i64
            if first > last or first <= previous: return None
            if glyph as i64 >= first and glyph as i64 <= last: return Some(read_u16_be(font.blob, item + 4) as i64)
            previous = last
            index = index + 1
        return Some(0)
    None

fn layout_context_gdef_glyph_class(font: OtFont, glyph: u32) -> Option<i64>:
    val bounds = match layout_context_gdef_limit(font):
        Some(value): value
        None: return None
    val class_def = match _layout_context_gdef_child(font, bounds, 4):
        Some(value): value
        None: return None
    val glyph_class = match layout_context_class_def(font, class_def, bounds.1, glyph):
        Some(value): value
        None: return None
    if glyph_class > 4: return None
    Some(glyph_class)

fn layout_context_gdef_mark_attach_class(font: OtFont, glyph: u32) -> Option<i64>:
    val bounds = match layout_context_gdef_limit(font):
        Some(value): value
        None: return None
    val class_def = match _layout_context_gdef_child(font, bounds, 10):
        Some(value): value
        None: return None
    val mark_class = match layout_context_class_def(font, class_def, bounds.1, glyph):
        Some(value): value
        None: return None
    if mark_class > 255: return None
    Some(mark_class)

fn layout_context_mark_filter_contains(font: OtFont, set_index: i64, glyph: u32) -> Option<bool>:
    val bounds = match layout_context_gdef_limit(font):
        Some(value): value
        None: return None
    val version = read_u32_be(font.blob, bounds.0)
    if version != 65538u32 and version != 65539u32: return None
    val definition = match _layout_context_gdef_child(font, bounds, 12):
        Some(value): value
        None: return None
    if read_u16_be(font.blob, definition) != 1u32: return None
    val count = read_u16_be(font.blob, definition + 2) as i64
    if set_index < 0 or set_index >= count or definition + 4 + count * 4 > bounds.1: return None
    val coverage_offset = read_u32_be(font.blob, definition + 4 + set_index * 4) as i64
    if coverage_offset < 4 + count * 4: return None
    val covered = layout_context_coverage(font.blob, definition + coverage_offset, bounds.1, glyph)
    if not covered.valid: return None
    Some(covered.found)

fn layout_context_lookup_flag_syntax_valid(flag: u32) -> bool:
    flag <= 65535u32 and (flag & 224u32) == 0u32

fn layout_context_lookup_flag_valid(font: OtFont, flag: u32, mark_filtering_set: i64) -> bool:
    if not layout_context_lookup_flag_syntax_valid(flag): return false
    val class_filters = flag & 65310u32
    if class_filters == 0u32: return true
    if not _layout_context_gdef_class_valid(font, 4, 4): return false
    if (flag & 16u32) != 0u32:
        return mark_filtering_set >= 0 and
            layout_context_mark_filter_contains(font, mark_filtering_set, 0u32) != None
    if (flag & 65280u32) != 0u32:
        return _layout_context_gdef_class_valid(font, 10, 255)
    true

fn layout_context_lookup_class_accepts(flag: u32, glyph_class: i64,
                                       mark_in_filter: Option<bool>,
                                       mark_attach_class: Option<i64>) -> Option<bool>:
    if not layout_context_lookup_flag_syntax_valid(flag) or glyph_class < 0 or glyph_class > 4: return None
    if glyph_class == 1 and (flag & 2u32) != 0u32: return Some(false)
    if glyph_class == 2 and (flag & 4u32) != 0u32: return Some(false)
    if glyph_class != 3: return Some(true)
    if (flag & 8u32) != 0u32: return Some(false)
    if (flag & 16u32) != 0u32: return mark_in_filter
    val attachment_type = (flag & 65280u32) / 256u32
    if attachment_type == 0u32: return Some(true)
    val mark_class = match mark_attach_class:
        Some(value): value
        None: return None
    Some(mark_class == attachment_type as i64)

fn layout_context_lookup_flag_accepts(font: OtFont, flag: u32,
                                      mark_filtering_set: i64, glyph: u32) -> Option<bool>:
    if not layout_context_lookup_flag_syntax_valid(flag): return None
    val class_filters = flag & 65310u32
    if class_filters == 0u32: return Some(true)
    if (flag & 16u32) != 0u32 and mark_filtering_set < 0: return None
    val glyph_class = match layout_context_gdef_glyph_class(font, glyph):
        Some(value): value
        None: return None
    var mark_in_filter: Option<bool> = None
    var mark_attach_class: Option<i64> = None
    if glyph_class == 3 and (flag & 8u32) == 0u32:
        if (flag & 16u32) != 0u32:
            mark_in_filter = layout_context_mark_filter_contains(font, mark_filtering_set, glyph)
        else if (flag & 65280u32) != 0u32:
            mark_attach_class = layout_context_gdef_mark_attach_class(font, glyph)
    layout_context_lookup_class_accepts(flag, glyph_class, mark_in_filter, mark_attach_class)

fn layout_context_lookup_accepts(font: OtFont, lookup: GsubLookup, record: LayoutGlyphRecord) -> Option<bool>:
    layout_context_lookup_flag_accepts(font, lookup.flag, lookup.mark_filtering_set, record.glyph_id)

fn layout_context_next_input(font: OtFont, lookup: GsubLookup, records: [LayoutGlyphRecord], index: i64) -> Option<i64>:
    var cursor = index
    while cursor < records.len():
        val accepted = match layout_context_lookup_accepts(font, lookup, records[cursor]):
            Some(value): value
            None: return None
        if accepted: return Some(cursor)
        cursor = cursor + 1
    Some(-1)

fn layout_context_previous_input(font: OtFont, lookup: GsubLookup, records: [LayoutGlyphRecord], index: i64) -> Option<i64>:
    var cursor = index
    while cursor >= 0:
        val accepted = match layout_context_lookup_accepts(font, lookup, records[cursor]):
            Some(value): value
            None: return None
        if accepted: return Some(cursor)
        cursor = cursor - 1
    Some(-1)

fn layout_context3_positions(font: OtFont, lookup: GsubLookup, subtable: i64, limit: i64,
                       records: [LayoutGlyphRecord], start: i64, maximum_work: i64) -> Option<[i64]>:
    val input_count = read_u16_be(font.blob, subtable + 2) as i64
    if input_count > maximum_work: return None
    var positions: [i64] = []
    var cursor = start
    var input_index: i64 = 0
    while input_index < input_count:
        val position = match layout_context_next_input(font, lookup, records, cursor):
            Some(value): value
            None: return None
        if position < 0: return Some([])
        val coverage = read_u16_be(font.blob, subtable + 6 + input_index * 2) as i64
        val matched = layout_context_coverage(font.blob, subtable + coverage, limit, records[position].glyph_id)
        if not matched.valid: return None
        if not matched.found: return Some([])
        positions.push(position)
        cursor = position + 1
        input_index = input_index + 1
    Some(positions)

fn _no_context_match(work: i64) -> LayoutContextMatch:
    LayoutContextMatch(matched: false, positions: [], records_offset: 0, record_count: 0, work: work)

fn layout_context2_match(font: OtFont, lookup: GsubLookup, subtable: i64, limit: i64,
                         records: [LayoutGlyphRecord], start: i64, maximum_work: i64) -> Option<LayoutContextMatch>:
    var work: i64 = 1
    val covered = layout_context_coverage(font.blob, subtable + read_u16_be(font.blob, subtable + 2) as i64,
        limit, records[start].glyph_id)
    if not covered.valid: return None
    if not covered.found: return Some(_no_context_match(work))
    val first_class = match layout_context_class_def(font, subtable + read_u16_be(font.blob, subtable + 4) as i64,
        limit, records[start].glyph_id):
        Some(value): value
        None: return None
    val set_count = read_u16_be(font.blob, subtable + 6) as i64
    if first_class < 0 or first_class >= set_count: return Some(_no_context_match(work))
    val set_offset = read_u16_be(font.blob, subtable + 8 + first_class * 2) as i64
    if set_offset == 0: return Some(_no_context_match(work))
    val set = subtable + set_offset
    val rule_count = read_u16_be(font.blob, set) as i64
    var rule_index: i64 = 0
    while rule_index < rule_count:
        work = work + 1
        if work > maximum_work: return None
        val rule = set + read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
        val glyph_count = read_u16_be(font.blob, rule) as i64
        val record_count = read_u16_be(font.blob, rule + 2) as i64
        var positions: [i64] = [start]
        var cursor = start + 1
        var input_index: i64 = 1
        var matched = true
        while input_index < glyph_count:
            work = work + 1
            if work > maximum_work: return None
            val position = match layout_context_next_input(font, lookup, records, cursor):
                Some(value): value
                None: return None
            if position < 0:
                matched = false
            else:
                val wanted = read_u16_be(font.blob, rule + 4 + (input_index - 1) * 2) as i64
                val actual = match layout_context_class_def(font, subtable + read_u16_be(font.blob, subtable + 4) as i64,
                    limit, records[position].glyph_id):
                    Some(value): value
                    None: return None
                if wanted != actual: matched = false
                positions.push(position)
                cursor = position + 1
            input_index = input_index + 1
        if matched:
            return Some(LayoutContextMatch(matched: true, positions: positions,
                records_offset: rule + 4 + (glyph_count - 1) * 2,
                record_count: record_count, work: work))
        rule_index = rule_index + 1
    Some(_no_context_match(work))

fn layout_chain3_match(font: OtFont, lookup: GsubLookup, subtable: i64, limit: i64,
                       records: [LayoutGlyphRecord], start: i64, maximum_work: i64) -> Option<LayoutContextMatch>:
    var cursor = subtable + 2
    val backtrack_count = read_u16_be(font.blob, cursor) as i64
    var work = backtrack_count
    if work > maximum_work: return None
    cursor = cursor + 2
    var previous = start - 1
    var backtrack_index: i64 = 0
    var matched = true
    while backtrack_index < backtrack_count:
        val position = match layout_context_previous_input(font, lookup, records, previous):
            Some(value): value
            None: return None
        if position < 0:
            matched = false
        else:
            val covered = layout_context_coverage(font.blob, subtable + read_u16_be(font.blob, cursor + backtrack_index * 2) as i64,
                limit, records[position].glyph_id)
            if not covered.valid: return None
            if not covered.found: matched = false
            previous = position - 1
        backtrack_index = backtrack_index + 1
    cursor = cursor + backtrack_count * 2
    val input_count = read_u16_be(font.blob, cursor) as i64
    work = work + input_count
    if work > maximum_work: return None
    cursor = cursor + 2
    var positions: [i64] = []
    var next = start
    var input_index: i64 = 0
    while input_index < input_count:
        val position = match layout_context_next_input(font, lookup, records, next):
            Some(value): value
            None: return None
        if position < 0:
            matched = false
        else:
            val covered = layout_context_coverage(font.blob, subtable + read_u16_be(font.blob, cursor + input_index * 2) as i64,
                limit, records[position].glyph_id)
            if not covered.valid: return None
            if not covered.found: matched = false
            positions.push(position)
            next = position + 1
        input_index = input_index + 1
    cursor = cursor + input_count * 2
    val lookahead_count = read_u16_be(font.blob, cursor) as i64
    work = work + lookahead_count
    if work > maximum_work: return None
    cursor = cursor + 2
    var lookahead_index: i64 = 0
    while lookahead_index < lookahead_count:
        val position = match layout_context_next_input(font, lookup, records, next):
            Some(value): value
            None: return None
        if position < 0:
            matched = false
        else:
            val covered = layout_context_coverage(font.blob, subtable + read_u16_be(font.blob, cursor + lookahead_index * 2) as i64,
                limit, records[position].glyph_id)
            if not covered.valid: return None
            if not covered.found: matched = false
            next = position + 1
        lookahead_index = lookahead_index + 1
    cursor = cursor + lookahead_count * 2
    val record_count = read_u16_be(font.blob, cursor) as i64
    Some(LayoutContextMatch(matched: matched and positions.len() == input_count,
        positions: positions, records_offset: cursor + 2, record_count: record_count, work: work))

fn layout_chain12_match(font: OtFont, lookup: GsubLookup, subtable: i64, limit: i64,
                        records: [LayoutGlyphRecord], start: i64, classes: bool,
                        maximum_work: i64) -> Option<LayoutContextMatch>:
    var work: i64 = 1
    val covered = layout_context_coverage(font.blob, subtable + read_u16_be(font.blob, subtable + 2) as i64,
        limit, records[start].glyph_id)
    if not covered.valid: return None
    if not covered.found: return Some(_no_context_match(work))
    val set_index = if classes:
        match layout_context_class_def(font, subtable + read_u16_be(font.blob, subtable + 6) as i64,
            limit, records[start].glyph_id):
            Some(value): value
            None: return None
    else:
        covered.index
    val set_count_offset = if classes: subtable + 10 else: subtable + 4
    val set_count = read_u16_be(font.blob, set_count_offset) as i64
    if set_index < 0 or set_index >= set_count: return Some(_no_context_match(work))
    val set_offset = read_u16_be(font.blob, set_count_offset + 2 + set_index * 2) as i64
    if set_offset == 0: return Some(_no_context_match(work))
    val set = subtable + set_offset
    val rule_count = read_u16_be(font.blob, set) as i64
    var rule_index: i64 = 0
    while rule_index < rule_count:
        work = work + 1
        if work > maximum_work: return None
        val rule = set + read_u16_be(font.blob, set + 2 + rule_index * 2) as i64
        var cursor = rule
        val backtrack_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        var previous = start - 1
        var item: i64 = 0
        var matched = true
        while item < backtrack_count:
            work = work + 1
            if work > maximum_work: return None
            val position = match layout_context_previous_input(font, lookup, records, previous):
                Some(value): value
                None: return None
            if position < 0:
                matched = false
            else:
                val wanted = read_u16_be(font.blob, cursor + item * 2) as i64
                val actual = if classes:
                    match layout_context_class_def(font, subtable + read_u16_be(font.blob, subtable + 4) as i64,
                        limit, records[position].glyph_id):
                        Some(value): value
                        None: return None
                else:
                    records[position].glyph_id as i64
                if wanted != actual: matched = false
                previous = position - 1
            item = item + 1
        cursor = cursor + backtrack_count * 2
        val input_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        var positions: [i64] = [start]
        var next = start + 1
        item = 1
        while item < input_count:
            work = work + 1
            if work > maximum_work: return None
            val position = match layout_context_next_input(font, lookup, records, next):
                Some(value): value
                None: return None
            if position < 0:
                matched = false
            else:
                val wanted = read_u16_be(font.blob, cursor + (item - 1) * 2) as i64
                val actual = if classes:
                    match layout_context_class_def(font, subtable + read_u16_be(font.blob, subtable + 6) as i64,
                        limit, records[position].glyph_id):
                        Some(value): value
                        None: return None
                else:
                    records[position].glyph_id as i64
                if wanted != actual: matched = false
                positions.push(position)
                next = position + 1
            item = item + 1
        cursor = cursor + (input_count - 1) * 2
        val lookahead_count = read_u16_be(font.blob, cursor) as i64
        cursor = cursor + 2
        item = 0
        while item < lookahead_count:
            work = work + 1
            if work > maximum_work: return None
            val position = match layout_context_next_input(font, lookup, records, next):
                Some(value): value
                None: return None
            if position < 0:
                matched = false
            else:
                val wanted = read_u16_be(font.blob, cursor + item * 2) as i64
                val actual = if classes:
                    match layout_context_class_def(font, subtable + read_u16_be(font.blob, subtable + 8) as i64,
                        limit, records[position].glyph_id):
                        Some(value): value
                        None: return None
                else:
                    records[position].glyph_id as i64
                if wanted != actual: matched = false
                next = position + 1
            item = item + 1
        cursor = cursor + lookahead_count * 2
        val record_count = read_u16_be(font.blob, cursor) as i64
        if matched and positions.len() == input_count:
            return Some(LayoutContextMatch(matched: true, positions: positions,
                records_offset: cursor + 2, record_count: record_count, work: work))
        rule_index = rule_index + 1
    Some(_no_context_match(work))

export LayoutGlyphRecord, LayoutApplyResult
export LayoutContextCoverage, LayoutContextMatch, layout_context_coverage
export layout_context_gdef_limit, layout_context_class_def, layout_context_gdef_glyph_class
