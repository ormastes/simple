# OpenType gvar table: variable font glyph delta application and packed-delta decoders

use std.skia.entity.path.{SkPath, SkPathVerb, sk_path_new}
use std.skia.feature.glyph.ot_parser.{OtFont, OtTable, find_table, read_u16_be, read_u32_be, read_f2dot14}

# ===== gvar (variable font glyph deltas) =====

class GvarTable:
    axis_count: u32
    shared_tuple_count: u32
    shared_tuples_offset: u32
    glyph_count: u32
    flags: u16
    glyph_variation_data_array_offset: u32
    glyph_variation_data_offsets: [u32]
    # Absolute offset of the gvar table inside `blob`. glyph_variation_data_array_offset
    # is gvar-table-relative per the spec, so the two must be added to address the
    # glyph variation data array.
    table_offset: u32
    # The font blob the table was parsed from, so delta application does not need
    # the enclosing OtFont handed back in.
    blob: [u8]

fn parse_gvar(font: OtFont) -> Option<GvarTable>:
    # Tag 'gvar' = 0x67766172 = [103, 118, 97, 114] = 1735811442.
    # The previous constant, 1735811954, is 0x67766372 ('gvcr'): no real font ever
    # matched it, so parse_gvar always answered None.
    val gvar_tag: u32 = 1735811442
    val maybe_tbl = find_table(font, gvar_tag)
    val tbl = match maybe_tbl:
        Some(value):
            value
        None:
            return None
    val base = tbl.offset as i64
    val blob = font.blob
    # gvar header: majorVersion(u16), minorVersion(u16), axisCount(u16),
    #   sharedTupleCount(u16), sharedTuplesOffset(u32), glyphCount(u16),
    #   flags(u16), glyphVariationDataArrayOffset(u32)
    # total header = 20 bytes
    if base + 19 >= blob.len() as i64:
        return None
    val axis_count = read_u16_be(blob, base + 4) as u32
    val shared_tuple_count = read_u16_be(blob, base + 6) as u32
    val shared_tuples_off = read_u32_be(blob, base + 8)
    val glyph_count = read_u16_be(blob, base + 12) as u32
    val flags = read_u16_be(blob, base + 14) as u16
    val gvar_data_array_off = read_u32_be(blob, base + 16)
    # Offsets array starts at base + 20
    # flags bit 0: 0 = u16 offsets (×2), 1 = u32 offsets
    val use_long_offsets = (flags & 1) != 0
    val offset_count = glyph_count as i64 + 1
    val offsets_base = base + 20
    var offsets: [u32] = []
    var i: i64 = 0
    while i < offset_count:
        if use_long_offsets:
            val off = offsets_base + i * 4
            if off + 3 >= blob.len() as i64:
                offsets.append(0)
            else:
                offsets.append(read_u32_be(blob, off))
        else:
            val off = offsets_base + i * 2
            if off + 1 >= blob.len() as i64:
                offsets.append(0)
            else:
                val raw = read_u16_be(blob, off)
                offsets.append(raw * 2)
        i = i + 1
    Some(GvarTable(
        axis_count: axis_count,
        shared_tuple_count: shared_tuple_count,
        shared_tuples_offset: shared_tuples_off,
        glyph_count: glyph_count,
        flags: flags,
        glyph_variation_data_array_offset: gvar_data_array_off,
        glyph_variation_data_offsets: offsets,
        table_offset: base as u32,
        blob: blob
    ))

# apply_glyph_deltas — apply variable-font deltas using the blob GvarTable was
# parsed from. Equivalent to apply_glyph_deltas_with_font when the font handed in
# there is the same one parse_gvar read.
fn apply_glyph_deltas(outline: SkPath, gvar: GvarTable, glyph_id: u32, normalized_coords: [f64]) -> SkPath:
    _apply_glyph_deltas_blob(gvar.blob, outline, gvar, glyph_id, normalized_coords)

fn apply_glyph_deltas_with_font(font: OtFont, outline: SkPath, gvar: GvarTable, glyph_id: u32, normalized_coords: [f64]) -> SkPath:
    _apply_glyph_deltas_blob(font.blob, outline, gvar, glyph_id, normalized_coords)

fn _apply_glyph_deltas_blob(blob: [u8], outline: SkPath, gvar: GvarTable, glyph_id: u32, normalized_coords: [f64]) -> SkPath:
    if normalized_coords.len() == 0:
        return outline
    if (glyph_id as i64) >= (gvar.glyph_count as i64):
        return outline
    if (gvar.glyph_variation_data_offsets.len() as i64) < ((glyph_id as i64) + 2):
        return outline
    val start_off = gvar.glyph_variation_data_offsets[glyph_id as i64] as i64
    val end_off = gvar.glyph_variation_data_offsets[glyph_id as i64 + 1] as i64
    if start_off >= end_off:
        return outline
    # glyph_variation_data_array_offset is relative to the start of the gvar
    # table, so the table's own absolute offset has to be added.
    val data_base = (gvar.table_offset as i64) + (gvar.glyph_variation_data_array_offset as i64) + start_off
    if data_base + 3 >= blob.len() as i64:
        return outline
    # Gather original points
    val n_segs = outline.segments.len() as i64
    var orig_xs: [f64] = []
    var orig_ys: [f64] = []
    var si: i64 = 0
    while si < n_segs:
        val seg = outline.segments[si]
        var pi: i64 = 0
        while pi < (seg.pts.len() as i64):
            orig_xs.append(seg.pts[pi].x)
            orig_ys.append(seg.pts[pi].y)
            pi = pi + 1
        si = si + 1
    val n_points = orig_xs.len() as i64
    val axis_count = gvar.axis_count as i64
    # Decode the packed TupleVariation delta stream for this glyph.
    val flat = gvar_accumulate_point_deltas(
        blob, data_base, axis_count, gvar.shared_tuple_count as i64, normalized_coords, n_points
    )
    var delta_x: [f64] = []
    var delta_y: [f64] = []
    var fi: i64 = 0
    while fi < n_points:
        delta_x.append(flat[fi])
        delta_y.append(flat[n_points + fi])
        fi = fi + 1
    # Rebuild path applying accumulated deltas
    var new_path = sk_path_new()
    var point_idx: i64 = 0
    var si2: i64 = 0
    while si2 < n_segs:
        val seg = outline.segments[si2]
        if seg.verb == SkPathVerb.Move:
            val nx = orig_xs[point_idx] + delta_x[point_idx]
            val ny = orig_ys[point_idx] + delta_y[point_idx]
            val np = new_path.move_to(nx, ny)
            new_path = np
            point_idx = point_idx + 1
        else if seg.verb == SkPathVerb.Line:
            val nx = orig_xs[point_idx] + delta_x[point_idx]
            val ny = orig_ys[point_idx] + delta_y[point_idx]
            val np = new_path.line_to(nx, ny)
            new_path = np
            point_idx = point_idx + 1
        else if seg.verb == SkPathVerb.Quad:
            val nx1 = orig_xs[point_idx] + delta_x[point_idx]
            val ny1 = orig_ys[point_idx] + delta_y[point_idx]
            val nx2 = orig_xs[point_idx + 1] + delta_x[point_idx + 1]
            val ny2 = orig_ys[point_idx + 1] + delta_y[point_idx + 1]
            val np = new_path.quad_to(nx1, ny1, nx2, ny2)
            new_path = np
            point_idx = point_idx + 2
        else if seg.verb == SkPathVerb.Cubic:
            val nx1 = orig_xs[point_idx] + delta_x[point_idx]
            val ny1 = orig_ys[point_idx] + delta_y[point_idx]
            val nx2 = orig_xs[point_idx + 1] + delta_x[point_idx + 1]
            val ny2 = orig_ys[point_idx + 1] + delta_y[point_idx + 1]
            val nx3 = orig_xs[point_idx + 2] + delta_x[point_idx + 2]
            val ny3 = orig_ys[point_idx + 2] + delta_y[point_idx + 2]
            val np = new_path.cubic_to(nx1, ny1, nx2, ny2, nx3, ny3)
            new_path = np
            point_idx = point_idx + 3
        else if seg.verb == SkPathVerb.Close:
            val np = new_path.close()
            new_path = np
        else:
            pass_do_nothing
        si2 = si2 + 1
    new_path

# ===== gvar packed-delta decoders (per OpenType spec 'gvar' table) =====

# decode_packed_point_numbers — returns (point_numbers, new_offset).
# An empty point-number list (count byte 0x00) means "all glyph points".
fn decode_packed_point_numbers(data: [u8], offset: i64) -> ([i64], i64):
    var off = offset
    if off >= data.len() as i64:
        return ([], off)
    val first = data[off] as i64
    off = off + 1
    var count: i64 = 0
    if (first & 0x80) != 0:
        # 2-byte count: low 7 bits of first + next byte
        if off >= data.len() as i64:
            return ([], off)
        val second = data[off] as i64
        off = off + 1
        count = ((first & 0x7F) << 8) | second
    else:
        count = first
    if count == 0:
        return ([], off)
    var nums: [i64] = []
    var running: i64 = 0
    var emitted: i64 = 0
    while emitted < count and off < (data.len() as i64):
        val ctrl = data[off] as i64
        off = off + 1
        val is_u16 = (ctrl & 0x80) != 0
        val run_len = (ctrl & 0x7F) + 1
        var r: i64 = 0
        while r < run_len and emitted < count and off < (data.len() as i64):
            var delta: i64 = 0
            if is_u16:
                if off + 1 >= data.len() as i64:
                    return (nums, off)
                val hi = data[off] as i64
                val lo = data[off + 1] as i64
                delta = (hi << 8) | lo
                off = off + 2
            else:
                delta = data[off] as i64
                off = off + 1
            running = running + delta
            nums.append(running)
            emitted = emitted + 1
            r = r + 1
    (nums, off)

# decode_packed_deltas — returns (deltas, new_offset).
# Ctrl byte layout: bit7 = zero-run, bit6 = i16 (else i8), low 6 bits = run_len-1.
fn decode_packed_deltas(data: [u8], offset: i64, count: i64) -> ([i64], i64):
    var off = offset
    var deltas: [i64] = []
    var emitted: i64 = 0
    while emitted < count and off < (data.len() as i64):
        val ctrl = data[off] as i64
        off = off + 1
        val is_zero_run = (ctrl & 0x80) != 0
        val is_i16 = (ctrl & 0x40) != 0
        val run_len = (ctrl & 0x3F) + 1
        var r: i64 = 0
        while r < run_len and emitted < count:
            if is_zero_run:
                deltas.append(0)
                emitted = emitted + 1
            else if is_i16:
                if off + 1 >= data.len() as i64:
                    return (deltas, off)
                val hi = data[off] as i64
                val lo = data[off + 1] as i64
                var v = (hi << 8) | lo
                if v >= 32768:
                    v = v - 65536
                off = off + 2
                deltas.append(v)
                emitted = emitted + 1
            else:
                if off >= data.len() as i64:
                    return (deltas, off)
                var v = data[off] as i64
                if v >= 128:
                    v = v - 256
                off = off + 1
                deltas.append(v)
                emitted = emitted + 1
            r = r + 1
    (deltas, off)

# TupleVariation header flags (per OpenType spec):
#   EMBEDDED_PEAK_TUPLE      = 0x8000
#   INTERMEDIATE_REGION      = 0x4000
#   PRIVATE_POINT_NUMBERS    = 0x2000
#   TUPLE_INDEX_MASK         = 0x0FFF
class TupleVariationHeader:
    variation_data_size: i64
    tuple_index: i64
    embedded_peak: [f64]
    intermediate_start: [f64]
    intermediate_end: [f64]
    private_point_numbers: bool

fn parse_tuple_variation_header(data: [u8], offset: i64, axis_count: i64, shared_tuple_count: i64) -> (TupleVariationHeader, i64):
    var off = offset
    if off + 3 >= data.len() as i64:
        val empty = TupleVariationHeader(
            variation_data_size: 0,
            tuple_index: 0,
            embedded_peak: [],
            intermediate_start: [],
            intermediate_end: [],
            private_point_numbers: false
        )
        return (empty, off)
    val size = read_u16_be(data, off) as i64
    val flags_word = read_u16_be(data, off + 2) as i64
    off = off + 4
    val has_embedded_peak = (flags_word & 0x8000) != 0
    val has_intermediate = (flags_word & 0x4000) != 0
    val private_points = (flags_word & 0x2000) != 0
    val tuple_index = flags_word & 0x0FFF
    var peak: [f64] = []
    if has_embedded_peak:
        var ci: i64 = 0
        while ci < axis_count:
            if off + 1 >= data.len() as i64:
                return (TupleVariationHeader(
                    variation_data_size: size,
                    tuple_index: tuple_index,
                    embedded_peak: peak,
                    intermediate_start: [],
                    intermediate_end: [],
                    private_point_numbers: private_points
                ), off)
            peak.append(read_f2dot14(data, off))
            off = off + 2
            ci = ci + 1
    var istart: [f64] = []
    var iend: [f64] = []
    if has_intermediate:
        var ci: i64 = 0
        while ci < axis_count:
            if off + 1 >= data.len() as i64:
                return (TupleVariationHeader(
                    variation_data_size: size,
                    tuple_index: tuple_index,
                    embedded_peak: peak,
                    intermediate_start: istart,
                    intermediate_end: iend,
                    private_point_numbers: private_points
                ), off)
            istart.append(read_f2dot14(data, off))
            off = off + 2
            ci = ci + 1
        var cj: i64 = 0
        while cj < axis_count:
            if off + 1 >= data.len() as i64:
                return (TupleVariationHeader(
                    variation_data_size: size,
                    tuple_index: tuple_index,
                    embedded_peak: peak,
                    intermediate_start: istart,
                    intermediate_end: iend,
                    private_point_numbers: private_points
                ), off)
            iend.append(read_f2dot14(data, off))
            off = off + 2
            cj = cj + 1
    val header = TupleVariationHeader(
        variation_data_size: size,
        tuple_index: tuple_index,
        embedded_peak: peak,
        intermediate_start: istart,
        intermediate_end: iend,
        private_point_numbers: private_points
    )
    (header, off)

# ===== gvar delta application wired to decoders =====

# Piecewise-linear tuple scalar (public helper exposed for testing).
fn _compute_tuple_scalar(peak: [f64], user: [f64]) -> f64:
    var scalar = 1.0
    var i = 0
    while i < peak.length():
        val p = match peak.at(i):
            Some(value):
                value
            None:
                return 0.0
        val u = match user.at(i):
            Some(value):
                value
            None:
                return 0.0
        if p == 0.0:
            # axis not contributing — scalar unchanged
            pass_do_nothing
        else:
            if (p > 0.0 and (u <= 0.0 or u > p)) or (p < 0.0 and (u >= 0.0 or u < p)):
                return 0.0
            val contribution = u / p
            scalar = scalar * contribution
        i = i + 1
    scalar

# gvar_accumulate_point_deltas — decode one glyph's packed TupleVariation delta
# stream and accumulate scalar-weighted per-point deltas.
#
# `data_base` points at the glyph's variation data header
# (tupleVariationCount u16, dataOffset u16). Handles SHARED_POINT_NUMBERS
# (0x8000 of tupleVariationCount), per-tuple PRIVATE_POINT_NUMBERS, embedded
# peak tuples and the packed byte/word/zero-run delta encodings.
#
# Returns a flat [f64] of length 2 * n_points: x-deltas first, then y-deltas.
# A flat array (rather than a tuple of two) keeps callers — including specs —
# off the struct/tuple-field lowering path.
fn gvar_accumulate_point_deltas(blob: [u8], data_base: i64, axis_count: i64, shared_tuple_count: i64, normalized_coords: [f64], n_points: i64) -> [f64]:
    var acc_dx: [f64] = []
    var acc_dy: [f64] = []
    var k: i64 = 0
    while k < n_points:
        acc_dx.append(0.0)
        acc_dy.append(0.0)
        k = k + 1
    if n_points <= 0 or data_base < 0 or data_base + 3 >= (blob.len() as i64):
        return _gvar_flatten_deltas(acc_dx, acc_dy, n_points)
    val tuple_count_raw = read_u16_be(blob, data_base) as i64
    val tuple_count = tuple_count_raw & 0x0FFF
    val has_shared_points = (tuple_count_raw & 0x8000) != 0
    val serial_data_offset = read_u16_be(blob, data_base + 2) as i64
    var serial_pos: i64 = data_base + serial_data_offset
    var shared_points: [i64] = []
    if has_shared_points:
        val sp = decode_packed_point_numbers(blob, serial_pos)
        shared_points = sp.0
        serial_pos = sp.1
    var header_pos: i64 = data_base + 4
    var ti: i64 = 0
    while ti < tuple_count:
        val parsed = parse_tuple_variation_header(blob, header_pos, axis_count, shared_tuple_count)
        val header = parsed.0
        header_pos = parsed.1
        # An empty embedded peak means the tuple references the shared-tuples
        # array, which is outside this glyph's data; _compute_tuple_scalar then
        # yields 1.0, matching the previous behaviour of this path.
        val scalar = _compute_tuple_scalar(header.embedded_peak, normalized_coords)
        val tuple_data_end = serial_pos + header.variation_data_size
        if scalar == 0.0:
            serial_pos = tuple_data_end
            ti = ti + 1
            continue
        var local_pos = serial_pos
        var point_list: [i64] = shared_points
        if header.private_point_numbers:
            val pp = decode_packed_point_numbers(blob, local_pos)
            point_list = pp.0
            local_pos = pp.1
        val listed = point_list.len() as i64
        # An empty point list means "all glyph points".
        val point_count: i64 = if listed == 0: n_points else: listed
        val dxres = decode_packed_deltas(blob, local_pos, point_count)
        val xdeltas = dxres.0
        local_pos = dxres.1
        val dyres = decode_packed_deltas(blob, local_pos, point_count)
        val ydeltas = dyres.0
        var pi: i64 = 0
        while pi < point_count:
            val target_idx: i64 = if listed == 0: pi else: point_list[pi]
            if target_idx >= 0 and target_idx < n_points and pi < (xdeltas.len() as i64) and pi < (ydeltas.len() as i64):
                acc_dx[target_idx] = acc_dx[target_idx] + scalar * (xdeltas[pi] as f64)
                acc_dy[target_idx] = acc_dy[target_idx] + scalar * (ydeltas[pi] as f64)
            pi = pi + 1
        serial_pos = tuple_data_end
        ti = ti + 1
    _gvar_flatten_deltas(acc_dx, acc_dy, n_points)

fn _gvar_flatten_deltas(dx: [f64], dy: [f64], n_points: i64) -> [f64]:
    var out: [f64] = []
    var i: i64 = 0
    while i < n_points:
        out.append(dx[i])
        i = i + 1
    var j: i64 = 0
    while j < n_points:
        out.append(dy[j])
        j = j + 1
    out

# apply_gvar_deltas_to_points — wire the packed-delta decoders into gvar processing.
# Reads the gvar header from the top of gvar_blob, locates this glyph's variation
# data via the offset table, parses each TupleVariation (shared or private point
# numbers, packed x/y deltas), and accumulates scalar-weighted deltas per point.
fn apply_gvar_deltas_to_points(points: [(i64, i64)], gvar_blob: [u8], glyph_id: i64, axis_count: i64, user_coords: [f64]) -> [(i64, i64)]:
    if gvar_blob.len() < 20:
        return points
    # gvar header: majorVersion(u16), minorVersion(u16), axisCount(u16),
    #   sharedTupleCount(u16), sharedTuplesOffset(u32), glyphCount(u16),
    #   flags(u16), glyphVariationDataArrayOffset(u32)
    val shared_tuple_count = read_u16_be(gvar_blob, 6) as i64
    val glyph_count = read_u16_be(gvar_blob, 12) as i64
    val flags = read_u16_be(gvar_blob, 14) as i64
    val data_array_offset = read_u32_be(gvar_blob, 16) as i64
    if glyph_id < 0 or glyph_id >= glyph_count:
        return points
    val use_long_offsets = (flags & 1) != 0
    val offsets_base: i64 = 20
    var start_off: i64 = 0
    var end_off: i64 = 0
    if use_long_offsets:
        val a = offsets_base + glyph_id * 4
        val b = offsets_base + (glyph_id + 1) * 4
        if b + 3 >= gvar_blob.len() as i64:
            return points
        start_off = read_u32_be(gvar_blob, a) as i64
        end_off = read_u32_be(gvar_blob, b) as i64
    else:
        val a = offsets_base + glyph_id * 2
        val b = offsets_base + (glyph_id + 1) * 2
        if b + 1 >= gvar_blob.len() as i64:
            return points
        start_off = (read_u16_be(gvar_blob, a) as i64) * 2
        end_off = (read_u16_be(gvar_blob, b) as i64) * 2
    if start_off >= end_off:
        return points
    val data_base = data_array_offset + start_off
    if data_base + 3 >= gvar_blob.len() as i64:
        return points
    val n_points = points.length()
    # Decode the packed TupleVariation delta stream (shared/private point
    # numbers, packed byte/word/zero-run deltas) via the shared accumulator.
    val flat = gvar_accumulate_point_deltas(gvar_blob, data_base, axis_count, shared_tuple_count, user_coords, n_points)
    var acc_dx: [f64] = []
    var acc_dy: [f64] = []
    var k: i64 = 0
    while k < n_points:
        acc_dx.append(flat[k])
        acc_dy.append(flat[n_points + k])
        k = k + 1
    # Apply accumulated deltas, rounding to i64
    var out: [(i64, i64)] = []
    var oi: i64 = 0
    while oi < n_points:
        val pt = match points.at(oi):
            Some(value):
                value
            None:
                break
        val px = pt.0
        val py = pt.1
        val ddx = match acc_dx.at(oi):
            Some(value):
                value
            None:
                break
        val ddy = match acc_dy.at(oi):
            Some(value):
                value
            None:
                break
        val nx = px + (if ddx >= 0.0: (ddx + 0.5) as i64 else: (ddx - 0.5) as i64)
        val ny = py + (if ddy >= 0.0: (ddy + 0.5) as i64 else: (ddy - 0.5) as i64)
        out.append((nx, ny))
        oi = oi + 1
    out
