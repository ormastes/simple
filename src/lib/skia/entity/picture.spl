# Skia Picture
#
# SkPicture — recorded drawing commands for later playback.

use std.skia.entity.geometry.{SkRect, SkPoint}
use std.skia.entity.paint.{SkPaint, sk_paint_new}
use std.skia.entity.path.{SkPath, SkPathVerb, sk_path_new}
use std.skia.entity.image.{SkImage}
use std.skia.entity.matrix.{Matrix3x3}

# ============================================================================
# SkPictureOp — a recorded drawing operation with optional payload fields
# ============================================================================

enum SkPictureOpKind:
    Save
    SaveLayer
    Restore
    DrawRect
    DrawOval
    DrawPath
    DrawText
    DrawImage
    ClipRect
    SetMatrix
    DrawPaint
    DrawPoints
    DrawRRect
    DrawTextBlob

class SkPictureOp:
    kind: SkPictureOpKind
    rect: SkRect
    rx: f64
    ry: f64
    path: Option<SkPath>
    image: Option<SkImage>
    paint: SkPaint
    x: f64
    y: f64

fn sk_picture_op_draw_rect(rect: SkRect, paint: SkPaint) -> SkPictureOp:
    SkPictureOp(
        kind: SkPictureOpKind.DrawRect,
        rect: rect,
        rx: 0.0,
        ry: 0.0,
        path: None,
        image: None,
        paint: paint,
        x: 0.0,
        y: 0.0
    )

fn sk_picture_op_draw_rrect(rect: SkRect, rx: f64, ry: f64, paint: SkPaint) -> SkPictureOp:
    SkPictureOp(
        kind: SkPictureOpKind.DrawRRect,
        rect: rect,
        rx: rx,
        ry: ry,
        path: None,
        image: None,
        paint: paint,
        x: 0.0,
        y: 0.0
    )

fn sk_picture_op_draw_path(path: SkPath, paint: SkPaint) -> SkPictureOp:
    SkPictureOp(
        kind: SkPictureOpKind.DrawPath,
        rect: SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0),
        rx: 0.0,
        ry: 0.0,
        path: Some(path),
        image: None,
        paint: paint,
        x: 0.0,
        y: 0.0
    )

fn sk_picture_op_draw_image(image: SkImage, x: f64, y: f64, paint: SkPaint) -> SkPictureOp:
    SkPictureOp(
        kind: SkPictureOpKind.DrawImage,
        rect: SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0),
        rx: 0.0,
        ry: 0.0,
        path: None,
        image: Some(image),
        paint: paint,
        x: x,
        y: y
    )

fn sk_picture_op_draw_paint(paint: SkPaint) -> SkPictureOp:
    SkPictureOp(
        kind: SkPictureOpKind.DrawPaint,
        rect: SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0),
        rx: 0.0,
        ry: 0.0,
        path: None,
        image: None,
        paint: paint,
        x: 0.0,
        y: 0.0
    )

# ============================================================================
# SkPicture — immutable recorded display list
# ============================================================================

class SkPicture:
    cull_rect: SkRect
    op_count: i64
    ops: [SkPictureOp]

fn sk_picture_empty() -> SkPicture:
    val empty_ops: [SkPictureOp] = []
    SkPicture(
        cull_rect: SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0),
        op_count: 0,
        ops: empty_ops
    )

impl SkPicture:
    fn cull_rect() -> SkRect:
        self.cull_rect

    fn approximate_op_count() -> i64:
        self.op_count

    fn serialize() -> [i64]:
        # Binary serialization requires native runtime; return empty bytes
        []

# ============================================================================
# SkPictureRecorder — records drawing commands into a picture
# ============================================================================

class SkPictureRecorder:
    recording: bool
    cull_rect: SkRect
    ops: [SkPictureOp]

fn sk_picture_recorder_new() -> SkPictureRecorder:
    val empty_ops: [SkPictureOp] = []
    SkPictureRecorder(
        recording: false,
        cull_rect: SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0),
        ops: empty_ops
    )

impl SkPictureRecorder:
    fn begin_recording(bounds: SkRect) -> SkPictureRecorder:
        val empty_ops: [SkPictureOp] = []
        SkPictureRecorder(recording: true, cull_rect: bounds, ops: empty_ops)

    fn record(op: SkPictureOp):
        self.ops.push(op)

    fn finish_recording() -> SkPicture:
        SkPicture(
            cull_rect: self.cull_rect,
            op_count: self.ops.len() as i64,
            ops: self.ops
        )

    fn is_recording() -> bool:
        self.recording

fn sk_pack_matrix_op_path(m: Matrix3x3) -> SkPath:
    """Losslessly pack the 6 affine entries of Matrix3x3 into an SkPath carrier."""
    sk_path_new().move_to(m.m00, m.m01).line_to(m.m02, m.m10).line_to(m.m11, m.m12)

fn sk_unpack_matrix_from_path(path_opt: Option<SkPath>) -> Option<Matrix3x3>:
    """Unpack a full affine Matrix3x3 encoded by sk_pack_matrix_op_path."""
    if val Some(p) = path_opt:
        if p.segments.len() == 3:
            val s0 = p.segments[0]
            val s1 = p.segments[1]
            val s2 = p.segments[2]
            if (s0.verb == SkPathVerb.Move and s1.verb == SkPathVerb.Line and
                s2.verb == SkPathVerb.Line and
                s0.pts.len() >= 1 and s1.pts.len() >= 1 and s2.pts.len() >= 1):
                return Some(Matrix3x3(
                    m00: s0.pts[0].x, m01: s0.pts[0].y, m02: s1.pts[0].x,
                    m10: s1.pts[0].y, m11: s2.pts[0].x, m12: s2.pts[0].y,
                    m20: 0.0, m21: 0.0, m22: 1.0
                ))
    None

export SkPictureOpKind
export SkPictureOp
export SkPicture
export SkPictureRecorder
export sk_picture_op_draw_rect
export sk_picture_op_draw_rrect
export sk_picture_op_draw_path
export sk_picture_op_draw_image
export sk_picture_op_draw_paint
export sk_pack_matrix_op_path
export sk_unpack_matrix_from_path
export sk_picture_empty
export sk_picture_recorder_new
