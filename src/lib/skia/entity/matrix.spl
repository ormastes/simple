# Skia Matrix — Matrix3x3 for 2D transforms
#
# Re-exports the common-tier Matrix3x3 (moved to
# src/lib/common/drawing/vector.spl on 2026-08-09 — see
# doc/08_tracking/bug/matrix3x3_missing_from_std_common_drawing_vector_2026-08-04.md)
# so existing `use std.skia.entity.matrix.{Matrix3x3}` call sites keep working
# without inverting the common/skia tier order.
#
# Usage:
#   val t = Matrix3x3.translate(tx: 10.0, ty: 20.0)
#   val s = Matrix3x3.scale(sx: 2.0, sy: 3.0)
#   val r = Matrix3x3.rotate_degrees(deg: 45.0)

use std.common.drawing.vector.{Matrix3x3}

export Matrix3x3
