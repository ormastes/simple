# Skia Color Type
#
# SkColor4f — four-component float RGBA used throughout Skia.
# We wrap the stdlib Color for conversion but define SkColor4f as primary.

use std.common.color.types.{Color}

# ============================================================================
# SkColor4f — float RGBA [0.0, 1.0]
# ============================================================================

class SkColor4f:
    r: f64
    g: f64
    b: f64
    a: f64

fn sk_color4f(r: f64, g: f64, b: f64, a: f64) -> SkColor4f:
    SkColor4f(r: r, g: g, b: b, a: a)

fn sk_color4f_from_color(c: Color) -> SkColor4f:
    val cr: i64 = c.r
    val cg: i64 = c.g
    val cb: i64 = c.b
    val ca: i64 = c.a
    SkColor4f(
        r: (cr as f64) / 255.0,
        g: (cg as f64) / 255.0,
        b: (cb as f64) / 255.0,
        a: (ca as f64) / 255.0
    )

# ============================================================================
# SkColor — packed 32-bit ARGB (u32 equivalent via i64)
# ============================================================================

# Packed color as i64 (upper 8 bits = alpha, then R, G, B)
type SkColor = i64

fn sk_color_argb(a: i64, r: i64, g: i64, b: i64) -> SkColor:
    ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)

fn sk_color_rgb(r: i64, g: i64, b: i64) -> SkColor:
    sk_color_argb(255, r, g, b)

fn sk_color_alpha(c: SkColor) -> i64:
    (c >> 24) & 0xFF

fn sk_color_red(c: SkColor) -> i64:
    (c >> 16) & 0xFF

fn sk_color_green(c: SkColor) -> i64:
    (c >> 8) & 0xFF

fn sk_color_blue(c: SkColor) -> i64:
    c & 0xFF

# Named color constants
fn sk_color_black() -> SkColor: sk_color_argb(255, 0, 0, 0)
fn sk_color_white() -> SkColor: sk_color_argb(255, 255, 255, 255)
fn sk_color_preset_red() -> SkColor: sk_color_argb(255, 255, 0, 0)
fn sk_color_preset_green() -> SkColor: sk_color_argb(255, 0, 128, 0)
fn sk_color_preset_blue() -> SkColor: sk_color_argb(255, 0, 0, 255)
fn sk_color_transparent() -> SkColor: sk_color_argb(0, 0, 0, 0)

fn _sk_unit_to_u8(v: f64) -> i64:
    if v <= 0.0:
        return 0
    if v >= 1.0:
        return 255
    ((v * 255.0 + 0.5) as i64) & 0xFF

impl SkColor4f:
    fn to_sk_color() -> SkColor:
        val af: f64 = self.a
        val rf: f64 = self.r
        val gf: f64 = self.g
        val bf: f64 = self.b
        val a = _sk_unit_to_u8(af)
        val r = _sk_unit_to_u8(rf)
        val g = _sk_unit_to_u8(gf)
        val b = _sk_unit_to_u8(bf)
        sk_color_argb(a, r, g, b)

    fn to_string() -> text:
        "SkColor4f(r:{self.r} g:{self.g} b:{self.b} a:{self.a})"

export SkColor
export SkColor4f
export sk_color4f
export sk_color4f_from_color
export sk_color_argb
export sk_color_rgb
export sk_color_alpha
export sk_color_red
export sk_color_green
export sk_color_blue
export sk_color_black
export sk_color_white
export sk_color_transparent
