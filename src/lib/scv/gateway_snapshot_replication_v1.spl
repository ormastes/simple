export SCV_GATEWAY_SNAPSHOT_MAX_MISSING_V1, SCV_GATEWAY_SNAPSHOT_MAX_TOTAL_BYTES_V1
export scv_gateway_snapshot_manifest_validate_v1, scv_gateway_snapshot_manifest_encode_v1
export scv_gateway_snapshot_pin_id_v1
export scv_gateway_snapshot_manifest_decode_v1, scv_gateway_snapshot_request_encode_v1, scv_gateway_snapshot_request_decode_v1
export scv_gateway_snapshot_read_request_encode_v1, scv_gateway_snapshot_read_request_decode_v1
export scv_gateway_snapshot_read_response_encode_v1, scv_gateway_snapshot_read_response_decode_v1
export scv_gateway_snapshot_response_encode_v1, scv_gateway_snapshot_response_decode_v1

export scv_gateway_snapshot_closure_verify_v1
