# SCV evidence-based file matcher (report §7.9 stage A/B, file level only).
#
# Classifies the delta between two tree payloads (store.spl tree-object
# format: "rel|file_obj_id|chunk|size|mtime" per line, where `chunk` is the
# whole-content chunk id readable at scv_chunk_path) and feeds identity.spl:
#   unchanged / edited (same path, new content) /
#   move (exact-content rename, unique on BOTH sides -> accepted, 1000) /
#   move_edit (line overlap > 70% -> suggested edge, score recorded) /
#   new / deleted.
#
# Bounded: at most SCV_ENTITY_MAX_PAIRS deleted x added similarity
# comparisons; beyond the cap files fail open to new+deleted (reported,
# never guessed). Symbol-level EntityId matching (parser-driven) is out of
# scope here — see doc/05_design/app/tools/scv.md.

use app.io.mod (file_exists, file_read)
use std.scv.core.{scv_chunk_path}
use std.scv.identity.{scv_identity_allocate, scv_identity_lookup_by_path, scv_identity_record_move, scv_identity_record_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_list}
use std.scv.refactoring_relations.{RefactorFileInput, scv_refactor_infer}

val SCV_ENTITY_MAX_PAIRS = 512
val SCV_ENTITY_MOVE_EDIT_MIN_MILLI = 700

fn scv_entity_line_field(line: text, index: i64) -> text:
    val parts = line.trim().split("|")
    if index < parts.len():
        parts[index]
    else:
        ""

fn scv_entity_tree_lines(tree_payload: text) -> [text]:
    var out: [text] = []
    for line in tree_payload.split("\n"):
        if line.trim() != "" and line.contains("|"):
            out.push(line.trim())
    out

fn scv_entity_chunk_for(lines: [text], rel: text) -> text:
    for line in lines:
        if scv_entity_line_field(line, 0) == rel:
            return scv_entity_line_field(line, 2)
    ""

fn scv_entity_has_path(lines: [text], rel: text) -> bool:
    for line in lines:
        if scv_entity_line_field(line, 0) == rel:
            return true
    false

fn scv_entity_count_chunk(lines: [text], chunk: text) -> i64:
    var n = 0
    for line in lines:
        if scv_entity_line_field(line, 2) == chunk:
            n = n + 1
    n

fn scv_entity_read_content(root: text, chunk: text) -> text:
    val path = scv_chunk_path(root, chunk)
    if file_exists(path):
        file_read(path)
    else:
        ""

# Line-overlap similarity in milli (0..1000): shared lines / max line count.
# The CDC chunk-hash overlap variant is deferred (see design doc).
fn scv_entity_line_overlap_milli(a: text, b: text) -> i64:
    var a_lines: [text] = []
    for line in a.split("\n"):
        if line.trim() != "":
            a_lines.push(line)
    var b_lines: [text] = []
    for line in b.split("\n"):
        if line.trim() != "":
            b_lines.push(line)
    if a_lines.len() == 0 or b_lines.len() == 0:
        return 0
    var used: [bool] = []
    for _ in b_lines:
        used.push(false)
    var shared = 0
    for la in a_lines:
        var j = 0
        while j < b_lines.len():
            if not used[j] and b_lines[j] == la:
                used[j] = true
                shared = shared + 1
                break
            j = j + 1
    val denom = if a_lines.len() > b_lines.len(): a_lines.len() else: b_lines.len()
    (shared * 1000) / denom

# Classify prev->new tree delta. Returns rows "class|path|other_path|score_milli".
fn scv_entity_list_has(items: [text], value: text) -> bool:
    for item in items:
        if item == value:
            return true
    false

fn scv_entity_classify(root: text, prev_payload: text, new_payload: text) -> [text]:
    val prev_lines = scv_entity_tree_lines(prev_payload)
    val new_lines = scv_entity_tree_lines(new_payload)
    var out: [text] = []
    var deleted: [text] = []
    var added: [text] = []
    for line in prev_lines:
        val rel = scv_entity_line_field(line, 0)
        if scv_entity_has_path(new_lines, rel):
            if scv_entity_chunk_for(new_lines, rel) == scv_entity_line_field(line, 2):
                out.push("unchanged|{rel}||1000")
            else:
                out.push("edited|{rel}||1000")
        else:
            deleted.push(rel)
    for line in new_lines:
        val rel = scv_entity_line_field(line, 0)
        if not scv_entity_has_path(prev_lines, rel):
            added.push(rel)
    var matched_del: [text] = []
    var matched_add: [text] = []
    # Stage A: exact-content rename, unique on both sides -> accepted move.
    for del in deleted:
        val chunk = scv_entity_chunk_for(prev_lines, del)
        if scv_entity_count_chunk(prev_lines, chunk) != 1:
            continue
        var hits: [text] = []
        for add in added:
            if scv_entity_chunk_for(new_lines, add) == chunk:
                hits.push(add)
        if hits.len() == 1 and scv_entity_count_chunk(new_lines, chunk) == 1:
            out.push("move|{del}|{hits[0]}|1000")
            matched_del.push(del)
            matched_add.push(hits[0])
        elif hits.len() > 1:
            # Ambiguous identical content: suggested only, never accepted.
            out.push("move_ambiguous|{del}|{hits[0]}|1000")
            matched_del.push(del)
    # Stage B: bounded rename+edit candidates -> suggested move_edit.
    var pairs = 0
    for del in deleted:
        if scv_entity_list_has(matched_del, del):
            continue
        var best_add = ""
        var best_score = 0
        val del_content = scv_entity_read_content(root, scv_entity_chunk_for(prev_lines, del))
        for add in added:
            if scv_entity_list_has(matched_add, add):
                continue
            if pairs >= SCV_ENTITY_MAX_PAIRS:
                break
            pairs = pairs + 1
            val score = scv_entity_line_overlap_milli(del_content, scv_entity_read_content(root, scv_entity_chunk_for(new_lines, add)))
            if score > best_score:
                best_score = score
                best_add = add
        if best_add != "" and best_score > SCV_ENTITY_MOVE_EDIT_MIN_MILLI:
            out.push("move_edit|{del}|{best_add}|{best_score}")
            matched_del.push(del)
            matched_add.push(best_add)
    for del in deleted:
        if not scv_entity_list_has(matched_del, del):
            out.push("deleted|{del}||0")
    for add in added:
        if not scv_entity_list_has(matched_add, add):
            out.push("new|{add}||0")
    out

# Apply a classification to the identity store for `commit`.
# Returns the classification rows actually applied.
fn scv_entity_apply(root: text, prev_payload: text, new_payload: text, commit: text) -> [text]:
    val rows = scv_entity_classify(root, prev_payload, new_payload)
    for row in rows:
        val parts = row.split("|")
        val kind = parts[0]
        val a = parts[1]
        val b = parts[2]
        val score = parts[3].to_int() ?? 0
        if kind == "unchanged" or kind == "edited":
            if scv_identity_lookup_by_path(root, a) == "":
                scv_identity_allocate(root, a, commit)
        elif kind == "move":
            scv_identity_record_move(root, a, b, commit, "exact_content,unique_pair", 1000, "accepted")
        elif kind == "move_edit":
            # Suggested only: id is NOT moved; the added path gets its own id
            # until a human or later evidence accepts the edge.
            scv_identity_record_move(root, a, b, commit, "line_overlap", score, "suggested")
            scv_identity_allocate(root, b, commit)
        elif kind == "move_ambiguous":
            scv_identity_record_move(root, a, b, commit, "exact_content,ambiguous", score, "suggested")
            scv_identity_allocate(root, b, commit)
        elif kind == "deleted":
            scv_identity_record_delete(root, a, commit)
        elif kind == "new":
            scv_identity_allocate(root, a, commit)
    rows

export SCV_ENTITY_MAX_PAIRS, SCV_ENTITY_MOVE_EDIT_MIN_MILLI
export scv_entity_classify, scv_entity_apply, scv_entity_line_overlap_milli, scv_entity_read_content

# --- SCV-IMPL-I-05: confidence calibration corpus + oracle -------------------
#
# Curated rename/move/extract corpus under test/fixtures/scv_identity_corpus/:
# one directory per case with old/<rel>, new/<rel> and truth.sdn ground-truth
# rows:
#   accept|kind|from|to    this relation is TRUE and may be auto-accepted
#   infer|kind|from        a suggested (Inferred) row is expected, never accepted
#   ambiguous|kind|from    any ACCEPTED row from `from` is wrong (I-05 contract:
#                          ambiguity is surfaced, never silently accepted)
#
# Confidence classes (I-05):
#   Explicit      accepted, confidence == 1000 (anchor / exact-content match)
#   Verified-high accepted, confidence >= 900 (< 1000)
#   Inferred      suggested
#   Unresolved    ambiguous
#
# Precision = accepted-correct / accepted-total, over accepted rows only
# (Explicit + Verified-high). Ambiguous rows are asserted to NEVER appear as
# accepted. Bounded: SCV_CORPUS_MIN_CASES..SCV_CORPUS_MAX_CASES.

val SCV_CORPUS_MIN_CASES = 30
val SCV_CORPUS_MAX_CASES = 200
val SCV_CORPUS_PRECISION_GATE_MILLI_X100 = 99500

fn scv_corpus_sorted(names: [text]) -> [text]:
    var out: [text] = []
    for name in names:
        out.push(name)
    var i = 0
    while i < out.len():
        var j = i + 1
        while j < out.len():
            if out[j] < out[i]:
                val t = out[i]
                out[i] = out[j]
                out[j] = t
            j = j + 1
        i = i + 1
    out

fn scv_corpus_case_inputs(case_dir: text) -> [RefactorFileInput]:
    var rels: [text] = []
    for side in ["old", "new"]:
        if file_exists("{case_dir}/{side}"):
            for name in dir_list("{case_dir}/{side}"):
                var seen = false
                for r in rels:
                    if r == name:
                        seen = true
                if not seen:
                    rels.push(name)
    var out: [RefactorFileInput] = []
    for rel in scv_corpus_sorted(rels):
        val old_path = "{case_dir}/old/{rel}"
        val new_path = "{case_dir}/new/{rel}"
        val old_text = if file_exists(old_path): file_read(old_path) else: ""
        val new_text = if file_exists(new_path): file_read(new_path) else: ""
        out.push(RefactorFileInput(rel: rel, old_text: old_text, new_text: new_text))
    out

fn scv_corpus_class_of(status: text, confidence_milli: i64) -> text:
    if status == "accepted":
        if confidence_milli >= 1000:
            return "Explicit"
        return "Verified-high"
    if status == "suggested":
        return "Inferred"
    "Unresolved"

# Evaluate the whole corpus through the landed I-04 matcher. Result record
# ends in a house verdict line: PASS/FAIL/ERROR.
fn scv_corpus_evaluate(corpus_root: text) -> text:
    if not file_exists(corpus_root):
        return "ERROR — nothing was checked (corpus root missing: {corpus_root})\n"
    val cases = scv_corpus_sorted(dir_list(corpus_root))
    if cases.len() < SCV_CORPUS_MIN_CASES:
        return "ERROR — nothing was checked (corpus too small: {cases.len()} case(s), minimum {SCV_CORPUS_MIN_CASES})\n"
    if cases.len() > SCV_CORPUS_MAX_CASES:
        return "ERROR — nothing was checked (corpus unbounded: {cases.len()} case(s), maximum {SCV_CORPUS_MAX_CASES})\n"
    var accepted_total = 0
    var accepted_correct = 0
    var explicit_n = 0
    var verified_n = 0
    var inferred_n = 0
    var unresolved_n = 0
    var ambiguous_accepted = 0
    var wrong: [text] = []
    for case_name in cases:
        val case_dir = "{corpus_root}/{case_name}"
        if not file_exists("{case_dir}/truth.sdn"):
            continue
        var truth_accept: [text] = []
        var truth_ambiguous_from: [text] = []
        for line in file_read("{case_dir}/truth.sdn").split("\n"):
            val t = line.trim()
            if t.starts_with("accept|"):
                truth_accept.push(t["accept|".len():])
            elif t.starts_with("ambiguous|"):
                val parts = t.split("|")
                if parts.len() >= 3:
                    truth_ambiguous_from.push(parts[2])
        val rows = scv_refactor_infer(scv_corpus_case_inputs(case_dir))
        for row in rows:
            val parts = row.split("|")
            if parts.len() < 6:
                continue
            val kind = parts[0]
            val from_ref = parts[1]
            val to_ref = parts[2]
            val conf = parts[3].to_int() ?? 0
            val status = parts[5]
            val cls = scv_corpus_class_of(status, conf)
            if cls == "Explicit":
                explicit_n = explicit_n + 1
            elif cls == "Verified-high":
                verified_n = verified_n + 1
            elif cls == "Inferred":
                inferred_n = inferred_n + 1
            else:
                unresolved_n = unresolved_n + 1
            if status != "accepted":
                continue
            accepted_total = accepted_total + 1
            # Ambiguity must never be silently accepted: an accepted row whose
            # `from` the truth marks ambiguous is a hard offender.
            var is_ambiguous_from = false
            for a in truth_ambiguous_from:
                if from_ref.contains(a):
                    is_ambiguous_from = true
            if is_ambiguous_from:
                ambiguous_accepted = ambiguous_accepted + 1
                wrong.push("{case_name}: accepted over ambiguous ground truth: {row}\n")
                continue
            var ok = false
            for t in truth_accept:
                if "{kind}|{from_ref}|{to_ref}" == t:
                    ok = true
            if ok:
                accepted_correct = accepted_correct + 1
            else:
                wrong.push("{case_name}: accepted row not in ground truth: {row}\n")
    var report = "identity_precision:\n  cases: {cases.len()}\n"
    report = report + "  classes: explicit={explicit_n} verified_high={verified_n} inferred={inferred_n} unresolved={unresolved_n}\n"
    report = report + "  accepted: total={accepted_total} correct={accepted_correct}\n"
    report = report + "  ambiguous_accepted: {ambiguous_accepted}\n"
    report = report + wrong.join("")
    if accepted_total == 0:
        return report + "ERROR — nothing was checked (0 accepted rows over {cases.len()} case(s))\n"
    val precision_x100 = accepted_correct * 100000 / accepted_total
    val whole = precision_x100 / 1000
    val frac = precision_x100 % 1000
    report = report + "  precision_milli_x100: {precision_x100} ({whole}.{frac}%)\n"
    if ambiguous_accepted > 0:
        return report + "FAIL — {ambiguous_accepted} ambiguous relation(s) silently accepted; precision {precision_x100}/100000 over {accepted_total} accepted row(s)\n"
    if precision_x100 < SCV_CORPUS_PRECISION_GATE_MILLI_X100:
        return report + "FAIL — precision {precision_x100}/100000 < 99500/100000 over {accepted_total} accepted row(s), {cases.len()} case(s)\n"
    report + "PASS — precision {precision_x100}/100000 >= 99500/100000: {accepted_correct}/{accepted_total} accepted row(s) correct, {cases.len()} case(s), 0 ambiguous accepted\n"

export SCV_CORPUS_MIN_CASES, SCV_CORPUS_MAX_CASES, SCV_CORPUS_PRECISION_GATE_MILLI_X100
export scv_corpus_case_inputs, scv_corpus_class_of, scv_corpus_evaluate
