# SCV coalescer/settle layer (SCV-IMPL-E-04).
#
# Batches raw watcher events by SOURCE CLASS with a logical clock (now_ms is
# always passed in — deterministic, no sleeping):
#   editor — micro-batch on the short editor window
#   fs     — settle window (a later event on a path restarts its window)
#   save   — flushed immediately
#   vcs    — (and any bulk source) deferred until an explicit bulk_end
# Repeated events with the same (path, kind) inside a window coalesce to one.
# Atomic saves (tmp write + rename-to-target + tmp delete) normalize to a
# single modify of the TARGET path via scv_coalesce_atomic_save.

use std.nogc_async_mut.file_system.event_watch.{FsWatchEvent}

struct ScvCoalescePending:
    seq: i64
    kind: text
    path: text
    related: text
    klass: text    # editor | fs | save | vcs
    due_ms: i64    # logical release time; -1 = held until bulk_end

struct ScvCoalescer:
    editor_ms: i64
    settle_ms: i64
    bulk_active: bool
    pending: [ScvCoalescePending]

fn scv_coalesce_open(editor_ms: i64, settle_ms: i64) -> ScvCoalescer:
    ScvCoalescer(editor_ms: editor_ms, settle_ms: settle_ms,
                 bulk_active: false, pending: [])

fn scv_coalesce_pending_count(c: ScvCoalescer) -> i64:
    c.pending.len()

fn scv_coalesce_due(c: ScvCoalescer, klass: text, now_ms: i64) -> i64:
    if klass == "save":
        now_ms
    elif klass == "editor":
        now_ms + c.editor_ms
    elif klass == "vcs" or klass == "bulk":
        -1
    else:
        now_ms + c.settle_ms

# Add one raw event. A pending entry with the same (path, kind) is coalesced:
# its window restarts at the new event's time, its first seq is kept.
fn scv_coalesce_add(c: ScvCoalescer, ev: FsWatchEvent, klass: text, now_ms: i64) -> ScvCoalescer:
    var next = c
    val effective = if next.bulk_active and (klass == "vcs" or klass == "bulk"): "vcs" else: klass
    val due = scv_coalesce_due(next, effective, now_ms)
    var i = 0
    while i < next.pending.len():
        if next.pending[i].path == ev.path and next.pending[i].kind == ev.kind:
            next.pending[i].due_ms = due
            next.pending[i].related = ev.related
            return next
        i = i + 1
    next.pending.push(ScvCoalescePending(seq: ev.seq, kind: ev.kind, path: ev.path,
                                         related: ev.related, klass: effective, due_ms: due))
    next

# Release every settled entry (due_ms >= 0 and due_ms <= now_ms). Held bulk
# entries (due_ms == -1) never settle by time.
fn scv_coalesce_flush_ready(c: ScvCoalescer, now_ms: i64) -> (ScvCoalescer, [FsWatchEvent]):
    var next = c
    var out: [FsWatchEvent] = []
    var keep: [ScvCoalescePending] = []
    for p in next.pending:
        if p.due_ms >= 0 and p.due_ms <= now_ms:
            out.push(FsWatchEvent(seq: p.seq, kind: p.kind, path: p.path, related: p.related))
        else:
            keep.push(p)
    next.pending = keep
    (next, out)

fn scv_coalesce_bulk_begin(c: ScvCoalescer) -> ScvCoalescer:
    var next = c
    next.bulk_active = true
    next

# End the bulk generation: held entries become releasable on the next flush.
fn scv_coalesce_bulk_end(c: ScvCoalescer) -> ScvCoalescer:
    var next = c
    next.bulk_active = false
    var i = 0
    while i < next.pending.len():
        if next.pending[i].due_ms < 0:
            next.pending[i].due_ms = 0
        i = i + 1
    next

fn _scv_atomic_has(events: [FsWatchEvent], kind: text, path: text) -> bool:
    for ev in events:
        if ev.kind == kind and ev.path == path:
            return true
    false

# Atomic-save normalization: created(tmp) + renamed(target, related=tmp)
# [+ deleted(tmp)] collapses to ONE modified(target). A rename whose source
# was never created in the same batch is a genuine rename and is kept.
fn scv_coalesce_atomic_save(events: [FsWatchEvent]) -> [FsWatchEvent]:
    var out: [FsWatchEvent] = []
    var drop_tmp: [text] = []
    for ev in events:
        if ev.kind == "renamed" and ev.related != "" and _scv_atomic_has(events, "created", ev.related):
            out.push(FsWatchEvent(seq: ev.seq, kind: "modified", path: ev.path, related: ""))
            drop_tmp.push(ev.related)
    for ev in events:
        if ev.kind == "renamed" and ev.related != "" and _scv_atomic_has(events, "created", ev.related):
            continue
        var dropped = false
        for tmp in drop_tmp:
            if (ev.kind == "created" or ev.kind == "deleted") and ev.path == tmp:
                dropped = true
        if not dropped:
            out.push(ev)
    out
