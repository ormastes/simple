# Pure compile-inventory records, canonicalization, and event reduction.
# I/O and publication remain in compile_source_inventory.spl.

use std.common.crypto.sha256.{sha256_text}
use std.common.text_whitespace.{split_whitespace}

val COMPILE_SOURCE_INVENTORY_SCHEMA_V1: i64 = 1
val COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1: i64 = 256 * 1024 * 1024

struct CompileSourceInventoryEntryV1:
    source_identity: text
    content_digest: text
    semantic_digest: text
    export_digest: text
    initializer_digest: text
    provider_digest: text
    byte_count: i64

struct CompileSourceEventV1:
    source: text
    operation: text
    source_identity: text
    content_digest: text
    semantic_digest: text
    export_digest: text
    initializer_digest: text
    provider_digest: text
    byte_count: i64

struct CompileSourceGitChangeV1:
    operation: text
    source_identity: text
    content: text

struct CompileSourceInventoryV1:
    schema_version: i64
    generation: i64
    entries: [CompileSourceInventoryEntryV1]

struct CompileSourceInventoryReadV1:
    valid: bool
    reason: text
    digest: text
    inventory: CompileSourceInventoryV1?

struct CompileSourceInventoryChangeV1:
    valid: bool
    reason: text
    inventory: CompileSourceInventoryV1?
    content_changed: bool
    semantics_changed: bool

fn compile_source_inventory_strip_comments_v1(content: text) -> text:
    var rows: [text] = []
    for line in content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"):
            continue
        # split_whitespace is a free function, not a text method: the method
        # form resolved to `str.split_whitespace`, which exists nowhere, and
        # aborted every inventory refresh (rc=70) under the seed.
        rows = rows.push(split_whitespace(trimmed).join(" "))
    rows.join("\n")

# Facet text keyed off an ALREADY-canonicalized (comment/blank stripped) text.
# `compile_source_inventory_facet_text_v1` below stripped comments itself on
# every call, so one file paid for `strip_comments` 4 times (semantic, export,
# initializer, provider) even though all four facets share the same canonical
# text. This is the same canonicalization, just computed once and reused.
fn compile_source_inventory_facet_rows_from_canonical_v1(
    canonical: text, facet: text
) -> text:
    if facet == "semantic":
        return canonical
    var rows: [text] = []
    for line in canonical.split("\n"):
        if (facet == "export" and (line.starts_with("export ") or
                line.starts_with("pub "))) or
                (facet == "initializer" and (line.starts_with("val ") or
                    line.starts_with("var ") or line.starts_with("init "))) or
                (facet == "provider" and (line.starts_with("use ") or
                    line.starts_with("impl ") or line.starts_with("provider "))):
            rows = rows.push(line)
    rows.join("\n")

fn compile_source_inventory_facet_text_v1(content: text, facet: text) -> text:
    compile_source_inventory_facet_rows_from_canonical_v1(
        compile_source_inventory_strip_comments_v1(content), facet)

# Whole-text canonicalization. The per-line reference above costs ~35 runtime
# calls per source line (split, trim, split_whitespace's split + per-token
# trim, join, seven prefix tests); over a 44,758-file / 7.4M-line src+test
# cold inventory that was ~200 s of the ~360 s Stage 2 cold init (x86_64
# Linux, 2026-10-04, see
# doc/08_tracking/bug/stage2_x86_64_hir_shard_worker_segv_startup_2026-10-04.md).
# The functions below compute the SAME texts with a handful of whole-text
# replace/split calls per file, so runtime calls scale with comment and facet
# lines instead of with every token of every line.
#
# They are exact only when space and newline are the sole whitespace in the
# file: then `trim` + `split_whitespace(...).join(" ")` of a line is "collapse
# space runs, drop one edge space", which whole-text replaces reproduce.
# Every other character that `trim` (Unicode White_Space on the Rust lane) or
# the per-token trim could remove sends the file to the reference path.
fn compile_source_inventory_whole_text_eligible_v1(content: text) -> bool:
    for needle in ["\t", "\r", "\u{b}", "\u{c}", "\u{85}", "\u{a0}", "\u{1680}",
            "\u{2000}", "\u{2001}", "\u{2002}", "\u{2003}", "\u{2004}", "\u{2005}",
            "\u{2006}", "\u{2007}", "\u{2008}", "\u{2009}", "\u{200a}", "\u{2028}",
            "\u{2029}", "\u{202f}", "\u{205f}", "\u{3000}"]:
        if content.contains(needle):
            return false
    true

# Canonical text of an eligible file: the reference loop's non-blank,
# non-comment lines, each trimmed with space runs collapsed, joined by "\n".
fn compile_source_inventory_whole_text_canonical_v1(content: text) -> text:
    var body = content
    while body.contains("  "):
        body = body.replace("  ", " ")
    # Runs are single spaces now, so one leading/trailing space per line is
    # all that trim would remove. Framing newlines make every line uniform.
    body = ("\n" + body + "\n").replace("\n ", "\n").replace(" \n", "\n")
    while body.contains("\n\n"):
        body = body.replace("\n\n", "\n")
    # body is "\n" or "\n" + lines + "\n" with no blank line. A doubled
    # newline therefore marks exactly the comment lines; drop each marked
    # piece's first line (the comment) and keep the rest of that piece.
    if body.contains("\n#"):
        var pieces = body.replace("\n#", "\n\n#").split("\n\n")
        var index = 1
        while index < pieces.len():
            var rows = pieces[index].split("\n")
            rows[0] = ""
            pieces[index] = rows.join("\n")
            index = index + 1
        body = pieces.join("")
    # Every kept line is non-empty and edge-trimmed, so trim removes exactly
    # the two framing newlines ("\n" alone becomes "").
    body.trim()

# Rows of `canonical` that start with any of `prefixes`, in source order,
# joined by "\n" -- compile_source_inventory_facet_rows_from_canonical_v1 for
# one facet. `prefixes` must not be prefixes of one another.
fn compile_source_inventory_whole_text_rows_v1(canonical: text, prefixes: [text]) -> text:
    if canonical == "":
        return ""
    val lined = "\n" + canonical + "\n"
    var marked = lined
    for prefix in prefixes:
        marked = marked.replace("\n" + prefix, "\n\n" + prefix)
    # Canonical text has no blank line, so "\n\n" occurs only at a match.
    if not marked.contains("\n\n"):
        return ""
    val pieces = marked.split("\n\n")
    var rows: [text] = []
    var index = 1
    while index < pieces.len():
        rows.push(pieces[index].split("\n")[0])
        index = index + 1
    rows.join("\n")

# NOTE on hashing cost: `sha256_text` is already
# runtime-native — src/lib/common/crypto/sha256.spl:211 calls the extern
# `rt_tls13_sha256` and only falls back to an interpreted compression loop on
# an invalid-length result. So a per-file "pass a natively-hashed digest in"
# path would not skip interpreted hashing; it would just add a second,
# redundant file read (fs::read via rt_file_hash_sha256, on top of the
# content this function already has in hand) for no compute benefit, and it
# would hash bytes other than the ones canonicalized here. (The Rust-lane
# accelerator itself read its [u8] argument with one registry-checked call per
# byte until 2026-10-04; that cost belonged in the runtime, not here.) That
# path was tried and removed here — see
# doc/08_tracking/bug/windows_scv_inventory_cold_init_untracked_walk_slow_2026-09-13.md
# for what IS still interpreted-only in this file (the comment/whitespace
# canonicalization below) and the measurement this note is based on.
fn compile_source_inventory_event_from_content_v1(
    source: text, operation: text, source_identity: text, content: text
) -> CompileSourceEventV1:
    if operation == "delete":
        return CompileSourceEventV1(
            source, operation, source_identity, "", "", "", "", "", 0)
    var canonical = ""
    var exports = ""
    var initializers = ""
    var providers = ""
    if compile_source_inventory_whole_text_eligible_v1(content):
        canonical = compile_source_inventory_whole_text_canonical_v1(content)
        exports = compile_source_inventory_whole_text_rows_v1(canonical, ["export ", "pub "])
        initializers = compile_source_inventory_whole_text_rows_v1(canonical, ["val ", "var ", "init "])
        providers = compile_source_inventory_whole_text_rows_v1(canonical, ["use ", "impl ", "provider "])
    else:
        # Reference path. Build all views while each normalized line is
        # already available; the public single-facet helpers retain their
        # contract.
        var semantic_rows: [text] = []
        var export_rows: [text] = []
        var initializer_rows: [text] = []
        var provider_rows: [text] = []
        for line in content.split("\n"):
            val trimmed = line.trim()
            if trimmed == "" or trimmed.starts_with("#"):
                continue
            val normalized = split_whitespace(trimmed).join(" ")
            semantic_rows = semantic_rows.push(normalized)
            if normalized.starts_with("export ") or normalized.starts_with("pub "):
                export_rows = export_rows.push(normalized)
            if normalized.starts_with("val ") or normalized.starts_with("var ") or normalized.starts_with("init "):
                initializer_rows = initializer_rows.push(normalized)
            if normalized.starts_with("use ") or normalized.starts_with("impl ") or normalized.starts_with("provider "):
                provider_rows = provider_rows.push(normalized)
        canonical = semantic_rows.join("\n")
        exports = export_rows.join("\n")
        initializers = initializer_rows.join("\n")
        providers = provider_rows.join("\n")
    val content_digest = sha256_text(content)
    val semantic_digest = if canonical == content:
        content_digest
    else:
        sha256_text(canonical)
    # Empty and whole-source facets frequently coincide. Reuse only a digest
    # computed for byte-identical text in this event; no cross-source cache or
    # membership/publication authority is introduced.
    val export_digest = if exports == canonical:
        semantic_digest
    else:
        sha256_text(exports)
    val initializer_digest = if initializers == canonical:
        semantic_digest
    elif initializers == exports:
        export_digest
    else:
        sha256_text(initializers)
    val provider_digest = if providers == canonical:
        semantic_digest
    elif providers == exports:
        export_digest
    elif providers == initializers:
        initializer_digest
    else:
        sha256_text(providers)
    CompileSourceEventV1(
        source, operation, source_identity, content_digest, semantic_digest,
        export_digest, initializer_digest, provider_digest, content.len())

fn compile_source_inventory_git_event_v1(
    operation: text, source_identity: text, content: text
) -> CompileSourceEventV1:
    compile_source_inventory_event_from_content_v1(
        "git", operation, source_identity, content)

fn compile_source_inventory_filesystem_event_v1(
    operation: text, source_identity: text, content: text
) -> CompileSourceEventV1:
    compile_source_inventory_event_from_content_v1(
        "filesystem", operation, source_identity, content)

fn compile_source_inventory_event_path_v1(root: text, path: text) -> text:
    val normalized_root = root.replace("\\", "/")
    val normalized_path = path.replace("\\", "/")
    if normalized_path.starts_with(normalized_root + "/"):
        return normalized_path.substring(normalized_root.len() + 1)
    normalized_path

fn compile_source_inventory_text_valid_v1(value: text) -> bool:
    value != "" and not value.contains("\n") and not value.contains("\r") and
        not value.contains("|")

fn compile_source_inventory_digest_valid_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    var index = 0
    while index < 64:
        val ch = value.byte_at(index) as i64
        if not ((ch >= 48 and ch <= 57) or (ch >= 97 and ch <= 102)):
            return false
        index = index + 1
    true

fn compile_source_inventory_path_valid_v1(value: text) -> bool:
    compile_source_inventory_text_valid_v1(value) and
        not value.starts_with("/") and not value.contains("\\") and
        not value.contains("//") and not value.split("/").contains("..") and
        (value.ends_with(".spl") or value == "simple.sdn" or
            value.ends_with("/simple.sdn"))

fn compile_source_inventory_cache_root_valid_v1(cache_root: text) -> bool:
    cache_root == "build/scv" or cache_root == ".simple/scv" or
        cache_root.ends_with("/build/scv") or
        cache_root.ends_with("/.simple/scv")

# Pure routing for checkout-owned inventory. Machine cache configuration is a
# separate contract: SIMPLE_CACHE never relocates an admitted SCV snapshot.
fn compile_source_inventory_plain_checkout_v1(path: text) -> text:
    var plain = path
    # A backslash remains a legal POSIX filename byte. Convert only paths
    # that explicitly carry Windows drive/UNC syntax.
    if path.starts_with("\\\\") or (path.len() >= 2 and path.substring(1, 2) == ":"):
        plain = path.replace("\\", "/")
    if plain.starts_with("//?/UNC/"):
        plain = "//" + plain.substring(8)
    elif plain.starts_with("//?/"):
        plain = plain.substring(4)
    if plain == "": return ""
    if not plain.starts_with("/") and not (plain.len() >= 3 and plain.substring(1, 3) == ":/"):
        return ""
    for component in plain.split("/"):
        if component == "." or component == "..": return ""
    while plain.len() > 1 and plain.ends_with("/"):
        plain = plain.substring(0, plain.len() - 1)
    plain

fn compile_source_inventory_checkout_cache_root_v1(checkout_root: text) -> text:
    val root = compile_source_inventory_plain_checkout_v1(checkout_root)
    if root == "": return ""
    if root == "/": return "/build/scv"
    root + "/build/scv"

fn compile_source_inventory_snapshot_cache_root_v1(
    checkout_root: text, snapshot_root: text, revision_id: text
) -> text:
    val root = compile_source_inventory_plain_checkout_v1(checkout_root)
    val snapshot = compile_source_inventory_plain_checkout_v1(snapshot_root)
    if root == "" or snapshot == "" or not revision_id.starts_with("scv-revision-v1-"):
        return ""
    if not compile_source_inventory_digest_valid_v1(revision_id.substring(16)):
        return ""
    val prefix = if root == "/": "" else: root
    val normal = prefix + "/build/scv"
    val legacy = prefix + "/.simple/scv"
    if snapshot == normal + "/snapshots/" + revision_id: return normal
    if snapshot == legacy + "/snapshots/" + revision_id: return legacy
    ""

# These digests have different encodings. The snapshot hashes selected
# path/content/size rows; the source inventory hashes its canonical schema,
# generation and semantic fields. Never compare one domain with the other.
struct CompileSourceInventoryBindingV1:
    snapshot_manifest_digest: text
    source_inventory_digest: text

fn compile_source_inventory_binding_reason_v1(
    binding: CompileSourceInventoryBindingV1, actual_source_inventory_digest: text
) -> text:
    if not compile_source_inventory_digest_valid_v1(binding.snapshot_manifest_digest):
        return "snapshot-manifest-digest-invalid"
    if not compile_source_inventory_digest_valid_v1(binding.source_inventory_digest):
        return "source-inventory-digest-invalid"
    if binding.source_inventory_digest != actual_source_inventory_digest:
        return "source-inventory-digest-mismatch"
    "ok"

export CompileSourceInventoryBindingV1, compile_source_inventory_binding_reason_v1
export compile_source_inventory_plain_checkout_v1

# Byte-wise identity order (-1/0/1). Not text `<`/`>=`: native bootstrap text
# relational operators compare tagged addresses, so the heap sort produced an
# allocation-order inventory that failed its own canonical re-encode check
# (inventory-noncanonical on every Windows stage-2 cold init, 2026-09-25).
fn compile_source_inventory_identity_cmp_v1(left: text, right: text) -> i64:
    val shared = if left.len() < right.len(): left.len() else: right.len()
    var index = 0
    while index < shared:
        val a = left.byte_at(index) as i64
        val b = right.byte_at(index) as i64
        if a != b:
            return if a < b: -1 else: 1
        index = index + 1
    if left.len() == right.len(): 0 elif left.len() < right.len(): -1 else: 1

fn compile_source_inventory_sort_v1(
    values: [CompileSourceInventoryEntryV1]
) -> [CompileSourceInventoryEntryV1]:
    var sorted = values
    # Published and warm inventories are already ordered. Preserve their
    # linear validation cost instead of heap-sorting them again.
    var ordered = 1
    while ordered < sorted.len() and compile_source_inventory_identity_cmp_v1(sorted[ordered - 1].source_identity, sorted[ordered].source_identity) <= 0:
        ordered = ordered + 1
    if ordered >= sorted.len():
        return sorted
    # Build a max heap, then move its maximum to the sorted suffix. Cold Git
    # listings may place untracked paths before cached paths, so insertion
    # sort is quadratic even when each individual listing is ordered.
    var start = sorted.len() / 2 - 1
    var end = sorted.len() - 1
    while end > 0:
        var root = 0
        if start >= 0:
            root = start
            start = start - 1
        else:
            val maximum = sorted[0]
            sorted[0] = sorted[end]
            sorted[end] = maximum
            end = end - 1
        while root * 2 + 1 <= end:
            var child = root * 2 + 1
            if child < end and compile_source_inventory_identity_cmp_v1(sorted[child].source_identity, sorted[child + 1].source_identity) < 0:
                child = child + 1
            if compile_source_inventory_identity_cmp_v1(sorted[root].source_identity, sorted[child].source_identity) >= 0:
                break
            val parent = sorted[root]
            sorted[root] = sorted[child]
            sorted[child] = parent
            root = child
    sorted

# Empty-inventory cold initialization is a set of unique creates. Validate
# it once, append once, and sort once. Anything else retains sequential event
# semantics through the existing apply path, including duplicate no-ops,
# replacements, invalid operations, and generation increments.
fn compile_source_inventory_initial_events_v1(
    events: [CompileSourceEventV1]
) -> CompileSourceInventoryV1?:
    var entries: [CompileSourceInventoryEntryV1] = []
    var seen: {text: bool} = {}
    for event in events:
        if (event.operation != "create" or
                not (event.source == "git" or event.source == "filesystem") or
                seen.contains_key(event.source_identity)):
            return nil
        val entry = CompileSourceInventoryEntryV1(
            event.source_identity, event.content_digest, event.semantic_digest,
            event.export_digest, event.initializer_digest, event.provider_digest,
            event.byte_count)
        if not compile_source_inventory_entry_valid_v1(entry):
            return nil
        seen[event.source_identity] = true
        entries = entries.push(entry)
    Some(CompileSourceInventoryV1(1, events.len(), compile_source_inventory_sort_v1(entries)))

fn compile_source_inventory_entry_valid_v1(
    entry: CompileSourceInventoryEntryV1
) -> bool:
    compile_source_inventory_path_valid_v1(entry.source_identity) and
        compile_source_inventory_digest_valid_v1(entry.content_digest) and
        compile_source_inventory_digest_valid_v1(entry.semantic_digest) and
        compile_source_inventory_digest_valid_v1(entry.export_digest) and
        compile_source_inventory_digest_valid_v1(entry.initializer_digest) and
        compile_source_inventory_digest_valid_v1(entry.provider_digest) and
        entry.byte_count >= 0

fn compile_source_inventory_encode_v1(inventory: CompileSourceInventoryV1) -> text:
    if inventory.schema_version != COMPILE_SOURCE_INVENTORY_SCHEMA_V1 or
            inventory.generation < 0:
        return ""
    val entries = compile_source_inventory_sort_v1(inventory.entries)
    var rows = [
        "simple-compile-source-inventory-v1",
        "generation={inventory.generation}",
        "count={entries.len()}"
    ]
    var previous = ""
    for entry in entries:
        if (not compile_source_inventory_entry_valid_v1(entry) or
                entry.source_identity == previous):
            return ""
        previous = entry.source_identity
        rows = rows.push([
            entry.source_identity, entry.content_digest, entry.semantic_digest,
            entry.export_digest, entry.initializer_digest,
            entry.provider_digest, entry.byte_count.to_text()
        ].join("|"))
    rows.join("\n")

fn compile_source_inventory_digest_v1(inventory: CompileSourceInventoryV1) -> text:
    val encoded = compile_source_inventory_encode_v1(inventory)
    if encoded == "": "" else: sha256_text(encoded)

fn compile_source_inventory_find_v1(
    entries: [CompileSourceInventoryEntryV1], source_identity: text
) -> i64:
    var index = 0
    while index < entries.len():
        if entries[index].source_identity == source_identity:
            return index
        index = index + 1
    -1

fn compile_source_inventory_apply_event_v1(
    inventory: CompileSourceInventoryV1, event: CompileSourceEventV1
) -> CompileSourceInventoryChangeV1:
    if (inventory.schema_version != COMPILE_SOURCE_INVENTORY_SCHEMA_V1 or
            inventory.generation < 0 or
            not (event.source == "git" or event.source == "filesystem") or
            not compile_source_inventory_path_valid_v1(event.source_identity)):
        return CompileSourceInventoryChangeV1(false, "event-invalid", nil, false, false)
    var entries = compile_source_inventory_sort_v1(inventory.entries)
    val found = compile_source_inventory_find_v1(entries, event.source_identity)
    if event.operation == "delete":
        if found < 0:
            return CompileSourceInventoryChangeV1(true, "ok-no-change", Some(inventory), false, false)
        val old = entries[found]
        var survivors: [CompileSourceInventoryEntryV1] = []
        var index = 0
        while index < entries.len():
            if index != found:
                survivors.push(entries[index])
            index = index + 1
        entries = survivors
        val next = CompileSourceInventoryV1(1, inventory.generation + 1, entries)
        return CompileSourceInventoryChangeV1(true, "ok", Some(next), true,
            old.semantic_digest != "" or old.export_digest != "" or
            old.initializer_digest != "" or old.provider_digest != "")
    if not (event.operation == "create" or event.operation == "modify"):
        return CompileSourceInventoryChangeV1(false, "event-operation-invalid", nil, false, false)
    val next_entry = CompileSourceInventoryEntryV1(
        event.source_identity, event.content_digest, event.semantic_digest,
        event.export_digest, event.initializer_digest, event.provider_digest,
        event.byte_count)
    if not compile_source_inventory_entry_valid_v1(next_entry):
        return CompileSourceInventoryChangeV1(false, "event-entry-invalid", nil, false, false)
    var content_changed = true
    var semantics_changed = true
    if found >= 0:
        val old = entries[found]
        content_changed = old.content_digest != next_entry.content_digest or
            old.byte_count != next_entry.byte_count
        semantics_changed = old.semantic_digest != next_entry.semantic_digest or
            old.export_digest != next_entry.export_digest or
            old.initializer_digest != next_entry.initializer_digest or
            old.provider_digest != next_entry.provider_digest
        if not content_changed and not semantics_changed:
            return CompileSourceInventoryChangeV1(true, "ok-no-change", Some(inventory), false, false)
        entries[found] = next_entry
    else:
        entries = entries.push(next_entry)
    val next = CompileSourceInventoryV1(
        1, inventory.generation + 1, compile_source_inventory_sort_v1(entries))
    CompileSourceInventoryChangeV1(true, "ok", Some(next), content_changed, semantics_changed)


export COMPILE_SOURCE_INVENTORY_SCHEMA_V1
export COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1
export CompileSourceInventoryEntryV1
export CompileSourceEventV1
export CompileSourceGitChangeV1
export CompileSourceInventoryV1
export CompileSourceInventoryReadV1
export CompileSourceInventoryChangeV1
export compile_source_inventory_strip_comments_v1, compile_source_inventory_identity_cmp_v1
export compile_source_inventory_facet_rows_from_canonical_v1
export compile_source_inventory_facet_text_v1
export compile_source_inventory_whole_text_eligible_v1
export compile_source_inventory_whole_text_canonical_v1
export compile_source_inventory_whole_text_rows_v1
export compile_source_inventory_event_from_content_v1
export compile_source_inventory_git_event_v1
export compile_source_inventory_filesystem_event_v1
export compile_source_inventory_event_path_v1
export compile_source_inventory_text_valid_v1
export compile_source_inventory_digest_valid_v1
export compile_source_inventory_path_valid_v1
export compile_source_inventory_cache_root_valid_v1
export compile_source_inventory_checkout_cache_root_v1
export compile_source_inventory_snapshot_cache_root_v1
export compile_source_inventory_sort_v1
export compile_source_inventory_initial_events_v1
export compile_source_inventory_entry_valid_v1
export compile_source_inventory_encode_v1
export compile_source_inventory_digest_v1
export compile_source_inventory_find_v1
export compile_source_inventory_apply_event_v1
