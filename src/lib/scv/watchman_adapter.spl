# SCV Watchman adapter behind the EventSource protocol (SCV-IMPL-E-08).
#
# Speaks the ScvEventCursor/ScvEventPull contract from event_source.spl with
# source "watchman": the watchman CLOCKSPEC is the opaque token, file
# notifications SETTLE on a logical clock (now_ms is always passed in — no
# sleeping), and both `is_fresh_instance: true` responses and recrawl
# warnings force the mandatory invalidate/reconcile path: events are refused
# (needs_rescan=true) until scv_watchman_reconcile runs. Watchers are hints;
# reconcile is the only authority.
#
# Transport: this module consumes WatchmanMsg values from an in-adapter
# inbox fed by scv_watchman_inject — a deterministic fake-watchman transport
# used by the specs. TODO(SCV-IMPL-E-08): wire a live `watchman -j` UDS/CLI
# transport that decodes real subscription JSON into WatchmanMsg; no
# watchman binary is installed on this host, so real-binary integration is
# unverified and must never be claimed until that lands.

use std.nogc_async_mut.file_system.event_watch.{FsWatchEvent}
use std.scv.event_source.{ScvEventCursor, ScvEventPull}

struct WatchmanMsg:
    kind: text            # "subscribe_ack" | "files" | "recrawl"
    clock: text           # watchman clockspec carried by the response
    fresh: bool           # watchman's is_fresh_instance flag
    events: [FsWatchEvent]

struct WatchmanPendingEvent:
    ev: FsWatchEvent
    clock: text
    due_ms: i64           # logical release time (recv_ms + settle_ms)

struct WatchmanAdapter:
    root: text
    settle_ms: i64
    clockspec: text       # latest clock observed from the transport
    invalidated: bool     # fresh-instance or recrawl seen; reconcile required
    inbox: [WatchmanMsg]  # fake/live transport delivery queue
    inbox_ms: [i64]       # logical receive time of each inbox entry
    pending: [WatchmanPendingEvent]

fn scv_watchman_open(root: text, settle_ms: i64) -> (WatchmanAdapter, ScvEventCursor):
    val a = WatchmanAdapter(root: root, settle_ms: settle_ms, clockspec: "",
                            invalidated: false, inbox: [], inbox_ms: [], pending: [])
    (a, ScvEventCursor(source: "watchman", opaque_token: "", fresh_instance: true, overflowed: false))

# Transport delivery (deterministic): a message arrives at logical time recv_ms.
fn scv_watchman_inject(a: WatchmanAdapter, msg: WatchmanMsg, recv_ms: i64) -> WatchmanAdapter:
    var next = a
    next.inbox.push(msg)
    next.inbox_ms.push(recv_ms)
    next

# Drain the inbox into adapter state: track the clockspec, stage file events
# with their settle deadline, and latch invalidation on fresh/recrawl.
fn _scv_watchman_drain(a: WatchmanAdapter) -> WatchmanAdapter:
    var next = a
    var i = 0
    while i < next.inbox.len():
        val msg = next.inbox[i]
        val recv_ms = next.inbox_ms[i]
        if msg.clock != "":
            next.clockspec = msg.clock
        if msg.kind == "recrawl" or (msg.kind == "files" and msg.fresh):
            next.invalidated = true
        elif msg.kind == "files":
            for ev in msg.events:
                next.pending.push(WatchmanPendingEvent(ev: ev, clock: msg.clock,
                                                       due_ms: recv_ms + next.settle_ms))
        i = i + 1
    next.inbox = []
    next.inbox_ms = []
    next

# Pull settled events. Fresh or overflowed cursors are REFUSED events until
# reconcile runs; an invalidation observed in the stream marks the returned
# cursor overflowed and refuses events the same way.
fn scv_watchman_pull(a: WatchmanAdapter, cursor: ScvEventCursor, now_ms: i64) -> (WatchmanAdapter, ScvEventPull):
    if cursor.fresh_instance or cursor.overflowed:
        return (a, ScvEventPull(events: [], cursor: cursor, needs_rescan: true))
    var next = _scv_watchman_drain(a)
    if next.invalidated:
        val marked = ScvEventCursor(source: cursor.source, opaque_token: next.clockspec,
                                    fresh_instance: false, overflowed: true)
        return (next, ScvEventPull(events: [], cursor: marked, needs_rescan: true))
    var out: [FsWatchEvent] = []
    var keep: [WatchmanPendingEvent] = []
    var token = cursor.opaque_token
    for p in next.pending:
        if p.due_ms <= now_ms:
            out.push(p.ev)
            if p.clock != "":
                token = p.clock
        else:
            keep.push(p)
    next.pending = keep
    val advanced = ScvEventCursor(source: cursor.source, opaque_token: token,
                                  fresh_instance: false, overflowed: false)
    (next, ScvEventPull(events: out, cursor: advanced, needs_rescan: false))

# Mandatory invalidate/reconcile path: the caller resnapshots authoritatively
# (scv rescan/identity pass); here we clear the invalidation, drop staged
# events made stale by it, and resume from the latest clockspec.
fn scv_watchman_reconcile(a: WatchmanAdapter, cursor: ScvEventCursor) -> (WatchmanAdapter, ScvEventCursor):
    var next = _scv_watchman_drain(a)
    if next.invalidated:
        # Staged events predate the invalidation; the authoritative rescan
        # supersedes them. Events staged without an invalidation stay valid.
        next.pending = []
    next.invalidated = false
    (next, ScvEventCursor(source: "watchman", opaque_token: next.clockspec,
                          fresh_instance: false, overflowed: false))
