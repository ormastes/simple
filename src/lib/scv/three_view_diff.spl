# SCV-IMPL-D-02 — three-view diff: ONE comparison rendered as
# `--view raw|syntax|entity|semantic|all`, plus `--git-patch` — an
# always-applicable Git patch export (whole-file hunks, so it applies
# regardless of context drift).
# D-03 adds `--view graph`: the refactoring-aware edit graph (edit_graph.spl)
# over the SAME comparison; `all` keeps its four D-02 sections.

use app.io.mod (file_exists, file_read)
use std.scv.core.{scv_status_index_path, scv_chunk_path}
use std.scv.working_copy.{scv_line_for_path, scv_line_chunk}
use std.scv.diff.{scv_diff}
use std.scv.identity.{scv_identity_lookup_by_path}
use std.scv.edit_graph.{scv_edit_graph}

fn scv_view_valid(view: text) -> bool:
    view == "raw" or view == "syntax" or view == "entity" or view == "semantic" or view == "all" or view == "graph"

# Entity view: raw-diff rows relabelled by persistent FileEntityId so a
# rename shows as the SAME entity changing path, not delete+add.
fn scv_entity_view(root: text) -> text:
    val raw = scv_diff(root, "--raw")
    if raw == "no changes\n":
        return raw
    var out = ""
    for line in raw.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split(" ")
        if parts.len() >= 4 and parts[0] == "renamed":
            # "renamed old -> new"
            val id = scv_identity_lookup_by_path(root, parts[3])
            val label = if id != "": id else: "unassigned"
            out = out + "entity {label} renamed {parts[1]} -> {parts[3]}\n"
        elif parts.len() >= 2:
            val id = scv_identity_lookup_by_path(root, parts[1])
            val label = if id != "": id else: "unassigned"
            out = out + "entity {label} {parts[0]} {parts[1]}\n"
        else:
            out = out + trimmed + "\n"
    if out == "":
        "no changes\n"
    else:
        out

fn scv_patch_lines(prefix: text, content: text) -> (text, i64):
    # Body lines with `prefix`; trailing empty segment after a final newline
    # is not a line.
    var rows = content.split("\n")
    var count = rows.len()
    if count > 0 and rows[count - 1] == "":
        count = count - 1
    var out = ""
    var i = 0
    while i < count:
        out = out + prefix + rows[i] + "\n"
        i = i + 1
    (out, count)

fn scv_patch_one(path: text, old_text: text, new_text: text, kind: text) -> text:
    val (old_body, old_n) = scv_patch_lines("-", old_text)
    val (new_body, new_n) = scv_patch_lines("+", new_text)
    var out = "diff --git a/{path} b/{path}\n"
    if kind == "added":
        out = out + "new file mode 100644\n--- /dev/null\n+++ b/{path}\n"
        out = out + "@@ -0,0 +1,{new_n} @@\n" + new_body
    elif kind == "deleted":
        out = out + "deleted file mode 100644\n--- a/{path}\n+++ /dev/null\n"
        out = out + "@@ -1,{old_n} +0,0 @@\n" + old_body
    else:
        out = out + "--- a/{path}\n+++ b/{path}\n"
        out = out + "@@ -1,{old_n} +1,{new_n} @@\n" + old_body + new_body
    out

# Always-applicable Git patch: one whole-file hunk per changed file derived
# from the SAME comparison (status index vs working copy) as the views.
fn scv_git_patch(root: text) -> text:
    val raw = scv_diff(root, "--raw")
    if raw == "no changes\n":
        return ""
    val index = if file_exists(scv_status_index_path(root)): file_read(scv_status_index_path(root)) else: ""
    var out = ""
    for line in raw.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split(" ")
        if parts.len() < 2:
            continue
        val kind = parts[0]
        if kind == "modified":
            val rel = parts[1]
            val old_chunk = scv_line_chunk(scv_line_for_path(index, rel))
            val old_file = scv_chunk_path(root, old_chunk)
            val old_text = if file_exists(old_file): file_read(old_file) else: ""
            out = out + scv_patch_one(rel, old_text, file_read("{root}/{rel}"), "modified")
        elif kind == "added":
            val rel = parts[1]
            out = out + scv_patch_one(rel, "", file_read("{root}/{rel}"), "added")
        elif kind == "deleted":
            val rel = parts[1]
            val old_chunk = scv_line_chunk(scv_line_for_path(index, rel))
            val old_file = scv_chunk_path(root, old_chunk)
            val old_text = if file_exists(old_file): file_read(old_file) else: ""
            out = out + scv_patch_one(rel, old_text, "", "deleted")
        elif kind == "renamed" and parts.len() >= 4:
            # rename = delete old + add new, always applicable
            val old_chunk = scv_line_chunk(scv_line_for_path(index, parts[1]))
            val old_file = scv_chunk_path(root, old_chunk)
            val old_text = if file_exists(old_file): file_read(old_file) else: ""
            out = out + scv_patch_one(parts[1], old_text, "", "deleted")
            val new_rel = parts[3]
            out = out + scv_patch_one(new_rel, "", file_read("{root}/{new_rel}"), "added")
    out

fn scv_view_section(root: text, view: text) -> text:
    if view == "raw":
        "view=raw\n" + scv_diff(root, "--raw")
    elif view == "syntax":
        "view=syntax\n" + scv_diff(root, "--structural")
    elif view == "entity":
        "view=entity\n" + scv_entity_view(root)
    elif view == "graph":
        "view=graph\n" + scv_edit_graph(root)
    else:
        "view=semantic\n" + scv_diff(root, "--ignore-formatting")

# Entry point: `scv diff --view <v> [--git-patch]`.
fn scv_diff_views(root: text, view: text, git_patch: bool) -> text:
    if not scv_view_valid(view):
        return "ERROR diff --view must be raw|syntax|entity|semantic|all|graph, got: {view}\n"
    var out = ""
    if view == "all":
        out = out + scv_view_section(root, "raw")
        out = out + scv_view_section(root, "syntax")
        out = out + scv_view_section(root, "entity")
        out = out + scv_view_section(root, "semantic")
    else:
        out = out + scv_view_section(root, view)
    if git_patch:
        val patch = scv_git_patch(root)
        out = out + "git-patch\n"
        if patch == "":
            out = out + "(empty)\n"
        else:
            out = out + patch
    out

export scv_diff_views, scv_git_patch, scv_entity_view
