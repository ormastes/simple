# SCV three-way tree merge with conflicts as data.

use app.io.mod (file_exists, file_read, file_delete, file_size, dir_walk)
use std.nogc_sync_mut.io.time_ops.{current_time_ms}
use std.scv.core.{scv_object_path, scv_chunk_path, scv_state_private, scv_line_set_contains, scv_worktree_path_safe}
use std.scv.store.{scv_hash_text, scv_write_text, scv_write_chunk_from_file, scv_write_tree_object, scv_write_commit, scv_write_operation, scv_current_op, scv_commit_tree}
use std.scv.identity_merge.{scv_identity_merge_groups}
use std.scv.structural_match.{scv_default_match_config, scv_compute_edit_script, scv_parser_index_root_node, scv_text_block_names, scv_structural_merge_from_text}
use std.scv.region_merge.{scv_region_merge_text}
use std.scv.merge_validation.{scv_merge_validation_accept}
use std.scv.conflict_v2.{scv_conflict_v2_payload, scv_conflict_v2_write, scv_conflict_v2_classify}
use std.scv.preprocessor_regions.{scv_pp_divergence, scv_pp_guard_rewritten, scv_pp_has_construct}

# ---------------------------------------------------------------------------
# Preprocessor-region conflict detection.
#
# Fixes the missed-real-conflict class recorded in
# `doc/08_tracking/bug/scv_merge_silently_merges_across_divergent_preprocessor_branches_2026-08-26.md`:
# the syntax-node and line rungs below compute disjointness over raw line
# indices, so a `#ifdef` line and the statements it governs look independent.
# Corpus case 22 was merged CLEAN into `int mode = 7;` under `#ifdef FEATURE_B`
# — a configuration neither side authored. See preprocessor_regions.spl for the
# region model and its honest lexical-only ceiling.
#
# Scope: `.spl` is excluded outright — Simple has no preprocessor and uses `#`
# as its comment character, so running the detector there could only ever
# manufacture spurious conflicts.
# ---------------------------------------------------------------------------

fn scv_pp_applicable_path(rel: text) -> bool:
    not rel.ends_with(".spl")

# The chunk text behind a tree line, or "" when unreadable/binary.
fn scv_read_line_text(root: text, line: text) -> text:
    if line == "":
        return ""
    val path = scv_chunk_path(root, scv_tree_line_chunk_id(line))
    if not file_exists(path):
        return ""
    val t = file_read(path)
    if t.contains("\u0000"):
        return ""
    t

# Diagnostic when the two sides' edits are preprocessor-divergent, else "".
fn scv_pp_merge_divergence(root: text, rel: text, base_line: text, left_line: text, right_line: text) -> text:
    if not scv_pp_applicable_path(rel):
        return ""
    val b = scv_read_line_text(root, base_line)
    val l = scv_read_line_text(root, left_line)
    val r = scv_read_line_text(root, right_line)
    if b == "" or l == "" or r == "":
        return ""
    scv_pp_divergence(b, l, r)

# Rename companion: one side renamed the file, the other rewrote its guard
# conditions. Carrying the edit onto the new path would silently change which
# build configuration compiles it. A body-only edit is NOT flagged — that is
# ordinary rename+edit, which corpus cases 07/12 pin as clean.
fn scv_pp_rename_guard_divergence(root: text, rel: text, base_line: text, edited_line: text) -> text:
    if not scv_pp_applicable_path(rel):
        return ""
    val b = scv_read_line_text(root, base_line)
    val s = scv_read_line_text(root, edited_line)
    if b == "" or s == "":
        return ""
    if not scv_pp_has_construct(b):
        return ""
    if not scv_pp_guard_rewritten(b, s):
        return ""
    "one side renamed the file while the other rewrote its preprocessor guard conditions; carrying the edit onto the new path changes which build configuration compiles it"

fn scv_write_pp_conflict(root: text, rel: text, base_line: text, left_line: text, right_line: text, diagnostics: text, attempted: text) -> text:
    val id = scv_write_conflict_kind(root, rel, "preprocessor_region_divergent", "", base_line, left_line, right_line)
    scv_conflict_v2_write(root, scv_conflict_v2_payload(rel, "preprocessor_region_divergent", "", base_line, left_line, right_line, attempted, diagnostics))
    id

# ---------------------------------------------------------------------------
# Structural merge helpers
# ---------------------------------------------------------------------------

# Returns kind of root syntax node for rel.
# Returns "" when the file has no parser_index entry (not parsed by WS-B path).
# Returns "line" when parsed but only fallback-line nodes found.
fn scv_node_kind_for_rel(root: text, rel: text) -> text:
    val node_id = scv_parser_index_root_node(root, rel)
    if node_id == "":
        return ""
    val path = scv_object_path(root, "syntax", node_id)
    if not file_exists(path):
        return ""
    for line in file_read(path).split("\n"):
        if line.starts_with("kind:"):
            return line[5:].trim()
    ""

# Returns true when WS-B structural merge should be attempted for this file.
# Triggered for: .spl files, files with parser_index entries of any kind.
# Does NOT trigger for .txt, .md, binary, or other non-Simple files.
fn scv_structural_merge_applicable(root: text, rel: text) -> bool:
    if rel.ends_with(".spl"):
        return true
    val node_id = scv_parser_index_root_node(root, rel)
    node_id != ""

# Returns merged file tree-line or "" to fall through.
# When parser index reports only kind==line nodes, returns "" immediately —
# caller must log "structural-fallback-line" and proceed with line merge.
# When WS-A produces structured trees and ops succeed, writes merged file and
# returns a valid tree line with strategy "structural-anchor-merge".
fn scv_try_structural_merge(root: text, rel: text, base_line: text, left_line: text, right_line: text) -> text:
    if base_line == "" or left_line == "" or right_line == "":
        return ""
    val base_chunk = scv_tree_line_chunk_id(base_line)
    val left_chunk = scv_tree_line_chunk_id(left_line)
    val right_chunk = scv_tree_line_chunk_id(right_line)
    val base_path = scv_chunk_path(root, base_chunk)
    val left_path = scv_chunk_path(root, left_chunk)
    val right_path = scv_chunk_path(root, right_chunk)
    if not file_exists(base_path) or not file_exists(left_path) or not file_exists(right_path):
        return ""
    val base_text = file_read(base_path)
    val left_text = file_read(left_path)
    val right_text = file_read(right_path)
    val base_blocks = scv_text_block_names(base_text)
    val left_blocks = scv_text_block_names(left_text)
    val right_blocks = scv_text_block_names(right_text)
    if base_blocks.len() == 0 and left_blocks.len() == 0 and right_blocks.len() == 0:
        return ""
    val merged = scv_structural_merge_from_text(base_text, left_text, right_text)
    if merged == "":
        return ""
    # SCV-IMPL-D-06: aggressive output is validated before acceptance.
    if not scv_merge_validation_accept(merged):
        return ""
    scv_write_merged_line_file(root, rel, merged)

# ---------------------------------------------------------------------------

fn scv_tree_content(root: text, commit: text) -> text:
    val tree = scv_commit_tree(root, commit)
    if tree == "":
        return ""
    val path = scv_object_path(root, "trees", tree)
    if file_exists(path):
        file_read(path)
    else:
        ""

fn scv_tree_line_for_path(tree_content: text, rel: text) -> text:
    for line in tree_content.split("\n"):
        if line.starts_with("{rel}|"):
            return line
    ""

fn scv_tree_line_path(line: text) -> text:
    val parts = line.split("|")
    if parts.len() > 0:
        parts[0]
    else:
        ""

fn scv_tree_line_chunk_id(line: text) -> text:
    val parts = line.split("|")
    if parts.len() >= 3:
        parts[2]
    else:
        ""

fn scv_tree_line_size(line: text) -> text:
    val parts = line.split("|")
    if parts.len() >= 4:
        parts[3]
    else:
        "0"

fn scv_tree_line_with_path(line: text, rel: text) -> text:
    val parts = line.split("|")
    if parts.len() >= 5:
        "{rel}|{parts[1]}|{parts[2]}|{parts[3]}|{parts[4]}"
    else:
        line

fn scv_merge_tree_content_error(tree_content: text, label: text) -> text:
    var seen_paths = ""
    for line in tree_content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() != 5:
            return "ERROR bad {label} merge tree entry\n"
        if not scv_worktree_path_safe(parts[0]):
            return "ERROR unsafe {label} merge tree path: {parts[0]}\n"
        if scv_line_set_contains(seen_paths, parts[0]):
            return "ERROR duplicate {label} merge tree path: {parts[0]}\n"
        seen_paths = seen_paths + parts[0] + "\n"
    ""

fn scv_tree_find_new_line_by_chunk(side_tree: text, base_tree: text, chunk: text) -> text:
    if chunk == "":
        return ""
    for line in side_tree.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val rel = scv_tree_line_path(trimmed)
        if scv_tree_line_chunk_id(trimmed) == chunk and scv_tree_line_for_path(base_tree, rel) == "":
            return trimmed
    ""

fn scv_tree_find_old_line_by_chunk(base_tree: text, side_tree: text, chunk: text) -> text:
    if chunk == "":
        return ""
    for line in base_tree.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val rel = scv_tree_line_path(trimmed)
        if scv_tree_line_chunk_id(trimmed) == chunk and scv_tree_line_for_path(side_tree, rel) == "":
            return trimmed
    ""

fn scv_add_paths_from_tree(tree_content: text, paths: text) -> text:
    var out = paths
    for line in tree_content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val rel = scv_tree_line_path(trimmed)
        if rel != "" and not scv_line_set_contains(out, rel):
            out = out + rel + "\n"
    out

# SCV-IMPL-D-07 — v2 typed conflict emission for content conflicts. Reads the
# three sides, classifies signature_conflict vs content_overlap over the
# region parser's view, and records the attempted algorithms. v1 objects stay
# byte-stable; v2 lives in objects/conflicts_v2.
fn scv_write_conflict_v2_content(root: text, rel: text, base_line: text, left_line: text, right_line: text, attempted: text) -> text:
    var kind = "content_overlap"
    val base_path = scv_chunk_path(root, scv_tree_line_chunk_id(base_line))
    val left_path = scv_chunk_path(root, scv_tree_line_chunk_id(left_line))
    val right_path = scv_chunk_path(root, scv_tree_line_chunk_id(right_line))
    if file_exists(base_path) and file_exists(left_path) and file_exists(right_path):
        kind = scv_conflict_v2_classify(file_read(base_path), file_read(left_path), file_read(right_path))
    val payload = scv_conflict_v2_payload(rel, kind, "", base_line, left_line, right_line, attempted, "no non-conflicting merge found by the attempted algorithms")
    scv_conflict_v2_write(root, payload)

# True when `side_tree` carries a path absent from `base_tree` — for the D-07
# entity_identity_ambiguous detection in the identity pre-pass.
fn scv_tree_has_added_path(side_tree: text, base_tree: text) -> bool:
    for line in side_tree.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val rel = scv_tree_line_path(trimmed)
        if rel != "" and scv_tree_line_for_path(base_tree, rel) == "":
            return true
    false

fn scv_write_conflict(root: text, rel: text, base_line: text, left_line: text, right_line: text) -> text:
    val payload = "path: {rel}\nbase: {base_line}\nleft: {left_line}\nright: {right_line}\ntime_ms: {current_time_ms()}\n"
    val id = scv_hash_text("conflict", payload)
    scv_write_text(scv_object_path(root, "conflicts", id), payload)
    id

fn scv_lines_changed_positions(base_text: text, side_text: text) -> text:
    val base_lines = base_text.split("\n")
    val side_lines = side_text.split("\n")
    if base_lines.len() != side_lines.len():
        return "shape-mismatch\n"
    var out = ""
    var i = 0
    while i < base_lines.len():
        if base_lines[i] != side_lines[i]:
            out = out + "{i}\n"
        i = i + 1
    out

fn scv_syntax_line_node_hash(line_no: i64, line: text) -> text:
    val payload = "grammar: fallback-line\nversion: builtin\nkind: line\nfield:\nchildren:\nline: {line_no}\nraw: {scv_hash_text(\"raw\", line)}\nsyntax: {scv_hash_text(\"syntax\", \"line:{line_no}:{line}\")}\nparse_status: ok\n"
    scv_hash_text("syntax_node", payload)

fn scv_syntax_node_changed_positions(base_text: text, side_text: text) -> text:
    val base_lines = base_text.split("\n")
    val side_lines = side_text.split("\n")
    if base_lines.len() != side_lines.len():
        return "shape-mismatch\n"
    var out = ""
    var i = 0
    while i < base_lines.len():
        val line_no = i + 1
        if scv_syntax_line_node_hash(line_no, base_lines[i]) != scv_syntax_line_node_hash(line_no, side_lines[i]):
            out = out + "{i}\n"
        i = i + 1
    out

fn scv_line_changes_overlap(left_changes: text, right_changes: text) -> bool:
    if left_changes == "shape-mismatch\n" or right_changes == "shape-mismatch\n":
        return true
    for line in left_changes.split("\n"):
        val trimmed = line.trim()
        if trimmed != "" and right_changes.contains("{trimmed}\n"):
            return true
    false

fn scv_apply_line_side(base_text: text, side_text: text, side_changes: text) -> text:
    val base_lines = base_text.split("\n")
    val side_lines = side_text.split("\n")
    var out = ""
    var i = 0
    while i < base_lines.len():
        if i > 0:
            out = out + "\n"
        if side_changes.contains("{i}\n"):
            out = out + side_lines[i]
        else:
            out = out + base_lines[i]
        i = i + 1
    out

fn scv_write_merged_line_file(root: text, rel: text, content: text) -> text:
    if not scv_worktree_path_safe(rel):
        return ""
    # The chunk id MUST be the sha256 of the bytes on disk (export-tree and
    # fsck recompute it from the file), so the merged text is staged to a file
    # and chunked exactly like a snapshot does (one digest path, no drift).
    val staged = "{root}/.scv/merge_stage_{current_time_ms()}_{scv_hash_text(\"stage\", content)}"
    scv_write_text(staged, content)
    val chunk = scv_write_chunk_from_file(root, staged)
    val size = file_size(staged)
    file_delete(staged)
    val payload = "path: {rel}\nchunk: {chunk}\nsize: {size}\nmtime: 0\n"
    val file_id = scv_hash_text("file", payload)
    scv_write_text(scv_object_path(root, "files", file_id), payload)
    "{rel}|{file_id}|{chunk}|{size}|0"
fn scv_try_syntax_node_merge(root: text, rel: text, base_line: text, left_line: text, right_line: text) -> text:
    if base_line == "" or left_line == "" or right_line == "":
        return ""
    val base_chunk = scv_tree_line_chunk_id(base_line)
    val left_chunk = scv_tree_line_chunk_id(left_line)
    val right_chunk = scv_tree_line_chunk_id(right_line)
    val base_path = scv_chunk_path(root, base_chunk)
    val left_path = scv_chunk_path(root, left_chunk)
    val right_path = scv_chunk_path(root, right_chunk)
    if not file_exists(base_path) or not file_exists(left_path) or not file_exists(right_path):
        return ""
    val base_text = file_read(base_path)
    val left_text = file_read(left_path)
    val right_text = file_read(right_path)
    if base_text.contains("\u0000") or left_text.contains("\u0000") or right_text.contains("\u0000"):
        return ""
    val left_changes = scv_syntax_node_changed_positions(base_text, left_text)
    val right_changes = scv_syntax_node_changed_positions(base_text, right_text)
    if scv_line_changes_overlap(left_changes, right_changes):
        return ""
    val left_applied = scv_apply_line_side(base_text, left_text, left_changes)
    val merged_text = scv_apply_line_side(left_applied, right_text, right_changes)
    scv_write_merged_line_file(root, rel, merged_text)

# SCV-IMPL-D-05 — semistructured region merge, attempted only where every
# earlier rung failed and a conflict would otherwise be written. Its output is
# validated by the D-06 ladder's always-available rungs before acceptance.
fn scv_try_region_merge(root: text, rel: text, base_line: text, left_line: text, right_line: text) -> text:
    if base_line == "" or left_line == "" or right_line == "":
        return ""
    val base_path = scv_chunk_path(root, scv_tree_line_chunk_id(base_line))
    val left_path = scv_chunk_path(root, scv_tree_line_chunk_id(left_line))
    val right_path = scv_chunk_path(root, scv_tree_line_chunk_id(right_line))
    if not file_exists(base_path) or not file_exists(left_path) or not file_exists(right_path):
        return ""
    val base_text = file_read(base_path)
    val left_text = file_read(left_path)
    val right_text = file_read(right_path)
    if base_text.contains("\u0000") or left_text.contains("\u0000") or right_text.contains("\u0000"):
        return ""
    val merged = scv_region_merge_text(base_text, left_text, right_text)
    if merged == "":
        return ""
    if not scv_merge_validation_accept(merged):
        return ""
    scv_write_merged_line_file(root, rel, merged)

fn scv_try_line_merge(root: text, rel: text, base_line: text, left_line: text, right_line: text) -> text:
    if base_line == "" or left_line == "" or right_line == "":
        return ""
    val base_chunk = scv_tree_line_chunk_id(base_line)
    val left_chunk = scv_tree_line_chunk_id(left_line)
    val right_chunk = scv_tree_line_chunk_id(right_line)
    val base_path = scv_chunk_path(root, base_chunk)
    val left_path = scv_chunk_path(root, left_chunk)
    val right_path = scv_chunk_path(root, right_chunk)
    if not file_exists(base_path) or not file_exists(left_path) or not file_exists(right_path):
        return ""
    val base_text = file_read(base_path)
    val left_text = file_read(left_path)
    val right_text = file_read(right_path)
    if base_text.contains("\u0000") or left_text.contains("\u0000") or right_text.contains("\u0000"):
        return ""
    val left_changes = scv_lines_changed_positions(base_text, left_text)
    val right_changes = scv_lines_changed_positions(base_text, right_text)
    if scv_line_changes_overlap(left_changes, right_changes):
        return ""
    val left_applied = scv_apply_line_side(base_text, left_text, left_changes)
    val merged_text = scv_apply_line_side(left_applied, right_text, right_changes)
    scv_write_merged_line_file(root, rel, merged_text)

fn scv_pick_merge_line(root: text, rel: text, base_tree: text, left_tree: text, right_tree: text, base_line: text, left_line: text, right_line: text) -> (text, text, text):
    val base_chunk = scv_tree_line_chunk_id(base_line)
    val left_chunk = scv_tree_line_chunk_id(left_line)
    val right_chunk = scv_tree_line_chunk_id(right_line)
    if base_line != "" and left_line == "" and right_line != "":
        val moved_left = scv_tree_find_new_line_by_chunk(left_tree, base_tree, base_chunk)
        if moved_left != "" and right_chunk != base_chunk:
            return ("", "", "left-rename-source")
    if base_line != "" and right_line == "" and left_line != "":
        val moved_right = scv_tree_find_new_line_by_chunk(right_tree, base_tree, base_chunk)
        if moved_right != "" and left_chunk != base_chunk:
            return ("", "", "right-rename-source")
    if base_line == "" and left_line != "" and right_line == "":
        val old_left = scv_tree_find_old_line_by_chunk(base_tree, left_tree, left_chunk)
        val old_right_line = scv_tree_line_for_path(right_tree, scv_tree_line_path(old_left))
        if old_left != "" and old_right_line != "" and scv_tree_line_chunk_id(old_right_line) != left_chunk:
            val carried_r = scv_tree_line_with_path(old_right_line, rel)
            val rdiag = scv_pp_rename_guard_divergence(root, rel, old_left, carried_r)
            if rdiag != "":
                val rid = scv_write_pp_conflict(root, rel, old_left, left_line, carried_r, rdiag, "path-rename")
                return (carried_r, rid, "preprocessor-rename-guard-conflict")
            return (carried_r, "", "left-rename-right-edit")
    if base_line == "" and right_line != "" and left_line == "":
        val old_right = scv_tree_find_old_line_by_chunk(base_tree, right_tree, right_chunk)
        val old_left_line = scv_tree_line_for_path(left_tree, scv_tree_line_path(old_right))
        if old_right != "" and old_left_line != "" and scv_tree_line_chunk_id(old_left_line) != right_chunk:
            val carried_l = scv_tree_line_with_path(old_left_line, rel)
            val ldiag = scv_pp_rename_guard_divergence(root, rel, old_right, carried_l)
            if ldiag != "":
                val lid = scv_write_pp_conflict(root, rel, old_right, carried_l, right_line, ldiag, "path-rename")
                return (carried_l, lid, "preprocessor-rename-guard-conflict")
            return (carried_l, "", "right-rename-left-edit")
    if left_chunk == right_chunk:
        return (left_line, "", "same-content")
    if left_chunk == base_chunk:
        return (right_line, "", "right-only")
    if right_chunk == base_chunk:
        return (left_line, "", "left-only")
    # Both sides changed the file differently. Before ANY aggressive rung runs,
    # refuse when the two edits are preprocessor-region divergent: the line and
    # syntax-node rungs below reason on raw line indices and would merge these
    # clean into a build configuration neither side authored.
    val pp_diag = scv_pp_merge_divergence(root, rel, base_line, left_line, right_line)
    if pp_diag != "":
        val pp_id = scv_write_pp_conflict(root, rel, base_line, left_line, right_line, pp_diag, "preprocessor-regions")
        return (left_line, pp_id, "preprocessor-region-conflict")
    # Attempt structural merge (WS-B: GumTree-grade anchor merge).
    # Only for .spl files or files with parser_index entries.
    # scv_try_structural_merge returns non-empty on success → structural-anchor-merge.
    # Returns "" when no anchors or no ops → fall through with structural-fallback-line.
    # Non-applicable files keep legacy labels (syntax-node-fallback / line-fallback).
    val structural_applicable = scv_structural_merge_applicable(root, rel)
    if structural_applicable:
        val structural_line = scv_try_structural_merge(root, rel, base_line, left_line, right_line)
        if structural_line != "":
            return (structural_line, "", "structural-anchor-merge")
        val syntax_merged_line = scv_try_syntax_node_merge(root, rel, base_line, left_line, right_line)
        if syntax_merged_line != "":
            return (syntax_merged_line, "", "structural-fallback-line")
        val merged_line = scv_try_line_merge(root, rel, base_line, left_line, right_line)
        if merged_line != "":
            return (merged_line, "", "structural-fallback-line")
        # SCV-IMPL-D-05: last aggressive rung before conflict — semistructured
        # region merge (validated by the D-06 gate inside the helper).
        val region_line = scv_try_region_merge(root, rel, base_line, left_line, right_line)
        if region_line != "":
            return (region_line, "", "region-merge")
        val conflict_id = scv_write_conflict(root, rel, base_line, left_line, right_line)
        scv_write_conflict_v2_content(root, rel, base_line, left_line, right_line, "structural-anchor,syntax-node,line,region")
        return (left_line, conflict_id, "conflict-data")
    val syntax_merged_line2 = scv_try_syntax_node_merge(root, rel, base_line, left_line, right_line)
    if syntax_merged_line2 != "":
        return (syntax_merged_line2, "", "syntax-node-fallback")
    val merged_line2 = scv_try_line_merge(root, rel, base_line, left_line, right_line)
    if merged_line2 != "":
        return (merged_line2, "", "line-fallback")
    val conflict_id2 = scv_write_conflict(root, rel, base_line, left_line, right_line)
    scv_write_conflict_v2_content(root, rel, base_line, left_line, right_line, "syntax-node,line")
    (left_line, conflict_id2, "conflict-data")

# SCV-IMPL-D-04 — identity-aware pre-pass. Groups are entities the path/chunk
# logic cannot resolve (rename+edit vs edit, rename vs rename, rename vs
# delete); each consumes its paths so the path loop below never sees them.
# Conflicts stay DATA objects (jj remains the conflict-storage authority).
fn scv_write_conflict_kind(root: text, rel: text, kind: text, entity: text, base_line: text, left_line: text, right_line: text) -> text:
    val payload = "path: {rel}\nkind: {kind}\nentity: {entity}\nbase: {base_line}\nleft: {left_line}\nright: {right_line}\ntime_ms: {current_time_ms()}\n"
    val id = scv_hash_text("conflict", payload)
    scv_write_text(scv_object_path(root, "conflicts", id), payload)
    id

# Returns (picked_line, conflict_id, strategy_rows, consumed_paths).
fn scv_apply_identity_group(root: text, group: text, base_tree: text, left_tree: text, right_tree: text) -> (text, text, text, text):
    val f = group.split("\t")
    if f.len() != 7:
        return ("", "", "", "")
    val kind = f[0]
    val entity = f[1]
    val target = f[2]
    var consumed = ""
    for p in f[3].split(","):
        if p != "":
            consumed = consumed + p + "\n"
    val base_line = if f[4] != "": scv_tree_line_with_path(f[4], target) else: ""
    val left_line = if f[5] != "": scv_tree_line_with_path(f[5], target) else: ""
    val right_line = if f[6] != "": scv_tree_line_with_path(f[6], target) else: ""
    val source = scv_tree_line_path(f[4])
    if kind == "rename_edit":
        val (picked, conflict_id, strategy) = scv_pick_merge_line(root, target, base_tree, left_tree, right_tree, base_line, left_line, right_line)
        val rows = "{source}: identity-rename-source\n{target}: identity-rename-clobbered ({strategy}) entity={entity}\n"
        return (picked, conflict_id, rows, consumed)
    if kind == "rename_rename":
        val conflict_id = scv_write_conflict_kind(root, target, "entity_identity_ambiguous", entity, f[4], f[5], f[6])
        scv_conflict_v2_write(root, scv_conflict_v2_payload(target, "entity_identity_ambiguous", entity, f[4], f[5], f[6], "identity-prepass", "both sides renamed entity {entity} to different paths"))
        val rows = "{source}: identity-rename-source\n{target}: identity-rename-rename conflict entity={entity}\n"
        return (left_line, conflict_id, rows, consumed)
    if kind == "rename_delete":
        val kept = if left_line != "": left_line else: right_line
        val conflict_id = scv_write_conflict_kind(root, target, "entity_rename_delete", entity, f[4], f[5], f[6])
        # SCV-IMPL-D-07: name the D-04 store ceiling properly. The linear
        # identity store attributes only ONE accepted rename per EntityId, so
        # a rename-vs-rename surfaces here as rename-vs-"delete" with the
        # second rename left as an unattributed ADDED path on the deleting
        # side. When that added path exists, the v2 kind is
        # entity_identity_ambiguous; v1 keeps its store's-eye label.
        val deleting_tree = if left_line == "": left_tree else: right_tree
        var v2_kind = "entity_rename_delete"
        var v2_diag = "entity {entity} renamed on one side and deleted on the other"
        if scv_tree_has_added_path(deleting_tree, base_tree):
            v2_kind = "entity_identity_ambiguous"
            v2_diag = "identity store attributes only one accepted rename per EntityId; the deleting side carries an unattributed added path that may be a second rename of entity {entity}"
        scv_conflict_v2_write(root, scv_conflict_v2_payload(target, v2_kind, entity, f[4], f[5], f[6], "identity-prepass", v2_diag))
        val rows = "{source}: identity-rename-source\n{target}: identity-rename-delete conflict entity={entity}\n"
        return (kept, conflict_id, rows, consumed)
    ("", "", "", "")

fn scv_merge_commits(root: text, base_commit: text, left_commit: text, right_commit: text) -> text:
    val base_tree = scv_tree_content(root, base_commit)
    val left_tree = scv_tree_content(root, left_commit)
    val right_tree = scv_tree_content(root, right_commit)
    if left_tree == "" or right_tree == "":
        return "ERROR missing merge input\n"
    val base_error = scv_merge_tree_content_error(base_tree, "base")
    if base_error != "":
        return base_error
    val left_error = scv_merge_tree_content_error(left_tree, "left")
    if left_error != "":
        return left_error
    val right_error = scv_merge_tree_content_error(right_tree, "right")
    if right_error != "":
        return right_error
    var paths = ""
    paths = scv_add_paths_from_tree(base_tree, paths)
    paths = scv_add_paths_from_tree(left_tree, paths)
    paths = scv_add_paths_from_tree(right_tree, paths)
    var merged_lines: [text] = []
    var conflict_count = 0
    var conflict_ids = ""
    var strategies = ""
    var consumed = ""
    for group in scv_identity_merge_groups(root, base_commit, left_commit, right_commit):
        val (g_picked, g_conflict, g_rows, g_consumed) = scv_apply_identity_group(root, group, base_tree, left_tree, right_tree)
        if g_consumed == "":
            continue
        consumed = consumed + g_consumed
        if g_picked != "":
            merged_lines.push(g_picked)
        strategies = strategies + g_rows
        if g_conflict != "":
            conflict_count = conflict_count + 1
            conflict_ids = conflict_ids + g_conflict + "\n"
    for rel in paths.split("\n"):
        val path = rel.trim()
        if path == "":
            continue
        if scv_line_set_contains(consumed, path):
            continue
        val base_line = scv_tree_line_for_path(base_tree, path)
        val left_line = scv_tree_line_for_path(left_tree, path)
        val right_line = scv_tree_line_for_path(right_tree, path)
        val (picked, conflict_id, strategy) = scv_pick_merge_line(root, path, base_tree, left_tree, right_tree, base_line, left_line, right_line)
        if picked != "":
            merged_lines.push(picked)
        if strategy != "":
            strategies = strategies + path + ": " + strategy + "\n"
        if conflict_id != "":
            conflict_count = conflict_count + 1
            conflict_ids = conflict_ids + conflict_id + "\n"
    val tree = scv_write_tree_object(root, merged_lines)
    # Parents are SPACE-joined: scv_write_operation validates each parent by
    # splitting on " " (store.spl), so the old comma join could never be recorded.
    val commit = scv_write_commit(root, "{left_commit} {right_commit}", tree, scv_state_private())
    val op = scv_write_operation(root, scv_current_op(root), commit, "merge-commits {base_commit} {left_commit} {right_commit}")
    if op.starts_with("ERROR"):
        return op
    "merge {commit} {op} conflicts={conflict_count}\nstrategies:\n{strategies}{conflict_ids}"

fn scv_conflicts(root: text) -> text:
    val dir = "{root}/.scv/objects/conflicts"
    if not file_exists(dir):
        return "no conflicts\n"
    var rows: [text] = []
    for path in dir_walk(dir):
        val content = file_read(path)
        val id_parts = path.split("/")
        val file_name = id_parts[id_parts.len() - 1]
        rows.push("{file_name}: {content}")
    val out = rows.join("")
    if out == "":
        "no conflicts\n"
    else:
        out

fn scv_conflict_id_valid(id: text) -> bool:
    id.starts_with("conflict_") and not id.contains("/") and not id.contains("\\") and not id.contains("\n") and not id.contains("\r")

fn scv_resolve_conflict(root: text, id: text) -> text:
    if not scv_conflict_id_valid(id):
        return "ERROR invalid conflict id\n"
    val path = scv_object_path(root, "conflicts", id)
    if not file_exists(path):
        return "ERROR missing conflict\n"
    if file_delete(path):
        "resolved {id}\n"
    else:
        "ERROR could not resolve conflict\n"
