# Complete transaction planning from authenticated original patches and actual
# Merkle-bound bucket proofs. No incomplete read set can prove absence.
use std.scv.db_paged_model.*
use std.scv.db_paged_proof.*
use std.scv.db_paged_prepare.*
use std.scv.db_paged_constraints.*
use std.scv.db_paged_indexes.*
use std.scv.db_page_records.*
use std.scv.db_pages.*
use std.scv.db_patch.*
use std.scv.db_reducer.{DbAcceptedBatch}
use std.scv.db_admission.{db_authorize_patch, db_require_unreserved_entity_kinds}
use std.scv.distributed_identity.{SettledAlias}

struct DbPagedRequest:
    manifest: DbPagedManifest
    patch: DbPatch
    policy: DbPagedPolicy
    now: u64
    proofs: [DbPagedLookupProof]

struct DbPagedCommitPlan:
    manifest: DbPagedManifest
    build: DbPageBuild
    replay: bool

enum DbPagedPlanning:
    NeedKeys(request: DbPagedRequest, keys: [text])
    Ready(plan: DbPagedCommitPlan)

fn _paged_accepted(reads: DbPagedReads, key: text, actor_index: bool) -> Result<DbAcceptedBatch?, text>:
    val record = db_paged_read(reads, key)?
    if record == nil: return Ok(nil)
    match db_typed_page_record_decode(record.unwrap())?:
        Accepted(batch):
            if actor_index: return Err("SCVDB_PAGED_INDEX_CORRUPT")
            Ok(Some(batch))
        ActorCounter(batch):
            if not actor_index: return Err("SCVDB_PAGED_INDEX_CORRUPT")
            Ok(Some(batch))
        _: Err("SCVDB_PAGED_INDEX_CORRUPT")

fn _paged_run(request: DbPagedRequest) -> Result<DbPagedPlanning, text>:
    val manifest = request.manifest
    val patch = request.patch
    val policy = request.policy
    val valid = db_paged_manifest_validate(manifest, policy)?
    val allowed = db_require_unreserved_entity_kinds(patch)?
    if patch.provenance.starts_with("SCVDB-CONFLICT-RESOLUTION-v1:"): return Err("SCVDB_RESOLUTION_OWNER_REQUIRED")
    if (patch.operations.len() as u64) > policy.max_operations or (patch.causal_dependencies.len() as u64) > policy.max_read_keys: return Err("SCVDB_PAGED_QUOTA")
    val digest = db_patch_validate(patch)?
    # Signature/context/key-time/scope/metadata authentication precedes any
    # attacker-selected dependency IO. This phase supplies the signed dependency
    # names only to separate authentication from existence: it is NOT dependency
    # proof. Actual membership is independently checked below from Merkle pages.
    val authenticated_scope = db_authorize_patch(patch, policy.config.admission, patch.causal_dependencies, request.now)?
    val reads = db_paged_reads(manifest, policy, request.proofs)?
    val batch_key = db_page_batch_key(patch.batch_id)?
    val actor_key = db_page_actor_counter_key(patch.actor, patch.actor_counter)?
    var first = [batch_key, actor_key]
    for dependency in patch.causal_dependencies: first.push(db_page_batch_key(dependency)?)
    if patch.base_revision != "" and patch.base_revision != manifest.revision: first.push(db_paged_history_key(patch.base_revision)?)
    var missing = db_paged_missing(reads, first, policy)?
    if missing.len() > 0: return Ok(DbPagedPlanning.NeedKeys(request, missing))
    var accepted_ids: [text] = []
    for dependency in patch.causal_dependencies:
        if _paged_accepted(reads, db_page_batch_key(dependency)?, false)? == nil: return Err("SCVDB_MISSING_DEPENDENCY")
        accepted_ids.push(dependency)
    val authorized = db_authorize_patch(patch, policy.config.admission, accepted_ids, request.now)?
    val accepted = _paged_accepted(reads, batch_key, false)?
    val counter = _paged_accepted(reads, actor_key, true)?
    if val previous = accepted:
        if previous.canonical_digest != digest or counter == nil or counter.unwrap() != previous: return Err("SCVDB_BATCH_IDENTITY_COLLISION")
        return Ok(DbPagedPlanning.Ready(DbPagedCommitPlan(manifest: manifest, build: DbPageBuild(manifest: manifest.pages, pages: []), replay: true)))
    if counter != nil: return Err("SCVDB_ACTOR_COUNTER_COLLISION")
    if patch.base_revision != manifest.revision:
        if patch.base_revision == "": return Err("SCVDB_BASE_REVISION_MISSING")
        val historical = db_paged_read(reads, db_paged_history_key(patch.base_revision)?)?
        if historical == nil: return Err("SCVDB_BASE_REVISION_MISSING")
        if db_paged_index_value(historical.unwrap(), 172u8)? != DbValue.Text(patch.base_revision): return Err("SCVDB_PAGED_INDEX_CORRUPT")
    missing = db_paged_missing(reads, db_paged_alias_reads(patch, policy)?, policy)?
    if missing.len() > 0: return Ok(DbPagedPlanning.NeedKeys(request, missing))
    val operations = db_paged_execution_operations(patch, reads, policy)?
    missing = db_paged_missing(reads, db_paged_operation_row_keys(operations)?, policy)?
    if missing.len() > 0: return Ok(DbPagedPlanning.NeedKeys(request, missing))
    val rows = db_paged_reduce_rows(patch, operations, reads, policy)?
    missing = db_paged_missing(reads, db_paged_constraint_reads(rows, policy)?, policy)?
    if missing.len() > 0: return Ok(DbPagedPlanning.NeedKeys(request, missing))
    val allocations = db_paged_allocations(rows, reads, policy)?
    var allocation_keys: [text] = []
    for binding in allocations:
        allocation_keys.push(db_page_alias_key(SettledAlias(database_namespace: binding.namespace, authority_epoch: binding.epoch, entity_kind: binding.uid.entity_kind, sequence: binding.sequence))?)
    allocation_keys.push(db_paged_history_key(manifest.revision)?)
    missing = db_paged_missing(reads, allocation_keys, policy)?
    if missing.len() > 0: return Ok(DbPagedPlanning.NeedKeys(request, missing))
    var updates = db_paged_constraint_updates(rows, reads, policy, allocations)?
    val next_batch = DbAcceptedBatch(batch_id: patch.batch_id, canonical_digest: digest, actor: patch.actor, actor_counter: patch.actor_counter, prior_revision: manifest.revision)
    updates.push(db_typed_page_record_encode(DbTypedPageRecord.Accepted(next_batch))?)
    updates.push(db_typed_page_record_encode(DbTypedPageRecord.ActorCounter(next_batch))?)
    updates.push(db_paged_index_record(db_paged_history_key(manifest.revision)?, 172u8, DbValue.Text(manifest.revision))?)
    if (updates.len() as u64) > policy.max_read_keys: return Err("SCVDB_PAGED_QUOTA")
    # All update buckets need actual old-page proofs, even records whose keys
    # were derived only after alias allocation/global checks.
    var update_keys: [text] = []
    for update in updates: update_keys.push(update.key)
    missing = db_paged_missing(reads, update_keys, policy)?
    if missing.len() > 0: return Ok(DbPagedPlanning.NeedKeys(request, missing))
    var affected: [DbRecordPage] = []
    var by_bucket: {text: DbRecordPage} = {}
    for page in reads.pages: by_bucket[page.bucket] = page
    for bucket in db_pages_required_buckets(updates)?:
        if by_bucket.contains_key(bucket): affected.push(by_bucket[bucket])
    val build = db_pages_update(manifest.pages, affected, updates)?
    val next = db_paged_manifest_seal(DbPagedManifest(context: manifest.context, policy_revision: policy.revision, structure_revision: manifest.structure_revision, protocol: manifest.protocol, index_version: manifest.index_version, parent_revision: manifest.revision, pages: build.manifest, revision: ""))?
    Ok(DbPagedPlanning.Ready(DbPagedCommitPlan(manifest: next, build: build, replay: false)))

fn db_paged_begin(manifest: DbPagedManifest, patch: DbPatch, policy: DbPagedPolicy, now: u64) -> Result<DbPagedPlanning, text>:
    _paged_run(DbPagedRequest(manifest: manifest, patch: patch, policy: policy, now: now, proofs: []))

fn db_paged_advance(planning: DbPagedPlanning, proofs: [DbPagedLookupProof]) -> Result<DbPagedPlanning, text>:
    match planning:
        NeedKeys(request, _):
            var next = request
            next.proofs = request.proofs + proofs
            _paged_run(next)
        Ready(_): Err("SCVDB_PAGED_ALREADY_READY")

export DbPagedRequest, DbPagedCommitPlan, DbPagedPlanning, db_paged_begin, db_paged_advance
