# SCV GumTree-grade structural matching: anchor extraction, top-down/bottom-up
# matching, edit script generation.
#
# Thresholds from Falleri et al. "Fine-grained and accurate source code
# differencing" (ASE 2014).  Do NOT change without re-reading the paper.
# TODO(prod-003): empirical calibration pass once WS-A tree-sitter lands.

use app.io.mod (file_exists, file_read, dir_walk)
use std.scv.core.{scv_object_path, scv_parser_index_path, scv_line_set_contains}
use std.scv.store.{scv_hash_text}
use std.scv.anchor.{Anchor, NamedAnchor, OrdinalAnchor, scv_named_anchor, scv_ordinal_anchor, scv_build_qpath, scv_anchor_id}
use std.scv.core.{scv_head_path}
use std.scv.store.{scv_content_id_for_file}
use std.scv.symbol_entity.{scv_symbol_extract_decls}
use std.scv.cst_ir.{scv_cst_atom, scv_cst_named, scv_cst_list, scv_cst_file, scv_cst_document, scv_cst_document_node, scv_cst_kind, scv_cst_label, scv_cst_value, scv_cst_children, scv_cst_hash, scv_cst_root_key, scv_cst_roots_dir, scv_cst_root_store, scv_cst_root_load}

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

struct StructuralMatchConfig:
    min_dice: i64    # ×1000 fixed-point; paper suggests 500
    min_height: i64  # minimum subtree height for top-down anchoring; paper: 2
    max_size: i64    # skip subtrees larger than this (performance guard)

fn scv_default_match_config() -> StructuralMatchConfig:
    StructuralMatchConfig(min_dice: 500, min_height: 2, max_size: 1000)

# ---------------------------------------------------------------------------
# Low-level node field readers
# Syntax node SDN format (see parser.spl scv_write_syntax_node):
#   grammar: ...
#   version: ...
#   kind: <kind>
#   field: <field>
#   children: <comma-sep ids>
#   name: <name>   (tree-sitter nodes; may be absent for fallback)
#   raw: <hash>
#   syntax: <hash>
#   ...
# ---------------------------------------------------------------------------

fn scv_load_node_fields(root: text, node_id: text) -> text:
    if node_id == "":
        return ""
    val path = scv_object_path(root, "syntax", node_id)
    if not file_exists(path):
        return ""
    file_read(path)

fn scv_node_kind(node_fields: text) -> text:
    for line in node_fields.split("\n"):
        if line.starts_with("kind:"):
            return line[5:].trim()
    ""

fn scv_node_name(node_fields: text) -> text:
    for line in node_fields.split("\n"):
        if line.starts_with("name:"):
            return line[5:].trim()
    ""

fn scv_node_syntax_hash(node_fields: text) -> text:
    for line in node_fields.split("\n"):
        if line.starts_with("syntax:"):
            return line[7:].trim()
    ""

fn scv_node_children_ids(node_fields: text) -> [text]:
    for line in node_fields.split("\n"):
        if line.starts_with("children:"):
            val children = line[9:].trim()
            if children == "":
                return []
            return children.split(",")
    []

# ---------------------------------------------------------------------------
# Anchor extraction
# Walk the syntax subtree rooted at node_id; emit Named anchors for nodes
# that have a name field (function_def, class_def, module etc.), and Ordinal
# anchors for unnamed statement/expr children of named parents.
# Returns [] for kind==line (graceful degradation path).
# ---------------------------------------------------------------------------

fn scv_extract_anchors_rec(root: text, node_id: text, parent_qpath: text, acc: [Anchor]) -> [Anchor]:
    val fields = scv_load_node_fields(root, node_id)
    if fields == "":
        return acc
    val kind = scv_node_kind(fields)
    if kind == "line" or kind == "":
        return acc
    val name = scv_node_name(fields)
    var qpath = parent_qpath
    var result = acc
    if name != "":
        qpath = scv_build_qpath(parent_qpath, name)
        result.push(scv_named_anchor(qpath))
    val children = scv_node_children_ids(fields)
    var ordinal_index = 0
    for child_id in children:
        val child_fields = scv_load_node_fields(root, child_id)
        val child_kind = scv_node_kind(child_fields)
        if child_kind == "line" or child_kind == "":
            ordinal_index = ordinal_index + 1
            continue
        val child_name = scv_node_name(child_fields)
        if child_name == "" and qpath != "":
            result.push(scv_ordinal_anchor(qpath, ordinal_index))
        result = scv_extract_anchors_rec(root, child_id, qpath, result)
        ordinal_index = ordinal_index + 1
    result

fn scv_extract_anchors(root: text, node_id: text, parent_qpath: text) -> [Anchor]:
    if node_id == "":
        return []
    val fields = scv_load_node_fields(root, node_id)
    if fields == "":
        return []
    val kind = scv_node_kind(fields)
    if kind == "line" or kind == "":
        return []
    scv_extract_anchors_rec(root, node_id, parent_qpath, [])

# ---------------------------------------------------------------------------
# Parser index helpers
# The parser_index.sdn line format:
#   rel|language|raw|syntax_hash|semantic_hash|kind|parse_status|metric|node=<id>
# ---------------------------------------------------------------------------

fn scv_parser_index_root_node(root: text, rel: text) -> text:
    val index_path = scv_parser_index_path(root)
    if not file_exists(index_path):
        return ""
    for line in file_read(index_path).split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() < 9:
            continue
        if parts[0] != rel:
            continue
        val marker = "node="
        if parts[8].starts_with(marker):
            return parts[8][marker.len():]
    ""

# ---------------------------------------------------------------------------
# Subtree hash + Dice similarity
# ---------------------------------------------------------------------------

fn scv_subtree_hash_rec(root: text, node_id: text, depth: i64) -> text:
    if depth > 100:
        return scv_hash_text("subtree", node_id)
    val fields = scv_load_node_fields(root, node_id)
    if fields == "":
        return scv_hash_text("subtree", node_id)
    val own_hash = scv_node_syntax_hash(fields)
    val children = scv_node_children_ids(fields)
    if children.len() == 0:
        return own_hash
    var combined = own_hash
    for child_id in children:
        combined = combined + "," + scv_subtree_hash_rec(root, child_id, depth + 1)
    scv_hash_text("subtree", combined)

fn scv_subtree_hash(root: text, node_id: text) -> text:
    scv_subtree_hash_rec(root, node_id, 0)

fn scv_subtree_height_rec(root: text, node_id: text, depth: i64) -> i64:
    if depth > 200:
        return 200
    val fields = scv_load_node_fields(root, node_id)
    if fields == "":
        return 0
    val children = scv_node_children_ids(fields)
    if children.len() == 0:
        return 1
    var max_child = 0
    for child_id in children:
        val h = scv_subtree_height_rec(root, child_id, depth + 1)
        if h > max_child:
            max_child = h
    max_child + 1

fn scv_subtree_height(root: text, node_id: text) -> i64:
    scv_subtree_height_rec(root, node_id, 0)

fn scv_descendant_labels_rec(root: text, node_id: text, depth: i64, acc: [text]) -> [text]:
    if depth > 100:
        return acc
    val fields = scv_load_node_fields(root, node_id)
    if fields == "":
        return acc
    val kind = scv_node_kind(fields)
    val name = scv_node_name(fields)
    var result = acc
    if name != "":
        result.push(name)
    elif kind != "" and kind != "line":
        result.push(kind)
    val children = scv_node_children_ids(fields)
    for child_id in children:
        result = scv_descendant_labels_rec(root, child_id, depth + 1, result)
    result

fn scv_descendant_labels(root: text, node_id: text) -> [text]:
    scv_descendant_labels_rec(root, node_id, 0, [])

# Dice(A,B) = 2|A∩B| / (|A|+|B|)  returned ×1000 fixed-point
fn scv_dice_similarity(a: [text], b: [text]) -> i64:
    if a.len() == 0 and b.len() == 0:
        return 1000
    if a.len() == 0 or b.len() == 0:
        return 0
    var common = 0
    for la in a:
        for lb in b:
            if la == lb:
                common = common + 1
                break
    (2 * common * 1000) / (a.len() + b.len())

# ---------------------------------------------------------------------------
# Pair-set helpers
# Pairs are encoded as "base_id:head_id\n" text for simplicity
# ---------------------------------------------------------------------------

fn scv_pair_contains_base(pairs: text, base_id: text) -> bool:
    for line in pairs.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split(":")
        if parts.len() >= 2 and parts[0] == base_id:
            return true
    false

fn scv_pair_contains_head(pairs: text, head_id: text) -> bool:
    for line in pairs.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split(":")
        if parts.len() >= 2 and parts[1] == head_id:
            return true
    false

fn scv_pair_rows_contains_base(rows: [text], base_id: text) -> bool:
    for row in rows:
        val parts = row.trim().split(":")
        if parts.len() >= 2 and parts[0] == base_id:
            return true
    false

fn scv_pair_rows_contains_head(rows: [text], head_id: text) -> bool:
    for row in rows:
        val parts = row.trim().split(":")
        if parts.len() >= 2 and parts[1] == head_id:
            return true
    false

fn scv_pairs_to_list(pairs: text) -> [(text, text)]:
    var out: [(text, text)] = []
    for line in pairs.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split(":")
        if parts.len() >= 2:
            out.push((parts[0], parts[1]))
    out

# ---------------------------------------------------------------------------
# Top-down matching: identical subtree hash → high-confidence anchor pair
# ---------------------------------------------------------------------------

fn scv_collect_node_ids_rec(root: text, node_id: text, depth: i64, acc: [text]) -> [text]:
    if depth > 200 or node_id == "":
        return acc
    var result = acc
    result.push(node_id)
    val fields = scv_load_node_fields(root, node_id)
    if fields == "":
        return result
    val children = scv_node_children_ids(fields)
    for child_id in children:
        result = scv_collect_node_ids_rec(root, child_id, depth + 1, result)
    result

fn scv_collect_node_ids(root: text, node_id: text) -> [text]:
    scv_collect_node_ids_rec(root, node_id, 0, [])

fn scv_match_top_down(root: text, base_root: text, head_root: text, cfg: StructuralMatchConfig) -> [(text, text)]:
    if base_root == "" or head_root == "":
        return []
    val base_height = scv_subtree_height(root, base_root)
    val head_height = scv_subtree_height(root, head_root)
    if base_height < cfg.min_height or head_height < cfg.min_height:
        return []
    val base_nodes = scv_collect_node_ids(root, base_root)
    val head_nodes = scv_collect_node_ids(root, head_root)
    var pairs = ""
    for base_id in base_nodes:
        if scv_pair_contains_base(pairs, base_id):
            continue
        val base_hash = scv_subtree_hash(root, base_id)
        for head_id in head_nodes:
            if scv_pair_contains_head(pairs, head_id):
                continue
            val head_hash = scv_subtree_hash(root, head_id)
            if base_hash == head_hash:
                pairs = pairs + "{base_id}:{head_id}\n"
                break
    scv_pairs_to_list(pairs)

# ---------------------------------------------------------------------------
# Bottom-up matching: Dice similarity on descendant labels
# ---------------------------------------------------------------------------

fn scv_match_bottom_up(root: text, base_root: text, head_root: text, existing: [(text, text)], cfg: StructuralMatchConfig) -> [(text, text)]:
    if base_root == "" or head_root == "":
        return existing
    val base_nodes = scv_collect_node_ids(root, base_root)
    val head_nodes = scv_collect_node_ids(root, head_root)
    var pair_rows: [text] = []
    for pair in existing:
        val (b, h) = pair
        pair_rows.push("{b}:{h}\n")
    for base_id in base_nodes:
        if scv_pair_rows_contains_base(pair_rows, base_id):
            continue
        val base_labels = scv_descendant_labels(root, base_id)
        var best_head = ""
        var best_dice: i64 = cfg.min_dice
        for head_id in head_nodes:
            if scv_pair_rows_contains_head(pair_rows, head_id):
                continue
            val head_labels = scv_descendant_labels(root, head_id)
            val dice = scv_dice_similarity(base_labels, head_labels)
            if dice > best_dice:
                best_dice = dice
                best_head = head_id
        if best_head != "":
            pair_rows.push("{base_id}:{best_head}\n")
    scv_pairs_to_list(pair_rows.join(""))

# ---------------------------------------------------------------------------
# Edit script
# ---------------------------------------------------------------------------

struct EditOp:
    kind: text
    base_node: text
    head_node: text
    anchor: Anchor

fn scv_make_edit_op(kind: text, base_node: text, head_node: text, anchor: Anchor) -> EditOp:
    EditOp(kind: kind, base_node: base_node, head_node: head_node, anchor: anchor)

fn scv_pair_has_base(pairs: [(text, text)], base_id: text) -> bool:
    for pair in pairs:
        val (b, h) = pair
        if b == base_id:
            return true
    false

fn scv_pair_has_head(pairs: [(text, text)], head_id: text) -> bool:
    for pair in pairs:
        val (b, h) = pair
        if h == head_id:
            return true
    false

fn scv_compute_edit_script(root: text, base_root: text, head_root: text, cfg: StructuralMatchConfig) -> [EditOp]:
    val top_pairs = scv_match_top_down(root, base_root, head_root, cfg)
    val all_pairs = scv_match_bottom_up(root, base_root, head_root, top_pairs, cfg)
    if all_pairs.len() == 0:
        return []
    val base_nodes = scv_collect_node_ids(root, base_root)
    val head_nodes = scv_collect_node_ids(root, head_root)
    var ops: [EditOp] = []
    # Deletes: base nodes with no match in head
    for base_id in base_nodes:
        if not scv_pair_has_base(all_pairs, base_id):
            val fields = scv_load_node_fields(root, base_id)
            val name = scv_node_name(fields)
            var anchor = scv_ordinal_anchor("", 0)
            if name != "":
                anchor = scv_named_anchor(name)
            ops.push(scv_make_edit_op("delete", base_id, "", anchor))
    # Inserts: head nodes with no match in base
    for head_id in head_nodes:
        if not scv_pair_has_head(all_pairs, head_id):
            val fields = scv_load_node_fields(root, head_id)
            val name = scv_node_name(fields)
            var anchor = scv_ordinal_anchor("", 0)
            if name != "":
                anchor = scv_named_anchor(name)
            ops.push(scv_make_edit_op("insert", "", head_id, anchor))
    # Updates/Moves: matched pairs
    for pair in all_pairs:
        val (base_id, head_id) = pair
        val base_fields = scv_load_node_fields(root, base_id)
        val head_fields = scv_load_node_fields(root, head_id)
        val base_hash = scv_node_syntax_hash(base_fields)
        val head_hash = scv_node_syntax_hash(head_fields)
        val name = scv_node_name(base_fields)
        var anchor = scv_ordinal_anchor("", 0)
        if name != "":
            anchor = scv_named_anchor(name)
        if base_hash != head_hash:
            ops.push(scv_make_edit_op("update", base_id, head_id, anchor))
        else:
            # Same hash but matched via bottom-up: potentially a move
            ops.push(scv_make_edit_op("move", base_id, head_id, anchor))
    ops

# ---------------------------------------------------------------------------
# Diff display helper — used by diff.spl for --structural mode
# ---------------------------------------------------------------------------

# Candidate cap for bounded pairing (per base node). Named constant per the
# scv v2 reports: pairing is bucketed by (kind, size bucket) and capped so the
# matcher never degenerates to unbounded O(N²).
fn scv_match_candidate_cap() -> i64:
    64

# Cap on syntax objects examined when resolving a root by content id via the
# object-store scan (the parser index only holds the CURRENT row per rel).
fn scv_syntax_root_scan_cap() -> i64:
    4096

fn scv_node_raw_hash(node_fields: text) -> text:
    for line in node_fields.split("\n"):
        if line.starts_with("raw:"):
            return line[4:].trim()
    ""

fn scv_node_path_field(node_fields: text) -> text:
    for line in node_fields.split("\n"):
        if line.starts_with("path:"):
            return line[5:].trim()
    ""

fn scv_parser_index_root_node_for_raw(root: text, rel: text, raw: text) -> text:
    val index_path = scv_parser_index_path(root)
    if not file_exists(index_path):
        return ""
    for line in file_read(index_path).split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() < 9:
            continue
        if parts[0] != rel or parts[2] != raw:
            continue
        val marker = "node="
        if parts[8].starts_with(marker):
            return parts[8][marker.len():]
    ""

# Resolve a stored parse root for (rel, content id).  Fast path: the parser
# index row (current parse).  Slow path: bounded scan of the content-addressed
# syntax object store for a file/binary root whose `path`/`raw` fields match —
# old roots persist there after the index row is repointed by a re-parse.
# Returns "" when no stored root exists (caller falls back to text blocks).
fn scv_syntax_root_for_content(root: text, rel: text, raw: text) -> text:
    if rel == "" or raw == "":
        return ""
    val indexed = scv_parser_index_root_node_for_raw(root, rel, raw)
    if indexed != "":
        return indexed
    # objects/syntax dir derived from scv_object_path (".../syntax/<id>.sdn"):
    # strip the "/.sdn" suffix of the empty-id probe to get the directory.
    val probe = scv_object_path(root, "syntax", "")
    val dir = probe[0:probe.len() - 5]
    if not file_exists(dir):
        return ""
    var scanned = 0
    for path in dir_walk(dir):
        if scanned >= scv_syntax_root_scan_cap():
            return ""
        scanned = scanned + 1
        if not path.ends_with(".sdn"):
            continue
        val fields = file_read(path)
        val kind = scv_node_kind(fields)
        if kind != "file" and kind != "binary":
            continue
        if scv_node_raw_hash(fields) != raw or scv_node_path_field(fields) != rel:
            continue
        # node id is the file basename without .sdn
        val name = path.split("/")
        val base = name[name.len() - 1]
        return base[0:base.len() - 4]
    ""

# ---------------------------------------------------------------------------
# Bounded matching over two stored roots.
# Candidates are bucketed by (node kind, size bucket of subtree node count)
# and capped at scv_match_candidate_cap() per base node.  Subtree hashes and
# labels are computed once per node, never inside the pairing loops.
# ---------------------------------------------------------------------------

fn scv_size_bucket(n: i64) -> i64:
    var bucket = 0
    var limit = 1
    while limit < n and bucket < 30:
        limit = limit * 2
        bucket = bucket + 1
    bucket

fn scv_subtree_node_count(root: text, node_id: text) -> i64:
    scv_collect_node_ids(root, node_id).len()

fn scv_bucket_key(root: text, node_id: text) -> text:
    val fields = scv_load_node_fields(root, node_id)
    "{scv_node_kind(fields)}#{scv_size_bucket(scv_subtree_node_count(root, node_id))}"

fn scv_match_roots_bounded(root: text, base_root: text, head_root: text, cfg: StructuralMatchConfig) -> [(text, text)]:
    val base_nodes = scv_collect_node_ids(root, base_root)
    val head_nodes = scv_collect_node_ids(root, head_root)
    if base_nodes.len() == 0 or head_nodes.len() == 0:
        return []
    if base_nodes.len() > cfg.max_size or head_nodes.len() > cfg.max_size:
        return []
    # Precompute per-node hash and bucket key once.
    var base_hash: [text] = []
    var base_key: [text] = []
    for b in base_nodes:
        base_hash.push(scv_subtree_hash(root, b))
        base_key.push(scv_bucket_key(root, b))
    var head_hash: [text] = []
    var head_key: [text] = []
    for h in head_nodes:
        head_hash.push(scv_subtree_hash(root, h))
        head_key.push(scv_bucket_key(root, h))
    var pair_rows: [text] = []
    # Top-down: identical subtree hash within the same (kind, size) bucket.
    var i = 0
    while i < base_nodes.len():
        var candidates = 0
        var j = 0
        while j < head_nodes.len():
            if head_key[j] == base_key[i]:
                candidates = candidates + 1
                if candidates > scv_match_candidate_cap():
                    break
                if head_hash[j] == base_hash[i] and not scv_pair_rows_contains_head(pair_rows, head_nodes[j]):
                    pair_rows.push("{base_nodes[i]}:{head_nodes[j]}\n")
                    break
            j = j + 1
        i = i + 1
    # Bottom-up: Dice similarity on descendant labels, same bucketing + cap.
    # Nodes with EMPTY label sets are skipped: dice([],[]) == 1000 would pair
    # arbitrary unmatched fallback-line nodes and emit garbage move/update ops.
    i = 0
    while i < base_nodes.len():
        if scv_pair_rows_contains_base(pair_rows, base_nodes[i]):
            i = i + 1
            continue
        val base_labels = scv_descendant_labels(root, base_nodes[i])
        if base_labels.len() == 0:
            i = i + 1
            continue
        var best_head = ""
        var best_dice: i64 = cfg.min_dice
        var candidates = 0
        var j = 0
        while j < head_nodes.len():
            if head_key[j] == base_key[i] and not scv_pair_rows_contains_head(pair_rows, head_nodes[j]):
                candidates = candidates + 1
                if candidates > scv_match_candidate_cap():
                    break
                val head_labels = scv_descendant_labels(root, head_nodes[j])
                if head_labels.len() > 0:
                    val dice = scv_dice_similarity(base_labels, head_labels)
                    if dice > best_dice:
                        best_dice = dice
                        best_head = head_nodes[j]
            j = j + 1
        if best_head != "":
            pair_rows.push("{base_nodes[i]}:{best_head}\n")
        i = i + 1
    scv_pairs_to_list(pair_rows.join(""))

fn scv_edit_script_from_pairs(root: text, base_root: text, head_root: text, all_pairs: [(text, text)]) -> [EditOp]:
    val base_nodes = scv_collect_node_ids(root, base_root)
    val head_nodes = scv_collect_node_ids(root, head_root)
    var ops: [EditOp] = []
    for base_id in base_nodes:
        if not scv_pair_has_base(all_pairs, base_id):
            val fields = scv_load_node_fields(root, base_id)
            val name = scv_node_name(fields)
            var anchor = scv_ordinal_anchor("", 0)
            if name != "":
                anchor = scv_named_anchor(name)
            ops.push(scv_make_edit_op("delete", base_id, "", anchor))
    for head_id in head_nodes:
        if not scv_pair_has_head(all_pairs, head_id):
            val fields = scv_load_node_fields(root, head_id)
            val name = scv_node_name(fields)
            var anchor = scv_ordinal_anchor("", 0)
            if name != "":
                anchor = scv_named_anchor(name)
            ops.push(scv_make_edit_op("insert", "", head_id, anchor))
    for pair in all_pairs:
        val (base_id, head_id) = pair
        val base_fields = scv_load_node_fields(root, base_id)
        val head_fields = scv_load_node_fields(root, head_id)
        val name = scv_node_name(base_fields)
        var anchor = scv_ordinal_anchor("", 0)
        if name != "":
            anchor = scv_named_anchor(name)
        if scv_node_syntax_hash(base_fields) != scv_node_syntax_hash(head_fields):
            ops.push(scv_make_edit_op("update", base_id, head_id, anchor))
        # matched with identical syntax hash: no op (unchanged); position moves
        # of fallback-line nodes are indistinguishable because line_no is baked
        # into the syntax hash — real move detection waits on tree-sitter roots.
    ops

# Real matcher over two STORED parse roots (Gap D).  Returns [] when either
# root is missing/degenerate or the size guard bails — callers treat [] as
# "fall back to the text-block path".
fn scv_structural_diff_from_roots(root: text, base_root_node: text, head_root_node: text, cfg: StructuralMatchConfig) -> [EditOp]:
    if base_root_node == "" or head_root_node == "":
        return []
    val base_kind = scv_node_kind(scv_load_node_fields(root, base_root_node))
    val head_kind = scv_node_kind(scv_load_node_fields(root, head_root_node))
    if base_kind == "" or base_kind == "line" or head_kind == "" or head_kind == "line":
        return []
    val pairs = scv_match_roots_bounded(root, base_root_node, head_root_node, cfg)
    if pairs.len() == 0:
        return []
    scv_edit_script_from_pairs(root, base_root_node, head_root_node, pairs)

# Diff entry used by diff.spl --structural mode: resolve stored roots for both
# content ids, then run the bounded matcher.  [] means "no stored root pair".
fn scv_structural_diff_ops_for_file(root: text, rel: text, base_raw: text, head_raw: text, cfg: StructuralMatchConfig) -> [EditOp]:
    val base_node = scv_syntax_root_for_content(root, rel, base_raw)
    if base_node == "":
        return []
    val head_node = scv_syntax_root_for_content(root, rel, head_raw)
    if head_node == "":
        return []
    scv_structural_diff_from_roots(root, base_node, head_node, cfg)

# ---------------------------------------------------------------------------
# Text-based structural block analysis
# Works on raw source text without requiring tree-sitter parse output.
# Identifies fn/class/struct/module definitions at column 0.
# ---------------------------------------------------------------------------

fn scv_find_char_pos(s: text, ch: text) -> i64:
    # Byte offset, matching the byte-indexed bracket slices at the call sites.
    # The previous loop bounded by len() (bytes) but probed char_at(i)
    # (characters), silently corrupting on multi-byte lines.
    s.index_of(ch)

fn scv_text_def_name(line: text) -> text:
    if line.len() == 0:
        return ""
    if line.char_at(0) == " " or line.char_at(0) == "\t":
        return ""
    if line.starts_with("fn "):
        val rest = line[3:]
        val pos = scv_find_char_pos(rest, "(")
        if pos > 0:
            return rest[0:pos].trim()
        return ""
    if line.starts_with("class "):
        val rest = line[6:]
        var end_pos = scv_find_char_pos(rest, ":")
        val ppos = scv_find_char_pos(rest, "(")
        if ppos >= 0 and (end_pos < 0 or ppos < end_pos):
            end_pos = ppos
        if end_pos > 0:
            return rest[0:end_pos].trim()
        if rest.trim().len() > 0:
            return rest.trim()
        return ""
    if line.starts_with("struct "):
        val rest = line[7:]
        val cpos = scv_find_char_pos(rest, ":")
        if cpos > 0:
            return rest[0:cpos].trim()
        if rest.trim().len() > 0:
            return rest.trim()
        return ""
    if line.starts_with("module "):
        val rest = line[7:]
        val cpos = scv_find_char_pos(rest, ":")
        if cpos > 0:
            return rest[0:cpos].trim()
        if rest.trim().len() > 0:
            return rest.trim()
        return ""
    ""

fn scv_text_block_names(content: text) -> [text]:
    var names: [text] = []
    for line in content.split("\n"):
        val name = scv_text_def_name(line)
        if name != "":
            var already = false
            for n in names:
                if n == name:
                    already = true
                    break
            if not already:
                names.push(name)
    names

fn scv_text_block_content(content: text, target: text) -> text:
    val lines = content.split("\n")
    var in_block = false
    var rows: [text] = []
    var i = 0
    while i < lines.len():
        val name = scv_text_def_name(lines[i])
        if name == target and not in_block:
            in_block = true
        elif name != "" and in_block:
            break
        if in_block:
            rows.push(lines[i])
        i = i + 1
    rows.join("\n")

fn scv_text_block_body(content: text, target: text) -> text:
    val full = scv_text_block_content(content, target)
    val lines = full.split("\n")
    if lines.len() <= 1:
        return ""
    var rows: [text] = []
    var i = 1
    while i < lines.len():
        rows.push(lines[i])
        i = i + 1
    rows.join("\n")

fn scv_normalize_block(content: text) -> text:
    val lines = content.split("\n")
    var end_idx = lines.len()
    while end_idx > 0 and lines[end_idx - 1].trim() == "":
        end_idx = end_idx - 1
    var rows: [text] = []
    var i = 0
    while i < end_idx:
        rows.push(lines[i])
        i = i + 1
    rows.join("\n")

fn scv_text_block_position(content: text, target: text) -> i64:
    var pos = 0
    for line in content.split("\n"):
        val name = scv_text_def_name(line)
        if name == target:
            return pos
        if name != "":
            pos = pos + 1
    -1

fn scv_text_preamble(content: text) -> text:
    var rows: [text] = []
    for line in content.split("\n"):
        val name = scv_text_def_name(line)
        if name != "":
            break
        rows.push(line)
    rows.join("\n")

fn scv_names_contain(names: [text], target: text) -> bool:
    for n in names:
        if n == target:
            return true
    false

fn scv_intra_block_moves(block_name: text, base_body: text, head_body: text) -> [EditOp]:
    var result: [EditOp] = []
    val base_lines = base_body.split("\n")
    val head_lines = head_body.split("\n")
    var base_idx = 0
    for bline in base_lines:
        val bt = bline.trim()
        if bt == "":
            base_idx = base_idx + 1
            continue
        var head_idx = 0
        for hline in head_lines:
            val ht = hline.trim()
            if ht == bt and base_idx != head_idx:
                result.push(scv_make_edit_op("move",
                    "{block_name}.stmt[{base_idx}]",
                    "{block_name}.stmt[{head_idx}]",
                    scv_ordinal_anchor(block_name, base_idx)))
                break
            head_idx = head_idx + 1
        base_idx = base_idx + 1
    result

fn scv_structural_diff_from_text(base_text: text, head_text: text, cfg: StructuralMatchConfig) -> [EditOp]:
    val base_names = scv_text_block_names(base_text)
    val head_names = scv_text_block_names(head_text)
    if base_names.len() == 0 and head_names.len() == 0:
        return []
    var result: [EditOp] = []
    var matched_head = ""
    for bname in base_names:
        if scv_names_contain(head_names, bname):
            matched_head = matched_head + bname + "\n"
            val bc = scv_normalize_block(scv_text_block_content(base_text, bname))
            val hc = scv_normalize_block(scv_text_block_content(head_text, bname))
            if bc == hc:
                val bp = scv_text_block_position(base_text, bname)
                val hp = scv_text_block_position(head_text, bname)
                if bp != hp:
                    result.push(scv_make_edit_op("move", bname, bname, scv_named_anchor(bname)))
            else:
                result.push(scv_make_edit_op("update", bname, bname, scv_named_anchor(bname)))
                val bb = scv_text_block_body(base_text, bname)
                val hb = scv_text_block_body(head_text, bname)
                val intra = scv_intra_block_moves(bname, bb, hb)
                for op in intra:
                    result.push(op)
        else:
            val bb = scv_text_block_body(base_text, bname)
            var renamed_to = ""
            for hname in head_names:
                if scv_line_set_contains(matched_head, hname):
                    continue
                val hb = scv_text_block_body(head_text, hname)
                if bb == hb and bb != "":
                    renamed_to = hname
                    break
            if renamed_to != "":
                matched_head = matched_head + renamed_to + "\n"
                result.push(scv_make_edit_op("update", bname, renamed_to, scv_named_anchor(bname)))
            else:
                result.push(scv_make_edit_op("delete", bname, "", scv_named_anchor(bname)))
    for hname in head_names:
        if not scv_line_set_contains(matched_head, hname):
            result.push(scv_make_edit_op("insert", "", hname, scv_named_anchor(hname)))
    result

fn scv_structural_merge_from_text(base_text: text, left_text: text, right_text: text) -> text:
    val base_names = scv_text_block_names(base_text)
    val left_names = scv_text_block_names(left_text)
    val right_names = scv_text_block_names(right_text)
    if base_names.len() == 0 and left_names.len() == 0 and right_names.len() == 0:
        return ""
    for bname in base_names:
        val bc = scv_normalize_block(scv_text_block_content(base_text, bname))
        if scv_names_contain(left_names, bname) and scv_names_contain(right_names, bname):
            val lc = scv_normalize_block(scv_text_block_content(left_text, bname))
            val rc = scv_normalize_block(scv_text_block_content(right_text, bname))
            if lc != bc and rc != bc:
                return ""
    var blocks: [text] = []
    var used_names: [text] = []
    for lname in left_names:
        used_names.push(lname)
        val lc = scv_normalize_block(scv_text_block_content(left_text, lname))
        val in_base = scv_names_contain(base_names, lname)
        var chosen = lc
        if in_base:
            val bc = scv_normalize_block(scv_text_block_content(base_text, lname))
            val left_changed = lc != bc
            val in_right = scv_names_contain(right_names, lname)
            if in_right:
                val rc = scv_normalize_block(scv_text_block_content(right_text, lname))
                val right_changed = rc != bc
                if right_changed and not left_changed:
                    chosen = rc
                elif right_changed and left_changed:
                    return ""
        blocks.push(chosen)
    for rname in right_names:
        if scv_names_contain(used_names, rname):
            continue
        val in_base = scv_names_contain(base_names, rname)
        if in_base:
            val bc = scv_normalize_block(scv_text_block_content(base_text, rname))
            val rc = scv_normalize_block(scv_text_block_content(right_text, rname))
            if rc != bc:
                return ""
            continue
        val rc = scv_text_block_content(right_text, rname)
        blocks.push(rc)
    val result = blocks.join("\n")
    if result != "":
        return result + "\n"
    result

# ---------------------------------------------------------------------------
# SCV-IMPL-D-01 completion — REAL parser roots from the P-05 CST root store.
#
# `diff --structural` first asks the P-05 root store (cst_ir.spl,
# {meta}/cst_roots/<revision>_<ContentId>.cst) for a `scv/cst/v1` document
# on BOTH sides of a file comparison.  Resolution is exact-key first
# (revision + ContentId); when the base side was stored under an earlier
# revision the store is scanned for `_<ContentId>.cst`, bounded by
# scv_cst_root_scan_cap().  Both resolved keys are reported in the diff
# provenance line so the "keyed by revision+ContentId" claim is verifiable.
#
# The matcher below works on CST NAMED nodes (declarations) with real labels,
# so — unlike the fallback-line syntax objects — it discriminates moves and
# renames, and it reports ambiguous candidates as `ambiguous` ops instead of
# guessing.
#
# HONEST SCOPE of the builder (`scv_cst_from_simple_source`): an INTERIM
# .spl structural builder over symbol_entity's declaration scanner — the
# same interim status as SCV-IMPL-I-03.  It produces real P-05 IR documents,
# not tree-sitter parses.
# TODO(SCV-IMPL-P-06/WS-A): populate the root store from query-pack parser
# roots; this builder is the interim producer until those land.
# ---------------------------------------------------------------------------

fn scv_cst_builder_version() -> text:
    "cst-spl-1"

# Bound on root-store entries examined when resolving a ContentId whose
# exact revision key is absent.
fn scv_cst_root_scan_cap() -> i64:
    4096

# Bottom-up rename candidates must beat the runner-up by this Dice margin
# (x1000) or the pair is reported `ambiguous`, never accepted.
fn scv_cst_ambiguity_margin_milli() -> i64:
    50

fn scv_cst_decl_field(row: text, index: i64) -> text:
    val parts = row.split("|")
    if index < parts.len():
        parts[index]
    else:
        ""

fn scv_cst_body_atoms(lines: [text], start_line: i64, end_line: i64) -> [text]:
    # 1-based inclusive line range -> one atom per non-empty trimmed line.
    var atoms: [text] = []
    var ln = start_line
    while ln <= end_line and ln <= lines.len():
        val t = lines[ln - 1].trim()
        if t != "":
            atoms.push(scv_cst_atom("line", t))
        ln = ln + 1
    atoms

fn scv_cst_is_container_kind(kind: text) -> bool:
    kind == "type" or kind == "enum" or kind == "trait"

# Build a `scv/cst/v1` document for Simple source: file(rel) -> named
# declaration nodes ("<kind> <qualified name>") each holding an ordered
# `body` list of line atoms; container declarations nest their members.
fn scv_cst_from_simple_source(rel: text, source: text) -> text:
    val lines = source.split("\n")
    val line_count = if lines.len() > 0 and lines[lines.len() - 1] == "": lines.len() - 1 else: lines.len()
    val decls = scv_symbol_extract_decls(source)
    var top: [text] = []
    var open_label = ""
    var open_name = ""
    var open_children: [text] = []
    val first_line = if decls.len() > 0: (scv_cst_decl_field(decls[0], 2).to_int() ?? 1) else: lines.len() + 1
    val preamble = scv_cst_body_atoms(lines, 1, first_line - 1)
    if preamble.len() > 0:
        top.push(scv_cst_named("preamble", [scv_cst_list("body", "ordered", preamble)]))
    var i = 0
    while i < decls.len():
        val kind = scv_cst_decl_field(decls[i], 0)
        val name = scv_cst_decl_field(decls[i], 1)
        val start = scv_cst_decl_field(decls[i], 2).to_int() ?? 1
        val container = scv_cst_decl_field(decls[i], 3)
        val end = if i + 1 < decls.len(): (scv_cst_decl_field(decls[i + 1], 2).to_int() ?? start) - 1 else: line_count
        val qname = if container != "": "{container}.{name}" else: name
        val node = scv_cst_named("{kind} {qname}", [scv_cst_list("body", "ordered", scv_cst_body_atoms(lines, start, end))])
        if container != "" and container == open_name:
            open_children.push(node)
        else:
            if open_label != "":
                top.push(scv_cst_named(open_label, open_children))
                open_label = ""
                open_name = ""
                open_children = []
            if scv_cst_is_container_kind(kind):
                open_label = "{kind} {qname}"
                open_name = name
                open_children = [scv_cst_list("body", "ordered", scv_cst_body_atoms(lines, start, end))]
            else:
                top.push(node)
        i = i + 1
    if open_label != "":
        top.push(scv_cst_named(open_label, open_children))
    scv_cst_document(scv_cst_file(rel, top))

fn scv_cst_current_revision(root: text) -> text:
    val head = scv_head_path(root)
    if file_exists(head):
        val rev = file_read(head).trim()
        if rev != "":
            return rev
    "none"

# `scv cst-store <path>`: build the interim CST for a working-copy file and
# store it in the P-05 root store keyed by (current revision, ContentId).
fn scv_cst_store_file(root: text, rel: text) -> text:
    val path = "{root}/{rel}"
    if not file_exists(path):
        return "ERROR cst-store: no such file {rel}\n"
    val content_id = scv_content_id_for_file(path)
    val revision = scv_cst_current_revision(root)
    val doc = scv_cst_from_simple_source(rel, file_read(path))
    val stored = scv_cst_root_store(root, revision, content_id, doc)
    if stored.starts_with("ERROR"):
        return stored
    "{stored}builder={scv_cst_builder_version()} rel={rel}\n"

# Resolve a stored CST root for (revision, ContentId).  Returns (doc, key);
# ("", "") when nothing is stored.  Exact key first; then a bounded scan of
# the root store for the same ContentId under any revision.
fn scv_cst_root_resolve(root: text, revision: text, content_id: text) -> (text, text):
    if content_id == "":
        return ("", "")
    val exact = scv_cst_root_load(root, revision, content_id)
    if exact != "":
        return (exact, scv_cst_root_key(revision, content_id))
    val dir = scv_cst_roots_dir(root)
    if not file_exists(dir):
        return ("", "")
    val suffix = "_{content_id}.cst"
    var scanned = 0
    for path in dir_walk(dir):
        if scanned >= scv_cst_root_scan_cap():
            return ("", "")
        scanned = scanned + 1
        if not path.ends_with(suffix):
            continue
        val parts = path.split("/")
        val base = parts[parts.len() - 1]
        val rev = base[0:base.len() - suffix.len()]
        val doc = scv_cst_root_load(root, rev, content_id)
        if doc != "":
            return (doc, scv_cst_root_key(rev, content_id))
    ("", "")

# --- flattened CST named nodes -------------------------------------------

struct CstDeclNode:
    id: text        # path id "0/2"
    parent: text    # parent named-node label ("" at file level)
    ordinal: i64    # index among named siblings
    label: text     # "<kind> <qname>"
    kind: text      # first word of label
    hash: text      # scv_cst_hash of the subtree
    atoms: [text]   # descendant atom values (for Dice)

fn scv_cst_atom_values_rec(node: text, acc: [text]) -> [text]:
    var out = acc
    if scv_cst_kind(node) == "atom":
        out.push(scv_cst_value(node))
        return out
    for child in scv_cst_children(node):
        out = scv_cst_atom_values_rec(child, out)
    out

fn scv_cst_label_kind(label: text) -> text:
    val idx = label.index_of(" ")
    if idx < 0:
        label
    else:
        label[0:idx]

fn scv_cst_flatten_rec(node: text, id: text, parent: text, acc: [CstDeclNode]) -> [CstDeclNode]:
    var out = acc
    var ordinal = 0
    var child_i = 0
    for child in scv_cst_children(node):
        val child_id = "{id}/{child_i}"
        child_i = child_i + 1
        val ck = scv_cst_kind(child)
        if ck == "named":
            val label = scv_cst_label(child)
            out.push(CstDeclNode(id: child_id, parent: parent, ordinal: ordinal, label: label, kind: scv_cst_label_kind(label), hash: scv_cst_hash(child), atoms: scv_cst_atom_values_rec(child, [])))
            ordinal = ordinal + 1
            out = scv_cst_flatten_rec(child, child_id, label, out)
        elif ck == "list" or ck == "file":
            out = scv_cst_flatten_rec(child, child_id, parent, out)
    out

fn scv_cst_flatten_doc(doc: text) -> [CstDeclNode]:
    val node = scv_cst_document_node(doc)
    if node == "":
        return []
    scv_cst_flatten_rec(node, "0", "", [])

fn scv_cst_count_hash(nodes: [CstDeclNode], hash: text) -> i64:
    var n = 0
    for node in nodes:
        if node.hash == hash:
            n = n + 1
    n

fn scv_cst_count_label(nodes: [CstDeclNode], label: text) -> i64:
    var n = 0
    for node in nodes:
        if node.label == label:
            n = n + 1
    n

fn scv_cst_find_label(nodes: [CstDeclNode], label: text) -> i64:
    var i = 0
    while i < nodes.len():
        if nodes[i].label == label:
            return i
        i = i + 1
    -1

fn scv_cst_find_hash(nodes: [CstDeclNode], hash: text) -> i64:
    var i = 0
    while i < nodes.len():
        if nodes[i].hash == hash:
            return i
        i = i + 1
    -1

fn scv_cst_index_used(used: [i64], idx: i64) -> bool:
    for u in used:
        if u == idx:
            return true
    false

# Match named nodes of two CST documents.  Returns (pairs, ambiguous) where
# pairs are (base_index, head_index) and ambiguous lists base indexes whose
# best rename candidate tied within scv_cst_ambiguity_margin_milli().
#   stage 1: identical subtree hash, unique on both sides
#   stage 2: identical label, unique on both sides (edited in place)
#   stage 3: bottom-up Dice over line atoms among unmatched nodes of the
#            same declaration kind, capped at scv_match_candidate_cap()
fn scv_cst_match_nodes(base: [CstDeclNode], head: [CstDeclNode], cfg: StructuralMatchConfig) -> ([(i64, i64)], [i64]):
    var pairs: [(i64, i64)] = []
    var used_base: [i64] = []
    var used_head: [i64] = []
    var ambiguous: [i64] = []
    var bi = 0
    while bi < base.len():
        val h = base[bi].hash
        if scv_cst_count_hash(base, h) == 1 and scv_cst_count_hash(head, h) == 1:
            val hi = scv_cst_find_hash(head, h)
            pairs.push((bi, hi))
            used_base.push(bi)
            used_head.push(hi)
        bi = bi + 1
    bi = 0
    while bi < base.len():
        if not scv_cst_index_used(used_base, bi):
            val label = base[bi].label
            if scv_cst_count_label(base, label) == 1 and scv_cst_count_label(head, label) == 1:
                val hi = scv_cst_find_label(head, label)
                if not scv_cst_index_used(used_head, hi):
                    pairs.push((bi, hi))
                    used_base.push(bi)
                    used_head.push(hi)
        bi = bi + 1
    bi = 0
    while bi < base.len():
        if scv_cst_index_used(used_base, bi):
            bi = bi + 1
            continue
        var best = -1
        var best_score = 0
        var second = 0
        var examined = 0
        var hi = 0
        while hi < head.len():
            if examined >= scv_match_candidate_cap():
                break
            if not scv_cst_index_used(used_head, hi) and head[hi].kind == base[bi].kind:
                examined = examined + 1
                val score = scv_dice_similarity(base[bi].atoms, head[hi].atoms)
                if score > best_score:
                    second = best_score
                    best_score = score
                    best = hi
                elif score > second:
                    second = score
            hi = hi + 1
        if best >= 0 and best_score >= cfg.min_dice:
            if best_score - second < scv_cst_ambiguity_margin_milli():
                ambiguous.push(bi)
            else:
                pairs.push((bi, best))
                used_base.push(bi)
                used_head.push(best)
        bi = bi + 1
    (pairs, ambiguous)

fn scv_cst_pairs_has_head(pairs: [(i64, i64)], hi: i64) -> bool:
    for pair in pairs:
        val (_, h) = pair
        if h == hi:
            return true
    false

fn scv_cst_pairs_has_base(pairs: [(i64, i64)], bi: i64) -> bool:
    for pair in pairs:
        val (b, _) = pair
        if b == bi:
            return true
    false

# Edit script over two CST documents.  Op kinds: insert / delete / update /
# move / rename / ambiguous.  Rename anchors read "old -> new".
fn scv_structural_diff_from_cst(base_doc: text, head_doc: text, cfg: StructuralMatchConfig) -> [EditOp]:
    val base = scv_cst_flatten_doc(base_doc)
    val head = scv_cst_flatten_doc(head_doc)
    val (pairs, ambiguous) = scv_cst_match_nodes(base, head, cfg)
    var ops: [EditOp] = []
    for pair in pairs:
        val (bi, hi) = pair
        val b = base[bi]
        val h = head[hi]
        if b.label != h.label:
            ops.push(scv_make_edit_op("rename", b.id, h.id, scv_named_anchor("{b.label} -> {h.label}")))
        elif b.hash != h.hash:
            ops.push(scv_make_edit_op("update", b.id, h.id, scv_named_anchor(b.label)))
        if b.parent == h.parent and b.ordinal != h.ordinal:
            ops.push(scv_make_edit_op("move", b.id, h.id, scv_named_anchor(h.label)))
        elif b.parent != h.parent:
            ops.push(scv_make_edit_op("move", b.id, h.id, scv_named_anchor("{b.label} -> {h.parent}")))
    for bi in ambiguous:
        ops.push(scv_make_edit_op("ambiguous", base[bi].id, "", scv_named_anchor(base[bi].label)))
    var i = 0
    while i < base.len():
        if not scv_cst_pairs_has_base(pairs, i) and not scv_cst_index_used(ambiguous, i):
            ops.push(scv_make_edit_op("delete", base[i].id, "", scv_named_anchor(base[i].label)))
        i = i + 1
    i = 0
    while i < head.len():
        if not scv_cst_pairs_has_head(pairs, i):
            ops.push(scv_make_edit_op("insert", "", head[i].id, scv_named_anchor(head[i].label)))
        i = i + 1
    ops

# Diff entry for diff.spl: resolve BOTH roots from the P-05 store, run the
# CST matcher.  Returns (ops, provenance); provenance is "" when either root
# is missing (caller falls through to syntax-roots / text-blocks).
fn scv_cst_diff_ops_for_file(root: text, base_content_id: text, head_content_id: text, cfg: StructuralMatchConfig) -> ([EditOp], text):
    val revision = scv_cst_current_revision(root)
    val (base_doc, base_key) = scv_cst_root_resolve(root, revision, base_content_id)
    if base_doc == "":
        return ([], "")
    val (head_doc, head_key) = scv_cst_root_resolve(root, revision, head_content_id)
    if head_doc == "":
        return ([], "")
    (scv_structural_diff_from_cst(base_doc, head_doc, cfg), "base={base_key} head={head_key}")
