# SCV-IMPL-D-04 — identity-aware merge support.
#
# Resolves "which logical file is this path" per COMMIT using the persistent
# FileEntityId store (identity.spl) so a three-way merge can pair a rename on
# one side with an edit on the other by EntityId instead of by path or by an
# exact-chunk coincidence.
#
# Why per commit: the identity store is linear (one current_path per id), so
# after `restore-op` to a base and a snapshot on a second side, the store
# happily allocates a fresh id for a path the first side renamed. A merge
# must therefore reconstruct the path->id map AT each of base/left/right by
# walking the first-parent chain and replaying, per commit, the accepted
# move edges and creates recorded for that commit. Maps are derived in
# memory per merge invocation; nothing new is persisted.
#
# Resolution rules per commit C (parent map M):
#   kept path        -> M[path]                       (edits keep identity)
#   added path       -> id X accepted-moved/created AT C whose current_path is
#                       that path and that has no later accepted move; else the
#                       single-unclaimed-path rule; else UNRESOLVED (path-based
#                       fallback in merge.spl — never a guess)
#
# Groups handed to merge.spl (tab-separated rows):
#   kind \t entity \t target_path \t consumed_paths(,) \t base_line \t left_line \t right_line
#   kind: rename_edit | rename_rename | rename_delete
#
# TODO(I-04): once lane C's refactoring-relations API lands, consume its
# accepted rename relations here instead of the raw identity edge log.

use app.io.mod (file_exists, file_read)
use std.scv.core.{scv_object_path, scv_line_set_contains}
use std.scv.store.{scv_commit_tree, scv_commit_parents}
use std.scv.identity.{scv_identity_rows_path, scv_identity_edges_path, scv_identity_current_path}

fn scv_idm_tree_payload(root: text, commit: text) -> text:
    val tree = scv_commit_tree(root, commit)
    if tree == "":
        return ""
    val path = scv_object_path(root, "trees", tree)
    if file_exists(path):
        file_read(path)
    else:
        ""

fn scv_idm_tree_paths(payload: text) -> [text]:
    var out: [text] = []
    for line in payload.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parts = trimmed.split("|")
        if parts.len() > 0 and parts[0] != "":
            out.push(parts[0])
    out

fn scv_idm_tree_line(payload: text, rel: text) -> text:
    for line in payload.split("\n"):
        if line.starts_with("{rel}|"):
            return line.trim()
    ""

fn scv_idm_line_chunk(line: text) -> text:
    val parts = line.split("|")
    if parts.len() >= 3:
        parts[2]
    else:
        ""

fn scv_idm_list_has(items: [text], value: text) -> bool:
    for item in items:
        if item == value:
            return true
    false

fn scv_idm_first_parent(root: text, commit: text) -> text:
    val parents = scv_commit_parents(root, commit)
    if parents.len() == 0:
        return ""
    val first = parents[0].split(",")
    if first.len() == 0:
        return ""
    first[0].trim()

# --- map helpers (rows "rel|file_id\n") ------------------------------------

fn scv_idm_map_get(map: text, rel: text) -> text:
    for row in map.split("\n"):
        if row.starts_with("{rel}|"):
            return row[rel.len() + 1:]
    ""

fn scv_idm_map_path_of(map: text, id: text) -> text:
    for row in map.split("\n"):
        if row.ends_with("|{id}"):
            return row[0:row.len() - id.len() - 1]
    ""

# --- identity store readers -----------------------------------------------

fn scv_idm_lines(path: text) -> [text]:
    if not file_exists(path):
        return []
    var out: [text] = []
    for line in file_read(path).split("\n"):
        val trimmed = line.trim()
        if trimmed != "":
            out.push(trimmed)
    out

fn scv_idm_field(row: text, index: i64) -> text:
    val parts = row.split("|")
    if index < parts.len():
        parts[index]
    else:
        ""

# ids created at `commit` (identity rows: file_id|current_path|created_commit|origin|state)
fn scv_idm_created_at(rows: [text], commit: text) -> [text]:
    var out: [text] = []
    for row in rows:
        if scv_idm_field(row, 2) == commit:
            out.push(scv_idm_field(row, 0))
    out

fn scv_idm_edge_is_accepted_move(edge: text) -> bool:
    val relation = scv_idm_field(edge, 2)
    (relation == "move" or relation == "move_edit") and scv_idm_field(edge, 7) == "accepted"

# ids with an ACCEPTED move edge recorded at `commit`
fn scv_idm_moved_at(edges: [text], commit: text) -> [text]:
    var out: [text] = []
    for edge in edges:
        if scv_idm_field(edge, 3) == commit and scv_idm_edge_is_accepted_move(edge):
            val id = scv_idm_field(edge, 0)
            if not scv_idm_list_has(out, id):
                out.push(id)
    out

# True when `id` has an accepted move edge AFTER its edge at `commit` in the
# append-only log (log order is time order): its current_path is then not its
# path at `commit`.
fn scv_idm_moved_later(edges: [text], id: text, commit: text) -> bool:
    var seen_at_commit = false
    for edge in edges:
        if scv_idm_field(edge, 0) != id:
            continue
        if seen_at_commit and scv_idm_edge_is_accepted_move(edge):
            return true
        if scv_idm_field(edge, 3) == commit:
            seen_at_commit = true
    false

# --- per-commit derivation --------------------------------------------------

fn scv_idm_derive(root: text, rows: [text], edges: [text], parent_map: text, parent_payload: text, payload: text, commit: text) -> text:
    val paths = scv_idm_tree_paths(payload)
    val parent_paths = scv_idm_tree_paths(parent_payload)
    var map = ""
    var added: [text] = []
    for rel in paths:
        if scv_idm_list_has(parent_paths, rel):
            val id = scv_idm_map_get(parent_map, rel)
            if id != "":
                map = map + "{rel}|{id}\n"
        else:
            added.push(rel)
    if added.len() == 0:
        return map
    var candidates: [text] = []
    for id in scv_idm_moved_at(edges, commit):
        # a move's source must have vanished from the parent tree
        val from = scv_idm_map_path_of(parent_map, id)
        if from == "" or scv_idm_list_has(paths, from):
            continue
        candidates.push(id)
    for id in scv_idm_created_at(rows, commit):
        if not scv_idm_list_has(candidates, id):
            candidates.push(id)
    var claimed: [text] = []
    var placed: [text] = []
    # pass 1: current_path is authoritative when no later accepted move exists
    for id in candidates:
        if scv_idm_moved_later(edges, id, commit):
            continue
        val cur = scv_identity_current_path(root, id)
        if scv_idm_list_has(added, cur) and not scv_idm_list_has(claimed, cur):
            map = map + "{cur}|{id}\n"
            claimed.push(cur)
            placed.push(id)
    # pass 2: exactly one unclaimed added path and one unplaced candidate
    var unclaimed: [text] = []
    for rel in added:
        if not scv_idm_list_has(claimed, rel):
            unclaimed.push(rel)
    var unplaced: [text] = []
    for id in candidates:
        if not scv_idm_list_has(placed, id):
            unplaced.push(id)
    if unclaimed.len() == 1 and unplaced.len() == 1:
        map = map + "{unclaimed[0]}|{unplaced[0]}\n"
    map

# Path -> FileEntityId map at `commit` ("rel|file_id" rows, "" when unknown).
fn scv_identity_map_at_commit(root: text, commit: text) -> text:
    val rows = scv_idm_lines(scv_identity_rows_path(root))
    val edges = scv_idm_lines(scv_identity_edges_path(root))
    if rows.len() == 0:
        return ""
    # first-parent chain, iterative, root-most first
    var chain: [text] = []
    var cur = commit
    var guard = 0
    while cur != "" and guard < 100000:
        if scv_idm_list_has(chain, cur):
            break
        chain.push(cur)
        cur = scv_idm_first_parent(root, cur)
        guard = guard + 1
    var map = ""
    var parent_payload = ""
    var i = chain.len() - 1
    while i >= 0:
        val payload = scv_idm_tree_payload(root, chain[i])
        map = scv_idm_derive(root, rows, edges, map, parent_payload, payload, chain[i])
        parent_payload = payload
        i = i - 1
    map

# Entity-level groups the path-based merge cannot resolve. Only renames whose
# other side also changed (or vanished) are claimed; exact-content renames and
# plain edits stay on the landed chunk/path logic so their strategy labels are
# untouched.
fn scv_identity_merge_groups(root: text, base_commit: text, left_commit: text, right_commit: text) -> [text]:
    var out: [text] = []
    val base_payload = scv_idm_tree_payload(root, base_commit)
    if base_payload == "":
        return out
    val base_map = scv_identity_map_at_commit(root, base_commit)
    if base_map == "":
        return out
    val left_map = scv_identity_map_at_commit(root, left_commit)
    val right_map = scv_identity_map_at_commit(root, right_commit)
    val left_payload = scv_idm_tree_payload(root, left_commit)
    val right_payload = scv_idm_tree_payload(root, right_commit)
    for row in base_map.split("\n"):
        if row == "":
            continue
        val parts = row.split("|")
        if parts.len() != 2:
            continue
        val pb = parts[0]
        val entity = parts[1]
        val pl = scv_idm_map_path_of(left_map, entity)
        val pr = scv_idm_map_path_of(right_map, entity)
        val left_renamed = pl != "" and pl != pb
        val right_renamed = pr != "" and pr != pb
        if not left_renamed and not right_renamed:
            continue
        val bl = scv_idm_tree_line(base_payload, pb)
        val ll = if pl != "": scv_idm_tree_line(left_payload, pl) else: ""
        val rl = if pr != "": scv_idm_tree_line(right_payload, pr) else: ""
        val bc = scv_idm_line_chunk(bl)
        if left_renamed and right_renamed:
            if pl != pr:
                out.push("rename_rename\t{entity}\t{pl}\t{pb},{pl},{pr}\t{bl}\t{ll}\t{rl}")
            continue
        if left_renamed:
            if pr == "":
                out.push("rename_delete\t{entity}\t{pl}\t{pb},{pl}\t{bl}\t{ll}\t{rl}")
            elif scv_idm_line_chunk(ll) != bc and scv_idm_line_chunk(rl) != bc:
                out.push("rename_edit\t{entity}\t{pl}\t{pb},{pl}\t{bl}\t{ll}\t{rl}")
            continue
        if pl == "":
            out.push("rename_delete\t{entity}\t{pr}\t{pb},{pr}\t{bl}\t{ll}\t{rl}")
        elif scv_idm_line_chunk(rl) != bc and scv_idm_line_chunk(ll) != bc:
            out.push("rename_edit\t{entity}\t{pr}\t{pb},{pr}\t{bl}\t{ll}\t{rl}")
    out

export scv_identity_map_at_commit, scv_identity_merge_groups
