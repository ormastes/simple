# Diagnostic counters are invocation-owned, never cache/admission authority.
# Allocate before entering any per-file transient scope; update scalar fields only.
use std.nogc_sync_mut.sffi.time.{time_monotonic_ns}

class ScvCompileCostV1:
    exists_calls: i64 = 0
    exists_ns: i64 = 0
    read_calls: i64 = 0
    read_ns: i64 = 0
    read_bytes: i64 = 0
    event_calls: i64 = 0
    event_ns: i64 = 0
    hash_calls: i64 = 0
    hash_ns: i64 = 0
    materialize_calls: i64 = 0
    materialize_ns: i64 = 0
    copy_calls: i64 = 0
    copy_ns: i64 = 0
    verify_calls: i64 = 0
    verify_ns: i64 = 0
    inventory_ns: i64 = 0
    snapshot_ns: i64 = 0
    lock_released: bool = true
    emitted: bool = false

    me record_exists(elapsed: i64):
        self.exists_calls = self.exists_calls + 1
        self.exists_ns = self.exists_ns + elapsed

    me record_read(elapsed: i64, bytes: i64):
        self.read_calls = self.read_calls + 1
        self.read_ns = self.read_ns + elapsed
        self.read_bytes = self.read_bytes + bytes

    me record_event(elapsed: i64):
        self.event_calls = self.event_calls + 1
        self.event_ns = self.event_ns + elapsed

    me record_hash(elapsed: i64):
        self.hash_calls = self.hash_calls + 1
        self.hash_ns = self.hash_ns + elapsed

    me record_materialize(elapsed: i64):
        self.materialize_calls = self.materialize_calls + 1
        self.materialize_ns = self.materialize_ns + elapsed

    me record_copy(elapsed: i64):
        self.copy_calls = self.copy_calls + 1
        self.copy_ns = self.copy_ns + elapsed

    me record_verify(elapsed: i64):
        self.verify_calls = self.verify_calls + 1
        self.verify_ns = self.verify_ns + elapsed

fn scv_cost_now_v1(cost: ScvCompileCostV1?) -> i64:
    # Disabled instrumentation must not query the clock.
    if cost == nil: 0 else: time_monotonic_ns()

fn scv_cost_elapsed_v1(cost: ScvCompileCostV1?, started: i64) -> i64:
    if cost == nil: return 0
    # The runtime reports unavailable monotonic samples as a negative value.
    # Ignore those intervals instead of interpreting uptime as elapsed work.
    if started < 0: return 0
    val ended = time_monotonic_ns()
    if ended < 0: return 0
    if ended >= started: ended - started else: 0

export ScvCompileCostV1, scv_cost_now_v1, scv_cost_elapsed_v1
