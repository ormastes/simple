# SCV-IMPL-D-07 — typed conflict objects v2.
#
# Conflicts stay DATA (jj remains the conflict-storage authority). v2 objects
# live in a SEPARATE store, `objects/conflicts_v2`, so the v1 payloads and the
# `$SCV conflicts` listing stay byte-stable (the D-04 spec pins them). A v2
# object carries:
#   schema:     scv/conflict/v2
#   path:       worktree-relative file
#   kind:       content_overlap | signature_conflict |
#               entity_identity_ambiguous | entity_rename_delete |
#               parser_disagreement | preprocessor_region_divergent
#   entities:   comma-joined FileEntityIds ("" when unattributed)
#   parser:     the parser identity whose regions/nodes the merge reasoned on
#   base/left/right: the node sides (tree lines) as the merge saw them
#   attempted:  comma-joined merge algorithms tried before conflicting
#   diagnostics: free-text explanation (honest about store ceilings)
#   time_ms
#
# Kind notes:
#   entity_identity_ambiguous — the D-04 rename-vs-rename ceiling named
#     properly: the linear identity store attributes only ONE accepted rename
#     per EntityId, so the second rename surfaces as an unattributed added
#     path on the "deleting" side. merge.spl detects that added path and
#     emits this kind (v1 keeps its store's-eye `entity_rename_delete` label).
#   parser_disagreement — two parser identities disagreeing about the same
#     bytes. Reachable by CONSTRUCTION only today: no merge path runs two
#     parsers over one file yet (single builtin text-block parser), so no
#     merge emits it; the kind exists so the ladder can record it the day a
#     second parser identity lands. Stated here rather than papered over.
#   preprocessor_region_divergent — the two sides edited the CONDITION and the
#     guarded BODY of the same C preprocessor construct, or edited bodies in two
#     mutually exclusive arms of it, or combined a rename with a guard rewrite.
#     Textually disjoint, semantically exclusive: the line/syntax-node rungs
#     merged these clean, producing a configuration neither side authored. NOT
#     `parser_disagreement` — one parser, no disagreement about the bytes; the
#     merger simply had no region model. See preprocessor_regions.spl (and
#     `doc/08_tracking/bug/scv_merge_silently_merges_across_divergent_preprocessor_branches_2026-08-26.md`)
#     for the detector's honest lexical-only ceiling.

use app.io.mod (file_exists, file_read, dir_walk)
use std.nogc_sync_mut.io.time_ops.{current_time_ms}
use std.scv.core.{scv_object_path}
use std.scv.store.{scv_hash_text, scv_write_text}
use std.scv.structural_match.{scv_text_block_names, scv_text_block_content}

fn scv_conflict_v2_version() -> text:
    "scv/conflict/v2"

fn scv_conflict_v2_parser_identity() -> text:
    "scv-text-blocks/v1"

fn scv_conflict_v2_kinds() -> [text]:
    ["content_overlap", "signature_conflict", "entity_identity_ambiguous", "entity_rename_delete", "parser_disagreement", "preprocessor_region_divergent"]

fn scv_conflict_v2_kind_valid(kind: text) -> bool:
    for k in scv_conflict_v2_kinds():
        if k == kind:
            return true
    false

# Returns "" for an unknown kind — a conflict is never stored mislabeled.
fn scv_conflict_v2_payload(rel: text, kind: text, entities: text, base_line: text, left_line: text, right_line: text, attempted: text, diagnostics: text) -> text:
    if not scv_conflict_v2_kind_valid(kind):
        return ""
    "schema: {scv_conflict_v2_version()}\npath: {rel}\nkind: {kind}\nentities: {entities}\nparser: {scv_conflict_v2_parser_identity()}\nbase: {base_line}\nleft: {left_line}\nright: {right_line}\nattempted: {attempted}\ndiagnostics: {diagnostics}\ntime_ms: {current_time_ms()}\n"

fn scv_conflict_v2_field(payload: text, key: text) -> text:
    for line in payload.split("\n"):
        if line.starts_with("{key}: "):
            return line[key.len() + 2:]
    ""

fn scv_conflict_v2_write(root: text, payload: text) -> text:
    if payload == "":
        return ""
    val id = scv_hash_text("conflict_v2", payload)
    scv_write_text(scv_object_path(root, "conflicts_v2", id), payload)
    id

fn scv_conflict_v2_list(root: text) -> text:
    val dir = "{root}/.scv/objects/conflicts_v2"
    if not file_exists(dir):
        return "no v2 conflicts\n"
    var rows: [text] = []
    for path in dir_walk(dir):
        val parts = path.split("/")
        rows.push("{parts[parts.len() - 1]}: {file_read(path)}")
    val out = rows.join("")
    if out == "":
        "no v2 conflicts\n"
    else:
        out

# Content-conflict classification over the region parser's view: when a block
# present on all three sides has its SIGNATURE line (the block's first line)
# changed on BOTH sides to different texts, the conflict is signature-level;
# otherwise it is a plain content overlap.
fn scv_conflict_v2_classify(base_text: text, left_text: text, right_text: text) -> text:
    for name in scv_text_block_names(base_text):
        val bsig = scv_text_block_content(base_text, name).split("\n")[0]
        val lblock = scv_text_block_content(left_text, name)
        val rblock = scv_text_block_content(right_text, name)
        if lblock == "" or rblock == "":
            continue
        val lsig = lblock.split("\n")[0]
        val rsig = rblock.split("\n")[0]
        if lsig != bsig and rsig != bsig and lsig != rsig:
            return "signature_conflict"
    "content_overlap"

export scv_conflict_v2_version, scv_conflict_v2_parser_identity, scv_conflict_v2_kinds, scv_conflict_v2_kind_valid
export scv_conflict_v2_payload, scv_conflict_v2_field, scv_conflict_v2_write, scv_conflict_v2_list
export scv_conflict_v2_classify
