# codex-impl
# Bounded, evidence-driven review escalation DAG admission.

use std.common.crypto.sha256.{sha256_text}
use std.scv.lifecycle.model.{LifecycleResult, lifecycle_ok, lifecycle_error}

struct ReviewRoutePolicy:
    max_model_depth: i64
    max_children_per_run: i64
    terminal_high_or_critical_human: bool

struct ReviewEscalationRequest:
    parent_run_id: text
    reviewer: text
    depth: i64
    existing_child_count: i64
    question: text
    prior_question_fingerprints: [text]
    severity: text
    missing_evidence: text

fn review_question_fingerprint(question: text) -> text:
    sha256_text(question.trim().to_lower())

fn review_escalation_admit(policy: ReviewRoutePolicy, request: ReviewEscalationRequest) -> LifecycleResult:
    if request.parent_run_id == "" or request.reviewer == "" or request.question.trim() == "":
        return lifecycle_error("REVIEW_ESCALATION_INPUT", "parent, reviewer, and concrete unresolved question are required")
    if request.missing_evidence.trim() == "":
        return lifecycle_error("REVIEW_ESCALATION_EVIDENCE", "escalation must name missing or disputed evidence")
    if request.depth >= policy.max_model_depth:
        if policy.terminal_high_or_critical_human and (request.severity == "high" or request.severity == "critical"):
            return lifecycle_ok("human_required", request.parent_run_id)
        return lifecycle_error("REVIEW_ESCALATION_DEPTH", "model escalation depth is exhausted")
    if request.existing_child_count >= policy.max_children_per_run:
        return lifecycle_error("REVIEW_ESCALATION_FANOUT", "review escalation fan-out is exhausted")
    if request.prior_question_fingerprints.contains(review_question_fingerprint(request.question)):
        return lifecycle_error("REVIEW_ESCALATION_CYCLE", "the unresolved question already exists in this review path")
    lifecycle_ok("model_escalation_admitted", request.parent_run_id)

export ReviewRoutePolicy, ReviewEscalationRequest, review_question_fingerprint, review_escalation_admit
