# codex-impl
# Typed projections between lifecycle value objects and digest-bound records.

use std.scv.lifecycle.model.{RevisionAliases, ChangeIdentity, RevisionIdentity, ReviewSession, ReviewRun, SourceAnchor, Finding, Approval, GateRun, GateBundle, RemoteBinding, SyncConflict, Feature, LifecycleRun, OperationAudit, Task, Publication, ReleaseCandidate, ReleaseLine, ReleaseIdentity}
use std.scv.lifecycle.codec.{LifecycleRecord, lifecycle_record}

fn _field(key: text, value: text) -> text:
    key + "=" + value

fn _has(record: LifecycleRecord, key: text) -> bool:
    val prefix = key + "="
    for field in record.fields:
        if field.starts_with(prefix):
            return true
    false

fn _get(record: LifecycleRecord, key: text) -> text:
    val prefix = key + "="
    for field in record.fields:
        if field.starts_with(prefix):
            return field[prefix.len():]
    ""

fn _all(record: LifecycleRecord, key: text) -> [text]:
    val prefix = key + "[]="
    var values: [text] = []
    for field in record.fields:
        if field.starts_with(prefix):
            values.push(field[prefix.len():])
    values

fn _typed(record: LifecycleRecord, kind: text) -> bool:
    record.schema == "scv-lifecycle/1" and record.kind == kind and record.entity_id != "" and lifecycle_record(record.kind, record.entity_id, record.fields).digest == record.digest

fn _required(record: LifecycleRecord, keys: [text]) -> bool:
    for key in keys:
        if not _has(record, key):
            return false
    true

fn _keys_valid(record: LifecycleRecord, scalar_keys: [text], array_keys: [text]) -> bool:
    var seen_scalars: [text] = []
    for field in record.fields:
        val idx = field.index_of("=")
        if idx <= 0:
            return false
        val key = field[0:idx]
        if key.ends_with("[]"):
            val base = key[0:key.len() - 2]
            if not array_keys.contains(base):
                return false
        else:
            if not scalar_keys.contains(key) or seen_scalars.contains(key):
                return false
            seen_scalars.push(key)
    true

fn _typed_fields(record: LifecycleRecord, kind: text, scalar_keys: [text], array_keys: [text]) -> bool:
    _typed(record, kind) and _required(record, scalar_keys) and _keys_valid(record, scalar_keys, array_keys)

fn _add_all(fields: [text], key: text, values: [text]):
    for value in values:
        fields.push(_field(key + "[]", value))

fn change_record(value: ChangeIdentity) -> LifecycleRecord:
    lifecycle_record("change", value.change_id, [_field("title", value.title), _field("intent_digest", value.intent_digest), _field("owner", value.owner)])

fn change_from_record(record: LifecycleRecord) -> ChangeIdentity?:
    if not _typed_fields(record, "change", ["title", "intent_digest", "owner"], []):
        return nil
    ChangeIdentity(change_id: record.entity_id, title: _get(record, "title"), intent_digest: _get(record, "intent_digest"), owner: _get(record, "owner"))

fn revision_record(value: RevisionIdentity) -> LifecycleRecord:
    var fields = [_field("change_id", value.change_id), _field("tree_id", value.tree_id), _field("metadata_digest", value.metadata_digest), _field("jj_change_id", value.aliases.jj_change_id), _field("jj_commit_id", value.aliases.jj_commit_id), _field("git_oid", value.aliases.git_oid)]
    _add_all(fields, "parent_revision_ids", value.parent_revision_ids)
    _add_all(fields, "provider_patchsets", value.aliases.provider_patchsets)
    lifecycle_record("revision", value.revision_id, fields)

fn revision_from_record(record: LifecycleRecord) -> RevisionIdentity?:
    if not _typed_fields(record, "revision", ["change_id", "tree_id", "metadata_digest", "jj_change_id", "jj_commit_id", "git_oid"], ["parent_revision_ids", "provider_patchsets"]):
        return nil
    val aliases = RevisionAliases(jj_change_id: _get(record, "jj_change_id"), jj_commit_id: _get(record, "jj_commit_id"), git_oid: _get(record, "git_oid"), provider_patchsets: _all(record, "provider_patchsets"))
    RevisionIdentity(revision_id: record.entity_id, change_id: _get(record, "change_id"), tree_id: _get(record, "tree_id"), parent_revision_ids: _all(record, "parent_revision_ids"), metadata_digest: _get(record, "metadata_digest"), aliases: aliases)

