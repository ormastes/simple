    lifecycle_record("approval", value.approval_id, [_field("review_id", value.review_id), _field("revision_id", value.revision_id), _field("tree_digest", value.tree_digest), _field("reviewer", value.reviewer), _field("authority", value.authority), _field("policy_digest", value.policy_digest), _field("evidence_bundle_digest", value.evidence_bundle_digest), _field("created_at", value.created_at), _field("state", value.state)])

