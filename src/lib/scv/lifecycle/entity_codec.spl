    Approval(approval_id: record.entity_id, review_id: _get(record, "review_id"), revision_id: _get(record, "revision_id"), tree_digest: _get(record, "tree_digest"), reviewer: _get(record, "reviewer"), authority: _get(record, "authority"), policy_digest: _get(record, "policy_digest"), evidence_bundle_digest: _get(record, "evidence_bundle_digest"), created_at: _get(record, "created_at"), state: _get(record, "state"))

