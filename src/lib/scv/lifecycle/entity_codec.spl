    lifecycle_record("review", value.review_id, [_field("change_id", value.change_id), _field("base_revision_id", value.base_revision_id), _field("head_revision_id", value.head_revision_id), _field("target_ref", value.target_ref), _field("profile", value.profile), _field("state", value.state)])

fn review_session_from_record(record: LifecycleRecord) -> ReviewSession?:
    if not _typed_fields(record, "review", ["change_id", "base_revision_id", "head_revision_id", "target_ref", "profile", "state"], []):
        return nil
    ReviewSession(review_id: record.entity_id, change_id: _get(record, "change_id"), base_revision_id: _get(record, "base_revision_id"), head_revision_id: _get(record, "head_revision_id"), target_ref: _get(record, "target_ref"), profile: _get(record, "profile"), state: _get(record, "state"))

fn review_run_record(value: ReviewRun) -> LifecycleRecord:
    var fields = [_field("review_id", value.review_id), _field("parent_run_id", value.parent_run_id), _field("reviewer", value.reviewer), _field("reviewer_version", value.reviewer_version), _field("role", value.role), _field("policy_digest", value.policy_digest), _field("evidence_bundle_id", value.evidence_bundle_id), _field("verdict", value.verdict)]
    _add_all(fields, "unresolved_question_ids", value.unresolved_question_ids)
    lifecycle_record("review_run", value.review_run_id, fields)

fn review_run_from_record(record: LifecycleRecord) -> ReviewRun?:
    if not _typed_fields(record, "review_run", ["review_id", "parent_run_id", "reviewer", "reviewer_version", "role", "policy_digest", "evidence_bundle_id", "verdict"], ["unresolved_question_ids"]):
        return nil
    ReviewRun(review_run_id: record.entity_id, review_id: _get(record, "review_id"), parent_run_id: _get(record, "parent_run_id"), reviewer: _get(record, "reviewer"), reviewer_version: _get(record, "reviewer_version"), role: _get(record, "role"), policy_digest: _get(record, "policy_digest"), evidence_bundle_id: _get(record, "evidence_bundle_id"), verdict: _get(record, "verdict"), unresolved_question_ids: _all(record, "unresolved_question_ids"))

fn finding_record(value: Finding) -> LifecycleRecord:
    var fields = [_field("review_id", value.review_id), _field("revision_id", value.revision_id), _field("producer_run_id", value.producer_run_id), _field("rule_id", value.rule_id), _field("category", value.category), _field("severity", value.severity), _field("confidence_evidence", value.confidence_evidence), _field("fingerprint", value.fingerprint), _field("message", value.message), _field("state", value.state), _field("anchor.path", value.source_anchor.path), _field("anchor.parser", value.source_anchor.parser), _field("anchor.symbol_id", value.source_anchor.symbol_id), _field("anchor.syntax_node_kind", value.source_anchor.syntax_node_kind), _field("anchor.syntax_node_fingerprint", value.source_anchor.syntax_node_fingerprint), _field("anchor.surrounding_token_hash", value.source_anchor.surrounding_token_hash), _field("anchor.semantic_entity_id", value.source_anchor.semantic_entity_id), _field("anchor.fallback_line", value.source_anchor.fallback_line.to_text()), _field("anchor.fallback_column", value.source_anchor.fallback_column.to_text())]
    _add_all(fields, "evidence_refs", value.evidence_refs)
    lifecycle_record("finding", value.finding_id, fields)

fn finding_from_record(record: LifecycleRecord) -> Finding?:
    if not _typed_fields(record, "finding", ["review_id", "revision_id", "producer_run_id", "rule_id", "category", "severity", "confidence_evidence", "fingerprint", "message", "state", "anchor.path", "anchor.parser", "anchor.symbol_id", "anchor.syntax_node_kind", "anchor.syntax_node_fingerprint", "anchor.surrounding_token_hash", "anchor.semantic_entity_id", "anchor.fallback_line", "anchor.fallback_column"], ["evidence_refs"]):
        return nil
    if (_get(record, "anchor.fallback_line").to_int() ?? -1) < 0 or (_get(record, "anchor.fallback_column").to_int() ?? -1) < 0:
        return nil
    val anchor = SourceAnchor(path: _get(record, "anchor.path"), parser: _get(record, "anchor.parser"), symbol_id: _get(record, "anchor.symbol_id"), syntax_node_kind: _get(record, "anchor.syntax_node_kind"), syntax_node_fingerprint: _get(record, "anchor.syntax_node_fingerprint"), surrounding_token_hash: _get(record, "anchor.surrounding_token_hash"), semantic_entity_id: _get(record, "anchor.semantic_entity_id"), fallback_line: _get(record, "anchor.fallback_line").to_int() ?? -1, fallback_column: _get(record, "anchor.fallback_column").to_int() ?? -1)
    Finding(finding_id: record.entity_id, review_id: _get(record, "review_id"), revision_id: _get(record, "revision_id"), producer_run_id: _get(record, "producer_run_id"), rule_id: _get(record, "rule_id"), category: _get(record, "category"), severity: _get(record, "severity"), confidence_evidence: _get(record, "confidence_evidence"), source_anchor: anchor, fingerprint: _get(record, "fingerprint"), message: _get(record, "message"), evidence_refs: _all(record, "evidence_refs"), state: _get(record, "state"))

