    GateBundle(gate_bundle_id: record.entity_id, revision_id: _get(record, "revision_id"), gate_run_ids: _all(record, "gate_run_ids"), approval_ids: _all(record, "approval_ids"), complete: _get(record, "complete") == "true", bundle_digest: _get(record, "bundle_digest"), policy_digest: _get(record, "policy_digest"))

