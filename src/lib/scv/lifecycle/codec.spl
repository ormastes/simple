# codex-impl
# Canonical lifecycle record envelope for SCV object-store persistence.

use std.common.crypto.sha256.{sha256_text}

struct LifecycleRecord:
    schema: text
    kind: text
    entity_id: text
    fields: [text]
    digest: text

struct LifecycleDecodeResult:
    ok: bool
    error: text
    record: LifecycleRecord?

fn lifecycle_field_valid(value: text) -> bool:
    not value.contains("|") and not value.contains("\n") and not value.contains("\r")

fn lifecycle_record(kind: text, entity_id: text, fields: [text]) -> LifecycleRecord:
    val payload = "scv-lifecycle/1|" + kind + "|" + entity_id + "|" + fields.join("|")
    LifecycleRecord(schema: "scv-lifecycle/1", kind: kind, entity_id: entity_id, fields: fields, digest: sha256_text(payload))

fn lifecycle_record_encode(record: LifecycleRecord) -> text:
    if record.schema != "scv-lifecycle/1" or record.kind == "" or record.entity_id == "":
        return ""
    for field in record.fields:
        if not lifecycle_field_valid(field):
            return ""
    record.schema + "|" + record.kind + "|" + record.entity_id + "|" + record.fields.len().to_text() + "|" + record.fields.join("|") + "|" + record.digest

fn lifecycle_record_decode(payload: text) -> LifecycleDecodeResult:
    val parts = payload.split("|")
    if parts.len() < 6 or parts[0] != "scv-lifecycle/1":
        return LifecycleDecodeResult(ok: false, error: "malformed lifecycle envelope", record: nil)
    if parts[1] == "" or parts[2] == "":
        return LifecycleDecodeResult(ok: false, error: "lifecycle kind or entity identity is empty", record: nil)
    val field_count = parts[3].to_int() ?? -1
    if field_count < 0 or parts.len() != field_count + 5:
        return LifecycleDecodeResult(ok: false, error: "lifecycle field count mismatch", record: nil)
    var fields: [text] = []
    var i = 0
    while i < field_count:
        fields.push(parts[4 + i])
        i = i + 1
    val record = lifecycle_record(parts[1], parts[2], fields)
    if record.digest != parts[parts.len() - 1]:
        return LifecycleDecodeResult(ok: false, error: "lifecycle digest mismatch", record: nil)
    LifecycleDecodeResult(ok: true, error: "", record: record)

export LifecycleRecord, LifecycleDecodeResult
export lifecycle_field_valid, lifecycle_record, lifecycle_record_encode, lifecycle_record_decode
