# codex-impl
# Durable lifecycle envelopes stored separately from SCV content objects.

use std.io_runtime.{file_exists, file_read, file_write, dir_create_all}
use std.scv.lifecycle.codec.{LifecycleRecord, LifecycleDecodeResult, lifecycle_record_encode, lifecycle_record_decode}

struct LifecycleStoreProbe:
    status: text
    error: text
    record: LifecycleRecord?

fn lifecycle_store_atom_valid(value: text) -> bool:
    value != "" and not value.contains("/") and not value.contains("\\") and not value.contains("..") and not value.contains("|")

fn lifecycle_store_path(root: text, record: LifecycleRecord) -> text:
    if not lifecycle_store_atom_valid(record.kind) or not lifecycle_store_atom_valid(record.entity_id):
        return ""
    root + "/.scv/lifecycle/" + record.kind + "/" + record.entity_id + ".scvl"

fn lifecycle_store_write(root: text, record: LifecycleRecord) -> bool:
    val path = lifecycle_store_path(root, record)
    val payload = lifecycle_record_encode(record)
    if path == "" or payload == "":
        return false
    val dir = root + "/.scv/lifecycle/" + record.kind
    if not dir_create_all(dir):
        return false
    file_write(path, payload)

fn lifecycle_store_read(root: text, kind: text, entity_id: text) -> LifecycleDecodeResult:
    if not lifecycle_store_atom_valid(kind) or not lifecycle_store_atom_valid(entity_id):
        return lifecycle_record_decode("")
    val path = root + "/.scv/lifecycle/" + kind + "/" + entity_id + ".scvl"
    if not file_exists(path):
        return lifecycle_record_decode("")
    lifecycle_record_decode(file_read(path))

fn lifecycle_store_probe(root: text, kind: text, entity_id: text) -> LifecycleStoreProbe:
    if not lifecycle_store_atom_valid(kind) or not lifecycle_store_atom_valid(entity_id):
        return LifecycleStoreProbe(status: "rejected", error: "invalid lifecycle store identity", record: nil)
    val path = root + "/.scv/lifecycle/" + kind + "/" + entity_id + ".scvl"
    if not file_exists(path):
        return LifecycleStoreProbe(status: "absent", error: "", record: nil)
    val decoded = lifecycle_record_decode(file_read(path))
    if not decoded.ok:
        return LifecycleStoreProbe(status: "corrupt", error: decoded.error, record: nil)
    LifecycleStoreProbe(status: "found", error: "", record: decoded.record)

export LifecycleStoreProbe, lifecycle_store_atom_valid, lifecycle_store_path, lifecycle_store_write, lifecycle_store_read, lifecycle_store_probe
