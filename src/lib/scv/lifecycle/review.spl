# codex-impl
# Exact-revision review and gate admission rules.

use std.common.crypto.sha256.{sha256_text}
use std.scv.lifecycle.model.{ReviewSession, Approval, GateRun, GateBundle, LifecycleResult, lifecycle_ok, lifecycle_error}

struct ApprovalEvidence:
    revision_id: text
    tree_digest: text
    reviewer: text
    authority: text
    policy_digest: text
    evidence_digest: text
    created_at: text

fn lifecycle_open_review(review_id: text, change_id: text, base_revision_id: text, head_revision_id: text, target_ref: text, profile: text) -> ReviewSession:
    ReviewSession(review_id: review_id, change_id: change_id, base_revision_id: base_revision_id, head_revision_id: head_revision_id, target_ref: target_ref, profile: profile, state: "reviewing")

fn lifecycle_approval(review: ReviewSession, evidence: ApprovalEvidence) -> Approval:
    val approval_id = "apr_" + sha256_text(review.review_id + "|" + evidence.revision_id + "|" + evidence.reviewer + "|" + evidence.policy_digest)
    val state = if evidence.revision_id == review.head_revision_id: "approved" else: "rejected_revision"
    Approval(approval_id: approval_id, review_id: review.review_id, revision_id: evidence.revision_id, tree_digest: evidence.tree_digest, reviewer: evidence.reviewer, authority: evidence.authority, policy_digest: evidence.policy_digest, evidence_bundle_digest: evidence.evidence_digest, created_at: evidence.created_at, state: state)

fn lifecycle_revalidate_approval(approval: Approval, current_revision_id: text, current_policy_digest: text, current_evidence_digest: text) -> Approval:
    val state = if approval.revision_id != current_revision_id:
        "stale_revision"
    else if approval.policy_digest != current_policy_digest:
        "stale_policy"
    else if approval.evidence_bundle_digest != current_evidence_digest:
        "stale_evidence"
    else:
        "approved"
    Approval(
        approval_id: approval.approval_id, review_id: approval.review_id,
        revision_id: approval.revision_id, tree_digest: approval.tree_digest,
        reviewer: approval.reviewer, authority: approval.authority,
        policy_digest: approval.policy_digest,
        evidence_bundle_digest: approval.evidence_bundle_digest,
        created_at: approval.created_at, state: state
    )

fn lifecycle_gate_bundle(bundle_id: text, revision_id: text, runs: [GateRun], approvals: [Approval], policy_digest: text) -> GateBundle:
    var run_ids: [text] = []
    var approval_ids: [text] = []
    var complete = runs.len() > 0 and approvals.len() > 0
    for run in runs:
        run_ids.push(run.gate_run_id)
        if run.revision_id != revision_id or run.policy_digest != policy_digest or run.verdict != "pass" or run.evidence_objects.len() == 0:
            complete = false
    for approval in approvals:
        approval_ids.push(approval.approval_id)
        if approval.revision_id != revision_id or approval.policy_digest != policy_digest or approval.state != "approved":
            complete = false
    val digest = sha256_text(revision_id + "|" + run_ids.join(",") + "|" + approval_ids.join(",") + "|" + policy_digest)
    GateBundle(gate_bundle_id: bundle_id, revision_id: revision_id, gate_run_ids: run_ids, approval_ids: approval_ids, complete: complete, bundle_digest: digest, policy_digest: policy_digest)

fn lifecycle_gate_bundle_admits(bundle: GateBundle, revision_id: text) -> LifecycleResult:
    if bundle.revision_id != revision_id:
        return lifecycle_error("LIFECYCLE_GATE_REVISION", "gate bundle targets another revision")
    if not bundle.complete:
        return lifecycle_error("LIFECYCLE_GATE_INCOMPLETE", "gate bundle lacks non-vacuous passing evidence or exact approval")
    lifecycle_ok("admitted", bundle.gate_bundle_id)

export ApprovalEvidence, lifecycle_open_review, lifecycle_approval, lifecycle_revalidate_approval
export lifecycle_gate_bundle, lifecycle_gate_bundle_admits
