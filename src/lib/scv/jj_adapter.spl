# SCV mutating jj CLI adapter (SCV-IMPL-B-02, scv_complete_impl_plan.md Track B).
#
# Counterpart to the READ-ONLY sidecar adapter in backend_git.spl (MIG-13), which
# by construction never executes jj at all (it probes `.jj` by directory
# existence). This module is the mutating half: snapshot / describe / new / undo
# actually RUN, and the sj lane (src/app/sj_daemon/request_handler.spl) routes
# its jj commands through here instead of merely building a command string and
# handing it back as stdout.
#
# Contract, in the order the rules matter:
#
#   1. PINNED VERSION. Every execution first reads `jj --version` and refuses
#      (does not warn, does not proceed) when the major.minor does not match
#      JJ_PINNED_VERSION. A mismatched jj is an unknown CLI, and guessing at
#      compatibility on a tool that rewrites history is not an option.
#   2. ARGV, NEVER A SHELL STRING. Commands are built and executed as a [text]
#      argv through process_run, so a message containing spaces or quotes cannot
#      be re-split or reinterpreted by a shell.
#   3. MACHINE TEMPLATES ONLY. State is read back with `-T <template>` and
#      `--no-graph`; no function here parses jj's human-facing output.
#   4. NO `.jj` INTERNALS. Nothing here opens, stats, or parses anything under
#      `.jj/`. jj is addressed only through its documented CLI.
#   5. FLAGS. Every invocation carries `-R <repo> --no-pager --color never`.
#      `--ignore-working-copy` is added to every operation EXCEPT snapshot,
#      because the shared repo is under concurrent use and a working-copy
#      snapshot race has bitten this project before. Snapshot is the one
#      deliberate exception: `jj debug snapshot` exists precisely to snapshot the
#      working copy, so passing `--ignore-working-copy` there would make it a
#      no-op by construction. See scv_jj_argv.
#
# B-01 (sj capsule coordinator, src/lib/scv/sj_capsule.spl) is the transaction
# owner; this module is its EXECUTOR. The API B-01 should call is
# `scv_jj_exec` / `scv_jj_exec_pinned` plus the four named operation wrappers,
# all returning a typed JjExecResult that distinguishes "refused before running"
# (executed: false) from "ran and failed" (executed: true, ok: false).

use std.nogc_sync_mut.io.process_ops.{process_run}

# The jj release this adapter is written against, as major.minor. Bump this only
# together with a re-verification of the flag and template contract above.
val JJ_PINNED_VERSION = "0.32"

# Result of one adapter invocation.
#
# `executed` is the load-bearing field and the reason this struct exists: it is
# false when the adapter REFUSED to spawn jj (version mismatch, empty argv), and
# true only when a jj process really ran. A caller must never read a 0 exit_code
# as evidence of execution without also checking `executed` — "the command was
# built" is exactly the failure mode B-02 exists to close.
struct JjExecResult:
    ok: bool
    executed: bool
    exit_code: i64
    stdout: text
    stderr: text
    command: text
    version: text

fn scv_jj_pinned_version() -> text:
    JJ_PINNED_VERSION

fn _jj_result_refused(command: text, version: text, message: text) -> JjExecResult:
    JjExecResult(
        ok: false,
        executed: false,
        exit_code: 2,
        stdout: "",
        stderr: message,
        command: command,
        version: version
    )

# Read the installed jj version as reported by the CLI, e.g. "0.32.0-44de5718".
# Returns "" when jj is absent or unreadable.
fn scv_jj_version(repo: text) -> text:
    val (out, _err, code) = process_run("jj", ["--version"])
    if code != 0:
        return ""
    val words = out.trim().split(" ")
    if words.len() < 2:
        return ""
    words[1]

# True when `version` is on the pinned major.minor line.
fn scv_jj_version_matches(version: text) -> bool:
    scv_jj_version_matches_pin(version, JJ_PINNED_VERSION)

fn scv_jj_version_matches_pin(version: text, pin: text) -> bool:
    if version == "" or pin == "":
        return false
    version == pin or version.starts_with(pin + ".") or version.starts_with(pin + "-")

# True for the jj subcommands this adapter treats as mutating. Read-only
# subcommands still execute, but callers (and B-01) use this to decide whether a
# lease/transaction is required.
fn scv_jj_is_mutating(argv: [text]) -> bool:
    if argv.len() == 0:
        return false
    val verb = argv[0]
    if verb == "debug":
        return argv.len() > 1 and argv[1] == "snapshot"
    verb == "describe" or verb == "new" or verb == "undo" or verb == "commit" or
        verb == "abandon" or verb == "squash" or verb == "rebase" or
        verb == "restore" or verb == "edit" or verb == "duplicate" or
        verb == "bookmark" or verb == "split" or verb == "absorb"

# Build the full argv for a jj invocation, including the flag policy in rule 5
# above. Exposed so the flag contract is testable without spawning a process.
fn scv_jj_argv(repo: text, argv: [text]) -> [text]:
    var out: [text] = ["jj", "-R", repo]
    # Snapshot is the deliberate exception: `jj debug snapshot`'s entire job is
    # to snapshot the working copy, so --ignore-working-copy would neuter it.
    val is_snapshot = argv.len() > 1 and argv[0] == "debug" and argv[1] == "snapshot"
    if not is_snapshot:
        out.push("--ignore-working-copy")
    out.push("--no-pager")
    out.push("--color")
    out.push("never")
    var i = 0
    while i < argv.len():
        out.push(argv[i])
        i = i + 1
    out

# Core execution entry point, checked against an explicit version pin.
#
# This is the single place in SCV where a jj process is spawned for a mutation.
# It refuses before spawning when jj is missing or off-pin.
fn scv_jj_exec_pinned(repo: text, argv: [text], pin: text) -> JjExecResult:
    val full = scv_jj_argv(repo, argv)
    val command = full.join(" ")
    if argv.len() == 0:
        return _jj_result_refused(command, "", "ERROR — nothing was checked (empty jj argv)")
    val version = scv_jj_version(repo)
    if version == "":
        return _jj_result_refused(command, "", "ERROR — nothing was checked (jj not available on PATH)")
    if not scv_jj_version_matches_pin(version, pin):
        return _jj_result_refused(
            command,
            version,
            "ERROR — nothing was checked (jj version {version} does not match pinned {pin}; refusing to run a mutating operation against an unverified CLI)"
        )
    var args: [text] = []
    var i = 1
    while i < full.len():
        args.push(full[i])
        i = i + 1
    val (out, err, code) = process_run("jj", args)
    JjExecResult(
        ok: code == 0,
        executed: true,
        exit_code: code,
        stdout: out,
        stderr: err,
        command: command,
        version: version
    )

# Execute against the adapter's own pin. This is the entry point B-01 should
# call for anything it does not have a named wrapper for.
fn scv_jj_exec(repo: text, argv: [text]) -> JjExecResult:
    scv_jj_exec_pinned(repo, argv, JJ_PINNED_VERSION)

# --- named mutating operations -------------------------------------------

# Snapshot the working copy into the op log. Deliberately WITHOUT
# --ignore-working-copy; see rule 5.
fn scv_jj_snapshot(repo: text) -> JjExecResult:
    scv_jj_exec(repo, ["debug", "snapshot"])

# Set the description of `rev` (default `@`).
fn scv_jj_describe(repo: text, message: text) -> JjExecResult:
    scv_jj_describe_rev(repo, "@", message)

fn scv_jj_describe_rev(repo: text, rev: text, message: text) -> JjExecResult:
    # `message` is passed as its own argv element, so spaces and quotes survive.
    scv_jj_exec(repo, ["describe", "-r", rev, "-m", message])

# Create a new change on top of the current one.
fn scv_jj_new(repo: text) -> JjExecResult:
    scv_jj_exec(repo, ["new"])

fn scv_jj_new_on(repo: text, parent: text) -> JjExecResult:
    scv_jj_exec(repo, ["new", parent])

# Undo the most recent operation in the op log.
fn scv_jj_undo(repo: text) -> JjExecResult:
    scv_jj_exec(repo, ["undo"])

# --- machine-template reads ----------------------------------------------

# Read one revision through a machine template. Never scrapes human output.
fn scv_jj_template(repo: text, rev: text, template: text) -> text:
    val r = scv_jj_exec(repo, ["log", "--no-graph", "-r", rev, "-T", template])
    if not r.ok:
        return ""
    r.stdout

fn scv_jj_read_description(repo: text, rev: text) -> text:
    scv_jj_template(repo, rev, "description").trim()

fn scv_jj_read_change_id(repo: text, rev: text) -> text:
    scv_jj_template(repo, rev, "change_id.short(12)").trim()

fn scv_jj_read_commit_id(repo: text, rev: text) -> text:
    scv_jj_template(repo, rev, "commit_id.short(12)").trim()

export JJ_PINNED_VERSION, JjExecResult
export scv_jj_pinned_version, scv_jj_version, scv_jj_version_matches, scv_jj_version_matches_pin
export scv_jj_is_mutating, scv_jj_argv, scv_jj_exec, scv_jj_exec_pinned
export scv_jj_snapshot, scv_jj_describe, scv_jj_describe_rev, scv_jj_new, scv_jj_new_on, scv_jj_undo
export scv_jj_template, scv_jj_read_description, scv_jj_read_change_id, scv_jj_read_commit_id
