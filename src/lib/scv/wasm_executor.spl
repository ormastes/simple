# SCV WASM executor — tree-sitter WASM grammar loading and parse execution.
# Implements strict Tree-sitter WASM execution admission.
#
# When libwasmtime and libscv_wasm are absent (or SCV_FORCE_FALLBACK=1),
# strict entrypoints return an explicit unavailable error. Callers select an
# honestly labeled line index or opaque byte representation as appropriate.
# No extern fn declarations for wasmtime symbols — wasmtime is probed at
# runtime via DynLib.  The shim (src/runtime/scv_wasm_shim.c) is loaded
# dynamically; it exposes:
#   wasm_rt_load(path: text) -> i64
#   wasm_rt_free(handle: i64)
#   wasm_rt_parse_all(handle: i64, source: text, source_len: i64) -> text
# The shim pre-flattens the tree-sitter cursor walk to "kind|field|start|end|leaf\n"
# lines so Simple never holds raw TS or wasmtime pointers.

use app.io.mod (file_exists)
use std.nogc_sync_mut.sffi.dynamic.{DynLib, sffi_lib_path}
use std.scv.store.{scv_write_text, scv_hash_text, scv_content_id_for_u8}
use std.scv.file_buffer.{scv_file_buffer_read_bounded}
use std.scv.parser_registry.{scv_locked_parser_hash, scv_locked_parser_error, scv_wasm_magic_ok}
use std.scv.structural_span_v1.{scv_structural_spans_v1}
use std.scv.core.{scv_object_path}
use std.io_runtime.{env_get}
use std.scv.wasm_shim_contract.{scv_wasm_input_within_bounds, scv_wasm_blob_validate}

# ---------------------------------------------------------------------------
# Availability probe
# ---------------------------------------------------------------------------

# Returns true when BOTH the wasmtime dynamic library AND the scv_wasm shim
# are loadable on this machine, AND SCV_FORCE_FALLBACK is not "1".
# When false, strict parse reports unavailable and never simulates success.
fn scv_wasm_executor_available() -> bool:
    val force_fallback = env_get("SCV_FORCE_FALLBACK")
    if force_fallback == "1":
        return false
    val wasmtime_path = sffi_lib_path("wasmtime")
    val shim_path = sffi_lib_path("scv_wasm")
    # Existence pre-check: spl_dlopen on a MISSING file raises a hard
    # E-SFFI-001 runtime error (it does not return <=0 as DynLib.load
    # assumes), which crashed every caller on hosts without the shim.
    # A probe must be able to answer "no" without dying.
    if not file_exists(wasmtime_path):
        return false
    if not file_exists(shim_path):
        return false
    val wt_lib = DynLib.load(wasmtime_path)
    if val Some(wt) = wt_lib:
        wt.close()
    else:
        return false
    val sh_lib = DynLib.load(shim_path)
    if val Some(sh) = sh_lib:
        sh.close()
    else:
        return false
    true

# ---------------------------------------------------------------------------
# Structural node-ID hashing
# ---------------------------------------------------------------------------

# Compute a structural ID for a syntax node, excluding byte positions.
# Identical subtrees across edits share the same structural ID.
fn scv_ts_node_structural_id(kind: text, field: text, source_slice: text, child_ids: [text]) -> text:
    val child_concat = child_ids.join(",")
    scv_hash_text("syntax_node", "ts:{kind}:{field}:{source_slice}:{child_concat}")

# ---------------------------------------------------------------------------
# Node writers for tree-sitter-wasm execution path
# ---------------------------------------------------------------------------

# Write a derived leaf from an admitted provider blob.
fn _scv_wasm_leaf(root: text, kind: text, field: text, byte_start: i64,
                     byte_end: i64, source_slice: text, language: text,
                     grammar: text, version: text, parser_hash: text) -> text:
    val node_id = scv_ts_node_structural_id(kind, field, source_slice, [])
    val payload = "grammar: {grammar}\nversion: {version}\nparser_hash: {parser_hash}\nexecution: wasm-tree-sitter\nkind: {kind}\nfield: {field}\nchildren:\nbyte_start: {byte_start}\nbyte_end: {byte_end}\nlanguage: {language}\nsyntax: {node_id}\nparse_status: ok\n"
    val path = scv_object_path(root, "syntax", node_id)
    if not file_exists(path):
        scv_write_text(path, payload)
    node_id

# Write an inner syntax node (with children) and return its structural ID.
fn scv_wasm_inner_node(root: text, kind: text, field: text, byte_start: i64,
                       byte_end: i64, child_ids: [text], language: text,
                       grammar: text, version: text, parser_hash: text) -> text:
    val node_id = scv_ts_node_structural_id(kind, field, "", child_ids)
    val child_concat = child_ids.join(",")
    val payload = "grammar: {grammar}\nversion: {version}\nparser_hash: {parser_hash}\nexecution: wasm-tree-sitter\nkind: {kind}\nfield: {field}\nchildren: {child_concat}\nbyte_start: {byte_start}\nbyte_end: {byte_end}\nlanguage: {language}\nsyntax: {node_id}\nparse_status: ok\n"
    val path = scv_object_path(root, "syntax", node_id)
    if not file_exists(path):
        scv_write_text(path, payload)
    node_id

# ---------------------------------------------------------------------------
# Real WASM parse via shim extern fns
# ---------------------------------------------------------------------------

# Parse the serialised cursor blob returned by wasm_rt_parse_all.
# Each line is "kind|field|byte_start|byte_end|is_leaf|depth".
# The depth field (0-based) drives stack management: before processing each node
# we pop the stack down to the node's depth level, flushing completed inner nodes
# to their parents as we go.  This correctly handles sibling inner nodes.
# source is needed to extract leaf text slices from byte offsets.
fn _scv_parse_node_blob(root: text, blob: text, source: text, language: text,
                         grammar: text, version: text, parser_hash: text) -> text:
    val lines = blob.split("\n")
    var stack_kinds:    [text] = []
    var stack_fields:   [text] = []
    var stack_starts:   [i64]  = []
    var stack_ends:     [i64]  = []
    var stack_children: [text] = []
    var root_id = ""
    var li = 0
    while li < lines.len():
        val line = lines[li]
        li = li + 1
        if line == "":
            continue
        val parts = line.split("|")
        if parts.len() < 5:
            continue
        val nkind  = parts[0]
        val nfield = parts[1]
        val nstart = parts[2].to_i64() ?? 0
        val nend   = parts[3].to_i64() ?? 0
        val nleaf  = parts[4] == "1"
        val ndepth = if parts.len() >= 6: parts[5].to_i64() ?? 0 else: 0
        # Pop the stack down to ndepth, flushing completed inner nodes upward.
        # An inner node at depth D lives at stack index D (root is index 0).
        # Before placing a new node at depth D we need the stack to have exactly
        # D entries — i.e., all entries at index >= D must be flushed first.
        while stack_kinds.len() > ndepth:
            val si = stack_kinds.len() - 1
            val fkind     = stack_kinds[si]
            val ffield    = stack_fields[si]
            val fstart    = stack_starts[si]
            val fend      = stack_ends[si]
            val fchild_str = stack_children[si]
            val fchildren: [text] = if fchild_str == "": [] else: fchild_str.split(",")
            val fid = scv_wasm_inner_node(root, fkind, ffield, fstart, fend,
                                          fchildren, language, grammar, version, parser_hash)
            stack_kinds.pop()
            stack_fields.pop()
            stack_starts.pop()
            stack_ends.pop()
            stack_children.pop()
            if stack_kinds.len() > 0:
                val parent = stack_kinds.len() - 1
                val pcur = stack_children[parent]
                stack_children[parent] = if pcur == "": fid else: pcur + "," + fid
            else:
                root_id = fid
        if nleaf:
            val slen = nend - nstart
            val slice = if (slen > 0 and nstart >= 0 and nend <= source.len()):
                            source.slice(nstart, nend)
                        else:
                            ""
            val child_id = _scv_wasm_leaf(root, nkind, nfield, nstart, nend,
                                             slice, language, grammar, version, parser_hash)
            if stack_kinds.len() > 0:
                val top = stack_kinds.len() - 1
                val cur = stack_children[top]
                stack_children[top] = if cur == "": child_id else: cur + "," + child_id
            else:
                root_id = child_id
        else:
            stack_kinds.push(nkind)
            stack_fields.push(nfield)
            stack_starts.push(nstart)
            stack_ends.push(nend)
            stack_children.push("")
    # Flush any remaining inner nodes on the stack bottom-up
    while stack_kinds.len() > 0:
        val si = stack_kinds.len() - 1
        val fkind     = stack_kinds[si]
        val ffield    = stack_fields[si]
        val fstart    = stack_starts[si]
        val fend      = stack_ends[si]
        val fchild_str = stack_children[si]
        val fchildren: [text] = if fchild_str == "": [] else: fchild_str.split(",")
        val fid = scv_wasm_inner_node(root, fkind, ffield, fstart, fend,
                                      fchildren, language, grammar, version, parser_hash)
        stack_kinds.pop()
        stack_fields.pop()
        stack_starts.pop()
        stack_ends.pop()
        stack_children.pop()
        if stack_kinds.len() > 0:
            val parent = stack_kinds.len() - 1
            val pcur = stack_children[parent]
            stack_children[parent] = if pcur == "": fid else: pcur + "," + fid
        else:
            root_id = fid
    root_id

# ---------------------------------------------------------------------------
# Public high-level parse API
# ---------------------------------------------------------------------------

# Full WASM parse pipeline: load grammar → parse → walk → write nodes.
# Returns (root_node_id, error_or_empty).
#
# When the scv_wasm shim is compiled and linked (i.e., the runtime is built
# with wasmtime support), these extern declarations are resolved and the real
# path is used.  When the shim is absent, scv_wasm_executor_available()
# returns false and the call never reaches these externs. Fallback is selected
# by callers and cannot acquire a successful WASM execution label.
#
# In interpreter mode or when only DynLib probing is available (no compiled
# shim), the availability check gates everything and reports unavailable.
@unsafe(reason: "wasm shim handle from foreign loader; availability-gated before use", capabilities: [ffi])
extern fn wasm_rt_load(path: text) -> i64
@unsafe(reason: "frees a foreign wasm shim handle; caller owns handle lifetime", capabilities: [ffi])
extern fn wasm_rt_free(handle: i64)
@unsafe(reason: "foreign parse over caller buffer; length passed explicitly", capabilities: [ffi])
extern fn wasm_rt_parse_all(handle: i64, source: text, source_len: i64) -> text

# Smallest ffi-unsafe boundary around the shim: load, parse, free.
# Returns "" when the grammar cannot be loaded or parsing yields nothing.
@unsafe(reason: "wasm shim load/parse/free sequence; handle validity checked, freed on all paths", capabilities: [ffi])
fn _scv_wasm_parse_blob(grammar_path: text, source: text, source_len: i64) -> text:
    val handle = wasm_rt_load(grammar_path)
    if handle <= 0:
        return ""
    val blob = wasm_rt_parse_all(handle, source, source_len)
    wasm_rt_free(handle)
    blob

fn scv_wasm_parse(root: text, language: text, grammar: text, version: text,
                  parser_hash: text, source: text) -> (text, text):
    val blob = match scv_wasm_verified_blob(root, language, grammar, version, parser_hash, source):
        Ok(value): value
        Err(error): return ("", error)
    val root_id = _scv_parse_node_blob(root, blob, source, language, grammar, version, parser_hash)
    if root_id == "":
        return ("", "ERROR WASM provider produced no tree\n")
    (root_id, "")

# The only successful producer of real-provider blobs. A fixture blob is never
# sufficient execution evidence. Verify the exact lock, artifact and source byte
# length before invoking the shim; reject missing/recovered/overlapping trees.
fn scv_wasm_verified_blob(root: text, language: text, grammar: text, version: text,
                           parser_hash: text, source: text) -> Result<text, text>:
    if grammar != "tree-sitter-wasm":
        return Err("ERROR unsupported WASM provider\n")
    val locked = scv_locked_parser_hash(root, language, grammar, version)
    if locked != parser_hash:
        return Err("ERROR WASM parser lock mismatch\n")
    val lock_error = scv_locked_parser_error(root, language, grammar, version)
    if lock_error != "": return Err(lock_error)
    if not scv_wasm_executor_available():
        return Err("ERROR WASM provider unavailable\n")
    val source_len = source.bytes().len()
    # Hardened shim contract (SCV-IMPL-P-02): refuse oversized inputs.
    if not scv_wasm_input_within_bounds(source_len):
        return Err("ERROR WASM input bound\n")
    # Build grammar artifact path: .scv/parsers/<parser_hash>.wasm
    val grammar_path = "{root}/.scv/parsers/{parser_hash}.wasm"
    val artifact = scv_file_buffer_read_bounded(grammar_path, 67108864)
    if artifact.error != "": return Err(artifact.error)
    if scv_content_id_for_u8(artifact.bytes) != parser_hash or not scv_wasm_magic_ok(artifact.bytes):
        return Err("ERROR WASM artifact identity\n")
    # Load grammar + parse via the ffi-unsafe boundary wrapper
    val blob = _scv_wasm_parse_blob(grammar_path, source, source_len)
    if blob == "":
        return Err("ERROR WASM provider returned no parse\n")
    val after = scv_file_buffer_read_bounded(grammar_path, 67108864)
    if after.error != "": return Err(after.error)
    if after.bytes != artifact.bytes:
        return Err("ERROR WASM artifact changed during execution\n")
    # Hardened shim contract (SCV-IMPL-P-02): a malformed blob is rejected
    # wholesale — never turned into a half-built tree.
    match scv_structural_spans_v1(blob, source_len):
        Ok(spans): Ok(blob)
        Err(error): Err(error)
