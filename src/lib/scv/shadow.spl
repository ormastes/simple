# SCV shadow replication (MIG-16, asymmetric replication §1): every explicit
# SCV commit is also recorded to a shadow store — a second SCV object layout
# holding content-addressed copies of the immutable objects and refs.
#
# `scv shadow-sync --dest <dir>` replicates new immutable objects + refs since
# the last sync, verifies every copy by recomputing its content hash, and
# records a watermark in .scv/meta/shadow_state.sdn. Idempotent: a re-run over
# an up-to-date shadow copies nothing. Fail-closed: a corrupted or unverifiable
# shadow object is a FAIL and the watermark is not advanced.
#
# Documented default destination: /mnt/data/scv-backup/scv-shadow
# (the shadow server is disposable — on divergence, stop the shadow and treat
# the canonical side as authoritative).

use app.io.mod (file_exists, file_read, file_copy, dir_create)
use std.scv.core.{scv_repo_dir, scv_meta_dir}
use std.scv.store.{scv_repo_exists, scv_current_op, scv_read_workspace_commit, scv_write_text, scv_content_id_for_file, scv_create_parent_dir}
use std.scv.stabilize.{scv_checkpoint_rel_sources}

fn scv_shadow_state_path(root: text) -> text:
    "{scv_meta_dir(root)}/shadow_state.sdn"

fn scv_shadow_sync(root: text, dest: text) -> text:
    if not scv_repo_exists(root):
        return "ERROR — nothing was checked (repository not initialized)\n"
    if dest == "":
        return "ERROR — nothing was checked (shadow-sync requires --dest <dir>)\n"
    # Same must-replicate set as checkpoints (stabilization §2): operation
    # heads, refs, changes, lineage objects and content chunks. Rebuildable
    # state is deliberately excluded.
    val rels = scv_checkpoint_rel_sources(root)
    if rels.len() == 0:
        return "ERROR — nothing was checked (no replication sources)\n"
    dir_create(dest, true)
    var copied = 0
    var up_to_date = 0
    var errors = ""
    var error_count = 0
    var row_list: [text] = []
    for rel in rels:
        val src = "{scv_repo_dir(root)}/{rel}"
        val src_sha = scv_content_id_for_file(src)
        val dst = "{dest}/{rel}"
        if file_exists(dst):
            if scv_content_id_for_file(dst) == src_sha:
                up_to_date = up_to_date + 1
                row_list.push("{src_sha} {rel}\n")
                continue
            if rel.starts_with("objects/") and not rel.starts_with("objects/changes/"):
                # Content-addressed idempotency: an existing shadow OBJECT must
                # byte-agree with the source. The object store is immutable
                # (changes are the exception: a ChangeId file evolves in place
                # across snapshots, so it is replicated like a ref below), so
                # any divergence is corruption, never a legitimate update.
                errors = errors + "shadow object corrupted: {rel}\n"
                error_count = error_count + 1
                continue
            # Refs and operation heads are mutable: overwrite with the current
            # content and verify by recomputed hash, like a fresh copy.
            if not scv_write_text(dst, file_read(src)):
                errors = errors + "shadow ref update failed: {rel}\n"
                error_count = error_count + 1
                continue
            if scv_content_id_for_file(dst) != src_sha:
                errors = errors + "shadow verify failed (recomputed hash mismatch): {rel}\n"
                error_count = error_count + 1
                continue
            copied = copied + 1
            row_list.push("{src_sha} {rel}\n")
            continue
        scv_create_parent_dir(dst)
        if not file_copy(src, dst):
            errors = errors + "shadow copy failed: {rel}\n"
            error_count = error_count + 1
            continue
        # Verify by recomputed hash over the copied bytes, never trust the copy.
        if scv_content_id_for_file(dst) != src_sha:
            errors = errors + "shadow verify failed (recomputed hash mismatch): {rel}\n"
            error_count = error_count + 1
            continue
        copied = copied + 1
        row_list.push("{src_sha} {rel}\n")
    if error_count > 0:
        return "{errors}FAIL — {error_count} shadow object(s) failed verification; watermark not advanced\n"
    val rows = row_list.join("")
    val state = "shadow_state:\n  op: {scv_current_op(root)}\n  commit: {scv_read_workspace_commit(root)}\n  dest: {dest}\n  files: {rels.len()}\n--\n{rows}"
    if not scv_write_text(scv_shadow_state_path(root), state):
        return "FAIL — shadow watermark write failed: {scv_shadow_state_path(root)}\n"
    "PASS — {copied} object(s) replicated, {up_to_date} up-to-date -> {dest}\n"
