# Event-maintained canonical source inventory for compile-owned SCV snapshots.
#
# This module never discovers files. Git/filesystem adapters submit explicit
# events, and compilation freezes one admitted immutable generation. All writes
# are confined to the caller-provided SCV cache root.

use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{dir_list}
use std.nogc_sync_mut.sffi.fs.{file_create_excl}
use std.io.{file_lock, file_unlock}
use std.io_runtime.{process_is_running}
use std.nogc_async_mut.file_system.event_watch.{FsWatchEvent}

extern fn rt_getpid() -> i64

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_rename(from_path: text, to_path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_is_regular_no_follow(path: text) -> bool
extern fn rt_file_read_regular_no_follow_bounded(path: text, max_bytes: i64) -> text?
extern fn rt_file_size(path: text) -> i64
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool

val COMPILE_SOURCE_INVENTORY_SCHEMA_V1: i64 = 1
val COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1: i64 = 256 * 1024 * 1024

struct CompileSourceInventoryEntryV1:
    source_identity: text
    content_digest: text
    semantic_digest: text
    export_digest: text
    initializer_digest: text
    provider_digest: text
    byte_count: i64

struct CompileSourceEventV1:
    source: text
    operation: text
    source_identity: text
    content_digest: text
    semantic_digest: text
    export_digest: text
    initializer_digest: text
    provider_digest: text
    byte_count: i64

struct CompileSourceGitChangeV1:
    operation: text
    source_identity: text
    content: text

struct CompileSourceInventoryV1:
    schema_version: i64
    generation: i64
    entries: [CompileSourceInventoryEntryV1]

struct CompileSourceInventoryReadV1:
    valid: bool
    reason: text
    digest: text
    inventory: CompileSourceInventoryV1?

struct CompileSourceInventoryChangeV1:
    valid: bool
    reason: text
    inventory: CompileSourceInventoryV1?
    content_changed: bool
    semantics_changed: bool

fn compile_source_inventory_strip_comments_v1(content: text) -> text:
    var rows: [text] = []
    for line in content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"):
            continue
        rows = rows.push(trimmed.split_whitespace().join(" "))
    rows.join("\n")

fn compile_source_inventory_facet_text_v1(content: text, facet: text) -> text:
    val canonical = compile_source_inventory_strip_comments_v1(content)
    if facet == "semantic":
        return canonical
    var rows: [text] = []
    for line in canonical.split("\n"):
        if (facet == "export" and (line.starts_with("export ") or
                line.starts_with("pub "))) or
                (facet == "initializer" and (line.starts_with("val ") or
                    line.starts_with("var ") or line.starts_with("init "))) or
                (facet == "provider" and (line.starts_with("use ") or
                    line.starts_with("impl ") or line.starts_with("provider "))):
            rows = rows.push(line)
    rows.join("\n")

fn compile_source_inventory_event_from_content_v1(
    source: text, operation: text, source_identity: text, content: text
) -> CompileSourceEventV1:
    if operation == "delete":
        return CompileSourceEventV1(
            source, operation, source_identity, "", "", "", "", "", 0)
    CompileSourceEventV1(
        source, operation, source_identity, sha256_text(content),
        sha256_text(compile_source_inventory_facet_text_v1(content, "semantic")),
        sha256_text(compile_source_inventory_facet_text_v1(content, "export")),
        sha256_text(compile_source_inventory_facet_text_v1(content, "initializer")),
        sha256_text(compile_source_inventory_facet_text_v1(content, "provider")),
        content.len())

fn compile_source_inventory_git_event_v1(
    operation: text, source_identity: text, content: text
) -> CompileSourceEventV1:
    compile_source_inventory_event_from_content_v1(
        "git", operation, source_identity, content)

fn compile_source_inventory_filesystem_event_v1(
    operation: text, source_identity: text, content: text
) -> CompileSourceEventV1:
    compile_source_inventory_event_from_content_v1(
        "filesystem", operation, source_identity, content)

fn compile_source_inventory_event_path_v1(root: text, path: text) -> text:
    val normalized_root = root.replace("\\", "/")
    val normalized_path = path.replace("\\", "/")
    if normalized_path.starts_with(normalized_root + "/"):
        return normalized_path.substring(normalized_root.len() + 1)
    normalized_path

fn compile_source_inventory_apply_and_publish_v1(
    cache_root: text, events: [CompileSourceEventV1]
) -> CompileSourceInventoryReadV1:
    val current = compile_source_inventory_read_current_v1(cache_root)
    var inventory = if current.valid:
        current.inventory!
    else:
        CompileSourceInventoryV1(COMPILE_SOURCE_INVENTORY_SCHEMA_V1, 0, [])
    for event in events:
        val changed = compile_source_inventory_apply_event_v1(inventory, event)
        if not changed.valid:
            return CompileSourceInventoryReadV1(false, changed.reason, "", nil)
        inventory = changed.inventory!
    val digest = compile_source_inventory_publish_v1(cache_root, inventory)
    if digest == "":
        return CompileSourceInventoryReadV1(false, "inventory-publication-failed", "", nil)
    compile_source_inventory_read_current_v1(cache_root)

fn compile_source_inventory_apply_git_changes_v1(
    cache_root: text, changes: [CompileSourceGitChangeV1]
) -> CompileSourceInventoryReadV1:
    var events: [CompileSourceEventV1] = []
    for change in changes:
        events = events.push(compile_source_inventory_git_event_v1(
            change.operation, change.source_identity, change.content))
    compile_source_inventory_apply_and_publish_v1(cache_root, events)

fn compile_source_inventory_apply_filesystem_events_v1(
    root: text, cache_root: text, events: [FsWatchEvent]
) -> CompileSourceInventoryReadV1:
    var translated: [CompileSourceEventV1] = []
    for event in events:
        if event.kind == "overflow":
            return CompileSourceInventoryReadV1(
                false, "inventory-event-overflow", "", nil)
        val identity = compile_source_inventory_event_path_v1(root, event.path)
        if event.kind == "deleted" or event.kind == "rename_from":
            translated = translated.push(
                compile_source_inventory_filesystem_event_v1(
                    "delete", identity, ""))
            continue
        if event.kind == "renamed" and event.related != "":
            val related = compile_source_inventory_event_path_v1(root, event.related)
            translated = translated.push(
                compile_source_inventory_filesystem_event_v1(
                    "delete", related, ""))
        val content = compile_source_inventory_read_text_v1(event.path)
        if content == nil:
            return CompileSourceInventoryReadV1(
                false, "inventory-event-read-failed:{identity}", "", nil)
        val operation = if event.kind == "created" or event.kind == "rename_to":
            "create"
        else:
            "modify"
        translated = translated.push(
            compile_source_inventory_filesystem_event_v1(
                operation, identity, content!))
    compile_source_inventory_apply_and_publish_v1(cache_root, translated)

fn compile_source_inventory_text_valid_v1(value: text) -> bool:
    value != "" and not value.contains("\n") and not value.contains("\r") and
        not value.contains("|")

fn compile_source_inventory_digest_valid_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    for ch in value:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
    true

fn compile_source_inventory_path_valid_v1(value: text) -> bool:
    compile_source_inventory_text_valid_v1(value) and
        not value.starts_with("/") and not value.contains("\\") and
        not value.contains("//") and not value.split("/").contains("..") and
        (value.ends_with(".spl") or value == "simple.sdn" or
            value.ends_with("/simple.sdn"))

fn compile_source_inventory_cache_root_valid_v1(cache_root: text) -> bool:
    cache_root == "build/scv" or cache_root == ".simple/scv" or
        cache_root.ends_with("/build/scv") or
        cache_root.ends_with("/.simple/scv")

fn compile_source_inventory_sort_v1(
    values: [CompileSourceInventoryEntryV1]
) -> [CompileSourceInventoryEntryV1]:
    var sorted = values
    var index = 1
    while index < sorted.len():
        val item = sorted[index]
        var cursor = index
        while cursor > 0 and item.source_identity < sorted[cursor - 1].source_identity:
            sorted[cursor] = sorted[cursor - 1]
            cursor = cursor - 1
        sorted[cursor] = item
        index = index + 1
    sorted

fn compile_source_inventory_entry_valid_v1(
    entry: CompileSourceInventoryEntryV1
) -> bool:
    compile_source_inventory_path_valid_v1(entry.source_identity) and
        compile_source_inventory_digest_valid_v1(entry.content_digest) and
        compile_source_inventory_digest_valid_v1(entry.semantic_digest) and
        compile_source_inventory_digest_valid_v1(entry.export_digest) and
        compile_source_inventory_digest_valid_v1(entry.initializer_digest) and
        compile_source_inventory_digest_valid_v1(entry.provider_digest) and
        entry.byte_count >= 0

fn compile_source_inventory_encode_v1(inventory: CompileSourceInventoryV1) -> text:
    if inventory.schema_version != COMPILE_SOURCE_INVENTORY_SCHEMA_V1 or
            inventory.generation < 0:
        return ""
    val entries = compile_source_inventory_sort_v1(inventory.entries)
    var rows = [
        "simple-compile-source-inventory-v1",
        "generation={inventory.generation}",
        "count={entries.len()}"
    ]
    var previous = ""
    for entry in entries:
        if (not compile_source_inventory_entry_valid_v1(entry) or
                entry.source_identity == previous):
            return ""
        previous = entry.source_identity
        rows = rows.push([
            entry.source_identity, entry.content_digest, entry.semantic_digest,
            entry.export_digest, entry.initializer_digest,
            entry.provider_digest, entry.byte_count.to_text()
        ].join("|"))
    rows.join("\n")

fn compile_source_inventory_digest_v1(inventory: CompileSourceInventoryV1) -> text:
    val encoded = compile_source_inventory_encode_v1(inventory)
    if encoded == "": "" else: sha256_text(encoded)

fn compile_source_inventory_find_v1(
    entries: [CompileSourceInventoryEntryV1], source_identity: text
) -> i64:
    var index = 0
    while index < entries.len():
        if entries[index].source_identity == source_identity:
            return index
        index = index + 1
    -1

fn compile_source_inventory_apply_event_v1(
    inventory: CompileSourceInventoryV1, event: CompileSourceEventV1
) -> CompileSourceInventoryChangeV1:
    if (inventory.schema_version != COMPILE_SOURCE_INVENTORY_SCHEMA_V1 or
            inventory.generation < 0 or
            not (event.source == "git" or event.source == "filesystem") or
            not compile_source_inventory_path_valid_v1(event.source_identity)):
        return CompileSourceInventoryChangeV1(false, "event-invalid", nil, false, false)
    var entries = compile_source_inventory_sort_v1(inventory.entries)
    val found = compile_source_inventory_find_v1(entries, event.source_identity)
    if event.operation == "delete":
        if found < 0:
            return CompileSourceInventoryChangeV1(true, "ok-no-change", Some(inventory), false, false)
        val old = entries[found]
        entries = entries.remove_at(found)
        val next = CompileSourceInventoryV1(1, inventory.generation + 1, entries)
        return CompileSourceInventoryChangeV1(true, "ok", Some(next), true,
            old.semantic_digest != "" or old.export_digest != "" or
            old.initializer_digest != "" or old.provider_digest != "")
    if not (event.operation == "create" or event.operation == "modify"):
        return CompileSourceInventoryChangeV1(false, "event-operation-invalid", nil, false, false)
    val next_entry = CompileSourceInventoryEntryV1(
        event.source_identity, event.content_digest, event.semantic_digest,
        event.export_digest, event.initializer_digest, event.provider_digest,
        event.byte_count)
    if not compile_source_inventory_entry_valid_v1(next_entry):
        return CompileSourceInventoryChangeV1(false, "event-entry-invalid", nil, false, false)
    var content_changed = true
    var semantics_changed = true
    if found >= 0:
        val old = entries[found]
        content_changed = old.content_digest != next_entry.content_digest or
            old.byte_count != next_entry.byte_count
        semantics_changed = old.semantic_digest != next_entry.semantic_digest or
            old.export_digest != next_entry.export_digest or
            old.initializer_digest != next_entry.initializer_digest or
            old.provider_digest != next_entry.provider_digest
        if not content_changed and not semantics_changed:
            return CompileSourceInventoryChangeV1(true, "ok-no-change", Some(inventory), false, false)
        entries[found] = next_entry
    else:
        entries = entries.push(next_entry)
    val next = CompileSourceInventoryV1(
        1, inventory.generation + 1, compile_source_inventory_sort_v1(entries))
    CompileSourceInventoryChangeV1(true, "ok", Some(next), content_changed, semantics_changed)

fn compile_source_inventory_storage_v1(cache_root: text) -> text:
    "{cache_root}/source-inventory"

fn compile_source_inventory_read_text_v1(path: text) -> text?:
    if not rt_file_is_regular_no_follow(path):
        return nil
    val size = rt_file_size(path)
    if size <= 0 or size > COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1:
        return nil
    rt_file_read_regular_no_follow_bounded(path, size)

fn compile_source_inventory_decode_v1(content: text) -> CompileSourceInventoryReadV1:
    val lines = content.split("\n")
    if lines.len() < 3 or lines[0] != "simple-compile-source-inventory-v1" or
            not lines[1].starts_with("generation=") or
            not lines[2].starts_with("count="):
        return CompileSourceInventoryReadV1(false, "inventory-header-invalid", "", nil)
    val generation = lines[1].substring(11).to_i64() ?? -1
    val count = lines[2].substring(6).to_i64() ?? -1
    if generation < 0 or count < 0 or lines.len() != count + 3:
        return CompileSourceInventoryReadV1(false, "inventory-count-invalid", "", nil)
    var entries: [CompileSourceInventoryEntryV1] = []
    var index = 3
    while index < lines.len():
        val fields = lines[index].split("|")
        if fields.len() != 7:
            return CompileSourceInventoryReadV1(false, "inventory-row-invalid", "", nil)
        entries = entries.push(CompileSourceInventoryEntryV1(
            fields[0], fields[1], fields[2], fields[3], fields[4], fields[5],
            fields[6].to_i64() ?? -1))
        index = index + 1
    val inventory = CompileSourceInventoryV1(1, generation, entries)
    if compile_source_inventory_encode_v1(inventory) != content:
        return CompileSourceInventoryReadV1(false, "inventory-noncanonical", "", nil)
    CompileSourceInventoryReadV1(true, "ok", sha256_text(content), Some(inventory))

fn compile_source_inventory_publish_v1(
    cache_root: text, inventory: CompileSourceInventoryV1
) -> text:
    if not compile_source_inventory_cache_root_valid_v1(cache_root):
        return ""
    val content = compile_source_inventory_encode_v1(inventory)
    if content == "":
        return ""
    val digest = sha256_text(content)
    val root = compile_source_inventory_storage_v1(cache_root)
    if not rt_dir_create_all("{root}/generations"):
        return ""
    val publication_lock = file_lock("{root}/publication.lock", 5)
    if publication_lock < 0:
        return ""
    val current = compile_source_inventory_read_current_v1(cache_root)
    if current.valid and current.inventory!.generation > inventory.generation:
        val _unlocked = file_unlock(publication_lock)
        return ""
    if current.valid and current.inventory!.generation == inventory.generation:
        val existing_digest = current.digest
        val _unlocked = file_unlock(publication_lock)
        return if existing_digest == digest: digest else: ""
    val generation_path = "{root}/generations/{digest}.inventory"
    if not rt_file_exists(generation_path):
        val generation_staged = "{generation_path}.tmp.{rt_getpid()}"
        rt_file_delete(generation_staged)
        if (not file_create_excl(generation_staged, content) or
                not rt_file_rename(generation_staged, generation_path)):
            rt_file_delete(generation_staged)
            val raced = compile_source_inventory_read_text_v1(generation_path)
            if raced == nil or raced! != content:
                val _unlocked = file_unlock(publication_lock)
                return ""
    val staged = "{root}/CURRENT.tmp.{rt_getpid()}"
    rt_file_delete(staged)
    if not file_create_excl(staged, digest) or
            not rt_file_rename(staged, "{root}/CURRENT"):
        rt_file_delete(staged)
        val _unlocked = file_unlock(publication_lock)
        return ""
    val _unlocked = file_unlock(publication_lock)
    digest

fn compile_source_inventory_read_current_v1(
    cache_root: text
) -> CompileSourceInventoryReadV1:
    if not compile_source_inventory_cache_root_valid_v1(cache_root):
        return CompileSourceInventoryReadV1(false, "inventory-cache-root-invalid", "", nil)
    val root = compile_source_inventory_storage_v1(cache_root)
    val pointer = compile_source_inventory_read_text_v1("{root}/CURRENT")
    if pointer == nil or not compile_source_inventory_digest_valid_v1(pointer!):
        return CompileSourceInventoryReadV1(false, "inventory-pointer-invalid", "", nil)
    val content = compile_source_inventory_read_text_v1(
        "{root}/generations/{pointer!}.inventory")
    if content == nil or sha256_text(content!) != pointer!:
        return CompileSourceInventoryReadV1(false, "inventory-generation-invalid", "", nil)
    compile_source_inventory_decode_v1(content!)

fn compile_source_inventory_recover_v1(cache_root: text) -> i64:
    if not compile_source_inventory_cache_root_valid_v1(cache_root):
        return 0
    val root = compile_source_inventory_storage_v1(cache_root)
    val recovery_lock = file_lock("{root}/publication.lock", 1)
    if recovery_lock < 0:
        return 0
    var removed = 0
    for name in dir_list(root):
        if name.starts_with("CURRENT.tmp."):
            val owner = name.substring(12).to_i64() ?? -1
            if owner > 0 and not process_is_running(owner) and
                    rt_file_delete("{root}/{name}"):
                removed = removed + 1
    for name in dir_list("{root}/generations"):
        if name.contains(".inventory.tmp."):
            val parts = name.split(".tmp.")
            val owner = if parts.len() == 2: parts[1].to_i64() ?? -1 else: -1
            if owner > 0 and not process_is_running(owner) and
                    rt_file_delete("{root}/generations/{name}"):
                removed = removed + 1
    val _unlocked = file_unlock(recovery_lock)
    removed

fn compile_source_inventory_snapshot_rows_v1(
    inventory: CompileSourceInventoryV1
) -> text:
    val entries = compile_source_inventory_sort_v1(inventory.entries)
    var rows: [text] = []
    for entry in entries:
        if not compile_source_inventory_entry_valid_v1(entry):
            return ""
        rows = rows.push("{entry.source_identity}|sha256_{entry.content_digest}|{entry.byte_count}")
    rows.join("\n")

export COMPILE_SOURCE_INVENTORY_SCHEMA_V1
export CompileSourceInventoryEntryV1, CompileSourceEventV1
export CompileSourceGitChangeV1
export CompileSourceInventoryV1, CompileSourceInventoryReadV1
export CompileSourceInventoryChangeV1
export compile_source_inventory_apply_event_v1
export compile_source_inventory_git_event_v1
export compile_source_inventory_filesystem_event_v1
export compile_source_inventory_apply_git_changes_v1
export compile_source_inventory_apply_filesystem_events_v1
export compile_source_inventory_encode_v1, compile_source_inventory_decode_v1
export compile_source_inventory_digest_v1
export compile_source_inventory_publish_v1, compile_source_inventory_read_current_v1
export compile_source_inventory_recover_v1
export compile_source_inventory_snapshot_rows_v1
