# SCV-IMPL-I-02 — snapshot-path FileEntityId integration + `scv file-history`.
#
# Every implicit snapshot resolves file identity: the pre-snapshot status
# index is compared with the post-snapshot one and reconciled into the
# persistent identity store (identity.spl). Evidence order (plan I-02):
#   editor txn > rename pair > exact content > similarity > user
# Editor-transaction evidence arrives as explicit rename hints (the event
# layer / CLI passes them); rename-pair covers case-only renames; exact
# content match is an accepted move; similarity is only ever `suggested`
# and never moves current_path (identity.spl invariant).

use app.io.mod (file_exists, file_read)
use std.scv.core.{scv_status_index_path, scv_chunk_path, scv_line_set_contains}
use std.scv.working_copy.{scv_snapshot, scv_line_chunk}
use std.scv.identity.{scv_identity_allocate, scv_identity_lookup_by_path, scv_identity_state, scv_identity_current_path, scv_identity_record_move, scv_identity_record_delete, scv_identity_history}

val SCV_SIMILARITY_SUGGEST_MILLI = 600

fn scv_history_read_index(root: text) -> text:
    val path = scv_status_index_path(root)
    if file_exists(path):
        file_read(path)
    else:
        ""

fn scv_history_index_rows(index: text) -> [text]:
    var out: [text] = []
    for line in index.split("\n"):
        val trimmed = line.trim()
        if trimmed != "":
            out.push(trimmed)
    out

fn scv_history_row_path(row: text) -> text:
    val parts = row.split("|")
    if parts.len() >= 1:
        parts[0]
    else:
        ""

fn scv_history_lower(value: text) -> text:
    value.lower()

fn scv_history_chunk_text(root: text, chunk: text) -> text:
    val path = scv_chunk_path(root, chunk)
    if file_exists(path):
        file_read(path)
    else:
        ""

# Fraction (milli) of `a`'s non-empty lines also present in `b`.
fn scv_history_line_overlap_milli(a: text, b: text) -> i64:
    var total = 0
    var hit = 0
    var b_set = ""
    for line in b.split("\n"):
        val t = line.trim()
        if t != "":
            b_set = b_set + t + "\n"
    for line in a.split("\n"):
        val t = line.trim()
        if t == "":
            continue
        total = total + 1
        if scv_line_set_contains(b_set, t):
            hit = hit + 1
    if total == 0:
        return 0
    hit * 1000 / total

fn scv_history_hint_target(rename_hints: [text], old_path: text) -> text:
    # Hints are "old|new" rows supplied by the editor txn / CLI.
    for hint in rename_hints:
        val parts = hint.split("|")
        if parts.len() == 2 and parts[0] == old_path:
            return parts[1]
    ""

# Reconcile identity between two status indexes at `commit`.
# Returns the log of identity decisions, one line each.
fn scv_identity_reconcile(root: text, old_index: text, new_index: text, commit: text, rename_hints: [text]) -> text:
    val old_rows = scv_history_index_rows(old_index)
    val new_rows = scv_history_index_rows(new_index)
    var new_paths = ""
    for row in new_rows:
        new_paths = new_paths + scv_history_row_path(row) + "\n"
    var old_paths = ""
    for row in old_rows:
        old_paths = old_paths + scv_history_row_path(row) + "\n"
    # vanished old rows and appeared new rows
    var vanished: [text] = []
    for row in old_rows:
        if not scv_line_set_contains(new_paths, scv_history_row_path(row)):
            vanished.push(row)
    var out = ""
    var consumed = ""
    for row in new_rows:
        val rel = scv_history_row_path(row)
        val chunk = scv_line_chunk(row)
        if scv_line_set_contains(old_paths, rel):
            # path survived: ensure it has an id (first snapshot bootstrap)
            if scv_identity_lookup_by_path(root, rel) == "":
                val id = scv_identity_allocate(root, rel, commit)
                out = out + "identity {id} create {rel}\n"
            continue
        # appeared path — evidence order over vanished candidates
        var matched = ""
        var evidence = ""
        var confidence = 0
        var status = ""
        # 1) editor txn / rename pair hint (highest evidence)
        for old_row in vanished:
            val old_rel = scv_history_row_path(old_row)
            if scv_line_set_contains(consumed, old_rel):
                continue
            if scv_history_hint_target(rename_hints, old_rel) == rel:
                matched = old_rel
                evidence = "rename_pair"
                confidence = 1000
                status = "accepted"
        # 2) case-only rename counts as a rename pair
        if matched == "":
            for old_row in vanished:
                val old_rel = scv_history_row_path(old_row)
                if scv_line_set_contains(consumed, old_rel):
                    continue
                if scv_history_lower(old_rel) == scv_history_lower(rel):
                    matched = old_rel
                    evidence = "case_rename"
                    confidence = 1000
                    status = "accepted"
        # 3) exact content
        if matched == "":
            for old_row in vanished:
                val old_rel = scv_history_row_path(old_row)
                if scv_line_set_contains(consumed, old_rel):
                    continue
                if scv_line_chunk(old_row) == chunk:
                    matched = old_rel
                    evidence = "exact_content"
                    confidence = 1000
                    status = "accepted"
        # 4) similarity — only ever suggested, never moves current_path
        if matched == "":
            val new_text = scv_history_chunk_text(root, chunk)
            for old_row in vanished:
                val old_rel = scv_history_row_path(old_row)
                if scv_line_set_contains(consumed, old_rel):
                    continue
                val old_text = scv_history_chunk_text(root, scv_line_chunk(old_row))
                val overlap = scv_history_line_overlap_milli(old_text, new_text)
                if overlap >= SCV_SIMILARITY_SUGGEST_MILLI and overlap > confidence:
                    matched = old_rel
                    evidence = "similarity"
                    confidence = overlap
                    status = "suggested"
        if matched != "":
            val id = scv_identity_record_move(root, matched, rel, commit, evidence, confidence, status)
            out = out + "identity {id} move {matched} -> {rel} evidence={evidence} status={status}\n"
            consumed = consumed + matched + "\n"
            if status == "suggested":
                # 5) user decision pending — the new path still needs an id of
                # its own until the suggestion is accepted.
                val new_id = scv_identity_allocate(root, rel, commit)
                out = out + "identity {new_id} create {rel} (pending suggestion)\n"
        else:
            val id = scv_identity_allocate(root, rel, commit)
            out = out + "identity {id} create {rel}\n"
    # unmatched vanished rows are terminal deletes (atomic-save temporaries
    # never appear in a snapshot index, so tmp-write-rename-delete coalesces
    # to a plain content update of the target path)
    for old_row in vanished:
        val old_rel = scv_history_row_path(old_row)
        if scv_line_set_contains(consumed, old_rel):
            continue
        val id = scv_identity_record_delete(root, old_rel, commit)
        if id != "":
            out = out + "identity {id} delete {old_rel}\n"
    out

# Snapshot with identity resolution — the implicit-snapshot entry point.
fn scv_snapshot_with_identity(root: text, rename_hints: [text]) -> text:
    val old_index = scv_history_read_index(root)
    val result = scv_snapshot(root)
    if result.starts_with("ERROR"):
        return result
    # "snapshot <commit> <op>\n"
    val parts = result.trim().split(" ")
    val commit = if parts.len() >= 2: parts[1] else: ""
    val new_index = scv_history_read_index(root)
    result + scv_identity_reconcile(root, old_index, new_index, commit, rename_hints)

# `scv file-history <path-or-id>` — resolved id, current path/state, and the
# ordered relation history from the append-only edge log.
fn scv_file_history(root: text, target: text) -> text:
    var id = target
    if not target.starts_with("file_"):
        id = scv_identity_lookup_by_path(root, target)
        if id == "":
            # a deleted path no longer maps live — fall back to any row match
            id = ""
    if id == "" or scv_identity_state(root, id) == "":
        return "ERROR file-history: no identity for {target}\n"
    var out = "file-history {id}\n"
    out = out + "path: {scv_identity_current_path(root, id)}\n"
    out = out + "state: {scv_identity_state(root, id)}\n"
    for row in scv_identity_history(root, id):
        out = out + "edge: {row}\n"
    out

export SCV_SIMILARITY_SUGGEST_MILLI
export scv_identity_reconcile, scv_snapshot_with_identity, scv_file_history
export scv_history_line_overlap_milli
