"""Proposed configuration values. Parsing never establishes accepted authority."""
use std.common.sdn.value.{SdnValue}

pub struct ScvRouteV1:
    id: text
    domain: text
    path: text
    profile: text

pub struct ScvConfigV1:
    schema_version: i64
    profile: text
    validated: bool
    source_sha256: text
    routes_sha256: text
    settings: Dict<text, SdnValue>
    routes: [ScvRouteV1]

# These values must originate in the host's old accepted policy, not in a
# candidate config. Intersection restricts requests; it is not authorization.
pub struct ScvAuthorityConstraintsV1:
    network: bool = false
    executable_providers: bool = false
    llm_proposals: bool = false
    secure_algorithms: [text]
    provider_ids: [text]
    max_worker_memory_bytes: i64
    generation: text

pub struct ScvEffectiveConfigV1:
    source_sha256: text
    routes_sha256: text
    policy_generation: text
    network: bool
    executable_providers: bool
    llm_proposals: bool
    secure_algorithms: [text]
    provider_ids: [text]
    max_worker_memory_bytes: i64
    canonical_sha256: text

export ScvRouteV1, ScvConfigV1, ScvAuthorityConstraintsV1, ScvEffectiveConfigV1
