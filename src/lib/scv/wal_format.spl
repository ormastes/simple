# Pure framing parser for the SCV mutable-state WAL. It validates the entire
# file before returning either clean state, one complete pending transaction,
# or an explicit error. It performs no I/O and never repairs malformed input.

fn scv_wal_line_value(line: text, key: text) -> text:
    for part in line.split(" "):
        if part.starts_with("{key}="):
            return part["{key}=".len():]
    ""

fn scv_wal_parse(wal_content: text) -> [text]:
    var tx_id = ""
    var head_old = ""
    var ws_old = ""
    var new_commit = ""
    var open_tx = false
    var have_head = false
    var have_workspace = false
    var have_commit = false
    for line in wal_content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "":
            continue
        elif trimmed.starts_with("BEGIN "):
            if open_tx:
                return ["ERROR malformed WAL: nested BEGIN while op={tx_id} is pending; state preserved"]
            tx_id = scv_wal_line_value(trimmed, "op")
            if tx_id == "":
                return ["ERROR malformed WAL: BEGIN has no operation id; state preserved"]
            head_old = ""
            ws_old = ""
            new_commit = ""
            have_head = false
            have_workspace = false
            have_commit = false
            open_tx = true
        elif trimmed.starts_with("SET "):
            if not open_tx:
                return ["ERROR malformed WAL: SET without BEGIN; state preserved"]
            val path = scv_wal_line_value(trimmed, "path")
            val old = scv_wal_line_value(trimmed, "old")
            if old == "":
                return ["ERROR malformed WAL: SET has no old value; state preserved"]
            if path == "HEAD_OP":
                if have_head:
                    return ["ERROR malformed WAL: duplicate HEAD_OP SET; state preserved"]
                head_old = old
                have_head = true
            elif path == "meta/workspaces.sdn":
                if have_workspace:
                    return ["ERROR malformed WAL: duplicate workspace SET; state preserved"]
                ws_old = old
                have_workspace = true
            else:
                return ["ERROR malformed WAL: unknown SET path; state preserved"]
        elif trimmed.starts_with("NEW "):
            if not open_tx or have_commit:
                return ["ERROR malformed WAL: unexpected or duplicate NEW; state preserved"]
            new_commit = scv_wal_line_value(trimmed, "commit")
            if new_commit == "":
                return ["ERROR malformed WAL: NEW has no commit id; state preserved"]
            have_commit = true
        elif trimmed.starts_with("COMMIT ") or trimmed.starts_with("ABORT "):
            if not open_tx or scv_wal_line_value(trimmed, "op") != tx_id:
                return ["ERROR malformed WAL: unmatched transaction terminator; state preserved"]
            if not have_head or not have_workspace or not have_commit:
                return ["ERROR malformed WAL: terminal record follows incomplete transaction; state preserved"]
            open_tx = false
        else:
            return ["ERROR malformed WAL: unknown record; state preserved"]
    if not open_tx:
        return ["clean"]
    if not have_head or not have_workspace or not have_commit:
        return ["ERROR unresolved WAL: incomplete recovery record; state preserved"]
    ["pending", tx_id, head_old, ws_old, new_commit]
