# SCV append-only operation/event journal + WAL for mutable head/meta writes.
# Design: doc/01_research/app/tools/scv/scv_v2_final_report_2026-08-25.md §16.1,
# migration stabilization doc §7. Events are one line-framed record per repo
# mutation; the WAL brackets the mutable HEAD_OP/workspace publication with
# BEGIN/COMMIT so an incomplete trailing transaction is rolled back (or rolled
# forward when the head was already published) on the next open — old or new,
# never half.

use app.io.mod (file_exists, file_read, file_delete, dir_create, dir_list)
use std.scv.core.{scv_repo_dir, scv_head_path, scv_workspace_path, scv_status_index_path, scv_object_path}
use std.scv.store.{scv_repo_exists, scv_write_text, scv_fault_exit, scv_object_field, scv_commit_tree}
use std.scv.maintenance.{scv_rebuild_object_index}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}

fn scv_journal_dir(root: text) -> text:
    "{scv_repo_dir(root)}/journal"

fn scv_journal_events_path(root: text) -> text:
    "{scv_journal_dir(root)}/events.log"

fn scv_journal_wal_path(root: text) -> text:
    "{scv_journal_dir(root)}/wal.log"

# Line-framing escape for recorded file content: "%" -> "%25", "\n" -> "%0A",
# " " -> "%20" (WAL fields are space-tokenized), an absent file is "-".
fn scv_journal_encode(value: text) -> text:
    val escaped = value.split("%").join("%25").split("\n").join("%0A").split(" ").join("%20")
    if escaped == "": "%empty" else: escaped

fn scv_journal_decode(value: text) -> text:
    if value == "%empty":
        return ""
    value.split("%0A").join("\n").split("%20").join(" ").split("%25").join("%")

fn scv_journal_append(path: text, line: text) -> bool:
    val old = if file_exists(path): file_read(path) else: ""
    scv_write_text(path, "{old}{line}\n")

# Append-only event record: one line per repository mutation.
fn scv_journal_record_event(root: text, op_id: text, kind: text, refs: text, sha: text) -> bool:
    dir_create(scv_journal_dir(root), true)
    val line = "op={op_id} kind={kind} refs={refs} sha={sha} utc={current_time_ms()}"
    scv_journal_append(scv_journal_events_path(root), line)

fn scv_journal_read_file(path: text) -> text:
    if file_exists(path): file_read(path) else: "-"

# WAL transaction open: record the pre-publication head/workspace state and the
# commit about to be published, then the fault point "wal" (simulated crash
# before any mutable write happened -> recovery rolls back to old).
fn scv_wal_begin(root: text, tx_id: text, new_commit: text) -> bool:
    dir_create(scv_journal_dir(root), true)
    val wal = scv_journal_wal_path(root)
    val head_old = scv_journal_encode(scv_journal_read_file(scv_head_path(root)))
    val ws_old = scv_journal_encode(scv_journal_read_file(scv_workspace_path(root)))
    scv_journal_append(wal, "BEGIN op={tx_id} utc={current_time_ms()}")
    scv_journal_append(wal, "SET path=HEAD_OP old={head_old}")
    scv_journal_append(wal, "SET path=meta/workspaces.sdn old={ws_old}")
    scv_journal_append(wal, "NEW commit={new_commit}")
    scv_fault_exit("wal")
    true

fn scv_wal_commit(root: text, tx_id: text) -> bool:
    scv_journal_append(scv_journal_wal_path(root), "COMMIT op={tx_id}")

# Close a transaction whose guarded write failed WITHOUT crashing, so the next
# open does not report a spurious recovery.
fn scv_wal_abort(root: text, tx_id: text) -> bool:
    scv_journal_append(scv_journal_wal_path(root), "ABORT op={tx_id}")

fn scv_wal_line_value(line: text, key: text) -> text:
    for part in line.split(" "):
        if part.starts_with("{key}="):
            return part["{key}=".len():]
    ""

fn scv_wal_restore(root: text, rel: text, encoded: text):
    val path = if rel == "HEAD_OP": scv_head_path(root) else: scv_workspace_path(root)
    if encoded == "-":
        if file_exists(path):
            file_delete(path)
    else:
        scv_write_text(path, scv_journal_decode(encoded))

# On-open recovery: if the trailing transaction has a BEGIN without a matching
# COMMIT/ABORT, decide by the single publication point (HEAD_OP). Head already
# advanced -> roll FORWARD (publish the recorded workspace pointer); head
# unchanged -> roll BACK the mutable files to their recorded old state.
fn scv_wal_recover(root: text) -> text:
    val wal = scv_journal_wal_path(root)
    if not file_exists(wal):
        return "wal clean\n"
    var tx_id = ""
    var head_old = ""
    var ws_old = ""
    var new_commit = ""
    var open_tx = false
    for line in file_read(wal).split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with("BEGIN "):
            tx_id = scv_wal_line_value(trimmed, "op")
            head_old = ""
            ws_old = ""
            new_commit = ""
            open_tx = true
        elif trimmed.starts_with("SET "):
            if scv_wal_line_value(trimmed, "path") == "HEAD_OP":
                head_old = scv_wal_line_value(trimmed, "old")
            else:
                ws_old = scv_wal_line_value(trimmed, "old")
        elif trimmed.starts_with("NEW "):
            new_commit = scv_wal_line_value(trimmed, "commit")
        elif trimmed.starts_with("COMMIT ") or trimmed.starts_with("ABORT "):
            if scv_wal_line_value(trimmed, "op") == tx_id:
                open_tx = false
    if not open_tx:
        return "wal clean\n"
    val head_now = scv_journal_read_file(scv_head_path(root))
    val head_was = if head_old == "-": "-" else: scv_journal_decode(head_old)
    if head_now != head_was:
        # Head was published: complete the transaction (roll forward).
        if new_commit != "":
            scv_write_text(scv_workspace_path(root), "default: {new_commit}\n")
        scv_journal_append(wal, "COMMIT op={tx_id} recovered=forward")
        "wal recovered op={tx_id} forward\n"
    else:
        scv_wal_restore(root, "HEAD_OP", head_old)
        scv_wal_restore(root, "meta/workspaces.sdn", ws_old)
        scv_journal_append(wal, "ABORT op={tx_id} recovered=rollback")
        "wal recovered op={tx_id} rollback\n"

# --- rebuild-db (MIG-11) -----------------------------------------------------

# Resolve the published commit from the head view (the single publication
# point), never from derived meta.
fn scv_journal_head_commit(root: text) -> text:
    val head = scv_head_path(root)
    val op = if file_exists(head): file_read(head).trim() else: ""
    if op == "":
        return ""
    val op_path = scv_object_path(root, "operations", op)
    if not file_exists(op_path):
        return ""
    val view_id = scv_object_field(file_read(op_path), "view")
    val view_path = scv_object_path(root, "operations", view_id)
    if view_id == "" or not file_exists(view_path):
        return ""
    scv_object_field(file_read(view_path), "default")

# Derived indexes/meta are a materialized view over the immutable objects +
# journal: delete them and rebuild from the head commit's tree.
fn scv_rebuild_db(root: text) -> text:
    if not scv_repo_exists(root):
        return "ERROR — nothing was checked (repository not initialized)\n"
    var out = scv_wal_recover(root)
    val commit = scv_journal_head_commit(root)
    if commit == "":
        return "ERROR — nothing was checked (no published head commit)\n"
    val tree = scv_commit_tree(root, commit)
    val tree_path = scv_object_path(root, "trees", tree)
    if tree == "" or not file_exists(tree_path):
        return "ERROR — nothing was checked (missing tree for commit {commit})\n"
    if file_exists(scv_status_index_path(root)):
        file_delete(scv_status_index_path(root))
    val payload = file_read(tree_path)
    var rows = 0
    for line in payload.split("\n"):
        if line.trim() != "":
            rows = rows + 1
    scv_write_text(scv_status_index_path(root), payload)
    scv_write_text(scv_workspace_path(root), "default: {commit}\n")
    val idx = scv_rebuild_object_index(root)
    out = out + "status index rows={rows}\n" + idx
    if idx.starts_with("ERROR"):
        out + "FAIL — derived state rebuild incomplete (object index)\n"
    else:
        out + "PASS — derived state rebuilt (status index {rows} row(s); object index)\n"

# --- SCV-IMPL-E-03: event batches into the WAL journal ---------------------
# Watcher event batches land as PENDING files under journal/event_batches/,
# then commit into the append-only events.log (one framed line per event,
# op = batch id) with a durable .committed marker. Replay walks the pending
# set and is idempotent: an already-committed batch is never re-appended.

fn scv_event_batches_dir(root: text) -> text:
    "{scv_journal_dir(root)}/event_batches"

fn scv_event_batch_pending_path(root: text, batch_id: text) -> text:
    "{scv_event_batches_dir(root)}/{batch_id}.pending"

fn scv_event_batch_committed_path(root: text, batch_id: text) -> text:
    "{scv_event_batches_dir(root)}/{batch_id}.committed"

fn scv_event_batch_is_committed(root: text, batch_id: text) -> bool:
    file_exists(scv_event_batch_committed_path(root, batch_id))

# Record one event into a pending (uncommitted) batch.
fn scv_event_batch_record(root: text, batch_id: text, kind: text, path: text, related: text) -> bool:
    dir_create(scv_event_batches_dir(root), true)
    val line = "kind={kind} path={scv_journal_encode(path)} related={scv_journal_encode(related)}"
    scv_journal_append(scv_event_batch_pending_path(root, batch_id), line)

# Commit a pending batch: append its events to events.log, write the durable
# committed marker, remove the pending file. Idempotent — a batch that already
# carries a committed marker only has its stray pending file cleared.
fn scv_event_batch_commit(root: text, batch_id: text) -> bool:
    val pending = scv_event_batch_pending_path(root, batch_id)
    if scv_event_batch_is_committed(root, batch_id):
        if file_exists(pending):
            file_delete(pending)
        return true
    if not file_exists(pending):
        return false
    for line in file_read(pending).split("\n"):
        val trimmed = line.trim()
        if trimmed != "":
            scv_journal_record_event(root, batch_id, "fsevent", trimmed.split(" ").join(","), "-")
    scv_write_text(scv_event_batch_committed_path(root, batch_id), "committed utc={current_time_ms()}\n")
    file_delete(pending)
    true

# Replay: commit every pending batch found on disk. Returns how many batches
# were newly committed; a second replay over the same state returns 0 and
# leaves events.log byte-identical (idempotent).
fn scv_event_batch_replay(root: text) -> i64:
    val dirp = scv_event_batches_dir(root)
    var committed = 0
    for name in dir_list(dirp):
        val trimmed = name.trim()
        if trimmed.ends_with(".pending"):
            val batch_id = trimmed[:trimmed.len() - ".pending".len()]
            if not scv_event_batch_is_committed(root, batch_id):
                if scv_event_batch_commit(root, batch_id):
                    committed = committed + 1
            else:
                scv_event_batch_commit(root, batch_id)
    committed

# Committed fs-event view of the journal (CLI `scv events`).
fn scv_event_log(root: text) -> text:
    val events = scv_journal_events_path(root)
    if not file_exists(events):
        return "no events\n"
    var out = ""
    for line in file_read(events).split("\n"):
        if line.contains(" kind=fsevent "):
            out = out + line + "\n"
    if out == "":
        return "no events\n"
    out
