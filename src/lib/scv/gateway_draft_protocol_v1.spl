"""Bounded SCV local draft blob transfer protocol. No Git or publication claim."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.base_encoding.base64.{base64_encode_bytes, base64_decode_bytes}
use std.common.crypto.sha256.{sha256_u8_hex}

pub val SCV_GATEWAY_DRAFT_MAX_BLOB_BYTES_V1: i64 = 1048576
pub val SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1: i64 = 1405000
pub val SCV_GATEWAY_DRAFT_MAX_RESPONSE_BYTES_V1: i64 = 1405000

pub struct ScvGatewayDraftRequestV1:
    version: i64
    id: text
    repository: text
    method: text
    request_id: text
    content_sha256: text
    bytes: [u8]

impl ScvGatewayDraftRequestV1:
    fn __eq__(other: ScvGatewayDraftRequestV1) -> bool:
        self.version == other.version and self.id == other.id and self.repository == other.repository and
            self.method == other.method and self.request_id == other.request_id and
            self.content_sha256 == other.content_sha256 and self.bytes == other.bytes

pub struct ScvGatewayDraftResponseV1:
    version: i64
    id: text
    repository: text
    principal_id: text
    method: text
    request_id: text
    status: text
    content_sha256: text
    byte_count: i64
    state: text
    payload: [u8]
    error: text

impl ScvGatewayDraftResponseV1:
    fn __eq__(other: ScvGatewayDraftResponseV1) -> bool:
        self.version == other.version and self.id == other.id and self.repository == other.repository and
        self.principal_id == other.principal_id and self.method == other.method and
            self.request_id == other.request_id and self.status == other.status and
            self.content_sha256 == other.content_sha256 and self.byte_count == other.byte_count and
            self.state == other.state and self.payload == other.payload and self.error == other.error

fn _draft_protocol_id_v1(value: text, bound: i64) -> bool:
    if value.len() <= 0 or value.len() > bound or value == "." or value == "..": return false
    for byte in value.bytes():
        val ch = byte.to_i64()
        if not ((ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
            (ch >= 97 and ch <= 122) or ch == 45 or ch == 46 or ch == 95): return false
    true

fn _draft_protocol_digest_v1(value: text) -> bool:
    if value.len() != 64: return false
    for byte in value.bytes():
        val ch = byte.to_i64()
        if not ((ch >= 48 and ch <= 57) or (ch >= 97 and ch <= 102)): return false
    true

fn _draft_protocol_fields_v1(source: text, names: [text], bound: i64) -> Result<Dict<text, SdnValue>, text>:
    if source.len() <= 0 or source.len() > bound: return Err("draft_wire_limit")
    val limits = SdnStrictLimitsV1(max_source_bytes: bound, max_depth: 2,
        max_nodes: 32, max_rows: 0, max_cells: 0, max_columns: 0)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(_): return Err("draft_sdn_invalid")
    match parsed.value:
        case Dict(fields):
            for key in fields.keys():
                if not names.contains(key): return Err("draft_unknown_field")
            for key in names:
                if not fields.contains_key(key): return Err("draft_missing_field")
            Ok(fields)
        case _: Err("draft_mapping_required")

fn _draft_protocol_text_v1(value: SdnValue) -> Result<text, text>:
    match value:
        case String(text_value): Ok(text_value)
        case _: Err("draft_text_required")

fn _draft_protocol_int_v1(value: SdnValue) -> Result<i64, text>:
    match value:
        case Int(integer): Ok(integer)
        case _: Err("draft_integer_required")

pub fn scv_gateway_draft_request_validate_v1(request: ScvGatewayDraftRequestV1,
        pinned_repository: text) -> Result<(), text>:
    if request.version != 1 or not _draft_protocol_id_v1(request.id, 128) or
        not _draft_protocol_id_v1(request.repository, 128) or request.repository != pinned_repository or
        not _draft_protocol_id_v1(request.request_id, 128): return Err("draft_subject_invalid")
    if not _draft_protocol_digest_v1(request.content_sha256): return Err("draft_digest_invalid")
    if request.method == "put":
        if request.bytes.len() as i64 > SCV_GATEWAY_DRAFT_MAX_BLOB_BYTES_V1 or
            sha256_u8_hex(request.bytes) != request.content_sha256: return Err("draft_payload_invalid")
    elif request.method == "get":
        if request.bytes.len() != 0: return Err("draft_payload_unexpected")
    else: return Err("draft_method_invalid")
    Ok(())

pub fn scv_gateway_draft_request_encode_v1(request: ScvGatewayDraftRequestV1,
        pinned_repository: text) -> Result<text, text>:
    scv_gateway_draft_request_validate_v1(request, pinned_repository)?
    # A conservative fixed-field allowance lets us prove the canonical wire
    # bound before allocating the base64 representation.
    val encoded_bound = ((request.bytes.len() as i64 + 2) / 3) * 4
    if encoded_bound + 1024 > SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1: return Err("draft_wire_limit")
    val payload = if request.method == "put": base64_encode_bytes(request.bytes) else: ""
    val fields: Dict<text, SdnValue> = {
        "version": SdnValue.Int(1), "id": SdnValue.String(request.id),
        "repository": SdnValue.String(request.repository), "method": SdnValue.String(request.method),
        "request_id": SdnValue.String(request.request_id),
        "content_sha256": SdnValue.String(request.content_sha256),
        "payload_encoding": SdnValue.String("base64"), "payload": SdnValue.String(payload)}
    val wire = sdn_encode_canonical(SdnValue.Dict(fields))
    if wire.len() > SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1: return Err("draft_wire_limit")
    Ok(wire)

pub fn scv_gateway_draft_request_decode_v1(source: text) -> Result<ScvGatewayDraftRequestV1, text>:
    val fields = _draft_protocol_fields_v1(source,
        ["version", "id", "repository", "method", "request_id", "content_sha256", "payload_encoding", "payload"],
        SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1)?
    val version = _draft_protocol_int_v1(fields["version"])?
    val id = _draft_protocol_text_v1(fields["id"])?
    val repository = _draft_protocol_text_v1(fields["repository"])?
    val method = _draft_protocol_text_v1(fields["method"])?
    val request_id = _draft_protocol_text_v1(fields["request_id"])?
    val digest = _draft_protocol_text_v1(fields["content_sha256"])?
    if _draft_protocol_text_v1(fields["payload_encoding"])? != "base64": return Err("draft_encoding_invalid")
    val encoded = _draft_protocol_text_v1(fields["payload"])?
    if method == "get" and encoded != "": return Err("draft_payload_unexpected")
    if encoded.len() > 1398104: return Err("draft_payload_limit")
    val bytes = if method == "put": base64_decode_bytes(encoded) else: []
    if method == "put" and base64_encode_bytes(bytes) != encoded: return Err("draft_payload_encoding_invalid")
    val request = ScvGatewayDraftRequestV1(version: version, id: id, repository: repository,
        method: method, request_id: request_id, content_sha256: digest, bytes: bytes)
    scv_gateway_draft_request_validate_v1(request, repository)?
    if scv_gateway_draft_request_encode_v1(request, repository)? != source:
        return Err("draft_request_noncanonical")
    Ok(request)

pub fn scv_gateway_draft_response_encode_v1(response: ScvGatewayDraftResponseV1,
        request: ScvGatewayDraftRequestV1, pinned_repository: text,
        expected_principal: text) -> Result<text, text>:
    scv_gateway_draft_request_validate_v1(request, pinned_repository)?
    if response.version != 1 or response.id != request.id or response.repository != request.repository or
        not _draft_protocol_id_v1(response.principal_id, 128) or response.principal_id != expected_principal or
        response.method != request.method or response.request_id != request.request_id: return Err("draft_response_subject")
    if response.status == "ok":
        if response.error != "" or response.content_sha256 != request.content_sha256 or
            response.byte_count < 0 or response.byte_count > SCV_GATEWAY_DRAFT_MAX_BLOB_BYTES_V1:
            return Err("draft_response_invalid")
        if request.method == "put":
            if response.state != "local_durable" or response.payload.len() != 0 or
                response.byte_count != request.bytes.len() as i64: return Err("draft_receipt_invalid")
        elif response.state != "local_readback" or response.payload.len() as i64 != response.byte_count or
             sha256_u8_hex(response.payload) != response.content_sha256: return Err("draft_readback_invalid")
    elif not ["denied", "not_found", "error"].contains(response.status) or response.state != "" or
         response.payload.len() != 0 or response.content_sha256 != request.content_sha256 or
         response.byte_count != 0 or response.error.len() == 0 or response.error.len() > 80:
        return Err("draft_response_invalid")
    if response.status != "ok":
        for byte in response.error.bytes():
            val ch = byte.to_i64()
            if not ((ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95):
                return Err("draft_error_code_invalid")
    val fields: Dict<text, SdnValue> = {
        "version": SdnValue.Int(1), "id": SdnValue.String(response.id),
        "repository": SdnValue.String(response.repository), "principal_id": SdnValue.String(response.principal_id),
        "method": SdnValue.String(response.method),
        "request_id": SdnValue.String(response.request_id), "status": SdnValue.String(response.status),
        "content_sha256": SdnValue.String(response.content_sha256), "byte_count": SdnValue.Int(response.byte_count),
        "state": SdnValue.String(response.state), "payload_encoding": SdnValue.String("base64"),
        "payload": SdnValue.String(base64_encode_bytes(response.payload)), "error": SdnValue.String(response.error)}
    val wire = sdn_encode_canonical(SdnValue.Dict(fields))
    if wire.len() > SCV_GATEWAY_DRAFT_MAX_RESPONSE_BYTES_V1: return Err("draft_response_limit")
    Ok(wire)

pub fn scv_gateway_draft_response_decode_v1(source: text, request: ScvGatewayDraftRequestV1,
        pinned_repository: text, expected_principal: text) -> Result<ScvGatewayDraftResponseV1, text>:
    val fields = _draft_protocol_fields_v1(source,
        ["version", "id", "repository", "principal_id", "method", "request_id", "status", "content_sha256", "byte_count", "state", "payload_encoding", "payload", "error"],
        SCV_GATEWAY_DRAFT_MAX_RESPONSE_BYTES_V1)?
    if _draft_protocol_text_v1(fields["payload_encoding"])? != "base64": return Err("draft_encoding_invalid")
    val encoded = _draft_protocol_text_v1(fields["payload"])?
    if encoded.len() > 1398104: return Err("draft_payload_limit")
    val payload = base64_decode_bytes(encoded)
    if base64_encode_bytes(payload) != encoded: return Err("draft_payload_encoding_invalid")
    val response = ScvGatewayDraftResponseV1(version: _draft_protocol_int_v1(fields["version"])? ,
        id: _draft_protocol_text_v1(fields["id"])?, repository: _draft_protocol_text_v1(fields["repository"])?,
        principal_id: _draft_protocol_text_v1(fields["principal_id"])?,
        method: _draft_protocol_text_v1(fields["method"])?, request_id: _draft_protocol_text_v1(fields["request_id"])?,
        status: _draft_protocol_text_v1(fields["status"])?, content_sha256: _draft_protocol_text_v1(fields["content_sha256"])?,
        byte_count: _draft_protocol_int_v1(fields["byte_count"])?, state: _draft_protocol_text_v1(fields["state"])?,
        payload: payload, error: _draft_protocol_text_v1(fields["error"])?)
    val checked = scv_gateway_draft_response_encode_v1(response, request, pinned_repository, expected_principal)?
    if checked != source: return Err("draft_response_noncanonical")
    Ok(response)

export ScvGatewayDraftRequestV1, ScvGatewayDraftResponseV1
export SCV_GATEWAY_DRAFT_MAX_BLOB_BYTES_V1, SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1, SCV_GATEWAY_DRAFT_MAX_RESPONSE_BYTES_V1
export scv_gateway_draft_request_validate_v1, scv_gateway_draft_request_encode_v1, scv_gateway_draft_request_decode_v1
export scv_gateway_draft_response_encode_v1, scv_gateway_draft_response_decode_v1
