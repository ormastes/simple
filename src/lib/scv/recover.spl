# SCV staged recovery (MIG-22, stabilization §12).
#
# `scv recover --level <0..5>`:
#   0  rebuild derived indexes (parser index invalidation + rebuild-db)
#   1  rebuild DB from journal/objects (WAL recovery + rebuild-db)
#   2  reconstruct heads from the operation DAG (newest tip op wins)
#   3  reconstruct from a git backend checkout (--git <path>): re-init + import + snapshot
#   4  checkpoint restore + journal replay (--checkpoint <id>)
#   5  report-only: what GitHub-only recovery preserves/loses; modifies nothing
# Levels 0-4 end with doctor + fsck; the verdict is always the last line.

use app.io.mod (file_exists, file_read, file_delete, dir_walk, dir_create, process_run)
use std.nogc_sync_mut.io.file_ops.{file_read_bytes, file_write_bytes, file_modified_time}
use std.scv.core.{scv_repo_dir, scv_objects_dir, scv_head_path, scv_workspace_path, scv_object_path, scv_parser_index_path, scv_line_set_contains}
use std.scv.store.{scv_repo_exists, scv_init_repo, scv_write_text, scv_create_parent_dir, scv_object_field}
use std.scv.journal.{scv_wal_recover, scv_rebuild_db, scv_journal_events_path}
use std.scv.stabilize.{scv_doctor, scv_checkpoint_verify, scv_checkpoints_dir}
use std.scv.integrity.{scv_fsck}
use std.scv.working_copy.{scv_snapshot}

fn scv_recover_verdict_line(result: text) -> text:
    var verdict = ""
    for line in result.split("\n"):
        if line.trim() != "":
            verdict = line.trim()
    verdict

# Common tail for levels 0-4: doctor + fsck, then the house verdict.
fn scv_recover_finish(root: text, level: i64, out: text) -> text:
    val doctor = scv_doctor(root)
    val fsck = scv_fsck(root)
    var combined = out + doctor + fsck
    val doctor_ok = scv_recover_verdict_line(doctor).starts_with("PASS")
    val fsck_ok = fsck.starts_with("OK")
    if doctor_ok and fsck_ok:
        combined + "PASS — recover level {level} complete (doctor PASS, fsck OK)\n"
    elif not doctor_ok:
        combined + "FAIL — recover level {level}: doctor did not pass\n"
    else:
        combined + "FAIL — recover level {level}: fsck not clean\n"

fn scv_recover_level_0(root: text) -> text:
    var out = ""
    val parser_index = scv_parser_index_path(root)
    if file_exists(parser_index):
        file_delete(parser_index)
        out = out + "parser index invalidated\n"
    val rebuilt = scv_rebuild_db(root)
    if rebuilt.starts_with("ERROR"):
        return out + rebuilt
    scv_recover_finish(root, 0, out + rebuilt)

fn scv_recover_level_1(root: text) -> text:
    var out = scv_wal_recover(root)
    val rebuilt = scv_rebuild_db(root)
    if rebuilt.starts_with("ERROR"):
        return out + rebuilt
    scv_recover_finish(root, 1, out + rebuilt)

# Level 2: op objects carry "view:"; view objects do not. Tips are op objects
# never referenced as a parent; the newest tip (mtime) becomes HEAD_OP.
fn scv_recover_level_2(root: text) -> text:
    val ops_dir = "{scv_objects_dir(root)}/operations"
    if not file_exists(ops_dir):
        return "ERROR — nothing was checked (no operations directory)\n"
    var op_rows: [text] = []
    var parents = ""
    for path in dir_walk(ops_dir):
        val content = file_read(path)
        if scv_object_field(content, "view") == "":
            continue
        val parts = path.split("/")
        val name = parts[parts.len() - 1]
        val id = if name.ends_with(".sdn"): name[0:name.len() - 4] else: name
        op_rows.push("{id}|{path}")
        for parent in scv_object_field(content, "parents").split(","):
            val p = parent.trim()
            if p != "":
                parents = parents + p + "\n"
    var best_id = ""
    var best_mtime = -1
    for row in op_rows:
        val parts = row.split("|")
        if scv_line_set_contains(parents, parts[0]):
            continue
        val mtime = file_modified_time(parts[1])
        if mtime > best_mtime:
            best_mtime = mtime
            best_id = parts[0]
    if best_id == "":
        return "ERROR — nothing was checked (no tip operation found)\n"
    var out = "head reconstructed from operation DAG: {best_id}\n"
    scv_write_text(scv_head_path(root), "{best_id}\n")
    val view_id = scv_object_field(file_read(scv_object_path(root, "operations", best_id)), "view")
    val view_path = scv_object_path(root, "operations", view_id)
    if view_id != "" and file_exists(view_path):
        val commit = scv_object_field(file_read(view_path), "default")
        if commit != "":
            scv_write_text(scv_workspace_path(root), "default: {commit}\n")
    val rebuilt = scv_rebuild_db(root)
    if rebuilt.starts_with("ERROR"):
        return out + rebuilt
    scv_recover_finish(root, 2, out + rebuilt)

fn scv_recover_level_3(root: text, git_dir: text) -> text:
    if git_dir == "":
        return "FAIL — recover level 3 requires --git <path>\n"
    if not file_exists(git_dir):
        return "ERROR — nothing was checked (missing git backend: {git_dir})\n"
    var out = ""
    if not scv_repo_exists(root):
        out = out + scv_init_repo(root)
        if out.starts_with("ERROR"):
            return out
    val (ls_out, ls_err, ls_code) = process_run("git", ["-C", git_dir, "ls-files"])
    if ls_code != 0:
        return out + "ERROR — nothing was checked (git ls-files failed: {ls_err.trim()})\n"
    var imported = 0
    for line in ls_out.split("\n"):
        val rel = line.trim()
        if rel == "":
            continue
        val src = "{git_dir}/{rel}"
        if not file_exists(src):
            continue
        val dst = "{root}/{rel}"
        scv_create_parent_dir(dst)
        file_write_bytes(dst, file_read_bytes(src) ?? [])
        imported = imported + 1
    if imported == 0:
        return out + "ERROR — nothing was checked (git backend has no files)\n"
    out = out + "imported {imported} file(s) from git backend\n"
    val snap = scv_snapshot(root)
    if snap.starts_with("ERROR"):
        return out + snap
    scv_recover_finish(root, 3, out + snap)

# Level 4: restore checkpointed state, then replay journal events recorded
# after the checkpoint whose operation objects still exist and verify.
fn scv_recover_level_4(root: text, checkpoint: text) -> text:
    if checkpoint == "":
        return "FAIL — recover level 4 requires --checkpoint <id>\n"
    val verify = scv_checkpoint_verify(root, checkpoint)
    if not verify.starts_with("OK"):
        return verify + "FAIL — recover level 4: checkpoint {checkpoint} did not verify\n"
    val data_dir = "{scv_checkpoints_dir(root)}/{checkpoint}/data"
    val prefix = "{data_dir}/"
    var restored = 0
    for path in dir_walk(data_dir):
        if not path.starts_with(prefix):
            continue
        val rel = path[prefix.len():]
        val dst = "{scv_repo_dir(root)}/{rel}"
        scv_create_parent_dir(dst)
        file_write_bytes(dst, file_read_bytes(path) ?? [])
        restored = restored + 1
    var out = verify + "restored {restored} file(s) from checkpoint {checkpoint}\n"
    # journal replay: advance HEAD_OP to the newest journaled op that still exists
    val events_path = scv_journal_events_path(root)
    var replay_op = ""
    if file_exists(events_path):
        for line in file_read(events_path).split("\n"):
            val trimmed = line.trim()
            if not trimmed.starts_with("op="):
                continue
            val op_id = trimmed[3:].split(" ")[0]
            val op_path = scv_object_path(root, "operations", op_id)
            if op_id == "" or not file_exists(op_path):
                continue
            val view_id = scv_object_field(file_read(op_path), "view")
            if view_id != "" and file_exists(scv_object_path(root, "operations", view_id)):
                replay_op = op_id
    if replay_op != "":
        scv_write_text(scv_head_path(root), "{replay_op}\n")
        out = out + "journal replay advanced HEAD_OP to {replay_op}\n"
    val rebuilt = scv_rebuild_db(root)
    if rebuilt.starts_with("ERROR"):
        return out + rebuilt
    scv_recover_finish(root, 4, out + rebuilt)

fn scv_recover_count_kind(root: text, kind: text) -> i64:
    val dir = "{scv_objects_dir(root)}/{kind}"
    if not file_exists(dir):
        return 0
    var count = 0
    for item in dir_walk(dir):
        count = count + 1
    count

# Level 5: report only. GitHub-only recovery keeps source history; SCV
# semantic history (changes, operations, identity, checkpoints, conflicts)
# would be lost. Never modifies the repository.
fn scv_recover_level_5(root: text) -> text:
    var out = "recover level 5 (GitHub only) — report, nothing modified\n"
    out = out + "preserved: source files and git commit history from the GitHub remote\n"
    out = out + "lost: changes={scv_recover_count_kind(root, \"changes\")}"
    out = out + " operations={scv_recover_count_kind(root, \"operations\")}"
    out = out + " conflicts={scv_recover_count_kind(root, \"conflicts\")}"
    val identity_path = "{root}/.scv/meta/file_identity.sdn"
    var identity_rows = 0
    if file_exists(identity_path):
        for line in file_read(identity_path).split("\n"):
            if line.trim() != "":
                identity_rows = identity_rows + 1
    out = out + " identity_rows={identity_rows}"
    var checkpoints = 0
    val checkpoints_dir = scv_checkpoints_dir(root)
    if file_exists(checkpoints_dir):
        for path in dir_walk(checkpoints_dir):
            if path.ends_with("/manifest.sdn"):
                checkpoints = checkpoints + 1
    out = out + " checkpoints={checkpoints}\n"
    out + "PASS — recover level 5 report complete (semantic history above would be lost)\n"

fn scv_recover(root: text, args: [text]) -> text:
    var level = -1
    var git_dir = ""
    var checkpoint = ""
    var i = 1
    while i < args.len():
        val arg = args[i]
        if arg == "--level" and i + 1 < args.len():
            level = args[i + 1].to_i64() ?? -1
            i = i + 1
        elif arg.starts_with("--level="):
            level = arg[8:].to_i64() ?? -1
        elif arg == "--git" and i + 1 < args.len():
            git_dir = args[i + 1]
            i = i + 1
        elif arg == "--checkpoint" and i + 1 < args.len():
            checkpoint = args[i + 1]
            i = i + 1
        elif arg.starts_with("--checkpoint="):
            checkpoint = arg[13:]
        else:
            return "FAIL — unknown recover option: {arg}\n"
        i = i + 1
    if level < 0 or level > 5:
        return "FAIL — recover requires --level <0..5>\n"
    # Levels 2/4/5 must work with a damaged repo (e.g. deleted HEAD_OP): only
    # require the .scv directory itself; levels 0/1 need an intact head.
    if level != 3 and not file_exists(scv_repo_dir(root)):
        return "ERROR — nothing was checked (repository not initialized)\n"
    if (level == 0 or level == 1) and not scv_repo_exists(root):
        return "ERROR — nothing was checked (repository head missing; try --level 2)\n"
    if level == 0:
        scv_recover_level_0(root)
    elif level == 1:
        scv_recover_level_1(root)
    elif level == 2:
        scv_recover_level_2(root)
    elif level == 3:
        scv_recover_level_3(root, git_dir)
    elif level == 4:
        scv_recover_level_4(root, checkpoint)
    else:
        scv_recover_level_5(root)
