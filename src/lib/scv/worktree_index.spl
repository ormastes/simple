# SCV persistent binary worktree index (SCV-IMPL-E-05).
#
# Entries keyed by path carrying mode, size, mtime/ctime, BOTH ContentIds
# (worktree + repository, see B-03 dual-byte model), FileId, a per-entry
# clock, plus header-level dirty/ignore generations. Serialized as a
# length-prefixed BINARY record file (magic "SCVIDX1\n", little-endian
# 8-byte i64s, length-prefixed UTF-8 strings) — no pipe/line delimiters,
# so paths containing '|', tab, or space round-trip byte-exactly.
#
# B-04 ADOPTION INTERFACE (honest dependency note): plan row E-05 depends on
# SCV-IMPL-B-04 (SQLite-WAL / Simple DB metadata store), owned by another
# lane and not landed. This module is deliberately a self-contained binary
# store whose surface — scv_wtindex_load / save / upsert / get / remove /
# bump_*_gen — is exactly what the B-04 migration replaces with path_state
# table reads/writes. Nothing else in SCV may depend on the on-disk layout.

use std.nogc_sync_mut.io.file_ops.{file_read_bytes, file_write_bytes}

struct ScvWtEntry:
    path: text
    mode: i64
    size: i64
    mtime_ms: i64
    ctime_ms: i64
    worktree_content_id: text
    repository_content_id: text
    file_id: text
    clock: i64
    dirty_gen: i64
    ignore_gen: i64

struct ScvWtIndex:
    dirty_generation: i64
    ignore_generation: i64
    entries: [ScvWtEntry]

fn scv_wtindex_new() -> ScvWtIndex:
    ScvWtIndex(dirty_generation: 0, ignore_generation: 0, entries: [])

fn scv_wtindex_empty_entry() -> ScvWtEntry:
    ScvWtEntry(path: "", mode: 0, size: 0, mtime_ms: 0, ctime_ms: 0,
               worktree_content_id: "", repository_content_id: "", file_id: "",
               clock: 0, dirty_gen: 0, ignore_gen: 0)

fn scv_wtindex_upsert(idx: ScvWtIndex, entry: ScvWtEntry) -> ScvWtIndex:
    var next = idx
    var i = 0
    while i < next.entries.len():
        if next.entries[i].path == entry.path:
            next.entries[i] = entry
            return next
        i = i + 1
    next.entries.push(entry)
    next

fn scv_wtindex_get(idx: ScvWtIndex, path: text) -> ScvWtEntry:
    for e in idx.entries:
        if e.path == path:
            return e
    scv_wtindex_empty_entry()

fn scv_wtindex_remove(idx: ScvWtIndex, path: text) -> ScvWtIndex:
    var next = idx
    var keep: [ScvWtEntry] = []
    for e in next.entries:
        if e.path != path:
            keep.push(e)
    next.entries = keep
    next

fn scv_wtindex_bump_dirty_gen(idx: ScvWtIndex) -> ScvWtIndex:
    var next = idx
    next.dirty_generation = next.dirty_generation + 1
    next

fn scv_wtindex_bump_ignore_gen(idx: ScvWtIndex) -> ScvWtIndex:
    var next = idx
    next.ignore_generation = next.ignore_generation + 1
    next

# ---- binary encoding ----

fn _wt_put_i64(out: [u8], value: i64) -> [u8]:
    var next = out
    var v = value
    var i = 0
    while i < 8:
        next.push((v & 0xFF) as u8)
        v = v >> 8
        i = i + 1
    next

fn _wt_put_str(out: [u8], value: text) -> [u8]:
    val bytes = value.bytes()
    var next = _wt_put_i64(out, bytes.len())
    var i = 0
    while i < bytes.len():
        next.push(bytes[i])
        i = i + 1
    next

fn _wt_get_i64(data: [u8], pos: i64) -> (i64, i64):
    if pos + 8 > data.len():
        return (0, -1)
    var v: i64 = 0
    var i = 7
    while i >= 0:
        v = (v << 8) | (data[pos + i] as i64)
        i = i - 1
    (v, pos + 8)

fn _wt_bytes_to_text(bytes: [u8]) -> text:
    var result = ""
    var i = 0
    while i < bytes.len():
        val b = bytes[i] as i64
        if b == 10:
            result = result + "\n"
        elif b == 13:
            result = result + "\r"
        elif b == 9:
            result = result + "\t"
        else:
            result = result + char_from_code(b)
        i = i + 1
    result

fn _wt_get_str(data: [u8], pos: i64) -> (text, i64):
    val (n, p) = _wt_get_i64(data, pos)
    if p < 0 or n < 0 or p + n > data.len():
        return ("", -1)
    (_wt_bytes_to_text(data[p:p + n]), p + n)

fn scv_wtindex_save(path: text, idx: ScvWtIndex) -> bool:
    var out: [u8] = []
    out = _wt_put_str(out, "SCVIDX1")
    out = _wt_put_i64(out, idx.dirty_generation)
    out = _wt_put_i64(out, idx.ignore_generation)
    out = _wt_put_i64(out, idx.entries.len())
    for e in idx.entries:
        out = _wt_put_str(out, e.path)
        out = _wt_put_i64(out, e.mode)
        out = _wt_put_i64(out, e.size)
        out = _wt_put_i64(out, e.mtime_ms)
        out = _wt_put_i64(out, e.ctime_ms)
        out = _wt_put_str(out, e.worktree_content_id)
        out = _wt_put_str(out, e.repository_content_id)
        out = _wt_put_str(out, e.file_id)
        out = _wt_put_i64(out, e.clock)
        out = _wt_put_i64(out, e.dirty_gen)
        out = _wt_put_i64(out, e.ignore_gen)
    file_write_bytes(path, out)

# Load an index. A missing file or any structural corruption (bad magic,
# truncated field) fails CLOSED to a fresh empty index — callers rescan.
fn scv_wtindex_load(path: text) -> ScvWtIndex:
    val data = file_read_bytes(path) ?? []
    if data.len() == 0:
        return scv_wtindex_new()
    val (magic, p0) = _wt_get_str(data, 0)
    if p0 < 0 or magic != "SCVIDX1":
        return scv_wtindex_new()
    val (dirty, p1) = _wt_get_i64(data, p0)
    val (ignore, p2) = _wt_get_i64(data, p1)
    val (count, p3) = _wt_get_i64(data, p2)
    if p3 < 0 or count < 0:
        return scv_wtindex_new()
    var idx = ScvWtIndex(dirty_generation: dirty, ignore_generation: ignore, entries: [])
    var pos = p3
    var i = 0
    while i < count:
        val (epath, a) = _wt_get_str(data, pos)
        if a < 0:
            return scv_wtindex_new()
        val (mode, b) = _wt_get_i64(data, a)
        val (size, c) = _wt_get_i64(data, b)
        val (mtime, d) = _wt_get_i64(data, c)
        val (ctime, e2) = _wt_get_i64(data, d)
        val (wt_cid, f) = _wt_get_str(data, e2)
        val (repo_cid, g) = _wt_get_str(data, f)
        val (fid, h) = _wt_get_str(data, g)
        val (clock, j) = _wt_get_i64(data, h)
        val (dgen, k) = _wt_get_i64(data, j)
        val (igen, m) = _wt_get_i64(data, k)
        if m < 0:
            return scv_wtindex_new()
        idx.entries.push(ScvWtEntry(path: epath, mode: mode, size: size,
                                    mtime_ms: mtime, ctime_ms: ctime,
                                    worktree_content_id: wt_cid,
                                    repository_content_id: repo_cid,
                                    file_id: fid, clock: clock,
                                    dirty_gen: dgen, ignore_gen: igen))
        pos = m
        i = i + 1
    idx
