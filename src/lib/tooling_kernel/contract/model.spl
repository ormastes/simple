use common.kernel_plugin.ids.{KpfId128, KpfDigest256}

pub enum ToolingStatusV1:
    Ok
    CapacityExceeded
    DocumentNotFound
    SessionNotFound
    RevisionStale
    SnapshotMismatch
    LanguageMismatch
    GenerationMismatch
    Cancelled
    Disconnected

pub struct ToolingDocumentHandleV1:
    slot: i64
    epoch: u64

pub struct ToolingSessionHandleV1:
    slot: i64
    epoch: u64
    generation: u64

pub struct ToolingRequestHandleV1:
    slot: i64
    epoch: u64
    document_revision: u64

pub struct ToolingDocumentSnapshotV1:
    document_id: KpfId128
    language_id: KpfId128
    revision: u64
    content_digest: KpfDigest256

pub struct ToolingOpenDocumentResultV1:
    status: ToolingStatusV1
    handle: ToolingDocumentHandleV1

pub struct ToolingOpenSessionResultV1:
    status: ToolingStatusV1
    handle: ToolingSessionHandleV1

pub struct ToolingBeginRequestResultV1:
    status: ToolingStatusV1
    handle: ToolingRequestHandleV1

pub struct ToolingDiagnosticPublicationV1:
    status: ToolingStatusV1
    accepted_count: u32

pub fn tooling_invalid_document_handle_v1() -> ToolingDocumentHandleV1:
    ToolingDocumentHandleV1(slot: -1, epoch: 0)

pub fn tooling_invalid_session_handle_v1() -> ToolingSessionHandleV1:
    ToolingSessionHandleV1(slot: -1, epoch: 0, generation: 0)

pub fn tooling_invalid_request_handle_v1() -> ToolingRequestHandleV1:
    ToolingRequestHandleV1(slot: -1, epoch: 0, document_revision: 0)
