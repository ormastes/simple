use common.kernel_plugin.ids.{KpfId128, KpfDigest256}
use tooling_kernel.contract.model.*

pub struct ToolingAnalysisRequestV1:
    workspace_id: KpfId128
    language_id: KpfId128
    provider_id: KpfId128
    provider_generation: u64
    document: ToolingDocumentHandleV1
    revision: u64
    content_digest: KpfDigest256
    required_fact_bits: u64

pub struct ToolingAnalysisReceiptV1:
    provider_id: KpfId128
    provider_generation: u64
    revision: u64
    content_digest: KpfDigest256
    completed_fact_bits: u64
    status: ToolingStatusV1

pub fn tooling_adapter_receipt_v1(request: ToolingAnalysisRequestV1, completed_fact_bits: u64, status: ToolingStatusV1) -> ToolingAnalysisReceiptV1:
    ToolingAnalysisReceiptV1(provider_id: request.provider_id, provider_generation: request.provider_generation, revision: request.revision, content_digest: request.content_digest, completed_fact_bits: completed_fact_bits, status: status)
