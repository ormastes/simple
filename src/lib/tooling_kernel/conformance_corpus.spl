"""Canonical IDE conformance corpus decoder shared by native client tests."""

use std.common.sdn.parser.parse
use std.common.sdn.schema.*

pub struct ToolingIdeConformanceV1:
    uri: text
    language: text
    revision: i64
    content_digest: text
    canonical_result_id: text
    authority: text
    coverage: text
    native_source: text
    browser_source: text
    semantic_coverage_complete: bool

pub fn tooling_ide_conformance_decode_v1(content: text) -> Result<ToolingIdeConformanceV1, text>:
    val parsed = parse(content)?
    val issues = SdnDecodeIssues.new()
    val schema = sdn_require_text(parsed, "schema", issues) ?? ""
    val corpus = ToolingIdeConformanceV1(
        uri: sdn_require_text(parsed, "uri", issues) ?? "",
        language: sdn_require_text(parsed, "language", issues) ?? "",
        revision: sdn_require_int(parsed, "revision", issues) ?? -1,
        content_digest: sdn_require_text(parsed, "content_digest", issues) ?? "",
        canonical_result_id: sdn_require_text(parsed, "canonical_result_id", issues) ?? "",
        authority: sdn_require_text(parsed, "authority", issues) ?? "",
        coverage: sdn_require_text(parsed, "coverage", issues) ?? "",
        native_source: sdn_require_text(parsed, "native_source", issues) ?? "",
        browser_source: sdn_require_text(parsed, "browser_source", issues) ?? "",
        semantic_coverage_complete: sdn_require_bool(parsed, "semantic_coverage_complete", issues) ?? false,
    )
    if schema != "simple.tooling.ide-conformance/1" or not issues.is_empty():
        return Err("invalid tooling IDE conformance corpus")
    Ok(corpus)
