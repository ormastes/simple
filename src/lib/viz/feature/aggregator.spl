# Aggregator: collects CompositorFrames per SurfaceId and resolves root frame

use std.viz.entity.compositor_frame.{CompositorFrame}
use std.viz.entity.surface_id.{SurfaceId}
use std.viz.entity.aggregator_entry.{AggregatorEntry}
use std.viz.feature.aggregator_walker.{WalkerContext, walk_and_compose, source_frame_is_admissible_for_composition}

# Registry admission caps prevent disconnected or never-drawn frames from
# consuming unbounded retained memory before aggregate-time graph limits run.
const AGGREGATOR_MAX_REGISTERED_SURFACES: i32 = 128

fn _frame_is_admissible(frame: CompositorFrame) -> bool:
    source_frame_is_admissible_for_composition(frame)

class Aggregator:
    known_frames: [AggregatorEntry]

    static fn new() -> Aggregator:
        Aggregator(known_frames: [])

    me register_frame(entry: AggregatorEntry):
        if not _frame_is_admissible(entry.frame):
            return
        var found = false
        var i = 0
        var result: [AggregatorEntry] = []
        while i < me.known_frames.len().to_i32():
            val existing = me.known_frames[i.to_i64()]
            if existing.surface_id.equals(entry.surface_id):
                result.push(entry)
                found = true
            else:
                result.push(existing)
            i = i + 1
        if found:
            me.known_frames = result
        else if me.known_frames.len().to_i32() < AGGREGATOR_MAX_REGISTERED_SURFACES:
            me.known_frames.push(entry)

    # TODO(viz-aggregator): inline referenced_surfaces' render passes into root frame
    me aggregate(root: SurfaceId) -> CompositorFrame:
        var i = 0
        while i < me.known_frames.len().to_i32():
            val entry = me.known_frames[i.to_i64()]
            if entry.surface_id.equals(root):
                return walk_and_compose(entry.frame, entry.surface_id, WalkerContext.new(me.known_frames))
            i = i + 1
        CompositorFrame.empty()
