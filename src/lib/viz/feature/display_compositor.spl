# DisplayCompositor: top-level compositor that submits and draws frames

use std.viz.entity.compositor_frame.{CompositorFrame}
use std.viz.entity.surface_id.{SurfaceId}
use std.viz.feature.aggregator.{Aggregator}
use std.viz.entity.aggregator_entry.{AggregatorEntry}
use std.skia.entity.geometry.{SkRect}
use std.skia.entity.matrix.{Matrix3x3}

# Presentation allocation is bounded independently of authored logical
# coordinates. This permits 4K at 2x or 8K at 1x while rejecting hostile
# physical targets.
const DISPLAY_MAX_PHYSICAL_EXTENT: f64 = 16384.0
const DISPLAY_MAX_PHYSICAL_PIXELS: f64 = 67108864.0
const DISPLAY_MAX_SCROLL_VIEWPORTS: f64 = 1024.0

fn _finite_coordinate(value: f64) -> bool:
    value == value and value >= -1.0e308 and value <= 1.0e308

fn _valid_rect(rect: SkRect) -> bool:
    _finite_coordinate(rect.left) and _finite_coordinate(rect.top) and
        _finite_coordinate(rect.right) and _finite_coordinate(rect.bottom) and
        not rect.is_empty()

fn _rect_within(rect: SkRect, bounds: SkRect) -> bool:
    rect.left >= bounds.left and rect.top >= bounds.top and
        rect.right <= bounds.right and rect.bottom <= bounds.bottom

fn _absolute(value: f64) -> f64:
    if value < 0.0: -value else: value

fn _metadata_within_output_budget(frame: CompositorFrame, bounds: SkRect) -> bool:
    val metadata = frame.metadata
    if not _finite_coordinate(metadata.device_scale_factor) or
        metadata.device_scale_factor <= 0.0:
        return false
    val width = bounds.right - bounds.left
    val height = bounds.bottom - bounds.top
    val physical_width = width * metadata.device_scale_factor
    val physical_height = height * metadata.device_scale_factor
    if not _finite_coordinate(physical_width) or not _finite_coordinate(physical_height) or
        physical_width > DISPLAY_MAX_PHYSICAL_EXTENT or
        physical_height > DISPLAY_MAX_PHYSICAL_EXTENT or
        physical_width * physical_height > DISPLAY_MAX_PHYSICAL_PIXELS:
        return false
    _finite_coordinate(metadata.root_scroll_offset_x) and
        _finite_coordinate(metadata.root_scroll_offset_y) and
        _absolute(metadata.root_scroll_offset_x) <= width * DISPLAY_MAX_SCROLL_VIEWPORTS and
        _absolute(metadata.root_scroll_offset_y) <= height * DISPLAY_MAX_SCROLL_VIEWPORTS

fn _point_within_output(matrix: Matrix3x3, x: f64, y: f64, bounds: SkRect) -> bool:
    val w = _projective_w(matrix, x, y)
    if not _finite_coordinate(w) or w == 0.0:
        return false
    val transformed_x = (matrix.m00 * x + matrix.m01 * y + matrix.m02) / w
    val transformed_y = (matrix.m10 * x + matrix.m11 * y + matrix.m12) / w
    _finite_coordinate(transformed_x) and _finite_coordinate(transformed_y) and
        transformed_x >= bounds.left and transformed_x <= bounds.right and
        transformed_y >= bounds.top and transformed_y <= bounds.bottom

fn _projective_w(matrix: Matrix3x3, x: f64, y: f64) -> f64:
    matrix.m20 * x + matrix.m21 * y + matrix.m22

fn _transform_maps_rect_within(matrix: Matrix3x3, rect: SkRect, bounds: SkRect) -> bool:
    val top_left_w = _projective_w(matrix, rect.left, rect.top)
    val top_right_w = _projective_w(matrix, rect.right, rect.top)
    val bottom_left_w = _projective_w(matrix, rect.left, rect.bottom)
    val bottom_right_w = _projective_w(matrix, rect.right, rect.bottom)
    if not _finite_coordinate(top_left_w) or not _finite_coordinate(top_right_w) or
        not _finite_coordinate(bottom_left_w) or not _finite_coordinate(bottom_right_w):
        return false
    val all_positive = top_left_w > 0.0 and top_right_w > 0.0 and
        bottom_left_w > 0.0 and bottom_right_w > 0.0
    val all_negative = top_left_w < 0.0 and top_right_w < 0.0 and
        bottom_left_w < 0.0 and bottom_right_w < 0.0
    if not all_positive and not all_negative:
        return false
    _point_within_output(matrix, rect.left, rect.top, bounds) and
        _point_within_output(matrix, rect.right, rect.top, bounds) and
        _point_within_output(matrix, rect.left, rect.bottom, bounds) and
        _point_within_output(matrix, rect.right, rect.bottom, bounds)

# Presentation is the final resource boundary.  Reject rather than clip an
# out-of-bounds composed frame: clipping transforms/effects here would change
# rendering semantics and could still allocate from hostile coordinates.
fn _frame_within_output_bounds(frame: CompositorFrame, bounds: SkRect) -> bool:
    if not _valid_rect(bounds) or not _valid_rect(frame.device_viewport_rect) or
        not _rect_within(frame.device_viewport_rect, bounds) or
        not _metadata_within_output_budget(frame, bounds):
        return false
    var pass_index = 0
    while pass_index < frame.render_pass_list.len().to_i32():
        val render_pass = frame.render_pass_list[pass_index.to_i64()]
        if not _valid_rect(render_pass.output_rect) or
            not _rect_within(render_pass.output_rect, bounds) or
            not _transform_maps_rect_within(
                render_pass.transform_to_root_target, render_pass.output_rect, bounds):
            return false
        if not _valid_rect(render_pass.damage_rect) or
            not _rect_within(render_pass.damage_rect, bounds) or
            not _transform_maps_rect_within(
                render_pass.transform_to_root_target, render_pass.damage_rect, bounds):
            return false
        if val Some(backdrop_bounds) = render_pass.backdrop_filter_bounds:
            if not _valid_rect(backdrop_bounds) or
                not _rect_within(backdrop_bounds, bounds) or
                not _transform_maps_rect_within(
                    render_pass.transform_to_root_target, backdrop_bounds, bounds):
                return false
        var sqs_index = 0
        while sqs_index < render_pass.shared_quad_states.len().to_i32():
            val sqs = render_pass.shared_quad_states[sqs_index.to_i64()]
            val combined = render_pass.transform_to_root_target.mul(sqs.quad_to_target_transform)
            if not _valid_rect(sqs.visible_layer_rect) or
                not _rect_within(sqs.visible_layer_rect, bounds) or
                not _transform_maps_rect_within(combined, sqs.visible_layer_rect, bounds) or
                not _valid_rect(sqs.clip_rect) or not _rect_within(sqs.clip_rect, bounds) or
                not _transform_maps_rect_within(combined, sqs.clip_rect, bounds):
                return false
            sqs_index = sqs_index + 1
        var quad_index = 0
        while quad_index < render_pass.quads.len().to_i32():
            val quad = render_pass.quads[quad_index.to_i64()]
            if not _valid_rect(quad.rect) or not _rect_within(quad.rect, bounds) or
                not _valid_rect(quad.visible_rect) or not _rect_within(quad.visible_rect, bounds):
                return false
            val sqs = render_pass.shared_quad_states[quad.shared_quad_state_index.to_i64()]
            if not _transform_maps_rect_within(
                render_pass.transform_to_root_target.mul(sqs.quad_to_target_transform),
                quad.rect, bounds):
                return false
            quad_index = quad_index + 1
        pass_index = pass_index + 1
    true

class DisplayCompositor:
    aggregator: Aggregator
    output_bounds: SkRect

    static fn new(output_bounds: SkRect) -> DisplayCompositor:
        DisplayCompositor(
            aggregator: Aggregator.new(),
            output_bounds: output_bounds
        )

    me submit_frame(entry: AggregatorEntry):
        me.aggregator.register_frame(entry)

    me draw_frame(root: SurfaceId) -> CompositorFrame:
        val frame = me.aggregator.aggregate(root)
        if _frame_within_output_bounds(frame, me.output_bounds):
            frame
        else:
            CompositorFrame.empty()
