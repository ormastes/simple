@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# std.glob - Glob pattern matching utilities
# Pure Simple implementation
# Supports: *, ?, [abc], [a-z], [!abc]

use std.common.encoding.utf8.{utf8_seq_len}

fn glob_match(path: text, pattern: text) -> bool:
    _glob_at(s: path, si: 0, p: pattern, pi: 0)

# Byte length of the codepoint starting at byte offset `si` in `s` (>= 1;
# an invalid lead byte, or `si` out of range, falls back to 1 so callers can
# never loop forever). `si` itself is always byte-consistent here (advanced
# only by prior calls to this same helper or literal-match single-byte
# steps that are only ever taken on identical byte sequences -- see the
# "Literal match" branch below), so this never mis-reads a continuation
# byte as a lead byte. Returns a plain i64, not a tuple/aggregate -- see
# the note in js/builtins/string.spl's string_charAt for why aggregate
# returns across a call boundary are avoided on this seed.
fn _glob_codepoint_len_at(s: text, si: i64) -> i64:
    val bytes = s.bytes()
    if si < 0 or si >= bytes.len():
        return 1
    val lead = bytes[si]
    val seqlen = utf8_seq_len(lead)
    if seqlen <= 0:
        return 1
    seqlen

fn _glob_at(s: text, si: i64, p: text, pi: i64) -> bool:
    if pi >= p.len():
        return si >= s.len()

    val pc = p[pi:pi + 1]

    if pc == "*":
        # Star: try matching 0..N characters from current position. Steps
        # by whole codepoints of `s` between attempts -- stepping by raw
        # byte would additionally try every mid-character continuation-
        # byte offset inside a multi-byte character in `s`. Those extra
        # attempts can never produce a false match (a continuation byte,
        # 0x80-0xBF, can never equal an ASCII pattern byte or a valid
        # UTF-8 lead byte, 0xC2+), so this is a performance cleanup, not a
        # correctness fix, for this branch specifically.
        var i = si
        while i <= s.len():
            if _glob_at(s: s, si: i, p: p, pi: pi + 1):
                return true
            if i >= s.len():
                break
            val step = _glob_codepoint_len_at(s, i)
            i = i + step
        return false

    if si >= s.len():
        return false

    if pc == "?":
        # '?' matches exactly one *character*, not one byte -- advance by
        # the full byte length of the codepoint at `si`. The old
        # `si + 1` step left `si` pointing at a UTF-8 continuation byte
        # for any multi-byte character, which then could never compare
        # equal to a subsequent ASCII pattern byte, so a pattern like
        # "ab?d" would never match "abéd" even though '?' should consume
        # "é" as one character and the match should succeed. This IS a
        # genuine correctness bug (unlike the '*' cleanup above): '?'
        # only ever tries exactly one si value, so there is no
        # backtracking to eventually land on the right byte offset.
        val step = _glob_codepoint_len_at(s, si)
        val next_si = si + step
        return _glob_at(s: s, si: next_si, p: p, pi: pi + 1)

    if pc == "[":
        # Character class: find first closing ]
        var close = -1
        for ci in (pi + 1)..p.len():
            if close == -1 and p[ci:ci + 1] == "]":
                close = ci
        if close > pi + 1:
            val class_str = p[pi + 1:close]
            # Pass the WHOLE character at si (not just its lead byte) and
            # consume its full byte length. The old `s[si:si+1]`/`si + 1`
            # only ever looked at (and consumed) one byte: a multi-byte
            # character's lead byte can't equal or range-match any ASCII
            # class member, so a plain `[abc]` class correctly rejected it
            # either way -- but a *negated* class like `[!abc]` (common
            # for "anything but a path separator") incorrectly matched on
            # just the lead byte and then left `si` pointing at a
            # continuation byte, corrupting every subsequent match step
            # for that path.
            val seqlen = _glob_codepoint_len_at(s, si)
            var end = si + seqlen
            if end > s.len():
                end = s.len()
            if _char_in_class(ch: s[si:end], class_str: class_str):
                return _glob_at(s: s, si: end, p: p, pi: close + 1)
        return false

    # Literal match
    if s[si:si + 1] == pc:
        return _glob_at(s: s, si: si + 1, p: p, pi: pi + 1)

    false

fn _char_in_class(ch: text, class_str: text) -> bool:
    # Match character against class: abc, a-z, !abc
    var negate = false
    var check_start = 0
    if class_str.len() > 0 and class_str[0:1] == "!":
        negate = true
        check_start = 1

    var found = false
    var skip_count = 0
    for i in check_start..class_str.len():
        if skip_count > 0:
            skip_count = skip_count - 1
            continue
        val c = class_str[i:i + 1]
        val has_dash = i + 1 < class_str.len() and class_str[i + 1:i + 2] == "-"
        val has_end = i + 2 < class_str.len()
        if has_dash and has_end:
            val range_end = class_str[i + 2:i + 3]
            if ch >= c and ch <= range_end:
                found = true
            skip_count = 2
        else:
            if c == ch:
                found = true

    if negate: not found else: found
