# QUIC Connection — fail-closed pure-Simple compatibility facade
#
# No native QUIC provider is admitted. All mutable state is passed and returned
# by value so callers can retain the public shape without hidden side-effects.
# A future provider must introduce a typed, reviewed SFFI contract rather than
# restoring the removed raw-handle declarations.
#
# RFC 9000 defaults (quic_config_default):
#   version          = 1        (RFC 9000)
#   max_idle_timeout = 30 000 ms
#   max_streams_bidi = 100
#   max_streams_uni  = 100
#   initial_window   = 65 535   (64 KiB)

# ============================================================================
# Configuration
# ============================================================================

class QuicConfig:
    """QUIC connection configuration (passed by value)."""
    version: i64
    max_idle_timeout: i64
    max_streams_bidi: i64
    max_streams_uni: i64
    initial_window: i64

pub fn quic_config_default() -> QuicConfig:
    """Return RFC 9000 default configuration."""
    QuicConfig {
        version: 1,
        max_idle_timeout: 30000,
        max_streams_bidi: 100,
        max_streams_uni: 100,
        initial_window: 65535
    }

# ============================================================================
# Named result helpers (avoids anonymous tuple returns)
# ============================================================================

class QuicOutgoing:
    """Result of quic_get_outgoing: updated connection + outgoing data."""
    conn: QuicConnection
    data: text
    data_len: i64

class QuicStreamRead:
    """Result of quic_stream_recv: received data + byte count."""
    data: text
    data_len: i64

# ============================================================================
# Connection
# ============================================================================

class QuicConnection:
    """Opaque QUIC connection handle plus bookkeeping flags."""
    handle: i64
    is_server: bool
    established: bool
    closed: bool

fn _quic_closed_connection(is_server: bool) -> QuicConnection:
    """Terminal fail-closed connection: no native handle, never usable."""
    QuicConnection {
        handle: 0,
        is_server: is_server,
        established: false,
        closed: true
    }

pub fn quic_connection_is_usable(conn: QuicConnection) -> bool:
    """Return false while no authenticated native provider is admitted.

    The argument remains part of the compatibility API. A future typed provider
    must validate provider admission, handle origin, and lifecycle here.
    """
    false

pub fn quic_accept(scid: text, config: QuicConfig) -> QuicConnection:
    """Return a terminal server connection; no native provider is admitted."""
    _quic_closed_connection(true)

pub fn quic_connect(server_name: text, scid: text, config: QuicConfig) -> QuicConnection:
    """Return a terminal client connection; no native provider is admitted."""
    _quic_closed_connection(false)

pub fn quic_feed_udp(conn: QuicConnection, data: text, len: i64) -> QuicConnection:
    """Reject input by returning a terminal connection without native I/O."""
    _quic_closed_connection(conn.is_server)

pub fn quic_get_outgoing(conn: QuicConnection) -> QuicOutgoing:
    """Return no output while the connection provider is unavailable."""
    QuicOutgoing { conn: conn, data: "", data_len: 0 }

pub fn quic_stream_recv(conn: QuicConnection, stream_id: i64, buf_size: i64) -> QuicStreamRead:
    """Return no stream data while the provider is unavailable."""
    QuicStreamRead { data: "", data_len: 0 }

pub fn quic_stream_send(conn: QuicConnection, stream_id: i64, data: text, fin: bool) -> i64:
    """Reject stream output while the provider is unavailable."""
    -1

pub fn quic_close(conn: QuicConnection, reason: text) -> QuicConnection:
    """Return a terminal connection without invoking native code."""
    _quic_closed_connection(conn.is_server)

pub fn quic_check_timeout(conn: QuicConnection) -> QuicConnection:
    """Return a terminal connection; no native timer can be armed."""
    _quic_closed_connection(conn.is_server)

pub fn quic_timeout_millis(conn: QuicConnection) -> i64:
    """Return milliseconds until the next QUIC timer fires (-1 = no timer)."""
    -1
