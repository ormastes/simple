# Parent-authoritative commit owner for bounded local parallel applications.
#
# This is intentionally a runtime owner, not a second commit contract. Child
# results remain `ResultEnvelopeV1` values; the common engine determines their
# canonical order and whether the whole batch may publish. This class supplies
# the missing serialization boundary around the one mutable snapshot root.

use std.common.structural.parallel_commit.commit_contracts.{
    ParallelCommitOrder,
    ParallelConflictPolicy,
    ResultEnvelopeV1
}
use std.common.structural.parallel_commit.commit_engine.{
    ParallelCommitOutcomeV1,
    ParallelCommitStateV1,
    parallel_commit_publish_envelopes,
    parallel_commit_receipt
}
use std.common.structural.transfer.transfer_contracts.{
    ParallelExecutionDomain,
    TransferEnvelopeV1,
    parallel_execution_domain_to_u8,
    transfer_envelope_v1_boundary_allowed
}
use std.common.structural.transfer.process_frame_codec.{decode_process_transfer_frame}
use std.common.structural.parallel_commit.result_envelope_codec.{decode_result_envelope}
use std.thread_sffi.{MutexHandle, mutex_create}

struct ParentCommitSubmissionV1:
    """One child-created result paired with its checked return boundary."""
    transfer: TransferEnvelopeV1
    result: ResultEnvelopeV1

fn parent_commit_submission_v1(transfer: TransferEnvelopeV1,
                               result: ResultEnvelopeV1) -> ParentCommitSubmissionV1:
    ParentCommitSubmissionV1(transfer: transfer, result: result)

fn parent_commit_submission_v1_well_formed(value: ParentCommitSubmissionV1) -> bool:
    """Admit only a boundary-valid child result returned to its parent.

    This layer intentionally does not reinterpret payload bytes. Process
    results therefore remain encoded copies, while thread/actor children may
    use the existing admitted inline/frozen/owned routes. Raw pointer bits have
    no transfer payload variant and fail before a result reaches the owner.
    """
    if not transfer_envelope_v1_boundary_allowed(value.transfer):
        return false
    if parallel_execution_domain_to_u8(value.transfer.target_domain)
        != parallel_execution_domain_to_u8(ParallelExecutionDomain.Parent):
        return false
    if parallel_execution_domain_to_u8(value.transfer.source_domain)
        == parallel_execution_domain_to_u8(ParallelExecutionDomain.Parent):
        return false
    true

class ParentCommitOwnerV1:
    """One mutex-serialized authority for a parent snapshot root.

    The owner never retains child envelopes after `commit`; only the common
    transition's constant-size revision/token state survives. A failed batch
    leaves that root unchanged, including stale and conflicting child results.
    """
    state: ParallelCommitStateV1
    order: ParallelCommitOrder
    conflict: ParallelConflictPolicy
    mutex: MutexHandle

impl ParentCommitOwnerV1:
    static fn create(initial: ParallelCommitStateV1,
                     order: ParallelCommitOrder,
                     conflict: ParallelConflictPolicy) -> ParentCommitOwnerV1:
        ParentCommitOwnerV1(
            state: initial,
            order: order,
            conflict: conflict,
            mutex: mutex_create()
        )

    fn snapshot() -> ParallelCommitStateV1?:
        """Read the currently published root under the owner's mutex.

        `nil` is deliberate fail-closed behavior for a broken runtime mutex;
        callers must not infer a snapshot from an unsynchronized field read.
        """
        if not self.mutex.lock():
            return nil
        val snapshot = self.state
        self.mutex.unlock()
        Some(snapshot)

    me commit(results: [ResultEnvelopeV1], candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Validate, order, and atomically publish one child-result batch.

        Publication is serialized before calling the pure common transition,
        so a second child batch observes the revision written by the first.
        No result history or mutable child payload is stored in this owner.
        """
        if not self.mutex.lock():
            return self.lock_failure()
        val current = self.state
        val outcome = parallel_commit_publish_envelopes(
            current, results, candidate_snapshot_token, self.order, self.conflict)
        if outcome.receipt.ok:
            self.state = outcome.state
        self.mutex.unlock()
        outcome

    me commit_submissions(submissions: [ParentCommitSubmissionV1],
                          candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Commit only child-created results with an admitted parent boundary."""
        if not self.mutex.lock():
            return self.lock_failure()
        var results: [ResultEnvelopeV1] = []
        for submission in submissions:
            if not parent_commit_submission_v1_well_formed(submission):
                val rejected = self.failure("invalid-child-result-transfer")
                self.mutex.unlock()
                return rejected
            results.push(submission.result)
        val current = self.state
        val outcome = parallel_commit_publish_envelopes(
            current, results, candidate_snapshot_token, self.order, self.conflict)
        if outcome.receipt.ok:
            self.state = outcome.state
        self.mutex.unlock()
        outcome

    me commit_process_result_frame(frame: [u8],
                                   candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Decode one encoded Process→Parent result before committing it.

        The process frame authenticates its bounded byte extent/checksum and
        route; the result codec then validates typed commit metadata. Neither
        layer exposes raw process-local addresses to the parent owner.
        """
        val decoded_frame = decode_process_transfer_frame(
            frame, ParallelExecutionDomain.Parent)
        if not decoded_frame.ok:
            return self.reject_process_frame()
        val decoded_result = decode_result_envelope(decoded_frame.value.payload)
        if not decoded_result.ok:
            return self.reject_process_frame()
        val submission = parent_commit_submission_v1(
            decoded_frame.value.envelope, decoded_result.value)
        self.commit_submissions([submission], candidate_snapshot_token)

    fn lock_failure() -> ParallelCommitOutcomeV1:
        """Return a diagnostic-only outcome if runtime serialization is absent."""
        self.failure("commit-owner-lock-unavailable")

    me reject_process_frame() -> ParallelCommitOutcomeV1:
        if not self.mutex.lock():
            return self.lock_failure()
        val rejected = self.failure("invalid-process-result-frame")
        self.mutex.unlock()
        rejected

    fn failure(reason: text) -> ParallelCommitOutcomeV1:
        """Keep the root unchanged while returning one well-formed diagnostic."""
        val current = self.state
        ParallelCommitOutcomeV1(
            state: current,
            receipt: parallel_commit_receipt(
                false,
                current.revision,
                current.revision,
                current.snapshot_token,
                current.snapshot_token,
                0,
                [], [], [],
                reason
            )
        )

fn parent_commit_owner_v1(initial: ParallelCommitStateV1,
                          order: ParallelCommitOrder,
                          conflict: ParallelConflictPolicy) -> ParentCommitOwnerV1:
    """Construct the local parent authority after validating its root."""
    ParentCommitOwnerV1.create(initial, order, conflict)
