# Parent-authoritative commit owner for bounded local parallel applications.
#
# This is intentionally a runtime owner, not a second commit contract. Child
# results remain `ResultEnvelopeV1` values; the common engine determines their
# canonical order and whether the whole batch may publish. This class supplies
# the missing serialization boundary around the one mutable snapshot root.

use std.common.structural.parallel_commit.commit_contracts.{
    ParallelCommitOrder,
    ParallelConflictPolicy,
    ResultEnvelopeV1
}
use std.common.structural.parallel_commit.commit_engine.{
    ParallelCommitOutcomeV1,
    ParallelCommitStateV1,
    parallel_commit_publish_envelopes,
    parallel_commit_receipt
}
use std.common.structural.transfer.transfer_contracts.{
    ParallelExecutionDomain,
    TransferEnvelopeV1,
    parallel_execution_domain_to_u8,
    transfer_envelope_v1_boundary_allowed
}
use std.common.structural.transfer.process_frame_codec.{decode_process_transfer_frame}
use std.common.structural.parallel_commit.result_envelope_codec.{decode_result_envelope}
use std.nogc_async_mut.parent_commit_inbox.{ParentCommitFrameInboxV1}
use std.thread_sffi.{MutexHandle, mutex_create}
use std.nogc_async_mut.io.{time_now_unix_micros}

struct ParentCommitSubmissionV1:
    """One child-created result paired with its checked return boundary."""
    transfer: TransferEnvelopeV1
    result: ResultEnvelopeV1

struct ParentCommitCandidateV1:
    """Application-created candidate root offered for atomic publication.

    `application_payload_root` is the complete proposed application token root.
    The owner independently applies the canonical result order and compares its
    computed root before changing either live field.
    """
    snapshot_token: i64
    application_payload_root: [i64]

struct ParentCommitMutationReceiptV1:
    ok: bool
    before_revision: i64
    after_revision: i64
    before_snapshot_token: i64
    after_snapshot_token: i64
    before_application_payload_root: [i64]
    after_application_payload_root: [i64]
    applied_payload_tokens: [i64]
    reason: text

struct ParentCommitMutationOutcomeV1:
    commit: ParallelCommitOutcomeV1
    mutation: ParentCommitMutationReceiptV1

fn parent_commit_candidate_v1(snapshot_token: i64,
                              application_payload_root: [i64]) -> ParentCommitCandidateV1:
    ParentCommitCandidateV1(snapshot_token: snapshot_token,
        application_payload_root: application_payload_root)

fn parent_commit_payload_root_copy(source: [i64]) -> [i64]:
    var result: [i64] = []
    for token in source:
        result.push(token)
    result

fn parent_commit_submission_v1(transfer: TransferEnvelopeV1,
                               result: ResultEnvelopeV1) -> ParentCommitSubmissionV1:
    ParentCommitSubmissionV1(transfer: transfer, result: result)

fn parent_commit_submission_v1_well_formed(value: ParentCommitSubmissionV1) -> bool:
    """Admit only a boundary-valid child result returned to its parent.

    This layer intentionally does not reinterpret payload bytes. Process
    results therefore remain encoded copies, while thread/actor children may
    use the existing admitted inline/frozen/owned routes. Raw pointer bits have
    no transfer payload variant and fail before a result reaches the owner.
    """
    if not transfer_envelope_v1_boundary_allowed(value.transfer):
        return false
    if parallel_execution_domain_to_u8(value.transfer.target_domain) != parallel_execution_domain_to_u8(ParallelExecutionDomain.Parent):
        return false
    if parallel_execution_domain_to_u8(value.transfer.source_domain) == parallel_execution_domain_to_u8(ParallelExecutionDomain.Parent):
        return false
    true

class ParentCommitOwnerV1:
    """One mutex-serialized authority for a parent snapshot root.

    The owner never retains child envelopes after `commit`. It owns both the
    common revision/token state and the application payload-token root. A failed
    batch leaves both unchanged, including stale and conflicting child results.
    """
    state: ParallelCommitStateV1
    application_payload_root: [i64]
    order: ParallelCommitOrder
    conflict: ParallelConflictPolicy
    mutex: MutexHandle
    next_process_session_generation: i64

impl ParentCommitOwnerV1:
    static fn create(initial: ParallelCommitStateV1,
                     order: ParallelCommitOrder,
                     conflict: ParallelConflictPolicy) -> ParentCommitOwnerV1:
        ParentCommitOwnerV1.create_with_application_root(
            initial, [], order, conflict)

    static fn create_with_application_root(
        initial: ParallelCommitStateV1,
        application_payload_root: [i64],
        order: ParallelCommitOrder,
        conflict: ParallelConflictPolicy
    ) -> ParentCommitOwnerV1:
        var generation_seed = time_now_unix_micros()
        if generation_seed < 0:
            generation_seed = 0 - generation_seed
        if generation_seed == 0:
            generation_seed = 1
        ParentCommitOwnerV1(
            state: initial,
            application_payload_root: parent_commit_payload_root_copy(
                application_payload_root),
            order: order,
            conflict: conflict,
            mutex: mutex_create(),
            next_process_session_generation: generation_seed
        )

    me issue_process_session_generation() -> i64:
        """Issue session identity from the sole long-lived parent authority."""
        if not self.mutex.lock():
            return 0
        val issued = self.next_process_session_generation
        if issued == 9223372036854775807:
            self.mutex.unlock()
            return 0
        self.next_process_session_generation = issued + 1
        self.mutex.unlock()
        issued

    fn snapshot() -> ParallelCommitStateV1?:
        """Read the currently published root under the owner's mutex.

        `nil` is deliberate fail-closed behavior for a broken runtime mutex;
        callers must not infer a snapshot from an unsynchronized field read.
        """
        if not self.mutex.lock():
            return nil
        val snapshot = self.state
        self.mutex.unlock()
        Some(snapshot)

    fn snapshot_application_payload_root() -> [i64]?:
        """Copy the canonical application payload root under the owner lock."""
        if not self.mutex.lock():
            return nil
        val result = parent_commit_payload_root_copy(self.application_payload_root)
        self.mutex.unlock()
        Some(result)

    me commit(results: [ResultEnvelopeV1], candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Validate, order, and atomically publish one child-result batch.

        Publication is serialized before calling the pure common transition,
        so a second child batch observes the revision written by the first.
        No result history or mutable child payload is stored in this owner.
        """
        if not self.mutex.lock():
            return self.lock_failure()
        val current = self.state
        val outcome = parallel_commit_publish_envelopes(
            current, results, candidate_snapshot_token, self.order, self.conflict)
        if outcome.receipt.ok:
            for token in outcome.receipt.ordered_payload_tokens:
                self.application_payload_root.push(token)
            self.state = outcome.state
        self.mutex.unlock()
        outcome

    me commit_submissions(submissions: [ParentCommitSubmissionV1],
                          candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Commit only child-created results with an admitted parent boundary."""
        if not self.mutex.lock():
            return self.lock_failure()
        var results: [ResultEnvelopeV1] = []
        for submission in submissions:
            if not parent_commit_submission_v1_well_formed(submission):
                val rejected = self.failure("invalid-child-result-transfer")
                self.mutex.unlock()
                return rejected
            results.push(submission.result)
        val current = self.state
        val outcome = parallel_commit_publish_envelopes(
            current, results, candidate_snapshot_token, self.order, self.conflict)
        if outcome.receipt.ok:
            for token in outcome.receipt.ordered_payload_tokens:
                self.application_payload_root.push(token)
            self.state = outcome.state
        self.mutex.unlock()
        outcome

    me commit_process_result_frame(frame: [u8],
                                   candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Decode one encoded Process→Parent result before committing it.

        The process frame authenticates its bounded byte extent/checksum and
        route; the result codec then validates typed commit metadata. Neither
        layer exposes raw process-local addresses to the parent owner.
        """
        self.commit_process_result_frames([frame], candidate_snapshot_token)

    me commit_process_result_frames(frames: [[u8]],
                                    candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Decode and atomically publish one bounded process-result batch.

        Each frame is independently route- and schema-checked before the
        common transition sees any child result. A malformed frame rejects the
        complete batch before the root mutex is acquired for publication, so
        partially decoded process results never advance the parent snapshot.
        """
        if frames.len() == 0:
            return self.reject_process_frame()
        var submissions: [ParentCommitSubmissionV1] = []
        for frame in frames:
            val decoded_frame = decode_process_transfer_frame(
                frame, ParallelExecutionDomain.Parent)
            if not decoded_frame.ok:
                return self.reject_process_frame()
            val decoded_result = decode_result_envelope(decoded_frame.value.payload)
            if not decoded_result.ok:
                return self.reject_process_frame()
            submissions.push(parent_commit_submission_v1(
                decoded_frame.value.envelope, decoded_result.value))
        self.commit_submissions(submissions, candidate_snapshot_token)

    me commit_process_result_frames_with_candidate(
        frames: [[u8]],
        candidate: ParentCommitCandidateV1
    ) -> ParentCommitMutationOutcomeV1:
        """Publish only after complete decode, application apply, and verify.

        The candidate is child-independent application state built off to the
        side.  This method validates every frame and the complete candidate
        receipt before the single assignment to `self.state`.  Every failure
        returns the unchanged root and a negative mutation receipt.
        """
        if frames.len() == 0:
            return self.reject_candidate("empty-process-result-batch")
        var submissions: [ParentCommitSubmissionV1] = []
        for frame in frames:
            val decoded_frame = decode_process_transfer_frame(
                frame, ParallelExecutionDomain.Parent)
            if not decoded_frame.ok:
                return self.reject_candidate("invalid-process-result-frame")
            val decoded_result = decode_result_envelope(decoded_frame.value.payload)
            if not decoded_result.ok:
                return self.reject_candidate("invalid-process-result-frame")
            val submission = parent_commit_submission_v1(
                decoded_frame.value.envelope, decoded_result.value)
            if not parent_commit_submission_v1_well_formed(submission):
                return self.reject_candidate("invalid-child-result-transfer")
            submissions.push(submission)
        if not self.mutex.lock():
            return self.reject_candidate_unlocked("commit-owner-lock-unavailable")
        val current = self.state
        val current_application_payload_root = parent_commit_payload_root_copy(
            self.application_payload_root)
        var results: [ResultEnvelopeV1] = []
        for submission in submissions:
            results.push(submission.result)
        val proposed = parallel_commit_publish_envelopes(
            current, results, candidate.snapshot_token, self.order, self.conflict)
        if not proposed.receipt.ok:
            val rejected = self.candidate_failure_locked(proposed, proposed.receipt.reason)
            self.mutex.unlock()
            return rejected
        var applied_root: [i64] = []
        for token in current_application_payload_root:
            applied_root.push(token)
        for token in proposed.receipt.ordered_payload_tokens:
            applied_root.push(token)
        if applied_root != candidate.application_payload_root:
            val rejected = self.candidate_failure_locked(
                proposed, "candidate-application-root-mismatch")
            self.mutex.unlock()
            return rejected
        self.state = proposed.state
        self.application_payload_root = applied_root
        val accepted = ParentCommitMutationOutcomeV1(
            commit: proposed,
            mutation: ParentCommitMutationReceiptV1(
                ok: true,
                before_revision: current.revision,
                after_revision: proposed.state.revision,
                before_snapshot_token: current.snapshot_token,
                after_snapshot_token: proposed.state.snapshot_token,
                before_application_payload_root: parent_commit_payload_root_copy(
                    current_application_payload_root),
                after_application_payload_root: parent_commit_payload_root_copy(applied_root),
                applied_payload_tokens: parent_commit_payload_root_copy(
                    proposed.receipt.ordered_payload_tokens),
                reason: ""))
        self.mutex.unlock()
        accepted

    fn candidate_failure_locked(_proposed: ParallelCommitOutcomeV1,
                                reason: text) -> ParentCommitMutationOutcomeV1:
        val current = self.state
        val current_application_payload_root = parent_commit_payload_root_copy(
            self.application_payload_root)
        ParentCommitMutationOutcomeV1(
            commit: ParallelCommitOutcomeV1(
                state: current,
                receipt: parallel_commit_receipt(false,
                    current.revision, current.revision,
                    current.snapshot_token, current.snapshot_token,
                    0, [], [], [], reason)),
            mutation: ParentCommitMutationReceiptV1(
                ok: false,
                before_revision: current.revision,
                after_revision: current.revision,
                before_snapshot_token: current.snapshot_token,
                after_snapshot_token: current.snapshot_token,
                before_application_payload_root: current_application_payload_root,
                after_application_payload_root: current_application_payload_root,
                applied_payload_tokens: [],
                reason: reason))

    me reject_candidate(reason: text) -> ParentCommitMutationOutcomeV1:
        if not self.mutex.lock():
            return self.reject_candidate_unlocked("commit-owner-lock-unavailable")
        val rejected = self.candidate_failure_locked(self.failure(reason), reason)
        self.mutex.unlock()
        rejected

    fn reject_candidate_unlocked(reason: text) -> ParentCommitMutationOutcomeV1:
        # Lock acquisition failed, so canonical fields are deliberately not
        # observed. Sentinel state makes the unavailable snapshot explicit.
        val current = ParallelCommitStateV1(revision: -1, snapshot_token: -1)
        val current_application_payload_root: [i64] = []
        val failed = ParallelCommitOutcomeV1(
            state: current,
            receipt: parallel_commit_receipt(false,
                current.revision, current.revision,
                current.snapshot_token, current.snapshot_token,
                0, [], [], [], reason))
        ParentCommitMutationOutcomeV1(
            commit: failed,
            mutation: ParentCommitMutationReceiptV1(
                ok: false,
                before_revision: current.revision,
                after_revision: current.revision,
                before_snapshot_token: current.snapshot_token,
                after_snapshot_token: current.snapshot_token,
                before_application_payload_root: current_application_payload_root,
                after_application_payload_root: current_application_payload_root,
                applied_payload_tokens: [],
                reason: reason))

    me commit_next_process_result(inbox: ParentCommitFrameInboxV1,
                                  candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Drain exactly one accepted ingress frame into the parent commit.

        The inbox transfers the frame before this method acquires the commit
        root. A stale/conflicting result is therefore terminal for that frame;
        callers must create a new child result against a new snapshot rather
        than relying on implicit queue retries.
        """
        val received = inbox.receive()
        if not received.ok:
            return self.inbox_failure(received.reason)
        self.commit_process_result_frame(received.frame, candidate_snapshot_token)

    me drain_process_result_batch(inbox: ParentCommitFrameInboxV1,
                                  max_frames: i64,
                                  candidate_snapshot_token: i64) -> ParallelCommitOutcomeV1:
        """Drain up to a bounded number of accepted frames into one commit.

        `max_frames` is an explicit parent scheduling budget, not a queue
        capacity override. The owner consumes only frames already accepted by
        the bounded inbox and delegates their canonical ordering to the common
        commit engine in one transition.
        """
        if max_frames <= 0:
            return self.inbox_failure("invalid-batch-limit")
        var frames: [[u8]] = []
        while frames.len() < max_frames:
            val received = inbox.receive()
            if received.ok:
                frames.push(received.frame)
                continue
            if received.reason == "empty" or received.reason == "closed":
                break
            return self.inbox_failure(received.reason)
        if frames.len() == 0:
            return self.inbox_failure("empty")
        self.commit_process_result_frames(frames, candidate_snapshot_token)

    fn lock_failure() -> ParallelCommitOutcomeV1:
        """Return a diagnostic-only outcome if runtime serialization is absent."""
        self.failure("commit-owner-lock-unavailable")

    me reject_process_frame() -> ParallelCommitOutcomeV1:
        if not self.mutex.lock():
            return self.lock_failure()
        val rejected = self.failure("invalid-process-result-frame")
        self.mutex.unlock()
        rejected

    me inbox_failure(reason: text) -> ParallelCommitOutcomeV1:
        if not self.mutex.lock():
            return self.lock_failure()
        val rejected = self.failure("process-result-inbox-" + reason)
        self.mutex.unlock()
        rejected

    fn failure(reason: text) -> ParallelCommitOutcomeV1:
        """Keep the root unchanged while returning one well-formed diagnostic."""
        val current = self.state
        ParallelCommitOutcomeV1(
            state: current,
            receipt: parallel_commit_receipt(
                false,
                current.revision,
                current.revision,
                current.snapshot_token,
                current.snapshot_token,
                0,
                [], [], [],
                reason
            )
        )

fn parent_commit_owner_v1(initial: ParallelCommitStateV1,
                          order: ParallelCommitOrder,
                          conflict: ParallelConflictPolicy) -> ParentCommitOwnerV1:
    """Construct the local parent authority after validating its root."""
    ParentCommitOwnerV1.create(initial, order, conflict)

fn parent_commit_owner_v1_with_application_root(
    initial: ParallelCommitStateV1,
    application_payload_root: [i64],
    order: ParallelCommitOrder,
    conflict: ParallelConflictPolicy
) -> ParentCommitOwnerV1:
    ParentCommitOwnerV1.create_with_application_root(
        initial, application_payload_root, order, conflict)
