# HTTP compatibility facade
#
# The synchronous no-GC module owns the lossless typed SFFI lift. This
# compile-time re-export avoids duplicate high-level-object foreign declarations
# and adds no request-time allocation, copy, lookup, or dispatch.

export use std.nogc_sync_mut.net.http.{NetHttpMethod, HttpRequest, HttpResponse,
    HttpClient, Url, UrlBuilder, get, post, download}
