"""
# sosix Host Facade

Host-side process/OS facade under the `sosix` vocabulary. Tools depend on
`sosix_*` names instead of reaching for native/POSIX primitives directly, so a
future Windows backend (and, later, SimpleOS binding the same names) can be
swapped in behind one seam.

**Not** `src/os/sosix/**` — that tree is SimpleOS-internal (it calls
`os.userlib.syscall_raw.syscall` and imports `os.kernel.errno`) and has no host
backend. This module deliberately reuses the same vocabulary so SimpleOS can
later bind behind identical names.

## Overhead policy

The host path adds no facade call frame where the underlying primitive has
the exact signature: braced `export use module.{source as sosix_name}` binds the
same declaration under the SOSIX name. The unbraced
`export use module.source as sosix_name` form is still an open module-versus-
symbol resolution gap. Only `sosix_run`, `sosix_platform` and
`sosix_proc_usage` carry adapter bodies because their signature or value
domain differs. Native POSIX raw-alias qualification remains separate.

## Why no `variants/` overlay

The `variants/` overlay selects a module ROOT at compile time. That fits a
per-host tool binary (unlike the compiler, which is multi-target at runtime from
one binary and is therefore explicitly disqualified from a host-OS variants axis
by the seam-qualification bar in `.claude/skills/spipe.md`). It is still not
warranted here: the Windows side is an honest unavailable-stub, so there is no
second real implementation to select between. A cheap platform check keeps the
diff minimal and the POSIX path alias-thin. When a real Windows backend lands,
promoting this seam to the `platform` variants group is a mechanical change.
"""

use std.nogc_sync_mut.io_runtime.{platform_name}
use std.nogc_async_mut.io.process_ops.{process_run}
export use std.nogc_async_mut.io.process_ops.{
    process_spawn_async as sosix_spawn,
    process_is_running as sosix_is_running,
    process_kill as sosix_kill
}
export use std.nogc_async_mut.env.{which as sosix_which}
export use std.nogc_sync_mut.io.dir_ops.{
    dir_is_real_no_follow as sosix_dir_is_real_no_follow
}
export use std.nogc_sync_mut.io.file_ops.{
    file_read as sosix_file_read,
    file_exists as sosix_file_exists,
    file_atomic_write as sosix_file_atomic_write
}
export use std.nogc_sync_mut.io.dir_ops.{dir_create_all as sosix_dir_create_all}
export use std.nogc_sync_mut.io.process_ops.{process_run as sosix_process_run}
export use std.nogc_sync_mut.env.{env_get as sosix_env_get}
export use std.nogc_sync_mut.io_runtime.{env_get_opt as sosix_env_get_opt}
export use std.nogc_async_mut.io.process_ops.{eprint as sosix_eprint}
export use std.sys.pty.{
    open as sosix_pty_open,
    spawn as sosix_pty_spawn,
    write as sosix_pty_write,
    read as sosix_pty_read,
    close as sosix_pty_close,
    is_running as sosix_pty_is_running,
    platform_default_shell as sosix_pty_default_shell
}


struct SosixRun:
    stdout: text
    stderr: text
    exit_code: i64


struct SosixProcUsage:
    cpu_pct: f64
    rss_mb: i64
    valid: bool


# ---------------------------------------------------------------------------
# Adapters (value domain / signature genuinely differs)
# ---------------------------------------------------------------------------

fn sosix_platform() -> text:
    """Host family: "posix" or "windows".

    Adapter, not an alias: the runtime reports "macos"/"linux"/"unix"/"windows"
    and callers of this facade branch on the two-valued family instead.
    """
    if platform_name() == "windows":
        return "windows"
    "posix"


fn sosix_run(cmd: text, args: [text]) -> SosixRun:
    """Run `cmd` to completion, capturing stdout/stderr and the exit code.

    Adapter, not an alias: the underlying primitive returns the bare tuple
    `(text, text, i64)`, and this facade's contract is a named struct.
    """
    val (out, err, code) = process_run(cmd, args)
    SosixRun(stdout: out, stderr: err, exit_code: code)


fn sosix_proc_usage(pid: i64) -> SosixProcUsage:
    """CPU percentage and resident set size for a live process.

    Adapter: no existing primitive reports this. POSIX reads
    `ps -o %cpu=,rss= -p <pid>`. A dead or unknown pid yields `valid: false`
    rather than fabricated zeros, which a caller cannot distinguish from a truly
    idle process.
    """
    if pid <= 0:
        return SosixProcUsage(cpu_pct: 0.0, rss_mb: 0, valid: false)
    if sosix_platform() == "windows":
        # Honest stub: the real Windows backend is a separate work package.
        return SosixProcUsage(cpu_pct: 0.0, rss_mb: 0, valid: false)

    val (out, _err, code) = process_run("ps", ["-o", "%cpu=,rss=", "-p", "{pid}"])
    if code != 0:
        return SosixProcUsage(cpu_pct: 0.0, rss_mb: 0, valid: false)

    var fields = []
    for part in out.trim().split(" "):
        if part.trim() != "":
            fields.push(part.trim())
    if fields.len() < 2:
        return SosixProcUsage(cpu_pct: 0.0, rss_mb: 0, valid: false)

    # `ps` reports rss in kilobytes.
    SosixProcUsage(cpu_pct: _parse_pct(fields[0]), rss_mb: fields[1].to_i64() / 1024, valid: true)


fn _parse_pct(raw: text) -> f64:
    # text has no to_f64() in this lane; `ps` %cpu is always `<int>.<frac>`.
    val parts = raw.split(".")
    var value = parts[0].to_i64().to_f64()
    if parts.len() > 1:
        var frac = parts[1]
        if frac.len() > 2:
            frac = frac.substring(0, 2)
        var scale = 10.0
        if frac.len() == 2:
            scale = 100.0
        value = value + frac.to_i64().to_f64() / scale
    value


export SosixRun, SosixProcUsage
export sosix_platform, sosix_run, sosix_proc_usage
