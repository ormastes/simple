"""SOSIX ordinary text policy: strict UTF-8, never host charset inference.

Raw provider strings may enter only as immutable byte carriers. Validation
precedes all character processing. The byte-count accessor reads provider
length metadata; it does not decode or scan malformed text.
"""
use std.common.string_core.{str_len}
use std.nogc_sync_mut.io_runtime.{platform_name}
use std.common.encoding.external_text.{ExternalText, ExternalChar, utf8_format}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_external_from_internal, io_internal_text}

pub val SOSIX_TEXT_BYTE_LIMIT: i64 = 16777216

fn sosix_text_check_size(value: text) -> Result<(), TextIoError>:
    val size = str_len(value)
    if size < 0 or size > SOSIX_TEXT_BYTE_LIMIT:
        return Err(TextIoError.Io("SOSIX text exceeds the 16 MiB boundary limit"))
    Ok(())

fn sosix_encode_utf8(value: text) -> Result<ExternalText, TextIoError>:
    sosix_text_check_size(value)?
    io_external_from_internal(value, utf8_format())


fn sosix_decode_text(value: ExternalText) -> Result<text, TextIoError>:
    if value.encoded_byte_length() > SOSIX_TEXT_BYTE_LIMIT:
        return Err(TextIoError.Io("SOSIX encoded text exceeds the 16 MiB boundary limit"))
    io_internal_text(value)

fn sosix_admit_utf8(value: text) -> Result<text, TextIoError>:
    # This shared encoder first extracts raw bytes, then validates UTF-8.
    # For UTF-8 Preserve it performs no conversion or text materialization.
    # Return the original immutable carrier only after successful admission.
    val admitted = sosix_encode_utf8(value)?
    Ok(value)

fn sosix_admit_c_string(value: text, environment_key: bool) -> Result<text, TextIoError>:
    val admitted = sosix_admit_utf8(value)?
    if admitted.contains("\0"):
        return Err(TextIoError.Io("SOSIX C-string input contains embedded NUL"))
    if environment_key and (admitted == "" or admitted.contains("=")):
        return Err(TextIoError.Io("SOSIX environment key must be nonempty without equals"))
    Ok(admitted)

fn sosix_decode_char(value: ExternalChar) -> Result<char, TextIoError>:
    match value.to_internal_char():
        case Ok(character): Ok(character)
        case Err(error): Err(TextIoError.Codec(error))

export sosix_text_check_size, sosix_encode_utf8, sosix_decode_text, sosix_decode_char
export sosix_admit_utf8, sosix_admit_c_string

fn sosix_require_posix_text_provider() -> Result<(), TextIoError>:
    val platform = platform_name()
    if platform == "linux" or platform == "macos" or platform == "unix" or platform == "freebsd" or platform == "illumos" or platform == "solaris":
        return Ok(())
    Err(TextIoError.Unsupported("SOSIX ordinary UTF-8 host text provider unavailable: {platform}"))

export sosix_require_posix_text_provider

# Environment providers use explicit Windows UTF-16 APIs and strict UTF-8
# conversion. This admission does not qualify directory/process/console text.
fn sosix_require_environment_text_provider() -> Result<(), TextIoError>:
    if platform_name() == "windows": return Ok(())
    sosix_require_posix_text_provider()

export sosix_require_environment_text_provider

# Successful resolver output must be admitted before trimming or path parsing.
fn sosix_resolved_path_checked(output: text) -> Result<text, TextIoError>:
    val admitted = sosix_admit_utf8(output)?
    val resolved = admitted.trim()
    if resolved == "":
        return Err(TextIoError.Io("executable resolver returned empty successful output"))
    if not resolved.contains("/") or resolved.contains("\n") or resolved.contains("\r"):
        return Err(TextIoError.Io("executable resolver did not return one explicit path"))
    sosix_admit_c_string(resolved, false)

export sosix_resolved_path_checked
