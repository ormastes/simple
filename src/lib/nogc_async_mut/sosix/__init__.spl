"""
# sosix — unified SOSIX runtime library (hosted composition)

One capsule for every SOSIX consumer: process/env host facade, positioned file
I/O over the canonical SimpleRing (`fs`), the typed synchronous adapter
(`sync`), and time leaves (`time`). Contracts live in
`std.common.contracts.sosix.*`; SimpleOS binds the same contracts from
`src/os/sosix/**` and never imports this capsule. Design:
`doc/05_design/runtime/sosix_runtime_unification_design.md`.

The exact-POSIX leg (`posix`) is absent until the runtime-owned
`rt_fd_pread`/`rt_fd_pwrite` externs land (plan task C1); nothing here stubs it.
"""

export use std.nogc_async_mut.sosix.host_facade.{
    SosixRun, SosixProcUsage,
    sosix_platform, sosix_run, sosix_spawn, sosix_is_running,
    sosix_kill, sosix_proc_usage, sosix_which,
    sosix_pty_open, sosix_pty_spawn, sosix_pty_write, sosix_pty_read,
    sosix_pty_close, sosix_pty_default_shell, sosix_pty_is_running
}
export use std.nogc_async_mut.sosix.fs.{SosixFsSubmit, SosixFsTaken, SosixHostedFs}
export use std.nogc_async_mut.sosix.file_driver.{
    SosixHostedFileDriver, SOSIX_FILE_DRIVER_STATUS_IO
}
export use std.nogc_async_mut.sosix.sync.{
    SosixSyncWaitDriver, SosixSyncResult, SOSIX_SYNC_WAIT_BUDGET,
    sosix_sync_fs_read_at, sosix_sync_fs_write_at
}
export use std.nogc_async_mut.sosix.posix.{
    SOSIX_POSIX_OPEN_READ, SOSIX_POSIX_OPEN_READ_WRITE, SOSIX_POSIX_OPEN_WRITE,
    sosix_posix_open, sosix_posix_close, sosix_posix_pread, sosix_posix_pwrite
}
export use std.nogc_async_mut.sosix.time.{
    sosix_time_monotonic_now_ns, sosix_time_deadline_reached, sosix_time_deadline_after
}
