"""Hosted SOSIX pseudo-terminal service.

Split out of `host_facade` so a consumer that needs only process execution
(`sosix_run`, e.g. the native linker driver) does not compile the PTY family
into its closure: `rt_pty_open/spawn/read/write/close` are Rust-lane-only
(frozen in scripts/check/rt_dual_implementation_baseline.txt), so the core-C
stage-3 compiler link cannot resolve them. Same braced `export use` binding as
before -- no adapter frame -- and the package `sosix` re-exports these names
unchanged.

Keep the public PTY surface aligned with the synchronous SOSIX facade. Generic
std.sosix.pty imports can select this family; capability and lifecycle queries
must still delegate to the selected std.sys.pty provider.
"""

export use std.sys.pty.{
    open as sosix_pty_open,
    spawn as sosix_pty_spawn,
    spawn_configured_v1 as sosix_pty_spawn_configured_v1,
    configured_launch_probe_v1 as sosix_pty_configured_launch_probe_v1,
    literal_bytes_supported_v1 as sosix_pty_literal_bytes_supported_v1,
    write_literal_some_v1 as sosix_pty_write_literal_some_v1,
    write as sosix_pty_write,
    write_some as sosix_pty_write_some,
    input_pending as sosix_pty_input_pending,
    read as sosix_pty_read,
    close as sosix_pty_close,
    is_running as sosix_pty_is_running,
    can_resize as sosix_pty_can_resize,
    resize as sosix_pty_resize,
    cleanup_pending as sosix_pty_cleanup_pending,
    exit_code as sosix_pty_exit_code,
    platform_default_shell as sosix_pty_default_shell
}
export use std.sys.pty_launch.{PtyLaunchV1, PtyLaunchModeV1, PtyEnvironmentChangeV1}
