"""Checked stdin facade: ordinary operations return internal UTF-8 text.

Encoding, endian order and BOM policy are selected once per borrowed session.
No external text values or raw descriptors occur in this public API.
"""
use std.nogc_sync_mut.io.text_session.{TextSessionCodec, utf8_text_session_codec}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_sync_mut.io.stdin_text_session.{StdinTextSession, stdin_text_session}

pub fn sosix_stdin_text(codec: TextSessionCodec) -> Result<StdinTextSession, TextIoError>:
    """Create a checked, logically closeable session; the process retains fd0."""
    stdin_text_session(codec)

pub fn sosix_stdin_utf8(input_byte_limit: i64) -> Result<StdinTextSession, TextIoError>:
    """Select strict UTF-8 explicitly, preserving U+FEFF as content."""
    val codec = utf8_text_session_codec(input_byte_limit, input_byte_limit)?
    stdin_text_session(codec)

export StdinTextSession, sosix_stdin_text, sosix_stdin_utf8
