# Narrow host seam for the derived workaround index. These aliases retain the
# canonical providers' checked results, deadlines and atomic publication.
# The existing reader rejects a symlink/reparse point at the final component;
# it does not pin ancestor directories against concurrent replacement.
# LOCKLESS by design (doc/05_design/compiler/scv/lockless_refresh.md): the
# index is a set of immutable per-writer fragments merged at read time, so this
# seam exposes no file lock.
export use std.nogc_sync_mut.io.file_ops.{
    file_read_regular_no_follow_bounded as workaround_host_read,
    file_read_regular_no_follow_bounded_bytes as workaround_host_read_bytes,
    file_exists as workaround_host_exists,
    file_atomic_write as workaround_host_publish,
    file_create_exclusive as workaround_host_stage,
    file_publish_noreplace_raw as workaround_host_publish_noreplace,
    file_modified_time as workaround_host_modified_time,
    secure_temp_dir as workaround_host_temp_dir,
    file_remove as workaround_host_remove
}
export use std.nogc_sync_mut.io.dir_ops.{dir_create_all as workaround_host_mkdir, dir_list as workaround_host_list}
export use std.nogc_sync_mut.io.env_ops.{cwd as workaround_host_cwd}
export use std.nogc_sync_mut.io.process_ops.{process_run_bounded as workaround_host_process}
export use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros as workaround_host_now_micros}
export use std.nogc_sync_mut.io.sysinfo_ops.{getpid as workaround_host_pid}
