"""Hosted SOSIX environment service.

The nullable lookup preserves the raw distinction between an absent variable
and a present value. The no-GC sync runtime owns the sole foreign call.
"""

export use std.nogc_sync_mut.io_runtime.{
    env_get_nullable as sosix_env_get_nullable,
    env_set_process as sosix_env_set,
    env_remove_process as sosix_env_remove,
    cwd_process as sosix_cwd
}
