# Bounded ASCII process-result ingress for the existing native piped process.
#
# `rt_process_read_stdout` is text-based and may split a child write at any
# point.  This reader accepts only `SPRF1 <lowercase-hex>\n` lines, restores
# the verified binary process frame, and offers it to the parent-owned bounded
# inbox.  It never treats stdout bytes or child-local addresses as values.

use std.common.structural.transfer.process_frame_codec.{
    decode_process_transfer_text_line,
    process_transfer_text_max_line_bytes
}
use std.common.structural.transfer.process_frame_auth.{
    decode_process_transfer_authenticated_text_line,
    process_transfer_frame_authenticated
}
use std.common.structural.transfer.transfer_contracts.{ParallelExecutionDomain}
use std.nogc_async_mut.parent_commit_inbox.{
    ParentCommitFrameInboxV1,
    parent_commit_frame_inbox_v1_for_generation
}
use std.nogc_async_mut.parent_commit_authenticated_session.{
    ParentProcessSessionIdentityV2,
    parent_process_session_identity_v2
}
use std.nogc_async_mut.io.process_ops.{
    process_close_piped,
    process_is_piped_alive,
    process_kill,
    process_read_stdout,
    process_spawn_piped
}

struct ParentCommitPipedReadResultV1:
    ok: bool
    accepted: i64
    rejected: i64
    pending_bytes: i64
    reason: text

struct ParentCommitPipedProcessStatusV1:
    session_generation: i64
    process_handle: i64
    alive: bool
    closed: bool
    close_succeeded: bool
    close_attempts: i64
    cancelled: bool
    naturally_exited: bool
    accepted: i64
    rejected: i64
    terminal_reason: text
    authenticated: bool
    session_id: text

fn parent_commit_piped_read_result_v1(ok: bool, accepted: i64, rejected: i64,
                                      pending_bytes: i64, reason: text) -> ParentCommitPipedReadResultV1:
    ParentCommitPipedReadResultV1(ok: ok, accepted: accepted, rejected: rejected,
        pending_bytes: pending_bytes, reason: reason)

fn parent_commit_piped_stdout_is_ascii(value: text) -> bool:
    """Armored process frames are byte-indexed ASCII, never generic UTF-8."""
    var index = 0
    while index < value.len():
        if value.char_code_at(index) > 127:
            return false
        index = index + 1
    true

class ParentCommitPipedResultReaderV1:
    """Parent-owned line reassembler around one already-bounded frame inbox."""
    inbox: ParentCommitFrameInboxV1
    max_line_bytes: i64
    pending: text
    pending_high_water_bytes: i64
    dropping_oversize_line: bool
    closed: bool
    auth_required: bool
    auth_key: text
    auth_session_id: text
    auth_generation: i64

impl ParentCommitPipedResultReaderV1:
    static fn create(inbox: ParentCommitFrameInboxV1) -> ParentCommitPipedResultReaderV1:
        ParentCommitPipedResultReaderV1.create_with_line_budget(
            inbox, process_transfer_text_max_line_bytes())

    static fn create_with_line_budget(inbox: ParentCommitFrameInboxV1,
                                      requested_max_line_bytes: i64) -> ParentCommitPipedResultReaderV1:
        """Create with a parent-selected ceiling that can only tighten v1.

        The codec owns the global maximum needed to carry its largest legal
        frame.  Applications may choose a smaller bound, but a request cannot
        silently enlarge the process transport beyond that frozen limit.
        """
        var max_line_bytes = requested_max_line_bytes
        if max_line_bytes <= 0 or max_line_bytes > process_transfer_text_max_line_bytes():
            max_line_bytes = process_transfer_text_max_line_bytes()
        ParentCommitPipedResultReaderV1(
            inbox: inbox,
            max_line_bytes: max_line_bytes,
            pending: "",
            pending_high_water_bytes: 0,
            dropping_oversize_line: false,
            closed: false,
            auth_required: false,
            auth_key: "",
            auth_session_id: "",
            auth_generation: 0
        )

    static fn create_authenticated(inbox: ParentCommitFrameInboxV1,
                                   auth_key: text,
                                   identity: ParentProcessSessionIdentityV2) -> ParentCommitPipedResultReaderV1:
        val reader = ParentCommitPipedResultReaderV1.create(inbox)
        reader.auth_required = true
        reader.auth_key = auth_key
        reader.auth_session_id = identity.session_id
        reader.auth_generation = identity.generation
        # SPRF2 adds a 64-byte tag and two delimiters around the canonical
        # SPRF1 carrier. The underlying frame bound remains unchanged.
        reader.max_line_bytes = process_transfer_text_max_line_bytes() + 71
        reader

    me observe_pending_high_water():
        if self.pending.len() > self.pending_high_water_bytes:
            self.pending_high_water_bytes = self.pending.len()

    me receive_stdout_chunk(chunk: text, max_lines: i64) -> ParentCommitPipedReadResultV1:
        """Consume at most `max_lines` completed stdout lines.

        Remaining text is retained only up to the maximum valid armored frame
        line.  An oversized line is discarded through its newline so a noisy
        child cannot turn partial-frame buffering into unbounded parent memory.
        """
        if self.closed:
            return parent_commit_piped_read_result_v1(false, 0, 0,
                0, "reader-closed")
        if max_lines <= 0:
            return parent_commit_piped_read_result_v1(false, 0, 0,
                self.pending.len(), "invalid-line-limit")
        if not parent_commit_piped_stdout_is_ascii(chunk):
            # `text.len()` is a byte count, while text navigation can be
            # character-oriented. Reject UTF-8 before retaining any part of
            # it so the advertised byte ceiling stays an ASCII byte ceiling.
            self.pending = ""
            self.dropping_oversize_line = false
            return parent_commit_piped_read_result_v1(false, 0, 1,
                0, "non-ascii-stdout")
        var accepted = 0
        var rejected = 0
        var processed = 0
        # Retained bytes may already contain a complete line deferred by the
        # prior parent scheduling budget.  Scan them before requiring another
        # child write; otherwise an idle child could strand an accepted result.
        val input = self.pending + chunk
        self.pending = ""
        var i = 0
        while i < input.len():
            if processed >= max_lines:
                val suffix = input.substring(i, input.len())
                if self.pending.len() + suffix.len() > self.max_line_bytes:
                    self.pending = ""
                    self.dropping_oversize_line = true
                    return parent_commit_piped_read_result_v1(false, accepted,
                        rejected + 1, 0, "pending-text-overflow")
                self.pending = self.pending + suffix
                self.observe_pending_high_water()
                return parent_commit_piped_read_result_v1(true, accepted, rejected,
                    self.pending.len(), "")
            val ch = input.substring(i, i + 1)
            i = i + 1
            if self.dropping_oversize_line:
                if ch == "\n":
                    self.dropping_oversize_line = false
                continue
            if ch != "\n":
                if self.pending.len() >= self.max_line_bytes:
                    self.pending = ""
                    self.dropping_oversize_line = true
                    rejected = rejected + 1
                else:
                    self.pending = self.pending + ch
                    self.observe_pending_high_water()
                continue
            processed = processed + 1
            var decoded_ok = false
            var decoded_wire: [u8] = []
            var authenticated = not self.auth_required
            if self.auth_required:
                val decoded_auth = decode_process_transfer_authenticated_text_line(
                    self.pending, ParallelExecutionDomain.Parent)
                decoded_ok = decoded_auth.ok
                decoded_wire = decoded_auth.wire
                authenticated = decoded_auth.ok and process_transfer_frame_authenticated(
                    self.auth_key, self.auth_session_id, self.auth_generation,
                    decoded_auth.wire, decoded_auth.tag)
            else:
                val decoded = decode_process_transfer_text_line(
                    self.pending, ParallelExecutionDomain.Parent)
                decoded_ok = decoded.ok
                decoded_wire = decoded.wire
            self.pending = ""
            if not decoded_ok or not authenticated
                    or not self.inbox.offer_process_result_frame(decoded_wire):
                rejected = rejected + 1
            else:
                accepted = accepted + 1
        parent_commit_piped_read_result_v1(true, accepted, rejected,
            self.pending.len(), "")

    me poll_process_stdout(pid: i64, max_lines: i64) -> ParentCommitPipedReadResultV1:
        """Poll the canonical native pipe; no process-global buffer is used."""
        if pid <= 0:
            return parent_commit_piped_read_result_v1(false, 0, 0,
                self.pending.len(), "invalid-process-handle")
        self.receive_stdout_chunk(process_read_stdout(pid), max_lines)

    me close():
        """Terminally reject later frames and drop incomplete child output."""
        self.pending = ""
        self.dropping_oversize_line = false
        self.closed = true
        self.inbox.close()

    me revoke():
        """Cancel retained child ownership; no accepted frame may resurrect."""
        self.pending = ""
        self.dropping_oversize_line = false
        self.closed = true
        self.inbox.revoke()

    fn pending_byte_count() -> i64:
        self.pending.len()

    fn is_closed() -> bool:
        self.closed

    fn pending_high_water_byte_count() -> i64:
        """Largest retained partial-line size during this reader lifetime."""
        self.pending_high_water_bytes

fn parent_commit_piped_result_reader_v1(inbox: ParentCommitFrameInboxV1) -> ParentCommitPipedResultReaderV1:
    ParentCommitPipedResultReaderV1.create(inbox)

fn parent_commit_piped_result_reader_v1_with_line_budget(
    inbox: ParentCommitFrameInboxV1,
    max_line_bytes: i64
) -> ParentCommitPipedResultReaderV1:
    ParentCommitPipedResultReaderV1.create_with_line_budget(inbox, max_line_bytes)

class ParentCommitPipedProcessSessionV1:
    """Parent-owned lifecycle for one generation-bound piped child.

    The process handle never leaves this owner after construction. Polling can
    only feed its paired reader, and close is idempotent so the native handle is
    released at most once. The inbox independently enforces generation and
    replay admission before parent publication.
    """
    session_generation: i64
    process_handle: i64
    reader: ParentCommitPipedResultReaderV1
    closed: bool
    close_succeeded: bool
    close_attempts: i64
    cancelled: bool
    naturally_exited: bool
    accepted: i64
    rejected: i64
    terminal_reason: text
    authenticated: bool
    session_id: text

impl ParentCommitPipedProcessSessionV1:
    static fn spawn(command: text, args: [text], session_generation: i64,
                    inbox: ParentCommitFrameInboxV1) -> ParentCommitPipedProcessSessionV1:
        val binding_ok = session_generation > 0 and inbox.expected_generation == session_generation
        val pid = if not binding_ok or command == "":
            -1
        else:
            process_spawn_piped(command, args)
        ParentCommitPipedProcessSessionV1(
            session_generation: session_generation,
            process_handle: pid,
            reader: parent_commit_piped_result_reader_v1(inbox),
            closed: false,
            close_succeeded: false,
            close_attempts: 0,
            cancelled: false,
            naturally_exited: false,
            accepted: 0,
            rejected: 0,
            authenticated: false,
            session_id: "",
            terminal_reason: if not binding_ok:
                "generation-binding-mismatch"
            elif pid > 0:
                ""
            else:
                "spawn-failed"
        )

    static fn spawn_authenticated(command: text, args: [text],
                                  capacity: i64, auth_key: text,
                                  authority_secret: text, authority_epoch: text,
                                  process_namespace: text, child_identity: i64,
                                  session_generation: i64) -> ParentCommitPipedProcessSessionV1:
        val identity = parent_process_session_identity_v2(
            authority_secret, authority_epoch, process_namespace,
            child_identity, session_generation)
        val binding_ok = capacity > 0 and session_generation > 0
            and auth_key != "" and identity.session_id != "" and command != ""
        val inbox = parent_commit_frame_inbox_v1_for_generation(
            capacity, session_generation)
        val pid = if binding_ok:
            process_spawn_piped(command, args)
        else:
            -1
        ParentCommitPipedProcessSessionV1(
            session_generation: session_generation,
            process_handle: pid,
            reader: ParentCommitPipedResultReaderV1.create_authenticated(
                inbox, auth_key, identity),
            closed: false,
            close_succeeded: false,
            close_attempts: 0,
            cancelled: false,
            naturally_exited: false,
            accepted: 0,
            rejected: 0,
            authenticated: true,
            session_id: identity.session_id,
            terminal_reason: if not binding_ok:
                "invalid-authenticated-session"
            elif pid > 0:
                ""
            else:
                "spawn-failed")

    me poll(max_lines: i64) -> ParentCommitPipedReadResultV1:
        if self.closed:
            return parent_commit_piped_read_result_v1(false, 0, 0, 0,
                "session-closed")
        if self.process_handle <= 0:
            return parent_commit_piped_read_result_v1(false, 0, 0, 0,
                self.terminal_reason)
        val result = self.reader.poll_process_stdout(self.process_handle, max_lines)
        self.accepted = self.accepted + result.accepted
        self.rejected = self.rejected + result.rejected
        # A bounded line budget may leave a complete coalesced suffix in the
        # reader after the child has exited. Drain already-retained input on a
        # later poll before invoking the native alive probe, because hosted
        # providers release the pipe slot when they observe exit.
        if self.reader.pending_byte_count() == 0 and not process_is_piped_alive(self.process_handle):
            self.finish_natural_exit()
        result

    me finish_natural_exit():
        """Record the terminal reap performed by the native alive probe.

        On hosted providers `process_is_piped_alive` reaps the exited child and
        releases its pipe slot when it returns false. Calling close afterward
        would therefore manufacture a `close-failed` result for an already
        completed cleanup. Treat that provider transition as the session's one
        successful close/reap receipt.
        """
        if self.closed:
            return
        self.reader.close()
        self.closed = true
        self.close_succeeded = true
        self.close_attempts = self.close_attempts + 1
        self.naturally_exited = true
        self.terminal_reason = "exited"

    me close() -> bool:
        self.close_with_reason("closed")

    me cancel() -> bool:
        """Revoke this session and close its native handle exactly once."""
        if self.closed:
            return self.close_succeeded
        self.cancelled = true
        self.reader.revoke()
        if self.process_handle > 0:
            process_kill(self.process_handle)
        self.close_with_reason("cancelled")

    me close_with_reason(reason: text) -> bool:
        if self.closed:
            return self.close_succeeded
        if not self.cancelled:
            self.reader.close()
        self.closed = true
        if self.process_handle <= 0:
            return false
        self.close_attempts = self.close_attempts + 1
        self.close_succeeded = process_close_piped(self.process_handle)
        self.terminal_reason = if self.close_succeeded:
            reason
        else:
            "close-failed"
        self.close_succeeded

    fn status() -> ParentCommitPipedProcessStatusV1:
        ParentCommitPipedProcessStatusV1(
            session_generation: self.session_generation,
            process_handle: self.process_handle,
            alive: self.process_handle > 0 and not self.closed
                and process_is_piped_alive(self.process_handle),
            closed: self.closed,
            close_succeeded: self.close_succeeded,
            close_attempts: self.close_attempts,
            cancelled: self.cancelled,
            naturally_exited: self.naturally_exited,
            accepted: self.accepted,
            rejected: self.rejected,
            terminal_reason: self.terminal_reason,
            authenticated: self.authenticated,
            session_id: self.session_id)

fn parent_commit_piped_process_session_v1(
    command: text,
    args: [text],
    session_generation: i64,
    inbox: ParentCommitFrameInboxV1
) -> ParentCommitPipedProcessSessionV1:
    ParentCommitPipedProcessSessionV1.spawn(
        command, args, session_generation, inbox)

fn parent_commit_authenticated_piped_process_session_v2(
    command: text,
    args: [text],
    capacity: i64,
    auth_key: text,
    authority_secret: text,
    authority_epoch: text,
    process_namespace: text,
    child_identity: i64,
    session_generation: i64
) -> ParentCommitPipedProcessSessionV1:
    ParentCommitPipedProcessSessionV1.spawn_authenticated(
        command, args, capacity, auth_key, authority_secret, authority_epoch,
        process_namespace, child_identity, session_generation)
