"""Value types for bounded linker input windows and staged spill output."""

pub enum LinkWorkingSetStatus:
    Ok
    InvalidLimit
    InvalidWindow
    ResidentBudgetExceeded
    ArithmeticOverflow

pub struct LinkWorkingSetPlan:
    status: LinkWorkingSetStatus
    input_bytes: u64
    input_window_bytes: u64
    staged_output_bytes: u64
    scratch_bytes: u64
    resident_bytes: u64
    resident_limit_bytes: u64
    window_count: u64
    spill_required: bool

pub struct LinkSpillFrameV1:
    logical_offset: u64
    payload_bytes: u64
    checksum_crc32: u32
