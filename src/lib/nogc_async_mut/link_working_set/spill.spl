"""Checksummed spill-frame metadata for staged linker output."""

use std.common.compress.gzip.{gzip_crc32}
use std.nogc_async_mut.link_working_set.model.{LinkSpillFrameV1}

pub fn link_spill_frame_v1(logical_offset: u64, payload: [u8]) -> LinkSpillFrameV1:
    LinkSpillFrameV1(logical_offset: logical_offset, payload_bytes: payload.len().to_u64(), checksum_crc32: gzip_crc32(payload))

pub fn link_spill_frame_v1_valid(frame: LinkSpillFrameV1, payload: [u8]) -> bool:
    frame.payload_bytes == payload.len().to_u64() and frame.checksum_crc32 == gzip_crc32(payload)
